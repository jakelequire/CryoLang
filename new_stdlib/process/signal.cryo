///! POSIX signal numbers.
///!
///! Numeric constants that match Linux x86_64. `Signal` wraps an
///! `i32` so the compiler catches "I passed a pid where a signal
///! was expected" mistakes. The common signals get named
///! constructors; arbitrary numbers go through `from_i32`.
///!
///! Signal *handling* — installing a handler with `sigaction` — is
///! not modeled here. The moment a program installs handlers it
///! crosses into territory that interacts with every other stdlib
///! primitive (async-signal safety, reentrant mallocs, the whole
///! deal), and that's a separate design problem.

namespace std::process::signal;

type struct Signal {
    value: i32;

    static from_i32(value: i32) -> Signal {
        return Signal { value: value };
    }

    as_i32(&this) -> i32 {
        return this.value;
    }

    // POSIX signal numbers (Linux).
    static hangup() -> Signal { return Signal { value: 1 }; }          // SIGHUP
    static interrupt() -> Signal { return Signal { value: 2 }; }       // SIGINT
    static quit() -> Signal { return Signal { value: 3 }; }            // SIGQUIT
    static illegal() -> Signal { return Signal { value: 4 }; }         // SIGILL
    static trap() -> Signal { return Signal { value: 5 }; }            // SIGTRAP
    static abort() -> Signal { return Signal { value: 6 }; }           // SIGABRT
    static bus() -> Signal { return Signal { value: 7 }; }             // SIGBUS
    static floating_point() -> Signal { return Signal { value: 8 }; }  // SIGFPE
    static kill() -> Signal { return Signal { value: 9 }; }            // SIGKILL
    static user1() -> Signal { return Signal { value: 10 }; }          // SIGUSR1
    static segfault() -> Signal { return Signal { value: 11 }; }       // SIGSEGV
    static user2() -> Signal { return Signal { value: 12 }; }          // SIGUSR2
    static pipe() -> Signal { return Signal { value: 13 }; }           // SIGPIPE
    static alarm() -> Signal { return Signal { value: 14 }; }          // SIGALRM
    static terminate() -> Signal { return Signal { value: 15 }; }      // SIGTERM
    static child() -> Signal { return Signal { value: 17 }; }          // SIGCHLD
    static cont() -> Signal { return Signal { value: 18 }; }           // SIGCONT
    static stop() -> Signal { return Signal { value: 19 }; }           // SIGSTOP
    static tty_stop() -> Signal { return Signal { value: 20 }; }       // SIGTSTP
}
