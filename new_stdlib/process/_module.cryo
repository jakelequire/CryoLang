///! process — subprocess spawning.
///!
///! Build a `Command`, call `spawn`, manage a `Child` with
///! captured stdin/stdout/stderr. POSIX `fork + execve` under the
///! hood; Windows is not yet supported.
///!
///! Between fork and exec the child runs a small amount of code — no
///! allocator calls, only async-signal-safe libc — then either execs
///! the target or `_exit(127)` on failure. The parent sees 127 as
///! "exec failed" regardless of why.
///!
///! In scope:
///! - `Command` with program / args / env overrides / cwd
///! - `Stdio::Inherit / Null / Piped / Fd(i32)`
///! - `Child::wait` / `try_wait` / `kill` / `send_signal`
///! - `Command::output` / `status` / `spawn`
///! - Captured `ChildStdin` / `ChildStdout` / `ChildStderr` that
///!   implement `Write` / `Read`
///!
///! Out of scope for now:
///! - Async child management (poll-based `try_wait` is the whole
///!   non-blocking story; a real async runtime is a separate piece)
///! - Detached / double-fork daemonization
///! - Process groups / session leader control
///! - Windows semantics (CreateProcess, job objects)

namespace std::process;

public module process::signal;
public module process::child;
public module process::command;
