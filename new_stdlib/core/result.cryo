///! Result — a value that may be an error.
///!
///! Every fallible stdlib call returns `Result<T, E>` with a module-specific
///! `E`. Operations whose only failure mode is "not there" return `Option`.

namespace std::core::result;

import core::intrinsics;
import core::clone;
import core::cmp;
import core::option;

type enum Result<T, E> {
    Ok(T);
    Err(E);
}

implement enum Result<T, E> {
    is_ok(&this) -> boolean {
        match (&this) {
            Result::Ok(_) => { return true; }
            Result::Err(_) => { return false; }
        }
    }

    is_err(&this) -> boolean {
        match (&this) {
            Result::Ok(_) => { return false; }
            Result::Err(_) => { return true; }
        }
    }

    unwrap(&this) -> T {
        match (&this) {
            Result::Ok(value) => { return value; }
            Result::Err(_) => {
                intrinsics::panic("called Result::unwrap() on an Err value", FILE, LINE);
            }
        }
    }

    expect(&this, message: string) -> T {
        match (&this) {
            Result::Ok(value) => { return value; }
            Result::Err(_) => {
                intrinsics::panic(message, FILE, LINE);
            }
        }
    }

    /// Mirror of `unwrap` for error paths. Useful in tests that assert an
    /// operation fails.
    unwrap_err(&this) -> E {
        match (&this) {
            Result::Ok(_) => {
                intrinsics::panic("called Result::unwrap_err() on an Ok value", FILE, LINE);
            }
            Result::Err(err) => { return err; }
        }
    }

    unwrap_or(&this, default_value: T) -> T {
        match (&this) {
            Result::Ok(value) => { return value; }
            Result::Err(_) => { return default_value; }
        }
    }

    unwrap_or_else(&this, op: (E) -> T) -> T {
        match (&this) {
            Result::Ok(value) => { return value; }
            Result::Err(err) => { return op(err); }
        }
    }

    map<U>(&this, op: (T) -> U) -> Result<U, E> {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(op(value)); }
            Result::Err(err) => { return Result::Err(err); }
        }
    }

    /// Adapt an inner error to a caller's outer error type.
    map_err<F>(&this, op: (E) -> F) -> Result<T, F> {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(value); }
            Result::Err(err) => { return Result::Err(op(err)); }
        }
    }

    and_then<U>(&this, op: (T) -> Result<U, E>) -> Result<U, E> {
        match (&this) {
            Result::Ok(value) => { return op(value); }
            Result::Err(err) => { return Result::Err(err); }
        }
    }

    or_else<F>(&this, op: (E) -> Result<T, F>) -> Result<T, F> {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(value); }
            Result::Err(err) => { return op(err); }
        }
    }

    /// Project the success side to an `Option`, discarding the error.
    ok(&this) -> Option<T> {
        match (&this) {
            Result::Ok(value) => { return Option::Some(value); }
            Result::Err(_) => { return Option::None; }
        }
    }

    /// Project the error side to an `Option`, discarding the success.
    err(&this) -> Option<E> {
        match (&this) {
            Result::Ok(_) => { return Option::None; }
            Result::Err(err) => { return Option::Some(err); }
        }
    }

    /// True iff the result is `Ok(x)` where `x.equals(&value)`.
    contains(&this, value: &T) -> boolean where T: Eq {
        match (&this) {
            Result::Ok(inner) => { return inner.equals(value); }
            Result::Err(_) => { return false; }
        }
    }

    /// True iff the result is `Err(e)` where `e.equals(&error)`.
    contains_err(&this, error: &E) -> boolean where E: Eq {
        match (&this) {
            Result::Ok(_) => { return false; }
            Result::Err(inner) => { return inner.equals(error); }
        }
    }
}

// ============================================================================
// Trait impls
// ============================================================================

implement<T, E> Clone for Result<T, E> where T: Clone, E: Clone {
    clone(&this) -> Result<T, E> {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(value.clone()); }
            Result::Err(err) => { return Result::Err(err.clone()); }
        }
    }
}

implement<T, E> Eq for Result<T, E> where T: Eq, E: Eq {
    equals(&this, other: &Result<T, E>) -> boolean {
        match (&this) {
            Result::Ok(a) => {
                match (other) {
                    Result::Ok(b) => { return a.equals(b); }
                    Result::Err(_) => { return false; }
                }
            }
            Result::Err(a) => {
                match (other) {
                    Result::Ok(_) => { return false; }
                    Result::Err(b) => { return a.equals(b); }
                }
            }
        }
    }
}
