///! Hashing.
///!
///! `Hash` types feed their bytes to a `Hasher`, which folds them into a
///! running state and eventually produces a `u64`. The protocol is the
///! same one Rust uses and covers everything from cheap hash-table hashes
///! to cryptographic digests — implementations just pick how sophisticated
///! their state update is.
///!
///! `DefaultHasher` is FNV-1a. It's fast, simple, and good enough for
///! HashMap keys in non-adversarial code. A better default (SipHash-1-3,
///! ahash, xxhash) lands later; HashMap will be generic over hasher so
///! the upgrade is caller-controlled.

namespace std::core::hash;

import core::option;
import core::slice;

// ============================================================================
// Traits
// ============================================================================

type trait Hasher {
    /// Feed a single byte into the hash state.
    write_u8(mut &this, value: u8) -> void;

    /// Feed a byte slice. Implementations should override with a faster
    /// bulk path; the default falls back to `write_u8` per byte.
    write_bytes(mut &this, bytes: Slice<u8>) -> void {
        mut i: u64 = 0;
        while (i < bytes.length()) {
            match (bytes.get(i)) {
                Option::Some(byte) => { this.write_u8(byte); }
                Option::None => { break; }
            }
            i = i + 1;
        }
    }

    /// Finalize the hash and return the digest. After calling `finish`
    /// the hasher should not be written to again.
    finish(&this) -> u64;
}

type trait Hash {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher;
}

// ============================================================================
// DefaultHasher — FNV-1a
// ============================================================================

/// 64-bit FNV-1a. Simple; not DoS-resistant. Fine as a HashMap default
/// when inputs are trusted.
type struct DefaultHasher {
    state: u64;

    static new() -> DefaultHasher {
        // FNV offset basis.
        return DefaultHasher { state: 14695981039346656037 };
    }
}

const FNV_PRIME: u64 = 1099511628211;

implement Hasher for DefaultHasher {
    write_u8(mut &this, value: u8) -> void {
        this.state = this.state ^ (value as u64);
        this.state = this.state * FNV_PRIME;
    }

    finish(&this) -> u64 {
        return this.state;
    }
}

// ============================================================================
// Primitive Hash impls
// ============================================================================

/// Shared helper for integer Hash impls: feed the little-endian bytes
/// of `value` to the hasher.
function hash_u64_le<H>(hasher: mut &H, value: u64) -> void where H: Hasher {
    mut v: u64 = value;
    mut i: u32 = 0;
    while (i < 8) {
        hasher.write_u8((v & 0xFF) as u8);
        v = v >> 8;
        i = i + 1;
    }
}

implement Hash for u8 {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher {
        hasher.write_u8(this);
    }
}

implement Hash for u16 {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher {
        hash_u64_le(hasher, this as u64);
    }
}

implement Hash for u32 {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher {
        hash_u64_le(hasher, this as u64);
    }
}

implement Hash for u64 {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher {
        hash_u64_le(hasher, this);
    }
}

implement Hash for i8 {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher {
        hasher.write_u8(this as u8);
    }
}

implement Hash for i16 {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher {
        hash_u64_le(hasher, (this as u16) as u64);
    }
}

implement Hash for i32 {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher {
        hash_u64_le(hasher, (this as u32) as u64);
    }
}

implement Hash for i64 {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher {
        hash_u64_le(hasher, this as u64);
    }
}

implement Hash for boolean {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher {
        if (this) {
            hasher.write_u8(1);
        } else {
            hasher.write_u8(0);
        }
    }
}

implement Hash for char {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher {
        hasher.write_u8(this as u8);
    }
}
