///! Clone — explicit duplication.
///!
///! `Clone` produces an independent copy of a value. For types that own
///! heap storage (`Array`, `String`, `Box`) that means allocating fresh
///! storage and copying the contents; for POD types it's a bitwise copy.
///!
///! Types that satisfy `Copy` (see `core::marker`) get a `Clone` impl
///! for free — they can be duplicated without ceremony — but making
///! `Clone` its own trait lets generic code ask for the weaker promise.

namespace std::core::clone;

type trait Clone {
    clone(&this) -> This;
}

implement Clone for i8 { clone(&this) -> i8 { return this; } }
implement Clone for i16 { clone(&this) -> i16 { return this; } }
implement Clone for i32 { clone(&this) -> i32 { return this; } }
implement Clone for i64 { clone(&this) -> i64 { return this; } }
implement Clone for u8 { clone(&this) -> u8 { return this; } }
implement Clone for u16 { clone(&this) -> u16 { return this; } }
implement Clone for u32 { clone(&this) -> u32 { return this; } }
implement Clone for u64 { clone(&this) -> u64 { return this; } }
implement Clone for f32 { clone(&this) -> f32 { return this; } }
implement Clone for f64 { clone(&this) -> f64 { return this; } }
implement Clone for boolean { clone(&this) -> boolean { return this; } }
implement Clone for char { clone(&this) -> char { return this; } }
