///! Error — the stdlib's general-purpose error struct.
///!
///! A plain struct with a message and a numeric code. Modules that need
///! richer error information define their own type and convert to this
///! at module boundaries. When traits land this becomes the reference
///! implementation of the `Error` trait.

namespace std::core::error;

type struct Error {
    public message: string;
    public code: i32;

    /// Construct an error. `code` defaults to zero when the caller has
    /// nothing specific to report.
    static new(message: string, code: i32) -> Error {
        return Error { message: message, code: code };
    }
}
