///! math — float operations.
///!
///! Thin wrappers over libm. Every function delegates to the C
///! implementation and inherits its platform behavior (rounding
///! mode, errno on domain errors, subnormal handling). We don't
///! re-derive the IEEE 754 corner cases in Cryo.
///!
///! The naming follows C (`sqrt`, `sinh`, `atan2`). f64 is the
///! default; f32 versions live alongside with an `f32` suffix only
///! when the C name already carries one (`sqrtf` → `sqrt_f32`).

namespace std::math;

extern "C" {
    function sqrt(value: f64) -> f64;
    function sqrtf(value: f32) -> f32;
    function cbrt(value: f64) -> f64;
    function pow(base: f64, exponent: f64) -> f64;
    function powf(base: f32, exponent: f32) -> f32;

    function exp(value: f64) -> f64;
    function expf(value: f32) -> f32;
    function exp2(value: f64) -> f64;
    function log(value: f64) -> f64;
    function logf(value: f32) -> f32;
    function log2(value: f64) -> f64;
    function log10(value: f64) -> f64;

    function sin(value: f64) -> f64;
    function cos(value: f64) -> f64;
    function tan(value: f64) -> f64;
    function asin(value: f64) -> f64;
    function acos(value: f64) -> f64;
    function atan(value: f64) -> f64;
    function atan2(y: f64, x: f64) -> f64;

    function sinh(value: f64) -> f64;
    function cosh(value: f64) -> f64;
    function tanh(value: f64) -> f64;

    function floor(value: f64) -> f64;
    function ceil(value: f64) -> f64;
    function round(value: f64) -> f64;
    function trunc(value: f64) -> f64;
    function fabs(value: f64) -> f64;
    function fabsf(value: f32) -> f32;

    function fmod(x: f64, y: f64) -> f64;
    function copysign(magnitude: f64, sign: f64) -> f64;
}

// ============================================================================
// Constants
// ============================================================================

const PI: f64 = 3.141592653589793;
const TAU: f64 = 6.283185307179586;
const E: f64 = 2.718281828459045;
const SQRT_2: f64 = 1.4142135623730951;
const LN_2: f64 = 0.6931471805599453;
const LN_10: f64 = 2.302585092994046;

// ============================================================================
// f64 entrypoints (for naming symmetry — thin aliases over libm)
// ============================================================================

function square_root(value: f64) -> f64 { return sqrt(value); }
function cube_root(value: f64) -> f64 { return cbrt(value); }
function power(base: f64, exponent: f64) -> f64 { return pow(base, exponent); }

function natural_log(value: f64) -> f64 { return log(value); }
function log_base2(value: f64) -> f64 { return log2(value); }
function log_base10(value: f64) -> f64 { return log10(value); }
function exponential(value: f64) -> f64 { return exp(value); }

function sine(value: f64) -> f64 { return sin(value); }
function cosine(value: f64) -> f64 { return cos(value); }
function tangent(value: f64) -> f64 { return tan(value); }

function absolute(value: f64) -> f64 { return fabs(value); }
function absolute_f32(value: f32) -> f32 { return fabsf(value); }

function hypot(x: f64, y: f64) -> f64 {
    return sqrt(x * x + y * y);
}

// Integer absolute — cheap enough to be intrinsic-free.
function abs_i32(value: i32) -> i32 {
    if (value < 0) { return 0 - value; }
    return value;
}

function abs_i64(value: i64) -> i64 {
    if (value < 0) { return 0 - value; }
    return value;
}

// ============================================================================
// Classification
// ============================================================================

extern "C" {
    // `isnan` / `isinf` in libc are macros, so we use the underlying
    // primitive implementations — `__isnan` and friends exist on
    // glibc; fall back to a bit pattern comparison if not.
    function __isnan(value: f64) -> i32;
    function __isinf(value: f64) -> i32;
}

function is_nan(value: f64) -> boolean {
    return __isnan(value) != 0;
}

function is_infinite(value: f64) -> boolean {
    return __isinf(value) != 0;
}

function is_finite(value: f64) -> boolean {
    return !is_nan(value) && !is_infinite(value);
}
