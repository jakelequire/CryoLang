///! File — Read/Write over a file descriptor.
///!
///! Opening a file returns a `File` that implements both `Read` and
///! `Write`. Callers compose with `fmt::Formatter` or read-all
///! helpers without caring that the destination is a file.
///!
///! `File` wraps a raw `i32` fd. The obligations are the POSIX ones:
///! every `open` pairs with a `drop` (which `close`s), and no
///! `File::drop` should be skipped or double-invoked.

namespace std::fs::file;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import io::error;
import io::fd;
import io::traits;
import ffi::cstr;
import fs::path;

extern "C" {
    function lseek(fd: i32, offset: i64, whence: i32) -> i32;
}

// POSIX open flags (access mode flags O_RDONLY/O_WRONLY/O_RDWR live in io::fd).
const O_CREAT: i32 = 64;
const O_EXCL: i32 = 128;
const O_TRUNC: i32 = 512;
const O_APPEND: i32 = 1024;

// lseek whence.
const SEEK_SET: i32 = 0;
const SEEK_CUR: i32 = 1;
const SEEK_END: i32 = 2;

// Default mode for newly created files: 0644.
const DEFAULT_CREATE_MODE: u32 = 420;

// ============================================================================
// OpenOptions — what you're asking the OS for
// ============================================================================

type struct OpenOptions {
    read: boolean;
    write: boolean;
    append: boolean;
    truncate: boolean;
    create: boolean;
    create_new: boolean;

    static new() -> OpenOptions {
        return OpenOptions {
            read: false,
            write: false,
            append: false,
            truncate: false,
            create: false,
            create_new: false
        };
    }

    read(mut &this, value: boolean) -> OpenOptions {
        this.read = value;
        return this;
    }

    write(mut &this, value: boolean) -> OpenOptions {
        this.write = value;
        return this;
    }

    append(mut &this, value: boolean) -> OpenOptions {
        this.append = value;
        return this;
    }

    truncate(mut &this, value: boolean) -> OpenOptions {
        this.truncate = value;
        return this;
    }

    create(mut &this, value: boolean) -> OpenOptions {
        this.create = value;
        return this;
    }

    create_new(mut &this, value: boolean) -> OpenOptions {
        this.create_new = value;
        return this;
    }

    open(&this, p: Path) -> Result<File, IoError> {
        return File::open_with(p, this);
    }

    /// Flatten the options into a POSIX `flags` bitmask. Packaged so
    /// `File::open_with` doesn't grow an `if` ladder.
    to_flags(&this) -> i32 {
        mut flags: i32 = 0;
        if (this.read && this.write) { flags = fd::O_RDWR; }
        else if (this.write) { flags = fd::O_WRONLY; }
        else { flags = fd::O_RDONLY; }
        if (this.append) { flags = flags | O_APPEND; }
        if (this.truncate) { flags = flags | O_TRUNC; }
        if (this.create) { flags = flags | O_CREAT; }
        if (this.create_new) { flags = flags | O_CREAT | O_EXCL; }
        return flags;
    }
}

// ============================================================================
// File
// ============================================================================

type struct File {
    fd: i32;

    /// Open `p` for reading. Fails with `NotFound`, `PermissionDenied`,
    /// or a mapped `errno`-derived kind on failure.
    static open(p: Path) -> Result<File, IoError> {
        mut options: OpenOptions = OpenOptions::new();
        options = options.read(true);
        return File::open_with(p, &options);
    }

    /// Create (or truncate) `p` for writing.
    static create(p: Path) -> Result<File, IoError> {
        mut options: OpenOptions = OpenOptions::new();
        options = options.write(true).create(true).truncate(true);
        return File::open_with(p, &options);
    }

    static open_with(p: Path, options: &OpenOptions) -> Result<File, IoError> {
        match (CString::from_str(p.as_str())) {
            Result::Ok(c_path) => {
                const raw_fd: i32 = fd::open(c_path.as_ptr(), options.to_flags(), DEFAULT_CREATE_MODE);
                mut c_local: CString = c_path;
                c_local.drop();
                if (raw_fd < 0) {
                    return Result::Err(IoError::from_errno(fd::errno()));
                }
                return Result::Ok(File { fd: raw_fd });
            }
            Result::Err(_) => {
                return Result::Err(IoError::new(IoErrorKind::InvalidInput, 0));
            }
        }
    }

    /// Seek to `offset` bytes from the start. Returns the new absolute
    /// position.
    seek_set(mut &this, offset: i64) -> Result<u64, IoError> {
        const pos: i64 = lseek(this.fd, offset, SEEK_SET);
        if (pos < 0) {
            return Result::Err(IoError::from_errno(fd::errno()));
        }
        return Result::Ok(pos as u64);
    }

    /// Close the file descriptor. Ownership obligation: every `File`
    /// must have `drop` called before going out of scope. Calling
    /// more than once is a bug the kernel may not catch — the second
    /// `close` could race against an unrelated `open` that reused
    /// the same fd.
    drop(mut &this) -> void {
        if (this.fd >= 0) {
            fd::close_fd(this.fd);
            this.fd = -1;
        }
    }
}

implement Read for File {
    read(mut &this, buffer: u8*, length: u64) -> Result<u64, IoError> {
        return fd::read_fd(this.fd, buffer, length);
    }
}

implement Write for File {
    write(mut &this, bytes: Slice<u8>) -> Result<u64, IoError> {
        return fd::write_fd(this.fd, bytes);
    }

    flush(mut &this) -> Result<(), IoError> {
        // `write(2)` is unbuffered at the syscall layer. `fsync` is a
        // caller concern — most writes don't need durability
        // guarantees and `fsync` is expensive.
        return Result::Ok(());
    }
}

// ============================================================================
// Convenience helpers
// ============================================================================

/// Read the entire contents of `p` into a fresh `Array<u8>`. Panics
/// on allocation failure; caller handles I/O failure via the Result.
function read(p: Path) -> Result<Array<u8>, IoError> {
    match (File::open(p)) {
        Result::Ok(handle) => {
            mut file: File = handle;
            mut out: Array<u8> = Array::new();
            mut chunk: u8[4096];
            loop {
                match (file.read(&chunk[0], 4096)) {
                    Result::Ok(n) => {
                        if (n == 0) { break; }
                        mut i: u64 = 0;
                        while (i < n) {
                            out.push(chunk[i]);
                            i++;
                        }
                    }
                    Result::Err(err) => {
                        out.drop();
                        file.drop();
                        return Result::Err(err);
                    }
                }
            }
            file.drop();
            return Result::Ok(out);
        }
        Result::Err(err) => { return Result::Err(err); }
    }
}

/// Write `bytes` to `p`, creating or truncating.
function write(p: Path, bytes: Slice<u8>) -> Result<(), IoError> {
    match (File::create(p)) {
        Result::Ok(handle) => {
            mut file: File = handle;
            const result: Result<(), IoError> = file.write_all(bytes);
            file.drop();
            return result;
        }
        Result::Err(err) => { return Result::Err(err); }
    }
}
