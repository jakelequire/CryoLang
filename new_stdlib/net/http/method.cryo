///! HTTP method.

namespace std::net::http::method;

import core::option;
import collections::str;

type enum Method {
    Get;
    Head;
    Post;
    Put;
    Delete;
    Connect;
    Options;
    Trace;
    Patch;
}

implement enum Method {
    /// Uppercase wire form.
    as_str(&this) -> Str {
        match (&this) {
            Method::Get => { return Str::from_raw("GET" as u8*, 3); }
            Method::Head => { return Str::from_raw("HEAD" as u8*, 4); }
            Method::Post => { return Str::from_raw("POST" as u8*, 4); }
            Method::Put => { return Str::from_raw("PUT" as u8*, 3); }
            Method::Delete => { return Str::from_raw("DELETE" as u8*, 6); }
            Method::Connect => { return Str::from_raw("CONNECT" as u8*, 7); }
            Method::Options => { return Str::from_raw("OPTIONS" as u8*, 7); }
            Method::Trace => { return Str::from_raw("TRACE" as u8*, 5); }
            Method::Patch => { return Str::from_raw("PATCH" as u8*, 5); }
        }
    }

    /// Parse the uppercase wire form. Returns `None` on unknown
    /// methods rather than inventing a variant — the caller decides
    /// whether to 405 or to treat as a bad request.
    static parse(source: Str) -> Option<Method> {
        if (source.equals(&Str::from_raw("GET" as u8*, 3))) {
            return Option::Some(Method::Get);
        }
        if (source.equals(&Str::from_raw("HEAD" as u8*, 4))) {
            return Option::Some(Method::Head);
        }
        if (source.equals(&Str::from_raw("POST" as u8*, 4))) {
            return Option::Some(Method::Post);
        }
        if (source.equals(&Str::from_raw("PUT" as u8*, 3))) {
            return Option::Some(Method::Put);
        }
        if (source.equals(&Str::from_raw("DELETE" as u8*, 6))) {
            return Option::Some(Method::Delete);
        }
        if (source.equals(&Str::from_raw("CONNECT" as u8*, 7))) {
            return Option::Some(Method::Connect);
        }
        if (source.equals(&Str::from_raw("OPTIONS" as u8*, 7))) {
            return Option::Some(Method::Options);
        }
        if (source.equals(&Str::from_raw("TRACE" as u8*, 5))) {
            return Option::Some(Method::Trace);
        }
        if (source.equals(&Str::from_raw("PATCH" as u8*, 5))) {
            return Option::Some(Method::Patch);
        }
        return Option::None;
    }
}
