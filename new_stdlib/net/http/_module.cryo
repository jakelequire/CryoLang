///! http — HTTP/1.1, connection-per-request.
///!
///! Enough to stand up a handler-based server and to make client
///! requests without third-party code. Explicitly not a full HTTP
///! implementation — no keep-alive, no HTTP/2, no chunked encoding,
///! no TLS. See `net/_module.cryo` for the rationale.

namespace std::net::http;

public module net::http::method;
public module net::http::status;
public module net::http::headers;
public module net::http::request;
public module net::http::response;
public module net::http::server;
public module net::http::client;
