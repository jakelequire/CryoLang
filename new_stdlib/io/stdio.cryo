///! Standard streams — `stdin`, `stdout`, `stderr`.
///!
///! Thin wrappers over the POSIX file descriptors 0, 1, 2. All three
///! go through `io::fd::read_fd` / `write_fd` directly; no
///! buffering, because the caller composes a buffered writer on top
///! when they need one. That keeps the base types honest and
///! composable — a buffered writer is just `Write + storage`.

namespace std::io::stdio;

import core::option;
import core::result;
import core::slice;
import io::error;
import io::fd;
import io::traits;

const STDIN_FD: i32 = 0;
const STDOUT_FD: i32 = 1;
const STDERR_FD: i32 = 2;

// ============================================================================
// Stdin
// ============================================================================

type struct Stdin { }

/// Handle to process standard input. Construction is free — all
/// instances dispatch to file descriptor 0.
function stdin() -> Stdin {
    return Stdin { };
}

implement Read for Stdin {
    read(mut &this, buffer: u8*, length: u64) -> Result<u64, IoError> {
        return fd::read_fd(STDIN_FD, buffer, length);
    }
}

// ============================================================================
// Stdout
// ============================================================================

type struct Stdout { }

function stdout() -> Stdout {
    return Stdout { };
}

implement Write for Stdout {
    write(mut &this, bytes: Slice<u8>) -> Result<u64, IoError> {
        return fd::write_fd(STDOUT_FD, bytes);
    }

    flush(mut &this) -> Result<(), IoError> {
        // `write(2)` is unbuffered at this layer. A buffered wrapper
        // is where `flush` does work.
        return Result::Ok(());
    }
}

// ============================================================================
// Stderr
// ============================================================================

type struct Stderr { }

function stderr() -> Stderr {
    return Stderr { };
}

implement Write for Stderr {
    write(mut &this, bytes: Slice<u8>) -> Result<u64, IoError> {
        return fd::write_fd(STDERR_FD, bytes);
    }

    flush(mut &this) -> Result<(), IoError> {
        return Result::Ok(());
    }
}
