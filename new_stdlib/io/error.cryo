///! IoError — the failure kind for every fallible I/O operation.
///!
///! Modeled as an enum with a small closed set of kinds because
///! callers mostly branch on the kind, not the text. A free-form
///! `Other(message)` variant exists for platform-specific errors
///! that don't fit the taxonomy.

namespace std::io::error;

type enum IoErrorKind {
    NotFound;
    PermissionDenied;
    AlreadyExists;
    ConnectionRefused;
    ConnectionReset;
    ConnectionAborted;
    NotConnected;
    AddrInUse;
    Interrupted;
    InvalidInput;
    InvalidData;
    TimedOut;
    WriteZero;
    UnexpectedEof;
    WouldBlock;
    Other;
}

type struct IoError {
    public kind: IoErrorKind;
    /// `errno` from the underlying syscall, or 0 if not applicable.
    /// Useful for diagnostics; callers should branch on `kind`.
    public os_code: i32;

    static new(kind: IoErrorKind, os_code: i32) -> IoError {
        return IoError { kind: kind, os_code: os_code };
    }

    /// Map a POSIX `errno` to an `IoError`. Unknown codes fold to
    /// `Other`. The numeric constants match Linux; other platforms
    /// get remapped inside the libc wrappers.
    static from_errno(code: i32) -> IoError {
        mut kind: IoErrorKind = IoErrorKind::Other;
        if (code == 2) { kind = IoErrorKind::NotFound; }
        else if (code == 13) { kind = IoErrorKind::PermissionDenied; }
        else if (code == 17) { kind = IoErrorKind::AlreadyExists; }
        else if (code == 4) { kind = IoErrorKind::Interrupted; }
        else if (code == 22) { kind = IoErrorKind::InvalidInput; }
        else if (code == 11) { kind = IoErrorKind::WouldBlock; }
        else if (code == 110) { kind = IoErrorKind::TimedOut; }
        else if (code == 111) { kind = IoErrorKind::ConnectionRefused; }
        else if (code == 104) { kind = IoErrorKind::ConnectionReset; }
        else if (code == 103) { kind = IoErrorKind::ConnectionAborted; }
        else if (code == 107) { kind = IoErrorKind::NotConnected; }
        else if (code == 98) { kind = IoErrorKind::AddrInUse; }
        return IoError { kind: kind, os_code: code };
    }
}
