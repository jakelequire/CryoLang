///! IoError — the failure kind for every fallible I/O operation.
///!
///! Modeled as an enum with a small closed set of kinds because
///! callers mostly branch on the kind, not the text. A free-form
///! `Other(message)` variant exists for platform-specific errors
///! that don't fit the taxonomy.

namespace std::io::error;

type enum IoErrorKind {
    NotFound;
    PermissionDenied;
    AlreadyExists;
    ConnectionRefused;
    ConnectionReset;
    ConnectionAborted;
    NotConnected;
    AddrInUse;
    Interrupted;
    InvalidInput;
    InvalidData;
    TimedOut;
    WriteZero;
    UnexpectedEof;
    WouldBlock;
    Other;
}

type struct IoError {
    public kind: IoErrorKind;
    /// `errno` from the underlying syscall, or 0 if not applicable.
    /// Useful for diagnostics; callers should branch on `kind`.
    public os_code: i32;

    static new(kind: IoErrorKind, os_code: i32) -> IoError {
        return IoError { kind: kind, os_code: os_code };
    }

    /// Map a POSIX `errno` to an `IoError`. Unknown codes fold to
    /// `Other`. The numeric constants match Linux; other platforms
    /// get remapped inside the libc wrappers.
    static from_errno(code: i32) -> IoError {
        return match (code) {
            2   => { IoError { kind: IoErrorKind::NotFound, os_code: code } }
            4   => { IoError { kind: IoErrorKind::Interrupted, os_code: code } }
            11  => { IoError { kind: IoErrorKind::WouldBlock, os_code: code } }
            13  => { IoError { kind: IoErrorKind::PermissionDenied, os_code: code } }
            17  => { IoError { kind: IoErrorKind::AlreadyExists, os_code: code } }
            22  => { IoError { kind: IoErrorKind::InvalidInput, os_code: code } }
            98  => { IoError { kind: IoErrorKind::AddrInUse, os_code: code } }
            103 => { IoError { kind: IoErrorKind::ConnectionAborted, os_code: code } }
            104 => { IoError { kind: IoErrorKind::ConnectionReset, os_code: code } }
            107 => { IoError { kind: IoErrorKind::NotConnected, os_code: code } }
            110 => { IoError { kind: IoErrorKind::TimedOut, os_code: code } }
            111 => { IoError { kind: IoErrorKind::ConnectionRefused, os_code: code } }
            _   => { IoError { kind: IoErrorKind::Other, os_code: code } }
        }
    }
}
