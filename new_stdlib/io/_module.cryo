///! io — byte-level input/output.
///!
///! `Read` and `Write` are the traits every byte sink or source
///! implements. `IoError` is the failure channel — callers get
///! `Result<T, IoError>` from every fallible call (PLAN §2.5 retires
///! the old `IoResult`).
///!
///! Standard streams live in `io::stdio`. File I/O is a layer up in
///! `fs::file`, which implements `Read + Write` on top of libc.

namespace std::io;

public module io::error;
public module io::fd;
public module io::traits;
public module io::stdio;
