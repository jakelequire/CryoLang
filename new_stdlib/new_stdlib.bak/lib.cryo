///! Cryo Standard Library
///!
///! The Cryo standard library is the set of types, functions, and modules that
///! every Cryo program can rely on. It is written entirely in Cryo, compiled
///! as a static library (`libcryo.a`), and linked into every binary.
///!
///! The stdlib is organized into a shallow hierarchy of modules, each covering
///! a single concern. Modules that depend on no other stdlib code (`core/`)
///! live at the bottom; modules that compose those into higher-level
///! abstractions (`collections/`, `io/`) live on top.
///!
///! Every program automatically imports the `prelude` module, which re-exports
///! the handful of names so universally useful that requiring an `import` for
///! them would be noise: `Option`, `Result`, `panic`, `assert`, and the basic
///! print functions. Everything else lives in an explicit module that you
///! import when you need it.
///!
///! This file declares which top-level modules exist. Their contents and
///! API contracts live in each module's own files.

namespace std;

public module prelude;

public module core;
// public module alloc;        // Phase 3 — blocked on Drop in cryoc
// public module collections;  // Phase 4
// public module fmt;          // Phase 5
// public module io;           // Phase 5
// public module fs;           // Phase 5
// public module math;         // Phase 5
// public module time;         // Phase 5
// public module env;          // Phase 5
// public module process;      // Phase 5
// public module os;           // Phase 5
// public module ffi;          // Phase 5

const VERSION_MAJOR: u32 = 0;
const VERSION_MINOR: u32 = 1;
const VERSION_PATCH: u32 = 0;
const VERSION: string = "0.1.0";

function version() -> (u32, u32, u32) {
    return (VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH);
}

function version_string() -> string {
    return VERSION;
}
