///! Error — the stdlib's general-purpose error type
///!
///! `Error` is a plain struct carrying a message and an optional numeric
///! code. It is the default `E` for `Result<T, E>` when a module has no
///! richer error type of its own, and the common currency that module-
///! specific errors convert into through the forthcoming `From` trait.
///!
///! # Why not a trait?
///!
///! A proper stdlib would define `Error` as a trait with source-chain
///! support (an error caused by another error caused by another). Cryo
///! doesn't have traits yet — see `PLAN.md` §2.1. In the meantime, a
///! concrete struct covers the ~90% case of "something went wrong, here's
///! why." When traits arrive we introduce an `Error` trait and keep this
///! struct as the `impl Error` reference implementation.

namespace std::core::error;

// ============================================================================
// Declaration
// ============================================================================

type struct Error {
    public message: string;
    public code: i32;

    /// Construct an error with a message and no code. The code defaults
    /// to zero, which callers should treat as "unspecified."
    static new(message: string) -> Error {
        return Error { message: message, code: 0 };
    }

    /// Construct an error with a message and a numeric code. Use this for
    /// errors that wrap an errno-style value or a protocol status code.
    static with_code(message: string, code: i32) -> Error {
        return Error { message: message, code: code };
    }

    /// The human-readable description of the error.
    message(&this) -> string {
        return this.message;
    }

    /// The numeric code attached to the error, or zero if none was set.
    code(&this) -> i32 {
        return this.code;
    }

    /// `true` iff the error carries a non-zero code.
    has_code(&this) -> boolean {
        return this.code != 0;
    }
}
