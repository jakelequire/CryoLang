///! core — foundation layer of the Cryo standard library
///!
///! Everything in `core/` is either a language-level primitive (`intrinsics`),
///! a panic/assertion helper that every other module depends on (`panic`),
///! or a small, self-contained type with no dependencies outside of itself
///! and the two above (`option`, `result`, `slice`, `ptr`, `mem`,
///! `primitives`, `error`).
///!
///! Nothing in `core/` allocates on the heap or performs I/O. Higher-level
///! modules (`alloc/`, `collections/`, `io/`) build on top of what lives here.

namespace std::core;

public module core::intrinsics;
public module core::panic;
public module core::primitives;
public module core::option;
public module core::result;
public module core::error;
public module core::slice;
public module core::ptr;
public module core::mem;

