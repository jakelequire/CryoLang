///! Panic and assertion helpers
///!
///! A panic is the response to a broken invariant — a bug the program cannot
///! meaningfully recover from. It prints a message and source location to
///! stderr and aborts the process. Panics are not error handling; errors that
///! a caller can reasonably respond to belong in `Result`.
///!
///! Every stdlib call that can fail for a *caller's* reason returns
///! `Result` or `Option`. Every stdlib call that panics does so because of
///! the callee's own invariant — `Option::unwrap` on `None`, indexing past
///! the end of an array, an assertion marking "this branch is unreachable."
///! Keep that separation when adding new APIs.

namespace std::core::panic;

import core::intrinsics;

// ----------------------------------------------------------------------------
// Panic
// ----------------------------------------------------------------------------

/// Abort the program with `message` and the source location where `panic`
/// was called. `file` and `line` should be the compiler-provided `FILE` and
/// `LINE` constants; the helper forms below do that automatically, so most
/// code should reach for `assert` / `unreachable` / `todo` rather than
/// calling `panic` directly.
function panic(message: string, file: string, line: u32) -> void {
    intrinsics::panic(message, file, line);
}

// ----------------------------------------------------------------------------
// Assertions
// ----------------------------------------------------------------------------

/// Panic if `condition` is false. Always checked — use `debug_assert` for
/// checks that should disappear in release builds.
function assert(condition: boolean, message: string) -> void {
    if (!condition) {
        intrinsics::panic(message, FILE, LINE);
    }
}

/// Panic if `left != right`. The caller supplies the message; we do not
/// format the values because Phase 1 has no formatter yet.
///
/// Requires `T` to support `!=`. When the trait system lands, this becomes
/// `where T: Eq`.
function assert_eq<T>(left: T, right: T, message: string) -> void {
    if (left != right) {
        intrinsics::panic(message, FILE, LINE);
    }
}

/// Panic if `left == right`. Requires `T` to support `==`.
function assert_ne<T>(left: T, right: T, message: string) -> void {
    if (left == right) {
        intrinsics::panic(message, FILE, LINE);
    }
}

/// Assertion that only runs in debug builds. In release builds the call
/// compiles to nothing. Use for checks whose cost you want to pay in
/// development but not in hot paths.
function debug_assert(condition: boolean, message: string) -> void {
    if (DEBUG) {
        assert(condition, message);
    }
}

// ----------------------------------------------------------------------------
// Markers
// ----------------------------------------------------------------------------

/// Mark a code path the programmer believes cannot be reached. If it ever
/// is, the program aborts with a clear message rather than executing
/// wrong code.
function unreachable() -> void {
    intrinsics::panic("entered unreachable code", FILE, LINE);
}

/// Mark a function whose implementation is missing. Useful while stubbing
/// out a module — calling the function at runtime aborts rather than
/// returning a nonsense value.
function unimplemented() -> void {
    intrinsics::panic("not implemented", FILE, LINE);
}

/// A softer synonym of `unimplemented` — reads better at the call site
/// when the intent is "I'll get to this" rather than "this will never be
/// implemented."
function todo() -> void {
    intrinsics::panic("not yet implemented", FILE, LINE);
}

// ----------------------------------------------------------------------------
// Compile-time flags
// ----------------------------------------------------------------------------

/// True when the program is built in debug mode. Set by the compiler based
/// on optimization level; the default in a development build is `true`.
const DEBUG: boolean = true;
