///! Option — a value that may be absent
///!
///! `Option<T>` is Cryo's answer to nullable values. Every use of a nullable
///! pointer in C translates naturally to `Option<T>`, with the difference
///! that the compiler forces you to handle the absent case before you can
///! reach the value.
///!
///! # Requirements on the type parameter
///!
///! Most methods on `Option<T>` make no assumptions about `T`. The few that
///! do are documented individually. Phase 1 of the stdlib predates Cryo's
///! trait system; when traits land, those per-method notes become real
///! trait bounds. See `PLAN.md` section 2.1 and 5.4.

namespace std::core::option;

import core::intrinsics;
import core::panic;
import core::result;

// ============================================================================
// Declaration
// ============================================================================

type enum Option<T> {
    Some(T);
    None;
}

// ============================================================================
// Methods
// ============================================================================

implement enum Option<T> {
    // ------------------------------------------------------------------------
    // Predicates
    // ------------------------------------------------------------------------

    is_some(&this) -> boolean {
        match (&this) {
            Option::Some(_) => { return true; }
            Option::None => { return false; }
        }
    }

    is_none(&this) -> boolean {
        match (&this) {
            Option::Some(_) => { return false; }
            Option::None => { return true; }
        }
    }

    /// `true` iff the option is `Some` *and* the predicate holds for the
    /// inner value. Equivalent to `match (opt) { Some(v) => f(v), None => false }`.
    is_some_and(&this, predicate: (T) -> boolean) -> boolean {
        match (&this) {
            Option::Some(value) => { return predicate(value); }
            Option::None => { return false; }
        }
    }

    /// `true` if the option is `None` *or* the predicate holds for the
    /// inner value. The dual of `is_some_and`.
    is_none_or(&this, predicate: (T) -> boolean) -> boolean {
        match (&this) {
            Option::Some(value) => { return predicate(value); }
            Option::None => { return true; }
        }
    }

    /// `true` iff the option is `Some` and its inner value is equal to
    /// `value`. Requires `T` to support `==`; when trait bounds arrive
    /// this becomes `where T: Eq`.
    contains_eq(&this, value: T) -> boolean {
        match (&this) {
            Option::Some(inner) => { return inner == value; }
            Option::None => { return false; }
        }
    }

    /// `true` iff the option is `Some` and the predicate holds for its
    /// inner value. Works for any `T`.
    contains_by(&this, predicate: (T) -> boolean) -> boolean {
        match (&this) {
            Option::Some(inner) => { return predicate(inner); }
            Option::None => { return false; }
        }
    }

    // ------------------------------------------------------------------------
    // Extraction
    // ------------------------------------------------------------------------

    /// Return the inner value, aborting the program if the option is `None`.
    /// Prefer `unwrap_or` or an explicit `match` in code that must not
    /// panic.
    unwrap(&this) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => {
                intrinsics::panic("called Option::unwrap() on a None value", FILE, LINE);
            }
        }
    }

    /// Like `unwrap`, but panic with a caller-supplied message. The message
    /// should describe the invariant the caller believed held.
    expect(&this, message: string) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => {
                intrinsics::panic(message, FILE, LINE);
            }
        }
    }

    unwrap_or(&this, default_value: T) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => { return default_value; }
        }
    }

    /// Like `unwrap_or`, but compute the default lazily. Use this when the
    /// default is expensive to produce and you want to skip the work in
    /// the `Some` case.
    unwrap_or_else(&this, default_fn: () -> T) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => { return default_fn(); }
        }
    }

    // ------------------------------------------------------------------------
    // Transformation
    // ------------------------------------------------------------------------

    /// Apply `f` to the inner value if `Some`, leaving `None` unchanged.
    map<U>(&this, f: (T) -> U) -> Option<U> {
        match (&this) {
            Option::Some(value) => { return Option::Some(f(value)); }
            Option::None => { return Option::None; }
        }
    }

    /// Apply `f` to the inner value if `Some`; otherwise return
    /// `default_value`. `default_value` is always evaluated; use
    /// `map_or_else` if that cost matters.
    map_or<U>(&this, default_value: U, f: (T) -> U) -> U {
        match (&this) {
            Option::Some(value) => { return f(value); }
            Option::None => { return default_value; }
        }
    }

    /// Like `map_or`, but compute the default lazily.
    map_or_else<U>(&this, default_fn: () -> U, f: (T) -> U) -> U {
        match (&this) {
            Option::Some(value) => { return f(value); }
            Option::None => { return default_fn(); }
        }
    }

    /// If `Some`, call `f` with the inner value and return its result.
    /// If `None`, return `None`. This is the monadic bind for `Option`.
    and_then<U>(&this, f: (T) -> Option<U>) -> Option<U> {
        match (&this) {
            Option::Some(value) => { return f(value); }
            Option::None => { return Option::None; }
        }
    }

    /// Keep the value only if `predicate` holds; otherwise `None`.
    filter(&this, predicate: (T) -> boolean) -> Option<T> {
        match (&this) {
            Option::Some(value) => {
                if (predicate(value)) {
                    return Option::Some(value);
                }
                return Option::None;
            }
            Option::None => { return Option::None; }
        }
    }

    // ------------------------------------------------------------------------
    // Choice
    // ------------------------------------------------------------------------

    and<U>(&this, other: Option<U>) -> Option<U> {
        match (&this) {
            Option::Some(_) => { return other; }
            Option::None => { return Option::None; }
        }
    }

    or(&this, other: Option<T>) -> Option<T> {
        match (&this) {
            Option::Some(_) => { return this; }
            Option::None => { return other; }
        }
    }

    or_else(&this, f: () -> Option<T>) -> Option<T> {
        match (&this) {
            Option::Some(_) => { return this; }
            Option::None => { return f(); }
        }
    }

    /// Return `Some` if exactly one of `this` and `other` is `Some`.
    xor(&this, other: Option<T>) -> Option<T> {
        match (&this) {
            Option::Some(_) => {
                match (other) {
                    Option::Some(_) => { return Option::None; }
                    Option::None => { return this; }
                }
            }
            Option::None => { return other; }
        }
    }

    // ------------------------------------------------------------------------
    // Mutation in place
    // ------------------------------------------------------------------------

    /// Replace the option with `None` and return the previous value.
    take(mut &this) -> Option<T> {
        const previous: Option<T> = this;
        this = Option::None;
        return previous;
    }

    /// Replace the option with `Some(value)` and return the previous value.
    replace(mut &this, value: T) -> Option<T> {
        const previous: Option<T> = this;
        this = Option::Some(value);
        return previous;
    }

    /// Call `f` with the inner value if `Some`, and return `this` unchanged.
    /// Useful for inserting side effects (e.g., logging) into a chain.
    inspect(&this, f: (T) -> void) -> Option<T> {
        match (&this) {
            Option::Some(value) => { f(value); }
            Option::None => { }
        }
        return this;
    }

    // ------------------------------------------------------------------------
    // Conversion to Result
    // ------------------------------------------------------------------------

    /// Turn `Some(v)` into `Ok(v)` and `None` into `Err(err)`.
    /// `err` is always evaluated; use `ok_or_else` for lazy errors.
    ok_or<E>(&this, err: E) -> Result<T, E> {
        match (&this) {
            Option::Some(value) => { return Result::Ok(value); }
            Option::None => { return Result::Err(err); }
        }
    }

    ok_or_else<E>(&this, err_fn: () -> E) -> Result<T, E> {
        match (&this) {
            Option::Some(value) => { return Result::Ok(value); }
            Option::None => { return Result::Err(err_fn()); }
        }
    }
}

// ============================================================================
// Free helpers
// ============================================================================

/// Flatten `Option<Option<T>>` into `Option<T>`. Defined as a free function
/// because the outer and inner `Option` would otherwise need the same
/// `T`, which the method-on-enum form cannot express.
function flatten<T>(nested: Option<Option<T>>) -> Option<T> {
    match (nested) {
        Option::Some(inner) => { return inner; }
        Option::None => { return Option::None; }
    }
}

/// Combine two options into an option of the pair. Returns `Some((a, b))`
/// if both are `Some`; `None` otherwise.
function zip<A, B>(a: Option<A>, b: Option<B>) -> Option<(A, B)> {
    match (a) {
        Option::Some(av) => {
            match (b) {
                Option::Some(bv) => { return Option::Some((av, bv)); }
                Option::None => { return Option::None; }
            }
        }
        Option::None => { return Option::None; }
    }
}

/// Shorthand constructor. `some(x)` reads better than `Option::Some(x)` in
/// expressions that already name the type elsewhere.
function some<T>(value: T) -> Option<T> {
    return Option::Some(value);
}

/// Shorthand constructor for the absent case.
function none<T>() -> Option<T> {
    return Option::None;
}
