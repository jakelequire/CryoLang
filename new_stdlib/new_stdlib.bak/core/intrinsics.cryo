///! Compiler intrinsics
///!
///! Declarations of functions the compiler lowers directly to LLVM IR rather
///! than through a normal call. These are the primitives every higher-level
///! module in the stdlib is built on.
///!
///! This module is deliberately narrow. It contains only the operations that
///! genuinely need compiler cooperation:
///!
///!   - Heap allocation (`malloc`, `free`, friends) — because the backend
///!     must emit calls to the C runtime allocator.
///!   - Bulk memory ops (`memcpy`, `memset`, ...) — because LLVM has
///!     dedicated instructions that beat a naive loop.
///!   - Pointer arithmetic (`ptr_add`, `ptr_sub`, `ptr_diff`) — because
///!     these lower to `getelementptr` / `ptrtoint` and the type system
///!     needs to see them specially.
///!   - `panic` — because it participates in unwinding / abort semantics.
///!
///! Everything else that lives in libc (`printf`, `strlen`, `fopen`, and so
///! on) belongs in the `ffi` module as explicit C externs, not here. The
///! old stdlib mixed the two; this one does not.

namespace std::core::intrinsics;

// ----------------------------------------------------------------------------
// Heap allocation
// ----------------------------------------------------------------------------

intrinsic function malloc(size: u64) -> void*;
intrinsic function calloc(count: u64, size: u64) -> void*;
intrinsic function realloc(ptr: void*, new_size: u64) -> void*;
intrinsic function free(ptr: void*) -> void;
intrinsic function aligned_alloc(alignment: u64, size: u64) -> void*;

// ----------------------------------------------------------------------------
// Bulk memory operations
// ----------------------------------------------------------------------------

/// Copy `count` bytes from `src` to `dest`. Undefined behavior if the regions
/// overlap — use `memmove` when overlap is possible.
intrinsic function memcpy(dest: void*, src: void*, count: u64) -> void*;

/// Copy `count` bytes from `src` to `dest`, handling overlap correctly.
intrinsic function memmove(dest: void*, src: void*, count: u64) -> void*;

/// Set `count` bytes starting at `dest` to the low byte of `value`.
intrinsic function memset(dest: void*, value: i32, count: u64) -> void*;

/// Compare `count` bytes at two addresses. Returns 0 if equal, negative if
/// the first differing byte in `a` is less than in `b`, positive otherwise.
intrinsic function memcmp(a: void*, b: void*, count: u64) -> i32;

/// Find the first byte equal to `value` in the first `count` bytes of `ptr`.
/// Returns null if not found.
intrinsic function memchr(ptr: void*, value: i32, count: u64) -> void*;

// ----------------------------------------------------------------------------
// Pointer arithmetic
//
// These are byte-granularity; higher-level helpers in `core::ptr` and
// `core::mem` wrap them with typed-offset semantics.
// ----------------------------------------------------------------------------

intrinsic function ptr_add(ptr: void*, offset: u64) -> void*;
intrinsic function ptr_sub(ptr: void*, offset: u64) -> void*;
intrinsic function ptr_diff(a: void*, b: void*) -> i64;

// ----------------------------------------------------------------------------
// Panic
//
// The `panic` intrinsic prints the message and source location to stderr,
// then aborts the process. It does not return; when Cryo's `never` type is
// wired through the compiler end-to-end, the return type below becomes
// `never`.
// ----------------------------------------------------------------------------

intrinsic function panic(message: string, file: string, line: u32) -> void;

// ----------------------------------------------------------------------------
// Reflection
// ----------------------------------------------------------------------------

/// Returns a compile-time string naming the type `T` — useful in panic
/// messages and assertion failures. The exact format is unspecified.
intrinsic function typeof_name<T>() -> string;
