///! fmt — formatting values as text.
///!
///! `Display` produces human-readable output for end users.
///! `Debug` produces developer-readable output for diagnostics and
///! inspection. A `Formatter<W>` wraps any `Write` impl and gives
///! trait methods a stable surface to target.
///!
///! This module provides the core traits, a `Formatter`, primitive
///! `Display` and `Debug` implementations, and `print` / `println`
///! helpers. Format-string interpolation (`"{} + {}"`) requires
///! variadic argument or macro support beyond the current compiler.

namespace std::fmt;

public module fmt::integer;
public module fmt::display;
