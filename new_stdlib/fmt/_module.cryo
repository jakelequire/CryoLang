///! fmt — formatting values as text.
///!
///! `Display` produces human-readable output (what a user sees),
///! `Debug` produces developer-readable output (what shows up in
///! `assert_eq!` and log messages). A `Formatter<W>` wraps any
///! `Write` impl and gives trait methods a stable surface to target.
///!
///! Phase 5 is deliberately minimal: the traits, a `Formatter`,
///! primitive impls, and a handful of `print` / `println` helpers.
///! Format-string parsing (`"{} + {}"`) waits until the compiler
///! exposes variadic arguments or macro hooks.

namespace std::fmt;

public module fmt::integer;
public module fmt::display;
