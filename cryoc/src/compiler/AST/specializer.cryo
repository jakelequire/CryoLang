/// AST Specializer
///
/// Thin orchestrator for generic AST specialization: clone → substitute → return.
/// Used by the Monomorphizer to produce concrete AST declarations from generic
/// template entries.

namespace Compiler::AST::Specializer;

import Compiler::Diag;
import Compiler::AST;
import Compiler::Types::Arena;
import Compiler::Types::TypeRef;
import Compiler::AST::Node;
import Compiler::AST::Declaration;
import Compiler::AST::Cloner;
import Compiler::AST::Substituter;
import Compiler::Types;
import Compiler::Types::Substitution;
import Compiler::Types::GenericRegistry;
import Compiler::Resolver::InternTable;
import Compiler::Resolver::SymbolStr;
import Compiler::Resolver::MangledName;


// ============================================================================
// SpecializationResult — Output of a single specialization
// ============================================================================

type struct SpecializationResult {
    specialized_ast: ASTNode*;
    impl_asts:       ASTNode*[];
    spec_name:       string;
    success:         boolean;
    error_message:   string;

    static ok(ast: ASTNode*, impls: ASTNode*[], name: string) -> SpecializationResult {
        return SpecializationResult {
            specialized_ast: ast,
            impl_asts:       impls,
            spec_name:       name,
            success:         true,
            error_message:   "",
        };
    }

    static fail(message: string) -> SpecializationResult {
        return SpecializationResult {
            specialized_ast: null,
            impl_asts:       [],
            spec_name:       "",
            success:         false,
            error_message:   message,
        };
    }
}


// ============================================================================
// ASTSpecializer — Clone + substitute orchestrator
// ============================================================================

type struct ASTSpecializer {
    arena:        TypeArena*;
    intern_table: InternTable*;


    static new(arena: TypeArena*, intern_table: InternTable*) -> ASTSpecializer {
        return ASTSpecializer {
            arena:        arena,
            intern_table: intern_table,
        };
    }


    /// Specialize a generic template entry with the given concrete type arguments.
    ///
    /// Steps:
    ///   1. Build TypeSubstitution from entry's param IDs → concrete type args
    ///   2. Generate specialized name via MangledName
    ///   3. Clone the generic AST
    ///   4. Run ASTTypeSubstituter on the clone
    ///   5. Clone + substitute each impl block
    ///   6. Return result
    specialize(&this, entry: TemplateEntry*, type_args: TypeRef[],
               type_arg_displays: string[]) -> SpecializationResult {
        // Validate
        if (entry == null) {
            return SpecializationResult::fail("null template entry");
        }
        if (type_args.length != entry.param_count) {
            return SpecializationResult::fail(
                format("type argument count mismatch: expected %lld, got %lld",
                        entry.param_count, type_args.length)
            );
        }

        // 1. Build substitution
        const subst: TypeSubstitution = TypeSubstitution::from_params(
            entry.param_type_ids, type_args
        );
        const subst_ptr: TypeSubstitution* = malloc(sizeof(TypeSubstitution));
        *subst_ptr = subst;

        // 2. Generate specialized name
        const base_name_str: string = this.intern_table.resolve(entry.name);
        const mangled: MangledName = MangledName::from_generic(
            this.intern_table, base_name_str, type_arg_displays
        );
        const spec_name: string = this.intern_table.resolve(mangled.value);

        // 3. Clone AST — using for_specialization() so the clone is
        //    created with the specialized name and empty generic_params
        //    from the start.  This avoids post-clone field writes (set_name,
        //    generic_params = []) that the C++ codegen miscompiles on class
        //    hierarchies with vtables.
        const spec_sym: SymbolStr = this.intern_table.intern(spec_name);
        mut cloner: ASTCloner = ASTCloner::for_specialization(spec_sym);
        const cloned_ast: ASTNode* = cloner.clone_node(entry.ast_node);
        if (cloned_ast == null) {
            return SpecializationResult::fail("AST clone returned null");
        }

        // 4. Build SymbolStr arrays for the substituter.
        //    entry.name and entry.param_names are already SymbolStr — no re-interning.
        mut arg_syms: SymbolStr[] = [];
        for (mut ai: i64 = 0; ai < type_arg_displays.length; ai++) {
            arg_syms.push(this.intern_table.intern(type_arg_displays[ai]));
        }

        mut substituter: ASTTypeSubstituter* = new ASTTypeSubstituter(
            subst_ptr, this.arena, this.intern_table,
            entry.name, spec_sym,
            entry.param_names, arg_syms
        );
        cloned_ast.accept(substituter);

        // 5. Renaming is already done by the cloner (step 3).
        //    No post-clone set_name() needed.

        // 6. Clone + substitute each impl block
        mut impl_asts: ASTNode*[] = [];
        for (mut i: i64 = 0; i < entry.impl_blocks.length; i++) {
            const cloned_impl: ASTNode* = cloner.clone_node(entry.impl_blocks[i]);
            if (cloned_impl != null) {
                const impl_node: ImplBlockNode* = cloned_impl as ImplBlockNode*;

                // Filter out methods whose `this` parameter is a Generic
                // instantiation of the outer template with modified args
                // (e.g. `this: Result<T*, E>` on `implement Result<T, E>`).
                // Such methods apply only to specific outer T — monomorphizing
                // them for arbitrary T produces invalid code, since the body
                // uses the modified shape (`*ptr` where ptr is actually T, not
                // T*).  The C++ reference compiler skips unused methods via
                // lazy monomorphization; for our eager pipeline we skip at
                // specialization time based on the structural self-match.
                mut kept: MethodNode*[] = [];
                for (mut mi: i64 = 0; mi < impl_node.methods.length; mi++) {
                    if (!this.method_has_modified_self_type(impl_node.methods[mi], entry)) {
                        kept.push(impl_node.methods[mi]);
                    }
                }
                impl_node.methods = kept;

                cloned_impl.accept(substituter);
                // Rename impl block target to specialized name and
                // clear generic params — the specialization is concrete.
                impl_node.set_target_type(spec_sym);
                impl_node.generic_params = [];
                impl_asts = impl_asts + [cloned_impl];
            }
        }

        // 7. Return
        return SpecializationResult::ok(cloned_ast, impl_asts, spec_name);
    }


    /// Detect methods whose `this` parameter is a Generic(base, args) where
    /// base matches the outer template name AND the args are NOT the identity
    /// mapping of the template's params.  Example: on `implement Result<T, E>`,
    /// `this: Result<T*, E>` has `T*` (not bare `T`) — a modified self-type.
    method_has_modified_self_type(&this, method: MethodNode*, entry: TemplateEntry*) -> boolean {
        if (method == null || method.func == null) { return false; }
        const func: FunctionDeclNode* = method.func;

        const this_amp:  SymbolStr = this.intern_table.intern("&this");
        const this_bare: SymbolStr = this.intern_table.intern("this");

        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null) { continue; }
            if (!param.name.equals(this_amp) && !param.name.equals(this_bare)) {
                continue;
            }
            if (param.type_annotation == null) { continue; }
            if (this.annotation_is_modified_outer(param.type_annotation, entry)) {
                return true;
            }
        }
        return false;
    }

    /// Recursively unwrap Reference/Pointer and return true iff the inner
    /// annotation is Generic(Named(entry.name), args) where any arg is NOT
    /// the bare outer param in its position.
    annotation_is_modified_outer(&this, ann: TypeAnnotation*, entry: TemplateEntry*) -> boolean {
        if (ann == null) { return false; }
        match (*ann) {
            TypeAnnotation::Reference(ref) => {
                return this.annotation_is_modified_outer(ref.inner, entry);
            }
            TypeAnnotation::Pointer(ptr) => {
                return this.annotation_is_modified_outer(ptr.inner, entry);
            }
            TypeAnnotation::Generic(gen) => {
                match (*gen.base) {
                    TypeAnnotation::Named(named) => {
                        if (!named.name.equals(entry.name)) { return false; }
                        if (gen.args.length != entry.param_count) { return false; }
                        for (mut i: i64 = 0; i < gen.args.length; i++) {
                            if (!this.annotation_is_bare_param(gen.args[i], entry.param_names[i])) {
                                return true;
                            }
                        }
                        return false;
                    }
                    _ => { return false; }
                }
            }
            _ => { return false; }
        }
        return false;
    }

    /// True iff `ann` is exactly `Named(expected_name)` with no wrappers.
    annotation_is_bare_param(&this, ann: TypeAnnotation*, expected_name: SymbolStr) -> boolean {
        if (ann == null) { return false; }
        match (*ann) {
            TypeAnnotation::Named(named) => { return named.name.equals(expected_name); }
            _ => { return false; }
        }
        return false;
    }
}
