/// Expression Codegen
///
/// Free functions for generating LLVM IR from each of the 24 expression
/// node types.  Each function takes a CodegenContext and the specific
/// node, and stores the result in the context for the caller to retrieve.

namespace Compiler::Codegen::ExprCodegen;

import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Codegen::TypeMap;
import Compiler::Codegen::Context;
import Compiler::CompilationContext;
import Compiler::Types;
import Compiler::Types::TypeRef;
import Compiler::Types::Type;
import Compiler::Types::Arena;
import Compiler::Types::UserDefined;
import Compiler::Types::Compound;
import Compiler::Types::Generic;
import Compiler::AST;
import Compiler::AST::Node;
import Compiler::AST::Expression;
import Compiler::AST::Declaration;
import Compiler::Lex;
import Compiler::Resolver::SymbolStr;
import Compiler::Resolver::InternTable;
import Compiler::Diag;
import Compiler::Diag::SourceSpan;


// ============================================================================
// Literal
// ============================================================================

/// Generate a constant value from a literal node.
function codegen_literal(cg: CodegenContext*, node: LiteralNode*,
                         out_value: LValue*, out_is_lvalue: boolean*) -> void {
    mut ty: LType = cg.type_mapper.map_type(node.resolved_type);

    *out_is_lvalue = false;

    const kind: LiteralKind = node.literal_kind;

    if (kind == LiteralKind::Integer) {
        // Use atoi for basic integer parsing (limited to i32 range).
        // TODO: Use a proper i64 parser when available.
        if (!ty.is_valid()) { ty = LType::i32(); }
        const val: i32 = atoi(node.value);
        *out_value = LType::const_int(ty, val as u64, true);
    } else if (kind == LiteralKind::Float) {
        if (!ty.is_valid()) { ty = LType::f64(); }
        mut val: f64 = 0.0;
        sscanf(node.value, "%lf", &val);
        *out_value = LType::const_real(ty, val);
    } else if (kind == LiteralKind::String) {
        *out_value = cg.get_or_create_string_literal(node.value);
    } else if (kind == LiteralKind::Char) {
        // Char is stored as i32.
        mut char_val: u64 = 0;
        if (strlen(node.value) > 0) {
            char_val = node.value[0] as u64;
        }
        *out_value = LType::const_int(LType::i32(), char_val, false);
    } else if (kind == LiteralKind::Boolean) {
        const bval: u64 = if (node.value == "true") { 1 } else { 0 };
        *out_value = LType::const_int(LType::i1(), bval, false);
    } else if (kind == LiteralKind::Null) {
        // Null literal must always be a pointer type.  If resolved_type
        // mapped to void or an invalid type, fall back to i8* (void*).
        // LLVMPointerTypeKind = 12 in the LLVM-C API.
        if (!ty.is_valid() || llvm::LLVMGetTypeKind(ty.raw) != 12) {
            ty = LType::pointer_to(LType::i8());
        }
        *out_value = LType::const_pointer_null(ty);
    } else {
        *out_value = LValue::null();
    }
}


// ============================================================================
// Identifier
// ============================================================================

/// Look up a named value (local, parameter, or global).
function codegen_identifier(cg: CodegenContext*, node: IdentifierNode*,
                            out_value: LValue*, out_is_lvalue: boolean*) -> void {
    // Built-in pseudo-macros: FILE and LINE expand to the source location of
    // the identifier reference.  These match the C++ reference compiler's
    // behavior (ExpressionCodegen.cpp handles `FILE` / `LINE` specially).
    const name_str: string = cg.resolve(node.name);
    if (strcmp(name_str, "FILE") == 0) {
        mut filename: string = node.span.file;
        if (filename == null || strlen(filename) == 0) {
            filename = "<unknown>";
        }
        *out_value = cg.builder.build_global_string_ptr(filename, "FILE.str");
        *out_is_lvalue = false;
        return;
    }
    if (strcmp(name_str, "LINE") == 0) {
        const line: u64 = node.span.start_line as u64;
        *out_value = LType::const_int(LType::i32(), line, false);
        *out_is_lvalue = false;
        return;
    }

    // Try local/parameter first.
    const local: LValue = cg.get_named_value(node.name);
    if (local.is_valid()) {
        *out_value = local;
        *out_is_lvalue = true;
        return;
    }

    // Try global.
    const global: LValue = resolve_global(cg, node.name);
    if (global.is_valid()) {
        *out_value = global;
        *out_is_lvalue = true;
        return;
    }

    // Try function (for function references / first-class functions).
    const func: LValue = resolve_function(cg, node.name);
    if (func.is_valid()) {
        *out_value = func;
        *out_is_lvalue = false;
        return;
    }

    *out_value = LValue::null();
    *out_is_lvalue = false;
}


// ============================================================================
// Binary Expression
// ============================================================================

/// Generate IR for a binary expression.  Handles arithmetic, comparison,
/// logical short-circuit, and assignment operators.
function codegen_binary(cg: CodegenContext*, lhs_val: LValue, rhs_val: LValue,
                        op_kind: TokenType, result_type: TypeRef,
                        out_value: LValue*) -> void {
    if (!lhs_val.is_valid() || !rhs_val.is_valid()) {
        *out_value = LValue::null();
        return;
    }
    // Determine if this is integer, float, or pointer arithmetic.
    // Follow InstantiatedType chain to get the concrete type.
    mut t: Type* = cg.lookup_type_by_id(result_type.id);
    mut bd: i32 = 0;
    while (t != null && t.kind == TypeKind::InstantiatedType && bd < 5) {
        const binst: InstantiatedType* = t as InstantiatedType*;
        if (binst.has_resolved_type()) {
            t = cg.lookup_type_by_id(binst.resolved_type.id);
        } else { break; }
        bd = bd + 1;
    }
    mut t_kind: TypeKind = TypeKind::Error;
    if (t != null) { t_kind = t.kind; }

    // String ops.  Strings are null-terminated `i8*` at the LLVM level.
    //   `==`/`!=` → strcmp
    //   `+` string + string → append (concat into fresh heap buffer)
    //   `+` string + int    → pointer advancement (GEP over i8)
    if (t_kind == TypeKind::String) {
        if (op_kind == TokenType::EqualEqual || op_kind == TokenType::ExclaimEqual) {
            codegen_string_compare(cg, lhs_val, rhs_val, op_kind, out_value);
            return;
        }
        if (op_kind == TokenType::Plus) {
            // Decide concat vs pointer-advance by the RHS's LLVM type.
            // Both operands are already rvalues at this point.
            const rhs_llvm: void* = llvm::LLVMTypeOf(rhs_val.raw);
            if (rhs_llvm != null && llvm::LLVMGetTypeKind(rhs_llvm) == 8) {
                // string + int → GEP i8 for pointer arithmetic.  Caller
                // uses this idiom for substring-from-offset, C-string
                // walking, etc.
                const buf: void* = malloc(8);
                const slots: void** = buf as void**;
                slots[0] = rhs_val.raw;
                *out_value = cg.builder.build_gep(
                    LType::i8(), lhs_val, buf, 1, "ptradv");
                free(buf);
                return;
            }
            // string + string → call std::core::primitives::string::append.
            // The stdlib already provides this as a method on `string`;
            // every module gets it via cross-module extern declarations.
            const intern: InternTable* = cg.get_intern();
            const fn_sym: SymbolStr = intern.intern(
                "std::core::primitives::string::append");
            const fn_val: LValue = resolve_function(cg, fn_sym);
            if (!fn_val.is_valid()) {
                *out_value = LValue::null();
                return;
            }
            const fn_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(fn_val.raw) };
            mut args: LValue[] = [];
            args.push(lhs_val);
            args.push(rhs_val);
            codegen_call(cg, fn_val, fn_ty, args, "strcat", out_value);
            return;
        }
        // Ordered comparison between two strings (i.e. raw `char*`
        // buffer walking — `this.current >= this.buffer_end`).  LLVM
        // allows `icmp` directly on matching pointer types; treat as
        // unsigned since address space is unsigned.  Without this,
        // `codegen_binary` fell through to the null-return below and
        // stripped any method body containing such a comparison.
        if (op_kind == TokenType::LAngle || op_kind == TokenType::RAngle ||
            op_kind == TokenType::LessEqual || op_kind == TokenType::GreaterEqual) {
            mut icmp_op: i32 = 36;  // IntULT (default)
            if (op_kind == TokenType::RAngle) {
                icmp_op = 34;  // IntUGT
            } else if (op_kind == TokenType::LessEqual) {
                icmp_op = 37;  // IntULE
            } else if (op_kind == TokenType::GreaterEqual) {
                icmp_op = 35;  // IntUGE
            }
            *out_value = cg.builder.build_icmp(icmp_op, lhs_val, rhs_val, "ptrcmp");
            return;
        }
        *out_value = LValue::null();
        return;
    }

    // Enum comparison: compare i32 discriminant tags.
    // For simple enums the value is already i32.
    // For ADT enums extract field 0 (the tag) first.
    if (t_kind == TypeKind::Enum) {
        if (op_kind == TokenType::EqualEqual || op_kind == TokenType::ExclaimEqual) {
            mut lhs_tag: LValue = lhs_val;
            mut rhs_tag: LValue = rhs_val;
            // Check if this is an ADT enum (struct type in LLVM) or simple (i32).
            const lhs_llvm_ty: void* = llvm::LLVMTypeOf(lhs_val.raw);
            if (lhs_llvm_ty != null && llvm::LLVMGetTypeKind(lhs_llvm_ty) == 10) {
                // LLVMStructTypeKind = 10 — extract tag at index 0.
                // (13 is LLVMVectorTypeKind; the old constant was wrong,
                // which made every ADT-enum `==` compare full structs
                // and fail `icmp requires integer operands` at verify.)
                lhs_tag = cg.builder.build_extract_value(lhs_val, 0, "lhs.tag");
                rhs_tag = cg.builder.build_extract_value(rhs_val, 0, "rhs.tag");
            }
            if (op_kind == TokenType::EqualEqual) {
                *out_value = cg.builder.build_icmp(32, lhs_tag, rhs_tag, "enum.eq");
            } else {
                *out_value = cg.builder.build_icmp(33, lhs_tag, rhs_tag, "enum.ne");
            }
            return;
        }
        *out_value = LValue::null();
        return;
    }

    // Bail out if the operand type is not numeric, pointer, or function.
    // Operating on void/error/unresolved types crashes LLVM.  Function
    // types are included so that `fn_ptr != null` and `fn_ptr == fn_ptr`
    // checks reach the icmp path below — both lower to LLVM `ptr`, so the
    // existing pointer-comparison logic works unchanged.
    if (t_kind != TypeKind::Int && t_kind != TypeKind::Float &&
        t_kind != TypeKind::Bool && t_kind != TypeKind::Pointer &&
        t_kind != TypeKind::Char && t_kind != TypeKind::Function) {
        *out_value = LValue::null();
        return;
    }

    // Pointer + int / Pointer - int → GEP over the pointee type.
    // LLVM rejects `add ptr, i64`; the arithmetic must be expressed
    // as a getelementptr with a scaled integer index.  Matches the
    // string-plus-int path above but for typed pointers (`i8*`, `u8*`
    // etc. used for C-string or buffer walking).
    if (t_kind == TypeKind::Pointer &&
        (op_kind == TokenType::Plus || op_kind == TokenType::Minus)) {
        const ptr_t: PointerType* = t as PointerType*;
        const pointee_lty: LType = cg.type_mapper.map_type(ptr_t.pointee);
        if (pointee_lty.is_valid()) {
            mut idx: LValue = rhs_val;
            if (op_kind == TokenType::Minus) {
                idx = cg.builder.build_neg(rhs_val, "gep.neg");
            }
            const buf: void* = malloc(8);
            const slots: void** = buf as void**;
            slots[0] = idx.raw;
            *out_value = cg.builder.build_gep(
                pointee_lty, lhs_val, buf, 1, "ptradv");
            free(buf);
            return;
        }
    }

    const is_float: boolean = t_kind == TypeKind::Float;
    mut is_signed: boolean = false;
    if (t_kind == TypeKind::Int) {
        const int_t: IntType* = t as IntType*;
        const ik: IntegerKind = int_t.int_kind;
        is_signed = ik.is_signed();
    }

    // Normalize integer operand widths.
    // LLVM requires both operands to binary ops (icmp, add, shl, etc.)
    // to have the same type.  If they differ (e.g., i32 vs i64),
    // extend the narrower one to match the wider.
    mut lhs: LValue = lhs_val;
    mut rhs: LValue = rhs_val;
    if (!is_float) {
        const lhs_ty: void* = llvm::LLVMTypeOf(lhs.raw);
        const rhs_ty: void* = llvm::LLVMTypeOf(rhs.raw);
        // LLVMIntegerTypeKind = 8, LLVMPointerTypeKind = 12
        const lhs_kind: i32 = llvm::LLVMGetTypeKind(lhs_ty);
        const rhs_kind: i32 = llvm::LLVMGetTypeKind(rhs_ty);
        if (lhs_ty != null && rhs_ty != null &&
            lhs_kind == 8 && rhs_kind == 8) {
            const lhs_w: u32 = llvm::LLVMGetIntTypeWidth(lhs_ty);
            const rhs_w: u32 = llvm::LLVMGetIntTypeWidth(rhs_ty);
            if (lhs_w < rhs_w) {
                const target: LType = LType { raw: rhs_ty };
                if (is_signed) {
                    lhs = cg.builder.build_sext(lhs, target, "widen");
                } else {
                    lhs = cg.builder.build_zext(lhs, target, "widen");
                }
            } else if (rhs_w < lhs_w) {
                const target: LType = LType { raw: lhs_ty };
                if (is_signed) {
                    rhs = cg.builder.build_sext(rhs, target, "widen");
                } else {
                    rhs = cg.builder.build_zext(rhs, target, "widen");
                }
            }
        } else if (lhs_ty != null && rhs_ty != null &&
                   lhs_kind == 8 && rhs_kind == 12) {
            // int <op> ptr — coerce int to ptr so icmp on two pointers
            // succeeds.  Mirrors the bootstrap's ensure_compatible_types
            // path; address comparisons in stdlib (e.g., aligned_addr <
            // base + offset where the int side holds a ptrtoint'd address)
            // depend on this.
            const ptr_ty: LType = LType { raw: rhs_ty };
            lhs = cg.builder.build_int_to_ptr(lhs, ptr_ty, "int2ptr");
        } else if (lhs_ty != null && rhs_ty != null &&
                   lhs_kind == 12 && rhs_kind == 8) {
            const ptr_ty: LType = LType { raw: lhs_ty };
            rhs = cg.builder.build_int_to_ptr(rhs, ptr_ty, "int2ptr");
        }
    }

    // Arithmetic
    if (op_kind == TokenType::Plus) {
        *out_value = if (is_float) {
            cg.builder.build_fadd(lhs, rhs, "addtmp")
        } else {
            cg.builder.build_add(lhs, rhs, "addtmp")
        };
    } else if (op_kind == TokenType::Minus) {
        *out_value = if (is_float) {
            cg.builder.build_fsub(lhs, rhs, "subtmp")
        } else {
            cg.builder.build_sub(lhs, rhs, "subtmp")
        };
    } else if (op_kind == TokenType::Star) {
        *out_value = if (is_float) {
            cg.builder.build_fmul(lhs, rhs, "multmp")
        } else {
            cg.builder.build_mul(lhs, rhs, "multmp")
        };
    } else if (op_kind == TokenType::Slash) {
        *out_value = if (is_float) {
            cg.builder.build_fdiv(lhs, rhs, "divtmp")
        } else { if (is_signed) {
            cg.builder.build_sdiv(lhs, rhs, "divtmp")
        } else {
            cg.builder.build_udiv(lhs, rhs, "divtmp")
        } };
    } else if (op_kind == TokenType::Percent) {
        *out_value = if (is_float) {
            cg.builder.build_frem(lhs, rhs, "remtmp")
        } else { if (is_signed) {
            cg.builder.build_srem(lhs, rhs, "remtmp")
        } else {
            cg.builder.build_urem(lhs, rhs, "remtmp")
        } };

    // Comparison
    } else if (op_kind == TokenType::EqualEqual) {
        *out_value = if (is_float) {
            cg.builder.build_fcmp(1 /* OEQ */, lhs, rhs, "eqtmp")
        } else {
            cg.builder.build_icmp(32 /* IntEQ */, lhs, rhs, "eqtmp")
        };
    } else if (op_kind == TokenType::ExclaimEqual) {
        *out_value = if (is_float) {
            cg.builder.build_fcmp(6 /* ONE */, lhs, rhs, "netmp")
        } else {
            cg.builder.build_icmp(33 /* IntNE */, lhs, rhs, "netmp")
        };
    } else if (op_kind == TokenType::LAngle) {
        *out_value = if (is_float) {
            cg.builder.build_fcmp(4 /* OLT */, lhs, rhs, "lttmp")
        } else { if (is_signed) {
            cg.builder.build_icmp(40 /* IntSLT */, lhs, rhs, "lttmp")
        } else {
            cg.builder.build_icmp(36 /* IntULT */, lhs, rhs, "lttmp")
        } };
    } else if (op_kind == TokenType::RAngle) {
        *out_value = if (is_float) {
            cg.builder.build_fcmp(2 /* OGT */, lhs, rhs, "gttmp")
        } else { if (is_signed) {
            cg.builder.build_icmp(38 /* IntSGT */, lhs, rhs, "gttmp")
        } else {
            cg.builder.build_icmp(34 /* IntUGT */, lhs, rhs, "gttmp")
        } };
    } else if (op_kind == TokenType::LessEqual) {
        *out_value = if (is_float) {
            cg.builder.build_fcmp(5 /* OLE */, lhs, rhs, "letmp")
        } else { if (is_signed) {
            cg.builder.build_icmp(41 /* IntSLE */, lhs, rhs, "letmp")
        } else {
            cg.builder.build_icmp(37 /* IntULE */, lhs, rhs, "letmp")
        } };
    } else if (op_kind == TokenType::GreaterEqual) {
        *out_value = if (is_float) {
            cg.builder.build_fcmp(3 /* OGE */, lhs, rhs, "getmp")
        } else { if (is_signed) {
            cg.builder.build_icmp(39 /* IntSGE */, lhs, rhs, "getmp")
        } else {
            cg.builder.build_icmp(35 /* IntUGE */, lhs, rhs, "getmp")
        } };

    // Bitwise
    } else if (op_kind == TokenType::Amp) {
        *out_value = cg.builder.build_and(lhs, rhs, "andtmp");
    } else if (op_kind == TokenType::Pipe) {
        *out_value = cg.builder.build_or(lhs, rhs, "ortmp");
    } else if (op_kind == TokenType::Caret) {
        *out_value = cg.builder.build_xor(lhs, rhs, "xortmp");
    } else if (op_kind == TokenType::LessLess) {
        *out_value = cg.builder.build_shl(lhs, rhs, "shltmp");
    } else if (op_kind == TokenType::GreaterGreater) {
        *out_value = if (is_signed) {
            cg.builder.build_ashr(lhs, rhs, "shrtmp")
        } else {
            cg.builder.build_lshr(lhs, rhs, "shrtmp")
        };

    } else {
        *out_value = LValue::null();
    }
}


// ============================================================================
// Unary Expression
// ============================================================================

function codegen_unary(cg: CodegenContext*, operand: LValue, op_kind: TokenType,
                       operand_type: TypeRef, out_value: LValue*) -> void {
    const t: Type* = cg.lookup_type_by_id(operand_type.id);
    mut t_kind: TypeKind = TypeKind::Error;
    if (t != null) { t_kind = t.kind; }
    const is_float: boolean = t_kind == TypeKind::Float;

    if (op_kind == TokenType::Minus) {
        *out_value = if (is_float) {
            cg.builder.build_fneg(operand, "negtmp")
        } else {
            cg.builder.build_neg(operand, "negtmp")
        };
    } else if (op_kind == TokenType::Exclaim) {
        *out_value = cg.builder.build_not(operand, "nottmp");
    } else if (op_kind == TokenType::Tilde) {
        *out_value = cg.builder.build_not(operand, "bnottmp");
    } else {
        *out_value = LValue::null();
    }
}


// ============================================================================
// Call Expression
// ============================================================================

/// Generate IR for a function call.
/// Coerces integer argument widths to match the callee's LLVM parameter
/// types (e.g., i8→i32 for memset, i32→i64 for u64 params).
function codegen_call(cg: CodegenContext*, callee: LValue, callee_type: LType,
                      args: LValue[], name: string,
                      out_value: LValue*) -> void {
    const n: u32 = args.length as u32;

    if (n == 0) {
        *out_value = cg.builder.build_call(callee_type, callee, null, 0, name);
        return;
    }

    // Get expected parameter types for argument coercion.
    // callee_type is the function type passed to LLVMBuildCall2.
    // Even though LLVMGetTypeKind may report it as pointer (opaque ptr era),
    // LLVMCountParamTypes still works on function types.
    // Also try LLVMCountParams on the callee value as fallback.
    mut expected_count: u32 = llvm::LLVMCountParamTypes(callee_type.raw);
    mut param_types_buf: void* = null;
    if (expected_count > 0 && expected_count <= 64) {
        param_types_buf = malloc(expected_count as u64 * 8);
        llvm::LLVMGetParamTypes(callee_type.raw, param_types_buf);
    }

    // Build argument array, coercing integer widths where needed.
    const buf: void* = malloc(n as u64 * 8);
    const slots: void** = buf as void**;
    const param_types: void** = param_types_buf as void**;
    for (mut i: u32 = 0; i < n; i++) {
        mut arg_val: LValue = args[i];
        if (arg_val.is_valid() && param_types_buf != null && i < expected_count) {
            const expected_ty: void* = param_types[i];
            const actual_ty: void* = llvm::LLVMTypeOf(arg_val.raw);
            // Compare by type kind — void* pointer equality is broken in the
            // Cryo compiler (always returns true), so we cannot rely on
            // expected_ty != actual_ty to detect mismatches.
            const ek: i32 = llvm::LLVMGetTypeKind(expected_ty);
            const ak: i32 = llvm::LLVMGetTypeKind(actual_ty);
            if (ek != ak) {
                if (ek == 12 && ak == 10) {
                    // Expected ptr (12), actual struct (10): store struct to
                    // temp alloca and pass its address.  This handles passing
                    // `this` (struct value) to a function expecting &this (ptr).
                    const st: LType = LType { raw: actual_ty };
                    const tmp: LValue = cg.builder.build_alloca(st, "arg.ref");
                    cg.builder.build_store(arg_val, tmp);
                    arg_val = tmp;
                } else if (ek == 10 && ak == 12) {
                    // Expected struct by value (10), actual ptr (12): load
                    // the struct from the pointer.  Handles by-value struct
                    // args where the caller has the struct via a pointer
                    // field or local (e.g. `ctx.diagnostics` typed as
                    // `DiagnosticSink*` being passed to a function that
                    // takes `DiagnosticSink` by value).
                    const st: LType = LType { raw: expected_ty };
                    arg_val = cg.builder.build_load(st, arg_val, "arg.deref");
                } else if ((ek == 2 || ek == 3) && ak == 12) {
                    // Expected float (2) or double (3), actual ptr (12):
                    // load the float through the pointer.  Happens for
                    // by-value primitive receivers — e.g. `f64::trunc(this) -> f64`
                    // called as `(&this).trunc()` where `&this` is a ptr to f64.
                    const ft: LType = LType { raw: expected_ty };
                    arg_val = cg.builder.build_load(ft, arg_val, "arg.deref");
                } else if (ek == 8 && ak == 12 && expected_count > 0 && i == 0) {
                    // Expected integer (8), actual ptr (12) for the receiver
                    // (i==0): same scenario — by-value primitive `this` on
                    // an integer-kind type.  Load the integer.  We restrict
                    // to i==0 (the receiver slot) to avoid colliding with
                    // the legitimate ptrtoint coercion for non-receiver args.
                    const it: LType = LType { raw: expected_ty };
                    arg_val = cg.builder.build_load(it, arg_val, "arg.deref");
                } else if (ek == 12 && ak == 8) {
                    // Expected ptr (12), actual integer: inttoptr.
                    const target: LType = LType { raw: expected_ty };
                    arg_val = LValue { raw: llvm::LLVMBuildIntToPtr(cg.builder.raw, arg_val.raw, expected_ty, "arg.i2p") };
                } else if (ek == 8 && ak == 12) {
                    // Expected integer, actual ptr: ptrtoint.
                    const target: LType = LType { raw: expected_ty };
                    arg_val = LValue { raw: llvm::LLVMBuildPtrToInt(cg.builder.raw, arg_val.raw, expected_ty, "arg.p2i") };
                }
            } else if (ek == 8 && ak == 8) {
                // Both integers — coerce widths if needed.
                const ew: u32 = llvm::LLVMGetIntTypeWidth(expected_ty);
                const aw: u32 = llvm::LLVMGetIntTypeWidth(actual_ty);
                if (aw < ew) {
                    const target: LType = LType { raw: expected_ty };
                    arg_val = cg.builder.build_zext(arg_val, target, "arg.widen");
                } else if (aw > ew) {
                    const target: LType = LType { raw: expected_ty };
                    arg_val = cg.builder.build_trunc(arg_val, target, "arg.trunc");
                }
            }
        }
        slots[i] = arg_val.raw;
    }
    if (param_types_buf != null) { free(param_types_buf); }

    *out_value = cg.builder.build_call(callee_type, callee, buf, n, name);
    free(buf);
}


// ============================================================================
// Sizeof / Alignof
// ============================================================================

function codegen_sizeof(cg: CodegenContext*, type_ref: TypeRef,
                        out_value: LValue*) -> void {
    const t: Type* = cg.lookup_type_by_id(type_ref.id);
    if (t != null) {
        *out_value = LType::const_int(LType::i64(), t.size_bytes(), false);
    } else {
        *out_value = LType::const_int(LType::i64(), 0, false);
    }
}

function codegen_alignof(cg: CodegenContext*, type_ref: TypeRef,
                         out_value: LValue*) -> void {
    const t: Type* = cg.lookup_type_by_id(type_ref.id);
    if (t != null) {
        *out_value = LType::const_int(LType::i64(), t.alignment(), false);
    } else {
        *out_value = LType::const_int(LType::i64(), 0, false);
    }
}


// ============================================================================
// Cast Expression
// ============================================================================

function codegen_cast(cg: CodegenContext*, val: LValue,
                      from_type: TypeRef, to_type: TypeRef,
                      out_value: LValue*) -> void {
    const src_type: Type* = cg.lookup_type_by_id(from_type.id);
    const dst_type: Type* = cg.lookup_type_by_id(to_type.id);
    if (src_type == null || dst_type == null) {
        *out_value = val;
        return;
    }

    const dest_ty: LType = cg.type_mapper.map_type(to_type);

    const from_kind: TypeKind = src_type.kind;
    const to_kind: TypeKind = dst_type.kind;
    // Treat Char and Bool as integer-like for cast purposes — both are
    // integer types at the LLVM level (i32 and i1 respectively).  Without
    // including Char here, casts like `s[i] as u64` (where `s[i]: char`)
    // fall through to the bitcast fallback and LLVM rejects
    // `bitcast i32 to i64` (bitcast requires same-size operands).
    const from_int: boolean = from_kind == TypeKind::Int || from_kind == TypeKind::Char;
    const from_float: boolean = from_kind == TypeKind::Float;
    const to_int: boolean = to_kind == TypeKind::Int || to_kind == TypeKind::Char;
    const to_float: boolean = to_kind == TypeKind::Float;
    // Treat `String` as a pointer type for cast classification — strings
    // are `i8*` at the LLVM level, so `string as i64` is semantically a
    // ptrtoint (not a bitcast, which requires same-size operands and
    // LLVM rejects for pointer ↔ integer).  Same for `i64 as string`
    // (inttoptr) and `string ↔ some_other_pointer` (pointer_cast / no-op
    // under opaque pointers).
    const from_ptr: boolean = from_kind == TypeKind::Pointer ||
                              from_kind == TypeKind::Reference ||
                              from_kind == TypeKind::String;
    const to_ptr: boolean = to_kind == TypeKind::Pointer ||
                            to_kind == TypeKind::Reference ||
                            to_kind == TypeKind::String;

    // Int → Int (truncate, zext, or sext).  Determine bit widths via the
    // cryo-level type where possible (IntType's `int_kind.bit_width()`);
    // Char is stored as i32 at the LLVM level but is its own TypeKind,
    // so fall back to 32 bits for it without dereferencing `val.raw`
    // (which may be null on upstream codegen failures — LLVMTypeOf would
    // segfault on a null operand).  The target width comes from LLVM
    // since `dest_ty` was freshly mapped above and guaranteed non-null
    // when both kinds are int-like.
    if (from_int && to_int) {
        mut from_bits: u32 = 0;
        mut signed_src: boolean = false;
        if (from_kind == TypeKind::Int) {
            const from_it: IntType* = src_type as IntType*;
            from_bits = from_it.int_kind.bit_width() as u32;
            signed_src = from_it.int_kind.is_signed();
        } else if (from_kind == TypeKind::Char) {
            from_bits = 32;
            signed_src = false;
        }
        mut to_bits: u32 = 0;
        if (to_kind == TypeKind::Int) {
            const to_it: IntType* = dst_type as IntType*;
            to_bits = to_it.int_kind.bit_width() as u32;
        } else if (to_kind == TypeKind::Char) {
            to_bits = 32;
        }
        if (from_bits == 0 || to_bits == 0 || !val.is_valid()) {
            *out_value = val;
        } else if (from_bits > to_bits) {
            *out_value = cg.builder.build_trunc(val, dest_ty, "trunctmp");
        } else if (from_bits < to_bits) {
            if (signed_src) {
                *out_value = cg.builder.build_sext(val, dest_ty, "sexttmp");
            } else {
                *out_value = cg.builder.build_zext(val, dest_ty, "zexttmp");
            }
        } else {
            *out_value = val;  // Same width, no-op.
        }
    // Float → Float
    } else if (from_float && to_float) {
        const from_ft: FloatType* = src_type as FloatType*;
        const to_ft: FloatType* = dst_type as FloatType*;
        const from_fk: FloatKind = from_ft.float_kind;
        const to_fk: FloatKind = to_ft.float_kind;
        const from_bits: u64 = from_fk.bit_width();
        const to_bits: u64 = to_fk.bit_width();
        if (from_bits > to_bits) {
            *out_value = cg.builder.build_fp_trunc(val, dest_ty, "fptrunctmp");
        } else if (from_bits < to_bits) {
            *out_value = cg.builder.build_fp_ext(val, dest_ty, "fpexttmp");
        } else {
            *out_value = val;
        }
    // Int → Float
    } else if (from_int && to_float) {
        const from_it2: IntType* = src_type as IntType*;
        const from_ik2: IntegerKind = from_it2.int_kind;
        if (from_ik2.is_signed()) {
            *out_value = cg.builder.build_si_to_fp(val, dest_ty, "sitofptmp");
        } else {
            *out_value = cg.builder.build_ui_to_fp(val, dest_ty, "uitofptmp");
        }
    // Float → Int
    } else if (from_float && to_int) {
        const to_it2: IntType* = dst_type as IntType*;
        const to_ik2: IntegerKind = to_it2.int_kind;
        if (to_ik2.is_signed()) {
            *out_value = cg.builder.build_fp_to_si(val, dest_ty, "fptositmp");
        } else {
            *out_value = cg.builder.build_fp_to_ui(val, dest_ty, "fptouitmp");
        }
    // Pointer ↔ Pointer
    } else if (from_ptr && to_ptr) {
        *out_value = cg.builder.build_pointer_cast(val, dest_ty, "ptrcasttmp");
    // Int → Pointer
    } else if (from_int && to_ptr) {
        *out_value = cg.builder.build_int_to_ptr(val, dest_ty, "inttoptr");
    // Pointer → Int
    } else if (from_ptr && to_int) {
        *out_value = cg.builder.build_ptr_to_int(val, dest_ty, "ptrtoint");
    // Bool to int
    } else if (from_kind == TypeKind::Bool && to_int) {
        *out_value = cg.builder.build_zext(val, dest_ty, "booltoint");
    // Fallback: bitcast
    } else {
        *out_value = cg.builder.build_bitcast(val, dest_ty, "bitcasttmp");
    }
}


// ============================================================================
// Member Access
// ============================================================================

/// Generate a GEP to a struct/class field.  `site_span` is the source span
/// of the access expression in the caller; used only to attach a source
/// snippet to any diagnostic we emit.
function codegen_member_access(cg: CodegenContext*, object_ptr: LValue,
                               object_type: TypeRef, member: SymbolStr,
                               out_value: LValue*, out_is_lvalue: boolean*,
                               site_span: SourceSpan) -> void {
    // Auto-deref: if the object is a pointer/reference (e.g., `node: ExprStmtNode*`
    // stored in an alloca), load the pointer value so we can GEP into the struct.
    // This matches C/Rust behavior where `node.field` on a pointer is an implicit
    // deref.  Applied once per call — GEP'd field pointers stay as struct pointers.
    mut obj_ptr: LValue = object_ptr;
    mut obj_type: TypeRef = object_type;
    mut t: Type* = cg.lookup_type_by_id(obj_type.id);

    // Unwrap InstantiatedType to its concrete resolved form before kind-based
    // dispatch.  Sema does the same in `check_field_access` — without this,
    // a `Pair<string>` resolves to an `InstantiatedType` whose kind isn't
    // Struct/Class/Array, and every field/length access silently returns null.
    mut inst_depth: i32 = 0;
    while (t != null && t.kind == TypeKind::InstantiatedType && inst_depth < 5) {
        const inst: InstantiatedType* = t as InstantiatedType*;
        if (!inst.has_resolved_type()) { break; }
        obj_type = inst.resolved_type;
        t = cg.lookup_type_by_id(obj_type.id);
        inst_depth = inst_depth + 1;
    }

    if (t != null && (t.kind == TypeKind::Pointer || t.kind == TypeKind::Reference)) {
        if (t.kind == TypeKind::Pointer) {
            const pt: PointerType* = t as PointerType*;
            obj_type = pt.pointee;
        } else {
            const rt: ReferenceType* = t as ReferenceType*;
            obj_type = rt.referent;
        }
        t = cg.lookup_type_by_id(obj_type.id);

        // Load the pointer value through the alloca (if object_ptr is an lvalue
        // pointing to a ptr slot).  Skip when object_ptr is already the ptr
        // value — e.g., `&this` parameters are stored raw in named_values.
        if (obj_ptr.is_valid()) {
            const obj_llvm_ty: void* = llvm::LLVMTypeOf(obj_ptr.raw);
            if (obj_llvm_ty != null && llvm::LLVMGetTypeKind(obj_llvm_ty) == 12) {
                // LLVMPointerTypeKind = 12.  In practice all named_values are
                // stored as pointer-typed LLVM values, so this always holds;
                // the load is correct either way (load ptr from ptr-to-ptr).
                obj_ptr = cg.builder.build_load(LType::pointer_to(LType::i8()),
                                                obj_ptr, "autoderef");
            }
        }
    }

    // The pointee of a Pointer/Reference may itself be an InstantiatedType
    // (e.g. `HashMapEntry<u32, i64>` sitting in the arena as the pointee of a
    // `HashMapEntry<u32, i64>*`). Mirror the pre-Pointer unwrap above so the
    // kind dispatch below sees the concrete Struct/Class/Array; without this,
    // field_idx stays -1, the access silently emits no IR, and the
    // half-emitted basic block gets stripped by `is_function_body_valid`.
    mut inst_depth2: i32 = 0;
    while (t != null && t.kind == TypeKind::InstantiatedType && inst_depth2 < 5) {
        const inst: InstantiatedType* = t as InstantiatedType*;
        if (!inst.has_resolved_type()) { break; }
        obj_type = inst.resolved_type;
        t = cg.lookup_type_by_id(obj_type.id);
        inst_depth2 = inst_depth2 + 1;
    }

    if (t == null) {
        *out_value = LValue::null();
        *out_is_lvalue = false;
        return;
    }

    const tk: TypeKind = t.kind;
    mut field_idx: i64 = -1;

    if (tk == TypeKind::Struct) {
        const st: StructType* = t as StructType*;
        field_idx = st.field_index(member);
    } else if (tk == TypeKind::Class) {
        // Classes are flattened at struct-layout time (see `map_class`):
        //   [ vtable ptr, if any ancestor has virtual methods ]
        //   [ root class's fields, then each derived class's fields in order ]
        //   [ this class's own fields ]
        // Walk the base chain root-first and sum field counts to get the
        // absolute slot index.
        const cls: ClassType* = t as ClassType*;
        mut chain: ClassType*[] = [];
        mut any_virtual: boolean = false;
        mut walk: ClassType* = cls;
        mut depth: i32 = 0;
        while (walk != null && depth < 16) {
            chain.push(walk);
            if (walk.has_virtual_methods) { any_virtual = true; }
            if (!walk.has_base || !walk.base_class.is_valid()) { break; }
            const base_t: Type* = cg.lookup_type_by_id(walk.base_class.id);
            if (base_t == null || base_t.kind != TypeKind::Class) { break; }
            walk = base_t as ClassType*;
            depth = depth + 1;
        }

        mut cumulative: i64 = if (any_virtual) { 1 } else { 0 };
        for (mut ci: i64 = chain.length - 1; ci >= 0; ci--) {
            const link: ClassType* = chain[ci];
            const local_idx: i64 = link.field_index(member);
            if (local_idx >= 0) {
                field_idx = cumulative + local_idx;
                break;
            }
            cumulative = cumulative + link.fields.length;
        }
    } else if (tk == TypeKind::Array) {
        const arr_t: ArrayType* = t as ArrayType*;
        const length_sym: SymbolStr = cg.intern_str("length");
        if (member.id == length_sym.id) {
            if (arr_t.is_fixed()) {
                // Fixed array: length is a compile-time constant.
                *out_value = LType::const_int(LType::i64(), arr_t.size as u64, false);
                *out_is_lvalue = false;
                return;
            }
            // Dynamic array { T*, i64 }: length is field 1.
            field_idx = 1;
        }
    }

    if (field_idx < 0) {
        *out_value = LValue::null();
        *out_is_lvalue = false;
        return;
    }

    const struct_ty: LType = cg.type_mapper.map_type(obj_type);
    if (!struct_ty.is_valid()) {
        cg.emit_error_at_span(ErrorCode::E0622_MEMBER_ACCESS_ERROR,
            "codegen: member access — failed to map object type to LLVM type",
            site_span);
        *out_value = LValue::null();
        *out_is_lvalue = false;
        return;
    }
    if (!obj_ptr.is_valid()) {
        cg.emit_error_at_span(ErrorCode::E0622_MEMBER_ACCESS_ERROR,
            "codegen: member access — object pointer is null",
            site_span);
        *out_value = LValue::null();
        *out_is_lvalue = false;
        return;
    }
    // If `obj_ptr` is a struct VALUE (e.g., a direct return from a
    // function call: `f().field`), it isn't a GEP-able address.  Use
    // `extractvalue` to pull out the field from the value and return
    // an rvalue.  LLVMStructTypeKind = 10; under opaque pointers an
    // actual pointer has kind 12, so the check is unambiguous.
    const obj_llvm_ty: void* = llvm::LLVMTypeOf(obj_ptr.raw);
    if (obj_llvm_ty != null && llvm::LLVMGetTypeKind(obj_llvm_ty) == 10) {
        *out_value = cg.builder.build_extract_value(
            obj_ptr, field_idx as u32, "fieldval");
        *out_is_lvalue = false;
        return;
    }
    const gep: LValue = cg.builder.build_struct_gep(struct_ty, obj_ptr,
                                                      field_idx as u32, "fieldptr");
    *out_value = gep;
    *out_is_lvalue = true;
}


// ============================================================================
// Array Access
// ============================================================================

/// Generate a GEP for array element access.  `site_span` is the source
/// span of the access expression in the caller; used for diagnostics.
function codegen_array_access(cg: CodegenContext*, array_val: LValue,
                              array_type: TypeRef, index_val: LValue,
                              out_value: LValue*, out_is_lvalue: boolean*,
                              site_span: SourceSpan) -> void {
    const t: Type* = cg.lookup_type_by_id(array_type.id);
    if (t == null) {
        *out_value = LValue::null();
        *out_is_lvalue = false;
        return;
    }

    // Pointer indexing (C-style `ptr[i]` ≡ `*(ptr + i)`).  `array_val` is an
    // lvalue holding the ptr — load it, then GEP element_ty to the ith slot.
    if (t.kind == TypeKind::Pointer) {
        const pt: PointerType* = t as PointerType*;
        const elem_ty: LType = cg.type_mapper.map_type(pt.pointee);
        if (!elem_ty.is_valid() || !array_val.is_valid() || !index_val.is_valid()) {
            *out_value = LValue::null();
            *out_is_lvalue = false;
            return;
        }
        const ptr_ty: LType = LType::pointer_to(elem_ty);
        const data_ptr: LValue = cg.builder.build_load(ptr_ty, array_val, "ptrload");
        const buf: void* = malloc(8);
        const slots: void** = buf as void**;
        slots[0] = index_val.raw;
        const gep: LValue = cg.builder.build_gep(elem_ty, data_ptr, buf, 1, "elemptr");
        free(buf);
        *out_value = gep;
        *out_is_lvalue = true;
        return;
    }

    // String indexing (`s[i]`) — treat the string as `i8*` at the LLVM
    // level.  Return the byte's address as an lvalue so it can be used
    // on both sides of an assignment (`c = s[i]` AND `s[i] = c`).  The
    // `char` (i32) vs byte (i8) size mismatch is resolved by the callers
    // (`codegen_rvalue` load-and-zext for reads, the assignment path
    // trunc-and-store for writes — both look for the `TypeKind::String`
    // source type to detect this case).
    if (t.kind == TypeKind::String) {
        if (!array_val.is_valid() || !index_val.is_valid()) {
            *out_value = LValue::null();
            *out_is_lvalue = false;
            return;
        }
        const i8_ty: LType = LType::i8();
        const i8_ptr_ty: LType = LType::pointer_to(i8_ty);
        const data_ptr: LValue = cg.builder.build_load(i8_ptr_ty, array_val, "strptr");
        const buf: void* = malloc(8);
        const slots: void** = buf as void**;
        slots[0] = index_val.raw;
        const byte_ptr: LValue = cg.builder.build_gep(i8_ty, data_ptr, buf, 1, "charptr");
        free(buf);
        *out_value = byte_ptr;
        *out_is_lvalue = true;
        return;
    }

    if (t.kind != TypeKind::Array) {
        *out_value = LValue::null();
        *out_is_lvalue = false;
        return;
    }

    const arr: ArrayType* = t as ArrayType*;
    const elem_ty: LType = cg.type_mapper.map_type(arr.element);
    if (!elem_ty.is_valid()) {
        cg.emit_error_at_span(ErrorCode::E0621_ARRAY_OPERATION_ERROR,
            "codegen: array access — failed to map element type",
            site_span);
        *out_value = LValue::null();
        *out_is_lvalue = false;
        return;
    }
    if (!array_val.is_valid()) {
        cg.emit_error_at_span(ErrorCode::E0621_ARRAY_OPERATION_ERROR,
            "codegen: array access — array value is null",
            site_span);
        *out_value = LValue::null();
        *out_is_lvalue = false;
        return;
    }
    if (!index_val.is_valid()) {
        cg.emit_error_at_span(ErrorCode::E0621_ARRAY_OPERATION_ERROR,
            "codegen: array access — index value is null",
            site_span);
        *out_value = LValue::null();
        *out_is_lvalue = false;
        return;
    }

    if (arr.is_fixed()) {
        // Fixed array: GEP into [N x T].
        const arr_ty: LType = cg.type_mapper.map_type(array_type);
        // Build indices: [0, index]
        const zero: LValue = LType::const_int(LType::i64(), 0, false);
        const buf: void* = malloc(16);
        const slots: void** = buf as void**;
        slots[0] = zero.raw;
        slots[1] = index_val.raw;
        const gep: LValue = cg.builder.build_gep(arr_ty, array_val, buf, 2, "elemptr");
        free(buf);
        *out_value = gep;
        *out_is_lvalue = true;
    } else {
        // Dynamic array: load { T*, i64 } from pointer, extract data pointer, then GEP.
        const arr_ty: LType = cg.type_mapper.map_type(array_type);
        const loaded: LValue = cg.builder.build_load(arr_ty, array_val, "arrload");
        const data_ptr: LValue = cg.builder.build_extract_value(loaded, 0, "data");
        const buf: void* = malloc(8);
        const slots: void** = buf as void**;
        slots[0] = index_val.raw;
        const gep: LValue = cg.builder.build_gep(elem_ty, data_ptr, buf, 1, "elemptr");
        free(buf);
        *out_value = gep;
        *out_is_lvalue = true;
    }
}


// ============================================================================
// Struct Literal
// ============================================================================

/// Generate IR for a struct literal: allocate, fill fields, return address.
/// `site_span` is the source span of the struct-literal expression in the
/// caller; used for diagnostics.
function codegen_struct_literal(cg: CodegenContext*, struct_type: TypeRef,
                                field_names: SymbolStr[], field_values: LValue[],
                                out_value: LValue*, out_is_lvalue: boolean*,
                                site_span: SourceSpan) -> void {
    const ty: LType = cg.type_mapper.map_type(struct_type);
    if (!ty.is_valid()) {
        *out_value = LValue::null();
        *out_is_lvalue = false;
        return;
    }

    // Get the current function for entry block alloca.
    const current_bb: LBasicBlock = cg.builder.get_insert_block();
    if (!current_bb.is_valid()) {
        cg.emit_error_at_span(ErrorCode::E0638_INVALID_STRUCT_INITIALIZATION,
            "codegen: struct literal — builder has no insert block",
            site_span);
        *out_value = LValue::null();
        *out_is_lvalue = false;
        return;
    }
    const current_fn: LValue = current_bb.get_parent();
    if (!current_fn.is_valid()) {
        cg.emit_error_at_span(ErrorCode::E0638_INVALID_STRUCT_INITIALIZATION,
            "codegen: struct literal — insert block has no parent function",
            site_span);
        *out_value = LValue::null();
        *out_is_lvalue = false;
        return;
    }

    const alloca: LValue = cg.create_entry_alloca(current_fn, "structlit", ty);

    // Store each field value at its GEP index.
    const t: Type* = cg.lookup_type_by_id(struct_type.id);
    if (t != null && t.kind == TypeKind::Struct) {
        const st: StructType* = t as StructType*;
        for (mut i: i64 = 0; i < field_names.length; i++) {
            const fidx: i64 = st.field_index(field_names[i]);
            if (fidx >= 0) {
                const gep: LValue = cg.builder.build_struct_gep(ty, alloca, fidx as u32, "field");
                cg.builder.build_store(field_values[i], gep);
            }
        }
    }

    *out_value = alloca;
    *out_is_lvalue = true;
}


// ============================================================================
// String comparison
// ============================================================================

/// Compare two i8* string values using strcmp.
/// Returns i1: true if equal (==) or not equal (!=).
function codegen_string_compare(cg: CodegenContext*, lhs: LValue, rhs: LValue,
                                 op_kind: TokenType, out_value: LValue*) -> void {
    // Ensure strcmp is declared: i32 strcmp(i8*, i8*)
    const intern: InternTable* = cg.get_intern();
    const strcmp_name: string = "strcmp";
    const strcmp_sym: SymbolStr = intern.intern(strcmp_name);
    mut strcmp_fn: LValue = resolve_function(cg, strcmp_sym);
    if (!strcmp_fn.is_valid()) {
        const i8_ptr: LType = LType::pointer_to(LType::i8());
        const param_buf: void* = malloc(16);
        const params: void** = param_buf as void**;
        params[0] = i8_ptr.raw;
        params[1] = i8_ptr.raw;
        const strcmp_ty: LType = LType::function_type(LType::i32(), param_buf, 2, false);
        free(param_buf);
        strcmp_fn = cg.llvm_module.add_function(strcmp_name, strcmp_ty);
        cg.register_function(strcmp_sym, strcmp_fn);
    }

    // Call strcmp(lhs, rhs).
    const strcmp_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(strcmp_fn.raw) };
    const arg_buf: void* = malloc(16);
    const args: void** = arg_buf as void**;
    args[0] = lhs.raw;
    args[1] = rhs.raw;
    const cmp_result: LValue = cg.builder.build_call(strcmp_ty, strcmp_fn, arg_buf, 2, "strcmp");
    free(arg_buf);

    // strcmp returns 0 when equal.
    const zero: LValue = LType::const_int(LType::i32(), 0, false);
    if (op_kind == TokenType::EqualEqual) {
        *out_value = cg.builder.build_icmp(32 /* IntEQ */, cmp_result, zero, "streq");
    } else {
        *out_value = cg.builder.build_icmp(33 /* IntNE */, cmp_result, zero, "strne");
    }
}
