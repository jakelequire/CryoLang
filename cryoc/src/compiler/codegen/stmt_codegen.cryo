/// Statement Codegen
///
/// Free functions for generating LLVM IR from statement nodes.
/// Handles control flow (if, while, for, loop, match, switch),
/// block scoping, return, break, continue, and expression statements.

namespace Compiler::Codegen::StmtCodegen;

import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Codegen::Context;
import Compiler::Codegen::ExprCodegen;
import Compiler::Codegen::DeclCodegen;
import Compiler::CompilationContext;
import Compiler::AST;
import Compiler::AST::Node;
import Compiler::AST::Statement;
import Compiler::AST::Expression;
import Compiler::AST::Declaration;
import Compiler::AST::Pattern;
import Compiler::Types;
import Compiler::Types::TypeRef;
import Compiler::Diag;
import Compiler::Diag::Diagnostic;
import Compiler::Diag::SourceSpan;


// ============================================================================
// Block
// ============================================================================

/// Generate IR for a block statement.  Pushes a new scope and pops it
/// after all statements are visited.  `visit_stmt` is used to dispatch
/// each statement through the visitor.
///
/// Returns true if the block was terminated (return/break/continue).
function codegen_block(cg: CodegenContext*, node: BlockStmtNode*,
                       visitor: void*, visit_fn: void*) -> boolean {
    cg.push_scope();
    mut terminated: boolean = false;

    for (mut i: i64 = 0; i < node.statements.length; i++) {
        // If we already emitted a terminator, skip remaining statements.
        const current: LBasicBlock = cg.builder.get_insert_block();
        if (current.is_valid() && current.has_terminator()) {
            terminated = true;
            break;
        }
        // Dispatch to the visitor (caller provides the visit function).
        // The visitor will call the appropriate codegen function.
        const stmt: StatementNode* = node.statements[i];
        if (stmt != null) {
            stmt.accept(visitor as BaseASTVisitor*);
        }
    }

    cg.pop_scope();
    return terminated;
}


// ============================================================================
// Return
// ============================================================================

function codegen_return(cg: CodegenContext*, val: LValue, has_value: boolean) -> void {
    if (has_value && val.is_valid()) {
        // Unit-returning functions lower to `void` in LLVM (see
        // map_return_type), so a source-level `return unit_expr;`
        // must emit `ret void` rather than `ret {} %unit` — the
        // verifier rejects the latter.  Detect the mismatch by
        // looking at the current function's LLVM return type.
        const cur_bb: LBasicBlock = cg.builder.get_insert_block();
        if (cur_bb.is_valid()) {
            const fn: LValue = cur_bb.get_parent();
            if (fn.is_valid()) {
                const fn_ty_raw: void* = llvm::LLVMGlobalGetValueType(fn.raw);
                if (llvm::LLVMGetTypeKind(fn_ty_raw) == 9) {
                    const ret_ty_raw: void* = llvm::LLVMGetReturnType(fn_ty_raw);
                    if (llvm::LLVMGetTypeKind(ret_ty_raw) == 0) {
                        emit_va_end_if_variadic(cg, current_variadic_arg(cg));
                        cg.builder.build_ret_void();
                        return;
                    }
                }
            }
        }
        // Coerce the return value to the function's declared return type.
        // Handles common implicit conversions like u64↔ptr (stdlib uses this
        // in `align_up`/`align_down`) and narrower integer returns.
        const coerced: LValue = coerce_return_value(cg, val);
        emit_va_end_if_variadic(cg, current_variadic_arg(cg));
        cg.builder.build_ret(coerced);
    } else if (!has_value) {
        emit_va_end_if_variadic(cg, current_variadic_arg(cg));
        cg.builder.build_ret_void();
    }
    // If has_value but val is null, expression codegen failed.
    // Don't emit anything — the caller will detect the incomplete
    // function and strip it back to a declare.
}

/// Coerce a return-statement value to match the declared return type.
/// Emits inttoptr/ptrtoint/trunc/zext when the straight ret would fail LLVM
/// verification.  Returns the original value if no coercion is needed.
///
/// Comparisons use LLVMGetTypeKind codes (integers) rather than void*
/// equality — the C++ Cryo compiler lowers `==` on void* to strcmp, so we
/// never pull the raw types into a `==` expression.
function coerce_return_value(cg: CodegenContext*, val: LValue) -> LValue {
    const cur_bb: LBasicBlock = cg.builder.get_insert_block();
    if (!cur_bb.is_valid()) { return val; }
    const fn: LValue = cur_bb.get_parent();
    if (!fn.is_valid()) { return val; }

    const fn_ty_raw: void* = llvm::LLVMGlobalGetValueType(fn.raw);
    if (llvm::LLVMGetTypeKind(fn_ty_raw) != 9) {
        // Not a function type — can't determine return type.  Kind 9 = Function.
        return val;
    }
    const want_ty_raw: void* = llvm::LLVMGetReturnType(fn_ty_raw);
    const got_ty_raw: void* = llvm::LLVMTypeOf(val.raw);

    // LLVM kind codes: 0=void, 8=integer, 12=pointer.
    const want_kind: i32 = llvm::LLVMGetTypeKind(want_ty_raw);
    const got_kind:  i32 = llvm::LLVMGetTypeKind(got_ty_raw);
    const want_lty: LType = LType { raw: want_ty_raw };

    if (want_kind == 12 && got_kind == 8) {
        return cg.builder.build_int_to_ptr(val, want_lty, "ret.inttoptr");
    }
    if (want_kind == 8 && got_kind == 12) {
        return cg.builder.build_ptr_to_int(val, want_lty, "ret.ptrtoint");
    }
    if (want_kind == 8 && got_kind == 8) {
        const want_bits: u32 = llvm::LLVMGetIntTypeWidth(want_ty_raw);
        const got_bits:  u32 = llvm::LLVMGetIntTypeWidth(got_ty_raw);
        if (want_bits > got_bits) {
            return cg.builder.build_zext(val, want_lty, "ret.zext");
        }
        if (want_bits < got_bits) {
            return cg.builder.build_trunc(val, want_lty, "ret.trunc");
        }
    }

    // Fixed-size array `[N x T]` → dynamic fat pointer `{T*, i64}`.  Happens
    // when a function typed `T[]` returns `[a, b, ...]` and sema didn't
    // propagate the dynamic expected_type into the array-literal's resolved
    // shape.  Stash the loaded array on the stack, malloc N*sizeof(T), memcpy
    // the contents, and build the fat pointer — keeping IR verifiable even
    // when upstream inference is incomplete.
    // want_kind 10 = Struct, got_kind 11 = Array (LLVM kind codes).
    if (want_kind == 10 && got_kind == 11) {
        const len: u32 = llvm::LLVMGetArrayLength(got_ty_raw);
        const elem_ty_raw: void* = llvm::LLVMGetElementType(got_ty_raw);
        const elem_size_val: LValue = LValue { raw: llvm::LLVMSizeOf(elem_ty_raw) };
        const len_val: LValue = LType::const_int(LType::i64(), len as u64, false);
        const byte_count: LValue = cg.builder.build_mul(
            len_val, elem_size_val, "ret.bytecnt");

        const src_alloca: LValue = cg.create_entry_alloca(
            fn, "ret.src", LType { raw: got_ty_raw });
        cg.builder.build_store(val, src_alloca);

        const malloc_fn: LValue = resolve_function(cg, cg.intern_str("malloc"));
        if (!malloc_fn.is_valid()) {
            return val;
        }
        const malloc_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(malloc_fn.raw) };
        mut malloc_args: LValue[] = [];
        malloc_args.push(byte_count);
        mut data_ptr: LValue = LValue::null();
        codegen_call(cg, malloc_fn, malloc_ty, malloc_args, "ret.data", &data_ptr);
        if (!data_ptr.is_valid()) {
            return val;
        }

        llvm::LLVMBuildMemCpy(cg.builder.raw,
                              data_ptr.raw, 1,
                              src_alloca.raw, 1,
                              byte_count.raw);

        const fat_alloca: LValue = cg.create_entry_alloca(fn, "ret.fat", want_lty);
        const ptr_slot: LValue = cg.builder.build_struct_gep(
            want_lty, fat_alloca, 0, "ret.fat.ptr");
        cg.builder.build_store(data_ptr, ptr_slot);
        const len_slot: LValue = cg.builder.build_struct_gep(
            want_lty, fat_alloca, 1, "ret.fat.len");
        cg.builder.build_store(len_val, len_slot);

        const loaded: LValue = cg.builder.build_load(want_lty, fat_alloca, "ret.fat.val");
        return loaded;
    }

    return val;
}


// ============================================================================
// If Statement
// ============================================================================

/// Generate IR for an if/else statement.
/// Creates then_bb, else_bb (if needed), and merge_bb.
function codegen_if(cg: CodegenContext*, cond: LValue,
                    current_fn: LValue,
                    has_else: boolean) -> IfBlocks {
    const then_bb: LBasicBlock = LBasicBlock::append(current_fn, "then");
    const else_bb: LBasicBlock = if (has_else) {
        LBasicBlock::append(current_fn, "else")
    } else {
        LBasicBlock::null()
    };
    const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "ifcont");

    // Emit conditional branch.
    if (has_else) {
        cg.builder.build_cond_br(cond, then_bb, else_bb);
    } else {
        cg.builder.build_cond_br(cond, then_bb, merge_bb);
    }

    return IfBlocks {
        then_bb:  then_bb,
        else_bb:  else_bb,
        merge_bb: merge_bb,
    };
}

type struct IfBlocks {
    then_bb:  LBasicBlock;
    else_bb:  LBasicBlock;
    merge_bb: LBasicBlock;
}


// ============================================================================
// While Loop
// ============================================================================

/// Create the basic blocks for a while loop.
/// Returns cond_bb, body_bb, and merge_bb.
function codegen_while_header(cg: CodegenContext*, current_fn: LValue) -> LoopBlocks {
    const cond_bb: LBasicBlock = LBasicBlock::append(current_fn, "while.cond");
    const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "while.body");
    const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "while.end");

    // Branch to condition check.
    cg.builder.build_br(cond_bb);

    // Push loop targets for break/continue.
    cg.push_loop(merge_bb, cond_bb);

    return LoopBlocks {
        cond_bb:  cond_bb,
        body_bb:  body_bb,
        merge_bb: merge_bb,
    };
}

type struct LoopBlocks {
    cond_bb:  LBasicBlock;
    body_bb:  LBasicBlock;
    merge_bb: LBasicBlock;
}


// ============================================================================
// For Loop
// ============================================================================

/// Create basic blocks for a for loop: init -> cond -> body -> update -> cond.
function codegen_for_header(cg: CodegenContext*, current_fn: LValue) -> ForBlocks {
    const cond_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.cond");
    const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.body");
    const update_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.update");
    const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.end");

    // Push loop targets: break -> merge, continue -> update.
    cg.push_loop(merge_bb, update_bb);

    return ForBlocks {
        cond_bb:   cond_bb,
        body_bb:   body_bb,
        update_bb: update_bb,
        merge_bb:  merge_bb,
    };
}

type struct ForBlocks {
    cond_bb:   LBasicBlock;
    body_bb:   LBasicBlock;
    update_bb: LBasicBlock;
    merge_bb:  LBasicBlock;
}


// ============================================================================
// Infinite Loop
// ============================================================================

/// Create basic blocks for a `loop { ... }` infinite loop.
function codegen_loop_header(cg: CodegenContext*, current_fn: LValue) -> LoopBlocks {
    const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "loop.body");
    const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "loop.end");

    cg.builder.build_br(body_bb);
    cg.push_loop(merge_bb, body_bb);

    return LoopBlocks {
        cond_bb:  LBasicBlock::null(),
        body_bb:  body_bb,
        merge_bb: merge_bb,
    };
}


// ============================================================================
// Break / Continue
// ============================================================================

function codegen_break(cg: CodegenContext*) -> void {
    const target: LBasicBlock = cg.current_break_target();
    if (target.is_valid()) {
        cg.builder.build_br(target);
    }
}

function codegen_continue(cg: CodegenContext*) -> void {
    const target: LBasicBlock = cg.current_continue_target();
    if (target.is_valid()) {
        cg.builder.build_br(target);
    }
}


// ============================================================================
// Match Statement
// ============================================================================

/// Create basic blocks for a match/switch statement.
function codegen_match_header(cg: CodegenContext*, current_fn: LValue,
                               num_arms: u32) -> MatchBlocks {
    mut arm_bbs: LBasicBlock[] = [];
    for (mut i: u32 = 0; i < num_arms; i++) {
        const name: string = format("match.arm%d", i);
        arm_bbs.push(LBasicBlock::append(current_fn, name));
    }
    const default_bb: LBasicBlock = LBasicBlock::append(current_fn, "match.default");
    const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "match.end");

    return MatchBlocks {
        arm_bbs:    arm_bbs,
        default_bb: default_bb,
        merge_bb:   merge_bb,
    };
}

type struct MatchBlocks {
    arm_bbs:    LBasicBlock[];
    default_bb: LBasicBlock;
    merge_bb:   LBasicBlock;
}


// ============================================================================
// Variable Declaration (local)
// ============================================================================

/// Generate IR for a local variable declaration.
/// `site_span` is the source span of the variable's declaration node; used
/// for diagnostics when the insert block or parent function are unexpectedly
/// null (both indicate a codegen-ordering bug, so we point the user at the
/// declaration that tripped the check).
function codegen_local_var(cg: CodegenContext*, name: SymbolStr,
                           ty: TypeRef, init_val: LValue,
                           has_init: boolean,
                           site_span: SourceSpan) -> void {
    const var_name: string = cg.resolve(name);
    const llvm_ty: LType = cg.type_mapper.map_type(ty);
    if (!llvm_ty.is_valid()) {
        return;
    }

    // Void is unsized — LLVMBuildAlloca crashes in DataLayout::getAlignment.
    // Use LLVMGetTypeKind (0 = VoidTypeKind) instead of pointer comparison.
    if (llvm::LLVMGetTypeKind(llvm_ty.raw) == 0) {
        return;
    }

    // Get the current function for entry-block alloca.
    const current_bb: LBasicBlock = cg.builder.get_insert_block();
    if (!current_bb.is_valid()) {
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0607_VARIABLE_GENERATION_ERROR,
            format("codegen: local variable '%s' — builder has no insert block", var_name));
        diag = diag.at(site_span);
        diag = diag.with_note("the codegen builder must have an insert block active when a local is declared; this usually means a statement was visited outside of any function body");
        cg.emit_diagnostic(diag);
        return;
    }
    const current_fn: LValue = current_bb.get_parent();
    if (!current_fn.is_valid()) {
        cg.emit_error_at_span(ErrorCode::E0607_VARIABLE_GENERATION_ERROR,
            format("codegen: local variable '%s' — insert block has no parent function", var_name),
            site_span);
        return;
    }

    const alloca: LValue = cg.create_entry_alloca(current_fn, var_name, llvm_ty);

    if (has_init && init_val.is_valid()) {
        cg.builder.build_store(init_val, alloca);
    }

    cg.set_named_value(name, alloca);
}


// ============================================================================
// Helpers
// ============================================================================

/// Branch to a target block if the current block has no terminator.
function branch_if_not_terminated(cg: CodegenContext*, target: LBasicBlock) -> void {
    const current: LBasicBlock = cg.builder.get_insert_block();
    if (current.is_valid() && !current.has_terminator()) {
        cg.builder.build_br(target);
    }
}

/// Reshape an icmp RHS to match the LHS width when the subject is a
/// narrower integer than the pattern value.  `codegen_pattern_value`
/// always produces i32 literals (char literals, atoi'd ints), but the
/// subject can be i8/i16 (u8/char matches) or i64 (wide counters).
/// Truncate or sign-extend to keep LLVM's verifier happy.
function coerce_icmp_operands(cg: CodegenContext*, lhs: LValue, rhs: LValue) -> LValue {
    if (!lhs.is_valid() || !rhs.is_valid()) { return rhs; }
    const lhs_ty_raw: void* = llvm::LLVMTypeOf(lhs.raw);
    const rhs_ty_raw: void* = llvm::LLVMTypeOf(rhs.raw);
    // Only reshape when both are integer — pointer/float cases hit
    // distinct error paths.  LLVMGetTypeKind code 8 = Integer.  We avoid
    // `lhs_ty_raw == rhs_ty_raw` for the early-out because the bootstrap
    // lowers `==` on `void*` to strcmp, which would read from the LLVM
    // type objects as if they were strings.
    if (llvm::LLVMGetTypeKind(lhs_ty_raw) != 8) { return rhs; }
    if (llvm::LLVMGetTypeKind(rhs_ty_raw) != 8) { return rhs; }
    const lhs_bits: u32 = llvm::LLVMGetIntTypeWidth(lhs_ty_raw);
    const rhs_bits: u32 = llvm::LLVMGetIntTypeWidth(rhs_ty_raw);
    if (lhs_bits == rhs_bits) { return rhs; }
    const lhs_ty: LType = LType { raw: lhs_ty_raw };
    if (rhs_bits > lhs_bits) {
        return cg.builder.build_trunc(rhs, lhs_ty, "match.coerce.trunc");
    }
    return cg.builder.build_zext(rhs, lhs_ty, "match.coerce.zext");
}
