/// Declaration Codegen
///
/// Handles IR generation for declarations: struct/class/enum types,
/// function signatures, function bodies, methods, globals, extern blocks,
/// and vtables.  Called by IRGeneratorVisitor's visit() overrides.

namespace Compiler::Codegen::DeclCodegen;

import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Codegen::TypeMap;
import Compiler::Codegen::Context;
import Compiler::CompilationContext;
import Compiler::DeclIndex;
import Compiler::ModuleGraph;
import Compiler::Types;
import Compiler::Types::TypeRef;
import Compiler::Types::Type;
import Compiler::Types::Arena;
import Compiler::Types::UserDefined;
import Compiler::Types::Compound;
import Compiler::Types::Generic;
import Compiler::AST;
import Compiler::AST::Node;
import Compiler::AST::Declaration;
import Compiler::AST::Statement;
import Compiler::AST::Expression;
import Compiler::Resolver::SymbolStr;
import Compiler::Resolver::InternTable;
import Compiler::Resolver::MangledName;
import Compiler::Resolver::QualifiedName;
import Compiler::Diag;


// ============================================================================
// Phase 1: Forward-declare all named types
// ============================================================================

/// Walk the program and forward-declare all struct/class/enum types as
/// named LLVM struct types.  This must run before function declarations
/// so that parameter and return types can reference these types.
function declare_types(cg: CodegenContext*, program: ProgramNode*) -> void {
    const stmts: ASTNode*[] = program.statements;
    for (mut i: i64 = 0; i < stmts.length; i++) {
        const stmt: ASTNode* = stmts[i];
        if (stmt == null) { continue; }

        const kind: NodeKind = stmt.kind;

        if (kind == NodeKind::StructDeclaration) {
            declare_struct_type(cg, stmt as StructDeclNode*);
        } else if (kind == NodeKind::ClassDeclaration) {
            declare_class_type(cg, stmt as ClassDeclNode*);
        } else if (kind == NodeKind::EnumDeclaration) {
            declare_enum_type(cg, stmt as EnumDeclNode*);
        } else if (kind == NodeKind::ImplementationBlock) {
            // Impl blocks may contain methods we need, but types are
            // already declared via StructDecl/ClassDecl.
        }
    }
}

/// Forward-declare a struct as a named LLVM type and fill its body.
function declare_struct_type(cg: CodegenContext*, node: StructDeclNode*) -> void {
    // Skip generic templates — only monomorphized versions get IR.
    if (node.generic_params.length > 0) {
        return;
    }

    const name: string = cg.resolve(node.name);
    const qname: QualifiedName = QualifiedName::single(cg.get_intern(), name);
    const mangled: string = MangledName::for_struct(cg.get_intern(), qname).resolve(cg.get_intern());

    // Look up the Cryo StructType to get field info.
    const type_ref: TypeRef = cg.ctx.decl_index.lookup_type(node.name);
    if (type_ref.is_invalid()) {
        return;
    }

    // Let the type mapper handle forward declaration + body fill.
    cg.type_mapper.map_type(type_ref);
}

/// Forward-declare a class type.
function declare_class_type(cg: CodegenContext*, node: ClassDeclNode*) -> void {
    if (node.generic_params.length > 0) {
        return;
    }

    const type_ref: TypeRef = cg.ctx.decl_index.lookup_type(node.name);
    if (type_ref.is_invalid()) {
        return;
    }

    cg.type_mapper.map_type(type_ref);
}

/// Declare an enum type.
function declare_enum_type(cg: CodegenContext*, node: EnumDeclNode*) -> void {
    if (node.generic_params.length > 0) {
        return;
    }

    const type_ref: TypeRef = cg.ctx.decl_index.lookup_type(node.name);
    if (type_ref.is_invalid()) {
        return;
    }

    cg.type_mapper.map_type(type_ref);
}


// ============================================================================
// Phase 2: Declare all function signatures
// ============================================================================

/// Walk the program and create LLVM function declarations for all
/// functions, methods, and extern blocks.
function declare_functions(cg: CodegenContext*, program: ProgramNode*) -> void {
    const stmts: ASTNode*[] = program.statements;
    for (mut i: i64 = 0; i < stmts.length; i++) {
        const stmt: ASTNode* = stmts[i];
        if (stmt == null) { continue; }

        const kind: NodeKind = stmt.kind;

        if (kind == NodeKind::FunctionDeclaration) {
            declare_function(cg, stmt as FunctionDeclNode*);
        } else if (kind == NodeKind::IntrinsicDeclaration) {
            declare_intrinsic(cg, stmt as IntrinsicDeclNode*);
        } else if (kind == NodeKind::ExternBlock) {
            declare_extern_block(cg, stmt as ExternBlockNode*);
        } else if (kind == NodeKind::ImplementationBlock) {
            declare_impl_block(cg, stmt as ImplBlockNode*);
        } else if (kind == NodeKind::StructDeclaration) {
            declare_struct_methods(cg, stmt as StructDeclNode*);
        } else if (kind == NodeKind::ClassDeclaration) {
            declare_class_methods(cg, stmt as ClassDeclNode*);
        }
    }
}

/// Declare a single function signature (no body generation).
function declare_function(cg: CodegenContext*, node: FunctionDeclNode*) -> void {
    // Skip generic templates.
    if (node.generic_params.length > 0) {
        return;
    }

    // Look up the pre-computed mangled name from the DI.
    const ctx_ptr: CompilationContext* = cg.ctx;
    const intern: InternTable* = ctx_ptr.intern_table;
    const qualified: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
    const di: DeclarationIndex* = ctx_ptr.decl_index;
    mut mangled_sym: SymbolStr = di.lookup_mangled_name(qualified);
    if (!mangled_sym.is_valid()) {
        // Compute and register on first use.
        const qname: QualifiedName = QualifiedName::from_symbol(qualified);
        const computed: MangledName = MangledName::for_function(intern, qname);
        mangled_sym = computed.value;
        di.register_mangled_name(qualified, mangled_sym);
    }
    const fn_name: string = intern.resolve(mangled_sym);

    // Build the LLVM function type.
    const ret_ty: LType = map_return_type(cg, node);
    if (!ret_ty.is_valid()) { return; }

    const param_count: u32 = node.parameters.length as u32;

    mut fn_type: LType = LType::null();
    if (param_count == 0) {
        fn_type = LType::function_type(ret_ty, null, 0, node.is_variadic);
    } else {
        const buf: void* = malloc(param_count as u64 * 8);
        const slots: void** = buf as void**;
        mut all_valid: boolean = true;
        for (mut i: u32 = 0; i < param_count; i++) {
            const param: VarDeclNode* = node.parameters[i];
            const param_ty: LType = cg.type_mapper.map_type(param.resolved_type);
            if (!param_ty.is_valid()) {
                all_valid = false;
                break;
            }
            slots[i] = param_ty.raw;
        }
        if (!all_valid) {
            free(buf);
            return;
        }
        fn_type = LType::function_type(ret_ty, buf, param_count, node.is_variadic);
        free(buf);
    }

    // Add the function to the LLVM module.
    const fn_val: LValue = cg.llvm_module.add_function(fn_name, fn_type);

    // Register under qualified name (module scope).
    cg.register_function(qualified, fn_val);
}

/// Declare all methods in an impl block.
function declare_impl_block(cg: CodegenContext*, node: ImplBlockNode*) -> void {
    // Skip generic impl blocks.
    if (node.generic_params.length > 0) {
        return;
    }

    // Qualify the target type — node.target_type may be bare ("CompileMode")
    // but the DI and type system use qualified names.
    // If specialization already set a fully-qualified arena name (contains
    // "::"), don't re-qualify — it would double-prefix and produce a key
    // that callers can't find.
    const ctx_ptr: CompilationContext* = cg.ctx;
    const target_str: string = ctx_ptr.intern_table.resolve(node.target_type);
    mut qualified_target: SymbolStr = node.target_type;
    if (strstr(target_str, "::") == null) {
        qualified_target = ctx_ptr.qualify_symbol_sym(node.target_type);
    }

    for (mut i: i64 = 0; i < node.methods.length; i++) {
        declare_method(cg, node.methods[i], qualified_target);
    }
}

/// Declare methods defined inline within a struct declaration.
function declare_struct_methods(cg: CodegenContext*, node: StructDeclNode*) -> void {
    if (node.generic_params.length > 0) {
        return;
    }
    if (node.methods.length == 0) {
        return;
    }
    // Use the arena's canonical qualified name for the struct type.
    // For specialized structs (e.g., Array_Token), the arena name is
    // the correct DI key (e.g., std::collections::array::Array_Token).
    // qualify_symbol_sym would produce the consuming module's namespace
    // prefix, which doesn't match the DI registration.
    const ctx_ptr: CompilationContext* = cg.ctx;
    const di: DeclarationIndex* = ctx_ptr.decl_index;
    mut qualified: SymbolStr = SymbolStr::empty();
    // Try both local-qualified and bare name in the DI, then get the
    // arena's canonical qualified name from the TypeRef.
    const local_sym: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
    mut di_ref: TypeRef = di.lookup_type(local_sym);
    if (!di_ref.is_valid()) {
        di_ref = di.lookup_type(node.name);
    }
    if (di_ref.is_valid()) {
        const arena: TypeArena* = cg.get_arena();
        qualified = arena.get_qualified_name(di_ref);
    }
    if (!qualified.is_valid()) {
        qualified = local_sym;
    }
    for (mut i: i64 = 0; i < node.methods.length; i++) {
        declare_method(cg, node.methods[i], qualified);
    }
}

/// Declare methods defined inline within a class declaration.
function declare_class_methods(cg: CodegenContext*, node: ClassDeclNode*) -> void {
    if (node.generic_params.length > 0) {
        return;
    }
    if (node.methods.length == 0) {
        return;
    }
    // Qualify the class name — node.name is the bare AST name.
    // Break cg.ctx chain into local to avoid C++ compiler double-deref bug.
    const ctx_ptr: CompilationContext* = cg.ctx;
    const qualified: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
    for (mut i: i64 = 0; i < node.methods.length; i++) {
        declare_method(cg, node.methods[i], qualified);
    }

    // Emit the vtable for classes with virtual methods.  Drive this from
    // ClassType.methods + its base chain (populated by the type-resolution
    // pass) so the vtable is inheritance-complete: a subclass's vtable has
    // one slot per virtual method introduced anywhere in the ancestry,
    // in the order of first introduction (root → leaf).  The slot's
    // implementation is the most-derived override present in the chain,
    // falling back to the inherited base implementation when the subclass
    // doesn't override that slot.  Layout discipline is what makes call-site
    // dispatch work: a `Base*` callsite looks up slot N in `Base`'s layout,
    // and any subclass's vtable guarantees slot N at the same index.
    const di: DeclarationIndex* = ctx_ptr.decl_index;
    const type_ref: TypeRef = di.lookup_type(qualified);
    if (type_ref.is_valid()) {
        const arena: TypeArena* = cg.get_arena();
        const t: Type* = arena.lookup(type_ref.id);
        if (t != null && t.kind == TypeKind::Class) {
            const cls: ClassType* = t as ClassType*;
            if (cls.has_virtual_methods) {
                codegen_vtable_for_class(cg, cls);
            }
        }
    }
}

/// Walk the class's base chain (leaf → root) and collect the ordered list
/// of virtual-method names.  New `is_virtual` methods append a new slot;
/// `is_override` methods reuse an existing slot.  The returned list is in
/// root → leaf declaration order — the canonical vtable layout — and every
/// subclass's vtable extends this list with its own additions.
function collect_vtable_slot_names(cg: CodegenContext*, cls: ClassType*) -> SymbolStr[] {
    const arena: TypeArena* = cg.get_arena();

    // Build chain = [cls, ..., root].
    mut chain: ClassType*[] = [];
    mut walk: ClassType* = cls;
    mut depth: i32 = 0;
    while (walk != null && depth < 16) {
        chain.push(walk);
        if (!walk.has_base || !walk.base_class.is_valid()) { break; }
        const base_t: Type* = arena.lookup(walk.base_class.id);
        if (base_t == null || base_t.kind != TypeKind::Class) { break; }
        walk = base_t as ClassType*;
        depth = depth + 1;
    }

    // Walk root → leaf, collecting virtual-slot names in declaration order.
    mut names: SymbolStr[] = [];
    for (mut ci: i64 = chain.length - 1; ci >= 0; ci--) {
        const link: ClassType* = chain[ci];
        for (mut mi: i64 = 0; mi < link.methods.length; mi++) {
            const m: MethodInfo = link.methods[mi];
            if (!m.is_virtual) { continue; }
            mut already: boolean = false;
            for (mut ki: i64 = 0; ki < names.length; ki++) {
                if (names[ki].equals(m.name)) { already = true; break; }
            }
            if (!already) { names.push(m.name); }
        }
    }
    return names;
}

/// For a given vtable slot (identified by method name), walk the class's
/// chain leaf → root and return the first `{class, method}` pair that
/// declares the slot (as `is_virtual` or `is_override`).  The resulting
/// LValue is the LLVM function whose pointer gets installed into the slot.
/// Returns `LValue::null()` if no implementation can be resolved.
function find_vtable_slot_impl(cg: CodegenContext*, cls: ClassType*,
                                slot_name: SymbolStr) -> LValue {
    const arena: TypeArena* = cg.get_arena();
    const intern: InternTable* = cg.get_intern();
    mut walk: ClassType* = cls;
    mut depth: i32 = 0;
    while (walk != null && depth < 16) {
        for (mut mi: i64 = 0; mi < walk.methods.length; mi++) {
            const m: MethodInfo = walk.methods[mi];
            if (!m.name.equals(slot_name)) { continue; }
            if (!m.is_virtual && !m.is_override) { continue; }
            const type_str: string = intern.resolve(walk.qualified_name);
            const method_str: string = intern.resolve(slot_name);
            const combined: string = format("%s::%s", type_str, method_str);
            const combined_sym: SymbolStr = intern.intern(combined);
            return cg.get_function(combined_sym);
        }
        if (!walk.has_base || !walk.base_class.is_valid()) { break; }
        const base_t: Type* = arena.lookup(walk.base_class.id);
        if (base_t == null || base_t.kind != TypeKind::Class) { break; }
        walk = base_t as ClassType*;
        depth = depth + 1;
    }
    return LValue::null();
}

/// Return the vtable slot index of `method_name` in this class's layout,
/// or -1 if `method_name` isn't a virtual method of the class or any
/// ancestor.  Used by call-site dispatch to emit `load vtbl[idx]` as the
/// indirect callee.
function vtable_slot_index(cg: CodegenContext*, cls: ClassType*,
                            method_name: SymbolStr) -> i32 {
    const names: SymbolStr[] = collect_vtable_slot_names(cg, cls);
    for (mut i: i32 = 0; i < names.length as i32; i++) {
        if (names[i].equals(method_name)) { return i; }
    }
    return -1;
}

/// Emit the vtable global for `cls`.  Slot layout comes from
/// `collect_vtable_slot_names` (inheritance-complete), and each slot's
/// contents come from `find_vtable_slot_impl` (most-derived override wins,
/// inherited base implementation otherwise).
function codegen_vtable_for_class(cg: CodegenContext*, cls: ClassType*) -> void {
    const intern: InternTable* = cg.get_intern();

    const slot_names: SymbolStr[] = collect_vtable_slot_names(cg, cls);
    if (slot_names.length == 0) { return; }

    mut impls: LValue[] = [];
    for (mut i: i64 = 0; i < slot_names.length; i++) {
        const impl: LValue = find_vtable_slot_impl(cg, cls, slot_names[i]);
        if (!impl.is_valid()) {
            // If the slot's implementation isn't declared in this module,
            // skip vtable emission entirely — a half-populated vtable would
            // misdispatch.  Cross-module vtables are handled when the owning
            // module's codegen runs; this module can still store the vtable
            // pointer by name via a forward global declaration, but that's
            // out of scope here.
            return;
        }
        impls.push(impl);
    }

    const n: u32 = impls.length as u32;
    const fn_ptr_ty: LType = LType::pointer_to(LType::i8());
    const vtable_ty: LType = LType::array_of(fn_ptr_ty, n);

    const buf: void* = malloc(n as u64 * 8);
    const slots: void** = buf as void**;
    for (mut i: u32 = 0; i < n; i++) {
        slots[i] = llvm::LLVMConstBitCast(impls[i].raw, fn_ptr_ty.raw);
    }
    const init: LValue = LType::const_array(fn_ptr_ty, buf, n);
    free(buf);

    const qname: QualifiedName = QualifiedName::from_symbol(cls.qualified_name);
    const mangled: string = MangledName::for_vtable(intern, qname).resolve(intern);
    const global: LValue = cg.llvm_module.add_global(vtable_ty, mangled);
    global.set_initializer(init);
    global.set_global_constant(true);
    global.set_linkage(8);  // LLVMInternalLinkage
}

/// Declare a method.  Methods get a `this` pointer as the first parameter.
function declare_method(cg: CodegenContext*, node: MethodNode*, target_type: SymbolStr) -> void {
    const func: FunctionDeclNode* = node.func;
    if (func == null) { return; }

    // Skip generic methods.
    if (func.generic_params.length > 0) {
        return;
    }

    const intern: InternTable* = cg.get_intern();
    const type_str: string = intern.resolve(target_type);
    const method_str: string = intern.resolve(func.name);

    // Build the combined DI key and look up the pre-computed mangled name.
    const combined: string = format("%s::%s", type_str, method_str);
    const combined_sym: SymbolStr = intern.intern(combined);
    const ctx_ptr: CompilationContext* = cg.ctx;
    const di: DeclarationIndex* = ctx_ptr.decl_index;
    mut mangled_sym: SymbolStr = di.lookup_mangled_name(combined_sym);
    if (!mangled_sym.is_valid()) {
        // Compute and register on first use — covers paths that don't
        // register upfront (monomorphized impl blocks, etc.).
        const arena: TypeArena* = cg.get_arena();
        const type_qname: QualifiedName = QualifiedName::from_symbol(target_type);
        const type_mangled: MangledName = MangledName::from_qualified(intern, type_qname);
        mut pd: string[] = [];
        const this_sym: SymbolStr = intern.intern("&this");
        for (mut pi: i64 = 0; pi < func.parameters.length; pi++) {
            const pp: VarDeclNode* = func.parameters[pi];
            if (pp != null && pp.resolved_type.is_valid() && !pp.name.equals(this_sym)) {
                const pt: Type* = arena.lookup(pp.resolved_type.id);
                if (pt != null) { pd.push(pt.display_name()); }
            }
        }
        const computed: MangledName = MangledName::for_method(intern, type_mangled, method_str, pd);
        mangled_sym = computed.value;
        di.register_mangled_name(combined_sym, mangled_sym);
    }
    const fn_name: string = intern.resolve(mangled_sym);

    // Build LLVM function type.  Non-static methods prepend a `this` pointer.
    const ret_ty: LType = map_return_type(cg, func);
    if (!ret_ty.is_valid()) { return; }

    const is_instance: boolean = !node.is_static;

    // Detect whether the method already declares an explicit self parameter.
    // Cryo allows three forms: `&this` / `mut &this` (reference, default),
    // and `this` (by-value).  `&this` is stored in `parameters` with the
    // literal name "&this"; `this` by-value is stored with the literal name
    // "this".  In EITHER case we must NOT prepend an extra implicit `this`
    // slot — the explicit param already accounts for the self argument.
    // Only when the method has no self-param at all (e.g., some elaborated
    // methods) should we synthesize the `&this` pointer prefix.
    mut explicit_self_name: string = "";  // "", "&this", or "this"
    for (mut pc0: u32 = 0; pc0 < func.parameters.length as u32; pc0++) {
        const pp0: VarDeclNode* = func.parameters[pc0];
        if (pp0 == null) { continue; }
        const pn: string = intern.resolve(pp0.name);
        if (strcmp(pn, "&this") == 0) {
            explicit_self_name = "&this";
            break;
        }
        if (strcmp(pn, "this") == 0) {
            explicit_self_name = "this";
            break;
        }
    }

    // Look up the target type.  `&this` forms want `T*`; by-value `this`
    // wants the struct `T` directly.  If there's no explicit self we'll
    // synthesize `T*` as the implicit prefix.
    mut target_mapped: LType = LType::null();
    mut this_ty: LType = LType::null();
    if (is_instance) {
        mut target_ref: TypeRef = di.lookup_type(target_type);
        if (target_ref.is_valid()) {
            target_mapped = cg.type_mapper.map_type(target_ref);
            if (target_mapped.is_valid()) {
                this_ty = LType::pointer_to(target_mapped);
            }
        }
        if (!this_ty.is_valid()) {
            return;
        }
    }

    const prepend_implicit_this: boolean = is_instance && strlen(explicit_self_name) == 0;

    // Count user parameters.  `&this` contributes a ptr slot via the
    // existing param; by-value `this` contributes a struct slot via the
    // existing param; implicit missing self is handled by prepend_implicit_this.
    mut user_param_count: u32 = 0;
    for (mut pc: u32 = 0; pc < func.parameters.length as u32; pc++) {
        const pp: VarDeclNode* = func.parameters[pc];
        if (pp != null) { user_param_count = user_param_count + 1; }
    }
    const total_params: u32 = user_param_count + (if (prepend_implicit_this) { 1 } else { 0 } as u32);

    const buf: void* = malloc(total_params as u64 * 8);
    const slots: void** = buf as void**;

    mut idx: u32 = 0;
    if (prepend_implicit_this) {
        slots[0] = this_ty.raw;
        idx = 1;
    }

    mut params_valid: boolean = true;
    for (mut i: u32 = 0; i < func.parameters.length as u32; i++) {
        const param: VarDeclNode* = func.parameters[i];
        if (param == null) { continue; }
        const param_name: string = intern.resolve(param.name);

        // For `&this` and `mut &this`, force the LLVM type to `T*` —
        // parser-synthesized reference annotations may not round-trip
        // through the arena correctly for every method.
        // For by-value `this`, use the struct type directly.
        mut mapped_param: LType = LType::null();
        if (strcmp(param_name, "&this") == 0 && this_ty.is_valid()) {
            mapped_param = this_ty;
        } else if (strcmp(param_name, "this") == 0 && target_mapped.is_valid()) {
            mapped_param = target_mapped;
        } else {
            mapped_param = cg.type_mapper.map_type(param.resolved_type);
        }
        if (!mapped_param.is_valid()) {
            params_valid = false;
            break;
        }
        slots[idx] = mapped_param.raw;
        idx = idx + 1;
    }

    if (!params_valid) {
        free(buf);
        return;
    }

    const fn_type: LType = LType::function_type(ret_ty, buf, total_params, func.is_variadic);
    free(buf);

    const fn_val: LValue = cg.llvm_module.add_function(fn_name, fn_type);

    // Register under the combined key built above.  Also register against the
    // (name, total-LLVM-arity) composite so that callers can pick the correct
    // overload at call sites (e.g., `Array::new()` vs `Array::new(u64)`).
    // `total_params` matches the arity cross-module externs register with
    // (the FunctionType's param count), keeping the two registration paths
    // interoperable.
    cg.register_function(combined_sym, fn_val);
    cg.register_function_with_arity(combined_sym, total_params, fn_val);
}

/// Declare an intrinsic function (e.g., malloc, printf, strlen).
/// Intrinsics use C linkage — bare name, no namespace qualification.
function declare_intrinsic(cg: CodegenContext*, node: IntrinsicDeclNode*) -> void {
    const intern: InternTable* = cg.get_intern();
    const name_str: string = intern.resolve(node.name);

    // Map return type.
    mut ret_ty: LType = LType::void_type();
    if (node.has_resolved_return_type()) {
        ret_ty = cg.type_mapper.map_type(node.resolved_return_type);
        if (!ret_ty.is_valid()) { return; }
    }

    const param_count: u32 = node.parameters.length as u32;
    mut fn_type: LType = LType::null();

    if (param_count == 0) {
        fn_type = LType::function_type(ret_ty, null, 0, node.is_variadic);
    } else {
        const buf: void* = malloc(param_count as u64 * 8);
        const slots: void** = buf as void**;
        mut all_valid: boolean = true;
        for (mut i: u32 = 0; i < param_count; i++) {
            const param: VarDeclNode* = node.parameters[i];
            const param_ty: LType = cg.type_mapper.map_type(param.resolved_type);
            if (!param_ty.is_valid()) {
                all_valid = false;
                break;
            }
            slots[i] = param_ty.raw;
        }
        if (!all_valid) {
            free(buf);
            return;
        }
        fn_type = LType::function_type(ret_ty, buf, param_count, node.is_variadic);
        free(buf);
    }

    // C linkage: use bare name.
    const fn_val: LValue = cg.llvm_module.add_function(name_str, fn_type);

    // Register under bare name (for identifier lookups like `malloc(...)`)
    cg.register_function(node.name, fn_val);

    // Also register under qualified name (for cross-module resolution).
    const ctx_ptr: CompilationContext* = cg.ctx;
    const qualified: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
    if (!qualified.equals(node.name)) {
        cg.register_function(qualified, fn_val);
    }
}

/// Declare extern block functions.
function declare_extern_block(cg: CodegenContext*, node: ExternBlockNode*) -> void {
    // Get intern table from CompilationContext to avoid CodegenContext offset issues.
    const ctx_ptr: CompilationContext* = cg.ctx;
    const intern: InternTable* = ctx_ptr.intern_table;

    for (mut i: i64 = 0; i < node.functions.length; i++) {
        const func: FunctionDeclNode* = node.functions[i];
        if (func == null) { continue; }

        const name_str: string = intern.resolve(func.name);

        // Extern functions use their bare name (C linkage).
        const ret_ty: LType = map_return_type(cg, func);
        if (!ret_ty.is_valid()) {
            printf("[IRGen] WARNING: extern '%s' — failed to map return type, skipping\n", name_str); fflush(null);
            cg.ctx.emit_warning(ErrorCode::E0643_RETURN_TYPE_ERROR,
                format("codegen: extern function '%s' — failed to map return type", name_str));
            continue;
        }
        const param_count: u32 = func.parameters.length as u32;

        mut fn_type: LType = LType::null();
        if (param_count == 0) {
            fn_type = LType::function_type(ret_ty, null, 0, func.is_variadic);
        } else {
            const buf: void* = malloc(param_count as u64 * 8);
            const slots: void** = buf as void**;
            mut params_ok: boolean = true;
            for (mut j: u32 = 0; j < param_count; j++) {
                const param: VarDeclNode* = func.parameters[j];
                const mapped_ep: LType = cg.type_mapper.map_type(param.resolved_type);
                if (!mapped_ep.is_valid()) {
                    printf("[IRGen] WARNING: extern '%s' param %d — failed to map type, skipping\n", name_str, j); fflush(null);
                    cg.ctx.emit_warning(ErrorCode::E0642_PARAM_TYPE_ERROR,
                        format("codegen: extern function '%s' — failed to map parameter %d type", name_str, j as i32));
                    params_ok = false;
                    break;
                }
                slots[j] = mapped_ep.raw;
            }
            if (!params_ok) {
                free(buf);
                continue;
            }
            fn_type = LType::function_type(ret_ty, buf, param_count, func.is_variadic);
            free(buf);
        }

        // Use bare name for C linkage.
        const fn_val: LValue = cg.llvm_module.add_function(name_str, fn_type);
        cg.register_function(func.name, fn_val);
    }
}

/// Declare cross-module extern functions.
///
/// Instead of reading from pre-built CrossModuleFnDescriptor objects
/// (which suffer from struct-copy corruption when the descriptor
/// contains dynamic array fields), query the DeclarationIndex directly
/// for each module's functions and look up their FunctionType in the arena.
function declare_cross_module_externs(cg: CodegenContext*) -> void {
    // Get shared state from CompilationContext, NOT from CodegenContext.
    // cg.intern may read from the wrong struct offset due to the large
    // CodegenContext layout — use ctx_ptr.intern_table which earlier
    // passes rely on successfully.
    const ctx_ptr: CompilationContext* = cg.ctx;
    const intern: InternTable* = ctx_ptr.intern_table;
    const mg: ModuleGraph* = ctx_ptr.module_graph;
    const di: DeclarationIndex* = ctx_ptr.decl_index;
    const arena: TypeArena* = cg.get_arena();
    mut declared: i32 = 0;
    mut skipped: i32 = 0;

    // Iterate over all modules and declare their functions as externs.
    const modules: ModuleInfo[] = mg.modules;
    const current_file: string = ctx_ptr.source_file;
    for (mut mi: i64 = 0; mi < modules.length; mi++) {
        const mod_info: ModuleInfo = modules[mi];
        // Skip the current module — its functions are declared by
        // declare_functions/declare_method in generate_program.
        if (strcmp(mod_info.file_path, current_file) == 0) {
            continue;
        }
        const mod_sym: SymbolStr = intern.intern(mod_info.file_path);

        // Get all functions registered in this module.
        const funcs: SymbolStr[] = di.get_functions_in_module(mod_sym);

        for (mut fi: i64 = 0; fi < funcs.length; fi++) {
            const fn_name: SymbolStr = funcs[fi];

            // Skip if already declared in the current LLVM module.
            const existing: LValue = cg.get_function(fn_name);
            if (existing.is_valid()) {
                continue;
            }

            // Look up the FunctionType from the DI → arena.
            const func_type_ref: TypeRef = di.lookup_func_type(fn_name);
            if (func_type_ref.is_invalid()) {
                // No full signature — try return-type-only fallback.
                const ret_ref: TypeRef = di.lookup_func_return(fn_name);
                if (ret_ref.is_valid()) {
                    const ret_ty: LType = cg.type_mapper.map_type(ret_ref);
                    if (ret_ty.is_valid()) {
                        // Declare as a no-arg function (best effort).
                        const fn_type: LType = LType::function_type(ret_ty, null, 0, false);
                        mut fb_mangled: SymbolStr = di.lookup_mangled_name(fn_name);
                        if (!fb_mangled.is_valid()) {
                            const fb_qname: QualifiedName = QualifiedName::from_symbol(fn_name);
                            fb_mangled = MangledName::for_function(intern, fb_qname).value;
                        }
                        const ir_name: string = intern.resolve(fb_mangled);
                        const fn_val: LValue = cg.llvm_module.add_function(ir_name, fn_type);
                        cg.register_function(fn_name, fn_val);
                        declared = declared + 1;
                    }
                }
                continue;
            }
            // Full signature available — resolve from arena.

            // Resolve the FunctionType from the arena.
            const ft_ptr: Type* = arena.lookup(func_type_ref.id);
            if (ft_ptr == null || ft_ptr.kind != TypeKind::Function) {
                skipped = skipped + 1;
                continue;
            }
            const ft: FunctionType* = ft_ptr as FunctionType*;

            // Map return type.
            const ret_ty: LType = cg.type_mapper.map_type(ft.return_type);
            if (!ret_ty.is_valid()) {
                skipped = skipped + 1;
                continue;
            }

            // Map parameter types.
            const param_count: u32 = ft.param_types.length as u32;
            mut fn_type: LType = LType::null();
            mut valid: boolean = true;

            if (param_count == 0) {
                fn_type = LType::function_type(ret_ty, null, 0, ft.is_variadic);
            } else {
                const buf: void* = malloc(param_count as u64 * 8);
                const slots: void** = buf as void**;
                for (mut j: u32 = 0; j < param_count; j++) {
                    const mapped: LType = cg.type_mapper.map_type(ft.param_types[j]);
                    if (!mapped.is_valid()) {
                        valid = false;
                        break;
                    }
                    slots[j] = mapped.raw;
                }
                if (valid) {
                    fn_type = LType::function_type(ret_ty, buf, param_count, ft.is_variadic);
                }
                free(buf);
            }

            if (!valid || !fn_type.is_valid()) {
                skipped = skipped + 1;
                continue;
            }

            // Look up the pre-computed mangled name from the DI.
            mut mangled_sym: SymbolStr = di.lookup_mangled_name(fn_name);
            if (!mangled_sym.is_valid()) {
                // Fallback: compute from qualified name.
                const ext_qname: QualifiedName = QualifiedName::from_symbol(fn_name);
                const ext_mangled: MangledName = MangledName::for_function(intern, ext_qname);
                mangled_sym = ext_mangled.value;
            }
            const ir_name: string = intern.resolve(mangled_sym);

            const fn_val: LValue = cg.llvm_module.add_function(ir_name, fn_type);
            cg.register_function(fn_name, fn_val);
            cg.register_function_with_arity(fn_name, param_count, fn_val);
            declared = declared + 1;
        }
    }

    if (ctx_ptr.debug_mode) {
        printf("[Codegen] Cross-module externs: %d declared, %d skipped\n", declared, skipped);
    }
}

/// Declare cross-module global variable externs.  Mirrors
/// `declare_cross_module_externs` for functions: walks every module in the
/// module graph, finds globals defined elsewhere, and emits
/// `@name = external global T` stubs in the current LLVM module so that
/// `get_global` lookups resolve to a valid LValue at call sites that
/// reference `g_stderr`, `g_logger`, etc.
function declare_cross_module_global_externs(cg: CodegenContext*) -> void {
    const ctx_ptr: CompilationContext* = cg.ctx;
    const intern: InternTable* = ctx_ptr.intern_table;
    const mg: ModuleGraph* = ctx_ptr.module_graph;
    const di: DeclarationIndex* = ctx_ptr.decl_index;
    mut declared: i32 = 0;
    mut skipped: i32 = 0;

    const modules: ModuleInfo[] = mg.modules;
    const current_file: string = ctx_ptr.source_file;
    for (mut mi: i64 = 0; mi < modules.length; mi++) {
        const mod_info: ModuleInfo = modules[mi];
        if (strcmp(mod_info.file_path, current_file) == 0) {
            continue;
        }
        const mod_sym: SymbolStr = intern.intern(mod_info.file_path);

        const globals: SymbolStr[] = di.get_globals_in_module(mod_sym);
        for (mut gi: i64 = 0; gi < globals.length; gi++) {
            const g_name: SymbolStr = globals[gi];

            // Skip if already declared/registered in the current LLVM module.
            const existing: LValue = cg.get_global(g_name);
            if (existing.is_valid()) {
                continue;
            }

            const g_type_ref: TypeRef = di.lookup_global(g_name);
            if (g_type_ref.is_invalid()) {
                skipped = skipped + 1;
                continue;
            }
            const g_llvm_ty: LType = cg.type_mapper.map_type(g_type_ref);
            if (!g_llvm_ty.is_valid()) {
                skipped = skipped + 1;
                continue;
            }

            // Use the same global-mangling scheme as local definitions so
            // the extern references match the defining module's symbol.
            const g_name_str: string = intern.resolve(g_name);
            const g_qname: QualifiedName = QualifiedName::single(intern, g_name_str);
            const mangled: string = MangledName::for_global(intern, g_qname).resolve(intern);

            const g_val: LValue = cg.llvm_module.add_global(g_llvm_ty, mangled);
            cg.register_global(g_name, g_val);
            declared = declared + 1;
        }
    }

    if (ctx_ptr.debug_mode) {
        printf("[Codegen] Cross-module global externs: %d declared, %d skipped\n", declared, skipped);
    }
}


// ============================================================================
// Phase 3: Generate function bodies
// ============================================================================

/// Generate IR for all function bodies in the program.
/// `visit_fn` is a callback that generates the body using the visitor.
function generate_bodies(cg: CodegenContext*, program: ProgramNode*,
                         visit_fn: void*) -> void {
    const stmts: ASTNode*[] = program.statements;
    for (mut i: i64 = 0; i < stmts.length; i++) {
        const stmt: ASTNode* = stmts[i];
        if (stmt == null) { continue; }

        const kind: NodeKind = stmt.kind;

        if (kind == NodeKind::FunctionDeclaration) {
            const func: FunctionDeclNode* = stmt as FunctionDeclNode*;
            if (func.generic_params.length > 0) { continue; }
            if (func.body == null) { continue; }
            // Body generation happens through the visitor.
        } else if (kind == NodeKind::VariableDeclaration) {
            const var_decl: VarDeclNode* = stmt as VarDeclNode*;
            if (var_decl.is_global) {
                codegen_global_var(cg, var_decl);
            }
        }
    }
}


// ============================================================================
// Global variable codegen
// ============================================================================

/// Generate a global variable declaration with optional initializer.
function codegen_global_var(cg: CodegenContext*, node: VarDeclNode*) -> void {
    const name_str: string = cg.resolve(node.name);
    const qname: QualifiedName = QualifiedName::single(cg.get_intern(), name_str);
    const mangled: string = MangledName::for_global(cg.get_intern(), qname).resolve(cg.get_intern());

    const ty: LType = cg.type_mapper.map_type(node.resolved_type);
    if (!ty.is_valid()) {
        return;
    }

    const global: LValue = cg.llvm_module.add_global(ty, mangled);

    // Set default initializer (zeroinitializer).
    const init: LValue = LType::const_null(ty);
    global.set_initializer(init);

    if (!node.is_mutable) {
        global.set_global_constant(true);
    }

    cg.register_global(node.name, global);
}


// ============================================================================
// Function body codegen
// ============================================================================

/// Generate the body of a function.  Called from the IRGeneratorVisitor.
///
/// 1. Look up the LLVM function
/// 2. Create entry basic block
/// 3. Create allocas for parameters and store incoming values
/// 4. Push scope, bind parameter names
/// 5. The visitor will visit the body (BlockStmtNode)
/// 6. Handle implicit return for void functions
function codegen_function_prologue(cg: CodegenContext*, node: FunctionDeclNode*) -> LValue {
    const ctx_ptr: CompilationContext* = cg.ctx;
    const qualified: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
    const fn_val: LValue = cg.get_function(qualified);
    if (!fn_val.is_valid()) {
        return LValue::null();
    }

    // Create entry basic block.
    const entry_bb: LBasicBlock = LBasicBlock::append(fn_val, "entry");
    cg.builder.position_at_end(entry_bb);

    // Create allocas for each parameter and store the incoming value.
    cg.push_scope();

    for (mut i: u32 = 0; i < node.parameters.length as u32; i++) {
        const param: VarDeclNode* = node.parameters[i];
        const param_name: string = cg.resolve(param.name);
        const param_ty: LType = cg.type_mapper.map_type(param.resolved_type);

        if (!param_ty.is_valid()) {
            cg.pop_scope();
            return LValue::null();
        }

        const alloca: LValue = cg.create_entry_alloca(fn_val, param_name, param_ty);
        const arg: LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, i) };
        cg.builder.build_store(arg, alloca);
        cg.set_named_value(param.name, alloca);
    }

    return fn_val;
}

/// Emit implicit void return ONLY for void/unit functions.
/// Non-void functions must have explicit returns from the source code.
/// If a non-void function's block has no terminator, body generation
/// failed — the caller will strip it back to a declare.
function codegen_function_epilogue(cg: CodegenContext*, node: FunctionDeclNode*) -> void {
    const current_bb: LBasicBlock = cg.builder.get_insert_block();
    if (current_bb.is_valid() && !current_bb.has_terminator()) {
        const ret_ty: TypeRef = node.resolved_return_type;
        mut is_void: boolean = ret_ty.is_invalid();
        if (!is_void) {
            const t: Type* = cg.lookup_type_by_id(ret_ty.id);
            is_void = t != null && (t.kind == TypeKind::Void || t.kind == TypeKind::Unit);
        }
        if (is_void) {
            cg.builder.build_ret_void();
        }
        // Non-void: intentionally leave unterminated. The caller
        // detects this and strips the function body.
    }
    cg.pop_scope();
}

/// Generate function prologue for a method.  Prepends `this` parameter binding.
function codegen_method_prologue(cg: CodegenContext*, node: MethodNode*,
                                  target_type: SymbolStr) -> LValue {
    const func: FunctionDeclNode* = node.func;
    if (func == null) { return LValue::null(); }

    // Look up the function by combined key "Type::method".
    const type_str: string = cg.resolve(target_type);
    const method_str: string = cg.resolve(func.name);
    const combined: string = format("%s::%s", type_str, method_str);
    const combined_sym: SymbolStr = cg.intern_str(combined);

    const fn_val: LValue = cg.get_function(combined_sym);
    if (!fn_val.is_valid()) {
        printf("[IRGen] WARNING: method_prologue — not found: '%s' (id=%u)\n", combined, combined_sym.id); fflush(null);
        return LValue::null();
    }

    const entry_bb: LBasicBlock = LBasicBlock::append(fn_val, "entry");
    cg.builder.position_at_end(entry_bb);

    cg.push_scope();

    // Detect which of the three self forms (if any) this method uses.
    //   `&this` / `mut &this` — param named "&this", semantically a T*
    //   `this`                — param named "this", semantically a by-value T
    //   (none)                — implicit `&this`; `declare_method` synthesized
    //                           a leading T* in the LLVM function signature
    // The LLVM parameter layout depends on which case we're in — matches the
    // logic in declare_method so named_values and LLVM params line up.
    mut explicit_ref_idx: i64 = -1;   // parameters[i] is "&this"
    mut explicit_val_idx: i64 = -1;   // parameters[i] is "this"
    for (mut pc: i64 = 0; pc < func.parameters.length; pc++) {
        const pp: VarDeclNode* = func.parameters[pc];
        if (pp == null) { continue; }
        const pn: string = cg.resolve(pp.name);
        if (strcmp(pn, "&this") == 0) { explicit_ref_idx = pc; break; }
        if (strcmp(pn, "this") == 0)  { explicit_val_idx = pc; break; }
    }

    mut param_idx: u32 = 0;

    // Bind `this` for instance methods.  All three forms produce a `this`
    // named-value that's a pointer to the struct — for by-value `this` we
    // alloca+store the struct so member-access GEPs work the same way.
    if (!node.is_static) {
        const qualified_target: SymbolStr = cg.ctx.qualify_symbol_sym(target_type);
        mut target_ref: TypeRef = cg.ctx.decl_index.lookup_type(qualified_target);
        if (target_ref.is_invalid()) {
            target_ref = cg.ctx.decl_index.lookup_type(target_type);
        }
        if (target_ref.is_invalid()) {
            const ts: string = cg.resolve(target_type);
            const ms: string = cg.resolve(func.name);
            cg.ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("codegen: method '%s::%s' — target type '%s' not found in declaration index", ts, ms, ts));
            cg.pop_scope();
            return LValue::null();
        }

        const this_sym: SymbolStr = cg.intern_str("this");
        const arg0: LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, 0) };

        if (explicit_val_idx >= 0) {
            // By-value `this`: LLVM param 0 is a struct value.  Alloca it so
            // downstream code (member access, method calls) can treat `this`
            // as a pointer uniformly.
            const target_mapped: LType = cg.type_mapper.map_type(target_ref);
            if (!target_mapped.is_valid()) {
                cg.pop_scope();
                return LValue::null();
            }
            const slot: LValue = cg.create_entry_alloca(fn_val, "this", target_mapped);
            cg.builder.build_store(arg0, slot);
            cg.set_named_value(this_sym, slot);
        } else {
            // `&this` (explicit or implicit): LLVM param 0 is already a ptr.
            // Store the raw pointer directly in named_values (no alloca).
            cg.set_named_value(this_sym, arg0);
        }

        param_idx = 1;
    }

    // Bind the remaining user parameters.  Skip whichever self form this
    // method uses (we already handled it above).
    for (mut i: u32 = 0; i < func.parameters.length as u32; i++) {
        const param: VarDeclNode* = func.parameters[i];
        if (param == null) { continue; }
        if (i as i64 == explicit_ref_idx) { continue; }
        if (i as i64 == explicit_val_idx) { continue; }

        const param_name: string = cg.resolve(param.name);
        const param_ty: LType = cg.type_mapper.map_type(param.resolved_type);
        if (!param_ty.is_valid()) {
            cg.pop_scope();
            return LValue::null();
        }

        const alloca: LValue = cg.create_entry_alloca(fn_val, param_name, param_ty);
        const arg: LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, param_idx) };
        cg.builder.build_store(arg, alloca);
        cg.set_named_value(param.name, alloca);
        param_idx = param_idx + 1;
    }

    return fn_val;
}


// ============================================================================
// Helpers
// ============================================================================

/// Map a function's return type to an LLVMType.
function map_return_type(cg: CodegenContext*, node: FunctionDeclNode*) -> LType {
    if (node.resolved_return_type.is_invalid()) {
        return LType::void_type();
    }

    const t: Type* = cg.lookup_type_by_id(node.resolved_return_type.id);
    if (t == null || t.kind == TypeKind::Void || t.kind == TypeKind::Unit) {
        return LType::void_type();
    }

    return cg.type_mapper.map_type(node.resolved_return_type);
}
