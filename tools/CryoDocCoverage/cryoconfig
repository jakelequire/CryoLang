# CryoDocCoverage - the public declarations of a source tree that carry no
# documentation, held to a golden list (`make doc-coverage-check`).
#
# Parses with the compiler library (lexer and parser only), so it links
# what the library links: these per-OS sections mirror tools/CryoLSP's,
# which mirror compiler/cryoconfig's. A mismatch surfaces as
# `undefined reference to clang_*` / `LLVM*` at link time.

[project]
project_name = "cryo-doc-coverage"
output_dir   = "build"
target_type  = "executable"
entry_point  = "src/main.cryo"

[compiler]
debug    = false
optimize = O2

[link.unix]
system = ["LLVM-20"]
search = ["/usr/lib/llvm-20/lib"]
static = ["/usr/lib/llvm-20/lib/libclang-20.so.1"]

[link.windows]
system = ["LLVM-C", "clang"]
search = ["../../.toolchains/llvm-win/lib"]

[dependencies]
compiler = { path = "../../compiler", alias = "Compiler" }
