///! Every declaration below without a comment saying "counted" must not
///! appear in the fixture golden; every one with it must.

namespace fixture::shapes;

/// Documented.
public function documented() -> i32 { return 1; }

public function undocumented() -> i32 { return 2; }                  // counted

function public_by_default() -> i32 { return 3; }                    // counted

private function private_helper() -> i32 { return 4; }

internal function package_helper() -> i32 { return 5; }

public const LIMIT: i32 = 3;                                          // counted

/// Documented.
public const DOCUMENTED_LIMIT: i32 = 4;

public type struct Square {                                           // counted
    side: i32;

    /// Documented.
    public static new(side: i32) -> Square { return Square { side: side }; }

    area(&this) -> i32 { return this.side * this.side; }              // counted

    static unit() -> Square { return Square { side: 1 }; }           // counted

    const SIDES: i32 = 4;                                             // counted

private:
    corner(&this) -> i32 { return 0; }
}

type struct Secret {                                                  // counted
    value: i32;
    reveal(&this) -> i32 { return this.value; }                       // counted
}

private type struct Hidden {
    value: i32;
    reveal(&this) -> i32 { return this.value; }
}

implement struct Hidden {
    public twice(&this) -> i32 { return this.value * 2; }
}

/// Documented.
public type enum Colour {
    Red;
    Green;
}

implement enum Colour {
    is_red(&this) -> boolean { return true; }                         // counted

    /// Documented.
    is_green(&this) -> boolean { return false; }
}

public type trait Measure {                                           // counted
    measure(&this) -> i32;                                            // counted
    /// Twice the measure.
    double(&this) -> i32 { return this.measure() * 2; }
}

implement trait Measure for Square {
    measure(&this) -> i32 { return this.area(); }
}

extern "C" {
    function abs(value: i32) -> i32;
}
