# NewCryoLSP — A Cryo-language LSP server for the Cryo programming language.
#
# Speaks LSP 3.17 (JSON-RPC 2.0 over stdio). Drives the self-hosted Cryo
# compiler in `Lsp` mode to produce diagnostics, hover, go-to-definition,
# and completion responses.

[project]
project_name = "cryolsp"
output_dir   = "build"
target_type  = "executable"
entry_point  = "src/main.cryo"

[compiler]
debug    = false
optimize = true
stdlib   = true

[dependencies]
# Reserved for a future package model. The cross-project source roots
# above are the v1 mechanism for depending on the compiler + stdlib.
compiler = { path = "../../compiler" }
