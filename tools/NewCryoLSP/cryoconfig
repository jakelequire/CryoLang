# NewCryoLSP — Cryo-language LSP server.
#
# LSP 3.17 over JSON-RPC 2.0 over stdio. Drives the self-hosted Cryo
# compiler in `Lsp` mode for diagnostics, hover, go-to-definition, and
# completion. Depends on the compiler library so the AST + type arena +
# resolver are walkable in-process — spawning the binary per check
# would force a re-parse on every keystroke.

[project]
project_name = "cryolsp"
output_dir   = "build"
target_type  = "executable"
entry_point  = "src/main.cryo"

[compiler]
debug    = false
optimize = true
stdlib   = true
# The compiler library transitively pulls in LLVM bindings.  Even
# though the LSP only drives the frontend pipeline (no codegen), the
# linker still resolves every reference in the library, so we have
# to mirror the compiler's LLVM link flags here.
link_libs  = ["LLVM-20"]
link_paths = ["/usr/lib/llvm-20/lib"]

[dependencies]
compiler = { path = "../../compiler", alias = "Compiler" }
