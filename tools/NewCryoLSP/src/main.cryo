///! cryolsp — entry point.
///!
///! Initializes the stderr logger, constructs a Server, runs the
///! event loop. Process exit code is set by the loop:
///!   • 0  — `shutdown` then `exit` notification (clean close)
///!   • 1  — anything else (EOF, fatal protocol error)

namespace Main;

import Server::Server;
import Util::Log;

function main(argc: int, argv: string*) -> int {
    Util::Log::init_stderr_logger();
    Util::Log::info(Str::from_raw("cryolsp starting", 16));
    mut server: Server::Server = Server::Server::new();
    return server.run();
}
