///! Server capabilities — the response payload for `initialize`.
///!
///! V1 advertises:
///!   • Synchronous full-text document sync
///!   • Hover, definition, completion (trigger characters: '.' '::')
///!
///! Push diagnostics use `textDocument/publishDiagnostics`; the spec
///! says that capability is implicit and not declared in the
///! `ServerCapabilities` block, so we don't include it.

namespace Protocol::Capabilities;

import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::json::value;

const SERVER_NAME:    string = "cryolsp";
const SERVER_VERSION: string = "0.1.0";

// LSP TextDocumentSyncKind
const SYNC_NONE:        i32 = 0;
const SYNC_FULL:        i32 = 1;
const SYNC_INCREMENTAL: i32 = 2;

/// Build the JSON `result` payload for an `initialize` reply.
function build_initialize_result() -> JsonValue {
    mut sync: JsonObject = JsonObject::new();
    sync.insert(string_from_lit("openClose"), JsonValue::Bool(true));
    sync.insert(string_from_lit("change"),
                JsonValue::Number(JsonNumber::Int(SYNC_FULL as i64)));
    sync.insert(string_from_lit("save"), JsonValue::Bool(false));

    mut completion: JsonObject = JsonObject::new();
    mut triggers: Array<JsonValue> = Array<JsonValue>::new();
    triggers.push(JsonValue::String(String::from_str(Str::from_raw("." as u8*, 1))));
    triggers.push(JsonValue::String(String::from_str(Str::from_raw("::" as u8*, 2))));
    completion.insert(string_from_lit("triggerCharacters"), JsonValue::Array(triggers));
    completion.insert(string_from_lit("resolveProvider"), JsonValue::Bool(false));

    mut caps: JsonObject = JsonObject::new();
    caps.insert(string_from_lit("textDocumentSync"), JsonValue::Object(sync));
    caps.insert(string_from_lit("hoverProvider"),    JsonValue::Bool(true));
    caps.insert(string_from_lit("definitionProvider"), JsonValue::Bool(true));
    caps.insert(string_from_lit("completionProvider"), JsonValue::Object(completion));

    mut server_info: JsonObject = JsonObject::new();
    server_info.insert(string_from_lit("name"),
        JsonValue::String(string_from_lit(SERVER_NAME)));
    server_info.insert(string_from_lit("version"),
        JsonValue::String(string_from_lit(SERVER_VERSION)));

    mut result: JsonObject = JsonObject::new();
    result.insert(string_from_lit("capabilities"), JsonValue::Object(caps));
    result.insert(string_from_lit("serverInfo"),   JsonValue::Object(server_info));
    return JsonValue::Object(result);
}

function string_from_lit(lit: string) -> String {
    mut len: u64 = 0;
    const ptr: u8* = lit as u8*;
    while (ptr[len] != 0) { len = len + 1; }
    return String::from_str(Str::from_raw(ptr, len));
}
