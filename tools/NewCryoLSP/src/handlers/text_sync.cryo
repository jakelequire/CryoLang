///! textDocument/didOpen, didChange, didClose handlers.
///!
///! Each one mutates the DocumentStore, drives a recompile through
///! the CompilerSession, and pushes diagnostics back to the client.
///! `didSave` is logged but doesn't trigger a recompile — diagnostics
///! are already current from the most recent change.

namespace Handlers::TextSync;

import std::core::option;
import std::core::result;
import std::collections::str;
import std::collections::string;
import std::io::stdio;
import std::json::value;

import Protocol::LspTypes;

import Server::Document;
import Server::CompilerSession;

import Handlers::DiagHandler;
import Util::Log;

// ============================================================================
// didOpen
// ============================================================================

function did_open(docs: mut &DocumentStore, compiler: mut &CompilerSession,
                  params: &JsonValue, writer: mut &Stdout) -> void {
    match (params.get(Str::from_raw("textDocument" as u8*, 12))) {
        Option::Some(td) => {
            match (TextDocumentItem::from_json(td)) {
                Result::Ok(item) => {
                    mut owned: TextDocumentItem = item;
                    open_document(docs, compiler, owned, writer);
                }
                Result::Err(e) => {
                    mut err: LspParseError = e;
                    err.drop();
                    Util::Log::warn(Str::from_raw("didOpen: bad textDocument", 25));
                }
            }
        }
        Option::None => {
            Util::Log::warn(Str::from_raw("didOpen: missing textDocument", 29));
        }
    }
}

function open_document(docs: mut &DocumentStore, compiler: mut &CompilerSession,
                       item: TextDocumentItem, writer: mut &Stdout) -> void {
    mut item_owned: TextDocumentItem = item;
    const doc: Document = Document::new(item_owned.uri, item_owned.language_id,
                                          item_owned.version, item_owned.text);
    // Move ownership into store.
    mut tracked: Document = doc;
    docs.open(tracked);
    // Find back so we can recompile.
    match (docs.get(item_owned.uri.as_str())) {
        Option::Some(d) => {
            match (compiler.recompile(d)) {
                Result::Ok(_)  => {
                    Handlers::DiagHandler::publish(compiler, d.uri.as_str(), writer);
                }
                Result::Err(e) => {
                    mut err: String = e;
                    Util::Log::error(err.as_str());
                    err.drop();
                }
            }
        }
        Option::None => { Util::Log::error(Str::from_raw("didOpen: doc vanished", 21)); }
    }
}

// ============================================================================
// didChange  (full-text replacement, v1)
// ============================================================================

function did_change(docs: mut &DocumentStore, compiler: mut &CompilerSession,
                    params: &JsonValue, writer: mut &Stdout) -> void {
    mut uri_s: String = String::new();
    mut version: i32 = 0;
    match (params.get(Str::from_raw("textDocument" as u8*, 12))) {
        Option::Some(td) => {
            match (VersionedTextDocumentIdentifier::from_json(td)) {
                Result::Ok(v) => {
                    mut id: VersionedTextDocumentIdentifier = v;
                    uri_s   = String::from_str(id.uri.as_str());
                    version = id.version;
                    id.drop();
                }
                Result::Err(e) => {
                    mut err: LspParseError = e;
                    err.drop();
                    Util::Log::warn(Str::from_raw("didChange: bad textDocument", 27));
                    return;
                }
            }
        }
        Option::None => {
            Util::Log::warn(Str::from_raw("didChange: missing textDocument", 31));
            return;
        }
    }

    // Pull the most recent contentChanges entry. v1 expects full-text
    // sync, so we take the LAST entry's `text` field as the new body.
    mut new_text: String = String::new();
    match (params.get(Str::from_raw("contentChanges" as u8*, 14))) {
        Option::Some(changes) => {
            const len: u64 = changes.length();
            if (len == 0) {
                Util::Log::debug(Str::from_raw("didChange: no changes", 21));
                uri_s.drop();
                return;
            }
            match (changes.at(len - 1)) {
                Option::Some(last) => {
                    match (last.get(Str::from_raw("text" as u8*, 4))) {
                        Option::Some(t) => {
                            match (t.as_str()) {
                                Option::Some(s) => { new_text = String::from_str(s); }
                                Option::None    => {
                                    Util::Log::warn(Str::from_raw("didChange: text not string", 26));
                                    uri_s.drop();
                                    return;
                                }
                            }
                        }
                        Option::None => {
                            Util::Log::warn(Str::from_raw("didChange: missing text (incremental sync not supported)", 56));
                            uri_s.drop();
                            return;
                        }
                    }
                }
                Option::None => { uri_s.drop(); return; }
            }
        }
        Option::None => { uri_s.drop(); return; }
    }

    match (docs.replace(uri_s.as_str(), version, new_text)) {
        Result::Ok(_) => { }
        Result::Err(e) => {
            mut err: String = e;
            Util::Log::warn(err.as_str());
            err.drop();
            uri_s.drop();
            return;
        }
    }

    // Recompile + push diagnostics.
    match (docs.get(uri_s.as_str())) {
        Option::Some(d) => {
            match (compiler.recompile(d)) {
                Result::Ok(_)  => {
                    Handlers::DiagHandler::publish(compiler, uri_s.as_str(), writer);
                }
                Result::Err(e) => { mut err: String = e; err.drop(); }
            }
        }
        Option::None => { }
    }
    uri_s.drop();
}

// ============================================================================
// didClose
// ============================================================================

function did_close(docs: mut &DocumentStore, compiler: mut &CompilerSession,
                   params: &JsonValue, writer: mut &Stdout) -> void {
    match (params.get(Str::from_raw("textDocument" as u8*, 12))) {
        Option::Some(td) => {
            match (TextDocumentIdentifier::from_json(td)) {
                Result::Ok(id) => {
                    mut owned: TextDocumentIdentifier = id;
                    // Tell the client to clear squiggles by publishing
                    // an empty diagnostic array.
                    Handlers::DiagHandler::publish_empty(owned.uri.as_str(), writer);
                    docs.close(owned.uri.as_str());
                    compiler.forget(owned.uri.as_str());
                    owned.drop();
                }
                Result::Err(e) => {
                    mut err: LspParseError = e;
                    err.drop();
                }
            }
        }
        Option::None => { }
    }
}
