///! Diagnostics push handler.
///!
///! Reads the diagnostics from the most-recent compile, runs them
///! through the existing `Compiler::Diag::Lsp::diagnostics_to_lsp`
///! converter, then through `Protocol::Conv::compiler_diag_to_json`
///! to produce the LSP wire shape, and emits a
///! `textDocument/publishDiagnostics` notification.

namespace Handlers::DiagHandler;

import std::core::option;
import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::io::stdio;
import std::json::value;

import Compiler::Diag::Lsp;

import Protocol::Framing;
import Protocol::JsonRpc;
import Protocol::Conv;

import Server::CompilerSession;
import Util::Log;
import Util::Uri;

const METHOD:     string = "textDocument/publishDiagnostics";
const METHOD_LEN: u64    = 31;

/// Compute the LSP diagnostics for `uri` and push them to the client.
function publish(compiler: &CompilerSession, uri: Str, writer: mut &Stdout) -> void {
    mut diags: Array<JsonValue> = Array<JsonValue>::new();
    match (compiler.get(uri)) {
        Option::Some(sess) => {
            if (sess.ctx == null) {
                Util::Log::warn(Str::from_raw("publish: ctx null", 17));
                send_payload(uri, &mut diags, writer);
                diags.drop();
                return;
            }
            // Convert internal Diagnostic[] -> compiler-shape LspDiagnostic[].
            const compiler_diags: LspDiagnostic[] =
                Compiler::Diag::Lsp::diagnostics_to_lsp(sess.ctx.diagnostics.diagnostics);
            // Convert each LspDiagnostic -> wire JSON.
            mut i: u64 = 0;
            while (i < compiler_diags.length) {
                diags.push(Protocol::Conv::compiler_diag_to_json(&compiler_diags[i]));
                i++;
            }
        }
        Option::None => { }
    }
    send_payload(uri, &mut diags, writer);
    // diags is now empty (entries were moved into the payload object);
    // drop the array shell.
    diags.drop();
}

/// Publish an empty diagnostics array — clears squiggles on the
/// client. Used by `didClose`.
function publish_empty(uri: Str, writer: mut &Stdout) -> void {
    mut empty: Array<JsonValue> = Array<JsonValue>::new();
    send_payload(uri, &mut empty, writer);
    empty.drop();
}

function send_payload(uri: Str, diags: mut &Array<JsonValue>,
                      writer: mut &Stdout) -> void {
    mut params: JsonObject = JsonObject::new();
    // `uri` is already in URI form (it came from the client on
    // didOpen/didChange or from a path that we ran through
    // path_to_uri at the call site). Pass through verbatim.
    params.insert(string_from_lit("uri"),
                  JsonValue::String(String::from_str(uri)));
    // Move the array into the params object.
    mut moved: Array<JsonValue> = Array<JsonValue>::new();
    // Swap diags <-> moved so we can hand `diags` to JsonValue::Array
    // without aliasing `diags.ptr` afterwards.
    mut i: u64 = 0;
    while (i < diags.length()) {
        moved.push(diags.ptr[i]);
        i++;
    }
    diags.length = 0;
    params.insert(string_from_lit("diagnostics"), JsonValue::Array(moved));

    mut params_value: JsonValue = JsonValue::Object(params);
    mut body: String = JsonRpc::encode_notification(
        Str::from_raw(METHOD as u8*, METHOD_LEN), &params_value);
    params_value.drop();

    match (Framing::write_message(writer, body.as_str())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { Util::Log::error(Str::from_raw("publishDiagnostics write failed", 31)); }
    }
    body.drop();
}

function string_from_lit(lit: string) -> String {
    mut len: u64 = 0;
    const ptr: u8* = lit as u8*;
    while (ptr[len] != 0) { len = len + 1; }
    return String::from_str(Str::from_raw(ptr, len));
}
