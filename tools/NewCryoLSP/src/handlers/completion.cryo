///! textDocument/completion handler.
///!
///! Position → enclosing scope → walk parent scope chain → emit
///! CompletionItem[] mapped from the compiler's `SymbolKind`.
///!
///! v1 does NOT do trigger-character context analysis (e.g.
///! `obj.method(` filtering by receiver type). The full in-scope
///! symbol set is returned and the editor's fuzzy filter picks the
///! relevant subset. Trigger-aware completion lands in v1.1.

namespace Handlers::CompletionHandler;

import std::core::option;
import std::core::result;
import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::json::value;

import Compiler::Resolver;
import Compiler::Resolver::Symbol;
import Compiler::Resolver::SymbolKind;
import Compiler::Resolver::Scope;
import Compiler::Resolver::InternTable;
import Compiler::Types::TypeArena;

import Protocol::LspTypes;

import Server::Document;
import Server::CompilerSession;
import AstQuery::ScopeIndex;

/// Return a `CompletionList` for the cursor position.
function handle(docs: &DocumentStore, compiler: &CompilerSession,
                params: &JsonValue) -> JsonValue {
    mut uri_s: String = String::new();
    match (params.get(Str::from_raw("textDocument" as u8*, 12))) {
        Option::Some(td) => {
            match (td.get(Str::from_raw("uri" as u8*, 3))) {
                Option::Some(u) => {
                    match (u.as_str()) {
                        Option::Some(s) => { uri_s = String::from_str(s); }
                        Option::None    => { return empty_list(); }
                    }
                }
                Option::None => { return empty_list(); }
            }
        }
        Option::None => { return empty_list(); }
    }

    mut line0: u32 = 0;
    mut char0: u32 = 0;
    match (params.get(Str::from_raw("position" as u8*, 8))) {
        Option::Some(pj) => {
            match (Position::from_json(pj)) {
                Result::Ok(p)  => { line0 = p.line; char0 = p.character; }
                Result::Err(e) => { mut err: LspParseError = e; err.drop(); uri_s.drop(); return empty_list(); }
            }
        }
        Option::None => { uri_s.drop(); return empty_list(); }
    }

    const line: u32 = line0 + 1;
    const col:  u32 = char0 + 1;

    match (compiler.get(uri_s.as_str())) {
        Option::Some(sess) => {
            uri_s.drop();
            if (sess.ctx == null || sess.ctx.resolver == null) { return empty_list(); }
            const scope_id: u32 = AstQuery::ScopeIndex::find_enclosing_scope(
                sess.ctx.resolver, line, col);
            return build_completion_list(sess.ctx.resolver,
                                          sess.ctx.intern_table,
                                          sess.ctx.type_arena,
                                          scope_id);
        }
        Option::None => { uri_s.drop(); return empty_list(); }
    }
}

function build_completion_list(resolver: Resolver*, interner: InternTable*,
                               arena: TypeArena*, start_scope_id: u32) -> JsonValue {
    mut items: Array<CompletionItem> = Array<CompletionItem>::new();
    if (resolver == null || interner == null) { return empty_list(); }

    // Walk the scope chain upward, collecting every visible symbol.
    mut sc_id: u32 = start_scope_id;
    while (sc_id > 0) {
        const sc: Scope* = resolver.get_scope(sc_id);
        if (sc == null) { break; }
        for (mut i: int = 0; i < sc.symbol_ids.length; i++) {
            const sym_id: u32 = sc.symbol_ids[i];
            const sym: Symbol* = resolver.get_symbol(sym_id);
            if (sym == null) { continue; }
            items.push(symbol_to_item(sym, interner, arena));
        }
        sc_id = sc.parent_id;
    }

    // Always include the global scope (id 0).
    const global: Scope* = resolver.get_scope(0);
    if (global != null) {
        for (mut i: int = 0; i < global.symbol_ids.length; i++) {
            const sym_id: u32 = global.symbol_ids[i];
            const sym: Symbol* = resolver.get_symbol(sym_id);
            if (sym == null) { continue; }
            items.push(symbol_to_item(sym, interner, arena));
        }
    }

    const list: CompletionList = CompletionList {
        is_incomplete: false,
        items:         items,
    };
    mut owned: CompletionList = list;
    const result: JsonValue = owned.to_json();
    owned.drop();
    return result;
}

function symbol_to_item(sym: Symbol*, interner: InternTable*,
                        arena: TypeArena*) -> CompletionItem {
    const name: string = interner.resolve(sym.name);
    mut name_len: u64 = 0;
    if (name != null) {
        while (name[name_len] != 0) { name_len = name_len + 1; }
    }
    const label: String = if (name != null) {
        String::from_str(Str::from_raw(name as u8*, name_len))
    } else {
        String::from_str(Str::from_raw("?" as u8*, 1))
    };
    const kind: i32 = symbol_kind_to_lsp(sym.kind);

    mut detail: Option<String> = Option::None;
    if (arena != null && sym.type_ref.is_valid()) {
        const tn: string = arena.format_display(sym.type_ref);
        if (tn != null) {
            mut tn_len: u64 = 0;
            while (tn[tn_len] != 0) { tn_len = tn_len + 1; }
            detail = Option::Some(
                String::from_str(Str::from_raw(tn as u8*, tn_len)));
        }
    }

    return CompletionItem { label: label, kind: kind, detail: detail };
}

/// Map the compiler's `SymbolKind` to the LSP `CompletionItemKind`.
/// Unknown kinds fall back to `Text` (1).
function symbol_kind_to_lsp(k: SymbolKind) -> i32 {
    return match (k) {
        SymbolKind::Variable     => { LspTypes::KIND_VARIABLE }
        SymbolKind::Parameter    => { LspTypes::KIND_VARIABLE }
        SymbolKind::Function     => { LspTypes::KIND_FUNCTION }
        SymbolKind::Method       => { LspTypes::KIND_METHOD }
        SymbolKind::Type         => { LspTypes::KIND_CLASS }
        SymbolKind::TypeAlias    => { LspTypes::KIND_CLASS }
        SymbolKind::Constant     => { LspTypes::KIND_CONSTANT }
        SymbolKind::Field        => { LspTypes::KIND_FIELD }
        SymbolKind::EnumVariant  => { LspTypes::KIND_ENUM_MEMBER }
        SymbolKind::GenericParam => { LspTypes::KIND_TYPE_PARAM }
        SymbolKind::Namespace    => { LspTypes::KIND_MODULE }
        SymbolKind::Import       => { LspTypes::KIND_MODULE }
        SymbolKind::Intrinsic    => { LspTypes::KIND_OPERATOR }
        _                        => { LspTypes::KIND_TEXT }
    };
}

function empty_list() -> JsonValue {
    const list: CompletionList = CompletionList {
        is_incomplete: false,
        items:         Array<CompletionItem>::new(),
    };
    mut owned: CompletionList = list;
    const result: JsonValue = owned.to_json();
    owned.drop();
    return result;
}
