///! Go-to-definition handler.
///!
///! v1: returns `null` for every position.  Wiring is in place
///! (request → response, capability bit advertised in initialize);
///! the position-→-AST-node walker + resolver lookup that turn a
///! cursor into a `Symbol::declaring_span` is future work.
///!
///! `null` is the LSP-spec-correct "no definition found" reply, so
///! editors render it gracefully (no jump, no error pop-up).

namespace Lsp::Handlers::Definition;

import std::core::option;
import std::collections::str;
import std::collections::string;
import std::json::value;

import Lsp::Server::Docs;
import Lsp::Server::Session;


public function handle_definition(docs: &Docs, sessions: mut &SessionMap,
                                   params: &JsonValue) -> JsonValue {
    match (params.get(Str::from_cstr("textDocument"))) {
        Option::Some(_) => { }
        Option::None    => { }
    }
    return JsonValue::Null;
}
