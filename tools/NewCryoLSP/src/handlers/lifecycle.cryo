///! Lifecycle handlers — `shutdown` and the `exit` integration point.
///!
///! `initialize` is handled inline in `Server::Server::handle_initialize`
///! because it needs to mutate state that lives on the server. This
///! module owns `shutdown` (drop tracked sessions) and provides helpers
///! the server uses for the `exit` notification.

namespace Handlers::Lifecycle;

import Server::Document;
import Server::CompilerSession;
import Util::Log;

/// Drop every open document + compiler session and flag the server
/// as ready to exit. Subsequent requests will be rejected.
function handle_shutdown(state: mut &ServerState, docs: mut &DocumentStore,
                        compiler: mut &CompilerSession) -> void {
    Util::Log::info(Str::from_raw("shutdown received" as u8*, 17));
    state.shutdown_requested = true;
    docs.drop();
    *docs = DocumentStore::new();
    compiler.drop();
    *compiler = CompilerSession::new();
}

/// Lifecycle/state struct shared with the server. Re-exported here so
/// the dispatcher in `server.cryo` and the handler agree on the shape.
type struct ServerState {
    initialized:        boolean;
    shutdown_requested: boolean;
    root_uri:           String;
}
