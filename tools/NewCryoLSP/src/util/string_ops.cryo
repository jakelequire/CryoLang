///! string_ops — local string helpers the stdlib doesn't ship yet.
///!
///! Byte-level primitives only. Anything that needs UTF-8 awareness
///! belongs in `core::slice` or `collections::str` upstream.

namespace Util::StringOps;

import std::core::option;
import std::collections::str;
import std::collections::string;

const SPACE: u8 = 32;
const HT:    u8 = 9;
const CR:    u8 = 13;
const LF:    u8 = 10;

/// Find the first occurrence of `needle` in `haystack`. Returns the
/// 0-based byte index, or `None` if absent.
function find_byte(haystack: Str, needle: u8) -> Option<u64> {
    const len: u64 = haystack.length();
    const ptr: u8* = haystack.as_ptr();
    mut i: u64 = 0;
    while (i < len) {
        if (ptr[i] == needle) { return Option::Some(i); }
        i++;
    }
    return Option::None;
}

/// True iff `haystack` contains `needle` at byte granularity.
function contains_byte(haystack: Str, needle: u8) -> boolean {
    return find_byte(haystack, needle).is_some();
}

/// Split `s` once at the first occurrence of `delim`. Returns
/// `(before, after)` or `None` if the delimiter is absent. Neither
/// half includes the delimiter byte.
function split_once(s: Str, delim: u8) -> Option<SplitPair> {
    match (find_byte(s, delim)) {
        Option::Some(i) => {
            return Option::Some(SplitPair {
                before: s.sub_bytes(0, i),
                after:  s.sub_bytes(i + 1, s.length()),
            });
        }
        Option::None => { return Option::None; }
    }
}

type struct SplitPair {
    before: Str;
    after:  Str;
}

/// Trim leading + trailing ASCII whitespace (SP, HT, CR, LF). Returns
/// a sub-slice of `s`.
function trim(s: Str) -> Str {
    const len: u64 = s.length();
    const ptr: u8* = s.as_ptr();
    mut start: u64 = 0;
    while (start < len) {
        const b: u8 = ptr[start];
        if (b == SPACE || b == HT || b == CR || b == LF) { start = start + 1; }
        else                                              { break; }
    }
    mut end: u64 = len;
    while (end > start) {
        const b: u8 = ptr[end - 1];
        if (b == SPACE || b == HT || b == CR || b == LF) { end = end - 1; }
        else                                              { break; }
    }
    return s.sub_bytes(start, end);
}

/// True iff the two byte slices are equal.
function bytes_equal(a: Str, b: Str) -> boolean {
    return a.equals(&b);
}

/// True iff `s` starts with `prefix`.
function starts_with(s: Str, prefix: Str) -> boolean {
    if (s.length() < prefix.length()) { return false; }
    return s.sub_bytes(0, prefix.length()).equals(&prefix);
}
