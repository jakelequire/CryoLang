///! Stderr logger.
///!
///! **Stdout is reserved for LSP protocol traffic.** Every log call
///! goes to fd 2. The logger is a thin wrapper over `eprintln` (stdlib
///! `fmt::display::eprintln`) plus a level prefix.
///!
///! No file logging in v1. Pipe stderr to a file if the editor doesn't
///! capture it (VS Code shows it in the "CryoLSP" output channel).

namespace Util::Log;

import std::io::stdio;
import std::collections::str;
import std::collections::string;
import std::fmt::display;

mut g_initialized: boolean = false;

/// Optional one-time init. Idempotent — calling it twice is a no-op.
function init_stderr_logger() -> void {
    g_initialized = true;
}

function info(msg: Str) -> void {
    write_prefixed("[INFO ] ", 8, msg);
}

function debug(msg: Str) -> void {
    write_prefixed("[DEBUG] ", 8, msg);
}

function warn(msg: Str) -> void {
    write_prefixed("[WARN ] ", 8, msg);
}

function error(msg: Str) -> void {
    write_prefixed("[ERROR] ", 8, msg);
}

function write_prefixed(prefix_lit: string, prefix_len: u64, msg: Str) -> void {
    mut err: Stderr = stderr();
    const prefix: Str = Str::from_raw(prefix_lit as u8*, prefix_len);
    match (err.write(prefix.as_ptr(), prefix.length())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return; }
    }
    match (err.write(msg.as_ptr(), msg.length())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return; }
    }
    const nl: u8 = 10;
    match (err.write(&nl, 1)) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return; }
    }
}
