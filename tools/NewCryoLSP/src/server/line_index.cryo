///! LineIndex — byte-offset-of-line-start cache.
///!
///! For a given document text, store an `Array<u64>` where entry `i`
///! is the byte offset at which line `i` (0-indexed) begins. This
///! turns an LSP `Position { line, character }` into a single byte
///! offset in O(1) and a byte offset back into a `(line, character)`
///! pair in O(log n).
///!
///! v1 treats `character` as a byte offset (assumes ASCII). The
///! struct is wide enough that swapping in a UTF-16 boundary table
///! later is a non-breaking change.

namespace Server::LineIndex;

import std::core::option;
import std::collections::array;
import std::collections::str;
import std::collections::string;

type struct LineIndex {
    /// Byte offset of the first byte of each line. `line_starts[0] == 0`
    /// always. The trailing entry is the document length (one past the
    /// last byte) so range queries don't need a special case.
    line_starts: Array<u64>;
    total_bytes: u64;

    static empty() -> LineIndex {
        mut starts: Array<u64> = Array<u64>::new();
        starts.push(0);
        starts.push(0);
        return LineIndex { line_starts: starts, total_bytes: 0 };
    }

    /// Build from `text`. Walks the bytes once. Treats `\r\n` as a
    /// single line break so DOS-line-ending files don't double-count.
    static build(text: Str) -> LineIndex {
        mut starts: Array<u64> = Array<u64>::new();
        starts.push(0);
        const ptr: u8* = text.as_ptr();
        const len: u64 = text.length();
        mut i: u64 = 0;
        while (i < len) {
            const b: u8 = ptr[i];
            if (b == 13 && i + 1 < len && ptr[i + 1] == 10) {
                // \r\n
                starts.push(i + 2);
                i = i + 2;
                continue;
            }
            if (b == 10) {
                starts.push(i + 1);
                i = i + 1;
                continue;
            }
            i = i + 1;
        }
        // Sentinel — line "after the last" begins at byte `len`.
        starts.push(len);
        return LineIndex { line_starts: starts, total_bytes: len };
    }

    line_count(&this) -> u64 {
        // The trailing sentinel doesn't count as a real line.
        if (this.line_starts.length() == 0) { return 0; }
        return this.line_starts.length() - 1;
    }

    /// Convert (line, character) to a byte offset. Out-of-range
    /// positions clamp to the end of the document.
    offset_of(&this, line: u32, character: u32) -> u64 {
        const line_idx: u64 = line as u64;
        if (line_idx >= this.line_starts.length()) { return this.total_bytes; }
        const start: u64 = this.line_starts.ptr[line_idx];
        const end:   u64 = if (line_idx + 1 < this.line_starts.length()) {
            this.line_starts.ptr[line_idx + 1]
        } else {
            this.total_bytes
        };
        const offset: u64 = start + (character as u64);
        if (offset > end) { return end; }
        return offset;
    }

    /// Convert a byte offset to (line, character). Binary search over
    /// `line_starts`.
    position_of(&this, offset: u64) -> Position {
        // Binary search for the largest line_starts[i] <= offset.
        const n: u64 = this.line_count();
        if (n == 0) { return Position { line: 0, character: 0 }; }
        mut lo: u64 = 0;
        mut hi: u64 = n;     // exclusive — we want indices in [0, n)
        while (lo < hi) {
            const mid: u64 = lo + (hi - lo) / 2;
            const ms:  u64 = this.line_starts.ptr[mid];
            if (ms <= offset) { lo = mid + 1; }
            else              { hi = mid; }
        }
        const line: u64 = if (lo == 0) { 0 } else { lo - 1 };
        const ch:   u64 = offset - this.line_starts.ptr[line];
        return Position { line: line as u32, character: ch as u32 };
    }

    drop(mut &this) -> void {
        this.line_starts.drop();
    }
}

/// Plain-data position (mirrors LSP `Position` but living next to the
/// LineIndex to avoid a dependency cycle).
type struct Position {
    line:      u32;
    character: u32;
}
