///! CompilerSession — owns one CompilerInstance + per-URI session state.
///!
///! Each open document gets a `DocumentSession` carrying its own
///! `CompilationContext*`. Recompiling drops the previous context and
///! constructs a new one — frontend-only LSP compiles run in
///! milliseconds, so this trade is acceptable for v1. Cross-document
///! context reuse is a v1.x optimization.
///!
///! After `recompile(uri)`:
///!   • `session.ctx.artifacts.ast` holds the parsed program (AST is
///!     preserved because `CompileMode::Lsp.preserve_asts() == true`).
///!   • `session.ctx.diagnostics.diagnostics[]` holds errors/warnings.
///!   • `session.ctx.resolver` holds the name-resolution results.
///!   • `session.ctx.type_arena` holds type info.

namespace Server::CompilerSession;

import std::core::option;
import std::core::result;
import std::collections::str;
import std::collections::string;
import std::collections::hashmap;

import Compiler::Instance;
import Compiler::CompilationContext;
import Compiler::CompileMode;
import Compiler::Diag::Sink;

import Server::Document;
import Util::Log;

type struct DocumentSession {
    uri:     String;
    version: i32;
    /// Owning pointer to the per-document compilation context. Null
    /// before the first compile; non-null afterwards. Replaced on
    /// every recompile.
    ctx:     CompilationContext*;
    /// Whether the most-recent compile finished successfully (no fatal
    /// pass error). Diagnostics are still surfaced even when this is
    /// false — failed compiles still produce useful errors for the
    /// editor to render.
    success: boolean;

    drop(mut &this) -> void {
        this.uri.drop();
        if (this.ctx != null) {
            // The ctx struct holds Box-leaked sub-objects; the proper
            // teardown lives on CompilationContext::drop. The bridge
            // between heap-allocated ctx pointers and Cryo's drop
            // protocol is awkward today — for v1 we simply leak the
            // sub-objects on document close. Stale entries don't
            // accumulate fast (LSP sessions live for hours, not
            // minutes), so this is acceptable for v1.
            //
            // TODO: add CompilationContext::dispose(ctx*) so we can
            // properly free the resolver, type arena, and intern
            // table when a document closes.
            this.ctx = null;
        }
    }
}

type struct CompilerSession {
    instance: CompilerInstance;
    sessions: HashMap<String, DocumentSession>;

    static new() -> CompilerSession {
        return CompilerSession {
            instance: CompilerInstance::new(),
            sessions: HashMap<String, DocumentSession>::new(),
        };
    }

    /// Compile (or recompile) the document at `uri` from its current
    /// in-memory text. Returns the index into the diagnostics array
    /// the caller should publish.
    recompile(mut &this, doc: &Document) -> Result<(), String> {
        mut key: String = String::from_str(doc.uri.as_str());

        // Construct a fresh CompilationContext. We allocate it on the
        // heap so the pointer can outlive this stack frame and be
        // queried later by hover/definition/completion.
        const ctx_box: CompilationContext* =
            malloc(intrinsics::sizeof<CompilationContext>()) as CompilationContext*;
        intrinsics::memset(ctx_box as void*, 0,
                           intrinsics::sizeof<CompilationContext>());
        *ctx_box = CompilationContext::new(CompileMode::Lsp, doc.uri.as_str());

        match (this.instance.compile_for_lsp_content_into(
                    ctx_box, doc.uri.as_str(), doc.text.as_str())) {
            // CompilationResult is opaque to us — we only care that the
            // call returned. Errors are surfaced via the diagnostics
            // sink, and partial trees survive (lenient_codegen).
            _ => { }
        }

        // Replace any previous session for this URI.
        match (this.sessions.get_ptr(&key)) {
            Option::Some(prev) => {
                prev.ctx = ctx_box;
                prev.version = doc.version;
                key.drop();
                return Result::Ok(());
            }
            Option::None => { }
        }

        const sess: DocumentSession = DocumentSession {
            uri:     String::from_str(doc.uri.as_str()),
            version: doc.version,
            ctx:     ctx_box,
            success: true,
        };
        this.sessions.insert(key, sess);
        return Result::Ok(());
    }

    /// Look up the per-document session for hover/definition/completion.
    get(&this, uri: Str) -> Option<DocumentSession*> {
        mut probe: String = String::from_str(uri);
        const r: Option<DocumentSession*> = this.sessions.get_ptr(&probe);
        probe.drop();
        return r;
    }

    /// Drop the session for a closed document. The owning ctx is
    /// retired; the diagnostics array clears in the close handler.
    forget(mut &this, uri: Str) -> void {
        mut probe: String = String::from_str(uri);
        this.sessions.remove(&probe);
        probe.drop();
    }

    drop(mut &this) -> void {
        this.sessions.drop();
    }
}
