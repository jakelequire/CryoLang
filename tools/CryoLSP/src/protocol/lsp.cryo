///! LSP 3.17 wire types.
///!
///! Just the shapes the v1 server actually emits - Position, Range,
///! Location, Hover, MarkupContent.  Each type carries
///! `to_json()` so dispatch handlers can build a wire payload without
///! touching JsonObject directly.
///!
///! NOTE: LSP diagnostics are NOT modelled here.  `publishDiagnostics`
///! payloads are built directly from `compiler::diag::diagnostic` in
///! `lsp::protocol::conv` - a wire-side `Diagnostic` struct here would
///! collide by bare name with the compiler's `Diagnostic` (Cryo's
///! resolver exposes a dependency's type names globally), which breaks
///! compilation of the compiler library the LSP links against.
///!
///! Field names follow the spec exactly so the JSON encoder doesn't
///! need a translation table.

namespace lsp::protocol::lsp;

import std::core::option;
import std::collections::str;
import std::collections::string::{ String };
import std::collections::array;
import std::json::value;


// Position / Range / Location  (LSP section 3.6.4 / 3.6.5 / 3.6.6)

/// Zero-based line + UTF-16 character offset.  Cryo source is UTF-8
/// internally; the conversion happens in `server::line_index`.
type struct Position {
    line:      u32;
    character: u32;

    static new(line: u32, character: u32) -> Position {
        return Position { line: line, character: character };
    }

    to_json(&this) -> value::JsonValue {
        mut o: value::JsonObject = value::JsonObject::new();
        o.put("line",      value::JsonValue::int_value(this.line as i64));
        o.put("character", value::JsonValue::int_value(this.character as i64));
        return value::JsonValue::Object(o);
    }
}

type struct Range {
    start: Position;
    end:   Position;

    static new(start: Position, end: Position) -> Range {
        return Range { start: start, end: end };
    }

    to_json(&this) -> value::JsonValue {
        mut o: value::JsonObject = value::JsonObject::new();
        o.put("start", this.start.to_json());
        o.put("end",   this.end.to_json());
        return value::JsonValue::Object(o);
    }
}

type struct Location {
    uri:   String;
    range: Range;

    to_json(&this) -> value::JsonValue {
        mut o: value::JsonObject = value::JsonObject::new();
        o.put("uri",   value::JsonValue::from(this.uri.as_str()));
        o.put("range", this.range.to_json());
        return value::JsonValue::Object(o);
    }
}

implement trait Drop for struct Location {
    drop(mut &this) -> void { }
}


// Hover + MarkupContent  (LSP section 3.6.18)

type struct MarkupContent {
    /// "plaintext" or "markdown"
    kind:  String;
    value: String;

    static markdown(value: String) -> MarkupContent {
        return MarkupContent {
            kind:  String::from_str(str::Str::from("markdown")),
            value: value,
        };
    }

    to_json(&this) -> value::JsonValue {
        mut o: value::JsonObject = value::JsonObject::new();
        o.put("kind",  value::JsonValue::from(this.kind.as_str()));
        o.put("value", value::JsonValue::from(this.value.as_str()));
        return value::JsonValue::Object(o);
    }
}

implement trait Drop for struct MarkupContent {
    drop(mut &this) -> void { }
}

type struct Hover {
    contents: MarkupContent;
    range:    Option<Range>;

    to_json(&this) -> value::JsonValue {
        mut o: value::JsonObject = value::JsonObject::new();
        o.put("contents", this.contents.to_json());
        match (&this.range) {
            Option::Some(r) => {
                o.put("range", r.to_json());
            }
            Option::None => { }
        }
        return value::JsonValue::Object(o);
    }
}

implement trait Drop for struct Hover {
    drop(mut &this) -> void { }
}

