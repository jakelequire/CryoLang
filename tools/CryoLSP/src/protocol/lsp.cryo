///! LSP 3.17 wire types.
///!
///! Just the shapes the v1 server actually emits - Position, Range,
///! Location, Hover, MarkupContent, CompletionItem.  Each type carries
///! `to_json()` so dispatch handlers can build a wire payload without
///! touching JsonObject directly.
///!
///! NOTE: LSP diagnostics are NOT modelled here.  `publishDiagnostics`
///! payloads are built directly from `Compiler::Diag::Diagnostic` in
///! `Lsp::Protocol::Conv` - a wire-side `Diagnostic` struct here would
///! collide by bare name with the compiler's `Diagnostic` (Cryo's
///! resolver exposes a dependency's type names globally), which breaks
///! compilation of the compiler library the LSP links against.
///!
///! Field names follow the spec exactly so the JSON encoder doesn't
///! need a translation table.

namespace Lsp::Protocol::Lsp;

import std::core::option;
import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::json::value;


// Position / Range / Location  (LSP section 3.6.4 / 3.6.5 / 3.6.6)

/// Zero-based line + UTF-16 character offset.  Cryo source is UTF-8
/// internally; the conversion happens in `Server::LineIndex`.
type struct Position {
    line:      u32;
    character: u32;

    static new(line: u32, character: u32) -> Position {
        return Position { line: line, character: character };
    }

    to_json(&this) -> JsonValue {
        mut o: JsonObject = JsonObject::new();
        o.put("line",      JsonValue::int_value(this.line as i64));
        o.put("character", JsonValue::int_value(this.character as i64));
        return JsonValue::Object(o);
    }

    static from_json(v: &JsonValue) -> Option<Position> {
        match (v.get(Str::from("line"))) {
            Option::Some(line_v) => {
                match (line_v.get(Str::from("character"))) { _ => { } }
                const line: u32 = Position::json_u32_or(line_v, 0);
                match (v.get(Str::from("character"))) {
                    Option::Some(ch_v) => {
                        const ch: u32 = Position::json_u32_or(ch_v, 0);
                        return Option::Some(Position::new(line, ch));
                    }
                    Option::None => { return Option::None; }
                }
            }
            Option::None => { return Option::None; }
        }
    }

    /// Read a non-negative integer field from a JsonValue, with a fallback
    /// when the key is missing or the value isn't a number.  Saturates at
    /// u32::MAX so a malformed huge number doesn't overflow callers.
    static json_u32_or(v: &JsonValue, fallback: u32) -> u32 {
        match (v) {
            JsonValue::Number(n) => {
                match (n) {
                    JsonNumber::Int(i) => {
                        if (i < 0)             { return fallback; }
                        if (i > 4294967295)    { return 4294967295 as u32; }
                        return i as u32;
                    }
                    JsonNumber::UInt(u) => {
                        if (u > 4294967295)    { return 4294967295 as u32; }
                        return u as u32;
                    }
                    JsonNumber::Float(f) => {
                        if (f < 0.0)           { return fallback; }
                        return f as u32;
                    }
                }
            }
            _ => { return fallback; }
        }
    }
}

type struct Range {
    start: Position;
    end:   Position;

    static new(start: Position, end: Position) -> Range {
        return Range { start: start, end: end };
    }

    to_json(&this) -> JsonValue {
        mut o: JsonObject = JsonObject::new();
        o.put("start", this.start.to_json());
        o.put("end",   this.end.to_json());
        return JsonValue::Object(o);
    }
}

type struct Location {
    uri:   String;
    range: Range;

    to_json(&this) -> JsonValue {
        mut o: JsonObject = JsonObject::new();
        o.put("uri",   JsonValue::from(this.uri.as_str()));
        o.put("range", this.range.to_json());
        return JsonValue::Object(o);
    }

    drop(mut &this) -> void {
        this.uri.drop();
    }
}


// Hover + MarkupContent  (LSP section 3.6.18)

type struct MarkupContent {
    /// "plaintext" or "markdown"
    kind:  String;
    value: String;

    static markdown(value: String) -> MarkupContent {
        return MarkupContent {
            kind:  String::from_str(Str::from("markdown")),
            value: value,
        };
    }

    to_json(&this) -> JsonValue {
        mut o: JsonObject = JsonObject::new();
        o.put("kind",  JsonValue::from(this.kind.as_str()));
        o.put("value", JsonValue::from(this.value.as_str()));
        return JsonValue::Object(o);
    }

    drop(mut &this) -> void {
        this.kind.drop();
        this.value.drop();
    }
}

type struct Hover {
    contents: MarkupContent;
    range:    Option<Range>;

    to_json(&this) -> JsonValue {
        mut o: JsonObject = JsonObject::new();
        o.put("contents", this.contents.to_json());
        match (this.range) {
            Option::Some(r) => {
                o.put("range", r.to_json());
            }
            Option::None => { }
        }
        return JsonValue::Object(o);
    }

    drop(mut &this) -> void {
        this.contents.drop();
    }
}


// CompletionItem  (LSP section 3.6.21)

/// Subset of CompletionItemKind we currently emit.  The numeric
/// values are the LSP-spec encodings - VS Code and others render
/// distinct icons per kind.
type enum CompletionItemKind {
    Text;        // 1
    Method;      // 2
    Function;    // 3
    Variable;    // 6
    Class;       // 7
    Interface;   // 8
    Module;      // 9
    Field;       // 5
    Enum;        // 13
    Keyword;     // 14
    Snippet;     // 15
}

implement enum CompletionItemKind {
    to_int(&this) -> i64 {
        return match (this) {
            CompletionItemKind::Text      => { 1 as i64 }
            CompletionItemKind::Method    => { 2 as i64 }
            CompletionItemKind::Function  => { 3 as i64 }
            CompletionItemKind::Field     => { 5 as i64 }
            CompletionItemKind::Variable  => { 6 as i64 }
            CompletionItemKind::Class     => { 7 as i64 }
            CompletionItemKind::Interface => { 8 as i64 }
            CompletionItemKind::Module    => { 9 as i64 }
            CompletionItemKind::Enum      => { 13 as i64 }
            CompletionItemKind::Keyword   => { 14 as i64 }
            CompletionItemKind::Snippet   => { 15 as i64 }
        };
    }
}

type struct CompletionItem {
    label:  String;
    kind:   CompletionItemKind;
    detail: Option<String>;

    to_json(&this) -> JsonValue {
        mut o: JsonObject = JsonObject::new();
        o.put("label", JsonValue::from(this.label.as_str()));
        o.put("kind",  JsonValue::int_value(this.kind.to_int()));
        match (this.detail) {
            Option::Some(d) => {
                o.put("detail", JsonValue::from(d.as_str()));
            }
            Option::None => { }
        }
        return JsonValue::Object(o);
    }

    drop(mut &this) -> void {
        this.label.drop();
        match (this.detail) {
            Option::Some(d) => { d.drop(); }
            Option::None    => { }
        }
    }
}


