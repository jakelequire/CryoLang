///! JSON-RPC 2.0 envelope - request, notification, response.
///!
///! The wire layer above `Framing` (which deals in raw bytes) and
///! below the LSP semantic types.  Every inbound frame becomes an
///! `IncomingMessage`; every reply we send becomes a
///! `ResponseMessage` serialised back through `encode_response`.
///!
///! `IncomingMessage::Invalid(reason)` collapses every flavour of
///! "unparseable" - bad JSON, missing `jsonrpc`, missing `method`,
///! malformed `id` - so the dispatch layer has one decision branch
///! instead of N.  The `reason` String is owned and dropped when
///! the message is.

namespace lsp::protocol::jsonrpc;

import std::core::option;
import std::core::result;
import std::collections::str;
import std::collections::string;
import std::collections::string::{ String };
import std::collections::array;
import std::collections::array::{ Array };
import std::json::value;
import std::json::parser;
import std::json::serializer;
import std::json::error;


// JSON-RPC error codes (LSP section 3.4)

const PARSE_ERROR:           i32 = -32700;
const INVALID_REQUEST:       i32 = -32600;
const METHOD_NOT_FOUND:      i32 = -32601;
const INVALID_PARAMS:        i32 = -32602;
const INTERNAL_ERROR:        i32 = -32603;
const SERVER_NOT_INITIALIZED: i32 = -32002;
const REQUEST_FAILED:        i32 = -32803;


// Inbound - request / notification / invalid

/// A fully-decoded JSON-RPC request.  `id` is owned (cloned out of
/// the parsed JSON tree); `method` and `params` are likewise owned.
type struct RequestMessage {
    id:     value::JsonValue;
    method: String;
    params: value::JsonValue;

    drop(mut &this) -> void {
        this.id.drop();
        this.method.drop();
        this.params.drop();
    }
}

type struct NotificationMessage {
    method: String;
    params: value::JsonValue;

    drop(mut &this) -> void {
        this.method.drop();
        this.params.drop();
    }
}

type enum IncomingMessage {
    Request(RequestMessage);
    Notification(NotificationMessage);
    /// Body could not be decoded into a valid JSON-RPC message.
    /// `reason` is a human-readable explanation we can log.
    Invalid(String);
}

implement enum IncomingMessage {
    drop(mut &this) -> void {
        match (this) {
            IncomingMessage::Request(r)      => { r.drop(); }
            IncomingMessage::Notification(n) => { n.drop(); }
            IncomingMessage::Invalid(s)      => { s.drop(); }
        }
    }
}


// Outbound - response

type struct ErrorObject {
    code:    i32;
    message: String;

    static new(code: i32, message: String) -> ErrorObject {
        return ErrorObject { code: code, message: message };
    }

    drop(mut &this) -> void {
        this.message.drop();
    }
}

type struct ResponseMessage {
    id:     value::JsonValue;
    result: value::JsonValue;
    error:  Option<ErrorObject>;

    static success(id: value::JsonValue, result: value::JsonValue) -> ResponseMessage {
        return ResponseMessage {
            id:     id,
            result: result,
            error:  Option::None,
        };
    }

    static failure(id: value::JsonValue, err: ErrorObject) -> ResponseMessage {
        return ResponseMessage {
            id:     id,
            result: value::JsonValue::Null,
            error:  Option::Some(err),
        };
    }

    drop(mut &this) -> void {
        this.id.drop();
        this.result.drop();
        match (this.error) {
            Option::Some(e) => { e.drop(); }
            Option::None    => { }
        }
    }
}


// JsonRpcCodec - parse inbound frames, encode outbound messages.
// All statics: the codec is stateless (operates on the value passed in).

type struct JsonRpcCodec {

    // Parsing

    /// Decode the body of one frame into an `IncomingMessage`.  Any
    /// failure mode - bad JSON, missing fields, wrong shapes - collapses
    /// into `Invalid(reason)` so the caller has a single recovery path.
    static parse_incoming(body: str::Str) -> IncomingMessage {
        match (parser::parse(body)) {
            Result::Ok(v) => {
                mut owned: value::JsonValue = v;
                return JsonRpcCodec::classify(&owned);
            }
            Result::Err(e) => {
                mut err: error::JsonError  = e;
                mut reason: String  = String::new();
                reason.push("json parse failed: ");
                reason.push(err.msg.as_str());
                err.drop();
                return IncomingMessage::Invalid(reason);
            }
        }
    }

    /// Classify an already-parsed JsonValue.  Mutates the input by
    /// extracting (cloning out) owned fields; the leftover container is
    /// dropped before we return.
    static classify(v: mut &value::JsonValue) -> IncomingMessage {
        if (!v.is_object()) {
            v.drop();
            return JsonRpcCodec::invalid_msg("body is not a JSON object");
        }

        // jsonrpc must be the literal string "2.0".
        if (!JsonRpcCodec::field_equals(v, "jsonrpc", "2.0")) {
            v.drop();
            return JsonRpcCodec::invalid_msg("missing or wrong 'jsonrpc' field");
        }

        // method must be a string.
        const method: String = match (JsonRpcCodec::clone_string_field(v, "method")) {
            Option::Some(s) => { s }
            Option::None    => {
                v.drop();
                return JsonRpcCodec::invalid_msg("missing 'method' field");
            }
        };

        // params: object/array/missing -> defaults to Null for handlers.
        const params: value::JsonValue = match (JsonRpcCodec::clone_field(v, "params")) {
            Option::Some(p) => { p }
            Option::None    => { value::JsonValue::Null }
        };

        // id present => request, absent => notification.
        match (JsonRpcCodec::clone_field(v, "id")) {
            Option::Some(id) => {
                v.drop();
                return IncomingMessage::Request(RequestMessage {
                    id:     id,
                    method: method,
                    params: params,
                });
            }
            Option::None => {
                v.drop();
                return IncomingMessage::Notification(NotificationMessage {
                    method: method,
                    params: params,
                });
            }
        }
    }

    static invalid_msg(reason: string) -> IncomingMessage {
        mut s: String = String::new();
        s.push(reason);
        return IncomingMessage::Invalid(s);
    }

    static field_equals(obj: &value::JsonValue, key: string, expected: string) -> boolean {
        match (obj.get(str::Str::from(key))) {
            Option::Some(v) => {
                match (v.as::<str::Str>()) {
                    Option::Some(s) => { return s.equals(&str::Str::from(expected)); }
                    Option::None    => { return false; }
                }
            }
            Option::None => { return false; }
        }
    }

    static clone_string_field(obj: &value::JsonValue, key: string) -> Option<String> {
        match (obj.get(str::Str::from(key))) {
            Option::Some(v) => {
                match (v.as::<str::Str>()) {
                    Option::Some(s) => { return Option::Some(String::from_str(s)); }
                    Option::None    => { return Option::None; }
                }
            }
            Option::None => { return Option::None; }
        }
    }

    static clone_field(obj: &value::JsonValue, key: string) -> Option<value::JsonValue> {
        match (obj.get(str::Str::from(key))) {
            Option::Some(v) => { return Option::Some(JsonRpcCodec::clone_value(v)); }
            Option::None    => { return Option::None; }
        }
    }

    // Cloning JsonValue

    /// Deep-clone a `JsonValue`.  We need this when a handler stashes
    /// the request `id` for the eventual reply - the parsed tree owns
    /// the bytes, and we want to drop the tree without freeing the id
    /// out from under the response.
    static clone_value(v: &value::JsonValue) -> value::JsonValue {
        match (v) {
            value::JsonValue::Null      => { return value::JsonValue::Null; }
            value::JsonValue::Bool(b)   => { return value::JsonValue::Bool(b); }
            value::JsonValue::Number(n) => { return value::JsonValue::Number(n); }
            value::JsonValue::String(s) => {
                return value::JsonValue::String(String::from_str(s.as_str()));
            }
            value::JsonValue::Array(arr) => {
                mut out: Array<value::JsonValue> = Array::<value::JsonValue>::with_capacity(arr.length());
                mut i: u64 = 0;
                while (i < arr.length()) {
                    // JsonValue owns resources (not Copy): borrow the element in
                    // place with get_ref rather than copying it out with get.
                    match (arr.get_ref(i)) {
                        Option::Some(elem) => { out.push(JsonRpcCodec::clone_value(elem)); }
                        Option::None       => { }
                    }
                    i = i + 1;
                }
                return value::JsonValue::Array(out);
            }
            value::JsonValue::Object(obj) => {
                mut out: value::JsonObject = value::JsonObject::new();
                mut i: u64 = 0;
                while (i < obj.length()) {
                    match (obj.key_at(i)) {
                        Option::Some(k) => {
                            match (obj.value_at(i)) {
                                Option::Some(vp) => {
                                    out.insert(String::from_str(k), JsonRpcCodec::clone_value(vp));
                                }
                                Option::None => { }
                            }
                        }
                        Option::None => { }
                    }
                    i = i + 1;
                }
                return value::JsonValue::Object(out);
            }
        }
    }

    // Encoding

    /// Render a `ResponseMessage` to its JSON-RPC wire form.  The result
    /// is an owned `String` whose bytes the framing layer hands straight
    /// to `Stdout::write_all`.
    static encode_response(resp: &ResponseMessage) -> String {
        mut obj: value::JsonObject = value::JsonObject::new();
        obj.put("jsonrpc", value::JsonValue::from("2.0"));
        obj.put("id", JsonRpcCodec::clone_value(&resp.id));

        match (resp.error) {
            Option::Some(err) => {
                mut err_obj: value::JsonObject = value::JsonObject::new();
                err_obj.put("code", value::JsonValue::int_value(err.code as i64));
                err_obj.put("message", value::JsonValue::from(err.message.as_str()));
                obj.put("error", value::JsonValue::Object(err_obj));
            }
            Option::None => {
                obj.put("result", JsonRpcCodec::clone_value(&resp.result));
            }
        }

        const wire: value::JsonValue = value::JsonValue::Object(obj);
        mut owned_wire: value::JsonValue = wire;
        const out: String = serializer::stringify(&owned_wire);
        owned_wire.drop();
        return out;
    }

    /// Build a notification on the wire (no `id` field).
    static encode_notification(method: str::Str, params: value::JsonValue) -> String {
        mut obj: value::JsonObject = value::JsonObject::new();
        obj.put("jsonrpc", value::JsonValue::from("2.0"));
        obj.put("method", value::JsonValue::from(method));
        obj.put("params", params);

        mut owned: value::JsonValue = value::JsonValue::Object(obj);
        const out: String = serializer::stringify(&owned);
        owned.drop();
        return out;
    }

    /// Build a server->client request on the wire with the given id.  Used
    /// for spec messages like `workspace/semanticTokens/refresh` where the
    /// server pushes a refresh hint to the client.  The id is required by
    /// JSON-RPC for routing the (eventual) response back; the response is
    /// typically ignored on this server side.
    static encode_request(id: i64, method: str::Str, params: value::JsonValue) -> String {
        mut obj: value::JsonObject = value::JsonObject::new();
        obj.put("jsonrpc", value::JsonValue::from("2.0"));
        obj.put("id", value::JsonValue::int_value(id));
        obj.put("method", value::JsonValue::from(method));
        obj.put("params", params);

        mut owned: value::JsonValue = value::JsonValue::Object(obj);
        const out: String = serializer::stringify(&owned);
        owned.drop();
        return out;
    }
}
