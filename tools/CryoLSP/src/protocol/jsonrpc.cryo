///! JSON-RPC 2.0 envelope - request, notification, response.
///!
///! The wire layer above `Framing` (which deals in raw bytes) and
///! below the LSP semantic types.  Every inbound frame becomes an
///! `IncomingMessage`; every reply we send becomes a
///! `ResponseMessage` serialised back through `encode_response`.
///!
///! `IncomingMessage::Invalid(reason)` collapses every flavour of
///! "unparseable" - bad JSON, missing `jsonrpc`, missing `method`,
///! malformed `id` - so the dispatch layer has one decision branch
///! instead of N.  The `reason` String is owned and dropped when
///! the message is.

namespace lsp::protocol::jsonrpc;

import std::core::option;
import std::core::result;
import std::core::mem;
import std::collections::str;
import std::collections::string::{ String };
import std::collections::array::{ Array };
import std::encoding::value;
import std::encoding::json;
import std::encoding::json::error;


// JSON-RPC error codes (LSP section 3.4)

const PARSE_ERROR:           i32 = -32700;
const INVALID_REQUEST:       i32 = -32600;
const METHOD_NOT_FOUND:      i32 = -32601;
const INTERNAL_ERROR:        i32 = -32603;
const SERVER_NOT_INITIALIZED: i32 = -32002;
const REQUEST_FAILED:        i32 = -32803;
const REQUEST_CANCELLED:     i32 = -32800;


// Inbound - request / notification / invalid

/// A fully-decoded JSON-RPC request.  `id` is owned (cloned out of
/// the parsed JSON tree); `method` and `params` are likewise owned.
type struct RequestMessage {
    id:     value::Value;
    method: String;
    params: value::Value;
}

implement trait Drop for struct RequestMessage {
    drop(mut &this) -> void { }
}

type struct NotificationMessage {
    method: String;
    params: value::Value;
}

implement trait Drop for struct NotificationMessage {
    drop(mut &this) -> void { }
}

/// A frame that is not a valid request or notification.  It is answered
/// with an error carrying `code` and `id` - the request's own id when one
/// could be read, otherwise `null`, as JSON-RPC requires.
type struct InvalidMessage {
    code:   i32;
    id:     value::Value;
    reason: String;
}

implement trait Drop for struct InvalidMessage {
    drop(mut &this) -> void { }
}

type enum IncomingMessage {
    Request(RequestMessage);
    Notification(NotificationMessage);
    /// The client's answer to a request the server sent.  Nothing the
    /// server sends waits for one, so it is read and dropped.
    Response;
    /// Body could not be decoded into a valid JSON-RPC message.
    Invalid(InvalidMessage);
}

implement trait Drop for enum IncomingMessage {
    drop(mut &this) -> void { }
}


// Outbound - response

type struct ErrorObject {
    code:    i32;
    message: String;

    static new(code: i32, message: String) -> ErrorObject {
        return ErrorObject { code: code, message: message };
    }
}

implement trait Drop for struct ErrorObject {
    drop(mut &this) -> void { }
}

type struct ResponseMessage {
    id:     value::Value;
    result: value::Value;
    error:  Option<ErrorObject>;

    static success(id: value::Value, result: value::Value) -> ResponseMessage {
        return ResponseMessage {
            id:     id,
            result: result,
            error:  Option::None,
        };
    }

    static failure(id: value::Value, err: ErrorObject) -> ResponseMessage {
        return ResponseMessage {
            id:     id,
            result: value::Value::Null,
            error:  Option::Some(err),
        };
    }
}

implement trait Drop for struct ResponseMessage {
    drop(mut &this) -> void { }
}


// JsonRpcCodec - parse inbound frames, encode outbound messages.
// All statics: the codec is stateless (operates on the value passed in).

type struct JsonRpcCodec {

    // Parsing

    /// Decode the body of one frame into an `IncomingMessage`.  Any
    /// failure mode - bad JSON, missing fields, wrong shapes - collapses
    /// into `Invalid(reason)` so the caller has a single recovery path.
    static parse_incoming(body: str::Str) -> IncomingMessage {
        match (json::Json::parse(body)) {
            Result::Ok(v) => {
                mut owned: value::Value = v;
                return JsonRpcCodec::classify(&owned);
            }
            Result::Err(e) => {
                mut err: error::JsonError  = e;
                mut reason: String  = String::new();
                reason.append("json parse failed: ");
                reason.append(err.msg.as_str());
                mem::drop(err);
                return IncomingMessage::Invalid(InvalidMessage {
                    code: PARSE_ERROR, id: value::Value::Null, reason: reason,
                });
            }
        }
    }

    /// Classify an already-parsed Value by cloning the fields it needs
    /// out of it; the value itself is released by its owner.
    static classify(v: mut &value::Value) -> IncomingMessage {
        if (!v.is_object()) {
            return JsonRpcCodec::invalid_msg(v, "body is not a JSON object");
        }

        // jsonrpc must be the literal string "2.0".
        if (!JsonRpcCodec::field_equals(v, "jsonrpc", "2.0")) {
            return JsonRpcCodec::invalid_msg(v, "missing or wrong 'jsonrpc' field");
        }

        // method must be a string.  With none, a message carrying `result`
        // or `error` is a response to one of the server's own requests.
        const method: String = match (JsonRpcCodec::clone_string_field(v, "method")) {
            Option::Some(s) => { s }
            Option::None    => {
                if (JsonRpcCodec::has_field(v, "result") || JsonRpcCodec::has_field(v, "error")) {
                    return IncomingMessage::Response;
                }
                return JsonRpcCodec::invalid_msg(v, "missing 'method' field");
            }
        };

        // params: object/array/missing -> defaults to Null for handlers.
        const params: value::Value = match (JsonRpcCodec::clone_field(v, "params")) {
            Option::Some(p) => { p }
            Option::None    => { value::Value::Null }
        };

        // id present => request, absent => notification.
        match (JsonRpcCodec::clone_field(v, "id")) {
            Option::Some(id) => {
                return IncomingMessage::Request(RequestMessage {
                    id:     id,
                    method: method,
                    params: params,
                });
            }
            Option::None => {
                return IncomingMessage::Notification(NotificationMessage {
                    method: method,
                    params: params,
                });
            }
        }
    }

    /// An invalid request, answered under its own id when it has a usable
    /// one (a string or a number), otherwise under `null`.
    static invalid_msg(v: &value::Value, reason: string) -> IncomingMessage {
        mut s: String = String::new();
        s.append(reason);
        mut id: value::Value = value::Value::Null;
        if (v.is_object()) {
            match (v.get(str::Str::from("id"))) {
                Option::Some(idv) => {
                    match (idv) {
                        value::Value::String(_) => { id = JsonRpcCodec::clone_value(idv); }
                        value::Value::Number(_) => { id = JsonRpcCodec::clone_value(idv); }
                        _ => { }
                    }
                }
                Option::None => { }
            }
        }
        return IncomingMessage::Invalid(InvalidMessage { code: INVALID_REQUEST, id: id, reason: s });
    }

    static has_field(obj: &value::Value, key: string) -> boolean {
        match (obj.get(str::Str::from(key))) {
            Option::Some(_) => { return true; }
            Option::None    => { return false; }
        }
    }

    static field_equals(obj: &value::Value, key: string, expected: string) -> boolean {
        match (obj.get(str::Str::from(key))) {
            Option::Some(v) => {
                match (v.as::<str::Str>()) {
                    Option::Some(s) => { return s.equals(&str::Str::from(expected)); }
                    Option::None    => { return false; }
                }
            }
            Option::None => { return false; }
        }
    }

    static clone_string_field(obj: &value::Value, key: string) -> Option<String> {
        match (obj.get(str::Str::from(key))) {
            Option::Some(v) => {
                match (v.as::<str::Str>()) {
                    Option::Some(s) => { return Option::Some(String::from_str(s)); }
                    Option::None    => { return Option::None; }
                }
            }
            Option::None => { return Option::None; }
        }
    }

    static clone_field(obj: &value::Value, key: string) -> Option<value::Value> {
        match (obj.get(str::Str::from(key))) {
            Option::Some(v) => { return Option::Some(JsonRpcCodec::clone_value(v)); }
            Option::None    => { return Option::None; }
        }
    }

    // Cloning Value

    /// Deep-clone a `Value`.  We need this when a handler stashes
    /// the request `id` for the eventual reply - the parsed tree owns
    /// the bytes, and we want to drop the tree without freeing the id
    /// out from under the response.
    static clone_value(v: &value::Value) -> value::Value {
        match (v) {
            value::Value::Null      => { return value::Value::Null; }
            value::Value::Bool(b)   => { return value::Value::Bool(b); }
            value::Value::Number(n) => { return value::Value::Number(n); }
            value::Value::String(s) => {
                return value::Value::String(String::from_str(s.as_str()));
            }
            value::Value::Array(arr) => {
                mut out: Array<value::Value> = Array::<value::Value>::with_capacity(arr.length());
                mut i: i64 = 0;
                while (i < arr.length()) {
                    // Value owns resources (not Copy): borrow the element in
                    // place with get_reference rather than copying it out with get.
                    match (arr.get_reference(i)) {
                        Option::Some(elem) => { out.push(JsonRpcCodec::clone_value(elem)); }
                        Option::None       => { }
                    }
                    i = i + 1;
                }
                return value::Value::Array(out);
            }
            value::Value::Object(obj) => {
                mut out: value::Object = value::Object::new();
                mut i: i64 = 0;
                while (i < obj.length()) {
                    match (obj.key_at(i)) {
                        Option::Some(k) => {
                            match (obj.value_at(i)) {
                                Option::Some(vp) => {
                                    out.insert(String::from_str(k), JsonRpcCodec::clone_value(vp));
                                }
                                Option::None => { }
                            }
                        }
                        Option::None => { }
                    }
                    i = i + 1;
                }
                return value::Value::Object(out);
            }
        }
    }

    // Encoding

    /// Render a `ResponseMessage` to its JSON-RPC wire form.  The result
    /// is an owned `String` whose bytes the framing layer hands straight
    /// to `Stdout::write_all`.
    static encode_response(resp: &ResponseMessage) -> String {
        mut obj: value::Object = value::Object::new();
        obj.put("jsonrpc", value::Value::from("2.0"));
        obj.put("id", JsonRpcCodec::clone_value(&resp.id));

        // Borrowed: matching the field by value would release the error's
        // message here and again when the caller drops the response.
        match (&resp.error) {
            Option::Some(err) => {
                mut err_obj: value::Object = value::Object::new();
                err_obj.put("code", value::Value::integer_value(err.code as i64));
                err_obj.put("message", value::Value::from(err.message.as_str()));
                obj.put("error", value::Value::Object(err_obj));
            }
            Option::None => {
                obj.put("result", JsonRpcCodec::clone_value(&resp.result));
            }
        }

        const wire: value::Value = value::Value::Object(obj);
        mut owned_wire: value::Value = wire;
        const out: String = json::Json::to_text(&owned_wire);
        mem::drop(owned_wire);
        return out;
    }

    /// Build a notification on the wire (no `id` field).
    static encode_notification(method: str::Str, params: value::Value) -> String {
        mut obj: value::Object = value::Object::new();
        obj.put("jsonrpc", value::Value::from("2.0"));
        obj.put("method", value::Value::from(method));
        obj.put("params", params);

        mut owned: value::Value = value::Value::Object(obj);
        const out: String = json::Json::to_text(&owned);
        mem::drop(owned);
        return out;
    }

    /// Build a server->client request on the wire with the given id.  Used
    /// for spec messages like `workspace/semanticTokens/refresh` where the
    /// server pushes a refresh hint to the client.  The id is required by
    /// JSON-RPC for routing the (eventual) response back; the response is
    /// typically ignored on this server side.
    static encode_request(id: i64, method: str::Str, params: value::Value) -> String {
        mut obj: value::Object = value::Object::new();
        obj.put("jsonrpc", value::Value::from("2.0"));
        obj.put("id", value::Value::integer_value(id));
        obj.put("method", value::Value::from(method));
        obj.put("params", params);

        mut owned: value::Value = value::Value::Object(obj);
        const out: String = json::Json::to_text(&owned);
        mem::drop(owned);
        return out;
    }
}
