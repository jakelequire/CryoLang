///! JSON-RPC 2.0 envelope - request, notification, response.
///!
///! The wire layer above `Framing` (which deals in raw bytes) and
///! below the LSP semantic types.  Every inbound frame becomes an
///! `IncomingMessage`; every reply we send becomes a
///! `ResponseMessage` serialised back through `encode_response`.
///!
///! `IncomingMessage::Invalid(reason)` collapses every flavour of
///! "unparseable" - bad JSON, missing `jsonrpc`, missing `method`,
///! malformed `id` - so the dispatch layer has one decision branch
///! instead of N.  The `reason` String is owned and dropped when
///! the message is.

namespace Lsp::Protocol::JsonRpc;

import std::core::option;
import std::core::result;
import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::json::value;
import std::json::parser;
import std::json::serializer;
import std::json::error;


// JSON-RPC error codes (LSP section 3.4)

const PARSE_ERROR:           i32 = -32700;
const INVALID_REQUEST:       i32 = -32600;
const METHOD_NOT_FOUND:      i32 = -32601;
const INVALID_PARAMS:        i32 = -32602;
const INTERNAL_ERROR:        i32 = -32603;
const SERVER_NOT_INITIALIZED: i32 = -32002;
const REQUEST_FAILED:        i32 = -32803;


// Inbound - request / notification / invalid

/// A fully-decoded JSON-RPC request.  `id` is owned (cloned out of
/// the parsed JSON tree); `method` and `params` are likewise owned.
type struct RequestMessage {
    id:     JsonValue;
    method: String;
    params: JsonValue;

    drop(mut &this) -> void {
        this.id.drop();
        this.method.drop();
        this.params.drop();
    }
}

type struct NotificationMessage {
    method: String;
    params: JsonValue;

    drop(mut &this) -> void {
        this.method.drop();
        this.params.drop();
    }
}

type enum IncomingMessage {
    Request(RequestMessage);
    Notification(NotificationMessage);
    /// Body could not be decoded into a valid JSON-RPC message.
    /// `reason` is a human-readable explanation we can log.
    Invalid(String);
}

implement enum IncomingMessage {
    drop(mut &this) -> void {
        match (this) {
            IncomingMessage::Request(r)      => { r.drop(); }
            IncomingMessage::Notification(n) => { n.drop(); }
            IncomingMessage::Invalid(s)      => { s.drop(); }
        }
    }
}


// Outbound - response

type struct ErrorObject {
    code:    i32;
    message: String;

    static new(code: i32, message: String) -> ErrorObject {
        return ErrorObject { code: code, message: message };
    }

    drop(mut &this) -> void {
        this.message.drop();
    }
}

type struct ResponseMessage {
    id:     JsonValue;
    result: JsonValue;
    error:  Option<ErrorObject>;

    static success(id: JsonValue, result: JsonValue) -> ResponseMessage {
        return ResponseMessage {
            id:     id,
            result: result,
            error:  Option::None,
        };
    }

    static failure(id: JsonValue, err: ErrorObject) -> ResponseMessage {
        return ResponseMessage {
            id:     id,
            result: JsonValue::Null,
            error:  Option::Some(err),
        };
    }

    drop(mut &this) -> void {
        this.id.drop();
        this.result.drop();
        match (this.error) {
            Option::Some(e) => { e.drop(); }
            Option::None    => { }
        }
    }
}


// Parsing

/// Decode the body of one frame into an `IncomingMessage`.  Any
/// failure mode - bad JSON, missing fields, wrong shapes - collapses
/// into `Invalid(reason)` so the caller has a single recovery path.
function parse_incoming(body: Str) -> IncomingMessage {
    match (parser::parse(body)) {
        Result::Ok(v) => {
            mut owned: JsonValue = v;
            return classify(&owned);
        }
        Result::Err(e) => {
            mut err: JsonError  = e;
            mut reason: String  = String::new();
            reason.push_cstr("json parse failed: ");
            reason.push_str(err.msg.as_str());
            err.drop();
            return IncomingMessage::Invalid(reason);
        }
    }
}

/// Classify an already-parsed JsonValue.  Mutates the input by
/// extracting (cloning out) owned fields; the leftover container is
/// dropped before we return.
function classify(v: mut &JsonValue) -> IncomingMessage {
    if (!v.is_object()) {
        v.drop();
        return invalid_msg("body is not a JSON object");
    }

    // jsonrpc must be the literal string "2.0".
    if (!field_equals(v, "jsonrpc", "2.0")) {
        v.drop();
        return invalid_msg("missing or wrong 'jsonrpc' field");
    }

    // method must be a string.
    const method: String = match (clone_string_field(v, "method")) {
        Option::Some(s) => { s }
        Option::None    => {
            v.drop();
            return invalid_msg("missing 'method' field");
        }
    };

    // params: object/array/missing -> defaults to Null for handlers.
    const params: JsonValue = match (clone_field(v, "params")) {
        Option::Some(p) => { p }
        Option::None    => { JsonValue::Null }
    };

    // id present => request, absent => notification.
    match (clone_field(v, "id")) {
        Option::Some(id) => {
            v.drop();
            return IncomingMessage::Request(RequestMessage {
                id:     id,
                method: method,
                params: params,
            });
        }
        Option::None => {
            v.drop();
            return IncomingMessage::Notification(NotificationMessage {
                method: method,
                params: params,
            });
        }
    }
}

function invalid_msg(reason: string) -> IncomingMessage {
    mut s: String = String::new();
    s.push_cstr(reason);
    return IncomingMessage::Invalid(s);
}

function field_equals(obj: &JsonValue, key: string, expected: string) -> boolean {
    match (obj.get(Str::from_cstr(key))) {
        Option::Some(v) => {
            match (v.as_str()) {
                Option::Some(s) => { return s.equals(&Str::from_cstr(expected)); }
                Option::None    => { return false; }
            }
        }
        Option::None => { return false; }
    }
}

function clone_string_field(obj: &JsonValue, key: string) -> Option<String> {
    match (obj.get(Str::from_cstr(key))) {
        Option::Some(v) => {
            match (v.as_str()) {
                Option::Some(s) => { return Option::Some(String::from_str(s)); }
                Option::None    => { return Option::None; }
            }
        }
        Option::None => { return Option::None; }
    }
}

function clone_field(obj: &JsonValue, key: string) -> Option<JsonValue> {
    match (obj.get(Str::from_cstr(key))) {
        Option::Some(v) => { return Option::Some(clone_value(v)); }
        Option::None    => { return Option::None; }
    }
}


// Cloning JsonValue

/// Deep-clone a `JsonValue`.  We need this when a handler stashes
/// the request `id` for the eventual reply - the parsed tree owns
/// the bytes, and we want to drop the tree without freeing the id
/// out from under the response.
function clone_value(v: &JsonValue) -> JsonValue {
    match (v) {
        JsonValue::Null      => { return JsonValue::Null; }
        JsonValue::Bool(b)   => { return JsonValue::Bool(b); }
        JsonValue::Number(n) => { return JsonValue::Number(n); }
        JsonValue::String(s) => {
            return JsonValue::String(String::from_str(s.as_str()));
        }
        JsonValue::Array(arr) => {
            mut out: Array<JsonValue> = Array<JsonValue>::with_capacity(arr.length());
            mut i: u64 = 0;
            while (i < arr.length()) {
                // JsonValue owns resources (not Copy): borrow the element in
                // place with get_ptr rather than copying it out with get.
                match (arr.get_ptr(i)) {
                    Option::Some(elem) => { out.push(clone_value(elem)); }
                    Option::None       => { }
                }
                i = i + 1;
            }
            return JsonValue::Array(out);
        }
        JsonValue::Object(obj) => {
            mut out: JsonObject = JsonObject::new();
            mut i: u64 = 0;
            while (i < obj.length()) {
                match (obj.key_at(i)) {
                    Option::Some(k) => {
                        match (obj.value_at(i)) {
                            Option::Some(vp) => {
                                out.insert(String::from_str(k), clone_value(vp));
                            }
                            Option::None => { }
                        }
                    }
                    Option::None => { }
                }
                i = i + 1;
            }
            return JsonValue::Object(out);
        }
    }
}


// Encoding

/// Render a `ResponseMessage` to its JSON-RPC wire form.  The result
/// is an owned `String` whose bytes the framing layer hands straight
/// to `Stdout::write_all`.
function encode_response(resp: &ResponseMessage) -> String {
    mut obj: JsonObject = JsonObject::new();
    obj.insert(
        String::from_str(Str::from_cstr("jsonrpc")),
        JsonValue::String(String::from_str(Str::from_cstr("2.0"))));
    obj.insert(
        String::from_str(Str::from_cstr("id")),
        clone_value(&resp.id));

    match (resp.error) {
        Option::Some(err) => {
            mut err_obj: JsonObject = JsonObject::new();
            mut code_num: JsonNumber = JsonNumber::Int(err.code as i64);
            err_obj.insert(
                String::from_str(Str::from_cstr("code")),
                JsonValue::Number(code_num));
            err_obj.insert(
                String::from_str(Str::from_cstr("message")),
                JsonValue::String(String::from_str(err.message.as_str())));
            obj.insert(
                String::from_str(Str::from_cstr("error")),
                JsonValue::Object(err_obj));
        }
        Option::None => {
            obj.insert(
                String::from_str(Str::from_cstr("result")),
                clone_value(&resp.result));
        }
    }

    const wire: JsonValue = JsonValue::Object(obj);
    mut owned_wire: JsonValue = wire;
    const out: String = serializer::stringify(&owned_wire);
    owned_wire.drop();
    return out;
}

/// Build a notification on the wire (no `id` field).
public function encode_notification(method: Str, params: JsonValue) -> String {
    mut obj: JsonObject = JsonObject::new();
    obj.insert(
        String::from_str(Str::from_cstr("jsonrpc")),
        JsonValue::String(String::from_str(Str::from_cstr("2.0"))));
    obj.insert(
        String::from_str(Str::from_cstr("method")),
        JsonValue::String(String::from_str(method)));
    obj.insert(
        String::from_str(Str::from_cstr("params")),
        params);

    mut owned: JsonValue = JsonValue::Object(obj);
    const out: String = serializer::stringify(&owned);
    owned.drop();
    return out;
}

/// Build a server->client request on the wire with the given id.  Used
/// for spec messages like `workspace/semanticTokens/refresh` where the
/// server pushes a refresh hint to the client.  The id is required by
/// JSON-RPC for routing the (eventual) response back; the response is
/// typically ignored on this server side.
public function encode_request(id: i64, method: Str, params: JsonValue) -> String {
    mut obj: JsonObject = JsonObject::new();
    obj.insert(
        String::from_str(Str::from_cstr("jsonrpc")),
        JsonValue::String(String::from_str(Str::from_cstr("2.0"))));
    obj.insert(
        String::from_str(Str::from_cstr("id")),
        JsonValue::Number(JsonNumber::Int(id)));
    obj.insert(
        String::from_str(Str::from_cstr("method")),
        JsonValue::String(String::from_str(method)));
    obj.insert(
        String::from_str(Str::from_cstr("params")),
        params);

    mut owned: JsonValue = JsonValue::Object(obj);
    const out: String = serializer::stringify(&owned);
    owned.drop();
    return out;
}
