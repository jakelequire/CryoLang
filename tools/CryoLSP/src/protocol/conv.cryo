///! Conversions between compiler-internal types and LSP wire JSON.
///!
///! `Compiler::Diag::Diagnostic` → JSON for `publishDiagnostics`.
///! Built directly as `JsonValue` rather than via the LSP-side
///! `Diagnostic` struct because both types are named `Diagnostic` and
///! the import-resolution path through both top-level namespaces in
///! the same file picks whichever was imported last — depending on
///! the resolution order this either compiles or doesn't.  Going
///! direct keeps the file insensitive to import order.

namespace Lsp::Protocol::Conv;

import std::core::option;
import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::json::value;

import Compiler::Diag;
import Compiler::Diag::Severity;
import Compiler::Diag::SourceSpan;
import Compiler::Diag::SpanLabel;
import Compiler::Diag::Diagnostic;
import Compiler::Diag::Renderer;


/// Build a `Range` JSON object from a 1-based compiler `SourceSpan`.
///
///   { "start": { "line": L0, "character": C0 },
///     "end":   { "line": L1, "character": C1 } }
///
/// Spans without a location (start_line == 0) collapse to (0,0)→(0,0)
/// — VS Code renders that harmlessly at the top of the document.
public function range_json_from_span(span: SourceSpan) -> JsonValue {
    mut sl: u32 = 0;
    mut sc: u32 = 0;
    mut el: u32 = 0;
    mut ec: u32 = 0;
    if (span.start_line > 0) { sl = span.start_line - 1; }
    if (span.start_col  > 0) { sc = span.start_col  - 1; }
    if (span.end_line   > 0) { el = span.end_line   - 1; }
    if (span.end_col    > 0) { ec = span.end_col    - 1; }
    return range_json(sl, sc, el, ec);
}

public function range_json(sl: u32, sc: u32, el: u32, ec: u32) -> JsonValue {
    mut o: JsonObject = JsonObject::new();
    o.insert(String::from_str(Str::from_cstr("start")), pos_json(sl, sc));
    o.insert(String::from_str(Str::from_cstr("end")),   pos_json(el, ec));
    return JsonValue::Object(o);
}

function pos_json(line: u32, character: u32) -> JsonValue {
    mut o: JsonObject = JsonObject::new();
    o.insert(String::from_str(Str::from_cstr("line")),
             JsonValue::Number(JsonNumber::Int(line as i64)));
    o.insert(String::from_str(Str::from_cstr("character")),
             JsonValue::Number(JsonNumber::Int(character as i64)));
    return JsonValue::Object(o);
}


/// Map a compiler `Severity` onto LSP's integer codes (1..4).
/// `Note` and `Help` both surface as `Information` (3) — VS Code
/// renders Hint (4) very quietly, which is the wrong affordance for
/// the compiler's "please look at this" diagnostics.
public function severity_int_from(sev: Severity) -> i64 {
    return match (sev) {
        Severity::Error   => { 1 as i64 }
        Severity::Warning => { 2 as i64 }
        Severity::Note    => { 3 as i64 }
        Severity::Help    => { 3 as i64 }
    };
}


/// Build the `params` object for a `textDocument/publishDiagnostics`
/// notification:
///
///   { "uri": "<uri>", "diagnostics": [ ... ] }
///
/// Filters `diags` to only those whose `span.file` matches the URI's
/// filesystem path — multi-module project compiles populate the sink
/// with diagnostics from EVERY module they touched, but each
/// `publishDiagnostics` notification is per-URI on the wire.  Without
/// the filter, an editor showing `main.cryo` would render diagnostics
/// from sibling files at made-up positions in the active buffer.
public function build_publish_params(uri: Str, diags: Diagnostic[]) -> JsonValue {
    const fs_path: Str = uri_to_fs_path(uri);
    // One renderer for the whole batch.  It caches source files across
    // diagnostics, so reusing it holds each publish to a single read per
    // file.  `plain()` config: no ANSI, no leading rule — the rendered
    // text lands in an LSP `message`, not a terminal.
    mut renderer: DiagRenderer = DiagRenderer::new(RenderConfig::plain());
    mut arr: Array<JsonValue> = Array<JsonValue>::with_capacity(diags.length as u64);
    for (mut i: i64 = 0; i < diags.length; i++) {
        if (diag_is_for_path(&diags[i], fs_path)) {
            arr.push(diag_to_json(&diags[i], &renderer));
        }
    }

    mut params: JsonObject = JsonObject::new();
    params.insert(
        String::from_str(Str::from_cstr("uri")),
        JsonValue::String(String::from_str(uri)));
    params.insert(
        String::from_str(Str::from_cstr("diagnostics")),
        JsonValue::Array(arr));
    return JsonValue::Object(params);
}


// ============================================================================
// URI / span filtering
// ============================================================================

const FILE_SCHEME:     string = "file://";
const FILE_SCHEME_LEN: u64    = 7;

/// Strip the `file://` scheme from a URI to get the absolute
/// filesystem path the compiler stores in `SourceSpan::file`.
function uri_to_fs_path(uri: Str) -> Str {
    if (uri.length() >= FILE_SCHEME_LEN) {
        const prefix: Str = uri.sub_bytes(0, FILE_SCHEME_LEN);
        if (prefix.equals(&Str::from_cstr(FILE_SCHEME))) {
            return uri.sub_bytes(FILE_SCHEME_LEN, uri.length());
        }
    }
    return uri;
}

/// True when this diagnostic's source span belongs to `fs_path`.
/// Spanless diagnostics (`span.file == ""`) are dropped — they have
/// no editor position to render against, so attributing them to the
/// publishing URI would surface them at line 0 (or worse, at
/// whatever stale line/col the span happened to carry over) and
/// confuse the user.  A future pass can route them into the LSP
/// output channel instead.
function diag_is_for_path(diag: &Diagnostic, fs_path: Str) -> boolean {
    const span_file: string = diag.span.file;
    if (span_file == "") { return false; }
    if (strlen(span_file) == 0 as u64) { return false; }
    return fs_path.equals(&Str::from_cstr(span_file));
}


// ============================================================================
// Rich diagnostic fields
//
// The wire `Diagnostic` carries far more than range + message.  We populate:
//   - `message`            the full rendered report (header, source snippet
//                          with carets, secondary labels, notes, suggestions)
//   - `relatedInformation` every secondary span and located child, as a
//                          clickable navigation target
//   - `codeDescription`    a docs link the editor opens from the code
//   - `tags`               fade unused/dead code, strike deprecated
// so the editor surfaces the same diagnostic the terminal compiler prints.
// ============================================================================

/// The documentation URL an editor opens when the user clicks a
/// diagnostic's code.  There is no per-code reference page yet, so this
/// points at the language reference; swap in a per-code anchor when one
/// exists.
const ERROR_DOC_URL: string =
    "https://github.com/jakelequire/CryoLang/blob/main/docs/cryo.md";

/// Reconstruct a `file://` URI from the absolute filesystem path the
/// compiler stamps onto every span — the inverse of `uri_to_fs_path`.
function uri_string_from_fs_path(file: string) -> String {
    mut s: String = String::with_capacity(strlen(file) + FILE_SCHEME_LEN);
    s.push_cstr(FILE_SCHEME);
    s.push_cstr(file);
    return s;
}

/// Build one `DiagnosticRelatedInformation` entry: a `{ location, message }`
/// pair the editor renders as a clickable jump target beneath the
/// diagnostic.
function related_info_json(file: string, span: SourceSpan,
                           message: string) -> JsonValue {
    mut loc: JsonObject = JsonObject::new();
    loc.insert(String::from_str(Str::from_cstr("uri")),
               JsonValue::String(uri_string_from_fs_path(file)));
    loc.insert(String::from_str(Str::from_cstr("range")),
               range_json_from_span(span));

    mut o: JsonObject = JsonObject::new();
    o.insert(String::from_str(Str::from_cstr("location")),
             JsonValue::Object(loc));
    mut msg: String = String::new();
    msg.push_cstr(message);
    o.insert(String::from_str(Str::from_cstr("message")),
             JsonValue::String(msg));
    return JsonValue::Object(o);
}

/// Collect a diagnostic's secondary span labels and located child
/// diagnostics into an LSP `relatedInformation` array.  Primary labels
/// are skipped — the diagnostic's own `range` already covers the primary
/// site — and so are spanless children: they have no editor position,
/// but the rendered `message` still carries their text.
function related_information_array(diag: &Diagnostic) -> Array<JsonValue> {
    mut arr: Array<JsonValue> = Array<JsonValue>::new();

    for (mut i: i64 = 0; i < diag.labels.length; i++) {
        const label: SpanLabel = diag.labels[i];
        if (label.is_primary)            { continue; }
        if (!label.span.has_location())  { continue; }
        arr.push(related_info_json(label.span.file, label.span, label.message));
    }

    for (mut i: i64 = 0; i < diag.children.length; i++) {
        const child: Diagnostic = diag.children[i];
        if (!child.span.has_location()) { continue; }
        const text: string =
            format("%s: %s", child.severity.label(), child.message);
        arr.push(related_info_json(child.span.file, child.span, text));
    }

    return arr;
}

/// LSP `DiagnosticTag` values for a code.  `Unnecessary` (1) fades the
/// span — the right affordance for unused/dead code; `Deprecated` (2)
/// strikes it through.  Codes with no tag yield an empty array.
function diagnostic_tags_array(code: ErrorCode) -> Array<JsonValue> {
    mut arr: Array<JsonValue> = Array<JsonValue>::new();
    match (code) {
        ErrorCode::W0001_UNUSED_VARIABLE => { arr.push(JsonValue::Number(JsonNumber::Int(1))); }
        ErrorCode::W0002_UNUSED_FUNCTION => { arr.push(JsonValue::Number(JsonNumber::Int(1))); }
        ErrorCode::W0003_UNUSED_IMPORT   => { arr.push(JsonValue::Number(JsonNumber::Int(1))); }
        ErrorCode::W0009_DEAD_CODE       => { arr.push(JsonValue::Number(JsonNumber::Int(1))); }
        ErrorCode::W0007_DEPRECATED      => { arr.push(JsonValue::Number(JsonNumber::Int(2))); }
        _                                => { }
    }
    return arr;
}

/// `{ "href": <docs url> }` — makes the diagnostic's code a clickable
/// link in the editor's problems panel and hover.
function code_description_json() -> JsonValue {
    mut o: JsonObject = JsonObject::new();
    o.insert(String::from_str(Str::from_cstr("href")),
             JsonValue::String(String::from_str(Str::from_cstr(ERROR_DOC_URL))));
    return JsonValue::Object(o);
}


/// Render one compiler diagnostic as a fully-populated LSP `Diagnostic`
/// JSON object.  `renderer` produces the `message` body and is shared
/// across the publish batch so its source-file cache is reused.
public function diag_to_json(diag: &Diagnostic,
                             renderer: DiagRenderer*) -> JsonValue {
    mut o: JsonObject = JsonObject::new();
    o.insert(String::from_str(Str::from_cstr("range")),
             range_json_from_span(diag.span));
    o.insert(String::from_str(Str::from_cstr("severity")),
             JsonValue::Number(JsonNumber::Int(severity_int_from(diag.severity))));

    // Code: rendered as the canonical "E0102" / "W0001" string.
    mut code_str: String = String::new();
    code_str.push_cstr(diag.code.format());
    o.insert(String::from_str(Str::from_cstr("code")),
             JsonValue::String(code_str));

    // codeDescription: turns the code into a clickable docs link.
    o.insert(String::from_str(Str::from_cstr("codeDescription")),
             code_description_json());

    o.insert(String::from_str(Str::from_cstr("source")),
             JsonValue::String(String::from_str(Str::from_cstr("cryoc"))));

    // message: the full rendered report — header, source snippet with
    // carets, secondary labels, notes, and suggestions — so the editor
    // shows the same diagnostic the terminal compiler would print.
    o.insert(String::from_str(Str::from_cstr("message")),
             JsonValue::String(renderer.render_to_string(*diag)));

    // tags: fade unused/dead code, strike deprecated.  An empty array is
    // a valid no-op; emitting it unconditionally keeps the move/ownership
    // story simple.
    o.insert(String::from_str(Str::from_cstr("tags")),
             JsonValue::Array(diagnostic_tags_array(diag.code)));

    // relatedInformation: clickable navigation to every secondary span
    // and located child diagnostic.
    o.insert(String::from_str(Str::from_cstr("relatedInformation")),
             JsonValue::Array(related_information_array(diag)));

    return JsonValue::Object(o);
}
