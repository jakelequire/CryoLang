///! Conversions between compiler-internal types and LSP wire JSON.
///!
///! Two static-method types group the conversions:
///!   - `UriPath`             `file://` URI <-> filesystem path.
///!   - `DiagnosticConverter` `compiler::diag::diagnostic` -> LSP JSON
///!                           for `publishDiagnostics`.
///!
///! Diagnostics are built directly as `JsonValue` rather than via the
///! LSP-side `Diagnostic` struct because both types are named
///! `Diagnostic` and the import-resolution path through both top-level
///! namespaces in the same file picks whichever was imported last -
///! depending on the resolution order this either compiles or doesn't.
///! Going direct keeps the file insensitive to import order.

namespace Lsp::Protocol::Conv;

import std::core::option;
import std::core::intrinsics;
import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::collections::hashmap;
import std::json::value;

import compiler::diag;
import compiler::diag::severity;
import compiler::diag::source_span;
import compiler::diag::span_label;
import compiler::diag::diagnostic;
import compiler::diag::suggestion;
import compiler::diag::renderer;

import Lsp::Server::DiagRenderCache;


const FILE_SCHEME:     string = "file://";
const FILE_SCHEME_LEN: u64    = 7;

/// The documentation URL an editor opens when the user clicks a
/// diagnostic's code.  There is no per-code reference page yet, so this
/// points at the language reference; swap in a per-code anchor when one
/// exists.
const ERROR_DOC_URL: string =
    "https://github.com/jakelequire/CryoLang/blob/main/docs/cryo.md";


// UriPath - file:// URI <-> filesystem path (both directions), with the
// platform-specific drive-letter handling gated per target.

type struct UriPath {

    /// Convert a `file://` URI to the absolute filesystem path the compiler
    /// stores in `SourceSpan::file`.  Three steps:
    ///   1. Strip the `file://` scheme.
    ///   2. Percent-decode (`%3A` -> `:`, `%20` -> ` `, ...).  Editors send
    ///      URIs percent-encoded; on Windows the drive colon arrives as
    ///      `%3A` (`file:///c%3A/...`), so skipping this leaves an un-openable
    ///      path and every stdlib / cryoconfig / module lookup fails.
    ///   3. Platform-normalize (Windows: drop the leading `/` before a drive
    ///      letter so `/C:/x` becomes `C:/x`; POSIX: unchanged).
    /// Returns an OWNED String - callers append their own NUL when they need
    /// a C string.
    static uri_to_fs_path(uri: Str) -> String {
        mut start: u64 = 0;
        if (uri.length() >= FILE_SCHEME_LEN) {
            const prefix: Str = uri.sub_bytes(0, FILE_SCHEME_LEN);
            if (prefix.equals(&Str::from(FILE_SCHEME))) {
                start = FILE_SCHEME_LEN;
            }
        }

        const ptr: u8* = uri.as_ptr();
        const len: u64 = uri.length();
        mut out: String = String::with_capacity(len - start);
        mut i: u64 = start;
        while (i < len) {
            const b: u8 = ptr[i];
            if (b == 37 && i + 2 < len) {                        // '%'
                const hi: i32 = UriPath::hex_nibble(ptr[i + 1]);
                const lo: i32 = UriPath::hex_nibble(ptr[i + 2]);
                if (hi >= 0 && lo >= 0) {
                    out.push_byte(((hi * 16) + lo) as u8);
                    i = i + 3;
                    continue;
                }
            }
            out.push_byte(b);
            i = i + 1;
        }
        return UriPath::normalize_fs_path(out);
    }

    /// Value of a single hex digit, or -1 if the byte isn't `[0-9A-Fa-f]`.
    static hex_nibble(b: u8) -> i32 {
        if (b >= 48 && b <= 57)  { return (b - 48) as i32; }        // '0'-'9'
        if (b >= 65 && b <= 70)  { return (b - 65 + 10) as i32; }   // 'A'-'F'
        if (b >= 97 && b <= 102) { return (b - 97 + 10) as i32; }   // 'a'-'f'
        return -1 as i32;
    }

    /// Windows file URIs carry the path as `/C:/dir/file`; the leading slash
    /// before the drive letter is not a valid Windows path, so strip it.
    ![target(windows)]
    static normalize_fs_path(path: String) -> String {
        const len: u64 = path.length();
        if (len >= 3) {
            const p: u8* = path.as_ptr();
            const is_alpha: boolean =
                (p[1] >= 65 && p[1] <= 90) || (p[1] >= 97 && p[1] <= 122);
            if (p[0] == 47 && is_alpha && p[2] == 58) {            // '/', letter, ':'
                mut out: String = String::from_str(path.as_str().sub_bytes(1, len));
                mut owned: String = path;
                owned.drop();
                return out;
            }
        }
        return path;
    }

    /// POSIX paths keep their leading slash (`/home/...`); nothing to do.
    ![target(unix)]
    static normalize_fs_path(path: String) -> String {
        return path;
    }

    /// Reconstruct a `file://` URI from the absolute filesystem path the
    /// compiler stamps onto every span - the inverse of `uri_to_fs_path`.
    /// On Windows a drive path (`C:/...`) must become `file:///C:/...`:
    /// without the extra leading slash the `C:` is parsed as a URI host
    /// authority and the editor can't open the target.  POSIX paths
    /// already start with `/`, so `file://` + `/home/...` is correct.
    static uri_string_from_fs_path(file: string) -> String {
        mut s: String = String::with_capacity(strlen(file) + FILE_SCHEME_LEN + 1);
        s.push(FILE_SCHEME);
        s.push(UriPath::uri_authority_slash(file));
        s.push(file);
        return s;
    }

    /// `"/"` when `file` needs a leading slash inserted after `file://` so a
    /// Windows drive letter isn't mistaken for a host; `""` otherwise.
    ![target(windows)]
    static uri_authority_slash(file: string) -> string {
        const fp: u8* = file as u8*;
        if (strlen(file) > 0 as u64 && fp[0] != 47) { return "/"; }   // not '/'
        return "";
    }

    ![target(unix)]
    static uri_authority_slash(file: string) -> string {
        return "";                                        // already '/'-rooted
    }
}


// DiagnosticConverter - compiler::diag::diagnostic -> LSP wire JSON.

type struct DiagnosticConverter {

    /// Build a `Range` JSON object from a 1-based compiler `SourceSpan`.
    ///
    ///   { "start": { "line": L0, "character": C0 },
    ///     "end":   { "line": L1, "character": C1 } }
    ///
    /// Spans without a location (start_line == 0) collapse to (0,0)->(0,0)
    /// - VS Code renders that harmlessly at the top of the document.
    static range_json_from_span(span: SourceSpan) -> JsonValue {
        mut sl: u32 = 0;
        mut sc: u32 = 0;
        mut el: u32 = 0;
        mut ec: u32 = 0;
        if (span.start_line > 0) { sl = span.start_line - 1; }
        if (span.start_col  > 0) { sc = span.start_col  - 1; }
        if (span.end_line   > 0) { el = span.end_line   - 1; }
        if (span.end_col    > 0) { ec = span.end_col    - 1; }
        return DiagnosticConverter::range_json(sl, sc, el, ec);
    }

    static range_json(sl: u32, sc: u32, el: u32, ec: u32) -> JsonValue {
        mut o: JsonObject = JsonObject::new();
        o.put("start", DiagnosticConverter::pos_json(sl, sc));
        o.put("end",   DiagnosticConverter::pos_json(el, ec));
        return JsonValue::Object(o);
    }

    static pos_json(line: u32, character: u32) -> JsonValue {
        mut o: JsonObject = JsonObject::new();
        o.put("line",      JsonValue::int_value(line as i64));
        o.put("character", JsonValue::int_value(character as i64));
        return JsonValue::Object(o);
    }

    /// Map a compiler `Severity` onto LSP's integer codes (1..4).
    /// `Note` and `Help` both surface as `Information` (3) - VS Code
    /// renders Hint (4) very quietly, which is the wrong affordance for
    /// the compiler's "please look at this" diagnostics.
    static severity_int_from(sev: Severity) -> i64 {
        return match (sev) {
            Severity::Error   => { 1 as i64 }
            Severity::Warning => { 2 as i64 }
            Severity::Note    => { 3 as i64 }
            Severity::Help    => { 3 as i64 }
        };
    }

    /// Build the `params` object for a `textDocument/publishDiagnostics`
    /// notification:
    ///
    ///   { "uri": "<uri>", "diagnostics": [ ... ] }
    ///
    /// Filters `diags` to only those whose `span.file` matches the URI's
    /// filesystem path - multi-module project compiles populate the sink
    /// with diagnostics from EVERY module they touched, but each
    /// `publishDiagnostics` notification is per-URI on the wire.  Without
    /// the filter, an editor showing `main.cryo` would render diagnostics
    /// from sibling files at made-up positions in the active buffer.
    static build_publish_params(uri: Str, diags: &Diagnostic[],
                                cache: DiagRenderCache*) -> JsonValue {
        // Open a publish cycle for this URI: drops the cache entries this
        // URI left last time and arms `cache.insert` to track the ids about
        // to be repopulated below (see DiagRenderCache).
        cache.begin_publish(uri);

        mut fs_path_owned: String = UriPath::uri_to_fs_path(uri);
        const fs_path: Str = fs_path_owned.as_str();
        // One renderer for the whole batch.  It caches source files across
        // diagnostics, so reusing it holds each publish to a single read per
        // file.  `plain()` config: no ANSI, no leading rule - the rendered
        // text lands in an LSP `message`, not a terminal.
        mut renderer: DiagRenderer = DiagRenderer::new(RenderConfig::plain());
        mut arr: Array<JsonValue> = Array<JsonValue>::with_capacity(diags.length as u64);
        for (mut i: i64 = 0; i < diags.length; i++) {
            if (DiagnosticConverter::diag_is_for_path(&diags[i], fs_path)) {
                arr.push(DiagnosticConverter::diag_to_json(&diags[i], &renderer, cache));
            }
        }
        fs_path_owned.drop();

        mut params: JsonObject = JsonObject::new();
        params.put("uri", JsonValue::from(uri));
        params.put("diagnostics", JsonValue::Array(arr));
        return JsonValue::Object(params);
    }

    /// True when this diagnostic's source span belongs to `fs_path`.
    /// Spanless diagnostics (`span.file == ""`) are dropped - they have
    /// no editor position to render against, so attributing them to the
    /// publishing URI would surface them at line 0 (or worse, at
    /// whatever stale line/col the span happened to carry over) and
    /// confuse the user.  A future pass can route them into the LSP
    /// output channel instead.
    static diag_is_for_path(diag: &Diagnostic, fs_path: Str) -> boolean {
        const span_file: string = diag.span.file;
        if (span_file == "") { return false; }
        if (strlen(span_file) == 0 as u64) { return false; }
        return fs_path.equals(&Str::from(span_file));
    }

    // Rich diagnostic fields
    //
    // The wire `Diagnostic` carries far more than range + message.  We populate:
    //   - `message`            the full rendered report (header, source snippet
    //                          with carets, secondary labels, notes, suggestions)
    //   - `relatedInformation` every secondary span and located child, as a
    //                          clickable navigation target
    //   - `codeDescription`    a docs link the editor opens from the code
    //   - `tags`               fade unused/dead code, strike deprecated
    // so the editor surfaces the same diagnostic the terminal compiler prints.

    /// Build one `DiagnosticRelatedInformation` entry: a `{ location, message }`
    /// pair the editor renders as a clickable jump target beneath the
    /// diagnostic.
    static related_info_json(file: string, span: SourceSpan,
                             message: string) -> JsonValue {
        mut loc: JsonObject = JsonObject::new();
        loc.put("uri",   JsonValue::String(UriPath::uri_string_from_fs_path(file)));
        loc.put("range", DiagnosticConverter::range_json_from_span(span));

        mut o: JsonObject = JsonObject::new();
        o.put("location", JsonValue::Object(loc));
        mut msg: String = String::new();
        msg.push(message);
        o.put("message", JsonValue::String(msg));
        return JsonValue::Object(o);
    }

    /// Collect a diagnostic's secondary span labels and located child
    /// diagnostics into an LSP `relatedInformation` array.  Primary labels
    /// are skipped - the diagnostic's own `range` already covers the primary
    /// site - and so are spanless children: they have no editor position,
    /// but the rendered `message` still carries their text.
    static related_information_array(diag: &Diagnostic) -> Array<JsonValue> {
        mut arr: Array<JsonValue> = Array<JsonValue>::new();

        for (mut i: i64 = 0; i < diag.labels.length; i++) {
            const label: SpanLabel = diag.labels[i];
            if (label.is_primary)            { continue; }
            if (!label.span.has_location())  { continue; }
            arr.push(DiagnosticConverter::related_info_json(label.span.file, label.span, label.message));
        }

        for (mut i: i64 = 0; i < diag.children.length; i++) {
            const child: &Diagnostic = &diag.children[i];
            if (!child.span.has_location()) { continue; }
            const text: string =
                format("%s: %s", child.severity.label(), child.message);
            arr.push(DiagnosticConverter::related_info_json(child.span.file, child.span, text));
        }

        return arr;
    }

    /// LSP `DiagnosticTag` values for a code.  `Unnecessary` (1) fades the
    /// span - the right affordance for unused/dead code; `Deprecated` (2)
    /// strikes it through.  Codes with no tag yield an empty array.
    static diagnostic_tags_array(code: ErrorCode) -> Array<JsonValue> {
        mut arr: Array<JsonValue> = Array<JsonValue>::new();
        match (code) {
            ErrorCode::W0001_UNUSED_VARIABLE => { arr.push(JsonValue::int_value(1)); }
            ErrorCode::W0002_UNUSED_FUNCTION => { arr.push(JsonValue::int_value(1)); }
            ErrorCode::W0003_UNUSED_IMPORT   => { arr.push(JsonValue::int_value(1)); }
            ErrorCode::W0009_DEAD_CODE       => { arr.push(JsonValue::int_value(1)); }
            ErrorCode::W0007_DEPRECATED      => { arr.push(JsonValue::int_value(2)); }
            _                                => { }
        }
        return arr;
    }

    /// `{ "href": <docs url> }` - makes the diagnostic's code a clickable
    /// link in the editor's problems panel and hover.
    static code_description_json() -> JsonValue {
        mut o: JsonObject = JsonObject::new();
        o.put("href", JsonValue::from(ERROR_DOC_URL));
        return JsonValue::Object(o);
    }

    /// Build a stable id for `diag` - a 16-char hex hash of the
    /// diagnostic's (file, start_line, start_col, code) tuple.  Same
    /// diagnostic across publishes => same id; different diagnostics get
    /// distinct ids with FNV-1a's collision profile (negligible for
    /// per-session use).  The id is URI-path-safe (hex digits only) so it
    /// embeds cleanly in a `cryo-diagnostic:/<id>.cryo-diag` URI.
    ///
    /// Returns an OWNED `String`.  The raw `string`s that `ErrorCode::format`
    /// and `format` heap-allocate here are freed before returning, so none
    /// of the three (code, key, hash) leak per diagnostic per publish.
    static build_diag_id(diag: &Diagnostic) -> String {
        const code_str: string = diag.code.format();
        const key: string = format("%s:%u:%u:%s",
            diag.span.file, diag.span.start_line, diag.span.start_col, code_str);
        const h: u64 = hash_str(key);
        const hex: string = format("%016llx", h);
        mut out: String = String::from_str(Str::from(hex));
        intrinsics::free(code_str as void*);
        intrinsics::free(key as void*);
        intrinsics::free(hex as void*);
        return out;
    }

    /// One JSON object per Suggestion, with shape:
    ///
    ///   { "message":       "did you mean `length`?",
    ///     "applicability": "machine-applicable",
    ///     "parts":         [ { "range": {...}, "newText": "length" }, ... ] }
    ///
    /// Ranges are LSP-flavoured (0-indexed lines + characters) and
    /// independently point at each (span, replacement) pair the
    /// suggestion would apply, so a CodeAction handler can hand them
    /// straight to `WorkspaceEdit.changes[uri]` and the IDE will apply
    /// every part atomically.
    static suggestion_to_json(sug: &Suggestion) -> JsonValue {
        mut o: JsonObject = JsonObject::new();

        mut msg: String = String::new();
        msg.push(sug.message);
        o.put("message", JsonValue::String(msg));

        mut app: String = String::new();
        app.push(sug.applicability.wire_label());
        o.put("applicability", JsonValue::String(app));

        mut parts_arr: Array<JsonValue> =
            Array<JsonValue>::with_capacity(sug.parts.length as u64);
        for (mut i: i64 = 0; i < sug.parts.length; i++) {
            const p: SuggestionPart = sug.parts[i];
            mut po: JsonObject = JsonObject::new();
            po.put("range", DiagnosticConverter::range_json_from_span(p.span));
            // Reconstruct a `file://` URI so the editor knows which document
            // the edit applies to.  Multi-file suggestions are rare today
            // but the field is essentially free and makes them work.
            po.put("uri", JsonValue::String(UriPath::uri_string_from_fs_path(p.span.file)));
            mut nt: String = String::new();
            nt.push(p.replacement);
            po.put("newText", JsonValue::String(nt));
            parts_arr.push(JsonValue::Object(po));
        }
        o.put("parts", JsonValue::Array(parts_arr));

        return JsonValue::Object(o);
    }

    /// Build the JSON array of suggestions to embed under
    /// `diagnostic.data.suggestions`.  Spanless suggestions and parts
    /// without a file are skipped - the editor has no way to attach an
    /// edit to nothing.
    static suggestions_array(diag: &Diagnostic) -> Array<JsonValue> {
        mut arr: Array<JsonValue> = Array<JsonValue>::new();
        for (mut i: i64 = 0; i < diag.suggestions.length; i++) {
            const sug: &Suggestion = &diag.suggestions[i];
            if (sug.parts.length == 0) { continue; }
            // Drop suggestions whose first part has no real location.
            if (!sug.parts[0].span.has_location()) { continue; }
            arr.push(DiagnosticConverter::suggestion_to_json(sug));
        }
        return arr;
    }

    /// Render one compiler diagnostic as a fully-populated LSP `Diagnostic`
    /// JSON object.  `renderer` produces the `message` body; `cache`
    /// receives a side copy of that rendered text keyed by a stable
    /// `diagId` that's also stamped on the diagnostic's `data` field, so
    /// the editor's "open rendered diagnostic" code action can fetch the
    /// full report back later.
    static diag_to_json(diag: &Diagnostic,
                        renderer: DiagRenderer*,
                        cache: DiagRenderCache*) -> JsonValue {
        mut o: JsonObject = JsonObject::new();
        o.put("range", DiagnosticConverter::range_json_from_span(diag.span));
        o.put("severity", JsonValue::int_value(DiagnosticConverter::severity_int_from(diag.severity)));

        // Code: rendered as the canonical "E0102" / "W0001" string.
        mut code_str: String = String::new();
        code_str.push(diag.code.format());
        o.put("code", JsonValue::String(code_str));

        // codeDescription: turns the code into a clickable docs link.
        o.put("codeDescription", DiagnosticConverter::code_description_json());

        o.put("source", JsonValue::from("cryoc"));

        // `message`: the short headline only.  VS Code's problems panel
        // renders messages as a single line and its own UI already shows
        // the file/line chip, so stuffing the full multi-line rendered
        // report here turns into garbage.  The full report (snippet,
        // carets, secondary labels, notes, suggestions) lives in the
        // virtual `cryo-diagnostic:` document - opened from the
        // "Show full Cryo diagnostic" code action - and reaches the
        // client via `cryo/renderedDiagnostic` keyed off the diagId.
        mut headline: String = String::new();
        headline.push(diag.message);
        o.put("message", JsonValue::String(headline));

        // Render once for the cache so the virtual-doc view can fetch the
        // full report on demand.  Kept separate from the inline message
        // above by design.
        mut rendered: String = renderer.render_to_string(diag);

        // diagId: stable across publishes; the cache key + the value
        // the editor extension passes to `cryo/renderedDiagnostic`.
        mut id: String = DiagnosticConverter::build_diag_id(diag);
        mut id_for_cache: String = String::from_str(id.as_str());
        cache.insert(id_for_cache, rendered);

        // data: { "diagId": "<id>", "suggestions": [...] }.  diagId
        // backs the "Show full Cryo diagnostic" code action; suggestions
        // are serialized so the `textDocument/codeAction` handler can
        // build per-suggestion CodeAction entries with WorkspaceEdit
        // payloads (machine-applicable fixes auto-apply on click).
        mut id_for_data: String = String::from_str(id.as_str());
        id.drop();
        mut data_obj: JsonObject = JsonObject::new();
        data_obj.put("diagId", JsonValue::String(id_for_data));
        data_obj.put("suggestions", JsonValue::Array(DiagnosticConverter::suggestions_array(diag)));
        o.put("data", JsonValue::Object(data_obj));

        // tags: fade unused/dead code, strike deprecated.  An empty array is
        // a valid no-op; emitting it unconditionally keeps the move/ownership
        // story simple.
        o.put("tags", JsonValue::Array(DiagnosticConverter::diagnostic_tags_array(diag.code)));

        // relatedInformation: clickable navigation to every secondary span
        // and located child diagnostic.
        o.put("relatedInformation", JsonValue::Array(DiagnosticConverter::related_information_array(diag)));

        return JsonValue::Object(o);
    }
}
