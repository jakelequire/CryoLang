///! Go-to-definition handler.
///!
///! Locates the AST node under the cursor and resolves it to a target
///! declaration's name span.  Returns an LSP `Location { uri, range }`
///! pointing at the declared identifier — so the editor jumps to the
///! exact name token, not the whole declaration.
///!
///! Dispatch order (mirrors hover):
///!
///!   1. Cursor on a declaration's own name      → return self
///!   2. `Foo::bar` (ScopeResolution)            → method, then function
///!   3. `obj.method` (MemberAccess)             → method on receiver type
///!   4. Identifier use site                     → resolver span → Symbol
///!   5. Type token in an annotation             → declaring struct/class/etc.
///!
///! Returns `null` (the LSP-spec "no definition" reply) when the cursor
///! lands somewhere that has no jump target (a literal, whitespace, a
///! builtin like `i32` whose decl is synthetic).

namespace Lsp::Handlers::Definition;

import std::core::option;
import std::collections::str;
import std::collections::string;
import std::json::value;

import Compiler::CompilationContext;
import Compiler::AST;
import Compiler::AST::Node;
import Compiler::AST::Expression;
import Compiler::AST::Declaration;
import Compiler::AST::NodeLocator;
import Compiler::Diag::SourceSpan;
import Compiler::Resolver::Resolver;
import Compiler::Resolver::Symbol;
import Compiler::Resolver::SymbolID;
import Compiler::Resolver::SymbolStr;
import Compiler::Types::TypeRef;
import Compiler::ModuleGraph;

import Lsp::Server::Docs;
import Lsp::Server::Session;
import Lsp::Protocol::Lsp;


public function handle_definition(docs: &Docs, sessions: mut &SessionMap,
                                   params: &JsonValue) -> JsonValue {
    // -- Extract URI + 0-based (line, character) ----------------------
    const td_opt: Option<JsonValue*> = params.get(Str::from_cstr("textDocument"));
    if (!td_opt.is_some()) { return JsonValue::Null; }
    const td: JsonValue* = td_opt.unwrap_or(null);
    if (td == null) { return JsonValue::Null; }

    const uri_opt: Option<JsonValue*> = td.get(Str::from_cstr("uri"));
    if (!uri_opt.is_some()) { return JsonValue::Null; }
    const uri_val: JsonValue* = uri_opt.unwrap_or(null);
    if (uri_val == null) { return JsonValue::Null; }

    const uri_str_opt: Option<Str> = uri_val.as_str();
    if (!uri_str_opt.is_some()) { return JsonValue::Null; }
    const uri: Str = uri_str_opt.unwrap_or(Str::from_cstr(""));

    const pos_opt: Option<JsonValue*> = params.get(Str::from_cstr("position"));
    if (!pos_opt.is_some()) { return JsonValue::Null; }
    const pos: JsonValue* = pos_opt.unwrap_or(null);
    if (pos == null) { return JsonValue::Null; }
    const line:      u32 = json_u32_field(pos, "line");
    const character: u32 = json_u32_field(pos, "character");

    // -- Find the session + module + AST for this URI -----------------
    const session_opt: Option<CompilerSession*> = sessions.get(uri);
    if (!session_opt.is_some()) { return JsonValue::Null; }
    const session: CompilerSession* = session_opt.unwrap_or(null);
    if (session == null) { return JsonValue::Null; }
    const ctx: CompilationContext* = session.context();
    if (ctx == null) { return JsonValue::Null; }

    const fs_path: Str = uri_to_fs_path(uri);
    mut path_buf: String = String::with_capacity(fs_path.length() + 1);
    path_buf.push_str(fs_path);
    path_buf.push_byte(0 as u8);
    const path_buf_len: u64 = path_buf.length() - 1;
    path_buf.truncate(path_buf_len);
    const path_cstr: string = path_buf.as_ptr() as string;

    const mod_idx: i64 = ctx.module_graph.find_module_by_path(path_cstr);
    path_buf.drop();
    if (mod_idx < 0) { return JsonValue::Null; }

    const ast: ProgramNode* = ctx.module_graph.get_module_ast(mod_idx as u32);
    if (ast == null) { return JsonValue::Null; }

    // -- Walk to the innermost node -----------------------------------
    // Compiler spans are 1-based; LSP positions are 0-based.
    const cursor_line: u32 = line + 1 as u32;
    const cursor_char: u32 = character + 1 as u32;
    const node: ASTNode* = NodeLocator::find_innermost_node_at(
        ast, cursor_line, cursor_char);
    if (node == null) { return JsonValue::Null; }

    // -- Dispatch -----------------------------------------------------
    const name_span: SourceSpan = NodeLocator::name_span_of(node);
    const on_decl_name: boolean =
        NodeLocator::span_contains(name_span, cursor_line, cursor_char);

    mut target_span: SourceSpan = SourceSpan::none();

    // 1. Cursor on a declaration's own name → return that name span.
    //    "Go to definition" on the definition itself is a no-op jump
    //    in most editors, but emitting the span keeps the protocol
    //    consistent (the editor may choose to highlight, peek, etc.).
    if (on_decl_name) {
        target_span = name_span;
    }

    // 2. `Foo::bar` — try method on `Foo`, then a free function `bar`.
    //    Mirrors hover's resolution; falls through when neither hits.
    if (!target_span.has_location() && node.kind == NodeKind::ScopeResolution) {
        const sr: ScopeResolutionNode* = node as ScopeResolutionNode*;
        const m: MethodNode* = NodeLocator::find_method_in_modules(
            ctx.module_graph, ctx.intern_table, sr.scope_name, sr.member_name);
        if (m != null && m.func != null) {
            target_span = m.func.name_span;
        } else {
            const f: FunctionDeclNode* = NodeLocator::find_function_in_modules(
                ctx.module_graph, sr.member_name);
            if (f != null) {
                target_span = f.name_span;
            } else {
                // Last resort: jump to the type/module named on the
                // scope side — useful for `Foo::Bar` where `Bar` is
                // a nested type or a constant on `Foo`.
                const td: ASTNode* = NodeLocator::find_type_decl_in_modules(
                    ctx.module_graph, ctx.intern_table, sr.scope_name);
                if (td != null) {
                    target_span = NodeLocator::name_span_of(td);
                }
            }
        }
    }

    // 3. `obj.method` — receiver's resolved type → method on that type.
    //    `find_innermost_node_at` returns MemberAccess only when the
    //    cursor is past the receiver (on the dot or member token), so
    //    cursor-on-receiver naturally falls through to (4).
    if (!target_span.has_location() && node.kind == NodeKind::MemberAccess) {
        const ma: MemberAccessNode* = node as MemberAccessNode*;
        if (ma.object != null && ctx.decl_index != null) {
            const recv_ty: TypeRef = ma.object.resolved_type;
            if (recv_ty.is_valid()) {
                const type_sym: SymbolStr = ctx.decl_index.lookup_type_name(recv_ty);
                if (type_sym.is_valid()) {
                    const m: MethodNode* = NodeLocator::find_method_in_modules(
                        ctx.module_graph, ctx.intern_table, type_sym, ma.member);
                    if (m != null && m.func != null) {
                        target_span = m.func.name_span;
                    }
                }
            }
        }
    }

    // 4. Identifier use site → resolver's span→symbol map → declaring
    //    span on the symbol record.  Covers locals, params, fields
    //    accessed via plain identifiers, and free-function references.
    //    Builtins (`i32`, `bool`, …) come back with an empty
    //    declaring span and are filtered at the bottom.
    //
    //    `Symbol::declaring_span` is stamped at registration time and
    //    typically covers the whole decl statement.  Walk the target
    //    file's AST to find the decl node at that span and use its
    //    narrower `name_span` so the editor highlights just the name
    //    on jump.
    if (!target_span.has_location()
        && node.kind == NodeKind::Identifier
        && ctx.resolver != null) {
        const id_node: IdentifierNode* = node as IdentifierNode*;
        const sym_id: SymbolID = ctx.resolver.resolve(id_node.span);
        if (sym_id.is_valid()) {
            const sym: Symbol = ctx.resolver.get_symbol(sym_id);
            if (sym.declaring_span.has_location()) {
                target_span = narrow_to_name_span(
                    ctx.module_graph, sym.declaring_span);
            }
        }
    }

    // 5. Cursor on a type token inside an annotation (the locator
    //    can't descend into TypeAnnotation, so the walk stops at the
    //    enclosing decl — function, variable, field, type alias).
    //    Find the innermost named segment under the cursor, then
    //    look up its declaring struct/class/enum/trait/typealias.
    if (!target_span.has_location()) {
        const ann: TypeAnnotation* = annotation_for_node(node);
        if (ann != null) {
            const named: NamedAnnotation* = NodeLocator::find_named_annotation_at(
                ann, cursor_line, cursor_char);
            if (named != null) {
                const decl: ASTNode* = NodeLocator::find_type_decl_in_modules(
                    ctx.module_graph, ctx.intern_table, named.name);
                if (decl != null) {
                    target_span = NodeLocator::name_span_of(decl);
                }
            }
        }
    }

    if (!target_span.has_location()) { return JsonValue::Null; }
    if (target_span.file == "")       { return JsonValue::Null; }
    if (strlen(target_span.file) == 0 as u64) { return JsonValue::Null; }

    return build_location_json(target_span);
}


// ============================================================================
// Span narrowing
// ============================================================================

/// Walk the module graph to find the decl node at `decl_span` and
/// return its `name_span` (the narrow range covering just the
/// declared identifier).  Falls back to `decl_span` itself when no
/// decl can be located — e.g. synthetic spans from sema.  Used so
/// jumps from identifier use sites land on the name rather than
/// underlining the whole decl line.
function narrow_to_name_span(graph: ModuleGraph*, decl_span: SourceSpan) -> SourceSpan {
    if (graph == null) { return decl_span; }
    if (decl_span.file == "")           { return decl_span; }
    if (strlen(decl_span.file) == 0 as u64) { return decl_span; }

    const mod_idx: i64 = graph.find_module_by_path(decl_span.file);
    if (mod_idx < 0) { return decl_span; }
    const ast: ProgramNode* = graph.get_module_ast(mod_idx as u32);
    if (ast == null) { return decl_span; }

    const decl: ASTNode* = NodeLocator::find_innermost_node_at(
        ast, decl_span.start_line, decl_span.start_col);
    if (decl == null) { return decl_span; }

    const name_span: SourceSpan = NodeLocator::name_span_of(decl);
    if (name_span.has_location()) { return name_span; }
    return decl_span;
}


// ============================================================================
// Annotation lookup on the located decl
// ============================================================================

/// Return the type-annotation tree attached to `node`, if any.
/// Used by the type-token branch to find which named segment the
/// cursor sits on.  Decls that don't carry an annotation here
/// (struct/class/enum bodies, free expressions) return `null` and
/// the caller falls through to a `null` reply.
function annotation_for_node(node: ASTNode*) -> TypeAnnotation* {
    if (node == null) { return null; }
    if (node.kind == NodeKind::FunctionDeclaration) {
        const f: FunctionDeclNode* = node as FunctionDeclNode*;
        return f.return_type_annotation;
    }
    if (node.kind == NodeKind::MethodDeclaration) {
        const m: MethodNode* = node as MethodNode*;
        if (m.func == null) { return null; }
        return m.func.return_type_annotation;
    }
    if (node.kind == NodeKind::VariableDeclaration) {
        const v: VarDeclNode* = node as VarDeclNode*;
        return v.type_annotation;
    }
    if (node.kind == NodeKind::FieldDeclaration) {
        const fld: FieldDeclNode* = node as FieldDeclNode*;
        return fld.type_annotation;
    }
    if (node.kind == NodeKind::TypeAliasDeclaration) {
        const ta: TypeAliasDeclNode* = node as TypeAliasDeclNode*;
        return ta.target_annotation;
    }
    return null;
}


// ============================================================================
// JSON / span / URI helpers
//
// Duplicated from hover.cryo for now; consolidating into a shared
// `Lsp::Protocol` helper module is a follow-up cleanup once a third
// handler lands that needs them.
// ============================================================================

const FILE_SCHEME:     string = "file://";
const FILE_SCHEME_LEN: u64    = 7;

/// Build an LSP `Location` JSON object from a span whose `file`
/// field carries the absolute filesystem path (the parser stamps
/// every span with the source it came from).  Reconstructs the URI
/// by prepending `file://` — the inverse of `uri_to_fs_path`.
function build_location_json(span: SourceSpan) -> JsonValue {
    mut uri_buf: String = String::with_capacity(strlen(span.file) + FILE_SCHEME_LEN);
    uri_buf.push_cstr(FILE_SCHEME);
    uri_buf.push_cstr(span.file);

    const range: Range = range_from_span(span);
    const loc: Location = Location { uri: uri_buf, range: range };
    const result: JsonValue = loc.to_json();
    mut l: Location = loc;
    l.drop();
    return result;
}

/// Strip `file://` from a URI to get the absolute filesystem path
/// the loader stored on each span.
function uri_to_fs_path(uri: Str) -> Str {
    if (uri.length() >= FILE_SCHEME_LEN) {
        const prefix: Str = uri.sub_bytes(0, FILE_SCHEME_LEN);
        if (prefix.equals(&Str::from_cstr(FILE_SCHEME))) {
            return uri.sub_bytes(FILE_SCHEME_LEN, uri.length());
        }
    }
    return uri;
}

/// Read an integer field (`line` / `character`) from a JSON Position.
/// Negative or non-integer values clamp to 0 — the LSP spec says
/// positions must be non-negative, but malformed clients exist.
function json_u32_field(obj: &JsonValue, key: string) -> u32 {
    match (obj.get(Str::from_cstr(key))) {
        Option::Some(v) => {
            match (v) {
                JsonValue::Number(n) => {
                    match (n) {
                        JsonNumber::Int(i)   => {
                            if (i < 0) { return 0 as u32; }
                            return i as u32;
                        }
                        JsonNumber::UInt(u)  => { return u as u32; }
                        JsonNumber::Float(f) => {
                            if (f < 0.0) { return 0 as u32; }
                            return f as u32;
                        }
                    }
                }
                _ => { return 0 as u32; }
            }
        }
        Option::None => { return 0 as u32; }
    }
    return 0 as u32;
}

/// Convert a 1-based compiler `SourceSpan` to a 0-based LSP `Range`.
function range_from_span(span: SourceSpan) -> Range {
    mut sl: u32 = 0;
    mut sc: u32 = 0;
    mut el: u32 = 0;
    mut ec: u32 = 0;
    if (span.start_line > 0) { sl = span.start_line - 1; }
    if (span.start_col  > 0) { sc = span.start_col  - 1; }
    if (span.end_line   > 0) { el = span.end_line   - 1; }
    if (span.end_col    > 0) { ec = span.end_col    - 1; }
    return Range::new(Position::new(sl, sc), Position::new(el, ec));
}
