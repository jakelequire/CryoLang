///! Go-to-definition.
///!
///! The target at the position (`identity`) to the place it is declared:
///! a declaration's name, a binding's own name, a field's or a variant's
///! name, a module's file.  A target with nowhere to go - a primitive, or
///! no target - answers `null`.
namespace lsp::handlers::definition;

import std::core::option;
import std::core::mem;
import std::collections::str;
import std::collections::string;
import std::collections::string::{ String };
import std::json::value;

import compiler::compilation_context::{ CompilationContext };
import compiler::ast::{ NodeKind, PatternElement };
import compiler::ast::node::{ ASTNode, ProgramNode };
import compiler::ast::node_locator;
import compiler::ast::declaration::{ ClassDeclNode, EnumDeclNode, StructDeclNode, UnionDeclNode, VarDeclNode };
import compiler::ast::pattern::{ EnumPatternNode, PatternNode };
import compiler::diag::source_span::{ SourceSpan };
import compiler::resolver::res::{ DefId, DefKind };
import compiler::resolver::symbol::{ Symbol };
import compiler::resolver::symbol_id::{ SymbolID };

import lsp::handlers::identity::{ Asked, Locator, Target };
import lsp::server::docs;
import lsp::server::session;
import lsp::protocol::lsp;
import lsp::protocol::conv;


public function handle_definition(docs: mut &docs::Docs, projects: mut &session::Projects,
                                   params: &value::JsonValue) -> value::JsonValue {
    const asked: Asked = Asked::from(docs, projects, params);
    if (asked.ctx == null) { return value::JsonValue::Null; }
    const span: SourceSpan = Declared::span_of(asked.ctx, &asked.answer.target);
    if (span.start_line == 0 || span.file == null || span.file.length() == 0) {
        return value::JsonValue::Null;
    }
    mut uri: String = conv::UriPath::uri_string_from_fs_path(span.file);
    const loc: lsp::Location = lsp::Location { uri: uri, range: docs.range_of_span(span) };
    const result: value::JsonValue = loc.to_json();
    mut l: lsp::Location = loc;
    mem::drop(l);
    return result;
}


/// Where a target is declared.
type struct Declared {
    /// The span of the name a target is declared under; `none()` for a
    /// target declared nowhere.
    static span_of(ctx: CompilationContext*, target: &Target) -> SourceSpan {
        match (target) {
            Target::Def(d)          => { return Declared::def_span(ctx, d); }
            Target::Local(s)        => { return Declared::binding_span(ctx, s); }
            Target::TypeParam(s)    => { return ctx.resolver.get_symbol(s).declaring_span; }
            Target::Field(o, i)     => { return Declared::field_span(ctx, o, i); }
            Target::Variant(o, i)   => { return Declared::variant_span(ctx, o, i); }
            _                       => { return SourceSpan::none(); }
        }
    }

    /// A definition's declared name; a module's, the `namespace` its file
    /// declares, or the file's start.
    static def_span(ctx: CompilationContext*, d: DefId) -> SourceSpan {
        if (ctx.defs.kind_of(d) == DefKind::Module) {
            for (mut i: i64 = 0; i < ctx.module_graph.modules.length; i++) {
                if (!ctx.module_graph.modules[i].def.equals(d)) { continue; }
                const program: ProgramNode* = ctx.module_graph.get_module_ast(i as u32);
                if (program != null) {
                    for (mut s: i64 = 0; s < program.statements.length; s++) {
                        const stmt: ASTNode* = program.statements[s];
                        if (stmt != null && stmt.kind == NodeKind::ModuleDeclaration
                                && stmt.span.start_line != 0) {
                            return stmt.span;
                        }
                    }
                }
                return SourceSpan::new(ctx.module_graph.modules[i].file_path, 1, 1, 1, 1);
            }
            return SourceSpan::none();
        }
        const decl: ASTNode* = ctx.decl_index.declaration_of(d);
        const named: SourceSpan = node_locator::name_span_of(decl);
        if (named.start_line != 0) { return named; }
        return ctx.defs.span_of(d);
    }

    /// A binding's own name: the declaration whose binding it is, found
    /// at the span the name layer declared it with.
    static binding_span(ctx: CompilationContext*, s: SymbolID) -> SourceSpan {
        const sym: Symbol = ctx.resolver.get_symbol(s);
        const at: SourceSpan = sym.declaring_span;
        if (at.start_line == 0) { return at; }
        const m: i64 = ctx.module_graph.find_module_by_path(at.file);
        if (m < 0) { return at; }
        const program: ProgramNode* = ctx.module_graph.get_module_ast(m as u32);
        const n: ASTNode* = Locator::node_at(ctx, program, at.start_line, at.start_col);
        if (n != null && n.kind == NodeKind::VariableDeclaration) {
            const v: VarDeclNode* = n as VarDeclNode*;
            if (v.sym_id.equals(s) && v.name_span.start_line != 0) { return v.name_span; }
        }
        return at;
    }

    /// Whether a binding is one a pattern declares: a match arm's name, or
    /// a name inside a variant's pattern.
    static is_pattern_binding(ctx: CompilationContext*, s: SymbolID) -> boolean {
        const at: SourceSpan = ctx.resolver.get_symbol(s).declaring_span;
        if (at.start_line == 0) { return false; }
        const m: i64 = ctx.module_graph.find_module_by_path(at.file);
        if (m < 0) { return false; }
        const program: ProgramNode* = ctx.module_graph.get_module_ast(m as u32);
        const n: ASTNode* = Locator::node_at(ctx, program, at.start_line, at.start_col);
        if (n == null) { return false; }
        if (n.kind == NodeKind::Pattern) {
            return (n as PatternNode*).binding_sym.equals(s);
        }
        if (n.kind != NodeKind::EnumPattern) { return false; }
        const ep: EnumPatternNode* = n as EnumPatternNode*;
        for (mut i: i64 = 0; i < ep.elements.length; i++) {
            match (ep.elements[i]) {
                PatternElement::Binding(b) => {
                    if (b != null && b.sym_id.equals(s)) { return true; }
                }
                _ => { }
            }
        }
        return false;
    }

    static field_span(ctx: CompilationContext*, owner: DefId, index: i64) -> SourceSpan {
        const decl: ASTNode* = ctx.decl_index.declaration_of(owner);
        if (decl == null || index < 0) { return SourceSpan::none(); }
        if (decl.kind == NodeKind::StructDeclaration) {
            const sd: StructDeclNode* = decl as StructDeclNode*;
            if (index < sd.fields.length) { return sd.fields[index].name_span; }
        } else if (decl.kind == NodeKind::ClassDeclaration) {
            const cd: ClassDeclNode* = decl as ClassDeclNode*;
            if (index < cd.fields.length) { return cd.fields[index].name_span; }
        } else if (decl.kind == NodeKind::UnionDeclaration) {
            const ud: UnionDeclNode* = decl as UnionDeclNode*;
            if (index < ud.fields.length) { return ud.fields[index].name_span; }
        }
        return SourceSpan::none();
    }

    static variant_span(ctx: CompilationContext*, owner: DefId, ordinal: i64) -> SourceSpan {
        const decl: ASTNode* = ctx.decl_index.declaration_of(owner);
        if (decl == null || decl.kind != NodeKind::EnumDeclaration || ordinal < 0) {
            return SourceSpan::none();
        }
        const ed: EnumDeclNode* = decl as EnumDeclNode*;
        if (ordinal >= ed.variants.length) { return SourceSpan::none(); }
        return ed.variants[ordinal].name_span;
    }
}
