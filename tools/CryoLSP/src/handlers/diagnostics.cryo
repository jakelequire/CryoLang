///! Diagnostic publishing.
///!
///! After every `recompile()` we walk the freshly-populated
///! `ctx.diagnostics.diagnostics` array, build a
///! `textDocument/publishDiagnostics` notification, and write it to
///! the wire.  Diagnostics are URI-scoped: every notification names
///! exactly one document, so an empty `diagnostics: []` array is the
///! way to clear stale squiggles after a fix.

namespace lsp::handlers::diagnostics;

import std::core::option;
import std::core::result;
import std::core::mem;
import std::collections::str;
import std::collections::string::{ String };
import std::collections::array::{ Array };
import std::io::stdio;
import std::io::error;
import std::json::value;

import compiler::compilation_context;
import compiler::diag::diagnostic;

import lsp::protocol::framing;
import lsp::protocol::jsonrpc;
import lsp::protocol::conv;
import lsp::server::diag_render_cache;
import lsp::server::docs;


// DiagnosticPublisher - build + frame + write publishDiagnostics
// notifications to the wire.  Stateless: the stdout sink is passed in.

type struct DiagnosticPublisher {

    /// Publish diagnostics for `uri`, reading them from the compilation
    /// context's diagnostic sink.  Always emits - even when `diagnostics`
    /// is empty - so the editor clears squiggles after a successful
    /// recompile.  `cache` receives the rendered text of each emitted
    /// diagnostic, keyed by `diagId`, so the `cryo/renderedDiagnostic`
    /// request can later return the same text for the editor's virtual
    /// diagnostic tab.  `notice`, when there is one, is a warning on the
    /// document's first line saying why the analysis did not read it.
    static publish_for(writer: mut &stdio::Stdout, uri: str::Str,
                       ctx: compilation_context::CompilationContext*,
                       notice: Option<String>,
                       cache: mut diag_render_cache::DiagRenderCache*,
                       positions: &docs::Docs) -> void {
        const none: [diagnostic::Diagnostic] = [];
        const diags: &[diagnostic::Diagnostic] = if (ctx == null) { &none } else { &ctx.diagnostics.diagnostics };
        const params: value::JsonValue =
            conv::DiagnosticConverter::build_publish_params(uri, diags, notice, cache, positions);
        DiagnosticPublisher::send_notification(writer, params);
    }

    /// Publish an empty diagnostics array for `uri`.  Used when there's
    /// no compilation context to consult (e.g. didClose, or a session
    /// that never compiled successfully).
    static publish_empty(writer: mut &stdio::Stdout, uri: str::Str) -> void {
        mut params: value::JsonObject = value::JsonObject::new();
        params.put("uri", value::JsonValue::from(uri));
        params.put("diagnostics", value::JsonValue::Array(Array::<value::JsonValue>::with_capacity(0)));
        DiagnosticPublisher::send_notification(writer, value::JsonValue::Object(params));
    }

    /// Encode + frame + write a `publishDiagnostics` notification.  Write
    /// failures are swallowed (consistent with the rest of the server -
    /// stdout is the wire, so logging the error there would corrupt it).
    static send_notification(writer: mut &stdio::Stdout, params: value::JsonValue) -> void {
        mut body: String = jsonrpc::JsonRpcCodec::encode_notification(
            str::Str::from("textDocument/publishDiagnostics"), params);
        match (framing::FrameCodec::write_message(writer, body.as_str())) {
            Result::Ok(_)  => { }
            Result::Err(_) => { }
        }
        mem::drop(body);
    }
}
