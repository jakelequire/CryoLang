///! A type's members and a module's contents, enumerated by identity.
///!
///! A type's members are what its declaration holds - fields, constants,
///! methods, variants - then what every implementation block whose stamped
///! target is the type adds.  A module's contents are
///! its export list and the modules nested under it.  Nothing here asks for
///! a member by its name: completion and the extended hover list them all.
namespace lsp::handlers::members;

import std::collections::str;
import std::collections::string::{ String };
import compiler::compilation_context::{ CompilationContext };
import compiler::ast::node::{ ProgramNode };
import compiler::ast::node_locator::{ NodeLocator };
import compiler::ast::declaration::{
    DeclarationNode, DeclKind, EnumDecl, FieldDecl, FunctionDecl, ImplBlock, MethodDecl,
    StructDecl, UnionDecl, VarDecl
};
import compiler::module_graph::{ ModulePath };
import compiler::resolver::res::{ DefId };
import compiler::resolver::symbol::{ Symbol, SymbolKind };
import compiler::resolver::symbol_id::{ SymbolID };


/// One member of a type.
type enum Member {
    /// Field `index` of the type `owner` declares.
    Field(DefId, i64);
    /// Variant `ordinal` of the enum `owner`.
    Variant(DefId, i64);
    /// A method, by its declaration.
    Method(MethodDecl*);
    /// A constant the type declares, by its definition.
    Constant(DefId);
}

type struct Members {
    ctx: CompilationContext*;
    out: [Member];

    /// Every member of the type `d`: its own, then its implementation
    /// blocks'.  Empty for a definition that is no type.
    static of_type(ctx: CompilationContext*, d: DefId) -> [Member] {
        mut m: Members = Members { ctx: ctx, out: [] };
        if (d.is_valid()) { m.add_type(d); }
        return m.out;
    }

    /// Add the members `d` declares and its blocks add.
    add_type(mut &this, d: DefId) -> void {
        const decl: DeclarationNode* = this.ctx.decl_index.declaration_of(d);
        if (decl == null) { return; }
        match (decl.kind) {
            DeclKind::Enum(ed) => {
                for (mut i: i64 = 0; i < ed.variants.length(); i++) {
                    this.out.push(Member::Variant(d, i));
                }
            }
            DeclKind::Union(ud) => {
                this.add_fields(d, &ud.fields);
                this.add_constants(&ud.constants);
                this.add_methods(&ud.methods);
            }
            DeclKind::Struct(sd) => {
                this.add_fields(d, &sd.fields);
                this.add_constants(&sd.constants);
                this.add_methods(&sd.methods);
            }
            DeclKind::Import(_) | DeclKind::Intrinsic(_) | DeclKind::Impl(_)
            | DeclKind::Module(_) | DeclKind::Variant(_) | DeclKind::Destructure(_)
            | DeclKind::Extern(_) | DeclKind::TypeAlias(_) | DeclKind::Field(_)
            | DeclKind::GenericParam(_) | DeclKind::Trait(_) | DeclKind::Variable(_)
            | DeclKind::Function(_) | DeclKind::Method(_) => { return; }
        }
        this.add_blocks(d);
    }

    add_fields(mut &this, owner: DefId, fields: &[DeclarationNode*]) -> void {
        for (mut i: i64 = 0; i < fields.length(); i++) {
            if (fields[i] != null) { this.out.push(Member::Field(owner, i)); }
        }
    }

    add_constants(mut &this, constants: &[DeclarationNode*]) -> void {
        for (mut i: i64 = 0; i < constants.length(); i++) {
            const c: VarDecl* = DeclarationNode::var_of(constants[i]);
            if (c == null || !c.def.is_valid()) { continue; }
            this.out.push(Member::Constant(c.def));
        }
    }

    add_methods(mut &this, methods: &[DeclarationNode*]) -> void {
        for (mut i: i64 = 0; i < methods.length(); i++) {
            const m_decl: DeclarationNode* = methods[i];
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m == null || m.func == null) { continue; }
            this.out.push(Member::Method(m));
        }
    }

    /// The methods of every implementation block, in any module, whose
    /// stamped target is `d`.
    add_blocks(mut &this, d: DefId) -> void {
        const n: u32 = this.ctx.module_graph.module_count();
        for (mut mi: u32 = 0; mi < n; mi++) {
            const program: ProgramNode* = this.ctx.module_graph.get_module_ast(mi);
            if (program == null) { continue; }
            for (mut si: i64 = 0; si < program.statements.length(); si++) {
                const stmt: DeclarationNode* = NodeLocator::unwrap_decl_stmt(program.statements[si]).as_decl();
                if (stmt == null || DeclarationNode::impl_of(stmt) == null) { continue; }
                const ib: ImplBlock* = DeclarationNode::impl_of(stmt);
                if (ib.target_def().equals(d)) {
                    this.add_constants(&ib.constants);
                    this.add_methods(&ib.methods);
                }
            }
        }
    }


    /// The declaration of field `index` of the type `owner`, or null.  The
    /// header: a field carries its spans and documentation there.
    static field_decl(ctx: CompilationContext*, owner: DefId, index: i64) -> DeclarationNode* {
        const decl: DeclarationNode* = ctx.decl_index.declaration_of(owner);
        if (decl == null || index < 0) { return null; }
        if (DeclarationNode::struct_of(decl) != null) {
            const sd: StructDecl* = DeclarationNode::struct_of(decl);
            if (index < sd.fields.length()) { return sd.fields[index]; }
        } else if (DeclarationNode::union_of(decl) != null) {
            const ud: UnionDecl* = DeclarationNode::union_of(decl);
            if (index < ud.fields.length()) { return ud.fields[index]; }
        }
        return null;
    }

    /// The declaration of variant `ordinal` of the enum `owner`, or null.
    static variant_decl(ctx: CompilationContext*, owner: DefId, ordinal: i64) -> DeclarationNode* {
        const decl: DeclarationNode* = ctx.decl_index.declaration_of(owner);
        const ed: EnumDecl* = DeclarationNode::enum_of(decl);
        if (ed == null || ordinal < 0 || ordinal >= ed.variants.length()) { return null; }
        return ed.variants[ordinal];
    }

    /// Whether a member is reached through a value (`x.m`) rather than
    /// through its type (`T::m`).
    static is_instance(m: &Member) -> boolean {
        return match (m) {
            Member::Field(_, _)   => { true }
            Member::Variant(_, _) => { false }
            Member::Method(md)    => { !md.is_static }
            Member::Constant(_)   => { false }
        };
    }

    /// Whether code in module `from` may name the member `m` of the type
    /// `owner`, judged as the compiler judges the access: a field is
    /// declared where its type is, a method where its declaration is
    /// written, and a trait's method reaches wherever the trait does.  A
    /// variant reaches wherever its enum does.
    static reachable_from(ctx: CompilationContext*, owner: DefId, m: &Member, from: ModulePath) -> boolean {
        match (m) {
            Member::Field(_, index) => {
                const field: FieldDecl* = DeclarationNode::field_of(Members::field_decl(ctx, owner, index));
                if (field == null) { return true; }
                return ctx.reaches(field.visibility, ctx.declaring_module(owner), from);
            }
            Member::Variant(_, _) => { return true; }
            Member::Method(md) => {
                const func: FunctionDecl* = DeclarationNode::fn_of(md.func);
                if (func != null && func.origin_trait.is_valid()) {
                    return !ctx.hidden_from(func.origin_trait, from);
                }
                return ctx.reaches(md.visibility, ctx.module_of_file(md.func.span.file), from);
            }
            Member::Constant(d) => { return !ctx.hidden_from(d, from); }
        }
    }

    /// The declarations module `m` exports that code in module `from` may
    /// name, each as the declaration it names rather than the binding that
    /// re-exports it.
    static exports_of(ctx: CompilationContext*, m: ModulePath, from: ModulePath) -> [SymbolID] {
        mut out: [SymbolID] = [];
        const all: [SymbolID] = ctx.resolver.get_exports(m);
        for (mut i: i64 = 0; i < all.length(); i++) {
            if (ctx.resolver.get_symbol(all[i]).kind == SymbolKind::Refused) { continue; }
            const declared: SymbolID = ctx.resolver.declaration_of(all[i]);
            if (ctx.hidden_from(ctx.resolver.get_symbol(declared).def, from)) { continue; }
            out.push(declared);
        }
        return out;
    }

    /// The modules nested one level under `m`, or, for an invalid `m`, the
    /// modules nested under none, that code in module `from` may name.
    /// Each is named by its last segment, the text a path continues with;
    /// a module hidden from `from` hides every path through it.
    static submodules_of(ctx: CompilationContext*, m: ModulePath, from: ModulePath) -> [string] {
        mut out: [string] = [];
        mut hidden: [string] = [];
        const parent: string = if (m.is_valid()) { ctx.intern_table.shown(m.decl_name()) } else { "" };
        const skip: i64 = if (m.is_valid()) { parent.length() as i64 + 2 } else { 0 };
        const separator: str::Str = str::Str::from("::");
        const n: u32 = ctx.module_graph.module_count();
        for (mut i: u32 = 0; i < n; i++) {
            const p: ModulePath = ctx.module_graph.get_module(i as i64).path();
            if (m.is_valid() && (p.equals(m) || !p.is_within(m, ctx.intern_table))) { continue; }
            const full: str::Str = str::Str::from(ctx.intern_table.shown(p.decl_name()));
            if (skip >= full.length()) { continue; }
            const rest: str::Str = full.sub_bytes(skip, full.length());
            const head: str::Str = match (rest.split_once(&separator)) {
                Option::Some(parts) => { parts.first }
                Option::None        => { rest }
            };
            if (head.length() == 0) { continue; }
            const seg: string = String::from_str(head).into_raw();
            if (head.length() == rest.length() && ctx.hidden_from(ctx.module_def_of(p), from)) {
                hidden.push(seg);
                continue;
            }
            mut seen: boolean = false;
            for (mut k: i64 = 0; k < out.length(); k++) {
                if (out[k].equals(&seg)) { seen = true; break; }
            }
            if (!seen) { out.push(seg); }
        }
        mut reachable: [string] = [];
        for (mut i: i64 = 0; i < out.length(); i++) {
            mut is_hidden: boolean = false;
            for (mut k: i64 = 0; k < hidden.length(); k++) {
                if (hidden[k].equals(&out[i])) { is_hidden = true; break; }
            }
            if (!is_hidden) { reachable.push(out[i]); }
        }
        return reachable;
    }
}
