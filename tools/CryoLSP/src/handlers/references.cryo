///! References and document highlights: every place the target at the
///! position is written, from the uses index (`uses`).  A position with no
///! target answers nothing.
namespace lsp::handlers::references;

import std::core::option;
import std::collections::str;
import std::collections::string::{ String };
import std::collections::array;
import std::collections::array::{ Array };
import std::json::value;

import lsp::handlers::identity::{ Asked };
import lsp::handlers::uses::{ Use, Uses };
import lsp::server::docs;
import lsp::server::session;
import lsp::protocol::conv;


/// `textDocument/references`: every use of the target, its declaration
/// included when the request's context asks for it.
public function handle_references(docs: mut &docs::Docs, projects: mut &session::Projects,
                                   params: &value::JsonValue) -> value::JsonValue {
    const asked: Asked = Asked::from(docs, projects, params);
    if (asked.ctx == null || asked.answer.target.is_nothing()) { return value::JsonValue::Null; }
    const found: Use[] = Uses::of_target(asked.ctx, &asked.answer.target,
                                         References::includes_declaration(params));
    mut out: Array<value::JsonValue> = Array::<value::JsonValue>::new();
    for (mut i: i64 = 0; i < found.length; i++) {
        mut loc: value::JsonObject = value::JsonObject::new();
        loc.put("uri", value::JsonValue::String(conv::UriPath::uri_string_from_fs_path(found[i].span.file)));
        loc.put("range", docs.range_of_span(found[i].span).to_json());
        out.push(value::JsonValue::Object(loc));
    }
    return value::JsonValue::Array(out);
}

/// `textDocument/documentHighlight`: the target's uses in this document.
public function handle_highlight(docs: mut &docs::Docs, projects: mut &session::Projects,
                                  params: &value::JsonValue) -> value::JsonValue {
    const asked: Asked = Asked::from(docs, projects, params);
    if (asked.ctx == null || asked.module_idx < 0 || asked.answer.target.is_nothing()) {
        return value::JsonValue::Null;
    }
    const here: Use[] = Uses::in_module(asked.ctx, asked.module_idx);
    mut out: Array<value::JsonValue> = Array::<value::JsonValue>::new();
    for (mut i: i64 = 0; i < here.length; i++) {
        if (!here[i].target.same(&asked.answer.target)) { continue; }
        mut h: value::JsonObject = value::JsonObject::new();
        h.put("range", docs.range_of_span(here[i].span).to_json());
        // A declaration is where the name is written to; a use reads it.
        h.put("kind", value::JsonValue::int_value(if (here[i].decl) { 3 } else { 2 }));
        out.push(value::JsonValue::Object(h));
    }
    return value::JsonValue::Array(out);
}


type struct References {
    /// `context.includeDeclaration`, false when absent.
    static includes_declaration(params: &value::JsonValue) -> boolean {
        const c: value::JsonValue* = params.get(str::Str::from("context")).unwrap_or(null);
        if (c == null) { return false; }
        const inc: value::JsonValue* = c.get(str::Str::from("includeDeclaration")).unwrap_or(null);
        if (inc == null) { return false; }
        return match (inc) {
            value::JsonValue::Bool(b) => { b }
            _                         => { false }
        };
    }
}
