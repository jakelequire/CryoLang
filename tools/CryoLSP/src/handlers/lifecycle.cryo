///! `initialize` and `shutdown` handlers.
///!
///! `initialize` is the only request the server accepts before
///! `state.initialized` flips true.  It captures the workspace
///! `rootUri` (so imports relative to the project root resolve)
///! and returns the server's capabilities.  `shutdown` flips
///! `shutdown_requested`; the next `exit` notification ends the
///! process cleanly with code 0.

namespace lsp::handlers::lifecycle;

import std::core::mem;
import std::core::option;
import std::collections::str;
import std::collections::string;
import std::collections::string::{ String };
import std::collections::array;
import std::collections::array::{ Array };
import std::json::value;

import lsp::server::state;
import lsp::protocol::semantic_tokens;


/// Handle an `initialize` request.  Mutates `state` and returns the
/// JSON value to put into the response's `result` field.
public function handle_initialize(state: mut &state::ServerState, params: &value::JsonValue) -> value::JsonValue {
    // Stash the workspace root if present.  Either `rootUri` (older
    // spec) or `workspaceFolders[0].uri` (newer) is acceptable; we
    // accept the former since most clients still send it.
    match (params.get(str::Str::from("rootUri"))) {
        Option::Some(uri_v) => {
            match (uri_v.as::<str::Str>()) {
                Option::Some(uri) => {
                    mut old: String = String::from_str(uri);
                    mem::swap(&old, &state.root_uri);
                    mem::drop(old);
                }
                Option::None => { }
            }
        }
        Option::None => { }
    }

    state.initialized = true;

    // Position encoding: `utf-8` when the client offers it, otherwise the
    // protocol's default, UTF-16 code units.  Either way the columns are
    // converted in one place (`line_index::Columns`).
    const advertise_utf8: boolean = LspCapabilities::client_offers_utf8(params);
    state.utf8_positions = advertise_utf8;
    state.semantic_tokens_refresh = LspCapabilities::client_supports_tokens_refresh(params);
    return LspCapabilities::build_initialize_result(advertise_utf8);
}

/// Handle a `shutdown` request.  Per LSP spec the response body is
/// `null`; the client sends `exit` next, which the server loop
/// catches at the top of its dispatch path.
public function handle_shutdown(state: mut &state::ServerState) -> value::JsonValue {
    state.shutdown_requested = true;
    return value::JsonValue::Null;
}


// LspCapabilities - client-capability probing + InitializeResult building.

type struct LspCapabilities {

    /// True when the client declares
    /// `capabilities.workspace.semanticTokens.refreshSupport: true`.
    static client_supports_tokens_refresh(params: &value::JsonValue) -> boolean {
        match (params.get(str::Str::from("capabilities"))) {
            Option::Some(caps) => {
                match (caps.get(str::Str::from("workspace"))) {
                    Option::Some(ws) => {
                        match (ws.get(str::Str::from("semanticTokens"))) {
                            Option::Some(st) => {
                                match (st.get(str::Str::from("refreshSupport"))) {
                                    Option::Some(flag) => {
                                        match (flag) {
                                            value::JsonValue::Bool(b) => { return b; }
                                            _ => { return false; }
                                        }
                                    }
                                    Option::None => { return false; }
                                }
                            }
                            Option::None => { return false; }
                        }
                    }
                    Option::None => { return false; }
                }
            }
            Option::None => { return false; }
        }
    }

    /// True when the client's `initialize` params advertise support for the
    /// `utf-8` position encoding (`capabilities.general.positionEncodings`
    /// contains the string `"utf-8"`).  Missing/wrong-typed fields => false.
    static client_offers_utf8(params: &value::JsonValue) -> boolean {
        match (params.get(str::Str::from("capabilities"))) {
            Option::Some(caps) => {
                match (caps.get(str::Str::from("general"))) {
                    Option::Some(general) => {
                        match (general.get(str::Str::from("positionEncodings"))) {
                            Option::Some(encs) => {
                                match (encs) {
                                    value::JsonValue::Array(arr) => {
                                        for (mut i: u64 = 0; i < arr.length(); i++) {
                                            match (arr.get_ref(i)) {
                                                Option::Some(e) => {
                                                    match (e.as::<str::Str>()) {
                                                        Option::Some(s) => {
                                                            if (s.equals(&str::Str::from("utf-8"))) {
                                                                return true;
                                                            }
                                                        }
                                                        Option::None => { }
                                                    }
                                                }
                                                Option::None => { }
                                            }
                                        }
                                        return false;
                                    }
                                    _ => { return false; }
                                }
                            }
                            Option::None => { return false; }
                        }
                    }
                    Option::None => { return false; }
                }
            }
            Option::None => { return false; }
        }
    }

    /// Build the `InitializeResult` payload.  Only what we actually
    /// support today - adding a feature should grow this object, not a
    /// separate registration step.
    static build_initialize_result(advertise_utf8: boolean) -> value::JsonValue {
        mut caps: value::JsonObject = value::JsonObject::new();

        // positionEncoding: only advertised when the client offered `utf-8`
        // (see `client_offers_utf8`).  Advertising it unconditionally would
        // break clients that speak only UTF-16, so the field is omitted in
        // that case and the connection falls back to the UTF-16 default.
        if (advertise_utf8) {
            caps.put("positionEncoding", value::JsonValue::from("utf-8"));
        }

        // textDocumentSync: open/close, change 1 = Full (`did_change` takes
        // the last `contentChanges` entry as the whole document), and save,
        // which is what runs an analysis.  Advertising Incremental (2)
        // without applying ranges to the stored buffer would discard every
        // edit but the last one's snippet.
        mut sync: value::JsonObject = value::JsonObject::new();
        sync.put("openClose", value::JsonValue::Bool(true));
        sync.put("change", value::JsonValue::int_value(1 as i64));
        mut save: value::JsonObject = value::JsonObject::new();
        save.put("includeText", value::JsonValue::Bool(false));
        sync.put("save", value::JsonValue::Object(save));
        caps.put("textDocumentSync", value::JsonValue::Object(sync));

        caps.put("hoverProvider", value::JsonValue::Bool(true));
        caps.put("definitionProvider", value::JsonValue::Bool(true));
        caps.put("referencesProvider", value::JsonValue::Bool(true));
        caps.put("documentHighlightProvider", value::JsonValue::Bool(true));
        caps.put("documentSymbolProvider", value::JsonValue::Bool(true));
        caps.put("workspaceSymbolProvider", value::JsonValue::Bool(true));
        // Rename, with a prepare step that refuses before a name is typed.
        mut rename_opts: value::JsonObject = value::JsonObject::new();
        rename_opts.put("prepareProvider", value::JsonValue::Bool(true));
        caps.put("renameProvider", value::JsonValue::Object(rename_opts));

        // Completion: trigger on `.` and `:` (member access + scope
        // resolution).  Both are entered in Phase C; advertised here so
        // editors enable the keystroke handler.
        mut completion: value::JsonObject = value::JsonObject::new();
        mut triggers: Array<value::JsonValue> = Array::<value::JsonValue>::with_capacity(2);
        triggers.push(value::JsonValue::from("."));
        triggers.push(value::JsonValue::from(":"));
        completion.put("triggerCharacters", value::JsonValue::Array(triggers));
        caps.put("completionProvider", value::JsonValue::Object(completion));

        // Semantic tokens: full-document only.  Legend (token types +
        // modifiers) lives in `lsp::protocol::semantic_tokens`; the indexes
        // emitted by the handler must match the order declared there.
        caps.put("semanticTokensProvider",
                 semantic_tokens::SemanticTokensCodec::provider_capability());

        // Code actions: every diagnostic gets a "Show full Cryo
        // diagnostic" lightbulb item; clicking it fires the
        // `cryo.openRenderedDiagnostic` client-side command that opens
        // a `cryo-diagnostic:` virtual document containing the rendered
        // report.  Boolean form advertises support without a kind
        // filter - the handler decides per-diagnostic whether to emit.
        caps.put("codeActionProvider", value::JsonValue::Bool(true));

        // Code lenses: render an inline "Show full diagnostic" link
        // above every diagnostic line.  Same destination as the code
        // action, just always visible - no Ctrl+. needed.
        // `resolveProvider: false` keeps the lens fully populated up
        // front; no separate `codeLens/resolve` round-trip.
        mut code_lens: value::JsonObject = value::JsonObject::new();
        code_lens.put("resolveProvider", value::JsonValue::Bool(false));
        caps.put("codeLensProvider", value::JsonValue::Object(code_lens));

        mut result: value::JsonObject = value::JsonObject::new();
        result.put("capabilities", value::JsonValue::Object(caps));

        // serverInfo block. The version is not decoration: CryoAnalyzer
        // compares it against its own and warns when they differ, which is
        // how a stale `cryolsp` picked up from $PATH ahead of a freshly
        // built one gets noticed. It must therefore track the release
        // version, in step with `tools/CryoAnalyzer/package.json`.
        mut info: value::JsonObject = value::JsonObject::new();
        info.put("name", value::JsonValue::from("cryolsp"));
        info.put("version", value::JsonValue::from("1.0.0"));
        result.put("serverInfo", value::JsonValue::Object(info));

        return value::JsonValue::Object(result);
    }
}
