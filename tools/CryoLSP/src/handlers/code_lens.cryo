///! `textDocument/codeLens`: a clickable "Show full diagnostic" link
///! that VS Code renders directly above every diagnostic line.
///!
///! Unlike code actions (which the user has to invoke via Ctrl+. or
///! the lightbulb), code lenses are always visible - no keybind, no
///! menu.  Each lens fires the same `cryo.openRenderedDiagnostic`
///! client-side command the code action does, so both paths funnel
///! into the same `cryo-diagnostic:` virtual document.
///!
///! Source of truth is the live compilation context attached to the
///! URI's session: walk its diagnostic sink, filter to entries whose
///! `span.file` matches this URI, and emit one lens per match.  No
///! caching beyond what already lives in the sink - the diag-render
///! cache is queried separately, by id, when the user actually opens
///! the virtual doc.

namespace lsp::handlers::code_lens;

import std::core::option;
import std::core::mem;
import std::collections::str;
import std::collections::string;
import std::collections::string::{ String };
import std::collections::array;
import std::collections::array::{ Array };
import std::json::value;

import compiler::compilation_context;
import compiler::diag::diagnostic;
import compiler::diag::source_span;
import compiler::ast;
import compiler::ast::node;
import compiler::ast::declaration;
import compiler::ast::node_locator;
import compiler::resolver::res::{ DefId, ResSlot };
import compiler::module_graph;

import lsp::server::session;
import lsp::server::docs;
import lsp::protocol::conv;
import lsp::protocol::lsp;
import std::fmt;


/// Handle a `textDocument/codeLens` request and return the JSON
/// array to put in the response's `result` field.  An empty array
/// (no session, no compile, no diagnostics for this URI) is a valid
/// non-result.
public function handle_code_lens(docs: mut &docs::Docs, projects: mut &session::Projects,
                                  params: &value::JsonValue) -> value::JsonValue {
    mut lenses: Array<value::JsonValue> = Array::<value::JsonValue>::new();

    // params.textDocument.uri  -> the document we're lensing
    const uri: String = CodeLensBuilder::uri_from_params(params);
    if (uri.length() == 0) {
        return value::JsonValue::Array(lenses);
    }

    const ctx: compilation_context::CompilationContext* = projects.analysis_for(docs, uri.as_str());
    if (ctx == null) {
        return value::JsonValue::Array(lenses);
    }

    // Filter to diagnostics whose span belongs to this URI - the
    // session's sink may carry cross-module diagnostics from compile
    // dependencies, and emitting a lens against the wrong file would
    // surface it on whatever line happens to share coordinates here.
    mut fs_path_owned: String = conv::UriPath::uri_to_fs_path(uri.as_str());
    const fs_path: str::Str = fs_path_owned.as_str();
    const diags: &[diagnostic::Diagnostic] = &ctx.diagnostics.diagnostics;
    for (mut i: i64 = 0; i < diags.length(); i++) {
        if (!conv::DiagnosticConverter::diag_is_for_path(&diags[i], fs_path)) { continue; }
        if (!diags[i].span.has_location())               { continue; }
        mut id: String = conv::DiagnosticConverter::build_diag_id(&diags[i]);
        lenses.push(CodeLensBuilder::build_lens(docs, &diags[i], id.as_str()));
        mem::drop(id);
    }
    mem::drop(fs_path_owned);

    // Second producer: an "N implementations" lens above every type and
    // trait declaration in this document, counting impl blocks across the
    // whole module graph.  Clicking it opens a reference peek listing each
    // implementation (client command `cryo.showImplementations`).
    ImplLensBuilder::append_impl_lenses(&lenses, ctx, uri.as_str(), docs);

    return value::JsonValue::Array(lenses);
}


// ImplLensBuilder - "N implementations" lenses above type / trait decls.
//
// For each top-level struct / enum / union / trait in the
// document, count the impl blocks targeting it (types) or implementing
// it (traits) across the module graph, and emit a code lens whose
// command opens a VS Code reference peek over the implementation sites.

type struct ImplLensBuilder {

    /// Append one lens per implementable declaration in `uri`'s module.
    /// No-op when the module isn't in the graph (single-file fallback for
    /// a URI outside the project) or carries no type/trait decls.
    static append_impl_lenses(lenses: mut &Array<value::JsonValue>,
                               ctx: compilation_context::CompilationContext*, uri: str::Str,
                               positions: &docs::Docs) -> void {
        if (ctx == null || ctx.module_graph == null) { return; }
        const ast: node::ProgramNode* = ImplLensBuilder::module_ast_for_uri(ctx, uri);
        if (ast == null) { return; }

        for (mut si: i64 = 0; si < ast.statements.length(); si++) {
            const item: node::Node = node_locator::NodeLocator::unwrap_decl_stmt(ast.statements[si]);
            const stmt: declaration::DeclarationNode* = item.as_decl();
            if (stmt == null || stmt.generated) { continue; }

            // Which declarations get a lens: a type, by the implementations
            // targeting it, and a trait, by the implementations of it.
            mut def: DefId = DefId::invalid();
            mut is_trait: boolean = false;
            const sd: declaration::StructDecl* = declaration::DeclarationNode::struct_of(stmt);
            if (sd != null) { def = sd.def; }
            const en: declaration::EnumDecl* = declaration::DeclarationNode::enum_of(stmt);
            if (en != null) { def = en.def; }
            const tr: declaration::TraitDecl* = declaration::DeclarationNode::trait_of(stmt);
            if (tr != null) { def = tr.def; is_trait = true; }
            const un: declaration::UnionDecl* = declaration::DeclarationNode::union_of(stmt);
            if (un != null) { def = un.def; }
            if (!def.is_valid()) { continue; }

            const spans: [source_span::SourceSpan] = ImplLensBuilder::impls_of(ctx, def, is_trait);
            if (spans.length() == 0) { continue; }

            const name_span: source_span::SourceSpan = node_locator::name_span_of(item);
            if (!name_span.has_location()) { continue; }

            lenses.push(ImplLensBuilder::build_impl_lens(positions, uri, name_span, &spans));
        }
    }

    /// Where each implementation of `def` is written: the blocks whose
    /// target the name layer stamped with `def`, or for a trait, whose
    /// trait it stamped with `def`.  A block copied into another module
    /// keeps its template's spans and is counted where it is written; a
    /// block the compiler wrote is written nowhere.
    static impls_of(ctx: compilation_context::CompilationContext*, def: DefId,
                    is_trait: boolean) -> [source_span::SourceSpan] {
        mut spans: [source_span::SourceSpan] = [];
        const n: u32 = ctx.module_graph.module_count();
        for (mut mi: u32 = 0; mi < n; mi++) {
            const prog: node::ProgramNode* = ctx.module_graph.get_module_ast(mi);
            if (prog == null) { continue; }
            const file: string = ctx.module_graph.modules[mi as i64].file_path;
            for (mut si: i64 = 0; si < prog.statements.length(); si++) {
                const stmt: declaration::DeclarationNode* = node_locator::NodeLocator::unwrap_decl_stmt(prog.statements[si]).as_decl();
                if (stmt == null || stmt.generated || declaration::DeclarationNode::impl_of(stmt) == null) { continue; }
                if (stmt.span.file == null || !stmt.span.file.eq(file)) { continue; }
                const ib: declaration::ImplBlock* = declaration::DeclarationNode::impl_of(stmt);
                const named: DefId = if (is_trait) {
                    ImplLensBuilder::annotation_def(ib.trait_annotation)
                } else {
                    ImplLensBuilder::slot_def(&ib.res)
                };
                if (!named.equals(def)) { continue; }
                spans.push(if (ib.target_type_span.has_location()) { ib.target_type_span } else { stmt.span });
            }
        }
        return spans;
    }

    /// The definition a type annotation's head names: `Iterator` in
    /// `Iterator<T>`; invalid for any other shape.
    static annotation_def(ann: ast::TypeAnnotation*) -> DefId {
        if (ann == null) { return DefId::invalid(); }
        return match (*ann) {
            ast::TypeAnnotation::Named(n)   => { ImplLensBuilder::slot_def(&n.res) }
            ast::TypeAnnotation::Generic(g) => { ImplLensBuilder::annotation_def(g.base) }
            _                               => { DefId::invalid() }
        };
    }

    static slot_def(slot: &ResSlot) -> DefId {
        return match (slot) {
            ResSlot::Answered(r) => { r.def_id() }
            _                    => { DefId::invalid() }
        };
    }

    /// Resolve `uri` to its parsed `ProgramNode`, or null when the file
    /// isn't loaded in the graph.  Mirrors the NUL-terminated path dance
    /// in `definition.cryo` (`find_module_by_path` wants a C string, but
    /// `Str` isn't NUL-terminated).
    static module_ast_for_uri(ctx: compilation_context::CompilationContext*, uri: str::Str) -> node::ProgramNode* {
        mut fs_path_owned: String = conv::UriPath::uri_to_fs_path(uri);
        const fs_path: str::Str = fs_path_owned.as_str();
        mut path_buf: String = String::with_capacity(fs_path.length() + 1);
        path_buf.push(fs_path);
        path_buf.push_byte(0 as u8);
        mem::drop(fs_path_owned);
        const path_buf_len: u64 = path_buf.length() - 1;
        path_buf.truncate(path_buf_len);
        const path_cstr: string = path_buf.as_ptr() as string;

        const mod_idx: i64 = ctx.module_graph.find_module_by_path(path_cstr);
        mem::drop(path_buf);
        if (mod_idx < 0) { return null; }
        return ctx.module_graph.get_module_ast(mod_idx as u32);
    }

    /// Build one `{ range, command }` lens.  `range` is the declaration's
    /// name span; the command fires `cryo.showImplementations` with
    /// `[anchorUri, anchorPosition, locations]` so the client extension
    /// can hand them to VS Code's `editor.action.showReferences` peek.
    static build_impl_lens(positions: &docs::Docs, uri: str::Str, name_span: source_span::SourceSpan,
                            spans: &[source_span::SourceSpan]) -> value::JsonValue {
        const count: i64 = spans.length();

        // command.arguments[2] = [ Location, ... ]
        mut locs: Array<value::JsonValue> = Array::<value::JsonValue>::with_capacity(count as u64);
        for (mut i: i64 = 0; i < spans.length(); i++) {
            locs.push(ImplLensBuilder::location_json(positions, spans[i]));
        }

        // command.arguments = [ anchorUri, anchorPosition, locations ]: the
        // anchor is where the reference peek opens, the name's start.
        const name_range: lsp::Range = positions.range_of_span(name_span);
        mut args: Array<value::JsonValue> = Array::<value::JsonValue>::with_capacity(3);
        args.push(value::JsonValue::from(uri));
        args.push(name_range.start.to_json());
        args.push(value::JsonValue::Array(locs));

        const title: string = if (count == 1) {
            "1 implementation"
        } else {
            fmt::format("%d implementations", count as i32)
        };

        mut cmd: value::JsonObject = value::JsonObject::new();
        cmd.put("title", value::JsonValue::from(title));
        cmd.put("command", value::JsonValue::from("cryo.showImplementations"));
        cmd.put("arguments", value::JsonValue::Array(args));

        mut lens: value::JsonObject = value::JsonObject::new();
        lens.put("range", name_range.to_json());
        lens.put("command", value::JsonValue::Object(cmd));
        return value::JsonValue::Object(lens);
    }

    /// LSP `Location` JSON (`{ uri, range }`) for an implementation site.
    static location_json(positions: &docs::Docs, span: source_span::SourceSpan) -> value::JsonValue {
        mut loc: value::JsonObject = value::JsonObject::new();
        loc.put("uri",   value::JsonValue::String(conv::UriPath::uri_string_from_fs_path(span.file)));
        loc.put("range", conv::DiagnosticConverter::range_json_from_span(positions, span));
        return value::JsonValue::Object(loc);
    }
}


// CodeLensBuilder - extract request fields + build CodeLens JSON.

type struct CodeLensBuilder {

    /// Extract `params.textDocument.uri` as an owned `String`.  Returns
    /// an empty string when the field is missing or wrong-typed - the
    /// caller then short-circuits to an empty lens array.
    static uri_from_params(params: &value::JsonValue) -> String {
        match (params.get(str::Str::from("textDocument"))) {
            Option::Some(td) => {
                match (td.get(str::Str::from("uri"))) {
                    Option::Some(uri_v) => {
                        match (uri_v.as::<str::Str>()) {
                            Option::Some(s) => { return String::from_str(s); }
                            Option::None    => { return String::new(); }
                        }
                    }
                    Option::None => { return String::new(); }
                }
            }
            Option::None => { return String::new(); }
        }
    }

    /// Build one CodeLens JSON object - `{ range, command }`.  The
    /// `range` is the diagnostic's primary span; the `command` fires
    /// the client-side `cryo.openRenderedDiagnostic` with the
    /// diagnostic id as a single argument.
    static build_lens(positions: &docs::Docs, diag: &diagnostic::Diagnostic, id: str::Str) -> value::JsonValue {
        const title:  string = "Show full diagnostic";
        const cmd_id: string = "cryo.openRenderedDiagnostic";

        // command.arguments = ["<diagId>"]
        mut args: Array<value::JsonValue> = Array::<value::JsonValue>::with_capacity(1);
        args.push(value::JsonValue::from(id));

        mut cmd: value::JsonObject = value::JsonObject::new();
        cmd.put("title", value::JsonValue::from(title));
        cmd.put("command", value::JsonValue::from(cmd_id));
        cmd.put("arguments", value::JsonValue::Array(args));

        mut lens: value::JsonObject = value::JsonObject::new();
        lens.put("range", conv::DiagnosticConverter::range_json_from_span(positions, diag.span));
        lens.put("command", value::JsonValue::Object(cmd));
        return value::JsonValue::Object(lens);
    }
}
