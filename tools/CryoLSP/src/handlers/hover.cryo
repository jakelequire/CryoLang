///! Hover.
///!
///! The target at the position (`identity`) shown as the declaration it
///! names - a signature, a type's head, a binding with its type - followed
///! by the declaration's doc comment.  A position with no target falls to
///! the keyword table; anything else answers `null`.
namespace lsp::handlers::hover;

import std::core::option;
import std::core::mem;
import std::collections::str;
import std::collections::string;
import std::collections::string::{ String };
import std::json::value;
import std::ffi::libc;

import compiler::compilation_context::{ CompilationContext };
import compiler::ast::{ NodeKind };
import compiler::ast::node::{ ASTNode };
import compiler::ast::declaration::{
    ClassDeclNode, DeclarationNode, EnumDeclNode, FieldDeclNode, FunctionDeclNode,
    IntrinsicDeclNode, MethodNode, StructDeclNode, UnionDeclNode, VarDeclNode
};
import compiler::resolver::res::{ DefId, DefKind };
import compiler::resolver::symbol::{ Symbol, SymbolKind };
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::types::type_ref::{ TypeRef };

import lsp::handlers::identity::{ Answer, Asked, Target };
import lsp::handlers::keyword_docs;
import lsp::server::docs;
import lsp::server::session;
import lsp::protocol::lsp;


/// `textDocument/hover`.
public function handle_hover(docs: mut &docs::Docs, projects: mut &session::Projects,
                              params: &value::JsonValue) -> value::JsonValue {
    const asked: Asked = Asked::from(docs, projects, params);
    if (asked.ctx != null && !asked.answer.target.is_nothing()) {
        mut shown: Shown = Shown::new(asked.ctx);
        shown.answer(&asked.answer);
        if (shown.text.length() > 0) {
            return shown.reply(docs, &asked.answer);
        }
    }
    match (docs.get(asked.uri)) {
        Option::Some(doc) => {
            match (keyword_docs::try_keyword_hover(docs, doc, asked.line, asked.character)) {
                Option::Some(json) => { return json; }
                Option::None       => { }
            }
        }
        Option::None => { }
    }
    return value::JsonValue::Null;
}

/// `cryo/expandHover`, the editor's request for a longer hover: the same
/// answer.
public function handle_hover_verbose(docs: mut &docs::Docs, projects: mut &session::Projects,
                                      params: &value::JsonValue) -> value::JsonValue {
    return handle_hover(docs, projects, params);
}


/// A target shown as text: one line of Cryo, and the doc comment of the
/// declaration it names.
type struct Shown {
    ctx:  CompilationContext*;
    text: string;
    doc:  string;

    static new(ctx: CompilationContext*) -> Shown {
        return Shown { ctx: ctx, text: "", doc: "" };
    }

    answer(mut &this, a: &Answer) -> void {
        match (&a.target) {
            Target::Def(d) => {
                if (a.receiver) {
                    this.text = "this: " + this.type_text(a.ty);
                    return;
                }
                this.def(d);
            }
            Target::Local(s)      => { this.local(s, a.ty); }
            Target::TypeParam(s)  => {
                this.text = "type parameter " + this.ctx.intern_table.resolve(this.ctx.resolver.get_symbol(s).name);
            }
            Target::Prim(p)       => { this.text = this.ctx.intern_table.resolve(p); }
            Target::Field(o, i)   => { this.field(o, i); }
            Target::Variant(o, i) => { this.variant(o, i); }
            Target::Nothing       => { }
        }
    }

    path(&this, d: DefId) -> string {
        return this.ctx.intern_table.shown(this.ctx.defs.path_of(d));
    }

    type_text(&this, ty: TypeRef) -> string {
        if (!ty.is_valid()) { return "?"; }
        return this.ctx.type_arena.resolve_display_name(ty);
    }

    def(mut &this, d: DefId) -> void {
        if (this.ctx.defs.kind_of(d) == DefKind::Module) {
            this.text = "module " + this.path(d);
            return;
        }
        const decl: ASTNode* = this.ctx.decl_index.declaration_of(d);
        if (decl == null) {
            this.text = this.path(d);
            return;
        }
        this.doc = (decl as DeclarationNode*).documentation;
        match (decl.kind) {
            NodeKind::FunctionDeclaration => { this.text = this.signature(d, decl as FunctionDeclNode*, false); }
            NodeKind::MethodDeclaration => {
                const m: MethodNode* = decl as MethodNode*;
                if (m.func != null) {
                    this.text = this.signature(d, m.func, m.is_static);
                    if (this.doc.length() == 0) { this.doc = m.func.documentation; }
                }
            }
            NodeKind::IntrinsicDeclaration => {
                const f: IntrinsicDeclNode* = decl as IntrinsicDeclNode*;
                this.text = "intrinsic function " + this.path(d) + "(" + this.params(&f.parameters, false)
                    + ") -> " + this.type_text(f.resolved_return_type);
            }
            NodeKind::StructDeclaration    => { this.text = "type struct " + this.path(d); }
            NodeKind::UnionDeclaration     => { this.text = "type union " + this.path(d); }
            NodeKind::ClassDeclaration     => { this.text = "type class " + this.path(d); }
            NodeKind::EnumDeclaration      => { this.text = "type enum " + this.path(d); }
            NodeKind::TraitDeclaration     => { this.text = "type trait " + this.path(d); }
            NodeKind::TypeAliasDeclaration => { this.text = "type " + this.path(d); }
            NodeKind::VariableDeclaration => {
                const v: VarDeclNode* = decl as VarDeclNode*;
                const kw: string = if (v.is_mutable) { "mut " } else { "const " };
                this.text = kw + this.path(d) + ": " + this.type_text(v.resolved_type);
            }
            _ => { this.text = this.path(d); }
        }
    }

    /// `function a::b(x: i32) -> i64`, or for a method `[static]
    /// Owner::m(...)`.
    signature(&this, d: DefId, f: FunctionDeclNode*, is_static: boolean) -> string {
        const is_method: boolean = this.ctx.defs.kind_of(d) == DefKind::Method;
        const head: string = if (is_method) {
            if (is_static) { "static " } else { "" }
        } else { "function " };
        // An instance method's first parameter is its receiver, written
        // `this`, `&this` or `mut &this`, and shown as written.
        const receiver: boolean = is_method && !is_static;
        return head + this.path(d) + "(" + this.params(&f.parameters, receiver) + ") -> "
            + this.type_text(f.resolved_return_type);
    }

    params(&this, ps: &VarDeclNode*[], receiver: boolean) -> string {
        mut out: string = "";
        for (mut i: i64 = 0; i < ps.length; i++) {
            if (i > 0) { out = out + ", "; }
            out = out + this.ctx.intern_table.resolve(ps[i].name);
            if (i > 0 || !receiver) { out = out + ": " + this.type_text(ps[i].resolved_type); }
        }
        return out;
    }

    local(mut &this, s: SymbolID, ty: TypeRef) -> void {
        const sym: Symbol = this.ctx.resolver.get_symbol(s);
        const name: string = this.ctx.intern_table.resolve(sym.name);
        const kw: string = if (sym.kind == SymbolKind::Parameter) {
            ""
        } else {
            if (sym.is_mutable) { "mut " } else { "const " }
        };
        this.text = kw + name + ": " + this.type_text(ty);
    }

    field(mut &this, owner: DefId, index: i64) -> void {
        const decl: ASTNode* = this.ctx.decl_index.declaration_of(owner);
        if (decl == null || index < 0) { return; }
        mut fd: FieldDeclNode* = null;
        if (decl.kind == NodeKind::StructDeclaration) {
            const sd: StructDeclNode* = decl as StructDeclNode*;
            if (index < sd.fields.length) { fd = sd.fields[index]; }
        } else if (decl.kind == NodeKind::ClassDeclaration) {
            const cd: ClassDeclNode* = decl as ClassDeclNode*;
            if (index < cd.fields.length) { fd = cd.fields[index]; }
        } else if (decl.kind == NodeKind::UnionDeclaration) {
            const ud: UnionDeclNode* = decl as UnionDeclNode*;
            if (index < ud.fields.length) { fd = ud.fields[index]; }
        }
        if (fd == null) { return; }
        this.text = "field " + this.path(owner) + "::" + this.ctx.intern_table.resolve(fd.name)
            + ": " + this.type_text(fd.resolved_type);
        this.doc = fd.documentation;
    }

    variant(mut &this, owner: DefId, ordinal: i64) -> void {
        const decl: ASTNode* = this.ctx.decl_index.declaration_of(owner);
        if (decl == null || decl.kind != NodeKind::EnumDeclaration || ordinal < 0) { return; }
        const ed: EnumDeclNode* = decl as EnumDeclNode*;
        if (ordinal >= ed.variants.length) { return; }
        this.text = this.path(owner) + "::" + this.ctx.intern_table.resolve(ed.variants[ordinal].name);
        this.doc = ed.variants[ordinal].documentation;
    }

    /// The hover reply: the text in a Cryo block, then the doc comment.
    reply(&this, docs: &docs::Docs, a: &Answer) -> value::JsonValue {
        mut body: String = String::with_capacity(64);
        body.push("```cryo\n");
        body.push(this.text);
        body.push("\n```");
        const doc: string = Shown::clean_doc(this.doc);
        if (doc.length() > 0) {
            body.push("\n\n");
            body.push(doc);
        }
        const hover: lsp::Hover = lsp::Hover {
            contents: lsp::MarkupContent::markdown(body),
            range:    Option::Some(docs.range_of_span(a.span)),
        };
        const result: value::JsonValue = hover.to_json();
        mut h: lsp::Hover = hover;
        mem::drop(h);
        return result;
    }

    /// A doc comment as markdown: each line's `///`, `///!`, `/**`, `*`
    /// or `*/` marker and one following space removed, trailing blanks
    /// trimmed.
    static clean_doc(raw: string) -> string {
        if (raw == null) { return ""; }
        const len: i64 = libc::strlen(raw) as i64;
        if (len == 0) { return ""; }
        const buf: i8* = libc::malloc((len + 1) as u64) as i8*;
        mut out: i64 = 0;
        mut i:   i64 = 0;
        while (i < len) {
            while (i < len && (raw[i] == ' ' as i8 || raw[i] == '\t' as i8)) { i = i + 1; }
            if (i + 3 < len && raw[i] == '/' as i8 && raw[i + 1] == '/' as i8
                    && raw[i + 2] == '/' as i8 && raw[i + 3] == '!' as i8) {
                i = i + 4;
            } else if (i + 2 < len && raw[i] == '/' as i8 && raw[i + 1] == '/' as i8
                    && raw[i + 2] == '/' as i8) {
                i = i + 3;
            } else if (i + 2 < len && raw[i] == '/' as i8 && raw[i + 1] == '*' as i8
                    && raw[i + 2] == '*' as i8) {
                i = i + 3;
            } else if (i + 1 < len && raw[i] == '*' as i8 && raw[i + 1] == '/' as i8) {
                i = i + 2;
            } else if (i < len && raw[i] == '*' as i8 && (i + 1 >= len || raw[i + 1] != '*' as i8)) {
                i = i + 1;
            }
            if (i < len && raw[i] == ' ' as i8) { i = i + 1; }
            while (i < len && raw[i] != '\n' as i8) {
                if (i + 1 < len && raw[i] == '*' as i8 && raw[i + 1] == '/' as i8) {
                    i = i + 2;
                    break;
                }
                buf[out] = raw[i] as i8;
                out = out + 1;
                i = i + 1;
            }
            while (out > 0 && (buf[out - 1] == ' ' as i8 || buf[out - 1] == '\t' as i8)) { out = out - 1; }
            if (i < len) {
                buf[out] = '\n' as i8;
                out = out + 1;
                i = i + 1;
            }
        }
        while (out > 0 && buf[out - 1] == '\n' as i8) { out = out - 1; }
        buf[out] = 0 as i8;
        return buf as string;
    }
}
