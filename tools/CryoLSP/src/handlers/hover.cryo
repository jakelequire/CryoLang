///! Hover.
///!
///! The target at the position (`identity`) shown as the declaration it
///! names - a signature, a type's head, a binding with its type - followed
///! by the declaration's doc comment.  A position with no target on an
///! import path's earlier segment shows the path, in a string literal or an
///! f-string the string; elsewhere it falls to the keyword table, and
///! anything else answers `null`.
namespace lsp::handlers::hover;

import std::core::option;
import std::core::mem;
import std::collections::str;
import std::collections::string::{ String };
import std::json::value;
import std::ffi::libc;

import compiler::compilation_context::{ CompilationContext };
import compiler::ast::{ LiteralKind, TypeAnnotation };
import compiler::ast::declaration::{
    DeclarationNode, DeclKind, EnumVariant, FieldDecl, FunctionDecl,
    ImportDecl, MethodDecl, VarDecl
};
import compiler::module_graph::{ ModulePath };
import compiler::ast::expression::{
    CallExpr, ExpressionNode, IdentifierExpr, LiteralExpr, UnaryExpr
};
import compiler::ast::node::{ Node };
import compiler::ast::pattern::{ DirectiveNode };
import compiler::ast::node_locator;
import compiler::ast::walk::{ Walk };
import compiler::resolver::lang_item::{ LangItem };
import compiler::resolver::res::{ DeclVisibility, DefId, DefKind, Res, ResSlot };
import compiler::resolver::symbol::{ Symbol, SymbolKind };
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::types::type_ref::{ TypeRef };

import lsp::handlers::definition::{ Declared };
import lsp::handlers::identity::{ Answer, Asked, Locator, Target };
import lsp::handlers::keyword_docs;
import lsp::handlers::members::{ Member, Members };
import lsp::handlers::names::{ Names };
import lsp::server::docs;
import lsp::server::line_index::{ Columns };
import lsp::server::session;
import lsp::protocol::lsp;


/// `textDocument/hover`.
public function handle_hover(docs: mut &docs::Docs, projects: mut &session::Projects,
                              params: &value::JsonValue) -> value::JsonValue {
    return Shown::hover(docs, projects, params, false);
}

/// `cryo/expandHover`, the editor's request for a longer hover: a type's
/// hover lists its members.
public function handle_hover_verbose(docs: mut &docs::Docs, projects: mut &session::Projects,
                                      params: &value::JsonValue) -> value::JsonValue {
    return Shown::hover(docs, projects, params, true);
}


/// A target shown as text: one line of Cryo, under the directives written
/// above the declaration it names, and that declaration's doc comment.
type struct Shown {
    ctx:   CompilationContext*;
    text:  string;
    /// `![...]` lines, one per directive, each ending in a newline.
    directives: string;
    doc:   string;
    /// How paths and types are written: as the cursor's scope writes them,
    /// or in full.
    names: Names;

    static new(names: Names) -> Shown {
        return Shown { ctx: names.ctx, text: "", directives: "", doc: "", names: names };
    }

    /// The hover at the request's position; `expanded`, a type's members
    /// listed under it.
    static hover(docs: mut &docs::Docs, projects: mut &session::Projects,
                 params: &value::JsonValue, expanded: boolean) -> value::JsonValue {
        const asked: Asked = Asked::from(docs, projects, params);
        if (asked.ctx != null && !asked.answer.target.is_nothing()) {
            // The expanded hover writes every path in full.
            const names: Names = if (expanded) {
                Names::full(asked.ctx)
            } else {
                Names::in_module(asked.ctx, asked.module_idx, asked.cursor.line, asked.cursor.col)
            };
            mut shown: Shown = Shown::new(names);
            shown.answer(&asked.answer);
            if (expanded && !asked.answer.receiver) {
                match (&asked.answer.target) {
                    Target::Def(d) => {
                        if (asked.ctx.defs.kind_of(d) == DefKind::Type) { shown.members(d); }
                    }
                    _ => { }
                }
            }
            if (shown.text.length() > 0) {
                return shown.reply(docs, &asked.answer);
            }
        }
        match (docs.get(asked.uri)) {
            Option::Some(doc) => {
                if (asked.ctx != null && asked.module_idx >= 0 && asked.cursor.line > 0) {
                    mut shown: Shown = Shown::new(
                        Names::in_module(asked.ctx, asked.module_idx, asked.cursor.line, asked.cursor.col));
                    const path: Answer = shown.import_prefix(&asked);
                    if (shown.text.length() > 0) { return shown.reply(docs, &path); }
                    const at: Answer = shown.string_at(doc, &asked);
                    if (shown.text.length() > 0) { return shown.reply(docs, &at); }
                }
                match (keyword_docs::try_keyword_hover(docs, doc, asked.line, asked.character)) {
                    Option::Some(json) => { return json; }
                    Option::None       => { }
                }
            }
            Option::None => { }
        }
        return value::JsonValue::Null;
    }

    answer(mut &this, a: &Answer) -> void {
        match (&a.target) {
            Target::Def(d) => {
                if (a.receiver) {
                    this.text = "this: " + this.type_text(a.ty);
                    return;
                }
                this.def(d);
            }
            Target::Local(s)      => { this.local(s, a.ty); }
            Target::TypeParam(s)  => {
                this.text = "type parameter " + this.ctx.intern_table.resolve(this.ctx.resolver.get_symbol(s).name);
            }
            Target::Prim(p)       => { this.text = this.ctx.intern_table.resolve(p); }
            Target::Field(o, i)   => { this.field(o, i); }
            Target::Variant(o, i) => { this.variant(o, i); }
            Target::Nothing       => { }
        }
    }

    path(&this, d: DefId) -> string {
        return this.names.def_path(d);
    }

    type_text(&this, ty: TypeRef) -> string {
        return this.names.type_text(ty);
    }

    type_text_written(&this, ty: TypeRef, ann: TypeAnnotation*) -> string {
        return this.names.type_text_written(ty, ann);
    }

    def(mut &this, d: DefId) -> void {
        if (this.ctx.defs.kind_of(d) == DefKind::Module) {
            this.text = "module " + this.path(d);
            return;
        }
        const decl: DeclarationNode* = this.ctx.decl_index.declaration_of(d);
        if (decl == null) {
            this.text = this.path(d);
            return;
        }
        this.doc = decl.documentation;
        this.show_directives(&decl.attached_directives);
        // How far the definition reaches, as its registration recorded it:
        // what is written, or the default where nothing is.  A method's is
        // its declaration's, which its owner's scope declares it with.
        const reach: string = match (this.ctx.defs.visibility_of(d)) {
            DeclVisibility::Unrecorded => { "" }
            DeclVisibility::Public     => { "public " }
            DeclVisibility::Internal   => { "internal " }
            DeclVisibility::Private    => { "private " }
        };
        match (decl.kind) {
            DeclKind::Method(m) => {
                if (m.func != null) {
                    this.text = m.visibility.label() + " " + this.signature(d, m.func, m.is_static);
                    if (this.doc.length() == 0) { this.doc = m.func.documentation; }
                }
            }
            DeclKind::Function(_) => { this.text = reach + this.signature(d, decl, false); }
            DeclKind::Intrinsic(f) => {
                this.text = reach + "intrinsic function " + this.path(d) + "("
                    + this.params(&f.parameters, false, f.is_variadic) + ") -> "
                    + this.type_text(f.resolved_return_type);
            }
            DeclKind::TypeAlias(_) => { this.text = reach + "type " + this.path(d); }
            DeclKind::Enum(_)      => { this.text = reach + "type enum " + this.path(d); }
            DeclKind::Trait(_)     => { this.text = reach + "type trait " + this.path(d); }
            DeclKind::Union(_)     => { this.text = reach + "type union " + this.path(d); }
            DeclKind::Struct(_)    => { this.text = reach + "type struct " + this.path(d); }
            DeclKind::Variable(v)  => {
                const kw: string = if (v.is_mutable) { "mut " } else { "const " };
                this.text = reach + kw + this.path(d) + ": "
                    + this.names.type_text_written(v.resolved_type, v.type_annotation);
            }
            DeclKind::Import(_) | DeclKind::Module(_) | DeclKind::Impl(_)
            | DeclKind::Variant(_) | DeclKind::Extern(_) | DeclKind::Destructure(_)
            | DeclKind::Field(_) | DeclKind::GenericParam(_) => {
                this.text = this.path(d);
            }
        }
    }

    /// One `![...]` line per directive written on the declaration, but for
    /// those that tell its user nothing: `language`, which names the
    /// declaration to the compiler.
    show_directives(mut &this, written: &[DirectiveNode*]) -> void {
        for (mut i: i64 = 0; i < written.length(); i++) {
            const hidden: boolean = match (written[i].directive_kind.as_string()) {
                "language" => { true }
                _          => { false }
            };
            if (hidden) { continue; }
            this.directives = this.directives + "![" + written[i].to_text() + "]\n";
        }
    }

    /// `function a::b(x: i32) -> i64`, or for a method `[static]
    /// Owner::m(...)`.
    signature(&this, d: DefId, f_decl: DeclarationNode*, is_static: boolean) -> string {
        const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
        const is_method: boolean = this.ctx.defs.kind_of(d) == DefKind::Method;
        const head: string = if (is_method) {
            if (is_static) { "static " } else { "" }
        } else { "function " };
        // An instance method's first parameter is its receiver, written
        // `this`, `&this` or `mut &this`, and shown as written.
        const receiver: boolean = is_method && !is_static;
        return head + this.path(d) + "(" + this.params(&f.parameters, receiver, f.is_variadic) + ") -> "
            + this.names.type_text_written(f.resolved_return_type, f.return_type_annotation);
    }

    /// The parameters as written.  A `variadic` function's last parameter
    /// written with no type is its named rest (`args...`); with none, the
    /// rest is a bare `...`.
    params(&this, ps: &[DeclarationNode*], receiver: boolean, variadic: boolean) -> string {
        mut out: string = "";
        mut named_rest: boolean = false;
        for (mut i: i64 = 0; i < ps.length(); i++) {
            if (i > 0) { out = out + ", "; }
            const p: VarDecl* = DeclarationNode::var_of(ps[i]);
            // The receiver's name is its spelling (`&this`, `this`); a
            // `mut` written before it is the parameter's mutability.
            if (i == 0 && receiver && p.is_mutable) { out = out + "mut "; }
            out = out + this.ctx.intern_table.resolve(p.name);
            if (variadic && i == ps.length() - 1 && p.type_annotation == null) {
                out = out + "...";
                named_rest = true;
            } else if (i > 0 || !receiver) {
                out = out + ": " + this.names.type_text_written(p.resolved_type, p.type_annotation);
            }
        }
        if (variadic && !named_rest) {
            out = if (ps.length() > 0) { out + ", ..." } else { "..." };
        }
        return out;
    }

    local(mut &this, s: SymbolID, ty: TypeRef) -> void {
        const sym: Symbol = this.ctx.resolver.get_symbol(s);
        const name: string = this.ctx.intern_table.resolve(sym.name);
        mut kw: string = "";
        if (Declared::is_pattern_binding(this.ctx, s)) {
            kw = "binding ";
        } else if (sym.kind != SymbolKind::Parameter) {
            kw = if (sym.is_mutable) { "mut " } else { "const " };
        }
        // A binding declared with an annotation shows its type as written.
        const at: DeclarationNode* = Declared::binding_decl(this.ctx, s);
        if (at != null && DeclarationNode::var_of(at) != null) {
            this.text = kw + name + ": "
                + this.names.type_text_written(ty, (DeclarationNode::var_of(at)).type_annotation);
            return;
        }
        this.text = kw + name + ": " + this.type_text(ty);
    }

    field(mut &this, owner: DefId, index: i64) -> void {
        const h: DeclarationNode* = Members::field_decl(this.ctx, owner, index);
        if (h == null) { return; }
        const fd: FieldDecl* = DeclarationNode::field_of(h);
        this.show_directives(&h.attached_directives);
        this.text = fd.visibility.label() + " field " + this.path(owner) + "::" + this.ctx.intern_table.resolve(fd.name)
            + ": " + this.names.type_text_written(fd.resolved_type, fd.type_annotation);
        this.doc = h.documentation;
    }

    variant(mut &this, owner: DefId, ordinal: i64) -> void {
        const v: DeclarationNode* = Members::variant_decl(this.ctx, owner, ordinal);
        if (v == null) { return; }
        this.text = this.path(owner) + "::"
            + this.ctx.intern_table.resolve(DeclarationNode::variant_of(v).name);
        this.doc = v.documentation;
    }

    /// A segment of an import's path before its last - `std` or `core` in
    /// `import std::core::intrinsics;` - as the path written through it and
    /// the modules under that path this module may name, one line each.  A
    /// module is loaded only when something imports it, so the path need
    /// not name a module the analysis holds; nothing when no module is
    /// under it.
    import_prefix(mut &this, asked: &Asked) -> Answer {
        const at: Node? = Locator::node_at(this.ctx, this.ctx.module_graph.get_module_ast(asked.module_idx as u32),
                                          asked.cursor.line, asked.cursor.col);
        if (at.is_none()) { return Answer::nothing(); }
        const d: DeclarationNode* = at.unwrap().as_decl();
        if (d == null) { return Answer::nothing(); }
        const imp: ImportDecl* = match (d.kind) {
            DeclKind::Import(i) => { i }
            _                   => { null }
        };
        if (imp == null) { return Answer::nothing(); }
        mut segment: i64 = -1;
        for (mut k: i64 = 0; k < imp.path_segment_spans.length() - 1; k++) {
            if (node_locator::span_contains(imp.path_segment_spans[k], asked.cursor.line, asked.cursor.col)) {
                segment = k;
            }
        }
        if (segment < 0) { return Answer::nothing(); }
        mut written: String = String::with_capacity(32);
        for (mut k: i64 = 0; k <= segment; k++) {
            if (k > 0) { written.push("::"); }
            written.push(this.ctx.intern_table.resolve(imp.path_segments[k]));
        }
        const shown_path: string = written.into_raw();
        const m: ModulePath = this.ctx.module_graph.module_path_over(
            this.ctx.intern_table.intern(shown_path), this.ctx.intern_table);
        if (!m.is_valid()) { return Answer::nothing(); }
        const from: ModulePath = this.ctx.module_graph.get_module(asked.module_idx).path();
        const subs: [string] = Members::submodules_of(this.ctx, m, from);
        mut out: String = String::from_str(str::Str::from(shown_path));
        for (mut i: i64 = 0; i < subs.length(); i++) {
            out.push("\n    module ");
            out.push(subs[i]);
        }
        this.text = out.into_raw();
        return Answer::of(Target::Nothing, imp.path_segment_spans[segment], TypeRef::invalid());
    }

    /// The string written at the position, as its text in its type: a
    /// literal `string("text")[13]`, its byte count after it; an f-string
    /// `f"{name: string} is {age: i32}" -> String`, each hole's type written
    /// in it and its format spec left out.  The answer is where the string
    /// is written; nothing when no string is, or when the text the analysis
    /// read does not spell it on one line.
    string_at(mut &this, doc: &docs::Document, asked: &Asked) -> Answer {
        const at: Node? = Locator::node_at(this.ctx, this.ctx.module_graph.get_module_ast(asked.module_idx as u32),
                                          asked.cursor.line, asked.cursor.col);
        if (at.is_none()) { return Answer::nothing(); }
        mut under: StringUnder = StringUnder { ctx: this.ctx, line: asked.cursor.line,
                                               col: asked.cursor.col, found: null };
        under.walk_node(at.unwrap());
        const e: ExpressionNode* = under.found;
        if (e == null || e.span.end_line != e.span.start_line) { return Answer::nothing(); }
        const line: str::Str = if (doc.has_snap) {
            doc.snap_line_text(e.span.start_line - 1)
        } else {
            doc.line_text(e.span.start_line - 1)
        };
        const start: i64 = Columns::compiler_to_byte(line, e.span.start_col);
        const end: i64 = Columns::compiler_to_byte(line, e.span.end_col);
        const b: u8* = line.as_ptr();
        if (end - start < 2 || b[end - 1] != '"' as u8) { return Answer::nothing(); }
        mut out: String = String::with_capacity(end - start + 32);
        const literal: LiteralExpr* = ExpressionNode::literal_of(e);
        if (literal != null) {
            out.push(this.type_text(e.resolved_type));
            out.push("(");
            out.push(line.sub_bytes(start, end));
            out.push(")[");
            out.push(literal.byte_length);
            out.push("]");
            this.text = out.into_raw();
            return Answer::of(Target::Nothing, e.span, e.resolved_type);
        }
        // The holes, in the order written: the lowering appends each piece
        // to the lowering of the text before it, so the last hole is the
        // outermost call's.
        mut holes: [ExpressionNode*] = [];
        mut c: CallExpr* = ExpressionNode::call_of(e);
        while (c != null && c.arguments.length() > 0) {
            if (c.arguments.length() >= 2) {
                const reference: UnaryExpr* = ExpressionNode::unary_of(c.arguments[1]);
                if (reference != null) { holes.push(reference.operand); }
            }
            c = ExpressionNode::call_of(c.arguments[0]);
        }
        // Each hole is written back as `{` + its expression's text + its
        // type + `}`, through the `}` that closes it; the text between holes
        // is copied as written.
        mut from: i64 = start;
        for (mut i: i64 = holes.length() - 1; i >= 0; i--) {
            const hole: ExpressionNode* = holes[i];
            if (hole.span.start_line != e.span.start_line || hole.span.end_line != e.span.start_line) {
                return Answer::nothing();
            }
            const hole_start: i64 = Columns::compiler_to_byte(line, hole.span.start_col);
            const hole_end: i64 = Columns::compiler_to_byte(line, hole.span.end_col);
            mut open: i64 = hole_start - 1;
            while (open > from && (b[open] == ' ' as u8 || b[open] == '\t' as u8)) { open = open - 1; }
            mut close: i64 = hole_end;
            while (close < end && b[close] != '}' as u8) { close = close + 1; }
            if (open < from || b[open] != '{' as u8 || close >= end) { return Answer::nothing(); }
            out.push(line.sub_bytes(from, open + 1));
            out.push(line.sub_bytes(hole_start, hole_end));
            out.push(": ");
            out.push(this.type_text(hole.resolved_type));
            out.push("}");
            from = close + 1;
        }
        out.push(line.sub_bytes(from, end));
        out.push(" -> ");
        out.push(this.type_text(e.resolved_type));
        this.text = out.into_raw();
        return Answer::of(Target::Nothing, e.span, e.resolved_type);
    }

    /// The members of the type `d`, one line each, for the extended hover:
    /// a field's name and type, a variant's name, a method's signature.
    members(mut &this, d: DefId) -> void {
        const all: [Member] = Members::of_type(this.ctx, d);
        mut out: String = String::from_str(str::Str::from(this.text));
        for (mut i: i64 = 0; i < all.length(); i++) {
            mut line: Shown = Shown::new(this.names);
            match (&all[i]) {
                Member::Field(o, k) => {
                    const fd: FieldDecl* = DeclarationNode::field_of(Members::field_decl(this.ctx, o, k));
                    if (fd != null) {
                        line.text = this.ctx.intern_table.resolve(fd.name) + ": " + this.type_text(fd.resolved_type);
                    }
                }
                Member::Variant(o, k) => {
                    const v: EnumVariant* = DeclarationNode::variant_of(Members::variant_decl(this.ctx, o, k));
                    if (v != null) { line.text = this.ctx.intern_table.resolve(v.name); }
                }
                Member::Method(m) => {
                    if (DeclarationNode::fn_of(m.func).def.is_valid()) { line.def(DeclarationNode::fn_of(m.func).def); }
                }
                Member::Constant(d) => { line.def(d); }
            }
            if (line.text.length() == 0) { continue; }
            out.push("\n    ");
            out.push(line.text);
        }
        this.text = out.into_raw();
    }

    /// The hover reply: the text in a Cryo block, then the doc comment.
    reply(&this, docs: &docs::Docs, a: &Answer) -> value::JsonValue {
        mut body: String = String::with_capacity(64);
        body.push("```cryo\n");
        body.push(this.directives);
        body.push(this.text);
        body.push("\n```");
        const doc: string = Shown::clean_doc(this.doc);
        if (doc.length() > 0) {
            body.push("\n\n");
            body.push(doc);
        }
        const hover: lsp::Hover = lsp::Hover {
            contents: lsp::MarkupContent::markdown(body),
            range:    Option::Some(docs.range_of_span(a.span)),
        };
        const result: value::JsonValue = hover.to_json();
        mut h: lsp::Hover = hover;
        mem::drop(h);
        return result;
    }

    /// A doc comment as markdown: each line's `///`, `///!`, `/**`, `*`
    /// or `*/` marker and one following space removed, trailing blanks
    /// trimmed.
    static clean_doc(raw: string) -> string {
        if (raw == null) { return ""; }
        const len: i64 = libc::strlen(raw) as i64;
        if (len == 0) { return ""; }
        const buf: i8* = libc::malloc((len + 1) as u64) as i8*;
        mut out: i64 = 0;
        mut i:   i64 = 0;
        while (i < len) {
            while (i < len && (raw[i] == ' ' as i8 || raw[i] == '\t' as i8)) { i = i + 1; }
            if (i + 3 < len && raw[i] == '/' as i8 && raw[i + 1] == '/' as i8
                    && raw[i + 2] == '/' as i8 && raw[i + 3] == '!' as i8) {
                i = i + 4;
            } else if (i + 2 < len && raw[i] == '/' as i8 && raw[i + 1] == '/' as i8
                    && raw[i + 2] == '/' as i8) {
                i = i + 3;
            } else if (i + 2 < len && raw[i] == '/' as i8 && raw[i + 1] == '*' as i8
                    && raw[i + 2] == '*' as i8) {
                i = i + 3;
            } else if (i + 1 < len && raw[i] == '*' as i8 && raw[i + 1] == '/' as i8) {
                i = i + 2;
            } else if (i < len && raw[i] == '*' as i8 && (i + 1 >= len || raw[i + 1] != '*' as i8)) {
                i = i + 1;
            }
            if (i < len && raw[i] == ' ' as i8) { i = i + 1; }
            while (i < len && raw[i] != '\n' as i8) {
                if (i + 1 < len && raw[i] == '*' as i8 && raw[i + 1] == '/' as i8) {
                    i = i + 2;
                    break;
                }
                buf[out] = raw[i] as i8;
                out = out + 1;
                i = i + 1;
            }
            while (out > 0 && (buf[out - 1] == ' ' as i8 || buf[out - 1] == '\t' as i8)) { out = out - 1; }
            if (i < len) {
                buf[out] = '\n' as i8;
                out = out + 1;
                i = i + 1;
            }
        }
        while (out > 0 && buf[out - 1] == '\n' as i8) { out = out - 1; }
        buf[out] = 0 as i8;
        return buf as string;
    }
}


/// The string under a position: the string literal written there, or the
/// f-string whose lowering holds it.  An f-string lowers to a chain of
/// builder calls the compiler wrote, every one at the f-string's span; the
/// first met, the outermost, stands for the f-string.  The walk goes down
/// from the innermost written node holding the position, so a string met
/// later at another span is inside the one before it - an f-string in a
/// hole of another - and is the answer.
type struct StringUnder {
    ctx:   CompilationContext*;
    line:  u32;
    col:   u32;
    found: ExpressionNode*;

    consider(mut &this, e: ExpressionNode*) -> void {
        if (!node_locator::span_contains(e.span, this.line, this.col)) { return; }
        if (this.found != null && this.found.span.start_line == e.span.start_line
                && this.found.span.start_col == e.span.start_col
                && this.found.span.end_line == e.span.end_line
                && this.found.span.end_col == e.span.end_col) {
            return;
        }
        this.found = e;
    }

    /// Whether `call` calls one of the builders an f-string lowers to,
    /// either the ones that build a `String` or the ones that record pieces.
    builds_fstring(&this, call: CallExpr*) -> boolean {
        const id: IdentifierExpr* = ExpressionNode::identifier_of(call.callee);
        if (id == null) { return false; }
        const callee: DefId = match (&id.res) {
            ResSlot::Answered(r) => {
                match (r) { Res::Def(d) => { d } _ => { DefId::invalid() } }
            }
            _ => { DefId::invalid() }
        };
        if (!callee.is_valid()) { return false; }
        const items: [LangItem] = LangItem::all();
        for (mut k: i64 = 0; k < items.length(); k++) {
            const pieces: Option<LangItem> = items[k].pieces_builder();
            if (pieces.is_none()) { continue; }
            if (callee.equals(this.ctx.generic_registry.wellknown(items[k]))
                    || callee.equals(this.ctx.generic_registry.wellknown(pieces.unwrap()))) {
                return true;
            }
        }
        return false;
    }
}

implement trait Walk for struct StringUnder {
    walk_literal(mut &this, e: ExpressionNode*, n: LiteralExpr*) -> void {
        if (!e.generated && n.literal_kind == LiteralKind::String) { this.consider(e); }
    }

    walk_call(mut &this, e: ExpressionNode*, n: CallExpr*) -> void {
        if (e.generated && this.builds_fstring(n)) { this.consider(e); }
        CallExpr::walk_children(n, this);
    }
}
