///! Hover handler.
///!
///! Locates the AST node under the cursor and renders its resolved
///! type as a markdown code block.
///!
///! Steps:
///!   1. Pull `uri` + `position` out of the request params.
///!   2. Look up the URI's `CompilerSession` (recompile already ran
///!      from didOpen / didChange).
///!   3. From the session's `CompilationContext`, find the module
///!      whose `file_path` matches the URI's filesystem path.
///!   4. Walk that module's AST via `compiler::ast::node_locator` to find
///!      the innermost node covering the cursor (1-based on entry).
///!   5. Read the node's `resolved_type` and render it via the type
///!      arena's display formatter.
///!
///! Returns `null` when any step yields no info - no session, no
///! AST, no node at cursor, or no type on that node.  The LSP spec
///! treats `null` as "no hover here", which the editor renders as
///! "no tooltip" (clean fallback).
///!
///! All rendering + AST/graph queries hang off `HoverEngine`, a
///! per-request object holding the compilation pointers (`ctx`, type
///! `arena`, `intern` table, module `graph`).  Formatters and graph
///! walks are `&this` methods; stateless string/AST utilities are
///! `static` methods on the same type.  `handle_hover` is the only free
///! function - it builds one engine per request and drives the dispatch.

namespace Lsp::Handlers::Hover;

import std::core::option;
import std::core::primitives;
import std::collections::str;
import std::collections::string;
import std::json::value;

import compiler::compilation_context;
import compiler::ast;
import compiler::ast::node;
import compiler::ast::expression;
import compiler::ast::statement;
import compiler::ast::declaration;
import compiler::ast::pattern;
import compiler::ast::node_locator;
import compiler::diag::source_span;
import compiler::resolver::resolver;
import compiler::resolver::symbol;
import compiler::resolver::symbol_id;
import compiler::resolver::symbol_str;
import compiler::resolver::intern_table;
import compiler::types::type_ref;
import compiler::types::arena;
import compiler::types;
import compiler::types::type_base;
import compiler::types::compound;
import compiler::types::generic;
import compiler::module_graph;

import Lsp::Server::Docs;
import Lsp::Server::Session;
import Lsp::Server::LineIndex;
import Lsp::Protocol::Lsp;
import Lsp::Protocol::Conv;
import Lsp::Handlers::KeywordDocs;


/// Standard `textDocument/hover` entry point - base (non-verbose) hover.
public function handle_hover(docs: &Docs, sessions: mut &SessionMap,
                              params: &JsonValue) -> JsonValue {
    return handle_hover_ex(docs, sessions, params, false);
}

/// `cryo/expandHover` entry point - the expanded hover the extension
/// requests when the user raises the hover verbosity.  Identical to the
/// base hover except a struct/class type-decl body additionally lists the
/// type's method signatures.
public function handle_hover_verbose(docs: &Docs, sessions: mut &SessionMap,
                                      params: &JsonValue) -> JsonValue {
    return handle_hover_ex(docs, sessions, params, true);
}

public function handle_hover_ex(docs: &Docs, sessions: mut &SessionMap,
                                 params: &JsonValue, verbose: boolean) -> JsonValue {
    // -- Extract URI + 0-based (line, character) from the params ------
    // Use stepwise extraction with early returns; deeply nested
    // `match` arms returning `Str` AND diverging via `return` confuse
    // the codegen's PHI-node type unification.
    const td_opt: Option<JsonValue*> = params.get(Str::from("textDocument"));
    if (!td_opt.is_some()) { return JsonValue::Null; }
    const td: JsonValue* = td_opt.unwrap_or(null);
    if (td == null) { return JsonValue::Null; }

    const uri_opt: Option<JsonValue*> = td.get(Str::from("uri"));
    if (!uri_opt.is_some()) { return JsonValue::Null; }
    const uri_val: JsonValue* = uri_opt.unwrap_or(null);
    if (uri_val == null) { return JsonValue::Null; }

    const uri_str_opt: Option<Str> = uri_val.as<Str>();
    if (!uri_str_opt.is_some()) { return JsonValue::Null; }
    const uri: Str = uri_str_opt.unwrap_or(Str::from(""));

    const pos_opt: Option<JsonValue*> = params.get(Str::from("position"));
    if (!pos_opt.is_some()) { return JsonValue::Null; }
    const pos: JsonValue* = pos_opt.unwrap_or(null);
    if (pos == null) { return JsonValue::Null; }
    const line:      u32 = HoverEngine::json_u32_field(pos, "line");
    const character: u32 = HoverEngine::json_u32_field(pos, "character");

    // -- Resolve the session + module + AST (best-effort) ------------
    // We resolve the AST BEFORE deciding on the keyword-doc hover, so we
    // can tell whether the cursor sits on an identifier / binding / path
    // segment that merely happens to be SPELLED like a keyword - a param
    // named `default`, an import segment `core::default`.  At those sites
    // the token is used as an identifier and the AST hover is correct;
    // the keyword doc would be wrong.  When no project / AST is available
    // (single-file buffer, pre-compile), `node` stays null and the
    // keyword-doc path runs exactly as it did before.
    //
    // `ensure_fresh` recompiles this document if another document's edit
    // reset the shared AST arena since this session last compiled, so the
    // ctx we walk below is never dangling (see Session.cryo).
    const cursor_line: u32 = line + 1 as u32;
    const cursor_char: u32 = character + 1 as u32;

    mut ctx: CompilationContext* = null;
    mut node: ASTNode* = null;
    const session: CompilerSession* = sessions.ensure_fresh(docs, uri);
    if (session != null) {
        ctx = session.context();
    }
    if (ctx != null) {
        // Strip `file://` to get the filesystem path the loader stored.
        mut fs_path_owned: String = UriPath::uri_to_fs_path(uri);
        const fs_path: Str = fs_path_owned.as_str();
        mut path_buf: String = String::with_capacity(fs_path.length() + 1);
        path_buf.push(fs_path);
        path_buf.push_byte(0 as u8);
        fs_path_owned.drop();
        const path_buf_len: u64 = path_buf.length() - 1;
        path_buf.truncate(path_buf_len);
        const path_cstr: string = path_buf.as_ptr() as string;

        const mod_idx: i64 = ctx.module_graph.find_module_by_path(path_cstr);
        path_buf.drop();
        if (mod_idx >= 0) {
            const ast: ProgramNode* = ctx.module_graph.get_module_ast(mod_idx as u32);
            if (ast != null) {
                node = node_locator::find_innermost_node_at(ast, cursor_line, cursor_char);
            }
        }
    }

    // -- Keyword hover (token-level), gated by AST context -----------
    // Skip it when the cursor is on an identifier / binding / path
    // segment name: there the keyword-lexeme is an identifier, not a
    // keyword (Cryo accepts `default`, `type`, ... as binding/path
    // names).  Otherwise run it exactly as before - keywords like
    // `function` / `mut` / `i32` don't sit on a name span, so they still
    // resolve to their markdown blurb.
    const on_name: boolean =
        HoverEngine::cursor_on_name_position(node, cursor_line, cursor_char);
    if (!on_name) {
        const doc_opt: Option<Document*> = docs.get(uri);
        match (doc_opt) {
            Option::Some(doc) => {
                const kw_hover: Option<JsonValue> =
                    KeywordDocs::try_keyword_hover(doc, line, character);
                match (kw_hover) {
                    Option::Some(json) => { return json; }
                    Option::None       => { }
                }
            }
            Option::None => { }
        }
    }

    // -- AST hover requires a resolved node + type arena -------------
    if (node == null) { return JsonValue::Null; }
    if (ctx == null) { return JsonValue::Null; }
    if (ctx.type_arena == null) { return JsonValue::Null; }

    // Per-request engine: holds the compilation pointers so the
    // formatters + graph walks below don't each re-thread them.
    mut eng: HoverEngine = HoverEngine::new(ctx);
    eng.verbose = verbose;

    // -- Pick a content string and a span for the highlight ---------
    const name_span: SourceSpan = node_locator::name_span_of(node);
    const on_decl_name: boolean =
        node_locator::span_contains(name_span, cursor_line, cursor_char);

    mut content: string = "";
    mut hover_span: SourceSpan = node.span;
    // Doc-comment text for the decl this hover ultimately points
    // at - empty when the decl has no `///` cluster directly above
    // (the parser already filters for "no blank-line gap").
    // Branches set this whenever they identify a decl; the response
    // builder appends it as a markdown paragraph after the code
    // block.
    mut doc_text: string = "";

    // Decl-name hover: render the full callable signature, not just
    // the return type.  `function name(p1: T1, ...) -> Ret` reads more
    // like the source line and matches how editors show signatures.
    if (on_decl_name && node.kind == NodeKind::FunctionDeclaration) {
        const f: FunctionDeclNode* = node as FunctionDeclNode*;
        // A bare `FunctionDeclNode*` can be a trait method (stored on
        // `TraitDeclNode.methods`, no `MethodNode` wrapper), an extern
        // declaration (on `ExternBlockNode.functions`), or a free
        // function; `format_callable_decl` reverse-walks the graph and
        // renders the matching form.
        content    = eng.format_callable_decl(f);
        hover_span = name_span;
        doc_text   = f.documentation;
    } else if (on_decl_name && node.kind == NodeKind::MethodDeclaration) {
        const m: MethodNode* = node as MethodNode*;
        if (m.func != null) {
            // Reverse-walk to find which struct/class/impl block owns
            // this method so the hover reads `Str::from_raw`, not just
            // `from_raw`.  Empty owner falls through to bare-name form.
            const owner: SymbolStr = node_locator::find_method_owner(
                ctx.module_graph, m);
            const owner_str: string = if (owner.is_valid()) {
                HoverEngine::leaf_after_separator(ctx.type_arena.intern_table.resolve(owner))
            } else { "" };
            content    = eng.format_method_signature_full(m, owner_str);
            hover_span = name_span;
            doc_text   = m.documentation;
        }
    } else if (on_decl_name && node.kind == NodeKind::VariableDeclaration) {
        // `const body_str: Str = ...;` - render the declaration form
        // rather than just the type, so the hover reflects what the
        // user wrote (`const` vs. `mut`, the variable's name).
        const v: VarDeclNode* = node as VarDeclNode*;
        // A receiver whose name token IS the whole lexeme (`this`, `&this`)
        // lands here with `on_decl_name` true; render it as the receiver
        // (`this` / `this: mut &Type`), not `const this: ?`.
        if (eng.is_receiver_param(v)) {
            content    = eng.format_receiver(v);
            hover_span = name_span;
        } else {
            content    = eng.format_variable_decl(v);
            // Surface a bound when the declared type is a constrained generic
            // param (`const held: T where T: Show`), matching the use-site form.
            content    = eng.append_param_bound(content, v.resolved_type,
                node.span.file, cursor_line, cursor_char);
            hover_span = name_span;
            doc_text   = v.documentation;
        }
    } else if (node.kind == NodeKind::VariableDeclaration) {
        // Cursor on a `VarDeclNode` outside the name token - the
        // common case is the synthesized `&this` / `mut &this` /
        // `this` receiver parameter (the parser stores the literal
        // `&this` as the param name).  Render those as
        // `this: &Type` so the receiver's resolved type is visible
        // even though there's no source-level name-span to anchor.
        const v: VarDeclNode* = node as VarDeclNode*;
        if (eng.is_receiver_param(v)) {
            content    = eng.format_receiver(v);
            hover_span = v.span;
        }
    } else if (on_decl_name && node.kind == NodeKind::FieldDeclaration) {
        // `name: Type` inside `type struct/class { ... }`.  Hover the
        // field name in source - the locator descends into the
        // struct's `fields[]` to land here - and render `name: Type`.
        const fld: FieldDeclNode* = node as FieldDeclNode*;
        content    = eng.format_field_decl(fld);
        hover_span = name_span;
        doc_text   = fld.documentation;
    } else if (on_decl_name && (
                  node.kind == NodeKind::StructDeclaration
               || node.kind == NodeKind::ClassDeclaration
               || node.kind == NodeKind::EnumDeclaration
               || node.kind == NodeKind::TraitDeclaration
               || node.kind == NodeKind::TypeAliasDeclaration)) {
        // `type struct HashMap<K, V, A = GlobalAlloc>` - render the
        // type-decl head, including generic params with their
        // defaults so the user can see the full parameter list.
        content    = eng.format_type_decl(node);
        hover_span = name_span;
        doc_text   = (node as DeclarationNode*).documentation;
    } else if (on_decl_name && node.kind == NodeKind::EnumVariant) {
        // `NotFound;` inside `type enum IoErrorKind { ... }` - show
        // `IoErrorKind::NotFound = 0` (auto-numbered) or the explicit
        // discriminant when set.  Reverse-walks the graph to find the
        // enclosing enum so the hover renders the qualified name.
        const variant: EnumVariantNode* = node as EnumVariantNode*;
        const parent: EnumDeclNode* = eng.find_enum_for_variant(variant);
        if (parent != null) {
            content    = eng.format_enum_variant(parent, variant);
            hover_span = name_span;
            doc_text   = variant.documentation;
        }
    } else if (node.kind == NodeKind::ScopeResolution) {
        // `Type::method(...)` or `Module::function(...)`.  Two cursor
        // sub-positions, resolved independently so hovering `fmt` in
        // `fmt::printf` shows the `fmt` namespace, not the `printf`
        // callable:
        //   - on the SCOPE token (`fmt`, `Option`) -> the scope's own
        //     hover: a type/enum/trait decl when the scope names one,
        //     else the namespace overview (same as an import segment).
        //   - on the MEMBER token (`printf`, `Some`) -> the callable's
        //     signature.  Method on `Type` wins; falls back to a free
        //     function in some module; finally an enum variant.
        const sr: ScopeResolutionNode* = node as ScopeResolutionNode*;

        // Scope side first.  The member span is checked to break ties on
        // synthetic nodes whose scope/member spans both equal the whole
        // span (there the cursor is treated as on the member).
        const on_scope: boolean = node_locator::span_contains(
                sr.scope_span, cursor_line, cursor_char)
            && !node_locator::span_contains(
                sr.member_span, cursor_line, cursor_char);
        if (on_scope) {
            const scope_decl: ASTNode* = node_locator::find_type_decl_in_modules(
                ctx.module_graph, ctx.intern_table, sr.scope_name);
            if (scope_decl != null) {
                content    = eng.format_type_decl(scope_decl);
                doc_text   = (scope_decl as DeclarationNode*).documentation;
                hover_span = sr.scope_span;
            } else {
                // Namespace scope (`fmt`, `io`) - resolve against `std::`
                // and render the same overview an import segment shows.
                const literal: string = ctx.intern_table.resolve(sr.scope_name);
                const seg_path: string = eng.resolve_namespace_path(literal);
                const ns: string = eng.format_namespace_overview(seg_path);
                if (ns != "") {
                    content    = ns;
                    doc_text   = eng.namespace_doc_for_path(seg_path);
                    hover_span = sr.scope_span;
                }
            }
        }

        if (content == "") {
            const m: MethodNode* = node_locator::find_method_in_modules(
                ctx.module_graph, ctx.intern_table, sr.scope_name, sr.member_name);
            if (m != null && m.func != null) {
                const owner_str: string = HoverEngine::leaf_after_separator(
                    ctx.type_arena.intern_table.resolve(sr.scope_name));
                content  = eng.format_method_signature_full(m, owner_str);
                doc_text = m.documentation;
            } else {
                const f: FunctionDeclNode* = node_locator::find_function_in_modules(
                    ctx.module_graph, sr.member_name);
                if (f != null) {
                    content  = eng.format_callable_decl(f);
                    doc_text = f.documentation;
                } else {
                    // Enum-variant fallback.  `find_type_decl_in_modules`
                    // already accepts qualified-or-bare names and matches
                    // enum decls; cast and scan variants for the member.
                    const td: ASTNode* = node_locator::find_type_decl_in_modules(
                        ctx.module_graph, ctx.intern_table, sr.scope_name);
                    if (td != null && td.kind == NodeKind::EnumDeclaration) {
                        const ed: EnumDeclNode* = td as EnumDeclNode*;
                        const v: EnumVariantNode* = HoverEngine::find_variant_in_enum(
                            ed, sr.member_name);
                        if (v != null) {
                            content  = eng.format_enum_variant(ed, v);
                            doc_text = v.documentation;
                        }
                    }
                }
            }
            // Narrow the highlight to the member token so only `printf`
            // underlines, not the whole `fmt::printf`.
            if (content != "") { hover_span = sr.member_span; }
        }
    } else if (node.kind == NodeKind::StructLiteral) {
        // `IoError { kind: ..., os_code: ... }` - three sub-cases based
        // on cursor position:
        //   - on the type-name token (`IoError`)         -> struct head
        //   - on a field-init name (`kind`, `os_code`)   -> `name: Type`
        //   - inside a field-init value                  -> falls through
        //     (the locator descends into `value` so we typically don't
        //     even reach this branch in that case)
        const sl: StructLiteralNode* = node as StructLiteralNode*;
        const sl_result: StructLiteralHover = eng.struct_literal_hover_at(
            sl, cursor_line, cursor_char);
        if (sl_result.content != "") {
            content    = sl_result.content;
            hover_span = sl_result.span;
            doc_text   = sl_result.doc;
        }
    } else if (node.kind == NodeKind::MemberAccess) {
        // `obj.method(...)` - look up the method on the receiver's
        // resolved type.  Use the type arena's display for the owner
        // prefix so monomorphized generics render as
        // `Array<u8, GlobalAlloc>::append(...)` rather than the
        // mangled spec-name `5Array$Lh_N$L3std...`.  Method lookup
        // still goes through the bare/qualified SymbolStr from
        // `decl_index.lookup_type_name` because that's what the
        // locator's leaf-aware matcher compares against.
        const ma: MemberAccessNode* = node as MemberAccessNode*;
        if (ma.object != null && ctx.decl_index != null) {
            // -- Path 1: resolved-type route --------------------------
            // The receiver expression's resolved_type after sema is
            // often `&Formatter<W>` or `mut &String` (parser keeps the
            // borrow form), but method declarations register against
            // the underlying struct's TypeRef.  Unwrap Reference /
            // Pointer / InstantiatedType wrappers so `lookup_type_name`
            // hits the carrier's entry in the reverse map.
            mut type_sym: SymbolStr = SymbolStr::empty();
            mut owner_display: string = "";
            const recv_ty: TypeRef = eng.unwrap_to_carrier(ma.object.resolved_type);
            if (recv_ty.is_valid()) {
                type_sym = ctx.decl_index.lookup_type_name(recv_ty);
                if (type_sym.is_valid()) {
                    owner_display = ctx.type_arena.resolve_display_name_short(
                        recv_ty.id);
                }
            }

            // -- Path 1b: generic-param receiver ---------------------
            // A receiver whose resolved type is a bare generic param
            // (`this.second` typed `J`) has no entry in the type reverse
            // map, so `lookup_type_name` misses.  Use the param's own
            // name as the carrier; the trait-method lookup below then
            // resolves `J::next` through the enclosing impl's
            // `where J: Iterator<A>` bound.
            if (!type_sym.is_valid() && recv_ty.is_valid()) {
                const gp_name: SymbolStr = eng.generic_param_name_of(recv_ty);
                if (gp_name.is_valid()) {
                    type_sym = gp_name;
                    owner_display = ctx.intern_table.resolve(gp_name);
                }
            }

            // -- Path 2: annotation fallback -------------------------
            // Inside a generic function body sema may not have stamped
            // a valid resolved_type on identifier expressions (the
            // template body is type-checked once with unresolved
            // generic params, so a `mut &Formatter<W>` parameter
            // reference can land here as `?`).  Recover by walking
            // through the parameter declaration's source annotation:
            // `Formatter<W>` -> take `Formatter` as the carrier name,
            // then run the method lookup by name.
            if (!type_sym.is_valid()) {
                const annot_name: SymbolStr = eng.receiver_carrier_name_from_annotation(
                    ma.object);
                if (annot_name.is_valid()) {
                    type_sym = annot_name;
                    owner_display = HoverEngine::leaf_after_separator(
                        ctx.intern_table.resolve(annot_name));
                }
            }

            // -- Path 2b: field-access receiver (`this.second.next()`) --
            // The receiver is itself a field read (`this.second`), not an
            // identifier, so Path 2's annotation walk (Identifier-only)
            // misses and sema left the field access's resolved_type
            // unstamped in the template body.  Recover the field's declared
            // carrier from the AST: find `second` on the enclosing method's
            // owner and read its annotation's leaf (`J`).  The trait-method
            // lookup below then resolves `J::next` through the impl's
            // `where J: Iterator<A>` bound.
            if (!type_sym.is_valid()) {
                const fld_carrier: SymbolStr = eng.member_field_carrier_name(ma.object);
                if (fld_carrier.is_valid()) {
                    type_sym = fld_carrier;
                    owner_display = HoverEngine::leaf_after_separator(
                        ctx.intern_table.resolve(fld_carrier));
                }
            }

            if (type_sym.is_valid()) {
                // Disambiguate field vs. method when both names exist
                // on the carrier type.  `is_member_access_callee`
                // walks the file's AST looking for a CallExpression
                // whose callee is THIS member access - true when the
                // user wrote `obj.member(...)`, false for bare
                // `obj.member`.  Without this check we'd always
                // render the method, even on a field read like
                // `return this.length;` where `length` is the field
                // and the enclosing function `length()` is unrelated.
                const is_call: boolean = node_locator::is_member_access_callee(
                    ctx.module_graph, ma);

                // Generic-param receiver fallback: when the carrier
                // type-sym resolves to a generic parameter name (e.g.
                // `T` from `value: &T` in `println<T>(value: &T)
                // where T: Display`), there's no struct named `T` to
                // look methods up on.  Walk back to the enclosing
                // function's trait bounds, look up the named trait,
                // and render the trait method instead.  Done before
                // the regular method/field path so trait method docs
                // win when both exist (which is rare anyway).
                const trait_m: FunctionDeclNode* = eng.trait_method_for_generic_receiver(
                    ma.span.file, ma.span.start_line, ma.span.start_col,
                    type_sym, ma.member);
                if (trait_m != null) {
                    const trait_owner: SymbolStr =
                        node_locator::find_trait_for_function(
                            ctx.module_graph, trait_m);
                    const owner_str: string = if (trait_owner.is_valid()) {
                        HoverEngine::leaf_after_separator(
                            ctx.intern_table.resolve(trait_owner))
                    } else { "" };
                    content  = eng.format_trait_method_signature(
                        trait_m, owner_str);
                    doc_text = trait_m.documentation;
                    if (node_locator::span_contains(
                            ma.member_span, cursor_line, cursor_char)) {
                        hover_span = ma.member_span;
                    }
                }

                if (content != "") {
                    // Trait-method fallback above already filled
                    // content; skip the struct-method/field lookup.
                } else if (is_call) {
                    // Method-first lookup - the parens commit to a
                    // callable.  Fall back to a field of the same
                    // name only if no method matches (rare; would be
                    // a function-pointer-typed field).
                    const m: MethodNode* = node_locator::find_method_in_modules(
                        ctx.module_graph, ctx.intern_table, type_sym, ma.member);
                    if (m != null && m.func != null) {
                        content  = eng.format_method_signature_full(m, owner_display);
                        doc_text = m.documentation;
                    } else {
                        const fld: FieldDeclNode* = node_locator::find_field_in_modules(
                            ctx.module_graph, ctx.intern_table, type_sym, ma.member);
                        if (fld != null) {
                            content  = eng.format_field_decl(fld);
                            content  = eng.prefix_field_owner(content, ma.object, type_sym);
                            content  = eng.append_param_bound(content, fld.resolved_type,
                                ma.span.file, cursor_line, cursor_char);
                            doc_text = fld.documentation;
                        }
                    }
                } else {
                    // Field-first lookup - bare `.member` access.
                    // Methods can also be referenced bare (e.g.
                    // function-pointer assignment of a method) but
                    // the field reading is far more common.
                    const fld: FieldDeclNode* = node_locator::find_field_in_modules(
                        ctx.module_graph, ctx.intern_table, type_sym, ma.member);
                    if (fld != null) {
                        content  = eng.format_field_decl(fld);
                        content  = eng.prefix_field_owner(content, ma.object, type_sym);
                        content  = eng.append_param_bound(content, fld.resolved_type,
                            ma.span.file, cursor_line, cursor_char);
                        doc_text = fld.documentation;
                    } else {
                        const m: MethodNode* = node_locator::find_method_in_modules(
                            ctx.module_graph, ctx.intern_table, type_sym, ma.member);
                        if (m != null && m.func != null) {
                            content  = eng.format_method_signature(m, owner_display);
                            doc_text = m.documentation;
                        }
                    }
                }

                if (content != "" && node_locator::span_contains(
                        ma.member_span, cursor_line, cursor_char)) {
                    hover_span = ma.member_span;
                }
            }
        }
    } else if (node.kind == NodeKind::ImportDeclaration) {
        // `import std::core::panic;` - hovering an individual
        // segment shows the corresponding namespace's `_module.cryo`
        // banner: the `namespace X::Y;` line plus its `public module`
        // re-exports.  Inside stdlib files imports are relative
        // (`import core::option;` from `std::net::socket_addr`), so
        // resolve the literal path against `std::` as a fallback -
        // matching the loader's stdlib-search behavior.
        const imp: ImportDeclNode* = node as ImportDeclNode*;
        const seg_idx: i64 = HoverEngine::import_segment_at(
            imp, cursor_line, cursor_char);
        if (seg_idx >= 0) {
            const literal: string = eng.build_segment_path(imp, seg_idx);
            const seg_path: string = eng.resolve_namespace_path(literal);
            content    = eng.format_namespace_overview(seg_path);
            doc_text   = eng.namespace_doc_for_path(seg_path);
            hover_span = imp.path_segment_spans[seg_idx];
        }
    } else if (node.kind == NodeKind::ModuleDeclaration) {
        // `namespace std::net::socket_addr;` and
        // `public module collections::string;` - same per-segment
        // dispatch as imports.  `parse_namespace_declaration` lowers
        // the namespace decl into a `ModuleDeclNode`; both syntaxes
        // share the per-segment span tracking populated by the
        // parser.
        const md: ModuleDeclNode* = node as ModuleDeclNode*;
        const seg_idx: i64 = HoverEngine::module_decl_segment_at(
            md, cursor_line, cursor_char);
        if (seg_idx >= 0) {
            const literal: string = eng.build_module_decl_path(md, seg_idx);
            const seg_path: string = eng.resolve_namespace_path(literal);
            content    = eng.format_namespace_overview(seg_path);
            doc_text   = eng.namespace_doc_for_path(seg_path);
            hover_span = md.path_segment_spans[seg_idx];
        }
    } else if (node.kind == NodeKind::ImplementationBlock) {
        // `implement [trait <T> for] [struct|enum|class] <Target> { ... }`
        // - hover the trait name, the target type name, or both.  The
        // locator stops at the impl block when the cursor is on the
        // head (it only descends into methods), so this branch routes
        // both sub-positions.
        const impl_blk: ImplBlockNode* = node as ImplBlockNode*;
        // Generic-param side: cursor on `I` / `O` in `implement<I, O>`.
        // Each param owns its own span; render the param plus its bound
        // from the impl's own `where` clause (`I where I: Iterator`).
        for (mut gpi: i64 = 0; gpi < impl_blk.generic_params.length; gpi++) {
            const gp: GenericParamNode* = impl_blk.generic_params[gpi];
            if (gp == null) { continue; }
            if (!node_locator::span_contains(gp.span, cursor_line, cursor_char)) {
                continue;
            }
            const leaf: string = ctx.intern_table.resolve(gp.name);
            content    = leaf + eng.render_where_for_param(
                &impl_blk.where_bounds, gp.name);
            hover_span = gp.span;
            break;
        }
        // Trait side: the trait_annotation owns spans on its own
        // NamedAnnotations, so reuse the same path used for type
        // annotations elsewhere in this file.
        if (content == "" && impl_blk.trait_annotation != null) {
            const named: NamedAnnotation* = node_locator::find_named_annotation_at(
                impl_blk.trait_annotation, cursor_line, cursor_char);
            if (named != null) {
                const decl: ASTNode* = node_locator::find_type_decl_in_modules(
                    ctx.module_graph, ctx.intern_table, named.name);
                if (decl != null) {
                    content    = eng.format_type_decl(decl);
                    hover_span = named.span;
                    doc_text   = (decl as DeclarationNode*).documentation;
                }
            }
        }
        // Target side: cursor on the target-type lexeme.  Span set by
        // `parse_implementation_block`; absent on legacy paths
        // (defensive `is_valid` check).
        if (content == "" && impl_blk.target_type_span.has_location()
                && node_locator::span_contains(impl_blk.target_type_span,
                                              cursor_line, cursor_char)) {
            const decl: ASTNode* = node_locator::find_type_decl_in_modules(
                ctx.module_graph, ctx.intern_table, impl_blk.target_type);
            if (decl != null) {
                content    = eng.format_type_decl(decl);
                hover_span = impl_blk.target_type_span;
                doc_text   = (decl as DeclarationNode*).documentation;
            }
        }
    } else if (node.kind == NodeKind::StaticMatchExpression
            || node.kind == NodeKind::StaticMatchStatement) {
        // `static match (T) { String => ... u8 | u16 => ... }`.  Arm type
        // patterns (and the scrutinee) are `TypeAnnotation`s, not ASTNodes, so
        // the locator can't return one and stops at the static-match node.
        // Scan the scrutinee + every arm's type patterns for the annotation
        // under the cursor and render its type decl - so a NAMED pattern
        // (`String`, `Str`, a user type) hovers like any other type name.
        // Primitive patterns (`u8`, `boolean`) were already handled by the
        // keyword-doc path before the AST walk, so they don't reach here.
        const named: NamedAnnotation* = eng.static_match_annotation_at(
            node, cursor_line, cursor_char);
        if (named != null) {
            const decl: ASTNode* = node_locator::find_type_decl_in_modules(
                ctx.module_graph, ctx.intern_table, named.name);
            if (decl != null) {
                content    = eng.format_type_decl(decl);
                hover_span = named.span;
                doc_text   = (decl as DeclarationNode*).documentation;
            }
        }
    } else if (node.kind == NodeKind::Pattern) {
        const pat: PatternNode* = node as PatternNode*;
        if (pat.pattern_kind == PatternKind::Enum) {
            // Enum arm `Option::Some(value)`.  Route the cursor to one of
            // three sub-positions, each hovered independently:
            //   - a payload binding (`value`)  -> `value: <payload type>`
            //   - the variant token (`Some`)   -> `Option::Some(T)`
            //   - the enum-path token (`Option`) -> the enum's decl body
            const ep: EnumPatternNode* = node as EnumPatternNode*;

            // 1. Payload binding: `value` in `Some(value)`.  Each binding
            //    owns its own span; the type is the variant's declared
            //    associated type at the same positional index.
            for (mut ei: i64 = 0; ei < ep.elements.length; ei++) {
                const pb: PatternBinding* = ep.binding_at(ei);
                if (pb == null) { continue; }
                if (node_locator::span_contains(pb.span, cursor_line, cursor_char)) {
                    content    = eng.format_pattern_binding(ep, ei, pb);
                    hover_span = pb.span;
                    break;
                }
            }

            // 2/3. Variant vs enum-path token.  Look the enum decl up once;
            //      `Some` renders the variant, `Option` renders the enum.
            if (content == "") {
                const td: ASTNode* = node_locator::find_type_decl_in_modules(
                    ctx.module_graph, ctx.intern_table, ep.enum_name);
                if (td != null && td.kind == NodeKind::EnumDeclaration) {
                    const ed: EnumDeclNode* = td as EnumDeclNode*;
                    const on_variant: boolean = node_locator::span_contains(
                        ep.variant_span, cursor_line, cursor_char);
                    if (!on_variant && node_locator::span_contains(
                            ep.enum_span, cursor_line, cursor_char)) {
                        content    = eng.format_type_decl(td);
                        hover_span = ep.enum_span;
                        doc_text   = (td as DeclarationNode*).documentation;
                    } else {
                        // Variant token, or an unqualified/whole-pattern
                        // fallback: render the variant it names.
                        const v: EnumVariantNode* = HoverEngine::find_variant_in_enum(
                            ed, ep.variant_name);
                        if (v != null) {
                            content    = eng.format_enum_variant(ed, v);
                            hover_span = ep.variant_span;
                            doc_text   = v.documentation;
                        }
                    }
                }
            }
        } else if (pat.pattern_kind == PatternKind::Identifier) {
            // Bare identifier arm.  Two readings, tried in order:
            //   1. an enum variant used unqualified (`FOO` for
            //      `MyEnum::FOO`) - the near-certain intent inside a
            //      `match` over an enum subject; the parser can't tell it
            //      apart from a fresh binding, so it lands here as an
            //      Identifier pattern with no enum qualifier.
            //   2. a global const of that name (errno-style tables), which
            //      an identifier pattern shadows as a fresh binding - the
            //      resolver records no span->sym entry for it.
            // Enum-variant first: consts and variants rarely share a name,
            // and when neither matches (a genuine capture binding) both
            // lookups simply miss and the hover falls through.
            const ed: EnumDeclNode* = eng.find_enum_with_variant(pat.binding_name);
            if (ed != null) {
                const v: EnumVariantNode* = HoverEngine::find_variant_in_enum(
                    ed, pat.binding_name);
                if (v != null) {
                    content    = eng.format_enum_variant(ed, v);
                    hover_span = pat.span;
                    doc_text   = v.documentation;
                }
            }
            if (content == "") {
                const cv: VarDeclNode* = node_locator::find_const_in_modules(
                    ctx.module_graph, pat.binding_name);
                if (cv != null) {
                    content    = eng.format_variable_decl(cv);
                    hover_span = pat.span;
                    doc_text   = cv.documentation;
                }
            }
        }
    } else if (node.kind == NodeKind::Literal) {
        // String literals render as `string("Hello, ...")[len]`; numeric
        // literals as `<value>: <inferred-type>` so the hover surfaces
        // both the source value and the type sema picked from context
        // (the same `42` is `i32` in `const x: i32 = 42` but `u64`
        // when passed to a `u64` parameter).  Char/bool/null fall
        // through to the type-only fallback - their value already
        // shows in source and the type alone is the useful info.
        const lit: LiteralNode* = node as LiteralNode*;
        if (lit.literal_kind == LiteralKind::String) {
            content    = HoverEngine::format_string_literal(lit);
            hover_span = lit.span;
        } else if (lit.literal_kind == LiteralKind::Integer
                || lit.literal_kind == LiteralKind::Float) {
            content    = eng.format_numeric_literal(lit);
            hover_span = lit.span;
        }
    } else if (node.kind == NodeKind::Identifier && ctx.resolver != null) {
        // `body_str` (use site) - show the declaration form so the
        // hover reads `const body_str: Str` instead of just `Str`.
        // Symbol lookup happens via the resolver's span -> sym_id map
        // populated during NameResolution; absent (sema bailed) falls
        // through to the type-only fallback.
        //
        // For top-level constants (errno-style numbers, sentinel
        // strings) we ALSO append the initializer literal so hover
        // reads `const ENOENT: i32 = 2` rather than just the type.
        // Walks back through the symbol's declaring span to find the
        // VarDeclNode and reads its initializer.
        const id_node: IdentifierNode* = node as IdentifierNode*;

        // `this` is parsed as an Identifier but isn't resolver-tracked.
        // Render it as `this: <EnclosingType>` by finding the method
        // body that contains the cursor and reading its owner.
        if (id_node.name.is_valid() && ctx.intern_table != null) {
            const this_sym: SymbolStr = ctx.intern_table.intern("this");
            if (id_node.name.equals(this_sym)) {
                const owner: SymbolStr = node_locator::find_enclosing_method_owner(
                    ctx.module_graph, id_node.span.file,
                    id_node.span.start_line, id_node.span.start_col);
                if (owner.is_valid()) {
                    const owner_str: string = HoverEngine::leaf_after_separator(
                        ctx.intern_table.resolve(owner));
                    content    = "this: " + owner_str;
                    hover_span = id_node.span;
                }
            }
        }
        if (content == "") {
            const sym_id: SymbolID = ctx.resolver.resolve(id_node.span);
            if (sym_id.is_valid()) {
                const sym: Symbol = ctx.resolver.get_symbol(sym_id);

                // Free-function call site (`foo` in `foo(x)`) - render the
                // full signature instead of the function's own type, which
                // round-trips through the arena as `?` for arrow types.
                // Trait-method detection mirrors the decl-name dispatch above.
                if (sym.kind == SymbolKind::Function) {
                    const fdecl: FunctionDeclNode* = eng.function_decl_at_span(
                        sym.declaring_span);
                    if (fdecl != null) {
                        content  = eng.format_callable_decl(fdecl);
                        doc_text = fdecl.documentation;
                    }
                }

                if (content == "") {
                    const init_str: string = eng.const_initializer_text(
                        sym.declaring_span);
                    // Pull the symbol's source decl up front: besides docs, its
                    // `resolved_type` is the reliable type source.  A use-site
                    // reference to a global const (`this.f(INITIAL_BUCKETS)`)
                    // often carries no stamped `resolved_type` on the reference
                    // identifier - sema resolves the declaration, not every
                    // use - so `id_node.resolved_type` would render `?`.  The
                    // decl node carries the sema-resolved `u64`; prefer it when
                    // the use-site type is missing.
                    // Covers `const ENOENT: i32 = 2` use sites; method/field/
                    // parameter uses fall through with empty doc.
                    const v: VarDeclNode* = eng.var_decl_at_span(
                        sym.declaring_span);
                    mut use_ty: TypeRef = id_node.resolved_type;
                    if (!use_ty.is_valid() && v != null
                            && v.resolved_type.is_valid()) {
                        use_ty = v.resolved_type;
                    }
                    content = eng.format_identifier_use(sym, use_ty, init_str);
                    // Surface a generic param's bound at the use site:
                    // `foo<T: Display>(x)` hovered on `x` reads
                    // `const x: T where T: Display`.
                    content = eng.append_param_bound(content, use_ty,
                        id_node.span.file, cursor_line, cursor_char);
                    if (v != null) { doc_text = v.documentation; }

                    // Generic-body fallback: when sema didn't stamp a
                    // valid resolved_type on the identifier (the param
                    // type involves an unresolved generic param like
                    // `T` or `&T`), `format_identifier_use` renders
                    // `value: ?`.  Recover by formatting the source
                    // type annotation as text - `value: &T` reads
                    // exactly the way it was written, even when sema
                    // couldn't lower it through the type arena yet.
                    if (v != null && v.type_annotation != null
                            && HoverEngine::contains_unknown_type(content)) {
                        const ann_str: string = eng.format_annotation(
                            v.type_annotation);
                        if (ann_str != "" && ann_str != "?") {
                            content = eng.rebuild_identifier_use_with_annotation(
                                sym, ann_str, init_str);
                        }
                    }
                }
            }
        }

        // AST fallback: inside a trait default-method / generic template
        // body the resolver records no span->sym for parameters or pattern
        // bindings, so `resolve` above misses and the type-only fallbacks
        // find nothing.  Recover the declaration straight from the AST.
        if (content == "" && id_node.name.is_valid()) {
            // Enclosing function parameter (`pred` in `pred(value)`).
            content = eng.identifier_as_param(id_node.name, id_node.span.file,
                id_node.span.start_line, id_node.span.start_col);
            if (content == "") {
                // Match-arm payload binding (`value` in
                // `Some(value) => pred(value)`).
                content = eng.identifier_as_pattern_binding(id_node.name,
                    id_node.span.file,
                    id_node.span.start_line, id_node.span.start_col);
            }
            if (content != "") { hover_span = id_node.span; }
        }
    }

    // Associated-type cursor: hovering `Item` in `type Item;` inside a
    // trait body.  `AssocTypeDeclNode` is a plain struct (not an AST node),
    // so the locator stops at the enclosing TraitDeclaration; scan its
    // `assoc_types[]` for the one whose span covers the cursor and render
    // `type Item` (with any declaration-site bounds).
    if (content == "" && node.kind == NodeKind::TraitDeclaration) {
        const td: TraitDeclNode* = node as TraitDeclNode*;
        for (mut ai: i64 = 0; ai < td.assoc_types.length; ai++) {
            const a: AssocTypeDeclNode* = td.assoc_types[ai];
            if (a == null) { continue; }
            if (node_locator::span_contains(a.span, cursor_line, cursor_char)) {
                content    = eng.format_assoc_type(a);
                hover_span = a.span;
                break;
            }
        }
    }

    // Where-clause cursor: hovering a trait name inside a function or
    // method's `where T: Trait + Trait2` clause.  The locator stops
    // at the FunctionDeclaration / MethodDeclaration node (the where
    // clause sits between params and body, neither of which the
    // descent reaches).  Scan trait_bounds[] for a TraitRef whose
    // span covers the cursor; render its declaring trait.
    if (content == "") {
        const trait_ref_match: SymbolStr = HoverEngine::trait_ref_at_cursor(
            node, cursor_line, cursor_char);
        if (trait_ref_match.is_valid()) {
            const decl: ASTNode* = node_locator::find_type_decl_in_modules(
                ctx.module_graph, ctx.intern_table, trait_ref_match);
            if (decl != null) {
                content    = eng.format_type_decl(decl);
                doc_text   = (decl as DeclarationNode*).documentation;
                hover_span = HoverEngine::trait_ref_span_at_cursor(node, cursor_line, cursor_char);
            }
        }
    }

    // Where-clause type-parameter side: hovering `A` in `where A:
    // Allocator`.  TraitBound.type_parameter is a bare SymbolStr with
    // no dedicated span, so the param's span is derived as
    // `[bound.span.start, first_trait_ref.span.start)` - same line in
    // every case the parser produces.
    if (content == "") {
        const param_span: SourceSpan = HoverEngine::type_param_span_at_cursor(
            node, cursor_line, cursor_char);
        if (param_span.has_location()) {
            const param_name: SymbolStr = HoverEngine::type_param_at_cursor(
                node, cursor_line, cursor_char);
            if (param_name.is_valid()) {
                content    = eng.format_generic_param_at(node, param_name);
                hover_span = param_span;
            }
        }
    }

    // Inline-asm symbol reference: the cursor sits inside an `asm { ... }`
    // block (the locator returns the AsmBlockStmtNode because the body isn't
    // span-preserved in the AST).  Pull the identifier under the cursor out
    // of the live buffer and, if it names a Cryo function (`call
    // __cryo_start`), render that function's signature.  Mnemonics and
    // registers simply don't resolve to a function, so they get no hover.
    if (content == "" && node.kind == NodeKind::AsmBlockStatement
            && ctx.intern_table != null) {
        const doc_opt: Option<Document*> = docs.get(uri);
        mut docp: Document* = null;
        match (doc_opt) {
            Option::Some(d) => { docp = d; }
            Option::None     => { }
        }
        if (docp != null) {
            const line0: u32 = cursor_line - 1 as u32;
            if (line0 as u64 < docp.line_index.line_count()) {
                const ls: u64 = docp.line_index.line_start(line0);
                const le: u64 = docp.line_index.line_end(line0);
                mut lb: u64 = if (le > ls) { le - ls } else { 0 as u64 };
                if (lb > 0 as u64 && line0 as u64 + 1 < docp.line_index.line_count()) {
                    lb = lb - 1 as u64;             // strip trailing '\n'
                }
                const txt: string = docp.text.as_ptr() as string;
                const base: string = txt + ls as i64;
                const col: u32 = cursor_char - 1 as u32;    // 0-based byte col
                if (col as u64 < lb
                        && HoverEngine::asm_is_ident_byte(base[col as i64] as u8)) {
                    mut s: u32 = col;
                    while (s > 0 as u32
                            && HoverEngine::asm_is_ident_byte(base[(s - 1 as u32) as i64] as u8)) {
                        s = s - 1 as u32;
                    }
                    mut e: u32 = col;
                    while (e as u64 < lb
                            && HoverEngine::asm_is_ident_byte(base[e as i64] as u8)) {
                        e = e + 1 as u32;
                    }
                    mut ident: String = String::new();
                    mut bi: u32 = s;
                    while (bi < e) {
                        ident.push_byte(base[bi as i64] as u8);
                        bi = bi + 1 as u32;
                    }
                    const target: SymbolStr =
                        ctx.intern_table.intern(ident.as_ptr() as string);
                    ident.drop();
                    const fdecl: FunctionDeclNode* = eng.find_asm_symbol_decl(target);
                    if (fdecl != null) {
                        content    = eng.format_callable_decl(fdecl);
                        doc_text   = fdecl.documentation;
                        hover_span = SourceSpan::new(node.span.file,
                            cursor_line, s + 1 as u32, cursor_line, e + 1 as u32);
                    }
                }
            }
        }
    }

    // Fallback path for everything else (variables, identifiers,
    // expressions, type tokens).  Use the short type name so the
    // tooltip says `Str` not `std::collections::str::Str`.
    if (content == "") {
        // Type-annotation cursor (e.g. `: IoError`) - find the named
        // segment under the cursor, look up the declaring struct /
        // class / enum / trait / typealias, and render the full body
        // via `format_type_decl`.  Falls through to the type-name
        // fallback when the named segment isn't a user-defined type
        // (primitives, generic params).
        const ann_root: TypeAnnotation* = HoverEngine::annotation_for_decl(node);
        if (ann_root != null) {
            // `This` token (`ZipIter<This, J>`): explain the implementing
            // type it stands for.  Checked before the named-segment walk,
            // which skips `ThisType` entirely.
            const this_span: SourceSpan = node_locator::find_this_span_at(
                ann_root, cursor_line, cursor_char);
            if (this_span.has_location()) {
                content    = eng.this_reference_type(node);
                hover_span = this_span;
            }

            const named: NamedAnnotation* = if (content == "") {
                node_locator::find_named_annotation_at(
                    ann_root, cursor_line, cursor_char)
            } else { null };
            if (named != null) {
                const decl: ASTNode* = node_locator::find_type_decl_in_modules(
                    ctx.module_graph, ctx.intern_table, named.name);
                if (decl != null) {
                    content    = eng.format_type_decl(decl);
                    hover_span = named.span;
                    doc_text   = (decl as DeclarationNode*).documentation;
                } else {
                    // Not a user-defined type - it's a generic type
                    // parameter.  When the enclosing context bounds it,
                    // render `I where I: Iterator`; an unbound param that the
                    // enclosing decl declares (`J` in `zip<J>() -> ...<J>`)
                    // renders as its bare name; anything else falls through.
                    const leaf: string = HoverEngine::leaf_after_separator(
                        ctx.intern_table.resolve(named.name));
                    const suffix: string = eng.generic_param_where_suffix(
                        named.name, node.span.file, cursor_line, cursor_char);
                    if (suffix != "") {
                        content    = leaf + suffix;
                        hover_span = named.span;
                    } else if (eng.enclosing_declares_generic_param(
                            named.name, node, node.span.file,
                            cursor_line, cursor_char)) {
                        content    = leaf;
                        hover_span = named.span;
                    }
                }
            }
        }

        if (content == "") {
            const ty: TypeRef = node_locator::resolved_type_of(node);
            if (!ty.is_valid()) { return JsonValue::Null; }
            const type_name: string = ctx.type_arena.resolve_display_name_short(ty.id);
            if (type_name == "") { return JsonValue::Null; }
            content = type_name;
            if (on_decl_name) { hover_span = name_span; }
            // Narrow the highlight to a type-annotation span when the
            // cursor sits on one.  Without this, hovering `i32` in
            // `function foo() -> i32 { ... }` would underline the entire
            // function - the locator can't descend into TypeAnnotation
            // (it's an enum, not an AST node) so the walk stops at the
            // enclosing decl.
            const ann_span: SourceSpan = HoverEngine::annotation_span_at_cursor(
                node, cursor_line, cursor_char);
            if (node_locator::span_contains(ann_span, cursor_line, cursor_char)) {
                hover_span = ann_span;
            }
        }
    }

    // -- Build the LSP Hover response --------------------------------
    // Layout: code-block signature, then a blank line, then the doc
    // comment as plain markdown.  The blank line is required for
    // markdown to treat the doc as a separate paragraph rather than
    // a continuation of the fenced code block.
    mut value_buf: String = String::with_capacity(64);
    value_buf.push("```cryo\n");
    value_buf.push(content);
    value_buf.push("\n```");
    if (doc_text != "") {
        const doc_clean: string = HoverEngine::clean_doc_for_hover(doc_text);
        if (doc_clean != "") {
            value_buf.push("\n\n");
            value_buf.push(doc_clean);
        }
    }

    const contents: MarkupContent = MarkupContent::markdown(value_buf);
    const hover: Hover = Hover {
        contents: contents,
        range:    Option::Some(HoverEngine::range_from_span(hover_span)),
    };
    const result: JsonValue = hover.to_json();
    mut h: Hover = hover;
    h.drop();
    return result;
}


// Struct-literal hover result
//
/// Result of dispatching a struct-literal hover: the rendered string
/// + the highlight span.  Empty `content` means the struct-literal
/// branch couldn't classify the cursor (caller falls back to the
/// generic type-only path).
type struct StructLiteralHover {
    content: string;
    span:    SourceSpan;
    doc:     string;
}


// HoverEngine - per-request rendering + AST/graph queries
//
// Holds the compilation pointers for one hover request.  Signature
// formatters, graph reverse-walks, and namespace lookups are `&this`
// methods (they read `arena` / `intern` / `graph` / `ctx`); the
// stateless string + AST utilities are `static` methods on the same
// type so the hover logic all lives in one place instead of a wall of
// free functions.

type struct HoverEngine {
    ctx:    CompilationContext*;
    arena:  TypeArena*;
    intern: InternTable*;
    graph:  ModuleGraph*;
    /// Expanded ("verbose") hover: when set, a struct/class type-decl hover
    /// additionally lists the type's method signatures in its body.  Driven
    /// by the `cryo/expandHover` custom request the extension fires when the
    /// user increases the hover's verbosity level.
    verbose: boolean;

    static new(ctx: CompilationContext*) -> HoverEngine {
        return HoverEngine {
            ctx:     ctx,
            arena:   ctx.type_arena,
            intern:  ctx.intern_table,
            graph:   ctx.module_graph,
            verbose: false,
        };
    }


    // Inline-asm symbol hover support

    /// Byte class for an identifier inside an `asm` body (letters, digits,
    /// `_`, and `.`/`$` for mangled symbols).  Mirrors the classifier in the
    /// semantic-tokens re-scanner so hover and colouring agree on token edges.
    static asm_is_ident_byte(b: u8) -> boolean {
        return (b >= 65 as u8 && b <= 90 as u8)      // A-Z
            || (b >= 97 as u8 && b <= 122 as u8)     // a-z
            || (b >= 48 as u8 && b <= 57 as u8)      // 0-9
            || b == 95 as u8                          // _
            || b == 46 as u8                          // .
            || b == 36 as u8;                         // $
    }

    /// Find a free / extern function named `target` anywhere in the module
    /// graph.  Used to resolve a bare symbol reference written inside an
    /// `asm` block (`call __cryo_start`) - those aren't AST nodes, so the
    /// normal span->symbol resolver can't reach them; we match by name.
    find_asm_symbol_decl(&this, target: SymbolStr) -> FunctionDeclNode* {
        if (!target.is_valid() || this.graph == null) { return null; }
        const count: u32 = this.graph.module_count();
        for (mut m: u32 = 0 as u32; m < count; m++) {
            const prog: ProgramNode* = this.graph.get_module_ast(m);
            if (prog == null) { continue; }
            const hit: FunctionDeclNode* =
                HoverEngine::scan_stmts_for_fn(prog, target);
            if (hit != null) { return hit; }
        }
        return null;
    }

    /// Scan a module's top-level statements for a function declaration whose
    /// name equals `target` - covers free functions (bare or wrapped in a
    /// DeclarationStatement) and `extern "C"` block functions.
    static scan_stmts_for_fn(prog: ProgramNode*, target: SymbolStr) -> FunctionDeclNode* {
        for (mut i: i64 = 0; i < prog.statements.length; i++) {
            const s: ASTNode* = prog.statements[i] as ASTNode*;
            if (s == null) { continue; }
            mut f: FunctionDeclNode* = null;
            if (s.kind == NodeKind::FunctionDeclaration) {
                f = s as FunctionDeclNode*;
            } else if (s.kind == NodeKind::DeclarationStatement) {
                const ds: DeclStmtNode* = s as DeclStmtNode*;
                if (ds.declaration != null
                        && ds.declaration.kind == NodeKind::FunctionDeclaration) {
                    f = ds.declaration as FunctionDeclNode*;
                }
            } else if (s.kind == NodeKind::ExternBlock) {
                const eb: ExternBlockNode* = s as ExternBlockNode*;
                for (mut k: i64 = 0; k < eb.functions.length; k++) {
                    const ef: FunctionDeclNode* = eb.functions[k];
                    if (ef != null && ef.name.is_valid() && ef.name.equals(target)) {
                        return ef;
                    }
                }
            }
            if (f != null && f.name.is_valid() && f.name.equals(target)) {
                return f;
            }
        }
        return null;
    }


    // Signature formatters
    //
    // Render a callable as `function name(p1: T1, p2: T2) -> Ret` (free
    // function) or `method name(...)` / `static name(...)` (method).
    // Parameter types come from `VarDeclNode.resolved_type`; the function's
    // return type comes from `FunctionDeclNode.resolved_return_type`.  Both
    // are filled in by sema, so this only produces useful output once name
    // resolution + type checking have run.  When sema bailed mid-pipeline
    // (the common LSP case for in-progress edits) the affected slots stay
    // `TypeRef::invalid()` and render as `?`.

    /// Render a trait method as `<Trait>::<name><generics>(<params>) -> <ret>
    ///     where <bounds>`.  `owner_display` is the trait's leaf name
    /// (`Display` rather than `std::fmt::display::Display`).  No `function`
    /// keyword - trait method declarations omit it in source too.
    format_trait_method_signature(&this, func: FunctionDeclNode*,
                                  owner_display: string) -> string {
        if (func == null) { return ""; }
        mut sig: string = HoverEngine::directives_prefix(func as DeclarationNode*);
        if (owner_display != "") {
            sig = sig + owner_display + "::";
        }
        sig = sig + this.arena.intern_table.resolve(func.name);
        sig = sig + this.format_generic_params(func.generic_params);
        sig = sig + this.format_params(func.parameters, func.is_variadic);
        sig = sig + " -> ";
        sig = sig + this.arena.resolve_display_name_short(func.resolved_return_type.id);
        sig = sig + this.format_where_clause(func.trait_bounds);
        return sig;
    }

    format_function_signature(&this, func: FunctionDeclNode*) -> string {
        if (func == null) { return ""; }
        mut sig: string = HoverEngine::directives_prefix(func as DeclarationNode*);
        sig = sig + "function ";
        sig = sig + this.arena.intern_table.resolve(func.name);
        sig = sig + this.format_generic_params(func.generic_params);
        sig = sig + this.format_params(func.parameters, func.is_variadic);
        sig = sig + " -> ";
        sig = sig + this.arena.resolve_display_name_short(func.resolved_return_type.id);
        sig = sig + this.format_where_clause(func.trait_bounds);
        return sig;
    }

    /// Render an extern declaration as
    /// `extern "C" function syscall(number: Syscall, ...) -> i64`.
    /// Directives come from BOTH levels: the block's (`![target(linux)]`
    /// gates the whole `extern "C" { ... }`) and the function's own
    /// (`![symbol("lseek64")]`), in that source order.
    format_extern_function_signature(&this, func: FunctionDeclNode*,
                                     block: ExternBlockNode*) -> string {
        if (func == null || block == null) { return ""; }
        mut sig: string = HoverEngine::directives_prefix(block as DeclarationNode*);
        sig = sig + HoverEngine::directives_prefix(func as DeclarationNode*);
        sig = sig + "extern \"" + block.linkage_type + "\" function ";
        sig = sig + this.arena.intern_table.resolve(func.name);
        sig = sig + this.format_params(func.parameters, func.is_variadic);
        sig = sig + " -> ";
        sig = sig + this.arena.resolve_display_name_short(func.resolved_return_type.id);
        return sig;
    }

    /// Render a bare `FunctionDeclNode*` in its declaration form, decided
    /// by where the graph declares it: a trait's method
    /// (`Display::fmt(...)`), an extern declaration (`extern "C" function
    /// ...`), or a free function (`function ...`).  Single dispatch point
    /// for the decl-name, identifier-call-site, and scope-resolution
    /// hovers, which previously each re-implemented the trait check.
    format_callable_decl(&this, func: FunctionDeclNode*) -> string {
        if (func == null) { return ""; }
        const trait_owner: SymbolStr = node_locator::find_trait_for_function(
            this.graph, func);
        if (trait_owner.is_valid()) {
            const owner_str: string = HoverEngine::leaf_after_separator(
                this.intern.resolve(trait_owner));
            return this.format_trait_method_signature(func, owner_str);
        }
        const eb: ExternBlockNode* = node_locator::find_extern_block_for_function(
            this.graph, func);
        if (eb != null) {
            return this.format_extern_function_signature(func, eb);
        }
        return this.format_function_signature(func);
    }

    /// Render a method as `<modifier>? <Owner>::<name>(<params>) -> <ret>`.
    /// Modifier is one of `static` / `constructor` / `destructor` and is
    /// omitted on plain instance methods - the `&this` / `mut &this`
    /// receiver in the parameter list already conveys instance-ness, so
    /// a leading `method` keyword would just be noise.
    ///
    /// `owner_display` is the rendered owner string the caller has
    /// already computed.  For decl-name and scope-resolution hovers the
    /// caller passes the leaf of a SymbolStr (`Str` from
    /// `std::collections::str::Str`).  For member-access hovers the
    /// caller passes the receiver type's display name from the type
    /// arena - which goes through the arena's `format_display_short` and
    /// covers monomorphized generics correctly
    /// (`Array<u8, GlobalAlloc>` rather than the mangled
    /// `5Array$Lh_N$L3std.5alloc.9allocator.11GlobalAlloc$G$G`).  Empty
    /// string means "no owner prefix".
    format_method_signature(&this, method: MethodNode*, owner_display: string) -> string {
        if (method == null || method.func == null) { return ""; }
        const f: FunctionDeclNode* = method.func;
        mut sig: string = "";
        if (method.is_static)      { sig = sig + "static "; }
        if (method.is_constructor) { sig = sig + "constructor "; }
        if (method.is_destructor)  { sig = sig + "destructor "; }
        if (owner_display != "") {
            sig = sig + owner_display + "::";
        }
        sig = sig + this.arena.intern_table.resolve(f.name);
        sig = sig + this.format_generic_params(f.generic_params);
        sig = sig + this.format_params(f.parameters, f.is_variadic);
        sig = sig + " -> ";
        sig = sig + this.arena.resolve_display_name_short(f.resolved_return_type.id);
        sig = sig + this.format_where_clause(f.trait_bounds);
        return sig;
    }

    /// Main-hover variant of `format_method_signature`: prefixes the
    /// method's attached `![...]` directives above the signature.  The
    /// expanded-hover listings (`format_inline_methods` /
    /// `format_impl_methods`) keep calling the bare form - a multi-line
    /// directive prefix would break their one-line-per-method indentation.
    format_method_signature_full(&this, method: MethodNode*,
                                 owner_display: string) -> string {
        const sig: string = this.format_method_signature(method, owner_display);
        if (sig == "") { return ""; }
        return HoverEngine::directives_prefix(method as DeclarationNode*) + sig;
    }


    // Directive rendering
    //
    // Declarations carry their source-order `![...]` directives on
    // `DeclarationNode.attached_directives` (parser-attached; config
    // gating and directive processing read them but never strip them).
    // Hover renders them above the signature exactly as written in
    // source, e.g. `![target(linux)]` above `sys_lseek`.

    /// Render one directive body (no `![ ]` wrapper): `target(linux)`,
    /// `symbol("lseek64")`, `config(not(windows))`.  Nested directive
    /// calls recurse; leaf args reuse `DirectiveArg::to_text`.
    static render_directive(d: DirectiveNode*) -> string {
        if (d == null) { return ""; }
        mut s: string = d.directive_kind;
        if (d.args.length > 0) {
            s = s + "(";
            for (mut i: i64 = 0; i < d.args.length; i++) {
                if (i > 0) { s = s + ", "; }
                const a: DirectiveArg = d.args[i];
                if (a.kind == DirectiveArgKind::Nested) {
                    s = s + HoverEngine::render_directive(a.nested);
                } else {
                    s = s + a.to_text();
                }
            }
            s = s + ")";
        }
        return s;
    }

    /// A decl's attached directives as a hover prefix - one `![...]` per
    /// line, each newline-terminated so the signature follows below.
    /// "" when the decl is null or carries no directives, so callers can
    /// unconditionally concatenate.
    static directives_prefix(decl: DeclarationNode*) -> string {
        if (decl == null || decl.attached_directives.length == 0) { return ""; }
        mut s: string = "";
        for (mut i: i64 = 0; i < decl.attached_directives.length; i++) {
            const d: DirectiveNode* = decl.attached_directives[i];
            if (d == null) { continue; }
            s = s + "![" + HoverEngine::render_directive(d) + "]\n";
        }
        return s;
    }

    /// Render a struct/class field as `<name>: <Type>`.  No `field`
    /// keyword: the surrounding `type struct/class` already conveys
    /// it, and source uses just `name: Type` for fields.
    format_field_decl(&this, fld: FieldDeclNode*) -> string {
        if (fld == null) { return ""; }
        mut sig: string = this.arena.intern_table.resolve(fld.name);
        sig = sig + ": ";
        sig = sig + this.arena.resolve_display_name_short(fld.resolved_type.id);
        return sig;
    }

    /// Render a type declaration's full body for hover:
    ///
    ///   type struct Point<T = i32> {
    ///       x: T;
    ///       y: T;
    ///   }
    ///
    /// Struct/class hovers list fields; enum hovers list variants with
    /// their auto-numbered or explicit discriminants; trait hovers list
    /// method signatures; type-alias hovers append the resolved target
    /// after `=`.  Methods on struct/class are intentionally omitted -
    /// individual method hovers cover those, and including them would
    /// make the type-hover unwieldy for stdlib types like `HashMap` or
    /// `Array`.  Empty bodies collapse to just the head.
    format_type_decl(&this, node: ASTNode*) -> string {
        const body: string = match (node.kind) {
            NodeKind::StructDeclaration => {
                const d: StructDeclNode* = node as StructDeclNode*;
                mut sig: string = "type struct " + this.arena.intern_table.resolve(d.name)
                    + this.format_generic_params(d.generic_params);
                const methods_str: string = if (this.verbose) {
                    this.format_type_methods(d.name, d.methods)
                } else { "" };
                if (d.fields.length > 0 || methods_str != "") {
                    sig = sig + " {\n";
                    for (mut i: i64 = 0; i < d.fields.length; i++) {
                        sig = sig + "    " + this.format_field_decl(d.fields[i]) + ";\n";
                    }
                    if (d.fields.length > 0 && methods_str != "") { sig = sig + "\n"; }
                    sig = sig + methods_str;
                    sig = sig + "}";
                }
                sig
            }
            NodeKind::ClassDeclaration => {
                const d: ClassDeclNode* = node as ClassDeclNode*;
                mut sig: string = "type class " + this.arena.intern_table.resolve(d.name)
                    + this.format_generic_params(d.generic_params);
                if (d.base_class.is_valid()) {
                    sig = sig + " : "
                        + HoverEngine::leaf_after_separator(this.arena.intern_table.resolve(d.base_class));
                }
                const methods_str: string = if (this.verbose) {
                    this.format_type_methods(d.name, d.methods)
                } else { "" };
                if (d.fields.length > 0 || methods_str != "") {
                    sig = sig + " {\n";
                    for (mut i: i64 = 0; i < d.fields.length; i++) {
                        sig = sig + "    " + this.format_field_decl(d.fields[i]) + ";\n";
                    }
                    if (d.fields.length > 0 && methods_str != "") { sig = sig + "\n"; }
                    sig = sig + methods_str;
                    sig = sig + "}";
                }
                sig
            }
            NodeKind::EnumDeclaration => {
                const d: EnumDeclNode* = node as EnumDeclNode*;
                mut sig: string = "type enum " + this.arena.intern_table.resolve(d.name)
                    + this.format_generic_params(d.generic_params);
                if (d.variants.length > 0) {
                    sig = sig + " {\n";
                    for (mut i: i64 = 0; i < d.variants.length; i++) {
                        sig = sig + "    " + this.format_variant_in_decl(d, d.variants[i]) + "\n";
                    }
                    sig = sig + "}";
                }
                sig
            }
            NodeKind::TraitDeclaration => {
                const d: TraitDeclNode* = node as TraitDeclNode*;
                mut sig: string = "type trait " + this.arena.intern_table.resolve(d.name)
                    + this.format_generic_params(d.generic_params);
                if (d.assoc_types.length > 0 || d.methods.length > 0) {
                    sig = sig + " {\n";
                    // Associated types first (`type Item;`), then methods -
                    // matching the usual source order in a trait body.
                    for (mut ai: i64 = 0; ai < d.assoc_types.length; ai++) {
                        const a: AssocTypeDeclNode* = d.assoc_types[ai];
                        if (a == null) { continue; }
                        sig = sig + "    " + this.format_assoc_type(a) + ";\n";
                    }
                    for (mut i: i64 = 0; i < d.methods.length; i++) {
                        const m: FunctionDeclNode* = d.methods[i];
                        if (m == null) { continue; }
                        sig = sig + "    " + this.arena.intern_table.resolve(m.name)
                            + this.format_params(m.parameters, m.is_variadic)
                            + " -> "
                            + this.arena.resolve_display_name_short(m.resolved_return_type.id)
                            + ";\n";
                    }
                    sig = sig + "}";
                }
                sig
            }
            NodeKind::TypeAliasDeclaration => {
                const d: TypeAliasDeclNode* = node as TypeAliasDeclNode*;
                mut sig: string = "type alias " + this.arena.intern_table.resolve(d.alias_name);
                sig = sig + this.format_generic_params(d.generic_params);
                // Append the resolved target after `=` when sema has filled
                // it in; otherwise leave the head bare so partially-typed
                // sources still produce useful hovers.
                if (d.resolved_target.is_valid()) {
                    sig = sig + " = "
                        + this.arena.resolve_display_name_short(d.resolved_target.id);
                }
                sig
            }
            _ => { "" }
        };
        if (body == "") { return ""; }
        // All five matched kinds inherit DeclarationNode; prepend any
        // attached `![...]` directives (`![repr(c)]`, `![align(16)]`, ...).
        return HoverEngine::directives_prefix(node as DeclarationNode*) + body;
    }

    /// Render the type's INLINE methods (declared directly in the struct /
    /// class body, e.g. `String`'s `push_byte` / `length` / `as_str`) as plain
    /// indented signatures for the expanded hover.  These live on the decl's
    /// own `methods` array, NOT in a separate impl block, so `format_type_methods`
    /// (which walks impl blocks) never sees them.  Always inherent → no prefix.
    format_inline_methods(&this, methods: &MethodNode*[]) -> string {
        mut out: string = "";
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null) { continue; }
            out = out + "    " + this.format_method_signature(m, "") + "\n";
        }
        return out;
    }

    /// List the type's impl-block methods for the expanded hover, one indented
    /// signature per line.  `want_trait` selects which impl blocks to include:
    ///   * `false` -> inherent impls (`implement Foo { ... }`), plain signature
    ///     (`resize_buckets(this: mut &This, n: u64) -> void`).
    ///   * `true`  -> trait impls (`implement trait Iterator for Foo`), each
    ///     prefixed `trait <Trait>::` (`trait Iterator::next(...) -> ...`).
    /// Splitting the two lets the caller render them as separate sections.
    /// Reuses `format_method_signature` with an empty owner (no `Owner::`
    /// prefix) so static/where-clause rendering matches method hovers.
    /// Returns "" when nothing matches, so callers concatenate unconditionally.
    /// Name matching mirrors `find_impls_of_type`.
    format_impl_methods(&this, type_name: SymbolStr, want_trait: boolean) -> string {
        if (this.graph == null || this.intern == null) { return ""; }
        const type_leaf: string = NodeLocator::leaf_segment_str(
            this.intern.resolve(type_name));
        mut out: string = "";
        const n: u32 = this.graph.module_count();
        for (mut mi: u32 = 0; mi < n; mi++) {
            const ast: ProgramNode* = this.graph.get_module_ast(mi);
            if (ast == null) { continue; }
            for (mut si: i64 = 0; si < ast.statements.length; si++) {
                const stmt: ASTNode* = NodeLocator::unwrap_decl_stmt(
                    ast.statements[si]);
                if (stmt == null) { continue; }
                if (stmt.kind != NodeKind::ImplementationBlock) { continue; }
                const impl_blk: ImplBlockNode* = stmt as ImplBlockNode*;
                if (!NodeLocator::type_name_matches(this.intern,
                        impl_blk.target_type, type_name, type_leaf)) { continue; }
                const is_trait: boolean = impl_blk.trait_annotation != null;
                if (is_trait != want_trait) { continue; }
                // Trait impls prefix each signature with `trait <Trait>::`.
                mut prefix: string = "";
                if (is_trait) {
                    const th: SymbolStr = NodeLocator::annotation_head_name(
                        impl_blk.trait_annotation);
                    if (th.is_valid()) {
                        prefix = "trait " + HoverEngine::leaf_after_separator(
                            this.intern.resolve(th)) + "::";
                    }
                }
                for (mut k: i64 = 0; k < impl_blk.methods.length; k++) {
                    const m: MethodNode* = impl_blk.methods[k];
                    if (m == null || m.func == null) { continue; }
                    out = out + "    " + prefix
                        + this.format_method_signature(m, "") + "\n";
                }
            }
        }
        return out;
    }

    /// Assemble the expanded-hover method listing for a struct/class: inherent
    /// methods first (inline body methods + inherent impl blocks), then a blank
    /// line, then trait-impl methods.  Either section may be empty; the blank
    /// separator is inserted only when both are present.  Returns "" when the
    /// type has no methods at all.
    format_type_methods(&this, type_name: SymbolStr,
                        inline_methods: &MethodNode*[]) -> string {
        const inherent: string = this.format_inline_methods(inline_methods)
            + this.format_impl_methods(type_name, false);
        const traits: string = this.format_impl_methods(type_name, true);
        if (inherent != "" && traits != "") {
            return inherent + "\n" + traits;
        }
        return inherent + traits;
    }

    /// Render one variant inside an enum-decl body: `Name = N;` for
    /// unit-only variants (auto-numbered or explicit), `Name(T1, T2);`
    /// for payload variants.  Mirrors the standalone variant hover but
    /// without the enclosing `EnumName::` prefix - it's redundant inside
    /// the enum's own decl listing.
    format_variant_in_decl(&this, parent: EnumDeclNode*, variant: EnumVariantNode*) -> string {
        if (variant == null) { return ""; }
        mut s: string = this.arena.intern_table.resolve(variant.name);
        if (variant.associated_types.length > 0) {
            s = s + "(";
            for (mut i: i64 = 0; i < variant.associated_types.length; i++) {
                if (i > 0) { s = s + ", "; }
                s = s + this.format_annotation(variant.associated_types[i]);
            }
            return s + ");";
        }
        const disc: i64 = if (variant.has_value) {
            variant.explicit_value
        } else {
            HoverEngine::variant_auto_index(parent, variant)
        };
        return s + " = " + HoverEngine::i64_to_text(disc) + ";";
    }

    format_generic_params(&this, params: &GenericParamNode*[]) -> string {
        if (params.length == 0) { return ""; }
        mut s: string = "<";
        for (mut i: i64 = 0; i < params.length; i++) {
            if (i > 0) { s = s + ", "; }
            const p: GenericParamNode* = params[i];
            if (p == null) { continue; }
            s = s + this.intern.resolve(p.name);
            if (p.default_annotation != null) {
                s = s + " = " + this.format_annotation(p.default_annotation);
            }
        }
        return s + ">";
    }

    /// Render a function/method's trait bounds as a `where` clause on a
    /// new indented line.  Mirrors the source spelling:
    ///
    ///     hash<H>(&this, hasher: mut &H) -> void
    ///         where H: Hasher
    ///
    ///     foo<T, U>(...) -> ...
    ///         where T: Default + Clone, U: Eq
    ///
    /// Each `TraitBound` carries the type-parameter name plus one or more
    /// `TraitRef`s; multi-trait bounds join with `+`, multi-param bounds
    /// join with `, `.  Empty bound list returns "" so callers can
    /// unconditionally concatenate.
    format_where_clause(&this, bounds: &TraitBound[]) -> string {
        if (bounds.length == 0) { return ""; }
        mut s: string = "\n    where ";
        for (mut i: i64 = 0; i < bounds.length; i++) {
            if (i > 0) { s = s + ", "; }
            const b: &TraitBound = &bounds[i];
            s = s + this.intern.resolve(b.type_parameter);
            s = s + ": ";
            for (mut j: i64 = 0; j < b.trait_refs.length; j++) {
                if (j > 0) { s = s + " + "; }
                s = s + this.format_trait_ref(&b.trait_refs[j]);
            }
        }
        return s;
    }

    /// Render a `TraitRef` as `<leaf>[<args>]`.  Multi-segment paths
    /// (`io::Write`) collapse to their leaf - the hover already names the
    /// enclosing context, so the prefix would just be noise.
    format_trait_ref(&this, tref: &TraitRef) -> string {
        if (tref.path.length == 0) { return "?"; }
        const leaf_sym: SymbolStr = tref.path[tref.path.length - 1];
        mut s: string = this.intern.resolve(leaf_sym);
        if (tref.type_args.length > 0) {
            s = s + "<";
            for (mut i: i64 = 0; i < tref.type_args.length; i++) {
                if (i > 0) { s = s + ", "; }
                s = s + this.format_annotation(tref.type_args[i]);
            }
            s = s + ">";
        }
        return s;
    }

    /// Render an associated-type member as `type Item` or, when it carries
    /// declaration-site constraints, `type Item: Copy + Clone`.  No trailing
    /// `;` - the caller appends one where a member listing needs it.
    format_assoc_type(&this, a: AssocTypeDeclNode*) -> string {
        if (a == null) { return ""; }
        mut s: string = "type " + this.intern.resolve(a.name);
        if (a.bounds.length > 0) {
            s = s + ": ";
            for (mut i: i64 = 0; i < a.bounds.length; i++) {
                if (i > 0) { s = s + " + "; }
                s = s + this.format_trait_ref(&a.bounds[i]);
            }
        }
        return s;
    }

    /// Render a `TypeAnnotation*` as a one-line string.  Handles the
    /// common shapes generic-param defaults take: bare `Named` (e.g.
    /// `GlobalAlloc`), `Primitive` (e.g. `i32`), and pointer/reference
    /// wrappers.  Unhandled variants render as `?` rather than error -
    /// hover should never crash when sema has only partially digested
    /// the source.
    format_annotation(&this, ann: TypeAnnotation*) -> string {
        if (ann == null) { return "?"; }
        return match (*ann) {
            TypeAnnotation::Primitive(p) => { this.intern.resolve(p.name) }
            TypeAnnotation::Named(n)     => {
                HoverEngine::leaf_after_separator(this.intern.resolve(n.name))
            }
            TypeAnnotation::Pointer(p)   => {
                this.format_annotation(p.inner) + "*"
            }
            TypeAnnotation::Reference(r) => {
                const inner: string = this.format_annotation(r.inner);
                // Cryo spells a mutable reference `mut &T`, not `&mut T`.
                const prefix: string = if (r.is_mutable) { "mut &" } else { "&" };
                prefix + inner
            }
            TypeAnnotation::Array(a)     => {
                this.format_annotation(a.element) + "[]"
            }
            _                            => { "?" }
        };
    }

    /// Reconstruct a closure's signature `(P0, P1, ...) -> Ret` from the
    /// LambdaExprNode.  A capturing lambda's `resolved_type` is the synthesized
    /// `__Closure_<N>` struct, so displaying that type name gives an opaque
    /// `__Closure_0` in hovers; the signature is the useful information and it's
    /// fully recoverable from the lambda's parameters + return type.
    format_lambda_signature(&this, lam: LambdaExprNode*) -> string {
        mut s: string = "(";
        for (mut i: i64 = 0; i < lam.parameters.length; i++) {
            if (i > 0) { s = s + ", "; }
            const p: VarDeclNode* = lam.parameters[i];
            if (p.has_resolved_type()) {
                s = s + this.arena.resolve_display_name_short(p.resolved_type.id);
            } else if (p.type_annotation != null) {
                s = s + this.format_annotation(p.type_annotation);
            } else {
                s = s + "?";
            }
        }
        s = s + ") -> ";
        if (lam.return_type.is_valid()) {
            s = s + this.arena.resolve_display_name_short(lam.return_type.id);
        } else if (lam.return_type_ann != null) {
            s = s + this.format_annotation(lam.return_type_ann);
        } else {
            s = s + "void";
        }
        return s;
    }

    /// Render a variable declaration as `const|mut <name>: <Type>`,
    /// matching the source-level form.  `is_global` doesn't get a
    /// dedicated marker - the type already conveys what matters.
    /// For globals with a literal initializer, the value is appended:
    /// `const ENOENT: i32 = 2` - useful for errno-style constant tables
    /// where the value is the relevant fact about the binding.
    format_variable_decl(&this, v: VarDeclNode*) -> string {
        if (v == null) { return ""; }
        mut sig: string = if (v.is_mutable) { "mut " } else { "const " };
        sig = sig + this.arena.intern_table.resolve(v.name);
        sig = sig + ": ";
        if (v.initializer != null && v.initializer.kind == NodeKind::LambdaExpression) {
            sig = sig + this.format_lambda_signature(v.initializer as LambdaExprNode*);
        } else {
            sig = sig + this.arena.resolve_display_name_short(v.resolved_type.id);
        }
        if (v.is_global && v.initializer != null) {
            const init: string = HoverEngine::literal_text(v.initializer);
            if (init != "") { sig = sig + " = " + init; }
        }
        return sig;
    }

    /// True when `v` is a method receiver parameter (`&this` /
    /// `mut &this` / `this`).  The parser stores the literal lexeme
    /// (`&this` etc.) as the param's `name`, so a string-content match
    /// against the interned name is the most direct way to detect it.
    is_receiver_param(&this, v: VarDeclNode*) -> boolean {
        if (v == null) { return false; }
        const name_str: string = this.arena.intern_table.resolve(v.name);
        return strcmp(name_str, "&this") == 0
            || strcmp(name_str, "this")  == 0;
    }

    /// Render `<param_name>: <Bound1> + <Bound2>` for the generic param
    /// on `node`.  Walks every bound on the decl whose `type_parameter`
    /// matches `param_name` and joins their trait-ref leaves with `+` -
    /// mirrors how `format_where_clause` renders the source side.
    format_generic_param_at(&this, node: ASTNode*, param_name: SymbolStr) -> string {
        if (this.intern == null || !param_name.is_valid()) { return ""; }
        mut s: string = this.intern.resolve(param_name);
        const bounds: TraitBound[]* = HoverEngine::bounds_of_decl(node);
        if (bounds == null) { return s; }
        mut first_ref: boolean = true;
        for (mut bi: i64 = 0; bi < bounds.length; bi++) {
            const b: &TraitBound = &(*bounds)[bi];
            if (!b.type_parameter.equals(param_name)) { continue; }
            for (mut ti: i64 = 0; ti < b.trait_refs.length; ti++) {
                if (first_ref) {
                    s = s + ": " + this.format_trait_ref(&b.trait_refs[ti]);
                    first_ref = false;
                } else {
                    s = s + " + " + this.format_trait_ref(&b.trait_refs[ti]);
                }
            }
        }
        return s;
    }

    /// The generic-param name a type denotes, or empty if it isn't a bare
    /// generic / bounded param.  Peels Reference / Pointer so `mut &I` and
    /// `I*` still report `I` - a receiver or by-pointer field typed on a
    /// generic param should still surface the param's bound.
    generic_param_name_of(&this, ty: TypeRef) -> SymbolStr {
        if (this.arena == null || !ty.is_valid()) { return SymbolStr::empty(); }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return SymbolStr::empty(); }
        if (t.kind == TypeKind::GenericParam) {
            return (t as GenericParamType*).param_name;
        }
        if (t.kind == TypeKind::BoundedParam) {
            return (t as BoundedParamType*).param_name;
        }
        if (t.kind == TypeKind::Reference) {
            return this.generic_param_name_of((t as ReferenceType*).referent);
        }
        if (t.kind == TypeKind::Pointer) {
            return this.generic_param_name_of((t as PointerType*).pointee);
        }
        return SymbolStr::empty();
    }

    /// Render the ` where <pname>: <T1> + <T2>` suffix for `pname` if the
    /// matching bound is present in `bounds`, else "".  Inline form: the
    /// caller concatenates it right after the type (`inner: I where
    /// I: Iterator`).
    render_where_for_param(&this, bounds: &TraitBound[], pname: SymbolStr) -> string {
        if (this.intern == null) { return ""; }
        for (mut i: i64 = 0; i < bounds.length; i++) {
            const b: &TraitBound = &bounds[i];
            if (!b.type_parameter.equals(pname)) { continue; }
            if (b.trait_refs.length == 0) { continue; }
            mut s: string = " where " + this.intern.resolve(pname) + ": ";
            for (mut j: i64 = 0; j < b.trait_refs.length; j++) {
                if (j > 0) { s = s + " + "; }
                s = s + this.format_trait_ref(&b.trait_refs[j]);
            }
            return s;
        }
        return "";
    }

    /// Find the ` where <pname>: <traits>` suffix visible at cursor position
    /// `(file, line, col)` for generic param `pname`.  A param's bound can
    /// sit on either the enclosing function/method's own `where` clause OR
    /// the enclosing impl block's `where` clause - the common case: a struct
    /// field typed `I` carries no bound on the struct, but the impl that
    /// operates on it declares `implement<I> ... where I: Iterator`.  Scans
    /// the file's top-level decls for whichever encloses the cursor.  Empty
    /// when no enclosing decl bounds `pname` (an unconstrained param).
    generic_param_where_suffix(&this, pname: SymbolStr, file: string,
                               line: u32, col: u32) -> string {
        if (this.graph == null || this.intern == null || !pname.is_valid()) {
            return "";
        }
        const mod_idx: i64 = this.graph.find_module_by_path(file);
        if (mod_idx < 0) { return ""; }
        const ast: ProgramNode* = this.graph.get_module_ast(mod_idx as u32);
        if (ast == null) { return ""; }
        for (mut si: i64 = 0; si < ast.statements.length; si++) {
            const stmt: ASTNode* = HoverEngine::unwrap_top_decl(ast.statements[si]);
            if (stmt == null) { continue; }
            if (stmt.kind == NodeKind::ImplementationBlock) {
                const ib: ImplBlockNode* = stmt as ImplBlockNode*;
                // The impl's span covers head-through-closing-brace, so a
                // cursor anywhere inside a method body maps to this impl.
                if (!node_locator::span_contains(ib.span, line, col)) { continue; }
                const s: string = this.render_where_for_param(&ib.where_bounds, pname);
                if (s != "") { return s; }
                // A method may add its own `where` on top of the impl's.
                for (mut mi: i64 = 0; mi < ib.methods.length; mi++) {
                    const m: MethodNode* = ib.methods[mi];
                    if (m == null || m.func == null) { continue; }
                    if (!node_locator::span_contains(m.span, line, col)) { continue; }
                    const ms: string = this.render_where_for_param(
                        &m.func.trait_bounds, pname);
                    if (ms != "") { return ms; }
                }
                return "";
            }
            if (stmt.kind == NodeKind::FunctionDeclaration) {
                const f: FunctionDeclNode* = stmt as FunctionDeclNode*;
                if (!node_locator::span_contains(f.span, line, col)) { continue; }
                const s: string = this.render_where_for_param(&f.trait_bounds, pname);
                if (s != "") { return s; }
            }
        }
        return "";
    }

    /// If `ty` is a bare generic param bound in the context at
    /// `(file, line, col)`, append its ` where <p>: <traits>` suffix to
    /// `content` (inline form).  No-op when `content` is empty, `ty` isn't
    /// a generic param, or the param is unconstrained here.  The single
    /// entry point the render sites (field / member / identifier-use) call
    /// so the bound-surfacing rule lives in one place.
    append_param_bound(&this, content: string, ty: TypeRef, file: string,
                       line: u32, col: u32) -> string {
        if (content == "") { return content; }
        const pname: SymbolStr = this.generic_param_name_of(ty);
        if (!pname.is_valid()) { return content; }
        return content + this.generic_param_where_suffix(pname, file, line, col);
    }

    /// The type `This` stands for, as code.  `node` is the enclosing
    /// function/method decl the `This` token sits in (a signature-position
    /// cursor lands on it - and the return-type token is outside the body a
    /// position walk would search).  In a trait method `This` is the
    /// implementing type, bounded by the enclosing trait -> `This: Iterator`.
    /// In an impl/inherent method it is that concrete owner -> `This = ChainIter`.
    /// Bare `This` when neither can be determined.
    this_reference_type(&this, node: ASTNode*) -> string {
        mut f: FunctionDeclNode* = null;
        if (node.kind == NodeKind::FunctionDeclaration) {
            f = node as FunctionDeclNode*;
        } else if (node.kind == NodeKind::MethodDeclaration) {
            f = (node as MethodNode*).func;
        }
        if (f != null) {
            const trait_owner: SymbolStr = node_locator::find_trait_for_function(
                this.graph, f);
            if (trait_owner.is_valid()) {
                return "This: " + HoverEngine::leaf_after_separator(
                    this.intern.resolve(trait_owner));
            }
        }
        if (node.kind == NodeKind::MethodDeclaration) {
            const owner: SymbolStr = node_locator::find_method_owner(
                this.graph, node as MethodNode*);
            if (owner.is_valid()) {
                return "This = " + HoverEngine::leaf_after_separator(
                    this.intern.resolve(owner));
            }
        }
        return "This";
    }

    /// True when the context at `(file, line, col)` declares a generic
    /// parameter named `name` - on the enclosing function/method, or the
    /// enclosing impl block, or the enclosing trait.  Lets an unbound
    /// param token (`J` in `ZipIter<This, J>`) hover as its bare name
    /// rather than falling back to the whole enclosing type.
    enclosing_declares_generic_param(&this, name: SymbolStr, node: ASTNode*,
                                     file: string, line: u32, col: u32) -> boolean {
        if (this.graph == null || !name.is_valid()) { return false; }
        // The located decl itself (a signature-position cursor - `J` in a
        // return type - lands on the method/function decl whose own
        // generic params a position walk of the body would never reach).
        if (HoverEngine::param_list_has(
                HoverEngine::generic_params_of_decl(node), name)) {
            return true;
        }
        const f: FunctionDeclNode* = node_locator::find_enclosing_function(
            this.graph, file, line, col);
        if (f != null && HoverEngine::param_list_has(&f.generic_params, name)) {
            return true;
        }
        const mod_idx: i64 = this.graph.find_module_by_path(file);
        if (mod_idx < 0) { return false; }
        const ast: ProgramNode* = this.graph.get_module_ast(mod_idx as u32);
        if (ast == null) { return false; }
        for (mut si: i64 = 0; si < ast.statements.length; si++) {
            const stmt: ASTNode* = HoverEngine::unwrap_top_decl(ast.statements[si]);
            if (stmt == null) { continue; }
            if (!node_locator::span_contains(stmt.span, line, col)) { continue; }
            if (HoverEngine::param_list_has(
                    HoverEngine::generic_params_of_decl(stmt), name)) {
                return true;
            }
        }
        return false;
    }

    /// True when `params` (may be null) contains a generic param named `name`.
    static param_list_has(params: GenericParamNode*[]*, name: SymbolStr) -> boolean {
        if (params == null) { return false; }
        for (mut i: i64 = 0; i < (*params).length; i++) {
            const gp: GenericParamNode* = (*params)[i];
            if (gp != null && gp.name.equals(name)) { return true; }
        }
        return false;
    }

    /// Render a method receiver as `this: <ReceiverType>`.  The receiver
    /// type is whatever sema resolved on the synthetic `&this` /
    /// `mut &this` / `this` `VarDeclNode` - that already includes the
    /// `&` / `&mut` / value shape, so the formatter doesn't need to
    /// reconstruct it from the name lexeme.
    format_receiver(&this, v: VarDeclNode*) -> string {
        // A by-value `this` receiver in a template has no resolved self type;
        // render bare `this` (as written) rather than `this: ?`.
        if (!v.resolved_type.is_valid()) { return "this"; }
        return "this: " + this.arena.resolve_display_name_short(v.resolved_type.id);
    }

    /// Re-render an identifier use with an explicit type-annotation
    /// string instead of the arena's short display.  Mirrors
    /// `format_identifier_use`'s per-SymbolKind formatting so the
    /// fallback shape stays consistent with the primary path.
    rebuild_identifier_use_with_annotation(&this, sym: Symbol, type_str: string,
                                           init_str: string) -> string {
        const name_str: string = if (this.intern != null) {
            this.intern.resolve(sym.name)
        } else {
            ""
        };
        const init_suffix: string = if (init_str != "") { " = " + init_str } else { "" };

        return match (sym.kind) {
            SymbolKind::Variable  => {
                const prefix: string = if (sym.is_mutable) { "mut " } else { "const " };
                prefix + name_str + ": " + type_str + init_suffix
            }
            SymbolKind::Constant  => {
                "const " + name_str + ": " + type_str + init_suffix
            }
            SymbolKind::Parameter => {
                // A parameter is an immutable binding unless declared `mut`,
                // so render it the same as a local: `const` / `mut`.  This
                // keeps a param's use-site hover consistent with its
                // declaration hover (`format_variable_decl`), which already
                // prefixes `const`.
                const prefix: string = if (sym.is_mutable) { "mut " } else { "const " };
                prefix + name_str + ": " + type_str
            }
            SymbolKind::Field     => {
                "field " + name_str + ": " + type_str
            }
            _                     => { type_str }
        };
    }

    /// Render an identifier use as the declaration form of the symbol it
    /// resolves to: `const body_str: Str` for a const local,
    /// `mut body_str: Str` for a mutable local, `body_str: Str` for a
    /// parameter (with `mut` prefix when the param itself is mutable),
    /// `<name>: <Type>` for a field reached via `this.<name>` or similar.
    /// `ty` is the use-site's resolved type (already short-formatted so
    /// callers don't have to re-resolve through the arena).  `init_str`
    /// is the literal text of the symbol's initializer (empty when the
    /// symbol has no literal value or isn't a top-level const) - appended
    /// as ` = <value>` so a hovered errno reads `const ENOENT: i32 = 2`.
    format_identifier_use(&this, sym: Symbol, ty: TypeRef, init_str: string) -> string {
        const type_str: string = this.arena.resolve_display_name_short(ty.id);
        const name_str: string = this.arena.intern_table.resolve(sym.name);
        const init_suffix: string = if (init_str != "") { " = " + init_str } else { "" };

        return match (sym.kind) {
            SymbolKind::Variable  => {
                const prefix: string = if (sym.is_mutable) { "mut " } else { "const " };
                prefix + name_str + ": " + type_str + init_suffix
            }
            SymbolKind::Constant  => {
                "const " + name_str + ": " + type_str + init_suffix
            }
            SymbolKind::Parameter => {
                // A parameter is an immutable binding unless declared `mut`,
                // so render it the same as a local: `const` / `mut`.  Keeps a
                // param's use-site hover consistent with its declaration
                // hover (`format_variable_decl`), which prefixes `const`.
                const prefix: string = if (sym.is_mutable) { "mut " } else { "const " };
                prefix + name_str + ": " + type_str
            }
            SymbolKind::Field     => {
                "field " + name_str + ": " + type_str
            }
            // For Function/Method/Type/etc. just show the type - the
            // ScopeResolution and decl-name branches above already handle
            // the signature-rich cases.
            _                     => { type_str }
        };
    }

    /// `is_variadic` renders the function's varargs the way source spells
    /// them.  Two forms (see `parse_parameter_list`): the named tail
    /// `args...` keeps its param in the list (so the body can reference
    /// it) but with NO type annotation - rendered `args...`; the bare
    /// extern-C `...` pushes no param at all - rendered as a trailing
    /// `...` after the fixed params.
    format_params(&this, params: &VarDeclNode*[], is_variadic: boolean) -> string {
        mut named_va_idx: i64 = -1;
        if (is_variadic && params.length > 0) {
            const last: VarDeclNode* = params[params.length - 1];
            if (last != null && last.type_annotation == null) {
                const lraw: string = this.arena.intern_table.resolve(last.name);
                // Never mistake an annotation-less receiver for the
                // variadic tail (a by-value `this` in a trait template).
                if (strcmp(HoverEngine::param_name_display(lraw), "this") != 0) {
                    named_va_idx = params.length - 1;
                }
            }
        }
        mut s: string = "(";
        for (mut i: i64 = 0; i < params.length; i++) {
            if (i > 0) { s = s + ", "; }
            const p: VarDeclNode* = params[i];
            if (p == null) { continue; }
            const raw: string = this.arena.intern_table.resolve(p.name);
            s = s + HoverEngine::param_name_display(raw);
            if (i == named_va_idx) {
                s = s + "...";
                continue;
            }
            // A by-value `this` receiver in a trait template has no resolved
            // self type yet - render bare `this` (as written in source),
            // not `this: ?`.  The `&this` / `mut &this` forms always carry a
            // valid reference type, so they still show `this: mut &Type`.
            if (strcmp(raw, "this") == 0 && !p.resolved_type.is_valid()) {
                // bare receiver, no type suffix
            } else {
                s = s + ": ";
                s = s + this.arena.resolve_display_name_short(p.resolved_type.id);
            }
        }
        if (is_variadic && named_va_idx < 0) {
            if (params.length > 0) { s = s + ", "; }
            s = s + "...";
        }
        return s + ")";
    }

    /// A receiver parameter is stored under its literal lexeme (`&this`,
    /// `mut &this`, or `&mut this`); render all three as just `this` so a
    /// signature reads `next(this: mut &This)`, not `next(&this: ...)`.  The
    /// borrow/mutability shape already shows in the param's type.  Any other
    /// name passes through unchanged.
    static param_name_display(name: string) -> string {
        if (strcmp(name, "&this")     == 0) { return "this"; }
        if (strcmp(name, "mut &this") == 0) { return "this"; }
        if (strcmp(name, "&mut this") == 0) { return "this"; }
        return name;
    }

    /// Render a numeric literal as `<value>: <inferred-type>` - for
    /// example `42: i32`, `0xFF: u8`, `3.14: f64`.  The type comes from
    /// `resolved_type` which sema fills in based on the surrounding
    /// context, so the same literal can hover differently depending on
    /// where it appears (annotation, parameter type, arithmetic peer).
    /// When sema bails, the type slot is `?` rather than empty so the
    /// hover still reads sensibly.
    format_numeric_literal(&this, lit: LiteralNode*) -> string {
        if (lit == null) { return ""; }
        const ty: TypeRef = lit.resolved_type;
        const type_str: string = if (ty.is_valid()) {
            this.arena.resolve_display_name_short(ty.id)
        } else { "?" };
        return lit.value + ": " + type_str;
    }

    /// Render a variant as `<EnumName>::<VariantName> = <discriminant>`
    /// for unit-only variants, or `<EnumName>::<VariantName>(<types>)`
    /// when the variant carries associated types.  Discriminant is the
    /// explicit value when set, otherwise the variant's index in source
    /// order - Cryo enums start at 0 and step by one.
    format_enum_variant(&this, parent: EnumDeclNode*, variant: EnumVariantNode*) -> string {
        if (parent == null || variant == null) { return ""; }
        mut sig: string = this.arena.intern_table.resolve(parent.name);
        sig = sig + "::" + this.arena.intern_table.resolve(variant.name);

        if (variant.associated_types.length > 0) {
            sig = sig + "(";
            for (mut i: i64 = 0; i < variant.associated_types.length; i++) {
                if (i > 0) { sig = sig + ", "; }
                sig = sig + this.format_annotation(variant.associated_types[i]);
            }
            return sig + ")";
        }

        const disc: i64 = if (variant.has_value) {
            variant.explicit_value
        } else {
            HoverEngine::variant_auto_index(parent, variant)
        };
        return sig + " = " + HoverEngine::i64_to_text(disc);
    }

    /// Render a payload binding from an enum pattern (`value` in
    /// `Option::Some(value)`) as `value: <payload type>`.  The type is the
    /// matched variant's declared associated type at the binding's
    /// positional index (`Some(T)` -> `T`); falls back to the bare name
    /// when the enum/variant/position can't be resolved.
    format_pattern_binding(&this, ep: EnumPatternNode*, index: i64,
                           pb: PatternBinding*) -> string {
        if (pb == null) { return ""; }
        mut s: string = this.intern.resolve(pb.name);
        const td: ASTNode* = node_locator::find_type_decl_in_modules(
            this.graph, this.intern, ep.enum_name);
        if (td != null && td.kind == NodeKind::EnumDeclaration) {
            const ed: EnumDeclNode* = td as EnumDeclNode*;
            const v: EnumVariantNode* = HoverEngine::find_variant_in_enum(
                ed, ep.variant_name);
            if (v != null && index >= 0 && index < v.associated_types.length) {
                const ann: string = this.format_annotation(v.associated_types[index]);
                if (ann != "" && ann != "?") { s = s + ": " + ann; }
            }
        }
        return s;
    }

    /// AST fallback for an identifier the resolver didn't track (a use
    /// inside a trait default-method / generic template body, where sema
    /// records no span->sym).  If the enclosing function declares a
    /// parameter of that name, render it as its declaration form
    /// (`const pred: (This::Item) -> boolean`).  Empty when no enclosing
    /// function or no matching parameter.
    identifier_as_param(&this, name: SymbolStr, file: string,
                        line: u32, col: u32) -> string {
        const f: FunctionDeclNode* = node_locator::find_enclosing_function(
            this.graph, file, line, col);
        if (f == null) { return ""; }
        for (mut i: i64 = 0; i < f.parameters.length; i++) {
            const p: VarDeclNode* = f.parameters[i];
            if (p == null || !p.name.equals(name)) { continue; }
            if (this.is_receiver_param(p)) { return this.format_receiver(p); }
            mut s: string = if (p.is_mutable) { "mut " } else { "const " };
            s = s + this.intern.resolve(p.name) + ": ";
            if (p.resolved_type.is_valid()) {
                s = s + this.arena.resolve_display_name_short(p.resolved_type.id);
            } else if (p.type_annotation != null) {
                s = s + this.format_annotation(p.type_annotation);
            } else {
                s = s + "?";
            }
            return s;
        }
        return "";
    }

    /// AST fallback for a pattern-binding *use* the resolver didn't track
    /// (`value` in `Some(value) => pred(value)`).  Find the enclosing match
    /// arm, scan its enum patterns for a binding of that name, and render it
    /// (`value: <payload type>`).  Empty when no enclosing arm binds it.
    identifier_as_pattern_binding(&this, name: SymbolStr, file: string,
                                  line: u32, col: u32) -> string {
        const arm: MatchArmNode* = NodeLocator::find_enclosing_match_arm(
            this.graph, file, line, col);
        if (arm == null) { return ""; }
        for (mut pi: i64 = 0; pi < arm.patterns.length; pi++) {
            const pn: PatternNode* = arm.patterns[pi];
            if (pn == null || pn.pattern_kind != PatternKind::Enum) { continue; }
            const ep: EnumPatternNode* = pn as EnumPatternNode*;
            for (mut ei: i64 = 0; ei < ep.elements.length; ei++) {
                const pb: PatternBinding* = ep.binding_at(ei);
                if (pb == null || !pb.name.equals(name)) { continue; }
                return this.format_pattern_binding(ep, ei, pb);
            }
        }
        return "";
    }


    // Graph / ctx queries

    /// Walk the module graph to the decl at `decl_span` and return the
    /// initializer literal as text - empty when the decl isn't a global
    /// const, has no initializer, or the initializer isn't a literal we
    /// can render compactly.  Used to enrich identifier-use hovers for
    /// errno-style const tables (`const ENOENT: i32 = 2`).
    const_initializer_text(&this, decl_span: SourceSpan) -> string {
        const v: VarDeclNode* = this.var_decl_at_span(decl_span);
        if (v == null)             { return ""; }
        if (!v.is_global)          { return ""; }
        if (v.initializer == null) { return ""; }
        return HoverEngine::literal_text(v.initializer);
    }

    /// Locate a `VarDeclNode` at the start position of `decl_span`.
    /// Returns `null` when the span isn't reachable in the graph or the
    /// node at that position isn't a variable decl.  Shared between the
    /// initializer-text helper and the Pattern-identifier dispatch.
    var_decl_at_span(&this, decl_span: SourceSpan) -> VarDeclNode* {
        if (this.graph == null)                  { return null; }
        if (decl_span.file == "")                { return null; }
        if (strlen(decl_span.file) == 0 as u64)  { return null; }
        if (!decl_span.has_location())           { return null; }

        const mod_idx: i64 = this.graph.find_module_by_path(decl_span.file);
        if (mod_idx < 0) { return null; }
        const ast: ProgramNode* = this.graph.get_module_ast(mod_idx as u32);
        if (ast == null) { return null; }

        const node: ASTNode* = node_locator::find_innermost_node_at(
            ast, decl_span.start_line, decl_span.start_col);
        if (node == null) { return null; }
        if (node.kind != NodeKind::VariableDeclaration) { return null; }
        return node as VarDeclNode*;
    }

    /// When a receiver's carrier resolves to a generic parameter name
    /// (`T`, `W`, ...), method lookup on the bare param fails because no
    /// struct named `T` exists.  Find the enclosing function, scan its
    /// `trait_bounds[]` for the param, and look up `method_name` on the
    /// bounded trait.  Returns the trait method's FunctionDeclNode, or
    /// null when no trait bound carries that method.
    ///
    /// The hover handler treats null as "fall through to normal method/
    /// field lookup" - for non-generic receivers this returns null
    /// immediately because no trait_bound's `type_parameter` matches.
    trait_method_for_generic_receiver(&this, file_path: string, line: u32,
                                      character: u32, carrier: SymbolStr,
                                      method_name: SymbolStr) -> FunctionDeclNode* {
        if (!carrier.is_valid())     { return null; }
        if (!method_name.is_valid()) { return null; }

        // The bound on `carrier` can sit on either the enclosing function/
        // method's own `where` clause OR the enclosing impl block's `where`
        // clause.  The impl case is the common one: a struct field typed
        // `J` carries no bound on the struct, but the impl operating on it
        // declares `implement<I, J, A> ... where J: Iterator<A>` - so
        // `this.second.next()` inside that impl resolves `next` through the
        // impl's `where_bounds`, not the `next` method's own (empty) ones.

        // 1. Enclosing function/method's own trait bounds.
        const fdecl: FunctionDeclNode* = node_locator::find_enclosing_function(
            this.graph, file_path, line, character);
        if (fdecl != null) {
            const f: FunctionDeclNode* = this.trait_method_from_bounds(
                &fdecl.trait_bounds, carrier, method_name);
            if (f != null) { return f; }
        }

        // 2. Enclosing impl block's where clause.  Its span covers the whole
        //    body, so a cursor inside any method maps to this impl.
        if (this.graph != null && file_path != "") {
            const mod_idx: i64 = this.graph.find_module_by_path(file_path);
            if (mod_idx >= 0) {
                const ast: ProgramNode* = this.graph.get_module_ast(mod_idx as u32);
                if (ast != null) {
                    for (mut si: i64 = 0; si < ast.statements.length; si++) {
                        const stmt: ASTNode* = HoverEngine::unwrap_top_decl(
                            ast.statements[si]);
                        if (stmt == null) { continue; }
                        if (stmt.kind != NodeKind::ImplementationBlock) { continue; }
                        const ib: ImplBlockNode* = stmt as ImplBlockNode*;
                        if (!node_locator::span_contains(ib.span, line, character)) {
                            continue;
                        }
                        const f: FunctionDeclNode* = this.trait_method_from_bounds(
                            &ib.where_bounds, carrier, method_name);
                        if (f != null) { return f; }
                    }
                }
            }
        }
        return null;
    }

    /// Scan `bounds` for one whose `type_parameter` equals `carrier`, then
    /// look up `method_name` on each trait the bound names (left-to-right,
    /// first match wins) - a multi-bound `T: Display + Debug` where both
    /// declare the method is unusual, so source order is the truest read.
    /// Returns the trait method's FunctionDeclNode, or null.
    trait_method_from_bounds(&this, bounds: &TraitBound[], carrier: SymbolStr,
                             method_name: SymbolStr) -> FunctionDeclNode* {
        for (mut bi: i64 = 0; bi < bounds.length; bi++) {
            const b: &TraitBound = &bounds[bi];
            if (!b.type_parameter.equals(carrier)) { continue; }
            for (mut ti: i64 = 0; ti < b.trait_refs.length; ti++) {
                const tref: &TraitRef = &b.trait_refs[ti];
                if (tref.path.length == 0) { continue; }
                const trait_leaf: SymbolStr = tref.path[tref.path.length - 1];
                const f: FunctionDeclNode* = node_locator::find_trait_method_in_modules(
                    this.graph, this.intern, trait_leaf, method_name);
                if (f != null) { return f; }
            }
        }
        return null;
    }

    /// AST-side companion to `unwrap_to_carrier`.  Recover the receiver's
    /// carrier-type SymbolStr from the AST when sema didn't stamp a usable
    /// resolved_type - primarily for member-access hovers inside generic
    /// function bodies where `f.resolved_type` is invalid because sema
    /// type-checked the body with unresolved generic params.
    ///
    /// Path:
    ///   1. `recv` must be an IdentifierNode.
    ///   2. Look up the resolver symbol for that identifier.
    ///   3. Find the declaring VarDeclNode (parameter or local).
    ///   4. Walk the TypeAnnotation, peeling Reference/Pointer/Generic
    ///      wrappers, and return the SymbolStr of the leaf Named node.
    ///
    /// Returns `SymbolStr::empty()` when any step misses.  All callers
    /// treat an empty result as "no fallback available" and skip the
    /// method lookup.
    receiver_carrier_name_from_annotation(&this, recv: ExpressionNode*) -> SymbolStr {
        if (recv == null) { return SymbolStr::empty(); }
        if (recv.kind != NodeKind::Identifier) { return SymbolStr::empty(); }
        if (this.ctx.resolver == null) { return SymbolStr::empty(); }

        const id: IdentifierNode* = recv as IdentifierNode*;

        // `this` is parsed as an IdentifierNode but the resolver has no
        // symbol entry for it (it's the synthesised receiver, not a
        // user-bound name).  Recover the carrier type by scanning the
        // module graph for the method whose body span covers `this`'s
        // position - that method's owner IS the carrier type.
        if (id.name.is_valid() && this.intern != null) {
            const this_sym: SymbolStr = this.intern.intern("this");
            if (id.name.equals(this_sym) && id.span.has_location()) {
                return node_locator::find_enclosing_method_owner(
                    this.graph, id.span.file,
                    id.span.start_line, id.span.start_col);
            }
        }

        const sym_id: SymbolID = this.ctx.resolver.resolve(id.span);
        if (!sym_id.is_valid()) { return SymbolStr::empty(); }
        const sym: Symbol = this.ctx.resolver.get_symbol(sym_id);

        const v: VarDeclNode* = this.var_decl_at_span(sym.declaring_span);
        if (v == null) { return SymbolStr::empty(); }
        if (v.type_annotation == null) { return SymbolStr::empty(); }
        return HoverEngine::annotation_carrier_name(v.type_annotation);
    }

    /// Carrier-type SymbolStr for a receiver that is itself a field read
    /// (`this.second` in `this.second.next()`).  Sema often leaves such a
    /// nested member access's resolved_type unstamped in a template body,
    /// and `receiver_carrier_name_from_annotation` only handles identifier
    /// receivers - so recover the field's declared type from the AST:
    ///   1. `recv` must be a MemberAccess `<base>.<field>`.
    ///   2. Resolve the owner type of `<base>` (`this` -> enclosing method
    ///      owner; an identifier param/local -> its annotation carrier).
    ///   3. Find `<field>` on that owner and return its annotation's leaf
    ///      name (`J`), which the trait-method lookup keys on.
    /// Empty when any step misses.
    member_field_carrier_name(&this, recv: ExpressionNode*) -> SymbolStr {
        if (recv == null || recv.kind != NodeKind::MemberAccess) {
            return SymbolStr::empty();
        }
        const inner: MemberAccessNode* = recv as MemberAccessNode*;
        if (inner.object == null) { return SymbolStr::empty(); }

        // Owner type of the base object.
        mut owner: SymbolStr = SymbolStr::empty();
        if (inner.object.kind == NodeKind::Identifier && this.intern != null) {
            const base_id: IdentifierNode* = inner.object as IdentifierNode*;
            const this_sym: SymbolStr = this.intern.intern("this");
            if (base_id.name.is_valid() && base_id.name.equals(this_sym)
                    && base_id.span.has_location()) {
                owner = node_locator::find_enclosing_method_owner(
                    this.graph, base_id.span.file,
                    base_id.span.start_line, base_id.span.start_col);
            } else {
                // A named local/param whose type is a struct we can name.
                owner = this.receiver_carrier_name_from_annotation(inner.object);
            }
        }
        if (!owner.is_valid()) { return SymbolStr::empty(); }

        const fld: FieldDeclNode* = node_locator::find_field_in_modules(
            this.graph, this.intern, owner, inner.member);
        if (fld == null || fld.type_annotation == null) {
            return SymbolStr::empty();
        }
        return HoverEngine::annotation_carrier_name(fld.type_annotation);
    }

    /// Strip Reference, Pointer, and InstantiatedType wrappers from `ty`
    /// until a "carrier" type - the actual struct / class / enum the
    /// receiver names - is reached.  Method declarations register against
    /// the carrier's TypeRef, never against the borrow form or the spec
    /// instantiation wrapper, so any DI lookup that expects to find
    /// `Foo::bar` from a `&Foo<T>` receiver must unwrap first.
    ///
    /// Caps the chain at 6 hops as a safety net against malformed type
    /// arenas - a self-referential pointer would otherwise loop forever.
    unwrap_to_carrier(&this, ty: TypeRef) -> TypeRef {
        if (this.arena == null) { return ty; }
        mut cur: TypeRef = ty;
        mut hops: i64 = 0;
        while (hops < 6) {
            if (!cur.is_valid()) { return cur; }
            const t: Type* = this.arena.lookup(cur.id);
            if (t == null) { return cur; }
            if (t.kind == TypeKind::Reference) {
                const rt: ReferenceType* = t as ReferenceType*;
                cur = rt.referent;
            } else if (t.kind == TypeKind::Pointer) {
                const pt: PointerType* = t as PointerType*;
                cur = pt.pointee;
            } else if (t.kind == TypeKind::InstantiatedType) {
                // `Formatter<W>` -> unwrap to the bare `Formatter` template.
                // Methods are declared on the template's TypeRef; the
                // monomorphized spec re-registers them but the bare base
                // is what the DI's reverse map keys on for hover.
                const it: InstantiatedType* = t as InstantiatedType*;
                cur = it.generic_base;
            } else {
                return cur;
            }
            hops = hops + 1;
        }
        return cur;
    }

    /// Find the named type annotation under the cursor inside a static-match
    /// node - its scrutinee or any arm's type patterns.  Returns null when the
    /// node isn't a static match or the cursor isn't on a NAMED annotation
    /// (primitives return null here and are covered by the keyword-doc path).
    static_match_annotation_at(&this, node: ASTNode*, line: u32,
                               col: u32) -> NamedAnnotation* {
        if (node.kind == NodeKind::StaticMatchExpression) {
            const sm: StaticMatchExprNode* = node as StaticMatchExprNode*;
            return this.scan_static_match(sm.scrutinee, sm.arms, line, col);
        }
        if (node.kind == NodeKind::StaticMatchStatement) {
            const sm: StaticMatchStmtNode* = node as StaticMatchStmtNode*;
            return this.scan_static_match(sm.scrutinee, sm.arms, line, col);
        }
        return null;
    }

    /// Scan a static match's scrutinee then each arm type pattern for the named
    /// annotation covering `(line, col)`.  `find_named_annotation_at` handles
    /// descending into pointer/generic/reference wrappers and returns null for
    /// primitives and `This`.
    scan_static_match(&this, scrutinee: TypeAnnotation*,
                      arms: &StaticMatchArmNode*[], line: u32,
                      col: u32) -> NamedAnnotation* {
        if (scrutinee != null) {
            const n: NamedAnnotation* = node_locator::find_named_annotation_at(
                scrutinee, line, col);
            if (n != null) { return n; }
        }
        for (mut i: i64 = 0; i < arms.length; i++) {
            const arm: StaticMatchArmNode* = arms[i];
            if (arm == null) { continue; }
            for (mut j: i64 = 0; j < arm.type_patterns.length; j++) {
                const n: NamedAnnotation* = node_locator::find_named_annotation_at(
                    arm.type_patterns[j], line, col);
                if (n != null) { return n; }
            }
        }
        return null;
    }

    /// Unwrap only Reference / Pointer wrappers, PRESERVING an
    /// InstantiatedType so its generic args (`<K, V>`) survive in the
    /// display.  Companion to `unwrap_to_carrier`, which additionally strips
    /// the InstantiatedType down to its bare template base for method lookup.
    unwrap_ref_ptr(&this, ty: TypeRef) -> TypeRef {
        if (this.arena == null) { return ty; }
        mut cur: TypeRef = ty;
        mut hops: i64 = 0;
        while (hops < 6) {
            if (!cur.is_valid()) { return cur; }
            const t: Type* = this.arena.lookup(cur.id);
            if (t == null) { return cur; }
            if (t.kind == TypeKind::Reference) {
                cur = (t as ReferenceType*).referent;
            } else if (t.kind == TypeKind::Pointer) {
                cur = (t as PointerType*).pointee;
            } else {
                return cur;
            }
            hops = hops + 1;
        }
        return cur;
    }

    /// Owner-type prefix for a field hover - e.g. `EntriesRefIter<K, V>` for
    /// the `buckets` field reached through `this.buckets`, so the hover reads
    /// `EntriesRefIter<K, V>.buckets: Entry<K, V>**`.  Prefers the receiver
    /// expression's resolved type (Reference/Pointer peeled but the
    /// InstantiatedType kept so `<K, V>` shows); when sema left the receiver
    /// unstamped (generic template body) falls back to the carrier struct /
    /// class decl named by `type_sym`, rendered with its own generic params.
    /// Returns "" when no usable owner name is available, so callers can
    /// concatenate unconditionally.
    field_owner_display(&this, obj: ExpressionNode*, type_sym: SymbolStr) -> string {
        // Path A (preferred): the carrier's declaration + its declared generic
        // params, e.g. `EntriesRefIter<K, V>`.  This is the canonical decl
        // form and avoids the doubled-arg quirk (`EntriesRefIter<K, V, K, V>`)
        // that resolve_display_name_short produces for a `this` receiver whose
        // resolved type is an InstantiatedType wrapping a spec that already
        // carries its args in the display name.
        if (type_sym.is_valid() && this.graph != null && this.intern != null) {
            const decl: ASTNode* = node_locator::find_type_decl_in_modules(
                this.graph, this.intern, type_sym);
            if (decl != null) {
                const nm: SymbolStr = HoverEngine::decl_type_name(decl);
                if (nm.is_valid()) {
                    mut s: string = this.intern.resolve(nm);
                    const params: GenericParamNode*[]* =
                        HoverEngine::generic_params_of_decl(decl);
                    if (params != null) {
                        s = s + this.format_generic_params(*params);
                    }
                    return s;
                }
            }
        }
        // Path B (fallback): receiver's resolved type, ref/ptr peeled with
        // generics kept.  Used when the decl can't be located by name - e.g.
        // a receiver whose carrier lives outside the walkable module graph.
        if (obj != null && obj.resolved_type.is_valid() && this.arena != null) {
            const carrier: TypeRef = this.unwrap_ref_ptr(obj.resolved_type);
            if (carrier.is_valid()) {
                const s: string = this.arena.resolve_display_name_short(carrier.id);
                if (s != "" && s != "?") { return s; }
            }
        }
        return "";
    }

    /// Prefix a rendered field decl (`buckets: Entry<K, V>**`) with its owner
    /// type and a `.` separator when the owner is resolvable, yielding
    /// `EntriesRefIter<K, V>.buckets: Entry<K, V>**`.  Passes the field string
    /// through unchanged when no owner name is available.
    prefix_field_owner(&this, field_str: string, obj: ExpressionNode*,
                       type_sym: SymbolStr) -> string {
        const owner: string = this.field_owner_display(obj, type_sym);
        if (owner == "") { return field_str; }
        return owner + "." + field_str;
    }

    /// Name symbol of a struct / class / enum declaration node.  Returns an
    /// empty SymbolStr for other node kinds.
    static decl_type_name(node: ASTNode*) -> SymbolStr {
        if (node == null) { return SymbolStr::empty(); }
        if (node.kind == NodeKind::StructDeclaration) {
            return (node as StructDeclNode*).name;
        }
        if (node.kind == NodeKind::ClassDeclaration) {
            return (node as ClassDeclNode*).name;
        }
        if (node.kind == NodeKind::EnumDeclaration) {
            return (node as EnumDeclNode*).name;
        }
        return SymbolStr::empty();
    }

    function_decl_at_span(&this, decl_span: SourceSpan) -> FunctionDeclNode* {
        if (this.graph == null)                  { return null; }
        if (decl_span.file == "")                { return null; }
        if (strlen(decl_span.file) == 0 as u64)  { return null; }
        if (!decl_span.has_location())           { return null; }

        const mod_idx: i64 = this.graph.find_module_by_path(decl_span.file);
        if (mod_idx < 0) { return null; }
        const ast: ProgramNode* = this.graph.get_module_ast(mod_idx as u32);
        if (ast == null) { return null; }

        const node: ASTNode* = node_locator::find_innermost_node_at(
            ast, decl_span.start_line, decl_span.start_col);
        if (node == null) { return null; }
        if (node.kind != NodeKind::FunctionDeclaration) { return null; }
        return node as FunctionDeclNode*;
    }

    /// Build the namespace path for `imp.path_segments[0..=index]`,
    /// joined with `::`.  Used to find the matching `_module.cryo`
    /// (the file whose `namespace_name` equals this prefix).
    build_segment_path(&this, imp: ImportDeclNode*, index: i64) -> string {
        mut path: string = "";
        for (mut i: i64 = 0; i <= index; i++) {
            if (i > 0) { path = path + "::"; }
            path = path + this.intern.resolve(imp.path_segments[i]);
        }
        return path;
    }

    /// `::`-joined namespace path for `md.path_segments[0..=index]`.
    build_module_decl_path(&this, md: ModuleDeclNode*, index: i64) -> string {
        mut path: string = "";
        for (mut i: i64 = 0; i <= index; i++) {
            if (i > 0) { path = path + "::"; }
            path = path + this.intern.resolve(md.path_segments[i]);
        }
        return path;
    }

    /// Resolve an import-segment literal path to the absolute namespace
    /// path the loader would pick.  Stdlib imports inside stdlib source
    /// are written relative (`import core::option;`); the loader
    /// resolves them under `<stdlib>/`, which corresponds to the `std::`
    /// namespace prefix.  We try the literal first so absolute paths
    /// (and project-relative imports whose namespace already matches)
    /// stay correct, then `std::<literal>` as the fallback.  When
    /// neither matches a loaded module, we still prefer the candidate
    /// that has loaded *descendants* in the graph so the synth-children
    /// fallback in `format_namespace_overview` produces useful output.
    resolve_namespace_path(&this, literal: string) -> string {
        if (this.graph == null) { return literal; }
        if (node_locator::find_program_by_namespace(this.graph, literal) != null) {
            return literal;
        }
        const std_path: string = "std::" + literal;
        if (node_locator::find_program_by_namespace(this.graph, std_path) != null) {
            return std_path;
        }
        // Neither namespace is loaded - pick whichever has descendants
        // under it (so the children-synth fallback in the formatter
        // shows the expected sub-modules).  Prefer `std::` because
        // stdlib-relative is the dominant relative-import case.
        if (this.namespace_has_descendants(std_path))  { return std_path; }
        if (this.namespace_has_descendants(literal))   { return literal; }
        return literal;
    }

    /// True when any module in the graph declares a namespace whose
    /// path starts with `prefix::`.  Used by `resolve_namespace_path`
    /// to pick the candidate whose synth-children list will be
    /// non-empty.
    namespace_has_descendants(&this, prefix: string) -> boolean {
        if (this.graph == null) { return false; }
        const prefix_len: i64 = strlen(prefix) as i64;
        if (prefix_len == 0) { return false; }
        const n: u32 = this.graph.module_count();
        for (mut mi: u32 = 0; mi < n; mi++) {
            const ast: ProgramNode* = this.graph.get_module_ast(mi);
            if (ast == null) { continue; }
            const ns: string = ast.namespace_name;
            const ns_len: i64 = strlen(ns) as i64;
            if (ns_len <= prefix_len + 2) { continue; }
            if (ns[prefix_len] != ':' as i8 || ns[prefix_len + 1] != ':' as i8) {
                continue;
            }
            mut prefix_match: boolean = true;
            for (mut i: i64 = 0; i < prefix_len; i++) {
                if (ns[i] != prefix[i]) { prefix_match = false; break; }
            }
            if (prefix_match) { return true; }
        }
        return false;
    }

    /// Render the namespace overview for `path`: the `namespace X::Y;`
    /// line plus every `public module ...;` declaration in the matching
    /// `_module.cryo`.  When no `_module.cryo` for this namespace is in
    /// the graph (the compiler doesn't load ancestor module files
    /// proactively - only the leaf file directly imported is parsed),
    /// derive the sub-module list by walking all loaded modules and
    /// taking the unique next-segment of those whose namespace starts
    /// with `path::`.  That gives a useful "what's reachable under
    /// this namespace" view from already-parsed source.
    format_namespace_overview(&this, path: string) -> string {
        mut sig: string = "namespace " + path + ";";
        const prog: ProgramNode* = node_locator::find_program_by_namespace(this.graph, path);

        if (prog != null) {
            mut had_modules: boolean = false;
            for (mut i: i64 = 0; i < prog.statements.length; i++) {
                const stmt: ASTNode* = HoverEngine::unwrap_top_decl(prog.statements[i]);
                if (stmt == null) { continue; }
                if (stmt.kind != NodeKind::ModuleDeclaration) { continue; }
                const m: ModuleDeclNode* = stmt as ModuleDeclNode*;
                // Skip the file's own `namespace X::Y::Z;` line -
                // `parse_namespace_declaration` lowers it into a
                // ModuleDeclNode with the qualified path, but it isn't a
                // re-export of itself.
                if (strcmp(m.path, path) == 0) { continue; }
                if (!had_modules) { sig = sig + "\n"; had_modules = true; }
                sig = sig + "\n";
                if (m.is_public) { sig = sig + "public "; }
                sig = sig + "module " + m.path + ";";
            }
            if (had_modules) { return sig; }
        }

        // Fallback: synthesize the sub-module list from descendant
        // namespaces in the graph.  Each unique direct child becomes a
        // synthetic `module <name>;` line.
        if (this.graph == null) { return sig; }
        const path_len: i64 = strlen(path) as i64;
        mut children: string[] = [];
        const n: u32 = this.graph.module_count();
        for (mut mi: u32 = 0; mi < n; mi++) {
            const ast: ProgramNode* = this.graph.get_module_ast(mi);
            if (ast == null) { continue; }
            const ns: string = ast.namespace_name;
            const ns_len: i64 = strlen(ns) as i64;
            // Match `path` followed by `::` then a segment.
            if (ns_len <= path_len + 2) { continue; }
            if (ns[path_len] != ':' as i8 || ns[path_len + 1] != ':' as i8) { continue; }
            // Compare the prefix.
            mut prefix_match: boolean = true;
            for (mut i: i64 = 0; i < path_len; i++) {
                if (ns[i] != path[i]) { prefix_match = false; break; }
            }
            if (!prefix_match) { continue; }
            // Extract first child segment after `path::`.
            const child: string = HoverEngine::first_segment_after(ns, (path_len + 2 as i64) as i64);
            if (child == "") { continue; }
            if (!HoverEngine::contains_string(&children, child)) {
                children.push(child);
            }
        }
        if (children.length == 0) { return sig; }
        sig = sig + "\n";
        for (mut i: i64 = 0; i < children.length; i++) {
            sig = sig + "\nmodule " + children[i] + ";";
        }
        return sig;
    }

    /// The `///!` banner doc for namespace `path`: locate that namespace's
    /// program in the graph and read the `documentation` the parser
    /// attached to its own `namespace X::Y;` decl.  The self-namespace
    /// `ModuleDeclNode` is the one whose `path` equals `path` (same
    /// identification `format_namespace_overview` uses to *skip* it).
    /// Empty string when the namespace isn't loaded or has no banner.
    namespace_doc_for_path(&this, path: string) -> string {
        const prog: ProgramNode* = node_locator::find_program_by_namespace(this.graph, path);
        if (prog == null) { return ""; }
        for (mut i: i64 = 0; i < prog.statements.length; i++) {
            const stmt: ASTNode* = HoverEngine::unwrap_top_decl(prog.statements[i]);
            if (stmt == null) { continue; }
            if (stmt.kind != NodeKind::ModuleDeclaration) { continue; }
            const m: ModuleDeclNode* = stmt as ModuleDeclNode*;
            if (strcmp(m.path, path) == 0) { return m.documentation; }
        }
        return "";
    }

    /// Reverse-walk: given a variant node, find the enclosing
    /// `EnumDeclNode`.  Mirrors `find_method_owner` for methods -
    /// EnumVariantNodes don't carry a parent pointer so we scan the
    /// graph.  Returns `null` when nothing matches (shouldn't happen for
    /// a variant node the locator just returned).
    find_enum_for_variant(&this, variant: EnumVariantNode*) -> EnumDeclNode* {
        if (this.graph == null || variant == null) { return null; }
        const n: u32 = this.graph.module_count();
        for (mut mi: u32 = 0; mi < n; mi++) {
            const ast: ProgramNode* = this.graph.get_module_ast(mi);
            if (ast == null) { continue; }
            for (mut si: i64 = 0; si < ast.statements.length; si++) {
                const stmt: ASTNode* = HoverEngine::unwrap_top_decl(ast.statements[si]);
                if (stmt == null) { continue; }
                if (stmt.kind != NodeKind::EnumDeclaration) { continue; }
                const ed: EnumDeclNode* = stmt as EnumDeclNode*;
                for (mut vi: i64 = 0; vi < ed.variants.length; vi++) {
                    if (ed.variants[vi] == variant) { return ed; }
                }
            }
        }
        return null;
    }


    // Struct-literal hover

    /// Decide which sub-region of `IoError { kind: ..., os_code: ... }` the
    /// cursor hit, and render accordingly:
    ///
    ///   - Cursor before any field (the `IoError` token region) ->
    ///     full struct head, span = the type-name range
    ///   - Cursor on a field-init name -> `<field>: <Type>`, span = the
    ///     field-init's name segment (`init.span` start through
    ///     `init.value.span` start)
    ///   - Cursor in a field-init value -> empty (locator usually descends
    ///     into the value, so we rarely see this; keep as fallback)
    struct_literal_hover_at(&this, sl: StructLiteralNode*, line: u32, ch: u32) -> StructLiteralHover {
        mut result: StructLiteralHover = StructLiteralHover {
            content: "",
            span:    sl.span,
            doc:     "",
        };
        if (sl == null) { return result; }

        // Look up the struct/class decl whose name appears at the head.
        const decl: ASTNode* = node_locator::find_type_decl_in_modules(
            this.graph, this.intern, sl.struct_type);

        // Field-name dispatch.  For each field-init, the name occupies
        // [init.span.start_col, init.value.span.start_col) on
        // init.span.start_line.  Compare cursor (line, ch) against that
        // range; on hit, render the field decl.
        for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
            const init: FieldInit = sl.field_inits[i];
            if (init.value == null) { continue; }
            if (line != init.span.start_line) { continue; }

            const name_start: u32 = init.span.start_col;
            const name_end:   u32 = init.value.span.start_col;
            if (ch < name_start || ch >= name_end) { continue; }

            // Cursor is on the field name.  Look up the field on the
            // owning struct/class decl and render `<name>: <Type>`.
            if (decl != null) {
                const fld: FieldDeclNode* = HoverEngine::find_field_on_type_decl(
                    decl, init.field_name);
                if (fld != null) {
                    result.content = this.format_field_decl(fld);
                    result.span    = HoverEngine::field_init_name_span(init.span, init.value.span);
                    result.doc     = fld.documentation;
                    return result;
                }
            }

            // Decl unavailable - fall back to `name: <ResolvedValueType>`.
            const value_ty: TypeRef = init.value.resolved_type;
            if (value_ty.is_valid()) {
                result.content = this.arena.intern_table.resolve(init.field_name)
                    + ": " + this.arena.resolve_display_name_short(value_ty.id);
                result.span    = HoverEngine::field_init_name_span(init.span, init.value.span);
                return result;
            }
        }

        // Cursor wasn't on any field-init name span - treat it as a hit
        // on the struct-type token at the head of the literal.
        if (decl != null) {
            result.content = this.format_type_decl(decl);
            result.span    = this.struct_literal_head_span(sl);
            result.doc     = (decl as DeclarationNode*).documentation;
        }
        return result;
    }

    /// Span of the type-name token at the head of a struct literal.
    /// The literal's outer span starts at the type name; we trim it to
    /// just the identifier's length so the editor highlights `IoError`
    /// rather than `IoError { ... }`.
    struct_literal_head_span(&this, sl: StructLiteralNode*) -> SourceSpan {
        const name: string = if (this.intern != null) {
            this.intern.resolve(sl.struct_type)
        } else { "" };
        const name_len: u32 = strlen(name) as u32;
        return SourceSpan::new(
            sl.span.file,
            sl.span.start_line, sl.span.start_col,
            sl.span.start_line, sl.span.start_col + name_len);
    }


    // Stateless string / AST utilities (statics)

    /// Return everything after the final `::` in `s`, or `s` itself when
    /// there's no `::`.  Mirrors `extract_leaf_segment` in
    /// `compiler::types::arena` - duplicated here to avoid the cross-
    /// module import for one tiny string helper.
    static leaf_after_separator(s: string) -> string {
        const len: i64 = strlen(s) as i64;
        mut last_sep: i64 = -1;
        for (mut i: i64 = 0; i + 1 < len; i++) {
            if (s[i] == ':' && s[i + 1] == ':') { last_sep = i; }
        }
        if (last_sep < 0) { return s; }
        const start: i64 = last_sep + 2;
        if (start >= len) { return ""; }
        return s + start;
    }

    /// Return the type-annotation span on `node` that covers the
    /// cursor, if any.  Looks at the return-type annotation for
    /// functions and methods, and the type annotation for variables /
    /// fields.  Used to narrow the hover highlight when the cursor sits
    /// on a type token that isn't its own AST node.
    static annotation_span_at_cursor(node: ASTNode*, line: u32, ch: u32) -> SourceSpan {
        const ann: TypeAnnotation* = HoverEngine::annotation_for_decl(node);
        return node_locator::annotation_span(ann);
    }

    /// Scan a FunctionDeclNode or MethodNode's `trait_bounds[]` for a
    /// TraitRef whose span covers `(line, character)`.  Returns the
    /// leaf SymbolStr of the trait reference's qualified path (e.g.
    /// `FmtWrite` from `where W: FmtWrite`) - that's the name the
    /// `find_type_decl_in_modules` lookup keys on.  Returns
    /// `SymbolStr::empty()` when the cursor isn't on any trait ref.
    static trait_ref_at_cursor(node: ASTNode*, line: u32, character: u32) -> SymbolStr {
        const bounds: TraitBound[]* = HoverEngine::bounds_of_decl(node);
        if (bounds == null) { return SymbolStr::empty(); }
        for (mut bi: i64 = 0; bi < bounds.length; bi++) {
            const b: &TraitBound = &(*bounds)[bi];
            for (mut ti: i64 = 0; ti < b.trait_refs.length; ti++) {
                const tref: &TraitRef = &b.trait_refs[ti];
                if (!node_locator::span_contains(tref.span, line, character)) { continue; }
                if (tref.path.length == 0) { continue; }
                return tref.path[tref.path.length - 1];
            }
        }
        return SymbolStr::empty();
    }

    /// Companion to `trait_ref_at_cursor` - returns the span of the
    /// matching TraitRef so the hover can highlight the exact lexeme.
    static trait_ref_span_at_cursor(node: ASTNode*, line: u32, character: u32) -> SourceSpan {
        const bounds: TraitBound[]* = HoverEngine::bounds_of_decl(node);
        if (bounds == null) { return SourceSpan::none(); }
        for (mut bi: i64 = 0; bi < bounds.length; bi++) {
            const b: &TraitBound = &(*bounds)[bi];
            for (mut ti: i64 = 0; ti < b.trait_refs.length; ti++) {
                const tref: &TraitRef = &b.trait_refs[ti];
                if (node_locator::span_contains(tref.span, line, character)) {
                    return tref.span;
                }
            }
        }
        return SourceSpan::none();
    }

    /// Approximate span of the type-parameter portion of a `where`
    /// bound.  TraitBound stamps a single span over the whole `A:
    /// Trait + Trait2` lexeme and a separate span on each TraitRef; the
    /// type-parameter sits between `bound.span.start` and the first
    /// trait_ref's start.  Returns `SourceSpan::none()` when the cursor
    /// isn't on any param.
    static type_param_span_at_cursor(node: ASTNode*, line: u32, character: u32) -> SourceSpan {
        const bounds: TraitBound[]* = HoverEngine::bounds_of_decl(node);
        if (bounds == null) { return SourceSpan::none(); }
        for (mut bi: i64 = 0; bi < bounds.length; bi++) {
            const b: &TraitBound = &(*bounds)[bi];
            if (b.trait_refs.length == 0) { continue; }
            const first: &TraitRef = &b.trait_refs[0];
            // Build a synthetic span: same start as the bound, end at the
            // first trait ref's start (i.e. the position of `:`).
            const param_span: SourceSpan = SourceSpan::new(
                b.span.file,
                b.span.start_line, b.span.start_col,
                first.span.start_line, first.span.start_col);
            if (node_locator::span_contains(param_span, line, character)) {
                return param_span;
            }
        }
        return SourceSpan::none();
    }

    static type_param_at_cursor(node: ASTNode*, line: u32, character: u32) -> SymbolStr {
        const bounds: TraitBound[]* = HoverEngine::bounds_of_decl(node);
        if (bounds == null) { return SymbolStr::empty(); }
        for (mut bi: i64 = 0; bi < bounds.length; bi++) {
            const b: &TraitBound = &(*bounds)[bi];
            if (b.trait_refs.length == 0) { continue; }
            const first: &TraitRef = &b.trait_refs[0];
            const param_span: SourceSpan = SourceSpan::new(
                b.span.file,
                b.span.start_line, b.span.start_col,
                first.span.start_line, first.span.start_col);
            if (node_locator::span_contains(param_span, line, character)) {
                return b.type_parameter;
            }
        }
        return SymbolStr::empty();
    }

    /// Extract the `trait_bounds[]` (or impl-level `where_bounds[]`)
    /// slice from a decl whose head can carry a `where` clause.
    /// FunctionDeclNode owns its own bounds; MethodNode delegates to its
    /// inner `func`; ImplBlockNode keeps its head-level where clause in
    /// `where_bounds[]` rather than a per-method array.  Empty array for
    /// any other node kind.
    // Returns a BORROW (pointer into the AST node) of the decl's bounds array,
    // or null when the node has none.  Returning `f.trait_bounds` by value would
    // alias the owning `TraitBound[]` buffer into the caller's local, whose
    // scope-exit drop would then free a buffer the AST node still owns (double
    // free) - the static checker doesn't flag return-of-field, but the drop glue
    // still fires.  Callers read through the pointer (`(*bounds)[i]`).
    static bounds_of_decl(node: ASTNode*) -> TraitBound[]* {
        if (node == null) { return null; }
        if (node.kind == NodeKind::FunctionDeclaration) {
            const f: FunctionDeclNode* = node as FunctionDeclNode*;
            return &f.trait_bounds;
        }
        if (node.kind == NodeKind::MethodDeclaration) {
            const m: MethodNode* = node as MethodNode*;
            if (m.func == null) { return null; }
            return &m.func.trait_bounds;
        }
        if (node.kind == NodeKind::ImplementationBlock) {
            const b: ImplBlockNode* = node as ImplBlockNode*;
            return &b.where_bounds;
        }
        return null;
    }

    /// The `generic_params[]` a decl declares (function/method/impl/trait/
    /// struct/class/enum), or null for kinds without any.  Lets an unbound
    /// generic-param token be recognized as such at a use site.
    static generic_params_of_decl(node: ASTNode*) -> GenericParamNode*[]* {
        if (node == null) { return null; }
        if (node.kind == NodeKind::FunctionDeclaration) {
            return &(node as FunctionDeclNode*).generic_params;
        }
        if (node.kind == NodeKind::MethodDeclaration) {
            const m: MethodNode* = node as MethodNode*;
            if (m.func == null) { return null; }
            return &m.func.generic_params;
        }
        if (node.kind == NodeKind::ImplementationBlock) {
            return &(node as ImplBlockNode*).generic_params;
        }
        if (node.kind == NodeKind::TraitDeclaration) {
            return &(node as TraitDeclNode*).generic_params;
        }
        if (node.kind == NodeKind::StructDeclaration) {
            return &(node as StructDeclNode*).generic_params;
        }
        if (node.kind == NodeKind::ClassDeclaration) {
            return &(node as ClassDeclNode*).generic_params;
        }
        if (node.kind == NodeKind::EnumDeclaration) {
            return &(node as EnumDeclNode*).generic_params;
        }
        return null;
    }

    static annotation_for_decl(node: ASTNode*) -> TypeAnnotation* {
        if (node == null) { return null; }
        if (node.kind == NodeKind::FunctionDeclaration) {
            const f: FunctionDeclNode* = node as FunctionDeclNode*;
            return f.return_type_annotation;
        }
        if (node.kind == NodeKind::MethodDeclaration) {
            const m: MethodNode* = node as MethodNode*;
            if (m.func == null) { return null; }
            return m.func.return_type_annotation;
        }
        if (node.kind == NodeKind::VariableDeclaration) {
            const v: VarDeclNode* = node as VarDeclNode*;
            return v.type_annotation;
        }
        if (node.kind == NodeKind::FieldDeclaration) {
            const fld: FieldDeclNode* = node as FieldDeclNode*;
            return fld.type_annotation;
        }
        if (node.kind == NodeKind::TypeAliasDeclaration) {
            const ta: TypeAliasDeclNode* = node as TypeAliasDeclNode*;
            return ta.target_annotation;
        }
        return null;
    }

    /// True when `s` carries a `: ?` placeholder the arena uses for invalid
    /// type IDs.  Used by the hover handler to detect a sema miss (generic
    /// body, partial compile) and trigger the annotation fallback.  The `?`
    /// may sit at the end (`const x: ?`) or mid-string when a value suffix
    /// follows (`const INITIAL_BUCKETS: ? = 8`), so scan for the pattern
    /// rather than only inspecting the trailing three bytes.
    static contains_unknown_type(s: string) -> boolean {
        const len: i64 = strlen(s) as i64;
        for (mut i: i64 = 0; i + 2 < len; i++) {
            if (s[i] == ':' && s[i + 1] == ' ' && s[i + 2] == '?') {
                // Confirm it's the placeholder, not part of a larger token:
                // the `?` must end the type, i.e. be the last byte or be
                // followed by a space (` = <value>` initializer suffix).
                const after: i64 = i + 3;
                if (after >= len || s[after] == ' ') { return true; }
            }
        }
        return false;
    }

    static json_u32_field(obj: &JsonValue, key: string) -> u32 {
        match (obj.get(Str::from(key))) {
            Option::Some(v) => {
                match (v) {
                    JsonValue::Number(n) => {
                        match (n) {
                            JsonNumber::Int(i)   => {
                                if (i < 0) { return 0 as u32; }
                                return i as u32;
                            }
                            JsonNumber::UInt(u)  => { return u as u32; }
                            JsonNumber::Float(f) => {
                                if (f < 0.0) { return 0 as u32; }
                                return f as u32;
                            }
                        }
                    }
                    _ => { return 0 as u32; }
                }
            }
            Option::None => { return 0 as u32; }
        }
    }

    /// True when the cursor lands on a position where a token is being used
    /// AS an identifier - a declared name, an identifier use, or a namespace
    /// path segment - rather than as a language keyword.  Cryo accepts several
    /// keyword LEXEMES as identifiers in binding / path position (`default` as
    /// a param name, `core::default` as an import segment), so a byte-level
    /// keyword match at these sites is wrong; the caller uses this to suppress
    /// the keyword-doc hover and let the AST path render the real symbol.
    static cursor_on_name_position(node: ASTNode*, cline: u32, cchar: u32) -> boolean {
        if (node == null) { return false; }
        // Declared name (function / method / variable / parameter / field /
        // struct / ... - name_span_of covers every declaration kind).
        const nspan: SourceSpan = node_locator::name_span_of(node);
        if (node_locator::span_contains(nspan, cline, cchar)) { return true; }
        // Identifier use (`return default;`, `pred(value)`).
        if (node.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = node as IdentifierNode*;
            if (node_locator::span_contains(id.span, cline, cchar)) { return true; }
        }
        // `import A::B::C;` path segment.
        if (node.kind == NodeKind::ImportDeclaration) {
            const imp: ImportDeclNode* = node as ImportDeclNode*;
            for (mut i: i64 = 0; i < imp.path_segment_spans.length; i++) {
                if (node_locator::span_contains(imp.path_segment_spans[i], cline, cchar)) {
                    return true;
                }
            }
        }
        // `namespace A::B;` / `public module A::B;` path segment.
        if (node.kind == NodeKind::ModuleDeclaration) {
            const md: ModuleDeclNode* = node as ModuleDeclNode*;
            for (mut i: i64 = 0; i < md.path_segment_spans.length; i++) {
                if (node_locator::span_contains(md.path_segment_spans[i], cline, cchar)) {
                    return true;
                }
            }
        }
        return false;
    }

    /// Convert a 1-based compiler `SourceSpan` to a 0-based LSP `Range`.
    /// Used so the editor highlights the matched token while the tooltip
    /// is open - without a range the hover anchors to a single point.
    static range_from_span(span: SourceSpan) -> Range {
        mut sl: u32 = 0;
        mut sc: u32 = 0;
        mut el: u32 = 0;
        mut ec: u32 = 0;
        if (span.start_line > 0) { sl = span.start_line - 1; }
        if (span.start_col  > 0) { sc = span.start_col  - 1; }
        if (span.end_line   > 0) { el = span.end_line   - 1; }
        if (span.end_col    > 0) { ec = span.end_col    - 1; }
        return Lsp::Protocol::Lsp::Range::new(Position::new(sl, sc), Position::new(el, ec));
    }

    /// Render a literal-bearing expression to its source-level text.
    /// Handles bare `LiteralNode` and `-<literal>` UnaryExpressions
    /// (negative integer constants).  Returns "" for any other shape so
    /// hover never displays a partial expression - composite initializers
    /// like `(FOO | BAR)` are better shown by the user navigating to the
    /// decl itself.
    static literal_text(expr: ExpressionNode*) -> string {
        if (expr == null) { return ""; }
        if (expr.kind == NodeKind::Literal) {
            const l: LiteralNode* = expr as LiteralNode*;
            return l.value;
        }
        if (expr.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = expr as UnaryExprNode*;
            if (u.operand != null && u.operand.kind == NodeKind::Literal) {
                const l: LiteralNode* = u.operand as LiteralNode*;
                return "-" + l.value;
            }
        }
        return "";
    }

    /// Walk a `TypeAnnotation*`, peeling Reference/Pointer/Array/Optional/
    /// Generic wrappers, and return the SymbolStr of the innermost `Named`
    /// (or `Primitive`) annotation.  Empty SymbolStr if the leaf isn't a
    /// named carrier - function types, tuples, and ThisType don't have a
    /// single SymbolStr the DI can key on.
    static annotation_carrier_name(ann: TypeAnnotation*) -> SymbolStr {
        if (ann == null) { return SymbolStr::empty(); }
        mut cur: TypeAnnotation* = ann;
        mut hops: i64 = 0;
        while (hops < 6) {
            const result: SymbolStr = match (*cur) {
                TypeAnnotation::Named(n)     => { n.name }
                TypeAnnotation::Primitive(p) => { p.name }
                _                            => { SymbolStr::empty() }
            };
            if (result.is_valid()) { return result; }

            const next: TypeAnnotation* = match (*cur) {
                TypeAnnotation::Reference(r) => { r.inner }
                TypeAnnotation::Pointer(p)   => { p.inner }
                TypeAnnotation::Array(a)     => { a.element }
                TypeAnnotation::Generic(g)   => { g.base }
                _                            => { null }
            };
            if (next == null) { return SymbolStr::empty(); }
            cur = next;
            hops = hops + 1;
        }
        return SymbolStr::empty();
    }

    /// Return the index into `imp.path_segments` whose span contains
    /// the cursor, or -1 when the cursor sits on the `import` keyword,
    /// the trailing `;`, or any inter-segment punctuation (`::`).
    static import_segment_at(imp: ImportDeclNode*, line: u32, ch: u32) -> i64 {
        if (imp == null) { return -1 as i64; }
        for (mut i: i64 = 0; i < imp.path_segment_spans.length; i++) {
            if (node_locator::span_contains(imp.path_segment_spans[i], line, ch)) {
                return i;
            }
        }
        return -1 as i64;
    }

    /// Index of the `ModuleDeclNode` segment whose span contains the
    /// cursor, or -1 when the cursor is on `namespace` / `module` /
    /// `public` / `;` / a `::` separator.  Mirror of
    /// `import_segment_at` for `namespace X::Y::Z;` and
    /// `public module X::Y;` decls.
    static module_decl_segment_at(md: ModuleDeclNode*, line: u32, ch: u32) -> i64 {
        if (md == null) { return -1 as i64; }
        for (mut i: i64 = 0; i < md.path_segment_spans.length; i++) {
            if (node_locator::span_contains(md.path_segment_spans[i], line, ch)) {
                return i;
            }
        }
        return -1 as i64;
    }

    /// Return the substring of `s` from byte index `start` up to (but
    /// not including) the next `::` or end-of-string.  Used to extract
    /// the first namespace segment after a known prefix.
    static first_segment_after(s: string, start: i64) -> string {
        const len: i64 = strlen(s) as i64;
        mut end: i64 = start;
        while (end < len) {
            if (end + 1 < len
                    && s[end] == ':' as i8 && s[end + 1] == ':' as i8) {
                break;
            }
            end = end + 1;
        }
        const seg_len: i64 = end - start;
        if (seg_len <= 0) { return ""; }
        const buf: i8* = malloc((seg_len + 1) as u64) as i8*;
        for (mut i: i64 = 0; i < seg_len; i++) { buf[i] = s[start + i] as i8; }
        buf[seg_len] = 0 as i8;
        return buf as string;
    }

    static contains_string(arr: &string[], target: string) -> boolean {
        for (mut i: i64 = 0; i < arr.length; i++) {
            if (strcmp(arr[i], target) == 0) { return true; }
        }
        return false;
    }

    /// Strip per-line `///` (and a single optional space after) from a
    /// doc-comment cluster so the rendered hover reads as plain markdown
    /// rather than as a wall of Cryo source.  Lines starting with the
    /// alternate doc-block markers (`///!`, `/**`, `* `, `*/`) get the
    /// same treatment - keeps stdlib-style module banners legible.
    /// Trailing whitespace + blank trailing lines are trimmed; embedded
    /// blank lines pass through (markdown paragraph breaks).
    static clean_doc_for_hover(raw: string) -> string {
        const len: i64 = strlen(raw) as i64;
        if (len == 0) { return ""; }
        const buf: i8* = malloc((len + 1) as u64) as i8*;
        mut out: i64 = 0;
        mut i:   i64 = 0;
        while (i < len) {
            // Skip leading whitespace on this line.
            while (i < len && (raw[i] == ' ' as i8 || raw[i] == '\t' as i8)) {
                i = i + 1;
            }
            // Strip `///!`, `///`, `/**`, `*/`, or a leading `*` continuation.
            if (i + 3 < len
                    && raw[i] == '/' as i8 && raw[i + 1] == '/' as i8
                    && raw[i + 2] == '/' as i8 && raw[i + 3] == '!' as i8) {
                i = i + 4;
            } else if (i + 2 < len
                    && raw[i] == '/' as i8 && raw[i + 1] == '/' as i8
                    && raw[i + 2] == '/' as i8) {
                i = i + 3;
            } else if (i + 2 < len
                    && raw[i] == '/' as i8 && raw[i + 1] == '*' as i8
                    && raw[i + 2] == '*' as i8) {
                i = i + 3;
            } else if (i + 1 < len
                    && raw[i] == '*' as i8 && raw[i + 1] == '/' as i8) {
                i = i + 2;
            } else if (i < len && raw[i] == '*' as i8
                    && (i + 1 >= len || raw[i + 1] != '*' as i8)) {
                i = i + 1;
            }
            // Single optional space after the marker.
            if (i < len && raw[i] == ' ' as i8) { i = i + 1; }

            // Copy until end of line, stopping at a trailing `*/`.
            while (i < len && raw[i] != '\n' as i8) {
                if (i + 1 < len
                        && raw[i] == '*' as i8 && raw[i + 1] == '/' as i8) {
                    i = i + 2;
                    break;
                }
                buf[out] = raw[i] as i8;
                out = out + 1;
                i = i + 1;
            }
            // Trim trailing whitespace on this line.
            while (out > 0 && (buf[out - 1] == ' ' as i8 || buf[out - 1] == '\t' as i8)) {
                out = out - 1;
            }
            // Append the newline if present.
            if (i < len) {
                buf[out] = '\n' as i8;
                out = out + 1;
                i = i + 1;
            }
        }
        // Drop trailing newlines so markdown doesn't render a dangling blank line.
        while (out > 0 && buf[out - 1] == '\n' as i8) { out = out - 1; }
        buf[out] = 0 as i8;
        return buf as string;
    }

    /// Format an `i64` as a heap-leased decimal `string`.  Routes through
    /// `i64.to_decimal_buf` so the digit logic stays in one place; the
    /// returned buffer is a bare `malloc` that outlives this call (same
    /// pattern as the other `format_*` helpers in this file - the leak is
    /// per-hover-request and acceptable until the LSP grows a per-call
    /// arena).
    ///
    /// The buffer must NOT be a `String`: `String` is `Drop`, so a local
    /// one is freed on scope exit and `as_ptr()` would hand back dangling
    /// memory.  That UAF surfaced as garbage byte-counts in string-literal
    /// hovers (`string("...")[<garbage>]`).
    static i64_to_text(value: i64) -> string {
        mut scratch: u8[21];
        const n: u64 = value.to_decimal_buf(&scratch[0]);
        const src: u8*  = &scratch[0];
        const buf: i8*  = malloc(n + 1 as u64) as i8*;
        for (mut i: i64 = 0; i < n as i64; i++) { buf[i] = src[i] as i8; }
        buf[n as i64] = 0 as i8;
        return buf as string;
    }

    /// Render a string literal as `string("<text>")[<bytes>]` so the
    /// hover surfaces both the source text and the byte count.  The
    /// lexer already strips the surrounding quotes and resolves escape
    /// sequences when populating `LiteralNode.value`, so the byte count
    /// is just `strlen(value)` and we re-escape control characters so
    /// the displayed text fits on one line of hover markup.  Long
    /// strings get truncated past 60 visible chars - hover isn't the
    /// place for the full payload.
    static format_string_literal(lit: LiteralNode*) -> string {
        if (lit == null) { return "string"; }
        const bytes:   i64    = strlen(lit.value) as i64;
        const escaped: string = HoverEngine::escape_for_hover(lit.value);
        return "string(\"" + escaped + "\")[" + HoverEngine::i64_to_text(bytes) + "]";
    }

    /// Re-escape `\n`/`\r`/`\t`/`"`/`\` in `s` so the hover renders the
    /// source-level appearance (newlines wouldn't survive markdown
    /// otherwise).  Truncates with `...` past 60 visible chars to keep the
    /// hover panel one line.
    ///
    /// Writes into a bare `malloc` rather than a `String` builder: a local
    /// `String` is `Drop`, so returning `out.as_ptr()` handed back a freed
    /// buffer - the UAF that rendered string-literal hovers as garbage
    /// (`string("<garbage>")[...]`).  Worst case every input byte escapes to
    /// two output bytes, plus a trailing `...` and NUL - `2*len + 4`.
    static escape_for_hover(s: string) -> string {
        const len: i64 = strlen(s) as i64;
        const max_show: i64 = 60;
        const buf: i8* = malloc((2 * len + 4) as u64) as i8*;
        mut wi: i64 = 0;
        mut shown: i64 = 0;
        mut i: i64 = 0;
        while (i < len) {
            if (shown >= max_show) {
                buf[wi] = '.' as i8;  wi = wi + 1;
                buf[wi] = '.' as i8;  wi = wi + 1;
                buf[wi] = '.' as i8;  wi = wi + 1;
                break;
            }
            const c: char = s[i];
            if (c == '\n' as i8) {
                buf[wi] = '\\' as i8; wi = wi + 1;
                buf[wi] = 'n' as i8;  wi = wi + 1;
                shown = shown + 2;
            } else if (c == '\r' as i8) {
                buf[wi] = '\\' as i8; wi = wi + 1;
                buf[wi] = 'r' as i8;  wi = wi + 1;
                shown = shown + 2;
            } else if (c == '\t' as i8) {
                buf[wi] = '\\' as i8; wi = wi + 1;
                buf[wi] = 't' as i8;  wi = wi + 1;
                shown = shown + 2;
            } else if (c == '"' as i8) {
                buf[wi] = '\\' as i8; wi = wi + 1;
                buf[wi] = '"' as i8;  wi = wi + 1;
                shown = shown + 2;
            } else if (c == '\\' as i8) {
                buf[wi] = '\\' as i8; wi = wi + 1;
                buf[wi] = '\\' as i8; wi = wi + 1;
                shown = shown + 2;
            } else {
                buf[wi] = c as i8; wi = wi + 1;
                shown = shown + 1;
            }
            i = i + 1;
        }
        buf[wi] = 0 as i8;
        return buf as string;
    }

    /// Index of `variant` in `parent.variants[]`.  Falls back to 0 when
    /// the variant somehow isn't on the parent - shouldn't happen for
    /// nodes the locator returned.
    static variant_auto_index(parent: EnumDeclNode*, variant: EnumVariantNode*) -> i64 {
        for (mut i: i64 = 0; i < parent.variants.length; i++) {
            if (parent.variants[i] == variant) { return i; }
        }
        return 0;
    }

    /// Linear scan for a variant by name on a known enum decl.  Used by
    /// the `EnumName::Variant` ScopeResolution branch.
    static find_variant_in_enum(parent: EnumDeclNode*, name: SymbolStr) -> EnumVariantNode* {
        if (parent == null) { return null; }
        for (mut i: i64 = 0; i < parent.variants.length; i++) {
            const v: EnumVariantNode* = parent.variants[i];
            if (v != null && v.name.equals(name)) { return v; }
        }
        return null;
    }

    /// Find the first enum decl in the graph that declares a variant named
    /// `name`.  Used for unqualified match-arm patterns (`FOO` for
    /// `MyEnum::FOO`), which carry no enum qualifier.  First match wins:
    /// variant names are near-unique across a program, and callers only
    /// reach here for a bare identifier that named no const.  Returns null
    /// when no enum declares the variant (a genuine capture binding).
    find_enum_with_variant(&this, name: SymbolStr) -> EnumDeclNode* {
        if (this.graph == null) { return null; }
        const n: u32 = this.graph.module_count();
        for (mut mi: u32 = 0; mi < n; mi++) {
            const ast: ProgramNode* = this.graph.get_module_ast(mi);
            if (ast == null) { continue; }
            for (mut si: i64 = 0; si < ast.statements.length; si++) {
                const stmt: ASTNode* = HoverEngine::unwrap_top_decl(ast.statements[si]);
                if (stmt == null) { continue; }
                if (stmt.kind != NodeKind::EnumDeclaration) { continue; }
                const ed: EnumDeclNode* = stmt as EnumDeclNode*;
                if (HoverEngine::find_variant_in_enum(ed, name) != null) {
                    return ed;
                }
            }
        }
        return null;
    }

    /// `ProgramNode.statements` may wrap top-level decls in a
    /// `DeclStmtNode`; unwrap so callers can branch on the inner kind.
    /// Mirrors the locator's `unwrap_decl_stmt` (kept private there).
    static unwrap_top_decl(node: ASTNode*) -> ASTNode* {
        if (node == null) { return null; }
        if (node.kind != NodeKind::DeclarationStatement) { return node; }
        const d: DeclStmtNode* = node as DeclStmtNode*;
        return d.declaration as ASTNode*;
    }

    /// Span of just the field name within a `FieldInit`.  The init's
    /// outer span runs from the name through the value; the value's own
    /// span tells us where the name ends.  Falls back to the outer span
    /// when the value span is missing (sema bailed pre-resolution).
    static field_init_name_span(init_span: SourceSpan, value_span: SourceSpan) -> SourceSpan {
        if (!value_span.has_location()) { return init_span; }
        return SourceSpan::new(
            init_span.file,
            init_span.start_line, init_span.start_col,
            init_span.start_line, value_span.start_col);
    }

    /// Lookup a field by name on a struct or class decl.  Mirrors the
    /// `methods_contains` style of the locator's reverse walks; returns
    /// `null` for kinds without an inline `fields[]` (enums, traits) and
    /// for missing names.
    static find_field_on_type_decl(decl: ASTNode*, name: SymbolStr) -> FieldDeclNode* {
        if (decl == null) { return null; }
        if (decl.kind == NodeKind::StructDeclaration) {
            const sd: StructDeclNode* = decl as StructDeclNode*;
            return HoverEngine::field_by_name(&sd.fields, name);
        }
        if (decl.kind == NodeKind::ClassDeclaration) {
            const cd: ClassDeclNode* = decl as ClassDeclNode*;
            return HoverEngine::field_by_name(&cd.fields, name);
        }
        return null;
    }

    static field_by_name(fields: &FieldDeclNode*[], name: SymbolStr) -> FieldDeclNode* {
        for (mut i: i64 = 0; i < fields.length; i++) {
            const f: FieldDeclNode* = fields[i];
            if (f != null && f.name.equals(name)) { return f; }
        }
        return null;
    }
}


// URI helpers live in `Lsp::Protocol::Conv` (`UriPath::uri_to_fs_path`).
