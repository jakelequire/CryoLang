///! Completion, from the last analysis and the line being typed.
///!
///! The text before the cursor on its own line says what is being
///! completed: a member after `.` (`wb.get().`), a path after `::`
///! (`B::Item::`), a module path after `import`, or a bare name.  What was
///! written before the cursor is resolved through the doors, in the scope
///! the analysis has at the cursor; what can follow it is enumerated by
///! identity (`members`).  No analysis runs for a completion: the line being
///! typed is never compiled, only read.
namespace lsp::handlers::completion;

import std::core::option;
import std::core::mem;
import std::collections::str;
import std::collections::string;
import std::collections::string::{ String };
import std::collections::array;
import std::collections::array::{ Array };
import std::collections::hashmap;
import std::collections::hashmap::{ HashMap };
import std::json::value;

import compiler::compilation_context::{ CompilationContext };
import compiler::ast::{ NodeKind };
import compiler::ast::node::{ ASTNode, ProgramNode };
import compiler::ast::declaration::{
    ClassDeclNode, DeclarationNode, DeclKind, EnumDecl, EnumVariant, FieldDecl, FunctionDeclNode,
    ImplBlock, MethodNode, StructDecl, UnionDecl, VarDeclNode
};
import compiler::module_graph::{ ModulePath, ModuleSpellingMatch };
import compiler::resolver::res::{ DefId, DefKind, FamilyOwner };
import compiler::resolver::scope::{ ScopeID };
import compiler::resolver::symbol::{ Symbol, SymbolKind };
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::decl_index::{ OverloadId };
import compiler::sema::member_resolver::{ FieldAnswer, MemberResolver };
import compiler::sema::type_utils::{ TypeUtils };
import compiler::types;
import compiler::types::type_ref::{ TypeRef };
import compiler::types::type_base;
import compiler::types::compound;
import compiler::types::user_defined::{ ClassType };

import lsp::handlers::definition::{ Declared };
import lsp::handlers::hover::{ Shown };
import lsp::handlers::identity::{ Asked, Locator };
import lsp::handlers::members::{ Member, Members };
import lsp::handlers::names::{ Names, Place };
import lsp::server::docs;
import lsp::server::line_index::{ Columns };
import lsp::server::session;


// The protocol's CompletionItemKind numbers.
const CK_METHOD:      i64 = 2;
const CK_FUNCTION:    i64 = 3;
const CK_FIELD:       i64 = 5;
const CK_VARIABLE:    i64 = 6;
const CK_CLASS:       i64 = 7;
const CK_INTERFACE:   i64 = 8;
const CK_MODULE:      i64 = 9;
const CK_ENUM:        i64 = 13;
const CK_KEYWORD:     i64 = 14;
const CK_ENUM_MEMBER: i64 = 20;
const CK_CONSTANT:    i64 = 21;
const CK_STRUCT:      i64 = 22;
const CK_TYPE_PARAM:  i64 = 25;


/// `textDocument/completion`.
public function handle_completion(docs: mut &docs::Docs, projects: mut &session::Projects,
                                   params: &value::JsonValue) -> value::JsonValue {
    const asked: Asked = Asked::from(docs, projects, params);
    mut c: Completer = Completer::new(asked.ctx, asked.module_idx);
    match (docs.get(asked.uri)) {
        Option::Some(doc) => {
            const line: str::Str = doc.line_text(asked.line);
            const end: u64 = Columns::wire_to_byte(line, asked.character, docs.utf8);
            const pos: docs::CompilerPos = docs.scope_pos(asked.uri, asked.line, asked.character);
            c.complete(line, end, pos);
        }
        Option::None => { c.keywords(); }
    }
    return c.reply();
}


/// One `.name` (or the head) of a receiver written before a `.`, and the
/// text of the calls and indexings written after it (`(4)[0]`).
type struct Step {
    name: str::Str;
    ops:  str::Str;

    /// The brackets opening each call (`(`) and indexing (`[`) in `ops`,
    /// in order.
    op_list(&this) -> [u8] {
        mut out: [u8] = [];
        const b: u8* = this.ops.as_ptr();
        mut depth: i64 = 0;
        for (mut i: u64 = 0; i < this.ops.length(); i++) {
            const c: u8 = b[i];
            if (c == '(' as u8 || c == '[' as u8) {
                if (depth == 0) { out.push(c); }
                depth = depth + 1;
            }
            if (c == ')' as u8 || c == ']' as u8) { depth = depth - 1; }
        }
        return out;
    }
}


type struct Completer {
    ctx:    CompilationContext*;
    module: ModulePath;
    scope:  ScopeID;
    pos:    docs::CompilerPos;
    items:  Array<value::JsonValue>;
    /// The labels already offered.
    labels: HashMap<String, i64>;
    /// Paths read, and items' details written, as the cursor's scope does.
    names:  Names;

    static new(ctx: CompilationContext*, module_idx: i64) -> Completer {
        mut m: ModulePath = ModulePath::none();
        if (ctx != null && module_idx >= 0) { m = ctx.module_graph.get_module(module_idx).path(); }
        return Completer { ctx: ctx, module: m, scope: ScopeID::invalid(),
                           pos: docs::CompilerPos { line: 0, col: 0 },
                           items: Array::<value::JsonValue>::with_capacity(64),
                           labels: HashMap::<String, i64>::new(),
                           names: Names::at(ctx, m, 0, 0) };
    }

    /// Complete at byte `end` of `line`, the cursor's line in the buffer;
    /// `pos` is where the analysis has the cursor's scope.
    complete(mut &this, line: str::Str, end: u64, pos: docs::CompilerPos) -> void {
        this.place_cursor(pos);
        const b: u8* = line.as_ptr();
        mut p: u64 = end;
        while (p > 0 && Completer::is_ident(b[p - 1])) { p = p - 1; }
        if (p >= 1 && b[p - 1] == '.' as u8) {
            this.member(line, p - 1);
            return;
        }
        if (p >= 2 && b[p - 1] == ':' as u8 && b[p - 2] == ':' as u8) {
            const start: u64 = Completer::path_start(line, p - 2);
            if (Completer::after_import(line, start)) {
                this.import_path(line.sub_bytes(start, p - 2));
            } else {
                this.path(line, start, p - 2);
            }
            return;
        }
        // A `:` right after a name is the first half of a `::` being typed
        // (each `:` is a trigger of its own).  Nothing is offered there: a
        // list here would be replaced by the path's list, or by none, one
        // keystroke later.
        if (p == end && p >= 2 && b[p - 1] == ':' as u8 && Completer::is_ident(b[p - 2])) {
            return;
        }
        if (Completer::after_import(line, p)) {
            this.modules_under(ModulePath::none());
            return;
        }
        this.bare();
        this.keywords();
    }

    /// Take the cursor's scope from where the analysis has it, `pos`.
    place_cursor(mut &this, pos: docs::CompilerPos) -> void {
        this.pos = pos;
        this.names = Names::at(this.ctx, this.module, pos.line, pos.col);
        this.scope = this.names.scope;
    }

    // -- What was written --

    /// Where the path ending at byte `end` (`A::B` before a `::`) starts.
    static path_start(line: str::Str, end: u64) -> u64 {
        const b: u8* = line.as_ptr();
        mut s: u64 = end;
        loop {
            while (s > 0 && Completer::is_ident(b[s - 1])) { s = s - 1; }
            if (s >= 2 && b[s - 1] == ':' as u8 && b[s - 2] == ':' as u8
                    && s >= 3 && Completer::is_ident(b[s - 3])) {
                s = s - 2;
                continue;
            }
            return s;
        }
        return s;
    }

    /// Whether the text before byte `at` is the keyword `import` or
    /// `export` and blanks.
    static after_import(line: str::Str, at: u64) -> boolean {
        const b: u8* = line.as_ptr();
        mut e: u64 = at;
        while (e > 0 && (b[e - 1] == ' ' as u8 || b[e - 1] == '\t' as u8)) { e = e - 1; }
        if (e == at) { return false; }
        mut s: u64 = e;
        while (s > 0 && Completer::is_ident(b[s - 1])) { s = s - 1; }
        mut k: u64 = s;
        while (k > 0 && (b[k - 1] == ' ' as u8 || b[k - 1] == '\t' as u8)) { k = k - 1; }
        if (k != 0) { return false; }
        const word: str::Str = line.sub_bytes(s, e);
        return word.equals(&str::Str::from("import")) || word.equals(&str::Str::from("export"));
    }

    // -- `a.b().` --

    /// Members of the receiver written before the `.` at byte `dot`.
    member(mut &this, line: str::Str, dot: u64) -> void {
        const ty: TypeRef = this.receiver_before(line, dot);
        if (!ty.is_valid()) { return; }
        const d: DefId = this.type_def(ty);
        if (!d.is_valid()) { return; }
        const all: [Member] = Members::of_type(this.ctx, d);
        for (mut i: i64 = 0; i < all.length; i++) {
            if (Members::is_instance(&all[i])) { this.member_item(&all[i]); }
        }
    }

    /// The type of the receiver written before the `.` at byte `dot`, or
    /// invalid when it is not read.
    receiver_before(&this, line: str::Str, dot: u64) -> TypeRef {
        if (this.ctx == null || !this.scope.is_valid()) { return TypeRef::invalid(); }
        mut steps: [Step] = [];
        const b: u8* = line.as_ptr();
        mut q: u64 = dot;
        loop {
            const ops_end: u64 = q;
            while (q > 0 && (b[q - 1] == ')' as u8 || b[q - 1] == ']' as u8)) {
                const at: i64 = Completer::opening(line, q - 1);
                if (at < 0) { return TypeRef::invalid(); }
                q = at as u64;
            }
            mut s: u64 = q;
            while (s > 0 && Completer::is_ident(b[s - 1])) { s = s - 1; }
            if (s == q) { return TypeRef::invalid(); }
            steps.push(Step { name: line.sub_bytes(s, q), ops: line.sub_bytes(q, ops_end) });
            q = s;
            if (q > 0 && b[q - 1] == '.' as u8) {
                q = q - 1;
                continue;
            }
            // A receiver whose head is a path (`T::make().`) is not read.
            if (q >= 2 && b[q - 1] == ':' as u8 && b[q - 2] == ':' as u8) { return TypeRef::invalid(); }
            break;
        }
        mut ty: TypeRef = this.head_type(&steps[steps.length - 1]);
        for (mut i: i64 = steps.length - 2; i >= 0 && ty.is_valid(); i--) {
            ty = this.step_type(ty, &steps[i]);
        }
        return ty;
    }

    /// The byte of the bracket opening the one closing at byte `close`, or
    /// -1 when this line holds none.
    static opening(line: str::Str, close: u64) -> i64 {
        const b: u8* = line.as_ptr();
        mut depth: i64 = 0;
        mut i: i64 = close as i64;
        while (i >= 0) {
            const c: u8 = b[i];
            if (c == ')' as u8 || c == ']' as u8) { depth = depth + 1; }
            if (c == '(' as u8 || c == '[' as u8) {
                depth = depth - 1;
                if (depth == 0) { return i; }
            }
            i = i - 1;
        }
        return -1;
    }

    /// The type of a receiver's head: `this`, or a name the scope binds.
    head_type(&this, s: &Step) -> TypeRef {
        const ops: [u8] = s.op_list();
        mut ty: TypeRef = TypeRef::invalid();
        mut from: i64 = 0;
        if (s.name.equals(&str::Str::from("this"))) {
            ty = this.receiver_type();
        } else {
            const bound: SymbolID = this.ctx.resolver.value_target(
                this.ctx.resolver.lookup_value(this.intern(s.name), this.scope));
            if (!bound.is_valid()) { return ty; }
            const sym: Symbol = this.ctx.resolver.get_symbol(bound);
            if (sym.kind == SymbolKind::Function) {
                if (ops.length == 0 || ops[0] != '(' as u8) { return ty; }
                const decl: ASTNode* = this.ctx.decl_index.declaration_of(sym.def);
                if (decl == null || decl.kind != NodeKind::FunctionDeclaration) { return ty; }
                ty = (decl as FunctionDeclNode*).resolved_return_type;
                from = 1;
            } else if (sym.def.is_valid()) {
                const decl: ASTNode* = this.ctx.decl_index.declaration_of(sym.def);
                if (decl == null || decl.kind != NodeKind::VariableDeclaration) { return ty; }
                ty = (decl as VarDeclNode*).resolved_type;
            } else if (sym.kind == SymbolKind::Variable || sym.kind == SymbolKind::Parameter) {
                ty = Declared::binding_type(this.ctx, bound);
            }
        }
        return this.apply_ops(ty, &ops, from);
    }

    /// The type `this` has at the cursor: the type whose declaration or
    /// implementation block holds the instance method around it.
    receiver_type(&this) -> TypeRef {
        const program: ProgramNode* = this.ctx.module_graph.get_module_ast(
            this.ctx.module_graph.find_module_index(this.module) as u32);
        mut loc: Locator = Locator::new(this.ctx, this.pos.line, this.pos.col);
        loc.descend(program);
        mut in_method: boolean = false;
        for (mut i: i64 = loc.chain.length - 1; i >= 0; i--) {
            const n: ASTNode* = loc.chain[i];
            if (!in_method) {
                if (n.kind == NodeKind::MethodDeclaration) {
                    if ((n as MethodNode*).is_static) { return TypeRef::invalid(); }
                    in_method = true;
                }
                continue;
            }
            const d: DefId = Completer::declared_type(n);
            if (d.is_valid()) { return this.ctx.decl_index.type_of_def(d); }
        }
        return TypeRef::invalid();
    }

    /// The type a type declaration or an implementation block is for, or
    /// invalid for any other node.
    static declared_type(n: ASTNode*) -> DefId {
        return match (n.kind) {
            NodeKind::ClassDeclaration     => { (n as ClassDeclNode*).def }
            NodeKind::Declaration          => {
                match ((n as DeclarationNode*).shape) {
                    DeclKind::Impl(ib) => { ib.target_def() }
                    DeclKind::Struct(s) => { s.def }
                    DeclKind::Enum(e) => { e.def }
                    DeclKind::Union(u) => { u.def }
                    DeclKind::Import(_) | DeclKind::Intrinsic(_)
                    | DeclKind::Module(_) | DeclKind::Variant(_) | DeclKind::Destructure(_)
                    | DeclKind::Extern(_) | DeclKind::TypeAlias(_) | DeclKind::Field(_)
                    | DeclKind::GenericParam(_) | DeclKind::Trait(_) | DeclKind::Legacy => { DefId::invalid() }
                }
            }
            _                              => { DefId::invalid() }
        };
    }

    /// The type of `.name` on a value of type `ty`, then its calls and
    /// indexings.
    step_type(&this, ty: TypeRef, s: &Step) -> TypeRef {
        const ops: [u8] = s.op_list();
        if (ops.length > 0 && ops[0] == '(' as u8) {
            return this.apply_ops(this.method_return(ty, this.intern(s.name)), &ops, 1);
        }
        return this.apply_ops(this.field_type(ty, this.intern(s.name)), &ops, 0);
    }

    /// The type of field `leaf` of type `ty`, through its base classes, or
    /// invalid when it has none.
    field_type(&this, ty: TypeRef, leaf: SymbolStr) -> TypeRef {
        mut types_: TypeUtils = TypeUtils { arena: this.ctx.type_arena, intern: this.ctx.intern_table,
                                            ctx: this.ctx, checker: null };
        mut mr: MemberResolver = MemberResolver::null();
        mr.arena = this.ctx.type_arena;
        mr.intern = this.ctx.intern_table;
        mr.ctx = this.ctx;
        mr.types = &types_;
        const fa: FieldAnswer = mr.field_of(ty, leaf);
        return fa.ty;
    }

    /// The return type the methods named `leaf` of type `ty` declare, through
    /// its base classes; invalid when none or when they disagree.
    method_return(&this, ty: TypeRef, leaf: SymbolStr) -> TypeRef {
        const entries: [OverloadId] = this.method_entries(ty, leaf);
        if (entries.length == 0) { return TypeRef::invalid(); }
        return this.shared_return(&entries);
    }

    /// The methods named `leaf` of type `ty`, from the first of it and its
    /// base classes that declares any.
    method_entries(&this, ty: TypeRef, leaf: SymbolStr) -> [OverloadId] {
        mut types_: TypeUtils = TypeUtils { arena: this.ctx.type_arena, intern: this.ctx.intern_table,
                                            ctx: this.ctx, checker: null };
        mut owner: TypeRef = types_.method_owner_ref(this.carrier(ty));
        for (mut depth: i64 = 0; depth < 16 && owner.is_valid(); depth++) {
            const entries: [OverloadId] = this.ctx.decl_index.lookup_family_entries(
                FamilyOwner::Type(owner), leaf);
            if (entries.length > 0) { return entries; }
            const t: type_base::Type* = this.ctx.type_arena.lookup(owner);
            if (t == null || t.kind != types::TypeKind::Class) { return []; }
            const cls: ClassType* = t.as_class();
            if (!cls.has_base) { return []; }
            owner = cls.base_class;
        }
        return [];
    }

    shared_return(&this, entries: &[OverloadId]) -> TypeRef {
        mut ret: TypeRef = TypeRef::invalid();
        for (mut k: i64 = 0; k < entries.length; k++) {
            const sig: type_base::Type* = this.ctx.type_arena.lookup(
                this.ctx.decl_index.entry_signature(entries[k]));
            if (sig == null || sig.kind != types::TypeKind::Function) { return TypeRef::invalid(); }
            const r: TypeRef = sig.as_function().return_type;
            if (ret.is_valid() && !ret.equals(r)) { return TypeRef::invalid(); }
            ret = r;
        }
        return ret;
    }

    /// `ty` after the calls and indexings in `ops` from position `from`: an
    /// index takes an array's element; a call on a value is not followed.
    apply_ops(&this, ty: TypeRef, ops: &[u8], from: i64) -> TypeRef {
        mut cur: TypeRef = ty;
        for (mut i: i64 = from; i < ops.length && cur.is_valid(); i++) {
            if (ops[i] != '[' as u8) { return TypeRef::invalid(); }
            const c: TypeRef = this.carrier(cur);
            const dynamic_elem: TypeRef = this.ctx.type_arena.default_array_element(c);
            if (dynamic_elem.is_valid()) {
                cur = dynamic_elem;
                continue;
            }
            const t: type_base::Type* = this.ctx.type_arena.lookup(c);
            if (t == null || t.kind != types::TypeKind::Array) { return TypeRef::invalid(); }
            cur = t.as_array().element;
        }
        return cur;
    }

    carrier(&this, ty: TypeRef) -> TypeRef {
        const loc: Locator = Locator::new(this.ctx, 0, 0);
        return loc.carrier(ty);
    }

    /// The type definition a value of type `ty` is an instance of.
    type_def(&this, ty: TypeRef) -> DefId {
        const c: TypeRef = this.carrier(ty);
        const d: DefId = this.ctx.decl_index.def_of(c, this.ctx.type_arena);
        if (d.is_valid()) { return d; }
        mut types_: TypeUtils = TypeUtils { arena: this.ctx.type_arena, intern: this.ctx.intern_table,
                                            ctx: this.ctx, checker: null };
        return this.ctx.decl_index.def_of(types_.method_owner_ref(c), this.ctx.type_arena);
    }

    // -- `A::B::` --

    /// What can follow the path written in bytes `start`..`end` of `line`.
    path(mut &this, line: str::Str, start: u64, end: u64) -> void {
        const place: Place = this.place_of_path(line.sub_bytes(start, end));
        match (place) {
            Place::Module(m) => {
                const syms: [SymbolID] = Members::exports_of(this.ctx, m);
                for (mut i: i64 = 0; i < syms.length; i++) { this.symbol_item(syms[i]); }
                this.modules_under(m);
            }
            Place::Type(d) => {
                const all: [Member] = Members::of_type(this.ctx, d);
                for (mut i: i64 = 0; i < all.length; i++) {
                    if (!Members::is_instance(&all[i])) { this.member_item(&all[i]); }
                }
            }
            Place::Nothing => { }
        }
    }

    /// What the path `written` (`A::B`) names in the cursor's scope.
    place_of_path(&this, written: str::Str) -> Place {
        return this.names.place_of_path(written);
    }

    // -- `import A::B::` --

    /// The modules under an import's written path, which need not name a
    /// module itself (`import std::`).
    import_path(mut &this, written: str::Str) -> void {
        if (this.ctx == null) { return; }
        const m: ModulePath = this.ctx.module_graph.module_path_over(this.intern(written), this.ctx.intern_table);
        if (m.is_valid()) { this.modules_under(m); }
    }

    modules_under(mut &this, m: ModulePath) -> void {
        if (this.ctx == null) { return; }
        const subs: [string] = Members::submodules_of(this.ctx, m);
        for (mut i: i64 = 0; i < subs.length; i++) { this.push(subs[i], "", CK_MODULE); }
    }

    // -- A bare name --

    /// Every name the cursor's scope can see: its bindings, innermost
    /// first, less a local declared after the cursor; the prelude's; and
    /// the modules the file imports.
    bare(mut &this) -> void {
        if (this.ctx == null || !this.scope.is_valid()) { return; }
        const seen: [SymbolID] = this.ctx.resolver.visible_bindings(this.scope);
        for (mut i: i64 = 0; i < seen.length; i++) {
            // A type body binds its fields, methods and variants, which a
            // bare name never reaches: they are written through `this` or
            // the type.
            const k: SymbolKind = this.ctx.resolver.get_symbol(seen[i]).kind;
            if (k == SymbolKind::Field || k == SymbolKind::Method || k == SymbolKind::EnumVariant) {
                continue;
            }
            if (this.declared_after_cursor(seen[i])) { continue; }
            this.symbol_item(seen[i]);
        }
        const prelude: &[ModulePath] = &this.ctx.resolver.prelude_modules;
        for (mut p: i64 = 0; p < prelude.length; p++) {
            const syms: [SymbolID] = Members::exports_of(this.ctx, prelude[p]);
            for (mut i: i64 = 0; i < syms.length; i++) { this.symbol_item(syms[i]); }
        }
        const n: u32 = this.ctx.module_graph.module_count();
        for (mut i: u32 = 0; i < n; i++) {
            const p: ModulePath = this.ctx.module_graph.get_module(i as i64).path();
            if (p.equals(this.module) || !this.ctx.module_graph.imports(this.module, p)) { continue; }
            const full: string = this.ctx.intern_table.shown(p.decl_name());
            this.push(Completer::last_segment(full), "", CK_MODULE);
        }
    }

    /// Whether `id` is a local the cursor's function declares after the
    /// cursor.
    declared_after_cursor(&this, id: SymbolID) -> boolean {
        const s: Symbol = this.ctx.resolver.get_symbol(id);
        if (!s.scope_id.is_valid() || this.ctx.resolver.get_scope(s.scope_id).kind.is_module_level()) {
            return false;
        }
        const at: u32 = s.declaring_span.start_line;
        return at > this.pos.line || (at == this.pos.line && s.declaring_span.start_col > this.pos.col);
    }

    static last_segment(path: string) -> string {
        const n: i64 = path.length() as i64;
        mut s: i64 = n;
        while (s > 1 && !(path[s - 1] == ':' && path[s - 2] == ':')) { s = s - 1; }
        if (s <= 1) { return path; }
        return path.substr(s, n - s);
    }

    // -- Items --

    /// An item for a binding, or for the declaration an import binds.
    symbol_item(mut &this, id: SymbolID) -> void {
        mut s: Symbol = this.ctx.resolver.get_symbol(id);
        const label: string = this.ctx.intern_table.resolve(s.name);
        if (s.kind == SymbolKind::Import) {
            const target: SymbolID = this.ctx.resolver.declaration_of(id);
            if (target.equals(id)) { return; }
            s = this.ctx.resolver.get_symbol(target);
        }
        mut shown: Shown = Shown::new(this.names);
        mut kind: i64 = CK_VARIABLE;
        match (s.kind) {
            SymbolKind::Variable  => {
                if (s.def.is_valid()) { shown.def(s.def); } else { shown.local(s.id, Declared::binding_type(this.ctx, s.id)); }
            }
            SymbolKind::Parameter => { shown.local(s.id, Declared::binding_type(this.ctx, s.id)); }
            SymbolKind::Constant  => { kind = CK_CONSTANT; shown.def(s.def); }
            SymbolKind::Function  => { kind = CK_FUNCTION; shown.def(s.def); }
            SymbolKind::Intrinsic => { kind = CK_FUNCTION; shown.def(s.def); }
            SymbolKind::Method    => { kind = CK_METHOD; shown.def(s.def); }
            SymbolKind::Type      => { kind = this.type_kind(s.def); shown.def(s.def); }
            SymbolKind::TypeAlias => { kind = CK_CLASS; shown.def(s.def); }
            SymbolKind::EnumVariant => { kind = CK_ENUM_MEMBER; }
            SymbolKind::Namespace => { kind = CK_MODULE; }
            SymbolKind::GenericParam => { kind = CK_TYPE_PARAM; }
            SymbolKind::Field     => { kind = CK_FIELD; }
            _                     => { return; }
        }
        this.push(label, shown.text, kind);
    }

    type_kind(&this, d: DefId) -> i64 {
        const decl: ASTNode* = this.ctx.decl_index.declaration_of(d);
        if (decl == null) { return CK_CLASS; }
        return match (decl.kind) {
            NodeKind::Declaration       => {
                match ((decl as DeclarationNode*).shape) {
                    DeclKind::Struct(_) => { CK_STRUCT }
                    DeclKind::Enum(_) => { CK_ENUM }
                    DeclKind::Union(_) => { CK_STRUCT }
                    DeclKind::Trait(_) => { CK_INTERFACE }
                    DeclKind::Import(_) | DeclKind::Intrinsic(_) | DeclKind::Impl(_)
                    | DeclKind::Module(_) | DeclKind::Variant(_) | DeclKind::Destructure(_)
                    | DeclKind::Extern(_) | DeclKind::TypeAlias(_) | DeclKind::Field(_)
                    | DeclKind::GenericParam(_) | DeclKind::Legacy => { CK_CLASS }
                }
            }
            _                           => { CK_CLASS }
        };
    }

    member_item(mut &this, m: &Member) -> void {
        mut shown: Shown = Shown::new(this.names);
        match (m) {
            Member::Field(o, i) => {
                const fd: FieldDecl* = DeclarationNode::field_of(Members::field_decl(this.ctx, o, i));
                if (fd == null) { return; }
                shown.field(o, i);
                this.push(this.ctx.intern_table.resolve(fd.name), shown.text, CK_FIELD);
            }
            Member::Variant(o, i) => {
                const decl: ASTNode* = this.ctx.decl_index.declaration_of(o);
                const en: EnumDecl* = DeclarationNode::enum_of(decl);
                if (en == null) { return; }
                shown.variant(o, i);
                const v: EnumVariant* = DeclarationNode::variant_of(en.variants[i]);
                this.push(this.ctx.intern_table.resolve(v.name),
                          shown.text, CK_ENUM_MEMBER);
            }
            Member::Method(md) => {
                if (md.func.def.is_valid()) { shown.def(md.func.def); }
                const kind: i64 = if (md.is_static || md.is_constructor) { CK_FUNCTION } else { CK_METHOD };
                this.push(this.ctx.intern_table.resolve(md.func.name), shown.text, kind);
            }
        }
    }

    /// The keywords a statement or an expression can start with.
    keywords(mut &this) -> void {
        const words: [string] = [
            "function", "return", "if", "else", "while", "for", "loop", "match", "break",
            "continue", "type", "struct", "union", "enum", "trait", "implement", "import",
            "namespace", "const", "mut", "move", "asm", "this", "true", "false", "null"
        ];
        for (mut i: i64 = 0; i < words.length; i++) { this.push(words[i], "", CK_KEYWORD); }
    }

    /// Add an item, unless one already carries `label`: an inner binding
    /// hides an outer one of the same name.
    push(mut &this, label: string, detail: string, kind: i64) -> void {
        const l: str::Str = str::Str::from(label);
        mut key: String = String::from_str(l);
        match (this.labels.get_ref(&key)) {
            Option::Some(_) => { mem::drop(key); return; }
            Option::None    => { }
        }
        this.labels.insert(key, 0);
        mut o: value::JsonObject = value::JsonObject::new();
        o.put("label", value::JsonValue::String(String::from_str(l)));
        o.put("kind", value::JsonValue::int_value(kind));
        if (detail != null && detail.length() > 0) {
            o.put("detail", value::JsonValue::String(String::from_str(str::Str::from(detail))));
        }
        this.items.push(value::JsonValue::Object(o));
    }

    reply(mut &this) -> value::JsonValue {
        mut items: Array<value::JsonValue> = Array::<value::JsonValue>::new();
        mem::swap(&items, &this.items);
        mut out: value::JsonObject = value::JsonObject::new();
        out.put("isIncomplete", value::JsonValue::Bool(false));
        out.put("items", value::JsonValue::Array(items));
        return value::JsonValue::Object(out);
    }

    // -- Text --

    /// A written name as the interner holds it.  Interning is the door text
    /// becomes a `SymbolStr` through; a name the analysis never saw is added
    /// to its table and binds nothing.
    intern(&this, s: str::Str) -> SymbolStr {
        return this.ctx.intern_table.intern(this.cstr(s));
    }

    /// `s` as a NUL-terminated copy.
    cstr(&this, s: str::Str) -> string {
        mut buf: String = String::with_capacity(s.length() + 1);
        buf.push(s);
        buf.push_byte(0 as u8);
        return buf.into_raw();
    }

    static is_ident(b: u8) -> boolean {
        return (b >= 'a' as u8 && b <= 'z' as u8) || (b >= 'A' as u8 && b <= 'Z' as u8)
            || (b >= '0' as u8 && b <= '9' as u8) || b == '_' as u8;
    }
}
