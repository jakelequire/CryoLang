///! Completion handler.
///!
///! Provides type-aware auto-complete triggered by `.` (dot access)
///! and `::` (scope resolution).
///!
///! Dot completion:
///!   - Finds the AST node under the cursor (position of the receiver
///!     expression before the dot).
///!   - Reads the node's `resolved_type`, unwraps Reference/Pointer/
///!     InstantiatedType wrappers, and maps the carrier TypeRef to a
///!     SymbolStr via `decl_index.lookup_type_name`.
///!   - Walks all modules to enumerate fields and non-static methods
///!     declared on matching struct/class/impl blocks.
///!
///! Scope-resolution completion:
///!   - Reads the whole scope path before `::` - every `seg::` group, not
///!     just the last segment, so `Types::Foo::` and a bare `Foo::` stay
///!     distinct scopes.
///!   - Resolves that path to a qualified declaration name: an already-
///!     qualified path is taken at face value, a bare leaf goes through the
///!     compiler's own import-scoped resolution
///!     (`DeclarationIndex::resolve_qualified_scoped`) against the editing
///!     file's namespace.
///!   - Walks all modules to enumerate static methods (struct/class/impl)
///!     and enum variants on that declaration.
///!   - When the path names a namespace rather than a type, enumerates the
///!     declarations that namespace contains.
///!
///! Both member walks match a declaration on its module namespace AND its
///! leaf whenever the target is qualified.  Matching on the leaf alone
///! merges every same-named declaration in the program into one list, which
///! is what made scope completion appear to work only sometimes.
///!
///! Falls back to a static keyword list when type info is unavailable.
///!
///! Member enumeration + item building hang off `CompletionEngine`, a
///! per-request object holding the module graph / intern table / type
///! arena / declaration index.  `handle_completion` is the only free
///! function.

namespace Lsp::Handlers::Completion;

import std::core::option;
import std::core::primitives;
import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::json::value;

import Compiler::CompilationContext;
import Compiler::DeclIndex;
import Compiler::AST;
import Compiler::AST::Node;
import Compiler::AST::Expression;
import Compiler::AST::Declaration;
import Compiler::AST::NodeLocator;
import Compiler::Diag::SourceSpan;
import Compiler::Resolver::SymbolStr;
import Compiler::Types::TypeRef;
import Compiler::Types::Arena;
import Compiler::Types;
import Compiler::Types::Type;
import Compiler::Types::Compound;
import Compiler::Types::Generic;
import Compiler::ModuleGraph;

import Lsp::Server::Docs;
import Lsp::Server::Session;
import Lsp::Protocol::Lsp;
import Lsp::Protocol::Conv;


// LSP CompletionItemKind constants

const CK_METHOD:      i64 = 2;
const CK_FUNCTION:    i64 = 3;
const CK_FIELD:       i64 = 5;
const CK_CLASS:       i64 = 7;
const CK_INTERFACE:   i64 = 8;
const CK_ENUM:        i64 = 13;
const CK_KEYWORD:     i64 = 14;
const CK_ENUM_MEMBER: i64 = 20;
const CK_STRUCT:      i64 = 22;


// Public entry point

public function handle_completion(docs: &Docs, sessions: mut &SessionMap,
                                   params: &JsonValue) -> JsonValue {
    // 1. Extract textDocument.uri
    const td_opt: Option<JsonValue*> = params.get(Str::from("textDocument"));
    if (!td_opt.is_some()) { return CompletionEngine::make_keyword_list(); }
    const td: JsonValue* = td_opt.unwrap_or(null);
    if (td == null) { return CompletionEngine::make_keyword_list(); }

    const uri_opt: Option<JsonValue*> = td.get(Str::from("uri"));
    if (!uri_opt.is_some()) { return CompletionEngine::make_keyword_list(); }
    const uri_val: JsonValue* = uri_opt.unwrap_or(null);
    if (uri_val == null) { return CompletionEngine::make_keyword_list(); }

    const uri_str_opt: Option<Str> = uri_val.as<Str>();
    if (!uri_str_opt.is_some()) { return CompletionEngine::make_keyword_list(); }
    const uri: Str = uri_str_opt.unwrap_or(Str::from(""));

    // 2. Extract position
    const pos_opt: Option<JsonValue*> = params.get(Str::from("position"));
    if (!pos_opt.is_some()) { return CompletionEngine::make_keyword_list(); }
    const pos: JsonValue* = pos_opt.unwrap_or(null);
    if (pos == null) { return CompletionEngine::make_keyword_list(); }
    const line:      u32 = CompletionEngine::json_u32_field(pos, "line");
    const character: u32 = CompletionEngine::json_u32_field(pos, "character");

    // 3. Get document text
    const doc_opt: Option<Document*> = docs.get(uri);
    if (!doc_opt.is_some()) { return CompletionEngine::make_keyword_list(); }
    const doc: Document* = doc_opt.unwrap_or(null);
    if (doc == null) { return CompletionEngine::make_keyword_list(); }

    const text: Str = doc.text.as_str();
    const len: u64 = text.length();
    if (len == 0) { return CompletionEngine::make_keyword_list(); }
    const ptr: u8* = text.as_ptr();

    const byte_off: u64 = doc.line_index.byte_offset(line, character);
    if (byte_off == 0 || byte_off > len) { return CompletionEngine::make_keyword_list(); }

    // 4. Detect trigger character
    const DOT:   u8 = 46 as u8;
    const COLON: u8 = 58 as u8;

    mut is_dot:   boolean = false;
    mut is_scope: boolean = false;

    if (byte_off >= 1 && ptr[byte_off - 1] == DOT) {
        is_dot = true;
    } else if (byte_off >= 2 && ptr[byte_off - 1] == COLON && ptr[byte_off - 2] == COLON) {
        is_scope = true;
    } else {
        return CompletionEngine::make_keyword_list();
    }

    // 5. Extract identifier immediately before the trigger
    //    For dot  : identifier ends at byte_off-2 (inclusive); dot at byte_off-1
    //    For ::   : identifier ends at byte_off-3 (inclusive); :: at byte_off-2..byte_off-1
    mut ident_end_excl: u64 = 0;
    if (is_dot) {
        if (byte_off < 2) { return CompletionEngine::make_keyword_list(); }
        ident_end_excl = byte_off - 1;
    } else {
        if (byte_off < 3) { return CompletionEngine::make_keyword_list(); }
        ident_end_excl = byte_off - 2;
    }

    mut ident_start: u64 = ident_end_excl;
    while (ident_start > 0 && CompletionEngine::is_ident_byte(ptr[ident_start - 1])) {
        ident_start = ident_start - 1;
    }
    if (ident_start == ident_end_excl) { return CompletionEngine::make_keyword_list(); }

    // For `::` the qualifier is part of the name: keep walking back over
    // preceding `seg::` groups so the whole path is captured.  Scraping only
    // the last segment makes `A::Foo::` and `B::Foo::` indistinguishable.
    if (is_scope) {
        while (ident_start >= 2 && ptr[ident_start - 1] == COLON
                                && ptr[ident_start - 2] == COLON) {
            mut seg_start: u64 = ident_start - 2;
            while (seg_start > 0 && CompletionEngine::is_ident_byte(ptr[seg_start - 1])) {
                seg_start = seg_start - 1;
            }
            // A `::` with no identifier before it is not part of the path.
            if (seg_start == ident_start - 2) { break; }
            ident_start = seg_start;
        }
    }

    // Build NUL-terminated C-string from the identifier bytes
    const ident_len: u64 = ident_end_excl - ident_start;
    mut ident_buf: String = String::with_capacity(ident_len + 1);
    ident_buf.push(text.sub_bytes(ident_start, ident_end_excl));
    ident_buf.push_byte(0 as u8);
    ident_buf.truncate(ident_len);
    const ident_cstr: string = ident_buf.as_ptr() as string;

    // 6. Build a parseable "completion buffer".  LSP completion always
    // fires on syntactically incomplete code - the dangling `f.` / `Foo::`
    // the user just typed - and Cryo's parser aborts the whole frontend on
    // it, so a clean compile yields no AST/types and we'd only ever reach
    // the keyword fallback.  Splice a placeholder identifier in at the
    // cursor so the receiver (`f`) / scope (`Foo`) parses and gets a real
    // type stamped; the enumerators below then read it exactly as they do
    // for a valid buffer.  Positions before the cursor are untouched, so
    // the receiver/scope the resolver looks up keeps its coordinates.
    mut patched: String = CompletionEngine::build_completion_buffer(text, byte_off);

    // 7. Compile that buffer into this URI's session.  We bypass
    // `ensure_fresh` (which compiles the *clean* buffer) and drive
    // `recompile` with the patched source directly.  This compile resets
    // the shared AST arena, so we flag the session dirty immediately: the
    // next hover / diagnostic request rebuilds from the clean editor buffer
    // and never sees the placeholder.
    const session: CompilerSession* = sessions.get_or_create(uri);
    if (session == null) {
        patched.drop();
        ident_buf.drop();
        return CompletionEngine::make_keyword_list();
    }
    session.recompile(uri, patched.as_str());
    patched.drop();
    session.needs_recompile = true;
    const ctx: CompilationContext* = session.context();
    if (ctx == null || ctx.type_arena == null || ctx.intern_table == null) {
        ident_buf.drop();
        return CompletionEngine::make_keyword_list();
    }

    // 7. Resolve the file URI to a module AST
    mut fs_path_owned: String = UriPath::uri_to_fs_path(uri);
    const fs_path: Str = fs_path_owned.as_str();
    mut path_buf: String = String::with_capacity(fs_path.length() + 1);
    path_buf.push(fs_path);
    path_buf.push_byte(0 as u8);
    fs_path_owned.drop();
    const path_buf_len: u64 = path_buf.length() - 1;
    path_buf.truncate(path_buf_len);
    const path_cstr: string = path_buf.as_ptr() as string;

    const mod_idx: i64 = ctx.module_graph.find_module_by_path(path_cstr);
    path_buf.drop();
    if (mod_idx < 0) {
        ident_buf.drop();
        return CompletionEngine::make_keyword_list();
    }
    const ast: ProgramNode* = ctx.module_graph.get_module_ast(mod_idx as u32);
    if (ast == null) {
        ident_buf.drop();
        return CompletionEngine::make_keyword_list();
    }

    // 8. Build completion items
    mut eng: CompletionEngine = CompletionEngine::new(ctx);
    mut items: Array<JsonValue> = Array<JsonValue>::with_capacity(64);

    if (is_dot) {
        // Dot completion: enumerate instance members of the receiver type.
        // Convert the last byte of the identifier from LSP 0-based coords to
        // compiler 1-based coords so node_locator can find the right node.
        const cursor_line: u32 = line + 1 as u32;
        const line_start_off: u64 = doc.line_index.byte_offset(line, 0 as u32);
        const ident_last_0based: u64 = ident_end_excl - 1 - line_start_off;
        const lookup_char: u32 = (ident_last_0based + 1) as u32;

        const node: ASTNode* = NodeLocator::find_innermost_node_at(
            ast, cursor_line, lookup_char);
        if (node != null) {
            const ty: TypeRef = NodeLocator::resolved_type_of(node);
            if (ty.is_valid() && ctx.decl_index != null) {
                const recv_ty: TypeRef = eng.unwrap_to_carrier(ty);
                if (recv_ty.is_valid()) {
                    const type_sym: SymbolStr =
                        ctx.decl_index.lookup_type_name(recv_ty);
                    if (type_sym.is_valid()) {
                        eng.collect_instance_members(type_sym, &items);
                    }
                }
            }
        }
    } else {
        // Scope-resolution completion: resolve the scraped path the way the
        // editing module would, then enumerate static methods + enum variants
        // on the declaration it names.
        const target: SymbolStr = eng.resolve_scope_path(ident_cstr, ast.namespace_name);
        if (target.is_valid()) {
            eng.collect_scope_members(target, &items);
        }
        // A path that names no declaration may still name a namespace.
        if (items.length == 0) {
            eng.collect_namespace_members(ident_cstr, &items);
        }
    }

    ident_buf.drop();

    if (items.length == 0) {
        items.drop();
        return CompletionEngine::make_keyword_list();
    }
    return CompletionEngine::make_completion_list(items);
}


// CompletionEngine - per-request member enumeration + item building
//
// Holds the compilation pointers (module `graph`, `intern` table, type
// `arena`).  Member-collection walks are `&this` methods; the pure item
// builders + string/AST utilities are `static` methods.

type struct CompletionEngine {
    graph:  ModuleGraph*;
    intern: InternTable*;
    arena:  TypeArena*;
    decl:   DeclarationIndex*;

    static new(ctx: CompilationContext*) -> CompletionEngine {
        return CompletionEngine {
            graph:  ctx.module_graph,
            intern: ctx.intern_table,
            arena:  ctx.type_arena,
            decl:   ctx.decl_index,
        };
    }


    // Scope-path resolution

    /// Resolve the scope path scraped before `::` to the qualified
    /// declaration name it refers to.  An already-qualified path is taken at
    /// face value; a bare leaf goes through the compiler's own import-scoped
    /// resolution against `use_site_ns`, so the members offered are the ones
    /// this file would actually bind.
    ///
    /// A miss or an import-visible ambiguity yields the bare name unchanged.
    /// The collectors key off whether the result carries a qualifier, so an
    /// unresolved name degrades to a leaf match - the widest list that can be
    /// offered honestly - rather than to nothing.
    resolve_scope_path(&this, path: string, use_site_ns: string) -> SymbolStr {
        if (this.intern == null) { return SymbolStr::empty(); }
        const bare: SymbolStr = this.intern.intern(path);
        if (this.decl == null || CompletionEngine::has_scope_separator(path)) {
            return bare;
        }
        const ns: SymbolStr = this.intern.intern(use_site_ns);
        return this.decl.resolve_qualified_scoped(bare, ns, this.intern).resolved_or(bare);
    }


    // Member collection

    /// Walk all modules and add fields + non-static methods that belong to
    /// `type_sym` into `items`.
    collect_instance_members(&this, type_sym: SymbolStr,
                             items: mut &Array<JsonValue>) -> void {
        if (this.graph == null || this.intern == null) { return; }
        const target: string   = this.intern.resolve(type_sym);
        const leaf: string     = CompletionEngine::leaf_after_separator(target);
        const exact: boolean   = CompletionEngine::has_scope_separator(target);

        const n: u32 = this.graph.module_count();
        for (mut mi: u32 = 0; mi < n; mi++) {
            const mod_ast: ProgramNode* = this.graph.get_module_ast(mi);
            if (mod_ast == null) { continue; }
            const mod_ns: string = mod_ast.namespace_name;
            for (mut si: i64 = 0; si < mod_ast.statements.length; si++) {
                const stmt: ASTNode* = CompletionEngine::unwrap_top_decl(mod_ast.statements[si]);
                if (stmt == null) { continue; }
                if (stmt.kind == NodeKind::StructDeclaration) {
                    const d: StructDeclNode* = stmt as StructDeclNode*;
                    if (!this.decl_matches(d.name, mod_ns, target, leaf, exact)) { continue; }
                    this.add_fields(&d.fields, items);
                    this.add_instance_methods(&d.methods, items);
                } else if (stmt.kind == NodeKind::ClassDeclaration) {
                    const d: ClassDeclNode* = stmt as ClassDeclNode*;
                    if (!this.decl_matches(d.name, mod_ns, target, leaf, exact)) { continue; }
                    this.add_fields(&d.fields, items);
                    this.add_instance_methods(&d.methods, items);
                } else if (stmt.kind == NodeKind::ImplementationBlock) {
                    const d: ImplBlockNode* = stmt as ImplBlockNode*;
                    if (!this.ref_matches(d.target_type, mod_ns, target, leaf, exact)) { continue; }
                    this.add_instance_methods(&d.methods, items);
                }
            }
        }
    }

    /// Walk all modules and add static methods + enum variants that belong to
    /// `name_sym` into `items`.
    collect_scope_members(&this, name_sym: SymbolStr,
                          items: mut &Array<JsonValue>) -> void {
        if (this.graph == null || this.intern == null) { return; }
        const target: string = this.intern.resolve(name_sym);
        const leaf: string   = CompletionEngine::leaf_after_separator(target);
        const exact: boolean = CompletionEngine::has_scope_separator(target);

        const n: u32 = this.graph.module_count();
        for (mut mi: u32 = 0; mi < n; mi++) {
            const mod_ast: ProgramNode* = this.graph.get_module_ast(mi);
            if (mod_ast == null) { continue; }
            const mod_ns: string = mod_ast.namespace_name;
            for (mut si: i64 = 0; si < mod_ast.statements.length; si++) {
                const stmt: ASTNode* = CompletionEngine::unwrap_top_decl(mod_ast.statements[si]);
                if (stmt == null) { continue; }
                if (stmt.kind == NodeKind::EnumDeclaration) {
                    const d: EnumDeclNode* = stmt as EnumDeclNode*;
                    if (!this.decl_matches(d.name, mod_ns, target, leaf, exact)) { continue; }
                    this.add_enum_variants(&d.variants, items);
                } else if (stmt.kind == NodeKind::StructDeclaration) {
                    const d: StructDeclNode* = stmt as StructDeclNode*;
                    if (!this.decl_matches(d.name, mod_ns, target, leaf, exact)) { continue; }
                    this.add_static_methods(&d.methods, items);
                } else if (stmt.kind == NodeKind::ClassDeclaration) {
                    const d: ClassDeclNode* = stmt as ClassDeclNode*;
                    if (!this.decl_matches(d.name, mod_ns, target, leaf, exact)) { continue; }
                    this.add_static_methods(&d.methods, items);
                } else if (stmt.kind == NodeKind::ImplementationBlock) {
                    const d: ImplBlockNode* = stmt as ImplBlockNode*;
                    if (!this.ref_matches(d.target_type, mod_ns, target, leaf, exact)) { continue; }
                    this.add_static_methods(&d.methods, items);
                }
            }
        }
    }

    /// Walk all modules whose namespace is exactly `ns` and add the
    /// declarations they contain.  This is what makes a path that names a
    /// namespace (`Compiler::Types::`) complete to its contents instead of
    /// falling through to the keyword list.
    collect_namespace_members(&this, ns: string, items: mut &Array<JsonValue>) -> void {
        if (this.graph == null || this.intern == null) { return; }
        if (strlen(ns) == 0) { return; }

        const n: u32 = this.graph.module_count();
        for (mut mi: u32 = 0; mi < n; mi++) {
            const mod_ast: ProgramNode* = this.graph.get_module_ast(mi);
            if (mod_ast == null) { continue; }
            if (strcmp(mod_ast.namespace_name, ns) != 0) { continue; }
            for (mut si: i64 = 0; si < mod_ast.statements.length; si++) {
                const stmt: ASTNode* = CompletionEngine::unwrap_top_decl(mod_ast.statements[si]);
                if (stmt == null) { continue; }
                if (stmt.kind == NodeKind::StructDeclaration) {
                    const d: StructDeclNode* = stmt as StructDeclNode*;
                    CompletionEngine::push_item(items, this.intern.resolve(d.name),
                                                "struct", CK_STRUCT);
                } else if (stmt.kind == NodeKind::ClassDeclaration) {
                    const d: ClassDeclNode* = stmt as ClassDeclNode*;
                    CompletionEngine::push_item(items, this.intern.resolve(d.name),
                                                "class", CK_CLASS);
                } else if (stmt.kind == NodeKind::EnumDeclaration) {
                    const d: EnumDeclNode* = stmt as EnumDeclNode*;
                    CompletionEngine::push_item(items, this.intern.resolve(d.name),
                                                "enum", CK_ENUM);
                } else if (stmt.kind == NodeKind::TraitDeclaration) {
                    const d: TraitDeclNode* = stmt as TraitDeclNode*;
                    CompletionEngine::push_item(items, this.intern.resolve(d.name),
                                                "trait", CK_INTERFACE);
                } else if (stmt.kind == NodeKind::FunctionDeclaration) {
                    const d: FunctionDeclNode* = stmt as FunctionDeclNode*;
                    const detail: string = if (this.arena != null) {
                        "(...) -> " + this.arena.resolve_display_name_short(d.resolved_return_type.id)
                    } else { "" };
                    CompletionEngine::push_item(items, this.intern.resolve(d.name),
                                                detail, CK_FUNCTION);
                }
            }
        }
    }

    add_fields(&this, fields: &FieldDeclNode*[], items: mut &Array<JsonValue>) -> void {
        if (this.arena == null) { return; }
        for (mut i: i64 = 0; i < fields.length; i++) {
            const f: FieldDeclNode* = fields[i];
            if (f == null) { continue; }
            const label: string = this.arena.intern_table.resolve(f.name);
            const detail: string = this.arena.resolve_display_name_short(f.resolved_type.id);
            CompletionEngine::push_item(items, label, detail, CK_FIELD);
        }
    }

    add_instance_methods(&this, methods: &MethodNode*[], items: mut &Array<JsonValue>) -> void {
        if (this.arena == null || this.intern == null) { return; }
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null) { continue; }
            if (m.is_static || m.is_constructor) { continue; }
            const label: string = this.intern.resolve(m.func.name);
            const detail: string = "(...) -> "
                + this.arena.resolve_display_name_short(m.func.resolved_return_type.id);
            CompletionEngine::push_item(items, label, detail, CK_METHOD);
        }
    }

    add_static_methods(&this, methods: &MethodNode*[], items: mut &Array<JsonValue>) -> void {
        if (this.arena == null || this.intern == null) { return; }
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null) { continue; }
            if (!m.is_static && !m.is_constructor) { continue; }
            const label: string = this.intern.resolve(m.func.name);
            const detail: string = "(...) -> "
                + this.arena.resolve_display_name_short(m.func.resolved_return_type.id);
            CompletionEngine::push_item(items, label, detail, CK_FUNCTION);
        }
    }

    add_enum_variants(&this, variants: &EnumVariantNode*[], items: mut &Array<JsonValue>) -> void {
        if (this.intern == null) { return; }
        for (mut i: i64 = 0; i < variants.length; i++) {
            const v: EnumVariantNode* = variants[i];
            if (v == null) { continue; }
            const label: string = this.intern.resolve(v.name);
            CompletionEngine::push_item(items, label, "", CK_ENUM_MEMBER);
        }
    }

    /// Strip `Reference`, `Pointer`, and `InstantiatedType` wrappers from
    /// `ty` until the carrier struct/class/enum TypeRef is reached.
    /// Mirrors `unwrap_to_carrier` in `Lsp::Handlers::Hover`.
    unwrap_to_carrier(&this, ty: TypeRef) -> TypeRef {
        if (this.arena == null) { return ty; }
        mut cur: TypeRef = ty;
        mut hops: i64 = 0;
        while (hops < 6) {
            if (!cur.is_valid()) { return cur; }
            const t: Type* = this.arena.lookup(cur.id);
            if (t == null) { return cur; }
            if (t.kind == TypeKind::Reference) {
                const rt: ReferenceType* = t as ReferenceType*;
                cur = rt.referent;
            } else if (t.kind == TypeKind::Pointer) {
                const pt: PointerType* = t as PointerType*;
                cur = pt.pointee;
            } else if (t.kind == TypeKind::InstantiatedType) {
                const it: InstantiatedType* = t as InstantiatedType*;
                cur = it.generic_base;
            } else {
                return cur;
            }
            hops = hops + 1;
        }
        return cur;
    }

    /// True when the declaration `decl_name`, declared in module namespace
    /// `mod_ns`, is the one `target` names.
    ///
    /// With a qualified target the namespace must agree as well as the leaf.
    /// Leaf-only matching merges every same-named declaration in the program
    /// into a single completion list; it is kept as the fallback for an
    /// unqualified target, which is either a name that did not resolve or a
    /// builtin registered without a namespace.
    decl_matches(&this, decl_name: SymbolStr, mod_ns: string, target: string,
                 target_leaf: string, exact: boolean) -> boolean {
        if (this.intern == null) { return false; }
        const dn: string = this.intern.resolve(decl_name);
        if (!exact) {
            if (strlen(target_leaf) == 0) { return false; }
            return strcmp(dn, target_leaf) == 0;
        }
        // `target` must read exactly "<mod_ns>::<dn>".
        const nl: i64 = strlen(mod_ns) as i64;
        if (nl == 0) { return false; }
        for (mut i: i64 = 0; i < nl; i++) {
            if (target[i] == 0 || target[i] != mod_ns[i]) { return false; }
        }
        if (target[nl] != ':' || target[nl + 1] != ':') { return false; }
        return strcmp(dn, target + nl + 2) == 0;
    }

    /// True when a type *reference* written inside module namespace `mod_ns`
    /// - an `implement` block's target - denotes the declaration `target`
    /// names.  Unlike a declaration's own name, the reference may be bare and
    /// bind to a type declared elsewhere, so it is resolved through the same
    /// import-scoped lookup before comparison.
    ref_matches(&this, ref_name: SymbolStr, mod_ns: string, target: string,
                target_leaf: string, exact: boolean) -> boolean {
        if (this.intern == null) { return false; }
        const rn: string = this.intern.resolve(ref_name);
        if (!exact) {
            if (strlen(target_leaf) == 0) { return false; }
            return strcmp(CompletionEngine::leaf_after_separator(rn), target_leaf) == 0;
        }
        const resolved: SymbolStr = this.resolve_scope_path(rn, mod_ns);
        if (!resolved.is_valid()) { return false; }
        return strcmp(this.intern.resolve(resolved), target) == 0;
    }

    /// True when `s` contains a `::` scope separator.
    static has_scope_separator(s: string) -> boolean {
        const len: i64 = strlen(s) as i64;
        for (mut i: i64 = 0; i + 1 < len; i++) {
            if (s[i] == ':' && s[i + 1] == ':') { return true; }
        }
        return false;
    }


    // Item builders (statics)

    /// Append a single CompletionItem with the given label, optional detail,
    /// and LSP kind.
    static push_item(items: mut &Array<JsonValue>, label: string,
                     detail: string, kind: i64) -> void {
        mut o: JsonObject = JsonObject::new();

        mut label_s: String = String::new();
        label_s.push(label);
        o.put("label", JsonValue::String(label_s));

        o.put("kind", JsonValue::int_value(kind));

        if (strlen(detail) > 0) {
            mut detail_s: String = String::new();
            detail_s.push(detail);
            o.put("detail", JsonValue::String(detail_s));
        }

        items.push(JsonValue::Object(o));
    }

    /// Append one CompletionItem of kind=Keyword (LSP kind 14).
    static push_keyword(items: mut &Array<JsonValue>, label: string) -> void {
        CompletionEngine::push_item(items, label, "", CK_KEYWORD);
    }

    /// Build the static keyword completion list (fallback).
    static make_keyword_list() -> JsonValue {
        mut items: Array<JsonValue> = Array<JsonValue>::with_capacity(20);
        CompletionEngine::push_keyword(&items, "function");
        CompletionEngine::push_keyword(&items, "return");
        CompletionEngine::push_keyword(&items, "if");
        CompletionEngine::push_keyword(&items, "else");
        CompletionEngine::push_keyword(&items, "while");
        CompletionEngine::push_keyword(&items, "for");
        CompletionEngine::push_keyword(&items, "loop");
        CompletionEngine::push_keyword(&items, "match");
        CompletionEngine::push_keyword(&items, "break");
        CompletionEngine::push_keyword(&items, "continue");
        CompletionEngine::push_keyword(&items, "type");
        CompletionEngine::push_keyword(&items, "struct");
        CompletionEngine::push_keyword(&items, "union");
        CompletionEngine::push_keyword(&items, "enum");
        CompletionEngine::push_keyword(&items, "trait");
        CompletionEngine::push_keyword(&items, "implement");
        CompletionEngine::push_keyword(&items, "import");
        CompletionEngine::push_keyword(&items, "namespace");
        CompletionEngine::push_keyword(&items, "const");
        CompletionEngine::push_keyword(&items, "mut");
        CompletionEngine::push_keyword(&items, "move");
        CompletionEngine::push_keyword(&items, "asm");
        return CompletionEngine::make_completion_list(items);
    }

    /// Wrap an items array into a LSP `CompletionList` object.
    static make_completion_list(items: Array<JsonValue>) -> JsonValue {
        mut out: JsonObject = JsonObject::new();
        out.put("isIncomplete", JsonValue::Bool(false));
        out.put("items", JsonValue::Array(items));
        return JsonValue::Object(out);
    }


    // String / AST utilities (statics)

    /// `ProgramNode.statements` may wrap top-level decls in a
    /// `DeclStmtNode`; unwrap so callers can branch on the inner kind.
    /// Mirrors `unwrap_decl_stmt` in `Compiler::AST::NodeLocator`
    /// (kept private there).
    static unwrap_top_decl(node: ASTNode*) -> ASTNode* {
        if (node == null) { return null; }
        if (node.kind != NodeKind::DeclarationStatement) { return node; }
        const d: DeclStmtNode* = node as DeclStmtNode*;
        return d.declaration as ASTNode*;
    }

    static json_u32_field(obj: &JsonValue, key: string) -> u32 {
        match (obj.get(Str::from(key))) {
            Option::Some(v) => {
                match (v) {
                    JsonValue::Number(n) => {
                        match (n) {
                            JsonNumber::Int(i)   => {
                                if (i < 0) { return 0 as u32; }
                                return i as u32;
                            }
                            JsonNumber::UInt(u)  => { return u as u32; }
                            JsonNumber::Float(f) => {
                                if (f < 0.0) { return 0 as u32; }
                                return f as u32;
                            }
                        }
                    }
                    _ => { return 0 as u32; }
                }
            }
            Option::None => { return 0 as u32; }
        }
    }

    /// Return everything after the final `::` in `s`, or `s` itself when
    /// there is no `::`.  Mirrors `leaf_after_separator` in
    /// `Lsp::Handlers::Hover` (kept private there).
    static leaf_after_separator(s: string) -> string {
        const len: i64 = strlen(s) as i64;
        mut last_sep: i64 = -1;
        for (mut i: i64 = 0; i + 1 < len; i++) {
            if (s[i] == ':' && s[i + 1] == ':') { last_sep = i; }
        }
        if (last_sep < 0) { return s; }
        const start: i64 = last_sep + 2;
        if (start >= len) { return ""; }
        return s + start;
    }

    /// True when `b` is a valid identifier byte (a-z, A-Z, 0-9, _).
    /// Mirrors `is_ident_byte` in `Lsp::Handlers::KeywordDocs`.
    static is_ident_byte(b: u8) -> boolean {
        if (b >= 97 as u8 && b <= 122 as u8) { return true; }
        if (b >= 65 as u8 && b <= 90 as u8)  { return true; }
        if (b >= 48 as u8 && b <= 57 as u8)  { return true; }
        if (b == 95 as u8) { return true; }
        return false;
    }

    /// Build a parseable copy of `text` with the placeholder identifier
    /// `__cryo_completion__` spliced in at byte offset `cursor` (right after
    /// the `.` / `::` the user just typed).  This turns the incomplete
    ///   f.            ->  f.__cryo_completion__;
    ///   Foo::         ->  Foo::__cryo_completion__;
    /// into something the compiler parses cleanly, so the receiver / scope
    /// before the cursor gets a real type and the enumerators resolve it.
    ///
    /// The trailing `;` is appended only when the rest of the cursor's line
    /// is blank (statement position).  In an in-progress expression such as
    /// `bar(f.)` the remainder is non-blank, so no `;` is added and the
    /// result `bar(f.__cryo_completion__)` still parses; inserting a `;`
    /// there would break it.  The placeholder name is never matched against
    /// anything - the resolver reads the receiver/scope, which sits before
    /// the splice - so a collision with a real member is harmless.
    static build_completion_buffer(text: Str, cursor: u64) -> String {
        const len: u64 = text.length();
        const ptr: u8* = text.as_ptr();
        const LF:  u8 = 10 as u8;
        const SP:  u8 = 32 as u8;
        const TAB: u8 = 9 as u8;
        const CR:  u8 = 13 as u8;

        // Statement position if every byte from the cursor to the next
        // newline (or EOF) is whitespace.
        mut rest_blank: boolean = true;
        mut i: u64 = cursor;
        while (i < len) {
            const b: u8 = ptr[i];
            if (b == LF) { break; }
            if (b != SP && b != TAB && b != CR) { rest_blank = false; break; }
            i = i + 1;
        }

        mut out: String = String::with_capacity(len + 24);
        if (cursor > 0)   { out.push(text.sub_bytes(0, cursor)); }
        out.push("__cryo_completion__");
        if (rest_blank)   { out.push_byte(59 as u8); }         // ';'
        if (cursor < len) { out.push(text.sub_bytes(cursor, len)); }
        return out;
    }
}
