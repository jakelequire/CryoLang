///! Completion handler.
///!
///! v1: returns a small static list of Cryo keywords so the trigger
///! characters (`.` and `::`) at least produce *something* in the
///! editor.  Real symbol-aware completion needs:
///!   • the position-→-AST-node walker (shared with hover/definition)
///!   • member enumeration via `node.resolved_type` → arena lookup
///!   • scope walking via the resolver
///!
///! Returning a CompletionList (rather than just an array) lets us
///! signal `isIncomplete: true` when we want the editor to keep
///! re-querying as the user types.

namespace Lsp::Handlers::Completion;

import std::core::option;
import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::json::value;

import Lsp::Server::Docs;
import Lsp::Server::Session;


public function handle_completion(docs: &Docs, sessions: mut &SessionMap,
                                   params: &JsonValue) -> JsonValue {
    match (params.get(Str::from_cstr("textDocument"))) {
        Option::Some(_) => { }
        Option::None    => { }
    }

    mut items: Array<JsonValue> = Array<JsonValue>::with_capacity(20);
    push_keyword(&items, "function");
    push_keyword(&items, "return");
    push_keyword(&items, "if");
    push_keyword(&items, "else");
    push_keyword(&items, "while");
    push_keyword(&items, "for");
    push_keyword(&items, "loop");
    push_keyword(&items, "match");
    push_keyword(&items, "break");
    push_keyword(&items, "continue");
    push_keyword(&items, "type");
    push_keyword(&items, "struct");
    push_keyword(&items, "enum");
    push_keyword(&items, "trait");
    push_keyword(&items, "implement");
    push_keyword(&items, "import");
    push_keyword(&items, "namespace");
    push_keyword(&items, "const");

    mut out: JsonObject = JsonObject::new();
    out.insert(
        String::from_str(Str::from_cstr("isIncomplete")),
        JsonValue::Bool(false));
    out.insert(
        String::from_str(Str::from_cstr("items")),
        JsonValue::Array(items));
    return JsonValue::Object(out);
}


/// Append one CompletionItem of kind=Keyword (LSP enum 14).
function push_keyword(items: mut &Array<JsonValue>, label: string) -> void {
    mut o: JsonObject = JsonObject::new();
    mut label_buf: String = String::new();
    label_buf.push_cstr(label);
    o.insert(String::from_str(Str::from_cstr("label")),
             JsonValue::String(label_buf));
    o.insert(String::from_str(Str::from_cstr("kind")),
             JsonValue::Number(JsonNumber::Int(14 as i64)));
    items.push(JsonValue::Object(o));
}
