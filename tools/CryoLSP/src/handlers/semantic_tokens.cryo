///! Semantic tokens (`textDocument/semanticTokens/full`).
///!
///! Every name written in the document is coloured by what it names: the
///! uses index (`uses`) holds each one with the identity its stamp gives - a
///! module, a type of some kind, a function or method, a global, a local or
///! parameter, a type parameter, a field, a variant - and whether it is the
///! declaration.  A node the compiler wrote (an f-string's lowering, a
///! closure struct) is not in the index, so nothing paints over the source
///! it stands for; a method's receiver and `this` are left to the grammar's
///! keyword colour.  Beside the names, the segments of an import's or a
///! namespace's path are namespaces, and an inline assembly block's text is
///! coloured by a small assembly lexer.
///!
///! Spans are positions in the text the analysis read: each token is
///! measured there and carried to the buffer's line, and a line edited since
///! the analysis gets none.  Tokens are sorted and overlapping ones dropped
///! before the wire encoding.

namespace lsp::handlers::semantic_tokens;

import std::core::option;
import std::core::drop;
import std::core::mem;
import std::collections::str;
import std::collections::string::{ String };
import std::collections::array::{ Array };
import std::json::value;

import compiler::compilation_context::{ CompilationContext };
import compiler::ast::node::{ Node, ProgramNode };
import compiler::ast::node_locator::{ NodeLocator };
import compiler::ast::statement;
import compiler::ast::declaration::{
    DeclarationNode, DeclKind, ImportDecl, MethodDecl, ModuleDecl, VarDecl
};
import compiler::diag::source_span;
import compiler::resolver::res::{ DefId, DefKind };
import compiler::resolver::symbol::{ Symbol, SymbolKind };

import lsp::handlers::identity::{ Target };
import lsp::handlers::uses::{ Use, Uses };
import lsp::server::docs;
import lsp::server::session;
import lsp::server::line_index;
import lsp::protocol::semantic_tokens::{ SemanticToken };
import lsp::protocol::conv;


/// One request's tokens, and what they are measured against: the text the
/// analysis read for the document (`line_index`, `doc_text`), carried to
/// the buffer's lines through `doc`.
type struct SemanticTokenizer {
    ctx:              CompilationContext*;
    line_index:       line_index::LineIndex*;
    doc_text:         string;
    doc_text_length:  i64;
    doc_file:         string;
    /// Wire columns count bytes rather than UTF-16 code units.
    utf8:             boolean;
    /// The open document, which carries a line of the analysed text to the
    /// buffer's line; null when the document is not open.
    doc:              docs::Document*;
    tokens:           Array<SemanticToken>;

    static new(ctx: CompilationContext*, docs: &docs::Docs, uri: str::Str,
               doc_file: string) -> SemanticTokenizer {
        mut t: SemanticTokenizer = SemanticTokenizer {
            ctx:              ctx,
            line_index:       null,
            doc_text:         "",
            doc_text_length:  0,
            doc_file:         doc_file,
            utf8:             docs.utf8,
            doc:              null,
            tokens:           Array::<SemanticToken>::new(),
        };
        // Spans are positions in the text the analysis read: measure them
        // there, and carry each token's line to the buffer (`doc`).
        match (docs.get(uri)) {
            Option::Some(doc) => {
                if (doc != null) {
                    t.doc = doc;
                    if (doc.has_snap) {
                        t.line_index      = &doc.snap_index;
                        t.doc_text        = doc.snap_text.as_ptr() as string;
                        t.doc_text_length = doc.snap_text.length();
                    } else {
                        t.line_index      = &doc.line_index;
                        t.doc_text        = doc.text.as_ptr() as string;
                        t.doc_text_length = doc.text.length();
                    }
                }
            }
            Option::None => { }
        }
        return t;
    }


    // What is written in module `m`

    colour(mut &this, m: i64) -> void {
        const w: Uses = Uses::scan(this.ctx, m);
        for (mut i: i64 = 0; i < w.out.length(); i++) { this.use_token(&w.out[i]); }
        const program: ProgramNode* = this.ctx.module_graph.get_module_ast(m as u32);
        if (program != null) {
            for (mut i: i64 = 0; i < program.statements.length(); i++) {
                this.path_segments(program.statements[i]);
            }
        }
        for (mut i: i64 = 0; i < w.asm.length(); i++) { this.asm_body(w.asm[i]); }
    }

    /// A name, coloured by what it names.
    use_token(mut &this, u: &Use) -> void {
        if (u.receiver) { return; }
        const decl: u32 = if (u.decl) {
            lsp::protocol::semantic_tokens::MOD_DECLARATION
        } else {
            lsp::protocol::semantic_tokens::MOD_NONE
        };
        match (&u.target) {
            Target::Def(d) => { this.def_token(u.span, d, decl); }
            Target::Local(s) => {
                const sym: Symbol = this.ctx.resolver.get_symbol(s);
                if (sym.kind == SymbolKind::Parameter) {
                    this.emit_span(u.span, lsp::protocol::semantic_tokens::TYPE_PARAMETER, decl);
                    return;
                }
                const ro: u32 = if (sym.is_mutable) {
                    lsp::protocol::semantic_tokens::MOD_NONE
                } else {
                    lsp::protocol::semantic_tokens::MOD_READONLY
                };
                this.emit_span(u.span, lsp::protocol::semantic_tokens::TYPE_VARIABLE, decl | ro);
            }
            Target::TypeParam(_) => {
                this.emit_span(u.span, lsp::protocol::semantic_tokens::TYPE_TYPE_PARAM, decl);
            }
            Target::Field(_, _) => {
                this.emit_span(u.span, lsp::protocol::semantic_tokens::TYPE_PROPERTY, decl);
            }
            Target::Variant(_, _) => {
                this.emit_span(u.span, lsp::protocol::semantic_tokens::TYPE_ENUM_MEMBER, decl);
            }
            // A primitive keeps the grammar's colour.
            _ => { }
        }
    }

    /// A definition's name: its kind, and for a type the kind of type its
    /// declaration is.
    def_token(mut &this, span: source_span::SourceSpan, d: DefId, decl: u32) -> void {
        const node: DeclarationNode* = this.ctx.decl_index.declaration_of(d);
        match (this.ctx.defs.kind_of(d)) {
            DefKind::Module => {
                this.emit_span(span, lsp::protocol::semantic_tokens::TYPE_NAMESPACE, decl);
            }
            DefKind::Type => {
                mut ty: u32 = lsp::protocol::semantic_tokens::TYPE_TYPE;
                if (node != null) {
                    ty = match (node.kind) {
                        DeclKind::Struct(_) => { lsp::protocol::semantic_tokens::TYPE_STRUCT }
                        DeclKind::Enum(_)   => { lsp::protocol::semantic_tokens::TYPE_ENUM }
                        DeclKind::Union(_)  => { lsp::protocol::semantic_tokens::TYPE_STRUCT }
                        DeclKind::Trait(_)  => { lsp::protocol::semantic_tokens::TYPE_INTERFACE }
                        DeclKind::Import(_) | DeclKind::Intrinsic(_) | DeclKind::Impl(_)
                        | DeclKind::Module(_) | DeclKind::Variant(_) | DeclKind::Destructure(_)
                        | DeclKind::Extern(_) | DeclKind::TypeAlias(_) | DeclKind::Field(_)
                        | DeclKind::GenericParam(_) | DeclKind::Variable(_) | DeclKind::Function(_)
                        | DeclKind::Method(_) => {
                            lsp::protocol::semantic_tokens::TYPE_TYPE
                        }
                    };
                }
                this.emit_span(span, ty, decl);
            }
            DefKind::Function => {
                this.emit_span(span, lsp::protocol::semantic_tokens::TYPE_FUNCTION, decl);
            }
            DefKind::Method => {
                mut mods: u32 = decl;
                if (node != null && DeclarationNode::method_of(node) != null
                        && DeclarationNode::method_of(node).is_static) {
                    mods = mods | lsp::protocol::semantic_tokens::MOD_STATIC;
                }
                this.emit_span(span, lsp::protocol::semantic_tokens::TYPE_METHOD, mods);
            }
            DefKind::Value => {
                mut mods: u32 = decl;
                if (node != null && DeclarationNode::var_of(node) != null
                        && !(DeclarationNode::var_of(node)).is_mutable) {
                    mods = mods | lsp::protocol::semantic_tokens::MOD_READONLY;
                }
                this.emit_span(span, lsp::protocol::semantic_tokens::TYPE_VARIABLE, mods);
            }
            _ => { }
        }
    }

    /// Each segment of an import's path, or of the path a `namespace` or
    /// `module` declares, is a namespace.
    path_segments(mut &this, stmt: Node) -> void {
        const n: DeclarationNode* = NodeLocator::unwrap_decl_stmt(stmt).as_decl();
        if (n == null || n.generated) { return; }
        const imp: ImportDecl* = DeclarationNode::import_of(n);
        if (imp != null) {
            for (mut i: i64 = 0; i < imp.path_segment_spans.length(); i++) {
                this.emit_span(imp.path_segment_spans[i], lsp::protocol::semantic_tokens::TYPE_NAMESPACE,
                               lsp::protocol::semantic_tokens::MOD_NONE);
            }
        } else if (DeclarationNode::module_of(n) != null) {
            const md: ModuleDecl* = DeclarationNode::module_of(n);
            for (mut i: i64 = 0; i < md.path_segment_spans.length(); i++) {
                this.emit_span(md.path_segment_spans[i], lsp::protocol::semantic_tokens::TYPE_NAMESPACE,
                               lsp::protocol::semantic_tokens::MOD_NONE);
            }
        }
    }


    // Token emission + sorting

    /// Emit a single token for `span`, classified as (`type_id`, `modifiers`).
    /// Converts compiler 1-based line/col to LSP 0-based, and clamps the
    /// length so a multi-line span (rare for identifiers) reports just the
    /// portion on the start line.  A span in another file, or one that does
    /// not fit the analysed text, is dropped.
    emit_span(mut &this, span: source_span::SourceSpan, type_id: u32, modifiers: u32) -> void {
        if (!span.has_location()) { return; }
        if (span.start_line == 0 as u32) { return; }
        if (this.doc_file != "" && span.file != "" && !SemanticTokenizer::file_paths_equal(span.file, this.doc_file)) {
            return;
        }
        const line: u32   = span.start_line - 1 as u32;

        // Compiler columns become wire columns through `Columns`, measured
        // against the analysed text.  Without it there is nothing to
        // measure, and the compiler's columns are used as they are.
        mut start_byte: u32 = if (span.start_col > 0 as u32) {
            span.start_col - 1 as u32
        } else {
            0 as u32
        };
        mut end_byte_opt: u32 = if (span.end_line == span.start_line
                                     && span.end_col > span.start_col) {
            span.end_col - 1 as u32
        } else {
            start_byte + 1 as u32
        };

        if (this.line_index != null && this.doc_text != "") {
            if (line as i64 >= this.line_index.line_count()) { return; }
            const line_start: i64 = this.line_index.line_start(line);
            const line_end:   i64 = this.line_index.line_end(line);
            mut line_bytes: i64 = if (line_end > line_start) {
                line_end - line_start
            } else {
                0
            };
            if (line_bytes > 0 && line as i64 + 1 < this.line_index.line_count()) {
                line_bytes = line_bytes - 1;            // strip trailing \n
            }
            // Trim a trailing \r if present (CRLF input - line_index counts
            // \n only, so the \r sits inside line_bytes).
            if (line_bytes > 0 && (line_start + line_bytes - 1) < this.doc_text_length) {
                const last_byte: u8 = this.doc_text[(line_start + line_bytes - 1) as i64] as u8;
                if (last_byte == 13 as u8) { line_bytes = line_bytes - 1; }
            }

            const line_text: str::Str = str::Str::from_raw((this.doc_text + line_start as i64) as u8*, line_bytes);
            const sb: i64 = line_index::Columns::compiler_to_byte(line_text, span.start_col);
            mut eb: i64 = sb + 1;
            if (span.end_line == span.start_line && span.end_col > span.start_col) {
                eb = line_index::Columns::compiler_to_byte(line_text, span.end_col);
            }

            // Validate the resolved byte range against the line's length.
            if (sb >= line_bytes && line_bytes > 0) { return; }
            if (eb > line_bytes) { eb = line_bytes; }
            start_byte = line_index::Columns::byte_to_wire(line_text, sb, this.utf8);
            end_byte_opt = line_index::Columns::byte_to_wire(line_text, eb, this.utf8);
        }

        mut length: u32 = if (end_byte_opt > start_byte) {
            end_byte_opt - start_byte
        } else {
            1 as u32
        };
        if (length == 0 as u32) { return; }

        this.push_token(line, start_byte, length, type_id, modifiers);
    }

    /// Push a token on line `line` of the analysed text, moved to the
    /// buffer's line; a line edited since the analysis gets no token.
    push_token(mut &this, line: u32, start_char: u32, length: u32,
               type_id: u32, modifiers: u32) -> void {
        mut out_line: u32 = line;
        if (this.doc != null) {
            const cur: i64 = this.doc.buffer_line_of(line);
            if (cur < 0) { return; }
            out_line = cur as u32;
        }
        this.tokens.push(SemanticToken::new(out_line, start_char, length, type_id, modifiers));
    }


    // Inline-asm block colouring
    //
    // The parser does NOT keep per-token spans for the assembly body - it
    // stores a list of reconstructed text `pieces` (see AsmBlockStmt).
    // So the block's source region is re-scanned straight out of the
    // analysed text with a small asm-aware lexer, emitting tokens in 0-based
    // BYTE coordinates via `emit_raw` (asm is ASCII, so byte == LSP char and
    // there's no tab-cell translation to do).  The `${expr}` operands ARE
    // real Cryo expressions with spans, and are names in the uses index.

    /// Push a token in 0-based LSP coordinates.  Used by the asm re-scanner,
    /// which reads the analysed text's bytes and therefore already has valid
    /// character offsets - no cell-column translation or span validation
    /// needed (positions come from within a known-good line).
    emit_raw(mut &this, line0: u32, start_char: u32, length: u32,
             type_id: u32, modifiers: u32) -> void {
        if (length == 0 as u32) { return; }
        this.push_token(line0, start_char, length, type_id, modifiers);
    }

    /// `node` is an `asm` statement.
    asm_body(mut &this, node: statement::Stmt*) -> void {
        if (node == null) { return; }
        if (this.line_index == null || this.doc_text == "") { return; }
        const span: source_span::SourceSpan = node.span;
        if (!span.has_location()) { return; }
        if (span.start_line == 0 as u32) { return; }
        mut intel: boolean = false;
        match (node.kind) {
            statement::StmtKind::Asm(a) => {
                intel = match (a.dialect) {
                    statement::AsmDialect::Intel => { true }
                    statement::AsmDialect::ATT   => { false }
                };
            }
            _ => { return; }
        }
        mut ln: u32 = span.start_line - 1 as u32;                 // 0-based
        const last: u32 = if (span.end_line >= span.start_line) {
            span.end_line - 1 as u32
        } else { ln };
        const total: i64 = this.line_index.line_count();
        while (ln as i64 <= last as i64 && (ln as i64) < total) {
            this.scan_asm_line(ln, intel);
            ln = ln + 1 as u32;
        }
    }

    /// Tokenize one line of an asm block body and emit semantic tokens.
    /// Handles AT&T and (best-effort) Intel: `%reg` registers, `$imm`
    /// immediates and `$sym` address-of, bare numbers, `.directives`,
    /// `label:` definitions, instruction mnemonics, symbol references,
    /// comments (`#`, `//`, and `;` in Intel), string literals, and
    /// punctuation.  `${...}` operand refs are skipped (their names are
    /// coloured from the uses index).
    scan_asm_line(mut &this, line0: u32, intel: boolean) -> void {
        if (line0 as i64 >= this.line_index.line_count()) { return; }
        const line_start: i64 = this.line_index.line_start(line0);
        const line_end_raw: i64 = this.line_index.line_end(line0);
        mut line_bytes: i64 = if (line_end_raw > line_start) {
            line_end_raw - line_start
        } else { 0 };
        // Strip the trailing '\n' (line_end points past it for non-last lines).
        if (line_bytes > 0 && line0 as i64 + 1 < this.line_index.line_count()) {
            line_bytes = line_bytes - 1;
        }
        // Strip a trailing '\r' (CRLF).
        if (line_bytes > 0 && (line_start + line_bytes - 1) < this.doc_text_length) {
            const lb: u8 = this.doc_text[(line_start + line_bytes - 1) as i64] as u8;
            if (lb == 13 as u8) { line_bytes = line_bytes - 1; }
        }
        if (line_bytes == 0) { return; }

        const base: string = this.doc_text + line_start as i64;
        const n: u32 = line_bytes as u32;
        mut i: u32 = 0 as u32;
        // False until the instruction's mnemonic has been emitted on this
        // logical instruction; the first bare identifier becomes the mnemonic,
        // later ones are operand symbols.  Reset by `{`/`}` and a `label:`.
        mut instr_started: boolean = false;

        while (i < n) {
            const c: u8 = base[i as i64] as u8;

            // Whitespace.
            if (c == 32 as u8 || c == 9 as u8 || c == 13 as u8) {
                i = i + 1 as u32; continue;
            }
            // Comments run to end-of-line.
            if (c == 35 as u8) {                                  // '#'
                this.emit_raw(line0, i, n - i,
                    lsp::protocol::semantic_tokens::TYPE_COMMENT,
                    lsp::protocol::semantic_tokens::MOD_NONE);
                return;
            }
            if (c == 47 as u8 && i + (1 as u32) < n
                    && (base[(i + 1 as u32) as i64] as u8) == 47 as u8) {   // '//'
                this.emit_raw(line0, i, n - i,
                    lsp::protocol::semantic_tokens::TYPE_COMMENT,
                    lsp::protocol::semantic_tokens::MOD_NONE);
                return;
            }
            if (intel && c == 59 as u8) {                         // ';' (Intel only)
                this.emit_raw(line0, i, n - i,
                    lsp::protocol::semantic_tokens::TYPE_COMMENT,
                    lsp::protocol::semantic_tokens::MOD_NONE);
                return;
            }
            // `${...}` operand reference - its names come from the uses
            // index; skip the whole `${...}` span here.
            if (c == 36 as u8 && i + (1 as u32) < n
                    && (base[(i + 1 as u32) as i64] as u8) == 123 as u8) {   // '${'
                mut depth: i64 = 0;
                mut opened: boolean = false;
                while (i < n) {
                    const cc: u8 = base[i as i64] as u8;
                    if (cc == 123 as u8) { depth = depth + 1; opened = true; }
                    else if (cc == 125 as u8) { depth = depth - 1; }
                    i = i + 1 as u32;
                    if (opened && depth == 0) { break; }
                }
                instr_started = true;
                continue;
            }
            // Block delimiters: `asm {` open and the closing `}`.  Reset the
            // instruction state so an instruction sharing the `{`/`}` line
            // (`asm { nop }`) still classifies its mnemonic correctly.
            if (c == 123 as u8 || c == 125 as u8) {               // '{' '}'
                instr_started = false; i = i + 1 as u32; continue;
            }
            // String literal.
            if (c == 34 as u8) {                                  // '"'
                mut j: u32 = i + 1 as u32;
                while (j < n && (base[j as i64] as u8) != 34 as u8) {
                    if ((base[j as i64] as u8) == 92 as u8 && j + (1 as u32) < n) {
                        j = j + 1 as u32;                          // skip escape
                    }
                    j = j + 1 as u32;
                }
                if (j < n) { j = j + 1 as u32; }                  // closing quote
                this.emit_raw(line0, i, j - i,
                    lsp::protocol::semantic_tokens::TYPE_STRING,
                    lsp::protocol::semantic_tokens::MOD_NONE);
                i = j; continue;
            }
            // AT&T register: `%name`.
            if (c == 37 as u8) {                                  // '%'
                mut j: u32 = i + 1 as u32;
                while (j < n && SemanticTokenizer::is_asm_ident_byte(base[j as i64] as u8)) {
                    j = j + 1 as u32;
                }
                this.emit_raw(line0, i, j - i,
                    lsp::protocol::semantic_tokens::TYPE_VARIABLE,
                    lsp::protocol::semantic_tokens::MOD_DEFAULT_LIBRARY);
                i = j; instr_started = true; continue;
            }
            // Immediate: `$number`, `$-number`, or `$symbol` (address-of).
            if (c == 36 as u8) {                                  // '$' (not '${')
                mut j: u32 = i + 1 as u32;
                if (j < n) {
                    const s: u8 = base[j as i64] as u8;
                    if (s == 43 as u8 || s == 45 as u8) { j = j + 1 as u32; }  // sign
                }
                const sym_start: u32 = j;
                if (j < n && SemanticTokenizer::is_asm_ident_start(base[j as i64] as u8)) {
                    while (j < n && SemanticTokenizer::is_asm_ident_byte(base[j as i64] as u8)) {
                        j = j + 1 as u32;
                    }
                    this.emit_raw(line0, i, 1 as u32,
                        lsp::protocol::semantic_tokens::TYPE_OPERATOR,
                        lsp::protocol::semantic_tokens::MOD_NONE);
                    this.emit_raw(line0, sym_start, j - sym_start,
                        lsp::protocol::semantic_tokens::TYPE_FUNCTION,
                        lsp::protocol::semantic_tokens::MOD_NONE);
                } else {
                    while (j < n && SemanticTokenizer::is_asm_number_byte(base[j as i64] as u8)) {
                        j = j + 1 as u32;
                    }
                    this.emit_raw(line0, i, j - i,
                        lsp::protocol::semantic_tokens::TYPE_NUMBER,
                        lsp::protocol::semantic_tokens::MOD_NONE);
                }
                i = j; instr_started = true; continue;
            }
            // Bare number (displacement `8(%rax)`, `-16`, `0x10`).
            const is_neg_num: boolean = c == 45 as u8 && i + (1 as u32) < n
                && SemanticTokenizer::is_asm_digit(base[(i + 1 as u32) as i64] as u8);
            if (SemanticTokenizer::is_asm_digit(c) || is_neg_num) {
                mut j: u32 = if (is_neg_num) { i + 1 as u32 } else { i };
                while (j < n && SemanticTokenizer::is_asm_number_byte(base[j as i64] as u8)) {
                    j = j + 1 as u32;
                }
                this.emit_raw(line0, i, j - i,
                    lsp::protocol::semantic_tokens::TYPE_NUMBER,
                    lsp::protocol::semantic_tokens::MOD_NONE);
                i = j; instr_started = true; continue;
            }
            // Identifier: `.directive`, `label:`, mnemonic, or symbol ref.
            if (SemanticTokenizer::is_asm_ident_start(c) || c == 46 as u8) {   // '.'
                const start: u32 = i;
                mut j: u32 = i;
                if (c == 46 as u8) { j = j + 1 as u32; }          // leading '.'
                while (j < n && SemanticTokenizer::is_asm_ident_byte(base[j as i64] as u8)) {
                    j = j + 1 as u32;
                }
                const len: u32 = j - start;
                if (len == 0 as u32) { i = i + 1 as u32; continue; }
                const is_label: boolean = j < n && (base[j as i64] as u8) == 58 as u8;  // ':'
                if (c == 46 as u8) {
                    this.emit_raw(line0, start, len,
                        lsp::protocol::semantic_tokens::TYPE_MACRO,
                        lsp::protocol::semantic_tokens::MOD_NONE);
                    instr_started = true;
                } else if (is_label) {
                    this.emit_raw(line0, start, len,
                        lsp::protocol::semantic_tokens::TYPE_FUNCTION,
                        lsp::protocol::semantic_tokens::MOD_DECLARATION);
                    instr_started = false;                        // label isn't the instruction
                } else if (!instr_started) {
                    // Instruction mnemonic (or a prefix).  Positional: the
                    // first identifier on the line is the mnemonic whatever it
                    // is, so every instruction is covered without an allowlist.
                    // A prefix (`lock`, `rep`, ...) precedes the real mnemonic,
                    // so leave `instr_started` false to colour the next token
                    // as a mnemonic too.
                    this.emit_raw(line0, start, len,
                        lsp::protocol::semantic_tokens::TYPE_KEYWORD,
                        lsp::protocol::semantic_tokens::MOD_NONE);
                    if (!SemanticTokenizer::is_asm_prefix(base, start, len)) {
                        instr_started = true;
                    }
                } else if (intel && SemanticTokenizer::is_intel_register(base, start, len)) {
                    this.emit_raw(line0, start, len,
                        lsp::protocol::semantic_tokens::TYPE_VARIABLE,
                        lsp::protocol::semantic_tokens::MOD_DEFAULT_LIBRARY);
                } else {
                    this.emit_raw(line0, start, len,
                        lsp::protocol::semantic_tokens::TYPE_FUNCTION,
                        lsp::protocol::semantic_tokens::MOD_NONE);  // symbol ref (hover target)
                }
                i = j; continue;
            }
            // Operator punctuation.
            if (c == 44 as u8 || c == 40 as u8 || c == 41 as u8 || c == 91 as u8
                    || c == 93 as u8 || c == 43 as u8 || c == 45 as u8
                    || c == 42 as u8 || c == 58 as u8) {          // , ( ) [ ] + - * :
                this.emit_raw(line0, i, 1 as u32,
                    lsp::protocol::semantic_tokens::TYPE_OPERATOR,
                    lsp::protocol::semantic_tokens::MOD_NONE);
                i = i + 1 as u32; continue;
            }
            // Anything else: skip one byte.
            i = i + 1 as u32;
        }
    }

    static is_asm_ident_start(b: u8) -> boolean {
        return (b >= 65 as u8 && b <= 90 as u8)      // A-Z
            || (b >= 97 as u8 && b <= 122 as u8)     // a-z
            || b == 95 as u8;                         // _
    }

    static is_asm_ident_byte(b: u8) -> boolean {
        return SemanticTokenizer::is_asm_ident_start(b)
            || (b >= 48 as u8 && b <= 57 as u8)      // 0-9
            || b == 46 as u8                          // .
            || b == 36 as u8;                         // $ (mangled symbols)
    }

    static is_asm_digit(b: u8) -> boolean {
        return b >= 48 as u8 && b <= 57 as u8;
    }

    static is_asm_number_byte(b: u8) -> boolean {
        return SemanticTokenizer::is_asm_digit(b)
            || (b >= 97 as u8 && b <= 102 as u8)     // a-f
            || (b >= 65 as u8 && b <= 70 as u8)      // A-F
            || b == 120 as u8 || b == 88 as u8        // x X (0x prefix)
            || b == 95 as u8;                         // _ digit separator
    }

    /// True when `lit` (a NUL-terminated literal) exactly equals the byte
    /// window `p[start .. start+len)`.
    static region_eq(p: string, start: u32, len: u32, lit: string) -> boolean {
        mut k: u32 = 0 as u32;
        loop {
            const lc: u8 = lit[k as i64] as u8;
            if (lc == 0 as u8) { return k == len; }   // both ended together
            if (k >= len) { return false; }
            if ((p[(start + k) as i64] as u8) != lc) { return false; }
            k = k + 1 as u32;
        }
        return false;
    }

    /// Instruction prefixes that precede the real mnemonic on the same line
    /// (`lock cmpxchg`, `rep movsb`).  Kept as a small allowlist so the token
    /// AFTER a prefix is still coloured as an instruction rather than a symbol
    /// reference - the mnemonics themselves need no list (they're positional).
    static is_asm_prefix(p: string, start: u32, len: u32) -> boolean {
        if (len < 3 as u32 || len > 8 as u32) { return false; }
        return SemanticTokenizer::region_eq(p, start, len, "lock")
            || SemanticTokenizer::region_eq(p, start, len, "rep")
            || SemanticTokenizer::region_eq(p, start, len, "repe")
            || SemanticTokenizer::region_eq(p, start, len, "repz")
            || SemanticTokenizer::region_eq(p, start, len, "repne")
            || SemanticTokenizer::region_eq(p, start, len, "repnz")
            || SemanticTokenizer::region_eq(p, start, len, "bnd")
            || SemanticTokenizer::region_eq(p, start, len, "notrack")
            || SemanticTokenizer::region_eq(p, start, len, "data16")
            || SemanticTokenizer::region_eq(p, start, len, "addr32")
            || SemanticTokenizer::region_eq(p, start, len, "xacquire")
            || SemanticTokenizer::region_eq(p, start, len, "xrelease");
    }

    /// Best-effort recognition of an Intel-syntax register name (AT&T uses
    /// `%`, handled directly).  Covers the common integer + vector registers;
    /// exotic names fall through and colour as symbol references.
    static is_intel_register(p: string, start: u32, len: u32) -> boolean {
        if (len < 2 as u32 || len > 5 as u32) { return false; }
        const c0: u8 = p[start as i64] as u8;
        // Vector: xmm/ymm/zmm + index.
        if (len >= 4 as u32
                && (c0 == 120 as u8 || c0 == 121 as u8 || c0 == 122 as u8)   // x y z
                && (p[(start + 1 as u32) as i64] as u8) == 109 as u8          // m
                && (p[(start + 2 as u32) as i64] as u8) == 109 as u8) {       // m
            return true;
        }
        // Extended GPRs r8..r15 (optional b/w/d suffix, e.g. r10d).
        if (c0 == 114 as u8) {                                    // 'r'
            const c1: u8 = p[(start + 1 as u32) as i64] as u8;
            if (c1 >= 56 as u8 && c1 <= 57 as u8) { return true; }            // r8 r9
            if (c1 == 49 as u8 && len >= 3 as u32) {                          // r1?
                const c2: u8 = p[(start + 2 as u32) as i64] as u8;
                if (c2 >= 48 as u8 && c2 <= 53 as u8) { return true; }        // r10..r15
            }
        }
        return SemanticTokenizer::region_eq(p, start, len, "rax")
            || SemanticTokenizer::region_eq(p, start, len, "rbx")
            || SemanticTokenizer::region_eq(p, start, len, "rcx")
            || SemanticTokenizer::region_eq(p, start, len, "rdx")
            || SemanticTokenizer::region_eq(p, start, len, "rsi")
            || SemanticTokenizer::region_eq(p, start, len, "rdi")
            || SemanticTokenizer::region_eq(p, start, len, "rbp")
            || SemanticTokenizer::region_eq(p, start, len, "rsp")
            || SemanticTokenizer::region_eq(p, start, len, "rip")
            || SemanticTokenizer::region_eq(p, start, len, "eax")
            || SemanticTokenizer::region_eq(p, start, len, "ebx")
            || SemanticTokenizer::region_eq(p, start, len, "ecx")
            || SemanticTokenizer::region_eq(p, start, len, "edx")
            || SemanticTokenizer::region_eq(p, start, len, "esi")
            || SemanticTokenizer::region_eq(p, start, len, "edi")
            || SemanticTokenizer::region_eq(p, start, len, "ebp")
            || SemanticTokenizer::region_eq(p, start, len, "esp")
            || SemanticTokenizer::region_eq(p, start, len, "ax")
            || SemanticTokenizer::region_eq(p, start, len, "bx")
            || SemanticTokenizer::region_eq(p, start, len, "cx")
            || SemanticTokenizer::region_eq(p, start, len, "dx")
            || SemanticTokenizer::region_eq(p, start, len, "al")
            || SemanticTokenizer::region_eq(p, start, len, "bl")
            || SemanticTokenizer::region_eq(p, start, len, "cl")
            || SemanticTokenizer::region_eq(p, start, len, "dl");
    }

    /// In-place insertion sort by (line, start_char).  Token counts per
    /// file are modest (a few thousand at most for stdlib-sized files);
    /// insertion sort's O(n2) is fine and avoids allocating a temporary.
    /// Stable: ties keep emission order.
    sort_tokens(mut &this) -> void {
        // Index/mutate through the raw element pointer: no element is
        // dropped or replaced wholesale, so the Array invariants stay intact.
        const data: SemanticToken* = this.tokens.as_ptr();
        const n: i64 = this.tokens.length() as i64;
        for (mut i: i64 = 1; i < n; i++) {
            const t: SemanticToken = data[i];
            mut j: i64 = i - 1;
            // The comparator takes its operands by reference: a by-value
            // pass would read as a move of `t`, used again below.
            while (j >= 0 && SemanticTokenizer::token_lt(&t, &data[j])) {
                data[j + 1] = data[j];
                j = j - 1;
            }
            data[j + 1] = t;
        }
    }

    /// Walk the sorted token list and drop:
    ///   - exact duplicates (same line, start_char, length, type, modifiers)
    ///   - later tokens whose range starts inside the previously-kept
    ///     token's range
    ///
    /// In-place: rewrites the array's prefix and truncates.  Preserves sort
    /// order; the array stays valid for the delta-encoder.
    dedup_overlapping(mut &this) -> void {
        const n: i64 = this.tokens.length();
        if (n < 2) { return; }
        const data: SemanticToken* = this.tokens.as_ptr();

        mut write: i64 = 1;
        mut last:  SemanticToken = data[0];
        mut last_end_char: u32 = last.start_char + last.length;

        for (mut read: i64 = 1; read < n; read++) {
            const cur: SemanticToken = data[read];

            // Exact duplicate of the last kept token -> drop.
            if (cur.line == last.line && cur.start_char == last.start_char
                    && cur.length == last.length
                    && cur.token_type == last.token_type
                    && cur.token_modifiers == last.token_modifiers) {
                continue;
            }

            // Overlap on the same line -> drop the later (narrower or
            // duplicate-range) token, keeping the previously-emitted one.
            if (cur.line == last.line && cur.start_char < last_end_char) {
                continue;
            }

            data[write] = cur.clone();
            write = write + 1;
            last = cur;
            last_end_char = last.start_char + last.length;
        }

        // Array has no truncate(); pop the trailing items we've already
        // copied forward.
        mut to_drop: i64 = n - write;
        while (to_drop > 0) {
            this.tokens.pop();
            to_drop = to_drop - 1;
        }
    }


    // Stateless helpers (statics)

    /// Byte-compare two NUL-terminated paths: the same file reaches here
    /// as different copies, so pointer equality does not decide it.
    static file_paths_equal(a: string, b: string) -> boolean {
        if (a == b) { return true; }                      // same pointer
        mut i: i64 = 0;
        loop {
            const ca: u8 = a[i] as u8;
            const cb: u8 = b[i] as u8;
            if (ca != cb) { return false; }
            if (ca == 0 as u8) { return true; }
            i = i + 1;
        }
        return false;
    }

    static token_lt(a: &SemanticToken, b: &SemanticToken) -> boolean {
        if (a.line < b.line) { return true; }
        if (a.line > b.line) { return false; }
        if (a.start_char != b.start_char) { return a.start_char < b.start_char; }
        // Same (line, start_char): wider tokens first, so the dedup pass
        // keeps the one covering more bytes.
        return a.length > b.length;
    }
}

/// SemanticTokenizer owns its `tokens` Array on the heap; the explicit
/// `drop` releases it at end of request (the other fields are non-owning
/// pointers).
implement trait Drop for struct SemanticTokenizer {
    drop(mut &this) -> void { }
}

implement trait Clone for struct SemanticToken {
    clone(&this) -> SemanticToken {
        return SemanticToken::new(this.line, this.start_char, this.length,
                                   this.token_type, this.token_modifiers);
    }
}


// Entry point

public function handle_semantic_tokens(docs: mut &docs::Docs, projects: mut &session::Projects,
                                        params: &value::JsonValue) -> value::JsonValue {
    const td: value::JsonValue* = params.get(str::Str::from("textDocument")).unwrap_or(null);
    if (td == null) { return lsp::protocol::semantic_tokens::SemanticTokensCodec::empty_response(); }
    const uri_val: value::JsonValue* = td.get(str::Str::from("uri")).unwrap_or(null);
    if (uri_val == null) { return lsp::protocol::semantic_tokens::SemanticTokensCodec::empty_response(); }
    const uri_str_opt: Option<str::Str> = uri_val.as::<str::Str>();
    if (!uri_str_opt.is_some()) { return lsp::protocol::semantic_tokens::SemanticTokensCodec::empty_response(); }
    const uri: str::Str = uri_str_opt.unwrap_or(str::Str::from(""));

    const ctx: CompilationContext* = projects.analysis_for(docs, uri);
    if (ctx == null) { return lsp::protocol::semantic_tokens::SemanticTokensCodec::empty_response(); }

    mut fs_path_owned: String = conv::UriPath::uri_to_fs_path(uri);
    mut path_buf: String = String::with_capacity(fs_path_owned.length() + 1);
    path_buf.push(fs_path_owned.as_str());
    path_buf.push_byte(0 as u8);
    mem::drop(fs_path_owned);
    const path_buf_len: i64 = path_buf.length() - 1;
    path_buf.truncate(path_buf_len);
    const path_cstr: string = path_buf.as_ptr() as string;

    const mod_idx: i64 = ctx.module_graph.find_module_by_path(path_cstr);
    if (mod_idx < 0) { mem::drop(path_buf); return lsp::protocol::semantic_tokens::SemanticTokensCodec::empty_response(); }

    // path_cstr backs the tokenizer's doc_file, so path_buf outlives it.
    mut tokenizer: SemanticTokenizer = SemanticTokenizer::new(ctx, docs, uri, path_cstr);
    tokenizer.colour(mod_idx);
    // The delta-line encoding needs tokens in position order, and the spec
    // forbids overlapping ones.
    tokenizer.sort_tokens();
    tokenizer.dedup_overlapping();

    const data: value::JsonValue = lsp::protocol::semantic_tokens::SemanticTokensCodec::encode_tokens(&tokenizer.tokens);
    const resp: value::JsonValue = lsp::protocol::semantic_tokens::SemanticTokensCodec::response_json(data);
    mem::drop(path_buf);
    return resp;
}
