///! Names as the cursor's scope writes them.
///!
///! A path written before the cursor (`A::B::`) is resolved through the
///! doors in the cursor's scope (`place_of_path`).  The other way round, a
///! definition or a type the editor shows is written in the shortest form
///! that names the same identity from the cursor: a definition's own name
///! when the scope binds that name to it, else its owner's shortest form and
///! the name, else its path in full.  Every candidate is resolved through the
///! doors and compared by identity before it is used; nothing is cut from a
///! name's text.  A type argument equal to the default its template declares
///! is left out.  `Names::full` writes every path in full, as declared.
namespace lsp::handlers::names;

import std::collections::str;
import std::collections::string::{ String };
import std::collections::array;

import compiler::compilation_context::{ CompilationContext };
import compiler::module_graph::{ ModulePath, ModuleSpellingMatch };
import compiler::resolver::res::{ DefId, DefKind };
import compiler::resolver::scope::{ ScopeID };
import compiler::resolver::symbol::{ Symbol, SymbolKind };
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::decl_index::{ OverloadId };
import compiler::types::{ TypeKind };
import compiler::types::type_ref::{ TypeRef };
import compiler::types::type_base::{ Type };
import compiler::types::compound::{ ArrayType, FunctionType, OptionalType, PointerType, ReferenceType, TupleType };
import compiler::types::generic_registry::{ TemplateEntry };
import compiler::types::resolver::{ ResolutionContext };
import compiler::ast::{ GenericAnnotation, TypeAnnotation };
import compiler::sema::type_utils::{ TypeUtils };


/// What a path written before the cursor names.
type enum Place {
    Nothing;
    Module(ModulePath);
    Type(DefId);
}


type struct Names {
    ctx:    CompilationContext*;
    /// The module the cursor is in; none for `full`.
    module: ModulePath;
    /// The scope at the cursor; invalid for `full`.
    scope:  ScopeID;
    /// Every path in full, as declared.
    full:   boolean;

    /// Names written in full: the expanded hover's text.
    static full(ctx: CompilationContext*) -> Names {
        return Names { ctx: ctx, module: ModulePath::none(), scope: ScopeID::invalid(), full: true };
    }

    /// Names as module `within` writes them at `line`:`col`, compiler
    /// coordinates.  A position with no scope writes them in full.
    static at(ctx: CompilationContext*, within: ModulePath, line: u32, col: u32) -> Names {
        mut n: Names = Names { ctx: ctx, module: within, scope: ScopeID::invalid(), full: false };
        if (ctx != null && within.is_valid() && line != 0) {
            n.scope = ctx.resolver.scope_at(within, line, col);
        }
        return n;
    }

    /// Names as the module at index `module_idx` writes them at `line`:`col`.
    static in_module(ctx: CompilationContext*, module_idx: i64, line: u32, col: u32) -> Names {
        if (ctx == null || module_idx < 0) { return Names::full(ctx); }
        return Names::at(ctx, ctx.module_graph.get_module(module_idx).path(), line, col);
    }

    relative(&this) -> boolean {
        return !this.full && this.ctx != null && this.scope.is_valid();
    }

    // -- A path written before the cursor --

    /// What the path `written` (`A::B`) names in the cursor's scope.
    place_of_path(&this, written: str::Str) -> Place {
        if (this.ctx == null || !this.scope.is_valid()) { return Place::Nothing; }
        const separator: str::Str = str::Str::from("::");
        const segs: [str::Str] = array::from_iter(written.split(&separator));
        mut place: Place = this.head_place(segs[0]);
        for (mut i: i64 = 1; i < segs.length(); i++) {
            place = this.next_place(&place, segs[i]);
        }
        return place;
    }

    /// What a path's first segment names in the cursor's scope: the type
    /// the scope binds it to, or the module it spells there.
    head_place(&this, seg: str::Str) -> Place {
        const name: SymbolStr = this.intern(seg);
        const bound: SymbolID = this.ctx.resolver.type_binding(name, this.scope);
        if (bound.is_valid()) {
            mut s: Symbol = this.ctx.resolver.get_symbol(bound);
            if (s.kind == SymbolKind::Import) {
                if (s.def.is_valid() && this.ctx.defs.kind_of(s.def) == DefKind::Module) {
                    return Place::Module(this.ctx.module_graph.module_of_def(s.def));
                }
                s = this.ctx.resolver.get_symbol(this.ctx.resolver.declaration_of(bound));
            }
            return this.place_of(&s);
        }
        const m: ModuleSpellingMatch = this.ctx.modules_written_as(
            this.cstr(seg), this.module, ModulePath::none());
        if (m.visible == 1) { return Place::Module(m.found); }
        return Place::Nothing;
    }

    /// What segment `seg` names after `place`: a type the module exports,
    /// or a module under it.
    next_place(&this, place: &Place, seg: str::Str) -> Place {
        match (place) {
            Place::Module(m) => {
                const found: [SymbolID] = this.ctx.resolver.exports_named(m, this.intern(seg));
                for (mut i: i64 = 0; i < found.length(); i++) {
                    const s: Symbol = this.ctx.resolver.get_symbol(found[i]);
                    const p: Place = this.place_of(&s);
                    match (p) {
                        Place::Nothing => { }
                        _              => { return p; }
                    }
                }
                const sub: ModuleSpellingMatch = this.ctx.modules_written_as(this.cstr(seg), this.module, m);
                if (sub.visible == 1) { return Place::Module(sub.found); }
                return Place::Nothing;
            }
            _ => { return Place::Nothing; }
        }
    }

    place_of(&this, s: &Symbol) -> Place {
        if (s.kind == SymbolKind::Type || s.kind == SymbolKind::TypeAlias) {
            if (s.def.is_valid()) { return Place::Type(s.def); }
        }
        if (s.kind == SymbolKind::Namespace && s.def.is_valid()) {
            return Place::Module(this.ctx.module_graph.module_of_def(s.def));
        }
        return Place::Nothing;
    }

    // -- A definition as the cursor's scope writes it --

    /// Definition `d`'s path as the cursor's scope writes it.
    def_path(&this, d: DefId) -> string {
        const whole: string = this.ctx.intern_table.shown(this.ctx.defs.path_of(d));
        if (!this.relative() || !d.is_valid()) { return whole; }
        if (this.ctx.defs.kind_of(d) == DefKind::Module) {
            const m: string = this.module_text(this.ctx.module_graph.module_of_def(d));
            return if (m.length() > 0) { m } else { whole };
        }
        const leaf: string = this.ctx.intern_table.shown(this.ctx.defs.leaf_of(d));
        if (this.binds(leaf, d)) { return leaf; }
        const owner: DefId = this.ctx.defs.parent_of(d);
        if (!owner.is_valid()) { return whole; }
        const prefix: string = if (this.ctx.defs.kind_of(owner) == DefKind::Module) {
            this.module_text(this.ctx.module_graph.module_of_def(owner))
        } else {
            this.def_path(owner)
        };
        if (prefix.length() == 0) { return whole; }
        return prefix + "::" + leaf;
    }

    /// Whether the scope binds the bare name `leaf` to `d`: in the type
    /// namespace, or in the value namespace to `d` or an overload of its
    /// family.
    binds(&this, leaf: string, d: DefId) -> boolean {
        const name: SymbolStr = this.intern(str::Str::from(leaf));
        const t: SymbolID = this.ctx.resolver.type_binding(name, this.scope);
        if (t.is_valid()) {
            mut s: Symbol = this.ctx.resolver.get_symbol(t);
            if (s.kind == SymbolKind::Import) {
                s = this.ctx.resolver.get_symbol(this.ctx.resolver.declaration_of(t));
            }
            if (s.def.equals(d)) { return true; }
        }
        const v: SymbolID = this.ctx.resolver.value_target(this.ctx.resolver.lookup_value(name, this.scope));
        if (!v.is_valid()) { return false; }
        const vd: DefId = this.ctx.resolver.get_symbol(v).def;
        if (!vd.is_valid()) { return false; }
        if (vd.equals(d)) { return true; }
        const mine: OverloadId = this.ctx.decl_index.entry_of_def(d);
        if (!mine.is_valid()) { return false; }
        const family: [OverloadId] = this.ctx.decl_index.family_entries_of_def(vd);
        for (mut k: i64 = 0; k < family.length(); k++) {
            if (family[k].equals(mine)) { return true; }
        }
        return false;
    }

    /// The shortest spelling of module `m`'s path, its last segments, that
    /// the cursor's scope resolves to `m`; "" when none does.
    module_text(&this, m: ModulePath) -> string {
        if (!m.is_valid()) { return ""; }
        const whole: string = this.ctx.intern_table.shown(m.decl_name());
        const separator: str::Str = str::Str::from("::");
        const segs: [str::Str] = array::from_iter(str::Str::from(whole).split(&separator));
        for (mut j: i64 = segs.length() - 1; j >= 0; j--) {
            mut spelled: String = String::new();
            for (mut k: i64 = j; k < segs.length(); k++) {
                if (k > j) { spelled.push(str::Str::from("::")); }
                spelled.push(segs[k]);
            }
            const p: Place = this.place_of_path(spelled.as_str());
            match (p) {
                Place::Module(found) => {
                    if (found.equals(m)) { return spelled.into_raw(); }
                }
                _ => { }
            }
        }
        return "";
    }

    // -- A type as the cursor's scope writes it --

    /// `type_text` of a type an annotation `ann` declared, with an array
    /// spelled as the annotation spells it: `Array<T>` written so, `[T]`
    /// written so.  Without an annotation, `type_text`.
    type_text_written(&this, ty: TypeRef, ann: TypeAnnotation*) -> string {
        if (ann == null || !ty.is_valid()) { return this.type_text(ty); }
        if (!this.relative()) {
            mut types_: TypeUtils = TypeUtils { arena: this.ctx.type_arena, intern: this.ctx.intern_table,
                                                ctx: this.ctx, checker: null };
            return types_.written_display_name(ty, ann);
        }
        const t: Type* = this.ctx.type_arena.lookup(ty);
        if (t == null) { return "?"; }
        match (*ann) {
            TypeAnnotation::Pointer(p) => {
                if (t.kind == TypeKind::Pointer) {
                    return this.type_text_written(t.as_pointer().pointee, p.inner) + "*";
                }
            }
            TypeAnnotation::Reference(r) => {
                if (t.kind == TypeKind::Reference) {
                    const rt: ReferenceType* = t.as_reference();
                    const inner: string = this.type_text_written(rt.referent, r.inner);
                    if (rt.is_mutable()) { return "mut &" + inner; }
                    return "&" + inner;
                }
            }
            TypeAnnotation::Array(a) => {
                const elem: TypeRef = this.ctx.type_arena.default_array_element(ty);
                if (elem.is_valid()) { return "[" + this.type_text_written(elem, a.element) + "]"; }
                if (t.kind == TypeKind::Array) {
                    const at: ArrayType* = t.as_array();
                    return at.spelled(this.type_text_written(at.element, a.element));
                }
            }
            TypeAnnotation::Generic(g) => {
                const d: DefId = this.ctx.decl_index.def_of(ty, this.ctx.type_arena);
                const base: TypeRef = this.ctx.type_arena.inst_generic_base(ty);
                if (d.is_valid() && base.is_valid()) { return this.instance_text(ty, base, d, g); }
            }
            _ => { }
        }
        return this.type_text(ty);
    }

    type_text(&this, ty: TypeRef) -> string {
        if (!ty.is_valid()) { return "?"; }
        if (!this.relative()) { return this.ctx.type_arena.resolve_display_name(ty); }
        const t: Type* = this.ctx.type_arena.lookup(ty);
        if (t == null) { return "?"; }
        match (t.kind) {
            TypeKind::Pointer => { return this.type_text(t.as_pointer().pointee) + "*"; }
            TypeKind::Reference => {
                const r: ReferenceType* = t.as_reference();
                const inner: string = this.type_text(r.referent);
                if (r.is_mutable()) { return "mut &" + inner; }
                return "&" + inner;
            }
            TypeKind::Array => {
                const a: ArrayType* = t.as_array();
                return a.spelled(this.type_text(a.element));
            }
            TypeKind::Optional => { return this.type_text(t.as_optional().wrapped) + "?"; }
            TypeKind::Function => {
                const f: FunctionType* = t.as_function();
                mut out: string = "(";
                for (mut i: i64 = 0; i < f.param_types.length(); i++) {
                    if (i > 0) { out = out + ", "; }
                    out = out + this.type_text(f.param_types[i]);
                }
                if (f.is_variadic) {
                    if (f.param_types.length() > 0) { out = out + ", "; }
                    out = out + "...";
                }
                return out + ") -> " + this.type_text(f.return_type);
            }
            TypeKind::Tuple => {
                const tu: TupleType* = t.as_tuple();
                mut out: string = "(";
                for (mut i: i64 = 0; i < tu.elements.length(); i++) {
                    if (i > 0) { out = out + ", "; }
                    out = out + this.type_text(tu.elements[i]);
                }
                return out + ")";
            }
            _ => { }
        }
        const array_elem: TypeRef = this.ctx.type_arena.default_array_element(ty);
        if (array_elem.is_valid()) { return "[" + this.type_text(array_elem) + "]"; }
        const d: DefId = this.ctx.decl_index.def_of(ty, this.ctx.type_arena);
        const base: TypeRef = this.ctx.type_arena.inst_generic_base(ty);
        if (base.is_valid()) {
            if (!d.is_valid()) { return this.ctx.type_arena.resolve_display_name(ty); }
            return this.instance_text(ty, base, d, null);
        }
        if (d.is_valid() && (t.kind == TypeKind::Struct
                || t.kind == TypeKind::Enum || t.kind == TypeKind::Trait
                || t.kind == TypeKind::TypeAlias)) {
            return this.def_path(d);
        }
        return this.ctx.type_arena.resolve_display_name(ty);
    }

    /// Instantiation `ty` of the template `d` (whose type is `base`), its
    /// arguments as `written`, a generic annotation, spells them when it is
    /// given.
    instance_text(&this, ty: TypeRef, base: TypeRef, d: DefId, written: GenericAnnotation*) -> string {
        const keep: i64 = this.args_shown(ty, base);
        mut out: string = this.def_path(d);
        if (keep == 0) { return out; }
        out = out + "<";
        for (mut i: i64 = 0; i < keep; i++) {
            if (i > 0) { out = out + ", "; }
            const arg: TypeRef = this.ctx.type_arena.inst_type_arg_at(ty, i);
            if (written != null && i < written.args.length()) {
                out = out + this.type_text_written(arg, written.args[i]);
            } else {
                out = out + this.type_text(arg);
            }
        }
        return out + ">";
    }

    /// How many of instantiation `ty`'s arguments to show: all of them, less
    /// the trailing ones equal to the default their template declares given
    /// the arguments before them.
    args_shown(&this, ty: TypeRef, base: TypeRef) -> i64 {
        const n: i64 = this.ctx.type_arena.inst_type_arg_count(ty);
        const entry: TemplateEntry* = this.ctx.generic_registry.template_of_type(base);
        if (entry == null) { return n; }
        mut keep: i64 = n;
        while (keep > 0) {
            mut prefix: [TypeRef] = [];
            for (mut i: i64 = 0; i < keep - 1; i++) { prefix.push(this.ctx.type_arena.inst_type_arg_at(ty, i)); }
            mut rc: ResolutionContext = ResolutionContext::new("");
            rc.symbolic_no_demand = true;
            const filled: [TypeRef] = this.ctx.type_resolver.expand_default_type_args(entry, prefix, &rc);
            if (filled.length() < keep) { break; }
            if (!filled[keep - 1].equals(this.ctx.type_arena.inst_type_arg_at(ty, keep - 1))) { break; }
            keep = keep - 1;
        }
        return keep;
    }

    // -- Text --


    /// A written name as the interner holds it.  Interning is the door text
    /// becomes a `SymbolStr` through; a name the analysis never saw is added
    /// to its table and binds nothing.
    intern(&this, s: str::Str) -> SymbolStr {
        return this.ctx.intern_table.intern(this.cstr(s));
    }

    /// `s` as a NUL-terminated copy.
    cstr(&this, s: str::Str) -> string {
        mut buf: String = String::with_capacity(s.length() + 1);
        buf.push(s);
        buf.push_byte(0 as u8);
        return buf.into_raw();
    }
}
