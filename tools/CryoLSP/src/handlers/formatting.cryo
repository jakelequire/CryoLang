///! `textDocument/formatting`: the layout `cryo fmt` gives a file, as one
///! edit replacing the open document's whole text.  A document already laid
///! out gets no edit, and so does one the formatter leaves as it is (it does
///! not lex, or its brackets do not balance) - an edit in progress is
///! usually both, and formatting it on save must not fail the save.

namespace lsp::handlers::formatting;

import std::core::option;
import std::core::result::{ Result };
import std::collections::str;
import std::collections::string::{ String };
import std::collections::array::{ Array };
import std::json::value;
import compiler::format::{ SourceFormatter };
import lsp::server::docs;
import lsp::protocol::lsp;


/// Handle a `textDocument/formatting` request: an array of text edits.
public function handle_formatting(docs: &docs::Docs, params: &value::JsonValue) -> value::JsonValue {
    mut edits: Array<value::JsonValue> = Array::<value::JsonValue>::new();
    const td: value::JsonValue* = params.get(str::Str::from("textDocument")).unwrap_or(null);
    if (td == null) { return value::JsonValue::Array(edits); }
    const uri_val: value::JsonValue* = td.get(str::Str::from("uri")).unwrap_or(null);
    if (uri_val == null) { return value::JsonValue::Array(edits); }
    const uri: str::Str = uri_val.as::<str::Str>().unwrap_or(str::Str::from(""));
    const doc: docs::Document* = docs.get(uri).unwrap_or(null);
    if (doc == null) { return value::JsonValue::Array(edits); }

    match (SourceFormatter::format(doc.text.as_str())) {
        Result::Err(_) => {}
        Result::Ok(laid_out) => {
            if (laid_out.as_str() != doc.text.as_str()) {
                const whole: lsp::Range = lsp::Range::new(lsp::Position::new(0 as u32, 0 as u32),
                                                          docs.position_of_byte(doc, doc.text.length()));
                mut edit: value::JsonObject = value::JsonObject::new();
                edit.put("range", whole.to_json());
                edit.put("newText", value::JsonValue::from(laid_out.as_str()));
                edits.push(value::JsonValue::Object(edit));
            }
        }
    }
    return value::JsonValue::Array(edits);
}
