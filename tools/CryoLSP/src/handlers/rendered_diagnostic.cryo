///! `cryo/renderedDiagnostic`: custom request - returns the full
///! rendered text of a previously-published diagnostic.
///!
///! Params:  `{ "id": "<diagId>" }`     - the id stamped onto the
///!                                       diagnostic's `data` field
///!                                       at publish time.
///! Result:  `{ "content": "<text>" }`  - the multi-line rendered
///!                                       report; empty when the id
///!                                       is unknown (the editor
///!                                       then shows a "not cached"
///!                                       placeholder in the tab).
///!
///! Backs the editor extension's virtual-document content provider for
///! the `cryo-diagnostic:` URI scheme - opening such a URI in VS Code
///! triggers a `cryo/renderedDiagnostic` round-trip and renders the
///! result as a read-only text document, the same UX as
///! rust-analyzer's diagnostics view.

namespace lsp::handlers::rendered_diagnostic;

import std::core::option;
import std::collections::str;
import std::collections::string;
import std::collections::string::{ String };
import std::json::value;

import lsp::server::diag_render_cache;


/// Handle a `cryo/renderedDiagnostic` request and return the JSON
/// payload to put into the response's `result` field.
public function handle(cache: &diag_render_cache::DiagRenderCache, params: &value::JsonValue) -> value::JsonValue {
    mut content: String = String::new();

    match (params.get(str::Str::from("id"))) {
        Option::Some(id_v) => {
            match (id_v.as::<str::Str>()) {
                Option::Some(id) => {
                    match (cache.get(id)) {
                        Option::Some(text) => { content.push(text); }
                        Option::None       => { }
                    }
                }
                Option::None => { }
            }
        }
        Option::None => { }
    }

    mut o: value::JsonObject = value::JsonObject::new();
    o.insert(String::from_str(str::Str::from("content")),
             value::JsonValue::String(content));
    return value::JsonValue::Object(o);
}
