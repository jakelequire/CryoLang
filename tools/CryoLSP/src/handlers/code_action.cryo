///! `textDocument/codeAction`: emit the lightbulb-menu entries the
///! editor offers next to a diagnostic.  We contribute two kinds:
///!
///!   1. One `quickfix` per Suggestion stamped on the diagnostic's
///!      `data.suggestions` array, each carrying a `WorkspaceEdit`
///!      that the editor applies on click.  Machine-applicable
///!      suggestions are flagged `isPreferred` so VS Code's
///!      "Auto Fix" command runs them without a prompt.
///!   2. A "Show full Cryo diagnostic" command action keyed off
///!      `data.diagId` - opens the virtual `cryo-diagnostic:` URI in
///!      a side tab, the rust-analyzer rendered-diagnostic UX.
///!
///! Diagnostics without `data` are ignored: we only contribute actions
///! to diagnostics we published ourselves.

namespace Lsp::Handlers::CodeAction;

import std::core::option;
import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::json::value;


/// Handle a `textDocument/codeAction` request.  Walks the
/// `context.diagnostics` array and emits one action per diagnostic
/// that carries a `data.diagId` field.
public function handle(params: &JsonValue) -> JsonValue {
    mut actions: Array<JsonValue> = Array<JsonValue>::new();

    match (params.get(Str::from("context"))) {
        Option::Some(ctx) => {
            match (ctx.get(Str::from("diagnostics"))) {
                Option::Some(diags_ptr) => {
                    const total: u64 = diags_ptr.length();
                    for (mut i: u64 = 0; i < total; i++) {
                        match (diags_ptr.at(i)) {
                            Option::Some(d) => {
                                CodeActionBuilder::contribute_actions_for(d, actions);
                            }
                            Option::None => { }
                        }
                    }
                }
                Option::None => { }
            }
        }
        Option::None => { }
    }

    return JsonValue::Array(actions);
}


// CodeActionBuilder - assemble CodeAction JSON from wire diagnostics.
// All statics: pure JSON transforms over the request's diagnostic data.

type struct CodeActionBuilder {

    /// For one wire diagnostic, push every applicable CodeAction into
    /// `actions`.  Order matches user expectations: quickfixes (the
    /// actionable items) come first, then the show-rendered convenience
    /// action.
    static contribute_actions_for(diag: &JsonValue,
                                  actions: mut &Array<JsonValue>) -> void {
        match (diag.get(Str::from("data"))) {
            Option::Some(data) => {
                CodeActionBuilder::push_quickfix_actions(diag, data, actions);
                CodeActionBuilder::push_show_rendered_action(data, actions);
            }
            Option::None => { }
        }
    }

    /// Build one `CodeAction` per Suggestion in `data.suggestions` and
    /// append it to `actions`.  Each action carries a `WorkspaceEdit`
    /// describing the multipart edit the IDE should apply on click; no
    /// client-side command is needed.
    static push_quickfix_actions(diag: &JsonValue, data: &JsonValue,
                                 actions: mut &Array<JsonValue>) -> void {
        match (data.get(Str::from("suggestions"))) {
            Option::Some(suggestions) => {
                const n: u64 = suggestions.length();
                for (mut i: u64 = 0; i < n; i++) {
                    match (suggestions.at(i)) {
                        Option::Some(sug) => {
                            match (CodeActionBuilder::build_quickfix(diag, sug)) {
                                Option::Some(act) => { actions.push(act); }
                                Option::None      => { }
                            }
                        }
                        Option::None => { }
                    }
                }
            }
            Option::None => { }
        }
    }

    /// Build one quickfix CodeAction from a serialized suggestion.
    /// Returns `None` when the suggestion has no parts (already filtered
    /// server-side, defensive guard).
    static build_quickfix(diag: &JsonValue, sug: &JsonValue) -> Option<JsonValue> {
        const parts_v: Option<JsonValue*> = sug.get(Str::from("parts"));
        match (parts_v) {
            Option::None => { return Option::None; }
            Option::Some(parts) => {
                if (parts.length() == 0) { return Option::None; }

                // Title: the suggestion message.
                mut title: String = String::new();
                match (sug.get(Str::from("message"))) {
                    Option::Some(msg_v) => {
                        match (msg_v.as<Str>()) {
                            Option::Some(s) => { title.push(s); }
                            Option::None    => { title.push("Apply suggestion"); }
                        }
                    }
                    Option::None => { title.push("Apply suggestion"); }
                }

                // Applicability: drives `isPreferred`.  Only machine-applicable
                // fixes are marked preferred so VS Code's auto-fix won't run a
                // guess.
                mut is_preferred: boolean = false;
                match (sug.get(Str::from("applicability"))) {
                    Option::Some(app_v) => {
                        match (app_v.as<Str>()) {
                            Option::Some(s) => {
                                if (s.equals(&Str::from("machine-applicable"))) {
                                    is_preferred = true;
                                }
                            }
                            Option::None => { }
                        }
                    }
                    Option::None => { }
                }

                // Build the WorkspaceEdit.  Group parts by uri because LSP
                // `changes` is `{ uri -> TextEdit[] }`.
                mut edit: JsonObject = JsonObject::new();
                mut changes: JsonObject = JsonObject::new();
                const total: u64 = parts.length();
                for (mut i: u64 = 0; i < total; i++) {
                    match (parts.at(i)) {
                        Option::Some(p) => { CodeActionBuilder::add_part_edit(changes, p); }
                        Option::None    => { }
                    }
                }
                edit.put("changes", JsonValue::Object(changes));

                // (We deliberately omit `diagnostics: [diag]` - JsonValue
                // has no clone method, and editors render the quickfix
                // lightbulb on the diagnostic's gutter regardless.  The
                // correlation field is only useful for advanced grouping
                // UIs that don't yet exist on the Cryo side.)
                mut action: JsonObject = JsonObject::new();
                action.put("title", JsonValue::String(title));
                action.put("kind", JsonValue::from("quickfix"));
                action.put("edit", JsonValue::Object(edit));
                if (is_preferred) {
                    action.put("isPreferred", JsonValue::Bool(true));
                }
                return Option::Some(JsonValue::Object(action));
            }
        }
    }

    /// Read `(uri, range, newText)` from one serialized suggestion part,
    /// build its LSP `TextEdit` (`{ range, newText }`, range rebuilt from
    /// scratch so it owns its JSON - JsonValue has no clone), and append it
    /// to the TextEdit array under `uri` in `changes`.  No-op when any
    /// field is missing.
    ///
    /// Deliberately one method that owns the whole part -> changes
    /// insertion, rather than splitting it into a helper that returns a
    /// `Pair<String, JsonValue>`.  Partially moving one field of such a
    /// pair into a call argument while borrowing another field in the same
    /// call hits a pinned-compiler bug: it accepts the moved-out field as
    /// the call argument but still drops it when the pair leaves scope,
    /// double-freeing the moved object.  For a TextEdit here, the
    /// freed-then-reused node would alias the `changes` object, producing a
    /// CYCLIC WorkspaceEdit that stack-overflows the JSON-RPC encoder
    /// (`clone_value`) and crashes the server on any real quickfix.
    /// Keeping the edit in a single owned local (no struct field to
    /// partially move) sidesteps the compiler bug.  Minimal repro of the
    /// partial-move double-free is filed for a compiler-side fix.
    static add_part_edit(changes: mut &JsonObject, part: &JsonValue) -> void {
        const uri_v: Option<JsonValue*> = part.get(Str::from("uri"));
        const range_v: Option<JsonValue*> = part.get(Str::from("range"));
        const new_text_v: Option<JsonValue*> = part.get(Str::from("newText"));
        if (uri_v.is_none() || range_v.is_none() || new_text_v.is_none()) {
            return;
        }

        mut uri_str: String = String::new();
        match (uri_v.unwrap().as<Str>()) {
            Option::Some(s) => { uri_str.push(s); }
            Option::None    => { uri_str.drop(); return; }
        }

        mut new_text: String = String::new();
        match (new_text_v.unwrap().as<Str>()) {
            Option::Some(s) => { new_text.push(s); }
            Option::None    => { uri_str.drop(); new_text.drop(); return; }
        }

        const range_copy: JsonValue = CodeActionBuilder::rebuild_range(range_v.unwrap());
        mut edit_obj: JsonObject = JsonObject::new();
        edit_obj.put("range", range_copy);
        edit_obj.put("newText", JsonValue::String(new_text));
        mut edit: JsonValue = JsonValue::Object(edit_obj);

        // Append this TextEdit to the array under `uri` in `changes`,
        // creating the array if absent.
        match (changes.get(uri_str.as_str())) {
            Option::Some(existing) => {
                match (existing) {
                    JsonValue::Array(arr) => {
                        arr.push(edit);
                        uri_str.drop();
                        return;
                    }
                    _ => { }
                }
            }
            Option::None => { }
        }
        mut fresh: Array<JsonValue> = Array<JsonValue>::with_capacity(1);
        fresh.push(edit);
        changes.insert(uri_str, JsonValue::Array(fresh));
    }

    /// Rebuild an LSP `Range` JSON object by reading its scalar fields
    /// out of `src`.  Missing or malformed fields collapse to 0, matching
    /// what `range_json_from_span` produces for a spanless diagnostic.
    static rebuild_range(src: JsonValue*) -> JsonValue {
        const sl: i64 = CodeActionBuilder::read_range_pos(src, "start", "line");
        const sc: i64 = CodeActionBuilder::read_range_pos(src, "start", "character");
        const el: i64 = CodeActionBuilder::read_range_pos(src, "end",   "line");
        const ec: i64 = CodeActionBuilder::read_range_pos(src, "end",   "character");
        return CodeActionBuilder::build_range(sl, sc, el, ec);
    }

    static read_range_pos(src: JsonValue*, anchor: string, field: string) -> i64 {
        match (src.get(Str::from(anchor))) {
            Option::Some(pos) => {
                match (pos.get(Str::from(field))) {
                    Option::Some(v) => {
                        match (v.as<i64>()) {
                            Option::Some(n) => { return n; }
                            Option::None    => { return 0; }
                        }
                    }
                    Option::None => { return 0; }
                }
            }
            Option::None => { return 0; }
        }
    }

    static build_range(sl: i64, sc: i64, el: i64, ec: i64) -> JsonValue {
        mut o: JsonObject = JsonObject::new();
        o.put("start", CodeActionBuilder::build_pos(sl, sc));
        o.put("end",   CodeActionBuilder::build_pos(el, ec));
        return JsonValue::Object(o);
    }

    static build_pos(line: i64, ch: i64) -> JsonValue {
        mut o: JsonObject = JsonObject::new();
        o.put("line",      JsonValue::int_value(line));
        o.put("character", JsonValue::int_value(ch));
        return JsonValue::Object(o);
    }

    /// Append the "Show full Cryo diagnostic" action backed by the
    /// diagnostic's `diagId`.  Skipped when the wire diagnostic carries
    /// no id.
    static push_show_rendered_action(data: &JsonValue,
                                     actions: mut &Array<JsonValue>) -> void {
        match (data.get(Str::from("diagId"))) {
            Option::Some(id_v) => {
                match (id_v.as<Str>()) {
                    Option::Some(id) => { actions.push(CodeActionBuilder::build_show_rendered_action(id)); }
                    Option::None     => { }
                }
            }
            Option::None => { }
        }
    }

    /// Build the show-rendered CodeAction object.  Runs the client-side
    /// `cryo.openRenderedDiagnostic` command (registered by the
    /// CryoAnalyzer VS Code extension) which opens the virtual
    /// `cryo-diagnostic:` URI for `id`.
    static build_show_rendered_action(id: Str) -> JsonValue {
        const title:   string = "Show full Cryo diagnostic";
        const cmd_id:  string = "cryo.openRenderedDiagnostic";

        mut args: Array<JsonValue> = Array<JsonValue>::with_capacity(1);
        args.push(JsonValue::from(id));

        mut cmd: JsonObject = JsonObject::new();
        cmd.put("title", JsonValue::from(title));
        cmd.put("command", JsonValue::from(cmd_id));
        cmd.put("arguments", JsonValue::Array(args));

        mut action: JsonObject = JsonObject::new();
        action.put("title", JsonValue::from(title));
        action.put("kind", JsonValue::from("quickfix"));
        action.put("command", JsonValue::Object(cmd));
        return JsonValue::Object(action);
    }
}
