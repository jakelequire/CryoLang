///! Text-document synchronization.
///!
///! Three notifications, all carrying a `textDocument` and (for
///! didOpen / didChange) some text:
///!
///!   - didOpen   -> store doc, create session, recompile, publish
///!   - didChange -> replace doc text, recompile, publish
///!   - didClose  -> drop doc, drop session, publish empty diagnostics
///!
///! The advertised `textDocumentSync` is `1 = Full`, so editors
///! send the whole document text on every didChange.  `did_change`
///! pulls the LAST entry of `contentChanges` and treats its `text`
///! field as the new document - for Full sync there's exactly one
///! entry with no `range`, so this is correct.

namespace Lsp::Handlers::TextSync;

import std::core::option;
import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::io::stdio;
import std::json::value;

import Lsp::Server::Docs;
import Lsp::Server::Session;
import Lsp::Server::DiagRenderCache;
import Lsp::Handlers::Diagnostics;
import Lsp::Protocol::JsonRpc;
import Lsp::Protocol::Framing;


public function did_open(docs: mut &Docs, sessions: mut &SessionMap,
                          params: &JsonValue) -> void {
    match (params.get(Str::from_cstr("textDocument"))) {
        Option::Some(td) => {
            const uri:     String = clone_string_field_or_empty(td, "uri");
            const version: i32    = i32_field_or(td, "version", 1 as i32);
            const text:    String = clone_string_field_or_empty(td, "text");

            mut doc: Document = Document::new(
                String::from_str(uri.as_str()),
                String::from_str(text.as_str()),
                version);
            docs.insert(doc);

            // Defer the compile+publish: mark the session dirty and queue
            // the URI.  The flush (idle window in the server loop, or the
            // next request via ensure_fresh) turns the whole burst into a
            // single compile.
            sessions.mark_dirty(uri.as_str());

            mut u: String = uri;     u.drop();
            mut t: String = text;    t.drop();
        }
        Option::None => { }
    }
}


public function did_change(docs: mut &Docs, sessions: mut &SessionMap,
                            params: &JsonValue) -> void {
    match (params.get(Str::from_cstr("textDocument"))) {
        Option::Some(td) => {
            const uri:     String = clone_string_field_or_empty(td, "uri");
            const version: i32    = i32_field_or(td, "version", 1 as i32);

            // Pull the LAST entry of `contentChanges` - for full-sync
            // clients there's exactly one; for incremental clients
            // taking this approach loses partial edits (TODO when v2).
            const new_text: String = match (params.get(Str::from_cstr("contentChanges"))) {
                Option::Some(changes) => { last_change_text(changes) }
                Option::None          => { String::new() }
            };

            // Update the stored document - `replace_text` rebuilds the
            // line index, which is needed even for full sync.
            match (docs.get(uri.as_str())) {
                Option::Some(doc_ptr) => {
                    doc_ptr.replace_text(String::from_str(new_text.as_str()), version);
                }
                Option::None => {
                    // didChange before didOpen - accept it anyway by
                    // creating the doc.
                    mut fresh: Document = Document::new(
                        String::from_str(uri.as_str()),
                        String::from_str(new_text.as_str()),
                        version);
                    docs.insert(fresh);
                }
            }

            // Coalesce: flag the edit and enqueue; the compile is owed
            // but not run here (see did_open).  This is what turns a
            // per-keystroke whole-project recompile into one compile per
            // editing pause.
            sessions.mark_dirty(uri.as_str());

            mut u: String = uri;       u.drop();
            mut t: String = new_text;  t.drop();
        }
        Option::None => { }
    }
}


/// Compile + publish every document queued by `mark_dirty` since the
/// last flush, then clear the queue.  Called by the server loop when the
/// input stream goes idle (the edit burst has subsided).  Each URI is
/// routed through `ensure_fresh`, so a document already recompiled by an
/// interleaved request (hover/completion) isn't compiled twice - it just
/// gets its diagnostics published.
public function flush_pending(docs: &Docs, sessions: mut &SessionMap,
                               writer: mut &Stdout, cache: DiagRenderCache*) -> void {
    mut uris: Array<String> = sessions.take_pending();
    const n: u64 = uris.length();
    for (mut i: u64 = 0; i < n; i++) {
        match (uris.get_ref(i)) {
            Option::Some(uri_ptr) => {
                const uri: Str = uri_ptr.as_str();
                const session: CompilerSession* = sessions.ensure_fresh(docs, uri);
                if (session != null && session.context() != null) {
                    Diagnostics::publish_for(writer, uri,
                                              session.context(), cache);
                    send_semantic_tokens_refresh(writer);
                }
            }
            Option::None => { }
        }
    }
    uris.drop();
}


public function did_close(docs: mut &Docs, sessions: mut &SessionMap,
                           writer: mut &Stdout, params: &JsonValue) -> void {
    match (params.get(Str::from_cstr("textDocument"))) {
        Option::Some(td) => {
            const uri: String = clone_string_field_or_empty(td, "uri");
            docs.remove(uri.as_str());
            sessions.remove(uri.as_str());
            // Drop any queued-but-unflushed edit for this URI so a later
            // flush doesn't resurrect a session for a closed document.
            sessions.clear_pending_for(uri.as_str());
            // Clear stale squiggles in the editor.
            Diagnostics::publish_empty(writer, uri.as_str());
            mut u: String = uri;  u.drop();
        }
        Option::None => { }
    }
}


// JSON field helpers

function clone_string_field_or_empty(obj: &JsonValue, key: string) -> String {
    match (obj.get(Str::from_cstr(key))) {
        Option::Some(v) => {
            match (v.as_str()) {
                Option::Some(s) => { return String::from_str(s); }
                Option::None    => { return String::new(); }
            }
        }
        Option::None => { return String::new(); }
    }
}

function i32_field_or(obj: &JsonValue, key: string, fallback: i32) -> i32 {
    match (obj.get(Str::from_cstr(key))) {
        Option::Some(v) => {
            match (v) {
                JsonValue::Number(n) => {
                    match (n) {
                        JsonNumber::Int(i)   => { return i as i32; }
                        JsonNumber::UInt(u)  => { return u as i32; }
                        JsonNumber::Float(f) => { return f as i32; }
                    }
                }
                _ => { return fallback; }
            }
        }
        Option::None => { return fallback; }
    }
    return fallback;
}

/// Pull the `text` field out of the LAST change entry.  Treats every
/// change as a whole-document replacement; `range`-bearing entries are
/// silently overridden by whichever entry sits last in the array.
function last_change_text(changes: &JsonValue) -> String {
    match (changes) {
        JsonValue::Array(arr) => {
            if (arr.length() == 0) { return String::new(); }
            // JsonValue owns resources (not Copy): borrow the last element in
            // place with get_ref rather than copying it out with get.
            match (arr.get_ref(arr.length() - 1)) {
                Option::Some(last) => {
                    return clone_string_field_or_empty(last, "text");
                }
                Option::None => { return String::new(); }
            }
        }
        _ => { return String::new(); }
    }
}


// Server->client: nudge the editor to re-fetch semantic tokens

/// Monotonically-increasing id for outbound `workspace/semanticTokens/refresh`
/// requests.  Per JSON-RPC each request needs a unique id so the client's
/// (ignored) response can be routed; we never read it but the spec
/// requires the field.
mut g_refresh_request_id: i64 = 1 as i64;

/// Send `workspace/semanticTokens/refresh` to invalidate the editor's
/// cached semantic tokens.  Called after every recompile so the client
/// re-requests tokens against the freshly-built AST.  Without this, the
/// editor keeps painting STALE tokens from a previous parse onto the
/// current text: as the user types, the cached spans drift away from
/// the identifiers they were meant to colour, and VS Code renders the
/// stale span colours on top of TextMate, producing the "broken-up,
/// overlapping" highlighting the user reports.
function send_semantic_tokens_refresh(writer: mut &Stdout) -> void {
    const id: i64 = g_refresh_request_id;
    g_refresh_request_id = id + 1 as i64;
    mut body: String = JsonRpc::encode_request(
        id,
        Str::from_cstr("workspace/semanticTokens/refresh"),
        JsonValue::Null);
    match (Framing::write_message(writer, body.as_str())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { }
    }
    body.drop();
}
