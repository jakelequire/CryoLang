///! Text-document synchronization.
///!
///!   - didOpen   -> store the buffer; analyse its project if it never was
///!   - didChange -> replace the buffer; nothing is analysed
///!   - didSave   -> analyse the file's project again
///!   - didChangeWatchedFiles -> the same, for a `.cryo` file changed on disk
///!   - didClose  -> drop the buffer, clear its squiggles and dimming
///!
///! Analyses run in `flush`, when the server's input goes quiet, or sooner
///! when a request needs one (`Projects::analysis_for`); `flush` publishes
///! the diagnostics of every analysis that ran.
///!
///! The advertised `textDocumentSync` change kind is `1 = Full`, so editors
///! send the whole document on every didChange; the LAST entry of
///! `contentChanges` is the new text.

namespace lsp::handlers::text_sync;

import std::core::option;
import std::core::mem;
import std::collections::str;
import std::collections::string;
import std::collections::string::{ String };
import std::collections::array;
import std::collections::array::{ Array };
import std::io::stdio;
import std::json::value;

import lsp::server::docs;
import lsp::server::session;
import lsp::server::diag_render_cache;
import lsp::handlers::diagnostics;
import lsp::handlers::inactive_regions;
import lsp::protocol::jsonrpc;
import lsp::protocol::framing;
import lsp::protocol::conv;


public function did_open(docs: mut &docs::Docs, projects: mut &session::Projects,
                          params: &value::JsonValue) -> void {
    match (params.get(str::Str::from("textDocument"))) {
        Option::Some(td) => {
            const uri:     String = TextFields::clone_string_field_or_empty(td, "uri");
            const version: i32    = TextFields::i32_field_or(td, "version", 1 as i32);
            const text:    String = TextFields::clone_string_field_or_empty(td, "text");
            mut doc: docs::Document = docs::Document::new(uri, text, version);
            projects.note_open(doc.path.as_str());
            docs.insert(doc);
        }
        Option::None => { }
    }
}


public function did_change(docs: mut &docs::Docs, params: &value::JsonValue) -> void {
    match (params.get(str::Str::from("textDocument"))) {
        Option::Some(td) => {
            const uri:     String = TextFields::clone_string_field_or_empty(td, "uri");
            const version: i32    = TextFields::i32_field_or(td, "version", 1 as i32);
            const new_text: String = match (params.get(str::Str::from("contentChanges"))) {
                Option::Some(changes) => { TextFields::last_change_text(changes) }
                Option::None          => { String::new() }
            };
            match (docs.get(uri.as_str())) {
                Option::Some(doc_ptr) => {
                    doc_ptr.replace_text(new_text, version);
                }
                Option::None => {
                    // didChange before didOpen - accept it as an open.
                    mut fresh: docs::Document = docs::Document::new(
                        String::from_str(uri.as_str()), new_text, version);
                    docs.insert(fresh);
                }
            }
            mem::drop(uri);
        }
        Option::None => { }
    }
}


public function did_save(projects: mut &session::Projects, params: &value::JsonValue) -> void {
    match (params.get(str::Str::from("textDocument"))) {
        Option::Some(td) => {
            mut uri: String = TextFields::clone_string_field_or_empty(td, "uri");
            mut path: String = conv::UriPath::uri_to_fs_path(uri.as_str());
            projects.note_saved(path.as_str());
            mem::drop(path);
            mem::drop(uri);
        }
        Option::None => { }
    }
}


/// `workspace/didChangeWatchedFiles`: a `.cryo` file created, changed or
/// deleted on disk is a reason to analyse its project again.
public function did_change_watched_files(projects: mut &session::Projects,
                                         params: &value::JsonValue) -> void {
    match (params.get(str::Str::from("changes"))) {
        Option::Some(changes) => {
            match (changes) {
                value::JsonValue::Array(arr) => {
                    for (mut i: u64 = 0; i < arr.length(); i++) {
                        match (arr.get_ref(i)) {
                            Option::Some(ch) => {
                                mut uri: String = TextFields::clone_string_field_or_empty(ch, "uri");
                                if (uri.as_str().ends_with(&str::Str::from(".cryo"))) {
                                    mut path: String = conv::UriPath::uri_to_fs_path(uri.as_str());
                                    projects.note_saved(path.as_str());
                                    mem::drop(path);
                                }
                                mem::drop(uri);
                            }
                            Option::None => { }
                        }
                    }
                }
                _ => { }
            }
        }
        Option::None => { }
    }
}


/// Run every owed analysis and publish the diagnostics and inactive regions
/// of every analysis that ran, for each open document of its project.  An
/// analysis that did not parse publishes its diagnostics measured against
/// the buffers it read - the buffers as they are now - and is then released.
public function flush(docs: mut &docs::Docs, projects: mut &session::Projects,
                      writer: mut &stdio::Stdout, cache: diag_render_cache::DiagRenderCache*,
                      outbound: mut &OutboundRequests) -> void {
    mut ready: Array<session::Project*> = projects.take_unpublished(docs);
    for (mut i: u64 = 0; i < ready.length(); i++) {
        const p: session::Project* = ready.get(i).unwrap_or(null);
        if (p == null) { continue; }
        const a: session::Analysis* = p.published_analysis();
        a.publish_arena();
        docs.measure_buffers = (p.last.ctx != null);
        for (d in docs.by_uri.values_ref()) {
            if (!p.owns(d.path.as_str())) { continue; }
            diagnostics::DiagnosticPublisher::publish_for(writer, d.uri.as_str(), a.ctx, cache, docs);
            inactive_regions::InactiveRegionsPublisher::publish_for(writer, d.uri.as_str(),
                                                                    a.ctx, d.version, docs);
        }
        docs.measure_buffers = false;
        p.last.release();
    }
    if (ready.length() > 0) { outbound.send_semantic_tokens_refresh(writer); }
    mem::drop(ready);
}


public function did_close(docs: mut &docs::Docs, writer: mut &stdio::Stdout,
                           params: &value::JsonValue) -> void {
    match (params.get(str::Str::from("textDocument"))) {
        Option::Some(td) => {
            const uri: String = TextFields::clone_string_field_or_empty(td, "uri");
            docs.remove(uri.as_str());
            // Clear stale squiggles + dimming in the editor.
            diagnostics::DiagnosticPublisher::publish_empty(writer, uri.as_str());
            inactive_regions::InactiveRegionsPublisher::publish_empty(writer, uri.as_str());
            mut u: String = uri;  mem::drop(u);
        }
        Option::None => { }
    }
}


// TextFields - pull typed fields out of the notification params JSON.
// All statics: stateless readers over the borrowed JsonValue.

type struct TextFields {

    static clone_string_field_or_empty(obj: &value::JsonValue, key: string) -> String {
        match (obj.get(str::Str::from(key))) {
            Option::Some(v) => {
                match (v.as::<str::Str>()) {
                    Option::Some(s) => { return String::from_str(s); }
                    Option::None    => { return String::new(); }
                }
            }
            Option::None => { return String::new(); }
        }
    }

    static i32_field_or(obj: &value::JsonValue, key: string, fallback: i32) -> i32 {
        match (obj.get(str::Str::from(key))) {
            Option::Some(v) => {
                match (v) {
                    value::JsonValue::Number(n) => {
                        match (n) {
                            value::JsonNumber::Int(i)   => { return i as i32; }
                            value::JsonNumber::UInt(u)  => { return u as i32; }
                            value::JsonNumber::Float(f) => { return f as i32; }
                        }
                    }
                    _ => { return fallback; }
                }
            }
            Option::None => { return fallback; }
        }
    }

    /// Pull the `text` field out of the LAST change entry.  Treats every
    /// change as a whole-document replacement; `range`-bearing entries are
    /// silently overridden by whichever entry sits last in the array.
    static last_change_text(changes: &value::JsonValue) -> String {
        match (changes) {
            value::JsonValue::Array(arr) => {
                if (arr.length() == 0) { return String::new(); }
                // JsonValue owns resources (not Copy): borrow the last element in
                // place with get_ref rather than copying it out with get.
                match (arr.get_ref(arr.length() - 1)) {
                    Option::Some(last) => {
                        return TextFields::clone_string_field_or_empty(last, "text");
                    }
                    Option::None => { return String::new(); }
                }
            }
            _ => { return String::new(); }
        }
    }
}


// Server->client: nudge the editor to re-fetch semantic tokens

/// Allocator of JSON-RPC ids for outbound server->client requests.  Per
/// JSON-RPC each request needs a unique id so the client's (ignored)
/// response can be routed; we never read it but the spec requires the
/// field.  Owned by the `Server` (one per process), so the monotonic
/// counter lives on a struct field instead of a module global.
type struct OutboundRequests {
    next: i64;
    /// The client declared `workspace.semanticTokens.refreshSupport`; a
    /// refresh request to a client that did not is an unknown method to it.
    refresh_supported: boolean;

    static new() -> OutboundRequests {
        return OutboundRequests { next: 1 as i64, refresh_supported: false };
    }

    /// Hand out the next request id and advance the counter.
    next_id(mut &this) -> i64 {
        const id: i64 = this.next;
        this.next = id + 1 as i64;
        return id;
    }

    /// Send `workspace/semanticTokens/refresh` so the client re-requests
    /// tokens against the new analysis instead of painting tokens from an
    /// older one over text that has moved.
    send_semantic_tokens_refresh(mut &this, writer: mut &stdio::Stdout) -> void {
        if (!this.refresh_supported) { return; }
        const id: i64 = this.next_id();
        mut body: String = jsonrpc::JsonRpcCodec::encode_request(
            id,
            str::Str::from("workspace/semanticTokens/refresh"),
            value::JsonValue::Null);
        match (framing::FrameCodec::write_message(writer, body.as_str())) {
            Result::Ok(_)  => { }
            Result::Err(_) => { }
        }
        mem::drop(body);
    }
}
