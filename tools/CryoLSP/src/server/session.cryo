///! Projects and their analyses.
///!
///! A project is the cryoconfig a file's directory or one of its parents
///! holds, or, for a file under no cryoconfig, the file alone as its own
///! entry point.  A file an analysed project holds as a library module (the
///! standard library's, a dependency's) is answered from that project's
///! analysis instead, and is never analysed as a project of its own while
///! one holds it: a jump into the standard library lands in the analysis
///! the jump came from.  Each project has one analysis that answers questions: the
///! last one whose every module lexed and parsed, so the name layer stamped
///! the whole tree.  An analysis of a buffer that does not parse publishes
///! its diagnostics and is then released, leaving the previous answers in
///! place - a half-typed line does not take every answer away.
///!
///! An analysis runs when a project's first file is opened, when one of its
///! files is saved, and when a `.cryo` file changes on disk.  Edits between
///! saves change only the buffers; positions are carried between a buffer
///! and the text its analysis read by `docs::Document`.  Every analysis
///! reads every open buffer in place of its file.  While one runs, the
///! compiler calls the server's hook before each file and module, and
///! requests waiting then are answered from the last analysis
///! (`Projects::analysing`).
///!
///! Each analysis lives in its own arena, so releasing one reclaims the
///! whole context at once.  The compiler routes frees and reallocations by
///! the published arena, so the arena of the analysis being read is
///! published before it is walked (`Projects::analysis_for`).

namespace lsp::server::session;

import std::core::option;
import std::core::result;
import std::core::drop;
import std::core::intrinsics;
import std::core::mem;
import std::collections::str;
import std::collections::string::{ String };
import std::collections::array::{ Array };
import std::collections::hashmap::{ HashMap };
import std::io::stdio;

import std::alloc::arena;

import compiler::compilation_context::{ SourceOverride, YieldHook };
import compiler::module_graph::{ ModuleGraph, ModuleOrigin };
import compiler::instance;
import compiler::codegen::ast_arena;

import lsp::protocol::conv;
import lsp::server::docs;
import lsp::server::diag_render_cache;
import std::ffi::libc;


/// One analysis of a project: a context in its own arena, and the
/// NUL-terminated buffers the context's `string`s point into.
type struct Analysis {
    ctx:   compilation_context::CompilationContext*;
    arena: arena::Arena*;
    /// The overlays' paths and texts, in pairs, then the focus and the
    /// standard library's paths.
    keep:  Array<String>;
    /// How many path/text pairs open `keep`.
    overlays: i64;

    static none() -> Analysis {
        return Analysis { ctx: null, arena: null, keep: Array::<String>::new(), overlays: 0 };
    }

    /// The text this analysis read for the open buffer of file `path`.
    text_read(&this, path: str::Str) -> Option<str::Str> {
        for (mut i: i64 = 0; i < this.overlays; i++) {
            const p: String* = this.keep.get_ref(2 * i).unwrap_or(null);
            const t: String* = this.keep.get_ref(2 * i + 1).unwrap_or(null);
            if (p != null && t != null && p.as_str().equals(&path)) { return Option::Some(t.as_str()); }
        }
        return Option::None;
    }

    /// Make this analysis's arena the published one before its context is
    /// read: frees and reallocations route by the published arena.
    publish_arena(&this) -> void {
        if (this.arena != null) { ast_arena::cryo_ast_arena_set_current(this.arena); }
    }

    /// Reclaim the context in bulk, then the buffers it pointed into.
    release(mut &this) -> void {
        if (this.arena != null) {
            // Retract first: the allocator dereferences the published arena
            // on every free, so releasing it while published makes the next
            // free anywhere a wild read.
            ast_arena::cryo_ast_arena_retract(this.arena);
            this.arena.release();
            libc::free(this.arena as void*);
            this.arena = null;
        }
        this.ctx = null;
        mut old: Array<String> = Array::<String>::new();
        mem::swap(&old, &this.keep);
        mem::drop(old);
    }
}

implement trait Drop for Analysis {
    drop(mut &this) -> void { this.release(); }
}


type struct Project {
    /// The cryoconfig's path, or the lone file's path.
    key:     String;
    /// NUL-terminated cryoconfig path; empty for a lone file.
    config:  String;
    /// The analysis that answers questions; `ctx` null until one parsed.
    current: Analysis;
    /// An open or a save made an analysis owed.
    owed:    boolean;
    /// An analysis has run, whether or not it parsed.
    analysed: boolean;
    /// When the last analysis ran, as the number of analyses run before it
    /// in this process.
    analysed_at: u64;
    /// An analysis ran and its diagnostics are not published yet.
    unpublished: boolean;
    /// The last analysis when it was not adopted (its tree did not parse):
    /// held only until its diagnostics are published.
    last:    Analysis;
    /// The file whose open or save made the analysis owed; it picks the
    /// target view of a configuration with several.
    focus:   String;
    instance: instance::CompilerInstance;
    /// The arena of the analysis running now, null between analyses: the
    /// one to publish again when the compiler resumes after its hook.
    building: arena::Arena*;

    static new(key: str::Str, config: str::Str) -> Project {
        return Project {
            key:         String::from_str(key),
            config:      PathFinder::build_cstring_buffer(config),
            current:     Analysis::none(),
            owed:        false,
            analysed:    false,
            analysed_at: 0,
            unpublished: false,
            last:        Analysis::none(),
            focus:       String::new(),
            instance:    instance::CompilerInstance::new(instance::CompilerConfig::default()),
            building:    null,
        };
    }

    /// Run one analysis of the project, with every open buffer in place of
    /// its file.  The analysis is returned unadopted.  The compiler calls
    /// `hook` between modules.
    analyse(mut &this, docs: &docs::Docs, hook: virtual YieldHook*) -> Analysis {
        mut a: Analysis = Analysis::none();

        // Everything the context points into is made here, with arena
        // routing off, so it lives in libc and outlives the arena.
        const focus_c: String = PathFinder::build_cstring_buffer(this.focus.as_str());
        const stdlib_c: String = PathFinder::discover_stdlib_root(this.focus.as_str());
        mut overlay_paths: Array<string> = Array::<string>::new();
        mut overlay_texts: Array<string> = Array::<string>::new();
        for (d in docs.by_uri.values_ref()) {
            const path_c: String = PathFinder::build_cstring_buffer(d.path.as_str());
            const text_c: String = PathFinder::build_cstring_buffer(d.text.as_str());
            overlay_paths.push(path_c.as_ptr() as string);
            overlay_texts.push(text_c.as_ptr() as string);
            a.keep.push(path_c);
            a.keep.push(text_c);
            a.overlays = a.overlays + 1;
        }
        this.instance.config.stdlib_path_override = if (stdlib_c.length() > 0) {
            stdlib_c.as_ptr() as string
        } else {
            ""
        };
        const focus_s: string = focus_c.as_ptr() as string;
        a.keep.push(focus_c);
        a.keep.push(stdlib_c);

        const box_arena: Box<arena::Arena> = Box::<arena::Arena>::new(
            arena::Arena::with_chunk_size(8 * 1024 * 1024));
        a.arena = box_arena.leak();
        this.building = a.arena;
        this.instance.yield_hook = hook;
        ast_arena::cryo_ast_arena_set_current(a.arena);
        ast_arena::cryo_alloc_arena_set_active(true);
        mut overlays: [SourceOverride] = [];
        for (mut i: i64 = 0; i < overlay_paths.length(); i++) {
            overlays.push(SourceOverride {
                path:    overlay_paths.get(i).unwrap_or(""),
                content: overlay_texts.get(i).unwrap_or(""),
            });
        }
        const build: instance::ProjectBuild = this.instance.compile_for_lsp_project(
            this.config.as_ptr() as string, focus_s, overlays);
        ast_arena::cryo_alloc_arena_set_active(false);
        this.building = null;
        a.ctx = build.ctx;
        mem::drop(overlay_paths);
        mem::drop(overlay_texts);
        return a;
    }

    /// Analyse the project as its files and buffers are now.  The analysis
    /// is kept for publishing; it becomes the one that answers when its
    /// whole tree parsed, and then each open buffer's text is what it read.
    refresh(mut &this, docs: mut &docs::Docs, hook: virtual YieldHook*) -> void {
        // Owed no longer: a save while this one runs owes the next.
        this.owed = false;
        mut a: Analysis = this.analyse(docs, hook);
        this.analysed = true;
        this.unpublished = true;
        this.last.release();
        if (a.ctx != null && a.ctx.frontend_complete) {
            this.current.release();
            mem::swap(&this.current, &a);
            // A buffer edited while the analysis ran has moved on from the
            // text it read: the snapshot is the text read.
            for (d in docs.by_uri.values_ref()) {
                if (!this.owns(d.path.as_str()) && !this.holds_library(d.path.as_str())) { continue; }
                const read: Option<str::Str> = this.current.text_read(d.path.as_str());
                if (read.is_some()) { d.adopt_text(read.unwrap_or(str::Str::from(""))); }
            }
        } else {
            mem::swap(&this.last, &a);
        }
        mem::drop(a);
    }

    /// Whether this project's current analysis holds file `path` as a
    /// module that is not the project's own: the standard library's, a
    /// dependency's or a vendored library's.  Such a file is answered from
    /// this analysis rather than analysed as a project of its own.
    holds_library(&this, path: str::Str) -> boolean {
        if (this.current.ctx == null) { return false; }
        mut c: String = PathFinder::build_cstring_buffer(path);
        const graph: ModuleGraph* = this.current.ctx.module_graph;
        const idx: i64 = graph.find_module_by_path(c.as_ptr() as string);
        mem::drop(c);
        if (idx < 0) { return false; }
        return match (graph.get_module(idx).origin) {
            ModuleOrigin::Local => { false }
            _                   => { true }
        };
    }

    /// Whether file `path` belongs to this project.
    owns(&this, path: str::Str) -> boolean {
        mut k: String = Projects::key_for(path);
        const yes: boolean = k.as_str().equals(&this.key.as_str());
        mem::drop(k);
        return yes;
    }

    /// The analysis whose diagnostics are owed: the last one, adopted or not.
    published_analysis(&this) -> Analysis* {
        if (this.last.ctx != null) { return &this.last; }
        return &this.current;
    }

    set_focus(mut &this, path: str::Str) -> void {
        mut old: String = String::from_str(path);
        mem::swap(&old, &this.focus);
        mem::drop(old);
    }
}

implement trait Drop for Project {
    drop(mut &this) -> void { }
}


type struct Projects {
    by_key: HashMap<String, Project>;
    /// Called by the compiler between modules of an analysis: the server
    /// answering what it can meanwhile.
    yield_hook:   virtual YieldHook*;
    /// An analysis is running: a request answered from inside it is
    /// answered from the last analysis, never by starting another.
    analysing: boolean;
    /// How many analyses have run in this process.
    analyses: u64;

    static new() -> Projects {
        return Projects { by_key: HashMap::<String, Project>::new(), yield_hook: null,
                          analysing: false, analyses: 0 };
    }

    /// Run project `p`'s owed analysis, unless one is already running.
    refresh(mut &this, p: Project*, docs: mut &docs::Docs) -> void {
        if (!p.owed || this.analysing) { return; }
        this.analysing = true;
        this.analyses = this.analyses + 1;
        p.analysed_at = this.analyses;
        p.refresh(docs, this.yield_hook);
        this.analysing = false;
    }

    /// The arena of the analysis running now, or null.
    building(&this) -> arena::Arena* {
        for (p in this.by_key.values_ref()) {
            if (p.building != null) { return p.building; }
        }
        return null;
    }

    /// The key of the project `path` belongs to: the nearest cryoconfig at
    /// or above its directory, or the path itself when there is none.
    static key_for(path: str::Str) -> String {
        const cfg: String = PathFinder::discover_project_cryoconfig(path);
        if (cfg.length() > 0) { return cfg; }
        mem::drop(cfg);
        return String::from_str(path);
    }

    /// The analysed project holding file `path` as a library module
    /// (`Project::holds_library`), or null.  Of several, the one analysed
    /// last: the editor reached the file from it.
    library_holder(&this, path: str::Str) -> Project* {
        mut best: Project* = null;
        for (p in this.by_key.values_ref()) {
            if (!p.holds_library(path)) { continue; }
            if (best == null || p.analysed_at > best.analysed_at) { best = p; }
        }
        return best;
    }

    /// The project whose analysis answers for file `path`: an analysed
    /// project holding it as a library module, or else the project its own
    /// directory names.  A library file never becomes a project of its own
    /// while an analysis holds it, so jumping into the standard library
    /// starts no analysis of the library.
    project_for(mut &this, path: str::Str) -> Project* {
        const held: Project* = this.library_holder(path);
        if (held != null) { return held; }
        mut key: String = Projects::key_for(path);
        match (this.by_key.get_ref(&key)) {
            Option::Some(p) => { mem::drop(key); return p; }
            Option::None    => { }
        }
        const lone: boolean = key.as_str().equals(&path);
        const config: str::Str = if (lone) { str::Str::from("") } else { key.as_str() };
        const p: Project = Project::new(key.as_str(), config);
        this.by_key.insert(String::from_str(key.as_str()), p);
        match (this.by_key.get_ref(&key)) {
            Option::Some(q) => { mem::drop(key); return q; }
            Option::None    => { mem::drop(key); return null; }
        }
    }

    /// A document was opened: its project is analysed if it never was.
    note_open(mut &this, path: str::Str) -> void {
        const p: Project* = this.project_for(path);
        if (p == null) { return; }
        if (!p.analysed) { Projects::owe(p, path); }
    }

    /// A file was saved, or changed on disk: its project is analysed again.
    /// A library file saved is analysed again as part of the project that
    /// holds it, whose focus (its entry, or its target view) stays put.
    note_saved(mut &this, path: str::Str) -> void {
        const p: Project* = this.project_for(path);
        if (p == null) { return; }
        if (p.holds_library(path)) {
            p.owed = true;
            return;
        }
        Projects::owe(p, path);
    }

    static owe(p: Project*, path: str::Str) -> void {
        p.owed = true;
        p.set_focus(path);
    }

    has_owed(&this) -> boolean {
        for (p in this.by_key.values_ref()) {
            if (p.owed || p.unpublished) { return true; }
        }
        return false;
    }

    /// The analysis that answers for document `uri`, analysing its project
    /// first when an open or a save is owed; null when none has parsed.  Its
    /// arena is published on return.
    analysis_for(mut &this, docs: mut &docs::Docs, uri: str::Str) -> compilation_context::CompilationContext* {
        const doc: Option<docs::Document*> = docs.get(uri);
        if (!doc.is_some()) { return null; }
        const d: docs::Document* = doc.unwrap_or(null);
        const p: Project* = this.project_for(d.path.as_str());
        if (p == null) { return null; }
        this.refresh(p, docs);
        p.current.publish_arena();
        return p.current.ctx;
    }

    /// Run every owed analysis, and return each project whose diagnostics
    /// are unpublished (`Project::published_analysis` says from which).
    take_unpublished(mut &this, docs: mut &docs::Docs) -> Array<Project*> {
        // Collected first: an analysis answers requests between modules,
        // and a document opened meanwhile can add a project to the map.
        mut all: Array<Project*> = Array::<Project*>::new();
        for (p in this.by_key.values_ref()) { all.push(p); }
        mut out: Array<Project*> = Array::<Project*>::new();
        for (mut i: i64 = 0; i < all.length(); i++) {
            const p: Project* = all.get(i).unwrap_or(null);
            if (p == null) { continue; }
            this.refresh(p, docs);
            if (p.unpublished) {
                p.unpublished = false;
                out.push(p);
            }
        }
        return out;
    }
}

implement trait Drop for Projects {
    drop(mut &this) -> void { }
}


// PathFinder - project discovery + path utilities for the LSP.
// Static methods: they walk the filesystem from a path, holding no state.

type struct PathFinder {

/// Walk parents of `fs_path` looking for a directory that contains
/// `stdlib/lib.cryo`; return that `stdlib` directory's absolute
/// path as a NUL-terminated `String` (empty when nothing is found).
///
/// Mirrors the compiler's `resolve_stdlib_root` search but rooted at
/// the file being edited rather than at the binary or `cwd` - the
/// LSP binary often lives many directories away from the active
/// project (`.../tools/CryoLSP/build/bin/cryolsp`), so the
/// binary-relative search the CLI driver uses doesn't reach the
/// in-repo stdlib.  Walking up from the source file does.
static discover_stdlib_root(fs_path: str::Str) -> String {
    mut dir: String = PathFinder::lsp_parent_dir(fs_path);
    loop {
        if (dir.length() == 0) { mem::drop(dir); return String::new(); }

        mut probe: String = String::with_capacity(dir.length() + 16);
        probe.push(dir.as_str());
        probe.push("/stdlib/lib.cryo");
        probe.push_byte(0 as u8);
        const probe_len: i64 = probe.length() - 1;
        probe.truncate(probe_len);
        const p_cstr: string = probe.as_ptr() as string;

        if (libc::access(p_cstr, 0 as i32) == 0 as i32) {
            // Found <dir>/stdlib/lib.cryo - return <dir>/stdlib.
            mut out: String = String::with_capacity(dir.length() + 8);
            out.push(dir.as_str());
            out.push("/stdlib");
            out.push_byte(0 as u8);
            const out_len: i64 = out.length() - 1;
            out.truncate(out_len);
            mem::drop(probe);
            mem::drop(dir);
            return out;
        }
        mem::drop(probe);

        const next: String = PathFinder::lsp_parent_dir(dir.as_str());
        mem::drop(dir);
        dir = next;
    }
    return String::new();
}

/// Walk parents of `fs_path` until a `cryoconfig` is found; return
/// its absolute path as a NUL-terminated `String` (empty `String`
/// when nothing is found by the time we hit `/`).
///
/// "Closest" wins: editing
///   /home/.../CryoLang/compiler/src/compiler/diag/sink.cryo
/// finds
///   /home/.../CryoLang/compiler/cryoconfig
/// even though /home/.../CryoLang has no cryoconfig at the root.
static discover_project_cryoconfig(fs_path: str::Str) -> String {
    // Start from the file's directory.
    mut dir: String = PathFinder::lsp_parent_dir(fs_path);
    loop {
        if (dir.length() == 0) { mem::drop(dir); return String::new(); }

        mut candidate: String = String::with_capacity(dir.length() + 12);
        candidate.push(dir.as_str());
        candidate.push("/cryoconfig");
        candidate.push_byte(0 as u8);
        const cand_len: i64 = candidate.length() - 1;
        candidate.truncate(cand_len);
        const c_cstr: string = candidate.as_ptr() as string;

        // F_OK == 0; access returns 0 when the path is reachable.
        if (libc::access(c_cstr, 0 as i32) == 0 as i32) {
            mem::drop(dir);
            return candidate;
        }
        mem::drop(candidate);

        // Step up to the parent.  lsp_parent_dir of "/" is "" - that's
        // the loop's exit condition.
        const next: String = PathFinder::lsp_parent_dir(dir.as_str());
        mem::drop(dir);
        dir = next;
    }
    return String::new();
}

/// Return the parent directory of `path` as an owned `String`.
/// Trailing slashes are stripped, then everything from the last `/`
/// onwards is dropped.  `lsp_parent_dir("/foo/bar")` -> `"/foo"`,
/// `lsp_parent_dir("/foo")` -> `""` (we treat `"/"`'s parent as empty so
/// the discover_project_cryoconfig loop terminates).
static lsp_parent_dir(path: str::Str) -> String {
    const len: i64 = path.length();
    if (len == 0) { return String::new(); }
    const ptr: u8* = path.as_ptr();

    // Find the last '/' that isn't a trailing one.
    mut end: i64 = len;
    while (end > 0 && ptr[end - 1] == 47) { end = end - 1; }   // strip trailing /
    mut last_slash: i64 = -1;
    mut i: i64 = 0;
    while (i < end) {
        if (ptr[i] == 47) { last_slash = i; }
        i = i + 1;
    }
    if (last_slash < 0) { return String::new(); }
    if (last_slash == 0) { return String::new(); }              // path is "/foo"
    return String::from_str(path.sub_bytes(0, last_slash));
}

/// Build a `String` whose underlying buffer is NUL-terminated, suitable
/// for `String.as_ptr() as string`.  The reported `length()` excludes
/// the trailing NUL, but the byte sits in the buffer immediately past
/// the last logical byte.
static build_cstring_buffer(s: str::Str) -> String {
    mut out: String = String::with_capacity(s.length() + 1);
    out.push(s);
    out.push_byte(0 as u8);
    out.truncate(s.length());                       // hide the NUL from length()
    return out;
}
}
