///! Server - event loop + dispatcher + lifecycle gate.
///!
///! Reads framed JSON-RPC from stdin, dispatches by method, writes
///! responses + notifications back over stdout.  Lifecycle gating
///! enforces the LSP contract:
///!
///!   - Pre-`initialize`: any non-`exit` request returns
///!     `SERVER_NOT_INITIALIZED`.  Notifications are dropped silently.
///!   - Post-`initialize`: normal operation.
///!   - Post-`shutdown`: only `exit` is honoured; everything else
///!     returns `INVALID_REQUEST`.
///!
///! Process exit code:
///!   - 0  - clean shutdown (`shutdown` then `exit`)
///!   - 1  - anything else (mid-frame EOF, fatal protocol error)

namespace lsp::server::server;

import std::core::option;
import std::core::result;
import std::core::intrinsics;
import std::core::mem;
import std::collections::str;
import std::collections::string;
import std::collections::string::{ String };
import std::io::stdio;
import std::io::error;
import std::io::traits;
import std::json::value;
import std::json::serializer;
import std::alloc::arena;
import std::env;
import std::ffi::libc;
import std::sys::syscall;

import compiler::codegen::ast_arena;

import lsp::protocol::framing;
import lsp::protocol::jsonrpc;
import lsp::server::state;
import lsp::server::docs;
import lsp::server::session;
import lsp::server::diag_render_cache;
import lsp::handlers::lifecycle;
import lsp::handlers::text_sync;
import lsp::handlers::hover;
import lsp::handlers::definition;
import lsp::handlers::references;
import lsp::handlers::rename;
import lsp::handlers::symbols;
import lsp::handlers::completion;
import lsp::handlers::semantic_tokens;
import lsp::handlers::code_action;
import lsp::handlers::code_lens;
import lsp::handlers::rendered_diagnostic;


type struct Server {
    state:      state::ServerState;
    docs:       docs::Docs;
    projects:   session::Projects;
    diag_cache: diag_render_cache::DiagRenderCache;
    reader:     stdio::Stdin;
    writer:     stdio::Stdout;
    /// Id allocator for server->client requests (e.g. semanticTokens/refresh).
    outbound:   text_sync::OutboundRequests;
    /// The id of the request being answered outside the compiler's hook -
    /// the one an analysis may be running for - and whether the client
    /// cancelled it while the analysis ran.
    serving:    value::JsonValue;
    cancelled:  boolean;
    /// Inside the compiler's hook (`between_modules`).
    in_yield:   boolean;

    static new() -> Server {
        return Server {
            state:      state::ServerState::new(),
            docs:       docs::Docs::new(),
            projects:   session::Projects::new(),
            diag_cache: diag_render_cache::DiagRenderCache::new(),
            reader:     stdio::stdin(),
            writer:     stdio::stdout(),
            outbound:   text_sync::OutboundRequests::new(),
            serving:    value::JsonValue::Null,
            cancelled:  false,
            in_yield:   false,
        };
    }

    /// The compiler's hook between two modules of an analysis; `client` is
    /// the server.
    static between_modules(client: void*) -> void {
        const s: Server* = client as Server*;
        s.serve_waiting();
    }

    /// Handle every message already waiting on stdin, while an analysis is
    /// suspended between modules: a request is answered from the last
    /// analysis (`Projects::analysing` keeps it from starting another), an
    /// edit or a save updates the buffers or owes the next analysis, and a
    /// cancellation marks the request the analysis runs for.  Allocations
    /// go to the heap meanwhile, and the analysis's arena is published
    /// again before the compiler resumes.
    serve_waiting(mut &this) -> void {
        if (this.in_yield || !Server::poll_stdin_readable(0 as i32)) { return; }
        const building: arena::Arena* = this.projects.building();
        this.in_yield = true;
        ast_arena::cryo_alloc_arena_set_active(false);
        mut more: boolean = true;
        while (more && Server::poll_stdin_readable(0 as i32)) {
            match (framing::FrameCodec::read_message(&this.reader)) {
                Result::Ok(maybe) => {
                    match (maybe) {
                        Option::Some(body) => {
                            mut owned: String = body;
                            this.handle(owned.as_str());
                            mem::drop(owned);
                        }
                        // End of input: the main loop reads it again and stops.
                        Option::None => { more = false; }
                    }
                }
                Result::Err(_) => { more = false; }
            }
        }
        if (building != null) { ast_arena::cryo_ast_arena_set_current(building); }
        ast_arena::cryo_alloc_arena_set_active(true);
        this.in_yield = false;
    }

    /// Whether two request ids are the same id.
    static same_id(a: &value::JsonValue, b: &value::JsonValue) -> boolean {
        mut sa: String = serializer::stringify(a);
        mut sb: String = serializer::stringify(b);
        const same: boolean = sa.as_str().equals(&sb.as_str());
        mem::drop(sa);
        mem::drop(sb);
        return same;
    }

    /// Run until either `exit` or stdin closes.  Returns the process
    /// exit code (0 on a clean shutdown, 1 otherwise).
    ///
    /// An open or a save makes an analysis owed rather than running one
    /// inline.  While one is owed the loop waits up to `DEBOUNCE_MS` for
    /// more input before running it, so a burst of notifications (the
    /// editor opening several files, a save-all) becomes one analysis.  A
    /// request that needs the analysis runs it at once
    /// (`Projects::analysis_for`).
    run(mut &this) -> i32 {
        this.projects.yield_hook = Server::between_modules;
        this.projects.yield_client = &this as void*;
        loop {
            // Debounce window: only enter it while an analysis or its
            // publishing is owed, so an otherwise-idle server still blocks
            // on the read below (no busy-loop).
            if (this.projects.has_owed()) {
                if (!Server::poll_stdin_readable(DEBOUNCE_MS)) {
                    text_sync::flush(&this.docs, &this.projects,
                                     &this.writer, &this.diag_cache,
                                     &this.outbound);
                    continue;
                }
                // Input is ready - fall through and read it, deferring the
                // flush so a still-arriving burst keeps coalescing.
            }

            match (framing::FrameCodec::read_message(&this.reader)) {
                Result::Ok(maybe) => {
                    match (maybe) {
                        Option::Some(body) => {
                            mut owned: String = body;
                            this.handle(owned.as_str());
                            mem::drop(owned);
                        }
                        Option::None => {
                            // Clean EOF.  Treat as success only if we
                            // already received a `shutdown` request -
                            // anything else is a peer that gave up
                            // mid-conversation.
                            if (this.state.shutdown_requested) {
                                return 0 as i32;
                            }
                            return 1 as i32;
                        }
                    }
                }
                Result::Err(_) => {
                    // Logging the error itself would help, but the
                    // spec gives us no place to send it (stdout is
                    // the wire).  Bail with a non-zero code.
                    return 1 as i32;
                }
            }
        }
        return 1 as i32;                                    // unreachable
    }

    /// Decode one frame body and route it.  Errors during decode
    /// (malformed JSON, missing fields) collapse to `Invalid` and
    /// are logged but otherwise ignored - there's no `id` we can
    /// reply against.
    handle(mut &this, body: str::Str) -> void {
        mut msg: jsonrpc::IncomingMessage = jsonrpc::JsonRpcCodec::parse_incoming(body);
        match (&msg) {
            jsonrpc::IncomingMessage::Request(req) => {
                // Inside the hook a request is answered at once; outside it,
                // it may wait on an analysis, during which it can be
                // cancelled.
                if (this.in_yield) {
                    this.dispatch_request(&msg);
                } else {
                    this.serving = jsonrpc::JsonRpcCodec::clone_value(&req.id);
                    this.cancelled = false;
                    this.dispatch_request(&msg);
                    this.serving = value::JsonValue::Null;
                    this.cancelled = false;
                }
            }
            jsonrpc::IncomingMessage::Notification(_) => { this.dispatch_notification(&msg); }
            jsonrpc::IncomingMessage::Response        => { }
            jsonrpc::IncomingMessage::Invalid(inv)    => {
                this.reply_error(&inv.id, inv.code, inv.reason.as_str());
            }
        }
        mem::drop(msg);
    }

    dispatch_request(mut &this, msg: mut &jsonrpc::IncomingMessage) -> void {
        // Extract a borrow of the inner request without moving it
        // out of the enum - match-binding gives us `&` access.
        match (msg) {
            jsonrpc::IncomingMessage::Request(req) => {
                const method: str::Str = req.method.as_str();

                // `initialize` is the only request that runs while
                // uninitialized.  Everything else gets the
                // SERVER_NOT_INITIALIZED rejection.
                if (!this.state.initialized
                        && !method.equals(&str::Str::from("initialize"))) {
                    this.reply_error(&req.id,
                        jsonrpc::SERVER_NOT_INITIALIZED,
                        str::Str::from("server not initialized"));
                    return;
                }

                // After `shutdown`, only `exit` (a notification) is honoured.
                if (this.state.shutdown_requested) {
                    this.reply_error(&req.id,
                        jsonrpc::INVALID_REQUEST,
                        str::Str::from("server is shutting down"));
                    return;
                }

                if (method.equals(&str::Str::from("initialize"))) {
                    const result: value::JsonValue =
                        lifecycle::handle_initialize(&this.state, &req.params);
                    this.docs.utf8 = this.state.utf8_positions;
                    this.outbound.refresh_supported = this.state.semantic_tokens_refresh;
                    this.reply_ok(&req.id, result);
                    return;
                }

                if (method.equals(&str::Str::from("shutdown"))) {
                    const result: value::JsonValue =
                        lifecycle::handle_shutdown(&this.state);
                    this.reply_ok(&req.id, result);
                    return;
                }

                if (method.equals(&str::Str::from("textDocument/hover"))) {
                    // Fully-qualified: bare `Hover::` would resolve to
                    // the wire-shape `lsp::protocol::lsp::Hover` struct.
                    const result: value::JsonValue =
                        lsp::handlers::hover::handle_hover(
                            &this.docs, &this.projects, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                // Custom request: the extension's verbosity-aware hover
                // provider fires this when the user expands the hover.  Same
                // params as `textDocument/hover`; a struct/class type-decl
                // body additionally lists the type's method signatures.
                if (method.equals(&str::Str::from("cryo/expandHover"))) {
                    const result: value::JsonValue =
                        lsp::handlers::hover::handle_hover_verbose(
                            &this.docs, &this.projects, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                if (method.equals(&str::Str::from("textDocument/definition"))) {
                    const result: value::JsonValue =
                        lsp::handlers::definition::handle_definition(
                            &this.docs, &this.projects, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                if (method.equals(&str::Str::from("textDocument/references"))) {
                    const result: value::JsonValue =
                        lsp::handlers::references::handle_references(
                            &this.docs, &this.projects, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                if (method.equals(&str::Str::from("textDocument/documentHighlight"))) {
                    const result: value::JsonValue =
                        lsp::handlers::references::handle_highlight(
                            &this.docs, &this.projects, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                if (method.equals(&str::Str::from("textDocument/prepareRename"))) {
                    const r: rename::Renaming =
                        rename::Renaming::prepare(&this.docs, &this.projects, &req.params);
                    if (r.refused()) {
                        this.reply_error(&req.id, jsonrpc::REQUEST_FAILED, r.refusal.as_str());
                    } else {
                        this.reply_ok(&req.id, r.prepare_json(&this.docs));
                    }
                    return;
                }
                if (method.equals(&str::Str::from("textDocument/rename"))) {
                    mut r: rename::Renaming =
                        rename::Renaming::prepare(&this.docs, &this.projects, &req.params);
                    const new_name: str::Str = rename::new_name_of(&req.params);
                    if (!r.refused()) { r.check(&this.docs, new_name); }
                    if (r.refused()) {
                        this.reply_error(&req.id, jsonrpc::REQUEST_FAILED, r.refusal.as_str());
                    } else {
                        this.reply_ok(&req.id, r.edit_json(&this.docs, new_name));
                    }
                    return;
                }
                if (method.equals(&str::Str::from("textDocument/documentSymbol"))) {
                    const result: value::JsonValue =
                        lsp::handlers::symbols::handle_document_symbols(
                            &this.docs, &this.projects, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                if (method.equals(&str::Str::from("workspace/symbol"))) {
                    const result: value::JsonValue =
                        lsp::handlers::symbols::handle_workspace_symbols(
                            &this.docs, &this.projects, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                if (method.equals(&str::Str::from("textDocument/completion"))) {
                    const result: value::JsonValue =
                        lsp::handlers::completion::handle_completion(
                            &this.docs, &this.projects, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                if (method.equals(&str::Str::from("textDocument/semanticTokens/full"))) {
                    const result: value::JsonValue =
                        lsp::handlers::semantic_tokens::handle_semantic_tokens(
                            &this.docs, &this.projects, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                if (method.equals(&str::Str::from("textDocument/codeAction"))) {
                    const result: value::JsonValue = code_action::handle(&req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                if (method.equals(&str::Str::from("textDocument/codeLens"))) {
                    const result: value::JsonValue =
                        code_lens::handle_code_lens(&this.docs, &this.projects, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                // Custom request: the editor extension's
                // TextDocumentContentProvider asks for the rendered
                // text behind a `cryo-diagnostic:` virtual URI.
                if (method.equals(&str::Str::from("cryo/renderedDiagnostic"))) {
                    const result: value::JsonValue =
                        rendered_diagnostic::handle(&this.diag_cache, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }

                this.reply_error(&req.id,
                    jsonrpc::METHOD_NOT_FOUND,
                    str::Str::from("method not found"));
            }
            _ => { }
        }
    }

    dispatch_notification(mut &this, msg: mut &jsonrpc::IncomingMessage) -> void {
        match (msg) {
            jsonrpc::IncomingMessage::Notification(notif) => {
                const method: str::Str = notif.method.as_str();

                // `exit` is honoured even before initialize - it's
                // the only way for a stuck handshake to terminate.
                if (method.equals(&str::Str::from("exit"))) {
                    const code: i32 = if (this.state.shutdown_requested) {
                        0 as i32
                    } else {
                        1 as i32
                    };
                    env::process_exit(code);
                }

                // Lifecycle gate: pre-`initialize`, drop everything
                // except `exit` (handled above).
                if (!this.state.initialized) { return; }

                if (method.equals(&str::Str::from("textDocument/didOpen"))) {
                    text_sync::did_open(&this.docs, &this.projects, &notif.params);
                    return;
                }
                if (method.equals(&str::Str::from("textDocument/didChange"))) {
                    text_sync::did_change(&this.docs, &notif.params);
                    return;
                }
                if (method.equals(&str::Str::from("textDocument/didSave"))) {
                    text_sync::did_save(&this.projects, &notif.params);
                    return;
                }
                if (method.equals(&str::Str::from("workspace/didChangeWatchedFiles"))) {
                    text_sync::did_change_watched_files(&this.projects, &notif.params);
                    return;
                }
                if (method.equals(&str::Str::from("textDocument/didClose"))) {
                    text_sync::did_close(&this.docs, &this.writer, &notif.params);
                    return;
                }

                // `$/cancelRequest`: read while an analysis runs for the
                // request being answered, it turns that request's answer
                // into a cancellation.  Any other request was answered
                // before the cancellation could be read.
                if (method.equals(&str::Str::from("$/cancelRequest"))) {
                    const id: value::JsonValue* = notif.params.get(str::Str::from("id")).unwrap_or(null);
                    if (id != null && Server::same_id(id, &this.serving)) { this.cancelled = true; }
                    return;
                }

                // Unknown notifications are silently ignored per LSP spec.
            }
            _ => { }
        }
    }


    // Replies

    reply_ok(mut &this, id: &value::JsonValue, result: value::JsonValue) -> void {
        if (this.cancelled && !this.in_yield && Server::same_id(id, &this.serving)) {
            mut dropped: value::JsonValue = result;
            mem::drop(dropped);
            this.reply_error(id, jsonrpc::REQUEST_CANCELLED, str::Str::from("request cancelled"));
            return;
        }
        const id_clone: value::JsonValue = jsonrpc::JsonRpcCodec::clone_value(id);
        const resp: jsonrpc::ResponseMessage =
            jsonrpc::ResponseMessage::success(id_clone, result);
        this.send_response(&resp);
        mut owned: jsonrpc::ResponseMessage = resp;
        mem::drop(owned);
    }

    reply_error(mut &this, id: &value::JsonValue, code: i32, message: str::Str) -> void {
        const id_clone: value::JsonValue = jsonrpc::JsonRpcCodec::clone_value(id);
        const err: jsonrpc::ErrorObject =
            jsonrpc::ErrorObject::new(code, String::from_str(message));
        const resp: jsonrpc::ResponseMessage =
            jsonrpc::ResponseMessage::failure(id_clone, err);
        this.send_response(&resp);
        mut owned: jsonrpc::ResponseMessage = resp;
        mem::drop(owned);
    }

    send_response(mut &this, resp: &jsonrpc::ResponseMessage) -> void {
        mut body: String = jsonrpc::JsonRpcCodec::encode_response(resp);
        match (framing::FrameCodec::write_message(&this.writer, body.as_str())) {
            Result::Ok(_)  => { }
            Result::Err(_) => {
                // Write failed - the only reasonable response is to
                // bail.  We can't even log because stdout is the wire.
            }
        }
        mem::drop(body);
    }


    // Non-blocking stdin readiness - the debounce primitive.
    //
    // Edit-coalescing (see `run`) needs to ask "is more input ready
    // within a short window?" without blocking forever.  POSIX uses poll(2)
    // with a timeout; Windows peeks the stdin pipe.  Both return true when a
    // byte is ready (read it next) and false on a lull (flush the coalesced
    // compiles).  The bindings are the stdlib's proven `libc` / `syscall`
    // ones - no new externs.

    /// True when stdin (fd 0) has a byte ready within `timeout_ms`.  A poll
    /// error (EINTR, ...) or a timeout both report "not ready", so the caller
    /// flushes and re-enters the loop - it never hangs waiting on a lull.
    ![target(unix)]
    static poll_stdin_readable(timeout_ms: i32) -> boolean {
        mut pfd: libc::pollfd = libc::pollfd {
            fd:      0 as i32,                          // stdin
            events:  libc::POLLIN,
            revents: 0 as i16,
        };
        const rc: i32 = libc::poll(&pfd, 1 as u64, timeout_ms);
        return rc > 0 as i32;
    }

    /// Windows stdin is the client's pipe; `PeekNamedPipe` reports how many
    /// bytes are buffered without consuming them.  Poll it in 5 ms steps up
    /// to `timeout_ms`.  If the peek fails (stdin is a redirected file or a
    /// console rather than a pipe) fall back to "ready" so the reader is
    /// never starved of input.
    ![target(windows)]
    static poll_stdin_readable(timeout_ms: i32) -> boolean {
        const h: u8* = syscall::GetStdHandle(syscall::STD_INPUT_HANDLE);
        mut waited: i32 = 0 as i32;
        loop {
            mut avail: u32 = 0 as u32;
            const ok: i32 = syscall::PeekNamedPipe(
                h, null, 0 as u32, null, &avail, null);
            if (ok == 0 as i32)   { return true; }      // not a pipe: don't starve
            if (avail > 0 as u32) { return true; }
            if (waited >= timeout_ms) { return false; }
            syscall::Sleep(5 as u32);
            waited = waited + 5 as i32;
        }
        return false;
    }
}

implement trait Drop for struct Server {
    drop(mut &this) -> void { }
}


/// Debounce window in milliseconds: how long to wait for the next
/// keystroke before compiling.  Small enough to feel instant, large
/// enough that continuous typing coalesces into one compile per pause.
const DEBOUNCE_MS: i32 = 40 as i32;
