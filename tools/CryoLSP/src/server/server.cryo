///! Server — event loop + dispatcher + lifecycle gate.
///!
///! Reads framed JSON-RPC from stdin, dispatches by method, writes
///! responses + notifications back over stdout.  Lifecycle gating
///! enforces the LSP contract:
///!
///!   • Pre-`initialize`: any non-`exit` request returns
///!     `SERVER_NOT_INITIALIZED`.  Notifications are dropped silently.
///!   • Post-`initialize`: normal operation.
///!   • Post-`shutdown`: only `exit` is honoured; everything else
///!     returns `INVALID_REQUEST`.
///!
///! Process exit code:
///!   • 0  — clean shutdown (`shutdown` then `exit`)
///!   • 1  — anything else (mid-frame EOF, fatal protocol error)

namespace Lsp::Server::Server;

import std::core::option;
import std::core::result;
import std::core::intrinsics;
import std::collections::str;
import std::collections::string;
import std::io::stdio;
import std::io::error;
import std::io::traits;
import std::json::value;
import std::env;

import Lsp::Protocol::Framing;
import Lsp::Protocol::JsonRpc;
import Lsp::Server::State;
import Lsp::Server::Docs;
import Lsp::Server::Session;
import Lsp::Server::DiagRenderCache;
import Lsp::Handlers::Lifecycle;
import Lsp::Handlers::TextSync;
import Lsp::Handlers::Hover;
import Lsp::Handlers::Definition;
import Lsp::Handlers::Completion;
import Lsp::Handlers::SemanticTokens;
import Lsp::Handlers::CodeAction;
import Lsp::Handlers::CodeLens;
import Lsp::Handlers::RenderedDiagnostic;


type struct Server {
    state:      ServerState;
    docs:       Docs;
    sessions:   SessionMap;
    diag_cache: DiagRenderCache;
    reader:     Stdin;
    writer:     Stdout;

    static new() -> Server {
        return Server {
            state:      ServerState::new(),
            docs:       Docs::new(),
            sessions:   SessionMap::new(),
            diag_cache: DiagRenderCache::new(),
            reader:     stdin(),
            writer:     stdout(),
        };
    }

    drop(mut &this) -> void {
        this.state.drop();
        this.docs.drop();
        this.sessions.drop();
        this.diag_cache.drop();
    }

    /// Run until either `exit` or stdin closes.  Returns the process
    /// exit code (0 on a clean shutdown, 1 otherwise).
    run(mut &this) -> i32 {
        loop {
            match (Framing::read_message(&this.reader)) {
                Result::Ok(maybe) => {
                    match (maybe) {
                        Option::Some(body) => {
                            mut owned: String = body;
                            this.handle(owned.as_str());
                            owned.drop();
                        }
                        Option::None => {
                            // Clean EOF.  Treat as success only if we
                            // already received a `shutdown` request —
                            // anything else is a peer that gave up
                            // mid-conversation.
                            if (this.state.shutdown_requested) {
                                return 0 as i32;
                            }
                            return 1 as i32;
                        }
                    }
                }
                Result::Err(_) => {
                    // Logging the error itself would help, but the
                    // spec gives us no place to send it (stdout is
                    // the wire).  Bail with a non-zero code.
                    return 1 as i32;
                }
            }
        }
        return 1 as i32;                                    // unreachable
    }

    /// Decode one frame body and route it.  Errors during decode
    /// (malformed JSON, missing fields) collapse to `Invalid` and
    /// are logged but otherwise ignored — there's no `id` we can
    /// reply against.
    handle(mut &this, body: Str) -> void {
        mut msg: IncomingMessage = JsonRpc::parse_incoming(body);
        match (msg) {
            IncomingMessage::Request(_)      => { this.dispatch_request(&msg); }
            IncomingMessage::Notification(_) => { this.dispatch_notification(&msg); }
            IncomingMessage::Invalid(_)      => {
                // Drop the parse-failure reason on the floor — the
                // alternative is logging to stderr, which is fine
                // but adds dependency on `eprintln`.  Add when
                // surface area justifies it.
            }
        }
        msg.drop();
    }

    dispatch_request(mut &this, msg: mut &IncomingMessage) -> void {
        // Extract a borrow of the inner request without moving it
        // out of the enum — match-binding gives us `&` access.
        match (msg) {
            IncomingMessage::Request(req) => {
                const method: Str = req.method.as_str();

                // `initialize` is the only request that runs while
                // uninitialized.  Everything else gets the
                // SERVER_NOT_INITIALIZED rejection.
                if (!this.state.initialized
                        && !method.equals(&Str::from_cstr("initialize"))) {
                    this.reply_error(&req.id,
                        JsonRpc::SERVER_NOT_INITIALIZED,
                        Str::from_cstr("server not initialized"));
                    return;
                }

                if (method.equals(&Str::from_cstr("initialize"))) {
                    const result: JsonValue =
                        Lifecycle::handle_initialize(&this.state, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }

                if (method.equals(&Str::from_cstr("shutdown"))) {
                    const result: JsonValue =
                        Lifecycle::handle_shutdown(&this.state);
                    this.reply_ok(&req.id, result);
                    return;
                }

                if (method.equals(&Str::from_cstr("textDocument/hover"))) {
                    // Fully-qualified: bare `Hover::` would resolve to
                    // the wire-shape `Lsp::Protocol::Lsp::Hover` struct.
                    const result: JsonValue =
                        Lsp::Handlers::Hover::handle_hover(
                            &this.docs, &this.sessions, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                if (method.equals(&Str::from_cstr("textDocument/definition"))) {
                    const result: JsonValue =
                        Lsp::Handlers::Definition::handle_definition(
                            &this.docs, &this.sessions, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                if (method.equals(&Str::from_cstr("textDocument/completion"))) {
                    const result: JsonValue =
                        Lsp::Handlers::Completion::handle_completion(
                            &this.docs, &this.sessions, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                if (method.equals(&Str::from_cstr("textDocument/semanticTokens/full"))) {
                    const result: JsonValue =
                        Lsp::Handlers::SemanticTokens::handle_semantic_tokens(
                            &this.docs, &this.sessions, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                if (method.equals(&Str::from_cstr("textDocument/codeAction"))) {
                    const result: JsonValue = CodeAction::handle(&req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                if (method.equals(&Str::from_cstr("textDocument/codeLens"))) {
                    const result: JsonValue =
                        CodeLens::handle_code_lens(&this.sessions, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }
                // Custom request: the editor extension's
                // TextDocumentContentProvider asks for the rendered
                // text behind a `cryo-diagnostic:` virtual URI.
                if (method.equals(&Str::from_cstr("cryo/renderedDiagnostic"))) {
                    const result: JsonValue =
                        RenderedDiagnostic::handle(&this.diag_cache, &req.params);
                    this.reply_ok(&req.id, result);
                    return;
                }

                this.reply_error(&req.id,
                    JsonRpc::METHOD_NOT_FOUND,
                    Str::from_cstr("method not found"));
            }
            _ => { }
        }
    }

    dispatch_notification(mut &this, msg: mut &IncomingMessage) -> void {
        match (msg) {
            IncomingMessage::Notification(notif) => {
                const method: Str = notif.method.as_str();

                // `exit` is honoured even before initialize — it's
                // the only way for a stuck handshake to terminate.
                if (method.equals(&Str::from_cstr("exit"))) {
                    const code: i32 = if (this.state.shutdown_requested) {
                        0 as i32
                    } else {
                        1 as i32
                    };
                    env::process_exit(code);
                }

                // Lifecycle gate: pre-`initialize`, drop everything
                // except `exit` (handled above).
                if (!this.state.initialized) { return; }

                if (method.equals(&Str::from_cstr("textDocument/didOpen"))) {
                    TextSync::did_open(&this.docs, &this.sessions,
                                        &this.writer, &this.diag_cache,
                                        &notif.params);
                    return;
                }
                if (method.equals(&Str::from_cstr("textDocument/didChange"))) {
                    TextSync::did_change(&this.docs, &this.sessions,
                                          &this.writer, &this.diag_cache,
                                          &notif.params);
                    return;
                }
                if (method.equals(&Str::from_cstr("textDocument/didClose"))) {
                    TextSync::did_close(&this.docs, &this.sessions,
                                         &this.writer, &notif.params);
                    return;
                }

                // Unknown notifications are silently ignored per LSP spec.
            }
            _ => { }
        }
    }


    // ------------------------------------------------------------------
    // Replies
    // ------------------------------------------------------------------

    reply_ok(mut &this, id: &JsonValue, result: JsonValue) -> void {
        const id_clone: JsonValue = JsonRpc::clone_value(id);
        const resp: ResponseMessage =
            ResponseMessage::success(id_clone, result);
        this.send_response(&resp);
        mut owned: ResponseMessage = resp;
        owned.drop();
    }

    reply_error(mut &this, id: &JsonValue, code: i32, message: Str) -> void {
        const id_clone: JsonValue = JsonRpc::clone_value(id);
        const err: ErrorObject =
            ErrorObject::new(code, String::from_str(message));
        const resp: ResponseMessage =
            ResponseMessage::failure(id_clone, err);
        this.send_response(&resp);
        mut owned: ResponseMessage = resp;
        owned.drop();
    }

    send_response(mut &this, resp: &ResponseMessage) -> void {
        mut body: String = JsonRpc::encode_response(resp);
        match (Framing::write_message(&this.writer, body.as_str())) {
            Result::Ok(_)  => { }
            Result::Err(_) => {
                // Write failed — the only reasonable response is to
                // bail.  We can't even log because stdout is the wire.
            }
        }
        body.drop();
    }
}
