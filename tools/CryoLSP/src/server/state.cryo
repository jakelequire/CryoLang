///! Server lifecycle state.
///!
///! The LSP protocol is a strict state machine:
///!
///!   start → initialized → shutdown_requested → exit
///!
///! `initialize` flips `initialized = true`; after that the server
///! accepts normal traffic.  `shutdown` flips `shutdown_requested`;
///! after that only `exit` is honoured (everything else returns
///! `INVALID_REQUEST`).  `exit` itself ends the loop.
///!
///! The state struct also holds the `rootUri` the client sent so
///! handlers that resolve relative paths (e.g. an `import`) know
///! where the workspace lives.

namespace Lsp::Server::State;

import std::collections::string;

type struct ServerState {
    initialized:         boolean;
    shutdown_requested:  boolean;
    root_uri:            String;

    static new() -> ServerState {
        return ServerState {
            initialized:        false,
            shutdown_requested: false,
            root_uri:           String::new(),
        };
    }

    drop(mut &this) -> void {
        this.root_uri.drop();
    }
}
