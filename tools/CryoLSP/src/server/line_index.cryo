///! Byte-offset <-> (line, character) conversion.
///!
///! Built once per document at didOpen / didChange.  Subsequent
///! lookups are O(log N) where N is the line count, via binary
///! search of the line-start table.
///!
///! Three column systems meet here, and `Columns` is the only place that
///! converts between them:
///!   - the wire: 0-based `character`, counted in UTF-16 code units, or in
///!     bytes when the client and server agreed on `utf-8`;
///!   - bytes: an offset into the line's UTF-8 text;
///!   - the compiler: 1-based columns, one per byte, where a tab advances
///!     to the next multiple-of-4 stop.
///! Any other arithmetic on a column puts squiggles and lookups off on a
///! line with a tab or with text outside ASCII.
///!
///! `LineIndex` itself works in bytes: `line` is 0-based and offsets are
///! byte offsets into the document.

namespace lsp::server::line_index;

import std::core::option;
import std::core::drop;
import std::collections::str;
import std::collections::array::{ Array };
import lsp::protocol::lsp;


type struct LineIndex {
    /// Total length of the indexed text, in bytes.  Cached so callers
    /// can clamp out-of-range positions without a separate length read.
    text_length: i64;
    /// Byte offset of the start of each line.  Always at least one
    /// entry (offset 0); a trailing newline produces an extra entry
    /// for the empty last line.
    line_starts: Array<i64>;

    static build(text: str::Str) -> LineIndex {
        const len: i64 = text.length();
        mut starts: Array<i64> = Array::<i64>::with_capacity(64);
        starts.push(0);

        const ptr: u8* = text.as_ptr();
        mut i: i64 = 0;
        while (i < len) {
            const b: u8 = ptr[i];
            if (b == 10) {
                // '\n' - next line starts at the byte after the LF.
                starts.push(i + 1);
            }
            // '\r' alone is rare in editor buffers (LSP normalises to
            // \n on the wire).  Treating CR as a line break would
            // double-count CRLF; ignoring it is correct for both LF
            // and CRLF inputs.
            i = i + 1;
        }

        return LineIndex {
            text_length: len,
            line_starts: starts,
        };
    }

    line_count(&this) -> i64 {
        return this.line_starts.length();
    }

    /// Byte offset of the start of `line`.  Out-of-range lines clamp
    /// to text_length so callers building substrings get an empty
    /// slice rather than a panic.
    line_start(&this, line: u32) -> i64 {
        const idx: i64 = line as i64;
        if (idx >= this.line_starts.length()) {
            return this.text_length;
        }
        match (this.line_starts.get(idx)) {
            Option::Some(off) => { return off; }
            Option::None      => { return this.text_length; }
        }
    }

    /// Byte offset of the END of `line` (exclusive - i.e. start of the
    /// next line, or text_length for the last line).
    line_end(&this, line: u32) -> i64 {
        const next: i64 = (line as i64) + 1;
        if (next >= this.line_starts.length()) {
            return this.text_length;
        }
        match (this.line_starts.get(next)) {
            Option::Some(off) => { return off; }
            Option::None      => { return this.text_length; }
        }
    }

    /// Convert byte offset -> (line, byte column within the line).  Binary
    /// search over the line-start table; O(log N) in the line count.  The
    /// column is in bytes: `Docs::position_of_byte` makes it a wire column.
    position_of(&this, byte_offset: i64) -> lsp::Position {
        const n: i64 = this.line_starts.length();
        if (n == 0) {
            return lsp::Position::new(0 as u32, 0 as u32);
        }
        // Find the largest index `lo` with line_starts[lo] <= byte_offset.
        mut lo: i64 = 0;
        mut hi: i64 = n;                                   // exclusive
        while (lo + 1 < hi) {
            const mid: i64 = (lo + hi) / 2;
            const v: i64 = match (this.line_starts.get(mid)) {
                Option::Some(x) => { x }
                Option::None    => { 0 }
            };
            if (v <= byte_offset) {
                lo = mid;
            } else {
                hi = mid;
            }
        }
        const start: i64 = match (this.line_starts.get(lo)) {
            Option::Some(x) => { x }
            Option::None    => { 0 }
        };
        const ch: i64 = byte_offset - start;
        return lsp::Position::new(lo as u32, ch as u32);
    }
}


implement trait Drop for LineIndex {
    drop(mut &this) -> void { }
}


/// Column conversions within one line's text (no line terminator).
type struct Columns {

    /// Bytes in the UTF-8 sequence starting with `lead`.  A stray
    /// continuation byte counts as one, so malformed text still advances.
    static seq_bytes(lead: u8) -> i64 {
        if (lead < 0x80) { return 1; }
        if (lead >= 0xF0) { return 4; }
        if (lead >= 0xE0) { return 3; }
        if (lead >= 0xC0) { return 2; }
        return 1;
    }

    /// Wire units of the sequence starting with `lead`: its bytes under
    /// `utf-8`, otherwise UTF-16 code units (two for a 4-byte sequence).
    static seq_units(lead: u8, utf8: boolean) -> i64 {
        if (utf8) { return Columns::seq_bytes(lead); }
        if (lead >= 0xF0) { return 2; }
        return 1;
    }

    /// Byte offset of wire column `character`.  A column inside a
    /// character (half of a surrogate pair) lands on that character's start;
    /// a column past the end lands on the end.
    static wire_to_byte(line: str::Str, character: u32, utf8: boolean) -> i64 {
        const p: u8* = line.as_ptr();
        const len: i64 = line.length();
        mut i: i64 = 0;
        mut units: i64 = 0;
        while (i < len) {
            const u: i64 = Columns::seq_units(p[i], utf8);
            if (units + u > (character as i64)) { return i; }
            units = units + u;
            i = i + Columns::seq_bytes(p[i]);
        }
        return len;
    }

    /// Wire column of byte offset `byte_col`.
    static byte_to_wire(line: str::Str, byte_col: i64, utf8: boolean) -> u32 {
        const p: u8* = line.as_ptr();
        const len: i64 = line.length();
        mut i: i64 = 0;
        mut units: i64 = 0;
        while (i < len && i < byte_col) {
            units = units + Columns::seq_units(p[i], utf8);
            i = i + Columns::seq_bytes(p[i]);
        }
        return units as u32;
    }

    /// Byte offset of the compiler's 1-based column `col`.  A column inside
    /// a tab's expansion lands on the tab.
    static compiler_to_byte(line: str::Str, col: u32) -> i64 {
        const p: u8* = line.as_ptr();
        const len: i64 = line.length();
        mut i: i64 = 0;
        mut c: i64 = 1;
        while (i < len) {
            const next: i64 = Columns::compiler_advance(c, p[i]);
            if (next > (col as i64)) { return i; }
            c = next;
            i = i + 1;
        }
        return len;
    }

    /// The compiler's 1-based column of byte offset `byte_col`.
    static byte_to_compiler(line: str::Str, byte_col: i64) -> u32 {
        const p: u8* = line.as_ptr();
        const len: i64 = line.length();
        mut i: i64 = 0;
        mut c: i64 = 1;
        while (i < len && i < byte_col) {
            c = Columns::compiler_advance(c, p[i]);
            i = i + 1;
        }
        return c as u32;
    }

    static compiler_advance(col: i64, b: u8) -> i64 {
        if (b == 9) { return ((col - 1) / 4 + 1) * 4 + 1; }
        return col + 1;
    }

    /// The text of 0-based `line` in `text`, without its terminator.
    static line_of(text: str::Str, index: &LineIndex, line: u32) -> str::Str {
        const start: i64 = index.line_start(line);
        mut end: i64 = index.line_end(line);
        const p: u8* = text.as_ptr();
        while (end > start && (p[end - 1] == 10 || p[end - 1] == 13)) {
            end = end - 1;
        }
        return text.sub_bytes(start, end);
    }
}

implement trait Drop for Columns {
    drop(mut &this) -> void { }
}
