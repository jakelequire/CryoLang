///! Open-document store.
///!
///! Maps `URI -> Document`.  A document holds the current editor buffer
///! (text + version + LineIndex) and the text its project's current
///! analysis read, and `Docs` converts positions between the wire, the
///! buffer and that analysis.
///!
///! Lookup returns a borrow (`Document*`) so handlers can read the
///! text and line index without cloning the whole buffer.  The borrow
///! is invalidated by the next `remove(uri)` for that key, but
///! `insert` for a different URI does not invalidate prior borrows
///! (HashMap entries are individually heap-allocated).

namespace lsp::server::docs;

import std::core::option;
import std::core::drop;
import std::core::mem;
import std::collections::str;
import std::collections::string;
import std::collections::string::{ String };
import std::collections::hashmap;
import std::collections::hashmap::{ HashMap };
import std::fs::file;
import std::fs::path;
import std::ffi::libc;
import compiler::diag::source_span;
import lsp::server::line_index;
import lsp::server::line_index::{ Columns };
import lsp::protocol::lsp;
import lsp::protocol::conv;


type struct Document {
    uri:        String;
    /// The filesystem path the URI names, spelled as the compiler spells a
    /// span's file, so a span is matched to its document by comparing paths.
    path:       String;
    version:    i32;
    text:       String;
    line_index: line_index::LineIndex;
    /// The text the project's current analysis read for this file.  Answers
    /// come from that analysis while the buffer moves on, so positions are
    /// carried between the two texts by `snap_line_of` / `cur_line_of`.
    /// Without one (`has_snap` false) the analysis read what the buffer
    /// holds: the file was opened after it, unedited since.
    snap_text:  String;
    snap_index: line_index::LineIndex;
    has_snap:   boolean;

    static new(uri: String, text: String, version: i32) -> Document {
        const idx: line_index::LineIndex = line_index::LineIndex::build(text.as_str());
        const p: String = conv::UriPath::uri_to_fs_path(uri.as_str());
        return Document {
            uri:        uri,
            path:       p,
            version:    version,
            text:       text,
            line_index: idx,
            snap_text:  String::new(),
            snap_index: line_index::LineIndex::build(str::Str::from("")),
            has_snap:   false,
        };
    }

    line_text(&this, line: u32) -> str::Str {
        return Columns::line_of(this.text.as_str(), &this.line_index, line);
    }

    snap_line_text(&this, line: u32) -> str::Str {
        return Columns::line_of(this.snap_text.as_str(), &this.snap_index, line);
    }

    /// `text` is what a new analysis read for this buffer.
    adopt_text(mut &this, text: str::Str) -> void {
        mut old: String = String::from_str(text);
        mem::swap(&old, &this.snap_text);
        mem::drop(old);
        mut old_index: line_index::LineIndex = line_index::LineIndex::build(this.snap_text.as_str());
        mem::swap(&old_index, &this.snap_index);
        mem::drop(old_index);
        this.has_snap = true;
    }

    /// Lines the buffer and the analysed text share at the start, and at
    /// the end.  Between them is the edited region, whose lines have no
    /// counterpart.
    shared_lines(&this) -> SharedLines {
        const nc: u64 = this.line_index.line_count();
        const ns: u64 = this.snap_index.line_count();
        mut lim: u64 = nc;
        if (ns < lim) { lim = ns; }
        mut p: u64 = 0;
        while (p < lim && this.line_text(p as u32).equals(&this.snap_line_text(p as u32))) {
            p = p + 1;
        }
        mut s: u64 = 0;
        while (s < lim - p
               && this.line_text((nc - 1 - s) as u32).equals(&this.snap_line_text((ns - 1 - s) as u32))) {
            s = s + 1;
        }
        return SharedLines { prefix: p, suffix: s, cur_lines: nc, snap_lines: ns };
    }

    /// The analysed text's line for buffer line `line`, or -1 when the line
    /// was edited since the analysis.
    snap_line_of(&this, line: u32) -> i64 {
        if (!this.has_snap) { return line as i64; }
        const sh: SharedLines = this.shared_lines();
        const l: u64 = line as u64;
        if (l < sh.prefix) { return l as i64; }
        if (l + sh.suffix >= sh.cur_lines && l < sh.cur_lines) {
            return (l + sh.snap_lines - sh.cur_lines) as i64;
        }
        return -1;
    }

    /// The buffer's line for analysed line `line`, or -1 when the line was
    /// edited since the analysis.
    buffer_line_of(&this, line: u32) -> i64 {
        if (!this.has_snap) { return line as i64; }
        const sh: SharedLines = this.shared_lines();
        const l: u64 = line as u64;
        if (l < sh.prefix) { return l as i64; }
        if (l + sh.suffix >= sh.snap_lines && l < sh.snap_lines) {
            return (l + sh.cur_lines - sh.snap_lines) as i64;
        }
        return -1;
    }

    /// The buffer's line for analysed line `line`; a line inside the edited
    /// region is placed on the region's first line, so a range into it
    /// still points near what it named.
    cur_line_of(&this, line: u32) -> u32 {
        const b: i64 = this.buffer_line_of(line);
        if (b >= 0) { return b as u32; }
        return this.shared_lines().prefix as u32;
    }

    /// Replace the buffer (full sync) - drops the previous text, then
    /// rebuilds the index from the new contents and drops the previous one.
    replace_text(mut &this, new_text: String, new_version: i32) -> void {
        mut old_text: String = new_text;
        mem::swap(&old_text, &this.text);
        mem::drop(old_text);
        this.version = new_version;
        mut old_index: line_index::LineIndex = line_index::LineIndex::build(this.text.as_str());
        mem::swap(&old_index, &this.line_index);
        mem::drop(old_index);
    }
}

/// Lines a buffer shares with its analysed text: `prefix` at the start,
/// `suffix` at the end.
type struct SharedLines {
    prefix:     u64;
    suffix:     u64;
    cur_lines:  u64;
    snap_lines: u64;
}

/// A position in the compiler's terms: 1-based line, 1-based column.  Line
/// 0 is no position: the cursor's line was edited since the analysis, so no
/// node of it answers.
type struct CompilerPos {
    line: u32;
    col:  u32;
}

type struct Docs {
    by_uri: HashMap<String, Document>;
    /// Wire columns count bytes (the client offered `utf-8`) rather than
    /// UTF-16 code units.  Set once by `initialize`.
    utf8:   boolean;
    /// Spans being converted come from an analysis of the buffers as they
    /// are now, not from the current snapshot: set only while the
    /// diagnostics of an analysis that was not adopted are published.
    measure_buffers: boolean;

    static new() -> Docs {
        return Docs { by_uri: HashMap::<String, Document>::new(), utf8: false,
                      measure_buffers: false };
    }

    /// The open document whose file is `path`, compared as the compiler
    /// spells a span's file.
    by_path(&this, path: str::Str) -> Option<Document*> {
        for (d in this.by_uri.values_ref()) {
            if (d.path.as_str().equals(&path)) { return Option::Some(d); }
        }
        return Option::None;
    }

    /// The position in the current analysis of wire position (`line`,
    /// `character`) in the open document `uri`.  A document that is not
    /// open has no buffer to measure, so its column is taken as given.
    to_compiler(&this, uri: str::Str, line: u32, character: u32) -> CompilerPos {
        match (this.get(uri)) {
            Option::Some(doc) => {
                const snap_line: i64 = doc.snap_line_of(line);
                if (snap_line < 0) { return CompilerPos { line: 0, col: 0 }; }
                const text: str::Str = doc.line_text(line);
                const b: u64 = Columns::wire_to_byte(text, character, this.utf8);
                return CompilerPos { line: (snap_line + 1) as u32,
                                     col: Columns::byte_to_compiler(text, b) };
            }
            Option::None => { return CompilerPos { line: line + 1, col: character + 1 }; }
        }
    }

    /// The position in the current analysis whose scope a cursor is in.  A
    /// cursor on a line the analysis read is at its own position.  On the
    /// first line edited since, it is placed on the analysed line, no
    /// further along than the text the two lines share; further into the
    /// edit, at the start of that line, which every scope still open at the
    /// edit holds.
    scope_pos(&this, uri: str::Str, line: u32, character: u32) -> CompilerPos {
        const exact: CompilerPos = this.to_compiler(uri, line, character);
        if (exact.line != 0) { return exact; }
        match (this.get(uri)) {
            Option::Some(doc) => {
                const sh: SharedLines = doc.shared_lines();
                const at: u32 = (sh.prefix + 1) as u32;
                if (line as u64 != sh.prefix || sh.prefix + sh.suffix >= sh.snap_lines) {
                    return CompilerPos { line: at, col: 1 };
                }
                const cur: str::Str = doc.line_text(line);
                const old: str::Str = doc.snap_line_text(line);
                const cb: u8* = cur.as_ptr();
                const ob: u8* = old.as_ptr();
                mut k: u64 = 0;
                while (k < cur.length() && k < old.length() && cb[k] == ob[k]) { k = k + 1; }
                mut b: u64 = Columns::wire_to_byte(cur, character, this.utf8);
                if (b > k) { b = k; }
                return CompilerPos { line: at, col: Columns::byte_to_compiler(old, b) };
            }
            Option::None => { return exact; }
        }
    }

    /// Byte offset into document `doc` of wire position (`line`, `character`).
    byte_offset(&this, doc: &Document, line: u32, character: u32) -> u64 {
        const b: u64 = Columns::wire_to_byte(doc.line_text(line), character, this.utf8);
        return doc.line_index.line_start(line) + b;
    }

    /// Wire position of byte offset `offset` into document `doc`.
    position_of_byte(&this, doc: &Document, offset: u64) -> lsp::Position {
        const p: lsp::Position = doc.line_index.position_of(offset);
        const ch: u32 = Columns::byte_to_wire(doc.line_text(p.line), p.character as u64, this.utf8);
        return lsp::Position::new(p.line, ch);
    }

    /// Wire range of a compiler span.  The columns are measured against
    /// the text the analysis read for the span's file - an open document's
    /// analysed text, carried to the buffer's lines, or the file on disk
    /// when it is not open.  A span with no location is (0,0)-(0,0).
    range_of_span(&this, span: source_span::SourceSpan) -> lsp::Range {
        if (span.start_line == 0) {
            return lsp::Range::new(lsp::Position::new(0, 0), lsp::Position::new(0, 0));
        }
        const file_name: string = span.file;
        if (file_name == "" || libc::strlen(file_name) == 0) {
            return lsp::Range::new(lsp::Position::new(0, 0), lsp::Position::new(0, 0));
        }
        const fpath: str::Str = str::Str::from(file_name);
        mut end_line: u32 = span.end_line;
        mut end_col: u32 = span.end_col;
        if (end_line == 0) {
            end_line = span.start_line;
            end_col = span.start_col;
        }
        match (this.by_path(fpath)) {
            Option::Some(doc) => {
                if (this.measure_buffers || !doc.has_snap) {
                    return lsp::Range::new(
                        this.wire_of(doc.text.as_str(), &doc.line_index, span.start_line, span.start_col),
                        this.wire_of(doc.text.as_str(), &doc.line_index, end_line, end_col));
                }
                const s: lsp::Position =
                    this.wire_of(doc.snap_text.as_str(), &doc.snap_index, span.start_line, span.start_col);
                const e: lsp::Position =
                    this.wire_of(doc.snap_text.as_str(), &doc.snap_index, end_line, end_col);
                return lsp::Range::new(
                    lsp::Position::new(doc.cur_line_of(s.line), s.character),
                    lsp::Position::new(doc.cur_line_of(e.line), e.character));
            }
            Option::None => { }
        }
        match (file::read_to_string(path::Path::from(fpath))) {
            Result::Ok(t) => {
                mut owned: String = t;
                mut idx: line_index::LineIndex = line_index::LineIndex::build(owned.as_str());
                const r: lsp::Range = lsp::Range::new(
                    this.wire_of(owned.as_str(), &idx, span.start_line, span.start_col),
                    this.wire_of(owned.as_str(), &idx, end_line, end_col));
                mem::drop(idx);
                mem::drop(owned);
                return r;
            }
            Result::Err(_) => {
                // No text to measure: the compiler's columns are the best
                // statement of where the span is.
                return lsp::Range::new(
                    lsp::Position::new(span.start_line - 1, Docs::col0(span.start_col)),
                    lsp::Position::new(end_line - 1, Docs::col0(end_col)));
            }
        }
    }

    /// Wire position of the compiler's (`line`, `col`) in `text`.
    wire_of(&this, text: str::Str, index: &line_index::LineIndex, line: u32, col: u32) -> lsp::Position {
        if (line == 0) { return lsp::Position::new(0, 0); }
        const lt: str::Str = Columns::line_of(text, index, line - 1);
        const b: u64 = Columns::compiler_to_byte(lt, col);
        return lsp::Position::new(line - 1, Columns::byte_to_wire(lt, b, this.utf8));
    }

    static col0(col: u32) -> u32 {
        if (col == 0) { return 0; }
        return col - 1;
    }

    /// Insert a freshly-built document.  If a document already exists
    /// at the same URI it is dropped (the editor has effectively
    /// re-opened the file from scratch).
    insert(mut &this, doc: Document) -> void {
        const key: String = String::from_str(doc.uri.as_str());
        match (this.by_uri.insert(key, doc)) {
            Option::Some(prev) => { mem::drop(prev); }
            Option::None       => { }
        }
    }

    /// Borrow the document at `uri`, or `None` if no such document is
    /// open.  The pointer remains valid until `remove(uri)`.
    get(&this, uri: str::Str) -> Option<Document*> {
        const key: String = String::from_str(uri);
        const result: Option<Document*> = this.by_uri.get_ref(&key);
        mut owned: String = key;
        mem::drop(owned);
        return result;
    }

    /// Remove and drop the document at `uri`.  Returns whether one
    /// was actually removed (mostly for diagnostic logging - handlers
    /// don't generally care about the answer).
    remove(mut &this, uri: str::Str) -> boolean {
        const key: String = String::from_str(uri);
        match (this.by_uri.remove(&key)) {
            Option::Some(doc) => {
                mut d: Document = doc;
                mem::drop(d);
                mut k: String = key;
                mem::drop(k);
                return true;
            }
            Option::None => {
                mut k: String = key;
                mem::drop(k);
                return false;
            }
        }
    }
}


// Drop trait impls
//
// `HashMap<K, V>::drop` is bounded `where K: Drop, V: Drop`.  Inherent
// `drop` methods on stdlib templates (`String`, `Document` here) are
// recognised by the bound check, but only when expressed via the
// `implement trait Drop for T` shape - the stdlib documents the
// contract this way at `std::core::drop`.  Without this impl a `Document`
// cannot be stored in a HashMap.

implement trait Drop for Document {
    drop(mut &this) -> void { }
}

implement trait Drop for Docs {
    drop(mut &this) -> void { }
}
