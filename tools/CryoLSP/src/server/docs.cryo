///! Open-document store.
///!
///! Maps `URI -> Document`.  A document holds the current editor
///! buffer (text + version + LineIndex); whoever owns it is also
///! responsible for keeping the per-doc CompilerSession in sync -
///! the two structures are paired by URI in `Server`.
///!
///! Lookup returns a borrow (`Document*`) so handlers can read the
///! text and line index without cloning the whole buffer.  The borrow
///! is invalidated by the next `remove(uri)` for that key, but
///! `insert` for a different URI does not invalidate prior borrows
///! (HashMap entries are individually heap-allocated).

namespace lsp::server::docs;

import std::core::option;
import std::core::drop;
import std::core::mem;
import std::collections::str;
import std::collections::string;
import std::collections::string::{ String };
import std::collections::hashmap;
import std::collections::hashmap::{ HashMap };
import lsp::server::line_index;


type struct Document {
    uri:        String;
    version:    i32;
    text:       String;
    line_index: line_index::LineIndex;

    static new(uri: String, text: String, version: i32) -> Document {
        const idx: line_index::LineIndex = line_index::LineIndex::build(text.as_str());
        return Document {
            uri:        uri,
            version:    version,
            text:       text,
            line_index: idx,
        };
    }

    /// Replace the buffer (full sync) - drops the previous text, then
    /// rebuilds the index from the new contents and drops the previous one.
    replace_text(mut &this, new_text: String, new_version: i32) -> void {
        mut old_text: String = new_text;
        mem::swap(&old_text, &this.text);
        mem::drop(old_text);
        this.version = new_version;
        mut old_index: line_index::LineIndex = line_index::LineIndex::build(this.text.as_str());
        mem::swap(&old_index, &this.line_index);
        mem::drop(old_index);
    }
}

type struct Docs {
    by_uri: HashMap<String, Document>;

    static new() -> Docs {
        return Docs { by_uri: HashMap::<String, Document>::new() };
    }

    /// Insert a freshly-built document.  If a document already exists
    /// at the same URI it is dropped (the editor has effectively
    /// re-opened the file from scratch).
    insert(mut &this, doc: Document) -> void {
        const key: String = String::from_str(doc.uri.as_str());
        match (this.by_uri.insert(key, doc)) {
            Option::Some(prev) => { mem::drop(prev); }
            Option::None       => { }
        }
    }

    /// Borrow the document at `uri`, or `None` if no such document is
    /// open.  The pointer remains valid until `remove(uri)`.
    get(&this, uri: str::Str) -> Option<Document*> {
        const key: String = String::from_str(uri);
        const result: Option<Document*> = this.by_uri.get_ref(&key);
        mut owned: String = key;
        mem::drop(owned);
        return result;
    }

    /// Remove and drop the document at `uri`.  Returns whether one
    /// was actually removed (mostly for diagnostic logging - handlers
    /// don't generally care about the answer).
    remove(mut &this, uri: str::Str) -> boolean {
        const key: String = String::from_str(uri);
        match (this.by_uri.remove(&key)) {
            Option::Some(doc) => {
                mut d: Document = doc;
                mem::drop(d);
                mut k: String = key;
                mem::drop(k);
                return true;
            }
            Option::None => {
                mut k: String = key;
                mem::drop(k);
                return false;
            }
        }
    }
}


// Drop trait impls
//
// `HashMap<K, V>::drop` is bounded `where K: Drop, V: Drop`.  Inherent
// `drop` methods on stdlib templates (`String`, `Document` here) are
// recognised by the bound check, but only when expressed via the
// `implement trait Drop for T` shape - the stdlib documents the
// contract this way at `std::core::drop`.  Without these impls we
// can't store `Document` or `CompilerSession` in a HashMap.

implement trait Drop for Document {
    drop(mut &this) -> void { }
}

implement trait Drop for Docs {
    drop(mut &this) -> void { }
}
