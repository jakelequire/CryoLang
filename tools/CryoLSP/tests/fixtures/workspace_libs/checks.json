{
  "open": ["second/src/lib.cryo", "first/src/lib.cryo"],
  "checks": [
    {"name": "a workspace member's file is analysed with its member: its warning is published",
     "method": "diagnostics", "file": "second/src/lib.cryo",
     "expect": [{"code": "W0001", "at": "second/src/lib.cryo@second_unused"}]},
    {"name": "a second member's file is analysed with its own member, not the first's",
     "method": "diagnostics", "file": "first/src/lib.cryo",
     "expect": [{"code": "W0001", "at": "first/src/lib.cryo@first_unused"}]},
    {"name": "hover on a workspace member's function",
     "method": "hover", "at": "second/src/lib.cryo@second_value", "contains": ["second_value", "i64"]},
    {"name": "hover on the other member's function",
     "method": "hover", "at": "first/src/lib.cryo@first_value", "contains": ["first_value", "i64"]},
    {"name": "definition of a local in a workspace member",
     "method": "definition", "at": "second/src/lib.cryo@base_use", "expect": "second/src/lib.cryo@base"},
    {"name": "definition of a call into the shared source tree, from one member",
     "method": "definition", "at": "second/src/lib.cryo@second_twice_call", "expect": "shared/src/lib.cryo@twice"},
    {"name": "definition of a call into the shared source tree, from the other member",
     "method": "definition", "at": "first/src/lib.cryo@first_twice_call", "expect": "shared/src/lib.cryo@twice"}
  ]
}
