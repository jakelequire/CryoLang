# Language server fixture: a workspace of `[[lib]]` members with no entry
# point and no `[lib]`, sharing one source tree through `source_paths`.  A
# file is analysed as part of the member whose source_dir holds it.

[project]
project_name = "workspace_libs"
output_dir   = "build"
source_paths = ["shared/src"]

[compiler]

[[lib]]
name       = "first"
source_dir = "first/src"

[[lib]]
name       = "second"
source_dir = "second/src"

[dependencies]
