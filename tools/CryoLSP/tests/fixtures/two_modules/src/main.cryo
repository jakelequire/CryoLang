import Probe::A;
import Probe::B/*^import_b*/;
import Probe::A::{ /*@imp_twice*/twice, /*@imp_thrice*/thrice as /*@imp_three*/three };

type enum /*@mode*/Mode { /*@ready_variant*/Ready; /*@busy_variant*/Busy; }

function pick</*@t_param*/T>(x: /*@t_use*/T) -> T { return x; }
const /*@limit*/LIMIT: i64 = 5;

function classify(/*@v_param*/v: i64) -> i64 {
    return match (/*@v_use*/v) {
        /*@limit_arm*/LIMIT => { 1 }
        /*@ready_arm*/Ready => { /*@ready_use*/Ready + 100 }
    };
}

function main() -> i32 {
    const /*@wb*/wb: /*@ann_path*/B::/*@ann_item*/Item = /*@make_path*/B::Item::/*@make_call*/make(4);
    const /*@n*/n: i64 = /*@wb_use*/wb./*^after_dot*//*@get_call*/get();
    const h: i32 = /*@helper_path*/B::/*@helper_call*/helper();
    const /*@local_x*/local_x: i64 = /*@n_use*/n + 1;
    /*@unused*/const shadow: i64 = /*@local_x_use*/local_x;
    const _a: i32 = A::helper();
    const _m: Mode = Mode::/*@busy_use*/Busy;
    return pick(h) + classify(n) as i32 + scaled();
}

function scaled() -> i32 { return /*@twice_use*/twice(2) + /*@three_use*/three(); }
