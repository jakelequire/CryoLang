{
  "open": ["src/main.cryo", "src/a.cryo", "src/b.cryo"],
  "checks": [
    {"name": "definition of a local", "method": "definition",
     "at": "src/main.cryo@local_x_use", "expect": "src/main.cryo@local_x"},
    {"name": "definition of a local used in an expression", "method": "definition",
     "at": "src/main.cryo@n_use", "expect": "src/main.cryo@n"},
    {"name": "definition of a local used as a receiver", "method": "definition",
     "at": "src/main.cryo@wb_use", "expect": "src/main.cryo@wb"},
    {"name": "definition of a parameter", "method": "definition",
     "at": "src/main.cryo@v_use", "expect": "src/main.cryo@v_param"},
    {"name": "hover on a local shows its name and type", "method": "hover",
     "at": "src/main.cryo@local_x_use", "contains": ["local_x", "i64"]},
    {"name": "member completion after a dot lists the receiver's own members",
     "method": "completion", "at": "src/main.cryo@after_dot",
     "edit": {"file": "src/main.cryo", "from": "/*@get_call*/get();", "to": ";"},
     "includes": ["by", "get", "doubled"], "excludes": ["ax"]},
    {"name": "an unused variable warning is published at its statement",
     "method": "diagnostics", "file": "src/main.cryo",
     "expect": [{"code": "W0001", "at": "src/main.cryo@unused"}]}
  ]
}
