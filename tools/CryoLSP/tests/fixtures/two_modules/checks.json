{
  "open": ["src/main.cryo", "src/a.cryo", "src/b.cryo"],
  "checks": [
    {"name": "definition of a local", "method": "definition",
     "at": "src/main.cryo@local_x_use", "expect": "src/main.cryo@local_x"},
    {"name": "definition of a local used in an expression", "method": "definition",
     "at": "src/main.cryo@n_use", "expect": "src/main.cryo@n"},
    {"name": "definition of a local used as a receiver", "method": "definition",
     "at": "src/main.cryo@wb_use", "expect": "src/main.cryo@wb"},
    {"name": "definition of a parameter", "method": "definition",
     "at": "src/main.cryo@v_use", "expect": "src/main.cryo@v_param"},
    {"name": "hover on a local shows its name and type", "method": "hover",
     "at": "src/main.cryo@local_x_use", "contains": ["local_x", "i64"]},
    {"name": "definition of a static call through a qualified type is the named module's",
     "method": "definition", "at": "src/main.cryo@make_call", "expect": "src/b.cryo@b_make"},
    {"name": "hover on a static call through a qualified type shows the named module's",
     "method": "hover", "at": "src/main.cryo@make_call", "contains": ["make", "i64"], "excludes": ["i32"]},
    {"name": "definition of a method call is the receiver's type's method",
     "method": "definition", "at": "src/main.cryo@get_call", "expect": "src/b.cryo@b_get"},
    {"name": "hover on a method call shows the receiver's type's method",
     "method": "hover", "at": "src/main.cryo@get_call", "contains": ["get", "i64"], "excludes": ["i32"]},
    {"name": "definition of a module-qualified function call is the named module's",
     "method": "definition", "at": "src/main.cryo@helper_call", "expect": "src/b.cryo@b_helper"},
    {"name": "definition of `this` is its own module's type",
     "method": "definition", "at": "src/b.cryo@b_this", "expect": "src/b.cryo@b_item"},
    {"name": "hover on `this` names its own module's type",
     "method": "hover", "at": "src/b.cryo@b_this", "contains": ["Probe::B::Item"], "excludes": ["Probe::A"]},
    {"name": "definition of a return type is its own module's type",
     "method": "definition", "at": "src/b.cryo@b_make_ret", "expect": "src/b.cryo@b_item"},
    {"name": "definition of a struct literal's type is its own module's type",
     "method": "definition", "at": "src/b.cryo@b_lit", "expect": "src/b.cryo@b_item"},
    {"name": "definition of an implementation's target is its own module's type",
     "method": "definition", "at": "src/b.cryo@b_impl_target", "expect": "src/b.cryo@b_item"},
    {"name": "a match arm that binds a name hovers as the binding, not a variant",
     "method": "hover", "at": "src/main.cryo@ready_arm", "contains": ["Ready", "i64"], "excludes": ["Mode::Ready"]},
    {"name": "a match arm's binding is labelled a binding, not a constant",
     "method": "hover", "at": "src/main.cryo@ready_arm", "contains": ["binding Ready: i64"], "excludes": ["const"]},
    {"name": "a use of a match arm's binding is labelled a binding",
     "method": "hover", "at": "src/main.cryo@ready_use", "contains": ["binding Ready: i64"], "excludes": ["const"]},
    {"name": "definition of a use of a match arm's binding is the binding",
     "method": "definition", "at": "src/main.cryo@ready_use", "expect": "src/main.cryo@ready_arm"},
    {"name": "definition of a constant named by a match arm is the constant",
     "method": "definition", "at": "src/main.cryo@limit_arm", "expect": "src/main.cryo@limit"},
    {"name": "hover on a constant named by a match arm shows the constant",
     "method": "hover", "at": "src/main.cryo@limit_arm", "contains": ["LIMIT", "i64"]},
    {"name": "definition of a qualified type annotation is the named module's type",
     "method": "definition", "at": "src/main.cryo@ann_item", "expect": "src/b.cryo@b_item"},
    {"name": "hover on a qualified type annotation names the whole path",
     "method": "hover", "at": "src/main.cryo@ann_item", "contains": ["Probe::B::Item"]},
    {"name": "definition of a field read through `this` is its own module's field",
     "method": "definition", "at": "src/a.cryo@a_ax_use", "expect": "src/a.cryo@a_ax"},
    {"name": "hover on a field read through `this` shows its type",
     "method": "hover", "at": "src/a.cryo@a_ax_use", "contains": ["ax", "i32"]},
    {"name": "definition of an enum variant named by a path is the variant",
     "method": "definition", "at": "src/main.cryo@busy_use", "expect": "src/main.cryo@busy_variant"},
    {"name": "definition of a type parameter's use is its declaration",
     "method": "definition", "at": "src/main.cryo@t_use", "expect": "src/main.cryo@t_param"},
    {"name": "definition of an import's module is the module's namespace declaration",
     "method": "definition", "at": "src/main.cryo@import_b", "expect": "src/b.cryo@b_ns"},
    {"name": "references of a type are its own module's, with its declaration",
     "method": "references", "at": "src/b.cryo@b_item", "declaration": true,
     "expect": ["src/b.cryo@b_item", "src/b.cryo@b_make_ret", "src/b.cryo@b_lit",
                "src/b.cryo@b_impl_target", "src/main.cryo@ann_path", "src/main.cryo@make_path"]},
    {"name": "references of the same-named type in another module are that module's",
     "method": "references", "at": "src/a.cryo@a_item", "declaration": true,
     "expect": ["src/a.cryo@a_item", "src/a.cryo@a_make_ret", "src/a.cryo@a_lit"]},
    {"name": "references of a method call, without its declaration",
     "method": "references", "at": "src/main.cryo@get_call",
     "expect": ["src/main.cryo@get_call"]},
    {"name": "references of a field: its declaration, a struct literal's initializer, a read through `this`",
     "method": "references", "at": "src/a.cryo@a_ax_use", "declaration": true,
     "expect": ["src/a.cryo@a_ax", "src/a.cryo@a_ax_init", "src/a.cryo@a_ax_use"]},
    {"name": "document highlight of a local is its declaration and its use",
     "method": "documentHighlight", "at": "src/main.cryo@local_x_use",
     "expect": ["src/main.cryo@local_x", "src/main.cryo@local_x_use"]},
    {"name": "document symbols nest a type's members and an implementation's methods",
     "method": "documentSymbol", "file": "src/b.cryo",
     "includes": ["Item", "Item/by", "Item/make", "Item/get", "helper", "implement Item/doubled"],
     "excludes": ["Item/ax"]},
    {"name": "workspace symbols find a method by part of its name",
     "method": "workspaceSymbol", "query": "doub", "includes": ["doubled"], "excludes": ["helper"]},
    {"name": "member completion after a dot lists the receiver's own members",
     "method": "completion", "at": "src/main.cryo@after_dot",
     "edit": {"file": "src/main.cryo", "from": "/*@get_call*/get();", "to": ";"},
     "includes": ["by", "get", "doubled"], "excludes": ["ax"]},
    {"name": "member completion with a syntax error elsewhere in the buffer answers from the last analysis, running none",
     "method": "completion", "at": "src/main.cryo@after_dot", "quiet_stderr": true,
     "edit": {"file": "src/main.cryo",
              "from": "/*@get_call*/get();\n    const h: i32 = /*@helper_path*/B::/*@helper_call*/helper();",
              "to": ";\n    const h: i32 = (((;"},
     "includes": ["by", "get", "doubled"], "excludes": ["ax", "fresh", "function"]},
    {"name": "completion after a module path lists that module's declarations",
     "method": "completion", "at": "src/main.cryo@c_mod",
     "edit": {"file": "src/main.cryo", "from": "const _a: i32 = A::helper();", "to": "const _a: i32 = B::/*^c_mod*/"},
     "includes": ["Item", "helper"], "excludes": ["only_a", "main", "function"]},
    {"name": "completion after a type path lists its own static members, not a namesake's",
     "method": "completion", "at": "src/main.cryo@c_ty",
     "edit": {"file": "src/main.cryo", "from": "const _a: i32 = A::helper();", "to": "const _a: i32 = B::Item::/*^c_ty*/"},
     "includes": ["make", "fresh"], "excludes": ["get", "by", "only_a", "function"]},
    {"name": "completion after an enum lists its variants",
     "method": "completion", "at": "src/main.cryo@c_enum",
     "edit": {"file": "src/main.cryo", "from": "Mode::/*@busy_use*/Busy;", "to": "Mode::/*^c_enum*/"},
     "includes": ["Ready", "Busy"], "excludes": ["function"]},
    {"name": "completion on a bare name lists what the scope sees, not only keywords",
     "method": "completion", "at": "src/main.cryo@c_bare",
     "edit": {"file": "src/main.cryo", "from": "const _a: i32 = A::helper();", "to": "const _a: i32 = lo/*^c_bare*/"},
     "includes": ["local_x", "n", "wb", "classify", "pick", "LIMIT", "Mode", "B", "return"],
     "excludes": ["_m", "v", "T"]},
    {"name": "completion after `this.` in a method lists its type's instance members",
     "method": "completion", "at": "src/b.cryo@c_this",
     "edit": {"file": "src/b.cryo", "from": "return /*@b_this*/this.by;", "to": "return this./*^c_this*/"},
     "includes": ["by", "get", "doubled"], "excludes": ["fresh", "make", "ax"]},
    {"name": "the extended hover on a type lists its members, its implementation's included",
     "method": "expandHover", "at": "src/b.cryo@b_item",
     "contains": ["by: i64", "make", "get", "doubled", "fresh"], "excludes": ["ax", "only_a"]},
    {"name": "a bare name in a method offers its module's names, not the type's own members",
     "method": "completion", "at": "src/b.cryo@c_bare_in_method",
     "edit": {"file": "src/b.cryo", "from": "return /*@b_this*/this.by;", "to": "return h/*^c_bare_in_method*/"},
     "includes": ["helper", "Item", "this"], "excludes": ["by", "get", "make", "doubled"]},
    {"name": "completion after an import's path lists the modules under it",
     "method": "completion", "at": "src/main.cryo@c_imp",
     "edit": {"file": "src/main.cryo", "from": "import Probe::A;", "to": "import std::core::/*^c_imp*/"},
     "includes": ["option", "mem"], "excludes": ["function", "main"]},
    {"name": "an unused variable warning is published at its statement",
     "method": "diagnostics", "file": "src/main.cryo",
     "expect": [{"code": "W0001", "at": "src/main.cryo@unused"}]},
    {"name": "an edit to one open file reaches another file's diagnostics when it is saved",
     "method": "diagnostics", "file": "src/main.cryo",
     "edit": {"file": "src/b.cryo", "from": "/*@b_helper*/helper()", "to": "/*@b_helper*/helper_gone()",
              "save": true},
     "expect": [{"code": "E0233", "at": "src/main.cryo@helper_path"}]},
    {"name": "a saved syntax error leaves the last analysis answering on unchanged lines",
     "method": "definition", "at": "src/main.cryo@local_x_use",
     "edit": {"file": "src/main.cryo", "from": "/*@helper_call*/helper();", "to": "/*@helper_call*/helper(;",
              "save": true},
     "expect": "src/main.cryo@local_x"},
    {"name": "a line inserted above, unsaved, moves the answer with it",
     "method": "definition", "at": "src/main.cryo@local_x_use",
     "edit": {"file": "src/main.cryo", "from": "function main() -> i32 {",
              "to": "function main() -> i32 {\n    const _inserted: i64 = 1;"},
     "expect": "src/main.cryo@local_x"},
    {"name": "a line edited since the last analysis answers nothing",
     "method": "definition", "at": "src/main.cryo@n_use",
     "edit": {"file": "src/main.cryo", "from": "/*@n_use*/n + 1;", "to": "/*@n_use*/n + 2;"},
     "expect": null}
  ]
}
