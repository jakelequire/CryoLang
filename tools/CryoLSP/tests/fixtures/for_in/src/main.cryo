import std::collections::string::{ String };

function main() -> i32 {
    const /*@name*/name: String = String::from("ab");
    mut /*@total*/total: i32 = 0;
    /*@for_kw*/for (/*@byte*/byte in /*@name_use*/name./*@as_bytes*/as_bytes()) {
        /*@total_body*/total = total + /*@byte_use*/byte as i32;
    }
    return total;
}
