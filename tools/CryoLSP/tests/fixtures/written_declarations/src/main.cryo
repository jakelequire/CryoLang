namespace Written::Main;

import std::collections::string::{ String };
import std::collections::array::{ Array };
import std::fmt;

/// Spread over two lines.
function /*@spread*/spread(x: int,
                           y: int) -> int {
    return x + y;
}

/// A point.
type struct /*@point*/Point {
    x: int;
    y: int;
    label: String;

    /// The origin.
    static /*@origin*/origin() -> Point {
        return Point { x: 0, y: 0, label: String::from("o") };
    }

    bump(mut &this) {
        this.x = this.x + 1;
    }

    length(&this) -> int {
        return this.x + this./*@step_use*/step();
    }

private:
    /// One step along.
    /*@step*/step(&this) -> int {
        return this.y;
    }
}

/// A shade.
type enum /*@shade*/Shade {
    Light;
    Dark(int);
}

/// A box of anything.
type struct /*@boxed*/Boxed<T> {
    item: T;
}

function unbox(b: /*@boxed_use*/Boxed<int>) -> int {
    return b.item;
}

function note(x: int) {
    fmt::printf("%d\n", x);
}

function made<T>() -> int {
    return 1;
}

function main() -> int {
    mut names: Array<String> = Array::</*@turbo_arg*/String>::new();
    names.push(String::from("a"));
    const p: Point = Point::/*@origin_use*/origin();
    const s: /*@shade_use*/Shade = Shade::Light;
    const k: int = made::</*@call_arg*/String>();
    const copied: String = p.label./*@clone_use*/clone();
    mut q: Point = Point::origin();
    q./*@bump_use*/bump();
    /*@note_use*/note(copied.length() as int);
    const r: int = q./*@x_use*/x;
    fmt::printf("%d %d\n", names.length(), k);
    match (s) {
        Shade::Light => { }
        Shade::Dark(_) => { }
    }
    return /*@spread_use*/spread(p.x, p./*@length_use*/length()) + r;
}
