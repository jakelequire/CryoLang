// A method written with no receiver is refused, and the fixes offered
// follow its body: one that never names `this` is offered `static` first,
// and `&this`; one that names it is offered `&this` and `mut &this`.
namespace Main;

type struct Counter {
    count: i32;

    /*@zero*/zero(/*^zero_receiver*/) -> i32 { return 0; }

    /*@get*/get(/*^get_receiver*/) -> i32 { return this.count; }

    /*@set*/set(/*^set_receiver*/value: i32) -> void { this.count = value; }
}

function main() -> i32 {
    return 0;
}
