// A method written with no receiver is refused at its name.  No edit is
// offered: which receiver it needs, or whether it is static, is the
// author's choice.
namespace Main;

type struct Counter {
    count: i32;

    /*@zero*/zero() -> i32 { return 0; }

    /*@get*/get() -> i32 { return this.count; }

    /*@set*/set(value: i32) -> void { this.count = value; }
}

function main() -> i32 {
    return 0;
}
