// A method that writes through a `&this` receiver is refused, and the fix
// offered declares the receiver `mut &this` - also where the write reaches
// the receiver through a field.
namespace Main;

type struct Counter {
    count: i32;
    listeners: [i32];

    bump(/*@receiver*/&this) -> void {
        /*@write*/this.count = this.count + 1;
    }

    listen(/*@listen_receiver*/&this, x: i32) -> void {
        this.listeners./*@push*/push(x);
    }
}

function main() -> i32 {
    mut c: Counter = Counter { count: 0, listeners: [] };
    c.bump();
    c.listen(1);
    return c.count;
}
