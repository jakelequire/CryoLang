// A method that writes through a `&this` receiver is refused, and the fix
// offered declares the receiver `mut &this` - also where the write reaches
// the receiver through a field, and where the receiver is written
// `const &this`, whose `const` the fix replaces.  A method changing its
// receiver in two places keeps a squiggle at each, and both offer the one
// fix that settles them.
namespace Main;

type struct Counter {
    count: i32;
    listeners: [i32];

    bump(/*@receiver*/&this) -> void {
        /*@write*/this.count = this.count + 1;
    }

    listen(/*@listen_receiver*/&this, x: i32) -> void {
        this.listeners./*@push*/push(x);
    }

    reset(/*@const_receiver*/const &this) -> void {
        /*@const_write*/this.count = 0;
    }

    register(/*@register_receiver*/&this, x: i32) -> void {
        /*@register_write*/this.count = x;
        this.listeners./*@register_push*/push(x);
    }
}

function main() -> i32 {
    mut c: Counter = Counter { count: 0, listeners: [] };
    c.bump();
    c.listen(1);
    c.reset();
    c.register(2);
    return c.count;
}
