// A method that writes through a `&this` receiver is refused, and the fix
// offered declares the receiver `mut &this`.
namespace Main;

type struct Counter {
    count: i32;

    bump(/*@receiver*/&this) -> void {
        /*@write*/this.count = this.count + 1;
    }
}

function main() -> i32 {
    mut c: Counter = Counter { count: 0 };
    c.bump();
    return c.count;
}
