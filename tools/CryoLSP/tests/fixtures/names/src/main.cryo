namespace Main;

import std::collections::string::{ String };
import std::collections::array::{ Array };
import Probe::Shapes;

type struct Cat { name: String; }

implement Cat {
    static /*@cat_new_decl*/new(name: String) -> Cat { return Cat { name: name }; }
}

type struct Point { y: i32; }

function count_lines(/*@lines*/lines: const (const u8*)*, n: i64) -> i64 {
    if (lines == null) { return 0; }
    return n;
}

function main() -> i32 {
    const /*@c*/c: Cat = Cat::/*@cat_new*/new(String::from_str("tom"));
    const /*@c2*/c2 = Cat::new(String::from_str("kit"));
    const /*@p*/p: Shapes::Point = Shapes::Point::make(1);
    const /*@q*/q: Point = Point { y: 2 };
    const /*@xs*/xs: Array<i64> = Array::<i64>::new();
    const /*@greet*/greet: String = String::from_str("hi");
    /*@greet_use*/greet.to_ascii_uppercase();
    const o: Shapes::Point = Shapes::Point::/*@origin_use*/ORIGIN;
    return p.x + q.y + o.x + (xs.length() as i32) + (c.name.length() + c2.name.length()) as i32 + (count_lines(null, 0) as i32);
}
