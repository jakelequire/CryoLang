// Indented wrongly on purpose: the formatting check lays it out.
namespace Main;

type struct Point {
public:
x: int;   
        y: int;
	static origin() -> Point {
	return Point { x: 0,
	               y: 0 };
	}
}




function main() -> int {
  const p: Point = Point::origin();
        return p.x
            + p.y;
}

