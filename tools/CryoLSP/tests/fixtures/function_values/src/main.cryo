type struct Listener {
    /*@field_decl*/callback: (i32) -> i32;

    fire(&this, payload: i32) -> i32 {
        return this./*@field_call*/callback(payload);
    }
}

function twice(n: i32) -> i32 {
    return n * 2;
}

function apply(/*@param_decl*/step: (i32) -> i32, n: i32) -> i32 {
    return /*@param_call*/step(n);
}

function main() -> i32 {
    const /*@local_decl*/handler: (i32) -> i32 = twice;
    const first: i32 = /*@local_call*/handler(1);
    const second: i32 = apply(/*@local_passed*/handler, 2);
    const listener: Listener = Listener { callback: handler };
    return first + second + listener.fire(3) + /*@plain_call*/twice(4);
}
