{
  "open": ["src/main.cryo"],
  "checks": [
    {"name": "a value of a function type is a function where a call calls it, and a variable, parameter or field elsewhere",
     "method": "semanticTokens", "file": "src/main.cryo",
     "expect": {"src/main.cryo@local_call": "function",
                "src/main.cryo@param_call": "function",
                "src/main.cryo@field_call": "function",
                "src/main.cryo@plain_call": "function",
                "src/main.cryo@local_decl": "variable.declaration",
                "src/main.cryo@local_passed": "variable",
                "src/main.cryo@param_decl": "parameter.declaration",
                "src/main.cryo@field_decl": "property.declaration"}},
    {"name": "hover on a called function value is the local, with its function type",
     "method": "hover", "at": "src/main.cryo@local_call", "contains": ["handler", "(i32) -> i32"]},
    {"name": "definition of a called field of a function type is the field",
     "method": "definition", "at": "src/main.cryo@field_call", "expect": "src/main.cryo@field_decl"},
    {"name": "definition of a called function value is the local",
     "method": "definition", "at": "src/main.cryo@local_call", "expect": "src/main.cryo@local_decl"},
    {"name": "function values draw no diagnostic",
     "method": "diagnostics", "file": "src/main.cryo", "expect": []}
  ]
}
