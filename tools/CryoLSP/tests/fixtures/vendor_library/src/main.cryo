namespace VendorLibrary::Main;

/*@import*/import vendor::Widgets;

function main() -> int {
    mut gadget: Widgets::Gadget = Widgets::/*@gadget_lit*/Gadget { /*@size_init*/size: 2, flags: 0 };
    const turns: i32 = /*@spin_path*/Widgets::/*@spin_call*/widgets_spin(&gadget, Widgets::/*@limit_use*/WIDGETS_LIMIT);
    return (turns + gadget./*@size_read*/size) as int;
}
