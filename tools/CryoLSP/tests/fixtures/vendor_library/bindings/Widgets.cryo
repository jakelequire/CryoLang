/// Bindings in the shape `cryo vendor` generates from C headers.

/*@ns*/namespace Widgets;

![repr(C)]
type struct /*@gadget*/Gadget {
    /*@size*/size: i32;
    flags: u32;
}

const /*@limit*/WIDGETS_LIMIT: i32 = 8 as i32;

extern "C" {
    function /*@spin*/widgets_spin(gadget: mut Gadget*, turns: i32) -> i32;
}
