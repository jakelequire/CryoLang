// An operator on a type parameter its bounds do not license is refused,
// and the fix adds the bound: a new `where` clause, or `+` after the
// parameter's own bound.
namespace Main;

function largest<T>(a: T, b: T) -> T/*^largest_bounds*/ {
    if (/*@greater*/a > b) { return a; }
    if (/*@less*/b < a) { return b; }
    return b;
}

function sum<T>(a: T, b: T) -> T where T: Clone/*^sum_bounds*/ {
    return /*@plus*/a + b;
}

function main() -> i32 {
    return 0;
}
