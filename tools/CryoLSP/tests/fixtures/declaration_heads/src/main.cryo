// A declaration's hover heads its signature with how far it reaches and
// the directives written above it, and writes a receiver and a variadic
// rest as they are written.
namespace Main;

import std::fmt;
/*@ffi_import*/import std::ffi::libc;
import std::collections::string::{ String };

![inline]
internal function /*@scale*/scale(x: i32) -> i32 {
    return x * 2;
}

private type struct /*@pair*/Pair {
    private /*@left*/left: i32;
    right: i32;

    ![section(".text.pair")]
    /*@tooling*/![tooling(kind(a, b))]
    static /*@make*/make(left: i32, right: i32) -> Pair {
        return Pair { left: left, right: right };
    }

    sum(&this) -> i32 {
        return this.left + this.right;
    }

    bump(mut &this) -> void {
        this.right = this.right + 1;
    }

    peek(const &this) -> i32 {
        return this.left;
    }
}

private function poke(p: mut i32*, held: const (&Pair)*) -> void {
    *p = held.right;
}

function main() -> i32 {
    mut p: Pair = Pair::/*@make_use*/make(1, 2);
    p./*@bump_use*/bump();
    mut slot: i32 = p./*@peek_use*/peek();
    const held: &Pair = &p;
    /*@poke_use*/poke(&slot, &held);
    fmt::/*@printf_use*/printf("%d\n", p.right);
    libc::/*@c_printf_use*/printf("\n" as u8*);
    const name: string = "Ada";
    const age: i32 = 36;
    const /*@greeting*/greeting: String = f"{name} is { age:>3} years old {{\n{p.right:?}";
    const /*@nul*/nul: string = "a\0b";
    fmt::printf("%d %s\n", greeting.length(), nul);
    const found: Option<i32> = Option::Some(age);
    fmt::printf("%d\n", found./*@unwrap_use*/unwrap());
    return /*@scale_use*/scale(p./*@sum_use*/sum()) + p./*@right_use*/right;
}
