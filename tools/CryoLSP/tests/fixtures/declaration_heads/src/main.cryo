// A declaration's hover heads its signature with how far it reaches and
// the directives written above it, and writes a receiver and a variadic
// rest as they are written.
namespace Main;

import std::fmt;
import std::ffi::libc;

![inline]
internal function /*@scale*/scale(x: i32) -> i32 {
    return x * 2;
}

private type struct /*@pair*/Pair {
    private /*@left*/left: i32;
    right: i32;

    ![section(".text.pair")]
    /*@tooling*/![tooling(kind(a, b))]
    static /*@make*/make(left: i32, right: i32) -> Pair {
        return Pair { left: left, right: right };
    }

    sum(&this) -> i32 {
        return this.left + this.right;
    }

    bump(mut &this) -> void {
        this.right = this.right + 1;
    }
}

function main() -> i32 {
    mut p: Pair = Pair::/*@make_use*/make(1, 2);
    p./*@bump_use*/bump();
    fmt::/*@printf_use*/printf("%d\n", p.right);
    libc::/*@c_printf_use*/printf("\n" as u8*);
    return /*@scale_use*/scale(p./*@sum_use*/sum()) + p./*@right_use*/right;
}
