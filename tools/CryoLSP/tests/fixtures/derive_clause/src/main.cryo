import std::core::cmp::{ Eq, Ord };
import std::core::hash::{ Hash };
import std::core::clone::{ Clone };
import std::fmt::display::{ Debug };

type struct /*@point*/Point with [/*@eq*/Eq, Ord, /*@hash*/Hash, Clone, Debug] {
    x: i64;
    y: i64;
}

type enum Shape<T> with [Eq, /*@clone*/Clone] {
    Dot;
    Held(T);
}

function main() -> i32 {
    const p: Point = Point { x: 1, y: 2 };
    const q: Point = p./*@clone_use*/clone();
    const s: Shape<i64> = Shape::Held(3);
    if (p./*@equals_use*/equals(&q) && s.equals(&s.clone())) { return 0; }
    return 1;
}
