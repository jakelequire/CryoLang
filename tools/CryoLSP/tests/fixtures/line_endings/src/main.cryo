// Every line of this file ends in CR LF, as an editor on Windows saves it.
// A position past the first line must still land on the token it names.
namespace /*@ns*/Main;

import std::fmt;

type struct /*@point*/Point {
    x: int;
    y: int;
}

function /*@sum*/sum(p: /*@point_use*/Point) -> int {
    const /*@total*/total: int = p.x + p.y;
    return /*@total_use*/total;
}

function main() -> int {
    const p: /*@point_use2*/Point = /*@point_use3*/Point { x: 1, y: 2 };
    return /*@sum_use*/sum(p);
}
