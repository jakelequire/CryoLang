# Language server fixture: a `[lib]` and two `[[bin]]`s over one source
# tree, the library in its own directory below it (every file there is
# the library's).  Each binary's entry point is reached only from its own
# view, so each is analysed as its own program, and the library's modules
# with the library.

[project]
project_name = "library_with_binaries"
output_dir   = "build"

[lib]
name       = "shapes"
source_dir = "src/shapes"

[[bin]]
name        = "first"
entry_point = "src/first.cryo"

[[bin]]
name        = "second"
entry_point = "src/second.cryo"

[compiler]

[dependencies]
