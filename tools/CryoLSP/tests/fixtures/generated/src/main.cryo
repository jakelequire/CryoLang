import std::collections::string::{ /*@string_imp*/String };

const /*@limit*/LIMIT: i64 = 3;

function /*@shout*/shout</*@t*/T>(/*@p*/p: /*@t_use*/T) -> T { return /*@p_use*/p; }

function main() -> i32 {
    const /*@x*/x: i64 = /*@limit_use*/LIMIT;
    const msg: String = /*@fstr*/f"x={x}";
    const /*@owned*/owned: String = /*^lit*/"abc";
    mut /*@cnt*/cnt: i64 = 0;
    const /*@add*/add = /*^lambda*/move (n: i64) -> i64 { return n + /*@owned_cap*/owned.length() as i64; };
    /*@cnt_use*/cnt = cnt + add(1) + /*@shout_use*/shout(/*@x_arg*/x);
    mut /*@grown*/grown = cnt * 2;
    grown = grown + 1;
    return msg.length() as i32 + grown as i32;
}
