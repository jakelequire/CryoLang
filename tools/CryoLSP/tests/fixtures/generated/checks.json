{
  "open": ["src/main.cryo"],
  "checks": [
    {"name": "semantic tokens colour names by what they name",
     "method": "semanticTokens", "file": "src/main.cryo",
     "expect": {"src/main.cryo@p_use": "parameter",
                "src/main.cryo@t_use": "typeParameter",
                "src/main.cryo@limit_use": "variable.readonly",
                "src/main.cryo@x": "variable.declaration.readonly",
                "src/main.cryo@cnt": "variable.declaration",
                "src/main.cryo@shout_use": "function",
                "src/main.cryo@owned_cap": "variable.readonly"}},
    {"name": "a name inside an f-string's hole is coloured, the f-string's lowering is not",
     "method": "semanticTokens", "file": "src/main.cryo",
     "expect": {"src/main.cryo@fstr+5": "variable.readonly", "src/main.cryo@fstr": null}},
    {"name": "nothing is coloured at a lambda or a converted literal, where the compiler writes its own nodes",
     "method": "semanticTokens", "file": "src/main.cryo",
     "expect": {"src/main.cryo@lambda": null, "src/main.cryo@lit": null}},
    {"name": "hover inside an f-string's hole names the local, not the lowering's call",
     "method": "hover", "at": "src/main.cryo@fstr+5", "contains": ["x", "i64"], "excludes": ["fmt"]},
    {"name": "definition inside an f-string's hole is the local",
     "method": "definition", "at": "src/main.cryo@fstr+5", "expect": "src/main.cryo@x"},
    {"name": "references of a local include its use in an f-string's hole",
     "method": "references", "at": "src/main.cryo@x", "declaration": true,
     "expect": ["src/main.cryo@x", "src/main.cryo@fstr+5", "src/main.cryo@x_arg"]},
    {"name": "references of a local a lambda captures are where it is written, not the lambda",
     "method": "references", "at": "src/main.cryo@owned", "declaration": true,
     "expect": ["src/main.cryo@owned", "src/main.cryo@owned_cap"]},
    {"name": "inlay hints show the type of a variable declared with none written, not a type the compiler wrote",
     "method": "inlayHints", "file": "src/main.cryo",
     "expect": {"src/main.cryo@grown+5": ": i64", "src/main.cryo@add+3": null, "src/main.cryo@x+1": null, "src/main.cryo@cnt+3": null}},
    {"name": "inlay hints are not given on a line edited since the analysis",
     "method": "inlayHints", "file": "src/main.cryo",
     "edit": {"file": "src/main.cryo", "from": "cnt * 2;", "to": "cnt * 3;"},
     "expect": {"src/main.cryo@grown+5": null}},
    {"name": "rename of a local reaches its use in an f-string's hole",
     "method": "rename", "at": "src/main.cryo@x_arg", "new_name": "y", "old": "x",
     "expect": ["src/main.cryo@x", "src/main.cryo@fstr+5", "src/main.cryo@x_arg"]},
    {"name": "rename of a local a lambda captures rewrites the capture once",
     "method": "rename", "at": "src/main.cryo@owned", "new_name": "held", "old": "owned",
     "expect": ["src/main.cryo@owned", "src/main.cryo@owned_cap"]},
    {"name": "rename of a standard library type is refused",
     "method": "prepareRename", "at": "src/main.cryo@string_imp",
     "refused": "declared outside the project"},
    {"name": "rename of a local to a name a later use's scope already binds is refused",
     "method": "rename", "at": "src/main.cryo@x", "new_name": "cnt",
     "refused": "already names something"},
    {"name": "rename of a constant to a name its module already declares is refused",
     "method": "rename", "at": "src/main.cryo@limit", "new_name": "main",
     "refused": "already names something"}
  ]
}
