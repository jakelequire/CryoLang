{
  "open": ["src/main.cryo", "src/used.cryo", "src/orphan.cryo"],
  "checks": [
    {"name": "a file nothing imports says so on its first line",
     "method": "diagnostics", "file": "src/orphan.cryo",
     "expect": [{"code": null, "at": "src/orphan.cryo@orphan_top",
                 "message": "nothing the project builds imports it"}]},
    {"name": "an imported file carries no notice",
     "method": "diagnostics", "file": "src/used.cryo", "expect": []},
    {"name": "the entry point carries no notice",
     "method": "diagnostics", "file": "src/main.cryo", "expect": []},
    {"name": "when module discovery stops, an open file it did not reach says why",
     "method": "diagnostics", "file": "src/used.cryo",
     "edit": {"file": "src/main.cryo", "from": "import Notices::Used;",
              "to": "import Notices::Missing;", "save": true},
     "expect": [{"code": null, "at": "src/used.cryo@used_top",
                 "message": "stopped while finding the project's modules"}]},
    {"name": "the notice names the error that stopped discovery, and where",
     "method": "diagnostics", "file": "src/used.cryo",
     "edit": {"file": "src/main.cryo", "from": "import Notices::Used;",
              "to": "import Notices::Missing;", "save": true},
     "expect": [{"code": null, "at": "src/used.cryo@used_top",
                 "message": "main.cryo:1: cannot find module `Notices::Missing`"}]},
    {"name": "once discovery succeeds again, the notice is withdrawn",
     "method": "diagnostics", "file": "src/used.cryo", "expect": []}
  ]
}
