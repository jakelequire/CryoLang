// Lines indented with tabs, and text outside ASCII before a token: the
// editor counts columns in UTF-16 units, one per tab.  And the element
// type written inside an array, pointer or optional type: each wrapper's
// span covers its element.

type struct /*@node*/Node {
    value: i64;
}

function arrays(a: /*@in_dynamic*/Node[], b: &/*@in_ref_ptr_array*/Node*[],
                c: /*@in_pointer*/Node*, d: /*@in_optional_array*/Node[]?) -> i64 {
    const /*@fixed_local*/e: /*@in_fixed*/Node[2] = [Node { value: 1 }, Node { value: 2 }];
    mut n: i64 = a.length + /*@ref_ptr_array_use*/b.length + e[0].value + c.value;
    if (d.is_some()) { n += 1; }
    return n;
}

function main() -> i32 {
	const /*@tabbed*/tabbed: i64 = 1;
	/*@unused_tab*/const unused_t: i64 = /*@tabbed_use*/tabbed;
	const _s: string = "héllo wörld 😀"; const /*@after_text*/after: i64 = /*@tabbed_use2*/tabbed;
	const /*@dynamic_local*/nodes: Node[] = [];
	const refs: Node*[] = [];
	const n: i64 = arrays(/*@arrays_args*/nodes, &refs, null, Option::None);
	return /*@after_use*/after as i32 + n as i32;
}
