{
  "open": ["src/main.cryo"],
  "checks": [
    {"name": "definition from a tab-indented line", "method": "definition",
     "at": "src/main.cryo@tabbed_use", "expect": "src/main.cryo@tabbed"},
    {"name": "definition after text outside ASCII", "method": "definition",
     "at": "src/main.cryo@tabbed_use2", "expect": "src/main.cryo@tabbed"},
    {"name": "definition of a name declared after text outside ASCII", "method": "definition",
     "at": "src/main.cryo@after_use", "expect": "src/main.cryo@after_text"},
    {"name": "hover from a tab-indented line", "method": "hover",
     "at": "src/main.cryo@tabbed_use", "contains": ["tabbed", "i64"]},
    {"name": "a warning on a tab-indented line starts at its token", "method": "diagnostics",
     "file": "src/main.cryo",
     "expect": [{"code": "W0001", "at": "src/main.cryo@unused_tab"}]},
    {"name": "definition of the element of a dynamic array type", "method": "definition",
     "at": "src/main.cryo@in_dynamic", "expect": "src/main.cryo@node"},
    {"name": "definition of the element of a fixed array type", "method": "definition",
     "at": "src/main.cryo@in_fixed", "expect": "src/main.cryo@node"},
    {"name": "definition of the pointee of a pointer type", "method": "definition",
     "at": "src/main.cryo@in_pointer", "expect": "src/main.cryo@node"},
    {"name": "definition inside a reference to an array of pointers", "method": "definition",
     "at": "src/main.cryo@in_ref_ptr_array", "expect": "src/main.cryo@node"},
    {"name": "definition inside an optional array type", "method": "definition",
     "at": "src/main.cryo@in_optional_array", "expect": "src/main.cryo@node"},
    {"name": "hover on the element of a dynamic array type", "method": "hover",
     "at": "src/main.cryo@in_dynamic", "contains": ["Node"]}
  ]
}
