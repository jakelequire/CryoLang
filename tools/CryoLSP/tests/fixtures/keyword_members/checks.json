{
  "open": ["src/main.cryo"],
  "checks": [
    {"name": "hover on a method named by a keyword after `.` is the method, not the keyword",
     "method": "hover", "at": "src/main.cryo@delete_use",
     "contains": ["delete(", "amount: i32"], "excludes": ["## delete"]},
    {"name": "hover on a static method named by a keyword after `::` is the method, not the keyword",
     "method": "hover", "at": "src/main.cryo@while_use",
     "contains": ["while(value: i32) -> i32"], "excludes": ["## while"]},
    {"name": "hover on a field named by a keyword after `.` is the field, not the keyword",
     "method": "hover", "at": "src/main.cryo@match_use",
     "contains": ["match: i32"], "excludes": ["## match"]},
    {"name": "hover on a keyword-named method's declaration is the method, not the keyword",
     "method": "hover", "at": "src/main.cryo@delete_decl",
     "contains": ["delete(", "amount: i32"], "excludes": ["## delete"]},
    {"name": "go-to-definition from a keyword-named method's use reaches its declaration",
     "method": "definition", "at": "src/main.cryo@delete_use", "expect": "src/main.cryo@delete_decl"},
    {"name": "semantic tokens colour keyword-named members as the members they are",
     "method": "semanticTokens", "file": "src/main.cryo",
     "expect": {"src/main.cryo@delete_use": "method", "src/main.cryo@while_use": "method",
                "src/main.cryo@match_use": "property", "src/main.cryo@delete_decl": "method.declaration",
                "src/main.cryo@match_decl": "property.declaration"}},
    {"name": "completion after `.` offers the members named by keywords",
     "method": "completion", "at": "src/main.cryo@counter_members",
     "edit": {"file": "src/main.cryo", "from": "counter./*@delete_use*/delete(3);", "to": "counter./*^counter_members*/"},
     "includes": ["delete", "match"]}
  ]
}
