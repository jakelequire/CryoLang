namespace Main;

type struct Counter {
    /*@match_decl*/match: i32;

    /*@delete_decl*/delete(mut &this, amount: i32) -> i32 {
        this.match = this.match - amount;
        return this.match;
    }

    static /*@while_decl*/while(value: i32) -> i32 {
        return value * 2;
    }
}

function main() -> i32 {
    mut counter: Counter = Counter { match: 10 };
    const left: i32 = counter./*@delete_use*/delete(3);
    const doubled: i32 = Counter::/*@while_use*/while(left);
    return doubled - counter./*@match_use*/match - left;
}
