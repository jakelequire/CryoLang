# CryoLSP - Cryo-language LSP server.
#
# LSP 3.17 over JSON-RPC 2.0 over stdio. Drives the self-hosted Cryo
# compiler in `Lsp` mode for diagnostics, hover, go-to-definition, and
# completion. Depends on the compiler library so the AST + type arena +
# resolver are walkable in-process - spawning the binary per check
# would force a re-parse on every keystroke.

[project]
project_name = "cryolsp"
output_dir   = "build"
target_type  = "executable"
entry_point  = "src/main.cryo"

[compiler]
debug    = false
optimize = O2

# The compiler library transitively pulls in LLVM *and* libclang
# bindings (the latter via Compiler::Bindgen's C-header import engine).
# Even though the LSP only drives the frontend pipeline (no codegen,
# no bindgen), the linker still resolves every reference in the
# library, so we must mirror the compiler's per-OS link overlays here
# (see compiler/cryoconfig for the full rationale).  These sections
# MUST be kept in sync with the compiler's; a mismatch surfaces as
# `undefined reference to clang_*` / `LLVM*` at link time.
#
# NOTE: the Windows search path is repo-relative and the LSP lives one
# directory deeper than the compiler (tools/CryoLSP vs compiler), so it
# is `../../.toolchains/...` here versus `../.toolchains/...` there.
[link.unix]
system = ["LLVM-20"]
search = ["/usr/lib/llvm-20/lib"]
static = ["/usr/lib/llvm-20/lib/libclang-20.so.1"]

[link.windows]
system = ["LLVM-C", "clang"]
search = ["../../.toolchains/llvm-win/lib"]

[dependencies]
compiler = { path = "../../compiler", alias = "Compiler" }
