# cryosmith - a seeded generator of random, valid, deterministic Cryo
# programs for differential testing.
#
# Built by the pinned compiler (bin/cryo) against the tree's stdlib, and
# linked against the stdlib only: it writes program text and needs nothing
# from the compiler it helps to test.

[project]
project_name = "cryosmith"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]
debug    = false
optimize = O2
