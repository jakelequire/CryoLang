///! The program model CryoSmith builds before it prints anything.
///!
///! A `Program` is arenas of plain data: structures, fields, variables,
///! expressions, statements and functions, with one more holding runs of
///! indices (a call's arguments, a function's parameters, a struct literal's
///! fields).  A node names its children by index, and a block is a chain of
///! statements each naming the next, so no node owns another.

namespace cryosmith::program;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };

/// The type of a generated value.
public type enum ValueType {
    I8;
    I16;
    I32;
    I64;
    U8;
    U16;
    U32;
    U64;
    Boolean;
    /// What a function that returns nothing returns.
    Void;
    /// A generated struct, by its index in the program's structures.
    Record(i64);
}

implement enum ValueType {
    /// The integer types, narrowest first, signed before unsigned.
    public static integers() -> Array<ValueType> {
        mut all: Array<ValueType> = Array::<ValueType>::new();
        all.push(ValueType::I8);
        all.push(ValueType::I16);
        all.push(ValueType::I32);
        all.push(ValueType::I64);
        all.push(ValueType::U8);
        all.push(ValueType::U16);
        all.push(ValueType::U32);
        all.push(ValueType::U64);
        return all;
    }

    /// The type's name as a program spells it.
    public name(this) -> String {
        return match (this) {
            ValueType::I8            => { String::from_str(Str::new("i8")) }
            ValueType::I16           => { String::from_str(Str::new("i16")) }
            ValueType::I32           => { String::from_str(Str::new("i32")) }
            ValueType::I64           => { String::from_str(Str::new("i64")) }
            ValueType::U8            => { String::from_str(Str::new("u8")) }
            ValueType::U16           => { String::from_str(Str::new("u16")) }
            ValueType::U32           => { String::from_str(Str::new("u32")) }
            ValueType::U64           => { String::from_str(Str::new("u64")) }
            ValueType::Boolean       => { String::from_str(Str::new("boolean")) }
            ValueType::Void          => { String::from_str(Str::new("void")) }
            ValueType::Record(index) => { f"S{index}" }
        };
    }

    /// A number that is the same for two values exactly when they are the
    /// same type.
    public identity(this) -> i64 {
        return match (this) {
            ValueType::I8            => { 0 }
            ValueType::I16           => { 1 }
            ValueType::I32           => { 2 }
            ValueType::I64           => { 3 }
            ValueType::U8            => { 4 }
            ValueType::U16           => { 5 }
            ValueType::U32           => { 6 }
            ValueType::U64           => { 7 }
            ValueType::Boolean       => { 8 }
            ValueType::Void          => { 9 }
            ValueType::Record(index) => { 10 + index }
        };
    }

    /// The struct a record type names, or -1 for any other type.
    public structure(this) -> i64 {
        return match (this) {
            ValueType::Record(index) => { index }
            _                        => { -1 }
        };
    }

    /// The width in bits of an integer type; 0 for any other type.
    public width(&this) -> u64 {
        return match (&this) {
            ValueType::I8  => { 8 }
            ValueType::I16 => { 16 }
            ValueType::I32 => { 32 }
            ValueType::I64 => { 64 }
            ValueType::U8  => { 8 }
            ValueType::U16 => { 16 }
            ValueType::U32 => { 32 }
            ValueType::U64 => { 64 }
            _              => { 0 }
        };
    }

    /// Whether the type is a signed integer.
    public is_signed(&this) -> boolean {
        return match (&this) {
            ValueType::I8  => { true }
            ValueType::I16 => { true }
            ValueType::I32 => { true }
            ValueType::I64 => { true }
            _              => { false }
        };
    }

    /// Whether the type is an integer.
    public is_integer(&this) -> boolean { return this.width() != 0; }

    /// Whether the type is a generated struct.
    public is_record(&this) -> boolean { return this.structure() >= 0; }

    /// Whether the type is the same type as `other`.
    public same(&this, other: ValueType) -> boolean { return this.identity() == other.identity(); }

    /// Whether the language converts a value of this type to `wider`
    /// implicitly: to a wider integer of the same signedness, or from an
    /// unsigned integer to a wider signed one.
    public widens_to(&this, wider: ValueType) -> boolean {
        if (!this.is_integer() || !wider.is_integer()) { return false; }
        if (this.width() >= wider.width()) { return false; }
        return this.is_signed() == wider.is_signed() || !this.is_signed();
    }

    /// The largest value of an integer type, as a magnitude.
    public maximum(&this) -> u64 {
        const width: u64 = this.width();
        if (this.is_signed()) { return (1 << (width - 1)) - 1; }
        if (width == 64) { return u64::MAX; }
        return (1 << width) - 1;
    }
}

/// A unary operator.
public type enum UnaryOperator {
    /// `-x`, on a signed integer.
    Negate;
    /// `~x`, on an integer.
    Complement;
    /// `!x`, on a boolean.
    Not;
}

implement enum UnaryOperator {
    /// The operator as a program spells it.
    public symbol(&this) -> Str {
        return match (&this) {
            UnaryOperator::Negate     => { Str::new("-") }
            UnaryOperator::Complement => { Str::new("~") }
            UnaryOperator::Not        => { Str::new("!") }
        };
    }
}

/// A binary operator, arithmetic, bitwise, comparison or logical.
public type enum BinaryOperator {
    Add;
    Subtract;
    Multiply;
    Divide;
    Remainder;
    BitAnd;
    BitOr;
    BitXor;
    ShiftLeft;
    ShiftRight;
    Equal;
    NotEqual;
    Less;
    LessEqual;
    Greater;
    GreaterEqual;
    And;
    Or;
}

implement enum BinaryOperator {
    /// The operator as a program spells it.
    public symbol(&this) -> Str {
        return match (&this) {
            BinaryOperator::Add          => { Str::new("+") }
            BinaryOperator::Subtract     => { Str::new("-") }
            BinaryOperator::Multiply     => { Str::new("*") }
            BinaryOperator::Divide       => { Str::new("/") }
            BinaryOperator::Remainder    => { Str::new("%") }
            BinaryOperator::BitAnd       => { Str::new("&") }
            BinaryOperator::BitOr        => { Str::new("|") }
            BinaryOperator::BitXor       => { Str::new("^") }
            BinaryOperator::ShiftLeft    => { Str::new("<<") }
            BinaryOperator::ShiftRight   => { Str::new(">>") }
            BinaryOperator::Equal        => { Str::new("==") }
            BinaryOperator::NotEqual     => { Str::new("!=") }
            BinaryOperator::Less         => { Str::new("<") }
            BinaryOperator::LessEqual    => { Str::new("<=") }
            BinaryOperator::Greater      => { Str::new(">") }
            BinaryOperator::GreaterEqual => { Str::new(">=") }
            BinaryOperator::And          => { Str::new("&&") }
            BinaryOperator::Or           => { Str::new("||") }
        };
    }
}

/// An arithmetic operation written as a wrapping method call, defined for
/// every pair of values.
public type enum WrappingOperator {
    Add;
    Subtract;
    Multiply;
}

implement enum WrappingOperator {
    /// The method's name.
    public method(&this) -> Str {
        return match (&this) {
            WrappingOperator::Add      => { Str::new("wrapping_add") }
            WrappingOperator::Subtract => { Str::new("wrapping_subtract") }
            WrappingOperator::Multiply => { Str::new("wrapping_multiply") }
        };
    }
}

/// What an expression node is.  Indices name other nodes of the same
/// program: expressions, variables, fields, structures, functions, or a run
/// of the program's index lists.
public type enum ExpressionKind {
    /// An integer literal: its magnitude and whether it is negative.
    IntegerLiteral(u64, boolean);
    /// `true` or `false`.
    BooleanLiteral(boolean);
    /// The type's named limit: `T::MAX` when true, `T::MIN` when false.
    Limit(boolean);
    /// A read of a variable.
    Variable(i64);
    /// A unary operator and its operand.
    Unary(UnaryOperator, i64);
    /// A binary operator and its two operands.
    Binary(BinaryOperator, i64, i64);
    /// `receiver.wrapping_<operation>(argument)`.
    Wrapping(WrappingOperator, i64, i64);
    /// `operand as T`, `T` the node's own type.
    Cast(i64);
    /// A narrower operand where the node's type is wanted, converted
    /// implicitly; printed as the operand alone.
    Widen(i64);
    /// `if (condition) { a } else { b }`.
    Conditional(i64, i64, i64);
    /// A call of a free function or a static method: the function, the
    /// first argument's place in the index lists, and the argument count.
    Call(i64, i64, i64);
    /// `receiver.method(arguments)`: the receiver, a place; the method; the
    /// first argument's place in the index lists, and the argument count.
    MethodCall(i64, i64, i64, i64);
    /// `base.field`: the base expression and the field.
    Field(i64, i64);
    /// A struct literal: the structure, the first entry's place in the index
    /// lists, and the number of fields written.  Each entry is two indices:
    /// the field, then its value.
    StructureLiteral(i64, i64, i64);
}

/// One expression: what it is and its type.
public type struct ExpressionNode {
    /// What the expression is.
    public kind: ExpressionKind;
    /// The expression's type.
    public value_type: ValueType;
}

/// How a variable is named and what may be done to it.
public type enum VariableRole {
    /// The program's global hash state, `observed`.
    Observed;
    /// A function's parameter, `p<N>`: read only.
    Parameter;
    /// A local, `v<N>`.
    Local;
    /// A loop counter, `n<N>`: read only.  No name a program declares is
    /// spelled like a type (`i8`, `f32`): a value of that name would stand
    /// in front of the type in `i8::MIN`.
    Counter;
    /// A method's receiver, `this`: its fields may be written when the
    /// method takes `mut &this`, and it is never assigned whole.
    Receiver;
}

/// A named value.
public type struct Variable {
    /// How it is named and what may be done to it.
    public role: VariableRole;
    /// The number in its name, counted per function and role.
    public number: i64;
    /// Its type.
    public value_type: ValueType;
    /// Whether it may be written: declared `mut`, or a `mut &this`.
    public mutable: boolean;
}

/// One field of a generated struct, `f<N>`.
public type struct Field {
    /// The number in its name, counted per struct.
    public number: i64;
    /// Its type: an integer, `boolean`, or an earlier struct.
    public value_type: ValueType;
    /// Its default value, an expression, or -1 for none.
    public default_value: i64;
}

/// One generated struct, `S<N>`: its fields are a run of the program's
/// fields, and its methods are the functions it owns.
public type struct Structure {
    /// The number in its name.
    public number: i64;
    /// The first field's place in the program's fields.
    public first_field: i64;
    /// How many fields it has.
    public field_count: i64;
}

/// How a function takes its receiver.
public type enum Receiver {
    /// A free function: no receiver.
    Free;
    /// A static method: called through its struct, no receiver.
    Static;
    /// `&this`: reads the receiver.
    Shared;
    /// `mut &this`: may write the receiver's fields.
    Exclusive;
}

/// The three loop shapes, each counting a counter from 0 to a trip count.
public type enum LoopShape {
    /// `for (mut i: T = 0; i < K; i = i + 1) { ... }`.
    Counted;
    /// `mut i: T = 0; while (i < K) { i = i + 1; ... }`: the increment
    /// comes first, so a `continue` cannot skip it.
    Conditioned;
    /// `for (i in 0..K) { ... }`.
    Ranged;
}

/// What a statement node is.  A block is the index of its first statement,
/// or -1 when it is empty.
public type enum StatementKind {
    /// Declare a variable with its initial value.
    Declare(i64, i64);
    /// `place = value`: a place is a variable read or a field of one.
    Assign(i64, i64);
    /// `place op= value`.
    Compound(BinaryOperator, i64, i64);
    /// Fold a value into `observed`.
    Observe(i64);
    /// An expression evaluated for its effect: a call returning nothing.
    Evaluate(i64);
    /// `if (condition) { then } else { otherwise }`; an empty `otherwise`
    /// prints no `else`.
    Branch(i64, i64, i64);
    /// A loop: its shape, counter, trip count and body.
    Loop(LoopShape, i64, u64, i64);
    /// `if (condition) { break; }` when true, `continue` when false.
    Exit(boolean, i64);
    /// `if (condition) { return value; }`; a value of -1 returns nothing.
    ReturnIf(i64, i64);
    /// `return value;`.
    Return(i64);
    /// `main`'s end: print the hash line and return 0.
    Finish;
}

/// One statement and the statement after it in its block, or -1.
public type struct StatementNode {
    /// What the statement is.
    public kind: StatementKind;
    /// The next statement of the block, or -1.
    public next: i64;
}

/// One function: a free function, `main`, or a method of a struct.
public type struct Function {
    /// The number in its name: `h<N>`, or `m<N>` for a method; `main` has
    /// none.
    public number: i64;
    /// Whether this is `main`.
    public is_main: boolean;
    /// The struct that owns a method, or -1 for a free function.
    public owner: i64;
    /// How it takes its receiver.
    public receiver: Receiver;
    /// The first parameter's place in the index lists.
    public first_parameter: i64;
    /// How many parameters it takes, not counting the receiver.
    public parameter_count: i64;
    /// What it returns.
    public returns: ValueType;
    /// The first statement of its body.
    public body: i64;
    /// The most work one call can do, in the cost model's units.
    public cost: u64;
}

/// A whole generated program.
public type struct Program {
    /// Every generated struct, in the order they are printed.
    public structures: Array<Structure>;
    /// Every struct's fields, each struct's a run.
    public fields: Array<Field>;
    /// Every variable, `observed` first.
    public variables: Array<Variable>;
    /// Every expression node.
    public expressions: Array<ExpressionNode>;
    /// Every statement node.
    public statements: Array<StatementNode>;
    /// Runs of indices: call arguments, function parameters and struct
    /// literal entries.
    public lists: Array<i64>;
    /// The functions in the order they were generated: every struct's
    /// methods, then the free functions, `main` last.  A function calls
    /// only functions before it.
    public functions: Array<Function>;

    /// A program holding only `observed`.
    public static new() -> Program {
        mut program: Program = Program {
            structures:  Array::<Structure>::new(),
            fields:      Array::<Field>::new(),
            variables:   Array::<Variable>::new(),
            expressions: Array::<ExpressionNode>::new(),
            statements:  Array::<StatementNode>::new(),
            lists:       Array::<i64>::new(),
            functions:   Array::<Function>::new(),
        };
        program.variables.push(Variable { role: VariableRole::Observed, number: 0, value_type: ValueType::U64, mutable: true });
        return program;
    }

    /// The index of `observed`.
    public static observed() -> i64 { return 0; }

    /// Add an expression node; its index.
    public expression(mut &this, kind: ExpressionKind, value_type: ValueType) -> i64 {
        this.expressions.push(ExpressionNode { kind: kind, value_type: value_type });
        return this.expressions.length() - 1;
    }

    /// Add a statement node with no successor; its index.
    public statement(mut &this, kind: StatementKind) -> i64 {
        this.statements.push(StatementNode { kind: kind, next: -1 });
        return this.statements.length() - 1;
    }

    /// Add a variable; its index.
    public variable(mut &this, variable: Variable) -> i64 {
        this.variables.push(variable);
        return this.variables.length() - 1;
    }

    /// Chain `statements` into a block, in order; the block's first
    /// statement, or -1 for none.
    public block(mut &this, statements: &Array<i64>) -> i64 {
        mut index: i64 = statements.length() - 1;
        mut next: i64 = -1;
        while (index >= 0) {
            const current: i64 = statements.get(index).unwrap();
            mut node: StatementNode = this.statements.get(current).unwrap();
            node.next = next;
            this.statements.set(current, node);
            next = current;
            index = index - 1;
        }
        return next;
    }

    /// The expression at `index`.
    public expression_at(&this, index: i64) -> ExpressionNode { return this.expressions.get(index).unwrap(); }

    /// The statement at `index`.
    public statement_at(&this, index: i64) -> StatementNode { return this.statements.get(index).unwrap(); }

    /// The variable at `index`.
    public variable_at(&this, index: i64) -> Variable { return this.variables.get(index).unwrap(); }

    /// The function at `index`.
    public function_at(&this, index: i64) -> Function { return this.functions.get(index).unwrap(); }

    /// The structure at `index`.
    public structure_at(&this, index: i64) -> Structure { return this.structures.get(index).unwrap(); }

    /// The field at `index`.
    public field_at(&this, index: i64) -> Field { return this.fields.get(index).unwrap(); }

    /// The index-list entry at `index`.
    public list_at(&this, index: i64) -> i64 { return this.lists.get(index).unwrap(); }

    /// Whether a value of type `from` holds a field, directly or through
    /// a nested struct, of type `target`.
    public reaches(&this, from: ValueType, target: ValueType) -> boolean {
        const index: i64 = from.structure();
        if (index < 0) { return false; }
        const declared: Structure = this.structure_at(index);
        mut field: i64 = declared.first_field;
        while (field < declared.first_field + declared.field_count) {
            const field_type: ValueType = this.field_at(field).value_type;
            if (field_type.same(target) || this.reaches(field_type, target)) { return true; }
            field = field + 1;
        }
        return false;
    }
}
