///! Captures: what a closure may capture, so the capture is a copy made
///! where the closure is made and nothing it holds can outlive what it was
///! taken from.
///!
///! A value of a `Copy` type is copied into the closure, whether or not the
///! closure is written `move`, and every scalar, struct and enum a program
///! has is `Copy`; so a captured value is the closure's own, and a later
///! assignment of the variable it was taken from does not reach it.  A
///! closure captures only such values: a parameter, a local, a loop counter
///! or a `match` binding.  `this` is a reference, and a closure holding it
///! would hold a view of the receiver while the method goes on writing
///! it; a closure local is a callable, not a value; `observed` is a global,
///! which a closure body reads where it stands rather than capturing.  A
///! closure that captures is a value of its own type, held by a local with
///! no annotation, since a variable of function type holds only a function
///! pointer.

namespace cryosmith::guarantees::capture;

import cryosmith::model::{ ValueType, Variable, VariableRole };

/// The rule a closure's captures are chosen by.
public type struct Capture {
    /// Whether a closure may capture `variable`: a parameter, a local, a
    /// counter or a binding, holding a scalar, a struct or an enum value.
    public static admits(variable: Variable) -> boolean {
        const copied: boolean = variable.value_type.is_integer() || variable.value_type.same(ValueType::Boolean)
            || variable.value_type.is_record() || variable.value_type.is_enumeration();
        return copied && match (variable.role) {
            VariableRole::Parameter => { true }
            VariableRole::Local     => { true }
            VariableRole::Counter   => { true }
            VariableRole::Binding   => { true }
            _                       => { false }
        };
    }
}
