///! The rules that make every generated program valid, terminating and
///! deterministic, each stated once: generation follows them, the printer
///! writes the hash they define, and the corpus check reads it.
///!
///! Imports the model only.
///!
///!   arithmetic   `ArithmeticGuard`: the masks that keep plain `+`, `-`,
///!                `*`, negation, shifts and division defined under both
///!                overflow rules, and the largest literal written
///!   termination  `CostBudget` and the loop limits: every call does a
///!                bounded amount of work, known when it is generated
///!   observation  `Observation`: the hash every value is folded into, and
///!                the one line a program prints

namespace cryosmith::guarantees;

module {
    guarantees::arithmetic;
    guarantees::termination;
    guarantees::observation;
}

export cryosmith::guarantees::arithmetic::{ ArithmeticGuard };
export cryosmith::guarantees::termination::{ CostBudget, MOST_LOOPS, MOST_TRIPS };
export cryosmith::guarantees::observation::{ Observation };
