///! `match`: the rule that makes every generated `match` exhaustive and
///! every arm reachable.
///!
///! The compiler refuses a `match` that leaves a variant uncovered, and an
///! arm after one that matches every value can never be chosen.  So a
///! generated `match` writes an arm for some of its enum's variants, each
///! at most once and in any order, and then `_` exactly when a variant is
///! left; it never writes `_` when every variant has its own arm, nor any
///! arm after `_`.

namespace cryosmith::guarantees::exhaustiveness;

import std::collections::array::{ Array };

/// The rule a `match`'s arms are generated by.
public type struct Exhaustiveness {
    /// What `_` is among a `match`'s patterns.
    public static wildcard() -> i64 { return -1; }

    /// The patterns of a `match` over an enum of `variant_count` variants
    /// whose own arms are `covered`, distinct variant numbers in the order
    /// written: those, then `_` when some variant is not among them.
    public static patterns(covered: &Array<i64>, variant_count: i64) -> Array<i64> {
        mut patterns: Array<i64> = Array::<i64>::new();
        for (variant in covered.iter()) { patterns.push(variant); }
        if (covered.length() < variant_count) { patterns.push(Exhaustiveness::wildcard()); }
        return patterns;
    }
}
