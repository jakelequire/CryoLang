///! The hash a program folds every value it computes into, and the one line
///! it prints.
///!
///! `observed` is a global `u64`.  `mix` is FNV-1a's step plus a constant,
///! so folding the state into itself does not stick at zero.  An integer is
///! folded as `(e as u64)`, a boolean as 1 or 2, a struct field by field.
///! The program prints `cryosmith-hash <decimal u64>` and exits 0; two
///! builds of one program that print different lines disagree on a value.

namespace cryosmith::guarantees::observation;

import std::collections::str::{ Str };

/// The hash state's definition.
public type struct Observation {
    /// The state's starting value: FNV-1a's offset basis.
    public static initial_state() -> u64 { return 14695981039346656037; }

    /// What `mix` multiplies by: FNV-1a's 64-bit prime.
    public static multiplier() -> u64 { return 1099511628211; }

    /// What `mix` adds after multiplying, so a zero state does not stay
    /// zero.
    public static increment() -> u64 { return 2654435769; }

    /// What the program's one output line starts with, before the hash.
    public static hash_line_prefix() -> Str { return Str::new("cryosmith-hash "); }
}
