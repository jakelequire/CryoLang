///! Overload sets: the rule that keeps every call of an overloaded name
///! choosing exactly one function.
///!
///! A call of an overloaded name selects the overload its arguments fit,
///! and no implicit conversion makes an argument fit: a narrower integer is
///! not widened, and a literal where the overloads' parameters differ is an
///! `i32`.  So two members of one set differ in their parameter count or in
///! the type of a parameter, and every argument of a call of an overloaded
///! name has exactly its parameter's type and reads a name, never a bare
///! literal or one made only of literals.  Then the arguments' types are
///! one member's parameter types and no other's.

namespace cryosmith::guarantees::overloading;

import std::collections::array::{ Array };

import cryosmith::model::{ ValueType };

/// The rule an overload set is generated by.
public type struct Overloading {
    /// Whether a call whose arguments have exactly the types `first` can
    /// never fit the parameters `second`: the counts differ, or some
    /// position's types do.
    public static distinguishes(first: &Array<ValueType>, second: &Array<ValueType>) -> boolean {
        if (first.length() != second.length()) { return true; }
        mut position: i64 = 0;
        while (position < first.length()) {
            if (!first.get(position).unwrap().same(second.get(position).unwrap())) { return true; }
            position = position + 1;
        }
        return false;
    }
}
