///! Taking things out of a generated program for a reducer (section 9, item
///! 8 of the design): what the printed program names, what may therefore
///! be taken out, and taking it.  The generator builds the whole program
///! first; omissions apply to its model before it is printed, so every
///! program a reducer tries is still one CryoSmith vouches for.
///!
///!   references  `References`: what the printed part of a program names,
///!               and where each printed statement is linked from
///!   omitter     `Omitter`: the candidates, and taking one out
///!
///! Imports the model alone.

namespace cryosmith::reduce;

module {
    reduce::references;
    reduce::omitter;
}

export cryosmith::reduce::omitter::{ Omitter };
