///! An audit of the model's references, reading every function's uses
///! (`UseWalk`): no local holds a reference; within one statement, a
///! variable borrowed exclusively or an exclusive reference passed on is
///! the only use of that variable, and one moved is not also borrowed or
///! passed on there - an assignment's target aside, which is written once
///! its value is made; and a value a function returns that is a reference
///! borrows no variable of the function, so it refers only to what the
///! function's reference parameters do.

namespace cryosmith::selftest::loans;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::result::{ Result };

import cryosmith::configuration::{ GenerationOptions };
import cryosmith::generate::{ Generator };
import cryosmith::model::{ Function, Program, Variable, VariableRole };
import cryosmith::selftest::runner::{ SelfTest };
import cryosmith::selftest::uses::{ Use, UseKind, UseWalk };

/// How many programs the loan audit reads.
const LOAN_AUDITED_PROGRAMS: u64 = 200;

/// The audit of one program's references.
internal type struct LoanAudit {
    /// The number of borrows and references passed on the program makes,
    /// each within the rules; or the first that breaks one.
    internal static check(program: &Program) -> Result<i64, String> {
        for (variable in program.variables.iter()) {
            const local: boolean = match (variable.role) {
                VariableRole::Local => { true }
                _                   => { false }
            };
            if (local && variable.value_type.is_reference()) { return Result::Err(String::from_str(Str::new("a local holds a reference"))); }
        }
        mut lent: i64 = 0;
        mut index: i64 = 0;
        while (index < program.functions.length()) {
            const defined: Function = program.function_at(index);
            match (LoanAudit::function(defined.returns.is_reference(), UseWalk::of(program, defined))) {
                Result::Ok(count)   => { lent = lent + count; }
                Result::Err(reason) => { return Result::Err(f"function {index}: {reason.as_str()}"); }
            }
            index = index + 1;
        }
        return Result::Ok(lent);
    }

    /// The loans in one function's `uses`, or the first rule broken.
    private static function(returns_reference: boolean, uses: Array<Use>) -> Result<i64, String> {
        mut lent: i64 = 0;
        mut returning: boolean = false;
        mut statement: Array<Use> = Array::<Use>::new();
        for (used in uses.iter()) {
            match (used.kind) {
                UseKind::StatementStarted => {
                    const verdict: Result<i64, String> = LoanAudit::statement(&statement);
                    if (verdict.is_err()) { return verdict; }
                    lent = lent + verdict.unwrap();
                    statement.clear();
                }
                UseKind::ReturnStarted => { returning = true; }
                UseKind::ReturnEnded => { returning = false; }
                UseKind::SharedBorrow => {
                    if (returning && returns_reference) { return Result::Err(f"a returned reference borrows variable {used.variable}"); }
                    statement.push(used);
                }
                UseKind::ExclusiveBorrow => {
                    if (returning && returns_reference) { return Result::Err(f"a returned reference borrows variable {used.variable}"); }
                    statement.push(used);
                }
                _ => { statement.push(used); }
            }
        }
        const verdict: Result<i64, String> = LoanAudit::statement(&statement);
        if (verdict.is_err()) { return verdict; }
        return Result::Ok(lent + verdict.unwrap());
    }

    /// The loans one statement's `uses` make, or the first rule broken: a
    /// variable lent exclusively or moved has no other use there but an
    /// assignment to it.
    private static statement(uses: &Array<Use>) -> Result<i64, String> {
        mut lent: i64 = 0;
        for (used in uses.iter()) {
            const sole: boolean = match (used.kind) {
                UseKind::ExclusiveBorrow => { true }
                UseKind::ExclusivePass   => { true }
                UseKind::Moved           => { true }
                _                        => { false }
            };
            const lends: boolean = match (used.kind) {
                UseKind::SharedBorrow => { true }
                UseKind::SharedPass   => { true }
                _                     => { sole && !LoanAudit::is_move(used.kind) }
            };
            if (lends) { lent = lent + 1; }
            if (!sole) { continue; }
            mut others: i64 = 0;
            for (other in uses.iter()) {
                if (other.variable != used.variable) { continue; }
                match (other.kind) {
                    UseKind::Assigned => { }
                    UseKind::Declared => { }
                    _ => { others = others + 1; }
                }
            }
            if (others > 1) { return Result::Err(f"variable {used.variable} is lent exclusively or moved and used again in one statement"); }
        }
        return Result::Ok(lent);
    }

    /// Whether `kind` is a move.
    private static is_move(kind: UseKind) -> boolean {
        return match (kind) {
            UseKind::Moved => { true }
            _              => { false }
        };
    }
}

implement struct SelfTest {
    /// Every reference keeps the rules, and the audit finds borrows to
    /// check.
    internal loan_audit(mut &this) -> void {
        mut lent: i64 = 0;
        mut seed: u64 = 1;
        while (seed <= LOAN_AUDITED_PROGRAMS) {
            const program: Program = Generator::generate(GenerationOptions::new(seed));
            match (LoanAudit::check(&program)) {
                Result::Ok(count)   => { lent = lent + count; }
                Result::Err(reason) => { this.expect(false, f"seed {seed}: {reason.as_str()}"); }
            }
            seed = seed + 1;
        }
        this.expect(lent > 0, String::from_str(Str::new("the loan audit found no borrow")));
    }
}
