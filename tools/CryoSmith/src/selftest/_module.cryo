///! `cryosmith selftest`: the generator's guarantees that need no compiler,
///! checked in process.
///!
///! - The same seed and options give the same bytes; different seeds give
///!   different programs.
///! - A function's text does not depend on how many functions follow it.
///! - Feature lists read and print canonically, and refuse an unknown name.
///! - A disabled feature's forms never appear, and each form is seen with
///!   its feature enabled, so the search can find what it looks for.
///! - The static audit passes every program and refuses every planted one
///!   that divides.
///! - The bound audit passes every program, and refuses a program printed
///!   without its `Copy` bounds exactly when a generic definition in it
///!   uses a `T` value more than once.
///! - The binding audit finds every binding of a `match` expression's arm
///!   folded into an integer arm's value or observed by any other arm.
///! - The capture audit finds every closure reading only what it captures
///!   or declares, and observing every value it captures.
///!
///! It counts its checks and refuses a run that made none.
///!
///!   runner        `SelfTest`: running the checks, counting, reporting
///!   determinism   same seed, same bytes; the function prefix property
///!   features      feature lists and feature switches
///!   audit         the static audit of printed text, and its check
///!   copy_bounds   the audit of generic signatures' `Copy` bounds
///!   bindings      the audit of the model's `match` bindings
///!   observations  the audit of what an observation folds in
///!   captures      the audit of the model's closures and their captures
///!
///! Imports `generate`, `emit`, `configuration` and `model`.

namespace cryosmith::selftest;

module {
    selftest::runner;
    selftest::determinism;
    selftest::features;
    selftest::audit;
    selftest::copy_bounds;
    selftest::bindings;
    selftest::observations;
    selftest::captures;
}

export cryosmith::selftest::runner::{ SelfTest };
