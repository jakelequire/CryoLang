///! An audit of the model's moves, reading every function's uses in the
///! order its text is printed (`UseWalk`): a value is moved only out of a
///! variable of an owned type, nothing names the variable after the move -
///! not a read, an assignment, a borrow or a second move - and no variable
///! is moved inside a loop it was declared outside, which would move it
///! again on the next trip.  The printed order is stricter than the order
///! the program runs in: a move in an `if`'s first branch and a read in its
///! second are refused here, as the generator never writes them.

namespace cryosmith::selftest::moves;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::result::{ Result };

import cryosmith::configuration::{ GenerationOptions };
import cryosmith::generate::{ Generator };
import cryosmith::model::{ Program };
import cryosmith::selftest::runner::{ SelfTest };
import cryosmith::selftest::uses::{ Use, UseKind, UseWalk };

/// How many programs the move audit reads.
const MOVE_AUDITED_PROGRAMS: u64 = 200;

/// The audit of one program's moves.
internal type struct MoveAudit {
    /// The number of moves the program makes, each within the rules; or
    /// the first that breaks one.
    internal static check(program: &Program) -> Result<i64, String> {
        mut moves: i64 = 0;
        mut index: i64 = 0;
        while (index < program.functions.length()) {
            match (MoveAudit::function(program, UseWalk::of(program, program.function_at(index)))) {
                Result::Ok(count)   => { moves = moves + count; }
                Result::Err(reason) => { return Result::Err(f"function {index}: {reason.as_str()}"); }
            }
            index = index + 1;
        }
        return Result::Ok(moves);
    }

    /// The moves in one function's `uses`, or the first rule broken.
    private static function(program: &Program, uses: Array<Use>) -> Result<i64, String> {
        mut declared: Array<i64> = Array::<i64>::new();
        mut loop_marks: Array<i64> = Array::<i64>::new();
        mut moved: Array<i64> = Array::<i64>::new();
        for (used in uses.iter()) {
            const variable: i64 = used.variable;
            match (used.kind) {
                UseKind::Declared => { declared.push(variable); }
                UseKind::LoopEntered => { loop_marks.push(declared.length()); }
                UseKind::LoopLeft => { loop_marks.truncate(loop_marks.length() - 1); }
                UseKind::Moved => {
                    if (moved.contains(&variable)) { return Result::Err(f"variable {variable} is moved twice"); }
                    if (!program.variable_at(variable).value_type.is_owned()) { return Result::Err(f"variable {variable} is moved but holds no owned value"); }
                    if (loop_marks.length() > 0) {
                        const mark: i64 = loop_marks.get(loop_marks.length() - 1).unwrap();
                        mut position: i64 = 0;
                        while (position < mark) {
                            if (declared.get(position).unwrap() == variable) {
                                return Result::Err(f"variable {variable} is moved inside a loop it was declared outside");
                            }
                            position = position + 1;
                        }
                    }
                    moved.push(variable);
                }
                UseKind::StatementStarted => { }
                UseKind::ReturnStarted => { }
                UseKind::ReturnEnded => { }
                _ => {
                    if (moved.contains(&variable)) { return Result::Err(f"variable {variable} is named after its value was moved out"); }
                }
            }
        }
        return Result::Ok(moved.length());
    }
}

implement struct SelfTest {
    /// Every move keeps the rules, and the audit finds moves to check.
    internal move_audit(mut &this) -> void {
        mut moves: i64 = 0;
        mut seed: u64 = 1;
        while (seed <= MOVE_AUDITED_PROGRAMS) {
            const program: Program = Generator::generate(GenerationOptions::new(seed));
            match (MoveAudit::check(&program)) {
                Result::Ok(count)   => { moves = moves + count; }
                Result::Err(reason) => { this.expect(false, f"seed {seed}: {reason.as_str()}"); }
            }
            seed = seed + 1;
        }
        this.expect(moves > 0, String::from_str(Str::new("the move audit found no move")));
    }
}
