///! An audit of trait methods' default bodies, read from the printed text:
///! every call a default body makes on `this` names a method numbered below
///! its own, a method its trait or a supertrait declared earlier, so no
///! default calls itself or a later default that could call it back.  It
///! reads the text, not the model, so it does not share the generator's
///! mistake about which methods a default may call.

namespace cryosmith::selftest::defaults;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };

import cryosmith::configuration::{ GenerationOptions };
import cryosmith::selftest::runner::{ SelfTest };

/// How many programs the default audit reads.
const DEFAULT_AUDITED_PROGRAMS: u64 = 200;

/// The audit of one program's default bodies.
internal type struct DefaultAudit {
    /// The number of calls on `this` the default bodies in `text` make,
    /// each naming an earlier method; or the first that does not.  A
    /// default body is a definition at indent 4 inside a `type trait`
    /// block, `    t2(&this, p0: u8) -> i32 {`, up to its `    }`.
    internal static check(text: Str) -> Result<i64, String> {
        mut checked: i64 = 0;
        mut in_trait: boolean = false;
        mut current: i64 = -1;
        for (line in text.lines()) {
            if (line.starts_with(&Str::new("type trait "))) {
                in_trait = true;
            } else if (line == Str::new("}")) {
                in_trait = false;
                current = -1;
            } else if (in_trait && line.starts_with(&Str::new("    t")) && line.ends_with(&Str::new(" {"))) {
                current = DefaultAudit::number_at(line, 5);
            } else if (line == Str::new("    }")) {
                current = -1;
            } else if (current >= 0) {
                const opening: Str = Str::new("this.t");
                mut rest: Str = line;
                mut at: Option<i64> = rest.find(&opening);
                while (at.is_some()) {
                    const called: i64 = DefaultAudit::number_at(rest, at.unwrap() + opening.length());
                    if (called < 0 || called >= current) {
                        return Result::Err(f"the default body of t{current} calls t{called} on `this`: `{line.trim()}`");
                    }
                    checked = checked + 1;
                    rest = rest.byte_substring(at.unwrap() + opening.length(), rest.length());
                    at = rest.find(&opening);
                }
            }
        }
        return Result::Ok(checked);
    }

    /// The decimal number written at byte `start` of `text`, or -1 when no
    /// digit is there.
    private static number_at(text: Str, start: i64) -> i64 {
        mut end: i64 = start;
        while (end < text.length() && text.byte_at(end).unwrap() >= '0' as u8 && text.byte_at(end).unwrap() <= '9' as u8) {
            end = end + 1;
        }
        return match (i64::try_from(text.byte_substring(start, end))) {
            Result::Ok(number) => { number }
            Result::Err(_)     => { -1 }
        };
    }
}

implement struct SelfTest {
    /// Every call a default body makes on `this` names an earlier method,
    /// and the audit finds such calls to check.
    internal default_audit(mut &this) -> void {
        mut checked: i64 = 0;
        mut seed: u64 = 1;
        while (seed <= DEFAULT_AUDITED_PROGRAMS) {
            const text: String = SelfTest::program(GenerationOptions::new(seed));
            match (DefaultAudit::check(text.as_str())) {
                Result::Ok(count)   => { checked = checked + count; }
                Result::Err(reason) => { this.expect(false, f"seed {seed}: {reason.as_str()}"); }
            }
            seed = seed + 1;
        }
        this.expect(checked > 0, String::from_str(Str::new("the default audit found no call on `this` in a default body")));
    }
}
