///! Feature lists and feature switches: a list reads back canonically, and a
///! feature's forms appear exactly when it is enabled.

namespace cryosmith::selftest::features;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };

import cryosmith::configuration::{ Feature, FeatureSet, GenerationOptions };
import cryosmith::model::{ ExpressionKind, Program };
import cryosmith::selftest::runner::{ SelfTest };

/// How many programs each feature switch is checked over.
const SWITCH_PROGRAMS: u64 = 40;

/// How many programs a switch for a rarely drawn form is checked over: a
/// `?` choosing between a variant and its sibling.
const RARE_SWITCH_PROGRAMS: u64 = 200;

implement struct SelfTest {
    /// `default` and the canonical list read as the default set, a removal
    /// removes exactly its feature, and an unknown name is refused.
    internal feature_lists(mut &this) -> void {
        const defaults: String = FeatureSet::default_set().canonical();
        match (FeatureSet::parse(Str::new("default"))) {
            Result::Ok(set) => { this.expect(set.canonical().as_str() == defaults.as_str(), f"`default` reads as {set.canonical().as_str()}"); }
            Result::Err(reason) => { this.expect(false, f"`default` is refused: {reason.as_str()}"); }
        }
        match (FeatureSet::parse(defaults.as_str())) {
            Result::Ok(set) => { this.expect(set.canonical().as_str() == defaults.as_str(), String::from_str(Str::new("the canonical list does not read back as itself"))); }
            Result::Err(reason) => { this.expect(false, f"the canonical list is refused: {reason.as_str()}"); }
        }
        match (FeatureSet::parse(Str::new("default,no-shifts"))) {
            Result::Ok(set) => {
                this.expect(!set.has(Feature::Shifts) && set.has(Feature::Division), String::from_str(Str::new("`default,no-shifts` does not remove exactly shifts")));
            }
            Result::Err(reason) => { this.expect(false, f"`default,no-shifts` is refused: {reason.as_str()}"); }
        }
        this.expect(FeatureSet::parse(Str::new("default,bogus")).is_err(), String::from_str(Str::new("an unknown feature is accepted")));
    }

    /// Each switchable feature: with it on, one of its spellings appears in
    /// some program; with it off, none appears in any.
    internal feature_switches(mut &this) -> void {
        this.switch(Feature::Wrapping, [Str::new(".wrapping_"), Str::new(".wrapping_")]);
        this.switch(Feature::Shifts, [Str::new(" << "), Str::new(" >> ")]);
        this.switch(Feature::Division, [Str::new(" / "), Str::new(" % ")]);
        this.switch(Feature::Guarded, [Str::new(" * "), Str::new(" * ")]);
        this.switch(Feature::Bitwise, [Str::new(" ^ "), Str::new("(~")]);
        this.switch(Feature::Loops, [Str::new("for ("), Str::new("while (")]);
        this.switch(Feature::LoopExits, [Str::new("{ break; }"), Str::new("{ continue; }")]);
        this.switch(Feature::EarlyReturns, [Str::new(") { return "), Str::new(") { return; }")]);
        this.switch(Feature::IfExpressions, [Str::new("(if ("), Str::new("(if (")]);
        this.switch(Feature::Booleans, [Str::new(" && "), Str::new(" || ")]);
        this.switch(Feature::Structs, [Str::new("type struct S0 {"), Str::new("S0 { f")]);
        this.switch(Feature::Generics, [Str::new("<T>(p0: T, p1: T"), Str::new(") -> T where T: Eq + Copy {")]);
        this.switch(Feature::Generics, [Str::new("g0::<"), Str::new("g0::<")]);
        this.switch(Feature::GenericStructs, [Str::new("type struct B0<T> {"), Str::new("type struct B0<T> {")]);
        this.switch(Feature::GenericStructs, [Str::new("B0::<"), Str::new("B1::<")]);
        this.switch(Feature::InferredTypeArguments, [Str::new("g0("), Str::new("B0 {")]);
        this.switch(Feature::InferredTypeArguments, [Str::new("::<_>"), Str::new("::<_>")]);
        this.switch(Feature::GenericMethods, [Str::new("static m0(p0: T"), Str::new("static m1(p0: T")]);
        this.switch(Feature::GenericMethods, [Str::new(">::m0("), Str::new(">::m1(")]);
        this.switch(Feature::Enums, [Str::new("type enum E0 {"), Str::new("type enum E0 {")]);
        this.switch(Feature::Enums, [Str::new("(match ("), Str::new("(match (")]);
        this.switch(Feature::Enums, [Str::new(" => {\n"), Str::new("    _ => ")]);
        this.switch(Feature::EnumPayloads, [Str::new("    V1("), Str::new("    V2(")]);
        this.switch(Feature::EnumPayloads, [Str::new("(b0"), Str::new("(b1")]);
        this.switch(Feature::EnumPayloads, [Str::new("mix(2, "), Str::new("mix(3, ")]);
        this.switch(Feature::GenericEnums, [Str::new("type enum G0<T> {"), Str::new("type enum G0<T> {")]);
        this.switch(Feature::GenericEnums, [Str::new("G0::<"), Str::new(": G0<")]);
        this.switch(Feature::NestedPatterns, [Str::new("(_, "), Str::new(", _)")]);
        this.switch(Feature::NestedPatterns, [Str::new("V0(E0::"), Str::new("V1(E0::")]);
        this.switch(Feature::Closures, [Str::new("(q0: "), Str::new(" = () -> ")]);
        this.switch(Feature::FunctionValues, [Str::new(") -> ("), Str::new(")(")]);
        this.switch(Feature::GenericClosures, [Str::new("(q0: T"), Str::new(") -> T { ")]);
        this.switch(Feature::CallableBounds, [Str::new("<T, F>("), Str::new(", F: (")]);
        this.switch(Feature::Traits, [Str::new("type trait Tr0 {"), Str::new("implement trait Tr0 for struct S")]);
        this.switch(Feature::Traits, [Str::new(".t0("), Str::new(".t1(")]);
        this.switch(Feature::TraitBounds, [Str::new("function k0<T"), Str::new("where T: Tr")]);
        this.switch(Feature::TraitObjects, [Str::new(": virtual &Tr0"), Str::new(": virtual &Tr1")]);
        this.switch(Feature::TraitDefaults, [Str::new(";\n\n    t"), Str::new(";\n\n    t")]);
        this.switch(Feature::Supertraits, [Str::new("type trait Tr1 : Tr0 {"), Str::new("type trait Tr1 : Tr0 {")]);
        this.switch(Feature::EnumImplementations, [Str::new(" for enum E"), Str::new("match (this) {")]);
        this.switch(Feature::Drops, [Str::new("mem::drop(v"), Str::new("&(D")]);
        this.switch(Feature::References, [Str::new("(p0: &D"), Str::new("(p0: mut &D")]);
        this.switch(Feature::Moves, [Str::new("implement trait Drop for struct D0 {"), Str::new(": D0 = D0 {")]);
        this.switch(Feature::Boxes, [Str::new("Box::new(D"), Str::new(".strong_count()")]);
        this.switch(Feature::Boxes, [Str::new("Rc::new(D"), Str::new("Rc::new(D")]);
        this.switch(Feature::Options, [Str::new("Option::Some(D"), Str::new("Result::Err(")]);
        this.switch(Feature::Options, [Str::new(")?"), Str::new(")?")]);
        this.switch_over(Feature::SiblingVariants, [Str::new("Option::None }))?"), Str::new("Option::None }))?")], RARE_SWITCH_PROGRAMS);
        this.switch(Feature::Arrays, [Str::new(": [i8; "), Str::new(": [u64; ")]);
        this.switch(Feature::Arrays, [Str::new(": &Slice<"), Str::new(" % (p")]);
        this.switch(Feature::Strings, [Str::new(": String = String::"), Str::new(".as_bytes()) {")]);
        this.switch(Feature::Strings, [Str::new(".push(\""), Str::new(".as_str())")]);
        this.switch(Feature::DynamicArrays, [Str::new(".pop().unwrap()"), Str::new("Array::new()")]);
        this.switch(Feature::DynamicArrays, [Str::new(": [u8] = "), Str::new(": [i32] = ")]);
        this.switch(Feature::Maps, [Str::new("HashMap::new()"), Str::new(".contains_key(&")]);
        this.switch(Feature::Maps, [Str::new(".insert("), Str::new(".keys()) {")]);
        this.constants_switch();
        this.overloads_switch();
        this.captures_switch();
    }

    /// `trait-objects` and `references` are exercised, not only declared:
    /// of the programs declaring a trait object parameter, at least half
    /// pass `&v` to one, an object being a last argument, and likewise for
    /// a reference parameter, read from the model, where a borrowed
    /// temporary counts too.  A map's lookup borrows its key, `.get(&v1)`,
    /// so a reference's borrow is told apart by its type, not its text.
    internal borrow_coverage(mut &this) -> void {
        this.borrow_coverage_of(Str::new("trait-objects"), [Str::new(": virtual &Tr"), Str::new(": virtual &Tr")], [Str::new(", &v"), Str::new(", &p")], Str::new(", &("));
        this.reference_coverage();
    }

    /// Of the programs declaring a reference parameter, at least half
    /// borrow a variable or a temporary for one.
    private reference_coverage(mut &this) -> void {
        if (!this.owns()) { return; }
        mut declaring: i64 = 0;
        mut passing: i64 = 0;
        mut seed: u64 = 1;
        while (seed <= SWITCH_PROGRAMS) {
            const program: &Program = this.default_model(seed);
            mut declares: boolean = false;
            for (defined in program.functions.iter()) {
                mut position: i64 = 0;
                while (position < defined.parameter_count) {
                    if (program.variable_at(program.list_at(defined.first_parameter + position)).value_type.is_reference()) { declares = true; }
                    position = position + 1;
                }
            }
            mut borrows: boolean = false;
            for (node in program.expressions.iter()) {
                const borrowing: boolean = match (node.kind) {
                    ExpressionKind::Borrow(_)          => { true }
                    ExpressionKind::BorrowTemporary(_) => { true }
                    _                                  => { false }
                };
                if (borrowing && node.value_type.is_reference()) { borrows = true; }
            }
            if (declares) {
                declaring = declaring + 1;
                if (borrows) { passing = passing + 1; }
            }
            seed = seed + 1;
        }
        this.expect(declaring > 0 && 2 * passing >= declaring, f"`references`: {passing} of the {declaring} programs declaring its parameter pass `&v` to one");
    }

    /// `enum-implementations` reaches an enum all three ways a struct's
    /// implementation is reached, read from the model of the default
    /// programs: some call a trait method on an enum value, some
    /// instantiate a trait-bounded function at an enum, and some borrow an
    /// enum variable for a trait object.
    internal enum_implementation_coverage(mut &this) -> void {
        mut calls: i64 = 0;
        mut bounds: i64 = 0;
        mut objects: i64 = 0;
        mut seed: u64 = 1;
        while (seed <= SWITCH_PROGRAMS) {
            const program: &Program = this.default_model(seed);
            mut called: boolean = false;
            mut bounded: boolean = false;
            mut borrowed: boolean = false;
            for (node in program.expressions.iter()) {
                match (node.kind) {
                    ExpressionKind::MethodCall(receiver, _, _, _) => {
                        if (program.expression_at(receiver).value_type.is_enumeration()) { called = true; }
                    }
                    ExpressionKind::GenericCall(callee, type_argument, _, _, _) => {
                        if (type_argument.is_enumeration() && program.function_at(callee).genericity.bounding_trait() >= 0) { bounded = true; }
                    }
                    ExpressionKind::Borrow(variable) => {
                        if (node.value_type.object_trait() >= 0 && program.variable_at(variable).value_type.is_enumeration()) { borrowed = true; }
                    }
                    _ => { }
                }
            }
            if (called) { calls = calls + 1; }
            if (bounded) { bounds = bounds + 1; }
            if (borrowed) { objects = objects + 1; }
            seed = seed + 1;
        }
        this.expect(calls > 0, f"`enum-implementations`: no program of {SWITCH_PROGRAMS} calls a trait method on an enum value");
        this.expect(bounds > 0, f"`enum-implementations`: no program of {SWITCH_PROGRAMS} instantiates a trait bound at an enum");
        this.expect(objects > 0, f"`enum-implementations`: no program of {SWITCH_PROGRAMS} borrows an enum for a trait object");
    }

    /// Of the programs spelling either of `declarations`, at least half
    /// spell either of `borrows` followed by a digit, or `temporary`.
    private borrow_coverage_of(mut &this, feature: Str, declarations: [Str; 2], borrows: [Str; 2], temporary: Str) -> void {
        if (!this.owns()) { return; }
        mut declaring: i64 = 0;
        mut passing: i64 = 0;
        mut seed: u64 = 1;
        while (seed <= SWITCH_PROGRAMS) {
            const text: String = this.default_text(seed);
            const body: Str = SelfTest::body(text.as_str());
            if (body.contains(&declarations[0]) || body.contains(&declarations[1])) {
                declaring = declaring + 1;
                if (SelfTest::passes_borrow(body, borrows) || body.contains(&temporary)) { passing = passing + 1; }
            }
            seed = seed + 1;
        }
        this.expect(declaring > 0 && 2 * passing >= declaring, f"`{feature}`: {passing} of the {declaring} programs declaring its parameter pass `&v` to one");
    }

    /// Whether `text` borrows a parameter or local as an argument: one of
    /// `openings`, then a digit.
    private static passes_borrow(text: Str, openings: [Str; 2]) -> boolean {
        for (opening in openings) {
            mut rest: Str = text;
            mut at: Option<i64> = rest.find(&opening);
            while (at.is_some()) {
                const next: i64 = at.unwrap() + opening.length();
                if (next < rest.length() && rest.byte_at(next).unwrap() >= '0' as u8 && rest.byte_at(next).unwrap() <= '9' as u8) { return true; }
                rest = rest.byte_substring(next, rest.length());
                at = rest.find(&opening);
            }
        }
        return false;
    }

    /// `closure-captures`: with it on, some program declares a local with
    /// no type, `const v3 = (q0: u8) -> ..`, which only a capturing closure
    /// is held by; with it off, none does.
    private captures_switch(mut &this) -> void {
        if (!this.owns()) { return; }
        mut seen: boolean = false;
        mut leaked: boolean = false;
        mut seed: u64 = 1;
        while (seed <= SWITCH_PROGRAMS) {
            const on: String = this.default_text(seed);
            mut off_options: GenerationOptions = GenerationOptions::new(seed);
            off_options.features = FeatureSet::parse(Str::new("default,no-closure-captures")).unwrap();
            const off: String = SelfTest::program(off_options);
            if (SelfTest::declares_untyped(SelfTest::body(on.as_str()))) { seen = true; }
            if (SelfTest::declares_untyped(SelfTest::body(off.as_str()))) { leaked = true; }
            seed = seed + 1;
        }
        this.expect(seen, String::from_str(Str::new("`closure-captures` on: no program declares a local with no type")));
        this.expect(!leaked, String::from_str(Str::new("`closure-captures` off: a program still declares a local with no type")));
    }

    /// Whether `text` declares a local with no type: `const v`, digits,
    /// then ` = `.
    private static declares_untyped(text: Str) -> boolean {
        const opening: Str = Str::new("const v");
        mut rest: Str = text;
        mut at: Option<i64> = rest.find(&opening);
        while (at.is_some()) {
            mut end: i64 = at.unwrap() + opening.length();
            while (end < rest.length() && rest.byte_at(end).unwrap() >= '0' as u8 && rest.byte_at(end).unwrap() <= '9' as u8) {
                end = end + 1;
            }
            rest = rest.byte_substring(end, rest.length());
            if (rest.starts_with(&Str::new(" = "))) { return true; }
            at = rest.find(&opening);
        }
        return false;
    }

    /// `overloads`: with it on, some program declares a free function and
    /// some program a method twice under one name; with it off, none does.
    private overloads_switch(mut &this) -> void {
        if (!this.owns()) { return; }
        mut functions_seen: boolean = false;
        mut methods_seen: boolean = false;
        mut leaked: boolean = false;
        mut seed: u64 = 1;
        while (seed <= SWITCH_PROGRAMS) {
            const on: String = this.default_text(seed);
            mut off_options: GenerationOptions = GenerationOptions::new(seed);
            off_options.features = FeatureSet::parse(Str::new("default,no-overloads")).unwrap();
            const off: String = SelfTest::program(off_options);
            if (SelfTest::declares_twice(on.as_str(), 0)) { functions_seen = true; }
            if (SelfTest::declares_twice(on.as_str(), 4)) { methods_seen = true; }
            if (SelfTest::declares_twice(off.as_str(), 0) || SelfTest::declares_twice(off.as_str(), 4)) { leaked = true; }
            seed = seed + 1;
        }
        this.expect(functions_seen, String::from_str(Str::new("`overloads` on: no program declares a free function's name twice")));
        this.expect(methods_seen, String::from_str(Str::new("`overloads` on: no program declares a method's name twice")));
        this.expect(!leaked, String::from_str(Str::new("`overloads` off: a program still declares a name twice")));
    }

    /// Whether `text` defines one name twice at `indent`: a free function
    /// at 0, a method of one struct or one trait implementation at 4.  A
    /// line at 4 outside both is a statement of a function's body, which may
    /// hold a closure's `) -> `.
    private static declares_twice(text: Str, indent: i64) -> boolean {
        mut names: Array<String> = Array::<String>::new();
        mut scope: Str = Str::new("");
        for (line in text.lines()) {
            if (line.starts_with(&Str::new("type struct ")) || line.starts_with(&Str::new("implement "))) { scope = line; }
            if (line.starts_with(&Str::new("function "))) { scope = Str::new(""); }
            const trimmed: Str = line.trim_start();
            if (line.length() - trimmed.length() != indent || !line.ends_with(&Str::new(" {")) || !trimmed.contains(&Str::new(") -> "))) {
                continue;
            }
            if (indent == 0 && !line.starts_with(&Str::new("function "))) { continue; }
            if (indent > 0 && scope.length() == 0) { continue; }
            const name: Str = trimmed.split_once(&Str::new("(")).unwrap().first;
            const key: String = f"{scope} {name}";
            for (seen in names.iterate_references()) {
                if (seen.as_str() == key.as_str()) { return true; }
            }
            names.push(key);
        }
        return false;
    }

    /// `constants`: with it on, some program passes an argument made only of
    /// literals; with it off, none does.  Such an argument is the one place
    /// a literal opens a parenthesised operation (`(19371 & 32767)`).
    private constants_switch(mut &this) -> void {
        if (!this.owns()) { return; }
        mut seen: boolean = false;
        mut leaked: boolean = false;
        mut seed: u64 = 1;
        while (seed <= SWITCH_PROGRAMS) {
            const on: String = this.default_text(seed);
            mut off_options: GenerationOptions = GenerationOptions::new(seed);
            off_options.features = FeatureSet::parse(Str::new("default,no-constants")).unwrap();
            const off: String = SelfTest::program(off_options);
            if (SelfTest::combines_literals(SelfTest::body(on.as_str()))) { seen = true; }
            if (SelfTest::combines_literals(SelfTest::body(off.as_str()))) { leaked = true; }
            seed = seed + 1;
        }
        this.expect(seen, String::from_str(Str::new("`constants` on: no program passes an argument made only of literals")));
        this.expect(!leaked, String::from_str(Str::new("`constants` off: a program still passes an argument made only of literals")));
    }

    /// Whether a parenthesis in `text` opens on a literal that an operator
    /// then combines: `(` and digits, then ` & `, ` | ` or ` ^ `.
    private static combines_literals(text: Str) -> boolean {
        mut index: i64 = 0;
        while (index < text.length()) {
            if (text.byte_at(index) == Option::Some('(' as u8)) {
                mut end: i64 = index + 1;
                while (end < text.length() && text.byte_at(end).unwrap() >= '0' as u8 && text.byte_at(end).unwrap() <= '9' as u8) {
                    end = end + 1;
                }
                if (end > index + 1) {
                    const rest: Str = text.byte_substring(end, text.length());
                    if (rest.starts_with(&Str::new(" & ")) || rest.starts_with(&Str::new(" | ")) || rest.starts_with(&Str::new(" ^ "))) { return true; }
                }
            }
            index = index + 1;
        }
        return false;
    }

    /// `feature` on: one of `spellings` appears in some program; off: in
    /// none.
    private switch(mut &this, feature: Feature, spellings: [Str; 2]) -> void {
        this.switch_over(feature, spellings, SWITCH_PROGRAMS);
    }

    /// `switch` over the first `programs` seeds, for a form drawn rarely
    /// enough that a few dozen programs may not hold it.
    private switch_over(mut &this, feature: Feature, spellings: [Str; 2], programs: u64) -> void {
        if (!this.owns()) { return; }
        mut seen: boolean = false;
        mut leaked: boolean = false;
        mut seed: u64 = 1;
        while (seed <= programs) {
            const on: String = this.default_text(seed);
            mut off_options: GenerationOptions = GenerationOptions::new(seed);
            off_options.features = FeatureSet::parse(f"default,no-{feature.name()}".as_str()).unwrap();
            const off: String = SelfTest::program(off_options);
            for (spelling in spellings) {
                if (SelfTest::body(on.as_str()).contains(&spelling)) { seen = true; }
                if (SelfTest::body(off.as_str()).contains(&spelling)) { leaked = true; }
            }
            seed = seed + 1;
        }
        this.expect(seen, f"`{feature.name()}` on: no program spells it");
        this.expect(!leaked, f"`{feature.name()}` off: a program still spells it");
    }
}
