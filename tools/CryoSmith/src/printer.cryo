///! Printing a `Program` as Cryo source.
///!
///! Every binary, unary, cast and `if` expression is parenthesised, so
///! precedence never decides a meaning, and every statement has a line of
///! its own, so a line-based reducer can delete one.

namespace cryosmith::printer;

import std::collections::str::{ Str };
import std::collections::string::{ String };

import cryosmith::generator::{ GENERATOR_VERSION, GenerationOptions };
import cryosmith::program::{
    ExpressionKind, ExpressionNode, Function, LoopShape, Program, ScalarType, StatementKind, StatementNode,
    Variable, VariableRole
};

/// Writes one program's text.
public type struct Printer {
    text: String;

    /// The source of `program`, generated with `options`.
    public static print(program: &Program, options: &GenerationOptions) -> String {
        mut printer: Printer = Printer { text: String::new() };
        if (options.header) {
            printer.text.push(f"// cryosmith {GENERATOR_VERSION} seed {options.seed} features {options.features.canonical().as_str()} functions {options.function_count()} size {options.size}");
            if (options.plant.is_planted()) { printer.text.push(f" plant {options.plant.name()}"); }
            printer.text.push(Str::new("\n\n"));
        }
        printer.text.push(Str::new(
            "namespace Main;\n\n"
            "import std::fmt;\n\n"
            "mut observed: u64 = 14695981039346656037;\n\n"
            "function mix(state: u64, value: u64) -> u64 {\n"
            "    return (state ^ value).wrapping_multiply(1099511628211).wrapping_add(2654435769);\n"
            "}\n"));
        mut index: i64 = 0;
        while (index < program.functions.length()) {
            printer.definition(program, program.function_at(index));
            index = index + 1;
        }
        return printer.text;
    }

    definition(mut &this, program: &Program, defined: Function) -> void {
        this.text.push(Str::new("\n"));
        if (defined.is_main) {
            this.text.push(Str::new("function main() -> i32 {\n"));
        } else {
            this.text.push(f"function h{defined.number}(");
            mut index: i64 = 0;
            while (index < defined.parameter_count) {
                if (index > 0) { this.text.push(Str::new(", ")); }
                const parameter: i64 = program.list_at(defined.first_parameter + index);
                this.name(program, parameter);
                this.text.push(f": {program.variable_at(parameter).scalar.name()}");
                index = index + 1;
            }
            this.text.push(f") -> {defined.returns.name()} ");
            this.text.push(Str::new("{\n"));
        }
        this.block(program, defined.body, 1);
        this.text.push(Str::new("}\n"));
    }

    block(mut &this, program: &Program, first: i64, indent: i64) -> void {
        mut current: i64 = first;
        while (current >= 0) {
            const node: StatementNode = program.statement_at(current);
            this.statement(program, node.kind, indent);
            current = node.next;
        }
    }

    /// `{`, the block, and `}` on its own line at `indent`.
    braced(mut &this, program: &Program, first: i64, indent: i64) -> void {
        this.text.push(Str::new("{\n"));
        this.block(program, first, indent + 1);
        this.indent(indent);
        this.text.push(Str::new("}"));
    }

    statement(mut &this, program: &Program, kind: StatementKind, indent: i64) -> void {
        this.indent(indent);
        match (kind) {
            StatementKind::Declare(variable, value) => {
                const declared: Variable = program.variable_at(variable);
                this.text.push(if (declared.mutable) { Str::new("mut ") } else { Str::new("const ") });
                this.name(program, variable);
                this.text.push(f": {declared.scalar.name()} = ");
                this.expression(program, value);
                this.text.push(Str::new(";\n"));
            }
            StatementKind::Assign(variable, value) => {
                this.name(program, variable);
                this.text.push(Str::new(" = "));
                this.expression(program, value);
                this.text.push(Str::new(";\n"));
            }
            StatementKind::Compound(operator, variable, value) => {
                this.name(program, variable);
                this.text.push(f" {operator.symbol()}= ");
                this.expression(program, value);
                this.text.push(Str::new(";\n"));
            }
            StatementKind::Observe(value) => {
                this.text.push(Str::new("observed = mix(observed, "));
                this.as_hash_input(program, value);
                this.text.push(Str::new(");\n"));
            }
            StatementKind::Branch(condition, then_block, else_block) => {
                this.text.push(Str::new("if ("));
                this.expression(program, condition);
                this.text.push(Str::new(") "));
                this.braced(program, then_block, indent);
                if (else_block >= 0) {
                    this.text.push(Str::new(" else "));
                    this.braced(program, else_block, indent);
                }
                this.text.push(Str::new("\n"));
            }
            StatementKind::Loop(shape, counter, trips, body) => {
                const scalar: Str = program.variable_at(counter).scalar.name();
                match (shape) {
                    LoopShape::Counted => {
                        this.text.push(Str::new("for (mut "));
                        this.name(program, counter);
                        this.text.push(f": {scalar} = 0; ");
                        this.name(program, counter);
                        this.text.push(f" < {trips}; ");
                        this.name(program, counter);
                        this.text.push(Str::new(" = "));
                        this.name(program, counter);
                        this.text.push(Str::new(" + 1) "));
                        this.braced(program, body, indent);
                    }
                    LoopShape::Conditioned => {
                        this.text.push(Str::new("mut "));
                        this.name(program, counter);
                        this.text.push(f": {scalar} = 0;\n");
                        this.indent(indent);
                        this.text.push(Str::new("while ("));
                        this.name(program, counter);
                        this.text.push(f" < {trips}) ");
                        this.text.push(Str::new("{\n"));
                        this.indent(indent + 1);
                        this.name(program, counter);
                        this.text.push(Str::new(" = "));
                        this.name(program, counter);
                        this.text.push(Str::new(" + 1;\n"));
                        this.block(program, body, indent + 1);
                        this.indent(indent);
                        this.text.push(Str::new("}"));
                    }
                    LoopShape::Ranged => {
                        this.text.push(Str::new("for ("));
                        this.name(program, counter);
                        this.text.push(f" in 0..{trips}) ");
                        this.braced(program, body, indent);
                    }
                }
                this.text.push(Str::new("\n"));
            }
            StatementKind::Exit(is_break, condition) => {
                this.text.push(Str::new("if ("));
                this.expression(program, condition);
                this.text.push(if (is_break) { Str::new(") { break; }\n") } else { Str::new(") { continue; }\n") });
            }
            StatementKind::ReturnIf(condition, value) => {
                this.text.push(Str::new("if ("));
                this.expression(program, condition);
                this.text.push(Str::new(") { return "));
                this.expression(program, value);
                this.text.push(Str::new("; }\n"));
            }
            StatementKind::Return(value) => {
                this.text.push(Str::new("return "));
                this.expression(program, value);
                this.text.push(Str::new(";\n"));
            }
            StatementKind::Finish => {
                this.text.push(Str::new("fmt::println(f\"cryosmith-hash {observed}\");\n"));
                this.indent(indent);
                this.text.push(Str::new("return 0;\n"));
            }
        }
    }

    /// A value as `mix` takes it: an integer converted to `u64`, a boolean
    /// as 1 or 2.
    as_hash_input(mut &this, program: &Program, value: i64) -> void {
        match (program.expression_at(value).scalar) {
            ScalarType::Boolean => {
                this.text.push(Str::new("if ("));
                this.expression(program, value);
                this.text.push(Str::new(") { 1 } else { 2 }"));
            }
            _ => {
                this.text.push(Str::new("("));
                this.expression(program, value);
                this.text.push(Str::new(" as u64)"));
            }
        }
    }

    expression(mut &this, program: &Program, index: i64) -> void {
        const node: ExpressionNode = program.expression_at(index);
        match (node.kind) {
            ExpressionKind::IntegerLiteral(magnitude, negative) => {
                if (negative) { this.text.push(f"(-{magnitude})"); } else { this.text.push(f"{magnitude}"); }
            }
            ExpressionKind::BooleanLiteral(value) => {
                this.text.push(if (value) { Str::new("true") } else { Str::new("false") });
            }
            ExpressionKind::Limit(is_maximum) => {
                this.text.push(f"{node.scalar.name()}::");
                this.text.push(if (is_maximum) { Str::new("MAX") } else { Str::new("MIN") });
            }
            ExpressionKind::Variable(variable) => { this.name(program, variable); }
            ExpressionKind::Unary(operator, operand) => {
                this.text.push(f"({operator.symbol()}");
                this.expression(program, operand);
                this.text.push(Str::new(")"));
            }
            ExpressionKind::Binary(operator, left, right) => {
                this.text.push(Str::new("("));
                this.expression(program, left);
                this.text.push(f" {operator.symbol()} ");
                this.expression(program, right);
                this.text.push(Str::new(")"));
            }
            ExpressionKind::Wrapping(operator, receiver, argument) => {
                this.receiver(program, receiver);
                this.text.push(f".{operator.method()}(");
                this.expression(program, argument);
                this.text.push(Str::new(")"));
            }
            ExpressionKind::Cast(operand) => {
                this.text.push(Str::new("("));
                this.expression(program, operand);
                this.text.push(f" as {node.scalar.name()})");
            }
            ExpressionKind::Widen(operand) => { this.expression(program, operand); }
            ExpressionKind::Conditional(condition, then_value, else_value) => {
                this.text.push(Str::new("(if ("));
                this.expression(program, condition);
                this.text.push(Str::new(") { "));
                this.expression(program, then_value);
                this.text.push(Str::new(" } else { "));
                this.expression(program, else_value);
                this.text.push(Str::new(" })"));
            }
            ExpressionKind::Call(callee, first, count) => {
                this.text.push(f"h{program.function_at(callee).number}(");
                mut index: i64 = 0;
                while (index < count) {
                    if (index > 0) { this.text.push(Str::new(", ")); }
                    this.expression(program, program.list_at(first + index));
                    index = index + 1;
                }
                this.text.push(Str::new(")"));
            }
        }
    }

    /// A method's receiver: a name or a parenthesised expression as it
    /// prints, anything else in parentheses.
    receiver(mut &this, program: &Program, index: i64) -> void {
        match (program.expression_at(index).kind) {
            ExpressionKind::Variable(_) => { this.expression(program, index); }
            ExpressionKind::Unary(_, _) => { this.expression(program, index); }
            ExpressionKind::Binary(_, _, _) => { this.expression(program, index); }
            ExpressionKind::Cast(_) => { this.expression(program, index); }
            ExpressionKind::Conditional(_, _, _) => { this.expression(program, index); }
            _ => {
                this.text.push(Str::new("("));
                this.expression(program, index);
                this.text.push(Str::new(")"));
            }
        }
    }

    name(mut &this, program: &Program, variable: i64) -> void {
        const named: Variable = program.variable_at(variable);
        match (named.role) {
            VariableRole::Observed  => { this.text.push(Str::new("observed")); }
            VariableRole::Parameter => { this.text.push(f"p{named.number}"); }
            VariableRole::Local     => { this.text.push(f"v{named.number}"); }
            VariableRole::Counter   => { this.text.push(f"n{named.number}"); }
        }
    }

    indent(mut &this, depth: i64) -> void { this.text.push_repeated(' ', depth * 4); }
}
