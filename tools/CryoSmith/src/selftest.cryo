///! `cryosmith selftest`: the generator's guarantees that need no compiler,
///! checked in process.
///!
///! - The same seed and options give the same bytes; different seeds give
///!   different programs.
///! - A function's text does not depend on how many functions follow it.
///! - Feature lists read and print canonically, and refuse an unknown name.
///! - A disabled feature's forms never appear, and each form is seen with
///!   its feature enabled, so the search can find what it looks for.
///! - The static audit passes every program and refuses every planted one
///!   that divides.
///!
///! It counts its checks and refuses a run that made none.

namespace cryosmith::selftest;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::fmt;

import cryosmith::audit::{ Audit };
import cryosmith::features::{ Feature, FeatureSet };
import cryosmith::generator::{ GenerationOptions, Generator, Plant };
import cryosmith::printer::{ Printer };

/// How many programs the audit reads.
const AUDITED_PROGRAMS: u64 = 300;

/// How many programs each feature switch is checked over.
const SWITCH_PROGRAMS: u64 = 40;

/// The self-test's checks and their failures.
public type struct SelfTest {
    checks: i64;
    failures: Array<String>;

    /// Run every check; 0 when all passed, 1 otherwise.
    public static run() -> i32 {
        mut test: SelfTest = SelfTest { checks: 0, failures: Array::<String>::new() };
        test.determinism();
        test.function_prefix();
        test.feature_lists();
        test.feature_switches();
        test.audit();
        for (failure in test.failures.iterate_references()) { fmt::eprintln(f"cryosmith selftest: FAIL {failure.as_str()}"); }
        if (test.checks == 0) {
            fmt::eprintln(String::from_str(Str::new("cryosmith selftest: FAIL no check ran")));
            return 1;
        }
        if (test.failures.length() > 0) {
            fmt::eprintln(f"cryosmith selftest: FAIL ({test.failures.length()} of {test.checks} checks)");
            return 1;
        }
        fmt::println(f"cryosmith selftest: OK ({test.checks} checks)");
        return 0;
    }

    expect(mut &this, holds: boolean, description: String) -> void {
        this.checks = this.checks + 1;
        if (!holds) { this.failures.push(description); }
    }

    static program(options: GenerationOptions) -> String {
        return Printer::print(&Generator::generate(options), &options);
    }

    determinism(mut &this) -> void {
        mut seed: u64 = 1;
        while (seed <= 20) {
            const first: String = SelfTest::program(GenerationOptions::new(seed));
            const second: String = SelfTest::program(GenerationOptions::new(seed));
            this.expect(first.as_str() == second.as_str(), f"seed {seed} generated two different programs");
            const next: String = SelfTest::program(GenerationOptions::new(seed + 1));
            this.expect(first.as_str() != next.as_str(), f"seeds {seed} and {seed + 1} generated the same program");
            seed = seed + 1;
        }
    }

    /// Functions h0 and h1 print the same with two helpers as with four.
    function_prefix(mut &this) -> void {
        mut seed: u64 = 1;
        while (seed <= 10) {
            mut longer: GenerationOptions = GenerationOptions::new(seed);
            longer.functions = 4;
            mut shorter: GenerationOptions = GenerationOptions::new(seed);
            shorter.functions = 2;
            const long_text: String = SelfTest::program(longer);
            const short_text: String = SelfTest::program(shorter);
            const long_prefix: Option<Str> = SelfTest::between(long_text.as_str(), Str::new("\nfunction h0("), Str::new("\nfunction h2("));
            const short_prefix: Option<Str> = SelfTest::between(short_text.as_str(), Str::new("\nfunction h0("), Str::new("\nfunction main("));
            this.expect(long_prefix.is_some() && long_prefix == short_prefix, f"seed {seed}: h0 and h1 depend on the function count");
            seed = seed + 1;
        }
    }

    feature_lists(mut &this) -> void {
        const defaults: String = FeatureSet::default_set().canonical();
        match (FeatureSet::parse(Str::new("default"))) {
            Result::Ok(set) => { this.expect(set.canonical().as_str() == defaults.as_str(), f"`default` reads as {set.canonical().as_str()}"); }
            Result::Err(reason) => { this.expect(false, f"`default` is refused: {reason.as_str()}"); }
        }
        match (FeatureSet::parse(defaults.as_str())) {
            Result::Ok(set) => { this.expect(set.canonical().as_str() == defaults.as_str(), String::from_str(Str::new("the canonical list does not read back as itself"))); }
            Result::Err(reason) => { this.expect(false, f"the canonical list is refused: {reason.as_str()}"); }
        }
        match (FeatureSet::parse(Str::new("default,no-shifts"))) {
            Result::Ok(set) => {
                this.expect(!set.has(Feature::Shifts) && set.has(Feature::Division), String::from_str(Str::new("`default,no-shifts` does not remove exactly shifts")));
            }
            Result::Err(reason) => { this.expect(false, f"`default,no-shifts` is refused: {reason.as_str()}"); }
        }
        this.expect(FeatureSet::parse(Str::new("default,bogus")).is_err(), String::from_str(Str::new("an unknown feature is accepted")));
    }

    /// Each switchable feature: with it on, one of its spellings appears in
    /// some program; with it off, none appears in any.
    feature_switches(mut &this) -> void {
        this.switch(Feature::Wrapping, [Str::new(".wrapping_"), Str::new(".wrapping_")]);
        this.switch(Feature::Shifts, [Str::new(" << "), Str::new(" >> ")]);
        this.switch(Feature::Division, [Str::new(" / "), Str::new(" % ")]);
        this.switch(Feature::Guarded, [Str::new(" * "), Str::new(" * ")]);
        this.switch(Feature::Bitwise, [Str::new(" ^ "), Str::new("(~")]);
        this.switch(Feature::Loops, [Str::new("for ("), Str::new("while (")]);
        this.switch(Feature::LoopExits, [Str::new("{ break; }"), Str::new("{ continue; }")]);
        this.switch(Feature::EarlyReturns, [Str::new("{ return "), Str::new("{ return ")]);
        this.switch(Feature::IfExpressions, [Str::new("(if ("), Str::new("(if (")]);
        this.switch(Feature::Booleans, [Str::new(" && "), Str::new(" || ")]);
    }

    switch(mut &this, feature: Feature, spellings: [Str; 2]) -> void {
        mut seen: boolean = false;
        mut leaked: boolean = false;
        mut seed: u64 = 1;
        while (seed <= SWITCH_PROGRAMS) {
            const on: String = SelfTest::program(GenerationOptions::new(seed));
            mut off_options: GenerationOptions = GenerationOptions::new(seed);
            off_options.features = FeatureSet::parse(f"default,no-{feature.name()}".as_str()).unwrap();
            const off: String = SelfTest::program(off_options);
            for (spelling in spellings) {
                if (SelfTest::body(on.as_str()).contains(&spelling)) { seen = true; }
                if (SelfTest::body(off.as_str()).contains(&spelling)) { leaked = true; }
            }
            seed = seed + 1;
        }
        this.expect(seen, f"`{feature.name()}` on: no program spells it");
        this.expect(!leaked, f"`{feature.name()}` off: a program still spells it");
    }

    audit(mut &this) -> void {
        mut sites: i64 = 0;
        mut seed: u64 = 1;
        while (seed <= AUDITED_PROGRAMS) {
            const text: String = SelfTest::program(GenerationOptions::new(seed));
            match (Audit::check(text.as_str())) {
                Result::Ok(count)   => { sites = sites + count; }
                Result::Err(reason) => { this.expect(false, f"seed {seed}: {reason.as_str()}"); }
            }
            seed = seed + 1;
        }
        this.expect(sites > 0, String::from_str(Str::new("the audit found no division or shift to check")));
        mut dividing: i64 = 0;
        mut refused: i64 = 0;
        seed = 1;
        while (seed <= 100) {
            mut planted: GenerationOptions = GenerationOptions::new(seed);
            planted.plant = Plant::UnguardedDivision;
            const text: String = SelfTest::program(planted);
            const body: Str = SelfTest::body(text.as_str());
            if (body.contains(&Str::new(" / ")) || body.contains(&Str::new(" % ")) || body.contains(&Str::new("/= ")) || body.contains(&Str::new("%= "))) {
                dividing = dividing + 1;
                if (Audit::check(text.as_str()).is_err()) { refused = refused + 1; }
            }
            seed = seed + 1;
        }
        this.expect(dividing > 0, String::from_str(Str::new("no planted program divides")));
        this.expect(refused == dividing, f"the audit refused {refused} of {dividing} planted programs that divide");
    }

    /// The program after its prelude: everything past `mix`'s closing brace.
    static body(text: Str) -> Str {
        return match (text.split_once(&Str::new("\n}\n"))) {
            Option::Some(parts) => { parts.second }
            Option::None        => { text }
        };
    }

    /// The text from `start` up to `end`, if both are there in that order.
    static between(text: Str, start: Str, end: Str) -> Option<Str> {
        const from: i64 = text.find(&start)?;
        const rest: Str = text.byte_substring(from, text.length());
        const length: i64 = rest.find(&end)?;
        return Option::Some(rest.byte_substring(0, length));
    }
}
