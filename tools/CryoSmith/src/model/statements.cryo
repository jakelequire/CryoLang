///! Statement nodes.  A block is the index of its first statement, or -1
///! when it is empty, and each statement names the next one of its block.

namespace cryosmith::model::statements;

import cryosmith::model::operators::{ BinaryOperator };

/// The three loop shapes, each counting a counter from 0 to a trip count.
public type enum LoopShape {
    /// `for (mut i: T = 0; i < K; i = i + 1) { ... }`.
    Counted;
    /// `mut i: T = 0; while (i < K) { i = i + 1; ... }`: the increment
    /// comes first, so a `continue` cannot skip it.
    Conditioned;
    /// `for (i in 0..K) { ... }`.
    Ranged;
}

/// What a statement node is.  A block is the index of its first statement,
/// or -1 when it is empty.
public type enum StatementKind {
    /// Declare a variable with its initial value.
    Declare(i64, i64);
    /// `place = value`: a place is a variable read or a field of one.
    Assign(i64, i64);
    /// `place op= value`.
    Compound(BinaryOperator, i64, i64);
    /// Fold a value into `observed`.
    Observe(i64);
    /// An expression evaluated for its effect: a call returning nothing.
    Evaluate(i64);
    /// `if (condition) { then } else { otherwise }`; an empty `otherwise`
    /// prints no `else`.
    Branch(i64, i64, i64);
    /// A loop: its shape, counter, trip count and body.
    Loop(LoopShape, i64, u64, i64);
    /// `if (condition) { break; }` when true, `continue` when false.
    Exit(boolean, i64);
    /// `if (condition) { return value; }`; a value of -1 returns nothing.
    ReturnIf(i64, i64);
    /// `return value;`.
    Return(i64);
    /// `match (subject) { pattern => { block } ... }`: the subject, the
    /// first arm's place among the program's arms, and the arm count; each
    /// arm's body is a block.
    Match(i64, i64, i64);
    /// `main`'s end: print the hash line and return 0.
    Finish;
}

/// One statement and the statement after it in its block, or -1.
public type struct StatementNode {
    /// What the statement is.
    public kind: StatementKind;
    /// The next statement of the block, or -1.
    public next: i64;
}
