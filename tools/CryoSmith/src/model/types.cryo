///! `ValueType`: the type of a generated value - the eight integer types,
///! `boolean`, `void` and a generated struct - and the facts about it that
///! generation and printing read.  Its name is the program's to spell
///! (`Program::type_name`), since an instance's names its type argument.

namespace cryosmith::model::types;

import std::collections::array::{ Array };

/// The type of a generated value.
public type enum ValueType {
    /// `i8`.
    I8;
    /// `i16`.
    I16;
    /// `i32`.
    I32;
    /// `i64`.
    I64;
    /// `u8`.
    U8;
    /// `u16`.
    U16;
    /// `u32`.
    U32;
    /// `u64`.
    U64;
    /// `boolean`.
    Boolean;
    /// What a function that returns nothing returns.
    Void;
    /// A generated struct or an instance of a generic one, by its index in
    /// the program's structures.
    Record(i64);
    /// A generated enum, by its index in the program's enums.
    Enumeration(i64);
    /// A generic function's type parameter, `T`: its values are read,
    /// passed, returned, selected between and, under an `Eq` bound,
    /// compared, and nothing else.
    TypeParameter;
    /// A function type, `(u8, i32) -> boolean`, by its index in the
    /// program's signatures, where equal signatures share one index.
    Function(i64);
    /// A trait object borrowing a value of a struct implementing a trait,
    /// `virtual &Tr0`, by the trait's place among the program's traits: a
    /// parameter's type only, its methods called through the value's
    /// table.
    TraitObject(i64);
    /// A struct owning a destructor, `D<N>`, by its place among the
    /// program's owned structs: not `Copy`, so each pass, store or return
    /// of a value moves it, and it is dropped once, where its last owner
    /// leaves scope.
    Owned(i64);
    /// `&D<N>`, a shared reference to an owned struct's value, by the
    /// owned struct's place: a parameter's or a return's type only, so it
    /// never outlives the statement that borrows.
    SharedReference(i64);
    /// `mut &D<N>`, an exclusive reference to an owned struct's value, by
    /// the owned struct's place: a parameter's type only, through which
    /// the value's fields are written.
    ExclusiveReference(i64);
}

implement enum ValueType {
    /// The integer types, narrowest first, signed before unsigned.
    public static integers() -> Array<ValueType> {
        mut all: Array<ValueType> = Array::<ValueType>::new();
        all.push(ValueType::I8);
        all.push(ValueType::I16);
        all.push(ValueType::I32);
        all.push(ValueType::I64);
        all.push(ValueType::U8);
        all.push(ValueType::U16);
        all.push(ValueType::U32);
        all.push(ValueType::U64);
        return all;
    }

    /// A number that is the same for two values exactly when they are the
    /// same type: the eleven types without an index below 11, and each
    /// indexed kind on its own residue of seven above them.
    public identity(this) -> i64 {
        return match (this) {
            ValueType::I8            => { 0 }
            ValueType::I16           => { 1 }
            ValueType::I32           => { 2 }
            ValueType::I64           => { 3 }
            ValueType::U8            => { 4 }
            ValueType::U16           => { 5 }
            ValueType::U32           => { 6 }
            ValueType::U64           => { 7 }
            ValueType::Boolean       => { 8 }
            ValueType::Void          => { 9 }
            ValueType::TypeParameter => { 10 }
            ValueType::Record(index) => { 11 + 7 * index }
            ValueType::Enumeration(index) => { 12 + 7 * index }
            ValueType::Function(index) => { 13 + 7 * index }
            ValueType::TraitObject(index) => { 14 + 7 * index }
            ValueType::Owned(index) => { 15 + 7 * index }
            ValueType::SharedReference(index) => { 16 + 7 * index }
            ValueType::ExclusiveReference(index) => { 17 + 7 * index }
        };
    }

    /// The owned struct a reference refers to a value of, or -1 for any
    /// other type.
    public referent(this) -> i64 {
        return match (this) {
            ValueType::SharedReference(index)    => { index }
            ValueType::ExclusiveReference(index) => { index }
            _                                    => { -1 }
        };
    }

    /// Whether this is a reference, shared or exclusive.
    public is_reference(&this) -> boolean { return this.referent() >= 0; }

    /// Whether this is an exclusive reference, `mut &D<N>`.
    public is_exclusive(this) -> boolean {
        return match (this) {
            ValueType::ExclusiveReference(_) => { true }
            _                                => { false }
        };
    }

    /// The owned struct an owned type names, or -1 for any other type.
    public owned(this) -> i64 {
        return match (this) {
            ValueType::Owned(index) => { index }
            _                       => { -1 }
        };
    }

    /// Whether this is an owned struct's type, whose values move.
    public is_owned(&this) -> boolean { return this.owned() >= 0; }

    /// The trait a trait object borrows its value as, or -1 for any other
    /// type.
    public object_trait(this) -> i64 {
        return match (this) {
            ValueType::TraitObject(index) => { index }
            _                             => { -1 }
        };
    }

    /// The signature a function type names, or -1 for any other type.
    public signature(this) -> i64 {
        return match (this) {
            ValueType::Function(index) => { index }
            _                          => { -1 }
        };
    }

    /// Whether this is a function type.
    public is_function(&this) -> boolean { return this.signature() >= 0; }

    /// The struct a record type names, or -1 for any other type.
    public structure(this) -> i64 {
        return match (this) {
            ValueType::Record(index) => { index }
            _                        => { -1 }
        };
    }

    /// The enum an enum type names, or -1 for any other type.
    public enumeration(this) -> i64 {
        return match (this) {
            ValueType::Enumeration(index) => { index }
            _                             => { -1 }
        };
    }

    /// Whether this is an enum type.
    public is_enumeration(&this) -> boolean { return this.enumeration() >= 0; }

    /// Whether a `match` expression may produce a value of this type: an
    /// integer, `boolean` or enum type.
    public is_matchable(&this) -> boolean {
        return this.is_integer() || this.same(ValueType::Boolean) || this.is_enumeration();
    }

    /// The width in bits of an integer type; 0 for any other type.
    public width(&this) -> u64 {
        return match (&this) {
            ValueType::I8  => { 8 }
            ValueType::I16 => { 16 }
            ValueType::I32 => { 32 }
            ValueType::I64 => { 64 }
            ValueType::U8  => { 8 }
            ValueType::U16 => { 16 }
            ValueType::U32 => { 32 }
            ValueType::U64 => { 64 }
            _              => { 0 }
        };
    }

    /// Whether the type is a signed integer.
    public is_signed(&this) -> boolean {
        return match (&this) {
            ValueType::I8  => { true }
            ValueType::I16 => { true }
            ValueType::I32 => { true }
            ValueType::I64 => { true }
            _              => { false }
        };
    }

    /// Whether the type is an integer.
    public is_integer(&this) -> boolean { return this.width() != 0; }

    /// Whether the type is a generated struct.
    public is_record(&this) -> boolean { return this.structure() >= 0; }

    /// Whether the type is the same type as `other`.
    public same(&this, other: ValueType) -> boolean { return this.identity() == other.identity(); }

    /// Whether the language converts a value of this type to `wider`
    /// implicitly: to a wider integer of the same signedness, or from an
    /// unsigned integer to a wider signed one.
    public widens_to(&this, wider: ValueType) -> boolean {
        if (!this.is_integer() || !wider.is_integer()) { return false; }
        if (this.width() >= wider.width()) { return false; }
        return this.is_signed() == wider.is_signed() || !this.is_signed();
    }

    /// The largest value of an integer type, as a magnitude.
    public maximum(&this) -> u64 {
        const width: u64 = this.width();
        if (this.is_signed()) { return (1 << (width - 1)) - 1; }
        if (width == 64) { return u64::MAX; }
        return (1 << width) - 1;
    }
}
