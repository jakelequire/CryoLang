///! The program model: what CryoSmith builds before it prints anything.
///!
///! A `Program` is arenas of plain data - structs, fields, variables,
///! expressions, statements and functions - and one more holding runs of
///! indices (a call's arguments, a function's parameters, a struct
///! literal's entries).  A node names its children by index, and a block is
///! a chain of statements each naming the next, so no node owns another.
///!
///! The model is the lowest layer: it imports only the standard library,
///! and every other layer may read it.
///!
///!   types        `ValueType`, the type of a generated value
///!   operators    the unary, binary and wrapping operators
///!   expressions  expression nodes
///!   statements   statement nodes and loop shapes
///!   items        variables, struct fields, structs, owned structs, enums,
///!                traits and functions
///!   program      `Program`, the arenas and their accessors

namespace cryosmith::model;

module {
    model::types;
    model::operators;
    model::expressions;
    model::statements;
    model::items;
    model::program;
}

export cryosmith::model::types::{ ValueType };
export cryosmith::model::operators::{ BinaryOperator, UnaryOperator, WrappingOperator };
export cryosmith::model::expressions::{ ExpressionKind, ExpressionNode, MatchArm, PatternElement, TypeArgumentSpelling };
export cryosmith::model::statements::{ LoopShape, StatementKind, StatementNode };
export cryosmith::model::items::{
    Closure, Enumeration, Field, Function, Genericity, OwnedStructure, Receiver, Signature, Structure, TraitDeclaration, TraitMethod,
    Variable, VariableRole, VariantDeclaration
};
export cryosmith::model::program::{ Program };
