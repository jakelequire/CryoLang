///! Expressions, every operator application parenthesised.

namespace cryosmith::emit::expressions;

import std::collections::str::{ Str };
import std::collections::string::{ String };

import cryosmith::emit::printer::{ Printer };
import cryosmith::model::{
    Closure, ExpressionKind, ExpressionNode, Function, MatchArm, Omission, PatternElement, Program, TypeArgumentSpelling, ValueType
};

implement struct Printer {
    /// The expression at `index`.
    internal expression(mut &this, program: &Program, index: i64) -> void {
        const node: ExpressionNode = program.expression_at(index);
        match (node.kind) {
            ExpressionKind::IntegerLiteral(magnitude, negative) => {
                if (negative) { this.text.append(f"(-{magnitude})"); } else { this.text.append(f"{magnitude}"); }
            }
            ExpressionKind::BooleanLiteral(value) => {
                this.text.append(if (value) { Str::new("true") } else { Str::new("false") });
            }
            ExpressionKind::Limit(is_maximum) => {
                this.text.append(f"{program.type_name(node.value_type).as_str()}::");
                this.text.append(if (is_maximum) { Str::new("MAX") } else { Str::new("MIN") });
            }
            ExpressionKind::Variable(variable) => { this.name(program, variable); }
            ExpressionKind::Unary(operator, operand) => {
                this.text.append(f"({operator.symbol()}");
                this.expression(program, operand);
                this.text.append(Str::new(")"));
            }
            ExpressionKind::Binary(operator, left, right) => {
                this.text.append(Str::new("("));
                this.expression(program, left);
                this.text.append(f" {operator.symbol()} ");
                this.expression(program, right);
                this.text.append(Str::new(")"));
            }
            ExpressionKind::Wrapping(operator, receiver, argument) => {
                this.receiver(program, receiver);
                this.text.append(f".{operator.method()}(");
                this.expression(program, argument);
                this.text.append(Str::new(")"));
            }
            ExpressionKind::Cast(operand) => {
                this.text.append(Str::new("("));
                this.expression(program, operand);
                this.text.append(f" as {program.type_name(node.value_type).as_str()})");
            }
            ExpressionKind::Widen(operand) => { this.expression(program, operand); }
            ExpressionKind::Variant(variant, spelling, first, count) => {
                this.text.append(f"{program.variant_path(node.value_type.enumeration(), spelling).as_str()}::V{variant}");
                if (count > 0) {
                    this.text.append(Str::new("("));
                    this.arguments(program, first, count);
                }
            }
            ExpressionKind::Mix(state, value) => {
                this.text.append(Str::new("mix("));
                this.expression(program, state);
                this.text.append(Str::new(", "));
                this.as_hash_input(program, value);
                this.text.append(Str::new(")"));
            }
            ExpressionKind::Match(subject, first, count) => {
                this.text.append(Str::new("(match ("));
                this.expression(program, subject);
                this.text.append(Str::new(") { "));
                mut arm: i64 = first;
                while (arm < first + count) {
                    if (program.omits_arm(program.expression_at(subject).value_type, program.arm_at(arm))) {
                        arm = arm + 1;
                        continue;
                    }
                    this.pattern(program, program.expression_at(subject).value_type, program.arm_at(arm));
                    this.text.append(Str::new(" => { "));
                    this.inline_observations(program, program.arm_at(arm).observations);
                    this.expression(program, program.arm_at(arm).body);
                    this.text.append(Str::new(" } "));
                    arm = arm + 1;
                }
                this.text.append(Str::new("})"));
            }
            ExpressionKind::Closure(index) => {
                const closure: Closure = program.closure_at(index);
                this.text.append(Str::new("("));
                mut position: i64 = 0;
                while (position < closure.parameter_count) {
                    if (position > 0) { this.text.append(Str::new(", ")); }
                    const parameter: i64 = program.list_at(closure.first_parameter + position);
                    this.name(program, parameter);
                    this.text.append(f": {program.type_name(program.variable_at(parameter).value_type).as_str()}");
                    position = position + 1;
                }
                this.text.append(f") -> {program.type_name(program.signature_of(closure.function_type).returns).as_str()} ");
                this.text.append(Str::new("{ "));
                this.inline_observations(program, closure.observations);
                this.text.append(Str::new("return "));
                this.expression(program, closure.body);
                this.text.append(Str::new("; }"));
            }
            ExpressionKind::Invoke(callee, first, count) => {
                this.expression(program, callee);
                this.text.append(Str::new("("));
                this.arguments(program, first, count);
            }
            ExpressionKind::Conditional(condition, then_value, else_value) => {
                this.text.append(Str::new("(if ("));
                this.expression(program, condition);
                this.text.append(Str::new(") { "));
                this.expression(program, then_value);
                this.text.append(Str::new(" } else { "));
                this.expression(program, else_value);
                this.text.append(Str::new(" })"));
            }
            ExpressionKind::Call(callee, first, count) => {
                const called: Function = program.function_at(callee);
                if (called.is_unowned()) {
                    this.text.append(f"h{called.number}(");
                } else {
                    this.text.append(f"S{called.owner.structure()}::m{called.number}(");
                }
                this.arguments(program, first, count);
            }
            ExpressionKind::GenericCall(callee, type_argument, spelling, first, count) => {
                const called: Function = program.function_at(callee);
                if (called.is_unowned()) {
                    this.text.append(f"{Printer::generic_prefix(&called)}{called.number}");
                } else {
                    this.text.append(f"B{program.template_at(program.structure_at(called.owner.structure()).template).number}");
                }
                const callable: Str = if (called.takes_callable()) { Str::new(", _") } else { Str::new("") };
                match (spelling) {
                    TypeArgumentSpelling::Written     => { this.text.append(f"::<{program.type_name(type_argument).as_str()}{callable}>"); }
                    TypeArgumentSpelling::Placeholder => { this.text.append(f"::<_{callable}>"); }
                    TypeArgumentSpelling::Omitted     => { }
                }
                if (!called.is_unowned()) { this.text.append(f"::m{called.number}"); }
                this.text.append(Str::new("("));
                this.arguments(program, first, count);
            }
            ExpressionKind::MethodCall(receiver, callee, first, count) => {
                this.expression(program, receiver);
                const called: Function = program.function_at(callee);
                this.text.append(f".{Printer::method_prefix(&called)}{called.number}(");
                this.arguments(program, first, count);
            }
            ExpressionKind::Borrow(variable) => {
                this.text.append(Str::new("&"));
                this.name(program, variable);
            }
            ExpressionKind::ArrayLiteral(first, count) => {
                this.text.append(Str::new("["));
                mut position: i64 = 0;
                while (position < count) {
                    if (position > 0) { this.text.append(Str::new(", ")); }
                    this.expression(program, program.list_at(first + position));
                    position = position + 1;
                }
                this.text.append(Str::new("]"));
            }
            ExpressionKind::ArrayRepeat(value) => {
                this.text.append(Str::new("["));
                this.expression(program, value);
                this.text.append(f"; {node.value_type.array_length()}]");
            }
            ExpressionKind::Element(variable, index) => {
                this.name(program, variable);
                this.text.append(Str::new("["));
                this.expression(program, index);
                this.text.append(Str::new("]"));
            }
            ExpressionKind::Length(variable) => {
                this.name(program, variable);
                this.text.append(Str::new(".length()"));
            }
            ExpressionKind::TextLiteral(code) => { this.text.append(f"String::from(\"{Program::text_of(code).as_str()}\")"); }
            ExpressionKind::TextOf(value) => {
                this.text.append(Str::new("String::from("));
                this.expression(program, value);
                this.text.append(Str::new(")"));
            }
            ExpressionKind::EmptyText => { this.text.append(Str::new("String::new()")); }
            ExpressionKind::StrLiteral(code) => { this.text.append(f"\"{Program::text_of(code).as_str()}\""); }
            ExpressionKind::AsStr(variable) => {
                this.name(program, variable);
                this.text.append(Str::new(".as_str()"));
            }
            ExpressionKind::Push(variable, value) => {
                this.name(program, variable);
                this.text.append(Str::new(".append("));
                this.expression(program, value);
                this.text.append(Str::new(")"));
            }
            ExpressionKind::EmptyArray => { this.text.append(Str::new("Array::new()")); }
            ExpressionKind::DynamicRepeat(value, count) => {
                this.text.append(Str::new("["));
                this.expression(program, value);
                this.text.append(f"; {count}]");
            }
            ExpressionKind::Duplicate(variable) => {
                this.name(program, variable);
                this.text.append(Str::new(".clone()"));
            }
            ExpressionKind::Append(variable, value) => {
                this.name(program, variable);
                this.text.append(Str::new(".push("));
                this.expression(program, value);
                this.text.append(Str::new(")"));
            }
            ExpressionKind::Pop(variable) => {
                this.name(program, variable);
                this.text.append(Str::new(".pop().unwrap()"));
            }
            ExpressionKind::EmptyMap => { this.text.append(Str::new("HashMap::new()")); }
            ExpressionKind::Insert(map, key, value, default_value) => {
                this.name(program, map);
                this.text.append(Str::new(".insert("));
                this.expression(program, key);
                this.text.append(Str::new(", "));
                this.expression(program, value);
                this.text.append(Str::new(").unwrap_or("));
                this.expression(program, default_value);
                this.text.append(Str::new(")"));
            }
            ExpressionKind::Lookup(map, key, default_value) => {
                this.name(program, map);
                this.text.append(Str::new(".get(&"));
                this.expression(program, key);
                this.text.append(Str::new(").unwrap_or("));
                this.expression(program, default_value);
                this.text.append(Str::new(")"));
            }
            ExpressionKind::Removal(map, key, default_value) => {
                this.name(program, map);
                this.text.append(Str::new(".remove(&"));
                this.expression(program, key);
                this.text.append(Str::new(").unwrap_or("));
                this.expression(program, default_value);
                this.text.append(Str::new(")"));
            }
            ExpressionKind::Contains(map, key) => {
                this.name(program, map);
                this.text.append(Str::new(".contains_key(&"));
                this.expression(program, key);
                this.text.append(Str::new(")"));
            }
            ExpressionKind::TraitCall(receiver, method, first, count) => {
                this.expression(program, receiver);
                this.text.append(f".t{program.trait_method_at(method).number}(");
                this.arguments(program, first, count);
            }
            ExpressionKind::Field(base, field) => {
                this.expression(program, base);
                this.text.append(f".f{program.field_at(field).number}");
            }
            ExpressionKind::StructureLiteral(structure, spelling, first, count) => {
                this.text.append(f"{program.literal_path(structure, spelling).as_str()} ");
                this.literal_entries(program, first, count);
            }
            ExpressionKind::OwnedLiteral(owned, first, count) => {
                this.text.append(f"D{program.owned_at(owned).number} ");
                this.literal_entries(program, first, count);
            }
            ExpressionKind::Move(variable) => { this.name(program, variable); }
            ExpressionKind::BorrowTemporary(value) => {
                this.text.append(Str::new("&("));
                this.expression(program, value);
                this.text.append(Str::new(")"));
            }
            ExpressionKind::Dereference(operand) => {
                this.text.append(Str::new("*"));
                this.expression(program, operand);
            }
            ExpressionKind::Hold(value, spelling) => {
                this.text.append(Printer::holder_path(program, node.value_type, spelling).as_str());
                this.text.append(Printer::holding_variant(node.value_type));
                this.text.append(Str::new("("));
                this.expression(program, value);
                this.text.append(Str::new(")"));
            }
            ExpressionKind::Absent(code, spelling) => {
                this.text.append(Printer::holder_path(program, node.value_type, spelling).as_str());
                if (code < 0) {
                    this.text.append(Str::new("::None"));
                } else {
                    this.text.append(Str::new("::Err("));
                    this.expression(program, code);
                    this.text.append(Str::new(")"));
                }
            }
            ExpressionKind::Share(variable) => {
                this.name(program, variable);
                this.text.append(Str::new(".clone()"));
            }
            ExpressionKind::Count(owner) => {
                this.receiver(program, owner);
                this.text.append(Str::new(".strong_count()"));
            }
            ExpressionKind::Unwrap(variable) => {
                this.name(program, variable);
                this.text.append(Str::new(".unwrap()"));
            }
            ExpressionKind::Propagate(value) => {
                this.text.append(Str::new("("));
                this.expression(program, value);
                this.text.append(Str::new(")?"));
            }
            ExpressionKind::Presence(subject, binding, present, error_binding, absent) => {
                const fallible: boolean = error_binding >= 0;
                this.text.append(Str::new("(match ("));
                this.expression(program, subject);
                this.text.append(if (fallible) { Str::new(") { Result::Ok(") } else { Str::new(") { Option::Some(") });
                this.name(program, binding);
                this.text.append(Str::new(") => { "));
                this.expression(program, present);
                if (fallible) {
                    this.text.append(Str::new(" } Result::Err("));
                    this.name(program, error_binding);
                    this.text.append(Str::new(") => { "));
                } else {
                    this.text.append(Str::new(" } Option::None => { "));
                }
                this.expression(program, absent);
                this.text.append(Str::new(" } })"));
            }
        }
    }

    /// A holder type's path before its member: `Box`, `Rc`, `Option`,
    /// `Result`, or with `Written` its type spelled as a path,
    /// `Option::<D0>`, `Result::<D0, u32>`.
    private static holder_path(program: &Program, holder: ValueType, spelling: TypeArgumentSpelling) -> String {
        const name: String = program.type_name(holder);
        const opening: i64 = name.as_str().find("<").unwrap_or(name.length());
        mut path: String = String::from_str(name.as_str().byte_substring(0, opening));
        match (spelling) {
            TypeArgumentSpelling::Written => {
                path.append(Str::new("::"));
                path.append(name.as_str().byte_substring(opening, name.length()));
            }
            _ => { }
        }
        return path;
    }

    /// The member a holder's value is built with: `::new` for a box or a
    /// shared owner, `::Some` for an option, `::Ok` for a result.
    private static holding_variant(holder: ValueType) -> Str {
        return match (holder) {
            ValueType::Boxed(_)    => { Str::new("::new") }
            ValueType::Counted(_)  => { Str::new("::new") }
            ValueType::Optional(_) => { Str::new("::Some") }
            _                      => { Str::new("::Ok") }
        };
    }

    /// A literal's braces and its `count` entries from `first` in the index
    /// lists, each a field and its value: `{ f1: a, f0: b }`, or `{}`.
    private literal_entries(mut &this, program: &Program, first: i64, count: i64) -> void {
        this.text.append(Str::new("{"));
        mut entry: i64 = 0;
        mut written: i64 = 0;
        while (entry < count) {
            const field: i64 = program.list_at(first + 2 * entry);
            if (!program.omits(Omission::Field(field))) {
                this.text.append(if (written > 0) { Str::new(", ") } else { Str::new(" ") });
                this.text.append(f"f{program.field_at(field).number}: ");
                this.expression(program, program.list_at(first + 2 * entry + 1));
                written = written + 1;
            }
            entry = entry + 1;
        }
        this.text.append(if (written > 0) { Str::new(" }") } else { Str::new("}") });
    }

    /// A call's arguments and its closing parenthesis.
    private arguments(mut &this, program: &Program, first: i64, count: i64) -> void {
        mut index: i64 = 0;
        while (index < count) {
            if (index > 0) { this.text.append(Str::new(", ")); }
            this.expression(program, program.list_at(first + index));
            index = index + 1;
        }
        this.text.append(Str::new(")"));
    }

    /// A `match` arm's pattern over a value of `matched`: `_`, or the
    /// arm's variant with its payload's elements, `E0::V0`,
    /// `E0::V1(b0, _)`.
    internal pattern(mut &this, program: &Program, matched: ValueType, arm: MatchArm) -> void {
        if (arm.pattern < 0) {
            this.text.append(Str::new("_"));
            return;
        }
        this.variant_pattern(program, matched, arm.pattern, arm.first_element, arm.element_count);
    }

    /// Variant `variant` of `matched` with `count` payload elements from
    /// `first` in the index lists: `E0::V0`, `G0::V1(b0, E0::V2(_))`.
    private variant_pattern(mut &this, program: &Program, matched: ValueType, variant: i64, first: i64, count: i64) -> void {
        this.text.append(f"{program.enumeration_path(matched.enumeration()).as_str()}::V{variant}");
        if (count == 0) { return; }
        this.text.append(Str::new("("));
        mut index: i64 = 0;
        while (index < count) {
            if (index > 0) { this.text.append(Str::new(", ")); }
            match (program.pattern_element_at(program.list_at(first + index))) {
                PatternElement::Binding(variable) => { this.name(program, variable); }
                PatternElement::Wildcard => { this.text.append(Str::new("_")); }
                PatternElement::Variant(inner, inner_variant, inner_first, inner_count) => {
                    this.variant_pattern(program, inner, inner_variant, inner_first, inner_count);
                }
            }
            index = index + 1;
        }
        this.text.append(Str::new(")"));
    }

    /// A method's receiver: a name, a field or a parenthesised expression
    /// as it prints, anything else in parentheses.
    private receiver(mut &this, program: &Program, index: i64) -> void {
        match (program.expression_at(index).kind) {
            ExpressionKind::Variable(_) => { this.expression(program, index); }
            ExpressionKind::Field(_, _) => { this.expression(program, index); }
            ExpressionKind::Unary(_, _) => { this.expression(program, index); }
            ExpressionKind::Binary(_, _, _) => { this.expression(program, index); }
            ExpressionKind::Cast(_) => { this.expression(program, index); }
            ExpressionKind::Conditional(_, _, _) => { this.expression(program, index); }
            ExpressionKind::Match(_, _, _) => { this.expression(program, index); }
            _ => {
                this.text.append(Str::new("("));
                this.expression(program, index);
                this.text.append(Str::new(")"));
            }
        }
    }
}
