///! Printing a `Program` as Cryo source.
///!
///! Every binary, unary, cast and `if` expression is parenthesised, so
///! precedence never decides a meaning, and every statement and every field
///! has a line of its own, so a line-based reducer can delete one.  A
///! struct's methods are printed inside its body, and every struct before
///! the free functions.
///!
///! One struct, `Printer`, with its methods in three files:
///!
///!   printer      the struct, `print`, the header, the prelude that defines
///!                the hash, structs, functions and names
///!   statements   statements and blocks
///!   expressions  expressions, arguments and receivers
///!
///! Imports the model, `configuration` (the header) and `guarantees` (the
///! hash's definition); it never reads a random stream.

namespace cryosmith::emit;

module {
    emit::printer;
    emit::statements;
    emit::expressions;
}

export cryosmith::emit::printer::{ Printer };
