///! cryosmith - a seeded generator of random, valid, deterministic Cryo
///! programs, for differential testing of the compiler.
///!
///! `cryosmith <command> [options]`; `cryosmith help` lists the commands.
///! DESIGN.md beside this tool states what a generated program guarantees
///! and how the layers below are arranged.

namespace cryosmith::main;

import std::env;

import cryosmith::cli::{ Cli };

function main() -> i32 {
    return Cli::run(&env::args());
}
