///! `GenerationArguments`: the generation options as a command line spells
///! them, declared and read the same way by every command that generates.

namespace cryosmith::configuration::arguments;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::convert::{ TryFrom };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::env::arguments::{ ArgumentParser, ParsedArguments };
import std::fs::file::{ File };
import std::fs::path::{ PathBuf };

import cryosmith::configuration::features::{ FeatureSet };
import cryosmith::configuration::options::{ GenerationOptions, Plant };

/// The options every generating command takes.
public type struct GenerationArguments {
    /// Declare the generation options on `parser`.
    public static declare(parser: mut &ArgumentParser) -> void {
        parser.option(Str::new("features"), Option::None, Str::new("LIST"), Str::new("enabled features, comma-separated"))
            .option(Str::new("functions"), Option::None, Str::new("N"), Str::new("helper functions (default: from the seed)"))
            .option(Str::new("size"), Option::None, Str::new("N"), Str::new("statements per function"))
            .option(Str::new("plant"), Option::None, Str::new("NAME"), Str::new("a deliberate defect, for a check's control"))
            .option(Str::new("omissions"), Option::None, Str::new("FILE"), Str::new("what a reducer takes out, a path per entry"))
            .option(Str::new("mutation"), Option::None, Str::new("M"), Str::new("mutation M of the program, for the crash fuzzer"))
            .flag(Str::new("no-header"), Option::None, Str::new("leave the header comment out"));
    }

    /// The paths of the omissions `--omissions FILE` lists, in the order
    /// listed, separated by commas, spaces or line ends; none without the
    /// option.  The one file a command reads, named by the command line,
    /// so the same arguments still give the same text.
    public static omissions(parsed: &ParsedArguments) -> Result<Array<String>, String> {
        mut paths: Array<String> = Array::<String>::new();
        const file: Str = match (parsed.value(Str::new("omissions"))) {
            Option::Some(file) => { file }
            Option::None       => { return Result::Ok(paths); }
        };
        const text: String = match (File::read_text(PathBuf::from(file).as_path())) {
            Result::Ok(text)    => { text }
            Result::Err(reason) => { return Result::Err(f"cannot read {file}: {reason}"); }
        };
        for (line in text.as_str().split("\n")) {
            for (entry in line.split(",")) {
                for (word in entry.split(" ")) {
                    const path: Str = word.trim();
                    if (!path.is_empty()) { paths.push(String::from_str(path)); }
                }
            }
        }
        return Result::Ok(paths);
    }

    /// The generation options `parsed` gives, for `seed`.
    public static read(parsed: &ParsedArguments, seed: u64) -> Result<GenerationOptions, String> {
        mut options: GenerationOptions = GenerationOptions::new(seed);
        match (parsed.value(Str::new("features"))) {
            Option::Some(list) => { options.features = FeatureSet::parse(list)?; }
            Option::None       => { }
        }
        match (GenerationArguments::number(parsed, Str::new("functions"))?) {
            Option::Some(count) => { options.functions = count as i64; }
            Option::None        => { }
        }
        match (GenerationArguments::number(parsed, Str::new("size"))?) {
            Option::Some(size) => { options.size = size as i64; }
            Option::None       => { }
        }
        match (parsed.value(Str::new("plant"))) {
            Option::Some(name) => {
                match (Plant::named(name)) {
                    Option::Some(plant) => { options.plant = plant; }
                    Option::None        => { return Result::Err(f"unknown plant `{name}`; the plants are `none`, `unguarded-division` and `uncopied-type-parameter`"); }
                }
            }
            Option::None => { }
        }
        options.header = !parsed.flag(Str::new("no-header"));
        return Result::Ok(options);
    }

    /// The decimal value of option `name`, if it was given.
    public static number(parsed: &ParsedArguments, name: Str) -> Result<Option<u64>, String> {
        match (parsed.value(name)) {
            Option::Some(text) => {
                return match (u64::try_from(text)) {
                    Result::Ok(value) => { Result::Ok(Option::Some(value)) }
                    Result::Err(_)    => { Result::Err(f"--{name} takes a decimal number, not `{text}`") }
                };
            }
            Option::None => { return Result::Ok(Option::None); }
        }
    }
}
