///! What a program is generated from: the seed, the enabled features, the
///! sizes, the header switch and a plant, and how a command line spells
///! them.  The generator's version is here too, since the header that
///! reproduces a program names it.
///!
///! Imports the model's neighbour `random` (a seed chooses the helper
///! count) and the standard library only.
///!
///!   features   `Feature` and `FeatureSet`: names, stages, canonical lists
///!   options    `GenerationOptions`, `Plant` and `GENERATOR_VERSION`
///!   arguments  `GenerationArguments`: the generation options on a
///!              command line, shared by every command that generates

namespace cryosmith::configuration;

module {
    configuration::features;
    configuration::options;
    configuration::arguments;
}

export cryosmith::configuration::features::{ Feature, FeatureSet };
export cryosmith::configuration::options::{ GENERATOR_VERSION, GenerationOptions, Plant };
export cryosmith::configuration::arguments::{ GenerationArguments };
