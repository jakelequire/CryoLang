///! `CorpusCheck`: the command's arguments, its seeds and its summary.
///!
///! Every program terminates by construction, so a run is not timed out: a
///! program that does not end is itself a finding, seen as a check that
///! does not end.

namespace cryosmith::corpus::check;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::env::arguments::{ ArgumentParser, ParsedArguments };
import std::fmt;
import std::fs::directory::{ Directory };
import std::fs::file::{ File };
import std::fs::path::{ PathBuf };

import cryosmith::configuration::{ GenerationArguments, GenerationOptions };
import cryosmith::emit::{ Printer };
import cryosmith::generate::{ Generator };

/// The corpus check's settings.
public type struct CorpusCheck {
    /// The compiler that builds every program.
    internal compiler: String;
    /// Where the programs and their builds go.
    internal work: String;
    /// The standard library the compiler builds against, when named.
    internal stdlib: Option<String>;

    /// Run the check over the arguments after `corpus-check`; 0 when every
    /// program passed, 1 when one failed, 2 on a usage error.
    public static run(arguments: &Array<String>) -> i32 {
        mut parser: ArgumentParser = ArgumentParser::new(Str::new("cryosmith corpus-check"));
        GenerationArguments::declare(&parser);
        parser.option(Str::new("cryo"), Option::None, Str::new("COMPILER"), Str::new("the compiler to build with"))
            .option(Str::new("work"), Option::None, Str::new("DIR"), Str::new("where the programs and builds go"))
            .option(Str::new("stdlib"), Option::None, Str::new("DIR"), Str::new("the standard library the compiler builds against"))
            .option(Str::new("first-seed"), Option::None, Str::new("N"), Str::new("the first seed"))
            .option(Str::new("count"), Option::None, Str::new("K"), Str::new("how many programs"));
        const parsed: ParsedArguments = match (parser.parse(arguments.as_slice())) {
            Result::Ok(parsed) => { parsed }
            Result::Err(error) => { fmt::eprintln(f"{error}"); fmt::eprint(parser.help_text()); return 2; }
        };
        const compiler: Str = match (parsed.value(Str::new("cryo"))) {
            Option::Some(compiler) => { compiler }
            Option::None           => { fmt::eprintln(String::from_str(Str::new("cryosmith corpus-check: --cryo is required"))); return 2; }
        };
        const work: Str = match (parsed.value(Str::new("work"))) {
            Option::Some(work) => { work }
            Option::None       => { fmt::eprintln(String::from_str(Str::new("cryosmith corpus-check: --work is required"))); return 2; }
        };
        const first: u64 = match (GenerationArguments::number(&parsed, Str::new("first-seed"))) {
            Result::Ok(value)   => { value.unwrap_or(1) }
            Result::Err(reason) => { fmt::eprintln(reason); return 2; }
        };
        const count: u64 = match (GenerationArguments::number(&parsed, Str::new("count"))) {
            Result::Ok(value)   => { value.unwrap_or(200) }
            Result::Err(reason) => { fmt::eprintln(reason); return 2; }
        };
        match (Directory::create_all(PathBuf::from(work).as_path())) {
            Result::Ok(_)       => { }
            Result::Err(reason) => { fmt::eprintln(f"cryosmith: cannot create {work}: {reason}"); return 1; }
        }
        const check: CorpusCheck = CorpusCheck {
            compiler: String::from_str(compiler),
            work: String::from_str(work),
            stdlib: match (parsed.value(Str::new("stdlib"))) {
                Option::Some(stdlib) => { Option::Some(String::from_str(stdlib)) }
                Option::None         => { Option::None }
            },
        };
        mut failed: u64 = 0;
        mut hashes: Array<String> = Array::<String>::new();
        mut offset: u64 = 0;
        while (offset < count) {
            const seed: u64 = first.wrapping_add(offset);
            const options: GenerationOptions = match (GenerationArguments::read(&parsed, seed)) {
                Result::Ok(options) => { options }
                Result::Err(reason) => { fmt::eprintln(reason); return 2; }
            };
            match (check.program(options)) {
                Result::Ok(hash) => {
                    fmt::println(f"ok    seed {seed} {hash.as_str()}");
                    if (!hashes.contains(&hash)) { hashes.push(hash); }
                }
                Result::Err(reason) => { fmt::println(f"FAIL  seed {seed}: {reason.as_str()}"); failed = failed + 1; }
            }
            offset = offset + 1;
        }
        if (failed > 0) {
            fmt::println(f"corpus-check: FAIL ({failed} of {count} programs)");
            return 1;
        }
        fmt::println(f"corpus-check: OK ({count} programs, -O0 and -O2 agree, {hashes.length()} distinct hashes)");
        return 0;
    }

    /// Write, build twice and run twice the program `options` describe; its
    /// hash line, or why it failed.
    private program(&this, options: GenerationOptions) -> Result<String, String> {
        const name: String = f"smith-{options.seed}";
        const source: PathBuf = this.path(f"{name.as_str()}.cryo".as_str());
        const text: String = Printer::print(&Generator::generate(options), &options);
        match (File::write_text(source.as_path(), text.as_str())) {
            Result::Ok(_)       => { }
            Result::Err(reason) => { return Result::Err(f"cannot write {source.as_path().as_str()}: {reason}"); }
        }
        const unoptimised: PathBuf = this.path(f"{name.as_str()}-O0.exe".as_str());
        const optimised: PathBuf = this.path(f"{name.as_str()}-O2.exe".as_str());
        this.build(&source, &unoptimised, Str::new("--opt-level=0"))?;
        this.build(&source, &optimised, Str::new("--opt-level=2"))?;
        const first: String = this.execute(&unoptimised)?;
        const second: String = this.execute(&optimised)?;
        if (first.as_str() != second.as_str()) {
            return Result::Err(f"-O0 printed `{first.as_str()}`, -O2 printed `{second.as_str()}`");
        }
        CorpusCheck::remove(&unoptimised)?;
        CorpusCheck::remove(&optimised)?;
        return Result::Ok(first);
    }

    /// `file` in the work directory.
    internal path(&this, file: Str) -> PathBuf {
        mut path: PathBuf = PathBuf::from(this.work.as_str());
        path.push(file);
        return path;
    }
}
