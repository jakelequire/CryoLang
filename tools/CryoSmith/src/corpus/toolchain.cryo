///! Building a program with the compiler the check names, running the
///! result, and reading what it printed against the output contract.

namespace cryosmith::corpus::toolchain;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::fs::file::{ File };
import std::fs::path::{ PathBuf };
import std::process::command::{ Command, Output };

import cryosmith::corpus::check::{ CorpusCheck };
import cryosmith::guarantees::{ Observation };

/// How many lines of a failed build's output a report quotes.
const QUOTED_LINES: i64 = 6;

implement struct CorpusCheck {
    /// Build `source` into `output` at `level`.
    internal build(&this, source: &PathBuf, output: &PathBuf, level: Str) -> Result<(), String> {
        mut command: Command = Command::new(this.compiler.as_str());
        command.current_directory(this.work.as_str());
        command.argument(Str::new("build")).argument(f"{source.as_path().as_str()}".as_str()).argument(level)
            .argument(Str::new("-o")).argument(f"{output.as_path().as_str()}".as_str());
        match (&this.stdlib) {
            Option::Some(stdlib) => { command.argument(f"--stdlib={stdlib.as_str()}".as_str()); }
            Option::None         => { }
        }
        const result: Output = match (command.output()) {
            Result::Ok(result)  => { result }
            Result::Err(reason) => { return Result::Err(f"the compiler could not start: {reason}"); }
        };
        if (!result.status().success()) {
            return Result::Err(f"{level} build failed ({CorpusCheck::status_text(&result)}): {CorpusCheck::first_lines(&result)}");
        }
        return Result::Ok(());
    }

    /// Run `program`; the one line it printed, which must be the hash line.
    internal execute(&this, program: &PathBuf) -> Result<String, String> {
        mut command: Command = Command::new(f"{program.as_path().as_str()}".as_str());
        command.current_directory(this.work.as_str());
        const result: Output = match (command.output()) {
            Result::Ok(result)  => { result }
            Result::Err(reason) => { return Result::Err(f"{program.as_path().as_str()} could not start: {reason}"); }
        };
        if (!result.status().success()) {
            return Result::Err(f"{program.as_path().as_str()} ended with {CorpusCheck::status_text(&result)}");
        }
        const printed: Str = match (Str::from_utf8(result.stdout())) {
            Result::Ok(printed) => { printed.trim_end() }
            Result::Err(_)      => { return Result::Err(f"{program.as_path().as_str()} printed bytes that are not UTF-8"); }
        };
        if (!printed.starts_with(&Observation::hash_line_prefix()) || printed.contains(&Str::new("\n"))) {
            return Result::Err(f"{program.as_path().as_str()} printed `{printed}`, not one hash line");
        }
        return Result::Ok(String::from_str(printed));
    }

    /// Remove a passing program's executable.
    internal static remove(path: &PathBuf) -> Result<(), String> {
        return match (File::remove(path.as_path())) {
            Result::Ok(_)       => { Result::Ok(()) }
            Result::Err(reason) => { Result::Err(f"cannot remove {path.as_path().as_str()}: {reason}") }
        };
    }

    /// How a child ended: its exit code, or the signal that ended it.
    private static status_text(result: &Output) -> String {
        return match (result.status().exit_code()) {
            Option::Some(code) => { f"exit {code}" }
            Option::None       => { f"signal {result.status().terminating_signal().unwrap_or(0)}" }
        };
    }

    /// The first lines of a child's error and output streams, for a report.
    private static first_lines(result: &Output) -> String {
        mut text: String = String::new();
        mut lines: i64 = 0;
        for (stream in [result.stderr(), result.stdout()]) {
            match (Str::from_utf8(stream)) {
                Result::Ok(content) => {
                    for (line in content.lines()) {
                        if (lines >= QUOTED_LINES) { break; }
                        if (line.trim().is_empty()) { continue; }
                        text.push(Str::new(" | "));
                        text.push(line.trim());
                        lines = lines + 1;
                    }
                }
                Result::Err(_) => { }
            }
        }
        return text;
    }
}
