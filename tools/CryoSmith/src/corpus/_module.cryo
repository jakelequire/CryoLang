///! `cryosmith corpus-check`: CryoSmith's acceptance test, and the one place
///! it runs a compiler.
///!
///! For each seed it writes the program, builds it at `--opt-level=0` and at
///! `--opt-level=2`, and runs both.  A program passes when both builds
///! succeed, both runs exit 0, and both print the same single line,
///! `cryosmith-hash <u64>`.  A failure is a generator defect or a compiler
///! finding; either way the program and its builds stay in the work
///! directory, and a passing seed's executables are removed.
///!
///!   check      `CorpusCheck`: the command, its seeds and its summary
///!   toolchain  building a program with the compiler named, and running it
///!
///! Imports `generate`, `emit`, `configuration` and `guarantees`.

namespace cryosmith::corpus;

module {
    corpus::check;
    corpus::toolchain;
}

export cryosmith::corpus::check::{ CorpusCheck };
