///! `TypeChoice`: drawing the type of a value to generate, from the types
///! the enabled features and the declared structs allow.

namespace cryosmith::typing::choice;

import std::collections::array::{ Array };

import cryosmith::configuration::{ Feature, FeatureSet };
import cryosmith::model::{ ValueType };
import cryosmith::random::{ RandomStream };

/// The type draws generation makes.
public type struct TypeChoice {
    /// An integer type, each equally likely.
    public static integer(random: mut &RandomStream) -> ValueType {
        return ValueType::integers().get(random.below(8)).unwrap();
    }

    /// An integer type, or sometimes `boolean` when booleans are enabled.
    public static scalar(random: mut &RandomStream, features: FeatureSet) -> ValueType {
        if (features.has(Feature::Booleans) && random.chance(15)) { return ValueType::Boolean; }
        return TypeChoice::integer(random);
    }

    /// A scalar type, or sometimes one of the `structures` structs the
    /// program declares.
    public static any(random: mut &RandomStream, features: FeatureSet, structures: i64) -> ValueType {
        if (structures > 0 && random.chance(20)) { return ValueType::Record(random.below(structures)); }
        return TypeChoice::scalar(random, features);
    }

    /// The integer types that widen to `wanted` implicitly.
    public static narrower(wanted: ValueType) -> Array<ValueType> {
        mut found: Array<ValueType> = Array::<ValueType>::new();
        for (candidate in ValueType::integers().iter()) {
            if (candidate.widens_to(wanted)) { found.push(candidate); }
        }
        return found;
    }
}
