///! `Mutation`: one edit that turns a valid program's text into a
///! near-valid one, for the crash fuzzer (section 9, item 9 of the design).
///!
///! An operator offers the sites the text has for it, in text order, each
///! an edit of a span of the program's body - everything after the
///! prelude's `mix` - so the hash state and its fold stay written as the
///! generator wrote them.  A mutation's number seeds a stream of its own,
///! which picks an operator among those with a site and then one of its
///! sites, so a seed, its options and the number give the same file.  The
///! printer's shape - one statement per line, every operation in
///! parentheses - is what lets a site be found in the text exactly.

namespace cryosmith::mutate::mutation;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };

import cryosmith::random::{ RandomStream };

/// What a mutation does to its site.
public type enum MutationOperator {
    /// A token of the body deleted: a name, a number or one punctuation
    /// character.
    DeleteToken;
    /// A token of the body written twice, a space between.
    DuplicateToken;
    /// A `}` of the body deleted.
    DropBrace;
    /// A `{` added at the end of a line of the body.
    ExtraBrace;
    /// A declared local's type left out: `const v0: u8 = 1;` written
    /// `const v0 = 1;`.
    DropAnnotation;
    /// A call of a function or method given its last argument fewer.
    DropArgument;
    /// A call of a function or method given its last argument twice.
    ExtraArgument;
    /// A declared local's type replaced by the next of the types the
    /// program's declarations name, in the order they first appear:
    /// `const v0: u8 = 1;` written `const v0: i64 = 1;`.
    SwapType;
    /// A call's first two arguments exchanged, where their texts differ.
    SwapArguments;
}

implement enum MutationOperator {
    /// Every operator, in the order a mutation draws among them.
    public static all() -> Array<MutationOperator> {
        return [MutationOperator::DeleteToken, MutationOperator::DuplicateToken, MutationOperator::DropBrace, MutationOperator::ExtraBrace,
                MutationOperator::DropAnnotation, MutationOperator::DropArgument, MutationOperator::ExtraArgument,
                MutationOperator::SwapType, MutationOperator::SwapArguments];
    }

    /// The operator's name, as a header and a report spell it.
    public name(&this) -> Str {
        return match (&this) {
            MutationOperator::DeleteToken    => { Str::new("delete-token") }
            MutationOperator::DuplicateToken => { Str::new("duplicate-token") }
            MutationOperator::DropBrace      => { Str::new("drop-brace") }
            MutationOperator::ExtraBrace     => { Str::new("extra-brace") }
            MutationOperator::DropAnnotation => { Str::new("drop-annotation") }
            MutationOperator::DropArgument   => { Str::new("drop-argument") }
            MutationOperator::ExtraArgument  => { Str::new("extra-argument") }
            MutationOperator::SwapType       => { Str::new("swap-type") }
            MutationOperator::SwapArguments  => { Str::new("swap-arguments") }
        };
    }
}

/// A span of a text: the bytes from `start` to `end`.
public type struct Span {
    /// Where it starts.
    public start: i64;
    /// Where it ends, past its last byte.
    public end: i64;
}

/// A call by a generated name, as its text has it: the name, the
/// parentheses and each argument, split at the commas outside any nested
/// parentheses, brackets or braces, without the space after a comma.
public type struct CallText {
    /// The name called.
    public name: Span;
    /// The `(` opening the arguments.
    public open: i64;
    /// The `)` closing them.
    public close: i64;
    /// Each argument's span, in order.
    public arguments: Array<Span>;
}

/// An edit of a text: the bytes from `start` to `end` replaced by
/// `replacement`.
public type struct TextEdit {
    /// Where the span starts.
    public start: i64;
    /// Where it ends, past its last byte.
    public end: i64;
    /// What it is replaced by.
    public replacement: String;
    /// Whether the edit leaves a program the compiler must refuse, so an
    /// acceptance of it is a finding.  Unmarked edits may leave a valid
    /// program.
    public refused: boolean;
}

/// One mutation of a program: its number, the operator it drew and the
/// site, by its place among the operator's sites.
public type struct Mutation {
    /// The number the mutation was drawn from.
    public number: u64;
    /// What it does.
    public operator: MutationOperator;
    /// Where, among the operator's sites in text order.
    public site: i64;

    /// Mutation `number` of `text`, the program of `seed`: an operator
    /// drawn among those with a site, then one of its sites; none when no
    /// operator has one.
    public static choose(seed: u64, number: u64, text: Str) -> Option<Mutation> {
        mut weights: Array<i64> = Array::<i64>::new();
        mut counts: Array<i64> = Array::<i64>::new();
        mut any: boolean = false;
        const operators: Array<MutationOperator> = MutationOperator::all();
        for (operator in operators.iter()) {
            const count: i64 = Mutation::sites(operator, text).length();
            counts.push(count);
            weights.push(if (count > 0) { 1 } else { 0 });
            if (count > 0) { any = true; }
        }
        if (!any) { return Option::None; }
        mut stream: RandomStream = RandomStream::for_mutation(seed, number);
        const drawn: i64 = stream.pick(&weights);
        return Option::Some(Mutation { number: number, operator: operators[drawn], site: stream.below(counts[drawn]) });
    }

    /// `text` with the mutation made, and the header's first line, when it
    /// has one, ending ` mutation <number> <operator> <site>`; none when
    /// the text has no such site.
    public apply(&this, text: Str) -> Option<String> {
        const edits: Array<TextEdit> = Mutation::sites(this.operator, text);
        if (this.site < 0 || this.site >= edits.length()) { return Option::None; }
        mut mutated: String = String::from_str(text.byte_substring(0, edits[this.site].start));
        mutated.append(edits[this.site].replacement.as_str());
        mutated.append(text.byte_substring(edits[this.site].end, text.length()));
        if (!mutated.as_str().starts_with(&Str::new("// cryosmith "))) { return Option::Some(mutated); }
        const header_end: i64 = mutated.as_str().find(&Str::new("\n")).unwrap_or(mutated.length());
        mut headed: String = String::from_str(mutated.as_str().byte_substring(0, header_end));
        headed.append(f" mutation {this.number} {this.operator.name()} {this.site}".as_str());
        headed.append(mutated.as_str().byte_substring(header_end, mutated.length()));
        return Option::Some(headed);
    }

    /// Whether the edit this mutation makes in `text` leaves a program the
    /// compiler must refuse: an argument dropped from, or added to, a call
    /// of a name declared exactly once, or a number, a bracket or a
    /// generated name written twice outside a string literal.
    public must_be_refused(&this, text: Str) -> boolean {
        const edits: Array<TextEdit> = Mutation::sites(this.operator, text);
        if (this.site < 0 || this.site >= edits.length()) { return false; }
        return edits[this.site].refused;
    }

    /// Every site `operator` has in `text`'s body, in text order.
    public static sites(operator: MutationOperator, text: Str) -> Array<TextEdit> {
        const body: i64 = Mutation::body_start(text);
        return match (operator) {
            MutationOperator::DeleteToken    => { Mutation::token_edits(text, body, false) }
            MutationOperator::DuplicateToken => { Mutation::token_edits(text, body, true) }
            MutationOperator::DropBrace      => { Mutation::byte_edits(text, body, Str::new("}"), Str::new("")) }
            MutationOperator::ExtraBrace     => { Mutation::byte_edits(text, body, Str::new("\n"), Str::new(" {\n")) }
            MutationOperator::DropAnnotation => { Mutation::annotation_edits(text, body) }
            MutationOperator::DropArgument   => { Mutation::argument_edits(text, body, false) }
            MutationOperator::ExtraArgument  => { Mutation::argument_edits(text, body, true) }
            MutationOperator::SwapType       => { Mutation::type_edits(text, body) }
            MutationOperator::SwapArguments  => { Mutation::swap_edits(text, body) }
        };
    }

    /// Where the body starts: past the closing brace of the prelude's
    /// `mix`, the first line that is only `}`.
    private static body_start(text: Str) -> i64 {
        return match (text.find(&Str::new("\n}\n"))) {
            Option::Some(at) => { at + 3 }
            Option::None     => { 0 }
        };
    }

    /// Whether the one-byte `character` belongs to a name or a number.
    private static is_word(character: Str) -> boolean {
        return Str::new("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_").contains(&character);
    }

    /// The tokens of `text` from `from`, as spans: each name or number
    /// whole, each other byte that is not a space or a line end alone.
    private static tokens(text: Str, from: i64) -> Array<TextEdit> {
        mut tokens: Array<TextEdit> = Array::<TextEdit>::new();
        mut at: i64 = from;
        while (at < text.length()) {
            const character: Str = text.byte_substring(at, at + 1);
            if (character == Str::new(" ") || character == Str::new("\n")) {
                at = at + 1;
                continue;
            }
            mut end: i64 = at + 1;
            if (Mutation::is_word(character)) {
                while (end < text.length() && Mutation::is_word(text.byte_substring(end, end + 1))) { end = end + 1; }
            }
            tokens.push(TextEdit { start: at, end: end, replacement: String::from_str(text.byte_substring(at, end)), refused: false });
            at = end;
        }
        return tokens;
    }

    /// Each token from `from` deleted, or with `twice` written twice.  A
    /// number, a bracket or a generated name written twice outside a
    /// string literal is marked refused: two numbers or two names never
    /// stand side by side in the language, and a doubled bracket leaves
    /// the brackets unbalanced.  Any other token may double into valid
    /// text (`- -x`, `;;`), and one inside a string literal is text.
    private static token_edits(text: Str, from: i64, twice: boolean) -> Array<TextEdit> {
        mut edits: Array<TextEdit> = Array::<TextEdit>::new();
        const tokens: Array<TextEdit> = Mutation::tokens(text, from);
        const strings: Array<Span> = Mutation::string_spans(text);
        mut next_string: i64 = 0;
        for (token in tokens.iterate_references()) {
            mut replacement: String = String::new();
            mut refused: boolean = false;
            if (twice) {
                replacement.append(token.replacement.as_str());
                replacement.append(Str::new(" "));
                replacement.append(token.replacement.as_str());
                while (next_string < strings.length() && strings[next_string].end <= token.start) { next_string = next_string + 1; }
                const quoted: boolean = next_string < strings.length() && strings[next_string].start <= token.start;
                // A generated name is letters, then digits: `v3`, `S0`, `u8`.
                const spelled: Str = token.replacement.as_str();
                mut letters: i64 = 0;
                while (letters < spelled.length() && !Str::new("0123456789_").contains(&spelled.byte_substring(letters, letters + 1))) { letters = letters + 1; }
                const generated: boolean = letters > 0 && Mutation::all_digits(spelled.byte_substring(letters, spelled.length()));
                const number: boolean = letters == 0 && Mutation::is_word(spelled.byte_substring(0, 1)) && spelled.byte_substring(0, 1) != Str::new("_");
                refused = !quoted && (number || generated || Str::new("()[]{}").contains(&spelled));
            }
            edits.push(TextEdit { start: token.start, end: token.end, replacement: replacement, refused: refused });
        }
        return edits;
    }

    /// The string literals of `text`, their quotes included, in text
    /// order: each from a `"` to the next `"` no backslash escapes.  An
    /// f-string's holes lie inside its span.
    private static string_spans(text: Str) -> Array<Span> {
        mut spans: Array<Span> = Array::<Span>::new();
        mut opened: i64 = -1;
        mut at: i64 = 0;
        while (at < text.length()) {
            const character: Str = text.byte_substring(at, at + 1);
            if (opened >= 0 && character == Str::new("\\")) {
                at = at + 2;
                continue;
            }
            if (character == Str::new("\"")) {
                if (opened < 0) {
                    opened = at;
                } else {
                    spans.push(Span { start: opened, end: at + 1 });
                    opened = -1;
                }
            }
            at = at + 1;
        }
        return spans;
    }

    /// Each occurrence of the one-byte `found` from `from`, replaced by
    /// `replacement`.
    private static byte_edits(text: Str, from: i64, found: Str, replacement: Str) -> Array<TextEdit> {
        mut edits: Array<TextEdit> = Array::<TextEdit>::new();
        mut at: i64 = from;
        while (at < text.length()) {
            if (text.byte_substring(at, at + 1) == found) { edits.push(TextEdit { start: at, end: at + 1, replacement: String::from_str(replacement), refused: false }); }
            at = at + 1;
        }
        return edits;
    }

    /// The type of each declaration line from `from` - `const` or `mut`
    /// first, then a name and `: T = ` - as the span of its `T`.
    private static declared_types(text: Str, from: i64) -> Array<Span> {
        mut types: Array<Span> = Array::<Span>::new();
        mut start: i64 = from;
        while (start < text.length()) {
            const rest: Str = text.byte_substring(start, text.length());
            const length: i64 = rest.find(&Str::new("\n")).unwrap_or(rest.length());
            const line: Str = rest.byte_substring(0, length);
            const declared: Str = line.trim_start();
            if (declared.starts_with(&Str::new("const ")) || declared.starts_with(&Str::new("mut "))) {
                const colon: Option<i64> = line.find(&Str::new(": "));
                const equals: Option<i64> = line.find(&Str::new(" = "));
                if (colon.is_some() && equals.is_some() && colon.unwrap() < equals.unwrap()) {
                    types.push(Span { start: start + colon.unwrap() + 2, end: start + equals.unwrap() });
                }
            }
            start = start + length + 1;
        }
        return types;
    }

    /// Each declaration line from `from` with its `: T` taken out.
    private static annotation_edits(text: Str, from: i64) -> Array<TextEdit> {
        mut edits: Array<TextEdit> = Array::<TextEdit>::new();
        const types: Array<Span> = Mutation::declared_types(text, from);
        for (declared in types.iterate_references()) {
            edits.push(TextEdit { start: declared.start - 2, end: declared.end, replacement: String::new(), refused: false });
        }
        return edits;
    }

    /// Each declaration line from `from` with its type replaced by the
    /// next of the distinct types the declarations name, in the order
    /// they first appear, the last by the first; none when they name
    /// fewer than two.
    private static type_edits(text: Str, from: i64) -> Array<TextEdit> {
        const types: Array<Span> = Mutation::declared_types(text, from);
        mut distinct: Array<Str> = Array::<Str>::new();
        for (declared in types.iterate_references()) {
            const name: Str = text.byte_substring(declared.start, declared.end);
            if (!distinct.contains(&name)) { distinct.push(name); }
        }
        mut edits: Array<TextEdit> = Array::<TextEdit>::new();
        if (distinct.length() < 2) { return edits; }
        for (declared in types.iterate_references()) {
            const at: i64 = distinct.index_of(&text.byte_substring(declared.start, declared.end)).unwrap();
            const next: Str = distinct[(at + 1) % distinct.length()];
            edits.push(TextEdit { start: declared.start, end: declared.end, replacement: String::from_str(next), refused: false });
        }
        return edits;
    }

    /// Each call from `from` of a function or method by its generated name
    /// (`h3(`, `.m0(`, `.t2(`, `g1(`, `k0(`).
    private static calls(text: Str, from: i64) -> Array<CallText> {
        mut calls: Array<CallText> = Array::<CallText>::new();
        const tokens: Array<TextEdit> = Mutation::tokens(text, from);
        for (token in tokens.iterate_references()) {
            const name: Str = token.replacement.as_str();
            if (name.length() < 2 || !Str::new("hmtgk").contains(&name.byte_substring(0, 1)) || !Mutation::all_digits(name.byte_substring(1, name.length()))) { continue; }
            if (token.end >= text.length() || text.byte_substring(token.end, token.end + 1) != Str::new("(")) { continue; }
            const open: i64 = token.end;
            mut arguments: Array<Span> = Array::<Span>::new();
            mut depth: i64 = 0;
            mut argument_start: i64 = open + 1;
            mut close: i64 = -1;
            mut at: i64 = open;
            while (at < text.length() && close < 0) {
                const character: Str = text.byte_substring(at, at + 1);
                if (character == Str::new("(") || character == Str::new("[") || character == Str::new("{")) { depth = depth + 1; }
                if (character == Str::new(")") || character == Str::new("]") || character == Str::new("}")) {
                    depth = depth - 1;
                    if (depth == 0) { close = at; }
                }
                if ((character == Str::new(",") && depth == 1) || (close == at && at > open + 1)) {
                    arguments.push(Span { start: argument_start, end: at });
                    argument_start = at + 1;
                    if (argument_start < text.length() && text.byte_substring(argument_start, argument_start + 1) == Str::new(" ")) { argument_start = argument_start + 1; }
                }
                at = at + 1;
            }
            if (close < 0) { continue; }
            calls.push(CallText { name: Span { start: token.start, end: token.end }, open: open, close: close, arguments: arguments });
        }
        return calls;
    }

    /// Each call from `from` given at least one argument: its last
    /// argument dropped, or with `twice` written again after itself.  A
    /// call of a name declared exactly once is marked refused, since its
    /// one declaration takes exactly the arguments the generator gave it;
    /// a name declared more than once - an overload set, a trait's method
    /// and its implementations, methods of one name on several types - may
    /// have a declaration the edited call fits.
    private static argument_edits(text: Str, from: i64, twice: boolean) -> Array<TextEdit> {
        mut edits: Array<TextEdit> = Array::<TextEdit>::new();
        const calls: Array<CallText> = Mutation::calls(text, from);
        for (call in calls.iterate_references()) {
            const count: i64 = call.arguments.length();
            if (count == 0) { continue; }
            const last: Span = call.arguments[count - 1];
            // A name that begins its line's code, after `function `,
            // `static ` or nothing, is a declaration's - whose parameter list
            // may lose its last parameter validly when nothing calls it - or
            // a call statement's, which stays unmarked with it.
            const line_start: i64 = match (text.byte_substring(0, call.name.start).find_last(&Str::new("\n"))) {
                Option::Some(at) => { at + 1 }
                Option::None     => { 0 }
            };
            const lead: Str = text.byte_substring(line_start, call.name.start).trim_start();
            const declared_here: boolean = lead.is_empty() || lead == Str::new("function ") || lead == Str::new("static ");
            const refused: boolean = !declared_here && Mutation::declarations(text, text.byte_substring(call.name.start, call.name.end)) == 1;
            if (twice) {
                mut replacement: String = String::from_str(Str::new(", "));
                replacement.append(text.byte_substring(last.start, last.end));
                edits.push(TextEdit { start: call.close, end: call.close, replacement: replacement, refused: refused });
            } else {
                const dropped_from: i64 = if (count > 1) { call.arguments[count - 2].end } else { call.open + 1 };
                edits.push(TextEdit { start: dropped_from, end: call.close, replacement: String::new(), refused: refused });
            }
        }
        return edits;
    }

    /// How many declarations of the generated callable `name` `text` has:
    /// the lines that, past their indentation, begin `function name`,
    /// `static name`, or `name` followed by a receiver or a type parameter
    /// list (`name(&this`, `name(mut &this`, `name(this`, `name<`).  The
    /// printer writes every declaration of a function or method on such a
    /// line, and no call begins one: a function's call statement begins
    /// `name(` with an argument that is no receiver, a method's is reached
    /// through its object or type.  A call passing `this` as its first
    /// argument reads as a declaration too, which only keeps an edit
    /// unmarked.
    private static declarations(text: Str, name: Str) -> i64 {
        mut forms: Array<String> = Array::<String>::new();
        forms.push(f"function {name}(");
        forms.push(f"function {name}<");
        forms.push(f"static {name}(");
        forms.push(f"static {name}<");
        forms.push(f"{name}(&this");
        forms.push(f"{name}(mut &this");
        forms.push(f"{name}(this");
        forms.push(f"{name}<");
        mut found: i64 = 0;
        mut start: i64 = 0;
        while (start < text.length()) {
            const rest: Str = text.byte_substring(start, text.length());
            const length: i64 = rest.find(&Str::new("\n")).unwrap_or(rest.length());
            const line: Str = rest.byte_substring(0, length).trim_start();
            for (form in forms.iterate_references()) {
                if (line.starts_with(&form.as_str())) {
                    found = found + 1;
                    break;
                }
            }
            start = start + length + 1;
        }
        return found;
    }

    /// Each call from `from` given at least two arguments whose texts
    /// differ: its first two exchanged.
    private static swap_edits(text: Str, from: i64) -> Array<TextEdit> {
        mut edits: Array<TextEdit> = Array::<TextEdit>::new();
        const calls: Array<CallText> = Mutation::calls(text, from);
        for (call in calls.iterate_references()) {
            if (call.arguments.length() < 2) { continue; }
            const first: Span = call.arguments[0];
            const second: Span = call.arguments[1];
            const first_text: Str = text.byte_substring(first.start, first.end);
            const second_text: Str = text.byte_substring(second.start, second.end);
            if (first_text == second_text) { continue; }
            mut replacement: String = String::from_str(second_text);
            replacement.append(text.byte_substring(first.end, second.start));
            replacement.append(first_text);
            edits.push(TextEdit { start: first.start, end: second.end, replacement: replacement, refused: false });
        }
        return edits;
    }

    /// Whether `text` is one or more decimal digits.
    private static all_digits(text: Str) -> boolean {
        if (text.is_empty()) { return false; }
        mut at: i64 = 0;
        while (at < text.length()) {
            if (!Str::new("0123456789").contains(&text.byte_substring(at, at + 1))) { return false; }
            at = at + 1;
        }
        return true;
    }
}
