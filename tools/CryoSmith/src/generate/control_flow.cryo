///! Statements: declarations, stores, observations, branches, bounded loops,
///! loop exits, early returns, and calls made for their effect.
///!
///! A block observes every local it declared before it ends, and spends at
///! most half the statements left, so the block holding it keeps
///! statements of its own.  A loop counts a read-only counter to a literal
///! trip count, and its body's work is charged once per trip.

namespace cryosmith::generate::control_flow;

import std::collections::array::{ Array };

import cryosmith::configuration::{ Feature, FeatureSet };
import cryosmith::generate::generator::{ Generator };
import cryosmith::generate::structs::{ MethodCandidate };
import cryosmith::guarantees::{ MOST_LOOPS, MOST_TRIPS };
import cryosmith::model::{ BinaryOperator, LoopShape, StatementKind, ValueType };
import cryosmith::typing::{ TypeChoice };

/// How deep blocks nest.
const MOST_BLOCKS: i64 = 4;

implement struct Generator {
    /// Append statements to `statements`: until the budget is spent for a
    /// function's top block, else one to six.
    internal fill(mut &this, statements: mut &Array<i64>, top: boolean) -> void {
        if (this.statements_left <= 0) { return; }
        mut count: i64 = 1 + this.random.below(if (this.statements_left < 6) { this.statements_left } else { 6 });
        while (this.statements_left > 0 && (top || count > 0)) {
            this.statements_left = this.statements_left - 1;
            count = count - 1;
            statements.push(this.statement());
        }
    }

    /// A nested block: its statements, then an observation of each local
    /// it declared.  It spends at most half the statements left.
    internal block(mut &this) -> i64 {
        return this.block_observing(&Array::<i64>::new());
    }

    /// `block`, observing each of `entering` - names that came into scope
    /// with the block, a `match` arm's bindings - after its own locals.
    internal block_observing(mut &this, entering: &Array<i64>) -> i64 {
        return this.block_opening(&Array::<i64>::new(), entering);
    }

    /// `block_observing`, its statements opened by `opening`, statements
    /// already made.
    internal block_opening(mut &this, opening: &Array<i64>, entering: &Array<i64>) -> i64 {
        const start: i64 = this.environment.mark();
        const lengths: Array<i64> = this.environment.known_lengths();
        const reserved: i64 = this.statements_left / 2;
        this.statements_left = this.statements_left - reserved;
        this.block_depth = this.block_depth + 1;
        mut statements: Array<i64> = Array::<i64>::new();
        for (made in opening.iter()) { statements.push(made); }
        this.fill(&statements, false);
        this.observe_declared(start, &statements);
        for (variable in entering.iter()) { this.observe_place(this.read(variable), &statements); }
        this.environment.leave(start);
        this.environment.keep_fewest(&lengths);
        this.block_depth = this.block_depth - 1;
        this.statements_left = this.statements_left + reserved;
        return this.program.block(&statements);
    }

    /// One statement, chosen by weight from those allowed here.
    private statement(mut &this) -> i64 {
        this.environment.begin_statement();
        const features: FeatureSet = this.options.features;
        const nested: boolean = this.block_depth < MOST_BLOCKS;
        const writable: Array<i64> = this.environment.writable_records(&this.program);
        const mutators: Array<MethodCandidate> = this.method_calls(ValueType::Void, true);
        const assignable: Array<i64> = this.whole_stores();
        mut weights: Array<i64> = Array::<i64>::new();
        weights.push(30);
        weights.push(if (assignable.length() > 0) { 20 } else { 0 });
        weights.push(12);
        weights.push(if (features.has(Feature::Branches) && nested) { 10 } else { 0 });
        weights.push(if (features.has(Feature::Loops) && nested && this.loop_depth < MOST_LOOPS) { 10 } else { 0 });
        weights.push(if (features.has(Feature::LoopExits) && this.loop_depth > 0) { 4 } else { 0 });
        weights.push(if (features.has(Feature::EarlyReturns) && !this.in_main) { 4 } else { 0 });
        weights.push(if (writable.length() > 0) { 14 } else { 0 });
        weights.push(if (mutators.length() > 0) { 8 } else { 0 });
        weights.push(if (this.matches_enumerations() && nested) { 8 } else { 0 });
        weights.push(if (this.declares_closures()) { 6 } else { 0 });
        weights.push(if (this.makes_owned()) { 10 } else { 0 });
        const references: Array<i64> = this.writable_references();
        weights.push(if (references.length() > 0) { 8 } else { 0 });
        const releasable: Array<i64> = this.releasable();
        weights.push(if (releasable.length() > 0) { 4 } else { 0 });
        const discardable: Array<i64> = this.discardable();
        weights.push(if (discardable.length() > 0) { 3 } else { 0 });
        const boxes: Array<i64> = this.environment.writable_boxes(&this.program);
        weights.push(if (boxes.length() > 0) { 8 } else { 0 });
        weights.push(if (this.makes_arrays()) { 8 } else { 0 });
        const arrays: Array<i64> = this.writable_arrays();
        weights.push(if (arrays.length() > 0) { 12 } else { 0 });
        weights.push(if (this.makes_strings()) { 6 } else { 0 });
        const texts: Array<i64> = this.writable_texts();
        weights.push(if (texts.length() > 0) { 10 } else { 0 });
        weights.push(if (this.makes_dynamic_arrays()) { 8 } else { 0 });
        const appendable: Array<i64> = this.appendable();
        weights.push(if (appendable.length() > 0) { 10 } else { 0 });
        const poppable: Array<i64> = this.shrinkable(&appendable, true);
        weights.push(if (poppable.length() > 0) { 6 } else { 0 });
        const reassignable: Array<i64> = this.shrinkable(&appendable, false);
        weights.push(if (reassignable.length() > 0) { 3 } else { 0 });
        weights.push(if (this.makes_maps()) { 6 } else { 0 });
        const maps: Array<i64> = this.writable_maps();
        weights.push(if (maps.length() > 0) { 10 } else { 0 });
        weights.push(if (maps.length() > 0) { 5 } else { 0 });
        weights.push(if (maps.length() > 0) { 1 } else { 0 });
        const form: i64 = this.random.pick(&weights);
        this.budget.charge(1);
        if (form == 0) { return this.declaration(); }
        if (form == 1) {
            const chosen: i64 = assignable.get(this.random.below(assignable.length())).unwrap();
            if (this.program.variable_at(chosen).value_type.is_array()) { this.environment.lend(chosen, true); }
            return this.store(this.target(chosen));
        }
        if (form == 2) {
            const value_type: ValueType = TypeChoice::scalar(&this.random, this.options.features);
            return this.observation(this.expression(value_type, this.depth(), true));
        }
        if (form == 3) {
            const condition: i64 = this.condition(this.depth());
            const then_block: i64 = this.block();
            const else_block: i64 = if (this.random.chance(50)) { this.block() } else { -1 };
            return this.program.statement(StatementKind::Branch(condition, then_block, else_block));
        }
        if (form == 4) { return this.loop_statement(); }
        if (form == 5) {
            const condition: i64 = this.condition(this.depth());
            return this.program.statement(StatementKind::Exit(this.random.chance(50), condition));
        }
        if (form == 6) {
            const condition: i64 = this.condition(this.depth());
            const value: i64 = if (this.returns.same(ValueType::Void)) { -1 } else { this.returned_value() };
            return this.program.statement(StatementKind::ReturnIf(condition, value));
        }
        if (form == 7) { return this.store(this.field_place(writable.get(this.random.below(writable.length())).unwrap())); }
        if (form == 9) { return this.match_statement(); }
        if (form == 10) { return this.closure_declaration(); }
        if (form == 11) { return this.owned_declaration(); }
        if (form == 12) { return this.reference_store(references.get(this.random.below(references.length())).unwrap()); }
        if (form == 13) { return this.release(&releasable); }
        if (form == 14) { return this.discarded_result(&discardable); }
        if (form == 15) { return this.box_store(boxes.get(this.random.below(boxes.length())).unwrap()); }
        if (form == 16) { return this.array_declaration(); }
        if (form == 17) { return this.element_store(&arrays); }
        if (form == 18) { return this.text_declaration(); }
        if (form == 19) { return this.text_push(&texts); }
        if (form == 20) { return this.dynamic_declaration(); }
        if (form == 21) { return this.append(&appendable); }
        if (form == 22) { return this.pop(&poppable); }
        if (form == 23) { return this.dynamic_assignment(&reassignable); }
        if (form == 24) { return this.map_declaration(); }
        if (form == 25) { return this.map_change(&maps, false); }
        if (form == 26) { return this.map_change(&maps, true); }
        if (form == 27) { return this.map_reset(&maps); }
        const method: MethodCandidate = mutators.get(this.random.below(mutators.length())).unwrap();
        return this.program.statement(StatementKind::Evaluate(this.method_call(method, this.depth())));
    }

    /// The `mut` locals in scope a store may assign whole: any but a dynamic
    /// array, which only its own statements assign, since they know the
    /// fewest elements it holds afterwards, and a map, which is only ever
    /// given a new empty one.
    private whole_stores(&this) -> Array<i64> {
        mut found: Array<i64> = Array::<i64>::new();
        for (variable in this.environment.assignable(&this.program).iter()) {
            const held: ValueType = this.program.variable_at(variable).value_type;
            if (!held.is_dynamic_array() && !held.is_map()) { found.push(variable); }
        }
        return found;
    }

    /// `const` or `mut` local with its initial value; the name is in scope
    /// only after the value, so the value cannot read it.
    private declaration(mut &this) -> i64 {
        const value_type: ValueType = this.any_type();
        const value: i64 = this.typed_place(value_type, this.depth());
        const mutable: boolean = this.random.chance(50);
        const variable: i64 = this.environment.declare_local(&this.program, value_type, mutable);
        return this.program.statement(StatementKind::Declare(variable, value));
    }

    /// A store to `place`, a `mut` local or a field reached from a
    /// writable struct: plain, or a compound operator that cannot overflow.
    internal store(mut &this, place: i64) -> i64 {
        const value_type: ValueType = this.program.expression_at(place).value_type;
        const features: FeatureSet = this.options.features;
        if (value_type.is_integer() && this.random.chance(35)) {
            mut weights: Array<i64> = Array::<i64>::new();
            weights.push(if (features.has(Feature::Bitwise)) { 3 } else { 0 });
            weights.push(if (features.has(Feature::Shifts)) { 2 } else { 0 });
            weights.push(if (features.has(Feature::Division)) { 2 } else { 0 });
            const total: i64 = weights.iter().sum();
            if (total > 0) {
                const form: i64 = this.random.pick(&weights);
                const depth: i64 = this.depth();
                if (form == 0) {
                    const operator: BinaryOperator = this.bitwise_operator();
                    return this.program.statement(StatementKind::Compound(operator, place, this.expression(value_type, depth, false)));
                }
                if (form == 1) {
                    const operator: BinaryOperator = if (this.random.chance(50)) { BinaryOperator::ShiftLeft } else { BinaryOperator::ShiftRight };
                    return this.program.statement(StatementKind::Compound(operator, place, this.shift_amount(value_type, depth)));
                }
                const operator: BinaryOperator = if (this.random.chance(50)) { BinaryOperator::Divide } else { BinaryOperator::Remainder };
                return this.program.statement(StatementKind::Compound(operator, place, this.divisor(value_type, depth)));
            }
        }
        return this.program.statement(StatementKind::Assign(place, this.typed_place(value_type, this.depth())));
    }

    /// A bounded loop.  The counter is read only, and the body's work is
    /// charged once per trip.
    private loop_statement(mut &this) -> i64 {
        const shape: LoopShape = match (this.random.below(3)) {
            0 => { LoopShape::Counted }
            1 => { LoopShape::Conditioned }
            _ => { LoopShape::Ranged }
        };
        const value_type: ValueType = match (shape) {
            LoopShape::Ranged => { ValueType::I32 }
            _                 => { TypeChoice::integer(&this.random) }
        };
        const trips: i64 = this.random.below(MOST_TRIPS + 1);
        const start: i64 = this.environment.mark();
        const counter: i64 = this.environment.declare_counter(&this.program, value_type);
        const outer: u64 = this.budget.enter_loop(trips);
        this.budget.charge(2);
        this.loop_depth = this.loop_depth + 1;
        this.environment.enter_loop();
        const body: i64 = this.block();
        this.environment.leave_loop();
        this.environment.leave(start);
        this.loop_depth = this.loop_depth - 1;
        this.budget.leave_loop(outer);
        return this.program.statement(StatementKind::Loop(shape, counter, trips as u64, body));
    }

    /// A condition for a branch, a loop exit, an early return or an `if`
    /// expression.
    internal condition(mut &this, depth: i64) -> i64 { return this.boolean_expression(depth, false); }
}
