///! Enums and `match`: enums `E<N>` with variants `V<N>`, their values,
///! and `match` over them as an expression and as a statement.
///!
///! The enums are declared first, before the structs, from a stream of
///! their own, so with the feature off no draw is taken.  With
///! `enum-payloads` a variant carries up to two scalar values,
///! `V1(u8, i32)`; a value of an enum type is then `Copy`, as each of its
///! payload's types is.  An enum is a type a value may have: a local, a
///! parameter, a return type, a generic function's type argument.  A value
///! of one is a variant (`E0::V1`, `E0::V2(a, b)` with a value of each
///! payload type), a variable, a call, an `if` expression or a `match`
///! expression, so it always reads a name.  A `match` covers every variant
///! once, by its own arm or by a `_` written last (`Exhaustiveness`), its
///! arms in a shuffled order; an expression's arms read a name, since an
///! arm, as an `if` expression's, gives a bare literal no type.  An arm
///! over a payload variant binds each value, `E0::V2(b0, b1)`, and every
///! binding is observed: a statement's arm at the end of its block, an
///! expression's arm by statements before its value.  An enum value is
///! observed by the `match` the printer folds it with, which folds a
///! payload into its variant's number.

namespace cryosmith::generate::enums;

import std::collections::array::{ Array };

import cryosmith::configuration::{ Feature };
import cryosmith::generate::generator::{ Generator };
import cryosmith::generate::structs::{ MethodCandidate };
import cryosmith::guarantees::{ Exhaustiveness };
import cryosmith::model::{ Enumeration, ExpressionKind, MatchArm, StatementKind, ValueType, VariantDeclaration };
import cryosmith::random::{ RandomStream };
import cryosmith::typing::{ TypeChoice };

/// The most enums a program declares.
const MOST_ENUMERATIONS: i64 = 2;

/// The most variants an enum has; it has at least two.
const MOST_VARIANTS: i64 = 4;

/// The most values a variant's payload holds.
const MOST_PAYLOAD_VALUES: i64 = 2;

implement struct Generator {
    /// Declare the program's enums, one or two, from their own stream.
    internal declare_enumerations(mut &this) -> void {
        mut declaring: RandomStream = RandomStream::for_enumerations(this.options.seed);
        const count: i64 = 1 + declaring.below(MOST_ENUMERATIONS);
        while (this.program.enumerations.length() < count) {
            const variant_count: i64 = 2 + declaring.below(MOST_VARIANTS - 1);
            const first_variant: i64 = this.program.variants.length();
            while (this.program.variants.length() < first_variant + variant_count) {
                const first_payload: i64 = this.program.payload_types.length();
                const payload_count: i64 = if (this.options.features.has(Feature::EnumPayloads)) { declaring.below(MOST_PAYLOAD_VALUES + 1) } else { 0 };
                while (this.program.payload_types.length() < first_payload + payload_count) {
                    this.program.payload_types.push(TypeChoice::scalar(&declaring, this.options.features));
                }
                this.program.variants.push(VariantDeclaration { first_payload: first_payload, payload_count: payload_count });
            }
            this.program.enumerations.push(Enumeration {
                number: this.program.enumerations.length(), variant_count: variant_count, first_variant: first_variant,
            });
        }
    }

    /// A value of the enum type `wanted`: a variant, a variable, a call, a
    /// method call or an `if` expression.
    internal enumeration_expression(mut &this, wanted: ValueType, depth: i64) -> i64 {
        const deeper: boolean = depth > 0;
        const next: i64 = if (deeper) { depth - 1 } else { 0 };
        const variables: Array<i64> = this.environment.variables_of(&this.program, wanted);
        const callees: Array<i64> = this.callees(wanted);
        const methods: Array<MethodCandidate> = this.method_calls(wanted, false);
        const generic_callees: Array<i64> = this.generic_callees(wanted);
        mut weights: Array<i64> = Array::<i64>::new();
        weights.push(8);
        weights.push(if (variables.length() > 0) { 10 } else { 0 });
        weights.push(if (callees.length() > 0 && deeper) { 5 } else { 0 });
        weights.push(if (methods.length() > 0 && deeper) { 4 } else { 0 });
        weights.push(if (this.options.features.has(Feature::IfExpressions) && deeper) { 2 } else { 0 });
        weights.push(if (generic_callees.length() > 0 && deeper) { 3 } else { 0 });
        const form: i64 = this.random.pick(&weights);
        if (form == 0) {
            const variants: i64 = this.program.enumeration_at(wanted.enumeration()).variant_count;
            return this.variant_value(wanted, this.random.below(variants), next);
        }
        if (form == 1) { return this.read(variables.get(this.random.below(variables.length())).unwrap()); }
        if (form == 2) { return this.call(callees.get(this.random.below(callees.length())).unwrap(), next); }
        if (form == 3) { return this.method_call(methods.get(this.random.below(methods.length())).unwrap(), next); }
        if (form == 4) {
            const condition: i64 = this.condition(next);
            const then_value: i64 = this.enumeration_expression(wanted, next);
            const else_value: i64 = this.enumeration_expression(wanted, next);
            return this.node(ExpressionKind::Conditional(condition, then_value, else_value), wanted);
        }
        return this.generic_call(generic_callees.get(this.random.below(generic_callees.length())).unwrap(), wanted, next);
    }

    /// Variant `variant` of the enum type `wanted`, with a value of each of
    /// its payload's types: `E0::V0`, `E0::V1(a, b)`.
    private variant_value(mut &this, wanted: ValueType, variant: i64, depth: i64) -> i64 {
        const shape: VariantDeclaration = this.program.variant_of(wanted.enumeration(), variant);
        mut values: Array<i64> = Array::<i64>::new();
        mut position: i64 = 0;
        while (position < shape.payload_count) {
            values.push(this.typed_place(this.program.payload_type(shape, position), depth));
            position = position + 1;
        }
        const first: i64 = this.program.list_run(&values);
        return this.node(ExpressionKind::Variant(variant, first, shape.payload_count), wanted);
    }

    /// Whether a `match` may be generated here: the feature is on and the
    /// program has an enum to match on.
    internal matches_enumerations(&this) -> boolean {
        return this.options.features.has(Feature::Enums) && this.program.enumerations.length() > 0;
    }

    /// `match (subject) { .. }` whose arms are values of `wanted`, each
    /// reading a name, an arm over a payload variant observing its bindings
    /// first.
    internal match_expression(mut &this, wanted: ValueType, depth: i64) -> i64 {
        const subject: i64 = this.match_subject(depth);
        const matched: ValueType = this.program.expression_at(subject).value_type;
        const patterns: Array<i64> = this.match_patterns(matched);
        mut arms: Array<MatchArm> = Array::<MatchArm>::new();
        for (pattern in patterns.iter()) {
            const scope: i64 = this.environment.mark();
            const bindings: Array<i64> = this.payload_bindings(matched, pattern);
            mut observations: Array<i64> = Array::<i64>::new();
            for (binding in bindings.iter()) { this.observe_place(this.read(binding), &observations); }
            const body: i64 = this.expression(wanted, depth, true);
            this.environment.leave(scope);
            arms.push(MatchArm {
                pattern: pattern, first_binding: this.program.list_run(&bindings), binding_count: bindings.length(),
                observations: this.program.block(&observations), body: body,
            });
        }
        const first: i64 = this.program.arm_run(&arms);
        return this.node(ExpressionKind::Match(subject, first, arms.length()), wanted);
    }

    /// `match (subject) { .. }` whose arms are blocks, each observing its
    /// arm's bindings last.
    internal match_statement(mut &this) -> i64 {
        const subject: i64 = this.match_subject(this.depth());
        const matched: ValueType = this.program.expression_at(subject).value_type;
        const patterns: Array<i64> = this.match_patterns(matched);
        mut arms: Array<MatchArm> = Array::<MatchArm>::new();
        for (pattern in patterns.iter()) {
            const scope: i64 = this.environment.mark();
            const bindings: Array<i64> = this.payload_bindings(matched, pattern);
            const body: i64 = this.block_observing(&bindings);
            this.environment.leave(scope);
            arms.push(MatchArm {
                pattern: pattern, first_binding: this.program.list_run(&bindings), binding_count: bindings.length(),
                observations: -1, body: body,
            });
        }
        const first: i64 = this.program.arm_run(&arms);
        return this.program.statement(StatementKind::Match(subject, first, arms.length()));
    }

    /// A value of one of the program's enums to match on, itself sometimes
    /// a `match` expression.
    private match_subject(mut &this, depth: i64) -> i64 {
        const matched: ValueType = ValueType::Enumeration(this.random.below(this.program.enumerations.length()));
        return this.expression(matched, depth, true);
    }

    /// `match (value) { E0::V0 => { 1 } E0::V1(b0) => { mix(2, b0) } .. }`,
    /// an arm per variant giving its number plus one, as a literal the
    /// `u64` it is passed as types, with each payload value folded in by
    /// `mix`.  An enum value is observed through it.
    internal variant_number(mut &this, value: i64) -> i64 {
        const matched: ValueType = this.program.expression_at(value).value_type;
        mut arms: Array<MatchArm> = Array::<MatchArm>::new();
        while (arms.length() < this.program.enumeration_at(matched.enumeration()).variant_count) {
            const scope: i64 = this.environment.mark();
            const bindings: Array<i64> = this.payload_bindings(matched, arms.length());
            mut folded: i64 = this.integer((arms.length() + 1) as u64, ValueType::U64);
            for (binding in bindings.iter()) { folded = this.node(ExpressionKind::Mix(folded, this.read(binding)), ValueType::U64); }
            this.environment.leave(scope);
            arms.push(MatchArm {
                pattern: arms.length(), first_binding: this.program.list_run(&bindings), binding_count: bindings.length(),
                observations: -1, body: folded,
            });
        }
        const first: i64 = this.program.arm_run(&arms);
        return this.node(ExpressionKind::Match(value, first, arms.length()), ValueType::U64);
    }

    /// A binding in scope for each value variant `pattern` of the enum type
    /// `matched` carries; none for `_` or a unit variant.
    private payload_bindings(mut &this, matched: ValueType, pattern: i64) -> Array<i64> {
        mut bindings: Array<i64> = Array::<i64>::new();
        if (pattern < 0) { return bindings; }
        const shape: VariantDeclaration = this.program.variant_of(matched.enumeration(), pattern);
        while (bindings.length() < shape.payload_count) {
            bindings.push(this.environment.declare_binding(&this.program, this.program.payload_type(shape, bindings.length())));
        }
        return bindings;
    }

    /// A `match`'s patterns over the enum type `matched`: one to all of its
    /// variants in a shuffled order, then `_` when one is left.
    private match_patterns(mut &this, matched: ValueType) -> Array<i64> {
        const variant_count: i64 = this.program.enumeration_at(matched.enumeration()).variant_count;
        mut order: Array<i64> = Array::<i64>::new();
        while (order.length() < variant_count) { order.push(order.length()); }
        mut position: i64 = variant_count - 1;
        while (position > 0) {
            const other: i64 = this.random.below(position + 1);
            const held: i64 = order.get(position).unwrap();
            order.set(position, order.get(other).unwrap());
            order.set(other, held);
            position = position - 1;
        }
        const covered_count: i64 = 1 + this.random.below(variant_count);
        mut covered: Array<i64> = Array::<i64>::new();
        while (covered.length() < covered_count) { covered.push(order.get(covered.length()).unwrap()); }
        return Exhaustiveness::patterns(&covered, variant_count);
    }
}
