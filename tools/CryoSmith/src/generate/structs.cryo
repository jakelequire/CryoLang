///! Structs (stage 2): declarations, literals, field places, methods and
///! method calls.
///!
///! One to three structs are declared from their own stream; a field's
///! struct type is an earlier struct's, so no struct contains itself.  A
///! method taking `mut &this` returns nothing and is called only as a
///! statement of its own, so no expression both changes a struct and reads
///! it; such a method is called only on a place whose fields may be written.

namespace cryosmith::generate::structs;

import std::collections::array::{ Array };

import cryosmith::configuration::{ Feature };
import cryosmith::generate::generator::{ Generator };
import cryosmith::model::{ ExpressionKind, Field, Function, Receiver, Structure, TypeArgumentSpelling, ValueType };
import cryosmith::random::{ RandomStream };
import cryosmith::typing::{ TypeChoice };

/// The most structs a program declares.
const MOST_STRUCTURES: i64 = 3;

/// The most fields a struct has: four, so no field is named `f32`.
const MOST_FIELDS: i64 = 4;

/// The most methods a struct has.
const MOST_METHODS: i64 = 3;

implement struct Generator {
    /// Declare the structs and their fields from the structs' own stream,
    /// then generate every struct's methods.
    internal declare_structures(mut &this) -> void {
        this.random = RandomStream::for_structures(this.options.seed);
        const count: i64 = 1 + this.random.below(MOST_STRUCTURES);
        mut receivers: Array<Receiver> = Array::<Receiver>::new();
        mut owners: Array<i64> = Array::<i64>::new();
        mut index: i64 = 0;
        while (index < count) {
            const first_field: i64 = this.program.fields.length();
            const field_count: i64 = 1 + this.random.below(MOST_FIELDS);
            mut number: i64 = 0;
            while (number < field_count) {
                const value_type: ValueType = if (index > 0 && this.random.chance(30)) {
                    ValueType::Record(this.random.below(index))
                } else {
                    TypeChoice::scalar(&this.random, this.options.features)
                };
                mut default_value: i64 = -1;
                if (!value_type.is_record() && this.random.chance(30)) {
                    default_value = match (value_type) {
                        ValueType::Boolean => { this.node(ExpressionKind::BooleanLiteral(this.random.chance(50)), ValueType::Boolean) }
                        _                  => { this.literal(value_type) }
                    };
                }
                this.program.fields.push(Field { number: number, value_type: value_type, default_value: default_value });
                number = number + 1;
            }
            this.program.structures.push(Structure::declared(index, first_field, field_count));
            const methods: i64 = 1 + this.random.below(MOST_METHODS);
            mut method: i64 = 0;
            while (method < methods) {
                const roll: i64 = this.random.below(10);
                receivers.push(if (roll < 3) { Receiver::Static } else { if (roll < 7) { Receiver::Shared } else { Receiver::Exclusive } });
                owners.push(index);
                method = method + 1;
            }
            index = index + 1;
        }
        mut numbers: Array<i64> = Array::<i64>::new();
        index = 0;
        while (index < count) { numbers.push(0); index = index + 1; }
        index = 0;
        while (index < owners.length()) {
            const owner: i64 = owners.get(index).unwrap();
            const number: i64 = numbers.get(owner).unwrap();
            numbers.set(owner, number + 1);
            this.define(number, owner, receivers.get(index).unwrap());
            index = index + 1;
        }
    }

    /// A struct-typed expression of `wanted`: a literal, a variable, a
    /// field, a call or an `if` expression.  A literal names its type, so
    /// every form reads a name.
    internal record_expression(mut &this, wanted: ValueType, depth: i64) -> i64 {
        const deeper: boolean = depth > 0;
        const next: i64 = if (deeper) { depth - 1 } else { 0 };
        const variables: Array<i64> = this.environment.variables_of(&this.program, wanted);
        const roots: Array<i64> = this.environment.field_roots(&this.program, wanted);
        const callees: Array<i64> = this.callees(wanted);
        const methods: Array<MethodCandidate> = this.method_calls(wanted, false);
        const generic_callees: Array<i64> = this.generic_callees(wanted);
        mut weights: Array<i64> = Array::<i64>::new();
        weights.push(8);
        weights.push(if (variables.length() > 0) { 10 } else { 0 });
        weights.push(if (roots.length() > 0) { 6 } else { 0 });
        weights.push(if (callees.length() > 0 && deeper) { 6 } else { 0 });
        weights.push(if (methods.length() > 0 && deeper) { 5 } else { 0 });
        weights.push(if (this.options.features.has(Feature::IfExpressions) && deeper) { 2 } else { 0 });
        weights.push(if (generic_callees.length() > 0 && deeper) { 4 } else { 0 });
        const form: i64 = this.random.pick(&weights);
        if (form == 0) { return this.record_literal(wanted, next); }
        if (form == 1) { return this.read(variables.get(this.random.below(variables.length())).unwrap()); }
        if (form == 2) { return this.place(roots.get(this.random.below(roots.length())).unwrap(), wanted); }
        if (form == 3) { return this.call(callees.get(this.random.below(callees.length())).unwrap(), next); }
        if (form == 4) { return this.method_call(methods.get(this.random.below(methods.length())).unwrap(), next); }
        if (form == 6) { return this.generic_call(generic_callees.get(this.random.below(generic_callees.length())).unwrap(), wanted, next); }
        const condition: i64 = this.condition(next);
        const then_value: i64 = this.record_expression(wanted, next);
        const else_value: i64 = this.record_expression(wanted, next);
        return this.node(ExpressionKind::Conditional(condition, then_value, else_value), wanted);
    }

    /// `S { f: value, ... }`, its fields in a shuffled order; a field with a
    /// default is left out half the time.  An instance's literal that
    /// leaves its type argument to inference gives a deciding value for
    /// each field of type `T`; its first field is one, and has no default.
    /// Inside a generic struct's own method, a literal of that struct is
    /// spelled the same ways, so the instance its fields bind need not be
    /// the one the body belongs to.
    private record_literal(mut &this, wanted: ValueType, depth: i64) -> i64 {
        const declared: Structure = this.program.structure_at(wanted.structure());
        const spelling: TypeArgumentSpelling = if (declared.is_instance()) { this.type_argument_spelling() } else { TypeArgumentSpelling::Written };
        mut order: Array<i64> = Array::<i64>::new();
        mut field: i64 = declared.first_field;
        while (field < declared.first_field + declared.field_count) {
            if (this.program.field_at(field).default_value < 0 || this.random.chance(50)) { order.push(field); }
            field = field + 1;
        }
        this.shuffle(&order);
        mut values: Array<i64> = Array::<i64>::new();
        for (written in order.iter()) {
            const field_type: ValueType = this.program.field_at(written).value_type;
            if (spelling.is_inferred() && this.program.field_is_type_argument(wanted.structure(), written)) {
                values.push(this.deciding_value(field_type, depth));
            } else {
                values.push(this.typed_place(field_type, depth));
            }
        }
        const first: i64 = this.program.lists.length();
        mut index: i64 = 0;
        while (index < order.length()) {
            this.program.lists.push(order.get(index).unwrap());
            this.program.lists.push(values.get(index).unwrap());
            index = index + 1;
        }
        return this.node(ExpressionKind::StructureLiteral(wanted.structure(), spelling, first, order.length()), wanted);
    }

    /// Put `order` in a drawn order: a literal writes its fields in any.
    internal shuffle(mut &this, order: mut &Array<i64>) -> void {
        mut index: i64 = order.length() - 1;
        while (index > 0) {
            const other: i64 = this.random.below(index + 1);
            const swapped: i64 = order.get(index).unwrap();
            order.set(index, order.get(other).unwrap());
            order.set(other, swapped);
            index = index - 1;
        }
    }

    /// A field reached from the writable struct `root`, for a store: a
    /// walk down its fields that stops at a scalar, or at a nested struct
    /// half the time.
    internal field_place(mut &this, root: i64) -> i64 {
        mut place: i64 = this.target(root);
        mut value_type: ValueType = this.program.variable_at(root).value_type;
        while (true) {
            const declared: Structure = this.program.structure_at(value_type.structure());
            const field: i64 = declared.first_field + this.random.below(declared.field_count);
            value_type = this.program.field_at(field).value_type;
            place = this.program.expression(ExpressionKind::Field(place, field), value_type);
            if (!value_type.is_record() || this.random.chance(50)) { return place; }
        }
        return place;
    }

    /// A place of type `wanted` reached from the variable `root`: the
    /// variable itself when it is of `wanted`, else a walk down the fields
    /// that lead to one.
    internal place(mut &this, root: i64, wanted: ValueType) -> i64 {
        mut place: i64 = this.read(root);
        mut value_type: ValueType = this.program.variable_at(root).value_type;
        while (!value_type.same(wanted)) {
            const declared: Structure = this.program.structure_at(value_type.structure());
            mut leading: Array<i64> = Array::<i64>::new();
            mut field: i64 = declared.first_field;
            while (field < declared.first_field + declared.field_count) {
                const field_type: ValueType = this.program.field_at(field).value_type;
                if (field_type.same(wanted) || this.program.reaches(field_type, wanted)) { leading.push(field); }
                field = field + 1;
            }
            const chosen: i64 = leading.get(this.random.below(leading.length())).unwrap();
            value_type = this.program.field_at(chosen).value_type;
            place = this.node(ExpressionKind::Field(place, chosen), value_type);
        }
        return place;
    }

    /// A call of `candidate`'s method on a place of its receiver type: one
    /// whose fields may be written when the method takes `mut &this`.  On
    /// an instance of a generic struct, `T` stands for the instance's
    /// argument, in the arguments and in what the call returns.
    internal method_call(mut &this, candidate: MethodCandidate, depth: i64) -> i64 {
        const called: Function = this.program.function_at(candidate.method);
        const roots: Array<i64> = this.environment.receiver_roots(&this.program, candidate.receiver, called.receiver.writes_receiver());
        const receiver: i64 = this.place(roots.get(this.random.below(roots.length())).unwrap(), candidate.receiver);
        const type_argument: ValueType = this.program.structure_at(candidate.receiver.structure()).argument;
        const first: i64 = this.instantiated_arguments(called, type_argument, false, depth);
        const returned: ValueType = if (called.returns.same(ValueType::TypeParameter)) { type_argument } else { called.returns };
        return this.node(ExpressionKind::MethodCall(receiver, candidate.method, first, called.parameter_count), returned);
    }

    /// The earlier methods taking a receiver and returning `wanted` that
    /// are affordable and have a receiver in scope: methods taking
    /// `mut &this` when `writes` (they return nothing), `&this` otherwise.
    /// A generic struct's method is a candidate once for each of its
    /// instances, its own among them, that has a receiver in scope and on
    /// which it returns `wanted`.  A trait method's default body is a
    /// candidate once for each struct that runs it, implementing the trait
    /// and writing no method of its own for the default.
    internal method_calls(&this, wanted: ValueType, writes: boolean) -> Array<MethodCandidate> {
        mut found: Array<MethodCandidate> = Array::<MethodCandidate>::new();
        if (!this.options.features.has(Feature::Calls)) { return found; }
        mut index: i64 = 0;
        while (index < this.program.functions.length()) {
            const candidate: Function = this.program.function_at(index);
            const matches: boolean = !candidate.receiver.is_called_by_name() && candidate.receiver.writes_receiver() == writes;
            if (matches && candidate.is_default() && candidate.returns.same(wanted) && this.budget.affordable(candidate.cost)) {
                mut structure: i64 = 0;
                while (structure < this.program.structures.length()) {
                    if (this.program.runs_default(structure, candidate.implements)
                        && this.environment.receiver_roots(&this.program, ValueType::Record(structure), writes).length() > 0) {
                        found.push(MethodCandidate { method: index, receiver: ValueType::Record(structure) });
                    }
                    structure = structure + 1;
                }
            } else if (matches && !candidate.is_default() && this.budget.affordable(candidate.cost) && this.may_call(&candidate)) {
                const owner: Structure = this.program.structure_at(candidate.owner);
                mut receiver: i64 = if (owner.is_own_instance()) { 0 } else { candidate.owner };
                const last: i64 = if (owner.is_own_instance()) { this.program.structures.length() - 1 } else { candidate.owner };
                while (receiver <= last) {
                    const instance: Structure = this.program.structure_at(receiver);
                    const receives: boolean = receiver == candidate.owner || (owner.is_own_instance() && instance.template == owner.template);
                    const returned: ValueType = if (candidate.returns.same(ValueType::TypeParameter)) { instance.argument } else { candidate.returns };
                    if (receives && returned.same(wanted)
                        && this.environment.receiver_roots(&this.program, ValueType::Record(receiver), writes).length() > 0) {
                        found.push(MethodCandidate { method: index, receiver: ValueType::Record(receiver) });
                    }
                    receiver = receiver + 1;
                }
            }
            index = index + 1;
        }
        return found;
    }
}

/// A method call the generator may write: the method, and the type of the
/// place it is called on - its own struct, or for a generic struct's
/// method, one of that struct's instances.
internal type struct MethodCandidate {
    /// The method, by its place among the functions.
    internal method: i64;
    /// The receiver's type.
    internal receiver: ValueType;
}
