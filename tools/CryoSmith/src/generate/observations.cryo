///! Observations: every value a program computes reaches the hash.
///!
///! Each block ends by observing every local it declared, a function body
///! by observing its parameters and a method's receiver.  A scalar is folded
///! directly; a struct field by field, nested structs through their own
///! fields; a struct a call returns is bound to a local first, so the call
///! runs once.

namespace cryosmith::generate::observations;

import std::collections::array::{ Array };

import cryosmith::generate::generator::{ Generator };
import cryosmith::model::{ ExpressionKind, StatementKind, Structure, ValueType, VariableRole };

implement struct Generator {
    /// Observe every local declared in the scope since `start`.
    internal observe_declared(mut &this, start: i64, statements: mut &Array<i64>) -> void {
        for (variable in this.environment.locals_since(&this.program, start).iter()) {
            this.observe_place(this.read(variable), statements);
        }
    }

    /// Observe a place: a scalar is folded into `observed`, a struct is
    /// observed field by field, a closure local by a call of it, and a `T`
    /// value by a call of its bound trait's first method, every one of
    /// which returns a scalar - and where `T` is bounded by no trait, not at
    /// all, since nothing converts it to a `u64`.
    internal observe_place(mut &this, place: i64, statements: mut &Array<i64>) -> void {
        const value_type: ValueType = this.program.expression_at(place).value_type;
        if (value_type.same(ValueType::TypeParameter)) {
            const bounding: i64 = this.genericity.bounding_trait();
            if (bounding >= 0) { this.observe_value(this.trait_call(place, this.program.trait_at(bounding).first_method, 0), statements); }
            return;
        }
        if (value_type.is_enumeration()) {
            statements.push(this.observation(this.variant_number(place)));
            return;
        }
        if (value_type.is_function()) {
            match (this.program.expression_at(place).kind) {
                ExpressionKind::Variable(variable) => {
                    match (this.program.variable_at(variable).role) {
                        VariableRole::Local => {
                            this.observe_value(this.closure_call(this.closure_held_by(variable), 0), statements);
                        }
                        _ => { this.observe_value(this.invoke_value(place, 0), statements); }
                    }
                }
                _ => { }
            }
            return;
        }
        if (!value_type.is_record()) {
            statements.push(this.observation(place));
            return;
        }
        const declared: Structure = this.program.structure_at(value_type.structure());
        mut field: i64 = declared.first_field;
        while (field < declared.first_field + declared.field_count) {
            const field_place: i64 = this.node(ExpressionKind::Field(place, field), this.program.field_at(field).value_type);
            this.observe_place(field_place, statements);
            field = field + 1;
        }
    }

    /// Observe a value: a scalar directly, a struct by binding it to a
    /// local first, so it is computed once.  A `T` value - a call of a
    /// closure returning `T` - is evaluated and not observed, since nothing
    /// converts it to a `u64`.
    internal observe_value(mut &this, value: i64, statements: mut &Array<i64>) -> void {
        const value_type: ValueType = this.program.expression_at(value).value_type;
        if (value_type.same(ValueType::TypeParameter)) {
            statements.push(this.program.statement(StatementKind::Evaluate(value)));
            return;
        }
        if (value_type.is_enumeration()) {
            statements.push(this.observation(this.variant_number(value)));
            return;
        }
        if (value_type.is_function()) {
            this.observe_value(this.invoke_value(value, 0), statements);
            return;
        }
        if (!value_type.is_record()) {
            statements.push(this.observation(value));
            return;
        }
        const variable: i64 = this.environment.declare_local(&this.program, value_type, false);
        statements.push(this.program.statement(StatementKind::Declare(variable, value)));
        this.observe_place(this.read(variable), statements);
    }

    /// `observed = mix(observed, value)`.
    internal observation(mut &this, value: i64) -> i64 {
        return this.program.statement(StatementKind::Observe(value));
    }
}
