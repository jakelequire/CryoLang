///! Inferred type arguments: a generic call or an instance's struct literal
///! that leaves its type argument to inference, `g0(a, b)`, `g0::<_>(a, b)`,
///! `B0 { f0: a }`, `B0::<_> { f0: a }`.
///!
///! Inference reads the type argument off the values given for `T`, and it
///! is certain only where those values have exactly the type: inference
///! never widens, so a narrower value would bind `T` to its own type, and a
///! literal decides no type parameter.  So where the type argument is
///! inferred, every value for `T` is a deciding value: of the type itself,
///! reading a name.  With the feature off, the spelling is written and no
///! draw is taken.

namespace cryosmith::generate::inference;

import cryosmith::configuration::{ Feature };
import cryosmith::generate::generator::{ Generator };
import cryosmith::model::{ TypeArgumentSpelling, ValueType };

implement struct Generator {
    /// How the next generic call or instance literal spells its type
    /// argument: left out four times in ten, a placeholder twice, written
    /// otherwise; always written, with no draw, when the feature is off.
    internal type_argument_spelling(mut &this) -> TypeArgumentSpelling {
        if (!this.options.features.has(Feature::InferredTypeArguments)) { return TypeArgumentSpelling::Written; }
        const roll: i64 = this.random.below(10);
        if (roll < 4) { return TypeArgumentSpelling::Omitted; }
        if (roll < 6) { return TypeArgumentSpelling::Placeholder; }
        return TypeArgumentSpelling::Written;
    }

    /// A value given for `T` where the type argument is inferred: of
    /// exactly `wanted`, never widened, and reading a name, so neither a
    /// bare literal nor one made only of literals.
    internal deciding_value(mut &this, wanted: ValueType, depth: i64) -> i64 {
        return this.expression(wanted, depth, true);
    }
}
