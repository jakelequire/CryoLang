///! Type-directed generation of a `Program` from `GenerationOptions`.
///!
///! One struct, `Generator`, with its methods in one file per concern; a
///! feature stage adds a file here and the forms it generates, and leaves
///! the others' draws alone where its feature is off:
///!
///!   generator     the struct, `generate`, node construction and the
///!                 expression entry points every stage calls
///!   functions     a function's signature, body and cost; calls of free
///!                 functions and static methods
///!   control_flow  statements: declarations, stores, branches, loops, loop
///!                 exits and early returns
///!   scalars       integer and boolean expressions, literals, and the
///!                 guarded operators
///!   observations  folding every computed value into the hash
///!   structs       struct declarations, literals, field places, methods
///!                 and method calls (stage 2)
///!   constants     arguments made only of literals (stage 2)
///!   generics      generic functions, their `T` values and their calls
///!                 (stage 3)
///!   generic_structures  generic structs and their instances (stage 3)
///!   inference     type arguments left to inference, and the values that
///!                 decide them (stage 3)
///!   generic_methods  a generic struct's own methods (stage 3)
///!   overloads     overload sets of free functions and methods (stage 3)
///!   enums         enums, their values, and `match` (stage 4)
///!   closures      closure locals and their calls (stage 5)
///!   function_values  function-typed parameters and returns, and the
///!                 closures and named functions given for them (stage 5)
///!   traits        traits and their implementations for structs (stage 6)
///!   moves         owned structs with a destructor, and their moves
///!                 (stage 7)
///!
///! Imports the model, `random`, `configuration`, `typing` and
///! `guarantees`; nothing below it imports it.

namespace cryosmith::generate;

module {
    generate::generator;
    generate::functions;
    generate::control_flow;
    generate::scalars;
    generate::observations;
    generate::structs;
    generate::constants;
    generate::generics;
    generate::generic_structures;
    generate::inference;
    generate::generic_methods;
    generate::overloads;
    generate::enums;
    generate::closures;
    generate::function_values;
    generate::traits;
    generate::moves;
}

export cryosmith::generate::generator::{ Generator };
