///! Constants (stage 2): an argument made only of literals.
///!
///! A parameter types literals combined with each other: an argument made
///! only of literals takes its parameter's type when every value it
///! computes on the way is one the parameter holds.  With `constants`, an
///! integer argument - of a call, a method call or a wrapping method - is
///! now and then `(a & b)`, `(a | b)` or `(a ^ b)` of two literals in
///! `[0, M]`, `M` the type's largest literal, and for a signed type with
///! `guarded`, sometimes its negation.  Every intermediate is in the type's
///! range, so the argument is typed by the parameter and never refused.

namespace cryosmith::generate::constants;

import cryosmith::configuration::{ Feature, FeatureSet };
import cryosmith::generate::generator::{ Generator };
import cryosmith::guarantees::{ ArithmeticGuard };
import cryosmith::model::{ BinaryOperator, ExpressionKind, UnaryOperator, ValueType };

implement struct Generator {
    /// Whether an argument for a parameter of `wanted` is a constant: now
    /// and then, for an integer, with `constants` and the bitwise operators
    /// it combines literals with enabled.  Draws nothing otherwise.
    internal constant_wanted(mut &this, wanted: ValueType) -> boolean {
        const features: FeatureSet = this.options.features;
        return features.has(Feature::Constants) && features.has(Feature::Bitwise) && wanted.is_integer() && this.random.chance(15);
    }

    /// An argument made only of literals, of `wanted`.
    internal constant(mut &this, wanted: ValueType) -> i64 {
        const maximum: u64 = ArithmeticGuard::largest_literal(wanted);
        const left: i64 = this.integer(this.random.bits() & maximum, wanted);
        const right: i64 = this.integer(this.random.bits() & maximum, wanted);
        const operator: BinaryOperator = this.bitwise_operator();
        const combined: i64 = this.node(ExpressionKind::Binary(operator, left, right), wanted);
        if (wanted.is_signed() && this.options.features.has(Feature::Guarded) && this.random.chance(50)) {
            return this.node(ExpressionKind::Unary(UnaryOperator::Negate, combined), wanted);
        }
        return combined;
    }
}
