///! The command line: `cryosmith <command> [options]`.
///!
///! The top layer: it may import every other layer, and nothing imports it
///! but the entry point.
///!
///!   commands  `Cli`: the dispatch, the usage text, and the commands that
///!             only generate (`generate`, `batch`, `features`, `version`)

namespace cryosmith::cli;

module {
    cli::commands;
}

export cryosmith::cli::commands::{ Cli };
