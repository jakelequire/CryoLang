///! Type-directed generation of a `Program` from a seed.
///!
///! An expression is generated for a wanted type, with a depth budget, from
///! the forms the enabled features allow; the environment lists the names
///! in scope.  Every form is valid under both overflow rules (wrapping, or
///! debug traps): plain `+`, `-`, `*` and negation only meet masked
///! operands whose result fits, a divisor is guarded into `[1, M]` and a
///! shift amount is masked below the width.  Loops count to a literal trip
///! count, a function calls only functions generated before it, and a cost
///! model bounds the work of every call, so every program terminates.
///!
///! Structs are declared first, then their methods, then the free
///! functions and `main`, each function from its own random stream.  A
///! method that writes its receiver returns nothing and is called only as
///! a statement, so no expression both changes a struct and reads it.

namespace cryosmith::generator;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::core::option::{ Option };
import std::random::generator::{ Rng };
import std::random::source::{ RandomSource };

import cryosmith::features::{ Feature, FeatureSet };
import cryosmith::program::{
    BinaryOperator, ExpressionKind, Field, Function, LoopShape, Program, Receiver, StatementKind, Structure,
    UnaryOperator, ValueType, Variable, VariableRole, WrappingOperator
};

/// The generator's version: raised whenever one seed and one set of
/// options may generate different text.
public const GENERATOR_VERSION: i64 = 3;

/// The spacing between the seeds of two functions' random streams.
const STREAM_SPACING: u64 = 0x9E3779B97F4A7C15;

/// Mixed into the seed of the stream the structs are declared from.
const STRUCTURE_STREAM: u64 = 0xD1B54A32D192ED03;

/// Mixed into the seed of every method's stream, so no method shares a
/// stream with a free function.
const METHOD_STREAM: u64 = 0x94D049BB133111EB;

/// The most work one call of a helper function or a method may do.
const HELPER_COST_LIMIT: u64 = 20000;

/// The most work `main` may do.
const MAIN_COST_LIMIT: u64 = 2000000;

/// The largest trip count of a loop.
const MOST_TRIPS: i64 = 6;

/// How deep loops nest.
const MOST_LOOPS: i64 = 3;

/// How deep blocks nest.
const MOST_BLOCKS: i64 = 4;

/// The most structs a program declares.
const MOST_STRUCTURES: i64 = 3;

/// The most fields a struct has.
const MOST_FIELDS: i64 = 4;

/// The most methods a struct has.
const MOST_METHODS: i64 = 3;

/// The largest literal magnitude: `i64::MAX`, so no unsigned literal is
/// written past it.
const LARGEST_LITERAL: u64 = 9223372036854775807;

/// A deliberate defect, for proving that a check can refuse.
public type enum Plant {
    /// No defect.
    Unplanted;
    /// A divisor loses its `| 1` and may be zero.
    UnguardedDivision;
}

implement enum Plant {
    /// The plant's name on a command line.
    public name(&this) -> Str {
        return match (&this) {
            Plant::Unplanted         => { Str::new("none") }
            Plant::UnguardedDivision => { Str::new("unguarded-division") }
        };
    }

    /// The plant named `name`, if there is one.
    public static named(name: Str) -> Option<Plant> {
        if (name == Str::new("none")) { return Option::Some(Plant::Unplanted); }
        if (name == Str::new("unguarded-division")) { return Option::Some(Plant::UnguardedDivision); }
        return Option::None;
    }

    /// Whether this is a defect.
    public is_planted(&this) -> boolean {
        return match (&this) {
            Plant::Unplanted => { false }
            _                => { true }
        };
    }
}

/// What a program is generated from.
public type struct GenerationOptions {
    /// The seed.
    public seed: u64;
    /// The enabled features.
    public features: FeatureSet;
    /// How many helper functions; -1 chooses from the seed.
    public functions: i64;
    /// The statement budget of one function.
    public size: i64;
    /// Whether the program starts with the header comment.
    public header: boolean;
    /// A deliberate defect, or none.
    public plant: Plant;

    /// The defaults for `seed`.
    public static new(seed: u64) -> GenerationOptions {
        return GenerationOptions {
            seed: seed, features: FeatureSet::default_set(), functions: -1, size: 24, header: true,
            plant: Plant::Unplanted,
        };
    }

    /// How many helper functions the program has: `functions`, or 2 to 6
    /// chosen from the seed.
    public function_count(&this) -> i64 {
        if (this.functions >= 0) { return this.functions; }
        mut stream: Rng = Rng::from_seed(this.seed);
        return 2 + stream.next_below(5);
    }
}

/// Builds one program.
public type struct Generator {
    program: Program;
    options: GenerationOptions;
    random: Rng;
    scope: Array<i64>;
    locals: i64;
    counters: i64;
    loop_depth: i64;
    block_depth: i64;
    multiplier: u64;
    spent: u64;
    limit: u64;
    statements_left: i64;
    in_main: boolean;
    returns: ValueType;

    /// The program `options` describe.
    public static generate(options: GenerationOptions) -> Program {
        mut generator: Generator = Generator {
            program: Program::new(), options: options, random: Rng::from_seed(options.seed),
            scope: Array::<i64>::new(), locals: 0, counters: 0, loop_depth: 0, block_depth: 0,
            multiplier: 1, spent: 0, limit: 0, statements_left: 0, in_main: false, returns: ValueType::I32,
        };
        if (options.features.has(Feature::Structs)) { generator.declare_structures(); }
        const count: i64 = options.function_count();
        mut number: i64 = 0;
        while (number < count) {
            generator.define(number, -1, Receiver::Free);
            number = number + 1;
        }
        generator.define(count, -1, Receiver::Free);
        return generator.program;
    }

    /// Declare one to three structs and their fields from the structs' own
    /// stream, then generate every struct's methods.  A field's struct type
    /// is an earlier struct's, so no struct contains itself.
    declare_structures(mut &this) -> void {
        this.random = Rng::from_seed(this.options.seed ^ STRUCTURE_STREAM);
        const count: i64 = 1 + this.below(MOST_STRUCTURES);
        mut receivers: Array<Receiver> = Array::<Receiver>::new();
        mut owners: Array<i64> = Array::<i64>::new();
        mut index: i64 = 0;
        while (index < count) {
            const first_field: i64 = this.program.fields.length();
            const field_count: i64 = 1 + this.below(MOST_FIELDS);
            mut number: i64 = 0;
            while (number < field_count) {
                const value_type: ValueType = if (index > 0 && this.chance(30)) { ValueType::Record(this.below(index)) } else { this.scalar_type() };
                mut default_value: i64 = -1;
                if (!value_type.is_record() && this.chance(30)) {
                    default_value = match (value_type) {
                        ValueType::Boolean => { this.node(ExpressionKind::BooleanLiteral(this.chance(50)), ValueType::Boolean) }
                        _                  => { this.literal(value_type) }
                    };
                }
                this.program.fields.push(Field { number: number, value_type: value_type, default_value: default_value });
                number = number + 1;
            }
            this.program.structures.push(Structure { number: index, first_field: first_field, field_count: field_count });
            const methods: i64 = 1 + this.below(MOST_METHODS);
            mut method: i64 = 0;
            while (method < methods) {
                const roll: i64 = this.below(10);
                receivers.push(if (roll < 3) { Receiver::Static } else { if (roll < 7) { Receiver::Shared } else { Receiver::Exclusive } });
                owners.push(index);
                method = method + 1;
            }
            index = index + 1;
        }
        mut numbers: Array<i64> = Array::<i64>::new();
        index = 0;
        while (index < count) { numbers.push(0); index = index + 1; }
        index = 0;
        while (index < owners.length()) {
            const owner: i64 = owners.get(index).unwrap();
            const number: i64 = numbers.get(owner).unwrap();
            numbers.set(owner, number + 1);
            this.define(number, owner, receivers.get(index).unwrap());
            index = index + 1;
        }
    }

    /// Generate one function from its own random stream: free function
    /// `number` (or `main` after the last), or method `number` of struct
    /// `owner`.
    define(mut &this, number: i64, owner: i64, receiver: Receiver) -> void {
        const is_main: boolean = owner < 0 && number == this.options.function_count();
        const stream: u64 = if (owner < 0) {
            this.options.seed ^ ((number as u64) + 1).wrapping_multiply(STREAM_SPACING)
        } else {
            this.options.seed ^ METHOD_STREAM ^ ((this.program.functions.length() as u64) + 1).wrapping_multiply(STREAM_SPACING)
        };
        this.random = Rng::from_seed(stream);
        this.scope.clear();
        this.scope.push(Program::observed());
        this.locals = 0;
        this.counters = 0;
        this.loop_depth = 0;
        this.block_depth = 0;
        this.multiplier = 1;
        this.spent = 0;
        this.limit = if (is_main) { MAIN_COST_LIMIT } else { HELPER_COST_LIMIT };
        this.statements_left = if (owner < 0) { this.options.size } else { (this.options.size + 1) / 2 };
        this.in_main = is_main;
        const receiver_variable: i64 = match (receiver) {
            Receiver::Shared    => { this.program.variable(Variable { role: VariableRole::Receiver, number: 0, value_type: ValueType::Record(owner), mutable: false }) }
            Receiver::Exclusive => { this.program.variable(Variable { role: VariableRole::Receiver, number: 0, value_type: ValueType::Record(owner), mutable: true }) }
            _                   => { -1 }
        };
        if (receiver_variable >= 0) { this.scope.push(receiver_variable); }
        const first_parameter: i64 = this.program.lists.length();
        mut parameter_count: i64 = 0;
        if (!is_main) {
            parameter_count = if (owner < 0) { 1 + this.below(4) } else { this.below(4) };
            mut index: i64 = 0;
            while (index < parameter_count) {
                const value_type: ValueType = this.any_type();
                const parameter: i64 = this.program.variable(Variable { role: VariableRole::Parameter, number: index, value_type: value_type, mutable: false });
                this.program.lists.push(parameter);
                this.scope.push(parameter);
                index = index + 1;
            }
        }
        this.returns = match (receiver) {
            Receiver::Exclusive => { ValueType::Void }
            Receiver::Static    => { (if (this.chance(50)) { ValueType::Record(owner) } else { this.any_type() }) }
            _                   => { (if (is_main) { ValueType::I32 } else { this.any_type() }) }
        };
        mut statements: Array<i64> = Array::<i64>::new();
        const body_start: i64 = this.scope.length();
        this.fill(&statements, true);
        this.observe_declared(body_start, &statements);
        if (is_main) {
            mut helper: i64 = 0;
            while (helper < this.program.functions.length()) {
                const called: Function = this.program.function_at(helper);
                if (called.owner < 0 && this.callees(called.returns).contains(&helper)) {
                    this.observe_value(this.call(helper, 2), &statements);
                }
                helper = helper + 1;
            }
            statements.push(this.program.statement(StatementKind::Finish));
        } else {
            mut index: i64 = 0;
            while (index < parameter_count) {
                const parameter: i64 = this.program.list_at(first_parameter + index);
                this.observe_place(this.read(parameter), &statements);
                index = index + 1;
            }
            if (receiver_variable >= 0) { this.observe_place(this.read(receiver_variable), &statements); }
            if (!this.returns.same(ValueType::Void)) {
                const value: i64 = this.typed_place(this.returns, this.depth());
                statements.push(this.program.statement(StatementKind::Return(value)));
            }
        }
        const body: i64 = this.program.block(&statements);
        this.program.functions.push(Function {
            number: number, is_main: is_main, owner: owner, receiver: receiver, first_parameter: first_parameter,
            parameter_count: parameter_count, returns: this.returns, body: body, cost: this.spent,
        });
    }

    // ---- statements ------------------------------------------------------

    /// Append statements to `statements`: until the budget is spent for a
    /// function's top block, else one to six.
    fill(mut &this, statements: mut &Array<i64>, top: boolean) -> void {
        if (this.statements_left <= 0) { return; }
        mut count: i64 = 1 + this.below(if (this.statements_left < 6) { this.statements_left } else { 6 });
        while (this.statements_left > 0 && (top || count > 0)) {
            this.statements_left = this.statements_left - 1;
            count = count - 1;
            statements.push(this.statement());
        }
    }

    /// A nested block: its statements, then an observation of each local
    /// it declared.
    /// It spends at most half the statements left, so the block holding it
    /// keeps statements of its own.
    block(mut &this) -> i64 {
        const start: i64 = this.scope.length();
        const reserved: i64 = this.statements_left / 2;
        this.statements_left = this.statements_left - reserved;
        this.block_depth = this.block_depth + 1;
        mut statements: Array<i64> = Array::<i64>::new();
        this.fill(&statements, false);
        this.observe_declared(start, &statements);
        this.scope.truncate(start);
        this.block_depth = this.block_depth - 1;
        this.statements_left = this.statements_left + reserved;
        return this.program.block(&statements);
    }

    /// Observe every local declared in the scope from `start`.
    observe_declared(mut &this, start: i64, statements: mut &Array<i64>) -> void {
        mut index: i64 = start;
        while (index < this.scope.length()) {
            const variable: i64 = this.scope.get(index).unwrap();
            match (this.program.variable_at(variable).role) {
                VariableRole::Local => { this.observe_place(this.read(variable), statements); }
                _                   => { }
            }
            index = index + 1;
        }
    }

    /// Observe a place: a scalar is folded into `observed`, a struct is
    /// observed field by field.
    observe_place(mut &this, place: i64, statements: mut &Array<i64>) -> void {
        const value_type: ValueType = this.program.expression_at(place).value_type;
        if (!value_type.is_record()) {
            statements.push(this.observation(place));
            return;
        }
        const declared: Structure = this.program.structure_at(value_type.structure());
        mut field: i64 = declared.first_field;
        while (field < declared.first_field + declared.field_count) {
            const field_place: i64 = this.node(ExpressionKind::Field(place, field), this.program.field_at(field).value_type);
            this.observe_place(field_place, statements);
            field = field + 1;
        }
    }

    /// Observe a value: a scalar directly, a struct by binding it to a
    /// local first, so it is computed once.
    observe_value(mut &this, value: i64, statements: mut &Array<i64>) -> void {
        const value_type: ValueType = this.program.expression_at(value).value_type;
        if (!value_type.is_record()) {
            statements.push(this.observation(value));
            return;
        }
        const variable: i64 = this.program.variable(Variable { role: VariableRole::Local, number: this.locals, value_type: value_type, mutable: false });
        this.locals = this.locals + 1;
        statements.push(this.program.statement(StatementKind::Declare(variable, value)));
        this.scope.push(variable);
        this.observe_place(this.read(variable), statements);
    }

    /// One statement, chosen by weight from those allowed here.
    statement(mut &this) -> i64 {
        const features: FeatureSet = this.options.features;
        const nested: boolean = this.block_depth < MOST_BLOCKS;
        const writable: Array<i64> = this.writable_records();
        const mutators: Array<i64> = this.method_calls(ValueType::Void, true);
        mut weights: Array<i64> = Array::<i64>::new();
        weights.push(30);
        weights.push(if (this.assignable().length() > 0) { 20 } else { 0 });
        weights.push(12);
        weights.push(if (features.has(Feature::Branches) && nested) { 10 } else { 0 });
        weights.push(if (features.has(Feature::Loops) && nested && this.loop_depth < MOST_LOOPS) { 10 } else { 0 });
        weights.push(if (features.has(Feature::LoopExits) && this.loop_depth > 0) { 4 } else { 0 });
        weights.push(if (features.has(Feature::EarlyReturns) && !this.in_main) { 4 } else { 0 });
        weights.push(if (writable.length() > 0) { 14 } else { 0 });
        weights.push(if (mutators.length() > 0) { 8 } else { 0 });
        const form: i64 = this.pick(&weights);
        this.charge(1);
        if (form == 0) { return this.declaration(); }
        if (form == 1) {
            const candidates: Array<i64> = this.assignable();
            return this.store(this.target(candidates.get(this.below(candidates.length())).unwrap()));
        }
        if (form == 2) {
            const value_type: ValueType = this.scalar_type();
            return this.observation(this.expression(value_type, this.depth(), true));
        }
        if (form == 3) {
            const condition: i64 = this.condition(this.depth());
            const then_block: i64 = this.block();
            const else_block: i64 = if (this.chance(50)) { this.block() } else { -1 };
            return this.program.statement(StatementKind::Branch(condition, then_block, else_block));
        }
        if (form == 4) { return this.loop_statement(); }
        if (form == 5) {
            const condition: i64 = this.condition(this.depth());
            return this.program.statement(StatementKind::Exit(this.chance(50), condition));
        }
        if (form == 6) {
            const condition: i64 = this.condition(this.depth());
            const value: i64 = if (this.returns.same(ValueType::Void)) { -1 } else { this.typed_place(this.returns, this.depth()) };
            return this.program.statement(StatementKind::ReturnIf(condition, value));
        }
        if (form == 7) { return this.store(this.field_place(writable.get(this.below(writable.length())).unwrap())); }
        const method: i64 = mutators.get(this.below(mutators.length())).unwrap();
        return this.program.statement(StatementKind::Evaluate(this.method_call(method, this.depth())));
    }

    /// `const` or `mut` local with its initial value; the name is in scope
    /// only after the value, so the value cannot read it.
    declaration(mut &this) -> i64 {
        const value_type: ValueType = this.any_type();
        const value: i64 = this.typed_place(value_type, this.depth());
        const variable: i64 = this.program.variable(Variable { role: VariableRole::Local, number: this.locals, value_type: value_type, mutable: this.chance(50) });
        this.locals = this.locals + 1;
        this.scope.push(variable);
        return this.program.statement(StatementKind::Declare(variable, value));
    }

    /// A store to `place`, a `mut` local or a field reached from a
    /// writable struct: plain, or a compound operator that cannot overflow.
    store(mut &this, place: i64) -> i64 {
        const value_type: ValueType = this.program.expression_at(place).value_type;
        const features: FeatureSet = this.options.features;
        if (value_type.is_integer() && this.chance(35)) {
            mut weights: Array<i64> = Array::<i64>::new();
            weights.push(if (features.has(Feature::Bitwise)) { 3 } else { 0 });
            weights.push(if (features.has(Feature::Shifts)) { 2 } else { 0 });
            weights.push(if (features.has(Feature::Division)) { 2 } else { 0 });
            const total: i64 = weights.iter().sum();
            if (total > 0) {
                const form: i64 = this.pick(&weights);
                const depth: i64 = this.depth();
                if (form == 0) {
                    const operator: BinaryOperator = match (this.below(3)) {
                        0 => { BinaryOperator::BitAnd }
                        1 => { BinaryOperator::BitOr }
                        _ => { BinaryOperator::BitXor }
                    };
                    return this.program.statement(StatementKind::Compound(operator, place, this.expression(value_type, depth, false)));
                }
                if (form == 1) {
                    const operator: BinaryOperator = if (this.chance(50)) { BinaryOperator::ShiftLeft } else { BinaryOperator::ShiftRight };
                    return this.program.statement(StatementKind::Compound(operator, place, this.shift_amount(value_type, depth)));
                }
                const operator: BinaryOperator = if (this.chance(50)) { BinaryOperator::Divide } else { BinaryOperator::Remainder };
                return this.program.statement(StatementKind::Compound(operator, place, this.divisor(value_type, depth)));
            }
        }
        return this.program.statement(StatementKind::Assign(place, this.typed_place(value_type, this.depth())));
    }

    /// A field reached from the writable struct `root`: a walk down its
    /// fields that stops at a scalar, or at a nested struct half the time.
    field_place(mut &this, root: i64) -> i64 {
        mut place: i64 = this.target(root);
        mut value_type: ValueType = this.program.variable_at(root).value_type;
        while (true) {
            const declared: Structure = this.program.structure_at(value_type.structure());
            const field: i64 = declared.first_field + this.below(declared.field_count);
            value_type = this.program.field_at(field).value_type;
            place = this.program.expression(ExpressionKind::Field(place, field), value_type);
            if (!value_type.is_record() || this.chance(50)) { return place; }
        }
        return place;
    }

    /// A store's target, `variable` named: a place written is not a value
    /// read, so it is not charged as work.
    target(mut &this, variable: i64) -> i64 {
        return this.program.expression(ExpressionKind::Variable(variable), this.program.variable_at(variable).value_type);
    }

    /// A bounded loop.  The counter is read only, and the body's work is
    /// charged once per trip.
    loop_statement(mut &this) -> i64 {
        const shape: LoopShape = match (this.below(3)) {
            0 => { LoopShape::Counted }
            1 => { LoopShape::Conditioned }
            _ => { LoopShape::Ranged }
        };
        const value_type: ValueType = match (shape) {
            LoopShape::Ranged => { ValueType::I32 }
            _                 => { this.integer_type() }
        };
        const trips: i64 = this.below(MOST_TRIPS + 1);
        const counter: i64 = this.program.variable(Variable { role: VariableRole::Counter, number: this.counters, value_type: value_type, mutable: true });
        this.counters = this.counters + 1;
        const outer: u64 = this.multiplier;
        this.multiplier = outer * (if (trips > 0) { trips as u64 } else { 1 });
        this.charge(2);
        this.loop_depth = this.loop_depth + 1;
        this.scope.push(counter);
        const body: i64 = this.block();
        this.scope.truncate(this.scope.length() - 1);
        this.loop_depth = this.loop_depth - 1;
        this.multiplier = outer;
        return this.program.statement(StatementKind::Loop(shape, counter, trips as u64, body));
    }

    /// `observed = mix(observed, value)`.
    observation(mut &this, value: i64) -> i64 {
        return this.program.statement(StatementKind::Observe(value));
    }

    /// The `mut` locals in scope, which may be assigned whole.
    assignable(&this) -> Array<i64> {
        mut found: Array<i64> = Array::<i64>::new();
        for (variable in this.scope.iter()) {
            const declared: Variable = this.program.variable_at(variable);
            match (declared.role) {
                VariableRole::Local => { if (declared.mutable) { found.push(variable); } }
                _                   => { }
            }
        }
        return found;
    }

    /// The structs in scope whose fields may be written: `mut` locals and
    /// a `mut &this`.
    writable_records(&this) -> Array<i64> {
        mut found: Array<i64> = Array::<i64>::new();
        for (variable in this.scope.iter()) {
            const declared: Variable = this.program.variable_at(variable);
            if (declared.value_type.is_record() && Generator::is_writable(declared)) { found.push(variable); }
        }
        return found;
    }

    /// Whether `variable`'s fields may be written.
    static is_writable(variable: Variable) -> boolean {
        return match (variable.role) {
            VariableRole::Local => { variable.mutable }
            VariableRole::Receiver => { variable.mutable }
            _                   => { false }
        };
    }

    // ---- expressions -----------------------------------------------------

    /// An expression of `wanted` where the language converts implicitly:
    /// an initializer, an assignment, an argument, a return value or a
    /// struct literal's field.  It may be a narrower value, widened.
    typed_place(mut &this, wanted: ValueType, depth: i64) -> i64 {
        if (this.options.features.has(Feature::Widening) && wanted.is_integer() && this.chance(15)) {
            mut narrower: Array<ValueType> = Array::<ValueType>::new();
            for (candidate in ValueType::integers().iter()) {
                if (candidate.widens_to(wanted)) { narrower.push(candidate); }
            }
            if (narrower.length() > 0) {
                const source: ValueType = narrower.get(this.below(narrower.length())).unwrap();
                const operand: i64 = this.expression(source, depth, true);
                return this.node(ExpressionKind::Widen(operand), wanted);
            }
        }
        return this.expression(wanted, depth, false);
    }

    /// An expression of `wanted`: a bare literal, or one that reads a name
    /// (a variable, a field, a call, a named limit), never only literals
    /// combined.  A literal combined with a name takes the name's type, but
    /// literals combined with each other are typed by where the whole
    /// stands, and an operand gives them none.  With `reads_name`, not even
    /// a bare literal: a method's receiver, a cast's operand and an `if`
    /// expression's arms give a literal no type either.
    expression(mut &this, wanted: ValueType, depth: i64, reads_name: boolean) -> i64 {
        match (wanted) {
            ValueType::Boolean   => { return this.boolean_expression(depth, reads_name); }
            ValueType::Record(_) => { return this.record_expression(wanted, depth); }
            _                    => { return this.integer_expression(wanted, depth, reads_name); }
        }
    }

    /// An integer expression of `wanted`.
    integer_expression(mut &this, wanted: ValueType, depth: i64, reads_name: boolean) -> i64 {
        const features: FeatureSet = this.options.features;
        const deeper: boolean = depth > 0;
        const next: i64 = depth - 1;
        const variables: Array<i64> = this.variables_of(wanted);
        const callees: Array<i64> = this.callees(wanted);
        const roots: Array<i64> = this.field_roots(wanted);
        const methods: Array<i64> = this.method_calls(wanted, false);
        mut weights: Array<i64> = Array::<i64>::new();
        weights.push(if (reads_name) { 0 } else { 10 });
        weights.push(1);
        weights.push(if (variables.length() > 0) { 14 } else { 0 });
        const others: Array<i64> = this.integer_variables_except(wanted);
        weights.push(if (features.has(Feature::Casts) && (deeper || others.length() > 0)) { 6 } else { 0 });
        weights.push(if (features.has(Feature::Wrapping) && deeper) { 10 } else { 0 });
        weights.push(if (features.has(Feature::Guarded) && deeper) { 10 } else { 0 });
        weights.push(if (features.has(Feature::Bitwise) && deeper) { 8 } else { 0 });
        weights.push(if (features.has(Feature::Shifts) && deeper) { 5 } else { 0 });
        weights.push(if (features.has(Feature::Division) && deeper) { 5 } else { 0 });
        weights.push(if (features.has(Feature::Guarded) && wanted.is_signed() && deeper) { 3 } else { 0 });
        weights.push(if (features.has(Feature::IfExpressions) && deeper) { 3 } else { 0 });
        weights.push(if (callees.length() > 0 && deeper) { 6 } else { 0 });
        weights.push(if (roots.length() > 0) { 10 } else { 0 });
        weights.push(if (methods.length() > 0 && deeper) { 6 } else { 0 });
        const form: i64 = this.pick(&weights);
        if (form == 0) { return this.literal(wanted); }
        if (form == 1) { return this.node(ExpressionKind::Limit(this.chance(50)), wanted); }
        if (form == 2) { return this.read(variables.get(this.below(variables.length())).unwrap()); }
        if (form == 3) {
            if (!deeper) {
                return this.node(ExpressionKind::Cast(this.read(others.get(this.below(others.length())).unwrap())), wanted);
            }
            mut source: ValueType = this.integer_type();
            while (source.same(wanted)) { source = this.integer_type(); }
            return this.node(ExpressionKind::Cast(this.expression(source, next, true)), wanted);
        }
        if (form == 4) {
            const operator: WrappingOperator = match (this.below(3)) {
                0 => { WrappingOperator::Add }
                1 => { WrappingOperator::Subtract }
                _ => { WrappingOperator::Multiply }
            };
            const receiver: i64 = this.expression(wanted, next, true);
            const argument: i64 = if (this.constant_wanted(wanted)) { this.constant(wanted) } else { this.expression(wanted, next, false) };
            return this.node(ExpressionKind::Wrapping(operator, receiver, argument), wanted);
        }
        if (form == 5) { return this.guarded(wanted, next); }
        if (form == 6) {
            if (this.chance(25)) {
                return this.node(ExpressionKind::Unary(UnaryOperator::Complement, this.expression(wanted, next, true)), wanted);
            }
            const operator: BinaryOperator = match (this.below(3)) {
                0 => { BinaryOperator::BitAnd }
                1 => { BinaryOperator::BitOr }
                _ => { BinaryOperator::BitXor }
            };
            const left: i64 = this.expression(wanted, next, true);
            const right: i64 = this.expression(wanted, next, false);
            return this.node(ExpressionKind::Binary(operator, left, right), wanted);
        }
        if (form == 7) {
            const operator: BinaryOperator = if (this.chance(50)) { BinaryOperator::ShiftLeft } else { BinaryOperator::ShiftRight };
            const value: i64 = this.expression(wanted, next, true);
            const amount: i64 = this.shift_amount(wanted, next);
            return this.node(ExpressionKind::Binary(operator, value, amount), wanted);
        }
        if (form == 8) {
            const operator: BinaryOperator = if (this.chance(50)) { BinaryOperator::Divide } else { BinaryOperator::Remainder };
            const dividend: i64 = this.expression(wanted, next, true);
            const divisor: i64 = this.divisor(wanted, next);
            return this.node(ExpressionKind::Binary(operator, dividend, divisor), wanted);
        }
        if (form == 9) {
            const operand: i64 = this.masked(this.expression(wanted, next, true), wanted.maximum(), wanted);
            return this.node(ExpressionKind::Unary(UnaryOperator::Negate, operand), wanted);
        }
        if (form == 10) {
            const condition: i64 = this.condition(next);
            const then_value: i64 = this.expression(wanted, next, true);
            const else_value: i64 = this.expression(wanted, next, true);
            return this.node(ExpressionKind::Conditional(condition, then_value, else_value), wanted);
        }
        if (form == 11) { return this.call(callees.get(this.below(callees.length())).unwrap(), next); }
        if (form == 12) { return this.place(roots.get(this.below(roots.length())).unwrap(), wanted); }
        return this.method_call(methods.get(this.below(methods.length())).unwrap(), next);
    }

    /// A struct-typed expression of `wanted`: a literal, a variable, a
    /// field, a call or an `if` expression.  A literal names its type, so
    /// every form reads a name.
    record_expression(mut &this, wanted: ValueType, depth: i64) -> i64 {
        const deeper: boolean = depth > 0;
        const next: i64 = if (deeper) { depth - 1 } else { 0 };
        const variables: Array<i64> = this.variables_of(wanted);
        const roots: Array<i64> = this.field_roots(wanted);
        const callees: Array<i64> = this.callees(wanted);
        const methods: Array<i64> = this.method_calls(wanted, false);
        mut weights: Array<i64> = Array::<i64>::new();
        weights.push(8);
        weights.push(if (variables.length() > 0) { 10 } else { 0 });
        weights.push(if (roots.length() > 0) { 6 } else { 0 });
        weights.push(if (callees.length() > 0 && deeper) { 6 } else { 0 });
        weights.push(if (methods.length() > 0 && deeper) { 5 } else { 0 });
        weights.push(if (this.options.features.has(Feature::IfExpressions) && deeper) { 2 } else { 0 });
        const form: i64 = this.pick(&weights);
        if (form == 0) { return this.record_literal(wanted, next); }
        if (form == 1) { return this.read(variables.get(this.below(variables.length())).unwrap()); }
        if (form == 2) { return this.place(roots.get(this.below(roots.length())).unwrap(), wanted); }
        if (form == 3) { return this.call(callees.get(this.below(callees.length())).unwrap(), next); }
        if (form == 4) { return this.method_call(methods.get(this.below(methods.length())).unwrap(), next); }
        const condition: i64 = this.condition(next);
        const then_value: i64 = this.record_expression(wanted, next);
        const else_value: i64 = this.record_expression(wanted, next);
        return this.node(ExpressionKind::Conditional(condition, then_value, else_value), wanted);
    }

    /// `S { f: value, ... }`, its fields in a shuffled order; a field with a
    /// default is left out half the time.
    record_literal(mut &this, wanted: ValueType, depth: i64) -> i64 {
        const declared: Structure = this.program.structure_at(wanted.structure());
        mut order: Array<i64> = Array::<i64>::new();
        mut field: i64 = declared.first_field;
        while (field < declared.first_field + declared.field_count) {
            if (this.program.field_at(field).default_value < 0 || this.chance(50)) { order.push(field); }
            field = field + 1;
        }
        mut index: i64 = order.length() - 1;
        while (index > 0) {
            const other: i64 = this.below(index + 1);
            const swapped: i64 = order.get(index).unwrap();
            order.set(index, order.get(other).unwrap());
            order.set(other, swapped);
            index = index - 1;
        }
        mut values: Array<i64> = Array::<i64>::new();
        for (written in order.iter()) { values.push(this.typed_place(this.program.field_at(written).value_type, depth)); }
        const first: i64 = this.program.lists.length();
        index = 0;
        while (index < order.length()) {
            this.program.lists.push(order.get(index).unwrap());
            this.program.lists.push(values.get(index).unwrap());
            index = index + 1;
        }
        return this.node(ExpressionKind::StructureLiteral(wanted.structure(), first, order.length()), wanted);
    }

    /// A plain `+`, `-` or `*` over operands masked so that the result fits
    /// `wanted` (`W` its width): `+` and signed `-` mask both sides to
    /// `2^(W-2) - 1`; unsigned `-` sets bit `W-2` of the left side and
    /// masks the right below it, so the left is larger; `*` masks both sides
    /// below the square root of the range.
    guarded(mut &this, wanted: ValueType, depth: i64) -> i64 {
        const width: u64 = wanted.width();
        const quarter: u64 = 1 << (width - 2);
        const left: i64 = this.expression(wanted, depth, true);
        const right: i64 = this.expression(wanted, depth, true);
        const choice: i64 = this.below(3);
        if (choice == 0) {
            return this.node(ExpressionKind::Binary(BinaryOperator::Add, this.masked(left, quarter - 1, wanted), this.masked(right, quarter - 1, wanted)), wanted);
        }
        if (choice == 1) {
            if (wanted.is_signed()) {
                return this.node(ExpressionKind::Binary(BinaryOperator::Subtract, this.masked(left, quarter - 1, wanted), this.masked(right, quarter - 1, wanted)), wanted);
            }
            const raised: i64 = this.node(ExpressionKind::Binary(BinaryOperator::BitOr, left, this.integer(quarter, wanted)), wanted);
            return this.node(ExpressionKind::Binary(BinaryOperator::Subtract, raised, this.masked(right, quarter - 1, wanted)), wanted);
        }
        const root_bits: u64 = if (wanted.is_signed()) { (width - 1) / 2 } else { width / 2 };
        const root: u64 = (1 << root_bits) - 1;
        return this.node(ExpressionKind::Binary(BinaryOperator::Multiply, this.masked(left, root, wanted), this.masked(right, root, wanted)), wanted);
    }

    /// `(value & mask)`.
    masked(mut &this, value: i64, mask: u64, value_type: ValueType) -> i64 {
        return this.node(ExpressionKind::Binary(BinaryOperator::BitAnd, value, this.integer(mask, value_type)), value_type);
    }

    /// A shift amount for a `value_type` value: `(e & (W - 1))`.
    shift_amount(mut &this, value_type: ValueType, depth: i64) -> i64 {
        return this.masked(this.expression(value_type, depth, true), value_type.width() - 1, value_type);
    }

    /// A divisor for a `value_type` dividend: `((e & M) | 1)`,
    /// `M = 2^(W-2) - 1`, never zero and never negative.  The
    /// unguarded-division plant leaves the `| 1` out.
    divisor(mut &this, value_type: ValueType, depth: i64) -> i64 {
        const mask: u64 = (1 << (value_type.width() - 2)) - 1;
        const bounded: i64 = this.masked(this.expression(value_type, depth, true), mask, value_type);
        match (this.options.plant) {
            Plant::UnguardedDivision => { return bounded; }
            _                        => { }
        }
        return this.node(ExpressionKind::Binary(BinaryOperator::BitOr, bounded, this.integer(1, value_type)), value_type);
    }

    /// A call of the free function or static method `callee`, with
    /// arguments for its parameters.
    call(mut &this, callee: i64, depth: i64) -> i64 {
        const called: Function = this.program.function_at(callee);
        const first: i64 = this.arguments(called, depth);
        return this.node(ExpressionKind::Call(callee, first, called.parameter_count), called.returns);
    }

    /// A call of the method `callee` on a place of its struct: one whose
    /// fields may be written when the method takes `mut &this`.
    method_call(mut &this, callee: i64, depth: i64) -> i64 {
        const called: Function = this.program.function_at(callee);
        const owner: ValueType = ValueType::Record(called.owner);
        const roots: Array<i64> = this.receiver_roots(owner, Generator::writes_receiver(called));
        const receiver: i64 = this.place(roots.get(this.below(roots.length())).unwrap(), owner);
        const first: i64 = this.arguments(called, depth);
        return this.node(ExpressionKind::MethodCall(receiver, callee, first, called.parameter_count), called.returns);
    }

    /// Charge a call of `called` and generate its arguments; the first
    /// argument's place in the index lists.
    arguments(mut &this, called: Function, depth: i64) -> i64 {
        this.charge(called.cost);
        mut arguments: Array<i64> = Array::<i64>::new();
        mut index: i64 = 0;
        while (index < called.parameter_count) {
            const parameter: Variable = this.program.variable_at(this.program.list_at(called.first_parameter + index));
            if (this.constant_wanted(parameter.value_type)) {
                arguments.push(this.constant(parameter.value_type));
            } else {
                arguments.push(this.typed_place(parameter.value_type, if (depth < 0) { 0 } else { depth }));
            }
            index = index + 1;
        }
        const first: i64 = this.program.lists.length();
        for (argument in arguments.iter()) { this.program.lists.push(argument); }
        return first;
    }

    /// Whether an argument for a parameter of `wanted` is a constant: now
    /// and then, for an integer, with `constants` and the bitwise operators
    /// it combines literals with enabled.
    constant_wanted(mut &this, wanted: ValueType) -> boolean {
        const features: FeatureSet = this.options.features;
        return features.has(Feature::Constants) && features.has(Feature::Bitwise) && wanted.is_integer() && this.chance(15);
    }

    /// An argument made only of literals: `(a & b)`, `(a | b)` or `(a ^ b)`
    /// of two literals in `[0, M]`, `M` the largest literal of `wanted`,
    /// and for a signed type, with `guarded`, sometimes its negation.  Every value it
    /// computes on the way is one `wanted` holds, so the parameter it is
    /// passed to types it.
    constant(mut &this, wanted: ValueType) -> i64 {
        const maximum: u64 = if (wanted.maximum() > LARGEST_LITERAL) { LARGEST_LITERAL } else { wanted.maximum() };
        const left: i64 = this.integer(this.random.next_64() & maximum, wanted);
        const right: i64 = this.integer(this.random.next_64() & maximum, wanted);
        const operator: BinaryOperator = match (this.below(3)) {
            0 => { BinaryOperator::BitAnd }
            1 => { BinaryOperator::BitOr }
            _ => { BinaryOperator::BitXor }
        };
        const combined: i64 = this.node(ExpressionKind::Binary(operator, left, right), wanted);
        if (wanted.is_signed() && this.options.features.has(Feature::Guarded) && this.chance(50)) {
            return this.node(ExpressionKind::Unary(UnaryOperator::Negate, combined), wanted);
        }
        return combined;
    }

    /// Whether `called` takes `mut &this`.
    static writes_receiver(called: Function) -> boolean {
        return match (called.receiver) {
            Receiver::Exclusive => { true }
            _                   => { false }
        };
    }

    /// A place of type `wanted` reached from the variable `root`: the
    /// variable itself when it is of `wanted`, else a walk down the fields
    /// that lead to one.
    place(mut &this, root: i64, wanted: ValueType) -> i64 {
        mut place: i64 = this.read(root);
        mut value_type: ValueType = this.program.variable_at(root).value_type;
        while (!value_type.same(wanted)) {
            const declared: Structure = this.program.structure_at(value_type.structure());
            mut leading: Array<i64> = Array::<i64>::new();
            mut field: i64 = declared.first_field;
            while (field < declared.first_field + declared.field_count) {
                const field_type: ValueType = this.program.field_at(field).value_type;
                if (field_type.same(wanted) || this.program.reaches(field_type, wanted)) { leading.push(field); }
                field = field + 1;
            }
            const chosen: i64 = leading.get(this.below(leading.length())).unwrap();
            value_type = this.program.field_at(chosen).value_type;
            place = this.node(ExpressionKind::Field(place, chosen), value_type);
        }
        return place;
    }

    /// A boolean expression.
    boolean_expression(mut &this, depth: i64, reads_name: boolean) -> i64 {
        const features: FeatureSet = this.options.features;
        const deeper: boolean = depth > 0 && features.has(Feature::Booleans);
        const next: i64 = if (depth > 0) { depth - 1 } else { 0 };
        const variables: Array<i64> = this.variables_of(ValueType::Boolean);
        const callees: Array<i64> = this.callees(ValueType::Boolean);
        const roots: Array<i64> = this.field_roots(ValueType::Boolean);
        const methods: Array<i64> = this.method_calls(ValueType::Boolean, false);
        mut weights: Array<i64> = Array::<i64>::new();
        weights.push(if (reads_name || !features.has(Feature::Booleans)) { 0 } else { 2 });
        weights.push(if (variables.length() > 0) { 10 } else { 0 });
        weights.push(12);
        weights.push(if (features.has(Feature::Booleans)) { 4 } else { 0 });
        weights.push(if (deeper) { 6 } else { 0 });
        weights.push(if (deeper) { 3 } else { 0 });
        weights.push(if (deeper) { 2 } else { 0 });
        weights.push(if (callees.length() > 0 && depth > 0) { 4 } else { 0 });
        weights.push(if (roots.length() > 0) { 8 } else { 0 });
        weights.push(if (methods.length() > 0 && depth > 0) { 4 } else { 0 });
        const form: i64 = this.pick(&weights);
        if (form == 0) { return this.node(ExpressionKind::BooleanLiteral(this.chance(50)), ValueType::Boolean); }
        if (form == 1) { return this.read(variables.get(this.below(variables.length())).unwrap()); }
        if (form == 2) {
            const value_type: ValueType = this.integer_type();
            const left: i64 = this.expression(value_type, next, true);
            const right: i64 = this.expression(value_type, next, false);
            return this.node(ExpressionKind::Binary(this.comparison(), left, right), ValueType::Boolean);
        }
        if (form == 3) {
            const left_type: ValueType = this.integer_type();
            mut right_type: ValueType = this.integer_type();
            while (right_type.same(left_type)) { right_type = this.integer_type(); }
            const left: i64 = this.expression(left_type, next, true);
            const right: i64 = this.expression(right_type, next, true);
            return this.node(ExpressionKind::Binary(this.comparison(), left, right), ValueType::Boolean);
        }
        if (form == 4) {
            const operator: BinaryOperator = if (this.chance(50)) { BinaryOperator::And } else { BinaryOperator::Or };
            const left: i64 = this.boolean_expression(next, reads_name);
            const right: i64 = this.boolean_expression(next, false);
            return this.node(ExpressionKind::Binary(operator, left, right), ValueType::Boolean);
        }
        if (form == 5) {
            return this.node(ExpressionKind::Unary(UnaryOperator::Not, this.boolean_expression(next, true)), ValueType::Boolean);
        }
        if (form == 6) {
            const operator: BinaryOperator = if (this.chance(50)) { BinaryOperator::Equal } else { BinaryOperator::NotEqual };
            const left: i64 = this.boolean_expression(next, true);
            const right: i64 = this.boolean_expression(next, false);
            return this.node(ExpressionKind::Binary(operator, left, right), ValueType::Boolean);
        }
        if (form == 7) { return this.call(callees.get(this.below(callees.length())).unwrap(), next); }
        if (form == 8) { return this.place(roots.get(this.below(roots.length())).unwrap(), ValueType::Boolean); }
        return this.method_call(methods.get(this.below(methods.length())).unwrap(), next);
    }

    /// A condition for a branch, loop exit or early return.
    condition(mut &this, depth: i64) -> i64 { return this.boolean_expression(depth, false); }

    /// One of the six comparison operators.
    comparison(mut &this) -> BinaryOperator {
        return match (this.below(6)) {
            0 => { BinaryOperator::Equal }
            1 => { BinaryOperator::NotEqual }
            2 => { BinaryOperator::Less }
            3 => { BinaryOperator::LessEqual }
            4 => { BinaryOperator::Greater }
            _ => { BinaryOperator::GreaterEqual }
        };
    }

    /// A literal of `wanted`: small values, 1, the largest magnitude, or a
    /// random one; never past `i64::MAX`, and negative only for a signed
    /// type, never its minimum.
    literal(mut &this, wanted: ValueType) -> i64 {
        const maximum: u64 = if (wanted.maximum() > LARGEST_LITERAL) { LARGEST_LITERAL } else { wanted.maximum() };
        const roll: i64 = this.below(10);
        mut magnitude: u64 = this.random.next_64() & maximum;
        if (roll < 3) { magnitude = this.below(17) as u64; }
        if (roll == 3) { magnitude = 1; }
        if (roll == 4) { magnitude = maximum; }
        const negative: boolean = wanted.is_signed() && magnitude != 0 && this.chance(40);
        return this.node(ExpressionKind::IntegerLiteral(magnitude, negative), wanted);
    }

    /// A non-negative literal of `value_type` whose value the caller chose.
    integer(mut &this, value: u64, value_type: ValueType) -> i64 {
        return this.node(ExpressionKind::IntegerLiteral(value, false), value_type);
    }

    /// A read of `variable`.
    read(mut &this, variable: i64) -> i64 {
        return this.node(ExpressionKind::Variable(variable), this.program.variable_at(variable).value_type);
    }

    /// An expression node, charged as one unit of work.
    node(mut &this, kind: ExpressionKind, value_type: ValueType) -> i64 {
        this.charge(1);
        return this.program.expression(kind, value_type);
    }

    /// The variables in scope of type `wanted`.
    variables_of(&this, wanted: ValueType) -> Array<i64> {
        mut found: Array<i64> = Array::<i64>::new();
        for (variable in this.scope.iter()) {
            if (this.program.variable_at(variable).value_type.same(wanted)) { found.push(variable); }
        }
        return Generator::observed_last(found);
    }

    /// The integer variables in scope of a type other than `excluded`.
    integer_variables_except(&this, excluded: ValueType) -> Array<i64> {
        mut found: Array<i64> = Array::<i64>::new();
        for (variable in this.scope.iter()) {
            const value_type: ValueType = this.program.variable_at(variable).value_type;
            if (value_type.is_integer() && !value_type.same(excluded)) { found.push(variable); }
        }
        return Generator::observed_last(found);
    }

    /// The struct variables in scope with a field, directly or nested, of
    /// type `wanted`.
    field_roots(&this, wanted: ValueType) -> Array<i64> {
        mut found: Array<i64> = Array::<i64>::new();
        for (variable in this.scope.iter()) {
            if (this.program.reaches(this.program.variable_at(variable).value_type, wanted)) { found.push(variable); }
        }
        return found;
    }

    /// The variables in scope a receiver of type `owner` can be reached
    /// from: one of that type or holding a field of it, and with
    /// `writable`, only those whose fields may be written.
    receiver_roots(&this, owner: ValueType, writable: boolean) -> Array<i64> {
        mut found: Array<i64> = Array::<i64>::new();
        for (variable in this.scope.iter()) {
            const declared: Variable = this.program.variable_at(variable);
            if (writable && !Generator::is_writable(declared)) { continue; }
            if (declared.value_type.same(owner) || this.program.reaches(declared.value_type, owner)) { found.push(variable); }
        }
        return found;
    }

    /// `found` without `observed`, unless `observed` is all it holds: a
    /// value read from the hash state and folded back into it cancels out
    /// (`x ^ x`), so the state is read only where nothing else is in scope.
    static observed_last(found: Array<i64>) -> Array<i64> {
        if (found.length() <= 1) { return found; }
        mut others: Array<i64> = Array::<i64>::new();
        for (variable in found.iter()) {
            if (variable != Program::observed()) { others.push(variable); }
        }
        return others;
    }

    /// Whether one more call of `candidate` keeps this function's work
    /// under its limit.
    affordable(&this, candidate: Function) -> boolean {
        return this.spent + this.multiplier * (candidate.cost + 1) <= this.limit;
    }

    /// The earlier free functions and static methods returning `wanted`
    /// that one more call of keeps this function's work under its limit.
    callees(&this, wanted: ValueType) -> Array<i64> {
        mut found: Array<i64> = Array::<i64>::new();
        if (!this.options.features.has(Feature::Calls)) { return found; }
        mut index: i64 = 0;
        while (index < this.program.functions.length()) {
            const candidate: Function = this.program.function_at(index);
            const through_type: boolean = match (candidate.receiver) {
                Receiver::Free   => { true }
                Receiver::Static => { true }
                _                => { false }
            };
            if (through_type && candidate.returns.same(wanted) && this.affordable(candidate)) { found.push(index); }
            index = index + 1;
        }
        return found;
    }

    /// The earlier methods taking a receiver and returning `wanted` that
    /// are affordable and have a receiver in scope: methods taking
    /// `mut &this` when `writes` (they return nothing), `&this` otherwise.
    method_calls(&this, wanted: ValueType, writes: boolean) -> Array<i64> {
        mut found: Array<i64> = Array::<i64>::new();
        if (!this.options.features.has(Feature::Calls)) { return found; }
        mut index: i64 = 0;
        while (index < this.program.functions.length()) {
            const candidate: Function = this.program.function_at(index);
            const matches: boolean = match (candidate.receiver) {
                Receiver::Shared    => { !writes }
                Receiver::Exclusive => { writes }
                _                   => { false }
            };
            if (matches && candidate.returns.same(wanted) && this.affordable(candidate)
                && this.receiver_roots(ValueType::Record(candidate.owner), writes).length() > 0) {
                found.push(index);
            }
            index = index + 1;
        }
        return found;
    }

    // ---- choices ---------------------------------------------------------

    /// Charge `units` of work, once per trip of every enclosing loop.
    charge(mut &this, units: u64) -> void { this.spent = this.spent + units * this.multiplier; }

    /// An expression depth for a statement: 1 to 4.
    depth(mut &this) -> i64 { return 1 + this.below(4); }

    /// An integer type.
    integer_type(mut &this) -> ValueType { return ValueType::integers().get(this.below(8)).unwrap(); }

    /// An integer type, or sometimes `boolean` when booleans are enabled.
    scalar_type(mut &this) -> ValueType {
        if (this.options.features.has(Feature::Booleans) && this.chance(15)) { return ValueType::Boolean; }
        return this.integer_type();
    }

    /// A scalar type, or sometimes a struct when the program declares any.
    any_type(mut &this) -> ValueType {
        const declared: i64 = this.program.structures.length();
        if (declared > 0 && this.chance(20)) { return ValueType::Record(this.below(declared)); }
        return this.scalar_type();
    }

    /// A number in `[0, bound)`.
    below(mut &this, bound: i64) -> i64 { return this.random.next_below(bound); }

    /// True `percent` times in a hundred.
    chance(mut &this, percent: i64) -> boolean { return this.below(100) < percent; }

    /// An index into `weights`, chosen in proportion to its weight.
    pick(mut &this, weights: &Array<i64>) -> i64 {
        const total: i64 = weights.iter().sum();
        mut roll: i64 = this.below(total);
        mut index: i64 = 0;
        while (index < weights.length()) {
            const weight: i64 = weights.get(index).unwrap();
            if (roll < weight) { return index; }
            roll = roll - weight;
            index = index + 1;
        }
        return weights.length() - 1;
    }
}
