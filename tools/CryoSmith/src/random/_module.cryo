///! Seeded random streams: every random choice CryoSmith makes is drawn
///! from a `RandomStream`, and every stream is seeded from the program's
///! seed and the place of what it generates, never from a clock.
///!
///! A layer of its own beside the model: it imports only the standard
///! library.
///!
///!   stream   `RandomStream`: its draws, and the seed of each part's stream

namespace cryosmith::random;

module {
    random::stream;
}

export cryosmith::random::stream::{ RandomStream };
