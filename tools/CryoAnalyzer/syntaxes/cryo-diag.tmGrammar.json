{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cryo Diagnostic",
  "scopeName": "source.cryo-diag",
  "fileTypes": ["cryo-diag"],
  "patterns": [
    { "include": "#rule-line" },
    { "include": "#header-error" },
    { "include": "#header-warning" },
    { "include": "#header-note" },
    { "include": "#header-help" },
    { "include": "#header-info" },
    { "include": "#child-header" },
    { "include": "#suggestion-header" },
    { "include": "#summary-line" },
    { "include": "#arrow-primary" },
    { "include": "#arrow-secondary" },
    { "include": "#ellipsis-line" },
    { "include": "#snippet-line" },
    { "include": "#margin-line" },
    { "include": "#backtick-code" }
  ],
  "repository": {
    "rule-line": {
      "match": "^={5,}$",
      "name": "markup.bold comment.line.rule.cryo-diag"
    },
    "header-error": {
      "match": "^(error)(?:(\\[)([A-Z]\\d+)(\\]))?(:)\\s*(.*)$",
      "captures": {
        "1": { "name": "markup.bold markup.error keyword.other.severity.error.cryo-diag" },
        "2": { "name": "punctuation.section.brackets.code.cryo-diag" },
        "3": { "name": "entity.name.tag.error-code.cryo-diag" },
        "4": { "name": "punctuation.section.brackets.code.cryo-diag" },
        "5": { "name": "punctuation.separator.colon.cryo-diag" },
        "6": {
          "name": "markup.bold message.headline.cryo-diag",
          "patterns": [{ "include": "#backtick-code" }]
        }
      }
    },
    "header-warning": {
      "match": "^(warning)(?:(\\[)([A-Z]\\d+)(\\]))?(:)\\s*(.*)$",
      "captures": {
        "1": { "name": "markup.bold markup.warning keyword.other.severity.warning.cryo-diag" },
        "2": { "name": "punctuation.section.brackets.code.cryo-diag" },
        "3": { "name": "entity.name.tag.warning-code.cryo-diag" },
        "4": { "name": "punctuation.section.brackets.code.cryo-diag" },
        "5": { "name": "punctuation.separator.colon.cryo-diag" },
        "6": {
          "name": "markup.bold message.headline.cryo-diag",
          "patterns": [{ "include": "#backtick-code" }]
        }
      }
    },
    "header-note": {
      "match": "^(note)(?:(\\[)([A-Z]\\d+)(\\]))?(:)\\s*(.*)$",
      "captures": {
        "1": { "name": "markup.bold markup.inserted keyword.other.severity.note.cryo-diag" },
        "2": { "name": "punctuation.section.brackets.code.cryo-diag" },
        "3": { "name": "entity.name.tag.note-code.cryo-diag" },
        "4": { "name": "punctuation.section.brackets.code.cryo-diag" },
        "5": { "name": "punctuation.separator.colon.cryo-diag" },
        "6": {
          "name": "message.note.cryo-diag",
          "patterns": [{ "include": "#backtick-code" }]
        }
      }
    },
    "header-help": {
      "match": "^(help)(?:(\\[)([A-Z]\\d+)(\\]))?(:)\\s*(.*)$",
      "captures": {
        "1": { "name": "markup.bold markup.inserted keyword.other.severity.help.cryo-diag" },
        "2": { "name": "punctuation.section.brackets.code.cryo-diag" },
        "3": { "name": "entity.name.tag.help-code.cryo-diag" },
        "4": { "name": "punctuation.section.brackets.code.cryo-diag" },
        "5": { "name": "punctuation.separator.colon.cryo-diag" },
        "6": {
          "name": "message.help.cryo-diag",
          "patterns": [{ "include": "#backtick-code" }]
        }
      }
    },
    "header-info": {
      "match": "^(info)(?:(\\[)([A-Z]\\d+)(\\]))?(:)\\s*(.*)$",
      "captures": {
        "1": { "name": "markup.bold markup.inserted keyword.other.severity.info.cryo-diag" },
        "2": { "name": "punctuation.section.brackets.code.cryo-diag" },
        "3": { "name": "entity.name.tag.info-code.cryo-diag" },
        "4": { "name": "punctuation.section.brackets.code.cryo-diag" },
        "5": { "name": "punctuation.separator.colon.cryo-diag" },
        "6": {
          "name": "message.info.cryo-diag",
          "patterns": [{ "include": "#backtick-code" }]
        }
      }
    },
    "child-header": {
      "match": "^\\s+(note|help|info)(:)\\s*(.*)$",
      "captures": {
        "1": { "name": "markup.bold markup.inserted keyword.other.severity.child.cryo-diag" },
        "2": { "name": "punctuation.separator.colon.cryo-diag" },
        "3": {
          "name": "message.child.cryo-diag",
          "patterns": [{ "include": "#backtick-code" }]
        }
      }
    },
    "suggestion-header": {
      "match": "^\\s*(suggestion)(\\s+\\[[^\\]]+\\])?(:)\\s*(.*)$",
      "captures": {
        "1": { "name": "markup.bold markup.inserted keyword.other.severity.suggestion.cryo-diag" },
        "2": { "name": "comment.line.applicability.cryo-diag" },
        "3": { "name": "punctuation.separator.colon.cryo-diag" },
        "4": {
          "name": "message.suggestion.cryo-diag",
          "patterns": [{ "include": "#backtick-code" }]
        }
      }
    },
    "summary-line": {
      "match": "^(aborting due to \\d+ errors?)(?:; (\\d+ warnings? emitted))?$",
      "captures": {
        "1": { "name": "markup.bold markup.error message.summary.error.cryo-diag" },
        "2": { "name": "markup.bold markup.warning message.summary.warning.cryo-diag" }
      }
    },
    "arrow-primary": {
      "match": "^\\s*(-->)\\s+(\\S+?)(:)(\\d+)(:)(\\d+)\\s*$",
      "captures": {
        "1": { "name": "markup.bold comment punctuation.definition.arrow.primary.cryo-diag" },
        "2": { "name": "markup.underline.link.cryo-diag" },
        "3": { "name": "punctuation.separator.position.cryo-diag" },
        "4": { "name": "constant.numeric.position.line.cryo-diag" },
        "5": { "name": "punctuation.separator.position.cryo-diag" },
        "6": { "name": "constant.numeric.position.column.cryo-diag" }
      }
    },
    "arrow-secondary": {
      "match": "^\\s*(::)\\s+(\\S+?)(:)(\\d+)(:)(\\d+)\\s*$",
      "captures": {
        "1": { "name": "markup.bold comment punctuation.definition.arrow.secondary.cryo-diag" },
        "2": { "name": "markup.underline.link.cryo-diag" },
        "3": { "name": "punctuation.separator.position.cryo-diag" },
        "4": { "name": "constant.numeric.position.line.cryo-diag" },
        "5": { "name": "punctuation.separator.position.cryo-diag" },
        "6": { "name": "constant.numeric.position.column.cryo-diag" }
      }
    },
    "ellipsis-line": {
      "match": "^\\s*\\.\\.\\.\\s*$",
      "name": "comment punctuation.definition.ellipsis.cryo-diag"
    },
    "snippet-line": {
      "begin": "^(\\s*\\d+)(\\s)(\\|)(\\s?)",
      "beginCaptures": {
        "1": { "name": "constant.numeric.line-number.cryo-diag" },
        "3": { "name": "comment punctuation.definition.divider.cryo-diag" }
      },
      "end": "$",
      "contentName": "meta.embedded.block.cryo source.cryo",
      "patterns": [
        { "include": "source.cryo" }
      ]
    },
    "margin-line": {
      "begin": "^(\\s*)(\\|)",
      "beginCaptures": {
        "2": { "name": "comment punctuation.definition.divider.cryo-diag" }
      },
      "end": "$",
      "patterns": [
        { "include": "#caret-primary" },
        { "include": "#caret-replace" },
        { "include": "#caret-insert" },
        { "include": "#caret-secondary" },
        { "include": "#connector-pipe" },
        { "include": "#label-text" },
        { "include": "#backtick-code" }
      ]
    },
    "caret-primary": {
      "match": "(?<=^|\\s)\\^+(?=\\s|$)",
      "name": "markup.bold markup.error caret.primary.cryo-diag"
    },
    "caret-secondary": {
      "match": "(?<=^|\\s)-+(?=\\s|$)",
      "name": "markup.bold markup.deleted caret.secondary.cryo-diag"
    },
    "caret-replace": {
      "match": "(?<=^|\\s)~+(?=\\s|$)",
      "name": "markup.bold markup.changed caret.replace.cryo-diag"
    },
    "caret-insert": {
      "match": "(?<=^|\\s)\\++(?=\\s|$)",
      "name": "markup.bold markup.inserted caret.insert.cryo-diag"
    },
    "connector-pipe": {
      "match": "(?<=^|\\s)\\|(?=\\s|$)",
      "name": "markup.bold markup.deleted connector.pipe.cryo-diag"
    },
    "label-text": {
      "match": "(?<=[\\^~+\\-]\\s)(.+)$",
      "captures": {
        "1": {
          "name": "markup.italic comment.line.label.cryo-diag",
          "patterns": [{ "include": "#backtick-code" }]
        }
      }
    },
    "backtick-code": {
      "match": "`[^`]+`",
      "name": "markup.inline.raw markup.bold string.quoted.other.backtick.cryo-diag"
    }
  }
}
