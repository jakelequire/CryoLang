{
  "name": "cryo-analyzer",
  "displayName": "Cryo Analyzer",
  "description": "Language support for the Cryo programming language",
  "version": "1.0.0",
  "publisher": "cryolang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "assets/cryo-logo-1.png",
  "activationEvents": [
    "onLanguage:cryo"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cryo",
        "aliases": [
          "Cryo",
          "cryo",
          "Cryo Analyzer"
        ],
        "extensions": [
          ".cryo"
        ],
        "configuration": "./language/language-configuration.json"
      },
      {
        "id": "cryo-diag",
        "aliases": [
          "Cryo Diagnostic"
        ],
        "extensions": [
          ".cryo-diag"
        ]
      }
    ],
    "grammars": [
      {
        "language": "cryo",
        "scopeName": "source.cryo",
        "path": "./syntaxes/cryo.tmGrammar.json"
      },
      {
        "language": "cryo-diag",
        "scopeName": "source.cryo-diag",
        "path": "./syntaxes/cryo-diag.tmGrammar.json"
      }
    ],
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true
    },
    "semanticTokenScopes": [
      {
        "language": "cryo",
        "scopes": {
          "namespace": ["entity.name.namespace.cryo", "entity.name.namespace"],
          "parameter": ["variable.parameter.cryo", "variable.parameter"],
          "variable": ["variable.other.cryo", "variable"],
          "property": ["variable.other.property.cryo", "variable.other.property"],
          "enumMember": ["variable.other.enummember.cryo", "constant.other.enum"],
          "function": ["entity.name.function.cryo", "entity.name.function"],
          "method": ["entity.name.function.member.cryo", "entity.name.function"],
          "type": ["entity.name.type.cryo", "entity.name.type"],
          "struct": ["entity.name.type.struct.cryo", "entity.name.type"],
          "class": ["entity.name.type.class.cryo", "entity.name.type"],
          "enum": ["entity.name.type.enum.cryo", "entity.name.type"],
          "interface": ["entity.name.type.interface.cryo", "entity.name.type"],
          "typeParameter": ["entity.name.type.parameter.cryo", "entity.name.type"]
        }
      }
    ],
    "markdown.markdownItPlugins": true,
    "configuration": {
      "title": "Cryo Analyzer",
      "properties": {
        "cryo.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the CryoLSP language server"
        },
        "cryo.languageServer.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to the cryolsp binary. Leave empty for auto-detection. The resolver probes (in order): $CRYO_HOME/bin, $CRYO_HOME/tools/CryoLSP/build and .../build/bin; <workspace>/tools/CryoLSP/build (the `cryo build` output) and .../build/bin and <workspace>/bin; cryolsp on $PATH; the directory containing `cryo` on $PATH (and its in-repo sibling); extension-relative fallbacks."
        },
        "cryo.languageServer.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging for the language server"
        },
        "cryo.languageServer.logFile": {
          "type": "string",
          "default": "",
          "description": "Path to a log file for LSP server output"
        }
      }
    },
    "commands": [
      {
        "command": "cryo.restartLanguageServer",
        "title": "Cryo: Restart Language Server"
      },
      {
        "command": "cryo.shutdownLanguageServer",
        "title": "Cryo: Shutdown Language Server"
      },
      {
        "command": "cryo.showOutputChannel",
        "title": "Cryo: Show Output"
      },
      {
        "command": "cryo.openRenderedDiagnostic",
        "title": "Cryo: Open Rendered Diagnostic"
      },
      {
        "command": "cryo.showImplementations",
        "title": "Cryo: Show Implementations"
      },
      {
        "command": "cryo.toggleHoverMethods",
        "title": "Cryo: Toggle Method Signatures in Hover"
      }
    ],
    "keybindings": [
      {
        "command": "cryo.toggleHoverMethods",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorLangId == cryo"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cryo.openRenderedDiagnostic",
          "when": "false"
        },
        {
          "command": "cryo.showImplementations",
          "when": "false"
        }
      ]
    },
    "colors": [
      {
        "id": "cryo.diag.error",
        "description": "Cryo diagnostic: error severity tag, primary caret and label.",
        "defaults": {
          "dark": "#f48771",
          "light": "#a31515",
          "highContrast": "#ff5050"
        }
      },
      {
        "id": "cryo.diag.warning",
        "description": "Cryo diagnostic: warning severity tag and caret.",
        "defaults": {
          "dark": "#dcdcaa",
          "light": "#b89500",
          "highContrast": "#ffff00"
        }
      },
      {
        "id": "cryo.diag.note",
        "description": "Cryo diagnostic: note severity, secondary carets and labels.",
        "defaults": {
          "dark": "#75beff",
          "light": "#0451a5",
          "highContrast": "#75beff"
        }
      },
      {
        "id": "cryo.diag.help",
        "description": "Cryo diagnostic: help severity tag and caret.",
        "defaults": {
          "dark": "#89d185",
          "light": "#007a3a",
          "highContrast": "#7cff7c"
        }
      },
      {
        "id": "cryo.diag.info",
        "description": "Cryo diagnostic: info severity tag.",
        "defaults": {
          "dark": "#9cdcfe",
          "light": "#0070c1",
          "highContrast": "#9cdcfe"
        }
      },
      {
        "id": "cryo.diag.suggestion",
        "description": "Cryo diagnostic: suggestion glyphs (~ + ) and replacement labels.",
        "defaults": {
          "dark": "#b5cea8",
          "light": "#009b6b",
          "highContrast": "#7cff7c"
        }
      },
      {
        "id": "cryo.diag.errorCode",
        "description": "Cryo diagnostic: error/warning code inside [Exxxx] brackets.",
        "defaults": {
          "dark": "#4ec9b0",
          "light": "#267f99",
          "highContrast": "#4ec9b0"
        }
      },
      {
        "id": "cryo.diag.errorCodeBracket",
        "description": "Cryo diagnostic: the [ ] brackets around the error code.",
        "defaults": {
          "dark": "#808080",
          "light": "#a0a0a0",
          "highContrast": "#a0a0a0"
        }
      },
      {
        "id": "cryo.diag.separator",
        "description": "Cryo diagnostic: the `:` separating severity from the headline.",
        "defaults": {
          "dark": "#d4d4d4",
          "light": "#000000",
          "highContrast": "#ffffff"
        }
      },
      {
        "id": "cryo.diag.headline",
        "description": "Cryo diagnostic: the bold headline message after the severity.",
        "defaults": {
          "dark": "#ffffff",
          "light": "#000000",
          "highContrast": "#ffffff"
        }
      },
      {
        "id": "cryo.diag.arrow",
        "description": "Cryo diagnostic: the '-->' / '::' location arrows.",
        "defaults": {
          "dark": "#569cd6",
          "light": "#001080",
          "highContrast": "#569cd6"
        }
      },
      {
        "id": "cryo.diag.fileLink",
        "description": "Cryo diagnostic: the file path inside arrow lines.",
        "defaults": {
          "dark": "#4ec9b0",
          "light": "#267f99",
          "highContrast": "#4ec9b0"
        }
      },
      {
        "id": "cryo.diag.position",
        "description": "Cryo diagnostic: line:column numbers in arrow lines.",
        "defaults": {
          "dark": "#b5cea8",
          "light": "#098658",
          "highContrast": "#b5cea8"
        }
      },
      {
        "id": "cryo.diag.lineNumber",
        "description": "Cryo diagnostic: snippet line numbers (context lines).",
        "defaults": {
          "dark": "#858585",
          "light": "#8a8a8a",
          "highContrast": "#a0a0a0"
        }
      },
      {
        "id": "cryo.diag.lineNumberActive",
        "description": "Cryo diagnostic: snippet line number on the error line.",
        "defaults": {
          "dark": "#569cd6",
          "light": "#001080",
          "highContrast": "#569cd6"
        }
      },
      {
        "id": "cryo.diag.gutter",
        "description": "Cryo diagnostic: the `|` gutter between line number and source.",
        "defaults": {
          "dark": "#569cd6",
          "light": "#0451a5",
          "highContrast": "#569cd6"
        }
      },
      {
        "id": "cryo.diag.gutterActive",
        "description": "Cryo diagnostic: gutter pipe on the error line.",
        "defaults": {
          "dark": "#569cd6",
          "light": "#001080",
          "highContrast": "#569cd6"
        }
      },
      {
        "id": "cryo.diag.inlineCode",
        "description": "Cryo diagnostic: text wrapped in `backticks` inside messages.",
        "defaults": {
          "dark": "#ce9178",
          "light": "#a31515",
          "highContrast": "#ce9178"
        }
      },
      {
        "id": "cryo.diag.rule",
        "description": "Cryo diagnostic: the '====' rule line between diagnostics.",
        "defaults": {
          "dark": "#404040",
          "light": "#c0c0c0",
          "highContrast": "#a0a0a0"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.mjs",
    "check-types": "tsc --noEmit",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run check-types && node esbuild.mjs --production",
    "lint": "eslint src --ext ts",
    "install-package": "vsce package && npm install -g *.vsix"
  },
  "dependencies": {
    "shiki": "^1.24.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.3",
    "typescript": "^5.3.0"
  }
}
