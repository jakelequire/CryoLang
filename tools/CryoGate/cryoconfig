# cryogate - the repository's gate and test runner.
#
# Built by the pinned compiler (bin/cryo) against the tree's stdlib, and
# linked against the stdlib only: every compiler it judges is driven as a
# child process, so a compiler that does not build, crashes or miscompiles
# cannot break the program that reports it.

[project]
project_name = "cryogate"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]
debug    = false
optimize = O2
