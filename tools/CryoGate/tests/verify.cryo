function a_declared_runtime_member_is_judged_before_the_runtime_is_compared() -> Result<(), TestError> {
    mut changes: DeclaredChanges = Comparing::nothing_declared();
    changes.moved_members.push(String::from_str(Str::new("moved-runtime:hosted-unwind/Sys.o")));
    const compared: Compared = Comparing::of(&changes,
        Comparing::populations(Str::new(""), Str::new(""), Str::new(""), Str::new("runtime/hosted-unwind/00-Sys.o=1;runtime/hosted-unwind/01-Entry.o=1")),
        Comparing::populations(Str::new(""), Str::new(""), Str::new(""), Str::new("runtime/hosted-unwind/00-Sys.o=2;runtime/hosted-unwind/01-Entry.o=1")), 40);
    const shown: String = Text::joined(&compared.lines, Str::new("\n"));
    expect(shown.as_str().ends_with(&Str::new(
        "  runtime   declared moved runtime members left out: 1, 0 problem(s)\n"
        "  runtime   baseline     1  tree     1  moved 0  only-baseline 0  only-tree 0  replaced by the archive 0")), Str::new("the runtime's lines"))?;
    return expect_equal(compared.changed, 0);
}

/// Archive bytes built from text: a string literal ends at its first NUL,
/// so the NULs an archive holds are pushed as bytes.
type struct Archived {
    /// A member's 60-byte header.
    private static header(name: Str, size: i64) -> String {
        return f"{name:<16}                                {size:<10}`\n";
    }

    private static push(data: mut &Array<u8>, text: Str) -> void {
        for (byte in text.as_bytes().iter()) { data.push(byte); }
    }

    private static push_nuls(data: mut &Array<u8>, count: i64) -> void {
        for (mut i: i64 = 0; i < count; i++) { data.push(0); }
    }
}

![test]
function an_archives_members_are_named_by_the_long_name_table_and_the_bsd_form_alike() -> Result<(), TestError> {
    mut data: Array<u8> = Array::<u8>::new();
    Archived::push(&data, Str::new("!<arch>\n"));
    Archived::push(&data, Archived::header(Str::new("/"), 4).as_str());
    Archived::push_nuls(&data, 4);
    Archived::push(&data, Archived::header(Str::new("//"), 20).as_str());
    Archived::push(&data, Str::new("long_member_name.o/\n"));
    Archived::push(&data, Archived::header(Str::new("/0"), 3).as_str());
    Archived::push(&data, Str::new("abc\n"));
    Archived::push(&data, Archived::header(Str::new("Sys.o/"), 2).as_str());
    Archived::push(&data, Str::new("xy"));
    Archived::push(&data, Archived::header(Str::new("#1/8"), 10).as_str());
    Archived::push(&data, Str::new("Bsd.o"));
    Archived::push_nuls(&data, 3);
    Archived::push(&data, Str::new("zz"));
    expect_equal(Archived::header(Str::new("/"), 4).length(), 60)?;
    const members: Array<Pair<String, String>> = RuntimeArchives::members(data.as_slice()).unwrap();
    expect_equal(members.length(), 3)?;
    expect_equal(members[0].first.as_str(), Str::new("long_member_name.o"))?;
    expect_equal(members[0].second.as_str(), Str::new("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))?;
    expect_equal(members[1].first.as_str(), Str::new("Sys.o"))?;
    expect_equal(members[1].second.as_str(), Sha256::digest(Str::new("xy").as_bytes()).to_hex().as_str())?;
    expect_equal(members[2].first.as_str(), Str::new("Bsd.o"))?;
    expect_equal(members[2].second.as_str(), Sha256::digest(Str::new("zz").as_bytes()).to_hex().as_str())?;
    // An archive cut short reads up to its end.
    expect_equal(RuntimeArchives::members(data.as_slice().subslice(0, data.length() - 1)).unwrap().length(), 3)?;
    return expect(RuntimeArchives::members(Str::new("not an archive").as_bytes()).is_none(), Str::new("not an archive"));
}

