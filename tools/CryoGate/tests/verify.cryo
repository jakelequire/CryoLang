}

![test]
function runtimes_laid_out_differently_are_not_compared_and_their_declarations_not_judged() -> Result<(), TestError> {
    mut changes: DeclaredChanges = Comparing::nothing_declared();
    changes.moved_members.push(String::from_str(Str::new("moved-runtime:hosted-unwind/Sys.o")));
    const compared: Compared = Comparing::of(&changes,
        Comparing::populations(Str::new(""), Str::new(""), Str::new(""), Str::new("runtime/libcryort-core.a/00-Sys.o=1")),
        Comparing::populations(Str::new(""), Str::new(""), Str::new(""), Str::new("runtime/hosted-unwind/00-Sys.o=2;runtime/hosted-unwind/01-Entry.o=1")), 40);
    expect_equal(compared.lines[compared.lines.length() - 1].as_str(), Str::new(
        "  runtime   baseline     1  tree     2  NOT COMPARED: the baseline's runtime is laid out as tiers, the tree's as configurations"))?;
    expect_equal(compared.problems.length(), 0)?;
    return expect_equal(compared.changed, 0);
}

