![test]
function a_project_warning_only_the_tree_lists_is_new() -> Result<(), TestError> {
    mut tree: Array<Pair<String, String>> = Array::<Pair<String, String>>::new();
    tree.push(Pair::new(String::from_str(Str::new("p")), String::from_str(Str::new("W0001 src/main.cryo:7"))));
    const none: Array<String> = Array::<String>::new();

    mut same: Array<BaselineRecord> = Array::<BaselineRecord>::new();
    same.push(Judged::project(Str::new("p"), true, Str::new("W0001 src/main.cryo:7")));
    expect_equal(VerifyJudges::new_project_warnings(&same, &tree, &none).length(), 0)?;

    mut added: Array<BaselineRecord> = Array::<BaselineRecord>::new();
    added.push(Judged::project(Str::new("p"), true, Str::new("")));
    added.push(Judged::project(Str::new("q"), true, Str::new("")));
    const found: Array<String> = VerifyJudges::new_project_warnings(&added, &tree, &none);
    expect_equal(found.length(), 1)?;
    expect_equal(found[0].as_str(), Str::new("the tree's build of p reports a warning the baseline's does not: W0001 src/main.cryo:7"))?;

    mut not_listed: Array<BaselineRecord> = Array::<BaselineRecord>::new();
    not_listed.push(Judged::project(Str::new("p"), false, Str::new("")));
    not_listed.push(Judged::project(Str::new("q"), true, Str::new("")));
    expect_equal(VerifyJudges::new_project_warnings(&not_listed, &tree, &none).length(), 0)?;

    return expect_equal(VerifyJudges::new_project_warnings(&added, &tree, &Judged::list(Str::new("p"))).length(), 0);
}

![test]
function a_census_run_records_the_unit_suites_build_warnings() -> Result<(), TestError> {
    const lines: Array<String> = Text::lines(Str::new(
        "warning[W0001]: unused variable `p`; prefix it with `_` to silence this warning\r\n"
        " --> ./tests/lang/a.cryo:113:5\r\n"
        "ok    A::one\r\n"
        "  unit test summary\r\n"
        "    passed 1\r\n"));
    const records: Array<BaselineRecord> = BaselineRecord::of_census(&lines, &Judged::list(Str::new("unit suite")),
        &Array::<String>::new(), &Judged::list(Str::new("A::one")));
    expect_equal(records.length(), 1)?;
    expect_equal(records[0].warnings.length(), 1)?;
    expect_equal(records[0].warnings[0].as_str(), Str::new("W0001 ./tests/lang/a.cryo:113"))?;
    return expect(!records[0].warnings_listed, Str::new("the unit suite's warnings are not a project's listing"));
}

![test]
function a_census_run_records_each_projects_listed_build_warnings() -> Result<(), TestError> {
    const lines: Array<String> = Text::lines(Str::new(
        "test (negative) E1_x.cryo ... ok\r\n"
        "test (project) quiet ... ok\r\n"
        "test (project) noisy ... ok\r\n"
        "    warning W0002 src/other.cryo:12\r\n"
        "    warning W0001 src/main.cryo:3\r\n"
        "  projects summary\r\n"
        "    passed        2\r\n"
        "    failed        0\r\n"
        "    warnings      2\r\n"
        "    result   PASS\r\n"));
    const records: Array<BaselineRecord> = BaselineRecord::of_census(&lines,
        &Judged::list(Str::new("noisy,quiet,negative/E1_x.cryo")), &Array::<String>::new(), &Array::<String>::new());
    expect_equal(records.length(), 3)?;
    expect(records[0].warnings_listed && records[0].warnings.length() == 2, Str::new("noisy lists two"))?;
    expect_equal(records[0].warnings[0].as_str(), Str::new("W0001 src/main.cryo:3"))?;
    expect(records[1].warnings_listed && records[1].warnings.is_empty(), Str::new("quiet lists none, and says so"))?;
    expect(!records[2].warnings_listed, Str::new("a compile-fail file lists no build warnings"))?;
    const older: Array<String> = Text::lines(Str::new(
        "test (project) noisy ... ok\r\n"
        "  projects summary\r\n"
        "    passed        1\r\n"
        "    failed        0\r\n"
        "    result   PASS\r\n"));
    const unlisted: Array<BaselineRecord> = BaselineRecord::of_census(&older, &Judged::list(Str::new("noisy")),
        &Array::<String>::new(), &Array::<String>::new());
    return expect(!unlisted[0].warnings_listed, Str::new("a runner that prints no warnings row lists none"));
}

type struct Fixture {
    /// The declarations as `name=reason` entries joined by `;`, in order.
    private static shown(declarations: &Array<Declaration>) -> String {
        mut out: String = String::new();
        for (mut i: i64 = 0; i < declarations.length(); i++) {
            if (i > 0) { out.push(';'); }
            out.push(declarations[i].name.as_str());
            out.push('=');
            out.push(declarations[i].reason.as_str());
        }
        return out;
    }

    private static between(tree: Str, base: Str) -> String {
        const applied: Array<Declaration> = Declarations::between(tree, base);
        return Fixture::shown(&applied);
    }

    private static owner(path: Str) -> String {
        return match (ObjectOwner::of(path)) {
            Option::Some(name) => { name }
            Option::None       => { String::from_str(Str::new("<none>")) }
        };
    }
}

![test]
function parse_skips_comments_and_blank_lines() -> Result<(), TestError> {
    const parsed: Array<Declaration> = Declarations::parse(Str::new("# c\n\np why\nq\n"));
    const shown: String = Fixture::shown(&parsed);
    return expect_equal(shown.as_str(), Str::new("p=why;q="));
}

![test]
function a_name_written_twice_keeps_its_place_and_takes_the_later_reason() -> Result<(), TestError> {
    const parsed: Array<Declaration> = Declarations::parse(Str::new("p a\nq b\np c\n"));
    const shown: String = Fixture::shown(&parsed);
    return expect_equal(shown.as_str(), Str::new("p=c;q=b"));
}

![test]
function a_new_line_applies() -> Result<(), TestError> {
    const applied: String = Fixture::between(Str::new("p a\nq b\n"), Str::new("p a\n"));
    return expect_equal(applied.as_str(), Str::new("q=b"));
}

![test]
function an_unchanged_line_does_not_apply() -> Result<(), TestError> {
    const applied: String = Fixture::between(Str::new("p a\n"), Str::new("p a\n"));
    return expect_equal(applied.as_str(), Str::new(""));
}

![test]
function a_rewritten_reason_applies_again() -> Result<(), TestError> {
    const applied: String = Fixture::between(Str::new("p b\n"), Str::new("p a\n"));
    return expect_equal(applied.as_str(), Str::new("p=b"));
}

![test]
function a_removed_line_declares_nothing() -> Result<(), TestError> {
    const applied: String = Fixture::between(Str::new(""), Str::new("p a\n"));
    return expect_equal(applied.as_str(), Str::new(""));
}

![test]
function a_line_rewritten_into_the_archive_form_with_its_reason_kept_declares_nothing() -> Result<(), TestError> {
    const applied: String = Fixture::between(Str::new("archive:p a\n"), Str::new("p a\n"));
    return expect_equal(applied.as_str(), Str::new(""));
}

![test]
function a_new_line_in_the_archive_form_applies() -> Result<(), TestError> {
    const applied: String = Fixture::between(Str::new("archive:p a\n"), Str::new(""));
    return expect_equal(applied.as_str(), Str::new("archive:p=a"));
}

![test]
function a_line_rewritten_into_the_moved_form_with_its_reason_kept_declares_nothing() -> Result<(), TestError> {
    const applied: String = Fixture::between(Str::new("moved:p a\n"), Str::new("p a\n"));
    return expect_equal(applied.as_str(), Str::new(""));
}

![test]
function the_moved_archive_form_is_its_own_kind_naming_the_module() -> Result<(), TestError> {
    const name: Str = Str::new("moved-archive:std::a::b");
    const kind: DeclarationKind = Declarations::kind(name);
    expect(match (kind) { DeclarationKind::MovedArchive => { true } _ => { false } }, Str::new("kind moved-archive"))?;
    expect_equal(Declarations::program_of(name), Str::new("std::a::b"))?;
    const suffix: String = Declarations::archive_module_suffix(name);
    return expect_equal(suffix.as_str(), Str::new("/deps/std/a/b.o"));
}

![test]
function each_form_names_its_kind() -> Result<(), TestError> {
    expect(match (Declarations::kind(Str::new("archive:lang/u.cryo"))) { DeclarationKind::Archive => { true } _ => { false } }, Str::new("archive"))?;
    expect(match (Declarations::kind(Str::new("moved:p"))) { DeclarationKind::Moved => { true } _ => { false } }, Str::new("moved"))?;
    expect(match (Declarations::kind(Str::new("negative/E1_x.cryo"))) { DeclarationKind::Negative => { true } _ => { false } }, Str::new("negative before unit"))?;
    expect(match (Declarations::kind(Str::new("examples/01-hello"))) { DeclarationKind::Example => { true } _ => { false } }, Str::new("example"))?;
    expect(match (Declarations::kind(Str::new("lang/u.cryo"))) { DeclarationKind::Unit => { true } _ => { false } }, Str::new("unit"))?;
    return expect(match (Declarations::kind(Str::new("p"))) { DeclarationKind::Project => { true } _ => { false } }, Str::new("project"));
}

![test]
function an_object_outside_every_program_build_belongs_to_none() -> Result<(), TestError> {
    const outside: String = Fixture::owner(Str::new("tests/tests/lang/build/x.o"));
    expect_equal(outside.as_str(), Str::new("<none>"))?;
    const unit: String = Fixture::owner(Str::new("tests/build/deps/A.o"));
    expect_equal(unit.as_str(), Str::new("unit suite"))?;
    const project: String = Fixture::owner(Str::new("tests/tests/projects/p/build/a.o"));
    expect_equal(project.as_str(), Str::new("p"))?;
    const example: String = Fixture::owner(Str::new("examples/01-hello/build/m.o"));
    return expect_equal(example.as_str(), Str::new("examples/01-hello"));
}

![test]
function a_stdlib_object_the_tree_takes_from_the_archive_is_replaced() -> Result<(), TestError> {
    return expect(ObjectOwner::replaced_by_archive(Str::new("p/build/x/std/deps/std/io.o"), true),
        Str::new("a stdlib module's object, archive linked"));
}

![test]
function a_program_object_missing_from_the_tree_is_not_replaced() -> Result<(), TestError> {
    return expect(!ObjectOwner::replaced_by_archive(Str::new("p/build/x/local/deps/main.o"), true),
        Str::new("a program's own object"));
}

![test]
function a_stdlib_object_missing_when_no_archive_was_linked_is_not_replaced() -> Result<(), TestError> {
    return expect(!ObjectOwner::replaced_by_archive(Str::new("p/build/x/std/deps/std/io.o"), false),
        Str::new("no archive linked"));
}
