![test]
function a_declared_runtime_member_must_move_in_its_own_configuration() -> Result<(), TestError> {
    const sys: Str = Str::new("moved-runtime:hosted-unwind/Sys.o");
    // Moved, at the same place and at a new one.
    expect_equal(Judged::runtime_moves(sys, Str::new("runtime/hosted-unwind/00-Sys.o=1"), Str::new("runtime/hosted-unwind/00-Sys.o=2")), 0)?;
    expect_equal(Judged::runtime_moves(sys, Str::new("runtime/hosted-unwind/00-Sys.o=1"), Str::new("runtime/hosted-unwind/01-Sys.o=2")), 0)?;
    // Not moved; in no archive; moved only in another configuration.
    expect_equal(Judged::runtime_moves(sys, Str::new("runtime/hosted-unwind/00-Sys.o=1"), Str::new("runtime/hosted-unwind/00-Sys.o=1")), 1)?;
    expect_equal(Judged::runtime_moves(sys, Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::runtime_moves(sys, Str::new("runtime/hosted-abort/00-Sys.o=1"), Str::new("runtime/hosted-abort/00-Sys.o=2")), 1)?;
    // Another member's move stays in both maps, to be compared.
    mut left: HashMap<String, String> = Judged::map(Str::new("runtime/hosted-unwind/00-Sys.o=1;runtime/hosted-unwind/01-Entry.o=1"));
    mut right: HashMap<String, String> = Judged::map(Str::new("runtime/hosted-unwind/00-Sys.o=2;runtime/hosted-unwind/01-Entry.o=2"));
    expect_equal(VerifyJudges::runtime_moves(&Judged::list(sys), &left, &right).length(), 0)?;
    return expect(left.length() == 1 && right.length() == 1
        && right.contains_key(&String::from_str(Str::new("runtime/hosted-unwind/01-Entry.o"))), Str::new("only the declared member is removed"));
}

