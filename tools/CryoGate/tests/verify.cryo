/// The judges' inputs written as text: a list as names joined by `,`, a
/// map as `key=value` entries joined by `;`.  Each answers how many
/// problems its judge finds.
type struct Judged {
    private static list(text: Str) -> Array<String> {
        mut out: Array<String> = Array::<String>::new();
        for (part in text.split_nonempty(&Str::new(","))) { out.push(String::from_str(part)); }
        return out;
    }

    private static map(text: Str) -> HashMap<String, String> {
        mut out: HashMap<String, String> = HashMap::<String, String>::new();
        for (entry in text.split_nonempty(&Str::new(";"))) {
            match (entry.split_once(&Str::new("="))) {
                Option::Some(parts) => { out.insert(String::from_str(parts.first), String::from_str(parts.second)); }
                Option::None        => { }
            }
        }
        return out;
    }

    private static census(declared: Str, accounted: boolean, unit_failed: i64, negatives_failed: i64, failed: Str,
                  fixed: Str, namespaces: Str) -> i64 {
        const census: BaselineCensus = BaselineCensus {
            accounted: accounted, unit_failed: unit_failed, negatives_failed: negatives_failed,
            failed: Judged::list(failed),
        };
        const held: HashMap<String, String> = Judged::map(namespaces);
        return VerifyJudges::baseline_census(&census, &Judged::list(declared), &Judged::list(fixed), &held).length();
    }

    private static unit_moves(file: Str, suffix: Str, a: Str, b: Str) -> i64 {
        mut suffixes: Array<Pair<String, String>> = Array::<Pair<String, String>>::new();
        suffixes.push(Pair::new(String::from_str(file), String::from_str(suffix)));
        mut left: HashMap<String, String> = Judged::map(a);
        mut right: HashMap<String, String> = Judged::map(b);
        return VerifyJudges::unit_moves(&suffixes, &left, &right).length();
    }

    private static project_moves(names: Str, a: Str, b: Str) -> i64 {
        mut left: HashMap<String, String> = Judged::map(a);
        mut right: HashMap<String, String> = Judged::map(b);
        return VerifyJudges::project_moves(&Judged::list(names), &left, &right).length();
    }

    private static archive_module_moves(names: Str, a: Str, b: Str) -> i64 {
        mut left: HashMap<String, String> = Judged::map(a);
        mut right: HashMap<String, String> = Judged::map(b);
        return VerifyJudges::archive_module_moves(&Judged::list(names), &Array::<String>::new(), &left, &right).length();
    }

    private static runtime_moves(names: Str, a: Str, b: Str) -> i64 {
        mut left: HashMap<String, String> = Judged::map(a);
        mut right: HashMap<String, String> = Judged::map(b);
        return VerifyJudges::runtime_moves(&Judged::list(names), &left, &right).length();
    }

    /// A passing project's record, its warnings (joined by `,`) listed or
    /// not.
    private static project(name: Str, listed: boolean, warnings: Str) -> BaselineRecord {
        mut record: BaselineRecord = BaselineRecord::new(name, Str::new("ok"));
        record.warnings_listed = listed;
        record.warnings = Judged::list(warnings);
        return record;
    }

    private static new_warnings(base: Str, tree: Str) -> i64 {
        return VerifyJudges::new_warnings(&Judged::list(base), &Judged::list(tree)).length();
    }

    private static builds(base_exit: i32, base_output: Str, tree_exit: i32, tree_output: Str, fixed: boolean) -> i64 {
        return VerifyJudges::builds(Str::new("p"), base_exit, base_output, tree_exit, tree_output, fixed).length();
    }

    /// The records a census run's `lines` (joined by `|`) give `names`,
    /// each as `name=verdict:rows` joined by `;`, in the order of `names`.
    private static records(lines: Str, names: Str, rows: Str) -> String {
        mut output: Array<String> = Array::<String>::new();
        for (line in lines.split_nonempty(&Str::new("|"))) { output.push(String::from_str(line)); }
        const records: Array<BaselineRecord> = BaselineRecord::of_census(&output, &Judged::list(names),
            &Judged::list(rows), &Array::<String>::new());
        mut shown: Array<String> = Array::<String>::new();
        for (record in records.iterate_references()) {
            shown.push(f"{record.name.as_str()}={record.verdict.as_str()}:{record.rows.length()}");
        }
        return Text::joined(&shown, Str::new(";"));
    }
}

/// The checkout the test binary was built in, for the cases that read the
/// real tree.
type struct Checkout {
    private static root() -> Result<PathBuf, TestError> {
        return match (Host::repository()) {
            Result::Ok(root)    => { Result::Ok(root) }
            Result::Err(reason) => { Result::Err(TestError::other(reason.as_str())) }
        };
    }
}

![test]
function a_started_compiling_project_is_refused_by_the_baseline_and_built_by_the_tree() -> Result<(), TestError> {
    expect_equal(Judged::builds(1, Str::new("error[E0203]: x"), 0, Str::new(""), false), 0)?;
    expect_equal(Judged::builds(0, Str::new(""), 0, Str::new(""), false), 1)?;
    expect_equal(Judged::builds(3, Str::new("segfault"), 0, Str::new(""), false), 1)?;
    return expect_equal(Judged::builds(1, Str::new("error[E0203]: x"), 1, Str::new("error[E0203]: x"), false), 1);
}

![test]
function a_stdlib_archive_is_labelled_by_its_manifests_options() -> Result<(), TestError> {
    expect_equal(ObjectHashes::options_label(Str::new("key 1\noptions -O2 --panic=unwind\n")).as_str(), Str::new("-O2_--panic_unwind"))?;
    expect_equal(ObjectHashes::options_label(Str::new("options a,  b\n")).as_str(), Str::new("a_b"))?;
    return expect_equal(ObjectHashes::options_label(Str::new("key 1\n")).as_str(), Str::new("_"));
}

![test]
function a_gate_passes_on_its_exit_code_and_its_own_verdict_line() -> Result<(), TestError> {
    const gates: Array<GateCommand> = GateCommand::table(Str::new("cryogate"));
    const census: &GateCommand = &gates[0];
    expect_equal(GateVerdict::of(census, Str::new("x\ntest-census: OK -- all\n"), 0).ok, true)?;
    expect_equal(GateVerdict::of(census, Str::new("x\ntest-census: OK -- all\n"), 1).ok, false)?;
    expect_equal(GateVerdict::of(census, Str::new("everything fine\n"), 0).ok, false)?;
    expect_equal(GateVerdict::of(census, Str::new("test-census: OK\ntest-census: FAIL -- two\n"), 0).ok, false)?;
    expect_equal(GateVerdict::of(census, Str::new("  test-census: OK -- indented\n"), 0).ok, false)?;
    const fast: &GateCommand = &gates[7];
    expect_equal(fast.name.as_str(), Str::new("fast"))?;
    const quoted: GateVerdict = GateVerdict::of(fast, Str::new("\"check-fast: OK (all)\"\n"), 0);
    expect_equal(quoted.line.as_str(), Str::new("check-fast: OK (all)"))?;
    return expect_equal(quoted.ok, true);
}

![test]
function a_gate_reports_its_time_in_tenths_and_its_log_when_it_printed_no_verdict() -> Result<(), TestError> {
    const gates: Array<GateCommand> = GateCommand::table(Str::new("cryogate"));
    const passed: GateVerdict = GateVerdict::of(&gates[0], Str::new("test-census: OK -- all\n"), 0);
    expect_equal(passed.report(Str::new("census"), 1171.049, Str::new("c.log")).as_str(), Str::new("  census    ok   1171.0 s  test-census: OK -- all"))?;
    const silent: GateVerdict = GateVerdict::of(&gates[0], Str::new(""), 0);
    return expect_equal(silent.report(Str::new("census"), 0.96, Str::new("c.log")).as_str(), Str::new("  census    FAIL    1.0 s  <no verdict line; see c.log>"));
}

![test]
function a_gates_command_line_fills_in_the_compiler_and_the_stdlib() -> Result<(), TestError> {
    const gates: Array<GateCommand> = GateCommand::table(Str::new("cryogate"));
    expect_equal(Text::joined(&gates[1].command(Str::new("C"), Str::new("S")), Str::new(" ")).as_str(),
        Str::new("cryogate examples --cryo C --stdlib S"))?;
    expect_equal(Text::joined(&gates[2].command(Str::new("C"), Str::new("S")), Str::new(" ")).as_str(),
        Str::new("cryogate lsp --cryo C"))?;
    return expect_equal(Text::joined(&gates[6].command(Str::new("C"), Str::new("S")), Str::new(" ")).as_str(),
        Str::new("cryogate abi --cryo C"));
}

![test]
function a_list_file_ends_each_row_and_an_empty_one_is_empty() -> Result<(), TestError> {
    mut rows: Array<String> = Array::<String>::new();
    expect_equal(ObjectHashes::text(&rows).as_str(), Str::new(""))?;
    rows.push(String::from_str(Str::new("a")));
    rows.push(String::from_str(Str::new("b")));
    return expect_equal(ObjectHashes::text(&rows).as_str(), Str::new("a\nb\n"));
}

![test]
function a_started_passing_project_builds_are_not_judged() -> Result<(), TestError> {
    expect_equal(Judged::builds(0, Str::new(""), 0, Str::new(""), true), 0)?;
    return expect_equal(Judged::builds(1, Str::new("error[E0900]: x"), 1, Str::new("error[E0900]: x"), true), 0);
}

![test]
function only_a_whole_error_code_is_a_refusal() -> Result<(), TestError> {
    expect_equal(Judged::builds(1, Str::new("note: error[E12]: x"), 0, Str::new(""), false), 1)?;
    expect_equal(Judged::builds(1, Str::new("error[Exxxx] error[E1234 error[E0001]"), 0, Str::new(""), false), 0)?;
    return expect_equal(Judged::builds(1, Str::new("warning[W0001]: x"), 0, Str::new(""), false), 1);
}

![test]
function a_census_run_records_a_failed_project_and_a_passing_negative_file() -> Result<(), TestError> {
    const zeros: String = Str::new("0").repeat(64);
    const ones: String = Str::new("1").repeat(64);
    const rows: String = f"{zeros.as_str()}  tests/tests/projects/p/build/a.o,{ones.as_str()}  tests/tests/projects/q/build/b.o";
    const shown: String = Judged::records(Str::new("test (project) p ... FAILED (exit 1, expected 0)|test (negative) E1_x.cryo ... ok"),
        Str::new("p,negative/E1_x.cryo"), rows.as_str());
    return expect_equal(shown.as_str(), Str::new("p=FAILED:1;negative/E1_x.cryo=ok:0"));
}

![test]
function a_program_the_run_printed_no_verdict_for_has_no_record() -> Result<(), TestError> {
    const shown: String = Judged::records(Str::new("test (project) other ... ok"), Str::new("p"), Str::new(""));
    expect_equal(shown.as_str(), Str::new(""))?;
    const indented: String = Judged::records(Str::new(" test (project) p ... ok"), Str::new("p"), Str::new(""));
    return expect_equal(indented.as_str(), Str::new(""));
}

![test]
function a_record_file_reads_back_every_field() -> Result<(), TestError> {
    const record: BaselineRecord = BaselineRecord::read(Str::new(
        "name unit suite\nverdict FAILED\nunit-failed A::U::t\nunit-counts 5 1 0 2\nwarnings-listed\nwarning W0001 ./a.cryo:3\nrow d  tests/build/x.o\n"));
    expect(record.warnings_listed, Str::new("warnings-listed, a tag with no value"))?;
    expect_equal(record.name.as_str(), Str::new("unit suite"))?;
    expect_equal(record.verdict.as_str(), Str::new("FAILED"))?;
    expect_equal(record.unit_failed.length(), 1)?;
    expect_equal(record.warnings[0].as_str(), Str::new("W0001 ./a.cryo:3"))?;
    expect_equal(record.rows[0].as_str(), Str::new("d  tests/build/x.o"))?;
    const counts: Array<i64> = record.unit_counts.unwrap_or(Array::<i64>::new());
    return expect(counts.length() == 4 && counts[0] == 5 && counts[3] == 2, Str::new("unit-counts 5 1 0 2"));
}

![test]
function another_projects_moved_object_is_still_compared() -> Result<(), TestError> {
    const p: Str = Str::new("tests/tests/projects/p/");
    const q: Str = Str::new("tests/tests/projects/q/");
    mut left: HashMap<String, String> = Judged::map(f"{p}a.o=1;{q}a.o=1".as_str());
    mut right: HashMap<String, String> = Judged::map(f"{p}a.o=2;{q}a.o=2".as_str());
    expect_equal(VerifyJudges::project_moves(&Judged::list(Str::new("moved:p")), &left, &right).length(), 0)?;
    const kept: String = f"{q}a.o";
    return expect(left.length() == 1 && right.length() == 1 && left.contains_key(&kept) && right.contains_key(&kept),
        Str::new("only the declared project's objects are removed"));
}

![test]
function a_moved_archive_module_needs_its_source_below_std() -> Result<(), TestError> {
    const root: PathBuf = Checkout::root()?;
    expect(Declarations::archive_module_source(root.as_path(), Str::new("moved-archive:std::no_such_module_here")).is_none(),
        Str::new("no such module"))?;
    expect(Declarations::archive_module_source(root.as_path(), Str::new("moved-archive:fmt::display")).is_none(),
        Str::new("not below std::"))?;
    return expect(Declarations::archive_module_source(root.as_path(), Str::new("moved-archive:std::time::clock")).is_some(),
        Str::new("std::time::clock"));
}

![test]
function a_unit_test_file_names_its_object_by_its_namespace() -> Result<(), TestError> {
    const root: PathBuf = Checkout::root()?;
    const suffix: String = Declarations::unit_object_suffix(root.as_path(), Str::new("archive:lang/slice_reference_two_words.cryo"))
        .unwrap_or(String::new());
    expect_equal(suffix.as_str(), Str::new("/deps/CryoTests/Tests/Lang/SliceReferenceTwoWords.o"))?;
    return expect(Declarations::unit_object_suffix(root.as_path(), Str::new("lang/no_such_file_here.cryo")).is_none(),
        Str::new("no such file"));
}

/// A comparison over maps written as `Judged::map` text, the populations
/// in the order tests, examples, stdlib, runtime.
type struct Comparing {
    private static of(changes: &DeclaredChanges, baseline: Array<Str>, tree: Array<Str>, limit: i64) -> Compared {
        mut a: Array<HashMap<String, String>> = Array::<HashMap<String, String>>::new();
        mut b: Array<HashMap<String, String>> = Array::<HashMap<String, String>>::new();
        for (text in baseline.iterate_references()) { a.push(Judged::map(*text)); }
        for (text in tree.iterate_references()) { b.push(Judged::map(*text)); }
        return ObjectComparison::against(Str::new("HEAD"), changes, a, b, limit, Str::new("run"));
    }

    private static nothing_declared() -> DeclaredChanges {
        return DeclaredChanges {
            names: Array::<String>::new(), units: Array::<Pair<String, String>>::new(),
            moved_projects: Array::<String>::new(), moved_modules: Array::<String>::new(),
            moved_members: Array::<String>::new(), archive_files: Array::<String>::new(), problems: Array::<String>::new(),
        };
    }

    private static populations(tests: Str, examples: Str, stdlib: Str, runtime: Str) -> Array<Str> {
        mut out: Array<Str> = Array::<Str>::new();
        out.push(tests);
        out.push(examples);
        out.push(stdlib);
        out.push(runtime);
        return out;
    }
}

![test]
function the_comparison_reports_each_population_as_verify_does() -> Result<(), TestError> {
    const changes: DeclaredChanges = Comparing::nothing_declared();
    const compared: Compared = Comparing::of(&changes,
        Comparing::populations(Str::new("t/build/a.o=1;t/build/b.o=1;t/build/x/std/deps/std/io.o=1"), Str::new(""),
            Str::new("stdlib-archive/w/O0/x.o=1;stdlib-archive/w/O2/x.o=1"), Str::new("runtime/freestanding/00-Sys.o=1")),
        Comparing::populations(Str::new("t/build/a.o=2;t/build/c.o=1"), Str::new(""),
            Str::new("stdlib-archive/w/O0/x.o=1"), Str::new("runtime/freestanding/00-Sys.o=2")), 1);
    const shown: String = Text::joined(&compared.lines, Str::new("\n"));
    expect_equal(shown.as_str(), Str::new(
        "verify: objects against HEAD\n"
        "  tests     baseline     3  tree     2  moved 1  only-baseline 1  only-tree 1  replaced by the archive 1\n"
        "      moved         t/build/a.o\n"
        "      only-baseline t/build/b.o\n"
        "      only-tree     t/build/c.o\n"
        "  examples  baseline     0  tree     0  moved 0  only-baseline 0  only-tree 0  replaced by the archive 0\n"
        "  stdlib    archive objects of a stdlib root only one run used, left out: 1\n"
        "  stdlib    baseline     1  tree     1  moved 0  only-baseline 0  only-tree 0  replaced by the archive 0\n"
        "  runtime   baseline     1  tree     1  moved 1  only-baseline 0  only-tree 0  replaced by the archive 0\n"
        "      moved         runtime/freestanding/Sys.o"))?;
    return expect_equal(compared.changed, 4);
}

![test]
function a_long_list_names_how_many_more_and_where() -> Result<(), TestError> {
    const changes: DeclaredChanges = Comparing::nothing_declared();
    const compared: Compared = Comparing::of(&changes,
        Comparing::populations(Str::new("a.o=1;b.o=1;c.o=1"), Str::new(""), Str::new(""), Str::new("")),
        Comparing::populations(Str::new("a.o=2;b.o=2;c.o=2"), Str::new(""), Str::new(""), Str::new("")), 2);
    return expect_equal(compared.lines[4].as_str(),
        Str::new("      ... 1 more moved (full lists: run/baseline/base.tests.sha256, run/tree.tests.sha256)"));
}

![test]
function a_declared_projects_objects_are_left_out_of_the_comparison() -> Result<(), TestError> {
    mut changes: DeclaredChanges = Comparing::nothing_declared();
    changes.names.push(String::from_str(Str::new("p")));
    changes.names.push(String::from_str(Str::new("examples/e")));
    changes.archive_files.push(String::from_str(Str::new("archive:lang/u.cryo")));
    const compared: Compared = Comparing::of(&changes,
        Comparing::populations(Str::new("tests/tests/projects/p/build/a.o=1;tests/tests/projects/pq/build/a.o=1"),
            Str::new("examples/e/build/m.o=1"), Str::new(""), Str::new("")),
        Comparing::populations(Str::new("tests/tests/projects/p/build/a.o=2;tests/tests/projects/pq/build/a.o=1"),
            Str::new("examples/e/build/m.o=2"), Str::new(""), Str::new("")), 40);
    expect_equal(compared.lines[1].as_str(), Str::new("  tests     declared projects' objects left out: baseline 1, tree 1"))?;
    expect_equal(compared.lines[3].as_str(), Str::new("  examples  declared projects' objects left out: baseline 1, tree 1"))?;
    expect_equal(compared.changed, 0)?;
    // No archive object moved, so the file declared through the archive is a problem.
    return expect_equal(compared.problems.length(), 1);
}

![test]
function the_baseline_census_fails_on_declared_programs_only() -> Result<(), TestError> {
    expect_equal(Judged::census(Str::new("p"), true, 0, 0, Str::new("p"), Str::new(""), Str::new("")), 0)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new(""), Str::new(""), Str::new("")), 0)?;
    expect_equal(Judged::census(Str::new("p"), true, 0, 0, Str::new("p,q"), Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new("p,q"), true, 0, 0, Str::new("p"), Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new("p"), true, 1, 0, Str::new("p"), Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new("p"), false, 0, 0, Str::new("p"), Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new("q"), Str::new("q"), Str::new("")), 0)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new(""), Str::new("q"), Str::new("")), 1)?;
    return expect_equal(Judged::census(Str::new("q"), true, 0, 0, Str::new("q"), Str::new("q"), Str::new("")), 1);
}

![test]
function the_baseline_census_judges_negative_files_and_examples_by_name() -> Result<(), TestError> {
    expect_equal(Judged::census(Str::new(""), true, 0, 1, Str::new("negative/n.cryo"), Str::new("negative/n.cryo"), Str::new("")), 0)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 1, Str::new("negative/n.cryo"), Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new(""), Str::new("negative/n.cryo"), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 2, Str::new("negative/n.cryo"), Str::new("negative/n.cryo"), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new("examples/e"), Str::new("examples/e"), Str::new("")), 0)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new("examples/e"), Str::new(""), Str::new("")), 1)?;
    return expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new(""), Str::new("examples/e"), Str::new("")), 1);
}

![test]
function a_unit_failure_must_be_held_by_a_declared_unit_test_file() -> Result<(), TestError> {
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new(""), Str::new("lang/u.cryo"), Str::new("")), 0)?;
    expect_equal(Judged::census(Str::new(""), true, 1, 0, Str::new(""), Str::new("lang/u.cryo"), Str::new("lang/u.cryo=A::U")), 1)?;
    expect_equal(Judged::census(Str::new(""), true, 1, 0, Str::new("A::U::t"), Str::new("lang/u.cryo"), Str::new("lang/u.cryo=A::U")), 0)?;
    expect_equal(Judged::census(Str::new(""), true, 1, 0, Str::new("A::V::t"), Str::new("lang/u.cryo"), Str::new("lang/u.cryo=A::U")), 1)?;
    expect_equal(Judged::census(Str::new(""), true, 1, 0, Str::new("A::U::t"), Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new(""), true, 1, 0, Str::new("A::U::t"), Str::new("archive:lang/u.cryo"), Str::new("archive:lang/u.cryo=A::U")), 0)?;
    return expect_equal(Judged::census(Str::new(""), true, 1, 0, Str::new("A::V::t"), Str::new("archive:lang/u.cryo"), Str::new("archive:lang/u.cryo=A::U")), 1);
}

![test]
function a_program_declared_moved_is_one_the_baseline_passes() -> Result<(), TestError> {
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new(""), Str::new("moved:p"), Str::new("")), 0)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new("p"), Str::new("moved:p"), Str::new("")), 1)?;
    return expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new(""), Str::new("moved-archive:std::m"), Str::new("")), 0);
}

