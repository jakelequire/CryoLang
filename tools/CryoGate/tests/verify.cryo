///! verify's decisions over the declaration files and the object lists,
///! case for case with scripts/verify.py's self-test while both exist.
![config(testing)]
namespace cryogate::tests::verify;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect, expect_equal };

import std::collections::hashmap::{ HashMap };
import std::collections::pair::{ Pair };

import cryogate::gates::verify::{ BaselineCensus, Declaration, Declarations, DeclarationKind, ObjectOwner, VerifyJudges };

/// The judges' inputs written as text: a list as names joined by `,`, a
/// map as `key=value` entries joined by `;`.  Each answers how many
/// problems its judge finds, as verify.py's self-test counts them.
type struct Judged {
    static list(text: Str) -> Array<String> {
        mut out: Array<String> = Array::<String>::new();
        for (part in text.split_nonempty(&Str::new(","))) { out.push(String::from_str(part)); }
        return out;
    }

    static map(text: Str) -> HashMap<String, String> {
        mut out: HashMap<String, String> = HashMap::<String, String>::new();
        for (entry in text.split_nonempty(&Str::new(";"))) {
            match (entry.split_once(&Str::new("="))) {
                Option::Some(parts) => { out.insert(String::from_str(parts.first), String::from_str(parts.second)); }
                Option::None        => { }
            }
        }
        return out;
    }

    static census(declared: Str, accounted: boolean, unit_failed: i64, negatives_failed: i64, failed: Str,
                  fixed: Str, namespaces: Str) -> i64 {
        const census: BaselineCensus = BaselineCensus {
            accounted: accounted, unit_failed: unit_failed, negatives_failed: negatives_failed,
            failed: Judged::list(failed),
        };
        const held: HashMap<String, String> = Judged::map(namespaces);
        return VerifyJudges::baseline_census(&census, &Judged::list(declared), &Judged::list(fixed), &held).length();
    }

    static unit_moves(file: Str, suffix: Str, a: Str, b: Str) -> i64 {
        mut suffixes: Array<Pair<String, String>> = Array::<Pair<String, String>>::new();
        suffixes.push(Pair::new(String::from_str(file), String::from_str(suffix)));
        mut left: HashMap<String, String> = Judged::map(a);
        mut right: HashMap<String, String> = Judged::map(b);
        return VerifyJudges::unit_moves(&suffixes, &left, &right).length();
    }

    static project_moves(names: Str, a: Str, b: Str) -> i64 {
        mut left: HashMap<String, String> = Judged::map(a);
        mut right: HashMap<String, String> = Judged::map(b);
        return VerifyJudges::project_moves(&Judged::list(names), &left, &right).length();
    }

    static archive_module_moves(names: Str, a: Str, b: Str) -> i64 {
        mut left: HashMap<String, String> = Judged::map(a);
        mut right: HashMap<String, String> = Judged::map(b);
        return VerifyJudges::archive_module_moves(&Judged::list(names), &left, &right).length();
    }

    static new_warnings(base: Str, tree: Str) -> i64 {
        return VerifyJudges::new_warnings(&Judged::list(base), &Judged::list(tree)).length();
    }
}

![test]
function the_baseline_census_fails_on_declared_programs_only() -> Result<(), TestError> {
    expect_equal(Judged::census(Str::new("p"), true, 0, 0, Str::new("p"), Str::new(""), Str::new("")), 0)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new(""), Str::new(""), Str::new("")), 0)?;
    expect_equal(Judged::census(Str::new("p"), true, 0, 0, Str::new("p,q"), Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new("p,q"), true, 0, 0, Str::new("p"), Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new("p"), true, 1, 0, Str::new("p"), Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new("p"), false, 0, 0, Str::new("p"), Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new("q"), Str::new("q"), Str::new("")), 0)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new(""), Str::new("q"), Str::new("")), 1)?;
    return expect_equal(Judged::census(Str::new("q"), true, 0, 0, Str::new("q"), Str::new("q"), Str::new("")), 1);
}

![test]
function the_baseline_census_judges_negative_files_and_examples_by_name() -> Result<(), TestError> {
    expect_equal(Judged::census(Str::new(""), true, 0, 1, Str::new("negative/n.cryo"), Str::new("negative/n.cryo"), Str::new("")), 0)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 1, Str::new("negative/n.cryo"), Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new(""), Str::new("negative/n.cryo"), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 2, Str::new("negative/n.cryo"), Str::new("negative/n.cryo"), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new("examples/e"), Str::new("examples/e"), Str::new("")), 0)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new("examples/e"), Str::new(""), Str::new("")), 1)?;
    return expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new(""), Str::new("examples/e"), Str::new("")), 1);
}

![test]
function a_unit_failure_must_be_held_by_a_declared_unit_test_file() -> Result<(), TestError> {
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new(""), Str::new("lang/u.cryo"), Str::new("")), 0)?;
    expect_equal(Judged::census(Str::new(""), true, 1, 0, Str::new(""), Str::new("lang/u.cryo"), Str::new("lang/u.cryo=A::U")), 1)?;
    expect_equal(Judged::census(Str::new(""), true, 1, 0, Str::new("A::U::t"), Str::new("lang/u.cryo"), Str::new("lang/u.cryo=A::U")), 0)?;
    expect_equal(Judged::census(Str::new(""), true, 1, 0, Str::new("A::V::t"), Str::new("lang/u.cryo"), Str::new("lang/u.cryo=A::U")), 1)?;
    expect_equal(Judged::census(Str::new(""), true, 1, 0, Str::new("A::U::t"), Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::census(Str::new(""), true, 1, 0, Str::new("A::U::t"), Str::new("archive:lang/u.cryo"), Str::new("archive:lang/u.cryo=A::U")), 0)?;
    return expect_equal(Judged::census(Str::new(""), true, 1, 0, Str::new("A::V::t"), Str::new("archive:lang/u.cryo"), Str::new("archive:lang/u.cryo=A::U")), 1);
}

![test]
function a_program_declared_moved_is_one_the_baseline_passes() -> Result<(), TestError> {
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new(""), Str::new("moved:p"), Str::new("")), 0)?;
    expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new("p"), Str::new("moved:p"), Str::new("")), 1)?;
    return expect_equal(Judged::census(Str::new(""), true, 0, 0, Str::new(""), Str::new("moved-archive:std::m"), Str::new("")), 0);
}

![test]
function a_declared_unit_test_object_must_move() -> Result<(), TestError> {
    expect_equal(Judged::unit_moves(Str::new("u"), Str::new("/U.o"), Str::new("x/U.o=1"), Str::new("x/U.o=2")), 0)?;
    expect_equal(Judged::unit_moves(Str::new("u"), Str::new("/U.o"), Str::new("x/U.o=1"), Str::new("x/U.o=1")), 1)?;
    return expect_equal(Judged::unit_moves(Str::new("u"), Str::new("/U.o"), Str::new(""), Str::new("")), 1);
}

![test]
function a_project_declared_moved_must_move_one_of_its_objects() -> Result<(), TestError> {
    const prefix: Str = Str::new("tests/tests/projects/p/");
    expect_equal(Judged::project_moves(Str::new("moved:p"), f"{prefix}a.o=1;{prefix}b.o=1".as_str(), f"{prefix}a.o=1;{prefix}b.o=2".as_str()), 0)?;
    expect_equal(Judged::project_moves(Str::new("moved:p"), f"{prefix}a.o=1".as_str(), f"{prefix}a.o=1".as_str()), 1)?;
    expect_equal(Judged::project_moves(Str::new("moved:p"), Str::new(""), Str::new("")), 1)?;
    return expect_equal(Judged::project_moves(Str::new("moved:p"), f"{prefix}a.o=1".as_str(), f"{prefix}a.o=1;{prefix}b.o=1".as_str()), 0);
}

![test]
function a_module_declared_moved_archive_must_move_an_archive_object() -> Result<(), TestError> {
    expect_equal(Judged::archive_module_moves(Str::new("moved-archive:std::m"),
        Str::new("stdlib-archive/t/O0/x/deps/std/m.o=1;stdlib-archive/t/O2/x/deps/std/m.o=1"),
        Str::new("stdlib-archive/t/O0/x/deps/std/m.o=1;stdlib-archive/t/O2/x/deps/std/m.o=2")), 0)?;
    expect_equal(Judged::archive_module_moves(Str::new("moved-archive:std::m"),
        Str::new("stdlib-archive/t/O0/x/deps/std/m.o=1"), Str::new("stdlib-archive/t/O0/x/deps/std/m.o=1")), 1)?;
    expect_equal(Judged::archive_module_moves(Str::new("moved-archive:std::m"), Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::archive_module_moves(Str::new("moved-archive:std::m"),
        Str::new("stdlib-archive/t/O0/x/deps/std/am.o=1"), Str::new("stdlib-archive/t/O0/x/deps/std/am.o=2")), 1)?;
    // Another module's moved object stays in both maps, to be compared.
    mut left: HashMap<String, String> = Judged::map(Str::new("s/x/deps/std/m.o=1;s/x/deps/std/n.o=1"));
    mut right: HashMap<String, String> = Judged::map(Str::new("s/x/deps/std/m.o=2;s/x/deps/std/n.o=2"));
    expect_equal(VerifyJudges::archive_module_moves(&Judged::list(Str::new("moved-archive:std::m")), &left, &right).length(), 0)?;
    return expect(left.length() == 1 && right.length() == 1
        && left.contains_key(&String::from_str(Str::new("s/x/deps/std/n.o"))), Str::new("only the declared module's objects are removed"));
}

![test]
function an_archive_declared_unit_test_file_needs_an_archive_object_to_move() -> Result<(), TestError> {
    expect_equal(VerifyJudges::archive_moves(&Judged::list(Str::new("archive:lang/u.cryo")), 0).length(), 1)?;
    expect_equal(VerifyJudges::archive_moves(&Judged::list(Str::new("archive:lang/u.cryo")), 2).length(), 0)?;
    return expect_equal(VerifyJudges::archive_moves(&Judged::list(Str::new("")), 0).length(), 0);
}

![test]
function a_warning_only_the_tree_reports_is_new() -> Result<(), TestError> {
    expect_equal(Judged::new_warnings(Str::new("W0001 ./a.cryo:3"), Str::new("W0001 ./a.cryo:3")), 0)?;
    expect_equal(Judged::new_warnings(Str::new("W0001 ./a.cryo:3"), Str::new("W0001 ./a.cryo:3,E0619 ./b.cryo:9")), 1)?;
    expect_equal(Judged::new_warnings(Str::new("W0001 ./a.cryo:3"), Str::new("W0001 ./a.cryo:4")), 1)?;
    return expect_equal(Judged::new_warnings(Str::new("W0001 ./a.cryo:3,W0009 ./c.cryo:1"), Str::new("W0001 ./a.cryo:3")), 0);
}

type struct Fixture {
    /// The declarations as `name=reason` entries joined by `;`, in order.
    static shown(declarations: &Array<Declaration>) -> String {
        mut out: String = String::new();
        for (mut i: i64 = 0; i < declarations.length(); i++) {
            if (i > 0) { out.push(';'); }
            out.push(declarations[i].name.as_str());
            out.push('=');
            out.push(declarations[i].reason.as_str());
        }
        return out;
    }

    static between(tree: Str, base: Str) -> String {
        const applied: Array<Declaration> = Declarations::between(tree, base);
        return Fixture::shown(&applied);
    }

    static owner(path: Str) -> String {
        return match (ObjectOwner::of(path)) {
            Option::Some(name) => { name }
            Option::None       => { String::from_str(Str::new("<none>")) }
        };
    }
}

![test]
function parse_skips_comments_and_blank_lines() -> Result<(), TestError> {
    const parsed: Array<Declaration> = Declarations::parse(Str::new("# c\n\np why\nq\n"));
    const shown: String = Fixture::shown(&parsed);
    return expect_equal(shown.as_str(), Str::new("p=why;q="));
}

![test]
function a_name_written_twice_keeps_its_place_and_takes_the_later_reason() -> Result<(), TestError> {
    const parsed: Array<Declaration> = Declarations::parse(Str::new("p a\nq b\np c\n"));
    const shown: String = Fixture::shown(&parsed);
    return expect_equal(shown.as_str(), Str::new("p=c;q=b"));
}

![test]
function a_new_line_applies() -> Result<(), TestError> {
    const applied: String = Fixture::between(Str::new("p a\nq b\n"), Str::new("p a\n"));
    return expect_equal(applied.as_str(), Str::new("q=b"));
}

![test]
function an_unchanged_line_does_not_apply() -> Result<(), TestError> {
    const applied: String = Fixture::between(Str::new("p a\n"), Str::new("p a\n"));
    return expect_equal(applied.as_str(), Str::new(""));
}

![test]
function a_rewritten_reason_applies_again() -> Result<(), TestError> {
    const applied: String = Fixture::between(Str::new("p b\n"), Str::new("p a\n"));
    return expect_equal(applied.as_str(), Str::new("p=b"));
}

![test]
function a_removed_line_declares_nothing() -> Result<(), TestError> {
    const applied: String = Fixture::between(Str::new(""), Str::new("p a\n"));
    return expect_equal(applied.as_str(), Str::new(""));
}

![test]
function a_line_rewritten_into_the_archive_form_with_its_reason_kept_declares_nothing() -> Result<(), TestError> {
    const applied: String = Fixture::between(Str::new("archive:p a\n"), Str::new("p a\n"));
    return expect_equal(applied.as_str(), Str::new(""));
}

![test]
function a_new_line_in_the_archive_form_applies() -> Result<(), TestError> {
    const applied: String = Fixture::between(Str::new("archive:p a\n"), Str::new(""));
    return expect_equal(applied.as_str(), Str::new("archive:p=a"));
}

![test]
function a_line_rewritten_into_the_moved_form_with_its_reason_kept_declares_nothing() -> Result<(), TestError> {
    const applied: String = Fixture::between(Str::new("moved:p a\n"), Str::new("p a\n"));
    return expect_equal(applied.as_str(), Str::new(""));
}

![test]
function the_moved_archive_form_is_its_own_kind_naming_the_module() -> Result<(), TestError> {
    const name: Str = Str::new("moved-archive:std::a::b");
    const kind: DeclarationKind = Declarations::kind(name);
    expect(match (kind) { DeclarationKind::MovedArchive => { true } _ => { false } }, Str::new("kind moved-archive"))?;
    expect_equal(Declarations::program_of(name), Str::new("std::a::b"))?;
    const suffix: String = Declarations::archive_module_suffix(name);
    return expect_equal(suffix.as_str(), Str::new("/deps/std/a/b.o"));
}

![test]
function each_form_names_its_kind() -> Result<(), TestError> {
    expect(match (Declarations::kind(Str::new("archive:lang/u.cryo"))) { DeclarationKind::Archive => { true } _ => { false } }, Str::new("archive"))?;
    expect(match (Declarations::kind(Str::new("moved:p"))) { DeclarationKind::Moved => { true } _ => { false } }, Str::new("moved"))?;
    expect(match (Declarations::kind(Str::new("negative/E1_x.cryo"))) { DeclarationKind::Negative => { true } _ => { false } }, Str::new("negative before unit"))?;
    expect(match (Declarations::kind(Str::new("examples/01-hello"))) { DeclarationKind::Example => { true } _ => { false } }, Str::new("example"))?;
    expect(match (Declarations::kind(Str::new("lang/u.cryo"))) { DeclarationKind::Unit => { true } _ => { false } }, Str::new("unit"))?;
    return expect(match (Declarations::kind(Str::new("p"))) { DeclarationKind::Project => { true } _ => { false } }, Str::new("project"));
}

![test]
function an_object_outside_every_program_build_belongs_to_none() -> Result<(), TestError> {
    const outside: String = Fixture::owner(Str::new("tests/tests/lang/build/x.o"));
    expect_equal(outside.as_str(), Str::new("<none>"))?;
    const unit: String = Fixture::owner(Str::new("tests/build/deps/A.o"));
    expect_equal(unit.as_str(), Str::new("unit suite"))?;
    const project: String = Fixture::owner(Str::new("tests/tests/projects/p/build/a.o"));
    expect_equal(project.as_str(), Str::new("p"))?;
    const example: String = Fixture::owner(Str::new("examples/01-hello/build/m.o"));
    return expect_equal(example.as_str(), Str::new("examples/01-hello"));
}

![test]
function a_stdlib_object_the_tree_takes_from_the_archive_is_replaced() -> Result<(), TestError> {
    return expect(ObjectOwner::replaced_by_archive(Str::new("p/build/x/std/deps/std/io.o"), true),
        Str::new("a stdlib module's object, archive linked"));
}

![test]
function a_program_object_missing_from_the_tree_is_not_replaced() -> Result<(), TestError> {
    return expect(!ObjectOwner::replaced_by_archive(Str::new("p/build/x/local/deps/main.o"), true),
        Str::new("a program's own object"));
}

![test]
function a_stdlib_object_missing_when_no_archive_was_linked_is_not_replaced() -> Result<(), TestError> {
    return expect(!ObjectOwner::replaced_by_archive(Str::new("p/build/x/std/deps/std/io.o"), false),
        Str::new("no archive linked"));
}
