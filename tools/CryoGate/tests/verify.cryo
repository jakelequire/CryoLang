function a_warning_only_the_tree_reports_is_new() -> Result<(), TestError> {
    expect_equal(Judged::new_warnings(Str::new("W0001 ./a.cryo:3"), Str::new("W0001 ./a.cryo:3")), 0)?;
    expect_equal(Judged::new_warnings(Str::new("W0001 ./a.cryo:3"), Str::new("W0001 ./a.cryo:3,E0619 ./b.cryo:9")), 1)?;
