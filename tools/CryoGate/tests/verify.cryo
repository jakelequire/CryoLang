![test]
function a_project_declared_moved_must_move_one_of_its_objects() -> Result<(), TestError> {
    const prefix: Str = Str::new("tests/tests/projects/p/");
    expect_equal(Judged::project_moves(Str::new("moved:p"), f"{prefix}a.o=1;{prefix}b.o=1".as_str(), f"{prefix}a.o=1;{prefix}b.o=2".as_str()), 0)?;
    expect_equal(Judged::project_moves(Str::new("moved:p"), f"{prefix}a.o=1".as_str(), f"{prefix}a.o=1".as_str()), 1)?;
    expect_equal(Judged::project_moves(Str::new("moved:p"), Str::new(""), Str::new("")), 1)?;
    return expect_equal(Judged::project_moves(Str::new("moved:p"), f"{prefix}a.o=1".as_str(), f"{prefix}a.o=1;{prefix}b.o=1".as_str()), 0);
}

![test]
function a_module_declared_moved_archive_must_move_an_archive_object() -> Result<(), TestError> {
    expect_equal(Judged::archive_module_moves(Str::new("moved-archive:std::m"),
        Str::new("stdlib-archive/t/O0/x/deps/std/m.o=1;stdlib-archive/t/O2/x/deps/std/m.o=1"),
        Str::new("stdlib-archive/t/O0/x/deps/std/m.o=1;stdlib-archive/t/O2/x/deps/std/m.o=2")), 0)?;
    expect_equal(Judged::archive_module_moves(Str::new("moved-archive:std::m"),
        Str::new("stdlib-archive/t/O0/x/deps/std/m.o=1"), Str::new("stdlib-archive/t/O0/x/deps/std/m.o=1")), 1)?;
    expect_equal(Judged::archive_module_moves(Str::new("moved-archive:std::m"), Str::new(""), Str::new("")), 1)?;
    expect_equal(Judged::archive_module_moves(Str::new("moved-archive:std::m"),
        Str::new("stdlib-archive/t/O0/x/deps/std/am.o=1"), Str::new("stdlib-archive/t/O0/x/deps/std/am.o=2")), 1)?;
    // Another module's moved object stays in both maps, to be compared.
    mut left: HashMap<String, String> = Judged::map(Str::new("s/x/deps/std/m.o=1;s/x/deps/std/n.o=1"));
    mut right: HashMap<String, String> = Judged::map(Str::new("s/x/deps/std/m.o=2;s/x/deps/std/n.o=2"));
    expect_equal(VerifyJudges::archive_module_moves(&Judged::list(Str::new("moved-archive:std::m")), &Array::<String>::new(), &left, &right).length(), 0)?;
    return expect(left.length() == 1 && right.length() == 1
        && left.contains_key(&String::from_str(Str::new("s/x/deps/std/n.o"))), Str::new("only the declared module's objects are removed"));
}

![test]
function a_module_declared_moved_archive_may_move_only_its_unit_build_object() -> Result<(), TestError> {
    const unit: Str = Str::new("tests/build/target/release/host/std/deps/std/m.o");
    const other: Str = Str::new("tests/build/target/release/host/std/deps/std/n.o");
    const project: Str = Str::new("tests/tests/projects/p/build/std/deps/std/m.o");
    const archive: Str = Str::new("stdlib-archive/w/O2/x/deps/std/m.o");
    mut changes: DeclaredChanges = Comparing::nothing_declared();
    changes.moved_modules.push(String::from_str(Str::new("moved-archive:std::m")));
    // The archive's object is unchanged and the unit build's moved: the
    // declaration holds, and only the other module's and the project's
    // objects are left to compare.
    const held: Compared = Comparing::of(&changes,
        Comparing::populations(f"{unit}=1;{other}=1;{project}=1".as_str(), Str::new(""), f"{archive}=1".as_str(), Str::new("")),
        Comparing::populations(f"{unit}=2;{other}=2;{project}=2".as_str(), Str::new(""), f"{archive}=1".as_str(), Str::new("")), 5);
    expect_equal(held.problems.length(), 0)?;
    expect_equal(held.changed, 2)?;
    // Built by one run only, it moved too.
    const once: Compared = Comparing::of(&changes,
        Comparing::populations(f"{unit}=1".as_str(), Str::new(""), f"{archive}=1".as_str(), Str::new("")),
        Comparing::populations(Str::new(""), Str::new(""), f"{archive}=1".as_str(), Str::new("")), 5);
    expect_equal(once.problems.length(), 0)?;
    expect_equal(once.changed, 0)?;
    // Neither moved: the declaration is refused.
    const neither: Compared = Comparing::of(&changes,
        Comparing::populations(f"{unit}=1".as_str(), Str::new(""), f"{archive}=1".as_str(), Str::new("")),
        Comparing::populations(f"{unit}=1".as_str(), Str::new(""), f"{archive}=1".as_str(), Str::new("")), 5);
    expect_equal(neither.problems.length(), 1)?;
    return expect_equal(neither.problems[0].as_str(),
        Str::new("moved-archive:std::m is declared as moving its objects, but none of its 1 archive objects moved, nor its object in the unit build"));
}

![test]
function the_moved_runtime_form_is_its_own_kind_naming_configuration_and_member() -> Result<(), TestError> {
    const name: Str = Str::new("moved-runtime:hosted-unwind/Sys.o");
    expect(match (Declarations::kind(name)) { DeclarationKind::MovedRuntime => { true } _ => { false } }, Str::new("kind moved-runtime"))?;
    expect_equal(Declarations::program_of(name), Str::new("hosted-unwind/Sys.o"))?;
    const member: RuntimeMember = RuntimeMember::of(name).unwrap();
    expect_equal(member.configuration.as_str(), Str::new("hosted-unwind"))?;
    expect_equal(member.member.as_str(), Str::new("Sys.o"))?;
    expect(RuntimeMember::of(Str::new("moved-runtime:Sys.o")).is_none(), Str::new("no configuration"))?;
    expect(RuntimeMember::of(Str::new("moved-runtime:libcryort-core.a/Sys.o")).is_none(), Str::new("a tier is no configuration"))?;
    return expect(RuntimeMember::of(Str::new("moved-runtime:hosted/Sys.o")).is_none(), Str::new("hosted is no configuration"));
}

