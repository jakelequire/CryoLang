///! The gates' pure decisions, and the option parser every subcommand reads
///! its command line with.
![config(testing)]
namespace cryogate::tests::gates;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect, expect_false };

import cryogate::core::options::{ Options, Parsed };
import cryogate::gates::cross::{ CrossCheck, Population };
import cryogate::gates::incr::{ IncrementalInstance };
import cryogate::gates::vendor::{ VendorGate };

type struct Fixture {
    /// `cryogate` followed by the space-separated `words`.
    static command_line(words: Str) -> Array<String> {
        mut arguments: Array<String> = Array::<String>::new();
        arguments.push(String::from_str(Str::new("cryogate")));
        for (word in words.split(&Str::new(" "))) { arguments.push(String::from_str(word)); }
        return arguments;
    }

    static gate_options() -> Options {
        mut options: Options = Options::new(Str::new("cryogate gate --check --cryo <compiler> [names]"));
        options.flag(Str::new("--check"));
        options.valued(Str::new("--cryo"));
        return options;
    }
}

![test]
function options_read_flags_values_and_positionals() -> Result<(), TestError> {
    const arguments: Array<String> = Fixture::command_line(Str::new("--check --cryo a/cryo one --cryo=b/cryo two"));
    const parsed: Parsed = match (Fixture::gate_options().parse(&arguments, 1)) {
        Result::Ok(parsed) => { parsed }
        Result::Err(_)     => { return expect(false, Str::new("a valid command line is accepted")); }
    };
    expect(parsed.has(Str::new("--check")), Str::new("the flag"))?;
    expect(parsed.value(Str::new("--cryo")).unwrap() == Str::new("b/cryo"), Str::new("the last value given wins"))?;
    expect(parsed.positionals().length() == 2, Str::new("two positionals"))?;
    expect(parsed.positionals().get_ref(1).unwrap().as_str() == Str::new("two"), Str::new("in order"))?;
    return expect_false(parsed.separated(), Str::new("no `--`"));
}

![test]
function options_keep_everything_after_a_separator() -> Result<(), TestError> {
    const arguments: Array<String> = Fixture::command_line(Str::new("--check -- python --check x"));
    const parsed: Parsed = Fixture::gate_options().parse(&arguments, 1).unwrap();
    expect(parsed.separated(), Str::new("`--` seen"))?;
    expect(parsed.rest().length() == 3, Str::new("three words after it"))?;
    return expect(parsed.rest().get_ref(1).unwrap().as_str() == Str::new("--check"), Str::new("an option after `--` is the program's"));
}

![test]
function options_refuse_what_was_not_declared() -> Result<(), TestError> {
    const unknown: Array<String> = Fixture::command_line(Str::new("--chekc"));
    match (Fixture::gate_options().parse(&unknown, 1)) {
        Result::Ok(_)       => { return expect(false, Str::new("a mistyped flag is refused")); }
        Result::Err(reason) => { expect(reason.as_str().contains(&Str::new("`--chekc`")), Str::new("the refusal names it"))?; }
    }
    const missing: Array<String> = Fixture::command_line(Str::new("--cryo"));
    match (Fixture::gate_options().parse(&missing, 1)) {
        Result::Ok(_)       => { return expect(false, Str::new("a valued option with no value is refused")); }
        Result::Err(reason) => { expect(reason.as_str().contains(&Str::new("needs a value")), Str::new("the refusal says why"))?; }
    }
    const flag_with_value: Array<String> = Fixture::command_line(Str::new("--check=yes"));
    return expect(Fixture::gate_options().parse(&flag_with_value, 1).is_err(), Str::new("a flag given a value is refused"));
}

![test]
function a_header_publishes_object_like_macros_and_static_constants() -> Result<(), TestError> {
    const names: Array<String> = VendorGate::published(Str::new(
        "#define VC_MAKE_VERSION(major, minor) (((major) << 8) | (minor))\n"
        "#define VC_PLAIN_INT   4097\r\n"
        "#define VC_TWO_STEP    VC_MAKE_VERSION(1, 3)\n"
        "  #define VC_INDENTED 1\n"
        "#defineVC_GLUED 2\n"
        "static const unsigned long long VC_WIDE_FLAG = 0x100000000ull;\n"
        "static const int\n    VC_SPLIT = 3;\n"
        "static const int vc_declared_only;\n"
        "static constant_folded VC_NOT_CONST = 4;\n"
        "enum VcKind { VC_KIND_NONE = 0 };\n"));
    expect(names.length() == 4, Str::new("four constants"))?;
    expect(names.get_ref(0).unwrap().as_str() == Str::new("VC_PLAIN_INT"), Str::new("sorted, the literal first"))?;
    expect(names.get_ref(1).unwrap().as_str() == Str::new("VC_SPLIT"), Str::new("a declaration over two lines"))?;
    expect(names.get_ref(2).unwrap().as_str() == Str::new("VC_TWO_STEP"), Str::new("a macro invoking a macro"))?;
    expect(names.get_ref(3).unwrap().as_str() == Str::new("VC_WIDE_FLAG"), Str::new("the static constant"))?;
    return expect_false(names.contains(&String::from_str(Str::new("VC_MAKE_VERSIO"))), Str::new("a function-like macro is not read as a shorter name"));
}

![test]
function a_build_states_its_population_on_its_building_lines() -> Result<(), TestError> {
    expect(Population::counted(Str::new("Building cryo [release]: 164 local, 81 std module(s)")).unwrap() == 245, Str::new("local and std"))?;
    expect(Population::counted(Str::new("Building cryolsp [release]: 33 local, 85 std, 169 dep module(s)")).unwrap() == 287, Str::new("with dependencies"))?;
    expect(Population::counted(Str::new("Building cryort-core [release]: 3 local module(s)")).unwrap() == 3, Str::new("a runtime tier"))?;
    expect(Population::counted(Str::new("cryo is up to date")).is_none(), Str::new("a warm build states none"))?;
    expect(Population::counted(Str::new("Buildingcryo [release]: 3 local module(s)")).is_none(), Str::new("the name is separated"))?;
    mut lines: Array<String> = Array::<String>::new();
    lines.push(String::from_str(Str::new("Building cryort-core [release]: 3 local module(s)")));
    lines.push(String::from_str(Str::new("Building cryort-panic [release]: 2 local module(s)")));
    lines.push(String::from_str(Str::new("Compiled -> build/x")));
    const population: Population = Population::of(&lines);
    expect(population.tiers == 2, Str::new("two tiers"))?;
    return expect(population.modules == 5, Str::new("their modules summed"));
}

![test]
function an_error_report_keeps_each_error_with_its_span() -> Result<(), TestError> {
    mut lines: Array<String> = Array::<String>::new();
    lines.push(String::from_str(Str::new("error[E0233]: cannot find `x`")));
    lines.push(String::from_str(Str::new(" --> src/a.cryo:3:5")));
    lines.push(String::from_str(Str::new("note: unrelated")));
    lines.push(String::from_str(Str::new("error: linking failed")));
    lines.push(String::from_str(Str::new("    |")));
    lines.push(String::from_str(Str::new("    |")));
    lines.push(String::from_str(Str::new(" --> too far away")));
    const report: Array<String> = CrossCheck::error_report(&lines);
    expect(report.length() == 3, Str::new("two errors and one span"))?;
    expect(report.get_ref(1).unwrap().as_str().contains(&Str::new("src/a.cryo:3:5")), Str::new("the span follows its error"))?;
    return expect(report.get_ref(2).unwrap().as_str() == Str::new("error: linking failed"), Str::new("a span three lines on is not its"));
}

![test]
function the_reuse_count_is_read_off_the_build_line() -> Result<(), TestError> {
    expect(IncrementalInstance::reused(Str::new("Building x [release]: 3 local\n  reusing 7 cached object(s), recompiling 13\n")) == 7, Str::new("the count"))?;
    expect(IncrementalInstance::reused(Str::new("reusing the cache\n  reusing 12 cached object(s)")) == 12, Str::new("past a `reusing` that is not the line"))?;
    expect(IncrementalInstance::reused(Str::new("Compiled -> build/x.exe\n")) == 0, Str::new("no line is zero"))?;
    return expect(IncrementalInstance::reused(Str::new("  reusing 0 cached object(s), recompiling 3")) == 0, Str::new("an honest zero"));
}
