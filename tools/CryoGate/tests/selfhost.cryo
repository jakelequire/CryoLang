type struct Fixture {
    /// Write `text` to `relative` below `root`, creating its directories.
    private static put(root: Path, relative: Str, text: Str) -> Result<(), TestError> {
        const path: PathBuf = root.join(relative);
        match (path.as_path().parent()) {
            Option::Some(parent) => {
                match (Directory::create_all(parent)) {
                    Result::Ok(_)      => { }
                    Result::Err(error) => { return Result::Err(TestError::other(error.describe())); }
                }
            }
            Option::None => { }
        }
        return match (File::write_text(path.as_path(), text)) {
            Result::Ok(_)      => { Result::Ok(()) }
            Result::Err(error) => { Result::Err(TestError::other(error.describe())) }
        };
    }

    /// A field of the plan's stage `index` as text: its `program`, its
    /// `arguments` joined by spaces, its `variables` as `NAME=value` joined
    /// by `;`, or its `label`.
    private static field(plan: &ArmPlan, index: i64, name: Str) -> String {
        if (name == Str::new("program")) { return plan.stages.get_reference(index).unwrap().program.clone(); }
        if (name == Str::new("label")) { return plan.stages.get_reference(index).unwrap().label(); }
        if (name == Str::new("arguments")) { return Text::joined(&plan.stages.get_reference(index).unwrap().arguments, Str::new(" ")); }
        mut variables: Array<String> = Array::<String>::new();
        for (variable in plan.stages.get_reference(index).unwrap().variables.iterate_references()) {
            variables.push(f"{variable.first.as_str()}={variable.second.as_str()}");
        }
        return Text::joined(&variables, Str::new(";"));
    }

    private static scratch() -> Result<TemporaryDirectory, TestError> {
        return match (TemporaryDirectory::create()) {
            Result::Ok(directory) => { Result::Ok(directory) }
            Result::Err(error)    => { Result::Err(TestError::other(error.describe())) }
        };
    }

    /// The comparison as one line: `same 2 8`, `differs <key>`,
    /// `not comparable <reason>`.
    private static described(comparison: &TreeComparison) -> String {
        return match (comparison) {
            TreeComparison::Same(size)            => { f"same {size.modules} {size.bytes}" }
            TreeComparison::Differs(key)          => { f"differs {key.as_str()}" }
            TreeComparison::NotComparable(reason) => { f"not comparable {reason.as_str()}" }
        };
    }

    /// The archive comparison as one line: `shared`, or the tree's.
    private static archives(comparison: &ArchiveComparison) -> String {
        return match (comparison) {
            ArchiveComparison::Shared            => { String::from_str(Str::new("shared")) }
            ArchiveComparison::Compared(compared) => { Fixture::described(compared) }
        };
    }

    /// A stdlib archive `key` below the scratch stdlib `stdlib`, holding
    /// the objects `std/core/error.o` and `std/io/error.o` with the bytes
    /// given (an empty one is left out), and the same IR whatever they are.
    private static archive(stdlib: Path, key: Str, core: Str, io: Str) -> Result<(), TestError> {
        const home: String = f".bin/t/prebuilt/{key}/target/release/t/local";
        if (!core.is_empty()) { Fixture::put(stdlib, f"{home.as_str()}/deps/std/core/error.o".as_str(), core)?; }
        if (!io.is_empty()) { Fixture::put(stdlib, f"{home.as_str()}/deps/std/io/error.o".as_str(), io)?; }
        Fixture::put(stdlib, f"{home.as_str()}/ir/std/core/error.ll".as_str(), Str::new("ir"))?;
        return Fixture::put(stdlib, f"{home.as_str()}/ir/std/io/error.ll".as_str(), Str::new("ir2"));
    }

    /// The archive comparison after the pin built nothing, stage 2 built
    /// the archive `a` and stage 3 the archive `b` (none when `b` is
    /// empty); the stage compilers hold `second` and `third`.
    private static stage_archives(root: Path, a_core: Str, a_io: Str, b_core: Str, b_io: Str, second: Str, third: Str) -> Result<String, TestError> {
        const stdlib: PathBuf = root.join(Str::new("stdlib"));
        Fixture::archive(stdlib.as_path(), Str::new("old"), Str::new("x"), Str::new("y"))?;
        mut watched: StageArchives = match (StageArchives::start(stdlib.as_path())) {
            Result::Ok(watched) => { watched }
            Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
        };
        Fixture::recorded(&watched, Str::new("pinned"))?;
        Fixture::archive(stdlib.as_path(), Str::new("a"), a_core, a_io)?;
        Fixture::put(stdlib.as_path(), Str::new(".bin/t/prebuilt/a.lock"), Str::new("not an archive"))?;
        Fixture::recorded(&watched, Str::new("stage-2"))?;
        if (!b_core.is_empty() || !b_io.is_empty()) { Fixture::archive(stdlib.as_path(), Str::new("b"), b_core, b_io)?; }
        Fixture::recorded(&watched, Str::new("stage-3"))?;
        Fixture::put(root, Str::new("stage2"), second)?;
        Fixture::put(root, Str::new("stage3"), third)?;
        const compared: ArchiveComparison = watched.compare(root.join(Str::new("stage2")).as_path(), root.join(Str::new("stage3")).as_path());
        return Result::Ok(Fixture::archives(&compared));
    }

    private static recorded(watched: mut &StageArchives, via: Str) -> Result<(), TestError> {
        return match (watched.record(via)) {
            Result::Ok(_)       => { Result::Ok(()) }
            Result::Err(reason) => { Result::Err(TestError::other(reason.as_str())) }
        };
    }

    private static digest(root: Path) -> Result<TreeDigest, TestError> {
        return match (TreeDigest::of(root)) {
            Result::Ok(digest)  => { Result::Ok(digest) }
            Result::Err(reason) => { Result::Err(TestError::other(reason.as_str())) }
        };
    }

    private static verdict(statuses: &Array<ArmStatus>, allow_skipped: boolean) -> ArmsVerdict {
        mut arms: Array<Arm> = Array::<Arm>::new();
        mut index: i64 = 0;
        for (status in statuses.iterate_references()) {
            const name: Str = if (index == 0) { Str::new("linux") } else { Str::new("windows") };
            const copied: ArmStatus = match (status) {
                ArmStatus::Verified => { ArmStatus::Verified }
                ArmStatus::Skipped  => { ArmStatus::Skipped }
                ArmStatus::Failed   => { ArmStatus::Failed }
                ArmStatus::Declined => { ArmStatus::Declined }
            };
            arms.push(Arm::new(name, copied, Str::new("why")));
            index++;
        }
        return ArmsVerdict::of(&arms, allow_skipped);
    }
}

![test]
function the_linux_arm_builds_three_stages_from_the_pin_and_emits_ir_for_the_last_two() -> Result<(), TestError> {
    const plan: ArmPlan = ArmPlan::linux(Path::from(Str::new("/r")));
    expect(plan.stages.length() == 3, Str::new("three stages"))?;
    const pin: String = Fixture::field(&plan, 0, Str::new("program"));
    expect(pin.as_str().ends_with("cryo") && pin.as_str().contains("bin"), Str::new("the pin builds stage 2"))?;
    expect(Fixture::field(&plan, 0, Str::new("arguments")) == String::from_str(Str::new("build --no-incremental")), Str::new("stage 2 goes to compiler/build, with no IR"))?;
    expect(Fixture::field(&plan, 1, Str::new("program")).as_str() == plan.compilers.get_reference(0).unwrap().as_str(), Str::new("stage 2 builds stage 3"))?;
    expect(Fixture::field(&plan, 1, Str::new("arguments")) == String::from_str(Str::new("build --no-incremental --build-dir=build/self/s3 --emit-llvm")), Str::new("stage 3's directory and IR"))?;
    expect(Fixture::field(&plan, 2, Str::new("program")).as_str() == plan.compilers.get_reference(1).unwrap().as_str(), Str::new("stage 3 builds stage 4"))?;
    expect(Fixture::field(&plan, 2, Str::new("arguments")) == String::from_str(Str::new("build --no-incremental --build-dir=build/self/s4 --emit-llvm")), Str::new("stage 4's directory and IR"))?;
    expect(Fixture::field(&plan, 2, Str::new("label")) == String::from_str(Str::new("compiler  via stage-3     ->  build/self/s4")), Str::new("the report's label"))?;
    expect(plan.linked && !plan.libraries_beside && plan.runner.is_empty(), Str::new("linked IR compared, run directly"))?;
    expect(plan.wiped.length() == 2 && plan.wiped.get_reference(1).unwrap().as_str().ends_with(".bin"), Str::new("the stdlib archives are wiped, so each stage builds its own"))?;
    return expect(plan.third.as_str() == plan.created.get_reference(0).unwrap().as_str() && plan.fourth.as_str() == plan.created.get_reference(1).unwrap().as_str(), Str::new("stages 3 and 4 are compared"));
}

![test]
function the_windows_arm_runs_under_wine_with_the_fetched_toolchain_named() -> Result<(), TestError> {
    const plan: ArmPlan = ArmPlan::windows(Path::from(Str::new("/r")), true);
    expect(Fixture::field(&plan, 1, Str::new("program")) == String::from_str(Str::new("wine")), Str::new("wine runs the stage compiler"))?;
    const expected: String = f"{plan.compilers.get_reference(0).unwrap().as_str()} build --no-incremental --build-dir=build/self/win-s3 --emit-llvm";
    expect(Fixture::field(&plan, 1, Str::new("arguments")) == expected, Str::new("the stage-2 compiler is wine's argument, then the build"))?;
    const joined: String = Fixture::field(&plan, 1, Str::new("variables"));
    expect(joined.as_str().contains("CRYO_CC=Z:") && joined.as_str().contains("llvm-mingw\\bin\\clang.exe"), Str::new("the C driver on the Z: drive, with backslashes"))?;
    expect(joined.as_str().contains("CRYO_STDLIB=Z:/r/stdlib"), Str::new("the stdlib on the Z: drive, with forward slashes"))?;
    expect(joined.as_str().contains("WINEDEBUG=-all") && joined.as_str().contains("CRYO_CLANG_RESOURCE_DIR=Z:"), Str::new("wine quiet, libclang's headers named"))?;
    expect(!plan.linked && plan.libraries_beside && plan.wiped.length() == 3, Str::new("per-module IR only, libraries beside, the three stage directories wiped"))?;
    const native: ArmPlan = ArmPlan::windows(Path::from(Str::new("/r")), false);
    expect(Fixture::field(&native, 0, Str::new("program")).as_str().ends_with("cryo.exe"), Str::new("natively the pin runs itself"))?;
    expect(native.variables.length() == 4, Str::new("four variables natively"))?;
    expect(native.variables.get_reference(0).unwrap().first.as_str() == Str::new("CRYO_STDLIB"), Str::new("the stdlib named"))?;
    expect(native.variables.get_reference(1).unwrap().first.as_str() == Str::new("CRYO_CC"), Str::new("the C driver named"))?;
    expect(native.variables.get_reference(2).unwrap().first.as_str() == Str::new("CRYO_AR"), Str::new("the archiver named"))?;
    expect(native.variables.get_reference(3).unwrap().first.as_str() == Str::new("PATH"), Str::new("the search path given"))?;
    for (entry in native.variables.get_reference(3).unwrap().second.as_str().split_nonempty(";")) {
        expect(!Path::from(entry).join(Str::new("LLVM-C.dll")).as_path().is_file(), f"{entry} supplies LLVM-C.dll".as_str())?;
        expect(!Path::from(entry).join(Str::new("libclang.dll")).as_path().is_file(), f"{entry} supplies libclang.dll".as_str())?;
    }
    for (variable in plan.variables.iterate_references()) {
        expect(variable.first.as_str() != Str::new("PATH"), Str::new("under wine the host's search path is not the stage's"))?;
    }
    return expect(Fixture::field(&native, 0, Str::new("arguments")) == String::from_str(Str::new("build --no-incremental --build-dir=build/self/win-s2")), Str::new("stage 2 goes below build/self"));
}

![test]
function the_search_path_loses_every_directory_supplying_the_library() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = Fixture::scratch()?;
    const root: Path = scratch.path();
    Fixture::put(root, Str::new("llvm/LLVM-C.dll"), Str::new("library"))?;
    Fixture::put(root, Str::new("other/LLVM-C.dll"), Str::new("library"))?;
    Fixture::put(root, Str::new("msys/libclang.dll"), Str::new("library"))?;
    Fixture::put(root, Str::new("msys/gcc.exe"), Str::new("driver"))?;
    Fixture::put(root, Str::new("compilers/gcc.exe"), Str::new("driver"))?;
    Fixture::put(root, Str::new("near/LLVM-C.dll.txt"), Str::new("not the library"))?;
    const llvm: PathBuf = root.join(Str::new("llvm"));
    const other: PathBuf = root.join(Str::new("other"));
    const msys: PathBuf = root.join(Str::new("msys"));
    const compilers: PathBuf = root.join(Str::new("compilers"));
    const near: PathBuf = root.join(Str::new("near"));
    const missing: PathBuf = root.join(Str::new("missing"));
    const search: String = f"{llvm.as_path().as_str()};{msys.as_path().as_str()};{compilers.as_path().as_str()};;{other.as_path().as_str()};{near.as_path().as_str()};{missing.as_path().as_str()}";
    mut libraries: Array<Str> = Array::<Str>::new();
    libraries.push(Str::new("LLVM-C.dll"));
    libraries.push(Str::new("libclang.dll"));
    const kept: String = LibrarySearch::search_path_without(search.as_str(), Str::new(";"), &libraries);
    const expected: String = f"{compilers.as_path().as_str()};{near.as_path().as_str()};{missing.as_path().as_str()}";
    return expect(kept == expected, f"kept {kept.as_str()}".as_str());
}

/// A stage's C driver is named by the absolute path the inherited search
/// path gives it - here a directory that supplies a library too, so it is
/// gone from the stage's own PATH - with `.exe` added to a bare name.
![test]
function a_program_is_named_by_the_first_directory_holding_it() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = Fixture::scratch()?;
    const root: Path = scratch.path();
    Fixture::put(root, Str::new("msys/libclang.dll"), Str::new("library"))?;
    Fixture::put(root, Str::new("msys/gcc.exe"), Str::new("driver"))?;
    Fixture::put(root, Str::new("later/gcc.exe"), Str::new("driver"))?;
    const msys: PathBuf = root.join(Str::new("msys"));
    const later: PathBuf = root.join(Str::new("later"));
    const missing: PathBuf = root.join(Str::new("missing"));
    const search: String = f"{missing.as_path().as_str()};{msys.as_path().as_str()};{later.as_path().as_str()}";
    const expected: String = String::from_str(msys.as_path().join(Str::new("gcc.exe")).as_path().as_str());
    expect(LibrarySearch::located(search.as_str(), Str::new("gcc")) == Option::Some(expected.clone()), Str::new("a bare name gains .exe"))?;
    expect(LibrarySearch::located(search.as_str(), Str::new("gcc.exe")) == Option::Some(expected), Str::new("a file name is found as it is"))?;
    expect(LibrarySearch::located(search.as_str(), Str::new("clang")).is_none(), Str::new("a name no directory holds"))?;
    return expect(LibrarySearch::located(search.as_str(), Str::new("C:/tools/gcc.exe")).is_none(), Str::new("a path is not looked up"));
}

![test]
function module_trees_compare_by_the_path_below_the_kind_directory() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = Fixture::scratch()?;
    const root: Path = scratch.path();
    Fixture::put(root, Str::new("a/target/release/host/local/ir/std/core/error.ll"), Str::new("one"))?;
    Fixture::put(root, Str::new("a/target/release/host/local/ir/std/io/error.ll"), Str::new("two"))?;
    Fixture::put(root, Str::new("a/target/release/host/local/obj/main.o"), Str::new("not compared"))?;
    // The other build resolved to another bucket; the key ignores it.
    Fixture::put(root, Str::new("b/target/release/triple/local/ir/std/core/error.ll"), Str::new("one"))?;
    Fixture::put(root, Str::new("b/target/release/triple/local/ir/std/io/error.ll"), Str::new("two"))?;
    const same: TreeComparison = ModuleTrees::compare(root.join(Str::new("a")).as_path(), root.join(Str::new("b")).as_path(), Str::new("ir"), Str::new(".ll"));
    expect(Fixture::described(&same) == String::from_str(Str::new("same 2 6")), Str::new("two modules, six bytes"))?;
    Fixture::put(root, Str::new("b/target/release/triple/local/ir/std/io/error.ll"), Str::new("TWO"))?;
    const differs: TreeComparison = ModuleTrees::compare(root.join(Str::new("a")).as_path(), root.join(Str::new("b")).as_path(), Str::new("ir"), Str::new(".ll"));
    expect(Fixture::described(&differs) == String::from_str(Str::new("differs std/io/error.ll")), Str::new("a shared file name, told apart by its path"))?;
    Fixture::put(root, Str::new("b/target/release/triple/local/ir/std/extra.ll"), Str::new("three"))?;
    const sets: TreeComparison = ModuleTrees::compare(root.join(Str::new("a")).as_path(), root.join(Str::new("b")).as_path(), Str::new("ir"), Str::new(".ll"));
    expect(Fixture::described(&sets) == String::from_str(Str::new("not comparable module sets differ (2 vs 3)")), Str::new("a module on one side only"))?;
    const missing: TreeComparison = ModuleTrees::compare(root.join(Str::new("a")).as_path(), root.join(Str::new("none")).as_path(), Str::new("ir"), Str::new(".ll"));
    expect(Fixture::described(&missing) == String::from_str(Str::new("not comparable no per-module .ll files found under ir/")), Str::new("a tree with no module"))?;
    Fixture::put(root, Str::new("a/target/release/other/local/ir/std/core/error.ll"), Str::new("one"))?;
    const twice: String = Fixture::described(&ModuleTrees::compare(root.join(Str::new("a")).as_path(), root.join(Str::new("b")).as_path(), Str::new("ir"), Str::new(".ll")));
    return expect(twice.as_str().starts_with("not comparable module std/core/error.ll is held twice"), Str::new("one key in two buckets is refused, not resolved by order"));
}

![test]
function stage_archives_agree_only_when_every_object_agrees() -> Result<(), TestError> {
    const equal: TemporaryDirectory = Fixture::scratch()?;
    const same: String = Fixture::stage_archives(equal.path(), Str::new("one"), Str::new("two"), Str::new("one"), Str::new("two"), Str::new("c2"), Str::new("c3"))?;
    expect(same == String::from_str(Str::new("same 2 6")), Str::new("equal objects"))?;
    const differ: TemporaryDirectory = Fixture::scratch()?;
    const differs: String = Fixture::stage_archives(differ.path(), Str::new("one"), Str::new("two"), Str::new("one"), Str::new("TWO"), Str::new("c2"), Str::new("c3"))?;
    expect(differs == String::from_str(Str::new("differs std/io/error.o")), Str::new("an object differs under equal IR"))?;
    const short: TemporaryDirectory = Fixture::scratch()?;
    const missing: String = Fixture::stage_archives(short.path(), Str::new("one"), Str::new("two"), Str::new("one"), Str::new(""), Str::new("c2"), Str::new("c3"))?;
    expect(missing.as_str().starts_with("not comparable module sets differ"), Str::new("an object missing"))?;
    const none: TemporaryDirectory = Fixture::scratch()?;
    const built_none: String = Fixture::stage_archives(none.path(), Str::new("one"), Str::new("two"), Str::new(""), Str::new(""), Str::new("c2"), Str::new("c3"))?;
    expect(built_none == String::from_str(Str::new("not comparable stage-2 built 1 stdlib archive(s) and stage-3 0; each builds its own")), Str::new("stage 3 built none"))?;
    const shared: TemporaryDirectory = Fixture::scratch()?;
    const one: String = Fixture::stage_archives(shared.path(), Str::new("one"), Str::new("two"), Str::new(""), Str::new(""), Str::new("c2"), Str::new("c2"))?;
    return expect(one == String::from_str(Str::new("shared")), Str::new("byte-identical stages share one archive"));
}

![test]
function the_digest_covers_the_mirrored_sources_in_path_order() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = Fixture::scratch()?;
    const root: Path = scratch.path();
    Fixture::put(root, Str::new("bin/cryo"), Str::new("pin"))?;
    Fixture::put(root, Str::new("compiler/a/b"), Str::new("1"))?;
    Fixture::put(root, Str::new("compiler/a-b"), Str::new("2"))?;
    // The fed order is the whole path's: `a-b` before `a/b`, where a
    // walk visiting `a` before `a-b` would feed them the other way.
    mut expected: Sha256 = Sha256::new();
    mut paths: Array<Pair<Str, Str>> = Array::<Pair<Str, Str>>::new();
    paths.push(Pair::new(Str::new("bin/cryo"), Str::new("pin")));
    paths.push(Pair::new(Str::new("compiler/a-b"), Str::new("2")));
    paths.push(Pair::new(Str::new("compiler/a/b"), Str::new("1")));
    for (entry in paths.iterate_references()) {
        mut header: String = String::from_str(entry.first);
        header.push_byte(0);
        expected.update(header.as_str().as_bytes());
        expected.update(Sha256::digest(entry.second.as_bytes()).as_bytes());
    }
    const first: TreeDigest = Fixture::digest(root)?;
    expect(first.files == 3, Str::new("three files"))?;
    expect(first.digest == expected.finish().to_hex(), Str::new("path, NUL and the file's digest, in whole-path order"))?;
    Fixture::put(root, Str::new("compiler/build/cryo"), Str::new("built"))?;
    Fixture::put(root, Str::new("stdlib/.bin/t/x.a"), Str::new("archive"))?;
    Fixture::put(root, Str::new("compiler/a/__pycache__/m.pyc"), Str::new("cache"))?;
    Fixture::put(root, Str::new("tests/t.cryo"), Str::new("not mirrored"))?;
    const skipped: TreeDigest = Fixture::digest(root)?;
    expect(skipped.digest == first.digest && skipped.files == 3, Str::new("build outputs, caches and unmirrored trees move nothing"))?;
    Fixture::put(root, Str::new("stdlib/build/kept.cryo"), Str::new("source"))?;
    const kept: TreeDigest = Fixture::digest(root)?;
    expect(kept.files == 4, Str::new("a skipped name is skipped only where it is listed"))?;
    Fixture::put(root, Str::new("compiler/a/b"), Str::new("x"))?;
    const changed: TreeDigest = Fixture::digest(root)?;
    return expect(changed.digest != kept.digest, Str::new("one changed byte moves the digest"));
}

![test]
function an_arm_that_did_not_run_fails_the_run_unless_allowed() -> Result<(), TestError> {
    mut both: Array<ArmStatus> = Array::<ArmStatus>::new();
    both.push(ArmStatus::Verified);
    both.push(ArmStatus::Verified);
    const passed: ArmsVerdict = Fixture::verdict(&both, false);
    expect(passed.exit == 0, Str::new("both verified"))?;
    expect(passed.lines.get_reference(passed.lines.length() - 1).unwrap().as_str() == Str::new("selfhost-check: OK -- 2 of 2 arms verified here"), Str::new("the verdict line"))?;
    mut declined: Array<ArmStatus> = Array::<ArmStatus>::new();
    declined.push(ArmStatus::Verified);
    declined.push(ArmStatus::Declined);
    expect(Fixture::verdict(&declined, false).exit == 0, Str::new("an arm another run answers for"))?;
    mut skipped: Array<ArmStatus> = Array::<ArmStatus>::new();
    skipped.push(ArmStatus::Verified);
    skipped.push(ArmStatus::Skipped);
    const refused: ArmsVerdict = Fixture::verdict(&skipped, false);
    expect(refused.exit == 1, Str::new("a skipped arm fails the run"))?;
    expect(Text::joined(&refused.lines, Str::new("\n")).as_str().contains("  windows: why"), Str::new("naming the arm and its reason"))?;
    expect(Fixture::verdict(&skipped, true).exit == 0, Str::new("unless the caller allowed it"))?;
    mut failed: Array<ArmStatus> = Array::<ArmStatus>::new();
    failed.push(ArmStatus::Failed);
    failed.push(ArmStatus::Skipped);
    return expect(Fixture::verdict(&failed, true).exit == 1, Str::new("a failure fails the run whatever is allowed"));
}

![test]
function the_fixed_point_needs_identical_ir_and_a_stage_four_that_answers_as_stage_three() -> Result<(), TestError> {
    const same: TreeComparison = TreeComparison::Same(TreeSize { modules: 274, bytes: 9 });
    const answer: Option<String> = Option::Some(String::from_str(Str::new("cryo version 1")));
    const linked: LinkedIr = LinkedIr::Same(String::from_str(Str::new("ab")), 4);
    const held: ArmJudgement = ArmJudge::fixed_point(Str::new("linux"), &linked, &same, &answer, &answer);
    const text: String = Text::joined(&held.lines, Str::new("\n"));
    expect(held.passed && held.reason == String::from_str(Str::new("274 modules byte-identical")), Str::new("identical IR, the same answer"))?;
    expect(text.as_str().contains("  FIXED POINT OK  linux stage-3 and stage-4 produce byte-identical IR"), Str::new("the line a run is counted by"))?;
    const nothing: Option<String> = Option::None;
    const silent: ArmJudgement = ArmJudge::fixed_point(Str::new("linux"), &linked, &same, &answer, &nothing);
    expect(!silent.passed && silent.reason == String::from_str(Str::new("linux stage-4 binary does not run")), Str::new("a stage 4 that does not run"))?;
    const other: Option<String> = Option::Some(String::from_str(Str::new("cryo version 2")));
    const disagree: ArmJudgement = ArmJudge::fixed_point(Str::new("windows"), &LinkedIr::NotCompared, &same, &answer, &other);
    expect(!disagree.passed && Text::joined(&disagree.lines, Str::new("\n")).as_str().contains("stage-3 says 'cryo version 1', stage-4 says 'cryo version 2'"), Str::new("two answers"))?;
    const differing: TreeComparison = TreeComparison::Differs(String::from_str(Str::new("std/io/error.ll")));
    const tree: ArmJudgement = ArmJudge::fixed_point(Str::new("linux"), &linked, &differing, &answer, &answer);
    expect(!tree.passed && Text::joined(&tree.lines, Str::new("\n")).as_str().contains("linked cryo.ll matches but per-module IR differs; first differing module: std/io/error.ll"), Str::new("the tree is compared whatever the linked file says"))?;
    const broken: ArmJudgement = ArmJudge::fixed_point(Str::new("linux"), &LinkedIr::Differs, &same, &answer, &answer);
    return expect(!broken.passed && broken.reason == String::from_str(Str::new("linux linked cryo.ll differs")), Str::new("a linked file that differs"));
}

![test]
function the_stage_archives_pass_shared_or_byte_identical_only() -> Result<(), TestError> {
    expect(ArmJudge::archives(Str::new("linux"), &ArchiveComparison::Shared).passed, Str::new("one archive, shared"))?;
    const same: ArchiveComparison = ArchiveComparison::Compared(TreeComparison::Same(TreeSize { modules: 2, bytes: 6 }));
    const held: ArmJudgement = ArmJudge::archives(Str::new("linux"), &same);
    expect(held.passed && held.lines.get_reference(0).unwrap().as_str().contains("STDLIB ARCHIVES OK  linux stage-2 and stage-3 built byte-identical stdlib objects (2 modules, 6 bytes)"), Str::new("identical objects"))?;
    const differs: ArchiveComparison = ArchiveComparison::Compared(TreeComparison::Differs(String::from_str(Str::new("std/io/error.o"))));
    expect(!ArmJudge::archives(Str::new("linux"), &differs).passed, Str::new("an object differs"))?;
    const missing: ArchiveComparison = ArchiveComparison::Compared(TreeComparison::NotComparable(String::from_str(Str::new("none"))));
    return expect(!ArmJudge::archives(Str::new("linux"), &missing).passed, Str::new("nothing to compare"));
}

![test]
function a_stage_compiler_is_asked_through_the_arms_runner() -> Result<(), TestError> {
    const wine: ArmPlan = ArmPlan::windows(Path::from(Str::new("/r")), true);
    mut arguments: Array<Str> = Array::<Str>::new();
    arguments.push(Str::new("--version"));
    const asked: Job = wine.compiler_job(Str::new("/r/s4/cryo.exe"), &arguments);
    expect(asked.command_line() == String::from_str(Str::new("wine /r/s4/cryo.exe --version")), Str::new("wine runs it"))?;
    expect(wine.pin.as_str().ends_with("cryo.exe"), Str::new("the Windows pin"))?;
    const native: ArmPlan = ArmPlan::linux(Path::from(Str::new("/r")));
    const direct: Job = native.compiler_job(Str::new("/r/s4/cryo"), &arguments);
    expect(direct.command_line().as_str().ends_with("cryo --version") && !direct.command_line().as_str().contains("wine"), Str::new("natively it runs itself"))?;
    return expect(native.pin.as_str().ends_with("cryo"), Str::new("the Linux pin"));
}

![test]
function the_wsl_copy_holds_the_mirrored_sources_less_their_build_outputs() -> Result<(), TestError> {
    const plan: MirrorPlan = MirrorPlan::new(Path::from(Str::new("C:/apps/cryo")), Str::new("/mnt/c/apps/cryo"));
    expect(plan.directory.as_str().starts_with("$HOME/.cache/cryo-selfhost/") && plan.directory.length() == 39, Str::new("one copy per checkout, twelve hex digits"))?;
    const other: MirrorPlan = MirrorPlan::new(Path::from(Str::new("C:/apps/other")), Str::new("/mnt/c/apps/other"));
    expect(other.directory != plan.directory, Str::new("another checkout, another copy"))?;
    const script: String = plan.preparation();
    const text: Str = script.as_str();
    const copy: Str = plan.directory.as_str();
    expect(text.contains(f"--exclude=/compiler/build/ --exclude=/stdlib/.bin/ --exclude=/runtime/.bin/ '/mnt/c/apps/cryo/compiler' '/mnt/c/apps/cryo/runtime' '/mnt/c/apps/cryo/stdlib' '/mnt/c/apps/cryo/scripts' {copy}/".as_str()), Str::new("the four trees, less their build outputs"))?;
    expect(text.contains(f"rsync -a '/mnt/c/apps/cryo/bin/cryo' {copy}/bin/cryo".as_str()), Str::new("the pin"))?;
    expect(text.contains("--delete --delete-excluded --exclude=__pycache__/"), Str::new("whatever the checkout does not hold is deleted"))?;
    expect(text.contains(f"--exclude=/CryoGate/build/ --exclude=.bin/ '/mnt/c/apps/cryo/tools/CryoGate' {copy}/tools/".as_str()), Str::new("cryogate's sources, its build kept"))?;
    expect(text.ends_with(f"cd {copy}/tools/CryoGate && ../../bin/cryo build && cd {copy} && tools/CryoGate/build/cryogate selfhost --digest".as_str()), Str::new("built by the copy's pin, the digest printed last"))?;
    expect(plan.arm(false) == f"cd {copy} && tools/CryoGate/build/cryogate selfhost --no-windows", Str::new("the arm declines the Windows arm"))?;
    return expect(plan.arm(true).as_str().ends_with(" --no-windows --allow-skipped-arm"), Str::new("and passes the allowance on"));
}

/// The freestanding check from a Windows host builds the tree's compiler in
/// the copy with the copy's pin, and runs the check with that compiler.
![test]
function the_freestanding_check_in_the_copy_uses_the_compiler_built_there() -> Result<(), TestError> {
    const plan: MirrorPlan = MirrorPlan::new(Path::from(Str::new("C:/apps/cryo")), Str::new("/mnt/c/apps/cryo"));
    const copy: Str = plan.directory.as_str();
    expect(plan.freestanding(false) == f"cd {copy}/compiler && ../bin/cryo build && cd {copy} && tools/CryoGate/build/cryogate freestanding --cryo compiler/build/cryo",
           plan.freestanding(false).as_str())?;
    return expect(plan.freestanding(true).as_str().ends_with(" --cryo compiler/build/cryo --allow-skipped-arm"), Str::new("the allowance is passed on"));
}

![test]
function the_copys_digest_is_its_last_digest_line() -> Result<(), TestError> {
    const digest: Str = Str::new("4beb3ef409ba16bca4bc9af07b37891da0fabb0a40df32545bc32edcc3f2d69f");
    const output: String = f"Building cryogate\n{digest}  (400 files)\r\n";
    expect(MirrorPlan::reported(output.as_str()) == Option::Some(String::from_str(digest)), Str::new("the digest line, CRLF and all"))?;
    const upper: String = f"{digest.byte_substring(0, 63)}F  (400 files)\nCompiled";
    expect(MirrorPlan::reported(upper.as_str()).is_none(), Str::new("not lowercase hex, and the line is not the last"))?;
    return expect(MirrorPlan::reported(Str::new("error: cannot build\n")).is_none(), Str::new("a copy that printed no digest"));
}
