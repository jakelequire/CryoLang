///! The baseline's listings and keys: what git lists, the files a project's
///! cryoconfig reaches outside its directory, and the record keys.
![config(testing)]
namespace cryogate::tests::baseline;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::fs::path::{ Path, PathBuf };
import std::fs::temporary::{ TemporaryDirectory };
import std::test::error::{ TestError };
import std::test::assert::{ expect };

import std::collections::pair::{ Pair };
import std::fs::directory::{ Directory };
import std::fs::file::{ File };

import cryogate::baseline::cache::{ BaselineCache };
import cryogate::baseline::keys::{ BaselineKey, CompilerIdentity, HostToolchain, Program, ProgramKeys, ProgramStdlib };
import cryogate::baseline::listing::{ Listing };
import cryogate::core::text::{ Text };
import cryogate::core::git::{ Git };
import cryogate::core::host::{ Host };
import cryogate::core::log::{ RunLogs };

![test]
function git_s_listing_is_split_on_the_nul_byte() -> Result<(), TestError> {
    mut text: String = String::from_str(Str::new("a.cryo"));
    text.push_byte(0);
    text.append(Str::new("b/c d.cryo"));
    text.push_byte(0);
    text.push_byte(0);
    const entries: Array<String> = Listing::entries(text.as_str());
    expect(entries.length() == 2, Str::new("two entries, the empty one dropped"))?;
    expect(entries.get_reference(1).unwrap().as_str() == Str::new("b/c d.cryo"), Str::new("a space is part of a name"))?;
    return expect(Listing::entries(Str::new("one")).length() == 1, Str::new("text with no NUL is one entry"));
}

![test]
function a_quoted_value_runs_from_one_quote_to_the_next() -> Result<(), TestError> {
    const values: Array<String> = Listing::quoted(Str::new("x = \"a\"\ny = \"\" z \"b"));
    expect(values.length() == 2, Str::new("an empty pair is no value, and its second quote opens the next"))?;
    expect(values.get_reference(0).unwrap().as_str() == Str::new("a"), Str::new("the first value"))?;
    return expect(values.get_reference(1).unwrap().as_str() == Str::new(" z "), Str::new("the run after the empty pair"));
}

![test]
function a_value_is_read_as_a_path_from_the_project_directory() -> Result<(), TestError> {
    expect(Listing::within(Str::new("tests/p"), Str::new("../q/shelf")) == Option::Some(String::from_str(Str::new("tests/q/shelf"))), Str::new("a sibling"))?;
    expect(Listing::within(Str::new("tests/p"), Str::new("./src")) == Option::Some(String::from_str(Str::new("tests/p/src"))), Str::new("inside"))?;
    expect(Listing::within(Str::new("p"), Str::new("..")).is_none(), Str::new("the checkout's root is not a reached path"))?;
    expect(Listing::within(Str::new("p"), Str::new("../..")).is_none(), Str::new("above the root"))?;
    expect(Listing::within(Str::new("p"), Str::new("/usr/lib")).is_none(), Str::new("absolute"))?;
    return expect(Listing::within(Str::new("p"), Str::new("C:/lib")).is_none(), Str::new("absolute, with a drive"));
}

![test]
function the_most_recently_used_baselines_are_kept_ties_by_name() -> Result<(), TestError> {
    mut homes: Array<Pair<String, i64>> = Array::<Pair<String, i64>>::new();
    homes.push(Pair::new(String::from_str(Str::new("a")), 0));
    homes.push(Pair::new(String::from_str(Str::new("b")), 30));
    homes.push(Pair::new(String::from_str(Str::new("c")), 20));
    homes.push(Pair::new(String::from_str(Str::new("d")), 30));
    homes.push(Pair::new(String::from_str(Str::new("e")), 10));
    const three: Array<String> = BaselineCache::kept(&homes, 3, Str::new(""));
    expect(Text::joined(&three, Str::new(",")) == String::from_str(Str::new("b,d,c")), Str::new("newest first, a tie by name"))?;
    const current: Array<String> = BaselineCache::kept(&homes, 3, Str::new("a"));
    expect(Text::joined(&current, Str::new(",")) == String::from_str(Str::new("a,b,d")), Str::new("the home in use first, within the count, whatever its stamp"))?;
    const all: Array<String> = BaselineCache::kept(&homes, 10, Str::new(""));
    return expect(Text::joined(&all, Str::new(",")) == String::from_str(Str::new("b,d,c,e,a")), Str::new("a never-stamped home counts as oldest"));
}

![test]
function pruning_leaves_the_kept_count_of_baselines() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = match (TemporaryDirectory::create()) {
        Result::Ok(directory) => { directory }
        Result::Err(error)    => { return Result::Err(TestError::other(error.describe())); }
    };
    mut index: i64 = 0;
    while (index < BaselineCache::KEPT + 2) {
        const home: PathBuf = scratch.path().join(f"h{index}".as_str());
        match (Directory::create(home.as_path())) {
            Result::Ok(_)      => { }
            Result::Err(error) => { return Result::Err(TestError::other(error.describe())); }
        }
        index++;
    }
    const newest: PathBuf = scratch.path().join(f"h{BaselineCache::KEPT + 1}".as_str());
    match (BaselineCache::mark(newest.as_path())) {
        Result::Ok(_)       => { }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    }
    const deleted: Array<String> = match (BaselineCache::prune(scratch.path(), Str::new(""))) {
        Result::Ok(deleted) => { deleted }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    expect(deleted.length() == 2, Str::new("two over the bound"))?;
    expect(newest.as_path().is_directory(), Str::new("the one just used survives"))?;
    return expect(!scratch.path().join(f"h{BaselineCache::KEPT}".as_str()).as_path().exists(), Str::new("an unstamped home sorting last goes"));
}

![test]
function a_projects_inputs_hold_the_package_its_cryoconfig_reaches_by_path() -> Result<(), TestError> {
    const root: PathBuf = match (Host::repository()) {
        Result::Ok(root)    => { root }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    // git's logs go to scratch: a run directory under the checkout's
    // build-logs would prune the checkout's own.
    const scratch: TemporaryDirectory = match (TemporaryDirectory::create()) {
        Result::Ok(directory) => { directory }
        Result::Err(error)    => { return Result::Err(TestError::other(error.describe())); }
    };
    const logs: RunLogs = match (RunLogs::open(scratch.path())) {
        Result::Ok(logs)    => { logs }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    const git: Git = Git::new(root.as_path(), &logs);
    mut seen: Array<String> = Array::<String>::new();
    const reached: Array<String> = match (Listing::reached_outside(root.as_path(), &git,
            Str::new("tests/tests/projects/visibility_internal_names"), &seen)) {
        Result::Ok(files)   => { files }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    mut shelf: i64 = 0;
    for (file in reached.iterate_references()) {
        if (file.as_str().starts_with(&Str::new("tests/tests/projects/visibility_internal/shelf/"))) { shelf++; }
    }
    expect(shelf > 0, Str::new("the shelf package's files"))?;
    return expect(shelf == reached.length(), Str::new("nothing else: its own directory is not outside it"));
}

/// The record keys over the checkout `root` for a compiler, a runtime and
/// one program written in `scratch`, the programs built against `stdlib`:
/// the program's key.
private type struct StdlibKeys {
    private static of(root: Path, git: &Git, scratch: Path, stdlib: &ProgramStdlib) -> Result<String, TestError> {
        const compiler: PathBuf = scratch.join(Str::new("cryo"));
        const runtime: PathBuf = scratch.join(Str::new("runtime"));
        StdlibKeys::written(runtime.join(Str::new("lib.cryo")).as_path(), Str::new("runtime"))?;
        StdlibKeys::written(compiler.as_path(), Str::new("compiler"))?;
        mut programs: Array<Program> = Array::<Program>::new();
        programs.push(Program { name: String::from_str(Str::new("p")), files: Array::<String>::new() });
        const toolchain: HostToolchain = HostToolchain { digest: String::from_str(Str::new("host")) };
        return match (ProgramKeys::of(root, git, compiler.as_path(), runtime.as_path(), stdlib, &toolchain, &programs)) {
            Result::Ok(keys)    => { Result::Ok(keys[0].second.clone()) }
            Result::Err(reason) => { Result::Err(TestError::other(reason.as_str())) }
        };
    }

    /// `text` written to `path`, its directory made first.
    private static written(path: Path, text: Str) -> Result<(), TestError> {
        match (path.parent()) {
            Option::Some(parent) => {
                match (Directory::create_all(parent)) {
                    Result::Ok(_)      => { }
                    Result::Err(error) => { return Result::Err(TestError::other(error.describe())); }
                }
            }
            Option::None         => { }
        }
        return match (File::write_text(path, text)) {
            Result::Ok(_)      => { Result::Ok(()) }
            Result::Err(error) => { Result::Err(TestError::other(error.describe())) }
        };
    }
}

![test]
function a_record_key_reads_which_stdlib_the_programs_build_against_and_its_text() -> Result<(), TestError> {
    const root: PathBuf = match (Host::repository()) {
        Result::Ok(root)    => { root }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    const scratch: TemporaryDirectory = match (TemporaryDirectory::create()) {
        Result::Ok(directory) => { directory }
        Result::Err(error)    => { return Result::Err(TestError::other(error.describe())); }
    };
    const logs: RunLogs = match (RunLogs::open(scratch.path().join(Str::new("logs")).as_path())) {
        Result::Ok(logs)    => { logs }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    const git: Git = Git::new(root.as_path(), &logs);
    const home: PathBuf = scratch.path().join(Str::new("home"));
    const library: PathBuf = home.join(Str::new("stdlib/lib.cryo"));
    StdlibKeys::written(library.as_path(), Str::new("namespace std;"))?;
    const own: ProgramStdlib = ProgramStdlib::of_home(home.as_path());
    const own_key: String = StdlibKeys::of(root.as_path(), &git, scratch.path(), &own)?;
    expect(StdlibKeys::of(root.as_path(), &git, scratch.path(), &own)? == own_key, Str::new("the same stdlib reads the same"))?;
    // The same files as the checkout's: a record made against the
    // baseline's stdlib is never read for a run against the checkout's.
    const same_text: ProgramStdlib = ProgramStdlib { directory: home.join(Str::new("stdlib")), from_baseline: false };
    expect(StdlibKeys::of(root.as_path(), &git, scratch.path(), &same_text)? != own_key, Str::new("the stdlib's origin"))?;
    expect(StdlibKeys::of(root.as_path(), &git, scratch.path(), &ProgramStdlib::of_checkout(root.as_path()))? != own_key,
        Str::new("the checkout's stdlib"))?;
    StdlibKeys::written(home.join(Str::new("stdlib/.bin/archive.a")).as_path(), Str::new("built"))?;
    expect(StdlibKeys::of(root.as_path(), &git, scratch.path(), &own)? == own_key, Str::new("its build outputs are no input"))?;
    StdlibKeys::written(library.as_path(), Str::new("namespace std; "))?;
    return expect(StdlibKeys::of(root.as_path(), &git, scratch.path(), &own)? != own_key, Str::new("the stdlib's text"));
}

![test]
function a_baseline_built_against_its_own_stdlib_has_a_home_of_its_own() -> Result<(), TestError> {
    const root: PathBuf = match (Host::repository()) {
        Result::Ok(root)    => { root }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    const scratch: TemporaryDirectory = match (TemporaryDirectory::create()) {
        Result::Ok(directory) => { directory }
        Result::Err(error)    => { return Result::Err(TestError::other(error.describe())); }
    };
    const logs: RunLogs = match (RunLogs::open(scratch.path())) {
        Result::Ok(logs)    => { logs }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    const git: Git = Git::new(root.as_path(), &logs);
    const checkout: Result<String, String> = BaselineKey::of(root.as_path(), &git, Str::new("HEAD"), false);
    const own: Result<String, String> = BaselineKey::of(root.as_path(), &git, Str::new("HEAD"), true);
    expect(checkout.is_ok() && own.is_ok(), Str::new("both keys"))?;
    return expect(checkout.unwrap() != own.unwrap(), Str::new("the stdlib's origin"));
}

/// A compiler binary's bytes, made by hand: a PE header whose signature is
/// at 128, and stamp markers at 400, 1000, ... with their text after them.
private type struct Binary {
    private static made(markers: i64) -> Array<u8> {
        mut bytes: Array<u8> = Array::<u8>::new();
        while (bytes.length() < 2048) { bytes.push(7); }
        // `MZ`, and at 128 `PE`.
        bytes[0] = 77;
        bytes[1] = 90;
        bytes[60] = 128;
        bytes[61] = 0;
        bytes[62] = 0;
        bytes[63] = 0;
        bytes[128] = 80;
        bytes[129] = 69;
        bytes[130] = 0;
        bytes[131] = 0;
        const marker: Str = Str::new("CRYO-BUILD-STAMP");
        mut placed: i64 = 0;
        while (placed < markers) {
            const at: i64 = 400 + placed * 600;
            for (offset in 0..marker.length()) { bytes[at + offset] = marker.byte_at(offset).unwrap(); }
            placed++;
        }
        return bytes;
    }

    /// The identity of `bytes` with the byte at `at` changed.
    private static changed_at(bytes: &Array<u8>, at: i64) -> String {
        mut changed: Array<u8> = bytes.clone();
        changed[at] = changed[at] + 1;
        return CompilerIdentity::digest(changed);
    }
}

![test]
function a_compilers_identity_reads_its_stamp_link_time_and_checksum_as_zeros() -> Result<(), TestError> {
    const bytes: Array<u8> = Binary::made(1);
    const identity: String = CompilerIdentity::digest(bytes.clone());
    // The link time is 8 bytes past the signature, the checksum 88, and the
    // stamp text the 496 bytes after the marker's 16.
    expect(Binary::changed_at(&bytes, 136) == identity, Str::new("the link time's first byte"))?;
    expect(Binary::changed_at(&bytes, 139) == identity, Str::new("the link time's last byte"))?;
    expect(Binary::changed_at(&bytes, 216) == identity, Str::new("the checksum's first byte"))?;
    expect(Binary::changed_at(&bytes, 219) == identity, Str::new("the checksum's last byte"))?;
    expect(Binary::changed_at(&bytes, 416) == identity, Str::new("the stamp text's first byte"))?;
    expect(Binary::changed_at(&bytes, 911) == identity, Str::new("the stamp text's last byte"))?;
    expect(Binary::changed_at(&bytes, 135) != identity, Str::new("the byte before the link time"))?;
    expect(Binary::changed_at(&bytes, 140) != identity, Str::new("the byte after the link time"))?;
    expect(Binary::changed_at(&bytes, 215) != identity, Str::new("the byte before the checksum"))?;
    expect(Binary::changed_at(&bytes, 220) != identity, Str::new("the byte after the checksum"))?;
    expect(Binary::changed_at(&bytes, 415) != identity, Str::new("the marker's last byte"))?;
    expect(Binary::changed_at(&bytes, 912) != identity, Str::new("the byte after the stamp text"))?;
    return expect(Binary::changed_at(&bytes, 2000) != identity, Str::new("a byte of code"));
}

![test]
function a_binary_with_two_stamp_markers_has_its_stamp_read_as_it_is() -> Result<(), TestError> {
    const bytes: Array<u8> = Binary::made(2);
    const identity: String = CompilerIdentity::digest(bytes.clone());
    expect(Binary::changed_at(&bytes, 500) != identity, Str::new("no single region: the first marker's text counts"))?;
    return expect(Binary::changed_at(&bytes, 136) == identity, Str::new("the link time is still read as zeros"));
}

![test]
function the_host_toolchain_reads_the_libraries_beside_the_pins() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = match (TemporaryDirectory::create()) {
        Result::Ok(directory) => { directory }
        Result::Err(error)    => { return Result::Err(TestError::other(error.describe())); }
    };
    const bin: PathBuf = scratch.path().join(Str::new("bin"));
    match (Directory::create(bin.as_path())) {
        Result::Ok(_)      => { }
        Result::Err(error) => { return Result::Err(TestError::other(error.describe())); }
    }
    const library: PathBuf = bin.join(Str::new("LLVM-C.dll"));
    Toolchains::write(library.as_path(), Str::new("one"))?;
    const first: String = Toolchains::digest(scratch.path())?;
    expect(Toolchains::digest(scratch.path())? == first, Str::new("the same host reads the same"))?;
    Toolchains::write(library.as_path(), Str::new("two"))?;
    const second: String = Toolchains::digest(scratch.path())?;
    expect(second != first, Str::new("a library's bytes"))?;
    Toolchains::write(bin.join(Str::new("notes.txt")).as_path(), Str::new("x"))?;
    return expect(Toolchains::digest(scratch.path())? == second, Str::new("a file that is no library is git's to list"));
}

/// The host toolchain of a scratch checkout, and the files written into it.
private type struct Toolchains {
    private static write(path: Path, text: Str) -> Result<(), TestError> {
        return match (File::write_text(path, text)) {
            Result::Ok(_)      => { Result::Ok(()) }
            Result::Err(error) => { Result::Err(TestError::other(error.describe())) }
        };
    }

    private static digest(repository: Path) -> Result<String, TestError> {
        return match (HostToolchain::of(repository)) {
            Result::Ok(toolchain) => { Result::Ok(toolchain.digest.clone()) }
            Result::Err(reason)   => { Result::Err(TestError::other(reason.as_str())) }
        };
    }
}
