///! The core's decisions: what an outcome is called, when a lock is stale
///! and where it lives, which host a target gate includes, the error codes
///! a child's output holds.
![config(testing)]
namespace cryogate::tests::core;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::result::{ Result };
import std::fs::directory::{ Directory };
import std::fs::file::{ File };
import std::fs::path::{ PathBuf };
import std::fs::temporary::{ TemporaryDirectory };
import std::process;
import std::process::child::{ Child };
import std::process::command::{ Command };
import std::test::error::{ TestError };
import std::test::assert::{ expect, expect_false };

import cryogate::core::child::{ Outcome };
import cryogate::core::host::{ Host };
import cryogate::core::lock::{ HeavyLock };
import cryogate::core::text::{ Text };

/// An error code is `E`, exactly four digits and `]`; each is read in the
/// order written, as often as it appears, and a warning's is not one.
![test]
function an_error_code_is_four_digits_closed_by_a_bracket() -> Result<(), TestError> {
    const codes: String = Text::joined(&Text::error_codes(Str::new("error[E0201]: a\nerror[E12]: b\nerror[E1234 c\nerror[E12345]: d\nwarning[W0001]: e\nerror[E0900]: f\nerror[E0201]: g\n")), Str::new(" "));
    return expect(codes.as_str() == Str::new("E0201 E0900 E0201"), codes.as_str());
}

/// The compiler that builds cryogate keeps a list a call returns alive for
/// the whole loop that walks it; one that released it before the body
/// would have the loop read freed elements.
![test]
function a_loop_over_a_list_a_call_returns_reads_every_element() -> Result<(), TestError> {
    mut matched: i64 = 0;
    mut walked: i64 = 0;
    for (line in Text::lines(Str::new("the first line of the list\nthe second line of the list\nthe third line of the list")).iterate_references()) {
        walked++;
        if (line.as_str().contains(&Str::new("line of the list"))) { matched++; }
    }
    expect(walked == 3, Str::new("the loop walks all three lines"))?;
    return expect(matched == 3, Str::new("every line still holds its text inside the loop"));
}

![test]
function only_exit_zero_succeeds() -> Result<(), TestError> {
    expect(Outcome::Exited(0).succeeded(), Str::new("exit 0"))?;
    expect_false(Outcome::Exited(1).succeeded(), Str::new("exit 1"))?;
    expect_false(Outcome::Signalled(9).succeeded(), Str::new("a signal"))?;
    expect_false(Outcome::TimedOut.succeeded(), Str::new("a timeout"))?;
    expect_false(Outcome::OutputLost(String::new()).succeeded(), Str::new("output lost"))?;
    return expect_false(Outcome::CouldNotStart(String::new()).succeeded(), Str::new("never started"));
}

![test]
function outcomes_are_named_for_the_report() -> Result<(), TestError> {
    expect(Outcome::Exited(3).describe().as_str() == Str::new("exit 3"), Str::new("exit"))?;
    expect(Outcome::Signalled(9).describe().as_str() == Str::new("signal 9"), Str::new("signal"))?;
    expect(Outcome::TimedOut.describe().as_str() == Str::new("timed out"), Str::new("timeout"))?;
    expect(Outcome::OutputLost(String::from_str(Str::new("full"))).describe().as_str() == Str::new("output lost: full"), Str::new("output lost"))?;
    return expect(Outcome::CouldNotStart(String::from_str(Str::new("gone"))).describe().as_str() == Str::new("could not start: gone"), Str::new("never started"));
}

![test]
function a_lock_goes_stale_after_three_hours() -> Result<(), TestError> {
    expect_false(HeavyLock::is_stale(1000, 1000), Str::new("just written"))?;
    expect_false(HeavyLock::is_stale(1000, 1000 + 3 * 3600), Str::new("exactly three hours"))?;
    return expect(HeavyLock::is_stale(1000, 1001 + 3 * 3600), Str::new("past three hours"));
}

![test]
function a_lock_names_its_holders_process_and_a_hand_made_one_names_none() -> Result<(), TestError> {
    const taken: Str = Str::new("cryogate in C:\\checkout - cryogate.exe smith-reduce --seed 35 - pid 4242 - started 2026-11-20T03:06:08Z");
    expect(HeavyLock::holder_process(taken).unwrap() == 4242, Str::new("the pid after ` - pid `"))?;
    expect(HeavyLock::holder_process(Str::new("taken by hand - started 2026-11-20T03:06:08Z")).is_none(), Str::new("no pid named"))?;
    return expect(HeavyLock::holder_process(Str::new("x - pid  - started")).is_none(), Str::new("no digits after the marker"));
}

/// A lock in a scratch directory naming the process `pid` as its holder.
private function lock_held_by(scratch: &TemporaryDirectory, pid: i32) -> Result<PathBuf, TestError> {
    const lock: PathBuf = scratch.path().join(Str::new("cryo-heavy-run.lock"));
    const text: String = f"cryogate in C:\\checkout - cryogate.exe smith-reduce --text --seed 35 - pid {pid} - started 2026-11-20T03:06:08Z\n";
    expect(File::write_text(lock.as_path(), text.as_str()).is_ok(), Str::new("lock written"))?;
    return Result::Ok(lock);
}

![test]
function a_lock_whose_holder_is_no_longer_running_is_taken_over() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = match (TemporaryDirectory::create()) {
        Result::Ok(directory) => { directory }
        Result::Err(error)    => { return Result::Err(TestError::other(error.describe())); }
    };
    // A process that has exited: its id names nothing running.
    mut child: Child = match (Command::new(Str::new("git")).argument(Str::new("--version")).spawn()) {
        Result::Ok(child)  => { child }
        Result::Err(error) => { return Result::Err(TestError::other(error.describe())); }
    };
    expect(child.wait().is_ok(), Str::new("the child exited"))?;
    expect_false(Host::process_running(child.id()), Str::new("an exited process is not running"))?;
    const lock: PathBuf = lock_held_by(&scratch, child.id())?;
    const taken: Result<HeavyLock, String> = HeavyLock::acquire(lock.as_path(), Str::new("cryogate test"), false);
    expect(taken.is_ok(), Str::new("the abandoned lock is taken over"))?;
    const now: String = match (File::read_text(lock.as_path())) {
        Result::Ok(text)   => { text }
        Result::Err(error) => { return Result::Err(TestError::other(error.describe())); }
    };
    return expect(HeavyLock::holder_process(now.as_str()).unwrap() == process::id(), now.as_str());
}

![test]
function a_lock_whose_holder_is_running_is_held() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = match (TemporaryDirectory::create()) {
        Result::Ok(directory) => { directory }
        Result::Err(error)    => { return Result::Err(TestError::other(error.describe())); }
    };
    expect(Host::process_running(process::id()), Str::new("this process is running"))?;
    const lock: PathBuf = lock_held_by(&scratch, process::id())?;
    return expect(HeavyLock::acquire(lock.as_path(), Str::new("cryogate test"), false).is_err(), Str::new("a running holder's lock is not taken"));
}

/// A main checkout `apps/main` and a linked worktree made somewhere else,
/// `apps/elsewhere/linked`, laid out as git lays them out: the worktree's
/// `.git` file names its directory under the store, whose `commondir` leads
/// back to the store.
![test]
function every_worktree_takes_the_lock_beside_the_main_checkout() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = match (TemporaryDirectory::create()) {
        Result::Ok(directory) => { directory }
        Result::Err(error)    => { return Result::Err(TestError::other(error.describe())); }
    };
    const apps: PathBuf = match (scratch.path().canonicalize()) {
        Result::Ok(path)   => { path }
        Result::Err(error) => { return Result::Err(TestError::other(error.describe())); }
    };
    const main: PathBuf = apps.join(Str::new("main"));
    const linked: PathBuf = apps.join(Str::new("elsewhere")).as_path().join(Str::new("linked"));
    const store_entry: PathBuf = main.join(Str::new(".git/worktrees/linked"));
    expect(Directory::create_all(store_entry.as_path()).is_ok(), Str::new("store entry made"))?;
    expect(Directory::create_all(linked.as_path()).is_ok(), Str::new("worktree made"))?;
    expect(File::write_text(store_entry.join(Str::new("commondir")).as_path(), Str::new("../..\n")).is_ok(), Str::new("commondir written"))?;
    const marker: String = f"gitdir: {store_entry.as_path().as_str()}\n";
    expect(File::write_text(linked.join(Str::new(".git")).as_path(), marker.as_str()).is_ok(), Str::new("worktree marker written"))?;

    const expected: PathBuf = apps.join(Str::new("cryo-heavy-run.lock"));
    const from_main: PathBuf = match (Host::main_checkout(main.as_path())) {
        Result::Ok(path)    => { path }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    const from_linked: PathBuf = match (Host::main_checkout(linked.as_path())) {
        Result::Ok(path)    => { path }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    expect(from_main.as_path().as_str() == main.as_path().as_str(), Str::new("the main checkout is its own"))?;
    expect(from_linked.as_path().as_str() == main.as_path().as_str(), Str::new("the worktree leads to the main checkout"))?;
    const lock: PathBuf = match (HeavyLock::beside(from_linked.as_path())) {
        Result::Ok(path)    => { path }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    return expect(lock.as_path().as_str() == expected.as_path().as_str(), Str::new("the lock is beside the main checkout"));
}

![test]
function a_worktree_marker_without_gitdir_is_refused() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = match (TemporaryDirectory::create()) {
        Result::Ok(directory) => { directory }
        Result::Err(error)    => { return Result::Err(TestError::other(error.describe())); }
    };
    expect(File::write_text(scratch.path().join(Str::new(".git")).as_path(), Str::new("not a marker\n")).is_ok(), Str::new("marker written"))?;
    return expect(Host::main_checkout(scratch.path()).is_err(), Str::new("a .git file with no gitdir line"));
}

![test]
function unix_names_every_posix_host() -> Result<(), TestError> {
    expect(Host::builds_target(Host::os()), Str::new("this host's own name"))?;
    if (Host::os() == Str::new("windows")) {
        expect_false(Host::builds_target(Str::new("unix")), Str::new("unix on windows"))?;
        return expect_false(Host::builds_target(Str::new("linux")), Str::new("linux on windows"));
    }
    expect(Host::builds_target(Str::new("unix")), Str::new("unix on a POSIX host"))?;
    return expect_false(Host::builds_target(Str::new("windows")), Str::new("windows on a POSIX host"));
}
