///! The language server checks' decisions: framing, positions and URIs,
///! fixture markers, a server build's report, and the judgements of answers.
![config(testing)]
namespace cryogate::tests::lsp;

import std::collections::array::{ Array };
import std::collections::pair::{ Pair };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::fs::directory::{ Directory };
import std::fs::file::{ File };
import std::fs::path::{ Path, PathBuf };
import std::fs::temporary::{ TemporaryDirectory };
import std::encoding::json::parser;
import std::encoding::json::value::{ JsonValue };
import std::test::error::{ TestError };
import std::test::assert::{ expect };

import cryogate::lsp::build::{ LspBuild };
import cryogate::lsp::fixture::{ Fixture };
import cryogate::lsp::judges::{ Judgement, Judges };
import cryogate::lsp::wire::{ FrameBuffer, Frames, Locations, Position };

type struct Parsed {
    /// `text` parsed, or a test error naming it.
    private static of(text: Str) -> Result<JsonValue, TestError> {
        return match (parser::parse(text)) {
            Result::Ok(value) => { Result::Ok(value) }
            Result::Err(_)    => { Result::Err(TestError::other(f"not JSON: {text}".as_str())) }
        };
    }
}

/// Bodies come out whole however the bytes are cut, the header's name in
/// any case; a header block with no length ends the stream.
![test]
function a_frame_buffer_cuts_bodies_out_of_arbitrary_pieces() -> Result<(), TestError> {
    const one: String = Frames::framed(Str::new("{\"id\":1}"));
    const two: String = f"content-LENGTH: 8\r\nContent-Type: x\r\n\r\n{{\"id\":2}}";
    const stream: String = f"{one.as_str()}{two.as_str()}";
    mut buffer: FrameBuffer = FrameBuffer::new();
    mut bodies: Array<String> = Array::<String>::new();
    for (mut at: i64 = 0; at < stream.length(); at = at + 5) {
        const end: i64 = if (at + 5 < stream.length()) { at + 5 } else { stream.length() };
        buffer.push(stream.as_str().byte_substring(at, end).as_bytes());
        loop {
            match (buffer.next()) {
                Result::Ok(Option::Some(body)) => { bodies.push(body); }
                Result::Ok(Option::None)       => { break; }
                Result::Err(reason)            => { return Result::Err(TestError::other(reason.as_str())); }
            }
        }
    }
    expect(bodies.length() == 2, f"{bodies.length()} bodies".as_str())?;
    expect(bodies.get_reference(0).unwrap().as_str() == Str::new("{\"id\":1}"), Str::new("the first body"))?;
    expect(bodies.get_reference(1).unwrap().as_str() == Str::new("{\"id\":2}"), Str::new("the second, its header in another case"))?;
    mut broken: FrameBuffer = FrameBuffer::new();
    broken.push(Str::new("Content-Type: x\r\n\r\n{}").as_bytes());
    return expect(broken.next().is_err(), Str::new("no length is an error"));
}

/// A column counts UTF-16 units: a character outside the basic plane is
/// two of them; lines are counted by `\n`.
![test]
function a_position_counts_lines_and_utf16_units() -> Result<(), TestError> {
    const text: Str = Str::new("ab\n\u{e9}\u{1F600}x");
    const at: i64 = text.find(&Str::new("x")).unwrap();
    const position: Position = Locations::position_of(text, at);
    expect(position.line == 1, f"line {position.line}".as_str())?;
    return expect(position.character == 3, f"column {position.character}".as_str());
}

/// A drive colon escaped or not, and the letters' case, name one file.
![test]
function two_spellings_of_one_uri_are_the_same_file() -> Result<(), TestError> {
    expect(Locations::same_uri(Str::new("file:///C%3A/Work/A.cryo"), Str::new("file:///c:/work/a.cryo")), Str::new("escaped colon, upper case"))?;
    expect(!Locations::same_uri(Str::new("file:///c:/work/a.cryo"), Str::new("file:///c:/work/b.cryo")), Str::new("another file"))?;
    return expect(Locations::position_key(Str::new("file:///C%3A/w/Main.cryo"), 3, 4) == String::from_str(Str::new("main.cryo:3:4")), Str::new("the key is the file name and start"));
}

/// `/*@name*/` names the character after the comment, `/*^name*/` the
/// comment's start; a comment with no name is no marker.
![test]
function markers_name_the_place_after_or_at_the_comment() -> Result<(), TestError> {
    const text: Str = Str::new("a./*^dot*/b /*@word*/word /*@*/ /*@x*/");
    const found: Array<Pair<String, i64>> = Fixture::find_markers(text);
    expect(found.length() == 3, f"{found.length()} markers".as_str())?;
    expect(found.get_reference(0).unwrap().first.as_str() == Str::new("dot") && found.get_reference(0).unwrap().second == 2, Str::new("the caret names the comment's start"))?;
    const word: i64 = text.find(&Str::new("word ")).unwrap();
    return expect(found.get_reference(1).unwrap().first.as_str() == Str::new("word") && found.get_reference(1).unwrap().second == word,
                  Str::new("the at-sign names the character after"));
}

/// A marker written twice in one file is refused, and `+N` moves along the
/// marker's line.
![test]
function a_fixture_refuses_a_marker_twice_and_reads_an_offset() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = match (TemporaryDirectory::create()) {
        Result::Ok(directory) => { directory }
        Result::Err(error)    => { return Result::Err(TestError::other(error.describe())); }
    };
    const root: Path = scratch.path();
    match (Directory::create_all(root.join(Str::new("src")).as_path())) {
        Result::Ok(_)      => { }
        Result::Err(error) => { return Result::Err(TestError::other(error.describe())); }
    }
    const written: boolean = File::write_text(root.join(Str::new("checks.json")).as_path(), Str::new("{\"open\":[\"src/main.cryo\"],\"checks\":[]}")).is_ok()
        && File::write_text(root.join(Str::new("src/main.cryo")).as_path(), Str::new("\u{FEFF}x\n  /*@here*/value")).is_ok();
    expect(written, Str::new("the fixture is written"))?;
    mut fixture: Fixture = match (Fixture::open(root.as_str())) {
        Result::Ok(fixture) => { fixture }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    const moved: Pair<String, Position> = match (fixture.at(Str::new("src/main.cryo@here+2"))) {
        Result::Ok(place)   => { place }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    expect(moved.second.line == 1 && moved.second.character == 13, f"{moved.second.line}:{moved.second.character}".as_str())?;
    expect(fixture.at(Str::new("src/main.cryo@missing")).is_err(), Str::new("a missing marker is an error"))?;
    return expect(fixture.set_text(Str::new("src/main.cryo"), Str::new("/*@a*/x /*@a*/y")).is_err(), Str::new("a marker twice is an error"));
}

/// A build counts only with its population; the warnings and the binary
/// are read; an up-to-date build states no population.
![test]
function a_server_build_is_counted_only_with_its_population() -> Result<(), TestError> {
    const built: LspBuild = LspBuild::read(Str::new("Building cryolsp [release]: 24 local, 81 std, 161 dep module(s)\nwarning[W0001]: x\n2 warnings emitted\nCompiled -> build/gate/cryolsp.exe\n"));
    expect(built.counted && built.total() == 266, f"{built.total()} modules".as_str())?;
    expect(built.warnings == 2, f"{built.warnings} warnings".as_str())?;
    expect(built.binary.as_str() == Str::new("build/gate/cryolsp.exe"), built.binary.as_str())?;
    expect(built.described() == String::from_str(Str::new("compiled 266 module(s) (24 local, 81 std, 161 dep), 0 errors, 2 warning(s); linked build/gate/cryolsp.exe")),
           built.described().as_str())?;
    const warm: LspBuild = LspBuild::read(Str::new("cryolsp is up to date (release)\nCompiled -> build/gate/cryolsp.exe\n"));
    expect(!warm.counted, Str::new("an up-to-date build compiled nothing"))?;
    const compiler: LspBuild = LspBuild::read(Str::new("Building cryo [release]: 180 local, 94 std module(s)\naborting due to 1 error; 64 warnings emitted\nerror[E0001]: x\n"));
    expect(!compiler.counted, Str::new("a population without dependencies is not the server's"))?;
    expect(compiler.warnings == 0, Str::new("a warnings count not at the line's start is not read"))?;
    return expect(compiler.errors.length() == 1, Str::new("the error line is kept"));
}

/// A published set passes only when it is exactly the expected one, each
/// message holding its text.
![test]
function diagnostics_hold_only_as_the_exact_set_with_their_text() -> Result<(), TestError> {
    const published: JsonValue = Parsed::of(Str::new("{\"diagnostics\":[{\"code\":\"W0001\",\"message\":\"unused variable\",\"range\":{\"start\":{\"line\":2,\"character\":4}}},{\"message\":\"not analysed\",\"range\":{\"start\":{\"line\":0,\"character\":0}}}]}"))?;
    mut keys: Array<String> = Array::<String>::new();
    keys.push(String::from_str(Str::new("W0001:2:4")));
    keys.push(String::from_str(Str::new("null:0:0")));
    keys = Judges::sorted(keys);
    mut texts: Array<Pair<String, String>> = Array::<Pair<String, String>>::new();
    texts.push(Pair::new(String::from_str(Str::new("W0001:2:4")), String::from_str(Str::new("unused"))));
    expect(Judges::diagnostics_hold(&published, &keys, &texts), Str::new("the exact set, the text held"))?;
    mut wrong_text: Array<Pair<String, String>> = Array::<Pair<String, String>>::new();
    wrong_text.push(Pair::new(String::from_str(Str::new("W0001:2:4")), String::from_str(Str::new("unreachable"))));
    expect(!Judges::diagnostics_hold(&published, &keys, &wrong_text), Str::new("a message without the text"))?;
    mut fewer: Array<String> = Array::<String>::new();
    fewer.push(String::from_str(Str::new("W0001:2:4")));
    return expect(!Judges::diagnostics_hold(&published, &fewer, &texts), Str::new("one diagnostic more than expected"));
}

/// A hover check: `expect` null wants none; otherwise contains and excludes.
![test]
function a_hover_is_judged_by_what_it_contains() -> Result<(), TestError> {
    const check: JsonValue = Parsed::of(Str::new("{\"contains\":[\"i32\"],\"excludes\":[\"i64\"]}"))?;
    const none: JsonValue = Parsed::of(Str::new("{\"expect\":null}"))?;
    const answer: JsonValue = Parsed::of(Str::new("{\"contents\":{\"kind\":\"markdown\",\"value\":\"x: i32\"}}"))?;
    const wrong: JsonValue = Parsed::of(Str::new("{\"contents\":[{\"value\":\"x: i64\"},\"plain\"]}"))?;
    const nothing: JsonValue = JsonValue::Null;
    expect(Judges::hover(&check, &answer).passed, Str::new("the type is shown"))?;
    expect(!Judges::hover(&check, &wrong).passed, Str::new("the wrong type"))?;
    expect(Judges::hover(&none, &nothing).passed, Str::new("no hover wanted, none given"))?;
    return expect(!Judges::hover(&none, &answer).passed, Str::new("no hover wanted, one given"));
}

/// A code action passes only on a quickfix replacing exactly the old
/// text's width at the place with the new text.
![test]
function a_code_action_needs_one_exact_quickfix() -> Result<(), TestError> {
    const answer: JsonValue = Parsed::of(Str::new("[{\"kind\":\"refactor\",\"edit\":{\"changes\":{\"file:///c:/a.cryo\":[{\"range\":{\"start\":{\"line\":1,\"character\":2},\"end\":{\"line\":1,\"character\":5}},\"newText\":\"_x\"}]}}},{\"kind\":\"quickfix\",\"edit\":{\"changes\":{\"file:///C%3A/a.cryo\":[{\"range\":{\"start\":{\"line\":1,\"character\":2},\"end\":{\"line\":1,\"character\":3}},\"newText\":\"_x\"}]}}}]"))?;
    const at: Position = Position { line: 1, character: 2 };
    expect(Judges::code_action(&answer, Str::new("file:///c:/a.cryo"), &at, Str::new("x"), Str::new("_x")).passed, Str::new("the quickfix"))?;
    return expect(!Judges::code_action(&answer, Str::new("file:///c:/a.cryo"), &at, Str::new("xyz"), Str::new("_x")).passed, Str::new("only a refactor replaces three"));
}
