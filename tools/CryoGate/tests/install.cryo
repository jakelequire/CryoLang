///! The install check's judges: the files an install must hold on each OS,
///! how a reported path is matched against the install root, and every
///! refusal of a build with no C toolchain.
![config(testing)]
namespace cryogate::tests::install;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect };

import cryogate::release::install::{ InstallLayout };

![test]
function each_os_requires_its_own_binaries_and_dependency_step() -> Result<(), TestError> {
    const windows: Array<String> = InstallLayout::required(Str::new("windows"));
    const linux: Array<String> = InstallLayout::required(Str::new("linux"));
    expect(windows.contains(&String::from_str(Str::new("bin/LLVM-C.dll"))), Str::new("windows needs the LLVM library"))?;
    expect(windows.contains(&String::from_str(Str::new("install-dependencies.ps1"))), Str::new("windows ships the PowerShell step"))?;
    expect(linux.contains(&String::from_str(Str::new("bin/cryolsp"))), Str::new("linux ships the language server"))?;
    expect(!linux.contains(&String::from_str(Str::new("bin/cryo.exe"))), Str::new("linux has no .exe"))?;
    return expect(linux.contains(&String::from_str(Str::new("runtime/.bin/shipped"))), Str::new("the runtime is marked shipped"));
}

![test]
function a_reported_root_matches_across_separators_and_case_only_on_windows() -> Result<(), TestError> {
    const report: Str = Str::new("cryo 1.0.0\n  binary: C:\\Users\\Me\\Temp\\prefix\\bin\\cryo.exe");
    expect(InstallLayout::names_root(report, Str::new("c:/users/me/temp/prefix"), Str::new("windows")), Str::new("windows ignores case and separators"))?;
    expect(!InstallLayout::names_root(Str::new("binary: /home/Me/prefix/bin/cryo"), Str::new("/home/me/prefix"), Str::new("linux")), Str::new("linux keeps case"))?;
    return expect(!InstallLayout::names_root(report, Str::new("c:/users/me/temp/other"), Str::new("windows")), Str::new("another root does not match"));
}

![test]
function a_build_with_no_toolchain_passes_only_when_refused_with_e0705_naming_the_step() -> Result<(), TestError> {
    const good: Str = Str::new("error[E0705]: no C compiler to link the program with\n  = help: run /home/me/.cryo/install-dependencies.sh");
    expect(InstallLayout::judge_no_toolchain(Option::Some(1), good).is_none(), Str::new("the refusal passes"))?;
    expect(InstallLayout::judge_no_toolchain(Option::Some(0), good).is_some(), Str::new("a success fails"))?;
    expect(InstallLayout::judge_no_toolchain(Option::None, good).is_some(), Str::new("no exit fails"))?;
    expect(InstallLayout::judge_no_toolchain(Option::Some(1), Str::new("error[E0900]: linker invocation failed")).is_some(), Str::new("another code fails"))?;
    return expect(InstallLayout::judge_no_toolchain(Option::Some(1), Str::new("error[E0705]: no C compiler")).is_some(), Str::new("no named step fails"));
}
