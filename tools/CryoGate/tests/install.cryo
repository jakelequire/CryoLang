///! The install check's judges: the files an install must hold on each OS,
///! how a reported path is matched against the install root, an install's
///! files against the archive's, and every refusal of a build with no C
///! toolchain.
![config(testing)]
namespace cryogate::tests::install;

import std::collections::array::{ Array };
import std::collections::pair::{ Pair };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect };

import cryogate::release::install::{ InstallLayout };

![test]
function each_os_requires_its_own_binaries_and_dependency_step() -> Result<(), TestError> {
    const windows: Array<String> = InstallLayout::required(Str::new("windows"));
    const linux: Array<String> = InstallLayout::required(Str::new("linux"));
    expect(windows.contains(&String::from_str(Str::new("bin/LLVM-C.dll"))), Str::new("windows needs the LLVM library"))?;
    expect(windows.contains(&String::from_str(Str::new("install-dependencies.ps1"))), Str::new("windows ships the PowerShell step"))?;
    expect(windows.contains(&String::from_str(Str::new("user-setup.ps1"))), Str::new("windows ships the PATH and cache script"))?;
    expect(!linux.contains(&String::from_str(Str::new("user-setup.ps1"))), Str::new("linux has no PowerShell"))?;
    expect(linux.contains(&String::from_str(Str::new("bin/cryolsp"))), Str::new("linux ships the language server"))?;
    expect(!linux.contains(&String::from_str(Str::new("bin/cryo.exe"))), Str::new("linux has no .exe"))?;
    return expect(linux.contains(&String::from_str(Str::new("runtime/.bin/shipped"))), Str::new("the runtime is marked shipped"));
}

![test]
function a_reported_root_matches_across_separators_and_case_only_on_windows() -> Result<(), TestError> {
    const report: Str = Str::new("cryo 1.0.0\n  binary: C:\\Users\\Me\\Temp\\prefix\\bin\\cryo.exe");
    expect(InstallLayout::names_root(report, Str::new("c:/users/me/temp/prefix"), Str::new("windows")), Str::new("windows ignores case and separators"))?;
    expect(!InstallLayout::names_root(Str::new("binary: /home/Me/prefix/bin/cryo"), Str::new("/home/me/prefix"), Str::new("linux")), Str::new("linux keeps case"))?;
    return expect(!InstallLayout::names_root(report, Str::new("c:/users/me/temp/other"), Str::new("windows")), Str::new("another root does not match"));
}

![test]
function an_install_holds_the_archive_only_with_the_same_files_and_bytes() -> Result<(), TestError> {
    mut archive: Array<Pair<String, String>> = Array::<Pair<String, String>>::new();
    archive.push(Pair::new(String::from_str(Str::new("bin/cryo")), String::from_str(Str::new("aa"))));
    archive.push(Pair::new(String::from_str(Str::new("stdlib/.bin/shipped")), String::from_str(Str::new("bb"))));
    mut same: Array<Pair<String, String>> = Array::<Pair<String, String>>::new();
    same.push(Pair::new(String::from_str(Str::new("bin/cryo")), String::from_str(Str::new("aa"))));
    same.push(Pair::new(String::from_str(Str::new("stdlib/.bin/shipped")), String::from_str(Str::new("bb"))));
    expect(InstallLayout::first_difference(&archive, &same).is_none(), Str::new("the same files and bytes pass"))?;

    mut changed: Array<Pair<String, String>> = Array::<Pair<String, String>>::new();
    changed.push(Pair::new(String::from_str(Str::new("bin/cryo")), String::from_str(Str::new("aa"))));
    changed.push(Pair::new(String::from_str(Str::new("stdlib/.bin/shipped")), String::from_str(Str::new("cc"))));
    expect(InstallLayout::first_difference(&archive, &changed).unwrap().as_str().contains(&Str::new("stdlib/.bin/shipped is not the archive's")),
        Str::new("a changed file is named"))?;

    mut written: Array<Pair<String, String>> = Array::<Pair<String, String>>::new();
    written.push(Pair::new(String::from_str(Str::new("bin/cryo")), String::from_str(Str::new("aa"))));
    written.push(Pair::new(String::from_str(Str::new("stdlib/.bin/last-use")), String::from_str(Str::new("ee"))));
    written.push(Pair::new(String::from_str(Str::new("stdlib/.bin/shipped")), String::from_str(Str::new("bb"))));
    expect(InstallLayout::first_difference(&archive, &written).unwrap().as_str().contains(&Str::new("holds stdlib/.bin/last-use where")),
        Str::new("a file written into the install is named"))?;

    mut appended: Array<Pair<String, String>> = Array::<Pair<String, String>>::new();
    appended.push(Pair::new(String::from_str(Str::new("bin/cryo")), String::from_str(Str::new("aa"))));
    appended.push(Pair::new(String::from_str(Str::new("stdlib/.bin/shipped")), String::from_str(Str::new("bb"))));
    appended.push(Pair::new(String::from_str(Str::new("zz")), String::from_str(Str::new("ff"))));
    expect(InstallLayout::first_difference(&archive, &appended).unwrap().as_str().contains(&Str::new("holds zz, which the archive does not")),
        Str::new("a file after the archive's last is named"))?;

    mut short: Array<Pair<String, String>> = Array::<Pair<String, String>>::new();
    short.push(Pair::new(String::from_str(Str::new("bin/cryo")), String::from_str(Str::new("aa"))));
    return expect(InstallLayout::first_difference(&archive, &short).unwrap().as_str().contains(&Str::new("lacks stdlib/.bin/shipped")),
        Str::new("a missing file is named"));
}

![test]
function a_build_with_no_toolchain_passes_only_when_refused_with_e0705_naming_the_step() -> Result<(), TestError> {
    const good: Str = Str::new("error[E0705]: no C compiler to link the program with\n  = help: run /home/me/.cryo/install-dependencies.sh");
    expect(InstallLayout::judge_no_toolchain(Option::Some(1), good).is_none(), Str::new("the refusal passes"))?;
    expect(InstallLayout::judge_no_toolchain(Option::Some(0), good).is_some(), Str::new("a success fails"))?;
    expect(InstallLayout::judge_no_toolchain(Option::None, good).is_some(), Str::new("no exit fails"))?;
    expect(InstallLayout::judge_no_toolchain(Option::Some(1), Str::new("error[E0900]: linker invocation failed")).is_some(), Str::new("another code fails"))?;
    return expect(InstallLayout::judge_no_toolchain(Option::Some(1), Str::new("error[E0705]: no C compiler")).is_some(), Str::new("no named step fails"));
}
