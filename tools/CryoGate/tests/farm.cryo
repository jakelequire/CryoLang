///! smith-farm's decisions: the log it resumes from, the next batch, the
///! known findings and the jobs the host's memory allows.
![config(testing)]
namespace cryogate::tests::farm;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect };

import cryogate::smith::farm::{ FarmEntry, FarmKind, FarmLog, KnownFindings, MemoryBudget, MemoryVerdict };

![test]
function a_log_line_reads_back_as_it_was_written() -> Result<(), TestError> {
    const entry: FarmEntry = FarmEntry { seed: 41, kind: String::from_str(Str::new("crash")), verdict: String::from_str(Str::new("internal error [drop-argument] E0900")) };
    const log: FarmLog = FarmLog::read(entry.line().as_str()).unwrap();
    expect(log.entries.length() == 1, Str::new("one entry"))?;
    expect(log.entries[0].line().as_str() == entry.line().as_str(), log.entries[0].line().as_str())?;
    return expect(log.judged(41, FarmKind::Crash) && !log.judged(41, FarmKind::Diff), Str::new("judged by its own kind only"));
}

![test]
function a_line_that_is_no_entry_is_refused_by_its_number() -> Result<(), TestError> {
    const text: Str = Str::new("seed 1 diff ok\n\nseed two diff ok\n");
    return match (FarmLog::read(text)) {
        Result::Ok(_)       => { expect(false, Str::new("a seed that is no number was read")) }
        Result::Err(reason) => { expect(reason.as_str().starts_with(&Str::new("line 3 ")), reason.as_str()) }
    };
}

![test]
function a_kind_the_farm_does_not_judge_by_is_refused() -> Result<(), TestError> {
    return expect(FarmLog::read(Str::new("seed 1 reduce ok\n")).is_err(), Str::new("`reduce` is not a kind"));
}

![test]
function the_next_batch_skips_what_the_log_judged_by_that_kind() -> Result<(), TestError> {
    const log: FarmLog = FarmLog::read(Str::new("seed 1 diff ok\nseed 2 diff ok\nseed 4 diff mismatch [tree -O0 | tree -O2]\nseed 3 crash ok\n")).unwrap();
    const differences: Array<u64> = log.next_batch(1, 9, 3, FarmKind::Diff);
    expect(differences.length() == 3 && differences[0] == 3 && differences[1] == 5 && differences[2] == 6, Str::new("3, 5 and 6"))?;
    const crashes: Array<u64> = log.next_batch(1, 4, 8, FarmKind::Crash);
    expect(crashes.length() == 3 && crashes[0] == 1 && crashes[1] == 2 && crashes[2] == 4, Str::new("1, 2 and 4: the range ends the batch"))?;
    return expect(log.next_batch(1, 2, 5, FarmKind::Diff).is_empty(), Str::new("a range wholly judged gives nothing"));
}

![test]
function a_known_signature_names_its_bug() -> Result<(), TestError> {
    const known: KnownFindings = KnownFindings::read(Str::new("# known\n0364 internal error [drop-argument] E0900\n\n0365 mismatch [tree -O0, tree -O2 | linux -O2]\n")).unwrap();
    expect(known.bug_of(Str::new("internal error [drop-argument] E0900")).unwrap_or(String::new()).as_str() == Str::new("0364"), Str::new("0364"))?;
    expect(known.bug_of(Str::new("mismatch [tree -O0, tree -O2 | linux -O2]")).unwrap_or(String::new()).as_str() == Str::new("0365"), Str::new("0365"))?;
    expect(known.bug_of(Str::new("internal error [drop-brace] E0900")).is_none(), Str::new("another operator is another signature"))?;
    return expect(KnownFindings::read(Str::new("0364\n")).is_err(), Str::new("a bug with no signature is refused"));
}

/// The verdict `committed` gives under a 40 GB ceiling, a 52 GB hard limit
/// and 0.4 GB a job, at most 8 jobs, as `run N`, `wait` or `stop`.
private function verdict_at(committed: u64) -> String {
    const gigabyte: u64 = 1073741824;
    const budget: MemoryBudget = MemoryBudget { committed: committed, hard_limit: 52 * gigabyte, ceiling: 40 * gigabyte, per_job: (gigabyte * 4) / 10 };
    return match (budget.verdict(8)) {
        MemoryVerdict::Run(jobs) => { f"run {jobs}" }
        MemoryVerdict::Wait      => { String::from_str(Str::new("wait")) }
        MemoryVerdict::Stop      => { String::from_str(Str::new("stop")) }
    };
}

![test]
function the_jobs_are_what_the_room_under_the_ceiling_holds() -> Result<(), TestError> {
    const gigabyte: u64 = 1073741824;
    expect(verdict_at(20 * gigabyte).as_str() == Str::new("run 8"), verdict_at(20 * gigabyte).as_str())?;
    expect(verdict_at(39 * gigabyte).as_str() == Str::new("run 2"), verdict_at(39 * gigabyte).as_str())?;
    expect(verdict_at(40 * gigabyte - gigabyte / 10).as_str() == Str::new("wait"), Str::new("room for less than a job waits"))?;
    expect(verdict_at(45 * gigabyte).as_str() == Str::new("wait"), Str::new("past the ceiling waits"))?;
    return expect(verdict_at(52 * gigabyte).as_str() == Str::new("stop"), Str::new("the hard limit stops"));
}
