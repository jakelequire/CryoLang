/// Inputs written as text: a list as names joined by `,`, a row as a
/// digit repeated 64 times, two spaces and a path.
private type struct Given {
    private static list(text: Str) -> Array<String> {
        mut out: Array<String> = Array::<String>::new();
        for (part in text.split_nonempty(&Str::new(","))) { out.push(String::from_str(part)); }
        return out;
    }

    private static row(digit: Str, path: Str) -> String {
        mut row: String = String::new();
        while (row.length() < 64) { row.push(digit); }
        row.push(Str::new("  "));
        row.push(path);
        return row;
    }

    private static record(name: Str, verdict: Str, rows: Array<String>) -> BaselineRecord {
        mut record: BaselineRecord = BaselineRecord::new(name, verdict);
        record.rows = rows;
        return record;
    }

    private static unit_suite(failed: Str, count: i64) -> BaselineRecord {
        mut record: BaselineRecord = BaselineRecord::new(Str::new("unit suite"), if (failed.is_empty()) { Str::new("ok") } else { Str::new("FAILED") });
        record.unit_failed = Given::list(failed);
        mut counts: Array<i64> = Array::<i64>::new();
        counts.push(10);
        counts.push(count);
        counts.push(0);
        counts.push(0);
        record.unit_counts = Option::Some(counts);
        return record;
    }

    private static checkout() -> Result<PathBuf, TestError> {
        return match (Host::repository()) {
            Result::Ok(root)    => { Result::Ok(root) }
            Result::Err(reason) => { Result::Err(TestError::other(reason.as_str())) }
        };
    }

    private static step(name: Str, fixed: boolean) -> Result<String, TestError> {
        const root: PathBuf = Given::checkout()?;
        return match (DeclaredBuilds::step(root.as_path(), name, fixed)) {
            Result::Ok(build)    => { Result::Ok(String::from_str(if (build) { Str::new("build") } else { Str::new("no build") })) }
            Result::Err(problem) => { Result::Ok(problem) }
        };
    }
}

const KEYED: Str = "unit suite,p,q,negative/n.cryo,examples/e,examples/f,archives/census,archives/examples";

![test]
function every_record_found_runs_nothing() -> Result<(), TestError> {
    const plan: BaselinePlan = BaselinePlan::of(&Given::list(KEYED), &Given::list(KEYED));
    expect_equal(plan.missing.length(), 0)?;
    expect_equal(plan.census.length() + plan.examples.length(), 0)?;
    return expect_equal(plan.line().as_str(),
        Str::new("verify: baseline programs: 8 recorded, 0 to run (unit suite no, 0 project(s), 0 compile-fail file(s), 0 example(s))"));
}

![test]
function a_new_project_runs_alone_through_a_filter() -> Result<(), TestError> {
    const plan: BaselinePlan = BaselinePlan::of(&Given::list(KEYED), &Given::list(Str::new("unit suite,p,negative/n.cryo,examples/e,examples/f,archives/census,archives/examples")));
    expect_equal(Text::joined(&plan.census, Str::new(",")).as_str(), Str::new("q"))?;
    expect(!plan.everything, Str::new("one project of four is not everything"))?;
    return expect_equal(Text::joined(&plan.patterns(true), Str::new(",")).as_str(), Str::new("q"));
}

![test]
function several_programs_run_in_one_census_by_one_pattern_each() -> Result<(), TestError> {
    const plan: BaselinePlan = BaselinePlan::of(&Given::list(KEYED), &Given::list(Str::new("p,examples/e,examples/f,archives/census,archives/examples")));
    expect_equal(Text::joined(&plan.census, Str::new(",")).as_str(), Str::new("negative/n.cryo,q,unit suite"))?;
    expect(!plan.everything, Str::new("three of four is not everything"))?;
    return expect_equal(Text::joined(&plan.patterns(true), Str::new(",")).as_str(), Str::new("n.cryo,q,CryoTests::"));
}

![test]
function a_compiler_reading_one_pattern_runs_every_program() -> Result<(), TestError> {
    const plan: BaselinePlan = BaselinePlan::of(&Given::list(KEYED), &Given::list(Str::new("p,examples/e,examples/f,archives/census,archives/examples")));
    expect_equal(plan.census.length(), 3)?;
    return expect_equal(plan.patterns(false).length(), 0);
}

![test]
function the_examples_archives_unrecorded_run_every_example() -> Result<(), TestError> {
    const plan: BaselinePlan = BaselinePlan::of(&Given::list(KEYED), &Given::list(Str::new("unit suite,p,q,negative/n.cryo,examples/e,examples/f,archives/census")));
    expect_equal(Text::joined(&plan.examples, Str::new(",")).as_str(), Str::new("examples/e,examples/f"))?;
    return expect_equal(plan.census.length(), 0);
}

![test]
function the_census_archives_unrecorded_run_the_unit_suite_alone() -> Result<(), TestError> {
    const plan: BaselinePlan = BaselinePlan::of(&Given::list(KEYED), &Given::list(Str::new("unit suite,p,q,negative/n.cryo,examples/e,examples/f,archives/examples")));
    expect_equal(Text::joined(&plan.missing, Str::new(",")).as_str(), Str::new("archives/census,unit suite"))?;
    expect_equal(Text::joined(&plan.patterns(true), Str::new(",")).as_str(), Str::new("CryoTests::"))?;
    // The unit suite's declaration kind is a project's, so the report
    // counts it among the projects.
    return expect_equal(plan.line().as_str(),
        Str::new("verify: baseline programs: 6 recorded, 2 to run (unit suite yes, 1 project(s), 0 compile-fail file(s), 0 example(s))"));
}

![test]
function nothing_recorded_runs_one_census_over_everything() -> Result<(), TestError> {
    const plan: BaselinePlan = BaselinePlan::of(&Given::list(KEYED), &Array::<String>::new());
    expect(plan.everything, Str::new("every census-side program runs"))?;
    expect_equal(plan.patterns(true).length(), 0)?;
    return expect_equal(plan.line().as_str(),
        Str::new("verify: baseline programs: 0 recorded, 8 to run (unit suite yes, 3 project(s), 1 compile-fail file(s), 2 example(s))"));
}

![test]
function a_compile_fail_file_is_filtered_by_its_file_name() -> Result<(), TestError> {
    const plan: BaselinePlan = BaselinePlan::of(&Given::list(KEYED), &Given::list(Str::new("unit suite,p,q,examples/e,examples/f,archives/census,archives/examples")));
    return expect_equal(Text::joined(&plan.patterns(true), Str::new(",")).as_str(), Str::new("n.cryo"));
}

![test]
function an_examples_line_names_the_example_and_its_verdict() -> Result<(), TestError> {
    const built: Option<Pair<String, boolean>> = BaselinePlan::example_verdict(Str::new("  ok    examples/01-hello"));
    expect(built.is_some(), Str::new("an ok line"))?;
    expect_equal(built.unwrap().second, false)?;
    const failed: Option<Pair<String, boolean>> = BaselinePlan::example_verdict(Str::new("  FAIL  examples/02-x"));
    expect_equal(failed.unwrap().first.as_str(), Str::new("examples/02-x"))?;
    expect(BaselinePlan::example_verdict(Str::new("examples-gate: OK -- 2 project(s) built")).is_none(), Str::new("the verdict line"))?;
    return expect(BaselinePlan::example_verdict(Str::new("  ok    tests/x")).is_none(), Str::new("not an example"));
}

![test]
function records_add_up_to_each_populations_rows_and_the_census_verdict() -> Result<(), TestError> {
    mut records: Array<BaselineRecord> = Array::<BaselineRecord>::new();
    mut unit: BaselineRecord = Given::unit_suite(Str::new("A::U::t"), 1);
    unit.rows.push(Given::row(Str::new("1"), Str::new("tests/build/deps/A.o")));
    records.push(unit);
    mut p_rows: Array<String> = Array::<String>::new();
    p_rows.push(Given::row(Str::new("2"), Str::new("tests/tests/projects/p/build/a.o")));
    records.push(Given::record(Str::new("p"), Str::new("FAILED"), p_rows));
    records.push(Given::record(Str::new("negative/n.cryo"), Str::new("FAILED"), Array::<String>::new()));
    mut e_rows: Array<String> = Array::<String>::new();
    e_rows.push(Given::row(Str::new("3"), Str::new("examples/e/build/m.o")));
    records.push(Given::record(Str::new("examples/e"), Str::new("ok"), e_rows));
    mut archive_rows: Array<String> = Array::<String>::new();
    archive_rows.push(Given::row(Str::new("4"), Str::new("stdlib-archive/t/O2/deps/std/io.o")));
    records.push(Given::record(Str::new("archives/census"), Str::new("ok"), archive_rows.clone()));
    records.push(Given::record(Str::new("archives/examples"), Str::new("ok"), archive_rows));
    mut runtime: Array<String> = Array::<String>::new();
    runtime.push(Given::row(Str::new("5"), Str::new("runtime/hosted-unwind/00-a.o")));
    const totals: BaselineTotals = match (BaselineTotals::of(records, runtime)) {
        Result::Ok(totals)  => { totals }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    expect_equal(totals.lists[0].length(), 2)?;
    expect_equal(totals.lists[1].length(), 1)?;
    // Two sweeps linking one archive name its objects once.
    expect_equal(totals.lists[2].length(), 1)?;
    expect_equal(totals.lists[3].length(), 1)?;
    expect_equal(totals.census.unit_failed, 1)?;
    expect_equal(totals.census.negatives_failed, 1)?;
    return expect_equal(Text::joined(&totals.census.failed, Str::new(",")).as_str(), Str::new("A::U::t,negative/n.cryo,p"));
}

![test]
function two_records_naming_one_object_with_other_bytes_are_refused() -> Result<(), TestError> {
    mut records: Array<BaselineRecord> = Array::<BaselineRecord>::new();
    records.push(Given::unit_suite(Str::new(""), 0));
    mut first: Array<String> = Array::<String>::new();
    first.push(Given::row(Str::new("1"), Str::new("stdlib-archive/t/O2/deps/std/io.o")));
    mut second: Array<String> = Array::<String>::new();
    second.push(Given::row(Str::new("2"), Str::new("stdlib-archive/t/O2/deps/std/io.o")));
    records.push(Given::record(Str::new("archives/census"), Str::new("ok"), first));
    records.push(Given::record(Str::new("archives/examples"), Str::new("ok"), second));
    return match (BaselineTotals::of(records, Array::<String>::new())) {
        Result::Ok(_)       => { Result::Err(TestError::other(Str::new("two records disagreeing were accepted"))) }
        Result::Err(reason) => { expect_equal(reason.as_str(), Str::new("two baseline records disagree on stdlib-archive/t/O2/deps/std/io.o")) }
    };
}

![test]
function records_without_the_unit_suite_are_refused() -> Result<(), TestError> {
    return match (BaselineTotals::of(Array::<BaselineRecord>::new(), Array::<String>::new())) {
        Result::Ok(_)       => { Result::Err(TestError::other(Str::new("no unit suite record was accepted"))) }
        Result::Err(reason) => { expect_equal(reason.as_str(), Str::new("the baseline has no record of the unit suite")) }
    };
}

![test]
function an_archive_record_made_again_keeps_every_object_of_both() -> Result<(), TestError> {
    mut held: Array<String> = Array::<String>::new();
    held.push(Given::row(Str::new("1"), Str::new("stdlib-archive/t/O0/deps/std/io.o")));
    mut fresh: Array<String> = Array::<String>::new();
    fresh.push(Given::row(Str::new("1"), Str::new("stdlib-archive/t/O0/deps/std/io.o")));
    fresh.push(Given::row(Str::new("2"), Str::new("stdlib-archive/t/O2/deps/std/io.o")));
    const merged: BaselineRecord = match (BaselineTotals::merged(&Given::record(Str::new("archives/census"), Str::new("ok"), fresh),
                                                                 &Given::record(Str::new("archives/census"), Str::new("ok"), held))) {
        Result::Ok(merged)  => { merged }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    return expect_equal(merged.rows.length(), 2);
}

![test]
function an_archive_object_built_again_with_other_bytes_is_refused() -> Result<(), TestError> {
    mut held: Array<String> = Array::<String>::new();
    held.push(Given::row(Str::new("1"), Str::new("stdlib-archive/t/O0/deps/std/io.o")));
    mut fresh: Array<String> = Array::<String>::new();
    fresh.push(Given::row(Str::new("3"), Str::new("stdlib-archive/t/O0/deps/std/io.o")));
    return match (BaselineTotals::merged(&Given::record(Str::new("archives/census"), Str::new("ok"), fresh),
                                         &Given::record(Str::new("archives/census"), Str::new("ok"), held))) {
        Result::Ok(_)       => { Result::Err(TestError::other(Str::new("other bytes were merged"))) }
        Result::Err(reason) => { expect_equal(reason.as_str(), Str::new("the baseline built stdlib-archive/t/O0/deps/std/io.o again with other bytes")) }
    };
}

![test]
function a_record_written_reads_back_the_same() -> Result<(), TestError> {
    mut record: BaselineRecord = Given::unit_suite(Str::new("A::U::t"), 1);
    record.warnings.push(String::from_str(Str::new("W0002 tests/tests/a.cryo:3")));
    record.warnings_listed = true;
    record.rows.push(Given::row(Str::new("1"), Str::new("tests/build/deps/A.o")));
    const again: BaselineRecord = BaselineRecord::read(record.text().as_str());
    expect_equal(again.name.as_str(), Str::new("unit suite"))?;
    return expect(record.difference(&again).is_none(), Str::new("every field reads back"));
}

![test]
function a_declared_line_must_name_a_program_of_its_kind() -> Result<(), TestError> {
    expect_equal(Given::step(Str::new("negative/no_such_file.cryo"), true)?.as_str(),
        Str::new("negative/no_such_file.cryo: declared in tests/started-passing but tests/tests/negative/no_such_file.cryo does not exist"))?;
    expect_equal(Given::step(Str::new("no_such_project"), false)?.as_str(),
        Str::new("no_such_project: declared in tests/started-compiling but tests/tests/projects/no_such_project is not a test project"))?;
    expect_equal(Given::step(Str::new("moved-archive:std::time::clock"), false)?.as_str(),
        Str::new("moved-archive:std::time::clock: a standard-library module's moved objects are declared in tests/started-passing, not tests/started-compiling"))?;
    expect_equal(Given::step(Str::new("moved:examples/no-such-example"), true)?.as_str(),
        Str::new("moved:examples/no-such-example: declared in tests/started-passing but examples/no-such-example is not an example project"))?;
    return expect_equal(Given::step(Str::new("moved-runtime:hosted-unwind/no-o"), true)?.as_str(),
        Str::new("moved-runtime:hosted-unwind/no-o: declared in tests/started-passing but hosted-unwind/no-o is not <configuration>/<member>.o"));
}

![test]
function only_a_project_a_change_makes_compile_or_corrects_is_built() -> Result<(), TestError> {
    expect_equal(Given::step(Str::new("visibility_internal_names"), false)?.as_str(), Str::new("build"))?;
    expect_equal(Given::step(Str::new("visibility_internal_names"), true)?.as_str(), Str::new("build"))?;
    expect_equal(Given::step(Str::new("moved:visibility_internal_names"), true)?.as_str(), Str::new("no build"))?;
    expect_equal(Given::step(Str::new("moved:examples/01-hello"), true)?.as_str(), Str::new("no build"))?;
    return expect_equal(Given::step(Str::new("moved-archive:std::time::clock"), true)?.as_str(), Str::new("no build"));
}

![test]
function a_path_below_the_checkout_is_shown_relative_to_it() -> Result<(), TestError> {
    expect_equal(PopulationRun::relative(Path::from("C:/r/x"), Str::new("C:\\r\\x\\.verify\\runs\\1")).as_str(), Str::new(".verify/runs/1"))?;
    return expect_equal(PopulationRun::relative(Path::from("C:/r/x"), Str::new("D:/elsewhere")).as_str(), Str::new("D:/elsewhere"));
}

![test]
function the_declared_lines_are_listed_in_name_order_under_their_count() -> Result<(), TestError> {
    mut declared: Array<Declaration> = Array::<Declaration>::new();
    declared.push(Declaration { name: String::from_str(Str::new("q")), reason: String::from_str(Str::new("second")) });
    declared.push(Declaration { name: String::from_str(Str::new("p")), reason: String::from_str(Str::new("first")) });
    return expect_equal(VerifySession::declared_line(&declared, Str::new("HEAD"), Str::new("pass")).as_str(),
        Str::new("verify: 2 program(s) declared as starting to pass since HEAD\n      p -- first\n      q -- second"));
}

![test]
function a_sealed_text_opens_only_as_it_was_written() -> Result<(), TestError> {
    const text: Str = Str::new("name p\nverdict ok\n");
    const sealed: String = Seal::close(text);
    expect(Seal::open(sealed.as_str()) == Option::Some(text), Str::new("as written"))?;
    const changed: String = sealed.as_str().replace(&Str::new("verdict ok"), &Str::new("verdict FAILED"));
    expect(Seal::open(changed.as_str()).is_none(), Str::new("a changed line"))?;
    expect(Seal::open(text).is_none(), Str::new("no end line"))?;
    expect(Seal::open(sealed.as_str().byte_substring(0, sealed.length() - 1)).is_none(), Str::new("the end line cut short"))?;
    const without_first: Str = sealed.as_str().byte_substring(7, sealed.length());
    expect(Seal::open(without_first).is_none(), Str::new("a line dropped"))?;
    return expect(Seal::open(Seal::close(Str::new("")).as_str()) == Option::Some(Str::new("")), Str::new("nothing sealed opens to nothing"));
}

![test]
function a_stored_record_is_read_back_only_under_its_key_and_name_and_seal() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = Scratch::directory()?;
    const store: RecordStore = RecordStore { directory: scratch.path().join(Str::new("programs")) };
    Scratch::created(store.directory.as_path())?;
    const record: BaselineRecord = Given::record(Str::new("p"), Str::new("ok"), Given::list(Str::new("")));
    Scratch::done(store.save(Str::new("k1"), &record))?;
    expect(store.load(Str::new("k1"), Str::new("p")).is_some(), Str::new("its key and name"))?;
    expect(store.load(Str::new("k1"), Str::new("q")).is_none(), Str::new("another program's name"))?;
    expect(store.load(Str::new("k2"), Str::new("p")).is_none(), Str::new("another key"))?;
    const path: PathBuf = store.directory.join(Str::new("k1"));
    const text: String = Scratch::read(path.as_path())?;
    Scratch::write(path.as_path(), text.as_str().replace(&Str::new("verdict ok"), &Str::new("verdict FAILED")).as_str())?;
    expect(store.load(Str::new("k1"), Str::new("p")).is_none(), Str::new("a record changed on disk is no record"))?;
    Scratch::done(store.save(Str::new("k1"), &record))?;
    return expect(store.load(Str::new("k1"), Str::new("p")).is_some(), Str::new("and is written again"));
}

![test]
function pruning_drops_records_not_read_for_the_kept_days() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = Scratch::directory()?;
    const store: RecordStore = RecordStore { directory: scratch.path().join(Str::new("programs")) };
    Scratch::created(store.directory.as_path())?;
    const record: BaselineRecord = Given::record(Str::new("p"), Str::new("ok"), Given::list(Str::new("")));
    Scratch::done(store.save(Str::new("k1"), &record))?;
    Scratch::done(store.save(Str::new("k2"), &record))?;
    const now: i64 = SystemTime::now().unix_seconds();
    expect(Scratch::pruned(&store, now)? == 0, Str::new("records written now are kept"))?;
    expect(Scratch::pruned(&store, now + (RecordStore::KEPT_DAYS - 1) * 86400)? == 0, Str::new("within the kept days"))?;
    expect(Scratch::pruned(&store, now + (RecordStore::KEPT_DAYS + 1) * 86400)? == 2, Str::new("past them, both go"))?;
    return expect(store.load(Str::new("k1"), Str::new("p")).is_none(), Str::new("and are gone"));
}

![test]
function a_kept_tree_run_is_replayed_and_one_changed_on_disk_is_deleted_not_trusted() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = Scratch::directory()?;
    const run: PathBuf = scratch.path().join(Str::new("run-1"));
    Scratch::created(run.as_path())?;
    Scratch::write(run.join(Str::new("census.log")).as_path(), Str::new("test-census: OK -- every pinned entry accounted for\n"))?;
    Scratch::write(run.join(Str::new("tree.census.log")).as_path(), Str::new("runner output\n"))?;
    for (population in ObjectPopulation::all().iterate_references()) {
        Scratch::write(run.join(f"tree.{population.name()}.sha256".as_str()).as_path(), Given::row(Str::new("1"), Str::new("x.o")).as_str())?;
    }
    const table: Array<GateCommand> = GateCommand::table(Str::new("cryogate"));
    const names: Array<String> = Given::list(Str::new("census"));
    mut gates: Array<GateRun> = Array::<GateRun>::new();
    gates.push(GateRun {
        name: String::from_str(Str::new("census")), verdict: GateVerdict::of(&table[0], Str::new("test-census: OK -- x"), 0),
        seconds: 12.5, log: String::from_str(run.join(Str::new("census.log")).as_path().as_str()),
    });
    mut counts: Array<i64> = Array::<i64>::new();
    for (population in ObjectPopulation::all().iterate_references()) { counts.push(1); }
    const cache: TreeRunCache = TreeRunCache { directory: scratch.path().join(Str::new("tree-runs")), key: String::from_str(Str::new("k")) };
    Scratch::done(cache.store(run.as_path(), &PopulationRun { gates: gates, counts: counts }))?;

    const again: PathBuf = scratch.path().join(Str::new("run-2"));
    Scratch::created(again.as_path())?;
    const replayed: PopulationRun = match (cache.replay(&table, &names, again.as_path())) {
        Option::Some(population) => { population }
        Option::None             => { return Result::Err(TestError::other(Str::new("the kept run was not replayed"))); }
    };
    expect(replayed.gates.length() == 1 && replayed.gates[0].verdict.ok, Str::new("its gate, judged again from its log"))?;
    expect(replayed.gates[0].seconds == 12.5, Str::new("its time"))?;
    expect(replayed.counts.length() == 4, Str::new("its counts"))?;
    expect_equal(Scratch::read(again.join(Str::new("tree.census.log")).as_path())?.as_str(), Str::new("runner output\n"))?;

    Scratch::write(cache.entry().join(Str::new("tree.tests.sha256")).as_path(), Given::row(Str::new("2"), Str::new("x.o")).as_str())?;
    const third: PathBuf = scratch.path().join(Str::new("run-3"));
    Scratch::created(third.as_path())?;
    expect(cache.replay(&table, &names, third.as_path()).is_none(), Str::new("a kept list changed on disk is not replayed"))?;
    return expect(!cache.entry().as_path().exists(), Str::new("and the kept run is deleted"));
}

![test]
function a_kept_tree_run_whose_gate_log_does_not_pass_is_not_replayed() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = Scratch::directory()?;
    const run: PathBuf = scratch.path().join(Str::new("run-1"));
    Scratch::created(run.as_path())?;
    Scratch::write(run.join(Str::new("census.log")).as_path(), Str::new("test-census: FAILED\n"))?;
    for (population in ObjectPopulation::all().iterate_references()) {
        Scratch::write(run.join(f"tree.{population.name()}.sha256".as_str()).as_path(), Str::new(""))?;
    }
    const table: Array<GateCommand> = GateCommand::table(Str::new("cryogate"));
    mut gates: Array<GateRun> = Array::<GateRun>::new();
    gates.push(GateRun {
        name: String::from_str(Str::new("census")), verdict: GateVerdict::of(&table[0], Str::new("test-census: FAILED"), 1),
        seconds: 1.0, log: String::from_str(run.join(Str::new("census.log")).as_path().as_str()),
    });
    mut counts: Array<i64> = Array::<i64>::new();
    for (population in ObjectPopulation::all().iterate_references()) { counts.push(0); }
    const cache: TreeRunCache = TreeRunCache { directory: scratch.path().join(Str::new("tree-runs")), key: String::from_str(Str::new("k")) };
    Scratch::done(cache.store(run.as_path(), &PopulationRun { gates: gates, counts: counts }))?;
    const again: PathBuf = scratch.path().join(Str::new("run-2"));
    Scratch::created(again.as_path())?;
    return expect(cache.replay(&table, &Given::list(Str::new("census")), again.as_path()).is_none(),
        Str::new("a kept run is judged again, and a failing log is never a pass"));
}

![test]
function the_tree_runs_key_reads_every_listed_file_and_what_git_ignores_below_bin() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = Scratch::directory()?;
    const root: Path = scratch.path();
    const logs_home: TemporaryDirectory = Scratch::directory()?;
    const logs: RunLogs = match (RunLogs::open(logs_home.path())) {
        Result::Ok(logs)    => { logs }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    const git: Git = Git::new(root, &logs);
    mut init: Array<Str> = Array::<Str>::new();
    init.push(Str::new("init"));
    init.push(Str::new("-q"));
    expect(git.run(&init).outcome.succeeded(), Str::new("git init"))?;
    Scratch::write(root.join(Str::new(".gitignore")).as_path(), Str::new("*.o\nbin/*.dll\n"))?;
    Scratch::write(root.join(Str::new("a.cryo")).as_path(), Str::new("one"))?;
    Scratch::created(root.join(Str::new("bin")).as_path())?;
    Scratch::write(root.join(Str::new("bin/x.dll")).as_path(), Str::new("library"))?;
    const first: String = Scratch::inputs(root, &git)?;
    expect(Scratch::inputs(root, &git)? == first, Str::new("the same checkout reads the same"))?;
    Scratch::write(root.join(Str::new("a.cryo")).as_path(), Str::new("two"))?;
    const edited: String = Scratch::inputs(root, &git)?;
    expect(edited != first, Str::new("an untracked file's bytes"))?;
    Scratch::write(root.join(Str::new("b.o")).as_path(), Str::new("output"))?;
    expect(Scratch::inputs(root, &git)? == edited, Str::new("a file git ignores elsewhere is an output"))?;
    Scratch::write(root.join(Str::new("bin/x.dll")).as_path(), Str::new("another library"))?;
    return expect(Scratch::inputs(root, &git)? != edited, Str::new("a library git ignores below bin"));
}

![test]
function the_tree_runs_key_reads_the_compilers_bytes_the_gates_and_the_target() -> Result<(), TestError> {
    const scratch: TemporaryDirectory = Scratch::directory()?;
    const root: Path = scratch.path();
    const logs_home: TemporaryDirectory = Scratch::directory()?;
    const logs: RunLogs = match (RunLogs::open(logs_home.path())) {
        Result::Ok(logs)    => { logs }
        Result::Err(reason) => { return Result::Err(TestError::other(reason.as_str())); }
    };
    const git: Git = Git::new(root, &logs);
    mut init: Array<Str> = Array::<Str>::new();
    init.push(Str::new("init"));
    init.push(Str::new("-q"));
    expect(git.run(&init).outcome.succeeded(), Str::new("git init"))?;
    Scratch::write(root.join(Str::new(".gitignore")).as_path(), Str::new("build/\n"))?;
    Scratch::created(root.join(Str::new("build")).as_path())?;
    const compiler: PathBuf = root.join(Str::new("build/cryo"));
    Scratch::write(compiler.as_path(), Str::new("compiler one"))?;
    const toolchain: HostToolchain = HostToolchain { digest: String::from_str(Str::new("host")) };
    const gates: Array<String> = Given::list(Str::new("census,examples"));
    const first: String = Scratch::key(root, &git, compiler.as_path(), &toolchain, &gates, Str::new("x86_64-pc-windows-gnu"))?;
    Scratch::write(compiler.as_path(), Str::new("compiler two"))?;
    const second: String = Scratch::key(root, &git, compiler.as_path(), &toolchain, &gates, Str::new("x86_64-pc-windows-gnu"))?;
    expect(second != first, Str::new("the compiler's bytes at the same path"))?;
    expect(Scratch::key(root, &git, compiler.as_path(), &toolchain, &Given::list(Str::new("census")), Str::new("x86_64-pc-windows-gnu"))? != second,
        Str::new("the gates"))?;
    expect(Scratch::key(root, &git, compiler.as_path(), &toolchain, &gates, Str::new("x86_64-pc-linux-gnu"))? != second, Str::new("the target"))?;
    const other_host: HostToolchain = HostToolchain { digest: String::from_str(Str::new("another host")) };
    return expect(Scratch::key(root, &git, compiler.as_path(), &other_host, &gates, Str::new("x86_64-pc-windows-gnu"))? != second,
        Str::new("the host toolchain"));
}

/// Scratch directories and files for the store's and the cache's tests.
private type struct Scratch {
    private static directory() -> Result<TemporaryDirectory, TestError> {
        return match (TemporaryDirectory::create()) {
            Result::Ok(directory) => { Result::Ok(directory) }
            Result::Err(error)    => { Result::Err(TestError::other(error.describe())) }
        };
    }

    private static created(path: Path) -> Result<(), TestError> {
        return match (Directory::create_all(path)) {
            Result::Ok(_)      => { Result::Ok(()) }
            Result::Err(error) => { Result::Err(TestError::other(error.describe())) }
        };
    }

    private static write(path: Path, text: Str) -> Result<(), TestError> {
        return match (File::write_text(path, text)) {
            Result::Ok(_)      => { Result::Ok(()) }
            Result::Err(error) => { Result::Err(TestError::other(error.describe())) }
        };
    }

    private static read(path: Path) -> Result<String, TestError> {
        return match (File::read_text(path)) {
            Result::Ok(text)   => { Result::Ok(text) }
            Result::Err(error) => { Result::Err(TestError::other(error.describe())) }
        };
    }

    private static done(result: Result<(), String>) -> Result<(), TestError> {
        return match (result) {
            Result::Ok(_)       => { Result::Ok(()) }
            Result::Err(reason) => { Result::Err(TestError::other(reason.as_str())) }
        };
    }

    private static pruned(store: &RecordStore, now: i64) -> Result<i64, TestError> {
        return match (store.prune(now)) {
            Result::Ok(count)   => { Result::Ok(count) }
            Result::Err(reason) => { Result::Err(TestError::other(reason.as_str())) }
        };
    }

    private static key(root: Path, git: &Git, compiler: Path, toolchain: &HostToolchain, gates: &Array<String>, triple: Str) -> Result<String, TestError> {
        return match (TreeRunCache::of(root, git, compiler, toolchain, gates, triple)) {
            Result::Ok(cache)   => { Result::Ok(cache.key.clone()) }
            Result::Err(reason) => { Result::Err(TestError::other(reason.as_str())) }
        };
    }

    /// The hex digest `TreeRunCache::feed_inputs` gives the checkout `root`.
    private static inputs(root: Path, git: &Git) -> Result<String, TestError> {
        mut hasher: Sha256 = Sha256::new();
        return match (TreeRunCache::feed_inputs(&hasher, root, git)) {
            Result::Ok(_)       => { Result::Ok(hasher.finish().to_hex()) }
            Result::Err(reason) => { Result::Err(TestError::other(reason.as_str())) }
        };
    }
}
