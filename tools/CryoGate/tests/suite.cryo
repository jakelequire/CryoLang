///! The unit-suite judge: a run is accepted only with PASS, a `passed`
///! count matching the `ok` lines, and at least one test.
![config(testing)]
namespace cryogate::tests::suite;

import std::collections::str::{ Str };
import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect };

import cryogate::core::suite::{ UnitSuite };

![test]
function a_passing_run_is_counted() -> Result<(), TestError> {
    const output: Str = Str::new("ok    a::b\r\nok    a::c\r\n  unit test summary\r\n    passed        2\r\n    failed        0\r\n  OVERALL  PASS  (unit: ok)\r\n");
    return expect(UnitSuite::judge(output, Str::new("log")).unwrap_or(-1) == 2, Str::new("two tests counted"));
}

![test]
function a_run_with_no_tests_is_refused() -> Result<(), TestError> {
    const output: Str = Str::new("  unit test summary\n    passed        0\n    failed        0\n  OVERALL  PASS  (unit: ok)\n");
    return expect(UnitSuite::judge(output, Str::new("log")).is_err(), Str::new("zero tests is not a pass"));
}

![test]
function a_count_that_disagrees_with_the_lines_is_refused() -> Result<(), TestError> {
    const output: Str = Str::new("ok    a::b\n    passed        2\n  OVERALL  PASS  (unit: ok)\n");
    return expect(UnitSuite::judge(output, Str::new("log")).is_err(), Str::new("2 passed over 1 ok line"));
}

![test]
function a_run_without_the_overall_verdict_is_refused() -> Result<(), TestError> {
    const output: Str = Str::new("ok    a::b\n    passed        1\n");
    return expect(UnitSuite::judge(output, Str::new("log")).is_err(), Str::new("no OVERALL PASS"));
}

![test]
function a_failing_run_is_refused() -> Result<(), TestError> {
    const output: Str = Str::new("ok    a::b\n    passed        1\n    failed        1\n  OVERALL  FAIL\n");
    return expect(UnitSuite::judge(output, Str::new("log")).is_err(), Str::new("OVERALL FAIL"));
}
