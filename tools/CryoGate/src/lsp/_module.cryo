///! The language server's checks: what is sent and read, and what each
///! check requires of an answer.  The files depend on each other in the order
///! listed, and run no server (`lsp/run/` does).
///!
///!   reading   `Reading`: fields of a parsed message by dotted path
///!   wire      `Frames`, `FrameBuffer`: framing a message and cutting
///!             arriving bytes back into bodies; `Locations`, `Position`:
///!             URIs and UTF-16 positions
///!   fixture   `Fixture`: a fixture's `checks.json`, files and markers
///!   judges    `Judges`: each kind of check's judgement of an answer
///!   build     `LspBuild`: what a build of the server reported, judged
namespace cryogate::lsp;

internal module {
    reading;
    wire;
    fixture;
    judges;
    build;
    run;
}
