///! Reading a JSON message: a value reached by a dotted path of object keys,
///! and the text, number or list it holds, each `None` (or empty) when the
///! message holds something else there.  A server's answer is read field by
///! field, and a field of the wrong shape reads as absent rather than
///! ending the run.

namespace cryogate::lsp::reading;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::encoding::json::serializer;
import std::encoding::json::value::{ JsonExtract, JsonValue };

/// Field access on a parsed message.
public type struct Reading {
    /// The value below `value` at `path`, object keys separated by `.`
    /// (`result.capabilities`); the empty path is `value` itself.
    public static at(value: JsonValue*, path: Str) -> Option<JsonValue*> {
        mut current: JsonValue* = value;
        for (key in path.split_nonempty(&Str::new("."))) {
            if (!current.is_object()) { return Option::None; }
            current = current.get(key)?;
        }
        return Option::Some(current);
    }

    /// The string at `path`, or the empty text.
    public static text(value: JsonValue*, path: Str) -> Str {
        return match (Reading::at(value, path)) {
            Option::Some(found) => { found.as::<Str>().unwrap_or(Str::new("")) }
            Option::None        => { Str::new("") }
        };
    }

    /// Whether `path` holds a string.
    public static has_text(value: JsonValue*, path: Str) -> boolean {
        return match (Reading::at(value, path)) {
            Option::Some(found) => { found.is_string() }
            Option::None        => { false }
        };
    }

    /// The integer at `path`.
    public static integer(value: JsonValue*, path: Str) -> Option<i64> {
        const found: JsonValue* = Reading::at(value, path)?;
        return match (found) {
            JsonValue::Number(number) => { number.as_i64() }
            _                         => { Option::None }
        };
    }

    /// Whether `path` is present and not JSON `null`.
    public static present(value: JsonValue*, path: Str) -> boolean {
        return match (Reading::at(value, path)) {
            Option::Some(found) => { !found.is_null() }
            Option::None        => { false }
        };
    }

    /// The elements of the array at `path`; none when it is not an array.
    public static elements(value: JsonValue*, path: Str) -> Array<JsonValue*> {
        mut found: Array<JsonValue*> = Array::<JsonValue*>::new();
        match (Reading::at(value, path)) {
            Option::Some(list) => {
                if (list.is_array()) {
                    for (mut index: i64 = 0; index < list.length(); index++) { found.push(list.at(index).unwrap()); }
                }
            }
            Option::None => { }
        }
        return found;
    }

    /// The strings of the array at `path`, its other elements left out.
    public static texts(value: JsonValue*, path: Str) -> Array<String> {
        mut found: Array<String> = Array::<String>::new();
        for (element in Reading::elements(value, path).iterate_references()) {
            match ((*element).as::<Str>()) {
                Option::Some(text) => { found.push(String::from_str(text)); }
                Option::None       => { }
            }
        }
        return found;
    }

    /// The keys of the object at `path`, in their order; none when it is not
    /// an object.
    public static keys(value: JsonValue*, path: Str) -> Array<String> {
        mut found: Array<String> = Array::<String>::new();
        match (Reading::at(value, path)) {
            Option::Some(object) => {
                match (object) {
                    JsonValue::Object(fields) => {
                        for (mut index: i64 = 0; index < fields.length(); index++) {
                            found.push(String::from_str(fields.key_at(index).unwrap()));
                        }
                    }
                    _ => { }
                }
            }
            Option::None => { }
        }
        return found;
    }

    /// `value` written back as compact JSON text, for a failure's detail.
    public static shown(value: Option<JsonValue*>) -> String {
        return match (value) {
            Option::Some(found) => { Reading::clipped(serializer::stringify(found).as_str()) }
            Option::None        => { String::from_str(Str::new("None")) }
        };
    }

    /// `text` cut to the first 300 bytes, for a failure's detail.
    public static clipped(text: Str) -> String {
        if (text.length() <= 300) { return String::from_str(text); }
        return f"{text.byte_substring(0, 300)}...";
    }
}
