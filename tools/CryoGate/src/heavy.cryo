///! `cryogate heavy [--no-wait] -- <program> [arguments]`: run one heavy
///! proof under the heavy-run lock.
///!
///! The lock is taken (waited for unless `--no-wait`), the program runs with
///! cryogate's console, and the lock is released when it ends, whatever its
///! exit.  cryogate exits with the program's code.  The lock names its
///! holder as `CRYOGATE_OWNER` says, or as the checkout, followed by the
///! command line.

namespace cryogate::heavy;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::mem;
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::env;
import std::fmt;
import std::fs::path::{ Path, PathBuf };

import cryogate::core::child::{ Completion, Job, Outcome };
import cryogate::core::lock::{ HeavyLock };
import cryogate::core::options::{ Options, Parsed };

public type struct Heavy {
    public static run(repository: Path, arguments: &Array<String>, first: i64) -> i32 {
        mut options: Options = Options::new(Str::new("cryogate heavy [--no-wait] -- <program> [arguments]"));
        options.flag(Str::new("--no-wait"));
        const parsed: Parsed = match (options.parse(arguments, first)) {
            Result::Ok(parsed)  => { parsed }
            Result::Err(reason) => { fmt::eprintln(f"cryogate heavy: {reason.as_str()}"); return 2; }
        };
        if (!parsed.positionals().is_empty()) {
            fmt::eprintln(f"cryogate heavy: `{parsed.positionals().get_ref(0).unwrap().as_str()}` before `--`; usage: {options.usage()}");
            return 2;
        }
        if (parsed.rest().is_empty()) {
            fmt::eprintln(f"cryogate heavy: no program after `--`; usage: {options.usage()}");
            return 2;
        }
        const wait: boolean = !parsed.has(Str::new("--no-wait"));
        mut job: Job = Job::new(parsed.rest().get_ref(0).unwrap().as_str());
        mut argument: i64 = 1;
        while (argument < parsed.rest().length()) {
            job.argument(parsed.rest().get_ref(argument).unwrap().as_str());
            argument++;
        }
        const owner: String = match (env::var(Str::new("CRYOGATE_OWNER"))) {
            Option::Some(name) => { f"{name.as_str()} - {job.command_line().as_str()}" }
            Option::None       => { f"cryogate in {repository.as_str()} - {job.command_line().as_str()}" }
        };
        const path: PathBuf = match (HeavyLock::default_path(repository)) {
            Result::Ok(path)    => { path }
            Result::Err(reason) => { fmt::eprintln(f"cryogate heavy: {reason.as_str()}"); return 1; }
        };
        const lock: HeavyLock = match (HeavyLock::acquire(path.as_path(), owner.as_str(), wait)) {
            Result::Ok(lock)    => { lock }
            Result::Err(reason) => { fmt::eprintln(f"cryogate heavy: {reason.as_str()}"); return 1; }
        };
        fmt::eprintln(f"cryogate heavy: holding the heavy-run lock {path.as_path().as_str()}");
        const done: Completion = job.run();
        mem::drop(lock);
        return match (done.outcome) {
            Outcome::Exited(code) => { code }
            _ => {
                fmt::eprintln(f"cryogate heavy: `{job.command_line().as_str()}`: {done.outcome.describe().as_str()}");
                1
            }
        };
    }
}
