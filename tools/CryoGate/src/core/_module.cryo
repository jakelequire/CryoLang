///! The core: what every gate is built from, and nothing gate-specific.  It
///! imports only the standard library, and every other layer may use it.
///!
///!   child     one child process: argv, cwd, environment, log, time limit,
///!             and how it ended
///!   schedule  jobs run concurrently within CPU and memory budgets
///!   lock      the heavy-run lock shared by every checkout on the machine
///!   log       a run's log directory, the newest runs kept
///!   options   a subcommand's command line
///!   host      the host OS, executable names, the repository root
///!   git       git as a child process
///!   tree      sorted, `/`-separated directory listings
///!   text      lines, sorting, joining and a byte scanner
///!   suite     the unit-test runner's report, judged
namespace cryogate::core;

internal module {
    child;
    schedule;
    lock;
    log;
    options;
    host;
    git;
    tree;
    text;
    suite;
}
