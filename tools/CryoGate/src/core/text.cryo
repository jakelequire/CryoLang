///! Text a gate reads from a child's output or prints in its report.

namespace cryogate::core::text;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };

public type struct Text {
    /// The lines of `text`, a `\r` before each line break dropped, and no
    /// empty last line for a text that ends with a line break.
    public static lines(text: Str) -> Array<String> {
        mut lines: Array<String> = Array::<String>::new();
        for (line in text.split(&Str::new("\n"))) {
            match (line.strip_suffix(&Str::new("\r"))) {
                Option::Some(bare) => { lines.push(String::from_str(bare)); }
                Option::None       => { lines.push(String::from_str(line)); }
            }
        }
        if (!lines.is_empty() && lines.get_ref(lines.length() - 1).unwrap().is_empty()) { lines.pop(); }
        return lines;
    }

    /// `parts` with `separator` between each two.
    public static joined(parts: &Array<String>, separator: Str) -> String {
        mut out: String = String::new();
        mut first: boolean = true;
        for (part in parts.iter_ref()) {
            if (!first) { out.push(separator); }
            out.push(part.as_str());
            first = false;
        }
        return out;
    }
}
