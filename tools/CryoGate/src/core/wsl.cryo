///! WSL from a Windows host, as child processes of `wsl.exe`: starting it,
///! the path a Windows path has inside it, and the paths below a directory
///! mapped once that is known.

namespace cryogate::core::wsl;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::clone::{ Clone };
import std::core::result::{ Result };

import cryogate::core::child::{ Completion, Job };
import cryogate::core::log::{ RunLogs };

/// WSL, driven through `wsl.exe`.
public type struct Wsl {
    /// Start WSL's default distribution and wait for it: after a reboot it
    /// is stopped, and the first command run in it starts it.  Its
    /// completion, logged to `logs`.
    public static start(logs: &RunLogs) -> Completion {
        mut job: Job = Job::new(Str::new("wsl.exe"));
        job.argument(Str::new("-e"));
        job.argument(Str::new("true"));
        job.log_to(logs.file(Str::new("wsl-start")).as_str());
        return job.run();
    }

    /// Whether a WSL distribution is running, asked without starting one:
    /// `wsl.exe --list --running` exits 0 only while one runs.  A host
    /// with no `wsl.exe` has none running.
    public static running(logs: &RunLogs) -> boolean {
        mut job: Job = Job::new(Str::new("wsl.exe"));
        job.argument(Str::new("--list"));
        job.argument(Str::new("--running"));
        job.log_to(logs.file(Str::new("wsl-running")).as_str());
        return job.run().outcome.succeeded();
    }

    /// The path `path` has inside WSL (`wslpath -a`).  Its separators are
    /// made `/` first: wsl.exe rebuilds its arguments into a command line,
    /// on which `C:\Programming` arrives as `C:Programming`.  The
    /// completion of `wslpath` when it gave no path.
    public static path(path: Str, logs: &RunLogs) -> Result<String, Completion> {
        mut job: Job = Job::new(Str::new("wsl.exe"));
        job.argument(Str::new("--"));
        job.argument(Str::new("wslpath"));
        job.argument(Str::new("-a"));
        job.argument(path.replace("\\", "/").as_str());
        job.log_to(logs.file(Str::new("wslpath")).as_str());
        job.errors_to(logs.file(Str::new("wslpath-errors")).as_str());
        const done: Completion = job.run();
        const answer: String = String::from_str(done.output().as_str().trim());
        if (!done.outcome.succeeded() || answer.is_empty()) { return Result::Err(done); }
        return Result::Ok(answer);
    }
}

/// A Windows directory and the path it has inside WSL, so that a path
/// below it is named inside WSL without asking `wslpath` again.
public type struct WslMapping {
    /// The directory as Windows names it.
    public windows: String;
    /// The same directory inside WSL (`/mnt/c/...`).
    public inside: String;

    /// The path `path`, below `windows`, has inside WSL: the part after
    /// `windows` put after `inside`, its separators made `/`.  A path not
    /// below `windows` is given back as it is, separators made `/`.
    public path(&this, path: Str) -> String {
        const windows: String = this.windows.as_str().replace("\\", "/");
        const given: String = path.replace("\\", "/");
        if (!given.as_str().starts_with(windows.as_str())) { return given; }
        return f"{this.inside.as_str()}{given.as_str().byte_substring(windows.length(), given.length())}";
    }
}

/// A mapping copied whole: every configuration built inside WSL carries one.
implement trait Clone for WslMapping {
    clone(&this) -> WslMapping {
        return WslMapping { windows: this.windows.clone(), inside: this.inside.clone() };
    }
}
