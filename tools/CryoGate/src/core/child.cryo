///! Running one program as a child process: its arguments, directory and
///! environment, where its output goes, how long it may take, and what
///! became of it.
///!
///! Both output streams go to one log file, interleaved as written, or to
///! cryogate's own console.  Output a gate needs to read is read back from
///! the log: a file never fills and blocks the child the way an undrained
///! pipe does.

namespace cryogate::core::child;

import std::collections::array::{ Array };
import std::collections::pair::{ Pair };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::clone::{ Clone };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::env;
import std::fs::file::{ File };
import std::fs::path::{ Path, PathBuf };
import std::io::error::{ IoError };
import std::process::child::{ Child, ExitStatus };
import std::process::command::{ Command, Stdio };
import std::time::clock::{ Instant };
import std::time::duration::{ Duration };

import cryogate::core::host::{ Host };
import cryogate::core::text::{ Text };

/// What became of a job.
public type enum Outcome {
    /// The program ran and exited with this code.
    Exited(i32);
    /// The program was ended by this signal (POSIX).
    Signalled(i32);
    /// The program ran past its limit and was killed.
    TimedOut;
    /// The program never ran: the reason it could not be started.
    CouldNotStart(String);
}

implement enum Outcome {
    /// Whether the program ran and exited 0.
    public succeeded(&this) -> boolean {
        return match (&this) {
            Outcome::Exited(code) => { code == 0 }
            _                     => { false }
        };
    }

    /// The code the program exited with; `None` when it did not exit.
    public exit_code(&this) -> Option<i32> {
        return match (&this) {
            Outcome::Exited(code) => { Option::Some(code) }
            _                     => { Option::None }
        };
    }

    /// The outcome as a report writes it: `exit 0`, `signal 9`,
    /// `timed out`, `could not start: <reason>`.
    public describe(&this) -> String {
        return match (&this) {
            Outcome::Exited(code)          => { f"exit {code}" }
            Outcome::Signalled(signal)     => { f"signal {signal}" }
            Outcome::TimedOut              => { String::from_str(Str::new("timed out")) }
            Outcome::CouldNotStart(reason) => { f"could not start: {reason.as_str()}" }
        };
    }

    private static from_status(status: &ExitStatus) -> Outcome {
        match (status.exit_code()) {
            Option::Some(code) => { return Outcome::Exited(code); }
            Option::None       => { }
        }
        return match (status.terminating_signal()) {
            Option::Some(signal) => { Outcome::Signalled(signal) }
            Option::None         => { Outcome::CouldNotStart(String::from_str(Str::new("the system reported neither an exit code nor a signal"))) }
        };
    }
}

/// An outcome copied whole: one read again under another meaning (a
/// configuration's) is still the child's.
implement trait Clone for Outcome {
    clone(&this) -> Outcome {
        return match (&this) {
            Outcome::Exited(code)          => { Outcome::Exited(code) }
            Outcome::Signalled(signal)     => { Outcome::Signalled(signal) }
            Outcome::TimedOut              => { Outcome::TimedOut }
            Outcome::CouldNotStart(reason) => { Outcome::CouldNotStart(reason.clone()) }
        };
    }
}

/// A finished job.
public type struct Completion {
    public outcome: Outcome;
    /// Wall-clock time from the start to the end.
    public seconds: f64;
    /// The log the output stream was written to, with the error stream
    /// unless the job sent that elsewhere; empty when the job wrote to the
    /// console.
    public log: String;

    /// The job's whole output, as the log holds it.  Empty when the job
    /// wrote to the console or the log cannot be read.
    public output(&this) -> String {
        if (this.log.is_empty()) { return String::new(); }
        return match (File::read_text(Path::from(this.log.as_str()))) {
            Result::Ok(text) => { text }
            Result::Err(_)   => { String::new() }
        };
    }
}

/// A job that has been started and not yet finished.
public type struct Running {
    child: Child;
    started: Instant;
    limit: Option<Duration>;
    log: String;
    /// Whether the child roots a process tree, killed whole at the limit.
    tree: boolean;

    /// The job's completion once it has finished, `None` while it runs.  A
    /// job past its limit is killed here, with every process it started
    /// when it roots a tree, and completes as `TimedOut`.
    public poll(mut &this) -> Option<Completion> {
        match (this.child.try_wait()) {
            Result::Ok(Option::Some(status)) => { return Option::Some(this.complete(Outcome::from_status(&status))); }
            Result::Ok(Option::None)         => { }
            Result::Err(error)               => { return Option::Some(this.complete(Outcome::CouldNotStart(f"waiting for it failed: {error.describe()}"))); }
        }
        match (this.limit) {
            Option::Some(limit) => {
                if (this.started.elapsed() >= limit) {
                    // The verdict is `TimedOut` whatever the kill and the
                    // reap report.
                    const _: Result<(), IoError> = if (this.tree) { this.child.kill_tree() } else { this.child.kill() };
                    const _: Result<ExitStatus, IoError> = this.child.wait();
                    return Option::Some(this.complete(Outcome::TimedOut));
                }
            }
            Option::None => { }
        }
        return Option::None;
    }

    /// Block until the job finishes.
    public wait(mut &this) -> Completion {
        loop {
            match (this.poll()) {
                Option::Some(done) => { return done; }
                Option::None       => { std::time::clock::sleep(Duration::from_milliseconds(Running::POLL_MILLISECONDS)); }
            }
        }
    }

    private complete(&this, outcome: Outcome) -> Completion {
        return Completion {
            outcome: outcome,
            seconds: this.started.elapsed().as_seconds_f64(),
            log:     this.log.clone(),
        };
    }

    /// How often a waiting job is looked at.
    public const POLL_MILLISECONDS: u64 = 5;
}

/// One program to run, and how.
public type struct Job {
    program: String;
    arguments: Array<String>;
    directory: Option<String>;
    removed: Array<String>;
    added: Array<Pair<String, String>>;
    log: String;
    errors: String;
    limit: Option<Duration>;
    tree: boolean;

    /// A job running `program`, writing to the console.  A program named by
    /// a path is resolved against the current directory now, so a job run
    /// in another directory still finds it; a bare name is looked up on
    /// `PATH` when it starts.
    public static new(program: Str) -> Job {
        return Job {
            program:   Job::resolve(program),
            arguments: Array::<String>::new(),
            directory: Option::None,
            removed:   Array::<String>::new(),
            added:     Array::<Pair<String, String>>::new(),
            log:       String::new(),
            errors:    String::new(),
            limit:     Option::None,
            tree:      false,
        };
    }

    public argument(mut &this, value: Str) -> void { this.arguments.push(String::from_str(value)); }

    /// Run in `path` instead of the current directory.
    public directory(mut &this, path: Str) -> void { this.directory = Option::Some(String::from_str(path)); }

    /// Leave the inherited variable `name` out of the child's environment.
    public remove_variable(mut &this, name: Str) -> void { this.removed.push(String::from_str(name)); }

    /// Set `name` to `value` in the child's environment.
    public set_variable(mut &this, name: Str, value: Str) -> void {
        this.added.push(Pair::new(String::from_str(name), String::from_str(value)));
    }

    /// Set `name` to `value` in the child's environment unless cryogate
    /// inherited a value for it, which the child then inherits too.
    public default_variable(mut &this, name: Str, value: Str) -> void {
        match (env::var(name)) {
            Option::Some(_) => { }
            Option::None    => { this.set_variable(name, value); }
        }
    }

    /// For a compiler job: name the C driver it links with where the host
    /// needs it named, `CRYO_CC=gcc` on Windows unless cryogate inherited
    /// a choice.  Elsewhere the compiler's own default stands.
    ![target(windows)]
    public default_c_compiler(mut &this) -> void { this.default_variable(Str::new("CRYO_CC"), Str::new("gcc")); }
    ![target(unix)]
    public default_c_compiler(mut &this) -> void { }

    /// For a job running a compiler that keeps its libraries beside itself:
    /// give it `LibrarySearch::variables()`, so a library missing there
    /// stops the compiler starting instead of being loaded from a directory
    /// on PATH.  A POSIX compiler is not searched for that way, and nothing
    /// changes.
    ![target(windows)]
    public load_libraries_beside(mut &this) -> void {
        for (variable in LibrarySearch::variables().iterate_references()) {
            this.set_variable(variable.first.as_str(), variable.second.as_str());
        }
    }
    ![target(unix)]
    public load_libraries_beside(mut &this) -> void { }

    /// Write both output streams to the file `path`, created or truncated.
    public log_to(mut &this, path: Str) -> void { this.log = String::from_str(path); }

    /// Write the error stream to the file `path` instead, created or
    /// truncated, so the log holds the output stream alone.
    public errors_to(mut &this, path: Str) -> void { this.errors = String::from_str(path); }

    /// Kill the job and report it `TimedOut` once it has run this long.
    public limit(mut &this, limit: Duration) -> void { this.limit = Option::Some(limit); }

    /// Start the job as the root of a process tree every process it starts
    /// joins, so a job past its limit is killed with all of them: a child
    /// that runs children of its own (a cryogate gate) leaves none behind.
    public root_tree(mut &this) -> void { this.tree = true; }

    /// The program and its arguments as one line, for a report.
    public command_line(&this) -> String {
        mut line: String = this.program.clone();
        for (argument in this.arguments.iterate_references()) {
            line.push(' ');
            line.push(argument.as_str());
        }
        return line;
    }

    /// Start the job.  A job that cannot be started is returned as its
    /// completion, `CouldNotStart` with the reason.
    public start(&this) -> Result<Running, Completion> {
        const started: Instant = Instant::now();
        if (!this.program_exists()) {
            return Result::Err(this.never_ran(started, f"{this.program.as_str()} does not exist"));
        }
        mut command: Command = Command::new(this.program.as_str());
        for (argument in this.arguments.iterate_references()) { command.argument(argument.as_str()); }
        match (&this.directory) {
            Option::Some(path) => { command.current_directory(path.as_str()); }
            Option::None       => { }
        }
        this.build_environment(&command);
        command.stdin(Stdio::Null);
        if (this.tree) { command.group_descendants(); }
        if (!this.log.is_empty()) {
            match (File::create(Path::from(this.log.as_str()))) {
                Result::Ok(file) => {
                    mut owned: File = file;
                    command.stdout(Stdio::Fd(owned.into_descriptor()));
                    command.stderr(Stdio::SameAsStdout);
                }
                Result::Err(error) => {
                    return Result::Err(this.never_ran(started, f"cannot create its log {this.log.as_str()}: {error.describe()}"));
                }
            }
        }
        if (!this.errors.is_empty()) {
            match (File::create(Path::from(this.errors.as_str()))) {
                Result::Ok(file) => {
                    mut owned: File = file;
                    command.stderr(Stdio::Fd(owned.into_descriptor()));
                }
                Result::Err(error) => {
                    return Result::Err(this.never_ran(started, f"cannot create its error log {this.errors.as_str()}: {error.describe()}"));
                }
            }
        }
        return match (command.spawn()) {
            Result::Ok(child) => {
                Result::Ok(Running { child: child, started: started, limit: this.limit, log: this.log.clone(), tree: this.tree })
            }
            Result::Err(error) => {
                Result::Err(this.never_ran(started, String::from_str(error.describe())))
            }
        };
    }

    /// Run the job to its end.
    public run(&this) -> Completion {
        return match (this.start()) {
            Result::Ok(mut running) => { running.wait() }
            Result::Err(done)   => { done }
        };
    }

    private never_ran(&this, started: Instant, reason: String) -> Completion {
        return Completion {
            outcome: Outcome::CouldNotStart(reason),
            seconds: started.elapsed().as_seconds_f64(),
            log:     this.log.clone(),
        };
    }

    /// Whether a program named by a path is there.  A bare name is left to
    /// the system's own search.  Without this a POSIX host reports a missing
    /// program as the child's exit 127, which reads as the program's own
    /// failure.
    private program_exists(&this) -> boolean {
        const program: Path = Path::from(this.program.as_str());
        if (!program.is_absolute()) { return true; }
        if (program.is_file()) { return true; }
        return Path::from(Host::executable_name(program.as_str()).as_str()).is_file();
    }

    /// Inherit the environment, less the removed names, plus the added
    /// ones (on Windows a name matches whatever its case).
    private build_environment(&this, command: mut &Command) -> void {
        for (name in this.removed.iterate_references()) { command.env_remove(name.as_str()); }
        for (variable in this.added.iterate_references()) {
            command.env(variable.first.as_str(), variable.second.as_str());
        }
    }

    /// A program spelled with a directory separator is a path; it is made
    /// absolute against the current directory.  A bare name stays a name.
    private static resolve(program: Str) -> String {
        mut has_separator: boolean = false;
        for (byte in program.as_bytes().iter()) {
            if (Path::is_separator(byte)) { has_separator = true; }
        }
        if (!has_separator) { return String::from_str(program); }
        return Host::absolute(program);
    }
}

/// Where a Windows compiler that keeps `LLVM-C.dll` and `libclang.dll`
/// beside itself finds them.  Windows looks for a library in the program's
/// own directory and then on PATH, so a directory there holding either
/// would let the compiler start without its own copy, against another
/// build's.
public type struct LibrarySearch {
    /// The variables that leave a child only the copies beside its
    /// compiler: `CRYO_CC` and `CRYO_AR`, the C driver and the archiver
    /// named by the absolute path the inherited PATH gives them - they may
    /// live in a directory holding a library (msys's mingw64\bin holds gcc,
    /// ar and libclang.dll) - then `PATH`, the inherited one less every
    /// directory holding either library.
    public static variables() -> Array<Pair<String, String>> {
        const inherited: String = match (env::var(Str::new("PATH"))) {
            Option::Some(value) => { value }
            Option::None        => { String::new() }
        };
        mut variables: Array<Pair<String, String>> = Array::<Pair<String, String>>::new();
        mut drivers: Array<Str> = Array::<Str>::new();
        drivers.push(Str::new("gcc"));
        variables.push(Pair::new(String::from_str(Str::new("CRYO_CC")),
                                 LibrarySearch::named_program(inherited.as_str(), Str::new("CRYO_CC"), &drivers)));
        mut archivers: Array<Str> = Array::<Str>::new();
        archivers.push(Str::new("ar"));
        archivers.push(Str::new("llvm-ar"));
        archivers.push(Str::new("llvm-ar-20"));
        variables.push(Pair::new(String::from_str(Str::new("CRYO_AR")),
                                 LibrarySearch::named_program(inherited.as_str(), Str::new("CRYO_AR"), &archivers)));
        variables.push(Pair::new(String::from_str(Str::new("PATH")),
                                 LibrarySearch::search_path_without(inherited.as_str(), Str::new(";"), &LibrarySearch::libraries())));
        return variables;
    }

    /// The libraries a Windows compiler loads, by file name.
    public static libraries() -> Array<Str> {
        mut libraries: Array<Str> = Array::<Str>::new();
        libraries.push(Str::new("LLVM-C.dll"));
        libraries.push(Str::new("libclang.dll"));
        return libraries;
    }

    /// The search path `search`, its directories separated by `separator`,
    /// less every directory holding a file named in `libraries` and every
    /// empty entry, in the order given.
    public static search_path_without(search: Str, separator: Str, libraries: &Array<Str>) -> String {
        mut kept: Array<String> = Array::<String>::new();
        for (entry in search.split_nonempty(&separator)) {
            mut supplies: boolean = false;
            for (library in libraries.iterate_references()) {
                if (Path::from(entry).join(*library).as_path().is_file()) { supplies = true; }
            }
            if (!supplies) { kept.push(String::from_str(entry)); }
        }
        return Text::joined(&kept, separator);
    }

    /// The program a compiler runs for the role the variable `variable`
    /// names (`CRYO_CC`, `CRYO_AR`): the variable's own value when it is
    /// set, else the first of `defaults` found, as the compiler tries them.
    /// A bare name is given the absolute path of the first `;`-separated
    /// directory of `search` holding it (with `.exe` when it names no
    /// extension); a path, or a name found nowhere, is kept as it is, and
    /// the compiler that cannot start it says so.
    public static named_program(search: Str, variable: Str, defaults: &Array<Str>) -> String {
        mut names: Array<String> = Array::<String>::new();
        match (env::var(variable)) {
            Option::Some(value) => { names.push(value); }
            Option::None        => { for (name in defaults.iterate_references()) { names.push(String::from_str(*name)); } }
        }
        for (name in names.iterate_references()) {
            match (LibrarySearch::located(search, name.as_str())) {
                Option::Some(found) => { return found; }
                Option::None        => { }
            }
        }
        return names.get_reference(0).unwrap().clone();
    }

    /// The absolute path of the program `name` in the first `;`-separated
    /// directory of `search` holding it, trying `name.exe` when `name` has
    /// no extension; `None` for a name that is already a path, or one no
    /// directory holds.
    public static located(search: Str, name: Str) -> Option<String> {
        if (name.contains(&Str::new("/")) || name.contains(&Str::new("\\"))) { return Option::None; }
        const file: String = if (Path::from(name).extension().is_some()) { String::from_str(name) } else { f"{name}.exe" };
        for (entry in search.split_nonempty(&Str::new(";"))) {
            const candidate: PathBuf = Path::from(entry).join(file.as_str());
            if (candidate.as_path().is_file()) { return Option::Some(String::from_str(candidate.as_path().as_str())); }
        }
        return Option::None;
    }
}
