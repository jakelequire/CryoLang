///! The runtime's freestanding check: its programs and its judgements.  Pure;
///! it runs no compiler.  It uses the core and nothing above it, and its
///! files depend on each other in the order listed:
///!
///!   programs  `FreestandingPrograms`: each check's program and project file
///!   checks    `FreestandingJudge`, `CheckLine`, `FreestandingVerdict`: what
///!             each program must exit with and print, spelled as the report
///!             writes it, and the run's verdict
///!
///! The run itself, which builds, links and runs them, is the directory
///! `run/`, after both.
namespace cryogate::freestanding;

internal module {
    programs;
    checks;
    run;
}
