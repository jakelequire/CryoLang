///! The incremental-build matrix's decisions: the source edits and how two
///! builds' outputs compare.  Pure over text and files handed in; it runs no
///! compiler.  It uses the core and nothing above it, and its files depend
///! on each other in the order listed:
///!
///!   edits      `SourceEdit`, `EditKind`: the files the matrix edits, how,
///!              and the text each edit makes of a file
///!   snapshots  `BuildSnapshot`, `SnapshotComparison`: a build's program
///!              and objects as digests, and an incremental build judged
///!              against a clean one
///!
///! The run itself, which starts the compiler, is the directory `run/`,
///! after both.
namespace cryogate::incremental;

internal module {
    edits;
    snapshots;
    run;
}
