///! selfhost's decisions: what each arm builds and compares, and how its
///! results are judged.  Everything here is pure over paths, lists and files
///! handed in; it runs no compiler.  It uses the core and nothing above it,
///! and its files depend on each other in the order listed:
///!
///!   stages    `Stage`, `ArmPlan`: an arm's stages, its directories and
///!             the compilers it builds
///!   trees     `ModuleTrees`, `TreeComparison`, `TreeSize`: two stages'
///!             per-module output trees compared file by file
///!   archives  `StageArchives`, `ArchiveComparison`: the stdlib archive
///!             each stage compiler built, and stage 2's against stage 3's
///!   digest    `TreeDigest`: the digest of the sources the Linux arm reads
///!   arms      `Arm`, `ArmStatus`, `ArmsVerdict`: what each arm did, and
///!             the run's exit status
///!   judges    `ArmJudge`, `ArmJudgement`, `LinkedIr`: an arm's fixed
///!             point and its stage archives, judged
///!
///! The run itself, which starts the compilers, is the directory `run/`,
///! after all of these.
namespace cryogate::selfhost;

internal module {
    stages;
    trees;
    archives;
    digest;
    arms;
    judges;
    run;
}
