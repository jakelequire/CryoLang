///! A selfhost run itself, where the compilers are started: its files depend
///! on each other in the order listed.
///!
///!   arm  `ArmRun`: one arm's stages, then its fixed point and its stage
///!        archives, judged and reported
///!   wsl  `WslArm`: the Linux arm from a Windows host, inside WSL from a
///!        digest-checked copy of its sources
namespace cryogate::selfhost::run;

internal module {
    arm;
    wsl;
}
