///! The test corpus as the gates read it: what the three suites hold and the
///! roster golden pins (`roster`), and what a census run's output says ran
///! (`census`).  It reads files and text handed in, and runs no compiler.
///! It uses the core only.
///!
///!   roster  `TestGates`, `Roster`, `Discovered`, `Merge`: discovery, the
///!           golden, and a merge into it
///!   census  `CensusReading`, `Summary`, `Pinned`: a runner's output read,
///!           and the golden as this host owes it
namespace cryogate::corpus;

internal module {
    roster;
    census;
}
