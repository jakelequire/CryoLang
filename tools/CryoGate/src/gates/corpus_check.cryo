///! `cryogate corpus-check --cryo <compiler> --work <directory> [--smith
///! <cryosmith>] [--stdlib <directory>] [--first-seed N] [--count K]
///! [--jobs N] [-- <generation options>...]`: CryoSmith's acceptance check,
///! and the check of a compiler against generated programs.
///!
///! CryoSmith writes the programs (`cryosmith batch`, the generation options
///! passed through); each is built at `--opt-level=0` and at
///! `--opt-level=2` and both are run, as smith-diff builds and runs its
///! configurations (`smith/run/programs.cryo`), with these two alone.  A
///! program passes when both builds succeed, both runs exit 0, and both
///! print the same single hash line (`smith/corpus.cryo`).  The builds run
///! `--jobs` at once (default: the scheduler's, `CRYOGATE_JOBS` or the
///! logical CPUs), each in a build directory of its own, then the runs; the
///! report is printed in seed order, so it is the same bytes whatever the
///! count.  A failing program, its executables and a failed build's
///! directory stay in the work directory; a passing program's are removed.
///! Every program terminates by construction, so a run has no time limit:
///! one that does not end is itself a finding.
///!
///! `--expect <file>` checks a pinned corpus (`smith/pinned.cryo`): the
///! seeds and generation options are the file's, cryosmith must be the
///! generator version it was pinned at, and each program must also print
///! the hash line pinned beside its seed.  `--pin <file>` writes that file
///! from a run in which every program passed.

namespace cryogate::gates::corpus_check;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::fmt;
import std::fs::directory::{ Directory };
import std::fs::file::{ File };
import std::fs::path::{ Path, PathBuf };

import cryogate::core::child::{ Completion, Job };
import cryogate::core::host::{ Host };
import cryogate::core::log::{ RunLogs };
import cryogate::core::options::{ Options, Parsed };
import cryogate::smith::corpus::{ CorpusJudge, CorpusLayout };
import cryogate::smith::difference::{ Configuration };
import cryogate::smith::pinned::{ PinnedCorpus };
import cryogate::smith::run::programs::{ Attempt, SmithRun, Stage };

/// `cryogate corpus-check`: the two-configuration case of the programs
/// smith-diff builds, the compiler under test at both levels.
public type struct CorpusCheck {
    /// Run `cryogate corpus-check` with `arguments` from index `first`; 0
    /// when every program passed, 1 when one failed, 2 on a usage error.
    public static run(repository: Path, logs: &RunLogs, arguments: &Array<String>, first: i64) -> i32 {
        mut options: Options = Options::new(Str::new("cryogate corpus-check --cryo <compiler> --work <directory> [--smith <cryosmith>] [--stdlib <directory>] [--jobs N] (--expect <file> | [--first-seed N] [--count K] [--pin <file>] [-- <generation options>...])"));
        options.valued(Str::new("--cryo"));
        options.valued(Str::new("--work"));
        options.valued(Str::new("--smith"));
        options.valued(Str::new("--stdlib"));
        options.valued(Str::new("--first-seed"));
        options.valued(Str::new("--count"));
        options.valued(Str::new("--jobs"));
        options.valued(Str::new("--expect"));
        options.valued(Str::new("--pin"));
        const parsed: Parsed = match (options.parse(arguments, first)) {
            Result::Ok(parsed)  => { parsed }
            Result::Err(reason) => { fmt::eprintln(f"cryogate corpus-check: {reason.as_str()}"); return 2; }
        };
        const compiler: Option<Str> = parsed.value(Str::new("--cryo"));
        const work: Option<Str> = parsed.value(Str::new("--work"));
        const expect: Option<Str> = parsed.value(Str::new("--expect"));
        const pin: Option<Str> = parsed.value(Str::new("--pin"));
        // A pinned corpus names its own seeds and options.
        const chosen: boolean = parsed.value(Str::new("--first-seed")).is_some() || parsed.value(Str::new("--count")).is_some()
            || !parsed.rest().is_empty() || pin.is_some();
        if (compiler.is_none() || work.is_none() || !parsed.positionals().is_empty() || (expect.is_some() && chosen)) {
            fmt::eprintln(f"cryogate corpus-check: usage: {options.usage()}");
            return 2;
        }
        const pinned: Option<PinnedCorpus> = match (expect) {
            Option::Some(path) => {
                const text: String = match (File::read_text(Path::from(Host::absolute(path).as_str()))) {
                    Result::Ok(text)   => { text }
                    Result::Err(error) => { fmt::println(f"corpus-check: FAIL (cannot read the pinned corpus {path}: {error.describe()})"); return 1; }
                };
                match (PinnedCorpus::parse(text.as_str())) {
                    Result::Ok(corpus)  => { Option::Some(corpus) }
                    Result::Err(reason) => { fmt::println(f"corpus-check: FAIL (the pinned corpus {path}: {reason.as_str()})"); return 1; }
                }
            }
            Option::None => { Option::None }
        };
        const first_seed: u64 = match (&pinned) {
            Option::Some(corpus) => { corpus.first_seed }
            Option::None => {
                match (u64::try_from(parsed.value(Str::new("--first-seed")).unwrap_or(Str::new("1")))) {
                    Result::Ok(value) => { value }
                    Result::Err(_)    => { fmt::eprintln(String::from_str(Str::new("cryogate corpus-check: --first-seed takes a number"))); return 2; }
                }
            }
        };
        const count: u64 = match (&pinned) {
            Option::Some(corpus) => { corpus.count() }
            Option::None => {
                match (u64::try_from(parsed.value(Str::new("--count")).unwrap_or(Str::new("200")))) {
                    Result::Ok(value) => { value }
                    Result::Err(_)    => { fmt::eprintln(String::from_str(Str::new("cryogate corpus-check: --count takes a number"))); return 2; }
                }
            }
        };
        const generation: Array<String> = match (&pinned) {
            Option::Some(corpus) => { corpus.options.clone() }
            Option::None         => { parsed.rest().clone() }
        };
        // 0 leaves the scheduler's own count.
        const jobs: i64 = match (parsed.value(Str::new("--jobs"))) {
            Option::Some(text) => {
                match (i64::try_from(text)) {
                    Result::Ok(value) => {
                        if (value < 1) { fmt::eprintln(f"cryogate corpus-check: --jobs takes a count of at least 1, not `{text}`"); return 2; }
                        value
                    }
                    Result::Err(_) => { fmt::eprintln(f"cryogate corpus-check: --jobs takes a number, not `{text}`"); return 2; }
                }
            }
            Option::None => { 0 }
        };
        const default_smith: PathBuf = repository.join(Str::new("tools/CryoSmith/build"));
        const smith: String = match (parsed.value(Str::new("--smith"))) {
            Option::Some(path) => { Host::absolute(path) }
            Option::None       => { Host::executable_name(default_smith.as_path().join(Str::new("cryosmith")).as_path().as_str()) }
        };
        const work_path: PathBuf = PathBuf::from(Host::absolute(work.unwrap()).as_str());
        const tree: String = Host::absolute(compiler.unwrap());
        match (Directory::create_all(work_path.as_path())) {
            Result::Ok(_)      => { }
            Result::Err(error) => { fmt::eprintln(f"cryogate corpus-check: cannot create {work_path.as_path().as_str()}: {error.describe()}"); return 1; }
        }
        // The generator version a pinned corpus is checked at, or pinned at.
        mut generator: i64 = 0;
        if (pinned.is_some() || pin.is_some()) {
            mut version: Job = Job::new(smith.as_str());
            version.argument(Str::new("version"));
            version.log_to(logs.file(Str::new("corpus-version")).as_str());
            const asked: Completion = version.run();
            const printed: String = asked.output();
            const problem: Option<String> = match (&pinned) {
                Option::Some(corpus) => { corpus.version_problem(printed.as_str()) }
                Option::None => {
                    match (PinnedCorpus::generator_of(printed.as_str())) {
                        Result::Ok(found)   => { generator = found; Option::None }
                        Result::Err(reason) => { Option::Some(reason) }
                    }
                }
            };
            match (problem) {
                Option::Some(reason) => { fmt::println(f"corpus-check: FAIL ({reason.as_str()})"); return 1; }
                Option::None         => { }
            }
        }
        // The compiler under test at both levels, with no time limit:
        // every program terminates by construction.
        mut configurations: Array<Configuration> = Array::<Configuration>::new();
        configurations.push(Configuration::compiled(Str::new("tree"), Str::new(""), tree.as_str(), Str::new("0")));
        configurations.push(Configuration::compiled(Str::new("tree"), Str::new(""), tree.as_str(), Str::new("2")));
        const programs: SmithRun = SmithRun {
            configurations: configurations,
            layout:         CorpusLayout::new(work_path.as_path()),
            work:           work_path,
            stdlib:         match (parsed.value(Str::new("--stdlib"))) {
                Option::Some(stdlib) => { Option::Some(String::from_str(stdlib)) }
                Option::None         => { Option::None }
            },
            build_limit:    Option::None,
            run_limit:      Option::None,
            jobs:           jobs,
            log_prefix:     String::from_str(Str::new("corpus")),
        };
        match (programs.write_programs(smith.as_str(), first_seed, count, &generation, logs)) {
            Result::Ok(_)       => { }
            Result::Err(reason) => { fmt::println(f"corpus-check: FAIL ({reason.as_str()})"); return 1; }
        }
        const attempts: Array<Array<Attempt>> = programs.attempts(first_seed, count, logs);
        mut failed: u64 = 0;
        mut hashes: Array<String> = Array::<String>::new();
        mut each: Array<String> = Array::<String>::new();
        mut offset: u64 = 0;
        while (offset < count) {
            const seed: u64 = first_seed.wrapping_add(offset);
            mut verdict: Result<String, String> = CorpusCheck::judge(&attempts[offset as i64]);
            if (verdict.is_ok()) {
                match (programs.remove_executables(seed)) {
                    Result::Ok(_)       => { }
                    Result::Err(reason) => { verdict = Result::Err(reason); }
                }
            }
            match (&pinned) {
                Option::Some(corpus) => {
                    const mismatch: Option<String> = match (&verdict) {
                        Result::Ok(hash) => { corpus.mismatch(seed, hash.as_str()) }
                        Result::Err(_)   => { Option::None }
                    };
                    match (mismatch) {
                        Option::Some(reason) => { verdict = Result::Err(reason); }
                        Option::None         => { }
                    }
                }
                Option::None => { }
            }
            match (verdict) {
                Result::Ok(hash) => {
                    fmt::println(f"ok    seed {seed} {hash.as_str()}");
                    each.push(hash.clone());
                    if (!hashes.contains(&hash)) { hashes.push(hash); }
                }
                Result::Err(reason) => { fmt::println(f"FAIL  seed {seed}: {reason.as_str()}"); failed = failed + 1; }
            }
            offset = offset + 1;
        }
        if (failed > 0) {
            fmt::println(f"corpus-check: FAIL ({failed} of {count} programs)");
            return 1;
        }
        match (pin) {
            Option::Some(path) => {
                const corpus: PinnedCorpus = PinnedCorpus { generator: generator, options: generation, first_seed: first_seed, hashes: each };
                match (File::write_text(Path::from(Host::absolute(path).as_str()), corpus.text().as_str())) {
                    Result::Ok(_)      => { }
                    Result::Err(error) => { fmt::println(f"corpus-check: FAIL (cannot write {path}: {error.describe()})"); return 1; }
                }
                fmt::println(f"corpus-check: OK ({count} programs, -O0 and -O2 agree, {hashes.length()} distinct hashes; pinned at generator version {generator} to {path})");
                return 0;
            }
            Option::None => { }
        }
        if (pinned.is_some()) {
            fmt::println(f"corpus-check: OK ({count} programs, -O0 and -O2 agree and print their pinned hashes, {hashes.length()} distinct hashes)");
            return 0;
        }
        fmt::println(f"corpus-check: OK ({count} programs, -O0 and -O2 agree, {hashes.length()} distinct hashes)");
        return 0;
    }

    /// The hash line both levels of one program printed, or the first
    /// reason they fail: a failed build before a failed run, a failed run
    /// before output that is not one hash line, -O0 before -O2 at each,
    /// then the two lines' agreement.
    private static judge(attempts: &Array<Attempt>) -> Result<String, String> {
        mut stage: i64 = Stage::Build.rank();
        while (stage < Stage::Printed.rank()) {
            for (attempt in attempts.iterate_references()) {
                if (attempt.stage.rank() == stage) { return Result::Err(attempt.reason.clone()); }
            }
            stage++;
        }
        const one: String = attempts[0].observation.detail();
        const two: String = attempts[1].observation.detail();
        CorpusJudge::agree(one.as_str(), two.as_str())?;
        return Result::Ok(one);
    }
}
