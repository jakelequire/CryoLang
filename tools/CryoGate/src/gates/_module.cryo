///! The gates: one file per `cryogate` subcommand, each the command line, the
///! children it runs, and the verdict line it prints.  A gate's decisions
///! live in the layers below it (core, corpus, baseline, verify, selfhost,
///! incremental, freestanding, release, abi), so a gate file is
///! orchestration and printing; no gate imports another.
///!
///!   census    `cryogate census`: the suite run, reconciled with the roster
///!   roster    `cryogate roster`: the discovered roster against the golden
///!   examples  `cryogate examples`: every example built, and optionally run
///!   cross     `cryogate cross`: the other OS's builds, objects only
///!   incr      `cryogate incr`: incremental builds against clean ones
///!   vendor    `cryogate vendor`: every constant shape through `cryo vendor`
///!   pin       `cryogate pin` and `cryogate verify-pin`
///!   verify    `cryogate verify`
///!   selfhost  `cryogate selfhost`: the compiler's fixed point, on both arms
///!   abi       `cryogate abi`: the lang-item registry against the runtime's
///!             archives and the sources
///!   freestanding   `cryogate freestanding`: the runtime's freestanding
///!                  configuration linked with no C library and run
///!   release_smoke  `cryogate release-smoke`: a staged release tree
///!                  compiles and runs a hello-world
namespace cryogate::gates;

internal module {
    census;
    roster;
    examples;
    cross;
    incr;
    vendor;
    pin;
    verify;
    selfhost;
    abi;
    freestanding;
    release_smoke;
}
