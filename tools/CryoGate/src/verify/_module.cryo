///! verify's decisions: what the declaration files declare, the objects it
///! hashes and who owns them, the runtime archives' members, each program's
///! baseline record, the judgements over a baseline census, a declared
///! project's builds and the tree's warnings, and the comparison of the two
///! runs' objects.  Everything here is pure over text, lists and files
///! handed in; it runs no compiler.  It uses the core, the corpus and
///! nothing above them, and its files depend on each other in the order
///! listed:
///!
///!   declarations  `Declarations`, `DeclarationKind`, `RuntimeMember`,
///!                 `DeclaredChanges`
///!   objects       `ObjectOwner`, `ObjectPopulation`
///!   runtime       `RuntimeArchives`: the runtime population's rows
///!   hashing       `ObjectHashes`: every population's rows, and the wipe
///!   record       `BaselineRecord`: one program's record of a baseline
///!   judges        `VerifyJudges`, `BaselineCensus`
///!   comparison    `ObjectComparison`, `Compared`
namespace cryogate::verify;

internal module {
    declarations;
    objects;
    runtime;
    hashing;
    record;
    judges;
    comparison;
}
