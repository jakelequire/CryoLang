///! The baseline compiler: built from a commit's compiler/src and runtime/
///! with the working tree's other build inputs, in a clone below
///! `.verify/`, and kept in a home of its own, `.verify/baseline/<key>`,
///! beside the runtime its programs link and their records.

namespace cryogate::verify::run::compiler;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::fmt;
import std::fs::directory::{ Directory };
import std::fs::file::{ File };
import std::fs::path::{ Path, PathBuf };

import cryogate::baseline::cache::{ BaselineCache };
import cryogate::baseline::clone::{ BaselineClone };
import cryogate::baseline::keys::{ BaselineKey, ProgramStdlib };
import cryogate::core::child::{ Completion, Job };
import cryogate::core::git::{ Git };
import cryogate::core::host::{ Host };
import cryogate::core::log::{ RunLogs };
import cryogate::core::text::{ Text };
import cryogate::core::tree::{ Tree };
import cryogate::verify::record::{ BaselineRecord };
import cryogate::verify::run::children::{ PopulationRun, VerifyChild };
import cryogate::verify::runtime::{ RuntimeArchives };

/// A baseline compiler ready to run.
public type struct BaselineCompiler {
    /// The compiler.
    public compiler: PathBuf;
    /// Its home, `.verify/baseline/<key>`.
    public home: PathBuf;
    /// The commit it was built from, in full.
    public commit: String;
    /// What `CRYO_RUNTIME` names to its programs: the commit's runtime.
    public runtime_home: PathBuf;
    /// The directory the runtime archives its programs link are read from.
    public runtime_archives: PathBuf;
    /// The stdlib its programs build against.
    public stdlib: ProgramStdlib;

    /// The baseline compiler of `revision` in the checkout `repository`,
    /// for the target `triple`: the one in its home when that holds a
    /// compiler and a runtime (and, `stdlib_from_commit`, the commit's
    /// stdlib), else built afresh.  With `stdlib_from_commit` the compiler
    /// is built against the commit's stdlib and its programs build against
    /// it; else both read the checkout's.  Either way the home is stamped
    /// as used and the cache pruned to its most recently used.
    public static obtain(repository: Path, logs: &RunLogs, git: &Git, revision: Str, triple: Str,
                         stdlib_from_commit: boolean) -> Result<BaselineCompiler, String> {
        const commit: String = BaselineKey::commit(git, revision)?;
        const sources: String = BaselineKey::tree_of(git, commit.as_str(), Str::new("compiler/src"))?;
        const runtime: String = BaselineKey::tree_of(git, commit.as_str(), Str::new("runtime"))?;
        const key: String = BaselineKey::of(repository, git, revision, stdlib_from_commit)?;
        const state: PathBuf = repository.join(Str::new(".verify"));
        const homes: PathBuf = state.join(Str::new("baseline"));
        const home: PathBuf = homes.join(key.as_str());
        const compiler: PathBuf = home.join(Host::executable_name(Str::new("cryo")).as_str());
        const runtime_home: PathBuf = home.join(Str::new("runtime"));
        const stdlib: ProgramStdlib = if (stdlib_from_commit) { ProgramStdlib::of_home(home.as_path()) } else { ProgramStdlib::of_checkout(repository) };
        const shown: String = PopulationRun::relative(repository, compiler.as_path().as_str());
        const whose: Str = if (stdlib_from_commit) { Str::new("its own") } else { Str::new("the checkout's") };
        const holds_stdlib: boolean = stdlib.directory.join(Str::new("lib.cryo")).as_path().is_file();
        if (compiler.as_path().is_file() && runtime_home.as_path().is_directory() && holds_stdlib) {
            fmt::println(f"verify: baseline compiler for {revision} (compiler/src {BaselineCompiler::short(sources.as_str())}, runtime {BaselineCompiler::short(runtime.as_str())}, {whose} stdlib) is cached: {shown.as_str()}");
        } else {
            fmt::println(f"verify: building the baseline compiler for {revision} (compiler/src {BaselineCompiler::short(sources.as_str())}, {whose} stdlib) in .verify/src");
            BaselineCompiler::build(repository, logs, commit.as_str(), state.as_path(), home.as_path(), triple, stdlib_from_commit)?;
        }
        BaselineCache::mark(home.as_path())?;
        const _: Array<String> = BaselineCache::prune(homes.as_path(), key.as_str())?;
        // A runtime its compiler builds for itself lands below its sources;
        // a tiered one is a directory of archives per target.
        const archives: PathBuf = if (runtime_home.join(Str::new("lib.cryo")).as_path().is_file()) {
            runtime_home.join(Str::new(".bin")).join(triple)
        } else {
            runtime_home.join(triple)
        };
        return Result::Ok(BaselineCompiler {
            compiler: compiler, home: home, commit: commit, runtime_home: runtime_home, runtime_archives: archives,
            stdlib: stdlib,
        });
    }

    /// Whether this compiler's `cryo test` selects by every pattern it is
    /// given, and not only by its first, which it ignores the rest after.
    /// Asked of its compile-fail suite alone, which builds nothing, in the
    /// checkout `repository`'s tests: a pattern longer than any of the
    /// compile-fail files `negatives` (`negative/<file>`) is named, so no
    /// file holds it, then the first file's name.  Only a compiler that
    /// reads the second pattern runs that file; one that refuses the
    /// question gives it no verdict either.  The run is logged to `log`.
    public takes_several_patterns(&this, repository: Path, negatives: &Array<String>, log: Path) -> boolean {
        if (negatives.is_empty()) { return false; }
        mut longest: Str = Str::new("");
        for (name in negatives.iterate_references()) { if (name.length() > longest.length()) { longest = name.as_str(); } }
        const file: Str = match (negatives[0].as_str().strip_prefix(&Str::new("negative/"))) {
            Option::Some(file) => { file }
            Option::None       => { return false; }
        };
        mut job: Job = VerifyChild::job(this.compiler.as_path().as_str(), this.runtime_home.as_path().as_str(), this.stdlib.variable().as_str());
        job.argument(Str::new("test"));
        job.argument(Str::new("--suite=compile-fail"));
        job.argument(Str::new("--format=plain"));
        job.argument(f"{longest}-unmatched".as_str());
        job.argument(file);
        job.directory(repository.join(Str::new("tests")).as_path().as_str());
        job.log_to(log.as_str());
        const done: Completion = job.run();
        mut asked: Array<String> = Array::<String>::new();
        asked.push(negatives[0].clone());
        return !BaselineRecord::of_census(&Text::lines(done.output().as_str()), &asked, &Array::<String>::new(),
            &Array::<String>::new(), Str::new("")).is_empty();
    }

    /// Build the compiler of `commit` in the clone `<state>/src` and
    /// install it, its runtime and the libraries beside the pins in `home`,
    /// with the commit's stdlib, which the compiler is then built against,
    /// when `stdlib_from_commit`.  The build is always clean: an
    /// incremental one can reuse a module that owns a generic instance a
    /// changed module newly asks for, and the link then fails or links
    /// stale code.
    private static build(repository: Path, logs: &RunLogs, commit: Str, state: Path, home: Path, triple: Str,
                         stdlib_from_commit: boolean) -> Result<(), String> {
        const clone: PathBuf = state.join(Str::new("src"));
        BaselineClone::sync(repository, logs, clone.as_path(), commit, stdlib_from_commit)?;
        BaselineCompiler::remove(clone.join(Str::new("compiler/build")).as_path())?;
        const tiered: boolean = clone.join(Str::new("runtime/hosted/cryoconfig")).as_path().is_file();
        const tiers: String = f".bin/{triple}";
        mut runtime_for_make: String = String::new();
        if (tiered) {
            // The tree's Makefile does not build a tiered runtime: its
            // archives are built by the clone's pin as that layout's own
            // Makefile built them, and the pin links the compiler against
            // the working tree's runtime.
            const pin: PathBuf = clone.join(Str::new("bin")).join(Host::executable_name(Str::new("cryo")).as_str());
            BaselineCompiler::step(pin.as_path().as_str(), clone.join(Str::new("runtime")).as_path(), tiers.as_str(),
                state.join(Str::new("baseline-runtime.log")).as_path())?;
            BaselineCompiler::step(pin.as_path().as_str(), clone.join(Str::new("runtime/hosted")).as_path(), f"../{tiers.as_str()}".as_str(),
                state.join(Str::new("baseline-runtime-hosted.log")).as_path())?;
            runtime_for_make = String::from_str(repository.join(Str::new("runtime")).as_path().as_str());
        }
        const log: PathBuf = state.join(Str::new("baseline-build.log"));
        mut make: Job = VerifyChild::job(Str::new("make"), runtime_for_make.as_str(), Str::new(""));
        make.argument(Str::new("--no-print-directory"));
        make.argument(Str::new("cryo"));
        make.directory(clone.as_path().as_str());
        make.log_to(log.as_path().as_str());
        const done: Completion = make.run();
        const built: PathBuf = clone.join(Str::new("compiler/build")).join(Host::executable_name(Str::new("cryo")).as_str());
        if (!done.outcome.succeeded() || !built.as_path().is_file()) {
            return Result::Err(f"the baseline compiler did not build ({done.outcome.describe().as_str()}); see {PopulationRun::relative(repository, log.as_path().as_str()).as_str()}");
        }
        const runtime_home: PathBuf = home.join(Str::new("runtime"));
        BaselineCompiler::remove(runtime_home.as_path())?;
        BaselineCompiler::create(home)?;
        if (tiered) {
            // The baseline's programs link the archives built above.
            const built_runtime: PathBuf = clone.join(Str::new("runtime")).join(tiers.as_str());
            if (RuntimeArchives::rows(built_runtime.as_path())?.is_empty()) {
                return Result::Err(f"the baseline's tiered runtime built no archives under {PopulationRun::relative(repository, built_runtime.as_path().as_str()).as_str()}");
            }
            const target: PathBuf = runtime_home.join(triple);
            BaselineCompiler::create(runtime_home.as_path())?;
            BaselineCompiler::create(target.as_path())?;
            for (name in Tree::names(built_runtime.as_path(), &Array::<String>::new())?.iterate_references()) {
                if (name.as_str().starts_with(&Str::new("libcryort")) && name.as_str().ends_with(&Str::new(".a"))) {
                    BaselineCompiler::copy(built_runtime.join(name.as_str()).as_path(), target.join(name.as_str()).as_path())?;
                }
            }
        } else {
            // The baseline's programs build the commit's runtime from its
            // sources.
            mut excluded: Array<String> = Array::<String>::new();
            excluded.push(String::from_str(Str::new(".bin")));
            Tree::copy(clone.join(Str::new("runtime")).as_path(), runtime_home.as_path(), &excluded)?;
        }
        const stdlib_home: PathBuf = home.join(Str::new("stdlib"));
        BaselineCompiler::remove(stdlib_home.as_path())?;
        if (stdlib_from_commit) {
            // The clone is synced again by the next baseline built, so the
            // programs read a copy kept with the compiler.
            mut excluded: Array<String> = Array::<String>::new();
            excluded.push(String::from_str(Str::new(".bin")));
            Tree::copy(clone.join(Str::new("stdlib")).as_path(), stdlib_home.as_path(), &excluded)?;
        }
        const bin: PathBuf = repository.join(Str::new("bin"));
        for (name in Tree::names(bin.as_path(), &Array::<String>::new())?.iterate_references()) {
            if (name.as_str().to_ascii_lowercase().as_str().ends_with(&Str::new(".dll"))) {
                BaselineCompiler::copy(bin.join(name.as_str()).as_path(), home.join(name.as_str()).as_path())?;
            }
        }
        return BaselineCompiler::copy(built.as_path(), home.join(Host::executable_name(Str::new("cryo")).as_str()).as_path());
    }

    /// `pin build --no-incremental --build-dir=<output>` in `directory`,
    /// logged to `log`; refused unless it succeeds.
    private static step(pin: Str, directory: Path, output: Str, log: Path) -> Result<(), String> {
        mut job: Job = VerifyChild::job(pin, Str::new(""), Str::new(""));
        job.argument(Str::new("build"));
        job.argument(Str::new("--no-incremental"));
        job.argument(f"--build-dir={output}".as_str());
        job.directory(directory.as_str());
        job.log_to(log.as_str());
        const done: Completion = job.run();
        if (!done.outcome.succeeded()) {
            return Result::Err(f"the baseline's tiered runtime did not build ({done.outcome.describe().as_str()}); see {log.as_str()}");
        }
        return Result::Ok(());
    }

    /// The first twelve digits of an object id.
    private static short(id: Str) -> Str { return if (id.length() > 12) { id.byte_substring(0, 12) } else { id }; }

    private static remove(directory: Path) -> Result<(), String> {
        if (!directory.exists()) { return Result::Ok(()); }
        return match (Directory::remove_all(directory)) {
            Result::Ok(_)      => { Result::Ok(()) }
            Result::Err(error) => { Result::Err(f"cannot remove {directory.as_str()}: {error.describe()}") }
        };
    }

    private static create(directory: Path) -> Result<(), String> {
        return match (Directory::create_all(directory)) {
            Result::Ok(_)      => { Result::Ok(()) }
            Result::Err(error) => { Result::Err(f"cannot create {directory.as_str()}: {error.describe()}") }
        };
    }

    private static copy(from: Path, to: Path) -> Result<(), String> {
        return match (File::copy(from, to)) {
            Result::Ok(_)      => { Result::Ok(()) }
            Result::Err(error) => { Result::Err(f"cannot copy {from.as_str()} to {to.as_str()}: {error.describe()}") }
        };
    }
}
