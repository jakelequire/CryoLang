///! A verify run itself: the children it starts and the order it runs
///! them in, over the decisions of the rest of `verify/`.  Unlike those,
///! these files run compilers and print verify's report.  They use the
///! core, the corpus, the baseline layer and verify's decisions, and depend
///! on each other in the order listed:
///!
///!   children  `VerifyChild`: a child's environment, the shell and the
///!             interpreter a gate names; `PopulationRun`, `GateRun`: one
///!             compiler's gates and the object lists they leave
///!   compiler  `BaselineCompiler`: built from a commit, kept in its home
///!   programs  `BaselinePlan`, `BaselinePrograms`, `BaselineTotals`: the
///!             baseline one program at a time, and what its records add
///!             up to
///!   declared  `DeclaredBuilds`: the declared lines checked, and the
///!             declared projects built by both compilers
///!   reuse     `TreeRunCache`: the tree's gates taken from a passing run
///!             whose every input was the same
///!   session   `VerifySession`, `VerifySettings`: one run, start to end
namespace cryogate::verify::run;

internal module {
    children;
    compiler;
    programs;
    declared;
    reuse;
    session;
}
