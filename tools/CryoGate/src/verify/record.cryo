///! One program's record of a census run, as verify stores it under the
///! program's record key: written from a census's output, sealed, kept in
///! the checkout's store and read back.

namespace cryogate::verify::record;

import std::collections::array::{ Array };
import std::collections::hashmap::{ HashMap };
import std::core::pair::{ Pair };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::clone::{ Clone };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::hash::{ Sha256 };
import std::fs::directory::{ Directory };
import std::fs::file::{ File };
import std::fs::path::{ Path, PathBuf };
import std::time::clock::{ SystemTime };

import cryogate::core::text::{ Text };
import cryogate::core::tree::{ Tree };
import cryogate::corpus::census::{ CensusReading };
import cryogate::verify::objects::{ ObjectOwner };

/// One program's record of a baseline run: its verdict; the unit suite's
/// failed tests, counts and build warnings when it is the unit suite; a
/// project's build warnings, when the runner listed them; and its objects,
/// as `<sha256 digest>  <path>` rows.
public type struct BaselineRecord {
    /// The program, by its declaration name (`unit suite` for the unit suite).
    public name: String;
    /// `ok` or `FAILED`.
    public verdict: String;
    /// The unit tests the baseline failed, by full name, sorted.
    public unit_failed: Array<String>;
    /// passed, failed, ignored and filtered, when the record has them.
    public unit_counts: Option<Array<i64>>;
    /// The build warnings, `<code> <file>:<line>`, sorted.
    public warnings: Array<String>;
    /// Whether the runner listed this project's build warnings, so that
    /// none recorded means none and not a runner that never said.
    public warnings_listed: boolean;
    /// The program's objects, `<sha256 digest>  <path>`.
    public rows: Array<String>;

    /// A record of `name` with `verdict` and nothing else.
    public static new(name: Str, verdict: Str) -> BaselineRecord {
        return BaselineRecord {
            name: String::from_str(name), verdict: String::from_str(verdict), unit_failed: Array::<String>::new(),
            unit_counts: Option::None, warnings: Array::<String>::new(), warnings_listed: false,
            rows: Array::<String>::new(),
        };
    }

    /// A record file's text read back: a tag and its value per line,
    /// `name`, `verdict`, `unit-failed`, `unit-counts` (four numbers),
    /// `warnings-listed` (no value), `warning` and `row`.
    public static read(text: Str) -> BaselineRecord {
        mut record: BaselineRecord = BaselineRecord::new(Str::new(""), Str::new(""));
        for (line in Text::lines(text).iterate_references()) {
            const tag: Str = match (line.as_str().split_once(" ")) {
                Option::Some(parts) => { parts.first }
                Option::None        => { line.as_str() }
            };
            const value: Str = match (line.as_str().split_once(" ")) {
                Option::Some(parts) => { parts.second }
                Option::None        => { Str::new("") }
            };
            if (tag == Str::new("name")) { record.name = String::from_str(value); }
            if (tag == Str::new("verdict")) { record.verdict = String::from_str(value); }
            if (tag == Str::new("unit-failed")) { record.unit_failed.push(String::from_str(value)); }
            if (tag == Str::new("warning")) { record.warnings.push(String::from_str(value)); }
            if (tag == Str::new("warnings-listed")) { record.warnings_listed = true; }
            if (tag == Str::new("row")) { record.rows.push(String::from_str(value)); }
            if (tag == Str::new("unit-counts")) {
                mut counts: Array<i64> = Array::<i64>::new();
                for (number in value.split_whitespace()) { counts.push(i64::try_from(number).unwrap_or(0)); }
                record.unit_counts = Option::Some(counts);
            }
        }
        return record;
    }

    /// The record file's text, as `read` reads it back: `name`, `verdict`,
    /// each `unit-failed`, `unit-counts` when the record has them,
    /// `warnings-listed` when listed, each `warning` and each `row`, one per
    /// line, each line ended.
    public text(&this) -> String {
        mut text: String = f"name {this.name.as_str()}\nverdict {this.verdict.as_str()}\n";
        for (test in this.unit_failed.iterate_references()) { text.append(f"unit-failed {test.as_str()}\n".as_str()); }
        if (this.unit_counts.is_some()) {
            const counts: Array<i64> = this.unit_counts.clone().unwrap();
            mut numbers: Array<String> = Array::<String>::new();
            for (count in counts.iterate_references()) { numbers.push(f"{*count}"); }
            text.append(f"unit-counts {Text::joined(&numbers, Str::new(" ")).as_str()}\n".as_str());
        }
        if (this.warnings_listed) { text.append(Str::new("warnings-listed\n")); }
        for (warning in this.warnings.iterate_references()) { text.append(f"warning {warning.as_str()}\n".as_str()); }
        for (row in this.rows.iterate_references()) { text.append(f"row {row.as_str()}\n".as_str()); }
        return text;
    }

    /// The records the programs `names` get from one baseline census run:
    /// its output `lines` and the object rows it left.  A project's or a
    /// compile-fail file's verdict is its line's (`ok` once reached,
    /// `FAILED` when it failed); a program with no verdict line gets no
    /// record.  The unit suite gets one when the run accounted for it -
    /// every unit test the roster pins on this host (`unit_pinned`) ran, by
    /// name, and no other - with the tests that failed before the first
    /// summary and the warnings printed there, its build's.  A project's
    /// record holds the build warnings the run listed under its line, when
    /// the runner lists them.  A warning in a file of the stdlib the run
    /// built against, spelled `stdlib`, names the file `stdlib/<path>`, so
    /// a record reads the same wherever that stdlib lies.  Each row goes to
    /// the record of the program that owns its object.
    public static of_census(lines: &Array<String>, names: &Array<String>, rows: &Array<String>,
                            unit_pinned: &Array<String>, stdlib: Str) -> Array<BaselineRecord> {
        mut reading: CensusReading = CensusReading::of(lines);
        reading.name_stdlib_files(stdlib);
        mut verdicts: HashMap<String, String> = HashMap::<String, String>::new();
        for (line in lines.iterate_references()) {
            match (BaselineRecord::verdict_line(line.as_str(), Str::new("project"))) {
                Option::Some(seen) => { verdicts.insert(String::from_str(seen.first), String::from_str(Str::new("ok"))); }
                Option::None       => { }
            }
            match (BaselineRecord::verdict_line(line.as_str(), Str::new("negative"))) {
                Option::Some(seen) => { verdicts.insert(f"negative/{seen.first}", String::from_str(Str::new("ok"))); }
                Option::None       => { }
            }
        }
        for (line in lines.iterate_references()) {
            match (BaselineRecord::verdict_line(line.as_str(), Str::new("project"))) {
                Option::Some(seen) => { if (seen.second) { verdicts.insert(String::from_str(seen.first), String::from_str(Str::new("FAILED"))); } }
                Option::None       => { }
            }
            match (BaselineRecord::verdict_line(line.as_str(), Str::new("negative"))) {
                Option::Some(seen) => { if (seen.second) { verdicts.insert(f"negative/{seen.first}", String::from_str(Str::new("FAILED"))); } }
                Option::None       => { }
            }
        }
        mut records: Array<BaselineRecord> = Array::<BaselineRecord>::new();
        const unit_suite: String = String::from_str(Str::new("unit suite"));
        for (name in names.iterate_references()) {
            if (name.as_str() == unit_suite.as_str()) {
                const ran: Array<String> = Text::sorted_distinct(reading.unit_names.clone());
                const pinned: Array<String> = Text::sorted_distinct(unit_pinned.clone());
                if (!reading.unit.printed || ran != pinned) { continue; }
                mut failed: Array<String> = Array::<String>::new();
                for (mut i: i64 = 0; i < lines.length() && i < reading.first_summary; i++) {
                    match (BaselineRecord::failed_unit(lines[i].as_str())) {
                        Option::Some(test) => { failed.push(String::from_str(test)); }
                        Option::None       => { }
                    }
                }
                const failed_sorted: Array<String> = Text::sorted_distinct(failed);
                mut record: BaselineRecord = BaselineRecord::new(unit_suite.as_str(),
                    if (failed_sorted.is_empty()) { Str::new("ok") } else { Str::new("FAILED") });
                record.unit_failed = failed_sorted;
                mut counts: Array<i64> = Array::<i64>::new();
                counts.push(reading.unit.passed);
                counts.push(reading.unit.failed);
                counts.push(reading.unit.ignored);
                counts.push(reading.unit.filtered);
                record.unit_counts = Option::Some(counts);
                record.warnings = Text::sorted_distinct(reading.warnings.clone());
                records.push(record);
                continue;
            }
            mut record: BaselineRecord = match (verdicts.get_reference(&*name)) {
                Option::Some(verdict) => { BaselineRecord::new(name.as_str(), verdict.as_str()) }
                Option::None          => { continue; }
            };
            if (reading.project_warnings_listed && !name.as_str().starts_with("negative/")) {
                record.warnings_listed = true;
                mut warnings: Array<String> = Array::<String>::new();
                for (listed in reading.project_warnings.iterate_references()) {
                    if (listed.first.as_str() == name.as_str()) { warnings.push(listed.second.clone()); }
                }
                record.warnings = Text::sorted_distinct(warnings);
            }
            records.push(record);
        }
        for (row in rows.iterate_references()) {
            const text: Str = row.as_str();
            const path: Str = if (text.length() > 66) { text.byte_substring(66, text.length()) } else { Str::new("") };
            const owner: String = match (ObjectOwner::of(path)) {
                Option::Some(owner) => { owner }
                Option::None        => { continue; }
            };
            for (mut i: i64 = 0; i < records.length(); i++) {
                if (records[i].name.as_str() == owner.as_str()) { records[i].rows.push(row.clone()); }
            }
        }
        return records;
    }

    /// The first field in which `other` differs from this record, rows
    /// compared as sets; none when the two agree.
    public difference(&this, other: &BaselineRecord) -> Option<String> {
        if (this.verdict.as_str() != other.verdict.as_str()) {
            return Option::Some(f"verdict {this.verdict.as_str()}, derived {other.verdict.as_str()}");
        }
        if (this.unit_failed != other.unit_failed) { return Option::Some(String::from_str(Str::new("unit-failed"))); }
        if (this.unit_counts != other.unit_counts) { return Option::Some(String::from_str(Str::new("unit-counts"))); }
        if (this.warnings_listed != other.warnings_listed) { return Option::Some(String::from_str(Str::new("warnings-listed"))); }
        if (this.warnings != other.warnings) { return Option::Some(String::from_str(Str::new("warnings"))); }
        const rows: Array<String> = Text::sorted_distinct(this.rows.clone());
        const other_rows: Array<String> = Text::sorted_distinct(other.rows.clone());
        if (rows != other_rows) {
            return Option::Some(f"rows {rows.length()}, derived {other_rows.length()}");
        }
        return Option::None;
    }

    /// A census verdict line of `suite` (`project` or `negative`),
    /// `test (<suite>) <name> ...`, at the line's very start: its name, and
    /// whether the verdict is `FAILED`.
    private static verdict_line(line: Str, suite: Str) -> Option<Pair<Str, boolean>> {
        const opening: String = f"test ({suite}) ";
        const rest: Str = match (line.strip_prefix(opening.as_str())) {
            Option::Some(rest) => { rest }
            Option::None       => { return Option::None; }
        };
        const parts: Pair<Str, Str> = match (rest.split_once(" ")) {
            Option::Some(parts) => { parts }
            Option::None        => { return Option::None; }
        };
        if (parts.first.is_empty() || !parts.second.starts_with("...")) { return Option::None; }
        return Option::Some(Pair::new(parts.first, parts.second.starts_with("... FAILED")));
    }

    /// A failed unit test's line, `FAIL  <namespace>::<test>`, at the
    /// line's very start: the test's full name.
    private static failed_unit(line: Str) -> Option<Str> {
        const rest: Str = match (line.strip_prefix("FAIL")) {
            Option::Some(rest) => { rest }
            Option::None       => { return Option::None; }
        };
        const spaced: boolean = match (rest.byte_at(0)) {
            Option::Some(byte) => { byte.is_whitespace() }
            Option::None       => { false }
        };
        if (!spaced) { return Option::None; }
        for (name in rest.split_whitespace()) {
            for (mut i: i64 = 1; i + 2 < name.length(); i++) {
                if (name.byte_substring(i, i + 2) == Str::new("::")) { return Option::Some(name); }
            }
            return Option::None;
        }
        return Option::None;
    }
}

/// A text verify keeps, ended by a line holding the digest of the text
/// above it, so a file cut short or changed reads as no file.
public type struct Seal {
    /// `text`, whose lines are each ended, then `end` and its sha256.
    public static close(text: Str) -> String {
        mut sealed: String = String::from_str(text);
        sealed.append(f"end {Sha256::digest(text.as_bytes()).to_hex().as_str()}\n".as_str());
        return sealed;
    }

    /// The text `close` sealed, when the last line of `text` is `end` and
    /// the digest of every line before it.
    public static open(text: Str) -> Option<Str> {
        if (!text.ends_with("\n")) { return Option::None; }
        const body: Str = text.byte_substring(0, text.length() - 1);
        const covered_length: i64 = match (body.split_once_from_end("\n")) {
            Option::Some(parts) => { parts.first.length() + 1 }
            Option::None        => { 0 }
        };
        const digest: Str = match (body.byte_substring(covered_length, body.length()).strip_prefix("end ")) {
            Option::Some(digest) => { digest }
            Option::None         => { return Option::None; }
        };
        const covered: Str = text.byte_substring(0, covered_length);
        if (Sha256::digest(covered.as_bytes()).to_hex().as_str() != digest) { return Option::None; }
        return Option::Some(covered);
    }
}

/// The records verify keeps, `.verify/programs/<key>`, one file per program
/// key.  A key holds the identity of the compiler that ran the program, so
/// one store serves both sides of a run: the tree's records are the next
/// baseline's when that baseline is this tree.  A record is written through
/// a temporary and renamed into place, and ends with an `end` line holding
/// the digest of the text above it; a record whose digest does not hold,
/// or that names another program, is read as no record, and the program
/// runs again and is recorded afresh.
public type struct RecordStore {
    /// The store's directory.
    public directory: PathBuf;

    /// A record not read for this many days is deleted.
    public const KEPT_DAYS: i64 = 14;
    /// At most this many records are kept, the most recently read.
    public const KEPT_RECORDS: i64 = 20000;

    /// The store of the checkout `repository`, created when it is not there.
    public static of(repository: Path) -> Result<RecordStore, String> {
        const directory: PathBuf = repository.join(Str::new(".verify/programs"));
        return match (Directory::create_all(directory.as_path())) {
            Result::Ok(_)      => { Result::Ok(RecordStore { directory: directory }) }
            Result::Err(error) => { Result::Err(f"cannot create {directory.as_path().as_str()}: {error.describe()}") }
        };
    }

    /// The record of `name` stored under `key`; none when there is none,
    /// when it does not open, or when it names another program.  A record
    /// last written more than a day ago is written again, which stamps it
    /// as read for `prune`.
    public load(&this, key: Str, name: Str) -> Option<BaselineRecord> {
        const path: PathBuf = this.directory.join(key);
        const text: String = match (File::read_text(path.as_path())) {
            Result::Ok(text) => { text }
            Result::Err(_)   => { return Option::None; }
        };
        const record: BaselineRecord = match (Seal::open(text.as_str())) {
            Option::Some(covered) => { BaselineRecord::read(covered) }
            Option::None          => { return Option::None; }
        };
        if (record.name.as_str() != name) { return Option::None; }
        const written: i64 = match (path.as_path().metadata()) {
            Result::Ok(metadata) => { metadata.modified_seconds() }
            Result::Err(_)       => { 0 }
        };
        if (SystemTime::now().unix_seconds() - written > 86400) {
            const _: Result<(), String> = this.save(key, &record);
        }
        return Option::Some(record);
    }

    /// Store `record` under `key`, replacing what is there.
    public save(&this, key: Str, record: &BaselineRecord) -> Result<(), String> {
        const path: PathBuf = this.directory.join(key);
        const temporary: String = f"{path.as_path().as_str()}.tmp";
        match (File::write_text(Path::from(temporary.as_str()), Seal::close(record.text().as_str()).as_str())) {
            Result::Ok(_)      => { }
            Result::Err(error) => { return Result::Err(f"cannot write {temporary.as_str()}: {error.describe()}"); }
        }
        return match (Path::from(temporary.as_str()).rename_to(path.as_path())) {
            Result::Ok(_)      => { Result::Ok(()) }
            Result::Err(error) => { Result::Err(f"cannot replace {path.as_path().as_str()}: {error.describe()}") }
        };
    }

    /// Delete every record not read for `KEPT_DAYS`, then the least
    /// recently read beyond `KEPT_RECORDS`; the number deleted.  `now` is
    /// the time in seconds since the epoch.
    public prune(&this, now: i64) -> Result<i64, String> {
        mut stamped: Array<Pair<String, i64>> = Array::<Pair<String, i64>>::new();
        for (name in Tree::names(this.directory.as_path(), &Array::<String>::new())?.iterate_references()) {
            const seconds: i64 = match (this.directory.join(name.as_str()).as_path().metadata()) {
                Result::Ok(metadata) => { metadata.modified_seconds() }
                Result::Err(_)       => { 0 }
            };
            stamped.push(Pair::new(name.clone(), seconds));
        }
        mut deleted: i64 = 0;
        const oldest_kept: i64 = now - RecordStore::KEPT_DAYS * 86400;
        mut left: Array<i64> = Array::<i64>::new();
        for (entry in stamped.iterate_references()) {
            if (entry.second >= oldest_kept) { left.push(entry.second); continue; }
            if (File::remove(this.directory.join(entry.first.as_str()).as_path()).is_ok()) { deleted++; }
        }
        if (left.length() <= RecordStore::KEPT_RECORDS) { return Result::Ok(deleted); }
        left.sort();
        // The stamp of the oldest record kept: every one older goes.
        const cutoff: i64 = left[left.length() - RecordStore::KEPT_RECORDS];
        for (entry in stamped.iterate_references()) {
            if (entry.second < oldest_kept || entry.second >= cutoff) { continue; }
            if (File::remove(this.directory.join(entry.first.as_str()).as_path()).is_ok()) { deleted++; }
        }
        return Result::Ok(deleted);
    }
}

/// A record copied whole: a baseline run's fresh records are merged with,
/// and listed beside, the ones already stored.
implement trait Clone for BaselineRecord {
    clone(&this) -> BaselineRecord {
        return BaselineRecord {
            name: this.name.clone(), verdict: this.verdict.clone(), unit_failed: this.unit_failed.clone(),
            unit_counts: this.unit_counts.clone(), warnings: this.warnings.clone(), warnings_listed: this.warnings_listed,
            rows: this.rows.clone(),
        };
    }
}
