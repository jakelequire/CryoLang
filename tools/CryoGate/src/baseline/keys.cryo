///! The programs verify records the baseline's verdicts and objects for,
///! the key each record is stored under, and the key of the baseline
///! compiler built from a commit.
///!
///! A record is keyed by the identity of the compiler that ran it (its bytes
///! less what two links of one build differ in), the host's toolchain, the
///! runtime its programs link, the inputs every program reads, and the program's own
///! files with the ones its cryoconfig reaches outside its directory, so a
///! change that adds or edits a test runs the baseline over that test alone.
///! A record whose inputs changed has another key and is never read.

namespace cryogate::baseline::keys;

import std::collections::array::{ Array };
import std::collections::pair::{ Pair };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::hash::{ Sha256 };
import std::env;
import std::fs::file::{ File };
import std::fs::path::{ Path, PathBuf };

import cryogate::baseline::listing::{ Listing };
import cryogate::core::child::{ Completion, Job };
import cryogate::core::git::{ Git };
import cryogate::core::host::{ Host };
import cryogate::core::tree::{ Tree };

/// One program the baseline's verdict and objects are recorded for, and
/// the files of the working tree that are its own.
public type struct Program {
    /// The program as the declaration files name it.
    public name: String;
    /// Its files, `/`-separated paths from the checkout's root.
    public files: Array<String>;
}

/// The programs the census and the examples sweep build or check.
public type struct Programs {
    /// The unit suite's name: every unit-test file builds into one binary.
    public static unit_suite() -> Str { return Str::new("unit suite"); }

    /// The record of the stdlib archives the census's programs link.
    public static census_archives() -> Str { return Str::new("archives/census"); }

    /// The record of the stdlib archives the examples sweep's programs link.
    public static example_archives() -> Str { return Str::new("archives/examples"); }

    /// Every program, named as the declaration files name it: the unit
    /// suite (every file under tests/tests outside the projects and the
    /// compile-fail files), each compile-fail file as `negative/<file>`,
    /// each test project (a directory of tests/tests/projects holding a
    /// `test.json`) by its directory's name, and each example (a directory
    /// of examples/ holding a cryoconfig) as `examples/<name>`.  A project's
    /// and an example's files are its directory's and what its cryoconfig
    /// reaches outside it.
    /// git lists the test sources and the examples once, and each
    /// program's files are taken from that one listing.
    public static discover(repository: Path, git: &Git) -> Result<Array<Program>, String> {
        mut programs: Array<Program> = Array::<Program>::new();
        mut listed_paths: Array<Str> = Array::<Str>::new();
        listed_paths.push(Str::new("tests/tests"));
        listed_paths.push(Str::new("examples"));
        const listed: Array<String> = Listing::of(git, &listed_paths)?;
        const projects: Str = Str::new("tests/tests/projects/");
        const negatives: Str = Str::new("tests/tests/negative/");
        mut unit: Array<String> = Array::<String>::new();
        for (file in listed.iterate_references()) {
            if (!file.as_str().starts_with("tests/tests/")) { continue; }
            if (!file.as_str().starts_with(projects) && !file.as_str().starts_with(negatives)) { unit.push(file.clone()); }
        }
        programs.push(Program { name: String::from_str(Programs::unit_suite()), files: unit });
        for (file in listed.iterate_references()) {
            if (!file.as_str().starts_with(negatives) || !file.as_str().ends_with(".cryo")) { continue; }
            const base: Str = match (file.as_str().split_once_from_end("/")) {
                Option::Some(parts) => { parts.second }
                Option::None        => { file.as_str() }
            };
            mut own: Array<String> = Array::<String>::new();
            own.push(file.clone());
            programs.push(Program { name: f"negative/{base}", files: own });
        }
        Programs::homes(repository, git, &listed, Str::new("tests/tests/projects"), Str::new("test.json"), Str::new(""), &programs)?;
        Programs::homes(repository, git, &listed, Str::new("examples"), Str::new("cryoconfig"), Str::new("examples/"), &programs)?;
        return Result::Ok(programs);
    }

    /// One program per directory of `parent` that holds `marker`, named
    /// `<prefix><directory>`, its files those of `listed` below it.
    private static homes(repository: Path, git: &Git, listed: &Array<String>, parent: Str, marker: Str, prefix: Str,
                         programs: mut &Array<Program>) -> Result<(), String> {
        const names: Array<String> = Tree::names(repository.join(parent).as_path(), &Array::<String>::new())?;
        for (directory in names.iterate_references()) {
            const home: String = f"{parent}/{directory.as_str()}";
            if (!repository.join(home.as_str()).join(marker).as_path().is_file()) { continue; }
            const below: String = f"{home.as_str()}/";
            mut files: Array<String> = Array::<String>::new();
            for (file in listed.iterate_references()) {
                if (file.as_str().starts_with(below.as_str())) { files.push(file.clone()); }
            }
            mut seen: Array<String> = Array::<String>::new();
            for (file in Listing::reached_outside(repository, git, home.as_str(), &seen)?.iterate_references()) {
                files.push(file.clone());
            }
            programs.push(Program { name: f"{prefix}{directory.as_str()}", files: files });
        }
        return Result::Ok(());
    }
}

/// The standard library a side's programs build against: the checkout's,
/// or, for a baseline asked to use its own, the copy of the baseline
/// commit's that its home holds.
public type struct ProgramStdlib {
    /// The library's root directory.
    public directory: PathBuf;
    /// Whether it is the baseline commit's copy rather than the checkout's.
    public from_baseline: boolean;

    /// The checkout `repository`'s own stdlib.
    public static of_checkout(repository: Path) -> ProgramStdlib {
        return ProgramStdlib { directory: repository.join(Str::new("stdlib")), from_baseline: false };
    }

    /// The baseline commit's stdlib, copied into the baseline's `home`.
    public static of_home(home: Path) -> ProgramStdlib {
        return ProgramStdlib { directory: home.join(Str::new("stdlib")), from_baseline: true };
    }

    /// What a child's `CRYO_STDLIB` is set to: the baseline's copy, spelled
    /// absolute with forward slashes; nothing for the checkout's, which each
    /// gate names its own way.
    public variable(&this) -> String {
        return if (this.from_baseline) { Host::stdlib_spelling(this.directory.as_path().as_str()) } else { String::new() };
    }

    /// The directory as a command line names it: absolute, with forward
    /// slashes.
    public spelling(&this) -> String { return Host::stdlib_spelling(this.directory.as_path().as_str()); }
}

/// The keys the baseline's records are stored under.
public type struct ProgramKeys {
    /// Each program's key, and the two archive records' keys, as
    /// `(name, key)` pairs: 32 hex digits of a sha256 seeded with the
    /// identity of the compiler `compiler` and the host's `toolchain`, fed
    /// the files of the runtime home `runtime` (all but its build outputs,
    /// under `.bin`), then which stdlib the programs build against -
    /// `stdlib`'s origin and every file of it but its build outputs - then
    /// the inputs every program reads, then the program's name and files.
    /// Either side of a verify run computes them over its own compiler,
    /// runtime and stdlib, so a record one side made is the other side's
    /// when the two compilers are one build and the two stdlibs one origin
    /// and one text; a record made against the baseline's own stdlib is
    /// never read for a run against the checkout's, whatever the two hold.
    public static of(repository: Path, git: &Git, compiler: Path, runtime: Path, stdlib: &ProgramStdlib,
                     toolchain: &HostToolchain, programs: &Array<Program>) -> Result<Array<Pair<String, String>>, String> {
        mut linked: Sha256 = Sha256::new();
        linked.update(CompilerIdentity::of(compiler)?.as_str().as_bytes());
        linked.update(toolchain.digest.as_str().as_bytes());
        mut excluded: Array<String> = Array::<String>::new();
        excluded.push(String::from_str(Str::new(".bin")));
        mut runtime_files: Array<String> = Tree::files(runtime, &excluded)?;
        runtime_files.sort();
        Inputs::feed(&linked, runtime, &runtime_files)?;
        Inputs::text(&linked, Str::new("stdlib"), if (stdlib.from_baseline) { Str::new("baseline") } else { Str::new("checkout") });
        mut stdlib_files: Array<String> = Tree::files(stdlib.directory.as_path(), &excluded)?;
        stdlib_files.sort();
        Inputs::feed(&linked, stdlib.directory.as_path(), &stdlib_files)?;
        Inputs::feed(&linked, repository, &ProgramKeys::shared(git)?)?;
        const shared: String = linked.finish().to_hex();

        mut keys: Array<Pair<String, String>> = Array::<Pair<String, String>>::new();
        for (program in programs.iterate_references()) {
            mut hasher: Sha256 = ProgramKeys::seeded(shared.as_str(), program.name.as_str());
            Inputs::feed(&hasher, repository, &program.files)?;
            keys.push(Pair::new(program.name.clone(), ProgramKeys::shortened(hasher.finish().to_hex())));
        }
        mut archives: Array<Str> = Array::<Str>::new();
        archives.push(Programs::census_archives());
        archives.push(Programs::example_archives());
        for (name in archives.iterate_references()) {
            const hasher: Sha256 = ProgramKeys::seeded(shared.as_str(), *name);
            keys.push(Pair::new(String::from_str(*name), ProgramKeys::shortened(hasher.finish().to_hex())));
        }
        return Result::Ok(keys);
    }

    /// The files of the working tree every program's build reads besides
    /// the stdlib: the pins, the procedure that runs and hashes the builds
    /// (how the stdlib is spelled to each run, which flags a build gets),
    /// and what tests/ holds outside the test sources, less the files the
    /// census reads to judge a run rather than to build one.
    public static shared(git: &Git) -> Result<Array<String>, String> {
        mut roots: Array<Str> = Array::<Str>::new();
        roots.push(Str::new("bin"));
        mut shared: Array<String> = Listing::of(git, &roots)?;
        for (path in ProgramKeys::procedure().iterate_references()) { shared.push(String::from_str(*path)); }
        mut tests: Array<Str> = Array::<Str>::new();
        tests.push(Str::new("tests"));
        mut bookkeeping: Array<String> = Array::<String>::new();
        bookkeeping.push(String::from_str(Str::new("tests/test-roster.txt")));
        bookkeeping.push(String::from_str(Str::new("tests/started-compiling")));
        bookkeeping.push(String::from_str(Str::new("tests/started-passing")));
        for (file in Listing::of(git, &tests)?.iterate_references()) {
            if (file.as_str().starts_with("tests/tests/") || bookkeeping.contains(file)) { continue; }
            shared.push(file.clone());
        }
        return Result::Ok(shared);
    }

    /// The files of the procedure, in the order they are fed: what runs a
    /// baseline program, reads its run, hashes its objects and writes its
    /// record, and the gates the run goes through.
    public static procedure() -> Array<Str> {
        mut files: Array<Str> = Array::<Str>::new();
        files.push(Str::new("tools/CryoGate/src/verify/run/programs.cryo"));
        files.push(Str::new("tools/CryoGate/src/verify/record.cryo"));
        files.push(Str::new("tools/CryoGate/src/verify/hashing.cryo"));
        files.push(Str::new("tools/CryoGate/src/corpus/census.cryo"));
        files.push(Str::new("tools/CryoGate/src/gates/census.cryo"));
        files.push(Str::new("tools/CryoGate/src/gates/roster.cryo"));
        files.push(Str::new("tools/CryoGate/src/gates/examples.cryo"));
        files.push(Str::new("tools/CryoGate/src/core/host.cryo"));
        return files;
    }

    /// A sha256 fed `shared`, a NUL and `name`.
    private static seeded(shared: Str, name: Str) -> Sha256 {
        mut hasher: Sha256 = Sha256::new();
        mut seed: String = String::from_str(shared);
        seed.push_byte(0);
        seed.append(name);
        hasher.update(seed.as_str().as_bytes());
        return hasher;
    }

    private static shortened(hex: String) -> String { return String::from_str(hex.as_str().byte_substring(0, 32)); }
}

/// What a compiler binary is, as a key reads it: the same for two links of
/// one build, and different for any other byte.
public type struct CompilerIdentity {
    /// How many bytes of stamp text follow the marker.
    const STAMP_TEXT_LENGTH: i64 = 496;

    /// The identity of the compiler binary at `path`.
    public static of(path: Path) -> Result<String, String> {
        return match (File::read_bytes(path)) {
            Result::Ok(bytes)  => { Result::Ok(CompilerIdentity::digest(bytes)) }
            Result::Err(error) => { Result::Err(f"cannot read {path.as_str()}: {error.describe()}") }
        };
    }

    /// The hex sha256 of `bytes`, a compiler binary, with what differs
    /// between two links of the same objects read as zeros: the stamp text
    /// after the binary's one stamp marker (the commit it names, and the
    /// fingerprint, a digest of the rest), and in a PE file the header's
    /// link time and its checksum over the whole file.  The compiler's own
    /// fingerprint reads its stamp text the same way.  A binary with no
    /// single marker has its stamp read as it is.
    public static digest(bytes: Array<u8>) -> String {
        mut masked: Array<u8> = bytes;
        const length: i64 = masked.length();
        // The marker that opens the region `cryo stamp` rewrites.
        const marker: Str = Str::new("CRYO-BUILD-STAMP");
        mut found: i64 = -1;
        mut markers: i64 = 0;
        for (mut start: i64 = 0; start + marker.length() + CompilerIdentity::STAMP_TEXT_LENGTH <= length; start++) {
            if (masked[start] != marker.byte_at(0).unwrap()) { continue; }
            mut matched: boolean = true;
            for (mut offset: i64 = 1; offset < marker.length(); offset++) {
                if (masked[start + offset] != marker.byte_at(offset).unwrap()) { matched = false; break; }
            }
            if (matched) { markers++; found = start + marker.length(); }
        }
        if (markers == 1) {
            for (mut offset: i64 = 0; offset < CompilerIdentity::STAMP_TEXT_LENGTH; offset++) { masked[found + offset] = 0; }
        }
        // The PE signature's offset is at 0x3c; the link time is 8 bytes
        // past the signature, the checksum 88 bytes past it (64 into the
        // optional header, for both PE32 and PE32+).
        if (length >= 64 && masked[0] == 'M' && masked[1] == 'Z') {
            const signature: i64 = (masked[60] as i64) + (masked[61] as i64) * 256 + (masked[62] as i64) * 65536 + (masked[63] as i64) * 16777216;
            if (signature + 92 <= length && masked[signature] == 'P' && masked[signature + 1] == 'E'
                && masked[signature + 2] == 0 && masked[signature + 3] == 0) {
                for (mut offset: i64 = 0; offset < 4; offset++) {
                    masked[signature + 8 + offset] = 0;
                    masked[signature + 88 + offset] = 0;
                }
            }
        }
        return Sha256::digest(masked.as_slice()).to_hex();
    }
}

/// What the host lends every build besides the checkout's listed files:
/// the libraries beside the pins the compiler loads (which git ignores),
/// the C drivers a link can pick and their versions, and the `PATH` they
/// are found on.
public type struct HostToolchain {
    /// The hex sha256 of all of it.
    public digest: String;

    /// The host toolchain of the checkout `repository`: each `.dll` in its
    /// `bin`, then `CRYO_CC`, then for each driver a link can pick - the one
    /// `CRYO_CC` names, `gcc`, `clang`, `cc` - its name and what it prints
    /// for `--version` (or how it failed), then `PATH`.
    public static of(repository: Path) -> Result<HostToolchain, String> {
        mut hasher: Sha256 = Sha256::new();
        const bin: PathBuf = repository.join(Str::new("bin"));
        mut libraries: Array<String> = Array::<String>::new();
        if (bin.as_path().is_directory()) {
            for (name in Tree::names(bin.as_path(), &Array::<String>::new())?.iterate_references()) {
                if (name.as_str().to_ascii_lowercase().as_str().ends_with(".dll")) { libraries.push(f"bin/{name.as_str()}"); }
            }
        }
        libraries.sort();
        Inputs::feed(&hasher, repository, &libraries)?;
        const chosen: String = env::var(Str::new("CRYO_CC")).unwrap_or(String::new());
        mut drivers: Array<String> = Array::<String>::new();
        if (!chosen.is_empty()) { drivers.push(chosen.clone()); }
        drivers.push(String::from_str(Str::new("gcc")));
        drivers.push(String::from_str(Str::new("clang")));
        drivers.push(String::from_str(Str::new("cc")));
        Inputs::text(&hasher, Str::new("CRYO_CC"), chosen.as_str());
        for (driver in drivers.iterate_references()) {
            mut job: Job = Job::new(driver.as_str());
            job.argument(Str::new("--version"));
            const done: Completion = job.run();
            const answer: String = if (done.outcome.succeeded()) { done.output() } else { done.outcome.describe() };
            Inputs::text(&hasher, driver.as_str(), answer.as_str());
        }
        Inputs::text(&hasher, Str::new("PATH"), env::var(Str::new("PATH")).unwrap_or(String::new()).as_str());
        return Result::Ok(HostToolchain { digest: hasher.finish().to_hex() });
    }
}

/// The key of the baseline compiler built from a commit.
public type struct BaselineKey {
    /// 16 hex digits of the sha256 of the commit's compiler/src tree, its
    /// runtime tree and the hex digest of the working tree's build inputs:
    /// what a compiler build reads besides compiler/src and runtime/, which
    /// come from the commit.  With `stdlib_from_commit` the stdlib comes
    /// from the commit too, and its tree follows the other two.  `git` runs
    /// in the checkout at `repository`.  Fails when `revision` names no
    /// commit.
    public static of(repository: Path, git: &Git, revision: Str, stdlib_from_commit: boolean) -> Result<String, String> {
        const commit: String = BaselineKey::commit(git, revision)?;
        const sources: String = BaselineKey::parsed(git, f"{commit.as_str()}:compiler/src".as_str())?;
        const runtime: String = BaselineKey::parsed(git, f"{commit.as_str()}:runtime".as_str())?;
        mut stdlib: String = String::new();
        if (stdlib_from_commit) {
            const tree: String = BaselineKey::tree_of(git, commit.as_str(), Str::new("stdlib"))?;
            stdlib = f"stdlib {tree.as_str()}";
        }
        mut inputs: Sha256 = Sha256::new();
        Inputs::feed(&inputs, repository, &BaselineKey::build_inputs(git, stdlib_from_commit)?)?;
        mut key: Sha256 = Sha256::new();
        const text: String = f"{sources.as_str()}{runtime.as_str()}{stdlib.as_str()}{inputs.finish().to_hex().as_str()}";
        key.update(text.as_str().as_bytes());
        return Result::Ok(String::from_str(key.finish().to_hex().as_str().byte_substring(0, 16)));
    }

    /// The working tree's files a compiler build reads besides compiler/src
    /// and runtime/: the stdlib unless `stdlib_from_commit`, the pins,
    /// compiler/ outside its sources and the Makefile.  The clone a
    /// baseline is built in is given exactly these, so the key names the
    /// files the baseline was built from.
    public static build_inputs(git: &Git, stdlib_from_commit: boolean) -> Result<Array<String>, String> {
        mut roots: Array<Str> = Array::<Str>::new();
        if (!stdlib_from_commit) { roots.push(Str::new("stdlib")); }
        roots.push(Str::new("bin"));
        roots.push(Str::new("compiler"));
        roots.push(Str::new("Makefile"));
        mut inputs: Array<String> = Array::<String>::new();
        for (file in Listing::of(git, &roots)?.iterate_references()) {
            if (!file.as_str().starts_with("compiler/src/")) { inputs.push(file.clone()); }
        }
        return Result::Ok(inputs);
    }

    /// The full name of the commit `revision` names.
    public static commit(git: &Git, revision: Str) -> Result<String, String> {
        mut commit_of: String = String::from_str(revision);
        commit_of.append(Str::new("^{commit}"));
        return BaselineKey::parsed(git, commit_of.as_str());
    }

    /// The id of the tree `directory` is in the commit `commit`.
    public static tree_of(git: &Git, commit: Str, directory: Str) -> Result<String, String> {
        return BaselineKey::parsed(git, f"{commit}:{directory}".as_str());
    }

    private static parsed(git: &Git, specification: Str) -> Result<String, String> {
        mut arguments: Array<Str> = Array::<Str>::new();
        arguments.push(Str::new("rev-parse"));
        arguments.push(Str::new("--verify"));
        arguments.push(specification);
        const done: Completion = git.run(&arguments);
        if (!done.outcome.succeeded()) { return Result::Err(f"git rev-parse --verify {specification}: {done.outcome.describe().as_str()}"); }
        return Result::Ok(String::from_str(done.output().as_str().trim()));
    }
}

/// Files fed to a digest, each as a NUL, its path, a NUL and its bytes, and
/// named values framed the same way.
public type struct Inputs {
    /// Feed `hasher` a NUL, `label`, a NUL and `value`.
    public static text(hasher: mut &Sha256, label: Str, value: Str) -> void {
        mut framed: String = String::new();
        framed.push_byte(0);
        framed.append(label);
        framed.push_byte(0);
        framed.append(value);
        hasher.update(framed.as_str().as_bytes());
    }

    /// Feed `hasher` each of `files` below `root` that is a file; a listed
    /// path that is not on disk is left out.
    public static feed(hasher: mut &Sha256, root: Path, files: &Array<String>) -> Result<(), String> {
        for (file in files.iterate_references()) {
            const path: PathBuf = root.join(file.as_str());
            if (!path.as_path().is_file()) { continue; }
            mut header: String = String::new();
            header.push_byte(0);
            header.append(file.as_str());
            header.push_byte(0);
            hasher.update(header.as_str().as_bytes());
            match (File::read_bytes(path.as_path())) {
                Result::Ok(bytes)  => { hasher.update(bytes.as_slice()); }
                Result::Err(error) => { return Result::Err(f"cannot read {path.as_path().as_str()}: {error.describe()}"); }
            }
        }
        return Result::Ok(());
    }
}
