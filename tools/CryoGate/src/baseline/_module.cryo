///! The baseline verify compares a change against: the files of the working
///! tree each recorded program reads, the keys its records are stored
///! under, the key of the compiler built from a commit, the clone that
///! compiler is built in, and the bounded cache of baseline homes.  It asks
///! git and reads and writes files; it runs no compiler.  It uses the core
///! only.
///!
///!   listing  what git lists, split, and the paths a program reaches
///!   keys     `Programs`, `ProgramKeys`, `BaselineKey`: the record keys
///!   clone    `BaselineClone`: the checkout a baseline is built in
///!   cache    `BaselineCache`: the bounded set of baseline homes
namespace cryogate::baseline;

internal module {
    listing;
    keys;
    clone;
    cache;
}
