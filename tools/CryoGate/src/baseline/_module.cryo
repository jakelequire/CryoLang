///! The baseline verify compares a change against: the files of the working
///! tree each recorded program reads, the keys its records are stored
///! under, the key of the compiler built from a commit, the clone that
///! compiler is built in, and the bounded cache of baseline homes.  It asks
///! git and reads and writes files; it runs no compiler.
namespace cryogate::baseline;

module {
    listing;
    keys;
    clone;
    cache;
}
