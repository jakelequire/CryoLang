///! cryogate - the repository's gate and test runner.
///!
///! `cryogate <command> [arguments]`; `cryogate help` lists the commands.

namespace cryogate::main;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::result::{ Result };
import std::env;
import std::fmt;
import std::fs::path::{ PathBuf };

import cryogate::core::host::{ Host };
import cryogate::core::log::{ RunLogs };
import cryogate::gates::abi::{ AbiGate };
import cryogate::gates::annotate::{ AnnotateNegative };
import cryogate::gates::corpus_check::{ CorpusCheck };
import cryogate::gates::smith_diff::{ SmithDiff };
import cryogate::gates::smith_reduce::{ SmithReduce };
import cryogate::gates::smith_crash::{ SmithCrash };
import cryogate::gates::smith_selftest::{ SmithSelfTest };
import cryogate::gates::cross::{ CrossCheck };
import cryogate::gates::examples::{ ExamplesGate };
import cryogate::gates::freestanding::{ FreestandingGate };
import cryogate::gates::incr::{ IncrementalBuild };
import cryogate::gates::lsp::{ LspGate };
import cryogate::gates::lsp_smoke::{ LspSmoke };
import cryogate::gates::release_smoke::{ ReleaseSmokeGate };
import cryogate::gates::census::{ Census };
import cryogate::gates::pin::{ PinIntegrity, PinRefresh };
import cryogate::gates::roster::{ RosterGate };
import cryogate::gates::selfhost::{ SelfhostGate };
import cryogate::gates::vendor::{ VendorGate };
import cryogate::gates::verify::{ VerifyGate };
import cryogate::heavy::{ Heavy };
import cryogate::probe::{ Probe };
import cryogate::selftest::{ SelfTest };

function main() -> i32 {
    const arguments: Array<String> = env::args();
    if (arguments.length() < 2) {
        Main::usage();
        return 2;
    }
    const command: Str = arguments.get_reference(1).unwrap().as_str();
    if (command == Str::new("probe")) { return Probe::run(&arguments, 2); }
    if (command == Str::new("help")) { Main::usage(); return 0; }
    const repository: PathBuf = match (Host::repository()) {
        Result::Ok(root)     => { root }
        Result::Err(reason)  => { fmt::eprintln(f"cryogate: {reason.as_str()}"); return 1; }
    };
    if (command == Str::new("heavy")) { return Heavy::run(repository.as_path(), &arguments, 2); }
    if (command == Str::new("verify-pin")) { return PinIntegrity::run(repository.as_path(), &arguments, 2); }
    const logs: RunLogs = match (RunLogs::open(repository.as_path())) {
        Result::Ok(logs)    => { logs }
        Result::Err(reason) => { fmt::eprintln(f"cryogate: {reason.as_str()}"); return 1; }
    };
    if (command == Str::new("selftest")) { return SelfTest::run(repository.as_path(), &logs); }
    if (command == Str::new("cross")) { return CrossCheck::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("examples")) { return ExamplesGate::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("incr")) { return IncrementalBuild::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("vendor")) { return VendorGate::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("roster")) { return RosterGate::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("census")) { return Census::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("pin")) { return PinRefresh::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("verify")) { return VerifyGate::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("selfhost")) { return SelfhostGate::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("abi")) { return AbiGate::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("freestanding")) { return FreestandingGate::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("release-smoke")) { return ReleaseSmokeGate::run(&logs, &arguments, 2); }
    if (command == Str::new("corpus-check")) { return CorpusCheck::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("smith-diff")) { return SmithDiff::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("smith-reduce")) { return SmithReduce::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("smith-crash")) { return SmithCrash::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("smith-selftest")) { return SmithSelfTest::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("annotate-negative")) { return AnnotateNegative::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("lsp")) { return LspGate::run(repository.as_path(), &logs, &arguments, 2); }
    if (command == Str::new("lsp-smoke")) { return LspSmoke::run(repository.as_path(), &arguments, 2); }
    fmt::eprintln(f"cryogate: unknown command `{command}`");
    Main::usage();
    return 2;
}

type struct Main {
    private static usage() -> void {
        fmt::eprintln(String::from_str(Str::new(
            "usage: cryogate <command> [arguments]\n\n"
            "  selftest            check the child runner, the scheduler and the\n"
            "                      heavy-run lock, then run cryogate's unit tests\n"
            "  heavy [--no-wait] -- <program> [arguments]\n"
            "                      run a heavy proof under the heavy-run lock\n"
            "  cross --cryo <compiler> [--triple T] [--build-root DIR]\n"
            "        [--min-modules N] [--project P]...\n"
            "                      runtime, stdlib, compiler, LSP and cryogate compile for\n"
            "                      the other OS's triple, objects only\n"
            "  examples --cryo <compiler> [--min N] [--stdlib DIR] [--jobs N]\n"
            "                      every examples/ project builds\n"
            "  incr --instance --cryo <compiler>\n"
            "                      an edit asking a cached module for a new\n"
            "                      generic instance still links\n"
            "  incr --runtime --cryo <compiler>\n"
            "                      a rebuilt runtime is linked again with\n"
            "                      nothing else changed\n"
            "  incr --matrix --cryo <compiler> [--project DIR] [--bin NAME]\n"
            "                      every incremental build of an edit matrix\n"
            "                      equals a clean build of the same source\n"
            "  vendor --cryo <compiler>\n"
            "                      every constant shape survives `cryo vendor`\n"
            "  roster --cryo <compiler> [--merge | --update]\n"
            "                      the tests the three suites hold, against\n"
            "                      tests/test-roster.txt; --merge adds, --update\n"
            "                      rewrites from this host\n"
            "  census --cryo <compiler> [--verbose] [-- <cryo test flags>...]\n"
            "                      run the suites and reconcile what ran with the\n"
            "                      roster golden\n"
            "  census --read <log> the parse of a runner's log, as one JSON record\n"
            "  verify-pin [--require-clean] [--pin <binary>]...\n"
            "                      each pin matches its sidecar's sha256 and\n"
            "                      stamped commit, the pair names one commit, and\n"
            "                      the Windows pin has no 32-bit base relocation\n"
            "  pin [--source <compiler>] [--pin <binary>] [--no-strip]\n"
            "      [--strip-tool <tool>] [--stamper <compiler>] [--stamp-profile P]\n"
            "                      copy, strip and stamp a pin and write its sidecar\n"
            "  pin --through-wsl   run `make pin-impl` in this checkout inside WSL\n"
            "  verify --declared-since <rev>\n"
            "                      the lines tests/started-compiling and\n"
            "                      tests/started-passing declare against <rev>\n"
            "  verify --compare <run> --against <rev> [--list-limit <n>]\n"
            "                      a verify run directory's object comparison,\n"
            "                      from its recorded lists\n"
            "  verify --records <run> --programs <directory>\n"
            "                      the census records stored in <directory>,\n"
            "                      derived again from <run>'s baseline census\n"
            "  selfhost [--no-windows] [--allow-skipped-arm]\n"
            "                      the compiler's fixed point: three builds from a\n"
            "                      pin, on the Linux arm and the Windows arm\n"
            "  abi --cryo <compiler> [--nm <nm>]\n"
            "                      runtime/abi/lang_items.def against the runtime\n"
            "                      built in each configuration and the sources\n"
            "  freestanding --cryo <compiler> [--allow-skipped-arm]\n"
            "                      the runtime's freestanding configuration linked\n"
            "                      with no C library and run, Linux natively and\n"
            "                      Windows under wine (a Linux host)\n"
            "  release-smoke <staged-dir> <exe-name> [runner ...]\n"
            "                      a staged release tree builds and runs a\n"
            "                      hello-world under both default profiles\n"
            "  corpus-check --cryo <compiler> --work DIR [--smith <cryosmith>]\n"
            "        [--stdlib DIR] [--first-seed N] [--count K] [--jobs N]\n"
            "        [-- <generation options>]\n"
            "                      CryoSmith's programs built at -O0 and -O2, both run,\n"
            "                      one equal hash line and exit 0 required; --jobs\n"
            "                      builds at once, each in its own build directory\n"
            "  smith-diff --cryo <compiler> [--reference <compiler>]... [--interpret]\n"
            "        --work DIR [--smith <cryosmith>] [--stdlib DIR] [--first-seed N]\n"
            "        [--count K] [--jobs N] [--build-limit S] [--run-limit S]\n"
            "        [-- <generation options>]\n"
            "                      CryoSmith's programs built at -O0 and -O2 by each\n"
            "                      compiler (and interpreted), run under time limits;\n"
            "                      a crash, hang, refusal or mismatch is a finding\n"
            "  smith-reduce --seed N --cryo <compiler> [--reference <compiler>]...\n"
            "        [--interpret] --work DIR --out DIR [--signature S]\n"
            "        [--smith <cryosmith>] [--stdlib DIR] [--build-limit S]\n"
            "        [--run-limit S] [-- <generation options>]\n"
            "                      a failing program regenerated smaller while its\n"
            "                      smith-diff signature persists; a bug file drafted\n"
            "  smith-crash --cryo <compiler> --work DIR [--smith <cryosmith>]\n"
            "        [--stdlib DIR] [--first-seed N] [--count K] [--mutations J]\n"
            "        [--jobs N] [--build-limit S] [-- <generation options>]\n"
            "                      J mutations of each program built at -O0; a crash,\n"
            "                      hang, internal error or codeless refusal is a finding\n"
            "  smith-selftest --smith <cryosmith> [--jobs N]\n"
            "                      CryoSmith's self-test in N parts at once, judged as\n"
            "                      one whole run\n"
            "  annotate-negative --cryo <compiler> [--only NAME]... [--dry-run]\n"
            "                      write `//~` annotations into compile-fail files\n"
            "                      that hold none, keeping only ones that verify\n"
            "  lsp --cryo <compiler> [--build-dir DIR] [--min-modules N] [--min-checks N]\n"
            "      [--keep] [--no-run]\n"
            "                      tools/CryoLSP builds cold with the compiler under\n"
            "                      test, and the server it linked passes its checks\n"
            "  lsp-smoke [<server>] [--fixture NAME]\n"
            "                      the language server's behavioural checks against\n"
            "                      a server already built\n"
            "  selfhost --digest [<root>]\n"
            "                      the digest of the sources selfhost's Linux arm\n"
            "                      reads, below <root> or the checkout\n"
            "  probe <action>...   act as a child for the self-test: `exit N`,\n"
            "                      `sleep MS`, `print TEXT`, `error TEXT`,\n"
            "                      `variable NAME`, `directory`\n\n"
            "Logs go to build-logs/cryogate/<run>/.")));
    }
}
