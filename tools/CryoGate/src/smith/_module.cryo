///! CryoSmith's programs as cryogate checks them.  CryoSmith generates; it
///! runs no compiler.  Checking what it generated - building, running and
///! comparing - is cryogate's.  The decisions are pure and use the core and
///! nothing above it; its files depend on each other in the order listed:
///!
///!   corpus  `CorpusLayout`: each program's source, executables and build
///!           directories; `CorpusJudge`: the hash line a program must
///!           print, the two builds' agreement, and a failed child quoted
///!   difference  `Configuration`: one way of getting a program's hash
///!           line; `Observation`: what one configuration made of a
///!           program; `SmithDecision`: a program's verdict and a finding's
///!           signature
///!   pinned  `PinnedCorpus`: the seeds verify checks at one generator
///!           version, each with the hash line its program must print
///!   reduction  `ProgramHeader`: a program's header as the options that
///!           rebuild it, and the smaller candidates tried from them;
///!           `BugDraft`: the bug file a reduction drafts
///!   selftest  `SelfTestParts`: CryoSmith's self-test run in parts, the
///!           parts' reports judged as one whole run
///!   crash   `CrashDecision`: a build of a mutated program judged as the
///!           crash fuzzer judges it, and a finding's signature
///!
///! The builds and runs themselves, which start the compilers, are the
///! directory `run/`, after all of these.
namespace cryogate::smith;

internal module {
    corpus;
    difference;
    pinned;
    reduction;
    selftest;
    crash;
    run;
}
