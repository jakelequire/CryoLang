///! The runtime's ABI, as the registry `runtime/abi/lang_items.def` states it
///! and as the built archives and the sources spell it.  Everything here is
///! pure over text and files handed in; it runs no compiler and no nm.  It
///! uses the core and nothing above it, and its files depend on each other in
///! the order listed:
///!
///!   registry  `LangItems`, `LangItem`, `RowScope`: the registry's rows,
///!             what each configuration must define, and the names no row
///!             accounts for
///!   symbols   `ArchiveSymbols`, `SourceNames`: the symbols an archive's
///!             members define, and the `__cryo_` names the compiler's
///!             sources spell and the stdlib calls
namespace cryogate::abi;

internal module {
    registry;
    symbols;
}
