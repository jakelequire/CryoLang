///! cryo-rename: a whole-word rename across source trees.
///!
///!   cryo-rename <directory or file>... -- <old>=<new>...
///!
///! Every `.cryo` and `.md` file below each directory, and each file named
///! outright whatever its kind, is read as bytes. An
///! occurrence of `old` is replaced when each of its ends that is an
///! identifier character is not joined to another one, so `size` is not
///! found inside `size_of`, and `.size(` may be matched with its punctuation.
///! A directory named `build`, `.bin`, `target` or `.git` is skipped. A file
///! is rewritten only when it changed, and its count is printed.

namespace rename::main;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::env;
import std::fmt::{ println, eprintln };
import std::fs::{ File, Path };
import std::fs::directory::{ Directory, DirectoryEntry };

/// One spelling and the spelling written in its place.
type struct Replacement {
    old: String;
    new: String;
}

/// The replacements and what applying them has changed so far.
type struct Rename {
    replacements: Array<Replacement>;
    files: i64;
    occurrences: i64;

    static is_identifier_byte(byte: u8) -> boolean {
        return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90)
            || (byte >= 48 && byte <= 57) || byte == 95;
    }

    /// Whether `word` occurs at `at` in `text` with its identifier ends free.
    static matches_at(text: &Array<u8>, at: i64, word: Str) -> boolean {
        const length: i64 = word.length();
        if (at + length > text.length()) { return false; }
        for (mut i: i64 = 0; i < length; i++) {
            if (text[at + i] != word.as_bytes()[i]) { return false; }
        }
        if (Rename::is_identifier_byte(word.as_bytes()[0]) && at > 0
                && Rename::is_identifier_byte(text[at - 1])) {
            return false;
        }
        if (Rename::is_identifier_byte(word.as_bytes()[length - 1]) && at + length < text.length()
                && Rename::is_identifier_byte(text[at + length])) {
            return false;
        }
        return true;
    }

    /// Apply every replacement to the file at `path`; write it back if any applied.
    rewrite(mut &this, path: Path) -> void {
        const text: Array<u8> = match (File::read_bytes(path)) {
            Result::Ok(bytes) => { bytes }
            Result::Err(error) => {
                eprintln(f"cryo-rename: cannot read {path.as_str()}");
                return;
            }
        };
        mut out: Array<u8> = Array::with_capacity(text.length());
        mut count: i64 = 0;
        mut at: i64 = 0;
        while (at < text.length()) {
            mut replaced: boolean = false;
            for (mut r: i64 = 0; r < this.replacements.length(); r++) {
                const old: Str = this.replacements[r].old.as_str();
                if (Rename::matches_at(&text, at, old)) {
                    out.append(this.replacements[r].new.as_str().as_bytes());
                    at = at + old.length();
                    count = count + 1;
                    replaced = true;
                    break;
                }
            }
            if (!replaced) {
                out.push(text[at]);
                at = at + 1;
            }
        }
        if (count == 0) { return; }
        match (File::write_bytes(path, out.as_slice())) {
            Result::Ok(_) => { }
            Result::Err(error) => {
                eprintln(f"cryo-rename: cannot write {path.as_str()}");
                return;
            }
        }
        println(f"{path.as_str()}: {count}");
        this.files = this.files + 1;
        this.occurrences = this.occurrences + count;
    }

    /// Rewrite every `.cryo` and `.md` file below `directory`.
    walk(mut &this, directory: Path) -> void {
        const entries = match (Directory::entries(directory)) {
            Result::Ok(found) => { found }
            Result::Err(error) => {
                eprintln(f"cryo-rename: cannot list {directory.as_str()}");
                return;
            }
        };
        for (entry in entries) {
            const name: Str = entry.name();
            if (entry.is_directory()) {
                if (name != Str::new("build") && name != Str::new(".bin")
                        && name != Str::new("target") && name != Str::new(".git")) {
                    this.walk(entry.path());
                }
            } else if (name.ends_with(&Str::new(".cryo")) || name.ends_with(&Str::new(".md"))) {
                this.rewrite(entry.path());
            }
        }
    }
}

function main() -> i32 {
    const arguments: Array<String> = env::args();
    mut directories: Array<String> = Array::new();
    mut rename: Rename = Rename { replacements: Array::new(), files: 0, occurrences: 0 };
    mut after_separator: boolean = false;
    for (mut i: i64 = 1; i < arguments.length(); i++) {
        const argument: Str = arguments[i].as_str();
        if (argument == Str::new("--")) {
            after_separator = true;
        } else if (!after_separator) {
            directories.push(arguments[i].clone());
        } else {
            match (argument.split_once(&Str::new("="))) {
                Option::Some(pair) => {
                    rename.replacements.push(Replacement {
                        old: String::from_str(pair.first),
                        new: String::from_str(pair.second)
                    });
                }
                Option::None => {
                    eprintln(f"cryo-rename: `{argument}` is not <old>=<new>");
                    return 2;
                }
            }
        }
    }
    if (directories.length() == 0 || rename.replacements.length() == 0) {
        eprintln(String::from_str(Str::new("usage: cryo-rename <directory>... -- <old>=<new>...")));
        return 2;
    }
    for (mut i: i64 = 0; i < directories.length(); i++) {
        const path: Path = Path::from(directories[i].as_str());
        if (path.is_file()) {
            rename.rewrite(path);
        } else {
            rename.walk(path);
        }
    }
    println(f"cryo-rename: {rename.occurrences} occurrence(s) in {rename.files} file(s)");
    return 0;
}
