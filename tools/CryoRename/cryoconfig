# CryoRename - a whole-word rename across a source tree, the generator of
# the standard library's spelled-out names.  Run from the repository root:
#
#   cryo-rename <directory>... -- <old>=<new>...
#
# Every `.cryo` and `.md` file under each directory is read as bytes and
# each occurrence of an `old` whose ends are not joined to another
# identifier character is written as its `new`; a file is rewritten only
# when something changed, and the count per file is printed.

[project]
project_name = "cryo-rename"
output_dir   = "build"
target_type  = "executable"
entry_point  = "src/main.cryo"

[compiler]
debug    = false
optimize = O2

