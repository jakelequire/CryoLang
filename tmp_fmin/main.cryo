namespace FminRepro;
import std::math;
import std::fmt;

function main() -> int {
    fmt::printf("F64_MIN finite? %d\n", math::is_finite(math::F64_MIN) as i32);
    fmt::printf("F64_MAX finite? %d\n", math::is_finite(math::F64_MAX) as i32);
    const negmax: f64 = 0.0 - math::F64_MAX;
    fmt::printf("diff == 0? %d\n", (math::F64_MIN - negmax == 0.0) as i32);
    return 0;
}
