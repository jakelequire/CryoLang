# runtime/abi/lang_items.def — canonical lang-item symbol registry
#
# The single source of truth for every `__cryo_`-prefixed runtime symbol the
# compiler emits calls into. A symbol's spelling lives here and nowhere else in
# prose: runtime code defines each item as a `![no_mangle]` function whose
# source name IS the symbol, and generated code references it by codegen, never
# by a hand-typed string. When adding or changing a lang item, edit this file
# first, then the definition.
#
# Columns: SYMBOL | SIGNATURE | DEFINED-BY (tier) | STATUS
#
# ABI conventions (settled — see runtime/NOTES-capabilities.md §D):
#   - string   : the primitive thin, NUL-terminated `i8*` (8 bytes). This is the
#                panic message/file operand type. No compiler change: today's
#                `@panic` already passes `i8*`, and message/file are always
#                codegen-emitted static NUL-terminated literals, so the call
#                sites build no fat pointer. (No embedded NUL / explicit length —
#                fine for static panic strings.)
#   - SourceLoc: POD { file: string, line: u32, col: u32 }, 16 bytes (see
#                layout.def). Codegen constructs it zero-alloc from static data.
#   - Message/file strings are static, codegen-emitted bytes — never heap.
#   - The panic seam is abort-now / unwind-ready: the check helpers CALL
#     __cryo_panic; nothing inlines abort/trap assuming the abort strategy.
#     Adding `--panic=unwind` later must require no change to any core/ file.

# --- Entry (freestanding profile) ------------------------------------------
# Per-OS. AMD and Intel share the x86-64 ISA -> one x86-64 codepath covers both
# vendors; the split that matters is OS ABI (Linux vs Windows). Present only in
# no_runtime builds; a hosted program uses crt0's entry instead.
#
# Linux: the ELF entry the linker resolves under `-nostartfiles`. Reads argc/argv
# off the initial stack, hands them to __cryo_start. Fully freestanding (no libc,
# no imports). Exit = `exit_group` syscall.
_start          | ![naked] () -> void                       | core (freestanding, linux) | DONE (linux)
# Startup trampoline: runs the user `main` and exits with its return. `main` is
# an external C-ABI symbol resolved from the user object.
__cryo_start    | (argc: i64, argv: i8**) -> never          | core (freestanding, linux) | DONE (linux)
#
# Windows: PE startup passes no stack args and has no stable raw-syscall ABI, so
# the entry links ntdll (its sole dependency) and exits via NtTerminateProcess.
# Argument capture (PEB / command line) is deferred. The driver's no_runtime link
# emits `-nostartfiles -nostdlib -Wl,-e,_start -lntdll` for a windows target.
_start          | ![naked] () -> void  (PE entry, /entry=_start) | core (freestanding, windows) | DONE (windows)
# ntdll import, called by the windows exit path with (HANDLE)-1.
NtTerminateProcess | (process: i64, status: i32) -> i32  (extern, ntdll) | ntdll | (system)
# Satisfies the mingw backend's `call __main` in main's prologue (C global-ctor
# bootstrap). Empty for now; the ctor-array emitter (P3) will run ctors here.
__main          | () -> void                                | core (freestanding, windows) | DONE (windows)
#
# __cryo_start is shared (both OSes): run `main`, exit with its return. Argument
# capture deferred, so it takes no parameters on either target.

# --- Panic funnel ----------------------------------------------------------
# The single divergent sink. core/ only DECLARES it; panic/abort/ DEFINES it
# (prints message+location, then aborts). The unwind profile redefines it with
# no core/ change.
__cryo_panic              | (msg: string, file: string, line: u32) -> never  | panic/abort | PENDING (P7)

# --- Check handlers (route raw operands through the funnel) -----------------
# Each takes RAW operands (not a pre-formatted string) plus a SourceLoc, formats
# its own message, and diverges via __cryo_panic (or llvm.trap under no_runtime).
__cryo_panic_bounds_check | (loc: SourceLoc, index: u64, len: u64) -> never  | panic/abort | PENDING (P4)
__cryo_panic_overflow     | (loc: SourceLoc, op: u32, lhs: u64, rhs: u64) -> never | panic/abort | PENDING (P5)
__cryo_panic_div_zero     | (loc: SourceLoc) -> never                        | panic/abort | PENDING (P6)
__cryo_panic_no_match     | (loc: SourceLoc) -> never                        | panic/abort | PENDING (P6)

# --- Allocator (weak / user-overridable) -----------------------------------
# The codegen funnel is in place (P8): every heap site routes through
# ExprOps::emit_raw_alloc / emit_raw_dealloc (one resolver ladder:
# arena / allocator::alloc / malloc) instead of an open-coded copy each. The
# `__cryo_alloc`/`__cryo_dealloc` SYMBOLS land in Phase 3, when the funnel is
# pointed at a weak, user-overridable definition.
__cryo_alloc    | (size: u64, align: u64) -> void*          | alloc | PENDING (P2/P3; funnel done P8)
__cryo_dealloc  | (ptr: void*, size: u64, align: u64) -> void | alloc | PENDING (P2/P3; funnel done P8)
