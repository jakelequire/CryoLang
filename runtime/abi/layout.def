# runtime/abi/layout.def — POD layouts the compiler and runtime must agree on
#
# These are the byte-exact shapes codegen constructs and runtime handlers read.
# Pointer / u64 = 8 bytes. Offsets are from the aggregate base. A mismatch here
# is a silent memory-corruption bug, so both sides cite this file.
#
# See runtime/NOTES-capabilities.md §1.3 for the full type-layout table.

# Location — a place in the source, passed by address to the panic funnel and
# to every check handler. The layout of the language's
# `std::core::intrinsics::Location`; the runtime declares its own copy
# (`CryoRt::Sys::Location`), since it is built without the standard library. A
# check site's is materialized from static compile-time data (zero-alloc).
# `file` and `function` are `string`s (thin NUL-terminated i8*), matching the
# panic operand ABI.
struct Location {
    file:     string   # @0   static NUL-terminated path bytes (i8*)
    line:     u32      # @8   1-based
    column:   u32      # @12  1-based; 0 when unknown
    function: string   # @16  readable qualified name; null or empty when unknown
}   # size 24, align 8

# The panic message operand is the primitive `string` (thin NUL-terminated i8*,
# 8 bytes) — not a fat pointer.
