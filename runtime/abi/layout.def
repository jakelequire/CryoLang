# runtime/abi/layout.def — POD layouts the compiler and runtime must agree on
#
# These are the byte-exact shapes codegen constructs and runtime handlers read.
# Pointer / u64 = 8 bytes. Offsets are from the aggregate base. A mismatch here
# is a silent memory-corruption bug, so both sides cite this file.
#
# See runtime/NOTES-capabilities.md §1.3 for the full type-layout table.

# SourceLoc — passed to every check handler. Zero-alloc, no stdlib type; codegen
# materializes it from static compile-time data (file bytes are a static string).
# Carries column because codegen already has it and diagnostics want it.
struct SourceLoc {
    file: i8*    # @0   pointer to static NUL-terminated path bytes
    line: u32    # @8   1-based
    col:  u32    # @12  1-based
}   # size 16, align 8

# Str — the borrowed-UTF-8 fat pointer, the panic operand ABI. NOT NUL-relying:
# length is explicit. By-value ABI: SysV x86-64 -> DirectPair (two GP regs);
# Win64 -> Indirect (pointer to this struct). Matches stdlib collections::str.
struct Str {
    ptr: i8*     # @0   UTF-8 bytes, no trailing NUL required
    len: u64     # @8   byte length
}   # size 16, align 8
