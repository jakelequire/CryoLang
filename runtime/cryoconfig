# runtime/ - the Cryo runtime, one library built once per configuration.
#
# The compiler builds the configuration a program links on first use (see
# lib.cryo): `cryo build runtime --no-runtime` for a freestanding program,
# `--panic=abort` or `--panic=unwind` for a hosted one.  Each lands in its own
# directory under .bin/<triple>/<configuration>/<key>/, as libcryort.a.
#
# `no_std`: no build of the runtime links the stdlib.  A freestanding link
# drops libcryo.a, and a hosted program must not drag the stdlib in through
# its panic path.

[project]
project_name = "cryort"
output_dir = ".bin"

[lib]
name = "cryort"
source_dir = "."

[compiler]
no_std = true
