# runtime/ — the Cryo runtime workspace.
#
# One project, several independent library tiers. Each `[[lib]]` member builds
# from its own source tree into its own archive (libcryort-<name>.a), sharing
# the project-level `[compiler]` config below. Separate archives are what let
# the final user link SELECT among them — e.g. the panic strategy (panic/abort
# vs a future panic/unwind, both defining __cryo_panic) is chosen by which
# archive is on the link line, and the allocator tier can be user-overridden.
#
# `no_runtime = true` implies `no_std = true`: a freestanding link drops
# libcryo.a, so any stdlib symbol would fail to resolve. Every member is
# freestanding — output and process exit go straight to the OS.
#
# Build all tiers:  cryo build         (from this directory)
# Archives land in: .bin/libcryort-<name>.a

[project]
project_name = "cryort"
output_dir = ".bin"

[compiler]
no_std = true
no_runtime = true
emit_llvm = true

# Base tier: freestanding dual-OS program entry (_start / __cryo_start).
[[lib]]
name = "cryort-core"
source_dir = "core/src"

# Panic strategy = abort: defines __cryo_panic (print + terminate). A future
# [[lib]] "cryort-panic-unwind" would define the same symbol differently.
[[lib]]
name = "cryort-panic-abort"
source_dir = "panic/abort/src"
