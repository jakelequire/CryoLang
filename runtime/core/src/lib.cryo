///! runtime/core — base tier of the Cryo runtime.
///!
///! Built twice from these same sources: freestanding (`no_runtime` + `no_std`)
///! into libcryort-core.a, and hosted (`no_std` only) into
///! libcryort-core-hosted.a. This root carries the program entry; the lang-item
///! declarations (the `__cryo_panic` funnel and check handlers, see
///! `../../abi/lang_items.def`) arrive alongside their compiler-emitted call
///! sites in later tiers.

namespace CryoRt::Core;

/// The program entry: `_start` / `__cryo_start` in a freestanding build,
/// `__cryo_entry` / `__cryo_hosted_start` in a hosted one.
public module entry;
