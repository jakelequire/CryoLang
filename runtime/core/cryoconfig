# runtime/core — the base runtime tier.
#
# Built freestanding (no crt0, no libc, no stdlib) into its own archive,
# libcryort-core.a, exactly like the stdlib's libcryo.a. Tiers are separate
# archives (NOT path-deps): a path-dep would be source-harvested into one
# unified build and flatten this per-tier `no_runtime` config. The driver
# orders the tier archives on the link line.
#
# `no_runtime = true` implies `no_std = true`: a freestanding link drops
# libcryo.a, so any stdlib symbol would fail to resolve.

[project]
project_name = "cryort-core"
output_dir = ".bin"
target_type = "library"
source_dir = "src"

[compiler]
no_std = true
no_runtime = true
emit_llvm = true
