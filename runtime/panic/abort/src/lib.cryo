///! runtime/panic/abort — the abort panic strategy.
///!
///! Defines the panic funnel `__cryo_panic` (see `../../abi/lang_items.def`):
///! write "panicked at <file>:<line>: <msg>" to stderr, then terminate (exit
///! code 101). This tier is the abort strategy; a `panic/unwind` tier would
///! define the same symbol to unwind instead, chosen at link time — callers
///! never change.
///!
///! The four check handlers take raw operands plus a `SourceLoc`, format their
///! own message into a stack buffer, and funnel through `__cryo_panic`. Nothing
///! here assumes the abort strategy beyond the funnel it calls, so the unwind
///! tier can redefine `__cryo_panic` unchanged.
///!
///! Write/format/exit primitives come from the shared `CryoRt::Sys` module.

namespace CryoRt::Panic::Abort;

import CryoRt::Sys;

/// Source location passed to every check handler, matching `abi/layout.def`:
/// `{ file: string @0, line: u32 @8, col: u32 @12 }`, 16 bytes. Codegen
/// constructs it zero-alloc from static data; the handlers read `file`/`line`.
type struct SourceLoc {
    file: string;
    line: u32;
    col:  u32;
}

/// The single panic sink. Prints `panicked at <file>:<line>: <msg>` and
/// terminates. `![no_mangle]` makes the source name the emitted symbol.
![no_mangle] ![config(no_runtime)]
function __cryo_panic(msg: string, file: string, line: u32) -> never {
    Sys::write_cstr("panicked at ");
    Sys::write_cstr(file);
    Sys::write_cstr(":");
    Sys::write_u32(line);
    Sys::write_cstr(": ");
    Sys::write_cstr(msg);
    Sys::write_cstr("\n");
    Sys::rt_exit(101);
}

// --- Check handlers ---------------------------------------------------------

/// Index out of bounds: "index <index> out of bounds for length <len>".
![no_mangle] ![config(no_runtime)]
function __cryo_panic_bounds_check(loc: SourceLoc, index: u64, len: u64) -> never {
    mut buf: u8[128];
    mut pos: u64 = 0;
    Sys::append_cstr(&buf[0], &pos, "index ");
    Sys::append_u64(&buf[0], &pos, index);
    Sys::append_cstr(&buf[0], &pos, " out of bounds for length ");
    Sys::append_u64(&buf[0], &pos, len);
    buf[pos] = 0;
    __cryo_panic(&buf[0] as string, loc.file, loc.line);
}

/// Arithmetic overflow. `op` is a raw operation code (mapping pinned later);
/// the operands are printed so the failure is distinguishable now.
![no_mangle] ![config(no_runtime)]
function __cryo_panic_overflow(loc: SourceLoc, op: u32, lhs: u64, rhs: u64) -> never {
    mut buf: u8[128];
    mut pos: u64 = 0;
    Sys::append_cstr(&buf[0], &pos, "arithmetic overflow (op ");
    Sys::append_u64(&buf[0], &pos, op as u64);
    Sys::append_cstr(&buf[0], &pos, "): ");
    Sys::append_u64(&buf[0], &pos, lhs);
    Sys::append_cstr(&buf[0], &pos, ", ");
    Sys::append_u64(&buf[0], &pos, rhs);
    buf[pos] = 0;
    __cryo_panic(&buf[0] as string, loc.file, loc.line);
}

/// Division or remainder by zero (also the `INT_MIN / -1` case).
![no_mangle] ![config(no_runtime)]
function __cryo_panic_div_zero(loc: SourceLoc) -> never {
    __cryo_panic("attempt to divide by zero", loc.file, loc.line);
}

/// Fell through a non-exhaustive match with no arm for the scrutinee.
![no_mangle] ![config(no_runtime)]
function __cryo_panic_no_match(loc: SourceLoc) -> never {
    __cryo_panic("no matching pattern (non-exhaustive match)", loc.file, loc.line);
}
