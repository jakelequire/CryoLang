///! runtime/panic/abort — the abort panic strategy.
///!
///! Defines the panic funnel `__cryo_panic` (see `../abi/lang_items.def`):
///! write "panicked at <file>:<line>:<column> in <function>: <msg>" to stderr,
///! then terminate (exit code 101). Every declaration here is gated
///! `not(panic_unwind)`: a build compiled with the abort strategy defines it,
///! and `panic/unwind` defines the same symbols for a build compiled to unwind.
///!
///! The four check handlers take raw operands plus a `Location`, format their
///! own message into a stack buffer, and funnel through `__cryo_panic`.
///!
///! Write/format/exit primitives come from the shared `CryoRt::Sys` module.
///!
///! Nothing here is gated on `no_runtime`: the freestanding and the hosted
///! abort builds both define it. They differ only in which `Sys::rt_exit`
///! `Sys::end_panicking_process` reaches — raw `exit_group`/`NtTerminateProcess`,
///! or libc `exit` so the panicking program's buffered stdio is flushed on the
///! way out.

namespace CryoRt::Panic::Abort;

import CryoRt::Sys;

/// The thread ending the process after a panic, or 0 while none is
/// (`Sys::end_panicking_process`). A plain global, not thread-local: it is one
/// record for the whole process.
![config(not(panic_unwind))]
mut terminating_thread: u64 = 0;

/// The single panic sink. Prints the report (`Sys::write_panic_report`) and
/// terminates. `![no_mangle]` makes the source name the emitted symbol.
![no_mangle] ![config(not(panic_unwind))]
function __cryo_panic(msg: string, loc: Sys::Location*) -> never {
    Sys::write_panic_report(msg, loc);
    Sys::end_panicking_process(&terminating_thread);
}

// --- Unwind-surface stubs ---------------------------------------------------
// Both strategies export the SAME symbol surface and differ only in behaviour.
// These exist in the unwind strategy because unwinding needs them, and here
// because a program's objects can still NAME them under abort: a personality,
// the caught-panic accessors, the caught-panic report. Without these the link
// fails on undefined symbols that no abort-strategy program could ever call.
//
// Deliberately storage-free: no `![thread_local]`, because this strategy is
// also linked `-nostdlib` into freestanding programs, where a TLS reference would
// drag in a C-runtime symbol (`_tls_index` on Windows) that such a link cannot
// resolve.

/// Under abort a panic never returns and never unwinds, so no `catch_unwind` can
/// observe one and these are unreachable. They report "no panic taken" rather
/// than inventing a payload.
![no_mangle] ![config(not(panic_unwind))]
function __cryo_panic_taken_message() -> string { return null; }

![no_mangle] ![config(not(panic_unwind))]
function __cryo_panic_taken_file() -> string { return null; }

![no_mangle] ![config(not(panic_unwind))]
function __cryo_panic_taken_line() -> u32 { return 0; }

/// A caught panic's report: nothing is ever caught here, so there is none.
![no_mangle] ![config(not(panic_unwind))]
function __cryo_panic_write_report() -> void { }

/// The unwind strategy's root-catch tail. Unreachable here — the compiler only
/// synthesizes the root-catch `main` wrapper that calls it under `--panic=unwind`
/// — but terminate with the panic exit code rather than returning into a caller
/// that assumed divergence.
![no_mangle] ![config(not(panic_unwind))]
function __cryo_panic_finish() -> never {
    Sys::end_panicking_process(&terminating_thread);
}

/// The language personality, in each OS's calling convention: Linux is called
/// with the Itanium 5-argument signature, Windows through `.xdata` with the
/// 4-argument SEH one. Nothing in an abort build raises, so the only way to
/// arrive here is a genuine hardware exception, and the correct answer for a
/// strategy with no handlers is "keep searching".
![no_mangle] ![config(linux)] ![config(not(panic_unwind))]
function __cryo_personality_v0(version: i32, actions: i32, exception_class: u64,
                               exception_object: i64, context: i64) -> i32 {
    return 8;   // _URC_CONTINUE_UNWIND
}

![no_mangle] ![config(windows)] ![config(not(panic_unwind))]
function __cryo_personality_v0(ms_exc: i64, this_frame: i64,
                               ms_orig_context: i64, ms_disp: i64) -> i32 {
    return 1;   // ExceptionContinueSearch
}

// --- Check handlers ---------------------------------------------------------

/// Index out of bounds: "index <index> out of bounds for length <len>".
![no_mangle] ![config(not(panic_unwind))]
function __cryo_panic_bounds_check(loc: Sys::Location*, index: u64, len: u64) -> never {
    mut buf: [u8; 128];
    mut pos: u64 = 0;
    Sys::append_cstr(&buf[0], &pos, "index ");
    Sys::append_u64(&buf[0], &pos, index);
    Sys::append_cstr(&buf[0], &pos, " out of bounds for length ");
    Sys::append_u64(&buf[0], &pos, len);
    buf[pos] = 0;
    __cryo_panic(&buf[0] as string, loc);
}

/// An integer operation whose true result leaves its type's range, where
/// the build checks for overflow, or an array allocation's byte size.
/// `operation` is the code `lang_items.def` gives it.
![no_mangle] ![config(not(panic_unwind))]
function __cryo_panic_overflow(loc: Sys::Location*, operation: u32) -> never {
    __cryo_panic(Sys::overflow_message(operation), loc);
}

/// Division or remainder by zero (also the `INT_MIN / -1` case).
![no_mangle] ![config(not(panic_unwind))]
function __cryo_panic_div_zero(loc: Sys::Location*) -> never {
    __cryo_panic("attempt to divide by zero", loc);
}

/// Fell through a non-exhaustive match with no arm for the scrutinee.
![no_mangle] ![config(not(panic_unwind))]
function __cryo_panic_no_match(loc: Sys::Location*) -> never {
    __cryo_panic("no matching pattern (non-exhaustive match)", loc);
}
