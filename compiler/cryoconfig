# Cryo Compiler Project
#
# Multi-target build:
#   [lib]      → build/libcompiler.a (the self-hosted compiler as a library)
#   [[bin]]    → build/bin/cryo      (the CLI driver: argv → CompilerInstance)
#
# Tools that want to drive the compiler (LSP, formatter, analyzer) can
# depend on the [lib] half via the project's `[dependencies]` system.

[project]
project_name = "cryo"
output_dir = "build"
# Legacy single-target fields kept here so the currently-pinned bin/cryo
# (which only knows the legacy schema) can still bootstrap a new
# self-hosted compiler that understands [lib] / [[bin]].  Once the new
# binary is pinned via `make pin-cryo`, these can be removed.
target_type = "executable"
entry_point = "src/main.cryo"

[lib]
name = "compiler"
source_dir = "src/compiler"

[[bin]]
name = "cryo"
entry_point = "src/main.cryo"

[compiler]
debug = false
optimize = true
args = ["--emit-llvm"]
no_std = false
link_libs = ["LLVM-20"]
link_paths = ["/usr/lib/llvm-20/lib"]
# The compiler library at src/compiler imports Utils::* from src/utils.
# Both targets need src/utils on their scan path; the executable's
# entry_point already covers it transitively, the library does not.
include_paths = ["src/utils"]
