# Cryo Compiler Project
#
# Multi-target build:
#   [lib]      → build/libcompiler.a (the self-hosted compiler as a library)
#   [[bin]]    → build/bin/cryo      (the CLI driver: argv → CompilerInstance)
#
# Tools that want to drive the compiler (LSP, formatter, analyzer) can
# depend on the [lib] half via the project's `[dependencies]` system.

[project]
project_name = "cryo"
output_dir = "build"

[lib]
name = "compiler"
# Whole-of-src layout: the lib spans every namespace under src/, which
# covers Compiler::* (src/compiler) and Utils::* (src/utils) without
# needing a separate include_paths declaration.  Discovery starts from
# src/_module.cryo, which imports each top-level namespace to seed the
# loader's transitive walk.
source_dir = "src"

[[bin]]
name = "cryo"
entry_point = "src/main.cryo"

[compiler]
debug = false
optimize = O2
emit_llvm = true
no_std = false

# libLLVM is platform-divergent, so it lives in per-OS `[link]` overlays
# rather than the common `[link]` section: the host links the system shared
# library (`-lLLVM-20`, off the default search path under
# /usr/lib/llvm-20/lib), while a windows-gnu cross-link needs the
# mingw-targeted LLVM-C import library instead.  Keeping them separate stops
# the host build from dragging the Linux .so into a Windows link (and
# vice-versa).  The bare `[link]` common section is intentionally absent —
# every lib the compiler needs is platform-specific.
#
# The pinned compiler must understand these sections; if you ever roll the
# pin back to one that predates per-OS overlays, move LLVM-20 back into a
# bare `[link]` for the bootstrap build (see git history of this file).

[link.unix]
system = ["LLVM-20"]
search = ["/usr/lib/llvm-20/lib"]

# [link.windows]
# A windows-gnu cross-link of the compiler needs the mingw import library
# for LLVM's C API (LLVM-C.dll).  `scripts/fetch-windows-llvm.sh` downloads
# the official LLVM Windows release, extracts LLVM-C.dll, and synthesizes a
# mingw import lib (libLLVM-C.dll.a) under a local prefix; it prints the
# exact block to paste here.  `system` names the import library ("LLVM-C"),
# `search` is the directory that holds libLLVM-C.dll.a.  Verified end-to-end:
# the cross-linked cryo.exe runs under wine and emits valid COFF objects.
# system = ["LLVM-C"]
# search = ["/home/<you>/.local/llvm-20-mingw/lib"]
