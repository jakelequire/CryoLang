///! Project Configuration
///!
///! Parses `cryoconfig` INI-like project files to configure multi-module
///! compilation.  Provides target type policies and project root discovery.

namespace Compiler::ProjectConfig;

import Utils::Logger;
import std::fmt;
import std::fs::file;
import std::fs::metadata;
import std::fs::path;
import std::collections::str;
import std::collections::string;


// Native-build cache bucket, stamped at compile time per the OS this compiler
// runs on.  Used by `ProjectConfig::target_subdir` when no `--target` is set,
// so a Linux `cryo` and a Windows `cryo.exe` (run under wine) keep their
// native intermediates in disjoint `target/release/<bucket>/` trees instead
// of both claiming `host/` and clobbering each other's `.o`/`.ll`.  Linux
// keeps the historical `host` name so existing caches/paths are unchanged.
![target(unix)]
private function native_target_subdir() -> string { return "host"; }
![target(windows)]
private function native_target_subdir() -> string { return "host-windows"; }


/// What kind of output the project produces.
type enum TargetType {
    /// Produces an executable with a main() entry point.
    Executable;
    /// Produces a library (no main, exports public API).
    Library;
    /// Batch-compiles stdlib modules (no auto-imports).
    Stdlib;
}

implement enum TargetType {
    label(&this) -> string {
        return match (this) {
            TargetType::Executable => { "executable" }
            TargetType::Library    => { "library"    }
            TargetType::Stdlib     => { "stdlib"     }
        };
    }

    /// Parse a target type from a string.  Unrecognized values default to
    /// `Executable`.
    static from_string(s: string) -> TargetType {
        if (s.eq("library")) { return TargetType::Library; }
        if (s.eq("stdlib"))  { return TargetType::Stdlib; }
        return TargetType::Executable;
    }
}


// LibTarget / BinTarget: multi-target output declarations

/// One library output produced from a project.  Empty `name` means the
/// project does not declare a `[lib]` section.
type struct LibTarget {
    name:       string;     // library archive name (libcompiler.a -> "compiler")
    source_dir: string;     // root of the library's source tree

    static empty() -> LibTarget {
        return LibTarget { name: "", source_dir: "" };
    }

    is_present(&this) -> boolean {
        return this.name.length() > 0;
    }
}

/// One executable output produced from a project.  Multi-target projects
/// may declare any number via `[[bin]]` array-of-tables.
type struct BinTarget {
    name:        string;    // executable filename (bin/cryo -> "cryo")
    entry_point: string;    // path to the entry .cryo file

    static empty() -> BinTarget {
        return BinTarget { name: "", entry_point: "" };
    }
}


// Dependency: entries under [dependencies]

/// What kind of source a `[dependencies]` entry points at.
type enum DepKind {
    /// Local filesystem path (relative to the consumer's project root).
    Path;
    /// Remote git repository fetched into the global cryo cache and
    /// pinned by `cryoconfig.lock`.
    Git;
    /// Schema error.  The parser emitted a diagnostic; downstream
    /// resolution treats this as a hard failure.
    Invalid;
}

/// Which kind of ref selects a git dep's commit.  At most one of
/// `version`, `tag`, `branch`, `rev` may appear in the inline table.
/// `None` is only valid for non-git deps.
type enum GitRefKind {
    None;
    /// `version = "0.1.0"` or `version = "^0.1.0"`.  Resolves to the
    /// highest matching tag at fetch time.
    Version;
    /// `tag = "v0.1.0"`: exact match against a remote ref.
    Tag;
    /// `branch = "main"`: resolves to the tip of the branch.
    Branch;
    /// `rev = "<full or short sha>"`.
    Rev;
}

/// One entry in `[dependencies]`.  Two forms are accepted:
///
///   <name> = { path = "<rel>" [, alias = "<NS>"] }
///   <name> = { git  = "<url>", (version | tag | branch | rev) = "<v>"
///              [, subdir = "<sub>"] [, alias = "<NS>"] }
///
/// **Path deps** are resolved against the consumer's project root and
/// must contain their own `cryoconfig`.
///
/// **Git deps** are fetched into the global cache by `cryo fetch`,
/// pinned in `cryoconfig.lock`, and resolved through there at build
/// time.  The dep's `cryoconfig` is expected at the repo root unless
/// `subdir` overrides.
///
/// `alias` is the top-level namespace the consumer expects, currently
/// informational; a future warning fires if the dep's source declares
/// a different one.
type struct Dependency {
    name:  string;
    kind:  DepKind;
    alias: string;

    // ---- Path deps ----
    /// Filesystem path relative to the consumer's project root.
    /// Empty for git deps.
    path:  string;

    // ---- Git deps ----
    /// `https://...`, `git@...:...`, etc.  Empty for path deps.
    git_url:  string;
    /// Which of `version`/`tag`/`branch`/`rev` was supplied.
    /// `None` for path deps.
    ref_kind: GitRefKind;
    /// The literal value of whichever ref-key was supplied.
    ref_val:  string;
    /// Subpath into the repo where the dep's `cryoconfig` lives.
    /// Empty <=> repo root.
    subdir:   string;

    static empty() -> Dependency {
        return Dependency {
            name:     "",
            kind:     DepKind::Path,  // overwritten by parse_inline_table_into_dep
            alias:    "",
            path:     "",
            git_url:  "",
            ref_kind: GitRefKind::None,
            ref_val:  "",
            subdir:   "",
        };
    }

    /// True for git deps that name a fixed commit (`rev = "<sha>"`),
    /// where no remote lookup is needed beyond the initial clone.
    is_pinned_rev(&this) -> boolean {
        return this.kind == DepKind::Git
            && this.ref_kind == GitRefKind::Rev;
    }
}

/// One `[vendor.<Name>]` project pin.  Locks `import vendor::<Name>` for this
/// project to a specific target `triple`'s generated bindings, overriding the
/// build's default target triple for that one library.  The library's source
/// (headers / include dirs / link metadata) still comes from the global vendor
/// registry - the pin only selects which triple's bindings to resolve against
/// (and auto-generate on a cache miss; see the AutoVendor pre-build hook and
/// the loader's `vendor::` resolution branch).
///
/// Resolution precedence is project pin -> global registry -> not-found: a pin
/// fully shadows the build triple for its library, but a library that is not
/// registered globally has no source to generate from, so its pin is reported
/// and ignored (the normal E0500 "cannot find module" path then fires).
///
/// `name` is the import namespace taken verbatim from the section header
/// (`[vendor.RayLib]` -> "RayLib"); an empty `triple` means "use the build's
/// own `target_triple`", which makes the pin a no-op.  Both fields are
/// non-owning `string`s, so `VendorPin` is Copy and safe to pass/return by
/// value (mirrors `BinTarget` / `Dependency`).
type struct VendorPin {
    name:   string;
    triple: string;

    static empty(name: string) -> VendorPin {
        return VendorPin { name: name, triple: "" };
    }
}

/// Parsed representation of a `cryoconfig` file.
type struct ProjectConfig {
    project_name: string;
    output_dir:   string;
    target_type:  TargetType;
    entry_point:  string;      // relative path from project root (executables)
    source_dir:   string;      // root source directory (libraries/stdlib)
    debug:        boolean;
    // LLVM optimization level 0..3, from `[compiler] optimize` in C-style
    // (`O0`/`O1`/`O2`/`O3`). Defaults to 2. See `parse_opt_level`.
    opt_level:    u32;
    /// True when `[compiler] optimize` was explicitly set in cryoconfig.
    /// Lets profile resolution (`debug` => O0, `release` => O2) supply the
    /// optimization level only when the project did not pin one itself: an
    /// explicit `optimize = O3` still wins over the profile default, while an
    /// unset key lets `--dev`/`debug` profile drop to O0 instead of the
    /// always-O2 historical default.
    opt_level_explicit: boolean;
    /// Selected build profile name. Drives the per-profile cache subtree
    /// (`<output_dir>/target/<profile>/`) and the default optimization /
    /// debug-info level. `"release"` (O2, no debug info) by default;
    /// `"debug"` is O0 + DWARF. Set by `[profile] default = "..."` and
    /// overridden by the CLI `--release` / `--dev` / `--profile=NAME` flags.
    profile:      string;
    no_std:       boolean;
    native_alloc: boolean;
    emit_llvm:    boolean;
    /// `[compiler] codegen_threads = N` - worker count for parallel object
    /// emission.  `-1` (unset) => the online CPU count; `1` forces serial
    /// codegen.  The CLI `--codegen-threads=N` overrides this.  Never affects
    /// emitted bytes (each object is compiled independently), only build speed.
    codegen_threads: i64;
    /// Compile-once, link-twice.  Set (to the `[lib]` name, e.g. "compiler")
    /// on a `[[bin]]` view when the project also declares a `[lib]` whose
    /// closure the bin's compile covers: after the bin links, the driver
    /// bundles `lib<name>.a` from the bin's own object set (minus the entry
    /// module's object) instead of running a second full `[lib]` compile.
    /// Empty (`""`) => no derived archive.  Never affects the executable's
    /// bytes (the bin compile is unchanged); only skips redundant work.
    bundle_lib_from_bin: string;
    /// `[experimental] cxx_ffi = true` - opt-in to consuming C++ vendor
    /// libraries (`import vendor::<lib>` whose registry entry is `cxx-headers`
    /// / `language = "c++"`). Off by default: a build that imports a C++
    /// binding without this set fails with E0505, since the Strategy-A C++
    /// bindgen (mangled-symbol binding, no shim) is still experimental.
    /// Scoped to the consuming project - `cryo vendor` registration is
    /// unaffected (it runs without a project cryoconfig).
    cxx_ffi:      boolean;
    project_root: string;      // directory containing cryoconfig
    /// Cross-compilation target triple (e.g. "x86_64-pc-windows-gnu").
    /// Empty string <=> build for the host.  Set in cryoconfig under
    /// `[project] target = "..."`; CLI `--target=TRIPLE` overrides.
    /// Threaded into LLVM via `LLVMSetTarget` at IR generation time;
    /// suppresses the `cc` link step when it differs from the host so
    /// cross-compiled object files aren't fed to the host linker.
    target_triple: string;
    /// Project-pinned stdlib root.  Set in cryoconfig under
    /// `[project] stdlib_root = "/path/to/stdlib"`; empty string <=> unset
    /// (use the binary-relative auto-detection).  Used by projects that
    /// live outside the Cryo repo and want to avoid relying on env vars
    /// or `--stdlib`.  Sits between `$CRYO_STDLIB` and binary-relative
    /// auto-detection in `resolve_stdlib_root`'s priority chain; env
    /// vars and CLI flags can still override it for one-off invocations.
    stdlib_root:  string;
    /// `[link]` section.  Three intent-named roles so a project never has
    /// to juggle two similar `link_*` lists:
    ///   system -> `-l<name>`  (linker resolves on its default search path)
    ///   search -> `-L<dir>`   (extra dirs for resolving `system` libs that
    ///                          live off the default path, e.g. LLVM-20)
    ///   static -> the path is passed to the linker verbatim (a local
    ///             archive such as "helpers/libabihelpers-unix.a")
    link_system:  string[];    // e.g. ["LLVM-20"]              -> `-lLLVM-20`
    link_search:  string[];    // e.g. ["/usr/lib/llvm-20/lib"] -> `-L...`
    link_static:  string[];    // e.g. ["helpers/libabihelpers-unix.a"] (path verbatim)
    /// Per-OS `[link.unix]` / `[link.windows]` overlays.  Bare `[link]`
    /// above is common (applied to every target); these are appended on
    /// top only when the effective target triple's OS matches, so a
    /// project can point at LLVM (or any lib) by a different name/path
    /// per platform without the host build dragging the wrong libs into
    /// a cross-compile.  Same three roles (system -> `-l`, search ->
    /// `-L`, static -> verbatim path) as the common set.  Consumed in
    /// `run_linking` (codegen/passes.cryo) after the common loops.
    link_system_unix:     string[];
    link_search_unix:     string[];
    link_static_unix:     string[];
    link_system_windows:  string[];
    link_search_windows:  string[];
    link_static_windows:  string[];
    source_paths: string[];    // extra source roots resolved relative to
                               // project_root, e.g. ["../../compiler/src",
                               // "../../stdlib"] for tools that depend on
                               // the compiler library or stdlib sources.

    /// `[lib]` target.  Empty (`lib.name == ""`) when the project does
    /// not produce a library output.
    lib:  LibTarget;
    /// `[[bin]]` targets.  When non-empty, the project produces one
    /// executable per entry; the legacy `[project] target_type = "executable"`
    /// + `entry_point` are ignored in favour of these.
    bins: BinTarget[];
    /// `[dependencies]` entries.  Path deps point at a local directory;
    /// git deps point at a remote repository fetched into the global
    /// cache and pinned by `cryoconfig.lock`.  See `Dependency`.
    dependencies: Dependency[];

    /// `[vendor.<Name>]` project pins.  Each locks `import vendor::<Name>` to a
    /// target triple's bindings for this project, shadowing the build triple
    /// for that library and (via the AutoVendor pre-build hook) generating the
    /// bindings on a cache miss.  Empty when the project pins no vendor libs.
    /// See `VendorPin`.
    vendor_pins: VendorPin[];

    /// `[test] format = "..."` - preferred output format for the
    /// project's test runner. One of "plain" / "pretty" / "compact",
    /// or "" when unset (runner falls back to its built-in default).
    /// `cryo test` forwards this to the spawned test binary as
    /// `CRYO_TEST_FORMAT=...` unless the caller already passed
    /// `--format=...` on the CLI.
    test_format: string;
    /// `[test] color = "..."` - preferred color mode. One of
    /// "auto" / "always" / "never", or "" when unset. Forwarded to the
    /// spawned test binary via `CRYO_TEST_COLOR`.
    test_color: string;

    /// Number of schema errors detected while parsing this cryoconfig.
    /// Non-zero values indicate the build cannot proceed safely.
    /// Diagnostics are written to stderr at parse time; this counter
    /// lets downstream code detect the failure without re-scanning.
    error_count: i64;

    /// Create a default configuration.
    static default() -> ProjectConfig {
        return ProjectConfig {
            project_name: "unnamed",
            output_dir:   "build",
            target_type:  TargetType::Executable,
            entry_point:  "main.cryo",
            source_dir:   ".",
            debug:        false,
            // Optimized by default (O2). A project picks a level with
            // `[compiler] optimize = O0|O1|O2|O3` (or `cryo build
            // --opt-level=N`). Leaving it unset preserves the historical
            // always-O2 behavior.
            opt_level:    2,
            opt_level_explicit: false,
            profile:      "release",
            no_std:       false,
            native_alloc: false,
            emit_llvm:    false,
            codegen_threads: -1,
            bundle_lib_from_bin: "",
            cxx_ffi:      false,
            project_root: ".",
            target_triple: "",
            stdlib_root:  "",
            link_system:  [],
            link_search:  [],
            link_static:  [],
            link_system_unix:     [],
            link_search_unix:     [],
            link_static_unix:     [],
            link_system_windows:  [],
            link_search_windows:  [],
            link_static_windows:  [],
            source_paths: [],
            lib:          LibTarget::empty(),
            bins:         [],
            dependencies: [],
            vendor_pins:  [],
            test_format:  "",
            test_color:   "",
            error_count:  0,
        };
    }

    /// Deep copy.  All scalar fields are Copy; the owning arrays
    /// (`link_system`/`link_search`/`link_static`/`source_paths`/`bins`/
    /// `dependencies`) hold Copy elements (strings / BinTarget / Dependency),
    /// so each is rebuilt element-wise into an independent buffer.  Used by
    /// multi-target builds to derive a per-target view without consuming the
    /// shared base config.
    clone(&this) -> ProjectConfig {
        mut link_system_c:   string[]      = [];
        mut link_search_c:   string[]      = [];
        mut link_static_c:   string[]      = [];
        mut link_system_unix_c:    string[] = [];
        mut link_search_unix_c:    string[] = [];
        mut link_static_unix_c:    string[] = [];
        mut link_system_windows_c: string[] = [];
        mut link_search_windows_c: string[] = [];
        mut link_static_windows_c: string[] = [];
        mut source_paths_c:  string[]      = [];
        mut bins_c:          BinTarget[]   = [];
        mut deps_c:          Dependency[]  = [];
        mut vendor_pins_c:   VendorPin[]   = [];
        for (mut i: i64 = 0; i < this.link_system.length; i++)   { link_system_c.push(this.link_system[i]); }
        for (mut i: i64 = 0; i < this.link_search.length; i++)   { link_search_c.push(this.link_search[i]); }
        for (mut i: i64 = 0; i < this.link_static.length; i++)   { link_static_c.push(this.link_static[i]); }
        for (mut i: i64 = 0; i < this.link_system_unix.length; i++)    { link_system_unix_c.push(this.link_system_unix[i]); }
        for (mut i: i64 = 0; i < this.link_search_unix.length; i++)    { link_search_unix_c.push(this.link_search_unix[i]); }
        for (mut i: i64 = 0; i < this.link_static_unix.length; i++)    { link_static_unix_c.push(this.link_static_unix[i]); }
        for (mut i: i64 = 0; i < this.link_system_windows.length; i++) { link_system_windows_c.push(this.link_system_windows[i]); }
        for (mut i: i64 = 0; i < this.link_search_windows.length; i++) { link_search_windows_c.push(this.link_search_windows[i]); }
        for (mut i: i64 = 0; i < this.link_static_windows.length; i++) { link_static_windows_c.push(this.link_static_windows[i]); }
        for (mut i: i64 = 0; i < this.source_paths.length; i++)  { source_paths_c.push(this.source_paths[i]); }
        for (mut i: i64 = 0; i < this.bins.length; i++)          { bins_c.push(this.bins[i]); }
        for (mut i: i64 = 0; i < this.dependencies.length; i++)  { deps_c.push(this.dependencies[i]); }
        for (mut i: i64 = 0; i < this.vendor_pins.length; i++)   { vendor_pins_c.push(this.vendor_pins[i]); }
        return ProjectConfig {
            project_name:  this.project_name,
            output_dir:    this.output_dir,
            target_type:   this.target_type,
            entry_point:   this.entry_point,
            source_dir:    this.source_dir,
            debug:         this.debug,
            opt_level:     this.opt_level,
            opt_level_explicit: this.opt_level_explicit,
            profile:       this.profile,
            no_std:        this.no_std,
            native_alloc:  this.native_alloc,
            emit_llvm:     this.emit_llvm,
            codegen_threads: this.codegen_threads,
            bundle_lib_from_bin: this.bundle_lib_from_bin,
            cxx_ffi:       this.cxx_ffi,
            project_root:  this.project_root,
            target_triple: this.target_triple,
            stdlib_root:   this.stdlib_root,
            link_system:   link_system_c,
            link_search:   link_search_c,
            link_static:   link_static_c,
            link_system_unix:     link_system_unix_c,
            link_search_unix:     link_search_unix_c,
            link_static_unix:     link_static_unix_c,
            link_system_windows:  link_system_windows_c,
            link_search_windows:  link_search_windows_c,
            link_static_windows:  link_static_windows_c,
            source_paths:  source_paths_c,
            lib:           this.lib,
            bins:          bins_c,
            dependencies:  deps_c,
            vendor_pins:   vendor_pins_c,
            test_format:   this.test_format,
            test_color:    this.test_color,
            error_count:   this.error_count,
        };
    }

    /// True when the cryoconfig declares `[lib]` and/or one or more
    /// `[[bin]]` blocks.  Multi-target projects bypass the legacy
    /// single-target dispatch in `compile_project`.
    is_multi_target(&this) -> boolean {
        return this.lib.is_present() || this.bins.length > 0;
    }

    /// Whether this project requires an entry point (main function).
    requires_entry_point(&this) -> boolean {
        return match (this.target_type) {
            TargetType::Executable => { true }
            TargetType::Library    => { false }
            TargetType::Stdlib     => { false }
        };
    }

    /// Get the root file for module discovery.
    /// Executables use entry_point; libraries/stdlib use lib.cryo in
    /// source_dir, falling back to _module.cryo (the aggregator file
    /// every Cryo source directory carries).
    discovery_root_path(&this) -> string {
        if (this.requires_entry_point()) {
            return this.entry_point_path();
        }
        const base: string = if (this.project_root == ""
                                 || this.project_root.eq(".")) {
            this.source_dir
        } else {
            format("%s/%s", this.project_root, this.source_dir)
        };
        const lib_path: string = format("%s/lib.cryo", base);
        if (metadata::exists(Path::from(lib_path))) {
            return lib_path;
        }
        return format("%s/_module.cryo", base);
    }

    /// Parse a cryoconfig file at the given path.
    static parse(path: string) -> ProjectConfig {
        if (!metadata::exists(Path::from(path))) {
            cdebug("[ProjectConfig] Warning: cryoconfig not found at '%s', using defaults\n", path);
            return ProjectConfig::default();
        }

        mut content: string = "";
        match (file::read_to_string(Path::from(path))) {
            Result::Ok(s)  => { content = s.into_raw(); }
            Result::Err(_) => { return ProjectConfig::default(); }
        }

        // Extract project root from the config file path
        const project_root: string = path.parent_dir();

        mut config: ProjectConfig = ProjectConfig::default();
        config.project_root = project_root;

        // Parse INI-like format line by line.
        // Section names use a small extended vocabulary:
        //   "project" / "compiler" / "dependencies"
        //   "link"                                    [link]  (system/search/static)
        //   "lib"                                     [lib]
        //   "bin"                                     current [[bin]] entry
        //                                               (use current_bin_idx for which one)
        // current_bin_idx is -1 when not inside a [[bin]] block.
        mut current_section: string = "";
        mut current_bin_idx:  i64    = -1;
        // Index into config.vendor_pins for the current `[vendor.<Name>]`
        // section, or -1 when not inside one.  Set when the section header is
        // seen (mirrors current_bin_idx for `[[bin]]`).
        mut current_vendor_idx: i64  = -1;
        mut pos: i64 = 0;
        const len: i64 = content.length() as i64;

        while (pos < len) {
            // Extract one line
            const line_start: i64 = pos;
            while (pos < len && content[pos] != 10) {  // 10 = '\n'
                pos += 1;
            }
            const line: string = content.substr(line_start, pos - line_start);
            if (pos < len) { pos += 1; }  // skip '\n'

            // Skip empty lines and comments
            const trimmed: string = line.trim();
            if (trimmed.length() == 0) { continue; }
            if (trimmed[0] == 35) { continue; }  // 35 = '#'

            // Check for section header [section] or array-of-tables [[name]].
            if (trimmed[0] == 91) {  // 91 = '['
                const t_len: i64 = trimmed.length() as i64;
                const is_array: boolean = t_len >= 4
                    && trimmed[1] == 91                    // '[['
                    && trimmed[t_len - 1] == 93            // ']'
                    && trimmed[t_len - 2] == 93;           // ']]'
                if (is_array) {
                    // [[bin]] -> current_section = "bin", push fresh BinTarget.
                    current_section = trimmed.substr(2, t_len - 4);
                    current_vendor_idx = -1;
                    if (current_section.eq("bin")) {
                        config.bins.push(BinTarget::empty());
                        current_bin_idx = config.bins.length as i64 - 1;
                    } else {
                        current_bin_idx = -1;
                    }
                } else {
                    const close: i64 = trimmed.find_char(93 as i8);  // 93 = ']'
                    if (close > 1) {
                        current_section = trimmed.substr(1, close - 1);
                    }
                    current_bin_idx = -1;
                    current_vendor_idx = -1;
                    // `[vendor.<Name>]` -> push a fresh pin and track its index,
                    // so the dotted-section keys below land on the right pin.
                    if (current_section.starts_with("vendor.")) {
                        const vname: string = current_section.substr(
                            7, current_section.length() as i64 - 7);
                        config.vendor_pins.push(VendorPin::empty(vname));
                        current_vendor_idx = config.vendor_pins.length as i64 - 1;
                    }
                }
                continue;
            }

            // Parse key = value
            const eq_pos: i64 = trimmed.find_char(61 as i8);  // 61 = '='
            if (eq_pos < 0) { continue; }

            const key_slice: string = trimmed.substr(0, eq_pos);
            const key: string   = key_slice.trim();
            const val_slice: string = trimmed.substr(eq_pos + 1, trimmed.length() as i64 - eq_pos - 1);
            const raw_val: string = val_slice.trim();
            const val: string   = raw_val.strip_quotes();

            // `[vendor.<Name>]` pins use a dynamic section name, so they can't
            // be a `match` arm; dispatch them here before the fixed-section
            // match.  Only `triple` is recognized today.
            if (current_vendor_idx >= 0) {
                match (key) {
                    "triple" => { config.vendor_pins[current_vendor_idx].triple = val; }
                    _ => { ProjectConfig::report_unknown_key(current_section, key); }
                }
                continue;
            }

            // Apply to config based on section + key
            match (current_section) {
                "project" => {
                    match (key) {
                        "project_name"  => { config.project_name = val; }
                        "output_dir"    => { config.output_dir = val; }
                        "target_type"   => { config.target_type = TargetType::from_string(val); }
                        "entry_point"   => { config.entry_point = val; }
                        "source_dir"    => { config.source_dir = val; }
                        "target_triple" => { config.target_triple = val; }
                        "stdlib_root"   => { config.stdlib_root = val; }
                        "source_paths"  => { config.source_paths = ProjectConfig::parse_string_array(raw_val); }
                        // Renamed in the v1.0 schema:
                        "target" => {
                            config.error_count += ProjectConfig::report_removed_key("project", "target",
                                "rename it to `target_triple` (it set the cross-compile triple)");
                        }
                        _ => { ProjectConfig::report_unknown_key("project", key); }
                    }
                }
                "low_level" => {
                    match (key) {
                        "native_alloc" => { config.native_alloc = ProjectConfig::parse_bool(val); }
                        _ => { ProjectConfig::report_unknown_key("low_level", key); }
                    }
                }
                "compiler" => {
                    match (key) {
                        "debug"     => { config.debug     = ProjectConfig::parse_bool(val); }
                        "optimize"  => {
                            config.opt_level = ProjectConfig::parse_opt_level(val);
                            config.opt_level_explicit = true;
                        }
                        "no_std"    => { config.no_std    = ProjectConfig::parse_bool(val); }
                        "emit_llvm" => { config.emit_llvm = ProjectConfig::parse_bool(val); }
                        "codegen_threads" => {
                            config.codegen_threads = ProjectConfig::parse_codegen_threads(val);
                        }
                        // Removed in the v1.0 schema:
                        "args" => {
                            config.error_count += ProjectConfig::report_removed_key("compiler", "args",
                                "set `emit_llvm = true` for the only flag this ever honored");
                        }
                        "link_libs" => {
                            config.error_count += ProjectConfig::report_removed_key("compiler", "link_libs",
                                "use [link] system = [...] (or [link] static for local archives)");
                        }
                        "link_paths" => {
                            config.error_count += ProjectConfig::report_removed_key("compiler", "link_paths",
                                "use [link] search = [...]");
                        }
                        "include_paths" => {
                            config.error_count += ProjectConfig::report_removed_key("compiler", "include_paths",
                                "use [project] source_paths = [...]");
                        }
                        _ => { ProjectConfig::report_unknown_key("compiler", key); }
                    }
                }
                "experimental" => {
                    match (key) {
                        "cxx_ffi" => { config.cxx_ffi = ProjectConfig::parse_bool(val); }
                        _ => { ProjectConfig::report_unknown_key("experimental", key); }
                    }
                }
                "link" => {
                    match (key) {
                        "system" => { config.link_system = ProjectConfig::parse_string_array(raw_val); }
                        "search" => { config.link_search = ProjectConfig::parse_string_array(raw_val); }
                        "static" => { config.link_static = ProjectConfig::parse_string_array(raw_val); }
                        _ => { ProjectConfig::report_unknown_key("link", key); }
                    }
                }
                // Per-OS overlays.  `[link.unix]` / `[link.windows]` carry the
                // same three keys as `[link]`; they're stored separately and
                // appended to the common set in `run_linking` only when the
                // effective target triple's OS matches.
                "link.unix" => {
                    match (key) {
                        "system" => { config.link_system_unix = ProjectConfig::parse_string_array(raw_val); }
                        "search" => { config.link_search_unix = ProjectConfig::parse_string_array(raw_val); }
                        "static" => { config.link_static_unix = ProjectConfig::parse_string_array(raw_val); }
                        _ => { ProjectConfig::report_unknown_key("link.unix", key); }
                    }
                }
                "link.windows" => {
                    match (key) {
                        "system" => { config.link_system_windows = ProjectConfig::parse_string_array(raw_val); }
                        "search" => { config.link_search_windows = ProjectConfig::parse_string_array(raw_val); }
                        "static" => { config.link_static_windows = ProjectConfig::parse_string_array(raw_val); }
                        _ => { ProjectConfig::report_unknown_key("link.windows", key); }
                    }
                }
                "lib" => {
                    match (key) {
                        "name"       => { config.lib.name = val; }
                        "source_dir" => { config.lib.source_dir = val; }
                        _ => { ProjectConfig::report_unknown_key("lib", key); }
                    }
                }
                "bin" => {
                    if (current_bin_idx >= 0) {
                        match (key) {
                            "name"        => { config.bins[current_bin_idx].name = val; }
                            "entry_point" => { config.bins[current_bin_idx].entry_point = val; }
                            _ => { ProjectConfig::report_unknown_key("bin", key); }
                        }
                    }
                }
                "dependencies" => {
                    // KEY = { path = "...", alias = "..." }   (path dep)
                    // KEY = { git = "...", version = "..." }  (git dep)
                    config.dependencies.push(Dependency::empty());
                    const idx: i64 = config.dependencies.length as i64 - 1;
                    config.dependencies[idx].name = key;
                    config.error_count = config.error_count
                        + ProjectConfig::parse_inline_table_into_dep(raw_val, &config.dependencies[idx]);
                }
                "profile" => {
                    // `[profile] default = "debug"|"release"` selects the
                    // default build profile when the CLI doesn't pass one.
                    // Per-profile knob tables (`[profile.debug]` etc.) are not
                    // parsed yet; the built-in mapping (release => O2/no-debug,
                    // debug => O0/+debug) is applied in the compiler instance.
                    match (key) {
                        "default" => { config.profile = val; }
                        _ => { ProjectConfig::report_unknown_key("profile", key); }
                    }
                }
                "test" => {
                    // Test-runner defaults. The values aren't validated
                    // here; the runner-side parser (`apply_format` /
                    // `apply_color` in stdlib/test/runner.cryo) warns on
                    // unknown values and the build still proceeds.
                    match (key) {
                        "format" => { config.test_format = val; }
                        "color"  => { config.test_color  = val; }
                        _ => { ProjectConfig::report_unknown_key("test", key); }
                    }
                }
                _ => { }
            }
        }

        return config;
    }

    /// Build the absolute path to the entry point file.
    entry_point_path(&this) -> string {
        if (this.project_root == "" || this.project_root.eq(".")) {
            return this.entry_point;
        }
        return format("%s/%s", this.project_root, this.entry_point);
    }

    // Build-directory layout
    //
    // Final artifacts are HOISTED to the ROOT of `output_dir` so they can be
    // run as `build/<name>` regardless of which profile produced them:
    //   <output_dir>/<name>          executable        (cryo run / [[bin]])
    //   <output_dir>/<name>-test     test binary       (cryo test)
    //   <output_dir>/lib<name>.a     library archive   ([lib] target)
    // Everything internal lives under a VISIBLE, per-profile cache subtree at
    // `<output_dir>/target/<profile>/`, grouped per ORIGIN (stdlib / the local
    // project / each third-party dependency) so packages stay isolated:
    //   <output_dir>/target/<profile>/<name>             pre-hoist artifact
    //   <output_dir>/target/<profile>/build-manifest.json
    //   <output_dir>/target/<profile>/std/deps/*.o    std/ir/*.ll
    //   <output_dir>/target/<profile>/local/deps/*.o  local/ir/*.ll
    //   <output_dir>/target/<profile>/local/incremental/<name>.fp
    //   <output_dir>/target/<profile>/<depname>/deps/*.o  <depname>/ir/*.ll
    //   <output_dir>/target/<profile>/vendor/<Name>/<Name>.cryo   (bindgen)
    //   <output_dir>/target/<profile>/vendor/<Name>/deps/*.o  <Name>/ir/*.ll

    /// Visible per-profile cache root:
    /// `<output_dir>/target/<profile>/<target_subdir>`.
    ///
    /// `target_subdir` is the cross-compile triple (e.g.
    /// "x86_64-pc-windows-gnu") when one is in effect, or the literal
    /// "host" when building for the host.  The per-target subdir keeps
    /// host and cross intermediates from colliding: switching between
    /// `cryo build` (host) and `cryo build --target=...` (cross) used
    /// to overwrite each other's `.o` / `.ll` / incremental fingerprint
    /// files; now they live in disjoint trees and either can be
    /// rebuilt without disturbing the other.
    ///
    /// Hoisted artifacts (`bin_artifact_path` / `lib_archive_path`)
    /// remain at the build root - the `.exe` suffix already
    /// distinguishes them for Windows targets, and ordinary users only
    /// build one target at a time.
    profile_dir(&this) -> string {
        return format("%s/target/%s/%s",
            this.output_dir, this.profile, this.target_subdir());
    }

    /// Returns the active cross-compile triple if set, otherwise the native
    /// build bucket for the platform this compiler runs on.  Threaded into
    /// `profile_dir` so every per-build path (deps, IR, incremental,
    /// per-profile bin) carries the per-target separation.
    ///
    /// The native bucket is OS-specific (`native_target_subdir`) so a
    /// cross-built-and-run binary - e.g. a Windows `cryo.exe` invoked under
    /// wine, which builds for its own host with no explicit `--target` - does
    /// NOT collide with the Linux host build's `target/release/host/` tree.
    /// Without this, the Windows-native COFF intermediates would overwrite
    /// the Linux-native ELF ones (and vice-versa), forcing callers to pass
    /// `--build-dir` to keep them apart.
    target_subdir(&this) -> string {
        if (this.target_triple == null
                || this.target_triple.length() == 0) {
            return native_target_subdir();
        }
        return this.target_triple;
    }

    /// Per-origin object output dir: `<profile_dir>/<origin_subdir>/deps`.
    /// `origin_subdir` is `"std"`, `"local"`, or a dependency name.
    deps_dir_for(&this, origin_subdir: string) -> string {
        return format("%s/%s/deps", this.profile_dir(), origin_subdir);
    }

    /// Per-origin LLVM IR (`.ll`) output dir: `<profile_dir>/<origin_subdir>/ir`.
    ir_dir_for(&this, origin_subdir: string) -> string {
        return format("%s/%s/ir", this.profile_dir(), origin_subdir);
    }

    /// Umbrella directory for vendored-library build artifacts:
    /// `<profile_dir>/vendor`.  Each library lands in its own `<Name>/`
    /// subtree beneath it - the generated `<Name>.cryo` the build compiles,
    /// plus `deps/*.o` and `ir/*.ll` - routed via origin_subdir
    /// `"vendor/<Name>"`.  The global vendor cache
    /// (`<cache_root>/vendor/...`) remains the regeneration cache; the build
    /// folder holds the resolved copy actually compiled into this build, so
    /// what's visible here is exactly what was built.
    vendor_dir(&this) -> string {
        return format("%s/vendor", this.profile_dir());
    }

    /// Incremental-build state dir (whole-build, owned by the local project):
    /// `<profile_dir>/local/incremental`.
    incremental_dir(&this) -> string {
        return format("%s/local/incremental", this.profile_dir());
    }

    /// Per-profile executable, the link target BEFORE hoisting:
    /// `<profile_dir>/<name>[-test]`.
    profile_bin_path(&this, test_suffix: boolean) -> string {
        if (test_suffix) {
            return format("%s/%s-test", this.profile_dir(), this.project_name);
        }
        return format("%s/%s", this.profile_dir(), this.project_name);
    }

    /// Per-profile library archive, the bundle target BEFORE hoisting:
    /// `<profile_dir>/lib<name>.a`.
    profile_lib_path(&this, archive_name: string) -> string {
        return format("%s/%s", this.profile_dir(), archive_name);
    }

    /// Hoisted final executable at the build root.  `test_suffix` appends
    /// `-test` so a `cryo test` binary coexists with a `cryo run` build.
    /// This is the stable, profile-agnostic path `cryo run` execs.
    bin_artifact_path(&this, test_suffix: boolean) -> string {
        if (test_suffix) {
            return format("%s/%s-test", this.output_dir, this.project_name);
        }
        return format("%s/%s", this.output_dir, this.project_name);
    }

    /// Hoisted final library-archive at the build root: `<output_dir>/lib<name>.a`.
    lib_archive_path(&this, archive_name: string) -> string {
        return format("%s/%s", this.output_dir, archive_name);
    }

    /// JSON build manifest path (per-profile): `<profile_dir>/build-manifest.json`.
    manifest_path(&this) -> string {
        return format("%s/build-manifest.json", this.profile_dir());
    }

    /// Incremental fingerprint sidecar, keyed by target name so a
    /// multi-target project's `[lib]` and each `[[bin]]` track their inputs
    /// independently: `<profile_dir>/local/incremental/<project_name>.fp`.
    fingerprint_path(&this) -> string {
        return format("%s/%s.fp", this.incremental_dir(), this.project_name);
    }

    /// Per-module cache-key sidecar (one `namespace<TAB>keyhex` line per
    /// module), keyed by target name alongside the whole-build fingerprint:
    /// `<profile_dir>/local/incremental/<project_name>.modkeys`. Read by the
    /// next build to decide which modules' objects can be reused.
    module_keys_path(&this) -> string {
        return format("%s/%s.modkeys", this.incremental_dir(), this.project_name);
    }

    /// Recursively create `path` and any missing parent directories, like
    /// `mkdir -p`.  The `mkdir` intrinsic only creates the final component,
    /// so a nested `<build>/target/<profile>/local/deps` tree (or a custom
    /// `--build-dir=a/b/c`) needs each level made in turn.  `mkdir` returning
    /// EEXIST for an existing prefix is harmless and ignored.  Static so the
    /// codegen / manifest passes can reach it without a free-function symbol
    /// that could collide with another module's leaf-name.
    static mkdir_p(path: string) -> void {
        const len: u64 = path.length();
        if (len == 0) { return; }
        const src: i8* = path as i8*;
        mut s: String = String::with_capacity(len + 1);
        for (mut i: u64 = 0; i < len; i++) {
            // At each interior '/', the prefix built so far (src[0..i]) is the
            // parent directory to create before descending into it.
            if (i > 0 && src[i] == '/') {
                mkdir(s.as_cstr() as string, 493);  // 0755
            }
            s.push_byte(src[i] as u8);
        }
        mkdir(s.as_cstr() as string, 493);  // 0755
        s.drop();
    }

    /// Built-in optimization level for a profile name. `debug` => O0 (keeps
    /// allocas / no inlining for clean source mapping); everything else
    /// (`release`, unknown) => O2. An explicit `[compiler] optimize` or
    /// `--opt-level=N` still overrides this in the compiler instance.
    static profile_base_opt_level(name: string) -> u32 {
        if (name.eq("debug")) { return 0; }
        return 2;
    }

    /// Built-in debug-info default for a profile name. `debug` emits DWARF;
    /// `release` does not. `-g` / `--debug-info` can still force it on.
    static profile_base_debug_info(name: string) -> boolean {
        return name.eq("debug");
    }

    /// Search for a cryoconfig file starting from `start_dir` and walking upward.
    /// Returns the path to the cryoconfig file, or "" if not found.
    static find_cryoconfig(start_dir: string) -> string {
        // Try start_dir itself
        const candidate: string = format("%s/cryoconfig", start_dir);
        if (metadata::exists(Path::from(candidate))) {
            return candidate;
        }

        // Walk upward by stripping the last path component
        const parent: string = start_dir.parent_dir();
        if (parent.length() == 0 || parent.eq(start_dir)) {
            return "";  // reached root, not found
        }
        return ProjectConfig::find_cryoconfig(parent);
    }

    /// Parse a boolean value from a string.
    static parse_bool(s: string) -> boolean {
        return match (s) {
            "false" | "no"  | "0" => { false }
            "true"  | "yes" | "1" => { true  }
            _                     => { false }  // default to false on unrecognized values
        };
    }

    /// Parse a `[compiler] optimize` value into an LLVM optimization level
    /// 0..3. Accepts C-style `O0`/`O1`/`O2`/`O3` (case-insensitive), a bare
    /// `0`..`3`, and the legacy booleans (`true`/`yes` => O2, `false`/`no` =>
    /// O0). Anything unrecognized falls back to O2 (the default level).
    static parse_opt_level(s: string) -> u32 {
        return match (s) {
            "true"  | "yes"   => { 2 }
            "false" | "no"    => { 0 }
            "O0" | "o0" | "0" => { 0 }
            "O1" | "o1" | "1" => { 1 }
            "O2" | "o2" | "2" => { 2 }
            "O3" | "o3" | "3" => { 3 }
            _                 => { 2 }
        };
    }

    /// Parse a `[compiler] codegen_threads` value into a worker count.
    /// `"auto"` / empty => `-1` (use the online CPU count); `"off"` / `"serial"`
    /// / `"false"` / `"no"` / `0` / `1` => `1` (serial codegen); a bare positive
    /// integer => that many workers.  Unrecognized text => `-1` (auto).
    static parse_codegen_threads(s: string) -> i64 {
        if (s.length() == 0 || s == "auto") { return -1; }
        if (s == "off" || s == "serial" || s == "false" || s == "no") { return 1; }
        const len: i64 = s.length() as i64;
        mut acc: i64 = 0;
        mut got: boolean = false;
        for (mut k: i64 = 0; k < len; k++) {
            const ch: i64 = s[k] as i64;
            if (ch >= 48 && ch <= 57) { acc = acc * 10 + (ch - 48); got = true; }
            else { break; }
        }
        if (!got) { return -1; }
        if (acc < 1) { return 1; }   // 0 => serial
        return acc;
    }

    /// Parse a TOML-like string array value: `["a", "b", "c"]` -> ["a","b","c"].
    /// Lenient: ignores whitespace and missing brackets, handles single- and
    /// double-quoted entries, returns an empty array when nothing parses.
    static parse_string_array(raw: string) -> string[] {
        mut result: string[] = [];
        const len: i64 = raw.length() as i64;
        mut i: i64 = 0;
        while (i < len) {
            const c: char = raw[i];
            // Skip opening bracket, commas, whitespace.
            if (c == '[' || c == ',' || c == ' ' || c == '\t') {
                i += 1;
                continue;
            }
            // Stop at closing bracket.
            if (c == ']') { break; }
            // A quoted string.
            if (c == '"' || c == '\'') {
                const quote: char = c;
                i += 1;
                const start: i64 = i;
                while (i < len && raw[i] != quote) { i += 1; }
                if (i > start) {
                    result.push(raw.substr(start, i - start));
                }
                if (i < len) { i += 1; }  // skip closing quote
                continue;
            }
            // Unquoted token: scan to next delimiter.
            const t_start: i64 = i;
            while (i < len && raw[i] != ',' && raw[i] != ']') { i += 1; }
            mut end: i64 = i;
            // Trim trailing whitespace.
            while (end > t_start && (raw[end - 1] == ' ' || raw[end - 1] == '\t')) {
                end -= 1;
            }
            if (end > t_start) {
                result.push(raw.substr(t_start, end - t_start));
            }
        }
        return result;
    }

    /// Report a key that was renamed or removed in the cryoconfig v1.0 schema.
    /// Prints a hard error naming the replacement and returns 1 so the caller
    /// can fold it into `ProjectConfig.error_count` (which aborts the build).
    static report_removed_key(section: string, key: string, hint: string) -> i64 {
        fmt::eprintln(f"error: [{section}] {key} is no longer supported");
        fmt::eprintln(f"  {hint}");
        return 1;
    }

    /// Warn about a key the parser doesn't recognize.  Non-fatal: catches typos
    /// and dead config (e.g. the removed `stdlib_mode` / `stdlib` keys) instead of
    /// silently ignoring them.  The build still proceeds.
    static report_unknown_key(section: string, key: string) -> void {
        fmt::eprintln(f"warning: [{section}] ignores unknown key '{key}'");
    }

    /// Parse a `[dependencies]` inline-table value into the supplied
    /// Dependency and validate the schema.  Returns the number of errors
    /// detected; the caller forwards that into `ProjectConfig.error_count`.
    ///
    /// Accepted shapes:
    ///
    ///   { path = "<rel>" [, alias = "<NS>"] }
    ///   { git  = "<url>", (version | tag | branch | rev) = "<v>"
    ///                     [, subdir = "<sub>"] [, alias = "<NS>"] }
    ///
    /// Unknown keys are a hard error, as is mixing `path` with any
    /// git-only key, supplying multiple ref selectors, or omitting the
    /// ref selector for a git dep.  All diagnostics go to `g_stderr`.
    ///
    /// Whitespace and missing `{}` braces are tolerated.
    static parse_inline_table_into_dep(raw: string, dep: Dependency*) -> i64 {
        mut errors: i64 = 0;

        // Track which keys were supplied so we can validate combinations
        // after we've walked the whole inline table.
        mut saw_path:    boolean = false;
        mut saw_git:     boolean = false;
        mut saw_version: boolean = false;
        mut saw_tag:     boolean = false;
        mut saw_branch:  boolean = false;
        mut saw_rev:     boolean = false;
        mut saw_subdir:  boolean = false;

        const len: i64 = raw.length() as i64;
        mut i: i64 = 0;
        // Skip opening brace + whitespace.
        while (i < len && (raw[i] == '{' || raw[i] == ' ' || raw[i] == '\t')) {
            i += 1;
        }
        while (i < len) {
            // Skip leading whitespace, commas, and the closing brace.
            if (raw[i] == ',' || raw[i] == ' ' || raw[i] == '\t') {
                i += 1;
                continue;
            }
            if (raw[i] == '}') { break; }

            // Extract a key: runs until '=' or whitespace.
            const k_start: i64 = i;
            while (i < len && raw[i] != '=' && raw[i] != ' ' && raw[i] != '\t') {
                i += 1;
            }
            const key: string = raw.substr(k_start, i - k_start);

            // Skip to '='.
            while (i < len && raw[i] != '=') { i += 1; }
            if (i >= len) { break; }
            i += 1;  // past '='

            // Skip whitespace before value.
            while (i < len && (raw[i] == ' ' || raw[i] == '\t')) { i += 1; }
            if (i >= len) { break; }

            // Value: quoted string or unquoted token until ',' or '}'.
            mut value: string = "";
            if (raw[i] == '"' || raw[i] == '\'') {
                const quote: char = raw[i];
                i += 1;
                const v_start: i64 = i;
                while (i < len && raw[i] != quote) { i += 1; }
                value = raw.substr(v_start, i - v_start);
                if (i < len) { i += 1; }  // past closing quote
            } else {
                const v_start: i64 = i;
                while (i < len && raw[i] != ',' && raw[i] != '}') { i += 1; }
                mut end: i64 = i;
                while (end > v_start && (raw[end - 1] == ' ' || raw[end - 1] == '\t')) {
                    end -= 1;
                }
                value = raw.substr(v_start, end - v_start);
            }

            if (key.eq("path")) {
                dep.path = value;
                saw_path = true;
            } else if (key.eq("git")) {
                dep.git_url = value;
                saw_git = true;
            } else if (key.eq("version")) {
                dep.ref_kind = GitRefKind::Version;
                dep.ref_val  = value;
                saw_version  = true;
            } else if (key.eq("tag")) {
                dep.ref_kind = GitRefKind::Tag;
                dep.ref_val  = value;
                saw_tag      = true;
            } else if (key.eq("branch")) {
                dep.ref_kind = GitRefKind::Branch;
                dep.ref_val  = value;
                saw_branch   = true;
            } else if (key.eq("rev")) {
                dep.ref_kind = GitRefKind::Rev;
                dep.ref_val  = value;
                saw_rev      = true;
            } else if (key.eq("subdir")) {
                dep.subdir = value;
                saw_subdir = true;
            } else if (key.eq("alias")) {
                dep.alias = value;
            } else {
                fmt::eprintln(f"error: dependency '{dep.name}' uses unknown key '{key}'");
                fmt::eprintf("  recognized keys: path, git, version, tag, branch, rev, subdir, alias\n");
                errors += 1;
            }
        }

        // ---- Cross-key validation ----

        if (saw_path && saw_git) {
            fmt::eprintln(f"error: dependency '{dep.name}' specifies both `path` and `git`; pick one");
            errors += 1;
        }

        if (!saw_path && !saw_git) {
            fmt::eprintln(f"error: dependency '{dep.name}' must specify either `path = \"...\"` or `git = \"...\"`");
            errors += 1;
        }

        // Catch the most common authoring mistake: someone pasted a URL
        // into the `path` field instead of using `git`.
        if (saw_path && ProjectConfig::looks_like_url(dep.path)) {
            fmt::eprintln(f"error: dependency '{dep.name}' has a URL in `path`; use `git = \"...\"` for remote sources");
            fmt::eprintf("  e.g. `%s = { git = \"%s\", version = \"0.1.0\" }`\n",
                dep.name, dep.path);
            errors += 1;
        }

        mut ref_count: i64 = 0;
        if (saw_version) { ref_count += 1; }
        if (saw_tag)     { ref_count += 1; }
        if (saw_branch)  { ref_count += 1; }
        if (saw_rev)     { ref_count += 1; }

        if (saw_git) {
            dep.kind = DepKind::Git;
            if (ref_count == 0) {
                fmt::eprintln(f"error: git dependency '{dep.name}' must specify one of `version`, `tag`, `branch`, or `rev`");
                errors += 1;
            } else if (ref_count > 1) {
                fmt::eprintln(f"error: git dependency '{dep.name}' specifies more than one of `version`, `tag`, `branch`, `rev`; pick one");
                errors += 1;
            }
            if (dep.git_url.length() == 0) {
                fmt::eprintln(f"error: git dependency '{dep.name}' has empty `git` URL");
                errors += 1;
            }
        } else if (saw_path) {
            dep.kind = DepKind::Path;
            if (ref_count > 0 || saw_subdir) {
                fmt::eprintln(f"error: path dependency '{dep.name}' may not use `version`/`tag`/`branch`/`rev`/`subdir` (those are git-only)");
                errors += 1;
            }
        } else {
            dep.kind = DepKind::Invalid;
        }

        if (errors > 0) {
            dep.kind = DepKind::Invalid;
        }

        return errors;
    }

    /// Heuristic: does this look like a URL the user accidentally put in
    /// `path`?  Catches `https://`, `http://`, `git://`, `ssh://`, the
    /// `git@host:path` SCP-ish form, and bare `*.git` paths.
    static looks_like_url(s: string) -> boolean {
        if (s.starts_with("http://"))  { return true; }
        if (s.starts_with("https://")) { return true; }
        if (s.starts_with("git://"))   { return true; }
        if (s.starts_with("ssh://"))   { return true; }
        if (s.starts_with("git@"))     { return true; }
        return s.ends_with(".git");
    }
}
