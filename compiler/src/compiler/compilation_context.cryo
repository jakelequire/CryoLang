/// What artifact a single-file build should produce.  Inferred from the
/// extension of `-o PATH` by the CLI; read by `run_object_emission` to
/// pick between LLVM's emit-to-file modes and by the single-file Exe
/// flow to drive `cc` for final linking.
///
/// `None` is the default; it keeps the per-origin
/// `target/<profile>/<origin>/deps/<module>.o` layout when the user
/// didn't pass `-o`.
type enum OutputKind {
    None;
    Object;
    Asm;
    IRText;
    Exe;
}

implement enum OutputKind {

    is_override(&this) -> boolean {
        return match (this) {
            OutputKind::None => { false }
            _                => { true  }
        };
    }
}

/// A single-file `-o PATH`: the artifact kind comes with its path.
type enum OutputOverride {
    Default;
    Object(string);
    Asm(string);
    IRText(string);
    Exe(string);
}

implement enum OutputOverride {
    static from_cli(kind: OutputKind, path_text: Text) -> OutputOverride {
        const path: string = path_text.as_string();
        return match (kind) {
            OutputKind::None   => { OutputOverride::Default }
            OutputKind::Object => { OutputOverride::Object(path) }
            OutputKind::Asm    => { OutputOverride::Asm(path) }
            OutputKind::IRText => { OutputOverride::IRText(path) }
            OutputKind::Exe    => { OutputOverride::Exe(path) }
        };
    }

    /// The path `-o` named; empty for `Default`.
    path(&this) -> string {
        return match (this) {
            OutputOverride::Default   => { "" }
            OutputOverride::Object(p) => { p }
            OutputOverride::Asm(p)    => { p }
            OutputOverride::IRText(p) => { p }
            OutputOverride::Exe(p)    => { p }
        };
    }

    is_exe(&this) -> boolean {
        return match (this) {
            OutputOverride::Exe(_) => { true }
            _                      => { false }
        };
    }

    /// An object, assembly or IR file written straight by emission, with
    /// nothing to link.
    is_unlinked_artifact(&this) -> boolean {
        return match (this) {
            OutputOverride::Object(_) => { true }
            OutputOverride::Asm(_)    => { true }
            OutputOverride::IRText(_) => { true }
            _                         => { false }
        };
    }
}

/// How a panic leaves the function that raised it.
type enum PanicMode {
    Abort;
    Unwind;
}

/// Whether the program runs on the Cryo runtime or stands alone.
type enum Runtime {
    Hosted;
    Freestanding;
}

/// Where `GlobalAlloc` gets its memory.
type enum HeapBackend {
    Libc;
    Native;
}

/// Editor-buffer contents that replace one module's file on disk.
type struct SourceOverride {
    path:    string;
    content: string;
}

/// An injected specialization and the module its template is declared in.
type struct InjectedOrigin {
    node:   ASTNode*;
    module: ModulePath;
}

/// A node a desugaring wrote naming a language item (its slot holds
/// `ResSlot::Lang`) before the item was claimed.
type struct LangRef {
    node: ASTNode*;
    item: LangItem;
}

/// A reference a C import made to one of its own records: the import's
/// alias module, the C tag named, and the declaration the importer emitted
/// for that tag (null when it emitted none, or has not pinned it yet).
type struct CRecordRef {
    ann:   NamedAnnotation*;
    alias: ModulePath;
    tag:   SymbolStr;
    decl:  ASTNode*;
}

/// What the build was asked for: CLI flags merged over cryoconfig, complete
/// before the context is made and never written after.
type struct BuildOptions {
public:
    mode:          CompileMode;
    /// `--debug`: the compiler's own trace logging.
    verbose:       boolean;
    /// 0 (none) .. 3 (aggressive): the IR pipeline and the backend level.
    opt_level:     u32;
    /// `-g`: DWARF debug info.
    debug_info:    boolean;
    runtime:       Runtime;
    panic:         PanicMode;
    heap:          HeapBackend;
    no_std:        boolean;
    /// Where `lib.cryo` lives; empty when no stdlib was resolved.
    stdlib_root:   string;
    /// The triple code is generated for, resolved once: the host's when no
    /// target was asked for, never empty.
    target_triple: string;
    /// `--release-static`: link libLLVM and the C++ runtime statically.
    static_link:   boolean;
    /// `--emit=facts`.
    emit_facts:    boolean;
    output:        OutputOverride;
    /// The LSP's unsaved buffer for one module.
    source_override: Option<SourceOverride>;

    static defaults(mode: CompileMode) -> BuildOptions {
        return BuildOptions {
            mode:            mode,
            verbose:         false,
            opt_level:       2,
            debug_info:      false,
            runtime:         Runtime::Hosted,
            panic:           PanicMode::Abort,
            heap:            HeapBackend::Libc,
            no_std:          false,
            stdlib_root:     "",
            target_triple:   LTargetMachine::get_default_triple(),
            static_link:     false,
            emit_facts:      false,
            output:          OutputOverride::Default,
            source_override: Option::None,
        };
    }

    unwinds(&this) -> boolean {
        return match (this.panic) {
            PanicMode::Unwind => { true }
            PanicMode::Abort  => { false }
        };
    }

    freestanding(&this) -> boolean {
        return match (this.runtime) {
            Runtime::Freestanding => { true }
            Runtime::Hosted       => { false }
        };
    }

    native_heap(&this) -> boolean {
        return match (this.heap) {
            HeapBackend::Native => { true }
            HeapBackend::Libc   => { false }
        };
    }
}

/// What one file can see under a module spelling.
///
/// `visible` and `matched` are kept apart because they answer different
/// questions: nothing carries this spelling at all, versus something does and
/// the writer cannot reach it.  Collapsing them would report the second as the
/// first, which is the difference between "no such name" and "add an import".
type struct ModuleSpellingMatch {
    /// The single visible module, when `visible == 1`.
    found:   ModulePath;
    /// That module as a definition, when `visible == 1`.
    found_def: DefId;
    /// A second visible module, for naming the ambiguity.
    other:   ModulePath;
    /// Any module carrying the spelling, reachable or not.
    any:     ModulePath;
    /// How many carry it AND are reachable from the writing file.
    visible: i64;
    /// How many carry it at all.
    matched: i64;
}

type struct CompilationContext {
public:
    options:           BuildOptions;
    /// The file of the module the pipeline stands in; moved by
    /// `switch_to_module`.
    source_file:       string;
    /// The module the unit being compiled declares: set when the
    /// orchestrator switches to a module, and, while sema walks a
    /// specialization placed from another module, that template's module.
    /// None for a unit declaring no namespace.
    unit_module:       ModulePath;

    artifacts: PhaseArtifacts*;

    diagnostics:   DiagnosticSink*;
    diag_renderer: DiagRenderer*;

    provisions: ProvisionSet;

    module_graph: ModuleGraph*;

    intern_table: InternTable*;

    /// The one place a `DefId` is made and its path composed.
    defs: DefTable*;

    decl_index: DeclarationIndex*;

    /// Folded module-level integer constants, shared across modules: a fixed
    /// array size may name a constant declared in an imported module.
    const_table: ConstantTable*;

    /// Injected specializations, with the module each one's template is
    /// declared in; sema stands in that module to walk them.
    injected_origins: InjectedOrigin[];

    /// Language-item references a desugaring wrote before the item was
    /// claimed (`PassRegistry::settle_lang_refs` answers them).
    lang_refs: LangRef[];

    /// References a C import made to its own records before the name layer
    /// declared anything (`NameDeclarationPass::settle_c_refs` answers them).
    c_refs: CRecordRef[];

    // -- Inactive-region tracking (LSP tooling) --
    // Source spans of top-level declarations, methods, and inline `![dir] { }`
    // blocks that ConfigGating stripped as inactive for the target OS.  Those
    // decls are removed from the AST, so this is the only surviving record of
    // where they were; the LSP reads it to publish dimmed ("compiled out")
    // ranges to the editor.  Populated only by the ConfigGating pass.  Fresh
    // per compilation (the LSP builds a new CompilationContext on every
    // recompile), so it needs no explicit reset.
    inactive_spans: SourceSpan[];

    // -- Type system (initialized lazily by TypeDeclaration pass) --
    type_arena: TypeArena*;

    /// The driver's view of cryoconfig; passes read `options`.  Null for a
    /// compile with no project.
    project_config:      ProjectConfig*;
    active_module_index: i64;
    /// Where the active module stands in the build order: every module it
    /// depends on stands before it.  -1 when the order does not hold it.
    active_order_position: i64;
    /// One line per argument a call passes to a spelling-typed parameter,
    /// recorded while `options.emit_facts` is on.
    facts:               string[];

    // Owned components (initialized lazily by passes that need them).
    // Public because passes across the compiler reach into the context
    // directly to drive these sub-systems.  Encapsulating behind getters
    // is a possible follow-up; for now public matches actual usage.
    resolver:             Resolver*;
    type_resolver:        TypeResolver*;
    generic_registry:     GenericRegistry*;
    monomorphizer:        Monomorphizer*;
    directive_registry:   DirectiveRegistry*;

    static new(options: BuildOptions, source_file: string,
               project_config: ProjectConfig*) -> CompilationContext {
        // Boxed for a stable address: the components point at each other.
        const _box_renderer: Box<DiagRenderer> = Box::<DiagRenderer>::new(DiagRenderer::new(RenderConfig::default()));
        const renderer: DiagRenderer* = _box_renderer.leak();

        const _box_artifacts: Box<PhaseArtifacts> = Box::<PhaseArtifacts>::new(PhaseArtifacts::new());
        const _box_diag: Box<DiagnosticSink>      = Box::<DiagnosticSink>::new(DiagnosticSink::new());
        const _box_intern: Box<InternTable>       = Box::<InternTable>::new(InternTable::new());
        const intern_ptr: InternTable* = _box_intern.leak();
        const _box_defs: Box<DefTable>            = Box::<DefTable>::new(DefTable::new(intern_ptr));
        const defs_ptr: DefTable* = _box_defs.leak();
        const _box_module_graph: Box<ModuleGraph> = Box::<ModuleGraph>::new(ModuleGraph::new(defs_ptr));
        const graph_ptr: ModuleGraph* = _box_module_graph.leak();
        const _box_decl: Box<DeclarationIndex>    = Box::<DeclarationIndex>::new(DeclarationIndex::new(defs_ptr));
        const decl_ptr: DeclarationIndex* = _box_decl.leak();
        const _box_consts: Box<ConstantTable>     = Box::<ConstantTable>::new(ConstantTable::new(defs_ptr));
        const consts_ptr: ConstantTable* = _box_consts.leak();

        const diag_ptr: DiagnosticSink* = _box_diag.leak();

        const _box_res: Box<Resolver> = Box::<Resolver>::new(Resolver::new(intern_ptr, defs_ptr, graph_ptr));
        const resolver_ptr: Resolver* = _box_res.leak();
        const _box_arena: Box<TypeArena> = Box::<TypeArena>::new(TypeArena::new(intern_ptr, defs_ptr));
        const arena_ptr: TypeArena* = _box_arena.leak();
        const _box_greg: Box<GenericRegistry> = Box::<GenericRegistry>::new(GenericRegistry::new(arena_ptr));
        const greg_ptr: GenericRegistry* = _box_greg.leak();
        const _box_tr: Box<TypeResolver> = Box::<TypeResolver>::new(TypeResolver::new(
            arena_ptr, intern_ptr, greg_ptr, resolver_ptr, decl_ptr, consts_ptr, graph_ptr));
        const type_resolver_ptr: TypeResolver* = _box_tr.leak();
        type_resolver_ptr.set_diagnostics(diag_ptr);

        mut ctx: CompilationContext = CompilationContext {
            options:           options,
            source_file:       source_file,
            unit_module:       ModulePath::none(),

            artifacts:     _box_artifacts.leak(),
            diagnostics:   diag_ptr,
            diag_renderer: renderer,
            provisions:    ProvisionSet::empty(),
            module_graph:  graph_ptr,
            intern_table:  intern_ptr,
            defs:          defs_ptr,
            decl_index:    decl_ptr,
            const_table:   consts_ptr,
            injected_origins:     [],
            lang_refs:            [],
            c_refs:               [],
            inactive_spans:       [],
            type_arena:    arena_ptr,

            project_config:      project_config,
            active_module_index: -1,
            active_order_position: -1,
            facts:               [],

            resolver:             resolver_ptr,
            type_resolver:        type_resolver_ptr,
            generic_registry:     greg_ptr,
            monomorphizer:        null,
            directive_registry:   null,
        };

        diag_ptr.set_renderer(renderer);
        diag_ptr.set_config(DiagConfig::default());
        return ctx;
    }

    // String interning convenience

    /// Intern a string, returning a SymbolStr handle.
    /// Shorthand for this.intern_table.intern(text).
    intern(mut &this, text: string) -> SymbolStr {
        return this.intern_table.intern(text);
    }

    /// Resolve a SymbolStr back to its string data.
    /// Shorthand for this.intern_table.resolve(sym).
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    resolve_str(&this, sym: SymbolStr) -> string {
        return this.intern_table.resolve(sym);
    }

    /// Get a pointer to the intern table.
    get_intern_table(mut &this) -> InternTable* {
        return this.intern_table;
    }

    get_resolver(mut &this) -> Resolver* {
        return this.resolver;
    }

    get_generic_registry(&this) -> GenericRegistry* {
        return this.generic_registry;
    }

    note_lang_ref(mut &this, node: ASTNode*, item: LangItem) -> void {
        this.lang_refs.push(LangRef { node: node, item: item });
    }

    /// Record that an injected AST node came from a specific template module.
    register_injected_origin(mut &this, node: ASTNode*, template_module: ModulePath) -> void {
        this.injected_origins.push(InjectedOrigin { node: node, module: template_module });
    }

    /// Look up the template module for an injected AST node.
    /// Returns no module if the node wasn't injected.
    lookup_injected_origin(&this, node: ASTNode*) -> ModulePath {
        for (mut i: i64 = 0; i < this.injected_origins.length; i++) {
            if (this.injected_origins[i].node == node) {
                return this.injected_origins[i].module;
            }
        }
        return ModulePath::none();
    }


    // Namespace helpers

    /// Whether the unit being compiled declares a module.
    has_namespace(&this) -> boolean {
        return this.unit_module.is_valid();
    }

    /// The unit's module path as text, for display and for keys spelled
    /// with it.
    namespace_display(&this) -> string {
        return this.intern_table.resolve(this.unit_module.as_sym());
    }

    /// Which modules a spelling names, as one file can see them.
    ///
    /// Asked of a whole scope segment to decide what that segment names, of a
    /// segment's PREFIX to walk a module-rooted path, and by the type layer to
    /// say WHY a qualified annotation resolved to nothing; one implementation
    /// because all of those are the same question about the same relation,
    /// and two copies of a reachability rule are two rules as soon as either
    /// is edited.
    ///
    /// With a `root`, the spelling continues a path that already named that
    /// module - `J::Inner` once `J` named `Json` - and names a module whose
    /// path is the root's followed by the spelling.  What the path reached
    /// the root through makes it reachable, so such a module is visible.
    modules_written_as(&this, spelling: string,
                       use_module: ModulePath, root: ModulePath) -> ModuleSpellingMatch {
        mut r: ModuleSpellingMatch = ModuleSpellingMatch {
            found:   ModulePath::none(),
            found_def: DefId::invalid(),
            other:   ModulePath::none(),
            any:     ModulePath::none(),
            visible: 0,
            matched: 0,
        };
        if (this.module_graph == null || this.decl_index == null) { return r; }
        const rooted: boolean = root.is_valid();
        const rooted_length: u64 =
            if (rooted) { this.intern_table.resolve(root.as_sym()).length() + 2 + spelling.length() } else { 0 };
        // A spelling of more than one segment may continue a path from a
        // module this file imports: `Toml::Sub` with `import A::Toml;` names
        // `A::Toml::Sub`, whose head is the import's binding.  Such a module
        // is reachable through the import, as the same path through an alias
        // is.  The imported modules the head can name are gathered in the
        // same walk, and the candidates are judged once it has seen them all.
        const head: string = QualifiedName::head_of(spelling);
        const continues: boolean = !rooted && head.length() < spelling.length();
        const tail_length: u64 = spelling.length() - head.length();
        mut heads: ModulePath[] = [];
        mut head_lengths: u64[] = [];
        mut cands: ModulePath[] = [];
        mut cand_defs: DefId[] = [];
        mut cand_lengths: u64[] = [];
        mut cand_reach: boolean[] = [];
        const count: i64 = this.module_graph.module_count() as i64;
        for (mut i: i64 = 0; i < count; i++) {
            const cand: ModuleInfo* = this.module_graph.get_module(i);
            const cand_ns: SymbolStr = cand.namespace_name;
            if (!cand_ns.is_valid()) { continue; }
            const cand_str: string = this.intern_table.resolve(cand_ns);
            const names_head: boolean = continues && Resolver::ns_written_as(cand_str, head);
            const names_spelling: boolean = Resolver::ns_written_as(cand_str, spelling)
                && !(rooted && (cand_str.length() != rooted_length
                                || !cand.path().is_within(root, this.intern_table)));
            if (!names_head && !names_spelling) { continue; }
            const imported: boolean = this.decl_index.ns_imports(use_module, cand.path());
            if (names_head && imported) {
                heads.push(cand.path());
                head_lengths.push(cand_str.length());
            }
            if (!names_spelling) { continue; }
            r.matched = r.matched + 1;
            if (r.matched == 1) { r.any = cand.path(); }
            // The same reachability relation same-leaf resolution uses: the
            // module's own namespace, anything it imports (the registered set
            // is already closed over re-exports), or the prelude.
            //
            // `cand_str.eq(spelling)` is the fully-qualified spelling: a package
            // root is addressable without an import, so a path that names a
            // module's WHOLE namespace needs nothing brought into scope.  Only
            // the whole one - an abbreviation like `core::option` is a proper
            // suffix, its first segment is an interior segment binding nothing,
            // and it stays unreachable here.
            const reachable: boolean = rooted
                || cand.path().equals(use_module)
                || cand_str.eq(spelling)
                || this.decl_index.is_prelude_ns(cand.path())
                || imported;
            cands.push(cand.path());
            cand_defs.push(cand.def);
            cand_lengths.push(cand_str.length());
            cand_reach.push(reachable);
        }
        for (mut c: i64 = 0; c < cands.length; c++) {
            mut reachable: boolean = cand_reach[c];
            for (mut h: i64 = 0; !reachable && h < heads.length; h++) {
                reachable = head_lengths[h] + tail_length == cand_lengths[c]
                    && cands[c].is_within(heads[h], this.intern_table);
            }
            if (!reachable) { continue; }
            r.visible = r.visible + 1;
            if (r.visible == 1) { r.found = cands[c]; r.found_def = cand_defs[c]; }
            if (r.visible == 2) { r.other = cands[c]; }
        }
        return r;
    }

    /// Stand in module `m` (sema, walking a specialization placed from
    /// another module).  Returns the module replaced, to restore.
    swap_unit_module(mut &this, m: ModulePath) -> ModulePath {
        const old: ModulePath = this.unit_module;
        this.unit_module = m;
        return old;
    }

    /// Prepend the AMBIENT namespace to a bare leaf, interned.  Use this when
    /// the result feeds the type system (arena, registries).  Returns the leaf
    /// unchanged when no namespace is set.
    ///
    /// An ALREADY-QUALIFIED name is returned unchanged, so this is idempotent.
    /// Prepending to one mints `<ns>::<a::b::C>`, and nothing in the program
    /// registers a doubled key, so that form can only miss - which makes
    /// declining to build it the answer rather than a special case.  Deciding
    /// it HERE, at the one place the qualifier is applied, is what stops each
    /// caller needing to know which form it holds.
    ///
    /// The separator test is `QualifiedName::segment_count`, the same
    /// predicate the declaration key is derived with, so the two cannot come
    /// to disagree about what "already qualified" means.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    qualify_symbol_sym(mut &this, sym: SymbolStr) -> SymbolStr {
        if (QualifiedName::segment_count(this.intern_table.resolve(sym)) > 1) {
            return sym;
        }
        if (!this.unit_module.is_valid()) {
            return sym;
        }
        const ns: string = this.intern_table.resolve(this.unit_module.as_sym());
        const bare: string = this.intern_table.resolve(sym);
        return this.intern_table.intern(ns + "::" + bare);
    }

    /// The qualifier the span's OWN module would mint - the module that WROTE
    /// the name, not the one the compiler is standing in.
    ///
    /// A bare leaf means what it means in the module whose source text
    /// contains it.  The ambient cursor answers that correctly only while a
    /// pass walks a module's own declarations in order; a trait default's body
    /// and a specialized clone are both re-typed with the cursor parked on
    /// another module, and a name qualified there names nothing.
    ///
    /// Falls back to the cursor when the file names no module in the graph
    /// (a synthesized node, single-file mode) rather than to "no namespace":
    /// an invalid namespace compares unequal to every real one, so treating
    /// missing provenance as a distinct module would read "I cannot tell where
    /// this was written" as "this was written somewhere else".
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    qualify_symbol_sym_home(mut &this, sym: SymbolStr,
                            span_file: string) -> SymbolStr {
        // An ALREADY-QUALIFIED name is returned unchanged, as `qualify_symbol_sym`
        // returns it: a synthesized declaration (a closure struct, a
        // specialization placed by name) carries the key it was registered
        // with, and prefixing a module to it mints a doubled key nothing holds.
        if (QualifiedName::segment_count(this.intern_table.resolve(sym)) > 1) {
            return sym;
        }
        const home: ModulePath = this.module_of_file(span_file);
        if (!home.is_valid()) { return this.qualify_symbol_sym(sym); }
        const ns: string   = this.intern_table.resolve(home.as_sym());
        const bare: string = this.intern_table.resolve(sym);
        return this.intern_table.intern(ns + "::" + bare);
    }

    /// The key a TYPE DECLARATION is registered under, from what the node
    /// carries: a C-imported one lives in its alias's module
    /// (`<mod>::cit::Vec2`, the canonical name); any other is its registered
    /// name when it was minted qualified (a closure struct, a placed
    /// specialization), else the module of the file that WROTE it prefixed
    /// to its leaf.  A reader standing in some other module - a pass
    /// walking a root that holds injected clones - gets the same key the
    /// registration used, which the ambient cursor cannot give it.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    decl_type_key(mut &this, name: SymbolStr, binding_namespace: ModulePath,
                  span_file: string) -> SymbolStr {
        if (binding_namespace.is_valid()) {
            return this.qualify_binding_sym(name, binding_namespace);
        }
        return this.qualify_symbol_sym_home(name, span_file);
    }

    /// The key a FUNCTION DECLARATION is registered under: its name under
    /// the module of the file that WROTE it.  A specialization's clone
    /// carries the template's span, so its key is the template module's
    /// whichever module the clone is placed in - which is what lets the
    /// definition and every caller's cross-module extern name one symbol
    /// without the clone carrying its module a second way.  The registration,
    /// the emitted definition's symbol and every reader that walks a root for
    /// a declaration derive the key here, so they cannot disagree.
    /// Register a declaration the compiler synthesizes - an async future, a
    /// closure's struct, the body an `async main` is renamed to - under
    /// module `m` (invalid parent for no module).  The synthesizer creates
    /// the declaration, so this is its one registration, and every
    /// reference it builds copies the id.  Its origin is recorded as
    /// generated, so its path cannot be one the program wrote.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    register_in_module(mut &this, m: ModulePath, leaf: SymbolStr, kind: DefKind,
                       span: SourceSpan) -> DefId {
        return this.defs.register_generated(this.module_def_of(m), leaf, kind, span);
    }

    /// Register the method `decl` as a definition whose parent is `owner` -
    /// the type it is declared on, or the trait declaring it - under `leaf`,
    /// the name it is declared as, and keep `decl` under the id
    /// (`DeclarationIndex::method_decl_of`).  Called by the registrar
    /// holding the declaration: the name layer for a written method, a
    /// lowering for a method it generates.  A copy of a method - a trait
    /// default placed in an implementation, a monomorphized clone - is not
    /// registered.
    ![allow(lookup_by_spelling, reason = "registers the leaf written at the declaration; looks nothing up")]
    define_method(mut &this, owner: DefId, leaf: SymbolStr, span: SourceSpan,
                  decl: ASTNode*) -> DefId {
        const d: DefId = this.defs.register(owner, leaf, DefKind::Method, span);
        this.decl_index.keep_method_decl(d, decl);
        return d;
    }

    /// The definition of module `m`; invalid for no module.
    module_def_of(&this, m: ModulePath) -> DefId {
        if (!m.is_valid() || this.module_graph == null) { return DefId::invalid(); }
        return this.module_graph.module_def(m);
    }

    /// The module the source file `file` declares; none for a file the
    /// graph did not load.
    module_of_file(&this, file: string) -> ModulePath {
        if (this.module_graph == null) { return ModulePath::none(); }
        return this.module_graph.module_of_file(file);
    }

    /// The module this unit's source file declares: what a declaration the
    /// unit registers - or a synthesizer mints while lowering it - is
    /// declared in.  None for a unit the graph did not load.
    current_module(&this) -> ModulePath {
        return this.module_of_file(this.source_file);
    }

    /// The module the definition `d` is declared in; none for a definition
    /// no module the graph holds encloses.
    declaring_module(&this, d: DefId) -> ModulePath {
        if (this.module_graph == null) { return ModulePath::none(); }
        return this.module_graph.declaring_module(d);
    }

    /// The module the definition `d` IS; none when `d` is not a module.
    module_of_def(&this, d: DefId) -> ModulePath {
        if (this.module_graph == null) { return ModulePath::none(); }
        return this.module_graph.module_of_def(d);
    }

    /// The global the definition `d` is, from its registration slot, or an
    /// entry that is not `valid` when `d` names none or is not a global.
    global_entry_of_def(&this, d: DefId) -> GlobalEntry {
        return this.decl_index.global_entry_of_def(d);
    }

    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    decl_fn_key(mut &this, name: SymbolStr, span_file: string) -> SymbolStr {
        return this.qualify_symbol_sym_home(name, span_file);
    }

    /// The overload family owner a function declaration `def` is registered
    /// under: the definition that encloses it, its module.  The family's
    /// leaf is the name the declaration is written with.
    fn_family_of(&this, def: DefId) -> FamilyOwner {
        return FamilyOwner::Def(this.defs.parent_of(def));
    }

    /// The module a copy of the definition `copy_of` mangles its symbol
    /// under: the module that declares what it copies.
    copy_module_family(&this, copy_of: DefId) -> FamilyOwner {
        return this.module_family(this.declaring_module(copy_of));
    }

    /// The template the member `leaf` of `container` is - a generic static
    /// method on a type, a generic function in a module - read off the
    /// member-function door's family for that owner: the one entry whose
    /// definition is a template.  Null when none is, or when several are,
    /// which only a call's arguments tell apart.  A primitive or a type
    /// parameter holds no template.
    ![allow(lookup_by_spelling, reason = "a member's leaf, asked of the owner a path's segment resolved to through the member-function door")]
    member_template(&this, container: ResBase, leaf: SymbolStr) -> TemplateEntry* {
        const owner: DefId = match (container) {
            ResBase::Def(d) => { d }
            _               => { DefId::invalid() }
        };
        if (!owner.is_valid() || !leaf.is_valid()) { return null; }
        const entries: OverloadId[] = this.decl_index.lookup_family_entries(FamilyOwner::Def(owner), leaf);
        mut found: TemplateEntry* = null;
        for (mut i: i64 = 0; i < entries.length; i++) {
            const decl: ASTNode* = this.decl_index.entry_decl(entries[i]);
            if (decl == null) { continue; }
            mut def: DefId = DefId::invalid();
            if (decl.kind == NodeKind::MethodDeclaration && (decl as MethodNode*).func != null) {
                def = (decl as MethodNode*).func.def;
            } else if (decl.kind == NodeKind::FunctionDeclaration) {
                def = (decl as FunctionDeclNode*).def;
            }
            const t: TemplateEntry* = this.generic_registry.template_of(def);
            if (t == null || t == found) { continue; }
            if (found != null) { return null; }
            found = t;
        }
        return found;
    }

    /// The family owner module `m` is: the module's definition, and the
    /// root for no module.
    module_family(&this, m: ModulePath) -> FamilyOwner {
        return FamilyOwner::Def(this.module_def_of(m));
    }

    /// The `(key, namespace)` a GLOBAL is registered under in the declaration
    /// index, from what the node carries: its bare leaf under its module's
    /// namespace - the alias module's for a C-imported one (`FLAG_A` under
    /// `<mod>::cit`, the namespace the alias's stamp names), the writing
    /// module's for any other.  Every attribute the index records per
    /// registration - the type, the thread-local flag, the linker symbol - is
    /// asked by this pair, so a directive applied after registration and a
    /// reader standing in another module reach the slot the registration
    /// wrote, and a same-leaf global of some other module cannot answer for
    /// it.
    ///
    /// Falls back to the cursor when the file names no module in the graph
    /// (single-file mode), as the type declaration key does and for the same
    /// reason: an invalid namespace compares unequal to every real one.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    decl_global_key(mut &this, name: SymbolStr, binding_namespace: ModulePath,
                    span_file: string, out_module: ModulePath*) -> SymbolStr {
        if (binding_namespace.is_valid()) {
            *out_module = binding_namespace;
            return name;
        }
        const home: ModulePath = this.module_of_file(span_file);
        *out_module = if (home.is_valid()) { home } else { this.unit_module };
        return name;
    }

    /// Qualify `sym` under an extern-module alias's canonical namespace.
    /// Used for the struct/enum/typedef declarations the C-header import
    /// engine synthesizes into an extern module's alias: a synthesized
    /// `LLVMModuleRef` whose `binding_namespace` is `<mod>::llvm` qualifies
    /// as `<mod>::llvm::LLVMModuleRef`, exactly as the block's functions
    /// register (`type_resolution.cryo` ExternBlock branch).  Every caller
    /// tests the namespace first; a declaration without one is keyed by
    /// `decl_type_key` / `decl_global_key`.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    qualify_binding_sym(mut &this, sym: SymbolStr, binding_namespace: ModulePath) -> SymbolStr {
        const ns: string = this.intern_table.resolve(binding_namespace.as_sym());
        const bare: string = this.intern_table.resolve(sym);
        return this.intern_table.intern(ns + "::" + bare);
    }

    /// Install the scope walk's outermost tier, the prelude modules.  Called
    /// by each name-resolving pass on entry, after discovery has derived the
    /// prelude set.  Re-stated on every call rather than once: the resolver
    /// outlives a single pass, and a tier that is only correct when
    /// installation happened to precede the first lookup is a tier nobody
    /// can reason about.
    install_prelude_modules(mut &this) -> void {
        this.resolver.set_prelude_modules(this.decl_index.prelude_namespaces());
    }


    /// Record a source span that ConfigGating stripped as inactive for the
    /// target OS (a decl / method / inline block gated to another platform).
    /// The LSP reads `inactive_spans` to dim compiled-out code.  Ignores
    /// location-less spans so a synthesized node never produces a phantom
    /// range.
    note_inactive(mut &this, span: SourceSpan) -> void {
        if (span.has_location()) {
            this.inactive_spans.push(span);
        }
    }


    // Diagnostic convenience

    /// Emit an error diagnostic.
    emit_error(mut &this, code: ErrorCode, message: Text) -> void {
        this.diagnostics.emit(Diagnostic::error(code, message));
    }


    /// Emit an error with source location.
    emit_error_at(mut &this, code: ErrorCode, message: Text, span: SourceSpan) -> void {
        mut diag: Diagnostic = Diagnostic::error(code, message);
        diag = diag.at(span);
        this.diagnostics.emit(diag);
    }

    /// Emit a fully-built diagnostic. Use this when the diagnostic was
    /// composed via the builder pattern (`.at()`, `.with_note_at()`,
    /// `.help()`, `.suggest()`, `.also_at()`). The renderer uses spans,
    /// labels, children, and suggestions to produce a multi-line, source-
    /// quoting message rather than the plain `error[Exxxx]: <msg>` line
    /// that bare emit_error / emit_error_at produce.
    emit_diagnostic(mut &this, diag: Diagnostic) -> void {
        this.diagnostics.emit(diag);
    }


    /// Emit a help message (code E0000, severity Help).
    emit_help(mut &this, message: Text) -> void {
        const diag: Diagnostic = Diagnostic {
            severity:    Severity::Help,
            code:        ErrorCode::E0000_UNKNOWN,
            message:     message.as_string(),
            span:        SourceSpan::none(),
            labels:      [],
            children:    [],
            suggestions: [],
        };
        this.diagnostics.emit(diag);
    }

    /// Internal compiler error: emit, print help, and abort.
    ice(mut &this, message: Text) -> void {
        const ice_msg: string = fmt::format("internal compiler error: %s", message.as_string());
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR, Text::new(ice_msg));
        diag = diag.help(Text::new("please report this bug"));
        this.diagnostics.emit(diag);
        // The sink defers rendering until flush() at end of compilation;
        // exiting without flushing here would make every ICE a silent
        // exit-1 with no message printed at all.
        this.diagnostics.flush();
        env::process_exit(1);
    }

    /// Internal compiler error at a place in the source, reported like any
    /// other error so the ones a program has are reported together; the
    /// compilation stops before anything is built from the tree.
    ice_at(mut &this, message: Text, span: SourceSpan) -> void {
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
            Text::new(fmt::format("internal compiler error: %s", message.as_string())));
        diag = diag.at(span);
        diag = diag.help(Text::new("please report this bug"));
        this.diagnostics.emit(diag);
    }

    /// Whether any errors have been emitted.
    has_errors(&this) -> boolean {
        return this.diagnostics.has_errors();
    }


    // Multi-module: switch active module

    /// Switch the context to a different module by index.
    /// Updates source_file, namespace, AST, and resolver module.
    /// Used by the whole-program multi-pass orchestrator.
    switch_to_module(mut &this, index: i64) -> void {
        if (index < 0 || index >= this.module_graph.module_count() as i64) {
            this.ice(Text::new(fmt::format("switch_to_module: index %lld out of range (have %u modules)",
                index, this.module_graph.module_count())));
            return;
        }

        this.active_module_index = index;
        this.active_order_position = -1;
        for (mut p: i64 = 0; p < this.module_graph.topo_order.length; p++) {
            if (this.module_graph.topo_order[p] as i64 == index) {
                this.active_order_position = p;
                break;
            }
        }
        // Borrow the stored ModuleInfo; a value copy would shallow-alias its
        // owning arrays (dependencies/exports/...) and double-free them when
        // the copy drops at scope exit.
        const info: ModuleInfo* = &this.module_graph.modules[index];
        this.source_file = info.file_path;

        // Set namespace from module info
        const ns_str: string = this.intern_table.resolve(info.namespace_name);
        this.unit_module = if (info.namespace_name.is_valid()) { info.path() } else { ModulePath::none() };

        // NOTE: AST swap is handled by the orchestrator (compile_project) because
        // nested struct assignment (this.artifacts.ast = ...) through mut &this
        // doesn't reliably store back through the pointer chain.  The orchestrator
        // calls set_active_ast() separately after switch_to_module().

        // Update resolver's active module (scope restore handled by orchestrator)
        this.resolver.set_module(info.path());

        if (this.options.verbose) {
            LOG_DEBUG(LogComponent::General,
                "[CompilationContext] switch_to_module(%lld) -> '%s' ns='%s'",
                index, info.file_path, ns_str);
        }
    }
}

/// Releases what a compilation owns, users before what they use.  Each
/// component was made as a leaked `Box` (by `new`, or by the stage that first
/// needed it) for the stable address the others point at, and the project
/// config is handed to `new`; each is reclaimed here as one.
///
/// Every `string` resolved from the intern table dangles afterwards: a caller
/// copies what must outlive the context first.  Allocations made while the
/// per-target arena was active are freed as no-ops, so the context must drop
/// while that arena is still published.  The language server never drops
/// one: its contexts live in a session arena, released whole.
implement trait Drop for struct CompilationContext {
    drop(mut &this) -> void {
        if (this.monomorphizer != null) {
            mem::drop(Box::<Monomorphizer>::from_raw(this.monomorphizer));
        }
        if (this.directive_registry != null) {
            delete this.directive_registry;
        }
        mem::drop(Box::<TypeResolver>::from_raw(this.type_resolver));
        mem::drop(Box::<GenericRegistry>::from_raw(this.generic_registry));
        mem::drop(Box::<TypeArena>::from_raw(this.type_arena));
        mem::drop(Box::<Resolver>::from_raw(this.resolver));
        mem::drop(Box::<ConstantTable>::from_raw(this.const_table));
        mem::drop(Box::<DeclarationIndex>::from_raw(this.decl_index));
        mem::drop(Box::<ModuleGraph>::from_raw(this.module_graph));
        mem::drop(Box::<DefTable>::from_raw(this.defs));
        mem::drop(Box::<DiagnosticSink>::from_raw(this.diagnostics));
        mem::drop(Box::<DiagRenderer>::from_raw(this.diag_renderer));
        mem::drop(Box::<PhaseArtifacts>::from_raw(this.artifacts));
        if (this.project_config != null) {
            mem::drop(Box::<ProjectConfig>::from_raw(this.project_config));
        }
        mem::drop(Box::<InternTable>::from_raw(this.intern_table));
    }
}
