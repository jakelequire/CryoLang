///! Compilation Context
///!
///! Single shared state container for a compilation session.  Replaces both
///! PassContext (11 raw pointers) and component ownership on CompilerInstance
///! (17 unique_ptrs with implicit destruction ordering).
///!
///! Components are initialized lazily via init_*() methods called by passes
///! at the appropriate pipeline stage, not all upfront in a constructor.

namespace Compiler::CompilationContext;

import Compiler::{
    CompileMode, Diag, Artifacts, ModuleGraph, DeclIndex, ConstTable, ProjectConfig
};
import Compiler::Diag::{
    Snapshot, Config, Renderer, Severity, Sink, Diagnostic
};
import Compiler::Passes::PassID;
import Compiler::ResolveCounter;
import Compiler::Types;
import Compiler::Types::{ TypeRef, Arena, Registry, Resolver, GenericRegistry };
import Compiler::Mono::Monomorphizer;
import Compiler::Resolver::{ SymbolStr, InternTable, QualifiedName, Resolver };
import Utils::Logger;
import std::env;
import Compiler::Diag::SourceSpan;
import Compiler::Types::Checker;

/// What artifact a single-file build should produce.  Inferred from the
/// extension of `-o PATH` by the CLI; read by `run_object_emission` to
/// pick between LLVM's emit-to-file modes and by the single-file Exe
/// flow to drive `cc` for final linking.
///
/// `None` is the default; it keeps the per-origin
/// `target/<profile>/<origin>/deps/<module>.o` layout when the user
/// didn't pass `-o`.
type enum OutputKind {
    None;
    Object;
    Asm;
    IRText;
    Exe;
}

implement enum OutputKind {

    is_override(&this) -> boolean {
        return match (this) {
            OutputKind::None => { false }
            _                => { true  }
        };
    }
}

type struct CompilationContext {
public:
    // -- Configuration (set at creation, read-only thereafter) --
    mode:              CompileMode;
    source_file:       string;
    include_paths:     string[];
    debug_mode:        boolean;
    /// LLVM optimization level for this compilation: 0 (none/debuggable)
    /// .. 3 (aggressive). Drives both the IR pass pipeline
    /// (`default<O{n}>`, skipped entirely at 0) and the TargetMachine's
    /// backend codegen level. Defaults to 2; set from cryoconfig
    /// `[compiler] optimize` (true=>2, false=>0) or a `--opt-level=N`
    /// CLI override in `compile_project_with_ctx`.
    opt_level:         u32;
    /// Emit DWARF debug info (gated by `-g`/--debug-info). Off by default.
    /// Read by codegen to create a DICompileUnit + per-function
    /// DISubprograms and attach source locations.
    emit_debug_info:   boolean;
    /// DWARF debug-info handles, populated by `run_ir_generation` only when
    /// `emit_debug_info` is set, and read by the function prologue to attach
    /// a DISubprogram + debug location. Opaque LLVM metadata (void*); null
    /// when debug info is off. Per-module (one CompilationContext == one
    /// LLVM module == one DICompileUnit).
    di_builder:        void*;
    di_cu:             void*;
    di_file:           void*;
    namespace_str:     SymbolStr;        // interned current namespace (e.g., "Math::Vec2")

    // -- Phase outputs (heap-allocated to keep CompilationContext small) --
    artifacts: PhaseArtifacts*;

    // -- Diagnostics (heap-allocated) --
    diagnostics:   DiagnosticSink*;
    diag_renderer: DiagRenderer*;
    diag_config:   DiagConfig*;

    // -- Pass tracking --
    provisions: ProvisionSet;

    // -- Multi-module state (heap-allocated) --
    module_graph: ModuleGraph*;

    // -- Interned strings (heap-allocated, lives for the entire compilation) --
    intern_table: InternTable*;

    // -- Declaration index (heap-allocated) --
    decl_index: DeclarationIndex*;

    // -- Folded module-level integer constants (heap-allocated) --
    // Shared across modules: a fixed array size may name a constant declared
    // in an imported module, and imports are name-resolved first.
    const_table: ConstantTable*;

    // -- Injected specialization origin tracking --
    // Maps ASTNode pointer (as u64) -> template module SymbolStr.id.
    // Populated by GenericExpressionResolution when injecting specialized ASTs;
    // queried by sema to switch to the template's module scope.
    injected_ast_ptrs:    u64[];
    injected_ast_modules: u32[];

    // -- Inactive-region tracking (LSP tooling) --
    // Source spans of top-level declarations, methods, and inline `![dir] { }`
    // blocks that ConfigGating stripped as inactive for the target OS.  Those
    // decls are removed from the AST, so this is the only surviving record of
    // where they were; the LSP reads it to publish dimmed ("compiled out")
    // ranges to the editor.  Populated only by the ConfigGating pass.  Fresh
    // per compilation (the LSP builds a new CompilationContext on every
    // recompile), so it needs no explicit reset.
    inactive_spans: SourceSpan[];

    // -- Type system (initialized lazily by TypeDeclaration pass) --
    type_arena: TypeArena*;

    // -- Project configuration (multi-module mode) --
    project_config:      ProjectConfig*;
    project_no_std:      boolean;
    /// `[compiler] no_runtime` (cryoconfig): freestanding build.  Read by
    /// codegen to suppress the `main`-widening / `set_args`/`set_env`
    /// prologue and the `@panic` runtime, and by the linker pass to drop
    /// crt0 / libc / `libcryo.a`.  Also queryable from `![config(no_runtime)]`
    /// gates via ConfigGating.  Default false.
    project_no_runtime:  boolean;
    /// `[compiler] panic = "unwind"` / CLI `--panic=unwind`: select DWARF
    /// unwinding.  Read by codegen to emit invoke/landingpad cleanup edges and
    /// attach `__cryo_personality_v0`, and by the linker pass to link the
    /// `panic/unwind` runtime tier + libunwind instead of `panic/abort`.
    /// Default false = abort (emitted IR is byte-identical to before).
    project_panic_unwind:  boolean;
    /// `[low_level] native_alloc` (cryoconfig): route `GlobalAlloc` through
    /// the native mmap-backed heap instead of libc malloc.  Read by
    /// ConfigGating to evaluate `![config(native_alloc)]` gates.  Default
    /// false => libc-backed (Low-Level Plan Stage 3).  A temporary
    /// migration switch, deleted once the native heap is proven (the
    /// `native_syscalls` switch already completed that lifecycle).
    native_alloc:        boolean;
    active_module_index: i64;
    /// Resolved stdlib root: where `lib.cryo` lives.  Set by Instance
    /// after `resolve_stdlib_root` runs; the linker reads
    /// `<stdlib_root>/.bin/libcryo.a` from here so installed and
    /// in-repo cryo invocations both link against the right archive.
    /// Empty string <=> no stdlib (e.g. no_std project, or unresolved).
    stdlib_root:         string;
    /// Resolved cross-compilation target triple, or empty string when
    /// building for the host.  Set by Instance after merging CLI
    /// `--target=...` over `[project] target = "..."`.  Codegen reads
    /// this in `run_ir_generation` to call `LLVMSetTarget`; the linker
    /// pass compares it to the host triple to decide whether to skip
    /// the `cc` shellout (cross-compile object files cannot be linked
    /// by the host linker without a target-aware toolchain).
    target_triple:       string;
    /// `--release-static`: link statically against libLLVM + a static C++
    /// runtime so the produced compiler binary has no `libLLVM-20.so` runtime
    /// dependency.  Distribution-only; default false keeps the dynamic dev
    /// link.  Read in `CodegenPasses::run_linking`; does not affect IR.
    release_static:      boolean;
    /// Single-file `-o PATH` override.  Set by `compile_file` from
    /// `CompilerConfig::output_path_override`.  Empty string => no
    /// override (per-origin `target/<profile>/<origin>/deps/<module>.o`).  Read by
    /// `run_object_emission` to redirect emission and by the
    /// single-file Exe flow to drive `cc` for final linking.
    output_path_override: string;
    /// Single-file output kind selector.  Mirrors
    /// `CompilerConfig::output_kind`.  `OutputKind::None` <=> no `-o`.
    output_kind:         OutputKind;

    /// LSP in-memory source override.  When the Lexing pass switches
    /// to the module whose `source_file` equals `lsp_override_path`,
    /// it reads from `lsp_override_content` instead of the file on
    /// disk, letting the language server compile what's currently
    /// in the editor buffer (which may diverge from what's saved)
    /// while every OTHER module in the project loads from disk.
    /// Empty `lsp_override_path` (the default) disables the override.
    lsp_override_path:    string;
    lsp_override_content: string;

    // Owned components (initialized lazily by passes that need them).
    // Public because passes across the compiler reach into the context
    // directly to drive these sub-systems.  Encapsulating behind getters
    // is a possible follow-up; for now public matches actual usage.
    resolver:             Resolver*;
    type_resolver:        TypeResolver*;
    generic_registry:     GenericRegistry*;
    monomorphizer:        Monomorphizer*;
    module_type_registry: ModuleTypeRegistry*;
    directive_registry:   void*;           // DirectiveRegistry*; typed-erased to break import cycle.

private:
    type_checker:         TypeChecker*;
    module_loader:        void*;           // ModuleLoader*; typed-erased to break import cycle.
    codegen:              void*;           // LLVM C-API handle; typed-erased pending @cImport.
    linker:               void*;           // LLVM C-API handle; typed-erased pending @cImport.

public:
    /// Create a new compilation context for the given mode and source file.
    static new(mode: CompileMode, source_file: string) -> CompilationContext {
        // Heap-allocate large sub-components to keep CompilationContext small.
        // Struct construction copies fields by value through the stack, so
        // an inline-fielded CompilationContext would risk stack overflow.
        const _box_renderer: Box<DiagRenderer> = Box<DiagRenderer>::new(DiagRenderer::new(RenderConfig::default()));
        const renderer: DiagRenderer* = _box_renderer.leak();

        const _box_artifacts: Box<PhaseArtifacts> = Box<PhaseArtifacts>::new(PhaseArtifacts::new());
        const _box_diag: Box<DiagnosticSink>      = Box<DiagnosticSink>::new(DiagnosticSink::new());
        const _box_diag_config: Box<DiagConfig>   = Box<DiagConfig>::new(DiagConfig::default());
        const _box_module_graph: Box<ModuleGraph> = Box<ModuleGraph>::new(ModuleGraph::new());
        const _box_intern: Box<InternTable>       = Box<InternTable>::new(InternTable::new());
        const _box_decl: Box<DeclarationIndex>    = Box<DeclarationIndex>::new(DeclarationIndex::new());
        const _box_consts: Box<ConstantTable>     = Box<ConstantTable>::new(ConstantTable::new());

        const diag_ptr: DiagnosticSink* = _box_diag.leak();
        const diag_config_ptr: DiagConfig* = _box_diag_config.leak();

        mut ctx: CompilationContext = CompilationContext {
            mode:              mode,
            source_file:       source_file,
            include_paths:     [],
            debug_mode:        false,
            opt_level:         2,
            emit_debug_info:   false,
            di_builder:        null,
            di_cu:             null,
            di_file:           null,
            namespace_str:     SymbolStr::empty(),

            artifacts:     _box_artifacts.leak(),
            diagnostics:   diag_ptr,
            diag_renderer: renderer,
            diag_config:   diag_config_ptr,
            provisions:    ProvisionSet::empty(),
            module_graph:  _box_module_graph.leak(),
            intern_table:  _box_intern.leak(),
            decl_index:    _box_decl.leak(),
            const_table:   _box_consts.leak(),
            injected_ast_ptrs:    [],
            injected_ast_modules: [],
            inactive_spans:       [],
            type_arena:    null,

            project_config:      null,
            project_no_std:      false,
            project_no_runtime:  false,
            project_panic_unwind: false,
            native_alloc:        false,
            active_module_index: -1,
            stdlib_root:         "",
            target_triple:       "",
            release_static:      false,
            output_path_override: "",
            output_kind:         OutputKind::None,

            lsp_override_path:    "",
            lsp_override_content: "",

            resolver:             null,
            type_resolver:        null,
            type_checker:         null,
            generic_registry:     null,
            monomorphizer:        null,
            module_type_registry: null,
            module_loader:        null,
            codegen:              null,
            linker:               null,
            directive_registry:   null,
        };

        // Wire the renderer and config into the sink
        diag_ptr.set_renderer(renderer);
        // The config box was leaked above, so nothing else will ever drop it;
        // the sink's copy is the only owner.
        unsafe { diag_ptr.set_config(*diag_config_ptr); }
        return ctx;
    }

    /// Create a debug context with verbose logging.
    static debug(mode: CompileMode, source_file: string) -> CompilationContext {
        mut ctx_val: CompilationContext = CompilationContext::new(mode, source_file);
        ctx_val.debug_mode = true;
        return ctx_val;
    }


    // String interning convenience

    /// Intern a string, returning a SymbolStr handle.
    /// Shorthand for this.intern_table.intern(text).
    intern(mut &this, text: string) -> SymbolStr {
        return this.intern_table.intern(text);
    }

    /// Resolve a SymbolStr back to its string data.
    /// Shorthand for this.intern_table.resolve(sym).
    resolve_str(&this, sym: SymbolStr) -> string {
        return this.intern_table.resolve(sym);
    }

    /// Get a pointer to the intern table.
    /// Use this instead of ctx.intern_table when accessing through an
    /// inherited pointer (e.g. this.ctx in parser subclasses), where field
    /// access through class hierarchies doesn't resolve correctly.
    get_intern_table(mut &this) -> InternTable* {
        return this.intern_table;
    }

    get_resolver(mut &this) -> Resolver* {
        if (this.resolver == null) {
            this.init_resolver();
        }
        return this.resolver;
    }

    /// Returns the GenericRegistry if initialized; otherwise null.
    /// Does NOT initialize on demand; callers that need it in later passes
    /// should rely on init_type_system() having already been called.
    get_generic_registry(&this) -> GenericRegistry* {
        return this.generic_registry;
    }

    /// The canonical name of the DEFINITION a `TypeRef` names, or empty when
    /// the type is not a declared one.
    ///
    /// For a pass that synthesizes a path-bearing node: the synthesizer holds
    /// the type it is building a reference to rather than a written path, so
    /// the name its `Res` records is derived from that type instead of being
    /// looked up from a spelling. Deriving it is what lets the stamp be set at
    /// the synthesis site, which is where the referent is actually known.
    ///
    /// An instantiation is reduced to the template it instantiates first,
    /// because a `Res` names a definition and never an instantiation - the
    /// invariant that lets `ASTCloner` copy one verbatim. Reading the name off
    /// `Option<i32>` instead of `Option` would record a per-call-site answer
    /// for a declaration that has exactly one.
    definition_name_of(&this, ty: TypeRef) -> SymbolStr {
        if (this.decl_index == null || this.type_arena == null) {
            return SymbolStr::empty();
        }
        const base: TypeRef = this.type_arena.inst_generic_base(ty);
        if (base.is_valid()) {
            const bn: SymbolStr = this.decl_index.lookup_type_name(base);
            if (bn.is_valid()) { return bn; }
        }
        return this.decl_index.lookup_type_name(ty);
    }

    /// Record that an injected AST node came from a specific template module.
    register_injected_origin(mut &this, node_ptr: u64, module: SymbolStr) -> void {
        this.injected_ast_ptrs.push(node_ptr);
        this.injected_ast_modules.push(module.id);
    }

    /// Look up the template module for an injected AST node.
    /// Returns empty SymbolStr if the node wasn't injected.
    lookup_injected_origin(&this, node_ptr: u64) -> SymbolStr {
        for (mut i: i64 = 0; i < this.injected_ast_ptrs.length; i++) {
            if (this.injected_ast_ptrs[i] == node_ptr) {
                return SymbolStr::from_id(this.injected_ast_modules[i]);
            }
        }
        return SymbolStr::empty();
    }


    // Namespace helpers

    /// Whether a namespace has been set for this compilation unit.
    has_namespace(&this) -> boolean {
        return !this.namespace_str.is_empty();
    }

    /// Set the namespace for this compilation unit from a dotted/scoped string.
    set_namespace(mut &this, ns: string) -> void {
        this.namespace_str = this.intern_table.intern(ns);
    }

    /// The namespace as a display string (for APIs that need strings).
    namespace_display(&this) -> string {
        return this.intern_table.resolve(this.namespace_str);
    }

    /// The namespace of the module that owns `file`, as its interned name, or
    /// the empty symbol when no module in the graph declares it.
    ///
    /// This is the AMBIENT-CURSOR-FREE counterpart to `namespace_display()`.
    /// `namespace_display()` answers "which module is the compiler standing in
    /// right now", which is only the right question while a pass walks
    /// declarations in order; it is the wrong one the moment an annotation is
    /// re-resolved from somewhere else.  This answers "which module owns this
    /// specific piece of syntax", which is what a bare leaf in that syntax
    /// actually means.
    ///
    /// Exact, not a heuristic: a .cryo file declares exactly one namespace (the
    /// parser records the first non-directive `ModuleDeclaration` as the file's
    /// `namespace_name` and stops), so file -> module is a total function.
    ///
    /// Callers pass a node's own `span.file`, so the answer travels with the
    /// syntax rather than with the walk.
    ///
    /// The empty symbol means "the graph cannot say", and it is NOT
    /// distinguishable from a module whose namespace is the empty string: the
    /// intern table seeds "" at id 0, so `intern("")` and `SymbolStr::empty()`
    /// are the same handle.  Nothing declares an empty namespace, so the two
    /// cases do not both arise - but a caller must not lean on telling them
    /// apart.  Test `is_valid()` and fall back explicitly: reading a missing
    /// answer as a namespace that compares unequal to every real one turns "I
    /// don't know where this was written" into "this was written somewhere
    /// else", the false-positive direction that reverted the visibility gate.
    ///
    /// Delegates to `ModuleGraph::ns_sym_of_file`, which is where this mapping
    /// lives so that mono can share it (it cannot import this module - see the
    /// note on that function).  One implementation, two layers.
    module_ns_sym_of_file(&this, file: string) -> SymbolStr {
        if (this.module_graph == null) { return SymbolStr::empty(); }
        return this.module_graph.ns_sym_of_file(file);
    }

    /// The use-site module identity (a namespace SymbolStr) for import-scoped
    /// name resolution: the declared namespace when set (the multi-module
    /// norm), else the source file interned (single-file mode).  This is the
    /// identity space shared by qualified type names and ModuleInfo dependencies.
    current_module_ns(&this) -> SymbolStr {
        if (this.has_namespace()) { return this.namespace_str; }
        return this.intern_table.intern(this.source_file);
    }

    /// Import-scoped resolution of a bare leaf from the module currently being
    /// processed.  Import-aware, unlike a context-free lookup;
    /// see DeclarationIndex::resolve_qualified_scoped.
    ///
    /// The use site is `current_module_ns()` — the ambient cursor — so every
    /// caller passes `FILE, LINE` and the origin is `Cursor` by construction,
    /// not by inspection.  The site comes from the CALLER rather than from this
    /// wrapper, for the same reason `ResolutionContext::clone` carries the
    /// original: one location here would collapse every caller into itself and
    /// report the wrapper as the whole population.
    resolve_scoped(&this, bare: SymbolStr,
                   origin_file: string, origin_line: i32) -> ScopeResolution {
        return this.decl_index.resolve_qualified_scoped(
            bare, this.current_module_ns(), this.intern_table,
            origin_file, origin_line, "Cursor");
    }

    /// `resolve_scoped(bare).resolved_or(bare)` - for use at non-authoritative
    /// call sites (e.g. codegen, which receives already-qualified names).
    /// Authoritative sites call `resolve_scoped` and diagnose `Ambiguous`
    /// themselves.
    resolve_scoped_or(&this, bare: SymbolStr,
                      origin_file: string, origin_line: i32) -> SymbolStr {
        return this.resolve_scoped(bare, origin_file, origin_line)
                   .resolved_or(bare);
    }

    /// True when `bare` resolves to two or more import-visible same-leaf
    /// candidates from the current module - a hard ambiguity the caller must
    /// diagnose (E0154) and the author must qualify.  False for the common
    /// unique/local/miss cases.
    scope_is_ambiguous(&this, bare: SymbolStr,
                       origin_file: string, origin_line: i32) -> boolean {
        return this.resolve_scoped(bare, origin_file, origin_line).is_ambiguous();
    }

    /// `resolve_scoped`, judged against the module that WROTE the name rather
    /// than the module the compiler is standing in.
    ///
    /// A bare leaf means what it means in the module whose source text contains
    /// it, and that is not the ambient cursor: a generic body is re-typed with
    /// the cursor parked on the module owning the RECEIVER, so a name there is
    /// judged against a module that never wrote it, and the verdict describes
    /// the walk rather than the source (spec §5.2).
    ///
    /// `span_file` is the node's own `span.file`, so the answer travels with the
    /// syntax.  When it names no module in the graph (synthesized nodes,
    /// single-file mode) this falls back to the cursor rather than to "no
    /// scope": an invalid namespace compares unequal to every real one, so
    /// judging against it would read missing provenance as "written somewhere
    /// else" and reject everything - the false-positive direction that reverted
    /// the visibility gate once.  The fallback is counted AND reported as the
    /// `Cursor` origin, so a run can never confuse "provenance was available"
    /// with "provenance agreed with the cursor".
    resolve_scoped_at(&this, bare: SymbolStr, span_file: string,
                      origin_file: string, origin_line: i32) -> ScopeResolution {
        const syn: SymbolStr = this.module_ns_sym_of_file(span_file);
        if (!syn.is_valid()) {
            ResolveCounter::Site::ScopeUseCursor.bump();
            return this.resolve_scoped(bare, origin_file, origin_line);
        }
        ResolveCounter::Site::ScopeUseSyntax.bump();
        if (syn.id != this.current_module_ns().id) {
            ResolveCounter::Site::ScopeUseDiff.bump();
        }
        return this.decl_index.resolve_qualified_scoped(
            bare, syn, this.intern_table, origin_file, origin_line, "Syntax");
    }

    /// `resolve_scoped_at(..).resolved_or(bare)` - the syntax-scoped twin of
    /// `resolve_scoped_or`.
    resolve_scoped_or_at(&this, bare: SymbolStr, span_file: string,
                         origin_file: string, origin_line: i32) -> SymbolStr {
        return this.resolve_scoped_at(bare, span_file, origin_file, origin_line)
                   .resolved_or(bare);
    }

    /// `scope_is_ambiguous` judged against the writing module.  A caller that
    /// binds with `resolve_scoped_or_at` must ask this rather than
    /// `scope_is_ambiguous`, or the diagnostic and the binding are answers to
    /// one question from two different modules.
    scope_is_ambiguous_at(&this, bare: SymbolStr, span_file: string,
                          origin_file: string, origin_line: i32) -> boolean {
        return this.resolve_scoped_at(bare, span_file, origin_file, origin_line)
                   .is_ambiguous();
    }

    /// Temporarily override the active namespace (e.g., for scope switching in sema).
    /// Returns the previous value so it can be restored.
    swap_namespace(mut &this, new_ns: SymbolStr) -> SymbolStr {
        const old: SymbolStr = this.namespace_str;
        this.namespace_str = new_ns;
        return old;
    }

    /// Like qualify_symbol() but returns an interned SymbolStr instead of a raw string.
    /// Use this when the result feeds into the type system (arena, registries).
    /// Returns "Namespace::name" for types within a namespace, or bare name if
    /// no namespace is set.
    qualify_symbol_sym(mut &this, sym: SymbolStr) -> SymbolStr {
        if (this.namespace_str.is_empty()) {
            return sym;
        }
        const ns: string = this.intern_table.resolve(this.namespace_str);
        const bare: string = this.intern_table.resolve(sym);
        return this.intern_table.intern(ns + "::" + bare);
    }

    /// The qualifier the span's OWN module would mint - the module that WROTE
    /// the name, not the one the compiler is standing in.
    ///
    /// A bare leaf means what it means in the module whose source text
    /// contains it.  The ambient cursor answers that correctly only while a
    /// pass walks a module's own declarations in order; a trait default's body
    /// and a specialized clone are both re-typed with the cursor parked on
    /// another module, and a name qualified there names nothing.
    ///
    /// Falls back to the cursor when the file names no module in the graph
    /// (a synthesized node, single-file mode) rather than to "no namespace":
    /// an invalid namespace compares unequal to every real one, so treating
    /// missing provenance as a distinct module would read "I cannot tell where
    /// this was written" as "this was written somewhere else".
    qualify_symbol_sym_home(mut &this, sym: SymbolStr,
                            span_file: string) -> SymbolStr {
        const home: SymbolStr = this.module_ns_sym_of_file(span_file);
        if (!home.is_valid()) { return this.qualify_symbol_sym(sym); }
        const ns: string   = this.intern_table.resolve(home);
        const bare: string = this.intern_table.resolve(sym);
        return this.intern_table.intern(ns + "::" + bare);
    }

    /// Qualify `sym` under an extern-module binding namespace when
    /// `binding_namespace` is set, otherwise under the file's ambient
    /// namespace (`qualify_symbol_sym`).  Used for the struct/enum/typedef
    /// declarations the C-header import engine synthesizes into an extern
    /// module's *alias* namespace: a synthesized `LLVMModuleRef` whose
    /// `binding_namespace` is `llvm` qualifies as `llvm::LLVMModuleRef`,
    /// exactly as extern functions register under `alias::name`
    /// (`type_resolution.cryo` ExternBlock branch).  This is deliberately a
    /// SEPARATE channel from `DeclarationNode.source_module` (which the
    /// monomorphizer already uses to stamp a spec's template namespace) so
    /// C-import qualification can never perturb spec registration.
    qualify_binding_sym(mut &this, sym: SymbolStr, binding_namespace: SymbolStr) -> SymbolStr {
        if (binding_namespace.is_empty()) {
            return this.qualify_symbol_sym(sym);
        }
        const ns: string = this.intern_table.resolve(binding_namespace);
        const bare: string = this.intern_table.resolve(sym);
        return this.intern_table.intern(ns + "::" + bare);
    }

    /// The arena's CANONICAL type for a written struct/union/class name.
    ///
    /// The ambient namespace names the module the compiler is STANDING IN,
    /// which is the canonical one only by coincidence.  For an injected
    /// monomorph the two diverge: a spec is placed in the module owning its
    /// type argument (`Array<u8, GlobalAlloc>` -> `alloc::allocator`) while
    /// its canonical identity stays with the template
    /// (`collections::array::5Array$Lh_...$G`).  So the ambient key only hits
    /// when the emitting module happens to be the canonical one, and the
    /// bare-name alias the monomorphizer registers for every spec
    /// (`TypeArena::add_name_alias`) is what answers otherwise.
    canonical_type_ref(mut &this, name: SymbolStr) -> TypeRef {
        const di: DeclarationIndex* = this.decl_index;
        const arena: TypeArena* = this.type_arena;
        mut tref: TypeRef = di.lookup_type(
            this.qualify_symbol_sym(name));
        if (!tref.is_valid()) { tref = di.lookup_type(name); }
        if (!tref.is_valid()) { tref = arena.lookup_by_name(name); }
        return tref;
    }

    /// The name a type's methods are registered under, and therefore the
    /// prefix every cross-module reference to them mangles.
    ///
    /// Declaring a method and emitting its body must derive this the SAME
    /// way.  If they disagree the declaration is left bodyless (and, being a
    /// monomorph, `linkonce_odr`) while the body is emitted under a second
    /// symbol nobody references, and LLVM rejects the module with "Global is
    /// external, but doesn't have external or weak linkage".  Deriving it
    /// once is what makes disagreement unrepresentable rather than merely
    /// unobserved.
    canonical_type_qname(mut &this, name: SymbolStr) -> SymbolStr {
        const tref: TypeRef = this.canonical_type_ref(name);
        if (tref.is_valid()) {
            const arena: TypeArena* = this.type_arena;
            const q: SymbolStr = arena.get_qualified_name(tref);
            if (q.is_valid()) { return q; }
        }
        return this.qualify_symbol_sym(name);
    }


    // Lazy component initialization
    // TODO:
    // Remove later when all components are fully typed and can be initialized in the constructor

    /// Initialize the type system components (TypeArena, TypeChecker, TypeResolver).
    /// Called by the TypeDeclaration pass.
    init_type_system(mut &this) -> void {
        LOG_DEBUG(LogComponent::General, "[CompilationContext] init_type_system()");
        // Ensure resolver is initialized (symbols live there now)
        this.init_resolver();

        // Create the TypeArena if it doesn't exist yet
        if (this.type_arena == null) {
            const _box_arena: Box<TypeArena> = Box<TypeArena>::new(TypeArena::new(this.intern_table));
            this.type_arena = _box_arena.leak();
        }

        // Create the GenericRegistry early so that the TypeResolver can route
        // generic instantiations through the dedup cache from the very first
        // pass that resolves type annotations (FunctionSignature).
        if (this.generic_registry == null) {
            const _box_greg: Box<GenericRegistry> = Box<GenericRegistry>::new(GenericRegistry::new(this.type_arena));
            this.generic_registry = _box_greg.leak();
        }

        // Create the ModuleTypeRegistry if it doesn't exist yet
        if (this.module_type_registry == null) {
            const _box_mtr: Box<ModuleTypeRegistry> = Box<ModuleTypeRegistry>::new(ModuleTypeRegistry::new());
            this.module_type_registry = _box_mtr.leak();
        }

        // Create the TypeResolver with all required dependencies.
        // The Resolver (name_resolver) is initialized by the NameResolution pass
        // which runs before TypeDeclaration, so it should be available here.
        if (this.type_resolver == null) {
            const _box_tr: Box<TypeResolver> = Box<TypeResolver>::new(TypeResolver::new(
                this.type_arena,
                this.intern_table,
                this.generic_registry,
                this.module_type_registry,
                this.resolver,
                this.decl_index,
                this.const_table,
                this.module_graph
            ));
            this.type_resolver = _box_tr.leak();
            this.type_resolver.set_diagnostics(this.diagnostics);
        }
    }

    /// Initialize the Resolver for name resolution.
    /// Called by the NameResolution pass.
    init_resolver(mut &this) -> void {
        LOG_DEBUG(LogComponent::General, "[CompilationContext] init_resolver()");
        if (this.resolver == null) {
            const _box_res: Box<Resolver> = Box<Resolver>::new(Resolver::new(this.intern_table));
            this.resolver = _box_res.leak();
        }
        // The scope walk's outermost tier, installed here because this runs
        // after the prelude set is derived and before any pass resolves a name.
        // Re-stated on every call rather than once: the resolver outlives a
        // single pass, and a tier that is only correct when installation
        // happened to precede the first lookup is a tier nobody can reason
        // about.
        if (this.decl_index != null) {
            this.resolver.set_prelude_modules(this.decl_index.prelude_namespaces());
        }
    }


    /// Record a source span that ConfigGating stripped as inactive for the
    /// target OS (a decl / method / inline block gated to another platform).
    /// The LSP reads `inactive_spans` to dim compiled-out code.  Ignores
    /// location-less spans so a synthesized node never produces a phantom
    /// range.
    note_inactive(mut &this, span: SourceSpan) -> void {
        if (span.has_location()) {
            this.inactive_spans.push(span);
        }
    }


    // Diagnostic convenience

    /// Emit an error diagnostic.
    emit_error(mut &this, code: ErrorCode, message: string) -> void {
        this.diagnostics.emit(Diagnostic::error(code, message));
    }


    /// Emit an error with source location.
    emit_error_at(mut &this, code: ErrorCode, message: string, span: SourceSpan) -> void {
        mut diag: Diagnostic = Diagnostic::error(code, message);
        diag = diag.at(span);
        this.diagnostics.emit(diag);
    }

    /// Emit a fully-built diagnostic. Use this when the diagnostic was
    /// composed via the builder pattern (`.at()`, `.with_note_at()`,
    /// `.help()`, `.suggest()`, `.also_at()`). The renderer uses spans,
    /// labels, children, and suggestions to produce a multi-line, source-
    /// quoting message rather than the plain `error[Exxxx]: <msg>` line
    /// that bare emit_error / emit_error_at produce.
    emit_diagnostic(mut &this, diag: Diagnostic) -> void {
        this.diagnostics.emit(diag);
    }


    /// Emit a help message (code E0000, severity Help).
    emit_help(mut &this, message: string) -> void {
        const diag: Diagnostic = Diagnostic {
            severity:    Severity::Help,
            code:        ErrorCode::E0000_UNKNOWN,
            message:     message,
            span:        SourceSpan::none(),
            labels:      [],
            children:    [],
            suggestions: [],
        };
        this.diagnostics.emit(diag);
    }

    /// Internal compiler error: emit, print help, and abort.
    ice(mut &this, message: string) -> void {
        const ice_msg: string = format("internal compiler error: %s", message);
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR, ice_msg);
        diag = diag.help("please report this bug");
        this.diagnostics.emit(diag);
        // The sink defers rendering until flush() at end of compilation;
        // exiting without flushing here would make every ICE a silent
        // exit-1 with no message printed at all.
        this.diagnostics.flush();
        env::process_exit(1);
    }

    /// Whether any errors have been emitted.
    has_errors(&this) -> boolean {
        return this.diagnostics.has_errors();
    }


    // Provision tracking


    // Module-level reset (stdlib batch mode)

    /// Reset per-module state for the next module in a batch compilation.
    /// Checks mode.preserve_asts() to decide whether to save the current AST.
    reset_for_next_module(mut &this, next_source: string) -> void {
        LOG_DEBUG(LogComponent::General, "[CompilationContext] reset_for_next_module() next='%s'", next_source);
        // Preserve ASTs if the mode requires it (StdlibBatch)
        if (this.mode.preserve_asts()) {
            this.artifacts.preserve_current_ast();
        }

        // Reset per-module data
        this.artifacts.reset_for_next_module();
        this.provisions.clear();
        this.source_file = next_source;
        this.namespace_str = SymbolStr::empty();

        // Reset resolver cursor (preserves cross-module state)
        if (this.resolver != null) {
            this.resolver.reset_for_next_module();
        }
    }


    // Multi-module: switch active module

    /// Switch the context to a different module by index.
    /// Updates source_file, namespace, AST, and resolver module.
    /// Used by the whole-program multi-pass orchestrator.
    switch_to_module(mut &this, index: i64) -> void {
        if (index < 0 || index >= this.module_graph.module_count() as i64) {
            this.ice(format("switch_to_module: index %lld out of range (have %u modules)",
                index, this.module_graph.module_count()));
            return;
        }

        this.active_module_index = index;
        // Borrow the stored ModuleInfo; a value copy would shallow-alias its
        // owning arrays (dependencies/exports/...) and double-free them when
        // the copy drops at scope exit.
        const info: ModuleInfo* = &this.module_graph.modules[index];
        this.source_file = info.file_path;

        // Set namespace from module info
        const ns_str: string = this.intern_table.resolve(info.namespace_name);
        if (ns_str.length() > 0) {
            this.namespace_str = info.namespace_name;
        } else {
            this.namespace_str = SymbolStr::empty();
        }

        // NOTE: AST swap is handled by the orchestrator (compile_project) because
        // nested struct assignment (this.artifacts.ast = ...) through mut &this
        // doesn't reliably store back through the pointer chain.  The orchestrator
        // calls set_active_ast() separately after switch_to_module().

        // Update resolver's active module (scope restore handled by orchestrator)
        if (this.resolver != null) {
            this.resolver.set_module(info.name);
        }

        if (this.debug_mode) {
            LOG_DEBUG(LogComponent::General,
                "[CompilationContext] switch_to_module(%lld) -> '%s' ns='%s'",
                index, info.file_path, ns_str);
        }
    }

    /// Set up the project configuration for multi-module compilation.
    set_project_config(mut &this, config: ProjectConfig*) -> void {
        this.project_config = config;
        if (config != null) {
            this.project_no_std = config.no_std;
            this.project_no_runtime = config.no_runtime;
            this.project_panic_unwind = config.resolve_panic_unwind();
            this.native_alloc = config.native_alloc;
        }
    }


    // Per-target teardown

    /// Reclaim heap owned by this context once the build's survivor strings
    /// (the returned `CompilationResult`) have been copied out to storage
    /// independent of the context.  After this call the context is DEAD and
    /// must never be used again.
    ///
    /// A `cryo build` compiles each target (`[lib]`, then each `[[bin]]`)
    /// with its own context in a single process.  Without this teardown a
    /// completed target's heap stays resident while the next target builds,
    /// so a multi-target build's peak RSS stacks both targets instead of
    /// peaking at the larger one.  Reclaiming the prior context here caps
    /// the peak near a single target.
    ///
    /// NOT called on the LSP path: the language server keeps its context
    /// alive across requests and reaches this struct directly via
    /// `compile_project_with_ctx`, never through
    /// `compile_project_with_config` where this teardown is invoked.
    release_per_target(mut &this) -> void {
        if (this.intern_table != null) {
            this.intern_table.release_strings();
        }
    }
}
