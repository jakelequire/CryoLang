///! Lockfile — `cryoconfig.lock`
///!
///! Pins each git dependency to the SHA that was resolved by the most
///! recent `cryo fetch` / `cryo update`.  Path deps are not pinned.
///!
///! Format (INI-ish, matching the cryoconfig parser):
///!
///!   version = 1
///!
///!   [[package]]
///!   name     = "cqlite"
///!   url      = "https://github.com/jakelequire/cqlite.git"
///!   ref_kind = "version"   # version | tag | branch | rev
///!   ref_val  = "0.1.0"
///!   sha      = "abcdef..."
///!
///! The `ref_kind`/`ref_val` round-trip preserves the user's intent —
///! a stale lockfile that mismatches the current cryoconfig is detected
///! by comparing those fields and triggers a re-resolve.

namespace Compiler::DepsLockfile;

import Utils::File;
import Utils::Logger;


// ============================================================================
// Types
// ============================================================================

/// A single entry pinned in the lockfile.
type struct LockedDep {
    name:     string;
    url:      string;
    ref_kind: string;   // "version" | "tag" | "branch" | "rev"
    ref_val:  string;
    sha:      string;   // 40-char full SHA

    static empty() -> LockedDep {
        return LockedDep {
            name: "", url: "", ref_kind: "", ref_val: "", sha: "",
        };
    }
}

type struct Lockfile {
    /// Format version of the lockfile itself.  Bumped if we ever
    /// reshape the schema; older files would be regenerated.
    schema_version: i64;
    packages:       LockedDep[];

    static empty() -> Lockfile {
        return Lockfile { schema_version: 1, packages: [] };
    }

    /// Find the locked entry for `name`, or null if absent.
    find(&this, name: string) -> LockedDep* {
        for (mut i: int = 0; i < this.packages.length; i++) {
            if (intrinsics::strcmp(this.packages[i].name, name) == 0) {
                return &this.packages[i];
            }
        }
        return null;
    }
}

const CURRENT_SCHEMA_VERSION: i64 = 1;


// ============================================================================
// Parsing
// ============================================================================

/// Read and parse `path`.  Missing file → empty Lockfile (not an
/// error — it just means `cryo fetch` hasn't run yet).  Malformed
/// content prints a warning and is also treated as empty so the next
/// fetch can rebuild it.
function read(path: string) -> Lockfile {
    if (!File::exists(path)) {
        return Lockfile::empty();
    }

    mut file: File = File::new(path);
    file.load();
    const content: string = file.content();

    mut lock:   Lockfile = Lockfile::empty();
    mut current_section: string = "";
    mut cur_idx: i64 = -1;

    mut pos: i64 = 0;
    const len: i64 = intrinsics::strlen(content) as i64;

    while (pos < len) {
        const line_start: i64 = pos;
        while (pos < len && content[pos] != 10) { pos = pos + 1; }
        const line: string = substr_local(content, line_start, pos - line_start);
        if (pos < len) { pos = pos + 1; }

        const trimmed: string = trim_whitespace(line);
        if (intrinsics::strlen(trimmed) == 0) { continue; }
        if (trimmed[0] == '#') { continue; }

        if (trimmed[0] == '[') {
            const t_len: i64 = intrinsics::strlen(trimmed) as i64;
            const is_array: boolean = t_len >= 4
                && trimmed[1] == '['
                && trimmed[t_len-1] == ']' && trimmed[t_len-2] == ']';
            if (is_array) {
                current_section = substr_local(trimmed, 2, t_len - 4);
                if (intrinsics::strcmp(current_section, "package") == 0) {
                    lock.packages.push(LockedDep::empty());
                    cur_idx = lock.packages.length as i64 - 1;
                } else {
                    cur_idx = -1;
                }
            } else {
                const close: i64 = find_char_local(trimmed, ']' as i8);
                if (close > 1) {
                    current_section = substr_local(trimmed, 1, close - 1);
                }
                cur_idx = -1;
            }
            continue;
        }

        const eq: i64 = find_char_local(trimmed, '=' as i8);
        if (eq < 0) { continue; }
        const key: string   = trim_whitespace(substr_local(trimmed, 0, eq));
        const val_raw:string= trim_whitespace(substr_local(trimmed, eq + 1, intrinsics::strlen(trimmed) as i64 - eq - 1));
        const val: string   = strip_quotes(val_raw);

        if (intrinsics::strcmp(current_section, "") == 0) {
            // Top-level keys.
            if (intrinsics::strcmp(key, "version") == 0) {
                lock.schema_version = parse_int_local(val);
            }
        } else if (intrinsics::strcmp(current_section, "package") == 0 && cur_idx >= 0) {
            if      (intrinsics::strcmp(key, "name")     == 0) { lock.packages[cur_idx].name     = val; }
            else if (intrinsics::strcmp(key, "url")      == 0) { lock.packages[cur_idx].url      = val; }
            else if (intrinsics::strcmp(key, "ref_kind") == 0) { lock.packages[cur_idx].ref_kind = val; }
            else if (intrinsics::strcmp(key, "ref_val")  == 0) { lock.packages[cur_idx].ref_val  = val; }
            else if (intrinsics::strcmp(key, "sha")      == 0) { lock.packages[cur_idx].sha      = val; }
        }
    }

    if (lock.schema_version != CURRENT_SCHEMA_VERSION) {
        intrinsics::fprintf(g_stderr,
            "warning: %s has schema_version=%lld; expected %lld — regenerate via `cryo fetch`\n",
            path, lock.schema_version, CURRENT_SCHEMA_VERSION);
    }

    return lock;
}


// ============================================================================
// Writing
// ============================================================================

/// Write `lock` to `path`, overwriting any existing file.
/// Entries are emitted in insertion order so diffs stay readable.
function write(path: string, lock: Lockfile*) -> boolean {
    const f: void* = intrinsics::fopen(path, "w");
    if (f == null) {
        intrinsics::fprintf(g_stderr, "error: cannot open %s for writing\n", path);
        return false;
    }

    intrinsics::fputs("# Auto-generated by `cryo fetch`. Do not edit by hand.\n", f);
    intrinsics::fputs("# Re-run `cryo fetch` after changing cryoconfig dependencies.\n", f);
    intrinsics::fprintf(f, "version = %lld\n\n", lock.schema_version);

    for (mut i: int = 0; i < lock.packages.length; i++) {
        const p: LockedDep = lock.packages[i];
        intrinsics::fputs("[[package]]\n", f);
        intrinsics::fprintf(f, "name     = \"%s\"\n", p.name);
        intrinsics::fprintf(f, "url      = \"%s\"\n", p.url);
        intrinsics::fprintf(f, "ref_kind = \"%s\"\n", p.ref_kind);
        intrinsics::fprintf(f, "ref_val  = \"%s\"\n", p.ref_val);
        intrinsics::fprintf(f, "sha      = \"%s\"\n\n", p.sha);
    }

    intrinsics::fclose(f);
    return true;
}


// ============================================================================
// Internal string helpers
// ============================================================================

function substr_local(s: string, start: i64, length: i64) -> string {
    if (length <= 0) { return ""; }
    const buf: i8* = intrinsics::malloc(length as u64 + 1) as i8*;
    intrinsics::memcpy(buf as void*, intrinsics::ptr_add(s as void*, start) as void*, length as u64);
    const term: i8* = intrinsics::ptr_add(buf as void*, length) as i8*;
    intrinsics::memset(term as void*, 0, 1);
    return buf as string;
}

function find_char_local(s: string, ch: i8) -> i64 {
    const len: i64 = intrinsics::strlen(s) as i64;
    for (mut i: i64 = 0; i < len; i++) {
        if (s[i] == ch) { return i; }
    }
    return -1;
}

function trim_whitespace(s: string) -> string {
    const len: i64 = intrinsics::strlen(s) as i64;
    if (len == 0) { return s; }
    mut start: i64 = 0;
    while (start < len && (s[start] == 32 || s[start] == 9 || s[start] == 13)) {
        start = start + 1;
    }
    mut end: i64 = len - 1;
    while (end >= start && (s[end] == 32 || s[end] == 9 || s[end] == 13)) {
        end = end - 1;
    }
    if (start > end) { return ""; }
    return substr_local(s, start, end - start + 1);
}

function strip_quotes(s: string) -> string {
    const len: i64 = intrinsics::strlen(s) as i64;
    if (len >= 2 && s[0] == '"' && s[len-1] == '"') {
        return substr_local(s, 1, len - 2);
    }
    return s;
}

function parse_int_local(s: string) -> i64 {
    const len: i64 = intrinsics::strlen(s) as i64;
    mut acc: i64 = 0;
    for (mut i: i64 = 0; i < len; i++) {
        if (s[i] >= '0' && s[i] <= '9') {
            acc = acc * 10 + (s[i] - '0') as i64;
        } else {
            break;
        }
    }
    return acc;
}
