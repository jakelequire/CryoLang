///! Module Loader
///!
///! Discovers and resolves modules for multi-module compilation.
///! Handles import path -> filesystem path resolution with case variations,
///! recursive module discovery from an entry point, and circular dependency
///! detection.

namespace Compiler::ModuleLoader;

import Compiler::Resolver::SymbolStr;
import Compiler::Diag::Sink;
import Compiler::Diag::Diagnostic;
import Compiler::Diag::SourceSpan;
import Compiler::Diag::EditDistance;
import Compiler::Resolver::InternTable;
import Compiler::ModuleGraph;
import Compiler::Diag;
import Compiler::Lex;
import Compiler::Lex::Lexer;
import Compiler::ProjectConfig;
import Utils::File;
import Utils::Logger;
import std::collections::hashmap;
import std::collections::pair;
import std::core::option;

type struct ModuleLoader {
    project_root: string;
    entry_dir:    string;
    stdlib_root:  string;
    no_std:       boolean;

    /// Extra source roots resolved relative to project_root.  Scanned
    /// alongside entry_dir so that imports targeting siblings of the
    /// entry point (e.g. a library entry at `src/compiler/_module.cryo`
    /// whose source imports `Utils::*` from `src/utils`) resolve.
    extra_roots: string[];

    // Circular dependency detection.
    // loading[i].first is the path; loading[i].second is true while it is being loaded.
    loading: Pair<string, boolean>[];

    // Already-loaded file paths (dedup)
    loaded_paths: string[];

    // Pre-scanned namespace -> file_path map.
    // Built by scan_all_project_files() before discovery begins.
    // Key: namespace name (e.g., "Compiler::AST::Node")
    // Value: file path (e.g., "src/compiler/AST/node.cryo")
    ns_map: HashMap<string, string>;

    /// LSP-mode editor-buffer override.  When `lsp_override_path` is
    /// non-empty and matches the file the loader is about to read, the
    /// loader feeds `lsp_override_content` to the lexer instead of
    /// reading the file from disk.  This makes import discovery see
    /// the imports the user is *currently typing*; the on-disk copy
    /// may not have them yet, which would leave referenced stdlib
    /// modules undiscovered and break name resolution downstream.
    /// Both empty in non-LSP builds.
    lsp_override_path:    string;
    lsp_override_content: string;

    static new(project_root: string, entry_point: string,
               stdlib_root: string, no_std: boolean,
               extra_roots: string[]) -> ModuleLoader {
        return ModuleLoader {
            project_root:  project_root,
            entry_dir:     extract_directory(entry_point),
            stdlib_root:   stdlib_root,
            no_std:        no_std,
            extra_roots:   extra_roots,
            loading: [],
            loaded_paths:  [],
            ns_map:        HashMap<string, string>::new(),
            lsp_override_path:    "",
            lsp_override_content: "",
        };
    }

    /// Wire the LSP editor-buffer override.  Called once, before
    /// `discover_project`, when running under `CompileMode::Lsp`.  No-op
    /// when `path` is empty.
    set_lsp_override(mut &this, path: string, content: string) -> void {
        this.lsp_override_path    = path;
        this.lsp_override_content = content;
    }

    /// Build a `File` for `file_path`, substituting the LSP editor
    /// buffer when the path matches the configured override.  Mirrors
    /// the same gate the Lexing pass uses (see `pass_registry.cryo`).
    file_for(&this, file_path: string) -> File {
        if (strlen(this.lsp_override_path) > 0
                && strcmp(this.lsp_override_path, file_path) == 0) {
            return File::from_content(file_path, "cryo", this.lsp_override_content);
        }
        return File::new(file_path);
    }


    /// Discover all modules starting from the entry point.
    /// Populates the module graph with ModuleInfo entries and dependency edges.
    discover_project(mut &this, intern: InternTable*,
                     graph: ModuleGraph*, sink: DiagnosticSink*,
                     entry_path: string, debug: boolean) -> boolean {
        if (debug) {
            cdebug("[ModuleLoader] Discovering project from: %s\n", entry_path);
            cdebug("[ModuleLoader] Project root: %s\n", this.project_root);
        }

        // Pre-scan: walk the project directory tree and lex every .cryo file
        // to extract its namespace.  This builds the ns_map (namespace -> path)
        // so that resolve_import_path can resolve any import with a simple
        // HashMap lookup, regardless of directory casing.
        this.scan_all_project_files(this.entry_dir, debug);
        if (!this.no_std && strlen(this.stdlib_root) > 0) {
            this.scan_all_project_files(this.stdlib_root, debug);
        }
        // include_paths from cryoconfig: each is resolved relative to
        // project_root.  HashMap.insert is last-wins, so re-scanning a
        // path already covered by entry_dir is harmless.
        for (mut i: int = 0; i < this.extra_roots.length; i++) {
            const rel: string = this.extra_roots[i];
            const root: string = if (strlen(this.project_root) == 0
                                     || strcmp(this.project_root, ".") == 0) {
                rel
            } else {
                format("%s/%s", this.project_root, rel)
            };
            if (debug) {
                cdebug("[ModuleLoader] Scanning extra root: %s\n", root);
            }
            this.scan_all_project_files(root, debug);
        }

        if (debug) {
            cdebug("[ModuleLoader] Pre-scan complete: %d namespaces indexed\n",
                this.ns_map.length());
        }

        return this.discover_module(intern, graph, sink, entry_path, debug);
    }

    /// Recursively walk `dir`, calling `discover_module` on every `.cryo`
    /// file. Used by `cryo test` to register every file under `tests/`
    /// as a top-level module; test files are leaves in the import
    /// graph (nothing imports them) so the entry-point-driven walk
    /// would never reach them. Caller is responsible for having already
    /// run `scan_all_project_files(dir, ...)` so namespaces in the
    /// directory resolve through `ns_map`.
    discover_tests_directory(mut &this, intern: InternTable*,
                             graph: ModuleGraph*, sink: DiagnosticSink*,
                             dir: string, debug: boolean) -> boolean {
        const dp: void* = opendir(dir);
        if (dp == null) { return true; }

        mut overall_ok: boolean = true;
        mut entry: void* = readdir(dp);
        while (entry != null) {
            const name: string = dirent_name(entry);
            const dtype: i32 = dirent_type(entry);
            if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0) {
                entry = readdir(dp);
                continue;
            }
            const full_path: string = format("%s/%s", dir, name);
            if (dtype == 1) {
                // `tests/negative/` holds compile-fail cases: files that are
                // intentionally malformed so the compiler rejects them. They
                // must NOT be compiled into the shared test binary (one bad
                // file would break the whole build). `cmd_test` drives them
                // separately, compiling each on its own and checking the
                // expected diagnostic.
                if (strcmp(name, "negative") == 0) {
                    entry = readdir(dp);
                    continue;
                }
                // Recurse into subdirectories.
                if (!this.discover_tests_directory(
                        intern, graph, sink, full_path, debug)) {
                    overall_ok = false;
                }
            } else if (dtype == 0) {
                const name_len: u64 = strlen(name);
                if (name_len > 5) {
                    const ext: string = ptr_add(name as void*,
                        (name_len - 5) as i64) as string;
                    if (strcmp(ext, ".cryo") == 0) {
                        if (!this.discover_module(
                                intern, graph, sink, full_path, debug)) {
                            overall_ok = false;
                        }
                    }
                }
            }
            entry = readdir(dp);
        }
        closedir(dp);
        return overall_ok;
    }

    /// Recursively walk a directory, lex every .cryo file to extract its
    /// namespace declaration, and register namespace -> file_path in ns_map.
    scan_all_project_files(mut &this, dir: string, debug: boolean) -> void {
        const dp: void* = opendir(dir);
        if (dp == null) { return; }

        mut entry: void* = readdir(dp);
        while (entry != null) {
            const name: string = dirent_name(entry);
            const dtype: i32 = dirent_type(entry);

            // Skip . and ..
            if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0) {
                entry = readdir(dp);
                continue;
            }

            const full_path: string = format("%s/%s", dir, name);

            if (dtype == 1) {
                // FileType::Directory: recurse into subdirectory
                this.scan_all_project_files(full_path, debug);
            } else if (dtype == 0) {
                // FileType::File: regular file; check for .cryo extension
                const name_len: u64 = strlen(name);
                if (name_len > 5) {
                    const ext: string = ptr_add(name as void*, (name_len - 5) as i64) as string;
                    if (strcmp(ext, ".cryo") == 0) {
                        this.scan_file_namespace(full_path);
                    }
                }
            }

            entry = readdir(dp);
        }
        closedir(dp);
    }

    /// Lex a single .cryo file, extract the namespace declaration,
    /// and register it in ns_map.
    scan_file_namespace(mut &this, file_path: string) -> void {
        // Skip the on-disk existence check when the file is the LSP
        // override target; `file_for` will hand the lexer the editor
        // buffer regardless of what's on disk (file may be unsaved).
        const is_override: boolean =
            (strlen(this.lsp_override_path) > 0
                && strcmp(this.lsp_override_path, file_path) == 0);
        if (!is_override && !File::exists(file_path)) { return; }

        mut scan_sink: DiagnosticSink = DiagnosticSink::new();
        const file: File = this.file_for(file_path);
        const lexer: Lexer = Lexer::new(file, &scan_sink);
        const tokens: Token[] = lexer.lex();

        // Extract just the namespace; scan_tokens gives us everything
        // but we only need the namespace name.
        const scan: ModuleScanResult = scan_tokens(tokens);
        if (strlen(scan.namespace_name) > 0) {
            const h: u64 = hash_str(scan.namespace_name);
            this.ns_map.insert(scan.namespace_name, file_path);
        }
    }


    /// Resolve an import path (e.g., "BattleTest" or "Compiler::AST")
    /// to a filesystem path.  Returns "" if not found.
    resolve_import_path(&this, import_path: string) -> string {
        // Fast path: check pre-scanned namespace map first.
        // This handles all case-insensitive resolution automatically since
        // the map was built by walking the actual filesystem.
        const h: u64 = hash_str(import_path);
        const from_map: Option<string> = this.ns_map.get(&import_path);
        if (from_map.is_some()) {
            return from_map.unwrap();
        }

        // Convert :: to /
        const fs_path: string = replace_separator(import_path);

        // Search locations in priority order
        // 1. Project root
        const from_root: string = this.search_location(this.project_root, fs_path);
        if (strlen(from_root) > 0) { return from_root; }

        // 2. Entry point directory (if different from root)
        if (strcmp(this.entry_dir, this.project_root) != 0 && strlen(this.entry_dir) > 0) {
            const from_entry: string = this.search_location(this.entry_dir, fs_path);
            if (strlen(from_entry) > 0) { return from_entry; }
        }

        // 3. Stdlib (unless no_std)
        // Strip "std/" prefix from fs_path since the stdlib_root already
        // points to the stdlib directory (e.g., "../stdlib").
        // Import "std::collections::hashmap" -> fs_path "std/collections/hashmap"
        // -> search for "collections/hashmap" under stdlib_root.
        if (!this.no_std && strlen(this.stdlib_root) > 0) {
            mut stdlib_fs_path: string = fs_path;
            if (strlen(fs_path) > 4 && fs_path[0] == 's' && fs_path[1] == 't' &&
                fs_path[2] == 'd' && fs_path[3] == '/') {
                stdlib_fs_path = fs_path + 4;  // skip "std/"
            }
            const from_stdlib: string = this.search_location(this.stdlib_root, stdlib_fs_path);
            if (strlen(from_stdlib) > 0) { return from_stdlib; }
        }

        return "";
    }


    /// Best-effort "did you mean" for an unresolved import. Scans the
    /// pre-built namespace map — every discoverable module's declared
    /// namespace — for the closest name by Damerau-Levenshtein distance.
    /// Catches the common case mismatch (`utils` -> `Utils`) and small
    /// typos (`Compiler::Reslover` -> `Compiler::Resolver`). Returns ""
    /// when nothing is close enough or the map is empty.
    suggest_module(&this, import_path: string) -> string {
        mut candidates: string[] = [];
        const count: u64 = this.ns_map.bucket_count();
        mut b: u64 = 0;
        while (b < count) {
            mut node: hashmap::Entry<string, string>* = this.ns_map.get_bucket(b);
            loop {
                if (node == null) { break; }
                candidates.push(node.key);
                node = node.next;
            }
            b += 1;
        }
        return find_best_candidate(import_path, candidates);
    }


    // Internal: Recursive Discovery

    /// Recursively discover a module and its imports.
    discover_module(mut &this, intern: InternTable*,
                    graph: ModuleGraph*, sink: DiagnosticSink*,
                    file_path: string, debug: boolean) -> boolean {
        // Check if already loaded (case-insensitive on Windows).
        // Different import paths can resolve to the same file with different
        // casing (e.g., "src/Compiler/Passes/Sema.cryo" vs
        // "src/compiler/passes/sema.cryo").  Lowercasing ensures we only
        // load and register each physical file once.
        const norm_path: string = to_lowercase(file_path);

        if (this.is_loaded(norm_path)) { return true; }

        // Circular dependency: this module is already being loaded
        // (i.e., we are inside its own import subtree).  This is expected
        // for mutually-referencing modules (e.g., AST::Node <-> AST::Expression).
        // During *discovery* we only need to know that the file exists and
        // will be registered; the topological sort handles actual ordering.
        if (this.is_loading(norm_path)) {
            return true;
        }

        // Verify file exists.  Skip the check for the LSP override
        // target; its content lives in the editor buffer, not on disk.
        const is_override: boolean =
            (strlen(this.lsp_override_path) > 0
                && strcmp(this.lsp_override_path, file_path) == 0);
        if (!is_override && !File::exists(file_path)) {
            const msg: string = format("module file not found: '%s'", file_path);
            sink.emit(Diagnostic::error(ErrorCode::E0500_MODULE_NOT_FOUND, msg));
            return false;
        }

        // Mark as loading (use normalized path for dedup)
        this.push_loading(norm_path);

        if (debug) {
            cdebug("[ModuleLoader] Discovering: %s\n", file_path);
        }

        // Quick-scan the file: lex only, extract namespace and import paths
        mut scan_sink: DiagnosticSink = DiagnosticSink::new();
        const file: File = this.file_for(file_path);
        const lexer: Lexer = Lexer::new(file, &scan_sink);
        const tokens: Token[] = lexer.lex();

        // Extract namespace and imports from token stream
        const scan: ModuleScanResult = scan_tokens(tokens);

        // Note if this module uses an f-string so the orchestrator can
        // force-discover the f-string runtime (std::fmt::interp) on demand.
        if (scan.uses_fstring) {
            graph.uses_fstring = true;
        }

        if (debug) {
            cdebug("[ModuleLoader]   namespace: '%s', imports: %d\n",
                scan.namespace_name, scan.import_count);
        }

        // Create ModuleInfo (store original path so the lexer can open the file)
        const mod_name_str: string = if (strlen(scan.namespace_name) > 0) {
            scan.namespace_name
        } else {
            extract_module_name(file_path)
        };
        const mod_name: SymbolStr = intern.intern(mod_name_str);
        mut info: ModuleInfo = ModuleInfo::with_namespace(
            mod_name, file_path, mod_name);

        // Directory of the current file, used to resolve bare sub-module
        // names (e.g., `public module Commands;` in src/CLI/_module.cryo
        // should find src/CLI/Commands.cryo).
        const file_dir: string = extract_directory(file_path);

        // Process imports: discover dependencies recursively
        mut success: boolean = true;
        for (mut i: i64 = 0; i < scan.import_count; i++) {
            const import_path: string = scan.import_paths[i];

            // Resolve to filesystem path.  First try global resolution, then
            // fall back to searching relative to the declaring file's directory
            // (handles bare `public module X;` declarations in _module.cryo).
            mut resolved: string = this.resolve_import_path(import_path);
            if (strlen(resolved) == 0) {
                resolved = this.search_location(file_dir, replace_separator(import_path));
            }
            if (debug) {
                cdebug("[ModuleLoader]   import '%s' -> '%s'\n", import_path, resolved);
            }
            if (strlen(resolved) == 0) {
                // Filesystem resolution failed; check if the module was
                // already discovered (e.g., via a parent's `public module`
                // submodule declaration).  This handles cases where the
                // import path doesn't map cleanly to the filesystem due to
                // mixed-case directories (e.g., `compiler/AST/node.cryo`
                // where `AST` is uppercase but `compiler` is lowercase).
                const already_name: SymbolStr = intern.intern(import_path);
                const already_idx: i64 = graph.find_module_index(already_name);
                if (already_idx >= 0) {
                    // Module already in graph: use its recorded file path
                    resolved = graph.modules[already_idx].file_path;
                    if (debug) {
                        cdebug("[ModuleLoader]   import '%s' -> '%s' (found in graph)\n",
                            import_path, resolved);
                    }
                } else {
                    // Unresolved import. Anchor the diagnostic at the
                    // offending path, and — when a near-match exists in the
                    // discovered namespace map — suggest it. The lockstep
                    // import_spans array carries no file (scan_tokens has
                    // none), so rebuild the span with this file's path.
                    mut span: SourceSpan = SourceSpan::none();
                    if (i < scan.import_spans.length) {
                        const raw: SourceSpan = scan.import_spans[i];
                        span = SourceSpan::new(file_path,
                            raw.start_line, raw.start_col,
                            raw.end_line, raw.end_col);
                    }
                    const suggestion: string = this.suggest_module(import_path);
                    mut diag: Diagnostic = Diagnostic::error(
                        ErrorCode::E0500_MODULE_NOT_FOUND,
                        format("cannot find module `%s`", import_path));
                    if (span.has_location()) {
                        diag = diag.at_with_label(span,
                            format("no module named `%s` is in scope", import_path));
                    }
                    if (strlen(suggestion) > 0) {
                        diag = diag.with_note(format("did you mean `%s`?", suggestion));
                    }
                    diag = diag.help(
                        "imports resolve against the project root, the entry-point directory, and the standard library; module paths are case-sensitive");
                    sink.emit(diag);
                    success = false;
                    continue;
                }
            }

            // Recursively discover the dependency (must happen before
            // add_dependency so the target module's namespace is known)
            if (!this.discover_module(intern, graph, sink, resolved, debug)) {
                success = false;
            }

            // Add dependency edge using the target module's actual namespace
            // name (from its source file), not the raw import path.
            // e.g., `import core::option` resolves to file core/option.cryo
            // whose namespace is `std::core::option`.  We must record the
            // dependency under that namespace name so that get_exports() and
            // topological sort can find the module by its registered name.
            const dep_idx: i64 = graph.find_module_by_path(resolved);
            if (dep_idx >= 0) {
                info.add_dependency(graph.modules[dep_idx].name);
            } else {
                // Fallback: use raw import path (should not happen if
                // discover_module succeeded)
                const dep_name: SymbolStr = intern.intern(import_path);
                info.add_dependency(dep_name);
            }
        }

        // Discover submodules (public module declarations) WITHOUT adding
        // dependency edges.  Aggregator _module.cryo files re-export their
        // children, but this isn't a real data dependency; the parent doesn't
        // need its children compiled first.  Treating these as dependencies
        // creates false cycles (e.g., AST -> Specializer -> Types -> AST).
        for (mut s: i64 = 0; s < scan.submodule_count; s++) {
            const sub_path: string = scan.submodule_paths[s];
            mut sub_resolved: string = this.resolve_import_path(sub_path);
            if (strlen(sub_resolved) == 0) {
                sub_resolved = this.search_location(file_dir, replace_separator(sub_path));
            }
            if (debug) {
                cdebug("[ModuleLoader]   submodule '%s' -> '%s'\n", sub_path, sub_resolved);
            }
            if (strlen(sub_resolved) > 0) {
                if (!this.discover_module(intern, graph, sink, sub_resolved, debug)) {
                    success = false;
                }
                // NO add_dependency here; submodules are not real deps
            }
        }

        // Register this module in the graph
        graph.add_module(info);

        // Mark as loaded, remove from loading set (use normalized path)
        this.mark_loaded(norm_path);
        this.pop_loading(norm_path);

        return success;
    }


    // Internal: Path Resolution

    /// Search a single directory for a module with case variations.
    search_location(&this, base_dir: string, fs_path: string) -> string {
        // 1. Directory module: base_dir/fs_path/_module.cryo
        const dir_module: string = format("%s/%s/_module.cryo", base_dir, fs_path);
        if (File::exists(dir_module)) { return dir_module; }

        // 2. Exact case: base_dir/fs_path.cryo
        const exact: string = format("%s/%s.cryo", base_dir, fs_path);
        if (File::exists(exact)) { return exact; }

        // 3. Lowercase: base_dir/lowercase.cryo
        const lower: string = format("%s/%s.cryo", base_dir, to_lowercase(fs_path));
        if (File::exists(lower)) { return lower; }

        // 4. Snake case: base_dir/snake_case.cryo
        const snake: string = format("%s/%s.cryo", base_dir, to_snake_case(fs_path));
        if (File::exists(snake)) { return snake; }

        // 5. Lowercase directory module
        const lower_dir: string = format("%s/%s/_module.cryo", base_dir, to_lowercase(fs_path));
        if (File::exists(lower_dir)) { return lower_dir; }

        return "";
    }


    // Loading set management

    is_loading(&this, path: string) -> boolean {
        for (mut i: i64 = 0; i < this.loading.length; i++) {
            if (this.loading[i].second && strcmp(this.loading[i].first, path) == 0) {
                return true;
            }
        }
        return false;
    }

    push_loading(mut &this, path: string) -> void {
        this.loading.push(Pair::new(path, true));
    }

    pop_loading(mut &this, path: string) -> void {
        for (mut i: i64 = 0; i < this.loading.length; i++) {
            if (this.loading[i].second && strcmp(this.loading[i].first, path) == 0) {
                this.loading[i].second = false;
                return;
            }
        }
    }

    is_loaded(&this, path: string) -> boolean {
        for (mut i: i64 = 0; i < this.loaded_paths.length; i++) {
            if (strcmp(this.loaded_paths[i], path) == 0) {
                return true;
            }
        }
        return false;
    }

    mark_loaded(mut &this, path: string) -> void {
        this.loaded_paths.push(path);
    }
}


/// Result of scanning a file's tokens for namespace and import declarations.
/// This avoids needing a full parse during discovery.
type struct ModuleScanResult {
    namespace_name:  string;
    import_paths:    string[];    // real `import` statements (create dependency edges)
    import_spans:    SourceSpan[]; // span of each import path, parallel to import_paths (file unset; caller fills)
    import_count:    i64;
    submodule_paths: string[];    // `public module` declarations (discover only, no dep edge)
    submodule_count: i64;
    uses_fstring:    boolean;     // file contains at least one f-string (`f"..."`)
}


/// Scan a token stream for `namespace` and `import` declarations.
/// Does NOT build an AST; just extracts the module-level metadata
/// needed for dependency discovery.
function scan_tokens(tokens: Token[]) -> ModuleScanResult {
    mut ns: string = "";
    mut imports: string[] = [];
    mut import_spans: SourceSpan[] = [];
    mut submodules: string[] = [];
    const len: i64 = tokens.length;
    mut i: i64 = 0;

    while (i < len) {
        const tok: Token = tokens[i];

        // namespace Foo::Bar;
        if (tok.kind == TokenType::KwNamespace) {
            i += 1;
            const path: string = collect_qualified_name(tokens, &i, len);
            ns = path;
            // Skip semicolon if present
            if (i < len) {
                if (tokens[i].kind == TokenType::Semicolon) {
                    i += 1;
                }
            }
            continue;
        }

        // import Foo::Bar;
        if (tok.kind == TokenType::KwImport) {
            // The path's first segment sits just past the `import`
            // keyword; record its position so an unresolved import can
            // point a caret at the path rather than emitting a
            // context-free message.
            mut path_line: int = tok.line;
            mut path_col:  int = tok.column + 7;  // length of "import "
            i += 1;
            if (i < len) {
                path_line = tokens[i].line;
                path_col  = tokens[i].column;
            }
            const path: string = collect_qualified_name(tokens, &i, len);
            if (strlen(path) > 0) {
                imports.push(path);
                // Underline through the last consumed name token. The
                // file is left empty here (scan_tokens has no path); the
                // caller rebuilds the span with the real source path.
                mut end_line: int = path_line;
                mut end_col:  int = path_col + (strlen(path) as int);
                if (i >= 1 && (i - 1) < len) {
                    const last: Token = tokens[i - 1];
                    end_line = last.line;
                    end_col  = last.column + last.source_length;
                }
                import_spans.push(SourceSpan::new("",
                    path_line as u32, path_col as u32,
                    end_line as u32, end_col as u32));
            }
            // Skip semicolon if present
            if (i < len) {
                if (tokens[i].kind == TokenType::Semicolon) {
                    i += 1;
                }
            }
            continue;
        }

        // public module Math::Vec2;  -- sub-module declaration in _module.cryo files.
        // The module path is used as-is for dependency resolution (same as an
        // import).  Convention: always use the fully-qualified path, e.g.
        //   namespace Math;
        //   public module Math::Vec2;    // NOT just "Vec2"
        if (tok.kind == TokenType::KwPublic) {
            if ((i + 1) < len) {
                if (tokens[i + 1].kind == TokenType::KwModule) {
                    i += 2;  // consume 'public' 'module'
                    const mod_path: string = collect_qualified_name(tokens, &i, len);
                    if (strlen(mod_path) > 0) {
                        submodules.push(mod_path);
                    }
                    // Skip semicolon if present
                    if (i < len) {
                        if (tokens[i].kind == TokenType::Semicolon) {
                            i += 1;
                        }
                    }
                    continue;
                }
            }
        }

        // Stop scanning at the first non-import/namespace/module top-level
        // declaration to avoid scanning into function bodies.
        if (is_declaration_keyword(tok.kind)) {
            break;
        }

        i += 1;
    }

    // The import/namespace scan above stops at the first declaration, but
    // f-strings live in function bodies, so do a separate full-stream pass
    // to detect whether this module uses one (drives discovery of the
    // f-string runtime, std::fmt::interp).
    mut uses_fstring_val: boolean = false;
    for (mut fi: i64 = 0; fi < len; fi++) {
        if (tokens[fi].kind == TokenType::FStringLiteral) {
            uses_fstring_val = true;
            break;
        }
    }

    const import_count_val:    i64 = imports.length;
    const submodule_count_val: i64 = submodules.length;
    return ModuleScanResult {
        namespace_name:  ns,
        import_paths:    imports,
        import_spans:    import_spans,
        import_count:    import_count_val,
        submodule_paths: submodules,
        submodule_count: submodule_count_val,
        uses_fstring:    uses_fstring_val,
    };
}

/// Collect a qualified name like "Foo::Bar::Baz" from the token stream.
/// Advances *pos past the name tokens.
/// Accepts both identifiers and keywords as path segments, since module
/// names like "string", "process", "thread" etc. are valid Cryo keywords.
function collect_qualified_name(tokens: &Token[], pos: i64*, len: i64) -> string {
    mut result: string = "";
    mut p: i64 = *pos;

    while (p < len) {
        const tok: Token = tokens[p];
        // Accept identifiers AND keywords as path segments.
        // Module names often collide with keywords (e.g., "collections::string",
        // "core::option", "core::result", "thread", "process", "env").
        // Use the token's lexeme directly; it contains the original text.
        if (tok.kind == TokenType::Identifier || tok.kind.is_keyword()) {
            if (strlen(result) > 0) {
                result = format("%s::%s", result, tok.lexeme);
            } else {
                result = tok.lexeme;
            }
            p += 1;

            // Check for :: separator
            if (p < len) {
                if (tokens[p].kind == TokenType::ColonColon) {
                    p += 1;  // skip ::
                    continue;
                }
            }
            break;
        }
        break;
    }

    *pos = p;
    return result;
}

/// Check if a token kind starts a declaration (stop scanning point).
function is_declaration_keyword(kind: TokenType) -> boolean {
    if (kind == TokenType::KwFunction)  { return true; }
    if (kind == TokenType::KwType)      { return true; }
    if (kind == TokenType::KwConst)     { return true; }
    if (kind == TokenType::KwStatic)    { return true; }
    if (kind == TokenType::KwExtern)    { return true; }
    if (kind == TokenType::KwImplement) { return true; }
    if (kind == TokenType::KwPublic)    { return true; }
    if (kind == TokenType::KwPrivate)   { return true; }
    return false;
}


/// Replace :: with / in an import path.
function replace_separator(path: string) -> string {
    const len: i64 = strlen(path) as i64;
    if (len == 0) { return path; }

    const buf: i8* = malloc(len as u64 + 1) as i8*;
    mut j: i64 = 0;

    for (mut i: i64 = 0; i < len; i++) {
        if (path[i] == 58 && i + 1 < len && path[i + 1] == 58) {  // '::'
            const p: i8* = ptr_add(buf as void*, j) as i8*;
            *p = 47 as i8;  // '/'
            j += 1;
            i += 1;  // skip second ':'
        } else {
            const p: i8* = ptr_add(buf as void*, j) as i8*;
            const byte: i8 = path[i] as i8;
            *p = byte;
            j += 1;
        }
    }

    const term: i8* = ptr_add(buf as void*, j) as i8*;
    *term = 0 as i8;
    return buf as string;
}

/// Convert a string to lowercase using raw memcpy + in-place mutation.
function to_lowercase(s: string) -> string {
    const len: u64 = strlen(s);
    if (len == 0) { return s; }

    const out: i8* = malloc(len + 1) as i8*;
    memcpy(out as void*, s as void*, len);
    const term: i8* = ptr_add(out as void*, len as i64) as i8*;
    *term = 0 as i8;

    // In-place lowercase each byte
    for (mut i: u64 = 0; i < len; i++) {
        const p: i8* = ptr_add(out as void*, i as i64) as i8*;
        const ch: i8 = *p;
        // A=65, Z=90: add 32 to make lowercase
        const lower: i8 = (ch + 32) as i8;
        const use_lower: boolean = ch >= 65 && ch <= 90;
        if (use_lower) { *p = lower; }
    }
    return out as string;
}

/// Convert PascalCase/camelCase to snake_case, handling acronyms.
/// "PassID" -> "pass_id", "ASTValidation" -> "ast_validation".
/// Two-pass: first compute length, then fill.
function to_snake_case(s: string) -> string {
    const len: u64 = strlen(s);
    if (len == 0) { return s; }

    // Helper: insert underscore before uppercase char at position i when:
    //   (a) previous char is lowercase (new word after lowercase run), OR
    //   (b) previous char is uppercase AND next char is lowercase
    //       (transition from acronym to word, e.g. the 'V' in "ASTValidation")
    // Never insert after '/' or '_', or at position 0.

    // Pass 1: compute output length
    mut out_len: u64 = 0;
    for (mut i: u64 = 0; i < len; i++) {
        const ch: i8 = s[i];
        const is_upper: boolean = ch >= 65 && ch <= 90;
        if (is_upper && i > 0) {
            const prev: i8 = s[i - 1];
            if (prev != 47 && prev != 95) {
                const prev_lower: boolean = prev >= 97 && prev <= 122;
                const next_lower: boolean = (i + 1 < len) && s[i + 1] >= 97 && s[i + 1] <= 122;
                if (prev_lower || next_lower) {
                    out_len += 1;  // underscore
                }
            }
        }
        out_len += 1;
    }

    // Pass 2: fill output
    const out: i8* = malloc(out_len + 1) as i8*;
    mut j: u64 = 0;
    for (mut i: u64 = 0; i < len; i++) {
        const ch: i8 = s[i];
        const is_upper: boolean = ch >= 65 && ch <= 90;

        // Insert underscore using the same rule as pass 1
        if (is_upper && i > 0) {
            const prev: i8 = s[i - 1];
            if (prev != 47 && prev != 95) {
                const prev_lower: boolean = prev >= 97 && prev <= 122;
                const next_lower: boolean = (i + 1 < len) && s[i + 1] >= 97 && s[i + 1] <= 122;
                if (prev_lower || next_lower) {
                    const pu: i8* = ptr_add(out as void*, j as i64) as i8*;
                    *pu = 95 as i8;
                    j += 1;
                }
            }
        }

        const pc: i8* = ptr_add(out as void*, j as i64) as i8*;
        if (is_upper) {
            const lower_ch: i8 = ch + 32 as i8;
            *pc = lower_ch;
        } else {
            *pc = ch;
        }
        j += 1;
    }

    const term: i8* = ptr_add(out as void*, j as i64) as i8*;
    *term = 0 as i8;
    return out as string;
}

/// Extract a module name from a file path (filename without extension).
function extract_module_name(path: string) -> string {
    // Find last / or \
    const len: i64 = strlen(path) as i64;
    mut last_sep: i64 = -1;
    for (mut i: i64 = 0; i < len; i++) {
        if (path[i] == 47 || path[i] == 92) {  // '/' or '\'
            last_sep = i;
        }
    }

    const name_start: i64 = last_sep + 1;

    // Find last '.'
    mut last_dot: i64 = -1;
    for (mut i: i64 = name_start; i < len; i++) {
        if (path[i] == 46) {  // '.'
            last_dot = i;
        }
    }

    const name_end: i64 = if (last_dot > name_start) { last_dot } else { len };
    const name_len: i64 = name_end - name_start;

    const buf: i8* = malloc(name_len as u64 + 1) as i8*;
    memcpy(buf as void*, ptr_add(path as void*, name_start) as void*, name_len as u64);
    const term: i8* = ptr_add(buf as void*, name_len) as i8*;
    *term = 0 as i8;
    return buf as string;
}

/// Extract directory from a path.
function extract_directory(path: string) -> string {
    const len: i64 = strlen(path) as i64;
    mut last_sep: i64 = -1;
    for (mut i: i64 = 0; i < len; i++) {
        if (path[i] == 47 || path[i] == 92) {
            last_sep = i;
        }
    }
    if (last_sep <= 0) { return "."; }

    const buf: i8* = malloc(last_sep as u64 + 1) as i8*;
    memcpy(buf as void*, path as void*, last_sep as u64);
    const term: i8* = ptr_add(buf as void*, last_sep) as i8*;
    *term = 0 as i8;
    return buf as string;
}
