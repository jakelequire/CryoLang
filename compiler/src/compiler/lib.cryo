/// The compiler library's `lib.cryo`: `compiler` is the library's
/// namespace, the one a tool depending on it imports, and every file of the
/// library declares a namespace below it.  Its sub-modules are listed here
/// so discovery of the library reaches the whole tree.

namespace compiler;

module {
    Instance;
    Lex;
    CompileMode;
    CompilationContext;
    DeclIndex;
    ConstTable;
    ResolveCounter;
    Diag;
    Artifacts;
    ModuleGraph;
    AST;
    Types;
    Resolver;
    Parser;
    Mono;
    Sema;
    Passes;
    ProjectConfig;
    BuildManifest;
    ModuleLoader;
    Codegen;
    Deps;
    Bindgen;
    Vendor;
    Utils;
}
