/// Pass Registry
///
/// Pipeline builder and executor.  Replaces the PassManager class with a
/// data-driven approach: PassRegistry holds a list of PassIDs, validates
/// their dependency graph, and runs them in order via enum dispatch.
///
/// Pipeline construction is a pure function (build_standard_pipeline, etc.)
/// so each CompileMode gets exactly the passes it needs.

namespace Compiler::Passes::PassRegistry;
import ffi::libc;

import Compiler::{
    Diag, Artifacts, CompilationContext, ModuleGraph, ModuleLoader
};
import Compiler::Diag::{ Snapshot, Sink, SourceSpan };
import Compiler::Lex;
import Compiler::Lex::Lexer;
import Compiler::AST;
import Compiler::AST::{ Node, Declaration };
import Compiler::Types;
import Compiler::Types::{ TypeRef, Arena };
import Compiler::Passes::{
    PassID, ASTValidation, ConfigGating, Specialization,
    TypeResolution, TypeLowering, DirectiveProcessing,
    MoveCheck, DropInsertion
};
import Compiler::Bindgen::Importer;
import Compiler::Passes::DefaultExpansion;
import Compiler::Parser;
import Compiler::Parser::Parser;
import Compiler::Resolver::{ SymbolStr, InternTable, NameResolution };
import Compiler::Sema::Sema;
import Compiler::Codegen::Passes;
import Utils;
import Utils::Logger;
import std::fs::file;
import std::fs::metadata;
import std::fs::path;


// PassStats: Per-pass execution statistics

type struct PassStats {
    id:              PassID;
    executed:        boolean;
    success:         boolean;
    skipped:         boolean;
    errors_emitted:  u32;
    warnings_emitted: u32;

    static new(id: PassID) -> PassStats {
        return PassStats {
            id:               id,
            executed:         false,
            success:          false,
            skipped:          false,
            errors_emitted:   0,
            warnings_emitted: 0,
        };
    }
}



// PassRegistry: Pipeline container and executor

type struct PassRegistry {
    passes:     PassID[];
    stats:      PassStats[];
    validated:  boolean;
    verbose:    boolean;

    static new() -> PassRegistry {
        return PassRegistry {
            passes:     [],
            stats:      [],
            validated:  false,
            verbose:    false,
        };
    }

    /// Enable verbose logging of pass execution.
    set_verbose(mut &this, v: boolean) -> void {
        this.verbose = v;
    }

    /// Validate the dependency graph: for each pass, check that all required
    /// provisions will be satisfied by earlier passes.
    validate(mut &this) -> boolean {
        LOG_DEBUG(LogComponent::General, "[PassRegistry] validate() called, passes.length = %lld", this.passes.length);
        mut available: ProvisionSet = ProvisionSet::empty();

        for (mut i: int = 0; i < this.passes.length; i++) {
            LOG_DEBUG(LogComponent::General, "[PassRegistry] validating pass %lld/%lld", i + 1, this.passes.length);
            const meta: PassMetadata = this.passes[i].metadata();

            // Check required dependencies
            for (mut j: int = 0; j < meta.requirements.length; j++) {
                const req: PassRequirement = meta.requirements[j];
                if (req.is_required && !available.has(req.provision)) {
                    cdebug("[PassRegistry] Validation failed: %s requires %s but it won't be available\n",
                        meta.name, req.provision.name());
                    this.validated = false;
                    return false;
                }
            }

            // Register this pass's provisions
            for (mut k: int = 0; k < meta.provisions.length; k++) {
                available.mark(meta.provisions[k]);
            }
        }

        this.validated = true;
        return true;
    }

    /// Validate assuming the given provisions are already available.
    /// Used by the multi-module orchestrator where sub-pipelines start
    /// with provisions from previous stages.
    validate_with_initial(mut &this, initial: ProvisionSet) -> boolean {
        mut available: ProvisionSet = initial;

        for (mut i: int = 0; i < this.passes.length; i++) {
            const meta: PassMetadata = this.passes[i].metadata();

            for (mut j: int = 0; j < meta.requirements.length; j++) {
                const req: PassRequirement = meta.requirements[j];
                if (req.is_required && !available.has(req.provision)) {
                    cdebug("[PassRegistry] Validation failed: %s requires %s but it won't be available\n",
                        meta.name, req.provision.name());
                    this.validated = false;
                    return false;
                }
            }

            for (mut k: int = 0; k < meta.provisions.length; k++) {
                available.mark(meta.provisions[k]);
            }
        }

        this.validated = true;
        return true;
    }

    /// Replace the pass list with a new set of passes.
    set_passes(mut &this, new_passes: PassID[]) -> void {
        this.passes = new_passes;
        this.validated = false;
        // Reset stats
        this.stats = [];
        for (mut i: int = 0; i < new_passes.length; i++) {
            this.stats.push(PassStats::new(new_passes[i]));
        }
    }

    /// Run all passes in order.  Returns true if no fatal pass failed.
    run_all(mut &this, ctx: CompilationContext*) -> boolean {
        if (!this.validated) {
            cdebug("[PassRegistry] Error: pipeline not validated before run_all\n");
            return false;
        }

        // Track explicit pass failures separately from emitted diagnostics: a
        // non-fatal pass can return PassResult::failure(n) WITHOUT recording a
        // diagnostic, which the has_errors()-only gate below would otherwise
        // swallow and report as a green build. Fold both signals into the
        // result. (stub()/ok() are success=true, so legitimately-stubbed and
        // skipped passes are unaffected.)
        mut any_failed: boolean = false;

        for (mut i: int = 0; i < this.passes.length; i++) {
            const id: PassID = this.passes[i];
            const meta: PassMetadata = id.metadata();

            if (this.verbose) {
                cdebug("[Pass %d/%d] %s (%s)\n",
                    i + 1, this.passes.length, meta.name, meta.stage.label());
            }

            // Take diagnostic snapshot before the pass
            const snap: DiagnosticSnapshot = ctx->diagnostics.snapshot();

            // Dispatch to the pass implementation
            const result: PassResult = PassRegistry::run_pass(id, ctx);

            // Update stats
            this.stats[i].executed = true;
            this.stats[i].success = result.success;
            this.stats[i].skipped = result.skipped;
            this.stats[i].errors_emitted = result.errors_emitted;
            this.stats[i].warnings_emitted = result.warnings_emitted;

            if (result.skipped && this.verbose) {
                cdebug("[Pass %d/%d] %s SKIPPED (stub, not yet implemented)\n",
                    i + 1, this.passes.length, meta.name);
            }

            if (!result.success) { any_failed = true; }

            // Abort on fatal failure
            if (!result.success && id.fatal_on_failure()) {
                if (this.verbose) {
                    cdebug("[Pass %d/%d] %s FAILED (fatal); aborting pipeline\n",
                        i + 1, this.passes.length, meta.name);
                }
                return false;
            }

            // Register provisions from metadata on the context (single source of truth).
            // Provisions are derived from PassID::metadata(), not from PassResult,
            // so passes cannot accidentally claim provisions they don't own.
            if (result.success) {
                for (mut j: int = 0; j < meta.provisions.length; j++) {
                    ctx->provisions.mark(meta.provisions[j]);
                }
            }
        }

        return !any_failed && !ctx->diagnostics.has_errors();
    }

    /// Run passes until (and including) all passes in the given stage.
    run_until(mut &this, ctx: CompilationContext*, until: PassStage) -> boolean {
        if (!this.validated) {
            cdebug("[PassRegistry] Error: pipeline not validated before run_until\n");
            return false;
        }

        const until_int: u32 = until.to_int();

        for (mut i: int = 0; i < this.passes.length; i++) {
            const id: PassID = this.passes[i];
            const meta: PassMetadata = id.metadata();

            // Stop after the target stage
            if (meta.stage.to_int() > until_int) {
                break;
            }

            if (this.verbose) {
                cdebug("[Pass %d] %s (%s)\n", i + 1, meta.name, meta.stage.label());
            }

            const snap: DiagnosticSnapshot = ctx->diagnostics.snapshot();
            const result: PassResult = PassRegistry::run_pass(id, ctx);

            this.stats[i].executed = true;
            this.stats[i].success = result.success;
            this.stats[i].skipped = result.skipped;
            this.stats[i].errors_emitted = result.errors_emitted;
            this.stats[i].warnings_emitted = result.warnings_emitted;

            if (result.skipped && this.verbose) {
                cdebug("[Pass %d] %s SKIPPED (stub, not yet implemented)\n",
                    i + 1, meta.name);
            }

            if (!result.success && id.fatal_on_failure()) {
                return false;
            }

            // Derive provisions from metadata, not from PassResult
            if (result.success) {
                for (mut j: int = 0; j < meta.provisions.length; j++) {
                    ctx->provisions.mark(meta.provisions[j]);
                }
            }
        }

        return !ctx->diagnostics.has_errors();
    }

    /// Reset stats for the next module in a batch.
    /// Provisions are tracked on CompilationContext and reset via
    /// CompilationContext::reset_for_next_module().
    reset(mut &this) -> void {
        for (mut i: int = 0; i < this.stats.length; i++) {
            this.stats[i] = PassStats::new(this.passes[i]);
        }
    }

    // -- Pipeline builders (static) --
    // These are static methods so they can be resolved cross-module via
    // PassRegistry::build_*().  Cross-module resolution of free functions
    // through imported namespaces is historically brittle at codegen time;
    // static methods resolve reliably.

    /// Full compilation pipeline: lex -> parse -> analyze -> codegen -> link.
    static build_standard_pipeline() -> PassRegistry {
        LOG_DEBUG(LogComponent::General, "[PassRegistry] Building standard pipeline");
        mut reg: PassRegistry = PassRegistry::new();
        reg.set_passes([
            PassID::Lexing,
            PassID::Parsing,
            PassID::ConfigGating,
            PassID::ASTValidation,
            PassID::CHeaderImport,
            PassID::AutoImport,
            PassID::ImportResolution,
            PassID::NameResolution,
            PassID::TypeDeclaration,
            PassID::FunctionSignature,
            PassID::TemplateRegistration,
            PassID::DefaultExpansion,
            PassID::TypeResolution,
            PassID::StructFieldTypeSync,
            PassID::DirectiveProcessing,
            PassID::FunctionBodyTypeCheck,
            PassID::Monomorphization,
            PassID::GenericExpressionResolution,
            PassID::GenericValidation,
            PassID::MoveCheck,
            PassID::DropInsertion,
            PassID::TypeLowering,
            PassID::IRGeneration,
            PassID::Optimization,
            PassID::ObjectEmission,
            PassID::Linking,
        ]);
        return reg;
    }

    /// Frontend-only pipeline for LSP: lex -> parse -> specialize -> analyze (no codegen).
    static build_frontend_pipeline() -> PassRegistry {
        mut reg: PassRegistry = PassRegistry::new();
        reg.set_passes([
            PassID::Lexing,
            PassID::Parsing,
            PassID::ConfigGating,
            PassID::ASTValidation,
            PassID::CHeaderImport,
            PassID::AutoImport,
            PassID::ImportResolution,
            PassID::NameResolution,
            PassID::TypeDeclaration,
            PassID::FunctionSignature,
            PassID::TemplateRegistration,
            PassID::DefaultExpansion,
            PassID::TypeResolution,
            PassID::StructFieldTypeSync,
            PassID::DirectiveProcessing,
            PassID::FunctionBodyTypeCheck,
            PassID::Monomorphization,
            PassID::GenericExpressionResolution,
            PassID::GenericValidation,
            PassID::MoveCheck,
            PassID::DropInsertion,
            PassID::TypeLowering,
        ]);
        return reg;
    }

    /// Raw pipeline: no auto-imports or module resolution.
    static build_raw_pipeline() -> PassRegistry {
        mut reg: PassRegistry = PassRegistry::new();
        reg.set_passes([
            PassID::Lexing,
            PassID::Parsing,
            PassID::ConfigGating,
            PassID::ASTValidation,
            PassID::CHeaderImport,
            PassID::NameResolution,
            PassID::TypeDeclaration,
            PassID::FunctionSignature,
            PassID::TemplateRegistration,
            PassID::DefaultExpansion,
            PassID::TypeResolution,
            PassID::StructFieldTypeSync,
            PassID::DirectiveProcessing,
            PassID::FunctionBodyTypeCheck,
            PassID::Monomorphization,
            PassID::GenericExpressionResolution,
            PassID::GenericValidation,
            PassID::MoveCheck,
            PassID::DropInsertion,
            PassID::TypeLowering,
            PassID::IRGeneration,
            PassID::Optimization,
            PassID::ObjectEmission,
            PassID::Linking,
        ]);
        return reg;
    }



    // run_pass: Central dispatch function

    /// Dispatches to the pass implementation for the given PassID.
    /// Pass implementations are inlined here to avoid cross-namespace
    /// free function resolution issues.  As the compiler matures, these
    /// can be refactored into separate modules.
    static run_pass(id: PassID, ctx: CompilationContext*) -> PassResult {
        const meta: PassMetadata = id.metadata();

        return match (id) {
            PassID::Lexing => {
                PassRegistry::run_lexing_pass(ctx)
            }
            PassID::Parsing => {
                PassRegistry::run_parsing_pass(ctx)
            }
            PassID::ConfigGating => {
                ConfigGatingPasses::run(ctx)
            }
            PassID::ASTValidation => {
                PassRegistry::run_ast_validation_pass(ctx)
            }
            PassID::CHeaderImport => {
                Importer::run(ctx)
            }
            PassID::NameResolution => {
                NameResolutionPass::run(ctx)
            }
            PassID::TypeDeclaration => {
                PassRegistry::run_type_declaration_pass(ctx)
            }
            PassID::FunctionSignature => {
                TypeResolutionPasses::run_function_signature(ctx)
            }
            PassID::TemplateRegistration => {
                SpecializationPasses::run_template_registration(ctx)
            }
            PassID::DefaultExpansion => {
                DefaultExpansionPasses::run(ctx)
            }
            PassID::TypeResolution => {
                TypeResolutionPasses::run_type_resolution(ctx)
            }
            PassID::StructFieldTypeSync => {
                TypeResolutionPasses::run_struct_field_sync(ctx)
            }
            PassID::DirectiveProcessing => {
                DirectiveProcessingPasses::run_directive_processing(ctx)
            }
            PassID::Monomorphization => {
                SpecializationPasses::run_monomorphization(ctx)
            }
            PassID::GenericExpressionResolution => {
                SpecializationPasses::run_generic_expression_resolution(ctx)
            }
            PassID::GenericValidation => {
                SpecializationPasses::run_generic_validation(ctx)
            }
            PassID::FunctionBodyTypeCheck => {
                SemanticPasses::run_sema(ctx)
            }
            PassID::MoveCheck => {
                MoveCheckPass::run(ctx)
            }
            PassID::DropInsertion => {
                DropInsertionPass::run(ctx)
            }
            PassID::TypeLowering => {
                TypeLoweringPasses::run(ctx)
            }
            PassID::AutoImport => {
                PassRegistry::run_auto_import_pass(ctx)
            }
            PassID::ImportResolution => {
                PassRegistry::run_import_resolution_pass(ctx)
            }
            PassID::IRGeneration => {
                CodegenPasses::run_ir_generation(ctx)
            }
            PassID::Optimization => {
                CodegenPasses::run_optimization(ctx)
            }
            PassID::ObjectEmission => {
                CodegenPasses::run_object_emission(ctx)
            }
            PassID::Linking => {
                CodegenPasses::run_linking(ctx)
            }
            _ => {
                cdebug("[Pipeline] STUB: %s (not yet implemented)\n", meta.name);
                PassResult::stub()
            }
        };
    }

    // Pipeline builders are static methods on PassRegistry so they can be
    // resolved cross-module via PassRegistry::build_*().  See the note on the
    // static-method/free-function distinction near the top of this file.


    // Lexing Pass

    /// Reads the source file and tokenizes it.  Populates ctx.artifacts.tokens.
    static run_lexing_pass(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();
        const source_path: string = ctx.source_file;

        if (ctx.debug_mode) {
            cdebug("[Lexing] Tokenizing: %s\n", source_path);
        }

        // LSP in-memory mode.  Two sources of in-memory content:
        //
        //   (a) Single-file LSP entry (`compile_for_lsp_content_into`)
        //       pre-populates `ctx.artifacts.tokens.source_content` for the
        //       one file it knows about.  Used by tooling that drives the
        //       compiler against a single buffer with no project context.
        //
        //   (b) Multi-module LSP entry (`compile_for_lsp_project_into`)
        //       sets `ctx.lsp_override_path` and `ctx.lsp_override_content`
        //       so the orchestrator can keep iterating every module from
        //       disk while the ONE module the user is editing reads from
        //       the editor buffer instead.  This is the path that gives
        //       the LSP cross-file type info: every sibling module is
        //       parsed and analysed normally, only the active buffer is
        //       overridden.
        //
        // In-memory content (LSP override / single-buffer entry) is fed to
        // the lexer verbatim; otherwise the source is read from disk and
        // leaked as a NUL-terminated `string` (via `into_raw`) so token
        // lexemes pointing into it stay valid for the rest of compilation.
        mut inmem_content: string = "";
        if (libc::strlen(ctx.lsp_override_path) > 0
                && ctx.lsp_override_path.eq(source_path)) {
            inmem_content = ctx.lsp_override_content;
        } else if (ctx.artifacts.tokens.source_content != "") {
            inmem_content = ctx.artifacts.tokens.source_content;
        }
        const inmem_mode: boolean =
            (inmem_content != "" && libc::strlen(inmem_content) > 0 as u64);

        mut source: string = "";
        if (inmem_mode) {
            source = inmem_content;
        } else {
            if (!metadata::exists(Path::from_cstr(source_path))) {
                ctx.emit_error(ErrorCode::E0800_FILE_NOT_FOUND,
                    format("Source file not found: %s", source_path));
                return PassResult::failure(1);
            }
            match (file::read_to_string(Path::from_cstr(source_path))) {
                Result::Ok(s)  => { source = s.into_raw(); }
                Result::Err(_) => {
                    ctx.emit_error(ErrorCode::E0801_FILE_READ_ERROR,
                        format("Could not read source file: %s", source_path));
                    return PassResult::failure(1);
                }
            }
        }
        const lexer: Lexer    = Lexer::new(source_path, source, ctx.diagnostics);
        const tokens: Token[] = lexer.lex();

        if (tokens.length == 0) {
            ctx.emit_error(ErrorCode::E0011_LEXING_EXCEPTION, format("Lexer produced no tokens for: %s", source_path));
            return PassResult::failure(1);
        }

        // Filter out error tokens and plain comments so the parser doesn't see them.
        // Diagnostics were already emitted by the Lexer via the DiagnosticSink.
        // Doc comments (DocCommentLine, DocCommentBlock) are kept for the parser
        // to collect as documentation on declarations.
        // Also merge adjacent string literals ("foo" "bar" -> "foobar") like C.
        mut clean_tokens: Token[] = [];
        mut had_errors: boolean = false;
        mut had_comments: boolean = false;
        for (mut i: int = 0; i < tokens.length; i++) {
            if (tokens[i].kind == TokenType::Unknown) {
                had_errors = true;
            } else if (tokens[i].kind == TokenType::Comment) {
                had_comments = true;
            } else {
                clean_tokens.push(tokens[i]);
            }
        }

        // Merge adjacent string literals: "abc" "def" -> "abcdef" (C-style).
        // The lexer strips quotes from string lexemes, so concatenation
        // is just `combined + next`; no quote-stripping dance required.
        // Only wrap into a fresh Token when there's an actual merge;
        // singleton strings flow through unchanged so the lexer's
        // `source_length` (which tracks the original source extent
        // including quotes and escape digraphs) survives the pass.
        mut merged_tokens: Token[] = [];
        {
            mut j: int = 0;
            while (j < clean_tokens.length) {
                if (clean_tokens[j].kind == TokenType::StringLiteral
                    && j + 1 < clean_tokens.length
                    && clean_tokens[j + 1].kind == TokenType::StringLiteral) {
                    mut combined: string = clean_tokens[j].lexeme;
                    const start_line:    int = clean_tokens[j].line;
                    const start_col:     int = clean_tokens[j].column;
                    mut total_src_extent: int = clean_tokens[j].source_length;
                    while (j + 1 < clean_tokens.length &&
                           clean_tokens[j + 1].kind == TokenType::StringLiteral) {
                        j += 1;
                        const next: string = clean_tokens[j].lexeme;
                        const clen: i64 = libc::strlen(combined) as i64;
                        const nlen: i64 = libc::strlen(next) as i64;
                        const buf_size: i64 = clen + nlen + 1;
                        const buf: i8* = intrinsics::malloc(buf_size as u64) as i8*;
                        intrinsics::memcpy(buf as void*, combined as void*, clen as u64);
                        intrinsics::memcpy(intrinsics::ptr_add(buf as void*, clen) as void*,
                               next as void*, nlen as u64);
                        const term: i8* = intrinsics::ptr_add(buf as void*, clen + nlen) as i8*;
                        *term = 0 as i8;
                        combined = buf as string;
                        total_src_extent += clean_tokens[j].source_length;
                    }
                    const merged: Token = Token {
                        kind:          TokenType::StringLiteral,
                        lexeme:        combined,
                        line:          start_line,
                        column:        start_col,
                        source_length: total_src_extent,
                    };
                    merged_tokens.push(merged);
                } else {
                    merged_tokens.push(clean_tokens[j]);
                }
                j += 1;
            }
        }

        const had_merges: boolean = merged_tokens.length < clean_tokens.length;
        const needs_filter: boolean = had_errors || had_comments || had_merges;

        // Copy the chosen token list into an independently-owned buffer for the
        // TokenStream.  Selecting a local via an if-expression and storing it
        // would only ALIAS that local's buffer; the locals (`tokens`,
        // `clean_tokens`, `merged_tokens`) are then dropped at pass exit, which
        // would free the buffer the context now references.  Token is Copy, so
        // this is a shallow element-wise duplication; the locals drop cleanly,
        // each freeing its own distinct buffer exactly once.
        mut final_tokens: Token[] = [];
        if (needs_filter) {
            for (mut fi: int = 0; fi < merged_tokens.length; fi++) {
                final_tokens.push(merged_tokens[fi]);
            }
        } else {
            for (mut fi: int = 0; fi < tokens.length; fi++) {
                final_tokens.push(tokens[fi]);
            }
        }

        // Store results in artifacts
        ctx.artifacts.tokens = TokenStream::new(final_tokens, source_path, "");
        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }

    // Parsing Pass

    /// Parses the token stream into an AST.
    static run_parsing_pass(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        if (ctx.debug_mode) {
            cdebug("[Parsing] Parsing: %s\n", ctx.source_file);
        }

        // Verify we have tokens
        if (!ctx.artifacts.tokens.is_valid()) {
            ctx.emit_error(ErrorCode::E0116_PARSE_EXCEPTION,
                "no tokens available for parsing (lexing pass may have failed)");
            return PassResult::failure(1);
        }

        // Create parser and parse
        mut parser: Parser = Parser::from_context(ctx);
        const root: ProgramNode* = parser.parse();

        if (root == null) {
            ctx.emit_error(ErrorCode::E0116_PARSE_EXCEPTION,
                "parser produced null AST root");
            return PassResult::failure(1);
        }

        // Store the result in artifacts
        ctx.artifacts.ast = ASTOutput {
            root:           root,
            namespace_name: root.namespace_name,
        };

        LOG_DEBUG(LogComponent::Parser, "[Parsing] store: root=%p, root.kind=%d, stmts=%d",
            root, root.kind as int, root.statements.length);
        LOG_DEBUG(LogComponent::Parser, "[Parsing] readback: ctx.artifacts.ast.root=%p",
            ctx.artifacts.ast.root);

        if (ctx.debug_mode) {
            cdebug("[Parsing] Produced AST with %d top-level statements\n",
                root.statements.length);
        }

        // Parse errors are already recorded in ctx.diagnostics via the DiagnosticSink.
        // PassResult::from_snapshot below will pick them up automatically.

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }


    // AST Validation Pass: delegates to ASTValidationPass::run()

    /// Validates the parsed AST for structural correctness.
    static run_ast_validation_pass(ctx: CompilationContext*) -> PassResult {
        return ASTValidationPass::run(ctx);
    }


    // CHeaderImport pass: see bindgen/importer.cryo (Compiler::Bindgen::Importer)
    // for the libclang-driven implementation.


    // Type Declaration Pass

    /// Initializes the type system (TypeArena, TypeChecker, TypeResolver) and
    /// walks top-level declarations to create Type objects in the arena.
    /// This pass bridges the gap between name resolution and type resolution:
    /// after this pass, every declared struct/enum/class/trait has a TypeRef.
    static run_type_declaration_pass(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        if (ctx.debug_mode) {
            cdebug("[TypeDeclaration] Initializing type system and collecting declarations\n");
        }

        // Initialize the TypeArena and related components
        ctx.init_type_system();

        const arena: TypeArena* = ctx.type_arena;
        if (arena == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "TypeDeclaration: TypeArena was not created by init_type_system()");
            return PassResult::failure(1);
        }

        // Get the AST root
        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            if (ctx.debug_mode) {
                cdebug("[TypeDeclaration] No AST root available, skipping\n");
            }
            return PassResult::ok();
        }

        // Transfer the parsed namespace into the compilation context so that
        // ctx.qualify_symbol() produces fully-qualified names.
        const ns: string = ctx.artifacts.ast.namespace_name;
        if (ns != "") {
            ctx.set_namespace(ns);
        }

        // Determine the module name for qualified type names.
        // Use the raw namespace string directly (ctx.namespace_display() relies on
        // QualifiedName::display() which has a codegen issue with string.append()).
        const ns_raw: string = ctx.artifacts.ast.namespace_name;
        const module_name: string = if (ns_raw != "") { ns_raw } else { ctx.source_file };
        const module_sym: SymbolStr = ctx.intern(module_name);

        // Reject two type declarations that share a qualified name within
        // this module (E0207). Qualified names carry the namespace, so the
        // same bare name in different modules does not collide. Runs as a
        // pre-pass with a module-local seen set.
        mut seen_type_syms: u32[] = [];
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }
            mut tsym: SymbolStr = SymbolStr::empty();
            mut tspan: SourceSpan = SourceSpan::none();
            mut is_type: boolean = false;
            match (stmt.kind) {
                NodeKind::StructDeclaration => {
                    const n: StructDeclNode* = stmt as StructDeclNode*;
                    tsym = ctx.qualify_binding_sym(n.name, n.binding_namespace); tspan = n.span; is_type = true;
                }
                NodeKind::UnionDeclaration => {
                    const n: UnionDeclNode* = stmt as UnionDeclNode*;
                    tsym = ctx.qualify_binding_sym(n.name, n.binding_namespace); tspan = n.span; is_type = true;
                }
                NodeKind::EnumDeclaration => {
                    const n: EnumDeclNode* = stmt as EnumDeclNode*;
                    tsym = ctx.qualify_binding_sym(n.name, n.binding_namespace); tspan = n.span; is_type = true;
                }
                NodeKind::ClassDeclaration => {
                    const n: ClassDeclNode* = stmt as ClassDeclNode*;
                    tsym = ctx.qualify_symbol_sym(n.name); tspan = n.span; is_type = true;
                }
                NodeKind::TraitDeclaration => {
                    const n: TraitDeclNode* = stmt as TraitDeclNode*;
                    tsym = ctx.qualify_symbol_sym(n.name); tspan = n.span; is_type = true;
                }
                NodeKind::TypeAliasDeclaration => {
                    const n: TypeAliasDeclNode* = stmt as TypeAliasDeclNode*;
                    tsym = ctx.qualify_binding_sym(n.alias_name, n.binding_namespace); tspan = n.span; is_type = true;
                }
                _ => {}
            }
            if (!is_type) { continue; }
            mut dup: boolean = false;
            for (mut k: i64 = 0; k < seen_type_syms.length; k++) {
                if (seen_type_syms[k] == tsym.id) { dup = true; break; }
            }
            if (dup) {
                ctx.emit_error_at(ErrorCode::E0207_REDEFINED_TYPE,
                    format("type `%s` is defined multiple times",
                        ctx.resolve_str(tsym)),
                    tspan);
            } else {
                seen_type_syms.push(tsym.id);
            }
        }

        // Walk top-level statements and create types for declarations
        mut type_count: i64 = 0;
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }

            cdebug("[TypeDecl] stmt[%lld] kind=%d\n", i, stmt.kind as i32);
            match (stmt.kind) {
                NodeKind::StructDeclaration => {
                    const node: StructDeclNode* = stmt as StructDeclNode*;
                    const _intern: InternTable* = ctx.get_intern_table();
                    const _dbg: string = _intern.resolve(node.name);
                    cdebug("[TypeDecl]   -> Struct '%s'\n", _dbg);
                    const qualified_sym: SymbolStr = ctx.qualify_binding_sym(node.name, node.binding_namespace);
                    const struct_module_sym: SymbolStr = if (!node.binding_namespace.is_empty()) { node.binding_namespace } else { module_sym };
                    arena.create_struct(qualified_sym, struct_module_sym);
                    // A C-imported type (binding_namespace set) is reachable
                    // ONLY via its alias (`cit::Vec2`); registering its bare
                    // name globally would pollute the namespace and shadow
                    // same-named types in other modules.
                    if (!qualified_sym.equals(node.name) && node.binding_namespace.is_empty()) {
                        ctx.decl_index.register_name_mapping(node.name, qualified_sym);
                    }
                    type_count++;
                }
                NodeKind::UnionDeclaration => {
                    const node: UnionDeclNode* = stmt as UnionDeclNode*;
                    const _internu: InternTable* = ctx.get_intern_table();
                    const _dbgu: string = _internu.resolve(node.name);
                    cdebug("[TypeDecl]   -> Union '%s'\n", _dbgu);
                    const qualified_sym: SymbolStr = ctx.qualify_binding_sym(node.name, node.binding_namespace);
                    const union_module_sym: SymbolStr = if (!node.binding_namespace.is_empty()) { node.binding_namespace } else { module_sym };
                    arena.create_union(qualified_sym, union_module_sym);
                    if (!qualified_sym.equals(node.name) && node.binding_namespace.is_empty()) {
                        ctx.decl_index.register_name_mapping(node.name, qualified_sym);
                    }
                    type_count++;
                }
                NodeKind::EnumDeclaration => {
                    const node: EnumDeclNode* = stmt as EnumDeclNode*;
                    const _intern2: InternTable* = ctx.get_intern_table();
                    const _dbg2: string = _intern2.resolve(node.name);
                    cdebug("[TypeDecl]   -> Enum '%s'\n", _dbg2);
                    const qualified_sym: SymbolStr = ctx.qualify_binding_sym(node.name, node.binding_namespace);
                    const enum_module_sym: SymbolStr = if (!node.binding_namespace.is_empty()) { node.binding_namespace } else { module_sym };
                    arena.create_enum(qualified_sym, enum_module_sym);
                    if (!qualified_sym.equals(node.name) && node.binding_namespace.is_empty()) {
                        ctx.decl_index.register_name_mapping(node.name, qualified_sym);
                    }
                    type_count++;
                }
                NodeKind::ClassDeclaration => {
                    const node: ClassDeclNode* = stmt as ClassDeclNode*;
                    const qualified_sym: SymbolStr = ctx.qualify_symbol_sym(node.name);
                    arena.create_class(qualified_sym, module_sym);
                    if (!qualified_sym.equals(node.name)) {
                        ctx.decl_index.register_name_mapping(node.name, qualified_sym);
                    }
                    type_count++;
                }
                NodeKind::TraitDeclaration => {
                    const node: TraitDeclNode* = stmt as TraitDeclNode*;
                    const qualified_sym: SymbolStr = ctx.qualify_symbol_sym(node.name);
                    arena.create_trait(qualified_sym, module_sym);
                    if (!qualified_sym.equals(node.name)) {
                        ctx.decl_index.register_name_mapping(node.name, qualified_sym);
                    }
                    type_count++;
                }
                NodeKind::TypeAliasDeclaration => {
                    const node: TypeAliasDeclNode* = stmt as TypeAliasDeclNode*;
                    const qualified_alias: SymbolStr = ctx.qualify_binding_sym(node.alias_name, node.binding_namespace);
                    // Use qualified name (consistent with struct/enum/class/trait);
                    // target resolved in TypeResolution pass
                    const alias_ref: TypeRef = arena.create_type_alias(qualified_alias, TypeRef::invalid());
                    // Mark generic aliases so the arena dump can distinguish
                    // "unresolved because generic template" from "unresolved because broken"
                    if (node.is_generic()) {
                        const alias_ty: Type* = arena.lookup(alias_ref.id);
                        if (alias_ty != null && alias_ty.kind == TypeKind::TypeAlias) {
                            const alias_obj: TypeAliasType* = alias_ty as TypeAliasType*;
                            alias_obj.is_generic = true;
                        }
                    }
                    // Register in DeclarationIndex so resolve_named() can find
                    // aliases by qualified name during TypeResolution Phase 3
                    // (before Phase 4 populates the index for other types).
                    ctx.decl_index.register_type(qualified_alias, alias_ref);
                    // Bare-name registration only for file-namespaced aliases;
                    // a C-imported typedef (binding_namespace set) stays
                    // qualified-only (`cit::Celsius`) to avoid polluting the
                    // global bare-name space.
                    if (node.binding_namespace.is_empty()) {
                        ctx.decl_index.register_type(node.alias_name, alias_ref);
                    }
                    type_count++;
                }
                _ => {
                    // Functions, variables, imports, etc. don't create Type objects here
                }
            }
        }

        // Register primitive types in the DeclarationIndex so that
        // lookup_type_by_sym() can find them for `implement boolean { ... }` etc.
        // Primitives are arena singletons; use direct getters, not lookup_by_name.
        // Each type is registered under both the bare name ("i32") and the
        // qualified name ("std::core::primitives::i32") so that codegen's
        // declare_method / codegen_method_prologue can resolve the target type
        // after qualify_symbol_sym prepends the namespace.
        ctx.decl_index.register_type(ctx.intern("void"),    arena.get_void());
        // Unit type `()`, registered under its display name so trait
        // impls (`implement trait Drop for () { ... }`) resolve through the
        // same canonical-target path as the other primitives.  Without
        // this, TypeResolution falls through to `qualify_symbol_sym` and
        // over-qualifies the impl with the impl-body's defining namespace
        // (e.g. `std::core::drop::()`), producing a mangled name the call
        // site can't reconstruct from a bare receiver.
        ctx.decl_index.register_type(ctx.intern("()"),      arena.get_unit());
        ctx.decl_index.register_type(ctx.intern("boolean"), arena.get_bool());
        ctx.decl_index.register_type(ctx.intern("char"),    arena.get_char());
        ctx.decl_index.register_type(ctx.intern("string"),  arena.get_string());
        ctx.decl_index.register_type(ctx.intern("i8"),      arena.get_i8());
        ctx.decl_index.register_type(ctx.intern("i16"),     arena.get_i16());
        ctx.decl_index.register_type(ctx.intern("i32"),     arena.get_i32());
        ctx.decl_index.register_type(ctx.intern("i64"),     arena.get_i64());
        ctx.decl_index.register_type(ctx.intern("i128"),    arena.get_i128());
        ctx.decl_index.register_type(ctx.intern("u8"),      arena.get_u8());
        ctx.decl_index.register_type(ctx.intern("u16"),     arena.get_u16());
        ctx.decl_index.register_type(ctx.intern("u32"),     arena.get_u32());
        ctx.decl_index.register_type(ctx.intern("u64"),     arena.get_u64());
        ctx.decl_index.register_type(ctx.intern("u128"),    arena.get_u128());
        ctx.decl_index.register_type(ctx.intern("isize"),   arena.get_isize());
        ctx.decl_index.register_type(ctx.intern("usize"),   arena.get_usize());
        ctx.decl_index.register_type(ctx.intern("f32"),     arena.get_f32());
        ctx.decl_index.register_type(ctx.intern("f64"),     arena.get_f64());
        // Aliases: forward-only so they don't overwrite the reverse map.
        // This ensures lookup_type_name(f64_ref) returns "f64", not "double".
        ctx.decl_index.register_type_forward_only(ctx.intern("int"),     arena.get_i32());
        ctx.decl_index.register_type_forward_only(ctx.intern("uint"),    arena.get_u32());
        ctx.decl_index.register_type_forward_only(ctx.intern("float"),   arena.get_f64());
        ctx.decl_index.register_type_forward_only(ctx.intern("double"),  arena.get_f64());

        if (ctx.debug_mode) {
            cdebug("[TypeDeclaration] Created %lld type declarations (%lld total types in arena)\n",
                type_count, arena.type_count());
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }


    // DirectiveProcessing: see compiler/passes/directive_processing.cryo.


    // AutoImport Pass

    /// Injects synthetic import declarations (prelude, stdlib) into the AST
    /// based on the compilation mode and project configuration.
    static run_auto_import_pass(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        // No auto-imports in modes that disable them (Raw, StdlibBatch)
        if (!ctx.mode.auto_imports_enabled()) {
            if (ctx.debug_mode) {
                cdebug("[AutoImport] Skipped: auto-imports disabled for mode '%s'\n",
                    ctx.mode.label());
            }
            return PassResult::ok();
        }

        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            return PassResult::ok();
        }

        // Check no_std from project config (stored on context)
        // If no_std is true, skip prelude injection
        if (ctx.project_no_std) {
            if (ctx.debug_mode) {
                cdebug("[AutoImport] Skipped: no_std is set\n");
            }
            return PassResult::ok();
        }

        // Skip if the current file is itself part of the stdlib (namespace starts
        // with "std::").  This prevents circular imports when compiling the prelude
        // or any module the prelude re-exports.  StdlibBatch mode already returns
        // early above via auto_imports_enabled(), but this guards single-file and
        // multi-module compilations of stdlib sources.
        const ns: string = root.namespace_name;
        if (libc::strlen(ns) >= 5 && libc::strncmp(ns, "std::", 5) == 0) {
            if (ctx.debug_mode) {
                cdebug("[AutoImport] Skipped: stdlib module '%s'\n", ns);
            }
            return PassResult::ok();
        }

        // Inject the f-string runtime import for any module that used an
        // f-string (`f"..."`).  The parser desugars each into nested
        // `fmt_new`/`fmt_append_*` calls (see std::fmt::interp); this brings
        // those names into scope.  Done here rather than via the prelude so the
        // formatter's transitive deps (ffi::libc etc.) don't pollute every
        // module.  Placed before the explicit-`import std::prelude` short-circuit
        // below so it still fires when the user imported the prelude themselves.
        // A same-module re-import (if the user also wrote it) is silently
        // de-duplicated during name resolution.
        if (root.uses_fstring) {
            const interp_import: ImportDeclNode* = new ImportDeclNode(
                "std::fmt::interp", ImportStyle::Wildcard, SourceSpan::none());
            mut with_interp: ASTNode*[] = [];
            with_interp.push(interp_import as ASTNode*);
            for (mut fi: i64 = 0; fi < root.statements.length; fi++) {
                with_interp.push(root.statements[fi]);
            }
            root.statements = with_interp;
            if (ctx.debug_mode) {
                cdebug("[AutoImport] Injected 'import std::fmt::interp' (f-string used)\n");
            }
        }

        // Check whether the user already has an explicit `import std::prelude`.
        // If so, skip injection to avoid a duplicate import.
        const prelude_path: string = "std::prelude";
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt != null && stmt.kind == NodeKind::ImportDeclaration) {
                const imp: ImportDeclNode* = stmt as ImportDeclNode*;
                if (imp.module_path.eq(prelude_path)) {
                    if (ctx.debug_mode) {
                        cdebug("[AutoImport] Skipped: explicit 'import std::prelude' already present\n");
                    }
                    return PassResult::ok();
                }
            }
        }

        // Inject a synthetic `import std::prelude;` (wildcard) as the first statement.
        const prelude_import: ImportDeclNode* = new ImportDeclNode(
            prelude_path, ImportStyle::Wildcard, SourceSpan::none());

        // Build a new statement list with the prelude import at position 0.
        const old_len: i64 = root.statements.length;
        mut new_stmts: ASTNode*[] = [];
        new_stmts.push(prelude_import as ASTNode*);
        for (mut i: i64 = 0; i < old_len; i++) {
            new_stmts.push(root.statements[i]);
        }
        root.statements = new_stmts;

        if (ctx.debug_mode) {
            cdebug("[AutoImport] Injected 'import std::prelude' (%lld statements total)\n",
                root.statements.length);
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }


    // ImportResolution Pass

    /// Validates that all import declarations in the current module reference
    /// known modules in the ModuleGraph.  In whole-program multi-module mode,
    /// module discovery has already happened, so this pass is a validation step.
    /// For single-file mode, imports are not expected (unless auto-imported).
    static run_import_resolution_pass(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            return PassResult::ok();
        }

        mut import_count: i64 = 0;
        mut error_count: i64 = 0;

        // Single-file mode (e.g. `cryo check <file>`) never runs project
        // discovery, so imports were not verified against disk. Build a loader
        // off the file's directory + stdlib root to resolve them here; an
        // unresolvable import is E0500, matching what a project build reports.
        // Project builds (graph already populated) skip this - discovery owns
        // E0500 there.
        const graph: ModuleGraph* = ctx.module_graph;
        const single_file_mode: boolean = graph.module_count() == 0;
        mut sf_loader: ModuleLoader = ModuleLoader::new(
            "", ctx.source_file, ctx.stdlib_root, ctx.project_no_std, []);

        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }
            if (stmt.kind != NodeKind::ImportDeclaration) { continue; }

            const import_node: ImportDeclNode* = stmt as ImportDeclNode*;
            const module_path: string = import_node.module_path;
            import_count += 1;

            if (ctx.debug_mode) {
                cdebug("[ImportResolution] Validating import: '%s'\n", module_path);
            }

            // Only verify imports the user actually wrote. Compiler-injected
            // imports (e.g. the synthetic `std::prelude`) carry no source
            // location and are trusted; blaming the user for them - or for a
            // virtual module with no backing file - would be wrong.
            if (single_file_mode && import_node.span.has_location()) {
                const resolved: string = sf_loader.resolve_import_path(module_path);
                if (strlen(resolved) == 0) {
                    ctx.emit_error_at(ErrorCode::E0500_MODULE_NOT_FOUND,
                        format("module '%s' not found", module_path),
                        import_node.span);
                    error_count += 1;
                }
            } else if (graph.module_count() > 0) {
                const mod_sym: SymbolStr = ctx.intern(module_path);
                const mod_idx: i64 = graph.find_module_index(mod_sym);
                if (mod_idx < 0) {
                    // Try namespace-based lookup (import path might match namespace, not module name)
                    // This is valid: the module was already discovered, its symbols will be
                    // resolved by NameResolution via the Resolver's export system.
                    if (ctx.debug_mode) {
                        cdebug("[ImportResolution] Module '%s' not in graph by name, "
                               "will rely on namespace-based resolution\n", module_path);
                    }
                }
            }
        }

        if (ctx.debug_mode) {
            cdebug("[ImportResolution] Validated %lld imports (%lld errors)\n",
                import_count, error_count);
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }

}
