/// Semantic Analysis Passes
///
///   FunctionBodyTypeCheck (order 14): walks all function bodies and fills
///   resolved_type on every ExpressionNode.  Uses the TypeChecker for
///   operator validation and the TypeArena for type lookups.
///
///   This pass runs AFTER Specialization (Monomorphization + GenericExpressionResolution),
///   meaning all generic types have been fully instantiated and their specialized
///   ASTs injected into the program.  Sema checks both original non-generic bodies
///   and monomorphized concrete bodies in a single pass.  Generic templates are
///   skipped (is_generic() guard); only their specialized versions are checked.
///   By the time codegen runs, every expression node will have a concrete
///   resolved_type, so no type inference is needed in the backend.

namespace Compiler::Passes::Sema;

import Compiler::Diag;
import Compiler::Diag::Diagnostic;
import Compiler::Diag::Suggestion;
import Compiler::Diag::SourceSpan;
import Compiler::Diag::EditDistance;
import std::core::option;
import Compiler::Diag::Snapshot;
import Compiler::DeclIndex;
import Compiler::AST;
import Compiler::AST::Node;
import Compiler::AST::Expression;
import Compiler::AST::Statement;
import Compiler::AST::Declaration;
import Compiler::AST::Pattern;
import Compiler::AST::Visitor;
import Compiler::AST::NodeLocator;
import Compiler::Passes::PassID;
import Compiler::CompilationContext;
import Compiler::Lex;
import Compiler::Types;
import Compiler::Types::TypeRef;
import Compiler::Types::Type;
import Compiler::Types::UserDefined;
import Compiler::Types::Compound;
import Compiler::Types::Generic;
import Compiler::Types::Arena;
import Compiler::Types::Checker;
import Compiler::Types::Ownership;
import Compiler::Resolver::SymbolStr;
import Compiler::Resolver::InternTable;
import Compiler::Resolver::QualifiedName;
import Compiler::Resolver::MangledName;
import Compiler::Resolver::Resolver;
import Compiler::Types::Resolver;
import Compiler::Types::GenericRegistry;
import Compiler::Types::Substitution;
import Compiler::ModuleGraph;
import std::collections::hashmap;
import std::core::slice;
import Utils::Logger;


// Monotonic counter for the synthetic bindings introduced when lowering the
// `?` operator to a `match` (`resolve_try_expr`).  Match-arm bindings are
// arm-scoped so a fixed name would already be collision-free, but a unique
// suffix keeps nested `?` readable in AST dumps and the LSP.
mut g_try_counter: u32 = 0;


// TypeCheckVisitor: visitor-based function body type checker

/// Walks all function bodies, filling resolved_type on every ExpressionNode.
/// Queries the shared DeclarationIndex (populated by TypeResolution and
/// Specialization passes) for O(1) declaration lookups.  Only per-function
/// state (locals, scope undo log) lives on the visitor itself.
type class TypeCheckVisitor : BaseASTVisitor {
public:

    // -- Shared environment --
    arena:    TypeArena*;
    checker:  TypeChecker;
    intern:   InternTable*;
    ctx:      CompilationContext*;

    // -- Per-function state (reset via enter_function for each body) --
    locals:      HashMap<u32, TypeRef>;    // local variable scope (fast path)
    local_muts:  HashMap<u32, boolean>;    // mutability flag for each local
    // Span of the declaring `const`/`mut` keyword (for top-level locals)
    // or a zero-width insertion anchor (for params declared without
    // `mut`).  E0218 reads this to emit a precise "replace `const` with
    // `mut`" or "insert `mut`" quickfix.  Missing entry = no precise
    // anchor available; E0218 falls back to the explanatory note only.
    local_kw_spans: HashMap<u32, SourceSpan>;
    undo_keys:   u32[];                    // scope undo log: keys modified
    undo_prev:   TypeRef[];                // scope undo log: previous values
    undo_muts:   boolean[];                // scope undo log: previous mut flags
    undo_kw_spans: SourceSpan[];           // scope undo log: previous kw_spans
    return_type: TypeRef;                  // current function return type
    return_type_ann: TypeAnnotation*;      // current function return-type annotation (for secondary spans)
    this_type:   TypeRef;                  // current method receiver type
    this_sym:    SymbolStr;                // interned "this"
    this_is_mut: boolean;                  // method has `mut &this`
    // Type whose method body we're currently inside, regardless of static-ness.
    // For non-static methods this matches `this_type`; for static methods
    // `this_type` is invalid but `current_owner_type` still names the owner so
    // visibility checks can recognize `Foo::static_method` as "inside Foo".
    // Invalid outside any method body.
    current_owner_type: TypeRef;
    body_count:  i64;                      // counter for debug output

    // -- Loop/switch nesting (for break/continue validation) --
    // `break` is legal inside any loop or switch; `continue` only inside a
    // loop. Tracked as depths so nested constructs restore correctly.
    loop_depth:   i32;
    switch_depth: i32;

    // -- Expected type hint (set by DeclStmt for initializer resolution) --
    expected_type: TypeRef;

    // -- Match-arm payload binding names (by intern id), per function. --
    // A `match` arm pattern like `Variant(p)` binds `p` to a *temporary*
    // copy of the matched value's payload (codegen alloca's the subject),
    // so returning a pointer/reference to `p` dangles once the function
    // returns.  These ids let `visit(ReturnStmtNode)` reject that escape
    // (E0455) at compile time instead of miscompiling into a use-after-free.
    payload_binding_ids: u32[];

    // Names of the current function's parameters (and `this`).  These are
    // autoref'd / caller-backed, so `&param` is a re-borrow of caller
    // storage, NOT a stack-slot escape - `check_return_stack_address` uses
    // this to flag only `&<body-local>` returns.
    param_ids: u32[];

    // Closure-capture detection state, mutated only by `resolve_lambda`
    // and consulted by `resolve_identifier`.
    //
    // `in_lambda_depth` is the nesting level: 0 outside any lambda body,
    // 1 inside the outermost lambda, deeper for nested lambdas.  It gates
    // the capture-fallback path in `resolve_identifier` (so calls outside
    // lambdas never pay).
    //
    // `lambda_outer_locals` holds names visible from *outside* the lambda
    // currently being type-checked - the union of the enclosing function's
    // locals and any further-out lambda's already-captured names.  When
    // `resolve_identifier` misses the per-lambda `locals` map and we're
    // inside a lambda, it consults this map: a hit means "this is a
    // free variable, record it as a capture on `current_lambda`."
    //
    // `current_lambda` is the LambdaExprNode whose body we're currently
    // walking - the destination for `add_capture` calls.  Null outside
    // any lambda body.
    in_lambda_depth:     i32;
    lambda_outer_locals: HashMap<u32, TypeRef>;
    current_lambda:      LambdaExprNode*;

    // Per-module monotonic counter for synthesised closure-struct names.
    // Cross-module uniqueness comes from the namespace prefix; each
    // visitor instance owns its own counter and never resets it after
    // a closure has been minted.  Codegen has its own `lambda_counter`
    // for non-capturing lambdas; we deliberately keep these separate
    // (Sema synthesises only when captures are present, codegen mints
    // for every lambda) so the namespaces don't have to coordinate.
    closure_counter: u64;

    // Phase 5 cache: dedup closure-arg specialisations of free-function
    // calls.  Key is `<orig_name_id>|<idx>:<closure_ty_id>...`; value is
    // the SymbolStr.id of the spec's mangled LLVM symbol, which goes on
    // `call.resolved_callee` so codegen routes through the spec'd clone.
    // A second call site that passes the same closure-struct type to
    // the same parameter position of the same callee collapses onto the
    // first spec'd clone instead of producing a duplicate.
    closure_spec_map: HashMap<string, u32>;


    TypeCheckVisitor(arena: TypeArena*, intern: InternTable*,
                     ctx: CompilationContext*) : BaseASTVisitor() {
        this.arena          = arena;
        this.checker        = TypeChecker::new(arena);
        this.intern         = intern;
        this.ctx            = ctx;
        this.locals         = HashMap<u32, TypeRef>::new();
        this.local_muts     = HashMap<u32, boolean>::new();
        this.local_kw_spans = HashMap<u32, SourceSpan>::new();
        this.undo_keys      = [];
        this.undo_prev      = [];
        this.undo_muts      = [];
        this.undo_kw_spans  = [];
        this.return_type    = TypeRef::invalid();
        this.return_type_ann = null;
        this.this_type      = TypeRef::invalid();
        this.this_sym       = intern.intern("this");
        this.this_is_mut    = false;
        this.current_owner_type = TypeRef::invalid();
        this.body_count     = 0;
        this.loop_depth     = 0;
        this.switch_depth   = 0;
        this.expected_type  = TypeRef::invalid();
        this.payload_binding_ids = [];
        this.param_ids = [];
        this.in_lambda_depth     = 0;
        this.lambda_outer_locals = HashMap<u32, TypeRef>::new();
        this.current_lambda      = null;
        this.closure_counter     = 0;
        this.closure_spec_map    = HashMap<string, u32>::new();
    }

    /// Build a TypeCheckVisitor from the compilation context.
    /// Declaration lookups are served by ctx.decl_index (the single source
    /// of truth for declaration-level types), so no AST scan is needed here.
    static build(ctx: CompilationContext*) -> TypeCheckVisitor {
        return TypeCheckVisitor(ctx.type_arena, ctx.get_intern_table(), ctx);
    }


    // Lookup Helpers: delegate to ctx.decl_index

    lookup_func_return(&this, name: SymbolStr) -> TypeRef {
        return this.ctx.decl_index.lookup_func_return(name);
    }

    lookup_method_return(&this, type_sym: SymbolStr, method_sym: SymbolStr) -> TypeRef {
        // Try the name as-is first (handles already-qualified names from
        // monomorphized types whose arena qualified name was used directly).
        const bare_ret: TypeRef = this.ctx.decl_index.lookup_method_return(type_sym, method_sym);
        if (bare_ret.is_valid()) { return bare_ret; }
        // Try qualified name (for local/same-module types registered under qualified names)
        const qualified: SymbolStr = this.ctx.qualify_symbol_sym(type_sym);
        if (!qualified.equals(type_sym)) {
            const q_ret: TypeRef = this.ctx.decl_index.lookup_method_return(qualified, method_sym);
            if (q_ret.is_valid()) { return q_ret; }
        }
        // Cross-module fallback: resolve through the Resolver's scope chain
        // to find the type's original module (e.g. "Vec2" -> "Math::Vec2::Vec2").
        const cross_sym: SymbolStr = this.resolve_cross_module_name(type_sym);
        if (cross_sym.is_valid()) {
            return this.ctx.decl_index.lookup_method_return(cross_sym, method_sym);
        }
        return TypeRef::invalid();
    }

    lookup_type_by_sym(&this, name: SymbolStr) -> TypeRef {
        // Try the current module's qualified name FIRST so that module-local
        // types are preferred over bare-name aliases from other modules.
        // E.g., "Pair_i32" in BattleTest resolves to "BattleTest::Pair_i32"
        // rather than a same-named spec from Collections.
        const qualified: SymbolStr = this.ctx.qualify_symbol_sym(name);
        if (!qualified.equals(name)) {
            const q_ty: TypeRef = this.ctx.decl_index.lookup_type(qualified);
            if (q_ty.is_valid()) { return q_ty; }
        }
        // Direct lookup handles already-qualified names from specialized impl
        // blocks whose target_type was rewritten to the arena's qualified name
        // during GenericExpressionResolution, and cross-module bare aliases.
        const direct: TypeRef = this.ctx.decl_index.lookup_type(name);
        if (direct.is_valid()) { return direct; }
        // Cross-module fallback: resolve through scope chain.
        const cross_sym: SymbolStr = this.resolve_cross_module_name(name);
        if (cross_sym.is_valid()) {
            const cross_ty: TypeRef = this.ctx.decl_index.lookup_type(cross_sym);
            if (cross_ty.is_valid()) { return cross_ty; }
        }
        // Arena leaf-index fallback: handles types that are visible via
        // TypeResolver's fallback chain (arena leaf index) but not in the
        // Resolver's scope chain (e.g., FieldInfo from a submodule imported
        // indirectly via a parent _module.cryo `public module` declaration).
        const leaf_ref: TypeRef = this.arena.lookup_by_leaf(name);
        if (leaf_ref.is_valid()) { return leaf_ref; }
        return TypeRef::invalid();
    }

    /// Resolve a bare name to its original module-qualified form by looking
    /// up the symbol in the Resolver's scope chain.  Returns the qualified
    /// name (e.g. "Math::Vec2::Vec2") or empty if not found.
    resolve_cross_module_name(&this, name: SymbolStr) -> SymbolStr {
        const resolver: Resolver* = this.ctx.get_resolver();
        if (resolver == null) { return SymbolStr::empty(); }
        return resolver.resolve_type_qualified_name(name);
    }

    lookup_global_var(&this, name: SymbolStr) -> TypeRef {
        return this.ctx.decl_index.lookup_global(name);
    }

    /// Resolve any `typeof(expr)` inside a type annotation and cache the
    /// operand's static type on the annotation, so the TypeResolver (which
    /// has no expression resolver) can hand it back when it resolves the
    /// annotation moments later.  Recurses through the wrapper kinds a
    /// `typeof` can hide under (`typeof(x)*`, `&typeof(x)`, `typeof(x)[]`,
    /// `typeof(x)?`, `Array<typeof(x)>`, `[typeof(x), ...]`).  Must be called
    /// with the operand in scope - i.e. from sema while visiting the
    /// statement that carries the annotation.  No-op for annotations with no
    /// `typeof`.
    prime_typeof_annotation(mut &this, ann: TypeAnnotation*) -> void {
        if (ann == null) { return; }
        match (ann) {
            TypeAnnotation::Typeof(to) => {
                if (!to.resolved.is_valid() && to.operand != null) {
                    const operand: ExpressionNode* = to.operand as ExpressionNode*;
                    const ty: TypeRef = this.resolve_expr(operand);
                    if (ty.is_valid()) { to.resolved = ty; }
                }
            }
            TypeAnnotation::Pointer(p)   => { this.prime_typeof_annotation(p.inner); }
            TypeAnnotation::Reference(r) => { this.prime_typeof_annotation(r.inner); }
            TypeAnnotation::Array(a)     => { this.prime_typeof_annotation(a.element); }
            TypeAnnotation::Optional(o)  => { this.prime_typeof_annotation(o.inner); }
            TypeAnnotation::Generic(g)   => {
                for (mut i: i64 = 0; i < g.args.length; i++) {
                    this.prime_typeof_annotation(g.args[i]);
                }
            }
            TypeAnnotation::Tuple(t)     => {
                for (mut i: i64 = 0; i < t.elements.length; i++) {
                    this.prime_typeof_annotation(t.elements[i]);
                }
            }
            _ => {}
        }
    }


    // Did-you-mean candidate collectors
    //
    // Each collector walks one symbol table and returns a string[] of
    // names to feed `EditDistance::find_best_candidate` from a typo
    // diagnostic.  Qualified names (those containing `::`) are skipped:
    // the user wrote a bare identifier, so the candidate set is the set
    // of bare identifiers they could have typed.

    /// Local variables in the current function's scope.  Used for E0201
    /// (undefined variable) did-you-mean.
    collect_local_names(&this) -> string[] {
        mut out: string[] = [];
        mut it: HashMapIter<u32, TypeRef> = this.locals.iter();
        loop {
            match (it.next()) {
                Option::Some(pair) => {
                    const s: string = this.intern.resolve(SymbolStr::from_id(pair.first));
                    if (s != "" && strstr(s, "::") == null) {
                        out.push(s);
                    }
                }
                Option::None => { break; }
            }
        }
        return out;
    }

    /// Every bare function name registered in the DeclarationIndex.
    /// Used for E0202 (cannot find function) did-you-mean.
    collect_bare_callable_names(&this) -> string[] {
        mut out: string[] = [];
        const idx: DeclarationIndex* = this.ctx.decl_index;
        for (mut i: i64 = 0; i < idx.module_funcs.length; i++) {
            const sym_id: u32 = idx.module_funcs[i].first;
            const name: string = this.intern.resolve(SymbolStr::from_id(sym_id));
            if (name == "")                       { continue; }
            if (strstr(name, "::") != null)       { continue; }
            // De-dup: linear scan is fine since the bare-function pool
            // is small (overloads collapse to one bare entry per name).
            mut seen: boolean = false;
            for (mut j: i64 = 0; j < out.length; j++) {
                if (strcmp(out[j], name) == 0) { seen = true; break; }
            }
            if (!seen) { out.push(name); }
        }
        return out;
    }

    /// Every bare type name registered in the DeclarationIndex.  Used
    /// for E0203 (undefined type) did-you-mean.
    collect_bare_type_names(&this) -> string[] {
        mut out: string[] = [];
        const idx: DeclarationIndex* = this.ctx.decl_index;
        for (mut i: i64 = 0; i < idx.module_types.length; i++) {
            const sym_id: u32 = idx.module_types[i].first;
            const name: string = this.intern.resolve(SymbolStr::from_id(sym_id));
            if (name == "")                       { continue; }
            if (strstr(name, "::") != null)       { continue; }
            mut seen: boolean = false;
            for (mut j: i64 = 0; j < out.length; j++) {
                if (strcmp(out[j], name) == 0) { seen = true; break; }
            }
            if (!seen) { out.push(name); }
        }
        return out;
    }

    /// Field + method names on the given struct/class.  Walks past
    /// pointer/reference/instantiation wrappers the same way the
    /// member-access resolver does, so `(&dog).barke` suggests `bark`
    /// against the underlying class's members.  Used for E0204 (no
    /// field or method on type) did-you-mean.
    collect_struct_or_class_member_names(&this, obj_type: TypeRef) -> string[] {
        mut out: string[] = [];
        mut walk_ty: TypeRef = obj_type;
        mut walk_t:  Type*    = this.arena.lookup(walk_ty.id);
        mut depth: i32 = 0;
        while (walk_t != null && depth < 5) {
            match (walk_t.kind) {
                TypeKind::Pointer => {
                    const pt: PointerType* = walk_t as PointerType*;
                    walk_ty = pt.pointee;
                    walk_t  = this.arena.lookup(walk_ty.id);
                }
                TypeKind::Reference => {
                    const rt: ReferenceType* = walk_t as ReferenceType*;
                    walk_ty = rt.referent;
                    walk_t  = this.arena.lookup(walk_ty.id);
                }
                TypeKind::InstantiatedType => {
                    const it: InstantiatedType* = walk_t as InstantiatedType*;
                    if (!it.has_resolved_type()) { break; }
                    walk_ty = it.resolved_type;
                    walk_t  = this.arena.lookup(walk_ty.id);
                }
                _ => { break; }
            }
            depth += 1;
        }
        if (walk_t == null) { return out; }

        match (walk_t.kind) {
            TypeKind::Struct => {
                const st: StructType* = walk_t as StructType*;
                for (mut i: i64 = 0; i < st.fields.length; i++) {
                    out.push(this.intern.resolve(st.fields[i].name));
                }
                for (mut i: i64 = 0; i < st.methods.length; i++) {
                    out.push(this.intern.resolve(st.methods[i].name));
                }
            }
            TypeKind::Class => {
                const cl: ClassType* = walk_t as ClassType*;
                for (mut i: i64 = 0; i < cl.fields.length; i++) {
                    out.push(this.intern.resolve(cl.fields[i].name));
                }
                for (mut i: i64 = 0; i < cl.methods.length; i++) {
                    out.push(this.intern.resolve(cl.methods[i].name));
                }
            }
            _ => {}
        }
        return out;
    }

    /// Display name for a TypeRef.  Resolves through the arena's display
    /// formatter and re-interns the resulting string so it doesn't outlive
    /// the formatter's static buffer.  Returns "?" for invalid refs.
    type_display_name(&this, ty: TypeRef) -> string {
        if (!ty.is_valid()) { return "?"; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return "?"; }
        const sym: SymbolStr = this.intern.intern(this.arena.format_display(t));
        return this.intern.resolve(sym);
    }

    /// Walk a type's structure looking for any unsubstituted generic
    /// parameter (GenericParam or BoundedParam).  Used to gate
    /// type-mismatch diagnostics that would otherwise fire spuriously
    /// when a nested generic-function call returns its template-form
    /// signature type (e.g., `mem::offset<T>` returning `T*`) inside a
    /// monomorphized caller whose field type has already been
    /// substituted to a concrete type.  The substitution pipeline does
    /// not deep-propagate through foreign generic-function return
    /// types, so we silently skip checks involving any such leftover.
    contains_generic_param(&this, tref: TypeRef) -> boolean {
        if (!tref.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(tref.id);
        if (t == null) { return false; }
        if (t.kind == TypeKind::GenericParam || t.kind == TypeKind::BoundedParam) {
            return true;
        }
        if (t.kind == TypeKind::Pointer) {
            const p: PointerType* = t as PointerType*;
            return this.contains_generic_param(p.pointee);
        }
        if (t.kind == TypeKind::Reference) {
            const r: ReferenceType* = t as ReferenceType*;
            return this.contains_generic_param(r.referent);
        }
        if (t.kind == TypeKind::Array) {
            const a: ArrayType* = t as ArrayType*;
            return this.contains_generic_param(a.element);
        }
        if (t.kind == TypeKind::Optional) {
            const o: OptionalType* = t as OptionalType*;
            return this.contains_generic_param(o.wrapped);
        }
        if (t.kind == TypeKind::Tuple) {
            const tup: TupleType* = t as TupleType*;
            for (mut i: i64 = 0; i < tup.elements.length; i++) {
                if (this.contains_generic_param(tup.elements[i])) {
                    return true;
                }
            }
            return false;
        }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                if (this.contains_generic_param(inst.type_args[i])) {
                    return true;
                }
            }
            return false;
        }
        return false;
    }

    /// Build the rich "mismatched types" diagnostic with the rustc-style
    /// `expected `<E>`, found `<F>`` inline label.  Callers pass the
    /// context phrase ("cannot initialize variable `x`", "argument to
    /// `foo`", "return value of `bar`") which becomes the explanatory
    /// note attached underneath, so the headline stays short and
    /// uniform across codes.
    ///
    /// `context_span`, when set, attaches a secondary "expected due to
    /// this" label - useful when the expected type came from an
    /// explicit annotation elsewhere (parameter declaration, return
    /// type annotation) so the user sees both ends of the mismatch.
    emit_type_mismatch(mut &this, code: ErrorCode, span: SourceSpan,
                       expected: TypeRef, found: TypeRef,
                       context_msg: string, context_span: SourceSpan) -> void {
        this.emit_type_mismatch_with_value(code, span, expected, found,
            context_msg, context_span, null);
    }

    /// Same as `emit_type_mismatch`, but accepts the offending value
    /// expression so the diagnostic can attach a literal-aware
    /// suggestion (boolean coercion, numeric->string conversion).  All
    /// the fixes here are conservative: they only fire when both ends
    /// of the mismatch are primitives we know how to bridge cleanly,
    /// and the suggestion's applicability reflects how confident the
    /// edit is (`MachineApplicable` for unambiguous cases like
    /// `"true"` -> `true`; `MaybeIncorrect` for casts the user may
    /// reasonably not want).
    emit_type_mismatch_with_value(mut &this, code: ErrorCode, span: SourceSpan,
                                   expected: TypeRef, found: TypeRef,
                                   context_msg: string, context_span: SourceSpan,
                                   value_expr: ExpressionNode*) -> void {
        const expected_name: string = this.type_display_name(expected);
        const found_name:    string = this.type_display_name(found);

        mut diag: Diagnostic = Diagnostic::error(code, "mismatched types");
        diag = diag.at_with_label(span,
            format("expected `%s`, found `%s`", expected_name, found_name));
        if (context_span.has_location()) {
            diag = diag.also_at(context_span, "expected due to this");
        }
        if (context_msg != "") {
            diag = diag.with_note(context_msg);
        }
        diag = this.attach_type_coercion_suggestion(diag, span,
            expected_name, found_name, value_expr);
        this.ctx.emit_diagnostic(diag);
    }

    /// Attach a literal-aware quickfix to a type-mismatch diagnostic
    /// when the (expected, found, value) triple has an obvious bridge:
    ///
    ///   * `bool`/`boolean` <- string `"true"` / `"false"`   -> drop quotes
    ///   * `bool`/`boolean` <- integer literal `0`/`1`       -> `false` / `true`
    ///   * `string`         <- integer / float literal       -> wrap in quotes
    ///   * primitive numeric <- string literal that parses   -> drop quotes
    ///
    /// All suggestions are MachineApplicable (the produced edit is
    /// guaranteed to compile if applied verbatim).  Returns the
    /// diagnostic unchanged when none of the patterns fit so callers
    /// can chain unconditionally.  A more general "wrap with `as T`"
    /// cast suggestion is intentionally left out - it requires reading
    /// the original source text, and the semantics (truncation,
    /// sign-extension) are rarely what the user expected at this point.
    attach_type_coercion_suggestion(&this, diag: Diagnostic, span: SourceSpan,
                                     expected_name: string, found_name: string,
                                     value_expr: ExpressionNode*) -> Diagnostic {
        if (value_expr == null || !span.has_location()) { return diag; }
        const node: ASTNode* = value_expr as ASTNode*;
        if (node.kind != NodeKind::Literal) { return diag; }

        const lit: LiteralNode* = value_expr as LiteralNode*;
        const want_bool: boolean = strcmp(expected_name, "boolean") == 0
                                || strcmp(expected_name, "bool") == 0;
        const want_string: boolean = strcmp(expected_name, "string") == 0;
        const found_string: boolean = strcmp(found_name, "string") == 0;

        if (want_bool && lit.literal_kind == LiteralKind::String) {
            if (strcmp(lit.value, "true") == 0) {
                return diag.suggest(Suggestion::machine_applicable(
                    span, "true", "drop the quotes to write a `boolean`"));
            }
            if (strcmp(lit.value, "false") == 0) {
                return diag.suggest(Suggestion::machine_applicable(
                    span, "false", "drop the quotes to write a `boolean`"));
            }
        }
        if (want_bool && lit.literal_kind == LiteralKind::Integer) {
            if (strcmp(lit.value, "0") == 0) {
                return diag.suggest(Suggestion::machine_applicable(
                    span, "false", "use the boolean literal"));
            }
            if (strcmp(lit.value, "1") == 0) {
                return diag.suggest(Suggestion::machine_applicable(
                    span, "true", "use the boolean literal"));
            }
        }
        if (want_string &&
            (lit.literal_kind == LiteralKind::Integer
             || lit.literal_kind == LiteralKind::Float)) {
            return diag.suggest(Suggestion::machine_applicable(
                span, format("\"%s\"", lit.value),
                "wrap the literal in quotes to make it a string"));
        }
        if (found_string && !want_bool && !want_string
            && this.is_numeric_type_name(expected_name)
            && this.lexeme_looks_like_number(lit.value)) {
            return diag.suggest(Suggestion::machine_applicable(
                span, lit.value,
                format("drop the quotes to write a `%s`", expected_name)));
        }

        return diag;
    }

    /// True when `name` matches one of the built-in primitive numeric
    /// type display names.  Used to gate the "drop the quotes" fix so
    /// it doesn't fire on user-defined types where the suggestion would
    /// be wrong.
    is_numeric_type_name(&this, name: string) -> boolean {
        return strcmp(name, "i8")  == 0 || strcmp(name, "i16") == 0
            || strcmp(name, "i32") == 0 || strcmp(name, "i64") == 0
            || strcmp(name, "u8")  == 0 || strcmp(name, "u16") == 0
            || strcmp(name, "u32") == 0 || strcmp(name, "u64") == 0
            || strcmp(name, "f32") == 0 || strcmp(name, "f64") == 0
            || strcmp(name, "int") == 0;
    }

    /// True when `s` is the body of a numeric literal: an optional sign
    /// followed by digits (decimal only - hex/octal/binary use a `0x`/
    /// `0o`/`0b` prefix and won't appear inside a string literal that's
    /// meant to be a number).
    lexeme_looks_like_number(&this, s: string) -> boolean {
        if (s == null) { return false; }
        const n: i64 = strlen(s) as i64;
        if (n == 0) { return false; }
        mut i: i64 = 0;
        if (s[0] == '-' || s[0] == '+') { i = 1; }
        if (i >= n) { return false; }
        mut saw_dot: boolean = false;
        while (i < n) {
            const c: char = s[i];
            if (c >= '0' && c <= '9') { i += 1; continue; }
            if (c == '.' && !saw_dot)  { saw_dot = true; i += 1; continue; }
            return false;
        }
        return true;
    }

    /// Build a `did you mean `<best>`?` help line and a machine-applicable
    /// suggestion attached to `span`.  Returns the diagnostic unchanged
    /// when no candidate clears the edit-distance threshold, so callers
    /// can chain unconditionally:
    ///
    ///   diag = this.attach_did_you_mean(diag, name, candidates,
    ///                                   "variable", ident.span);
    ///
    /// `kind` is the noun used in the help text ("variable", "function",
    /// "type", "field or method").
    attach_did_you_mean(&this, diag: Diagnostic, name: string,
                        candidates: string[], kind: string,
                        span: SourceSpan) -> Diagnostic {
        const best: string = find_best_candidate(name, candidates);
        if (best == "") { return diag; }
        mut out: Diagnostic = diag.help(
            format("a %s with a similar name exists: `%s`", kind, best));
        out = out.suggest(Suggestion::machine_applicable(span, best,
            format("did you mean `%s`?", best)));
        return out;
    }

    /// Resolve a module-qualified function call (e.g., intrinsics::frexp).
    /// Searches the module graph for a module whose namespace ends with
    /// scope_name, then looks up "namespace::member_name" in the DeclarationIndex.
    /// Returns invalid TypeRef if no match found.
    resolve_module_qualified_function(mut &this, scope_name: SymbolStr,
                                      member_name: SymbolStr,
                                      call: CallExprNode*) -> TypeRef {
        const scope_str: string = this.intern.resolve(scope_name);
        const member_str: string = this.intern.resolve(member_name);
        const scope_len: i64 = strlen(scope_str) as i64;
        if (scope_len == 0) { return TypeRef::invalid(); }

        // Search the module graph for a module whose namespace ends with
        // "::scope_name" (e.g., scope_name="intrinsics" matches namespace
        // "std::core::intrinsics").  Functions are registered under their
        // full namespace during type resolution.
        const mg: ModuleGraph* = this.ctx.module_graph;
        const modules: ModuleInfo[] = mg.modules;
        for (mut i: i64 = 0; i < modules.length; i++) {
            const ns_str: string = this.intern.resolve(modules[i].namespace_name);
            const ns_len: i64 = strlen(ns_str) as i64;

            // Check if namespace ends with "::scope_name" or equals scope_name
            mut is_match: boolean = false;
            if (ns_len == scope_len) {
                is_match = strcmp(ns_str, scope_str) == 0;
            } else if (ns_len > scope_len + 1) {
                const suffix_start: i64 = ns_len - scope_len;
                if (ns_str[suffix_start - 1] == ':' && ns_str[suffix_start - 2] == ':') {
                    is_match = strcmp(ns_str + suffix_start, scope_str) == 0;
                }
            }

            if (is_match) {
                const qualified: string = ns_str + "::" + member_str;
                const q_sym: SymbolStr = this.ctx.intern(qualified);
                const ret: TypeRef = this.lookup_func_return(q_sym);
                if (ret.is_valid()) {
                    // Skip pinning when the target is a generic function
                    // template: mono's try_infer_function_call needs to see
                    // call.resolved_callee unpinned so it can run inference,
                    // pin the specialized symbol, and call instantiate_for_module.
                    // Premature pin here strands the InstantiatedType in the
                    // arena (sema creates the wrapper; mono never queues it)
                    // and GenericValidation rejects with E0900.
                    mut is_fn_template: boolean = false;
                    if (this.ctx.generic_registry != null) {
                        const tmpl: TemplateEntry* = this.ctx.generic_registry.get_template(q_sym);
                        if (tmpl != null && tmpl.node_kind == NodeKind::FunctionDeclaration) {
                            is_fn_template = true;
                        }
                    }
                    if (!is_fn_template) {
                        this.pin_scope_callee_qsym(call, q_sym);
                    }
                    return ret;
                }
            }
        }
        return TypeRef::invalid();
    }


    /// Look up the template module for an injected specialization by
    /// checking the CompilationContext's side table (populated during
    /// GenericExpressionResolution injection).
    find_template_module(&this, node: ASTNode*) -> SymbolStr {
        if (node == null) { return SymbolStr::empty(); }
        return this.ctx.lookup_injected_origin(node as u64);
    }

    lookup_type_sym(&this, ty: TypeRef) -> SymbolStr {
        // First try the direct TypeRef
        const direct: SymbolStr = this.ctx.decl_index.lookup_type_name(ty);
        if (direct.is_valid()) { return direct; }

        // If the TypeRef is an InstantiatedType with a resolved_type,
        // dereference and try the concrete type instead.
        const t: Type* = this.arena.lookup(ty.id);
        if (t != null && t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (inst.has_resolved_type()) {
                return this.ctx.decl_index.lookup_type_name(inst.resolved_type);
            }
        }

        return SymbolStr::empty();
    }

    lookup_local(&this, name: SymbolStr) -> TypeRef {
        const h: u64 = hash_int(name.id as u64);
        return match (this.locals.get(&name.id)) {
            Option::Some(val) => { val }
            Option::None      => { TypeRef::invalid() }
        };
    }


    // Scope Management

    /// Save the current scope state.  Returns a checkpoint index into the
    /// undo log that restore_scope() uses to roll back.
    save_scope(&this) -> i64 {
        return this.undo_keys.length;
    }

    /// Register a local variable, recording the previous binding (if any)
    /// in the undo log so it can be restored on scope exit.  Defaults to
    /// immutable (`const`); call `register_local_mut` for `mut` bindings.
    register_local(mut &this, name: SymbolStr, ty: TypeRef) -> void {
        this.register_local_with_mut(name, ty, false);
    }

    /// Register a `mut` local variable.
    register_local_mut(mut &this, name: SymbolStr, ty: TypeRef) -> void {
        this.register_local_with_mut(name, ty, true);
    }

    /// Internal: register a local with an explicit mutability flag.
    register_local_with_mut(mut &this, name: SymbolStr, ty: TypeRef,
                             is_mut: boolean) -> void {
        const key: u32 = name.id;

        // Save previous binding for undo
        this.undo_keys.push(key);
        match (this.locals.get(&key)) {
            Option::Some(val) => { this.undo_prev.push(val); }
            Option::None      => { this.undo_prev.push(TypeRef::invalid()); }
        }
        match (this.local_muts.get(&key)) {
            Option::Some(prev) => { this.undo_muts.push(prev); }
            Option::None       => { this.undo_muts.push(false); }
        }
        match (this.local_kw_spans.get(&key)) {
            Option::Some(prev) => { this.undo_kw_spans.push(prev); }
            Option::None       => { this.undo_kw_spans.push(SourceSpan::none()); }
        }

        this.locals.insert(key, ty);
        this.local_muts.insert(key, is_mut);
        // Default: drop any prior keyword anchor so a stale outer-scope
        // binding's span doesn't leak into the inner shadowing one.  The
        // caller pairs the registration with `record_local_kw_span` when
        // it has a parser-derived span to attach.
        this.local_kw_spans.remove(&key);
    }

    /// Attach a keyword-span anchor to a previously-registered local.
    /// `kw_span` is the SourceSpan the parser stamped on the
    /// VarDeclNode's `kw_span` field - the `const`/`mut` keyword's
    /// location for top-level locals, or a zero-width insertion point
    /// just before the parameter name for params declared without
    /// `mut`.  No-op when `kw_span` lacks a location.
    record_local_kw_span(mut &this, name: SymbolStr, kw_span: SourceSpan) -> void {
        if (!kw_span.has_location()) { return; }
        this.local_kw_spans.insert(name.id, kw_span);
    }

    /// Look up a local binding's mutability.  Returns true for unknown
    /// names (so the caller doesn't false-positive on globals or
    /// otherwise-tracked symbols).
    local_is_mutable(&this, name: SymbolStr) -> boolean {
        match (this.local_muts.get(&name.id)) {
            Option::Some(v) => { return v; }
            Option::None    => { return true; }
        }
    }

    // NOTE: sync_to_resolver() was removed.  The DeclarationIndex is now the
    // single source of truth for declaration-level type lookups (functions,
    // methods, named types, globals).  Per-function types (params, locals)
    // are tracked exclusively through the locals HashMap on this visitor.

    /// Roll back local variable bindings to a previous checkpoint,
    /// restoring any shadowed outer-scope variables.
    restore_scope(mut &this, save_point: i64) -> void {
        // Undo in reverse order
        for (mut i: i64 = this.undo_keys.length - 1; i >= save_point; i -= 1) {
            const key: u32 = this.undo_keys[i];
            const prev: TypeRef = this.undo_prev[i];
            const prev_mut: boolean = this.undo_muts[i];
            const prev_kw: SourceSpan = this.undo_kw_spans[i];
            if (prev.is_valid()) {
                this.locals.insert(key, prev);
                this.local_muts.insert(key, prev_mut);
                if (prev_kw.has_location()) {
                    this.local_kw_spans.insert(key, prev_kw);
                } else {
                    this.local_kw_spans.remove(&key);
                }
            } else {
                this.locals.remove(&key);
                this.local_muts.remove(&key);
                this.local_kw_spans.remove(&key);
            }
        }

        // Truncate undo log back to save point
        if (save_point < this.undo_keys.length) {
            mut new_keys: u32[] = [];
            mut new_prev: TypeRef[] = [];
            mut new_muts: boolean[] = [];
            mut new_kw_spans: SourceSpan[] = [];
            for (mut i: i64 = 0; i < save_point; i++) {
                new_keys.push(this.undo_keys[i]);
                new_prev.push(this.undo_prev[i]);
                new_muts.push(this.undo_muts[i]);
                new_kw_spans.push(this.undo_kw_spans[i]);
            }
            this.undo_keys = new_keys;
            this.undo_prev = new_prev;
            this.undo_muts = new_muts;
            this.undo_kw_spans = new_kw_spans;
        }
    }


    // Match Pattern Binding

    /// Register pattern bindings from a match arm as local variables.
    /// For enum patterns, each binding's type is inferred from the
    /// corresponding payload position in the enum variant definition.
    /// Peel through Reference and InstantiatedType wrappers to find the
    /// underlying concrete enum type.  e.g., &Option_string -> Option_string,
    /// InstantiatedType(Option, [string]) -> Option_string (via resolved_type).
    unwrap_to_enum(&this, ty: TypeRef) -> Type* {
        if (!ty.is_valid()) { return null; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return null; }

        // Peel references: &T -> T
        if (t.kind == TypeKind::Reference) {
            const ref_t: ReferenceType* = t as ReferenceType*;
            return this.unwrap_to_enum(ref_t.referent);
        }

        // Peel pointers: T* -> T
        if (t.kind == TypeKind::Pointer) {
            const ptr_t: PointerType* = t as PointerType*;
            return this.unwrap_to_enum(ptr_t.pointee);
        }

        // Dereference InstantiatedType -> resolved concrete type
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (inst.has_resolved_type()) {
                return this.unwrap_to_enum(inst.resolved_type);
            }
            return null;
        }

        // Already a concrete type; return it (caller checks for Enum kind)
        return t;
    }

    /// Peel Reference/Pointer wrappers and return the innermost InstantiatedType
    /// (if any), even when its `resolved_type` is still invalid.  Used by
    /// bind_arm_patterns to substitute generic params in variant payload types
    /// when the instantiation hasn't been monomorphized yet, for example,
    /// methods whose this-param type differs from the outer enum instantiation
    /// (`copied(this: Result<T*, E>)` on Result<i32, string>).
    peel_to_instantiation(&this, ty: TypeRef) -> InstantiatedType* {
        if (!ty.is_valid()) { return null; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return null; }
        if (t.kind == TypeKind::Reference) {
            const ref_t: ReferenceType* = t as ReferenceType*;
            return this.peel_to_instantiation(ref_t.referent);
        }
        if (t.kind == TypeKind::Pointer) {
            const ptr_t: PointerType* = t as PointerType*;
            return this.peel_to_instantiation(ptr_t.pointee);
        }
        if (t.kind == TypeKind::InstantiatedType) {
            return t as InstantiatedType*;
        }
        return null;
    }

    bind_arm_patterns(mut &this, arm: MatchArmNode*, subject_type: TypeRef) -> void {
        for (mut i: i64 = 0; i < arm.patterns.length; i++) {
            const pat: PatternNode* = arm.patterns[i];
            if (pat == null) { continue; }

            // Simple identifier pattern: binds the entire subject
            if (pat.pattern_kind == PatternKind::Identifier) {
                if (subject_type.is_valid()) {
                    this.register_local(pat.binding_name, subject_type);
                }
                continue;
            }

            if (pat.pattern_kind != PatternKind::Enum) { continue; }

            const enum_pat: EnumPatternNode* = pat as EnumPatternNode*;

            // Look up variant payload types from the enum's type info.
            // Unwrap the subject type through references and instantiations
            // to find the concrete EnumType with resolved payload types.
            mut payload_types: TypeRef[] = [];
            mut enum_ty: Type* = null;

            // Primary path: unwrap the subject type to find the concrete enum.
            // This handles &Option_string -> Option_string, and
            // InstantiatedType(Option, [string]) -> Option_string.
            enum_ty = this.unwrap_to_enum(subject_type);

            // Capture the instantiation (even if not yet monomorphized) so we
            // can substitute generic params into payload_types below.
            const peeled_inst: InstantiatedType* = this.peel_to_instantiation(subject_type);

            // Fallback A: if we have an InstantiatedType but no concrete enum
            // yet, use the generic base enum template directly.
            if ((enum_ty == null || enum_ty.kind != TypeKind::Enum) && peeled_inst != null) {
                const base_t: Type* = this.arena.lookup(peeled_inst.generic_base.id);
                if (base_t != null && base_t.kind == TypeKind::Enum) {
                    enum_ty = base_t;
                }
            }

            // Fallback B: look up by pattern's enum name (works for non-generic
            // enums where the pattern name matches the type name exactly).
            if (enum_ty == null || enum_ty.kind != TypeKind::Enum) {
                const enum_type_ref: TypeRef = this.lookup_type_by_sym(enum_pat.enum_name);
                if (enum_type_ref.is_valid()) {
                    enum_ty = this.unwrap_to_enum(enum_type_ref);
                }
            }

            if (enum_ty != null && enum_ty.kind == TypeKind::Enum) {
                const et: EnumType* = enum_ty as EnumType*;
                const variant: EnumVariantInfo* = et.get_variant(enum_pat.variant_name);
                if (variant != null) {
                    payload_types = variant.payload_types;

                    // When the subject is a generic instantiation whose concrete
                    // specialization hasn't been monomorphized yet (or when the
                    // enum template we're looking at still carries GenericParam
                    // payload types), substitute the template's generic params
                    // with the instantiation's type_args so the binding resolves
                    // to the correct concrete type.  Without this, methods like
                    // `copied(this: Result<T*, E>)` bind `ptr` to GenericParam T
                    // (mapped as the raw payload byte type) instead of T*.
                    const gr: GenericRegistry* = this.ctx.get_generic_registry();
                    if (peeled_inst != null && gr != null) {
                        const tmpl: TemplateEntry* = gr.get_template_by_type_id(
                            peeled_inst.generic_base.id);
                        if (tmpl != null &&
                            tmpl.param_type_ids.length == peeled_inst.type_args.length) {
                            mut subst: TypeSubstitution = TypeSubstitution::from_params(
                                tmpl.param_type_ids, peeled_inst.type_args);
                            mut substituted: TypeRef[] = [];
                            for (mut k: i64 = 0; k < payload_types.length; k++) {
                                substituted.push(subst.apply(payload_types[k], this.arena));
                            }
                            payload_types = substituted;
                        }
                    }
                }
            }

            // Register each binding. If variant payload types are available
            // AND valid, use the positional type. Otherwise fall back to
            // subject_type so the variable is at least defined (prevents
            // cascading "undefined variable" errors).
            for (mut j: i64 = 0; j < enum_pat.elements.length; j++) {
                const pb: PatternBinding* = enum_pat.binding_at(j);
                if (pb == null) { continue; }
                // Remember this binding so a `return` that escapes a
                // pointer/reference to it is caught (E0455).  The payload
                // lives in a match temporary that dies at function return.
                if (pb.name.is_valid()) { this.payload_binding_ids.push(pb.name.id); }
                if (j < payload_types.length && payload_types[j].is_valid()) {
                    this.register_local(pb.name, payload_types[j]);
                } else if (subject_type.is_valid()) {
                    this.register_local(pb.name, subject_type);
                } else {
                    // Last resort: register with a generic type to prevent
                    // "undefined variable" cascading.  The type is wrong but
                    // the variable is at least accessible.
                    this.register_local(pb.name, this.arena.get_void());
                }
            }
        }
    }


    // Per-Function Setup

    /// Reset per-function state and register parameters + "this".
    enter_function(mut &this, func: FunctionDeclNode*, fn_this_type: TypeRef) -> void {
        this.locals         = HashMap<u32, TypeRef>::new();
        this.local_muts     = HashMap<u32, boolean>::new();
        this.local_kw_spans = HashMap<u32, SourceSpan>::new();
        this.undo_keys      = [];
        this.undo_prev      = [];
        this.undo_muts      = [];
        this.undo_kw_spans  = [];
        this.return_type     = func.resolved_return_type;
        this.return_type_ann = func.return_type_annotation;
        this.this_type       = fn_this_type;
        this.this_is_mut = false;
        this.payload_binding_ids = [];
        this.param_ids = [];
        // Defensive reset: lambda state is normally save/restored by
        // resolve_lambda, but reseating it at every function entry
        // guarantees nested-pass re-entry can never observe stale state.
        this.in_lambda_depth     = 0;
        this.lambda_outer_locals = HashMap<u32, TypeRef>::new();
        this.current_lambda      = null;

        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null) { continue; }
            mut ty: TypeRef = this.arena.get_void();
            if (param.resolved_type.is_valid()) {
                ty = param.resolved_type;
            } else if (func.is_variadic && i == func.parameters.length - 1
                       && param.type_annotation == null) {
                // The trailing untyped `args...` bucket. Phase 0: expose it
                // as `void*` (the prologue-bound va_list pointer) so the body
                // can pluck values via the `va_arg_*` intrinsics. Phase 3
                // retypes this to the `VaArgs` wrapper.
                ty = this.arena.get_pointer_to(this.arena.get_void());
            }
            // The receiver param synthesised by the parser uses the
            // interned name "&this"; its `is_mutable` flag tracks
            // whether the user wrote `mut &this`.  We register `this`
            // (without the leading `&`) below; pick up the receiver's
            // mutability here so the assignment checker can validate
            // `*this = ...` and `this.field = ...` later.
            const param_name: string = this.intern.resolve(param.name);
            if (strcmp(param_name, "&this") == 0) {
                this.this_is_mut = param.is_mutable;
            } else {
                this.register_local_with_mut(param.name, ty, param.is_mutable);
                this.record_local_kw_span(param.name, param.kw_span);
                this.param_ids.push(param.name.id);
            }
        }

        if (fn_this_type.is_valid()) {
            this.register_local_with_mut(this.this_sym, fn_this_type, this.this_is_mut);
            this.param_ids.push(this.this_sym.id);
        }
    }


    // Declaration Visitors

    override visit(node: ProgramNode*) -> void {
        for (mut i: i64 = 0; i < node.statements.length; i++) {
            const stmt: ASTNode* = node.statements[i];
            if (stmt == null) { continue; }
            this.dispatch_top_level(stmt);
        }
    }

    dispatch_top_level(mut &this, stmt: ASTNode*) -> void {
        // If this declaration was injected from a specialized template
        // (source_module is set), temporarily switch the Resolver AND
        // the CompilationContext's namespace to the template's module
        // so that both scope-chain lookups and qualify_symbol_sym()
        // produce the correct qualified names.
        mut saved_scope: u64 = 0;
        mut saved_namespace: SymbolStr = SymbolStr::empty();
        mut needs_restore: boolean = false;
        // Check if this statement is an injected specialization by scanning
        // the Monomorphizer's spec_entries for a matching AST node pointer.
        // Direct field writes to source_module don't survive vtable-offset
        // miscompiles on class hierarchies, so we route through the
        // Monomorphizer as a side channel.
        const template_mod: SymbolStr = this.find_template_module(stmt);
        if (template_mod.is_valid()) {
            const resolver: Resolver* = this.ctx.get_resolver();
            if (resolver != null) {
                saved_scope = resolver.get_current_scope_id();
                const mod_str: string = this.intern.resolve(template_mod);
                const template_scope: u64 = resolver.find_module_scope(mod_str);
                if (template_scope > 0) {
                    resolver.set_module_with_scope(template_mod, template_scope);
                    saved_namespace = this.ctx.swap_namespace(template_mod);
                    needs_restore = true;
                }
            }
        }

        // Double-dispatch via accept(): runtime type calls the right
        // `override visit(SpecificType*)` method.  Statement kinds that
        // don't have a specific override fall through to BaseASTVisitor's
        // no-op default, which is the desired behavior for top-level
        // declarations TypeCheckVisitor doesn't process here.
        stmt.accept(this);

        // Restore scope and namespace after processing injected specialization
        if (needs_restore) {
            const resolver: Resolver* = this.ctx.get_resolver();
            if (resolver != null) {
                const current_mod: SymbolStr = this.intern.intern(this.ctx.source_file);
                resolver.set_module_with_scope(current_mod, saved_scope);
            }
            this.ctx.swap_namespace(saved_namespace);
        }
    }

    override visit(mut &this, node: FunctionDeclNode*) -> void {
        if (node.body == null || node.is_generic()) { return; }
        const _fn_name: string = this.intern.resolve(node.name);
        this.enter_function(node, TypeRef::invalid());
        this.visit(node.body);
        this.body_count += 1;
        this.check_function_returns(node);
    }

    /// All-paths-return check: when a function declares a non-trivial
    /// return type, every control-flow path through its body must end
    /// in a `return`, a divergent call (panic / `Never`-typed call), or
    /// an infinite `loop` with no `break`.  Functions returning `void`,
    /// `()`, or `Never` are exempt; falling off the end is fine.
    check_function_returns(mut &this, func: FunctionDeclNode*) -> void {
        if (func == null || func.body == null) { return; }
        if (!this.return_type_requires_return(func.resolved_return_type)) {
            return;
        }
        if (this.block_always_returns(func.body)) { return; }
        const fn_name: string = this.intern.resolve(func.name);
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0403_MISSING_RETURN,
            format("function `%s` is declared to return a value but reaches the end of its body without returning",
                fn_name));
        diag = diag.at(func.span);
        diag = diag.with_note("every control-flow path through the body must end in `return <expr>`, a divergent call (e.g. `panic(...)`), or an infinite `loop { ... }` with no `break`");
        diag = diag.with_note("if a missing path is unreachable, end it with `return <default>` or `panic(\"unreachable\")`");

        // Has-placeholders quickfix: append `return <default>;` on a new
        // line at the end of the body so the user only has to fill in
        // the value.  The default expression is picked to type-check
        // against the declared return type for primitive cases, and is
        // a `<TypeName>` placeholder otherwise.  Skipped when the body
        // is empty (no anchor) or the last stmt has no usable span.
        if (func.body.statements.length > 0) {
            const last: StatementNode* =
                func.body.statements[func.body.statements.length - 1];
            if (last != null && last.span.has_location()) {
                const anchor: SourceSpan = SourceSpan::new(
                    last.span.file,
                    last.span.end_line, last.span.end_col,
                    last.span.end_line, last.span.end_col);
                const placeholder: string =
                    this.default_return_expr_for(func.resolved_return_type);
                const repl: string =
                    format("\nreturn %s;", placeholder);
                diag = diag.suggest(Suggestion::single(anchor, repl,
                    "add a `return` at the end of the body",
                    Applicability::HasPlaceholders));
            }
        }

        this.ctx.diagnostics.emit(diag);
    }

    /// Build a placeholder expression suitable for an E0403 quickfix:
    /// a literal whose type matches `ret_ty` when one obviously exists
    /// (integers -> `0`, floats -> `0.0`, `bool`/`boolean` -> `false`,
    /// `string` -> `""`, pointers -> `null`), otherwise a `<TypeName>`
    /// placeholder so the user knows what shape to fill in.  Kept
    /// deliberately conservative - the goal is "compiles when the
    /// user clicks `Apply`" for the common primitive case.
    default_return_expr_for(&this, ret_ty: TypeRef) -> string {
        if (!ret_ty.is_valid()) { return "<value>"; }
        const t: Type* = this.arena.lookup(ret_ty.id);
        if (t == null) { return "<value>"; }
        match (t.kind) {
            TypeKind::Pointer  => { return "null"; }
            TypeKind::Optional => { return "Option::None"; }
            _                  => { /* fall through */ }
        }
        const name: string = this.type_display_name(ret_ty);
        if (strcmp(name, "boolean") == 0 || strcmp(name, "bool") == 0) {
            return "false";
        }
        if (strcmp(name, "string") == 0) { return "\"\""; }
        if (strcmp(name, "f32") == 0 || strcmp(name, "f64") == 0) {
            return "0.0";
        }
        if (strcmp(name, "i8") == 0  || strcmp(name, "i16") == 0
         || strcmp(name, "i32") == 0 || strcmp(name, "i64") == 0
         || strcmp(name, "u8") == 0  || strcmp(name, "u16") == 0
         || strcmp(name, "u32") == 0 || strcmp(name, "u64") == 0) {
            return "0";
        }
        return format("<%s>", name);
    }

    /// Returns true if `ret` is a return type that demands an explicit
    /// returned value (anything other than void / unit / never / invalid).
    return_type_requires_return(&this, ret: TypeRef) -> boolean {
        if (!ret.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(ret.id);
        if (t == null) { return false; }
        if (t.kind == TypeKind::Void) { return false; }
        if (t.kind == TypeKind::Unit) { return false; }
        if (t.kind == TypeKind::Never) { return false; }
        return true;
    }

    /// Recursive: does this block guarantee a return on every path?
    block_always_returns(&this, block: BlockStmtNode*) -> boolean {
        if (block == null) { return false; }
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            if (this.stmt_always_returns(block.statements[i])) {
                return true;
            }
        }
        return false;
    }

    /// Recursive: does this single statement guarantee that control
    /// never falls through to a sibling statement that follows it?
    stmt_always_returns(&this, stmt: StatementNode*) -> boolean {
        if (stmt == null) { return false; }
        const node: ASTNode* = stmt as ASTNode*;
        match (node.kind) {
            NodeKind::ReturnStatement => { return true; }
            NodeKind::BlockStatement => {
                return this.block_always_returns(stmt as BlockStmtNode*);
            }
            NodeKind::UnsafeBlockStatement => {
                const ub: UnsafeBlockStmtNode* = stmt as UnsafeBlockStmtNode*;
                return this.block_always_returns(ub.block);
            }
            NodeKind::IfStatement => {
                const ifs: IfStmtNode* = stmt as IfStmtNode*;
                if (!ifs.has_else()) { return false; }
                return this.stmt_always_returns(ifs.then_stmt)
                    && this.stmt_always_returns(ifs.else_stmt);
            }
            NodeKind::MatchStatement => {
                const ms: MatchStmtNode* = stmt as MatchStmtNode*;
                // Match returns iff every arm body returns AND the match
                // is exhaustive (covers every variant); exhaustiveness
                // ensures no fall-through.  `check_match_exhaustive` has
                // already emitted a diagnostic if the match isn't, so we
                // only treat exhaustive matches as guaranteed-return here.
                if (!this.match_is_exhaustive(ms.subject, ms.arms)) {
                    return false;
                }
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm == null || arm.body == null) { return false; }
                    if (!this.stmt_always_returns(arm.body)) { return false; }
                }
                return true;
            }
            NodeKind::LoopStatement => {
                // `loop { ... }` is divergent: control can only escape via
                // `return`, `panic`, or `break`.  If the body contains no
                // `break` anywhere, the loop runs forever as far as the
                // caller is concerned, so the function path through the
                // loop never falls past it.  This is the common shape
                // (e.g. read-loops that return on EOF / error).
                const ls: LoopStmtNode* = stmt as LoopStmtNode*;
                if (!this.block_contains_break(ls.body)) { return true; }
                return this.block_always_returns(ls.body);
            }
            NodeKind::SwitchStatement => {
                // A switch guarantees a return iff it has a `default` (so no
                // value can slip past unmatched) AND every case body returns.
                // A body that ends in `break` exits to the merge rather than
                // returning, so `stmt_always_returns` on it is false and such
                // a switch correctly fails this check.
                const sw: SwitchStmtNode* = stmt as SwitchStmtNode*;
                mut has_default: boolean = false;
                for (mut i: i64 = 0; i < sw.cases.length; i++) {
                    const c: CaseStmtNode* = sw.cases[i];
                    if (c == null) { return false; }
                    if (c.is_default) { has_default = true; }
                    if (!this.stmt_always_returns(c.body as StatementNode*)) {
                        return false;
                    }
                }
                return has_default;
            }
            NodeKind::DoWhileStatement => {
                // The body runs at least once, so if it unconditionally
                // returns the loop returns before the condition is tested.
                const dw: DoWhileStmtNode* = stmt as DoWhileStmtNode*;
                return this.stmt_always_returns(dw.body);
            }
            NodeKind::ExpressionStatement => {
                const es: ExprStmtNode* = stmt as ExprStmtNode*;
                return this.expr_is_divergent(es.expression);
            }
            _ => {}
        }
        return false;
    }

    /// Walk a block (recursively) for any `break` statement, ignoring
    /// `break`s inside nested `loop` / `while` / `for` / `match`
    /// arms (those would break the inner construct, not the loop we
    /// care about).  Used by the all-paths-return check to decide
    /// whether a `loop` is divergent.
    block_contains_break(&this, block: BlockStmtNode*) -> boolean {
        if (block == null) { return false; }
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            if (this.stmt_contains_break(block.statements[i])) { return true; }
        }
        return false;
    }

    stmt_contains_break(&this, stmt: StatementNode*) -> boolean {
        if (stmt == null) { return false; }
        const node: ASTNode* = stmt as ASTNode*;
        match (node.kind) {
            NodeKind::BreakStatement => { return true; }
            NodeKind::BlockStatement => {
                return this.block_contains_break(stmt as BlockStmtNode*);
            }
            NodeKind::UnsafeBlockStatement => {
                const ub: UnsafeBlockStmtNode* = stmt as UnsafeBlockStmtNode*;
                return this.block_contains_break(ub.block);
            }
            NodeKind::IfStatement => {
                const ifs: IfStmtNode* = stmt as IfStmtNode*;
                if (this.stmt_contains_break(ifs.then_stmt)) { return true; }
                if (ifs.has_else()) {
                    if (this.stmt_contains_break(ifs.else_stmt)) { return true; }
                }
                return false;
            }
            NodeKind::MatchStatement => {
                const ms: MatchStmtNode* = stmt as MatchStmtNode*;
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm != null && this.stmt_contains_break(arm.body)) {
                        return true;
                    }
                }
                return false;
            }
            // `break` inside a nested loop/while/for breaks that loop, not
            // the outer one, so don't recurse into them.
            _ => {}
        }
        return false;
    }

    /// Recognize calls to known divergent functions (`panic` and
    /// friends) so callers in non-void slots are accepted as
    /// guaranteed-returning by the all-paths check.  Also recognizes
    /// any callee whose `resolved_type` is `Never` (that's the
    /// long-term sound rule once the language gains `-> never`).
    expr_is_divergent(&this, expr: ExpressionNode*) -> boolean {
        if (expr == null) { return false; }
        if (expr.kind != NodeKind::CallExpression) { return false; }
        const call: CallExprNode* = expr as CallExprNode*;
        if (call.callee == null) { return false; }

        // Type-driven path: callee whose resolved_type is `Never`.
        if (call.resolved_type.is_valid()) {
            const rt: Type* = this.arena.lookup(call.resolved_type.id);
            if (rt != null && rt.kind == TypeKind::Never) { return true; }
        }

        if (call.callee.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = call.callee as IdentifierNode*;
            const name: string = this.intern.resolve(id.name);
            if (strcmp(name, "panic") == 0) { return true; }
            return false;
        }
        if (call.callee.kind == NodeKind::ScopeResolution) {
            const sr: ScopeResolutionNode* = call.callee as ScopeResolutionNode*;
            const member: string = this.intern.resolve(sr.member_name);
            if (strcmp(member, "panic") != 0) { return false; }
            const scope: string = this.intern.resolve(sr.scope_name);
            const slen: i64 = strlen(scope) as i64;
            // Anything that ends in `core::panic`, `prelude`, or
            // `core::intrinsics`, and whose member is `panic`, is the
            // standard library's panic plumbing.  All three forms
            // resolve through the same divergent runtime entry.
            if (slen >= 11) {
                const tail11: string = (scope + (slen - 11)) as string;
                if (strcmp(tail11, "core::panic") == 0) { return true; }
            }
            if (slen >= 7) {
                const tail7: string = (scope + (slen - 7)) as string;
                if (strcmp(tail7, "prelude") == 0) { return true; }
            }
            // `intrinsics::panic` and `core::intrinsics::panic`.
            if (slen >= 10) {
                const tail10: string = (scope + (slen - 10)) as string;
                if (strcmp(tail10, "intrinsics") == 0) { return true; }
            }
            if (strcmp(scope, "intrinsics") == 0) { return true; }
        }
        return false;
    }

    /// Predicate form of `check_match_exhaustive` for the all-paths
    /// check.  Any wildcard arm (`_ => ...`) or bare-identifier
    /// catch-all (`x => ...`) makes the match exhaustive regardless
    /// of subject type (the universal escape hatch).  For
    /// enum subjects without a wildcard, every variant must appear
    /// as an enum-pattern arm.  Non-enum subjects without a wildcard
    /// are never considered exhaustive (their value space is open).
    match_is_exhaustive(&this, subject: ExpressionNode*,
                         arms: MatchArmNode*[]) -> boolean {
        // Pass 1: any wildcard / identifier-binding arm short-circuits.
        for (mut i: i64 = 0; i < arms.length; i++) {
            const arm: MatchArmNode* = arms[i];
            if (arm == null) { continue; }
            for (mut j: i64 = 0; j < arm.patterns.length; j++) {
                const pat: PatternNode* = arm.patterns[j];
                if (pat == null) { continue; }
                if (pat.pattern_kind == PatternKind::Wildcard
                    || pat.pattern_kind == PatternKind::Identifier) {
                    return true;
                }
            }
        }
        // Pass 2: enum-variant-by-variant check.
        if (subject == null) { return false; }
        const enum_ty: Type* = this.unwrap_to_enum(subject.resolved_type);
        if (enum_ty == null || enum_ty.kind != TypeKind::Enum) { return false; }
        const et: EnumType* = enum_ty as EnumType*;
        if (et.variants.length == 0) { return false; }
        mut covered_ids: u32[] = [];
        for (mut i: i64 = 0; i < arms.length; i++) {
            const arm: MatchArmNode* = arms[i];
            if (arm == null) { continue; }
            for (mut j: i64 = 0; j < arm.patterns.length; j++) {
                const pat: PatternNode* = arm.patterns[j];
                if (pat == null) { continue; }
                if (pat.pattern_kind == PatternKind::Enum) {
                    const ep: EnumPatternNode* = pat as EnumPatternNode*;
                    covered_ids.push(ep.variant_name.id);
                }
            }
        }
        for (mut i: i64 = 0; i < et.variants.length; i++) {
            const vid: u32 = et.variants[i].name.id;
            mut found: boolean = false;
            for (mut k: i64 = 0; k < covered_ids.length; k++) {
                if (covered_ids[k] == vid) { found = true; break; }
            }
            if (!found) { return false; }
        }
        return true;
    }

    override visit(mut &this, node: StructDeclNode*) -> void {
        if (node.is_generic()) { return; }
        const qualified_sym: SymbolStr = this.ctx.qualify_symbol_sym(node.name);
        const st_type: TypeRef = this.ctx.decl_index.lookup_type(qualified_sym);
        this.visit_methods(node.methods, st_type);
    }

    override visit(mut &this, node: ClassDeclNode*) -> void {
        if (node.is_generic()) { return; }
        const qualified_sym: SymbolStr = this.ctx.qualify_symbol_sym(node.name);
        const cl_type: TypeRef = this.ctx.decl_index.lookup_type(qualified_sym);
        this.visit_methods(node.methods, cl_type);
    }

    override visit(mut &this, node: TraitDeclNode*) -> void {
        if (node.is_generic()) { return; }
        // Inside a trait declaration, `this` refers to the implementing
        // type, symbolically. Use the same canonical `This` placeholder
        // the type resolver synthesizes in `resolve_trait_method_signatures`
        // (B.1) so default-body uses of `this` and `&this` resolve cleanly
        // and will be substituted to the concrete impl target by B.6
        // synthesis. Without this, every trait default body emits
        // "undefined variable 'this'" diagnostics.
        const this_name: SymbolStr = this.intern.intern("This");
        const this_placeholder: TypeRef =
            this.arena.create_generic_param(this_name, 0xFFFFFFFF as u64);
        for (mut j: i64 = 0; j < node.methods.length; j++) {
            const func: FunctionDeclNode* = node.methods[j];
            if (func != null && func.body != null) {
                this.enter_function(func, this_placeholder);
                this.visit(func.body);
                this.body_count += 1;
            }
        }
    }

    override visit(mut &this, node: ImplBlockNode*) -> void {
        if (node.is_generic()) { return; }
        // Skip impls whose target is a generic template; those exist only
        // as a source for monomorphization. Type-checking the template body
        // would bind `this` to the bare-template type, which has no concrete
        // methods (those live on the spec'd clones). The spec'd impl block
        // gets visited separately with `this` typed as the concrete spec.
        const greg: GenericRegistry* = this.ctx.generic_registry;
        if (greg != null) {
            mut qualified_target: SymbolStr = node.target_type;
            const target_str: string = this.intern.resolve(node.target_type);
            if (strstr(target_str, "::") == null) {
                qualified_target = this.ctx.qualify_symbol_sym(node.target_type);
            }
            if (greg.get_template(qualified_target) != null) { return; }
        }
        const impl_this: TypeRef = this.lookup_type_by_sym(node.target_type);
        this.visit_methods(node.methods, impl_this);
    }

    /// Type-check all method bodies in a type or impl block.
    visit_methods(mut &this, methods: MethodNode*[], owner_type: TypeRef) -> void {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const method: MethodNode* = methods[i];
            if (method == null || method.func == null || method.func.body == null) {
                continue;
            }
            // Skip generic methods: their bodies contain unsubstituted
            // type parameters (T) that can't be resolved until monomorphization.
            if (method.func.is_generic()) { continue; }
            // Skip self-returning trait-default templates (combinators): they
            // are instantiated lazily at call sites and only their concrete
            // specializations (with the flag cleared) carry resolvable types.
            // Checking the template would re-derive the self-application
            // (`Adapter<Adapter<…>>`) the lazy path exists to avoid.
            if (method.func.is_self_returning_default) { continue; }
            // `this` resolves to the bare owner type (reference
            // semantics: `&this` is transparent at expression level,
            // like Rust's `&self`).  The pointer-vs-value distinction
            // is handled at call sites during overload resolution via
            // the implicit-convert pass (see `resolve_method_overload`).
            const method_this: TypeRef = if (method.is_static) {
                TypeRef::invalid()
            } else {
                owner_type
            };
            const saved_owner: TypeRef = this.current_owner_type;
            this.current_owner_type = owner_type;
            this.enter_function(method.func, method_this);
            // Resolve base-class constructor args so codegen can read
            // `arg.resolved_type` (`visit_scope_resolution` needs this to
            // map `NodeKind::Foo` to its enum type, etc.).  Sema's normal
            // body walk doesn't traverse `base_ctor_args` since they live
            // on MethodNode, not in the function body.
            if (method.is_constructor && method.has_base_ctor()) {
                for (mut k: i64 = 0; k < method.base_ctor_args.length; k++) {
                    this.resolve_expr(method.base_ctor_args[k]);
                }
            }
            this.visit(method.func.body);
            this.body_count += 1;
            // Constructors and destructors return the receiver / void
            // by convention; no explicit return required.  Everyone
            // else gets the all-paths check.
            if (!method.is_constructor && !method.is_destructor) {
                this.check_function_returns(method.func);
            }
            this.current_owner_type = saved_owner;
        }
    }


    // Statement Visitors

    /// Dispatch a StatementNode* to the correct typed visitor override
    /// via double-dispatch.  Each statement kind has an `override visit()`
    /// below.  Unknown kinds fall through to BaseASTVisitor's no-op
    /// default.
    dispatch_stmt(mut &this, stmt: StatementNode*) -> void {
        if (stmt == null) { return; }
        stmt.accept(this);
    }

    /// Non-overloaded block visitor.  All function-body and block visits
    /// route through here instead of relying on overloaded virtual
    /// dispatch (this.visit(BlockStmtNode*)), which may resolve to the
    /// wrong visit() overload when the compiler sees BlockStmtNode* as
    /// StatementNode*.
    override visit(mut &this, block: BlockStmtNode*) -> void {
        if (block == null) { return; }
        const save: i64 = this.save_scope();
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            this.dispatch_stmt(block.statements[i]);
        }
        this.restore_scope(save);
    }

    override visit(mut &this, node: ExprStmtNode*) -> void {
        this.resolve_expr(node.expression);
    }

    override visit(mut &this, node: DeclStmtNode*) -> void {
        if (node.declaration == null) { return; }
        const decl: ASTNode* = node.declaration;
        if (decl.kind == NodeKind::DestructureDeclaration) {
            this.visit(decl as DestructureDeclNode*);
            return;
        }
        if (decl.kind != NodeKind::VariableDeclaration) { return; }

        const var_node: VarDeclNode* = decl as VarDeclNode*;

        // Enforce the lambda-only inference rule (the parser deliberately
        // allows `const name = expr;` without a `:T` annotation; sema is
        // the gate).  An untyped binding is legal only when the
        // initializer is a lambda expression - any other shape would be
        // implicit variable typing, which Cryo doesn't offer.  Missing
        // initializer too is rejected: a fully-empty `const name;` has
        // no shape to infer from.  Skip the check when the binding
        // already carries a resolved type (synthesised declarations -
        // closure-struct __call__ shadows, drop-insertion's flag
        // locals - bypass parser-level annotation but always have
        // their resolved_type stamped at construction time).  Also
        // skip for `is_auto` bindings: those are compiler-synthesised
        // vars (today: the `__cryo_for_iter_N` iterator binding emitted
        // by the for-in desugar) whose type is taken from their
        // initializer once it's been resolved, mirroring the lambda
        // back-fill below.
        if (var_node.type_annotation == null && !var_node.has_resolved_type()
                && !var_node.is_auto) {
            const init: ExpressionNode* = var_node.initializer;
            const init_is_lambda: boolean = init != null
                && (init as ASTNode*).kind == NodeKind::LambdaExpression;
            if (!init_is_lambda) {
                const var_name: string = this.intern.resolve(var_node.name);
                const msg: string = if (init == null) {
                    format("variable `%s` needs a type annotation: write `: T` or initialise with a lambda expression",
                           var_name)
                } else {
                    format("variable `%s` needs a type annotation; type inference is only available for lambda initializers (`(params) -> Ret { ... }`)",
                           var_name)
                };
                mut diag: Diagnostic = Diagnostic::error(
                    ErrorCode::E0104_EXPECTED_TYPE, msg);
                diag = diag.at_with_label(var_node.span,
                    "missing `:` and type annotation");
                this.ctx.emit_diagnostic(diag);
            }
        }

        // Lazy-resolve the type annotation if earlier passes missed it, e.g.
        // VarDecls living inside a match-expression arm body (like
        // `const te: TypeofExprNode* = ...` in resolve_expr's Typeof arm).
        // `resolve_body_locals` in the monomorphizer recurses into match
        // STATEMENTS but not match EXPRESSIONS, so those VarDecls arrive
        // here with `resolved_type` invalid.  Without this, codegen's
        // `codegen_local_var` skips the alloca (map_type on invalid
        // TypeRef returns null) and downstream member-accesses on the
        // binding evaluate to null.
        if (!var_node.has_resolved_type() && var_node.type_annotation != null
                && this.ctx.type_resolver != null) {
            // Resolve any `typeof(expr)` operands now, while their operands
            // are in scope; the TypeResolver reads the cached type below.
            this.prime_typeof_annotation(var_node.type_annotation);
            mut res_ctx: ResolutionContext = ResolutionContext::new(
                this.ctx.source_file, "");
            const vtype: TypeRef = this.ctx.type_resolver.resolve(
                var_node.type_annotation, &res_ctx);
            if (vtype.is_valid()) {
                var_node.resolved_type = vtype;
            }
        }

        if (var_node.has_initializer()) {
            // Set expected_type hint so generic calls can resolve to concrete types.
            // E.g. `const x: Result<int, string> = Result::ok(42)`:
            // the declared type guides resolve_scope_call to find the specialization.
            const saved_expected: TypeRef = this.expected_type;
            if (var_node.has_resolved_type()) {
                this.expected_type = var_node.resolved_type;
            }
            mut init_type: TypeRef = this.resolve_expr(var_node.initializer);
            this.expected_type = saved_expected;
            // for-in scrutinee back-fill: if this binding was synthesized
            // by the for-in desugar (`is_auto`) and the collection's type
            // doesn't expose `next()` but does expose `iter()`, wrap the
            // initializer with `.iter()` and re-resolve.  Lets `for (x in
            // arr)` work against `Array<T>` / `Slice<T>` / `SliceIter<T>`
            // — anything iterable — while leaving direct-iterator
            // scrutinees (`Range`, user types that `implement trait
            // Iterator`) alone.
            if (var_node.is_auto && init_type.is_valid()
                    && var_node.initializer != null) {
                // Step 1: T[N] fixed-size arrays don't have methods; lower
                // to `Slice::from_raw(&<arr>[0], N)` so the iter()-wrap
                // below can dispatch through Slice<T>.
                const arr_t: Type* = this.arena.lookup(init_type.id);
                if (arr_t != null && arr_t.kind == TypeKind::Array) {
                    const at: ArrayType* = arr_t as ArrayType*;
                    if (at.is_fixed()) {
                        const orig_init: ExpressionNode* = var_node.initializer;
                        const sp: SourceSpan = orig_init.span;
                        // &<orig_init>[0]
                        const zero_lit: LiteralNode* = new LiteralNode(
                            "0", LiteralKind::Integer, sp);
                        const idx: ArrayAccessNode* = new ArrayAccessNode(
                            orig_init, zero_lit as ExpressionNode*, sp);
                        const amp_tok: Token = Token::new(
                            TokenType::Amp, "&",
                            sp.start_line as int, sp.start_col as int);
                        mut amp: UnaryExprNode* = new UnaryExprNode(
                            amp_tok, idx as ExpressionNode*, sp);
                        amp.is_synthetic = true;
                        // N (size)
                        const n_str: string = format("%ld", at.size);
                        const n_lit: LiteralNode* = new LiteralNode(
                            n_str, LiteralKind::Integer, sp);
                        // Slice<T>::from_raw(&arr[0], N).  Slice is in the
                        // prelude so this resolves without any explicit
                        // import in the user's file.  We carry T as an
                        // explicit scope-level generic arg using
                        // `pre_resolved` (sema runs after mono, so the
                        // mono's value-arg→type-arg inference engine
                        // never sees this synthesized call; passing T
                        // explicitly is the cheap path).
                        const slice_sym: SymbolStr = this.intern.intern("Slice");
                        const from_raw_sym: SymbolStr = this.intern.intern("from_raw");
                        mut sr: ScopeResolutionNode* = new ScopeResolutionNode(
                            slice_sym, from_raw_sym, sp);
                        mut elt_named: NamedAnnotation* =
                            new NamedAnnotation {
                                name:         SymbolStr::empty(),
                                span:         sp,
                                pre_resolved: at.element,
                            };
                        const elt_ann: TypeAnnotation* =
                            new TypeAnnotation::Named(elt_named);
                        mut gen_args: TypeAnnotation*[] = [];
                        gen_args.push(elt_ann);
                        sr.set_scope_generic_args(gen_args);
                        mut call: CallExprNode* = new CallExprNode(
                            sr as ExpressionNode*, sp);
                        call.add_argument(amp as ExpressionNode*);
                        call.add_argument(n_lit as ExpressionNode*);
                        var_node.set_initializer(call as ExpressionNode*);
                        init_type = this.resolve_expr(var_node.initializer);
                    }
                }
                // Step 2: nominal scrutinee that's iterable-but-not-iterator.
                // If type doesn't expose `next()` but does expose `iter()`,
                // wrap with `.iter()` and re-resolve.  Covers Array<T>,
                // Slice<T>, and (after step 1) the lowered T[N] case.
                mut lookup_ref: TypeRef = init_type;
                mut t: Type* = this.arena.lookup(init_type.id);
                mut depth: i32 = 0;
                while (t != null && depth < 5) {
                    if (t.kind == TypeKind::Pointer) {
                        const pt: PointerType* = t as PointerType*;
                        lookup_ref = pt.pointee;
                        t = this.arena.lookup(lookup_ref.id);
                    } else if (t.kind == TypeKind::Reference) {
                        const rt: ReferenceType* = t as ReferenceType*;
                        lookup_ref = rt.referent;
                        t = this.arena.lookup(lookup_ref.id);
                    } else if (t.kind == TypeKind::InstantiatedType) {
                        const inst: InstantiatedType* = t as InstantiatedType*;
                        if (!inst.has_resolved_type()) { break; }
                        lookup_ref = inst.resolved_type;
                        t = this.arena.lookup(lookup_ref.id);
                    } else {
                        break;
                    }
                    depth += 1;
                }
                const type_sym: SymbolStr = this.lookup_type_sym(lookup_ref);
                if (type_sym.is_valid()) {
                    const next_sym: SymbolStr = this.intern.intern("next");
                    const next_ret: TypeRef = this.lookup_method_return(
                        type_sym, next_sym);
                    if (!next_ret.is_valid()) {
                        const iter_sym: SymbolStr = this.intern.intern("iter");
                        const iter_ret: TypeRef = this.lookup_method_return(
                            type_sym, iter_sym);
                        if (iter_ret.is_valid()) {
                            const orig_init: ExpressionNode* = var_node.initializer;
                            const wrap_span: SourceSpan = orig_init.span;
                            mut iter_member: MemberAccessNode* =
                                new MemberAccessNode(orig_init, iter_sym,
                                                     wrap_span, wrap_span);
                            mut iter_call: CallExprNode* =
                                new CallExprNode(iter_member as ExpressionNode*,
                                                 wrap_span);
                            var_node.set_initializer(iter_call as ExpressionNode*);
                            init_type = this.resolve_expr(var_node.initializer);
                        }
                    }
                }
            }
            if (this.ctx.debug_mode) {
                const _dbg_name: string = this.intern.resolve(var_node.name);
                cdebug("[Sema:DeclStmt] var '%s' has_resolved=%d init_valid=%d resolved_id=%llu init_id=%llu\n",
                    _dbg_name,
                    var_node.has_resolved_type() as i32,
                    init_type.is_valid() as i32,
                    var_node.resolved_type.id,
                    init_type.id);
            }
            // Untyped lambda-binding form: `const f = (x:i32) -> i32 { ... };`.
            // The user elided the redundant `: (i32) -> i32` annotation; we
            // back-fill `resolved_type` from the lambda's own signature so
            // codegen sees a normally-typed binding (the alloca slot needs
            // this).  Only fires for the elided form - explicitly-typed
            // bindings keep their declared type and let the assignment
            // check below catch mismatches.
            //
            // Same back-fill is used by `is_auto` bindings, which today
            // are the `__cryo_for_iter_N` locals the for-in desugar emits.
            // The initializer's resolved_type IS the iterator type; we
            // copy it onto the binding so downstream calls to `.next()`
            // and the scope-exit drop see a normally-typed local.
            if (!var_node.has_resolved_type() && init_type.is_valid()
                    && var_node.initializer != null
                    && ((var_node.initializer as ASTNode*).kind == NodeKind::LambdaExpression
                        || var_node.is_auto)) {
                var_node.resolved_type = init_type;
            }
            if (var_node.has_resolved_type() && init_type.is_valid()) {
                // Declared type exists; check that the initializer is compatible
                if (!this.checker.can_assign(init_type, var_node.resolved_type)) {
                    const var_name: string = this.intern.resolve(var_node.name);
                    // Primary span: the offending initializer expression.
                    // Secondary span: the type annotation it doesn't match
                    // (renders as the "expected because of this" caret
                    // when both spans live on the same source line).
                    const value_span: SourceSpan =
                        if (var_node.initializer != null) {
                            var_node.initializer.span
                        } else {
                            var_node.span
                        };
                    const ann_span: SourceSpan = annotation_span(var_node.type_annotation);
                    this.emit_type_mismatch_with_value(
                        ErrorCode::E0200_TYPE_MISMATCH,
                        value_span,
                        var_node.resolved_type,
                        init_type,
                        format("`%s` was declared with this type; the initializer must match",
                               var_name),
                        ann_span,
                        var_node.initializer);
                }
            }
        }
        // Register the local variable.  Prefer the declared type annotation;
        // fall back to the initializer's inferred type so that variables
        // with unresolved annotations (e.g., cross-module types not yet in
        // the arena) still get registered and don't cause cascading
        // "undefined variable" errors in downstream usage.
        if (var_node.resolved_type.is_valid()) {
            this.register_local_with_mut(var_node.name, var_node.resolved_type, var_node.is_mutable);
        } else if (var_node.has_initializer()) {
            const init_type: TypeRef = var_node.initializer.resolved_type;
            if (init_type.is_valid()) {
                this.register_local_with_mut(var_node.name, init_type, var_node.is_mutable);
            } else {
                // Neither declared type nor initializer type resolved.
                // Register with void to prevent cascading "undefined variable" errors.
                this.register_local_with_mut(var_node.name, this.arena.get_void(), var_node.is_mutable);
            }
        } else {
            // No type annotation resolved and no initializer; register with void
            // to keep the variable visible in scope.
            this.register_local(var_node.name, this.arena.get_void());
        }
        // Stash the parser-stamped keyword span so a later E0218 on this
        // binding can suggest "make it `mut`" with the right anchor.
        this.record_local_kw_span(var_node.name, var_node.kw_span);
    }

    /// Type-check a struct destructure declaration: `const { f1, f2: alias }: T = expr;`.
    /// Validates the RHS resolves to a struct/class, that every binding entry
    /// names a real field, that no field is duplicated, and that all of the
    /// type's fields are bound (until rest patterns land).  Registers each
    /// local with its field's resolved type.
    override visit(mut &this, node: DestructureDeclNode*) -> void {
        // Lazy-resolve the type annotation (mirrors visit_decl_stmt's pattern).
        if (!node.has_resolved_type() && node.type_annotation != null
                && this.ctx.type_resolver != null) {
            mut res_ctx: ResolutionContext = ResolutionContext::new(
                this.ctx.source_file, "");
            const ttype: TypeRef = this.ctx.type_resolver.resolve(
                node.type_annotation, &res_ctx);
            if (ttype.is_valid()) {
                node.resolved_type = ttype;
            }
        }

        // Resolve and type-check the initializer against the declared type.
        if (node.has_initializer()) {
            const saved_expected: TypeRef = this.expected_type;
            if (node.has_resolved_type()) {
                this.expected_type = node.resolved_type;
            }
            const init_type: TypeRef = this.resolve_expr(node.initializer);
            this.expected_type = saved_expected;
            if (node.has_resolved_type() && init_type.is_valid()) {
                if (!this.checker.can_assign(init_type, node.resolved_type)) {
                    const value_span: SourceSpan =
                        if (node.initializer != null) {
                            node.initializer.span
                        } else {
                            node.span
                        };
                    const ann_span: SourceSpan = annotation_span(node.type_annotation);
                    this.emit_type_mismatch_with_value(
                        ErrorCode::E0200_TYPE_MISMATCH,
                        value_span,
                        node.resolved_type,
                        init_type,
                        "destructure pattern's declared type must match the initializer",
                        ann_span,
                        node.initializer);
                }
            }
        }

        // Look up the struct fields and validate each binding.  If the
        // declared type doesn't resolve to a struct/class with a populated
        // field list, register all bindings as void so downstream uses don't
        // emit cascading "undefined variable" errors.
        if (!node.has_resolved_type()) {
            this.register_destructure_locals_void(node);
            return;
        }

        const ty: Type* = this.arena.lookup(node.resolved_type.id);
        if (ty == null) {
            this.register_destructure_locals_void(node);
            return;
        }

        // Pull fields off StructType / ClassType.  Other type kinds (Reference,
        // Pointer, primitives, etc.) are not destructurable.
        mut fields_ptr: FieldInfo[] = [];
        mut got_fields: boolean = false;
        if (ty.kind == TypeKind::Struct) {
            const st: StructType* = ty as StructType*;
            fields_ptr = st.fields;
            got_fields = true;
        } else if (ty.kind == TypeKind::Class) {
            const ct: ClassType* = ty as ClassType*;
            fields_ptr = ct.fields;
            got_fields = true;
        }

        if (!got_fields) {
            const ty_sym: SymbolStr = this.intern.intern(this.arena.format_display(ty));
            const ty_name: string = this.intern.resolve(ty_sym);
            this.ctx.emit_error_at(ErrorCode::E0361_DESTRUCTURE_NON_STRUCT,
                format("cannot destructure non-struct type '%s'", ty_name),
                node.span);
            this.register_destructure_locals_void(node);
            return;
        }

        // For each binding entry: look up field by source name, check for
        // duplicates among earlier bindings, write the resolved type back to
        // the AST, and register the local in scope.
        for (mut i: i64 = 0; i < node.bindings.length; i++) {
            mut b: DestructureBinding = node.bindings[i];

            // Duplicate detection: walk earlier bindings.
            mut dup: boolean = false;
            for (mut j: i64 = 0; j < i; j++) {
                if (node.bindings[j].source_field.id == b.source_field.id) {
                    dup = true;
                    break;
                }
            }
            if (dup) {
                const dup_name: string = this.intern.resolve(b.source_field);
                mut diag: Diagnostic = Diagnostic::error(
                    ErrorCode::E0356_DUPLICATE_FIELD,
                    format("field `%s` bound more than once in destructure",
                        dup_name));
                diag = diag.at_with_label(b.span,
                    format("duplicate binding for `%s`", dup_name));
                // Machine-applicable removal: drop everything from just
                // after the previous binding (which always exists for
                // dup==true since j<i) up through the duplicate's end.
                // That captures the `, dup_name` slice; the comma that
                // separates the prev binding from this one goes with it.
                const prev: DestructureBinding = node.bindings[i - 1];
                if (prev.span.has_location() && b.span.has_location()) {
                    const removal: SourceSpan = SourceSpan::new(
                        b.span.file,
                        prev.span.end_line, prev.span.end_col,
                        b.span.end_line, b.span.end_col);
                    diag = diag.suggest(Suggestion::machine_applicable(
                        removal, "",
                        format("remove the duplicate binding `%s`", dup_name)));
                }
                this.ctx.emit_diagnostic(diag);
                this.register_local_with_mut(b.local_name, this.arena.get_void(),
                    b.is_mutable);
                continue;
            }

            // Field lookup.
            mut field_type: TypeRef = TypeRef::invalid();
            mut found: boolean = false;
            for (mut k: i64 = 0; k < fields_ptr.length; k++) {
                if (fields_ptr[k].name.id == b.source_field.id) {
                    field_type = fields_ptr[k].field_type;
                    found = true;
                    break;
                }
            }
            if (!found) {
                const field_name: string = this.intern.resolve(b.source_field);
                const ty_sym: SymbolStr = this.intern.intern(this.arena.format_display(ty));
                const ty_name: string = this.intern.resolve(ty_sym);
                mut diag: Diagnostic = Diagnostic::error(
                    ErrorCode::E0350_STRUCT_FIELD_NOT_FOUND,
                    format("no field `%s` on type `%s`", field_name, ty_name));
                diag = diag.at_with_label(b.span, "unknown field");
                // Candidate pool: the struct's actual field names.
                mut cands: string[] = [];
                for (mut k: i64 = 0; k < fields_ptr.length; k++) {
                    cands.push(this.intern.resolve(fields_ptr[k].name));
                }
                diag = this.attach_did_you_mean(diag, field_name, cands,
                                                "field", b.span);
                this.ctx.emit_diagnostic(diag);
                this.register_local_with_mut(b.local_name, this.arena.get_void(),
                    b.is_mutable);
                continue;
            }

            // Write field type back to the binding so codegen has it without
            // re-doing the lookup.
            b.resolved_type = field_type;
            node.bindings[i] = b;

            // Register in scope.
            this.register_local_with_mut(b.local_name, field_type, b.is_mutable);
        }

        // Completeness check: every field of the struct must be bound.
        // (Rest patterns are post-v1; until then, partial destructure is
        // an error rather than implicitly leaving fields un-moved.)
        if (node.bindings.length < fields_ptr.length) {
            mut missing: string = "";
            mut count: i64 = 0;
            for (mut k: i64 = 0; k < fields_ptr.length; k++) {
                mut bound: boolean = false;
                for (mut bi: i64 = 0; bi < node.bindings.length; bi++) {
                    if (node.bindings[bi].source_field.id == fields_ptr[k].name.id) {
                        bound = true;
                        break;
                    }
                }
                if (!bound) {
                    if (count > 0) { missing = format("%s, %s", missing, this.intern.resolve(fields_ptr[k].name)); }
                    else { missing = this.intern.resolve(fields_ptr[k].name); }
                    count++;
                }
            }
            const ty_sym: SymbolStr = this.intern.intern(this.arena.format_display(ty));
            const ty_name: string = this.intern.resolve(ty_sym);
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0362_DESTRUCTURE_INCOMPLETE,
                format("destructure of `%s` must bind all %lld field(s); missing: %s",
                    ty_name, fields_ptr.length, missing));
            diag = diag.at_with_label(node.span,
                format("missing %lld field%s",
                    count, if (count == 1) { "" } else { "s" }));

            // Machine-applicable insert: append `, <missing_fields>` just
            // after the last existing binding.  Skipped when there are
            // no existing bindings (the empty-pattern path is rejected
            // earlier) or the last binding span is missing.
            if (node.bindings.length > 0) {
                const last: DestructureBinding =
                    node.bindings[node.bindings.length - 1];
                if (last.span.has_location()) {
                    mut repl: string = "";
                    for (mut k: i64 = 0; k < fields_ptr.length; k++) {
                        mut bound: boolean = false;
                        for (mut bi: i64 = 0; bi < node.bindings.length; bi++) {
                            if (node.bindings[bi].source_field.id
                                    == fields_ptr[k].name.id) {
                                bound = true; break;
                            }
                        }
                        if (!bound) {
                            const fname: string =
                                this.intern.resolve(fields_ptr[k].name);
                            repl = format("%s, %s", repl, fname);
                        }
                    }
                    const ins: SourceSpan = SourceSpan::new(
                        last.span.file,
                        last.span.end_line, last.span.end_col,
                        last.span.end_line, last.span.end_col);
                    diag = diag.suggest(Suggestion::machine_applicable(
                        ins, repl,
                        if (count == 1) {
                            "bind the missing field"
                        } else {
                            "bind the missing fields"
                        }));
                }
            }
            this.ctx.emit_diagnostic(diag);
        }
    }

    /// Fallback: register every destructure binding as a void-typed local.
    /// Used when the declared type doesn't resolve, so downstream uses of the
    /// new bindings still find them in scope (avoiding cascading errors).
    register_destructure_locals_void(mut &this, node: DestructureDeclNode*) -> void {
        for (mut i: i64 = 0; i < node.bindings.length; i++) {
            const b: DestructureBinding = node.bindings[i];
            this.register_local_with_mut(b.local_name, this.arena.get_void(),
                b.is_mutable);
        }
    }

    override visit(mut &this, node: ReturnStmtNode*) -> void {
        if (node.has_expression()) {
            // Set expected_type to the function's return type so that
            // integer literals adopt the correct type (e.g., `return 8`
            // in a function returning u32 resolves the literal as u32,
            // not the default i32).
            const saved_expected: TypeRef = this.expected_type;
            if (this.return_type.is_valid()) {
                this.expected_type = this.return_type;
            }
            const expr_type: TypeRef = this.resolve_expr(node.expression);
            this.expected_type = saved_expected;
            if (expr_type.is_valid() && this.return_type.is_valid()) {
                if (!this.checker.can_assign(expr_type, this.return_type)) {
                    const value_span: SourceSpan =
                        if (node.expression != null) {
                            node.expression.span
                        } else {
                            node.span
                        };
                    const ann_span: SourceSpan = annotation_span(this.return_type_ann);
                    this.emit_type_mismatch_with_value(
                        ErrorCode::E0200_TYPE_MISMATCH,
                        value_span,
                        this.return_type,
                        expr_type,
                        "the function's declared return type doesn't match the value returned here",
                        ann_span,
                        node.expression);
                }
            }
            if (this.return_type.is_valid()) {
                this.check_return_payload_escape(node.expression, this.return_type);
            }
            // H5: returning `&local` / `&param` is a dangling pointer - the
            // stack slot is freed when the function returns.
            this.check_return_stack_address(node.expression);
        }
    }

    /// True when `name` resolves to a function-local binding or parameter
    /// (registered in `locals` by `enter_function` / `register_local`).
    /// Globals are resolved through the scope chain and are absent here,
    /// so `&GLOBAL` is correctly not treated as a stack escape.
    is_local_or_param(&this, name: SymbolStr) -> boolean {
        match (this.locals.get(&name.id)) {
            Option::Some(_) => { return true; }
            Option::None    => { return false; }
        }
    }

    /// True when `name` is one of the current function's parameters (or
    /// `this`).  Parameters are autoref'd (caller-backed), so `&param`
    /// re-borrows caller storage rather than escaping a stack slot.
    is_param(&this, name: SymbolStr) -> boolean {
        for (mut i: i64 = 0; i < this.param_ids.length; i++) {
            if (this.param_ids[i] == name.id) { return true; }
        }
        return false;
    }

    /// Reject `return &x` where `x` is a local variable or parameter:
    /// taking the address of a stack slot and returning it produces a
    /// dangling pointer (use-after-free at the call site).  Looks through
    /// `if`/`match` tail positions like the payload-escape check.
    check_return_stack_address(mut &this, e: ExpressionNode*) -> void {
        if (e == null) { return; }
        if (e.kind == NodeKind::IfExpression) {
            const ie: IfExprNode* = e as IfExprNode*;
            this.check_return_stack_address(ie.then_expr);
            this.check_return_stack_address(ie.else_expr);
            return;
        }
        if (e.kind == NodeKind::MatchExpression) {
            const me: MatchExprNode* = e as MatchExprNode*;
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                const arm: MatchArmNode* = me.arms[i];
                if (arm == null) { continue; }
                this.check_return_stack_address(this.arm_tail_expr(arm.body));
            }
            return;
        }
        if (e.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = e as UnaryExprNode*;
            if (u.op.lexeme == "&" && u.operand != null
                    && u.operand.kind == NodeKind::Identifier) {
                const id: IdentifierNode* = u.operand as IdentifierNode*;
                // Only a function-body local is a genuine stack-slot escape.
                // Parameters and `this` are autoref'd (caller-backed), so
                // `&param` re-borrows the caller's storage (this is the
                // `return &this` builder-chaining idiom) and is safe.
                if (this.is_local_or_param(id.name) && !this.is_param(id.name)) {
                    this.ctx.emit_error_at(
                        ErrorCode::E0455_DANGLING_POINTER,
                        "cannot return the address of a local variable: it lives on this function's stack frame and is freed when the function returns. Return the value by move, or a heap allocation, instead.",
                        e.span);
                }
            }
        }
    }

    // -- Match-payload borrow-escape detection (E0455) ------------------
    //
    // A `match` arm pattern `Variant(p)` binds `p` to the payload of a
    // value the codegen materialises into a stack temporary, so a
    // pointer/reference to `p` is only valid until the enclosing function
    // returns.  Returning such a borrow (e.g. `JsonValue::as_object`'s old
    // `match (this) { Object(o) => Some(o) }`) compiled fine but produced a
    // dangling pointer -> use-after-free at runtime.  These checks reject
    // the escape at compile time.  Returning the payload BY VALUE (a move /
    // copy, e.g. `Option::unwrap`'s `return value`) is unaffected: the
    // discriminator is whether the return type carries a *pointer* to the
    // binding's value type.

    is_payload_binding(&this, name: SymbolStr) -> boolean {
        if (!name.is_valid()) { return false; }
        for (mut i: i64 = 0; i < this.payload_binding_ids.length; i++) {
            if (this.payload_binding_ids[i] == name.id) { return true; }
        }
        return false;
    }

    /// Type identity that tolerates arena-id differences for the same
    /// named type.  Under `cryo check` (single-file frontend) a generic
    /// instantiation like `Option<Inner*>` can carry an `Inner` whose arena
    /// id differs from the `Inner` a match payload binding resolves to, even
    /// though they are the same struct.  Fall back to comparing qualified
    /// names so the borrow-escape check fires under `check` as well as a
    /// full build.
    types_equivalent(&this, a: TypeRef, b: TypeRef) -> boolean {
        if (a.id == b.id) { return true; }
        const ta: Type* = this.arena.lookup(a.id);
        const tb: Type* = this.arena.lookup(b.id);
        if (ta == null || tb == null) { return false; }
        if (ta.kind != tb.kind) { return false; }
        if (ta.kind == TypeKind::Struct || ta.kind == TypeKind::Class ||
            ta.kind == TypeKind::Enum) {
            const qa: SymbolStr = this.arena.get_qualified_name(a);
            const qb: SymbolStr = this.arena.get_qualified_name(b);
            return qa.is_valid() && qb.is_valid() && qa.equals(qb);
        }
        return false;
    }

    /// True when `t` is a pointer/reference whose pointee is the same type
    /// as `v` (by id or, robustly, by qualified name).
    is_ptr_or_ref_to(&this, t: TypeRef, v: TypeRef) -> boolean {
        const ty: Type* = this.arena.lookup(t.id);
        if (ty == null) { return false; }
        if (ty.kind == TypeKind::Pointer) {
            return this.types_equivalent((ty as PointerType*).pointee, v);
        }
        if (ty.kind == TypeKind::Reference) {
            return this.types_equivalent((ty as ReferenceType*).referent, v);
        }
        return false;
    }

    /// True when the return type carries a pointer/reference to `v` -
    /// directly (`v*` / `&v`) or as a payload of an Option/Result-shaped
    /// instantiation (`Option<v*>`, `Result<v*, E>`).  Returning the
    /// payload by value (return type carries `v`, not `v*`) is NOT a match.
    ret_carries_pointer_to(&this, ret_ty: TypeRef, v: TypeRef) -> boolean {
        if (this.is_ptr_or_ref_to(ret_ty, v)) { return true; }
        const t: Type* = this.arena.lookup(ret_ty.id);
        if (t != null && t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                if (this.is_ptr_or_ref_to(inst.type_args[i], v)) { return true; }
            }
        }
        return false;
    }

    /// True when `callee` names a variant of the enum `ret_ty` resolves to,
    /// so `Some`/`Ok`/`Err`-style constructors are recognised while plain
    /// function calls (which merely borrow their argument) are not.
    callee_names_ret_variant(&this, callee: ExpressionNode*, ret_ty: TypeRef) -> boolean {
        if (callee == null) { return false; }
        mut leaf: SymbolStr = SymbolStr::empty();
        if (callee.kind == NodeKind::Identifier) {
            leaf = (callee as IdentifierNode*).name;
        } else if (callee.kind == NodeKind::ScopeResolution) {
            leaf = (callee as ScopeResolutionNode*).member_name;
        } else {
            return false;
        }
        if (!leaf.is_valid()) { return false; }
        const et: Type* = this.unwrap_to_enum(ret_ty);
        if (et == null || et.kind != TypeKind::Enum) { return false; }
        const e: EnumType* = et as EnumType*;
        for (mut i: i64 = 0; i < e.variants.length; i++) {
            if (e.variants[i].name.equals(leaf)) { return true; }
        }
        return false;
    }

    /// Trailing value expression of a match-expression arm body (a braced
    /// block's last expression statement, or a bare expression statement).
    arm_tail_expr(&this, stmt: StatementNode*) -> ExpressionNode* {
        if (stmt == null) { return null; }
        if (stmt.kind == NodeKind::ExpressionStatement) {
            return (stmt as ExprStmtNode*).expression;
        }
        if (stmt.kind == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = stmt as BlockStmtNode*;
            for (mut i: i64 = blk.statements.length - 1; i >= 0; i -= 1) {
                const s: StatementNode* = blk.statements[i];
                if (s == null) { continue; }
                if (s.kind == NodeKind::ExpressionStatement) {
                    return (s as ExprStmtNode*).expression;
                }
                return null;
            }
        }
        return null;
    }

    check_return_payload_escape(mut &this, e: ExpressionNode*, ret_ty: TypeRef) -> void {
        if (e == null) { return; }
        // Bare payload binding returned directly as a pointer/reference.
        if (e.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = e as IdentifierNode*;
            if (this.is_payload_binding(id.name)
                    && this.ret_carries_pointer_to(ret_ty, id.resolved_type)) {
                this.emit_payload_escape(e.span);
            }
            return;
        }
        // `Some(p)` / `Ok(p)` / `Err(p)` wrapping a bare payload binding.
        if (e.kind == NodeKind::CallExpression) {
            const c: CallExprNode* = e as CallExprNode*;
            if (c.arguments.length == 1 && c.arguments[0] != null
                    && c.arguments[0].kind == NodeKind::Identifier
                    && this.callee_names_ret_variant(c.callee, ret_ty)) {
                const id: IdentifierNode* = c.arguments[0] as IdentifierNode*;
                if (this.is_payload_binding(id.name)
                        && this.ret_carries_pointer_to(ret_ty, id.resolved_type)) {
                    this.emit_payload_escape(c.arguments[0].span);
                }
            }
            return;
        }
        // `return match (...) { arm => <tail> }` and `if`-expression results.
        if (e.kind == NodeKind::MatchExpression) {
            const me: MatchExprNode* = e as MatchExprNode*;
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                const arm: MatchArmNode* = me.arms[i];
                if (arm == null) { continue; }
                this.check_return_payload_escape(this.arm_tail_expr(arm.body), ret_ty);
            }
            return;
        }
        if (e.kind == NodeKind::IfExpression) {
            const ie: IfExprNode* = e as IfExprNode*;
            this.check_return_payload_escape(ie.then_expr, ret_ty);
            this.check_return_payload_escape(ie.else_expr, ret_ty);
            return;
        }
    }

    emit_payload_escape(mut &this, span: SourceSpan) -> void {
        this.ctx.emit_error_at(
            ErrorCode::E0455_DANGLING_POINTER,
            "cannot return a pointer or reference to a value bound by `match`: the payload lives in a temporary that is freed when the function returns. Return it by value (move the payload out) instead.",
            span);
    }

    override visit(mut &this, node: IfStmtNode*) -> void {
        this.resolve_expr(node.condition);
        this.dispatch_stmt(node.then_stmt);
        if (node.has_else()) {
            this.dispatch_stmt(node.else_stmt);
        }
    }

    override visit(mut &this, node: WhileStmtNode*) -> void {
        this.resolve_expr(node.condition);
        this.loop_depth += 1;
        this.dispatch_stmt(node.body);
        this.loop_depth -= 1;
    }

    override visit(mut &this, node: DoWhileStmtNode*) -> void {
        this.loop_depth += 1;
        this.dispatch_stmt(node.body);
        this.loop_depth -= 1;
        this.resolve_expr(node.condition);
    }

    override visit(mut &this, node: ForStmtNode*) -> void {
        // For-loop init variable lives in its own scope so it's visible to
        // condition, update, and body, but doesn't leak out.
        const save: i64 = this.save_scope();

        if (node.init != null) {
            if (node.init.kind == NodeKind::DeclarationStatement) {
                this.visit(node.init as DeclStmtNode*);
            } else if (node.init.kind == NodeKind::VariableDeclaration) {
                // Parser produces a raw VarDeclNode (not wrapped in DeclStmtNode)
                // for C-style for-loop initializers: for (mut i: int = 0; ...)
                const var_node: VarDeclNode* = node.init as VarDeclNode*;
                // Same lambda-only inference rule as `visit(DeclStmtNode)`:
                // a for-loop init `for (mut i = 0; ...)` is missing its
                // type annotation and isn't a lambda - it must spell out
                // `: T`.
                if (var_node.type_annotation == null) {
                    const init_e: ExpressionNode* = var_node.initializer;
                    const init_is_lambda: boolean = init_e != null
                        && (init_e as ASTNode*).kind == NodeKind::LambdaExpression;
                    if (!init_is_lambda) {
                        const var_name: string = this.intern.resolve(var_node.name);
                        const msg: string = format(
                            "for-loop initializer `%s` needs a type annotation; type inference is only available for lambda initializers",
                            var_name);
                        mut diag: Diagnostic = Diagnostic::error(
                            ErrorCode::E0104_EXPECTED_TYPE, msg);
                        diag = diag.at_with_label(var_node.span,
                            "missing `:` and type annotation");
                        this.ctx.emit_diagnostic(diag);
                    }
                }
                if (var_node.has_initializer()) {
                    this.resolve_expr(var_node.initializer);
                }
                // Register the loop variable using the same fallback chain as
                // visit_decl_stmt: resolved type -> initializer type -> void.
                // This ensures the variable is always visible in the loop body.
                if (var_node.resolved_type.is_valid()) {
                    this.register_local_with_mut(var_node.name, var_node.resolved_type, var_node.is_mutable);
                } else if (var_node.has_initializer() && var_node.initializer.resolved_type.is_valid()) {
                    this.register_local_with_mut(var_node.name, var_node.initializer.resolved_type, var_node.is_mutable);
                } else {
                    this.register_local_with_mut(var_node.name, this.arena.get_i32(), var_node.is_mutable);
                }
            } else if (node.init.kind == NodeKind::ExpressionStatement) {
                const es: ExprStmtNode* = node.init as ExprStmtNode*;
                this.resolve_expr(es.expression);
            }
        }
        if (node.condition != null) { this.resolve_expr(node.condition); }
        if (node.update != null)    { this.resolve_expr(node.update); }
        this.loop_depth += 1;
        this.dispatch_stmt(node.body);
        this.loop_depth -= 1;

        this.restore_scope(save);
    }

    override visit(mut &this, node: MatchStmtNode*) -> void {
        const subject_type: TypeRef = this.resolve_expr(node.subject);
        for (mut i: i64 = 0; i < node.arms.length; i++) {
            const arm: MatchArmNode* = node.arms[i];
            if (arm == null) { continue; }

            const save: i64 = this.save_scope();
            this.bind_arm_patterns(arm, subject_type);
            if (arm.body != null) {
                this.dispatch_stmt(arm.body);
            }
            this.restore_scope(save);
        }
        this.check_match_exhaustive(node.subject, subject_type, node.arms,
            node.span);
        this.check_duplicate_default_arm(node.arms);
        this.check_range_patterns(node.arms, subject_type);
    }

    /// A match may have at most one wildcard (`_`) arm. A second one is
    /// dead code and almost always a mistake, so flag it as E0114. Bare
    /// identifier-binding arms are not counted: they bind a name rather
    /// than being the literal default, and shadowing is checked elsewhere.
    check_duplicate_default_arm(mut &this, arms: MatchArmNode*[]) -> void {
        mut seen_default: boolean = false;
        for (mut i: i64 = 0; i < arms.length; i++) {
            const arm: MatchArmNode* = arms[i];
            if (arm == null) { continue; }
            mut is_default: boolean = false;
            for (mut j: i64 = 0; j < arm.patterns.length; j++) {
                const pat: PatternNode* = arm.patterns[j];
                if (pat == null) { continue; }
                if (pat.pattern_kind == PatternKind::Wildcard) {
                    is_default = true;
                    break;
                }
            }
            if (is_default) {
                if (seen_default) {
                    this.ctx.emit_error_at(
                        ErrorCode::E0114_DUPLICATE_DEFAULT,
                        "duplicate `_` arm: a match may have at most one wildcard arm",
                        arm.span);
                }
                seen_default = true;
            }
        }
    }

    /// Validate `lo..hi` range patterns (`'0'..'9'`, `1..10`) against the
    /// match subject.  Two checks, both real correctness concerns:
    ///   * the bound kind must fit the subject - a `char` range needs a
    ///     `char` subject, and an integer range needs an integer (or `char`)
    ///     subject.  Codegen decodes char vs integer bounds with different
    ///     readers, so a mismatch would silently compare the wrong value.
    ///   * the low bound must not exceed the high bound; `9..0` matches
    ///     nothing and is almost always a typo.
    /// A range never makes a match exhaustive (its value universe stays
    /// open), so this adds no exhaustiveness bookkeeping - non-enum matches
    /// still require a `_` arm via `check_match_exhaustive`.
    check_range_patterns(mut &this, arms: MatchArmNode*[],
                          subject_type: TypeRef) -> void {
        const base: Type* = this.unwrap_to_enum(subject_type);
        for (mut i: i64 = 0; i < arms.length; i++) {
            const arm: MatchArmNode* = arms[i];
            if (arm == null) { continue; }
            for (mut j: i64 = 0; j < arm.patterns.length; j++) {
                const pat: PatternNode* = arm.patterns[j];
                if (pat == null || pat.pattern_kind != PatternKind::Range) {
                    continue;
                }

                if (base != null) {
                    if (pat.literal_kind == LiteralKind::Char
                        && base.kind != TypeKind::Char) {
                        this.ctx.emit_error_at(ErrorCode::E0200_TYPE_MISMATCH,
                            "char range pattern requires a `char` subject",
                            pat.span);
                    } else if (pat.literal_kind == LiteralKind::Integer
                        && base.kind != TypeKind::Int
                        && base.kind != TypeKind::Char) {
                        this.ctx.emit_error_at(ErrorCode::E0200_TYPE_MISMATCH,
                            "integer range pattern requires an integer subject",
                            pat.span);
                    }
                }

                const lo: i64 = sema_decode_range_bound(
                    this.intern.resolve(pat.value), pat.literal_kind);
                const hi: i64 = sema_decode_range_bound(
                    this.intern.resolve(pat.high_value), pat.literal_kind);
                if (lo > hi) {
                    this.ctx.emit_error_at(
                        ErrorCode::E0628_PATTERN_MATCHING_ERROR,
                        format("range pattern lower bound (%lld) exceeds upper bound (%lld)",
                               lo, hi),
                        pat.span);
                }
            }
        }
    }

    /// Check that a match expression / statement covers every variant of
    /// its subject's enum type, or has a wildcard / identifier-binding
    /// arm that catches anything left over.  Skipped for non-enum
    /// subjects (literals, integers, structs etc.); those have an
    /// open universe of values, so exhaustiveness is structural rather
    /// than enumerable.
    check_match_exhaustive(mut &this, subject: ExpressionNode*,
                            subject_type: TypeRef, arms: MatchArmNode*[],
                            match_span: SourceSpan) -> void {
        if (!subject_type.is_valid()) { return; }
        const enum_ty: Type* = this.unwrap_to_enum(subject_type);
        if (enum_ty == null || enum_ty.kind != TypeKind::Enum) { return; }
        const et: EnumType* = enum_ty as EnumType*;
        if (et.variants.length == 0) { return; }

        // Walk arms.  Any wildcard or bare-identifier pattern catches
        // every remaining variant; collect the explicit variant names
        // covered otherwise.
        mut has_wildcard: boolean = false;
        mut covered_ids: u32[] = [];
        for (mut i: i64 = 0; i < arms.length; i++) {
            const arm: MatchArmNode* = arms[i];
            if (arm == null) { continue; }
            for (mut j: i64 = 0; j < arm.patterns.length; j++) {
                const pat: PatternNode* = arm.patterns[j];
                if (pat == null) { continue; }
                if (pat.pattern_kind == PatternKind::Wildcard
                    || pat.pattern_kind == PatternKind::Identifier) {
                    has_wildcard = true;
                    break;
                }
                if (pat.pattern_kind == PatternKind::Enum) {
                    const ep: EnumPatternNode* = pat as EnumPatternNode*;
                    covered_ids.push(ep.variant_name.id);
                }
            }
            if (has_wildcard) { break; }
        }
        if (has_wildcard) { return; }

        // Find variants not in covered_ids.
        mut missing_names: SymbolStr[] = [];
        for (mut i: i64 = 0; i < et.variants.length; i++) {
            const vn: SymbolStr = et.variants[i].name;
            mut covered: boolean = false;
            for (mut k: i64 = 0; k < covered_ids.length; k++) {
                if (covered_ids[k] == vn.id) { covered = true; break; }
            }
            if (!covered) { missing_names.push(vn); }
        }
        if (missing_names.length == 0) { return; }

        // Build a friendly "missing: A, B, C" list.  Cap at 4 names so
        // an enum with many variants doesn't produce a 200-character
        // diagnostic line.
        const enum_name: string = this.intern.resolve(et.qualified_name);
        mut names_str: string = "";
        const cap: i64 = if (missing_names.length < 4) {
            missing_names.length
        } else { 4 };
        for (mut i: i64 = 0; i < cap; i++) {
            const n: string = this.intern.resolve(missing_names[i]);
            if (i == 0) { names_str = format("`%s`", n); }
            else { names_str = format("%s, `%s`", names_str, n); }
        }
        if (missing_names.length > cap) {
            names_str = format("%s, and %lld more",
                names_str, missing_names.length - cap);
        }
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0405_NON_EXHAUSTIVE_MATCH,
            format("non-exhaustive match: not all variants of `%s` are covered",
                enum_name));
        diag = diag.at(match_span);
        if (subject != null) {
            diag = diag.also_at(subject.span,
                "this subject's enum type has variants not handled below");
        }
        diag = diag.with_note(format("missing %s",
            if (missing_names.length == 1) {
                format("variant: %s", names_str)
            } else {
                format("variants: %s", names_str)
            }));
        diag = diag.with_note("add explicit arms for the missing variants, or use `_ => { ... }` to catch the rest");

        // Has-placeholders quickfix: append `<Enum>::<Variant> => { }`
        // for each missing variant, anchored after the last existing arm
        // so the renderer's auto-indent picks up the arm-body indent.
        // Skipped when there are no arms (nothing to anchor to) or when
        // the last arm's span is empty (synthesised input).
        if (arms.length > 0) {
            mut last_arm: MatchArmNode* = null;
            for (mut k: i64 = arms.length - 1; k >= 0; k -= 1) {
                if (arms[k] != null && arms[k].span.has_location()) {
                    last_arm = arms[k];
                    break;
                }
            }
            if (last_arm != null) {
                const anchor: SourceSpan = SourceSpan::new(
                    last_arm.span.file,
                    last_arm.span.end_line, last_arm.span.end_col,
                    last_arm.span.end_line, last_arm.span.end_col);
                // Prefer the subject's bare display name (e.g. `Color`)
                // over the fully-qualified name (`Main::Color`) so the
                // suggestion mirrors the form the user already wrote
                // in the existing arms.
                const short_enum: string = this.arena.resolve_display_name_short(subject_type.id);
                mut repl: string = "";
                for (mut i: i64 = 0; i < missing_names.length; i++) {
                    const vn: string = this.intern.resolve(missing_names[i]);
                    repl = format("%s\n%s::%s => { }", repl, short_enum, vn);
                }
                const sug_msg: string =
                    if (missing_names.length == 1) {
                        "add an arm for the missing variant"
                    } else {
                        "add arms for the missing variants"
                    };
                diag = diag.suggest(Suggestion::single(anchor, repl,
                    sug_msg, Applicability::HasPlaceholders));
            }
        }

        this.ctx.diagnostics.emit(diag);
    }

    override visit(mut &this, node: LoopStmtNode*) -> void {
        this.loop_depth += 1;
        this.dispatch_stmt(node.body);
        this.loop_depth -= 1;
    }

    override visit(mut &this, node: BreakStmtNode*) -> void {
        // `break` is legal inside any loop or switch.
        if (this.loop_depth == 0 && this.switch_depth == 0) {
            this.ctx.emit_error_at(ErrorCode::E0400_INVALID_BREAK,
                "`break` outside of a loop or switch", node.span);
        }
    }

    override visit(mut &this, node: ContinueStmtNode*) -> void {
        // `continue` only applies to loops, not switch.
        if (this.loop_depth == 0) {
            this.ctx.emit_error_at(ErrorCode::E0401_INVALID_CONTINUE,
                "`continue` outside of a loop", node.span);
        }
    }

    override visit(mut &this, node: UnsafeBlockStmtNode*) -> void {
        this.visit(node.block);
    }

    override visit(mut &this, node: SwitchStmtNode*) -> void {
        const subject_type: TypeRef = this.resolve_expr(node.expression);
        this.switch_depth += 1;
        for (mut i: i64 = 0; i < node.cases.length; i++) {
            const cs: CaseStmtNode* = node.cases[i];
            if (cs == null) { continue; }
            if (cs.value != null) { this.resolve_expr(cs.value); }
            if (cs.body != null)  { this.visit(cs.body); }
        }
        this.switch_depth -= 1;
        this.check_switch_applicable(node, subject_type);
    }

    /// Switchability class of a (already-unwrapped) type:
    ///   0 = ordinal (integer / char / bool) - compared by value
    ///   1 = fieldless enum - compared by tag
    ///   2 = enum WITH payloads - needs `match` to destructure
    ///   3 = string - needs `match` (value compare would test addresses)
    ///   4 = floating-point - equality is unreliable; use comparisons
    ///   5 = other structured type (struct/class/tuple/array/...) - use `match`
    ///  -1 = unknown / unresolved
    switch_type_class(&this, base: Type*) -> i32 {
        if (base == null) { return -1; }
        match (base.kind) {
            TypeKind::Int    => { return 0; }
            TypeKind::Char   => { return 0; }
            TypeKind::Bool   => { return 0; }
            TypeKind::Float  => { return 4; }
            TypeKind::String => { return 3; }
            TypeKind::Enum   => {
                const et: EnumType* = base as EnumType*;
                if (et.is_simple_enum()) { return 1; }
                return 2;
            }
            _                => { return 5; }
        }
    }

    /// Validate that a `switch` dispatches on something it can actually
    /// compare - an integer, char, bool, or fieldless enum - and that each
    /// `case` value matches the subject.  Anything else gets a tailored
    /// diagnostic pointing at the right tool (`match`, or plain comparisons).
    /// Runs in sema so `cryo check` rejects it cleanly, before codegen would
    /// emit a bad `icmp` (which would crash on aggregates/floats or silently
    /// compare addresses for strings/payload-carrying enums).
    check_switch_applicable(mut &this, node: SwitchStmtNode*,
                            subject_type: TypeRef) -> void {
        if (!subject_type.is_valid()) { return; }
        const base: Type* = this.unwrap_to_enum(subject_type);
        const sc: i32 = this.switch_type_class(base);
        if (sc == -1) { return; }   // unresolved; a prior pass will diagnose

        if (sc != 0 && sc != 1) {
            this.emit_switch_subject_error(node, subject_type, sc);
            return;   // the subject is the real problem; skip per-case noise
        }

        // Each case value must be the same flavor as the subject (ordinal
        // vs. the exact same enum); otherwise the `icmp` would compare
        // unrelated values.
        for (mut i: i64 = 0; i < node.cases.length; i++) {
            const cs: CaseStmtNode* = node.cases[i];
            if (cs == null || cs.is_default || cs.value == null) { continue; }
            const ct: TypeRef = cs.value.resolved_type;
            if (!ct.is_valid()) { continue; }
            const cbase: Type* = this.unwrap_to_enum(ct);
            const cc: i32 = this.switch_type_class(cbase);

            mut ok: boolean = false;
            if (sc == 0) {
                ok = (cc == 0);                       // ordinal <-> ordinal
            } else {
                ok = (cc == 1 && cbase == base);      // same fieldless enum
            }
            if (!ok) {
                mut d: Diagnostic = Diagnostic::error(
                    ErrorCode::E0200_TYPE_MISMATCH,
                    format("`case` value of type `%s` is not comparable to the switch subject of type `%s`",
                        this.type_display_name(ct),
                        this.type_display_name(subject_type)));
                d = d.at(cs.value.span);
                d = d.with_note("every `case` value must have the same type as the value being switched on");
                this.ctx.diagnostics.emit(d);
            }
        }
    }

    /// Emit the "switch isn't applicable to this type" diagnostic, tailored
    /// to *why* (payload enum, string, float, or other) with a concrete
    /// next step.  `sc` is the subject's `switch_type_class` (2..5).
    emit_switch_subject_error(mut &this, node: SwitchStmtNode*,
                              subject_type: TypeRef, sc: i32) -> void {
        const name: string = this.type_display_name(subject_type);
        const span: SourceSpan = node.expression.span;
        mut msg:   string = "";
        mut note1: string = "";
        mut note2: string = "";
        if (sc == 2) {
            msg   = format("`switch` cannot match on enum `%s`: it has variants that carry payloads", name);
            note1 = "`switch` compares by value and cannot bind variant payloads";
            note2 = "use a `match` expression instead - it destructures variant fields and checks exhaustiveness";
        } else if (sc == 3) {
            msg   = format("`switch` cannot match on `%s` values", name);
            note1 = "`switch` compares by value, so it would test string addresses rather than contents";
            note2 = "use a `match` expression with string patterns instead";
        } else if (sc == 4) {
            msg   = format("`switch` cannot match on floating-point type `%s`", name);
            note1 = "floating-point equality is unreliable, so `switch` does not allow it";
            note2 = "use `if` / `else if` comparisons instead";
        } else {
            msg   = format("`switch` cannot match on type `%s`", name);
            note1 = "`switch` supports integer, char, bool, and fieldless enum values";
            note2 = "use a `match` expression for structured types";
        }
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0209_INVALID_OPERATION, msg);
        d = d.at(span);
        d = d.with_note(note1);
        d = d.with_note(note2);
        this.ctx.diagnostics.emit(d);
    }


    // Expression Resolution (returns TypeRef)

    /// Resolve the type of an expression bottom-up.
    /// Sets resolved_type on the node and returns the TypeRef.
    resolve_expr(mut &this, expr: ExpressionNode*) -> TypeRef {
        if (expr == null) { return TypeRef::invalid(); }
        if (expr.has_resolved_type()) { return expr.resolved_type; }

        const n: ASTNode* = expr as ASTNode*;
        const result: TypeRef = match (n.kind) {
            NodeKind::Literal           => { this.resolve_literal(expr as LiteralNode*) }
            NodeKind::Identifier        => { this.resolve_identifier(expr as IdentifierNode*) }
            NodeKind::BinaryExpression  => { this.resolve_binary(expr as BinaryExprNode*) }
            NodeKind::UnaryExpression   => { this.resolve_unary(expr as UnaryExprNode*) }
            NodeKind::CallExpression    => { this.resolve_call(expr as CallExprNode*) }
            NodeKind::MemberAccess      => { this.resolve_member_access(expr as MemberAccessNode*) }
            NodeKind::ArrayAccess       => { this.resolve_array_access(expr as ArrayAccessNode*) }
            NodeKind::CastExpression    => { this.resolve_cast(expr as CastExprNode*) }
            NodeKind::IfExpression      => { this.resolve_if_expr(expr as IfExprNode*) }
            NodeKind::TernaryExpression => { this.resolve_ternary(expr as TernaryExprNode*) }
            NodeKind::MatchExpression   => { this.resolve_match_expr(expr as MatchExprNode*) }
            NodeKind::StructLiteral     => { this.resolve_struct_literal(expr as StructLiteralNode*) }
            NodeKind::ScopeResolution   => { this.resolve_scope_resolution(expr as ScopeResolutionNode*) }
            NodeKind::NewExpression     => { this.resolve_new_expr(expr as NewExprNode*) }
            NodeKind::ArrayLiteral      => { this.resolve_array_literal(expr as ArrayLiteralNode*) }
            NodeKind::TupleLiteral      => { this.resolve_tuple_literal(expr as TupleLiteralNode*) }
            NodeKind::SizeofExpression  => { this.arena.get_u64() }
            NodeKind::AlignofExpression => { this.arena.get_u64() }
            NodeKind::TypeofExpression  => {
                // `typeof` is a type-level construct (decltype): it resolves
                // to a type, not a runtime value, so it is only valid in type
                // position (`const y: typeof(x) = ...`, `e as typeof(x)`).
                // Using it as a value has no meaning here.
                const te: TypeofExprNode* = expr as TypeofExprNode*;
                this.resolve_expr(te.operand);
                this.ctx.emit_error_at(ErrorCode::E0209_INVALID_OPERATION,
                    "`typeof` may only be used in type position (e.g. `const y: typeof(x)`)",
                    expr.span);
                TypeRef::invalid()
            }
            NodeKind::DeleteExpression  => {
                const de: DeleteExprNode* = expr as DeleteExprNode*;
                this.resolve_expr(de.operand);
                this.arena.get_void()
            }
            NodeKind::TryExpression     => { this.resolve_try_expr(expr as TryExprNode*) }
            NodeKind::LambdaExpression  => { this.resolve_lambda(expr as LambdaExprNode*) }
            _ => { TypeRef::invalid() }
        };

        if (result.is_valid()) {
            expr.set_resolved_type(result);
        }
        return result;
    }

    /// Type-check a lambda expression.
    ///
    /// The body is walked in a per-lambda locals scope holding only the
    /// lambda's own parameters.  Free variables (references to outer-scope
    /// locals) are detected by `resolve_identifier`'s fallback path, which
    /// consults `lambda_outer_locals` - the union of every enclosing scope
    /// (function locals + any further-out lambda's already-captured names).
    /// A hit becomes a capture: Copy types are captured by value-copy,
    /// non-Copy types implicitly become move-captures (flipping the
    /// lambda's `is_move` flag), the binding is registered as a local
    /// in the lambda body, and the capture is recorded on the node's
    /// `captured_*` parallel arrays.
    ///
    /// The lambda's value type is still the function-pointer signature
    /// at the end of Phase 1; later phases switch capturing lambdas to
    /// emit a synthesised closure struct.
    resolve_lambda(mut &this, node: LambdaExprNode*) -> TypeRef {
        mut res_ctx: ResolutionContext = ResolutionContext::new(
            this.ctx.source_file, "");

        // Resolve parameter types from their annotations.
        mut param_types: TypeRef[] = [];
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            const p: VarDeclNode* = node.parameters[i];
            if (p == null) { continue; }
            mut pty: TypeRef = p.resolved_type;
            if (!pty.is_valid() && p.type_annotation != null
                    && this.ctx.type_resolver != null) {
                pty = this.ctx.type_resolver.resolve(p.type_annotation, &res_ctx);
                if (pty.is_valid()) { p.resolved_type = pty; }
            }
            if (!pty.is_valid()) { pty = this.arena.get_void(); }
            param_types.push(pty);
        }

        // Resolve the return type (explicit `-> T`; defaults to unit/void).
        mut ret_ty: TypeRef = node.return_type;
        if (!ret_ty.is_valid()) {
            if (node.return_type_ann != null && this.ctx.type_resolver != null) {
                ret_ty = this.ctx.type_resolver.resolve(node.return_type_ann, &res_ctx);
            }
            if (!ret_ty.is_valid()) { ret_ty = this.arena.get_void(); }
            node.set_return_type(ret_ty);
        }

        // Save the enclosing function's per-function state, then install a
        // fresh context for the lambda body. Cryo does not drop on field
        // reassignment (mirrors enter_function's `this.locals = HashMap::new()`),
        // so aliasing the saved maps and restoring them later is sound.
        const saved_locals:    HashMap<u32, TypeRef>    = this.locals;
        const saved_muts:      HashMap<u32, boolean>    = this.local_muts;
        const saved_kw:        HashMap<u32, SourceSpan> = this.local_kw_spans;
        const saved_undo_keys: u32[]                    = this.undo_keys;
        const saved_undo_prev: TypeRef[]                = this.undo_prev;
        const saved_undo_muts: boolean[]                = this.undo_muts;
        const saved_undo_kw:   SourceSpan[]             = this.undo_kw_spans;
        const saved_ret:       TypeRef                  = this.return_type;
        const saved_ret_ann:   TypeAnnotation*          = this.return_type_ann;
        const saved_this:      TypeRef                  = this.this_type;
        const saved_this_mut:  boolean                  = this.this_is_mut;
        const saved_payload:   u32[]                    = this.payload_binding_ids;
        const saved_expected:  TypeRef                  = this.expected_type;
        const saved_loop:      i32                      = this.loop_depth;
        const saved_switch:    i32                      = this.switch_depth;
        // Lambda-capture state save.  `saved_outer` aliases the *enclosing*
        // lambda's outer-locals snapshot (empty when entering a top-level
        // lambda) - it's restored verbatim on exit; the new map we build
        // below is what the body sees.
        const saved_outer_locals: HashMap<u32, TypeRef> = this.lambda_outer_locals;
        const saved_lambda_depth: i32                   = this.in_lambda_depth;
        const saved_current_lam:  LambdaExprNode*       = this.current_lambda;

        // Compose the body's view of out-of-scope bindings: every name
        // visible from immediately outside this lambda, transitively.
        //   union = (further-out captures, via saved_outer_locals)
        //         ∪ (immediate enclosing scope, via saved_locals)
        // saved_locals shadows saved_outer_locals (insert overwrites): an
        // immediate-enclosing binding that happens to share a name with a
        // further-out one is the closer match - it's what resolve_identifier
        // would have picked before lambda nesting added a level.
        mut new_outer_locals: HashMap<u32, TypeRef> = HashMap<u32, TypeRef>::new();
        mut outer_it: HashMapIter<u32, TypeRef> = saved_outer_locals.iter();
        loop {
            match (outer_it.next()) {
                Option::Some(pair) => {
                    new_outer_locals.insert(pair.first, pair.second);
                }
                Option::None => { break; }
            }
        }
        mut local_it: HashMapIter<u32, TypeRef> = saved_locals.iter();
        loop {
            match (local_it.next()) {
                Option::Some(pair) => {
                    new_outer_locals.insert(pair.first, pair.second);
                }
                Option::None => { break; }
            }
        }

        this.locals         = HashMap<u32, TypeRef>::new();
        this.local_muts     = HashMap<u32, boolean>::new();
        this.local_kw_spans = HashMap<u32, SourceSpan>::new();
        this.undo_keys      = [];
        this.undo_prev      = [];
        this.undo_muts      = [];
        this.undo_kw_spans  = [];
        this.return_type     = ret_ty;
        this.return_type_ann = node.return_type_ann;
        this.this_type       = TypeRef::invalid();
        this.this_is_mut     = false;
        this.payload_binding_ids = [];
        this.param_ids = [];
        this.expected_type   = TypeRef::invalid();
        this.loop_depth      = 0;
        this.switch_depth    = 0;
        this.lambda_outer_locals = new_outer_locals;
        this.in_lambda_depth     = saved_lambda_depth + 1;
        this.current_lambda      = node;

        for (mut pi: i64 = 0; pi < node.parameters.length; pi++) {
            const p: VarDeclNode* = node.parameters[pi];
            if (p == null) { continue; }
            this.register_local_with_mut(p.name, p.resolved_type, p.is_mutable);
        }

        // Type-check the body (resolves body expressions, checks returns
        // against the lambda's declared return type).
        if (node.body != null) {
            node.body.accept(this);
        }

        // Restore the enclosing function's state.
        this.locals         = saved_locals;
        this.local_muts     = saved_muts;
        this.local_kw_spans = saved_kw;
        this.undo_keys      = saved_undo_keys;
        this.undo_prev      = saved_undo_prev;
        this.undo_muts      = saved_undo_muts;
        this.undo_kw_spans  = saved_undo_kw;
        this.return_type     = saved_ret;
        this.return_type_ann = saved_ret_ann;
        this.this_type       = saved_this;
        this.this_is_mut     = saved_this_mut;
        this.payload_binding_ids = saved_payload;
        this.expected_type   = saved_expected;
        this.loop_depth      = saved_loop;
        this.switch_depth    = saved_switch;
        this.lambda_outer_locals = saved_outer_locals;
        this.in_lambda_depth     = saved_lambda_depth;
        this.current_lambda      = saved_current_lam;

        // Nested-capture propagation: when an inner lambda has captures
        // and we're still inside an outer lambda, any captured name that
        // isn't in the outer lambda's own locals (params + body-declared
        // locals) must be captured by the outer lambda too - otherwise
        // the outer lambda's `__call__` body, which materialises the
        // inner closure-struct value, won't have the name in scope when
        // codegen builds the field-init.  `this.locals` is now the
        // outer lambda's locals (restored above), so `lookup_local`
        // answers exactly that question.
        if (node.is_capturing()
                && saved_current_lam != null
                && saved_lambda_depth > 0) {
            const prop_registry: GenericRegistry* = this.ctx.get_generic_registry();
            for (mut ci: i64 = 0; ci < node.captured_names.length; ci++) {
                const cap_name: SymbolStr = node.captured_names[ci];
                if (!this.lookup_local(cap_name).is_valid()) {
                    const cap_ty: TypeRef = node.captured_types[ci];
                    saved_current_lam.add_capture(
                        cap_name,
                        cap_ty,
                        node.captured_spans[ci]);
                    // Mirror record_lambda_capture's implicit-move rule:
                    // propagating a non-Copy capture upward means the
                    // outer lambda's __call__ also owns the value, so it
                    // needs the same is_move plumbing (capture_alias on
                    // its shadow, Drop on its closure struct).  Without
                    // this, nested non-Copy captures would double-drop.
                    if (!OwnershipQuery::is_copy(this.arena, prop_registry,
                            this.intern, cap_ty)) {
                        saved_current_lam.is_move = true;
                    }
                }
            }
        }

        // Capturing lambdas materialise as a synthesised closure-struct
        // value, not a bare function pointer.  Non-capturing lambdas stay
        // on the existing fn-pointer path - codegen still emits a
        // standalone anonymous function for them via `lambda_emitter`.
        if (node.is_capturing()) {
            return this.synthesize_closure_struct(node);
        }
        return this.arena.get_function(ret_ty, param_types, false);
    }

    /// Helper for `resolve_identifier`: a name inside a lambda body
    /// resolved to an outer-scope binding `outer_ty`.  Validates the
    /// capture mode (only `Copy` types are capturable in the v1 MVP),
    /// records the capture on the surrounding `current_lambda`, and
    /// shadows the binding into the lambda's own locals so subsequent
    /// uses resolve through `lookup_local` without re-running this path.
    /// Returns the captured type so the calling identifier resolves.
    record_lambda_capture(mut &this, ident: IdentifierNode*,
                          outer_ty: TypeRef) -> TypeRef {
        // Cryo's capture policy: Copy types are captured by value-copy,
        // non-Copy types are captured by move (the outer binding is
        // consumed at the lambda's construction site, the closure-struct
        // takes ownership of the value, and its synthesized Drop releases
        // it at scope exit).  The `move` keyword stays valid as an
        // explicit signal (no-op when the captures are all Copy; useful
        // for documentation and forward-compat with thread::spawn where
        // explicit `move` makes the consumption visible at the call site)
        // - any non-Copy capture flips `is_move` to true regardless of
        // whether the source actually spelled it.  MoveCheck and
        // drop_insertion both read is_move when walking the LambdaExpr
        // node, so they see the same move-set whether the keyword was
        // present or implied.
        const is_copy: boolean = OwnershipQuery::is_copy(this.arena,
            this.ctx.get_generic_registry(), this.intern, outer_ty);
        if (!is_copy && this.current_lambda != null) {
            this.current_lambda.is_move = true;
        }

        // Shadow the binding as a per-lambda local: subsequent references
        // resolve via lookup_local, and the codegen path (Phase 3+) will
        // bind it to the closure-struct field.  Captures are by-value, so
        // the shadow is non-mut regardless of the original binding's
        // mutability.
        this.register_local(ident.name, outer_ty);

        if (this.current_lambda != null) {
            this.current_lambda.add_capture(ident.name, outer_ty, ident.span);
        }
        return outer_ty;
    }

    /// Mint a unique closure type name like `<ns>::__Closure_<N>`.  Cross-
    /// module uniqueness comes from the namespace prefix; within a module
    /// `closure_counter` monotonically increments so each capturing lambda
    /// gets its own struct.
    mint_closure_name(mut &this) -> SymbolStr {
        const idx: u64 = this.closure_counter;
        this.closure_counter += 1;
        const ns_str: string = if (this.ctx.has_namespace()) {
            this.ctx.namespace_display()
        } else {
            this.ctx.source_file
        };
        const name_str: string = format("%s::__Closure_%lld", ns_str, idx as i64);
        return this.intern.intern(name_str);
    }

    /// Synthesise the closure-struct + `__call__` method for a capturing
    /// lambda.  Returns the closure struct's TypeRef so the caller can
    /// stamp it onto the LambdaExprNode's `resolved_type`.
    ///
    /// What gets built:
    ///   - StructDeclNode named `<ns>::__Closure_<N>` with one FieldDeclNode
    ///     per capture; visibility public, resolved_type stamped.
    ///   - FunctionDeclNode named `__call__` with the lambda's params + return
    ///     type, body = `{ const cap_i: T_i = this.cap_i; ...; <lambda body>; }`.
    ///     The shadow bindings let the lambda body reuse the names it
    ///     already references; codegen creates allocas for them and the
    ///     body's identifier lookups resolve through `cg.values` as normal.
    ///   - MethodNode wrapping that function; added to the StructDeclNode.
    ///   - Arena StructType populated with FieldInfo + MethodInfo entries.
    ///   - DeclarationIndex registrations for the struct + its methods.
    ///   - The StructDeclNode appended to ProgramNode so subsequent passes
    ///     (sema's own visit, MoveCheck, DropInsertion, Codegen) see it.
    synthesize_closure_struct(mut &this, lambda: LambdaExprNode*) -> TypeRef {
        const ctx_ptr: CompilationContext* = this.ctx;
        const intern_ptr: InternTable* = this.intern;
        const arena_ptr: TypeArena* = this.arena;

        const qual_name: SymbolStr = this.mint_closure_name();
        const module_sym: SymbolStr = intern_ptr.intern(ctx_ptr.source_file);
        const span: SourceSpan = lambda.span;

        // 1. StructDeclNode + FieldDeclNodes.
        mut struct_decl: StructDeclNode* = new StructDeclNode(qual_name, span);
        // No `![repr]` directive applies; use Cryo-native layout.
        struct_decl.repr_c = false;
        struct_decl.repr_packed = false;
        struct_decl.repr_transparent = false;
        struct_decl.min_alignment = 0;

        for (mut i: i64 = 0; i < lambda.captured_names.length; i++) {
            const cap_name: SymbolStr = lambda.captured_names[i];
            const cap_ty:   TypeRef   = lambda.captured_types[i];
            mut field: FieldDeclNode* = new FieldDeclNode(cap_name, span);
            field.set_visibility(Visibility::Public);
            field.set_resolved_type(cap_ty);
            struct_decl.add_field(field);
        }

        // 2. Register the StructType in the arena and populate fields.
        const struct_ref: TypeRef = arena_ptr.create_struct(qual_name, module_sym);
        const struct_t: Type* = arena_ptr.lookup(struct_ref.id);
        if (struct_t != null && struct_t.kind == TypeKind::Struct) {
            const st: StructType* = struct_t as StructType*;
            mut infos: FieldInfo[] = [];
            for (mut i: i64 = 0; i < lambda.captured_names.length; i++) {
                infos.push(FieldInfo::new(
                    lambda.captured_names[i],
                    lambda.captured_types[i],
                    true, false, false));
            }
            st.set_fields(infos);
        }

        // 3. FunctionDeclNode for `__call__`.  Receiver is implicit (no
        //    explicit `&this` parameter); `register_methods_with_module`
        //    synthesises the receiver pointer slot at registration time.
        const call_name: SymbolStr = intern_ptr.intern("__call__");
        mut call_fn: FunctionDeclNode* = new FunctionDeclNode(call_name, span);
        call_fn.set_resolved_return_type(lambda.return_type);

        for (mut i: i64 = 0; i < lambda.parameters.length; i++) {
            call_fn.add_parameter(lambda.parameters[i]);
        }

        // 4. __call__ body: `{ const cap_i: T_i = this.cap_i; <lambda body> }`.
        //    For a `move` lambda's non-Copy captures, the shadow is marked
        //    is_capture_alias=true so drop_insertion skips its scope-exit
        //    drop - the closure-struct's synthesized Drop (below) owns the
        //    field's release.  Without the alias flag the shadow's
        //    value-copy would drop the captured value on every __call__
        //    return, double-freeing against the closure-struct drop and
        //    triple-freeing if the outer `p` is also still tracked.
        mut body_block: BlockStmtNode* = new BlockStmtNode(span);
        const this_ident_sym: SymbolStr = this.this_sym;
        const cap_registry: GenericRegistry* = this.ctx.get_generic_registry();
        for (mut i: i64 = 0; i < lambda.captured_names.length; i++) {
            const cap_name: SymbolStr = lambda.captured_names[i];
            const cap_ty:   TypeRef   = lambda.captured_types[i];

            // `this`
            mut this_ident: IdentifierNode* = new IdentifierNode(this_ident_sym, span);
            this_ident.set_resolved_type(struct_ref);

            // `this.cap_i`
            mut access: MemberAccessNode* = new MemberAccessNode(
                this_ident as ExpressionNode*, cap_name, span, span);
            access.set_resolved_type(cap_ty);

            // `const cap_i: T_i = this.cap_i;`
            mut shadow: VarDeclNode* = new VarDeclNode(cap_name, span);
            shadow.set_mutable(false);
            shadow.set_resolved_type(cap_ty);
            shadow.set_initializer(access as ExpressionNode*);
            if (lambda.is_move && !OwnershipQuery::is_copy(arena_ptr,
                    cap_registry, intern_ptr, cap_ty)) {
                shadow.set_capture_alias(true);
            }

            const shadow_stmt: DeclStmtNode* = new DeclStmtNode(
                shadow as DeclarationNode*, span);
            body_block.add_statement(shadow_stmt as StatementNode*);
        }

        // Append the original lambda body's statements (or the body itself
        // if it is not a block).  The body has already been sema-walked
        // inside `resolve_lambda` so every node carries its resolved_type.
        if (lambda.body != null) {
            if (lambda.body.kind == NodeKind::BlockStatement) {
                const orig_blk: BlockStmtNode* = lambda.body as BlockStmtNode*;
                for (mut bi: i64 = 0; bi < orig_blk.statements.length; bi++) {
                    body_block.add_statement(orig_blk.statements[bi]);
                }
            } else {
                body_block.add_statement(lambda.body);
            }
        }
        call_fn.set_body(body_block);

        // 5. MethodNode + attach to struct.
        mut method: MethodNode* = new MethodNode(call_fn, span);
        method.set_visibility(Visibility::Public);
        method.set_static(false);
        method.set_sink(false);
        struct_decl.add_method(method);

        // 5b. If any capture is non-Copy, synthesize a `drop` method that
        //     calls `.drop()` on each non-Copy field.  Without this, the
        //     closure struct gets `is_copy == false` (a non-Copy field
        //     makes the whole aggregate non-Copy) so drop_insertion
        //     synthesizes `closure.drop()` at scope exit, but codegen
        //     resolves to nothing on a struct with no inherent drop and
        //     drop-glue does NOT recurse into closure-struct fields - so
        //     the captured value silently leaks.  An inherent `drop`
        //     method whose body explicitly drops each non-Copy field
        //     gives both passes a concrete callee to dispatch through
        //     and ensures the field's own Drop runs exactly once.
        //     Copy-only closures need no Drop and stay Copy themselves.
        mut drop_method: MethodNode* = null;
        const registry_ptr: GenericRegistry* = this.ctx.get_generic_registry();
        mut has_noncopy_capture: boolean = false;
        for (mut di: i64 = 0; di < lambda.captured_names.length; di++) {
            if (!OwnershipQuery::is_copy(arena_ptr, registry_ptr,
                    intern_ptr, lambda.captured_types[di])) {
                has_noncopy_capture = true;
                break;
            }
        }
        if (has_noncopy_capture) {
            const drop_name: SymbolStr = intern_ptr.intern("drop");
            mut drop_fn: FunctionDeclNode* = new FunctionDeclNode(drop_name, span);
            drop_fn.set_resolved_return_type(arena_ptr.get_void());

            mut drop_body: BlockStmtNode* = new BlockStmtNode(span);
            for (mut di: i64 = 0; di < lambda.captured_names.length; di++) {
                const cap_name: SymbolStr = lambda.captured_names[di];
                const cap_ty:   TypeRef   = lambda.captured_types[di];
                if (OwnershipQuery::is_copy(arena_ptr, registry_ptr,
                        intern_ptr, cap_ty)) {
                    continue;
                }

                // `this`
                mut this_id: IdentifierNode* = new IdentifierNode(
                    this_ident_sym, span);
                this_id.set_resolved_type(struct_ref);

                // `this.cap_i`
                mut field_acc: MemberAccessNode* = new MemberAccessNode(
                    this_id as ExpressionNode*, cap_name, span, span);
                field_acc.set_resolved_type(cap_ty);

                // `this.cap_i.drop`
                mut drop_acc: MemberAccessNode* = new MemberAccessNode(
                    field_acc as ExpressionNode*, drop_name, span, span);

                // `this.cap_i.drop()`
                mut drop_call: CallExprNode* = new CallExprNode(
                    drop_acc as ExpressionNode*, span);

                // `this.cap_i.drop();`
                const drop_stmt: ExprStmtNode* = new ExprStmtNode(
                    drop_call as ExpressionNode*, span);
                drop_body.add_statement(drop_stmt as StatementNode*);
            }
            drop_fn.set_body(drop_body);

            drop_method = new MethodNode(drop_fn, span);
            drop_method.set_visibility(Visibility::Public);
            drop_method.set_static(false);
            drop_method.set_sink(false);
            struct_decl.add_method(drop_method);
        }

        // 6. Populate StructType.methods so sema's `resolve_method_overload`
        //    can find `__call__` (and `drop`, when synthesized) by name
        //    when the call dispatch kicks in.
        if (struct_t != null && struct_t.kind == TypeKind::Struct) {
            const st: StructType* = struct_t as StructType*;
            mut method_param_types: TypeRef[] = [];
            for (mut pi: i64 = 0; pi < call_fn.parameters.length; pi++) {
                const pp: VarDeclNode* = call_fn.parameters[pi];
                if (pp != null && pp.resolved_type.is_valid()) {
                    method_param_types.push(pp.resolved_type);
                }
            }
            const call_fn_ty: TypeRef = arena_ptr.get_function(
                lambda.return_type, method_param_types, false);
            const minfo: MethodInfo = MethodInfo {
                name:          call_name,
                function_type: call_fn_ty,
                is_public:     true,
                is_protected:  false,
                is_static:     false,
                is_virtual:    false,
                is_override:   false,
                param_types:   method_param_types,
                ast_node:      method as void*,
            };
            st.add_method(minfo);

            if (drop_method != null) {
                mut drop_param_types: TypeRef[] = [];
                const drop_fn_ty: TypeRef = arena_ptr.get_function(
                    arena_ptr.get_void(), drop_param_types, false);
                const drop_minfo: MethodInfo = MethodInfo {
                    name:          intern_ptr.intern("drop"),
                    function_type: drop_fn_ty,
                    is_public:     true,
                    is_protected:  false,
                    is_static:     false,
                    is_virtual:    false,
                    is_override:   false,
                    param_types:   drop_param_types,
                    ast_node:      drop_method as void*,
                };
                st.add_method(drop_minfo);
            }
        }

        // 7. DeclarationIndex registration so cross-pass lookups work.
        ctx_ptr.decl_index.register_type_with_module(qual_name, struct_ref, module_sym);
        mut method_arr: MethodNode*[] = [method];
        if (drop_method != null) { method_arr.push(drop_method); }
        ctx_ptr.decl_index.register_methods_with_module(
            qual_name, method_arr, module_sym, intern_ptr, arena_ptr);

        // 8. Inject into the ProgramNode so subsequent passes walk it.
        //    Sema's `visit(ProgramNode)` re-reads `statements.length` each
        //    iteration, so the appended StructDecl gets type-checked in
        //    the same pass; MoveCheck / DropInsertion / Codegen pick it
        //    up naturally afterwards.
        if (ctx_ptr.artifacts.ast.root != null) {
            ctx_ptr.artifacts.ast.root.add_statement(struct_decl as ASTNode*);
        }

        return struct_ref;
    }

    /// True when `ty` is a struct that carries a `__call__` method - the
    /// signature of a synthesised closure type.  Used by the closure-call
    /// rewrite to decide whether `f(args)` should be reinterpreted as
    /// `f.__call__(args)`.
    is_closure_struct_type(mut &this, ty: TypeRef) -> boolean {
        if (!ty.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null || t.kind != TypeKind::Struct) { return false; }
        const st: StructType* = t as StructType*;
        const call_sym: SymbolStr = this.intern.intern("__call__");
        return st.get_method(call_sym) != null;
    }

    /// If `call.callee` is an identifier whose resolved local type is a
    /// closure struct, rewrite the call to dispatch through `__call__`.
    /// In-place mutation of `call.callee`; safe because the caller has
    /// not yet inspected the callee kind for this resolve pass.
    maybe_rewrite_closure_call(mut &this, call: CallExprNode*) -> void {
        if (call == null || call.callee == null) { return; }
        const cn: ASTNode* = call.callee as ASTNode*;
        if (cn.kind != NodeKind::Identifier) { return; }
        const ident: IdentifierNode* = call.callee as IdentifierNode*;
        const local_ty: TypeRef = this.lookup_local(ident.name);
        if (!this.is_closure_struct_type(local_ty)) { return; }

        // Stamp the identifier with its resolved closure-struct type so
        // resolve_member_access has the receiver-type info it needs (it
        // would otherwise re-run resolve_identifier through the capture
        // fallback - harmless in isolation but extra work).
        ident.set_resolved_type(local_ty);

        const call_sym: SymbolStr = this.intern.intern("__call__");
        mut access: MemberAccessNode* = new MemberAccessNode(
            call.callee, call_sym, ident.span, ident.span);
        call.callee = access as ExpressionNode*;
    }

    /// Phase 5 entry point.  When a call passes one or more capturing
    /// closures as arguments to fn-typed (`(Args) -> Ret`) parameters of
    /// a non-generic free function, synthesise a specialised clone of
    /// the callee whose corresponding parameters are typed as the
    /// concrete closure-struct instead of the fn-pointer, inject the
    /// clone into ProgramNode, and pin `call.resolved_callee` to its
    /// mangled LLVM symbol.  Inside the spec'd body the parameter resolves
    /// to a closure-struct local, so `f(args)` lowers through the same
    /// `maybe_rewrite_closure_call` path as a direct-bound closure -
    /// codegen sees a regular method call on `__call__`, zero-cost.
    ///
    /// MVP scope:
    ///   - Identifier callees (free functions); method / scope calls
    ///     are out of scope (no callable-arg method-call test exists yet).
    ///   - Non-generic receiver - the existing monomorphizer covers the
    ///     `applymap<U>(f: (i32) -> U, ...)` case for non-capturing
    ///     lambdas, and capturing closures inside a generic receiver
    ///     would need spec-of-spec composition.
    ///   - Non-variadic, arity matches the call.
    ///   - Only `TypeKind::Function` params get substituted; everything
    ///     else passes through unchanged.
    ///
    /// Cross-call dedup: a string key built from the original name id and
    /// every `(idx, closure_ty.id)` pair maps to the prior spec's mangled
    /// symbol, so a second call site with the same shape reuses the clone.
    try_specialize_for_closure_args(mut &this,
                                    call: CallExprNode*,
                                    ident: IdentifierNode*) -> void {
        if (call == null || ident == null) { return; }
        if (call.resolved_callee.is_valid()) { return; }
        if (call.generic_args.length > 0) { return; }

        // Resolve the callee's FunctionType so we can see param shapes.
        // Try the bare name first (call as written), then the
        // current-module-qualified form in case DI keyed it that way.
        mut callee_fn_ref: TypeRef = this.ctx.decl_index.lookup_func_type(ident.name);
        if (!callee_fn_ref.is_valid()) {
            const qual: SymbolStr = this.ctx.qualify_symbol_sym(ident.name);
            if (!qual.equals(ident.name)) {
                callee_fn_ref = this.ctx.decl_index.lookup_func_type(qual);
            }
        }
        if (!callee_fn_ref.is_valid()) { return; }

        const ft_raw: Type* = this.arena.lookup(callee_fn_ref.id);
        if (ft_raw == null || ft_raw.kind != TypeKind::Function) { return; }
        const ft: FunctionType* = ft_raw as FunctionType*;
        if (ft.is_variadic) { return; }
        if (ft.param_types.length != call.arguments.length) { return; }

        // Scan arg/param pairs for "closure-struct value passed to
        // fn-typed slot" mismatches.  No mismatches -> no spec needed.
        mut sub_indices: i64[] = [];
        mut sub_types:   TypeRef[] = [];
        for (mut i: i64 = 0; i < ft.param_types.length; i++) {
            const p_ty: TypeRef = ft.param_types[i];
            const p_t: Type* = this.arena.lookup(p_ty.id);
            if (p_t == null || p_t.kind != TypeKind::Function) { continue; }
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null) { continue; }
            if (!this.is_closure_struct_type(arg.resolved_type)) { continue; }
            sub_indices.push(i);
            sub_types.push(arg.resolved_type);
        }
        if (sub_indices.length == 0) { return; }

        // Cache key: orig_name id + each (idx, closure_ty.id) pair.
        // Identical re-calls collapse onto a single specialisation.
        mut key: string = format("%u", ident.name.id);
        for (mut ki: i64 = 0; ki < sub_indices.length; ki++) {
            key = format("%s|%lld:%llu", key,
                sub_indices[ki], sub_types[ki].id);
        }

        match (this.closure_spec_map.get(&key)) {
            Option::Some(prior) => {
                call.set_resolved_callee(SymbolStr::from_id(prior));
                return;
            }
            Option::None => { /* fall through */ }
        }

        // Locate the original FunctionDeclNode at top level so we can
        // clone it.  Bare name first, then qualified.
        mut orig_func: FunctionDeclNode* = this.find_top_level_function(ident.name);
        if (orig_func == null) {
            const qual: SymbolStr = this.ctx.qualify_symbol_sym(ident.name);
            if (!qual.equals(ident.name)) {
                orig_func = this.find_top_level_function(qual);
            }
        }
        if (orig_func == null) { return; }
        if (orig_func.is_generic()) { return; }
        if (orig_func.body == null) { return; }

        // Clone the function decl.  ASTCloner clears resolved types on
        // every cloned expression / declaration node (its docstring
        // says the type substituter normally fills them); for our use
        // case sema's re-walk of the injected function fills them in.
        mut cloner: ASTCloner = ASTCloner();
        const cloned_node: ASTNode* = cloner.clone_node(orig_func as ASTNode*);
        if (cloned_node == null) { return; }
        if (cloned_node.kind != NodeKind::FunctionDeclaration) { return; }
        mut spec_func: FunctionDeclNode* = cloned_node as FunctionDeclNode*;

        // Stamp every parameter's resolved_type explicitly: substituted
        // positions get the closure-struct type, non-substituted
        // positions get the original's resolved_type.  enter_function
        // reads `param.resolved_type` directly when valid, so this is
        // what registers the right locals for the body's re-walk.
        for (mut i: i64 = 0; i < spec_func.parameters.length; i++) {
            mut p: VarDeclNode* = spec_func.parameters[i];
            if (p == null) { continue; }
            mut sub_ty: TypeRef = TypeRef::invalid();
            for (mut si: i64 = 0; si < sub_indices.length; si++) {
                if (sub_indices[si] == i) { sub_ty = sub_types[si]; break; }
            }
            if (sub_ty.is_valid()) {
                p.set_resolved_type(sub_ty);
            } else if (i < orig_func.parameters.length
                    && orig_func.parameters[i] != null
                    && orig_func.parameters[i].resolved_type.is_valid()) {
                p.set_resolved_type(orig_func.parameters[i].resolved_type);
            }
        }

        // Carry the original's resolved return type onto the clone so
        // enter_function picks it up without needing the annotation to
        // be re-resolved.
        spec_func.set_resolved_return_type(orig_func.resolved_return_type);

        // Mint a unique spec name and rename the clone.  The same key
        // produces the same name, so dedup via the closure_spec_map is
        // strictly an early-exit; cross-pass uniqueness is enforced by
        // the cache, not by the name.
        const spec_name: SymbolStr = this.mint_closure_spec_name(orig_func.name, sub_types);
        spec_func.set_name(spec_name);

        // Inject into ProgramNode so the spec'd function rides through
        // sema (this pass, via the visit(ProgramNode) length-reread
        // loop), then move-check, drop-insertion, and finally codegen,
        // which registers it in DI + the LLVM module under its qualified
        // spec name during the declare_functions phase.
        if (this.ctx.artifacts.ast.root != null) {
            this.ctx.artifacts.ast.root.add_statement(spec_func as ASTNode*);
        }

        // Compute the mangled LLVM symbol the codegen pass will use for
        // the spec'd function and pin it on the call.  declare_function
        // computes the same symbol from the same args (qualified name +
        // param types + return type), so the call resolves to the
        // freshly declared spec at codegen.
        const qualified_spec: SymbolStr = this.ctx.qualify_symbol_sym(spec_name);
        mut spec_param_types: TypeRef[] = [];
        for (mut i: i64 = 0; i < spec_func.parameters.length; i++) {
            spec_param_types.push(spec_func.parameters[i].resolved_type);
        }
        const mangled: MangledName = MangledName::for_free_function(
            this.intern, this.arena,
            QualifiedName::from_symbol(qualified_spec),
            spec_param_types, spec_func.resolved_return_type, false);
        call.set_resolved_callee(mangled.value);
        this.closure_spec_map.insert(key, mangled.value.id);
    }

    /// Linear scan over `ProgramNode.statements` to find a top-level
    /// FunctionDeclNode whose `name` matches `name`.  Called only on
    /// the rare closure-arg specialisation path, so the O(n) cost is
    /// acceptable; the alternative of indexing every free function
    /// AST in the DeclarationIndex is not worth the bookkeeping.
    find_top_level_function(&this, name: SymbolStr) -> FunctionDeclNode* {
        if (this.ctx.artifacts.ast.root == null) { return null; }
        const stmts: ASTNode*[] = this.ctx.artifacts.ast.root.statements;
        for (mut i: i64 = 0; i < stmts.length; i++) {
            const s: ASTNode* = stmts[i];
            if (s == null) { continue; }
            if (s.kind != NodeKind::FunctionDeclaration) { continue; }
            const fn: FunctionDeclNode* = s as FunctionDeclNode*;
            if (fn.name.id == name.id) { return fn; }
        }
        return null;
    }

    /// Mint a stable spec name for a closure-arg specialisation:
    /// `<orig>__cl_<ty1>_<ty2>_...`.  Cross-module uniqueness comes
    /// from later qualification at the call to MangledName::for_free_function;
    /// per-(orig, substitution-set) uniqueness comes from including
    /// every substituted closure-struct's arena TypeRef id, which is a
    /// fresh integer per synthesised closure struct.
    mint_closure_spec_name(mut &this,
                           orig: SymbolStr,
                           closure_tys: TypeRef[]) -> SymbolStr {
        mut s: string = this.intern.resolve(orig);
        s = format("%s__cl", s);
        for (mut i: i64 = 0; i < closure_tys.length; i++) {
            s = format("%s_%llu", s, closure_tys[i].id);
        }
        return this.intern.intern(s);
    }

    /// Scope-guard for Phase 5: closures are only delivered through
    /// free-function `(Args) -> Ret` parameter slots in v1.0.  When a
    /// method-call or scope-resolution call carries a closure-struct
    /// argument, the per-call-site specialisation path is bypassed and
    /// codegen would silently lower the struct value as if it were a
    /// fn-pointer (or, for generic receivers, leave the call unspec'd
    /// and crash at runtime when the dispatcher loads the struct's
    /// first word as a code pointer).  Emit one diagnostic per
    /// closure-struct argument so the user sees an explicit v1.0
    /// limitation note instead of an LLVM error or UB.  `context_msg`
    /// is interpolated into the label so the diagnostic localises to
    /// the kind of call site (method / scope-resolution).
    reject_closure_struct_args_in_non_free_call(mut &this,
                                                call: CallExprNode*,
                                                context_msg: string) -> void {
        if (call == null) { return; }
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null) { continue; }
            if (!this.is_closure_struct_type(arg.resolved_type)) { continue; }
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0458_CLOSURE_ARG_NON_FREE,
                format("%s is not yet supported", context_msg));
            diag = diag.at_with_label(arg.span,
                "this is a capturing closure (anonymous struct value)");
            diag = diag.with_note(
                "v1.0 routes capturing closures through free-function `(Args) -> Ret` parameters only; method-call and scope-resolution-call closure parameters are deferred");
            diag = diag.with_note(
                "workaround: pull the call out into a free function, or pre-extract the closure into a fn-pointer if the capture set is empty");
            this.ctx.emit_diagnostic(diag);
        }
    }


    // Individual Expression Resolvers

    resolve_literal(&this, lit: LiteralNode*) -> TypeRef {
        return match (lit.literal_kind) {
            LiteralKind::Integer => { this.resolve_integer_literal(lit) }
            LiteralKind::Float   => { this.resolve_float_literal(lit) }
            LiteralKind::String  => { this.arena.get_string() }
            LiteralKind::Char    => { this.arena.get_char() }
            LiteralKind::Boolean => { this.arena.get_bool() }
            LiteralKind::Null    => {
                // Type `null` as `void*` (Pointer to Void) rather than
                // bare Void.  The existing `void* <-> T*` rule in
                // TypeChecker handles assignment to any concrete
                // pointer type without needing a dedicated `void ->
                // Pointer` widening; preserves null semantics without
                // letting arbitrary void-typed expressions widen.
                this.arena.get_pointer_to(this.arena.get_void())
            }
        };
    }

    /// Resolve the type of an integer literal.
    /// If an expected_type hint is an integer type, adopt it (literals are
    /// polymorphic).  Otherwise default to i32.
    resolve_integer_literal(&this, lit: LiteralNode*) -> TypeRef {
        if (this.expected_type.is_valid()) {
            const exp: Type* = this.arena.lookup(this.expected_type.id);
            if (exp != null && exp.kind == TypeKind::Int) {
                const it: IntType* = exp as IntType*;
                // Bound the literal by what fits in the target's bit width
                // (its unsigned max). This catches genuine overflow such as
                // `u8 = 99999999` while still admitting bit-pattern / two's-
                // complement initializers up to the width. 128-bit bounds
                // exceed u64, so they are left unchecked here.
                const w: u64 = it.int_kind.bit_width();
                mut max_mag: u64 = 0;
                if (w == 8)       { max_mag = 255; }
                else if (w == 16) { max_mag = 65535; }
                else if (w == 32) { max_mag = 4294967295; }
                else if (w == 64) { max_mag = SEMA_U64_MAX; }
                if (max_mag != 0 && int_literal_exceeds(lit.value, max_mag)) {
                    this.ctx.emit_error_at(
                        ErrorCode::E0010_NUMBER_TOO_LARGE,
                        format("integer literal `%s` is out of range for type `%s`",
                            lit.value, it.int_kind.to_string()),
                        lit.span);
                }
                return this.expected_type;
            }
        }
        // No integer expected-type hint: default to i32 when the magnitude
        // fits, otherwise widen to the narrowest type that holds it.  A
        // bare literal larger than i32 - e.g. an i64::MIN magnitude reaching
        // a variadic `printf` with no param type to adopt - would otherwise
        // silently truncate to its low 32 bits.  i32 stays the default for
        // in-range literals so ordinary code is unaffected.
        if (!int_literal_exceeds(lit.value, SEMA_I32_MAX_MAG)) {
            return this.arena.get_i32();
        }
        if (!int_literal_exceeds(lit.value, SEMA_I64_MAX_MAG)) {
            return this.arena.get_i64();
        }
        return this.arena.get_u64();
    }

    /// Resolve the type of a float literal.
    /// If an expected_type hint is a float type, adopt it.
    /// Otherwise default to f64.
    resolve_float_literal(&this, lit: LiteralNode*) -> TypeRef {
        if (this.expected_type.is_valid()) {
            const exp: Type* = this.arena.lookup(this.expected_type.id);
            if (exp != null && exp.kind == TypeKind::Float) {
                return this.expected_type;
            }
        }
        return this.arena.get_f64();
    }

    resolve_identifier(mut &this, ident: IdentifierNode*) -> TypeRef {
        if (ident.name.equals(this.this_sym) && this.this_type.is_valid()) {
            return this.this_type;
        }
        // Check the local scope HashMap (covers params + locals registered
        // during this function's type-check walk via enter_function and
        // visit(DeclStmtNode*)).
        const local: TypeRef = this.lookup_local(ident.name);
        if (local.is_valid()) { return local; }

        // Lambda-capture fallback: inside a lambda body, the per-lambda
        // `locals` map only carries the lambda's own params, so a reference
        // to an enclosing-scope binding misses above.  Before falling
        // through to globals/functions/typo-diagnostic, check the outer
        // snapshot stitched together by `resolve_lambda`; a hit becomes a
        // capture on the surrounding lambda.
        if (this.in_lambda_depth > 0 && this.current_lambda != null) {
            match (this.lambda_outer_locals.get(&ident.name.id)) {
                Option::Some(outer_ty) => {
                    return this.record_lambda_capture(ident, outer_ty);
                }
                Option::None => { /* fall through */ }
            }
        }

        // Global variables are stored in the DeclarationIndex (single source
        // of truth for declaration-level type lookups).
        const global: TypeRef = this.lookup_global_var(ident.name);
        if (global.is_valid()) { return global; }

        // Built-in source-location pseudo-macros: `FILE` is a `string`
        // pointer to the file path, `LINE` is an `i32` line number.
        // Codegen substitutes these at use site (see
        // codegen_identifier in expr_codegen.cryo); sema only needs to
        // give them a type so the call argument type-checks.
        const name_str: string = this.intern.resolve(ident.name);
        if (strcmp(name_str, "FILE") == 0) { return this.arena.get_string(); }
        if (strcmp(name_str, "LINE") == 0) { return this.arena.get_i32(); }

        // First-class function reference: bare function name used as a
        // value (e.g. passed as a callback: `serve(addr, handler)`).
        // codegen_identifier already emits the LLVM function pointer when
        // resolve_function succeeds; sema just needs to give the
        // identifier the function's TypeRef so the surrounding call /
        // assignment type-checks.
        const func_ty: TypeRef = this.ctx.decl_index.lookup_func_type(ident.name);
        if (func_ty.is_valid()) { return func_ty; }

        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0201_UNDEFINED_VARIABLE,
            format("cannot find value `%s` in this scope", name_str));
        diag = diag.at_with_label(ident.span, "not found in this scope");
        const cands: string[] = this.collect_local_names();
        diag = this.attach_did_you_mean(diag, name_str, cands,
                                        "local", ident.span);
        this.ctx.emit_diagnostic(diag);
        return TypeRef::invalid();
    }

    resolve_binary(mut &this, bin: BinaryExprNode*) -> TypeRef {
        // Push the non-literal operand's type as the expected type while
        // resolving the literal so that shape-less literals (empty array
        // `[]`, bare struct literals, generic calls without explicit
        // args, *and* integer/float literals that would otherwise default
        // to i32/f64) adopt the slot they are being written into.  Without
        // this, `acc: u64 > 9223372036854775808` types the literal as i32,
        // truncating the bit pattern to its low 32 bits before codegen
        // ever sees it (pinned reproducer:
        // tests/tests/lang/integer_literals.cryo ::
        // u64_var_vs_inline_literal_above_i64_max_greater_than).  Restore
        // expected_type afterward so sibling expressions don't inherit a
        // stale expectation.
        const left_is_lit:  boolean = is_numeric_literal_expr(bin.left);
        const right_is_lit: boolean = is_numeric_literal_expr(bin.right);

        mut lhs: TypeRef = TypeRef::invalid();
        mut rhs: TypeRef = TypeRef::invalid();

        if (bin.op.kind.is_assignment_op()) {
            // Assignment: LHS is the slot, push its type as expected for RHS.
            lhs = this.resolve_expr(bin.left);
            if (lhs.is_valid()) {
                const saved_exp: TypeRef = this.expected_type;
                this.expected_type = lhs;
                rhs = this.resolve_expr(bin.right);
                this.expected_type = saved_exp;
            } else {
                rhs = this.resolve_expr(bin.right);
            }
            this.check_assignment_lvalue(bin.left);
            // Plain `=` must type-check the value against the slot, mirroring
            // the declaration-init and return paths (which both call
            // can_assign).  Without this, `x = "str"` (x: i32) and narrowing
            // assignments like `u8_var = i64_expr` compiled silently.
            // Compound assignment ops (`+=`, `<<=`, ...) are deliberately
            // excluded: their RHS need not be assignable to the LHS
            // (e.g. `ptr += 1`), and the implied binary op is validated on
            // its own.  Widening (e.g. i32 -> i64) stays legal because it is
            // ImplicitConvert, which can_assign accepts.  Non-concrete
            // (generic `T`, unit, void, function) operands are skipped, just
            // like the call-arg path (arg_type_is_concrete): trait default
            // method bodies are checked once with `T` still abstract.
            // `indirection_compatible` exempts pointer/reference spelling
            // (`&T` <-> `T*`, value <-> `&T`, Derived -> Base): address-of yields
            // a reference type that codegen lowers identically to the pointer
            // slot, e.g. `cursor = &node.next` (`&Entry*` into `Entry**`).
            // It only fires when a side is an indirection, so scalar
            // narrowing (`u8 = i64`) is still rejected.
            if (bin.op.lexeme == "="
                && lhs.is_valid() && rhs.is_valid()
                && this.arg_type_is_concrete(lhs)
                && this.arg_type_is_concrete(rhs)
                && !this.checker.can_assign(rhs, lhs)
                && !this.indirection_compatible(rhs, lhs)) {
                const value_span: SourceSpan =
                    if (bin.right != null) { bin.right.span }
                    else { bin.span };
                this.emit_type_mismatch_with_value(
                    ErrorCode::E0200_TYPE_MISMATCH,
                    value_span,
                    lhs,
                    rhs,
                    "the value assigned here doesn't match the type of the assignment target",
                    bin.left.span,
                    bin.right);
            }
            return lhs;
        }

        // Constant division/remainder by a literal zero is always a fault
        // (UB in the backend). Catch it before operand types matter.
        if ((bin.op.lexeme == "/" || bin.op.lexeme == "%")
            && is_zero_int_literal(bin.right)) {
            this.ctx.emit_error_at(
                ErrorCode::E0226_DIVISION_BY_ZERO,
                if (bin.op.lexeme == "/") { "division by zero" }
                else { "remainder with a zero divisor" },
                bin.span);
        }

        // Non-assignment binary ops: when one operand is a numeric literal
        // and the other isn't, resolve the non-literal first and use its
        // type as the expected_type for the literal.
        if (right_is_lit && !left_is_lit) {
            lhs = this.resolve_expr(bin.left);
            if (lhs.is_valid()) {
                const saved_exp: TypeRef = this.expected_type;
                this.expected_type = lhs;
                rhs = this.resolve_expr(bin.right);
                this.expected_type = saved_exp;
            } else {
                rhs = this.resolve_expr(bin.right);
            }
        } else if (left_is_lit && !right_is_lit) {
            rhs = this.resolve_expr(bin.right);
            if (rhs.is_valid()) {
                const saved_exp: TypeRef = this.expected_type;
                this.expected_type = rhs;
                lhs = this.resolve_expr(bin.left);
                this.expected_type = saved_exp;
            } else {
                lhs = this.resolve_expr(bin.left);
            }
        } else {
            lhs = this.resolve_expr(bin.left);
            rhs = this.resolve_expr(bin.right);
        }

        if (lhs.is_valid() && rhs.is_valid()) {
            const result: TypeCheckResult = this.checker.check_binary_op(
                bin.op.lexeme, lhs, rhs);
            if (result.success) { return result.result_type; }
            this.ctx.emit_error_at(ErrorCode::E0229_INVALID_BINARY_OP,
                result.error_message, bin.span);
        }

        if (lhs.is_valid()) { return lhs; }
        if (rhs.is_valid()) { return rhs; }
        return TypeRef::invalid();
    }

    /// Walk the LHS of an assignment and verify it's a mutable lvalue.
    /// Emits a diagnostic on the first immutable target found and stops.
    /// Coverage today (conservative; kept narrow for 0.1.0):
    ///   - Identifier -> local must be `mut`; constants and `const`
    ///     locals are rejected.
    ///   - MemberAccess (`obj.field`) -> recurse on the receiver.  When
    ///     the receiver is a value-type local, immutable receivers
    ///     reject the assignment.  Pointer/reference receivers are
    ///     conservatively accepted; fine-grained pointer-mutability
    ///     tracking is post-0.1 work.
    ///   - ArrayAccess (`arr[i]`) -> recurse on the array.
    ///   - Deref (`*x`) and `*this` -> accepted; pointer-pointee
    ///     mutability is not yet tracked.
    /// Anything else is accepted as-is.
    check_assignment_lvalue(mut &this, lhs: ExpressionNode*) -> void {
        if (lhs == null) { return; }
        match (lhs.kind) {
            NodeKind::Identifier => {
                const id: IdentifierNode* = lhs as IdentifierNode*;
                // Skip `this`: its mutability is handled by the receiver
                // logic in MemberAccess / *this; bare `this = X` is rare.
                if (id.name.equals(this.this_sym)) { return; }
                // Only check names that appear in our locals map; globals
                // and pseudo-macros (FILE/LINE) aren't tracked here.
                match (this.local_muts.get(&id.name.id)) {
                    Option::Some(is_mut) => {
                        if (!is_mut) {
                            const name_str: string = this.intern.resolve(id.name);
                            mut diag: Diagnostic = Diagnostic::error(
                                ErrorCode::E0218_IMMUTABLE_ASSIGNMENT,
                                format("cannot assign to immutable variable `%s`",
                                    name_str));
                            diag = diag.at_with_label(lhs.span,
                                "this binding is immutable");
                            // Machine-applicable fix: if we recorded a
                            // keyword anchor at the declaration site,
                            // either replace `const` with `mut` (for
                            // top-level locals) or insert `mut ` before
                            // the parameter name (zero-width anchor).
                            // The renderer + LSP both consume `.parts`
                            // directly, so a single edit is enough.
                            match (this.local_kw_spans.get(&id.name.id)) {
                                Option::Some(kw) => {
                                    const kw_len: u32 =
                                        if (kw.end_col > kw.start_col) {
                                            kw.end_col - kw.start_col
                                        } else { 0 };
                                    if (kw_len == 0) {
                                        // Param without `mut`: insert "mut "
                                        // before the name.
                                        diag = diag.suggest(
                                            Suggestion::machine_applicable(
                                                kw, "mut ",
                                                format("make `%s` mutable", name_str)));
                                    } else {
                                        // Local with `const` (or `mut` -
                                        // skipped already by the !is_mut
                                        // guard above): replace with `mut`.
                                        diag = diag.suggest(
                                            Suggestion::machine_applicable(
                                                kw, "mut",
                                                format("make `%s` mutable", name_str)));
                                    }
                                }
                                Option::None => {
                                    diag = diag.with_note("declare the binding with `mut` instead of `const` to allow reassignment");
                                }
                            }
                            this.ctx.diagnostics.emit(diag);
                        }
                    }
                    Option::None => {}
                }
            }
            NodeKind::MemberAccess => {
                const ma: MemberAccessNode* = lhs as MemberAccessNode*;
                if (ma.object == null) { return; }
                // For value-type receivers, mutating a field requires a
                // mutable receiver.  For pointer/reference receivers the
                // receiver itself is the address, so its top-level
                // mutability doesn't constrain field assignment.
                const recv_t: Type* = this.arena.lookup(ma.object.resolved_type.id);
                if (recv_t != null
                    && (recv_t.kind == TypeKind::Pointer
                        || recv_t.kind == TypeKind::Reference)) {
                    return;
                }
                this.check_assignment_lvalue(ma.object);
            }
            NodeKind::ArrayAccess => {
                const aa: ArrayAccessNode* = lhs as ArrayAccessNode*;
                if (aa.array == null) { return; }
                const arr_t: Type* = this.arena.lookup(aa.array.resolved_type.id);
                if (arr_t != null
                    && (arr_t.kind == TypeKind::Pointer
                        || arr_t.kind == TypeKind::Reference)) {
                    return;
                }
                this.check_assignment_lvalue(aa.array);
            }
            NodeKind::Literal => {
                // A literal is a value, never a place. `5 = 3` and the
                // like can never be a valid assignment target.
                this.ctx.emit_error_at(
                    ErrorCode::E0232_INVALID_ASSIGNMENT_TARGET,
                    "cannot assign to a literal; the left-hand side of an assignment must be a place (variable, field, or index)",
                    lhs.span);
            }
            // UnaryExpression (deref), CallExpression result, etc.: accept.
            _ => {}
        }
    }

    resolve_unary(mut &this, unary: UnaryExprNode*) -> TypeRef {
        const operand_type: TypeRef = this.resolve_expr(unary.operand);
        if (!operand_type.is_valid()) { return TypeRef::invalid(); }

        // `&` requires a place. The address of a literal would point at a
        // transient temporary, so reject `&5`, `&"x"`, etc. Synthesized
        // address-of (e.g. the `<=>` desugar) is exempt: it deliberately
        // borrows a compiler-materialized temporary.
        if (unary.op.lexeme == "&"
            && !unary.is_synthetic
            && unary.operand != null
            && unary.operand.kind == NodeKind::Literal) {
            this.ctx.emit_error_at(
                ErrorCode::E0223_INVALID_ADDRESS_OF,
                "cannot take the address of a literal; `&` requires a place (variable, field, or index)",
                unary.span);
            return TypeRef::invalid();
        }

        // `*this` is transparent at the type level.  Receivers are tagged
        // with the bare owner type (`Foo`, not `&Foo`) per the parser's
        // `&this` synthesis, but codegen actually passes them as pointers.
        // The stdlib uses `*this = newvalue` to overwrite the receiver
        // in place; that pattern type-checks here without the deref
        // failing on a non-pointer operand.
        if (unary.op.lexeme == "*"
            && unary.operand != null
            && unary.operand.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = unary.operand as IdentifierNode*;
            if (id.name.equals(this.this_sym)) {
                return operand_type;
            }
        }

        const result: TypeCheckResult = this.checker.check_unary_op(
            unary.op.lexeme, operand_type);
        if (!result.success) {
            this.ctx.emit_error_at(ErrorCode::E0230_INVALID_UNARY_OP,
                result.error_message, unary.span);
            return operand_type;
        }

        // Address-of (&): if the target expects &mut T, promote to mutable reference.
        // The checker always produces &T (immutable); upgrade when the context demands it.
        if (unary.op.lexeme == "&") {
            if (this.expected_type.is_valid()) {
                const exp_type: Type* = this.arena.lookup(this.expected_type.id);
                if (exp_type != null) {
                    if (exp_type.kind == TypeKind::Reference) {
                        const exp_ref: ReferenceType* = exp_type as ReferenceType*;
                        if (exp_ref.is_mutable()) {
                            return this.arena.get_reference_to(operand_type, RefMutability::Mutable);
                        }
                    }
                }
            }
        }

        return result.result_type;
    }

    /// Best-effort lookup of a callee's FunctionType TypeRef.  Used by
    /// `resolve_call` to push expected parameter types during arg
    /// resolution.  Returns invalid when the callee isn't statically
    /// resolvable (first-class function pointers, unresolved methods).
    /// Pick up the declared parameter types for a method call of the form
    /// `receiver.method(args)`.  Mirrors the receiver-type unwrap used by
    /// `resolve_method_overload` / `resolve_method_call`; walks the method
    /// table on the underlying struct/class and returns the matching
    /// MethodInfo's param_types when every matching overload agrees on
    /// the type at each position; otherwise returns an empty list so
    /// ambiguous overloads don't produce misleading hints.
    lookup_method_param_types(mut &this, member: MemberAccessNode*,
                               arg_count: i64) -> TypeRef[] {
        const obj_type: TypeRef = this.resolve_expr(member.object);
        if (!obj_type.is_valid()) { return []; }
        mut base_t: Type* = this.arena.lookup(obj_type.id);
        mut depth: i32 = 0;
        while (base_t != null && depth < 5) {
            match (base_t.kind) {
                TypeKind::Pointer => {
                    const pt: PointerType* = base_t as PointerType*;
                    base_t = this.arena.lookup(pt.pointee.id);
                }
                TypeKind::Reference => {
                    const rt: ReferenceType* = base_t as ReferenceType*;
                    base_t = this.arena.lookup(rt.referent.id);
                }
                TypeKind::InstantiatedType => {
                    const inst: InstantiatedType* = base_t as InstantiatedType*;
                    if (!inst.has_resolved_type()) { break; }
                    base_t = this.arena.lookup(inst.resolved_type.id);
                }
                _ => { break; }
            }
            depth += 1;
        }
        if (base_t == null) { return []; }

        mut methods: MethodInfo[] = [];
        if (base_t.kind == TypeKind::Class) {
            const ct: ClassType* = base_t as ClassType*;
            methods = ct.methods;
        } else if (base_t.kind == TypeKind::Struct) {
            const st: StructType* = base_t as StructType*;
            methods = st.methods;
        } else if (base_t.kind == TypeKind::BoundedParam) {
            // Bound-aware param-type hint: when the receiver is a generic
            // param `T: Trait`, look up `member` on each bound trait so
            // call-arg expected_type propagation can pick up the trait
            // method's declared param types. Without this, `T::deallocate`
            // resolves arg types with no expected hint, so the inner
            // `NonNull::new(...)` falls through `try_resolve_generic_return`'s
            // expected_type fallback and bottoms out at the unresolved
            // template, breaking codegen.
            const bp: BoundedParamType* = base_t as BoundedParamType*;
            for (mut bi: i64 = 0; bi < bp.bounds.length; bi++) {
                const bt: Type* = this.arena.lookup(bp.bounds[bi].id);
                if (bt == null || bt.kind != TypeKind::Trait) { continue; }
                const tt: TraitType* = bt as TraitType*;
                for (mut mi: i64 = 0; mi < tt.required_methods.length; mi++) {
                    methods.push(tt.required_methods[mi]);
                }
            }
            if (methods.length == 0) { return []; }
        } else {
            return [];
        }

        // Narrow to overloads whose arity matches the call; an overload
        // with a different param count can't participate in this call's
        // type-checking, so it shouldn't influence the hint.
        mut found: MethodInfo[] = [];
        for (mut i: i64 = 0; i < methods.length; i++) {
            if (methods[i].name.equals(member.member) &&
                methods[i].param_types.length == arg_count) {
                found.push(methods[i]);
            }
        }
        if (found.length == 0) { return []; }
        if (found.length == 1) { return found[0].param_types; }

        // Multiple arity-matching overloads: return a position-wise hint
        // only where every overload agrees on the type.  A TypeRef::invalid()
        // at a given slot disables the hint for that arg (caller only
        // pushes when param_types[i].is_valid()).
        mut merged: TypeRef[] = [];
        for (mut p: i64 = 0; p < arg_count; p++) {
            const first_info: MethodInfo = found[0];
            const first_ty: TypeRef = first_info.param_types[p];
            mut agree: boolean = true;
            for (mut j: i64 = 1; j < found.length; j++) {
                const j_info: MethodInfo = found[j];
                const j_ty: TypeRef = j_info.param_types[p];
                if (j_ty.id != first_ty.id) {
                    agree = false;
                    break;
                }
            }
            if (agree) {
                merged.push(first_ty);
            } else {
                merged.push(TypeRef::invalid());
            }
        }
        return merged;
    }

    /// For a scope-resolution callee that denotes an enum variant constructor
    /// (e.g. `IoResult::Err`, `Option::Some`), return the variant's payload
    /// types so that args can be resolved with proper expected_type hints.
    /// Generic enum templates don't populate variants on the template (see
    /// StructFieldTypeSync), so when the scope resolves to an unspecialized
    /// generic enum we consult the expected_type to find the concrete
    /// specialization whose variants carry resolved payload types.
    lookup_scope_variant_payload_types(&this, scope: ScopeResolutionNode*) -> TypeRef[] {
        mut type_ref: TypeRef = this.lookup_type_by_sym(scope.scope_name);
        // If the scope has explicit generic args (e.g., IoResult<u8>::Err),
        // resolve them to the specialized type.
        if (scope.scope_generic_args.length > 0) {
            const spec_sym: SymbolStr = this.resolve_generic_scope_name(
                scope.scope_name, scope.scope_generic_args);
            if (spec_sym.is_valid()) {
                const spec_ref: TypeRef = this.lookup_type_by_sym(spec_sym);
                if (spec_ref.is_valid()) { type_ref = spec_ref; }
            }
        }
        if (!type_ref.is_valid()) { return []; }
        mut enum_t: Type* = this.arena.lookup(type_ref.id);
        if (enum_t == null) { return []; }
        // If the looked-up type is generic (template variants are not
        // populated per StructFieldTypeSync), try to find the specialized
        // instantiation via expected_type.  e.g. expected_type =
        // Option<IoResult<u8>> for outer Option::Some; for inner
        // IoResult::Err the caller has pushed expected_type = IoResult<u8>.
        if (enum_t.kind == TypeKind::Enum) {
            const et: EnumType* = enum_t as EnumType*;
            if (et.variants.length == 0 && this.expected_type.is_valid()) {
                mut exp_ref: TypeRef = this.expected_type;
                mut exp_t: Type* = this.arena.lookup(exp_ref.id);
                if (exp_t != null && exp_t.kind == TypeKind::TypeAlias) {
                    const alias: TypeAliasType* = exp_t as TypeAliasType*;
                    if (alias.has_target()) {
                        exp_ref = alias.target;
                        exp_t = this.arena.lookup(exp_ref.id);
                    }
                }
                if (exp_t != null && exp_t.kind == TypeKind::InstantiatedType) {
                    const exp_inst: InstantiatedType* = exp_t as InstantiatedType*;
                    if (exp_inst.generic_base.id == type_ref.id && exp_inst.has_resolved_type()) {
                        enum_t = this.arena.lookup(exp_inst.resolved_type.id);
                    }
                }
            }
        }
        if (enum_t == null || enum_t.kind != TypeKind::Enum) { return []; }
        const et: EnumType* = enum_t as EnumType*;
        const variant: EnumVariantInfo* = et.get_variant(scope.member_name);
        if (variant == null) { return []; }
        // If the variant payload references the enum's generic params
        // (which it does on the template, e.g. Result::Ok carries `T`),
        // substitute those params with the concrete type-args from
        // `expected_type`. This is the case the `has_resolved_type` branch
        // above misses: when the spec InstantiatedType exists but never had
        // its `resolved_type` populated, its type_args are still concrete
        // and we can substitute manually so the caller gets a usable
        // expected_type for the arg (e.g. NonNull<u8>) rather than the
        // raw generic param.
        if (this.expected_type.is_valid()) {
            mut exp_ref2: TypeRef = this.expected_type;
            mut exp_t2: Type* = this.arena.lookup(exp_ref2.id);
            if (exp_t2 != null && exp_t2.kind == TypeKind::TypeAlias) {
                const alias2: TypeAliasType* = exp_t2 as TypeAliasType*;
                if (alias2.has_target()) {
                    exp_ref2 = alias2.target;
                    exp_t2 = this.arena.lookup(exp_ref2.id);
                }
            }
            if (exp_t2 != null && exp_t2.kind == TypeKind::InstantiatedType) {
                const exp_inst2: InstantiatedType* = exp_t2 as InstantiatedType*;
                if (exp_inst2.generic_base.id == type_ref.id) {
                    return this.substitute_payload_types(
                        variant.payload_types, type_ref, exp_inst2.type_args);
                }
            }
        }
        return variant.payload_types;
    }

    /// Substitute the enum's template generic params with concrete type
    /// args. `template_ref` is the generic enum's TypeRef (which carries
    /// param names via the generic registry).
    substitute_payload_types(&this, payload: TypeRef[], template_ref: TypeRef,
                              type_args: TypeRef[]) -> TypeRef[] {
        if (this.ctx.generic_registry == null) { return payload; }
        const entry: TemplateEntry* =
            this.ctx.generic_registry.get_template_by_type_id(template_ref.id);
        if (entry == null) { return payload; }
        if (entry.param_count != type_args.length) { return payload; }
        mut result: TypeRef[] = [];
        for (mut i: i64 = 0; i < payload.length; i++) {
            const pt: Type* = this.arena.lookup(payload[i].id);
            if (pt == null) {
                result.push(payload[i]);
            } else if (pt.kind == TypeKind::GenericParam) {
                const gp: GenericParamType* = pt as GenericParamType*;
                mut substituted: TypeRef = payload[i];
                for (mut p: i64 = 0; p < entry.param_count; p++) {
                    if (entry.param_names[p].equals(gp.param_name)) {
                        substituted = type_args[p];
                        break;
                    }
                }
                result.push(substituted);
            } else if (pt.kind == TypeKind::BoundedParam) {
                const bp: BoundedParamType* = pt as BoundedParamType*;
                mut substituted: TypeRef = payload[i];
                for (mut p: i64 = 0; p < entry.param_count; p++) {
                    if (entry.param_names[p].equals(bp.param_name)) {
                        substituted = type_args[p];
                        break;
                    }
                }
                result.push(substituted);
            } else {
                result.push(payload[i]);
            }
        }
        return result;
    }

    lookup_callee_function_type(&this, callee: ExpressionNode*) -> TypeRef {
        if (callee == null) { return TypeRef::invalid(); }
        const n: ASTNode* = callee as ASTNode*;
        if (n.kind == NodeKind::Identifier) {
            const ident: IdentifierNode* = callee as IdentifierNode*;
            const bare: TypeRef = this.ctx.decl_index.lookup_func_type(ident.name);
            if (bare.is_valid()) { return bare; }
            // Fall back to the current-module qualified form for paths
            // that only registered the fully-qualified key.
            const q_sym: SymbolStr = this.ctx.qualify_symbol_sym(ident.name);
            return this.ctx.decl_index.lookup_func_type(q_sym);
        }
        if (n.kind == NodeKind::ScopeResolution) {
            const sr: ScopeResolutionNode* = callee as ScopeResolutionNode*;
            // Try the bare scope name first.
            const bare_combined: string = format("%s::%s",
                this.intern.resolve(sr.scope_name),
                this.intern.resolve(sr.member_name));
            const bare_sym: SymbolStr = this.intern.intern(bare_combined);
            const bare_ft: TypeRef = this.ctx.decl_index.lookup_func_type(bare_sym);
            if (bare_ft.is_valid()) { return bare_ft; }
            // Fall back to the fully-qualified scope (TokenStream ->
            // Compiler::Artifacts::TokenStream) via DI's scope resolution.
            const resolved_scope: SymbolStr = this.ctx.decl_index.resolve_qualified(sr.scope_name);
            if (resolved_scope.is_valid()) {
                const q_combined: string = format("%s::%s",
                    this.intern.resolve(resolved_scope),
                    this.intern.resolve(sr.member_name));
                const q_sym: SymbolStr = this.intern.intern(q_combined);
                return this.ctx.decl_index.lookup_func_type(q_sym);
            }
            return TypeRef::invalid();
        }
        // MemberAccess would need a receiver-type lookup; skip for now
        // (method overload resolution handles type-correctness there).
        return TypeRef::invalid();
    }

    resolve_call(mut &this, call: CallExprNode*) -> TypeRef {
        // Closure-call rewrite: `f(args)` where `f` is a value of a
        // synthesised closure-struct type (carries a `__call__` method)
        // becomes `f.__call__(args)`.  Sema's normal method-dispatch path
        // takes over from there; codegen sees a regular method call.
        // Skipped for non-closure identifiers so plain function calls
        // still take the existing direct-call fast path.
        this.maybe_rewrite_closure_call(call);

        // Most args resolve without an expected type; integer literal
        // widths, etc., are resolved from their own literal form.  BUT
        // empty array literals (`[]`) need the param type to pick up an
        // element type, since they have no contents to infer from.  To
        // avoid side-effects on other literals (e.g. widening i32 -> i64
        // where a subsequent cast expected i32), we ONLY push expected
        // type when the arg is a zero-length ArrayLiteral.
        mut param_types: TypeRef[] = [];
        const callee_fn_type: TypeRef = this.lookup_callee_function_type(call.callee);
        if (callee_fn_type.is_valid()) {
            const ft_raw: Type* = this.arena.lookup(callee_fn_type.id);
            if (ft_raw != null && ft_raw.kind == TypeKind::Function) {
                const ft: FunctionType* = ft_raw as FunctionType*;
                param_types = ft.param_types;
            }
        }
        // Method calls (MemberAccess callee) don't go through the
        // function-type registry; their signatures live on the
        // receiver type's MethodInfo.  Walk the method table to
        // pick up param types for expected-type propagation.
        if (param_types.length == 0) {
            const callee_node: ASTNode* = call.callee as ASTNode*;
            if (callee_node.kind == NodeKind::MemberAccess) {
                param_types = this.lookup_method_param_types(
                    call.callee as MemberAccessNode*,
                    call.arguments.length);
            }
        }
        // Enum variant constructors (`Option::Some`, `IoResult::Err`) carry
        // their param types as the variant's payload_types.  Without this,
        // nested calls like `Option::Some(IoResult::Err(e))` resolve the
        // inner `IoResult::Err` with no expected_type; `promote_to_expected_instantiation`
        // then returns the generic template whose variants were left empty
        // by StructFieldTypeSync, and codegen bottoms out on a NULL variant.
        if (param_types.length == 0) {
            const callee_node: ASTNode* = call.callee as ASTNode*;
            if (callee_node.kind == NodeKind::ScopeResolution) {
                param_types = this.lookup_scope_variant_payload_types(
                    call.callee as ScopeResolutionNode*);
            }
        }
        const saved_expected: TypeRef = this.expected_type;
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            mut push_expected: boolean = false;
            const arg: ExpressionNode* = call.arguments[i];
            if (arg != null && i < param_types.length && param_types[i].is_valid()) {
                const arg_node: ASTNode* = arg as ASTNode*;
                if (arg_node.kind == NodeKind::ArrayLiteral) {
                    // Push the param type for ANY array-literal arg, not
                    // just empty ones.  For element-form literals the
                    // dynamic-vs-fixed shape is otherwise inferred from
                    // elements.length, which produces `[T; N]` when the
                    // callee expects `T[]`; call-arg coercion has no
                    // natural way to reinterpret a fixed array as a
                    // fat pointer.  The dynamic-shape branch in
                    // resolve_array_literal adopts the param's shape
                    // when assignable, so the literal lands as `T[]`.
                    push_expected = true;
                } else if (arg_node.kind == NodeKind::CallExpression
                        || arg_node.kind == NodeKind::ScopeResolution) {
                    // Nested calls and scope references need the param type
                    // so generic variant/static-method calls can reach their
                    // concrete instantiation instead of the raw template.
                    // Only call/scope kinds; Literal, Identifier, etc., have
                    // their own types and would only get confused (e.g. i32
                    // literal widening to i64 under a u64 param slot).
                    push_expected = true;
                } else if (is_negative_numeric_literal_expr(arg) &&
                           this.is_signed_int_type(param_types[i])) {
                    // A negative numeric literal (`-9223372036854775808`)
                    // wraps its magnitude in a UnaryExpression.  Without the
                    // param type, the magnitude defaults to i32 and a wide
                    // bit pattern (i64::MIN) truncates to its low 32 bits = 0
                    // before codegen sees it.  Push the param type so the
                    // magnitude adopts the slot's width.  (Bare positive
                    // literals are still left to their own form to avoid
                    // surprise i32 -> i64 widening under wider param slots.)
                    //
                    // ONLY for a SIGNED target: pushing an UNSIGNED param type
                    // onto a negative literal silently coerces e.g. `-1` to
                    // 4294967295 (`take_u32(-1)`), the exact footgun assignment
                    // rejects.  Leaving it unpushed keeps the literal signed so
                    // the same-width-sign-reinterpret arg gate below flags it.
                    push_expected = true;
                }
            }
            if (push_expected) {
                this.expected_type = param_types[i];
            } else {
                this.expected_type = TypeRef::invalid();
            }
            this.resolve_expr(arg);
        }
        this.expected_type = saved_expected;

        // Auto-ref: flag by-value arguments bound to reference (`&T`)
        // parameters so codegen passes their address.  `param_types` (used
        // above for expected-type propagation) carries the callee's
        // non-receiver parameter source types for free / method / scope
        // calls alike - including generic `&T`, which is exactly the case
        // the auto-ref fixes (e.g. `println(x)` over `println<T>(&T)`).
        this.flag_autoref_from_params(call, param_types);

        const callee: ExpressionNode* = call.callee;
        const callee_node: ASTNode* = callee as ASTNode*;

        if (callee_node.kind == NodeKind::Identifier) {
            const ident: IdentifierNode* = callee as IdentifierNode*;
            // Phase 5: when one or more args are capturing closures bound
            // to fn-typed parameter slots, synthesise a specialised clone
            // of the callee with the affected parameters re-typed as the
            // concrete closure-struct types, and pin `resolved_callee` to
            // its mangled symbol.  The early-return below then short-
            // circuits past the original-template arity / overload checks
            // (which would otherwise reject the closure-struct args as
            // not matching the fn-pointer param types).  Untouched calls
            // - including every existing fn-pointer call site - fall
            // through unchanged.
            this.try_specialize_for_closure_args(call, ident);

            // If mono pre-pinned a specialized callee (inferred-arg generic
            // free-function calls inside a spec'd body, e.g.
            // `alloc_entry(this, h, k, v)` after HashMap<K,V,A>::insert is
            // monomorphized), prefer the spec'd return type over the bare
            // template's still-generic one.  Without this, sema sees the
            // template's `Result<Entry<K,V>*, AllocError>` return and
            // downstream match-arm bindings (e.g., `Result::Ok(fresh)`)
            // resolve `fresh` to a still-generic payload type that codegen
            // can't lower.
            if (call.resolved_callee.is_valid()) {
                const spec_ret: TypeRef = this.lookup_func_return(call.resolved_callee);
                if (spec_ret.is_valid()) { return spec_ret; }
            }
            // If the call has generic args (e.g., identity<int>(100)),
            // resolve the specialized function name first.  We pin the
            // specialized callee symbol on the call so codegen can find
            // the concrete LLVM function; the bare template name is
            // skipped at codegen.
            if (call.generic_args.length > 0) {
                const spec_sym: SymbolStr = this.resolve_generic_scope_name(
                    ident.name, call.generic_args);
                if (spec_sym.is_valid()) {
                    call.set_resolved_callee(spec_sym);
                    const spec_ret: TypeRef = this.lookup_func_return(spec_sym);
                    if (spec_ret.is_valid()) { return spec_ret; }
                }
            }
            // Free-function overload resolution.  When multiple overloads
            // share `ident.name` (e.g. `visit(A*)` / `visit(B*)`), the
            // bare/qualified mangled-name slot in DI is last-write-wins,
            // so codegen's downstream `resolve_function*` calls would
            // dispatch every call to the last-registered overload's
            // mangled symbol.  Walk the overload set, find the one whose
            // declared param types match the call's arg types, and pin
            // its overload-specific mangled name to `resolved_callee` so
            // codegen can look up the right LLVM function directly.
            // A local binding of function-pointer type shadows any global
            // function of the same name (lexical scoping; see
            // resolve_direct_call). The arity check and overload-callee
            // pinning below are global-function-oriented: they would emit a
            // spurious arity diagnostic against the shadowed global and pin
            // its mangled symbol to `resolved_callee`, which codegen honors
            // first - making the call dispatch to the global at runtime.
            // Skip both when a local function pointer shadows, and let
            // resolve_direct_call route through the local.
            mut fp_shadows_global: boolean = false;
            const fp_shadow: TypeRef = this.lookup_local(ident.name);
            if (fp_shadow.is_valid()) {
                const fp_shadow_t: Type* = this.arena.lookup(fp_shadow.id);
                if (fp_shadow_t != null && fp_shadow_t.kind == TypeKind::Function) {
                    fp_shadows_global = true;
                }
            }
            if (!fp_shadows_global) {
                this.check_call_arity(call, ident);
                this.try_pin_overload_mangled_callee(call, ident);
            }
            return this.resolve_direct_call(ident);
        }
        if (callee_node.kind == NodeKind::MemberAccess) {
            // Phase 5 scope-guard: capturing closures are only delivered
            // through free-function `(Args) -> Ret` parameters in v1.0,
            // via `try_specialize_for_closure_args` above.  A closure
            // passed to a method's fn-typed param (`some.map(closure)`)
            // would silently miscompile because the per-call-site spec
            // path is only wired for Identifier callees.  Reject here
            // with an explicit diagnostic so users see a clear v1.0
            // limitation note instead of an LLVM verification failure
            // (or, worse, runtime UB) downstream.
            this.reject_closure_struct_args_in_non_free_call(call,
                "passing a capturing closure as a method-call argument");
            // Run overload resolution first: tags `call.resolved_method`
            // with the specific method declaration whose parameter types
            // match the call args.  Codegen trusts this tag to pick the
            // correct vtable slot for virtual dispatch; it's also the
            // foundation for precise direct-call overload selection.
            this.resolve_method_overload(call, callee as MemberAccessNode*);
            this.check_method_call_arg_types(call, callee as MemberAccessNode*);
            return this.resolve_method_call(callee as MemberAccessNode*);
        }
        if (callee_node.kind == NodeKind::ScopeResolution) {
            // Phase 5 scope-guard, mirroring the MemberAccess branch:
            // `Type::method(closure)` and `Module::func(closure)` are
            // not yet routed through closure-arg specialisation.
            this.reject_closure_struct_args_in_non_free_call(call,
                "passing a capturing closure to a scope-resolution call");
            const scope_ret: TypeRef = this.resolve_scope_call(
                callee as ScopeResolutionNode*, call);
            if (scope_ret.is_valid()) {
                this.check_scope_call_arg_types(
                    callee as ScopeResolutionNode*, call);
            }
            return scope_ret;
        }

        return this.resolve_expr(callee);
    }

    /// Conservative arity check for direct free-function calls.
    ///
    /// `resolve_call` resolves every argument expression but never
    /// validated their *count* against the callee's parameter list -
    /// `f(a, b, c)` for a 2-parameter `f` reached codegen with no
    /// diagnostic.  This is the first such check.  It is deliberately
    /// narrow to stay false-positive-free:
    ///   - Only plain `Identifier` callees (free functions); method and
    ///     scope calls have their own resolution paths.
    ///   - Skipped when the name has 0 or >1 overloads - with multiple
    ///     overloads we can't know which one this call targets without
    ///     full argument-type matching.
    ///   - Skipped for variadic functions and explicit-generic calls.
    ///   - Only *too many* arguments is reported.  *Too few* is legal in
    ///     the presence of default parameter values, which `FunctionType`
    ///     does not track; flagging it here would false-positive on every
    ///     defaulted call.  Passing *more* args than a non-variadic
    ///     function declares is unambiguously wrong regardless of defaults.
    ///
    /// Once arity matches, each argument is also type-checked against its
    /// declared parameter via `check_call_arg_types` (below), which reuses
    /// `TypeChecker::check_compatibility` and flags hard category
    /// mismatches (e.g. a `string` passed where an `i32` is expected).
    check_call_arity(mut &this, call: CallExprNode*, ident: IdentifierNode*) -> void {
        // Explicit generic calls (`f<T>(...)`) route through specialization;
        // skip rather than risk a template/instance param-count mismatch.
        if (call.generic_args.length > 0) { return; }

        // Resolve the overload set for the name.  Require exactly one:
        // 0 means it isn't a declared free function (e.g. a local
        // function-pointer binding), >1 means we'd need argument-type
        // matching to know which overload this call targets.
        const qualified: SymbolStr = this.ctx.qualify_symbol_sym(ident.name);
        mut overloads: TypeRef[] =
            this.ctx.decl_index.lookup_func_type_overloads(qualified);
        if (overloads.length == 0) {
            overloads = this.ctx.decl_index.lookup_func_type_overloads(ident.name);
        }
        if (overloads.length != 1) { return; }

        const ft_raw: Type* = this.arena.lookup(overloads[0].id);
        if (ft_raw == null || ft_raw.kind != TypeKind::Function) { return; }
        const ft: FunctionType* = ft_raw as FunctionType*;

        // Variadic functions accept any count >= the fixed prefix.
        if (ft.is_variadic) { return; }

        const expected: i64 = ft.param_types.length;
        const got: i64 = call.arguments.length;
        if (got < expected) {
            const name: string = this.intern.resolve(ident.name);
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0216_TOO_FEW_ARGS,
                format("function `%s` takes %lld argument(s) but %lld were supplied",
                       name, expected, got));
            diag = diag.at_with_label(call.span,
                format("missing %lld argument%s",
                    expected - got,
                    if (expected - got == 1) { "" } else { "s" }));

            // Has-placeholders insert: append `<TypeName>` placeholders
            // for each missing parameter, anchored just before the
            // closing paren.  Skipped when the call span looks malformed.
            if (call.span.has_location() && call.span.end_col > 0) {
                mut repl: string = "";
                for (mut k: i64 = got; k < expected; k++) {
                    const pname: string =
                        this.arena.resolve_display_name_short(ft.param_types[k].id);
                    const sep: string = if (k == 0) { "" } else { ", " };
                    repl = format("%s%s<%s>", repl, sep, pname);
                }
                const ins: SourceSpan = SourceSpan::new(
                    call.span.file,
                    call.span.end_line, call.span.end_col - 1,
                    call.span.end_line, call.span.end_col - 1);
                diag = diag.suggest(Suggestion::single(ins, repl,
                    if (expected - got == 1) {
                        "provide the missing argument"
                    } else {
                        "provide the missing arguments"
                    },
                    Applicability::HasPlaceholders));
            }
            this.ctx.diagnostics.emit(diag);
            return;
        }
        if (got > expected) {
            const name: string = this.intern.resolve(ident.name);
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0215_TOO_MANY_ARGS,
                format("function `%s` takes %lld argument(s) but %lld were supplied",
                       name, expected, got));
            diag = diag.at_with_label(call.span,
                format("unexpected argument%s",
                    if (got - expected == 1) { "" } else { "s" }));

            // Machine-applicable: delete from the end of the last
            // accepted argument through the byte just before the closing
            // paren.  This removes both the excess args AND the separating
            // commas, leaving the call shape (and surrounding code)
            // intact.  Skipped when the spans we'd need are missing or
            // out of order - the diagnostic itself still renders.
            mut anchor_end_line: u32 = 0;
            mut anchor_end_col:  u32 = 0;
            mut anchor_ok:       boolean = false;
            if (expected == 0) {
                // Remove every argument: anchor right after `(`, derived
                // from the start of the first argument.  We can't undo
                // any whitespace between `(` and the first arg, but the
                // user's IDE will collapse it when the replacement
                // applies.
                if (call.arguments.length > 0
                    && call.arguments[0] != null
                    && call.arguments[0].span.has_location()) {
                    anchor_end_line = call.arguments[0].span.start_line;
                    anchor_end_col  = call.arguments[0].span.start_col;
                    anchor_ok = true;
                }
            } else {
                const last_keep: ExpressionNode* =
                    call.arguments[expected - 1];
                if (last_keep != null && last_keep.span.has_location()) {
                    anchor_end_line = last_keep.span.end_line;
                    anchor_end_col  = last_keep.span.end_col;
                    anchor_ok = true;
                }
            }
            if (anchor_ok && call.span.has_location()
                && call.span.end_col > 0) {
                const removal: SourceSpan = SourceSpan::new(
                    call.span.file,
                    anchor_end_line, anchor_end_col,
                    call.span.end_line,
                    call.span.end_col - 1);
                diag = diag.suggest(Suggestion::machine_applicable(
                    removal, "",
                    if (got - expected == 1) {
                        "remove the extra argument"
                    } else {
                        format("remove the %lld extra arguments",
                            got - expected)
                    }));
            }

            this.ctx.diagnostics.emit(diag);
            return;
        }

        // Both arity checks passed (got == expected).  Type-check each
        // argument against its declared parameter type.  (Auto-ref of
        // value args to `&T` params is handled once in `resolve_call`.)
        this.check_args_against_params(call, ft.param_types.as_slice());
    }

    /// Per-argument type checking for a call whose argument list aligns
    /// 1:1 with `param_types` (free-function params, or a method's
    /// non-receiver params).  Conservative by design: an argument is
    /// flagged ONLY when `check_compatibility(arg, param)` bottoms out at
    /// `Incompatible` - a hard category mismatch such as passing a
    /// `string` where an `i32` is expected.  Every coercion the back end
    /// already performs (numeric widen/narrow, sign change, `&T`->`T*`,
    /// `void*`<->`T*`, class upcast, ...) maps to `ImplicitConvert` /
    /// `ExplicitCast` and is intentionally left alone, so this never
    /// rejects code codegen would have compiled correctly.  Generic /
    /// template / not-yet-instantiated types are skipped (opaque before
    /// monomorphization); the specialized instance is re-checked once
    /// every `T` is concrete.
    check_args_against_params(mut &this, call: CallExprNode*,
                              param_types: Slice<TypeRef>) -> void {
        const n: i64 = param_types.length as i64;
        for (mut i: i64 = 0; i < n; i++) {
            if (i >= call.arguments.length) { break; }
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null) { continue; }
            const arg_ty:   TypeRef = arg.resolved_type;
            const param_ty: TypeRef = param_types.get(i as u64).unwrap();
            if (!this.arg_type_is_concrete(arg_ty))   { continue; }
            if (!this.arg_type_is_concrete(param_ty)) { continue; }
            const compat: TypeCompatibility =
                this.checker.check_compatibility(arg_ty, param_ty);
            if (compat == TypeCompatibility::Incompatible) {
                // Pointer-vs-reference spelling and reference mutability
                // are not category mismatches: codegen passes a raw
                // pointer for `&T`, `&mut T` and `T*` alike.
                // `check_compatibility` models `&T`->`T*` but not the
                // reverse or `&T`<->`&mut T`, so guard those here before
                // flagging.
                if (this.indirection_compatible(arg_ty, param_ty)) { continue; }
                // A Cryo enum is represented as its integer discriminant,
                // so passing one to an integer parameter (the C-ABI
                // pattern for `type enum E : i32 { ... }` used across the
                // LLVM bindings, e.g. `LLVMSetLinkage(g, LLinkage::Private)`)
                // is representation-correct - mirror the enum->bool rule.
                if (this.enum_int_compatible(arg_ty, param_ty)) { continue; }
                this.emit_type_mismatch_with_value(
                    ErrorCode::E0214_ARGUMENT_MISMATCH,
                    arg.span,
                    param_ty,
                    arg_ty,
                    format("argument %lld doesn't match the parameter's declared type",
                           i + 1),
                    SourceSpan::none(),
                    arg);
            } else if (this.checker.is_lossy_numeric_narrowing(arg_ty, param_ty)
                       && !this.int_literal_fits_target(arg, param_ty)) {
                // A representation-losing numeric conversion (integer/float
                // narrowing or float->int) would silently `trunc` the value
                // at codegen, e.g. `take_u8(300_i64)` arriving as 44.  The
                // spec (section 2.9) requires an explicit `as` cast for these.  An
                // integer literal that fits the target is exempt: it
                // materializes as a correct constant (e.g. `push_byte(91)`).
                this.emit_type_mismatch_with_value(
                    ErrorCode::E0214_ARGUMENT_MISMATCH,
                    arg.span,
                    param_ty,
                    arg_ty,
                    format("argument %lld narrows the value and would silently truncate; add an explicit `as` cast",
                           i + 1),
                    SourceSpan::none(),
                    arg);
            } else if (this.checker.is_same_width_sign_reinterpret(arg_ty, param_ty)
                       && (is_numeric_literal_expr(arg) ||
                           is_negative_numeric_literal_expr(arg))
                       && !this.int_literal_fits_target(arg, param_ty)) {
                // Same-width signedness reinterpretation (i32 <-> u32, i64 <->
                // u64) preserves bits but flips the VALUE for any top-bit-set
                // input: `take_u32(-1_i32)` silently arrives as 4294967295.
                // Assignment already rejects this (E0200 via can_assign); the
                // call-arg gate was the asymmetric hole.
                //
                // Targeted policy: flag only when the argument is a numeric
                // LITERAL whose magnitude can't be represented in the target
                // (`take_u32(-1)`) - a definite, statically-known wrong value.
                // A literal that fits is exempt (`take_u32(5)`), and runtime
                // i64<->u64 offset/length passing (pervasive and benign in
                // practice) is left to the caller.
                this.emit_type_mismatch_with_value(
                    ErrorCode::E0214_ARGUMENT_MISMATCH,
                    arg.span,
                    param_ty,
                    arg_ty,
                    format("argument %lld reinterprets the sign of a same-width integer and would silently change its value; add an explicit `as` cast",
                           i + 1),
                    SourceSpan::none(),
                    arg);
            }
        }
    }

    /// True when `arg` is an integer literal whose value fits the target
    /// integer type's bit width.  Such a literal is materialized as a
    /// correct constant by codegen (e.g. `push_byte(91)` into a `u8`), so
    /// the call-arg narrowing check must not flag it.  Oversized literals
    /// (`take_u8(300)`) and runtime-typed narrowing still fall through to
    /// the error.  Mirrors the bound logic in `resolve_integer_literal`.
    int_literal_fits_target(&this, arg: ExpressionNode*, target: TypeRef) -> boolean {
        if (!is_numeric_literal_expr(arg)) { return false; }
        const lit: LiteralNode* = arg as LiteralNode*;
        if (lit.literal_kind != LiteralKind::Integer) { return false; }
        const t: Type* = this.arena.lookup(target.id);
        if (t == null || t.kind != TypeKind::Int) { return false; }
        const it: IntType* = t as IntType*;
        const w: u64 = it.int_kind.bit_width();
        mut max_mag: u64 = 0;
        if (w == 8)       { max_mag = 255; }
        else if (w == 16) { max_mag = 65535; }
        else if (w == 32) { max_mag = 4294967295; }
        else if (w == 64) { max_mag = SEMA_U64_MAX; }
        if (max_mag == 0) { return false; }
        return !int_literal_exceeds(lit.value, max_mag);
    }

    /// True when `ty` resolves to a signed integer type.  Used to decide
    /// whether a negative numeric literal argument may adopt the parameter's
    /// type: pushing a SIGNED slot's width is the i64::MIN fix; pushing an
    /// UNSIGNED slot would silently turn `-1` into a huge value.
    is_signed_int_type(&this, ty: TypeRef) -> boolean {
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null || t.kind != TypeKind::Int) { return false; }
        return (t as IntType*).int_kind.is_signed();
    }

    /// Per-argument type checking for an instance method call
    /// (`receiver.method(args)`).  Runs after `resolve_method_overload`,
    /// which has already populated `receiver.resolved_type` and every
    /// argument's `resolved_type`.  Conservative, mirroring the
    /// free-function gate: it gathers every candidate named `member.member`
    /// with the call's arity from BOTH the receiver's inherent methods
    /// (class base chain / struct / enum) AND its trait impls (including
    /// trait impls on primitive receivers).  It type-checks only when a
    /// single distinct signature emerges (overrides with an identical
    /// signature collapse to one); a genuine overload - more than one
    /// distinct signature - is skipped, since picking the target then
    /// needs the resolver's full matching.  Each argument is checked
    /// against its non-receiver parameter via `check_args_against_params`.
    /// Emit an arity diagnostic for a method / static-method call whose name
    /// resolved but whose argument count matched no overload. `expected` is
    /// the unique non-receiver parameter count of the same-named candidates,
    /// or < 0 when they disagree (overloaded by arity) - in which case a
    /// generic "no overload takes M arguments" is reported. Mirrors
    /// `check_call_arity`'s E0215/E0216 so methods and static methods get the
    /// same arity diagnostics free functions do, instead of silently reaching
    /// codegen and failing LLVM verification (a `cryo check`-clean ICE).
    emit_method_arity_error(mut &this, call: CallExprNode*, name: SymbolStr,
                            kind: string, expected: i64, got: i64) -> void {
        const nm: string = this.intern.resolve(name);
        if (expected < 0) {
            mut d: Diagnostic = Diagnostic::error(
                ErrorCode::E0215_TOO_MANY_ARGS,
                format("no overload of %s `%s` takes %lld argument(s)",
                       kind, nm, got));
            d = d.at_with_label(call.span,
                "no matching overload for this argument count");
            this.ctx.diagnostics.emit(d);
            return;
        }
        if (got < expected) {
            mut d: Diagnostic = Diagnostic::error(
                ErrorCode::E0216_TOO_FEW_ARGS,
                format("%s `%s` takes %lld argument(s) but %lld were supplied",
                       kind, nm, expected, got));
            d = d.at_with_label(call.span,
                format("missing %lld argument%s", expected - got,
                    if (expected - got == 1) { "" } else { "s" }));
            this.ctx.diagnostics.emit(d);
            return;
        }
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0215_TOO_MANY_ARGS,
            format("%s `%s` takes %lld argument(s) but %lld were supplied",
                   kind, nm, expected, got));
        d = d.at_with_label(call.span,
            format("unexpected argument%s",
                if (got - expected == 1) { "" } else { "s" }));
        this.ctx.diagnostics.emit(d);
    }

    /// Fold a same-named candidate's parameter count into the running
    /// unique-arity tally used for arity diagnostics. `uniq` starts at -1
    /// (none seen yet) and becomes -2 once two candidates disagree on arity.
    note_arity(&this, uniq: i64, param_count: i64) -> i64 {
        if (uniq == -1)          { return param_count; }
        if (uniq != param_count) { return -2; }
        return uniq;
    }

    /// Whether the `FunctionType` behind a `MethodInfo.function_type` is
    /// variadic.  Variadic methods accept a variable argument tail, so the
    /// strict arity check must skip them (mirrors `check_call_arity`'s
    /// `if (ft.is_variadic) return;` for free functions).
    method_type_is_variadic(&this, fn_type: TypeRef) -> boolean {
        if (!fn_type.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(fn_type.id);
        if (t == null || t.kind != TypeKind::Function) { return false; }
        return (t as FunctionType*).is_variadic;
    }

    check_method_call_arg_types(mut &this, call: CallExprNode*,
                                member: MemberAccessNode*) -> void {
        const obj_type: TypeRef = member.object.resolved_type;
        if (!obj_type.is_valid()) { return; }

        // Unwrap pointer / reference / resolved-instantiation to the
        // nominal receiver, matching `resolve_method_overload`.
        mut base_t: Type* = this.arena.lookup(obj_type.id);
        mut unwrap_depth: i32 = 0;
        while (base_t != null && unwrap_depth < 5) {
            if (base_t.kind == TypeKind::Pointer) {
                const pt: PointerType* = base_t as PointerType*;
                base_t = this.arena.lookup(pt.pointee.id);
            } else if (base_t.kind == TypeKind::Reference) {
                const rt: ReferenceType* = base_t as ReferenceType*;
                base_t = this.arena.lookup(rt.referent.id);
            } else if (base_t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = base_t as InstantiatedType*;
                if (!inst.has_resolved_type()) { return; }
                base_t = this.arena.lookup(inst.resolved_type.id);
            } else {
                break;
            }
            unwrap_depth += 1;
        }
        if (base_t == null) { return; }

        const argc: i64 = call.arguments.length;
        mut found:     boolean   = false;
        mut ambiguous: boolean   = false;
        // A same-named variadic candidate accepts this call's arity (a fixed
        // prefix plus a variable tail). Mirrors the free-function path
        // (`check_call_arity`), which bails on `is_variadic`; without it a
        // variadic method was rejected as if its declared parameter count
        // were exact.
        mut variadic_ok: boolean = false;
        mut chosen:    TypeRef[] = [];
        // Arity tracking: how many same-named candidates exist (any arity),
        // and their unique non-receiver param count (-1 none, -2 conflicting).
        // Drives the arity diagnostic when no candidate matches `argc`.
        mut name_seen:     i64 = 0;
        mut uniq_arity:    i64 = -1;

        // -- Inherent methods (class base chain / struct / enum) --
        // Primitives have no inherent methods; their trait impls are
        // gathered below, so don't bail on them here.
        mut methods_ref: MethodInfo[] = [];
        mut start_cls: ClassType* = null;
        match (base_t.kind) {
            TypeKind::Class => {
                start_cls = base_t as ClassType*;
                methods_ref = start_cls.methods;
            }
            TypeKind::Struct => { methods_ref = (base_t as StructType*).methods; }
            TypeKind::Enum   => { methods_ref = (base_t as EnumType*).methods; }
            _ => { }
        }
        mut walk: ClassType* = start_cls;
        mut cur: MethodInfo[] = methods_ref;
        mut depth: i32 = 0;
        while (depth < 16) {
            for (mut mi: i64 = 0; mi < cur.length; mi++) {
                const m: MethodInfo = cur[mi];
                if (!m.name.equals(member.member)) { continue; }
                if (this.method_type_is_variadic(m.function_type)) {
                    variadic_ok = true;
                    continue;
                }
                name_seen  += 1;
                uniq_arity  = this.note_arity(uniq_arity, m.param_types.length);
                if (m.param_types.length != argc) { continue; }
                if (!found) {
                    found = true;
                    // Copy the param-type ids into our own array; moving
                    // `m.param_types` out of the slice-element copy `m` would
                    // alias the arena's array and double-free. TypeRef is Copy.
                    chosen = [];
                    for (mut ci: i64 = 0; ci < m.param_types.length; ci++) {
                        chosen.push(m.param_types[ci]);
                    }
                } else if (!this.same_param_sig(chosen.as_slice(), m.param_types.as_slice())) {
                    ambiguous = true;
                }
            }
            if (walk == null) { break; }
            if (!walk.has_base || !walk.base_class.is_valid()) { break; }
            const parent_t: Type* = this.arena.lookup(walk.base_class.id);
            if (parent_t == null || parent_t.kind != TypeKind::Class) { break; }
            walk = parent_t as ClassType*;
            cur = walk.methods;
            depth += 1;
        }

        // -- Trait-impl methods (registered off the receiver's canonical
        // name; covers `implement trait T for U`, including primitive U).
        // Same non-receiver param construction as `match_methods_on_impl_block`.
        if (!ambiguous && this.ctx.generic_registry != null) {
            mut target_name: SymbolStr = SymbolStr::empty();
            match (base_t.kind) {
                TypeKind::Class  => { target_name = (base_t as ClassType*).qualified_name; }
                TypeKind::Struct => { target_name = (base_t as StructType*).qualified_name; }
                TypeKind::Enum   => { target_name = (base_t as EnumType*).qualified_name; }
                TypeKind::Int | TypeKind::Float | TypeKind::Bool
                | TypeKind::Char | TypeKind::String | TypeKind::Unit => {
                    target_name = this.intern.intern(base_t.display_name());
                }
                _ => { }
            }
            if (target_name.is_valid()) {
                const this_amp: SymbolStr = this.intern.intern("&this");
                const this_val: SymbolStr = this.intern.intern("this");
                const traits: SymbolStr[] =
                    this.ctx.generic_registry.traits_implemented_by(target_name);
                for (mut ti: i64 = 0; ti < traits.length; ti++) {
                    if (ambiguous) { break; }
                    const block: ImplBlockNode* =
                        this.ctx.generic_registry.lookup_trait_impl(
                            traits[ti], target_name);
                    if (block == null) { continue; }
                    for (mut bmi: i64 = 0; bmi < block.methods.length; bmi++) {
                        const mn: MethodNode* = block.methods[bmi];
                        if (mn == null || mn.func == null) { continue; }
                        const fn_node: FunctionDeclNode* = mn.func;
                        if (!fn_node.name.equals(member.member)) { continue; }
                        if (fn_node.is_variadic) {
                            variadic_ok = true;
                            continue;
                        }
                        mut tparams: TypeRef[] = [];
                        for (mut pi: i64 = 0; pi < fn_node.parameters.length; pi++) {
                            const pp: VarDeclNode* = fn_node.parameters[pi];
                            if (pp == null) { continue; }
                            if (pp.name.equals(this_amp)) { continue; }
                            if (pp.name.equals(this_val)) { continue; }
                            tparams.push(pp.resolved_type);
                        }
                        name_seen  += 1;
                        uniq_arity  = this.note_arity(uniq_arity, tparams.length);
                        if (tparams.length != argc) { tparams.drop(); continue; }
                        if (!found) {
                            found = true;
                            chosen = tparams;
                        } else {
                            // `tparams` is not moved into `chosen` on this path,
                            // so drop it after the signature comparison to keep
                            // it consumed on every control-flow path (no leak,
                            // no conditional-move warning).
                            const same: boolean =
                                this.same_param_sig(chosen.as_slice(), tparams.as_slice());
                            tparams.drop();
                            if (!same) {
                                ambiguous = true;
                                break;
                            }
                        }
                    }
                }
            }
        }

        if (ambiguous) { return; }
        if (found) {
            this.check_args_against_params(call, chosen.as_slice());
            return;
        }
        // A variadic overload accepts this arity: skip the strict arity
        // diagnostic, consistent with the free-function path.
        if (variadic_ok) { return; }
        // The method name resolved but no overload has the call's arity:
        // report it here (E0215/E0216) instead of letting codegen emit a
        // call with the wrong operand count and fail LLVM verification.
        if (name_seen > 0) {
            this.emit_method_arity_error(call, member.member, "method",
                uniq_arity, argc);
        }
    }

    /// True when one side is an enum and the other an integer.  A Cryo
    /// enum lowers to its integer discriminant, so enum<->int argument
    /// passing is representation-correct (the C-ABI interop pattern), not
    /// a category mismatch - consistent with `check_compatibility`'s
    /// existing enum->bool allowance.
    enum_int_compatible(&this, a: TypeRef, b: TypeRef) -> boolean {
        const at: Type* = this.arena.lookup(a.id);
        const bt: Type* = this.arena.lookup(b.id);
        if (at == null || bt == null) { return false; }
        if (at.kind == TypeKind::Enum && bt.kind == TypeKind::Int) { return true; }
        if (at.kind == TypeKind::Int && bt.kind == TypeKind::Enum) { return true; }
        return false;
    }

    /// True when `t` resolves to a reference (`&T` / `&mut T`) type.
    is_reference_type(&this, t: TypeRef) -> boolean {
        if (!t.is_valid()) { return false; }
        const ty: Type* = this.arena.lookup(t.id);
        return ty != null && ty.kind == TypeKind::Reference;
    }

    /// True when `t` resolves to a reference OR pointer - i.e. the value is
    /// already an address and must not be auto-ref'd again.
    is_ref_or_ptr_type(&this, t: TypeRef) -> boolean {
        if (!t.is_valid()) { return false; }
        const ty: Type* = this.arena.lookup(t.id);
        if (ty == null) { return false; }
        return ty.kind == TypeKind::Reference || ty.kind == TypeKind::Pointer;
    }

    /// Mark every by-value argument that lands on a reference (`&T`)
    /// parameter with `autoref`, so codegen takes its address instead of
    /// passing the value.  `param_types` are the callee's non-receiver
    /// parameter source types, aligned 1:1 with `call.arguments` (which
    /// never include the receiver).  Arguments that are already a
    /// reference/pointer (explicit `&x`) are left untouched.  This runs for
    /// generic `&T` parameters too - value->`&T` is exactly the case the
    /// auto-ref fixes (e.g. `println(x)` where `println<T>(value: &T)`).
    flag_autoref_from_params(mut &this, call: CallExprNode*,
                             param_types: TypeRef[]) -> void {
        const lim: i64 = if (param_types.length < call.arguments.length) {
            param_types.length
        } else {
            call.arguments.length
        };
        for (mut j: i64 = 0; j < lim; j++) {
            if (!this.is_reference_type(param_types[j])) { continue; }
            const arg: ExpressionNode* = call.arguments[j];
            if (arg == null) { continue; }
            if (this.is_ref_or_ptr_type(arg.resolved_type)) { continue; }
            arg.autoref = true;
        }
    }

    /// Structural equality of two parameter-type lists by length and
    /// arena TypeRef id.  Used to collapse a base method and its identical
    /// override into a single candidate signature.
    same_param_sig(&this, a: Slice<TypeRef>, b: Slice<TypeRef>) -> boolean {
        if (a.length != b.length) { return false; }
        for (mut i: i64 = 0; i < a.length as i64; i++) {
            if (a.get(i as u64).unwrap().id != b.get(i as u64).unwrap().id) { return false; }
        }
        return true;
    }

    /// Per-argument type checking for a `Type::method(args)` /
    /// `Module::func(args)` scope-resolution call.  Called only after
    /// `resolve_scope_call` resolved the callee, so an undefined symbol
    /// has already reported its own error and won't be double-flagged.
    /// Conservative: looks the combined `scope::member` symbol up in the
    /// declaration index and checks only when exactly ONE function-typed
    /// overload is registered (a unique static method or module function).
    /// Enum-variant constructors (not function-typed under this key),
    /// overloaded statics, and generic templates are skipped.
    check_scope_call_arg_types(mut &this, scope: ScopeResolutionNode*,
                               call: CallExprNode*) -> void {
        if (this.ctx.decl_index == null) { return; }

        // Mirror `resolve_scope_call`'s lookup symbol (specialize generic
        // scope args), then skip anything generic - the monomorphizer
        // re-checks specialized instances once every `T` is concrete.
        mut lookup_sym: SymbolStr = scope.scope_name;
        if (scope.scope_generic_args.length > 0) {
            const spec_sym: SymbolStr = this.resolve_generic_scope_name(
                scope.scope_name, scope.scope_generic_args);
            if (spec_sym.is_valid()) { lookup_sym = spec_sym; }
        }
        if (this.scope_is_generic_template(lookup_sym, scope.member_name)) { return; }

        const scope_str:  string = this.intern.resolve(lookup_sym);
        const member_str: string = this.intern.resolve(scope.member_name);
        if (strlen(scope_str) == 0 || strlen(member_str) == 0) { return; }
        const combined: SymbolStr = this.intern.intern(
            format("%s::%s", scope_str, member_str));

        const overloads: TypeRef[] =
            this.ctx.decl_index.lookup_func_type_overloads(combined);
        if (overloads.length == 1) {
            const ot: Type* = this.arena.lookup(overloads[0].id);
            if (ot != null && ot.kind == TypeKind::Function) {
                const ft: FunctionType* = ot as FunctionType*;
                if (!ft.is_variadic) {
                    if (ft.param_types.length == call.arguments.length) {
                        this.check_args_against_params(call, ft.param_types.as_slice());
                    } else {
                        // Wrong arity for the single resolved overload: report
                        // it instead of letting codegen build a mis-arity call
                        // and fail LLVM verification.
                        this.emit_method_arity_error(call, scope.member_name,
                            "function", ft.param_types.length,
                            call.arguments.length);
                    }
                }
            }
            return;
        }

        // The callee isn't a function-typed entry (the common case for an
        // inherent static method, which is registered as MethodInfo on its
        // owning type). Fall back to checking against that signature.
        this.check_static_scope_method_args(lookup_sym, scope, call);
    }

    /// Argument type-check for a `Type::method(args)` static call whose
    /// callee is an inherent static method registered as `MethodInfo` on
    /// the type (not in the function-type overload table). Mirrors the
    /// inherent-method gather in `check_method_call_arg_types`: type-check
    /// only when a single static signature of the call's arity is found,
    /// so genuine overloads stay deferred to the resolver.
    check_static_scope_method_args(mut &this, lookup_sym: SymbolStr,
                                   scope: ScopeResolutionNode*,
                                   call: CallExprNode*) -> void {
        mut type_ref: TypeRef = this.lookup_type_by_sym(lookup_sym);
        if (!type_ref.is_valid() && !lookup_sym.equals(scope.scope_name)) {
            type_ref = this.lookup_type_by_sym(scope.scope_name);
        }
        if (!type_ref.is_valid()) { return; }

        mut t: Type* = this.arena.lookup(type_ref.id);
        if (t != null && t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (!inst.has_resolved_type()) { return; }
            t = this.arena.lookup(inst.resolved_type.id);
        }
        if (t == null) { return; }

        mut methods: MethodInfo[] = [];
        match (t.kind) {
            TypeKind::Struct => { methods = (t as StructType*).methods; }
            TypeKind::Class  => { methods = (t as ClassType*).methods; }
            TypeKind::Enum   => { methods = (t as EnumType*).methods; }
            _ => { return; }
        }

        const argc: i64 = call.arguments.length;
        mut found:     boolean   = false;
        mut ambiguous: boolean   = false;
        // See `check_method_call_arg_types`: a variadic static overload
        // accepts a variable argument tail and must skip the strict arity
        // check, mirroring the free-function path.
        mut variadic_ok: boolean = false;
        mut chosen:    TypeRef[] = [];
        mut name_seen:  i64 = 0;
        mut uniq_arity: i64 = -1;
        for (mut mi: i64 = 0; mi < methods.length; mi++) {
            const m: MethodInfo = methods[mi];
            if (!m.is_static) { continue; }
            if (!m.name.equals(scope.member_name)) { continue; }
            if (this.method_type_is_variadic(m.function_type)) {
                variadic_ok = true;
                continue;
            }
            name_seen  += 1;
            uniq_arity  = this.note_arity(uniq_arity, m.param_types.length);
            if (m.param_types.length != argc) { continue; }
            if (!found) {
                found = true;
                // Copy the param-type ids (TypeRef is Copy); moving
                // `m.param_types` out of the slice-element copy `m` would alias
                // the arena's array and double-free at scope exit.
                chosen = [];
                for (mut ci: i64 = 0; ci < m.param_types.length; ci++) {
                    chosen.push(m.param_types[ci]);
                }
            } else if (!this.same_param_sig(chosen.as_slice(), m.param_types.as_slice())) {
                ambiguous = true;
            }
        }
        if (ambiguous) { return; }
        if (found) {
            this.check_args_against_params(call, chosen.as_slice());
            return;
        }
        if (variadic_ok) { return; }
        // Static method name resolved but no overload has the call's arity.
        if (name_seen > 0) {
            this.emit_method_arity_error(call, scope.member_name,
                "static method", uniq_arity, argc);
        }
    }

    /// One level of pointer/reference indirection peeled off `t`, or an
    /// invalid TypeRef when `t` is neither a pointer nor a reference.
    peel_indirection(&this, t: TypeRef) -> TypeRef {
        const ty: Type* = this.arena.lookup(t.id);
        if (ty == null) { return TypeRef::invalid(); }
        if (ty.kind == TypeKind::Pointer) {
            const pt: PointerType* = ty as PointerType*;
            return pt.pointee;
        }
        if (ty.kind == TypeKind::Reference) {
            const rt: ReferenceType* = ty as ReferenceType*;
            return rt.referent;
        }
        return TypeRef::invalid();
    }

    /// True when `arg` and `param` describe the same underlying type up
    /// to one level of pointer/reference spelling - covering `&T`<->`&mut T`,
    /// `&T`<->`T*`, and value<->`&T`/`T*` (call-site auto-ref, e.g. passing a
    /// `&this` receiver - which resolves to the value type - to a
    /// `&T` parameter).  Codegen lowers all of these to a raw pointer, so
    /// `check_call_arg_types` must not treat them as a category mismatch.
    ///
    /// At least one side must actually be an indirection (otherwise this
    /// is a plain value<->value comparison that was already judged
    /// `Incompatible`, e.g. `string` -> `i32`, and must stay flagged).  The
    /// underlying types must themselves be non-`Incompatible`, so
    /// `string` -> `&i32` and `i32*` -> `&String` are still rejected.
    indirection_compatible(&this, arg_ty: TypeRef, param_ty: TypeRef) -> boolean {
        const a_peeled: TypeRef = this.peel_indirection(arg_ty);
        const p_peeled: TypeRef = this.peel_indirection(param_ty);
        if (!a_peeled.is_valid() && !p_peeled.is_valid()) { return false; }
        const a_in: TypeRef = if (a_peeled.is_valid()) { a_peeled } else { arg_ty };
        const p_in: TypeRef = if (p_peeled.is_valid()) { p_peeled } else { param_ty };
        if (a_in.equals(p_in)) { return true; }
        // Derived -> Base upcast through the indirection (e.g. a value
        // `Derived` receiver forwarded to a `Base*`/`&Base` parameter, as
        // the visitor pattern does throughout the compiler).
        // `check_compatibility` only models this for `Derived*`->`Base*`,
        // not for the peeled value types, so check it explicitly.
        if (this.checker.is_subclass_of(a_in, p_in)) { return true; }
        const c: TypeCompatibility = this.checker.check_compatibility(a_in, p_in);
        return c != TypeCompatibility::Incompatible;
    }

    /// Whether `t` is concrete enough for `check_call_arg_types` to judge.
    /// False for generic params, bounded params, function templates,
    /// function (pointer) types, and instantiations not yet resolved to a
    /// concrete type - all opaque before monomorphization.  Recurses
    /// through the structural type constructors (pointer / reference /
    /// array / optional / tuple) so a generic buried inside `&T` or
    /// `(T, i32)` is skipped too.  Nominal types (struct / class / enum /
    /// primitives) are concrete leaves.
    arg_type_is_concrete(&this, t: TypeRef) -> boolean {
        if (!t.is_valid()) { return false; }
        const ty: Type* = this.arena.lookup(t.id);
        if (ty == null) { return false; }
        if (ty.kind == TypeKind::GenericParam)     { return false; }
        if (ty.kind == TypeKind::BoundedParam)     { return false; }
        if (ty.kind == TypeKind::FunctionTemplate) { return false; }
        if (ty.kind == TypeKind::Function)         { return false; }
        // Unit `()` is zero-sized and `void`/`void*` is C's universal
        // pointer; both are interchangeable with several representations
        // (the unit literal even resolves to `void*`), so they are never
        // a meaningful category mismatch.  Skip rather than risk a false
        // positive (e.g. `HashSet` = `HashMap<T, ()>` passing `()`).
        if (ty.kind == TypeKind::Unit)             { return false; }
        if (ty.kind == TypeKind::Void)             { return false; }
        if (ty.kind == TypeKind::Pointer) {
            const pt: PointerType* = ty as PointerType*;
            return this.arg_type_is_concrete(pt.pointee);
        }
        if (ty.kind == TypeKind::Reference) {
            const rt: ReferenceType* = ty as ReferenceType*;
            return this.arg_type_is_concrete(rt.referent);
        }
        if (ty.kind == TypeKind::Array) {
            const at: ArrayType* = ty as ArrayType*;
            return this.arg_type_is_concrete(at.element);
        }
        if (ty.kind == TypeKind::Optional) {
            const ot: OptionalType* = ty as OptionalType*;
            return this.arg_type_is_concrete(ot.wrapped);
        }
        if (ty.kind == TypeKind::Tuple) {
            const tt: TupleType* = ty as TupleType*;
            for (mut i: i64 = 0; i < tt.elements.length; i++) {
                if (!this.arg_type_is_concrete(tt.elements[i])) { return false; }
            }
            return true;
        }
        if (ty.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = ty as InstantiatedType*;
            if (!inst.has_resolved_type()) { return false; }
        }
        return true;
    }

    /// Free-function overload resolution.  Walks the overloads registered
    /// for `ident.name` (qualified first, then bare), finds one whose
    /// param types match the call's arg types by arena TypeRef ID, and
    /// pins the overload-specific mangled name as `call.resolved_callee`
    /// so codegen can look up the exact LLVM function instead of
    /// resolving by bare/qualified name (which is last-write-wins for
    /// overloads).  Silently no-ops on no-match; `resolve_direct_call`
    /// + the codegen fallback chain still produces a working call for
    /// non-overloaded functions.
    try_pin_overload_mangled_callee(mut &this, call: CallExprNode*,
                                    ident: IdentifierNode*) -> void {
        if (call.resolved_callee.is_valid()) { return; }

        // Gather arg types.  Bail if any arg failed to resolve; we'd
        // otherwise mismatch on TypeRef::invalid().
        mut arg_types: TypeRef[] = [];
        for (mut ai: i64 = 0; ai < call.arguments.length; ai++) {
            const arg: ExpressionNode* = call.arguments[ai];
            if (arg == null || !arg.resolved_type.is_valid()) { return; }
            arg_types.push(arg.resolved_type);
        }

        const di: DeclarationIndex* = this.ctx.decl_index;

        // Try qualified name first (current module), then bare.
        const qualified: SymbolStr = this.ctx.qualify_symbol_sym(ident.name);
        mut overloads: TypeRef[] = di.lookup_func_type_overloads(qualified);
        mut lookup_key: SymbolStr = qualified;
        if (overloads.length == 0) {
            overloads = di.lookup_func_type_overloads(ident.name);
            lookup_key = ident.name;
        }
        if (overloads.length == 0) { return; }
        if (overloads.length == 1) {
            // Unique-name function: pin the canonical mangled symbol
            // registered by declare_function so codegen can dispatch
            // through `resolve_function_by_mangled` instead of replaying
            // the qualified/bare/DI-mapping cascade.  Prefer the
            // overload-specific mangled name (matches the LLVM symbol);
            // fall back to the legacy single-slot mangled_names entry.
            mut unique_mangled: SymbolStr = di.lookup_overload_mangled(
                lookup_key, overloads[0]);
            if (!unique_mangled.is_valid()) {
                unique_mangled = di.lookup_mangled_name(lookup_key);
            }
            if (unique_mangled.is_valid()) {
                call.set_resolved_callee(unique_mangled);
            }
            return;
        }

        // Find the overload whose declared param types match arg types.
        // Match rules: exact arena ID match, or implicit Reference->Pointer
        // coercion (`&local` produces a Reference, but `f(p: T*)` declares
        // a Pointer; codegen passes a raw `ptr` either way).  Equivalence
        // by pointee/referent TypeRef.id.
        for (mut oi: i64 = 0; oi < overloads.length; oi++) {
            const ot: Type* = this.arena.lookup(overloads[oi].id);
            if (ot == null || ot.kind != TypeKind::Function) { continue; }
            const fn_ty: FunctionType* = ot as FunctionType*;
            // Variadic functions (e.g. `printf(fmt, ...)`) match any arg
            // count >= their fixed prefix; only the fixed params are
            // type-checked below.  Without this, a variadic call with extra
            // args fails to pin whenever the name has >1 overload (e.g.
            // `printf` declared in both `core::intrinsics` and `ffi::libc`),
            // and codegen then can't resolve the callee.
            if (fn_ty.is_variadic) {
                if (arg_types.length < fn_ty.param_types.length) { continue; }
            } else if (fn_ty.param_types.length != arg_types.length) {
                continue;
            }
            mut all_match: boolean = true;
            for (mut pi: i64 = 0; pi < fn_ty.param_types.length; pi++) {
                if (!this.overload_param_matches_arg(fn_ty.param_types[pi], arg_types[pi])) {
                    all_match = false;
                    break;
                }
            }
            if (!all_match) { continue; }
            const mangled: SymbolStr = di.lookup_overload_mangled(lookup_key, overloads[oi]);
            if (mangled.is_valid()) {
                call.set_resolved_callee(mangled);
                return;
            }
        }
    }

    /// Compatibility predicate for overload-resolution param <-> arg matching.
    /// Exact arena-ID match wins; otherwise allows pointer/reference coercion
    /// when both sides point/refer to the same pointee/referent type.
    overload_param_matches_arg(&this, param: TypeRef, arg: TypeRef) -> boolean {
        if (param.id == arg.id) { return true; }
        const pt: Type* = this.arena.lookup(param.id);
        const at: Type* = this.arena.lookup(arg.id);
        if (pt == null || at == null) { return false; }
        // &T -> T*  (reference passed where pointer expected; codegen
        // passes a raw `ptr` for both).
        if (pt.kind == TypeKind::Pointer && at.kind == TypeKind::Reference) {
            const pp: PointerType* = pt as PointerType*;
            const ar: ReferenceType* = at as ReferenceType*;
            return pp.pointee.id == ar.referent.id;
        }
        // T* -> &T  (the symmetric case, less common but mirror it).
        if (pt.kind == TypeKind::Reference && at.kind == TypeKind::Pointer) {
            const pr: ReferenceType* = pt as ReferenceType*;
            const ap: PointerType* = at as PointerType*;
            return pr.referent.id == ap.pointee.id;
        }
        return false;
    }

    resolve_direct_call(mut &this, ident: IdentifierNode*) -> TypeRef {
        // A local binding (parameter or variable) of function-pointer type
        // shadows any global function of the same name, per lexical scoping.
        // This must be checked BEFORE the global function table: otherwise a
        // call like `f()` inside `Option::or_else(f: () -> Option<T>)` binds
        // to a user's top-level `function f` (a hard E0200 when the return
        // types differ), and more generally any function-pointer parameter
        // that collides with a global function name silently calls the wrong
        // function. `resolve_identifier` already resolves locals before
        // globals; this aligns the direct-call path with that precedence.
        const fp_local: TypeRef = this.lookup_local(ident.name);
        if (fp_local.is_valid()) {
            const fp_t: Type* = this.arena.lookup(fp_local.id);
            if (fp_t != null && fp_t.kind == TypeKind::Function) {
                const fp_fn: FunctionType* = fp_t as FunctionType*;
                // Set the identifier's resolved_type to the FunctionType so
                // codegen can build the correct LLVM call through the pointer.
                ident.set_resolved_type(fp_local);
                return fp_fn.return_type;
            }
        }

        const func_ret: TypeRef = this.lookup_func_return(ident.name);
        if (func_ret.is_valid()) {
            // If the return type is an unresolved generic (e.g., Result<T, E>
            // from a generic function like ok<T, E>) and we have an expected
            // type from the call context (e.g., return type Result<bool, string>),
            // use the expected type instead.  This handles return-type inference
            // for generic functions where not all type params are inferrable
            // from arguments alone.
            if (this.expected_type.is_valid()) {
                const ret_t: Type* = this.arena.lookup(func_ret.id);
                if (ret_t != null) {
                    // FunctionTemplate: the function itself is generic, use expected type
                    if (ret_t.kind == TypeKind::FunctionTemplate) {
                        return this.expected_type;
                    }
                    // InstantiatedType with unresolved generic params
                    if (ret_t.kind == TypeKind::InstantiatedType) {
                        const inst: InstantiatedType* = ret_t as InstantiatedType*;
                        if (!inst.has_resolved_type()) {
                            return this.expected_type;
                        }
                    }
                }
            }
            return func_ret;
        }

        // Constructor call (e.g., Dog("Buddy"))
        const type_ref: TypeRef = this.lookup_type_by_sym(ident.name);
        if (type_ref.is_valid()) { return type_ref; }

        const name: string = this.intern.resolve(ident.name);
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0202_UNDEFINED_FUNCTION,
            format("cannot find function `%s` in this scope", name));
        diag = diag.at_with_label(ident.span, "not found in this scope");
        const cands: string[] = this.collect_bare_callable_names();
        diag = this.attach_did_you_mean(diag, name, cands,
                                        "function", ident.span);
        this.ctx.emit_diagnostic(diag);
        return TypeRef::invalid();
    }

    /// Tag the call with the specific method declaration chosen by
    /// overload resolution.  Walks the receiver class's base chain
    /// (leaf -> root) looking for a method named `member.member` whose
    /// declared parameter types match the call's argument types by
    /// arena TypeRef ID (arena dedup makes this a real semantic equality
    /// check, not a string compare).  First exact match wins; derived
    /// overloads shadow base overloads with the same signature
    /// (Cryo's name-hiding rule).  Leaves `call.resolved_method`
    /// Compute the mangled LLVM callee symbol for a resolved method and
    /// pin it as `call.resolved_callee`, so codegen can dispatch the
    /// call by looking up `resolved_callee` directly instead of
    /// re-running the receiver-kind / non-receiver-params dance and the
    /// owner-qualified-name lookup.  The mangling here matches
    /// `declare_method`'s registration in `decl_index.cryo`, so the
    /// lookup is guaranteed to find the registered LLVM function.
    ///
    /// `owner_t` is the class/struct that actually OWNS the matched
    /// method; for an inherited match, this is the ancestor where the
    /// method is declared, not the static receiver type.
    pin_method_resolved_callee(mut &this, call: CallExprNode*,
                                owner_t: Type*, m: MethodInfo) -> void {
        if (owner_t == null) { return; }
        if (m.ast_node == null) { return; }
        mut owner_str: string = "";
        if (owner_t.kind == TypeKind::Class) {
            owner_str = this.intern.resolve((owner_t as ClassType*).qualified_name);
        } else if (owner_t.kind == TypeKind::Struct) {
            owner_str = this.intern.resolve((owner_t as StructType*).qualified_name);
        } else if (owner_t.kind == TypeKind::Enum) {
            owner_str = this.intern.resolve((owner_t as EnumType*).qualified_name);
        } else {
            return;
        }
        this.pin_method_callee_from_qname(
            call, owner_str, m.ast_node as MethodNode*, m.is_static);
    }

    /// Pin `resolved_callee` for a method given its owner's qualified-name
    /// string directly. Used by the trait-impl resolution path, where the
    /// owner name comes from `register_methods_with_module`'s registration
    /// key (canonical target qname for user types, bare display name for
    /// primitives) rather than from a typed `Type*` with a `qualified_name`
    /// field.  Mangling matches `register_methods_with_module_aliased` so
    /// the produced symbol is exactly the one declare_method emitted.
    pin_method_callee_from_qname(mut &this, call: CallExprNode*,
                                  owner_qname_str: string,
                                  mn: MethodNode*, is_static: boolean) -> void {
        if (mn == null || mn.func == null) { return; }
        if (strlen(owner_qname_str) == 0) { return; }
        const fn_node: FunctionDeclNode* = mn.func;
        const type_qn: QualifiedName = QualifiedName::single(
            this.intern, owner_qname_str);
        const recv_kind: ReceiverKind = method_receiver_kind(
            fn_node, is_static, this.intern);
        const param_refs: TypeRef[] = method_non_receiver_params(
            fn_node, this.intern);
        const mangled: MangledName = MangledName::for_method_or_trait_impl(
            this.intern, this.arena, type_qn, fn_node.origin_trait, fn_node.name, recv_kind,
            param_refs, fn_node.resolved_return_type, fn_node.is_variadic);
        call.set_resolved_callee(mangled.value);
    }

    /// null on ambiguity or no-match so codegen can fall back cleanly.
    resolve_method_overload(mut &this, call: CallExprNode*, member: MemberAccessNode*) -> void {
        const obj_type: TypeRef = this.resolve_expr(member.object);
        if (!obj_type.is_valid()) { return; }

        // Unwrap Pointer / Reference / InstantiatedType to the concrete
        // class so we can walk its method table.  `resolve_expr` has
        // already populated every arg's `resolved_type` by the time we
        // enter this function (resolve_call evaluates args first).
        mut base_t: Type* = this.arena.lookup(obj_type.id);
        mut unwrap_depth: i32 = 0;
        while (base_t != null && unwrap_depth < 5) {
            if (base_t.kind == TypeKind::Pointer) {
                const pt: PointerType* = base_t as PointerType*;
                base_t = this.arena.lookup(pt.pointee.id);
            } else if (base_t.kind == TypeKind::Reference) {
                const rt: ReferenceType* = base_t as ReferenceType*;
                base_t = this.arena.lookup(rt.referent.id);
            } else if (base_t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = base_t as InstantiatedType*;
                if (!inst.has_resolved_type()) { break; }
                base_t = this.arena.lookup(inst.resolved_type.id);
            } else {
                break;
            }
            unwrap_depth += 1;
        }
        // Accept both classes (with inheritance) and structs (flat).
        // Structs don't have vtables or a base chain, but they DO have
        // overloaded methods (`String::push(string)` vs `String::push(String)`)
        // and codegen needs `resolved_method` to pick the right mangled
        // name at the call site.  Primitives (Int/Float/Bool/Char/String/
        // Unit) have no inherent methods table but may have trait-impl
        // methods registered via `implement trait Eq for i16 { ... }`;
        // we leave methods_ref empty for those and the trait-impl walk at
        // the bottom of this function picks them up.  Non-matching kinds
        // (Pointer, Reference, etc. shouldn't reach here after the unwrap
        // loop) bail.
        // `methods_ref` / `cur_methods` are non-owning VIEWS into method
        // arrays the arena owns; modelling them as `Slice<MethodInfo>`
        // (a Copy `(ptr,len)` pair) makes that explicit, so re-reading the
        // start view for pass 2 is a borrow, not a use-after-move, and the
        // views are never dropped (they alias arena storage).
        mut methods_ref: Slice<MethodInfo> = Slice<MethodInfo>::from_raw(null, 0);
        mut start_cls: ClassType* = null;
        match (base_t.kind) {
            TypeKind::Class => {
                start_cls = base_t as ClassType*;
                methods_ref = start_cls.methods.as_slice();
            }
            TypeKind::Struct => {
                const sst: StructType* = base_t as StructType*;
                methods_ref = sst.methods.as_slice();
            }
            TypeKind::Enum => {
                const est: EnumType* = base_t as EnumType*;
                methods_ref = est.methods.as_slice();
            }
            TypeKind::Int | TypeKind::Float | TypeKind::Bool
            | TypeKind::Char | TypeKind::String | TypeKind::Unit => {
                // Primitive receiver: no inherent methods, but the trait-impl
                // walk below may resolve.  methods_ref stays empty so the
                // inherent passes loop zero times.
            }
            _ => { return; }
        }

        // Gather the call's arg TypeRefs.
        mut arg_types: TypeRef[] = [];
        for (mut ai: i64 = 0; ai < call.arguments.length; ai++) {
            const arg_expr: ExpressionNode* = call.arguments[ai];
            if (arg_expr == null) { return; }
            if (!arg_expr.resolved_type.is_valid()) { return; }
            arg_types.push(arg_expr.resolved_type);
        }

        // Two-pass overload resolution over the leaf->root chain.  Pass 1
        // picks exact arena-ID matches (the fast, unambiguous case, e.g.,
        // `visit(LiteralNode*)` called with a `LiteralNode*` arg).  Pass 2
        // accepts implicit-convert matches (e.g., derived-to-base pointer
        // upcasts), which is what handles `node.accept(visitor)` where
        // `visitor` is a concrete subclass passed as the base visitor
        // parameter.  Exact matches win over conversions; if pass 1
        // finds a match we never run pass 2.
        // For structs, walk is null and the loop runs once against
        // `methods_ref`.  For classes, walk inherits through base_class.
        //
        // `owner_t` tracks the type that actually OWNS the methods in
        // `cur_methods`; for an inherited match we need the ancestor's
        // qualified name to mangle the callee correctly, not the static
        // receiver type's.
        mut walk: ClassType* = start_cls;
        mut depth: i32 = 0;
        mut cur_methods: Slice<MethodInfo> = methods_ref;
        mut owner_t: Type* = base_t;
        while (depth < 16) {
            for (mut mi: u64 = 0; mi < cur_methods.length; mi++) {
                const m: MethodInfo = *(cur_methods.get_ptr(mi).unwrap());
                if (!m.name.equals(member.member)) { continue; }
                if (m.param_types.length != arg_types.length) { continue; }
                mut exact: boolean = true;
                for (mut pi: i64 = 0; pi < m.param_types.length; pi++) {
                    if (m.param_types[pi].id != arg_types[pi].id) {
                        exact = false;
                        break;
                    }
                }
                if (exact) {
                    call.set_resolved_method(m.ast_node as ASTNode*);
                    this.pin_method_resolved_callee(call, owner_t, m);
                    return;
                }
            }
            if (walk == null) { break; }
            if (!walk.has_base || !walk.base_class.is_valid()) { break; }
            const parent_t: Type* = this.arena.lookup(walk.base_class.id);
            if (parent_t == null || parent_t.kind != TypeKind::Class) { break; }
            walk = parent_t as ClassType*;
            cur_methods = walk.methods.as_slice();
            owner_t = parent_t;
            depth += 1;
        }

        // Pass 2: implicit-convert + take-address fallback.  Cryo's
        // `&this` reference semantics let value-typed self expressions
        // be passed to pointer-typed parameters (implicit address-of),
        // matching the way the stdlib/compiler is written: inside a
        // `&this` method, `this` has the bare class type, but method
        // call sites like `visitor.visit(this)` forward it to params
        // declared as `T*`.  We accept both `can_implicit_convert` (for
        // pointer-to-pointer hierarchy upcasts, int widening, etc.)
        // and a narrow take-address match (arg `T` -> param `Pointer<T>`
        // or `Reference<T>`).
        //
        // CRITICAL: this pass runs in two sub-passes.  Pass 2a accepts
        // EXACT pointee matches only; pass 2b also accepts subclass
        // upcasts.  Without this split, `visitor.visit(this)` where
        // `this: EnumDeclNode` would resolve to `visit(DeclarationNode*)`
        // (a subclass match found earlier in declaration order) instead
        // of `visit(EnumDeclNode*)` (the exact-pointee match).  Overload
        // resolution prefers the most-specific match; the two-pass
        // split implements that by trying exact first.
        for (mut sub_pass: i32 = 0; sub_pass < 2; sub_pass++) {
            const allow_subclass: boolean = (sub_pass == 1);
            walk = start_cls;
            depth = 0;
            cur_methods = methods_ref;
            owner_t = base_t;
            while (depth < 16) {
                for (mut mi: u64 = 0; mi < cur_methods.length; mi++) {
                    const m: MethodInfo = *(cur_methods.get_ptr(mi).unwrap());
                    if (!m.name.equals(member.member)) { continue; }
                    if (m.param_types.length != arg_types.length) { continue; }
                    mut compat: boolean = true;
                    for (mut pi: i64 = 0; pi < m.param_types.length; pi++) {
                        // Gate `can_implicit_convert` to skip pointer-subclass
                        // upcasts in sub_pass=0.  `check_compatibility` treats
                        // `Derived* -> Base*` as ImplicitConvert, which would
                        // pick `visit(Base*)` for a `Derived*` arg whenever
                        // Base's overload is declared earlier, defeating the
                        // most-specific-wins comment above.  Subclass matches
                        // are deferred to sub_pass=1 (allow_subclass=true).
                        mut allow_implicit: boolean = true;
                        if (!allow_subclass) {
                            const at: Type* = this.arena.lookup(arg_types[pi].id);
                            const ppt: Type* = this.arena.lookup(m.param_types[pi].id);
                            if (at != null && ppt != null
                                    && at.kind == TypeKind::Pointer
                                    && ppt.kind == TypeKind::Pointer) {
                                const arg_ptr: PointerType* = at as PointerType*;
                                const param_ptr2: PointerType* = ppt as PointerType*;
                                if (arg_ptr.pointee.id != param_ptr2.pointee.id) {
                                    allow_implicit = false;
                                }
                            }
                        }
                        if (allow_implicit && this.checker.can_implicit_convert(
                            arg_types[pi], m.param_types[pi])) {
                            continue;
                        }
                        const pt: Type* = this.arena.lookup(m.param_types[pi].id);
                        if (pt != null) {
                            mut pointee: TypeRef = TypeRef::invalid();
                            if (pt.kind == TypeKind::Pointer) {
                                const ptr: PointerType* = pt as PointerType*;
                                pointee = ptr.pointee;
                            } else if (pt.kind == TypeKind::Reference) {
                                const rt: ReferenceType* = pt as ReferenceType*;
                                pointee = rt.referent;
                            }
                            if (pointee.is_valid() && pointee.id == arg_types[pi].id) {
                                continue;
                            }
                            // Also accept when arg itself is Pointer/Reference
                            // wrapping the same pointee, e.g. `&local` (Reference)
                            // passed to a `T*` (Pointer) param.  Codegen passes
                            // a raw `ptr` for both kinds, so the arg/param
                            // wrapper-kind difference doesn't change the LLVM
                            // signature.
                            const at: Type* = this.arena.lookup(arg_types[pi].id);
                            if (at != null && pointee.is_valid()) {
                                mut arg_pointee: TypeRef = TypeRef::invalid();
                                if (at.kind == TypeKind::Pointer) {
                                    const apt: PointerType* = at as PointerType*;
                                    arg_pointee = apt.pointee;
                                } else if (at.kind == TypeKind::Reference) {
                                    const art: ReferenceType* = at as ReferenceType*;
                                    arg_pointee = art.referent;
                                }
                                if (arg_pointee.is_valid() && arg_pointee.id == pointee.id) {
                                    continue;
                                }
                                if (allow_subclass && arg_pointee.is_valid() &&
                                    this.checker.is_subclass_of(arg_pointee, pointee)) {
                                    continue;
                                }
                            }
                            if (allow_subclass && pointee.is_valid() &&
                                this.checker.is_subclass_of(arg_types[pi], pointee)) {
                                continue;
                            }
                        }
                        compat = false;
                        break;
                    }
                    if (compat) {
                        call.set_resolved_method(m.ast_node as ASTNode*);
                        this.pin_method_resolved_callee(call, owner_t, m);
                        return;
                    }
                }
                if (walk == null) { break; }
                if (!walk.has_base || !walk.base_class.is_valid()) { break; }
                const parent_t: Type* = this.arena.lookup(walk.base_class.id);
                if (parent_t == null || parent_t.kind != TypeKind::Class) { break; }
                walk = parent_t as ClassType*;
                cur_methods = walk.methods.as_slice();
                owner_t = parent_t;
                depth += 1;
            }
        }
        // Trait-impl walk: methods registered via `implement trait T for U`
        // live in the trait-impl registry rather than on the receiver's
        // inherent `methods[]` array, so neither Pass 1 nor Pass 2 above
        // can see them.  This handles primitive trait impls (e.g.
        // `Eq for i16`) and trait impls on user types (e.g. `FmtWrite for
        // String`).  Mangling matches `register_methods_with_module`'s
        // registration so the pinned symbol resolves at LLVM lookup time.
        this.try_match_trait_impl_method(call, member, base_t, arg_types);
    }

    /// Walk the trait-impl registry for `base_t` and pin a matching trait
    /// method's mangled callee on `call`.  Used as the final fallback in
    /// `resolve_method_overload` for cases the inherent-method walk
    /// doesn't cover.
    try_match_trait_impl_method(mut &this, call: CallExprNode*,
                                 member: MemberAccessNode*,
                                 base_t: Type*,
                                 arg_types: TypeRef[]) -> void {
        if (call.resolved_callee.is_valid()) { return; }
        if (this.ctx.generic_registry == null) { return; }
        if (base_t == null) { return; }

        // Compute the target name in the same form
        // `register_methods_with_module` keys on:
        //   - Class/Struct/Enum -> canonical qualified_name
        //   - Primitives        -> bare display name interned
        // The mangle uses this name verbatim as the type qname, so any
        // mismatch produces a different LLVM symbol than declare_method
        // emitted.
        mut target_name: SymbolStr = SymbolStr::empty();
        mut target_str:  string    = "";
        match (base_t.kind) {
            TypeKind::Class => {
                target_name = (base_t as ClassType*).qualified_name;
            }
            TypeKind::Struct => {
                target_name = (base_t as StructType*).qualified_name;
            }
            TypeKind::Enum => {
                target_name = (base_t as EnumType*).qualified_name;
            }
            TypeKind::Int | TypeKind::Float | TypeKind::Bool
            | TypeKind::Char | TypeKind::String | TypeKind::Unit => {
                target_str  = base_t.display_name();
                target_name = this.intern.intern(target_str);
            }
            _ => { return; }
        }
        if (!target_name.is_valid()) { return; }
        if (strlen(target_str) == 0) {
            target_str = this.intern.resolve(target_name);
        }
        if (strlen(target_str) == 0) { return; }

        const traits: SymbolStr[] =
            this.ctx.generic_registry.traits_implemented_by(target_name);
        for (mut ti: i64 = 0; ti < traits.length; ti++) {
            const block: ImplBlockNode* =
                this.ctx.generic_registry.lookup_trait_impl(
                    traits[ti], target_name);
            if (block == null) { continue; }
            if (this.match_methods_on_impl_block(
                    call, member, block, target_str, arg_types)) {
                return;
            }
        }
    }

    /// Two-pass match over an impl block's methods.  Pass 1 is exact
    /// arena-id match; Pass 2 accepts `can_implicit_convert` widenings
    /// (e.g. `&local` -> `T*` reference/pointer coercion, int widenings).
    /// Returns true and pins `resolved_method` + `resolved_callee` on the
    /// first match; otherwise returns false.
    match_methods_on_impl_block(mut &this, call: CallExprNode*,
                                 member: MemberAccessNode*,
                                 block: ImplBlockNode*,
                                 owner_str: string,
                                 arg_types: TypeRef[]) -> boolean {
        if (block == null) { return false; }
        const this_amp: SymbolStr = this.intern.intern("&this");
        const this_val: SymbolStr = this.intern.intern("this");

        for (mut sub_pass: i32 = 0; sub_pass < 2; sub_pass++) {
            const allow_implicit: boolean = (sub_pass == 1);
            for (mut mi: i64 = 0; mi < block.methods.length; mi++) {
                const mn: MethodNode* = block.methods[mi];
                if (mn == null || mn.func == null) { continue; }
                const fn_node: FunctionDeclNode* = mn.func;
                if (!fn_node.name.equals(member.member)) { continue; }

                // Build the overload parameter list (skip self in both
                // forms) the same way ClassType/StructType registration
                // does: that's the signature against which sema matches
                // call args.
                mut params: TypeRef[] = [];
                for (mut pi: i64 = 0; pi < fn_node.parameters.length; pi++) {
                    const pp: VarDeclNode* = fn_node.parameters[pi];
                    if (pp == null) { continue; }
                    if (pp.name.equals(this_amp)) { continue; }
                    if (pp.name.equals(this_val)) { continue; }
                    params.push(pp.resolved_type);
                }
                if (params.length != arg_types.length) { continue; }

                mut compat: boolean = true;
                for (mut pi: i64 = 0; pi < params.length; pi++) {
                    if (params[pi].id == arg_types[pi].id) { continue; }
                    if (allow_implicit && this.checker.can_implicit_convert(
                            arg_types[pi], params[pi])) {
                        continue;
                    }
                    compat = false;
                    break;
                }
                if (compat) {
                    call.set_resolved_method(mn as ASTNode*);
                    this.pin_method_callee_from_qname(
                        call, owner_str, mn, mn.is_static);
                    return true;
                }
            }
        }
        return false;
    }

    /// Find an inherent method named `name` on a generic template's AST -
    /// struct/class body methods plus any non-trait `implement` blocks.
    /// Returns its FunctionDeclNode (carrying the `where` bounds) or null.
    find_template_method(&this, ast_node: ASTNode*, name: SymbolStr) -> FunctionDeclNode* {
        if (ast_node == null) { return null; }
        if (ast_node.kind == NodeKind::StructDeclaration) {
            const d: StructDeclNode* = ast_node as StructDeclNode*;
            for (mut i: i64 = 0; i < d.methods.length; i++) {
                const m: MethodNode* = d.methods[i];
                if (m != null && m.func != null && m.func.name.equals(name)) {
                    return m.func;
                }
            }
        } else if (ast_node.kind == NodeKind::ClassDeclaration) {
            const d: ClassDeclNode* = ast_node as ClassDeclNode*;
            for (mut i: i64 = 0; i < d.methods.length; i++) {
                const m: MethodNode* = d.methods[i];
                if (m != null && m.func != null && m.func.name.equals(name)) {
                    return m.func;
                }
            }
        }
        return null;
    }

    /// When a method isn't found on a generic receiver, check whether the
    /// receiver's *template* defines that method but gated behind a `where`
    /// clause its concrete type arguments don't satisfy - e.g.
    /// `Array<String>.get()`, where `get` is `where T: Copy` but `String`
    /// isn't `Copy`.  If so, emit a precise diagnostic naming the unmet bound
    /// (with a borrow hint for `Copy`) and return true; otherwise return
    /// false so the caller falls back to the generic "no method" message.
    try_diagnose_method_bound_failure(mut &this, obj_type: TypeRef,
                                       member: MemberAccessNode*) -> boolean {
        const reg: GenericRegistry* = this.ctx.get_generic_registry();
        if (reg == null || this.ctx.monomorphizer == null) { return false; }

        // Peel ref/ptr to find the InstantiatedType wrapper that carries the
        // concrete type arguments.
        mut t: Type* = this.arena.lookup(obj_type.id);
        mut depth: i32 = 0;
        while (t != null && depth < 5) {
            if (t.kind == TypeKind::InstantiatedType) { break; }
            if (t.kind == TypeKind::Reference) {
                t = this.arena.lookup((t as ReferenceType*).referent.id);
            } else if (t.kind == TypeKind::Pointer) {
                t = this.arena.lookup((t as PointerType*).pointee.id);
            } else {
                break;
            }
            depth += 1;
        }
        if (t == null || t.kind != TypeKind::InstantiatedType) { return false; }
        const inst: InstantiatedType* = t as InstantiatedType*;

        const tmpl: TemplateEntry* = reg.get_template_by_type_id(inst.generic_base.id);
        if (tmpl == null || tmpl.ast_node == null) { return false; }
        if (tmpl.param_names.length != inst.type_args.length) { return false; }

        const func: FunctionDeclNode* =
            this.find_template_method(tmpl.ast_node, member.member);
        if (func == null || func.trait_bounds.length == 0) { return false; }

        // Find the first bound whose concrete argument doesn't satisfy it.
        for (mut bi: i64 = 0; bi < func.trait_bounds.length; bi++) {
            const bound: TraitBound = func.trait_bounds[bi];
            mut concrete: TypeRef = TypeRef::invalid();
            for (mut pi: i64 = 0; pi < tmpl.param_names.length; pi++) {
                if (tmpl.param_names[pi].equals(bound.type_parameter)) {
                    concrete = inst.type_args[pi];
                    break;
                }
            }
            if (!concrete.is_valid()) { continue; }
            for (mut ri: i64 = 0; ri < bound.trait_refs.length; ri++) {
                const tref: TraitRef = bound.trait_refs[ri];
                if (tref.path.length == 0) { continue; }
                const trait_name: SymbolStr = tref.path[tref.path.length - 1];
                if (this.ctx.monomorphizer.type_implements_trait(concrete, trait_name, 0)) {
                    continue;
                }
                // Unmet bound - build the diagnostic.
                const method_str: string = this.intern.resolve(member.member);
                const trait_str:  string = this.intern.resolve(trait_name);
                const param_str:  string = this.intern.resolve(bound.type_parameter);
                const conc_str:   string = this.type_display_name(concrete);
                const primary: SourceSpan = if (member.member_span.has_location()) {
                    member.member_span
                } else {
                    member.span
                };
                mut d: Diagnostic = Diagnostic::error(
                    ErrorCode::E0358_UNDEFINED_METHOD_IMPL,
                    format("the trait bound `%s: %s` is not satisfied",
                        conc_str, trait_str));
                d = d.at(primary);
                d = d.with_note(format("method `%s` requires `%s: %s`",
                    method_str, param_str, trait_str));
                if (strcmp(trait_str, "Copy") == 0) {
                    d = d.help(format(
                        "`%s` owns resources, so it isn't `Copy`; borrow the element in place with `get_ptr` instead of copying it out with `%s`",
                        conc_str, method_str));
                }
                this.ctx.emit_diagnostic(d);
                return true;
            }
        }
        return false;
    }

    /// for-in over a non-`Copy` collection.  The desugar lowers
    /// `for (x in xs)` to `xs.iter()` followed by `iter.next()`, but
    /// `Array<T>::iter` / `Slice<T>::iter` are gated `where T: Copy`.  For a
    /// non-`Copy` element the `.iter()` wrap can't resolve, so the loop is
    /// left calling `.next()` (or `.iter()`) on the bare collection and the
    /// user sees a bare "no method named `next`" pointing at a call they
    /// never wrote.  Detect that shape — a Copy-gated `iter` whose concrete
    /// element argument isn't `Copy` — and report the real cause with a
    /// by-reference workaround.  Returns true when it emitted a diagnostic.
    try_diagnose_forin_noncopy(mut &this, obj_type: TypeRef,
                                member: MemberAccessNode*,
                                primary_span: SourceSpan) -> boolean {
        // Only the for-in desugar calls `.next()` / `.iter()` against a bare
        // collection; users don't invoke those on the container directly.
        const is_next: boolean = member.member.equals(this.intern.intern("next"));
        const is_iter: boolean = member.member.equals(this.intern.intern("iter"));
        if (!is_next && !is_iter) { return false; }

        const reg: GenericRegistry* = this.ctx.get_generic_registry();
        if (reg == null || this.ctx.monomorphizer == null) { return false; }

        // Peel ref/ptr to the InstantiatedType carrying the element arg.
        mut t: Type* = this.arena.lookup(obj_type.id);
        mut depth: i32 = 0;
        while (t != null && depth < 5) {
            if (t.kind == TypeKind::InstantiatedType) { break; }
            if (t.kind == TypeKind::Reference) {
                t = this.arena.lookup((t as ReferenceType*).referent.id);
            } else if (t.kind == TypeKind::Pointer) {
                t = this.arena.lookup((t as PointerType*).pointee.id);
            } else {
                break;
            }
            depth += 1;
        }
        if (t == null || t.kind != TypeKind::InstantiatedType) { return false; }
        const inst: InstantiatedType* = t as InstantiatedType*;

        const tmpl: TemplateEntry* = reg.get_template_by_type_id(inst.generic_base.id);
        if (tmpl == null || tmpl.ast_node == null) { return false; }
        if (tmpl.param_names.length != inst.type_args.length) { return false; }

        // The collection must expose an `iter` whose where-clause gates it.
        const iter_fn: FunctionDeclNode* =
            this.find_template_method(tmpl.ast_node, this.intern.intern("iter"));
        if (iter_fn == null || iter_fn.trait_bounds.length == 0) { return false; }

        // Find a `where <param>: Copy` bound on iter() whose concrete
        // argument doesn't satisfy `Copy`.
        for (mut bi: i64 = 0; bi < iter_fn.trait_bounds.length; bi++) {
            const bound: TraitBound = iter_fn.trait_bounds[bi];
            mut concrete: TypeRef = TypeRef::invalid();
            for (mut pi: i64 = 0; pi < tmpl.param_names.length; pi++) {
                if (tmpl.param_names[pi].equals(bound.type_parameter)) {
                    concrete = inst.type_args[pi];
                    break;
                }
            }
            if (!concrete.is_valid()) { continue; }
            for (mut ri: i64 = 0; ri < bound.trait_refs.length; ri++) {
                const tref: TraitRef = bound.trait_refs[ri];
                if (tref.path.length == 0) { continue; }
                const trait_name: SymbolStr = tref.path[tref.path.length - 1];
                if (strcmp(this.intern.resolve(trait_name), "Copy") != 0) { continue; }
                if (OwnershipQuery::is_copy(this.arena, reg, this.intern, concrete)) {
                    continue;
                }
                // Confirmed: iter() is Copy-gated and the element isn't Copy.
                const coll_str: string = this.type_display_name(obj_type);
                const elem_str: string = this.type_display_name(concrete);
                mut d: Diagnostic = Diagnostic::error(
                    ErrorCode::E0358_UNDEFINED_METHOD_IMPL,
                    format("cannot iterate `%s` with `for-in`: its element type `%s` is not `Copy`",
                        coll_str, elem_str));
                d = d.at(primary_span);
                d = d.with_note(
                    "`for (x in xs)` lowers to `xs.iter()`, but `iter` is gated `where T: Copy` because it yields elements by value");
                d = d.help(format(
                    "iterate by index and borrow each element in place instead, e.g. `for (mut i: u64 = 0; i < xs.length(); i++) { const x: %s* = ... xs.get_ptr(i); }`",
                    elem_str));
                this.ctx.emit_diagnostic(d);
                return true;
            }
        }
        return false;
    }

    resolve_method_call(mut &this, member: MemberAccessNode*) -> TypeRef {
        const obj_type: TypeRef = this.resolve_expr(member.object);
        // Input invalid -> upstream error already emitted, stay silent
        if (!obj_type.is_valid()) { return TypeRef::invalid(); }

        // Unwrap Pointer / Reference / InstantiatedType so method lookup
        // works on `this.intern_table.resolve(name)` where `intern_table`
        // is declared as `InternTable*`.  Without this the type-symbol
        // reverse-lookup fails on the pointer wrapper and the call's
        // return type silently stays invalid, starving downstream
        // codegen of the info needed to pick the right path (e.g.,
        // match-on-string subject detection).
        mut lookup_ref: TypeRef = obj_type;
        mut base_t: Type* = this.arena.lookup(obj_type.id);
        mut unwrap_depth: i32 = 0;
        while (base_t != null && unwrap_depth < 5) {
            if (base_t.kind == TypeKind::Pointer) {
                const pt: PointerType* = base_t as PointerType*;
                lookup_ref = pt.pointee;
                base_t = this.arena.lookup(lookup_ref.id);
            } else if (base_t.kind == TypeKind::Reference) {
                const rt: ReferenceType* = base_t as ReferenceType*;
                lookup_ref = rt.referent;
                base_t = this.arena.lookup(lookup_ref.id);
            } else if (base_t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = base_t as InstantiatedType*;
                if (!inst.has_resolved_type()) { break; }
                lookup_ref = inst.resolved_type;
                base_t = this.arena.lookup(lookup_ref.id);
            } else {
                break;
            }
            unwrap_depth += 1;
        }

        const type_sym: SymbolStr = this.lookup_type_sym(lookup_ref);
        if (!type_sym.is_valid()) {
            // BoundedParam still needs a chance: its name maps to the
            // generic-param identifier (e.g. "T"), which won't reverse-look
            // up to a SymbolStr but the bounds carry trait identities.
            if (base_t != null && base_t.kind == TypeKind::BoundedParam) {
                const trait_ret: TypeRef = this.lookup_method_through_bounds(
                    base_t as BoundedParamType*, member.member);
                if (trait_ret.is_valid()) {
                    member.set_resolved_type(trait_ret);
                    return trait_ret;
                }
            }
            // Valid type but no reverse mapping; internal gap, not user error
            return TypeRef::invalid();
        }

        // Try direct method lookup, then walk class hierarchy
        const ret: TypeRef = this.lookup_method_with_inheritance(
            lookup_ref, type_sym, member.member);
        if (ret.is_valid()) {
            const acc_span: SourceSpan = if (member.member_span.has_location()) {
                member.member_span
            } else {
                member.span
            };
            this.enforce_method_visibility(lookup_ref, member.member, acc_span);
            // When the call carries explicit method-level generic args
            // (`obj.method<U>(...)`), the bare lookup has the receiver's
            // type-level params substituted but knows nothing about the
            // method's own generic params; so a `cast<U>(&this) -> NonNull<U>`
            // looked up on `NonNull<u8>` comes back as `NonNull<u8>` instead
            // of `NonNull<U>`-with-U-still-free.  Re-resolve from the
            // method's template return annotation with both bindings
            // (struct-level + method-level) in scope so the call's resolved
            // type reflects the explicit args.
            const refined: TypeRef = if (member.generic_args.length > 0) {
                this.resolve_method_return_with_explicit_args(
                    obj_type, member, ret)
            } else {
                ret
            };
            member.set_resolved_type(refined);
            return refined;
        }

        // Bound-aware dispatch (B.4): when the receiver is a generic
        // parameter with trait bounds, the method might live on one of
        // those bounds. Walk them and pick the first matching trait method.
        if (base_t != null && base_t.kind == TypeKind::BoundedParam) {
            const trait_ret: TypeRef = this.lookup_method_through_bounds(
                base_t as BoundedParamType*, member.member);
            if (trait_ret.is_valid()) {
                member.set_resolved_type(trait_ret);
                return trait_ret;
            }
        }

        // Inherited-default fallback (B.4 + partial B.6): when a concrete
        // type X impls trait T and T provides a default method body, the
        // method isn't registered under X but is registered under T.
        // Walk T's that X impls and look for the method there. The full
        // B.6 work clones the default body into the impl AST; until that
        // lands, this lets sema type-check the call site so codegen can
        // dispatch through the trait method's own symbol.
        const inherited: TypeRef = this.lookup_method_through_trait_impls(
            type_sym, member.member);
        if (inherited.is_valid()) {
            member.set_resolved_type(inherited);
            return inherited;
        }

        // Before giving up, check if the member is a field with function type.
        // This handles patterns like `this.read_fn(args)` where read_fn is a
        // function pointer field, not a method.  The MemberAccess node's
        // resolved_type must stay as the Function type so codegen can emit
        // an indirect call through the loaded field; we return the
        // function's return type for the wrapping CallExpression, but
        // `try_field_function_call` tags the member directly.
        const field_ret: TypeRef = this.try_field_function_call(
            lookup_ref, member.member, member);
        if (field_ret.is_valid()) {
            return field_ret;
        }

        // A `.drop()` on a `Copy` receiver is a no-op: a bitwise-duplicable
        // value owns no resources, so there is nothing to release.  Copy
        // types deliberately carry no `drop` method (one would make them
        // non-Copy), so the lookups above legitimately found nothing - accept
        // the call as a no-op of type `void` instead of erroring.  This lets
        // generic `where T: Drop` containers (`Array`, `Box`, ...) instantiate
        // for Copy element types, whose drop bodies call `element.drop()` per
        // slot; codegen emits nothing for the call (see call_emitter).
        if (member.member.equals(this.intern.intern("drop"))
                && OwnershipQuery::is_copy(this.arena,
                       this.ctx.get_generic_registry(), this.intern, lookup_ref)) {
            member.set_resolved_type(this.arena.get_void());
            return this.arena.get_void();
        }

        // Inputs were valid but method not found.  Before emitting the
        // generic "method not found" diagnostic, ask the monomorphizer
        // whether a trait impl that COULD have provided this method has
        // its where-bounds violated for this specialization; that's
        // the truthful diagnostic for `result.clone()` on a
        // `Result<T, E>` where (say) `E: Clone` doesn't hold.  The
        // monomorphizer dropped the bounds-violating impl pre-spec
        // (`filter_bounds_violating_impls`) so the spec'd type
        // genuinely has no `clone`, but for the user-facing message
        // "the trait `Clone` is not implemented because the bound
        // `E: Clone` is not satisfied" is far more actionable than
        // "method not found".
        const method_name: string = this.intern.resolve(member.member);
        const recv_t: Type* = this.arena.lookup(lookup_ref.id);
        const type_display: string = if (recv_t != null) {
            this.arena.format_display(recv_t)
        } else {
            this.intern.resolve(type_sym)
        };
        // Prefer member_span (just the `.method` token) for the caret;
        // fall back to the whole expression span if the parser didn't
        // record one.
        const primary_span: SourceSpan = if (member.member_span.has_location()) {
            member.member_span
        } else {
            member.span
        };

        if (this.ctx.monomorphizer != null) {
            const failed_trait: SymbolStr = this.ctx.monomorphizer.diagnose_method_bounds_failure(
                lookup_ref, member.member);
            if (failed_trait.is_valid()) {
                const trait_str: string = this.intern.resolve(failed_trait);
                mut diag: Diagnostic = Diagnostic::error(
                    ErrorCode::E0358_UNDEFINED_METHOD_IMPL,
                    format("the trait `%s` is not implemented for `%s`",
                        trait_str, type_display));
                diag = diag.at(primary_span);
                diag = diag.with_note(format(
                    "the impl of `%s` for this type has a where-clause that this specialization does not satisfy",
                    trait_str));
                diag = diag.help(format(
                    "method `%s` belongs to trait `%s`; ensure the type arguments satisfy the impl's bounds",
                    method_name, trait_str));
                this.ctx.emit_diagnostic(diag);
                return TypeRef::invalid();
            }
        }

        // Inherent method gated by an unsatisfied `where` clause - e.g.
        // `Array<String>.get()`, where `get` requires `T: Copy` but `String`
        // owns heap data.  Report the specific unmet bound (and, for `Copy`,
        // point at the borrowing alternative) instead of a bare "no method".
        if (this.try_diagnose_method_bound_failure(obj_type, member)) {
            return TypeRef::invalid();
        }

        // for-in over a non-Copy Array/Slice: the desugar's synthesized
        // `.next()`/`.iter()` call fails here; report the Copy-gate cause
        // rather than a bare "no method named `next`".
        if (this.try_diagnose_forin_noncopy(obj_type, member, primary_span)) {
            return TypeRef::invalid();
        }

        // Generic "no method found": clean source-snippet message with
        // an inline list of impls that exist on this type, plus a
        // suggestion for the closest matching method name when one is
        // available.  No more `qualified=`/`cross=`/`in <file>` debug
        // context; those are tracing aids, not user-facing.
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0358_UNDEFINED_METHOD_IMPL,
            format("no method named `%s` found on type `%s`",
                method_name, type_display));
        diag = diag.at(primary_span);

        // Hint about an existing trait that defines this method, if any.
        const owning_trait: SymbolStr = this.lookup_trait_defining_method(member.member);
        if (owning_trait.is_valid()) {
            const trait_str: string = this.intern.resolve(owning_trait);
            diag = diag.with_note(format(
                "the method `%s` is defined on trait `%s`",
                method_name, trait_str));
            diag = diag.help(format(
                "implement `%s` for `%s`, or change the receiver to a type that already does",
                trait_str, type_display));
        } else {
            // Suggest a similarly-named method on the same type.  We
            // already have the member name's span, so attach an actual
            // machine-applicable Suggestion (rather than a help-only
            // line) so editors can offer it as a quickfix.
            const suggestion: SymbolStr = this.suggest_similar_method(type_sym, member.member);
            if (suggestion.is_valid()) {
                const sug_str: string = this.intern.resolve(suggestion);
                diag = diag.help(format(
                    "a method with a similar name exists: `%s`", sug_str));
                if (member.member_span.has_location()) {
                    diag = diag.suggest(Suggestion::machine_applicable(
                        member.member_span, sug_str,
                        format("did you mean `%s`?", sug_str)));
                }
            }
        }

        // Import-shadow detection: if a different user-defined type with
        // the same simple-name owns this method, the user likely imported
        // (or had auto-imported) the wrong one.  Common when two crates
        // both define `Diagnostic`/`Result`/`Error` etc.  The note +
        // quickfix tells the user which qualified type to add to imports.
        const resolved_qname: SymbolStr = this.arena.get_qualified_name(lookup_ref);
        if (resolved_qname.is_valid()) {
            const resolved_qname_str: string = this.intern.resolve(resolved_qname);
            const simple: string = extract_leaf_segment(resolved_qname_str);
            if (simple != "") {
                const simple_sym: SymbolStr = this.intern.intern(simple);
                const shadows: SymbolStr[] = this.find_shadowed_type_candidates(
                    simple_sym, member.member, lookup_ref);
                if (shadows.length > 0) {
                    diag = this.attach_shadow_import_suggestions(
                        diag, simple, shadows);
                } else {
                    // No shadow candidates: nothing consumes the array, so
                    // release its spine here instead of leaking it.
                    shadows.drop();
                }
            }
        }

        this.ctx.emit_diagnostic(diag);
        return TypeRef::invalid();
    }

    /// Check if a member is a field with function type on a struct/class.
    /// Returns the function's return type (for the wrapping CallExpression)
    /// and, when `member` is non-null, tags it with the field's Function
    /// type so codegen can emit an indirect call through the loaded field.
    /// Without the member tag the MemberAccess would look like a regular
    /// value-typed expression and codegen would chase method lookups for
    /// the wrapping call instead of loading and calling the field.
    try_field_function_call(&this, obj_type: TypeRef, field_name: SymbolStr,
                             member: MemberAccessNode*) -> TypeRef {
        // Dereference through references to get the underlying type
        const t: Type* = this.arena.lookup(obj_type.id);
        if (t == null) { return TypeRef::invalid(); }

        mut check_t: Type* = t;
        if (check_t.kind == TypeKind::Reference) {
            const ref_t: ReferenceType* = check_t as ReferenceType*;
            const inner: TypeRef = ref_t.referent;
            check_t = this.arena.lookup(inner.id);
            if (check_t == null) { return TypeRef::invalid(); }
        }

        // Search fields on struct or class
        if (check_t.kind == TypeKind::Struct) {
            const st: StructType* = check_t as StructType*;
            for (mut i: i64 = 0; i < st.fields.length; i++) {
                const f_name: SymbolStr = st.fields[i].name;
                if (f_name.id == field_name.id) {
                    const f_type: TypeRef = st.fields[i].field_type;
                    const ft: Type* = this.arena.lookup(f_type.id);
                    if (ft != null && ft.kind == TypeKind::Function) {
                        const fn_t: FunctionType* = ft as FunctionType*;
                        if (member != null) { member.set_resolved_type(f_type); }
                        return fn_t.return_type;
                    }
                    return TypeRef::invalid();
                }
            }
        } else if (check_t.kind == TypeKind::Class) {
            const ct: ClassType* = check_t as ClassType*;
            for (mut i: i64 = 0; i < ct.fields.length; i++) {
                const f_name: SymbolStr = ct.fields[i].name;
                if (f_name.id == field_name.id) {
                    const f_type: TypeRef = ct.fields[i].field_type;
                    const ft: Type* = this.arena.lookup(f_type.id);
                    if (ft != null && ft.kind == TypeKind::Function) {
                        const fn_t: FunctionType* = ft as FunctionType*;
                        if (member != null) { member.set_resolved_type(f_type); }
                        return fn_t.return_type;
                    }
                    return TypeRef::invalid();
                }
            }
        }
        return TypeRef::invalid();
    }

    /// Bound-aware method dispatch (B.4). When the receiver type is a
    /// `BoundedParamType` (i.e. a generic param `T` with trait bounds), the
    /// concrete impl isn't known yet, but the trait declaration determines
    /// the call's signature. For each bound trait we look up the method's
    /// return type registered in the DeclarationIndex (TraitDeclaration's
    /// resolution path populates these). The first match wins; the
    /// monomorphizer (B.6) will route the call to the concrete impl once
    /// `T` is bound to a real type.
    lookup_method_through_bounds(&this, bp: BoundedParamType*,
                                 method_name: SymbolStr) -> TypeRef {
        if (bp == null) { return TypeRef::invalid(); }
        for (mut i: i64 = 0; i < bp.bounds.length; i++) {
            const bound_ref: TypeRef = bp.bounds[i];
            const bound_t: Type* = this.arena.lookup(bound_ref.id);
            if (bound_t == null || bound_t.kind != TypeKind::Trait) { continue; }
            const trait_ty: TraitType* = bound_t as TraitType*;
            const ret: TypeRef = this.lookup_method_return(
                trait_ty.qualified_name, method_name);
            if (ret.is_valid()) { return ret; }
        }
        return TypeRef::invalid();
    }

    /// Walk the trait-impl registry for `target_name` and return the first
    /// matching trait-method return type. Used to resolve calls to default
    /// trait methods on a concrete type that doesn't override them; full
    /// AST-level synthesis (B.6) is still pending, but typing the call site
    /// against the trait's signature is enough for sema to proceed.
    /// `target_name` may be qualified (`std::io::stdio::Stdin`) or bare
    /// (`Stdin`); the registry is keyed by the bare name as captured by
    /// the impl-block parser, so try both forms.
    lookup_method_through_trait_impls(&this, target_name: SymbolStr,
                                      method_name: SymbolStr) -> TypeRef {
        if (!target_name.is_valid() || this.ctx.generic_registry == null) {
            return TypeRef::invalid();
        }
        const direct: TypeRef = this.try_trait_impls_for(target_name, method_name);
        if (direct.is_valid()) { return direct; }
        const bare: SymbolStr = this.bare_leaf_of_qualified(target_name);
        if (bare.is_valid() && !bare.equals(target_name)) {
            return this.try_trait_impls_for(bare, method_name);
        }
        return TypeRef::invalid();
    }

    try_trait_impls_for(&this, target: SymbolStr, method_name: SymbolStr) -> TypeRef {
        const traits: SymbolStr[] = this.ctx.generic_registry.traits_implemented_by(target);
        for (mut i: i64 = 0; i < traits.length; i++) {
            const ret: TypeRef = this.lookup_method_return(traits[i], method_name);
            if (ret.is_valid()) { return ret; }
        }
        return TypeRef::invalid();
    }

    /// Strip namespace segments off a possibly-qualified name. Returns
    /// the leaf segment after the final `::`, or the input unchanged when
    /// no `::` is present.
    bare_leaf_of_qualified(&this, name: SymbolStr) -> SymbolStr {
        if (!name.is_valid()) { return name; }
        const s: string = this.intern.resolve(name);
        const n: i64 = strlen(s) as i64;
        mut last_sep: i64 = -1;
        for (mut i: i64 = 0; i + 1 < n; i++) {
            if (s[i] == ':' && s[i + 1] == ':') { last_sep = i + 2; }
        }
        if (last_sep < 0) { return name; }
        mut tail: string = "";
        for (mut i: i64 = last_sep; i < n; i++) {
            tail = format("%s%c", tail, s[i] as i32);
        }
        return this.intern.intern(tail);
    }

    /// Hint helper: scan registered trait decls for one that defines
    /// `method_name`. Returns the trait's bare name, or
    /// `SymbolStr::empty()` when no trait declares the method. Used by
    /// the "no method found" diagnostic to suggest implementing the
    /// owning trait for the receiver type.
    lookup_trait_defining_method(&this, method_name: SymbolStr) -> SymbolStr {
        if (this.ctx.generic_registry == null) { return SymbolStr::empty(); }
        return this.ctx.generic_registry.find_trait_defining_method(method_name);
    }

    /// Hint helper: search the receiver type's own methods (struct/class
    /// inline + trait-impl methods) for a name close to `method_name`,
    /// returning the closest match when one is within edit-distance 2.
    /// Returns `SymbolStr::empty()` when no good suggestion exists. The
    /// distance threshold is intentionally tight; wider matches produce
    /// confusing "did you mean" hints.
    suggest_similar_method(&this, type_sym: SymbolStr,
                            method_name: SymbolStr) -> SymbolStr {
        if (!type_sym.is_valid() || !method_name.is_valid()) {
            return SymbolStr::empty();
        }
        const ty_ref: TypeRef = this.lookup_type_by_sym(type_sym);
        if (!ty_ref.is_valid()) { return SymbolStr::empty(); }
        const needle: string = this.intern.resolve(method_name);
        const cands: string[] = this.collect_struct_or_class_member_names(ty_ref);
        const best: string = find_best_candidate(needle, cands);
        if (best == "") { return SymbolStr::empty(); }
        return this.intern.intern(best);
    }

    /// Walk the type arena for other user-defined types whose simple-name
    /// (last `::` segment of the qualified name) matches `simple_name` and
    /// that own a method named `member_name`.  `resolved_type` is the type
    /// the failed lookup actually landed on; it is excluded from results
    /// so we don't suggest "import the type we already resolved to".
    ///
    /// Used to detect import-shadow cases: e.g. the source imports
    /// `Compiler::Diag` but calls `Diagnostic::error(...)`, and the
    /// resolver picked `Lsp::Protocol::Lsp::Diagnostic` because the LSP
    /// project was in scope.  The arena holds both `Diagnostic` types;
    /// walking it finds the one that has `error` and lets us emit a
    /// machine-applicable "import the right one" quickfix.
    ///
    /// Pass `SymbolStr::empty()` as `member_name` to skip the method
    /// filter (used when the failure is "no static at all" and we only
    /// need same-simple-name candidates).  Result capped at 4 candidates;
    /// past that the suggestion is too noisy to help.
    find_shadowed_type_candidates(&this, simple_name: SymbolStr,
                                  member_name: SymbolStr,
                                  resolved_type: TypeRef) -> SymbolStr[] {
        mut results: SymbolStr[] = [];
        if (!simple_name.is_valid()) { return results; }
        const needle: string = this.intern.resolve(simple_name);
        const filter_member: boolean = member_name.is_valid();

        const n: i64 = this.arena.type_count();
        for (mut i: i64 = 0; i < n; i++) {
            const t: Type* = this.arena.types[i];
            if (t == null) { continue; }
            if (resolved_type.is_valid() && t.id == resolved_type.id) { continue; }

            mut qname: SymbolStr = SymbolStr::empty();
            mut has_member: boolean = !filter_member;

            if (t.kind == TypeKind::Struct) {
                const st: StructType* = t as StructType*;
                qname = st.qualified_name;
                if (filter_member) {
                    has_member = st.get_method(member_name) != null;
                }
            } else if (t.kind == TypeKind::Class) {
                const ct: ClassType* = t as ClassType*;
                qname = ct.qualified_name;
                if (filter_member) {
                    has_member = ct.get_method(member_name) != null;
                }
            } else if (t.kind == TypeKind::Enum) {
                const et: EnumType* = t as EnumType*;
                qname = et.qualified_name;
                if (filter_member) {
                    has_member = et.get_method(member_name) != null
                              || et.get_variant(member_name) != null;
                }
            } else {
                continue;
            }

            if (!qname.is_valid() || !has_member) { continue; }
            const qstr: string = this.intern.resolve(qname);
            const leaf: string = extract_leaf_segment(qstr);
            if (leaf != needle) { continue; }

            // Dedupe in case the arena holds multiple TypeRefs that point
            // at the same qualified name (e.g. template + instantiation).
            mut dup: boolean = false;
            for (mut j: i64 = 0; j < results.length; j++) {
                if (results[j].equals(qname)) { dup = true; break; }
            }
            if (dup) { continue; }

            results.push(qname);
            if (results.length >= 4) { break; }
        }
        return results;
    }

    /// Build a zero-width SourceSpan suitable for inserting a new
    /// `import ...;` line into the current module.  Walks the top-level
    /// statements for the last `ImportDeclNode` and returns a point span
    /// at its end coordinate (so inserting `"\nimport X;"` lands the new
    /// line directly under the existing import block).  Falls back to a
    /// point at the end of the first non-namespace statement when no
    /// imports exist, and to `SourceSpan::none()` when there is nothing
    /// usable - which signals "skip the machine-applicable suggestion".
    find_import_insertion_span(&this) -> SourceSpan {
        if (this.ctx == null) { return SourceSpan::none(); }
        const root: ProgramNode* = this.ctx.artifacts.ast.root;
        if (root == null) { return SourceSpan::none(); }

        mut last_import_span: SourceSpan = SourceSpan::none();
        mut fallback_span: SourceSpan = SourceSpan::none();

        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }
            if (stmt.kind == NodeKind::ImportDeclaration) {
                last_import_span = stmt.span;
            } else if (!fallback_span.has_location()) {
                // First non-import top-level node (likely a namespace
                // declaration or doc-comment block).  We only use this
                // when there are NO imports at all.
                fallback_span = stmt.span;
            }
        }

        const anchor: SourceSpan = if (last_import_span.has_location()) {
            last_import_span
        } else {
            fallback_span
        };
        if (!anchor.has_location()) { return SourceSpan::none(); }
        return SourceSpan::new(anchor.file,
                               anchor.end_line, anchor.end_col,
                               anchor.end_line, anchor.end_col);
    }

    /// Attach an "import the right type" note + machine-applicable
    /// quickfix to `diag` for every shadowed candidate.  No-op when
    /// `candidates` is empty.  Applicability is MachineApplicable when
    /// there is exactly one candidate; with multiple candidates each
    /// suggestion is MaybeIncorrect so editors don't auto-apply a
    /// guess.  Returns the (possibly extended) diagnostic.
    attach_shadow_import_suggestions(&this, diag: Diagnostic,
                                     simple_name_str: string,
                                     candidates: SymbolStr[]) -> Diagnostic {
        if (candidates.length == 0) { return diag; }
        mut out: Diagnostic = diag;
        const insert_span: SourceSpan = this.find_import_insertion_span();
        const apply: Applicability = if (candidates.length == 1) {
            Applicability::MachineApplicable
        } else {
            Applicability::MaybeIncorrect
        };

        for (mut i: i64 = 0; i < candidates.length; i++) {
            const cand_str: string = this.intern.resolve(candidates[i]);
            out = out.with_note(format(
                "another `%s` exists: `%s`", simple_name_str, cand_str));
            // The import targets the *module* that owns the type
            // (`Compiler::Diag::Diagnostic`), not the type's own
            // fully-qualified path (`Compiler::Diag::Diagnostic::Diagnostic`).
            // Bringing the module into scope is the idiomatic form and
            // makes the simple name `Diagnostic` resolve unambiguously.
            const import_path: string = extract_parent_path(cand_str);
            if (import_path == "") { continue; }
            if (insert_span.has_location()) {
                const insertion: string = format("\nimport %s;", import_path);
                const msg: string = format("import `%s`", import_path);
                out = out.suggest(Suggestion::single(
                    insert_span, insertion, msg, apply));
            }
        }
        out = out.help(format(
            "the unqualified name `%s` resolved to a different type than the one you meant; import the intended module to disambiguate",
            simple_name_str));
        return out;
    }

    /// Look up a method by walking the class inheritance chain.
    /// Checks the immediate type first, then walks parent classes.
    lookup_method_with_inheritance(&this, type_ref: TypeRef,
                                   type_sym: SymbolStr,
                                   method_name: SymbolStr) -> TypeRef {
        // Try the immediate type
        const direct: TypeRef = this.lookup_method_return(type_sym, method_name);
        if (direct.is_valid()) { return direct; }

        // Walk class hierarchy
        mut current_ref: TypeRef = type_ref;
        mut current_t: Type* = this.arena.lookup(current_ref.id);
        if (current_t == null || current_t.kind != TypeKind::Class) {
            return TypeRef::invalid();
        }

        mut current: ClassType* = current_t as ClassType*;
        while (current.has_base && current.base_class.is_valid()) {
            const parent_ref: TypeRef = current.base_class;
            const parent_t: Type* = this.arena.lookup(parent_ref.id);
            if (parent_t == null || parent_t.kind != TypeKind::Class) { break; }
            const parent_sym: SymbolStr = this.ctx.decl_index.lookup_type_name(parent_ref);
            if (parent_sym.is_valid()) {
                const parent_ret: TypeRef = this.lookup_method_return(
                    parent_sym, method_name);
                if (parent_ret.is_valid()) { return parent_ret; }
            }
            current = parent_t as ClassType*;
        }

        return TypeRef::invalid();
    }

    /// When `member.generic_args` carry explicit method-level generic args
    /// (`obj.method<U>(...)`), re-resolve the method's *template* return-type
    /// annotation with both the receiver's type-level args and the explicit
    /// method-level args bound, so the call lands at the right concrete
    /// type.  Falls back to `fallback` (the bare-lookup return) on any miss.
    resolve_method_return_with_explicit_args(mut &this, recv_type: TypeRef,
                                              member: MemberAccessNode*,
                                              fallback: TypeRef) -> TypeRef {
        if (this.ctx.generic_registry == null) { return fallback; }
        if (this.ctx.type_resolver == null)    { return fallback; }
        if (member.generic_args.length == 0)   { return fallback; }

        // Unwrap one layer of Pointer/Reference if present so we end up at
        // the InstantiatedType (or template Struct/Class) that owns the
        // method.  Method-call resolution already did this for the lookup
        // path; mirror it here.
        mut owner_ref: TypeRef = recv_type;
        mut owner_t: Type* = this.arena.lookup(owner_ref.id);
        mut depth: i32 = 0;
        while (owner_t != null && depth < 5) {
            if (owner_t.kind == TypeKind::Pointer) {
                const pt: PointerType* = owner_t as PointerType*;
                owner_ref = pt.pointee;
                owner_t = this.arena.lookup(owner_ref.id);
            } else if (owner_t.kind == TypeKind::Reference) {
                const rt: ReferenceType* = owner_t as ReferenceType*;
                owner_ref = rt.referent;
                owner_t = this.arena.lookup(owner_ref.id);
            } else {
                break;
            }
            depth += 1;
        }
        if (owner_t == null) { return fallback; }

        // Find the owner template's AST.  Two registries to consult:
        //   - `get_template`: generic owners (e.g. `NonNull<T>`).
        //     The InstantiatedType wrapper points at the template's
        //     `generic_base`, so look that up first.
        //   - `lookup_inherent_owner`: non-generic owners that carry
        //     inline generic methods (e.g. `Request::parse<R>`).  Keyed
        //     by qualified name.
        mut owner_ast: ASTNode* = null;
        if (owner_t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = owner_t as InstantiatedType*;
            const tmpl: TemplateEntry* =
                this.ctx.generic_registry.get_template_by_type_id(
                    inst.generic_base.id);
            if (tmpl != null) {
                owner_ast = tmpl.ast_node;
            }
        }
        if (owner_ast == null) {
            const recv_qname: SymbolStr = this.arena.get_qualified_name(owner_ref);
            if (recv_qname.is_valid()) {
                owner_ast = this.ctx.generic_registry.lookup_inherent_owner(recv_qname);
                if (owner_ast == null) {
                    const tmpl: TemplateEntry* =
                        this.ctx.generic_registry.get_template(recv_qname);
                    if (tmpl != null) {
                        owner_ast = tmpl.ast_node;
                    }
                }
            }
        }
        if (owner_ast == null) { return fallback; }

        // Pull the methods[] array off whichever owner shape we found.
        mut owner_methods: MethodNode*[] = [];
        mut owner_params:  GenericParamNode*[] = [];
        if (owner_ast.kind == NodeKind::StructDeclaration) {
            const sn: StructDeclNode* = owner_ast as StructDeclNode*;
            owner_methods = sn.methods;
            owner_params  = sn.generic_params;
        } else if (owner_ast.kind == NodeKind::ClassDeclaration) {
            const cn: ClassDeclNode* = owner_ast as ClassDeclNode*;
            owner_methods = cn.methods;
            owner_params  = cn.generic_params;
        } else {
            return fallback;
        }

        // Find a method whose name + generic-param count matches the call.
        mut found: MethodNode* = null;
        for (mut k: i64 = 0; k < owner_methods.length; k++) {
            const m: MethodNode* = owner_methods[k];
            if (m == null || m.func == null) { continue; }
            if (!m.func.name.equals(member.member)) { continue; }
            if (m.func.generic_params.length != member.generic_args.length) {
                continue;
            }
            found = m;
            break;
        }
        // Trait-impl methods (incl. synthesized default methods like
        // `Iterator::fold<Acc>` / `Wrapper::wrap<B>`) live on the impl block,
        // not the owner type's struct/class `methods[]`.  When the owner-side
        // search misses, look through the trait impls registered for this
        // owner; their generic params drive the owner-level bindings instead.
        mut impl_block: ImplBlockNode* = null;
        if (found == null) {
            found = this.find_method_in_trait_impls(
                owner_ref, member.member, member.generic_args.length, &impl_block);
            if (found != null && impl_block != null) {
                owner_params = impl_block.generic_params;
            }
        }
        if (found == null) { return fallback; }
        const ret_ann: TypeAnnotation* = found.func.return_type_annotation;
        if (ret_ann == null) { return fallback; }

        // Build a resolution context that binds every owner-level and
        // method-level generic name to its concrete type, then resolve the
        // template return annotation directly.  Sema runs before the
        // monomorphizer, so the template annotations don't yet have
        // `pre_resolved` populated; we need real bindings on the context
        // for `resolve_named("T", ctx)` / `resolve_named("U", ctx)` to land
        // on something concrete.
        mut res_ctx: ResolutionContext = ResolutionContext::new(
            this.ctx.source_file, "");
        if (owner_t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = owner_t as InstantiatedType*;
            const n: i64 = if (owner_params.length < inst.type_args.length) {
                owner_params.length
            } else {
                inst.type_args.length
            };
            for (mut i: i64 = 0; i < n; i++) {
                const gp: GenericParamNode* = owner_params[i];
                if (gp == null) { continue; }
                res_ctx.add_binding(gp.name, inst.type_args[i]);
            }
        }
        for (mut i: i64 = 0; i < found.func.generic_params.length; i++) {
            const gp: GenericParamNode* = found.func.generic_params[i];
            if (gp == null) { continue; }
            const arg_ref: TypeRef = this.ctx.type_resolver.resolve(
                member.generic_args[i], &res_ctx);
            if (!arg_ref.is_valid()) { return fallback; }
            res_ctx.add_binding(gp.name, arg_ref);
        }
        const refined: TypeRef = this.ctx.type_resolver.resolve(ret_ann, &res_ctx);
        if (!refined.is_valid()) { return fallback; }
        return refined;
    }

    /// Search the trait impls registered for `owner_ref` for a method named
    /// `method_name` whose own generic-param count matches `n_generic_args`.
    /// Synthesized default trait methods (and hand-written generic trait
    /// methods) live on the impl block rather than the owner's struct/class
    /// `methods[]`, so the owner-side lookup in
    /// `resolve_method_return_with_explicit_args` misses them.  On a match,
    /// writes the owning impl block through `out_impl` so the caller can use
    /// its generic params for the owner-level bindings.  First match wins.
    find_method_in_trait_impls(&this, owner_ref: TypeRef,
                               method_name: SymbolStr, n_generic_args: i64,
                               out_impl: ImplBlockNode**) -> MethodNode* {
        if (this.ctx.generic_registry == null) { return null; }
        const qname: SymbolStr = this.arena.get_qualified_name(owner_ref);
        const bare: SymbolStr = this.bare_leaf_of_qualified(qname);
        for (mut i: i64 = 0; i < this.ctx.generic_registry.trait_impls.length; i++) {
            const impl_node: ImplBlockNode* =
                this.ctx.generic_registry.trait_impls[i].second;
            if (impl_node == null) { continue; }
            const matches_target: boolean =
                impl_node.target_type.equals(bare)
                || (qname.is_valid() && impl_node.qualified_target_name.equals(qname))
                || (qname.is_valid() && impl_node.target_type.equals(qname));
            if (!matches_target) { continue; }
            for (mut k: i64 = 0; k < impl_node.methods.length; k++) {
                const m: MethodNode* = impl_node.methods[k];
                if (m == null || m.func == null) { continue; }
                if (!m.func.name.equals(method_name)) { continue; }
                if (m.func.generic_params.length != n_generic_args) { continue; }
                *out_impl = impl_node;
                return m;
            }
        }
        return null;
    }

    /// Dispatch: resolve `Scope::Member(args)` as one of three constructs:
    ///   1. Static method call: Type::method() or SpecializedType::method()
    ///   2. Enum variant constructor: Option::Some(x), ErrorCode::E0001
    ///   3. Module-qualified function: intrinsics::frexp(), math::sqrt()
    resolve_scope_call(mut &this, scope: ScopeResolutionNode*,
                       call: CallExprNode*) -> TypeRef {
        // If the scope has generic args (e.g., Pair<int>::new), resolve them
        // to build the specialized type name for method/type lookup.
        mut lookup_sym: SymbolStr = scope.scope_name;
        if (scope.scope_generic_args.length > 0) {
            const spec_sym: SymbolStr = this.resolve_generic_scope_name(
                scope.scope_name, scope.scope_generic_args);
            if (spec_sym.is_valid()) {
                lookup_sym = spec_sym;
            }
        }

        // 1. Static method call
        const method_ret: TypeRef = this.try_resolve_static_method(
            scope, lookup_sym, call);
        if (method_ret.is_valid()) { return method_ret; }

        // 2. Enum variant / type-based static method
        const type_ret: TypeRef = this.try_resolve_type_or_variant(
            scope, lookup_sym, call);
        if (type_ret.is_valid()) { return type_ret; }

        // 3. Module-qualified function call
        const fn_ret: TypeRef = this.try_resolve_module_function(scope, call);
        if (fn_ret.is_valid()) { return fn_ret; }

        // 4. CImport alias-qualified function (e.g., llvm::FunctionName)
        const cimport_ret: TypeRef = this.try_resolve_cimport_function(scope, call);
        if (cimport_ret.is_valid()) { return cimport_ret; }

        const scope_str: string = this.intern.resolve(scope.scope_name);
        const member_str: string = this.intern.resolve(scope.member_name);
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0233_UNDEFINED_SYMBOL,
            format("cannot find `%s::%s`: no matching static method, variant, or type",
                scope_str, member_str));
        diag = diag.at(scope.span);

        // Import-shadow detection: if another user-defined type with the
        // same simple-name as `scope.scope_name` has a static / variant
        // matching `scope.member_name`, suggest importing it.  Same idea
        // as the E0358 path above, but here the "wrong type" lookup
        // failed on the static side (Foo::bar) rather than on a method
        // call against an already-typed receiver.
        const shadows: SymbolStr[] = this.find_shadowed_type_candidates(
            scope.scope_name, scope.member_name, TypeRef::invalid());
        if (shadows.length > 0) {
            diag = this.attach_shadow_import_suggestions(diag, scope_str, shadows);
        } else {
            // No shadow candidates: nothing consumes the array, so release
            // its spine here instead of leaking it.
            shadows.drop();
        }

        this.ctx.emit_diagnostic(diag);
        return TypeRef::invalid();
    }

    /// True when the scope name in a ScopeResolution callee either:
    ///   1. resolves to a generic template: the monomorphizer's
    ///      `try_infer_static_method_on_generic_template` will re-pin
    ///      with the spec'd form, so sema pinning the template form
    ///      would shadow it.
    ///   2. resolves to a function template (`Layout::array<T>`): the
    ///      monomorphizer's `try_infer_function_call` handles these.
    ///   3. resolves to an InstantiatedType: the scope was rewritten by
    ///      AST specialization to a spec form whose qualified-form key
    ///      lives in the DI; codegen's spec-first lookup uses the type's
    ///      `qualified_name` to find it.  Pinning the bare-leaf spec
    ///      form here would dead-end before the codegen fallback runs.
    scope_is_generic_template(&this, scope_sym: SymbolStr,
                              member_sym: SymbolStr) -> boolean {
        if (this.ctx.generic_registry == null) { return false; }
        // Direct lookup: scope name registered as a generic template.
        // Generic structs/classes/enums register under their qualified
        // name; function templates register under `scope::member`.
        const scope_entry: TemplateEntry* = this.ctx.generic_registry.get_template(scope_sym);
        if (scope_entry != null) { return true; }

        // Function template registered under the combined `scope::member`
        // key (e.g. `Layout::array<T>(n)`; Layout itself isn't generic,
        // but `Layout::array` IS a function template).
        if (member_sym.is_valid()) {
            const scope_str: string = this.intern.resolve(scope_sym);
            const member_str: string = this.intern.resolve(member_sym);
            const combined: string = format("%s::%s", scope_str, member_str);
            const csym: SymbolStr = this.intern.intern(combined);
            const fn_entry: TemplateEntry* = this.ctx.generic_registry.get_template(csym);
            if (fn_entry != null) { return true; }
        }

        // Scope name resolved by AST specialization to a spec'd type
        // (e.g. `String` -> `6String$LN$L3std.5alloc...$G$G`).  These look
        // like normal types from sema's POV but their methods are
        // registered under the FULLY-qualified spec name, not the
        // bare-leaf spec form the AST specializer wrote into scope_name.
        // Codegen's spec-first lookup uses the resolved type's
        // qualified_name to find the right key; sema pinning the bare-
        // leaf form would dead-end before that fallback runs.
        if (this.ctx.decl_index != null) {
            const type_ref: TypeRef = this.ctx.decl_index.lookup_type(scope_sym);
            if (type_ref.is_valid()) {
                const t: Type* = this.arena.lookup(type_ref.id);
                if (t != null && t.kind == TypeKind::InstantiatedType) {
                    return true;
                }
            }
        }
        return false;
    }

    /// Pin `resolved_callee` on `call` to the `scope::member` combined
    /// symbol that `try_resolve_*` matched against in the DI / module
    /// graph.  Codegen's `resolve_function_by_mangled` step 3 routes
    /// qualified-name pins through `resolve_function`, which keys exactly
    /// off this combined form; the LLVM lookup converges on the
    /// definition declare_function emitted.  No-op when:
    ///   - the call is null (sema runs from many sites that aren't calls)
    ///   - `resolved_callee` is already pinned by an earlier strategy
    ///   - the scope or method is generic (let the monomorphizer pin the
    ///     spec'd form post-substitution; pinning the template form here
    ///     would shadow that)
    pin_scope_callee_combined(mut &this, call: CallExprNode*,
                               scope_sym: SymbolStr,
                               member_sym: SymbolStr) -> void {
        if (call == null) { return; }
        if (call.resolved_callee.is_valid()) { return; }
        if (!scope_sym.is_valid() || !member_sym.is_valid()) { return; }
        if (this.scope_is_generic_template(scope_sym, member_sym)) { return; }
        const scope_str: string = this.intern.resolve(scope_sym);
        const member_str: string = this.intern.resolve(member_sym);
        if (strlen(scope_str) == 0 || strlen(member_str) == 0) { return; }
        const combined: string = format("%s::%s", scope_str, member_str);
        const sym: SymbolStr = this.intern.intern(combined);

        // When several trait impls register the same method name on the
        // same target type (e.g. `TryFrom<i64> for u64` AND
        // `TryFrom<Str> for u64`; both expose `u64::try_from`), the
        // combined-name pin is ambiguous: codegen would pick whichever
        // overload `resolve_function` happens to discover first.
        // Match on arg types when available and pin the chosen overload's
        // mangled LLVM symbol; this is the static-method peer of
        // `try_pin_overload_mangled_callee` for direct calls.
        if (this.try_pin_static_method_overload(call, sym)) { return; }

        call.set_resolved_callee(sym);
    }

    /// Static-method overload selection by argument type.  When the
    /// combined `Type::method` symbol has multiple FunctionType overloads
    /// registered (multi-impl situation above), walk them and pick the
    /// one whose declared param types match the call's argument types.
    /// On a unique match, pin the overload-specific mangled name and
    /// return true.  Returns false for any non-uniquely-resolvable case
    /// (no overloads, single overload, unresolved arg types, zero or
    /// multiple matches); the caller falls back to combined-name pinning.
    try_pin_static_method_overload(mut &this, call: CallExprNode*,
                                    combined_sym: SymbolStr) -> boolean {
        const di: DeclarationIndex* = this.ctx.decl_index;
        const overloads: TypeRef[] = di.lookup_func_type_overloads(combined_sym);
        if (overloads.length < 2) { return false; }

        mut arg_types: TypeRef[] = [];
        for (mut ai: i64 = 0; ai < call.arguments.length; ai++) {
            const arg: ExpressionNode* = call.arguments[ai];
            if (arg == null || !arg.resolved_type.is_valid()) { return false; }
            arg_types.push(arg.resolved_type);
        }

        mut matched: i64 = -1;
        for (mut oi: i64 = 0; oi < overloads.length; oi++) {
            const ot: Type* = this.arena.lookup(overloads[oi].id);
            if (ot == null || ot.kind != TypeKind::Function) { continue; }
            const fn_ty: FunctionType* = ot as FunctionType*;
            if (fn_ty.param_types.length != arg_types.length) { continue; }
            mut all_match: boolean = true;
            for (mut pi: i64 = 0; pi < fn_ty.param_types.length; pi++) {
                if (!this.overload_param_matches_arg(
                        fn_ty.param_types[pi], arg_types[pi])) {
                    all_match = false;
                    break;
                }
            }
            if (!all_match) { continue; }
            if (matched != -1) { return false; }
            matched = oi;
        }
        if (matched < 0) { return false; }

        const mangled: SymbolStr = di.lookup_overload_mangled(
            combined_sym, overloads[matched]);
        if (!mangled.is_valid()) { return false; }
        call.set_resolved_callee(mangled);
        return true;
    }

    /// Pin `resolved_callee` to a pre-built qualified callee symbol (used
    /// by `try_resolve_cimport_function` and `resolve_module_qualified_function`,
    /// which already build the combined form for their own lookup).
    pin_scope_callee_qsym(mut &this, call: CallExprNode*,
                           q_sym: SymbolStr) -> void {
        if (call == null) { return; }
        if (call.resolved_callee.is_valid()) { return; }
        if (!q_sym.is_valid()) { return; }
        call.set_resolved_callee(q_sym);
    }

    /// Try resolving Scope::Member as a static method call.
    /// Tries: specialized name -> base name -> DI-qualified name.
    try_resolve_static_method(mut &this, scope: ScopeResolutionNode*,
                              lookup_sym: SymbolStr,
                              call: CallExprNode*) -> TypeRef {
        // Try specialized name (e.g., Pair_i32::new)
        const method_ret: TypeRef = this.lookup_method_return(
            lookup_sym, scope.member_name);
        if (method_ret.is_valid()) {
            const resolved: TypeRef = this.try_resolve_generic_return(
                method_ret, scope.scope_name, scope.member_name, scope);
            scope.set_resolved_type(resolved);
            this.pin_scope_callee_combined(call, lookup_sym, scope.member_name);
            return resolved;
        }
        // Try the specialized type's DI-registered qualified name.  Generic
        // struct/class templates (e.g. `Utils::Map<K, V>`) register their
        // specialized methods under the arena's qualified name for the
        // specialization, not under the plain mangled base.  Without this
        // lookup the fallback below returns the template's return type,
        // which, for a method declared `-> Self` (just `Map`), is the
        // template struct, and callers emit a call to the unspecialized
        // symbol that the linker can't resolve.
        if (scope.scope_generic_args.length > 0) {
            const spec_ref: TypeRef = this.lookup_type_by_sym(lookup_sym);
            if (spec_ref.is_valid()) {
                const spec_qn: SymbolStr = this.ctx.decl_index.lookup_type_name(spec_ref);
                if (spec_qn.is_valid() && !spec_qn.equals(lookup_sym)) {
                    const qn_ret: TypeRef = this.ctx.decl_index.lookup_method_return(
                        spec_qn, scope.member_name);
                    if (qn_ret.is_valid()) {
                        scope.set_resolved_type(qn_ret);
                        this.pin_scope_callee_combined(call, spec_qn, scope.member_name);
                        return qn_ret;
                    }
                }
            }
        }
        // Try base name if we used a specialized one (e.g., Pair::new)
        if (lookup_sym.id != scope.scope_name.id) {
            const base_ret: TypeRef = this.lookup_method_return(
                scope.scope_name, scope.member_name);
            if (base_ret.is_valid()) {
                const resolved: TypeRef = this.try_resolve_generic_return(
                    base_ret, scope.scope_name, scope.member_name, scope);
                scope.set_resolved_type(resolved);
                this.pin_scope_callee_combined(
                    call, scope.scope_name, scope.member_name);
                return resolved;
            }
        }
        return TypeRef::invalid();
    }

    /// Try resolving Scope::Member as a type-based construct:
    ///   - Static method via DI-qualified name (FieldInfo::new cross-module)
    ///   - Enum variant constructor (Option::Some, CompileMode::Raw)
    try_resolve_type_or_variant(mut &this, scope: ScopeResolutionNode*,
                                lookup_sym: SymbolStr,
                                call: CallExprNode*) -> TypeRef {
        const type_ref: TypeRef = this.lookup_type_by_sym(lookup_sym);
        if (!type_ref.is_valid()) { return TypeRef::invalid(); }

        // Try static method using the type's DI-registered qualified name.
        // Handles cross-module calls like FieldInfo::new() where the bare
        // name doesn't match the registered qualified name.
        const di_name: SymbolStr = this.ctx.decl_index.lookup_type_name(type_ref);
        if (di_name.is_valid()) {
            const di_method_ret: TypeRef = this.lookup_method_return(
                di_name, scope.member_name);
            if (di_method_ret.is_valid()) {
                const resolved: TypeRef = this.try_resolve_generic_return(
                    di_method_ret, scope.scope_name, scope.member_name, scope);
                scope.set_resolved_type(resolved);
                this.pin_scope_callee_combined(call, di_name, scope.member_name);
                return resolved;
            }
        }
        // No method found; fall back to enum-variant constructor if (and
        // only if) the type IS an enum.  Without this gate, primitive
        // aliases registered in the decl_index (e.g. `float` -> `f64`,
        // injected by `pass_registry.cryo:878`) would swallow free
        // module-qualified function calls like `float::write_f64_buffer(...)`
        // sema would interpret them as `f64::write_f64_buffer(...)`,
        // miss the (non-existent) method, fall through to "constructor"
        // treatment, and return `f64` as the call's type.  Letting the
        // module-function resolver downstream try this scope instead
        // resolves to the real free function.
        mut concrete_t: Type* = this.arena.lookup(type_ref.id);
        if (concrete_t != null && concrete_t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = concrete_t as InstantiatedType*;
            if (inst.has_resolved_type()) {
                concrete_t = this.arena.lookup(inst.resolved_type.id);
            }
        }
        if (concrete_t == null || concrete_t.kind != TypeKind::Enum) {
            return TypeRef::invalid();
        }
        const promoted: TypeRef = this.promote_to_expected_instantiation(type_ref);
        scope.set_resolved_type(promoted);
        return promoted;
    }

    /// Try resolving Scope::Member as a module-qualified function call
    /// (e.g., intrinsics::frexp, math::sqrt).  Only attempts this if the
    /// scope name is NOT a known type (prevents false matches for enum
    /// variant calls like IoResult::Ok).
    try_resolve_module_function(mut &this, scope: ScopeResolutionNode*,
                                 call: CallExprNode*) -> TypeRef {
        // The earlier strategies already exhausted "type::method" and
        // "type::variant" lookups for any genuine type carrier.  If the
        // scope happens to ALSO resolve to a type (often via the
        // primitive-keyword aliases registered in `pass_registry.cryo`,
        // `float` -> `f64`, `int` -> `i32`, etc.), that doesn't preclude a
        // module of the same bare name living alongside it.  Stdlib's
        // `fmt::float` namespace + the `float`-keyword alias hit exactly
        // this shape: `float::write_f64_buffer(...)` should resolve to
        // the module function, not be silently swallowed because `float`
        // also names a type alias.  Reaching this strategy means none of
        // the earlier type-based interpretations matched, so it's safe
        // to try a module-function lookup unconditionally.
        const q_ret: TypeRef = this.resolve_module_qualified_function(
            scope.scope_name, scope.member_name, call);
        if (q_ret.is_valid()) {
            scope.set_resolved_type(q_ret);
            return q_ret;
        }
        return TypeRef::invalid();
    }

    /// Try resolving Scope::Member as a CImport alias-qualified function.
    /// Looks up "alias::member" directly in the DeclIndex.
    try_resolve_cimport_function(mut &this, scope: ScopeResolutionNode*,
                                  call: CallExprNode*) -> TypeRef {
        const scope_str: string = this.intern.resolve(scope.scope_name);
        const member_str: string = this.intern.resolve(scope.member_name);
        const qualified: string = scope_str + "::" + member_str;
        const q_sym: SymbolStr = this.ctx.intern(qualified);

        const ret: TypeRef = this.ctx.decl_index.lookup_func_return(q_sym);
        if (ret.is_valid()) {
            scope.set_resolved_type(ret);
            this.pin_scope_callee_qsym(call, q_sym);
            return ret;
        }
        return TypeRef::invalid();
    }

    /// Resolve generic args on a scope name (e.g., Pair<int>) to build
    /// the specialized type name (e.g., Pair_i32) for decl_index lookup.
    resolve_generic_scope_name(&this, base_name: SymbolStr,
                                generic_args: TypeAnnotation*[]) -> SymbolStr {
        if (this.ctx.type_resolver == null) { return SymbolStr::empty(); }

        mut res_ctx: ResolutionContext = ResolutionContext::new(
            this.ctx.source_file, "");
        mut arg_refs: TypeRef[] = [];
        for (mut i: i64 = 0; i < generic_args.length; i++) {
            const arg_ref: TypeRef = this.ctx.type_resolver.resolve(
                generic_args[i], &res_ctx);
            if (!arg_ref.is_valid()) { return SymbolStr::empty(); }
            arg_refs.push(arg_ref);
        }

        // Fill in trailing template defaults (e.g. `Box<T, A = GlobalAlloc>`)
        // so that a short call site like `Box<MyT>::new(...)` mangles to
        // the same spec key the ASTSpecializer / monomorphizer registered
        // under (`Box<MyT, GlobalAlloc>::new`).  Without this, the spec
        // lookup misses and sema falls through to E0233 before the
        // monomorphizer's late-binding path can rescue the call;
        // any allocator-generic type (Box, Rc, Array, HashMap, String,
        // CString, PathBuf, ...) used at a fresh `Type<T>::method(...)`
        // call site would otherwise force callers to spell the full
        // `Type<T, GlobalAlloc>::method(...)` form just to compile.
        //
        // Templates index by qualified name (e.g. `std::alloc::box::Box`),
        // not bare `Box`, so resolve through `lookup_type_by_sym` first to
        // pick up the cross-module scope chain; same path other sema
        // helpers use to find a type from a bare name.
        if (this.ctx.generic_registry != null) {
            // Look up the template entry.  Templates register under their
            // fully qualified name (e.g. `std::alloc::box::Box`), but call
            // sites use the bare name (`Box`).  The decl_index keeps a
            // bare->qualified mapping (populated by `register_name_mapping`
            // for every type declaration), so consult that first.  Fall
            // back to ctx-qualification and the resolver scope chain.
            mut entry: TemplateEntry* =
                this.ctx.generic_registry.get_template(base_name);
            if (entry == null) {
                const di_qual: SymbolStr = this.ctx.decl_index.resolve_qualified(base_name);
                if (di_qual.is_valid() && !di_qual.equals(base_name)) {
                    entry = this.ctx.generic_registry.get_template(di_qual);
                }
            }
            if (entry == null) {
                const qualified: SymbolStr = this.ctx.qualify_symbol_sym(base_name);
                if (!qualified.equals(base_name)) {
                    entry = this.ctx.generic_registry.get_template(qualified);
                }
            }
            if (entry == null) {
                const cross_sym: SymbolStr = this.resolve_cross_module_name(base_name);
                if (cross_sym.is_valid()) {
                    entry = this.ctx.generic_registry.get_template(cross_sym);
                }
            }
            if (entry != null && arg_refs.length < entry.param_count) {
                arg_refs = this.ctx.type_resolver.expand_default_type_args(
                    entry, arg_refs, &res_ctx);
            }
        }

        // Centralized specialized-identifier mangling; same encoding the
        // ASTSpecializer used when registering the clone, so lookups match.
        const base_qname: QualifiedName = QualifiedName::from_symbol(base_name);
        return MangledName::specialized_identifier(
            this.intern, this.arena, base_qname, arg_refs);
    }

    /// When a scope call (e.g. Result::ok) returns a generic InstantiatedType
    /// (Result<T, E>), try to resolve it to the concrete specialized return
    /// type.  Concrete type args come from two sources, in priority order:
    ///   1. Explicit scope generic args on the call: `HashMap<string, u32>::new()`
    ///      binds K=string, V=u32 at the call site; the scope already carries
    ///      resolved annotations for them, so the method return type gets
    ///      rewritten into a concrete InstantiatedType with those exact args.
    ///   2. `expected_type` hint from the enclosing variable declaration:
    ///      `const x: Result<int, string> = Result::ok(42)`, used when the
    ///      call has no explicit scope args.
    ///
    /// Without (1) the return type stays as the template's self-reference
    /// (e.g. `HashMap<K, V>`) and codegen hits an unresolved InstantiatedType
    /// that no downstream fallback can recover from.
    try_resolve_generic_return(mut &this, ret: TypeRef,
                                scope_name: SymbolStr,
                                member_name: SymbolStr,
                                scope: ScopeResolutionNode*) -> TypeRef {
        // Check that the return type is an unresolved InstantiatedType
        const ret_t: Type* = this.arena.lookup(ret.id);
        if (ret_t == null || ret_t.kind != TypeKind::InstantiatedType) { return ret; }
        const ret_inst: InstantiatedType* = ret_t as InstantiatedType*;
        if (ret_inst.is_resolved()) { return ret; }

        // Priority 1: explicit scope generic args, `Type<A, B>::method()`.
        if (scope != null && scope.scope_generic_args.length > 0
                && scope.scope_generic_args.length == ret_inst.type_args.length) {
            mut resolved_args: TypeRef[] = [];
            mut all_valid: boolean = true;
            mut res_ctx: ResolutionContext = ResolutionContext::new(
                this.ctx.source_file, "");
            for (mut i: i64 = 0; i < scope.scope_generic_args.length; i++) {
                const arg_ref: TypeRef = this.ctx.type_resolver.resolve(
                    scope.scope_generic_args[i], &res_ctx);
                if (!arg_ref.is_valid()) { all_valid = false; break; }
                resolved_args.push(arg_ref);
            }
            if (all_valid) {
                // Build a concrete InstantiatedType for (generic_base, explicit args).
                // Goes through the registry cache so the monomorphizer's
                // `set_resolved_type` call is visible to this TypeRef.
                return this.ctx.generic_registry.instantiate(
                    ret_inst.generic_base, resolved_args);
            }
        }

        // Priority 2: fall back to expected_type from the enclosing decl.
        if (!this.expected_type.is_valid()) { return ret; }

        // Check that expected_type is a concrete InstantiatedType with the same base.
        // Dereference TypeAlias first (e.g., StringPair -> Pair<string>).
        mut exp_ref: TypeRef = this.expected_type;
        mut exp_t: Type* = this.arena.lookup(exp_ref.id);
        if (exp_t != null && exp_t.kind == TypeKind::TypeAlias) {
            const alias: TypeAliasType* = exp_t as TypeAliasType*;
            if (alias.has_target()) {
                exp_ref = alias.target;
                exp_t = this.arena.lookup(exp_ref.id);
            }
        }
        if (exp_t == null || exp_t.kind != TypeKind::InstantiatedType) { return ret; }
        const exp_inst: InstantiatedType* = exp_t as InstantiatedType*;

        // Same generic base type? (e.g., both Result)
        if (ret_inst.generic_base.id != exp_inst.generic_base.id) { return ret; }

        // Centralized specialized-identifier mangling.  See note on
        // resolve_generic_scope_name above; never roll your own.
        const scope_qname: QualifiedName = QualifiedName::from_symbol(scope_name);
        const spec_sym: SymbolStr = MangledName::specialized_identifier(
            this.intern, this.arena, scope_qname, exp_inst.type_args);

        // Look up the specialized method return type
        const spec_ret: TypeRef = this.lookup_method_return(spec_sym, member_name);
        if (spec_ret.is_valid()) { return spec_ret; }

        // Fallback: return the expected type itself if the base matches.
        // The specialized struct exists (it was monomorphized) but the method
        // might not be registered yet; use the expected type directly.
        return this.expected_type;
    }

    /// When an enum variant constructor returns the base type (e.g., Optional)
    /// but expected_type is a specialization (e.g., Optional<string>), promote
    /// to the specialized type.  This lets codegen see the concrete instantiation.
    promote_to_expected_instantiation(&this, found: TypeRef) -> TypeRef {
        if (!this.expected_type.is_valid()) { return found; }

        // Dereference TypeAlias on expected_type (e.g., MyOptional -> Optional<string>)
        mut exp_ref: TypeRef = this.expected_type;
        mut exp_t: Type* = this.arena.lookup(exp_ref.id);
        if (exp_t != null && exp_t.kind == TypeKind::TypeAlias) {
            const alias: TypeAliasType* = exp_t as TypeAliasType*;
            if (alias.has_target()) {
                exp_ref = alias.target;
                exp_t = this.arena.lookup(exp_ref.id);
            }
        }
        if (exp_t == null) { return found; }

        // Standard case: expected_type is still an InstantiatedType carrying
        // the same generic_base as `found`; return it directly.
        if (exp_t.kind == TypeKind::InstantiatedType) {
            const exp_inst: InstantiatedType* = exp_t as InstantiatedType*;
            if (exp_inst.generic_base.equals(found)) {
                return exp_ref;
            }
            return found;
        }

        // Expected_type was already collapsed to the concrete specialization
        // (Enum/Struct/Class) via `resolved_type`.  Callers that set
        // expected_type straight from a monomorphized slot land here.  Find
        // an arena InstantiatedType with generic_base == found whose resolved
        // type matches exp_ref and return that specialization directly;
        // that way codegen's enum-variant branch reaches an Enum whose
        // variants were populated by the monomorphizer instead of bottoming
        // out on the (empty-variants) template.
        if (exp_t.kind == TypeKind::Enum || exp_t.kind == TypeKind::Struct
                || exp_t.kind == TypeKind::Class) {
            const count: i64 = this.arena.type_count();
            for (mut i: i64 = 0; i < count; i++) {
                const t: Type* = this.arena.types[i];
                if (t == null || t.kind != TypeKind::InstantiatedType) { continue; }
                const inst: InstantiatedType* = t as InstantiatedType*;
                if (!inst.generic_base.equals(found)) { continue; }
                if (!inst.has_resolved_type()) { continue; }
                if (inst.resolved_type.id == exp_ref.id) {
                    return exp_ref;
                }
            }
        }

        return found;
    }

    /// Walk a TypeRef past Pointer/Reference/InstantiatedType wrappers to its
    /// base Type*.  Returns null if the chain bottoms out at an unresolved
    /// InstantiatedType or a missing arena entry.  Mirrors the unwrap loops
    /// in check_field_access / resolve_member_access so visibility comparison
    /// runs on the same canonical form.
    unwrap_to_base_type(&this, ty: TypeRef) -> Type* {
        mut t: Type* = this.arena.lookup(ty.id);
        mut depth: i32 = 0;
        while (t != null && depth < 5) {
            match (t.kind) {
                TypeKind::Pointer => {
                    const pt: PointerType* = t as PointerType*;
                    t = this.arena.lookup(pt.pointee.id);
                }
                TypeKind::Reference => {
                    const rt: ReferenceType* = t as ReferenceType*;
                    t = this.arena.lookup(rt.referent.id);
                }
                TypeKind::InstantiatedType => {
                    const it: InstantiatedType* = t as InstantiatedType*;
                    if (!it.has_resolved_type()) { return null; }
                    t = this.arena.lookup(it.resolved_type.id);
                }
                _ => { return t; }
            }
            depth += 1;
        }
        return t;
    }

    /// If `field_name` on `recv_type` resolves to a private field, emit
    /// E0353_PRIVATE_ACCESS unless we're inside a method body of the type
    /// that declares it.  No-op when the field is public, the receiver
    /// is not a struct/class, or the field is not found (the missing-field
    /// error path already diagnosed it).
    enforce_field_visibility(mut &this, recv_type: TypeRef,
                              field_name: SymbolStr, span: SourceSpan) -> void {
        const base: Type* = this.unwrap_to_base_type(recv_type);
        if (base == null) { return; }

        mut field: FieldInfo* = null;
        mut declaring_t: Type* = null;
        mut declaring_name: string = "";

        if (base.kind == TypeKind::Struct) {
            mut st: StructType* = base as StructType*;
            field = st.get_field(field_name);
            if (field != null) {
                declaring_t = base;
                declaring_name = st.display_name();
            }
        } else if (base.kind == TypeKind::Class) {
            mut current: ClassType* = base as ClassType*;
            while (current != null) {
                field = current.get_field(field_name);
                if (field != null) {
                    declaring_t = current as Type*;
                    declaring_name = current.display_name();
                    break;
                }
                if (current.has_base && current.base_class.is_valid()) {
                    const parent_t: Type* = this.arena.lookup(current.base_class.id);
                    if (parent_t != null && parent_t.kind == TypeKind::Class) {
                        current = parent_t as ClassType*;
                    } else {
                        current = null;
                    }
                } else {
                    current = null;
                }
            }
        }

        if (field == null) { return; }
        if (field.is_public) { return; }

        // Allow access when we're inside a method of the declaring type.
        // current_owner_type stays valid for static methods too, where
        // `this_type` is invalid by design.  For `protected` members the
        // access is also allowed from subclasses of the declaring type.
        if (this.current_owner_type.is_valid()) {
            const owner: Type* = this.unwrap_to_base_type(this.current_owner_type);
            if (owner != null && declaring_t != null) {
                if (owner.id == declaring_t.id) { return; }
                if (field.is_protected && this.is_subclass_of(owner, declaring_t.id)) {
                    return;
                }
            }
        }

        const vis_word: string = if (field.is_protected) { "protected" } else { "private" };
        const field_str: string = this.intern.resolve(field_name);
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0353_PRIVATE_ACCESS,
            format("field `%s` of `%s` is %s", field_str, declaring_name, vis_word));
        diag = diag.at_with_label(span,
            format("%s field accessed outside `%s`", vis_word, declaring_name));
        this.ctx.emit_diagnostic(diag);
    }

    /// Method-call counterpart to enforce_field_visibility.  Searches the
    /// receiver's Struct/Class for the named method (walking the class
    /// inheritance chain for Class receivers) and emits E0353 if the matched
    /// MethodInfo is private and we're not inside that declaring type.
    enforce_method_visibility(mut &this, recv_type: TypeRef,
                               method_name: SymbolStr, span: SourceSpan) -> void {
        const base: Type* = this.unwrap_to_base_type(recv_type);
        if (base == null) { return; }

        mut method: MethodInfo* = null;
        mut declaring_t: Type* = null;
        mut declaring_name: string = "";

        if (base.kind == TypeKind::Struct) {
            mut st: StructType* = base as StructType*;
            method = st.get_method(method_name);
            if (method != null) {
                declaring_t = base;
                declaring_name = st.display_name();
            }
        } else if (base.kind == TypeKind::Class) {
            mut current: ClassType* = base as ClassType*;
            while (current != null) {
                method = current.get_method(method_name);
                if (method != null) {
                    declaring_t = current as Type*;
                    declaring_name = current.display_name();
                    break;
                }
                if (current.has_base && current.base_class.is_valid()) {
                    const parent_t: Type* = this.arena.lookup(current.base_class.id);
                    if (parent_t != null && parent_t.kind == TypeKind::Class) {
                        current = parent_t as ClassType*;
                    } else {
                        current = null;
                    }
                } else {
                    current = null;
                }
            }
        }

        if (method == null) { return; }
        if (method.is_public) { return; }

        // Inside the declaring type, or - for `protected` methods - inside
        // a subclass of it, the call is allowed.
        if (this.current_owner_type.is_valid()) {
            const owner: Type* = this.unwrap_to_base_type(this.current_owner_type);
            if (owner != null && declaring_t != null) {
                if (owner.id == declaring_t.id) { return; }
                if (method.is_protected && this.is_subclass_of(owner, declaring_t.id)) {
                    return;
                }
            }
        }

        const vis_word: string = if (method.is_protected) { "protected" } else { "private" };
        const method_str: string = this.intern.resolve(method_name);
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0353_PRIVATE_ACCESS,
            format("method `%s` of `%s` is %s", method_str, declaring_name, vis_word));
        diag = diag.at_with_label(span,
            format("%s method called outside `%s`", vis_word, declaring_name));
        this.ctx.emit_diagnostic(diag);
    }

    /// True when `candidate` is `ancestor_id` itself or descends from it
    /// through the class `base_class` chain.  Used by visibility
    /// enforcement to permit `protected` access from subclasses.  Depth
    /// guarded against cyclic inheritance graphs.
    is_subclass_of(mut &this, candidate: Type*, ancestor_id: u64) -> boolean {
        mut cur: Type* = candidate;
        mut depth: i32 = 0;
        while (cur != null && depth < 32) {
            if (cur.id == ancestor_id) { return true; }
            if (cur.kind != TypeKind::Class) { return false; }
            const cc: ClassType* = cur as ClassType*;
            if (cc.has_base && cc.base_class.is_valid()) {
                cur = this.arena.lookup(cc.base_class.id);
            } else {
                return false;
            }
            depth += 1;
        }
        return false;
    }

    resolve_member_access(mut &this, member: MemberAccessNode*) -> TypeRef {
        const obj_type: TypeRef = this.resolve_expr(member.object);
        // Input invalid -> upstream error already emitted, stay silent
        if (!obj_type.is_valid()) { return TypeRef::invalid(); }

        // Tuple positional access: `t.0`, `t.1`. The parser interns the
        // numeric token's lexeme as the member SymbolStr (same field as
        // named members); we branch on receiver kind here. Walks past
        // pointer/reference/instantiation wrappers so `(&t).0` also works.
        mut walk_ty: TypeRef = obj_type;
        mut walk_t: Type* = this.arena.lookup(walk_ty.id);
        mut depth: i32 = 0;
        while (walk_t != null && depth < 5) {
            match (walk_t.kind) {
                TypeKind::Pointer => {
                    const pt: PointerType* = walk_t as PointerType*;
                    walk_ty = pt.pointee;
                    walk_t = this.arena.lookup(walk_ty.id);
                }
                TypeKind::Reference => {
                    const rt: ReferenceType* = walk_t as ReferenceType*;
                    walk_ty = rt.referent;
                    walk_t = this.arena.lookup(walk_ty.id);
                }
                TypeKind::InstantiatedType => {
                    const it: InstantiatedType* = walk_t as InstantiatedType*;
                    if (!it.has_resolved_type()) { break; }
                    walk_ty = it.resolved_type;
                    walk_t = this.arena.lookup(walk_ty.id);
                }
                _ => { break; }
            }
            depth += 1;
        }
        if (walk_t != null && walk_t.kind == TypeKind::Tuple) {
            const tup: TupleType* = walk_t as TupleType*;
            const member_str: string = this.intern.resolve(member.member);
            const idx: i64 = parse_tuple_index(member_str);
            const m_span: SourceSpan = if (member.member_span.has_location()) {
                member.member_span
            } else {
                member.span
            };
            if (idx < 0) {
                this.ctx.emit_error_at(ErrorCode::E0204_UNDEFINED_FIELD,
                    format("expected a tuple index after `.`, got `%s`", member_str),
                    m_span);
                return TypeRef::invalid();
            }
            if (idx >= tup.elements.length) {
                this.ctx.emit_error_at(ErrorCode::E0204_UNDEFINED_FIELD,
                    format("tuple index %lld is out of bounds for tuple with %lld elements",
                           idx, tup.elements.length),
                    m_span);
                return TypeRef::invalid();
            }
            return tup.elements[idx];
        }

        // Struct/class field access via TypeChecker
        const result: TypeCheckResult = this.checker.check_field_access(
            obj_type, member.member);
        if (result.success) {
            const acc_span: SourceSpan = if (member.member_span.has_location()) {
                member.member_span
            } else {
                member.span
            };
            this.enforce_field_visibility(obj_type, member.member, acc_span);
            return result.result_type;
        }

        // Fall back to method lookup with inheritance chain
        const type_sym: SymbolStr = this.lookup_type_sym(obj_type);
        if (type_sym.is_valid()) {
            const method_ret: TypeRef = this.lookup_method_with_inheritance(
                obj_type, type_sym, member.member);
            if (method_ret.is_valid()) {
                const acc_span: SourceSpan = if (member.member_span.has_location()) {
                    member.member_span
                } else {
                    member.span
                };
                this.enforce_method_visibility(obj_type, member.member, acc_span);
                return method_ret;
            }

            // Both field and method lookup failed on a valid object; emit
            const type_name: string = this.intern.resolve(type_sym);
            const member_name: string = this.intern.resolve(member.member);
            const m_span: SourceSpan = if (member.member_span.has_location()) {
                member.member_span
            } else {
                member.span
            };
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0204_UNDEFINED_FIELD,
                format("no field or method `%s` on type `%s`",
                    member_name, type_name));
            diag = diag.at_with_label(m_span, "unknown field or method");
            const cands: string[] = this.collect_struct_or_class_member_names(obj_type);
            diag = this.attach_did_you_mean(diag, member_name, cands,
                                            "field or method", m_span);
            this.ctx.emit_diagnostic(diag);
        }

        return TypeRef::invalid();
    }

    resolve_array_access(mut &this, access: ArrayAccessNode*) -> TypeRef {
        const array_type: TypeRef = this.resolve_expr(access.array);
        const index_type: TypeRef = this.resolve_expr(access.index);
        // Input invalid -> upstream error already emitted, stay silent
        if (!array_type.is_valid()) { return TypeRef::invalid(); }

        // Tuple bracket indexing: `t[0]`, `t[1]`. Tuples have a fixed,
        // statically-known shape, so the index MUST be an integer literal
        // and we can bounds-check at compile time. Walks past pointer/
        // reference/instantiation wrappers so `(&t)[0]` works too.
        mut walk_ty: TypeRef = array_type;
        mut walk_t: Type* = this.arena.lookup(walk_ty.id);
        mut depth: i32 = 0;
        while (walk_t != null && depth < 5) {
            if (walk_t.kind == TypeKind::Pointer) {
                const pt: PointerType* = walk_t as PointerType*;
                walk_ty = pt.pointee;
                walk_t = this.arena.lookup(walk_ty.id);
            } else if (walk_t.kind == TypeKind::Reference) {
                const rt: ReferenceType* = walk_t as ReferenceType*;
                walk_ty = rt.referent;
                walk_t = this.arena.lookup(walk_ty.id);
            } else if (walk_t.kind == TypeKind::InstantiatedType) {
                const it: InstantiatedType* = walk_t as InstantiatedType*;
                if (!it.has_resolved_type()) { break; }
                walk_ty = it.resolved_type;
                walk_t = this.arena.lookup(walk_ty.id);
            } else {
                break;
            }
            depth += 1;
        }
        if (walk_t != null && walk_t.kind == TypeKind::Tuple) {
            const tup: TupleType* = walk_t as TupleType*;
            const idx: i64 = sema_const_int_index(access.index);
            if (idx < 0) {
                this.ctx.emit_error_at(ErrorCode::E0200_TYPE_MISMATCH,
                    "tuple index must be a non-negative integer literal; runtime indices are not supported on tuples",
                    access.span);
                return TypeRef::invalid();
            }
            if (idx >= tup.elements.length) {
                this.ctx.emit_error_at(ErrorCode::E0204_UNDEFINED_FIELD,
                    format("tuple index %lld is out of bounds for tuple with %lld elements",
                           idx, tup.elements.length),
                    access.span);
                return TypeRef::invalid();
            }
            return tup.elements[idx];
        }

        const result: TypeCheckResult = this.checker.check_index_access(
            array_type, index_type);
        if (result.success) { return result.result_type; }

        // Valid array but index check failed; emit the TypeChecker's message
        if (result.error_message != null && strlen(result.error_message) > 0) {
            this.ctx.emit_error_at(ErrorCode::E0200_TYPE_MISMATCH,
                result.error_message,
                access.span);
        }
        return TypeRef::invalid();
    }

    /// True when a cast crosses between a memory aggregate (struct / class /
    /// tuple / array) and a scalar-or-pointer type.  Such a cast has no valid
    /// LLVM lowering: `codegen_cast` falls through to an aggregate `bitcast`
    /// that the verifier rejects, surfacing as an E0900 backend crash instead
    /// of a clean diagnostic.  int<->pointer, pointer<->pointer, and the
    /// numeric / enum / char / bool casts all have real lowerings and stay
    /// legal (section 2.9 makes `as` the programmer's responsibility).
    is_aggregate_scalar_cast(&this, from: TypeRef, to: TypeRef) -> boolean {
        mut f: Type* = this.arena.lookup(from.id);
        mut t: Type* = this.arena.lookup(to.id);
        if (f == null || t == null) { return false; }
        if (f.kind == TypeKind::InstantiatedType) {
            const fi: InstantiatedType* = f as InstantiatedType*;
            if (!fi.has_resolved_type()) { return false; }
            f = this.arena.lookup(fi.resolved_type.id);
        }
        if (t.kind == TypeKind::InstantiatedType) {
            const ti: InstantiatedType* = t as InstantiatedType*;
            if (!ti.has_resolved_type()) { return false; }
            t = this.arena.lookup(ti.resolved_type.id);
        }
        if (f == null || t == null) { return false; }
        // `Class` is intentionally NOT an aggregate here: a class instance is
        // a heap pointer at the LLVM level, so `Class` <-> pointer / integer
        // lowers to a valid pointercast / ptrtoint (e.g. the `this as
        // Visitor*` upcast used throughout the compiler).  Only by-value
        // aggregates (struct / tuple / fixed array) have no scalar lowering.
        const f_agg: boolean = f.kind == TypeKind::Struct
                            || f.kind == TypeKind::Tuple  || f.kind == TypeKind::Array;
        const t_agg: boolean = t.kind == TypeKind::Struct
                            || t.kind == TypeKind::Tuple  || t.kind == TypeKind::Array;
        const f_scl: boolean = f.kind == TypeKind::Int    || f.kind == TypeKind::Float
                            || f.kind == TypeKind::Bool   || f.kind == TypeKind::Char
                            || f.kind == TypeKind::String || f.kind == TypeKind::Pointer
                            || f.kind == TypeKind::Reference || f.kind == TypeKind::Enum;
        const t_scl: boolean = t.kind == TypeKind::Int    || t.kind == TypeKind::Float
                            || t.kind == TypeKind::Bool   || t.kind == TypeKind::Char
                            || t.kind == TypeKind::String || t.kind == TypeKind::Pointer
                            || t.kind == TypeKind::Reference || t.kind == TypeKind::Enum;
        return (f_agg && t_scl) || (f_scl && t_agg);
    }

    resolve_cast(mut &this, cast: CastExprNode*) -> TypeRef {
        const from_ty: TypeRef = this.resolve_expr(cast.expression);
        // Resolve the target type annotation if TypeResolution didn't reach it
        // (e.g., cast used as an initializer rather than a standalone expression).
        if (!cast.has_resolved_target() && cast.target_annotation != null
                && this.ctx.type_resolver != null) {
            // Allow `e as typeof(x)`: prime the operand's type before the
            // TypeResolver reads it.
            this.prime_typeof_annotation(cast.target_annotation);
            mut res_ctx: ResolutionContext = ResolutionContext::new(
                this.ctx.source_file, "");
            const target: TypeRef = this.ctx.type_resolver.resolve(
                cast.target_annotation, &res_ctx);
            if (target.is_valid()) {
                cast.set_resolved_target(target);
            }
        }
        const to_ty: TypeRef = cast.resolved_target;
        // Reject casts with no valid representation (aggregate <-> scalar):
        // these have no LLVM lowering and otherwise crash the backend with a
        // bare E0900 verifier failure.  Skip non-concrete (generic) operands.
        if (from_ty.is_valid() && to_ty.is_valid()
            && this.arg_type_is_concrete(from_ty)
            && this.arg_type_is_concrete(to_ty)
            && this.is_aggregate_scalar_cast(from_ty, to_ty)) {
            this.ctx.emit_error_at(
                ErrorCode::E0208_INVALID_CAST,
                "invalid cast between an aggregate type (struct/class/tuple/array) and a scalar or pointer: there is no valid representation for this conversion",
                cast.span);
        }
        return cast.resolved_target;
    }

    resolve_if_expr(mut &this, if_expr: IfExprNode*) -> TypeRef {
        this.resolve_expr(if_expr.condition);
        const then_type: TypeRef = this.resolve_expr(if_expr.then_expr);
        const else_type: TypeRef = this.resolve_expr(if_expr.else_expr);
        if (then_type.is_valid()) { return then_type; }
        if (else_type.is_valid()) { return else_type; }
        return TypeRef::invalid();
    }

    resolve_ternary(mut &this, ternary: TernaryExprNode*) -> TypeRef {
        this.resolve_expr(ternary.condition);
        const true_type: TypeRef = this.resolve_expr(ternary.true_expr);
        const false_type: TypeRef = this.resolve_expr(ternary.false_expr);
        if (true_type.is_valid()) { return true_type; }
        if (false_type.is_valid()) { return false_type; }
        return TypeRef::invalid();
    }

    resolve_match_expr(mut &this, match_expr: MatchExprNode*) -> TypeRef {
        const subject_type: TypeRef = this.resolve_expr(match_expr.subject);
        this.check_duplicate_default_arm(match_expr.arms);

        // Propagate the outer expected_type (from `const x: T = match ...`,
        // return types, etc.) into each arm's last expression so integer
        // literals like `-1` adopt the declared type instead of defaulting
        // to i32.  Without this, codegen's phi sees mixed arm types (e.g.,
        // i64 for one arm's bound variable vs i32 for another arm's literal)
        // and fails verification.
        const outer_expected: TypeRef = this.expected_type;

        mut result_type: TypeRef = TypeRef::invalid();
        for (mut i: i64 = 0; i < match_expr.arms.length; i++) {
            const arm: MatchArmNode* = match_expr.arms[i];
            if (arm == null || arm.body == null) { continue; }

            const save: i64 = this.save_scope();
            this.bind_arm_patterns(arm, subject_type);

            const body_node: ASTNode* = arm.body as ASTNode*;
            if (body_node.kind == NodeKind::BlockStatement) {
                const block: BlockStmtNode* = arm.body as BlockStmtNode*;
                const last_idx: i64 = block.statements.length - 1;
                for (mut j: i64 = 0; j < block.statements.length; j++) {
                    // For the final statement of the block (the arm's
                    // yielded value), push the outer expected_type hint so
                    // integer/float literals resolve to the declared type.
                    if (j == last_idx && outer_expected.is_valid()) {
                        this.expected_type = outer_expected;
                    }
                    this.dispatch_stmt(block.statements[j]);
                    if (j == last_idx) {
                        this.expected_type = outer_expected;
                    }
                }
                // Infer arm type from the last expression statement
                if (!result_type.is_valid() && block.statements.length > 0) {
                    const last: StatementNode* =
                        block.statements[block.statements.length - 1];
                    const last_node: ASTNode* = last as ASTNode*;
                    if (last_node.kind == NodeKind::ExpressionStatement) {
                        const es: ExprStmtNode* = last as ExprStmtNode*;
                        if (es.expression != null &&
                            es.expression.has_resolved_type()) {
                            result_type = es.expression.resolved_type;
                        }
                    }
                }
            } else {
                this.dispatch_stmt(arm.body);
            }

            this.restore_scope(save);
        }

        // Restore caller's expected_type and prefer its hint over our own
        // inference; a more specific context-driven type wins.
        this.expected_type = outer_expected;

        // Exhaustiveness gate: same rule whether match is used as a
        // statement or as an expression.
        this.check_match_exhaustive(match_expr.subject, subject_type,
            match_expr.arms, match_expr.span);
        this.check_range_patterns(match_expr.arms, subject_type);

        if (outer_expected.is_valid()) {
            return outer_expected;
        }
        return result_type;
    }

    // Try operator (`expr?`) lowering

    /// Classify a type for the `?` operator: returns 1 if `ty` unwraps to a
    /// `Result`-shaped enum (variants `Ok` + `Err`), 2 if it unwraps to an
    /// `Option`-shaped enum (`Some` + `None`), 0 otherwise.  Shape is keyed
    /// on variant names rather than the enum's (possibly mangled or
    /// specialized) name, so it works for `Result_i32_string` etc.
    enum_try_shape(&this, ty: TypeRef) -> i32 {
        const e: Type* = this.unwrap_to_enum(ty);
        if (e == null || e.kind != TypeKind::Enum) { return 0; }
        const et: EnumType* = e as EnumType*;
        if (et.get_variant(this.intern.intern("Ok")) != null
                && et.get_variant(this.intern.intern("Err")) != null) {
            return 1;
        }
        if (et.get_variant(this.intern.intern("Some")) != null
                && et.get_variant(this.intern.intern("None")) != null) {
            return 2;
        }
        return 0;
    }

    /// Build the `match` AST that `expr?` desugars to.  `is_result` picks
    /// the `Result` (Ok/Err) shape over the `Option` (Some/None) shape.
    ///
    ///   match (operand) {
    ///       Result::Ok(v)  => { v }
    ///       Result::Err(e) => { return Result::Err(e); }
    ///   }
    ///
    /// The operand becomes the match scrutinee (so it is evaluated exactly
    /// once); the failure arm early-returns from the enclosing function.
    build_try_desugar(mut &this, node: TryExprNode*, is_result: boolean) -> MatchExprNode* {
        const span: SourceSpan = node.span;
        g_try_counter += 1;

        const enum_name: SymbolStr =
            this.intern.intern(if (is_result) { "Result" } else { "Option" });
        const ok_variant: SymbolStr =
            this.intern.intern(if (is_result) { "Ok" } else { "Some" });
        const err_variant: SymbolStr =
            this.intern.intern(if (is_result) { "Err" } else { "None" });
        const ok_bind: SymbolStr =
            this.intern.intern(format("__cryo_try_%u", g_try_counter));

        mut match_expr: MatchExprNode* = new MatchExprNode(node.operand, span);

        // Success arm:  Ok(v) => { v }   /   Some(v) => { v }
        mut ok_pat: EnumPatternNode* = new EnumPatternNode(span);
        ok_pat.set_enum_name(enum_name);
        ok_pat.set_variant_name(ok_variant);
        const ok_pb: PatternBinding* = new PatternBinding { name: ok_bind, span: span };
        ok_pat.add_element(PatternElement::Binding(ok_pb));
        mut ok_arm: MatchArmNode* = new MatchArmNode(span);
        ok_arm.add_pattern(ok_pat as PatternNode*);
        const ok_ident: IdentifierNode* = new IdentifierNode(ok_bind, span);
        const ok_stmt: ExprStmtNode* = new ExprStmtNode(ok_ident as ExpressionNode*, span);
        mut ok_block: BlockStmtNode* = new BlockStmtNode(span);
        ok_block.add_statement(ok_stmt as StatementNode*);
        ok_arm.set_body(ok_block as StatementNode*);
        match_expr.add_arm(ok_arm);

        // Failure arm:  Err(e) => { return Result::Err(e); }
        //          /    None    => { return Option::None; }
        mut err_pat: EnumPatternNode* = new EnumPatternNode(span);
        err_pat.set_enum_name(enum_name);
        err_pat.set_variant_name(err_variant);
        mut ret_value: ExpressionNode* = null;
        if (is_result) {
            const err_bind: SymbolStr =
                this.intern.intern(format("__cryo_try_err_%u", g_try_counter));
            const err_pb: PatternBinding* =
                new PatternBinding { name: err_bind, span: span };
            err_pat.add_element(PatternElement::Binding(err_pb));
            // return Result::Err(e)
            const err_scope: ScopeResolutionNode* =
                new ScopeResolutionNode(enum_name, err_variant, span);
            mut err_call: CallExprNode* =
                new CallExprNode(err_scope as ExpressionNode*, span);
            err_call.add_argument(
                new IdentifierNode(err_bind, span) as ExpressionNode*);
            ret_value = err_call as ExpressionNode*;
        } else {
            // return Option::None
            ret_value = new ScopeResolutionNode(enum_name, err_variant, span)
                as ExpressionNode*;
        }
        mut err_arm: MatchArmNode* = new MatchArmNode(span);
        err_arm.add_pattern(err_pat as PatternNode*);
        const ret_stmt: ReturnStmtNode* = new ReturnStmtNode(ret_value, span);
        mut err_block: BlockStmtNode* = new BlockStmtNode(span);
        err_block.add_statement(ret_stmt as StatementNode*);
        err_arm.set_body(err_block as StatementNode*);
        match_expr.add_arm(err_arm);

        return match_expr;
    }

    /// Lower the postfix try operator `expr?` and return the type it
    /// evaluates to (the `Ok`/`Some` payload `T`).
    ///
    /// The parser cannot pick the desugar shape: it depends on whether the
    /// operand is a `Result` or an `Option`, and on the enclosing function's
    /// return type, so it emits a `TryExprNode` verbatim and we lower it
    /// here.  The synthetic `match` is built once the operand type is known,
    /// stored on `node.desugared`, and resolved through the ordinary match
    /// path: that gives codegen / drop-insertion / move-check a plain
    /// `MatchExprNode` to consume, and type-checks the failure arm's early
    /// `return` against the enclosing function for free.
    resolve_try_expr(mut &this, node: TryExprNode*) -> TypeRef {
        // 1. Resolve the operand with no expected-type hint; it is the
        //    Result/Option container, not the `T` the `?` evaluates to.
        const saved_expected: TypeRef = this.expected_type;
        this.expected_type = TypeRef::invalid();
        const operand_type: TypeRef = this.resolve_expr(node.operand);
        this.expected_type = saved_expected;
        if (!operand_type.is_valid()) {
            // The operand failed to resolve; its own diagnostic already fired.
            return TypeRef::invalid();
        }

        // 2. Classify the operand: 1 = Result-shaped, 2 = Option-shaped.
        const operand_shape: i32 = this.enum_try_shape(operand_type);
        if (operand_shape == 0) {
            const ot: Type* = this.arena.lookup(operand_type.id);
            const disp: string = if (ot != null) {
                this.arena.format_display(ot)
            } else {
                "?"
            };
            this.ctx.emit_error_at(ErrorCode::E0234_INVALID_TRY_OPERAND,
                format("the `?` operator requires a `Result` or `Option` value, but the operand has type '%s'",
                    disp),
                node.span);
            return TypeRef::invalid();
        }

        // 3. The enclosing function must return the same shape, so the
        //    failure arm's early `return` is well-typed.
        const fn_shape: i32 = this.enum_try_shape(this.return_type);
        if (fn_shape != operand_shape) {
            const want: string = if (operand_shape == 1) { "Result" } else { "Option" };
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0235_TRY_OUTSIDE_RESULT_FN,
                format("the `?` operator can only be used in a function that returns `%s`",
                    want));
            diag = diag.at_with_label(node.span,
                format("propagates a `%s`, but the enclosing function doesn't return one",
                    want));

            // Has-placeholders fix: replace the existing return-type
            // annotation with the operand's type so the function shape
            // matches what `?` requires.  The user can later swap in a
            // different success type, but this version compiles.
            const ann_span: SourceSpan =
                annotation_span(this.return_type_ann);
            if (ann_span.has_location()) {
                const ret_repl: string =
                    this.arena.resolve_display_name_short(operand_type.id);
                diag = diag.suggest(Suggestion::single(ann_span, ret_repl,
                    format("change the return type to `%s`", ret_repl),
                    Applicability::HasPlaceholders));
            }

            this.ctx.emit_diagnostic(diag);
            return TypeRef::invalid();
        }

        // 4. Build the desugared `match` and resolve it through the normal
        //    path.  resolve_match_expr binds `v`/`e`, type-checks the
        //    failure arm's `return` against the enclosing function, and
        //    yields the success arm's payload type, which is the type of
        //    the whole `expr?` expression.
        mut desugared: MatchExprNode* =
            this.build_try_desugar(node, operand_shape == 1);
        node.set_desugared(desugared as ExpressionNode*);
        return this.resolve_expr(desugared as ExpressionNode*);
    }

    resolve_struct_literal(mut &this, lit: StructLiteralNode*) -> TypeRef {
        // Resolve the struct's type first so we know its field layout.
        // Push each field's declared type as `expected_type` while we
        // resolve the field's initializer; same motivation as
        // `resolve_call`: empty `[]` literals in a struct field like
        // `aliases: []` need the field type to pick up their element
        // type.  Limited to empty ArrayLiterals to avoid side-effects
        // on other literal kinds.
        //
        // Prefer the specialized type when the literal carries explicit
        // generic args (`HashMapIter<string, u32> { ... }`): the
        // substituter rewrites the args from T->concrete but leaves
        // `struct_type` as the bare template name, so a plain
        // `lookup_type_by_sym` gets the template and downstream IR
        // emission signs the function body as returning the wrong
        // arena type.  Build the mangled specialized name first and
        // fall back to the bare lookup only when that misses.
        mut struct_ref: TypeRef = TypeRef::invalid();
        if (lit.generic_args.length > 0 && this.ctx.type_resolver != null) {
            const spec_sym: SymbolStr = this.resolve_generic_scope_name(
                lit.struct_type, lit.generic_args);
            if (spec_sym.is_valid()) {
                struct_ref = this.lookup_type_by_sym(spec_sym);
            }
        }
        if (!struct_ref.is_valid()) {
            struct_ref = this.lookup_type_by_sym(lit.struct_type);
        }
        mut struct_t: Type* = if (struct_ref.is_valid()) {
            this.arena.lookup(struct_ref.id)
        } else {
            null
        };
        if (struct_t != null && struct_t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = struct_t as InstantiatedType*;
            if (inst.has_resolved_type()) {
                struct_t = this.arena.lookup(inst.resolved_type.id);
            }
        }

        const saved_expected: TypeRef = this.expected_type;
        for (mut i: i64 = 0; i < lit.field_inits.length; i++) {
            const field_init: FieldInit = lit.field_inits[i];
            const value_expr: ExpressionNode* = field_init.value;
            // Push the field's declared type as `expected_type` while
            // resolving its initializer. This lets generic-method calls
            // (`RawBuffer::new()` returning `RawBuffer<T,A>`) and empty
            // array literals (`[]` adopting the field's element type)
            // pick up the right concrete instantiation from the surrounding
            // struct's field layout.
            mut field_type: TypeRef = TypeRef::invalid();
            if (value_expr != null && struct_t != null &&
                (struct_t.kind == TypeKind::Struct || struct_t.kind == TypeKind::Class)) {
                mut finfo: FieldInfo* = null;
                if (struct_t.kind == TypeKind::Struct) {
                    const st: StructType* = struct_t as StructType*;
                    finfo = st.get_field(field_init.field_name);
                } else {
                    const ct: ClassType* = struct_t as ClassType*;
                    finfo = ct.get_field(field_init.field_name);
                }
                if (finfo != null && finfo.field_type.is_valid()) {
                    field_type = finfo.field_type;
                }
            }
            if (field_type.is_valid()) {
                this.expected_type = field_type;
            } else {
                this.expected_type = TypeRef::invalid();
            }
            const value_type: TypeRef = this.resolve_expr(value_expr);
            if (field_type.is_valid() && value_type.is_valid() && value_expr != null) {
                // Skip the check when either side still has an
                // unsubstituted generic parameter.  The substituter
                // doesn't deep-propagate through nested generic-call
                // return types, so `mem::offset(this.ptr, ...)`
                // returning `T*` inside a monomorphized `Slice<u8>`
                // body would otherwise fire a spurious mismatch
                // against the substituted field type `u8*`.
                const skip: boolean = this.contains_generic_param(value_type)
                                    || this.contains_generic_param(field_type);
                if (!skip && !this.checker.can_assign(value_type, field_type)) {
                    const field_name_str: string = this.intern.resolve(field_init.field_name);
                    this.emit_type_mismatch_with_value(
                        ErrorCode::E0200_TYPE_MISMATCH,
                        value_expr.span,
                        field_type,
                        value_type,
                        format("field `%s` expects this type", field_name_str),
                        SourceSpan::none(),
                        value_expr);
                }
            }
        }
        this.expected_type = saved_expected;

        // Completeness check: every declared field of the target struct/class
        // must appear in the literal.  Without this, partial literals like
        // `Foo { bar: 1 }` silently leave `baz` uninitialized and slip through
        // sema; the only signal downstream is an undef LLVM store.  Skip when
        // the type didn't resolve or hasn't finished sema-population yet (the
        // monomorphizer fills fields after instantiation; see
        // [[project_pipeline_phases]]).
        if (struct_t != null &&
            (struct_t.kind == TypeKind::Struct || struct_t.kind == TypeKind::Class)) {
            mut fields_ptr: FieldInfo[] = [];
            mut is_complete: boolean = false;
            if (struct_t.kind == TypeKind::Struct) {
                const st: StructType* = struct_t as StructType*;
                fields_ptr = st.fields;
                is_complete = st.is_complete;
            } else {
                const ct: ClassType* = struct_t as ClassType*;
                fields_ptr = ct.fields;
                is_complete = ct.is_complete;
            }
            if (is_complete && fields_ptr.length > 0) {
                mut missing_names: SymbolStr[] = [];
                for (mut k: i64 = 0; k < fields_ptr.length; k++) {
                    const decl_name: SymbolStr = fields_ptr[k].name;
                    mut covered: boolean = false;
                    for (mut fi: i64 = 0; fi < lit.field_inits.length; fi++) {
                        if (lit.field_inits[fi].field_name.id == decl_name.id) {
                            covered = true;
                            break;
                        }
                    }
                    if (!covered) { missing_names.push(decl_name); }
                }
                if (missing_names.length > 0) {
                    // Build a capped, comma-quoted name list, mirroring the
                    // non-exhaustive-match diagnostic above.
                    mut names_str: string = "";
                    const cap: i64 = if (missing_names.length < 4) {
                        missing_names.length
                    } else { 4 };
                    for (mut i: i64 = 0; i < cap; i++) {
                        const n: string = this.intern.resolve(missing_names[i]);
                        if (i == 0) { names_str = format("`%s`", n); }
                        else { names_str = format("%s, `%s`", names_str, n); }
                    }
                    if (missing_names.length > cap) {
                        names_str = format("%s, and %lld more",
                            names_str, missing_names.length - cap);
                    }
                    const ty_sym: SymbolStr = this.intern.intern(this.arena.format_display(struct_t));
                    const ty_name: string = this.intern.resolve(ty_sym);
                    mut diag: Diagnostic = Diagnostic::error(
                        ErrorCode::E0355_MISSING_FIELD_INIT,
                        format("missing field%s %s in initializer of `%s`",
                            if (missing_names.length == 1) { "" } else { "s" },
                            names_str, ty_name));
                    diag = diag.at_with_label(lit.span,
                        if (missing_names.length == 1) {
                            format("missing field %s", names_str)
                        } else {
                            format("missing fields %s", names_str)
                        });

                    // Build a help line + diff-style suggestion: insert
                    // each missing field as `<name>: <type>` on its own
                    // line, anchored just after the last existing field
                    // initializer.  The renderer auto-indents inserted
                    // lines to match the anchor line's leading whitespace,
                    // so the replacement carries no indent itself -
                    // `,\n<name>: <type>` is enough.  The literal-empty
                    // case is skipped (we don't have the open-brace
                    // column at hand); the headline + help still guide
                    // the user.
                    mut repl: string = "";
                    mut hint_names: string = "";
                    for (mut i: i64 = 0; i < missing_names.length; i++) {
                        if (i > 0) { hint_names = format("%s, ", hint_names); }
                        const fname: string = this.intern.resolve(missing_names[i]);
                        mut ftype: string = "_";
                        for (mut k: i64 = 0; k < fields_ptr.length; k++) {
                            if (fields_ptr[k].name.id == missing_names[i].id) {
                                ftype = this.arena.resolve_display_name(
                                    fields_ptr[k].field_type.id);
                                break;
                            }
                        }
                        if (lit.field_inits.length > 0 || i > 0) {
                            // Trailing comma on the prior line (the anchor
                            // line for i==0, the previous inserted field
                            // otherwise) before the new field's own line.
                            repl = format("%s,", repl);
                        }
                        repl = format("%s\n%s: <%s>", repl, fname, ftype);
                        hint_names = format("%s`%s`", hint_names, fname);
                    }

                    diag = diag.help(
                        if (missing_names.length == 1) {
                            format("specify a value for field %s", hint_names)
                        } else {
                            format("specify values for fields %s", hint_names)
                        });

                    if (lit.field_inits.length > 0) {
                        const anchor: FieldInit =
                            lit.field_inits[lit.field_inits.length - 1];
                        const insert_span: SourceSpan = SourceSpan::new(
                            anchor.span.file,
                            anchor.span.end_line, anchor.span.end_col,
                            anchor.span.end_line, anchor.span.end_col);
                        const sug_msg: string =
                            format("add %s", hint_names);
                        diag = diag.suggest(Suggestion::single(insert_span,
                            repl, sug_msg, Applicability::HasPlaceholders));
                    }

                    this.ctx.emit_diagnostic(diag);
                }
            }
        }

        return struct_ref;
    }

    /// Reject `Enum::member` where `member` is neither a variant nor a
    /// static method of the enum. Resolving the scope to a valid enum type
    /// is not enough - the member has to exist, or a typo silently compiles
    /// (E0640 with a did-you-mean over the real variant names).
    validate_enum_scope_member(mut &this, scope_ty: TypeRef,
                               scope: ScopeResolutionNode*) -> void {
        const t: Type* = this.arena.lookup(scope_ty.id);
        if (t == null || t.kind != TypeKind::Enum) { return; }
        const et: EnumType* = t as EnumType*;
        if (et.get_variant(scope.member_name) != null) { return; }
        for (mut i: i64 = 0; i < et.methods.length; i++) {
            if (et.methods[i].name.equals(scope.member_name)) { return; }
        }
        const enum_name: string = this.intern.resolve(scope.scope_name);
        const member:    string = this.intern.resolve(scope.member_name);
        mut cands: string[] = [];
        for (mut i: i64 = 0; i < et.variants.length; i++) {
            cands.push(this.intern.resolve(et.variants[i].name));
        }
        const best: string = find_best_candidate(member, cands);
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0640_INVALID_ENUM_VARIANT_ACCESS,
            format("enum `%s` has no variant `%s`", enum_name, member));
        d = d.at_with_label(scope.span, "unknown variant");
        if (strlen(best) > 0) {
            d = d.help(format("did you mean `%s::%s`?", enum_name, best));
        }
        this.ctx.diagnostics.emit(d);
    }

    resolve_scope_resolution(mut &this, scope: ScopeResolutionNode*) -> TypeRef {
        const found: TypeRef = this.lookup_type_by_sym(scope.scope_name);
        if (found.is_valid()) {
            // When the scope is an enum, the member must be a real variant
            // (or a static method). A typo like `Color::Bogus` previously
            // resolved straight to the enum type with the member ignored, so
            // it compiled and ran as a match arm that could never fire / a
            // garbage discriminant - a silent miscompile.
            this.validate_enum_scope_member(found, scope);
            return this.promote_to_expected_instantiation(found);
        }
        // Module-qualified globals: `libc::O_APPEND` where `libc` is a
        // namespace, not a type.  Codegen routes the value through
        // `resolve_global` (qualified first, then bare); without a
        // resolved_type here, codegen_rvalue skips its load step and
        // leaks the global *pointer* into the surrounding expression
        // (e.g. `flags | libc::O_APPEND` becomes `or ptr, ptr`,
        // failing the LLVM verifier).  Match codegen's lookup order
        // so the resolved type matches the value the load will produce.
        const scope_str: string = this.intern.resolve(scope.scope_name);
        const member_str: string = this.intern.resolve(scope.member_name);
        const qualified: string = scope_str + "::" + member_str;
        const q_sym: SymbolStr = this.ctx.intern(qualified);
        const q_global: TypeRef = this.lookup_global_var(q_sym);
        if (q_global.is_valid()) { return q_global; }
        const b_global: TypeRef = this.lookup_global_var(scope.member_name);
        if (b_global.is_valid()) { return b_global; }
        return found;
    }

    resolve_new_expr(mut &this, new_expr: NewExprNode*) -> TypeRef {
        // Resolve constructor arguments
        for (mut i: i64 = 0; i < new_expr.arguments.length; i++) {
            this.resolve_expr(new_expr.arguments[i]);
        }
        // Resolve struct literal field initializers if present
        if (new_expr.has_struct_init()) {
            this.resolve_struct_literal(new_expr.struct_init);
        }
        // Array allocation `new T[n]`: type-check the size expression so it's
        // a real value (codegen reads it to size the malloc).
        if (new_expr.has_array_size()) {
            this.resolve_expr(new_expr.array_size);
        }
        mut base: TypeRef = this.lookup_type_by_sym(new_expr.type_name);
        // Primitive element types (`new int[100]`, `new u8[1024]`) are not in
        // the decl index - the name is a primitive keyword, not a user type -
        // so fall back to primitive resolution.  This is what makes
        // `new int[100]` resolve to `int*` rather than failing.
        if (!base.is_valid() && this.ctx.type_resolver != null) {
            base = this.ctx.type_resolver.resolve_primitive(new_expr.type_name);
        }
        if (base.is_valid()) {
            return this.arena.get_pointer_to(base);
        }
        return TypeRef::invalid();
    }

    /// True when the current `expected_type` resolves (through any
    /// InstantiatedType wrapper) to a DYNAMIC array `E[]` (`{ptr, len, cap}`
    /// fat pointer), as opposed to a fixed `[E; N]`. Used by fill-form array
    /// literals to keep `mut c: E[] = [v; N]` dynamic while letting a fixed
    /// target adopt a fixed shape.
    expected_is_dynamic_array(&this) -> boolean {
        if (!this.expected_type.is_valid()) { return false; }
        mut exp_t: Type* = this.arena.lookup(this.expected_type.id);
        if (exp_t != null && exp_t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = exp_t as InstantiatedType*;
            if (inst.has_resolved_type()) {
                exp_t = this.arena.lookup(inst.resolved_type.id);
            }
        }
        if (exp_t == null || exp_t.kind != TypeKind::Array) { return false; }
        return !(exp_t as ArrayType*).is_fixed();
    }

    resolve_array_literal(mut &this, arr: ArrayLiteralNode*) -> TypeRef {
        // Bidirectional inference: if the surrounding context expects an
        // `Array<E>` / `[E; N]`, push `E` as the expected_type while
        // resolving each element so that polymorphic literals (integer /
        // float defaults) adopt `E` instead of falling back to `i32` /
        // `f64`.  Without this, `mut buf: u8[4] = [10, 20, 30, 40]`
        // resolved every element to `i32`, which propagated through to
        // codegen as a `[4 x i32]` literal and a bulk
        // `store [4 x i32] %v, ptr %buf, align 1` over a 4-byte slot;
        // 12 bytes of stack clobber.  Mirrors the save-restore pattern
        // used at var-decl entry and `return` (see the `expected_type`
        // wiring around lines 1056-1064 and 1303-1308).
        mut elem_expected: TypeRef = TypeRef::invalid();
        if (this.expected_type.is_valid()) {
            mut exp_t: Type* = this.arena.lookup(this.expected_type.id);
            if (exp_t != null && exp_t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = exp_t as InstantiatedType*;
                if (inst.has_resolved_type()) {
                    exp_t = this.arena.lookup(inst.resolved_type.id);
                }
            }
            if (exp_t != null && exp_t.kind == TypeKind::Array) {
                const exp_arr: ArrayType* = exp_t as ArrayType*;
                elem_expected = exp_arr.element;
            }
        }
        const saved_expected: TypeRef = this.expected_type;
        mut elem_type: TypeRef = TypeRef::invalid();
        for (mut i: i64 = 0; i < arr.elements.length; i++) {
            if (elem_expected.is_valid()) {
                this.expected_type = elem_expected;
            }
            const t: TypeRef = this.resolve_expr(arr.elements[i]);
            this.expected_type = saved_expected;
            // Every element must be assignable to the array's element type:
            // the context-declared element type when the surrounding context
            // fixes it (`i32[] = [...]`), otherwise the first element's type
            // (the literal itself establishes the homogeneous element type).
            // Without this, a mismatched element (`i32[] = [1, "x"]`) was
            // silently accepted and reinterpreted at codegen -> type confusion.
            mut target: TypeRef = elem_expected;
            if (!target.is_valid()) { target = elem_type; }
            if (target.is_valid() && t.is_valid()
                && !this.checker.can_assign(t, target)) {
                this.emit_type_mismatch_with_value(
                    ErrorCode::E0200_TYPE_MISMATCH,
                    arr.elements[i].span,
                    target,
                    t,
                    "array elements must all have the same type",
                    SourceSpan::none(),
                    arr.elements[i]);
            }
            if (!elem_type.is_valid() && t.is_valid()) {
                elem_type = t;
            }
        }
        if (arr.repeat_count_expr != null) {
            this.resolve_expr(arr.repeat_count_expr);
        }
        // Empty literal (`[]`): can't infer the element type from
        // contents; look at the surrounding context via `expected_type`.
        // If the call site or assignment context expects `Array<T>`, we
        // adopt the expected type VERBATIM (element type AND size/shape):
        // a dynamic `T[]` needs `size = -1` to map to `{ptr, i64}`; a
        // fixed `[T; N]` needs the declared N.  Returning a fresh type
        // with `size = elements.length = 0` would emit a zero-sized
        // fixed array that doesn't match the caller's param type.
        if (!elem_type.is_valid() && this.expected_type.is_valid() &&
            arr.elements.length == 0 && arr.repeat_count == 0 &&
            arr.repeat_count_expr == null) {
            mut exp_t: Type* = this.arena.lookup(this.expected_type.id);
            if (exp_t != null && exp_t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = exp_t as InstantiatedType*;
                if (inst.has_resolved_type()) {
                    exp_t = this.arena.lookup(inst.resolved_type.id);
                }
            }
            if (exp_t != null && exp_t.kind == TypeKind::Array) {
                return this.expected_type;
            }
        }
        if (elem_type.is_valid()) {
            // Fill expression [value; count]: use the repeat count for the
            // array size.  A static count (e.g. [0; 5]) uses repeat_count;
            // a dynamic count (e.g. [0; n]) has repeat_count_expr and the
            // size is unknown at compile time, so treat as dynamic (-1).
            mut size: i64 = arr.elements.length;
            if (arr.repeat_count > 0) {
                size = arr.repeat_count;
            } else if (arr.repeat_count_expr != null) {
                // Fill form `[value; count]` (the parser always records the
                // count as `repeat_count_expr`, even a literal). A compile-
                // time-constant count yields a FIXED `[E; count]` so it
                // matches a fixed `[E; N]` slot and fills the `[N x E]`
                // alloca directly - leaving it dynamic produced a `{ptr,len,
                // cap}` fat pointer whose store into the `[N x E]` local was
                // silently dropped, so the array read back uninitialized
                // garbage. A non-constant (runtime) count, or a context that
                // explicitly expects a dynamic `E[]`, stays dynamic (-1).
                size = -1;
                if (!this.expected_is_dynamic_array()) {
                    const fill_count: i64 = sema_const_int_index(arr.repeat_count_expr);
                    if (fill_count >= 0) { size = fill_count; }
                }
            }
            // Propagate a dynamic-array expected type: when the surrounding
            // context expects `T[]` (e.g. `return [a, b]` in a function
            // returning `T[]`), make the literal adopt the dynamic shape
            // instead of the fixed `[T; N]` inferred from elements.length.
            // Otherwise the return/assign sees a `[N x T]` value against a
            // `{ptr, i64}` slot and LLVM verification fails.
            if (this.expected_type.is_valid() && arr.repeat_count == 0 &&
                arr.repeat_count_expr == null) {
                mut exp_t: Type* = this.arena.lookup(this.expected_type.id);
                if (exp_t != null && exp_t.kind == TypeKind::InstantiatedType) {
                    const inst: InstantiatedType* = exp_t as InstantiatedType*;
                    if (inst.has_resolved_type()) {
                        exp_t = this.arena.lookup(inst.resolved_type.id);
                    }
                }
                if (exp_t != null && exp_t.kind == TypeKind::Array) {
                    const exp_arr: ArrayType* = exp_t as ArrayType*;
                    if (!exp_arr.is_fixed() &&
                        this.checker.can_assign(elem_type, exp_arr.element)) {
                        return this.expected_type;
                    }
                }
            }
            return this.arena.get_array_of(elem_type, size);
        }
        return TypeRef::invalid();
    }

    resolve_tuple_literal(mut &this, tup: TupleLiteralNode*) -> TypeRef {
        mut elem_types: TypeRef[] = [];
        for (mut i: i64 = 0; i < tup.elements.length; i++) {
            elem_types.push(this.resolve_expr(tup.elements[i]));
        }
        return this.arena.get_tuple(elem_types);
    }
}


/// Read a tuple bracket index expression as a compile-time constant
/// integer. Currently only accepts a bare integer literal; tuples have
/// a fixed shape, so runtime indices can't be bounds-checked and aren't
/// supported. Returns -1 for any non-literal or non-integer expression.
function sema_const_int_index(expr: ExpressionNode*) -> i64 {
    if (expr == null) { return -1; }
    const node: ASTNode* = expr as ASTNode*;
    if (node.kind != NodeKind::Literal) { return -1; }
    const lit: LiteralNode* = expr as LiteralNode*;
    if (lit.literal_kind != LiteralKind::Integer) { return -1; }
    return parse_tuple_index(lit.value);
}

/// True when `expr` is a bare integer or float literal node; used by
/// resolve_binary to decide whether to push the other operand's type as
/// expected_type.  Negative literals (`-5`) parse as UnaryExpression
/// wrapping the literal and aren't matched here; see
/// `is_negative_numeric_literal_expr` for that case.
function is_numeric_literal_expr(expr: ExpressionNode*) -> boolean {
    if (expr == null) { return false; }
    const node: ASTNode* = expr as ASTNode*;
    if (node.kind != NodeKind::Literal) { return false; }
    const lit: LiteralNode* = expr as LiteralNode*;
    return lit.literal_kind == LiteralKind::Integer
        || lit.literal_kind == LiteralKind::Float;
}

/// True when `expr` is a negated numeric literal: a UnaryExpression with a
/// `-` operator wrapping an integer/float literal (`-9223372036854775808`).
/// These need the surrounding expected type pushed onto the inner
/// magnitude literal - otherwise the magnitude defaults to i32 and a wide
/// bit pattern (i64::MIN's 2^63 magnitude) truncates to its low 32 bits,
/// which negate to 0.  The magnitude itself is checked, not the unary
/// node, so callers can decide whether to forward their expected type.
function is_negative_numeric_literal_expr(expr: ExpressionNode*) -> boolean {
    if (expr == null) { return false; }
    const node: ASTNode* = expr as ASTNode*;
    if (node.kind != NodeKind::UnaryExpression) { return false; }
    const u: UnaryExprNode* = expr as UnaryExprNode*;
    if (u.op.lexeme != "-") { return false; }
    return is_numeric_literal_expr(u.operand);
}

/// u64 max (2^64-1). Hoisted into a typed const so it adopts u64 rather
/// than wrapping negative when used inline (see integer_literals.cryo).
const SEMA_U64_MAX: u64 = 18446744073709551615;

/// i32 / i64 positive maxima, hoisted into typed consts for the same
/// reason as SEMA_U64_MAX: an inline `9223372036854775807` compared
/// against a u64 param truncates under the bootstrap.  Used by
/// `resolve_integer_literal` to pick a default width that holds the
/// literal's magnitude when no expected type is in scope.
const SEMA_I32_MAX_MAG: u64 = 2147483647;
const SEMA_I64_MAX_MAG: u64 = 9223372036854775807;

/// True when `expr` is an integer literal whose value denotes zero in any
/// radix, ignoring digit separators: `0`, `0x0`, `0b0`, `00`, `0_0`, ...
function is_zero_int_literal(expr: ExpressionNode*) -> boolean {
    if (expr == null) { return false; }
    const node: ASTNode* = expr as ASTNode*;
    if (node.kind != NodeKind::Literal) { return false; }
    const lit: LiteralNode* = expr as LiteralNode*;
    if (lit.literal_kind != LiteralKind::Integer) { return false; }
    return int_literal_text_is_zero(lit.value);
}

function int_literal_text_is_zero(s: string) -> boolean {
    if (s == null) { return false; }
    const len: i64 = strlen(s) as i64;
    mut i: i64 = 0;
    if (len >= 2 && s[0] == '0') {
        const c1: char = s[1];
        if (c1 == 'x' || c1 == 'X' || c1 == 'b'
            || c1 == 'B' || c1 == 'o' || c1 == 'O') { i = 2; }
    }
    mut saw_digit: boolean = false;
    while (i < len) {
        const c: char = s[i];
        if (c == '_') { i = i + 1; continue; }
        if (c != '0') { return false; }
        saw_digit = true;
        i = i + 1;
    }
    return saw_digit;
}

/// True when the integer-literal text `s` denotes a magnitude strictly
/// greater than `max_mag` (or overflows u64, which exceeds any type whose
/// bound fits in u64). Honors `0x`/`0b`/`0o` prefixes and `_` separators.
/// Returns false on malformed text so other passes own that diagnostic.
function int_literal_exceeds(s: string, max_mag: u64) -> boolean {
    if (s == null) { return false; }
    const len: i64 = strlen(s) as i64;
    if (len == 0) { return false; }
    mut i: i64 = 0;
    mut radix: u64 = 10;
    if (len >= 2 && s[0] == '0') {
        const c1: char = s[1];
        if (c1 == 'x' || c1 == 'X') { radix = 16; i = 2; }
        else if (c1 == 'b' || c1 == 'B') { radix = 2; i = 2; }
        else if (c1 == 'o' || c1 == 'O') { radix = 8; i = 2; }
    }
    mut acc: u64 = 0;
    mut saw_digit: boolean = false;
    while (i < len) {
        const c: char = s[i];
        if (c == '_') { i = i + 1; continue; }
        mut d: u64 = 0;
        if (c >= '0' && c <= '9') { d = (c - '0') as u64; }
        else if (c >= 'a' && c <= 'f') { d = (c - 'a' + 10) as u64; }
        else if (c >= 'A' && c <= 'F') { d = (c - 'A' + 10) as u64; }
        else { return false; }
        if (d >= radix) { return false; }
        saw_digit = true;
        // Overflow-checked acc = acc*radix + d. Past u64 it can only be
        // larger than any in-range bound, so report "exceeds".
        if (acc > (SEMA_U64_MAX - d) / radix) { return true; }
        acc = acc * radix + d;
        i = i + 1;
    }
    if (!saw_digit) { return false; }
    return acc > max_mag;
}

/// Parse a member-name SymbolStr as a non-negative tuple index. Returns
/// -1 for any non-digit character or empty input; the caller distinguishes
/// "not a tuple index" from "out of bounds" so the diagnostic can be more
/// specific. Plain decimal only: tuple indices never appear with prefixes
/// or signs in source.
function parse_tuple_index(s: string) -> i64 {
    if (s == null) { return -1; }
    const len: i64 = strlen(s) as i64;
    if (len == 0) { return -1; }
    mut acc: i64 = 0;
    for (mut i: i64 = 0; i < len; i++) {
        const c: char = s[i];
        if (c < '0' || c > '9') { return -1; }
        acc = acc * 10 + ((c - '0') as i64);
    }
    return acc;
}

/// Decode a range-pattern bound's interned text into a signed value for the
/// `lo <= hi` ordering check.  This mirrors the codegen-side decoders
/// (`decode_char_lexeme` / `parse_int_lexeme`) but is kept here so sema does
/// not reach across into the codegen layer - the same convention the other
/// sema-local literal helpers (`parse_tuple_index`, `int_literal_text_is_zero`)
/// already follow.  Best-effort: a malformed lexeme (which the parser should
/// already have rejected) decodes to 0 rather than raising a second error.
function sema_decode_range_bound(s: string, kind: LiteralKind) -> i64 {
    if (s == null) { return 0; }
    const len: i64 = strlen(s) as i64;
    if (len == 0) { return 0; }

    if (kind == LiteralKind::Char) {
        // The lexer hands over the text *between* the quotes, so `'\n'`
        // arrives as the two chars `\` `n`.  Resolve the C-style escapes.
        if (len >= 2 && s[0] == '\\') {
            const esc: char = s[1];
            if (esc == 'n')  { return 10; }
            if (esc == 't')  { return 9; }
            if (esc == 'r')  { return 13; }
            if (esc == '0')  { return 0; }
            if (esc == '\\') { return 92; }
            if (esc == '\'') { return 39; }
            if (esc == '"')  { return 34; }
            if (esc == 'a')  { return 7; }
            if (esc == 'b')  { return 8; }
            if (esc == 'f')  { return 12; }
            if (esc == 'v')  { return 11; }
            if (esc == 'x' && len >= 4) {
                return sema_hex_digit(s[2]) * 16 + sema_hex_digit(s[3]);
            }
            return esc as i64;
        }
        return s[0] as i64;
    }

    // Integer bound: optional sign, then 0x/0o/0b/decimal, '_' separators.
    mut i: i64 = 0;
    mut negate: boolean = false;
    if (s[0] == '-') { negate = true; i = 1; }
    else if (s[0] == '+') { i = 1; }

    mut base: i64 = 10;
    if (i + 1 < len && s[i] == '0' && (s[i+1] == 'x' || s[i+1] == 'X')) { base = 16; i += 2; }
    else if (i + 1 < len && s[i] == '0' && (s[i+1] == 'b' || s[i+1] == 'B')) { base = 2; i += 2; }
    else if (i + 1 < len && s[i] == '0' && (s[i+1] == 'o' || s[i+1] == 'O')) { base = 8; i += 2; }

    mut acc: i64 = 0;
    while (i < len) {
        const c: char = s[i];
        if (c == '_') { i += 1; continue; }
        const digit: i64 = sema_hex_digit(c);
        if (digit < 0 || digit >= base) { break; }
        acc = acc * base + digit;
        i += 1;
    }
    if (negate) { return 0 - acc; }
    return acc;
}

/// Value of a single hex digit (0-9, a-f, A-F), or -1 if not a hex digit.
function sema_hex_digit(c: char) -> i64 {
    if (c >= '0' && c <= '9') { return (c - '0') as i64; }
    if (c >= 'a' && c <= 'f') { return (c - 'a' + 10) as i64; }
    if (c >= 'A' && c <= 'F') { return (c - 'A' + 10) as i64; }
    return -1;
}


// SemanticPasses: static dispatch for pass registry

type struct SemanticPasses {

    /// Walk all function bodies and fill resolved_type on every ExpressionNode.
    ///
    /// By the time this pass completes, every expression in every function body
    /// (both original and monomorphized) will have a concrete TypeRef.  Generic
    /// templates are skipped; their specialized concrete versions (injected by
    /// GenericExpressionResolution) are type-checked instead.
    static run_function_body_type_check(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        if (ctx.debug_mode) {
            cdebug("[FunctionBodyTypeCheck] Type-checking function bodies\n");
        }

        const arena: TypeArena* = ctx.type_arena;
        if (arena == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "FunctionBodyTypeCheck: type system not initialized");
            return PassResult::failure(1);
        }

        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            return PassResult::ok();
        }

        // Build the visitor and drive it through the AST
        mut visitor: TypeCheckVisitor = TypeCheckVisitor::build(ctx);
        visitor.visit(root);

        if (ctx.debug_mode) {
            cdebug("[FunctionBodyTypeCheck] Type-checked %lld function bodies\n",
                visitor.body_count);
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }
}
