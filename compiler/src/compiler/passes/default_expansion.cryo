/// Default-Expansion Pass
///
/// Rewrites bare references to generic types whose every type-parameter has
/// a default annotation (e.g. `String<A = GlobalAlloc>`) into the explicit
/// `Generic(Named, [defaults])` form, so downstream resolution produces
/// one canonical InstantiatedType regardless of where the reference came
/// from.  Without this pass the resolver returns the template TypeRef for
/// bare `String`, while explicit `String<GlobalAlloc>` resolves through
/// `instantiate()`; two different TypeRef ids for the same logical type
/// break mono cache keys, name mangling, and method tables.
///
/// What gets rewritten
///
/// - Type annotations of shape `Named("X")` and the scope segment of
///   `X::member` whose STAMP names a registered template with a default on
///   every parameter, unless the reference stands inside that template's
///   own body (where bare `X` keeps meaning "the template with bound
///   params").  The question is asked of the stamp - `template_of(def)` -
///   never of the spelling: a written `PathBuf` that the name layer bound
///   to the user's own non-generic struct is not the stdlib's `PathBuf<A =
///   GlobalAlloc>` however the two are spelled, and a pass that matched by
///   leaf let an import that binds nothing (`import std::fs::path;`)
///   rewrite an unrelated same-leaf type.
///
/// Out of scope (handled by other passes / future work)
///
/// - Impl block targets (`implement trait Eq for struct String { ... }`)
///   would also benefit but require a structural change to ImplBlock
///   to carry type args. Tackled separately.
/// - Static-method scopes (`String::new()`): same shape concern.
/// - Generic static-method type-arg inference (`Slice::from_raw(u8*, ...)`).

namespace compiler::passes::default_expansion;

import compiler::diag;
import compiler::diag::snapshot;
import compiler::diag::snapshot::{ DiagnosticSnapshot };
import compiler::ast;
import compiler::ast::{
    declaration, expression, GenericAnnotation, NamedAnnotation, node, NodeKind, pattern,
    statement, TypeAnnotation
};
import compiler::passes::pass_id;
import compiler::passes::pass_id::{ PassResult };
import compiler::compilation_context;
import compiler::compilation_context::{ CompilationContext };
import compiler::types::{ generic_registry, type_ref };
import compiler::resolver::{ symbol_str, intern_table };
import compiler::resolver::res;
import compiler::resolver::res::{ DefId, Res, ResBase, ResSlot };
import compiler::diag::source_span;
import compiler::diag::source_span::{ SourceSpan };
import compiler::ast::declaration::{
    ClassDeclNode, DeclarationNode, DeclKind, EnumVariant, FieldDecl, FunctionDecl,
    GenericParamDecl, ImplBlock, MethodDecl, StructDecl, TraitDecl,
    UnionDecl, VarDecl
};
import compiler::ast::expression::{
    ArrayAccessNode, BinaryExprNode, CallExprNode,
    CastExprNode, ExprKind, ExpressionNode, FieldInit, MatchExprNode, MemberAccessNode,
    ScopeResolutionNode, StaticMatchExprNode,
    UnaryExprNode
};
import compiler::ast::node::{ ASTNode, ProgramNode };
import compiler::ast::pattern::{ MatchArmNode, StaticMatchArmNode };
import compiler::ast::statement::{ Stmt, StmtKind };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::types::generic_registry::{ GenericRegistry, TemplateEntry };
import compiler::types::type_ref::{ TypeRef };


// Scope stack: the generic declarations whose bodies the walk is inside

/// The templates whose parameters are in scope at the current position, by
/// identity.  A bare reference to a template inside that template's own body
/// keeps meaning the template with its parameters bound - `Foo` inside `Foo<A
/// = GlobalAlloc>` is `Foo<A>`, not `Foo<GlobalAlloc>` - so the walk pushes
/// each generic declaration's id on entry and the rewrite declines a stamp
/// that names one of them.  A generic PARAMETER needs no entry: its stamp is
/// `GenericParam`, which names no template.
type struct ScopeStack {
    defs: [DefId];

    static new() -> ScopeStack {
        return ScopeStack { defs: [] };
    }

    push(mut &this, d: DefId) -> void {
        if (d.is_valid()) { this.defs.push(d); }
    }

    pop(mut &this) -> void {
        if (this.defs.length > 0) {
            this.defs.pop();
        }
    }

    contains(&this, d: DefId) -> boolean {
        for (mut i: i64 = 0; i < this.defs.length; i++) {
            if (this.defs[i].equals(d)) { return true; }
        }
        return false;
    }
}


// DefaultExpansionPasses: pass entry point + walker

type struct DefaultExpansionPasses {

    /// Pass entry point.  Walks the program AST and rewrites every bare
    /// reference whose stamp names an all-default template.  Every module's
    /// TemplateRegistration has run before any module's DefaultExpansion, so
    /// the registry already holds this module's templates beside the
    /// imported ones and the stamp is the whole question.
    static run(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) { return PassResult::ok(); }

        mut scope: ScopeStack = ScopeStack::new();
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            DefaultExpansionPasses::rewrite_stmt(root.statements[i], ctx.generic_registry, &scope);
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }

    /// The arguments a bare reference to `d` expands to: one annotation per
    /// parameter, each a DEEP CLONE of the default the template declares, or
    /// an empty list when `d` is not a registered template or any of its
    /// parameters has no default.  Cloning matters because each rewrite site
    /// gets its own copy; sharing would break codegen, which mutates resolved
    /// type fields per site.
    static defaults_of(d: DefId, reg: GenericRegistry*) -> [TypeAnnotation*] {
        const entry: TemplateEntry* = reg.template_of(d);
        if (entry == null) { return []; }
        const params: [DeclarationNode*] = entry.get_generic_params();
        if (params.length == 0) { return []; }
        for (mut i: i64 = 0; i < params.length; i++) {
            const gp_decl: DeclarationNode* = params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            if (gp == null || !gp.has_default_annotation()) { return []; }
        }
        mut defaults: [TypeAnnotation*] = [];
        for (mut i: i64 = 0; i < params.length; i++) {
            defaults.push(TypeAnnotation::clone_ptr(DeclarationNode::generic_param_of(params[i]).default_annotation));
        }
        return defaults;
    }


    // Rewriter

    /// Rewrite a top-level statement, pushing/popping scope as we enter
    /// and leave a generic type's body.
    static rewrite_stmt(stmt: ASTNode*, reg: GenericRegistry*,
                        scope: ScopeStack*) -> void {
        if (stmt == null) { return; }
        match (stmt.kind) {
            NodeKind::ClassDeclaration => {
                const node: ClassDeclNode* = stmt as ClassDeclNode*;
                const is_generic: boolean = node.generic_params.length > 0;
                if (is_generic) { scope.push(node.def); }
                for (mut i: i64 = 0; i < node.fields.length; i++) {
                    const f_decl: DeclarationNode* = node.fields[i];
                    const f: FieldDecl* = DeclarationNode::field_of(f_decl);
                    if (f != null && f.has_type_annotation()) {
                        DefaultExpansionPasses::rewrite_annotation_in_place(
                            f.type_annotation, reg, scope);
                    }
                }
                for (mut i: i64 = 0; i < node.methods.length; i++) {
                    const m_decl: DeclarationNode* = node.methods[i];
                    const m: MethodDecl* = DeclarationNode::method_of(m_decl);
                    if (m != null && m.func != null) {
                        DefaultExpansionPasses::rewrite_function_decl(
                            m.func, reg, scope);
                    }
                }
                if (is_generic) { scope.pop(); }
            }
            NodeKind::Declaration => {
                match ((stmt as DeclarationNode*).shape) {
                    DeclKind::Function(_) => {
                        DefaultExpansionPasses::rewrite_function_decl(
                            DeclarationNode::with_shape(stmt), reg, scope);
                    }
                    DeclKind::Impl(node) => {
                        // An impl block is not the template's own body: its
                        // methods are a site that CONSUMES the type, so a bare
                        // reference to the target inside them is expanded like
                        // any other.  Its generic parameters need no scope
                        // entry - a parameter's stamp is `GenericParam`, which
                        // names no template.
                        for (mut i: i64 = 0; i < node.methods.length; i++) {
                            const m_decl: DeclarationNode* = node.methods[i];
                            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
                            if (m != null && m.func != null) {
                                DefaultExpansionPasses::rewrite_function_decl(
                                    m.func, reg, scope);
                            }
                        }
                    }
                    DeclKind::Struct(node) => {
                        const is_generic: boolean = node.generic_params.length > 0;
                        if (is_generic) { scope.push(node.def); }
                        for (mut i: i64 = 0; i < node.fields.length; i++) {
                            const f_decl: DeclarationNode* = node.fields[i];
                            const f: FieldDecl* = DeclarationNode::field_of(f_decl);
                            if (f != null && f.has_type_annotation()) {
                                DefaultExpansionPasses::rewrite_annotation_in_place(
                                    f.type_annotation, reg, scope);
                            }
                        }
                        for (mut i: i64 = 0; i < node.methods.length; i++) {
                            const m_decl: DeclarationNode* = node.methods[i];
                            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
                            if (m != null && m.func != null) {
                                DefaultExpansionPasses::rewrite_function_decl(
                                    m.func, reg, scope);
                            }
                        }
                        if (is_generic) { scope.pop(); }
                    }
                    DeclKind::Trait(node) => {
                        const is_generic: boolean = node.generic_params.length > 0;
                        if (is_generic) { scope.push(node.def); }
                        for (mut i: i64 = 0; i < node.methods.length; i++) {
                            DefaultExpansionPasses::rewrite_function_decl(
                                node.methods[i], reg, scope);
                        }
                        if (is_generic) { scope.pop(); }
                    }
                    DeclKind::Enum(node) => {
                        const is_generic: boolean = node.generic_params.length > 0;
                        if (is_generic) { scope.push(node.def); }
                        // Enum variant payload annotations (if any).
                        for (mut i: i64 = 0; i < node.variants.length; i++) {
                            const v: EnumVariant* = DeclarationNode::variant_of(node.variants[i]);
                            if (v == null) { continue; }
                            for (mut j: i64 = 0; j < v.associated_types.length; j++) {
                                DefaultExpansionPasses::rewrite_annotation_in_place(
                                    v.associated_types[j], reg, scope);
                            }
                        }
                        if (is_generic) { scope.pop(); }
                    }
                    DeclKind::TypeAlias(node) => {
                        const is_generic: boolean = node.generic_params.length > 0;
                        if (is_generic) { scope.push(node.def); }
                        if (node.target_annotation != null) {
                            DefaultExpansionPasses::rewrite_annotation_in_place(
                                node.target_annotation, reg, scope);
                        }
                        if (is_generic) { scope.pop(); }
                    }
                    DeclKind::Union(node) => {
                        const is_generic: boolean = node.generic_params.length > 0;
                        if (is_generic) { scope.push(node.def); }
                        for (mut i: i64 = 0; i < node.fields.length; i++) {
                            const f_decl: DeclarationNode* = node.fields[i];
                            const f: FieldDecl* = DeclarationNode::field_of(f_decl);
                            if (f != null && f.has_type_annotation()) {
                                DefaultExpansionPasses::rewrite_annotation_in_place(
                                    f.type_annotation, reg, scope);
                            }
                        }
                        for (mut i: i64 = 0; i < node.methods.length; i++) {
                            const m_decl: DeclarationNode* = node.methods[i];
                            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
                            if (m != null && m.func != null) {
                                DefaultExpansionPasses::rewrite_function_decl(
                                    m.func, reg, scope);
                            }
                        }
                        if (is_generic) { scope.pop(); }
                    }
                    // No other kind with a payload holds an annotation here.
                    DeclKind::Import(_) | DeclKind::Intrinsic(_)
                    | DeclKind::Module(_) | DeclKind::Variant(_) | DeclKind::Destructure(_)
                    | DeclKind::Extern(_) | DeclKind::Field(_) | DeclKind::GenericParam(_)
                    | DeclKind::Variable(_) | DeclKind::Method(_) | DeclKind::Legacy => {}
                }
            }
            _ => {}
        }
    }

    /// Rewrite a function/method declaration: its parameter and return
    /// annotations and its body.  Its own generic parameters (`<H>` in
    /// `hash<H>(...)`) need no scope entry: a written `H` inside is stamped
    /// `GenericParam`, which names no template whatever else is spelled `H`.
    static rewrite_function_decl(func_decl: DeclarationNode*,
                                  reg: GenericRegistry*,
                                  scope: ScopeStack*) -> void {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null) { return; }
        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const p_decl: DeclarationNode* = func.parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p != null && p.has_type_annotation()) {
                DefaultExpansionPasses::rewrite_annotation_in_place(
                    p.type_annotation, reg, scope);
            }
        }
        if (func.return_type_annotation != null) {
            DefaultExpansionPasses::rewrite_annotation_in_place(
                func.return_type_annotation, reg, scope);
        }
        if (func.has_body()) {
            DefaultExpansionPasses::rewrite_body_stmt(func.body, reg, scope);
        }
    }

    /// Walk a statement, rewriting any annotations inside.  Statements
    /// can carry annotations directly (variable declarations) or
    /// indirectly via nested expressions (casts, sizeof, struct
    /// literals' field-init values that are themselves expressions).
    static rewrite_body_stmt(stmt: Stmt*, reg: GenericRegistry*,
                              scope: ScopeStack*) -> void {
        if (stmt == null) { return; }
        match (stmt.shape) {
            StmtKind::Block(b) => {
                for (mut i: i64 = 0; i < b.statements.length; i++) {
                    DefaultExpansionPasses::rewrite_body_stmt(b.statements[i], reg, scope);
                }
            }
            StmtKind::UnsafeBlock(ub) => {
                DefaultExpansionPasses::rewrite_body_stmt(ub.block, reg, scope);
            }
            StmtKind::Expr(es) => {
                DefaultExpansionPasses::rewrite_expr(es.expression, reg, scope);
            }
            StmtKind::Decl(ds) => {
                if (ds.declaration != null) {
                    const decl_node: ASTNode* = ds.declaration as ASTNode*;
                    if (DeclarationNode::var_of(decl_node) != null) {
                        DefaultExpansionPasses::rewrite_var_decl(
                            DeclarationNode::var_of(ds.declaration), reg, scope);
                    }
                }
            }
            StmtKind::Return(rs) => {
                if (rs.expression != null) {
                    DefaultExpansionPasses::rewrite_expr(rs.expression, reg, scope);
                }
            }
            StmtKind::If(is_) => {
                DefaultExpansionPasses::rewrite_expr(is_.condition, reg, scope);
                DefaultExpansionPasses::rewrite_body_stmt(is_.then_stmt, reg, scope);
                DefaultExpansionPasses::rewrite_body_stmt(is_.else_stmt, reg, scope);
            }
            StmtKind::While(ws) => {
                DefaultExpansionPasses::rewrite_expr(ws.condition, reg, scope);
                DefaultExpansionPasses::rewrite_body_stmt(ws.body, reg, scope);
            }
            StmtKind::DoWhile(dw) => {
                DefaultExpansionPasses::rewrite_expr(dw.condition, reg, scope);
                DefaultExpansionPasses::rewrite_body_stmt(dw.body, reg, scope);
            }
            StmtKind::For(fs) => {
                // `init` is a variable declaration or an expression, which
                // are not statements; a statement there is walked as one.
                if (fs.init != null && fs.init.kind == NodeKind::Statement) {
                    DefaultExpansionPasses::rewrite_body_stmt(fs.init as Stmt*, reg, scope);
                }
                if (fs.condition != null) {
                    DefaultExpansionPasses::rewrite_expr(fs.condition, reg, scope);
                }
                if (fs.update != null) {
                    DefaultExpansionPasses::rewrite_expr(fs.update, reg, scope);
                }
                DefaultExpansionPasses::rewrite_body_stmt(fs.body, reg, scope);
            }
            StmtKind::Loop(ls) => {
                DefaultExpansionPasses::rewrite_body_stmt(ls.body, reg, scope);
            }
            StmtKind::Match(ms) => {
                DefaultExpansionPasses::rewrite_expr(ms.subject, reg, scope);
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm == null) { continue; }
                    if (arm.guard != null) {
                        DefaultExpansionPasses::rewrite_expr(arm.guard, reg, scope);
                    }
                    DefaultExpansionPasses::rewrite_body_stmt(arm.body, reg, scope);
                }
            }
            StmtKind::StaticMatch(sms) => {
                DefaultExpansionPasses::rewrite_annotation_in_place(sms.scrutinee, reg, scope);
                for (mut i: i64 = 0; i < sms.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sms.arms[i];
                    if (arm == null) { continue; }
                    for (mut p: i64 = 0; p < arm.type_patterns.length; p++) {
                        DefaultExpansionPasses::rewrite_annotation_in_place(arm.type_patterns[p], reg, scope);
                    }
                    DefaultExpansionPasses::rewrite_body_stmt(arm.body, reg, scope);
                }
            }
            StmtKind::Asm(_) | StmtKind::Break | StmtKind::Continue => {}
        }
    }

    /// Rewrite annotations in a variable declaration `mut x: T = ...` form).
    /// Both the declared type and the initializer expression need walking.
    static rewrite_var_decl(var_decl: VarDecl*, reg: GenericRegistry*,
                             scope: ScopeStack*) -> void {
        if (var_decl == null) { return; }
        if (var_decl.has_type_annotation()) {
            DefaultExpansionPasses::rewrite_annotation_in_place(
                var_decl.type_annotation, reg, scope);
        }
        if (var_decl.initializer != null) {
            DefaultExpansionPasses::rewrite_expr(var_decl.initializer, reg, scope);
        }
    }

    /// Walk an expression, rewriting any annotations in cast targets,
    /// sizeof/alignof type args, struct literal type names, generic args
    /// on calls, etc.  Recurses into all subexpressions so nested
    /// annotations are reachable.
    static rewrite_expr(expr: ExpressionNode*, reg: GenericRegistry*,
                         scope: ScopeStack*) -> void {
        if (expr == null) { return; }
        const node: ASTNode* = expr as ASTNode*;
        match (node.kind) {
            NodeKind::BinaryExpression => {
                const b: BinaryExprNode* = expr as BinaryExprNode*;
                DefaultExpansionPasses::rewrite_expr(b.left, reg, scope);
                DefaultExpansionPasses::rewrite_expr(b.right, reg, scope);
            }
            NodeKind::UnaryExpression => {
                const u: UnaryExprNode* = expr as UnaryExprNode*;
                DefaultExpansionPasses::rewrite_expr(u.operand, reg, scope);
            }
            NodeKind::MatchExpression => {
                const me: MatchExprNode* = expr as MatchExprNode*;
                DefaultExpansionPasses::rewrite_expr(me.subject, reg, scope);
                for (mut i: i64 = 0; i < me.arms.length; i++) {
                    const arm: MatchArmNode* = me.arms[i];
                    if (arm == null) { continue; }
                    if (arm.guard != null) {
                        DefaultExpansionPasses::rewrite_expr(arm.guard, reg, scope);
                    }
                    if (arm.body != null) {
                        DefaultExpansionPasses::rewrite_body_stmt(arm.body, reg, scope);
                    }
                }
            }
            NodeKind::StaticMatchExpression => {
                const sme: StaticMatchExprNode* = expr as StaticMatchExprNode*;
                DefaultExpansionPasses::rewrite_annotation_in_place(sme.scrutinee, reg, scope);
                for (mut i: i64 = 0; i < sme.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sme.arms[i];
                    if (arm == null) { continue; }
                    for (mut p: i64 = 0; p < arm.type_patterns.length; p++) {
                        DefaultExpansionPasses::rewrite_annotation_in_place(arm.type_patterns[p], reg, scope);
                    }
                    if (arm.body != null) {
                        DefaultExpansionPasses::rewrite_body_stmt(arm.body, reg, scope);
                    }
                }
            }
            NodeKind::CallExpression => {
                const c: CallExprNode* = expr as CallExprNode*;
                DefaultExpansionPasses::rewrite_expr(c.callee, reg, scope);
                for (mut i: i64 = 0; i < c.arguments.length; i++) {
                    DefaultExpansionPasses::rewrite_expr(c.arguments[i], reg, scope);
                }
                for (mut i: i64 = 0; i < c.generic_args.length; i++) {
                    DefaultExpansionPasses::rewrite_annotation_in_place(
                        c.generic_args[i], reg, scope);
                }
            }
            NodeKind::CastExpression => {
                const ce: CastExprNode* = expr as CastExprNode*;
                DefaultExpansionPasses::rewrite_expr(ce.expression, reg, scope);
                if (ce.target_annotation != null) {
                    DefaultExpansionPasses::rewrite_annotation_in_place(
                        ce.target_annotation, reg, scope);
                }
            }
            NodeKind::Expression => {
                match (expr.shape) {
                    ExprKind::Ternary(t) => {
                        DefaultExpansionPasses::rewrite_expr(t.condition, reg, scope);
                        DefaultExpansionPasses::rewrite_expr(t.true_expr, reg, scope);
                        DefaultExpansionPasses::rewrite_expr(t.false_expr, reg, scope);
                    }
                    ExprKind::If(ie) => {
                        DefaultExpansionPasses::rewrite_expr(ie.condition, reg, scope);
                        DefaultExpansionPasses::rewrite_expr(ie.then_expr, reg, scope);
                        DefaultExpansionPasses::rewrite_expr(ie.else_expr, reg, scope);
                    }
                    ExprKind::Sizeof(so) => {
                        if (so.type_ann != null) {
                            DefaultExpansionPasses::rewrite_annotation_in_place(
                                so.type_ann, reg, scope);
                        }
                    }
                    ExprKind::Alignof(ao) => {
                        if (ao.type_ann != null) {
                            DefaultExpansionPasses::rewrite_annotation_in_place(
                                ao.type_ann, reg, scope);
                        }
                    }
                    ExprKind::New(ne) => {
                        for (mut i: i64 = 0; i < ne.arguments.length; i++) {
                            DefaultExpansionPasses::rewrite_expr(ne.arguments[i], reg, scope);
                        }
                        for (mut i: i64 = 0; i < ne.generic_args.length; i++) {
                            DefaultExpansionPasses::rewrite_annotation_in_place(
                                ne.generic_args[i], reg, scope);
                        }
                        if (ne.array_size != null) {
                            DefaultExpansionPasses::rewrite_expr(ne.array_size, reg, scope);
                        }
                        if (ne.struct_init != null) {
                            DefaultExpansionPasses::rewrite_expr(ne.struct_init, reg, scope);
                        }
                    }
                    ExprKind::Struct(sl) => {
                        for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                            const fi: FieldInit = sl.field_inits[i];
                            if (fi.value != null) {
                                DefaultExpansionPasses::rewrite_expr(fi.value, reg, scope);
                            }
                        }
                        for (mut i: i64 = 0; i < sl.generic_args.length; i++) {
                            DefaultExpansionPasses::rewrite_annotation_in_place(
                                sl.generic_args[i], reg, scope);
                        }
                    }
                    ExprKind::Array(al) => {
                        for (mut i: i64 = 0; i < al.elements.length; i++) {
                            DefaultExpansionPasses::rewrite_expr(al.elements[i], reg, scope);
                        }
                    }
                    ExprKind::Tuple(tl) => {
                        for (mut i: i64 = 0; i < tl.elements.length; i++) {
                            DefaultExpansionPasses::rewrite_expr(tl.elements[i], reg, scope);
                        }
                    }
                    // Runs before sema lowers `?`, so only `operand` exists.
                    ExprKind::Try(t) => {
                        DefaultExpansionPasses::rewrite_expr(t.operand, reg, scope);
                    }
                    // Not rewritten: their operands are not walked here.
                    ExprKind::Typeof(_) => { }
                    ExprKind::Delete(_) => { }
                    ExprKind::Yield(_)  => { }
                    // Holds no annotation or expression.
                    ExprKind::Literal(_) => { }
                    ExprKind::Legacy    => { }
                }
            }
            NodeKind::ArrayAccess => {
                const aa: ArrayAccessNode* = expr as ArrayAccessNode*;
                DefaultExpansionPasses::rewrite_expr(aa.array, reg, scope);
                DefaultExpansionPasses::rewrite_expr(aa.index, reg, scope);
            }
            NodeKind::MemberAccess => {
                const ma: MemberAccessNode* = expr as MemberAccessNode*;
                DefaultExpansionPasses::rewrite_expr(ma.object, reg, scope);
            }
            NodeKind::ScopeResolution => {
                const sr: ScopeResolutionNode* = expr as ScopeResolutionNode*;
                // Default-expand the scope itself: `String::from_str(...)`
                // where `struct String<A = GlobalAlloc>` should become
                // `String<GlobalAlloc>::from_str(...)`.  Without this, the
                // call resolves to the bare-template method whose return
                // type still references the bare `String`, and the LLVM
                // signature mismatches with the spec'd target type at the
                // call site.
                //
                // The segment's stamp is `TypeRelative(Def(d), _)` when it
                // names a type; a module (`Def`), a primitive or a parameter
                // names no template and is left alone.
                if (sr.scope_generic_args.length == 0) {
                    mut d: DefId = DefId::invalid();
                    match (sr.require_scope_res("default_expansion:scope segment")) {
                        Res::TypeRelative(ResBase::Def(td), _) => { d = td; }
                        _ => {}
                    }
                    if (d.is_valid() && !scope.contains(d)) {
                        const defaults: [TypeAnnotation*] = DefaultExpansionPasses::defaults_of(d, reg);
                        if (defaults.length > 0) {
                            sr.scope_generic_args = defaults;
                        }
                    }
                }
                for (mut i: i64 = 0; i < sr.generic_args.length; i++) {
                    DefaultExpansionPasses::rewrite_annotation_in_place(
                        sr.generic_args[i], reg, scope);
                }
                for (mut i: i64 = 0; i < sr.scope_generic_args.length; i++) {
                    DefaultExpansionPasses::rewrite_annotation_in_place(
                        sr.scope_generic_args[i], reg, scope);
                }
            }
            _ => {}
        }
    }

    // Annotation rewriting

    /// Recursively rewrite a TypeAnnotation in place. The annotation enum
    /// is mutated through its tagged-union pointer so all consumers
    /// (already pointing at this node) see the rewritten form.
    static rewrite_annotation_in_place(ann: TypeAnnotation*,
                                        reg: GenericRegistry*,
                                        scope: ScopeStack*) -> void {
        if (ann == null) { return; }
        match (*ann) {
            TypeAnnotation::Named(named) => {
                // A definition's stamp is the question; a parameter, a
                // primitive or a refused name is not a template and is left
                // as written.
                const d: DefId = named.res.require("default_expansion:named annotation").def_id();
                if (!d.is_valid() || scope.contains(d)) { return; }
                const defaults: [TypeAnnotation*] = DefaultExpansionPasses::defaults_of(d, reg);
                if (defaults.length == 0) { return; }

                // Rewrite Named(X) -> Generic(Named(X), [defaults])
                // by mutating the enum tag through the pointer.
                const old_name: SymbolStr = named.name;
                const old_span: SourceSpan = named.span;

                // Allocate a fresh inner Named annotation that the new
                // Generic node points to.
                // Arena-backed like `TypeAnnotation::clone()`: `new` routes
                // through the per-target arena (reclaimed on reset) instead of a
                // raw `malloc` that leaks with the ctx on every LSP recompile.
                // The node being replaced was answered for by NameResolution,
                // in the scope it was written in; this one spells the same
                // name at the same span, so it inherits that answer.  Dropping
                // it would leave the only carrier of what the spelling names
                // to be re-derived from the leaf by whichever stage needs it.
                const old_res: ResSlot = named.res;
                const inner_named: NamedAnnotation* = new NamedAnnotation {
                    name: old_name,
                    span: old_span,
                    pre_resolved: TypeRef::invalid(),
                    res: old_res,
                };
                const inner_ann: TypeAnnotation* = new TypeAnnotation::Named(inner_named);

                const gen: GenericAnnotation* = new GenericAnnotation {
                    base: inner_ann,
                    args: defaults,
                    span: old_span,
                };
                *ann = TypeAnnotation::Generic(gen);

                // The new Generic's args may themselves reference templates
                // that need rewriting (e.g. `Array<u8, GlobalAlloc>` where
                // both args could be expansion candidates); recurse over
                // each arg using the same scope.
                for (mut i: i64 = 0; i < gen.args.length; i++) {
                    DefaultExpansionPasses::rewrite_annotation_in_place(
                        gen.args[i], reg, scope);
                }
            }
            TypeAnnotation::Pointer(p) => {
                DefaultExpansionPasses::rewrite_annotation_in_place(p.inner, reg, scope);
            }
            TypeAnnotation::Reference(r) => {
                DefaultExpansionPasses::rewrite_annotation_in_place(r.inner, reg, scope);
            }
            TypeAnnotation::Array(a) => {
                DefaultExpansionPasses::rewrite_annotation_in_place(a.element, reg, scope);
            }
            TypeAnnotation::Function(f) => {
                for (mut i: i64 = 0; i < f.parameters.length; i++) {
                    DefaultExpansionPasses::rewrite_annotation_in_place(
                        f.parameters[i], reg, scope);
                }
                DefaultExpansionPasses::rewrite_annotation_in_place(
                    f.return_type, reg, scope);
            }
            TypeAnnotation::Tuple(t) => {
                for (mut i: i64 = 0; i < t.elements.length; i++) {
                    DefaultExpansionPasses::rewrite_annotation_in_place(
                        t.elements[i], reg, scope);
                }
            }
            TypeAnnotation::Generic(g) => {
                // Recurse into the base ONLY if it isn't already a Named;
                // an already-explicit `Named("X")<args>` shouldn't have its
                // base re-expanded into another `Generic`, which would yield
                // `Generic(Generic(Named("X"), [defaults]), args)`.  The
                // outer args are the user-supplied bindings; preserve them.
                match (*g.base) {
                    TypeAnnotation::Named(_) => { /* skip; args already explicit */ }
                    _ => {
                        DefaultExpansionPasses::rewrite_annotation_in_place(g.base, reg, scope);
                    }
                }
                for (mut i: i64 = 0; i < g.args.length; i++) {
                    DefaultExpansionPasses::rewrite_annotation_in_place(
                        g.args[i], reg, scope);
                }
            }
            _ => {}
        }
    }
}
