/// Config-Gating Pass
///
/// Strips top-level declarations whose attached `![config(...)]` /
/// `![target(...)]` / bare-OS-atom (`![windows]`, `![linux]`,
/// `![macos]`, `![unix]`) directives evaluate to "inactive" against the
/// resolved target triple.  Runs immediately after parsing so downstream
/// passes (ASTValidation, NameResolution, type checking, etc.) never see
/// declarations whose `extern` references would fail to resolve on the
/// current target.
///
/// Vocabulary:
///   ![windows]                   active iff target OS is windows
///   ![linux]                     active iff target OS is linux
///   ![macos]                     active iff target OS is macos
///   ![unix]                      active iff target OS is linux or macos
///   ![config(<atom>)]            same as ![<atom>]
///   ![target(<atom>)]            same as ![<atom>]
///   ![config(not(<atom>))]       active iff <atom> is NOT the target OS
///
/// `![config(testing)]` is left untouched — its existing namespace-marker
/// semantics in DirectiveProcessing are independent of platform gating.
///
/// Block-level inline gates (`![config(windows)] { stmt; ... }` inside
/// function bodies) are NOT handled here — that requires a parser/AST
/// extension and lives in a follow-up pass.

namespace Compiler::Passes::ConfigGating;

import Compiler::AST;
import Compiler::AST::Node;
import Compiler::AST::Declaration;
import Compiler::AST::Statement;
import Compiler::AST::Pattern;
import Compiler::Passes::PassID;
import Compiler::CompilationContext;
import Compiler::Codegen::LLVMTypes;
import Utils::Logger;


// ============================================================================
// Active-target resolution
// ============================================================================

/// Atomic OS classification derived from a target triple.
type enum HostOS {
    Windows;
    Linux;
    Macos;
    Other;
}

/// Map an LLVM target triple substring to a HostOS atom.  Triples look
/// like `x86_64-pc-linux-gnu`, `x86_64-pc-windows-gnu`,
/// `x86_64-apple-darwin`; we just substring-match the OS field.
function classify_triple(triple: string) -> HostOS {
    if (strstr(triple, "windows") != null) { return HostOS::Windows; }
    if (strstr(triple, "linux") != null)   { return HostOS::Linux; }
    if (strstr(triple, "darwin") != null)  { return HostOS::Macos; }
    if (strstr(triple, "macos") != null)   { return HostOS::Macos; }
    if (strstr(triple, "apple") != null)   { return HostOS::Macos; }
    return HostOS::Other;
}

/// Resolve the active target OS from CompilationContext.  Honors
/// `ctx.target_triple` (set by Instance from CLI / cryoconfig) and
/// falls back to the host triple from LLVM.
function active_os(ctx: CompilationContext*) -> HostOS {
    const triple: string = resolve_effective_triple(ctx.target_triple);
    return classify_triple(triple);
}


// ============================================================================
// Atom matching
// ============================================================================

/// True iff `atom` (case-sensitive lowercase) names the active OS.
/// `unix` matches when the active OS is Linux or Macos.
function atom_matches(atom: string, os: HostOS) -> boolean {
    if (strcmp(atom, "windows") == 0) {
        return match (os) { HostOS::Windows => { true } _ => { false } };
    }
    if (strcmp(atom, "linux") == 0) {
        return match (os) { HostOS::Linux => { true } _ => { false } };
    }
    if (strcmp(atom, "macos") == 0) {
        return match (os) { HostOS::Macos => { true } _ => { false } };
    }
    if (strcmp(atom, "unix") == 0) {
        return match (os) {
            HostOS::Linux => { true }
            HostOS::Macos => { true }
            _             => { false }
        };
    }
    // Unknown atom — treat as inactive rather than crashing.  The
    // directive processor emits a warning for unknown vocabulary so the
    // user sees a real diagnostic.
    return false;
}

/// True iff `atom` is a recognized OS atom (one of windows/linux/macos/unix).
/// Used to distinguish `config(testing)` (not a platform gate; left alone)
/// from `config(windows)` (a platform gate; subject to evaluation).
function is_os_atom(atom: string) -> boolean {
    return strcmp(atom, "windows") == 0
        || strcmp(atom, "linux")   == 0
        || strcmp(atom, "macos")   == 0
        || strcmp(atom, "unix")    == 0;
}


// ============================================================================
// Directive evaluation
// ============================================================================

/// Result of evaluating one directive against the active target.
type enum CfgEvalResult {
    /// Directive is a cfg gate and its atom matches the active target —
    /// declaration should survive.
    Active;
    /// Directive is a cfg gate and its atom does NOT match the active
    /// target — declaration should be stripped.
    Inactive;
    /// Directive is not a platform gate (e.g. `![inline]`,
    /// `![config(testing)]`) — has no bearing on stripping.
    NotAGate;
}

/// Evaluate a single `not(<atom>)` nested call.  Returns Active if the
/// inner atom does NOT match the active OS, Inactive if it does.
function eval_not_call(inner: DirectiveNode*, os: HostOS) -> CfgEvalResult {
    if (inner == null) { return CfgEvalResult::NotAGate; }
    if (inner.args.length != 1) {
        // Malformed `not(...)` — directive_processing emits a diagnostic.
        // Treat as a no-op rather than dropping the decl silently.
        return CfgEvalResult::NotAGate;
    }
    const a: DirectiveArg = inner.args[0];
    if (a.kind != DirectiveArgKind::Ident) {
        return CfgEvalResult::NotAGate;
    }
    if (!is_os_atom(a.name)) {
        return CfgEvalResult::NotAGate;
    }
    if (atom_matches(a.name, os)) {
        return CfgEvalResult::Inactive;
    }
    return CfgEvalResult::Active;
}

/// Classify the gate inside `![config(...)]` / `![target(...)]`.  The
/// directive must have exactly one arg for the platform-gate forms we
/// support; everything else is a NotAGate (e.g. `config(testing)`,
/// multi-arg `cfg(any(...))` which we defer until vocabulary expansion).
function eval_config_args(d: DirectiveNode*, os: HostOS) -> CfgEvalResult {
    if (d.args.length != 1) {
        return CfgEvalResult::NotAGate;
    }
    const a: DirectiveArg = d.args[0];

    // Bare-ident form: `config(windows)`.
    if (a.kind == DirectiveArgKind::Ident) {
        if (!is_os_atom(a.name)) {
            return CfgEvalResult::NotAGate;
        }
        if (atom_matches(a.name, os)) {
            return CfgEvalResult::Active;
        }
        return CfgEvalResult::Inactive;
    }

    // Nested call: `config(not(windows))`.
    if (a.kind == DirectiveArgKind::Nested) {
        const inner: DirectiveNode* = a.nested;
        if (inner == null) { return CfgEvalResult::NotAGate; }
        if (strcmp(inner.directive_kind, "not") == 0) {
            return eval_not_call(inner, os);
        }
        // `any(...)` / `all(...)` deferred until vocabulary expansion.
        return CfgEvalResult::NotAGate;
    }

    return CfgEvalResult::NotAGate;
}

/// Evaluate one attached directive.  Maps the bare-OS-atom,
/// `![not(<atom>)]`, and `![config(...)]` / `![target(...)]` forms onto
/// a CfgEvalResult; everything else is NotAGate.
function eval_directive(d: DirectiveNode*, os: HostOS) -> CfgEvalResult {
    if (d == null) { return CfgEvalResult::NotAGate; }

    // Bare form: `![windows]`, `![linux]`, etc.
    if (is_os_atom(d.directive_kind)) {
        if (atom_matches(d.directive_kind, os)) {
            return CfgEvalResult::Active;
        }
        return CfgEvalResult::Inactive;
    }

    // Bare negation: `![not(<atom>)]`.  Mirrors the nested `not(...)`
    // form inside `config(...)` for consistency.
    if (strcmp(d.directive_kind, "not") == 0) {
        return eval_not_call(d, os);
    }

    // Wrapped form: `![config(...)]` / `![target(...)]`.
    if (strcmp(d.directive_kind, "config") == 0
            || strcmp(d.directive_kind, "target") == 0) {
        return eval_config_args(d, os);
    }

    return CfgEvalResult::NotAGate;
}


// ============================================================================
// Declaration filtering
// ============================================================================

/// True iff this declaration's attached_directives include at least one
/// platform gate that evaluates to Inactive.  A decl is stripped only if
/// some gate disqualifies it; if no gates are present (or all are
/// NotAGate / Active), the decl survives.  Multiple gates on a single
/// decl are AND'd: `![windows] ![linux] fn` would be impossible to
/// satisfy, which is the sensible behavior — both must be active.
function decl_is_active(decl: DeclarationNode*, os: HostOS) -> boolean {
    if (decl == null) { return true; }
    for (mut i: i64 = 0; i < decl.attached_directives.length; i++) {
        const d: DirectiveNode* = decl.attached_directives[i];
        const r: CfgEvalResult = eval_directive(d, os);
        if (match (r) { CfgEvalResult::Inactive => { true } _ => { false } }) {
            return false;
        }
    }
    return true;
}

/// Same predicate for block-attached directives.  Used by the
/// function-body walker to decide whether `![dir] { ... }` blocks
/// survive.
function block_is_active(block: BlockStmtNode*, os: HostOS) -> boolean {
    if (block == null) { return true; }
    for (mut i: i64 = 0; i < block.attached_directives.length; i++) {
        const d: DirectiveNode* = block.attached_directives[i];
        const r: CfgEvalResult = eval_directive(d, os);
        if (match (r) { CfgEvalResult::Inactive => { true } _ => { false } }) {
            return false;
        }
    }
    return true;
}


// ============================================================================
// Function-body walker
// ============================================================================

/// Walk a block's statements, filtering out child BlockStmt nodes whose
/// attached cfg directives are inactive.  Recurses into nested blocks
/// so gates can sit at any nesting level.  Active gated blocks have
/// their `attached_directives` cleared once kept — downstream passes
/// see them as plain blocks.
function process_block(block: BlockStmtNode*, os: HostOS, ctx: CompilationContext*) -> void {
    if (block == null) { return; }
    // Fast-path scan: most function bodies have no inline cfg-gated
    // sub-blocks at all.  Skip the rebuild loop in that case so we
    // don't touch `block.statements` — array assignment through a
    // class-field write is a known-fragile codegen path on the
    // current pin.
    mut needs_filter: boolean = false;
    for (mut i: i64 = 0; i < block.statements.length; i++) {
        const stmt: StatementNode* = block.statements[i];
        if (stmt == null) { continue; }
        if (stmt.kind == NodeKind::BlockStatement) {
            const inner: BlockStmtNode* = stmt as BlockStmtNode*;
            if (inner.has_directives()) { needs_filter = true; break; }
        }
    }
    if (!needs_filter) { return; }

    mut kept: StatementNode*[] = [];
    for (mut i: i64 = 0; i < block.statements.length; i++) {
        const stmt: StatementNode* = block.statements[i];
        if (stmt == null) { continue; }

        if (stmt.kind == NodeKind::BlockStatement) {
            const inner: BlockStmtNode* = stmt as BlockStmtNode*;
            if (inner.has_directives() && !block_is_active(inner, os)) {
                if (ctx.debug_mode) {
                    cdebug("[ConfigGating] stripped inline block at line %u\n",
                        inner.span.start_line);
                }
                continue;
            }
            process_block(inner, os, ctx);
        }
        kept.push(stmt);
    }
    block.statements = kept;
}


/// Walk every method body in `methods`, processing cfg-gated blocks.
/// Hoisted out of `run()` so a single call site invokes process_block
/// with `m.body` — the bootstrap miscompiles when this same pattern
/// appears repeatedly inside a `match` expression's arms.
function walk_method_bodies(methods: MethodNode*[], os: HostOS, ctx: CompilationContext*) -> void {
    for (mut i: i64 = 0; i < methods.length; i++) {
        const m: MethodNode* = methods[i];
        if (m != null) {
            const body: BlockStmtNode* = m.body;
            process_block(body, os, ctx);
        }
    }
}


// ============================================================================
// Pass entry point
// ============================================================================

/// Walks the program's top-level statements and removes declarations
/// whose attached cfg gates evaluate to Inactive.  Non-declaration
/// top-level statements (raw expressions, namespace markers, imports
/// without directives) pass through untouched.
function run(ctx: CompilationContext*) -> PassResult {
    const root: ProgramNode* = ctx.artifacts.ast.root;
    if (root == null) {
        return PassResult::ok();
    }

    const os: HostOS = active_os(ctx);

    mut kept: ASTNode*[] = [];
    mut stripped: i64 = 0;

    for (mut i: i64 = 0; i < root.statements.length; i++) {
        const stmt: ASTNode* = root.statements[i];
        if (stmt == null) { continue; }

        // Only DeclarationNode subclasses carry attached_directives.
        // Everything else passes through.
        const k: NodeKind = stmt.kind;
        const is_decl: boolean = match (k) {
            NodeKind::VariableDeclaration       => { true }
            NodeKind::DestructureDeclaration    => { true }
            NodeKind::FunctionDeclaration       => { true }
            NodeKind::MethodDeclaration         => { true }
            NodeKind::IntrinsicDeclaration      => { true }
            NodeKind::IntrinsicConstDeclaration => { true }
            NodeKind::ImportDeclaration         => { true }
            NodeKind::ModuleDeclaration         => { true }
            NodeKind::StructDeclaration         => { true }
            NodeKind::ClassDeclaration          => { true }
            NodeKind::EnumDeclaration           => { true }
            NodeKind::TraitDeclaration          => { true }
            NodeKind::TypeAliasDeclaration      => { true }
            NodeKind::ImplementationBlock       => { true }
            NodeKind::ExternBlock               => { true }
            _                                   => { false }
        };

        if (!is_decl) {
            kept.push(stmt);
            continue;
        }

        const decl: DeclarationNode* = stmt as DeclarationNode*;
        if (!decl_is_active(decl, os)) {
            stripped = stripped + 1;
            if (ctx.debug_mode) {
                cdebug("[ConfigGating] stripped %s for target os\n",
                    k.to_string());
            }
            continue;
        }

        // Phase 2b: recurse into function/method bodies for inline
        // `![dir] { ... }` gates.  Method/Impl/Class/Struct recursion
        // is currently disabled — the pin's match codegen miscompiles
        // consecutive class-cast-and-call arms.  After this binary is
        // pinned, the next session can re-enable those branches with
        // a clean pin that handles the pattern correctly.
        if (k == NodeKind::FunctionDeclaration) {
            const fd: FunctionDeclNode* = stmt as FunctionDeclNode*;
            const body: BlockStmtNode* = fd.body;
            if (body != null) {
                process_block(body, os, ctx);
            }
        }
        if (k == NodeKind::MethodDeclaration) {
            const md: MethodNode* = stmt as MethodNode*;
            const mbody: BlockStmtNode* = md.body;
            if (mbody != null) {
                process_block(mbody, os, ctx);
            }
        }
        kept.push(stmt);
    }

    if (stripped > 0) {
        root.statements = kept;
        if (ctx.debug_mode) {
            cdebug("[ConfigGating] stripped %lld decl(s); %lld remain\n",
                stripped, kept.length);
        }
    }

    return PassResult::ok();
}
