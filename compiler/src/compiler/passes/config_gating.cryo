/// Config-Gating Pass
///
/// Strips top-level declarations whose attached `![config(...)]` /
/// `![target(...)]` / bare-OS-atom (`![windows]`, `![linux]`,
/// `![macos]`, `![unix]`) directives evaluate to "inactive" against the
/// resolved target triple.  Runs immediately after parsing so downstream
/// passes (ASTValidation, NameResolution, type checking, etc.) never see
/// declarations whose `extern` references would fail to resolve on the
/// current target.
///
/// Vocabulary:
///   ![windows]                   active if target OS is windows
///   ![linux]                     active if target OS is linux
///   ![macos]                     active if target OS is macos
///   ![unix]                      active if target OS is linux or macos
///   ![config(<atom>)]            same as ![<atom>]
///   ![target(<atom>)]            same as ![<atom>]
///   ![config(not(<atom>))]       active if <atom> is NOT the target OS
///
/// `![config(testing)]` is left untouched; its existing namespace-marker
/// semantics in DirectiveProcessing are independent of platform gating.
///
/// Scope of stripping:
///   * top-level declarations (functions, structs, classes, enums,
///     traits, type aliases, impl/extern blocks, ...) via their attached
///     directives;
///   * whole `![target(...)]`-gated METHODS inside struct/class/impl
///     bodies (filtered out of the owning node's `methods` list);
///   * inline `![dir] { stmt; ... }` blocks inside function AND method
///     bodies (see `process_block`).
/// Struct/class FIELDS and enum VARIANTS are intentionally NOT gated:
/// gating a data member would diverge a type's layout per platform.  Gate
/// the whole type instead (write two same-named decls, one per OS).

namespace Compiler::Passes::ConfigGating;

import Compiler::AST;
import Compiler::AST::{ Node, Declaration, Statement, Pattern };
import Compiler::Passes::PassID;
import Compiler::CompilationContext;
import Compiler::Codegen::LLVMTypes;
import Compiler::Diag;
import Utils::Logger;


// Active-target resolution

/// Atomic OS classification derived from a target triple.
type enum HostOS {
    Windows;
    Linux;
    Macos;
    Other;
}

implement enum HostOS {
    /// Map an LLVM target triple substring to a HostOS atom.  Triples look
    /// like `x86_64-pc-linux-gnu`, `x86_64-pc-windows-gnu`,
    /// `x86_64-apple-darwin`; we just substring-match the OS field.
    static from_triple(triple: string) -> HostOS {
        if (triple.contains("windows")) { return HostOS::Windows; }
        if (triple.contains("linux"))   { return HostOS::Linux; }
        if (triple.contains("darwin"))  { return HostOS::Macos; }
        if (triple.contains("macos"))   { return HostOS::Macos; }
        if (triple.contains("apple"))   { return HostOS::Macos; }
        return HostOS::Other;
    }

    /// True if `atom` (case-sensitive lowercase) names this OS.  `unix`
    /// matches when the OS is Linux or Macos.  Unknown atoms are treated
    /// as inactive rather than crashing - the directive processor emits a
    /// warning for unknown vocabulary so the user still sees a real
    /// diagnostic.
    matches(&this, atom: string) -> boolean {
        if (atom.eq("windows")) {
            return match (this) { HostOS::Windows => { true } _ => { false } };
        }
        if (atom.eq("linux")) {
            return match (this) { HostOS::Linux => { true } _ => { false } };
        }
        if (atom.eq("macos")) {
            return match (this) { HostOS::Macos => { true } _ => { false } };
        }
        if (atom.eq("unix")) {
            return match (this) {
                HostOS::Linux => { true }
                HostOS::Macos => { true }
                _             => { false }
            };
        }
        return false;
    }

    /// True if `atom` is a recognized OS atom (one of windows/linux/macos/unix).
    /// Used to distinguish `config(testing)` (not a platform gate; left alone)
    /// from `config(windows)` (a platform gate; subject to evaluation).
    static is_os_atom(atom: string) -> boolean {
        return match (atom) {
            "windows" | "linux" | "macos" | "unix" => { true }
            _                                      => { false }
        };
    }
}



/// The active build configuration a `![config(...)]` gate resolves against:
/// the target OS plus the low-level feature flags.  Replaces the bare
/// `HostOS` that used to thread through the gating routines so that non-OS
/// atoms (`native_alloc`, ...) can gate on a build flag instead of the
/// target triple.
///
/// Feature flags here are MIGRATION SWITCHES, not product features: a flag
/// exists while a subsystem's native reimplementation bakes against its libc
/// predecessor, and is deleted (with its gated arms collapsing to the native
/// implementation) once proven.  `native_syscalls` (Stage 2) already
/// completed that lifecycle.
type struct CfgEnv {
    os: HostOS;
    native_alloc: boolean;
    no_runtime: boolean;

    /// Resolve from CompilationContext: OS from the effective target triple
    /// (honors `--target` / cryoconfig, host fallback), feature flags from
    /// their context fields (cryoconfig `[low_level]`).
    static from_ctx(ctx: CompilationContext*) -> CfgEnv {
        const triple: string = LTargetMachine::resolve_effective_triple(ctx.target_triple);
        const os: HostOS = HostOS::from_triple(triple);
        // `native_alloc` selects the native mmap-backed heap behind
        // `GlobalAlloc` (Low-Level Plan Stage 3).  NOT clamped per-OS: the
        // allocator is dual-OS by design (page provider = `sys::mmap` on
        // unix, `VirtualAlloc` on windows), so the flag is meaningful on
        // every supported target.
        return CfgEnv {
            os: os,
            native_alloc: ctx.native_alloc,
            // `no_runtime` gates freestanding-only declarations (e.g. a
            // `![config(no_runtime)]` `_start`).  Dual-OS by design.
            no_runtime: ctx.project_no_runtime,
        };
    }

    /// True if `atom` names a known non-OS feature flag (parallels
    /// `HostOS::is_os_atom`).  Keep in sync with `feature_active`.
    static is_feature_atom(atom: string) -> boolean {
        return atom.eq("native_alloc") || atom.eq("no_runtime");
    }

    /// Evaluate a known feature atom against this env's flags.  Precondition:
    /// `CfgEnv::is_feature_atom(atom)` is true.
    feature_active(&this, atom: string) -> boolean {
        if (atom.eq("native_alloc")) { return this.native_alloc; }
        if (atom.eq("no_runtime")) { return this.no_runtime; }
        return false;
    }
}

// Directive evaluation

/// Result of evaluating one directive against the active target.
type enum CfgEvalResult {
    /// Directive is a cfg gate and its atom matches the active target;
    /// declaration should survive.
    Active;
    /// Directive is a cfg gate and its atom does NOT match the active
    /// target; declaration should be stripped.
    Inactive;
    /// Directive is not a platform gate (e.g. `![inline]`,
    /// `![config(testing)]`): has no bearing on stripping.
    NotAGate;
}

// ConfigGating pass routines as static methods on a stateless struct
// (peer convention: TypeResolutionPasses, DirectiveProcessingPasses).
type struct ConfigGatingPasses {
    /// Evaluate a single `not(<atom>)` nested call.  Returns Active if the
    /// inner atom does NOT match the active OS, Inactive if it does.
    static eval_not_call(inner: DirectiveNode*, env: CfgEnv) -> CfgEvalResult {
        if (inner == null) { return CfgEvalResult::NotAGate; }
        if (inner.args.length != 1) {
            // Malformed `not(...)`; directive_processing emits a diagnostic.
            // Treat as a no-op rather than dropping the decl silently.
            return CfgEvalResult::NotAGate;
        }
        const a: DirectiveArg = inner.args[0];
        if (a.kind != DirectiveArgKind::Ident) {
            return CfgEvalResult::NotAGate;
        }
        // `not(<os-atom>)`: active when the target OS does NOT match.
        if (HostOS::is_os_atom(a.name)) {
            if (env.os.matches(a.name)) {
                return CfgEvalResult::Inactive;
            }
            return CfgEvalResult::Active;
        }
        // `not(<feature-atom>)`: active when the feature flag is OFF.
        if (CfgEnv::is_feature_atom(a.name)) {
            if (env.feature_active(a.name)) {
                return CfgEvalResult::Inactive;
            }
            return CfgEvalResult::Active;
        }
        return CfgEvalResult::NotAGate;
    }

    /// Classify the gate inside `![config(...)]` / `![target(...)]`.  The
    /// directive must have exactly one arg for the platform-gate forms we
    /// support; everything else is a NotAGate (e.g. `config(testing)`,
    /// multi-arg `cfg(any(...))` which we defer until vocabulary expansion).
    static eval_config_args(d: DirectiveNode*, env: CfgEnv) -> CfgEvalResult {
        if (d.args.length != 1) {
            return CfgEvalResult::NotAGate;
        }
        const a: DirectiveArg = d.args[0];

        // Bare-ident form: `config(windows)` (OS atom) or
        // `config(native_syscalls)` (feature atom).
        if (a.kind == DirectiveArgKind::Ident) {
            if (HostOS::is_os_atom(a.name)) {
                if (env.os.matches(a.name)) {
                    return CfgEvalResult::Active;
                }
                return CfgEvalResult::Inactive;
            }
            if (CfgEnv::is_feature_atom(a.name)) {
                if (env.feature_active(a.name)) {
                    return CfgEvalResult::Active;
                }
                return CfgEvalResult::Inactive;
            }
            return CfgEvalResult::NotAGate;
        }

        // Nested call: `config(not(windows))`.
        if (a.kind == DirectiveArgKind::Nested) {
            const inner: DirectiveNode* = a.nested;
            if (inner == null) { return CfgEvalResult::NotAGate; }
            if (inner.directive_kind.eq("not")) {
                return ConfigGatingPasses::eval_not_call(inner, env);
            }
            // `any(...)` / `all(...)` deferred until vocabulary expansion.
            return CfgEvalResult::NotAGate;
        }

        return CfgEvalResult::NotAGate;
    }

    /// Evaluate one attached directive.  Maps the bare-OS-atom,
    /// `![not(<atom>)]`, and `![config(...)]` / `![target(...)]` forms onto
    /// a CfgEvalResult; everything else is NotAGate.
    static eval_directive(d: DirectiveNode*, env: CfgEnv) -> CfgEvalResult {
        if (d == null) { return CfgEvalResult::NotAGate; }

        // Bare form: `![windows]`, `![linux]`, etc.
        if (HostOS::is_os_atom(d.directive_kind)) {
            if (env.os.matches(d.directive_kind)) {
                return CfgEvalResult::Active;
            }
            return CfgEvalResult::Inactive;
        }

        // Bare negation: `![not(<atom>)]`.  Mirrors the nested `not(...)`
        // form inside `config(...)` for consistency.
        if (d.directive_kind.eq("not")) {
            return ConfigGatingPasses::eval_not_call(d, env);
        }

        // Wrapped form: `![config(...)]` / `![target(...)]`.
        if (d.directive_kind.eq("config")
                || d.directive_kind.eq("target")) {
            return ConfigGatingPasses::eval_config_args(d, env);
        }

        return CfgEvalResult::NotAGate;
    }


    // Declaration filtering

    /// True if this declaration's attached_directives include at least one
    /// platform gate that evaluates to Inactive.  A decl is stripped only if
    /// some gate disqualifies it; if no gates are present (or all are
    /// NotAGate / Active), the decl survives.  Multiple gates on a single
    /// decl are AND'd: `![windows] ![linux] fn` would be impossible to
    /// satisfy, which is the sensible behavior; both must be active.
    static decl_is_active(decl: DeclarationNode*, env: CfgEnv) -> boolean {
        if (decl == null) { return true; }
        for (mut i: i64 = 0; i < decl.attached_directives.length; i++) {
            const d: DirectiveNode* = decl.attached_directives[i];
            const r: CfgEvalResult = ConfigGatingPasses::eval_directive(d, env);
            if (match (r) { CfgEvalResult::Inactive => { true } _ => { false } }) {
                return false;
            }
        }
        return true;
    }

    /// Same predicate for block-attached directives.  Used by the
    /// function-body walker to decide whether `![dir] { ... }` blocks
    /// survive.
    static block_is_active(block: BlockStmtNode*, env: CfgEnv) -> boolean {
        if (block == null) { return true; }
        for (mut i: i64 = 0; i < block.attached_directives.length; i++) {
            const d: DirectiveNode* = block.attached_directives[i];
            const r: CfgEvalResult = ConfigGatingPasses::eval_directive(d, env);
            if (match (r) { CfgEvalResult::Inactive => { true } _ => { false } }) {
                return false;
            }
        }
        return true;
    }


    // Function-body walker

    /// Walk a block's statements, filtering out child BlockStmt nodes whose
    /// attached cfg directives are inactive.  Recurses into nested blocks
    /// so gates can sit at any nesting level.  Active gated blocks have
    /// their `attached_directives` cleared once kept; downstream passes
    /// see them as plain blocks.
    static process_block(block: BlockStmtNode*, env: CfgEnv, ctx: CompilationContext*) -> void {
        if (block == null) { return; }
        // Fast-path scan: most function bodies have no inline cfg-gated
        // sub-blocks at all.  Skip the rebuild loop in that case so we
        // don't touch `block.statements`; array assignment through a
        // class-field write is a known-fragile codegen path on the
        // current pin.
        mut needs_filter: boolean = false;
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            const stmt: StatementNode* = block.statements[i];
            if (stmt == null) { continue; }
            if (stmt.kind == NodeKind::BlockStatement) {
                const inner: BlockStmtNode* = stmt as BlockStmtNode*;
                if (inner.has_directives()) { needs_filter = true; break; }
            }
        }
        if (!needs_filter) { return; }

        mut kept: StatementNode*[] = [];
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            const stmt: StatementNode* = block.statements[i];
            if (stmt == null) { continue; }

            if (stmt.kind == NodeKind::BlockStatement) {
                const inner: BlockStmtNode* = stmt as BlockStmtNode*;
                if (inner.has_directives() && !ConfigGatingPasses::block_is_active(inner, env)) {
                    if (ctx.debug_mode) {
                        cdebug("[ConfigGating] stripped inline block at line %u\n",
                            inner.span.start_line);
                    }
                    continue;
                }
                ConfigGatingPasses::process_block(inner, env, ctx);
            }
            kept.push(stmt);
        }
        block.statements = kept;
    }


    /// Walk every method body in `methods`, processing cfg-gated inline
    /// `![dir] { ... }` blocks.  Hoisted out of `run()` so a single call site
    /// invokes process_block with `m.body`; the same pattern repeated inside a
    /// `match` expression's arms has historically miscompiled.  Borrows the
    /// list (read-only) so the caller keeps ownership of the owning node's
    /// `methods` field.
    static walk_method_bodies(methods: &MethodNode*[], env: CfgEnv, ctx: CompilationContext*) -> void {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m != null && m.func != null) {
                const body: BlockStmtNode* = m.func.body;
                ConfigGatingPasses::process_block(body, env, ctx);
            }
        }
    }

    /// True if any method in `methods` carries a platform gate that evaluates
    /// Inactive for `os` - i.e. the list needs to be rebuilt.  Scans without
    /// allocating so the overwhelmingly-common no-gate case stays cheap and
    /// never rewrites the owning node's `methods` field (a class-field array
    /// write is a heavier codegen path; mirrors `process_block`'s fast-path).
    static methods_need_filter(methods: &MethodNode*[], env: CfgEnv) -> boolean {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null) { continue; }
            if (!ConfigGatingPasses::decl_is_active(m as DeclarationNode*, env)) { return true; }
        }
        return false;
    }

    /// Build a fresh method list keeping only the methods active for `os`.
    /// The caller assigns the result back onto the owning struct/class/impl
    /// node; only invoked after `methods_need_filter` confirms a rebuild is
    /// needed.  A method survives unless one of its attached gates evaluates
    /// Inactive - the same predicate (`decl_is_active`) used for top-level
    /// declarations, so `![target(windows)]` / `![target(unix)]` on a method
    /// behaves exactly like it does on a free function.
    static active_methods(methods: &MethodNode*[], env: CfgEnv,
                            ctx: CompilationContext*) -> MethodNode*[] {
        mut kept: MethodNode*[] = [];
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null) { continue; }
            if (!ConfigGatingPasses::decl_is_active(m as DeclarationNode*, env)) {
                if (ctx.debug_mode) {
                    cdebug("[ConfigGating] stripped gated method for target os\n");
                }
                continue;
            }
            kept.push(m);
        }
        return kept;
    }


    // Pass entry point

    /// Walks the program's top-level statements and removes declarations
    /// whose attached cfg gates evaluate to Inactive.  Non-declaration
    /// top-level statements (raw expressions, namespace markers, imports
    /// without directives) pass through untouched.
    static run(ctx: CompilationContext*) -> PassResult {
        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            return PassResult::ok();
        }

        const env: CfgEnv = CfgEnv::from_ctx(ctx);

        // An unclassifiable triple can't drive platform gating correctly: every
        // ![windows]/![linux]/![macos]/![unix] decl would be stripped and every
        // ![not(...)] decl kept, silently producing a wrong build. Fail loudly
        // instead. Reachable only via an explicit unsupported --target; the LLVM
        // host-triple fallback always classifies.
        const os_unknown: boolean = match (env.os) {
            HostOS::Other => { true }
            _             => { false }
        };
        if (os_unknown) {
            ctx.emit_error(ErrorCode::E0904_COMPILER_CONFIGURATION_ERROR,
                "unsupported target triple: cannot resolve a target platform (expected windows, linux, or macos)");
            return PassResult::failure(1);
        }

        mut kept: ASTNode*[] = [];
        mut stripped: i64 = 0;

        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }

            // Only DeclarationNode subclasses carry attached_directives.
            // Everything else passes through.
            const k: NodeKind = stmt.kind;
            const is_decl: boolean = match (k) {
                NodeKind::VariableDeclaration       => { true }
                NodeKind::DestructureDeclaration    => { true }
                NodeKind::FunctionDeclaration       => { true }
                NodeKind::MethodDeclaration         => { true }
                NodeKind::IntrinsicDeclaration      => { true }
                NodeKind::IntrinsicConstDeclaration => { true }
                NodeKind::ImportDeclaration         => { true }
                NodeKind::ModuleDeclaration         => { true }
                NodeKind::StructDeclaration         => { true }
                NodeKind::UnionDeclaration          => { true }
                NodeKind::ClassDeclaration          => { true }
                NodeKind::EnumDeclaration           => { true }
                NodeKind::TraitDeclaration          => { true }
                NodeKind::TypeAliasDeclaration      => { true }
                NodeKind::ImplementationBlock       => { true }
                NodeKind::ExternBlock               => { true }
                _                                   => { false }
            };

            if (!is_decl) {
                kept.push(stmt);
                continue;
            }

            const decl: DeclarationNode* = stmt as DeclarationNode*;
            if (!ConfigGatingPasses::decl_is_active(decl, env)) {
                stripped += 1;
                if (ctx.debug_mode) {
                    cdebug("[ConfigGating] stripped %s for target os\n",
                        k.to_string());
                }
                continue;
            }

            // Recurse into function/method bodies for inline `![dir] { ... }`
            // gates, and strip whole `![target(...)]`-gated methods inside
            // struct / class / impl bodies.  Method-list filtering uses the
            // same `decl_is_active` predicate as top-level decls, so a
            // platform gate on a method behaves identically to one on a free
            // function - no more delegate-to-free-helper workaround needed.
            // Each cast sits in its own straight-line `if` (never in `match`
            // arms) to dodge the historic consecutive-cast-and-call miscompile.
            if (k == NodeKind::FunctionDeclaration) {
                const fd: FunctionDeclNode* = stmt as FunctionDeclNode*;
                const body: BlockStmtNode* = fd.body;
                if (body != null) {
                    ConfigGatingPasses::process_block(body, env, ctx);
                }
            }
            if (k == NodeKind::MethodDeclaration) {
                const md: MethodNode* = stmt as MethodNode*;
                if (md.func != null) {
                    const mbody: BlockStmtNode* = md.func.body;
                    if (mbody != null) {
                        ConfigGatingPasses::process_block(mbody, env, ctx);
                    }
                }
            }
            if (k == NodeKind::StructDeclaration) {
                const sd: StructDeclNode* = stmt as StructDeclNode*;
                if (ConfigGatingPasses::methods_need_filter(&sd.methods, env)) {
                    sd.methods = ConfigGatingPasses::active_methods(&sd.methods, env, ctx);
                }
                ConfigGatingPasses::walk_method_bodies(&sd.methods, env, ctx);
            }
            if (k == NodeKind::UnionDeclaration) {
                const ud: UnionDeclNode* = stmt as UnionDeclNode*;
                if (ConfigGatingPasses::methods_need_filter(&ud.methods, env)) {
                    ud.methods = ConfigGatingPasses::active_methods(&ud.methods, env, ctx);
                }
                ConfigGatingPasses::walk_method_bodies(&ud.methods, env, ctx);
            }
            if (k == NodeKind::ClassDeclaration) {
                const cd: ClassDeclNode* = stmt as ClassDeclNode*;
                if (ConfigGatingPasses::methods_need_filter(&cd.methods, env)) {
                    cd.methods = ConfigGatingPasses::active_methods(&cd.methods, env, ctx);
                }
                ConfigGatingPasses::walk_method_bodies(&cd.methods, env, ctx);
            }
            if (k == NodeKind::ImplementationBlock) {
                const ib: ImplBlockNode* = stmt as ImplBlockNode*;
                if (ConfigGatingPasses::methods_need_filter(&ib.methods, env)) {
                    ib.methods = ConfigGatingPasses::active_methods(&ib.methods, env, ctx);
                }
                ConfigGatingPasses::walk_method_bodies(&ib.methods, env, ctx);
            }
            kept.push(stmt);
        }

        if (stripped > 0) {
            root.statements = kept;
            if (ctx.debug_mode) {
                // `kept` was moved into `root.statements` above; read the
                // remaining count back through its new owner.
                cdebug("[ConfigGating] stripped %lld decl(s); %lld remain\n",
                    stripped, root.statements.length);
            }
        } else {
            // Nothing stripped: `root.statements` keeps its original array and
            // the freshly-built `kept` copy is discarded.  Release its array
            // spine (the ASTNode* elements are arena-owned and unaffected).
            kept.drop();
        }

        return PassResult::ok();
    }

}
