///! Dead-Code Analysis Pass.
///!
///! A diagnostic-only lint that emits WARNINGS (never errors) for code that
///! can never run or names that are never used.  Warnings increment the
///! sink's separate `warning_count`, so this pass never fails a build; a user
///! who dislikes a given lint can suppress it by its numeric code through
///! `DiagConfig`.  `run` always returns `PassResult::ok()`.
///!
///! Lints implemented here:
///!
///!   * W0009 (unreachable statement) - a statement that follows an
///!     unconditionally-diverging statement (`return` / `break` / `continue`,
///!     or an `if`/`match` whose every branch diverges) in the same block.
///!     Reported once per block, at the first unreachable statement.  Only
///!     literal divergence is considered (no `panic`/`noreturn` reasoning),
///!     which keeps the false-positive rate at essentially zero.
///!
///!   * W0001 (unused variable) - a local `let`/`const`/`mut` binding that is
///!     never referenced.  A leading-underscore name (`_scratch`) opts out,
///!     matching the Rust convention.  Destructuring bindings
///!     (`const { a, b } = pair;`) are exempt: they frequently exist to move a
///!     field out of an aggregate while deliberately discarding the rest.
///!
///!   * W0002 (unused function/method) - a PRIVATE, module-local function or
///!     method that no call site targets.  Method usage is read from each call
///!     site's sema/mono-resolved `resolved_method` (operator overloads
///!     included, via their `desugared_call`); free-function usage from the
///!     resolution map.  Entry points (`main`, `![entry]`), tests, trait-impl
///!     methods, constructors/destructors, virtual/override methods, generic
///!     templates, mono specializations, and `![symbol(...)]` link-named
///!     functions are never flagged.  STATIC methods are also skipped for now:
///!     they are called as `Type::m()`, whose usage pins `resolved_callee` (a
///!     name) not `resolved_method`, so the harvest can't see it - precise
///!     static-call tracking is a follow-up.
///!
///! Scope: only the module currently being compiled is linted, and standard-
///! library modules (`std::*`) are skipped entirely - a dependency's internals
///! are not the user's dead code (this mirrors how Rust only warns about your
///! own crate).  Local/free-function usage is read from the resolver's
///! `ResolutionMap`; method usage from resolved call targets.
///!
///! Unused imports (W0003) are deliberately staged as a follow-up.
///!
///! Placement: after Monomorphization (so generic call sites are resolved) and
///! before DropInsertion (so unreachable detection sees the user's own
///! statements, not synthesized drop cleanups).  See `instance.cryo`'s
///! post-mono semantic-analysis stage.

namespace Compiler::Passes::DeadCode;

import Compiler::Diag;
import Compiler::Diag::{ Diagnostic, SourceSpan };
import Compiler::AST;
import Compiler::AST::{ Node, Expression, Statement, Declaration, Pattern };
import Compiler::CompilationContext;
import Compiler::Passes::PassID;
import Compiler::Resolver;
import Compiler::Resolver::{ Resolver, Symbol, SymbolID, SymbolStr, ResolutionMap };
import std::collections::hashmap;
import std::core::option;
import std::fmt;


type struct DeadCodeChecker {
    ctx: CompilationContext*;

    /// Set of declaration-span keys (see `ResolutionMap::make_key`) that are
    /// referenced somewhere.  A binding counts as "used" when its declaring
    /// span key is in this set.  Built once from the resolution map by
    /// `build_used`.  Covers identifier references: local variables and
    /// free-function callees.
    used: HashMap<u64, boolean>;

    /// Set of method/function declaration-span keys that are the target of a
    /// resolved call.  Populated by `harvest_module` from every call site's
    /// `resolved_method` (set by sema/mono), which is the only reliable signal
    /// for METHOD calls (`obj.foo()` is type-directed and not recorded in the
    /// resolution map).  Also covers operator overloads via `desugared_call`.
    method_used: HashMap<u64, boolean>;

    /// Whether the body currently being walked was name-resolved, so its local
    /// references are present in `used`.  W0001 (unused local) is only sound
    /// when this holds.  It is FALSE for trait *default* method bodies - the
    /// resolver declares trait methods "as signatures only" (see
    /// visit(TraitDeclNode)) and never resolves their bodies - and for mono
    /// specialization clones, which are not independently resolved (their
    /// resolved template, walked separately, is where a genuine dead local
    /// surfaces).  W0009 (unreachable) is structural and stays enabled either
    /// way.  Set per-body by `check_fn`.
    body_resolved: boolean;

    static new(ctx: CompilationContext*) -> DeadCodeChecker {
        return DeadCodeChecker {
            ctx:           ctx,
            used:          HashMap<u64, boolean>::new(),
            method_used:   HashMap<u64, boolean>::new(),
            body_resolved: true,
        };
    }

    // -- Usage set --

    /// Populate `used` from the resolution map.  Each entry maps a reference
    /// span -> the SymbolID it resolves to; we record the *declaration* span
    /// key of every referenced symbol, EXCLUDING the entry a declaration
    /// records for itself (whose key equals the declaring span), so a
    /// declaration never counts as a use of itself.
    build_used(mut &this) -> void {
        const resolver: Resolver* = this.ctx.get_resolver();
        if (resolver == null) { return; }
        const n: u64 = resolver.symbols.length as u64;
        mut it: HashMapIter<u64, SymbolID> = resolver.resolution_map.singles.iter();
        loop {
            match (it.next()) {
                Option::Some(pair) => {
                    const ref_key: u64  = pair.first;
                    const sid: SymbolID = pair.second;
                    if (!sid.is_valid() || sid.id > n) { continue; }
                    const decl_span: SourceSpan = resolver.symbols[(sid.id - 1) as i64].declaring_span;
                    const decl_key: u64 = ResolutionMap::make_key(decl_span);
                    if (ref_key != decl_key) {
                        this.used.insert(decl_key, true);
                    }
                }
                Option::None => { break; }
            }
        }
    }

    // -- Module walk (both lints) --

    /// Walk every function/method body in the current module.
    check_module(mut &this, root: ProgramNode*) -> void {
        if (root == null) { return; }
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }
            match (stmt.kind) {
                NodeKind::FunctionDeclaration => {
                    const fn: FunctionDeclNode* = stmt as FunctionDeclNode*;
                    this.check_fn(fn, this.is_body_resolved(fn));
                }
                NodeKind::StructDeclaration => {
                    this.check_methods((stmt as StructDeclNode*).methods);
                }
                NodeKind::UnionDeclaration => {
                    this.check_methods((stmt as UnionDeclNode*).methods);
                }
                NodeKind::ClassDeclaration => {
                    this.check_methods((stmt as ClassDeclNode*).methods);
                }
                NodeKind::ImplementationBlock => {
                    this.check_methods((stmt as ImplBlockNode*).methods);
                }
                NodeKind::TraitDeclaration => {
                    // Trait default method bodies are not name-resolved
                    // (signatures only), so W0001 would false-positive on every
                    // local; run structural W0009 only (body_resolved = false).
                    const td: TraitDeclNode* = stmt as TraitDeclNode*;
                    for (mut j: i64 = 0; j < td.methods.length; j++) {
                        this.check_fn(td.methods[j], false);
                    }
                }
                _ => {}
            }
        }
    }

    check_methods(mut &this, methods: &MethodNode*[]) -> void {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null) { continue; }
            this.check_fn(m.func, this.is_body_resolved(m.func));
        }
    }

    /// Whether `func`'s body was name-resolved (so its locals are in `used`).
    /// False for mono specialization clones, for trait-default methods
    /// synthesized into an impl block (`is_synth_default`), and for a body the
    /// compiler BUILT after resolution ran (`is_synthesized_body`, the `poll` of
    /// an `async` lowering) - none of them is a body the resolver walked.
    /// See the `body_resolved` field doc.
    is_body_resolved(&this, func: FunctionDeclNode*) -> boolean {
        return !func.is_specialization && !func.is_synth_default
            && !func.is_synthesized_body;
    }

    /// `body_resolved` gates W0001 (see the field doc): pass false for bodies
    /// whose local references are absent from `used` (trait defaults, mono
    /// clones); W0009 runs regardless.
    check_fn(mut &this, func: FunctionDeclNode*, body_resolved: boolean) -> void {
        if (func == null || func.body == null) { return; }
        this.body_resolved = body_resolved;
        this.check_block(func.body);
        this.body_resolved = true;
    }

    /// Scan a block's statement list for both lints.  For each REACHABLE
    /// statement: flag an unused local it declares (W0001), then recurse into
    /// its nested blocks.  The moment a statement unconditionally diverges, the
    /// next non-null statement is unreachable (W0009) - report it once and stop
    /// (everything after is equally dead, and dead bindings need no
    /// unused-warning).
    check_block(mut &this, block: BlockStmtNode*) -> void {
        if (block == null) { return; }
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            const stmt: StatementNode* = block.statements[i];
            if (stmt == null) { continue; }

            this.check_local_decl(stmt);
            this.check_stmt(stmt);

            if (this.stmt_diverges(stmt)) {
                mut j: i64 = i + 1;
                while (j < block.statements.length && block.statements[j] == null) {
                    j = j + 1;
                }
                if (j < block.statements.length) {
                    const span: SourceSpan = this.report_span(block.statements[j]);
                    if (span.has_location()) {
                        mut diag: Diagnostic = Diagnostic::warning(
                            ErrorCode::W0009_DEAD_CODE,
                            "unreachable statement: the preceding statement always diverges, so this can never be reached");
                        diag = diag.at(span);
                        this.ctx.emit_diagnostic(diag);
                    }
                }
                return;
            }
        }
    }

    /// A reportable source span for a statement.  A `DeclStmt` wrapper carries
    /// no location of its own; fall back to the declaration it wraps.
    report_span(&this, stmt: StatementNode*) -> SourceSpan {
        if (stmt.span.has_location()) { return stmt.span; }
        if (stmt.kind == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = stmt as DeclStmtNode*;
            if (ds.declaration != null) { return ds.declaration.span; }
        }
        return stmt.span;
    }

    /// If `stmt` declares a plain local binding that is never referenced, warn
    /// (W0001).  Destructuring bindings are exempt (see the module header).
    check_local_decl(mut &this, stmt: StatementNode*) -> void {
        if (!this.body_resolved) { return; }   // unresolved body: `used` is incomplete
        if (stmt.kind != NodeKind::DeclarationStatement) { return; }
        const ds: DeclStmtNode* = stmt as DeclStmtNode*;
        if (ds.declaration == null) { return; }
        if (ds.declaration.kind != NodeKind::VariableDeclaration) { return; }

        const vd: VarDeclNode* = ds.declaration as VarDeclNode*;
        if (!vd.span.has_location()) { return; }

        const name: string = this.ctx.resolve_str(vd.name);
        if (name == "" || name.starts_with("_")) { return; }

        const key: u64 = ResolutionMap::make_key(vd.span);
        if (this.used.contains_key(&key)) { return; }

        mut diag: Diagnostic = Diagnostic::warning(
            ErrorCode::W0001_UNUSED_VARIABLE,
            format("unused variable `%s`; prefix it with `_` to silence this warning", name));
        diag = diag.at(vd.span);
        this.ctx.emit_diagnostic(diag);
    }

    /// Recurse into a statement's nested blocks so code inside an `if` arm,
    /// loop body, etc. is scanned too.  Does NOT judge divergence.
    check_stmt(mut &this, stmt: StatementNode*) -> void {
        if (stmt == null) { return; }
        match (stmt.kind) {
            NodeKind::BlockStatement => {
                this.check_block(stmt as BlockStmtNode*);
            }
            NodeKind::IfStatement => {
                const it: IfStmtNode* = stmt as IfStmtNode*;
                if (it.then_stmt != null) { this.check_stmt(it.then_stmt); }
                if (it.else_stmt != null) { this.check_stmt(it.else_stmt); }
            }
            NodeKind::WhileStatement => {
                this.check_stmt((stmt as WhileStmtNode*).body);
            }
            NodeKind::ForStatement => {
                this.check_stmt((stmt as ForStmtNode*).body);
            }
            NodeKind::DoWhileStatement => {
                this.check_stmt((stmt as DoWhileStmtNode*).body);
            }
            NodeKind::LoopStatement => {
                this.check_stmt((stmt as LoopStmtNode*).body);
            }
            NodeKind::MatchStatement => {
                const m: MatchStmtNode* = stmt as MatchStmtNode*;
                for (mut i: i64 = 0; i < m.arms.length; i++) {
                    const arm: MatchArmNode* = m.arms[i];
                    if (arm != null && arm.body != null) { this.check_stmt(arm.body); }
                }
            }
            NodeKind::StaticMatchStatement => {
                const sm: StaticMatchStmtNode* = stmt as StaticMatchStmtNode*;
                for (mut i: i64 = 0; i < sm.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sm.arms[i];
                    if (arm != null && arm.body != null) { this.check_stmt(arm.body); }
                }
            }
            _ => {}
        }
    }

    /// Does this statement ALWAYS transfer control away, so a following
    /// statement in the same block can never execute?  Conservative: only
    /// literal `return`/`break`/`continue` and control structures whose every
    /// branch diverges count.  Everything else is treated as fall-through, so
    /// the lint never fabricates an unreachable warning.
    stmt_diverges(mut &this, stmt: StatementNode*) -> boolean {
        if (stmt == null) { return false; }
        match (stmt.kind) {
            NodeKind::ReturnStatement   => { return true; }
            NodeKind::BreakStatement    => { return true; }
            NodeKind::ContinueStatement => { return true; }
            NodeKind::BlockStatement => {
                return this.block_diverges(stmt as BlockStmtNode*);
            }
            NodeKind::IfStatement => {
                const it: IfStmtNode* = stmt as IfStmtNode*;
                if (it.then_stmt == null || it.else_stmt == null) { return false; }
                return this.stmt_diverges(it.then_stmt) && this.stmt_diverges(it.else_stmt);
            }
            NodeKind::MatchStatement => {
                const m: MatchStmtNode* = stmt as MatchStmtNode*;
                if (m.arms.length == 0) { return false; }
                for (mut i: i64 = 0; i < m.arms.length; i++) {
                    const arm: MatchArmNode* = m.arms[i];
                    if (arm == null || arm.body == null || !this.stmt_diverges(arm.body)) {
                        return false;
                    }
                }
                return true;
            }
            _ => { return false; }
        }
    }

    /// A block diverges if any statement in it diverges (once one does, the
    /// block cannot complete normally).
    block_diverges(mut &this, block: BlockStmtNode*) -> boolean {
        if (block == null) { return false; }
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            const stmt: StatementNode* = block.statements[i];
            if (stmt != null && this.stmt_diverges(stmt)) { return true; }
        }
        return false;
    }

    // -- Method-usage harvest (for W0002) --

    /// Record a resolved call target (a method or specialized free function)
    /// as used, keyed by its declaration span so it matches how the target
    /// declaration is keyed in `report_module`.
    mark_call_target(mut &this, node: ASTNode*) -> void {
        if (node == null) { return; }
        mut key: u64 = 0;
        if (node.kind == NodeKind::MethodDeclaration) {
            const mn: MethodNode* = node as MethodNode*;
            if (mn.func == null) { return; }
            key = ResolutionMap::make_key(mn.func.span);
        } else if (node.kind == NodeKind::FunctionDeclaration) {
            key = ResolutionMap::make_key((node as FunctionDeclNode*).span);
        } else {
            return;
        }
        this.method_used.insert(key, true);
    }

    /// Walk every function/method body harvesting call targets.  This is a
    /// COMPLETE traversal (unlike the lint-1 walk it does not early-exit on
    /// divergence): a method called only inside otherwise-unreachable code is
    /// still conservatively counted as used, so the lint never fabricates an
    /// "unused method" warning.
    harvest_module(mut &this, root: ProgramNode*) -> void {
        if (root == null) { return; }
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }
            match (stmt.kind) {
                NodeKind::FunctionDeclaration => { this.harvest_fn(stmt as FunctionDeclNode*); }
                NodeKind::StructDeclaration   => { this.harvest_methods((stmt as StructDeclNode*).methods); }
                NodeKind::UnionDeclaration    => { this.harvest_methods((stmt as UnionDeclNode*).methods); }
                NodeKind::ClassDeclaration    => { this.harvest_methods((stmt as ClassDeclNode*).methods); }
                NodeKind::ImplementationBlock => { this.harvest_methods((stmt as ImplBlockNode*).methods); }
                NodeKind::TraitDeclaration => {
                    const td: TraitDeclNode* = stmt as TraitDeclNode*;
                    for (mut j: i64 = 0; j < td.methods.length; j++) { this.harvest_fn(td.methods[j]); }
                }
                _ => {}
            }
        }
    }

    harvest_methods(mut &this, methods: &MethodNode*[]) -> void {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null) { continue; }
            this.harvest_fn(m.func);
        }
    }

    harvest_fn(mut &this, func: FunctionDeclNode*) -> void {
        if (func == null || func.body == null) { return; }
        this.harvest_stmt(func.body as StatementNode*);
    }

    /// Fully recurse a statement, harvesting call targets from every
    /// expression and every nested statement.
    harvest_stmt(mut &this, stmt: StatementNode*) -> void {
        if (stmt == null) { return; }
        match (stmt.kind) {
            NodeKind::BlockStatement => {
                const b: BlockStmtNode* = stmt as BlockStmtNode*;
                for (mut i: i64 = 0; i < b.statements.length; i++) { this.harvest_stmt(b.statements[i]); }
            }
            NodeKind::UnsafeBlockStatement => {
                this.harvest_stmt((stmt as UnsafeBlockStmtNode*).block as StatementNode*);
            }
            NodeKind::ReturnStatement     => { this.walk_expr((stmt as ReturnStmtNode*).expression); }
            NodeKind::ExpressionStatement => { this.walk_expr((stmt as ExprStmtNode*).expression); }
            NodeKind::DeclarationStatement => {
                const ds: DeclStmtNode* = stmt as DeclStmtNode*;
                if (ds.declaration != null) { this.harvest_decl(ds.declaration); }
            }
            NodeKind::VariableDeclaration   => { this.harvest_decl(stmt as DeclarationNode*); }
            NodeKind::DestructureDeclaration => { this.harvest_decl(stmt as DeclarationNode*); }
            NodeKind::IfStatement => {
                const it: IfStmtNode* = stmt as IfStmtNode*;
                this.walk_expr(it.condition);
                this.harvest_stmt(it.then_stmt);
                this.harvest_stmt(it.else_stmt);
            }
            NodeKind::WhileStatement => {
                const w: WhileStmtNode* = stmt as WhileStmtNode*;
                this.walk_expr(w.condition);
                this.harvest_stmt(w.body);
            }
            NodeKind::DoWhileStatement => {
                const d: DoWhileStmtNode* = stmt as DoWhileStmtNode*;
                this.harvest_stmt(d.body);
                this.walk_expr(d.condition);
            }
            NodeKind::ForStatement => {
                const f: ForStmtNode* = stmt as ForStmtNode*;
                if (f.init != null) { this.harvest_stmt(f.init as StatementNode*); }
                this.walk_expr(f.condition);
                this.walk_expr(f.update);
                this.harvest_stmt(f.body);
            }
            NodeKind::LoopStatement => {
                this.harvest_stmt((stmt as LoopStmtNode*).body);
            }
            NodeKind::MatchStatement => {
                const m: MatchStmtNode* = stmt as MatchStmtNode*;
                this.walk_expr(m.subject);
                for (mut i: i64 = 0; i < m.arms.length; i++) {
                    const arm: MatchArmNode* = m.arms[i];
                    if (arm == null) { continue; }
                    this.walk_expr(arm.guard);
                    this.harvest_stmt(arm.body);
                }
            }
            NodeKind::StaticMatchStatement => {
                const sm: StaticMatchStmtNode* = stmt as StaticMatchStmtNode*;
                for (mut i: i64 = 0; i < sm.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sm.arms[i];
                    if (arm != null) { this.harvest_stmt(arm.body); }
                }
            }
            _ => {}
        }
    }

    harvest_decl(mut &this, decl: DeclarationNode*) -> void {
        if (decl == null) { return; }
        if (decl.kind == NodeKind::VariableDeclaration) {
            this.walk_expr((decl as VarDeclNode*).initializer);
        } else if (decl.kind == NodeKind::DestructureDeclaration) {
            this.walk_expr((decl as DestructureDeclNode*).initializer);
        }
    }

    /// Complete expression traversal: harvest a call target at every
    /// `CallExprNode`, and recurse into every child expression - including the
    /// `desugared_call` side-channels where operator overloads hang their
    /// resolved method call.
    walk_expr(mut &this, e: ExpressionNode*) -> void {
        if (e == null) { return; }
        match (e.kind) {
            NodeKind::CallExpression => {
                const c: CallExprNode* = e as CallExprNode*;
                this.mark_call_target(c.resolved_method);
                this.walk_expr(c.callee);
                for (mut i: i64 = 0; i < c.arguments.length; i++) { this.walk_expr(c.arguments[i]); }
            }
            NodeKind::BinaryExpression => {
                const b: BinaryExprNode* = e as BinaryExprNode*;
                this.walk_expr(b.left);
                this.walk_expr(b.right);
                this.walk_expr(b.desugared_call);
            }
            NodeKind::UnaryExpression => {
                const u: UnaryExprNode* = e as UnaryExprNode*;
                this.walk_expr(u.operand);
                this.walk_expr(u.desugared_call);
            }
            NodeKind::TernaryExpression => {
                const t: TernaryExprNode* = e as TernaryExprNode*;
                this.walk_expr(t.condition);
                this.walk_expr(t.true_expr);
                this.walk_expr(t.false_expr);
            }
            NodeKind::IfExpression => {
                const ie: IfExprNode* = e as IfExprNode*;
                this.walk_expr(ie.condition);
                this.walk_expr(ie.then_expr);
                this.walk_expr(ie.else_expr);
            }
            NodeKind::MatchExpression => {
                const m: MatchExprNode* = e as MatchExprNode*;
                this.walk_expr(m.subject);
                for (mut i: i64 = 0; i < m.arms.length; i++) {
                    const arm: MatchArmNode* = m.arms[i];
                    if (arm == null) { continue; }
                    this.walk_expr(arm.guard);
                    this.harvest_stmt(arm.body);
                }
            }
            NodeKind::StaticMatchExpression => {
                const sm: StaticMatchExprNode* = e as StaticMatchExprNode*;
                for (mut i: i64 = 0; i < sm.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sm.arms[i];
                    if (arm != null) { this.harvest_stmt(arm.body); }
                }
            }
            NodeKind::NewExpression => {
                const n: NewExprNode* = e as NewExprNode*;
                for (mut i: i64 = 0; i < n.arguments.length; i++) { this.walk_expr(n.arguments[i]); }
                this.walk_expr(n.array_size);
                if (n.struct_init != null) { this.walk_expr(n.struct_init as ExpressionNode*); }
            }
            NodeKind::CastExpression => {
                this.walk_expr((e as CastExprNode*).expression);
            }
            NodeKind::StructLiteral => {
                const sl: StructLiteralNode* = e as StructLiteralNode*;
                for (mut i: i64 = 0; i < sl.field_inits.length; i++) { this.walk_expr(sl.field_inits[i].value); }
            }
            NodeKind::ArrayLiteral => {
                const al: ArrayLiteralNode* = e as ArrayLiteralNode*;
                for (mut i: i64 = 0; i < al.elements.length; i++) { this.walk_expr(al.elements[i]); }
            }
            NodeKind::TupleLiteral => {
                const tl: TupleLiteralNode* = e as TupleLiteralNode*;
                for (mut i: i64 = 0; i < tl.elements.length; i++) { this.walk_expr(tl.elements[i]); }
            }
            NodeKind::LambdaExpression => {
                this.harvest_stmt((e as LambdaExprNode*).body);
            }
            NodeKind::ArrayAccess => {
                const a: ArrayAccessNode* = e as ArrayAccessNode*;
                this.walk_expr(a.array);
                this.walk_expr(a.index);
                this.walk_expr(a.desugared_call);
            }
            NodeKind::MemberAccess => {
                this.walk_expr((e as MemberAccessNode*).object);
            }
            NodeKind::TypeofExpression => { this.walk_expr((e as TypeofExprNode*).operand); }
            NodeKind::DeleteExpression => { this.walk_expr((e as DeleteExprNode*).operand); }
            NodeKind::AwaitExpression  => { this.walk_expr((e as AwaitExprNode*).operand); }
            NodeKind::YieldExpression  => { this.walk_expr((e as YieldExprNode*).operand); }
            NodeKind::TryExpression => {
                const tr: TryExprNode* = e as TryExprNode*;
                this.walk_expr(tr.operand);
                this.walk_expr(tr.desugared);
            }
            _ => {}
        }
    }

    // -- Lint 3: unused private functions/methods (W0002) --

    /// Emit W0002 for every private, module-local function/method that no call
    /// site targets.  Scoped to private symbols so per-module analysis is
    /// sound (a private symbol is only reachable within its own module).
    report_module(mut &this, root: ProgramNode*) -> void {
        if (root == null) { return; }
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }
            match (stmt.kind) {
                NodeKind::FunctionDeclaration => { this.report_function(stmt as FunctionDeclNode*); }
                NodeKind::StructDeclaration   => { this.report_methods((stmt as StructDeclNode*).methods); }
                NodeKind::UnionDeclaration    => { this.report_methods((stmt as UnionDeclNode*).methods); }
                NodeKind::ClassDeclaration    => { this.report_methods((stmt as ClassDeclNode*).methods); }
                NodeKind::ImplementationBlock => { this.report_methods((stmt as ImplBlockNode*).methods); }
                _ => {}
            }
        }
    }

    report_methods(mut &this, methods: &MethodNode*[]) -> void {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null) { continue; }
            this.report_method(m);
        }
    }

    /// True if this call target's declaration span is referenced anywhere.
    is_target_used(&this, span: SourceSpan) -> boolean {
        const key: u64 = ResolutionMap::make_key(span);
        return this.method_used.contains_key(&key) || this.used.contains_key(&key);
    }

    report_function(mut &this, func: FunctionDeclNode*) -> void {
        if (func == null || func.body == null) { return; }   // extern / no body
        if (func.is_public) { return; }                       // only private
        if (func.is_generic()) { return; }                    // template - skip (conservative)
        if (func.is_specialization) { return; }               // mono-generated instance
        if (this.is_directive_excluded(func)) { return; }
        if (!func.span.has_location()) { return; }
        if (this.is_target_used(func.span)) { return; }

        const name: string = this.ctx.resolve_str(func.name);
        if (name == "" || name == "main") { return; }

        mut diag: Diagnostic = Diagnostic::warning(
            ErrorCode::W0002_UNUSED_FUNCTION,
            format("function `%s` is never used", name));
        diag = diag.at(func.span);
        this.ctx.emit_diagnostic(diag);
    }

    report_method(mut &this, m: MethodNode*) -> void {
        const f: FunctionDeclNode* = m.func;
        if (f == null || f.body == null) { return; }          // abstract / no body
        // Only private methods.  A method's symbol visibility derives from
        // `MethodNode.visibility` (see name_resolution), which defaults Public,
        // so anything not explicitly private is conservatively left alone.
        match (m.visibility) {
            Visibility::Private => {}
            _                   => { return; }
        }
        if (f.is_generic()) { return; }                       // template - skip
        if (f.is_specialization) { return; }                  // mono-generated instance
        // Static methods are called as `Type::m()` (scope-resolution), whose
        // usage pins `resolved_callee` (a name), not `resolved_method` - our
        // harvest can't see it, so flagging them would false-positive. Tracking
        // static-call usage precisely is a follow-up; skip them for now.
        if (m.is_static) { return; }
        // Dispatch-only or implicitly-invoked methods are never called by name:
        if (m.is_constructor || m.is_destructor || m.is_virtual || m.is_override) { return; }
        if (f.origin_trait.is_valid()) { return; }            // trait-impl method
        if (this.is_directive_excluded(f)) { return; }
        if (!f.span.has_location()) { return; }
        if (this.is_target_used(f.span)) { return; }

        const name: string = this.ctx.resolve_str(f.name);
        if (name == "") { return; }

        mut diag: Diagnostic = Diagnostic::warning(
            ErrorCode::W0002_UNUSED_FUNCTION,
            format("method `%s` is never used", name));
        diag = diag.at(f.span);
        this.ctx.emit_diagnostic(diag);
    }

    /// Always-live directives/link-names: entry points, tests, and functions
    /// whose linker symbol is pinned are never "unused".
    is_directive_excluded(&this, func: FunctionDeclNode*) -> boolean {
        if (func.has_link_name) { return true; }
        if (func.has_directive("entry"))         { return true; }
        if (func.has_directive("test"))          { return true; }
        if (func.has_directive("ignore"))        { return true; }
        if (func.has_directive("should_panic"))  { return true; }
        return false;
    }
}


type struct DeadCodePass {
    static run(ctx: CompilationContext*) -> PassResult {
        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) { return PassResult::ok(); }

        // Only lint the user's own code: skip the standard library. A
        // dependency's unused internals are not the user's dead code.
        if (root.namespace_name.starts_with("std::")) {
            return PassResult::ok();
        }

        mut chk: DeadCodeChecker = DeadCodeChecker::new(ctx);
        chk.build_used();          // resolution-map usage (locals, free-fn callees)
        chk.harvest_module(root);  // call targets (methods, operator overloads)
        chk.check_module(root);    // W0009 unreachable + W0001 unused locals
        chk.report_module(root);   // W0002 unused private functions/methods

        // A lint never fails the build; warnings are counted separately by the
        // DiagnosticSink and do not raise the error count.
        return PassResult::ok();
    }
}
