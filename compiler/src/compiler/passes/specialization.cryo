/// Specialization Passes
///
/// Three pass implementations for the generic specialization pipeline:
///
///   1. TemplateRegistration: Scans the AST for generic declarations and
///      registers them in the GenericRegistry.
///
///   2. Monomorphization: Runs the worklist-driven Monomorphizer to produce
///      concrete types and specialized ASTs for every InstantiatedType.
///
///   3. GenericExpressionResolution: Injects specialized ASTs into the
///      ProgramNode so codegen sees only concrete declarations.
///
///   4. GenericValidation: Walks all types in the arena and asserts that
///      every InstantiatedType has a resolved concrete type.  Catches
///      missed monomorphizations before they reach codegen or type lowering.

namespace Compiler::Passes::Specialization;

import Compiler::Diag;
import Compiler::Diag::Snapshot;
import Compiler::DeclIndex;
import Compiler::AST;
import Compiler::AST::{ Node, Declaration };
import Compiler::Passes::{ PassID, TypeResolution };
import Compiler::CompilationContext;
import Compiler::ModuleGraph;
import Compiler::Types;
import Compiler::Types::{ TypeRef, Arena, Type, UserDefined, Generic, Compound, GenericRegistry };
import Compiler::Mono::{ Monomorphizer, State };
import Compiler::Resolver::{ InternTable, SymbolStr };
import Utils::Logger;


/// Register a specialized type declaration using the arena type's actual
/// qualified name for method keys.  Uses the SpecializationEntry's
/// specialized_name as the key instead of ctx.qualify_symbol_sym to prevent
/// cross-module specs with the same bare name from overwriting each other.
/// This is wrapped as a static method (not a free function) to dodge a
/// codegen issue with parameter visibility inside free functions.
type struct SpecInjector {
    /// Register a specialized type using the arena type's ACTUAL qualified
    /// name for method keys.  This prevents cross-module specs with the
    /// same bare name (e.g. BattleTest::Pair_i32 vs Collections::Pair::Pair_i32)
    /// from overwriting each other's methods in the DI.
    static register(node: ASTNode*, spec_name: SymbolStr,
                    spec_type: TypeRef, owner_mod: SymbolStr,
                    ctx: CompilationContext*) -> void {
        if (node == null) { return; }
        // For function declarations, use the standard path (no naming conflict)
        if (node.kind == NodeKind::FunctionDeclaration) {
            SpecInjector::register_injected_decl(node, owner_mod, ctx);
            return;
        }
        if (!spec_type.is_valid()) {
            SpecInjector::register_injected_decl(node, owner_mod, ctx);
            return;
        }

        // Get the arena type's actual qualified name (e.g. "Collections::Pair::Pair_i32")
        // via TypeArena method that safely handles the pointer cast internally.
        const arena: TypeArena* = ctx.type_arena;
        const arena_qname: SymbolStr = arena.get_qualified_name(spec_type);
        if (!arena_qname.is_valid()) {
            SpecInjector::register_injected_decl(node, owner_mod, ctx);
            return;
        }

        // Owner module for DI ownership: the template's defining module for
        // relocated type specs (so codegen's define-vs-extern decision matches
        // where the AST is placed), else the demanding module.  Supplied by the
        // caller; see `register_spec`.
        const module_sym: SymbolStr = owner_mod;
        const local_sym: SymbolStr = ctx.qualify_symbol_sym(spec_name);

        // Register type under BOTH local and arena qualified names.
        // Local name (e.g. "BattleTest::Pair_i32") for same-module lookups.
        // Arena name (e.g. "Collections::Pair::Pair_i32") for cross-module lookups.
        // Skip local registration if the DI already has an entry; prevents a
        // cross-module spec (Collections::Pair_i32) from overwriting a same-
        // named local spec (BattleTest::Pair_i32) when both are injected into
        // the same module.
        const existing: TypeRef = ctx.decl_index.lookup_type(local_sym);
        if (!existing.is_valid()) {
            ctx.decl_index.register_type_with_module(local_sym, spec_type, module_sym);
        }
        if (!arena_qname.equals(local_sym)) {
            ctx.decl_index.register_type_with_module(arena_qname, spec_type, module_sym);
        }

        // Register a bare->qualified name mapping for the spec.  In-body
        // calls inside a spec'd method get rewritten by ASTTypeSubstituter
        // to use the bare-form spec name as their scope (e.g. inside
        // `Array<u8, GlobalAlloc>::with_capacity`'s body, the call
        // `Array::try_with_capacity_in(...)` is substituted to
        // `Array_<spec>::try_with_capacity_in(...)`).  Codegen's
        // ScopeResolution lookup uses `di.resolve_qualified(scope_name)`
        // to find the qualified form for the combined-key DI lookup,
        // and methods are registered under the QUALIFIED arena name.
        // Without this mapping the substituted bare scope passes through
        // unchanged and the combined-key lookup misses.
        if (!arena_qname.equals(spec_name)) {
            ctx.decl_index.register_name_mapping(spec_name, arena_qname);
        }

        // Methods registered ONLY under the arena qualified name.
        // This is the key fix: two specs with the same bare name get
        // different method keys, so they can't overwrite each other.
        if (node.kind == NodeKind::StructDeclaration) {
            const sn: StructDeclNode* = node as StructDeclNode*;
            ctx.decl_index.register_methods_with_module(
                arena_qname, sn.methods, module_sym, ctx.intern_table, ctx.type_arena);
        } else if (node.kind == NodeKind::ClassDeclaration) {
            const cn: ClassDeclNode* = node as ClassDeclNode*;
            ctx.decl_index.register_methods_with_module(
                arena_qname, cn.methods, module_sym, ctx.intern_table, ctx.type_arena);
        } else if (node.kind == NodeKind::EnumDeclaration) {
            // Enum methods come from implement blocks, not inline.
            // Type registration above already covers the enum itself.
        } else {
            SpecInjector::register_injected_decl(node, owner_mod, ctx);
        }
    }

    /// Register a newly injected specialized declaration into the DeclarationIndex
    /// so that sema can look it up without rescanning the AST.
    /// Delegates to the shared TypeResolutionPasses::register_decl_in_index().
    static register_injected_decl(stmt: ASTNode*, owner_mod: SymbolStr,
                                    ctx: CompilationContext*) -> void {
        // Injected spec clones, not source decls: pass is_source_decl=false so
        // they are skipped by the cross-module coherence check (their canonical
        // targets recur across every module that instantiates the template).
        // `owner_mod` sets the spec's DeclarationIndex module ownership to its
        // template's defining module (where Phase 6a-iii places its AST), so
        // codegen's define-vs-extern decision agrees with where it is emitted.
        TypeResolutionPasses::register_decl_in_index(stmt, ctx, false, owner_mod);
    }
}


// SpecializationPasses: static methods for cross-module resolution
//
// Entry points are wrapped as static methods on a struct (rather than free
// functions) because cross-module resolution of free functions through
// imported namespaces has historically been brittle at codegen time
// (compilation-ordering dependent).  Static methods resolve reliably.

type struct SpecializationPasses {

    // Pass 1: Template Registration

    /// Scans the AST for generic declarations (structs, enums, classes, functions,
    /// traits) and registers them in the GenericRegistry.  Also associates impl
    /// blocks with their target template.
    static run_template_registration(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        LOG_DEBUG(LogComponent::General, "[TemplateRegistration] Scanning for generic declarations");

        // Ensure the type system (and GenericRegistry) are initialized.
        // TypeDeclaration runs before this pass, so this is a safety guard.
        if (ctx.type_arena == null) {
            ctx.init_type_system();
        }

        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                           "TemplateRegistration: no AST root");
            return PassResult::failure(1);
        }

        // Get the generic registry (which now holds both templates and instantiations)
        const registry: GenericRegistry* = ctx.generic_registry;
        if (registry == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                           "TemplateRegistration: no generic registry");
            return PassResult::failure(1);
        }

        const arena: TypeArena* = ctx.type_arena;

        // Walk top-level statements
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }

            match (stmt.kind) {
                NodeKind::StructDeclaration => {
                    const node: StructDeclNode* = stmt as StructDeclNode*;
                    if (node.is_generic()) {
                        SpecializationPasses::register_generic_template(node.name, node.generic_params,
                            stmt, NodeKind::StructDeclaration, true, registry, arena, ctx);
                    }
                    // Static generic methods on non-generic structs (e.g.
                    // `Layout::array<T>`) need their own template entries;
                    // run_template_registration would otherwise miss them.
                    if (!node.is_generic()) {
                        SpecializationPasses::register_static_method_templates(node.name, node.methods,
                            registry, arena, ctx);
                        // Generic INSTANCE methods on non-generic structs
                        // (e.g. `Response::write_to<W>`) dispatch via receiver
                        // type rather than scope-qualified name; record the
                        // owner AST here so try_infer_method_call can find
                        // its `methods[]` from a receiver TypeRef.
                        SpecializationPasses::register_inherent_owner(node.name, stmt, registry, ctx);
                    }
                }
                NodeKind::EnumDeclaration => {
                    const node: EnumDeclNode* = stmt as EnumDeclNode*;
                    if (node.is_generic()) {
                        SpecializationPasses::register_generic_template(node.name, node.generic_params,
                            stmt, NodeKind::EnumDeclaration, true, registry, arena, ctx);
                    }
                }
                NodeKind::ClassDeclaration => {
                    const node: ClassDeclNode* = stmt as ClassDeclNode*;
                    if (node.is_generic()) {
                        SpecializationPasses::register_generic_template(node.name, node.generic_params,
                            stmt, NodeKind::ClassDeclaration, true, registry, arena, ctx);
                    }
                    if (!node.is_generic()) {
                        SpecializationPasses::register_static_method_templates(node.name, node.methods,
                            registry, arena, ctx);
                        SpecializationPasses::register_inherent_owner(node.name, stmt, registry, ctx);
                    }
                }
                NodeKind::FunctionDeclaration => {
                    const node: FunctionDeclNode* = stmt as FunctionDeclNode*;
                    if (node.is_generic()) {
                        SpecializationPasses::register_generic_template(node.name, node.generic_params,
                            stmt, NodeKind::FunctionDeclaration, false, registry, arena, ctx);
                    }
                }
                NodeKind::TraitDeclaration => {
                    const node: TraitDeclNode* = stmt as TraitDeclNode*;
                    if (node.is_generic()) {
                        SpecializationPasses::register_generic_template(node.name, node.generic_params,
                            stmt, NodeKind::TraitDeclaration, true, registry, arena, ctx);
                    }
                }
                NodeKind::TypeAliasDeclaration => {
                    const node: TypeAliasDeclNode* = stmt as TypeAliasDeclNode*;
                    if (node.is_generic()) {
                        SpecializationPasses::register_generic_template(node.alias_name, node.generic_params,
                            stmt, NodeKind::TypeAliasDeclaration, true, registry, arena, ctx);
                    }
                }
                NodeKind::ImplementationBlock => {
                    SpecializationPasses::register_impl_block(stmt as ImplBlockNode*, registry, ctx);
                }
                _ => {
                    // Not a declaration that can be generic
                }
            }
        }

        LOG_DEBUG(LogComponent::General, "[TemplateRegistration] Registered %lld templates", registry.template_count());

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }


    // Pass 2: Monomorphization

    /// Creates a Monomorphizer and processes all pending generic instantiations.
    static run_monomorphization(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        LOG_DEBUG(LogComponent::General, "[Monomorphization] Processing generic instantiations");

        // Get required components
        const arena: TypeArena* = ctx.type_arena;
        if (arena == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                           "Monomorphization: no TypeArena");
            return PassResult::failure(1);
        }

        const generic_reg: GenericRegistry* = ctx.generic_registry;
        if (generic_reg == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                           "Monomorphization: generic registry not initialized");
            return PassResult::failure(1);
        }

        // Reuse existing monomorphizer across modules (batch compilation),
        // or create one on first use.
        mut mono_ptr: Monomorphizer* = ctx.monomorphizer;
        const module_sym: SymbolStr = ctx.intern(ctx.source_file);
        if (mono_ptr != null) {
            // Subsequent module: clear transient state, keep specialization cache
            mono_ptr.reset_for_next_module();
            mono_ptr.set_current_module(module_sym);
        } else {
            // First module: allocate and store on context
            const _box_mono: Box<Monomorphizer> = Box<Monomorphizer>::new(
                Monomorphizer::new(arena, generic_reg, ctx.intern_table, ctx.diagnostics,
                                   ctx.type_resolver, ctx.decl_index));
            mono_ptr = _box_mono.leak();
            // The new orchestrator does NOT auto-wire its collaborators; their
            // back-pointers must be set AFTER the leak puts it at a stable heap
            // address (the old monolith had no wire() step).
            mono_ptr.wire();
            mono_ptr.set_current_module(module_sym);
            ctx.monomorphizer = mono_ptr;
        }

        // Bug C: annotate bound-directed method dispatch (e.g. Display vs
        // Debug `fmt`) BEFORE process_all clones any template, so every
        // specialization inherits the disambiguating trait through the
        // cloner.  Must precede process_all (which materializes specs).
        const ann_root: ProgramNode* = ctx.artifacts.ast.root;
        if (ann_root != null) {
            mono_ptr.annotate_bound_dispatch_in_module(ann_root);
        }

        mut success: boolean = mono_ptr.process_all();

        // Walk this module's non-generic free functions and inline
        // struct/class method bodies to specialize every generic call sema
        // pinned a binding stash onto (free calls, instance/static generic
        // methods, e.g. `Request::parse(stream)` inside `handle_connection`).
        // This CONSUMES sema's `CallExprNode.resolved_type_args`; it never
        // re-derives bindings.  (Owner-generic `![implicit]` static converters
        // like `String<GlobalAlloc>::from_cstr` are now synthesized by sema
        // with `scope_generic_args` pre-mono, so the normal stash path covers
        // them — the old eager `force_instantiate_static_converter` loop is
        // gone.)
        //
        // WALK/DRAIN FIXPOINT: re-walking is idempotent (each call is guarded
        // by its `resolved_callee` / non-generic `resolved_method`), so iterate
        // walk + drain until no new specialization entries appear.  This is
        // what resolves adapter-chain receivers (`r.map(f).fold()`) now that
        // the monolith's synchronous `ensure_receiver_inst_resolved` is gone:
        // the first pass types+specializes `.map(f)`, the next pass sees the
        // now-resolved receiver of `.fold()`, and so on to a fixpoint.
        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root != null) {
            loop {
                const before: i64 = mono_ptr.spec_count();
                mono_ptr.specialize_calls_in_module(root);
                // Drain the pending worklist for any new instantiations queued
                // by the walk.  We deliberately don't re-enter `process_all`
                // here because its `collect_unmonomorphized` pre-pass would
                // re-feed already-filtered partial specs (those containing
                // GenericParam at depth) and re-run post-pass marking.
                const post_success: boolean = mono_ptr.drain_pending_worklist();
                if (success) { success = post_success; }
                if (mono_ptr.spec_count() == before) { break; }
            }
        }

        LOG_DEBUG(LogComponent::General, "[Monomorphization] Completed: %lld specializations",
            mono_ptr.specialization_count());

        if (!success) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                           "Monomorphization failed");
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }


    // Pass 3: Generic Expression Resolution
    //
    // This pass REGISTERS each new specialization into the DeclarationIndex
    // (under the demanding module, exactly as before) so that monomorphization
    // discovery for later modules in the same Phase 6a-ii loop can resolve
    // calls against already-created specs.  It deliberately does NOT place the
    // spec's AST into a ProgramNode root — physical placement is deferred to
    // Phase 6a-iii (`route_specializations_to_owners`), which injects each spec
    // into its DETERMINISTIC owner module (the template's defining module),
    // independent of demand order.  Splitting registration (here, per demander)
    // from placement (there, per owner) keeps discovery byte-identical while
    // making a spec's object-file home a function of its template.
    static run_generic_expression_resolution(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        mut mono: Monomorphizer* = ctx.monomorphizer;
        if (mono == null) {
            // No monomorphizer means no generics were used; that's OK.
            return PassResult::ok();
        }

        const module_sym: SymbolStr = ctx.intern(ctx.source_file);
        mono.set_current_module(module_sym);

        const reg_start: i64 = mono.get_injection_cursor();
        const reg_end: i64 = mono.spec_count();
        if (reg_start >= reg_end) {
            mono.advance_injection_cursor();
            return PassResult::ok();
        }

        for (mut i: i64 = reg_start; i < reg_end; i++) {
            const entry: SpecializationEntry* = mono.spec_entry_at(i);
            SpecializationPasses::register_spec(ctx, mono, entry, i);
        }
        mono.advance_injection_cursor();

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }

    /// Register a single specialization into the DeclarationIndex, scope-tag its
    /// AST nodes, and re-register its impl methods.  Runs under the DEMANDING
    /// module's `ctx` (same as the pre-refactor inline loop) so discovery and
    /// DI state are byte-identical to baseline.  Does NOT place the AST into any
    /// root — that is Phase 6a-iii's job.  `entry_index` is the spec's slot in
    /// `mono.spec_entries`.
    static register_spec(ctx: CompilationContext*, mono: Monomorphizer*,
                         entry: SpecializationEntry*, entry_index: i64) -> void {
        const arena: TypeArena* = ctx.type_arena;
        const module_sym: SymbolStr = ctx.intern(ctx.source_file);

        // Resolve this spec's OWNER module.  Both DI ownership (here) and AST
        // placement (Phase 6a-iii) key off `owner_source`, so they always
        // agree: codegen's `owned_by_current_module` matches the module whose
        // root holds the definition.
        //
        // EVERY spec with a known template module relocates to that template's
        // defining module — the deterministic, demand-order-independent owner —
        // so a module's object file is a function of its own source plus the
        // templates it defines.
        //
        //   * TYPE specs (struct/enum/class) are named by the type's arena
        //     qualified name, which is LOCATION-INDEPENDENT.
        //   * FUNCTION / static-method-generic specs have no arena type, so the
        //     template namespace is stamped onto the spec's FunctionDeclNode
        //     (`source_module`, below) and read back at DI registration
        //     (register_decl_in_index) and at codegen (declare_function /
        //     codegen_function_prologue).  That makes their definition symbol
        //     and every caller's cross-module reference both qualify by the
        //     TEMPLATE module, so relocating the definition no longer diverges
        //     the names (which used to yield undefined-symbol link errors such
        //     as `CompileMode::Layout_of<...>` / `Sema::swap<u32[]>`).
        //
        // Specs with no template module (synthetic single-file specs) fall back
        // to the creating module.
        mut owner_module_sym: SymbolStr = module_sym;
        if (entry.template_module.is_valid()
                && ctx.module_graph != null) {
            const owner_path: SymbolStr = ctx.module_graph.source_file_for_owner_key(
                entry.template_module, ctx.intern_table);
            if (owner_path.is_valid()) { owner_module_sym = owner_path; }
        }
        entry.owner_source = owner_module_sym;

        // Stamp the canonical (template-derived) namespace onto FUNCTION specs
        // so their definition symbol and every caller reference qualify by the
        // template module rather than by whichever module emits/demands them.
        // Type specs get this for free via their arena qualified name; free
        // functions and static-method generics have no arena type, so the
        // namespace must ride on the node.  Read back by
        // `register_decl_in_index` (q_name) and `DeclarationEmitter`
        // (fn_qualified_name).  Must run BEFORE `SpecInjector::register` below.
        // `entry.template_module` is the template's namespace (or its source
        // path for root-namespace templates); either way the stamp is the single
        // source of truth for the spec's qualifier, so def and callers agree.
        if (entry.ast_node != null
                && entry.ast_node.kind == NodeKind::FunctionDeclaration
                && entry.template_module.is_valid()) {
            const tmpl_ns: string = ctx.intern_table.resolve(entry.template_module);
            SpecializationPasses::tag_decl_source_module(entry.ast_node, tmpl_ns);
        }

        // Scope-tag the main AST with its template module origin in the
        // CompilationContext's node-identity side table. This is kept separate
        // from the node's `source_module` field on purpose: that field is also
        // used to stamp ordinary (non-injected) decls with their defining module
        // (see type_resolution's ImplementationBlock handler), so it can't mark
        // "this exact node is an injected spec" without conflation. The side
        // table only ever holds injected specs, which is what `dispatch_top_level`
        // needs. (An earlier comment blamed a vtable field-write miscompile; that
        // was misdiagnosed — base writes are correct — but the side table stays
        // for the disambiguation reason above.) Physical placement into the
        // owner module's root happens later in Phase 6a-iii.
        if (entry.ast_node != null) {
            if (entry.template_module.is_valid()) {
                ctx.register_injected_origin(
                    entry.ast_node as u64, entry.template_module);
            }
        }
        // Scope-tag impl blocks
        for (mut j: i64 = 0; j < entry.impl_nodes.length; j++) {
            if (entry.template_module.is_valid()) {
                ctx.register_injected_origin(
                    entry.impl_nodes[j] as u64, entry.template_module);
            }
        }

        // Register in DeclarationIndex using the arena type's ACTUAL
        // qualified name for method keys.  This prevents two specs with
        // the same bare name (e.g. BattleTest::Pair_i32 and
        // Collections::Pair::Pair_i32) from overwriting each other.
        if (entry.ast_node != null) {
            SpecInjector::register(entry.ast_node, entry.specialized_name,
                                   entry.specialized_type, owner_module_sym, ctx);
        }
        // Register the InstantiatedType's TypeRef in type_reverse so
        // that codegen can look up the concrete type's qualified name
        // directly from the expression's resolved_type (which may be
        // the InstantiatedType, not the concrete struct).
        if (entry.instantiated_type.is_valid() && entry.specialized_type.is_valid()) {
            const conc_qname: SymbolStr = arena.get_qualified_name(entry.specialized_type);
            if (conc_qname.is_valid()) {
                ctx.decl_index.register_type_reverse_only(conc_qname, entry.instantiated_type);

                // For Array specializations, register a mapping from
                // element TypeRef -> concrete Array_<T> struct name.
                // Sema sets expression types to ArrayType (T[]), not
                // InstantiatedType, so codegen needs this to find methods.
                // The element type is always type_args[0]; subsequent args
                // (e.g. the allocator in stdlib-next's `Array<T, A = GlobalAlloc>`)
                // are part of the Array spec but not part of the element key.
                const inst_t: Type* = arena.lookup(entry.instantiated_type.id);
                if (inst_t != null && inst_t.kind == TypeKind::InstantiatedType) {
                    const inst: InstantiatedType* = inst_t as InstantiatedType*;
                    if (inst.type_args.length >= 1) {
                        const base_qn: SymbolStr = arena.get_qualified_name(inst.generic_base);
                        if (base_qn.is_valid()) {
                            const base_str: string = ctx.intern_table.resolve(base_qn);
                            if (strcmp(base_str, "std::collections::array::Array") == 0) {
                                ctx.decl_index.register_array_element_type(
                                    inst.type_args[0], conc_qname);
                            }
                        }
                    }
                }
            }
        }
        // Register impl block methods under the SAME qualified name as
        // the type itself (from the arena), not ctx.qualify_symbol_sym
        // which would use the consuming module's namespace.
        const impl_qname: SymbolStr = if (entry.specialized_type.is_valid()) {
            arena.get_qualified_name(entry.specialized_type)
        } else {
            SymbolStr::empty()
        };
        for (mut j: i64 = 0; j < entry.impl_nodes.length; j++) {
            const impl_node: ImplBlockNode* = entry.impl_nodes[j] as ImplBlockNode*;
            // Bounds-violating impls were dropped pre-clone by
            // `Monomorphizer::filter_bounds_violating_impls`; any
            // impl reaching here is fully applicable to this spec.
            if (impl_qname.is_valid() && impl_node != null) {
                impl_node.set_target_type(impl_qname);
                ctx.decl_index.register_methods_with_module(
                    impl_qname, impl_node.methods, owner_module_sym, ctx.intern_table, ctx.type_arena);
                // Re-register trait-impl entries against the *specialized*
                // target so `traits_implemented_by(spec_name)` finds them.
                // The original impl was `implement trait Hash for struct
                // String`, registered under bare `String` at template-
                // registration time; without this re-register, sema's
                // method-via-trait lookup for `String<GlobalAlloc>::hash`
                // bottoms out and emits E0091.
                if (impl_node.is_trait_impl()) {
                    const trait_nm: SymbolStr = SpecializationPasses::extract_root_name(impl_node.trait_annotation);
                    if (trait_nm.is_valid()) {
                        ctx.generic_registry.register_trait_impl(
                            trait_nm, impl_qname, impl_node);
                    }
                }
            } else {
                SpecInjector::register_injected_decl(entry.impl_nodes[j], owner_module_sym, ctx);
            }
        }

        mono.record_consuming_module(entry_index, module_sym);
    }

    /// Phase 6a-iii: place specializations OWNED by the currently-loaded module
    /// into its AST root.  `ctx` must already be loaded to a candidate owner
    /// module.  DeclarationIndex registration already happened in `register_spec`
    /// (Phase 6a-ii); this pass only performs the physical `add_statement`, which
    /// determines which object file emits the spec's definition.
    ///
    /// Placement keys off `entry.owner_source` — the resolved owner module's
    /// source-file path that `register_spec` ALSO used for DI ownership — so AST
    /// placement and DI ownership always agree.  The owner is the template's
    /// defining module (deterministic, demand-order independent) for every spec
    /// whose template module resolves to a module in the build; specs with no
    /// template module fall back to their creating module.  This is sound for
    /// type specs (named by location-independent arena qname) AND function /
    /// method-generic specs (named by `spec_base_name`, which folds the template
    /// module).  Each spec is placed exactly once, guarded by `entry.injected`.
    static route_specializations_to_owners(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        mut mono: Monomorphizer* = ctx.monomorphizer;
        if (mono == null) { return PassResult::ok(); }

        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) { return PassResult::ok(); }

        const my_src: SymbolStr = ctx.intern(ctx.source_file);

        const total: i64 = mono.spec_count();
        mut place_count: i64 = 0;
        for (mut i: i64 = 0; i < total; i++) {
            mut entry: SpecializationEntry* = mono.spec_entry_at(i);
            if (entry.injected) { continue; }
            if (!entry.owner_source.is_valid()) { continue; }
            if (!entry.owner_source.equals(my_src)) { continue; }
            entry.injected = true;
            if (entry.ast_node != null) {
                root.add_statement(entry.ast_node);
            }
            for (mut j: i64 = 0; j < entry.impl_nodes.length; j++) {
                root.add_statement(entry.impl_nodes[j]);
            }
            place_count += 1;
        }

        LOG_DEBUG(LogComponent::General,
            "[SpecRouting] Placed %lld specializations into owner '%s'",
            place_count, ctx.source_file);

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }


    // Pass 4: Generic Validation

    /// Walks all types in the arena and asserts that every InstantiatedType
    /// has a valid resolved_type.  Delegates to free functions to avoid
    /// vtable-offset issues with class-method field access.
    static run_generic_validation(ctx: CompilationContext*) -> PassResult {
        return SpecializationPasses::run_generic_validation_impl(ctx);
    }

    /// Unified template registration for any generic declaration.
    /// Extracts generic parameter metadata, qualifies the name, looks up the
    /// base type in the arena, and registers a TemplateEntry.
    ///
    /// `name` and `generic_params` are the common fields every generic
    /// declaration shares.  `ast_node` is the original declaration cast to
    /// ASTNode*.  `node_kind` identifies which declaration type it is.
    /// `lookup_base` controls whether the base type is looked up in the arena
    /// (true for types: struct/enum/class/trait) or left invalid (false for
    /// functions, which have no arena entry).
    static register_generic_template(name: SymbolStr, generic_params: &GenericParamNode*[],
                                       ast_node: ASTNode*, node_kind: NodeKind,
                                       lookup_base: boolean,
                                       registry: GenericRegistry*, arena: TypeArena*,
                                       ctx: CompilationContext*) -> void {
        if (generic_params.length == 0) { return; }

        const qualified_sym: SymbolStr = ctx.qualify_symbol_sym(name);
        // Use the namespace (not file path) as the module name so that
        // the monomorphizer's ResolutionContext can qualify type lookups
        // correctly (e.g., "std::core::option" not "./core/option.cryo").
        const module_sym: SymbolStr = if (ctx.has_namespace()) {
            ctx.namespace_str
        } else {
            ctx.intern(ctx.source_file)
        };
        LOG_DEBUG(LogComponent::General, "[TemplateRegistration] Registering %s template '%s'",
            node_kind.to_string(), ctx.resolve_str(name));

        // Use the shared utility for arena TypeRef creation (single source of truth)
        const refs: TypeRef[] = TypeResolutionPasses::create_generic_param_types(
            generic_params, arena);
        mut param_names: SymbolStr[] = [];
        mut param_type_ids: u64[] = [];
        for (mut i: i64 = 0; i < generic_params.length; i++) {
            const gp: GenericParamNode* = generic_params[i];
            param_names.push(gp.name);
            param_type_ids.push(refs[i].id);
        }

        mut base_type: TypeRef = TypeRef::invalid();
        if (node_kind == NodeKind::FunctionDeclaration) {
            // Generic functions have no arena type, but they need a TypeID so
            // the GenericRegistry can track instantiations (e.g., identity<int>).
            // Use a FunctionTemplate placeholder instead of a fake StructType.
            base_type = arena.create_function_template(qualified_sym);
        } else if (lookup_base) {
            base_type = arena.lookup_by_name(qualified_sym);
        }

        const entry: TemplateEntry = TemplateEntry::new(
            name, qualified_sym, module_sym,
            param_names, param_type_ids,
            ast_node, node_kind,
            base_type
        );
        registry.register_template(entry);
    }

    /// Register every generic STATIC method on `methods` as a function-style
    /// template. Static generic methods on non-generic types (e.g.
    /// `Layout::array<T>`) are otherwise invisible to the monomorphizer because
    /// `run_template_registration` only walks top-level declarations. Without
    /// registration the inference path in `try_infer_function_call` can't find
    /// them, and ScopeResolution callees like `Layout::array<int>(n)` link to a
    /// never-emitted bare-template symbol.
    ///
    /// Generic NON-static methods are intentionally skipped; those go through
    /// `try_infer_method_call` / `specialize_method`, which dispatches by
    /// receiver type rather than scope-qualified name.
    ///
    /// Owner-qualified key (`<owner_qualified>::<method>`) avoids collisions
    /// when two types in the same namespace each declare a static method with
    /// the same bare name.
    static register_static_method_templates(owner_name: SymbolStr,
                                              methods: &MethodNode*[],
                                              registry: GenericRegistry*,
                                              arena: TypeArena*,
                                              ctx: CompilationContext*) -> void {
        if (methods.length == 0) { return; }

        const owner_qsym: SymbolStr = ctx.qualify_symbol_sym(owner_name);
        const owner_qstr: string = ctx.intern_table.resolve(owner_qsym);
        const module_sym: SymbolStr = if (ctx.has_namespace()) {
            ctx.namespace_str
        } else {
            ctx.intern(ctx.source_file)
        };

        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null) { continue; }
            if (!m.is_static) { continue; }
            if (!m.func.is_generic()) { continue; }

            const method_str: string = ctx.intern_table.resolve(m.func.name);
            const qualified_str: string = owner_qstr + "::" + method_str;
            const qualified_sym: SymbolStr = ctx.intern_table.intern(qualified_str);

            const refs: TypeRef[] = TypeResolutionPasses::create_generic_param_types(
                m.func.generic_params, arena);
            mut param_names: SymbolStr[] = [];
            mut param_type_ids: u64[] = [];
            for (mut j: i64 = 0; j < m.func.generic_params.length; j++) {
                const gp: GenericParamNode* = m.func.generic_params[j];
                param_names.push(gp.name);
                param_type_ids.push(refs[j].id);
            }

            const base_type: TypeRef = arena.create_function_template(qualified_sym);

            const entry: TemplateEntry = TemplateEntry::new(
                m.func.name, qualified_sym, module_sym,
                param_names, param_type_ids,
                m.func as ASTNode*, NodeKind::FunctionDeclaration,
                base_type
            );
            registry.register_template(entry);
        }
    }

    /// Register a non-generic struct/class AST as an "inherent owner",
    /// keyed by both qualified and bare name.  Two consumers:
    ///
    /// * The monomorphizer / sema walk the owner's `methods[]` to specialize
    ///   generic INSTANCE methods (e.g. `Response::write_to<W>`).  Generic
    ///   STATIC methods take a separate path via
    ///   `register_static_method_templates`, which keys them by
    ///   `Owner::method` for ScopeResolution callees.
    /// * `OwnershipQuery::has_inherent_drop` walks the owner's `methods[]`
    ///   to detect an inline `drop` so the Copy classifier and the
    ///   drop-insertion pass treat the type as non-Copy and synthesize
    ///   scope-exit drops.
    ///
    /// Registration is unconditional for non-generic owners so the index is
    /// a complete `qualified_name -> AST` map for them; receiver-type lookups
    /// no longer have to thread a fallback through DeclarationIndex.  Generic
    /// owners go through `register_generic_template` instead; their methods
    /// are specialized as part of struct/class monomorphization rather than
    /// per-call.
    static register_inherent_owner(
            owner_name: SymbolStr, owner_ast: ASTNode*,
            registry: GenericRegistry*, ctx: CompilationContext*) -> void {
        if (owner_ast == null) { return; }
        const owner_qsym: SymbolStr = ctx.qualify_symbol_sym(owner_name);
        registry.register_inherent_owner(owner_qsym, owner_ast);
        // Also register under the bare name so receiver-type lookups that
        // miss the qualified form (e.g., when the arena returns the bare
        // name for primitive impls) still find the owner.
        if (!owner_qsym.equals(owner_name)) {
            registry.register_inherent_owner(owner_name, owner_ast);
        }
    }

    /// Tag an AST node's source_module field with the template's module name.
    /// struct/class/enum/function/impl decls are all DeclarationNode subclasses and
    /// `source_module` lives on that shared base, so a single base-pointer write
    /// covers every kind. (The kind check keeps the cast sound — only declaration
    /// nodes are written.) The earlier per-leaf concrete casts here worked around a
    /// believed vtable field-offset miscompile; that was misdiagnosed — base-pointer
    /// field writes on the vtable'd AST hierarchy are correct (verified 2026-06-17,
    /// O0+O2). The real crash was a since-fixed mangler ICE on `Array<ptr>` specs.
    static tag_decl_source_module(node: ASTNode*, module: string) -> void {
        if (node == null) { return; }
        const k: NodeKind = node.kind;
        const is_decl: boolean =
            k == NodeKind::StructDeclaration || k == NodeKind::ClassDeclaration
            || k == NodeKind::EnumDeclaration || k == NodeKind::FunctionDeclaration
            || k == NodeKind::ImplementationBlock;
        if (!is_decl) { return; }
        const decl: DeclarationNode* = node as DeclarationNode*;
        decl.source_module = module;
    }

    static register_impl_block(node: ImplBlockNode*, registry: GenericRegistry*,
                                 ctx: CompilationContext*) -> void {
        // Qualify the target name so impl blocks use the same key as templates.
        const qualified_sym: SymbolStr = ctx.qualify_symbol_sym(node.target_type);
        if (registry.get_template(qualified_sym) != null) {
            registry.register_impl_block(qualified_sym, node);
        } else if (!node.is_trait_impl()) {
            // Non-generic target: there is no TemplateEntry to hang the block
            // on, so an inherent `implement T { ... }` block would otherwise be
            // invisible to ownership classification.  Record it under both the
            // qualified and bare names (mirroring `register_inherent_owner`) so
            // a separately-declared `drop` makes `T` non-Copy and droppable.
            registry.register_inherent_impl_block(qualified_sym, node);
            if (!qualified_sym.equals(node.target_type)) {
                registry.register_inherent_impl_block(node.target_type, node);
            }
        }

        // Trait impls (`implement trait Foo for Bar`) also go into the
        // (trait, target) registry so sema/dispatch can find them by trait
        // name. Inherent impls (`implement Bar { ... }`) skip this branch.
        if (node.is_trait_impl()) {
            const trait_name: SymbolStr = SpecializationPasses::extract_root_name(node.trait_annotation);
            if (trait_name.is_valid()) {
                // NOTE: coherence (a trait may be implemented at most once per
                // type) is NOT checked here.  At this stage (DeclarationCollection)
                // there is no import-resolved target name, so a key would have to
                // use bare simple names — which conflate same-named types in
                // different modules and ignore trait/target type args.  The
                // single coherence check lives in TypeResolution's
                // `register_decl_in_index`, after `canonical_target` is stamped;
                // it covers same-file and cross-module duplicates uniformly,
                // including generic traits.  This branch only populates the
                // dispatch registry.
                registry.register_trait_impl(trait_name, node.target_type, node);
            }
        }
    }

    /// Walk a TypeAnnotation* to its underlying head identifier. Used to pull
    /// `Foo` out of `Foo`, `Foo<T>`, or `&Foo`. Returns an invalid SymbolStr
    /// for shapes the trait-impl registry doesn't index (Primitive, ThisType,
    /// Tuple, Function, Optional, Array). Qualified-path traits are tracked
    /// only by their leaf name here; full-path indexing is B.4 work.
    static extract_root_name(ann: TypeAnnotation*) -> SymbolStr {
        if (ann == null) { return SymbolStr::empty(); }
        return match (*ann) {
            TypeAnnotation::Named(n) => { n.name }
            TypeAnnotation::Generic(g) => { SpecializationPasses::extract_root_name(g.base) }
            TypeAnnotation::Reference(r) => { SpecializationPasses::extract_root_name(r.inner) }
            TypeAnnotation::Pointer(p) => { SpecializationPasses::extract_root_name(p.inner) }
            _ => { SymbolStr::empty() }
        };
    }

    static run_generic_validation_impl(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        const arena: TypeArena* = ctx.type_arena;
        if (arena == null) {
            return PassResult::ok();
        }

        const count: i64 = arena.type_count();
        LOG_DEBUG(LogComponent::General, "[GenericValidation] Validating %lld types in arena", count);

        mut unresolved_count: i64 = 0;

        for (mut i: i64 = 0; i < count; i++) {
            const ty: Type* = arena.types[i];
            if (ty == null) { continue; }

            // Non-virtual field access only; ty.kind is a plain enum field.
            if (ty.kind != TypeKind::InstantiatedType) { continue; }

            const inst: InstantiatedType* = ty as InstantiatedType*;

            // resolved_type is a TypeRef (plain struct); is_valid() is non-virtual.
            if (inst.resolved_type.is_valid()) { continue; }

            // Instantiations minted only by the additive symbolic generic-body walk
            // are never monomorphized or codegen'd (they may be concrete types that
            // live solely inside a never-instantiated template). They are not real
            // unresolved instantiations — skip, exactly like the generic-arg ones below.
            if (inst.is_symbolic) { continue; }

            // Skip template-internal references whose type args contain generic
            // parameters at any depth (e.g., Pair<T>, Option<Result<T, E>>).
            // These are created when a generic declaration references another
            // generic with its own params and are never meant to be monomorphized
            // until the *outer* template is specialized.  The shallow direct-arg
            // check used to miss nested cases like Option<Result<T,E>> where the
            // direct arg is an InstantiatedType, not a GenericParam.  Mirrors
            // the recursive filter in `TypeArena::contains_generic_param`, which is
            // the single authority every consumer (mono, sema, this validator) shares.
            mut has_generic_arg: boolean = false;
            for (mut j: i64 = 0; j < inst.type_args.length; j++) {
                if (arena.contains_generic_param(inst.type_args[j])) {
                    has_generic_arg = true;
                }
            }
            if (has_generic_arg) { continue; }

            // This InstantiatedType was never monomorphized.
            unresolved_count += 1;

            // All fields accessed below are plain data (u64, i64), no vtable dispatch.
            const base_id: u64 = inst.generic_base.id;
            const n_args: i64 = inst.type_args.length;
            const base_qname: SymbolStr = arena.get_qualified_name(inst.generic_base);
            mut base_name: string = "<no-qname>";
            if (base_qname.is_valid()) { base_name = ctx.intern_table.resolve(base_qname); }
            mut args_disp: string = "";
            for (mut ai: i64 = 0; ai < inst.type_args.length; ai++) {
                const aqn: SymbolStr = arena.get_qualified_name(inst.type_args[ai]);
                mut an: string = "?";
                if (aqn.is_valid()) { an = ctx.intern_table.resolve(aqn); }
                if (ai > 0) { args_disp = args_disp + ", "; }
                args_disp = args_disp + an;
            }
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("unresolved generic instantiation after monomorphization: '%s<%s>' (inst_id=%lu, base_id=%lu, n_args=%lld)",
                        base_name, args_disp, inst.id, base_id, n_args));
        }

        if (unresolved_count > 0) {
            LOG_DEBUG(LogComponent::General, "[GenericValidation] FAILED: %lld unresolved types found",
                unresolved_count);
        } else {
            LOG_DEBUG(LogComponent::General, "[GenericValidation] All generic types fully resolved");
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }
}
