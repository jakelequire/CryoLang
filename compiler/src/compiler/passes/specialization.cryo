/// Specialization Passes
///
/// Three pass implementations for the generic specialization pipeline:
///
///   1. TemplateRegistration: Scans the AST for generic declarations and
///      registers them in the GenericRegistry.
///
///   2. Monomorphization: Runs the worklist-driven Monomorphizer to produce
///      concrete types and specialized ASTs for every InstantiatedType.
///
///   3. GenericExpressionResolution: Injects specialized ASTs into the
///      ProgramNode so codegen sees only concrete declarations.
///
///   4. GenericValidation: Walks all types in the arena and asserts that
///      every InstantiatedType has a resolved concrete type.  Catches
///      missed monomorphizations before they reach codegen or type lowering.

namespace compiler::passes::specialization;

import compiler::diag::{ ErrorCode };
import compiler::diag::snapshot::{ DiagnosticSnapshot };
import compiler::decl_index;
import compiler::ast::{ declaration, node, TypeAnnotation };
import compiler::passes::{ pass_id, type_resolution };
import compiler::compilation_context::{ CompilationContext };
import compiler::module_graph::{ ModuleGraph, ModulePath };
import compiler::types::{
    arena, compound, generic, generic_registry, type_base, type_ref, TypeKind,
    user_defined
};
import compiler::mono::{ monomorphizer, state };
import compiler::resolver::{ intern_table, res, symbol_str };
import compiler::utils::log::{ Log, LogArea, LogLevel };
import std::fmt;
import std::collections::string::{ String };
import compiler::ast::declaration::{
    DeclarationNode, DeclKind, FunctionDecl, GenericParamDecl,
    ImplBlock, MethodDecl, StructDecl, TraitDecl, UnionDecl
};
import compiler::ast::node::{ Node, ProgramNode };
import compiler::mono::monomorphizer::{ Monomorphizer };
import compiler::mono::state::{ BlockPlacement, SpecializationEntry };
import compiler::passes::pass_id::{ PassResult };
import compiler::sema::sema::{ SemaVisitor };
import compiler::passes::type_resolution::{ TypeResolutionPasses };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::res::{ DefId };
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::types::arena::{ TypeArena };
import compiler::types::compound::{
    ArrayType, FunctionType, OptionalType, PointerType, ReferenceType, TupleType
};
import compiler::types::generic::{ InstantiatedType };
import compiler::types::generic_registry::{ GenericRegistry, TemplateEntry, TemplateKind };
import compiler::resolver::lang_item::{ LangItem };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };


/// The declaration-index side of placing a specialization.  A NAMED
/// specialization - a struct, union or enum clone with an arena type -
/// was registered by the monomorphizer when its entry was placed: the type,
/// its bare-name mapping, the methods it carries and its impl blocks', with
/// the id stamped on the clone.  Nothing is registered for one here.  This
/// is wrapped as a static method (not a free function) to dodge a codegen
/// issue with parameter visibility inside free functions.
type struct SpecInjector {
    /// Register a placed specialization that has NO named type - a function
    /// template's clone - as an ordinary injected declaration.  A named one
    /// is already in the index and is left alone: a second registration of
    /// the same declaration is a second writer of every key it holds.
    static register(node: DeclarationNode*, spec_type: TypeRef, ctx: mut CompilationContext*) -> void {
        if (node == null) { return; }
        const named: boolean = spec_type.is_valid()
            && (DeclarationNode::struct_of(node) != null
                || DeclarationNode::union_of(node) != null
                || DeclarationNode::enum_of(node) != null);
        if (!named) {
            SpecInjector::register_injected_decl(node, ctx);
        }
    }

    /// Register a newly injected specialized declaration into the DeclarationIndex
    /// so that sema can look it up without rescanning the AST.
    /// Delegates to the shared TypeResolutionPasses::register_decl_in_index().
    static register_injected_decl(stmt: DeclarationNode*, ctx: mut CompilationContext*) -> void {
        // Injected spec clones, not source decls: pass is_source_decl=false so
        // they are skipped by the cross-module coherence check (their canonical
        // targets recur across every module that instantiates the template).
        TypeResolutionPasses::register_decl_in_index(stmt, ctx, false);
    }
}


// SpecializationPasses: static methods for cross-module resolution
//
// Entry points are wrapped as static methods on a struct (rather than free
// functions) because cross-module resolution of free functions through
// imported namespaces has historically been brittle at codegen time
// (compilation-ordering dependent).  Static methods resolve reliably.

type struct SpecializationPasses {

    // Pass 1: Template Registration

    /// Scans the AST for generic declarations (structs, enums, functions,
    /// traits) and registers them in the GenericRegistry.  Also associates impl
    /// blocks with their target template.
    static run_template_registration(ctx: mut CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                           "TemplateRegistration: no AST root");
            return PassResult::failure(1);
        }

        // Get the generic registry (which now holds both templates and instantiations)
        const registry: mut GenericRegistry* = ctx.generic_registry;
        if (registry == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                           "TemplateRegistration: no generic registry");
            return PassResult::failure(1);
        }

        const arena: mut TypeArena* = ctx.type_arena;

        // Walk top-level statements
        for (mut i: i64 = 0; i < root.statements.length(); i++) {
            const stmt: DeclarationNode* = root.statements[i].as_decl();
            if (stmt == null) { continue; }

            // A template holds the declaration's header.
            const decl: DeclarationNode* = stmt;
            match (decl.kind) {
                DeclKind::Function(node) => {
                    if (node.is_generic()) {
                        SpecializationPasses::register_generic_template(node.name, node.generic_params,
                            decl, TemplateKind::Function, node.def, registry, arena, ctx);
                    }
                }
                DeclKind::Struct(node) => {
                    if (node.is_generic()) {
                        SpecializationPasses::register_generic_template(node.name, node.generic_params,
                            decl, TemplateKind::Struct, node.def, registry, arena, ctx);
                    }
                    // Static generic methods on non-generic structs (e.g.
                    // `Layout::array<T>`) need their own template entries;
                    // run_template_registration would otherwise miss them.
                    if (!node.is_generic()) {
                        SpecializationPasses::register_static_method_templates(node.methods,
                            registry, arena, ctx);
                        // Generic INSTANCE methods on non-generic structs
                        // (e.g. `Response::write_to<W>`) dispatch via
                        // receiver type rather than scope-qualified name;
                        // record the owner AST here so
                        // try_infer_method_call can find its `methods[]`
                        // from a receiver TypeRef.
                        SpecializationPasses::register_inherent_owner(
                            ctx.decl_index.type_of_decl(node.def, "specialization/inherent owner"), decl, registry);
                    }
                }
                DeclKind::Trait(node) => {
                    if (node.is_generic()) {
                        SpecializationPasses::register_generic_template(node.name, node.generic_params,
                            decl, TemplateKind::Trait, node.def, registry, arena, ctx);
                    }
                }
                DeclKind::Enum(node) => {
                    if (node.is_generic()) {
                        SpecializationPasses::register_generic_template(node.name, node.generic_params,
                            decl, TemplateKind::Enum, node.def, registry, arena, ctx);
                    }
                }
                DeclKind::TypeAlias(node) => {
                    if (node.is_generic()) {
                        SpecializationPasses::register_generic_template(node.alias_name, node.generic_params,
                            decl, TemplateKind::TypeAlias, node.def, registry, arena, ctx);
                    }
                }
                DeclKind::Union(node) => {
                    // Mirrors the struct arm: a union is a StructType-backed
                    // owner, so generic unions register as templates and
                    // non-generic ones expose static/instance method templates.
                    if (node.is_generic()) {
                        SpecializationPasses::register_generic_template(node.name, node.generic_params,
                            decl, TemplateKind::Union, node.def, registry, arena, ctx);
                    }
                    if (!node.is_generic()) {
                        SpecializationPasses::register_static_method_templates(node.methods,
                            registry, arena, ctx);
                        SpecializationPasses::register_inherent_owner(
                            ctx.decl_index.type_of_decl(node.def, "specialization/inherent owner"), decl, registry);
                    }
                }
                DeclKind::Impl(_) => {
                    SpecializationPasses::register_impl_block(decl, registry, ctx);
                }
                // No other kind with a payload can be generic.
                DeclKind::Import(_) | DeclKind::Intrinsic(_)
                | DeclKind::Module(_) | DeclKind::Variant(_) | DeclKind::Destructure(_)
                | DeclKind::Extern(_) | DeclKind::Field(_) | DeclKind::GenericParam(_)
                | DeclKind::Variable(_) | DeclKind::Method(_) => {}
            }
        }

        if (Log::enabled(LogArea::Mono, LogLevel::Debug)) {
            Log::debug(LogArea::Mono, f"registered {registry.template_count()} templates");
        }

        // The module declaring `Array` makes `[T]` a type from here on.
        ctx.type_resolver.note_dynamic_array_shape();

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }


    // Pass 2: Monomorphization

    /// Creates a Monomorphizer and processes all pending generic instantiations.
    static run_monomorphization(ctx: mut CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        // Get required components
        const arena: mut TypeArena* = ctx.type_arena;
        if (arena == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                           "Monomorphization: no TypeArena");
            return PassResult::failure(1);
        }

        const generic_reg: mut GenericRegistry* = ctx.generic_registry;
        if (generic_reg == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                           "Monomorphization: generic registry not initialized");
            return PassResult::failure(1);
        }

        // Reuse existing monomorphizer across modules (batch compilation),
        // or create one on first use.
        mut mono_ptr: mut Monomorphizer* = ctx.monomorphizer;
        const module_sym: SymbolStr = ctx.intern(ctx.source_file);
        if (mono_ptr != null) {
            // Subsequent module: clear transient state, keep specialization cache
            mono_ptr.reset_for_next_module();
            mono_ptr.set_current_source_file(module_sym);
        } else {
            // First module: allocate and store on context
            const _box_mono: Box<Monomorphizer> = Box::<Monomorphizer>::new(
                Monomorphizer::new(arena, generic_reg, ctx.intern_table, ctx.diagnostics,
                                   ctx.type_resolver, ctx.decl_index,
                                   SemaVisitor::synthesized_binder(ctx)));
            mono_ptr = _box_mono.into_raw();
            // The orchestrator does NOT auto-wire its collaborators; their
            // back-pointers must be set AFTER the leak puts it at a stable heap
            // address.
            mono_ptr.wire();
            mono_ptr.set_current_source_file(module_sym);
            ctx.monomorphizer = mono_ptr;
        }

        mut success: boolean = mono_ptr.process_all();

        // Walk this module's non-generic free functions and inline
        // struct method bodies to specialize every generic call sema
        // pinned a binding stash onto (free calls, instance/static generic
        // methods, e.g. `Request::parse(stream)` inside `handle_connection`).
        // This CONSUMES sema's `CallExpr.resolved_type_args`; it never
        // re-derives bindings.  (Owner-generic `![implicit]` static converters
        // like `String<GlobalAllocator>::from_string` are synthesized by sema
        // with `scope_generic_args` pre-mono, so the normal stash path covers
        // them.)
        //
        // WALK/DRAIN FIXPOINT: re-walking is idempotent (each call is guarded
        // by its `resolved_callee`), so iterate
        // walk + drain until no new specialization entries appear.  This is
        // what resolves adapter-chain receivers (`r.map(f).fold()`):
        // the first pass types+specializes `.map(f)`, the next pass sees the
        // now-resolved receiver of `.fold()`, and so on to a fixpoint.
        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root != null) {
            loop {
                const before_specs: i64 = mono_ptr.spec_count();
                const before_methods: i64 = mono_ptr.method_instance_count();
                mono_ptr.specialize_calls_in_module(root);
                // Drain the pending worklist for any new instantiations queued
                // by the walk.  We deliberately don't re-enter `process_all`
                // here because its `collect_unmonomorphized` pre-pass would
                // re-feed already-filtered partial specs (those containing
                // GenericParam at depth) and re-run post-pass marking.
                const post_success: boolean = mono_ptr.drain_pending_worklist();
                if (success) { success = post_success; }
                // Fixpoint on BOTH progress metrics.  A pass whose only progress
                // is a method instance (pinning a static generic-owner call
                // whose owner instantiation drained on the previous pass, or an
                // adapter-chain receiver's default) grows
                // `method_instance_count` but may leave `spec_count` unchanged;
                // breaking on `spec_count` alone stops before the call that
                // instance unblocks gets re-walked.  Both metrics are
                // monotonic and bounded - each instance is made exactly once,
                // behind the `method_instance` guard - so this terminates.
                if (mono_ptr.spec_count() == before_specs
                        && mono_ptr.method_instance_count() == before_methods) {
                    break;
                }
            }
        }

        if (Log::enabled(LogArea::Mono, LogLevel::Debug)) {
            Log::debug(LogArea::Mono, f"{mono_ptr.specialization_count()} specializations");
        }

        if (!success) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                           "Monomorphization failed");
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }


    // Pass 3: Generic Expression Resolution
    //
    // This pass REGISTERS each new specialization into the DeclarationIndex
    // (under the demanding module) so that monomorphization
    // discovery for later modules in the same Phase 6a-ii loop can resolve
    // calls against already-created specs.  It deliberately does NOT place the
    // spec's AST into a ProgramNode root - physical placement is deferred to
    // Phase 6a-iii (`route_specializations_to_owners`), which injects each spec
    // into its DETERMINISTIC owner module (`owner_module_for_spec`),
    // independent of demand order.  Splitting registration (here, per demander)
    // from placement (there, per owner) keeps discovery unchanged while
    // making a spec's object-file home a function of its template.
    static run_generic_expression_resolution(ctx: mut CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        mut mono: mut Monomorphizer* = ctx.monomorphizer;
        if (mono == null) {
            // No monomorphizer means no generics were used; that's OK.
            return PassResult::ok();
        }

        const module_sym: SymbolStr = ctx.intern(ctx.source_file);
        mono.set_current_source_file(module_sym);

        // A call bound to a method of an instantiation is bound once the
        // instantiation's methods are registered.  Binding one to a generic
        // method instantiates the method, whose body can mint instantiations
        // of its own with calls of their own queued, so register, bind and
        // drain until a round makes nothing new.
        loop {
            const reg_start: i64 = mono.get_injection_cursor();
            const reg_end: i64 = mono.spec_count();
            for (mut i: i64 = reg_start; i < reg_end; i++) {
                const entry: mut SpecializationEntry* = mono.spec_entry_at(i);
                SpecializationPasses::register_spec(ctx, mono, entry);
            }
            mono.advance_injection_cursor();
            const before_methods: i64 = mono.method_instance_count();
            mono.bind_queued_calls();
            if (!mono.drain_pending_worklist()) { break; }
            if (mono.spec_count() == reg_end && mono.method_instance_count() == before_methods) { break; }
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }

    /// The module a specialization is emitted in.  The candidates are the
    /// template's module and the module declaring each named type the type
    /// arguments are built from (`InstanceOwner::consider_type`), in that
    /// order, with the template's module last.  The owner is the first of
    /// them that no other candidate depends on.  When one candidate depends
    /// on all the others it is the only such module, and its object
    /// references nothing its module does not already import: an instance
    /// of a program's template, or over a program's type, is emitted in the
    /// program's module, never in a standard-library module one of its type
    /// arguments merely names (the allocator a `String` carries).  When no
    /// candidate depends on all the others, a type argument's module is
    /// taken before the template's: `Result<TlsStream, IoError>` and
    /// `block_on` of a TLS handshake are emitted in `net::tls::stream`,
    /// which keeps `core::result`'s and `std::future`'s objects - and so
    /// the link line of anything returning a `Result` or awaiting a future
    /// - free of the TLS library.  The answer is a function of the template
    /// and its arguments, never of which module asked for the instance: the
    /// monomorphizer materializes its whole worklist while `ctx` is loaded
    /// to the first module, so the asking module is not known here.
    ///
    /// An instance of a method with type parameters of its own is placed by
    /// the same rule, its own type arguments considered first, then its
    /// receiver as a type argument, then the module declaring the method.
    ///
    /// An implementation block an instantiation carries that was written
    /// in another module than the template's is placed by the same rule
    /// with the module it was written in (`written_in`, none for the
    /// instantiation itself) a candidate just ahead of the template's: a
    /// program's implementation of its own trait for a standard-library
    /// instantiation is emitted in the program, which depends on the
    /// instantiation's module, and one module's implementation of its
    /// trait for an instantiation of a template it imports is emitted
    /// beside the trait, keeping the template's object free of it.
    ///
    /// Invalid when no candidate is a module of the build.
    static owner_module_for_spec(ctx: CompilationContext*, entry: SpecializationEntry*,
                                 written_in: ModulePath) -> ModulePath {
        mut owner: InstanceOwner = InstanceOwner::new();
        if (ctx.module_graph == null) { return ModulePath::none(); }
        for (mut i: i64 = 0; i < entry.method_arguments.length(); i++) {
            owner.consider_type(ctx, entry.method_arguments[i], 0);
        }
        if (entry.is_method_instance()) {
            owner.consider_type(ctx, entry.specialized_type, 0);
        }
        if (entry.instantiated_type.is_valid()) {
            const arena: TypeArena* = ctx.type_arena;
            // `inst_*` answers for a pre-mono wrapper AND a post-mono concrete
            // alike (single-id identity puts the concrete at the wrapper's id,
            // carrying its own base + args).  A bare `kind == InstantiatedType`
            // test here would be false for every monomorphized spec.
            const n_args: i64 = arena.inst_type_arg_count(entry.instantiated_type);
            for (mut i: i64 = 0; i < n_args; i++) {
                owner.consider_type(ctx, arena.inst_type_arg_at(entry.instantiated_type, i), 0);
            }
        }
        owner.consider(ctx.module_graph, written_in);
        owner.consider(ctx.module_graph, entry.template_module);
        return owner.chosen(ctx.module_graph);
    }


    /// The source file of the module the block `impl_nodes[block]` of
    /// `entry` is emitted in: the entry's own when the entry is no
    /// instantiation (a method instance, or a blanket or object
    /// implementation, whose one block the entry was made to place) or the
    /// block was written in the template's module, else the owner of the
    /// block written in its module (`owner_module_for_spec`).
    static block_owner_source(ctx: CompilationContext*, entry: SpecializationEntry*,
                              block: i64) -> SymbolStr {
        if (entry.ast_node == null) { return entry.owner_source; }
        const written_in: ModulePath = ctx.module_of_file(entry.impl_nodes[block].source_file);
        if (!written_in.is_valid() || written_in.equals(entry.template_module)) { return entry.owner_source; }
        const owner: ModulePath = SpecializationPasses::owner_module_for_spec(ctx, entry, written_in);
        // Candidates that all depend on one another choose none, as for the
        // instantiation itself; the block then stays with the instantiation.
        if (!owner.is_valid()) { return entry.owner_source; }
        return ctx.module_graph.source_file_of(owner, ctx.intern_table);
    }

    /// Register a single specialization into the DeclarationIndex, scope-tag its
    /// AST nodes, and re-register its impl methods.  Runs under the DEMANDING
    /// module's `ctx` so discovery and DI state stay consistent.  Does NOT place
    /// the AST into any root - that is Phase 6a-iii's job.
    static register_spec(ctx: mut CompilationContext*, mono: Monomorphizer*,
                         entry: mut SpecializationEntry*) -> void {
        const arena: TypeArena* = ctx.type_arena;
        const module_sym: SymbolStr = ctx.intern(ctx.source_file);

        // A method instance's template is the method, whose module is the
        // one its file declares; only the module graph knows which that is.
        if (entry.is_method_instance()) {
            entry.template_module = ctx.module_of_file(entry.impl_nodes[0].source_file);
        }

        // Resolve this spec's OWNER module (`owner_module_for_spec`).  Both DI
        // ownership (here) and AST placement key off `owner_source`, so they
        // always agree: the module DI names as owner is the one whose root
        // holds the definition, and every other module declares the symbol
        // extern.
        //
        // Keying on the template's module alone would make `core::result`
        // define every `Result<T,E>` spec of the stdlib, so `result.o` would
        // reference `TlsStream::drop`, `Value::drop`, `Child::drop`, ...
        // A static archive is pulled one whole member at a time, so linking a
        // hello-world against a prebuilt stdlib would drag in `net::tls` -
        // and therefore `SSL_*` - merely because the allocator returns a
        // `Result`.
        //
        // A program and the stdlib archive it links may each emit one spec.
        // That is sound because a monomorph is a pure function of (template,
        // type-args): both clone the same template source into the same symbol.
        // `FunctionDecl::is_specialization` makes codegen give the definition
        // `linkonce_odr` linkage, so the linker keeps one and discards the rest.
        //
        // Placement does not affect symbol names, which is what makes relocation
        // safe at all:
        //   * TYPE specs (struct/enum) are named by the type's arena
        //     qualified name, which is LOCATION-INDEPENDENT.
        //   * FUNCTION / static-method-generic specs have no arena type; their
        //     key is the spec identifier under the module of the file that
        //     wrote the template (`decl_fn_key` over the clone's span), which
        //     the DI registration and codegen's definition both derive, so
        //     relocating the definition never diverges the names.
        //
        // A spec none of whose candidates is a module of the build stays with
        // the module registering it.
        const owner_module: ModulePath =
            SpecializationPasses::owner_module_for_spec(ctx, entry, ModulePath::none());
        entry.owner_source = if (owner_module.is_valid()) {
            ctx.module_graph.source_file_of(owner_module, ctx.intern_table)
        } else {
            module_sym
        };
        entry.block_placements = [];
        for (mut j: i64 = 0; j < entry.impl_nodes.length(); j++) {
            entry.block_placements.push(BlockPlacement {
                owner_source: SpecializationPasses::block_owner_source(ctx, entry, j),
                injected:     false,
            });
        }

        // Scope-tag the main AST with its template module origin in the
        // CompilationContext's node-identity side table.  A FUNCTION spec's
        // key needs no stamp on the node: the clone carries the template's
        // span, and a declaration's key is its name under the module of the
        // file that wrote it (`decl_fn_key`), so the definition and every
        // caller's reference qualify by the template module wherever the
        // clone is placed.  The side table only ever holds injected specs,
        // which is what `dispatch_top_level` needs.  Physical placement into
        // the owner module's root happens later in Phase 6a-iii.
        if (entry.ast_node != null) {
            if (entry.template_module.is_valid()) {
                ctx.register_injected_origin(
                    entry.ast_node, entry.template_module);
            }
        }
        // Scope-tag impl blocks
        for (mut j: i64 = 0; j < entry.impl_nodes.length(); j++) {
            if (entry.template_module.is_valid()) {
                ctx.register_injected_origin(
                    entry.impl_nodes[j], entry.template_module);
            }
        }

        // A named specialization is in the index since its placement; a
        // function clone registers as a declaration here.
        if (entry.ast_node != null) {
            SpecInjector::register(entry.ast_node, entry.specialized_type, ctx);
        }
        // Register the InstantiatedType's TypeRef in type_reverse so
        // that codegen can look up the concrete type's qualified name
        // directly from the expression's resolved_type (which may be
        // the InstantiatedType, not the concrete struct).
        if (entry.instantiated_type.is_valid() && entry.specialized_type.is_valid()) {
            if (arena.get_qualified_name(entry.specialized_type).is_valid()) {
                ctx.decl_index.register_type_reverse_only(
                    ctx.decl_index.registered_def(entry.specialized_type), entry.instantiated_type);
            }
        }
        // A method instance's block was made for its receiver, and its one
        // method registered under the receiver, when the instance was made.
        if (entry.is_method_instance()) { return; }
        // Each cloned impl block is rewritten to target the specialization
        // by its qualified name and recorded as a head under the
        // specialization's type; its methods were registered under the type
        // when the entry was placed.
        // The implementation the compiler makes for an object is named by the
        // definition minted for it, and is no head of the object's: a call of
        // one of its methods is pinned to it, and every other call on the
        // object goes through the object's table.
        const specialized: Type* = arena.lookup(entry.specialized_type);
        if (specialized != null && specialized.kind == TypeKind::Object) {
            for (mut j: i64 = 0; j < entry.impl_nodes.length(); j++) {
                DeclarationNode::impl_of(entry.impl_nodes[j]).target_type =
                    ctx.decl_index.lookup_type_name(entry.specialized_type);
            }
            return;
        }
        const impl_qname: SymbolStr = if (entry.specialized_type.is_valid()) {
            arena.get_qualified_name(entry.specialized_type).spelling()
        } else {
            SymbolStr::empty()
        };
        for (mut j: i64 = 0; j < entry.impl_nodes.length(); j++) {
            const impl_node: mut ImplBlock* = DeclarationNode::impl_of(entry.impl_nodes[j]);
            // Bounds-violating impls were dropped pre-clone by
            // `Monomorphizer::filter_bounds_violating_impls`; any
            // impl reaching here is fully applicable to this spec.
            if (impl_qname.is_valid() && impl_node != null) {
                impl_node.target_type = impl_qname;
                impl_node.spec_owner = entry.specialized_type;
                // The clone under the SPECIALIZATION: a subject that is a type
                // of its own selects among the clones placed under it.
                if (impl_node.is_trait_impl()) {
                    ctx.generic_registry.register_trait_impl(
                        impl_node.trait_def, entry.specialized_type,
                        entry.impl_nodes[j]);
                }
            } else {
                SpecInjector::register_injected_decl(entry.impl_nodes[j], ctx);
            }
        }
    }

    /// Phase 6a-iii: place specializations OWNED by the currently-loaded module
    /// into its AST root.  `ctx` must already be loaded to a candidate owner
    /// module.  DeclarationIndex registration already happened in `register_spec`
    /// (Phase 6a-ii); this pass only performs the physical `add_statement`, which
    /// determines which object file emits the spec's definition.
    ///
    /// Placement keys off `entry.owner_source` - the resolved owner module's
    /// source-file path that `register_spec` ALSO used for DI ownership - so AST
    /// placement and DI ownership always agree.  The owner is chosen by
    /// `owner_module_for_spec`.  Placement is sound for type specs (named by
    /// location-independent arena qname) AND function / method-generic specs
    /// (named under the template's module whatever object holds them).  Each
    /// spec is placed exactly once, guarded by `entry.injected`.
    /// Tag every function/method carried by a placed specialization so codegen
    /// can give it `linkonce_odr` linkage.  This is the one funnel through
    /// which a monomorph's AST reaches an owner module, so tagging here is
    /// exhaustive for anything that gets a definition emitted.  See
    /// `FunctionDecl::is_specialization` for why the linkage is sound.
    static mark_specialized(node: DeclarationNode*) -> void {
        if (node == null) { return; }
        if (DeclarationNode::fn_of(node) != null) {
            DeclarationNode::fn_of(node).is_specialization = true;
            return;
        }
        if (DeclarationNode::struct_of(node) != null) {
            SpecializationPasses::mark_methods((DeclarationNode::struct_of(node)).methods);
        } else if (DeclarationNode::union_of(node) != null) {
            SpecializationPasses::mark_methods((DeclarationNode::union_of(node)).methods);
        } else if (DeclarationNode::impl_of(node) != null) {
            SpecializationPasses::mark_methods((DeclarationNode::impl_of(node)).methods);
        }
    }

    static mark_methods(methods: &[DeclarationNode*]) -> void {
        for (mut i: i64 = 0; i < methods.length(); i++) {
            const m_decl: DeclarationNode* = methods[i];
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m != null && m.func != null) { DeclarationNode::fn_of(m.func).is_specialization = true; }
        }
    }

    /// How the placement trace names `entry`'s instance: its instantiation,
    /// or for a method instance its receiver, method and type arguments
    /// (`Array<i64>::sort_by_key<i64, ...>`).
    static instance_shown(ctx: CompilationContext*, entry: SpecializationEntry*) -> string {
        const arena: TypeArena* = ctx.type_arena;
        if (!entry.is_method_instance()) {
            const shown: TypeRef = if (entry.instantiated_type.is_valid()) {
                entry.instantiated_type
            } else {
                entry.specialized_type
            };
            return arena.resolve_display_name(shown);
        }
        const method: MethodDecl* = DeclarationNode::method_of(DeclarationNode::impl_of(entry.impl_nodes[0]).methods[0]);
        mut shown: String = f"{arena.resolve_display_name(entry.specialized_type)}::{ctx.intern_table.resolve(DeclarationNode::fn_of(method.func).name)}<";
        for (mut i: i64 = 0; i < entry.method_arguments.length(); i++) {
            if (i > 0) { shown.append(", "); }
            shown.append(arena.resolve_display_name(entry.method_arguments[i]));
        }
        shown.append(">");
        return shown.into_raw();
    }

    /// How the placement trace names block `block` of `entry`: its trait
    /// and the instantiation (`Shapes::Measure for Slice<i32>`), or the
    /// instantiation alone for a block that implements no trait.
    static block_shown(ctx: CompilationContext*, entry: SpecializationEntry*, block: i64) -> string {
        const shown: string = SpecializationPasses::instance_shown(ctx, entry);
        const implementation: ImplBlock* = DeclarationNode::impl_of(entry.impl_nodes[block]);
        if (!implementation.is_trait_impl()) { return shown; }
        return f"{ctx.intern_table.shown(ctx.defs.path_of(implementation.trait_def))} for {shown}".into_raw();
    }

    static route_specializations_to_owners(ctx: mut CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        mut mono: mut Monomorphizer* = ctx.monomorphizer;
        if (mono == null) { return PassResult::ok(); }

        const root: mut ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) { return PassResult::ok(); }

        const my_src: SymbolStr = ctx.intern(ctx.source_file);

        const total: i64 = mono.spec_count();
        mut place_count: i64 = 0;
        for (mut i: i64 = 0; i < total; i++) {
            mut entry: mut SpecializationEntry* = mono.spec_entry_at(i);
            if (!entry.injected && entry.owner_source.is_valid() && entry.owner_source.equals(my_src)) {
                entry.injected = true;
                if (Log::enabled(LogArea::Mono, LogLevel::Trace)) {
                    Log::trace(LogArea::Mono, f"instance {SpecializationPasses::instance_shown(ctx, entry)} placed in {ctx.intern_table.shown(ctx.unit_module.decl_name())}");
                }
                if (entry.ast_node != null) {
                    SpecializationPasses::mark_specialized(entry.ast_node);
                    root.add_statement(Node::Decl(entry.ast_node));
                }
                place_count += 1;
            }
            for (mut j: i64 = 0; j < entry.impl_nodes.length(); j++) {
                const placement: mut BlockPlacement* = &entry.block_placements[j];
                if (placement.injected || !placement.owner_source.equals(my_src)) { continue; }
                placement.injected = true;
                if (!placement.owner_source.equals(entry.owner_source) && Log::enabled(LogArea::Mono, LogLevel::Trace)) {
                    Log::trace(LogArea::Mono, f"implementation {SpecializationPasses::block_shown(ctx, entry, j)} placed in {ctx.intern_table.shown(ctx.unit_module.decl_name())}");
                }
                SpecializationPasses::mark_specialized(entry.impl_nodes[j]);
                root.add_statement(Node::Decl(entry.impl_nodes[j]));
            }
        }

        if (Log::enabled(LogArea::Mono, LogLevel::Debug)) {
            Log::debug(LogArea::Mono, f"placed {place_count} specializations into {ctx.source_file}");
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }


    // Pass 4: Generic Validation

    /// Walks all types in the arena and asserts that every InstantiatedType
    /// has a valid resolved_type.
    static run_generic_validation(ctx: mut CompilationContext*) -> PassResult {
        return SpecializationPasses::run_generic_validation_impl(ctx);
    }

    /// Unified template registration for any generic declaration.
    /// Extracts generic parameter metadata and registers a TemplateEntry
    /// under the declaration's key.
    ///
    /// `name` and `generic_params` are the common fields every generic
    /// declaration shares.  `ast_node` is the original declaration.  `kind`
    /// is which declaration it is.
    /// `def` is the id the declaration was stamped with - by the
    /// type-declaration stage for a type, by the name layer for a function -
    /// and its canonical name is the registry's key.  A type's base type is
    /// the index's answer for it; a function's is a placeholder.  An
    /// unstamped declaration is a missed stamp, recorded, and registers
    /// nothing: no second key is derived for it from the name and the file.
    static register_generic_template(name: SymbolStr, generic_params: &[DeclarationNode*],
                                       ast_node: DeclarationNode*, kind: TemplateKind,
                                       def: DefId,
                                       registry: mut GenericRegistry*, arena: mut TypeArena*,
                                       ctx: CompilationContext*) -> void {
        if (generic_params.length() == 0) { return; }

        if (!def.is_valid()) {
            compiler::resolver::res::record_pending_bug("register_generic_template: unstamped declaration");
            return;
        }
        const qualified_sym: SymbolStr = ctx.defs.path_of(def).spelling();
        if (Log::enabled(LogArea::Mono, LogLevel::Trace)) {
            Log::trace(LogArea::Mono, f"template {ctx.resolve_str(name)}");
        }

        // Use the shared utility for arena TypeRef creation (single source of truth)
        const refs: [TypeRef] = TypeResolutionPasses::create_generic_param_types(
            generic_params, arena);
        mut param_names: [SymbolStr] = [];
        mut param_syms: [SymbolID] = [];
        mut param_types: [TypeRef] = [];
        for (mut i: i64 = 0; i < generic_params.length(); i++) {
            const gp_decl: DeclarationNode* = generic_params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            param_names.push(gp.name);
            param_syms.push(gp.sym_id);
            param_types.push(refs[i]);
        }

        mut base_type: TypeRef = TypeRef::invalid();
        if (kind == TemplateKind::Function) {
            // Generic functions have no arena type, but they need a TypeID so
            // the GenericRegistry can track instantiations (e.g., identity<int>).
            // Use a FunctionTemplate placeholder instead of a fake StructType.
            base_type = arena.create_function_template(qualified_sym);
        } else {
            base_type = ctx.decl_index.type_of_def(def);
        }

        // The module whose scope the template's body resolves in: the unit
        // writing it.
        const entry: TemplateEntry = TemplateEntry::new(
            name, qualified_sym, def, ctx.current_module(),
            param_names, param_syms, param_types,
            ast_node, kind,
            base_type
        );
        registry.register_template(entry);
    }

    /// Register every generic STATIC method on `methods` as a function-style
    /// template. Static generic methods on non-generic types (e.g.
    /// `Layout::array<T>`) are otherwise invisible to the monomorphizer because
    /// `run_template_registration` only walks top-level declarations. Without
    /// registration the inference path in `try_infer_function_call` can't find
    /// them, and ScopeResolution callees like `Layout::array<int>(n)` link to a
    /// never-emitted bare-template symbol.
    ///
    /// Generic NON-static methods are intentionally skipped; those go through
    /// `try_infer_method_call` / `specialize_method`, which dispatches by
    /// receiver type rather than scope-qualified name.
    ///
    /// Each is registered under its own definition's path (`<owner>::<method>`),
    /// which keeps apart two types' static methods of one bare name: the
    /// method's definition has the owner it is declared on as its parent,
    /// whichever file the methods were written in.
    static register_static_method_templates(methods: &[DeclarationNode*],
                                              registry: mut GenericRegistry*,
                                              arena: mut TypeArena*,
                                              ctx: CompilationContext*) -> void {
        if (methods.length() == 0) { return; }

        // The module the methods are written in, whose scope their bodies
        // resolve in - an impl's, which need not be the owner type's.
        const written_in: ModulePath = ctx.current_module();

        for (mut i: i64 = 0; i < methods.length(); i++) {
            const m_decl: DeclarationNode* = methods[i];
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m == null || m.func == null) { continue; }
            if (!m.is_static) { continue; }
            if (!DeclarationNode::fn_of(m.func).is_generic()) { continue; }

            const qualified_sym: SymbolStr = ctx.defs.path_of(DeclarationNode::fn_of(m.func).def).spelling();

            const refs: [TypeRef] = TypeResolutionPasses::create_generic_param_types(
                DeclarationNode::fn_of(m.func).generic_params, arena);
            mut param_names: [SymbolStr] = [];
            mut param_syms: [SymbolID] = [];
            mut param_types: [TypeRef] = [];
            for (mut j: i64 = 0; j < DeclarationNode::fn_of(m.func).generic_params.length(); j++) {
                const gp_decl: DeclarationNode* = DeclarationNode::fn_of(m.func).generic_params[j];
                const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
                param_names.push(gp.name);
                param_syms.push(gp.sym_id);
                param_types.push(refs[j]);
            }

            const base_type: TypeRef = arena.create_function_template(qualified_sym);

            const entry: TemplateEntry = TemplateEntry::new(
                DeclarationNode::fn_of(m.func).name, qualified_sym, DeclarationNode::fn_of(m.func).def, written_in,
                param_names, param_syms, param_types,
                m.func, TemplateKind::Function,
                base_type
            );
            registry.register_template(entry);
        }
    }

    /// Register a non-generic struct AST as an "inherent owner",
    /// keyed by both qualified and bare name.  The monomorphizer / sema walk
    /// the owner's `methods[]` to specialize generic INSTANCE methods (e.g.
    /// `Response::write_to<W>`).  Generic STATIC methods take a separate path
    /// via `register_static_method_templates`, which keys them by
    /// `Owner::method` for ScopeResolution callees.
    ///
    /// Registration is unconditional for non-generic owners so the index is
    /// a complete `qualified_name -> AST` map for them; receiver-type lookups
    /// do not have to thread a fallback through DeclarationIndex.  Generic
    /// owners go through `register_generic_template` instead; their methods
    /// are specialized as part of struct monomorphization rather than
    /// per-call.
    static register_inherent_owner(
            owner: TypeRef, owner_ast: DeclarationNode*,
            registry: mut GenericRegistry*) -> void {
        if (owner_ast == null) { return; }
        // Under the declaration's own type and nothing else: two modules'
        // same-leaf declarations are two types, so a reader holding a
        // receiver is never handed some other module's declaration.
        registry.register_inherent_owner(owner, owner_ast);
    }

    static register_impl_block(decl: DeclarationNode*, registry: mut GenericRegistry*,
                                 ctx: CompilationContext*) -> void {
        const node: ImplBlock* = DeclarationNode::impl_of(decl);
        // The key a template is registered under is the target's canonical
        // name, which is the head's stamp.  Qualifying the spelling by the
        // module the impl was WRITTEN in names the template only when that
        // module declares the type; every trait implemented for another
        // module's type (`Display for Option<T>` in `fmt::display`) keyed a
        // name no template carries and was attached to none.
        if (registry.template_of(node.target_def()) != null) {
            registry.register_impl_block(node.target_def(), decl);
        } else if (!node.is_trait_impl()) {
            // Non-generic target: there is no TemplateEntry to hang the block
            // on, so an inherent `implement T { ... }` block would otherwise be
            // invisible to ownership classification.  Recorded under the
            // type the head names - a declared type's, a primitive's - which
            // is what every reader holds as a receiver.
            registry.register_inherent_impl_block(
                ctx.decl_index.impl_owner(node, ctx.type_arena, "specialization/inherent impl"), decl);
            // A generic static method on a non-generic target needs its own
            // template entry, exactly as when it is written inside the type's
            // body (see the struct arm of `run_template_registration`).
            // Without one, `Layout::array<T>(n)` finds no template, the
            // monomorphizer never specializes the call, and codegen emits a
            // reference to the bare template symbol that nothing defines.
            // `implement Layout { static array<T> }` is legal source.
            // (Only the STATIC templates: instance-method dispatch on an impl
            // block already goes through `register_inherent_impl_block` above.)
            const arena: mut TypeArena* = ctx.type_arena;
            if (arena != null) {
                SpecializationPasses::register_static_method_templates(
                    node.methods, registry, arena, ctx);
            }
        }

        // A trait impl goes into the trait-impl registry under the trait's
        // identity and the target's type, both off the name layer's stamps.
        // Coherence is not checked here: the single check lives in
        // TypeResolution, once `canonical_target` is stamped, and covers
        // same-file and cross-module duplicates uniformly.
        if (node.is_trait_impl()) {
            registry.register_trait_impl(
                TypeAnnotation::trait_def(node.trait_annotation),
                ctx.decl_index.impl_owner(node, ctx.type_arena, "specialization/trait impl"), decl);
            // A head for every type or for the references (`for T`, `for &T`)
            // is filed under its trait alone, here with the others: whether a
            // type has a trait is asked while signatures are resolved (a
            // trait default bounded on an associated type is copied into an
            // implementation only when its binding has the bound), and a
            // reference has the traits only such a head gives it.
            if (node.target_param().is_valid()) {
                registry.register_blanket_impl(TypeAnnotation::trait_def(node.trait_annotation), decl);
            }
        }
    }

    static run_generic_validation_impl(ctx: mut CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        const arena: TypeArena* = ctx.type_arena;
        if (arena == null) {
            return PassResult::ok();
        }

        const count: i64 = arena.type_count();

        mut unresolved_count: i64 = 0;

        for (mut i: i64 = 0; i < count; i++) {
            const ty: Type* = arena.types[i];
            if (ty == null) { continue; }

            if (ty.kind != TypeKind::InstantiatedType) { continue; }

            const inst: InstantiatedType* = ty.as_instantiated();
            if (inst.resolved_type.is_valid()) { continue; }

            // Instantiations minted only by the additive symbolic generic-body walk
            // are never monomorphized or codegen'd (they may be concrete types that
            // live solely inside a never-instantiated template). They are not real
            // unresolved instantiations - skip, exactly like the generic-arg ones below.
            if (inst.is_symbolic) { continue; }

            // Skip template-internal references whose type args contain generic
            // parameters at any depth (e.g., Pair<T>, Option<Result<T, E>>).
            // These are created when a generic declaration references another
            // generic with its own params and are never meant to be monomorphized
            // until the *outer* template is specialized.  Nested cases like
            // Option<Result<T,E>>, where the direct arg is an InstantiatedType
            // rather than a GenericParam, need the recursive filter in
            // `TypeArena::contains_generic_param`, which is the single authority
            // every consumer (mono, sema, this validator) shares.
            mut has_generic_arg: boolean = false;
            for (mut j: i64 = 0; j < inst.type_args.length(); j++) {
                if (arena.contains_generic_param(inst.type_args[j])) {
                    has_generic_arg = true;
                }
            }
            if (has_generic_arg) { continue; }

            // This InstantiatedType was never monomorphized.
            unresolved_count += 1;

            const base_id: u64 = inst.generic_base.key();
            const n_args: i64 = inst.type_args.length();
            mut base_name: string = "<no-qname>";
            if (arena.get_qualified_name(inst.generic_base).is_valid()) {
                base_name = ctx.intern_table.shown(arena.get_qualified_name(inst.generic_base));
            }
            mut args_disp: string = "";
            for (mut ai: i64 = 0; ai < inst.type_args.length(); ai++) {
                mut an: string = "?";
                if (arena.get_qualified_name(inst.type_args[ai]).is_valid()) {
                    an = ctx.intern_table.shown(arena.get_qualified_name(inst.type_args[ai]));
                }
                if (ai > 0) { args_disp = args_disp + ", "; }
                args_disp = args_disp + an;
            }
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                fmt::format("unresolved generic instantiation after monomorphization: `%s<%s>` (inst_id=%lu, base_id=%lu, n_args=%lld)",
                        base_name, args_disp, ty.id, base_id, n_args));
        }

        if (Log::enabled(LogArea::Mono, LogLevel::Debug)) {
            Log::debug(LogArea::Mono, f"validated {count} types: {unresolved_count} unresolved instantiations");
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }
}

/// The modules a specialization's owner is chosen from, in the order they
/// were considered (`SpecializationPasses::owner_module_for_spec`).
type struct InstanceOwner {
    /// Each candidate once, as a module of the build.
    modules: [ModulePath];
    /// The graph index of each of `modules`.
    indices: [i64];

    static new() -> InstanceOwner {
        return InstanceOwner { modules: [], indices: [] };
    }

    /// Add `m` when it is a module of the build not already a candidate.
    consider(mut &this, graph: ModuleGraph*, m: ModulePath) -> void {
        if (!m.is_valid()) { return; }
        const index: i64 = graph.find_module_index(m);
        if (index < 0) { return; }
        for (mut i: i64 = 0; i < this.indices.length(); i++) {
            if (this.indices[i] == index) { return; }
        }
        this.modules.push(m);
        this.indices.push(index);
    }

    /// The first candidate no other candidate depends on; none when there
    /// is no candidate.
    chosen(&this, graph: ModuleGraph*) -> ModulePath {
        for (mut i: i64 = 0; i < this.indices.length(); i++) {
            mut beneath_another: boolean = false;
            for (mut j: i64 = 0; j < this.indices.length(); j++) {
                if (graph.depends_on(this.indices[j], this.indices[i])) { beneath_another = true; }
            }
            if (!beneath_another) { return this.modules[i]; }
        }
        return ModulePath::none();
    }

    /// Consider the module declaring each named type `tref` is built from.
    /// Pointers, references, arrays, optionals, tuples, function types and
    /// instantiations are walked through, since a type argument is usually
    /// a compound wrapping the type that forced the instance:
    /// `Option<fn(Request) -> Response>`'s sole argument is a function type,
    /// which names no module.  A named type's own module is a candidate; a
    /// monomorph's arguments are candidates before it, since a monomorph is
    /// declared in its TEMPLATE's module (`BufferedStream<TlsStream>` in
    /// `io::buffered`, which every buffered reader links) and its arguments
    /// name the module that forced it.  A named type's fields are not
    /// walked, which keeps the answer stable and makes cycles impossible.
    consider_type(mut &this, ctx: CompilationContext*, tref: TypeRef, depth: i64) -> void {
        if (depth > 8 || !tref.is_valid()) { return; }
        const arena: TypeArena* = ctx.type_arena;
        const t: Type* = arena.lookup(tref);
        if (t == null) { return; }

        match (t.kind) {
            TypeKind::Pointer => {
                this.consider_type(ctx, t.as_pointer().pointee, depth + 1);
                return;
            }
            TypeKind::Reference => {
                this.consider_type(ctx, t.as_reference().referent, depth + 1);
                return;
            }
            TypeKind::Array => {
                this.consider_type(ctx, t.as_array().element, depth + 1);
                return;
            }
            TypeKind::Optional => {
                this.consider_type(ctx, t.as_optional().wrapped, depth + 1);
                return;
            }
            TypeKind::Tuple => {
                const tp: TupleType* = t.as_tuple();
                for (mut i: i64 = 0; i < tp.elements.length(); i++) {
                    this.consider_type(ctx, tp.elements[i], depth + 1);
                }
                return;
            }
            TypeKind::Function => {
                const ft: FunctionType* = t.as_function();
                for (mut i: i64 = 0; i < ft.param_types.length(); i++) {
                    this.consider_type(ctx, ft.param_types[i], depth + 1);
                }
                this.consider_type(ctx, ft.return_type, depth + 1);
                return;
            }
            TypeKind::InstantiatedType => {
                const inst: InstantiatedType* = t.as_instantiated();
                for (mut i: i64 = 0; i < inst.type_args.length(); i++) {
                    this.consider_type(ctx, inst.type_args[i], depth + 1);
                }
                return;
            }
            _ => { }
        }

        if (!arena.get_qualified_name(tref).is_valid()) { return; }
        if (arena.inst_generic_base(tref).is_valid()) {
            const n_args: i64 = arena.inst_type_arg_count(tref);
            for (mut i: i64 = 0; i < n_args; i++) {
                this.consider_type(ctx, arena.inst_type_arg_at(tref, i), depth + 1);
            }
        }
        this.consider(ctx.module_graph, arena.declared_in(t));
    }
}
