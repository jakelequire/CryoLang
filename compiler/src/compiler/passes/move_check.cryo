///! Move Check Pass.
///!
///! Walks function bodies after sema and rejects a non-Copy local that
///! is used after a `let`-RHS or call-arg move. Diagnostics are
///! `fatal_on_failure`, so the pipeline aborts before codegen and an
///! unsound binary is never emitted.
///!
///! Scope: bare-identifier moves at let initializers and at function-call
///! arguments. `if`/`else` and `match` branches ARE merged at their join
///! (`merge_branches`): a binding moved on any branch that can fall through
///! to the join is possibly-moved afterwards and - because Cryo has no
///! partial-move tracking - is conservatively treated as Moved, so a reuse
///! past the join is reported. Branches that diverge (`return`/`break`/
///! `continue`, or all sub-branches diverge) never reach the join, so their
///! moves are dropped - that is what keeps the `if (c) { consume(x); return; }
///! use(x);` guard pattern false-positive-free. `switch` cases ARE merged too
///! (`merge_switch_cases`), with a switch-specific divergence rule
///! (`switch_case_diverges`): a `break` ends a case by jumping to the merge, so
///! a break-terminated case still contributes its moves to the join, while only
///! `return`/`continue` (which leave the switch entirely) drop a case's moves.
///! Every diagnostic is an unambiguous (or, across a branch join, a possible)
///! double-free; within-iteration, across-branch, and loop-carried
///! use-after-move are all hard errors.

namespace Compiler::Passes::MoveCheck;

import Compiler::Diag;
import Compiler::Diag::{ Snapshot, Sink, SourceSpan, Diagnostic };
import Compiler::AST;
import Compiler::AST::{ Node, Expression, Statement, Declaration, Pattern };
import Compiler::Lex;
import Compiler::Passes::PassID;
import Compiler::CompilationContext;
import Compiler::Types;
import Compiler::Types::{ Arena, TypeRef, Type, GenericRegistry, Ownership, TraitChecker };
import Compiler::Resolver::{ SymbolStr, InternTable };
import std::core::option;
import std::collections::hashmap;


type enum MoveState {
    Live;
    Moved;
}


type struct MoveChecker {
    ctx:      CompilationContext*;
    arena:    TypeArena*;
    registry: GenericRegistry*;
    intern:   InternTable*;

    /// Per-binding type info: name.id -> resolved TypeRef. Reset on
    /// enter_function. Identifier-uses on names absent from this map
    /// are skipped; that's how globals, function names and other
    /// non-local references avoid the move pipeline.
    types: HashMap<u32, TypeRef>;

    /// Set of bindings currently in the Moved state, encoded as a
    /// (key, span) parallel-array stack rather than a HashMap so
    /// snapshot/restore is just an array-length checkpoint. Keys not
    /// in this list are Live by default. The full span is retained
    /// (not just the line) so the renderer can underline the move
    /// site in a combined rustc-style multi-span snippet.
    moved_keys:  u32[];
    moved_spans: SourceSpan[];
    /// Bindings that have been `poll`ed, i.e. futures whose storage must now
    /// hold still.  A poll runs the state machine's own body, which may take
    /// the address of one of its fields and keep it in another field across the
    /// suspend; moving the future afterwards leaves that pointer naming the old
    /// storage.  Before the first poll there is nothing to point at, so the
    /// construct-then-hand-over moves (`block_on(f)`, `spawn(f)`,
    /// `Futures::join(a, b)`) stay legal - the rule is "not after a poll", not
    /// "never".
    ///
    /// Deliberately append-only: it is never truncated by `restore_moves` and
    /// never revived.  Accumulating across sibling branches IS the union the
    /// join needs, and the only imprecision that buys is a poll in one branch
    /// being visible to a move in the other - which over-reports on code that
    /// polls and moves the same future in mutually exclusive branches.  That is
    /// the safe direction, and it keeps this out of `merge_branches`, where the
    /// meet-over-paths reasoning is subtle enough already.
    polled_keys:  u32[];
    polled_spans: SourceSpan[];
    /// Parallel to `moved_keys`: whether the move was *storage-
    /// duplicating* (a `let`/`var` initializer, an assignment RHS, or an
    /// aggregate-literal field - all of which bitwise-copy the value into
    /// a new owning binding that is independently dropped) rather than a
    /// plain call argument. Cryo passes non-Copy by-value parameters by
    /// hidden reference (autoref), so a bare identifier in an argument
    /// position is usually a borrow, not a move. Only real moves can
    /// double-free across a loop back-edge, so loop-carried detection
    /// keys on this flag - that is what keeps autoref'd arguments (e.g.
    /// `topo_contains(order, i)`) from being flagged.
    moved_real:  boolean[];

    /// Loop-carried-move detection state.  A loop body is walked twice:
    /// a silent discovery pass (`suppress_emit`) that records, via
    /// `capture_decls` + `captured_decl_keys`, which bindings are
    /// declared inside the body so they can be excluded (a body-local is
    /// fresh each iteration), and a real pass with the surviving outer
    /// bindings staged in `carried_keys` so a re-move at the top of the
    /// loop is reported as a use-after-move on the next iteration.
    suppress_emit:      boolean;
    capture_decls:      boolean;
    captured_decl_keys: u32[];
    carried_keys:       u32[];

    /// Names bound by an enum/match pattern in an enclosing arm (e.g. `pair`
    /// in `Some(pair) => ...`).  These are by-value payload bindings the
    /// pattern MOVED out of the (drop-glued) subject, so - exactly like a
    /// `let` local - moving a non-Copy FIELD out of one leaves the source's
    /// scope-exit glue to drop that field a second time.  They are NOT put in
    /// the `types` map (that would fold them into whole-binding move tracking
    /// and change behaviour broadly); this narrow set only teaches
    /// `is_owned_value_place` to recognise them so `check_field_move_out`
    /// fires.  Pushed around each arm body's walk, truncated after the join.
    pat_binding_keys: u32[];

    /// Partial-move set: parallel arrays recording a non-Copy *droppable*
    /// FIELD moved out of a non-`Drop` owned local (the Rust partial-move
    /// model, "allow + track" half).  `pm_binding[i]` is the owning binding's
    /// name id, `pm_field[i]` the moved field's name id.  A move is recorded
    /// (and ALLOWED) only when the owner is a straight-line (`branch_depth ==
    /// 0`) bare local of a struct/class with no user `Drop`, so
    /// drop_insertion can skip exactly these fields at the owner's scope exit
    /// - no drop flags needed because an unconditional move is definitely gone
    /// at every scope exit.  Everything else stays a hard E0453.  Mirrors
    /// drop_insertion's `pm_binding`/`pm_field`; the two passes MUST classify
    /// the identical set (a divergence is a double-free or a leak).  Reset in
    /// `enter_function`.
    pm_binding: u32[];
    pm_field:   u32[];

    /// Depth of enclosing `unsafe` blocks.
    ///
    /// `unsafe` does NOT turn the pass off - a use-after-move is a
    /// use-after-move wherever it is written, and the two things this pass
    /// shares with drop_insertion (the move set and the partial-move set) have
    /// to stay in agreement inside an `unsafe` block as much as outside one.
    /// What it marks is narrower: the programmer taking responsibility for
    /// ownership the compiler cannot follow, which in a language without
    /// lifetimes means exactly the ownership reached through a raw pointer.
    /// Only `check_deref_move_out` consults it.
    ///
    /// Before this existed the pass had no `UnsafeBlockStatement` case at all,
    /// so it never descended and `unsafe` silently disabled move checking
    /// wholesale - while drop_insertion, which does walk the block, went on
    /// suppressing drops for moves this pass never saw.  That divergence is
    /// the leak-or-double-free both passes' comments warn about.
    unsafe_depth: i64;

    /// Set while walking an argument whose parameter sema could NOT resolve.
    ///
    /// The move set and the raw-pointer rejection want OPPOSITE defaults for
    /// such a slot, because their costs are opposite.  Guessing "by value" for
    /// the move set over-reports a move, which costs a diagnostic; guessing
    /// "borrow" would silently double-free.  Guessing "by value" for a hard
    /// rejection breaks a build that was correct; guessing "borrow" only leaves
    /// the pre-existing hazard in place.  So the move set treats an
    /// unclassified slot as a transfer and `check_deref_move_out` stands down
    /// on it: the rule fires only where by-value is CERTAIN - a return, a `let`
    /// initializer, an assignment RHS, an aggregate-literal element (all of
    /// which copy unconditionally, no parameter involved), or an argument whose
    /// parameter sema actually resolved.
    ///
    /// The shape that forced this: the async lowering rewrites a `&this`
    /// receiver into `*this$recv`, and the calls it lands in include
    /// `mem::swap<T>(&s, this)` - a qualified generic free call, for which
    /// `resolve_call` produces no parameter types at all, so the slot stays
    /// unclassified even though the parameter is plainly a `T*` borrow.
    arg_binding_unknown: boolean;

    /// Depth of enclosing conditional / loop bodies.  A partial field move is
    /// tracked only at `branch_depth == 0`; inside any `if`/`match`/`switch`/
    /// loop body it stays a hard E0453, because drop-skip without per-field
    /// drop flags is sound only for an *unconditional* move.  Incremented
    /// around `merge_branches` / `merge_switch_cases` / `walk_loop_body`;
    /// mirrored in drop_insertion.
    branch_depth: i64;

    fired: i64;
    /// Count of fatal (loop-carried) use-after-move errors.  Non-zero
    /// fails the pass, which (MoveCheck being fatal_on_failure) aborts
    /// the pipeline before codegen, so the double-freeing binary is
    /// never emitted.
    fatal: i64;

    static new(ctx: CompilationContext*) -> MoveChecker {
        return MoveChecker {
            ctx:      ctx,
            arena:    ctx.type_arena,
            registry: ctx.generic_registry,
            intern:   ctx.get_intern_table(),
            types:       HashMap<u32, TypeRef>::new(),
            moved_keys:  [],
            moved_spans: [],
            polled_keys:  [],
            polled_spans: [],
            moved_real:  [],
            suppress_emit:      false,
            capture_decls:      false,
            captured_decl_keys: [],
            carried_keys:       [],
            pat_binding_keys:   [],
            pm_binding:         [],
            pm_field:           [],
            branch_depth:       0,
            unsafe_depth:        0,
            arg_binding_unknown: false,
            fired: 0,
            fatal: 0,
        };
    }

    enter_function(mut &this, func: FunctionDeclNode*) -> void {
        this.types       = HashMap<u32, TypeRef>::new();
        this.moved_keys  = [];
        this.moved_spans = [];
        this.polled_keys  = [];
        this.polled_spans = [];
        this.moved_real  = [];
        this.suppress_emit      = false;
        this.capture_decls      = false;
        this.captured_decl_keys = [];
        this.carried_keys       = [];
        this.pat_binding_keys   = [];
        this.pm_binding         = [];
        this.pm_field           = [];
        this.branch_depth       = 0;
        this.unsafe_depth       = 0;
        this.arg_binding_unknown = false;
        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null) { continue; }
            this.register_binding(param.name, param.resolved_type);
        }
    }

    register_binding(mut &this, name: SymbolStr, ty: TypeRef) -> void {
        if (!name.is_valid()) { return; }
        this.types.insert(name.id, ty);
        // During a loop body's discovery walk, record bindings declared
        // inside the body so they're excluded from the carried set: a
        // body-local is a fresh binding each iteration, not a value
        // carried across the back-edge.
        if (this.capture_decls) {
            this.captured_decl_keys.push(name.id);
        }
    }

    /// Record an arm's enum-pattern payload binding names (direct + nested)
    /// as pattern-bound owned places for the duration of the arm walk, so
    /// `check_field_move_out` catches a field moved out of one.  Mirrors
    /// `drop_insertion::register_enum_pattern_bindings` (which registers the
    /// same names for consumption/drop-glue on its side).  Returns nothing;
    /// callers truncate `pat_binding_keys` back to a saved length after the join.
    register_arm_pat_bindings(mut &this, arm: MatchArmNode*) -> void {
        if (arm == null) { return; }
        for (mut p: i64 = 0; p < arm.patterns.length; p++) {
            const pat: PatternNode* = arm.patterns[p];
            if (pat == null || pat.pattern_kind != PatternKind::Enum) { continue; }
            this.register_enum_pat_bindings(pat as EnumPatternNode*);
        }
    }

    register_enum_pat_bindings(mut &this, epat: EnumPatternNode*) -> void {
        if (epat == null) { return; }
        for (mut pos: i64 = 0; pos < epat.elements.length; pos++) {
            const pb: PatternBinding* = epat.binding_at(pos);
            if (pb != null && pb.name.is_valid()) {
                this.pat_binding_keys.push(pb.name.id);
                continue;
            }
            const sub: PatternNode* = epat.sub_at(pos);
            if (sub != null && sub.pattern_kind == PatternKind::Enum) {
                this.register_enum_pat_bindings(sub as EnumPatternNode*);
            }
        }
    }

    truncate_pat_bindings(mut &this, n: i64) -> void {
        while (this.pat_binding_keys.length > n) { this.pat_binding_keys.pop(); }
    }

    is_pat_binding(&this, key: u32) -> boolean {
        for (mut i: i64 = 0; i < this.pat_binding_keys.length; i++) {
            if (this.pat_binding_keys[i] == key) { return true; }
        }
        return false;
    }

    is_body_local(&this, key: u32, from: i64) -> boolean {
        for (mut i: i64 = from; i < this.captured_decl_keys.length; i++) {
            if (this.captured_decl_keys[i] == key) { return true; }
        }
        return false;
    }

    truncate_captured(mut &this, n: i64) -> void {
        while (this.captured_decl_keys.length > n) { this.captured_decl_keys.pop(); }
    }

    truncate_carried(mut &this, n: i64) -> void {
        while (this.carried_keys.length > n) { this.carried_keys.pop(); }
    }

    is_carried(&this, name: SymbolStr) -> boolean {
        if (!name.is_valid()) { return false; }
        for (mut i: i64 = 0; i < this.carried_keys.length; i++) {
            if (this.carried_keys[i] == name.id) { return true; }
        }
        return false;
    }

    is_moved(&this, name: SymbolStr) -> boolean {
        if (!name.is_valid()) { return false; }
        for (mut i: i64 = 0; i < this.moved_keys.length; i++) {
            if (this.moved_keys[i] == name.id) { return true; }
        }
        return false;
    }

    moved_at_span(&this, name: SymbolStr) -> SourceSpan {
        for (mut i: i64 = 0; i < this.moved_keys.length; i++) {
            if (this.moved_keys[i] == name.id) { return this.moved_spans[i]; }
        }
        return SourceSpan::none();
    }

    lookup_type(&this, name: SymbolStr) -> TypeRef {
        match (this.types.get(&name.id)) {
            Option::Some(t) => { return t; }
            Option::None    => { return TypeRef::invalid(); }
        }
    }

    is_copy(&this, ty: TypeRef) -> boolean {
        return OwnershipQuery::is_copy(this.arena, this.registry, this.intern, ty);
    }

    /// Whether a value of this type owns a resource that the callee's
    /// by-value-param drop would free - i.e. reusing it after a by-value
    /// move could double-free.  Mirrors drop_insertion::type_needs_drop:
    /// Copy types never drop (the short-circuit matters because primitives
    /// carry a no-op `Drop` impl), and a non-Copy type drops only if it (or
    /// a transitive part) owns a destructor.  A non-Copy *non-droppable*
    /// type (e.g. builtin `string`, a primitive-only struct) is safe to
    /// reuse after a by-value move: there is no drop to run twice.
    type_needs_drop(&this, ty: TypeRef) -> boolean {
        if (!ty.is_valid())   { return false; }
        if (this.is_copy(ty)) { return false; }
        return OwnershipQuery::needs_drop(this.arena, this.registry,
                                          this.intern, ty);
    }

    is_polled(&this, name: SymbolStr) -> boolean {
        if (!name.is_valid()) { return false; }
        for (mut i: i64 = 0; i < this.polled_keys.length; i++) {
            if (this.polled_keys[i] == name.id) { return true; }
        }
        return false;
    }

    polled_at_span(&this, name: SymbolStr) -> SourceSpan {
        for (mut i: i64 = 0; i < this.polled_keys.length; i++) {
            if (this.polled_keys[i] == name.id) { return this.polled_spans[i]; }
        }
        return SourceSpan::none();
    }

    mark_polled(mut &this, name: SymbolStr, span: SourceSpan) -> void {
        if (!name.is_valid() || this.is_polled(name)) { return; }
        this.polled_keys.push(name.id);
        this.polled_spans.push(span);
    }

    /// Whether `ty` is a future - the receiver types this rule governs.  Asked
    /// of the CONCRETE type: this pass runs after monomorphization, so an
    /// `async fn`'s generated state machine and a hand-written `Future` impl
    /// both answer here, and a type that merely happens to have a method named
    /// `poll` does not.
    type_implements_future(&this, ty: TypeRef) -> boolean {
        if (!ty.is_valid()) { return false; }
        // A pointer receiver addresses storage the caller owns; moving the
        // POINTER does not move the future, so it is not this rule's business.
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return false; }
        if (t.kind == TypeKind::Pointer || t.kind == TypeKind::Reference) { return false; }
        mut checker: TraitChecker = TraitChecker::new(
            this.arena, this.registry, this.intern, this.ctx.diagnostics);
        return checker.type_implements_trait(ty, this.intern.intern("Future"), 0);
    }

    /// Record `<local>.poll(cx)` so a later move of that local is rejected.
    /// Only an identifier receiver matters: a field or a temporary is not a
    /// binding this pass can see moved.
    note_poll_receiver(mut &this, c: CallExprNode*) -> void {
        if (c == null || c.callee == null || this.intern == null) { return; }
        if (c.callee.kind != NodeKind::MemberAccess) { return; }
        const ma: MemberAccessNode* = c.callee as MemberAccessNode*;
        if (ma.member.id != this.intern.intern("poll").id) { return; }
        if (ma.object == null || ma.object.kind != NodeKind::Identifier) { return; }
        const nm: SymbolStr = (ma.object as IdentifierNode*).name;
        if (!this.type_implements_future(this.lookup_type(nm))) { return; }
        this.mark_polled(nm, (c as ASTNode*).span);
    }

    /// A future whose `poll` has run may have handed out a pointer into its own
    /// storage, so moving it now leaves that pointer naming the old bytes.
    emit_moved_after_poll(mut &this, name: SymbolStr, move_span: SourceSpan) -> void {
        const headline: string = format(
            "future '%s' is moved after it has been polled",
            this.intern.resolve(name));
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0459_MOVED_AFTER_POLL, headline);
        diag = diag.at_with_label(move_span, "moved here");
        const pspan: SourceSpan = this.polled_at_span(name);
        if (pspan.has_location()) {
            diag = diag.also_at(pspan, "polled here, fixing its address");
        }
        diag = diag.help(
            "a future may hold a pointer into its own storage once it has run, so it must stay put; hand it over before the first poll (`block_on(f)`, `spawn(f)`, `Futures::join(a, b)`) rather than after");
        this.ctx.emit_diagnostic(diag);
        this.fired += 1;
        this.fatal += 1;
    }

    /// A polled future must not change address.  Both a storage-duplicating
    /// move and a by-value COPY do exactly that, which is why this cannot ride
    /// on the move-set: a state machine whose fields are all scalars is `Copy`,
    /// and Copy types never enter that set at all.
    check_polled_move(mut &this, expr: ExpressionNode*) -> void {
        if (expr == null || this.suppress_emit) { return; }
        if (expr.kind != NodeKind::Identifier) { return; }
        const nm: SymbolStr = (expr as IdentifierNode*).name;
        if (!this.is_polled(nm)) { return; }
        this.emit_moved_after_poll(nm, expr.span);
    }

    mark_moved(mut &this, name: SymbolStr, span: SourceSpan, real: boolean) -> void {
        if (!name.is_valid()) { return; }
        if (this.is_moved(name)) {
            // Already moved: upgrade to a real (storage-duplicating) move
            // if this site is one, so a borrow-then-move sequence still
            // registers for loop-carried detection.
            if (real) {
                for (mut i: i64 = 0; i < this.moved_keys.length; i++) {
                    if (this.moved_keys[i] == name.id) { this.moved_real[i] = true; }
                }
            }
            return;
        }
        this.moved_keys.push(name.id);
        this.moved_spans.push(span);
        this.moved_real.push(real);
    }

    /// Clear the moved state for `name` (it has been reinitialized by an
    /// assignment).  Compacts the parallel (key, span) stacks in place.
    /// Modelling revival is what keeps the loop-carried check from
    /// flagging the safe `consume(x); x = make();` reinit-each-iteration
    /// pattern.
    unmark_moved(mut &this, name: SymbolStr) -> void {
        if (!name.is_valid()) { return; }
        mut keep_keys:  u32[]        = [];
        mut keep_spans: SourceSpan[] = [];
        mut keep_real:  boolean[]    = [];
        for (mut i: i64 = 0; i < this.moved_keys.length; i++) {
            if (this.moved_keys[i] == name.id) { continue; }
            keep_keys.push(this.moved_keys[i]);
            keep_spans.push(this.moved_spans[i]);
            keep_real.push(this.moved_real[i]);
        }
        this.moved_keys  = keep_keys;
        this.moved_spans = keep_spans;
        this.moved_real  = keep_real;
    }

    /// Snapshot the moved-set as the current array length. Restore
    /// truncates back to that length, dropping any moves recorded in
    /// the bracketed region. Used to scope branch state: an if-body
    /// that moves a binding shouldn't leak that move into post-if
    /// code (partial-move joins aren't yet modeled).
    snapshot_moves(&this) -> i64 {
        return this.moved_keys.length;
    }

    restore_moves(mut &this, checkpoint: i64) -> void {
        while (this.moved_keys.length > checkpoint) {
            this.moved_keys.pop();
            this.moved_spans.pop();
            this.moved_real.pop();
        }
    }

    /// Fully reinstate the moved-set from an explicit (key, span, real)
    /// snapshot, element-wise (no owning buffer is aliased). Unlike
    /// `restore_moves` - a truncate-only length rewind - this restores a
    /// snapshot even after `unmark_moved` DELETED an entry that lived below
    /// the old checkpoint. That is required at a branch join: an in-branch
    /// assignment (`x = ...`) revives `x` by rebuilding the moved-set without
    /// it, so a length rewind cannot put a pre-branch move back, and a
    /// one-branch revival would otherwise erase a move on every path
    /// (an accepted use-after-move -> double free).
    restore_full(mut &this, keys: &u32[], spans: &SourceSpan[],
                 real: &boolean[]) -> void {
        mut nk: u32[]        = [];
        mut ns: SourceSpan[] = [];
        mut nr: boolean[]    = [];
        for (mut i: i64 = 0; i < keys.length; i++) {
            nk.push(keys[i]);
            ns.push(spans[i]);
            nr.push(real[i]);
        }
        this.moved_keys  = nk;
        this.moved_spans = ns;
        this.moved_real  = nr;
    }

    /// Conservative "does every path through `stmt` leave via return / break /
    /// continue" check, used by merge_branches to decide whether a branch's
    /// moves reach the post-branch join. A diverging branch never falls
    /// through, so its moves must NOT propagate past the enclosing `if`/
    /// `match` - that is exactly what keeps the `if (c) { consume(x); return; }
    /// use(x);` guard pattern sound and false-positive-free. `break`/`continue`
    /// count as divergence here because, for an `if`/`match`, they jump to
    /// (or past) the enclosing loop, bypassing the code that follows the
    /// join. (This rule does NOT hold for `switch`, whose cases reach the
    /// join via `break`; switch is intentionally not merged.)
    always_diverges(&this, stmt: StatementNode*) -> boolean {
        if (stmt == null) { return false; }
        match (stmt.kind) {
            NodeKind::ReturnStatement   => { return true; }
            NodeKind::BreakStatement    => { return true; }
            NodeKind::ContinueStatement => { return true; }
            NodeKind::BlockStatement => {
                // A block diverges if any straight-line statement diverges
                // (everything after that statement is unreachable).
                const b: BlockStmtNode* = stmt as BlockStmtNode*;
                for (mut i: i64 = 0; i < b.statements.length; i++) {
                    if (this.always_diverges(b.statements[i])) { return true; }
                }
                return false;
            }
            NodeKind::IfStatement => {
                // Diverges only if it has an else AND both branches diverge.
                const it: IfStmtNode* = stmt as IfStmtNode*;
                if (it.else_stmt == null) { return false; }
                return this.always_diverges(it.then_stmt) &&
                       this.always_diverges(it.else_stmt);
            }
            NodeKind::MatchStatement => {
                // Exhaustive (sema-guaranteed): diverges if every arm does.
                const m: MatchStmtNode* = stmt as MatchStmtNode*;
                if (m.arms.length == 0) { return false; }
                for (mut i: i64 = 0; i < m.arms.length; i++) {
                    const arm: MatchArmNode* = m.arms[i];
                    if (arm == null || !this.always_diverges(arm.body)) {
                        return false;
                    }
                }
                return true;
            }
            NodeKind::StaticMatchStatement => {
                // Reduced to a single live arm by the monomorphizer; diverges
                // if that arm's body does.
                const sm: StaticMatchStmtNode* = stmt as StaticMatchStmtNode*;
                if (sm.arms.length == 0 || sm.arms[0] == null) { return false; }
                return this.always_diverges(sm.arms[0].body);
            }
            _ => { return false; }
        }
    }

    /// Walk a set of mutually-exclusive branches (the two arms of an `if`,
    /// or the arms of a `match`) and merge their move-sets at the join.
    ///
    /// Each branch is walked from the SAME pre-branch move state (restored
    /// between branches), so a within-branch use-after-move still fires and
    /// no branch sees another's moves. After all branches, a binding moved
    /// by ANY branch that can fall through to the join (i.e. does not
    /// `always_diverges`) is marked Moved: Cryo has no partial-move tracking,
    /// so a value possibly-moved on some path is unsafe to reuse past the
    /// join (a potential double free) and is treated as moved. Diverging
    /// branches' moves are dropped - their path never reaches the join.
    /// A null body (e.g. a missing `else`) is the implicit live no-move
    /// branch: it is skipped, contributing nothing to the union, which
    /// leaves a one-sided move correctly *possibly*-moved.
    merge_branches(mut &this, bodies: StatementNode*[]) -> void {
        // Inside a conditional: a field-move-out here is NOT an unconditional
        // partial move, so partial_move_allowed rejects it (stays E0453).
        this.branch_depth += 1;
        // Full pre-branch snapshot (element-wise copy). A length checkpoint
        // alone is unsound here: an in-branch assignment (`x = ...`) calls
        // `unmark_moved`, which REBUILDS the moved-set without `x`, deleting
        // an entry that may sit BELOW the checkpoint. `restore_moves` only
        // truncates, so it cannot reinstate it - a revival on ONE branch
        // would erase a pre-branch move on EVERY path (an accepted
        // use-after-move -> double free). We snapshot the whole set and
        // restore it in full between branches (see `restore_full`).
        mut pre_keys:  u32[]        = [];
        mut pre_spans: SourceSpan[] = [];
        mut pre_real:  boolean[]    = [];
        for (mut i: i64 = 0; i < this.moved_keys.length; i++) {
            pre_keys.push(this.moved_keys[i]);
            pre_spans.push(this.moved_spans[i]);
            pre_real.push(this.moved_real[i]);
        }
        const pre_len: i64 = pre_keys.length;

        // Branches are separate scopes. A binding DECLARED inside a branch
        // (e.g. `Ok(handle) => { mut f = handle; ... }`) is dead at the join,
        // so its move must NOT propagate - otherwise a sibling arm that
        // re-declares the same name would falsely read it as moved. We
        // record each branch's declarations (forcing `capture_decls` on for
        // the walk) and exclude branch-locals from the union, mirroring how
        // walk_loop_body excludes body-locals from the carried set.
        const prev_capture: boolean = this.capture_decls;

        // Post-join moved-set = union, over every fall-through path, of THAT
        // path's END moved-set. A binding is Moved after the join if SOME
        // fall-through path leaves it moved; if EVERY path revives (reassigns)
        // it, it is Live again. This is a meet over paths, which is why we
        // iterate each branch's FULL end-set (not just moves added past a
        // checkpoint): a pre-branch move a branch did NOT revive is still in
        // its end-set and must survive, while one that ALL branches revived
        // appears in no end-set and is correctly dropped.
        mut u_keys:  u32[]        = [];
        mut u_spans: SourceSpan[] = [];
        mut u_real:  boolean[]    = [];
        for (mut i: i64 = 0; i < bodies.length; i++) {
            const body: StatementNode* = bodies[i];
            if (body == null) {
                // Implicit fall-through path (a missing `else`): it moves and
                // revives nothing, so its end-set IS the pre-branch set.
                // Contributing it keeps a one-sided move *possibly* moved and
                // prevents a sibling branch's revival from leaking past the join.
                for (mut j: i64 = 0; j < pre_len; j++) {
                    const k: u32 = pre_keys[j];
                    const real: boolean = pre_real[j];
                    mut found: boolean = false;
                    for (mut u: i64 = 0; u < u_keys.length; u++) {
                        if (u_keys[u] == k) {
                            if (real) { u_real[u] = true; }
                            found = true;
                            break;
                        }
                    }
                    if (!found) {
                        u_keys.push(k);
                        u_spans.push(pre_spans[j]);
                        u_real.push(real);
                    }
                }
                continue;
            }
            const branch_cap_start: i64 = this.captured_decl_keys.length;
            this.capture_decls = true;
            this.walk_stmt(body);
            this.capture_decls = prev_capture;
            // Only branches that can fall through contribute moves to the join.
            if (!this.always_diverges(body)) {
                for (mut j: i64 = 0; j < this.moved_keys.length; j++) {
                    const k:    u32     = this.moved_keys[j];
                    // Declared in this branch -> dead at the join, skip.
                    if (this.is_body_local(k, branch_cap_start)) { continue; }
                    const real: boolean = this.moved_real[j];
                    mut found: boolean = false;
                    for (mut u: i64 = 0; u < u_keys.length; u++) {
                        if (u_keys[u] == k) {
                            // A storage-duplicating move on any path wins.
                            if (real) { u_real[u] = true; }
                            found = true;
                            break;
                        }
                    }
                    if (!found) {
                        u_keys.push(k);
                        u_spans.push(this.moved_spans[j]);
                        u_real.push(real);
                    }
                }
            }
            // Restore the FULL pre-branch state for the next branch (a plain
            // truncate cannot undo an in-branch revival).
            this.restore_full(pre_keys, pre_spans, pre_real);
            // Outside a loop-discovery walk, the captured branch-locals are
            // only needed for the exclusion above - drop them so the stack
            // doesn't grow. Inside one (prev_capture true), leave them: they
            // are genuinely loop-body-local and the enclosing loop needs them.
            if (!prev_capture) { this.truncate_captured(branch_cap_start); }
        }
        // Apply the merged moves as the post-join state.
        this.moved_keys  = [];
        this.moved_spans = [];
        this.moved_real  = [];
        for (mut i: i64 = 0; i < u_keys.length; i++) {
            this.mark_moved(SymbolStr::from_id(u_keys[i]), u_spans[i], u_real[i]);
        }
        this.branch_depth -= 1;
    }

    /// Emit a use-after-move error with a primary label at the use
    /// site and a secondary label at the original move site. Renderer
    /// combines them into a single rustc-style snippet with `...`
    /// between non-adjacent line groups.
    ///
    /// This is a hard error (increments `fatal`): a non-Copy value read
    /// after it was moved bitwise-copies a now-owned-elsewhere handle, so
    /// the read either observes freed storage or sets up a second drop of
    /// the same allocation - a double free.  The pass is fatal_on_failure,
    /// so a non-zero `fatal` aborts the pipeline before codegen and the
    /// unsound binary is never emitted.
    emit_use_after_move(mut &this, code: ErrorCode, headline: string,
                        use_span: SourceSpan, move_span: SourceSpan) -> void {
        mut diag: Diagnostic = Diagnostic::error(code, headline);
        diag = diag.at_with_label(use_span, "value used here after move");
        if (move_span.has_location()) {
            diag = diag.also_at(move_span, "value moved here");
        }
        this.ctx.emit_diagnostic(diag);
        this.fired += 1;
        this.fatal += 1;
    }

    /// A value declared outside a loop, moved inside it via a storage-
    /// duplicating move, and read again on the next iteration: the move
    /// re-runs every pass over the same storage, so an owning value is
    /// dropped (freed) more than once - a double free.  Both this and the
    /// within-iteration use-after-move path (`emit_use_after_move` above)
    /// are hard errors that increment `fatal`, failing the pass and
    /// aborting the pipeline before codegen so the double-freeing binary
    /// is never emitted.
    emit_loop_carried(mut &this, name: SymbolStr, use_span: SourceSpan) -> void {
        const headline: string = format(
            "value '%s' moved inside a loop is used again on the next iteration",
            this.intern.resolve(name));
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0452_USE_AFTER_MOVE, headline);
        diag = diag.at_with_label(use_span,
            "moved here, then re-read on the next iteration (double free)");
        diag = diag.help(
            "declare the value inside the loop, reassign it after the move, or move out of a per-iteration binding");
        this.ctx.emit_diagnostic(diag);
        this.fired += 1;
        this.fatal += 1;
    }

    walk_program(mut &this, root: ProgramNode*) -> void {
        if (root == null) { return; }
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }
            this.walk_top_level(stmt);
        }
    }

    walk_top_level(mut &this, stmt: ASTNode*) -> void {
        match (stmt.kind) {
            NodeKind::FunctionDeclaration => {
                this.walk_function(stmt as FunctionDeclNode*);
            }
            NodeKind::StructDeclaration => {
                this.walk_methods((stmt as StructDeclNode*).methods);
            }
            NodeKind::UnionDeclaration => {
                this.walk_methods((stmt as UnionDeclNode*).methods);
            }
            NodeKind::ClassDeclaration => {
                this.walk_methods((stmt as ClassDeclNode*).methods);
            }
            NodeKind::ImplementationBlock => {
                this.walk_methods((stmt as ImplBlockNode*).methods);
            }
            NodeKind::TraitDeclaration => {
                const td: TraitDeclNode* = stmt as TraitDeclNode*;
                for (mut i: i64 = 0; i < td.methods.length; i++) {
                    const m: FunctionDeclNode* = td.methods[i];
                    if (m != null) { this.walk_function(m); }
                }
            }
            _ => {}
        }
    }

    walk_methods(mut &this, methods: &MethodNode*[]) -> void {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null) { continue; }
            this.walk_function(m.func);
        }
    }

    walk_function(mut &this, func: FunctionDeclNode*) -> void {
        if (func == null || func.body == null) { return; }
        if (func.is_generic()) { return; }
        cdebug("[MoveCheck] === func '%s' ===\n", this.intern.resolve(func.name));
        this.enter_function(func);
        this.walk_block(func.body);
    }

    walk_block(mut &this, block: BlockStmtNode*) -> void {
        if (block == null) { return; }
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            const stmt: StatementNode* = block.statements[i];
            if (stmt == null) { continue; }
            this.walk_stmt(stmt);
        }
    }

    walk_stmt(mut &this, stmt: StatementNode*) -> void {
        if (stmt == null) { return; }
        match (stmt.kind) {
            NodeKind::BlockStatement => {
                this.walk_block(stmt as BlockStmtNode*);
            }
            NodeKind::UnsafeBlockStatement => {
                // Walked like any other block, with `unsafe_depth` raised so
                // the raw-pointer rules stand down inside it.  Everything else
                // this pass checks stays in force.
                this.unsafe_depth += 1;
                this.walk_block((stmt as UnsafeBlockStmtNode*).block);
                this.unsafe_depth -= 1;
            }
            NodeKind::ReturnStatement => {
                const r: ReturnStmtNode* = stmt as ReturnStmtNode*;
                if (r.expression != null) {
                    this.walk_expr_move(r.expression, true);
                }
            }
            NodeKind::ExpressionStatement => {
                const e: ExprStmtNode* = stmt as ExprStmtNode*;
                if (e.expression != null) {
                    this.walk_expr_read(e.expression);
                }
            }
            NodeKind::DeclarationStatement => {
                const ds: DeclStmtNode* = stmt as DeclStmtNode*;
                if (ds.declaration != null &&
                    ds.declaration.kind == NodeKind::VariableDeclaration) {
                    this.walk_var_decl(ds.declaration as VarDeclNode*);
                }
            }
            NodeKind::IfStatement => {
                const it: IfStmtNode* = stmt as IfStmtNode*;
                if (it.condition != null) { this.walk_expr_read(it.condition); }
                // Walk both branches from the same pre-branch state and merge
                // their moves at the join. A binding moved in a non-diverging
                // branch stays moved afterwards (possibly-moved -> Moved,
                // since Cryo has no partial-move tracking), so a reuse past
                // the `if` is reported. A null `else` is the implicit live
                // fall-through that moves nothing - it just leaves a then-only
                // move *possibly* (not definitely) moved, which the union
                // models correctly. See merge_branches.
                mut if_branches: StatementNode*[] = [it.then_stmt, it.else_stmt];
                this.merge_branches(if_branches);
            }
            NodeKind::MatchStatement => {
                // Moves inside match arms must be tracked, or a double-move
                // within one arm (or a move in an arm reused after the match)
                // would silently double-free at runtime. Read the subject once,
                // then merge the arm bodies like if/else branches. Sema
                // guarantees exhaustiveness, so there is no implicit live
                // fall-through arm.
                const m: MatchStmtNode* = stmt as MatchStmtNode*;
                if (m.subject != null) {
                    this.check_subject_move_out(m.subject);
                    this.walk_expr_read(m.subject);
                }
                // Register every arm's payload bindings as pattern-bound owned
                // places for the merge (membership-only, so cross-arm overlap
                // is harmless: an arm body references only its own bindings).
                // This is what lets `check_field_move_out` catch a field moved
                // out of a `Some(pair) => ...` binding.
                const pat_snap: i64 = this.pat_binding_keys.length;
                mut arm_bodies: StatementNode*[] = [];
                for (mut ai: i64 = 0; ai < m.arms.length; ai++) {
                    const arm: MatchArmNode* = m.arms[ai];
                    if (arm != null) {
                        this.register_arm_pat_bindings(arm);
                        // A guard runs before the arm body; walk it as a read
                        // (like an `if` condition) so any move inside it is
                        // tracked. Reads of arm-local pattern bindings are
                        // harmless no-ops in the move-set.
                        if (arm.guard != null) { this.walk_expr_read(arm.guard); }
                        arm_bodies.push(arm.body);
                    }
                }
                this.merge_branches(arm_bodies);
                this.truncate_pat_bindings(pat_snap);
            }
            NodeKind::StaticMatchStatement => {
                // Single live arm post-monomorphization: walk it as a plain
                // block (no subject value, no branch merge).
                const sm: StaticMatchStmtNode* = stmt as StaticMatchStmtNode*;
                if (sm.arms.length > 0 && sm.arms[0] != null && sm.arms[0].body != null) {
                    this.walk_stmt(sm.arms[0].body);
                }
            }
            NodeKind::WhileStatement => {
                const w: WhileStmtNode* = stmt as WhileStmtNode*;
                if (w.condition != null) { this.walk_expr_read(w.condition); }
                this.walk_loop_body(w.body);
            }
            NodeKind::ForStatement => {
                const f: ForStmtNode* = stmt as ForStmtNode*;
                if (f.condition != null) { this.walk_expr_read(f.condition); }
                if (f.update != null)    { this.walk_expr_read(f.update); }
                this.walk_loop_body(f.body);
            }
            NodeKind::DoWhileStatement => {
                const d: DoWhileStmtNode* = stmt as DoWhileStmtNode*;
                this.walk_loop_body(d.body);
                if (d.condition != null) { this.walk_expr_read(d.condition); }
            }
            NodeKind::LoopStatement => {
                const lp: LoopStmtNode* = stmt as LoopStmtNode*;
                this.walk_loop_body(lp.body);
            }
            NodeKind::SwitchStatement => {
                // Moves inside switch case bodies must be tracked, or a
                // double-move within one case - or a move in a case reused after
                // the switch - would silently double-free/use-after-free at
                // runtime. Cryo's switch has no
                // fallthrough (each case is an independent block), so cases are
                // mutually-exclusive branches like match arms: read the subject
                // once, then merge the case bodies. The subject is always a Copy
                // scalar (sema restricts it to int/char/bool/fieldless-enum), so
                // it never itself moves.
                const sw: SwitchStmtNode* = stmt as SwitchStmtNode*;
                if (sw.expression != null) { this.walk_expr_read(sw.expression); }
                this.merge_switch_cases(sw.cases);
            }
            _ => {}
        }
    }

    /// Divergence of a switch CASE body with respect to the switch's own
    /// merge point. Unlike `always_diverges`, a `break` is NOT divergence
    /// here: in a switch a `break` jumps to the merge (the normal way to end
    /// a case), so the case's moves still reach the code after the switch and
    /// must be counted at the join. Only `return` / `continue` leave the
    /// switch entirely (to the function / an enclosing loop), so those cases'
    /// moves do not escape to the post-switch state.
    switch_case_diverges(mut &this, stmt: StatementNode*) -> boolean {
        if (stmt == null) { return false; }
        match (stmt.kind) {
            NodeKind::ReturnStatement   => { return true;  }
            NodeKind::ContinueStatement => { return true;  }
            NodeKind::BreakStatement    => { return false; }
            NodeKind::BlockStatement => {
                const b: BlockStmtNode* = stmt as BlockStmtNode*;
                for (mut i: i64 = 0; i < b.statements.length; i++) {
                    if (this.switch_case_diverges(b.statements[i])) { return true; }
                }
                return false;
            }
            NodeKind::IfStatement => {
                const it: IfStmtNode* = stmt as IfStmtNode*;
                if (it.else_stmt == null) { return false; }
                return this.switch_case_diverges(it.then_stmt) &&
                       this.switch_case_diverges(it.else_stmt);
            }
            NodeKind::MatchStatement => {
                const m: MatchStmtNode* = stmt as MatchStmtNode*;
                if (m.arms.length == 0) { return false; }
                for (mut i: i64 = 0; i < m.arms.length; i++) {
                    const arm: MatchArmNode* = m.arms[i];
                    if (arm == null || !this.switch_case_diverges(arm.body)) {
                        return false;
                    }
                }
                return true;
            }
            NodeKind::StaticMatchStatement => {
                const sm: StaticMatchStmtNode* = stmt as StaticMatchStmtNode*;
                if (sm.arms.length == 0 || sm.arms[0] == null) { return false; }
                return this.switch_case_diverges(sm.arms[0].body);
            }
            _ => { return false; }
        }
    }

    /// Merge the move-sets of a switch's case bodies at the switch join.
    /// Mirrors `merge_branches` (each case walked from the same pre-switch
    /// state, intra-case use-after-move still fires, branch-local bindings
    /// excluded from the union, possibly-moved -> Moved at the join), but uses
    /// `switch_case_diverges` so a `break`-terminated case still contributes
    /// its moves (it reaches the merge). A switch is not required to be
    /// exhaustive; the implicit "no case matched" fall-through moves nothing,
    /// which the union models correctly (a one-sided move stays *possibly*
    /// moved and is conservatively treated as Moved).
    merge_switch_cases(mut &this, cases: &CaseStmtNode*[]) -> void {
        this.branch_depth += 1;
        // Full pre-switch snapshot (see `merge_branches` for why a length
        // checkpoint is unsound when a case revives a pre-switch move).
        mut pre_keys:  u32[]        = [];
        mut pre_spans: SourceSpan[] = [];
        mut pre_real:  boolean[]    = [];
        for (mut i: i64 = 0; i < this.moved_keys.length; i++) {
            pre_keys.push(this.moved_keys[i]);
            pre_spans.push(this.moved_spans[i]);
            pre_real.push(this.moved_real[i]);
        }
        const pre_len: i64 = pre_keys.length;

        const prev_capture: boolean = this.capture_decls;
        mut u_keys:  u32[]        = [];
        mut u_spans: SourceSpan[] = [];
        mut u_real:  boolean[]    = [];
        for (mut i: i64 = 0; i < cases.length; i++) {
            const c: CaseStmtNode* = cases[i];
            if (c == null || c.body == null) { continue; }
            const branch_cap_start: i64 = this.captured_decl_keys.length;
            this.capture_decls = true;
            this.walk_stmt(c.body as StatementNode*);
            this.capture_decls = prev_capture;
            if (!this.switch_case_diverges(c.body as StatementNode*)) {
                // Contribute this case's FULL end-set (not just moves past a
                // checkpoint) so a pre-switch move the case did not revive
                // survives the join. See merge_branches.
                for (mut j: i64 = 0; j < this.moved_keys.length; j++) {
                    const k: u32 = this.moved_keys[j];
                    if (this.is_body_local(k, branch_cap_start)) { continue; }
                    const real: boolean = this.moved_real[j];
                    mut found: boolean = false;
                    for (mut u: i64 = 0; u < u_keys.length; u++) {
                        if (u_keys[u] == k) {
                            if (real) { u_real[u] = true; }
                            found = true;
                            break;
                        }
                    }
                    if (!found) {
                        u_keys.push(k);
                        u_spans.push(this.moved_spans[j]);
                        u_real.push(real);
                    }
                }
            }
            this.restore_full(pre_keys, pre_spans, pre_real);
            if (!prev_capture) { this.truncate_captured(branch_cap_start); }
        }
        // A switch need not be exhaustive: the implicit "no case matched"
        // fall-through moves and revives nothing, so its end-set is the
        // pre-switch set. Contributing it keeps every pre-switch move alive
        // across the switch (a case's revival cannot leak past the join).
        for (mut j: i64 = 0; j < pre_len; j++) {
            const k: u32 = pre_keys[j];
            const real: boolean = pre_real[j];
            mut found: boolean = false;
            for (mut u: i64 = 0; u < u_keys.length; u++) {
                if (u_keys[u] == k) {
                    if (real) { u_real[u] = true; }
                    found = true;
                    break;
                }
            }
            if (!found) {
                u_keys.push(k);
                u_spans.push(pre_spans[j]);
                u_real.push(real);
            }
        }
        this.moved_keys  = [];
        this.moved_spans = [];
        this.moved_real  = [];
        for (mut i: i64 = 0; i < u_keys.length; i++) {
            this.mark_moved(SymbolStr::from_id(u_keys[i]), u_spans[i], u_real[i]);
        }
        this.branch_depth -= 1;
    }

    /// Walk a loop body with loop-carried-move detection.
    ///
    /// A binding declared OUTSIDE the loop that the body leaves in the
    /// Moved state at the back-edge is read again at the top of the next
    /// iteration - a use-after-move that the single-walk Phase-1 model
    /// missed because it restored the moved-set after each loop. Because
    /// the move re-executes every pass over the same storage, an owning
    /// value's `drop` runs more than once -> double free.
    ///
    /// The body is walked twice: a silent discovery walk records which
    /// outer bindings survive moved (excluding body-local declarations,
    /// which are fresh each iteration), then a real walk with those
    /// bindings staged as moved-on-entry surfaces the re-move at its
    /// site. Branch handling stays conservative (snapshot/restore), so
    /// only UNCONDITIONAL loop-carried moves are flagged - zero false
    /// positives, at the cost of missing moves guarded by an inner `if`.
    walk_loop_body(mut &this, body: StatementNode*) -> void {
        if (body == null) { return; }
        // A loop body is conditional (0+ iterations): a field-move-out inside
        // it is not an unconditional partial move, so it stays E0453.
        this.branch_depth += 1;
        // All bookkeeping uses persistent parallel-array stacks with
        // length checkpoints (like `moved_keys`), so nested loops just
        // push and truncate - no array reassignment, no aliasing.
        const snap:       i64 = this.snapshot_moves();
        const cap_snap:   i64 = this.captured_decl_keys.length;
        const carry_snap: i64 = this.carried_keys.length;

        // discovery walk: silent, capture body-local declarations
        const prev_suppress: boolean = this.suppress_emit;
        const prev_capture:  boolean = this.capture_decls;
        this.suppress_emit = true;
        this.capture_decls = true;
        this.walk_stmt(body);
        this.suppress_emit = prev_suppress;
        this.capture_decls = prev_capture;

        // Stage outer bindings the body left moved at the back-edge as
        // carried.  Skip body-locals (fresh each iteration) and bindings
        // whose only move was an autoref'd call argument (`moved_real`
        // false) - those don't duplicate the value into a dropped copy.
        for (mut i: i64 = snap; i < this.moved_keys.length; i++) {
            const k: u32 = this.moved_keys[i];
            if (!this.moved_real[i]) { continue; }
            if (this.is_body_local(k, cap_snap)) { continue; }
            this.carried_keys.push(k);
        }
        this.truncate_captured(cap_snap);
        this.restore_moves(snap);

        // real walk: carried bindings are moved-on-entry, so the
        // re-move at the top of the body reports use-after-move.
        // The staged span is irrelevant - emit_loop_carried reports
        // at the use site.
        for (mut i: i64 = carry_snap; i < this.carried_keys.length; i++) {
            this.moved_keys.push(this.carried_keys[i]);
            this.moved_spans.push(SourceSpan::none());
            this.moved_real.push(true);
        }
        this.walk_stmt(body);

        // A loop may run zero times; body-internal moves don't propagate
        // to the following code.
        this.truncate_carried(carry_snap);
        this.restore_moves(snap);
        this.branch_depth -= 1;
    }

    walk_var_decl(mut &this, vd: VarDeclNode*) -> void {
        if (vd == null) { return; }
        if (vd.initializer != null) {
            this.walk_expr_move(vd.initializer, true);
        }
        if (!vd.is_global) {
            this.register_binding(vd.name, vd.resolved_type);
        }
    }

    /// True when passing `arg` hands the callee the VALUE rather than just an
    /// address.  A by-value (`T`) parameter duplicates the caller's storage and
    /// the callee drops its own copy, so reusing the caller's binding afterwards
    /// frees the same storage twice; a `&T` or `T*` parameter carries only an
    /// address and takes no ownership of the pointee.
    ///
    /// Sema records which of the two it resolved (`arg_binding`).  An
    /// unclassified slot - an unresolved callee, a variadic tail, or a call a
    /// later pass synthesized - reads as a transfer: over-reporting a move
    /// costs a diagnostic, under-reporting one is a double free.
    ///
    /// This must not be answered from `autoref`.  That flag is a codegen
    /// directive meaning "take this argument's address", so it is set only for a
    /// `&T` parameter and never for a `T*` one - which classified every
    /// pointer-parameter argument, `mem::swap<T>(a: T*, b: T*)` included, as a
    /// by-value transfer of a value the callee never takes.
    arg_transfers_value(&this, arg: ExpressionNode*) -> boolean {
        if (arg == null) { return false; }
        if (arg.arg_binding == ArgBinding::Borrowed) { return false; }
        return true;
    }

    /// Walk an argument expression with the ownership effect its parameter
    /// gives it.  Shared by call and `new` arguments so the two cannot drift.
    /// Only a transfer whose type actually needs drop can double-free on reuse;
    /// tracking non-droppable by-value arguments (e.g. builtin `string`) as
    /// moves would flag harmless reuse as use-after-move.  DropInsertion
    /// suppresses those drops the same way (its by-value-param drop is gated on
    /// `type_needs_drop`), so gating here keeps the two passes on the identical
    /// move set.
    walk_argument(mut &this, arg: ExpressionNode*) -> void {
        if (arg == null) { return; }
        if (!this.arg_transfers_value(arg)) {
            this.walk_expr_read(arg);
            return;
        }
        if (this.type_needs_drop(arg.resolved_type)) {
            // Tracked as a move either way, but only a parameter sema actually
            // resolved is grounds for REJECTING a move out of a pointer here.
            // See `arg_binding_unknown` for why the two defaults differ.
            const prev_unknown: boolean = this.arg_binding_unknown;
            this.arg_binding_unknown = (arg.arg_binding == ArgBinding::Unclassified);
            this.walk_expr_move(arg, true);
            this.arg_binding_unknown = prev_unknown;
            return;
        }
        // Passed by value without needing drop: the callee still works on a
        // copy at a different address - the same hazard as a move for a rule
        // about addresses, and the path a `Copy` state machine actually takes.
        this.check_polled_move(arg);
        this.walk_expr_read(arg);
    }

    /// Walk an expression in "move" context: bare identifiers of
    /// non-Copy types are marked Moved, sub-expressions descend in
    /// "read" context.  `real` marks storage-duplicating move sites
    /// (let/var init, assignment RHS, aggregate-literal field) versus
    /// autoref'd call arguments; see `moved_real`.
    walk_expr_move(mut &this, expr: ExpressionNode*, real: boolean) -> void {
        if (expr == null) { return; }
        // A storage-duplicating move of a non-Copy field out of an owned
        // value is a double free (no partial-move tracking). Reject it.
        if (real) { this.check_polled_move(expr); }
        if (real) { this.check_field_move_out(expr); }
        // Same hazard for a value read out THROUGH a pointer: the pointee is
        // duplicated into an independently-dropped place while whoever owns
        // that storage keeps its own claim on it.
        if (real) { this.check_deref_move_out(expr); }
        // Same hazard for an array element read by value: the array keeps
        // ownership of the element, so the duplicated handle is freed twice.
        if (real) { this.check_array_move_out(expr); }
        // ...and for a whole owning-array field read by value THROUGH a
        // pointer/reference (`x = node.fields`): `check_field_move_out` only
        // covers owned-value places, but an owning `T[]` field aliases its
        // buffer regardless of how the struct is reached, so it double-frees.
        if (real) { this.check_array_field_move_out(expr); }
        if (expr.kind == NodeKind::Identifier) {
            this.handle_ident(expr as IdentifierNode*, true, real);
            return;
        }
        // For other shapes, descend in read mode by default; the
        // child-as-move is only applied at known consume sites below.
        this.walk_expr_read(expr);
    }

    /// Walk an expression in "read" context: sub-expressions don't
    /// move bare bindings, but we still recurse for use-after-move
    /// detection on already-moved identifiers. Split into small
    /// per-kind helpers to keep individual functions short (originally
    /// also to dodge an earlier-compiler basic-block-count limit).
    walk_expr_read(mut &this, expr: ExpressionNode*) -> void {
        if (expr == null) { return; }
        match (expr.kind) {
            NodeKind::Identifier         => { this.handle_ident(expr as IdentifierNode*, false, false); }
            NodeKind::CallExpression     => { this.read_call(expr as CallExprNode*);                 }
            NodeKind::BinaryExpression   => { this.read_binary(expr as BinaryExprNode*);             }
            NodeKind::UnaryExpression    => { this.read_unary(expr as UnaryExprNode*);               }
            NodeKind::MemberAccess       => { this.read_member(expr as MemberAccessNode*);           }
            NodeKind::ArrayAccess        => { this.read_array_access(expr as ArrayAccessNode*);      }
            NodeKind::CastExpression     => { this.read_cast(expr as CastExprNode*);                 }
            NodeKind::StructLiteral      => { this.read_struct_lit(expr as StructLiteralNode*);      }
            NodeKind::TupleLiteral       => { this.read_tuple_lit(expr as TupleLiteralNode*);        }
            NodeKind::ArrayLiteral       => { this.read_array_lit(expr as ArrayLiteralNode*);        }
            NodeKind::TernaryExpression  => { this.read_ternary(expr as TernaryExprNode*);           }
            NodeKind::IfExpression       => { this.read_if_expr(expr as IfExprNode*);                }
            NodeKind::MatchExpression    => { this.read_match(expr as MatchExprNode*);               }
            NodeKind::StaticMatchExpression => {
                // Reduced to one live arm by the monomorphizer; walk it as a block.
                const sme: StaticMatchExprNode* = expr as StaticMatchExprNode*;
                if (sme.arms.length > 0 && sme.arms[0] != null && sme.arms[0].body != null) {
                    this.walk_stmt(sme.arms[0].body);
                }
            }
            NodeKind::NewExpression      => { this.read_new(expr as NewExprNode*);                   }
            NodeKind::TryExpression      => {
                // `expr?` is lowered to a `match` by sema; walk the desugar
                // so the operand is move-checked like any other match.
                const te: TryExprNode* = expr as TryExprNode*;
                if (te.desugared != null) { this.walk_expr_read(te.desugared); }
            }
            NodeKind::LambdaExpression   => { this.read_lambda(expr as LambdaExprNode*);     }
            _ => {}
        }
    }

    /// A move-flagged lambda consumes each non-Copy captured outer binding
    /// at its construction site - the surrounding scope can no longer name
    /// those bindings, and a loop-carried construction double-frees the
    /// captured value.  Walk each capture as a real move so subsequent uses
    /// surface as E0452 and loop-carried captures fail the pass.
    ///
    /// Sema flips `is_move` on any lambda that captures a non-Copy outer
    /// binding (whether the source wrote `move` or not); a Copy-only
    /// lambda has `is_move == false` and the loop body is a no-op.
    /// Bodies aren't walked here: sema synthesises a closure struct +
    /// `__call__` method for capturing lambdas and injects them into the
    /// program, so MoveCheck visits the body when it walks the
    /// synthesised method.  Non-capturing lambdas have no outer-state
    /// effect at the construction site.
    read_lambda(mut &this, lam: LambdaExprNode*) -> void {
        if (lam == null) { return; }
        if (!lam.is_move) { return; }
        for (mut i: i64 = 0; i < lam.captured_names.length; i++) {
            const cap_name: SymbolStr = lam.captured_names[i];
            const cap_ty:   TypeRef   = lam.captured_types[i];
            if (!cap_ty.is_valid()) { continue; }
            if (this.is_copy(cap_ty)) { continue; }
            // Synthesize an IdentifierNode at the capture's recorded span so
            // handle_ident's existing use-after-move and loop-carried logic
            // applies uniformly with any other move site.
            mut id: IdentifierNode* = new IdentifierNode(cap_name,
                lam.captured_spans[i]);
            id.set_resolved_type(cap_ty);
            this.handle_ident(id, true, true);
        }
    }

    read_call(mut &this, c: CallExprNode*) -> void {
        if (c == null) { return; }
        // Special case: `<ident>.drop()` is the user's "release this
        // binding now" mark.  `Drop::drop` is signed `drop(mut &this)`,
        // so `method_consumes_receiver` says false (a reference
        // receiver isn't a by-value consume), and without this arm
        // the move-checker would treat `x.drop()` as a borrow.  But
        // drop_insertion already treats `.drop()` as a move so it
        // doesn't synthesise a second drop at scope exit
        // (drop_insertion.cryo:1899-1924), and the two passes must
        // agree on the move-set.  Mirror that classification here so
        // `x.drop(); x.drop();` (or `x.drop(); use(x);`) surfaces as
        // E0452 at compile time instead of a silent double-free at
        // runtime.  Identifier-only receivers and zero arguments keep
        // the special case syntactic (no false positives on method
        // chains or .drop()-with-args overloads).
        if (c.callee != null && c.arguments.length == 0 &&
            c.callee.kind == NodeKind::MemberAccess) {
            const ma: MemberAccessNode* = c.callee as MemberAccessNode*;
            if (this.intern != null &&
                ma.member.id == this.intern.intern("drop").id &&
                ma.object != null && ma.object.kind == NodeKind::Identifier) {
                // walk_expr_move's Copy guard short-circuits for
                // primitives and POD types, so this is a no-op for
                // bindings that don't actually own anything.
                this.walk_expr_move(ma.object, true);
                return;
            }
        }
        // Method call to a consuming method: treat the receiver
        // (`x` in `x.method(...)`) as moved.  Without this, a method
        // declared `mut this` or marked `![sink]` would still
        // appear as a borrow at the call site, since the LHS of a
        // member-access defaults to `walk_expr_read`.  Resolved-method
        // is null for free functions, scope-resolution calls, and
        // calls sema couldn't resolve; those fall through to the
        // standard read+arg-move walk below.
        // Recorded before the receiver is walked: a consuming `poll` would mark
        // the receiver moved below, and the question here is what the call does
        // to the value's ADDRESS, not to its ownership.
        this.note_poll_receiver(c);
        mut receiver_moved: boolean = false;
        if (c.resolved_method != null && c.callee != null
                && c.callee.kind == NodeKind::MemberAccess) {
            const m: MethodNode* = c.resolved_method as MethodNode*;
            if (OwnershipQuery::method_consumes_receiver(this.arena, this.intern, m)) {
                const ma: MemberAccessNode* = c.callee as MemberAccessNode*;
                if (ma.object != null) {
                    // A consuming receiver (`mut this` / `![sink]`) is a
                    // real move: the value is taken and dropped by the
                    // callee, so a loop-carried receiver double-frees.
                    this.walk_expr_move(ma.object, true);
                    receiver_moved = true;
                }
            }
        }
        if (!receiver_moved && c.callee != null) {
            this.walk_expr_read(c.callee);
        }
        // An argument's ownership effect depends on the parameter it binds to,
        // which sema records as `arg_binding` (see `arg_transfers_value`):
        //   - a borrow (`&T` / `T*` parameter): only an address crosses the
        //     call, so walk it in READ context.  That still flags passing an
        //     already-moved value, but does not itself mark the argument moved.
        //   - a by-value transfer (`T` parameter): the value is moved into the
        //     callee, which drops it at its scope exit (see drop_insertion's
        //     by-value-param drop).  This duplicates the caller's storage, so
        //     reusing the binding afterwards drops it twice.  Walk it in MOVE
        //     context (real=true) so a later use reports use-after-move and a
        //     loop-carried reuse - a guaranteed double free - is a hard error.
        // This mirrors drop_insertion::read_call so both passes agree on which
        // arguments transfer ownership; a mismatch (move_check seeing a borrow,
        // drop_insertion a move) would silently double-free by-value owning
        // arguments.  Copy args and explicit `&x`/pointer args fall out via the
        // Copy / address-of guards in `walk_expr_move`.
        for (mut i: i64 = 0; i < c.arguments.length; i++) {
            this.walk_argument(c.arguments[i]);
        }
        return;
    }

    read_binary(mut &this, b: BinaryExprNode*) -> void {
        if (b == null) { return; }
        if (b.op.kind == TokenType::Equal) {
            // `lhs = rhs` moves the RHS into the LHS place, regardless of
            // whether the LHS is a bare binding or a field / index target:
            // the RHS is a storage-duplicating move.  A field-move-out on the
            // RHS double-frees, so check for it explicitly.  So does a
            // move-out through a pointer, and for the same reason: the walk
            // below passes `real=false`, which skips both checks.
            if (b.right != null) { this.check_field_move_out(b.right); }
            if (b.right != null) { this.check_deref_move_out(b.right); }
            if (b.left != null && b.left.kind == NodeKind::Identifier) {
                // Plain assignment to a bare identifier is a pure write: it
                // reinitializes the binding rather than reading it.  MOVE the
                // RHS (real=false: mark a bare-ident non-Copy RHS moved so a
                // later use surfaces as E0452, WITHOUT applying the real-move
                // array-move-out checks - the assignment path never ran those
                // and doing so would false-positive on the swap-remove idiom
                // `a[i] = a[last]` and on shallow array-field copies).  This
                // aligns move_check's move set with drop_insertion, which also
                // moves the RHS of every `=` and suppresses its scope-exit
                // drop; walking the RHS in read context here instead would
                // leave it Live for move_check while drop_insertion suppressed
                // its drop, so `x = y; f(y);` (non-Copy `y`) would compile and
                // then double-free `y`.  Then clear the LHS's moved state so a
                // moved-then-reassigned local is Live again (keeps the loop-
                // carried check from flagging `consume(x); x = make();` and
                // leaves `x = f(x)` with `x` Live).  Do NOT walk the LHS
                // (reading it would spuriously flag reassigning a moved-out
                // binding).
                if (b.right != null) { this.walk_expr_move(b.right, false); }
                this.unmark_moved((b.left as IdentifierNode*).name);
                return;
            }
            // Field / index LHS: read the LHS place (its address is computed)
            // and move the RHS into it (same real=false rationale as above).
            if (b.left  != null) { this.walk_expr_read(b.left); }
            if (b.right != null) { this.walk_expr_move(b.right, false); }
            return;
        }
        if (b.left != null)  { this.walk_expr_read(b.left); }
        if (b.right != null) { this.walk_expr_read(b.right); }
        return;
    }

    read_unary(mut &this, u: UnaryExprNode*) -> void {
        if (u == null) { return; }
        if (u.operand != null) { this.walk_expr_read(u.operand); }
        return;
    }

    read_member(mut &this, ma: MemberAccessNode*) -> void {
        if (ma == null) { return; }
        if (ma.object != null) { this.walk_expr_read(ma.object); }
        return;
    }

    read_array_access(mut &this, aa: ArrayAccessNode*) -> void {
        if (aa == null) { return; }
        if (aa.array != null) { this.walk_expr_read(aa.array); }
        if (aa.index != null) { this.walk_expr_read(aa.index); }
        return;
    }

    read_cast(mut &this, cv: CastExprNode*) -> void {
        if (cv == null) { return; }
        if (cv.expression != null) { this.walk_expr_read(cv.expression); }
        return;
    }

    read_struct_lit(mut &this, sl: StructLiteralNode*) -> void {
        if (sl == null) { return; }
        // Field initializers bitwise-copy the value into a new owning
        // aggregate that is independently dropped: a real move.
        for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
            this.walk_expr_move(sl.field_inits[i].value, true);
        }
        return;
    }

    read_tuple_lit(mut &this, tl: TupleLiteralNode*) -> void {
        if (tl == null) { return; }
        for (mut i: i64 = 0; i < tl.elements.length; i++) {
            this.walk_expr_move(tl.elements[i], true);
        }
        return;
    }

    read_array_lit(mut &this, al: ArrayLiteralNode*) -> void {
        if (al == null) { return; }
        for (mut i: i64 = 0; i < al.elements.length; i++) {
            this.walk_expr_move(al.elements[i], true);
        }
        return;
    }

    read_ternary(mut &this, t: TernaryExprNode*) -> void {
        if (t == null) { return; }
        if (t.condition != null)  { this.walk_expr_read(t.condition); }
        if (t.true_expr != null)  { this.walk_expr_read(t.true_expr); }
        if (t.false_expr != null) { this.walk_expr_read(t.false_expr); }
        return;
    }

    read_if_expr(mut &this, ie: IfExprNode*) -> void {
        if (ie == null) { return; }
        if (ie.condition != null) { this.walk_expr_read(ie.condition); }
        if (ie.then_expr != null) { this.walk_expr_read(ie.then_expr); }
        if (ie.else_expr != null) { this.walk_expr_read(ie.else_expr); }
        return;
    }

    /// A `match` in expression position (also the desugaring of `expr?`).
    /// Read the subject once, then merge the arm bodies exactly like the
    /// statement form so a double-move within an arm, or a move in an arm
    /// reused after the match, is caught.
    read_match(mut &this, m: MatchExprNode*) -> void {
        if (m == null) { return; }
        if (m.subject != null) {
            this.check_subject_move_out(m.subject);
            this.walk_expr_read(m.subject);
        }
        const pat_snap: i64 = this.pat_binding_keys.length;
        mut arm_bodies: StatementNode*[] = [];
        for (mut i: i64 = 0; i < m.arms.length; i++) {
            const arm: MatchArmNode* = m.arms[i];
            if (arm != null) {
                this.register_arm_pat_bindings(arm);
                // Guard runs before the body; walk as a read (see the
                // statement-match handler for the rationale).
                if (arm.guard != null) { this.walk_expr_read(arm.guard); }
                arm_bodies.push(arm.body);
            }
        }
        this.merge_branches(arm_bodies);
        this.truncate_pat_bindings(pat_snap);
        return;
    }

    read_new(mut &this, n: NewExprNode*) -> void {
        if (n == null) { return; }
        // `new T(args)` constructor arguments transfer ownership exactly like
        // ordinary call arguments: a by-value (`T` parameter) argument is moved
        // into the constructed object, so reusing the caller's binding
        // afterwards is a use-after-move (and a loop-carried reuse double-frees
        // once the object owns the storage).  Earlier this walked every
        // argument as a borrow, which left `new Holder(t); use(t);` silently
        // accepted even though drop_insertion::read_new already treats the same
        // argument as a move and suppresses its scope-exit drop - the two
        // passes disagreed on the move-set.  Mirror read_call (and
        // drop_insertion::read_new) so they track the identical set: a borrow
        // stays a read, a by-value droppable argument is a real move.
        for (mut i: i64 = 0; i < n.arguments.length; i++) {
            this.walk_argument(n.arguments[i]);
        }
        // `new T { field: local }` field initializers live in struct_init,
        // not arguments, and store-by-value (move for owning fields) exactly
        // like a bare struct literal.  Walk them so this pass's move-set
        // matches drop_insertion::read_new (the two MUST agree, see above);
        // otherwise drop_insertion suppresses the field-init binding's
        // scope-exit drop while move_check still thinks it is live.
        if (n.struct_init != null) { this.read_struct_lit(n.struct_init); }
        if (n.array_size != null)  { this.walk_expr_read(n.array_size); }
        return;
    }

    // ---- partial-move tracking (the "allow + track" half) ----------------

    pm_has(&this, binding_id: u32, field_id: u32) -> boolean {
        for (mut i: i64 = 0; i < this.pm_binding.length; i++) {
            if (this.pm_binding[i] == binding_id && this.pm_field[i] == field_id) {
                return true;
            }
        }
        return false;
    }

    pm_has_binding(&this, binding_id: u32) -> boolean {
        for (mut i: i64 = 0; i < this.pm_binding.length; i++) {
            if (this.pm_binding[i] == binding_id) { return true; }
        }
        return false;
    }

    /// True when `ty` carries a user-written destructor (an inherent `drop`
    /// method or an `implement trait Drop` block).  Such an owner's `drop`
    /// is opaque code that will free every field it thinks it owns, so a
    /// field moved out of it double-frees - partial moves stay forbidden.
    has_user_drop(&this, ty: TypeRef) -> boolean {
        if (!ty.is_valid() || this.arena == null) { return false; }
        if (OwnershipQuery::has_inherent_drop(this.arena, this.registry,
                                              this.intern, ty)) { return true; }
        return OwnershipQuery::type_implements_drop(this.arena, this.registry,
                                                    this.intern, ty);
    }

    /// Resolve `ty` to the underlying struct/class Type* whose per-field drop
    /// glue we can enumerate, peeling `InstantiatedType` wrappers.  Returns
    /// null for anything we can't safely drop field-by-field (unions, enums,
    /// arrays, primitives, unresolved generics).  Mirrors
    /// drop_insertion::aggregate_type_of so both passes agree on which owners
    /// admit a partial move.
    aggregate_type_of(&this, ty: TypeRef) -> Type* {
        if (!ty.is_valid() || this.arena == null) { return null as Type*; }
        mut cur: TypeRef = ty;
        mut t: Type* = this.arena.lookup(cur.id);
        mut guard: i32 = 0;
        while (t != null && t.kind == TypeKind::InstantiatedType && guard < 16) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (!inst.has_resolved_type()) { return null as Type*; }
            cur = inst.resolved_type;
            t = this.arena.lookup(cur.id);
            guard = guard + 1;
        }
        if (t == null) { return null as Type*; }
        if (t.kind == TypeKind::Struct) {
            const st: StructType* = t as StructType*;
            if (st.is_union) { return null as Type*; }
            return t;
        }
        if (t.kind == TypeKind::Class) { return t; }
        return null as Type*;
    }

    /// v1 allow-rule for a field-move-out `ma` (`p.field`): permit (and track)
    /// it ONLY when the owner is a straight-line bare local of a non-`Drop`
    /// struct/class value.  Anything else keeps the conservative E0453.
    partial_move_allowed(&this, ma: MemberAccessNode*) -> boolean {
        // Unconditional only: drop-skip without per-field flags is sound only
        // for a definitely-moved field.
        if (this.branch_depth != 0) { return false; }
        if (ma.object == null || ma.object.kind != NodeKind::Identifier) {
            return false;
        }
        const id: IdentifierNode* = ma.object as IdentifierNode*;
        // Must be a real `let`/param local (in the types map); pattern payload
        // bindings are excluded (their subject-glue-suppression is whole-payload
        // only), so their field moves stay rejected.
        const decl_ty: TypeRef = this.lookup_type(id.name);
        if (!decl_ty.is_valid()) { return false; }
        if (this.is_pat_binding(id.name.id)) { return false; }
        // Owned value place (not a borrow), non-`Drop`, and a struct/class whose
        // fields we can drop individually.
        if (this.is_ptr_or_ref(decl_ty)) { return false; }
        if (this.has_user_drop(decl_ty)) { return false; }
        if (this.aggregate_type_of(decl_ty) == null) { return false; }
        return true;
    }

    emit_double_field_move(mut &this, ma: MemberAccessNode*) -> void {
        const field: string = this.intern.resolve(ma.member);
        const headline: string = format(
            "field '%s' moved out of a value more than once", field);
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0452_USE_AFTER_MOVE, headline);
        diag = diag.at_with_label(ma.span,
            "this field was already moved out of the value (double free)");
        diag = diag.help(
            "a value can be moved out of a given field only once");
        this.ctx.emit_diagnostic(diag);
        this.fired += 1;
        this.fatal += 1;
    }

    /// True when `ty` is a pointer or reference: an address-sized handle
    /// that does not own its referent.  A field projected through such a
    /// handle reads heap or borrowed storage that is NOT drop-glued at
    /// THIS scope's exit, so moving it out cannot double-free here.
    is_ptr_or_ref(&this, ty: TypeRef) -> boolean {
        if (!ty.is_valid() || this.arena == null) { return false; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return false; }
        return t.kind == TypeKind::Pointer || t.kind == TypeKind::Reference;
    }

    /// True when `obj` names an owned, by-value place rooted in a local
    /// binding or parameter: a bare identifier of value type, or a field
    /// projection in which EVERY link is value-typed (no pointer/reference
    /// deref anywhere in the chain).  Such a place is drop-glued at scope
    /// exit, so moving a non-Copy field out of it double-frees.  A chain
    /// that passes through a pointer or reference - `node.value` with
    /// `node: HashNode*`, or `this.x` behind `&this` - points at heap or
    /// borrowed storage whose drop is managed elsewhere, not synthesized
    /// here, and is left alone (no false-positive rejection).
    is_owned_value_place(&this, obj: ExpressionNode*) -> boolean {
        if (obj == null) { return false; }
        if (obj.kind == NodeKind::Identifier) {
            // Key off the binding's DECLARED type, not the node's
            // resolved type: inside a `&this` / `mut &this` method the
            // `this` identifier (and any `&T` parameter) is auto-deref'd
            // to its value type at the use site, but the binding itself is
            // a Reference - a borrow we don't drop here.  A binding absent
            // from the local map (global, function name) isn't a
            // scope-glued local either.
            const id: IdentifierNode* = obj as IdentifierNode*;
            const decl_ty: TypeRef = this.lookup_type(id.name);
            if (decl_ty.is_valid()) {
                return !this.is_ptr_or_ref(decl_ty);
            }
            // Not a `let`/param local.  An enum/match PATTERN payload binding
            // (`Some(pair) => ...`) is a by-value owned place too - it was
            // moved out of the drop-glued subject - but it never entered the
            // `types` map (see `pat_binding_keys`).  Pattern bindings carry no
            // `&this` auto-deref subtlety, so the node's resolved type is the
            // binding's own type: value => owned place, ptr/ref => a borrow.
            if (this.is_pat_binding(id.name.id)) {
                return !this.is_ptr_or_ref(obj.resolved_type);
            }
            return false;
        }
        if (obj.kind == NodeKind::MemberAccess) {
            // An intermediate field that is itself a pointer/reference
            // derefs into heap or borrowed storage managed elsewhere.
            if (this.is_ptr_or_ref(obj.resolved_type)) { return false; }
            return this.is_owned_value_place((obj as MemberAccessNode*).object);
        }
        // Array elements, call results, casts, temporaries: not a simple
        // owned-value place we can prove is glue-dropped at this scope.
        return false;
    }

    /// Reject moving a non-Copy field out of an owned, drop-glued value.
    ///
    /// `mut x: String = h.name;` (and the `return` / assignment-RHS /
    /// aggregate-literal forms) bitwise-copies the field's owning handle
    /// into an independently dropped place.  Because `h` still owns
    /// `name`, `h`'s scope-exit drop glue ALSO drops `name` - the same
    /// heap pointer freed twice.  Cryo has no partial-move tracking, so
    /// this is a hard error (E0453) rather than the silent heap
    /// corruption it produced before.  The escape hatch is
    /// `core::mem::swap` (leave the field a valid value to be dropped in
    /// place) or a `Copy` field type.  Moving a field out THROUGH a
    /// pointer/reference (heap or borrowed storage) is the caller's to
    /// manage and is deliberately allowed - see `is_owned_value_place`.
    check_field_move_out(mut &this, expr: ExpressionNode*) -> void {
        if (expr == null || expr.kind != NodeKind::MemberAccess) { return; }
        const ma: MemberAccessNode* = expr as MemberAccessNode*;
        if (ma.object == null) { return; }
        // The projected field must itself own a resource.  A Copy field is
        // bitwise-independent of the source and safe to duplicate.
        const field_ty: TypeRef = expr.resolved_type;
        if (!field_ty.is_valid() || this.is_copy(field_ty)) { return; }
        // The source must be an owned, glue-dropped value place.
        if (!this.is_owned_value_place(ma.object)) { return; }
        // Partial-move model ("allow + track" half): a non-Copy *droppable*
        // field moved out of a straight-line, non-`Drop` owned local is
        // ALLOWED and recorded, so drop_insertion skips exactly this field at
        // the owner's scope exit (per-field glue makes that sound).  Every
        // other shape - `Drop` owner, in-branch (conditional) move, pattern
        // binding, non-droppable non-Copy field - keeps the hard E0453.
        if (this.type_needs_drop(field_ty) && this.partial_move_allowed(ma)) {
            const owner_id: u32 = (ma.object as IdentifierNode*).name.id;
            const field_id: u32 = ma.member.id;
            if (this.pm_has(owner_id, field_id)) {
                // Moving the SAME field out twice is a double free.
                if (!this.suppress_emit) { this.emit_double_field_move(ma); }
                return;
            }
            this.pm_binding.push(owner_id);
            this.pm_field.push(field_id);
            return;
        }
        this.emit_move_out_error(ma);
    }

    /// Apply the storage-duplicating move-out rules to a `match` subject.
    ///
    /// The subject is evaluated into a drop-glued temporary before any arm
    /// runs, so a subject that PROJECTS out of an owned place - `p.0`,
    /// `arr[i]`, `*ptr` - hands the same owning handle to two owners: that
    /// temporary and the source's own scope-exit glue. The value is then freed
    /// twice. This is the identical hazard `walk_expr_move`'s `real` positions
    /// (let-init, assignment RHS, aggregate-literal field) already reject, and
    /// the assignment spelling of the very same projection IS rejected - only
    /// the `match` spelling reached the arms unchecked, where it built cleanly
    /// and corrupted the heap at runtime.
    ///
    /// NOT gated on an arm binding the payload. The copy into the temporary
    /// happens whether or not a pattern names it, so `Some(_)` double-frees
    /// exactly like `Some(v)`.
    ///
    /// This restores an asymmetry rather than inventing a rule: DropInsertion
    /// already hoists an owning non-identifier subject into a synthesized local
    /// and walks it in MOVE context ("it's the rvalue init",
    /// `hoist_match_subject`), which is what classifies it for the partial-move
    /// drop-skip. The two passes MUST agree on that set - a divergence is a
    /// double free or a leak - and only this side was reading the subject as a
    /// plain read.
    ///
    /// Only the PROJECTION checks run, deliberately. Walking the subject as a
    /// full move would mark a bare identifier subject Moved, and `match (x)`
    /// does not consume `x` for every later use.
    check_subject_move_out(mut &this, subject: ExpressionNode*) -> void {
        if (subject == null) { return; }
        this.check_field_move_out(subject);
        this.check_deref_move_out(subject);
        this.check_array_move_out(subject);
        this.check_array_field_move_out(subject);
    }

    /// Reject a by-value read of `*p` when the pointee owns a destructor.
    ///
    /// `consume(*p)`, `const x: T = *p;` and `return *p;` bitwise-copy the
    /// pointee into an independently-dropped place while whoever owns the
    /// storage `p` names keeps its own claim on it, so the value's destructor
    /// runs twice.  Nothing in the type system records that the copy aliases,
    /// so this is silent: measured on a three-line reduction, one value with a
    /// destructor is freed twice for every shape of pointer (a parameter
    /// pointing at caller storage, a pointer to a local in the same frame, and
    /// a deref bound to a local).
    ///
    /// Cryo has no lifetimes, so the pointer carries no record of who owns the
    /// storage it names; the pass cannot tell a take (the owner is finished
    /// with it, or is about to be overwritten) from a copy (the owner will
    /// still drop it), and the two are spelled identically.  That judgement
    /// belongs to the programmer, and `unsafe` is where they make it: inside
    /// one, this rule stands down and the destructive read is written plainly
    /// as `*p`.  The block is the right granularity because the argument for
    /// soundness usually spans more than the read - in `mem::swap` it is the
    /// store that immediately replaces what was taken.
    ///
    /// Only reached from a storage-duplicating (`real`) position, so a borrow
    /// - `p.field`, `p.method()`, `&*p`, an argument bound to a `&T`/`T*`
    /// parameter - never gets here.  That gate is exactly why argument
    /// classification had to become sound first: while a `T*` parameter still
    /// looked like a by-value transfer, this rule fired on arguments the callee
    /// never takes.
    check_deref_move_out(mut &this, expr: ExpressionNode*) -> void {
        if (this.unsafe_depth > 0) { return; }
        if (expr == null || expr.kind != NodeKind::UnaryExpression) { return; }
        if (this.arg_binding_unknown) { return; }
        const u: UnaryExprNode* = expr as UnaryExprNode*;
        if (u.is_postfix || u.op.lexeme != "*") { return; }
        if (u.operand == null) { return; }
        // Only a pointee that owns a resource can be freed twice.  A Copy or
        // non-droppable pointee is bitwise-independent of the source.
        const pointee_ty: TypeRef = expr.resolved_type;
        if (!pointee_ty.is_valid() || this.is_copy(pointee_ty)) { return; }
        if (!this.type_needs_drop(pointee_ty)) { return; }
        if (this.suppress_emit) { return; }
        this.emit_deref_move_out_error(u);
    }

    emit_deref_move_out_error(mut &this, u: UnaryExprNode*) -> void {
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0453_DOUBLE_FREE,
            "cannot move a value that owns a destructor out of a pointer");
        diag = diag.at_with_label(u.span,
            "reading the pointee by value copies its owning handle; the storage this points at is still dropped by its owner (double free)");
        diag = diag.help(
            "borrow it instead (`p.field`, `p.method()`), or clone it; if this really is a take - the storage is yours to empty, or you overwrite it straight after - say so with an `unsafe` block around the sequence that makes it sound");
        this.ctx.emit_diagnostic(diag);
        this.fired += 1;
        this.fatal += 1;
    }

    emit_move_out_error(mut &this, ma: MemberAccessNode*) -> void {
        const field: string = this.intern.resolve(ma.member);
        const headline: string = format(
            "cannot move field '%s' out of a value that owns a destructor", field);
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0453_DOUBLE_FREE, headline);
        diag = diag.at_with_label(ma.span,
            "moving this field out leaves the source to drop it again at scope exit (double free)");
        diag = diag.help(
            "swap the field out with `core::mem::swap`, leaving a valid value to be dropped in place; or use a `Copy` field type");
        this.ctx.emit_diagnostic(diag);
        this.fired += 1;
        this.fatal += 1;
    }

    /// Reject a value-copy of a droppable element out of an owning array.
    ///
    /// `const x: T = arr[i];` (and the return / assignment-RHS /
    /// aggregate-literal forms) bitwise-copies the element's owning handle
    /// into an independently-dropped place while the array keeps owning the
    /// same element, so the buffer is freed twice at scope exit.  Cryo has
    /// no partial-move tracking for arrays, so this is a hard error (E0453);
    /// borrow the element instead (`const x: &T = &arr[i];`) or, when an
    /// owned copy is genuinely needed, clone it.  Indexing a raw pointer
    /// (`ptr[i]`, where `ptr: T*`) is borrowed/heap storage the caller
    /// manages and is deliberately allowed - mirrors `is_owned_value_place`.
    check_array_move_out(mut &this, expr: ExpressionNode*) -> void {
        if (expr == null || expr.kind != NodeKind::ArrayAccess) { return; }
        const aa: ArrayAccessNode* = expr as ArrayAccessNode*;
        if (aa.array == null) { return; }
        // Only a droppable element double-frees; Copy / non-owning elements
        // are bitwise-independent of the array and safe to duplicate.
        const elem_ty: TypeRef = expr.resolved_type;
        if (!elem_ty.is_valid() || !this.type_needs_drop(elem_ty)) { return; }
        // The indexed operand must be an owning array value (`T[]`/`Array<T>`),
        // not a raw-pointer deref the caller is responsible for.
        const arr_ty: TypeRef = aa.array.resolved_type;
        if (!arr_ty.is_valid() || this.is_ptr_or_ref(arr_ty)) { return; }
        this.emit_array_move_out_error(aa);
    }

    emit_array_move_out_error(mut &this, aa: ArrayAccessNode*) -> void {
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0453_DOUBLE_FREE,
            "cannot move an element out of an array that owns a destructor");
        diag = diag.at_with_label(aa.span,
            "copying this element out leaves the array to drop it again at scope exit (double free)");
        diag = diag.help(
            "borrow the element instead (`const x: &T = &arr[i];`); or clone it when an owned copy is required");
        this.ctx.emit_diagnostic(diag);
        this.fired += 1;
        this.fatal += 1;
    }

    /// Reject a value-copy of a whole owning array (`T[]`) out of a struct
    /// FIELD reached through a pointer/reference (`x = node.fields`,
    /// `f(node.fields)`).  `check_field_move_out` already catches the
    /// owned-value-place form; this covers the through-pointer form, which it
    /// deliberately skips.  The buffer is owned by the struct regardless of
    /// how it's reached, so the bitwise-copied handle is freed twice.  Borrow
    /// it (`&node.fields`) or clone it.
    check_array_field_move_out(mut &this, expr: ExpressionNode*) -> void {
        if (expr == null || expr.kind != NodeKind::MemberAccess) { return; }
        const ma: MemberAccessNode* = expr as MemberAccessNode*;
        if (ma.object == null) { return; }
        const field_ty: TypeRef = expr.resolved_type;
        if (!field_ty.is_valid()) { return; }
        const t: Type* = this.arena.lookup(field_ty.id);
        if (t == null || t.kind != TypeKind::Array) { return; }
        // Only an owning (droppable) array buffer double-frees on copy.
        if (!this.type_needs_drop(field_ty)) { return; }
        // The owned-value-place form is already handled by
        // `check_field_move_out`; don't double-report it.
        if (this.is_owned_value_place(ma.object)) { return; }
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0453_DOUBLE_FREE,
            "cannot move an owning array out of a value that owns a destructor");
        diag = diag.at_with_label(ma.span,
            "copying this array field out aliases the buffer the source still owns (double free)");
        diag = diag.help(
            "borrow it (`const x: &T[] = &place.field;`) or clone it when an owned copy is required");
        this.ctx.emit_diagnostic(diag);
        this.fired += 1;
        this.fatal += 1;
    }

    handle_ident(mut &this, ident: IdentifierNode*, in_move_context: boolean,
                 real: boolean) -> void {
        if (ident == null) { return; }
        const name: SymbolStr = ident.name;
        const ty: TypeRef = this.lookup_type(name);
        if (!ty.is_valid()) { return; }
        const _is_copy: boolean = this.is_copy(ty);
        const _is_moved: boolean = this.is_moved(name);
        cdebug("[MoveCheck:ident] '%s' ty.id=%llu is_copy=%d is_moved=%d in_move=%d\n",
            this.intern.resolve(name), ty.id, _is_copy as i32,
            _is_moved as i32, in_move_context as i32);
        if (_is_copy) { return; }

        // A whole by-value move of an aggregate that already has a field moved
        // out of it is a partial-move violation: the value has a hole and
        // cannot be moved/consumed as a unit.  Reads/borrows (`&p`, `p.other`)
        // stay fine; only a real move (`real`) is rejected.
        if (in_move_context && real && this.pm_has_binding(name.id)) {
            if (!this.suppress_emit) {
                const headline: string = format(
                    "use of partially-moved value '%s'", this.intern.resolve(name));
                mut diag: Diagnostic = Diagnostic::error(
                    ErrorCode::E0452_USE_AFTER_MOVE, headline);
                diag = diag.at_with_label(ident.span,
                    "value moved here after one of its fields was already moved out");
                diag = diag.help(
                    "a value with a moved-out field cannot be moved or consumed as a whole");
                this.ctx.emit_diagnostic(diag);
                this.fired += 1;
                this.fatal += 1;
            }
            return;
        }

        if (this.is_moved(name)) {
            // A real move site re-reading an already-moved binding upgrades
            // it (borrow-then-move), even when emission is suppressed.
            if (in_move_context && real) { this.mark_moved(name, ident.span, true); }
            if (this.suppress_emit) { return; }
            if (this.is_carried(name)) {
                // Moved on a previous iteration of the enclosing loop.
                this.emit_loop_carried(name, ident.span);
                return;
            }
            const move_span: SourceSpan = this.moved_at_span(name);
            const headline: string = format("use of moved value '%s'",
                this.intern.resolve(name));
            this.emit_use_after_move(ErrorCode::E0452_USE_AFTER_MOVE,
                headline, ident.span, move_span);
            return;
        }
        if (in_move_context) {
            this.mark_moved(name, ident.span, real);
        }
    }
}


type struct MoveCheckPass {
    static run(ctx: CompilationContext*) -> PassResult {
        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) { return PassResult::ok(); }
        mut checker: MoveChecker = MoveChecker::new(ctx);
        checker.walk_program(root);
        if (ctx.debug_mode) {
            cdebug("[MoveCheck] %lld diagnostics emitted (%lld fatal)\n",
                checker.fired, checker.fatal);
        }
        // Both within-iteration use-after-move and loop-carried moves are
        // unambiguous double frees and increment `fatal`: fail the pass so
        // the pipeline aborts before codegen (MoveCheck is
        // fatal_on_failure).
        if (checker.fatal > 0) {
            return PassResult::failure(checker.fatal as u32);
        }
        return PassResult::ok();
    }
}
