///! Drop Insertion Pass.
///!
///! Runs after MoveCheck and before TypeLowering.  Performs flow-sensitive
///! ownership analysis with proper branch-join semantics:
///! - `if`/`match`: definitely-moved is the intersection of the per-branch
///!   moved-sets, possibly-moved is the symmetric difference.  Diverging
///!   branches (those that always `return`/`break`/`continue`) are
///!   excluded from the join; their moves don't escape.
///! - Possibly-moved bindings get a synthesized `mut <name>__dropflag:
///!   boolean = false;` hoisted before the branching statement.  Each
///!   moving arm is augmented with `<flag> = true;`, and the binding's
///!   scope-exit drop is wrapped in `if (!<flag>) { binding.drop(); }`.
///!   This is the classic "drop flag" technique: the not-moved path
///!   drops correctly, the moved path skips the drop, and LLVM's
///!   default O2 pipeline folds the flag away when the move state can
///!   be proven statically.  See `merge_branches_if` and
///!   `synth_flag_for_match_arms`.
///! - Loop bodies snapshot/restore: body-internal moves don't propagate
///!   to the post-loop state.  Loop-carried moves are detected by
///!   MoveCheck (which is fatal_on_failure) before this pass runs, so
///!   we don't need fixed-point dataflow inside the loop body here.
///!
///! ## Synthesis
///!
///! The pass synthesizes `binding.drop();` calls at every scope-exit
///! point (normal fall-through and explicit early-exits) for every
///! live, non-Copy local declared in that scope, in reverse
///! declaration order.  Move-checked bindings are skipped, as are
///! types without a `Drop` impl (inherent or trait).
///!
///! Consumption tracking covers three patterns:
///!   - explicit `.drop()` calls,
///!   - by-value receivers (`mut this` / `this`),
///!   - `![sink]`-tagged `&this` methods (e.g. `Box::into_raw`).
///!
///! All three mark the receiver as moved so synthesis skips it at the
///! enclosing scope's exit.  See `types/ownership.cryo`'s
///! `method_consumes_receiver` for the directive plumbing.

namespace Compiler::Passes::DropInsertion;

import Compiler::Diag;
import Compiler::Diag::Snapshot;
import Compiler::Diag::Sink;
import Compiler::Diag::SourceSpan;
import Compiler::Diag::Diagnostic;
import Compiler::AST;
import Compiler::AST::Node;
import Compiler::AST::Expression;
import Compiler::AST::Statement;
import Compiler::AST::Declaration;
import Compiler::AST::Pattern;
import Compiler::Passes::PassID;
import Compiler::CompilationContext;
import Compiler::Resolver::SymbolStr;
import Compiler::Resolver::InternTable;
import Compiler::Types;
import Compiler::Types::Arena;
import Compiler::Types::TypeRef;
import Compiler::Types::Type;
import Compiler::Types::GenericRegistry;
import Compiler::Types::Ownership;
import std::core::option;
import std::collections::hashmap;


type struct DropInserter {
    ctx:      CompilationContext*;
    arena:    TypeArena*;
    registry: GenericRegistry*;
    intern:   InternTable*;

    /// Cached `drop` symbol id, used when matching method calls and
    /// synthesizing new ones.
    drop_sym: SymbolStr;

    /// Per-binding type info for live bindings.  Entries are added on
    /// `let` and conceptually removed when the declaring scope is
    /// popped.  Stored as parallel arrays rather than a HashMap so
    /// pop-scope can truncate by length (O(1) array-length checkpoint).
    /// HashMap::remove was rewritten with a cursor idiom in stdlib
    /// (fixing the historical chain-corruption bug); however parallel
    /// arrays remain preferable here because scope-pop removes a
    /// contiguous suffix by index, not individual keys; a pattern
    /// that maps naturally onto array truncation.
    /// Linear search is fine for typical function sizes.
    types_keys:  u32[];
    types_refs:  TypeRef[];

    /// Flat scope stack: `binding_*` arrays hold every binding in
    /// every live scope, and `scope_start_idx[i]` is the offset where
    /// scope `i` begins.  Pop-scope truncates the binding arrays back
    /// to that offset.  Innermost scope is `scope_start_idx.length - 1`.
    scope_start_idx: i64[];
    binding_names:   u32[];
    binding_types:   TypeRef[];
    binding_spans:   SourceSpan[];

    /// Stack of "loop boundary depths".  When walk_while/walk_for/
    /// walk_loop is processing a loop body, the current scope_stack
    /// length at entry is pushed here; `break`/`continue` then know to
    /// limit cumulative drops to scopes at index >= top-of-stack.
    /// Without this, a break would drop bindings declared OUTSIDE the
    /// loop, which are still live after the loop exits.
    loop_boundary: i64[];

    /// Moved-set on the current control-flow path, encoded the same way
    /// as MoveCheck: parallel-array (key, line) so snapshot/restore is
    /// just an array-length checkpoint.  Branch-join builds a snapshot,
    /// walks each branch independently, and merges via intersection.
    moved_keys:  u32[];
    moved_lines: i32[];

    /// Payload-binding -> owning-subject links, active only while walking a
    /// match's arms.  When a match payload binding (e.g. `s` in
    /// `match (opt) { Some(s) => ... }`) is marked moved (consumed), its
    /// linked subject (`opt`) is marked moved too - so an early `return`
    /// inside the arm doesn't drop the subject whose payload the arm just
    /// released (drop glue would double-free it).  Parallel arrays keyed by
    /// SymbolStr id; pushed by register_arm_pattern_bindings, popped by
    /// check_and_unregister_arm_bindings.
    link_payload: u32[];
    link_subject: u32[];

    /// Conditional-move drop flags: a binding moved on some control-flow
    /// paths but not others gets a synthesized `mut <name>__dropflag:
    /// boolean = false;` hoisted before the branching statement, plus a
    /// `<flag> = true;` appended to every moving arm.  At scope exit the
    /// binding's drop is wrapped in `if (!<flag>) { ... }` so it runs on
    /// the not-moved path and is skipped on the moved path - the
    /// canonical "drop flag" technique.  Parallel arrays keyed by
    /// SymbolStr id: `flag_binding_keys[i]` is the owning binding's name
    /// id, `flag_flag_keys[i]` is the synthesized boolean local's name
    /// id.  Lookup is linear; functions rarely have many conditional
    /// moves, so the array is short.
    flag_binding_keys: u32[];
    flag_flag_keys:    u32[];

    /// Monotonic counter for naming synthesized drop-flag locals (avoid
    /// clashing with anything the user wrote or with other synthetic
    /// names from this pass).
    flag_seq: i64;

    fired:        i64;
    inserted:     i64;

    /// Monotonic counter for naming hidden locals synthesized to hold and
    /// drop discarded owning temporaries (see emit_discarded_temp_drop).
    discard_seq:  i64;

    static new(ctx: CompilationContext*) -> DropInserter {
        return DropInserter {
            ctx:             ctx,
            arena:           ctx.type_arena,
            registry:        ctx.generic_registry,
            intern:          ctx.get_intern_table(),
            drop_sym:        ctx.get_intern_table().intern("drop"),
            types_keys:      [],
            types_refs:      [],
            scope_start_idx: [],
            binding_names:   [],
            binding_types:   [],
            binding_spans:   [],
            loop_boundary:   [],
            moved_keys:      [],
            moved_lines:     [],
            link_payload:    [],
            link_subject:    [],
            flag_binding_keys: [],
            flag_flag_keys:    [],
            flag_seq:        0,
            fired:           0,
            inserted:        0,
            discard_seq:     0,
        };
    }

    // ---- scope management ------------------------------------------------

    push_scope(mut &this) -> void {
        this.scope_start_idx.push(this.binding_names.length);
    }

    pop_scope(mut &this) -> void {
        const top: i64 = this.scope_start_idx.length;
        if (top == 0) { return; }
        // Read by index then truncate via pop(). Binding an Option payload
        // through a match arm into a `mut` outer variable currently fails
        // to lower (E0614: rvalue null). Read-then-truncate sidesteps the
        // pattern entirely.
        const start: i64 = this.scope_start_idx[top - 1];
        this.scope_start_idx.pop();
        // Bindings declared in this scope go out of lexical scope;
        // truncate them out of types_* and binding_*.  We assume
        // bindings are pushed onto types_* in the same order as
        // binding_*, which holds because register_binding is the only
        // mutator and adds to both arrays in lock-step.
        while (this.binding_names.length > start) {
            this.binding_names.pop();
            this.binding_types.pop();
            this.binding_spans.pop();
            this.types_keys.pop();
            this.types_refs.pop();
        }
    }

    /// Start offset of the innermost (top) scope.
    top_scope_start(&this) -> i64 {
        if (this.scope_start_idx.length == 0) { return 0; }
        return this.scope_start_idx[this.scope_start_idx.length - 1];
    }

    register_binding(mut &this, name: SymbolStr, ty: TypeRef, span: SourceSpan) -> void {
        if (!name.is_valid()) { return; }
        // A freshly declared binding starts live. The moved-set is keyed by
        // intern name id and `pop_scope` does NOT clear it, so a sibling
        // scope that reuses a name moved in an earlier (now-popped) scope
        // would inherit that stale move and never be dropped - a leak.
        // Clear the stale entry here so the new binding is droppable again.
        //
        // Guard on "no other live binding of this name": when this
        // declaration shadows a still-live OUTER binding, the move-set entry
        // may belong to that outer binding (name-keying can't tell them
        // apart), and reviving it would let an already-moved outer be
        // dropped - a double-free. In that case we keep the move recorded
        // and accept that the inner shadow may leak (fail-safe under-drop,
        // consistent with the rest of this pass).
        if (!this.name_is_live(name)) {
            this.unmark_moved(name);
        }
        this.types_keys.push(name.id);
        this.types_refs.push(ty);
        this.binding_names.push(name.id);
        this.binding_types.push(ty);
        this.binding_spans.push(span);
    }

    /// Same as register_binding but stores a type-only entry (no
    /// scope_stack push).  Used for function parameters, which aren't
    /// auto-dropped at function exit but should still resolve via
    /// lookup_type for use-after-move analysis.
    register_param_type(mut &this, name: SymbolStr, ty: TypeRef) -> void {
        if (!name.is_valid()) { return; }
        this.types_keys.push(name.id);
        this.types_refs.push(ty);
    }

    // ---- move tracking ---------------------------------------------------

    is_moved(&this, name: SymbolStr) -> boolean {
        if (!name.is_valid()) { return false; }
        for (mut i: i64 = 0; i < this.moved_keys.length; i++) {
            if (this.moved_keys[i] == name.id) { return true; }
        }
        return false;
    }

    is_moved_id(&this, key: u32) -> boolean {
        for (mut i: i64 = 0; i < this.moved_keys.length; i++) {
            if (this.moved_keys[i] == key) { return true; }
        }
        return false;
    }

    moved_at_line(&this, name: SymbolStr) -> i32 {
        for (mut i: i64 = 0; i < this.moved_keys.length; i++) {
            if (this.moved_keys[i] == name.id) { return this.moved_lines[i]; }
        }
        return 0;
    }

    mark_moved(mut &this, name: SymbolStr, span: SourceSpan) -> void {
        if (!name.is_valid()) { return; }
        if (this.is_moved(name)) { return; }
        this.moved_keys.push(name.id);
        this.moved_lines.push(span.start_line as i32);
        // Propagate to a linked match subject: consuming a payload binding
        // moves-from the subject it was extracted from, so the subject's glue
        // must not also drop that payload.  Bounded recursion handles nested
        // matches (a subject that is itself an outer match's payload).
        for (mut i: i64 = 0; i < this.link_payload.length; i++) {
            if (this.link_payload[i] == name.id) {
                this.mark_moved(SymbolStr::from_id(this.link_subject[i]), span);
            }
        }
    }

    /// True if a binding with `name` is currently live (registered in an
    /// as-yet-unpopped scope). Lets `register_binding` distinguish a fresh
    /// re-declaration (clear stale move state) from one that shadows a live
    /// outer binding (keep it; see register_binding).
    name_is_live(&this, name: SymbolStr) -> boolean {
        if (!name.is_valid()) { return false; }
        for (mut i: i64 = 0; i < this.binding_names.length; i++) {
            if (this.binding_names[i] == name.id) { return true; }
        }
        return false;
    }

    /// Clear move state for `name`. Length-preserving: matched slots are
    /// tombstoned with id 0 (the reserved invalid SymbolStr id, never a
    /// real binding name) rather than removed. This keeps the array-length
    /// checkpoints used by snapshot_moves/restore_moves and the branch-join
    /// (moves_since_keys/set_moves_tail) exactly valid; is_moved_id and
    /// binding_in_outer_scope are only ever queried with valid ids, so a 0
    /// tombstone is inert.
    unmark_moved(mut &this, name: SymbolStr) -> void {
        if (!name.is_valid()) { return; }
        for (mut i: i64 = 0; i < this.moved_keys.length; i++) {
            if (this.moved_keys[i] == name.id) {
                this.moved_keys[i] = 0;
            }
        }
    }

    snapshot_moves(&this) -> i64 {
        return this.moved_keys.length;
    }

    /// Truncate the moved-set back to a saved length.  Used by loop
    /// bodies (Phase 1 doesn't propagate body-internal moves to the
    /// post-loop state) and as part of branch-join.
    restore_moves(mut &this, checkpoint: i64) -> void {
        while (this.moved_keys.length > checkpoint) {
            this.moved_keys.pop();
            this.moved_lines.pop();
        }
    }

    /// Return the keys moved between [snapshot..len), in order.
    moves_since_keys(&this, snapshot: i64) -> u32[] {
        mut out: u32[] = [];
        for (mut i: i64 = snapshot; i < this.moved_keys.length; i++) {
            out.push(this.moved_keys[i]);
        }
        return out;
    }

    moves_since_lines(&this, snapshot: i64) -> i32[] {
        mut out: i32[] = [];
        for (mut i: i64 = snapshot; i < this.moved_keys.length; i++) {
            out.push(this.moved_lines[i]);
        }
        return out;
    }

    /// Replace the moved-set tail (after `snapshot`) with the given keys.
    set_moves_tail(mut &this, snapshot: i64, keys: u32[], lines: i32[]) -> void {
        this.restore_moves(snapshot);
        for (mut i: i64 = 0; i < keys.length; i++) {
            this.moved_keys.push(keys[i]);
            this.moved_lines.push(lines[i]);
        }
    }

    // ---- type queries ----------------------------------------------------

    is_copy(&this, ty: TypeRef) -> boolean {
        return OwnershipQuery::is_copy(this.arena, this.registry, this.intern, ty);
    }

    lookup_type(&this, name: SymbolStr) -> TypeRef {
        if (!name.is_valid()) { return TypeRef::invalid(); }
        // Walk in reverse so an inner-scope shadow wins over an outer
        // binding of the same name (rare in Cryo, but possible in
        // pattern arms).
        for (mut i: i64 = this.types_keys.length - 1; i >= 0; i--) {
            if (this.types_keys[i] == name.id) { return this.types_refs[i]; }
        }
        return TypeRef::invalid();
    }

    // ---- diagnostics -----------------------------------------------------

    // ---- entry points ----------------------------------------------------

    walk_program(mut &this, root: ProgramNode*) -> void {
        if (root == null) { return; }
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }
            this.walk_top_level(stmt);
        }
    }

    walk_top_level(mut &this, stmt: ASTNode*) -> void {
        match (stmt.kind) {
            NodeKind::FunctionDeclaration => {
                this.walk_function(stmt as FunctionDeclNode*, null);
            }
            NodeKind::StructDeclaration => {
                this.walk_methods((stmt as StructDeclNode*).methods);
            }
            NodeKind::ClassDeclaration => {
                this.walk_methods((stmt as ClassDeclNode*).methods);
            }
            NodeKind::ImplementationBlock => {
                this.walk_methods((stmt as ImplBlockNode*).methods);
            }
            NodeKind::TraitDeclaration => {
                const td: TraitDeclNode* = stmt as TraitDeclNode*;
                for (mut i: i64 = 0; i < td.methods.length; i++) {
                    const m: FunctionDeclNode* = td.methods[i];
                    if (m != null) { this.walk_function(m, null); }
                }
            }
            _ => {}
        }
    }

    walk_methods(mut &this, methods: &MethodNode*[]) -> void {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = (*methods)[i];
            if (m == null || m.func == null) { continue; }
            this.walk_function(m.func, m);
        }
    }

    walk_function(mut &this, func: FunctionDeclNode*,
                  owner_method: MethodNode*) -> void {
        if (func == null || func.body == null) { return; }
        if (func.is_generic()) { return; }
        // Reset per-function state.
        this.types_keys      = [];
        this.types_refs      = [];
        this.scope_start_idx = [];
        this.binding_names   = [];
        this.binding_types   = [];
        this.binding_spans   = [];
        this.loop_boundary   = [];
        this.moved_keys  = [];
        this.moved_lines = [];
        this.flag_binding_keys = [];
        this.flag_flag_keys    = [];
        this.flag_seq         = 0;

        this.push_scope();
        // A by-value owning parameter is moved in at the call (the argument is
        // marked moved in the caller), so the callee owns it and drops it at
        // function exit unless it is moved out again (returned, stored, passed
        // on, or explicitly `.drop()`-ed) - the moved-set check in
        // `maybe_append_drop` handles that. Two receiver forms are excluded
        // because they do NOT transfer ownership to the callee:
        //   - `&this` / `mut &this`: a Reference type; `needs_drop` is false
        //     for references, so it's filtered at synthesis automatically.
        //   - by-value `this`: the caller keeps the receiver and drops it, so
        //     dropping it here too would double-free; excluded by name below.
        // Copy and non-droppable params fall out via the `type_needs_drop`
        // gate, exactly like locals. Params are registered before body locals,
        // so reverse-order scope-exit drops them last (after the locals).
        const this_recv: u32 = this.intern.intern("this").id;
        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const p: VarDeclNode* = func.parameters[i];
            if (p == null) { continue; }
            this.register_param_type(p.name, p.resolved_type);
            if (p.name.is_valid() && p.name.id != this_recv
                    && this.type_needs_drop(p.resolved_type)
                    && this.param_drop_well_formed(p.resolved_type)) {
                this.binding_names.push(p.name.id);
                this.binding_types.push(p.resolved_type);
                this.binding_spans.push(p.span);
            }
        }
        // A base-class constructor initializer (`MyCtor(...) : Base(arg, ...)`)
        // runs before the body and consumes its arguments into the base
        // subobject.  The init list lives on the owning MethodNode (null for
        // free functions / trait methods).  Walk each arg in move context so a
        // by-value owning param forwarded to the base (e.g.
        // `Parser(tokens) : ExprParser(tokens)`) is marked moved here -
        // otherwise it would be dropped again at this constructor's exit,
        // double-freeing the buffer the base subobject now owns.
        if (owner_method != null) {
            const base_args_len: i64 = owner_method.base_ctor_args.length;
            for (mut bi: i64 = 0; bi < base_args_len; bi++) {
                const base_arg: ExpressionNode* = owner_method.base_ctor_args[bi];
                this.walk_expr_move(base_arg);
            }
        }
        this.walk_block_body(func.body);
        this.pop_scope();
    }

    /// Walk a block, mutating its `statements` list in-place to inject
    /// synthesized `binding.drop();` calls at end of scope and before
    /// any early-exit statements (`return`, `break`, `continue`).
    /// Returns true when the block always diverges on every control-flow
    /// path through it; used by the if/match join to ignore branches
    /// that can't fall through.
    walk_block(mut &this, block: BlockStmtNode*) -> boolean {
        if (block == null) { return false; }
        this.push_scope();
        const diverges: boolean = this.walk_block_body_impl(block, false);
        this.pop_scope();
        return diverges;
    }

    /// Walk a match-*expression* arm body.  Differs from `walk_block` in
    /// two ways, both because the block's trailing expression statement is
    /// the arm's *value* (it flows out as the match result rather than
    /// being discarded):
    ///   1. that trailing expression is walked in *move* context: a bare
    ///      binding yielded from the arm (`A => { x }`) is then marked
    ///      moved, so the cross-arm join and the enclosing scope don't
    ///      also drop it (which would double-free the match result);
    ///   2. no end-of-scope drops are synthesized for the arm's own
    ///      bindings; a `let` local declared *and not yielded* in a match
    ///      arm is therefore still not auto-dropped (it leaks, exactly as
    ///      before this routing existed).  Doing that correctly needs the
    ///      drop to run *after* the value expression (which may read the
    ///      local) while keeping the value statement last for codegen's
    ///      arm-value extraction; a coordinated drop/codegen change left
    ///      as follow-up work.
    /// Early-exit statements (`return`/`break`/`continue`) inside the arm
    /// still get their cumulative drops via `walk_stmt_into`; that is the
    /// part that makes a droppable local live across `expr?` get freed on
    /// the error path.
    walk_value_block(mut &this, block: BlockStmtNode*) -> boolean {
        if (block == null) { return false; }
        this.push_scope();
        const diverges: boolean = this.walk_block_body_impl(block, true);
        this.pop_scope();
        return diverges;
    }

    /// Body of a block: assumes the caller already pushed the scope
    /// (so a function can register parameters into the same scope as
    /// the body's locals before walking).  Returns true if the block
    /// always diverges.
    walk_block_body(mut &this, block: BlockStmtNode*) -> boolean {
        return this.walk_block_body_impl(block, false);
    }

    /// Shared block-body walker.  `value_block` is true only for a
    /// match-expression arm body; see `walk_value_block` for what that
    /// changes.  For ordinary blocks (`value_block == false`) this is the
    /// original `walk_block_body` behavior unchanged.
    walk_block_body_impl(mut &this, block: BlockStmtNode*,
                         value_block: boolean) -> boolean {
        if (block == null) { return false; }
        const old_stmts: &StatementNode*[] = &block.statements;
        mut new_stmts: StatementNode*[] = [];
        mut terminated: boolean = false;

        // For a value block, find the index of the arm's value statement:
        // the last non-null statement, when it is an expression statement.
        mut value_idx: i64 = -1;
        if (value_block) {
            for (mut i: i64 = old_stmts.length - 1; i >= 0; i--) {
                if ((*old_stmts)[i] != null) {
                    if ((*old_stmts)[i].kind == NodeKind::ExpressionStatement) {
                        value_idx = i;
                    }
                    break;
                }
            }
        }

        for (mut i: i64 = 0; i < old_stmts.length; i++) {
            const stmt: StatementNode* = (*old_stmts)[i];
            if (stmt == null) { continue; }
            if (terminated) {
                // Statements after an unconditional divergence are
                // unreachable.  Drop them; the early-exit already
                // emitted its drops and there's no path here.
                continue;
            }
            if (i == value_idx) {
                // The arm's value statement.  Walk its expression in move
                // context (a yielded bare binding is then marked moved),
                // and keep the statement in place so codegen still finds
                // the arm value as the block's last statement.
                const es: ExprStmtNode* = stmt as ExprStmtNode*;
                if (es.expression != null) { this.walk_expr_move(es.expression); }
                new_stmts.push(stmt);
            } else {
                const stmt_diverges: boolean = this.walk_stmt_into(stmt, &new_stmts);
                if (stmt_diverges) { terminated = true; }
            }
        }

        // Normal fall-through: emit drops for the top scope's bindings
        // in reverse declaration order, skipping any that have already
        // been moved on this path.  Suppressed when the block was
        // unconditionally terminated (drops were already emitted right
        // before the early-exit), and for value blocks (a match-arm
        // value statement must stay last; see `walk_value_block`).
        if (!terminated && !value_block) {
            this.append_top_scope_drops(&new_stmts);
        }

        block.statements = new_stmts;
        return terminated;
    }

    /// Walk a single statement, appending it (and any synthesized drops
    /// that must precede it) to `out`.
    /// Append `stmt` and any preceding synthesized drops to `out`.
    /// Returns true if `stmt` always diverges (any path through the
    /// program reaching this point cannot fall through to the next
    /// statement in the enclosing block).
    walk_stmt_into(mut &this, stmt: StatementNode*, out: StatementNode*[]*) -> boolean {
        return match (stmt.kind) {
            NodeKind::ReturnStatement => {
                const r: ReturnStmtNode* = stmt as ReturnStmtNode*;
                if (r.expression != null) { this.walk_expr_move(r.expression); }
                // Cumulative drops across every live scope, innermost
                // first.  These cannot be emitted as preceding statements
                // because the return *expression* runs at the return-stmt
                // codegen site and may borrow one of the locals being
                // dropped (e.g. `return classify(&owned)`).  Stash on the
                // node so codegen can sequence the drops *after* the
                // expression value is materialised but before `ret`.
                this.append_cumulative_drops(&r.synth_drops);
                out.push(stmt);
                true
            }
            NodeKind::BreakStatement => {
                // Drops only the bindings inside the enclosing loop's
                // scopes.  Bindings declared OUTSIDE the loop survive
                // the `break` and continue to live in the post-loop
                // code, so they must NOT be dropped here.
                this.append_loop_exit_drops(out);
                out.push(stmt);
                true
            }
            NodeKind::ContinueStatement => {
                this.append_loop_exit_drops(out);
                out.push(stmt);
                true
            }
            NodeKind::ExpressionStatement => {
                const e: ExprStmtNode* = stmt as ExprStmtNode*;
                if (e.expression != null) { this.walk_expr_read(e.expression); }
                // A discarded owning temporary (e.g. `make_owned();` or
                // `Res { id: 1 };`) is never bound, so without this it is
                // never dropped - a leak. Materialize it into a hidden local
                // and drop it at statement end. Consuming forms whose result
                // is void/Copy (e.g. `x.drop();`, `consume(a);`) fail the
                // owning-type gate and pass through unchanged; the receiver/
                // argument moves were already recorded by walk_expr_read.
                if (e.expression != null
                        && this.discarded_owning_temp(e.expression)) {
                    this.emit_discarded_temp_drop(e.expression, out, stmt.span);
                } else {
                    out.push(stmt);
                }
                false
            }
            NodeKind::DeclarationStatement => {
                const ds: DeclStmtNode* = stmt as DeclStmtNode*;
                if (ds.declaration != null) {
                    if (ds.declaration.kind == NodeKind::VariableDeclaration) {
                        this.walk_var_decl(ds.declaration as VarDeclNode*);
                    } else if (ds.declaration.kind == NodeKind::DestructureDeclaration) {
                        this.walk_destructure_decl(ds.declaration as DestructureDeclNode*);
                    }
                }
                out.push(stmt);
                false
            }
            NodeKind::BlockStatement => {
                const d: boolean = this.walk_block(stmt as BlockStmtNode*);
                out.push(stmt);
                d
            }
            NodeKind::UnsafeBlockStatement => {
                const u: UnsafeBlockStmtNode* = stmt as UnsafeBlockStmtNode*;
                mut d: boolean = false;
                if (u.block != null) { d = this.walk_block(u.block); }
                out.push(stmt);
                d
            }
            NodeKind::IfStatement => {
                // Pass `out` so walk_if can hoist drop-flag declarations
                // for conditionally-moved bindings BEFORE the if-stmt.
                const d: boolean = this.walk_if(stmt as IfStmtNode*, out);
                out.push(stmt);
                d
            }
            NodeKind::WhileStatement => {
                this.walk_while(stmt as WhileStmtNode*);
                out.push(stmt);
                false
            }
            NodeKind::DoWhileStatement => {
                this.walk_do_while(stmt as DoWhileStmtNode*);
                out.push(stmt);
                false
            }
            NodeKind::ForStatement => {
                this.walk_for(stmt as ForStmtNode*);
                out.push(stmt);
                false
            }
            NodeKind::LoopStatement => {
                this.walk_loop(stmt as LoopStmtNode*);
                out.push(stmt);
                false
            }
            NodeKind::MatchStatement => {
                // If the subject is a non-Identifier rvalue of owning type
                // (e.g. `match (compute()) { ... }`), the temporary holding
                // the subject value is invisible to the binding/scope-exit
                // drop machinery - match-arm consumption tracking only kicks
                // in when subject.kind == Identifier (see walk_match_arms).
                // Hoist the subject into a synthesized local declared just
                // before the match so its scope-exit drop fires through the
                // normal binding path, and the match itself sees an Identifier
                // subject (engaging consumption tracking + drop-glue
                // suppression for arms that move the payload out).
                const m: MatchStmtNode* = stmt as MatchStmtNode*;
                if (m != null && m.subject != null &&
                    m.subject.kind != NodeKind::Identifier &&
                    this.type_needs_drop(m.subject.resolved_type)) {
                    this.hoist_match_subject(m, out);
                }
                const d: boolean = this.walk_match(m, out);
                out.push(stmt);
                d
            }
            NodeKind::SwitchStatement => {
                // Walk the case bodies so owned locals inside them are dropped
                // (they previously leaked) and outer-binding moves are tracked.
                const d: boolean = this.walk_switch(stmt as SwitchStmtNode*);
                out.push(stmt);
                d
            }
            // CaseStatement and any other shapes pass through.
            _ => {
                out.push(stmt);
                false
            }
        };
    }

    walk_var_decl(mut &this, vd: VarDeclNode*) -> void {
        if (vd == null) { return; }
        if (vd.initializer != null) {
            this.walk_expr_move(vd.initializer);
        }
        // A capture-alias binding (synthesized shadow inside a `move`
        // lambda's __call__) doesn't own its value - the closure struct's
        // Drop releases the underlying field.  Skip register_binding so
        // no scope-exit drop is emitted; without this gate, every
        // `__call__` invocation would drop the captured value on return.
        if (vd.is_capture_alias) { return; }
        if (!vd.is_global) {
            this.register_binding(vd.name, vd.resolved_type, vd.span);
        }
    }

    /// Destructure declaration: consumes the RHS (sema enforces "all fields
    /// bound" via E0362, so by the time we get here the RHS is fully moved
    /// out).  walk_expr_move marks the RHS identifier (if any) as moved.
    /// Each new field local registers as an owned binding with its own
    /// scope-end drop, identical to a normal VarDecl.
    walk_destructure_decl(mut &this, dd: DestructureDeclNode*) -> void {
        if (dd == null) { return; }
        if (dd.initializer != null) {
            this.walk_expr_move(dd.initializer);
        }
        for (mut i: i64 = 0; i < dd.bindings.length; i++) {
            const b: DestructureBinding = dd.bindings[i];
            this.register_binding(b.local_name, b.resolved_type, b.span);
        }
    }

    // ---- control-flow walks ---------------------------------------------

    walk_if(mut &this, it: IfStmtNode*,
            out: StatementNode*[]*) -> boolean {
        if (it == null) { return false; }
        if (it.condition != null) { this.walk_expr_read(it.condition); }
        const snap: i64 = this.snapshot_moves();

        mut then_diverges: boolean = false;
        if (it.then_stmt != null) {
            it.then_stmt = this.wrap_early_exit(it.then_stmt);
            then_diverges = this.walk_stmt_in_place(it.then_stmt);
        }
        const then_keys:  u32[] = this.moves_since_keys(snap);
        const then_lines: i32[] = this.moves_since_lines(snap);
        this.restore_moves(snap);

        mut else_diverges: boolean = false;
        if (it.else_stmt != null) {
            it.else_stmt = this.wrap_early_exit(it.else_stmt);
            else_diverges = this.walk_stmt_in_place(it.else_stmt);
        }
        const else_keys:  u32[] = this.moves_since_keys(snap);
        const else_lines: i32[] = this.moves_since_lines(snap);
        this.restore_moves(snap);

        // Branch join.  A diverging branch's moves don't escape the if
        // (control never reaches post-if on that path), so we drop its
        // contribution from the join entirely.  An if without an else
        // has an implicit fall-through else-branch: non-diverging,
        // empty moved-set, making any then-only move conditional.
        const has_else: boolean = it.else_stmt != null;
        const both_diverge: boolean = then_diverges && has_else && else_diverges;
        this.merge_branches_if(it, out, snap,
            then_keys, then_lines, then_diverges,
            else_keys, else_lines, has_else, else_diverges);
        return both_diverge;
    }

    /// Divergence of a switch CASE body w.r.t. the switch merge. Mirrors
    /// MoveCheck::switch_case_diverges: a `break` is NOT divergence (it jumps
    /// to the merge, so the case's moves reach the code after the switch);
    /// only `return` / `continue` leave the switch entirely. Used to decide
    /// which cases' moves escape to the post-switch state.
    switch_case_diverges(mut &this, stmt: StatementNode*) -> boolean {
        if (stmt == null) { return false; }
        match (stmt.kind) {
            NodeKind::ReturnStatement   => { return true;  }
            NodeKind::ContinueStatement => { return true;  }
            NodeKind::BreakStatement    => { return false; }
            NodeKind::BlockStatement => {
                const b: BlockStmtNode* = stmt as BlockStmtNode*;
                for (mut i: i64 = 0; i < b.statements.length; i++) {
                    if (this.switch_case_diverges(b.statements[i])) { return true; }
                }
                return false;
            }
            NodeKind::IfStatement => {
                const it: IfStmtNode* = stmt as IfStmtNode*;
                if (it.else_stmt == null) { return false; }
                return this.switch_case_diverges(it.then_stmt) &&
                       this.switch_case_diverges(it.else_stmt);
            }
            NodeKind::MatchStatement => {
                const m: MatchStmtNode* = stmt as MatchStmtNode*;
                if (m.arms.length == 0) { return false; }
                for (mut i: i64 = 0; i < m.arms.length; i++) {
                    const arm: MatchArmNode* = m.arms[i];
                    if (arm == null || !this.switch_case_diverges(arm.body)) {
                        return false;
                    }
                }
                return true;
            }
            _ => { return false; }
        }
    }

    /// Instrument a switch's case bodies. Cryo's switch has no fallthrough,
    /// so each case is an independent block: walking each body via `walk_block`
    /// synthesizes scope-exit drops for the owned LOCALS declared inside it
    /// (previously these leaked - the case bodies were never walked). A
    /// `break` inside a case is handled like a loop break that targets the
    /// switch: we push a loop boundary so it drops only the case-local scope,
    /// not the enclosing loop's bindings (which survive the switch).
    ///
    /// For OUTER bindings moved inside a case, we conservatively mark the union
    /// of moves (from cases that reach the merge) as moved after the switch, so
    /// their scope-exit drops are suppressed. This may leak on a path whose
    /// case did not move the binding, but never double-frees; MoveCheck (fatal,
    /// runs first) reports the explicit use-after-move cases with the same
    /// per-case divergence rule, so the two passes track a consistent move-set.
    walk_switch(mut &this, sw: SwitchStmtNode*) -> boolean {
        if (sw == null) { return false; }
        if (sw.expression != null) { this.walk_expr_read(sw.expression); }
        const snap: i64 = this.snapshot_moves();
        // Outer bindings (registered before the switch): only their moves may
        // escape; case-local moves disappear with the case scope.
        mut outer_names: u32[] = [];
        for (mut i: i64 = 0; i < this.binding_names.length; i++) {
            outer_names.push(this.binding_names[i]);
        }
        // Treat the switch as a break target like a loop (codegen pushes
        // merge_bb as the break destination): a `break` inside a case drops
        // back to here, not to the enclosing loop.
        this.loop_boundary.push(this.scope_start_idx.length);

        mut union_keys: u32[] = [];
        for (mut i: i64 = 0; i < sw.cases.length; i++) {
            const c: CaseStmtNode* = sw.cases[i];
            if (c == null || c.body == null) { continue; }
            this.walk_block(c.body);
            if (!this.switch_case_diverges(c.body as StatementNode*)) {
                const keys: u32[] = this.moves_since_keys(snap);
                for (mut k: i64 = 0; k < keys.length; k++) {
                    mut in_outer: boolean = false;
                    for (mut o: i64 = 0; o < outer_names.length; o++) {
                        if (outer_names[o] == keys[k]) { in_outer = true; break; }
                    }
                    if (!in_outer) { continue; }
                    mut found: boolean = false;
                    for (mut u: i64 = 0; u < union_keys.length; u++) {
                        if (union_keys[u] == keys[k]) { found = true; break; }
                    }
                    if (!found) { union_keys.push(keys[k]); }
                }
            }
            this.restore_moves(snap);
        }
        this.loop_boundary.pop();
        // Suppress post-switch scope-exit drops for the moved union.
        for (mut i: i64 = 0; i < union_keys.length; i++) {
            this.mark_moved(SymbolStr::from_id(union_keys[i]), sw.span);
        }
        // Code after the switch is reachable unless every path diverges; we
        // conservatively report non-divergence (extra drops in dead code are
        // harmless).
        return false;
    }

    /// If `stmt` is a bare early-exit (return/break/continue), wrap it
    /// in a synthesized block so the block walker can splice cumulative
    /// drops before it.  Otherwise return the stmt unchanged.  The
    /// parser produces bare statements for `if (c) return;` shapes.
    wrap_early_exit(mut &this, stmt: StatementNode*) -> StatementNode* {
        if (stmt == null) { return stmt; }
        const k: NodeKind = stmt.kind;
        if (k != NodeKind::ReturnStatement &&
            k != NodeKind::BreakStatement  &&
            k != NodeKind::ContinueStatement) {
            return stmt;
        }
        const block: BlockStmtNode* = new BlockStmtNode(stmt.span);
        block.statements.push(stmt);
        return block as StatementNode*;
    }

    walk_while(mut &this, w: WhileStmtNode*) -> void {
        if (w == null) { return; }
        if (w.condition != null) { this.walk_expr_read(w.condition); }
        // Loops run their body 0+ times.  Any move inside the body
        // either doesn't happen (0 iterations) or may set up a
        // use-after-move on the next iteration.  Snapshot/restore so
        // the post-loop state matches the pre-loop state; a body-
        // internal move is invisible past the loop.  Loop-carried
        // double-frees are caught by MoveCheck (fatal_on_failure)
        // before this pass runs, so the suppressed move can't cause
        // unsoundness here.
        const snap: i64 = this.snapshot_moves();
        this.loop_boundary.push(this.scope_start_idx.length);
        if (w.body != null) {
            w.body = this.wrap_early_exit(w.body);
            this.walk_stmt_in_place(w.body);
        }
        this.loop_boundary.pop();
        this.restore_moves(snap);
    }

    walk_do_while(mut &this, w: DoWhileStmtNode*) -> void {
        if (w == null) { return; }
        const snap: i64 = this.snapshot_moves();
        this.loop_boundary.push(this.scope_start_idx.length);
        if (w.body != null) {
            w.body = this.wrap_early_exit(w.body);
            this.walk_stmt_in_place(w.body);
        }
        this.loop_boundary.pop();
        this.restore_moves(snap);
        if (w.condition != null) { this.walk_expr_read(w.condition); }
    }

    walk_for(mut &this, f: ForStmtNode*) -> void {
        if (f == null) { return; }
        // The init clause typically declares a loop variable like
        // `mut i: i64 = 0`; its scope is the for-statement, not the
        // enclosing block.  Push a scope so the init binding is dropped
        // when the for finishes.
        this.push_scope();
        if (f.init != null && f.init.kind == NodeKind::VariableDeclaration) {
            this.walk_var_decl(f.init as VarDeclNode*);
        }
        if (f.condition != null) { this.walk_expr_read(f.condition); }
        if (f.update != null)    { this.walk_expr_read(f.update); }
        const snap: i64 = this.snapshot_moves();
        this.loop_boundary.push(this.scope_start_idx.length);
        if (f.body != null) {
            f.body = this.wrap_early_exit(f.body);
            this.walk_stmt_in_place(f.body);
        }
        this.loop_boundary.pop();
        this.restore_moves(snap);
        this.pop_scope();
    }

    walk_loop(mut &this, l: LoopStmtNode*) -> void {
        if (l == null) { return; }
        const snap: i64 = this.snapshot_moves();
        this.loop_boundary.push(this.scope_start_idx.length);
        if (l.body != null) {
            l.body = this.wrap_early_exit(l.body);
            this.walk_stmt_in_place(l.body);
        }
        this.loop_boundary.pop();
        this.restore_moves(snap);
    }

    walk_match(mut &this, m: MatchStmtNode*,
               out: StatementNode*[]*) -> boolean {
        if (m == null) { return false; }
        return this.walk_match_arms(m, m.subject, m.arms, false, out);
    }

    /// Walk a match's subject and arms as N independent control-flow
    /// paths (intersection/union move-join, generalised over N arms;
    /// the same shape as `walk_if`).  Shared by match *statements*
    /// (`walk_match`, `is_expr == false`) and match *expressions*
    /// (`walk_expr_read`'s `MatchExpression`/`TryExpression` arms,
    /// `is_expr == true`; this is what the `?` and `??` operators
    /// desugar to).
    ///
    /// For a match expression each arm body is a *value block* (see
    /// `walk_value_block`): its trailing expression is the arm's yielded
    /// value, walked in move context.  Routing match expressions through
    /// here is what gives an early `return` inside an arm (in particular
    /// the failure arm of the `?` desugar) the cumulative drops of every
    /// live local, so a droppable local live across `expr?` is freed on
    /// the error path instead of leaked.
    /// Register an arm's enum-pattern payload bindings in the types map
    /// (detection only - never the scope, so no drop is synthesized for
    /// them) using `proxy_ty` as a stand-in non-Copy type.  Returns the
    /// count registered so the caller can check + unregister them.
    register_arm_pattern_bindings(mut &this, arm: MatchArmNode*,
                                  proxy_ty: TypeRef, subject_id: u32) -> i64 {
        mut count: i64 = 0;
        for (mut p: i64 = 0; p < arm.patterns.length; p++) {
            const pat: PatternNode* = arm.patterns[p];
            if (pat == null || pat.pattern_kind != PatternKind::Enum) { continue; }
            const epat: EnumPatternNode* = pat as EnumPatternNode*;
            for (mut pos: i64 = 0; pos < epat.elements.length; pos++) {
                const pb: PatternBinding* = epat.binding_at(pos);
                if (pb == null || !pb.name.is_valid()) { continue; }
                this.register_param_type(pb.name, proxy_ty);
                this.link_payload.push(pb.name.id);
                this.link_subject.push(subject_id);
                count = count + 1;
            }
        }
        return count;
    }

    /// Pop the last `count` types-map entries (the arm bindings just
    /// registered, which sit on top after the arm body's own scope balanced
    /// out) along with their subject links, and report whether any was
    /// consumed (moved) within the arm.
    check_and_unregister_arm_bindings(mut &this, count: i64) -> boolean {
        mut consumed: boolean = false;
        for (mut k: i64 = 0; k < count; k++) {
            const idx: i64 = this.types_keys.length - 1;
            if (idx < 0) { break; }
            if (this.is_moved_id(this.types_keys[idx])) { consumed = true; }
            this.types_keys.pop();
            this.types_refs.pop();
            if (this.link_payload.length > 0) {
                this.link_payload.pop();
                this.link_subject.pop();
            }
        }
        return consumed;
    }

    walk_match_arms(mut &this, m: MatchStmtNode*,
                    subject: ExpressionNode*,
                    arms: &MatchArmNode*[], is_expr: boolean,
                    out: StatementNode*[]*) -> boolean {
        if (subject != null) { this.walk_expr_read(subject); }

        // Subject-consumption tracking for drop-glue suppression.  When the
        // subject is a bare owning binding (e.g. `match (opt) { ... }` where
        // `opt: Option<String>`), a match payload binding is a copy that
        // aliases the subject's heap.  If an arm consumes that binding
        // (`s.drop()` or moving it out), the subject's own scope-exit glue
        // would free the same storage again - a double-free.  We register
        // each arm's payload bindings for consumption detection and, if any
        // arm consumes one, mark the subject moved so its glue is suppressed.
        // (Borrow-only arms leave the subject live so glue still frees it.)
        mut subj_name: SymbolStr = SymbolStr::empty();
        mut subj_ty:   TypeRef   = TypeRef::invalid();
        if (subject != null && subject.kind == NodeKind::Identifier &&
            OwnershipQuery::needs_drop(this.arena, this.registry, this.intern,
                                       subject.resolved_type)) {
            const sid: IdentifierNode* = subject as IdentifierNode*;
            subj_name = sid.name;
            subj_ty   = subject.resolved_type;
        }
        mut subject_consumed: boolean = false;

        // Each arm is a separate control-flow path; same
        // intersection/union join as walk_if, generalised over N arms.
        if (arms.length == 0) { return false; }
        const snap: i64 = this.snapshot_moves();
        // Snapshot the outer-scope binding set so we can ignore moves
        // of arm-local bindings (pattern bindings or `let` inside the
        // arm body).  Those bindings disappear when the arm ends; they
        // don't exist on any other arm and are not part of the cross-
        // arm join.  Without this filter, `match (...) { Ok(x) => {
        // x.drop(); } Err(_) => {} }` would flag `x` as conditionally
        // moved.
        mut outer_names: u32[] = [];
        for (mut i: i64 = 0; i < this.binding_names.length; i++) {
            outer_names.push(this.binding_names[i]);
        }

        mut all_keys:    u32[] = [];
        mut all_lines:   i32[] = [];
        mut all_counts:  i64[] = [];
        // Per-arm move log: flat parallel arrays + start-offset table
        // so we can find which arms moved which keys without an array-
        // of-arrays (codegen has known issues with `T[][]`).
        // arm_move_starts[a] is the index in arm_move_keys where arm `a`'s
        // moves begin; arm_move_starts[arm_count] is the total length.
        mut arm_move_keys:   u32[] = [];
        mut arm_move_lines:  i32[] = [];
        mut arm_move_starts: i64[] = [];
        const arm_count: i64 = arms.length;
        mut live_arms:   i64 = 0;
        mut diverge_count: i64 = 0;

        for (mut a: i64 = 0; a < arm_count; a++) {
            arm_move_starts.push(arm_move_keys.length);
            const arm: MatchArmNode* = (*arms)[a];
            if (arm == null || arm.body == null) { continue; }
            // Register this arm's enum-payload bindings for consumption
            // detection (types-map only, so they never get a spurious
            // scope-exit drop).  The subject's own type is a sufficient
            // non-Copy proxy: registration is used purely to make
            // `.drop()` / move detection see the binding, never to emit a
            // drop for it.
            mut reg_count: i64 = 0;
            if (subj_name.is_valid()) {
                reg_count = this.register_arm_pattern_bindings(arm, subj_ty, subj_name.id);
            }
            arm.body = this.wrap_early_exit(arm.body);
            const arm_div: boolean = if (is_expr) {
                this.walk_stmt_in_place_value(arm.body)
            } else {
                this.walk_stmt_in_place(arm.body)
            };
            // A consumed payload binding means the subject was moved-from on
            // this path; suppress its glue.  Checked before restore_moves so
            // the in-arm move is still visible.  Always unregisters.
            if (reg_count > 0) {
                if (this.check_and_unregister_arm_bindings(reg_count)) {
                    subject_consumed = true;
                }
            }
            if (arm_div) {
                diverge_count += 1;
                this.restore_moves(snap);
                continue;
            }
            live_arms += 1;
            const arm_keys:  u32[] = this.moves_since_keys(snap);
            const arm_lines: i32[] = this.moves_since_lines(snap);
            for (mut i: i64 = 0; i < arm_keys.length; i++) {
                mut in_outer: boolean = false;
                for (mut o: i64 = 0; o < outer_names.length; o++) {
                    if (outer_names[o] == arm_keys[i]) { in_outer = true; }
                }
                if (!in_outer) { continue; }
                // Record per-arm so the join can splice flag-sets into
                // the specific arms that performed the move.
                arm_move_keys.push(arm_keys[i]);
                arm_move_lines.push(arm_lines[i]);
                mut found: boolean = false;
                for (mut j: i64 = 0; j < all_keys.length; j++) {
                    if (all_keys[j] == arm_keys[i]) {
                        all_counts[j] += 1;
                        found = true;
                    }
                }
                if (!found) {
                    all_keys.push(arm_keys[i]);
                    all_lines.push(arm_lines[i]);
                    all_counts.push(1);
                }
            }
            this.restore_moves(snap);
        }
        // Closing offset so arm `arm_count - 1`'s slice has an end bound.
        arm_move_starts.push(arm_move_keys.length);

        // All arms diverge -> match diverges; post-state irrelevant.
        if (live_arms == 0 && diverge_count > 0) {
            this.restore_moves(snap);
            return true;
        }

        mut def_keys:  u32[] = [];
        mut def_lines: i32[] = [];
        for (mut i: i64 = 0; i < all_keys.length; i++) {
            const cond_move: boolean = all_counts[i] < live_arms;
            if (cond_move && m != null) {
                // Flag synthesis: a binding moved on some arms but not
                // all live arms.  Hoist a single flag before the match,
                // splice `<flag>=true` into every arm that moved it.
                const binding: SymbolStr = SymbolStr::from_id(all_keys[i]);
                this.synth_flag_for_match_arms(m, out, binding,
                    all_lines[i], arms, arm_count,
                    arm_move_keys, arm_move_starts, all_keys[i]);
            } else if (cond_move) {
                // Expression-position match (out == null): no place to
                // hoist a flag-decl, so fall back to the historical
                // warning.  Practically unreachable today because
                // expression-match in stdlib uses Option/Result with
                // payload consumption (handled via link_payload), not
                // outer-scope conditional moves.
                this.emit_conditional_move_by_id(all_keys[i], all_lines[i]);
            }
            def_keys.push(all_keys[i]);
            def_lines.push(all_lines[i]);
        }
        this.set_moves_tail(snap, def_keys, def_lines);
        // A payload binding was consumed by some arm -> the owning subject is
        // moved-from after the match.  Mark it so drop-insertion suppresses
        // its scope-exit glue (preventing a double-free of the payload the
        // arm already released).  Safe even when only one arm consumes: the
        // non-consuming arms (e.g. `None`) carry no payload to leak.
        if (subj_name.is_valid() && subject_consumed && subject != null) {
            this.mark_moved(subj_name, subject.span);
        }
        return false;
    }

    /// Walk a statement in place; used by control-flow walkers that
    /// don't rebuild a parent statement list.  For block statements
    /// this recurses into walk_block; for non-block statements we wrap
    /// it in a 1-element list and let walk_stmt_into route correctly.
    /// Walk a statement that lives as a child of a control-flow node
    /// (then/else of an if, body of a while, arm of a match, ...) without
    /// rebuilding a parent statement list.  Returns the divergence flag
    /// of the statement.  Bare early-exit branches should already have
    /// been wrapped in a synthesized BlockStmtNode by walk_if/etc. via
    /// wrap_early_exit, so by the time we get here the statement is
    /// either a Block or a non-early-exit shape.
    walk_stmt_in_place(mut &this, stmt: StatementNode*) -> boolean {
        if (stmt == null) { return false; }
        return match (stmt.kind) {
            NodeKind::BlockStatement => {
                this.walk_block(stmt as BlockStmtNode*)
            }
            _ => {
                mut throwaway: StatementNode*[] = [];
                this.walk_stmt_into(stmt, &throwaway)
            }
        };
    }

    /// `walk_stmt_in_place` for a match-*expression* arm body: a block
    /// goes through `walk_value_block` (so the arm's trailing expression
    /// is treated as the yielded value), and a bare un-blocked expression
    /// statement is itself that value, walked in move context.
    walk_stmt_in_place_value(mut &this, stmt: StatementNode*) -> boolean {
        if (stmt == null) { return false; }
        return match (stmt.kind) {
            NodeKind::BlockStatement => {
                this.walk_value_block(stmt as BlockStmtNode*)
            }
            NodeKind::ExpressionStatement => {
                const es: ExprStmtNode* = stmt as ExprStmtNode*;
                if (es.expression != null) { this.walk_expr_move(es.expression); }
                false
            }
            _ => {
                mut throwaway: StatementNode*[] = [];
                this.walk_stmt_into(stmt, &throwaway)
            }
        };
    }

    // ---- branch-join helpers --------------------------------------------

    /// True iff `key` matches an id that's currently in `binding_names`
    /// i.e. the binding is live at the point of the if/match join.
    /// Used to discard moves of branch-local bindings from the join,
    /// which otherwise produce false `E0456_CONDITIONAL_MOVE` reports.
    binding_in_outer_scope(&this, key: u32) -> boolean {
        for (mut i: i64 = 0; i < this.binding_names.length; i++) {
            if (this.binding_names[i] == key) { return true; }
        }
        return false;
    }

    /// `if`/`else`-specific branch join that synthesizes drop flags
    /// (see `make_drop_flag_decl` / `make_drop_flag_set` /
    /// `make_conditional_drop_call`) for any outer-scope binding moved
    /// on one branch but not the other.  The flag-decl is hoisted into
    /// `out` (the enclosing block buffer) BEFORE the if-stmt; the
    /// flag-set is spliced at the END of the moving branch's body so
    /// any drop synthesized at scope exit observes the flag's true
    /// state on the moved control-flow path.  Falls back to the
    /// original merge_branches semantics (add to def_keys, no flag) for
    /// any binding where flag synthesis isn't applicable.
    merge_branches_if(mut &this, it: IfStmtNode*,
                       out: StatementNode*[]*, snap: i64,
                       then_keys: u32[], then_lines: i32[], then_diverges: boolean,
                       else_keys: u32[], else_lines: i32[],
                       has_else: boolean, else_diverges: boolean) -> void {
        const live_then: boolean = !then_diverges;
        const live_else: boolean = has_else && !else_diverges;

        if (!live_then && !live_else) {
            this.restore_moves(snap);
            return;
        }
        if (live_then && !live_else) {
            // Then-only fall-through.  When there's no explicit else
            // (or the else diverges), a then-only move of an
            // outer-scope binding is conditional from the post-if
            // viewpoint: the false path didn't move, the true path
            // did.  Synthesize a drop flag for each such binding so
            // the scope-exit drop fires on the false path and is
            // suppressed on the true path.  Diverging-else case never
            // reaches post-if on the false path, so the move is
            // unconditional from post-if's perspective - no flag
            // needed.
            if (!has_else) {
                this.synth_flags_for_then_only_moves(it, out, then_keys, then_lines);
            }
            // Surviving (then) path's moves carry past the if for
            // subsequent analysis.  set_moves_tail also keeps the
            // conservative behavior of marking these bindings moved
            // for any code that follows the if; with the flag in
            // place, maybe_append_drop still emits the conditional
            // drop because get_drop_flag wins before is_moved_id.
            this.set_moves_tail(snap, then_keys, then_lines);
            return;
        }
        if (!live_then && live_else) {
            // Symmetric: else-only fall-through.  Synthesize a flag
            // for each else-only outer-scope move so the scope-exit
            // drop fires on the (diverging) "then" side - except that
            // side never reaches post-if, so the flag only matters
            // for control-flow paths where neither branch was taken,
            // which doesn't happen for `if`.  No flag needed here;
            // just propagate the else-branch moves forward.
            this.set_moves_tail(snap, else_keys, else_lines);
            return;
        }

        // Both branches fall through: compute definitely-moved
        // (intersection) and possibly-moved (symmetric difference).
        // For each possibly-moved outer-scope binding, synthesize a
        // drop flag and append `<flag>=true;` to the branch where it
        // was moved.  Definitely-moved bindings (in both arms) need
        // no flag - they are unconditionally moved, so the existing
        // moved_keys path suppresses their scope-exit drop.
        mut def_keys:  u32[] = [];
        mut def_lines: i32[] = [];
        for (mut i: i64 = 0; i < then_keys.length; i++) {
            if (!this.binding_in_outer_scope(then_keys[i])) { continue; }
            mut in_else: boolean = false;
            for (mut j: i64 = 0; j < else_keys.length; j++) {
                if (then_keys[i] == else_keys[j]) { in_else = true; }
            }
            if (in_else) {
                // Definitely moved on both branches.
                def_keys.push(then_keys[i]);
                def_lines.push(then_lines[i]);
            } else {
                // Then-only conditional move.  Flag + flag-set in then.
                const binding: SymbolStr = SymbolStr::from_id(then_keys[i]);
                this.synth_flag_for_branch(it, out, binding, then_lines[i],
                    /*branch_is_then=*/true);
                def_keys.push(then_keys[i]);
                def_lines.push(then_lines[i]);
            }
        }
        for (mut j: i64 = 0; j < else_keys.length; j++) {
            if (!this.binding_in_outer_scope(else_keys[j])) { continue; }
            mut in_then: boolean = false;
            for (mut i: i64 = 0; i < then_keys.length; i++) {
                if (then_keys[i] == else_keys[j]) { in_then = true; }
            }
            if (!in_then) {
                // Else-only conditional move.  Flag + flag-set in else.
                const binding: SymbolStr = SymbolStr::from_id(else_keys[j]);
                this.synth_flag_for_branch(it, out, binding, else_lines[j],
                    /*branch_is_then=*/false);
                def_keys.push(else_keys[j]);
                def_lines.push(else_lines[j]);
            }
        }
        this.set_moves_tail(snap, def_keys, def_lines);
    }

    /// Helper: synthesize a drop flag for a single binding moved in
    /// the given branch (true = then, false = else).  Hoists the
    /// flag-decl into `out` and splices `<flag>=true;` into the
    /// branch's body.  Records the binding -> flag mapping so
    /// maybe_append_drop emits a conditional drop later.
    synth_flag_for_branch(mut &this, it: IfStmtNode*,
                            out: StatementNode*[]*,
                            binding: SymbolStr, move_line: i32,
                            branch_is_then: boolean) -> void {
        // Already has a flag? Idempotent re-use - just splice the
        // flag-set into this branch.
        mut flag: SymbolStr = this.get_drop_flag(binding);
        if (!flag.is_valid()) {
            flag = this.fresh_drop_flag_name(binding);
            // Hoist `mut <flag>: boolean = false;` before the if-stmt.
            // The binding span is the best anchor for diagnostics on the
            // synthesized local; fall back to it.span if unavailable.
            const decl_span: SourceSpan = this.binding_span_for(binding, it.span);
            out.push(this.make_drop_flag_decl(flag, decl_span));
            // Register the synthesized binding in the type map so
            // subsequent flag references type-resolve cleanly.
            this.register_param_type(flag, this.arena.get_bool());
            this.register_drop_flag(binding, flag);
        }
        // Splice `<flag>=true;` at the end of the moving branch.
        const set_span: SourceSpan = this.line_only_span(move_line, it.span);
        if (branch_is_then) {
            it.then_stmt = this.splice_flag_set_into_branch(
                it.then_stmt, flag, set_span);
        } else {
            it.else_stmt = this.splice_flag_set_into_branch(
                it.else_stmt, flag, set_span);
        }
    }

    /// Helper: synthesize a drop flag for a binding conditionally
    /// moved by some - but not all - live arms of a match statement.
    /// Hoists a single `mut <flag>: boolean = false;` before the match,
    /// then splices `<flag>=true;` into every arm whose move log
    /// includes `key`.  Arms that didn't move it (borrow-only arms,
    /// diverging arms, irrelevant variants) leave the flag at `false`
    /// so the scope-exit conditional drop fires correctly.
    synth_flag_for_match_arms(mut &this, m: MatchStmtNode*,
                                out: StatementNode*[]*,
                                binding: SymbolStr, move_line: i32,
                                arms: &MatchArmNode*[], arm_count: i64,
                                arm_move_keys: &u32[],
                                arm_move_starts: &i64[],
                                key: u32) -> void {
        mut flag: SymbolStr = this.get_drop_flag(binding);
        if (!flag.is_valid()) {
            flag = this.fresh_drop_flag_name(binding);
            const decl_span: SourceSpan = this.binding_span_for(binding, m.span);
            out.push(this.make_drop_flag_decl(flag, decl_span));
            this.register_param_type(flag, this.arena.get_bool());
            this.register_drop_flag(binding, flag);
        }
        const set_span: SourceSpan = this.line_only_span(move_line, m.span);
        // Walk per-arm slice [starts[a], starts[a+1]) and splice the
        // flag-set when this arm moved `key`.
        for (mut a: i64 = 0; a < arm_count; a++) {
            const beg: i64 = (*arm_move_starts)[a];
            const end: i64 = (*arm_move_starts)[a + 1];
            mut moved_here: boolean = false;
            for (mut j: i64 = beg; j < end; j++) {
                if ((*arm_move_keys)[j] == key) { moved_here = true; }
            }
            if (!moved_here) { continue; }
            const arm: MatchArmNode* = (*arms)[a];
            if (arm == null || arm.body == null) { continue; }
            arm.body = this.splice_flag_set_into_branch(arm.body, flag, set_span);
        }
    }

    /// Helper: synthesize drop flags for every outer-scope binding moved
    /// in the then-branch when there's no explicit else.  The implicit
    /// else moves nothing, so every then-move is conditional.
    synth_flags_for_then_only_moves(mut &this, it: IfStmtNode*,
                                      out: StatementNode*[]*,
                                      then_keys: &u32[],
                                      then_lines: &i32[]) -> void {
        for (mut i: i64 = 0; i < then_keys.length; i++) {
            if (!this.binding_in_outer_scope((*then_keys)[i])) { continue; }
            const binding: SymbolStr = SymbolStr::from_id((*then_keys)[i]);
            this.synth_flag_for_branch(it, out, binding, (*then_lines)[i],
                /*branch_is_then=*/true);
        }
    }

    /// Look up a binding's declaration span for anchoring synthesized
    /// nodes' diagnostics.  Falls back to `default_span` (typically the
    /// branching statement's own span) if the binding was declared
    /// outside any tracked scope.
    binding_span_for(&this, binding: SymbolStr, default_span: SourceSpan) -> SourceSpan {
        for (mut i: i64 = this.binding_names.length - 1; i >= 0; i--) {
            if (this.binding_names[i] == binding.id) {
                if (this.binding_spans[i].has_location()) {
                    return this.binding_spans[i];
                }
                return default_span;
            }
        }
        return default_span;
    }

    /// Build a 1-column span pinned to the given line, falling back to
    /// `default_span` when no line is recorded (line == 0 means the move
    /// site span was unavailable).
    line_only_span(&this, line: i32, default_span: SourceSpan) -> SourceSpan {
        if (line <= 0) { return default_span; }
        return SourceSpan::new(this.ctx.source_file,
            line as u32, 1 as u32,
            line as u32, 1 as u32);
    }

    /// Original branch-join helper for match (and any non-if caller).
    /// Same intersection/symmetric-difference logic that
    /// merge_branches_if uses, but without drop-flag synthesis -
    /// possibly-moved bindings still get E0456 here, pending the same
    /// treatment for match arms in a follow-up.
    merge_branches(mut &this, snap: i64,
                   then_keys: u32[], then_lines: i32[], then_diverges: boolean,
                   else_keys: u32[], else_lines: i32[],
                   has_else: boolean, else_diverges: boolean) -> void {
        // A diverging branch's moves don't escape; drop its
        // contribution from the join.  This eliminates the
        // `if (c) { use(b); return; }` false-positive where `b` would
        // otherwise look conditionally moved.
        const live_then: boolean = !then_diverges;
        const live_else: boolean = has_else && !else_diverges;

        // Effective branches after diverge filtering.  When neither is
        // live (both diverge), the post-join state is unreachable and
        // the moved-set doesn't matter.
        if (!live_then && !live_else) {
            this.restore_moves(snap);
            return;
        }
        if (live_then && !live_else) {
            // Only the then-branch falls through past the if.  Two shapes
            // land here, distinguished by has_else:
            //
            //  - No explicit else (`if (c) { consume(x); }`): the implicit
            //    fall-through else moves nothing, so a then-only move of an
            //    outer-scope binding is genuinely *conditional* - `x` is moved
            //    on the true path but survives the false path, where the
            //    fail-safe under-drop below suppresses its drop: a
            //    memory-safe leak.  Warn (E0456) for each such binding.
            //
            //  - Diverging else (`if (c) { consume(x); } else { return; }`):
            //    the else path never reaches post-if, so the then-branch is
            //    the only surviving path and its move is *unconditional* -
            //    not a leak.  Don't warn.
            //
            // Reassignment (`x = f(x)`) never reaches here as a live move:
            // read_binary unmarks the lhs after the rhs move, tombstoning it
            // (id 0) out of then_keys; binding_in_outer_scope rejects id 0 and
            // any branch-local binding, so neither false-positives.
            if (!has_else) {
                for (mut i: i64 = 0; i < then_keys.length; i++) {
                    if (this.binding_in_outer_scope(then_keys[i])) {
                        this.emit_conditional_move_by_id(then_keys[i], then_lines[i]);
                    }
                }
            }
            // The surviving (then) path's moves carry past the if.  With a
            // diverging else this is exact; with no else it's the fail-safe
            // under-drop on the false path - the leak just warned about.
            this.set_moves_tail(snap, then_keys, then_lines);
            return;
        }
        if (!live_then && live_else) {
            // Only the else-branch falls through.  When there's no
            // explicit else, live_else can't be true, so this only
            // fires for `if (c) { ... return; } else { ... }`.
            this.set_moves_tail(snap, else_keys, else_lines);
            return;
        }

        // Both branches fall through: definitely-moved is the
        // intersection; possibly-moved is the symmetric difference.
        // Branch-local bindings (declared inside the then or else
        // body) are filtered out: they don't exist past the if-stmt
        // and shouldn't drive the cross-branch join.
        mut def_keys:  u32[] = [];
        mut def_lines: i32[] = [];
        for (mut i: i64 = 0; i < then_keys.length; i++) {
            if (!this.binding_in_outer_scope(then_keys[i])) { continue; }
            mut in_else: boolean = false;
            for (mut j: i64 = 0; j < else_keys.length; j++) {
                if (then_keys[i] == else_keys[j]) { in_else = true; }
            }
            if (in_else) {
                def_keys.push(then_keys[i]);
                def_lines.push(then_lines[i]);
            } else {
                this.emit_conditional_move_by_id(then_keys[i], then_lines[i]);
                def_keys.push(then_keys[i]);
                def_lines.push(then_lines[i]);
            }
        }
        for (mut j: i64 = 0; j < else_keys.length; j++) {
            if (!this.binding_in_outer_scope(else_keys[j])) { continue; }
            mut in_then: boolean = false;
            for (mut i: i64 = 0; i < then_keys.length; i++) {
                if (then_keys[i] == else_keys[j]) { in_then = true; }
            }
            if (!in_then) {
                this.emit_conditional_move_by_id(else_keys[j], else_lines[j]);
                def_keys.push(else_keys[j]);
                def_lines.push(else_lines[j]);
            }
        }
        this.set_moves_tail(snap, def_keys, def_lines);
    }

    emit_conditional_move_by_id(mut &this, key: u32, line: i32) -> void {
        // Phase 1.5: emit as a warning rather than an error.  The
        // analysis is over-eager: it reports any binding moved on
        // some control-flow paths but not others, even when the
        // binding's scope ends before the divergence becomes
        // observable (e.g. declared inside a loop body that resets
        // each iteration).  Once synthesis is enabled and proper
        // escape analysis is in place, this can be promoted to error.
        const sym: SymbolStr = SymbolStr::from_id(key);
        mut name_str: string = this.intern.resolve(sym);
        if (strlen(name_str) == 0) {
            name_str = "<binding>";
        }
        // Anchor at the binding's declaration span, which carries real
        // start/end columns so the renderer underlines the binding name
        // properly.  The move-set only tracks the move's line (no columns),
        // so a line-only span underlined column 1 (the left margin); fall
        // back to that only when the declaration span can't be recovered.
        const line_u: u32 = if (line > 0) { line as u32 } else { 0 };
        mut span: SourceSpan = SourceSpan::new(this.ctx.source_file, line_u, 1, line_u, 1);
        for (mut bi: i64 = 0; bi < this.binding_names.length; bi++) {
            if (this.binding_names[bi] == key && this.binding_spans[bi].has_location()) {
                span = this.binding_spans[bi];
                break;
            }
        }
        const msg: string = format(
            "value '%s' is moved on some control-flow paths but not others",
            name_str);
        mut diag: Diagnostic = Diagnostic::warning(ErrorCode::E0456_CONDITIONAL_MOVE, msg);
        diag = diag.at_with_label(span, "this binding may not be dropped on every path");
        this.ctx.emit_diagnostic(diag);
        this.fired += 1;
    }

    // ---- drop synthesis --------------------------------------------------

    /// Append synthetic drops for the top scope's bindings (reverse
    /// declaration order) to `out`.  Skips bindings that have already
    /// been moved on the current path and bindings whose type is Copy.
    append_top_scope_drops(mut &this, out: StatementNode*[]*) -> void {
        const start: i64 = this.top_scope_start();
        const end:   i64 = this.binding_names.length;
        for (mut i: i64 = end - 1; i >= start; i--) {
            this.maybe_append_drop(out, i);
        }
    }

    /// Append drops for every live scope down to `min_scope`, innermost
    /// first, reverse declaration order within each scope.
    append_drops_to_depth(mut &this, out: StatementNode*[]*, min_scope: i64) -> void {
        const total_scopes: i64 = this.scope_start_idx.length;
        if (total_scopes == 0 || min_scope >= total_scopes) { return; }
        const stop: i64 = if (min_scope < 0) { 0 } else { min_scope };
        for (mut s: i64 = total_scopes - 1; s >= stop; s--) {
            const start: i64 = this.scope_start_idx[s];
            const end:   i64 = if (s + 1 < total_scopes) {
                this.scope_start_idx[s + 1]
            } else {
                this.binding_names.length
            };
            for (mut i: i64 = end - 1; i >= start; i--) {
                this.maybe_append_drop(out, i);
            }
        }
    }

    /// Drops for every live scope, innermost first.  Used before
    /// `return`: the function exits, so every scope gets dropped.
    append_cumulative_drops(mut &this, out: StatementNode*[]*) -> void {
        this.append_drops_to_depth(out, 0);
    }

    /// Drops for scopes inside the current loop body.  Used before
    /// `break`/`continue`: those exit the enclosing loop only, so
    /// bindings declared OUTSIDE the loop must NOT be dropped here.
    append_loop_exit_drops(mut &this, out: StatementNode*[]*) -> void {
        if (this.loop_boundary.length == 0) {
            // No enclosing loop; `break`/`continue` outside a loop
            // would be a sema error already; emit nothing.
            return;
        }
        const boundary: i64 = this.loop_boundary[this.loop_boundary.length - 1];
        this.append_drops_to_depth(out, boundary);
    }

    /// True if a value of type `ty` must be dropped at scope/statement exit:
    /// non-Copy and carrying a drop (inherent or via the `Drop` trait). The
    /// type might lack a drop method (rare for non-Copy types, but possible
    /// for primitives that escape Copy through an alias) - emitting `.drop()`
    /// on such a type would fail at codegen, so those are excluded.
    /// Guards param auto-drop against a type whose drop method would mangle
    /// to a name that isn't emitted. A by-value param can receive a generic
    /// type with unfilled default args via mono substitution (e.g. `T` bound
    /// to bare `CString` from `Option<CString>`, where `CString<A=GlobalAlloc>`
    /// is what's actually emitted). Such a *base* template type is registered
    /// in the generic registry by its own type id; a fully concrete type or a
    /// canonical `InstantiatedType` (`String<GlobalAlloc>`) is not, so its drop
    /// mangles to the emitted symbol. Dropping a bare-template param would
    /// reference an unmangled `Type::drop` that nothing defines, so skip it
    /// (it leaks, as before this pass dropped any param - no regression). The
    /// recursive-default-expansion fix that canonicalizes such substitutions
    /// is the proper resolution; tracked separately.
    param_drop_well_formed(&this, ty: TypeRef) -> boolean {
        if (!ty.is_valid()) { return false; }
        if (this.registry == null) { return true; }
        return this.registry.get_template_by_type_id(ty.id) == null;
    }

    type_needs_drop(&this, ty: TypeRef) -> boolean {
        if (!ty.is_valid())   { return false; }
        if (this.is_copy(ty)) { return false; }
        // A user drop OR a transitively-droppable aggregate (struct field,
        // enum payload, tuple/array element).  The aggregate case is lowered
        // by codegen drop-glue: a `binding.drop()` on a type with no
        // user-written drop expands to in-place drops of its droppable parts.
        return OwnershipQuery::needs_drop(this.arena, this.registry,
                                          this.intern, ty);
    }

    maybe_append_drop(mut &this, out: StatementNode*[]*, idx: i64) -> void {
        const key:  u32       = this.binding_names[idx];
        const ty:   TypeRef   = this.binding_types[idx];
        const span: SourceSpan = this.binding_spans[idx];
        if (!this.type_needs_drop(ty)) { return; }
        const sym: SymbolStr = SymbolStr::from_id(key);
        // Conditional move: a drop-flag was hoisted for this binding by
        // a branch-join in this function.  Emit `if (!flag) drop();`
        // regardless of the moved-set state, since the flag is the
        // ground truth.  The moved_keys tracking still serves other
        // analyses (e.g. mark_moved short-circuit) but is overridden
        // here for the drop decision.
        const flag: SymbolStr = this.get_drop_flag(sym);
        if (flag.is_valid()) {
            const cstmt: StatementNode* = this.make_conditional_drop_call(
                sym, ty, flag, span);
            if (cstmt != null) {
                out.push(cstmt);
                this.inserted += 1;
            }
            return;
        }
        if (this.is_moved_id(key))   { return; }
        const stmt: StatementNode* = this.make_drop_call(sym, ty, span);
        if (stmt != null) {
            out.push(stmt);
            this.inserted += 1;
        }
    }

    /// An expression-statement whose result is a freshly-produced owning
    /// value that the statement discards: a call (including enum-variant
    /// constructors, which parse as calls) or a struct literal whose result
    /// type needs dropping. Bare identifiers, member/array access, casts,
    /// etc. are deliberately excluded - their result aliases an existing
    /// binding (already tracked for drop) rather than a new temporary, so
    /// synthesizing a drop here would double-free. `new` is excluded too: it
    /// yields a raw pointer (Copy), which the type gate rejects anyway.
    discarded_owning_temp(&this, expr: ExpressionNode*) -> boolean {
        if (expr == null) { return false; }
        if (expr.kind != NodeKind::CallExpression &&
            expr.kind != NodeKind::StructLiteral) {
            return false;
        }
        return this.type_needs_drop(expr.resolved_type);
    }

    /// Materialize a discarded owning temporary into a hidden local and drop
    /// it at statement end, rewriting `<expr>;` into
    ///     const __drop_tmpN: T = <expr>;
    ///     __drop_tmpN.drop();
    /// This reuses the ordinary local-var codegen (which keys the alloca by
    /// name and stores the rvalue) and the standard synthesized drop call, so
    /// no codegen change is needed. The hidden local is NOT registered as a
    /// scope binding, so the scope-exit pass won't drop it a second time; the
    /// drop fires at statement end, matching where most systems languages
    /// destroy a discarded temporary.
    emit_discarded_temp_drop(mut &this, expr: ExpressionNode*,
                              out: StatementNode*[]*, span: SourceSpan) -> void {
        const ty: TypeRef = expr.resolved_type;
        const name: SymbolStr = this.intern.intern(
            format("__drop_tmp%d", this.discard_seq));
        this.discard_seq = this.discard_seq + 1;
        const vd: VarDeclNode* = new VarDeclNode(name, span);
        vd.set_resolved_type(ty);
        vd.set_initializer(expr);
        const ds: DeclStmtNode* = new DeclStmtNode(vd as DeclarationNode*, span);
        out.push(ds as StatementNode*);
        const drop_stmt: StatementNode* = this.make_drop_call(name, ty, span);
        if (drop_stmt != null) {
            out.push(drop_stmt);
            this.inserted += 1;
        }
    }

    /// Hoist a non-Identifier owning match subject into a synthesized local
    /// declared just before the match, then rewrite the match's subject to
    /// an Identifier referencing the new local.  The local enters the normal
    /// binding registry on walk_var_decl, picking up scope-exit drop glue
    /// like any other owning local; and walk_match_arms's consumption
    /// tracking (gated on subject.kind == Identifier) now fires properly,
    /// so an arm that moves the payload out suppresses the subject's glue.
    hoist_match_subject(mut &this, m: MatchStmtNode*,
                        out: StatementNode*[]*) -> void {
        if (m == null || m.subject == null) { return; }
        const span: SourceSpan = m.subject.span;
        const ty: TypeRef = m.subject.resolved_type;
        const name: SymbolStr = this.intern.intern(
            format("__match_subj%d", this.discard_seq));
        this.discard_seq = this.discard_seq + 1;
        // Walk the subject in move context FIRST (it's the rvalue init).
        this.walk_expr_move(m.subject);
        mut vd: VarDeclNode* = new VarDeclNode(name, span);
        vd.set_resolved_type(ty);
        vd.set_initializer(m.subject);
        const ds: DeclStmtNode* = new DeclStmtNode(vd as DeclarationNode*, span);
        out.push(ds as StatementNode*);
        // Register the synthesized binding so scope-exit drop synthesis sees
        // it.  walk_var_decl is the usual entry point but it also walks the
        // initializer - which we just walked - so register directly.
        this.register_binding(name, ty, span);
        mut ident: IdentifierNode* = new IdentifierNode(name, span);
        ident.set_resolved_type(ty);
        m.subject = ident as ExpressionNode*;
    }

    // ---- drop-flag synthesis --------------------------------------------
    //
    // A binding moved on some control-flow paths and not others gets a
    // companion boolean local hoisted before the branching statement.
    // Moving arms set the flag to `true`; scope-exit wraps the drop in
    // `if (!<flag>) { binding.drop(); }`.  This is the standard "drop
    // flag" technique and turns what would be a memory-safe leak on the
    // not-moved path (the binding never gets dropped) into an exact
    // conditional drop.  LLVM's O2 default folds the flag away when it
    // can prove the move state statically.

    /// Look up the drop-flag local synthesized for `binding`, or return
    /// an invalid SymbolStr if there is none.
    get_drop_flag(&this, binding: SymbolStr) -> SymbolStr {
        if (!binding.is_valid()) { return SymbolStr::empty(); }
        for (mut i: i64 = 0; i < this.flag_binding_keys.length; i++) {
            if (this.flag_binding_keys[i] == binding.id) {
                return SymbolStr::from_id(this.flag_flag_keys[i]);
            }
        }
        return SymbolStr::empty();
    }

    /// Register a binding -> flag mapping (idempotent on the binding
    /// key; the first flag wins).
    register_drop_flag(mut &this, binding: SymbolStr, flag: SymbolStr) -> void {
        if (!binding.is_valid() || !flag.is_valid()) { return; }
        for (mut i: i64 = 0; i < this.flag_binding_keys.length; i++) {
            if (this.flag_binding_keys[i] == binding.id) { return; }
        }
        this.flag_binding_keys.push(binding.id);
        this.flag_flag_keys.push(flag.id);
    }

    /// Build `mut <flag>: boolean = false;` as a DeclStmt.  The boolean
    /// type is looked up via the type arena's primitive bool registry.
    make_drop_flag_decl(mut &this, flag_name: SymbolStr,
                         span: SourceSpan) -> StatementNode* {
        const lit: LiteralNode* = new LiteralNode("false", LiteralKind::Boolean, span);
        lit.set_resolved_type(this.arena.get_bool());
        const vd: VarDeclNode* = new VarDeclNode(flag_name, span);
        vd.set_resolved_type(this.arena.get_bool());
        vd.set_mutable(true);
        vd.set_initializer(lit as ExpressionNode*);
        const ds: DeclStmtNode* = new DeclStmtNode(vd as DeclarationNode*, span);
        return ds as StatementNode*;
    }

    /// Build `<flag> = true;` as an ExprStmt wrapping a BinaryExpr with
    /// the bare `=` token.  Drop-flag locals are always `mut` (see
    /// `make_drop_flag_decl`), so this is a legal assignment target.
    make_drop_flag_set(mut &this, flag_name: SymbolStr,
                        span: SourceSpan) -> StatementNode* {
        const lhs: IdentifierNode* = new IdentifierNode(flag_name, span);
        lhs.set_resolved_type(this.arena.get_bool());
        const rhs: LiteralNode* = new LiteralNode("true", LiteralKind::Boolean, span);
        rhs.set_resolved_type(this.arena.get_bool());
        const eq_tok: Token = Token::new(TokenType::Equal, "=",
            span.start_line as int, span.start_col as int);
        const assign: BinaryExprNode* = new BinaryExprNode(
            eq_tok, lhs as ExpressionNode*, rhs as ExpressionNode*, span);
        assign.set_resolved_type(this.arena.get_bool());
        const stmt: ExprStmtNode* = new ExprStmtNode(assign as ExpressionNode*, span);
        return stmt as StatementNode*;
    }

    /// Build `if (!<flag>) { <binding>.drop(); }` as an IfStmt.  The
    /// then-branch is a 1-statement block holding the drop call;
    /// else_stmt stays null.  Used by `maybe_append_drop` when the
    /// binding has a registered drop flag (conditional move).
    make_conditional_drop_call(mut &this, binding: SymbolStr, ty: TypeRef,
                                 flag: SymbolStr,
                                 span: SourceSpan) -> StatementNode* {
        // Condition: `!<flag>`
        const flag_ident: IdentifierNode* = new IdentifierNode(flag, span);
        flag_ident.set_resolved_type(this.arena.get_bool());
        const not_tok: Token = Token::new(TokenType::Exclaim, "!",
            span.start_line as int, span.start_col as int);
        const cond: UnaryExprNode* = new UnaryExprNode(
            not_tok, flag_ident as ExpressionNode*, span);
        cond.set_resolved_type(this.arena.get_bool());
        // Body: `{ <binding>.drop(); }`
        const drop_stmt: StatementNode* = this.make_drop_call(binding, ty, span);
        if (drop_stmt == null) { return null as StatementNode*; }
        const body: BlockStmtNode* = new BlockStmtNode(span);
        body.statements.push(drop_stmt);
        const if_stmt: IfStmtNode* = new IfStmtNode(
            cond as ExpressionNode*, body as StatementNode*,
            null as StatementNode*, span);
        return if_stmt as StatementNode*;
    }

    /// Append `<flag>=true;` to a branch body so the scope-exit
    /// conditional drop sees the moved state.  If the branch body is a
    /// BlockStmt we append directly; otherwise we wrap it in a block
    /// (the same trick `wrap_early_exit` uses).  Returns the (possibly
    /// re-wrapped) branch body so the caller can update the if/match
    /// node's pointer.
    splice_flag_set_into_branch(mut &this, branch: StatementNode*,
                                 flag_name: SymbolStr,
                                 span: SourceSpan) -> StatementNode* {
        if (branch == null) { return branch; }
        const set_stmt: StatementNode* = this.make_drop_flag_set(flag_name, span);
        if (branch.kind == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = branch as BlockStmtNode*;
            blk.statements.push(set_stmt);
            return branch;
        }
        // Non-block: wrap the original stmt and append the flag-set.
        const blk: BlockStmtNode* = new BlockStmtNode(span);
        blk.statements.push(branch);
        blk.statements.push(set_stmt);
        return blk as StatementNode*;
    }

    /// Allocate a fresh drop-flag name for `binding`.  Format
    /// `<name>__dropflag<seq>` keeps the binding visible in IR dumps
    /// (helpful when debugging) and the monotonic seq ensures uniqueness
    /// even if the same binding gains multiple flags from nested
    /// branches (which shouldn't happen with the idempotent
    /// register_drop_flag, but is cheap insurance).
    fresh_drop_flag_name(mut &this, binding: SymbolStr) -> SymbolStr {
        const base: string = this.intern.resolve(binding);
        const named: string = format("%s__dropflag%lld", base, this.flag_seq);
        this.flag_seq = this.flag_seq + 1;
        return this.intern.intern(named);
    }

    /// Build `binding.drop();` as ExprStmt(Call(MemberAccess(Ident, "drop"))).
    /// The synthesized nodes must carry resolved types; codegen runs
    /// after this pass and won't re-run type resolution, so an
    /// unresolved `binding.drop()` would lower to `<unknown>.drop()`
    /// and fail E0156 method lookup.
    make_drop_call(mut &this, name: SymbolStr, ty: TypeRef,
                    span: SourceSpan) -> StatementNode* {
        const ident: IdentifierNode* = new IdentifierNode(name, span);
        ident.set_resolved_type(ty);
        const member: MemberAccessNode* = new MemberAccessNode(
            ident as ExpressionNode*, this.drop_sym, span, span);
        const call: CallExprNode* = new CallExprNode(member as ExpressionNode*, span);
        const stmt: ExprStmtNode* = new ExprStmtNode(call as ExpressionNode*, span);
        return stmt as StatementNode*;
    }

    // ---- expression walks (move tracking on identifiers) -----------------

    /// Move-context: bare identifiers of non-Copy types get marked moved.
    walk_expr_move(mut &this, expr: ExpressionNode*) -> void {
        if (expr == null) { return; }
        if (expr.kind == NodeKind::Identifier) {
            this.handle_ident(expr as IdentifierNode*, true);
            return;
        }
        this.walk_expr_read(expr);
    }

    walk_expr_read(mut &this, expr: ExpressionNode*) -> void {
        if (expr == null) { return; }
        match (expr.kind) {
            NodeKind::Identifier         => { this.handle_ident(expr as IdentifierNode*, false);      }
            NodeKind::CallExpression     => { this.read_call(expr as CallExprNode*);                   }
            NodeKind::BinaryExpression   => { this.read_binary(expr as BinaryExprNode*);               }
            NodeKind::UnaryExpression    => { this.read_unary(expr as UnaryExprNode*);                 }
            NodeKind::MemberAccess       => { this.read_member(expr as MemberAccessNode*);             }
            NodeKind::ArrayAccess        => { this.read_array_access(expr as ArrayAccessNode*);        }
            NodeKind::CastExpression     => { this.read_cast(expr as CastExprNode*);                   }
            NodeKind::StructLiteral      => { this.read_struct_lit(expr as StructLiteralNode*);        }
            NodeKind::TupleLiteral       => { this.read_tuple_lit(expr as TupleLiteralNode*);          }
            NodeKind::ArrayLiteral       => { this.read_array_lit(expr as ArrayLiteralNode*);          }
            NodeKind::TernaryExpression  => { this.read_ternary(expr as TernaryExprNode*);             }
            NodeKind::IfExpression       => { this.read_if_expr(expr as IfExprNode*);                  }
            NodeKind::NewExpression      => { this.read_new(expr as NewExprNode*);                     }
            NodeKind::MatchExpression    => {
                // A match used as an expression, including the desugars
                // of `?` and `??`.  Route through the shared arm walker
                // in expression mode so an early `return` inside an arm
                // (the failure arm of a `?`) gets the cumulative drops of
                // every live local, and yielded values are move-tracked.
                const me: MatchExprNode* = expr as MatchExprNode*;
                // No hoist buffer at expression position - the
                // enclosing statement-list isn't reachable from here.
                // A throwaway out buffer plus a null match node tells
                // walk_match_arms to skip flag synthesis and fall back
                // to E0456 for conditional moves (rare in practice for
                // match expressions: stdlib uses Option/Result here,
                // whose payload consumption is tracked via
                // link_payload, not outer-scope move detection).
                mut throwaway_out: StatementNode*[] = [];
                this.walk_match_arms(null, me.subject, me.arms, true,
                    &throwaway_out);
            }
            NodeKind::TryExpression      => {
                // `expr?` is lowered by sema to a `match` expression;
                // route through the same path.  (`desugared` is null only
                // when sema rejected the operand; a diagnostic already
                // fired in that case.)
                const te: TryExprNode* = expr as TryExprNode*;
                if (te.desugared != null) { this.walk_expr_read(te.desugared); }
            }
            NodeKind::LambdaExpression   => { this.read_lambda(expr as LambdaExprNode*); }
            _ => {}
        }
    }

    /// A `move` lambda consumes each non-Copy captured outer binding at
    /// its construction site - mirrors MoveCheck::read_lambda so both
    /// passes agree on the move-set and the outer scope's auto-drop is
    /// suppressed for the consumed binding.  Non-`move` lambdas don't
    /// trigger this path (Copy captures don't drop anyway).
    read_lambda(mut &this, lam: LambdaExprNode*) -> void {
        if (lam == null) { return; }
        if (!lam.is_move) { return; }
        for (mut i: i64 = 0; i < lam.captured_names.length; i++) {
            const cap_name: SymbolStr = lam.captured_names[i];
            const cap_ty:   TypeRef   = lam.captured_types[i];
            if (!cap_ty.is_valid()) { continue; }
            if (this.is_copy(cap_ty)) { continue; }
            mut id: IdentifierNode* = new IdentifierNode(cap_name,
                lam.captured_spans[i]);
            id.set_resolved_type(cap_ty);
            this.handle_ident(id, true);
        }
    }

    read_call(mut &this, c: CallExprNode*) -> void {
        if (c == null) { return; }
        // Recognise `<ident>.drop()` and treat it as a move: the user
        // is explicitly releasing the binding here, so auto-drop must
        // not emit a second `.drop()` at scope exit.  Without this, any
        // file that hand-writes `b.drop();` would double-drop.  Same
        // applies post-stdlib-migration for user code that opts out of
        // auto-drop with an explicit consume.
        if (c.callee != null && c.arguments.length == 0 &&
            c.callee.kind == NodeKind::MemberAccess) {
            const ma: MemberAccessNode* = c.callee as MemberAccessNode*;
            if (ma.member.equals(this.drop_sym) && ma.object != null &&
                ma.object.kind == NodeKind::Identifier) {
                const id: IdentifierNode* = ma.object as IdentifierNode*;
                // Only treat as a move when the identifier is a binding
                // we're tracking (in the types map).  Pattern bindings
                // introduced by `match` arms aren't currently registered,
                // and treating their `.drop()` as a move would inflate
                // the per-arm moved-set and cascade into spurious
                // conditional-move errors at the match join.
                if (id.name.is_valid() && this.lookup_type(id.name).is_valid()) {
                    if (!this.is_moved(id.name)) {
                        this.mark_moved(id.name, id.span);
                    }
                    return;
                }
            }
        }
        // General consuming-method case: any method whose receiver is
        // by-value (`mut this` / `this`) or that carries
        // `![sink]` consumes the LHS at the call site.
        // Walk the receiver in move context; that mirrors what the
        // explicit `.drop()` arm above does, but for any consuming
        // method (e.g. `Box::into_raw`).  This tells the synthesiser
        // not to emit a drop for the consumed binding.
        mut receiver_moved: boolean = false;
        if (c.callee != null && c.callee.kind == NodeKind::MemberAccess) {
            const ma: MemberAccessNode* = c.callee as MemberAccessNode*;
            // Does this method consume its receiver (`![sink]` or by-value
            // `this`)?  Prefer the pinned `resolved_method`; fall back to a
            // receiver-type + method-name lookup when sema left it null (the
            // monomorphized-generic-method case - e.g. `opt.unwrap()`).  The
            // fallback is essential now that drop glue makes the receiver
            // droppable: without it, an `![sink]` combinator that copies a
            // payload out would not mark the receiver moved, and glue would
            // double-free that payload at scope exit.
            mut consumes: boolean = false;
            if (c.resolved_method != null) {
                const m: MethodNode* = c.resolved_method as MethodNode*;
                consumes = OwnershipQuery::method_consumes_receiver(this.arena, this.intern, m);
            }
            if (!consumes && ma.object != null) {
                consumes = OwnershipQuery::type_method_consumes(
                    this.arena, this.registry, this.intern,
                    ma.object.resolved_type, ma.member);
            }
            if (consumes && ma.object != null) {
                this.walk_expr_move(ma.object);
                receiver_moved = true;
            }
        }
        if (!receiver_moved && c.callee != null) {
            this.walk_expr_read(c.callee);
        }
        for (mut i: i64 = 0; i < c.arguments.length; i++) {
            const arg: ExpressionNode* = c.arguments[i];
            if (arg == null) { continue; }
            // Honor the autoref decision sema recorded.  A by-value argument
            // bound to a `&T` parameter is a *borrow*: sema set `autoref` so
            // codegen passes its address, and the callee never takes
            // ownership (the documented borrow model, ref section 16.4).  Walking it
            // in move context would mark the caller's binding as moved and
            // suppress its scope-exit drop, leaking it.  Walk autoref'd
            // borrows in read context; only genuine by-value (`T` param)
            // arguments transfer ownership and are walked as moves.
            if (arg.autoref) {
                this.walk_expr_read(arg);
            } else {
                this.walk_expr_move(arg);
            }
        }
    }

    read_binary(mut &this, b: BinaryExprNode*) -> void {
        if (b == null) { return; }
        if (b.left != null) { this.walk_expr_read(b.left); }
        if (b.right != null) {
            // `lhs = rhs` moves rhs into lhs.  Walk the rhs in move
            // context so a bare-ident rhs of a non-Copy type is marked
            // moved.  Compound assigns (`+=`, `-=`, etc.) read both
            // sides and write the result, so they aren't moves;
            // restrict the move semantics to plain `=`.
            if (b.op.kind == TokenType::Equal) {
                this.walk_expr_move(b.right);
                // Plain `=` to a bare identifier reinitializes that
                // binding: it now owns the rhs result and must be dropped
                // at scope exit.  Clear any stale moved state for the lhs
                // so (a) `x = f(x)` doesn't leave `x` marked moved (which
                // would suppress its scope-exit drop -> leak, and surface
                // as a spurious E0456 conditional-move at branch joins),
                // and (b) `consume(x); x = make();` revives `x`.  Mirrors
                // move_check::read_binary.  unmark_moved here is
                // length-preserving (tombstones in place), so the
                // moves_since_keys/set_moves_tail branch-join checkpoints
                // stay valid.
                if (b.left != null && b.left.kind == NodeKind::Identifier) {
                    this.unmark_moved((b.left as IdentifierNode*).name);
                }
            } else {
                this.walk_expr_read(b.right);
            }
        }
    }

    read_unary(mut &this, u: UnaryExprNode*) -> void {
        if (u == null) { return; }
        if (u.operand != null) { this.walk_expr_read(u.operand); }
    }

    read_member(mut &this, ma: MemberAccessNode*) -> void {
        if (ma == null) { return; }
        if (ma.object != null) { this.walk_expr_read(ma.object); }
    }

    read_array_access(mut &this, aa: ArrayAccessNode*) -> void {
        if (aa == null) { return; }
        if (aa.array != null) { this.walk_expr_read(aa.array); }
        if (aa.index != null) { this.walk_expr_read(aa.index); }
    }

    read_cast(mut &this, cv: CastExprNode*) -> void {
        if (cv == null) { return; }
        if (cv.expression != null) { this.walk_expr_read(cv.expression); }
    }

    read_struct_lit(mut &this, sl: StructLiteralNode*) -> void {
        if (sl == null) { return; }
        for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
            this.walk_expr_move(sl.field_inits[i].value);
        }
    }

    read_tuple_lit(mut &this, tl: TupleLiteralNode*) -> void {
        if (tl == null) { return; }
        for (mut i: i64 = 0; i < tl.elements.length; i++) {
            this.walk_expr_move(tl.elements[i]);
        }
    }

    read_array_lit(mut &this, al: ArrayLiteralNode*) -> void {
        if (al == null) { return; }
        for (mut i: i64 = 0; i < al.elements.length; i++) {
            this.walk_expr_move(al.elements[i]);
        }
    }

    read_ternary(mut &this, t: TernaryExprNode*) -> void {
        if (t == null) { return; }
        if (t.condition != null)  { this.walk_expr_read(t.condition); }
        if (t.true_expr != null)  { this.walk_expr_read(t.true_expr); }
        if (t.false_expr != null) { this.walk_expr_read(t.false_expr); }
    }

    read_if_expr(mut &this, ie: IfExprNode*) -> void {
        if (ie == null) { return; }
        if (ie.condition != null) { this.walk_expr_read(ie.condition); }
        if (ie.then_expr != null) { this.walk_expr_read(ie.then_expr); }
        if (ie.else_expr != null) { this.walk_expr_read(ie.else_expr); }
    }

    read_new(mut &this, n: NewExprNode*) -> void {
        if (n == null) { return; }
        for (mut i: i64 = 0; i < n.arguments.length; i++) {
            this.walk_expr_move(n.arguments[i]);
        }
        // `new T { field: local }` carries its field initializers in
        // struct_init, not arguments.  An owning field-init MOVES the local
        // into the freshly-constructed object (the object now owns that
        // storage), exactly like a bare struct literal.  Without walking
        // struct_init the field-init binding is never marked moved, so the
        // scope-exit drop glue frees storage the new node now aliases - a
        // double free.  array_size (`new T[n]`) is a plain read.
        if (n.struct_init != null) { this.read_struct_lit(n.struct_init); }
        if (n.array_size != null)  { this.walk_expr_read(n.array_size); }
    }

    handle_ident(mut &this, ident: IdentifierNode*, in_move_context: boolean) -> void {
        if (ident == null) { return; }
        const name: SymbolStr = ident.name;
        const ty: TypeRef = this.lookup_type(name);
        if (!ty.is_valid()) { return; }
        if (this.is_copy(ty)) { return; }
        if (in_move_context && !this.is_moved(name)) {
            this.mark_moved(name, ident.span);
        }
    }
}


type struct DropInsertionPass {
    static run(ctx: CompilationContext*) -> PassResult {
        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) { return PassResult::ok(); }
        mut inserter: DropInserter = DropInserter::new(ctx);
        inserter.walk_program(root);
        if (ctx.debug_mode) {
            cdebug("[DropInsertion] %lld drops inserted, %lld diagnostics emitted\n",
                inserter.inserted, inserter.fired);
        }
        return PassResult::ok();
    }
}
