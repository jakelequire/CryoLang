// The tags of a coherence key's parts (`coherence_key_of`).
const COH_FOR: u64        = 1;
const COH_ARGS: u64       = 2;
const COH_WHERE: u64      = 3;
const COH_PARAM: u64      = 4;
const COH_PROJECTION: u64 = 5;
const COH_DEF: u64        = 6;
const COH_TYPE: u64       = 7;
const COH_NONE: u64       = 8;
const COH_GENERIC: u64    = 9;
const COH_REF: u64        = 10;
const COH_REF_MUT: u64    = 11;
const COH_POINTER: u64    = 12;
const COH_ARRAY: u64      = 13;
const COH_TUPLE: u64      = 14;
const COH_THIS: u64       = 15;
const COH_OTHER: u64      = 16;


/// A trait's terms as one implementation of it reads them: `This` is
/// `owner`, written either bare or over the head's own arguments
/// (`self_args`); `subst` maps the trait's parameters (and a method's own)
/// to the implementation's; `assoc[i]` is what the implementation binds the
/// `i`-th associated type of `trait_ty` to, invalid where it binds none.
type struct ImplTerms {
    trait_ty:  TypeRef;
    this_ph:   TypeRef;
    owner:     TypeRef;
    self_args: [TypeRef];
    subst:     TypeSubstitution;
    assoc:     [TypeRef];
}

/// The walk over one implementation's copy of a trait's default body that
/// answers each `This::member` the trait stamped as its implementor with
/// the implementing type, `owner`, written with the block's own parameters
/// `params` (`ScopeResolutionExpr::name_implementor`).
type struct ImplementorStamp {
    owner:  ResBase;
    params: [DeclarationNode*];
}

implement trait Walk for struct ImplementorStamp {
    walk_scope_resolution(mut &this, e: ExpressionNode*, node: ScopeResolutionExpr*) -> void {
        node.name_implementor(this.owner, &this.params, e.span);
    }
}


// TypeResolutionRunner: holds shared resolution state for pass methods

/// Bundles the shared state needed by all type resolution helpers.
/// Constructed once per pass invocation, then methods are called on it
/// instead of threading (resolver, res_ctx, ctx) through every call.
type struct TypeResolutionRunner {
    arena:           TypeArena*;
    resolver:        TypeResolver*;
    ctx:             CompilationContext*;
    res_ctx:         ResolutionContext;

    static new(ctx: CompilationContext*) -> TypeResolutionRunner {
        mut runner: TypeResolutionRunner;
        runner.arena           = ctx.type_arena;
        runner.resolver        = ctx.type_resolver;
        runner.ctx             = ctx;
        runner.res_ctx         = ResolutionContext::new(ctx.source_file);
        return runner;
    }

    // Generic context helpers

    /// For each generic parameter, creates a GenericParamType in the arena and
    /// adds a binding (e.g., T -> GenericParamType(T, 0)) to the resolution context.
    bind_generic_params(&this, generic_params: &[DeclarationNode*],
                        res_ctx: ResolutionContext*) -> void {
        const refs: [TypeRef] = TypeResolutionPasses::create_generic_param_types(
            generic_params, this.arena);
        for (mut i: i64 = 0; i < generic_params.length(); i++) {
            const gp_decl: DeclarationNode* = generic_params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            res_ctx.add_binding(gp.sym_id, gp.name, refs[i]);
        }
    }

    /// If `generic_params` is non-empty, creates a copy of `base_ctx` with
    /// generic param types bound.  Otherwise returns `base_ctx` as-is.
    make_generic_context(&this, generic_params: &[DeclarationNode*],
                         base_ctx: ResolutionContext*) -> ResolutionContext {
        mut result: ResolutionContext = base_ctx.clone();
        if (generic_params.length() > 0) {
            this.bind_generic_params(generic_params, &result);
        }
        return result;
    }

    /// For a trait impl block (`impl Foo<X> for Bar<Y>`), bind the trait's
    /// outer generic params to the impl's trait args inside `res_ctx` so
    /// that cloned default-method bodies can resolve names like the
    /// trait's `Item` parameter.  Without this, `synthesize_default_trait_methods`
    /// clones a method like `Iterator<Item>::fold<Acc>(... f: (Acc, Item) -> Acc ...)`
    /// into the impl, then `resolve_method_signatures` runs with only the
    /// impl's own generics in scope; `Item` lookup misses, the function-type
    /// resolution returns a TypeRef whose internal param list contains an
    /// invalid `Item` slot, and the wrong mangled symbol is computed (or a
    /// hard panic in `encode_type_ref` fires once the silent "v" fallback
    /// is removed).  Resolves the trait_decl by leaf name; no-op if the
    /// trait isn't generic, the annotation isn't a `Generic(...)`, or the
    /// arg count doesn't match the trait's param count.
    bind_trait_args_for_impl(&this, impl_node: ImplBlock*,
                              res_ctx: ResolutionContext*) -> void {
        if (impl_node == null || !impl_node.is_trait_impl()) { return; }

        // The trait annotation must be a Generic(base, args) for there to
        // be any args to bind.  Non-generic traits (e.g. `impl Drop for Foo`)
        // have no outer params and need no binding work.
        const trait_ann: TypeAnnotation* = impl_node.trait_annotation;
        if (trait_ann == null) { return; }
        // Read the trait args in place through the node (peel_to_generic
        // returns the owning node, not a droppable copy of its args).
        const gen: GenericAnnotation* = TypeResolutionPasses::peel_to_generic(trait_ann);
        if (gen == null || gen.args.length() == 0) { return; }
        const trait_id: DefId = TypeAnnotation::trait_def(trait_ann);
        if (!trait_id.is_valid()) { return; }
        const trait_decl: TraitDecl* = this.ctx.generic_registry.get_trait_decl(trait_id);
        if (trait_decl == null) { return; }

        const ngp: i64   = trait_decl.generic_params.length();
        const nargs: i64 = gen.args.length();

        // Legacy generic-param trait (e.g. the pre-migration `Iterator<Item>`):
        // exact-arity positional binding, mapping trait param[i] -> impl arg[i]
        // (`Iterator<T>` binds `Item -> T`). Arity mismatch is a user error
        // caught elsewhere; bail silently (preserves prior behavior exactly).
        if (ngp > 0) {
            if (ngp != nargs) { return; }
            mut written: [TypeRef] = [];
            for (mut i: i64 = 0; i < nargs; i++) {
                const gp_decl: DeclarationNode* = trait_decl.generic_params[i];
                const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
                if (gp == null) { continue; }
                const arg_ty: TypeRef = this.resolver.resolve(gen.args[i], res_ctx);
                if (!arg_ty.is_valid()) { continue; }
                res_ctx.add_binding(gp.sym_id, gp.name, arg_ty);
                written.push(arg_ty);
            }
            if (written.length() == nargs) { impl_node.trait_arg_types = written; }
            return;
        }

        // Associated-type positional sugar: a trait with 0 generic params and
        // exactly 1 associated type binds that associated type from a single
        // positional arg - `implement Iterator<T>` => `Item -> T`. Binds
        // `This::Item` in the impl context so a cloned trait default's body
        // resolves it, and records the binding on the impl node so a
        // concrete `X::Item` projection can look it up.
        if (trait_decl.assoc_types.length() == 1 && nargs == 1) {
            const adecl: AssocTypeDeclNode* = trait_decl.assoc_types[0];
            if (adecl != null) {
                const arg_ty: TypeRef = this.resolver.resolve(gen.args[0], res_ctx);
                if (arg_ty.is_valid()) {
                    res_ctx.add_assoc_binding(trait_id, 0, arg_ty);
                }
                if (impl_node.assoc_binding_at(trait_decl, 0) == null) {
                    impl_node.bind_assoc_slot(0, gen.args[0]);
                }
            }
        }
    }

    /// Stage-5 associated-type diagnostics, run once per source-level trait
    /// impl during the function-signature phase (after
    /// `bind_trait_args_for_impl` has recorded any positional-sugar binding).
    /// Emits two user-facing errors that the silent-bail binding path above
    /// would otherwise leave undiagnosed:
    ///
    ///   * **E0310** - the trait has generic *params* and the impl tried to
    ///     bind an associated type *positionally* (more `<...>` args than the
    ///     trait has generic params).  Decision #6: positional args fill the
    ///     generic params only; an associated type of such a trait must be
    ///     bound by name (`Out = ...`).
    ///   * **E0309** - the trait declares associated types but this impl binds
    ///     none of them (no positional-sugar arg and no `type Item = ...;`
    ///     body form), so a `This::Item` projection would never reduce.
    ///
    /// A trait with no associated types is untouched (returns immediately), so
    /// every legacy / non-assoc impl is unaffected.
    validate_impl_assoc_bindings(&this, impl_decl: DeclarationNode*, impl_node: ImplBlock*) -> void {
        if (impl_node == null || !impl_node.is_trait_impl()) { return; }
        const trait_ann: TypeAnnotation* = impl_node.trait_annotation;
        if (trait_ann == null) { return; }
        const trait_id: DefId = TypeAnnotation::trait_def(trait_ann);
        if (!trait_id.is_valid()) { return; }
        const trait_decl: TraitDecl* = this.ctx.generic_registry.get_trait_decl(trait_id);
        if (trait_decl == null) { return; }
        // Only traits with associated types are subject to these checks.
        if (trait_decl.assoc_types.length() == 0) { return; }

        const intern: InternTable* = this.ctx.get_intern_table();
        // The diagnostic names the trait the way the author spelled it; the
        // identity above is for the lookup, not for the message.
        const trait_name: string = intern.resolve(
            TypeResolutionPasses::extract_trait_leaf(trait_ann));
        const span: SourceSpan = if (impl_node.target_type_span.has_location()) {
            impl_node.target_type_span
        } else {
            impl_decl.span
        };

        const ngp: i64 = trait_decl.generic_params.length();
        const gen: GenericAnnotation* = TypeResolutionPasses::peel_to_generic(trait_ann);
        const nargs: i64 = if (gen == null) { 0 } else { gen.args.length() };

        // E0310: positional associated-type binding while the trait also has
        // generic params.  The extra positional args (beyond `ngp`) can only be
        // an attempt to bind an associated type positionally, which is rejected.
        if (ngp > 0 && nargs > ngp) {
            const adecl0: AssocTypeDeclNode* = trait_decl.assoc_types[0];
            const aname: string = if (adecl0 == null) {
                "the associated type"
            } else {
                intern.resolve(adecl0.name)
            };
            this.ctx.emit_error_at(
                ErrorCode::E0310_POSITIONAL_ASSOC_WITH_GENERICS,
                fmt::format(
                    "trait `%s` has generic parameters; its positional args bind only the generic params, so bind associated type `%s` in the impl body (`type %s = ...;`)",
                    trait_name, aname, aname),
                span);
            return;
        }

        // E0309: a declared associated type left unbound by this impl.  After
        // `bind_trait_args_for_impl`, every bound assoc type (positional sugar
        // or `type Item = ...;` body form) is recorded on the impl node; an
        // unrecorded one is genuinely unbound.
        for (mut i: i64 = 0; i < trait_decl.assoc_types.length(); i++) {
            const adecl: AssocTypeDeclNode* = trait_decl.assoc_types[i];
            if (adecl == null) { continue; }
            if (impl_node.assoc_binding_at(trait_decl, i) != null) { continue; }
            // The implicit `<Method>Fut` of an `async` trait method is bound by
            // the impl's own `async` method, not written by the user — and that
            // binding is added by the sema-time lowering, which has not run yet.
            // Requiring it here would make every async trait impl an error.
            if (TypeResolutionPasses::impl_binds_assoc_via_async(
                    impl_node, trait_decl, i, this.ctx)) { continue; }
            const aname: string = intern.resolve(adecl.name);
            this.ctx.emit_error_at(
                ErrorCode::E0309_ASSOC_TYPE_NOT_BOUND,
                fmt::format(
                    "associated type `%s` not bound in this impl of trait `%s`",
                    aname, trait_name),
                span);
        }
    }

    /// An implementation's methods against its trait's (E0312): each method
    /// the trait declares without a body is written, each method written is
    /// one the trait declares, and each agrees with the trait's declaration -
    /// static or with a receiver, the receiver's form, the number of its own
    /// type parameters, each parameter's type and the return.  The trait's
    /// signature is read in the implementation's terms: `This` is the type
    /// implemented for, the trait's parameters are the head's arguments, its
    /// associated types are the implementation's bindings, and the method's
    /// own type parameters are the written method's, by position.  Run where
    /// every signature is final, on the blocks the source wrote; the copies
    /// of a trait's defaults agree by construction and are not compared.
    check_impl_conformance(&this, impl_decl: DeclarationNode*, impl_node: ImplBlock*,
                           impl_ctx: ResolutionContext*) -> void {
        if (impl_node == null || !impl_node.is_trait_impl()) { return; }
        if (impl_node.spec_owner.is_valid()) { return; }
        const trait_id: DefId = TypeAnnotation::trait_def(impl_node.trait_annotation);
        if (!trait_id.is_valid()) { return; }
        const decl: TraitDecl* = this.ctx.generic_registry.get_trait_decl(trait_id);
        if (decl == null) { return; }
        const owner: TypeRef = this.ctx.decl_index.impl_owner(impl_node, "type_resolution/impl conformance");
        if (!owner.is_valid()) { return; }
        const intern: InternTable* = this.ctx.get_intern_table();
        const trait_name: string = intern.resolve(
            TypeResolutionPasses::extract_trait_leaf(impl_node.trait_annotation));
        const head_span: SourceSpan = if (impl_node.target_type_span.has_location()) {
            impl_node.target_type_span
        } else {
            impl_decl.span
        };
        if (trait_id.equals(this.ctx.generic_registry.wellknown(LangItem::Allocate))) {
            this.check_allocate_owner(owner, head_span);
        }

        mut terms: ImplTerms = ImplTerms {
            trait_ty:  this.ctx.decl_index.type_of_decl(trait_id, "type_resolution/impl conformance"),
            this_ph:  this.arena.this_placeholder(this.ctx.intern("This")),
            owner:     owner,
            self_args: [],
            subst:     TypeSubstitution::empty(),
            assoc:     [],
        };
        for (mut ai: i64 = 0; ai < impl_node.target_args.length(); ai++) {
            terms.self_args.push(this.resolver.resolve(impl_node.target_args[ai], impl_ctx));
        }
        if (impl_node.trait_arg_types.length() == decl.generic_params.length()) {
            for (mut gi: i64 = 0; gi < decl.generic_params.length(); gi++) {
                const gp_decl: DeclarationNode* = decl.generic_params[gi];
                const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
                if (gp == null) { continue; }
                terms.subst.add(this.arena.create_generic_param(gp.sym_id, gp.name, gi as u64),
                                impl_node.trait_arg_types[gi]);
            }
        }
        for (mut si: i64 = 0; si < decl.assoc_types.length(); si++) {
            const bound: TypeAnnotation* = impl_node.assoc_binding_at(decl, si);
            terms.assoc.push(if (bound != null) { this.resolver.resolve(bound, impl_ctx) } else { TypeRef::invalid() });
        }

        for (mut ti: i64 = 0; ti < decl.methods.length(); ti++) {
            const tm_decl: DeclarationNode* = decl.methods[ti];
            const tm: FunctionDecl* = DeclarationNode::fn_of(tm_decl);
            if (tm == null || tm.has_body()) { continue; }
            if (this.ctx.generic_registry.writes_trait_item(impl_node, trait_id, ti)) { continue; }
            this.report_conformance(head_span,
                fmt::format("this implementation of trait `%s` is missing `%s`",
                    trait_name, intern.resolve(tm.name)));
        }

        for (mut mi: i64 = 0; mi < impl_node.methods.length(); mi++) {
            const m_decl: DeclarationNode* = impl_node.methods[mi];
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m == null || m.func == null || DeclarationNode::fn_of(m.func).is_synth_default || m.spec_of != null) { continue; }
            const name: string = intern.resolve(DeclarationNode::fn_of(m.func).name);
            const slot: i64 = this.ctx.generic_registry.trait_item_slot(trait_id, DeclarationNode::fn_of(m.func).name);
            if (slot < 0) {
                this.report_conformance(m.func.span,
                    fmt::format("`%s` is not a method of trait `%s`", name, trait_name));
                continue;
            }
            // A method's own parameters are mapped by position; each
            // declaration's are distinct types, so one map serves every method.
            const tm_decl: DeclarationNode* = decl.methods[slot];
            const tm: FunctionDecl* = DeclarationNode::fn_of(tm_decl);
            if (tm.generic_params.length() == DeclarationNode::fn_of(m.func).generic_params.length()) {
                for (mut gi: i64 = 0; gi < tm.generic_params.length(); gi++) {
                    const tg_decl: DeclarationNode* = tm.generic_params[gi];
                    const tg: GenericParamDecl* = DeclarationNode::generic_param_of(tg_decl);
                    const fg_decl: DeclarationNode* = DeclarationNode::fn_of(m.func).generic_params[gi];
                    const fg: GenericParamDecl* = DeclarationNode::generic_param_of(fg_decl);
                    if (tg == null || fg == null) { continue; }
                    terms.subst.add(this.arena.create_generic_param(tg.sym_id, tg.name, gi as u64),
                                    this.arena.create_generic_param(fg.sym_id, fg.name, gi as u64));
                }
            }
            this.check_method_conformance(tm_decl, m_decl, &terms, name, trait_name);
        }
    }

    /// One written method `m` against the trait's declaration `tm` of it,
    /// read in `terms` (above).
    check_method_conformance(&this, tm_decl: DeclarationNode*, m_decl: DeclarationNode*, terms: &ImplTerms,
                             name: string, trait_name: string) -> void {
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        const tm: FunctionDecl* = DeclarationNode::fn_of(tm_decl);
        const f_decl: DeclarationNode* = m.func;
        const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
        if (tm.is_static != m.is_static) {
            const want: string = if (tm.is_static) { "is static" } else { "takes a receiver" };
            const have: string = if (m.is_static) { "is static" } else { "takes a receiver" };
            this.report_conformance(f_decl.span,
                fmt::format("`%s` %s in trait `%s`, but %s here", name, want, trait_name, have));
            return;
        }
        if (tm.generic_params.length() != f.generic_params.length()) {
            this.report_conformance(f_decl.span,
                fmt::format("`%s` has %lld type parameter(s) in trait `%s`, but %lld here",
                    name, tm.generic_params.length(), trait_name, f.generic_params.length()));
            return;
        }

        const trecv: DeclarationNode* = TypeResolutionRunner::receiver_of(tm_decl);
        const frecv: DeclarationNode* = TypeResolutionRunner::receiver_of(f_decl);
        if (trecv != null && frecv != null) {
            const tform: string = TypeResolutionRunner::receiver_spelling(DeclarationNode::var_of(trecv));
            const fform: string = TypeResolutionRunner::receiver_spelling(DeclarationNode::var_of(frecv));
            if (!tform.equals(fform)) {
                this.report_conformance(frecv.span,
                    fmt::format("`%s` takes `%s` in trait `%s`, but `%s` here", name, tform, trait_name, fform));
                return;
            }
        }

        const tcount: i64 = TypeResolutionRunner::value_param_count(tm_decl);
        const fcount: i64 = TypeResolutionRunner::value_param_count(f_decl);
        if (tcount != fcount) {
            this.report_conformance(f_decl.span,
                fmt::format("`%s` takes %lld parameter(s) in trait `%s`, but %lld here",
                    name, tcount, trait_name, fcount));
            return;
        }
        for (mut pi: i64 = 0; pi < tcount; pi++) {
            const tp: VarDecl* = DeclarationNode::var_of(TypeResolutionRunner::value_param_at(tm_decl, pi));
            const fp_decl: DeclarationNode* = TypeResolutionRunner::value_param_at(f_decl, pi);
            const fp: VarDecl* = DeclarationNode::var_of(fp_decl);
            if (this.same_type(tp.resolved_type, fp.resolved_type, terms, true)) { continue; }
            this.report_conformance(fp_decl.span,
                fmt::format("parameter %lld of `%s` is `%s` in trait `%s`, but `%s` here",
                    pi + 1, name, this.shown_type(tp.resolved_type), trait_name,
                    this.shown_type(fp.resolved_type)));
        }
        // An `async` method's return is its future, which the trait spells as
        // a projection and the implementation's lowering builds later.
        if (tm.is_async || f.is_async) {
            if (tm.is_async != f.is_async) {
                this.report_conformance(f_decl.span,
                        fmt::format("`%s` is %s in trait `%s`, but %s here", name,
                        if (tm.is_async) { "async" } else { "not async" }, trait_name,
                        if (f.is_async) { "async" } else { "not async" }));
            }
            return;
        }
        if (!this.same_type(tm.resolved_return_type, f.resolved_return_type, terms, true)) {
            this.report_conformance(f_decl.span,
                fmt::format("`%s` returns `%s` in trait `%s`, but `%s` here",
                    name, this.shown_type(tm.resolved_return_type), trait_name,
                    this.shown_type(f.resolved_return_type)));
        }
    }

    /// Whether the trait's type `t` is the implementation's `f` once the
    /// trait's terms are read in the implementation's (`terms`), `t` taken
    /// in the trait's terms while `trait_side` holds and in the
    /// implementation's once a term has been replaced.  Walks the two side
    /// by side and builds no type, so asking leaves the arena as it was.  An
    /// unresolved side is not a disagreement: its own diagnostic is already
    /// reported.
    same_type(&this, t: TypeRef, f: TypeRef, terms: &ImplTerms, trait_side: boolean) -> boolean {
        if (!t.is_valid() || !f.is_valid()) { return true; }
        if (t.equals(f)) { return true; }
        const tt: Type* = this.arena.lookup(t);
        const ft: Type* = this.arena.lookup(f);
        if (tt == null || ft == null) { return true; }
        if (trait_side && t.equals(terms.this_ph)) { return this.is_self(f, terms); }
        if (trait_side && tt.kind == TypeKind::GenericParam) {
            const r: TypeRef = terms.subst.get(t);
            return r.is_valid() && this.same_type(r, f, terms, false);
        }
        if (tt.kind == TypeKind::AssocProjection) {
            const bound: TypeRef = this.bound_projection(tt.as_assoc_projection(), terms, trait_side);
            if (bound.is_valid()) { return this.same_type(bound, f, terms, false); }
        }
        if (ft.kind == TypeKind::AssocProjection) {
            const bound: TypeRef = this.bound_projection(ft.as_assoc_projection(), terms, false);
            if (bound.is_valid()) { return this.same_type(t, bound, terms, trait_side); }
        }
        if (tt.kind != ft.kind) { return false; }
        return match (tt.kind) {
            TypeKind::Pointer => {
                const a: PointerType* = tt.as_pointer();
                const b: PointerType* = ft.as_pointer();
                a.const_pointee == b.const_pointee && this.same_type(a.pointee, b.pointee, terms, trait_side)
            }
            TypeKind::Reference => {
                const a: ReferenceType* = tt.as_reference();
                const b: ReferenceType* = ft.as_reference();
                a.mutability == b.mutability && this.same_type(a.referent, b.referent, terms, trait_side)
            }
            TypeKind::Array => {
                const a: ArrayType* = tt.as_array();
                const b: ArrayType* = ft.as_array();
                a.size == b.size && this.same_type(a.element, b.element, terms, trait_side)
            }
            TypeKind::Optional => {
                const a: OptionalType* = tt.as_optional();
                const b: OptionalType* = ft.as_optional();
                this.same_type(a.wrapped, b.wrapped, terms, trait_side)
            }
            TypeKind::Function => {
                const a: FunctionType* = tt.as_function();
                const b: FunctionType* = ft.as_function();
                this.same_types(&a.param_types, &b.param_types, terms, trait_side)
                    && this.same_type(a.return_type, b.return_type, terms, trait_side)
            }
            TypeKind::Tuple => {
                const a: TupleType* = tt.as_tuple();
                const b: TupleType* = ft.as_tuple();
                this.same_types(&a.elements, &b.elements, terms, trait_side)
            }
            TypeKind::InstantiatedType => {
                const a: InstantiatedType* = tt.as_instantiated();
                const b: InstantiatedType* = ft.as_instantiated();
                a.generic_base.equals(b.generic_base)
                    && this.same_types(&a.type_args, &b.type_args, terms, trait_side)
            }
            _ => { false }
        };
    }

    same_types(&this, a: &[TypeRef], b: &[TypeRef], terms: &ImplTerms, trait_side: boolean) -> boolean {
        if (a.length() != b.length()) { return false; }
        for (mut i: i64 = 0; i < a.length(); i++) {
            if (!this.same_type(a[i], b[i], terms, trait_side)) { return false; }
        }
        return true;
    }

    /// Whether `f` is the type implemented for: the owner as the head names
    /// it, or the owner over the head's own arguments (`Wrap<T>` in
    /// `implement<T> trait Tr for Wrap<T>`).
    is_self(&this, f: TypeRef, terms: &ImplTerms) -> boolean {
        if (f.equals(terms.owner)) { return true; }
        const ft: Type* = this.arena.lookup(f);
        if (ft == null || ft.kind != TypeKind::InstantiatedType) { return false; }
        const inst: InstantiatedType* = ft.as_instantiated();
        if (!inst.generic_base.equals(terms.owner)) { return false; }
        if (inst.type_args.length() != terms.self_args.length()) { return false; }
        for (mut i: i64 = 0; i < inst.type_args.length(); i++) {
            if (!inst.type_args[i].equals(terms.self_args[i])) { return false; }
        }
        return true;
    }

    /// The type projection `p` names: the implementation's binding when its
    /// base is the type implemented for, else the binding the base's own
    /// implementation gives; invalid when neither answers.
    bound_projection(&this, p: AssocProjectionType*, terms: &ImplTerms, trait_side: boolean) -> TypeRef {
        mut base: TypeRef = p.base;
        if (trait_side) {
            if (base.equals(terms.this_ph)) { base = terms.owner; }
            const mapped: TypeRef = terms.subst.get(base);
            if (mapped.is_valid()) { base = mapped; }
        }
        if (p.owning_trait.equals(terms.trait_ty) && this.is_self(base, terms)) {
            if (p.slot >= 0 && p.slot < terms.assoc.length()) { return terms.assoc[p.slot]; }
            return TypeRef::invalid();
        }
        return this.resolver.concrete_projection(if (this.is_self(base, terms)) { terms.owner } else { base },
                                                 p.slot, p.owning_trait);
    }

    shown_type(&this, ty: TypeRef) -> string {
        const t: Type* = this.arena.lookup(ty);
        return if (t != null) { this.arena.format_display(t) } else { "?" };
    }

    static receiver_of(f_decl: DeclarationNode*) -> DeclarationNode* {
        const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
        for (mut i: i64 = 0; i < f.parameters.length(); i++) {
            const p_decl: DeclarationNode* = f.parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p != null && p.is_receiver()) { return p_decl; }
        }
        return null;
    }

    static value_param_count(f_decl: DeclarationNode*) -> i64 {
        const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
        mut n: i64 = 0;
        for (mut i: i64 = 0; i < f.parameters.length(); i++) {
            const p_decl: DeclarationNode* = f.parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p != null && !p.is_receiver()) { n += 1; }
        }
        return n;
    }

    /// The `k`-th parameter after the receiver.
    static value_param_at(f_decl: DeclarationNode*, k: i64) -> DeclarationNode* {
        const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
        mut n: i64 = 0;
        for (mut i: i64 = 0; i < f.parameters.length(); i++) {
            const p_decl: DeclarationNode* = f.parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p == null || p.is_receiver()) { continue; }
            if (n == k) { return p_decl; }
            n += 1;
        }
        return null;
    }

    /// The receiver as written: `this`, `&this` or `mut &this`.
    static receiver_spelling(p: VarDecl*) -> string {
        if (p.is_value_receiver()) { return "this"; }
        return if (p.is_mutable) { "mut &this" } else { "&this" };
    }

    /// The type an `Allocate` implementation is for.  Only a struct's `new`
    /// takes memory from an implementation, so one for any other type would
    /// never run (E0312).
    check_allocate_owner(&this, owner: TypeRef, head_span: SourceSpan) -> void {
        const t: Type* = this.arena.lookup(owner);
        if (t == null) { return; }
        const shown: string = this.shown_type(owner);
        if (t.kind != TypeKind::Struct) {
            mut d: Diagnostic = Diagnostic::error(ErrorCode::E0312_TRAIT_IMPL_MISMATCH,
                fmt::format("trait `Allocate` can be implemented only for a struct, and `%s` is not one",
                    shown));
            d = d.at_with_label(head_span, "`new` of this type never calls an `Allocate` implementation");
            this.ctx.emit_diagnostic(d);
        }
    }

    report_conformance(&this, span: SourceSpan, msg: string) -> void {
        this.ctx.emit_error_at(ErrorCode::E0312_TRAIT_IMPL_MISMATCH, msg, span);
    }


    /// Register the module-level variable `var_node`, whose type is known,
    /// under its definition.  The module recorded with it is the one it is
    /// mangled under and the one a qualified path names it through: a
    /// C-imported global (an anonymous-enum constant) the alias's
    /// (`cit::NAME`), any other the writing module's.  A global with a
    /// written type is registered by type resolution; one whose type is its
    /// initializer's, by sema once the initializer is typed.
    static register_module_global(ctx: CompilationContext*, decl: DeclarationNode*,
                                  var_node: VarDecl*) -> void {
        const gmod_sym: SymbolStr = ctx.intern(ctx.source_file);
        mut g_ns: ModulePath = ModulePath::none();
        const g_key: SymbolStr = ctx.decl_global_key(
            var_node.name, var_node.binding_namespace, decl.span.file, &g_ns);
        const owner: DefId = if (var_node.owner != null) { ctx.defs.parent_of(var_node.def) } else { DefId::invalid() };
        ctx.decl_index.register_global(
            var_node.def, g_key, var_node.resolved_type, gmod_sym, g_ns,
            var_node.is_thread_local, owner);
        ctx.decl_index.set_decl_visibility(var_node.def, var_node.visibility);
        TypeResolutionRunner::record_extern_symbol(ctx, var_node);
    }

    /// Record, on the global's registration, the linker symbol an IMPORTED
    /// global binds - its `![symbol("...")]` override when it has one, else
    /// its declared name.  A no-op for a global Cryo defines, which is mangled
    /// under its namespace.  The directive pass runs after this and re-records
    /// the override on the same slot.
    static record_extern_symbol(ctx: CompilationContext*, node: VarDecl*) -> void {
        if (!node.is_extern_import) { return; }
        const sym: SymbolStr = if (node.link_name.length() > 0) {
            ctx.intern(node.link_name)
        } else {
            node.name
        };
        ctx.decl_index.record_global_extern_symbol(node.def, sym);
    }

    /// Report an annotation the type layer could not resolve, at a
    /// declaration site (`kind_label` and `decl_name` name it in the
    /// headline).  A name in it the name layer refused was reported where it
    /// was written and the annotation's failure is that refusal's
    /// consequence, so it is not reported again; what remains is an
    /// annotation whose every written name is placed and that still names
    /// no type, reported at the declaration's span.
    emit_undefined_type(&this, ann: TypeAnnotation*,
                        kind_label: string, decl_name: string,
                        fallback_span: SourceSpan) -> void {
        if (TypeAnnotation::refused(ann)) { return; }
        this.ctx.emit_error_at(ErrorCode::E0203_UNDEFINED_TYPE,
            fmt::format("cannot resolve %s for `%s`", kind_label, decl_name),
            fallback_span);
    }


    // Signature and field resolution helpers

    /// Resolves the return type annotation and all parameter type annotations
    /// on a FunctionDecl.  Delegates core resolution to TypeResolver, then
    /// emits diagnostics and writes back to the Resolver's symbol table.
    resolve_func_signature(&this, func_decl: DeclarationNode*,
                           res_ctx: ResolutionContext*) -> void {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null) { return; }

        // Core resolution (return type + param types)
        this.resolver.resolve_func_signature(func_decl, res_ctx);

        this.emit_signature_diagnostics(func_decl);
    }

    /// Reports a signature whose return or parameter annotation did not
    /// resolve.  A failed annotation leaves `resolved_type` unset rather than
    /// poisoned, and every consumer downstream reads an unset param as `void`,
    /// so a signature that is never reported here is not merely undiagnosed -
    /// it silently acquires a different type than the one written.
    ///
    /// Call this once per function, at the point its signature resolution is
    /// FINAL.  Impl-block and inline methods are resolved twice (an early pass
    /// runs before the owner type exists in the arena, and a later one repairs
    /// what that missed), so reporting from the resolution helper itself would
    /// report the first pass's misses as errors.
    emit_signature_diagnostics(&this, func_decl: DeclarationNode*) -> void {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null) { return; }

        if (func.return_type_annotation != null && !func.has_resolved_return_type()) {
            this.emit_undefined_type(func.return_type_annotation,
                "return type", this.ctx.resolve_str(func.name), func_decl.span);
        }

        // Sema reads param types directly from the AST node (param.resolved_type)
        // via enter_function() -> declare().
        for (mut i: i64 = 0; i < func.parameters.length(); i++) {
            const param_decl: DeclarationNode* = func.parameters[i];
            const param: VarDecl* = DeclarationNode::var_of(param_decl);
            if (param == null) { continue; }
            if (param.type_annotation != null && !param.resolved_type.is_valid()) {
                // The receiver is not a written annotation and has no import
                // that would fix it: `resolve_method_signatures` back-fills it
                // from the owner type, and leaves it unset when the owner is
                // not yet in the arena.  Its annotation carries the impl's
                // target-type name and span, so reporting it names the impl
                // header rather than anything the author can act on.
                if (param.is_receiver()) { continue; }
                this.emit_undefined_type(param.type_annotation,
                    "type", this.ctx.resolve_str(param.name), param_decl.span);
            }
        }
    }

    /// `emit_signature_diagnostics` over a struct/union/impl method list.
    emit_method_signature_diagnostics(&this, methods: &[DeclarationNode*]) -> void {
        for (mut i: i64 = 0; i < methods.length(); i++) {
            const method_decl: DeclarationNode* = methods[i];
            const method: MethodDecl* = DeclarationNode::method_of(method_decl);
            if (method == null || method.func == null) { continue; }
            this.emit_signature_diagnostics(method.func);
        }
    }

    /// `emit_signature_diagnostics` over a trait's method list.
    emit_trait_method_signature_diagnostics(&this,
                                            methods: &[DeclarationNode*]) -> void {
        for (mut i: i64 = 0; i < methods.length(); i++) {
            const func_decl: DeclarationNode* = methods[i];
            const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
            if (func == null) { continue; }
            this.emit_signature_diagnostics(func_decl);
        }
    }

    /// Resolves type annotations on a type's field declarations.
    resolve_fields(&this, fields: &[DeclarationNode*],
                   res_ctx: ResolutionContext*) -> void {
        // Core resolution
        this.resolver.resolve_fields(fields, res_ctx);

        // Emit diagnostics for unresolved fields
        for (mut i: i64 = 0; i < fields.length(); i++) {
            const field_decl: DeclarationNode* = fields[i];
            const field: FieldDecl* = DeclarationNode::field_of(field_decl);
            if (field == null) { continue; }
            if (field.type_annotation != null && !field.resolved_type.is_valid()) {
                this.emit_undefined_type(field.type_annotation,
                    "type", this.ctx.resolve_str(field.name), field_decl.span);
            }
        }
    }

    /// Resolves all method signatures ([DeclarationNode*]) on a struct/impl.
    /// `owner_type` lets the resolver back-fill `this`/`&this` resolved_type
    /// (the parser leaves the receiver param's type unset).
    resolve_method_signatures(&this, methods: &[DeclarationNode*],
                              res_ctx: ResolutionContext*,
                              owner_type: TypeRef,
                              owner_def: DefId,
                              owner_args: &[TypeRef]) -> void {
        this.resolver.resolve_method_signatures(methods, res_ctx, owner_type, owner_def, owner_args);
    }

    /// A generic declaration's own parameters, as `res_ctx` binds them: the
    /// arguments its inline methods' `This` is the declaration over.
    decl_owner_args(&this, generic_params: &[DeclarationNode*],
                    res_ctx: ResolutionContext*) -> [TypeRef] {
        mut out: [TypeRef] = [];
        for (mut i: i64 = 0; i < generic_params.length(); i++) {
            const gp_decl: DeclarationNode* = generic_params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            out.push(if (gp != null) { res_ctx.lookup_binding(gp.sym_id) } else { TypeRef::invalid() });
        }
        return out;
    }

    /// The type arguments an impl head writes after `for` (`<T>` in
    /// `implement<T> trait Dup for Wrap<T>`): the arguments its methods'
    /// `This` is the owner over.
    impl_owner_args(&this, impl_node: ImplBlock*, res_ctx: ResolutionContext*) -> [TypeRef] {
        mut out: [TypeRef] = [];
        for (mut i: i64 = 0; i < impl_node.target_args.length(); i++) {
            out.push(this.resolver.resolve(impl_node.target_args[i], res_ctx));
        }
        return out;
    }

    /// Repair the signatures of a struct/union's *inline* methods during
    /// the TypeResolution pass, once the owner type exists.  The
    /// DeclarationCollection FunctionSignature pass resolves these methods
    /// before the owning type is registered, so its owner lookup returns
    /// invalid and a by-value `this` receiver (which carries no annotation)
    /// is left without a resolved_type.  `owner` is the declaration's own
    /// definition, the one the type-declaration stage registered it under,
    /// so the receiver back-fill in `Resolver::resolve_method_signatures`
    /// runs.  Idempotent for already-resolved return/param types.
    resolve_inline_method_signatures(&this, owner: DefId,
                                     methods: &[DeclarationNode*],
                                     generic_params: &[DeclarationNode*],
                                     res_ctx: ResolutionContext*) -> void {
        const owner_ty: TypeRef = this.ctx.decl_index.type_of_def(owner);
        if (owner_ty.is_invalid()) { return; }
        const args: [TypeRef] = this.decl_owner_args(generic_params, res_ctx);
        this.resolver.resolve_method_signatures(methods, res_ctx, owner_ty, owner, &args);
    }

    /// Resolves all function signatures ([DeclarationNode*]) on a trait.
    resolve_trait_method_signatures(&this, methods: &[DeclarationNode*],
                                    res_ctx: ResolutionContext*) -> void {
        this.resolver.resolve_trait_method_signatures(methods, res_ctx);
    }


    // Recursive statement walker for variable/expression types

    /// Resolve the annotation of a `for` loop's initializer when it is a
    /// variable declaration; an expression initializer has none to resolve.
    resolve_var_types_in_for_init(&this, init: Node,
                                  res_ctx: ResolutionContext*) -> void {
        if (init.is_null()) { return; }

        match (init) {
            Node::Stmt(s) => {
                this.resolve_var_types_in_stmt(s, res_ctx);
            }
            Node::Decl(d) => {
                // A bare variable declaration (not wrapped in a declaration
                // statement): `for (mut i: int = 0; ...)`.
                const var_node: VarDecl* = DeclarationNode::var_of(d);
                if (var_node != null && var_node.type_annotation != null
                        && !var_node.resolved_type.is_valid()) {
                    const vtype: TypeRef = this.resolver.resolve(var_node.type_annotation, res_ctx);
                    if (vtype.is_valid()) {
                        var_node.resolved_type = vtype;
                    } else {
                        // As the DeclStmt path: reported where written,
                        // recorded if unanswered, left to the walk otherwise.
                        TypeAnnotation::refused(var_node.type_annotation);
                    }
                }
            }
            _ => {}
        }
    }

    resolve_var_types_in_stmt(&this, stmt: Stmt*, res_ctx: ResolutionContext*) -> void {
        if (stmt == null) { return; }
        match (stmt.kind) {
            StmtKind::Block(block) => {
                for (mut i: i64 = 0; i < block.statements.length(); i++) {
                    this.resolve_var_types_in_stmt(block.statements[i], res_ctx);
                }
            }
            StmtKind::UnsafeBlock(unsafe_block) => {
                this.resolve_var_types_in_stmt(unsafe_block.block, res_ctx);
            }
            StmtKind::Decl(decl_stmt) => {
                if (decl_stmt.declaration != null) {
                    const decl: DeclarationNode* = decl_stmt.declaration;
                    if (DeclarationNode::var_of(decl) != null) {
                        const var_node: VarDecl* = DeclarationNode::var_of(decl);
                        if (var_node.type_annotation != null && !var_node.resolved_type.is_valid()) {
                            const vtype: TypeRef = this.resolver.resolve(var_node.type_annotation, res_ctx);
                            if (vtype.is_valid()) {
                                var_node.resolved_type = vtype;
                            } else {
                                // A name in it the name layer refused (`bool` for
                                // `boolean`) was reported where it was written, and
                                // the door records one left unanswered; a form
                                // resolved later in the walk (`typeof(...)`) is left
                                // to that walk.
                                TypeAnnotation::refused(var_node.type_annotation);
                            }
                        }
                        // Recurse into the initializer expression so var
                        // declarations nested inside it (e.g. for-loop init
                        // VarDecls in a lambda body bound here, match/if
                        // expression arms) get their `resolved_type` set.
                        // Without this, `const f = () -> i32 { for (mut i:
                        // i32 = 0; ...) { ... } };` left the for-init's `i`
                        // with an invalid resolved_type and codegen bailed
                        // out of the local-alloca path silently, producing
                        // a "rvalue null" downstream.
                        if (var_node.has_initializer()) {
                            this.resolve_var_types_in_expression(var_node.initializer, res_ctx);
                        }
                    } else if (DeclarationNode::destructure_of(decl) != null) {
                        const dd: DestructureDecl* = DeclarationNode::destructure_of(decl);
                        if (dd.type_annotation != null && !dd.resolved_type.is_valid()) {
                            const dtype: TypeRef = this.resolver.resolve(dd.type_annotation, res_ctx);
                            if (dtype.is_valid()) {
                                dd.resolved_type = dtype;
                            }
                        }
                        if (dd.initializer != null) {
                            this.resolve_var_types_in_expression(dd.initializer, res_ctx);
                        }
                    }
                }
            }
            StmtKind::If(if_stmt) => {
                this.resolve_var_types_in_stmt(if_stmt.then_stmt, res_ctx);
                this.resolve_var_types_in_stmt(if_stmt.else_stmt, res_ctx);
            }
            StmtKind::While(while_stmt) => {
                this.resolve_var_types_in_stmt(while_stmt.body, res_ctx);
            }
            StmtKind::DoWhile(do_stmt) => {
                this.resolve_var_types_in_stmt(do_stmt.body, res_ctx);
            }
            StmtKind::For(for_stmt) => {
                // Resolve init if it's a var declaration
                this.resolve_var_types_in_for_init(for_stmt.init, res_ctx);
                this.resolve_var_types_in_stmt(for_stmt.body, res_ctx);
            }
            StmtKind::Match(match_stmt) => {
                for (mut i: i64 = 0; i < match_stmt.arms.length(); i++) {
                    const arm: MatchArmNode* = match_stmt.arms[i];
                    if (arm != null) {
                        this.resolve_var_types_in_stmt(arm.body, res_ctx);
                    }
                }
            }
            StmtKind::StaticMatch(sm_stmt) => {
                for (mut i: i64 = 0; i < sm_stmt.arms.length(); i++) {
                    const arm: StaticMatchArmNode* = sm_stmt.arms[i];
                    if (arm != null) {
                        this.resolve_var_types_in_stmt(arm.body, res_ctx);
                    }
                }
            }
            StmtKind::Expr(expr_stmt) => {
                const _expr: ExpressionNode* = expr_stmt.expression;
                const cast: CastExpr* = ExpressionNode::cast_of(_expr);
                if (cast != null) {
                    if (cast.target_annotation != null && !cast.has_resolved_target()) {
                        const target: TypeRef = this.resolver.resolve(cast.target_annotation, res_ctx);
                        if (target.is_valid()) {
                            cast.set_resolved_target(target);
                        }
                    }
                }
                this.resolve_var_types_in_expression(_expr, res_ctx);
            }
            StmtKind::Return(ret_stmt) => {
                // `return match (...) { ... }` and `return if (...) ...`
                // both hide var declarations inside their branches, which
                // need to be traversed for type resolution.  Return
                // statements have no annotations themselves but their
                // expression subtree does.
                this.resolve_var_types_in_expression(ret_stmt.expression, res_ctx);
            }
            StmtKind::Loop(loop_stmt) => {
                this.resolve_var_types_in_stmt(loop_stmt.body, res_ctx);
            }
            // No type annotations.
            StmtKind::Asm(_) | StmtKind::Break | StmtKind::Continue => {}
        }
    }

    /// Recurse into an expression looking for nested statement containers
    /// (match-arm bodies, ternary/if-expression branches) so any var
    /// declarations inside them get their `resolved_type` set.  Without
    /// this, `return match (...) { Pattern => { mut x: T = ...; } }`
    /// (and similar idioms) leaves `x.resolved_type = invalid`, and
    /// codegen can't allocate it.
    resolve_var_types_in_expression(&this, expr: ExpressionNode*,
                                     res_ctx: ResolutionContext*) -> void {
        if (expr == null) { return; }
        match (expr.kind) {
            // Recurse into arguments so lambdas passed as arguments get resolved.
            ExprKind::Call(call) => {
                for (mut i: i64 = 0; i < call.arguments.length(); i++) {
                    this.resolve_var_types_in_expression(call.arguments[i], res_ctx);
                }
            }
            ExprKind::Match(match_expr) => {
                for (mut i: i64 = 0; i < match_expr.arms.length(); i++) {
                    const arm: MatchArmNode* = match_expr.arms[i];
                    if (arm != null && arm.body != null) {
                        this.resolve_var_types_in_stmt(arm.body, res_ctx);
                    }
                }
            }
            ExprKind::StaticMatch(sm_expr) => {
                for (mut i: i64 = 0; i < sm_expr.arms.length(); i++) {
                    const arm: StaticMatchArmNode* = sm_expr.arms[i];
                    if (arm != null && arm.body != null) {
                        this.resolve_var_types_in_stmt(arm.body, res_ctx);
                    }
                }
            }
            ExprKind::If(if_expr) => {
                if (if_expr.then_expr != null) {
                    this.resolve_var_types_in_expression(if_expr.then_expr, res_ctx);
                }
                if (if_expr.else_expr != null) {
                    this.resolve_var_types_in_expression(if_expr.else_expr, res_ctx);
                }
            }
            ExprKind::Ternary(te) => {
                if (te.true_expr != null) {
                    this.resolve_var_types_in_expression(te.true_expr, res_ctx);
                }
                if (te.false_expr != null) {
                    this.resolve_var_types_in_expression(te.false_expr, res_ctx);
                }
            }
            // Runs before sema lowers `?`; recurse into the source
            // operand so nested var declarations get resolved types.
            ExprKind::Try(try_expr) => {
                if (try_expr.operand != null) {
                    this.resolve_var_types_in_expression(try_expr.operand, res_ctx);
                }
            }
            // Not walked here.
            ExprKind::Sizeof(_) | ExprKind::Alignof(_) | ExprKind::Typeof(_)
            | ExprKind::Delete(_) | ExprKind::Yield(_) | ExprKind::New(_)
            | ExprKind::ObjectConversion(_)
            | ExprKind::Tuple(_) | ExprKind::Array(_) | ExprKind::Struct(_)
            | ExprKind::Literal(_) | ExprKind::Cast(_) | ExprKind::Unary(_)
            | ExprKind::Binary(_) | ExprKind::ArrayAccess(_) | ExprKind::Await(_)
            | ExprKind::Identifier(_) | ExprKind::ScopeResolution(_) | ExprKind::MemberAccess(_) => { }
            // Resolve parameter types and body variables of a lambda.
            ExprKind::Lambda(lam) => {
                // Resolve each parameter's type annotation into resolved_type.
                for (mut li: i64 = 0; li < lam.parameters.length(); li++) {
                    const lp_decl: DeclarationNode* = lam.parameters[li];
                    const lp: VarDecl* = DeclarationNode::var_of(lp_decl);
                    if (lp != null && lp.type_annotation != null && !lp.resolved_type.is_valid()) {
                        const ptype: TypeRef = this.resolver.resolve(lp.type_annotation, res_ctx);
                        if (ptype.is_valid()) {
                            lp.resolved_type = ptype;
                        }
                    }
                }
                // Resolve the return type annotation if sema hasn't filled it in.
                if (!lam.return_type.is_valid() && lam.return_type_ann != null) {
                    const rtype: TypeRef = this.resolver.resolve(lam.return_type_ann, res_ctx);
                    if (rtype.is_valid()) {
                        lam.set_return_type(rtype);
                    }
                }
                // Walk body for variable declarations.
                if (lam.body != null) {
                    this.resolve_var_types_in_stmt(lam.body, res_ctx);
                }
            }
        }
    
    }


    // Generic function call instantiation collection

    /// Scan a statement (recursively) for calls with generic_args.
    /// For each, resolve the args and register an instantiation in the
    /// GenericRegistry so the Monomorphizer can discover and specialize it.
    collect_generic_fn_calls_in_stmt(&this, stmt: Stmt*,
                                     res_ctx: ResolutionContext*) -> void {
        if (stmt == null) { return; }

        match (stmt.kind) {
            StmtKind::Block(block) => {
                for (mut i: i64 = 0; i < block.statements.length(); i++) {
                    this.collect_generic_fn_calls_in_stmt(block.statements[i], res_ctx);
                }
            }
            StmtKind::Expr(es) => {
                this.collect_generic_fn_calls_in_expr(es.expression, res_ctx);
            }
            StmtKind::Decl(ds) => {
                if (ds.declaration != null) {
                    const decl_node: DeclarationNode* = ds.declaration;
                    if (DeclarationNode::var_of(decl_node) != null) {
                        const var_node: VarDecl* = DeclarationNode::var_of(ds.declaration);
                        if (var_node.has_initializer()) {
                            this.collect_generic_fn_calls_in_expr(var_node.initializer, res_ctx);
                        }
                    } else if (DeclarationNode::destructure_of(ds.declaration) != null) {
                        const dd: DestructureDecl* = DeclarationNode::destructure_of(ds.declaration);
                        if (dd.initializer != null) {
                            this.collect_generic_fn_calls_in_expr(dd.initializer, res_ctx);
                        }
                    }
                }
            }
            StmtKind::Return(ret) => {
                if (ret.expression != null) {
                    this.collect_generic_fn_calls_in_expr(ret.expression, res_ctx);
                }
            }
            StmtKind::If(if_stmt) => {
                this.collect_generic_fn_calls_in_expr(if_stmt.condition, res_ctx);
                this.collect_generic_fn_calls_in_stmt(if_stmt.then_stmt, res_ctx);
                this.collect_generic_fn_calls_in_stmt(if_stmt.else_stmt, res_ctx);
            }
            StmtKind::While(w) => {
                this.collect_generic_fn_calls_in_expr(w.condition, res_ctx);
                this.collect_generic_fn_calls_in_stmt(w.body, res_ctx);
            }
            StmtKind::For(f) => {
                // The initializer is scanned only when it is a statement; a
                // variable declaration or an expression there is not.
                if (f.init.as_stmt() != null) {
                    this.collect_generic_fn_calls_in_stmt(f.init.as_stmt(), res_ctx);
                }
                if (f.condition != null) { this.collect_generic_fn_calls_in_expr(f.condition, res_ctx); }
                if (f.update != null) { this.collect_generic_fn_calls_in_stmt(f.update, res_ctx); }
                this.collect_generic_fn_calls_in_stmt(f.body, res_ctx);
            }
            StmtKind::Match(ms) => {
                this.collect_generic_fn_calls_in_expr(ms.subject, res_ctx);
                for (mut i: i64 = 0; i < ms.arms.length(); i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm == null) { continue; }
                    if (arm.guard != null) {
                        this.collect_generic_fn_calls_in_expr(arm.guard, res_ctx);
                    }
                    this.collect_generic_fn_calls_in_stmt(arm.body, res_ctx);
                }
            }
            StmtKind::StaticMatch(sm) => {
                for (mut i: i64 = 0; i < sm.arms.length(); i++) {
                    const arm: StaticMatchArmNode* = sm.arms[i];
                    if (arm == null) { continue; }
                    this.collect_generic_fn_calls_in_stmt(arm.body, res_ctx);
                }
            }
            StmtKind::Loop(ls) => {
                this.collect_generic_fn_calls_in_stmt(ls.body, res_ctx);
            }
            StmtKind::UnsafeBlock(_) | StmtKind::Asm(_) | StmtKind::DoWhile(_)
            | StmtKind::Break | StmtKind::Continue => {}
        }
    }

    /// Scan an expression (recursively) for calls with generic_args.
    collect_generic_fn_calls_in_expr(&this, expr: ExpressionNode*,
                                     res_ctx: ResolutionContext*) -> void {
        if (expr == null) { return; }
        match (expr.kind) {
            ExprKind::Call(call) => {
                // Recurse into callee and arguments first
                this.collect_generic_fn_calls_in_expr(call.callee, res_ctx);
                for (mut i: i64 = 0; i < call.arguments.length(); i++) {
                    this.collect_generic_fn_calls_in_expr(call.arguments[i], res_ctx);
                }
                // Check for generic_args on the call
                if (call.generic_args.length() > 0) {
                    this.register_generic_fn_call(call, res_ctx);
                }
            }
            ExprKind::Try(try_expr) => {
                this.collect_generic_fn_calls_in_expr(try_expr.operand, res_ctx);
            }
            ExprKind::Binary(bin) => {
                this.collect_generic_fn_calls_in_expr(bin.left, res_ctx);
                this.collect_generic_fn_calls_in_expr(bin.right, res_ctx);
            }
            ExprKind::ArrayAccess(aa) => {
                this.collect_generic_fn_calls_in_expr(aa.array, res_ctx);
                this.collect_generic_fn_calls_in_expr(aa.index, res_ctx);
            }
            ExprKind::Unary(un) => {
                this.collect_generic_fn_calls_in_expr(un.operand, res_ctx);
            }
            ExprKind::MemberAccess(ma) => {
                this.collect_generic_fn_calls_in_expr(ma.object, res_ctx);
            }
            ExprKind::Ternary(te) => {
                this.collect_generic_fn_calls_in_expr(te.condition, res_ctx);
                this.collect_generic_fn_calls_in_expr(te.true_expr, res_ctx);
                this.collect_generic_fn_calls_in_expr(te.false_expr, res_ctx);
            }
            ExprKind::If(ie) => {
                this.collect_generic_fn_calls_in_expr(ie.condition, res_ctx);
                this.collect_generic_fn_calls_in_expr(ie.then_expr, res_ctx);
                this.collect_generic_fn_calls_in_expr(ie.else_expr, res_ctx);
            }
            // Not walked here.
            ExprKind::Sizeof(_) | ExprKind::Alignof(_) | ExprKind::Typeof(_)
            | ExprKind::Delete(_) | ExprKind::Yield(_) | ExprKind::New(_)
            | ExprKind::ObjectConversion(_)
            | ExprKind::Tuple(_) | ExprKind::Array(_) | ExprKind::Struct(_)
            | ExprKind::Literal(_) | ExprKind::StaticMatch(_) | ExprKind::Match(_)
            | ExprKind::Cast(_) | ExprKind::Lambda(_) | ExprKind::Await(_)
            | ExprKind::Identifier(_) | ExprKind::ScopeResolution(_) => { }
        }
    
    }

    /// Register a generic function call instantiation (`f<T>(...)`): the
    /// callee's template, the written arguments resolved, an instantiation
    /// demanded from the registry.
    ///
    /// The callee is an identifier.  A path callee keeps its turbofish on the
    /// path node (`Mod::f<T>` parses to a `ScopeResolutionExpr` carrying the
    /// arguments; the CALL node's `generic_args` are written for an identifier
    /// callee and for a member callee's promoted `obj.m<T>`), so no other
    /// callee kind arrives here with arguments to register.
    ///
    /// The template is the callee's stamp: `Def(q)` names the declaration
    /// under the key the registry is keyed by.  A local, a type parameter or
    /// an unanswered slot names no template, and there is no spelling to
    /// search for one under - a bare leaf prefixed with the writer's module
    /// misses every imported template, and a resolver re-entered from here
    /// answers for whatever module the cursor is on.
    register_generic_fn_call(&this, call: CallExpr*,
                             res_ctx: ResolutionContext*) -> void {
        const ident: IdentifierExpr* = ExpressionNode::identifier_of(call.callee);
        if (ident == null) { return; }
        const registry: GenericRegistry* = this.ctx.generic_registry;
        if (registry == null) { return; }

        // The callee's stamp is the registry key; a callee with no stamp is
        // a defect the door records (an unresolved bare name is refused by
        // sema on its own path and never reaches an explicit-generic call).
        const entry: TemplateEntry* = registry.template_of(
            ident.res.require("type_resolution:register_generic_fn_call").def_id());
        if (entry == null) { return; }
        if (entry.kind != TemplateKind::Function) { return; }
        if (!entry.base_type.is_valid()) { return; }

        // Resolve generic args
        mut args: [TypeRef] = [];
        for (mut i: i64 = 0; i < call.generic_args.length(); i++) {
            const arg: TypeRef = this.resolver.resolve(call.generic_args[i], res_ctx);
            if (!arg.is_valid()) { return; }
            args.push(arg);
        }

        // Validate arg count
        if (args.length() != entry.param_count) { return; }

        // Register instantiation; GenericRegistry deduplicates
        registry.instantiate(entry.base_type, args);

        if (Log::enabled(LogArea::Types, LogLevel::Trace)) {
            Log::trace(LogArea::Types, f"generic call {this.ctx.resolve_str(ident.name)} with {args.length()} type arguments");
        }
    }
}


/// What a signature refused by E0506 belongs to: a named item, or a trait
/// implementation, which has no name of its own and is shown by its trait
/// and its type.
type struct SignatureOwner {
    item:           SymbolStr;
    implementation: ImplBlock*;
    /// The modules that see the signature: the item's own visibility,
    /// narrowed by its type's for a member, and by its trait's and type's
    /// for an implementation.
    reach:          Visibility;

    static of_item(item: SymbolStr, reach: Visibility) -> SignatureOwner {
        return SignatureOwner { item: item, implementation: null, reach: reach };
    }

    static of_implementation(block: ImplBlock*, reach: Visibility) -> SignatureOwner {
        return SignatureOwner { item: SymbolStr::empty(), implementation: block, reach: reach };
    }
}

// TypeResolutionPasses: static entry points for pass dispatch + cross-module API

type struct TypeResolutionPasses {

    // -- A narrower type in a wider signature (E0506) --

    /// Refuse a type named where a module that cannot name it would see it:
    /// a private type in a signature another module sees, an internal one
    /// in a signature another package sees.  The signatures are an item's,
    /// a member's of a type (seen as far as both reach), and the head and
    /// associated types of a trait's implementation for a type (seen as far
    /// as both reach).  A program could otherwise hold a value of a type it
    /// cannot name, and call its methods.  Judged here, where the signature
    /// is written, because that is the one place its author can fix it;
    /// `-> implement Trait` keeps a concrete type hidden.  A trait
    /// implementation's methods take the trait's signature and are judged
    /// at the trait.
    ///
    /// What an `internal module` declares reaches no further than the
    /// module, so every written visibility here is narrowed to its module's.
    static refuse_private_in_signatures(stmt: DeclarationNode*, ctx: CompilationContext*) -> void {
        const within: Visibility = ctx.declared_visibility(ctx.module_def_of(ctx.module_of_file(stmt.span.file)));
        match (stmt.kind) {
            DeclKind::Function(func) => {
                const owner: SignatureOwner = SignatureOwner::of_item(func.name, Visibility::narrower(within, func.visibility));
                TypeResolutionPasses::refuse_private_in_function(ctx, stmt, &owner);
            }
            DeclKind::Struct(node) => {
                TypeResolutionPasses::refuse_private_in_fields(ctx, &node.fields, Visibility::narrower(within, node.visibility));
                TypeResolutionPasses::refuse_private_in_methods(ctx, &node.methods, Visibility::narrower(within, node.visibility));
            }
            DeclKind::Union(node) => {
                TypeResolutionPasses::refuse_private_in_fields(ctx, &node.fields, Visibility::narrower(within, node.visibility));
                TypeResolutionPasses::refuse_private_in_methods(ctx, &node.methods, Visibility::narrower(within, node.visibility));
            }
            DeclKind::Enum(node) => {
                const owner: SignatureOwner = SignatureOwner::of_item(node.name, Visibility::narrower(within, node.visibility));
                for (mut i: i64 = 0; i < node.variants.length(); i++) {
                    const v: EnumVariant* = DeclarationNode::variant_of(node.variants[i]);
                    if (v == null) { continue; }
                    for (mut k: i64 = 0; k < v.associated_types.length(); k++) {
                        TypeResolutionPasses::refuse_private_in_annotation(ctx, v.associated_types[k], &owner);
                    }
                }
            }
            DeclKind::TypeAlias(node) => {
                const owner: SignatureOwner = SignatureOwner::of_item(node.alias_name, Visibility::narrower(within, node.visibility));
                TypeResolutionPasses::refuse_private_in_annotation(ctx, node.target_annotation, &owner);
            }
            DeclKind::Variable(node) => {
                if (node.is_global) {
                    const owner: SignatureOwner = SignatureOwner::of_item(node.name, Visibility::narrower(within, node.visibility));
                    TypeResolutionPasses::refuse_private_in_annotation(ctx, node.type_annotation, &owner);
                }
            }
            DeclKind::Trait(node) => {
                for (mut i: i64 = 0; i < node.methods.length(); i++) {
                    const m: FunctionDecl* = DeclarationNode::fn_of(node.methods[i]);
                    if (m == null) { continue; }
                    const owner: SignatureOwner = SignatureOwner::of_item(m.name, Visibility::narrower(within, node.visibility));
                    TypeResolutionPasses::refuse_private_in_function(ctx, node.methods[i], &owner);
                }
            }
            DeclKind::Impl(node) => {
                const target: Visibility = ctx.declared_visibility(
                    node.res.require("signature visibility: impl head").def_id());
                if (!node.is_trait_impl()) {
                    TypeResolutionPasses::refuse_private_in_methods(ctx, &node.methods, target);
                    return;
                }
                // A trait's implementation for a type is seen by every module
                // that sees both, and its methods' signatures are the trait's
                // with the head's arguments and the block's associated types
                // put in: those are the types it exposes.
                const owner: SignatureOwner = SignatureOwner::of_implementation(node,
                    Visibility::narrower(target, ctx.declared_visibility(node.trait_def)));
                TypeResolutionPasses::refuse_private_in_annotation(ctx, node.trait_annotation, &owner);
                for (mut i: i64 = 0; i < node.assoc_binding_annotations.length(); i++) {
                    TypeResolutionPasses::refuse_private_in_annotation(ctx, node.assoc_binding_annotations[i], &owner);
                }
            }
            DeclKind::Destructure(_) | DeclKind::Extern(_) | DeclKind::Field(_)
            | DeclKind::GenericParam(_) | DeclKind::Import(_) | DeclKind::Intrinsic(_)
            | DeclKind::Module(_) | DeclKind::Variant(_) | DeclKind::Method(_) => { }
        }
    }

    static refuse_private_in_fields(ctx: CompilationContext*, fields: &[DeclarationNode*], owner_reach: Visibility) -> void {
        for (mut i: i64 = 0; i < fields.length(); i++) {
            const f: FieldDecl* = DeclarationNode::field_of(fields[i]);
            if (f == null) { continue; }
            const owner: SignatureOwner = SignatureOwner::of_item(f.name, Visibility::narrower(owner_reach, f.visibility));
            TypeResolutionPasses::refuse_private_in_annotation(ctx, f.type_annotation, &owner);
        }
    }

    static refuse_private_in_methods(ctx: CompilationContext*, methods: &[DeclarationNode*], owner_reach: Visibility) -> void {
        for (mut i: i64 = 0; i < methods.length(); i++) {
            const m: MethodDecl* = DeclarationNode::method_of(methods[i]);
            if (m == null || m.func == null) { continue; }
            const owner: SignatureOwner = SignatureOwner::of_item(DeclarationNode::fn_of(m.func).name,
                Visibility::narrower(owner_reach, m.visibility));
            TypeResolutionPasses::refuse_private_in_function(ctx, m.func, &owner);
        }
    }

    /// A function's parameters, its return and the traits its bounds name.
    static refuse_private_in_function(ctx: CompilationContext*, func_decl: DeclarationNode*, owner: &SignatureOwner) -> void {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        // A private signature is seen only where everything it can name is.
        if (func == null || owner.reach == Visibility::Private) { return; }
        for (mut p: i64 = 0; p < func.parameters.length(); p++) {
            const param: VarDecl* = DeclarationNode::var_of(func.parameters[p]);
            if (param != null) { TypeResolutionPasses::refuse_private_in_annotation(ctx, param.type_annotation, owner); }
        }
        TypeResolutionPasses::refuse_private_in_annotation(ctx, func.return_type_annotation, owner);
        for (mut b: i64 = 0; b < func.trait_bounds.length(); b++) {
            for (mut t: i64 = 0; t < func.trait_bounds[b].trait_refs.length(); t++) {
                const r: &TraitRef = &func.trait_bounds[b].trait_refs[t];
                TypeResolutionPasses::refuse_private_named(ctx, r.resolved, r.span, owner);
                for (mut a: i64 = 0; a < r.type_args.length(); a++) {
                    TypeResolutionPasses::refuse_private_in_annotation(ctx, r.type_args[a], owner);
                }
            }
        }
    }

    /// Each type `ann` names, through every type it is built from.  An
    /// `implement Trait` names only its traits: the concrete type it stands
    /// for is the one a signature may hide.
    static refuse_private_in_annotation(ctx: CompilationContext*, ann: TypeAnnotation*, owner: &SignatureOwner) -> void {
        if (ann == null || owner.reach == Visibility::Private) { return; }
        match (*ann) {
            TypeAnnotation::Named(n) => {
                if (n != null) {
                    const d: DefId = match (n.res) {
                        ResSlot::Answered(r) => { r.def_id() }
                        _                    => { DefId::invalid() }
                    };
                    TypeResolutionPasses::refuse_private_named(ctx, d, n.span, owner);
                }
            }
            TypeAnnotation::Pointer(p)   => { if (p != null) { TypeResolutionPasses::refuse_private_in_annotation(ctx, p.inner, owner); } }
            TypeAnnotation::Reference(r) => { if (r != null) { TypeResolutionPasses::refuse_private_in_annotation(ctx, r.inner, owner); } }
            TypeAnnotation::Object(o)    => { if (o != null) { TypeResolutionPasses::refuse_private_in_annotation(ctx, o.trait_annotation, owner); } }
            TypeAnnotation::Array(a)     => { if (a != null) { TypeResolutionPasses::refuse_private_in_annotation(ctx, a.element, owner); } }
            TypeAnnotation::Function(f) => {
                if (f != null) {
                    for (mut i: i64 = 0; i < f.parameters.length(); i++) {
                        TypeResolutionPasses::refuse_private_in_annotation(ctx, f.parameters[i], owner);
                    }
                    TypeResolutionPasses::refuse_private_in_annotation(ctx, f.return_type, owner);
                }
            }
            TypeAnnotation::Tuple(t) => {
                if (t != null) {
                    for (mut i: i64 = 0; i < t.elements.length(); i++) {
                        TypeResolutionPasses::refuse_private_in_annotation(ctx, t.elements[i], owner);
                    }
                }
            }
            TypeAnnotation::Generic(g) => {
                if (g != null) {
                    TypeResolutionPasses::refuse_private_in_annotation(ctx, g.base, owner);
                    for (mut i: i64 = 0; i < g.args.length(); i++) {
                        TypeResolutionPasses::refuse_private_in_annotation(ctx, g.args[i], owner);
                    }
                }
            }
            TypeAnnotation::ImplTrait(it) => {
                if (it != null) {
                    for (mut i: i64 = 0; i < it.bounds.length(); i++) {
                        TypeResolutionPasses::refuse_private_in_annotation(ctx, it.bounds[i], owner);
                    }
                }
            }
            TypeAnnotation::Projection(p) => { if (p != null) { TypeResolutionPasses::refuse_private_in_annotation(ctx, p.base, owner); } }
            _ => { }
        }
    }

    /// E0506 when `d` is a type or trait reaching fewer modules than the
    /// signature naming it.  The writer can name `d`, since one it cannot
    /// is refused where it is named (E0503).
    static refuse_private_named(ctx: CompilationContext*, d: DefId, span: SourceSpan, owner: &SignatureOwner) -> void {
        if (!d.is_valid()) { return; }
        const named: Visibility = ctx.declared_visibility(d);
        if (named.reaches_as_far_as(owner.reach)) { return; }
        const type_str: string = ctx.intern_table.shown(ctx.defs.leaf_of(d));
        const reach_str: string = owner.reach.label();
        const named_str: string = named.label();
        const seen_by: string = if (named == Visibility::Private) { "other modules" } else { "other packages" };
        if (owner.implementation != null) {
            const trait_str: string = ctx.intern_table.shown(ctx.defs.leaf_of(owner.implementation.trait_def));
            const target_str: string = ctx.resolve_str(owner.implementation.target_type);
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0506_PRIVATE_TYPE_IN_PUBLIC_SIGNATURE,
                fmt::format("the implementation of `%s` for `%s` is %s, but it names the %s type `%s`",
                    trait_str, target_str, reach_str, named_str, type_str));
            diag = diag.at_with_label(span, fmt::format("%s type in an implementation %s can see", named_str, seen_by));
            diag = diag.help(fmt::format("make `%s` %s, or make `%s` or `%s` %s",
                type_str, reach_str, trait_str, target_str, named_str));
            ctx.emit_diagnostic(diag);
            return;
        }
        const item_str: string = ctx.resolve_str(owner.item);
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0506_PRIVATE_TYPE_IN_PUBLIC_SIGNATURE,
            fmt::format("`%s` is %s, but its signature names the %s type `%s`", item_str, reach_str, named_str, type_str));
        diag = diag.at_with_label(span, fmt::format("%s type in a signature %s can see", named_str, seen_by));
        diag = diag.help(fmt::format("make `%s` %s, make `%s` %s, or hide the concrete type behind `-> implement Trait`",
            type_str, reach_str, item_str, named_str));
        ctx.emit_diagnostic(diag);
    }

    // Shared utility: generic parameter declarations -> [TypeRef]

    /// Single source of truth for creating GenericParamType entries in the
    /// arena from a list of generic parameter declarations.  Returns parallel [TypeRef]
    /// where refs[i] is the GenericParamType for generic_params[i].
    ///
    /// A bound on the parameter does not reach the arena entry: a bound is
    /// written in a `where` clause, which lives on the declaration rather than
    /// on the parameter, and the consumers that need it read it from there.
    ///
    /// Used by:
    ///   - TypeResolutionRunner::bind_generic_params()
    ///   - SpecializationPasses::run_template_registration()
    static create_generic_param_types(generic_params: &[DeclarationNode*],
                                      arena: TypeArena*) -> [TypeRef] {
        mut refs: [TypeRef] = [];
        for (mut i: i64 = 0; i < generic_params.length(); i++) {
            const gp_decl: DeclarationNode* = generic_params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            refs.push(arena.create_generic_param(gp.sym_id, gp.name, i as u64));
        }
        return refs;
    }


    // Shared utility: register a declaration in the DeclarationIndex

    /// Registers a top-level declaration (struct, enum, function, impl block)
    /// in the DeclarationIndex.  A type declaration's TYPE is already in the
    /// index, under its own key (`decl_type_key`, the key the type-declaration
    /// stage minted it under), and nowhere else; this arm adds what that stage
    /// does not own - the bare-name mapping, the visibility verdict, the
    /// methods - and asks the index nothing about the type.  A monomorphized
    /// type never reaches this arm - its registration is
    /// `SpecInjector::register`, under the arena name - so the declarations
    /// here are the written ones, and a written type's bare leaf is not a key
    /// any store holds.
    ///
    /// Shared by TypeResolution (Phase 4) and Specialization (injected decl
    /// registration) so that both use the same registration logic.
    ///
    /// `is_source_decl` distinguishes the two callers: true for genuine
    /// source-level declarations swept by the TypeResolution pass, false
    /// for monomorphizer-injected spec clones.  Only source decls feed the
    /// cross-module trait-impl coherence check; spec clones share canonical
    /// targets across the modules that instantiate them and would otherwise
    /// false-positive.
    static register_decl_in_index(stmt: DeclarationNode*, ctx: CompilationContext*,
                                  is_source_decl: boolean) -> void {
        if (stmt == null) { return; }
        const arena: TypeArena* = ctx.type_arena;

        // A generic type's own methods, under the template.
        if (is_source_decl) {
            match (stmt.kind) {
                DeclKind::Struct(node) => {
                    if (ctx.generic_registry.template_of(node.def) != null) {
                        ctx.decl_index.register_template_methods(node.def, &node.methods, arena);
                    }
                }
                DeclKind::Union(node) => {
                    if (ctx.generic_registry.template_of(node.def) != null) {
                        ctx.decl_index.register_template_methods(node.def, &node.methods, arena);
                    }
                }
                DeclKind::Impl(node) => {
                    const owner: DefId = match (node.res) {
                        ResSlot::Answered(r) => { r.def_id() }
                        _                    => { DefId::invalid() }
                    };
                    if (owner.is_valid() && ctx.generic_registry.template_of(owner) != null) {
                        ctx.decl_index.register_template_methods(owner, &node.methods, arena);
                    }
                }
                DeclKind::Destructure(_) | DeclKind::Enum(_) | DeclKind::Extern(_)
                | DeclKind::Field(_) | DeclKind::GenericParam(_) | DeclKind::Import(_)
                | DeclKind::Intrinsic(_) | DeclKind::Module(_) | DeclKind::Trait(_)
                | DeclKind::TypeAlias(_) | DeclKind::Variable(_) | DeclKind::Variant(_)
                | DeclKind::Function(_) | DeclKind::Method(_) => { }
            }
        }

        match (stmt.kind) {
            DeclKind::Function(func) => {
                const func_decl: DeclarationNode* = stmt;
                // A signature the name layer refused registers nothing: with
                // the refused parameter dropped it would be a different
                // function's, and with no return type it cannot be mangled.
                // The refusal is recorded on the definition so a call to it
                // finds a declaration and reports nothing.
                if (decl_index::DeclarationIndex::signature_is_refused(func_decl)) {
                    ctx.defs.record_signature_refused(func.def);
                } else if (func.resolved_return_type.is_valid()) {
                    // Collect resolved param types from AST
                    mut param_types: [TypeRef] = [];
                    for (mut p: i64 = 0; p < func.parameters.length(); p++) {
                        const param_decl: DeclarationNode* = func.parameters[p];
                        const param: VarDecl* = DeclarationNode::var_of(param_decl);
                        if (param != null && param.resolved_type.is_valid()) {
                            param_types.push(param.resolved_type);
                        }
                    }

                    // Create a FunctionType in the arena (deduplicated)
                    const func_type_ref: TypeRef = arena.get_function(
                        func.resolved_return_type, param_types, func.is_variadic);

                    // A declaration is registered in its own family - its
                    // module and the name it is written with.  A copy (a
                    // monomorphized instance) is registered in none: a call
                    // reaches it by its instance, and its symbol is mangled
                    // under the module of the definition it copies.
                    const decl_span: SourceSpan = if (func_decl.has_name_span()) { func_decl.name_span } else { func_decl.span };
                    const entry: OverloadId = if (!func.def.is_valid() && func.copy_of.is_valid()) {
                        ctx.decl_index.register_copy_signature(
                            ctx.copy_module_family(func.copy_of), func.name, func.resolved_return_type,
                            func_type_ref, ctx.intern_table, arena, decl_span, func_decl)
                    } else {
                        ctx.decl_index.register_function_signature(
                            ctx.fn_family_of(func.def), func.name, func.resolved_return_type, func_type_ref,
                            ctx.intern_table, arena, SymbolStr::empty(), decl_span,
                            if (is_source_decl) { func.def } else { DefId::invalid() }, func_decl)
                    };
                    func.set_overload_entry(entry);
                    // A generic intrinsic's entries lower as its kind: the
                    // declaration's, and each specialization's, which is the
                    // entry a call to it is pinned to.
                    if (func.is_intrinsic) {
                        // A specialization's name is minted; its kind is
                        // the declaration's it is a copy of.
                        ctx.decl_index.mark_intrinsic(entry, if (func.copy_of.is_valid()) {
                            ctx.decl_index.entry_intrinsic_kind(ctx.decl_index.entry_of_def(func.copy_of))
                        } else {
                            IntrinsicKind::from_name(ctx.intern_table.resolve(func.name))
                        });
                    }
                    ctx.decl_index.set_decl_visibility(func.def, func.visibility);
                    // A free function's instance is answered by its entry.
                    ctx.decl_index.record_instance(func.instance, entry);
                }
            }
            DeclKind::Struct(node) => {
                ctx.decl_index.register_methods(ctx.decl_index.type_of_decl(node.def, "type_resolution/register struct methods"), node.methods, ctx.intern_table, arena, "type_resolution/register struct methods");
            }
            DeclKind::Union(node) => {
                ctx.decl_index.register_methods(ctx.decl_index.type_of_decl(node.def, "type_resolution/register union methods"), node.methods, ctx.intern_table, arena, "type_resolution/register union methods");
            }
            DeclKind::Impl(node) => {
                TypeResolutionPasses::register_impl_in_index(
                    stmt as DeclarationNode*, node, ctx, is_source_decl);
            }
            DeclKind::Destructure(_) | DeclKind::Enum(_) | DeclKind::Extern(_)
            | DeclKind::Field(_) | DeclKind::GenericParam(_) | DeclKind::Import(_)
            | DeclKind::Intrinsic(_) | DeclKind::Module(_) | DeclKind::Trait(_)
            | DeclKind::TypeAlias(_) | DeclKind::Variable(_) | DeclKind::Variant(_) | DeclKind::Method(_) => {}
        }
    }

    /// Register an implement block - `decl` its declaration, `node` its
    /// payload - in the index and the registry: its trait's identity on its
    /// methods, its head beside its target's template and under its trait,
    /// the coherence and overlap refusals, and its methods under the owner.
    static register_impl_in_index(decl: DeclarationNode*, node: ImplBlock*,
                                  ctx: CompilationContext*, is_source_decl: boolean) -> void {
        const arena: TypeArena* = ctx.type_arena;
        // Stamp the impl block with its defining module + qualified target
        // name so the monomorphizer can register spec'd methods (added later
        // to node.methods) under the same DI keys sema-time used for the
        // template.  Without these stamps the spec ends up registered under a
        // bare-name key that doesn't match the qualified key used at sema, and
        // the cross-module extern-decl path picks up the template's
        // (GenericParam-typed) overload entry.
        if (decl.source_file == "") {
            decl.set_source_file(ctx.source_file);
        }
        // Stamp each trait-impl method with its trait's identity so every
        // mangling site can disambiguate it from a same-named method of
        // another trait implemented for the same type.  Without this,
        // `implement trait A for T { foo() }` and `implement trait B for T {
        // foo() }` mangle to the same symbol and collide at link time (see
        // FunctionDecl.origin_trait and
        // MangledName::for_method_or_trait_impl).  This is the single stamping
        // chokepoint: it runs for both the type-resolution path and the
        // specialization injected-decl path (which routes spec'd impl blocks
        // back through register_decl_in_index).
        //
        // The trait is the head annotation's stamp: the canonical name the
        // trait registries key by, decided where the impl's imports were in
        // hand.  Two traits can share a leaf, and the stamp is what tells them
        // apart; a head with no stamp is a defect the door records, never a
        // leaf to search for.
        if (node.is_trait_impl()) {
            const ot_def: DefId = TypeResolutionPasses::head_named_slot(node.trait_annotation)
                .require("type_resolution:trait-impl head").def_id();
            if (ot_def.is_valid()) {
                // Carry the same answer on the block itself: a caller asking
                // WHICH trait this impl provides must not have to re-derive it
                // from the registry's bare leaf key.
                node.trait_def = ot_def;
                for (mut omi: i64 = 0; omi < node.methods.length(); omi++) {
                    const om_decl: DeclarationNode* = node.methods[omi];
                    const om: MethodDecl* = DeclarationNode::method_of(om_decl);
                    if (om != null && om.func != null) {
                        DeclarationNode::fn_of(om.func).set_origin_trait(ot_def);
                    }
                }
            }
        }
        // The impl's target under the name it is registered by, off the head:
        // a declaration's canonical name, a primitive's own spelling, a
        // clone's specialization.
        const canonical_target: SymbolStr = node.target_key(arena);
        if (canonical_target.is_valid()) {
            // A written head on a template names EVERY parameter of that
            // template, as parameters of its own or as a concrete
            // instantiation; an elided one is refused here, where every
            // template is registered and the head is about to be attached to
            // it.  A clone carries no stamp and is not a head anyone wrote.
            TypeResolutionPasses::refuse_elided_template_params(decl, node, ctx);
            // Attach the block to its target's template under the same key
            // TemplateRegistration used.  That pass runs before the template
            // exists whenever the target's module comes later in pass order
            // (`fmt::display`'s `Display for String` sees no `String` template
            // there), so this is the offer that always lands; a clone
            // injected after TemplateRegistration is attached here alone.
            // The registry refuses a block it already holds.
            ctx.generic_registry.register_impl_block(node.target_def(), decl);
            if (node.is_trait_impl()) {
                // Under the trait's identity and the target's type.
                // TemplateRegistration offered the same head; the registry
                // keeps one, and a clone routed here after that pass is
                // registered here alone.
                ctx.generic_registry.register_trait_impl(
                    node.trait_def,
                    ctx.decl_index.impl_owner(node, "type_resolution/trait impl"), decl);
            }
        }
        // Trait-impl coherence (same file AND across modules).  A trait may be
        // implemented at most once per type.  The head's key is its
        // identities (`coherence_key_of`): same-leaf types in different
        // modules stay distinct, an impl on an imported type collides with
        // the type's home-module impl, and the trait's type args (`From<i8>`
        // vs `From<i16>`), the target's type args, and the where-bounds all
        // participate, the impl's own parameters by position, so only genuine
        // duplicates collide.  This is the only coherence check, so there is
        // no double report.  Source decls only: monomorphizer-injected spec
        // clones share heads across the modules that instantiate them and
        // would false-positive.
        if (is_source_decl && node.is_trait_impl() && canonical_target.is_valid()) {
            mut coh_key: [u64] = [];
            const keyed: boolean = TypeResolutionPasses::coherence_key_of(node, ctx, &coh_key);
            const prior: DeclarationNode* = if (keyed) {
                ctx.generic_registry.register_coherence_head(&coh_key, decl)
            } else { null };
            if (prior != null) {
                const c_leaf: SymbolStr =
                    TypeResolutionPasses::extract_trait_leaf(node.trait_annotation);
                const tname: string = ctx.intern_table.resolve(c_leaf);
                const gname: string = ctx.intern_table.resolve(canonical_target);
                ctx.emit_error_at(
                    ErrorCode::E0308_CONFLICTING_TRAIT_IMPL,
                    fmt::format("conflicting implementations of trait `%s` for type `%s`: a trait may be implemented at most once per type, including across modules",
                           tname, gname),
                    decl.span);
            } else {
                // Not a second copy of one head, so ask whether an earlier
                // head under the same (trait, target) key OVERLAPS it: some
                // subject would select both.  Refused here at the later
                // declaration rather than at a use - the use is innocent, and
                // a pick by declaration order or by bound would make the
                // program's meaning depend on which impl was written first.
                // Where-bounds do not separate two heads; nothing here can
                // prove two bounds disjoint.
                const over: DeclarationNode* =
                    ctx.generic_registry.overlapping_head(
                        node.trait_def,
                        ctx.decl_index.impl_owner(node, "type_resolution/overlap"), node);
                if (over != null) {
                    const this_head: string = node.spell_head(ctx.intern_table);
                    const that_head: string = DeclarationNode::impl_of(over).spell_head(ctx.intern_table);
                    const trait_spelt: string =
                        TypeAnnotation::spell(node.trait_annotation, ctx.intern_table);
                    // Two heads spelled alike differ only in their
                    // where-clauses, and that is the sentence.
                    const msg: string = if (this_head == that_head) {
                        fmt::format("conflicting implementations of trait `%s`: two `%s` heads differ only in their where-clauses, which do not separate them - a type satisfying both bounds would select both",
                            trait_spelt, this_head)
                    } else {
                        fmt::format("conflicting implementations of trait `%s`: `%s` overlaps `%s`, so a type both heads accept would select both",
                            trait_spelt, this_head, that_head)
                    };
                    mut od: Diagnostic = Diagnostic::error(
                        ErrorCode::E0308_CONFLICTING_TRAIT_IMPL, msg);
                    od = od.at_with_label(decl.span, "this implementation");
                    od = od.also_at(over.span, "overlaps this one");
                    od = od.with_note(
                        "two implementations of one trait must not both accept any type; a where-clause narrows which types a head is FOR but does not separate two heads, so make the targets disjoint or keep one implementation");
                    ctx.emit_diagnostic(od);
                }
            }
        }
        // The head's methods under the owner the index names, their returns
        // in the owner's parameters.
        mut head: TypeSubstitution = TypeResolutionPasses::impl_params_to_owner(node, ctx, arena);
        ctx.decl_index.register_methods_through(
            ctx.decl_index.impl_owner(node, "type_resolution/register impl methods"),
            node.methods, &head, &node.trait_arg_types, ctx.intern_table, arena,
            "type_resolution/register impl methods");
    }


    // Default trait-method synthesis (Phase B.6)
    //
    // When an impl block names a trait and the trait declares a default body
    // for some method, the impl inherits that default unless it overrides.
    // This helper clones every default-bodied trait method that the impl
    // doesn't override and adds it as a MethodDecl on the impl. The clone
    // goes through the rest of FunctionSignature/TypeResolution/Sema in the
    // same loop, picking up the impl's `this_type` (= owner_type) so any
    // `This` annotations in the body resolve to the impl target.
    //
    // Cross-module: traits register themselves in the GenericRegistry's
    // trait-decl index from their own module's FunctionSignature pass.
    // A consumer module's pass runs after the trait's, so the lookup
    // finds the trait's AST.  Same-module impls work because traits are
    // declared before their impls in source order.
    //
    // Limitations: trait must be reachable as a bare leaf name. Generic
    // traits (e.g. `Iterator<T>`) work for the leaf-name path but the
    // generic params don't propagate yet; that's left for a follow-up.
    // Returns the number of methods synthesized.

    /// Rewrite every `ThisType` annotation reachable from `ann` (in-place) to
    /// `Named(target)`. Used after cloning a trait default method into an
    /// impl block: the trait body's `&this` parameter and any `-> This`
    /// return type carry `ThisType` annotations, but the impl-resolution
    /// path can't always set `ctx.this_type` (generic impl targets fall out
    /// of `decl_index.lookup_type`). Rewriting at clone time names the
    /// impl's target as its head writes it, arguments included, which is
    /// the type a hand-written impl method's `This` is.
    /// `home_span` is the span the rewritten annotation ADOPTS, and it must come
    /// from the impl block rather than from the `This` token being replaced.
    /// The name written here is the impl's target, so the syntax this annotation
    /// now stands for was written in the impl's file; keeping the trait's span
    /// leaves a node whose name and provenance disagree, and a bare leaf then
    /// resolves in a module that never wrote it (`HashMapIter` homed on
    /// `std::core::iter`).  An `implement` block may live in a third module
    /// again, so neither the trait's nor the target type's file can stand in.
    static rewrite_this_type_annotation(ann: TypeAnnotation*,
                                         target: SymbolStr,
                                         target_args: &[TypeAnnotation*],
                                         home_span: SourceSpan,
                                         home_res: ResSlot) -> void {
        if (ann == null) { return; }
        match (*ann) {
            TypeAnnotation::ThisType(t) => {
                // The impl head already asked what its target spells, in the
                // scope it was written in, and this node names that same type.
                // The head's slot is carried across whatever it holds: a head
                // no resolver could answer for mints an unanswered node, and a
                // second walk here would be a second opinion about one
                // spelling.
                const named: NamedAnnotation* = new NamedAnnotation {
                    name:         target,
                    span:         home_span,
                    pre_resolved: TypeRef::invalid(),
                    res:          home_res,
                };
                const temp: TypeAnnotation* = libc::malloc(sizeof(TypeAnnotation)) as TypeAnnotation*;
                if (target_args.length() > 0) {
                    // Generic target (`for Range<T>`): `This` is the full Self
                    // type `Range<T>`, not the bare `Range`.  Wrap the name in
                    // a Generic carrying deep-cloned copies of the target args.
                    const base_ann: TypeAnnotation* =
                        libc::malloc(sizeof(TypeAnnotation)) as TypeAnnotation*;
                    *base_ann = TypeAnnotation::Named(named);
                    mut cloned_args: [TypeAnnotation*] = [];
                    for (mut i: i64 = 0; i < target_args.length(); i++) {
                        cloned_args.push(TypeAnnotation::clone_ptr(target_args[i]));
                    }
                    const gen: GenericAnnotation* = new GenericAnnotation {
                        base: base_ann,
                        args: cloned_args,
                        span: home_span,
                        refused: false,
                    };
                    *temp = TypeAnnotation::Generic(gen);
                } else {
                    *temp = TypeAnnotation::Named(named);
                }
                mem::copy::<TypeAnnotation>(ann, temp, 1);
                // `temp` was only a staging container: its bytes (the enum tag +
                // the Named/Generic payload pointer) are now copied into `*ann`,
                // which owns the payload from here.  Free the throwaway container
                // so it doesn't leak per rewrite (this path is direct `malloc`,
                // not arena-routed, so in a long-running host - the LSP - it
                // would accumulate every recompile).  The `named`/`gen` the
                // pointer refers to is shared with `*ann` and must NOT be freed.
                libc::free(temp as void*);
            }
            TypeAnnotation::Reference(r) => {
                TypeResolutionPasses::rewrite_this_type_annotation(r.inner, target, target_args, home_span, home_res);
            }
            TypeAnnotation::Object(o) => {
                TypeResolutionPasses::rewrite_this_type_annotation(o.trait_annotation, target, target_args, home_span, home_res);
            }
            TypeAnnotation::Pointer(p) => {
                TypeResolutionPasses::rewrite_this_type_annotation(p.inner, target, target_args, home_span, home_res);
            }
            TypeAnnotation::Array(a) => {
                TypeResolutionPasses::rewrite_this_type_annotation(a.element, target, target_args, home_span, home_res);
            }
            TypeAnnotation::Generic(g) => {
                TypeResolutionPasses::rewrite_this_type_annotation(g.base, target, target_args, home_span, home_res);
                for (mut i: i64 = 0; i < g.args.length(); i++) {
                    TypeResolutionPasses::rewrite_this_type_annotation(g.args[i], target, target_args, home_span, home_res);
                }
            }
            TypeAnnotation::Tuple(tu) => {
                for (mut i: i64 = 0; i < tu.elements.length(); i++) {
                    TypeResolutionPasses::rewrite_this_type_annotation(tu.elements[i], target, target_args, home_span, home_res);
                }
            }
            TypeAnnotation::Function(f) => {
                TypeResolutionPasses::rewrite_this_type_annotation(f.return_type, target, target_args, home_span, home_res);
                for (mut i: i64 = 0; i < f.parameters.length(); i++) {
                    TypeResolutionPasses::rewrite_this_type_annotation(f.parameters[i], target, target_args, home_span, home_res);
                }
            }
            _ => { }
        }
    }

    /// Rewrite every reference to a trait's generic parameter (by name) in
    /// `ann` (in-place) to the impl's corresponding trait-argument
    /// annotation.  Companion to `rewrite_this_type_annotation`, run after
    /// cloning a trait default method into an impl block.  The trait body's
    /// signature names the trait's own params - e.g. `Item` in
    /// `Iterator<Item>::fold<Acc>(... f: (Acc, Item) -> Acc ...)` - but the
    /// clone lives in `implement<T> Iterator<T> for Range<T>`, where the
    /// trait arg standing in for `Item` is `T`.  Without this rewrite the
    /// cloned annotation keeps the literal name `Item`, which the
    /// impl-specialization substituter (keyed on the impl's own params, e.g.
    /// `T`) never touches; the leftover generic surfaces as an invalid
    /// TypeRef and crashes the mangler when the method is later specialized
    /// for a concrete instantiation.  `param_syms[i]` maps to `arg_anns[i]`;
    /// complex args (e.g. `Pair<u64, A>`) are deep-cloned into the slot.
    static rewrite_trait_params_annotation(ann: TypeAnnotation*,
                                            param_syms: &[SymbolID],
                                            arg_anns: &[TypeAnnotation*]) -> void {
        if (ann == null) { return; }
        match (*ann) {
            TypeAnnotation::Named(n) => {
                // Pre-resolved leaves already map to a concrete TypeRef and
                // can't be a trait param awaiting substitution.
                if (n.pre_resolved.is_valid()) { return; }
                const sym: SymbolID = n.param_sym();
                if (!sym.is_valid()) { return; }
                for (mut i: i64 = 0; i < param_syms.length(); i++) {
                    if (sym.equals(param_syms[i])) {
                        const cloned: TypeAnnotation* =
                            TypeAnnotation::clone_ptr(arg_anns[i]);
                        if (cloned != null) {
                            mem::copy::<TypeAnnotation>(ann, cloned, 1);
                        }
                        return;
                    }
                }
            }
            TypeAnnotation::Reference(r) => {
                TypeResolutionPasses::rewrite_trait_params_annotation(
                    r.inner, param_syms, arg_anns);
            }
            TypeAnnotation::Object(o) => {
                TypeResolutionPasses::rewrite_trait_params_annotation(
                    o.trait_annotation, param_syms, arg_anns);
            }
            TypeAnnotation::Pointer(p) => {
                TypeResolutionPasses::rewrite_trait_params_annotation(
                    p.inner, param_syms, arg_anns);
            }
            TypeAnnotation::Array(a) => {
                TypeResolutionPasses::rewrite_trait_params_annotation(
                    a.element, param_syms, arg_anns);
            }
            TypeAnnotation::Generic(g) => {
                TypeResolutionPasses::rewrite_trait_params_annotation(
                    g.base, param_syms, arg_anns);
                for (mut i: i64 = 0; i < g.args.length(); i++) {
                    TypeResolutionPasses::rewrite_trait_params_annotation(
                        g.args[i], param_syms, arg_anns);
                }
            }
            TypeAnnotation::Tuple(tu) => {
                for (mut i: i64 = 0; i < tu.elements.length(); i++) {
                    TypeResolutionPasses::rewrite_trait_params_annotation(
                        tu.elements[i], param_syms, arg_anns);
                }
            }
            TypeAnnotation::Function(f) => {
                TypeResolutionPasses::rewrite_trait_params_annotation(
                    f.return_type, param_syms, arg_anns);
                for (mut i: i64 = 0; i < f.parameters.length(); i++) {
                    TypeResolutionPasses::rewrite_trait_params_annotation(
                        f.parameters[i], param_syms, arg_anns);
                }
            }
            _ => { }
        }
    }

    /// Apply both clone-time rewrites to a freshly cloned trait default
    /// method's signature: `This` -> the impl target, and each trait generic
    /// param -> the impl's corresponding trait arg.  Consolidated into one
    /// entry point so the caller makes a single call; the return type is
    /// handled before the param loop so the loop is the trailing statement.
    static rewrite_default_method_signature(cloned_decl: DeclarationNode*,
                                            target: SymbolStr,
                                            target_args: &[TypeAnnotation*],
                                            param_syms: &[SymbolID],
                                            arg_anns: &[TypeAnnotation*],
                                            home_span: SourceSpan,
                                            home_res: ResSlot) -> void {
        const cloned: FunctionDecl* = DeclarationNode::fn_of(cloned_decl);
        if (cloned == null) { return; }
        const ret_ann: TypeAnnotation* = cloned.return_type_annotation;
        if (ret_ann != null) {
            TypeResolutionPasses::rewrite_this_type_annotation(ret_ann, target, target_args, home_span, home_res);
            if (param_syms.length() > 0) {
                TypeResolutionPasses::rewrite_trait_params_annotation(
                    ret_ann, param_syms, arg_anns);
            }
        }
        for (mut p: i64 = 0; p < cloned.parameters.length(); p++) {
            const param_decl: DeclarationNode* = cloned.parameters[p];
            const param: VarDecl* = DeclarationNode::var_of(param_decl);
            if (param != null && param.type_annotation != null) {
                TypeResolutionPasses::rewrite_this_type_annotation(
                    param.type_annotation, target, target_args, home_span, home_res);
                if (param_syms.length() > 0) {
                    TypeResolutionPasses::rewrite_trait_params_annotation(
                        param.type_annotation, param_syms, arg_anns);
                }
            }
        }
    }

    /// True if `ann` mentions `This` anywhere (directly or nested inside a
    /// pointer/reference/optional/array/generic/tuple/function annotation).
    /// Used to flag self-returning trait defaults (combinators) so the
    /// monomorphizer instantiates them lazily rather than eagerly.
    static annotation_references_this(ann: TypeAnnotation*) -> boolean {
        if (ann == null) { return false; }
        return match (*ann) {
            TypeAnnotation::ThisType(_) => { true }
            TypeAnnotation::Reference(r) => {
                TypeResolutionPasses::annotation_references_this(r.inner)
            }
            TypeAnnotation::Object(o) => {
                TypeResolutionPasses::annotation_references_this(o.trait_annotation)
            }
            TypeAnnotation::Pointer(p) => {
                TypeResolutionPasses::annotation_references_this(p.inner)
            }
            TypeAnnotation::Array(a) => {
                TypeResolutionPasses::annotation_references_this(a.element)
            }
            TypeAnnotation::Generic(g) => {
                mut found: boolean =
                    TypeResolutionPasses::annotation_references_this(g.base);
                for (mut i: i64 = 0; i < g.args.length(); i++) {
                    if (TypeResolutionPasses::annotation_references_this(g.args[i])) {
                        found = true;
                    }
                }
                found
            }
            TypeAnnotation::Tuple(tu) => {
                mut found: boolean = false;
                for (mut i: i64 = 0; i < tu.elements.length(); i++) {
                    if (TypeResolutionPasses::annotation_references_this(tu.elements[i])) {
                        found = true;
                    }
                }
                found
            }
            TypeAnnotation::Function(f) => {
                mut found: boolean =
                    TypeResolutionPasses::annotation_references_this(f.return_type);
                for (mut i: i64 = 0; i < f.parameters.length(); i++) {
                    if (TypeResolutionPasses::annotation_references_this(f.parameters[i])) {
                        found = true;
                    }
                }
                found
            }
            _ => { false }
        };
    }

    /// Walk a trait_annotation to its leaf identifier: the bare trait name.
    /// Mirrors `specialization::extract_root_name` but is duplicated here
    /// to keep type_resolution.cryo self-contained.
    /// The stamp on the head's Named annotation, walking the same wrappers
    /// `extract_trait_leaf` walks; `Pending` when there is none.
    /// An impl head on a template writes every parameter of the template it
    /// names - as parameters of its own (`implement<A> trait Display for
    /// String<A>`) or as a concrete instantiation (`implement trait Display
    /// for String<GlobalAlloc>`) - whether every parameter defaults or only the
    /// trailing ones do.  A head that writes fewer is not given the default
    /// meaning: `implement trait Display for String` would be an impl for
    /// `String<GlobalAlloc>` alone while reading as one for every `String`,
    /// and `implement<T> trait Foo for Array<T>` the same for `Array<T,
    /// GlobalAlloc>`.  Refused on the WRITTEN head only: the stamp is what a
    /// written head carries and a clone does not.
    static refuse_elided_template_params(decl: DeclarationNode*, node: ImplBlock*,
                                         ctx: CompilationContext*) -> void {
        const tmpl: TemplateEntry* = ctx.generic_registry.template_of(node.target_def());
        if (tmpl == null || tmpl.param_count == 0) { return; }
        // What the head writes after the target.  An inherent impl's list
        // also declares its names, so its one spelling is the parameter form.
        const inherent: boolean = !node.is_trait_impl();
        const written_count: i64 = node.target_args.length();
        const intern: InternTable* = ctx.intern_table;
        if (written_count == tmpl.param_count) { return; }

        const target: string = intern.resolve(node.target_type);
        const tmpl_params: [DeclarationNode*] = tmpl.get_generic_params();

        // The head as the writer would spell it with every parameter named:
        // its own parameters first, then the template's missing ones under the
        // template's own names.
        mut own_params: string = "";
        for (mut i: i64 = 0; i < node.generic_params.length(); i++) {
            if (i > 0) { own_params = own_params + ", "; }
            own_params = own_params + intern.resolve(DeclarationNode::generic_param_of(node.generic_params[i]).name);
        }
        mut head_params: string = own_params;
        mut target_args: string = "";
        for (mut i: i64 = 0; i < written_count; i++) {
            if (i > 0) { target_args = target_args + ", "; }
            target_args = target_args + TypeAnnotation::spell(node.target_args[i], intern);
        }
        mut concrete_args: string = target_args;
        mut all_defaulted: boolean = true;
        for (mut i: i64 = written_count; i < tmpl_params.length(); i++) {
            const tp: GenericParamDecl* = DeclarationNode::generic_param_of(tmpl_params[i]);
            const pname: string = intern.resolve(tp.name);
            if (head_params.length() > 0) { head_params = head_params + ", "; }
            head_params = head_params + pname;
            if (target_args.length() > 0) { target_args = target_args + ", "; }
            target_args = target_args + pname;
            if (concrete_args.length() > 0) { concrete_args = concrete_args + ", "; }
            if (tp.has_default_annotation()) {
                concrete_args = concrete_args + TypeAnnotation::spell(
                    tp.default_annotation, intern);
            } else {
                concrete_args = concrete_args + "..";
                all_defaulted = false;
            }
        }
        mut trait_part: string = "";
        if (node.is_trait_impl()) {
            trait_part = fmt::format("trait %s ", TypeAnnotation::spell(node.trait_annotation, intern));
        }
        // An inherent impl's parameters ARE the template's, so it has one
        // spelling; a trait impl has the parameter form and the concrete one.
        const param_form: string = if (inherent) {
            fmt::format("implement %s<%s>", target, target_args)
        } else {
            fmt::format("implement<%s> %sfor %s<%s>", head_params, trait_part, target, target_args)
        };
        const concrete_form: string = if (node.generic_params.length() > 0) {
            fmt::format("implement<%s> %sfor %s<%s>", own_params, trait_part, target, concrete_args)
        } else {
            fmt::format("implement %sfor %s<%s>", trait_part, target, concrete_args)
        };

        const span: SourceSpan = if (node.target_type_span.has_location()) { node.target_type_span } else { decl.span };
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0302_GENERIC_PARAM_MISMATCH,
            fmt::format("`%s` is a template with %lld parameter%s, and this impl head names %lld of them",
                   target, tmpl.param_count, if (tmpl.param_count == 1) { "" } else { "s" }, written_count));
        diag = diag.at_with_label(span, "every parameter is written in an impl head");
        diag = diag.with_note(fmt::format("write the parameters: `%s`", param_form));
        // An inherent block is written over the template and has nothing
        // else to offer.
        if (!inherent && all_defaulted) {
            diag = diag.with_note(fmt::format("or a concrete instantiation: `%s`", concrete_form));
        }
        if (!inherent && !all_defaulted) {
            diag = diag.with_note(fmt::format("or a concrete instantiation, one type per parameter: `%s`", concrete_form));
        }
        ctx.emit_diagnostic(diag);
    }

    static head_named_slot(ann: TypeAnnotation*) -> ResSlot {
        if (ann == null) { return ResSlot::Pending; }
        return match (*ann) {
            TypeAnnotation::Named(n) => { n.res }
            TypeAnnotation::Generic(g) => { TypeResolutionPasses::head_named_slot(g.base) }
            TypeAnnotation::Reference(r) => { TypeResolutionPasses::head_named_slot(r.inner) }
            TypeAnnotation::Pointer(p) => { TypeResolutionPasses::head_named_slot(p.inner) }
            _ => { ResSlot::Pending }
        };
    }

    static extract_trait_leaf(ann: TypeAnnotation*) -> SymbolStr {
        if (ann == null) { return SymbolStr::empty(); }
        return match (*ann) {
            TypeAnnotation::Named(n) => { n.name }
            TypeAnnotation::Generic(g) => {
                TypeResolutionPasses::extract_trait_leaf(g.base)
            }
            TypeAnnotation::Reference(r) => {
                TypeResolutionPasses::extract_trait_leaf(r.inner)
            }
            TypeAnnotation::Pointer(p) => {
                TypeResolutionPasses::extract_trait_leaf(p.inner)
            }
            _ => { SymbolStr::empty() }
        };
    }

    /// The implicit associated-type name an `async` trait method's future is
    /// bound to: `read` -> `ReadFut`, `read_exact` -> `ReadExactFut`. Each
    /// `_`-separated word is capitalised and the separators dropped, so the name
    /// reads as an ordinary Cryo type and cannot collide with the method name.
    /// Minted ONCE, by `desugar_async_trait_methods`, which records its
    /// position on the method (`FunctionDecl.async_fut_slot`) for every
    /// later reader.
    /// Case-mapped through explicit alphabet tables rather than char arithmetic:
    /// `CharType` is 4 bytes here while the stdlib treats a char as 1, so
    /// `c - 32` is not a portable way to upper-case in this codebase.
    static async_fut_assoc_name(ctx: CompilationContext*, method: SymbolStr) -> SymbolStr {
        const lower: string = "abcdefghijklmnopqrstuvwxyz";
        const upper: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const src: string = ctx.get_intern_table().resolve(method);
        const n: i64 = src.length() as i64;
        mut out: string = "";
        mut upper_next: boolean = true;
        for (mut i: i64 = 0; i < n; i++) {
            if (src[i] == '_') { upper_next = true; continue; }
            mut piece: string = src.substring(i as u32, 1);
            if (upper_next) {
                for (mut k: i64 = 0; k < 26; k++) {
                    if (src[i] == lower[k]) { piece = upper.substring(k as u32, 1); break; }
                }
            }
            out = fmt::format("%s%s", out, piece);
            upper_next = false;
        }
        return ctx.intern(fmt::format("%sFut", out));
    }

    /// Whether the trait's `slot`-th associated type is the implicit future
    /// type of an `async` trait method that `impl_node` supplies — either with
    /// its own `async` method, or with a default body inherited from the trait.
    ///
    /// Such a binding is added by the sema-time async lowering (which mints the
    /// future struct), long after E0309 runs, so the check has to recognise it
    /// as satisfied here rather than demanding the user write it.
    static impl_binds_assoc_via_async(impl_node: ImplBlock*, trait_decl: TraitDecl*,
                                      slot: i64, ctx: CompilationContext*) -> boolean {
        if (impl_node == null || trait_decl == null || ctx == null) { return false; }
        for (mut ti: i64 = 0; ti < trait_decl.methods.length(); ti++) {
            const tfunc_decl: DeclarationNode* = trait_decl.methods[ti];
            const tfunc: FunctionDecl* = DeclarationNode::fn_of(tfunc_decl);
            if (tfunc == null || !tfunc.is_async) { continue; }
            // The associated type the desugar recorded on the method; not
            // minted again from the leaf.
            if (tfunc.async_fut_slot != slot) { continue; }
            // The impl overrides it with its own `async` method...
            // (its position among the trait's methods, by the trait-method door)
            const item: i64 = ctx.generic_registry.trait_item_slot(trait_decl.def, tfunc.name);
            for (mut mi: i64 = 0; mi < impl_node.methods.length(); mi++) {
                const m_decl: DeclarationNode* = impl_node.methods[mi];
                const m: MethodDecl* = DeclarationNode::method_of(m_decl);
                if (m == null || m.func == null) { continue; }
                if (item >= 0 && ctx.generic_registry.trait_item_slot(trait_decl.def, DeclarationNode::fn_of(m.func).name) == item && DeclarationNode::fn_of(m.func).is_async) { return true; }
            }
            // ...or inherits the trait's default body, which
            // `synthesize_default_trait_methods` clones in as an `async` method.
            if (tfunc.has_body()) { return true; }
        }
        return false;
    }

    /// Desugar every `async` method on a trait declaration.
    ///
    /// `async read(&this, n: i64) -> i64` becomes an implicit `type ReadFut;`
    /// plus a projection return (`read(&this, n: i64) -> This::ReadFut`), which
    /// each impl binds to the future its own `async read` lowers to.
    ///
    /// Only the RESOLVED return is rewritten — the ANNOTATION deliberately keeps
    /// the user's `-> i64`. `synthesize_default_trait_methods` clones a
    /// default-bodied trait method into each impl carrying its annotations, and
    /// that clone must lower as an ordinary `async` method whose future's Output
    /// is `i64`. Rewriting the annotation would make the clone return its own
    /// future type, which is circular.
    ///
    /// The projection is born naming `trait_ref` as its owning trait: a call
    /// on a still-generic receiver carries this type (with `This` replaced by
    /// the receiver's parameter) and nothing else identifies the trait there -
    /// the callee is unresolved until the owner is concrete - so a reader that
    /// needs the declaration (the async lowering's receiver-refresh decision)
    /// reads it off the projection rather than scanning traits by the method's
    /// leaf, which answers the first trait declaring that leaf, async or not.
    static desugar_async_trait_methods(node: TraitDecl*, ctx: CompilationContext*,
                                       arena: TypeArena*, trait_ref: TypeRef) -> void {
        if (node == null || ctx == null || arena == null) { return; }
        const this_ty: TypeRef = arena.this_placeholder(ctx.intern("This"));
        if (!this_ty.is_valid()) { return; }
        for (mut i: i64 = 0; i < node.methods.length(); i++) {
            const func_decl: DeclarationNode* = node.methods[i];
            const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
            if (func == null || !func.is_async) { continue; }
            const assoc: SymbolStr =
                TypeResolutionPasses::async_fut_assoc_name(ctx, func.name);
            if (!assoc.is_valid()) { continue; }
            // A trait may legitimately declare the associated type itself; only
            // synthesize the one that is missing, so an explicit `type ReadFut;`
            // keeps its declaration-site bounds.
            mut slot: i64 = node.assoc_type_index(assoc);
            if (slot < 0) {
                mut adecl: AssocTypeDeclNode* =
                    libc::malloc(sizeof(AssocTypeDeclNode)) as AssocTypeDeclNode*;
                *adecl = AssocTypeDeclNode {
                    name:   assoc,
                    bounds: [],
                    span:   func_decl.span,
                };
                node.assoc_types.push(adecl);
                slot = node.assoc_types.length() - 1;
            }
            // The name is made here and nowhere else: the method carries its
            // position for every reader that would otherwise mint it again.
            func.set_async_fut_slot(slot);
            func.set_resolved_return_type(
                arena.create_assoc_projection(this_ty, assoc, trait_ref, slot));
        }
    }

    /// The projected member (`Item`) of a projection type-annotation, else empty.
    static projection_member_of(ann: TypeAnnotation*) -> SymbolStr {
        if (ann == null) { return SymbolStr::empty(); }
        return match (*ann) {
            TypeAnnotation::Projection(pj) => { pj.member }
            _ => { SymbolStr::empty() }
        };
    }

    /// Whether `ann` is an associated-type projection annotation (`I::Item`).
    static is_projection_annotation(ann: TypeAnnotation*) -> boolean {
        if (ann == null) { return false; }
        return match (*ann) {
            TypeAnnotation::Projection(_) => { true }
            _ => { false }
        };
    }

    /// The registered type a written argument names, off its stamp: a
    /// declaration's type (its template, for an instantiation), a
    /// primitive's.  Invalid for a type parameter, a projection, or a shape
    /// that names no registered type.
    static item_type_of(ann: TypeAnnotation*, ctx: CompilationContext*) -> TypeRef {
        if (ann == null) { return TypeRef::invalid(); }
        return match (*ann) {
            TypeAnnotation::Named(n) => {
                match (n.res.require("type_resolution:item annotation")) {
                    Res::Def(d)    => { ctx.decl_index.type_of_def(d) }
                    Res::PrimTy(p) => { ctx.type_resolver.resolve_primitive(p) }
                    _              => { TypeRef::invalid() }
                }
            }
            TypeAnnotation::Primitive(p) => { ctx.type_resolver.resolve_primitive(p.name) }
            TypeAnnotation::Generic(g)   => { TypeResolutionPasses::item_type_of(g.base, ctx) }
            TypeAnnotation::Reference(r) => { TypeResolutionPasses::item_type_of(r.inner, ctx) }
            TypeAnnotation::Pointer(p)   => { TypeResolutionPasses::item_type_of(p.inner, ctx) }
            _ => { TypeRef::invalid() }
        };
    }

    /// Whether a projection-bounded trait-default method (`min where This::Item:
    /// Ord`) is applicable to THIS impl. Returns false ONLY when the impl's
    /// concrete Item type definitively does not implement a bound trait - the
    /// case that must be filtered so the default's body is never synthesized
    /// (and then type-checked) for it (e.g. `EnumerateIter`/`ZipIter` whose Item
    /// is `Pair`, which is never `Ord`). A SYMBOLIC Item - a bare impl generic
    /// param (`A`), or an `I::Item` projection - is undecidable here and kept;
    /// its applicability is settled at the trait-level symbolic pass or per
    /// monomorphization. `args_ref` is the impl's trait-arg annotations.
    static default_method_applies_to_impl(tfunc_decl: DeclarationNode*,
                                          impl_node: ImplBlock*,
                                          trait_decl: TraitDecl*,
                                          args_ref: &[TypeAnnotation*],
                                          ctx: CompilationContext*) -> boolean {
        const tfunc: FunctionDecl* = DeclarationNode::fn_of(tfunc_decl);
        if (tfunc == null || impl_node == null || trait_decl == null) { return true; }
        for (mut bi: i64 = 0; bi < tfunc.trait_bounds.length(); bi++) {
            const b: TraitBound* = &tfunc.trait_bounds[bi];
            if (!b.has_projection_subject()) { continue; }
            const member: SymbolStr =
                TypeResolutionPasses::projection_member_of(b.subject_type);
            if (!member.is_valid()) { continue; }
            // Position of `member` among the trait's associated types, then in
            // the impl's positional trait-arg list (generic params first).
            const assoc_idx: i64 = trait_decl.assoc_type_index(member);
            if (assoc_idx < 0) { continue; }
            const arg_idx: i64 = trait_decl.generic_params.length() + assoc_idx;
            if (arg_idx < 0 || arg_idx >= args_ref.length()) { continue; }
            const item_ann: TypeAnnotation* = args_ref[arg_idx];
            if (item_ann == null) { continue; }
            // A symbolic Item - a projection or an impl-declared parameter -
            // names no registered type: keep.
            if (TypeResolutionPasses::is_projection_annotation(item_ann)) { continue; }
            // A concrete Item - its registered type, off the stamp - must
            // implement every bound trait, or the default cannot apply here.
            // Asked of the trait's IDENTITY and the type: a leaf answers for
            // every module's trait and type of that leaf.
            const item_ty: TypeRef = TypeResolutionPasses::item_type_of(item_ann, ctx);
            if (!item_ty.is_valid()) { continue; }
            for (mut ti: i64 = 0; ti < b.trait_refs.length(); ti++) {
                const tr: TraitRef* = &b.trait_refs[ti];
                if (tr.path.length() == 0) { continue; }
                if (ctx.generic_registry.select_trait_impl(tr.definition(), item_ty, ctx.intern_table) == null) {
                    return false;
                }
            }
        }
        return true;
    }

    /// An implement block's parameters bound to its OWNER's own parameters
    /// through the head (`U` in `implement<U> .. for Wrap<U>` to `Wrap`'s
    /// `T`): what a return written in the block's parameters is stored
    /// under (`DeclarationIndex::register_methods_through`).  Empty for a
    /// block whose target is no template, or `node` null.
    static impl_params_to_owner(node: ImplBlock*, ctx: CompilationContext*,
                                arena: TypeArena*) -> TypeSubstitution {
        mut head: TypeSubstitution = TypeSubstitution::empty();
        if (node == null) { return head; }
        const tmpl: TemplateEntry* = ctx.generic_registry.template_of(node.target_def());
        if (tmpl == null) { return head; }
        mut owner_params: [TypeRef] = [];
        for (mut i: i64 = 0; i < tmpl.param_types.length(); i++) {
            owner_params.push(tmpl.param_types[i]);
        }
        const tc: TraitChecker = TraitChecker::new(arena, ctx.generic_registry,
                                                   ctx.intern_table, ctx.diagnostics);
        tc.add_head_param_bindings(node, &owner_params, &head);
        return head;
    }

    /// The coherence key of a trait impl's head, as identities: the trait's
    /// definition and its type arguments, the target and its type
    /// arguments, and the where-bounds, a type by its arena id and the
    /// impl's own parameters by their position (read off their stamps), so
    /// two heads are one key exactly when they are one head.  Each part is
    /// a tag followed by its value.  False, with the key incomplete, when a
    /// part of the head has no identity - a name the name layer refused,
    /// reported where it is written - and the head then takes part in no
    /// coherence check.
    static coherence_key_of(node: ImplBlock*, ctx: CompilationContext*, key: mut &[u64]) -> boolean {
        if (!TypeResolutionPasses::ann_key(node.trait_annotation, node, ctx, key)) { return false; }
        key.push(COH_FOR);
        const head_res: Res = node.res.require("type_resolution: coherence head");
        if (!TypeResolutionPasses::res_key(head_res, node, ctx, key)) { return false; }
        key.push(COH_ARGS);
        key.push(node.target_args.length() as u64);
        for (mut i: i64 = 0; i < node.target_args.length(); i++) {
            if (!TypeResolutionPasses::ann_key(node.target_args[i], node, ctx, key)) { return false; }
        }
        key.push(COH_WHERE);
        key.push(node.where_bounds.length() as u64);
        for (mut i: i64 = 0; i < node.where_bounds.length(); i++) {
            const wb: TraitBound* = &node.where_bounds[i];
            const pidx: i64 = TypeResolutionPasses::impl_param_position(node, wb.subject_sym);
            if (pidx >= 0) {
                key.push(COH_PARAM);
                key.push(pidx as u64);
            } else if (wb.subject_type != null) {
                key.push(COH_PROJECTION);
            } else {
                return false;
            }
            key.push(wb.trait_refs.length() as u64);
            for (mut j: i64 = 0; j < wb.trait_refs.length(); j++) {
                const tr: TraitRef* = &wb.trait_refs[j];
                key.push(COH_DEF);
                key.push(if (tr.path.length() > 0) { (ctx.defs.slot(tr.definition()) as u64) + 1 } else { 0 });
                key.push(tr.type_args.length() as u64);
                for (mut k: i64 = 0; k < tr.type_args.length(); k++) {
                    if (!TypeResolutionPasses::ann_key(tr.type_args[k], node, ctx, key)) { return false; }
                }
            }
        }
        return true;
    }

    /// The position among `node`'s own generic parameters of the one the
    /// symbol `sym` names; -1 for none.
    static impl_param_position(node: ImplBlock*, sym: SymbolID) -> i64 {
        if (node == null || !sym.is_valid()) { return -1; }
        for (mut i: i64 = 0; i < node.generic_params.length(); i++) {
            const gp_decl: DeclarationNode* = node.generic_params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            if (gp != null && gp.sym_id.equals(sym)) { return i; }
        }
        return -1;
    }

    /// A projection through one of the impl's own parameters (`I::Item`)
    /// as a coherence key's part: the parameter's position, then the trait a
    /// where-bound on that parameter names whose declaration has the member,
    /// and the member's position among that trait's associated types (the
    /// `assoc-type` door, asked with the path's last segment).  False when
    /// no bound's trait declares the member.
    static projection_key(node: ImplBlock*, param: SymbolID, written: SymbolStr,
                          ctx: CompilationContext*, key: mut &[u64]) -> boolean {
        const pidx: i64 = TypeResolutionPasses::impl_param_position(node, param);
        if (pidx < 0) { return false; }
        const member: SymbolStr = QualifiedName::parse(ctx.intern_table, ctx.intern_table.resolve(written)).leaf();
        for (mut i: i64 = 0; i < node.where_bounds.length(); i++) {
            const wb: TraitBound* = &node.where_bounds[i];
            if (!wb.subject_sym.equals(param)) { continue; }
            for (mut j: i64 = 0; j < wb.trait_refs.length(); j++) {
                const tr: TraitRef* = &wb.trait_refs[j];
                if (tr.path.length() == 0) { continue; }
                const decl: TraitDecl* = ctx.generic_registry.get_trait_decl(tr.definition());
                if (decl == null) { continue; }
                const slot: i64 = decl.assoc_type_index(member);
                if (slot < 0) { continue; }
                key.push(COH_PROJECTION);
                key.push(pidx as u64);
                key.push((ctx.defs.slot(tr.definition()) as u64) + 1);
                key.push(slot as u64);
                return true;
            }
        }
        return false;
    }

    /// A stamped type-position name's part of a coherence key: an impl
    /// parameter by its position, a declared type or a primitive by its
    /// arena id.  False for any other answer.
    static res_key(r: Res, node: ImplBlock*, ctx: CompilationContext*, key: mut &[u64]) -> boolean {
        mut tref: TypeRef = TypeRef::invalid();
        match (r) {
            Res::GenericParam(s) => {
                const pidx: i64 = TypeResolutionPasses::impl_param_position(node, s);
                if (pidx < 0) { return false; }
                key.push(COH_PARAM);
                key.push(pidx as u64);
                return true;
            }
            Res::Def(q)    => { tref = ctx.decl_index.type_of_def(q); }
            Res::PrimTy(n) => { tref = ctx.decl_index.type_of_def(ctx.defs.primitive(n)); }
            _              => { }
        }
        if (!tref.is_valid()) { return false; }
        key.push(COH_TYPE);
        key.push(tref.key());
        return true;
    }

    /// A type annotation's part of a coherence key, structurally: each
    /// shape's tag and arity, then its parts.
    static ann_key(ann: TypeAnnotation*, node: ImplBlock*, ctx: CompilationContext*, key: mut &[u64]) -> boolean {
        if (ann == null) {
            key.push(COH_NONE);
            return true;
        }
        match (*ann) {
            TypeAnnotation::Primitive(p) => {
                // An alias keyword (`int`) is the primitive it spells, as the
                // name layer stamps it.
                mut prim: SymbolStr = p.name;
                const canon: string = ResBase::primitive_of_alias(ctx.intern_table.resolve(p.name));
                if (canon.length() > 0) { prim = ctx.intern_table.intern(canon); }
                return TypeResolutionPasses::res_key(Res::PrimTy(prim), node, ctx, key);
            }
            TypeAnnotation::Named(n) => {
                const r: Res = n.res.require("type_resolution: coherence key name");
                match (r) {
                    Res::TypeRelative(b, trailing) => {
                        if (trailing != 1) { return false; }
                        match (b) {
                            ResBase::GenericParam(s) => {
                                return TypeResolutionPasses::projection_key(node, s, n.name, ctx, key);
                            }
                            _ => { return false; }
                        }
                    }
                    _ => { }
                }
                return TypeResolutionPasses::res_key(r, node, ctx, key);
            }
            TypeAnnotation::Generic(g) => {
                key.push(COH_GENERIC);
                key.push(g.args.length() as u64);
                if (!TypeResolutionPasses::ann_key(g.base, node, ctx, key)) { return false; }
                for (mut i: i64 = 0; i < g.args.length(); i++) {
                    if (!TypeResolutionPasses::ann_key(g.args[i], node, ctx, key)) { return false; }
                }
                return true;
            }
            TypeAnnotation::Reference(r) => {
                key.push(if (r.is_mutable) { COH_REF_MUT } else { COH_REF });
                return TypeResolutionPasses::ann_key(r.inner, node, ctx, key);
            }
            TypeAnnotation::Pointer(p) => {
                key.push(COH_POINTER);
                return TypeResolutionPasses::ann_key(p.inner, node, ctx, key);
            }
            TypeAnnotation::Array(a) => {
                key.push(COH_ARRAY);
                return TypeResolutionPasses::ann_key(a.element, node, ctx, key);
            }
            TypeAnnotation::Tuple(t) => {
                key.push(COH_TUPLE);
                key.push(t.elements.length() as u64);
                for (mut i: i64 = 0; i < t.elements.length(); i++) {
                    if (!TypeResolutionPasses::ann_key(t.elements[i], node, ctx, key)) { return false; }
                }
                return true;
            }
            TypeAnnotation::ThisType(_) => {
                key.push(COH_THIS);
                return true;
            }
            _ => {
                key.push(COH_OTHER);
                return true;
            }
        }
    }

    /// Peel a trait annotation down to its underlying GenericAnnotation
    /// node (through Reference/Pointer wrappers), or null when the trait is
    /// non-generic.  Returns the NODE pointer (Copy, non-owning), NOT a copy
    /// of its `args`: callers read `gen.args` in place (member access /
    /// indexing through the pointer) so the node keeps SOLE ownership of the
    /// owning array.  Returning `g.args` by value aliased the field's buffer
    /// into a droppable local, and since `[TypeAnnotation*]` is deep-owning
    /// over its elements, two callers each dropping that alias double-freed
    /// the node's args buffer (and its element nodes).
    static peel_to_generic(ann: TypeAnnotation*) -> GenericAnnotation* {
        if (ann == null) { return null; }
        return match (*ann) {
            TypeAnnotation::Generic(g) => { g }
            TypeAnnotation::Reference(r) => {
                TypeResolutionPasses::peel_to_generic(r.inner)
            }
            TypeAnnotation::Pointer(p) => {
                TypeResolutionPasses::peel_to_generic(p.inner)
            }
            _ => { null }
        };
    }

    /// Clone every default-bodied trait method that `impl_node` doesn't
    /// override. Returns the number of methods added.
    static synthesize_default_trait_methods(impl_decl: DeclarationNode*, impl_node: ImplBlock*,
                                             ctx: CompilationContext*) -> i64 {
        if (impl_node == null) { return 0; }
        if (!impl_node.is_trait_impl()) { return 0; }

        const trait_name: DefId = TypeAnnotation::trait_def(
            impl_node.trait_annotation);
        if (!trait_name.is_valid()) { return 0; }

        const trait_decl: TraitDecl* = ctx.generic_registry.get_trait_decl(trait_name);
        if (trait_decl == null) { return 0; }

        // Quick scan: is there at least one default-bodied trait method
        // not overridden by this impl?  If not, return 0 without doing
        // any allocation.  Most stdlib trait impls hit this path.
        mut needs_synthesis: boolean = false;
        for (mut ti: i64 = 0; ti < trait_decl.methods.length(); ti++) {
            const tfunc_decl: DeclarationNode* = trait_decl.methods[ti];
            const tfunc: FunctionDecl* = DeclarationNode::fn_of(tfunc_decl);
            if (tfunc == null) { continue; }
            if (!tfunc.has_body()) { continue; }
            const overridden: boolean =
                ctx.generic_registry.writes_trait_item(impl_node, trait_name, ti);
            if (!overridden) {
                needs_synthesis = true;
                break;
            }
        }
        if (!needs_synthesis) { return 0; }

        // Map the trait's own generic params onto this impl's trait args so
        // cloned signatures referencing `Item` (etc.) become the concrete
        // arg (`T`, `i32`, `Pair<u64, A>`, ...).  Only meaningful when the
        // arities line up; an arity mismatch is a user error reported
        // elsewhere, so we skip the rewrite and let that path fire.
        // Read the trait args in place through the node; never copy the
        // owning `gen.args` array into a droppable local (double-free).
        // The non-generic case (gen == null) borrows a local empty sentinel
        // so the downstream `&[TypeAnnotation*]` borrow always has a valid
        // referent (it is never iterated when param_names is empty anyway).
        const gen: GenericAnnotation* =
            TypeResolutionPasses::peel_to_generic(impl_node.trait_annotation);
        const empty_args: [TypeAnnotation*] = [];
        const arg_count: i64 = if (gen != null) { gen.args.length() } else { 0 };
        const args_ref: &[TypeAnnotation*] =
            if (gen != null) { &gen.args } else { &empty_args };
        mut trait_param_syms: [SymbolID] = [];
        if (arg_count == trait_decl.generic_params.length()) {
            for (mut gi: i64 = 0; gi < trait_decl.generic_params.length(); gi++) {
                const gp_decl: DeclarationNode* = trait_decl.generic_params[gi];
                const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
                if (gp == null) {
                    trait_param_syms = [];
                    break;
                }
                trait_param_syms.push(gp.sym_id);
            }
        }

        // Clone each not-overridden default method into the impl block.
        // The clones go through the rest of FunctionSignature/TypeResolution/
        // Sema in the same loop, picking up the impl's `this_type` so any
        // `This` annotations resolve to the implementing type.
        mut cloner: ASTCloner = ASTCloner::new();
        mut synthesized: i64 = 0;
        // `This::member` in a default's body names the trait's implementor,
        // which in this block's copy is the type the block is for.
        mut stamp: ImplementorStamp = ImplementorStamp {
            owner:  ResBase::Def(DefId::invalid()),
            params: [],
        };
        const has_self: boolean = impl_node.self_type(&stamp.owner);
        for (mut gi: i64 = 0; gi < impl_node.generic_params.length(); gi++) {
            stamp.params.push(impl_node.generic_params[gi]);
        }

        for (mut ti: i64 = 0; ti < trait_decl.methods.length(); ti++) {
            const tfunc_decl: DeclarationNode* = trait_decl.methods[ti];
            const tfunc: FunctionDecl* = DeclarationNode::fn_of(tfunc_decl);
            if (tfunc == null) { continue; }
            if (!tfunc.has_body()) { continue; }

            const already_present: boolean =
                ctx.generic_registry.writes_trait_item(impl_node, trait_name, ti);
            if (already_present) { continue; }

            // Skip cloning a projection-bounded default (`min`/`max` with
            // `where This::Item: Ord`) into an impl whose CONCRETE Item type
            // definitively lacks the bound trait - e.g. `EnumerateIter`/`ZipIter`
            // yield `Pair`, which is never `Ord`. Without this the default body
            // would be synthesized and then type-checked against a `Pair`
            // receiver (`.compare()`), a spurious E0358. Symbolic Item types
            // (a param `A`, or an `I::Item` projection) are kept and decided
            // later.
            if (!TypeResolutionPasses::default_method_applies_to_impl(
                    tfunc_decl, impl_node, trait_decl, args_ref, ctx)) {
                continue;
            }

            const cloned_decl: DeclarationNode* = cloner.clone_func_decl(tfunc_decl);
            const cloned: FunctionDecl* = DeclarationNode::fn_of(cloned_decl);
            if (cloned == null) { continue; }
            cloned.set_synth_default(true);
            // A default whose return mentions `This` (e.g. combinators
            // returning `MapIter<This, ...>`) is self-referential: eagerly
            // instantiating it for an adapter's own impl recurses forever.
            // Flag it (checked on the pre-rewrite annotation) so mono
            // instantiates it lazily, only at call sites.
            if (TypeResolutionPasses::annotation_references_this(
                    tfunc.return_type_annotation)) {
                cloned.set_self_returning_default(true);
            }
            // Rewrite `&This` / `-> This` annotations on the cloned signature
            // to the impl's target. The trait body keeps `ThisType` for
            // generic resolution at trait-sig time; the impl body needs a
            // concrete name so resolution doesn't depend on `ctx.this_type`
            // being set (it isn't for generic impl targets whose decl_index
            // lookup misses).
            // The target name as written after `for`, falling back to the block
            // when the parser stamped no location.  Both name the impl's file,
            // which is what the rewritten annotation needs; the narrower one
            // also points a diagnostic at the type rather than the whole block.
            const this_home_span: SourceSpan =
                if (impl_node.target_type_span.has_location()) {
                    impl_node.target_type_span
                } else {
                    impl_decl.span
                };
            TypeResolutionPasses::rewrite_default_method_signature(
                cloned_decl, impl_node.target_type, impl_node.target_args,
                trait_param_syms, args_ref, this_home_span, impl_node.res);
            if (has_self) { stamp.walk_decl(cloned_decl); }
            mut method: MethodDecl* = MethodDecl::new(cloned_decl);
            const method_decl: DeclarationNode* = DeclarationNode::of(DeclKind::Method(method), cloned_decl.span);
            method.set_static(cloned.is_static);
            impl_node.methods.push(method_decl);
            synthesized += 1;
        }

        return synthesized;
    }


    /// Whether a free function named `name` with signature `sig` was seen
    /// before among one module's (`names`, `types`); it is recorded when it
    /// was not.
    static signature_repeats(names: [u32]*, types: [u64]*, name: SymbolStr, sig: u64) -> boolean {
        for (mut k: i64 = 0; k < (*names).length(); k++) {
            if ((*names)[k] == name.id && (*types)[k] == sig) { return true; }
        }
        (*names).push(name.id);
        (*types).push(sig);
        return false;
    }

    /// Record a non-generic struct's resolved fields and methods on its arena
    /// type; false when there is nothing to record - a template, or no arena
    /// type to record on.
    static sync_struct_members(node: StructDecl*, ctx: CompilationContext*, arena: TypeArena*) -> boolean {
        if (node.is_generic()) { return false; }

        const type_ref: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/struct field sync");
        if (!type_ref.is_valid()) { return false; }

        const base_type: Type* = arena.lookup(type_ref);
        if (base_type == null || base_type.kind != TypeKind::Struct) { return false; }

        mut st: StructType* = base_type.as_struct();
        mut field_infos: [FieldInfo] = [];
        for (mut j: i64 = 0; j < node.fields.length(); j++) {
            const field_decl: DeclarationNode* = node.fields[j];
            const field: FieldDecl* = DeclarationNode::field_of(field_decl);
            if (field == null) { continue; }
            // An unresolved field type must never be baked into the arena:
            // TypeLowering would size the struct from the id-0 sentinel (wrong
            // layout) or the mangler would ICE, both decoupled from any
            // diagnostic.  Emit E0203 here so the pass fails (via
            // from_snapshot) and Phase 5 aborts before codegen ever sees the
            // poisoned StructType.
            if (!field.resolved_type.is_valid()) {
                const fname: string = ctx.intern_table.resolve(field.name);
                const sname: string = ctx.intern_table.resolve(node.name);
                ctx.emit_error_at(ErrorCode::E0203_UNDEFINED_TYPE,
                    fmt::format("cannot resolve type for field `%s` of `%s`", fname, sname),
                    field_decl.span);
                continue;
            }
            mut fi: FieldInfo = FieldInfo::new(field.name, field.resolved_type, field.visibility, true);
            fi.set_default_value(field.default_value);
            field_infos.push(fi);
        }
        st.set_fields(field_infos);

        // Layout attributes (`![repr]` / `![align]`) are propagated from the
        // AST onto the StructType by DirectiveProcessing, which runs *after*
        // this pass.  See `propagate_layout_attrs_to_types` there.

        // Populate StructType.methods so sema's overload resolution
        // (resolve_method_overload) can pick the right overload for struct
        // methods.
        for (mut jm: i64 = 0; jm < node.methods.length(); jm++) {
            const mnode_decl: DeclarationNode* = node.methods[jm];
            const mnode: MethodDecl* = DeclarationNode::method_of(mnode_decl);
            if (mnode == null || mnode.func == null) { continue; }
            const fn_node_decl: DeclarationNode* = mnode.func;
            const fn_node: FunctionDecl* = DeclarationNode::fn_of(fn_node_decl);
            mut ptypes: [TypeRef] = [];
            for (mut pi: i64 = 0; pi < fn_node.parameters.length(); pi++) {
                const pp_decl: DeclarationNode* = fn_node.parameters[pi];
                const pp: VarDecl* = DeclarationNode::var_of(pp_decl);
                if (pp == null) { continue; }
                if (pp.is_receiver()) { continue; }
                ptypes.push(pp.resolved_type);
            }
            const fn_ty: TypeRef = arena.get_function(
                fn_node.resolved_return_type, ptypes, fn_node.is_variadic);
            const minfo: MethodInfo = MethodInfo {
                name:          fn_node.name,
                function_type: fn_ty,
                is_static:     mnode.is_static,
                param_types:   ptypes,
                ast_node:      mnode_decl as void*,
            };
            st.add_method(minfo);
        }
        return true;
    }

    /// Record a non-generic implement block's methods on its target's arena
    /// type, so method-call sema finds them there.  This applies to both
    /// inherent impls (`implement Foo { ... }`) and trait impls (`implement
    /// trait T for Foo { ... }`): without it only the methods declared inline
    /// in a struct body land on `StructType.methods`, and methods delivered
    /// by impl blocks were invisible to the call-arg expected_type
    /// propagation, so generic-method calls inside trait-impl method bodies
    /// (e.g. `NonNull::new(...)` as an argument to `deallocate`) had no
    /// concrete instantiation to point at.
    ///
    /// The owner is read off the head's stamp.  A spelling qualified by the
    /// writer's module misses every trait implemented for another module's
    /// type, and those methods were then invisible here - absent from the
    /// type's method list, so a call's argument types could not be
    /// propagated from them and `Type::member` could not tell the type from a
    /// module.
    static sync_impl_methods(node: ImplBlock*, ctx: CompilationContext*, arena: TypeArena*) -> void {
        if (node.is_generic()) { return; }
        const tgt: TypeRef = ctx.decl_index.impl_owner(node, "type_resolution/struct field sync");
        if (!tgt.is_valid()) { return; }
        const tgt_t: Type* = arena.lookup(tgt);
        if (tgt_t == null) { return; }
        for (mut mi: i64 = 0; mi < node.methods.length(); mi++) {
            const mnode_decl: DeclarationNode* = node.methods[mi];
            const mnode: MethodDecl* = DeclarationNode::method_of(mnode_decl);
            if (mnode == null || mnode.func == null) { continue; }
            const fn_node_decl: DeclarationNode* = mnode.func;
            const fn_node: FunctionDecl* = DeclarationNode::fn_of(fn_node_decl);
            mut ptypes: [TypeRef] = [];
            for (mut pi: i64 = 0; pi < fn_node.parameters.length(); pi++) {
                const pp_decl: DeclarationNode* = fn_node.parameters[pi];
                const pp: VarDecl* = DeclarationNode::var_of(pp_decl);
                if (pp == null) { continue; }
                if (pp.is_receiver()) { continue; }
                ptypes.push(pp.resolved_type);
            }
            const fn_ty: TypeRef = arena.get_function(
                fn_node.resolved_return_type, ptypes, fn_node.is_variadic);
            // Build the MethodInfo only on the paths that consume it.
            // MethodInfo has no Drop impl (its owned param_types array is
            // freed by field drop-glue at scope exit, not via an explicit
            // `.drop()`), so it can't be released on a dead path; instead
            // `ptypes` is moved into minfo on exactly the struct/enum
            // branches and dropped directly otherwise.
            if (tgt_t.kind == TypeKind::Struct
                    || tgt_t.kind == TypeKind::Enum) {
                const minfo: MethodInfo = MethodInfo {
                    name:          fn_node.name,
                    function_type: fn_ty,
                    is_static:     mnode.is_static,
                    param_types:   ptypes,
                    ast_node:      mnode_decl as void*,
                };
                if (tgt_t.kind == TypeKind::Struct) {
                    mut tst: StructType* = tgt_t.as_struct();
                    tst.add_method(minfo);
                } else {
                    // An enum's inherent methods live only in `implement
                    // enum E { }` blocks, so this is the ONLY way any reach
                    // its method set.
                    mut tet: EnumType* = tgt_t.as_enum();
                    tet.add_method(minfo);
                }
            } else {
                mem::drop(ptypes);
            }
        }
    }

    /// Record a non-generic union's resolved fields and methods on its arena
    /// type (a StructType with is_union set); false when there is nothing to
    /// record - a template, or no arena type to record on.  A field whose type
    /// did not resolve is refused (E0203) and left out.
    static sync_union_members(node: UnionDecl*, ctx: CompilationContext*, arena: TypeArena*) -> boolean {
        if (node.is_generic()) { return false; }

        const type_ref: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/union field sync");
        if (!type_ref.is_valid()) { return false; }

        const base_type: Type* = arena.lookup(type_ref);
        if (base_type == null || base_type.kind != TypeKind::Struct) { return false; }

        mut st: StructType* = base_type.as_struct();
        mut field_infos: [FieldInfo] = [];
        for (mut j: i64 = 0; j < node.fields.length(); j++) {
            const field_decl: DeclarationNode* = node.fields[j];
            const field: FieldDecl* = DeclarationNode::field_of(field_decl);
            if (field == null) { continue; }
            if (!field.resolved_type.is_valid()) {
                const fname: string = ctx.intern_table.resolve(field.name);
                const sname: string = ctx.intern_table.resolve(node.name);
                ctx.emit_error_at(ErrorCode::E0203_UNDEFINED_TYPE,
                    fmt::format("cannot resolve type for field `%s` of `%s`", fname, sname),
                    field_decl.span);
                continue;
            }
            mut fi: FieldInfo = FieldInfo::new(field.name, field.resolved_type, field.visibility, true);
            fi.set_default_value(field.default_value);
            field_infos.push(fi);
        }
        st.set_fields(field_infos);

        for (mut jm: i64 = 0; jm < node.methods.length(); jm++) {
            const mnode_decl: DeclarationNode* = node.methods[jm];
            const mnode: MethodDecl* = DeclarationNode::method_of(mnode_decl);
            if (mnode == null || mnode.func == null) { continue; }
            const fn_node_decl: DeclarationNode* = mnode.func;
            const fn_node: FunctionDecl* = DeclarationNode::fn_of(fn_node_decl);
            mut ptypes: [TypeRef] = [];
            for (mut pi: i64 = 0; pi < fn_node.parameters.length(); pi++) {
                const pp_decl: DeclarationNode* = fn_node.parameters[pi];
                const pp: VarDecl* = DeclarationNode::var_of(pp_decl);
                if (pp == null) { continue; }
                if (pp.is_receiver()) { continue; }
                ptypes.push(pp.resolved_type);
            }
            const fn_ty: TypeRef = arena.get_function(
                fn_node.resolved_return_type, ptypes, fn_node.is_variadic);
            const minfo: MethodInfo = MethodInfo {
                name:          fn_node.name,
                function_type: fn_ty,
                is_static:     mnode.is_static,
                param_types:   ptypes,
                ast_node:      mnode_decl as void*,
            };
            st.add_method(minfo);
        }
        return true;
    }

    // Pass 1: FunctionSignature (order 7)

    /// A trait's method signatures, resolved and recorded on its arena type;
    /// answers how many it has.
    /// An implement block's method signatures, with the trait's defaults it
    /// does not override copied in first; answers how many it resolved.
    static impl_signatures(runner: mut &TypeResolutionRunner, decl: DeclarationNode*,
                           node: ImplBlock*, ctx: CompilationContext*) -> i64 {
        const _added: i64 = TypeResolutionPasses::synthesize_default_trait_methods(
            decl, node, ctx);

        if (Log::enabled(LogArea::Types, LogLevel::Trace)) {
            const target: string = ctx.intern_table.resolve(node.target_type);
            Log::trace(LogArea::Types, f"implement block for '{target}': {node.methods.length()} methods");
            for (mut mi: i64 = 0; mi < node.methods.length(); mi++) {
                if (DeclarationNode::method_of(node.methods[mi]) == null) {
                    Log::trace(LogArea::Types, f"implement block for '{target}': method {mi} is not a method declaration");
                }
            }
        }
        mut impl_ctx: ResolutionContext = runner.make_generic_context(
            node.generic_params, &runner.res_ctx);
        // Trait impls: bind the trait's outer generic params to the impl's
        // trait args (e.g. `Item -> T` for an `implement<T> Iterator<T> for
        // Bar<T>`).  Cloned default-method bodies reference these names
        // through the trait's signature; without this binding, those
        // references resolve to invalid TypeRefs and the mangler downstream
        // produces a junk symbol with a hole where `Item` should be.
        runner.bind_trait_args_for_impl(node, &impl_ctx);
        // Flag an unbound associated type (E0309) or a positional assoc
        // binding on a trait that also has generic params (E0310).  Runs once
        // per source-level impl here in the FuncSig phase.
        runner.validate_impl_assoc_bindings(decl, node);
        // The owner type and its canonical name, off the head's stamp.  A
        // spelling qualified by the WRITER's module names the type only when
        // the writer declared it: a trait implemented for another module's
        // type (`implement trait Display for Str` in `fmt::display`) has no
        // owner under that key, and its methods then resolve with no receiver
        // type to back-fill and no `This` to bind.
        const impl_args: [TypeRef] = runner.impl_owner_args(node, &impl_ctx);
        runner.resolve_method_signatures(node.methods, &impl_ctx,
            ctx.decl_index.impl_owner(node, "type_resolution/impl methods"), node.target_def(), &impl_args);
        return node.methods.length();
    }

    static trait_signatures(runner: mut &TypeResolutionRunner, node: TraitDecl*,
                            ctx: CompilationContext*, arena: TypeArena*) -> i64 {
        mut trait_ctx: ResolutionContext = runner.make_generic_context(
            node.generic_params, &runner.res_ctx);
        runner.resolve_trait_method_signatures(node.methods, &trait_ctx);
        // Final for traits: `run_type_resolution` re-resolves impl
        // and inline method signatures, but not a trait's own.
        // Before the async desugar below, so an `async` method is
        // judged on the Output its annotation spells rather than on
        // the future projection that replaces it.
        runner.emit_trait_method_signature_diagnostics(node.methods);
        // Rewrite each `async` method's resolved return to its
        // implicit `This::<Method>Fut` projection AFTER the ordinary
        // resolution, so callers see the future type while the
        // annotation still spells the Output for impl-side lowering.
        // Must precede the `required_methods` population below,
        // which snapshots these signatures onto the TraitType.
        const tr_ref: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/trait populate");
        TypeResolutionPasses::desugar_async_trait_methods(node, ctx, arena, tr_ref);

        // Populate the TraitType's required_methods array so the
        // bound-aware-dispatch path in sema can read trait method
        // signatures off the arena type. Without this, every
        // bounded-parameter receiver call has to fall back to
        // brittle name-only lookups in the DeclarationIndex.
        const tr_t: Type* = if (tr_ref.is_valid()) {
            arena.lookup(tr_ref)
        } else { null };
        if (tr_t != null && tr_t.kind == TypeKind::Trait) {
            mut tr_type: TraitType* = tr_t.as_trait();
            // Register associated-type members (`type Item;`) so the
            // projection resolver and the positional-sugar desugar
            // can see which member names this trait declares and how
            // many it has.
            for (mut ai: i64 = 0; ai < node.assoc_types.length(); ai++) {
                const adecl: AssocTypeDeclNode* = node.assoc_types[ai];
                if (adecl != null) { tr_type.add_assoc_type(adecl.name); }
            }
            // `MethodInfo.param_types` is by contract the NON-SELF
            // parameters, which is what every reader matches against
            // an argument count. Keeping the receiver here made an
            // instance trait method look like it took one parameter
            // too many, so a call on a bounded or where-bounded
            // receiver found no signature and left its arguments
            // unclassified. Same receiver spellings the struct method
            // table filters on.
            for (mut mi: i64 = 0; mi < node.methods.length(); mi++) {
                const tfunc_decl: DeclarationNode* = node.methods[mi];
                const tfunc: FunctionDecl* = DeclarationNode::fn_of(tfunc_decl);
                if (tfunc == null) { continue; }
                mut param_types: [TypeRef] = [];
                for (mut p: i64 = 0; p < tfunc.parameters.length(); p++) {
                    const param_decl: DeclarationNode* = tfunc.parameters[p];
                    const param: VarDecl* = DeclarationNode::var_of(param_decl);
                    if (param == null) { continue; }
                    if (param.is_receiver()) { continue; }
                    if (param.resolved_type.is_valid()) {
                        param_types.push(param.resolved_type);
                    }
                }
                const fn_ty: TypeRef = arena.get_function(
                    tfunc.resolved_return_type, param_types,
                    tfunc.is_variadic);
                mut info: MethodInfo = MethodInfo::new(
                    tfunc.name, fn_ty, tfunc.is_static);
                info.param_types = param_types;
                tr_type.add_required_method(info);
            }
        }
        return node.methods.length();
    }

    /// Resolves function parameter types and return types for all top-level
    /// and method declarations.  Makes function signatures available for
    /// template registration and later type checking.
    /// Record the target of every non-generic alias the module declares,
    /// before anything resolves an annotation naming one.  Until its target
    /// is recorded an alias resolves to itself, so a parameter or return
    /// type written as an alias would keep the alias type - which is no
    /// function to call and takes no operator - while a local's annotation,
    /// resolved later, is the target.  Returns how many were recorded.
    static alias_targets(runner: TypeResolutionRunner*, root: ProgramNode*, ctx: CompilationContext*,
                         resolver: TypeResolver*) -> i64 {
        mut alias_count: i64 = 0;
        for (mut i: i64 = 0; i < root.statements.length(); i++) {
            const stmt: DeclarationNode* = root.statements[i].as_decl();
            if (stmt == null) { continue; }
            const node: TypeAliasDecl* = DeclarationNode::alias_of(stmt);
            if (node == null) { continue; }
            // A generic alias is resolved when it is instantiated.
            if (node.is_generic()) { continue; }
            if (node.target_annotation == null || node.has_resolved_target()) { continue; }
            const target: TypeRef = resolver.resolve(node.target_annotation, &runner.res_ctx);
            if (!target.is_valid()) {
                runner.emit_undefined_type(node.target_annotation,
                    "target type", ctx.resolve_str(node.alias_name), stmt.span);
                continue;
            }
            node.resolved_target = target;
            const alias_ref: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/alias target");
            if (alias_ref.is_valid()) {
                const alias_ty: Type* = runner.arena.lookup(alias_ref);
                if (alias_ty != null && alias_ty.kind == TypeKind::TypeAlias) {
                    const alias_obj: TypeAliasType* = alias_ty.as_alias();
                    alias_obj.set_target(target);
                }
            }
            alias_count++;
        }
        return alias_count;
    }

    static run_function_signature(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        if (Log::enabled(LogArea::Types, LogLevel::Debug)) {
            Log::debug(LogArea::Types, f"resolving function signatures in module '{ctx.artifacts.ast.namespace_name}'");
        }

        // Get required components
        const arena: TypeArena* = ctx.type_arena;
        const resolver: TypeResolver* = ctx.type_resolver;
        if (arena == null || resolver == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "FunctionSignature: type system not initialized");
            return PassResult::failure(1);
        }

        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            return PassResult::ok();
        }

        mut runner: TypeResolutionRunner = TypeResolutionRunner::new(ctx);
        const alias_count: i64 = TypeResolutionPasses::alias_targets(&runner, root, ctx, resolver);
        if (Log::enabled(LogArea::Types, LogLevel::Debug)) {
            Log::debug(LogArea::Types, f"resolved {alias_count} type aliases");
        }
        mut sig_count: i64 = 0;

        // Track resolved free-function signatures within this module to
        // reject exact redefinitions (E0206). Overloads differ in their
        // FunctionType, so only same-name + same-signature collides.
        mut seen_fn_names: [u32] = [];
        mut seen_fn_types: [u64] = [];

        // Walk top-level statements
        for (mut i: i64 = 0; i < root.statements.length(); i++) {
            const stmt: DeclarationNode* = root.statements[i].as_decl();
            if (stmt == null) { continue; }

            const decl: DeclarationNode* = stmt;
            match (decl.kind) {
                DeclKind::Function(func) => {
                    const func_decl: DeclarationNode* = stmt;
                    mut func_ctx: ResolutionContext = runner.make_generic_context(
                        func.generic_params, &runner.res_ctx);
                    runner.resolve_func_signature(func_decl, &func_ctx);
                    sig_count++;

                    if (func.resolved_return_type.is_valid()) {
                        mut fparams: [TypeRef] = [];
                        for (mut p: i64 = 0; p < func.parameters.length(); p++) {
                            const fp_decl: DeclarationNode* = func.parameters[p];
                            const fp: VarDecl* = DeclarationNode::var_of(fp_decl);
                            if (fp != null && fp.resolved_type.is_valid()) {
                                fparams.push(fp.resolved_type);
                            }
                        }
                        const fsig: TypeRef = arena.get_function(
                            func.resolved_return_type, fparams, func.is_variadic);
                        if (TypeResolutionPasses::signature_repeats(&seen_fn_names, &seen_fn_types,
                                                                    func.name, fsig.key())) {
                            ctx.emit_error_at(ErrorCode::E0206_REDEFINED_FUNCTION,
                                fmt::format("function `%s` is defined multiple times with the same signature",
                                    ctx.resolve_str(func.name)),
                                func_decl.span);
                        }
                    }
                }
                DeclKind::Trait(node) => {
                    sig_count += TypeResolutionPasses::trait_signatures(&runner, node, ctx, arena);
                }
                DeclKind::Impl(node) => {
                    sig_count += TypeResolutionPasses::impl_signatures(&runner, decl, node, ctx);
                }
                DeclKind::Struct(node) => {
                    mut struct_ctx: ResolutionContext = runner.make_generic_context(
                        node.generic_params, &runner.res_ctx);
                    const struct_owner: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/struct methods");
                    const struct_args: [TypeRef] = runner.decl_owner_args(node.generic_params, &struct_ctx);
                    runner.resolve_method_signatures(node.methods, &struct_ctx, struct_owner, node.def, &struct_args);
                    sig_count += node.methods.length();
                }
                DeclKind::Union(node) => {
                    mut union_ctx: ResolutionContext = runner.make_generic_context(
                        node.generic_params, &runner.res_ctx);
                    const union_owner: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/union methods");
                    const union_args: [TypeRef] = runner.decl_owner_args(node.generic_params, &union_ctx);
                    runner.resolve_method_signatures(node.methods, &union_ctx, union_owner, node.def, &union_args);
                    sig_count += node.methods.length();
                }
                DeclKind::Extern(node) => {
                    for (mut j: i64 = 0; j < node.functions.length(); j++) {
                        const fn_node_decl: DeclarationNode* = node.functions[j];
                        const fn_node: FunctionDecl* = DeclarationNode::fn_of(fn_node_decl);
                        runner.resolve_func_signature(fn_node_decl, &runner.res_ctx);

                        if (fn_node.resolved_return_type.is_valid()) {
                            // Collect resolved param types
                            mut ext_params: [TypeRef] = [];
                            for (mut p: i64 = 0; p < fn_node.parameters.length(); p++) {
                                const param_decl: DeclarationNode* = fn_node.parameters[p];
                                const param: VarDecl* = DeclarationNode::var_of(param_decl);
                                if (param != null && param.resolved_type.is_valid()) {
                                    ext_params.push(param.resolved_type);
                                }
                            }

                            // Create FunctionType in the arena
                            const func_type_ref: TypeRef = arena.get_function(
                                fn_node.resolved_return_type, ext_params, fn_node.is_variadic);

                            // The LLVM symbol an extern function resolves to: its
                            // bare C name, UNLESS a function-level `![symbol("sym")]`
                            // pins a different linker symbol (the C++ binding
                            // generator pins the Itanium mangled name).  Read from
                            // the parsed directive (DirectiveProcessing, which sets
                            // `has_link_name`, runs LATER than this pass), and
                            // registered as the DI mangled name so EVERY module - 
                            // declaring and consuming - emits the same symbol,
                            // making the override work across the module boundary.
                            const ext_link_str: string = fn_node_decl.link_directive_symbol();
                            const ext_link_sym: SymbolStr = if (ext_link_str.length() > 0) {
                                ctx.intern_table.intern(ext_link_str)
                            } else {
                                fn_node.name
                            };

                            // The declaration is registered under its own key -
                            // its name under the module that declares it, as
                            // any free function's: the alias's module for a C
                            // import (`<mod>::cit::add3`, the namespace the
                            // alias's stamp names), the writing module for a
                            // plain extern block - and the C name is its
                            // SYMBOL, never a key: a bare leaf shared by every
                            // extern block declaring that C name could only
                            // hold one of them, and a call pinned by the
                            // symbol alone could not say which declaration it
                            // meant.  A call binds the declaration its stamp
                            // names and is emitted at that declaration's
                            // signature.
                            const ext_q_name: SymbolStr = if (node.is_c_import()) {
                                ctx.qualify_binding_sym(fn_node.name, node.binding_namespace)
                            } else {
                                ctx.decl_fn_key(fn_node.name, fn_node_decl.span.file)
                            };
                            const ext_leaf: SymbolStr = fn_node.name;
                            const ext_owner: FamilyOwner = if (node.is_c_import()) {
                                ctx.module_family(node.binding_namespace)
                            } else {
                                ctx.fn_family_of(fn_node.def)
                            };
                            // Two extern blocks declaring one C name with
                            // DIFFERENT Cryo signatures is an ABI hazard the
                            // program carries whichever one a call names - at
                            // most one of them matches the C definition - and
                            // is reported once, at the later declaration.  An
                            // identical redeclaration (two modules each writing
                            // the libc prototype they need) shares the interned
                            // function type and says nothing.
                            const clash_key: SymbolStr =
                                ctx.decl_index.extern_symbol_conflict(ext_link_sym, func_type_ref);
                            if (clash_key.is_valid()) {
                                const sym_str: string = ctx.intern_table.resolve(fn_node.name);
                                mut wdiag: Diagnostic = Diagnostic::warning(
                                    ErrorCode::W0011_DUPLICATE_EXTERN_SYMBOL,
                                    fmt::format("extern C symbol `%s` is declared in more than one extern block with different signatures; a call binds the declaration it names, and at most one of them matches the C definition",
                                        sym_str));
                                wdiag = wdiag.at_with_label(fn_node_decl.span,
                                    "duplicate extern declaration here");
                                wdiag = wdiag.help(fmt::format("also declared as `%s`; make the two signatures agree, or remove one",
                                    ctx.intern_table.resolve(clash_key)));
                                ctx.emit_diagnostic(wdiag);
                            }
                            // The LLVM symbol is written on the overload entry
                            // as well as the key's slot: codegen resolves a
                            // pinned declaration through the entry registered
                            // under it, an extern's as any other function's.
                            fn_node.set_overload_entry(ctx.decl_index.register_function_signature(
                                ext_owner, ext_leaf, fn_node.resolved_return_type, func_type_ref,
                                ctx.intern_table, arena, ext_link_sym,
                                if (fn_node_decl.has_name_span()) { fn_node_decl.name_span } else { fn_node_decl.span },
                                fn_node.def, fn_node_decl));
                            ctx.decl_index.note_extern_symbol(ext_link_sym, ext_q_name, func_type_ref);
                            // Whether this IS a C function the compiler checks
                            // calls to (the C `printf`) is decided by the
                            // identity, claimed where it is registered.
                            ctx.claim_language_item(fn_node.def, fn_node_decl);
                            // An imported function is a declaration of this
                            // module and takes its written visibility, as a
                            // free function does: a `private` one is not
                            // callable by qualified path from another module.
                            // A C import's prototypes are its alias module's
                            // public declarations - the alias exists to be
                            // reached through, and the name layer declares
                            // them so - whatever the block's text wrote.
                            ctx.decl_index.set_decl_visibility(fn_node.def,
                                if (node.is_c_import()) { Visibility::Public } else { fn_node.visibility });
                        }
                    }
                    sig_count += node.functions.length();
                }
                DeclKind::Intrinsic(node) => {
                    // Resolve parameter types
                    for (mut j: i64 = 0; j < node.parameters.length(); j++) {
                        const param_decl: DeclarationNode* = node.parameters[j];
                        const param: VarDecl* = DeclarationNode::var_of(param_decl);
                        if (param != null && param.type_annotation != null &&
                            !param.resolved_type.is_valid()) {
                            const ptype: TypeRef = resolver.resolve(param.type_annotation, &runner.res_ctx);
                            if (ptype.is_valid()) {
                                param.resolved_type = ptype;
                            }
                        }
                    }
                    // Resolve return type and register in DeclarationIndex
                    if (node.return_type_annotation != null && !node.resolved_return_type.is_valid()) {
                        const rtype: TypeRef = resolver.resolve(node.return_type_annotation, &runner.res_ctx);
                        if (rtype.is_valid()) {
                            node.resolved_return_type = rtype;
                        }
                    }

                    if (node.resolved_return_type.is_valid()) {
                        // Build FunctionType for full signature.
                        mut i_param_types: [TypeRef] = [];
                        for (mut pi: i64 = 0; pi < node.parameters.length(); pi++) {
                            const ip_decl: DeclarationNode* = node.parameters[pi];
                            const ip: VarDecl* = DeclarationNode::var_of(ip_decl);
                            if (ip.resolved_type.is_valid()) {
                                i_param_types.push(ip.resolved_type);
                            }
                        }
                        const i_func_type_ref: TypeRef = arena.get_function(
                            node.resolved_return_type, i_param_types, node.is_variadic);

                        // Register in its module's family so cross-module
                        // externs pick up intrinsics.
                        // Intrinsics use C linkage; their LLVM symbol is the
                        // bare function name, not the qualified/mangled form.
                        const i_entry: OverloadId = ctx.decl_index.register_function_signature(
                            ctx.fn_family_of(node.def), node.name, node.resolved_return_type, i_func_type_ref, ctx.intern_table, arena,
                            node.name, decl.span, node.def, decl);

                        // The ENTRY carries the intrinsic's kind, read from
                        // the declaration's own name here, the one place a
                        // spelling decides it: codegen's inline decision reads
                        // the kind off the pin.  Its leaf is a key nowhere: a
                        // bare `malloc` with no declaration in scope is an
                        // error, and the intrinsic is reached as
                        // `intrinsics::malloc` like every declaration.
                        ctx.decl_index.mark_intrinsic(i_entry,
                            IntrinsicKind::from_name(ctx.intern_table.resolve(node.name)));
                        // Intrinsics are always public (an intrinsic
                        // carries no visibility); record it explicitly so
                        // the verdict is stated rather than inherited from
                        // `is_candidate_public`'s permissive default.
                        ctx.decl_index.set_decl_visibility(node.def, Visibility::Public);
                    }
                    sig_count++;
                }
                DeclKind::Import(_) | DeclKind::Module(_) | DeclKind::Variant(_)
                | DeclKind::Destructure(_) | DeclKind::TypeAlias(_) | DeclKind::Field(_)
                | DeclKind::GenericParam(_) | DeclKind::Enum(_) | DeclKind::Variable(_)
                | DeclKind::Method(_) => {}
            }
        }

        if (Log::enabled(LogArea::Types, LogLevel::Debug)) {
            Log::debug(LogArea::Types, f"resolved {sig_count} function signatures");
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }


    // Pass 2: TypeResolution (order 9)

    /// Resolves ALL remaining type annotations in the AST.
    /// Phase 1, the alias targets, runs at the start of the signature pass
    /// (`alias_targets`).
    /// Phase 2: Struct field types
    /// Phase 3: Variable and expression types in function bodies
    /// Phase 4: Register declarations in the DeclarationIndex
    static run_type_resolution(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        const arena: TypeArena* = ctx.type_arena;
        const resolver: TypeResolver* = ctx.type_resolver;
        if (arena == null || resolver == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "TypeResolution: type system not initialized");
            return PassResult::failure(1);
        }

        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            return PassResult::ok();
        }

        mut runner: TypeResolutionRunner = TypeResolutionRunner::new(ctx);

        // -- Phase 2: Declaration field types --------------------------------
        mut field_count: i64 = 0;
        for (mut i: i64 = 0; i < root.statements.length(); i++) {
            const stmt: DeclarationNode* = root.statements[i].as_decl();
            if (stmt == null) { continue; }

            match (stmt.kind) {
                DeclKind::Impl(node) => {
                    mut impl_ctx: ResolutionContext = runner.make_generic_context(
                        node.generic_params, &runner.res_ctx);
                    // Mirror the FunctionSignature pass's trait-arg
                    // binding so the second-pass resolution of method
                    // signatures sees the same scope.  (This pass picks
                    // up any param annotations missed by the first
                    // pass; without the trait-arg bindings here, we'd
                    // re-introduce the same `Item` lookup miss this
                    // resolution is meant to repair.)
                    runner.bind_trait_args_for_impl(node, &impl_ctx);
                    // An impl head names one trait outright, and nothing
                    // else reports a head whose trait resolves to
                    // nothing: every consumer reads `trait_identity` and
                    // returns quietly when it answers empty.  A
                    // misspelled trait therefore reached a later stage as
                    // a missing `Res` - an internal error naming no
                    // source location - instead of as a name its author
                    // can fix.  The head's own name is asked here, where
                    // the type index is populated and the same
                    // unresolved-name diagnostic every other annotation
                    // gets is already built.
                    if (node.is_trait_impl()) {
                        const trait_base: TypeAnnotation* =
                            TypeAnnotation::head_base(node.trait_annotation);
                        if (trait_base != null
                                && !resolver.resolve(trait_base,
                                                     &impl_ctx).is_valid()) {
                            runner.emit_undefined_type(trait_base,
                                "trait", ctx.resolve_str(node.target_type), stmt.span);
                        }
                    }
                    // The owner and its name off the stamp, as in the
                    // FuncSig phase above.
                    const impl_args: [TypeRef] = runner.impl_owner_args(node, &impl_ctx);
                    runner.resolve_method_signatures(node.methods, &impl_ctx,
                        ctx.decl_index.impl_owner(node, "type_resolution/impl methods"), node.target_def(), &impl_args);
                    runner.emit_method_signature_diagnostics(node.methods);
                    runner.check_impl_conformance(stmt, node, &impl_ctx);
                }
                DeclKind::Struct(node) => {
                    mut struct_ctx: ResolutionContext = runner.make_generic_context(
                        node.generic_params, &runner.res_ctx);
                    runner.resolve_fields(node.fields, &struct_ctx);
                    field_count += node.fields.length();
                    // Re-resolve the inline methods' signatures now that
                    // the owner type exists in the arena.  The
                    // DeclarationCollection FunctionSignature pass ran
                    // before this type was registered, so its owner lookup
                    // was invalid and a by-value `this` receiver (which
                    // carries no annotation) was left without a
                    // resolved_type.  Impl-block methods are repaired by
                    // the implement-block arm; inline methods need
                    // the same repair here, or a consuming method
                    // (`fn m(mut this)`) reaches drop-insertion with an
                    // unresolved receiver and its by-value `this` is never
                    // dropped - a leak on every call.
                    runner.resolve_inline_method_signatures(node.def, node.methods, &node.generic_params, &struct_ctx);
                    runner.emit_method_signature_diagnostics(node.methods);
                }
                DeclKind::Union(node) => {
                    mut union_ctx: ResolutionContext = runner.make_generic_context(
                        node.generic_params, &runner.res_ctx);
                    runner.resolve_fields(node.fields, &union_ctx);
                    field_count += node.fields.length();
                    runner.resolve_inline_method_signatures(node.def, node.methods, &node.generic_params, &union_ctx);
                    runner.emit_method_signature_diagnostics(node.methods);
                }
                // Enum variant associated types (now TypeAnnotation*) are
                // resolved during monomorphization for generic enums;
                // non-generic enums' by sema when it checks match arms.
                DeclKind::Destructure(_) | DeclKind::Enum(_) | DeclKind::Extern(_)
                | DeclKind::Field(_) | DeclKind::GenericParam(_) | DeclKind::Import(_)
                | DeclKind::Intrinsic(_) | DeclKind::Module(_) | DeclKind::Trait(_)
                | DeclKind::TypeAlias(_) | DeclKind::Variable(_) | DeclKind::Variant(_)
                | DeclKind::Function(_) | DeclKind::Method(_) => {}
            }
        }

        if (Log::enabled(LogArea::Types, LogLevel::Debug)) {
            Log::debug(LogArea::Types, f"resolved {field_count} field types");
        }

        // -- Phase 3: Variable and expression types in function bodies -------
        mut body_count: i64 = 0;
        for (mut i: i64 = 0; i < root.statements.length(); i++) {
            const stmt: DeclarationNode* = root.statements[i].as_decl();
            if (stmt == null) { continue; }

            match (stmt.kind) {
                DeclKind::Function(func) => {
                    if (func.body != null && !func.is_generic()) {
                        runner.resolve_var_types_in_stmt(func.body, &runner.res_ctx);
                        body_count++;
                    }
                }
                DeclKind::Struct(node) => {
                    if (!node.is_generic()) {
                        for (mut j: i64 = 0; j < node.methods.length(); j++) {
                            const method_decl: DeclarationNode* = node.methods[j];
                            const method: MethodDecl* = DeclarationNode::method_of(method_decl);
                            if (method != null && method.func != null && DeclarationNode::fn_of(method.func).body != null) {
                                // Method-level generics (`Layout::array<T>(n)`)
                                // must be in scope when the walker reaches a
                                // `mut x: T = ...` body annotation; without
                                // the binding, the resolver returns invalid
                                // and `emit_undefined_type` fires E0203 on a
                                // perfectly legal generic param.
                                mut m_ctx: ResolutionContext = runner.make_generic_context(
                                    DeclarationNode::fn_of(method.func).generic_params, &runner.res_ctx);
                                runner.resolve_var_types_in_stmt(
                                    DeclarationNode::fn_of(method.func).body, &m_ctx);
                                body_count++;
                            }
                        }
                    }
                }
                DeclKind::Union(node) => {
                    if (!node.is_generic()) {
                        for (mut j: i64 = 0; j < node.methods.length(); j++) {
                            const method_decl: DeclarationNode* = node.methods[j];
                            const method: MethodDecl* = DeclarationNode::method_of(method_decl);
                            if (method != null && method.func != null && DeclarationNode::fn_of(method.func).body != null) {
                                mut m_ctx: ResolutionContext = runner.make_generic_context(
                                    DeclarationNode::fn_of(method.func).generic_params, &runner.res_ctx);
                                runner.resolve_var_types_in_stmt(
                                    DeclarationNode::fn_of(method.func).body, &m_ctx);
                                body_count++;
                            }
                        }
                    }
                }
                DeclKind::Trait(node) => {
                    if (!node.is_generic()) {
                        for (mut j: i64 = 0; j < node.methods.length(); j++) {
                            const func_decl: DeclarationNode* = node.methods[j];
                            const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
                            if (func != null && func.body != null) {
                                mut m_ctx: ResolutionContext = runner.make_generic_context(
                                    func.generic_params, &runner.res_ctx);
                                runner.resolve_var_types_in_stmt(
                                    func.body, &m_ctx);
                                body_count++;
                            }
                        }
                    }
                }
                DeclKind::Impl(node) => {
                    if (!node.is_generic()) {
                        // Build the per-impl context that mirrors what
                        // FunctionSignature uses: the impl's own
                        // `<T, ...>` plus the trait's outer params bound
                        // to the impl's trait args (so the trait's
                        // `Item` resolves to the impl's concrete `T`).
                        // `synthesize_default_trait_methods` may have
                        // cloned default methods (e.g. `fold<Acc>` from
                        // `Iterator<Item>`); their bodies reference both
                        // the trait's `Item` and the method's own `Acc`,
                        // so all three layers must be pushed before the
                        // body walk to avoid spurious E0203.
                        mut impl_ctx: ResolutionContext = runner.make_generic_context(
                            node.generic_params, &runner.res_ctx);
                        runner.bind_trait_args_for_impl(node, &impl_ctx);
                        for (mut j: i64 = 0; j < node.methods.length(); j++) {
                            const method_decl: DeclarationNode* = node.methods[j];
                            const method: MethodDecl* = DeclarationNode::method_of(method_decl);
                            if (method != null && method.func != null && DeclarationNode::fn_of(method.func).body != null) {
                                mut m_ctx: ResolutionContext = runner.make_generic_context(
                                    DeclarationNode::fn_of(method.func).generic_params, &impl_ctx);
                                runner.resolve_var_types_in_stmt(
                                    DeclarationNode::fn_of(method.func).body, &m_ctx);
                                body_count++;
                            }
                        }
                    }
                }
                DeclKind::Destructure(_) | DeclKind::Enum(_) | DeclKind::Extern(_)
                | DeclKind::Field(_) | DeclKind::GenericParam(_) | DeclKind::Import(_)
                | DeclKind::Intrinsic(_) | DeclKind::Module(_) | DeclKind::TypeAlias(_)
                | DeclKind::Variable(_) | DeclKind::Variant(_) | DeclKind::Method(_) => {}
            }
        }

        if (Log::enabled(LogArea::Types, LogLevel::Debug)) {
            Log::debug(LogArea::Types, f"walked {body_count} function bodies");
        }

        // -- Phase 3b: Collect generic function call instantiations ----------
        // Scan non-generic function bodies for calls like identity<int>(100).
        // For each, resolve the generic args and register an InstantiatedType
        // so the Monomorphizer can discover and specialize the function.
        for (mut i: i64 = 0; i < root.statements.length(); i++) {
            const stmt: DeclarationNode* = root.statements[i].as_decl();
            if (stmt == null) { continue; }

            match (stmt.kind) {
                DeclKind::Function(func) => {
                    if (func.body != null && !func.is_generic()) {
                        runner.collect_generic_fn_calls_in_stmt(func.body, &runner.res_ctx);
                    }
                }
                DeclKind::Impl(node) => {
                    if (!node.is_generic()) {
                        for (mut j: i64 = 0; j < node.methods.length(); j++) {
                            const method_decl: DeclarationNode* = node.methods[j];
                            const method: MethodDecl* = DeclarationNode::method_of(method_decl);
                            if (method != null && method.func != null && DeclarationNode::fn_of(method.func).body != null) {
                                runner.collect_generic_fn_calls_in_stmt(DeclarationNode::fn_of(method.func).body, &runner.res_ctx);
                            }
                        }
                    }
                }
                DeclKind::Struct(node) => {
                    if (!node.is_generic()) {
                        for (mut j: i64 = 0; j < node.methods.length(); j++) {
                            const method_decl: DeclarationNode* = node.methods[j];
                            const method: MethodDecl* = DeclarationNode::method_of(method_decl);
                            if (method != null && method.func != null && DeclarationNode::fn_of(method.func).body != null) {
                                runner.collect_generic_fn_calls_in_stmt(DeclarationNode::fn_of(method.func).body, &runner.res_ctx);
                            }
                        }
                    }
                }
                DeclKind::Union(node) => {
                    if (!node.is_generic()) {
                        for (mut j: i64 = 0; j < node.methods.length(); j++) {
                            const method_decl: DeclarationNode* = node.methods[j];
                            const method: MethodDecl* = DeclarationNode::method_of(method_decl);
                            if (method != null && method.func != null && DeclarationNode::fn_of(method.func).body != null) {
                                runner.collect_generic_fn_calls_in_stmt(DeclarationNode::fn_of(method.func).body, &runner.res_ctx);
                            }
                        }
                    }
                }
                DeclKind::Destructure(_) | DeclKind::Enum(_) | DeclKind::Extern(_)
                | DeclKind::Field(_) | DeclKind::GenericParam(_) | DeclKind::Import(_)
                | DeclKind::Intrinsic(_) | DeclKind::Module(_) | DeclKind::Trait(_)
                | DeclKind::TypeAlias(_) | DeclKind::Variable(_) | DeclKind::Variant(_) | DeclKind::Method(_) => {}
            }
        }

        // -- Phase 4: Register declarations in the DeclarationIndex, and
        //    resolve and register top-level global variables
        for (mut i: i64 = 0; i < root.statements.length(); i++) {
            const stmt: DeclarationNode* = root.statements[i].as_decl();
            if (stmt == null) { continue; }

            // Register in DeclarationIndex (shared logic with Specialization).
            TypeResolutionPasses::register_decl_in_index(stmt, ctx, true);
            TypeResolutionPasses::refuse_private_in_signatures(stmt, ctx);

            // Phase 4-specific: resolve and register top-level global variables
            const var_node: VarDecl* = DeclarationNode::var_of(stmt);
            if (var_node != null) {
                // A module-level initializer is folded to the constant that
                // is emitted, so a `sizeof` in it needs its operand resolved
                // for the same reason a `static_assert` does. Without it the
                // fold declines, and declining publishes 0 as the value.
                TypeResolutionPasses::resolve_const_operand_types(
                    var_node.initializer, resolver, &runner.res_ctx);
                if (var_node.type_annotation != null && !var_node.resolved_type.is_valid()) {
                    const vtype: TypeRef = resolver.resolve(var_node.type_annotation, &runner.res_ctx);
                    if (vtype.is_valid()) {
                        var_node.resolved_type = vtype;
                    }
                }
                if (var_node.resolved_type.is_valid()) {
                    TypeResolutionRunner::register_module_global(
                        ctx, stmt, var_node);
                }
            }
        }

        // Resolve the `sizeof`/`alignof` operand types inside module-scope
        // `static_assert(...)` conditions. These live in a side list (not the
        // statement stream), so the normal expression resolver never visits
        // them; resolve them here while the module's resolution context is set
        // up. TypeLowering later folds the condition once layouts are known.
        for (mut si: i64 = 0; si < root.static_asserts.length(); si++) {
            const sa: StaticAssertItem* = root.static_asserts[si];
            if (sa == null) { continue; }
            TypeResolutionPasses::resolve_const_operand_types(
                sa.cond, resolver, &runner.res_ctx);
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }

    /// Recursively resolve the `sizeof`/`alignof` operand type annotations in a
    /// compile-time constant expression, so the folder can read their sizes.
    /// Only the node kinds a constant expression can contain are walked;
    /// everything else is left untouched (the folder rejects anything
    /// non-constant).
    ///
    /// Both positions that hold such an expression need this and neither is
    /// reached by the ordinary expression resolver: a `static_assert` condition
    /// lives in a side list, and a module-level initializer is walked by sema,
    /// which types the `sizeof` EXPRESSION rather than its operand.
    ///
    /// A named constant and an enum variant need nothing resolved here: the
    /// folder reads both from the constant table by name.
    static resolve_const_operand_types(expr: ExpressionNode*, resolver: TypeResolver*,
                                       res_ctx: ResolutionContext*) -> void {
        if (expr == null) { return; }
        const node: ExpressionNode* = expr;
        const c: CastExpr* = ExpressionNode::cast_of(node);
        if (c != null) {
            TypeResolutionPasses::resolve_const_operand_types(c.expression, resolver, res_ctx);
            return;
        }
        const s: SizeofExpr* = ExpressionNode::sizeof_of(node);
        if (s != null) {
            if (s.type_ann != null) {
                s.set_operand_type(resolver.resolve(s.type_ann, res_ctx));
            }
            return;
        }
        const a: AlignofExpr* = ExpressionNode::alignof_of(node);
        if (a != null) {
            if (a.type_ann != null) {
                a.set_operand_type(resolver.resolve(a.type_ann, res_ctx));
            }
            return;
        }
        const u: UnaryExpr* = ExpressionNode::unary_of(node);
        if (u != null) {
            TypeResolutionPasses::resolve_const_operand_types(u.operand, resolver, res_ctx);
            return;
        }
        const b: BinaryExpr* = ExpressionNode::binary_of(node);
        if (b != null) {
            TypeResolutionPasses::resolve_const_operand_types(b.left, resolver, res_ctx);
            TypeResolutionPasses::resolve_const_operand_types(b.right, resolver, res_ctx);
            return;
        }
    }


    // Pass 3: StructFieldTypeSync (order 10)

    /// Syncs resolved field types from the AST's field declarations back to
    /// StructType [FieldInfo] arrays in the TypeArena.
    static run_struct_field_sync(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        const arena: TypeArena* = ctx.type_arena;
        if (arena == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "StructFieldTypeSync: type system not initialized");
            return PassResult::failure(1);
        }

        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            return PassResult::ok();
        }

        mut struct_count: i64 = 0;

        for (mut i: i64 = 0; i < root.statements.length(); i++) {
            const stmt: DeclarationNode* = root.statements[i].as_decl();
            if (stmt == null) { continue; }

            match (stmt.kind) {
                DeclKind::Struct(sn) => {
                    if (TypeResolutionPasses::sync_struct_members(sn, ctx, arena)) { struct_count++; }
                    continue;
                }
                DeclKind::Union(un) => {
                    if (TypeResolutionPasses::sync_union_members(un, ctx, arena)) { struct_count++; }
                    continue;
                }
                DeclKind::Impl(ib) => {
                    TypeResolutionPasses::sync_impl_methods(ib, ctx, arena);
                    continue;
                }
                DeclKind::Enum(_) => { }
                // No other kind with a payload has members to sync.
                DeclKind::Destructure(_) | DeclKind::Extern(_) | DeclKind::Field(_)
                | DeclKind::GenericParam(_) | DeclKind::Import(_) | DeclKind::Intrinsic(_)
                | DeclKind::Module(_) | DeclKind::Trait(_) | DeclKind::TypeAlias(_)
                | DeclKind::Variable(_) | DeclKind::Variant(_) | DeclKind::Function(_)
                | DeclKind::Method(_) => { continue; }
            }
            const node: EnumDecl* = DeclarationNode::enum_of(stmt);

            const type_ref: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/enum field sync");
            if (!type_ref.is_valid()) { continue; }

            const base_type: Type* = arena.lookup(type_ref);
            if (base_type == null || base_type.kind != TypeKind::Enum) { continue; }

            mut et: EnumType* = base_type.as_enum();
            // Only populate if not already populated (avoid double-populating)
            if (et.variants.length() > 0) { continue; }

            // Build a resolution context.  For generic enums, bind each
            // generic parameter to its GenericParam TypeRef so that
            // variant payload annotations referencing `T` resolve to the
            // enum's own GenericParam_T.  Without this, generic enums had
            // empty variant info; the monomorphizer's substitution
            // path falls back to AST re-resolution on partially-
            // specialized clones (e.g., Option<T*> where the outer T is
            // still generic), which can't find `T` in a binding-free
            // context.  Populating the base lets specialization apply
            // substitution to a known-good source.
            mut res_ctx: ResolutionContext = ResolutionContext::new(ctx.source_file);
            // The variant payload annotations mean what the module that
            // WROTE this enum says.  That is the cursor for
            // a declaration this module actually owns - this walk is in
            // order - but not for one INJECTED into this root by
            // specialization, which carries its template's span.  The
            // span is right in both cases; `module_name` above is the
            // cursor spelled out, and is kept only as the current-module
            // string the resolver uses for `[T; NAME]` array sizes.
            // Use the canonical helper so the parameter types match
            // what template-registration created for the same enum.
            const refs: [TypeRef] = TypeResolutionPasses::create_generic_param_types(
                node.generic_params, arena);
            for (mut gpi: i64 = 0; gpi < node.generic_params.length(); gpi++) {
                const gp_decl: DeclarationNode* = node.generic_params[gpi];
                const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
                if (gp == null) { continue; }
                res_ctx.add_binding(gp.sym_id, gp.name, refs[gpi]);
            }

            // Discriminants come from the declaration itself, which
            // is also what a compile-time fold of `Enum::Variant`
            // reads; computing them here as well would let the tag
            // an expression sees drift from the tag the type carries.
            const tags: [i64] = node.variant_tags();
            for (mut j: i64 = 0; j < node.variants.length(); j++) {
                const variant_decl: DeclarationNode* = node.variants[j];
                const variant: EnumVariant* = DeclarationNode::variant_of(variant_decl);
                if (variant == null) { continue; }

                mut payload_types: [TypeRef] = [];
                for (mut k: i64 = 0; k < variant.associated_types.length(); k++) {
                    const ann: TypeAnnotation* = variant.associated_types[k];
                    mut resolved: TypeRef = TypeRef::invalid();
                    if (ann != null) {
                        resolved = ctx.type_resolver.resolve(ann, &res_ctx);
                    }
                    // Never bake an unresolved payload into the enum: the
                    // variant would be sized from the id-0 sentinel (wrong
                    // layout / discriminant) or ICE the mangler, decoupled
                    // from any diagnostic. Emit E0203 so the pass fails and
                    // Phase 5 aborts before codegen.
                    if (!resolved.is_valid()) {
                        const vname: string = ctx.intern_table.resolve(variant.name);
                        const ename: string = ctx.intern_table.resolve(node.name);
                        ctx.emit_error_at(ErrorCode::E0203_UNDEFINED_TYPE,
                            fmt::format("cannot resolve payload type for variant `%s` of enum `%s`", vname, ename),
                            variant_decl.span);
                        continue;
                    }
                    payload_types.push(resolved);
                }

                et.add_variant(EnumVariantInfo::new(
                    variant.name, payload_types, tags[j] as u64));
            }

            // Resolve the explicit discriminant base (`type enum Foo
            // : i64`), if any, so codegen lowers the tag at the
            // declared C-ABI width instead of the default i32 - fixing
            // both FFI width round-trips and large-discriminant
            // truncation (`Hi = 4294967296` -> 0 under an i32 tag).
            if (node.discriminant_annotation != null) {
                const disc: TypeRef = ctx.type_resolver.resolve(
                    node.discriminant_annotation, &res_ctx);
                if (disc.is_valid()) {
                    et.set_discriminant_type(disc);
                }
            }

            // See `sync_struct_members` - layout attrs are propagated
            // in DirectiveProcessing.
        }

        if (Log::enabled(LogArea::Types, LogLevel::Debug)) {
            Log::debug(LogArea::Types, f"synced field types of {struct_count} structs");
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }
}
