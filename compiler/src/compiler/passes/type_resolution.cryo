// TypeResolutionRunner: holds shared resolution state for pass methods

/// Bundles the shared state needed by all type resolution helpers.
/// Constructed once per pass invocation, then methods are called on it
/// instead of threading (resolver, res_ctx, ctx) through every call.
type struct TypeResolutionRunner {
    arena:           TypeArena*;
    resolver:        TypeResolver*;
    ctx:             CompilationContext*;
    res_ctx:         ResolutionContext;

    static new(ctx: CompilationContext*) -> TypeResolutionRunner {
        const module_name: string = ctx.has_namespace()
            ? ctx.namespace_display()
            : ctx.source_file;

        mut runner: TypeResolutionRunner;
        runner.arena           = ctx.type_arena;
        runner.resolver        = ctx.type_resolver;
        runner.ctx             = ctx;
        runner.res_ctx         = ResolutionContext::new(ctx.source_file);
        return runner;
    }

    // Generic context helpers

    /// For each GenericParamNode, creates a GenericParamType in the arena and
    /// adds a binding (e.g., T -> GenericParamType(T, 0)) to the resolution context.
    bind_generic_params(&this, generic_params: &GenericParamNode*[],
                        res_ctx: ResolutionContext*) -> void {
        const refs: TypeRef[] = TypeResolutionPasses::create_generic_param_types(
            generic_params, this.arena);
        for (mut i: i64 = 0; i < generic_params.length; i++) {
            const gp: GenericParamNode* = generic_params[i];
            res_ctx.add_binding(gp.name, refs[i]);
        }
    }

    /// If `generic_params` is non-empty, creates a copy of `base_ctx` with
    /// generic param types bound.  Otherwise returns `base_ctx` as-is.
    make_generic_context(&this, generic_params: &GenericParamNode*[],
                         base_ctx: ResolutionContext*) -> ResolutionContext {
        mut result: ResolutionContext = base_ctx.clone();
        if (generic_params.length > 0) {
            this.bind_generic_params(generic_params, &result);
        }
        return result;
    }

    /// For a trait impl block (`impl Foo<X> for Bar<Y>`), bind the trait's
    /// outer generic params to the impl's trait args inside `res_ctx` so
    /// that cloned default-method bodies can resolve names like the
    /// trait's `Item` parameter.  Without this, `synthesize_default_trait_methods`
    /// clones a method like `Iterator<Item>::fold<Acc>(... f: (Acc, Item) -> Acc ...)`
    /// into the impl, then `resolve_method_signatures` runs with only the
    /// impl's own generics in scope; `Item` lookup misses, the function-type
    /// resolution returns a TypeRef whose internal param list contains an
    /// invalid `Item` slot, and the wrong mangled symbol is computed (or a
    /// hard panic in `encode_type_ref` fires once the silent "v" fallback
    /// is removed).  Resolves the trait_decl by leaf name; no-op if the
    /// trait isn't generic, the annotation isn't a `Generic(...)`, or the
    /// arg count doesn't match the trait's param count.
    bind_trait_args_for_impl(&this, impl_node: ImplBlockNode*,
                              res_ctx: ResolutionContext*) -> void {
        if (impl_node == null || !impl_node.is_trait_impl()) { return; }
        if (this.ctx.generic_registry == null) { return; }

        // The trait annotation must be a Generic(base, args) for there to
        // be any args to bind.  Non-generic traits (e.g. `impl Drop for Foo`)
        // have no outer params and need no binding work.
        const trait_ann: TypeAnnotation* = impl_node.trait_annotation;
        if (trait_ann == null) { return; }
        // Read the trait args in place through the node (peel_to_generic
        // returns the owning node, not a droppable copy of its args).
        const gen: GenericAnnotation* = TypeResolutionPasses::peel_to_generic(trait_ann);
        if (gen == null || gen.args.length == 0) { return; }
        const trait_id: SymbolStr = TypeAnnotation::trait_identity(trait_ann);
        if (!trait_id.is_valid()) { return; }
        const trait_decl: TraitDeclNode* = this.ctx.generic_registry.get_trait_decl(trait_id);
        if (trait_decl == null) { return; }

        const ngp: i64   = trait_decl.generic_params.length;
        const nargs: i64 = gen.args.length;

        // Legacy generic-param trait (e.g. the pre-migration `Iterator<Item>`):
        // exact-arity positional binding, mapping trait param[i] -> impl arg[i]
        // (`Iterator<T>` binds `Item -> T`). Arity mismatch is a user error
        // caught elsewhere; bail silently (preserves prior behavior exactly).
        if (ngp > 0) {
            if (ngp != nargs) { return; }
            for (mut i: i64 = 0; i < nargs; i++) {
                const gp: GenericParamNode* = trait_decl.generic_params[i];
                if (gp == null) { continue; }
                const arg_ty: TypeRef = this.resolver.resolve(gen.args[i], res_ctx);
                if (!arg_ty.is_valid()) { continue; }
                res_ctx.add_binding(gp.name, arg_ty);
            }
            return;
        }

        // Associated-type positional sugar (plan rule #6): a trait with 0
        // generic params and exactly 1 associated type binds that associated
        // type from a single positional arg - `implement Iterator<T>` =>
        // `Item -> T`. Binds `Item` in the impl context so `This::Item` (and
        // cloned trait default methods) resolve, and records the binding on
        // the impl node so a concrete `X::Item` projection can look it up.
        if (trait_decl.assoc_types.length == 1 && nargs == 1) {
            const adecl: AssocTypeDeclNode* = trait_decl.assoc_types[0];
            if (adecl != null) {
                const arg_ty: TypeRef = this.resolver.resolve(gen.args[0], res_ctx);
                if (arg_ty.is_valid()) {
                    res_ctx.add_binding(adecl.name, arg_ty);
                }
                if (impl_node.lookup_assoc_binding(adecl.name) == null) {
                    impl_node.add_assoc_binding(adecl.name, gen.args[0]);
                }
            }
        }
    }

    /// Stage-5 associated-type diagnostics, run once per source-level trait
    /// impl during the function-signature phase (after
    /// `bind_trait_args_for_impl` has recorded any positional-sugar binding).
    /// Emits two user-facing errors that the silent-bail binding path above
    /// would otherwise leave undiagnosed:
    ///
    ///   * **E0310** - the trait has generic *params* and the impl tried to
    ///     bind an associated type *positionally* (more `<...>` args than the
    ///     trait has generic params).  Decision #6: positional args fill the
    ///     generic params only; an associated type of such a trait must be
    ///     bound by name (`Out = ...`).
    ///   * **E0309** - the trait declares associated types but this impl binds
    ///     none of them (no positional-sugar arg and no `type Item = ...;`
    ///     body form), so a `This::Item` projection would never reduce.
    ///
    /// A trait with no associated types is untouched (returns immediately), so
    /// every legacy / non-assoc impl is unaffected.
    validate_impl_assoc_bindings(&this, impl_node: ImplBlockNode*) -> void {
        if (impl_node == null || !impl_node.is_trait_impl()) { return; }
        if (this.ctx.generic_registry == null) { return; }
        const trait_ann: TypeAnnotation* = impl_node.trait_annotation;
        if (trait_ann == null) { return; }
        const trait_id: SymbolStr = TypeAnnotation::trait_identity(trait_ann);
        if (!trait_id.is_valid()) { return; }
        const trait_decl: TraitDeclNode* = this.ctx.generic_registry.get_trait_decl(trait_id);
        if (trait_decl == null) { return; }
        // Only traits with associated types are subject to these checks.
        if (trait_decl.assoc_types.length == 0) { return; }

        const intern: InternTable* = this.ctx.get_intern_table();
        // The diagnostic names the trait the way the author spelled it; the
        // identity above is for the lookup, not for the message.
        const trait_name: string = intern.resolve(
            TypeResolutionPasses::extract_trait_leaf(trait_ann));
        const span: SourceSpan = if (impl_node.target_type_span.has_location()) {
            impl_node.target_type_span
        } else {
            impl_node.span
        };

        const ngp: i64 = trait_decl.generic_params.length;
        const gen: GenericAnnotation* = TypeResolutionPasses::peel_to_generic(trait_ann);
        const nargs: i64 = if (gen == null) { 0 } else { gen.args.length };

        // E0310: positional associated-type binding while the trait also has
        // generic params.  The extra positional args (beyond `ngp`) can only be
        // an attempt to bind an associated type positionally, which is rejected.
        if (ngp > 0 && nargs > ngp) {
            const adecl0: AssocTypeDeclNode* = trait_decl.assoc_types[0];
            const aname: string = if (adecl0 == null) {
                "the associated type"
            } else {
                intern.resolve(adecl0.name)
            };
            this.ctx.emit_error_at(
                ErrorCode::E0310_POSITIONAL_ASSOC_WITH_GENERICS,
                fmt::format(
                    "trait `%s` has generic parameters; its positional args bind only the generic params, so bind associated type `%s` in the impl body (`type %s = ...;`)",
                    trait_name, aname, aname),
                span);
            return;
        }

        // E0309: a declared associated type left unbound by this impl.  After
        // `bind_trait_args_for_impl`, every bound assoc type (positional sugar
        // or `type Item = ...;` body form) is recorded on the impl node; an
        // unrecorded one is genuinely unbound.
        for (mut i: i64 = 0; i < trait_decl.assoc_types.length; i++) {
            const adecl: AssocTypeDeclNode* = trait_decl.assoc_types[i];
            if (adecl == null) { continue; }
            if (impl_node.lookup_assoc_binding(adecl.name) != null) { continue; }
            // The implicit `<Method>Fut` of an `async` trait method is bound by
            // the impl's own `async` method, not written by the user — and that
            // binding is added by the sema-time lowering, which has not run yet.
            // Requiring it here would make every async trait impl an error.
            if (TypeResolutionPasses::impl_binds_assoc_via_async(
                    impl_node, trait_decl, adecl.name, this.ctx)) { continue; }
            const aname: string = intern.resolve(adecl.name);
            this.ctx.emit_error_at(
                ErrorCode::E0309_ASSOC_TYPE_NOT_BOUND,
                fmt::format(
                    "associated type `%s` not bound in this impl of trait `%s`",
                    aname, trait_name),
                span);
        }
    }


    /// Record, on the registration `(key, ns)`, the linker symbol an IMPORTED
    /// global binds - its `![symbol("...")]` override when it has one, else
    /// its declared name.  A no-op for a global Cryo defines, which is mangled
    /// under its namespace.  The directive pass runs after this and re-records
    /// the override on the same slot.
    static record_extern_symbol(ctx: CompilationContext*, node: VarDeclNode*,
                                key: SymbolStr, ns: SymbolStr) -> void {
        if (!node.is_extern_import) { return; }
        const sym: SymbolStr = if (node.link_name.length() > 0) {
            ctx.intern(node.link_name)
        } else {
            node.name
        };
        ctx.decl_index.record_global_extern_symbol(key, ns, sym);
    }

    /// Report an annotation the type layer could not resolve, at a
    /// declaration site (`kind_label` and `decl_name` name it in the
    /// headline).  A name in it the name layer refused was reported where it
    /// was written and the annotation's failure is that refusal's
    /// consequence, so it is not reported again; what remains is an
    /// annotation whose every written name is placed and that still names
    /// no type, reported at the declaration's span.
    emit_undefined_type(&this, ann: TypeAnnotation*,
                        kind_label: string, decl_name: string,
                        fallback_span: SourceSpan) -> void {
        if (TypeAnnotation::refused(ann)) { return; }
        this.ctx.emit_error_at(ErrorCode::E0203_UNDEFINED_TYPE,
            fmt::format("cannot resolve %s for `%s`", kind_label, decl_name),
            fallback_span);
    }


    // Signature and field resolution helpers

    /// Resolves the return type annotation and all parameter type annotations
    /// on a FunctionDeclNode.  Delegates core resolution to TypeResolver, then
    /// emits diagnostics and writes back to the Resolver's symbol table.
    resolve_func_signature(&this, func: FunctionDeclNode*,
                           res_ctx: ResolutionContext*) -> void {
        if (func == null) { return; }

        // Core resolution (return type + param types)
        this.resolver.resolve_func_signature(func, res_ctx);

        this.emit_signature_diagnostics(func);
    }

    /// Reports a signature whose return or parameter annotation did not
    /// resolve.  A failed annotation leaves `resolved_type` unset rather than
    /// poisoned, and every consumer downstream reads an unset param as `void`,
    /// so a signature that is never reported here is not merely undiagnosed -
    /// it silently acquires a different type than the one written.
    ///
    /// Call this once per function, at the point its signature resolution is
    /// FINAL.  Impl-block and inline methods are resolved twice (an early pass
    /// runs before the owner type exists in the arena, and a later one repairs
    /// what that missed), so reporting from the resolution helper itself would
    /// report the first pass's misses as errors.
    emit_signature_diagnostics(&this, func: FunctionDeclNode*) -> void {
        if (func == null) { return; }

        if (func.return_type_annotation != null && !func.has_resolved_return_type()) {
            this.emit_undefined_type(func.return_type_annotation,
                "return type", this.ctx.resolve_str(func.name), func.span);
        }

        // Sema reads param types directly from the AST node (param.resolved_type)
        // via enter_function() -> register_local().
        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null) { continue; }
            if (param.type_annotation != null && !param.resolved_type.is_valid()) {
                // The receiver is not a written annotation and has no import
                // that would fix it: `resolve_method_signatures` back-fills it
                // from the owner type, and leaves it unset when the owner is
                // not yet in the arena.  Its annotation carries the impl's
                // target-type name and span, so reporting it names the impl
                // header rather than anything the author can act on.
                const pname: string = this.ctx.resolve_str(param.name);
                if (pname == "this" || pname == "&this") { continue; }
                this.emit_undefined_type(param.type_annotation,
                    "type", this.ctx.resolve_str(param.name), param.span);
            }
        }
    }

    /// `emit_signature_diagnostics` over a struct/union/class/impl method list.
    emit_method_signature_diagnostics(&this, methods: &MethodNode*[]) -> void {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const method: MethodNode* = methods[i];
            if (method == null || method.func == null) { continue; }
            this.emit_signature_diagnostics(method.func);
        }
    }

    /// `emit_signature_diagnostics` over a trait's method list.
    emit_trait_method_signature_diagnostics(&this,
                                            methods: &FunctionDeclNode*[]) -> void {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const func: FunctionDeclNode* = methods[i];
            if (func == null) { continue; }
            this.emit_signature_diagnostics(func);
        }
    }

    /// Resolves type annotations on an array of FieldDeclNode.
    resolve_fields(&this, fields: &FieldDeclNode*[],
                   res_ctx: ResolutionContext*) -> void {
        // Core resolution
        this.resolver.resolve_fields(fields, res_ctx);

        // Emit diagnostics for unresolved fields
        for (mut i: i64 = 0; i < fields.length; i++) {
            const field: FieldDeclNode* = fields[i];
            if (field == null) { continue; }
            if (field.type_annotation != null && !field.resolved_type.is_valid()) {
                this.emit_undefined_type(field.type_annotation,
                    "type", this.ctx.resolve_str(field.name), field.span);
            }
        }
    }

    /// Resolves all method signatures (MethodNode*[]) on a struct/class/impl.
    /// `owner_type` lets the resolver back-fill `this`/`&this` resolved_type
    /// (the parser leaves the receiver param's type unset).
    resolve_method_signatures(&this, methods: &MethodNode*[],
                              res_ctx: ResolutionContext*,
                              owner_type: TypeRef,
                              owner_qname: SymbolStr) -> void {
        this.resolver.resolve_method_signatures(methods, res_ctx, owner_type, owner_qname);
    }

    /// Repair the signatures of a struct/union/class's *inline* methods during
    /// the TypeResolution pass, once the owner type exists.  The
    /// DeclarationCollection FunctionSignature pass resolves these methods
    /// before the owning type is registered, so its owner lookup returns
    /// invalid and a by-value `this` receiver (which carries no annotation)
    /// is left without a resolved_type.  `owner_key` is the declaration's own
    /// key (`decl_type_key`), the one the type-declaration stage registered
    /// it under, so the receiver back-fill in
    /// `Resolver::resolve_method_signatures` runs.  Idempotent for
    /// already-resolved return/param types.
    resolve_inline_method_signatures(&this, owner_key: SymbolStr,
                                     methods: &MethodNode*[],
                                     res_ctx: ResolutionContext*) -> void {
        const owner: TypeRef = this.ctx.decl_index.lookup_type(owner_key);
        if (owner.is_invalid()) { return; }
        this.resolver.resolve_method_signatures(methods, res_ctx, owner, owner_key);
    }

    /// Resolves all function signatures (FunctionDeclNode*[]) on a trait.
    resolve_trait_method_signatures(&this, methods: &FunctionDeclNode*[],
                                    res_ctx: ResolutionContext*) -> void {
        this.resolver.resolve_trait_method_signatures(methods, res_ctx);
    }


    // Recursive statement walker for variable/expression types

    /// Recursively walks a statement, resolving VarDeclNode.type_annotation and
    /// CastExprNode.target_annotation within function bodies.
    resolve_var_types_in_statement(&this, stmt: ASTNode*,
                                   res_ctx: ResolutionContext*) -> void {
        if (stmt == null) { return; }

        match (stmt.kind) {
            NodeKind::BlockStatement => {
                const block: BlockStmtNode* = stmt as BlockStmtNode*;
                for (mut i: i64 = 0; i < block.statements.length; i++) {
                    this.resolve_var_types_in_statement(block.statements[i] as ASTNode*, res_ctx);
                }
            }
            NodeKind::UnsafeBlockStatement => {
                const unsafe_block: UnsafeBlockStmtNode* = stmt as UnsafeBlockStmtNode*;
                if (unsafe_block.block != null) {
                    this.resolve_var_types_in_statement(unsafe_block.block as ASTNode*, res_ctx);
                }
            }
            NodeKind::DeclarationStatement => {
                const decl_stmt: DeclStmtNode* = stmt as DeclStmtNode*;
                if (decl_stmt.declaration != null) {
                    const decl: DeclarationNode* = decl_stmt.declaration;
                    if (decl.kind == NodeKind::VariableDeclaration) {
                        const var_node: VarDeclNode* = decl as VarDeclNode*;
                        if (var_node.type_annotation != null && !var_node.resolved_type.is_valid()) {
                            const vtype: TypeRef = this.resolver.resolve(var_node.type_annotation, res_ctx);
                            if (vtype.is_valid()) {
                                var_node.resolved_type = vtype;
                            } else {
                                // A name in it the name layer refused (`bool` for
                                // `boolean`) was reported where it was written, and
                                // the door records one left unanswered; a form
                                // resolved later in the walk (`typeof(...)`) is left
                                // to that walk.
                                TypeAnnotation::refused(var_node.type_annotation);
                            }
                        }
                        // Recurse into the initializer expression so var
                        // declarations nested inside it (e.g. for-loop init
                        // VarDecls in a lambda body bound here, match/if
                        // expression arms) get their `resolved_type` set.
                        // Without this, `const f = () -> i32 { for (mut i:
                        // i32 = 0; ...) { ... } };` left the for-init's `i`
                        // with an invalid resolved_type and codegen bailed
                        // out of the local-alloca path silently, producing
                        // a "rvalue null" downstream.
                        if (var_node.has_initializer()) {
                            this.resolve_var_types_in_expression(var_node.initializer, res_ctx);
                        }
                    } else if (decl.kind == NodeKind::DestructureDeclaration) {
                        const dd: DestructureDeclNode* = decl as DestructureDeclNode*;
                        if (dd.type_annotation != null && !dd.resolved_type.is_valid()) {
                            const dtype: TypeRef = this.resolver.resolve(dd.type_annotation, res_ctx);
                            if (dtype.is_valid()) {
                                dd.resolved_type = dtype;
                            }
                        }
                        if (dd.initializer != null) {
                            this.resolve_var_types_in_expression(dd.initializer, res_ctx);
                        }
                    }
                }
            }
            NodeKind::VariableDeclaration => {
                // Raw VarDeclNode (not wrapped in DeclStmtNode): produced by
                // the parser for C-style for-loop initializers: for (mut i: int = 0; ...)
                const var_node: VarDeclNode* = stmt as VarDeclNode*;
                if (var_node.type_annotation != null && !var_node.resolved_type.is_valid()) {
                    const vtype: TypeRef = this.resolver.resolve(var_node.type_annotation, res_ctx);
                    if (vtype.is_valid()) {
                        var_node.resolved_type = vtype;
                    } else {
                        // As the DeclStmt path above: reported where written,
                        // recorded if unanswered, left to the walk otherwise.
                        TypeAnnotation::refused(var_node.type_annotation);
                    }
                }
            }
            NodeKind::IfStatement => {
                const if_stmt: IfStmtNode* = stmt as IfStmtNode*;
                this.resolve_var_types_in_statement(if_stmt.then_stmt as ASTNode*, res_ctx);
                if (if_stmt.has_else()) {
                    this.resolve_var_types_in_statement(if_stmt.else_stmt as ASTNode*, res_ctx);
                }
            }
            NodeKind::WhileStatement => {
                const while_stmt: WhileStmtNode* = stmt as WhileStmtNode*;
                this.resolve_var_types_in_statement(while_stmt.body as ASTNode*, res_ctx);
            }
            NodeKind::DoWhileStatement => {
                const do_stmt: DoWhileStmtNode* = stmt as DoWhileStmtNode*;
                this.resolve_var_types_in_statement(do_stmt.body as ASTNode*, res_ctx);
            }
            NodeKind::ForStatement => {
                const for_stmt: ForStmtNode* = stmt as ForStmtNode*;
                // Resolve init if it's a var declaration
                if (for_stmt.init != null) {
                    this.resolve_var_types_in_statement(for_stmt.init, res_ctx);
                }
                this.resolve_var_types_in_statement(for_stmt.body as ASTNode*, res_ctx);
            }
            NodeKind::MatchStatement => {
                const match_stmt: MatchStmtNode* = stmt as MatchStmtNode*;
                for (mut i: i64 = 0; i < match_stmt.arms.length; i++) {
                    const arm: MatchArmNode* = match_stmt.arms[i];
                    if (arm != null && arm.body != null) {
                        this.resolve_var_types_in_statement(arm.body as ASTNode*, res_ctx);
                    }
                }
            }
            NodeKind::StaticMatchStatement => {
                const sm_stmt: StaticMatchStmtNode* = stmt as StaticMatchStmtNode*;
                for (mut i: i64 = 0; i < sm_stmt.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sm_stmt.arms[i];
                    if (arm != null && arm.body != null) {
                        this.resolve_var_types_in_statement(arm.body as ASTNode*, res_ctx);
                    }
                }
            }
            NodeKind::ExpressionStatement => {
                const expr_stmt: ExprStmtNode* = stmt as ExprStmtNode*;
                const _expr: ExpressionNode* = expr_stmt.expression;
                const _expr_node: ASTNode* = _expr as ASTNode*;
                if (_expr != null &&
                    _expr_node.kind == NodeKind::CastExpression) {
                    const cast: CastExprNode* = expr_stmt.expression as CastExprNode*;
                    if (cast.target_annotation != null && !cast.has_resolved_target()) {
                        const target: TypeRef = this.resolver.resolve(cast.target_annotation, res_ctx);
                        if (target.is_valid()) {
                            cast.set_resolved_target(target);
                        }
                    }
                }
                this.resolve_var_types_in_expression(_expr, res_ctx);
            }
            NodeKind::ReturnStatement => {
                // `return match (...) { ... }` and `return if (...) ...`
                // both hide var declarations inside their branches, which
                // need to be traversed for type resolution.  The earlier
                // no-op comment was wrong; return statements don't have
                // annotations themselves but their expression subtree does.
                const ret_stmt: ReturnStmtNode* = stmt as ReturnStmtNode*;
                this.resolve_var_types_in_expression(ret_stmt.expression, res_ctx);
            }
            NodeKind::LoopStatement => {
                const loop_stmt: LoopStmtNode* = stmt as LoopStmtNode*;
                this.resolve_var_types_in_statement(loop_stmt.body as ASTNode*, res_ctx);
            }
            _ => {
                // Other statement kinds (break, continue): no type annotations
            }
        }
    }

    /// Recurse into an expression looking for nested statement containers
    /// (match-arm bodies, ternary/if-expression branches) so any var
    /// declarations inside them get their `resolved_type` set.  Without
    /// this, `return match (...) { Pattern => { mut x: T = ...; } }`
    /// (and similar idioms) leaves `x.resolved_type = invalid`, and
    /// codegen can't allocate it.
    resolve_var_types_in_expression(&this, expr: ExpressionNode*,
                                     res_ctx: ResolutionContext*) -> void {
        if (expr == null) { return; }
        const n: ASTNode* = expr as ASTNode*;
        match (n.kind) {
            NodeKind::CallExpression => {
                // Recurse into arguments so lambdas passed as arguments get resolved.
                const call: CallExprNode* = expr as CallExprNode*;
                for (mut i: i64 = 0; i < call.arguments.length; i++) {
                    this.resolve_var_types_in_expression(call.arguments[i], res_ctx);
                }
            }
            NodeKind::MatchExpression => {
                const match_expr: MatchExprNode* = expr as MatchExprNode*;
                for (mut i: i64 = 0; i < match_expr.arms.length; i++) {
                    const arm: MatchArmNode* = match_expr.arms[i];
                    if (arm != null && arm.body != null) {
                        this.resolve_var_types_in_statement(arm.body as ASTNode*, res_ctx);
                    }
                }
            }
            NodeKind::StaticMatchExpression => {
                const sm_expr: StaticMatchExprNode* = expr as StaticMatchExprNode*;
                for (mut i: i64 = 0; i < sm_expr.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sm_expr.arms[i];
                    if (arm != null && arm.body != null) {
                        this.resolve_var_types_in_statement(arm.body as ASTNode*, res_ctx);
                    }
                }
            }
            NodeKind::IfExpression => {
                const if_expr: IfExprNode* = expr as IfExprNode*;
                if (if_expr.then_expr != null) {
                    this.resolve_var_types_in_expression(if_expr.then_expr, res_ctx);
                }
                if (if_expr.else_expr != null) {
                    this.resolve_var_types_in_expression(if_expr.else_expr, res_ctx);
                }
            }
            NodeKind::TernaryExpression => {
                const te: TernaryExprNode* = expr as TernaryExprNode*;
                if (te.true_expr != null) {
                    this.resolve_var_types_in_expression(te.true_expr, res_ctx);
                }
                if (te.false_expr != null) {
                    this.resolve_var_types_in_expression(te.false_expr, res_ctx);
                }
            }
            NodeKind::TryExpression => {
                // Runs before sema lowers `?`; recurse into the source
                // operand so nested var declarations get resolved types.
                const try_expr: TryExprNode* = expr as TryExprNode*;
                if (try_expr.operand != null) {
                    this.resolve_var_types_in_expression(try_expr.operand, res_ctx);
                }
            }
            NodeKind::LambdaExpression => {
                // Resolve parameter types and body variables of a lambda.
                const lam: LambdaExprNode* = expr as LambdaExprNode*;
                // Resolve each parameter's type annotation into resolved_type.
                for (mut li: i64 = 0; li < lam.parameters.length; li++) {
                    const lp: VarDeclNode* = lam.parameters[li];
                    if (lp != null && lp.type_annotation != null && !lp.resolved_type.is_valid()) {
                        const ptype: TypeRef = this.resolver.resolve(lp.type_annotation, res_ctx);
                        if (ptype.is_valid()) {
                            lp.resolved_type = ptype;
                        }
                    }
                }
                // Resolve the return type annotation if sema hasn't filled it in.
                if (!lam.return_type.is_valid() && lam.return_type_ann != null) {
                    const rtype: TypeRef = this.resolver.resolve(lam.return_type_ann, res_ctx);
                    if (rtype.is_valid()) {
                        lam.set_return_type(rtype);
                    }
                }
                // Walk body for variable declarations.
                if (lam.body != null) {
                    this.resolve_var_types_in_statement(lam.body as ASTNode*, res_ctx);
                }
            }
            _ => {
                // Other expression kinds don't contain var declarations
            }
        }
    }


    // Generic function call instantiation collection

    /// Scan a statement (recursively) for CallExprNodes with generic_args.
    /// For each, resolve the args and register an instantiation in the
    /// GenericRegistry so the Monomorphizer can discover and specialize it.
    collect_generic_fn_calls_in_stmt(&this, stmt: ASTNode*,
                                     res_ctx: ResolutionContext*) -> void {
        if (stmt == null) { return; }

        match (stmt.kind) {
            NodeKind::BlockStatement => {
                const block: BlockStmtNode* = stmt as BlockStmtNode*;
                for (mut i: i64 = 0; i < block.statements.length; i++) {
                    this.collect_generic_fn_calls_in_stmt(block.statements[i] as ASTNode*, res_ctx);
                }
            }
            NodeKind::ExpressionStatement => {
                const es: ExprStmtNode* = stmt as ExprStmtNode*;
                this.collect_generic_fn_calls_in_expr(es.expression, res_ctx);
            }
            NodeKind::DeclarationStatement => {
                const ds: DeclStmtNode* = stmt as DeclStmtNode*;
                if (ds.declaration != null) {
                    const decl_node: ASTNode* = ds.declaration as ASTNode*;
                    if (decl_node.kind == NodeKind::VariableDeclaration) {
                        const var_node: VarDeclNode* = ds.declaration as VarDeclNode*;
                        if (var_node.has_initializer()) {
                            this.collect_generic_fn_calls_in_expr(var_node.initializer, res_ctx);
                        }
                    } else if (decl_node.kind == NodeKind::DestructureDeclaration) {
                        const dd: DestructureDeclNode* = ds.declaration as DestructureDeclNode*;
                        if (dd.has_initializer()) {
                            this.collect_generic_fn_calls_in_expr(dd.initializer, res_ctx);
                        }
                    }
                }
            }
            NodeKind::ReturnStatement => {
                const ret: ReturnStmtNode* = stmt as ReturnStmtNode*;
                if (ret.has_expression()) {
                    this.collect_generic_fn_calls_in_expr(ret.expression, res_ctx);
                }
            }
            NodeKind::IfStatement => {
                const if_stmt: IfStmtNode* = stmt as IfStmtNode*;
                this.collect_generic_fn_calls_in_expr(if_stmt.condition, res_ctx);
                this.collect_generic_fn_calls_in_stmt(if_stmt.then_stmt as ASTNode*, res_ctx);
                if (if_stmt.has_else()) {
                    this.collect_generic_fn_calls_in_stmt(if_stmt.else_stmt as ASTNode*, res_ctx);
                }
            }
            NodeKind::WhileStatement => {
                const w: WhileStmtNode* = stmt as WhileStmtNode*;
                this.collect_generic_fn_calls_in_expr(w.condition, res_ctx);
                this.collect_generic_fn_calls_in_stmt(w.body as ASTNode*, res_ctx);
            }
            NodeKind::ForStatement => {
                const f: ForStmtNode* = stmt as ForStmtNode*;
                if (f.init != null) { this.collect_generic_fn_calls_in_stmt(f.init, res_ctx); }
                if (f.condition != null) { this.collect_generic_fn_calls_in_expr(f.condition, res_ctx); }
                if (f.update != null) { this.collect_generic_fn_calls_in_expr(f.update, res_ctx); }
                this.collect_generic_fn_calls_in_stmt(f.body as ASTNode*, res_ctx);
            }
            NodeKind::MatchStatement => {
                const ms: MatchStmtNode* = stmt as MatchStmtNode*;
                this.collect_generic_fn_calls_in_expr(ms.subject, res_ctx);
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm == null) { continue; }
                    if (arm.guard != null) {
                        this.collect_generic_fn_calls_in_expr(arm.guard, res_ctx);
                    }
                    if (arm.body != null) {
                        this.collect_generic_fn_calls_in_stmt(arm.body as ASTNode*, res_ctx);
                    }
                }
            }
            NodeKind::StaticMatchStatement => {
                const sm: StaticMatchStmtNode* = stmt as StaticMatchStmtNode*;
                for (mut i: i64 = 0; i < sm.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sm.arms[i];
                    if (arm == null) { continue; }
                    if (arm.body != null) {
                        this.collect_generic_fn_calls_in_stmt(arm.body as ASTNode*, res_ctx);
                    }
                }
            }
            NodeKind::LoopStatement => {
                const ls: LoopStmtNode* = stmt as LoopStmtNode*;
                this.collect_generic_fn_calls_in_stmt(ls.body as ASTNode*, res_ctx);
            }
            _ => {}
        }
    }

    /// Scan an expression (recursively) for CallExprNodes with generic_args.
    collect_generic_fn_calls_in_expr(&this, expr: ExpressionNode*,
                                     res_ctx: ResolutionContext*) -> void {
        if (expr == null) { return; }
        const node: ASTNode* = expr as ASTNode*;

        match (node.kind) {
            NodeKind::CallExpression => {
                const call: CallExprNode* = expr as CallExprNode*;
                // Recurse into callee and arguments first
                this.collect_generic_fn_calls_in_expr(call.callee, res_ctx);
                for (mut i: i64 = 0; i < call.arguments.length; i++) {
                    this.collect_generic_fn_calls_in_expr(call.arguments[i], res_ctx);
                }
                // Check for generic_args on the call
                if (call.generic_args.length > 0) {
                    this.register_generic_fn_call(call, res_ctx);
                }
            }
            NodeKind::BinaryExpression => {
                const bin: BinaryExprNode* = expr as BinaryExprNode*;
                this.collect_generic_fn_calls_in_expr(bin.left, res_ctx);
                this.collect_generic_fn_calls_in_expr(bin.right, res_ctx);
            }
            NodeKind::UnaryExpression => {
                const un: UnaryExprNode* = expr as UnaryExprNode*;
                this.collect_generic_fn_calls_in_expr(un.operand, res_ctx);
            }
            NodeKind::TryExpression => {
                const try_expr: TryExprNode* = expr as TryExprNode*;
                this.collect_generic_fn_calls_in_expr(try_expr.operand, res_ctx);
            }
            NodeKind::TernaryExpression => {
                const te: TernaryExprNode* = expr as TernaryExprNode*;
                this.collect_generic_fn_calls_in_expr(te.condition, res_ctx);
                this.collect_generic_fn_calls_in_expr(te.true_expr, res_ctx);
                this.collect_generic_fn_calls_in_expr(te.false_expr, res_ctx);
            }
            NodeKind::IfExpression => {
                const ie: IfExprNode* = expr as IfExprNode*;
                this.collect_generic_fn_calls_in_expr(ie.condition, res_ctx);
                this.collect_generic_fn_calls_in_expr(ie.then_expr, res_ctx);
                this.collect_generic_fn_calls_in_expr(ie.else_expr, res_ctx);
            }
            NodeKind::MemberAccess => {
                const ma: MemberAccessNode* = expr as MemberAccessNode*;
                this.collect_generic_fn_calls_in_expr(ma.object, res_ctx);
            }
            NodeKind::ArrayAccess => {
                const aa: ArrayAccessNode* = expr as ArrayAccessNode*;
                this.collect_generic_fn_calls_in_expr(aa.array, res_ctx);
                this.collect_generic_fn_calls_in_expr(aa.index, res_ctx);
            }
            _ => {
                // Literals, identifiers, scope resolution, etc.: no nested generic calls
            }
        }
    }

    /// Register a generic function call instantiation (`f<T>(...)`): the
    /// callee's template, the written arguments resolved, an instantiation
    /// demanded from the registry.
    ///
    /// The callee is an identifier.  A path callee keeps its turbofish on the
    /// path node (`Mod::f<T>` parses to a `ScopeResolutionNode` carrying the
    /// arguments; the CALL node's `generic_args` are written for an identifier
    /// callee and for a member callee's promoted `obj.m<T>`), so no other
    /// callee kind arrives here with arguments to register.
    ///
    /// The template is the callee's stamp: `Def(q)` names the declaration
    /// under the key the registry is keyed by.  A local, a type parameter or
    /// an unanswered slot names no template, and there is no spelling to
    /// search for one under - a bare leaf prefixed with the writer's module
    /// misses every imported template, and a resolver re-entered from here
    /// answers for whatever module the cursor is on.
    register_generic_fn_call(&this, call: CallExprNode*,
                             res_ctx: ResolutionContext*) -> void {
        const callee_node: ASTNode* = call.callee as ASTNode*;
        if (callee_node.kind != NodeKind::Identifier) { return; }
        const registry: GenericRegistry* = this.ctx.generic_registry;
        if (registry == null) { return; }

        const ident: IdentifierNode* = call.callee as IdentifierNode*;
        // The callee's stamp is the registry key; a callee with no stamp is
        // a defect the door records (an unresolved bare name is refused by
        // sema on its own path and never reaches an explicit-generic call).
        const entry: TemplateEntry* = registry.template_of(
            ident.res.require("type_resolution:register_generic_fn_call").def_id());
        if (entry == null) { return; }
        if (entry.node_kind != NodeKind::FunctionDeclaration) { return; }
        if (!entry.base_type.is_valid()) { return; }

        // Resolve generic args
        mut args: TypeRef[] = [];
        for (mut i: i64 = 0; i < call.generic_args.length; i++) {
            const arg: TypeRef = this.resolver.resolve(call.generic_args[i], res_ctx);
            if (!arg.is_valid()) { return; }
            args.push(arg);
        }

        // Validate arg count
        if (args.length != entry.param_count) { return; }

        // Register instantiation; GenericRegistry deduplicates
        const mod_sym: SymbolStr = this.ctx.intern(this.ctx.source_file);
        registry.instantiate_for_module(entry.base_type, args, mod_sym);

        LOG_DEBUG(LogComponent::General, "[TypeResolution] Registered generic function call '%s' with %lld args",
            this.ctx.resolve_str(ident.name), args.length);
    }
}


// TypeResolutionPasses: static entry points for pass dispatch + cross-module API

type struct TypeResolutionPasses {

    // Shared utility: GenericParamNode[] -> TypeRef[]

    /// Single source of truth for creating GenericParamType entries in the
    /// arena from an array of GenericParamNode*.  Returns parallel TypeRef[]
    /// where refs[i] is the GenericParamType for generic_params[i].
    ///
    /// A bound on the parameter does not reach the arena entry: a bound is
    /// written in a `where` clause, which lives on the declaration rather than
    /// on the parameter, and the consumers that need it read it from there.
    ///
    /// Used by:
    ///   - TypeResolutionRunner::bind_generic_params()
    ///   - SpecializationPasses::run_template_registration()
    static create_generic_param_types(generic_params: &GenericParamNode*[],
                                      arena: TypeArena*) -> TypeRef[] {
        mut refs: TypeRef[] = [];
        for (mut i: i64 = 0; i < generic_params.length; i++) {
            const gp: GenericParamNode* = generic_params[i];
            refs.push(arena.create_generic_param(gp.name, i as u64));
        }
        return refs;
    }


    // Shared utility: register a declaration in the DeclarationIndex

    /// Registers a top-level declaration (struct, class, enum, function, impl block)
    /// in the DeclarationIndex.  A type declaration's TYPE is already in the
    /// index, under its own key (`decl_type_key`, the key the type-declaration
    /// stage minted it under), and nowhere else; this arm adds what that stage
    /// does not own - the bare-name mapping, the visibility verdict, the
    /// methods - and asks the index nothing about the type.  A monomorphized
    /// type never reaches this arm - its registration is
    /// `SpecInjector::register`, under the arena name - so the declarations
    /// here are the written ones, and a written type's bare leaf is not a key
    /// any store holds.
    ///
    /// Shared by TypeResolution (Phase 4) and Specialization (injected decl
    /// registration) so that both use the same registration logic.
    ///
    /// `is_source_decl` distinguishes the two callers: true for genuine
    /// source-level declarations swept by the TypeResolution pass, false
    /// for monomorphizer-injected spec clones.  Only source decls feed the
    /// cross-module trait-impl coherence check; spec clones share canonical
    /// targets across the modules that instantiate them and would otherwise
    /// false-positive.
    static register_decl_in_index(stmt: ASTNode*, ctx: CompilationContext*,
                                  is_source_decl: boolean) -> void {
        if (stmt == null) { return; }
        const arena: TypeArena* = ctx.type_arena;

        match (stmt.kind) {
            NodeKind::StructDeclaration => {
                const node: StructDeclNode* = stmt as StructDeclNode*;
                ctx.decl_index.register_methods(ctx.decl_index.type_of_decl(node.def, "type_resolution/register struct methods"), node.methods, ctx.intern_table, arena, "type_resolution/register struct methods");
            }
            NodeKind::UnionDeclaration => {
                const node: UnionDeclNode* = stmt as UnionDeclNode*;
                ctx.decl_index.register_methods(ctx.decl_index.type_of_decl(node.def, "type_resolution/register union methods"), node.methods, ctx.intern_table, arena, "type_resolution/register union methods");
            }
            NodeKind::ClassDeclaration => {
                const node: ClassDeclNode* = stmt as ClassDeclNode*;
                ctx.decl_index.register_methods(ctx.decl_index.type_of_decl(node.def, "type_resolution/register class methods"), node.methods, ctx.intern_table, arena, "type_resolution/register class methods");
            }
            NodeKind::TraitDeclaration => {
                const node: TraitDeclNode* = stmt as TraitDeclNode*;
                const qualified_sym: SymbolStr = ctx.decl_type_key(node.name, SymbolStr::empty(), node.span.file);
                // Register each trait method's return type on both the
                // qualified and bare trait name so bound-aware dispatch
                // (B.4) can find the method by leaf name when the receiver
                // is a `BoundedParamType` carrying this trait.
                for (mut mi: i64 = 0; mi < node.methods.length; mi++) {
                    const tfunc: FunctionDeclNode* = node.methods[mi];
                    if (tfunc == null) { continue; }
                    if (!tfunc.has_resolved_return_type()) { continue; }
                    ctx.decl_index.register_method(qualified_sym, tfunc.name,
                        tfunc.resolved_return_type);
                    if (!qualified_sym.equals(node.name)) {
                        ctx.decl_index.register_method(node.name, tfunc.name,
                            tfunc.resolved_return_type);
                    }
                }
            }
            NodeKind::FunctionDeclaration => {
                const func: FunctionDeclNode* = stmt as FunctionDeclNode*;
                if (func.resolved_return_type.is_valid()) {
                    // Collect resolved param types from AST
                    mut param_types: TypeRef[] = [];
                    for (mut p: i64 = 0; p < func.parameters.length; p++) {
                        const param: VarDeclNode* = func.parameters[p];
                        if (param != null && param.resolved_type.is_valid()) {
                            param_types.push(param.resolved_type);
                        }
                    }

                    // Create a FunctionType in the arena (deduplicated)
                    const func_type_ref: TypeRef = arena.get_function(
                        func.resolved_return_type, param_types, func.is_variadic);

                    // Under the declaration's own key, in the per-module list
                    // so cross-module descriptors carry it whole.
                    const q_name: SymbolStr = ctx.decl_fn_key(func.name, func.span.file);
                    const entry: OverloadId = ctx.decl_index.register_function_signature(
                        q_name, func.resolved_return_type, func_type_ref, ctx.intern_table, arena,
                        SymbolStr::empty(), if (func.has_name_span()) { func.name_span } else { func.span });
                    func.set_overload_entry(entry);

                    ctx.decl_index.set_decl_visibility(q_name, func.is_public);
                    // A monomorphized clone's identifier is program-unique -
                    // the mangling of its template and arguments - and is the
                    // FAMILY every caller pins it by, so the clone registers
                    // under it as well.  A written declaration's leaf is not
                    // a key any store holds: a caller names it by its stamp,
                    // and a leaf slot is last-writer-wins across every module
                    // declaring the leaf.  A leaf an `intrinsic function`
                    // owns keeps its single-slot bindings either way; the
                    // index refuses non-intrinsic overwrites of them.
                    if (!is_source_decl && !q_name.equals(func.name)) {
                        ctx.decl_index.register_signature(
                            func.name, func_type_ref, q_name, ctx.decl_index.entry_symbol(entry), SymbolStr::empty(),
                            ctx.decl_index.entry_span(entry));
                    }
                }
            }
            NodeKind::ImplementationBlock => {
                const node: ImplBlockNode* = stmt as ImplBlockNode*;
                // Stamp the impl block with its defining module + qualified
                // target name so the monomorphizer can register spec'd
                // methods (added later to node.methods) under the same DI
                // keys sema-time used for the template.  Without these
                // stamps the spec ends up registered under a bare-name key
                // that doesn't match the qualified key used at sema, and
                // the cross-module extern-decl path picks up the template's
                // (GenericParam-typed) overload entry.
                if (node.source_module == "") {
                    node.set_source_module(ctx.source_file);
                }
                // Stamp each trait-impl method with its trait's identity so
                // every mangling site can disambiguate it from a same-named
                // method of another trait implemented for the same type.
                // Without this, `implement trait A for T { foo() }` and
                // `implement trait B for T { foo() }` mangle to the same
                // symbol and collide at link time (see
                // FunctionDeclNode.origin_trait and
                // MangledName::for_method_or_trait_impl).  This is the single
                // stamping chokepoint: it runs for both the type-resolution
                // path and the specialization injected-decl path (which
                // routes spec'd impl blocks back through register_decl_in_index).
                //
                // The trait is the head annotation's stamp: the canonical name
                // the trait registries key by, decided where the impl's
                // imports were in hand.  Two traits can share a leaf, and the
                // stamp is what tells them apart; a head with no stamp is a
                // defect the door records, never a leaf to search for.
                if (node.is_trait_impl()) {
                    const ot_trait: SymbolStr = TypeResolutionPasses::head_named_slot(node.trait_annotation)
                        .require("type_resolution:trait-impl head").def_id().qualified_name();
                    if (ot_trait.is_valid()) {
                        // Carry the same answer on the block itself: a caller
                        // asking WHICH trait this impl provides must not have to
                        // re-derive it from the registry's bare leaf key.
                        node.qualified_trait_name = ot_trait;
                        for (mut omi: i64 = 0; omi < node.methods.length; omi++) {
                            const om: MethodNode* = node.methods[omi];
                            if (om != null && om.func != null) {
                                om.func.set_origin_trait(ot_trait);
                            }
                        }
                    }
                }
                // The impl's target under the name it is registered by, off
                // the head: a declaration's canonical name, a primitive's own
                // spelling, a clone's specialization.
                const canonical_target: SymbolStr = node.target_key(arena);
                if (ctx.generic_registry != null && canonical_target.is_valid()) {
                    // A written head on a template names EVERY parameter of
                    // that template, as parameters of its own or as a concrete
                    // instantiation; an elided one is refused here, where every
                    // template is registered and the head is about to be
                    // attached to it.  A clone carries no stamp and is not a
                    // head anyone wrote.
                    TypeResolutionPasses::refuse_elided_template_params(
                        node, canonical_target, ctx);
                    // Attach the block to its target's template under the
                    // same key TemplateRegistration used.  That pass runs
                    // before the template exists whenever the target's
                    // module comes later in pass order (`fmt::display`'s
                    // `Display for String` sees no `String` template there),
                    // so this is the offer that always lands; a clone
                    // injected after TemplateRegistration is attached here
                    // alone.  The registry refuses a block it already holds.
                    ctx.generic_registry.register_impl_block(
                        canonical_target, node);
                    if (node.is_trait_impl()) {
                        // Under the trait's identity and the target's key.
                        // TemplateRegistration offered the same head; the
                        // registry keeps one, and a clone routed here after
                        // that pass is registered here alone.
                        ctx.generic_registry.register_trait_impl(
                            node.qualified_trait_name, canonical_target, node);
                    }
                }
                // Trait-impl coherence (same file AND across modules).  A
                // trait may be implemented at most once per type.  TypeRes
                // has stamped `canonical_target` (import-resolved,
                // defining-module qualified), so the canonical impl-head
                // signature built here is exact: same-leaf types in
                // different modules stay distinct, an impl on an imported
                // type collides with the type's home-module impl, and the
                // trait's type args (`From<i8>` vs `From<i16>`), the
                // target's type args, and the where-bounds all participate
                // so only genuine duplicates collide.  This is the SOLE
                // coherence check - `register_impl_block`'s earlier
                // same-file-only check was removed in favor of it, so there
                // is no double report.  Source decls only: monomorphizer-
                // injected spec clones share canonical heads across the
                // modules that instantiate them and would false-positive.
                if (is_source_decl && node.is_trait_impl()
                        && canonical_target.is_valid()
                        && ctx.generic_registry != null) {
                    const coh_key: string =
                        TypeResolutionPasses::coherence_key_for(
                            node, canonical_target, ctx);
                    const coh_sym: SymbolStr =
                        ctx.intern_table.intern(coh_key);
                    const prior: ImplBlockNode* =
                        ctx.generic_registry.register_coherence(
                            coh_sym, node);
                    if (prior != null) {
                        const c_leaf: SymbolStr =
                            TypeResolutionPasses::extract_trait_leaf(
                                node.trait_annotation);
                        const tname: string =
                            ctx.intern_table.resolve(c_leaf);
                        const gname: string =
                            ctx.intern_table.resolve(canonical_target);
                        ctx.emit_error_at(
                            ErrorCode::E0308_CONFLICTING_TRAIT_IMPL,
                            fmt::format("conflicting implementations of trait `%s` for type `%s`: a trait may be implemented at most once per type, including across modules",
                                   tname, gname),
                            node.span);
                    }
                }
                // The head's methods under the owner the index names.
                ctx.decl_index.register_methods(
                    ctx.decl_index.impl_owner(node, "type_resolution/register impl methods"),
                    node.methods, ctx.intern_table, arena, "type_resolution/register impl methods");
            }
            _ => {}
        }
    }


    // Default trait-method synthesis (Phase B.6)
    //
    // When an impl block names a trait and the trait declares a default body
    // for some method, the impl inherits that default unless it overrides.
    // This helper clones every default-bodied trait method that the impl
    // doesn't override and adds it as a MethodNode on the impl. The clone
    // goes through the rest of FunctionSignature/TypeResolution/Sema in the
    // same loop, picking up the impl's `this_type` (= owner_type) so any
    // `This` annotations in the body resolve to the impl target.
    //
    // Cross-module: traits register themselves in the GenericRegistry's
    // trait-decl index from their own module's FunctionSignature pass.
    // A consumer module's pass runs after the trait's, so the lookup
    // finds the trait's AST.  Same-module impls work because traits are
    // declared before their impls in source order.
    //
    // Limitations: trait must be reachable as a bare leaf name. Generic
    // traits (e.g. `Iterator<T>`) work for the leaf-name path but the
    // generic params don't propagate yet; that's left for a follow-up.
    // Returns the number of methods synthesized.

    /// Rewrite every `ThisType` annotation reachable from `ann` (in-place) to
    /// `Named(target)`. Used after cloning a trait default method into an
    /// impl block: the trait body's `&this` parameter and any `-> This`
    /// return type carry `ThisType` annotations, but the impl-resolution
    /// path can't always set `ctx.this_type` (generic impl targets fall out
    /// of `decl_index.lookup_type`). Rewriting at clone time keeps the
    /// cloned method indistinguishable from a hand-written impl method,
    /// whose `&this` is parsed as `&Named(target)` directly.
    /// `home_span` is the span the rewritten annotation ADOPTS, and it must come
    /// from the impl block rather than from the `This` token being replaced.
    /// The name written here is the impl's target, so the syntax this annotation
    /// now stands for was written in the impl's file; keeping the trait's span
    /// leaves a node whose name and provenance disagree, and a bare leaf then
    /// resolves in a module that never wrote it (`HashMapIter` homed on
    /// `std::core::iter`).  An `implement` block may live in a third module
    /// again, so neither the trait's nor the target type's file can stand in.
    static rewrite_this_type_annotation(ann: TypeAnnotation*,
                                         target: SymbolStr,
                                         target_args: &TypeAnnotation*[],
                                         home_span: SourceSpan,
                                         home_res: ResSlot) -> void {
        if (ann == null) { return; }
        match (*ann) {
            TypeAnnotation::ThisType(t) => {
                // The impl head already asked what its target spells, in the
                // scope it was written in, and this node names that same type.
                // The head's slot is carried across whatever it holds: a head
                // no resolver could answer for mints an unanswered node, and a
                // second walk here would be a second opinion about one
                // spelling.
                const named: NamedAnnotation* = new NamedAnnotation {
                    name:         target,
                    span:         home_span,
                    pre_resolved: TypeRef::invalid(),
                    res:          home_res,
                };
                const temp: TypeAnnotation* = libc::malloc(sizeof(TypeAnnotation)) as TypeAnnotation*;
                if (target_args.length > 0) {
                    // Generic target (`for Range<T>`): `This` is the full Self
                    // type `Range<T>`, not the bare `Range`.  Wrap the name in
                    // a Generic carrying deep-cloned copies of the target args.
                    const base_ann: TypeAnnotation* =
                        libc::malloc(sizeof(TypeAnnotation)) as TypeAnnotation*;
                    *base_ann = TypeAnnotation::Named(named);
                    mut cloned_args: TypeAnnotation*[] = [];
                    for (mut i: i64 = 0; i < target_args.length; i++) {
                        cloned_args.push(TypeAnnotation::clone_ptr(target_args[i]));
                    }
                    const gen: GenericAnnotation* = new GenericAnnotation {
                        base: base_ann,
                        args: cloned_args,
                        span: home_span,
                    };
                    *temp = TypeAnnotation::Generic(gen);
                } else {
                    *temp = TypeAnnotation::Named(named);
                }
                mem::copy<TypeAnnotation>(ann, temp, 1);
                // `temp` was only a staging container: its bytes (the enum tag +
                // the Named/Generic payload pointer) are now copied into `*ann`,
                // which owns the payload from here.  Free the throwaway container
                // so it doesn't leak per rewrite (this path is direct `malloc`,
                // not arena-routed, so in a long-running host - the LSP - it
                // would accumulate every recompile).  The `named`/`gen` the
                // pointer refers to is shared with `*ann` and must NOT be freed.
                libc::free(temp as void*);
            }
            TypeAnnotation::Reference(r) => {
                TypeResolutionPasses::rewrite_this_type_annotation(r.inner, target, target_args, home_span, home_res);
            }
            TypeAnnotation::Pointer(p) => {
                TypeResolutionPasses::rewrite_this_type_annotation(p.inner, target, target_args, home_span, home_res);
            }
            TypeAnnotation::Array(a) => {
                TypeResolutionPasses::rewrite_this_type_annotation(a.element, target, target_args, home_span, home_res);
            }
            TypeAnnotation::Generic(g) => {
                TypeResolutionPasses::rewrite_this_type_annotation(g.base, target, target_args, home_span, home_res);
                for (mut i: i64 = 0; i < g.args.length; i++) {
                    TypeResolutionPasses::rewrite_this_type_annotation(g.args[i], target, target_args, home_span, home_res);
                }
            }
            TypeAnnotation::Tuple(tu) => {
                for (mut i: i64 = 0; i < tu.elements.length; i++) {
                    TypeResolutionPasses::rewrite_this_type_annotation(tu.elements[i], target, target_args, home_span, home_res);
                }
            }
            TypeAnnotation::Function(f) => {
                TypeResolutionPasses::rewrite_this_type_annotation(f.return_type, target, target_args, home_span, home_res);
                for (mut i: i64 = 0; i < f.parameters.length; i++) {
                    TypeResolutionPasses::rewrite_this_type_annotation(f.parameters[i], target, target_args, home_span, home_res);
                }
            }
            _ => { }
        }
    }

    /// Rewrite every reference to a trait's generic parameter (by name) in
    /// `ann` (in-place) to the impl's corresponding trait-argument
    /// annotation.  Companion to `rewrite_this_type_annotation`, run after
    /// cloning a trait default method into an impl block.  The trait body's
    /// signature names the trait's own params - e.g. `Item` in
    /// `Iterator<Item>::fold<Acc>(... f: (Acc, Item) -> Acc ...)` - but the
    /// clone lives in `implement<T> Iterator<T> for Range<T>`, where the
    /// trait arg standing in for `Item` is `T`.  Without this rewrite the
    /// cloned annotation keeps the literal name `Item`, which the
    /// impl-specialization substituter (keyed on the impl's own params, e.g.
    /// `T`) never touches; the leftover generic surfaces as an invalid
    /// TypeRef and crashes the mangler when the method is later specialized
    /// for a concrete instantiation.  `param_names[i]` maps to `arg_anns[i]`;
    /// complex args (e.g. `Pair<u64, A>`) are deep-cloned into the slot.
    static rewrite_trait_params_annotation(ann: TypeAnnotation*,
                                            param_names: &SymbolStr[],
                                            arg_anns: &TypeAnnotation*[]) -> void {
        if (ann == null) { return; }
        match (*ann) {
            TypeAnnotation::Named(n) => {
                // Pre-resolved leaves already map to a concrete TypeRef and
                // can't be a trait param awaiting substitution.
                if (n.pre_resolved.is_valid()) { return; }
                for (mut i: i64 = 0; i < param_names.length; i++) {
                    if (n.name.equals(param_names[i])) {
                        const cloned: TypeAnnotation* =
                            TypeAnnotation::clone_ptr(arg_anns[i]);
                        if (cloned != null) {
                            mem::copy<TypeAnnotation>(ann, cloned, 1);
                        }
                        return;
                    }
                }
            }
            TypeAnnotation::Reference(r) => {
                TypeResolutionPasses::rewrite_trait_params_annotation(
                    r.inner, param_names, arg_anns);
            }
            TypeAnnotation::Pointer(p) => {
                TypeResolutionPasses::rewrite_trait_params_annotation(
                    p.inner, param_names, arg_anns);
            }
            TypeAnnotation::Array(a) => {
                TypeResolutionPasses::rewrite_trait_params_annotation(
                    a.element, param_names, arg_anns);
            }
            TypeAnnotation::Generic(g) => {
                TypeResolutionPasses::rewrite_trait_params_annotation(
                    g.base, param_names, arg_anns);
                for (mut i: i64 = 0; i < g.args.length; i++) {
                    TypeResolutionPasses::rewrite_trait_params_annotation(
                        g.args[i], param_names, arg_anns);
                }
            }
            TypeAnnotation::Tuple(tu) => {
                for (mut i: i64 = 0; i < tu.elements.length; i++) {
                    TypeResolutionPasses::rewrite_trait_params_annotation(
                        tu.elements[i], param_names, arg_anns);
                }
            }
            TypeAnnotation::Function(f) => {
                TypeResolutionPasses::rewrite_trait_params_annotation(
                    f.return_type, param_names, arg_anns);
                for (mut i: i64 = 0; i < f.parameters.length; i++) {
                    TypeResolutionPasses::rewrite_trait_params_annotation(
                        f.parameters[i], param_names, arg_anns);
                }
            }
            _ => { }
        }
    }

    /// Apply both clone-time rewrites to a freshly cloned trait default
    /// method's signature: `This` -> the impl target, and each trait generic
    /// param -> the impl's corresponding trait arg.  Consolidated into one
    /// entry point so the caller makes a single call; the return type is
    /// handled before the param loop so the loop is the trailing statement.
    static rewrite_default_method_signature(cloned: FunctionDeclNode*,
                                            target: SymbolStr,
                                            target_args: &TypeAnnotation*[],
                                            param_names: &SymbolStr[],
                                            arg_anns: &TypeAnnotation*[],
                                            home_span: SourceSpan,
                                            home_res: ResSlot) -> void {
        if (cloned == null) { return; }
        const ret_ann: TypeAnnotation* = cloned.return_type_annotation;
        if (ret_ann != null) {
            TypeResolutionPasses::rewrite_this_type_annotation(ret_ann, target, target_args, home_span, home_res);
            if (param_names.length > 0) {
                TypeResolutionPasses::rewrite_trait_params_annotation(
                    ret_ann, param_names, arg_anns);
            }
        }
        for (mut p: i64 = 0; p < cloned.parameters.length; p++) {
            const param: VarDeclNode* = cloned.parameters[p];
            if (param != null && param.type_annotation != null) {
                TypeResolutionPasses::rewrite_this_type_annotation(
                    param.type_annotation, target, target_args, home_span, home_res);
                if (param_names.length > 0) {
                    TypeResolutionPasses::rewrite_trait_params_annotation(
                        param.type_annotation, param_names, arg_anns);
                }
            }
        }
    }

    /// True if `ann` mentions `This` anywhere (directly or nested inside a
    /// pointer/reference/optional/array/generic/tuple/function annotation).
    /// Used to flag self-returning trait defaults (combinators) so the
    /// monomorphizer instantiates them lazily rather than eagerly.
    static annotation_references_this(ann: TypeAnnotation*) -> boolean {
        if (ann == null) { return false; }
        return match (*ann) {
            TypeAnnotation::ThisType(_) => { true }
            TypeAnnotation::Reference(r) => {
                TypeResolutionPasses::annotation_references_this(r.inner)
            }
            TypeAnnotation::Pointer(p) => {
                TypeResolutionPasses::annotation_references_this(p.inner)
            }
            TypeAnnotation::Array(a) => {
                TypeResolutionPasses::annotation_references_this(a.element)
            }
            TypeAnnotation::Generic(g) => {
                mut found: boolean =
                    TypeResolutionPasses::annotation_references_this(g.base);
                for (mut i: i64 = 0; i < g.args.length; i++) {
                    if (TypeResolutionPasses::annotation_references_this(g.args[i])) {
                        found = true;
                    }
                }
                found
            }
            TypeAnnotation::Tuple(tu) => {
                mut found: boolean = false;
                for (mut i: i64 = 0; i < tu.elements.length; i++) {
                    if (TypeResolutionPasses::annotation_references_this(tu.elements[i])) {
                        found = true;
                    }
                }
                found
            }
            TypeAnnotation::Function(f) => {
                mut found: boolean =
                    TypeResolutionPasses::annotation_references_this(f.return_type);
                for (mut i: i64 = 0; i < f.parameters.length; i++) {
                    if (TypeResolutionPasses::annotation_references_this(f.parameters[i])) {
                        found = true;
                    }
                }
                found
            }
            _ => { false }
        };
    }

    /// Walk a trait_annotation to its leaf identifier: the bare trait name.
    /// Mirrors `specialization::extract_root_name` but is duplicated here
    /// to keep type_resolution.cryo self-contained.
    /// The stamp on the head's Named annotation, walking the same wrappers
    /// `extract_trait_leaf` walks; `Pending` when there is none.
    /// An impl head on a template writes every parameter of the template it
    /// names - as parameters of its own (`implement<A> trait Display for
    /// String<A>`) or as a concrete instantiation (`implement trait Display
    /// for String<GlobalAlloc>`) - whether every parameter defaults or only the
    /// trailing ones do.  A head that writes fewer is not given the default
    /// meaning: `implement trait Display for String` would be an impl for
    /// `String<GlobalAlloc>` alone while reading as one for every `String`,
    /// and `implement<T> trait Foo for Array<T>` the same for `Array<T,
    /// GlobalAlloc>`.  Refused on the WRITTEN head only: the stamp is what a
    /// written head carries and a clone does not.
    static refuse_elided_template_params(node: ImplBlockNode*, canonical_target: SymbolStr,
                                         ctx: CompilationContext*) -> void {
        mut written: boolean = false;
        match (node.res) {
            ResSlot::Answered(r) => {
                match (r) {
                    Res::Def(_) => { written = true; }
                    _           => { }
                }
            }
            _ => { }
        }
        if (!written) { return; }
        const tmpl: TemplateEntry* = ctx.generic_registry.get_template(canonical_target);
        if (tmpl == null || tmpl.param_count == 0) { return; }
        // What the head writes after the target.  An inherent impl's list
        // also declares its names, so its one spelling is the parameter form.
        const inherent: boolean = !node.is_trait_impl();
        const written_count: i64 = node.target_args.length;
        const intern: InternTable* = ctx.intern_table;
        if (written_count == tmpl.param_count) { return; }

        const target: string = intern.resolve(node.target_type);
        const tmpl_params: GenericParamNode*[] = tmpl.get_generic_params();

        // The head as the writer would spell it with every parameter named:
        // its own parameters first, then the template's missing ones under the
        // template's own names.
        mut own_params: string = "";
        for (mut i: i64 = 0; i < node.generic_params.length; i++) {
            if (i > 0) { own_params = own_params + ", "; }
            own_params = own_params + intern.resolve(node.generic_params[i].name);
        }
        mut head_params: string = own_params;
        mut target_args: string = "";
        for (mut i: i64 = 0; i < written_count; i++) {
            if (i > 0) { target_args = target_args + ", "; }
            target_args = target_args + TypeAnnotation::spell(node.target_args[i], intern);
        }
        mut concrete_args: string = target_args;
        mut all_defaulted: boolean = true;
        for (mut i: i64 = written_count; i < tmpl_params.length; i++) {
            const pname: string = intern.resolve(tmpl_params[i].name);
            if (head_params.length() > 0) { head_params = head_params + ", "; }
            head_params = head_params + pname;
            if (target_args.length() > 0) { target_args = target_args + ", "; }
            target_args = target_args + pname;
            if (concrete_args.length() > 0) { concrete_args = concrete_args + ", "; }
            if (tmpl_params[i].has_default_annotation()) {
                concrete_args = concrete_args + TypeAnnotation::spell(
                    tmpl_params[i].default_annotation, intern);
            } else {
                concrete_args = concrete_args + "..";
                all_defaulted = false;
            }
        }
        mut trait_part: string = "";
        if (node.is_trait_impl()) {
            trait_part = fmt::format("trait %s ", TypeAnnotation::spell(node.trait_annotation, intern));
        }
        // An inherent impl's parameters ARE the template's, so it has one
        // spelling; a trait impl has the parameter form and the concrete one.
        const param_form: string = if (inherent) {
            fmt::format("implement %s<%s>", target, target_args)
        } else {
            fmt::format("implement<%s> %sfor %s<%s>", head_params, trait_part, target, target_args)
        };
        const concrete_form: string = if (node.generic_params.length > 0) {
            fmt::format("implement<%s> %sfor %s<%s>", own_params, trait_part, target, concrete_args)
        } else {
            fmt::format("implement %sfor %s<%s>", trait_part, target, concrete_args)
        };

        const span: SourceSpan = if (node.target_type_span.has_location()) { node.target_type_span } else { node.span };
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0302_GENERIC_PARAM_MISMATCH,
            fmt::format("`%s` is a template with %lld parameter%s, and this impl head names %lld of them",
                   target, tmpl.param_count, if (tmpl.param_count == 1) { "" } else { "s" }, written_count));
        diag = diag.at_with_label(span, "every parameter is written in an impl head");
        diag = diag.with_note(fmt::format("write the parameters: `%s`", param_form));
        // An inherent block is written over the template and has nothing
        // else to offer.
        if (!inherent && all_defaulted) {
            diag = diag.with_note(fmt::format("or a concrete instantiation: `%s`", concrete_form));
        }
        if (!inherent && !all_defaulted) {
            diag = diag.with_note(fmt::format("or a concrete instantiation, one type per parameter: `%s`", concrete_form));
        }
        ctx.emit_diagnostic(diag);
    }

    static head_named_slot(ann: TypeAnnotation*) -> ResSlot {
        if (ann == null) { return ResSlot::Pending; }
        return match (*ann) {
            TypeAnnotation::Named(n) => { n.res }
            TypeAnnotation::Generic(g) => { TypeResolutionPasses::head_named_slot(g.base) }
            TypeAnnotation::Reference(r) => { TypeResolutionPasses::head_named_slot(r.inner) }
            TypeAnnotation::Pointer(p) => { TypeResolutionPasses::head_named_slot(p.inner) }
            _ => { ResSlot::Pending }
        };
    }

    static extract_trait_leaf(ann: TypeAnnotation*) -> SymbolStr {
        if (ann == null) { return SymbolStr::empty(); }
        return match (*ann) {
            TypeAnnotation::Named(n) => { n.name }
            TypeAnnotation::Generic(g) => {
                TypeResolutionPasses::extract_trait_leaf(g.base)
            }
            TypeAnnotation::Reference(r) => {
                TypeResolutionPasses::extract_trait_leaf(r.inner)
            }
            TypeAnnotation::Pointer(p) => {
                TypeResolutionPasses::extract_trait_leaf(p.inner)
            }
            _ => { SymbolStr::empty() }
        };
    }

    /// The implicit associated-type name an `async` trait method's future is
    /// bound to: `read` -> `ReadFut`, `read_exact` -> `ReadExactFut`. Each
    /// `_`-separated word is capitalised and the separators dropped, so the name
    /// reads as an ordinary Cryo type and cannot collide with the method name.
    /// Case-mapped through explicit alphabet tables rather than char arithmetic:
    /// `CharType` is 4 bytes here while the stdlib treats a char as 1, so
    /// `c - 32` is not a portable way to upper-case in this codebase.
    static async_fut_assoc_name(ctx: CompilationContext*, method: SymbolStr) -> SymbolStr {
        const lower: string = "abcdefghijklmnopqrstuvwxyz";
        const upper: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const src: string = ctx.get_intern_table().resolve(method);
        const n: i64 = src.length() as i64;
        mut out: string = "";
        mut upper_next: boolean = true;
        for (mut i: i64 = 0; i < n; i++) {
            if (src[i] == '_') { upper_next = true; continue; }
            mut piece: string = src.substring(i as u32, 1);
            if (upper_next) {
                for (mut k: i64 = 0; k < 26; k++) {
                    if (src[i] == lower[k]) { piece = upper.substring(k as u32, 1); break; }
                }
            }
            out = fmt::format("%s%s", out, piece);
            upper_next = false;
        }
        return ctx.intern(fmt::format("%sFut", out));
    }

    /// Whether `assoc` is the implicit future type of an `async` trait method
    /// that `impl_node` supplies — either with its own `async` method, or with a
    /// default body inherited from the trait.
    ///
    /// Such a binding is added by the sema-time async lowering (which mints the
    /// future struct), long after E0309 runs, so the check has to recognise it
    /// as satisfied here rather than demanding the user write it.
    static impl_binds_assoc_via_async(impl_node: ImplBlockNode*, trait_decl: TraitDeclNode*,
                                      assoc: SymbolStr, ctx: CompilationContext*) -> boolean {
        if (impl_node == null || trait_decl == null || ctx == null) { return false; }
        for (mut ti: i64 = 0; ti < trait_decl.methods.length; ti++) {
            const tfunc: FunctionDeclNode* = trait_decl.methods[ti];
            if (tfunc == null || !tfunc.is_async) { continue; }
            if (!TypeResolutionPasses::async_fut_assoc_name(ctx, tfunc.name).equals(assoc)) {
                continue;
            }
            // The impl overrides it with its own `async` method...
            for (mut mi: i64 = 0; mi < impl_node.methods.length; mi++) {
                const m: MethodNode* = impl_node.methods[mi];
                if (m == null || m.func == null) { continue; }
                if (m.func.name.equals(tfunc.name) && m.func.is_async) { return true; }
            }
            // ...or inherits the trait's default body, which
            // `synthesize_default_trait_methods` clones in as an `async` method.
            if (tfunc.has_body()) { return true; }
        }
        return false;
    }

    /// Desugar every `async` method on a trait declaration.
    ///
    /// `async read(&this, n: i64) -> i64` becomes an implicit `type ReadFut;`
    /// plus a projection return (`read(&this, n: i64) -> This::ReadFut`), which
    /// each impl binds to the future its own `async read` lowers to.
    ///
    /// Only the RESOLVED return is rewritten — the ANNOTATION deliberately keeps
    /// the user's `-> i64`. `synthesize_default_trait_methods` clones a
    /// default-bodied trait method into each impl carrying its annotations, and
    /// that clone must lower as an ordinary `async` method whose future's Output
    /// is `i64`. Rewriting the annotation would make the clone return its own
    /// future type, which is circular.
    ///
    /// The projection is born naming `trait_ref` as its owning trait: a call
    /// on a still-generic receiver carries this type (with `This` replaced by
    /// the receiver's parameter) and nothing else identifies the trait there -
    /// the callee is unresolved until the owner is concrete - so a reader that
    /// needs the declaration (the async lowering's receiver-refresh decision)
    /// reads it off the projection rather than scanning traits by the method's
    /// leaf, which answers the first trait declaring that leaf, async or not.
    static desugar_async_trait_methods(node: TraitDeclNode*, ctx: CompilationContext*,
                                       arena: TypeArena*, trait_ref: TypeRef) -> void {
        if (node == null || ctx == null || arena == null) { return; }
        const this_ty: TypeRef = arena.create_generic_param(
            ctx.intern("This"), 0xFFFFFFFF as u64);
        if (!this_ty.is_valid()) { return; }
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            const func: FunctionDeclNode* = node.methods[i];
            if (func == null || !func.is_async) { continue; }
            const assoc: SymbolStr =
                TypeResolutionPasses::async_fut_assoc_name(ctx, func.name);
            if (!assoc.is_valid()) { continue; }
            // A trait may legitimately declare the associated type itself; only
            // synthesize the one that is missing, so an explicit `type ReadFut;`
            // keeps its declaration-site bounds.
            if (node.lookup_assoc_type(assoc) == null) {
                mut adecl: AssocTypeDeclNode* =
                    libc::malloc(sizeof(AssocTypeDeclNode)) as AssocTypeDeclNode*;
                *adecl = AssocTypeDeclNode {
                    name:   assoc,
                    bounds: [],
                    span:   func.span,
                };
                node.add_assoc_type(adecl);
            }
            func.set_resolved_return_type(
                arena.create_assoc_projection(this_ty, assoc, trait_ref));
        }
    }

    /// The projected member (`Item`) of a projection type-annotation, else empty.
    static projection_member_of(ann: TypeAnnotation*) -> SymbolStr {
        if (ann == null) { return SymbolStr::empty(); }
        return match (*ann) {
            TypeAnnotation::Projection(pj) => { pj.member }
            _ => { SymbolStr::empty() }
        };
    }

    /// Whether `ann` is an associated-type projection annotation (`I::Item`).
    static is_projection_annotation(ann: TypeAnnotation*) -> boolean {
        if (ann == null) { return false; }
        return match (*ann) {
            TypeAnnotation::Projection(_) => { true }
            _ => { false }
        };
    }

    /// The registered type a written argument names, off its stamp: a
    /// declaration's type (its template, for an instantiation), a
    /// primitive's.  Invalid for a type parameter, a projection, or a shape
    /// that names no registered type.
    static item_type_of(ann: TypeAnnotation*, ctx: CompilationContext*) -> TypeRef {
        if (ann == null) { return TypeRef::invalid(); }
        return match (*ann) {
            TypeAnnotation::Named(n) => {
                match (n.res.require("type_resolution:item annotation")) {
                    Res::Def(d)    => { ctx.decl_index.type_of_def(d) }
                    Res::PrimTy(p) => { ctx.type_resolver.resolve_primitive(p) }
                    _              => { TypeRef::invalid() }
                }
            }
            TypeAnnotation::Primitive(p) => { ctx.type_resolver.resolve_primitive(p.name) }
            TypeAnnotation::Generic(g)   => { TypeResolutionPasses::item_type_of(g.base, ctx) }
            TypeAnnotation::Reference(r) => { TypeResolutionPasses::item_type_of(r.inner, ctx) }
            TypeAnnotation::Pointer(p)   => { TypeResolutionPasses::item_type_of(p.inner, ctx) }
            _ => { TypeRef::invalid() }
        };
    }

    /// Whether a projection-bounded trait-default method (`min where This::Item:
    /// Ord`) is applicable to THIS impl. Returns false ONLY when the impl's
    /// concrete Item type definitively does not implement a bound trait - the
    /// case that must be filtered so the default's body is never synthesized
    /// (and then type-checked) for it (e.g. `EnumerateIter`/`ZipIter` whose Item
    /// is `Pair`, which is never `Ord`). A SYMBOLIC Item - a bare impl generic
    /// param (`A`), or an `I::Item` projection - is undecidable here and kept;
    /// its applicability is settled at the trait-level symbolic pass or per
    /// monomorphization. `args_ref` is the impl's trait-arg annotations.
    static default_method_applies_to_impl(tfunc: FunctionDeclNode*,
                                          impl_node: ImplBlockNode*,
                                          trait_decl: TraitDeclNode*,
                                          args_ref: &TypeAnnotation*[],
                                          ctx: CompilationContext*) -> boolean {
        if (tfunc == null || impl_node == null || trait_decl == null) { return true; }
        for (mut bi: i64 = 0; bi < tfunc.trait_bounds.length; bi++) {
            const b: TraitBound* = &tfunc.trait_bounds[bi];
            if (!b.has_projection_subject()) { continue; }
            const member: SymbolStr =
                TypeResolutionPasses::projection_member_of(b.subject_type);
            if (!member.is_valid()) { continue; }
            // Position of `member` among the trait's associated types, then in
            // the impl's positional trait-arg list (generic params first).
            mut assoc_idx: i64 = -1;
            for (mut a: i64 = 0; a < trait_decl.assoc_types.length; a++) {
                if (trait_decl.assoc_types[a] != null
                        && trait_decl.assoc_types[a].name.equals(member)) {
                    assoc_idx = a; break;
                }
            }
            if (assoc_idx < 0) { continue; }
            const arg_idx: i64 = trait_decl.generic_params.length + assoc_idx;
            if (arg_idx < 0 || arg_idx >= args_ref.length) { continue; }
            const item_ann: TypeAnnotation* = args_ref[arg_idx];
            if (item_ann == null) { continue; }
            // A symbolic Item - a projection or an impl-declared parameter -
            // names no registered type: keep.
            if (TypeResolutionPasses::is_projection_annotation(item_ann)) { continue; }
            // A concrete Item - its registered type, off the stamp - must
            // implement every bound trait, or the default cannot apply here.
            // Asked of the trait's IDENTITY and the type: a leaf answers for
            // every module's trait and type of that leaf.
            const item_ty: TypeRef = TypeResolutionPasses::item_type_of(item_ann, ctx);
            if (!item_ty.is_valid()) { continue; }
            for (mut ti: i64 = 0; ti < b.trait_refs.length; ti++) {
                const tr: TraitRef* = &b.trait_refs[ti];
                if (tr.path.length == 0) { continue; }
                if (ctx.generic_registry.select_trait_impl(tr.identity(), item_ty, ctx.intern_table) == null) {
                    return false;
                }
            }
        }
        return true;
    }

    /// Positional index of `name` among `node`'s impl-head generic params,
    /// or -1 when it is not one of them.  Used to normalize a generic param
    /// to a position (`#0`) in the coherence key so that two otherwise
    /// identical impls that merely spell the param differently
    /// (`Box<T>` vs `Box<U>`) fold to the same key.
    static impl_param_index(node: ImplBlockNode*, name: SymbolStr) -> i64 {
        if (node == null || !name.is_valid()) { return -1; }
        for (mut i: i64 = 0; i < node.generic_params.length; i++) {
            const gp: GenericParamNode* = node.generic_params[i];
            if (gp != null && gp.name.is_valid() && gp.name.equals(name)) {
                return i;
            }
        }
        return -1;
    }

    /// Canonical key fragment for a type-position NAME.  Resolution order:
    ///   1. an impl-head generic param -> positional `#n` marker;
    ///   2. a name whose stamp names a declaration -> that type's canonical
    ///      id (`#T<id>`), asked of the index by the id, which folds every
    ///      spelling of one type to one key and keeps two same-leaf types of
    ///      different modules apart - a leaf folded by its spelling could do
    ///      neither once two modules declared it; a primitive by its
    ///      spelling, which is its registration key;
    ///   3. otherwise the spelling itself: a projection (`I::Item`), a
    ///      parameter, or a name nothing stamped.  The spelling is never
    ///      looked up: a name the writer's module did not resolve is not one
    ///      the module being compiled may resolve for it.
    static type_name_key(name: SymbolStr, res: Res, node: ImplBlockNode*,
                         ctx: CompilationContext*) -> string {
        const pidx: i64 = TypeResolutionPasses::impl_param_index(node, name);
        if (pidx >= 0) { return fmt::format("#%lld", pidx); }
        const tref: TypeRef = match (res) {
            Res::Def(q)    => { ctx.decl_index.type_of_def(q) }
            Res::PrimTy(n) => { ctx.decl_index.lookup_type(n) }
            _              => { TypeRef::invalid() }
        };
        if (tref.is_valid()) {
            return fmt::format("#T%llu", tref.id);
        }
        return ctx.intern_table.resolve(name);
    }

    /// Render a type annotation to a stable, canonical string for coherence
    /// keying.  Type-position names fold to their resolved type identity
    /// (see `type_name_key`); the impl's own generic params normalize to
    /// positional `#n` markers; everything else renders structurally.
    /// Purely a string identity - never type-checks - so it is safe to call
    /// this early in TypeResolution.
    static ann_canon_key(ann: TypeAnnotation*, node: ImplBlockNode*,
                         ctx: CompilationContext*) -> string {
        if (ann == null) { return "_"; }
        return match (*ann) {
            TypeAnnotation::Primitive(p) => {
                // A keyword primitive carries no slot; its lexeme is read
                // as the name layer would stamp it, an alias keyword
                // (`Feed<int>`) under the primitive's own spelling, so
                // `Feed<int>` and `Feed<i32>` render to one key.
                mut prim: SymbolStr = p.name;
                const canon: string = ResBase::primitive_of_alias(ctx.intern_table.resolve(p.name));
                if (canon.length() > 0) { prim = ctx.intern_table.intern(canon); }
                TypeResolutionPasses::type_name_key(prim, Res::PrimTy(prim), node, ctx)
            }
            TypeAnnotation::Named(n) => {
                // Through the door: every written type-position name is
                // answered - bound, or `Err` for one the name layer refused
                // where it was written - and a slot with no answer is a
                // defect to record, not a spelling to key by silently.
                TypeResolutionPasses::type_name_key(n.name,
                    n.res.require("type_resolution: coherence key name"), node, ctx)
            }
            TypeAnnotation::Generic(g) => {
                mut s: string =
                    TypeResolutionPasses::ann_canon_key(g.base, node, ctx);
                s = s + "<";
                for (mut i: i64 = 0; i < g.args.length; i++) {
                    if (i > 0) { s = s + ","; }
                    s = s + TypeResolutionPasses::ann_canon_key(
                        g.args[i], node, ctx);
                }
                s = s + ">";
                s
            }
            TypeAnnotation::Reference(r) => {
                const pre: string = if (r.is_mutable) { "&mut " } else { "&" };
                pre + TypeResolutionPasses::ann_canon_key(r.inner, node, ctx)
            }
            TypeAnnotation::Pointer(p) => {
                "*" + TypeResolutionPasses::ann_canon_key(p.inner, node, ctx)
            }
            TypeAnnotation::Array(a) => {
                "[" + TypeResolutionPasses::ann_canon_key(a.element, node, ctx)
                    + "]"
            }
            TypeAnnotation::Tuple(t) => {
                mut s: string = "[";
                for (mut i: i64 = 0; i < t.elements.length; i++) {
                    if (i > 0) { s = s + ","; }
                    s = s + TypeResolutionPasses::ann_canon_key(
                        t.elements[i], node, ctx);
                }
                s = s + "]";
                s
            }
            TypeAnnotation::ThisType(_) => { "This" }
            _ => { "_" }
        };
    }

    /// Build the canonical impl-head signature for a trait impl: the
    /// import-resolved trait reference (with type args), the import-resolved
    /// target type (`canonical_target`, with its type args), and the
    /// where-bounds - with the impl's own generic params normalized.  Two
    /// trait impls conflict for coherence if this string is identical.
    /// Bounds are folded in so two impls that differ only by their bounds
    /// (and may be non-overlapping) are NOT treated as duplicates.
    static coherence_key_for(node: ImplBlockNode*,
                             canonical_target: SymbolStr,
                             ctx: CompilationContext*) -> string {
        mut key: string = TypeResolutionPasses::ann_canon_key(
            node.trait_annotation, node, ctx);
        key = key + " for ";
        // Target base by resolved type identity, off the head's own answer.
        // A source head with a key is a stamped head: the name layer answers
        // every written target it can bind, a primitive by its own spelling
        // (`for int` folds to `i32` there, so the two heads collide here),
        // and only a clone - never a source declaration - carries a key
        // with no stamp.
        const head_res: Res = node.res.require("type_resolution: coherence head");
        key = key + TypeResolutionPasses::type_name_key(
            canonical_target, head_res, node, ctx);
        if (node.target_args.length > 0) {
            key = key + "<";
            for (mut i: i64 = 0; i < node.target_args.length; i++) {
                if (i > 0) { key = key + ","; }
                key = key + TypeResolutionPasses::ann_canon_key(
                    node.target_args[i], node, ctx);
            }
            key = key + ">";
        }
        if (node.where_bounds.length > 0) {
            key = key + " where ";
            for (mut i: i64 = 0; i < node.where_bounds.length; i++) {
                const wb: TraitBound* = &node.where_bounds[i];
                const pidx: i64 = TypeResolutionPasses::impl_param_index(
                    node, wb.type_parameter);
                if (pidx >= 0) {
                    key = key + fmt::format("#%lld:", pidx);
                } else {
                    key = key + ctx.intern_table.resolve(wb.type_parameter)
                        + ":";
                }
                for (mut j: i64 = 0; j < wb.trait_refs.length; j++) {
                    if (j > 0) { key = key + "+"; }
                    const tr: TraitRef* = &wb.trait_refs[j];
                    if (tr.path.length > 0) {
                        // The bound's carried identity, never a search for its
                        // leaf. Recovering the qualified name by searching the
                        // program declines as soon as any unrelated
                        // declaration shares the leaf, and two distinct traits
                        // then fold to one key - so two impls differing only in
                        // which module their bound came from rendered
                        // identically and coherence rejected the second.
                        key = key + ctx.intern_table.resolve(tr.identity());
                    }
                    if (tr.type_args.length > 0) {
                        key = key + "<";
                        for (mut k: i64 = 0; k < tr.type_args.length; k++) {
                            if (k > 0) { key = key + ","; }
                            key = key + TypeResolutionPasses::ann_canon_key(
                                tr.type_args[k], node, ctx);
                        }
                        key = key + ">";
                    }
                }
                key = key + ";";
            }
        }
        return key;
    }

    /// Peel a trait annotation down to its underlying GenericAnnotation
    /// node (through Reference/Pointer wrappers), or null when the trait is
    /// non-generic.  Returns the NODE pointer (Copy, non-owning), NOT a copy
    /// of its `args`: callers read `gen.args` in place (member access /
    /// indexing through the pointer) so the node keeps SOLE ownership of the
    /// owning array.  Returning `g.args` by value aliased the field's buffer
    /// into a droppable local, and since `TypeAnnotation*[]` is deep-owning
    /// over its elements, two callers each dropping that alias double-freed
    /// the node's args buffer (and its element nodes).
    static peel_to_generic(ann: TypeAnnotation*) -> GenericAnnotation* {
        if (ann == null) { return null; }
        return match (*ann) {
            TypeAnnotation::Generic(g) => { g }
            TypeAnnotation::Reference(r) => {
                TypeResolutionPasses::peel_to_generic(r.inner)
            }
            TypeAnnotation::Pointer(p) => {
                TypeResolutionPasses::peel_to_generic(p.inner)
            }
            _ => { null }
        };
    }

    /// Clone every default-bodied trait method that `impl_node` doesn't
    /// override. Returns the number of methods added.
    static synthesize_default_trait_methods(impl_node: ImplBlockNode*,
                                             ctx: CompilationContext*) -> i64 {
        if (impl_node == null) { return 0; }
        if (!impl_node.is_trait_impl()) { return 0; }
        if (ctx.generic_registry == null) { return 0; }

        const trait_name: SymbolStr = TypeAnnotation::trait_identity(
            impl_node.trait_annotation);
        if (!trait_name.is_valid()) { return 0; }

        const trait_decl: TraitDeclNode* = ctx.generic_registry.get_trait_decl(trait_name);
        if (trait_decl == null) { return 0; }

        // Quick scan: is there at least one default-bodied trait method
        // not overridden by this impl?  If not, return 0 without doing
        // any allocation.  Most stdlib trait impls hit this path.
        mut needs_synthesis: boolean = false;
        for (mut ti: i64 = 0; ti < trait_decl.methods.length; ti++) {
            const tfunc: FunctionDeclNode* = trait_decl.methods[ti];
            if (tfunc == null) { continue; }
            if (!tfunc.has_body()) { continue; }
            mut overridden: boolean = false;
            for (mut mi: i64 = 0; mi < impl_node.methods.length; mi++) {
                const m: MethodNode* = impl_node.methods[mi];
                if (m != null && m.func != null && m.func.name.equals(tfunc.name)) {
                    overridden = true;
                    break;
                }
            }
            if (!overridden) {
                needs_synthesis = true;
                break;
            }
        }
        if (!needs_synthesis) { return 0; }

        // Map the trait's own generic params onto this impl's trait args so
        // cloned signatures referencing `Item` (etc.) become the concrete
        // arg (`T`, `i32`, `Pair<u64, A>`, ...).  Only meaningful when the
        // arities line up; an arity mismatch is a user error reported
        // elsewhere, so we skip the rewrite and let that path fire.
        // Read the trait args in place through the node; never copy the
        // owning `gen.args` array into a droppable local (double-free).
        // The non-generic case (gen == null) borrows a local empty sentinel
        // so the downstream `&TypeAnnotation*[]` borrow always has a valid
        // referent (it is never iterated when param_names is empty anyway).
        const gen: GenericAnnotation* =
            TypeResolutionPasses::peel_to_generic(impl_node.trait_annotation);
        const empty_args: TypeAnnotation*[] = [];
        const arg_count: i64 = if (gen != null) { gen.args.length } else { 0 };
        const args_ref: &TypeAnnotation*[] =
            if (gen != null) { &gen.args } else { &empty_args };
        mut trait_param_names: SymbolStr[] = [];
        if (arg_count == trait_decl.generic_params.length) {
            for (mut gi: i64 = 0; gi < trait_decl.generic_params.length; gi++) {
                const gp: GenericParamNode* = trait_decl.generic_params[gi];
                if (gp == null) {
                    trait_param_names = [];
                    break;
                }
                trait_param_names.push(gp.name);
            }
        }

        // Clone each not-overridden default method into the impl block.
        // The clones go through the rest of FunctionSignature/TypeResolution/
        // Sema in the same loop, picking up the impl's `this_type` so any
        // `This` annotations resolve to the implementing type.
        mut cloner: ASTCloner = ASTCloner();
        mut synthesized: i64 = 0;

        for (mut ti: i64 = 0; ti < trait_decl.methods.length; ti++) {
            const tfunc: FunctionDeclNode* = trait_decl.methods[ti];
            if (tfunc == null) { continue; }
            if (!tfunc.has_body()) { continue; }

            mut already_present: boolean = false;
            for (mut mi: i64 = 0; mi < impl_node.methods.length; mi++) {
                const m: MethodNode* = impl_node.methods[mi];
                if (m != null && m.func != null && m.func.name.equals(tfunc.name)) {
                    already_present = true;
                    break;
                }
            }
            if (already_present) { continue; }

            // Skip cloning a projection-bounded default (`min`/`max` with
            // `where This::Item: Ord`) into an impl whose CONCRETE Item type
            // definitively lacks the bound trait - e.g. `EnumerateIter`/`ZipIter`
            // yield `Pair`, which is never `Ord`. Without this the default body
            // would be synthesized and then type-checked against a `Pair`
            // receiver (`.compare()`), a spurious E0358. Symbolic Item types
            // (a param `A`, or an `I::Item` projection) are kept and decided
            // later.
            if (!TypeResolutionPasses::default_method_applies_to_impl(
                    tfunc, impl_node, trait_decl, args_ref, ctx)) {
                continue;
            }

            const cloned: FunctionDeclNode* = cloner.clone_func_decl(tfunc);
            if (cloned == null) { continue; }
            cloned.set_synth_default(true);
            // A default whose return mentions `This` (e.g. combinators
            // returning `MapIter<This, ...>`) is self-referential: eagerly
            // instantiating it for an adapter's own impl recurses forever.
            // Flag it (checked on the pre-rewrite annotation) so mono
            // instantiates it lazily, only at call sites.
            if (TypeResolutionPasses::annotation_references_this(
                    tfunc.return_type_annotation)) {
                cloned.set_self_returning_default(true);
            }
            // Rewrite `&This` / `-> This` annotations on the cloned signature
            // to the impl's target. The trait body keeps `ThisType` for
            // generic resolution at trait-sig time; the impl body needs a
            // concrete name so resolution doesn't depend on `ctx.this_type`
            // being set (it isn't for generic impl targets whose decl_index
            // lookup misses).
            // The target name as written after `for`, falling back to the block
            // when the parser stamped no location.  Both name the impl's file,
            // which is what the rewritten annotation needs; the narrower one
            // also points a diagnostic at the type rather than the whole block.
            const this_home_span: SourceSpan =
                if (impl_node.target_type_span.has_location()) {
                    impl_node.target_type_span
                } else {
                    impl_node.span
                };
            TypeResolutionPasses::rewrite_default_method_signature(
                cloned, impl_node.target_type, impl_node.target_args,
                trait_param_names, args_ref, this_home_span, impl_node.res);
            mut method: MethodNode* = new MethodNode(cloned, cloned.span);
            method.set_static(cloned.is_static);
            impl_node.add_method(method);
            synthesized += 1;
        }

        return synthesized;
    }


    // Pass 1: FunctionSignature (order 7)

    /// Resolves function parameter types and return types for all top-level
    /// and method declarations.  Makes function signatures available for
    /// template registration and later type checking.
    static run_function_signature(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        const _modname: string = ctx.artifacts.ast.namespace_name;
        cdebug("[FuncSig] === module='%s' ===\n", _modname);

        if (ctx.debug_mode) {
            cdebug("[FunctionSignature] Resolving function signatures\n");
        }

        // Get required components
        const arena: TypeArena* = ctx.type_arena;
        const resolver: TypeResolver* = ctx.type_resolver;
        if (arena == null || resolver == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "FunctionSignature: type system not initialized");
            return PassResult::failure(1);
        }

        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            return PassResult::ok();
        }

        mut runner: TypeResolutionRunner = TypeResolutionRunner::new(ctx);
        mut sig_count: i64 = 0;

        // Track resolved free-function signatures within this module to
        // reject exact redefinitions (E0206). Overloads differ in their
        // FunctionType, so only same-name + same-signature collides.
        mut seen_fn_names: u32[] = [];
        mut seen_fn_types: u64[] = [];

        // Walk top-level statements
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }
            cdebug("[FuncSig] stmt[%lld] kind=%d\n", i, stmt.kind as i32);

            match (stmt.kind) {
                NodeKind::FunctionDeclaration => {
                    const func: FunctionDeclNode* = stmt as FunctionDeclNode*;
                    mut func_ctx: ResolutionContext = runner.make_generic_context(
                        func.generic_params, &runner.res_ctx);
                    runner.resolve_func_signature(func, &func_ctx);
                    sig_count++;

                    if (func.resolved_return_type.is_valid()) {
                        mut fparams: TypeRef[] = [];
                        for (mut p: i64 = 0; p < func.parameters.length; p++) {
                            const fp: VarDeclNode* = func.parameters[p];
                            if (fp != null && fp.resolved_type.is_valid()) {
                                fparams.push(fp.resolved_type);
                            }
                        }
                        const fsig: TypeRef = arena.get_function(
                            func.resolved_return_type, fparams, func.is_variadic);
                        mut redefined: boolean = false;
                        for (mut k: i64 = 0; k < seen_fn_names.length; k++) {
                            if (seen_fn_names[k] == func.name.id
                                && seen_fn_types[k] == fsig.id) {
                                redefined = true;
                                break;
                            }
                        }
                        if (redefined) {
                            ctx.emit_error_at(ErrorCode::E0206_REDEFINED_FUNCTION,
                                fmt::format("function `%s` is defined multiple times with the same signature",
                                    ctx.resolve_str(func.name)),
                                func.span);
                        } else {
                            seen_fn_names.push(func.name.id);
                            seen_fn_types.push(fsig.id);
                        }
                    }
                }
                NodeKind::StructDeclaration => {
                    const node: StructDeclNode* = stmt as StructDeclNode*;
                    mut struct_ctx: ResolutionContext = runner.make_generic_context(
                        node.generic_params, &runner.res_ctx);
                    const struct_owner: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/struct methods");
                    runner.resolve_method_signatures(node.methods, &struct_ctx, struct_owner,
                        ctx.decl_type_key(node.name, node.binding_namespace, node.span.file));
                    sig_count += node.methods.length;
                }
                NodeKind::UnionDeclaration => {
                    const node: UnionDeclNode* = stmt as UnionDeclNode*;
                    mut union_ctx: ResolutionContext = runner.make_generic_context(
                        node.generic_params, &runner.res_ctx);
                    const union_owner: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/union methods");
                    runner.resolve_method_signatures(node.methods, &union_ctx, union_owner,
                        ctx.decl_type_key(node.name, node.binding_namespace, node.span.file));
                    sig_count += node.methods.length;
                }
                NodeKind::ClassDeclaration => {
                    const node: ClassDeclNode* = stmt as ClassDeclNode*;
                    mut class_ctx: ResolutionContext = runner.make_generic_context(
                        node.generic_params, &runner.res_ctx);
                    const class_owner: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/class methods");
                    runner.resolve_method_signatures(node.methods, &class_ctx, class_owner,
                        ctx.decl_type_key(node.name, SymbolStr::empty(), node.span.file));
                    sig_count += node.methods.length;
                }
                NodeKind::TraitDeclaration => {
                    const node: TraitDeclNode* = stmt as TraitDeclNode*;

                    if (ctx.generic_registry != null) {
                        // The import-resolved name is the declaration's
                        // identity - the leaf cannot say, since a user trait
                        // may share it.  Whether it IS the language's
                        // `Copy`/`Drop`/... was claimed when the identity was
                        // minted (the type-declaration stage).
                        const trait_id: SymbolStr = ctx.decl_type_key(node.name, SymbolStr::empty(), node.span.file);
                        ctx.generic_registry.register_trait_decl(trait_id, node);
                    }

                    mut trait_ctx: ResolutionContext = runner.make_generic_context(
                        node.generic_params, &runner.res_ctx);
                    runner.resolve_trait_method_signatures(node.methods, &trait_ctx);
                    // Final for traits: `run_type_resolution` re-resolves impl
                    // and inline method signatures, but not a trait's own.
                    // Before the async desugar below, so an `async` method is
                    // judged on the Output its annotation spells rather than on
                    // the future projection that replaces it.
                    runner.emit_trait_method_signature_diagnostics(node.methods);
                    // Rewrite each `async` method's resolved return to its
                    // implicit `This::<Method>Fut` projection AFTER the ordinary
                    // resolution, so callers see the future type while the
                    // annotation still spells the Output for impl-side lowering.
                    // Must precede the `required_methods` population below,
                    // which snapshots these signatures onto the TraitType.
                    const tr_ref: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/trait populate");
                    TypeResolutionPasses::desugar_async_trait_methods(node, ctx, arena, tr_ref);
                    sig_count += node.methods.length;

                    // Populate the TraitType's required_methods array so the
                    // bound-aware-dispatch path in sema can read trait method
                    // signatures off the arena type. Without this, every
                    // BoundedParamType receiver call has to fall back to
                    // brittle name-only lookups in the DeclarationIndex.
                    const tr_t: Type* = if (tr_ref.is_valid()) {
                        arena.lookup(tr_ref.id)
                    } else { null };
                    if (tr_t != null && tr_t.kind == TypeKind::Trait) {
                        mut tr_type: TraitType* = tr_t as TraitType*;
                        // Register associated-type members (`type Item;`) so the
                        // projection resolver and the positional-sugar desugar
                        // can see which member names this trait declares and how
                        // many it has.
                        for (mut ai: i64 = 0; ai < node.assoc_types.length; ai++) {
                            const adecl: AssocTypeDeclNode* = node.assoc_types[ai];
                            if (adecl != null) { tr_type.add_assoc_type(adecl.name); }
                        }
                        // `MethodInfo.param_types` is by contract the NON-SELF
                        // parameters, which is what every reader matches against
                        // an argument count. Keeping the receiver here made an
                        // instance trait method look like it took one parameter
                        // too many, so a call on a bounded or where-bounded
                        // receiver found no signature and left its arguments
                        // unclassified. Same receiver spellings the struct and
                        // class method tables filter on.
                        const tr_this_amp: SymbolStr = ctx.intern_table.intern("&this");
                        const tr_this_val: SymbolStr = ctx.intern_table.intern("this");
                        for (mut mi: i64 = 0; mi < node.methods.length; mi++) {
                            const tfunc: FunctionDeclNode* = node.methods[mi];
                            if (tfunc == null) { continue; }
                            mut param_types: TypeRef[] = [];
                            for (mut p: i64 = 0; p < tfunc.parameters.length; p++) {
                                const param: VarDeclNode* = tfunc.parameters[p];
                                if (param == null) { continue; }
                                if (param.name.equals(tr_this_amp)) { continue; }
                                if (param.name.equals(tr_this_val)) { continue; }
                                if (param.resolved_type.is_valid()) {
                                    param_types.push(param.resolved_type);
                                }
                            }
                            const fn_ty: TypeRef = arena.get_function(
                                tfunc.resolved_return_type, param_types,
                                tfunc.is_variadic);
                            mut info: MethodInfo = MethodInfo::new(
                                tfunc.name, fn_ty, true, tfunc.is_static);
                            info.param_types = param_types;
                            tr_type.add_required_method(info);
                        }
                    }
                }
                NodeKind::ImplementationBlock => {
                    const node: ImplBlockNode* = stmt as ImplBlockNode*;

                    const _added: i64 = TypeResolutionPasses::synthesize_default_trait_methods(
                        node, ctx);

                    const _tgt: string = ctx.intern_table.resolve(node.target_type);
                    cdebug("[FuncSig] impl block: target='%s' methods.length=%lld node=%p\n",
                           _tgt, node.methods.length, node);
                    for (mut mi: i64 = 0; mi < node.methods.length; mi++) {
                        const _m: MethodNode* = node.methods[mi];
                        if (_m == null) {
                            cdebug("[FuncSig]   method[%lld]=NULL\n", mi);
                        } else {
                            cdebug("[FuncSig]   method[%lld]=%p func=%p\n",
                                   mi, _m, _m.func);
                        }
                    }
                    mut impl_ctx: ResolutionContext = runner.make_generic_context(
                        node.generic_params, &runner.res_ctx);
                    // Trait impls: bind the trait's outer generic params to
                    // the impl's trait args (e.g. `Item -> T` for an
                    // `implement<T> Iterator<T> for Bar<T>`).  Cloned
                    // default-method bodies reference these names through
                    // the trait's signature; without this binding, those
                    // references resolve to invalid TypeRefs and the
                    // mangler downstream produces a junk symbol with a
                    // hole where `Item` should be.
                    runner.bind_trait_args_for_impl(node, &impl_ctx);
                    // Stage-5 diagnostics: flag an unbound associated type
                    // (E0309) or a positional assoc binding on a trait that
                    // also has generic params (E0310).  Runs once per
                    // source-level impl here in the FuncSig phase.
                    runner.validate_impl_assoc_bindings(node);
                    // The owner type and its canonical name, off the head's
                    // stamp.  A spelling qualified by the WRITER's module
                    // names the type only when the writer declared it: a
                    // trait implemented for another module's type
                    // (`implement trait Display for Str` in `fmt::display`)
                    // has no owner under that key, and its methods then
                    // resolve with no receiver type to back-fill and no
                    // `This` to bind.
                    runner.resolve_method_signatures(node.methods, &impl_ctx,
                        ctx.decl_index.impl_owner(node, "type_resolution/impl methods"), node.target_key(runner.arena));
                    sig_count += node.methods.length;
                }
                NodeKind::ExternBlock => {
                    const node: ExternBlockNode* = stmt as ExternBlockNode*;
                    for (mut j: i64 = 0; j < node.functions.length; j++) {
                        const fn_node: FunctionDeclNode* = node.functions[j];
                        runner.resolve_func_signature(fn_node, &runner.res_ctx);

                        if (fn_node.resolved_return_type.is_valid()) {
                            // Collect resolved param types
                            mut ext_params: TypeRef[] = [];
                            for (mut p: i64 = 0; p < fn_node.parameters.length; p++) {
                                const param: VarDeclNode* = fn_node.parameters[p];
                                if (param != null && param.resolved_type.is_valid()) {
                                    ext_params.push(param.resolved_type);
                                }
                            }

                            // Create FunctionType in the arena
                            const func_type_ref: TypeRef = arena.get_function(
                                fn_node.resolved_return_type, ext_params, fn_node.is_variadic);

                            // The LLVM symbol an extern function resolves to: its
                            // bare C name, UNLESS a function-level `![symbol("sym")]`
                            // pins a different linker symbol (the C++ binding
                            // generator pins the Itanium mangled name).  Read from
                            // the parsed directive (DirectiveProcessing, which sets
                            // `has_link_name`, runs LATER than this pass), and
                            // registered as the DI mangled name so EVERY module - 
                            // declaring and consuming - emits the same symbol,
                            // making the override work across the module boundary.
                            const ext_link_str: string = fn_node.link_directive_symbol();
                            const ext_link_sym: SymbolStr = if (ext_link_str.length() > 0) {
                                ctx.intern_table.intern(ext_link_str)
                            } else {
                                fn_node.name
                            };

                            // The declaration is registered under its own key -
                            // its name under the module that declares it, as
                            // any free function's: the alias's module for a C
                            // import (`<mod>::cit::add3`, the namespace the
                            // alias's stamp names), the writing module for a
                            // plain extern block - and the C name is its
                            // SYMBOL, never a key: a bare leaf shared by every
                            // extern block declaring that C name could only
                            // hold one of them, and a call pinned by the
                            // symbol alone could not say which declaration it
                            // meant.  A call binds the declaration its stamp
                            // names and is emitted at that declaration's
                            // signature.
                            const ext_q_name: SymbolStr = if (node.is_c_import()) {
                                ctx.qualify_binding_sym(fn_node.name, node.binding_namespace)
                            } else {
                                ctx.decl_fn_key(fn_node.name, fn_node.span.file)
                            };
                            // Two extern blocks declaring one C name with
                            // DIFFERENT Cryo signatures is an ABI hazard the
                            // program carries whichever one a call names - at
                            // most one of them matches the C definition - and
                            // is reported once, at the later declaration.  An
                            // identical redeclaration (two modules each writing
                            // the libc prototype they need) shares the interned
                            // function type and says nothing.
                            const clash_key: SymbolStr =
                                ctx.decl_index.extern_symbol_conflict(ext_link_sym, func_type_ref);
                            if (clash_key.is_valid()) {
                                const sym_str: string = ctx.intern_table.resolve(fn_node.name);
                                mut wdiag: Diagnostic = Diagnostic::warning(
                                    ErrorCode::W0011_DUPLICATE_EXTERN_SYMBOL,
                                    fmt::format("extern C symbol `%s` is declared in more than one extern block with different signatures; a call binds the declaration it names, and at most one of them matches the C definition",
                                        sym_str));
                                wdiag = wdiag.at_with_label(fn_node.span,
                                    "duplicate extern declaration here");
                                wdiag = wdiag.help(fmt::format("also declared as `%s`; make the two signatures agree, or remove one",
                                    ctx.intern_table.resolve(clash_key)));
                                ctx.emit_diagnostic(wdiag);
                            }
                            // The LLVM symbol is written on the overload entry
                            // as well as the key's slot: codegen resolves a
                            // pinned declaration through the entry registered
                            // under it, an extern's as any other function's.
                            fn_node.set_overload_entry(ctx.decl_index.register_function_signature(
                                ext_q_name, fn_node.resolved_return_type, func_type_ref,
                                ctx.intern_table, arena, ext_link_sym,
                                if (fn_node.has_name_span()) { fn_node.name_span } else { fn_node.span }));
                            ctx.decl_index.note_extern_symbol(ext_link_sym, ext_q_name, func_type_ref);
                            // An imported function is a declaration of this
                            // module and takes its written visibility, as a
                            // free function does: a `private` one is not
                            // callable by qualified path from another module.
                            // A C import's prototypes are its alias module's
                            // public declarations - the alias exists to be
                            // reached through, and the name layer declares
                            // them so - whatever the block's text wrote.
                            ctx.decl_index.set_decl_visibility(ext_q_name,
                                node.is_c_import() || fn_node.is_public);
                        }
                    }
                    sig_count += node.functions.length;
                }
                NodeKind::IntrinsicDeclaration => {
                    const node: IntrinsicDeclNode* = stmt as IntrinsicDeclNode*;
                    // Resolve parameter types
                    for (mut j: i64 = 0; j < node.parameters.length; j++) {
                        const param: VarDeclNode* = node.parameters[j];
                        if (param != null && param.type_annotation != null &&
                            !param.resolved_type.is_valid()) {
                            const ptype: TypeRef = resolver.resolve(param.type_annotation, &runner.res_ctx);
                            if (ptype.is_valid()) {
                                param.resolved_type = ptype;
                            }
                        }
                    }
                    // Resolve return type and register in DeclarationIndex
                    if (node.return_type_annotation != null && !node.has_resolved_return_type()) {
                        const rtype: TypeRef = resolver.resolve(node.return_type_annotation, &runner.res_ctx);
                        if (rtype.is_valid()) {
                            node.set_resolved_return_type(rtype);
                        }
                    }

                    if (node.has_resolved_return_type()) {
                        // Build FunctionType for full signature.
                        mut i_param_types: TypeRef[] = [];
                        for (mut pi: i64 = 0; pi < node.parameters.length; pi++) {
                            const ip: VarDeclNode* = node.parameters[pi];
                            if (ip.resolved_type.is_valid()) {
                                i_param_types.push(ip.resolved_type);
                            }
                        }
                        const i_func_type_ref: TypeRef = arena.get_function(
                            node.resolved_return_type, i_param_types, node.is_variadic);

                        // Register under the qualified name so cross-module
                        // externs pick up intrinsics.
                        const q_name: SymbolStr = ctx.decl_fn_key(node.name, node.span.file);
                        // Intrinsics use C linkage; their LLVM symbol is the
                        // bare function name, not the qualified/mangled form.
                        ctx.decl_index.register_function_signature(
                            q_name, node.resolved_return_type, i_func_type_ref, ctx.intern_table, arena,
                            node.name, node.span);

                        // The leaf is recorded as an intrinsic's - codegen's
                        // inline decision reads it - and is a key nowhere: a
                        // bare `malloc` with no declaration in scope is an
                        // error, and the intrinsic is reached as
                        // `intrinsics::malloc` like every declaration.
                        ctx.decl_index.note_intrinsic(node.name, q_name);
                        // Intrinsics are always public (IntrinsicDeclNode
                        // carries no visibility); record it explicitly so
                        // the verdict is stated rather than inherited from
                        // `is_candidate_public`'s permissive default.
                        ctx.decl_index.set_decl_visibility(q_name, true);
                    }
                    sig_count++;
                }
                NodeKind::IntrinsicConstDeclaration => {
                    const ic_node: IntrinsicConstDeclNode* = stmt as IntrinsicConstDeclNode*;
                    if (ic_node.type_annotation != null && !ic_node.has_resolved_type()) {
                        const ic_type: TypeRef = resolver.resolve(ic_node.type_annotation, &runner.res_ctx);
                        if (ic_type.is_valid()) {
                            ic_node.set_resolved_type(ic_type);
                            // Register as a global so sema's lookup_global_var finds it
                            const ic_mod_sym: SymbolStr = ctx.intern(ctx.source_file);
                            mut ic_ns: SymbolStr = SymbolStr::empty();
                            const ic_key: SymbolStr = ctx.decl_global_key(
                                ic_node.name, SymbolStr::empty(), ic_node.span.file, &ic_ns);
                            ctx.decl_index.register_global_with_module(
                                ic_key, ic_type, ic_mod_sym, ic_ns, false);
                        }
                    }
                }
                _ => {
                    // Not a declaration with function signatures
                }
            }
        }

        if (ctx.debug_mode) {
            cdebug("[FunctionSignature] Resolved %lld function signatures\n", sig_count);
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }


    // Pass 2: TypeResolution (order 9)

    /// Resolves ALL remaining type annotations in the AST.
    /// Phase 1: Type aliases
    /// Phase 2: Struct/class field types
    /// Phase 3: Variable and expression types in function bodies
    /// Phase 4: Register declarations in the DeclarationIndex
    static run_type_resolution(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        if (ctx.debug_mode) {
            cdebug("[TypeResolution] Resolving all remaining type annotations\n");
        }

        const arena: TypeArena* = ctx.type_arena;
        const resolver: TypeResolver* = ctx.type_resolver;
        if (arena == null || resolver == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "TypeResolution: type system not initialized");
            return PassResult::failure(1);
        }

        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            return PassResult::ok();
        }

        mut runner: TypeResolutionRunner = TypeResolutionRunner::new(ctx);

        // -- Phase 1: Type alias resolution ----------------------------------
        mut alias_count: i64 = 0;
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }

            if (stmt.kind == NodeKind::TypeAliasDeclaration) {
                const node: TypeAliasDeclNode* = stmt as TypeAliasDeclNode*;
                // Skip generic aliases; resolved during instantiation
                if (node.is_generic()) { continue; }

                if (node.target_annotation != null && !node.has_resolved_target()) {
                    const target: TypeRef = resolver.resolve(node.target_annotation, &runner.res_ctx);
                    if (target.is_valid()) {
                        node.resolved_target = target;
                        // Update the TypeAliasType in the arena with the resolved target
                        const alias_ref: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/alias target");
                        if (alias_ref.is_valid()) {
                            const alias_ty: Type* = runner.arena.lookup(alias_ref.id);
                            if (alias_ty != null && alias_ty.kind == TypeKind::TypeAlias) {
                                const alias_obj: TypeAliasType* = alias_ty as TypeAliasType*;
                                alias_obj.set_target(target);
                            }
                        }
                        alias_count++;
                    } else {
                        runner.emit_undefined_type(node.target_annotation,
                            "target type", ctx.resolve_str(node.alias_name), node.span);
                    }
                }
            }
        }

        if (ctx.debug_mode) {
            cdebug("[TypeResolution] Phase 1: Resolved %lld type aliases\n", alias_count);
        }

        // -- Phase 2: Declaration field types --------------------------------
        mut field_count: i64 = 0;
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }

            match (stmt.kind) {
                NodeKind::StructDeclaration => {
                    const node: StructDeclNode* = stmt as StructDeclNode*;
                    mut struct_ctx: ResolutionContext = runner.make_generic_context(
                        node.generic_params, &runner.res_ctx);
                    runner.resolve_fields(node.fields, &struct_ctx);
                    field_count += node.fields.length;
                    // Re-resolve the inline methods' signatures now that the
                    // owner type exists in the arena.  The DeclarationCollection
                    // FunctionSignature pass ran before this type was registered,
                    // so its owner lookup was invalid and a by-value `this`
                    // receiver (which carries no annotation) was left without a
                    // resolved_type.  Impl-block methods are repaired by the
                    // ImplementationBlock branch below; inline methods need the
                    // same repair here, or a consuming method (`fn m(mut this)`)
                    // reaches drop-insertion with an unresolved receiver and its
                    // by-value `this` is never dropped - a leak on every call.
                    runner.resolve_inline_method_signatures(
                        ctx.decl_type_key(node.name, node.binding_namespace, node.span.file),
                        node.methods, &struct_ctx);
                    runner.emit_method_signature_diagnostics(node.methods);
                }
                NodeKind::UnionDeclaration => {
                    const node: UnionDeclNode* = stmt as UnionDeclNode*;
                    mut union_ctx: ResolutionContext = runner.make_generic_context(
                        node.generic_params, &runner.res_ctx);
                    runner.resolve_fields(node.fields, &union_ctx);
                    field_count += node.fields.length;
                    runner.resolve_inline_method_signatures(
                        ctx.decl_type_key(node.name, node.binding_namespace, node.span.file),
                        node.methods, &union_ctx);
                    runner.emit_method_signature_diagnostics(node.methods);
                }
                NodeKind::ClassDeclaration => {
                    const node: ClassDeclNode* = stmt as ClassDeclNode*;
                    mut class_ctx: ResolutionContext = runner.make_generic_context(
                        node.generic_params, &runner.res_ctx);
                    runner.resolve_fields(node.fields, &class_ctx);
                    field_count += node.fields.length;
                    runner.resolve_inline_method_signatures(
                        ctx.decl_type_key(node.name, SymbolStr::empty(), node.span.file),
                        node.methods, &class_ctx);
                    runner.emit_method_signature_diagnostics(node.methods);
                }
                NodeKind::ImplementationBlock => {
                    const node: ImplBlockNode* = stmt as ImplBlockNode*;
                    mut impl_ctx: ResolutionContext = runner.make_generic_context(
                        node.generic_params, &runner.res_ctx);
                    // Mirror the FunctionSignature pass's trait-arg
                    // binding so the second-pass resolution of method
                    // signatures sees the same scope.  (This pass picks
                    // up any param annotations missed by the first pass
                    // without the trait-arg bindings here, we'd
                    // re-introduce the same `Item` lookup miss this
                    // resolution is meant to repair.)
                    runner.bind_trait_args_for_impl(node, &impl_ctx);
                    // An impl head names one trait outright, and nothing else
                    // reports a head whose trait resolves to nothing: every
                    // consumer reads `trait_identity` and returns quietly when
                    // it answers empty.  A misspelled trait therefore reached a
                    // later stage as a missing `Res` - an internal error naming
                    // no source location - instead of as a name its author can
                    // fix.  The head's own name is asked here, where the type
                    // index is populated and the same unresolved-name
                    // diagnostic every other annotation gets is already built.
                    if (node.is_trait_impl()) {
                        const trait_base: TypeAnnotation* =
                            TypeAnnotation::head_base(node.trait_annotation);
                        if (trait_base != null
                                && !resolver.resolve(trait_base,
                                                     &impl_ctx).is_valid()) {
                            runner.emit_undefined_type(trait_base,
                                "trait", ctx.resolve_str(node.target_type), node.span);
                        }
                    }
                    // The owner and its name off the stamp, as in the FuncSig
                    // phase above.
                    runner.resolve_method_signatures(node.methods, &impl_ctx,
                        ctx.decl_index.impl_owner(node, "type_resolution/impl methods"), node.target_key(runner.arena));
                    runner.emit_method_signature_diagnostics(node.methods);
                }
                _ => {
                    // Enum variant associated types (now TypeAnnotation*) are resolved
                    // during monomorphization for generic enums.  Non-generic enums'
                    // variant types are resolved by sema when type-checking match arms.
                }
            }
        }

        if (ctx.debug_mode) {
            cdebug("[TypeResolution] Phase 2: Resolved %lld field types\n", field_count);
        }

        // -- Phase 3: Variable and expression types in function bodies -------
        mut body_count: i64 = 0;
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }

            match (stmt.kind) {
                NodeKind::FunctionDeclaration => {
                    const func: FunctionDeclNode* = stmt as FunctionDeclNode*;
                    if (func.body != null && !func.is_generic()) {
                        runner.resolve_var_types_in_statement(func.body as ASTNode*, &runner.res_ctx);
                        body_count++;
                    }
                }
                NodeKind::StructDeclaration => {
                    const node: StructDeclNode* = stmt as StructDeclNode*;
                    if (!node.is_generic()) {
                        for (mut j: i64 = 0; j < node.methods.length; j++) {
                            const method: MethodNode* = node.methods[j];
                            if (method != null && method.func != null && method.func.body != null) {
                                // Method-level generics (`Layout::array<T>(n)`)
                                // must be in scope when the walker reaches a
                                // `mut x: T = ...` body annotation; without
                                // the binding, the resolver returns invalid
                                // and `emit_undefined_type` fires E0203 on a
                                // perfectly legal generic param.
                                mut m_ctx: ResolutionContext = runner.make_generic_context(
                                    method.func.generic_params, &runner.res_ctx);
                                runner.resolve_var_types_in_statement(
                                    method.func.body as ASTNode*, &m_ctx);
                                body_count++;
                            }
                        }
                    }
                }
                NodeKind::UnionDeclaration => {
                    const node: UnionDeclNode* = stmt as UnionDeclNode*;
                    if (!node.is_generic()) {
                        for (mut j: i64 = 0; j < node.methods.length; j++) {
                            const method: MethodNode* = node.methods[j];
                            if (method != null && method.func != null && method.func.body != null) {
                                mut m_ctx: ResolutionContext = runner.make_generic_context(
                                    method.func.generic_params, &runner.res_ctx);
                                runner.resolve_var_types_in_statement(
                                    method.func.body as ASTNode*, &m_ctx);
                                body_count++;
                            }
                        }
                    }
                }
                NodeKind::ClassDeclaration => {
                    const node: ClassDeclNode* = stmt as ClassDeclNode*;
                    if (!node.is_generic()) {
                        for (mut j: i64 = 0; j < node.methods.length; j++) {
                            const method: MethodNode* = node.methods[j];
                            if (method != null && method.func != null && method.func.body != null) {
                                mut m_ctx: ResolutionContext = runner.make_generic_context(
                                    method.func.generic_params, &runner.res_ctx);
                                runner.resolve_var_types_in_statement(
                                    method.func.body as ASTNode*, &m_ctx);
                                body_count++;
                            }
                        }
                    }
                }
                NodeKind::TraitDeclaration => {
                    const node: TraitDeclNode* = stmt as TraitDeclNode*;
                    if (!node.is_generic()) {
                        for (mut j: i64 = 0; j < node.methods.length; j++) {
                            const func: FunctionDeclNode* = node.methods[j];
                            if (func != null && func.body != null) {
                                mut m_ctx: ResolutionContext = runner.make_generic_context(
                                    func.generic_params, &runner.res_ctx);
                                runner.resolve_var_types_in_statement(
                                    func.body as ASTNode*, &m_ctx);
                                body_count++;
                            }
                        }
                    }
                }
                NodeKind::ImplementationBlock => {
                    const node: ImplBlockNode* = stmt as ImplBlockNode*;
                    if (!node.is_generic()) {
                        // Build the per-impl context that mirrors what
                        // FunctionSignature uses: the impl's own `<T, ...>`
                        // plus the trait's outer params bound to the
                        // impl's trait args (so the trait's `Item`
                        // resolves to the impl's concrete `T`).
                        // `synthesize_default_trait_methods` may have
                        // cloned default methods (e.g. `fold<Acc>` from
                        // `Iterator<Item>`); their bodies reference both
                        // the trait's `Item` and the method's own `Acc`,
                        // so all three layers must be pushed before the
                        // body walk to avoid spurious E0203.
                        mut impl_ctx: ResolutionContext = runner.make_generic_context(
                            node.generic_params, &runner.res_ctx);
                        runner.bind_trait_args_for_impl(node, &impl_ctx);
                        for (mut j: i64 = 0; j < node.methods.length; j++) {
                            const method: MethodNode* = node.methods[j];
                            if (method != null && method.func != null && method.func.body != null) {
                                mut m_ctx: ResolutionContext = runner.make_generic_context(
                                    method.func.generic_params, &impl_ctx);
                                runner.resolve_var_types_in_statement(
                                    method.func.body as ASTNode*, &m_ctx);
                                body_count++;
                            }
                        }
                    }
                }
                _ => {}
            }
        }

        if (ctx.debug_mode) {
            cdebug("[TypeResolution] Phase 3: Walked %lld function bodies\n", body_count);
        }

        // -- Phase 3b: Collect generic function call instantiations ----------
        // Scan non-generic function bodies for calls like identity<int>(100).
        // For each, resolve the generic args and register an InstantiatedType
        // so the Monomorphizer can discover and specialize the function.
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }

            match (stmt.kind) {
                NodeKind::FunctionDeclaration => {
                    const func: FunctionDeclNode* = stmt as FunctionDeclNode*;
                    if (func.body != null && !func.is_generic()) {
                        runner.collect_generic_fn_calls_in_stmt(func.body as ASTNode*, &runner.res_ctx);
                    }
                }
                NodeKind::StructDeclaration => {
                    const node: StructDeclNode* = stmt as StructDeclNode*;
                    if (!node.is_generic()) {
                        for (mut j: i64 = 0; j < node.methods.length; j++) {
                            const method: MethodNode* = node.methods[j];
                            if (method != null && method.func != null && method.func.body != null) {
                                runner.collect_generic_fn_calls_in_stmt(method.func.body as ASTNode*, &runner.res_ctx);
                            }
                        }
                    }
                }
                NodeKind::UnionDeclaration => {
                    const node: UnionDeclNode* = stmt as UnionDeclNode*;
                    if (!node.is_generic()) {
                        for (mut j: i64 = 0; j < node.methods.length; j++) {
                            const method: MethodNode* = node.methods[j];
                            if (method != null && method.func != null && method.func.body != null) {
                                runner.collect_generic_fn_calls_in_stmt(method.func.body as ASTNode*, &runner.res_ctx);
                            }
                        }
                    }
                }
                NodeKind::ClassDeclaration => {
                    const node: ClassDeclNode* = stmt as ClassDeclNode*;
                    if (!node.is_generic()) {
                        for (mut j: i64 = 0; j < node.methods.length; j++) {
                            const method: MethodNode* = node.methods[j];
                            if (method != null && method.func != null && method.func.body != null) {
                                runner.collect_generic_fn_calls_in_stmt(method.func.body as ASTNode*, &runner.res_ctx);
                            }
                        }
                    }
                }
                NodeKind::ImplementationBlock => {
                    const node: ImplBlockNode* = stmt as ImplBlockNode*;
                    if (!node.is_generic()) {
                        for (mut j: i64 = 0; j < node.methods.length; j++) {
                            const method: MethodNode* = node.methods[j];
                            if (method != null && method.func != null && method.func.body != null) {
                                runner.collect_generic_fn_calls_in_stmt(method.func.body as ASTNode*, &runner.res_ctx);
                            }
                        }
                    }
                }
                _ => {}
            }
        }

        // -- Phase 4: Register declarations in the DeclarationIndex, and
        //    resolve and register top-level global variables
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }

            // Register in DeclarationIndex (shared logic with Specialization).
            TypeResolutionPasses::register_decl_in_index(stmt, ctx, true);

            match (stmt.kind) {
                NodeKind::VariableDeclaration => {
                    // Phase 4-specific: resolve and register top-level global variables
                    const var_node: VarDeclNode* = stmt as VarDeclNode*;
                    // A module-level initializer is folded to the constant that
                    // is emitted, so a `sizeof` in it needs its operand resolved
                    // for the same reason a `static_assert` does. Without it the
                    // fold declines, and declining publishes 0 as the value.
                    TypeResolutionPasses::resolve_const_operand_types(
                        var_node.initializer, resolver, &runner.res_ctx);
                    if (var_node.type_annotation != null && !var_node.resolved_type.is_valid()) {
                        const vtype: TypeRef = resolver.resolve(var_node.type_annotation, &runner.res_ctx);
                        if (vtype.is_valid()) {
                            var_node.resolved_type = vtype;
                        }
                    }
                    if (var_node.resolved_type.is_valid()) {
                        const gmod_sym: SymbolStr = ctx.intern(ctx.source_file);
                        // The declaration's own registration key: a C-imported
                        // global (an anonymous-enum constant) is reachable ONLY
                        // as `cit::NAME` under the alias namespace, never bare
                        // (a bare key would shadow same-leaf globals in other
                        // modules - the same rule as the struct/enum decls;
                        // sema's scope-resolution visit probes the qualified
                        // key and codegen mangles the symbol under the alias).
                        // Any other is its leaf under the writing module's
                        // namespace.
                        mut g_ns: SymbolStr = SymbolStr::empty();
                        const g_key: SymbolStr = ctx.decl_global_key(
                            var_node.name, var_node.binding_namespace, var_node.span.file, &g_ns);
                        ctx.decl_index.register_global_with_module(
                            g_key, var_node.resolved_type, gmod_sym, g_ns,
                            var_node.is_thread_local);
                        TypeResolutionRunner::record_extern_symbol(ctx, var_node, g_key, g_ns);
                    }
                }
                _ => {}
            }
        }

        // Resolve the `sizeof`/`alignof` operand types inside module-scope
        // `static_assert(...)` conditions. These live in a side list (not the
        // statement stream), so the normal expression resolver never visits
        // them; resolve them here while the module's resolution context is set
        // up. TypeLowering later folds the condition once layouts are known.
        for (mut si: i64 = 0; si < root.static_asserts.length; si++) {
            const sa: StaticAssertItem* = root.static_asserts[si];
            if (sa == null) { continue; }
            TypeResolutionPasses::resolve_const_operand_types(
                sa.cond as ExpressionNode*, resolver, &runner.res_ctx);
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }

    /// Recursively resolve the `sizeof`/`alignof` operand type annotations in a
    /// compile-time constant expression, so the folder can read their sizes.
    /// Only the node kinds a constant expression can contain are walked;
    /// everything else is left untouched (the folder rejects anything
    /// non-constant).
    ///
    /// Both positions that hold such an expression need this and neither is
    /// reached by the ordinary expression resolver: a `static_assert` condition
    /// lives in a side list, and a module-level initializer is walked by sema,
    /// which types the `sizeof` EXPRESSION rather than its operand.
    ///
    /// A named constant and an enum variant need nothing resolved here: the
    /// folder reads both from the constant table by name.
    static resolve_const_operand_types(expr: ExpressionNode*, resolver: TypeResolver*,
                                       res_ctx: ResolutionContext*) -> void {
        if (expr == null) { return; }
        const node: ASTNode* = expr as ASTNode*;
        if (node.kind == NodeKind::CastExpression) {
            const c: CastExprNode* = expr as CastExprNode*;
            TypeResolutionPasses::resolve_const_operand_types(c.expression, resolver, res_ctx);
            return;
        }
        if (node.kind == NodeKind::SizeofExpression) {
            const s: SizeofExprNode* = expr as SizeofExprNode*;
            if (s.type_ann != null) {
                s.set_operand_type(resolver.resolve(s.type_ann, res_ctx));
            }
            return;
        }
        if (node.kind == NodeKind::AlignofExpression) {
            const a: AlignofExprNode* = expr as AlignofExprNode*;
            if (a.type_ann != null) {
                a.set_operand_type(resolver.resolve(a.type_ann, res_ctx));
            }
            return;
        }
        if (node.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = expr as UnaryExprNode*;
            TypeResolutionPasses::resolve_const_operand_types(u.operand, resolver, res_ctx);
            return;
        }
        if (node.kind == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = expr as BinaryExprNode*;
            TypeResolutionPasses::resolve_const_operand_types(b.left, resolver, res_ctx);
            TypeResolutionPasses::resolve_const_operand_types(b.right, resolver, res_ctx);
            return;
        }
    }


    // Pass 3: StructFieldTypeSync (order 10)

    /// Syncs resolved field types from AST FieldDeclNode nodes back to
    /// StructType/ClassType FieldInfo[] arrays in the TypeArena.
    static run_struct_field_sync(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        if (ctx.debug_mode) {
            cdebug("[StructFieldTypeSync] Syncing resolved field types to arena types\n");
        }

        const arena: TypeArena* = ctx.type_arena;
        if (arena == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "StructFieldTypeSync: type system not initialized");
            return PassResult::failure(1);
        }

        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            return PassResult::ok();
        }

        mut struct_count: i64 = 0;
        mut class_count: i64 = 0;

        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }

            match (stmt.kind) {
                NodeKind::StructDeclaration => {
                    const node: StructDeclNode* = stmt as StructDeclNode*;
                    if (node.is_generic()) { continue; }

                    const type_ref: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/struct field sync");
                    if (!type_ref.is_valid()) { continue; }

                    const base_type: Type* = arena.lookup(type_ref.id);
                    if (base_type == null || base_type.kind != TypeKind::Struct) { continue; }

                    mut st: StructType* = base_type as StructType*;
                    mut field_infos: FieldInfo[] = [];
                    for (mut j: i64 = 0; j < node.fields.length; j++) {
                        const field: FieldDeclNode* = node.fields[j];
                        if (field == null) { continue; }
                        // An unresolved field type must never be baked into the
                        // arena: TypeLowering would size the struct from the id-0
                        // sentinel (wrong layout) or the mangler would ICE, both
                        // decoupled from any diagnostic. Emit E0203 here so the
                        // pass fails (via from_snapshot) and Phase 5 aborts before
                        // codegen ever sees the poisoned StructType.
                        if (!field.resolved_type.is_valid()) {
                            const fname: string = ctx.intern_table.resolve(field.name);
                            const sname: string = ctx.intern_table.resolve(node.name);
                            ctx.emit_error_at(ErrorCode::E0203_UNDEFINED_TYPE,
                                fmt::format("cannot resolve type for field `%s` of `%s`", fname, sname),
                                field.span);
                            continue;
                        }
                        const is_pub: boolean = field.visibility == Visibility::Public;
                        const is_prot: boolean = field.visibility == Visibility::Protected;
                        mut fi: FieldInfo = FieldInfo::new(field.name, field.resolved_type, is_pub, is_prot, true);
                        fi.set_default_value(field.default_value);
                        field_infos.push(fi);
                    }
                    st.set_fields(field_infos);

                    // Layout attributes (`![repr]` / `![align]`) are
                    // propagated from the AST onto the StructType by
                    // DirectiveProcessing, which runs *after* this pass.
                    // See `propagate_layout_attrs_to_types` there.

                    // Populate StructType.methods so sema's overload
                    // resolution (resolve_method_overload) can pick the
                    // right overload for struct methods; same rationale
                    // as ClassType below, except structs are dispatched
                    // statically rather than via vtable.
                    const st_this_amp: SymbolStr = ctx.intern_table.intern("&this");
                    const st_this_val: SymbolStr = ctx.intern_table.intern("this");
                    for (mut jm: i64 = 0; jm < node.methods.length; jm++) {
                        const mnode: MethodNode* = node.methods[jm];
                        if (mnode == null || mnode.func == null) { continue; }
                        const fn_node: FunctionDeclNode* = mnode.func;
                        mut ptypes: TypeRef[] = [];
                        for (mut pi: i64 = 0; pi < fn_node.parameters.length; pi++) {
                            const pp: VarDeclNode* = fn_node.parameters[pi];
                            if (pp == null) { continue; }
                            if (pp.name.equals(st_this_amp)) { continue; }
                            if (pp.name.equals(st_this_val)) { continue; }
                            ptypes.push(pp.resolved_type);
                        }
                        const fn_ty: TypeRef = arena.get_function(
                            fn_node.resolved_return_type, ptypes, fn_node.is_variadic);
                        const minfo: MethodInfo = MethodInfo {
                            name:          fn_node.name,
                            function_type: fn_ty,
                            is_public:     mnode.visibility == Visibility::Public,
                            is_protected:  mnode.visibility == Visibility::Protected,
                            is_static:     mnode.is_static,
                            is_virtual:    mnode.is_virtual,
                            is_override:   mnode.is_override,
                            param_types:   ptypes,
                            ast_node:      mnode as void*,
                        };
                        st.add_method(minfo);
                    }
                    struct_count++;
                }
                NodeKind::UnionDeclaration => {
                    const node: UnionDeclNode* = stmt as UnionDeclNode*;
                    if (node.is_generic()) { continue; }

                    const type_ref: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/union field sync");
                    if (!type_ref.is_valid()) { continue; }

                    const base_type: Type* = arena.lookup(type_ref.id);
                    // A union is a StructType (with is_union=true).
                    if (base_type == null || base_type.kind != TypeKind::Struct) { continue; }

                    mut st: StructType* = base_type as StructType*;
                    mut field_infos: FieldInfo[] = [];
                    for (mut j: i64 = 0; j < node.fields.length; j++) {
                        const field: FieldDeclNode* = node.fields[j];
                        if (field == null) { continue; }
                        if (!field.resolved_type.is_valid()) {
                            const fname: string = ctx.intern_table.resolve(field.name);
                            const sname: string = ctx.intern_table.resolve(node.name);
                            ctx.emit_error_at(ErrorCode::E0203_UNDEFINED_TYPE,
                                fmt::format("cannot resolve type for field `%s` of `%s`", fname, sname),
                                field.span);
                            continue;
                        }
                        const is_pub: boolean = field.visibility == Visibility::Public;
                        const is_prot: boolean = field.visibility == Visibility::Protected;
                        mut fi: FieldInfo = FieldInfo::new(field.name, field.resolved_type, is_pub, is_prot, true);
                        fi.set_default_value(field.default_value);
                        field_infos.push(fi);
                    }
                    st.set_fields(field_infos);

                    const u_this_amp: SymbolStr = ctx.intern_table.intern("&this");
                    const u_this_val: SymbolStr = ctx.intern_table.intern("this");
                    for (mut jm: i64 = 0; jm < node.methods.length; jm++) {
                        const mnode: MethodNode* = node.methods[jm];
                        if (mnode == null || mnode.func == null) { continue; }
                        const fn_node: FunctionDeclNode* = mnode.func;
                        mut ptypes: TypeRef[] = [];
                        for (mut pi: i64 = 0; pi < fn_node.parameters.length; pi++) {
                            const pp: VarDeclNode* = fn_node.parameters[pi];
                            if (pp == null) { continue; }
                            if (pp.name.equals(u_this_amp)) { continue; }
                            if (pp.name.equals(u_this_val)) { continue; }
                            ptypes.push(pp.resolved_type);
                        }
                        const fn_ty: TypeRef = arena.get_function(
                            fn_node.resolved_return_type, ptypes, fn_node.is_variadic);
                        const minfo: MethodInfo = MethodInfo {
                            name:          fn_node.name,
                            function_type: fn_ty,
                            is_public:     mnode.visibility == Visibility::Public,
                            is_protected:  mnode.visibility == Visibility::Protected,
                            is_static:     mnode.is_static,
                            is_virtual:    mnode.is_virtual,
                            is_override:   mnode.is_override,
                            param_types:   ptypes,
                            ast_node:      mnode as void*,
                        };
                        st.add_method(minfo);
                    }
                    struct_count++;
                }
                NodeKind::ClassDeclaration => {
                    const node: ClassDeclNode* = stmt as ClassDeclNode*;
                    if (node.is_generic()) { continue; }

                    const type_ref: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/class field sync");
                    if (!type_ref.is_valid()) { continue; }

                    const base_type: Type* = arena.lookup(type_ref.id);
                    if (base_type == null || base_type.kind != TypeKind::Class) { continue; }

                    mut ct: ClassType* = base_type as ClassType*;
                    mut field_infos: FieldInfo[] = [];
                    for (mut j: i64 = 0; j < node.fields.length; j++) {
                        const field: FieldDeclNode* = node.fields[j];
                        if (field == null) { continue; }
                        // See the StructDeclaration arm: never bake an unresolved
                        // field type into the arena. Emit E0203 so the pass fails
                        // and Phase 5 aborts before the poisoned ClassType reaches
                        // layout/vtable codegen.
                        if (!field.resolved_type.is_valid()) {
                            const fname: string = ctx.intern_table.resolve(field.name);
                            const sname: string = ctx.intern_table.resolve(node.name);
                            ctx.emit_error_at(ErrorCode::E0203_UNDEFINED_TYPE,
                                fmt::format("cannot resolve type for field `%s` of `%s`", fname, sname),
                                field.span);
                            continue;
                        }
                        const is_pub: boolean = field.visibility == Visibility::Public;
                        const is_prot: boolean = field.visibility == Visibility::Protected;
                        mut fi: FieldInfo = FieldInfo::new(field.name, field.resolved_type, is_pub, is_prot, true);
                        fi.set_default_value(field.default_value);
                        field_infos.push(fi);
                    }
                    ct.set_fields(field_infos);

                    // See the StructDeclaration arm - layout attrs are
                    // propagated in DirectiveProcessing.

                    // Populate ClassType.methods from the AST so virtual
                    // dispatch machinery (vtable emission, `has_virtual_methods`
                    // flag, slot indexing) has the data it needs.  Without
                    // this, cls.methods stays empty and every class looks
                    // non-virtual; the `new T(...)` path never stores a
                    // vtable pointer and polymorphic calls never dispatch
                    // through one.
                    for (mut jm: i64 = 0; jm < node.methods.length; jm++) {
                        const mnode: MethodNode* = node.methods[jm];
                        if (mnode == null || mnode.func == null) { continue; }
                        const fn_node: FunctionDeclNode* = mnode.func;
                        // Build the canonical parameter-type list: skip
                        // self params (`&this` / `this`).  These are the
                        // overload discriminator for vtable slot identity
                        // and the signature against which sema matches
                        // call arguments during overload resolution.
                        mut ptypes: TypeRef[] = [];
                        const this_amp: SymbolStr = ctx.intern_table.intern("&this");
                        const this_val: SymbolStr = ctx.intern_table.intern("this");
                        for (mut pi: i64 = 0; pi < fn_node.parameters.length; pi++) {
                            const pp: VarDeclNode* = fn_node.parameters[pi];
                            if (pp == null) { continue; }
                            if (pp.name.equals(this_amp)) { continue; }
                            if (pp.name.equals(this_val)) { continue; }
                            ptypes.push(pp.resolved_type);
                        }
                        const fn_ty: TypeRef = arena.get_function(
                            fn_node.resolved_return_type, ptypes, fn_node.is_variadic);
                        const minfo: MethodInfo = MethodInfo {
                            name:          fn_node.name,
                            function_type: fn_ty,
                            is_public:     mnode.visibility == Visibility::Public,
                            is_protected:  mnode.visibility == Visibility::Protected,
                            is_static:     mnode.is_static,
                            is_virtual:    mnode.is_virtual,
                            is_override:   mnode.is_override,
                            param_types:   ptypes,
                            ast_node:      mnode as void*,
                        };
                        ct.add_method(minfo);
                        const dbg_cname: string = ctx.intern_table.resolve(node.name);
                        const dbg_mname: string = ctx.intern_table.resolve(fn_node.name);
                        cdebug("[VT-DBG] add_method class='%s' method='%s' virt=%d over=%d hv=%d\n",
                               dbg_cname, dbg_mname, mnode.is_virtual as i32,
                               mnode.is_override as i32, ct.has_virtual_methods as i32);
                    }

                    // The base names one declaration, and which one is settled
                    // by the scope the class was WRITTEN in - so it is read
                    // from the stamp NameResolution left, not re-derived here.
                    // A bare leaf cannot be requalified from this pass's
                    // position: the base's own module may repeat its name
                    // (`compiler::types::type_base::Type`), and no amount of
                    // qualifying from the wrong module produces that.
                    if (node.has_base_class()) {
                        const base_ref: TypeRef = ctx.decl_index.type_of_res(
                            node.require_base_res("type_resolution: class base"));
                        if (base_ref.is_valid()) {
                            ct.set_base_class(base_ref);
                            // Propagate vtable presence: if any ancestor has
                            // virtual methods, this subclass needs a vtable
                            // slot too (even if it only inherits, doesn't
                            // add its own virtuals).
                            mut anc_ref: TypeRef = base_ref;
                            mut anc_depth: i32 = 0;
                            while (anc_depth < 16) {
                                const anc_t: Type* = arena.lookup(anc_ref.id);
                                if (anc_t == null || anc_t.kind != TypeKind::Class) { break; }
                                const anc_cls: ClassType* = anc_t as ClassType*;
                                if (anc_cls.has_virtual_methods) {
                                    ct.has_virtual_methods = true;
                                    break;
                                }
                                if (!anc_cls.has_base || !anc_cls.base_class.is_valid()) { break; }
                                anc_ref = anc_cls.base_class;
                                anc_depth += 1;
                            }
                        }
                    }
                    class_count++;
                }
                NodeKind::EnumDeclaration => {
                    const node: EnumDeclNode* = stmt as EnumDeclNode*;

                    const type_ref: TypeRef = ctx.decl_index.type_of_decl(node.def, "type_resolution/enum field sync");
                    if (!type_ref.is_valid()) { continue; }

                    const base_type: Type* = arena.lookup(type_ref.id);
                    if (base_type == null || base_type.kind != TypeKind::Enum) { continue; }

                    mut et: EnumType* = base_type as EnumType*;
                    // Only populate if not already populated (avoid double-populating)
                    if (et.variants.length > 0) { continue; }

                    // Build a resolution context.  For generic enums, bind each
                    // generic parameter to its GenericParam TypeRef so that
                    // variant payload annotations referencing `T` resolve to the
                    // enum's own GenericParam_T.  Without this, generic enums had
                    // empty variant info; the monomorphizer's substitution
                    // path falls back to AST re-resolution on partially-
                    // specialized clones (e.g., Option<T*> where the outer T is
                    // still generic), which can't find `T` in a binding-free
                    // context.  Populating the base lets specialization apply
                    // substitution to a known-good source.
                    const module_name: string = ctx.has_namespace()
                        ? ctx.namespace_display() : ctx.source_file;
                    mut res_ctx: ResolutionContext = ResolutionContext::new(ctx.source_file);
                    // The variant payload annotations mean what the module that
                    // WROTE this enum says (spec §8.2m).  That is the cursor for
                    // a declaration this module actually owns - this walk is in
                    // order - but not for one INJECTED into this root by
                    // specialization, which carries its template's span.  The
                    // span is right in both cases; `module_name` above is the
                    // cursor spelled out, and is kept only as the current-module
                    // string the resolver uses for `T[NAME]` array sizes.
                    // Use the canonical helper so a constrained `T: Bound`
                    // produces a BoundedParamType matching what
                    // template-registration created for the same enum.
                    const refs: TypeRef[] = TypeResolutionPasses::create_generic_param_types(
                        node.generic_params, arena);
                    for (mut gpi: i64 = 0; gpi < node.generic_params.length; gpi++) {
                        const gp: GenericParamNode* = node.generic_params[gpi];
                        if (gp == null) { continue; }
                        res_ctx.add_binding(gp.name, refs[gpi]);
                    }

                    // Discriminants come from the declaration itself, which
                    // is also what a compile-time fold of `Enum::Variant`
                    // reads; computing them here as well would let the tag
                    // an expression sees drift from the tag the type carries.
                    const tags: i64[] = node.variant_tags();
                    for (mut j: i64 = 0; j < node.variants.length; j++) {
                        const variant: EnumVariantNode* = node.variants[j];
                        if (variant == null) { continue; }

                        mut payload_types: TypeRef[] = [];
                        for (mut k: i64 = 0; k < variant.associated_types.length; k++) {
                            const ann: TypeAnnotation* = variant.associated_types[k];
                            mut resolved: TypeRef = TypeRef::invalid();
                            if (ann != null && ctx.type_resolver != null) {
                                resolved = ctx.type_resolver.resolve(ann, &res_ctx);
                            }
                            // Never bake an unresolved payload into the enum: the
                            // variant would be sized from the id-0 sentinel (wrong
                            // layout / discriminant) or ICE the mangler, decoupled
                            // from any diagnostic. Emit E0203 so the pass fails and
                            // Phase 5 aborts before codegen.
                            if (!resolved.is_valid()) {
                                const vname: string = ctx.intern_table.resolve(variant.name);
                                const ename: string = ctx.intern_table.resolve(node.name);
                                ctx.emit_error_at(ErrorCode::E0203_UNDEFINED_TYPE,
                                    fmt::format("cannot resolve payload type for variant `%s` of enum `%s`", vname, ename),
                                    variant.span);
                                continue;
                            }
                            payload_types.push(resolved);
                        }

                        et.add_variant(EnumVariantInfo::new(
                            variant.name, payload_types, tags[j] as u64));
                    }

                    // Resolve the explicit discriminant base (`type enum Foo
                    // : i64`), if any, so codegen lowers the tag at the
                    // declared C-ABI width instead of the default i32 - fixing
                    // both FFI width round-trips and large-discriminant
                    // truncation (`Hi = 4294967296` -> 0 under an i32 tag).
                    if (node.discriminant_annotation != null && ctx.type_resolver != null) {
                        const disc: TypeRef = ctx.type_resolver.resolve(
                            node.discriminant_annotation, &res_ctx);
                        if (disc.is_valid()) {
                            et.set_discriminant_type(disc);
                        }
                    }

                    // See the StructDeclaration arm - layout attrs are
                    // propagated in DirectiveProcessing.
                }
                NodeKind::ImplementationBlock => {
                    const node: ImplBlockNode* = stmt as ImplBlockNode*;
                    if (node.is_generic()) { continue; }
                    // Resolve the target type so method-call sema can find
                    // the impl's methods on the StructType/ClassType. This
                    // applies to both inherent impls (`implement Foo { ... }`)
                    // and trait impls (`implement trait T for Foo { ... }`).
                    // Without this, only methods declared inline inside the
                    // struct body land on `StructType.methods`; methods
                    // delivered via impl blocks were invisible to the
                    // call-arg expected_type propagation, so generic-method
                    // calls inside trait-impl method bodies (e.g.
                    // `NonNull::new(...)` as an argument to `deallocate`)
                    // had no concrete instantiation to point at.
                    //
                    // The owner is read off the head's stamp.  A spelling
                    // qualified by the writer's module misses every trait
                    // implemented for another module's type, and those
                    // methods were then invisible here - absent from the
                    // type's method list, so a call's argument types could
                    // not be propagated from them and `Type::member` could
                    // not tell the type from a module.
                    const tgt: TypeRef = ctx.decl_index.impl_owner(node, "type_resolution/struct field sync");
                    if (!tgt.is_valid()) { continue; }
                    const tgt_t: Type* = arena.lookup(tgt.id);
                    if (tgt_t == null) { continue; }
                    const this_amp_sym: SymbolStr = ctx.intern_table.intern("&this");
                    const this_val_sym: SymbolStr = ctx.intern_table.intern("this");
                    for (mut mi: i64 = 0; mi < node.methods.length; mi++) {
                        const mnode: MethodNode* = node.methods[mi];
                        if (mnode == null || mnode.func == null) { continue; }
                        const fn_node: FunctionDeclNode* = mnode.func;
                        mut ptypes: TypeRef[] = [];
                        for (mut pi: i64 = 0; pi < fn_node.parameters.length; pi++) {
                            const pp: VarDeclNode* = fn_node.parameters[pi];
                            if (pp == null) { continue; }
                            if (pp.name.equals(this_amp_sym)) { continue; }
                            if (pp.name.equals(this_val_sym)) { continue; }
                            ptypes.push(pp.resolved_type);
                        }
                        const fn_ty: TypeRef = arena.get_function(
                            fn_node.resolved_return_type, ptypes, fn_node.is_variadic);
                        // Build the MethodInfo only on the paths that consume
                        // it.  MethodInfo has no Drop impl (its owned
                        // param_types array is freed by field drop-glue at
                        // scope exit, not via an explicit `.drop()`), so it
                        // can't be released on a dead path; instead `ptypes`
                        // is moved into minfo on exactly the struct/class
                        // branches and dropped directly otherwise.
                        if (tgt_t.kind == TypeKind::Struct
                                || tgt_t.kind == TypeKind::Class
                                || tgt_t.kind == TypeKind::Enum) {
                            const minfo: MethodInfo = MethodInfo {
                                name:          fn_node.name,
                                function_type: fn_ty,
                                is_public:     mnode.visibility == Visibility::Public,
                                is_protected:  mnode.visibility == Visibility::Protected,
                                is_static:     mnode.is_static,
                                is_virtual:    mnode.is_virtual,
                                is_override:   mnode.is_override,
                                param_types:   ptypes,
                                ast_node:      mnode as void*,
                            };
                            if (tgt_t.kind == TypeKind::Struct) {
                                mut tst: StructType* = tgt_t as StructType*;
                                tst.add_method(minfo);
                            } else if (tgt_t.kind == TypeKind::Class) {
                                mut tct: ClassType* = tgt_t as ClassType*;
                                tct.add_method(minfo);
                            } else {
                                // An enum's inherent methods live only in
                                // `implement enum E { }` blocks, so this is
                                // the ONLY way any reach its method set.
                                mut tet: EnumType* = tgt_t as EnumType*;
                                tet.add_method(minfo);
                            }
                        } else {
                            ptypes.drop();
                        }
                    }
                }
                _ => {}
            }
        }

        if (ctx.debug_mode) {
            cdebug("[StructFieldTypeSync] Synced %lld structs, %lld classes\n",
                struct_count, class_count);
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }
}
