/// Directive-Processing Pass
///
/// Walks every top-level statement and every declaration's
/// `attached_directives` list, validates the built-in directive
/// vocabulary, applies known side-effects (e.g. `![inline]` flips a
/// function's `is_inline` flag), and registers every observed directive
/// in the compilation-wide DirectiveRegistry so later passes / tooling
/// can query "is this function marked `![test]`?", "what's the `repr`
/// of this struct?", and so on.
///
/// Built-in directive vocabulary:
///
///   ![inline]                 — function: hint the inliner to inline
///   ![noinline]               — function: hint the inliner to skip
///   ![entry]                  — function: marker for "program entry"
///   ![test]                   — function: marker for unit-test runners
///   ![ignore]                 — function (`![test]`-marked): skip this test
///                                 unless `--ignored` is passed
///   ![should_panic]           — function (`![test]`-marked): test passes
///                                 only if it panics or returns Err
///   ![config(testing)]        — namespace: marks the file as a testing
///                                 module; only built under `cryo test`
///   ![deprecated]             — any decl: deprecation marker
///   ![deprecated("msg")]      — any decl: deprecation marker w/ msg
///   ![align(N)]               — struct/class: align bytes (N integer)
///   ![repr(C)] / ![repr(packed)] — struct/class: layout repr
///   ![link("name")]           — extern fn / block: linker name override
///   ![config(<atom>)] / ![target(<atom>)] / ![<atom>] — platform gate
///                                 evaluated by ConfigGating; <atom> is
///                                 windows / linux / macos / unix or
///                                 `not(<atom>)`.
///   ![allow(name)] / ![warn(name)] / ![deny(name)] — lint level
///   ![derive(Trait, ...)]     — struct/class/enum: traits to auto-derive
///
/// Unknown directive names are accepted and recorded but otherwise inert.
/// Misuse of a built-in (wrong arity, wrong target kind, malformed args)
/// produces an E0150–E0153 diagnostic at the directive's source span.

namespace Compiler::Passes::DirectiveProcessing;

import Compiler::Diag;
import Compiler::Diag::Snapshot;
import Compiler::Diag::SourceSpan;
import Compiler::Diag::Diagnostic;
import Compiler::AST;
import Compiler::AST::Node;
import Compiler::AST::Declaration;
import Compiler::AST::Pattern;
import Compiler::Passes::PassID;
import Compiler::CompilationContext;
import Utils::Logger;


// ============================================================================
// DirectiveRecord — One observed directive
// ============================================================================

type struct DirectiveRecord {
    /// Directive name (e.g. "inline", "cfg").
    kind:       string;
    /// The DirectiveNode in the AST.
    node:       DirectiveNode*;
    /// Owning declaration (null ⇒ standalone module-level directive).
    decl:       DeclarationNode*;
    /// Fully-qualified name of the owning declaration, captured at
    /// registration time when `ctx.namespace` is correct for the
    /// current module.  Late-running passes (e.g. `TestMainCodegen`)
    /// can't reproduce the qualifier from `decl.name` alone because by
    /// then `ctx` may be in a different module's state.  Empty for
    /// standalone module-level directives where `decl == null`.
    qualified_name: SymbolStr;
    /// Source location of the directive.
    span:       SourceSpan;
}


// ============================================================================
// DirectiveRegistry — Accumulator across modules
// ============================================================================

/// Tracks every directive observed during compilation so later passes,
/// tooling, and tests can ask "is this function marked `![test]`?",
/// "what's the `repr` of struct Foo?", etc.
type class DirectiveRegistry {
public:
    records: DirectiveRecord[];

    static new() -> DirectiveRegistry* {
        mut r: DirectiveRegistry* = new DirectiveRegistry();
        r.records = [];
        return r;
    }

    /// Idempotently add a directive observation.  The pass may run on the
    /// same module twice (Phase 4 + Phase 6a), so we de-duplicate by
    /// AST node identity to keep the registry stable.
    add(mut &this, rec: DirectiveRecord) -> void {
        for (mut i: i64 = 0; i < this.records.length; i++) {
            if (this.records[i].node == rec.node) { return; }
        }
        this.records.push(rec);
    }

    count(&this) -> i64 {
        return this.records.length;
    }

    /// True if any directive in the registry has the given kind.
    has(&this, kind: string) -> boolean {
        for (mut i: i64 = 0; i < this.records.length; i++) {
            if (strcmp(this.records[i].kind, kind) == 0) {
                return true;
            }
        }
        return false;
    }

    count_kind(&this, kind: string) -> i64 {
        mut n: i64 = 0;
        for (mut i: i64 = 0; i < this.records.length; i++) {
            if (strcmp(this.records[i].kind, kind) == 0) {
                n = n + 1;
            }
        }
        return n;
    }

    /// Reset the registry (used by the multi-module driver between
    /// modules — though we currently keep records cumulative).
    clear(mut &this) -> void {
        this.records = [];
    }
}


// ============================================================================
// Directive kinds — recognised built-ins
// ============================================================================

/// True if `name` is a built-in directive recognised by the compiler.
/// Unknown names are accepted by the pass but get no validation or
/// side-effects — they're still registered so user tooling can read them.
function is_known_builtin(name: string) -> boolean {
    return strcmp(name, "inline") == 0
        || strcmp(name, "noinline") == 0
        || strcmp(name, "entry") == 0
        || strcmp(name, "test") == 0
        || strcmp(name, "ignore") == 0
        || strcmp(name, "should_panic") == 0
        || strcmp(name, "config") == 0
        || strcmp(name, "deprecated") == 0
        || strcmp(name, "align") == 0
        || strcmp(name, "repr") == 0
        || strcmp(name, "link") == 0
        || strcmp(name, "target") == 0
        || strcmp(name, "allow") == 0
        || strcmp(name, "warn") == 0
        || strcmp(name, "deny") == 0
        || strcmp(name, "derive") == 0
        // Bare-atom forms of the cfg/config gate.  These are sugar for
        // `![config(<atom>)]` and are evaluated by the ConfigGating pass.
        || strcmp(name, "windows") == 0
        || strcmp(name, "linux") == 0
        || strcmp(name, "macos") == 0
        || strcmp(name, "unix") == 0
        // Top-level negation form: `![not(<atom>)]`.  Mirrors the
        // nested `not(...)` form recognised inside `config(...)`.
        || strcmp(name, "not") == 0;
}

/// Local copy of the OS-atom predicate so the validator can extend
/// `config(...)` arg-shape checking without cross-importing the
/// ConfigGating pass.  Kept in sync with config_gating.cryo's atom set.
function is_cfg_os_atom(name: string) -> boolean {
    return strcmp(name, "windows") == 0
        || strcmp(name, "linux") == 0
        || strcmp(name, "macos") == 0
        || strcmp(name, "unix") == 0;
}


// ============================================================================
// Validation helpers — built-in shape checks
// ============================================================================

/// Built-in target categories so misplaced directives can be reported
/// with a precise message ("`![inline]` only applies to functions").
type enum DirectiveTarget {
    Module;       // top-level (no owning decl)
    Function;
    Struct;
    Class;
    Enum;
    Trait;
    TypeAlias;
    Variable;
    Impl;
    Extern;
    Import;
    Other;
}

function classify_target(decl: DeclarationNode*) -> DirectiveTarget {
    if (decl == null) { return DirectiveTarget::Module; }
    return match (decl.kind) {
        NodeKind::FunctionDeclaration   => { DirectiveTarget::Function }
        NodeKind::StructDeclaration     => { DirectiveTarget::Struct   }
        NodeKind::ClassDeclaration      => { DirectiveTarget::Class    }
        NodeKind::EnumDeclaration       => { DirectiveTarget::Enum     }
        NodeKind::TraitDeclaration      => { DirectiveTarget::Trait    }
        NodeKind::TypeAliasDeclaration  => { DirectiveTarget::TypeAlias }
        NodeKind::VariableDeclaration   => { DirectiveTarget::Variable }
        NodeKind::ImplementationBlock   => { DirectiveTarget::Impl     }
        NodeKind::ExternBlock           => { DirectiveTarget::Extern   }
        NodeKind::ImportDeclaration     => { DirectiveTarget::Import   }
        _                               => { DirectiveTarget::Other    }
    };
}

function target_label(t: DirectiveTarget) -> string {
    return match (t) {
        DirectiveTarget::Module    => { "module" }
        DirectiveTarget::Function  => { "function" }
        DirectiveTarget::Struct    => { "struct" }
        DirectiveTarget::Class     => { "class" }
        DirectiveTarget::Enum      => { "enum" }
        DirectiveTarget::Trait     => { "trait" }
        DirectiveTarget::TypeAlias => { "type alias" }
        DirectiveTarget::Variable  => { "variable" }
        DirectiveTarget::Impl      => { "impl block" }
        DirectiveTarget::Extern    => { "extern block" }
        DirectiveTarget::Import    => { "import" }
        DirectiveTarget::Other     => { "declaration" }
    };
}


// ============================================================================
// Validation — per-directive checks
// ============================================================================

/// Validate a single observed directive.  Emits diagnostics for arity or
/// placement violations.  Returns void; severity is encoded in the
/// emitted diagnostics.
function validate_builtin(ctx: CompilationContext*, dir: DirectiveNode*,
                          target: DirectiveTarget) -> void {
    const name: string = dir.directive_kind;
    const argc: i64 = dir.args.length;

    if (strcmp(name, "inline") == 0 || strcmp(name, "noinline") == 0) {
        if (argc != 0) {
            emit_arity_error(ctx, dir, name, 0, argc);
        }
        if (target != DirectiveTarget::Function) {
            emit_placement_error(ctx, dir, name, "function", target);
        }
        return;
    }

    if (strcmp(name, "entry") == 0 || strcmp(name, "test") == 0) {
        if (argc != 0) {
            emit_arity_error(ctx, dir, name, 0, argc);
        }
        if (target != DirectiveTarget::Function) {
            emit_placement_error(ctx, dir, name, "function", target);
        }
        return;
    }

    // `![ignore]` and `![should_panic]` are siblings of `![test]`: zero
    // args, function-target.  Cross-directive coupling (e.g. requiring
    // `![test]` to be present alongside `![ignore]`) is enforced later
    // by the test-mode validator pass — directive_processing only checks
    // each directive's own shape and target.
    if (strcmp(name, "ignore") == 0 || strcmp(name, "should_panic") == 0) {
        if (argc != 0) {
            emit_arity_error(ctx, dir, name, 0, argc);
        }
        if (target != DirectiveTarget::Function) {
            emit_placement_error(ctx, dir, name, "function", target);
        }
        return;
    }

    // `![config(<flavor>)]` marks an entire file's namespace as a special
    // build mode.  Today the only recognised flavor is `testing`, which
    // gates the file in/out under `cryo test`.  Future flavors (e.g. a
    // `bench` flavor for benchmarks) plug in here.
    if (strcmp(name, "config") == 0) {
        if (argc != 1) {
            emit_arity_error(ctx, dir, name, 1, argc);
            return;
        }
        const a: DirectiveArg = dir.args[0];

        // Nested call shape: `config(not(<atom>))` etc.  Only `not(...)`
        // is recognised today; vocabulary expansion (any/all) plugs in
        // here.  Placement is unrestricted — platform gates can attach
        // to any decl.
        if (a.kind == DirectiveArgKind::Nested) {
            if (a.nested == null
                    || strcmp(a.nested.directive_kind, "not") != 0) {
                const code: ErrorCode = ErrorCode::E0152_DIRECTIVE_BAD_ARG;
                const msg: string =
                    "directive `![config(...)]`: nested calls must be `not(<atom>)`";
                mut diag: Diagnostic = Diagnostic::error(code, msg);
                diag = diag.at(dir.span);
                ctx.emit_diagnostic(diag);
            }
            return;
        }

        if (a.kind != DirectiveArgKind::Ident) {
            emit_arg_kind_error(ctx, dir, name, 0, "an identifier");
            return;
        }

        // OS-atom flavor: `config(windows)` etc.  No placement
        // restriction — these gate any declaration.
        if (is_cfg_os_atom(a.name)) {
            return;
        }

        // Build-mode flavor: today only `testing` is recognised, and it
        // must live on a namespace.  Misspelled flavors fall through to
        // the catch-all error.
        if (strcmp(a.name, "testing") == 0) {
            if (target != DirectiveTarget::Module) {
                emit_placement_error(ctx, dir, name, "namespace", target);
            }
            return;
        }

        const code: ErrorCode = ErrorCode::E0152_DIRECTIVE_BAD_ARG;
        const msg: string = format(
            "directive `![config]`: unknown flavor `%s` (expected `testing`, `windows`, `linux`, `macos`, `unix`, or `not(<atom>)`)",
            a.name);
        mut diag: Diagnostic = Diagnostic::error(code, msg);
        diag = diag.at(dir.span);
        ctx.emit_diagnostic(diag);
        return;
    }

    // Bare-atom forms: `![windows]`, `![linux]`, `![macos]`, `![unix]`.
    // Sugar for `![config(<atom>)]`; identical semantics, evaluated by
    // the ConfigGating pass.  Zero args, unrestricted placement.
    if (is_cfg_os_atom(name)) {
        if (argc != 0) {
            emit_arity_error(ctx, dir, name, 0, argc);
        }
        return;
    }

    // Bare negation: `![not(<atom>)]`.  Mirrors the nested `not(...)`
    // form recognised inside `config(...)`.
    if (strcmp(name, "not") == 0) {
        if (argc != 1) {
            emit_arity_error(ctx, dir, name, 1, argc);
            return;
        }
        const a: DirectiveArg = dir.args[0];
        if (a.kind != DirectiveArgKind::Ident) {
            emit_arg_kind_error(ctx, dir, name, 0, "an identifier");
            return;
        }
        if (!is_cfg_os_atom(a.name)) {
            const code: ErrorCode = ErrorCode::E0152_DIRECTIVE_BAD_ARG;
            const msg: string = format(
                "directive `![not]`: unknown atom `%s` (expected `windows`, `linux`, `macos`, or `unix`)",
                a.name);
            mut diag: Diagnostic = Diagnostic::error(code, msg);
            diag = diag.at(dir.span);
            ctx.emit_diagnostic(diag);
        }
        return;
    }

    if (strcmp(name, "deprecated") == 0) {
        // Optional single string-literal message.
        if (argc > 1) {
            emit_arity_error(ctx, dir, name, 1, argc);
        }
        if (argc == 1) {
            const a: DirectiveArg = dir.args[0];
            if (a.kind != DirectiveArgKind::StringLit) {
                emit_arg_kind_error(ctx, dir, name, 0, "a string literal");
            }
        }
        return;
    }

    if (strcmp(name, "align") == 0) {
        if (argc != 1) {
            emit_arity_error(ctx, dir, name, 1, argc);
            return;
        }
        const a: DirectiveArg = dir.args[0];
        if (a.kind != DirectiveArgKind::IntLit) {
            emit_arg_kind_error(ctx, dir, name, 0, "an integer literal");
            return;
        }
        if (target != DirectiveTarget::Struct
            && target != DirectiveTarget::Class
            && target != DirectiveTarget::Variable) {
            emit_placement_error(ctx, dir, name, "struct/class/variable", target);
        }
        return;
    }

    if (strcmp(name, "repr") == 0) {
        if (argc != 1) {
            emit_arity_error(ctx, dir, name, 1, argc);
            return;
        }
        const a: DirectiveArg = dir.args[0];
        if (a.kind != DirectiveArgKind::Ident) {
            emit_arg_kind_error(ctx, dir, name, 0, "an identifier");
            return;
        }
        if (target != DirectiveTarget::Struct
            && target != DirectiveTarget::Class
            && target != DirectiveTarget::Enum) {
            emit_placement_error(ctx, dir, name, "struct/class/enum", target);
        }
        return;
    }

    if (strcmp(name, "link") == 0) {
        if (argc != 1) {
            emit_arity_error(ctx, dir, name, 1, argc);
            return;
        }
        const a: DirectiveArg = dir.args[0];
        if (a.kind != DirectiveArgKind::StringLit) {
            emit_arg_kind_error(ctx, dir, name, 0, "a string literal");
        }
        return;
    }

    // `![target(<atom>)]` is an alias for `![config(<atom>)]` for
    // platform-gate purposes.  Accepts the same vocabulary: bare OS
    // atom or `not(<atom>)`.  The legacy `![cfg]` spelling has been
    // retired in favor of `config`.
    if (strcmp(name, "target") == 0) {
        if (argc != 1) {
            emit_arity_error(ctx, dir, name, 1, argc);
            return;
        }
        const a: DirectiveArg = dir.args[0];
        if (a.kind == DirectiveArgKind::Nested) {
            if (a.nested == null
                    || strcmp(a.nested.directive_kind, "not") != 0) {
                const code: ErrorCode = ErrorCode::E0152_DIRECTIVE_BAD_ARG;
                const msg: string =
                    "directive `![target(...)]`: nested calls must be `not(<atom>)`";
                mut diag: Diagnostic = Diagnostic::error(code, msg);
                diag = diag.at(dir.span);
                ctx.emit_diagnostic(diag);
            }
            return;
        }
        if (a.kind != DirectiveArgKind::Ident) {
            emit_arg_kind_error(ctx, dir, name, 0, "an identifier");
            return;
        }
        if (!is_cfg_os_atom(a.name)) {
            const code: ErrorCode = ErrorCode::E0152_DIRECTIVE_BAD_ARG;
            const msg: string = format(
                "directive `![target]`: unknown atom `%s` (expected `windows`, `linux`, `macos`, `unix`, or `not(<atom>)`)",
                a.name);
            mut diag: Diagnostic = Diagnostic::error(code, msg);
            diag = diag.at(dir.span);
            ctx.emit_diagnostic(diag);
        }
        return;
    }

    if (strcmp(name, "allow") == 0 || strcmp(name, "warn") == 0 || strcmp(name, "deny") == 0) {
        if (argc == 0) {
            emit_arity_error(ctx, dir, name, 1, argc);
            return;
        }
        for (mut i: i64 = 0; i < argc; i++) {
            const a: DirectiveArg = dir.args[i];
            if (a.kind != DirectiveArgKind::Ident) {
                emit_arg_kind_error(ctx, dir, name, i, "an identifier");
            }
        }
        return;
    }

    if (strcmp(name, "derive") == 0) {
        if (argc == 0) {
            emit_arity_error(ctx, dir, name, 1, argc);
            return;
        }
        for (mut i: i64 = 0; i < argc; i++) {
            const a: DirectiveArg = dir.args[i];
            if (a.kind != DirectiveArgKind::Ident) {
                emit_arg_kind_error(ctx, dir, name, i, "a trait name (identifier)");
            }
        }
        if (target != DirectiveTarget::Struct
            && target != DirectiveTarget::Class
            && target != DirectiveTarget::Enum) {
            emit_placement_error(ctx, dir, name, "struct/class/enum", target);
        }
        return;
    }
}


// ============================================================================
// Side-effect application — known directives that mutate the AST
// ============================================================================

/// Apply known semantic side-effects of a directive to its target decl.
/// Currently:
///   ![inline]       → sets FunctionDeclNode.is_inline = true
///   ![noinline]     → sets FunctionDeclNode.is_inline = false
function apply_effects(dir: DirectiveNode*, decl: DeclarationNode*) -> void {
    if (decl == null) { return; }
    const name: string = dir.directive_kind;

    if (decl.kind == NodeKind::FunctionDeclaration) {
        const fn: FunctionDeclNode* = decl as FunctionDeclNode*;
        if (strcmp(name, "inline") == 0) {
            fn.is_inline = true;
            return;
        }
        if (strcmp(name, "noinline") == 0) {
            fn.is_inline = false;
            return;
        }
    }
}


// ============================================================================
// Diagnostic helpers
// ============================================================================

function emit_arity_error(ctx: CompilationContext*, dir: DirectiveNode*,
                          name: string, expected: i64, got: i64) -> void {
    const code: ErrorCode = ErrorCode::E0150_DIRECTIVE_BAD_ARITY;
    const msg: string = format(
        "directive `![%s]` expects %lld argument(s) but got %lld",
        name, expected, got);
    mut diag: Diagnostic = Diagnostic::error(code, msg);
    diag = diag.at(dir.span);
    ctx.emit_diagnostic(diag);
}

function emit_arg_kind_error(ctx: CompilationContext*, dir: DirectiveNode*,
                             name: string, idx: i64, expected_kind: string) -> void {
    const code: ErrorCode = ErrorCode::E0152_DIRECTIVE_BAD_ARG;
    const msg: string = format(
        "directive `![%s]`: argument %lld must be %s",
        name, idx + 1, expected_kind);
    mut diag: Diagnostic = Diagnostic::error(code, msg);
    diag = diag.at(dir.span);
    ctx.emit_diagnostic(diag);
}

function emit_placement_error(ctx: CompilationContext*, dir: DirectiveNode*,
                              name: string, expected_target: string,
                              actual: DirectiveTarget) -> void {
    const code: ErrorCode = ErrorCode::E0151_DIRECTIVE_MISPLACED;
    const msg: string = format(
        "directive `![%s]` only applies to %s, not %s",
        name, expected_target, target_label(actual));
    mut diag: Diagnostic = Diagnostic::error(code, msg);
    diag = diag.at(dir.span);
    ctx.emit_diagnostic(diag);
}


// ============================================================================
// Pass entry point
// ============================================================================

/// Walk the AST once: validate each directive, apply known effects, and
/// register every observed directive in the context's DirectiveRegistry.
/// Pass entry point.  Named `run_directive_processing` rather than bare
/// `run` to keep stage-2 dispatch unambiguous until codegen's
/// module-graph-walk fix (which lives in this same change set) ships in
/// the pinned compiler binary.  After the next pin refresh, this can be
/// renamed back to `run`.
function run_directive_processing(ctx: CompilationContext*) -> PassResult {
    const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

    const root: ProgramNode* = ctx.artifacts.ast.root;
    if (root == null) {
        return PassResult::ok();
    }

    // Lazy-init the registry.  We store a `DirectiveRegistry*` cast to
    // `void*` on the context so adding the field-type required no
    // cross-cutting edits to compilation_context.cryo's imports.
    if (ctx.directive_registry == null) {
        ctx.directive_registry = DirectiveRegistry::new() as void*;
    }
    mut registry: DirectiveRegistry* = ctx.directive_registry as DirectiveRegistry*;

    mut count: i64 = 0;

    // Cross-cutting tracking for the testing-mode validation below.
    // `has_config_testing` records whether this module's namespace
    // declaration carries `![config(testing)]`.  `first_test_dir` is
    // the source span of the first `![test]`/`![ignore]`/`![should_panic]`
    // directive seen, used to point the diagnostic at a real spot when
    // a test directive lives in a non-testing module.
    mut has_config_testing: boolean = false;
    mut has_test_directive: boolean = false;
    mut first_test_dir_span: SourceSpan = SourceSpan::none();
    mut first_test_dir_name: string = "";

    for (mut i: i64 = 0; i < root.statements.length; i++) {
        const stmt: ASTNode* = root.statements[i];
        if (stmt == null) { continue; }

        // Standalone (module-level) directives — no owner decl.
        if (stmt.kind == NodeKind::Directive) {
            const d: DirectiveNode* = stmt as DirectiveNode*;
            validate_builtin(ctx, d, DirectiveTarget::Module);
            const rec: DirectiveRecord = DirectiveRecord {
                kind: d.directive_kind,
                node: d,
                decl: null,
                qualified_name: SymbolStr::empty(),
                span: d.span,
            };
            registry.add(rec);
            count = count + 1;
            if (ctx.debug_mode) {
                cdebug("[DirectiveProcessing] module-level '%s' (%lld args) at %s:%u:%u\n",
                    d.directive_kind, d.args.length,
                    d.span.file, d.span.start_line, d.span.start_col);
            }
            continue;
        }

        // Attached directives on declarations.
        const t: DirectiveTarget = classify_target_from_kind(stmt.kind);
        if (t == DirectiveTarget::Other) { continue; }

        const decl: DeclarationNode* = stmt as DeclarationNode*;
        const ad_count: i64 = decl.attached_directives.length;
        if (ad_count == 0) { continue; }

        for (mut j: i64 = 0; j < ad_count; j++) {
            const d: DirectiveNode* = decl.attached_directives[j];
            if (d == null) { continue; }

            validate_builtin(ctx, d, t);
            apply_effects(d, decl);

            // Cross-cutting flags for the test-mode validation below.
            if (t == DirectiveTarget::Module
                    && strcmp(d.directive_kind, "config") == 0
                    && d.args.length == 1
                    && d.args[0].kind == DirectiveArgKind::Ident
                    && strcmp(d.args[0].name, "testing") == 0) {
                has_config_testing = true;
            }
            if (t == DirectiveTarget::Function
                    && (strcmp(d.directive_kind, "test")         == 0
                     || strcmp(d.directive_kind, "ignore")       == 0
                     || strcmp(d.directive_kind, "should_panic") == 0)) {
                if (!has_test_directive) {
                    first_test_dir_span = d.span;
                    first_test_dir_name = d.directive_kind;
                }
                has_test_directive = true;
            }

            // Capture the qualified name now while ctx.namespace is
            // correct for this module.  Late passes (TestMainCodegen)
            // need the qualifier to look up DI mangled names.
            mut qualified: SymbolStr = SymbolStr::empty();
            if (decl.kind == NodeKind::FunctionDeclaration) {
                const fn_decl: FunctionDeclNode* = decl as FunctionDeclNode*;
                qualified = ctx.qualify_symbol_sym(fn_decl.name);
            }
            const rec: DirectiveRecord = DirectiveRecord {
                kind: d.directive_kind,
                node: d,
                decl: decl,
                qualified_name: qualified,
                span: d.span,
            };
            registry.add(rec);
            count = count + 1;

            if (ctx.debug_mode) {
                mut tag: string = "custom ";
                if (is_known_builtin(d.directive_kind)) { tag = "builtin"; }
                cdebug("[DirectiveProcessing] %s '%s' on %s (%lld args) at %s:%u:%u\n",
                    tag, d.directive_kind, target_label(t), d.args.length,
                    d.span.file, d.span.start_line, d.span.start_col);
            }
        }
    }

    // Cross-cutting placement validation: enforce that `![config(testing)]`,
    // `![test]`, `![ignore]`, and `![should_panic]` only appear in files
    // under `<project_root>/tests/`, and that every file in `tests/` has
    // `![config(testing)]` on its namespace.
    validate_test_module_placement(ctx,
        has_config_testing, has_test_directive,
        first_test_dir_span, first_test_dir_name);

    if (ctx.debug_mode) {
        cdebug("[DirectiveProcessing] Processed %lld directives in this module (%lld cumulative)\n",
            count, registry.count());
    }

    return PassResult::from_snapshot(ctx.diagnostics, snap);
}

// ============================================================================
// Test-module placement validation
// ============================================================================

/// True iff `path` lies under `<project_root>/tests/` (recursively).
/// Computes the prefix once and does a byte-wise compare; matches the
/// path style cryoc uses internally (always project-relative or absolute,
/// never with `..`).
function file_is_under_tests_dir(project_root: string, file_path: string) -> boolean {
    if (strlen(project_root) == 0) { return false; }
    const prefix: string = format("%s/tests/", project_root);
    const plen: u64 = strlen(prefix);
    const flen: u64 = strlen(file_path);
    if (flen < plen) { return false; }
    return strncmp(file_path, prefix, plen) == 0;
}

/// Enforce the locked design's three placement rules.  Run once per
/// module after the walk has populated `has_config_testing` and
/// `has_test_directive`.
function validate_test_module_placement(ctx: CompilationContext*,
                                        has_config_testing: boolean,
                                        has_test_directive: boolean,
                                        first_test_dir_span: SourceSpan,
                                        first_test_dir_name: string) -> void {
    if (ctx.project_config == null) { return; }
    const project_root: string = ctx.project_config.project_root;
    const file_path:    string = ctx.source_file;

    // The stdlib lives outside the project tree but still parses through
    // this pass — never apply test-mode rules to stdlib files.
    if (strlen(ctx.stdlib_root) > 0
            && strncmp(file_path, ctx.stdlib_root, strlen(ctx.stdlib_root)) == 0) {
        return;
    }

    const in_tests_dir: boolean = file_is_under_tests_dir(project_root, file_path);

    // Rule 1: `![config(testing)]` must live under `tests/`.
    if (has_config_testing && !in_tests_dir) {
        const code: ErrorCode = ErrorCode::E0151_DIRECTIVE_MISPLACED;
        const msg: string = format(
            "directive `![config(testing)]` may only appear on a namespace inside `tests/`; this file is at `%s`",
            file_path);
        mut diag: Diagnostic = Diagnostic::error(code, msg);
        // Span the file's namespace decl if we can find it; otherwise
        // fall back to a span-less error so the renderer still shows
        // the file path from the message body.
        ctx.emit_diagnostic(diag);
    }

    // Rule 2: every file in `tests/` must carry `![config(testing)]`.
    if (in_tests_dir && !has_config_testing) {
        const code: ErrorCode = ErrorCode::E0151_DIRECTIVE_MISPLACED;
        const msg: string = format(
            "file under `tests/` is missing the `![config(testing)]` namespace marker (`%s`)",
            file_path);
        mut diag: Diagnostic = Diagnostic::error(code, msg);
        ctx.emit_diagnostic(diag);
    }

    // Rule 3: `![test]`/`![ignore]`/`![should_panic]` require an
    // enclosing `![config(testing)]` namespace.
    if (has_test_directive && !has_config_testing) {
        const code: ErrorCode = ErrorCode::E0151_DIRECTIVE_MISPLACED;
        const msg: string = format(
            "directive `![%s]` is only allowed inside a namespace marked `![config(testing)]`",
            first_test_dir_name);
        mut diag: Diagnostic = Diagnostic::error(code, msg);
        diag = diag.at(first_test_dir_span);
        ctx.emit_diagnostic(diag);
    }
}

/// classify_target by NodeKind alone (no DeclarationNode* needed).
function classify_target_from_kind(k: NodeKind) -> DirectiveTarget {
    return match (k) {
        NodeKind::FunctionDeclaration   => { DirectiveTarget::Function }
        NodeKind::StructDeclaration     => { DirectiveTarget::Struct   }
        NodeKind::ClassDeclaration      => { DirectiveTarget::Class    }
        NodeKind::EnumDeclaration       => { DirectiveTarget::Enum     }
        NodeKind::TraitDeclaration      => { DirectiveTarget::Trait    }
        NodeKind::TypeAliasDeclaration  => { DirectiveTarget::TypeAlias }
        NodeKind::VariableDeclaration   => { DirectiveTarget::Variable }
        NodeKind::ImplementationBlock   => { DirectiveTarget::Impl     }
        NodeKind::ExternBlock           => { DirectiveTarget::Extern   }
        NodeKind::ImportDeclaration     => { DirectiveTarget::Import   }
        NodeKind::ModuleDeclaration     => { DirectiveTarget::Module   }
        _                               => { DirectiveTarget::Other    }
    };
}
