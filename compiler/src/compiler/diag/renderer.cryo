/// DiagRenderer
///
/// Rich diagnostic renderer that produces a structured terminal report with
/// ANSI colors, source snippets, caret underlines, secondary spans, child
/// diagnostics, and suggestions.
///
/// Output goes through `Utils::DiagSink` over `io::Write` (`DiagRenderer::out`
/// is the discriminator).  The default (`out == null`) is the process's stderr,
/// written unbuffered via fd 2, which keeps stdout clean for LSP/JSON-RPC.
/// `render_to_string` points `out` at a `String` buffer so the language server
/// can embed the full rendered report in an LSP diagnostic's `message`.

namespace Compiler::Diag::Renderer;

import Compiler::Diag;
import Compiler::Diag::{ Severity, SourceSpan, SpanLabel, Suggestion, Diagnostic };
import Utils;
import Utils::SyntaxHighlighter;
import Utils::DiagSink;
import std::core::{ option, slice };
import std::io::stdio;
import std::env;
import std::collections::str;
import std::fs::file;
import std::fs::metadata;
import std::fs::path;
import std::collections::hashmap;
import std::collections::string;


// ANSI Color Codes

// NOTE: use \x1b (hex ESC = 0x1B) rather than \033 (octal).  Cryo's
// string-literal escape pass only recognizes \n \t \r \\ \' \" \0 \xHH;
// `\033` is parsed as `\0` + literal "33" and silently truncates the
// string to a single NUL byte, which is why all color escapes had been
// no-ops.
const ANSI_RESET:   string = "\x1b[0m";
const ANSI_BOLD:    string = "\x1b[1m";
const ANSI_RED:     string = "\x1b[91m";
const ANSI_YELLOW:  string = "\x1b[93m";
const ANSI_CYAN:    string = "\x1b[96m";
const ANSI_BLUE:    string = "\x1b[94m";
const ANSI_GREEN:   string = "\x1b[92m";
const ANSI_WHITE:   string = "\x1b[97m";
const ANSI_GREY:    string = "\x1b[90m";


// Column-width helpers (tab expansion + UTF-8 awareness)
//
// The renderer treats source columns as 1-indexed BYTE offsets - that's
// what the parser stamps onto every SourceSpan.  But terminals render
// in cells, not bytes, and a column-counted-in-bytes will mis-align the
// caret under any line containing a tab (one byte, many cells) or
// multi-byte UTF-8 (many bytes, one cell).  These helpers translate
// from "byte column on the original line" to "cell column on the
// rendered line", which keeps `^^^^` exactly below the highlighted
// span no matter what's in the source.
//
// Tab stops are 4 cells (rustc convention).  Wide characters (CJK
// fullwidth, emoji) are still counted as 1 cell - a proper east-asian-
// wide width table is a follow-up.

const TAB_WIDTH: u32 = 4;


// RenderConfig

/// Configuration for the diagnostic renderer.
type struct RenderConfig {
    colors:             boolean;
    context_lines:      u32;
    max_errors:         u32;
    warnings_as_errors: boolean;
    /// One-char left gutter printed before every structural line (arrow,
    /// margin, line-number, caret, child header, suggestion).  Terminal
    /// callers keep the default `" "` so the report breathes next to
    /// surrounding shell output; the LSP virtual-doc renderer uses `""`
    /// so its `.cryo-diag` text is column-zero.
    leading_pad:        string;
    /// When true, `print_message` keeps the literal backticks around
    /// inline-code spans rather than stripping them.  Terminal output
    /// gets bold-via-ANSI styling and the bare prose reads naturally, so
    /// terminal callers leave this off.  The LSP virtual-doc path turns
    /// it on so the `.cryo-diag` text retains markdown-style backticks
    /// for the TextMate grammar to highlight as `markup.inline.raw`.
    preserve_markup:    boolean;

    /// Default config: colors auto-detected, 2 context lines, 50 max errors.
    /// Color is enabled when stderr is a terminal AND `NO_COLOR` is unset,
    /// or when `CLICOLOR_FORCE` / `FORCE_COLOR` is set (overrides TTY check).
    static default() -> RenderConfig {
        return RenderConfig {
            colors:             RenderConfig::color_decision(),
            context_lines:      2,
            max_errors:         50,
            warnings_as_errors: false,
            leading_pad:        " ",
            preserve_markup:    false,
        };
    }

    /// Plain config: no colors, for redirected output, tests, or the
    /// language-server string-render path.  Keeps backticks intact so
    /// downstream renderers (LSP TextMate grammar, markdown viewers)
    /// can style code references inline.
    static plain() -> RenderConfig {
        return RenderConfig {
            colors:             false,
            context_lines:      2,
            max_errors:         50,
            warnings_as_errors: false,
            leading_pad:        "",
            preserve_markup:    true,
        };
    }

    /// Force-color config: ignore the TTY/NO_COLOR check.  Reserved for
    /// callers that have already decided color is wanted.
    static colored() -> RenderConfig {
        return RenderConfig {
            colors:             true,
            context_lines:      2,
            max_errors:         50,
            warnings_as_errors: false,
            leading_pad:        " ",
            preserve_markup:    false,
        };
    }

    /// Final color decision: respect NO_COLOR, then honor FORCE_COLOR /
    /// CLICOLOR_FORCE for callers redirecting stderr (CI logs, test
    /// captures), then fall back to the TTY probe.
    static color_decision() -> boolean {
        // Presence forces the decision regardless of value (empty counts as
        // set, per no-color.org); the matched String is dropped immediately.
        match (env::var(Str::new("NO_COLOR")))       { Option::Some(_) => { return false; } Option::None => {} }
        match (env::var(Str::new("FORCE_COLOR")))    { Option::Some(_) => { return true;  } Option::None => {} }
        match (env::var(Str::new("CLICOLOR_FORCE"))) { Option::Some(_) => { return true;  } Option::None => {} }
        return stdio::is_tty(2);
    }
}


// DiagRenderer

/// Renders diagnostics with source snippets and (optionally) ANSI colors.
///
/// `out` is the `DiagSink` discriminator: `null` writes to the process's
/// stderr (fd 2, unbuffered); a non-null value is the `String*` buffer that
/// `render_to_string` temporarily points it at.  Every write goes through
/// `Utils::DiagSink`, which is `io::Write`-based - no `FILE*` involved.
type struct DiagRenderer {
    config:          RenderConfig;
    cached_files:    string[];
    cached_contents: string[];
    file_index:      HashMap<string, i64>;
    out:             void*;

    static new(config: RenderConfig) -> DiagRenderer {
        return DiagRenderer {
            config:          config,
            cached_files:    [],
            cached_contents: [],
            file_index:      HashMap<string, i64>::new(),
            out:             null,
        };
    }

    /// The configured left-gutter prefix prepended to every structural
    /// line (see `RenderConfig::leading_pad`).
    lead(&this) -> string { return this.config.leading_pad; }

    /// Load a source file into the cache.  Returns true if the file was
    /// loaded (or was already cached).
    load_source(mut &this, filepath: string) -> boolean {
        if (this.has_source(filepath)) {
            return true;
        }

        if (!metadata::exists(Path::from_cstr(filepath))) {
            return false;
        }

        // Load the file content into memory.
        mut content: string = "";
        match (file::read_to_string(Path::from_cstr(filepath))) {
            Result::Ok(s)  => { content = s.into_raw(); }
            Result::Err(_) => { return false; }
        }

        const idx: i64 = this.cached_files.length as i64;
        this.cached_files.push(filepath);
        this.cached_contents.push(content);
        this.file_index.insert(filepath, idx);
        return true;
    }

    /// Check whether a file is already in the source cache.
    has_source(&this, filepath: string) -> boolean {
        return this.file_index.contains_key(&filepath);
    }

    /// Get the content of a cached source file, or "" if not cached.
    get_content(&this, filepath: string) -> string {
        const opt: Option<i64> = this.file_index.get(&filepath);
        if (opt.is_some()) {
            return this.cached_contents[opt.unwrap()];
        }
        return "";
    }

    /// Extract a single line (1-indexed) from a cached source file.
    /// Returns "" if the file is not cached or the line doesn't exist.
    get_line(&this, filepath: string, line_num: u32) -> string {
        const content: string = this.get_content(filepath);
        if (content == "") {
            return "";
        }

        const content_len: i64 = content.length() as i64;

        // Walk through the content counting newlines to find the target line.
        // Lines are 1-indexed.
        mut current_line: u32 = 1;
        mut line_start: i64 = 0;

        // If the target is line 1, line_start is already 0.
        // Otherwise, advance past newlines until we reach the target line.
        if (line_num > 1) {
            for (mut pos: i64 = 0; pos < content_len; pos++) {
                const ch: i8* = (content as i8*) + pos;
                if (*ch == 10) {  // '\n' = ASCII 10
                    current_line += 1;
                    if (current_line == line_num) {
                        line_start = pos + 1;
                        break;
                    }
                }
            }
            // If we didn't reach the target line, it doesn't exist.
            if (current_line < line_num) {
                return "";
            }
        }

        // Find the end of this line (next newline or end of content).
        mut line_end: i64 = content_len;
        for (mut pos: i64 = line_start; pos < content_len; pos++) {
            const ch: i8* = (content as i8*) + pos;
            if (*ch == 10) {  // '\n'
                line_end = pos;
                break;
            }
        }

        // Handle trailing '\r' for CRLF line endings.
        if (line_end > line_start) {
            const prev: i8* = (content as i8*) + (line_end - 1);
            if (*prev == 13) {  // '\r' = ASCII 13
                line_end -= 1;
            }
        }

        const line_len: i64 = line_end - line_start;
        if (line_len <= 0) {
            return "";
        }

        // Copy the line into a new buffer.
        const buf: i8* = intrinsics::malloc(line_len + 1) as i8*;
        if (buf == null) {
            return "";
        }
        const src: i8* = (content as i8*) + line_start;
        intrinsics::memcpy(buf as void*, src as void*, line_len as u64);
        const term: i8* = buf + line_len;
        intrinsics::memset(term as void*, 0, 1);

        return buf as string;
    }


    // Color helpers

    color_reset(&this) -> string {
        return if (this.config.colors) { ANSI_RESET } else { "" };
    }

    color_bold(&this) -> string {
        return if (this.config.colors) { ANSI_BOLD } else { "" };
    }

    color_red(&this) -> string {
        return if (this.config.colors) { ANSI_RED } else { "" };
    }

    color_yellow(&this) -> string {
        return if (this.config.colors) { ANSI_YELLOW } else { "" };
    }

    color_cyan(&this) -> string {
        return if (this.config.colors) { ANSI_CYAN } else { "" };
    }

    color_blue(&this) -> string {
        return if (this.config.colors) { ANSI_BLUE } else { "" };
    }

    color_green(&this) -> string {
        return if (this.config.colors) { ANSI_GREEN } else { "" };
    }

    color_white(&this) -> string {
        return if (this.config.colors) { ANSI_WHITE } else { "" };
    }

    color_grey(&this) -> string {
        return if (this.config.colors) { ANSI_GREY } else { "" };
    }

    /// Print `message` to `out`, bolding any text wrapped in matching
    /// backticks so identifier and type-name references stand out from
    /// the prose around them.  Backticks are always retained around the
    /// bolded span so the symbol stays visually delimited even when
    /// colors are off or stripped (NO_COLOR, piped output, copy/paste).
    ///
    /// `base_color` is the ANSI sequence to restore after each bolded
    /// span (so the surrounding label keeps its color); pass `""` to
    /// fall back to the default text style.
    print_message(&this, out: void*, message: string, base_color: string) -> void {
        if (message == null as string) { return; }
        const len: i64 = message.length() as i64;
        if (len == 0) { return; }

        const bold:  string = this.color_bold();
        const reset: string = this.color_reset();
        const colors_on:   boolean = this.config.colors;
        const keep_ticks:  boolean = true;

        mut i: i64 = 0;
        mut in_code: boolean = false;
        while (i < len) {
            const ch: i8 = message[i];
            if (ch == 96) {  // '`'
                if (!in_code) {
                    if (colors_on) {
                        DiagSink::emit_raw(out, bold);
                    }
                    if (keep_ticks) {
                        DiagSink::emit_byte(out, ch);
                    }
                    in_code = true;
                } else {
                    if (keep_ticks) {
                        DiagSink::emit_byte(out, ch);
                    }
                    if (colors_on) {
                        DiagSink::emit_raw(out, reset);
                        DiagSink::emit_raw(out, base_color);
                    }
                    in_code = false;
                }
                i = i + 1;
                continue;
            }
            // Emit one byte verbatim - a single UTF-8 lead/continuation byte
            // flows through unchanged.
            DiagSink::emit_byte(out, ch);
            i = i + 1;
        }
        if (in_code && colors_on) {
            // Unclosed backtick: best-effort reset so we don't leak
            // bold formatting into following lines.
            DiagSink::emit_raw(out, reset);
            DiagSink::emit_raw(out, base_color);
        }
    }

    /// Print one source line through the syntax highlighter, with
    /// tabs expanded to spaces on the way out so caret math (which
    /// counts cells, not bytes) lines up with what the terminal
    /// actually renders.  The expanded copy is heap-allocated and
    /// freed after the print; the original cached line is untouched.
    print_source_line(&this, out: void*, line_text: string) -> void {
        const expanded: string = DiagRenderer::expand_tabs(line_text);
        SyntaxHighlighter::print_line(out, expanded, this.config.colors);
        if (expanded != line_text) {
            intrinsics::free(expanded as void*);
        }
    }

    /// Return the ANSI color code for a given severity level.
    severity_color(&this, sev: Severity) -> string {
        return match (sev) {
            Severity::Error   => { this.color_red()    }
            Severity::Warning => { this.color_yellow() }
            Severity::Note    => { this.color_cyan()   }
            Severity::Help    => { this.color_green()  }
        };
    }

    // Left-gutter emitters (the `<lead><n> |` margin column).  Factored out
    // because the exact byte layout repeats ~15 times across the snippet,
    // caret, secondary-label, and suggestion renderers.

    /// Blank gutter (padded, no line number): `<lead><line_width spaces>
    /// <blue>|<reset><tail>`.  `tail` is `" "` before a caret/source line or
    /// `"\n"` for a bare margin.
    emit_gutter_blank(&this, out: void*, line_width: u32, tail: string) -> void {
        DiagSink::emit_raw(out, this.lead());
        DiagSink::emit_pad(out, line_width as i32);
        DiagSink::emit_raw(out, " ");
        DiagSink::emit_raw(out, this.color_blue());
        DiagSink::emit_raw(out, "|");
        DiagSink::emit_raw(out, this.color_reset());
        DiagSink::emit_raw(out, tail);
    }

    /// Numbered gutter: `<lead><num_pre><ln right-justified in line_width>
    /// <reset> <blue>|<reset><tail>`.  `num_pre` is the ANSI prefix before the
    /// number - grey for a context line, or bold+severity for the error line.
    emit_gutter_num(&this, out: void*, num_pre: string, line_width: u32,
                    ln: u32, tail: string) -> void {
        DiagSink::emit_raw(out, this.lead());
        DiagSink::emit_raw(out, num_pre);
        DiagSink::emit_uint(out, ln as u64, line_width as i32);
        DiagSink::emit_raw(out, this.color_reset());
        DiagSink::emit_raw(out, " ");
        DiagSink::emit_raw(out, this.color_blue());
        DiagSink::emit_raw(out, "|");
        DiagSink::emit_raw(out, this.color_reset());
        DiagSink::emit_raw(out, tail);
    }


    // Rendering

    /// Render a diagnostic to the destination stream, preceded by a
    /// severity-tinted rule.  This is the terminal entry point used by
    /// `DiagnosticSink::flush`.
    render(mut &this, diag: &Diagnostic) -> void {
        // 0. Top rule
        this.render_rule(diag.severity);

        // 1..5: the diagnostic body.
        this.render_body(diag);
    }

    /// Render `diag` into a freshly-allocated `String` rather than the
    /// terminal.  This is the form the language server embeds in an LSP
    /// diagnostic's `message`, so editors can show the full report -
    /// header, source snippet, carets, secondary labels, notes, and
    /// suggestions - on hover or in the problems panel.
    ///
    /// No leading rule and no ANSI escapes: callers construct the
    /// renderer with `RenderConfig::plain()`.
    ///
    /// Cross-platform with no `FILE*` at all: `this.out` is pointed at a
    /// local `String` (the sink treats a non-null `out` as a `String*`
    /// buffer), the body is rendered into it, and `out` is restored so the
    /// renderer stays reusable for terminal output.
    render_to_string(mut &this, diag: Diagnostic) -> String {
        mut buf: String = String::new();
        const saved: void* = this.out;
        this.out = (&buf) as void*;
        this.render_body(&diag);
        this.out = saved;
        return buf;
    }

    /// Render the diagnostic itself - header, snippet(s), secondary
    /// labels, children, suggestions - without the leading rule.
    /// Shared by `render` (terminal) and `render_to_string` (language
    /// server).
    render_body(mut &this, diag: &Diagnostic) -> void {
        const out: void* = this.out;

        // 1. Header line:  error[E0200]: message
        this.render_header(diag);

        // 2. Primary + same-file secondaries: combined snippet when
        //    any secondary lives in the primary's file (one snippet
        //    block, line groups separated by `...`).  Otherwise fall
        //    back to the single-span snippet.
        if (diag.span.has_location()) {
            this.load_source(diag.span.file);
            if (this.has_same_file_secondary(diag)) {
                this.render_combined_snippet(diag);
            } else {
                // Prefer the primary label's caption for the inline caret
                // when the emission site set one (e.g. `at_with_label` used
                // to surface `expected X, found Y` separately from the
                // headline).  Falls back to the headline for legacy
                // emission sites that only call `at(span)`.
                const caption: string = this.primary_label_caption(diag);
                this.render_snippet(diag.span, diag.severity, caption);
            }
        }

        // 3. Cross-file secondary labels (rendered as separate snippets
        //    since they can't share a margin with the primary).
        for (mut i: int = 0; i < diag.labels.length; i++) {
            const label: SpanLabel = diag.labels[i];
            if (label.is_primary) { continue; }
            if (!label.span.has_location()) { continue; }
            if (label.span.file == diag.span.file && diag.span.has_location()) {
                continue;  // already rendered in the combined block
            }
            this.load_source(label.span.file);
            this.render_secondary_span(label);
        }

        // Section divider between the diagnostic report (header +
        // snippet + cross-file labels) and the compiler-suggestion
        // block (children + suggestions).  Grey rather than severity-
        // tinted so it reads as a within-diagnostic separator instead
        // of the start of a new diagnostic.
        const has_followup: boolean =
            diag.children.length > 0 || diag.suggestions.length > 0;
        if (has_followup) {
            const div_bold:  string = this.color_bold();
            const div_grey:  string = this.color_grey();
            const div_reset: string = this.color_reset();
            DiagSink::emit_raw(out, div_bold);
            DiagSink::emit_raw(out, div_grey);
            DiagSink::emit_raw(out, "================================================================================");
            DiagSink::emit_raw(out, div_reset);
            DiagSink::emit_raw(out, "\n");
        }

        // 4. Children (notes, helps)
        for (mut i: int = 0; i < diag.children.length; i++) {
            const child: &Diagnostic = &diag.children[i];
            this.render_child(child);
        }

        // 5. Suggestions
        for (mut i: int = 0; i < diag.suggestions.length; i++) {
            const sug: &Suggestion = &diag.suggestions[i];
            this.render_suggestion(sug);
        }

        // Trailing blank line for separation
        DiagSink::emit_raw(out, "\n");
    }

    /// Print a horizontal rule of `=` characters tinted with the diagnostic
    /// severity color. Emitted before each diagnostic; doubles as the
    /// separator from the prior one.
    render_rule(&this, severity: Severity) -> void {
        const sev_color: string = this.severity_color(severity);
        const bold: string  = this.color_bold();
        const reset: string = this.color_reset();
        DiagSink::emit_raw(this.out, bold);
        DiagSink::emit_raw(this.out, sev_color);
        DiagSink::emit_raw(this.out, "================================================================================");
        DiagSink::emit_raw(this.out, reset);
        DiagSink::emit_raw(this.out, "\n");
    }

    /// The inline caption to print under the caret for a single-snippet
    /// render.  Returns the primary label's message when an emission
    /// site set one via `at_with_label`; otherwise falls back to the
    /// diagnostic's headline so legacy `at(span)` callers keep their
    /// "Header line repeats under the caret" output unchanged.
    primary_label_caption(&this, diag: &Diagnostic) -> string {
        for (mut i: int = 0; i < diag.labels.length; i++) {
            const lbl: SpanLabel = diag.labels[i];
            if (!lbl.is_primary)             { continue; }
            if (!lbl.span.has_location())    { continue; }
            if (lbl.span.start_line != diag.span.start_line) { continue; }
            if (lbl.span.start_col  != diag.span.start_col)  { continue; }
            if (lbl.message == "")           { continue; }
            return lbl.message;
        }
        return diag.message;
    }

    /// True if the diagnostic has at least one secondary label that
    /// shares the primary span's file. Cross-file secondaries are kept
    /// out of the combined block so the margin/line numbers stay
    /// coherent.
    has_same_file_secondary(&this, diag: &Diagnostic) -> boolean {
        if (!diag.span.has_location()) { return false; }
        for (mut i: int = 0; i < diag.labels.length; i++) {
            const lbl: SpanLabel = diag.labels[i];
            if (lbl.is_primary) { continue; }
            if (!lbl.span.has_location()) { continue; }
            if (lbl.span.file == diag.span.file) { return true; }
        }
        return false;
    }

    /// Render the header line:  error[E0200]: message
    render_header(&this, diag: &Diagnostic) -> void {
        const sev_color: string = this.severity_color(diag.severity);
        const bold: string = this.color_bold();
        const reset: string = this.color_reset();
        const white: string = this.color_white();
        const out: void* = this.out;

        // Severity + code chip, then the headline.  The message body
        // goes through `print_message` so backticked code like `i32`
        // can be re-bolded after we drop out of the headline's white
        // base color.
        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, sev_color);
        DiagSink::emit_raw(out, diag.severity.label());
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, "[");
        DiagSink::emit_raw(out, diag.code.format());
        DiagSink::emit_raw(out, "]");
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, ": ");
        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, white);
        this.print_message(out, diag.message, white);
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, "\n");
    }

    /// Render a source snippet with caret underline for the primary span.
    render_snippet(mut &this, span: SourceSpan, severity: Severity, message: string) -> void {
        const blue: string  = this.color_blue();
        const reset: string = this.color_reset();
        const bold: string  = this.color_bold();
        const grey: string  = this.color_grey();
        const out: void* = this.out;

        // Arrow line:  --> file:line:col
        DiagSink::emit_raw(out, this.lead());
        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, blue);
        DiagSink::emit_raw(out, "-->");
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, " ");
        DiagSink::emit_raw(out, span.file);
        DiagSink::emit_raw(out, ":");
        DiagSink::emit_int(out, span.start_line as u64);
        DiagSink::emit_raw(out, ":");
        DiagSink::emit_int(out, span.start_col as u64);
        DiagSink::emit_raw(out, "\n");

        // Width of the line-number column, sized to the largest line we'll
        // render (start + trailing context).
        const ctx: u32 = this.config.context_lines;
        const line_width: u32 = this.line_number_width(span.start_line + ctx);

        // Top margin
        this.render_margin(line_width);

        mut first_line: u32 = span.start_line;
        if (first_line > ctx) {
            first_line -= ctx;
        } else {
            first_line = 1;
        }

        // Render context lines before the error
        for (mut ln: u32 = first_line; ln < span.start_line; ln++) {
            const line_text: string = this.get_line(span.file, ln);
            DiagSink::emit_raw(out, this.lead());
            DiagSink::emit_raw(out, grey);
            DiagSink::emit_uint(out, ln as u64, line_width as i32);
            DiagSink::emit_raw(out, reset);
            DiagSink::emit_raw(out, " ");
            DiagSink::emit_raw(out, blue);
            DiagSink::emit_raw(out, "|");
            DiagSink::emit_raw(out, reset);
            DiagSink::emit_raw(out, " ");
            this.print_source_line(out, line_text);
            DiagSink::emit_raw(out, "\n");
        }

        // Render the error line
        const error_line: string = this.get_line(span.file, span.start_line);
        DiagSink::emit_raw(out, this.lead());
        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, blue);
        DiagSink::emit_uint(out, span.start_line as u64, line_width as i32);
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, " ");
        DiagSink::emit_raw(out, blue);
        DiagSink::emit_raw(out, "|");
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, " ");
        this.print_source_line(out, error_line);
        DiagSink::emit_raw(out, "\n");

        // Render the caret underline
        this.render_underline(span, severity, message, line_width);

        // Context lines after
        const last_ctx: u32 = span.start_line + ctx;
        for (mut ln: u32 = span.start_line + 1; ln <= last_ctx; ln++) {
            const line_text: string = this.get_line(span.file, ln);
            if (line_text == "" && ln > span.start_line + 1) {
                break;  // Stop at empty lines past the first one
            }
            this.emit_gutter_num(out, grey, line_width, ln, " ");
            this.print_source_line(out, line_text);
            DiagSink::emit_raw(out, "\n");
        }

        // Bottom margin
        this.render_margin(line_width);
    }

    /// Render a margin-only line:  "   |"
    render_margin(&this, line_width: u32) -> void {
        this.emit_gutter_blank(this.out, line_width, "\n");
    }

    /// Render an ellipsis line that separates non-adjacent line groups
    /// in a combined snippet:  "..."
    render_ellipsis(&this, line_width: u32) -> void {
        const blue: string  = this.color_blue();
        const reset: string = this.color_reset();
        DiagSink::emit_raw(this.out, blue);
        DiagSink::emit_pad(this.out, line_width as i32);
        DiagSink::emit_raw(this.out, "...");
        DiagSink::emit_raw(this.out, reset);
        DiagSink::emit_raw(this.out, "\n");
    }

    /// Width of the largest line number a snippet will render, used to
    /// right-align the line-number column so the `|` divider falls on a
    /// single x-position.  Returns the natural decimal-digit count of
    /// `max_line` - no artificial minimum, so a snippet spanning lines
    /// 55..58 prints a 2-cell column rather than padding every line with
    /// leading space.
    line_number_width(&this, max_line: u32) -> u32 {
        mut w: u32 = 1;
        mut n: u32 = max_line;
        while (n >= 10) {
            n = n / 10;
            w++;
        }
        return w;
    }

    /// Build a sorted list of labels in the primary span's file. The
    /// result is stable on tied lines, so multiple labels on the same
    /// line preserve their original (push) order.
    collect_same_file_labels(&this, diag: &Diagnostic) -> SpanLabel[] {
        mut out: SpanLabel[] = [];
        for (mut i: int = 0; i < diag.labels.length; i++) {
            const lbl: SpanLabel = diag.labels[i];
            if (!lbl.span.has_location()) { continue; }
            if (lbl.span.file != diag.span.file) { continue; }
            out.push(lbl);
        }
        // Insertion sort by start_line (small N, stable).
        for (mut i: int = 1; i < out.length; i++) {
            for (mut j: int = i; j > 0; j--) {
                if (out[j].span.start_line < out[j - 1].span.start_line) {
                    const tmp: SpanLabel = out[j];
                    out[j] = out[j - 1];
                    out[j - 1] = tmp;
                } else {
                    break;
                }
            }
        }
        return out;
    }

    /// Render a combined snippet that folds the primary span and every
    /// same-file secondary label into one block. Line groups are merged
    /// when their +/-context_lines windows overlap; otherwise they're
    /// separated by a `...` ellipsis row.
    render_combined_snippet(mut &this, diag: &Diagnostic) -> void {
        const blue: string  = this.color_blue();
        const reset: string = this.color_reset();
        const bold: string  = this.color_bold();
        const out: void* = this.out;

        const primary_span: SourceSpan = diag.span;
        const labels: SpanLabel[] = this.collect_same_file_labels(diag);
        if (labels.length == 0) {
            // Nothing to combine; fall back to single-span rendering.
            this.render_snippet(primary_span, diag.severity, diag.message);
            return;
        }

        // Compute line-number column width from the largest line we'll
        // print across every group.
        const ctx: u32 = this.config.context_lines;
        mut max_line: u32 = primary_span.start_line + ctx;
        for (mut i: int = 0; i < labels.length; i++) {
            const ln: u32 = labels[i].span.start_line + ctx;
            if (ln > max_line) { max_line = ln; }
        }
        const line_width: u32 = this.line_number_width(max_line);

        // Header arrow:  --> file:line:col  (always anchored at primary)
        DiagSink::emit_raw(out, this.lead());
        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, blue);
        DiagSink::emit_raw(out, "-->");
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, " ");
        DiagSink::emit_raw(out, primary_span.file);
        DiagSink::emit_raw(out, ":");
        DiagSink::emit_int(out, primary_span.start_line as u64);
        DiagSink::emit_raw(out, ":");
        DiagSink::emit_int(out, primary_span.start_col as u64);
        DiagSink::emit_raw(out, "\n");

        this.render_margin(line_width);

        // Walk labels in line order, accumulating a "current group"
        // [group_start..group_end]. When the next label's window
        // doesn't touch the current group, flush + ellipsis + start a
        // new group. Group windows are inclusive.
        mut group_start: u32 = 0;
        mut group_end:   u32 = 0;
        mut have_group:  boolean = false;

        for (mut i: int = 0; i < labels.length; i++) {
            const lbl: SpanLabel = labels[i];
            const ln: u32 = lbl.span.start_line;
            const want_start: u32 = if (ln > ctx) { ln - ctx } else { 1 };
            const want_end:   u32 = ln + ctx;

            if (!have_group) {
                group_start = want_start;
                group_end   = want_end;
                have_group  = true;
            } else if (want_start <= group_end + 1) {
                if (want_end > group_end) { group_end = want_end; }
            } else {
                this.render_line_group(diag.severity, primary_span.file,
                                       group_start, group_end,
                                       labels.as_slice(), line_width);
                this.render_ellipsis(line_width);
                group_start = want_start;
                group_end   = want_end;
            }
        }
        if (have_group) {
            this.render_line_group(diag.severity, primary_span.file,
                                   group_start, group_end,
                                   labels.as_slice(), line_width);
        }

        this.render_margin(line_width);
    }

    /// Render a contiguous line range as part of a combined snippet.
    /// For each line in [start_line..end_line]: print the line itself
    /// (bold blue line-number when it carries a label, grey otherwise),
    /// then one underline row per label that anchors on that line.
    render_line_group(mut &this, severity: Severity, file: string,
                      start_line: u32, end_line: u32,
                      labels: Slice<SpanLabel>, line_width: u32) -> void {
        const blue: string  = this.color_blue();
        const reset: string = this.color_reset();
        const grey: string  = this.color_grey();
        const bold: string  = this.color_bold();
        const out: void* = this.out;

        for (mut ln: u32 = start_line; ln <= end_line; ln++) {
            const line_text: string = this.get_line(file, ln);
            // get_line returns "" for both empty and out-of-bounds; if
            // we've passed the end of file there's nothing more to do.
            // Detect end-of-file by trying one line further than the
            // first empty: if the *next* line is also empty AND we're
            // past the last labeled line, stop.
            mut has_label: boolean = false;
            for (mut k: u64 = 0; k < labels.length; k++) {
                if (labels.get_ref(k).unwrap().span.start_line == ln) { has_label = true; break; }
            }

            if (line_text == "" && !has_label) {
                // Print blank line with line-number column (preserves
                // the convention for genuinely blank lines inside a
                // group). If we've actually run off the file end, the
                // caller already bounded us by max_line, so this is
                // safe.
                this.emit_gutter_num(out, grey, line_width, ln, "\n");
                continue;
            }

            if (has_label) {
                DiagSink::emit_raw(out, this.lead());
                DiagSink::emit_raw(out, bold);
                DiagSink::emit_raw(out, blue);
                DiagSink::emit_uint(out, ln as u64, line_width as i32);
                DiagSink::emit_raw(out, reset);
                DiagSink::emit_raw(out, " ");
                DiagSink::emit_raw(out, blue);
                DiagSink::emit_raw(out, "|");
                DiagSink::emit_raw(out, reset);
                DiagSink::emit_raw(out, " ");
            } else {
                this.emit_gutter_num(out, grey, line_width, ln, " ");
            }
            this.print_source_line(out, line_text);
            DiagSink::emit_raw(out, "\n");

            if (has_label) {
                this.render_labels_for_line(labels, file, ln, severity, line_width);
            }
        }
    }

    /// Render every label whose primary span starts on `line_num`,
    /// either as one stacked block (two labels = rustc-style side-by-
    /// side carets with a connector + caption row) or as the legacy
    /// one-row-per-label rendering when there's only one or when the
    /// labels are too many to stack cleanly.
    render_labels_for_line(mut &this, all_labels: Slice<SpanLabel>, file: string,
                            line_num: u32, severity: Severity,
                            line_width: u32) -> void {
        mut on_line: SpanLabel[] = [];
        for (mut k: u64 = 0; k < all_labels.length; k++) {
            const lbl: SpanLabel* = all_labels.get_ref(k).unwrap();
            if (lbl.span.start_line == line_num) {
                on_line.push(*lbl);
            }
        }
        if (on_line.length == 0) { return; }
        if (on_line.length == 1) {
            this.render_label_underline(on_line[0], severity, line_width);
            return;
        }

        // Insertion sort by start_col ascending so we can pick out
        // "rightmost" by index.  Stable: ties keep insertion order.
        for (mut i: i64 = 1; i < on_line.length; i++) {
            for (mut j: i64 = i; j > 0; j--) {
                if (on_line[j].span.start_col < on_line[j - 1].span.start_col) {
                    const tmp: SpanLabel = on_line[j];
                    on_line[j] = on_line[j - 1];
                    on_line[j - 1] = tmp;
                } else {
                    break;
                }
            }
        }

        // 2-label case gets the stacked rendering; 3+ falls back to
        // one-row-per-label so we don't have to solve the multi-level
        // connector layout problem here.
        if (on_line.length == 2) {
            this.render_stacked_two_labels(on_line[0], on_line[1],
                file, line_num, severity, line_width);
            return;
        }

        for (mut k: i64 = 0; k < on_line.length; k++) {
            this.render_label_underline(on_line[k], severity, line_width);
        }
    }

    /// Render two labels on the same line as one combined underline
    /// row + connector + caption stack:
    ///
    ///       |     ---   ^^^^^^^^ found `string`
    ///       |     |
    ///       |     expected because of this annotation
    ///
    /// `left` and `right` are pre-sorted by ascending start_col.  Both
    /// labels' colors come from severity/primary-ness; primary wins
    /// when caret ranges overlap.
    render_stacked_two_labels(mut &this, left: SpanLabel, right: SpanLabel,
                               file: string, line_num: u32,
                               severity: Severity, line_width: u32) -> void {
        const blue:  string = this.color_blue();
        const cyan:  string = this.color_cyan();
        const reset: string = this.color_reset();
        const bold:  string = this.color_bold();
        const sev_color: string = this.severity_color(severity);
        const out: void* = this.out;

        const line_text: string = this.get_line(file, line_num);

        const left_vs: u32 = DiagRenderer::byte_col_to_visual(line_text, left.span.start_col);
        const left_ve: u32 = if (left.span.end_col > left.span.start_col) {
            DiagRenderer::byte_col_to_visual(line_text, left.span.end_col)
        } else { left_vs + 1 };
        const right_vs: u32 = DiagRenderer::byte_col_to_visual(line_text, right.span.start_col);
        const right_ve: u32 = if (right.span.end_col > right.span.start_col) {
            DiagRenderer::byte_col_to_visual(line_text, right.span.end_col)
        } else { right_vs + 1 };

        // Underline row.  Walk cells 1..max(left_ve, right_ve) and pick
        // the glyph for each cell; primary wins inside an overlap zone.
        this.emit_gutter_blank(out, line_width, " ");
        mut max_cell: u32 = if (right_ve > left_ve) { right_ve } else { left_ve };
        for (mut cell: u32 = 1; cell < max_cell; cell++) {
            const in_left:  boolean = cell >= left_vs  && cell < left_ve;
            const in_right: boolean = cell >= right_vs && cell < right_ve;
            if (!in_left && !in_right) {
                DiagSink::emit_raw(out, " ");
                continue;
            }
            // Glyph + color preference: primary wins.
            mut is_primary: boolean = false;
            if (in_left  && left.is_primary)  { is_primary = true; }
            if (in_right && right.is_primary) { is_primary = true; }
            const glyph: string = if (is_primary) { "^" } else { "-" };
            const color: string = if (is_primary) { sev_color } else { cyan };
            DiagSink::emit_raw(out, bold);
            DiagSink::emit_raw(out, color);
            DiagSink::emit_raw(out, glyph);
            DiagSink::emit_raw(out, reset);
        }

        // Append the rightmost label's caption inline.
        if (right.message != "") {
            const right_color: string = if (right.is_primary) { sev_color } else { cyan };
            DiagSink::emit_raw(out, " ");
            DiagSink::emit_raw(out, bold);
            DiagSink::emit_raw(out, right_color);
            this.print_message(out, right.message, right_color);
            DiagSink::emit_raw(out, reset);
        }
        DiagSink::emit_raw(out, "\n");

        // Connector row for the left label.
        this.emit_gutter_blank(out, line_width, " ");
        const left_color: string = if (left.is_primary) { sev_color } else { cyan };
        for (mut cell: u32 = 1; cell < left_vs; cell++) {
            DiagSink::emit_raw(out, " ");
        }
        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, left_color);
        DiagSink::emit_raw(out, "|");
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, "\n");

        // Caption row for the left label.
        if (left.message != "") {
            this.emit_gutter_blank(out, line_width, " ");
            for (mut cell: u32 = 1; cell < left_vs; cell++) {
                DiagSink::emit_raw(out, " ");
            }
            DiagSink::emit_raw(out, bold);
            DiagSink::emit_raw(out, left_color);
            this.print_message(out, left.message, left_color);
            DiagSink::emit_raw(out, reset);
            DiagSink::emit_raw(out, "\n");
        }
    }

    /// Render the underline row for a single label inside a combined
    /// snippet. Primaries get `^^^^` in the diagnostic's severity
    /// color; secondaries get `----` in cyan, matching the
    /// "value moved here" caption style.
    render_label_underline(&this, label: SpanLabel, severity: Severity,
                           line_width: u32) -> void {
        const blue: string  = this.color_blue();
        const reset: string = this.color_reset();
        const bold: string  = this.color_bold();
        const out: void* = this.out;

        const span: SourceSpan = label.span;
        // Visual cells, not bytes: a tab counts as up to 4 cells, a
        // multi-byte UTF-8 codepoint counts as 1.  Without this the
        // carets drift right of their target on tab-indented source.
        const line_text: string = this.get_line(span.file, span.start_line);
        const visual_start: u32 = DiagRenderer::byte_col_to_visual(line_text, span.start_col);
        mut ul_start: u32 = 0;
        if (visual_start > 0) { ul_start = visual_start - 1; }
        mut ul_len: u32 = 1;
        if (span.end_col > span.start_col) {
            ul_len = DiagRenderer::byte_range_visual_width(line_text, span.start_col, span.end_col);
        }

        this.emit_gutter_blank(out, line_width, " ");
        for (mut s: u32 = 0; s < ul_start; s++) {
            DiagSink::emit_raw(out, " ");
        }

        const caption_color: string = if (label.is_primary) {
            this.severity_color(severity)
        } else {
            this.color_cyan()
        };
        const caret_char: string = if (label.is_primary) { "^" } else { "-" };

        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, caption_color);
        DiagSink::emit_raw(out, caret_char);
        for (mut t: u32 = 1; t < ul_len; t++) {
            DiagSink::emit_raw(out, caret_char);
        }

        if (label.message != "") {
            DiagSink::emit_raw(out, " ");
            this.print_message(out, label.message, caption_color);
        }
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, "\n");
    }

    /// Render the caret underline below a source line.
    render_underline(&this, span: SourceSpan, severity: Severity, message: string,
                     line_width: u32) -> void {
        const blue: string      = this.color_blue();
        const reset: string     = this.color_reset();
        const bold: string      = this.color_bold();
        const sev_color: string = this.severity_color(severity);
        const out: void* = this.out;

        // Calculate underline position in *visual cells* - see the
        // header comments at the top of this file for the byte-to-cell
        // conversion contract.
        const line_text: string = this.get_line(span.file, span.start_line);
        const visual_start: u32 = DiagRenderer::byte_col_to_visual(line_text, span.start_col);
        mut ul_start: u32 = 0;
        if (visual_start > 0) {
            ul_start = visual_start - 1;
        }

        mut ul_len: u32 = 1;
        if (span.end_col > span.start_col) {
            ul_len = DiagRenderer::byte_range_visual_width(line_text, span.start_col, span.end_col);
        }

        // Build the underline string: spaces + ^ + ~~~
        // Leading spaces for margin + pipe + gap
        this.emit_gutter_blank(out, line_width, " ");

        // Spaces to reach the underline start
        for (mut s: u32 = 0; s < ul_start; s++) {
            DiagSink::emit_raw(out, " ");
        }

        // The caret and tildes
        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, sev_color);
        DiagSink::emit_raw(out, "^");
        for (mut t: u32 = 1; t < ul_len; t++) {
            DiagSink::emit_raw(out, "~");
        }

        // Inline label
        if (message != "") {
            DiagSink::emit_raw(out, " ");
            this.print_message(out, message, sev_color);
        }

        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, "\n");
    }

    /// Render a secondary span:  :: file:line:col  with cyan underline.
    render_secondary_span(mut &this, label: SpanLabel) -> void {
        const blue: string  = this.color_blue();
        const cyan: string  = this.color_cyan();
        const bold: string  = this.color_bold();
        const reset: string = this.color_reset();
        const grey: string  = this.color_grey();
        const out: void* = this.out;

        // Secondary arrow:  :: file:line:col
        DiagSink::emit_raw(out, this.lead());
        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, blue);
        DiagSink::emit_raw(out, "::");
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, " ");
        DiagSink::emit_raw(out, label.span.file);
        DiagSink::emit_raw(out, ":");
        DiagSink::emit_int(out, label.span.start_line as u64);
        DiagSink::emit_raw(out, ":");
        DiagSink::emit_int(out, label.span.start_col as u64);
        DiagSink::emit_raw(out, "\n");

        const line_width: u32 = this.line_number_width(label.span.start_line);

        this.render_margin(line_width);

        // Render the source line
        const line_text: string = this.get_line(label.span.file, label.span.start_line);
        this.emit_gutter_num(out, grey, line_width, label.span.start_line, " ");
        this.print_source_line(out, line_text);
        DiagSink::emit_raw(out, "\n");

        // Cyan underline - visual cells, not bytes.
        const visual_start: u32 = DiagRenderer::byte_col_to_visual(line_text, label.span.start_col);
        mut ul_start: u32 = 0;
        if (visual_start > 0) {
            ul_start = visual_start - 1;
        }
        mut ul_len: u32 = 1;
        if (label.span.end_col > label.span.start_col) {
            ul_len = DiagRenderer::byte_range_visual_width(line_text,
                label.span.start_col, label.span.end_col);
        }

        this.emit_gutter_blank(out, line_width, " ");
        for (mut s: u32 = 0; s < ul_start; s++) {
            DiagSink::emit_raw(out, " ");
        }
        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, cyan);
        DiagSink::emit_raw(out, "^");
        for (mut t: u32 = 1; t < ul_len; t++) {
            DiagSink::emit_raw(out, "~");
        }
        if (label.message != "") {
            DiagSink::emit_raw(out, " ");
            this.print_message(out, label.message, cyan);
        }
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, "\n");

        this.render_margin(line_width);
    }

    /// Render a child diagnostic (note or help) without source context.
    render_child(mut &this, child: &Diagnostic) -> void {
        const bold: string  = this.color_bold();
        const reset: string = this.color_reset();
        const sev_color: string = this.severity_color(child.severity);
        const out: void* = this.out;

        // Severity prefix; the message body goes through `print_message`
        // so backticked identifiers/types are bolded inline.
        DiagSink::emit_raw(out, this.lead());
        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, sev_color);
        DiagSink::emit_raw(out, child.severity.label());
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, ": ");
        this.print_message(out, child.message, "");
        DiagSink::emit_raw(out, "\n");

        if (child.span.has_location()) {
            this.load_source(child.span.file);
            this.render_snippet(child.span, child.severity, child.message);
        }
    }

    /// Render a suggestion in green, with the replacement spliced into
    /// the original source line so the user sees the fix in context -
    /// rather than a free-floating "| length" row.  Each part gets:
    ///
    ///    help: a local with a similar name exists
    ///      |
    ///    3 |     const x: i32 = length;
    ///      |                    ~~~~~~  (replace)   /  ++++++ (insert) / ------ (delete)
    ///
    /// The diff glyph depends on the part's shape:
    ///   span_len > 0 && replacement != ""  ->  replace (~)
    ///   span_len > 0 && replacement == ""  ->  delete  (-)
    ///   span_len == 0 && replacement != "" ->  insert  (+)
    ///
    /// Multi-part suggestions render each part this way in order.  When
    /// the source line can't be loaded (foreign file the renderer
    /// hasn't cached) we fall back to the bare replacement row.
    render_suggestion(mut &this, sug: &Suggestion) -> void {
        const bold: string  = this.color_bold();
        const green: string = this.color_green();
        const reset: string = this.color_reset();
        const grey: string  = this.color_grey();
        const out: void* = this.out;

        const applicability_tag: string =
            match (sug.applicability) {
                Applicability::MachineApplicable => { " [machine-applicable]" }
                Applicability::HasPlaceholders   => { " [has-placeholders]"   }
                Applicability::MaybeIncorrect    => { " [maybe]"              }
                Applicability::Unspecified       => { ""                       }
            };
        DiagSink::emit_raw(out, this.lead());
        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, green);
        DiagSink::emit_raw(out, "suggestion");
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, grey);
        DiagSink::emit_raw(out, applicability_tag);
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, ": ");
        this.print_message(out, sug.message, "");
        DiagSink::emit_raw(out, "\n");

        for (mut i: i64 = 0; i < sug.parts.length; i++) {
            this.render_suggestion_part(sug.parts[i]);
        }
    }

    /// Render one (span, replacement) edit as a patched source-line
    /// snippet with a diff-glyph underline.  See `render_suggestion`
    /// for the glyph rules.
    render_suggestion_part(mut &this, part: SuggestionPart) -> void {
        const blue:  string = this.color_blue();
        const green: string = this.color_green();
        const grey:  string = this.color_grey();
        const reset: string = this.color_reset();
        const bold:  string = this.color_bold();
        const out: void* = this.out;

        // If the part has no real location, fall back to a bare row.
        if (!part.span.has_location()) {
            if (part.replacement != "") {
                DiagSink::emit_raw(out, this.lead());
                DiagSink::emit_raw(out, "   ");
                DiagSink::emit_raw(out, blue);
                DiagSink::emit_raw(out, "|");
                DiagSink::emit_raw(out, reset);
                DiagSink::emit_raw(out, " ");
                DiagSink::emit_raw(out, bold);
                DiagSink::emit_raw(out, green);
                DiagSink::emit_raw(out, part.replacement);
                DiagSink::emit_raw(out, reset);
                DiagSink::emit_raw(out, "\n");
            }
            return;
        }

        this.load_source(part.span.file);
        const orig_line: string = this.get_line(part.span.file, part.span.start_line);
        if (orig_line == "") {
            // Source not available; degrade to the bare replacement row.
            if (part.replacement != "") {
                DiagSink::emit_raw(out, this.lead());
                DiagSink::emit_raw(out, "   ");
                DiagSink::emit_raw(out, blue);
                DiagSink::emit_raw(out, "|");
                DiagSink::emit_raw(out, reset);
                DiagSink::emit_raw(out, " ");
                DiagSink::emit_raw(out, bold);
                DiagSink::emit_raw(out, green);
                DiagSink::emit_raw(out, part.replacement);
                DiagSink::emit_raw(out, reset);
                DiagSink::emit_raw(out, "\n");
            }
            return;
        }

        // Multi-line replacement: if the replacement contains a literal
        // `\n`, render each segment on its own row.  The first segment
        // is spliced into the anchor line (which gets a `~` indicator
        // since its content has changed); each subsequent segment is
        // shown as an inserted line - auto-indented to the anchor line's
        // leading whitespace and gutter-marked with `+`.  A single
        // trailing context line is pulled from the source so the user
        // sees what closes the construct (typically the `};` after a
        // struct literal).  Single-line replacements fall through to
        // the legacy splice-into-one-line path below.
        const repl_byte_count: i64 = if (part.replacement == null as string) {
            0
        } else {
            part.replacement.length() as i64
        };
        mut first_nl: i64 = -1;
        for (mut nl_i: i64 = 0; nl_i < repl_byte_count; nl_i++) {
            if ((part.replacement[nl_i] as u8) == (10 as u8)) {
                first_nl = nl_i;
                break;
            }
        }
        if (first_nl >= 0) {
            this.render_multiline_suggestion(part, orig_line, first_nl,
                repl_byte_count);
            return;
        }

        const span_len: u32 = if (part.span.end_col > part.span.start_col) {
            part.span.end_col - part.span.start_col
        } else {
            0
        };
        const has_repl: boolean = part.replacement != "" && part.replacement != null as string;

        // Diff-glyph dispatch.
        mut glyph: string = "~";
        if (span_len > 0 && !has_repl)      { glyph = "-"; }
        else if (span_len == 0 && has_repl) { glyph = "+"; }

        // Build the patched line by splicing replacement into the raw
        // source bytes.  The renderer's tab-expansion + visual-column
        // math then handles alignment for tab-indented files exactly
        // like it does for the primary snippet.
        const patched: string = DiagRenderer::splice_replacement(orig_line,
            part.span.start_col, part.span.end_col, part.replacement);

        // Line-number column width matches the patched line's natural
        // digit count (no artificial minimum, matching the primary snippet).
        const line_width: u32 = this.line_number_width(part.span.start_line);

        this.render_margin(line_width);

        // Patched source line, syntax-highlighted (replacement re-tokenises
        // cleanly inside the surrounding code).
        DiagSink::emit_raw(out, this.lead());
        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, blue);
        DiagSink::emit_uint(out, part.span.start_line as u64, line_width as i32);
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, " ");
        DiagSink::emit_raw(out, blue);
        DiagSink::emit_raw(out, "|");
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, " ");
        this.print_source_line(out, patched);
        DiagSink::emit_raw(out, "\n");

        // Underline row: green diff glyph under the affected portion of
        // the patched line.
        // start byte in the patched line: same as the original span.start_col
        // length:
        //   - replace / insert: strlen(replacement) bytes
        //   - delete:           1 cell at start_col
        const repl_byte_len: u32 = if (has_repl) {
            part.replacement.length() as u32
        } else {
            0
        };
        const visual_start: u32 = DiagRenderer::byte_col_to_visual(patched, part.span.start_col);
        mut ul_start: u32 = 0;
        if (visual_start > 0) { ul_start = visual_start - 1; }

        mut ul_len: u32 = 1;
        if (has_repl) {
            ul_len = DiagRenderer::byte_range_visual_width(patched,
                part.span.start_col, part.span.start_col + repl_byte_len);
        }

        this.emit_gutter_blank(out, line_width, " ");
        for (mut s: u32 = 0; s < ul_start; s++) {
            DiagSink::emit_raw(out, " ");
        }
        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, green);
        DiagSink::emit_raw(out, glyph);
        for (mut t: u32 = 1; t < ul_len; t++) {
            DiagSink::emit_raw(out, glyph);
        }
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, "\n");

        if (patched != orig_line) {
            intrinsics::free(patched as void*);
        }
    }

    /// Render a multi-line suggestion.  Called from `render_suggestion_part`
    /// when the replacement contains at least one `\n`.  Layout matches
    /// rustc's "diff" presentation:
    ///
    ///   |
    /// 53 ~     baz: "not a boolean",
    ///    +     buz: <boolean>
    /// 54 |     };
    ///   |
    ///
    /// `~` marks the existing anchor line whose content was modified
    /// (e.g. a trailing comma was appended); `+` rows are new lines the
    /// edit inserts; the line after with a `|` gutter is unmodified source
    /// shown as trailing context.  Inserted lines are auto-indented to
    /// the anchor line's leading whitespace so emission sites don't have
    /// to compute the indent themselves.
    render_multiline_suggestion(mut &this, part: SuggestionPart,
                                 orig_line: string, first_nl: i64,
                                 repl_byte_count: i64) -> void {
        const blue:  string = this.color_blue();
        const green: string = this.color_green();
        const grey:  string = this.color_grey();
        const reset: string = this.color_reset();
        const bold:  string = this.color_bold();
        const out: void* = this.out;

        // Splice the first segment (everything before the first `\n` in
        // the replacement) into the anchor line.  This is the line that
        // visually "changes": it now carries the appended punctuation
        // (`,`) or whatever leads off the multi-line edit.
        const first_seg: string = DiagRenderer::substring_bytes(part.replacement, 0, first_nl);
        const patched_first: string = DiagRenderer::splice_replacement(orig_line,
            part.span.start_col, part.span.end_col, first_seg);

        // Indent for inserted lines = anchor line's leading whitespace.
        const indent_n: i64 = DiagRenderer::leading_whitespace_count(orig_line);
        const indent_str: string = DiagRenderer::substring_bytes(orig_line, 0, indent_n);

        // Reserve enough digits for the largest line number we'll
        // render - up to two lines of trailing source context past the
        // anchor's end.  No artificial minimum; matches the primary
        // snippet's natural-width column.
        const line_width: u32 = this.line_number_width(part.span.end_line + 2);

        this.render_margin(line_width);

        // One line of leading context before the anchor (the line that
        // opens the construct, e.g. `Foo {`).  Skipped on file-start.
        if (part.span.start_line > 1) {
            const prev_ln: u32 = part.span.start_line - 1;
            const prev_text: string = this.get_line(part.span.file, prev_ln);
            if (prev_text != "") {
                this.emit_gutter_num(out, grey, line_width, prev_ln, " ");
                this.print_source_line(out, prev_text);
                DiagSink::emit_raw(out, "\n");
            }
        }

        // Anchor line: line number kept, but gutter switched to `~` so
        // a casual reader sees the change marker even without colour.
        DiagSink::emit_raw(out, this.lead());
        DiagSink::emit_raw(out, bold);
        DiagSink::emit_raw(out, green);
        DiagSink::emit_uint(out, part.span.start_line as u64, line_width as i32);
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, " ");
        DiagSink::emit_raw(out, green);
        DiagSink::emit_raw(out, "~");
        DiagSink::emit_raw(out, reset);
        DiagSink::emit_raw(out, " ");
        this.print_source_line(out, patched_first);
        DiagSink::emit_raw(out, "\n");

        // Underline the inserted slice on the anchor line.
        const first_seg_bytes: u32 = first_nl as u32;
        if (first_seg_bytes > 0) {
            const visual_start: u32 = DiagRenderer::byte_col_to_visual(patched_first,
                part.span.start_col);
            mut ul_start: u32 = 0;
            if (visual_start > 0) { ul_start = visual_start - 1; }
            const ul_len: u32 = DiagRenderer::byte_range_visual_width(patched_first,
                part.span.start_col, part.span.start_col + first_seg_bytes);
            this.emit_gutter_blank(out, line_width, " ");
            for (mut s: u32 = 0; s < ul_start; s++) {
                DiagSink::emit_raw(out, " ");
            }
            DiagSink::emit_raw(out, bold);
            DiagSink::emit_raw(out, green);
            for (mut t: u32 = 0; t < ul_len; t++) {
                DiagSink::emit_raw(out, "~");
            }
            DiagSink::emit_raw(out, reset);
            DiagSink::emit_raw(out, "\n");
        }

        // Each subsequent segment is a new inserted line: blank line-
        // number column, `+` gutter, anchor-indented content, then a
        // `+` underline spanning the inserted bytes.
        mut seg_start: i64 = first_nl + 1;
        while (seg_start <= repl_byte_count) {
            mut seg_end: i64 = seg_start;
            while (seg_end < repl_byte_count
                    && (part.replacement[seg_end] as u8) != (10 as u8)) {
                seg_end = seg_end + 1;
            }
            const seg: string = DiagRenderer::substring_bytes(part.replacement,
                seg_start, seg_end);
            const new_line: string = indent_str + seg;

            // Inserted-line row.
            DiagSink::emit_raw(out, this.lead());
            DiagSink::emit_pad(out, line_width as i32);
            DiagSink::emit_raw(out, " ");
            DiagSink::emit_raw(out, bold);
            DiagSink::emit_raw(out, green);
            DiagSink::emit_raw(out, "+");
            DiagSink::emit_raw(out, reset);
            DiagSink::emit_raw(out, " ");
            this.print_source_line(out, new_line);
            DiagSink::emit_raw(out, "\n");

            // Underline the new line with `+` glyphs - positioned
            // under the *content* only, not the leading indent.  The
            // gutter prints `indent_visual` spaces to skip past the
            // indent, then prints `seg_visual` `+` chars across the
            // visual extent of the inserted text.
            const new_line_bytes: i64 = new_line.length() as i64;
            const indent_byte_end: u32 = (indent_n + 1) as u32;
            const indent_visual: u32 = if (indent_n > 0) {
                DiagRenderer::byte_range_visual_width(new_line, 1, indent_byte_end)
            } else {
                0
            };
            const seg_visual: u32 = if ((new_line_bytes as i64) > indent_n) {
                DiagRenderer::byte_range_visual_width(new_line,
                    indent_byte_end, (new_line_bytes + 1) as u32)
            } else {
                0
            };
            this.emit_gutter_blank(out, line_width, " ");
            for (mut sp: u32 = 0; sp < indent_visual; sp++) {
                DiagSink::emit_raw(out, " ");
            }
            DiagSink::emit_raw(out, bold);
            DiagSink::emit_raw(out, green);
            for (mut t: u32 = 0; t < seg_visual; t++) {
                DiagSink::emit_raw(out, "+");
            }
            DiagSink::emit_raw(out, reset);
            DiagSink::emit_raw(out, "\n");

            seg_start = seg_end + 1;
        }

        // Two trailing lines of unmodified source.  Lets the reader
        // see what closes the construct (typically the `};` after a
        // struct literal, plus whatever follows it).  Stops at the
        // first empty line past the anchor.
        for (mut ctx_i: u32 = 1; ctx_i <= 2; ctx_i++) {
            const next_ln: u32 = part.span.end_line + ctx_i;
            const next_text: string = this.get_line(part.span.file, next_ln);
            if (next_text == "") { break; }
            this.emit_gutter_num(out, grey, line_width, next_ln, " ");
            this.print_source_line(out, next_text);
            DiagSink::emit_raw(out, "\n");
        }

        this.render_margin(line_width);
    }

    /// Print a summary line:  "aborting due to N errors; M warnings emitted"
    print_summary(&this, error_count: u32, warning_count: u32) -> void {
        const bold: string  = this.color_bold();
        const red: string   = this.color_red();
        const reset: string = this.color_reset();
        const out: void* = this.out;

        if (error_count > 0) {
            DiagSink::emit_raw(out, bold);
            DiagSink::emit_raw(out, red);
            DiagSink::emit_raw(out, "aborting due to ");
            DiagSink::emit_int(out, error_count as u64);
            DiagSink::emit_raw(out, " error");
            DiagSink::emit_raw(out, if (error_count == 1) { "" } else { "s" });
            if (warning_count > 0) {
                DiagSink::emit_raw(out, "; ");
                DiagSink::emit_int(out, warning_count as u64);
                DiagSink::emit_raw(out, " warning");
                DiagSink::emit_raw(out, if (warning_count == 1) { "" } else { "s" });
                DiagSink::emit_raw(out, " emitted");
            }
            DiagSink::emit_raw(out, reset);
            DiagSink::emit_raw(out, "\n");
        } else if (warning_count > 0) {
            const yellow: string = this.color_yellow();
            DiagSink::emit_raw(out, bold);
            DiagSink::emit_raw(out, yellow);
            DiagSink::emit_int(out, warning_count as u64);
            DiagSink::emit_raw(out, " warning");
            DiagSink::emit_raw(out, if (warning_count == 1) { "" } else { "s" });
            DiagSink::emit_raw(out, " emitted");
            DiagSink::emit_raw(out, reset);
            DiagSink::emit_raw(out, "\n");
        }
    }

    /// Advance one cell past `cell`'s tab stop.  `cell` is 0-indexed; the
    /// returned value is the cell that would print *after* a tab written
    /// at `cell`.
    static advance_past_tab(cell: u32) -> u32 {
        return ((cell / TAB_WIDTH) + 1) * TAB_WIDTH;
    }

    /// Build a copy of `line` with every `\t` replaced by enough spaces
    /// to reach the next tab stop.  Pass through ASCII and UTF-8 bytes
    /// verbatim - they print 1 cell per codepoint either way; the math
    /// in `byte_col_to_visual` cancels the multi-byte cost.  Returns a
    /// freshly allocated string the caller owns; the source-cache copy
    /// is left untouched.
    static expand_tabs(line: string) -> string {
        if (line == "") { return ""; }
        const len: i64 = line.length() as i64;

        // First pass: compute the output length so we can malloc once.
        mut out_len: i64 = 0;
        mut col: u32 = 0;
        for (mut i: i64 = 0; i < len; i++) {
            const ch: u8 = line[i] as u8;
            if (ch == 9) {  // '\t'
                const next_col: u32 = DiagRenderer::advance_past_tab(col);
                const gap: u32 = next_col - col;
                out_len = out_len + gap as i64;
                col = next_col;
            } else if (ch < 0x80) {
                out_len = out_len + 1;
                col = col + 1;
            } else if ((ch & 0xC0) == 0x80) {
                // UTF-8 continuation byte: copies through, no new cell.
                out_len = out_len + 1;
            } else {
                // UTF-8 lead byte: one cell, byte copies through.
                out_len = out_len + 1;
                col = col + 1;
            }
        }

        const buf: i8* = intrinsics::malloc(out_len + 1) as i8*;
        if (buf == null) { return line; }

        mut out_i: i64 = 0;
        col = 0;
        for (mut i: i64 = 0; i < len; i++) {
            const ch: u8 = line[i] as u8;
            if (ch == 9) {
                const next_col: u32 = DiagRenderer::advance_past_tab(col);
                const gap: u32 = next_col - col;
                for (mut k: u32 = 0; k < gap; k++) {
                    const slot: i8* = buf + out_i;
                    *slot = 32 as i8;  // ' '
                    out_i = out_i + 1;
                }
                col = next_col;
            } else {
                const slot: i8* = buf + out_i;
                *slot = ch as i8;
                out_i = out_i + 1;
                if (ch < 0x80) {
                    col = col + 1;
                } else if ((ch & 0xC0) != 0x80) {
                    col = col + 1;
                }
            }
        }
        const term: i8* = buf + out_i;
        *term = 0 as i8;
        return buf as string;
    }

    /// Convert a 1-indexed byte column on `line` into a 1-indexed cell
    /// column on its rendered (tab-expanded) form.  Result for a column
    /// of 0 is 0; column past EOL clamps to the line's final cell+1.
    static byte_col_to_visual(line: string, byte_col: u32) -> u32 {
        if (byte_col == 0)      { return 0; }
        if (line == "")         { return byte_col; }
        const len: i64 = line.length() as i64;
        const target: i64 = (byte_col - 1) as i64;

        mut col: u32 = 0;
        mut i: i64 = 0;
        while (i < len && i < target) {
            const ch: u8 = line[i] as u8;
            if (ch == 9) {
                col = DiagRenderer::advance_past_tab(col);
            } else if (ch < 0x80) {
                col = col + 1;
            } else if ((ch & 0xC0) != 0x80) {
                // UTF-8 lead byte: one cell.
                col = col + 1;
            }
            // Continuation byte: i advances, col doesn't.
            i = i + 1;
        }
        // 1-indexed cell column.
        return col + 1;
    }

    /// Splice `replacement` into `line` over byte range `[start_col..end_col)`
    /// (both 1-indexed).  Used by the suggestion renderer to build a
    /// patched-source-line view from a single edit.
    ///
    /// Out-of-bounds columns clamp to the line bounds.  Returns a freshly
    /// allocated string the caller owns; if no change would be made the
    /// original line is returned unchanged (caller should test pointer
    /// identity before freeing).
    static splice_replacement(line: string, start_col: u32, end_col: u32,
                                replacement: string) -> string {
        if (line == "")              { return line; }
        if (start_col == 0)          { return line; }

        const line_len: i64 = line.length() as i64;
        mut start: i64 = (start_col - 1) as i64;
        if (start < 0)        { start = 0; }
        if (start > line_len) { start = line_len; }

        mut end: i64 = if (end_col > 0) { (end_col - 1) as i64 } else { start };
        if (end < start)      { end = start; }
        if (end > line_len)   { end = line_len; }

        const repl_len: i64 = if (replacement == null as string) {
            0
        } else {
            replacement.length() as i64
        };

        // No-op edit: an empty replacement over a zero-width span.  Don't
        // bother allocating.
        if (start == end && repl_len == 0) { return line; }

        const tail_len: i64 = line_len - end;
        const out_len: i64 = start + repl_len + tail_len;
        const buf: i8* = intrinsics::malloc(out_len + 1) as i8*;
        if (buf == null) { return line; }

        // Prefix.
        if (start > 0) {
            intrinsics::memcpy(buf as void*, line as void*, start as u64);
        }
        // Replacement.
        if (repl_len > 0) {
            const dst_repl: i8* = buf + start;
            intrinsics::memcpy(dst_repl as void*, replacement as void*, repl_len as u64);
        }
        // Tail.
        if (tail_len > 0) {
            const src_tail: i8* = (line as i8*) + end;
            const dst_tail: i8* = buf + (start + repl_len);
            intrinsics::memcpy(dst_tail as void*, src_tail as void*, tail_len as u64);
        }
        const term: i8* = buf + out_len;
        *term = 0 as i8;
        return buf as string;
    }

    /// Extract bytes `[start..end)` of `s` into a freshly-allocated, NUL-
    /// terminated string the caller owns.  Returns `""` for empty / inverted
    /// ranges or on allocation failure.  Used by the multi-line suggestion
    /// renderer to split a replacement string on `\n` and to pull leading
    /// whitespace off the anchor line for auto-indenting inserted lines.
    static substring_bytes(s: string, start: i64, end: i64) -> string {
        if (s == null as string || s == "") { return ""; }
        if (end <= start) { return ""; }
        const len: i64 = end - start;
        const buf: i8* = intrinsics::malloc(len + 1) as i8*;
        if (buf == null) { return ""; }
        intrinsics::memcpy(buf as void*,
            (s + start) as void*, len as u64);
        *(buf + len) = 0 as i8;
        return buf as string;
    }

    /// Count of leading space / tab bytes on `line`.  The renderer auto-
    /// indents every inserted line of a multi-line suggestion by this many
    /// bytes off the anchor line, so a fix-it like `,\nbuz: <bool>` lands
    /// at the same column as the existing fields without the emission site
    /// having to compute indent itself.
    static leading_whitespace_count(line: string) -> i64 {
        if (line == null as string || line == "") { return 0; }
        const len: i64 = line.length() as i64;
        mut i: i64 = 0;
        while (i < len) {
            const c: u8 = line[i] as u8;
            if (c != 0x20 && c != 0x09) { break; }
            i = i + 1;
        }
        return i;
    }

    /// Visual cells occupied by the substring `line[start_byte..end_byte]`
    /// (1-indexed, half-open).  Used to compute caret-span widths so a
    /// `^^^^` underline matches the visual extent of a tab- or multi-byte
    /// span.
    static byte_range_visual_width(line: string, start_byte: u32, end_byte: u32) -> u32 {
        if (end_byte <= start_byte) { return 1; }
        const v_start: u32 = DiagRenderer::byte_col_to_visual(line, start_byte);
        const v_end:   u32 = DiagRenderer::byte_col_to_visual(line, end_byte);
        if (v_end <= v_start) { return 1; }
        return v_end - v_start;
    }
}
