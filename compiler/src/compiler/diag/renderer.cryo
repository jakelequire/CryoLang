/// DiagRenderer
///
/// Rich diagnostic renderer that produces rustc-style terminal output with
/// ANSI colors, source snippets, caret underlines, secondary spans, child
/// diagnostics, and suggestions.
///
/// All output goes to stderr via fprintf(g_stderr, ...) to keep stdout
/// clean for LSP/JSON-RPC.

namespace Compiler::Diag::Renderer;

import Compiler::Diag;
import Compiler::Diag::Severity;
import Compiler::Diag::SourceSpan;
import Compiler::Diag::SpanLabel;
import Compiler::Diag::Suggestion;
import Compiler::Diag::Diagnostic;
import std::collections::hashmap;
import std::core::option;
import Utils;
import Utils::File;
import Utils::SyntaxHighlighter;


// ============================================================================
// ANSI Color Codes
// ============================================================================

// NOTE: use \x1b (hex ESC = 0x1B) rather than \033 (octal).  Cryo's
// string-literal escape pass only recognizes \n \t \r \\ \' \" \0 \xHH;
// `\033` is parsed as `\0` + literal "33" and silently truncates the
// string to a single NUL byte, which is why all color escapes had been
// no-ops.
const ANSI_RESET:   string = "\x1b[0m";
const ANSI_BOLD:    string = "\x1b[1m";
const ANSI_RED:     string = "\x1b[91m";
const ANSI_YELLOW:  string = "\x1b[93m";
const ANSI_CYAN:    string = "\x1b[96m";
const ANSI_BLUE:    string = "\x1b[94m";
const ANSI_GREEN:   string = "\x1b[92m";
const ANSI_WHITE:   string = "\x1b[97m";
const ANSI_GREY:    string = "\x1b[90m";


// ============================================================================
// RenderConfig
// ============================================================================

/// Configuration for the diagnostic renderer.
type struct RenderConfig {
    colors:             boolean;
    context_lines:      u32;
    max_errors:         u32;
    warnings_as_errors: boolean;

    /// Default config: colors auto-detected, 2 context lines, 50 max errors.
    /// Color is enabled when stderr is a terminal AND `NO_COLOR` is unset,
    /// or when `CLICOLOR_FORCE` / `FORCE_COLOR` is set (overrides TTY check).
    static default() -> RenderConfig {
        return RenderConfig {
            colors:             color_decision(),
            context_lines:      2,
            max_errors:         50,
            warnings_as_errors: false,
        };
    }

    /// Plain config: no colors, for redirected output or tests.
    static plain() -> RenderConfig {
        return RenderConfig {
            colors:             false,
            context_lines:      2,
            max_errors:         50,
            warnings_as_errors: false,
        };
    }

    /// Force-color config: ignore the TTY/NO_COLOR check.  Reserved for
    /// callers that have already decided color is wanted.
    static colored() -> RenderConfig {
        return RenderConfig {
            colors:             true,
            context_lines:      2,
            max_errors:         50,
            warnings_as_errors: false,
        };
    }
}

/// Probe stderr for color support.  Color is on iff stderr is a TTY
/// AND the `NO_COLOR` env var is unset (per https://no-color.org).
function stderr_supports_color() -> boolean {
    const no_color: i8* = intrinsics::getenv("NO_COLOR") as i8*;
    if (no_color != null) { return false; }
    return intrinsics::isatty(2) == 1;
}

/// Final color decision: respect NO_COLOR, then honor FORCE_COLOR /
/// CLICOLOR_FORCE for callers redirecting stderr (CI logs, test
/// captures), then fall back to the TTY probe.
function color_decision() -> boolean {
    const no_color: i8* = intrinsics::getenv("NO_COLOR") as i8*;
    if (no_color != null) { return false; }
    const force1: i8* = intrinsics::getenv("FORCE_COLOR") as i8*;
    if (force1 != null) { return true; }
    const force2: i8* = intrinsics::getenv("CLICOLOR_FORCE") as i8*;
    if (force2 != null) { return true; }
    return intrinsics::isatty(2) == 1;
}


// ============================================================================
// DiagRenderer
// ============================================================================

/// Renders diagnostics to stderr with source snippets and ANSI colors.
type struct DiagRenderer {
    config:          RenderConfig;
    cached_files:    string[];
    cached_contents: string[];
    file_index:      HashMap<string, i64>;

    static new(config: RenderConfig) -> DiagRenderer {
        return DiagRenderer {
            config:          config,
            cached_files:    [],
            cached_contents: [],
            file_index:      HashMap<string, i64>::new(),
        };
    }

    /// Load a source file into the cache.  Returns true if the file was
    /// loaded (or was already cached).
    load_source(mut &this, filepath: string) -> boolean {
        if (this.has_source(filepath)) {
            return true;
        }

        if (!File::exists(filepath)) {
            return false;
        }

        mut file: File = File::new(filepath);

        // Load the file content into memory.
        match (file.load()) {
            Result::Err(_) => { return false; }
            _ => {}
        }

        const idx: i64 = this.cached_files.length as i64;
        this.cached_files.push(filepath);
        this.cached_contents.push(file.content());
        this.file_index.insert(filepath, idx);
        return true;
    }

    /// Check whether a file is already in the source cache.
    has_source(&this, filepath: string) -> boolean {
        return this.file_index.contains_key(&filepath);
    }

    /// Get the content of a cached source file, or "" if not cached.
    get_content(&this, filepath: string) -> string {
        const opt: Option<i64> = this.file_index.get(&filepath);
        if (opt.is_some()) {
            return this.cached_contents[opt.unwrap()];
        }
        return "";
    }

    /// Extract a single line (1-indexed) from a cached source file.
    /// Returns "" if the file is not cached or the line doesn't exist.
    get_line(&this, filepath: string, line_num: u32) -> string {
        const content: string = this.get_content(filepath);
        if (content == "") {
            return "";
        }

        const content_len: i64 = intrinsics::strlen(content) as i64;

        // Walk through the content counting newlines to find the target line.
        // Lines are 1-indexed.
        mut current_line: u32 = 1;
        mut line_start: i64 = 0;

        // If the target is line 1, line_start is already 0.
        // Otherwise, advance past newlines until we reach the target line.
        if (line_num > 1) {
            for (mut pos: i64 = 0; pos < content_len; pos++) {
                const ch: i8* = intrinsics::ptr_add(content as void*, pos) as i8*;
                if (*ch == 10) {  // '\n' = ASCII 10
                    current_line += 1;
                    if (current_line == line_num) {
                        line_start = pos + 1;
                        break;
                    }
                }
            }
            // If we didn't reach the target line, it doesn't exist.
            if (current_line < line_num) {
                return "";
            }
        }

        // Find the end of this line (next newline or end of content).
        mut line_end: i64 = content_len;
        for (mut pos: i64 = line_start; pos < content_len; pos++) {
            const ch: i8* = intrinsics::ptr_add(content as void*, pos) as i8*;
            if (*ch == 10) {  // '\n'
                line_end = pos;
                break;
            }
        }

        // Handle trailing '\r' for CRLF line endings.
        if (line_end > line_start) {
            const prev: i8* = intrinsics::ptr_add(content as void*, line_end - 1) as i8*;
            if (*prev == 13) {  // '\r' = ASCII 13
                line_end -= 1;
            }
        }

        const line_len: i64 = line_end - line_start;
        if (line_len <= 0) {
            return "";
        }

        // Copy the line into a new buffer.
        const buf: i8* = intrinsics::malloc(line_len + 1) as i8*;
        if (buf == null) {
            return "";
        }
        const src: i8* = intrinsics::ptr_add(content as void*, line_start) as i8*;
        intrinsics::memcpy(buf as void*, src as void*, line_len as u64);
        const term: i8* = intrinsics::ptr_add(buf as void*, line_len) as i8*;
        intrinsics::memset(term as void*, 0, 1);

        return buf as string;
    }


    // ================================================================
    // Color helpers
    // ================================================================

    color_reset(&this) -> string {
        return if (this.config.colors) { ANSI_RESET } else { "" };
    }

    color_bold(&this) -> string {
        return if (this.config.colors) { ANSI_BOLD } else { "" };
    }

    color_red(&this) -> string {
        return if (this.config.colors) { ANSI_RED } else { "" };
    }

    color_yellow(&this) -> string {
        return if (this.config.colors) { ANSI_YELLOW } else { "" };
    }

    color_cyan(&this) -> string {
        return if (this.config.colors) { ANSI_CYAN } else { "" };
    }

    color_blue(&this) -> string {
        return if (this.config.colors) { ANSI_BLUE } else { "" };
    }

    color_green(&this) -> string {
        return if (this.config.colors) { ANSI_GREEN } else { "" };
    }

    color_white(&this) -> string {
        return if (this.config.colors) { ANSI_WHITE } else { "" };
    }

    color_grey(&this) -> string {
        return if (this.config.colors) { ANSI_GREY } else { "" };
    }

    /// Return the ANSI color code for a given severity level.
    severity_color(&this, sev: Severity) -> string {
        return match (sev) {
            Severity::Error   => { this.color_red()    }
            Severity::Warning => { this.color_yellow() }
            Severity::Note    => { this.color_cyan()   }
            Severity::Help    => { this.color_green()  }
        };
    }


    // ================================================================
    // Rendering
    // ================================================================

    /// Render a diagnostic to stderr.
    render(mut &this, diag: Diagnostic) -> void {
        // 0. Top rule
        this.render_rule(diag.severity);

        // 1. Header line:  error[E0200]: message
        this.render_header(diag);

        // 2. Primary + same-file secondaries: combined snippet when
        //    any secondary lives in the primary's file (rustc-style:
        //    one snippet block, line groups separated by `...`).
        //    Otherwise fall back to the single-span snippet.
        if (diag.span.has_location()) {
            this.load_source(diag.span.file);
            if (this.has_same_file_secondary(diag)) {
                this.render_combined_snippet(diag);
            } else {
                this.render_snippet(diag.span, diag.severity, diag.message);
            }
        }

        // 3. Cross-file secondary labels (rendered as separate snippets
        //    since they can't share a margin with the primary).
        for (mut i: int = 0; i < diag.labels.length; i++) {
            const label: SpanLabel = diag.labels[i];
            if (label.is_primary) { continue; }
            if (!label.span.has_location()) { continue; }
            if (label.span.file == diag.span.file && diag.span.has_location()) {
                continue;  // already rendered in the combined block
            }
            this.load_source(label.span.file);
            this.render_secondary_span(label);
        }

        // 4. Children (notes, helps)
        for (mut i: int = 0; i < diag.children.length; i++) {
            const child: Diagnostic = diag.children[i];
            this.render_child(child);
        }

        // 5. Suggestions
        for (mut i: int = 0; i < diag.suggestions.length; i++) {
            const sug: Suggestion = diag.suggestions[i];
            this.render_suggestion(sug);
        }

        // Trailing blank line for separation
        intrinsics::fprintf(g_stderr, "\n");
    }

    /// Print a horizontal rule of `=` characters tinted with the diagnostic
    /// severity color. Emitted before each diagnostic; doubles as the
    /// separator from the prior one.
    render_rule(&this, severity: Severity) -> void {
        const sev_color: string = this.severity_color(severity);
        const bold: string  = this.color_bold();
        const reset: string = this.color_reset();
        intrinsics::fprintf(g_stderr, "%s%s================================================================================%s\n",
            bold, sev_color, reset);
    }

    /// True iff the diagnostic has at least one secondary label that
    /// shares the primary span's file. Cross-file secondaries are kept
    /// out of the combined block so the margin/line numbers stay
    /// coherent.
    has_same_file_secondary(&this, diag: Diagnostic) -> boolean {
        if (!diag.span.has_location()) { return false; }
        for (mut i: int = 0; i < diag.labels.length; i++) {
            const lbl: SpanLabel = diag.labels[i];
            if (lbl.is_primary) { continue; }
            if (!lbl.span.has_location()) { continue; }
            if (lbl.span.file == diag.span.file) { return true; }
        }
        return false;
    }

    /// Render the header line:  error[E0200]: message
    render_header(&this, diag: Diagnostic) -> void {
        const sev_color: string = this.severity_color(diag.severity);
        const bold: string = this.color_bold();
        const reset: string = this.color_reset();
        const white: string = this.color_white();

        intrinsics::fprintf(g_stderr, "%s%s%s%s[%s]%s: %s%s%s\n",
            bold, sev_color,
            diag.severity.label(),
            reset,
            diag.code.format(),
            reset,
            bold, white,
            diag.message);
        // Final reset after message
        intrinsics::fprintf(g_stderr, "%s", reset);
    }

    /// Render a source snippet with caret underline for the primary span.
    render_snippet(mut &this, span: SourceSpan, severity: Severity, message: string) -> void {
        const blue: string  = this.color_blue();
        const reset: string = this.color_reset();
        const bold: string  = this.color_bold();
        const grey: string  = this.color_grey();

        // Arrow line:  --> file:line:col
        intrinsics::fprintf(g_stderr, " %s%s-->%s %s:%u:%u\n",
            bold, blue, reset,
            span.file, span.start_line, span.start_col);

        // Calculate line number width (minimum 3)
        mut line_width: u32 = 3;
        if (span.start_line > 999) {
            line_width = 4;
        }
        if (span.start_line > 9999) {
            line_width = 5;
        }

        // Top margin
        this.render_margin(line_width);

        // Context lines before
        const ctx: u32 = this.config.context_lines;
        mut first_line: u32 = span.start_line;
        if (first_line > ctx) {
            first_line -= ctx;
        } else {
            first_line = 1;
        }

        // Render context lines before the error
        for (mut ln: u32 = first_line; ln < span.start_line; ln++) {
            const line_text: string = this.get_line(span.file, ln);
            intrinsics::fprintf(g_stderr, " %s%*u%s %s|%s ",
                grey, line_width, ln, reset,
                blue, reset);
            SyntaxHighlighter::print_line(line_text, this.config.colors);
            intrinsics::fprintf(g_stderr, "\n");
        }

        // Render the error line
        const error_line: string = this.get_line(span.file, span.start_line);
        intrinsics::fprintf(g_stderr, " %s%s%*u%s %s|%s ",
            bold, blue, line_width, span.start_line, reset,
            blue, reset);
        SyntaxHighlighter::print_line(error_line, this.config.colors);
        intrinsics::fprintf(g_stderr, "\n");

        // Render the caret underline
        this.render_underline(span, severity, message, line_width);

        // Context lines after
        const last_ctx: u32 = span.start_line + ctx;
        for (mut ln: u32 = span.start_line + 1; ln <= last_ctx; ln++) {
            const line_text: string = this.get_line(span.file, ln);
            if (line_text == "" && ln > span.start_line + 1) {
                break;  // Stop at empty lines past the first one
            }
            intrinsics::fprintf(g_stderr, " %s%*u%s %s|%s ",
                grey, line_width, ln, reset,
                blue, reset);
            SyntaxHighlighter::print_line(line_text, this.config.colors);
            intrinsics::fprintf(g_stderr, "\n");
        }

        // Bottom margin
        this.render_margin(line_width);
    }

    /// Render a margin-only line:  "   |"
    render_margin(&this, line_width: u32) -> void {
        const blue: string  = this.color_blue();
        const reset: string = this.color_reset();
        intrinsics::fprintf(g_stderr, " %*s %s|%s\n", line_width, "", blue, reset);
    }

    /// Render an ellipsis line that separates non-adjacent line groups
    /// in a combined snippet:  "..."
    render_ellipsis(&this, line_width: u32) -> void {
        const blue: string  = this.color_blue();
        const reset: string = this.color_reset();
        intrinsics::fprintf(g_stderr, "%s%*s...%s\n", blue, line_width, "", reset);
    }

    /// Width of the largest line number a combined snippet will render,
    /// used to align the margin column. Mirrors the per-snippet rule of
    /// "minimum 3 digits, scale up past 999/9999".
    line_number_width(&this, max_line: u32) -> u32 {
        mut w: u32 = 3;
        if (max_line > 999)   { w = 4; }
        if (max_line > 9999)  { w = 5; }
        if (max_line > 99999) { w = 6; }
        return w;
    }

    /// Build a sorted list of labels in the primary span's file. The
    /// result is stable on tied lines, so multiple labels on the same
    /// line preserve their original (push) order.
    collect_same_file_labels(&this, diag: Diagnostic) -> SpanLabel[] {
        mut out: SpanLabel[] = [];
        for (mut i: int = 0; i < diag.labels.length; i++) {
            const lbl: SpanLabel = diag.labels[i];
            if (!lbl.span.has_location()) { continue; }
            if (lbl.span.file != diag.span.file) { continue; }
            out.push(lbl);
        }
        // Insertion sort by start_line (small N, stable).
        for (mut i: int = 1; i < out.length; i++) {
            for (mut j: int = i; j > 0; j--) {
                if (out[j].span.start_line < out[j - 1].span.start_line) {
                    const tmp: SpanLabel = out[j];
                    out[j] = out[j - 1];
                    out[j - 1] = tmp;
                } else {
                    break;
                }
            }
        }
        return out;
    }

    /// Render a rustc-style combined snippet that folds the primary
    /// span and every same-file secondary label into one block. Line
    /// groups are merged when their ±context_lines windows overlap;
    /// otherwise they're separated by a `...` ellipsis row.
    render_combined_snippet(mut &this, diag: Diagnostic) -> void {
        const blue: string  = this.color_blue();
        const reset: string = this.color_reset();
        const bold: string  = this.color_bold();

        const primary_span: SourceSpan = diag.span;
        const labels: SpanLabel[] = this.collect_same_file_labels(diag);
        if (labels.length == 0) {
            // Nothing to combine; fall back to single-span rendering.
            this.render_snippet(primary_span, diag.severity, diag.message);
            return;
        }

        // Compute line-number column width from the largest line we'll
        // print across every group.
        const ctx: u32 = this.config.context_lines;
        mut max_line: u32 = primary_span.start_line + ctx;
        for (mut i: int = 0; i < labels.length; i++) {
            const ln: u32 = labels[i].span.start_line + ctx;
            if (ln > max_line) { max_line = ln; }
        }
        const line_width: u32 = this.line_number_width(max_line);

        // Header arrow:  --> file:line:col  (always anchored at primary)
        intrinsics::fprintf(g_stderr, " %s%s-->%s %s:%u:%u\n",
            bold, blue, reset,
            primary_span.file, primary_span.start_line, primary_span.start_col);

        this.render_margin(line_width);

        // Walk labels in line order, accumulating a "current group"
        // [group_start..group_end]. When the next label's window
        // doesn't touch the current group, flush + ellipsis + start a
        // new group. Group windows are inclusive.
        mut group_start: u32 = 0;
        mut group_end:   u32 = 0;
        mut have_group:  boolean = false;

        for (mut i: int = 0; i < labels.length; i++) {
            const lbl: SpanLabel = labels[i];
            const ln: u32 = lbl.span.start_line;
            const want_start: u32 = if (ln > ctx) { ln - ctx } else { 1 };
            const want_end:   u32 = ln + ctx;

            if (!have_group) {
                group_start = want_start;
                group_end   = want_end;
                have_group  = true;
            } else if (want_start <= group_end + 1) {
                if (want_end > group_end) { group_end = want_end; }
            } else {
                this.render_line_group(diag.severity, primary_span.file,
                                       group_start, group_end,
                                       labels, line_width);
                this.render_ellipsis(line_width);
                group_start = want_start;
                group_end   = want_end;
            }
        }
        if (have_group) {
            this.render_line_group(diag.severity, primary_span.file,
                                   group_start, group_end,
                                   labels, line_width);
        }

        this.render_margin(line_width);
    }

    /// Render a contiguous line range as part of a combined snippet.
    /// For each line in [start_line..end_line]: print the line itself
    /// (bold blue line-number when it carries a label, grey otherwise),
    /// then one underline row per label that anchors on that line.
    render_line_group(mut &this, severity: Severity, file: string,
                      start_line: u32, end_line: u32,
                      labels: SpanLabel[], line_width: u32) -> void {
        const blue: string  = this.color_blue();
        const reset: string = this.color_reset();
        const grey: string  = this.color_grey();
        const bold: string  = this.color_bold();

        for (mut ln: u32 = start_line; ln <= end_line; ln++) {
            const line_text: string = this.get_line(file, ln);
            // get_line returns "" for both empty and out-of-bounds; if
            // we've passed the end of file there's nothing more to do.
            // Detect end-of-file by trying one line further than the
            // first empty: if the *next* line is also empty AND we're
            // past the last labeled line, stop.
            mut has_label: boolean = false;
            for (mut k: int = 0; k < labels.length; k++) {
                if (labels[k].span.start_line == ln) { has_label = true; break; }
            }

            if (line_text == "" && !has_label) {
                // Print blank line with line-number column (preserves
                // rustc's behavior for genuinely blank lines inside a
                // group). If we've actually run off the file end, the
                // caller already bounded us by max_line, so this is
                // safe.
                intrinsics::fprintf(g_stderr, " %s%*u%s %s|%s\n",
                    grey, line_width, ln, reset, blue, reset);
                continue;
            }

            if (has_label) {
                intrinsics::fprintf(g_stderr, " %s%s%*u%s %s|%s ",
                    bold, blue, line_width, ln, reset,
                    blue, reset);
            } else {
                intrinsics::fprintf(g_stderr, " %s%*u%s %s|%s ",
                    grey, line_width, ln, reset,
                    blue, reset);
            }
            SyntaxHighlighter::print_line(line_text, this.config.colors);
            intrinsics::fprintf(g_stderr, "\n");

            if (has_label) {
                for (mut k: int = 0; k < labels.length; k++) {
                    if (labels[k].span.start_line == ln) {
                        this.render_label_underline(labels[k], severity, line_width);
                    }
                }
            }
        }
    }

    /// Render the underline row for a single label inside a combined
    /// snippet. Primaries get `^^^^` in the diagnostic's severity
    /// color; secondaries get `----` in cyan, matching the user's
    /// "value moved here" caption style.
    render_label_underline(&this, label: SpanLabel, severity: Severity,
                           line_width: u32) -> void {
        const blue: string  = this.color_blue();
        const reset: string = this.color_reset();
        const bold: string  = this.color_bold();

        const span: SourceSpan = label.span;
        mut ul_start: u32 = 0;
        if (span.start_col > 0) { ul_start = span.start_col - 1; }
        mut ul_len: u32 = 1;
        if (span.end_col > span.start_col) {
            ul_len = span.end_col - span.start_col;
        }

        intrinsics::fprintf(g_stderr, " %*s %s|%s ", line_width, "", blue, reset);
        for (mut s: u32 = 0; s < ul_start; s++) {
            intrinsics::fprintf(g_stderr, " ");
        }

        if (label.is_primary) {
            const sev_color: string = this.severity_color(severity);
            intrinsics::fprintf(g_stderr, "%s%s^", bold, sev_color);
            for (mut t: u32 = 1; t < ul_len; t++) {
                intrinsics::fprintf(g_stderr, "^");
            }
        } else {
            const cyan: string = this.color_cyan();
            intrinsics::fprintf(g_stderr, "%s%s-", bold, cyan);
            for (mut t: u32 = 1; t < ul_len; t++) {
                intrinsics::fprintf(g_stderr, "-");
            }
        }

        if (label.message != "") {
            intrinsics::fprintf(g_stderr, " %s", label.message);
        }
        intrinsics::fprintf(g_stderr, "%s\n", reset);
    }

    /// Render the caret underline below a source line.
    render_underline(&this, span: SourceSpan, severity: Severity, message: string,
                     line_width: u32) -> void {
        const blue: string      = this.color_blue();
        const reset: string     = this.color_reset();
        const bold: string      = this.color_bold();
        const sev_color: string = this.severity_color(severity);

        // Calculate underline position (1-indexed → 0-indexed)
        mut ul_start: u32 = 0;
        if (span.start_col > 0) {
            ul_start = span.start_col - 1;
        }

        mut ul_len: u32 = 1;
        if (span.end_col > span.start_col) {
            ul_len = span.end_col - span.start_col;
        }

        // Build the underline string: spaces + ^ + ~~~
        // Leading spaces for margin + pipe + gap
        intrinsics::fprintf(g_stderr, " %*s %s|%s ", line_width, "", blue, reset);

        // Spaces to reach the underline start
        for (mut s: u32 = 0; s < ul_start; s++) {
            intrinsics::fprintf(g_stderr, " ");
        }

        // The caret and tildes
        intrinsics::fprintf(g_stderr, "%s%s^", bold, sev_color);
        for (mut t: u32 = 1; t < ul_len; t++) {
            intrinsics::fprintf(g_stderr, "~");
        }

        // Inline label
        if (message != "") {
            intrinsics::fprintf(g_stderr, " %s", message);
        }

        intrinsics::fprintf(g_stderr, "%s\n", reset);
    }

    /// Render a secondary span:  :: file:line:col  with cyan underline.
    render_secondary_span(mut &this, label: SpanLabel) -> void {
        const blue: string  = this.color_blue();
        const cyan: string  = this.color_cyan();
        const bold: string  = this.color_bold();
        const reset: string = this.color_reset();
        const grey: string  = this.color_grey();

        // Secondary arrow:  :: file:line:col
        intrinsics::fprintf(g_stderr, " %s%s::%s %s:%u:%u\n",
            bold, blue, reset,
            label.span.file, label.span.start_line, label.span.start_col);

        mut line_width: u32 = 3;
        if (label.span.start_line > 999) {
            line_width = 4;
        }

        this.render_margin(line_width);

        // Render the source line
        const line_text: string = this.get_line(label.span.file, label.span.start_line);
        intrinsics::fprintf(g_stderr, " %s%*u%s %s|%s ",
            grey, line_width, label.span.start_line, reset,
            blue, reset);
        SyntaxHighlighter::print_line(line_text, this.config.colors);
        intrinsics::fprintf(g_stderr, "\n");

        // Cyan underline
        mut ul_start: u32 = 0;
        if (label.span.start_col > 0) {
            ul_start = label.span.start_col - 1;
        }
        mut ul_len: u32 = 1;
        if (label.span.end_col > label.span.start_col) {
            ul_len = label.span.end_col - label.span.start_col;
        }

        intrinsics::fprintf(g_stderr, " %*s %s|%s ", line_width, "", blue, reset);
        for (mut s: u32 = 0; s < ul_start; s++) {
            intrinsics::fprintf(g_stderr, " ");
        }
        intrinsics::fprintf(g_stderr, "%s%s^", bold, cyan);
        for (mut t: u32 = 1; t < ul_len; t++) {
            intrinsics::fprintf(g_stderr, "~");
        }
        if (label.message != "") {
            intrinsics::fprintf(g_stderr, " %s", label.message);
        }
        intrinsics::fprintf(g_stderr, "%s\n", reset);

        this.render_margin(line_width);
    }

    /// Render a child diagnostic (note or help) without source context.
    render_child(mut &this, child: Diagnostic) -> void {
        const bold: string  = this.color_bold();
        const reset: string = this.color_reset();
        const sev_color: string = this.severity_color(child.severity);

        if (child.span.has_location()) {
            // Child with source location: show a mini snippet
            intrinsics::fprintf(g_stderr, " %s%s%s%s: %s\n",
                bold, sev_color, child.severity.label(), reset,
                child.message);

            this.load_source(child.span.file);
            this.render_snippet(child.span, child.severity, child.message);
        } else {
            // Child without location: just the message
            intrinsics::fprintf(g_stderr, " %s%s%s%s: %s\n",
                bold, sev_color, child.severity.label(), reset,
                child.message);
        }
    }

    /// Render a suggestion with the replacement code in green.
    render_suggestion(&this, sug: Suggestion) -> void {
        const bold: string  = this.color_bold();
        const green: string = this.color_green();
        const blue: string  = this.color_blue();
        const reset: string = this.color_reset();

        intrinsics::fprintf(g_stderr, " %s%ssuggestion%s: %s\n",
            bold, green, reset, sug.message);

        if (sug.replacement != "") {
            intrinsics::fprintf(g_stderr, "    %s|%s %s%s%s\n",
                blue, reset,
                bold, green, sug.replacement);
            intrinsics::fprintf(g_stderr, "%s", reset);
        }
    }

    /// Print a summary line:  "aborting due to N errors; M warnings emitted"
    print_summary(&this, error_count: u32, warning_count: u32) -> void {
        const bold: string  = this.color_bold();
        const red: string   = this.color_red();
        const reset: string = this.color_reset();

        if (error_count > 0) {
            intrinsics::fprintf(g_stderr, "%s%saborting due to %u error%s",
                bold, red, error_count,
                if (error_count == 1) { "" } else { "s" });
            if (warning_count > 0) {
                intrinsics::fprintf(g_stderr, "; %u warning%s emitted",
                    warning_count,
                    if (warning_count == 1) { "" } else { "s" });
            }
            intrinsics::fprintf(g_stderr, "%s\n", reset);
        } else if (warning_count > 0) {
            const yellow: string = this.color_yellow();
            intrinsics::fprintf(g_stderr, "%s%s%u warning%s emitted%s\n",
                bold, yellow, warning_count,
                if (warning_count == 1) { "" } else { "s" },
                reset);
        }
    }
}
