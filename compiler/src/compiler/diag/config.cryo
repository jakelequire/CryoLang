/// DiagConfig
///
/// Diagnostic configuration: filtering, deduplication, max-errors cutoff,
/// warnings-as-errors promotion, and per-code suppression.

namespace compiler::diag::config;

import compiler::diag;
import compiler::diag::{ ErrorCode };
import std::io::stdio;
import std::env;
import std::collections::str::{ Str };


/// Diagnostic pipeline configuration.
type struct DiagConfig {
    colors:             boolean;
    context_lines:      u32;
    max_errors:         u32;
    warnings_as_errors: boolean;
    /// The warnings reported as errors when `warnings_as_errors` is off,
    /// each as `ErrorCode::to_u32` answers it.
    promoted_codes:     [u32];
    suppressed_codes:   [u32];

    /// Default config: colors auto-detected (TTY + !NO_COLOR), 2 context
    /// lines, 500 max errors.
    static default() -> DiagConfig {
        const color_on: boolean = DiagConfig::diag_color_supported();
        return DiagConfig {
            colors:             color_on,
            context_lines:      2,
            max_errors:         500,
            warnings_as_errors: false,
            promoted_codes:     [],
            suppressed_codes:   [],
        };
    }

    /// A config that keeps every report: no cutoff, nothing suppressed or
    /// promoted.  For a sink whose reports are handed on to another sink,
    /// which applies its own config when it receives them.
    static keeping_every_report() -> DiagConfig {
        return DiagConfig {
            colors:             false,
            context_lines:      2,
            max_errors:         0,
            warnings_as_errors: false,
            promoted_codes:     [],
            suppressed_codes:   [],
        };
    }

    /// Whether a warning with `code` is reported as an error: every warning
    /// under `warnings_as_errors`, else the ones `promoted_codes` names.
    promotes(&this, code: ErrorCode) -> boolean {
        if (this.warnings_as_errors) { return true; }
        for (mut i: i64 = 0; i < this.promoted_codes.length(); i++) {
            if (this.promoted_codes[i] == code.to_u32()) { return true; }
        }
        return false;
    }

    /// Check whether a code is suppressed.
    is_suppressed(&this, code: u32) -> boolean {
        for (mut i: i64 = 0; i < this.suppressed_codes.length(); i++) {
            if (this.suppressed_codes[i] == code) {
                return true;
            }
        }
        return false;
    }

    /// Probe stderr for color support: TTY AND `NO_COLOR` unset.
    static diag_color_supported() -> boolean {
        match (env::var(Str::new("NO_COLOR"))) {
            Option::Some(_) => { return false; }
            Option::None => {}
        }
        return stdio::is_tty(2);
    }
}
