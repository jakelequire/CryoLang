/// SpanLabel
///
/// A labeled source span used within a Diagnostic to annotate one or more
/// locations in the source code.  Primary labels mark the main error site;
/// secondary labels provide additional context.

namespace compiler::diag::span_label;

import compiler::diag::source_span::{ SourceSpan };
import std::collections::string::{ String };
import std::fmt::display::{ Display };


/// A labeled source span attached to a diagnostic.  The label owns its
/// caption, so a caption formatted for it is released with it.
type struct SpanLabel {
    span:       SourceSpan;
    message:    String;
    is_primary: boolean;
    /// The name of the declaration the labelled text belongs to - a
    /// function whose `where` bound the label marks - whose line a snippet
    /// of its own shows above the label's, so the reader sees what the
    /// label is part of.  No location when the label stands alone.
    owner:      SourceSpan;

    /// Create a primary label (rendered with the diagnostic's severity color).
    static primary<T>(span: SourceSpan, message: T) -> SpanLabel where T: Display {
        return SpanLabel {
            span:       span,
            message:    String::from(message),
            is_primary: true,
            owner:      SourceSpan::none(),
        };
    }

    /// Create a secondary label (rendered in cyan).
    static secondary<T>(span: SourceSpan, message: T) -> SpanLabel where T: Display {
        return SpanLabel {
            span:       span,
            message:    String::from(message),
            is_primary: false,
            owner:      SourceSpan::none(),
        };
    }
}

implement trait Clone for struct SpanLabel {
    clone(&this) -> SpanLabel {
        return SpanLabel {
            span:       this.span,
            message:    this.message.clone(),
            is_primary: this.is_primary,
            owner:      this.owner,
        };
    }
}
