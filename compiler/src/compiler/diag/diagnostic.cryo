/// Diagnostic
///
/// A single compiler diagnostic (error, warning, note, or help).
/// Supports multi-span labels, child diagnostics, and suggestions.

namespace Compiler::Diag::Diagnostic;

import Compiler::Diag;
import Compiler::Diag::Severity;
import Compiler::Diag::SourceSpan;
import Compiler::Diag::SpanLabel;
import Compiler::Diag::Suggestion;


/// A single compiler diagnostic (error, warning, note, or help).
type struct Diagnostic {
    severity:    Severity;
    code:        ErrorCode;
    message:     string;
    span:        SourceSpan;
    labels:      SpanLabel[];
    children:    Diagnostic[];
    suggestions: Suggestion[];

    /// Create an error diagnostic (no location yet; attach with at()).
    static error(code: ErrorCode, message: string) -> Diagnostic {
        return Diagnostic {
            severity:    Severity::Error,
            code:        code,
            message:     message,
            span:        SourceSpan::none(),
            labels:      [],
            children:    [],
            suggestions: [],
        };
    }

    /// Create a warning diagnostic.
    static warning(code: ErrorCode, message: string) -> Diagnostic {
        return Diagnostic {
            severity:    Severity::Warning,
            code:        code,
            message:     message,
            span:        SourceSpan::none(),
            labels:      [],
            children:    [],
            suggestions: [],
        };
    }

    /// Create a note diagnostic.
    static note(code: ErrorCode, message: string) -> Diagnostic {
        return Diagnostic {
            severity:    Severity::Note,
            code:        code,
            message:     message,
            span:        SourceSpan::none(),
            labels:      [],
            children:    [],
            suggestions: [],
        };
    }

    /// Deep copy.  The three owning arrays are rebuilt into independent
    /// buffers (SpanLabel is Copy; children/suggestions are cloned), so a
    /// clone can be returned from a builder while the receiver keeps - and
    /// independently frees - its own arrays.  The builders below all start
    /// from `this.clone()` and mutate the copy in place; without the clone
    /// they shallow-aliased the receiver's arrays and double-freed them.
    clone(&this) -> Diagnostic {
        mut labels_c: SpanLabel[] = [];
        mut children_c: Diagnostic[] = [];
        mut suggestions_c: Suggestion[] = [];
        for (mut i: i64 = 0; i < this.labels.length; i++)      { labels_c.push(this.labels[i]); }
        for (mut i: i64 = 0; i < this.children.length; i++)    { children_c.push(this.children[i].clone()); }
        for (mut i: i64 = 0; i < this.suggestions.length; i++) { suggestions_c.push(this.suggestions[i].clone()); }
        return Diagnostic {
            severity:    this.severity,
            code:        this.code,
            message:     this.message,
            span:        this.span,
            labels:      labels_c,
            children:    children_c,
            suggestions: suggestions_c,
        };
    }

    /// Attach a source span and return a new diagnostic (builder pattern).
    at(&this, span: SourceSpan) -> Diagnostic {
        mut r: Diagnostic = this.clone();
        r.span = span;
        r.labels.push(SpanLabel::primary(span, r.message));
        return r;
    }

    /// Like `at()`, but attaches a *short* primary caption distinct from
    /// the headline message. Used when the diagnostic has secondary
    /// labels and the renderer combines them into one snippet; the
    /// primary inline reads e.g. "value used here after move" while
    /// the headline carries the full description. Falls back to the
    /// headline if `label` is empty.
    at_with_label(&this, span: SourceSpan, label: string) -> Diagnostic {
        mut r: Diagnostic = this.clone();
        r.span = span;
        const caption: string = if (label == "") { r.message } else { label };
        r.labels.push(SpanLabel::primary(span, caption));
        return r;
    }

    /// Append a note child diagnostic.
    with_note(&this, message: string) -> Diagnostic {
        const child: Diagnostic = Diagnostic {
            severity:    Severity::Note,
            code:        ErrorCode::E0000_UNKNOWN,
            message:     message,
            span:        SourceSpan::none(),
            labels:      [],
            children:    [],
            suggestions: [],
        };
        mut r: Diagnostic = this.clone();
        r.children.push(child);
        return r;
    }

    /// Append a note child diagnostic with a source location.
    with_note_at(&this, message: string, span: SourceSpan) -> Diagnostic {
        mut child_labels: SpanLabel[] = [];
        child_labels.push(SpanLabel::primary(span, message));
        const child: Diagnostic = Diagnostic {
            severity:    Severity::Note,
            code:        ErrorCode::E0000_UNKNOWN,
            message:     message,
            span:        span,
            labels:      child_labels,
            children:    [],
            suggestions: [],
        };
        mut r: Diagnostic = this.clone();
        r.children.push(child);
        return r;
    }

    /// Append a help child diagnostic.
    help(&this, message: string) -> Diagnostic {
        const child: Diagnostic = Diagnostic {
            severity:    Severity::Help,
            code:        ErrorCode::E0000_UNKNOWN,
            message:     message,
            span:        SourceSpan::none(),
            labels:      [],
            children:    [],
            suggestions: [],
        };
        mut r: Diagnostic = this.clone();
        r.children.push(child);
        return r;
    }

    /// Append a secondary span label (e.g. "also defined here").
    also_at(&this, span: SourceSpan, message: string) -> Diagnostic {
        mut r: Diagnostic = this.clone();
        r.labels.push(SpanLabel::secondary(span, message));
        return r;
    }

    /// Append a suggestion.
    suggest(&this, suggestion: Suggestion) -> Diagnostic {
        mut r: Diagnostic = this.clone();
        r.suggestions.push(suggestion);
        return r;
    }

    /// Format for display (simple, non-rendered format).
    to_string(&this) -> string {
        if (this.span.has_location()) {
            return format("%s: %s[%s]: %s",
                this.span.to_string(),
                this.severity.label(),
                this.code.format(),
                this.message);
        }
        return format("%s[%s]: %s",
            this.severity.label(),
            this.code.format(),
            this.message);
    }
}
