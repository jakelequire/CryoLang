/// Diagnostic
///
/// A single compiler diagnostic (error, warning, note, or help).
/// Supports multi-span labels, child diagnostics, and suggestions.

namespace compiler::diag::diagnostic;

import compiler::diag::{ ErrorCode, edit_distance, severity, source_span, span_label, suggestion };
import compiler::diag::edit_distance::{ find_best_candidate };
import std::fmt;
import std::core::hash::{ DefaultHasher, Hasher };
import std::collections::string::{ String };
import std::collections::str::{ Str };
import std::core::slice::{ Slice };
import std::fmt::display::{ Display };
import compiler::diag::severity::{ Severity };
import compiler::diag::source_span::{ SourceSpan };
import compiler::diag::span_label::{ SpanLabel };
import compiler::diag::suggestion::{ Suggestion };


/// A single compiler diagnostic (error, warning, note, or help).  It owns
/// its text, so text formatted for it is released with it; the builders
/// take any `Display` and copy it in.
type struct Diagnostic {
    severity:    Severity;
    code:        ErrorCode;
    message:     String;
    span:        SourceSpan;
    labels:      [SpanLabel];
    children:    [Diagnostic];
    suggestions: [Suggestion];
    // What the diagnostic blames - a declaration, a missing import - as a key
    // naming it, empty when nothing is blamed.  Diagnostics of one cause whose
    // suggestions are the same edits are one problem written in several
    // places, and are reported once with every place labelled.
    cause:       String;
    // The headline of that one report, written about the cause rather than
    // about any one place.
    cause_headline: String;
    // Code showing the fixed shape, drawn under a help as source lines are,
    // for a fix that is no single edit of the program; empty when the help
    // has none.
    example:     String;

    /// A diagnostic of `severity` and `code` saying `message`, with no
    /// location, labels, children or cause.
    static new<T>(severity: Severity, code: ErrorCode, message: T) -> Diagnostic where T: Display {
        return Diagnostic {
            severity:    severity,
            code:        code,
            message:     String::from(message),
            span:        SourceSpan::none(),
            labels:      [],
            children:    [],
            suggestions: [],
            cause:       String::new(),
            cause_headline: String::new(),
            example:     String::new(),
        };
    }

    /// Create an error diagnostic (no location yet; attach with at()).
    static error<T>(code: ErrorCode, message: T) -> Diagnostic where T: Display {
        return Diagnostic::new(Severity::Error, code, message);
    }

    /// Create a warning diagnostic.
    static warning<T>(code: ErrorCode, message: T) -> Diagnostic where T: Display {
        return Diagnostic::new(Severity::Warning, code, message);
    }

    /// Attach a source span and return a new diagnostic (builder pattern).
    at(&this, span: SourceSpan) -> Diagnostic {
        mut r: Diagnostic = this.clone();
        r.span = span;
        r.labels.push(SpanLabel::primary(span, this.message.as_str()));
        return r;
    }

    /// Like `at()`, but attaches a *short* primary caption distinct from
    /// the headline message. Used when the diagnostic has secondary
    /// labels and the renderer combines them into one snippet; the
    /// primary inline reads e.g. "value used here after move" while
    /// the headline carries the full description. Falls back to the
    /// headline if `label` is empty.
    at_with_label<T>(&this, span: SourceSpan, label: T) -> Diagnostic where T: Display {
        mut r: Diagnostic = this.clone();
        r.span = span;
        mut caption: SpanLabel = SpanLabel::primary(span, label);
        if (caption.message.is_empty()) { caption.message = this.message.clone(); }
        r.labels.push(caption);
        return r;
    }

    /// Append a note child diagnostic.
    with_note<T>(&this, message: T) -> Diagnostic where T: Display {
        mut r: Diagnostic = this.clone();
        r.children.push(Diagnostic::new(Severity::Note, ErrorCode::E0000_UNKNOWN, message));
        return r;
    }

    /// Append a note child diagnostic with a source location.
    with_note_at<T>(&this, message: T, span: SourceSpan) -> Diagnostic where T: Display {
        mut child: Diagnostic = Diagnostic::new(Severity::Note, ErrorCode::E0000_UNKNOWN, message);
        child.span = span;
        child.labels.push(SpanLabel::primary(span, child.message.as_str()));
        mut r: Diagnostic = this.clone();
        r.children.push(child);
        return r;
    }

    /// Append a help child diagnostic.
    help<T>(&this, message: T) -> Diagnostic where T: Display {
        mut r: Diagnostic = this.clone();
        r.children.push(Diagnostic::new(Severity::Help, ErrorCode::E0000_UNKNOWN, message));
        return r;
    }

    /// Append a help child for a fix that is no single edit of the program,
    /// with `example` - code in the fixed shape, lines split by `\n` - drawn
    /// under it as source is drawn.  A fix that is one edit is a suggestion.
    help_with_example<T>(&this, message: T, example: string) -> Diagnostic where T: Display {
        mut child: Diagnostic = Diagnostic::new(Severity::Help, ErrorCode::E0000_UNKNOWN, message);
        child.example = String::from(example);
        mut r: Diagnostic = this.clone();
        r.children.push(child);
        return r;
    }

    /// Append a secondary span label (e.g. "also defined here").
    also_at<T>(&this, span: SourceSpan, message: T) -> Diagnostic where T: Display {
        mut r: Diagnostic = this.clone();
        r.labels.push(SpanLabel::secondary(span, message));
        return r;
    }

    /// A secondary label at `span`, inside the declaration named at
    /// `owner`, whose line is shown above it: a bound's line under the
    /// signature of the function the bound is on.
    also_at_in<T>(&this, span: SourceSpan, owner: SourceSpan, message: T) -> Diagnostic where T: Display {
        mut r: Diagnostic = this.clone();
        mut label: SpanLabel = SpanLabel::secondary(span, message);
        label.owner = owner;
        r.labels.push(label);
        return r;
    }

    /// Append a suggestion.
    suggest(&this, suggestion: Suggestion) -> Diagnostic {
        mut r: Diagnostic = this.clone();
        r.suggestions.push(suggestion);
        return r;
    }

    /// Blame `key` for the diagnostic, with `headline` the message of the one
    /// report every diagnostic of that cause is folded into.
    caused_by<K, H>(&this, key: K, headline: H) -> Diagnostic where K: Display, H: Display {
        mut r: Diagnostic = this.clone();
        r.cause = String::from(key);
        r.cause_headline = String::from(headline);
        return r;
    }

    /// True when `other` is the same problem: the same cause, the same
    /// severity, in the same file, and a fix made of the same edits, so
    /// applying it once settles both.
    shares_cause_with(&this, other: &Diagnostic) -> boolean {
        if (this.cause.is_empty() || this.cause != other.cause) { return false; }
        if (this.severity != other.severity) { return false; }
        if (this.span.file != other.span.file) { return false; }
        if (this.suggestions.length() != other.suggestions.length()) { return false; }
        for (mut i: i64 = 0; i < this.suggestions.length(); i++) {
            if (!this.suggestions[i].same_edits(&other.suggestions[i])) { return false; }
        }
        return true;
    }

    /// The indices of the diagnostics in `all` that are the same problem as
    /// `all[index]`, in order, `index` among them.
    static sites_sharing_cause(all: &[Diagnostic], index: i64) -> [i64] {
        mut out: [i64] = [];
        for (mut j: i64 = 0; j < all.length(); j++) {
            if (j == index || all[index].shares_cause_with(&all[j])) { out.push(j); }
        }
        return out;
    }

    /// The one report of `sites`, diagnostics of one cause: headed by the
    /// earliest site and worded by the cause's headline, with every site's
    /// caret under its own caption, the sites' other labels once each, and
    /// the help and fix once.  A site reported under another code says so
    /// in a note.
    static report_of(sites: [Diagnostic]) -> Diagnostic {
        mut order: [i64] = [];
        for (mut i: i64 = 0; i < sites.length(); i++) {
            mut at: i64 = order.length();
            while (at > 0 && sites[i].span.starts_before(&sites[order[at - 1]].span)) { at -= 1; }
            order.insert(at, i);
        }
        const head: &Diagnostic = &sites[order[0]];
        mut labels: [SpanLabel] = [];
        for (mut k: i64 = 0; k < order.length(); k++) {
            const site: &Diagnostic = &sites[order[k]];
            labels.push(SpanLabel::primary(site.span, site.primary_caption()));
        }
        for (mut k: i64 = 0; k < order.length(); k++) {
            const site: &Diagnostic = &sites[order[k]];
            for (mut l: i64 = 0; l < site.labels.length(); l++) {
                const label: &SpanLabel = &site.labels[l];
                if (label.is_primary) { continue; }
                mut seen: boolean = false;
                for (mut m: i64 = 0; m < labels.length(); m++) {
                    if (labels[m].span.same_as(&label.span) && labels[m].message == label.message) { seen = true; break; }
                }
                if (!seen) { labels.push(label.clone()); }
            }
        }
        mut r: Diagnostic = Diagnostic {
            severity:    head.severity,
            code:        head.code,
            message:     if (head.cause_headline.is_empty()) { head.message.clone() } else { head.cause_headline.clone() },
            span:        head.span,
            labels:      labels,
            children:    head.children.clone(),
            suggestions: head.suggestions.clone(),
            cause:       head.cause.clone(),
            cause_headline: head.cause_headline.clone(),
            example:     head.example.clone(),
        };
        for (mut k: i64 = 1; k < order.length(); k++) {
            const site: &Diagnostic = &sites[order[k]];
            if (site.code != head.code) {
                r = r.with_note(fmt::format("line %u is also reported as `%s`",
                    site.span.start_line, site.code.format()));
            }
        }
        return r;
    }

    /// The name of a report folded from several places: `diag-` and ten hex
    /// digits of a hash of its code, headline, file name and first place.
    /// The same input names it the same in every build, and the language
    /// server, which spells the file's path otherwise, names it the same.
    /// Empty for a diagnostic that is not a folded report.
    report_id(&this) -> string {
        if (this.other_sites().length() == 0) { return ""; }
        const key: String = f"{this.code.format()}|{this.message}|{this.span.file.basename()}|{this.span.start_line}|{this.span.start_col}";
        mut hasher: DefaultHasher = DefaultHasher::new();
        const bytes: &Slice<u8> = key.as_bytes();
        for (mut i: i64 = 0; i < bytes.length(); i++) { hasher.write_u8(bytes[i]); }
        const digits: u64 = hasher.finish() >> 24;
        mut id: String = f"diag-{digits:010X}";
        return id.into_raw();
    }

    /// The caption under this diagnostic's own caret: its primary label's,
    /// or the headline where no label at its span has one.
    primary_caption(&this) -> Str {
        for (mut i: i64 = 0; i < this.labels.length(); i++) {
            const label: &SpanLabel = &this.labels[i];
            if (!label.is_primary)             { continue; }
            if (!label.span.has_location())    { continue; }
            if (label.span.start_line != this.span.start_line) { continue; }
            if (label.span.start_col  != this.span.start_col)  { continue; }
            if (label.message.is_empty())      { continue; }
            return label.message.as_str();
        }
        return this.message.as_str();
    }

    /// The places of this report other than its head: every primary label
    /// away from `span`.  Empty for a diagnostic that is not a folded report.
    other_sites(&this) -> [SourceSpan] {
        mut out: [SourceSpan] = [];
        if (this.cause.is_empty()) { return out; }
        for (mut i: i64 = 0; i < this.labels.length(); i++) {
            const label: &SpanLabel = &this.labels[i];
            if (!label.is_primary || !label.span.has_location()) { continue; }
            if (label.span.same_as(&this.span)) { continue; }
            out.push(label.span);
        }
        return out;
    }

    /// Append a `did you mean` help and a machine-applicable suggestion when
    /// one of `candidates` is near enough to `name`; the diagnostic unchanged
    /// otherwise, so a caller chains it unconditionally.  `kind` is the noun
    /// of the help text (`local`, `function`, `field`).
    did_you_mean(&this, name: string, candidates: [string], kind: string,
                 span: SourceSpan) -> Diagnostic {
        const best: string = find_best_candidate(name, candidates);
        if (best == "") { return this.clone(); }
        mut r: Diagnostic = this.help(
            fmt::format("a %s with a similar name exists: `%s`", kind, best));
        r = r.suggest(Suggestion::machine_applicable(span, best,
            fmt::format("did you mean `%s`?", best)));
        return r;
    }

    /// Format for display (simple, non-rendered format).
    to_string(&this) -> string {
        if (this.span.has_location()) {
            mut located: String = f"{this.span.to_string()}: {this.severity.label()}[{this.code.format()}]: {this.message}";
            return located.into_raw();
        }
        mut unlocated: String = f"{this.severity.label()}[{this.code.format()}]: {this.message}";
        return unlocated.into_raw();
    }
}

/// A deep copy.  Every owning field - the text and the three arrays - is
/// rebuilt into an independent buffer, so a clone can be returned from a
/// builder while the receiver keeps - and independently frees - its own.
/// The builders all start from `this.clone()` and mutate the copy in place;
/// a shallow copy would alias the receiver's buffers and free them twice.
implement trait Clone for struct Diagnostic {
    clone(&this) -> Diagnostic {
        return Diagnostic {
            severity:    this.severity,
            code:        this.code,
            message:     this.message.clone(),
            span:        this.span,
            labels:      this.labels.clone(),
            children:    this.children.clone(),
            suggestions: this.suggestions.clone(),
            cause:       this.cause.clone(),
            cause_headline: this.cause_headline.clone(),
            example:     this.example.clone(),
        };
    }
}
