/// Diagnostic
///
/// A single compiler diagnostic (error, warning, note, or help).
/// Supports multi-span labels, child diagnostics, and suggestions.

namespace Compiler::Diag::Diagnostic;

import Compiler::Diag;
import Compiler::Diag::Severity;
import Compiler::Diag::SourceSpan;
import Compiler::Diag::SpanLabel;
import Compiler::Diag::Suggestion;


/// A single compiler diagnostic (error, warning, note, or help).
type struct Diagnostic {
    severity:    Severity;
    code:        ErrorCode;
    message:     string;
    span:        SourceSpan;
    labels:      SpanLabel[];
    children:    Diagnostic[];
    suggestions: Suggestion[];

    /// Create an error diagnostic (no location yet; attach with at()).
    static error(code: ErrorCode, message: string) -> Diagnostic {
        return Diagnostic {
            severity:    Severity::Error,
            code:        code,
            message:     message,
            span:        SourceSpan::none(),
            labels:      [],
            children:    [],
            suggestions: [],
        };
    }

    /// Create a warning diagnostic.
    static warning(code: ErrorCode, message: string) -> Diagnostic {
        return Diagnostic {
            severity:    Severity::Warning,
            code:        code,
            message:     message,
            span:        SourceSpan::none(),
            labels:      [],
            children:    [],
            suggestions: [],
        };
    }

    /// Create a note diagnostic.
    static note(code: ErrorCode, message: string) -> Diagnostic {
        return Diagnostic {
            severity:    Severity::Note,
            code:        code,
            message:     message,
            span:        SourceSpan::none(),
            labels:      [],
            children:    [],
            suggestions: [],
        };
    }

    /// Attach a source span and return a new diagnostic (builder pattern).
    at(mut &this, span: SourceSpan) -> Diagnostic {
        this.span = span;
        // Build the new labels array via push() rather than the `arr +
        // [elem]` concat operator. The concat operator on an array of
        // structs containing further arrays/strings (like SpanLabel's
        // `message: string`) emits a malformed result in cryoc's bootstrap
        // The resulting Array<T>'s length field reads as a heap pointer.
        // Push works because it reuses the receiver's storage and grows
        // by a known step.
        mut new_labels: SpanLabel[] = [];
        for (mut i: i64 = 0; i < this.labels.length; i++) {
            new_labels.push(this.labels[i]);
        }
        new_labels.push(SpanLabel::primary(span, this.message));
        return Diagnostic {
            severity:    this.severity,
            code:        this.code,
            message:     this.message,
            span:        span,
            labels:      new_labels,
            children:    this.children,
            suggestions: this.suggestions,
        };
    }

    /// Like `at()`, but attaches a *short* primary caption distinct from
    /// the headline message. Used when the diagnostic has secondary
    /// labels and the renderer combines them into one snippet; the
    /// primary inline reads e.g. "value used here after move" while
    /// the headline carries the full description. Falls back to the
    /// headline if `label` is empty.
    at_with_label(mut &this, span: SourceSpan, label: string) -> Diagnostic {
        this.span = span;
        mut new_labels: SpanLabel[] = [];
        for (mut i: i64 = 0; i < this.labels.length; i++) {
            new_labels.push(this.labels[i]);
        }
        const caption: string = if (label == "") { this.message } else { label };
        new_labels.push(SpanLabel::primary(span, caption));
        return Diagnostic {
            severity:    this.severity,
            code:        this.code,
            message:     this.message,
            span:        span,
            labels:      new_labels,
            children:    this.children,
            suggestions: this.suggestions,
        };
    }

    /// Append a note child diagnostic.
    with_note(&this, message: string) -> Diagnostic {
        const child: Diagnostic = Diagnostic {
            severity:    Severity::Note,
            code:        ErrorCode::E0000_UNKNOWN,
            message:     message,
            span:        SourceSpan::none(),
            labels:      [],
            children:    [],
            suggestions: [],
        };
        // See `at()` for why we use push() instead of `arr + [elem]`.
        mut new_children: Diagnostic[] = [];
        for (mut i: i64 = 0; i < this.children.length; i++) {
            new_children.push(this.children[i]);
        }
        new_children.push(child);
        return Diagnostic {
            severity:    this.severity,
            code:        this.code,
            message:     this.message,
            span:        this.span,
            labels:      this.labels,
            children:    new_children,
            suggestions: this.suggestions,
        };
    }

    /// Append a note child diagnostic with a source location.
    with_note_at(&this, message: string, span: SourceSpan) -> Diagnostic {
        mut child_labels: SpanLabel[] = [];
        child_labels.push(SpanLabel::primary(span, message));
        const child: Diagnostic = Diagnostic {
            severity:    Severity::Note,
            code:        ErrorCode::E0000_UNKNOWN,
            message:     message,
            span:        span,
            labels:      child_labels,
            children:    [],
            suggestions: [],
        };
        mut new_children: Diagnostic[] = [];
        for (mut i: i64 = 0; i < this.children.length; i++) {
            new_children.push(this.children[i]);
        }
        new_children.push(child);
        return Diagnostic {
            severity:    this.severity,
            code:        this.code,
            message:     this.message,
            span:        this.span,
            labels:      this.labels,
            children:    new_children,
            suggestions: this.suggestions,
        };
    }

    /// Append a help child diagnostic.
    help(&this, message: string) -> Diagnostic {
        const child: Diagnostic = Diagnostic {
            severity:    Severity::Help,
            code:        ErrorCode::E0000_UNKNOWN,
            message:     message,
            span:        SourceSpan::none(),
            labels:      [],
            children:    [],
            suggestions: [],
        };
        mut new_children: Diagnostic[] = [];
        for (mut i: i64 = 0; i < this.children.length; i++) {
            new_children.push(this.children[i]);
        }
        new_children.push(child);
        return Diagnostic {
            severity:    this.severity,
            code:        this.code,
            message:     this.message,
            span:        this.span,
            labels:      this.labels,
            children:    new_children,
            suggestions: this.suggestions,
        };
    }

    /// Append a secondary span label (e.g. "also defined here").
    also_at(&this, span: SourceSpan, message: string) -> Diagnostic {
        // See `at()` above: the `arr + [elem]` concat operator
        // produces a malformed result for SpanLabel[]; build via push().
        mut new_labels: SpanLabel[] = [];
        for (mut i: i64 = 0; i < this.labels.length; i++) {
            new_labels.push(this.labels[i]);
        }
        new_labels.push(SpanLabel::secondary(span, message));
        return Diagnostic {
            severity:    this.severity,
            code:        this.code,
            message:     this.message,
            span:        this.span,
            labels:      new_labels,
            children:    this.children,
            suggestions: this.suggestions,
        };
    }

    /// Append a suggestion.
    suggest(&this, suggestion: Suggestion) -> Diagnostic {
        // See `at()`: `arr + [elem]` produces a malformed array of structs;
        // build via push().
        mut new_suggestions: Suggestion[] = [];
        for (mut i: i64 = 0; i < this.suggestions.length; i++) {
            new_suggestions.push(this.suggestions[i]);
        }
        new_suggestions.push(suggestion);
        return Diagnostic {
            severity:    this.severity,
            code:        this.code,
            message:     this.message,
            span:        this.span,
            labels:      this.labels,
            children:    this.children,
            suggestions: new_suggestions,
        };
    }

    /// Format for display (simple, non-rendered format).
    to_string(&this) -> string {
        if (this.span.has_location()) {
            return format("%s: %s[%s]: %s",
                this.span.to_string(),
                this.severity.label(),
                this.code.format(),
                this.message);
        }
        return format("%s[%s]: %s",
            this.severity.label(),
            this.code.format(),
            this.message);
    }
}
