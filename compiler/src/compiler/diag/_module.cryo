/// Diagnostics Module
///
/// Unified diagnostic system replacing DiagEmitter and manual error-count
/// diffing.  DiagnosticSink collects all diagnostics; DiagnosticSnapshot
/// enables per-pass error isolation without global counter manipulation.

namespace compiler::diag;

import std::fmt;
import std::collections::str::{ Str };
import std::collections::string::{ String };

module {
    Severity;
    SourceSpan;
    SpanLabel;
    Suggestion;
    Diagnostic;
    Snapshot;
    Sink;
    Renderer;
    Config;
    EditDistance;
}


type enum ErrorCode {
    // Unknown Error
    E0000_UNKNOWN = 0;

    /* Lexical Analysis Errors (E0001-E0099) */
    E0001_UNEXPECTED_CHARACTER    = 1;
    E0002_UNTERMINATED_STRING     = 2;
    E0003_UNTERMINATED_CHAR       = 3;
    // 4 and 5 are reserved: they named an invalid number and an invalid
    // escape, and were never reported.
    E0006_INVALID_UNICODE         = 6;
    E0007_INVALID_HEX             = 7;
    E0008_INVALID_BINARY          = 8;
    E0009_INVALID_OCTAL           = 9;
    E0010_NUMBER_TOO_LARGE        = 10;
    E0011_LEXING_EXCEPTION        = 11;
    E0012_UNTERMINATED_COMMENT    = 12;
    E0013_BAD_OCTAL_ESCAPE        = 13;

    /* AST Validation Errors (E0050-E0069) */
    E0050_NULL_AST_NODE              = 50;
    E0051_MISSING_FUNCTION_NAME      = 51;
    E0052_MISSING_TYPE_NAME          = 52;
    E0053_NULL_PARAMETER             = 53;
    E0054_NULL_FIELD                 = 54;
    E0055_NULL_METHOD                = 55;
    E0056_METHOD_MISSING_FUNC        = 56;
    E0057_EMPTY_ENUM_VARIANTS        = 57;
    E0058_NULL_ENUM_VARIANT          = 58;
    E0059_NULL_BLOCK_STATEMENT       = 59;
    E0060_EMPTY_PROGRAM              = 60;
    E0061_TYPE_ALIAS_MISSING_TARGET  = 61;
    E0062_IMPL_MISSING_TARGET        = 62;
    E0063_IMPORT_MISSING_PATH        = 63;
    E0064_DUPLICATE_ENUM_DISCRIMINANT = 64;

    /* Syntax Errors (E0100-E0199) */
    E0100_EXPECTED_TOKEN          = 100;
    E0101_UNEXPECTED_TOKEN        = 101;
    E0102_EXPECTED_EXPRESSION     = 102;
    E0104_EXPECTED_TYPE           = 104;
    E0105_EXPECTED_IDENTIFIER     = 105;
    E0108_EXPECTED_BRACE          = 108;
    E0111_INVALID_SYNTAX          = 111;
    E0113_INVALID_PATTERN         = 113;
    E0114_DUPLICATE_DEFAULT       = 114;
    E0116_PARSE_EXCEPTION         = 116;
    // 103, 106, 107, 109, 110, 112 and 115 are reserved: they named an
    // expected statement, semicolon, parenthesis and bracket, mismatched
    // delimiters, an unexpected end of file and a failed parse recovery,
    // and were never reported.
    // A form the language does not have, written where it would be: a
    // class, a base list, a constructor or destructor, `virtual` and
    // `override` members, `protected`.  The help says what to write.
    E0117_REMOVED_FORM            = 117;
    // A method neither `static` nor written with a receiver: every
    // instance method says how it takes the receiver.
    E0118_MISSING_RECEIVER        = 118;

    /* Directive Errors (E0150-E0169) */
    E0150_DIRECTIVE_BAD_ARITY    = 150;
    E0151_DIRECTIVE_MISPLACED    = 151;
    E0152_DIRECTIVE_BAD_ARG      = 152;
    E0153_DIRECTIVE_UNKNOWN      = 153;

    /* Symbol Resolution Errors (E0154-E0169) */
    E0154_AMBIGUOUS_CALL         = 154;
    // A bare name that two declarations claim, with neither of them bound in
    // the scope that wrote it.  Distinct from E0154, which reports two
    // candidates that ARE in scope and asks the author to choose between them;
    // here nothing is in scope at all, and the name identifies a type only if
    // some index picks a winner the source never named.  Distinct from E0203,
    // which says no such name exists - the defect here is that two do.
    E0155_AMBIGUOUS_BARE_NAME    = 155;
    // A method two or more traits implemented for one type each provide at
    // the signature the call selects, with no inherent method to outrank
    // them: `p.go()` or `P::go(&p)` where `Beta::go` and `Gamma::go` both
    // fit.  A tie, never a pick by declaration or import order; it names
    // every candidate where it is declared and the trait-qualified call
    // that chooses (`Beta::go(&p)`).  Distinct from E0154, which is two
    // FUNCTIONS or two MODULES a name reaches.
    E0156_AMBIGUOUS_TRAIT_METHOD = 156;
    // 157 is reserved: a code once reported is never given a new meaning.

    /* Type Checking Errors (E0200-E0399) */
    E0200_TYPE_MISMATCH             = 200;
    E0201_UNDEFINED_VARIABLE        = 201;
    E0202_UNDEFINED_FUNCTION        = 202;
    E0203_UNDEFINED_TYPE            = 203;
    E0204_UNDEFINED_FIELD           = 204;
    E0205_REDEFINED_SYMBOL          = 205;
    E0206_REDEFINED_FUNCTION        = 206;
    E0207_REDEFINED_TYPE            = 207;
    E0208_INVALID_CAST              = 208;
    E0209_INVALID_OPERATION         = 209;
    // 210, 211 and 212 are reserved: they named an invalid assignment,
    // incompatible types and a void value used, and were never reported.
    E0213_NON_CALLABLE              = 213;
    E0214_ARGUMENT_MISMATCH         = 214;
    E0215_TOO_MANY_ARGS             = 215;
    E0216_TOO_FEW_ARGS              = 216;
    // 217 is reserved: it named a const violation and was never reported;
    // a write through a read-only place is E0250.
    E0218_IMMUTABLE_ASSIGNMENT      = 218;
    E0219_UNINITIALIZED_VAR         = 219;
    // 220 and 221 are reserved: they named unreachable code and a circular
    // dependency, and were never reported.
    E0222_INVALID_DEREF             = 222;
    E0223_INVALID_ADDRESS_OF        = 223;
    // 224, 225, 227 and 228 are reserved: they named an invalid index, an
    // index out of bounds, an overflow and an underflow, and were never
    // reported.
    E0226_DIVISION_BY_ZERO          = 226;
    E0229_INVALID_BINARY_OP         = 229;
    E0230_INVALID_UNARY_OP          = 230;
    E0231_NON_CALLABLE_TYPE         = 231;
    E0232_INVALID_ASSIGNMENT_TARGET = 232;
    E0233_UNDEFINED_SYMBOL          = 233;
    E0234_INVALID_TRY_OPERAND       = 234;
    E0235_TRY_OUTSIDE_RESULT_FN     = 235;
    E0236_RECURSIVE_TYPE            = 236;
    E0237_STATIC_ASSERT_FAILED      = 237;
    E0238_BRANCH_TYPE_MISMATCH      = 238;
    E0239_NON_CONST_ARRAY_SIZE      = 239;
    // A name that EXISTS but is not reachable from the module that wrote it.
    // Distinct from E0203, which means no such name exists anywhere, and from
    // E0353, which means the name is reachable but private.
    E0240_NAMESPACE_NOT_REACHABLE   = 240;
    // An `export` naming something it cannot grant: an item that the exported
    // path does not declare, or one it declares `private`.  Reported where the
    // export is WRITTEN, because that is the only place an author can fix it -
    // at an importer the name simply appears absent, which is E0240's story
    // and a different one.
    E0241_EXPORT_NOT_GRANTABLE      = 241;
    // A name written where a trait must stand - a supertrait, a bound, an
    // impl head's trait - that names nothing in scope.
    E0242_UNDEFINED_TRAIT           = 242;
    // An explicit import bringing in a name an earlier explicit import in
    // the same scope already brought in, in the same namespace.  Refused
    // at the second import, which is where the collision is written; the
    // first stays bound.
    E0243_NAME_IMPORTED_TWICE       = 243;
    // `import A::B as C;` where `A` offers an item `B` and `A::B` is also a
    // module: the path names both, and neither is chosen for the writer.
    E0244_IMPORT_ITEM_OR_MODULE     = 244;
    // `const NAME ...` in a trait's body: a trait declares no constants.
    E0245_CONSTANT_IN_TRAIT         = 245;
    // `const NAME ...` in `implement trait ... for ...`: there is no trait
    // constant for it to supply.
    E0246_CONSTANT_IN_TRAIT_IMPLEMENTATION = 246;
    // A constant on a generic type, or in a generic `implement` block.
    E0247_CONSTANT_ON_GENERIC_TYPE  = 247;
    // A type's constant written without a value.
    E0248_CONSTANT_WITHOUT_VALUE    = 248;
    // A constant on a type declared inside a function body.
    E0249_CONSTANT_ON_LOCAL_TYPE    = 249;
    // A write to a place reached through a read-only borrow, a read-only
    // pointer or the receiver of a `&this` method, or held by a `const`
    // binding: an assignment, a compound assignment, or a call of a
    // `mut &this` method on it.
    E0250_WRITE_THROUGH_READ_ONLY   = 250;
    // A read-only place handed where write access is wanted: its address
    // taken for a writable pointer, a `mut &T` or a `virtual mut &Trait`,
    // or a `&T` passed for one.
    E0251_READ_ONLY_FOR_WRITABLE    = 251;
    // The slice item written as a value - a binding's, a field's, a
    // parameter's or a return's own type, a type argument, a pointer's
    // pointee - where only `&Slice<T>` and `mut &Slice<T>` are types.
    E0252_SLICE_HELD_AS_VALUE       = 252;

    /* Generic/Template Errors (E0300-E0349) */
    // 300, 301, 303, 304 and 305 are reserved: they named a failed
    // instantiation, a failed generic type resolution, an invalid
    // constraint, an ambiguous generic and a recursive generic, and were
    // never reported.
    E0302_GENERIC_PARAM_MISMATCH         =  302;
    E0306_TRAIT_BOUND_NOT_SATISFIED      =  306;
    E0307_CANNOT_INFER_TYPE_ARG          =  307;
    E0308_CONFLICTING_TRAIT_IMPL         =  308;
    E0309_ASSOC_TYPE_NOT_BOUND           =  309;
    E0310_POSITIONAL_ASSOC_WITH_GENERICS =  310;
    E0311_GENERIC_PARAM_SHADOWED         =  311;
    E0312_TRAIT_IMPL_MISMATCH            =  312;
    // A trait written where a type goes, `p: Shape`, or as the pointee of a
    // pointer or reference type, `&Shape` or `Shape*`: a trait is no type,
    // and an object of one is written `virtual &Shape`.
    E0313_TRAIT_AS_TYPE                  =  313;
    // A call through a trait object of a method its signature makes
    // unavailable there: static, `this` by value, type parameters of its
    // own, or `This` outside the receiver.  The table holds no function
    // for it.
    E0314_OBJECT_METHOD_UNAVAILABLE      =  314;
    // A conversion to a trait object whose value's type does not implement
    // the trait, or names a type parameter no bound in scope says
    // implements it: no table is known for it in every copy of the body.
    E0315_OBJECT_CONVERSION              =  315;
    // `virtual` written on something that is not a trait (`virtual &i32`),
    // or a trait object in an `extern` signature, whose C side has no
    // table to call through.
    E0316_VIRTUAL_MISUSE                 =  316;
    // A bound writing more type arguments on its trait than the trait has
    // parameters and associated types of its own: an argument past them
    // fills no position.
    E0317_WRONG_TRAIT_ARGUMENT_COUNT     =  317;
    // A `with [...]` clause asking for an implementation the compiler does
    // not generate: an empty list, a trait listed twice, one that is not
    // derivable, a union, `Default` on an enum, a type declared in a
    // function body, or a field whose type lacks the trait.
    E0318_CANNOT_DERIVE                  =  318;
    // An `implement` head whose kind keyword (`struct`, `enum` or `union`)
    // names another kind than the type the head implements for.
    E0319_IMPLEMENT_KIND_MISMATCH        =  319;
    // An `implement` head naming an alias whose target is not a type a head
    // names by its declaration (a generic instance, a pointer, an array).
    E0320_IMPLEMENT_ALIAS_TARGET         =  320;

    /* Struct Errors (E0350-E0399) */
    E0350_STRUCT_FIELD_NOT_FOUND = 350;
    // 351, 352, 354, 357, 359 and 360 are reserved: they named class
    // members, constructors, `protected` and class visibility blocks.
    E0353_PRIVATE_ACCESS         = 353;
    E0355_MISSING_FIELD_INIT     = 355;
    E0356_DUPLICATE_FIELD        = 356;
    E0358_UNDEFINED_METHOD_IMPL      = 358;
    E0361_DESTRUCTURE_NON_STRUCT     = 361;
    E0362_DESTRUCTURE_INCOMPLETE     = 362;
    E0363_UNION_LITERAL_ARITY        = 363;
    E0364_INVALID_ASYNC_MEMBER       = 364;
    E0365_INVALID_ASYNC_MAIN         = 365;

    /* Control Flow Errors (E0400-E0449) */
    E0400_INVALID_BREAK          = 400;
    E0401_INVALID_CONTINUE       = 401;
    // 402 and 404 are reserved: they named an invalid return and an
    // unreachable pattern, and were never reported.
    E0403_MISSING_RETURN         = 403;
    E0405_NON_EXHAUSTIVE_MATCH   = 405;
    E0406_UNKNOWN_ENUM_VARIANT   = 406;
    E0407_INCONSISTENT_ALTERNATIVES = 407;

    /* Memory Management Errors (E0450-E0499) */
    // Note: E0450/E0451 (borrow-check codes) were removed - Cryo has no
    // borrow checker (it is a C++-like manual-memory language), so they
    // only ever implied a guarantee the compiler does not make.
    E0452_USE_AFTER_MOVE         = 452;
    E0453_DOUBLE_FREE            = 453;
    // 454 is reserved: it named a memory leak and was never reported.
    E0455_DANGLING_POINTER       = 455;
    E0456_CONDITIONAL_MOVE       = 456;
    E0457_NON_COPY_CAPTURE       = 457;
    E0458_CLOSURE_ARG_NON_FREE   = 458;
    E0459_MOVED_AFTER_POLL       = 459;
    E0460_BORROWED_TEMPORARY_RELEASED = 460;

    /* Module System Errors (E0500-E0549) */
    E0500_MODULE_NOT_FOUND       = 500;
    E0501_CIRCULAR_IMPORT        = 501;
    E0502_INVALID_IMPORT         = 502;
    E0503_PRIVATE_SYMBOL_ACCESS  = 503;
    // 504 is reserved: it named a namespace conflict and was never reported.
    E0505_EXPERIMENTAL_FEATURE   = 505;
    E0506_PRIVATE_TYPE_IN_PUBLIC_SIGNATURE = 506;

    /* Code Generation Errors (E0600-E0699) */
    E0600_CODEGEN_FAILED                = 600;
    E0602_INVALID_LLVM_TYPE             = 602;
    E0605_OPTIMIZATION_FAILED           = 605;
    E0606_FUNCTION_GENERATION_ERROR     = 606;
    E0607_VARIABLE_GENERATION_ERROR     = 607;
    E0609_TYPE_MAPPING_ERROR            = 609;
    // 610, 618 and 639 are reserved: they named class and constructor
    // generation.
    E0614_ASSIGNMENT_ERROR              = 614;
    E0619_METHOD_GENERATION_ERROR       = 619;
    E0621_ARRAY_OPERATION_ERROR         = 621;
    E0622_MEMBER_ACCESS_ERROR           = 622;
    E0628_PATTERN_MATCHING_ERROR        = 628;
    E0633_FUNCTION_BODY_ERROR           = 633;
    E0635_TYPE_CONSTRUCTOR_UNDEFINED    = 635;
    E0636_UNDEFINED_FUNCTION_CALL       = 636;
    E0638_INVALID_STRUCT_INITIALIZATION = 638;
    E0640_INVALID_ENUM_VARIANT_ACCESS   = 640;
    E0642_PARAM_TYPE_ERROR              = 642;
    E0643_RETURN_TYPE_ERROR             = 643;
    E0645_NO_STATIC_MATCH_ARM           = 645;
    E0646_THREAD_LOCAL_NOT_CONSTANT     = 646;
    E0647_LLVM_BACKEND_FAILED           = 647;
    // 601, 603, 604, 608, 611 to 613, 615 to 617, 620, 623 to 627, 629 to
    // 632, 634, 637, 641 and 644 are reserved: they named code generation
    // failures (an LLVM error, an invalid LLVM value, an unimplemented
    // intrinsic, and errors generating intrinsics, enums, structs, control
    // flow, operators, memory operations, the module context, scope
    // resolution, exception handlers, literals, casts, loops, template
    // instances, optimization, enum operations, type resolution, variable
    // initialization, generic instances, null casts and field types), and
    // were never reported.

    /* Linker Errors (E0700-E0799) */
    // 700 to 704 are reserved: they named a link error, an undefined and a
    // duplicate symbol, a missing library and an invalid target, and were
    // never reported; a failed link is E0900, naming the linker's output.

    /* System/IO Errors (E0800-E0899) */
    E0801_FILE_READ_ERROR               = 801;
    E0806_HEADER_PREPROC_FAILED         = 806;
    // 800, 802, 803, 804 and 805 are reserved: they named a missing file, a
    // failed write, a permission denied, running out of memory and an
    // internal error, and were never reported.

    /* Internal Compiler Errors (E0900-E0999) */
    E0900_INTERNAL_COMPILER_ERROR           = 900;
    E0904_COMPILER_CONFIGURATION_ERROR      = 904;
    // 901, 902, 903, 905, 906, 907 and 908 are reserved: they named an
    // unexpected state, a failed assertion, an unhandled exception and
    // method and type resolution failures, and were never reported.
    // 909 is reserved: it named constructor generation.

    /* Warning Codes (W0001-W9999) */
    W0001_UNUSED_VARIABLE               = 10001;
    W0002_UNUSED_FUNCTION               = 10002;
    // W0003, W0004, W0006, W0007, W0008 and W0010 are reserved: they named
    // an unused import, a shadowed variable, a lossy conversion, a
    // deprecated item, an unnecessary cast and missing documentation, and
    // were never reported, so `-Werror=` refuses them as it refuses any
    // name that is no warning.
    // W0005 is reserved: it named a numeric widening, which is either
    // lossless and silent or refused.
    W0009_DEAD_CODE                     = 10009;
    W0011_DUPLICATE_EXTERN_SYMBOL       = 10011;
    W0012_SIGNED_LITERAL_OUT_OF_RANGE   = 10012;
    W0013_FORMAT_STRING_MISMATCH        = 10013;
    W0014_REDUNDANT_NUMERIC_SUFFIX      = 10014;
    // W0015 is reserved: it named a hand-written call of a destructor,
    // which is refused (E0453).
    W0016_NAN_CONSTANT_PATTERN          = 10016;
    W0017_MUST_USE_DISCARDED            = 10017;
}

implement enum ErrorCode {
    /// Format as "E0200" or "W0001" depending on the code range.
    format(&this) -> string {
        const val: u32 = this as u32;
        if (val >= 10000) {
            // Warning codes: W + (val - 10000) zero-padded to 4 digits
            return fmt::format("W%04u", val - 10000).into_raw();
        }
        return fmt::format("E%04u", val).into_raw();
    }

    /// Return the numeric value as u32 for formatting purposes.
    to_u32(&this) -> u32 {
        return this as u32;
    }

    /// The warning a code is written as (`W0017`), or None when `name`
    /// names no warning.  A warning added to the enum is named here too, or
    /// `-Werror=` refuses its name.
    static warning_named(name: Str) -> Option<ErrorCode> {
        const warnings: [ErrorCode] = [
            ErrorCode::W0001_UNUSED_VARIABLE,
            ErrorCode::W0002_UNUSED_FUNCTION,
            ErrorCode::W0009_DEAD_CODE,
            ErrorCode::W0011_DUPLICATE_EXTERN_SYMBOL,
            ErrorCode::W0012_SIGNED_LITERAL_OUT_OF_RANGE,
            ErrorCode::W0013_FORMAT_STRING_MISMATCH,
            ErrorCode::W0014_REDUNDANT_NUMERIC_SUFFIX,
            ErrorCode::W0016_NAN_CONSTANT_PATTERN,
            ErrorCode::W0017_MUST_USE_DISCARDED,
        ];
        for (mut i: i64 = 0; i < warnings.length(); i++) {
            const spelled: String = fmt::format("W%04u", warnings[i].to_u32() - 10000);
            if (spelled.as_str() == name) { return Option::Some(warnings[i]); }
        }
        return Option::None;
    }


}

