/// DiagnosticSink
///
/// Collects all diagnostics emitted during compilation.
/// Supports deduplication, max-errors cutoff, warnings-as-errors promotion,
/// and per-code suppression via DiagConfig.

namespace Compiler::Diag::Sink;

import Compiler::Diag;
import Compiler::Diag::Severity;
import Compiler::Diag::Diagnostic;
import Compiler::Diag::Snapshot;
import Compiler::Diag::Config;
import Compiler::Diag::Renderer;
import std::collections::hashmap;
import Utils::Logger;


/// Collects all diagnostics emitted during compilation.
type struct DiagnosticSink {
    diagnostics:       Diagnostic[];
    error_count:       u32;
    warning_count:     u32;
    renderer:          DiagRenderer*;
    config:            DiagConfig;
    reached_max_errors: boolean;
    seen_keys:         HashMap<string, boolean>;

    static new() -> DiagnosticSink {
        return DiagnosticSink {
            diagnostics:       [],
            error_count:       0,
            warning_count:     0,
            renderer:          null,
            config:            DiagConfig::default(),
            reached_max_errors: false,
            seen_keys:         HashMap<string, boolean>::new(),
        };
    }

    /// Attach a renderer for rich diagnostic output.
    set_renderer(mut &this, renderer: DiagRenderer*) -> void {
        this.renderer = renderer;
    }

    /// Set the diagnostic configuration.
    set_config(mut &this, config: DiagConfig) -> void {
        this.config = config;
    }

    /// Emit a diagnostic, applying filtering, dedup, and rendering.
    emit(mut &this, diag: Diagnostic) -> void {
        // 1. Max-errors cutoff: stop emitting after the limit
        if (this.reached_max_errors) {
            return;
        }

        // 2. Per-code suppression
        if (this.config.is_suppressed(diag.code.to_u32())) {
            return;
        }

        // 3. Warnings-as-errors promotion
        mut effective_diag: Diagnostic = diag;
        if (this.config.warnings_as_errors && diag.severity.is_warning()) {
            effective_diag = Diagnostic {
                severity:    Severity::Error,
                code:        diag.code,
                message:     diag.message,
                span:        diag.span,
                labels:      diag.labels,
                children:    diag.children,
                suggestions: diag.suggestions,
            };
        }

        // 4. Deduplication: skip if same (code, file, start_line, start_col)
        const dedup_key: string = format("%u:%s:%u:%u",
            effective_diag.code.to_u32(), effective_diag.span.file,
            effective_diag.span.start_line, effective_diag.span.start_col);
        const h: u64 = hash_str(dedup_key);
        if (this.seen_keys.contains_key(&dedup_key)) {
            return;  // Duplicate; skip
        }
        this.seen_keys.insert(dedup_key, true);

        // 5. Update counters
        if (effective_diag.severity.is_error()) {
            this.error_count += 1;
        }
        if (effective_diag.severity.is_warning()) {
            this.warning_count += 1;
        }

        // 6. Store (rendering is deferred until flush() is called at the
        //    end of compilation, so all diagnostics appear together rather
        //    than interleaved with phase logs).
        this.diagnostics.push(effective_diag);

        // 7. Check max-errors limit. We only set the cutoff flag here;
        //    the summary is printed by the caller after flush().
        if (this.config.max_errors > 0 && this.error_count >= this.config.max_errors) {
            this.reached_max_errors = true;
        }
    }

    /// Render every collected diagnostic, non-errors first then errors,
    /// so errors land at the tail right above the abort summary where
    /// they're most visible. Within each group, emission order is
    /// preserved. Call this once at the end of compilation, before
    /// print_summary, to flush the deferred terminal output.
    flush(mut &this) -> void {
        if (this.renderer != null) {
            for (mut i: int = 0; i < this.diagnostics.length; i++) {
                if (!this.diagnostics[i].severity.is_error()) {
                    this.renderer.render(this.diagnostics[i]);
                }
            }
            for (mut i: int = 0; i < this.diagnostics.length; i++) {
                if (this.diagnostics[i].severity.is_error()) {
                    this.renderer.render(this.diagnostics[i]);
                }
            }
        } else {
            // Fall-back path with no renderer attached. Goes to stderr so
            // LSP-mode callers (which speak JSON-RPC over stdout) are not
            // corrupted if a flush sneaks through.
            for (mut i: int = 0; i < this.diagnostics.length; i++) {
                if (!this.diagnostics[i].severity.is_error()) {
                    intrinsics::fprintf(g_stderr, "%s\n", this.diagnostics[i].to_string());
                }
            }
            for (mut i: int = 0; i < this.diagnostics.length; i++) {
                if (this.diagnostics[i].severity.is_error()) {
                    intrinsics::fprintf(g_stderr, "%s\n", this.diagnostics[i].to_string());
                }
            }
        }
    }

    /// Take a snapshot of current counters.
    snapshot(&this) -> DiagnosticSnapshot {
        return DiagnosticSnapshot::new(this.error_count, this.warning_count);
    }

    /// Number of errors emitted since the given snapshot.
    errors_since(&this, snap: DiagnosticSnapshot) -> u32 {
        return this.error_count - snap.error_count;
    }

    /// Number of warnings emitted since the given snapshot.
    warnings_since(&this, snap: DiagnosticSnapshot) -> u32 {
        return this.warning_count - snap.warning_count;
    }

    /// Whether any errors have been emitted at all.
    has_errors(&this) -> boolean {
        return this.error_count > 0;
    }

    /// Whether any warnings have been emitted.  Used by the driver to
    /// decide whether to flush the deferred diagnostic queue; without
    /// this, warnings emitted in a successful build are silently
    /// discarded.
    has_warnings(&this) -> boolean {
        return this.warning_count > 0;
    }

    /// Total number of diagnostics collected.
    count(&this) -> u32 {
        return this.diagnostics.length as u32;
    }

}
