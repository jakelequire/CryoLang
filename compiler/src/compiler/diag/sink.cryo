/// DiagnosticSink
///
/// Collects all diagnostics emitted during compilation.
/// Supports deduplication, max-errors cutoff, warnings-as-errors promotion,
/// and per-code suppression via DiagConfig.

namespace Compiler::Diag::Sink;

import Compiler::Diag;
import Compiler::Diag::{ Severity, Diagnostic, Snapshot, Config, Renderer };
import std::collections::hashmap;
import Utils::Logger;
import Utils::DiagSink;


/// Collects all diagnostics emitted during compilation.
type struct DiagnosticSink {
    diagnostics:       Diagnostic[];
    error_count:       u32;
    warning_count:     u32;
    renderer:          DiagRenderer*;
    config:            DiagConfig;
    reached_max_errors: boolean;
    seen_keys:         HashMap<string, boolean>;

    // Speculative-suppression scope. While `suppress_depth > 0` every emit()
    // is counted (errors only) but neither stored, deduped, nor rendered.
    // Used by sema's additive symbolic generic-body type-check to measure what
    // it WOULD diagnose without perturbing real diagnostic output.
    suppress_depth:    u32;
    suppressed_errors: u32;

    // Source files whose WARNINGS are not the consumer's to act on: generated
    // vendor bindings. Nobody can fix a warning about a file that says DO NOT
    // EDIT in its header and is rewritten wholesale whenever the manifest
    // changes, so reporting one only buries the warnings about code the author
    // does own. Errors from these files still surface - an error stops the
    // build, and the author needs to see what stopped it.
    // Populated after module discovery has classified each module's origin.
    vendor_files:      string[];
    suppressed_vendor_warnings: u32;

    static new() -> DiagnosticSink {
        return DiagnosticSink {
            diagnostics:       [],
            error_count:       0,
            warning_count:     0,
            renderer:          null,
            config:            DiagConfig::default(),
            reached_max_errors: false,
            seen_keys:         HashMap<string, boolean>::new(),
            suppress_depth:    0,
            suppressed_errors: 0,
            vendor_files:      [],
            suppressed_vendor_warnings: 0,
        };
    }

    /// Record that `path` is a generated vendor binding, so warnings pointing
    /// into it are dropped.  Called once per vendored module, after discovery
    /// has classified module origins.
    mark_vendor_file(mut &this, path: string) -> void {
        for (mut i: i64 = 0; i < this.vendor_files.length; i++) {
            if (this.vendor_files[i].eq(path)) { return; }
        }
        this.vendor_files.push(path);
    }

    /// True when `path` is one of the generated vendor bindings.
    is_vendor_file(&this, path: string) -> boolean {
        if (path.length() == 0) { return false; }
        for (mut i: i64 = 0; i < this.vendor_files.length; i++) {
            if (this.vendor_files[i].eq(path)) { return true; }
        }
        return false;
    }

    /// Attach a renderer for rich diagnostic output.
    set_renderer(mut &this, renderer: DiagRenderer*) -> void {
        this.renderer = renderer;
    }

    /// Set the diagnostic configuration.
    set_config(mut &this, config: DiagConfig) -> void {
        this.config = config;
    }

    /// Emit a diagnostic, applying filtering, dedup, and rendering.
    emit(mut &this, diag: Diagnostic) -> void {
        // 0. Speculative suppression: while a symbolic/trial scope is active,
        //    count errors but discard the diagnostic entirely (no store, no
        //    dedup, no counters, no max-errors interaction). This keeps the
        //    additive symbolic generic-body walk from perturbing real output.
        if (this.suppress_depth > 0) {
            if (diag.severity.is_error()) { this.suppressed_errors += 1; }
            return;
        }

        // 1. Max-errors cutoff: stop emitting after the limit
        if (this.reached_max_errors) {
            return;
        }

        // 2. Per-code suppression
        if (this.config.is_suppressed(diag.code.to_u32())) {
            return;
        }

        // 3. A warning about generated vendor bindings is dropped: it reports on
        //    a file the author did not write and must not edit.  Judged BEFORE
        //    warnings-as-errors promotion, so `-Werror` cannot turn a vendored
        //    library's style warnings into errors that fail a build nobody can
        //    fix.  Errors fall through untouched.
        if (diag.severity.is_warning() && this.is_vendor_file(diag.span.file)) {
            this.suppressed_vendor_warnings += 1;
            return;
        }

        // 4. Warnings-as-errors promotion
        mut effective_diag: Diagnostic = diag;
        if (this.config.warnings_as_errors && effective_diag.severity.is_warning()) {
            // Promote in place: `effective_diag` is already a copy of `diag`,
            // so flip its severity rather than rebuilding the struct by moving
            // `diag`'s owned label/child/suggestion arrays out - that would
            // alias them into a second owner and double-free at scope exit.
            effective_diag.severity = Severity::Error;
        }

        // 5. Deduplication: skip only a TRUE duplicate - same code, position,
        // AND message. Message is part of the key, so two genuinely
        // different diagnostics that share an error code and start position
        // (common: many distinct conditions funnel through E0100/E0102/E0104)
        // stay distinct instead of collapsing into one with the second
        // silently dropped.
        const dedup_key: string = format("%u:%s:%u:%u:%s",
            effective_diag.code.to_u32(), effective_diag.span.file,
            effective_diag.span.start_line, effective_diag.span.start_col,
            effective_diag.message);
        if (this.seen_keys.contains_key(&dedup_key)) {
            return;  // Duplicate; skip
        }
        this.seen_keys.insert(dedup_key, true);

        // 6. Update counters
        if (effective_diag.severity.is_error()) {
            this.error_count += 1;
        }
        if (effective_diag.severity.is_warning()) {
            this.warning_count += 1;
        }

        // 7. Store (rendering is deferred until flush() is called at the
        //    end of compilation, so all diagnostics appear together rather
        //    than interleaved with phase logs).
        this.diagnostics.push(effective_diag);

        // 8. Check max-errors limit. We only set the cutoff flag here;
        //    the summary is printed by the caller after flush().
        if (this.config.max_errors > 0 && this.error_count >= this.config.max_errors) {
            this.reached_max_errors = true;
        }
    }

    /// Render every collected diagnostic, non-errors first then errors,
    /// so errors land at the tail right above the abort summary where
    /// they're most visible. Within each group, emission order is
    /// preserved. Call this once at the end of compilation, before
    /// print_summary, to flush the deferred terminal output.
    flush(mut &this) -> void {
        // Dropped vendor warnings stay recoverable without costing the ordinary
        // build a line: a count nobody can act on is noise in the terminal, but
        // silence with no way to see behind it hides a regression in what the
        // generator emits.
        if (this.suppressed_vendor_warnings > 0) {
            cdebug("[Diag] suppressed %u warning(s) from generated vendor bindings\n",
                   this.suppressed_vendor_warnings);
        }
        if (this.renderer != null) {
            for (mut i: int = 0; i < this.diagnostics.length; i++) {
                if (!this.diagnostics[i].severity.is_error()) {
                    this.renderer.render(&this.diagnostics[i]);
                }
            }
            for (mut i: int = 0; i < this.diagnostics.length; i++) {
                if (this.diagnostics[i].severity.is_error()) {
                    this.renderer.render(&this.diagnostics[i]);
                }
            }
        } else {
            // Fall-back path with no renderer attached. Goes to stderr so
            // LSP-mode callers (which speak JSON-RPC over stdout) are not
            // corrupted if a flush sneaks through.
            for (mut i: int = 0; i < this.diagnostics.length; i++) {
                if (!this.diagnostics[i].severity.is_error()) {
                    DiagSink::emit_raw(null, this.diagnostics[i].to_string());
                    DiagSink::emit_raw(null, "\n");
                }
            }
            for (mut i: int = 0; i < this.diagnostics.length; i++) {
                if (this.diagnostics[i].severity.is_error()) {
                    DiagSink::emit_raw(null, this.diagnostics[i].to_string());
                    DiagSink::emit_raw(null, "\n");
                }
            }
        }
    }

    /// Begin a speculative-suppression scope. Nestable: each begin must be
    /// matched by an end_suppress(). While active, emit() counts errors but
    /// stores/renders nothing.
    begin_suppress(mut &this) -> void {
        this.suppress_depth += 1;
    }

    /// End a speculative-suppression scope opened by begin_suppress().
    end_suppress(mut &this) -> void {
        if (this.suppress_depth > 0) {
            this.suppress_depth -= 1;
        }
    }


    /// Take a snapshot of current counters.
    snapshot(&this) -> DiagnosticSnapshot {
        return DiagnosticSnapshot::new(this.error_count, this.warning_count);
    }

    /// Number of errors emitted since the given snapshot.
    errors_since(&this, snap: DiagnosticSnapshot) -> u32 {
        return this.error_count - snap.error_count;
    }

    /// Number of warnings emitted since the given snapshot.
    warnings_since(&this, snap: DiagnosticSnapshot) -> u32 {
        return this.warning_count - snap.warning_count;
    }

    /// Whether any errors have been emitted at all.
    has_errors(&this) -> boolean {
        return this.error_count > 0;
    }

    /// Whether any warnings have been emitted.  Used by the driver to
    /// decide whether to flush the deferred diagnostic queue; without
    /// this, warnings emitted in a successful build are silently
    /// discarded.
    has_warnings(&this) -> boolean {
        return this.warning_count > 0;
    }

    /// Total number of diagnostics collected.
    count(&this) -> u32 {
        return this.diagnostics.length as u32;
    }

}
