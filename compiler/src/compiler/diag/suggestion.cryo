/// Suggestion
///
/// A machine-readable fix attached to a diagnostic.  Supports both
/// single-edit and multi-edit (atomic) suggestions, plus an Applicability
/// hint that tells callers whether the edit can be applied
/// automatically by an IDE without showing it to the user first.

namespace compiler::diag::suggestion;

import compiler::diag::source_span::{ SourceSpan };
import std::collections::string::{ String };
import std::fmt::display::{ Display };


/// What applying a Suggestion verbatim gives.  A suggestion shows a code
/// change only when the compiler is certain of it: there is no "probably"
/// level.  A diagnostic whose fix cannot be stated with certainty carries
/// its advice as help text and no suggestion.
type enum Applicability {
    /// The fix is correct: applied verbatim it lands the code the
    /// diagnostic asks for, with nothing left to fill in.  An editor may
    /// apply it automatically.
    MachineApplicable;
    /// The fix is correct in shape, and its text holds placeholders (a
    /// parameter name, `_`, `...`) the author replaces before the code
    /// compiles.
    HasPlaceholders;
}

implement enum Applicability {
    /// Stable lowercase label used in the LSP wire payload's
    /// `applicability` field so an editor can mark machine-applicable
    /// fixes as `isPreferred` in its code-action menu.
    wire_label(&this) -> string {
        return match (this) {
            Applicability::MachineApplicable => { "machine-applicable" }
            Applicability::HasPlaceholders   => { "has-placeholders"   }
        };
    }

}


/// One (span, replacement) edit inside a possibly-multipart suggestion.
/// Multi-part suggestions hold several of these and the IDE applies all
/// of them atomically - useful for fixes like "add `mut` HERE and change
/// `&` to `&mut` THERE" that don't compile if applied piecewise.
type struct SuggestionPart {
    span:        SourceSpan;
    replacement: string;

    static new(span: SourceSpan, replacement_text: string) -> SuggestionPart {
        const replacement: string = replacement_text;
        return SuggestionPart {
            span:        span,
            replacement: replacement,
        };
    }
}


/// A suggested code change attached to a diagnostic.
///
/// Keeps the legacy `span` / `replacement` pair on the surface so the
/// existing single-edit call sites and the terminal renderer continue
/// to work without churn; `parts` carries the same data for multi-part
/// fixes and is what new code should populate via `multipart()`.
type struct Suggestion {
    /// What the fix does, owned by the suggestion.
    message:       String;
    span:          SourceSpan;
    replacement:   string;
    parts:         [SuggestionPart];
    applicability: Applicability;

    /// Single-edit suggestion that the IDE may auto-apply: the fix lands
    /// valid, compilable code verbatim, with no required user input.
    static machine_applicable<T>(span: SourceSpan, replacement: string,
                                  message: T) -> Suggestion where T: Display {
        return Suggestion::single(span, replacement, message,
                                  Applicability::MachineApplicable);
    }

    /// Single-edit constructor with an explicit applicability level.
    static single<T>(span: SourceSpan, replacement: string, message: T,
                     applicability: Applicability) -> Suggestion where T: Display {
        mut parts: [SuggestionPart] = [];
        parts.push(SuggestionPart::new(span, replacement));
        return Suggestion {
            message:       String::from(message),
            span:          span,
            replacement:   replacement,
            parts:         parts,
            applicability: applicability,
        };
    }

    /// A fix made of several edits, which only compile applied together.
    /// `parts` holds at least one edit; the first is the surface pair.
    static multipart<T>(parts: [SuggestionPart], message: T,
                        applicability: Applicability) -> Suggestion where T: Display {
        const first: SuggestionPart = parts[0];
        return Suggestion {
            message:       String::from(message),
            span:          first.span,
            replacement:   first.replacement,
            parts:         parts,
            applicability: applicability,
        };
    }

    /// True when `other` makes exactly the same edits, in the same order.
    same_edits(&this, other: &Suggestion) -> boolean {
        if (this.parts.length() != other.parts.length()) { return false; }
        for (mut i: i64 = 0; i < this.parts.length(); i++) {
            if (!this.parts[i].span.same_as(&other.parts[i].span)) { return false; }
            if (this.parts[i].replacement != other.parts[i].replacement) { return false; }
        }
        return true;
    }

}

/// A deep copy; the message and `parts` (SuggestionPart is Copy) are the
/// owning fields, rebuilt into independent buffers so the clone can be
/// stored in a second owner without a double-free.
implement trait Clone for struct Suggestion {
    clone(&this) -> Suggestion {
        mut parts_c: [SuggestionPart] = [];
        for (mut i: i64 = 0; i < this.parts.length(); i++) {
            parts_c.push(this.parts[i]);
        }
        return Suggestion {
            message:       this.message.clone(),
            span:          this.span,
            replacement:   this.replacement,
            parts:         parts_c,
            applicability: this.applicability,
        };
    }
}
