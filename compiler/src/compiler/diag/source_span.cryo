/// SourceSpan
///
/// Location information attached to a diagnostic.

namespace compiler::diag::source_span;

import std::fmt;
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::fs::path::{ Path };


/// Location information attached to a diagnostic.
type struct SourceSpan {
    file:       string;
    start_line: u32;
    start_col:  u32;
    end_line:   u32;
    end_col:    u32;

    /// A span with no location (for diagnostics without source context).
    static none() -> SourceSpan {
        return SourceSpan {
            file:       "",
            start_line: 0,
            start_col:  0,
            end_line:   0,
            end_col:    0,
        };
    }

    static new(file_text: string, start_line: u32, start_col: u32,
               end_line: u32, end_col: u32) -> SourceSpan {
        const file: string = file_text;
        return SourceSpan {
            file:       file,
            start_line: start_line,
            start_col:  start_col,
            end_line:   end_line,
            end_col:    end_col,
        };
    }

    has_location(&this) -> boolean {
        return this.start_line > 0;
    }

    /// True when `other` covers exactly the same text.
    same_as(&this, other: &SourceSpan) -> boolean {
        return this.file == other.file
            && this.start_line == other.start_line && this.start_col == other.start_col
            && this.end_line == other.end_line && this.end_col == other.end_col;
    }

    /// True when this span lies inside `other`, in the same file: it starts
    /// no earlier and ends no later.  A span with no location lies inside
    /// nothing.
    within(&this, other: &SourceSpan) -> boolean {
        if (!this.has_location() || !other.has_location() || this.file != other.file) { return false; }
        const starts_inside: boolean = this.start_line > other.start_line
            || (this.start_line == other.start_line && this.start_col >= other.start_col);
        const ends_inside: boolean = this.end_line < other.end_line
            || (this.end_line == other.end_line && this.end_col <= other.end_col);
        return starts_inside && ends_inside;
    }

    /// The zero-width point where this span ends, where text written after
    /// it is inserted.  No location when the span has none.
    end_point(&this) -> SourceSpan {
        return SourceSpan::new(this.file, this.end_line, this.end_col, this.end_line, this.end_col);
    }

    /// True when this span starts before `other`: by file path, then line,
    /// then column.  A span with no location starts before none, and every
    /// located span starts before it.
    starts_before(&this, other: &SourceSpan) -> boolean {
        if (!this.has_location()) { return false; }
        if (!other.has_location()) { return true; }
        if (this.file != other.file) { return this.file < other.file; }
        if (this.start_line != other.start_line) { return this.start_line < other.start_line; }
        return this.start_col < other.start_col;
    }

    /// The smallest span covering both operands: earliest start, latest end.
    /// A location-less operand contributes nothing (the other is returned as
    /// is), so a caller can fold over spans that may be absent without
    /// guarding each one.  Operands from different files are NOT merged -
    /// `a` is returned, since a range straddling two files points nowhere.
    static covering(a: SourceSpan, b: SourceSpan) -> SourceSpan {
        if (!a.has_location()) { return b; }
        if (!b.has_location()) { return a; }
        if (!a.file.eq(b.file)) { return a; }

        mut start_line: u32 = a.start_line;
        mut start_col:  u32 = a.start_col;
        if (b.start_line < start_line
                || (b.start_line == start_line && b.start_col < start_col)) {
            start_line = b.start_line;
            start_col  = b.start_col;
        }

        mut end_line: u32 = a.end_line;
        mut end_col:  u32 = a.end_col;
        if (b.end_line > end_line
                || (b.end_line == end_line && b.end_col > end_col)) {
            end_line = b.end_line;
            end_col  = b.end_col;
        }

        return SourceSpan::new(a.file, start_line, start_col, end_line, end_col);
    }

    to_string(&this) -> string {
        if (!this.has_location()) {
            return "<unknown>";
        }
        return fmt::format("%s:%u:%u", this.file, this.start_line, this.start_col).into_raw();
    }
}

implement trait Clone for struct SourceSpan {
    clone(&this) -> SourceSpan { return *this; }
}

/// How a build writes a source file's name into the program it compiles: a
/// panic's location and the debug info.  A file under the standard library's
/// root is written as `stdlib/` followed by its path below the root, with `/`
/// between components, so the stdlib's objects hold the same text wherever
/// the stdlib lives and an archive built from one copy is the archive any
/// other copy would build.  Every other file is written as the build was
/// given it.
type struct ProgramFileNames {
    /// The standard library's root as the build spells its files' paths;
    /// empty when the build reaches no standard library.
    standard_library_root: string;

    static new(standard_library_root: string) -> ProgramFileNames {
        return ProgramFileNames { standard_library_root: standard_library_root };
    }

    /// The name `file` is written into the program under.
    name_of(&this, file: string) -> string {
        const root: string = this.standard_library_root;
        if (root.length() == 0 || !Path::from(Str::from(file)).starts_with(Path::from(Str::from(root)))) {
            return file;
        }
        mut name: String = String::from_str(Str::new("stdlib"));
        const bytes: u8* = file as u8*;
        // A run of separators, and the root's end, is one `/`.
        mut separated: boolean = true;
        for (mut at: i64 = root.length(); at < file.length(); at++) {
            if (Path::is_separator(bytes[at])) {
                separated = true;
            } else {
                if (separated) { name.push_byte('/' as u8); }
                separated = false;
                name.push_byte(bytes[at]);
            }
        }
        return name.into_raw();
    }
}
