/// LLVM Type-Safe Wrappers
///
/// Wraps opaque void* LLVM-C handles in distinct structs to prevent
/// misuse (e.g., passing a value where a type is expected).  Each
/// wrapper is a lightweight value type holding a single pointer.

namespace Compiler::Codegen::LLVMTypes;

import std::env;
import std::collections::str;
import Compiler::Codegen;
import std::fs::metadata;
import std::fs::path;
import std::fmt;


// LLVM-C enum mirrors
//
// Every integer argument and return value that LLVM-C documents as a
// named enum is mirrored here so callers reference symbols rather than
// magic numbers.  An LLVM minor-version surprise (a renumbered variant,
// an inserted predicate) then becomes a single edit in this file
// instead of a scavenger hunt across codegen.
//
// Values are taken from `llvm-c/Core.h`, `llvm-c/Analysis.h`, and
// `llvm-c/TargetMachine.h` for LLVM 20 (the version currently linked).
// These enums have been stable for many releases but are not part of
// the LLVM-C ABI stability guarantee; verifying against the headers
// when bumping LLVM is the price of using the C API.

/// Mirror of `LLVMTypeKind` (`llvm-c/Core.h`).
type enum LTypeKind : i32 {
    Void           = 0;
    Half           = 1;
    Float          = 2;
    Double         = 3;
    X86_FP80       = 4;
    FP128          = 5;
    PPC_FP128      = 6;
    Label          = 7;
    Integer        = 8;
    Function       = 9;
    Struct         = 10;
    Array          = 11;
    Pointer        = 12;
    Vector         = 13;
    Metadata       = 14;
    X86_MMX        = 15;
    Token          = 16;
    ScalableVector = 17;
    BFloat         = 18;
    X86_AMX        = 19;
    TargetExt      = 20;
}

/// Mirror of `LLVMIntPredicate` (`llvm-c/Core.h`).  The range starts at 32
/// because LLVM-C's `CmpInst::Predicate` continues past the FCmp space.
type enum LIntPredicate : i32 {
    EQ  = 32;
    NE  = 33;
    UGT = 34;
    UGE = 35;
    ULT = 36;
    ULE = 37;
    SGT = 38;
    SGE = 39;
    SLT = 40;
    SLE = 41;
}

/// Mirror of `LLVMRealPredicate` (`llvm-c/Core.h`).
type enum LRealPredicate : i32 {
    PredFalse = 0;
    OEQ       = 1;
    OGT       = 2;
    OGE       = 3;
    OLT       = 4;
    OLE       = 5;
    ONE       = 6;
    ORD       = 7;
    UNO       = 8;
    UEQ       = 9;
    UGT       = 10;
    UGE       = 11;
    ULT       = 12;
    ULE       = 13;
    UNE       = 14;
    PredTrue  = 15;
}

/// Mirror of `LLVMLinkage` (`llvm-c/Core.h`).
type enum LLinkage : i32 {
    External            = 0;
    AvailableExternally = 1;
    LinkOnceAny         = 2;
    LinkOnceODR         = 3;
    LinkOnceODRAutoHide = 4;
    WeakAny             = 5;
    WeakODR             = 6;
    Appending           = 7;
    Internal            = 8;
    Private             = 9;
    DLLImport           = 10;
    DLLExport           = 11;
    ExternalWeak        = 12;
    Ghost               = 13;
    Common              = 14;
    LinkerPrivate       = 15;
    LinkerPrivateWeak   = 16;
}

/// Mirror of `LLVMVerifierFailureAction` (`llvm-c/Analysis.h`).
type enum LVerifierAction : i32 {
    AbortProcess = 0;
    PrintMessage = 1;
    ReturnStatus = 2;
}

/// Mirror of `LLVMCodeGenOptLevel` (`llvm-c/TargetMachine.h`).
type enum LCodeGenOptLevel : i32 {
    LevelNone       = 0;
    LevelLess       = 1;
    LevelDefault    = 2;
    LevelAggressive = 3;
}

/// Mirror of `LLVMRelocMode` (`llvm-c/TargetMachine.h`).
type enum LRelocMode : i32 {
    Default      = 0;
    Static       = 1;
    PIC          = 2;
    DynamicNoPic = 3;
    ROPI         = 4;
    RWPI         = 5;
    ROPI_RWPI    = 6;
}

/// Mirror of `LLVMCodeModel` (`llvm-c/TargetMachine.h`).
type enum LCodeModel : i32 {
    Default    = 0;
    JITDefault = 1;
    Tiny       = 2;
    Small      = 3;
    Kernel     = 4;
    Medium     = 5;
    Large      = 6;
}

/// Mirror of `LLVMCodeGenFileType` (`llvm-c/TargetMachine.h`).
type enum LFileType : i32 {
    Assembly = 0;
    Object   = 1;
}


// LLVMModule: Wrapper around LLVMModuleRef

type struct LModule {
    raw: void*;

    static create(name: string) -> LModule {
        return LModule { raw: llvm::LLVMModuleCreateWithNameInContext(
            name, LContext::current().raw) };
    }

    static null() -> LModule {
        return LModule { raw: null };
    }

    is_valid(&this) -> boolean {
        return this.raw != null;
    }

    dispose(mut &this) -> void {
        if (this.raw != null) {
            llvm::LLVMDisposeModule(this.raw);
            this.raw = null;
        }
    }

    /// Verify the module.  Returns true if valid.
    verify(&this) -> boolean {
        mut err_msg: i8* = null;
        const result: i32 = llvm::LLVMVerifyModule(
            this.raw, LVerifierAction::ReturnStatus as i32, &err_msg as void*);
        if (err_msg != null) {
            llvm::LLVMDisposeMessage(err_msg as void*);
        }
        return result == 0;
    }

    print_to_string(&this) -> string {
        return llvm::LLVMPrintModuleToString(this.raw) as string;
    }

    dump(&this) -> void {
        llvm::LLVMDumpModule(this.raw);
    }

    /// Write this module's bitcode to `path` for the multi-process object
    /// emitter (a child process re-parses it and emits the `.o`).  Returns
    /// true on success.
    write_bitcode(&this, path: string) -> boolean {
        return llvm::LLVMWriteBitcodeToFile(this.raw, path) == 0;
    }

    /// Parse a textual-or-bitcode IR file into a NEW module owned by `ctx`.
    /// Returns a null LModule on failure.  `LLVMParseIRInContext` consumes the
    /// file's memory buffer internally, so there is nothing to dispose on the
    /// success path.
    static parse_ir_file(path: string, ctx: LContext) -> LModule {
        mut membuf: void* = null;
        mut err: i8* = null;
        if (llvm::LLVMCreateMemoryBufferWithContentsOfFile(
                path, &membuf as void*, &err as void*) != 0) {
            if (err != null) { llvm::LLVMDisposeMessage(err as void*); }
            return LModule::null();
        }
        mut out_mod: void* = null;
        mut perr: i8* = null;
        if (llvm::LLVMParseIRInContext(
                ctx.raw, membuf, &out_mod as void*, &perr as void*) != 0) {
            if (perr != null) { llvm::LLVMDisposeMessage(perr as void*); }
            return LModule::null();
        }
        return LModule { raw: out_mod };
    }

    set_target_triple(&this, triple: string) -> void {
        llvm::LLVMSetTarget(this.raw, triple);
    }

    set_data_layout(&this, layout: string) -> void {
        llvm::LLVMSetDataLayout(this.raw, layout);
    }

    /// Append module-level inline assembly (naked / global `asm { ... }`).
    /// Multiple appends accumulate, each emitted as a top-level
    /// `module asm "..."` block.
    append_inline_asm(&this, asm_text: string) -> void {
        llvm::LLVMAppendModuleInlineAsm(this.raw, asm_text, asm_text.length());
    }

    /// ABI size in bytes of an LLVM type under this module's data
    /// layout.  Returns 0 when the type is invalid or the module has
    /// no data layout set (the layout is installed in
    /// `run_ir_generation` before any IR is emitted, so callers during
    /// codegen always see a valid one).  The returned `LLVMTargetDataRef`
    /// is owned by the module - do NOT dispose it.
    abi_size_of(&this, ty: LType) -> u64 {
        if (!ty.is_valid()) { return 0; }
        const td: void* = llvm::LLVMGetModuleDataLayout(this.raw);
        if (td == null) { return 0; }
        return llvm::LLVMABISizeOfType(td, ty.raw);
    }

    context(&this) -> LContext {
        return LContext { raw: llvm::LLVMGetModuleContext(this.raw) };
    }

    get_named_function(&this, name: string) -> LValue {
        return LValue { raw: llvm::LLVMGetNamedFunction(this.raw, name) };
    }

    get_named_global(&this, name: string) -> LValue {
        return LValue { raw: llvm::LLVMGetNamedGlobal(this.raw, name) };
    }

    /// Idempotent: if a function with `name` is already in this module,
    /// return that existing handle.  LLVMAddFunction would otherwise auto-
    /// rename to `name.N` on collision, which strands every later caller
    /// that referenced the bare name as an undefined external (the real
    /// definition gets the suffixed name).  Generic specializations in
    /// particular flow through codegen many times per requesting module,
    /// so duplicate-add was producing thousands of `.N`-renamed declares
    /// per module.
    add_function(&this, name: string, fn_type: LType) -> LValue {
        const existing: void* = llvm::LLVMGetNamedFunction(this.raw, name);
        if (existing != null) {
            return LValue { raw: existing };
        }
        return LValue { raw: llvm::LLVMAddFunction(this.raw, name, fn_type.raw) };
    }

    add_global(&this, ty: LType, name: string) -> LValue {
        return LValue { raw: llvm::LLVMAddGlobal(this.raw, ty.raw, name) };
    }
}


// LContext: Wrapper around LLVMContextRef

/// The current target's codegen LLVM context, or null to use the process
/// global context.  Published/disposed per target by the driver
/// (`instance.cryo`) so the ~385 MiB of LLVM type tables a single target
/// produces are reclaimed at the target boundary instead of stacking across
/// the lib+bin builds in the never-disposed global context.  Single-threaded
/// compiler → a module-level global needs no synchronisation (same argument
/// as `g_ast_arena` / `g_shared_type_cache`).
mut g_codegen_context: void* = null;

type struct LContext {
    raw: void*;

    static create() -> LContext {
        return LContext { raw: llvm::LLVMContextCreate() };
    }

    static global() -> LContext {
        return LContext { raw: llvm::LLVMGetGlobalContext() };
    }

    /// The context codegen should build into.  When a per-target context is
    /// published (`g_codegen_context`, set by the driver around each target's
    /// pipeline) every leaf type/module/builder factory routes through it, so
    /// disposing that one context at the target boundary reclaims all of the
    /// target's LLVM type tables + named structs (~385 MiB) — the LLVM-side
    /// analogue of the per-target arena.  Null => the real global context, so
    /// non-project paths (compile_raw / frontend-only) behave exactly as before.
    static current() -> LContext {
        if (g_codegen_context != null) {
            return LContext { raw: g_codegen_context };
        }
        return LContext { raw: llvm::LLVMGetGlobalContext() };
    }

    static null() -> LContext {
        return LContext { raw: null };
    }

    is_valid(&this) -> boolean {
        return this.raw != null;
    }

    dispose(mut &this) -> void {
        if (this.raw != null) {
            llvm::LLVMContextDispose(this.raw);
            this.raw = null;
        }
    }
}

// Per-target codegen context lifecycle (Stage 4: cap LLVM-side memory).
// Called by the driver (instance.cryo) around each target's pipeline,
// mirroring the per-target arena's set-active / reset.

/// Publish a fresh per-target codegen context.  Disposes any prior one first
/// (defensive: the success/failure paths normally dispose at target end).
public function set_codegen_context_new() -> void {
    if (g_codegen_context != null) {
        llvm::LLVMContextDispose(g_codegen_context);
    }
    g_codegen_context = llvm::LLVMContextCreate();
}

/// Dispose the per-target codegen context and fall back to the global one.
/// Frees every LLVM type/named-struct/module created for this target in one
/// shot — the LLVM analogue of the arena reset.  No-op when unset.  Safe to
/// call after the per-module `LLVMDisposeModule`s: those detach their modules
/// from the context first, and `LLVMContextDispose` reclaims anything left.
public function dispose_codegen_context() -> void {
    if (g_codegen_context != null) {
        llvm::LLVMContextDispose(g_codegen_context);
        g_codegen_context = null;
    }
}

/// Parallel-codegen: publish a fresh per-MODULE context WITHOUT disposing the
/// prior one.  Unlike `set_codegen_context_new`, ownership of the previous
/// context transfers to the caller (it has been captured in an in-flight emit
/// job and will be disposed by the worker that emits it).  Disposing here would
/// free a context a worker is still reading.  Pair every producer that calls
/// this with `clear_codegen_context_ptr` once the final batch has joined.
public function set_codegen_context_new_keep_prior() -> void {
    g_codegen_context = llvm::LLVMContextCreate();
}

/// Parallel-codegen: the currently-published codegen context, captured into an
/// emit job so the worker can dispose it after `emit_to_file`.
public function current_codegen_context() -> void* {
    return g_codegen_context;
}

/// Parallel-codegen: drop the global's pointer WITHOUT disposing.  Used after
/// the last emit batch has joined — every per-module context was already
/// disposed by its worker, so the dangling global must be nulled (not freed)
/// before the target-end `dispose_codegen_context` runs, or it double-frees.
public function clear_codegen_context_ptr() -> void {
    g_codegen_context = null;
}


// LBuilder: Wrapper around LLVMBuilderRef

type struct LBuilder {
    raw: void*;

    static create() -> LBuilder {
        return LBuilder { raw: llvm::LLVMCreateBuilderInContext(LContext::current().raw) };
    }

    static null() -> LBuilder {
        return LBuilder { raw: null };
    }

    is_valid(&this) -> boolean {
        return this.raw != null;
    }

    dispose(mut &this) -> void {
        if (this.raw != null) {
            llvm::LLVMDisposeBuilder(this.raw);
            this.raw = null;
        }
    }

    position_at_end(&this, block: LBasicBlock) -> void {
        llvm::LLVMPositionBuilderAtEnd(this.raw, block.raw);
    }

    get_insert_block(&this) -> LBasicBlock {
        return LBasicBlock { raw: llvm::LLVMGetInsertBlock(this.raw) };
    }

    // ----- Terminators -----

    build_ret_void(&this) -> LValue {
        return LValue { raw: llvm::LLVMBuildRetVoid(this.raw) };
    }

    build_ret(&this, val: LValue) -> LValue {
        if (val.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildRet(this.raw, val.raw) };
    }

    build_br(&this, dest: LBasicBlock) -> LValue {
        if (dest.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildBr(this.raw, dest.raw) };
    }

    build_cond_br(&this, cond: LValue, then_bb: LBasicBlock, else_bb: LBasicBlock) -> LValue {
        if (cond.raw == null || then_bb.raw == null || else_bb.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildCondBr(this.raw, cond.raw, then_bb.raw, else_bb.raw) };
    }

    build_switch(&this, val: LValue, else_bb: LBasicBlock, num_cases: u32) -> LValue {
        if (val.raw == null || else_bb.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildSwitch(this.raw, val.raw, else_bb.raw, num_cases) };
    }

    build_unreachable(&this) -> LValue {
        return LValue { raw: llvm::LLVMBuildUnreachable(this.raw) };
    }

    // ----- Integer Arithmetic -----

    build_add(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildAdd(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_sub(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildSub(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_mul(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildMul(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_sdiv(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildSDiv(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_udiv(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildUDiv(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_srem(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildSRem(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_urem(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildURem(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_neg(&this, val: LValue, name: string) -> LValue {
        if (val.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildNeg(this.raw, val.raw, name) };
    }

    // ----- Float Arithmetic -----

    build_fadd(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildFAdd(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_fsub(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildFSub(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_fmul(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildFMul(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_fdiv(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildFDiv(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_frem(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildFRem(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_fneg(&this, val: LValue, name: string) -> LValue {
        if (val.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildFNeg(this.raw, val.raw, name) };
    }

    // ----- Bitwise -----

    build_shl(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildShl(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_lshr(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildLShr(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_ashr(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildAShr(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_and(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildAnd(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_or(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildOr(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_xor(&this, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildXor(this.raw, lhs.raw, rhs.raw, name) };
    }

    build_not(&this, val: LValue, name: string) -> LValue {
        if (val.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildNot(this.raw, val.raw, name) };
    }

    // ----- Comparisons -----

    build_icmp(&this, op: LIntPredicate, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildICmp(this.raw, op as i32, lhs.raw, rhs.raw, name) };
    }

    build_fcmp(&this, op: LRealPredicate, lhs: LValue, rhs: LValue, name: string) -> LValue {
        if (lhs.raw == null || rhs.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildFCmp(this.raw, op as i32, lhs.raw, rhs.raw, name) };
    }

    // ----- Memory -----

    build_alloca(&this, ty: LType, name: string) -> LValue {
        if (ty.raw == null) { return LValue::null(); }
        if (ty.kind() == LTypeKind::Void) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildAlloca(this.raw, ty.raw, name) };
    }

    build_load(&this, ty: LType, ptr: LValue, name: string) -> LValue {
        if (ty.raw == null || ptr.raw == null) { return LValue::null(); }
        if (ty.kind() == LTypeKind::Void) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildLoad2(this.raw, ty.raw, ptr.raw, name) };
    }

    /// Pluck the next variadic argument of `ty` from the va_list pointed to
    /// by `list`.  `list` is the alloca pointer the prologue allocates (see
    /// `emit_va_start_for_variadic`); its underlying storage type is per-ABI
    /// (`[24 x i8]` for SysV-amd64, `i8*` for Win64), but `LLVMBuildVAArg`
    /// only cares about the pointer.  Only sound for scalar `ty`; aggregates
    /// are unsupported by the LLVM `va_arg` instruction.
    build_va_arg(&this, list: LValue, ty: LType, name: string) -> LValue {
        if (list.raw == null || ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildVAArg(this.raw, list.raw, ty.raw, name) };
    }

    build_store(&this, val: LValue, ptr: LValue) -> LValue {
        if (val.raw == null || ptr.raw == null) { return LValue::null(); }
        // Guard: never store a void-typed value; LLVM's DataLayout::getAlignment
        // enters undefined behavior on unsized types, causing infinite recursion.
        const val_ty: void* = llvm::LLVMTypeOf(val.raw);
        if (val_ty != null && LType::kind_of(val_ty) == LTypeKind::Void) {
            return LValue::null();
        }
        return LValue { raw: llvm::LLVMBuildStore(this.raw, val.raw, ptr.raw) };
    }

    build_gep(&this, ty: LType, ptr: LValue, indices: void*, num_indices: u32, name: string) -> LValue {
        if (ty.raw == null || ptr.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildGEP2(this.raw, ty.raw, ptr.raw, indices, num_indices, name) };
    }

    build_struct_gep(&this, ty: LType, ptr: LValue, idx: u32, name: string) -> LValue {
        if (ty.raw == null || ptr.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildStructGEP2(this.raw, ty.raw, ptr.raw, idx, name) };
    }

    build_global_string_ptr(&this, str: string, name: string) -> LValue {
        return LValue { raw: llvm::LLVMBuildGlobalStringPtr(this.raw, str, name) };
    }

    // ----- Atomic Operations -----
    //
    // Memory ordering integers mirror LLVMAtomicOrdering in llvm-c/Core.h:
    //   0 = NotAtomic, 1 = Unordered, 2 = Monotonic (Relaxed),
    //   4 = Acquire, 5 = Release, 6 = AcquireRelease,
    //   7 = SequentiallyConsistent
    //
    // The single-thread flag is always 0 here (multi-threaded ops).  The
    // stdlib's `std::sync::atomic::Ordering` enum is what the user sees;
    // these wrappers take the post-translation integer so the cost of the
    // translation stays in the codegen dispatcher.
    //
    // Atomic loads and stores REQUIRE an explicit alignment (LLVM rejects
    // the verifier check otherwise); pass the natural alignment of the
    // pointee in bytes (1, 2, 4, or 8).

    /// Emits an LLVM `fence` instruction with the given memory ordering.
    /// `Name` is unused at the IR level; passes the empty string.
    build_fence(&this, order: i32) -> LValue {
        return LValue { raw: llvm::LLVMBuildFence(this.raw, order, 0, "") };
    }

    /// Emits `load atomic Ty, Ptr ordering, align Bytes`.  Used by the
    /// per-type `atomic_load_*` intrinsics; not a substitute for
    /// `build_load`, which is non-atomic.
    build_atomic_load(&this, ty: LType, ptr: LValue, order: i32, align_bytes: u32, name: string) -> LValue {
        if (ty.raw == null || ptr.raw == null) { return LValue::null(); }
        const inst: void* = llvm::LLVMBuildLoad2(this.raw, ty.raw, ptr.raw, name);
        if (inst == null) { return LValue::null(); }
        llvm::LLVMSetOrdering(inst, order);
        llvm::LLVMSetAlignment(inst, align_bytes);
        return LValue { raw: inst };
    }

    /// Emits `store atomic Val, Ptr ordering, align Bytes`.
    build_atomic_store(&this, val: LValue, ptr: LValue, order: i32, align_bytes: u32) -> LValue {
        if (val.raw == null || ptr.raw == null) { return LValue::null(); }
        const inst: void* = llvm::LLVMBuildStore(this.raw, val.raw, ptr.raw);
        if (inst == null) { return LValue::null(); }
        llvm::LLVMSetOrdering(inst, order);
        llvm::LLVMSetAlignment(inst, align_bytes);
        return LValue { raw: inst };
    }

    /// Emits `atomicrmw Op Ptr, Val ordering`.  `op` is an
    /// LLVMAtomicRMWBinOp value (Xchg=0 / Add=1 / Sub=2 / And=3 / Nand=4 /
    /// Or=5 / Xor=6 / Max=7 / Min=8 / UMax=9 / UMin=10).  Returns the
    /// pre-modification value of `*Ptr`.
    build_atomic_rmw(&this, op: i32, ptr: LValue, val: LValue, order: i32) -> LValue {
        if (ptr.raw == null || val.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildAtomicRMW(this.raw, op, ptr.raw, val.raw, order, 0) };
    }

    /// Emits `cmpxchg Ptr, Cmp, New SuccessOrdering FailureOrdering`.
    /// Returns the LLVM `{T, i1}` aggregate; caller uses
    /// `build_extract_value` to pull index 0 (loaded value) and index 1
    /// (success flag).  Higher-level wrappers in
    /// `Ops::IntrinsicEmitter::try_emit` reshape the aggregate into a
    /// Cryo `Pair<T, boolean>`.
    build_atomic_cmpxchg(&this, ptr: LValue, cmp: LValue, new_val: LValue,
                         succ_order: i32, fail_order: i32) -> LValue {
        if (ptr.raw == null || cmp.raw == null || new_val.raw == null) {
            return LValue::null();
        }
        return LValue {
            raw: llvm::LLVMBuildAtomicCmpXchg(
                this.raw, ptr.raw, cmp.raw, new_val.raw,
                succ_order, fail_order, 0
            )
        };
    }

    // ----- Casts -----

    build_trunc(&this, val: LValue, dest_ty: LType, name: string) -> LValue {
        if (val.raw == null || dest_ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildTrunc(this.raw, val.raw, dest_ty.raw, name) };
    }

    build_zext(&this, val: LValue, dest_ty: LType, name: string) -> LValue {
        if (val.raw == null || dest_ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildZExt(this.raw, val.raw, dest_ty.raw, name) };
    }

    build_sext(&this, val: LValue, dest_ty: LType, name: string) -> LValue {
        if (val.raw == null || dest_ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildSExt(this.raw, val.raw, dest_ty.raw, name) };
    }

    build_fp_to_ui(&this, val: LValue, dest_ty: LType, name: string) -> LValue {
        if (val.raw == null || dest_ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildFPToUI(this.raw, val.raw, dest_ty.raw, name) };
    }

    build_fp_to_si(&this, val: LValue, dest_ty: LType, name: string) -> LValue {
        if (val.raw == null || dest_ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildFPToSI(this.raw, val.raw, dest_ty.raw, name) };
    }

    build_ui_to_fp(&this, val: LValue, dest_ty: LType, name: string) -> LValue {
        if (val.raw == null || dest_ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildUIToFP(this.raw, val.raw, dest_ty.raw, name) };
    }

    build_si_to_fp(&this, val: LValue, dest_ty: LType, name: string) -> LValue {
        if (val.raw == null || dest_ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildSIToFP(this.raw, val.raw, dest_ty.raw, name) };
    }

    build_fp_trunc(&this, val: LValue, dest_ty: LType, name: string) -> LValue {
        if (val.raw == null || dest_ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildFPTrunc(this.raw, val.raw, dest_ty.raw, name) };
    }

    build_fp_ext(&this, val: LValue, dest_ty: LType, name: string) -> LValue {
        if (val.raw == null || dest_ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildFPExt(this.raw, val.raw, dest_ty.raw, name) };
    }

    build_ptr_to_int(&this, val: LValue, dest_ty: LType, name: string) -> LValue {
        if (val.raw == null || dest_ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildPtrToInt(this.raw, val.raw, dest_ty.raw, name) };
    }

    build_int_to_ptr(&this, val: LValue, dest_ty: LType, name: string) -> LValue {
        if (val.raw == null || dest_ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildIntToPtr(this.raw, val.raw, dest_ty.raw, name) };
    }

    build_bitcast(&this, val: LValue, dest_ty: LType, name: string) -> LValue {
        if (val.raw == null || dest_ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildBitCast(this.raw, val.raw, dest_ty.raw, name) };
    }

    build_pointer_cast(&this, val: LValue, dest_ty: LType, name: string) -> LValue {
        if (val.raw == null || dest_ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildPointerCast(this.raw, val.raw, dest_ty.raw, name) };
    }

    // ----- Misc -----

    build_phi(&this, ty: LType, name: string) -> LValue {
        if (ty.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildPhi(this.raw, ty.raw, name) };
    }

    build_call(&this, fn_ty: LType, fn_val: LValue, args: void*, num_args: u32, name: string) -> LValue {
        if (fn_ty.raw == null || fn_val.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildCall2(this.raw, fn_ty.raw, fn_val.raw, args, num_args, name) };
    }

    build_select(&this, cond: LValue, then_val: LValue, else_val: LValue, name: string) -> LValue {
        if (cond.raw == null || then_val.raw == null || else_val.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildSelect(this.raw, cond.raw, then_val.raw, else_val.raw, name) };
    }

    build_extract_value(&this, agg: LValue, index: u32, name: string) -> LValue {
        if (agg.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildExtractValue(this.raw, agg.raw, index, name) };
    }

    build_insert_value(&this, agg: LValue, elt: LValue, index: u32, name: string) -> LValue {
        if (agg.raw == null || elt.raw == null) { return LValue::null(); }
        return LValue { raw: llvm::LLVMBuildInsertValue(this.raw, agg.raw, elt.raw, index, name) };
    }
}


// LValue: Wrapper around LLVMValueRef

type struct LValue {
    raw: void*;

    static null() -> LValue {
        return LValue { raw: null };
    }

    is_valid(&this) -> boolean {
        return this.raw != null;
    }

    /// Build an inline-assembly callee value for `asm { ... }` blocks.
    /// The result is passed as the `Fn` operand of `build_call` (it is not
    /// a real `LLVMFunction`).  `dialect` is 0 = ATT, 1 = Intel.
    static inline_asm(fn_ty: LType, asm_text: string, constraints: string,
                      side_effects: boolean, align_stack: boolean,
                      dialect: i32, can_throw: boolean) -> LValue {
        return LValue { raw: llvm::LLVMGetInlineAsm(
            fn_ty.raw,
            asm_text, asm_text.length(),
            constraints, constraints.length(),
            side_effects as i32, align_stack as i32,
            dialect as u32, can_throw as i32) };
    }

    set_linkage(&this, linkage: LLinkage) -> void {
        llvm::LLVMSetLinkage(this.raw, linkage as i32);
    }

    set_initializer(&this, val: LValue) -> void {
        llvm::LLVMSetInitializer(this.raw, val.raw);
    }

    set_global_constant(&this, is_const: boolean) -> void {
        llvm::LLVMSetGlobalConstant(this.raw, is_const as i32);
    }

    get_param(index: u32) -> LValue {
        return LValue { raw: llvm::LLVMGetParam(this.raw, index) };
    }

    type_of(&this) -> LType {
        return LType { raw: llvm::LLVMTypeOf(this.raw) };
    }

    dump(&this) -> void {
        llvm::LLVMDumpValue(this.raw);
    }

    /// Add incoming values to this phi node.  `values` and `blocks` are
    /// parallel arrays of LLVMValueRef and LLVMBasicBlockRef raw pointers.
    add_incoming(&this, values: void*, blocks: void*, count: u32) -> void {
        llvm::LLVMAddIncoming(this.raw, values, blocks, count);
    }

    /// Add a case to this switch instruction.
    add_case(&this, on_val: LValue, dest: LBasicBlock) -> void {
        llvm::LLVMAddCase(this.raw, on_val.raw, dest.raw);
    }
}


// LType: Wrapper around LLVMTypeRef

type struct LType {
    raw: void*;

    static null() -> LType {
        return LType { raw: null };
    }

    is_valid(&this) -> boolean {
        return this.raw != null;
    }

    /// Typed wrapper around `LLVMGetTypeKind`: returns `LTypeKind`
    /// instead of a raw `i32` so callers compare against named variants
    /// (`ty.kind() == LTypeKind::Void`) rather than re-casting integers.
    kind(&this) -> LTypeKind {
        return llvm::LLVMGetTypeKind(this.raw) as LTypeKind;
    }

    // ----- Primitive type constructors -----

    // All primitive types are interned per-LLVMContext.  Routing them through
    // `LContext::current()` (rather than the implicit-global `LLVM<T>Type()`)
    // is what keeps every codegen type in the per-target context, so a single
    // `LLVMContextDispose` at the target boundary reclaims them.  Mixing a
    // global-context primitive into a per-target-context module would trip an
    // LLVM context-mismatch assertion, so these must stay consistent with the
    // module/builder/struct factories.
    static void_type() -> LType {
        return LType { raw: llvm::LLVMVoidTypeInContext(LContext::current().raw) };
    }

    static i1() -> LType {
        return LType { raw: llvm::LLVMInt1TypeInContext(LContext::current().raw) };
    }

    static i8() -> LType {
        return LType { raw: llvm::LLVMInt8TypeInContext(LContext::current().raw) };
    }

    static i16() -> LType {
        return LType { raw: llvm::LLVMInt16TypeInContext(LContext::current().raw) };
    }

    static i32() -> LType {
        return LType { raw: llvm::LLVMInt32TypeInContext(LContext::current().raw) };
    }

    static i64() -> LType {
        return LType { raw: llvm::LLVMInt64TypeInContext(LContext::current().raw) };
    }

    static i128() -> LType {
        return LType { raw: llvm::LLVMInt128TypeInContext(LContext::current().raw) };
    }

    static int_type(bits: u32) -> LType {
        return LType { raw: llvm::LLVMIntTypeInContext(LContext::current().raw, bits) };
    }

    static f32() -> LType {
        return LType { raw: llvm::LLVMFloatTypeInContext(LContext::current().raw) };
    }

    static f64() -> LType {
        return LType { raw: llvm::LLVMDoubleTypeInContext(LContext::current().raw) };
    }

    // ----- Compound type constructors -----

    static pointer_to(element: LType) -> LType {
        return LType { raw: llvm::LLVMPointerType(element.raw, 0) };
    }

    static array_of(element: LType, count: u32) -> LType {
        return LType { raw: llvm::LLVMArrayType(element.raw, count) };
    }

    /// Build an LLVM fixed-width vector type `<count x element>`.  Used
    /// by the ABI classifier to lower a SysV SSE eightbyte that holds
    /// two `f32` fields into a single `<2 x float>` register slot.
    static vector_of(element: LType, count: u32) -> LType {
        return LType { raw: llvm::LLVMVectorType(element.raw, count) };
    }

    static function_type(ret: LType, params: void*, param_count: u32, is_var_arg: boolean) -> LType {
        return LType { raw: llvm::LLVMFunctionType(ret.raw, params, param_count, is_var_arg as i32) };
    }

    static named_struct(ctx: LContext, name: string) -> LType {
        return LType { raw: llvm::LLVMStructCreateNamed(ctx.raw, name) };
    }

    /// Look up an existing identified struct by name in `ctx`, or an
    /// invalid `LType` if none exists yet. Lets the type mapper reuse a
    /// single LLVM struct per mangled name instead of minting a fresh
    /// `Name.0` when the same Cryo struct arrives under a new type id.
    static struct_by_name(ctx: LContext, name: string) -> LType {
        return LType { raw: llvm::LLVMGetTypeByName2(ctx.raw, name) };
    }

    static literal_struct(elements: void*, count: u32, packed: boolean) -> LType {
        return LType { raw: llvm::LLVMStructTypeInContext(
            LContext::current().raw, elements, count, packed as i32) };
    }

    // ----- Struct body -----

    set_struct_body(&this, elements: void*, count: u32, packed: boolean) -> void {
        llvm::LLVMStructSetBody(this.raw, elements, count, packed as i32);
    }

    is_opaque_struct(&this) -> boolean {
        return llvm::LLVMIsOpaqueStruct(this.raw) != 0;
    }

    // ----- Constant constructors -----

    static const_int(ty: LType, val: u64, sign_extend: boolean) -> LValue {
        return LValue { raw: llvm::LLVMConstInt(ty.raw, val, sign_extend as i32) };
    }

    /// Build an integer constant from its textual digits in `radix`. Used for
    /// i128/u128 literals whose value exceeds 64 bits (the u64-based
    /// `const_int` would truncate). `digits` must be the bare digits with no
    /// sign or `0x`/`0b`/`0o` prefix and no `_` separators.
    static const_int_of_string(ty: LType, digits: string, radix: u8) -> LValue {
        return LValue { raw: llvm::LLVMConstIntOfString(ty.raw, digits, radix) };
    }

    static const_real(ty: LType, val: f64) -> LValue {
        return LValue { raw: llvm::LLVMConstReal(ty.raw, val) };
    }

    static const_null(ty: LType) -> LValue {
        return LValue { raw: llvm::LLVMConstNull(ty.raw) };
    }

    static const_pointer_null(ty: LType) -> LValue {
        return LValue { raw: llvm::LLVMConstPointerNull(ty.raw) };
    }

    static const_undef(ty: LType) -> LValue {
        return LValue { raw: llvm::LLVMGetUndef(ty.raw) };
    }

    static const_struct(values: void*, count: u32, packed: boolean) -> LValue {
        // MUST build in the current per-module context, not the implicit global
        // one: the context-less `LLVMConstStruct` interns the anonymous struct
        // constant in the GLOBAL LLVMContext, so the same constant would be
        // shared across every module's supposedly-isolated context.  Emitting
        // two such modules concurrently then races that shared constant's
        // use-list (heap corruption inside LLVM).  `InContext` keeps every
        // constant private to its module — the invariant parallel emit needs.
        return LValue { raw: llvm::LLVMConstStructInContext(
            LContext::current().raw, values, count, packed as i32) };
    }

    static const_named_struct(ty: LType, values: void*, count: u32) -> LValue {
        return LValue { raw: llvm::LLVMConstNamedStruct(ty.raw, values, count) };
    }

    static const_array(element_ty: LType, values: void*, count: u32) -> LValue {
        return LValue { raw: llvm::LLVMConstArray(element_ty.raw, values, count) };
    }

    /// Typed wrapper around `LLVMGetTypeKind` for raw `LLVMTypeRef` handles
    /// (where wrapping in an `LType` first would just be ceremony).  Mirrors
    /// `LType::kind()` and lets callers branch on `LTypeKind::Void` etc.
    static kind_of(raw: void*) -> LTypeKind {
        return llvm::LLVMGetTypeKind(raw) as LTypeKind;
    }
}


// LBasicBlock: Wrapper around LLVMBasicBlockRef

type struct LBasicBlock {
    raw: void*;

    static null() -> LBasicBlock {
        return LBasicBlock { raw: null };
    }

    is_valid(&this) -> boolean {
        return this.raw != null;
    }

    static append(fn: LValue, name: string) -> LBasicBlock {
        // MUST append in the current per-module context.  The context-less
        // `LLVMAppendBasicBlock` is `LLVMAppendBasicBlockInContext(
        // LLVMGetGlobalContext(), ...)` under the hood, which mints the block —
        // and its `label` type plus the `void` terminators built into it — in
        // the process-global context, shared across every module's private
        // context.  Two such modules emitting concurrently then race that shared
        // type's use-list (heap corruption inside LLVM).  `InContext` keeps every
        // block private to its module — the last leak that blocked zero-copy
        // threaded emit.
        return LBasicBlock { raw: llvm::LLVMAppendBasicBlockInContext(
            LContext::current().raw, fn.raw, name) };
    }

    get_terminator(&this) -> LValue {
        return LValue { raw: llvm::LLVMGetBasicBlockTerminator(this.raw) };
    }

    has_terminator(&this) -> boolean {
        return llvm::LLVMGetBasicBlockTerminator(this.raw) != null;
    }

    get_parent(&this) -> LValue {
        return LValue { raw: llvm::LLVMGetBasicBlockParent(this.raw) };
    }
}


// LTargetMachine: Wrapper around LLVMTargetMachineRef

type struct LTargetMachine {
    raw: void*;

    static null() -> LTargetMachine {
        return LTargetMachine { raw: null };
    }

    is_valid(&this) -> boolean {
        return this.raw != null;
    }

    dispose(mut &this) -> void {
        if (this.raw != null) {
            llvm::LLVMDisposeTargetMachine(this.raw);
            this.raw = null;
        }
    }

    get_data_layout_string(&this) -> string {
        const td: void* = llvm::LLVMCreateTargetDataLayout(this.raw);
        const str: string = llvm::LLVMCopyStringRepOfTargetData(td) as string;
        llvm::LLVMDisposeTargetData(td);
        return str;
    }

    emit_to_file(&this, module: LModule, filename: string, file_type: LFileType) -> boolean {
        mut err_msg: i8* = null;
        const result: i32 = llvm::LLVMTargetMachineEmitToFile(
            this.raw, module.raw, filename, file_type as i32, &err_msg as void*);
        if (err_msg != null) {
            fmt::println(f"[Codegen] Emit error: {err_msg as string}");
            llvm::LLVMDisposeMessage(err_msg as void*);
        }
        return result == 0;
    }

    /// Initialize the native target for code generation.  Must be called
    /// once before any target-dependent operations.
    static init_native_target() -> void {
        llvm::LLVMInitializeX86TargetInfo();
        llvm::LLVMInitializeX86Target();
        llvm::LLVMInitializeX86TargetMC();
        llvm::LLVMInitializeX86AsmPrinter();
        llvm::LLVMInitializeX86AsmParser();
    }

    /// Create a target machine for an explicit LLVM target triple.  Used by
    /// codegen when the project specifies `target = "..."` in cryoconfig or
    /// the user passed `--target=TRIPLE`.  Falls back to the host triple when
    /// `triple` is the empty string.
    static create_target_machine_for_triple(triple: string) -> LTargetMachine {
        return LTargetMachine::create_target_machine_with_opt(
            triple, LCodeGenOptLevel::LevelDefault as i32);
    }

    /// Like `create_target_machine_for_triple`, but with an explicit backend
    /// codegen optimization level (0=None .. 3=Aggressive; `LCodeGenOptLevel`
    /// values line up with these). Codegen passes pass `ctx.opt_level` so an
    /// O0/debuggable build gets less aggressive instruction selection and
    /// register allocation than an optimized one. Out-of-range levels clamp
    /// into [0, 3].
    static create_target_machine_with_opt(triple: string, opt_level: i32) -> LTargetMachine {
        mut level: i32 = opt_level;
        if (level < 0) { level = 0; }
        if (level > 3) { level = 3; }

        mut effective: string = triple;
        if (triple == "" || triple.length() == 0) {
            // Go through `get_default_triple`, not the raw LLVM API, so the
            // Windows msvc→gnu coercion applies here too (otherwise a caller
            // passing "" on Windows would get the raw `windows-msvc` triple
            // and emit MSVC-style code the mingw linker can't resolve).
            effective = LTargetMachine::get_default_triple();
        }
        mut target: void* = null;
        mut err_msg: i8* = null;

        // Register the backend here rather than trusting the caller.  LLVM's
        // target registry is per-process and starts EMPTY, and this is the one
        // chokepoint every target machine is created through — so a caller that
        // reaches codegen's `init_native_target` first is merely the common
        // case, not a guarantee.  It is NOT one: an incremental build whose
        // modules are all cached codegens nothing (that is where
        // `init_native_target` used to run) yet still proceeds to link and, in
        // test mode, to test-main synthesis, which lands here.  The registry is
        // then empty and `LLVMGetTargetFromTriple` fails with "no targets are
        // registered", surfacing as E0900 "native target machine unavailable"
        // on a build whose sources never changed.  The LLVM initializers are
        // idempotent (each guards on a `static once_flag`), so calling them on
        // every target-machine creation is free.
        LTargetMachine::init_native_target();

        const found: i32 = llvm::LLVMGetTargetFromTriple(effective, &target as void*, &err_msg as void*);
        if (found != 0) {
            if (err_msg != null) {
                fmt::println(f"[Codegen] Target lookup failed for triple '{effective}': {err_msg as string}");
                llvm::LLVMDisposeMessage(err_msg as void*);
            }
            return LTargetMachine::null();
        }

        const tm: void* = llvm::LLVMCreateTargetMachine(
            target, effective, "generic", "",
            level,
            LRelocMode::PIC as i32,
            LCodeModel::Default as i32);

        return LTargetMachine { raw: tm };
    }

    static pick_windows_default_triple(raw: string) -> string {
        // Never return null: the result is cached and re-measured via strlen.
        if (raw == null) { return "x86_64-pc-windows-gnu"; }
        if (!raw.contains("windows-msvc")) { return raw; }
        // Prefer mingw (the only link path the port supports) when present.
        if (LTargetMachine::exe_on_path("x86_64-w64-mingw32-gcc.exe")) {
            return "x86_64-pc-windows-gnu";
        }
        // Otherwise honour an installed MSVC linker so codegen emits MSVC-ABI
        // objects (the user links them with their own toolchain).
        if (LTargetMachine::exe_on_path("lld-link.exe") || LTargetMachine::exe_on_path("link.exe")) {
            return raw;
        }
        return "x86_64-pc-windows-gnu";
    }

    static exe_on_path(exe: string) -> boolean {
        match (env::var(Str::new("PATH"))) {
            Option::Some(v) => {
                // Move the owned value into a local so it drops cleanly on every
                // exit (including the early `return true`); a borrowed cstr view
                // drives the scan. No leak — unlike a boundary `into_raw`.
                mut s: String = v;
                const path: string = s.as_cstr() as string;
                const len: i64 = path.length() as i64;
                mut start: i64 = 0;
                for (mut i: i64 = 0; i <= len; i++) {
                    if (i == len || path[i] == 59) {            // 59 = ';'
                        const dlen: i64 = i - start;
                        if (dlen > 0) {
                            const dir: string = path.substr(start, dlen);
                            mut candidate: string = dir;
                            if (dir[dlen - 1] != 92) {           // 92 = '\'
                                candidate += "\\";
                            }
                            candidate += exe;
                            if (metadata::exists(Path::from_cstr(candidate))) { return true; }
                        }
                        start = i + 1;
                    }
                }
                return false;
            }
            Option::None => { return false; }
        }
    }

    /// Resolve the effective triple for codegen: returns `requested` when it
    /// is non-empty, otherwise the host triple.  Centralizes the precedence
    /// rule so both IR generation and the linker decision read the same
    /// answer.
    static resolve_effective_triple(requested: string) -> string {
        if (requested == "" || requested.length() == 0) {
            return LTargetMachine::get_default_triple();
        }
        return requested;
    }

    /// Get the default target triple string for the host build.
    ///
    /// On Linux/macOS this is whatever `LLVMGetDefaultTargetTriple` reports
    /// (the triple the linked libLLVM was built for).
    ///
    /// On Windows the answer depends on which toolchain is installed.  The
    /// Windows `LLVM-C.dll` the compiler links against is from the official
    /// `clang+llvm-*-x86_64-pc-windows-msvc` release (see
    /// `scripts/fetch-windows-llvm.sh`), so `LLVMGetDefaultTargetTriple`
    /// reports `x86_64-pc-windows-msvc`.  But code emitted for the MSVC ABI
    /// cannot be linked by mingw — the most visible mismatch is the stack-probe
    /// symbol: MSVC emits `__chkstk` while mingw provides `___chkstk_ms`, so a
    /// mingw `cryo build` of MSVC-ABI code fails with `undefined reference to
    /// __chkstk`.  So when LLVM reports msvc we pick the ABI from the linker
    /// that is actually on `PATH`, rather than assuming one:
    ///   - an mingw `gcc` present → `x86_64-pc-windows-gnu` (the only link path
    ///     the port supports today; preferred when both are installed);
    ///   - else an MSVC linker (`lld-link`/`link.exe`) present → keep the
    ///     `windows-msvc` triple, so codegen emits MSVC-ABI objects for the
    ///     user's own toolchain to link;
    ///   - else → `x86_64-pc-windows-gnu` (mingw is the default we ship for).
    /// The probe runs once per process and is cached.  An explicit `--target=`
    /// bypasses all of this (see `resolve_effective_triple`).
    ![target(unix)]
    static get_default_triple() -> string {
        return llvm::LLVMGetDefaultTargetTriple() as string;
    }

    ![target(windows)]
    static get_default_triple() -> string {
        if (g_win_default_triple.length() > 0) {
            return g_win_default_triple;
        }
        const raw: string = llvm::LLVMGetDefaultTargetTriple() as string;
        g_win_default_triple = LTargetMachine::pick_windows_default_triple(raw);
        return g_win_default_triple;
    }
}


// Phi Node Helper


// LLVM Initialization


/// Cached result of the windows default-triple toolchain probe ("" until
/// computed).  Only the windows `get_default_triple` reads or writes it.
mut g_win_default_triple: string = "";
