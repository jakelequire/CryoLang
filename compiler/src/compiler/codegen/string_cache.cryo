/// String Cache
///
/// Deduplicating cache for module-global string literals.  Identical
/// `string`s share one LLVM global, named `.str.N` in append order.
///
/// Leaf component: owns its array.  Takes the `LBuilder` by parameter on
/// the create path — caching does not need a builder, only first-emission
/// does, so the builder lives on the caller side.

namespace Compiler::Codegen::StringCache;

import Compiler::Codegen::LLVMTypes;
import std::collections::pair;


// ============================================================================
// StringCache
// ============================================================================

type struct StringCache {
    entries: Pair<string, void*>[];   // (text, LLVMValueRef)

    static new() -> StringCache {
        return StringCache { entries: [] };
    }

    get_or_create(mut &this, text: string, builder: LBuilder) -> LValue {
        for (mut i: i64 = 0; i < this.entries.length; i++) {
            if (this.entries[i].first == text) {
                return LValue { raw: this.entries[i].second };
            }
        }

        const name: string = format(".str.%d", this.entries.length);
        const val: LValue = builder.build_global_string_ptr(text, name);

        this.entries.push(Pair::new(text, val.raw));

        return val;
    }
}
