/// Codegen utilities
///
/// Pure helpers used by the codegen pass.  No CodegenContext dependency,
/// no LLVM-builder dependency - just data shaping that doesn't naturally
/// live inside `CodegenContext`'s class body.  Grouped as statics on
/// `CodegenUtil` so the codegen emitters call them as `CodegenUtil::fn(...)`.

namespace compiler::codegen::util;

import compiler::ast;
import compiler::ast::{ MemberPin, node, declaration };
import compiler::types::user_defined::{ EnumType, EnumVariantInfo };
import compiler::types;
import compiler::types::{ type_ref, type_base };
import compiler::resolver::{ symbol_str };
import std::ffi::libc;
import compiler::ast::declaration::{ FunctionDeclNode, IntrinsicDeclNode, VarDeclNode };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::types::type_ref::{ TypeRef };
import utils::text::{ Text };
import compiler::lex::lexer;
import compiler::lex::lexer::{ Lexer };


// VTable slot identity

/// Identity of a single vtable slot: the (method_name, param_types)
/// pair.  Two methods occupy the same slot if the name matches AND
/// every parameter TypeRef matches by arena ID.  Keeps overloaded
/// virtuals in distinct slots while letting overrides collapse back
/// onto the base virtual's slot.
type struct VTableSlot {
    name:        SymbolStr;
    param_types: TypeRef[];
}


type struct CodegenUtil {
    /// The variant a node's pin names inside `et`: `Variant(ordinal)` read
    /// off the enum's own list.  Null for a pin that is not a variant's, or
    /// an ordinal past the list - a node no sema walk answered, which the
    /// caller reports rather than answers by the spelling.
    static pinned_variant(et: EnumType*, pin: MemberPin) -> EnumVariantInfo* {
        match (pin) {
            MemberPin::Variant(i) => {
                if (i >= 0 && i < et.variants.length) { return &et.variants[i]; }
                return null;
            }
            _ => { return null; }
        }
    }

    // Literal lexeme parsing
    //
    // Integer-literal parsing (hex/oct/bin/dec prefixes, sign, `_` separators)
    // lives in the stdlib as the generic `string::parse_int<T>`; codegen calls
    // `lexeme.parse_int<u64>()` directly.

    /// Strip the sign, base prefix (`0x`/`0b`/`0o`), `_` separators, and any type
    /// suffix from an integer-literal lexeme, returning the bare digit string and
    /// writing the detected radix to `*out_radix`. Used to build i128/u128
    /// constants via `LLVMConstIntOfString`, which takes digits + radix rather
    /// than a 64-bit value (so it doesn't truncate literals above `u64::MAX`).
    static int_literal_clean(s_text: Text, out_radix: u8*) -> string {
        const s: string = s_text.as_string();
        *out_radix = 10;
        if (s == null) { return "0"; }
        const len: i64 = s.length() as i64;
        mut i: i64 = 0;
        // A leading sign belongs to the unary operator, not the literal, but
        // tolerate it defensively.
        if (len > 0 && (*(s + 0) as char == '-' || *(s + 0) as char == '+')) { i = 1; }

        mut base: u8 = 10;
        if (i + 1 < len && (*(s + i) as char) == '0') {
            const p: char = *(s + i + 1) as char;
            if (p == 'x' || p == 'X')      { base = 16; i += 2; }
            else if (p == 'b' || p == 'B') { base = 2;  i += 2; }
            else if (p == 'o' || p == 'O') { base = 8;  i += 2; }
        }

        mut buf: string = libc::malloc(len + 1) as string;
        mut w: i64 = 0;
        while (i < len) {
            const c: char = *(s + i) as char;
            if (c == '_') { i += 1; continue; }
            mut digit: i64 = -1;
            if (c >= '0' && c <= '9')      { digit = (c - '0') as i64; }
            else if (c >= 'a' && c <= 'f') { digit = (c - 'a' + 10) as i64; }
            else if (c >= 'A' && c <= 'F') { digit = (c - 'A' + 10) as i64; }
            else { break; }   // the start of the type suffix (i128/u128) or junk
            if (digit >= base as i64) { break; }
            *(buf + w) = c;
            w += 1;
            i += 1;
        }
        *(buf + w) = '\0';
        *out_radix = base;
        if (w == 0) { return "0"; }
        return buf;
    }

    /// Strip `_` digit separators from a float-literal lexeme, returning a bare
    /// numeric string suitable for `sscanf("%lf", ...)`. The lexer accepts `_`
    /// in the integer part, fraction, and exponent of a float literal (e.g.
    /// `1_000.5`, `1_0e1_0`), but `sscanf` stops at the first `_`, so without
    /// this every digit-separated float silently parses to a truncated value
    /// (`1_000.5` -> `1.0`). Integers strip via `int_literal_clean`; floats need
    /// their own pass since they keep `.`/`e`/`+`/`-` that the integer cleaner
    /// would reject.
    static float_literal_clean(s_text: Text) -> string {
        const s: string = s_text.as_string();
        if (s == null) { return "0"; }
        const len: i64 = s.length() as i64;
        mut buf: string = libc::malloc(len + 1) as string;
        mut w: i64 = 0;
        mut i: i64 = 0;
        while (i < len) {
            const c: char = *(s + i) as char;
            if (c == '_') { i += 1; continue; }
            *(buf + w) = c;
            w += 1;
            i += 1;
        }
        *(buf + w) = '\0';
        if (w == 0) { return "0"; }
        return buf;
    }

    // Function/method parameter shape

    /// Number of parameters to emit as fixed-arity in an LLVM function type.
    /// For variadic Cryo functions (`args...`), the trailing name-only parameter
    /// stands in for the vararg bucket; sema needs it to be a local in scope,
    /// but LLVM must not see it as a fixed param (there's no callable type for
    /// it, and every call site passes a different arity for that slot).
    static fixed_param_count(func: FunctionDeclNode*) -> u32 {
        mut count: u32 = func.parameters.length as u32;
        if (func.is_variadic && count > 0) {
            const last: VarDeclNode* = func.parameters[count - 1];
            if (last.type_annotation == null) {
                count -= 1;
            }
        }
        return count;
    }

    /// Same shape as `fixed_param_count` but typed for `IntrinsicDeclNode*`.
    /// IntrinsicDeclNode and FunctionDeclNode both inherit from DeclarationNode
    /// but have different field layouts, so reusing the FunctionDeclNode-typed
    /// helper reads `is_variadic` past the end of an IntrinsicDeclNode's
    /// allocation and segfaults when the read crosses an unmapped page.
    static fixed_param_count_intrinsic(node: IntrinsicDeclNode*) -> u32 {
        mut count: u32 = node.parameters.length as u32;
        if (node.is_variadic && count > 0) {
            const last: VarDeclNode* = node.parameters[count - 1];
            if (last.type_annotation == null) {
                count -= 1;
            }
        }
        return count;
    }

    /// Return the trailing `args...` parameter when `func` is variadic and
    /// its last parameter is the vararg bucket (no type annotation, so sema
    /// couldn't give it a concrete type).  Null when the function has no
    /// such parameter.
    static variadic_param(func: FunctionDeclNode*) -> VarDeclNode* {
        if (!func.is_variadic) { return null as VarDeclNode*; }
        const n: i64 = func.parameters.length;
        if (n == 0) { return null as VarDeclNode*; }
        const last: VarDeclNode* = func.parameters[n - 1];
        if (last == null || last.type_annotation != null) {
            return null as VarDeclNode*;
        }
        return last;
    }


    // VTable slot identity

    /// Equality on two param-type lists: same arity, and element-wise equal
    /// arena ids.
    ///
    /// A plain id compare is sufficient because type ids are canonical - the
    /// arena's structural interner guarantees one id per semantic type, so two
    /// `TypeRef`s denoting the same shape ARE the same id no matter which
    /// resolution context minted them.  Vtable slot matching depends on that:
    /// an override's parameter `Foo*` and the virtual base's `Foo*` must
    /// compare equal even when one was registered while `Foo` was still a
    /// forward declaration.
    static param_types_equal(a: &TypeRef[], b: &TypeRef[]) -> boolean {
        if (a.length != b.length) { return false; }
        for (mut i: i64 = 0; i < a.length; i++) {
            if (!a[i].equals(b[i])) { return false; }
        }
        return true;
    }
}
