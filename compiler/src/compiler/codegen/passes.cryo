/// Codegen Passes
///
/// Entry points for the four codegen passes: IRGeneration, Optimization,
/// ObjectEmission, and Linking.  Called by PassRegistry::run_pass().

namespace Compiler::Codegen::Passes;

import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Codegen::TypeMap;
import Compiler::Codegen::Context;
import Compiler::Codegen::Ops::IntrinsicsCodegen;
import Compiler::Codegen::Visit::IRGenerator;
import Compiler::CompilationContext;
import Compiler::ProjectConfig;
import Compiler::Artifacts;
import Compiler::Diag;
import Compiler::Diag::Diagnostic;
import Compiler::Diag::Sink;
import Compiler::Diag::Snapshot;
import Compiler::AST::Node;
import Compiler::Passes::PassID;
import Compiler::Resolver::InternTable;
import Compiler::Resolver::SymbolStr;
import Utils::Logger;


// Shell-quoting helper

/// POSIX-shell-safe quote a path or argument for use in `system()` /
/// `sh -c` commands.  Wraps the input in single quotes and rewrites any
/// embedded single quote as the four-byte sequence `'\''`; single-quoted
/// strings are not interpreted by `/bin/sh` at all, so this neutralises
/// every shell metacharacter (spaces, $, `, *, ;, !, &, etc).
///
/// libc's `system(3)` runs the command through `sh -c`, so any
/// interpolated user-controlled path needs this treatment.  Without it,
/// a working directory with a space breaks linking, and a path containing
/// shell metacharacters is an arbitrary-command-execution hazard.
function shell_quote(s: string) -> string {
    const len: u64 = intrinsics::strlen(s);
    // Worst case: every byte is a single quote, expanding to 4 bytes,
    // plus two outer quotes and a NUL terminator.
    const cap: u64 = len * 4 + 3;
    const buf: i8* = intrinsics::malloc(cap) as i8*;
    mut o: u64 = 0;
    buf[o] = '\''; o += 1;
    const sb: i8* = s as i8*;
    for (mut i: u64 = 0; i < len; i++) {
        const ch: i8 = sb[i];
        if (ch == '\'') {
            buf[o] = '\''; o += 1;
            buf[o] = '\\'; o += 1;
            buf[o] = '\''; o += 1;
            buf[o] = '\''; o += 1;
        } else {
            buf[o] = ch; o += 1;
        }
    }
    buf[o] = '\''; o += 1;
    buf[o] = 0;
    return buf as string;
}


// Cascade-strip helper

/// Returns true if `name` is in the stripped-functions set.
function is_stripped(cg: CodegenContext*, name: string) -> boolean {
    if (name == null) { return false; }
    return cg.diag.is_stripped(name);
}

/// Walk a function's basic blocks and instructions; if any call instruction
/// targets a function whose mangled name is in the stripped-functions set,
/// return true.  Used by the cascade-strip pass to identify callers of
/// stripped same-module siblings (e.g. `Array<T>::quicksort` calling a
/// stripped `Array<T>::partition`).
function function_calls_stripped(cg: CodegenContext*, fn_val: void*) -> boolean {
    if (fn_val == null) { return false; }
    mut bb: void* = llvm::LLVMGetFirstBasicBlock(fn_val);
    while (bb != null) {
        mut inst: void* = llvm::LLVMGetFirstInstruction(bb);
        while (inst != null) {
            // LLVMOpcode::Call = 45 in the LLVM-C enum (verify via
            // `<llvm-c/Core.h>`, same value across LLVM 14-20).  CallBr
            // (asm goto) is 67 but doesn't appear in cryoc-generated IR.
            const op: i32 = llvm::LLVMGetInstructionOpcode(inst);
            if (op == 45) {
                // Last operand of a call instruction is the called value.
                const n: i32 = llvm::LLVMGetNumOperands(inst);
                if (n > 0) {
                    const callee: void* = llvm::LLVMGetOperand(inst, (n - 1) as u32);
                    if (callee != null) {
                        const callee_name: string = llvm::LLVMGetValueName(callee) as string;
                        if (callee_name != null && is_stripped(cg, callee_name)) {
                            return true;
                        }
                    }
                }
            }
            inst = llvm::LLVMGetNextInstruction(inst);
        }
        bb = llvm::LLVMGetNextBasicBlock(bb);
    }
    return false;
}

/// Iterate the module's functions until no more cascade-strips happen.
/// For each function with a body that calls a stripped sibling, strip it
/// (which adds it to the stripped set, potentially triggering more
/// strips on its own callers in the next iteration).
///
/// Emits a warning per cascade strip so the user can see the chain of
/// downstream casualties from the original codegen failure.  We use a
/// warning rather than an error here because the *primary* failure is
/// already reported by `report_invalid_function_body`; cascade entries
/// are downstream noise that exists only to avoid the worse alternative
/// of a half-built body that fails LLVM verification.
function cascade_strip_dependents(cg: CodegenContext*) -> void {
    mut iterations: i32 = 0;
    while (iterations < 16) {
        mut newly_stripped: i32 = 0;
        mut fn_val: void* = llvm::LLVMGetFirstFunction(cg.llvm_module.raw);
        while (fn_val != null) {
            const next_fn: void* = llvm::LLVMGetNextFunction(fn_val);
            // Only consider functions WITH a body.
            const first_bb: void* = llvm::LLVMGetFirstBasicBlock(fn_val);
            if (first_bb != null) {
                if (function_calls_stripped(cg, fn_val)) {
                    // Don't double-strip a name that's already in the set.
                    const fn_name: string = llvm::LLVMGetValueName(fn_val) as string;
                    if (!is_stripped(cg, fn_name)) {
                        const fn_name_safe: string = if (fn_name == null) {
                            "<unnamed>"
                        } else {
                            fn_name
                        };
                        mut wdiag: Diagnostic = Diagnostic::warning(
                            ErrorCode::E0633_FUNCTION_BODY_ERROR,
                            format("codegen: function '%s' transitively stripped because it calls a previously-stripped sibling in this module; see preceding error",
                                fn_name_safe));
                        cg.diag.emit(wdiag);
                        const wrap: LValue = LValue { raw: fn_val };
                        cg.diag.strip_function_body(wrap);
                        newly_stripped += 1;
                    }
                }
            }
            fn_val = next_fn;
        }
        if (newly_stripped == 0) { break; }
        iterations += 1;
    }
}


// Codegen Pass Implementations

type struct CodegenPasses {

    /// IRGeneration pass.  Creates an LLVM module, walks the AST, and
    /// produces LLVM IR.  Stores result in ctx.artifacts.ir.
    static run_ir_generation(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        // Resolve module name.
        mut module_name: string = "main";
        if (ctx.namespace_str.is_valid()) {
            module_name = ctx.intern_table.resolve(ctx.namespace_str);
        }

        cdebug("[Codegen] Step 1: IR generation for module: %s\n", module_name);

        // Initialize LLVM targets (idempotent).
        cdebug("[Codegen] Step 2: Initializing LLVM targets...\n");
        init_native_target();
        cdebug("[Codegen] Step 3: LLVM targets initialized\n");

        // Create per-module codegen context on the heap to avoid stack overflow.
        // CompilationContext is already large on the stack, and CodegenContext
        // adds ~400+ bytes of arrays and maps per module.
        cdebug("[Codegen] Step 4: Creating CodegenContext...\n");
        const _box_cg: Box<CodegenContext> = Box<CodegenContext>::new(CodegenContext::new(ctx, module_name));
        const cg: CodegenContext* = _box_cg.leak();
        // Two-phase init step 2: wire back-pointers on sub-components now
        // that `cg` is at its stable heap address.  Wiring before the move
        // into the Box would leave back-pointers dangling at the source.
        cg.wire();
        cdebug("[Codegen] Step 5: CodegenContext created\n");

        // Set target triple and data layout.  Honor a project-level
        // override (cryoconfig `target = "..."` or CLI `--target=TRIPLE`)
        // when one is set; otherwise fall back to the host triple from
        // LLVM.  The resolved triple is also fed to the target machine
        // below so the data-layout string matches.
        cdebug("[Codegen] Step 6: Setting target triple...\n");
        const triple: string = resolve_effective_triple(ctx.target_triple);
        cg.llvm_module.set_target_triple(triple);
        cdebug("[Codegen] Step 7: Target triple set: %s\n", triple);

        cdebug("[Codegen] Step 8: Creating target machine...\n");
        mut tm: LTargetMachine = create_target_machine_for_triple(triple);
        if (tm.is_valid()) {
            const layout: string = tm.get_data_layout_string();
            cg.llvm_module.set_data_layout(layout);
        }
        cdebug("[Codegen] Step 9: Target machine ready\n");

        // Cross-module externs are declared lazily by `resolve_function` /
        // `resolve_function_with_arity` / `resolve_global` on first reference
        // from this module, avoiding the O(modules x funcs x overloads) bulk
        // pre-declaration loop that used to run here.

        // Emit the inline runtime helpers (`format`, `panic`, etc.) into
        // this module with linkonce_odr linkage.  Idempotent and
        // per-module; the linker collapses the 100+ copies down to one.
        cg.intrinsics.emit_format_runtime();
        cg.intrinsics.emit_panic_runtime();

        // Create the visitor and generate IR.  Heap-allocate via Box::leak
        // so sub-emitters can hold stable `state: VisitorState*` back-pointers
        // into `gen.state`; same two-phase pattern as `CodegenContext` above.
        cdebug("[Codegen] Step 12: Creating IRGeneratorVisitor...\n");
        const _box_gen: Box<IRGeneratorVisitor> = Box<IRGeneratorVisitor>::new(IRGeneratorVisitor(cg));
        const gen: IRGeneratorVisitor* = _box_gen.leak();
        // Two-phase init step 2: wire back-pointers on sub-emitters now
        // that `gen` is at its stable heap address.  No-op while the
        // visitor's sub-emitter set is empty; the call site is in place
        // for incremental extraction.
        gen.wire();
        cdebug("[Codegen] Step 13: Getting program AST...\n");
        const program: ProgramNode* = ctx.artifacts.ast.program();
        cdebug("[Codegen] Step 14: Generating program IR (program=%p)...\n", program as void*);
        const success: boolean = gen.generate_program(program);
        mut step15_status: string = "failed";
        if (success) { step15_status = "succeeded"; }
        cdebug("[Codegen] Step 15: Program IR generation %s\n", step15_status);
        fflush(null);

        if (!success) {
            if (ctx.debug_mode) {
                cdebug("[Codegen] IR generation failed for module: %s\n", module_name);
            }
            cg.dispose_builder();
            tm.dispose();
            return PassResult::from_snapshot(ctx.diagnostics, snap);
        }

        // Cascade-strip: a method body that fails codegen (e.g.
        // `Array<T>::partition` with a non-numeric T whose `T < T` doesn't
        // lower) gets stripped to a `declare`-only.  But other methods in
        // the same impl block (e.g. `Array<T>::quicksort` which calls
        // `partition`, and `Array<T>::sort` which calls `quicksort`)
        // already emitted their bodies with a call to the now-empty
        // partition.  At link time, that call is an undefined reference.
        //
        // Walk all defined functions; for each that still has a body but
        // calls a same-module declare (a stripped sibling), strip it too.
        // Iterate until the strip set stabilizes.  Functions that were
        // intentionally cross-module externs are unaffected because the
        // strip set only contains symbols whose body was attempted in
        // this module.
        cascade_strip_dependents(cg);

        // Pre-verify: scan all functions for corrupt types before calling
        // LLVMVerifyModule (which crashes on null function types).
        mut has_corrupt: boolean = false;
        {
            mut fn_val: void* = llvm::LLVMGetFirstFunction(cg.llvm_module.raw);
            while (fn_val != null) {
                const fn_ty: void* = llvm::LLVMGlobalGetValueType(fn_val);
                if (fn_ty == null) {
                    const fn_name: string = llvm::LLVMGetValueName(fn_val) as string;
                    cdebug("[Codegen] CORRUPT: function '%s' has null type in module %s\n",
                           fn_name, module_name);
                    has_corrupt = true;
                } else {
                    const ret_ty: void* = llvm::LLVMGetReturnType(fn_ty);
                    if (ret_ty == null) {
                        const fn_name: string = llvm::LLVMGetValueName(fn_val) as string;
                        cdebug("[Codegen] CORRUPT: function '%s' has null return type in module %s\n",
                               fn_name, module_name);
                        has_corrupt = true;
                    }
                    const param_count: u32 = llvm::LLVMCountParamTypes(fn_ty);
                    if (param_count > 0) {
                        const param_buf: void* = intrinsics::malloc(param_count as u64 * 8);
                        llvm::LLVMGetParamTypes(fn_ty, param_buf);
                        const slots: void** = param_buf as void**;
                        for (mut pi: u32 = 0; pi < param_count; pi++) {
                            if (slots[pi] == null) {
                                const fn_name: string = llvm::LLVMGetValueName(fn_val) as string;
                                cdebug("[Codegen] CORRUPT: function '%s' param %u is null type in module %s\n",
                                       fn_name, pi, module_name);
                                has_corrupt = true;
                            }
                        }
                        intrinsics::free(param_buf);
                    }
                }
                fn_val = llvm::LLVMGetNextFunction(fn_val);
            }
        }

        // Dump .ll BEFORE verification so failing modules are inspectable.
        if (ctx.debug_mode) {
            const mn_len: u64 = intrinsics::strlen(module_name);
            const mn_buf: void* = intrinsics::malloc(mn_len + 1);
            intrinsics::memcpy(mn_buf, module_name as void*, mn_len);
            const mn_bytes: i8* = mn_buf as i8*;
            for (mut si: u64 = 0; si < mn_len; si++) {
                if (mn_bytes[si] == 58) { mn_bytes[si] = 95; }
            }
            mn_bytes[mn_len] = 0;
            // Honour project_config.output_dir so `--build-dir=...` lands
            // here too; hardcoded "build/obj/" would otherwise spill .ll
            // dumps into the default path even when the rest of codegen
            // is writing under a different directory.
            mut ll_dir: string = "build/obj";
            if (ctx.project_config != null) {
                ll_dir = format("%s/obj", ctx.project_config.output_dir);
            }
            const ll_path: string = format("%s/%s.ll", ll_dir, mn_buf as string);
            mut ll_err: i8* = null;
            llvm::LLVMPrintModuleToFile(cg.llvm_module.raw, ll_path, &ll_err as void*);
            if (ll_err != null) { llvm::LLVMDisposeMessage(ll_err as void*); }
            intrinsics::free(mn_buf);
        }

        if (has_corrupt) {
            cdebug("[Codegen] Skipping verification for %s due to corrupt function types\n", module_name);
        } else {
            // Verify the LLVM module.
            mut verify_err: i8* = null;
            const verify_result: i32 = llvm::LLVMVerifyModule(cg.llvm_module.raw, 2, &verify_err as void*);
            if (verify_result != 0) {
                // Print verifier output directly so the user can see which
                // module / function the verifier choked on. Then emit a
                // single short diagnostic; the previous code attached the
                // multi-KB verifier text to a Diagnostic.with_note(), and
                // that string ended up sharing memory across diagnostics
                // in a way that segfaulted the deferred flush in stdlib
                // builds with several verify failures.
                mut diag: Diagnostic = Diagnostic::error(
                    ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    format("LLVM module verification failed for %s", module_name));
                if (verify_err != null) {
                    const max_len: u64 = 2048;
                    const err_len: u64 = intrinsics::strlen(verify_err as string);
                    mut note_body: string = verify_err as string;
                    if (err_len > max_len) {
                        const trunc_buf: i8* = intrinsics::malloc(max_len + 1) as i8*;
                        intrinsics::memcpy(trunc_buf as void*, verify_err as void*, max_len);
                        trunc_buf[max_len] = 0;
                        note_body = trunc_buf as string;
                    }
                    diag = diag.with_note("LLVM reports: " + note_body);
                    if (err_len > max_len) {
                        diag = diag.with_note("(LLVM error truncated)");
                    }
                }
                ctx.diagnostics.emit(diag);
                if (verify_err != null) {
                    llvm::LLVMDisposeMessage(verify_err as void*);
                }
                cg.dispose_builder();
                tm.dispose();
                return PassResult::failure(1);
            }
            if (verify_err != null) {
                llvm::LLVMDisposeMessage(verify_err as void*);
            }
        }

        if (ctx.debug_mode) {
            cdebug("[Codegen] Module verified: %s\n", module_name);
        }

        // Store the LLVM module in artifacts.  The module is now owned by
        // artifacts; do NOT dispose it here.
        ctx.artifacts.ir = IROutput {
            llvm_module: cg.llvm_module.raw,
            module_name: module_name,
        };

        cg.dispose_builder();
        tm.dispose();

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }


    /// Optimization pass.  Runs LLVM's new pass manager on the module.
    static run_optimization(ctx: CompilationContext*) -> PassResult {
        if (!ctx.artifacts.ir.is_valid()) {
            return PassResult::ok();
        }

        if (ctx.debug_mode) {
            cdebug("[Codegen] Optimization for module: %s\n", ctx.artifacts.ir.module_name);
        }

        const opt_triple: string = resolve_effective_triple(ctx.target_triple);
        mut tm: LTargetMachine = create_target_machine_for_triple(opt_triple);
        if (!tm.is_valid()) {
            return PassResult::ok();
        }

        // Run default O2 optimization pipeline.
        const opts: void* = llvm::LLVMCreatePassBuilderOptions();
        const passes: string = "default<O2>";
        const result: i32 = llvm::LLVMRunPasses(
            ctx.artifacts.ir.llvm_module, passes, tm.raw, opts);
        llvm::LLVMDisposePassBuilderOptions(opts);

        if (result != 0) {
            tm.dispose();
            ctx.emit_error(ErrorCode::E0605_OPTIMIZATION_FAILED,
                format("LLVM optimization pipeline failed for module '%s' (error code %d)",
                    ctx.artifacts.ir.module_name, result));
            return PassResult::failure(1);
        }

        // Re-verify after optimization.  Optimization passes can introduce
        // verifier failures (malformed intrinsics, dropped metadata, etc.)
        // and we'd rather fail here than ship a broken object file.
        mut verify_err: i8* = null;
        const verify_rc: i32 = llvm::LLVMVerifyModule(
            ctx.artifacts.ir.llvm_module, 2, &verify_err as void*);
        tm.dispose();
        if (verify_rc != 0) {
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0605_OPTIMIZATION_FAILED,
                format("LLVM module verification failed after optimization for '%s'",
                    ctx.artifacts.ir.module_name));
            if (verify_err != null) {
                const max_len: u64 = 2048;
                const err_len: u64 = intrinsics::strlen(verify_err as string);
                mut note_body: string = verify_err as string;
                if (err_len > max_len) {
                    const trunc_buf: i8* = intrinsics::malloc(max_len + 1) as i8*;
                    intrinsics::memcpy(trunc_buf as void*, verify_err as void*, max_len);
                    trunc_buf[max_len] = 0;
                    note_body = trunc_buf as string;
                }
                diag = diag.with_note("LLVM reports: " + note_body);
                llvm::LLVMDisposeMessage(verify_err as void*);
            }
            ctx.diagnostics.emit(diag);
            return PassResult::failure(1);
        }
        if (verify_err != null) { llvm::LLVMDisposeMessage(verify_err as void*); }

        return PassResult::ok();
    }


    /// ObjectEmission pass.  Emits a per-module artifact from the LLVM
    /// module.  Kind selection:
    ///   - No `-o` override        -> legacy `<output_dir>/obj/<mod>.o`
    ///   - `-o foo.o`  / Object    -> emit object to the override path
    ///   - `-o foo.s`  / Asm       -> emit assembly to the override path
    ///   - `-o foo.ll` / IRText    -> dump module text to the override path
    ///   - `-o foo`    / Exe       -> emit object to the legacy path; the
    ///                                Linking pass picks it up and shells
    ///                                out to `cc` to produce the final
    ///                                executable at the override path.
    static run_object_emission(ctx: CompilationContext*) -> PassResult {
        if (!ctx.artifacts.ir.is_valid()) {
            return PassResult::ok();
        }

        const kind: OutputKind = ctx.output_kind;

        // IRText is the only kind that doesn't go through LLVM's
        // target-machine emit path; it's a pure text dump of the
        // module IR, no codegen needed.  Handle first to avoid
        // creating a target machine we won't use.
        match (kind) {
            OutputKind::IRText => {
                return CodegenPasses::emit_ir_text(ctx, ctx.output_path_override);
            }
            _ => { /* fall through */ }
        }

        // Resolve the effective triple here too; the object format
        // (ELF / COFF / Mach-O) is selected by the target machine, so
        // a stale host machine here would silently undo the cross-
        // compile we set up in IR generation.
        const obj_triple: string = resolve_effective_triple(ctx.target_triple);
        mut tm: LTargetMachine = create_target_machine_for_triple(obj_triple);
        if (!tm.is_valid()) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "failed to create target machine for object emission");
            return PassResult::failure(1);
        }

        // Decide the emit path + LLVM file_type.  Asm and Object kinds
        // route directly to the user's override.  Exe and the legacy
        // (no-override) case keep the `build/obj/<mod>.o` layout so
        // the Linking pass has a stable per-module input set.
        mut emit_path: string = "";
        mut emit_type: LFileType = LFileType::Object;
        match (kind) {
            OutputKind::Asm => {
                emit_path = ctx.output_path_override;
                emit_type = LFileType::Assembly;
            }
            OutputKind::Object => {
                emit_path = ctx.output_path_override;
                emit_type = LFileType::Object;
            }
            _ => {
                emit_path = CodegenPasses::legacy_obj_path(ctx);
                emit_type = LFileType::Object;
            }
        }

        const mod: LModule = LModule { raw: ctx.artifacts.ir.llvm_module };
        const success: boolean = tm.emit_to_file(mod, emit_path, emit_type);
        tm.dispose();

        if (!success) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("failed to emit %s",
                    match (kind) {
                        OutputKind::Asm => { format("assembly file: %s", emit_path) }
                        _               => { format("object file: %s", emit_path) }
                    }));
            return PassResult::failure(1);
        }

        // Store the object file path.
        // NOTE: Deep nested struct field assignment
        // (`ctx.artifacts.linked.object_file_path = ...`) has historically
        // been a source of codegen bugs through multi-deref chains. Assign
        // a full `LinkedOutput` replacement instead.
        ctx.artifacts.linked = LinkedOutput { object_file_path: emit_path };

        // Accumulate every module's object path so the linker pass can
        // invoke `cc` once over all of them at the end of Phase 7.
        // Route through `register_object_file`; directly calling
        // `.push()` on a multi-deref field chain has historically landed
        // on a temp copy (push-through-pointer codegen limitation).
        //
        // Skip registration for Asm/Object/IRText: those kinds emit a
        // user-facing artifact (assembly text, object, IR text) that
        // is NOT something `cc` should re-link.  Registering an .s/.ll
        // here would feed it back into run_linking and corrupt the
        // link command.  The legacy path and Exe kind both want the
        // .o registered: Exe so the link step picks it up, legacy so
        // multi-module project builds aggregate it.
        match (kind) {
            OutputKind::Asm    => { /* no register */ }
            OutputKind::Object => { /* no register */ }
            OutputKind::IRText => { /* unreachable: handled above */ }
            _ => {
                ctx.artifacts.register_object_file(emit_path);
            }
        }

        if (ctx.debug_mode) {
            cdebug("[Codegen] Emitted: %s\n", emit_path);
        }

        return PassResult::ok();
    }

    /// Build the legacy object path: `<output_dir>/obj/<safe_module>.o`.
    /// Used when no `-o PATH` override is in effect, and for the per-module
    /// object that feeds the Exe link step in single-file mode.
    static legacy_obj_path(ctx: CompilationContext*) -> string {
        mut output_dir: string = "build/obj";
        if (ctx.project_config != null) {
            // mkdir() doesn't create parent dirs; ensure the parent
            // exists first.  Custom `--build-dir=...` paths often don't
            // pre-exist; the bare `mkdir` then fails silently and the
            // object emission errors with "No such file or directory".
            mkdir(ctx.project_config.output_dir, 493);
            output_dir = format("%s/obj", ctx.project_config.output_dir);
        }
        mkdir(output_dir, 493);

        // Mangle module name: replace "::" with "_" for filesystem safety.
        mut safe_name: string = ctx.artifacts.ir.module_name;
        const name_len: u64 = intrinsics::strlen(safe_name);
        const name_buf: i8* = intrinsics::malloc(name_len + 1) as i8*;
        intrinsics::memcpy(name_buf as void*, safe_name as void*, name_len);
        name_buf[name_len] = 0;
        for (mut k: u64 = 0; k < name_len; k++) {
            if (name_buf[k] == ':') { name_buf[k] = '_'; }
        }
        safe_name = name_buf as string;
        return format("%s/%s.o", output_dir, safe_name);
    }

    /// Dump the LLVM module to a `.ll` text file at `path`.  Skips the
    /// target machine entirely; IR text is target-independent and the
    /// only failure mode is filesystem (permissions, missing parent).
    static emit_ir_text(ctx: CompilationContext*, path: string) -> PassResult {
        const mod_ref: void* = ctx.artifacts.ir.llvm_module;
        mut err: i8* = null;
        const rc: i32 = llvm::LLVMPrintModuleToFile(mod_ref, path, &err as void*);
        if (rc != 0) {
            const note: string = if (err != null) { err as string } else { "(no detail)" };
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("failed to write IR text to %s: %s", path, note));
            if (err != null) { llvm::LLVMDisposeMessage(err as void*); }
            return PassResult::failure(1);
        }
        if (err != null) { llvm::LLVMDisposeMessage(err as void*); }
        ctx.artifacts.linked = LinkedOutput { object_file_path: path };
        if (ctx.debug_mode) {
            cdebug("[Codegen] Emitted IR text: %s\n", path);
        }
        return PassResult::ok();
    }


    /// Linking pass.  Invokes the system linker (`cc`) to combine all
    /// per-module object files emitted during Phase 7 into the final
    /// executable at `{output_dir}/bin/{project_name}`.  Pulls link
    /// libs/paths from the parsed cryoconfig, and tacks on the stdlib
    /// archive whenever `no_std` is not set.
    static run_linking(ctx: CompilationContext*) -> PassResult {
        if (ctx.artifacts.object_files.length == 0) {
            // Nothing to link: library/stdlib batch build, or codegen
            // was disabled (LSP mode).  Not an error.
            return PassResult::ok();
        }
        if (ctx.project_config == null) {
            // Single-file mode: only Exe needs linking.  Asm / Object /
            // IRText emit their final artifact straight from object
            // emission; Default (no `-o`) leaves the .o behind without
            // linking, matching the historic behaviour.
            return match (ctx.output_kind) {
                OutputKind::Exe => { CodegenPasses::run_linking_singlefile(ctx) }
                _               => { PassResult::ok() }
            };
        }
        if (!ctx.project_config.requires_entry_point()) {
            // Library / stdlib target: no executable to produce, but
            // bundle the per-module .o files into a single archive that
            // executable projects can pick up via `<root>/<output>/lib<name>.a`.
            // The stdlib target writes `stdlib/.bin/libcryo.a` (canonical
            // path the executable-link path below looks for).
            return CodegenPasses::bundle_archive(ctx);
        }

        const cfg: ProjectConfig* = ctx.project_config;
        const output_dir: string = cfg.output_dir;
        // Cross-compilation: when the target triple differs from the
        // host, the per-module .o files were emitted for that target's
        // ABI/object format and the host's `cc` cannot link them.  Skip
        // the link step, leave the artifacts in `<output_dir>/obj/`,
        // and tell the user how to finish the link with a target-aware
        // toolchain.  Empty `ctx.target_triple` => host build, link
        // normally.
        if (intrinsics::strlen(ctx.target_triple) > 0
                && intrinsics::strcmp(ctx.target_triple, get_default_triple()) != 0) {
            const obj_only_dir: string = format("%s/obj", output_dir);
            intrinsics::printf("Cross-compile: produced %lld object file(s) for target '%s' in %s\n",
                ctx.artifacts.object_files.length, ctx.target_triple, obj_only_dir);
            intrinsics::printf("  (host linker skipped; link with a %s-aware toolchain, e.g.:\n",
                ctx.target_triple);
            intrinsics::printf("     clang --target=%s %s/*.o -o <output>)\n",
                ctx.target_triple, obj_only_dir);
            return PassResult::ok();
        }
        // Ensure parent dir exists for custom `--build-dir=...` paths
        // that haven't been pre-created.
        mkdir(output_dir, 493);
        const bin_dir: string = format("%s/bin", output_dir);
        mkdir(bin_dir, 493);  // 0755
        // Test-mode builds use a `-test` suffix so the test executable
        // coexists with a normal `cryo run` build of the same project.
        const exe_path: string = if (ctx.mode.skip_user_main()) {
            format("%s/%s-test", bin_dir, cfg.project_name)
        } else {
            format("%s/%s", bin_dir, cfg.project_name)
        };

        // Build the link command.  libc's system(3) runs `sh -c`, so
        // every interpolated path must be shell-quoted; without it, a
        // working directory with a space breaks the link, and a path
        // containing shell metacharacters is a command-injection hazard.
        mut cmd: string = format("cc -o %s", shell_quote(exe_path));
        for (mut i: i64 = 0; i < ctx.artifacts.object_files.length; i++) {
            cmd = format("%s %s", cmd, shell_quote(ctx.artifacts.object_files[i]));
        }
        // Project-configured -L paths and -l libs.  -L and -l are
        // single-token args with the value glued to the flag, so the
        // quoting goes around the value only.
        for (mut i: i64 = 0; i < cfg.link_paths.length; i++) {
            cmd = format("%s -L%s", cmd, shell_quote(cfg.link_paths[i]));
        }
        for (mut i: i64 = 0; i < cfg.link_libs.length; i++) {
            cmd = format("%s -l%s", cmd, shell_quote(cfg.link_libs[i]));
        }
        // Stdlib archive: the stdlib build emits `<stdlib_root>/.bin/libcryo.a`
        // (see bundle_archive); pull it in unless the project opted out
        // via `no_std`.  Read the resolved stdlib_root off the context
        // so installed cryo (where stdlib lives at <prefix>/share/cryo/stdlib)
        // and in-repo cryo (where it lives at <repo>/stdlib) both link
        // against the right archive.
        if (!cfg.no_std && intrinsics::strlen(ctx.stdlib_root) > 0) {
            const stdlib_archive: string = format("%s/.bin/libcryo.a",
                ctx.stdlib_root);
            cmd = format("%s %s", cmd, shell_quote(stdlib_archive));
        }
        // Cryo runtime support is fully inline-lowered: every bare-name
        // intrinsic (i32_to_i64, ptr_add, format, bswap*, clz*, isfinite,
        // atomic_fence, dirent_*) is emitted directly into LLVM IR by
        // IntrinsicsCodegen.  No C runtime to link.
        // System libs every cryo binary needs: libm for math intrinsics,
        // libstdc++ for LLVM's C++ internals (dragged in through -lLLVM-*).
        cmd = format("%s -lm -lstdc++", cmd);

        if (ctx.debug_mode) {
            cdebug("[Codegen] Linking %lld objects -> %s\n",
                ctx.artifacts.object_files.length, exe_path);
            cdebug("[Codegen] Link command: %s\n", cmd);
        }

        const rc: i32 = system(cmd);
        if (rc != 0) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("linker invocation failed (cc exited with %d): %s", rc, cmd));
            return PassResult::failure(1);
        }

        cdebug("[Codegen] Linked executable: %s\n", exe_path);

        // Emit a combined `.ll` text dump of the project's per-module IR
        // (written during Phase 7) alongside the executable.  Used by
        // selfhost-check for stage-4/stage-5 byte-identity verification.
        // Stderr is redirected to /dev/null so `llvm-link-20`'s "No such
        // file or directory: build/obj/*.ll" complaint (when Phase 7 didn't
        // write any .ll files because --emit-llvm wasn't set) doesn't
        // pollute the user's terminal in the silent default mode.
        const ll_path: string = format("%s.ll", exe_path);
        const obj_dir: string = format("%s/obj", output_dir);
        // Shell-quote obj_dir but leave `/*.ll` unquoted so the glob still
        // expands.  Adjacent shell tokens concatenate, so the result of
        // `'<dir>'/*.ll` is exactly the expansion the linker needs.
        const ll_cmd: string = format(
            "llvm-link-20 -S %s/*.ll -o %s 2>/dev/null",
            shell_quote(obj_dir), shell_quote(ll_path));
        const ll_rc: i32 = system(ll_cmd);
        if (ll_rc == 0) {
            cdebug("[Codegen] Linked IR dump: %s\n", ll_path);
        } else {
            cdebug("[Codegen] Warning: llvm-link-20 failed for IR dump (rc=%d)\n", ll_rc);
        }

        return PassResult::ok();
    }


    /// Single-file `-o PATH` Exe link.  Mirrors the project link path
    /// minus the cryoconfig-driven extras: there are no `[link]` paths,
    /// no test-suffix logic, and no llvm-link IR dump.  The stdlib
    /// archive is still pulled in when `ctx.stdlib_root` was resolved
    /// Without it most non-trivial programs would fail to link.
    static run_linking_singlefile(ctx: CompilationContext*) -> PassResult {
        const exe_path: string = ctx.output_path_override;
        if (intrinsics::strlen(exe_path) == 0) {
            // Defensive: run_linking only routes here when output_kind
            // is Exe, which the CLI sets alongside output_path_override.
            return PassResult::ok();
        }

        mut cmd: string = format("cc -o %s", shell_quote(exe_path));
        for (mut i: i64 = 0; i < ctx.artifacts.object_files.length; i++) {
            cmd = format("%s %s", cmd, shell_quote(ctx.artifacts.object_files[i]));
        }
        // Stdlib archive: same lookup as the project link path.  Empty
        // stdlib_root means single-file mode never resolved one (e.g.
        // user passed `--no-std` semantically by stripping prelude
        // resolution); skip the archive in that case and let the
        // linker error if the program needs stdlib symbols.
        if (intrinsics::strlen(ctx.stdlib_root) > 0) {
            const stdlib_archive: string = format("%s/.bin/libcryo.a",
                ctx.stdlib_root);
            cmd = format("%s %s", cmd, shell_quote(stdlib_archive));
        }
        cmd = format("%s -lm -lstdc++", cmd);

        if (ctx.debug_mode) {
            cdebug("[Codegen] Single-file link -> %s\n", exe_path);
            cdebug("[Codegen] Link command: %s\n", cmd);
        }

        const rc: i32 = system(cmd);
        if (rc != 0) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("linker invocation failed (cc exited with %d): %s", rc, cmd));
            return PassResult::failure(1);
        }

        cdebug("[Codegen] Linked executable: %s\n", exe_path);
        ctx.artifacts.linked = LinkedOutput { object_file_path: exe_path };
        return PassResult::ok();
    }


    /// Bundle a library/stdlib target's per-module .o files into a single
    /// archive next to them.  The Stdlib target is hardcoded to `libcryo.a`
    /// (the path the executable-link path looks for via
    /// `<root>/../stdlib/.bin/libcryo.a`); Library targets use
    /// `lib<project_name>.a` per the usual convention.
    /// `ar rcs` is idempotent; re-runs overwrite the archive cleanly.
    static bundle_archive(ctx: CompilationContext*) -> PassResult {
        if (ctx.project_config == null) {
            return PassResult::ok();
        }
        const cfg: ProjectConfig* = ctx.project_config;
        const archive_name: string = match (cfg.target_type) {
            TargetType::Stdlib => { "libcryo.a" }
            _                  => { format("lib%s.a", cfg.project_name) }
        };
        const archive_path: string = format("%s/%s", cfg.output_dir, archive_name);

        // Build `ar rcs <archive> <obj0> <obj1> ...` in one command so we
        // pay only one process spawn.  `r` replaces stale members on
        // re-bundle, `c` suppresses the empty-archive warning, `s` writes
        // the symbol index that `ld` consults to satisfy references.
        // Every interpolated path is shell-quoted; `system(3)` runs `sh -c`.
        mut cmd: string = format("ar rcs %s", shell_quote(archive_path));
        for (mut i: i64 = 0; i < ctx.artifacts.object_files.length; i++) {
            cmd = format("%s %s", cmd, shell_quote(ctx.artifacts.object_files[i]));
        }

        if (ctx.debug_mode) {
            cdebug("[Codegen] Bundling %lld objects -> %s\n",
                ctx.artifacts.object_files.length, archive_path);
            cdebug("[Codegen] Bundle command: %s\n", cmd);
        }

        const rc: i32 = system(cmd);
        if (rc != 0) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("ar invocation failed (exited with %d): %s", rc, cmd));
            return PassResult::failure(1);
        }

        cdebug("[Codegen] Bundled archive: %s (%lld objects)\n",
            archive_path, ctx.artifacts.object_files.length);
        return PassResult::ok();
    }
}
