/// Codegen Passes
///
/// Entry points for the four codegen passes: IRGeneration, Optimization,
/// ObjectEmission, and Linking.  Called by PassRegistry::run_pass().

namespace Compiler::Codegen::Passes;

import Compiler::Codegen;
import Compiler::Codegen::{ LLVMTypes, TypeMap, Context };
import Compiler::Codegen::Ops::IntrinsicsCodegen;
import Compiler::Codegen::Visit::IRGenerator;
import Compiler::CompilationContext;
import Compiler::ProjectConfig;
import Compiler::ModuleGraph;
import Compiler::Artifacts;
import Compiler::Diag;
import Compiler::Diag::{ Diagnostic, Sink, Snapshot };
import Compiler::AST::Node;
import Compiler::Passes::PassID;
import Compiler::Resolver::{ InternTable, SymbolStr };
import std::fmt;
import Utils::Logger;


// Shell-quoting helper

/// POSIX-shell-safe quote a path or argument for use in `system()` /
/// `sh -c` commands.  Wraps the input in single quotes and rewrites any
/// embedded single quote as the four-byte sequence `'\''`; single-quoted
/// strings are not interpreted by `/bin/sh` at all, so this neutralises
/// every shell metacharacter (spaces, $, `, *, ;, !, &, etc).
///
/// libc's `system(3)` runs the command through `sh -c`, so any
/// interpolated user-controlled path needs this treatment.  Without it,
/// a working directory with a space breaks linking, and a path containing
/// shell metacharacters is an arbitrary-command-execution hazard.
function shell_quote(s: string) -> string {
    const len: u64 = intrinsics::strlen(s);
    // Worst case: every byte is a single quote, expanding to 4 bytes,
    // plus two outer quotes and a NUL terminator.
    const cap: u64 = len * 4 + 3;
    const buf: i8* = intrinsics::malloc(cap) as i8*;
    mut o: u64 = 0;
    buf[o] = '\''; o += 1;
    const sb: i8* = s as i8*;
    for (mut i: u64 = 0; i < len; i++) {
        const ch: i8 = sb[i];
        if (ch == '\'') {
            buf[o] = '\''; o += 1;
            buf[o] = '\\'; o += 1;
            buf[o] = '\''; o += 1;
            buf[o] = '\''; o += 1;
        } else {
            buf[o] = ch; o += 1;
        }
    }
    buf[o] = '\''; o += 1;
    buf[o] = 0;
    return buf as string;
}

/// Shell redirect that discards stdout+stderr while probing a tool for
/// existence.  Host-gated (`cmd` uses `>NUL`, POSIX `sh` uses
/// `>/dev/null`; both honour `2>&1`) exactly like `c_header_import`'s
/// `cc_silence` - ConfigGating strips the inactive side at build time, so
/// the running compiler emits the form its own shell understands.
![target(unix)]
function probe_silence() -> string { return ">/dev/null 2>&1"; }

![target(windows)]
function probe_silence() -> string { return ">NUL 2>&1"; }

/// True iff `tool` can be launched, probed via `<tool> --version`.  A
/// missing binary makes the shell exit non-zero (`sh`: 127; `cmd`: 9009)
/// and `system(3)` reports that, so exit 0 means it's usable.  Mirrors
/// `pick_c_preprocessor`'s `cc_available` probe.  The probe runs after IR
/// is emitted (link/archive time), so the tool chosen never affects the
/// `.ll` the selfhost gate compares.
function tool_available(tool: string) -> boolean {
    return system(format("%s --version %s", tool, probe_silence())) == 0;
}

/// Pick the static archiver binary.  `CRYO_AR` overrides everything,
/// mirroring `pick_c_preprocessor`'s `CRYO_CC` knob - this is what lets a
/// Windows-hosted `cryo.exe` under wine point at an `llvm-ar.exe` it can
/// launch, since the host's ELF `ar` cannot run there.  With no override
/// we AUTO-DETECT: the default `ar` wins whenever it's launchable (true on
/// every POSIX host and on a mingw box, where binutils ships `ar`), so the
/// historic choice and selfhost byte-identity are preserved and the probe
/// only falls through to `llvm-ar` when `ar` is genuinely absent.
function pick_archiver() -> string {
    const env_raw: i8* = intrinsics::getenv("CRYO_AR") as i8*;
    if (env_raw != null) {
        const env_val: string = env_raw as string;
        if (intrinsics::strlen(env_val) > 0) { return env_val; }
    }
    if (tool_available("ar"))         { return "ar"; }
    if (tool_available("llvm-ar"))    { return "llvm-ar"; }
    if (tool_available("llvm-ar-20")) { return "llvm-ar-20"; }
    return "ar";
}

/// Pick the link driver (the `cc`/`gcc`/`clang` binary the link command
/// invokes).  `CRYO_CC` overrides everything, mirroring `pick_archiver`'s
/// `CRYO_AR` and `pick_c_preprocessor`'s use of the same knob for
/// `#include` preprocessing (one C-toolchain driver serves both jobs).
///
/// With no override we AUTO-DETECT, the same way `pick_c_preprocessor`
/// does, so a NATIVE Windows self-host needs no environment setup:
///
///   1. The per-target `default_driver` wins whenever it's launchable.
///      This is the historic choice on every host where it exists - `cc`
///      on a POSIX host, `x86_64-w64-mingw32-gcc` on a Linux->windows
///      cross - so existing flows and selfhost byte-identity are unchanged
///      (on Linux/CI `cc` is present, so the fallback never fires).
///   2. Only when `default_driver` is ABSENT do we probe.  This is the
///      native mingw/MSYS2 case: `host_linker_config` asks for `cc`, but a
///      stock box ships `gcc`/`clang` instead.  `gcc` is tried before
///      `clang` because on a mingw host `gcc` links gnu-ABI objects
///      natively while a bare `clang` may default to the msvc target.
///   3. A cross driver (`*-mingw32-*`) that's missing has no sane host
///      substitute, so we DON'T fall back for it - the original name is
///      kept so the link error names the absent cross toolchain.
function pick_link_driver(default_driver: string) -> string {
    const env_raw: i8* = intrinsics::getenv("CRYO_CC") as i8*;
    if (env_raw != null) {
        const env_val: string = env_raw as string;
        if (intrinsics::strlen(env_val) > 0) { return env_val; }
    }
    if (tool_available(default_driver)) { return default_driver; }
    if (strstr(default_driver, "mingw") == null) {
        if (tool_available("gcc"))   { return "gcc"; }
        if (tool_available("clang")) { return "clang"; }
        if (tool_available("cc"))    { return "cc"; }
    }
    return default_driver;
}

/// Resolve the `llvm-config` binary used to derive the static-link lib set
/// for `--release-static`.  `CRYO_LLVM_CONFIG` overrides; default
/// `llvm-config-20` (matches the LLVM 20 the compiler is built against).
/// Only consulted on the `--release-static` path, so a normal dev build
/// never needs it present.  The env override is what lets a musl release
/// build under Alpine point at its own `llvm-config` (which reports the
/// musl-built static `.a` set) with no source change.
function pick_llvm_config() -> string {
    const env_raw: i8* = intrinsics::getenv("CRYO_LLVM_CONFIG") as i8*;
    if (env_raw != null) {
        const env_val: string = env_raw as string;
        if (intrinsics::strlen(env_val) > 0) { return env_val; }
    }
    return "llvm-config-20";
}

/// Slurp `<llvm-config> --ldflags --libs --system-libs --link-static` and
/// return it as one space-separated flag string (`-L<libdir> -lLLVMCore ...
/// -lrt -ldl -lm -lz -lzstd -lxml2`) for splicing into the `--release-static`
/// link line.  This is how the 200+ component `.a` set AND its search dir are
/// obtained without hardcoding a list/path that would drift across LLVM
/// packagings - the `-L` from `--ldflags` is what makes this portable to a
/// musl/Alpine release where the static libs live elsewhere.  llvm-config
/// emits the sections in flag order: `-L` first, then the component libs,
/// then the system libs - the correct single-pass static link order.
/// Returns "" on popen failure, empty output, or a non-zero exit so the
/// caller can fail the link with a clear diagnostic.  Mirrors the
/// popen/fgets/pclose pattern in `c_header_import`'s `run_preproc_pipe`.
/// Runs at link time (after IR is emitted), so it never touches the `.ll`
/// the selfhost gate compares.
function static_llvm_link_flags(llvm_config: string) -> string {
    const cmd: string = format("%s --ldflags --libs --system-libs --link-static", llvm_config);
    const pipe: void* = intrinsics::popen(cmd, "r");
    if (pipe == null) { return ""; }

    mut out_buf: i8* = intrinsics::malloc(65536) as i8*;
    mut out_len: u64 = 0;
    mut out_cap: u64 = 65536;
    mut line_buf: i8[4096];

    while (intrinsics::fgets(&line_buf[0], 4096, pipe) != null) {
        const llen: u64 = intrinsics::strlen(&line_buf[0] as string);
        if (out_len + llen >= out_cap) {
            out_cap *= 2;
            const nb: i8* = intrinsics::malloc(out_cap) as i8*;
            intrinsics::memcpy(nb as void*, out_buf as void*, out_len);
            intrinsics::free(out_buf as void*);
            out_buf = nb;
        }
        intrinsics::memcpy((out_buf + out_len) as void*, &line_buf[0] as void*, llen);
        out_len += llen;
    }
    out_buf[out_len] = 0;
    const exit_code: i32 = intrinsics::pclose(pipe);

    if (exit_code != 0 || out_len == 0) {
        intrinsics::free(out_buf as void*);
        return "";
    }

    // llvm-config prints `--libs` and `--system-libs` on separate lines;
    // flatten every newline to a space so the result is one flat argument
    // string (libs first, then system libs - the correct static link order).
    for (mut i: u64 = 0; i < out_len; i++) {
        if (out_buf[i] == '\n' as i8 || out_buf[i] == '\r' as i8) {
            out_buf[i] = ' ' as i8;
        }
    }
    return out_buf as string;
}

// Host-shell-aware command construction
//
// The compiler shells out through libc `system(3)`, which runs `sh -c` on
// a POSIX-hosted compiler and `cmd /c` on a Windows-hosted one.  These
// helpers are gated on the COMPILER's OWN target (ConfigGating strips one
// side at build time): a Linux `cryo` keeps the POSIX forms, a native
// `cryo.exe` gets the `cmd`-compatible forms.  Without this, an executable
// link/hoist run on native Windows fails - `cmd` treats `shell_quote`'s
// single quotes as literal filename characters, has no `cp`, and does no
// glob/`2>/dev/null`.  (Cross-building a Windows target FROM Linux is
// unaffected: that link runs in `sh` on the Linux host, so the POSIX forms
// are correct there.)

/// Quote one path/argument for the active build host's shell.  POSIX:
/// `shell_quote`'s secure single-quote form.  Windows: a plain double-quote
/// wrap - `cmd` honours only double quotes, and build paths never contain
/// an embedded `"` (same assumption the archiver's response-file paths make).
![target(unix)]
function link_quote(s: string) -> string {
    return shell_quote(s);
}

![target(windows)]
function link_quote(s: string) -> string {
    return format("\"%s\"", s);
}

/// Rewrite `/` to `\` for a path handed to a `cmd` builtin (`copy`), which
/// parses a leading `/` on a token as a switch.  Drivers invoked as real
/// programs (gcc/clang) accept `/` fine, so only the `cmd`-builtin hoist
/// needs this.  Windows-only; never referenced on the POSIX side.
![target(windows)]
function to_windows_path(s: string) -> string {
    const len: u64 = intrinsics::strlen(s);
    const buf: i8* = intrinsics::malloc(len + 1) as i8*;
    const sb: i8* = s as i8*;
    for (mut i: u64 = 0; i < len; i++) {
        const ch: i8 = sb[i];
        if (ch == '/') { buf[i] = '\\' as i8; } else { buf[i] = ch; }
    }
    buf[len] = 0;
    return buf as string;
}

/// Copy the freshly-linked binary from the per-profile cache to the build
/// root.  POSIX: `cp -f`.  Windows: the `copy /Y` builtin (backslash paths,
/// stdout silenced via `>NUL`).  Returns the spawned command's exit code.
![target(unix)]
function hoist_binary(src: string, dst: string) -> i32 {
    return system(format("cp -f %s %s", shell_quote(src), shell_quote(dst)));
}

![target(windows)]
function hoist_binary(src: string, dst: string) -> i32 {
    return system(format("copy /Y \"%s\" \"%s\" >NUL",
        to_windows_path(src), to_windows_path(dst)));
}

/// Byte-wise path equality that treats `/` and `\` as the same
/// separator.  `ctx.source_file` and `discovery_root_path()` are built
/// by different code paths and can disagree on separator style on a
/// native Windows host even when they name the same file.
function paths_equal_loose(a: string, b: string) -> boolean {
    const la: i64 = intrinsics::strlen(a) as i64;
    const lb: i64 = intrinsics::strlen(b) as i64;
    if (la != lb) { return false; }
    const ab: i8* = a as i8*;
    const bb: i8* = b as i8*;
    for (mut i: i64 = 0; i < la; i++) {
        const ca: i8 = ab[i];
        const cb: i8 = bb[i];
        if (ca != cb) {
            const ca_sep: boolean = (ca == '/' || ca == '\\');
            const cb_sep: boolean = (cb == '/' || cb == '\\');
            if (!ca_sep || !cb_sep) { return false; }
        }
    }
    return true;
}

/// True when the module currently being emitted is the project's
/// discovery root (the executable entry point / library root).  Used to
/// scope `-o PATH` overrides: a single-file build is a synthesized
/// one-entry project whose stdlib imports compile as real modules, so
/// only the ENTRY module's artifact may honor the override.
function is_entry_module_active(ctx: CompilationContext*) -> boolean {
    if (ctx.project_config == null) { return false; }
    return paths_equal_loose(ctx.source_file,
        ctx.project_config.discovery_root_path());
}

/// Emit the combined `.ll` IR dump next to the hoisted exe (selfhost-check's
/// byte-identity input).  POSIX-only: it relies on shell glob expansion
/// (`/*/ir/*.ll`) and `2>/dev/null`, neither of which `cmd` provides.  On a
/// Windows-hosted compiler this is a no-op - the dump is a Linux CI aid, not
/// part of a normal build's output.
![target(unix)]
function emit_linked_ir_dump(profile_dir: string, ll_path: string) -> void {
    const ll_cmd: string = format(
        "llvm-link-20 -S %s/*/ir/*.ll -o %s 2>/dev/null",
        shell_quote(profile_dir), shell_quote(ll_path));
    const ll_rc: i32 = system(ll_cmd);
    if (ll_rc == 0) {
        cdebug("[Codegen] Linked IR dump: %s\n", ll_path);
    } else {
        cdebug("[Codegen] Warning: llvm-link-20 failed for IR dump (rc=%d)\n", ll_rc);
    }
}

![target(windows)]
function emit_linked_ir_dump(profile_dir: string, ll_path: string) -> void {
    // cmd has no glob / `2>/dev/null`; the IR dump is a POSIX selfhost-check
    // aid and is not produced on a native Windows build.
}

// Linker configuration per target

/// What the link pass needs to know about the active target's
/// toolchain: which driver binary to invoke, what to put on the system
/// library line, and whether the executable filename grows an `.exe`
/// suffix.  Built by `linker_config_for_triple` from the resolved
/// target triple so both `run_linking` and `run_linking_singlefile`
/// share one source of truth.
///
/// `use_stdlib_archive`:
///   - true  (host build): the stdlib was pre-built by `make stdlib`
///                         into `<stdlib_root>/.bin/libcryo.a` and we
///                         append it to the link line.
///   - false (cross-compile today): the host's `libcryo.a` was built
///                         for the host ABI and is incompatible with
///                         the target.  The per-build per-target stdlib
///                         object files are already in
///                         `ctx.artifacts.object_files` (cryo
///                         re-compiles every reachable std module
///                         when target != host), so no archive is
///                         needed.  Per-triple `libcryo.a` caching is
///                         future work.
///
/// `supported`:
///   - true  for triples we know how to drive end-to-end.
///   - false for triples where we still want the historic bailout
///           (object files only; user finishes the link manually).
type struct LinkerConfig {
    driver:              string;
    exe_suffix:          string;
    extra_system_libs:   string;
    use_stdlib_archive:  boolean;
    supported:           boolean;
}

/// The host-build `LinkerConfig`: what to run when the user did NOT pass
/// `--target=...` (or passed one that matches the host).  Gated on the
/// compiler's OWN target because the differences between Linux and
/// Windows host builds are not derivable from the runtime triple alone:
///
///   - exe suffix: empty on POSIX, `.exe` on Windows so the hoisted
///     binary opens correctly under cmd / Explorer.
///   - extra system libs: `-lstdc++` on POSIX (the self-hosted compiler
///     links libLLVM-20, which is C++; user programs never reference
///     C++ symbols so the flag is inert for them).  On Windows we need
///     `-lws2_32` instead: mingw does NOT auto-link Winsock the way it
///     auto-links kernel32/advapi32, so any program using `std::net`
///     would otherwise fail to link.  `-lstdc++` is omitted on Windows
///     because the compiler binary itself isn't relinked here (the
///     committed `cryo.exe` is already linked) and ordinary cryo
///     programs don't need it.
///   - the rest (`cc` driver, archive yes, supported) is identical.
![target(unix)]
function host_linker_config() -> LinkerConfig {
    return LinkerConfig {
        driver:             pick_link_driver("cc"),
        exe_suffix:         "",
        extra_system_libs:  "-lm -lstdc++",
        use_stdlib_archive: true,
        supported:          true,
    };
}

![target(windows)]
function host_linker_config() -> LinkerConfig {
    return LinkerConfig {
        driver:             pick_link_driver("cc"),
        exe_suffix:         ".exe",
        extra_system_libs:  "-lm -lws2_32",
        use_stdlib_archive: true,
        supported:          true,
    };
}

/// Pick the right toolchain for `triple`.  `triple` is the post-
/// `resolve_effective_triple` value (empty falls back to host).  Today:
///
///   - SysV-amd64 host (linux/macos): `cc -lm -lstdc++`, no suffix,
///     archive yes.  `-lstdc++` drags in LLVM-20's C++ runtime, which
///     the cryo compiler itself needs (libLLVM-20 is C++); ordinary
///     cryo programs don't reference it but the symbol set is a no-op
///     so keeping it on the host line costs nothing.
///   - x86_64 windows-gnu: `x86_64-w64-mingw32-gcc -lm`, `.exe` suffix,
///     archive no.  mingw-w64 ships its own libc/libm equivalents; no
///     C++ runtime to pull in for cross-compiled cryo programs (the
///     compiler binary itself isn't cross-compilable yet - it links
///     libLLVM, which has no Windows-gnu shim in this checkout).
///   - anything else (aarch64, riscv, windows-msvc, ...): unsupported;
///     `run_linking` falls back to the object-files-only bailout that
///     prints a manual-link hint.
function linker_config_for_triple(triple: string) -> LinkerConfig {
    // Host build: a null/empty triple, or one that matches the (coerced)
    // host triple, takes the per-host config below.  The split is
    // platform-gated because the host config diverges by OS - exe suffix
    // and which extra libs ship by default.
    if (triple == null
            || intrinsics::strlen(triple) == 0
            || intrinsics::strcmp(triple, get_default_triple()) == 0) {
        return host_linker_config();
    }
    // x86_64 windows-gnu (mingw-w64).  Substring-match the OS field so
    // every reasonable spelling (`x86_64-pc-windows-gnu`,
    // `x86_64-w64-windows-gnu`, `x86_64-windows-gnu`) routes here.
    if (strstr(triple, "windows") != null
            && strstr(triple, "gnu") != null
            && strstr(triple, "x86_64") != null) {
        return LinkerConfig {
            driver:             pick_link_driver("x86_64-w64-mingw32-gcc"),
            // `-lws2_32` for std::net (Winsock); mingw does NOT auto-link it
            // the way it does kernel32/advapi32.  It's always present on
            // Windows and tiny, so linking it unconditionally (like `-lm`)
            // costs nothing for non-net programs.
            exe_suffix:         ".exe",
            extra_system_libs:  "-lm -lws2_32",
            use_stdlib_archive: false,
            supported:          true,
        };
    }
    // Unknown triple - keep the existing object-files-only behaviour.
    return LinkerConfig {
        driver:             "",
        exe_suffix:         "",
        extra_system_libs:  "",
        use_stdlib_archive: false,
        supported:          false,
    };
}

/// Append the linker config's `.exe` suffix to a path if non-empty.
/// Keeps `ProjectConfig::profile_bin_path` / `bin_artifact_path`
/// target-agnostic; the suffix lives at the link site where the
/// LinkerConfig is in scope.
function with_exe_suffix(path: string, suffix: string) -> string {
    if (suffix == null) { return path; }
    if (intrinsics::strlen(suffix) == 0) { return path; }
    return format("%s%s", path, suffix);
}

/// Per-profile link-target path for the active target, with `.exe`
/// applied on Windows.  Wraps `ProjectConfig::profile_bin_path` so the
/// suffix logic lives in one place; `run_linking` writes to this path
/// and the incremental-build manifest in instance.cryo stats it.
function profile_bin_path_for_target(cfg: ProjectConfig*,
                                     ctx: CompilationContext*) -> string {
    const tri: string = resolve_effective_triple(ctx.target_triple);
    const lc:  LinkerConfig = linker_config_for_triple(tri);
    return with_exe_suffix(
        cfg.profile_bin_path(ctx.mode.skip_user_main()), lc.exe_suffix);
}

/// Hoisted (build-root) executable path for the active target, with
/// `.exe` applied on Windows.  Same shape as
/// `profile_bin_path_for_target` but lands the file at the user-facing
/// `<output_dir>/<name>[.exe]` instead of the per-profile cache.
function bin_artifact_path_for_target(cfg: ProjectConfig*,
                                      ctx: CompilationContext*) -> string {
    const tri: string = resolve_effective_triple(ctx.target_triple);
    const lc:  LinkerConfig = linker_config_for_triple(tri);
    return with_exe_suffix(
        cfg.bin_artifact_path(ctx.mode.skip_user_main()), lc.exe_suffix);
}


// Cascade-strip helper

/// Returns true if `name` is in the stripped-functions set.
function is_stripped(cg: CodegenContext*, name: string) -> boolean {
    if (name == null) { return false; }
    return cg.diag.is_stripped(name);
}

/// Walk a function's basic blocks and instructions; if any call instruction
/// targets a function whose mangled name is in the stripped-functions set,
/// return true.  Used by the cascade-strip pass to identify callers of
/// stripped same-module siblings (e.g. `Array<T>::quicksort` calling a
/// stripped `Array<T>::partition`).
function function_calls_stripped(cg: CodegenContext*, fn_val: void*) -> boolean {
    if (fn_val == null) { return false; }
    mut bb: void* = llvm::LLVMGetFirstBasicBlock(fn_val);
    while (bb != null) {
        mut inst: void* = llvm::LLVMGetFirstInstruction(bb);
        while (inst != null) {
            // LLVMOpcode::Call = 45 in the LLVM-C enum (verify via
            // `<llvm-c/Core.h>`, same value across LLVM 14-20).  CallBr
            // (asm goto) is 67 but doesn't appear in cryoc-generated IR.
            const op: i32 = llvm::LLVMGetInstructionOpcode(inst);
            if (op == 45) {
                // Last operand of a call instruction is the called value.
                const n: i32 = llvm::LLVMGetNumOperands(inst);
                if (n > 0) {
                    const callee: void* = llvm::LLVMGetOperand(inst, (n - 1) as u32);
                    if (callee != null) {
                        const callee_name: string = llvm::LLVMGetValueName(callee) as string;
                        if (callee_name != null && is_stripped(cg, callee_name)) {
                            return true;
                        }
                    }
                }
            }
            inst = llvm::LLVMGetNextInstruction(inst);
        }
        bb = llvm::LLVMGetNextBasicBlock(bb);
    }
    return false;
}

/// Create the per-module DWARF scaffolding when `ctx.emit_debug_info` is
/// set: a DIBuilder, a DIFile for the module's source path, a
/// DICompileUnit, and the module-level `Debug Info Version` / `Dwarf
/// Version` flags (without which the backend drops all debug metadata).
/// The handles are stashed on `ctx` for the function prologue to attach
/// per-function DISubprograms; `LLVMDIBuilderFinalize` must be called
/// before verification. No-op when debug info is off.
function setup_debug_info(ctx: CompilationContext*, module_raw: void*) -> void {
    if (!ctx.emit_debug_info) { return; }

    const dib: void* = llvm::LLVMCreateDIBuilder(module_raw);
    ctx.di_builder = dib;

    // DIFile: use the module's source path as the file name and "." as the
    // directory; debuggers join the two.
    const src: string = ctx.source_file;
    const file: void* = llvm::LLVMDIBuilderCreateFile(
        dib, src, intrinsics::strlen(src), ".", 1);
    ctx.di_file = file;

    // DICompileUnit: Lang = C (1), EmissionKind = Full (1); other flags off.
    const producer: string = "Cryo compiler";
    const cu: void* = llvm::LLVMDIBuilderCreateCompileUnit(
        dib, 1, file,
        producer, intrinsics::strlen(producer),
        0,            // isOptimized
        "", 0,        // Flags
        0,            // RuntimeVer
        "", 0,        // SplitName
        1,            // EmissionKind = Full
        0,            // DWOId
        0,            // SplitDebugInlining
        0,            // DebugInfoForProfiling
        "", 0,        // SysRoot
        "", 0);       // SDK
    ctx.di_cu = cu;

    // Module flags (behavior Warning = 1). "Debug Info Version" must be 3
    // (DEBUG_METADATA_VERSION) or LLVM silently strips the debug info.
    const ver_key: string = "Debug Info Version";
    const dver: void* = llvm::LLVMValueAsMetadata(
        llvm::LLVMConstInt(llvm::LLVMInt32Type(), 3, 0));
    llvm::LLVMAddModuleFlag(module_raw, 1, ver_key, intrinsics::strlen(ver_key), dver);
    const dwarf_key: string = "Dwarf Version";
    const dwarf: void* = llvm::LLVMValueAsMetadata(
        llvm::LLVMConstInt(llvm::LLVMInt32Type(), 4, 0));
    llvm::LLVMAddModuleFlag(module_raw, 1, dwarf_key, intrinsics::strlen(dwarf_key), dwarf);
}

/// Iterate the module's functions until no more cascade-strips happen.
/// For each function with a body that calls a stripped sibling, strip it
/// (which adds it to the stripped set, potentially triggering more
/// strips on its own callers in the next iteration).
///
/// Emits a warning per cascade strip so the user can see the chain of
/// downstream casualties from the original codegen failure.  We use a
/// warning rather than an error here because the *primary* failure is
/// already reported by `report_invalid_function_body`; cascade entries
/// are downstream noise that exists only to avoid the worse alternative
/// of a half-built body that fails LLVM verification.
function cascade_strip_dependents(cg: CodegenContext*) -> void {
    mut iterations: i32 = 0;
    while (iterations < 16) {
        mut newly_stripped: i32 = 0;
        mut fn_val: void* = llvm::LLVMGetFirstFunction(cg.llvm_module.raw);
        while (fn_val != null) {
            const next_fn: void* = llvm::LLVMGetNextFunction(fn_val);
            // Only consider functions WITH a body.
            const first_bb: void* = llvm::LLVMGetFirstBasicBlock(fn_val);
            if (first_bb != null) {
                if (function_calls_stripped(cg, fn_val)) {
                    // Don't double-strip a name that's already in the set.
                    const fn_name: string = llvm::LLVMGetValueName(fn_val) as string;
                    if (!is_stripped(cg, fn_name)) {
                        const fn_name_safe: string = if (fn_name == null) {
                            "<unnamed>"
                        } else {
                            fn_name
                        };
                        mut wdiag: Diagnostic = Diagnostic::warning(
                            ErrorCode::E0633_FUNCTION_BODY_ERROR,
                            format("codegen: function '%s' transitively stripped because it calls a previously-stripped sibling in this module; see preceding error",
                                fn_name_safe));
                        cg.diag.emit(wdiag);
                        const wrap: LValue = LValue { raw: fn_val };
                        cg.diag.strip_function_body(wrap);
                        newly_stripped += 1;
                    }
                }
            }
            fn_val = next_fn;
        }
        if (newly_stripped == 0) { break; }
        iterations += 1;
    }
}


// Codegen Pass Implementations

type struct CodegenPasses {

    /// IRGeneration pass.  Creates an LLVM module, walks the AST, and
    /// produces LLVM IR.  Stores result in ctx.artifacts.ir.
    static run_ir_generation(ctx: CompilationContext*) -> PassResult {
        // If an earlier pass (name resolution, sema, move-check, ...) already
        // reported an error, the program is ill-typed and any IR we produce is
        // unsound - e.g. a wrong-arity call lowers to an LLVM `call` with the
        // wrong operand count and trips the verifier, surfacing a confusing
        // internal-compiler-error (E0900) on top of the real source diagnostic.
        // Skip codegen entirely so the user sees only the genuine error. The
        // overall compile still fails (the pipeline's final gate is
        // `!diagnostics.has_errors()`), so no unsound binary is emitted.
        if (ctx.diagnostics.has_errors()) {
            cdebug("[Codegen] Skipping IR generation: earlier passes reported errors\n");
            return PassResult::ok();
        }
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        // Resolve module name.
        mut module_name: string = "main";
        if (ctx.namespace_str.is_valid()) {
            module_name = ctx.intern_table.resolve(ctx.namespace_str);
        }

        cdebug("[Codegen] Step 1: IR generation for module: %s\n", module_name);

        // Initialize LLVM targets (idempotent).
        cdebug("[Codegen] Step 2: Initializing LLVM targets...\n");
        init_native_target();
        cdebug("[Codegen] Step 3: LLVM targets initialized\n");

        // Create per-module codegen context on the heap to avoid stack overflow.
        // CompilationContext is already large on the stack, and CodegenContext
        // adds ~400+ bytes of arrays and maps per module.
        cdebug("[Codegen] Step 4: Creating CodegenContext...\n");
        const _box_cg: Box<CodegenContext> = Box<CodegenContext>::new(CodegenContext::new(ctx, module_name));
        const cg: CodegenContext* = _box_cg.leak();
        // Two-phase init step 2: wire back-pointers on sub-components now
        // that `cg` is at its stable heap address.  Wiring before the move
        // into the Box would leave back-pointers dangling at the source.
        cg.wire();
        cdebug("[Codegen] Step 5: CodegenContext created\n");

        // Set target triple and data layout.  Honor a project-level
        // override (cryoconfig `target = "..."` or CLI `--target=TRIPLE`)
        // when one is set; otherwise fall back to the host triple from
        // LLVM.  The resolved triple is also fed to the target machine
        // below so the data-layout string matches.
        cdebug("[Codegen] Step 6: Setting target triple...\n");
        const triple: string = resolve_effective_triple(ctx.target_triple);
        cg.llvm_module.set_target_triple(triple);
        cdebug("[Codegen] Step 7: Target triple set: %s\n", triple);

        cdebug("[Codegen] Step 8: Creating target machine...\n");
        mut tm: LTargetMachine = create_target_machine_for_triple(triple);
        if (tm.is_valid()) {
            const layout: string = tm.get_data_layout_string();
            cg.llvm_module.set_data_layout(layout);
        }
        cdebug("[Codegen] Step 9: Target machine ready\n");

        // DWARF debug-info scaffolding (no-op unless `-g`/--debug-info).
        // Must run before function-body emission so each prologue can
        // attach a DISubprogram + source location to its function.
        setup_debug_info(ctx, cg.llvm_module.raw);

        // Cross-module externs are declared lazily by `resolve_function` /
        // `resolve_function_with_arity` / `resolve_global` on first reference
        // from this module, avoiding the O(modules x funcs x overloads) bulk
        // pre-declaration loop that used to run here.

        // Emit the inline runtime helpers (`format`, `panic`, etc.) into
        // this module with linkonce_odr linkage.  Idempotent and
        // per-module; the linker collapses the 100+ copies down to one.
        cg.intrinsics.emit_format_runtime();
        cg.intrinsics.emit_panic_runtime();

        // Create the visitor and generate IR.  Heap-allocate via Box::leak
        // so sub-emitters can hold stable `state: VisitorState*` back-pointers
        // into `gen.state`; same two-phase pattern as `CodegenContext` above.
        cdebug("[Codegen] Step 12: Creating IRGeneratorVisitor...\n");
        const _box_gen: Box<IRGeneratorVisitor> = Box<IRGeneratorVisitor>::new(IRGeneratorVisitor(cg));
        const gen: IRGeneratorVisitor* = _box_gen.leak();
        // Two-phase init step 2: wire back-pointers on sub-emitters now
        // that `gen` is at its stable heap address.  No-op while the
        // visitor's sub-emitter set is empty; the call site is in place
        // for incremental extraction.
        gen.wire();
        cdebug("[Codegen] Step 13: Getting program AST...\n");
        const program: ProgramNode* = ctx.artifacts.ast.program();
        cdebug("[Codegen] Step 14: Generating program IR (program=%p)...\n", program as void*);
        const success: boolean = gen.generate_program(program);
        mut step15_status: string = "failed";
        if (success) { step15_status = "succeeded"; }
        cdebug("[Codegen] Step 15: Program IR generation %s\n", step15_status);
        fflush(null);

        if (!success) {
            if (ctx.debug_mode) {
                cdebug("[Codegen] IR generation failed for module: %s\n", module_name);
            }
            cg.dispose_builder();
            tm.dispose();
            return PassResult::from_snapshot(ctx.diagnostics, snap);
        }

        // Cascade-strip: a method body that fails codegen (e.g.
        // `Array<T>::partition` with a non-numeric T whose `T < T` doesn't
        // lower) gets stripped to a `declare`-only.  But other methods in
        // the same impl block (e.g. `Array<T>::quicksort` which calls
        // `partition`, and `Array<T>::sort` which calls `quicksort`)
        // already emitted their bodies with a call to the now-empty
        // partition.  At link time, that call is an undefined reference.
        //
        // Walk all defined functions; for each that still has a body but
        // calls a same-module declare (a stripped sibling), strip it too.
        // Iterate until the strip set stabilizes.  Functions that were
        // intentionally cross-module externs are unaffected because the
        // strip set only contains symbols whose body was attempted in
        // this module.
        cascade_strip_dependents(cg);

        // Finalize debug info: wires every DISubprogram into the compile
        // unit and resolves temporary metadata. Must run before
        // LLVMVerifyModule, which checks debug-info well-formedness.
        if (ctx.di_builder != null) {
            llvm::LLVMDIBuilderFinalize(ctx.di_builder);
        }

        // Pre-verify: scan all functions for corrupt types before calling
        // LLVMVerifyModule (which crashes on null function types).
        mut has_corrupt: boolean = false;
        {
            mut fn_val: void* = llvm::LLVMGetFirstFunction(cg.llvm_module.raw);
            while (fn_val != null) {
                const fn_ty: void* = llvm::LLVMGlobalGetValueType(fn_val);
                if (fn_ty == null) {
                    const fn_name: string = llvm::LLVMGetValueName(fn_val) as string;
                    cdebug("[Codegen] CORRUPT: function '%s' has null type in module %s\n",
                           fn_name, module_name);
                    has_corrupt = true;
                } else {
                    const ret_ty: void* = llvm::LLVMGetReturnType(fn_ty);
                    if (ret_ty == null) {
                        const fn_name: string = llvm::LLVMGetValueName(fn_val) as string;
                        cdebug("[Codegen] CORRUPT: function '%s' has null return type in module %s\n",
                               fn_name, module_name);
                        has_corrupt = true;
                    }
                    const param_count: u32 = llvm::LLVMCountParamTypes(fn_ty);
                    if (param_count > 0) {
                        const param_buf: void* = intrinsics::malloc(param_count as u64 * 8);
                        llvm::LLVMGetParamTypes(fn_ty, param_buf);
                        const slots: void** = param_buf as void**;
                        for (mut pi: u32 = 0; pi < param_count; pi++) {
                            if (slots[pi] == null) {
                                const fn_name: string = llvm::LLVMGetValueName(fn_val) as string;
                                cdebug("[Codegen] CORRUPT: function '%s' param %u is null type in module %s\n",
                                       fn_name, pi, module_name);
                                has_corrupt = true;
                            }
                        }
                        intrinsics::free(param_buf);
                    }
                }
                fn_val = llvm::LLVMGetNextFunction(fn_val);
            }
        }

        // Dump .ll BEFORE verification so failing modules are inspectable.
        if (ctx.debug_mode) {
            const mn_len: u64 = intrinsics::strlen(module_name);
            const mn_buf: void* = intrinsics::malloc(mn_len + 1);
            intrinsics::memcpy(mn_buf, module_name as void*, mn_len);
            const mn_bytes: i8* = mn_buf as i8*;
            for (mut si: u64 = 0; si < mn_len; si++) {
                if (mn_bytes[si] == 58) { mn_bytes[si] = 95; }
            }
            mn_bytes[mn_len] = 0;
            // Per-module IR lands under the per-profile cache, grouped by
            // origin (`<output_dir>/target/<profile>/<origin>/ir`); honour
            // project_config so `--build-dir=...` and the active profile both
            // flow through.
            mut ll_dir: string = "build/target/release/local/ir";
            if (ctx.project_config != null) {
                ll_dir = ctx.project_config.ir_dir_for(
                    CodegenPasses::current_origin_subdir(ctx));
            }
            ProjectConfig::mkdir_p(ll_dir);
            const ll_path: string = format("%s/%s.ll", ll_dir, mn_buf as string);
            mut ll_err: i8* = null;
            llvm::LLVMPrintModuleToFile(cg.llvm_module.raw, ll_path, &ll_err as void*);
            if (ll_err != null) { llvm::LLVMDisposeMessage(ll_err as void*); }
            intrinsics::free(mn_buf);
        }

        if (has_corrupt) {
            cdebug("[Codegen] Skipping verification for %s due to corrupt function types\n", module_name);
        } else {
            // Verify the LLVM module.
            mut verify_err: i8* = null;
            const verify_result: i32 = llvm::LLVMVerifyModule(cg.llvm_module.raw, 2, &verify_err as void*);
            if (verify_result != 0) {
                // Print verifier output directly so the user can see which
                // module / function the verifier choked on. Then emit a
                // single short diagnostic; the previous code attached the
                // multi-KB verifier text to a Diagnostic.with_note(), and
                // that string ended up sharing memory across diagnostics
                // in a way that segfaulted the deferred flush in stdlib
                // builds with several verify failures.
                mut diag: Diagnostic = Diagnostic::error(
                    ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    format("LLVM module verification failed for %s", module_name));
                if (verify_err != null) {
                    const max_len: u64 = 2048;
                    const err_len: u64 = intrinsics::strlen(verify_err as string);
                    mut note_body: string = verify_err as string;
                    if (err_len > max_len) {
                        const trunc_buf: i8* = intrinsics::malloc(max_len + 1) as i8*;
                        intrinsics::memcpy(trunc_buf as void*, verify_err as void*, max_len);
                        trunc_buf[max_len] = 0;
                        note_body = trunc_buf as string;
                    }
                    diag = diag.with_note("LLVM reports: " + note_body);
                    if (err_len > max_len) {
                        diag = diag.with_note("(LLVM error truncated)");
                    }
                }
                ctx.diagnostics.emit(diag);
                if (verify_err != null) {
                    llvm::LLVMDisposeMessage(verify_err as void*);
                }
                cg.dispose_builder();
                tm.dispose();
                return PassResult::failure(1);
            }
            if (verify_err != null) {
                llvm::LLVMDisposeMessage(verify_err as void*);
            }
        }

        if (ctx.debug_mode) {
            cdebug("[Codegen] Module verified: %s\n", module_name);
        }

        // Store the LLVM module in artifacts.  The module is now owned by
        // artifacts; do NOT dispose it here.
        ctx.artifacts.ir = IROutput {
            llvm_module: cg.llvm_module.raw,
            module_name: module_name,
        };

        cg.dispose_builder();
        tm.dispose();

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }


    /// Optimization pass.  Runs LLVM's new pass manager on the module.
    static run_optimization(ctx: CompilationContext*) -> PassResult {
        if (!ctx.artifacts.ir.is_valid()) {
            return PassResult::ok();
        }

        if (ctx.debug_mode) {
            cdebug("[Codegen] Optimization for module: %s (O%u)\n",
                ctx.artifacts.ir.module_name, ctx.opt_level);
        }

        // O0: skip the IR optimization pipeline entirely. This leaves the
        // generated allocas / loads / stores intact (no mem2reg, no
        // inlining, no folding) so an O0 build stays debuggable and maps
        // cleanly back to source. The backend TargetMachine level below
        // still governs instruction selection / register allocation.
        if (ctx.opt_level == 0) {
            if (ctx.debug_mode) {
                cdebug("[Codegen] O0: skipping IR optimization pipeline\n");
            }
            return PassResult::ok();
        }

        const opt_triple: string = resolve_effective_triple(ctx.target_triple);
        mut tm: LTargetMachine = create_target_machine_with_opt(
            opt_triple, ctx.opt_level as i32);
        if (!tm.is_valid()) {
            return PassResult::ok();
        }

        // Run the default optimization pipeline at the configured level.
        const opts: void* = llvm::LLVMCreatePassBuilderOptions();
        const passes: string = format("default<O%u>", ctx.opt_level);
        const result: i32 = llvm::LLVMRunPasses(
            ctx.artifacts.ir.llvm_module, passes, tm.raw, opts);
        llvm::LLVMDisposePassBuilderOptions(opts);

        if (result != 0) {
            tm.dispose();
            ctx.emit_error(ErrorCode::E0605_OPTIMIZATION_FAILED,
                format("LLVM optimization pipeline failed for module '%s' (error code %d)",
                    ctx.artifacts.ir.module_name, result));
            return PassResult::failure(1);
        }

        // Re-verify after optimization.  Optimization passes can introduce
        // verifier failures (malformed intrinsics, dropped metadata, etc.)
        // and we'd rather fail here than ship a broken object file.
        mut verify_err: i8* = null;
        const verify_rc: i32 = llvm::LLVMVerifyModule(
            ctx.artifacts.ir.llvm_module, 2, &verify_err as void*);
        tm.dispose();
        if (verify_rc != 0) {
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0605_OPTIMIZATION_FAILED,
                format("LLVM module verification failed after optimization for '%s'",
                    ctx.artifacts.ir.module_name));
            if (verify_err != null) {
                const max_len: u64 = 2048;
                const err_len: u64 = intrinsics::strlen(verify_err as string);
                mut note_body: string = verify_err as string;
                if (err_len > max_len) {
                    const trunc_buf: i8* = intrinsics::malloc(max_len + 1) as i8*;
                    intrinsics::memcpy(trunc_buf as void*, verify_err as void*, max_len);
                    trunc_buf[max_len] = 0;
                    note_body = trunc_buf as string;
                }
                diag = diag.with_note("LLVM reports: " + note_body);
                llvm::LLVMDisposeMessage(verify_err as void*);
            }
            ctx.diagnostics.emit(diag);
            return PassResult::failure(1);
        }
        if (verify_err != null) { llvm::LLVMDisposeMessage(verify_err as void*); }

        return PassResult::ok();
    }


    /// ObjectEmission pass.  Emits a per-module artifact from the LLVM
    /// module.  Kind selection:
    ///   - No `-o` override        -> per-origin `target/<profile>/<origin>/deps/<mod>.o`
    ///   - `-o foo.o`  / Object    -> emit object to the override path
    ///   - `-o foo.s`  / Asm       -> emit assembly to the override path
    ///   - `-o foo.ll` / IRText    -> dump module text to the override path
    ///   - `-o foo`    / Exe       -> emit object to the legacy path; the
    ///                                Linking pass picks it up and shells
    ///                                out to `cc` to produce the final
    ///                                executable at the override path.
    static run_object_emission(ctx: CompilationContext*) -> PassResult {
        if (!ctx.artifacts.ir.is_valid()) {
            return PassResult::ok();
        }

        // In project mode the `-o PATH` override applies to the ENTRY
        // module only.  A single-file build is a synthesized one-entry
        // project whose stdlib imports compile as real modules; without
        // this gate every std module would in turn overwrite the user's
        // `-o foo.o`.  Non-entry modules behave as if no override were
        // given (per-origin deps layout).
        mut kind: OutputKind = ctx.output_kind;
        if (ctx.project_config != null && !is_entry_module_active(ctx)) {
            kind = OutputKind::None;
        }

        // IRText is the only kind that doesn't go through LLVM's
        // target-machine emit path; it's a pure text dump of the
        // module IR, no codegen needed.  Handle first to avoid
        // creating a target machine we won't use.
        match (kind) {
            OutputKind::IRText => {
                return CodegenPasses::emit_ir_text(ctx, ctx.output_path_override);
            }
            _ => { /* fall through */ }
        }

        // Resolve the effective triple here too; the object format
        // (ELF / COFF / Mach-O) is selected by the target machine, so
        // a stale host machine here would silently undo the cross-
        // compile we set up in IR generation.
        const obj_triple: string = resolve_effective_triple(ctx.target_triple);
        mut tm: LTargetMachine = create_target_machine_with_opt(
            obj_triple, ctx.opt_level as i32);
        if (!tm.is_valid()) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "failed to create target machine for object emission");
            return PassResult::failure(1);
        }

        // Decide the emit path + LLVM file_type.  Asm and Object kinds
        // route directly to the user's override.  Exe and the no-override
        // case route to the per-origin `target/<profile>/<origin>/deps/<mod>.o`
        // layout so the Linking pass has a stable per-module input set.
        mut emit_path: string = "";
        mut emit_type: LFileType = LFileType::Object;
        match (kind) {
            OutputKind::Asm => {
                emit_path = ctx.output_path_override;
                emit_type = LFileType::Assembly;
            }
            OutputKind::Object => {
                emit_path = ctx.output_path_override;
                emit_type = LFileType::Object;
            }
            _ => {
                emit_path = CodegenPasses::legacy_obj_path(ctx);
                emit_type = LFileType::Object;
            }
        }

        const mod: LModule = LModule { raw: ctx.artifacts.ir.llvm_module };
        const success: boolean = tm.emit_to_file(mod, emit_path, emit_type);
        tm.dispose();

        if (!success) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("failed to emit %s",
                    match (kind) {
                        OutputKind::Asm => { format("assembly file: %s", emit_path) }
                        _               => { format("object file: %s", emit_path) }
                    }));
            return PassResult::failure(1);
        }

        // Store the object file path.
        // NOTE: Deep nested struct field assignment
        // (`ctx.artifacts.linked.object_file_path = ...`) has historically
        // been a source of codegen bugs through multi-deref chains. Assign
        // a full `LinkedOutput` replacement instead.
        ctx.artifacts.linked = LinkedOutput { object_file_path: emit_path };

        // Accumulate every module's object path so the linker pass can
        // invoke `cc` once over all of them at the end of Phase 7.
        // Route through `register_object_file`; directly calling
        // `.push()` on a multi-deref field chain has historically landed
        // on a temp copy (push-through-pointer codegen limitation).
        //
        // Skip registration for Asm/Object/IRText: those kinds emit a
        // user-facing artifact (assembly text, object, IR text) that
        // is NOT something `cc` should re-link.  Registering an .s/.ll
        // here would feed it back into run_linking and corrupt the
        // link command.  The legacy path and Exe kind both want the
        // .o registered: Exe so the link step picks it up, legacy so
        // multi-module project builds aggregate it.
        match (kind) {
            OutputKind::Asm    => { /* no register */ }
            OutputKind::Object => { /* no register */ }
            OutputKind::IRText => { /* unreachable: handled above */ }
            _ => {
                ctx.artifacts.register_object_file(emit_path);
            }
        }

        if (ctx.debug_mode) {
            cdebug("[Codegen] Emitted: %s\n", emit_path);
        }

        return PassResult::ok();
    }

    /// Origin output subdir (`"std"`, `"local"`, or `<depname>`) for the
    /// module currently being codegen'd, looked up by its source path.
    /// Falls back to `"local"` for single-file builds / when the module
    /// isn't in the graph.
    static current_origin_subdir(ctx: CompilationContext*) -> string {
        if (ctx.module_graph == null) { return "local"; }
        const idx: i64 = ctx.module_graph.find_module_by_path(ctx.source_file);
        if (idx < 0) { return "local"; }
        const mi: ModuleInfo* = &ctx.module_graph.modules[idx];
        return ModuleInfo::origin_subdir(mi.origin, mi.origin_name);
    }

    /// Build the per-module object path:
    /// `<output_dir>/target/<profile>/<origin>/deps/<safe_module>.o`.
    /// Used when no `-o PATH` override is in effect, and for the per-module
    /// object that feeds the Exe link step in single-file mode.
    static legacy_obj_path(ctx: CompilationContext*) -> string {
        mut output_dir: string = "build/target/release/local/deps";
        if (ctx.project_config != null) {
            output_dir = ctx.project_config.deps_dir_for(
                CodegenPasses::current_origin_subdir(ctx));
        }
        // mkdir_p creates every missing level (`target`, `<profile>`,
        // `<origin>`, `deps`, and any custom `--build-dir=...` prefix); a bare
        // `mkdir` would fail on the nested path and object emission would
        // error with "No such file or directory".
        ProjectConfig::mkdir_p(output_dir);

        // Mangle module name: replace "::" with "_" for filesystem safety.
        mut safe_name: string = ctx.artifacts.ir.module_name;
        const name_len: u64 = intrinsics::strlen(safe_name);
        const name_buf: i8* = intrinsics::malloc(name_len + 1) as i8*;
        intrinsics::memcpy(name_buf as void*, safe_name as void*, name_len);
        name_buf[name_len] = 0;
        for (mut k: u64 = 0; k < name_len; k++) {
            if (name_buf[k] == ':') { name_buf[k] = '_'; }
        }
        safe_name = name_buf as string;
        return format("%s/%s.o", output_dir, safe_name);
    }

    /// Dump the LLVM module to a `.ll` text file at `path`.  Skips the
    /// target machine entirely; IR text is target-independent and the
    /// only failure mode is filesystem (permissions, missing parent).
    static emit_ir_text(ctx: CompilationContext*, path: string) -> PassResult {
        const mod_ref: void* = ctx.artifacts.ir.llvm_module;
        mut err: i8* = null;
        const rc: i32 = llvm::LLVMPrintModuleToFile(mod_ref, path, &err as void*);
        if (rc != 0) {
            const note: string = if (err != null) { err as string } else { "(no detail)" };
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("failed to write IR text to %s: %s", path, note));
            if (err != null) { llvm::LLVMDisposeMessage(err as void*); }
            return PassResult::failure(1);
        }
        if (err != null) { llvm::LLVMDisposeMessage(err as void*); }
        ctx.artifacts.linked = LinkedOutput { object_file_path: path };
        if (ctx.debug_mode) {
            cdebug("[Codegen] Emitted IR text: %s\n", path);
        }
        return PassResult::ok();
    }


    /// Linking pass.  Invokes the system linker (`cc`) to combine all
    /// per-module object files emitted during Phase 7 into the final
    /// executable at `{output_dir}/{project_name}` (build root).  Pulls link
    /// libs/paths from the parsed cryoconfig, and tacks on the stdlib
    /// archive whenever `no_std` is not set.
    static run_linking(ctx: CompilationContext*) -> PassResult {
        if (ctx.artifacts.object_files.length == 0) {
            // Nothing to link: library/stdlib batch build, or codegen
            // was disabled (LSP mode).  Not an error.
            return PassResult::ok();
        }
        if (ctx.project_config == null) {
            // Raw mode (`cryo raw`): only Exe needs linking.  Asm /
            // Object / IRText emit their final artifact straight from
            // object emission; Default (no `-o`) leaves the .o behind
            // without linking, matching the historic behaviour.
            return match (ctx.output_kind) {
                OutputKind::Exe => { CodegenPasses::run_linking_singlefile(ctx) }
                _               => { PassResult::ok() }
            };
        }
        // `-o foo.o` / `foo.s` / `foo.ll` on a single-file build: the
        // entry module's artifact was already written by ObjectEmission
        // directly to the override path; there is no executable to link.
        match (ctx.output_kind) {
            OutputKind::Object => { return PassResult::ok(); }
            OutputKind::Asm    => { return PassResult::ok(); }
            OutputKind::IRText => { return PassResult::ok(); }
            _                  => { /* None / Exe: link normally */ }
        }
        if (!ctx.project_config.requires_entry_point()) {
            // Library / stdlib target: no executable to produce, but
            // bundle the per-module .o files into a single archive that
            // executable projects can pick up via `<root>/<output>/lib<name>.a`.
            // The stdlib target writes `stdlib/.bin/libcryo.a` (canonical
            // path the executable-link path below looks for).
            return CodegenPasses::bundle_archive(ctx);
        }

        const cfg: ProjectConfig* = ctx.project_config;
        const output_dir: string = cfg.output_dir;

        // Resolve the toolchain for the effective triple.  For host
        // builds (empty triple, or triple == host) this picks `cc` plus
        // the historic `-lm -lstdc++` line and tells us to append
        // `libcryo.a`.  For x86_64 windows-gnu it picks the mingw-w64
        // driver and tells us NOT to append `libcryo.a` (the per-build
        // stdlib .o files are already on the link line; the host
        // archive would be ABI-incompatible).  For triples we don't
        // know how to drive end-to-end (aarch64, riscv, windows-msvc,
        // ...) `supported` is false and we keep the historic
        // object-files-only bailout below.
        const effective_triple: string = resolve_effective_triple(ctx.target_triple);
        const link_cfg: LinkerConfig = linker_config_for_triple(effective_triple);

        if (!link_cfg.supported) {
            const obj_only_dir: string = cfg.profile_dir();
            fmt::println(f"Cross-compile: produced {ctx.artifacts.object_files.length} object file(s) for target '{ctx.target_triple}' in {obj_only_dir}");
            fmt::println(f"  (host linker skipped; link with a {ctx.target_triple}-aware toolchain, e.g.:");
            fmt::println(f"     clang --target={ctx.target_triple} {obj_only_dir}/*/deps/*.o -o <output>)");
            return PassResult::ok();
        }

        // The executable is linked under the per-profile cache
        // (`<output_dir>/target/<profile>/<name>[.exe]`) and HOISTED to
        // the build root afterwards; ensure the per-profile dir exists
        // for custom `--build-dir=...` paths that haven't been
        // pre-created.
        const profile_dir: string = cfg.profile_dir();
        ProjectConfig::mkdir_p(profile_dir);
        // Test-mode builds use a `-test` suffix so the test executable
        // coexists with a normal `cryo run` build of the same project.
        // The `.exe` suffix (Windows targets) goes on top of `-test` so
        // a windows test binary is `<name>-test.exe`.  Routed through
        // `profile_bin_path_for_target` so the same suffix logic the
        // incremental-build manifest uses applies here.
        const exe_path: string = profile_bin_path_for_target(cfg, ctx);

        // Build the link command.  libc's system(3) runs `sh -c`, so
        // every interpolated path must be shell-quoted; without it, a
        // working directory with a space breaks the link, and a path
        // containing shell metacharacters is a command-injection hazard.
        //
        // The object list goes in an @response-file rather than inline on
        // the command line, for the SAME reason `bundle_archive` does it:
        // a real project (the self-hosted compiler itself is ~520 objects)
        // blows straight past `cmd /c`'s ~8191-char command-line cap on a
        // native Windows host, where `system(3)` routes through cmd — the
        // historic "The command line is too long." native self-host link
        // failure.  gcc / clang / cc all accept `@file` with one
        // whitespace- or newline-separated, optionally double-quoted entry
        // per object; the `@"%s"` spelling (literal double quotes, not
        // `shell_quote`'s single quotes) matches the archiver precedent so
        // it parses identically under `sh -c` and `cmd /c`.  Same objects,
        // same order, same libs => a byte-identical executable on every
        // host, so selfhost byte-identity is unaffected.
        const link_rsp_path: string = format("%s.rsp", exe_path);
        const link_rf: void* = intrinsics::fopen(link_rsp_path, "w");
        if (link_rf == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("could not open linker response file for writing: %s", link_rsp_path));
            return PassResult::failure(1);
        }
        for (mut i: i64 = 0; i < ctx.artifacts.object_files.length; i++) {
            intrinsics::fprintf(link_rf, "\"%s\"\n", ctx.artifacts.object_files[i]);
        }
        intrinsics::fclose(link_rf);

        mut cmd: string = format("%s -o %s @\"%s\"",
            link_cfg.driver, link_quote(exe_path), link_rsp_path);
        // Project-configured linking ([link] in cryoconfig).  -L and -l are
        // single-token args with the value glued to the flag, so the
        // quoting goes around the value only.  `search` -> -L (extra dirs for
        // resolving `system` libs), `system` -> -l, `static` -> the archive
        // path passed to the linker verbatim.
        for (mut i: i64 = 0; i < cfg.link_search.length; i++) {
            cmd = format("%s -L%s", cmd, link_quote(cfg.link_search[i]));
        }
        for (mut i: i64 = 0; i < cfg.link_system.length; i++) {
            cmd = format("%s -l%s", cmd, link_quote(cfg.link_system[i]));
        }
        for (mut i: i64 = 0; i < cfg.link_static.length; i++) {
            cmd = format("%s %s", cmd, link_quote(cfg.link_static[i]));
        }
        // Per-OS overlay ([link.unix] / [link.windows]).  Appended after
        // the common set, so a project can carry platform-divergent libs
        // (e.g. the windows-gnu LLVM import lib + its lib dir vs the host's
        // `-lLLVM-20` under /usr/lib/llvm-20/lib) without the wrong set
        // leaking into a cross-compile.  The OS is read off the effective
        // triple; anything that isn't windows is treated as unix (the host
        // line and every other supported triple today).  Same flag shapes
        // as the common loops above: search -> -L, system -> -l, static
        // -> verbatim path.
        if (strstr(effective_triple, "windows") != null) {
            for (mut i: i64 = 0; i < cfg.link_search_windows.length; i++) {
                cmd = format("%s -L%s", cmd, link_quote(cfg.link_search_windows[i]));
            }
            for (mut i: i64 = 0; i < cfg.link_system_windows.length; i++) {
                cmd = format("%s -l%s", cmd, link_quote(cfg.link_system_windows[i]));
            }
            for (mut i: i64 = 0; i < cfg.link_static_windows.length; i++) {
                cmd = format("%s %s", cmd, link_quote(cfg.link_static_windows[i]));
            }
        } else {
            // The `[link.unix]` overlay carries the host libLLVM (`-lLLVM-20`
            // + its `-L/usr/lib/llvm-20/lib` search dir).  On a
            // `--release-static` build we replace that dynamic LLVM with the
            // static `.a` component set from llvm-config (spliced in below),
            // so skip the overlay's search/system entries here.  `[link.unix]`
            // is LLVM-only today; if it ever grows non-LLVM libs, switch this
            // to value-filtering "LLVM-20" rather than skipping the overlay.
            if (!ctx.release_static) {
                for (mut i: i64 = 0; i < cfg.link_search_unix.length; i++) {
                    cmd = format("%s -L%s", cmd, link_quote(cfg.link_search_unix[i]));
                }
                for (mut i: i64 = 0; i < cfg.link_system_unix.length; i++) {
                    cmd = format("%s -l%s", cmd, link_quote(cfg.link_system_unix[i]));
                }
            }
            for (mut i: i64 = 0; i < cfg.link_static_unix.length; i++) {
                cmd = format("%s %s", cmd, link_quote(cfg.link_static_unix[i]));
            }
        }
        // `--release-static`: splice the static libLLVM component set
        // (`-L<libdir> -lLLVMCore ... -lrt -ldl -lm -lz -lzstd -lxml2`) from
        // llvm-config in place of the dynamic `-lLLVM-20` skipped above.
        // Placed before the stdlib archive + system libs so the single-pass
        // static link order is objects -> LLVM -> libcryo.a -> libm/libstdc++.
        if (ctx.release_static) {
            const llvm_static: string = static_llvm_link_flags(pick_llvm_config());
            if (intrinsics::strlen(llvm_static) == 0) {
                ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    "could not obtain static LLVM link flags from llvm-config (is it installed? set CRYO_LLVM_CONFIG)");
                return PassResult::failure(1);
            }
            cmd = format("%s %s", cmd, llvm_static);
        }
        // Stdlib archive: the stdlib build emits `<stdlib_root>/.bin/libcryo.a`
        // (see bundle_archive); pull it in for host builds unless the
        // project opted out via `no_std`.  Cross-compile builds don't
        // append the archive - it's ABI-incompatible with the target
        // and the per-target stdlib .o files are already in the link
        // line (cryo re-compiles every reachable std module when
        // target != host).
        if (link_cfg.use_stdlib_archive && !cfg.no_std
                && intrinsics::strlen(ctx.stdlib_root) > 0) {
            const stdlib_archive: string = format("%s/.bin/libcryo.a",
                ctx.stdlib_root);
            cmd = format("%s %s", cmd, link_quote(stdlib_archive));
        }
        // Cryo runtime support is fully inline-lowered: every bare-name
        // intrinsic (i32_to_i64, ptr_add, format, bswap*, clz*, isfinite,
        // atomic_fence, dirent_*) is emitted directly into LLVM IR by
        // IntrinsicsCodegen.  No C runtime to link beyond what the
        // active target's system library line provides.
        cmd = format("%s %s", cmd, link_cfg.extra_system_libs);

        // `--release-static`: statically link libc (`-static`) and the C++
        // runtime (`-static-libstdc++ -static-libgcc`) so the produced binary
        // has no `libLLVM-20.so`/`libstdc++.so` runtime dependency.  These are
        // position-independent driver flags, so trailing placement is safe;
        // `-static-libstdc++` makes the earlier `-lstdc++` resolve to the
        // archive.  Linux host only (this branch is the unix link path).
        if (ctx.release_static) {
            cmd = format("%s -static -static-libstdc++ -static-libgcc", cmd);
        }

        if (ctx.debug_mode) {
            cdebug("[Codegen] Linking %lld objects -> %s\n",
                ctx.artifacts.object_files.length, exe_path);
            cdebug("[Codegen] Link command: %s\n", cmd);
        }

        const rc: i32 = system(cmd);
        // The response file has served its purpose; remove it so it doesn't
        // linger in the per-profile dir (best-effort - a failed unlink is
        // harmless).
        intrinsics::unlink(link_rsp_path);
        if (rc != 0) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("linker invocation failed (%s exited with %d): %s",
                    link_cfg.driver, rc, cmd));
            return PassResult::failure(1);
        }

        cdebug("[Codegen] Linked executable: %s\n", exe_path);

        // Hoist the freshly-linked binary from the per-profile cache up to
        // the build root (`<output_dir>/<name>[.exe]`) so it can be run
        // as `build/<name>[.exe]` regardless of which profile produced
        // it.  libc's system(3) runs `sh -c`, so both paths are
        // shell-quoted.
        const hoisted_exe: string = bin_artifact_path_for_target(cfg, ctx);
        ProjectConfig::mkdir_p(output_dir);
        // `hoist_binary` is host-shell-aware: `cp -f` on a POSIX-hosted
        // compiler, `copy /Y` (backslash paths) on a native Windows one.
        const hrc: i32 = hoist_binary(exe_path, hoisted_exe);
        if (hrc != 0) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("failed to hoist executable to %s (copy exited with %d)",
                    hoisted_exe, hrc));
            return PassResult::failure(1);
        }
        cdebug("[Codegen] Hoisted executable: %s\n", hoisted_exe);

        // Single-file `-o PATH` (Exe): mirror the hoisted binary to the
        // user's explicit output path.  The path is taken verbatim - no
        // `.exe` auto-append - since `-o` is explicit user intent.
        const exe_override: boolean = match (ctx.output_kind) {
            OutputKind::Exe => { true }
            _               => { false }
        };
        if (exe_override && intrinsics::strlen(ctx.output_path_override) > 0) {
            const orc: i32 = hoist_binary(hoisted_exe, ctx.output_path_override);
            if (orc != 0) {
                ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    format("failed to copy executable to %s (copy exited with %d)",
                        ctx.output_path_override, orc));
                return PassResult::failure(1);
            }
            cdebug("[Codegen] Mirrored executable to -o path: %s\n",
                ctx.output_path_override);
        }

        // Emit a combined `.ll` text dump of the project's per-module IR
        // (written during Phase 7) next to the HOISTED executable
        // (`<output_dir>/<name>.ll`).  Used by selfhost-check for
        // stage-3/stage-4 byte-identity verification.  Per-module IR is split
        // across per-origin subtrees, so the glob spans every origin's `ir/`
        // dir; the shell sorts the full expansion deterministically, so the
        // concatenation order is stable across builds.  Stderr is redirected
        // to /dev/null so `llvm-link-20`'s "No such file or directory"
        // complaint (when no .ll files were written because emit_llvm was
        // unset) doesn't pollute the user's terminal in the silent default.
        const ll_path: string = format("%s.ll", hoisted_exe);
        // POSIX-only (shell glob + `2>/dev/null`); a no-op on a native
        // Windows-hosted compiler, where `cmd` provides neither.
        emit_linked_ir_dump(profile_dir, ll_path);

        return PassResult::ok();
    }


    /// Single-file `-o PATH` Exe link.  Mirrors the project link path
    /// minus the cryoconfig-driven extras: there are no `[link]` paths,
    /// no test-suffix logic, and no llvm-link IR dump.  The stdlib
    /// archive is still pulled in for host builds when `ctx.stdlib_root`
    /// was resolved - without it most non-trivial programs would fail to
    /// link.  Cross-compile builds skip the archive (same reasoning as
    /// the project link path).  The user-supplied `exe_path` is taken
    /// verbatim: we do NOT auto-append `.exe` for Windows targets,
    /// since `-o` is explicit user intent.
    static run_linking_singlefile(ctx: CompilationContext*) -> PassResult {
        const exe_path: string = ctx.output_path_override;
        if (intrinsics::strlen(exe_path) == 0) {
            // Defensive: run_linking only routes here when output_kind
            // is Exe, which the CLI sets alongside output_path_override.
            return PassResult::ok();
        }

        const effective_triple: string = resolve_effective_triple(ctx.target_triple);
        const link_cfg: LinkerConfig = linker_config_for_triple(effective_triple);
        if (!link_cfg.supported) {
            // Unknown triple - same fallback as the project path.
            fmt::println(f"Cross-compile: produced {ctx.artifacts.object_files.length} object file(s) for target '{ctx.target_triple}'");
            fmt::println(f"  (host linker skipped; link with a {ctx.target_triple}-aware toolchain)");
            return PassResult::ok();
        }

        // Object list via an @response-file, same as the project link path
        // and `bundle_archive`: a large single-file program can still blow
        // past `cmd /c`'s ~8191-char command-line cap on a native Windows
        // host (where `system(3)` routes through cmd), and `@file` keeps the
        // spawned command short and byte-identical on every host.  `@"%s"`
        // (literal double quotes) parses the same under `sh -c` and `cmd /c`.
        const link_rsp_path: string = format("%s.rsp", exe_path);
        const link_rf: void* = intrinsics::fopen(link_rsp_path, "w");
        if (link_rf == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("could not open linker response file for writing: %s", link_rsp_path));
            return PassResult::failure(1);
        }
        for (mut i: i64 = 0; i < ctx.artifacts.object_files.length; i++) {
            intrinsics::fprintf(link_rf, "\"%s\"\n", ctx.artifacts.object_files[i]);
        }
        intrinsics::fclose(link_rf);

        mut cmd: string = format("%s -o %s @\"%s\"",
            link_cfg.driver, link_quote(exe_path), link_rsp_path);
        // Stdlib archive: same lookup as the project link path, and same
        // host-vs-cross gating.  Empty stdlib_root means single-file mode
        // never resolved one (e.g. user passed `--no-std` semantically by
        // stripping prelude resolution); skip the archive in that case
        // and let the linker error if the program needs stdlib symbols.
        if (link_cfg.use_stdlib_archive && intrinsics::strlen(ctx.stdlib_root) > 0) {
            const stdlib_archive: string = format("%s/.bin/libcryo.a",
                ctx.stdlib_root);
            cmd = format("%s %s", cmd, link_quote(stdlib_archive));
        }
        cmd = format("%s %s", cmd, link_cfg.extra_system_libs);

        if (ctx.debug_mode) {
            cdebug("[Codegen] Single-file link -> %s\n", exe_path);
            cdebug("[Codegen] Link command: %s\n", cmd);
        }

        const rc: i32 = system(cmd);
        // Discard the response file once the link has consumed it
        // (best-effort - a failed unlink is harmless).
        intrinsics::unlink(link_rsp_path);
        if (rc != 0) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("linker invocation failed (%s exited with %d): %s",
                    link_cfg.driver, rc, cmd));
            return PassResult::failure(1);
        }

        cdebug("[Codegen] Linked executable: %s\n", exe_path);
        ctx.artifacts.linked = LinkedOutput { object_file_path: exe_path };
        return PassResult::ok();
    }


    /// Bundle a library/stdlib target's per-module .o files into a single
    /// archive next to them.  The Stdlib target is hardcoded to `libcryo.a`
    /// (the path the executable-link path looks for via
    /// `<root>/../stdlib/.bin/libcryo.a`); Library targets use
    /// `lib<project_name>.a` per the usual convention.
    /// `ar rcs` is idempotent; re-runs overwrite the archive cleanly.
    static bundle_archive(ctx: CompilationContext*) -> PassResult {
        if (ctx.project_config == null) {
            return PassResult::ok();
        }
        const cfg: ProjectConfig* = ctx.project_config;
        const archive_name: string = match (cfg.target_type) {
            TargetType::Stdlib => { "libcryo.a" }
            _                  => { format("lib%s.a", cfg.project_name) }
        };
        // Archive lands at the build root (`<output_dir>/lib<name>.a`).
        ProjectConfig::mkdir_p(cfg.output_dir);
        const archive_path: string = cfg.lib_archive_path(archive_name);

        // Invoke `<ar> rcs <archive> @<response-file>`.  `r` replaces stale
        // members on re-bundle, `c` suppresses the empty-archive warning,
        // `s` writes the symbol index that `ld` consults to satisfy
        // references.
        //
        // Archiver selection mirrors `pick_c_preprocessor`'s `CRYO_CC` knob:
        // `CRYO_AR` overrides the default `ar`.  This is what lets a
        // Windows-hosted `cryo.exe` (e.g. run under wine) point at an
        // `llvm-ar.exe` it can actually launch, since the host's ELF `ar`
        // can't run there.
        //
        // The object list goes in an @response-file rather than on the
        // command line for TWO reasons: (1) a real compiler easily exceeds
        // the shell's argv limit on a large project — and under wine
        // `system(3)` routes through `cmd /c`, whose command line caps at
        // ~8191 chars (155 object paths blow straight past it, and cmd
        // truncates rather than erroring, crashing the archiver); (2) it
        // keeps the spawned command short and identical on every host.  Both
        // GNU `ar` and `llvm-ar` accept `@file` with one whitespace- or
        // newline-separated, optionally-quoted entry per object.
        //
        // Paths are wrapped in DOUBLE quotes (not `shell_quote`'s single
        // quotes), matching the cross-platform `c_header_import` precedent:
        // `system(3)` runs `sh -c` on POSIX but `cmd /c` on Windows, and
        // `cmd` treats single quotes as literal characters while honouring
        // double quotes; the archiver's own response-file parser likewise
        // honours double quotes.  The tool token is left unquoted (as
        // `c_header_import` leaves `cc`) so a quoted-path first token can't
        // trip cmd's outer-quote-stripping rule.
        const ar: string = pick_archiver();
        const rsp_path: string = format("%s.rsp", archive_path);
        const rf: void* = intrinsics::fopen(rsp_path, "w");
        if (rf == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("could not open archiver response file for writing: %s", rsp_path));
            return PassResult::failure(1);
        }
        for (mut i: i64 = 0; i < ctx.artifacts.object_files.length; i++) {
            intrinsics::fprintf(rf, "\"%s\"\n", ctx.artifacts.object_files[i]);
        }
        intrinsics::fclose(rf);

        const cmd: string = format("%s rcs \"%s\" @\"%s\"", ar, archive_path, rsp_path);

        if (ctx.debug_mode) {
            cdebug("[Codegen] Bundling %lld objects -> %s (via %s)\n",
                ctx.artifacts.object_files.length, archive_path, rsp_path);
            cdebug("[Codegen] Bundle command: %s\n", cmd);
        }

        const rc: i32 = system(cmd);
        // Drop the response file now the archiver has read it (best-effort).
        intrinsics::unlink(rsp_path);
        if (rc != 0) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("ar invocation failed (exited with %d): %s", rc, cmd));
            return PassResult::failure(1);
        }

        cdebug("[Codegen] Bundled archive: %s (%lld objects)\n",
            archive_path, ctx.artifacts.object_files.length);
        return PassResult::ok();
    }
}
