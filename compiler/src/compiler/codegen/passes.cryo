// Linker configuration per target

/// The answers `LinkerConfig` gets about the C toolchain, kept for the life
/// of the process: which driver a target's default resolves to (a `PATH`
/// search), and whether that driver unwinds through libgcc (the driver's
/// own answer, kept on disk across builds by `DriverFacts`).  Neither can
/// change while the process runs.  One target's answers are held; a link
/// for a target with another default driver finds them again.
///
/// Every string held here is a literal: the per-target arena is reset
/// between targets, so nothing allocated during a build may outlive it here.
/// That is why a `CRYO_CC` driver is read from the environment on every use
/// rather than held.
type struct ToolchainProbe {
    /// The target default the answers are for; "" before the first probe.
    default_driver:       string;
    /// The launchable driver found for it; "" until something asks.
    launchable_driver:    string;
    libgcc_probed:        boolean;
    unwinds_with_libgcc:  boolean;
}

mut g_toolchain_probe: ToolchainProbe = ToolchainProbe {
    default_driver: "", launchable_driver: "", libgcc_probed: false, unwinds_with_libgcc: false,
};

/// What the link pass needs to know about the active target's
/// toolchain: which driver binary to invoke, what to put on the system
/// library line, and whether the executable filename grows an `.exe`
/// suffix.  Built by `linker_config_for_triple` from the resolved
/// target triple.  Building one launches nothing: the suffix, the library
/// line and `supported` follow from the triple alone, and the driver is
/// resolved by `link_driver` only when a link needs it.
///
/// `supported`:
///   - true  for triples we know how to drive end-to-end.
///   - false for triples where we still want the historic bailout
///           (object files only; user finishes the link manually).
type struct LinkerConfig {
    /// The driver this target links with when `CRYO_CC` names none and it
    /// can be launched (`link_driver`).  Always a literal.
    default_driver:      string;
    exe_suffix:          string;
    extra_system_libs:   string;
    supported:           boolean;

    /// Pick the right toolchain for `triple`.  `triple` is the post-
    /// `resolve_effective_triple` value (empty falls back to host).  Today:
    ///
    ///   - SysV-amd64 host (linux/macos): `cc -lm -lstdc++`, no suffix.
    ///     `-lstdc++` drags in LLVM-20's C++ runtime, which
    ///     the cryo compiler itself needs (libLLVM-20 is C++); ordinary
    ///     cryo programs don't reference it but the symbol set is a no-op
    ///     so keeping it on the host line costs nothing.
    ///   - x86_64 windows-gnu: the driver `windows_gnu_link_driver` names
    ///     (clang + lld on a POSIX host), `-lm`, `.exe` suffix.
    ///     mingw-w64 ships its own libc/libm equivalents; no C++ runtime to
    ///     pull in for cross-compiled cryo programs.
    ///   - anything else (aarch64, riscv, windows-msvc, ...): unsupported;
    ///     `run_linking` falls back to the object-files-only bailout that
    ///     prints a manual-link hint.
    static linker_config_for_triple(triple_text: string) -> LinkerConfig {
        const triple: string = triple_text;
        // Host build: a null/empty triple, or one that matches the (coerced)
        // host triple, takes the per-host config below.  The split is
        // platform-gated because the host config diverges by OS - exe suffix
        // and which extra libs ship by default.
        if (triple == null
                || triple.length() == 0
                || triple == LTargetMachine::get_default_triple()) {
            return LinkerConfig::host_linker_config();
        }
        // x86_64 windows-gnu (mingw-w64).  Substring-match the OS field so
        // every reasonable spelling (`x86_64-pc-windows-gnu`,
        // `x86_64-w64-windows-gnu`, `x86_64-windows-gnu`) routes here.
        if (triple.contains("windows")
                && triple.contains("gnu")
                && triple.contains("x86_64")) {
            return LinkerConfig {
                default_driver:     LinkerConfig::windows_gnu_link_driver(),
                // `-lws2_32` for std::net (Winsock), `-lntdll` for the
                // async reactor (its readiness backend polls `\Device\Afd`
                // through the NT layer) and `-lcrypt32` for std::net::tls
                // (a server's chain is verified by Windows); mingw
                // auto-links none of them, the way it does kernel32/advapi32.
                // All are always present on Windows, so linking them
                // unconditionally (like `-lm`) costs nothing for programs
                // that use none.
                exe_suffix:         ".exe",
                extra_system_libs:  "-lm -lws2_32 -lntdll -lcrypt32",
                supported:          true,
            };
        }
        // Unknown triple - keep the existing object-files-only behaviour.
        return LinkerConfig {
            default_driver:     "",
            exe_suffix:         "",
            extra_system_libs:  "",
            supported:          false,
        };
    }

    /// The C driver this target links with.  `CRYO_CC` overrides everything,
    /// mirroring `pick_archiver`'s `CRYO_AR`.  With no override the driver is
    /// the first candidate found on `PATH` (`ExecutablePath`), searched once
    /// per process (`ToolchainProbe`); nothing is launched to find it:
    ///
    ///   1. The target's `default_driver` wins whenever it's on `PATH`.
    ///      This is the historic choice on every host where it exists - `cc`
    ///      on a POSIX host, `x86_64-w64-mingw32-gcc` on a Linux->windows
    ///      cross - so existing flows and selfhost byte-identity are unchanged
    ///      (on Linux/CI `cc` is present, so the fallback never fires).
    ///   2. Only when the default is ABSENT do we probe further.  This is the
    ///      native mingw/MSYS2 case: `host_linker_config` asks for `cc`, but a
    ///      stock box ships `gcc`/`clang` instead.  `gcc` is tried before
    ///      `clang` because on a mingw host `gcc` links gnu-ABI objects
    ///      natively while a bare `clang` may default to the msvc target.
    ///   3. A cross driver (`*-mingw32-*`) that's missing has no sane host
    ///      substitute, so we DON'T fall back for it - the original name is
    ///      kept so the link error names the absent cross toolchain.
    link_driver(&this) -> string {
        match (env::var(Str::new("CRYO_CC"))) {
            Option::Some(v) => {
                const env_val: string = v.into_raw();
                if (env_val.length() > 0) { return env_val; }
            }
            Option::None => {}
        }
        this.hold_probe();
        if (g_toolchain_probe.launchable_driver.length() == 0) {
            g_toolchain_probe.launchable_driver = LinkerConfig::first_launchable_driver(this.default_driver);
        }
        return g_toolchain_probe.launchable_driver;
    }

    /// Whether the link driver's toolchain takes its unwinder from libgcc:
    /// the driver resolves `libgcc_eh.a` to a path (`-print-file-name` echoes
    /// the bare name back when the file is not in its search dirs).  A
    /// toolchain without it unwinds through LLVM's libunwind instead.  Asked
    /// once per process (`ToolchainProbe`), and of the driver only when
    /// `facts_directory` holds no answer it gave for the program it starts
    /// now (`DriverFacts`); the answer it gives is kept there.  The probe's
    /// output goes to `log_path`, which is removed afterwards.
    unwinds_with_libgcc(&this, facts_directory: string, log_path_text: string) -> boolean {
        const driver: string = this.link_driver();
        this.hold_probe();
        if (g_toolchain_probe.libgcc_probed) { return g_toolchain_probe.unwinds_with_libgcc; }
        match (DriverFacts::read(facts_directory, driver)) {
            Option::Some(facts) => {
                Log::debug(LogArea::Link, f"`{driver}` unwinds through libgcc: {facts.unwinds_with_libgcc}, as it answered before");
                g_toolchain_probe.unwinds_with_libgcc = facts.unwinds_with_libgcc;
            }
            Option::None => {
                Log::debug(LogArea::Link, f"launching `{driver} -print-file-name=libgcc_eh.a` to find the unwinder");
                mut out: string = "";
                const rc: i32 = CodegenPasses::capture_tool(
                    fmt::format("%s -print-file-name=libgcc_eh.a", driver).into_raw(), log_path_text, &out);
                File::remove(Path::from(log_path_text));
                const answer: string = out;
                const facts: DriverFacts = DriverFacts {
                    unwinds_with_libgcc: rc == 0 && (answer.contains("/") || answer.contains("\\")),
                };
                if (rc == 0) { facts.write(facts_directory, driver); }
                g_toolchain_probe.unwinds_with_libgcc = facts.unwinds_with_libgcc;
            }
        }
        g_toolchain_probe.libgcc_probed = true;
        return g_toolchain_probe.unwinds_with_libgcc;
    }

    /// Make the process's `ToolchainProbe` the one for this target's default
    /// driver, dropping another target's answers.
    hold_probe(&this) -> void {
        if (g_toolchain_probe.default_driver == this.default_driver) { return; }
        g_toolchain_probe = ToolchainProbe {
            default_driver:      this.default_driver,
            launchable_driver:   "",
            libgcc_probed:       false,
            unwinds_with_libgcc: false,
        };
    }

    /// The first driver on `PATH` for `default_driver`, by the order
    /// `link_driver` gives.  Every answer is a literal.
    static first_launchable_driver(default_driver_text: string) -> string {
        const default_driver: string = default_driver_text;
        if (ExecutablePath::of_command(default_driver_text).length() > 0) { return default_driver; }
        if (!default_driver.contains("mingw")) {
            if (ExecutablePath::find("gcc").length() > 0)   { return "gcc"; }
            if (ExecutablePath::find("clang").length() > 0) { return "clang"; }
            if (ExecutablePath::find("cc").length() > 0)    { return "cc"; }
        }
        return default_driver;
    }

    /// The host-build `LinkerConfig`: what to run when the user did NOT pass
    /// `--target=...` (or passed one that matches the host).  Gated on the
    /// compiler's OWN target because the differences between Linux and
    /// Windows host builds are not derivable from the runtime triple alone:
    ///
    ///   - exe suffix: empty on POSIX, `.exe` on Windows so the hoisted
    ///     binary opens correctly under cmd / Explorer.
    ///   - extra system libs: `-lstdc++` on POSIX (the self-hosted compiler
    ///     links libLLVM-20, which is C++; user programs never reference
    ///     C++ symbols so the flag is inert for them).  On Windows we need
    ///     `-lws2_32` + `-lntdll` instead: mingw auto-links neither the way
    ///     it auto-links kernel32/advapi32, so any program using `std::net`
    ///     (Winsock) or the async reactor (whose Windows readiness backend
    ///     reaches `\Device\Afd` through the NT layer) would otherwise fail
    ///     to link.  `-lstdc++` is omitted on Windows
    ///     because the compiler binary itself isn't relinked here (the
    ///     committed `cryo.exe` is already linked) and ordinary cryo
    ///     programs don't need it.
    ///   - the rest (`cc` driver, supported) is identical.
    ![target(unix)]
    static host_linker_config() -> LinkerConfig {
        return LinkerConfig {
            default_driver:     "cc",
            exe_suffix:         "",
            extra_system_libs:  "-lm -lstdc++",
            supported:          true,
        };
    }

    /// The driver a build for x86_64 windows-gnu links with when that is
    /// not the host.  A POSIX-hosted compiler drives clang at the mingw
    /// target with lld: binutils-mingw-w64's GNU ld (2.41 on Ubuntu 24.04)
    /// places a base relocation over every thread-local's section-relative
    /// offset, so once the loader moves the image the program faults on its
    /// first thread-local access, and lld does not.  `CRYO_CC` overrides
    /// either (`link_driver`).
    ![target(unix)]
    static windows_gnu_link_driver() -> string {
        return "clang-20 --target=x86_64-w64-mingw32 -fuse-ld=lld";
    }

    ![target(windows)]
    static windows_gnu_link_driver() -> string {
        return "x86_64-w64-mingw32-gcc";
    }

    ![target(windows)]
    static host_linker_config() -> LinkerConfig {
        return LinkerConfig {
            default_driver:     "cc",
            exe_suffix:         ".exe",
            extra_system_libs:  "-lm -lws2_32 -lntdll -lcrypt32",
            supported:          true,
        };
    }
}


// Cascade-strip helper


// Codegen Pass Implementations

type struct CodegenPasses {

    // Host-shell-aware command construction
    //
    // The compiler shells out through libc `system(3)`, which runs `sh -c` on
    // a POSIX-hosted compiler and `cmd /c` on a Windows-hosted one.  These
    // helpers are gated on the COMPILER's OWN target (ConfigGating strips one
    // side at build time): a Linux `cryo` keeps the POSIX forms, a native
    // `cryo.exe` gets the `cmd`-compatible forms.  Without this, an executable
    // link/hoist run on native Windows fails - `cmd` treats `shell_quote`'s
    // single quotes as literal filename characters, has no `cp`, and does no
    // glob/`2>/dev/null`.  (Cross-building a Windows target FROM Linux is
    // unaffected: that link runs in `sh` on the Linux host, so the POSIX forms
    // are correct there.)

    /// Run a toolchain command - the linker, the archiver - with its combined
    /// output captured to `log_path`, and answer its exit code, the output in
    /// `*out`.  The output is read back rather than left on the terminal:
    /// the compiler's diagnostics render after every pass has run, so a
    /// tool's own reason for failing, printed as the tool ran, would sit
    /// above all of them, apart from the one error it explains.  A caller
    /// puts it in that error; a command that succeeds has its output printed
    /// here, as it would have been (a linker's warnings).  The log is
    /// removed on success and kept on failure, beside the response file.
    static run_tool(cmd_text: string, log_path_text: string, out: mut string*) -> i32 {
        const log_path: string = log_path_text;
        const rc: i32 = CodegenPasses::capture_tool(cmd_text, log_path_text, out);
        const text: string = *out;
        if (rc == 0) {
            if (text.length() > 0) { fmt::eprintf("%s", text); }
            File::remove(Path::from(log_path));
        }
        return rc;
    }

    /// Run a toolchain command with its combined output captured to
    /// `log_path`, and answer its exit code, the output in `*out`.  The log
    /// is left in place and nothing is printed: the caller decides both.
    static capture_tool(cmd_text: string, log_path_text: string, out: mut string*) -> i32 {
        const cmd: string = cmd_text;
        const log_path: string = log_path_text;
        const rc: i32 = Command::shell(fmt::format("%s > %s 2>&1", cmd,
            CodegenPasses::link_quote(log_path_text)).into_raw());
        mut text: string = "";
        match (File::read_text(Path::from(log_path))) {
            Result::Ok(t)  => { text = t.into_raw(); }
            Result::Err(_) => { }
        }
        *out = text;
        return rc;
    }

    /// The error for a toolchain command that failed: what ran, where its
    /// inputs are kept, and - as a note - what the tool itself reported,
    /// which is the reason.
    static tool_failure(what: string, cmd_text: string, rsp_path_text: string,
                        output_text: string) -> Diagnostic {
        const cmd: string = cmd_text;
        const output: string = output_text;
        const rsp_path: string = rsp_path_text;
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
            fmt::format("%s: %s\n  object list retained at: %s", what, cmd, rsp_path));
        if (output.length() > 0) {
            d = d.with_note(fmt::format("the tool reported:\n%s", output));
        }
        return d;
    }

    /// Quote one path/argument for the active build host's shell.  POSIX:
    /// `shell_quote`'s secure single-quote form.  Windows: a plain double-quote
    /// wrap - `cmd` honours only double quotes, and build paths never contain
    /// an embedded `"` (same assumption the archiver's response-file paths make).
    ![target(unix)]
    static link_quote(s_text: string) -> string {
        return CodegenPasses::shell_quote(s_text);
    }

    ![target(windows)]
    static link_quote(s_text: string) -> string {
        const s: string = s_text;
        return fmt::format("\"%s\"", s).into_raw();
    }

    /// Append the runtime tiers a HOSTED link needs, plus the entry override
    /// that makes the program start in Cryo instead of in crt0.  Placed after
    /// the user objects and the stdlib archive so the tiers resolve their
    /// undefined `__cryo_panic` (and, under unwind, `__cryo_personality_v0`).
    ///
    /// The core tier comes first and the panic tier last, for the same
    /// left-to-right reason `append_runtime_tier_libs` orders them that way: the
    /// core tier's own formatting helpers carry bounds checks, and a bounds
    /// check calls into the panic tier.
    ///
    /// Both are the `-hosted` builds rather than the freestanding ones: the two
    /// builds differ in how they terminate, and only the hosted build exits
    /// through libc `exit`, which flushes the program's buffered stdio.  Linking
    /// a freestanding archive here would silently discard anything the program
    /// had printed — and that applies to unwind too, since an uncaught panic
    /// still terminates (through `__cryo_panic_finish`).
    ///
    /// `-Wl,-e,__cryo_entry` is what actually retargets the entry, and it also
    /// pulls the entry out of the archive: ld enters the entry symbol as an
    /// undefined reference, so naming it here extracts the member.  The crt
    /// objects are deliberately NOT dropped (no `-nostartfiles`) — see
    /// `runtime/core/src/entry.cryo` for why removing them costs far more than
    /// the entry point.
    ///
    /// `--release-static` is the one link that keeps crt0's entry, and that is
    /// forced rather than chosen: it passes `-static`, and a fully static glibc
    /// sets up its own thread control block INSIDE `__libc_start_main` — the job
    /// ld.so does before the entry runs in every dynamic link.  Entering past it
    /// therefore leaves TLS unmapped, and the program dies on the first
    /// thread-local access, which the panic tier makes early.  Measured: a
    /// static binary with a retargeted entry segfaults before reaching `main`.
    /// Nothing else emits `-static`, so this exception is exactly as narrow as
    /// the flag.
    ///
    /// On Windows the core tier reaches ntdll — argv is parsed out of the PEB by
    /// the same code the freestanding tier uses, which sizes its vector with
    /// `RtlAllocateHeap`, and mingw's default library line stops at kernel32.
    /// No `-lntdll` is added here because the windows `extra_system_libs` already
    /// carries it and both link paths append that AFTER these archives, which is
    /// the order ld needs.
    ///
    /// No explicit `-lunwind`: the personality + `resume` reference the shared
    /// Itanium `_Unwind_*` Level-1 ABI, which the gcc driver's always-linked
    /// `libgcc_s` already provides for a hosted build (verified end-to-end).
    /// Forcing `-lunwind` instead breaks the link on a standard gcc/glibc host
    /// that ships `libunwind.so.8` but no `libunwind.so` dev symlink, for no
    /// benefit (identical ABI).  An LLVM-libunwind / freestanding combination
    /// that needs an explicit unwinder is a follow-up (a `[link]`-config knob).
    static append_hosted_runtime_libs(ctx: CompilationContext*, cmd_text: string,
                                      triple_text: string, link_cfg: LinkerConfig*,
                                      probe_log_text: string) -> string {
        const cmd: string = cmd_text;
        const triple: string = triple_text;
        const lib_dir: string = CodegenPasses::resolve_runtime_lib_dir(ctx, triple_text, true);
        if (lib_dir.length() == 0) {
            return cmd;
        }
        mut out: string = cmd;
        out = fmt::format("%s %s", out, CodegenPasses::link_quote(
            Path::from(lib_dir).join("libcryort-core-hosted.a").into_raw())).into_raw();
        const archive: string = match (ctx.options.unwinds()) {
            true  => { "libcryort-panic-unwind-hosted.a" }
            false => { "libcryort-panic-abort-hosted.a" }
        };
        out = fmt::format("%s %s", out, CodegenPasses::link_quote(
            Path::from(lib_dir).join(archive).into_raw())).into_raw();
        // A windows toolchain built on LLVM's runtimes (llvm-mingw) resolves the
        // `_Unwind_*` ABI through libunwind, and its clang driver links that
        // SHARED whenever the toolchain ships `libunwind.dll.a` - which makes
        // every binary we emit carry a runtime `libunwind.dll` import.  That is
        // wrong twice over: a shipped `cryo.exe` would need a loose DLL beside
        // it, and any stage of the self-host chain that runs a freshly linked
        // compiler dies before main with STATUS_DLL_NOT_FOUND (c0000135) and an
        // empty log.  Take the static `libunwind.a` instead: `--unwindlib=none`
        // stops the driver adding its own shared one, and the
        // `-Bstatic`/`-Bdynamic` bracket pins OUR `-lunwind` to the archive
        // while leaving every other library (kernel32, ntdll, the CRT) dynamic.
        // `-lunwind` stays un-pathed so it resolves from the active toolchain's
        // own lib dir.
        //
        // Scoped to windows on purpose: a hosted glibc link must NOT gain an
        // explicit `-lunwind` (see this function's contract above) - such hosts
        // ship `libunwind.so.8` with no `.so` dev symlink and the link fails.
        //
        // Scoped to a toolchain WITHOUT libgcc's unwinder too, and asked of the
        // toolchain rather than read off the driver's name: a mingw-w64 gcc, or
        // a clang driving the same gcc sysroot, resolves `_Unwind_*` from
        // `libgcc_eh`, ships no libunwind to link, and a gcc driver rejects
        // `--unwindlib` outright ("unrecognized command line option").
        if (triple.contains("windows")
                && !link_cfg.unwinds_with_libgcc(
                    DriverFacts::directory_for(ctx.options.stdlib_root, triple), probe_log_text)) {
            out = fmt::format("%s --unwindlib=none -Wl,-Bstatic -lunwind -Wl,-Bdynamic", out).into_raw();
        }
        if (ctx.options.static_link) {
            return out;
        }
        return fmt::format("%s -Wl,-e,__cryo_entry", out).into_raw();
    }

    /// A directory holds the runtime tiers when the base tier archive for the
    /// link KIND is in it.  The two kinds ship different archives, so asking the
    /// wrong question picks a directory that cannot satisfy the link: a hosted
    /// link that settled for a freestanding-only directory would name an entry
    /// symbol nothing defines, and `-e` on a missing symbol is a linker WARNING
    /// — the binary still links, and starts at whatever address ld defaulted to.
    static runtime_dir_has_core(dir_text: string, hosted: boolean) -> boolean {
        const dir: string = dir_text;
        const base: string = match (hosted) {
            true  => { "libcryort-core-hosted.a" }
            false => { "libcryort-core.a" }
        };
        const archive: PathBuf = Path::from(dir).join(base);
        return archive.as_path().exists();
    }

    /// Prefer `<dir>/<triple>`, fall back to `<dir>`, else "".  Always returns a
    /// freshly allocated path: callers build candidates from borrowed env-var
    /// views that drop at the end of their match arm.
    static runtime_dir_pick(dir_text: string, triple_text: string, hosted: boolean) -> string {
        const dir: string = dir_text;
        const triple: string = triple_text;
        const per_target: string = Path::from(dir).join(triple).into_raw();
        if (CodegenPasses::runtime_dir_has_core(per_target, hosted)) {
            return per_target;
        }
        if (CodegenPasses::runtime_dir_has_core(dir_text, hosted)) {
            return fmt::format("%s", dir).into_raw();
        }
        return "";
    }


    /// Locate the directory holding the runtime tier archives for `triple`, or
    /// "" when none can be found (the caller then links no tiers, exactly as
    /// before this locator existed).
    ///
    /// The priority chain mirrors `resolve_stdlib_root`'s so an installed
    /// toolchain resolves as readily as a dev tree, and every candidate prefers
    /// a per-triple SUBDIRECTORY over a flat one.  That preference is load
    /// bearing, not defensive: a project's final artifacts are hoisted to the
    /// root of its `output_dir`, so building the runtime workspace for a second
    /// target overwrites the first target's archives in place.  Linking a flat
    /// directory therefore risks handing the linker another architecture's
    /// objects, which fails as a pile of undefined symbols that look like a
    /// runtime bug.  The flat fallback is what a single-target tree looks like.
    ///
    /// `hosted` selects WHICH tier set the caller needs; a directory that holds
    /// only the other kind is not a hit (see `runtime_dir_has_core`).
    static resolve_runtime_lib_dir(ctx: CompilationContext*, triple_text: string,
                                   hosted: boolean) -> string {
        // 0. Explicit override, for a runtime built somewhere else entirely.
        match (env::var(Str::new("CRYO_RUNTIME"))) {
            Option::Some(v) => {
                mut s: String = v;
                const hit: string = CodegenPasses::runtime_dir_pick(
                    s.as_cstr() as string, triple_text, hosted);
                if (hit.length() > 0) { return hit; }
            }
            Option::None => {}
        }
        // 1. Install root.  install.sh writes CRYO_HOME into the user's shell
        //    rc; the tiers ship beside the other target libraries.
        match (env::var(Str::new("CRYO_HOME"))) {
            Option::Some(v) => {
                mut s: String = v;
                const home: Path = Path::from(s.as_cstr() as string);
                const hit_lib: string = CodegenPasses::runtime_dir_pick(
                    home.join("lib/cryo").into_raw(), triple_text, hosted);
                if (hit_lib.length() > 0) { return hit_lib; }
                const hit_rt: string = CodegenPasses::runtime_dir_pick(
                    home.join("runtime/.bin").into_raw(), triple_text, hosted);
                if (hit_rt.length() > 0) { return hit_rt; }
            }
            Option::None => {}
        }
        // 2. Beside the running compiler.  This is the candidate that carries
        //    the common case: a freestanding project sets `no_std`, which means
        //    no stdlib root is ever resolved, so the stdlib-relative candidate
        //    below cannot fire for exactly the projects that need the tiers.
        //    `<bin>/../lib/cryo` is the install layout; the two dev-tree depths
        //    cover `bin/cryo` and `compiler/build/cryo`.
        mut self_exe: string = "";
        match (env::current_exe()) {
            Option::Some(s) => { self_exe = s.into_raw(); }
            Option::None    => {}
        }
        match (Path::from(self_exe).parent()) {
            Option::Some(bindir) => {
                const hit_inst: string = CodegenPasses::runtime_dir_pick(
                    bindir.join("../lib/cryo").into_raw(), triple_text, hosted);
                if (hit_inst.length() > 0) { return hit_inst; }
                const hit_dev: string = CodegenPasses::runtime_dir_pick(
                    bindir.join("../runtime/.bin").into_raw(), triple_text, hosted);
                if (hit_dev.length() > 0) { return hit_dev; }
                const hit_dev2: string = CodegenPasses::runtime_dir_pick(
                    bindir.join("../../runtime/.bin").into_raw(), triple_text, hosted);
                if (hit_dev2.length() > 0) { return hit_dev2; }
            }
            Option::None => {}
        }
        // 3. Beside the resolved stdlib.  Covers an install that keeps the two
        //    together but places neither relative to the binary.
        if (ctx.options.stdlib_root.length() > 0) {
            const hit: string = CodegenPasses::runtime_dir_pick(
                Path::from(ctx.options.stdlib_root).join("../runtime/.bin").into_raw(), triple_text, hosted);
            if (hit.length() > 0) { return hit; }
        }
        return "";
    }

    /// Append the runtime tier archives, plus the system libraries they import,
    /// to a freestanding link command.
    ///
    /// Order matters and is not arbitrary: ld resolves left to right, so a tier
    /// must precede whatever satisfies its undefined symbols.  The panic tier
    /// goes LAST because every other tier can reach it — `core`'s and
    /// `backtrace`'s own formatting helpers carry bounds checks, and a bounds
    /// check calls `__cryo_panic_bounds_check`.  WHICH panic archive lands here
    /// is the panic strategy; that is the entire reason the tiers ship as
    /// separate archives rather than one.
    ///
    /// The system libraries follow the archives for the same reason: the tiers
    /// import `NtTerminateProcess`/`RtlVirtualUnwind` (ntdll) and
    /// `WriteFile`/`VirtualAlloc` (kernel32), so naming those first would leave
    /// the tiers' references unresolved.
    static append_runtime_tier_libs(ctx: CompilationContext*, cmd_text: string,
                                     triple_text: string) -> string {
        const cmd: string = cmd_text;
        const triple: string = triple_text;
        const lib_dir: string = CodegenPasses::resolve_runtime_lib_dir(ctx, triple_text, false);
        if (lib_dir.length() == 0) {
            return cmd;
        }
        mut out: string = cmd;
        const directory: Path = Path::from(lib_dir);
        out = fmt::format("%s %s", out, CodegenPasses::link_quote(
            directory.join("libcryort-alloc.a").into_raw())).into_raw();
        out = fmt::format("%s %s", out, CodegenPasses::link_quote(
            directory.join("libcryort-backtrace.a").into_raw())).into_raw();
        out = fmt::format("%s %s", out, CodegenPasses::link_quote(
            directory.join("libcryort-core.a").into_raw())).into_raw();
        const panic_tier: string = match (ctx.options.unwinds()) {
            true  => { "libcryort-panic-unwind.a" }
            false => { "libcryort-panic-abort.a" }
        };
        out = fmt::format("%s %s", out, CodegenPasses::link_quote(
            directory.join(panic_tier).into_raw())).into_raw();
        if (triple.contains("windows")) {
            out = fmt::format("%s -lkernel32 -lntdll", out).into_raw();
        }
        return out;
    }

    /// Copy the freshly-linked binary from the per-profile cache to the build
    /// root.  Cross-platform via `fs::file::copy`, which creates/truncates the
    /// destination and mirrors the source's Unix mode bits (so the hoisted
    /// binary stays executable).  Returns 0 on success, 1 on failure.
    static hoist_binary(src_text: string, dst_text: string) -> i32 {
        const dst: string = dst_text;
        const src: string = src_text;
        match (File::copy(Path::from(src), Path::from(dst))) {
            Result::Ok(_)  => { return 0; }
            Result::Err(_) => { return 1; }
        }
    }

    /// Write a linker/archiver `@response` file listing every object file, one
    /// double-quoted path per line (parses identically under a POSIX `sh -c`
    /// driver or a Windows `cmd /c` one, so selfhost byte-identity is
    /// unaffected).  Returns false if the file could not be written.
    static write_rsp_file(path_text: string, objects: &[string]) -> boolean {
        const path: string = path_text;
        mut text: String = String::new();
        for (mut i: i64 = 0; i < objects.length(); i++) {
            text.push_byte(34 as u8);           // "
            text.push(Str::new(objects[i]));
            text.push_byte(34 as u8);           // "
            text.push_byte(10 as u8);           // \n
        }
        const ok: boolean = match (File::write_bytes(Path::from(path), text.as_bytes())) {
            Result::Ok(_)  => { true }
            Result::Err(_) => { false }
        };
        mem::drop(text);
        return ok;
    }

    /// Emit the combined `.ll` IR dump next to the hoisted exe (selfhost-check's
    /// byte-identity input).  POSIX-only: it relies on shell glob expansion
    /// (`/*/ir/*.ll`), which `cmd` does not provide.  On a Windows-hosted
    /// compiler this is a no-op - the dump is a Linux CI aid, not part of a
    /// normal build's output.  The shell sorts the glob's expansion, so the
    /// modules are linked in the same order on every build.
    ![target(unix)]
    static emit_linked_ir_dump(profile_dir_text: string, ll_path_text: string) -> void {
        const ll_cmd: string = fmt::format(
            "llvm-link-20 -S %s/*/ir/*.ll -o %s",
            CodegenPasses::shell_quote(profile_dir_text), CodegenPasses::shell_quote(ll_path_text)).into_raw();
        const ll_rc: i32 = Command::shell(ll_cmd);
        if (ll_rc == 0) {
            Log::debug(LogArea::Codegen, f"linked ir dump {ll_path_text}");
        } else {
            Log::warn(LogArea::Codegen, f"llvm-link-20 failed for the ir dump (exit code {ll_rc})");
        }
    }

    ![target(windows)]
    static emit_linked_ir_dump(profile_dir_text: string, ll_path_text: string) -> void {
        // cmd has no glob; the IR dump is a POSIX selfhost-check aid and is
        // not produced on a native Windows build.
    }

    /// Compare, for every nominal type this module actually mapped, the size
    /// the front end computed against the size LLVM lays out for the mapped
    /// body.  The two are independent computations of the same number and
    /// nothing else in the pipeline compares them, so a front-end layout bug
    /// is otherwise invisible until a `sizeof`-driven write overruns.
    ///
    /// Switched on by `CRYO_LAYOUT_AUDIT`; one line per disagreement plus a
    /// per-module examined/disagree count, so a run reports the population and
    /// not just the exceptions.
    static audit_layout(ctx: CompilationContext*, cg: CodegenContext*, module_name: string) -> void {
        mut audit_all: boolean = false;
        match (env::var(Str::new("CRYO_LAYOUT_AUDIT"))) {
            Option::Some(v) => { if (v.starts_with(&Str::new("all"))) { audit_all = true; } }
            Option::None    => { return; }
        }
        const arena: TypeArena* = ctx.type_arena;
        if (arena == null) { return; }

        mut nominal:   i64 = 0;
        mut unmapped:  i64 = 0;
        mut opaque:    i64 = 0;
        mut fe_zero:   i64 = 0;
        mut llvm_zero: i64 = 0;
        mut examined:  i64 = 0;
        mut disagree:  i64 = 0;
        mut align_dis: i64 = 0;
        mut padded_n:  i64 = 0;
        mut offset_dis: i64 = 0;
        for (mut i: i64 = 0; i < arena.types.length(); i++) {
            const t: Type* = arena.types[i];
            if (t == null) { continue; }
            if (t.kind != TypeKind::Struct) { continue; }
            nominal += 1;

            // Only types this module put through the type mapper: mapping one
            // here to measure it would mint LLVM structs the module never
            // referenced and perturb what is being measured.
            const mapped: LType = cg.type_mapper.lookup_cache(t.id);
            if (!mapped.is_valid()) { unmapped += 1; continue; }
            if (mapped.is_opaque_struct()) { opaque += 1; continue; }

            const fe_size: u64 = t.size_bytes();
            if (fe_size == 0) { fe_zero += 1; continue; }
            const llvm_size: u64 = cg.llvm_module.abi_size_of(mapped);
            if (llvm_size == 0) { llvm_zero += 1; continue; }
            const llvm_align: u64 = cg.llvm_module.abi_align_of(mapped);

            // A second, independent number for structs: the size of a LITERAL
            // struct built from this type's own field list.  The named struct
            // in the cache is reused by mangled name across type ids, so a
            // name that two distinct field lists mangle to keeps the FIRST
            // body -- which this comparison, and only this comparison, sees.
            mut lit_size: u64 = 0;
            if (t.kind == TypeKind::Struct) {
                const st0: StructType* = t.as_struct();
                const nf: u32 = st0.fields.length() as u32;
                if (!st0.is_union && nf > 0) {
                    const fbuf: mut void* = libc::malloc(nf as u64 * 8);
                    const fslots: mut (mut void*)* = fbuf as mut (mut void*)*;
                    // Read the cache; do NOT map.  Mapping here would add
                    // entries the module never asked for, and the next
                    // module would then find them cached -- an instrument
                    // that moves its own population.
                    mut ok: boolean = true;
                    for (mut fi: u32 = 0; fi < nf; fi++) {
                        const ft: LType = cg.type_mapper.lookup_cache(st0.fields[fi].field_type.key());
                        if (!ft.is_valid()) { ok = false; }
                        else { fslots[fi] = ft.raw; }
                    }
                    if (ok) {
                        const lit: LType = LType::literal_struct(fbuf, nf, st0.repr_packed);
                        lit_size = cg.llvm_module.abi_size_of(lit);
                    }
                    libc::free(fbuf);
                }
            }

            examined += 1;
            const st: StructType* = t.as_struct();
            const name:      string = ctx.intern_table.shown(st.qualified_name);
            const min_align: u64    = st.min_alignment;
            const nargs:     i64    = st.type_args.length();
            const kind:      string = "S";

            // WHERE each field lives, not just how big the type is.  Size and
            // alignment can both agree while the offsets do not: an
            // over-aligned member is placed by the front end on its declared
            // boundary, and if the body does not carry a filler in front of it
            // the tail padding hides the difference in the total.  The element
            // index comes from `field_element_index` - the same routine the
            // body was built from and every field GEP addresses through - so
            // this compares the mapping against LLVM's own layout rather than
            // re-deriving it.
            mut off_bad: i64 = 0;
            {
                const fields_ref: &[FieldInfo] = &st.fields;
                const skip: boolean = st.is_union;
                const n_elems: i64 = llvm::LLVMCountStructElementTypes(mapped.raw) as i64;
                if (!skip) {
                    for (mut fi: i64 = 0; fi < (*fields_ref).length(); fi++) {
                        const slot: i64 = cg.type_mapper.field_element_index(t, fi);
                        if (slot < 0 || slot >= n_elems) { continue; }
                        const want: u64 = (*fields_ref)[fi].offset;
                        const got:  u64 = cg.llvm_module.offset_of_element(mapped, slot as u32);
                        if (want != got) {
                            off_bad += 1;
                            fmt::eprintf("LAYOUT-OFF module=%s type=%s field=%lld slot=%lld fe_offset=%llu llvm_offset=%llu\n",
                                   module_name, name, fi, slot, want, got);
                        }
                    }
                }
            }
            if (off_bad > 0) { offset_dis += 1; }

            // A body LARGER than its own field list carries the tail padding
            // that reproduces a declared `![align(N)]`; a body SMALLER than
            // its field list is an identified struct reused under a mangled
            // name a different field list already claimed.
            const padded: boolean = lit_size != 0 && lit_size < llvm_size;
            if (padded) { padded_n += 1; }
            const size_ok: boolean = fe_size == llvm_size;
            const body_ok: boolean = lit_size == 0 || lit_size == llvm_size || padded;
            const agrees:  boolean = size_ok && body_ok;
            if (!agrees) { disagree += 1; }
            if (t.alignment() != llvm_align) { align_dis += 1; }
            if (agrees && !padded && t.alignment() == llvm_align && !audit_all) { continue; }

            mut tag: string = "LAYOUT-DIS";
            if (agrees) {
                tag = "LAYOUT-OK";
                if (padded) { tag = "LAYOUT-PADDED"; }
                if (t.alignment() != llvm_align) { tag = "LAYOUT-ALIGN-DIS"; }
            }
            fmt::eprintf("%s module=%s kind=%s type=%s id=%llu fe_size=%llu fe_align=%llu llvm_size=%llu llvm_align=%llu lit_size=%llu min_align=%llu targs=%lld\n",
                   tag, module_name, kind, name, t.id, fe_size, t.alignment(), llvm_size, llvm_align, lit_size, min_align, nargs);
        }
        fmt::eprintf("LAYOUT-AUDIT module=%s nominal=%lld examined=%lld disagree=%lld align_dis=%lld offset_dis=%lld padded=%lld skip_unmapped=%lld skip_opaque=%lld skip_fe0=%lld skip_llvm0=%lld\n",
               module_name, nominal, examined, disagree, align_dis, offset_dis, padded_n, unmapped, opaque, fe_zero, llvm_zero);
        libc::fflush(null);
    }

    /// IRGeneration pass.  Creates an LLVM module, walks the AST, and
    /// produces LLVM IR.  Stores result in ctx.artifacts.ir.
    static run_ir_generation(ctx: mut CompilationContext*) -> PassResult {
        // If an earlier pass (name resolution, sema, move-check, ...) already
        // reported an error, the program is ill-typed and any IR we produce is
        // unsound - e.g. a wrong-arity call lowers to an LLVM `call` with the
        // wrong operand count and trips the verifier, surfacing a confusing
        // internal-compiler-error (E0900) on top of the real source diagnostic.
        // Skip codegen entirely so the user sees only the genuine error. The
        // overall compile still fails (the pipeline's final gate is
        // `!diagnostics.has_errors()`), so no unsound binary is emitted.
        if (ctx.diagnostics.has_errors()) {
            Log::debug(LogArea::Codegen, "skipping ir generation: earlier passes reported errors");
            return PassResult::ok();
        }
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        // Resolve module name.
        mut module_name: string = "main";
        if (ctx.has_namespace()) {
            module_name = ctx.namespace_display();
        }

        if (Log::enabled(LogArea::Codegen, LogLevel::Debug)) {
            Log::debug(LogArea::Codegen, f"ir generation for module {module_name}");
        }

        // Initialize LLVM targets (idempotent).
        LTargetMachine::init_native_target();

        // Create per-module codegen context on the heap to avoid stack overflow.
        // CompilationContext is already large on the stack, and CodegenContext
        // adds ~400+ bytes of arrays and maps per module.
        const _box_cg: Box<CodegenContext> = Box::<CodegenContext>::new(CodegenContext::new(ctx, module_name));
        const cg: mut CodegenContext* = _box_cg.into_raw();
        // Two-phase init step 2: wire back-pointers on sub-components now
        // that `cg` is at its stable heap address.  Wiring before the move
        // into the Box would leave back-pointers dangling at the source.
        cg.wire();

        // Set target triple and data layout.  Honor a project-level
        // override (cryoconfig `target = "..."` or CLI `--target=TRIPLE`)
        // when one is set; otherwise fall back to the host triple from
        // LLVM.  The resolved triple is also fed to the target machine
        // below so the data-layout string matches.
        const triple: string = ctx.options.target_triple;
        cg.llvm_module.set_target_triple(triple);
        if (Log::enabled(LogArea::Codegen, LogLevel::Debug)) {
            Log::debug(LogArea::Codegen, f"target triple {triple}");
        }

        // A triple LLVM has no target for leaves the module without a data
        // layout; object emission reports it and fails the build.
        mut tm: LTargetMachine = match (LTargetMachine::create_target_machine_for_triple(triple)) {
            Result::Ok(machine) => { machine }
            Result::Err(_)      => { LTargetMachine::null() }
        };
        if (tm.is_valid()) {
            const layout: string = tm.get_data_layout_string();
            cg.llvm_module.set_data_layout(layout);
        }

        // DWARF debug-info scaffolding (no-op unless `-g`/--debug-info).
        // Must run before function-body emission so each prologue can
        // attach a DISubprogram + source location to its function.
        CodegenPasses::setup_debug_info(ctx, cg);

        // Cross-module externs are declared lazily by `resolve_symbol` /
        // `resolve_family` / `resolve_global` on first reference
        // from this module, avoiding an O(modules x funcs x overloads) bulk
        // pre-declaration pass.

        // No runtime helper is emitted per-module any more.  A panic calls the
        // external `__cryo_panic` supplied by the linked panic tier (see
        // `emit_panic_call`), and formatting is `fmt::format`, an ordinary
        // stdlib function resolved and linked like any other.

        // Create the visitor and generate IR.  Heap-allocate via Box::into_raw
        // so sub-emitters can hold stable `state: VisitorState*` back-pointers
        // into `gen.state`; same two-phase pattern as `CodegenContext` above.
        const _box_gen: Box<IRGeneratorVisitor> = Box::<IRGeneratorVisitor>::new(IRGeneratorVisitor::new(cg));
        const gen: mut IRGeneratorVisitor* = _box_gen.into_raw();
        // Two-phase init step 2: wire back-pointers on sub-emitters now
        // that `gen` is at its stable heap address.  No-op while the
        // visitor's sub-emitter set is empty; the call site is in place
        // for incremental extraction.
        gen.wire();
        const program: ProgramNode* = ctx.artifacts.ast.program();
        const success: boolean = gen.generate_program(program);

        if (!success) {
            Log::debug(LogArea::Codegen, f"ir generation failed for module {module_name}");
            cg.dispose_builder();
            tm.dispose();
            return PassResult::from_snapshot(ctx.diagnostics, snap);
        }

        // Cascade-strip: a method body that fails codegen (e.g.
        // `Array<T>::partition` with a non-numeric T whose `T < T` doesn't
        // lower) gets stripped to a `declare`-only.  But other methods in
        // the same impl block (e.g. `Array<T>::quicksort` which calls
        // `partition`, and `Array<T>::sort` which calls `quicksort`)
        // already emitted their bodies with a call to the now-empty
        // partition.  At link time, that call is an undefined reference.
        //
        // Walk all defined functions; for each that still has a body but
        // calls a same-module declare (a stripped sibling), strip it too.
        // Iterate until the strip set stabilizes.  Functions that were
        // intentionally cross-module externs are unaffected because the
        // strip set only contains symbols whose body was attempted in
        // this module.
        CodegenPasses::cascade_strip_dependents(cg);

        const erased_loads: u64 = cg.llvm_module.erase_unused_aggregate_loads();
        if (erased_loads > 0 && Log::enabled(LogArea::Codegen, LogLevel::Debug)) {
            Log::debug(LogArea::Codegen, f"erased {erased_loads} unused aggregate load(s) in module {module_name}");
        }

        CodegenPasses::audit_layout(ctx, cg, module_name);

        // Finalize debug info: wires every DISubprogram into the compile
        // unit and resolves temporary metadata. Must run before
        // LLVMVerifyModule, which checks debug-info well-formedness.
        if (cg.debug_info.is_on()) {
            llvm::LLVMDIBuilderFinalize(cg.debug_info.builder);
        }

        // Pre-verify: scan all functions for corrupt types before calling
        // LLVMVerifyModule (which crashes on null function types).
        mut has_corrupt: boolean = false;
        {
            mut fn_val: mut void* = llvm::LLVMGetFirstFunction(cg.llvm_module.raw);
            while (fn_val != null) {
                const fn_ty: mut void* = llvm::LLVMGlobalGetValueType(fn_val);
                if (fn_ty == null) {
                    const fn_name: string = llvm::LLVMGetValueName(fn_val) as string;
                    Log::error(LogArea::Codegen, f"corrupt function '{fn_name}' in module {module_name}: null type");
                    has_corrupt = true;
                } else {
                    const ret_ty: void* = llvm::LLVMGetReturnType(fn_ty);
                    if (ret_ty == null) {
                        const fn_name: string = llvm::LLVMGetValueName(fn_val) as string;
                        Log::error(LogArea::Codegen, f"corrupt function '{fn_name}' in module {module_name}: null return type");
                        has_corrupt = true;
                    }
                    const param_count: u32 = llvm::LLVMCountParamTypes(fn_ty);
                    if (param_count > 0) {
                        const param_buf: mut void* = libc::malloc(param_count as u64 * 8);
                        llvm::LLVMGetParamTypes(fn_ty, param_buf);
                        const slots: void** = param_buf as void**;
                        for (mut pi: u32 = 0; pi < param_count; pi++) {
                            if (slots[pi] == null) {
                                const fn_name: string = llvm::LLVMGetValueName(fn_val) as string;
                                Log::error(LogArea::Codegen, f"corrupt function '{fn_name}' in module {module_name}: parameter {pi} has a null type");
                                has_corrupt = true;
                            }
                        }
                        libc::free(param_buf);
                    }
                }
                fn_val = llvm::LLVMGetNextFunction(fn_val);
            }
        }

        // The module is verified by its emission job, as it will be emitted
        // (`EmitJob.verify_and_key`); one with a corrupt function type is not.
        if (has_corrupt) {
            Log::error(LogArea::Codegen, f"skipping verification of module {module_name}: corrupt function types");
        }

        if (ctx.options.freestanding()) {
            cg.llvm_module.forbid_library_calls();
        }

        // `![inline]` is honoured at every optimization level, and level 0's
        // pipeline runs no inliner: inline its calls here.
        const ai_opts: mut void* = llvm::LLVMCreatePassBuilderOptions();
        const ai_rc: i32 = llvm::LLVMRunPasses(cg.llvm_module.raw, "always-inline", tm.raw, ai_opts);
        llvm::LLVMDisposePassBuilderOptions(ai_opts);
        if (ai_rc != 0) {
            ctx.emit_error(ErrorCode::E0605_OPTIMIZATION_FAILED,
                fmt::format("LLVM `always-inline` pass failed for module `%s` (error code %d)",
                    module_name, ai_rc));
            cg.dispose_builder();
            tm.dispose();
            return PassResult::failure(1);
        }

        // Store the LLVM module in artifacts.  The module is now owned by
        // artifacts; do NOT dispose it here.
        ctx.artifacts.ir = IROutput {
            llvm_module: cg.llvm_module.raw,
            module_name: module_name,
            verifiable: !has_corrupt,
        };

        cg.dispose_builder();
        tm.dispose();

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }


    /// ObjectEmission pass.  Emits a per-module artifact from the LLVM
    /// module.  Kind selection:
    ///   - No `-o` override        -> per-origin `target/<profile>/<origin>/deps/<mod>.o`
    ///   - `-o foo.o`  / Object    -> emit object to the override path
    ///   - `-o foo.s`  / Asm       -> emit assembly to the override path
    ///   - `-o foo.ll` / IRText    -> dump module text to the override path
    ///   - `-o foo`    / Exe       -> emit object to the legacy path; the
    ///                                Linking pass picks it up and shells
    ///                                out to `cc` to produce the final
    ///                                executable at the override path.
    /// Resolve WHERE and HOW this module's IR is emitted, WITHOUT touching
    /// LLVM.  Split out of `run_object_emission` so the codegen producer
    /// (instance.cryo) can compute the target on the producer side - it needs
    /// `ctx`, `project_config`, and the module graph - and hand only the
    /// resolved `{path, file_type, register}` triple to the emitter (a child
    /// process for large builds, or the in-process serial path).  `is_ir_text`
    /// flags the pure text-dump kind that bypasses the target machine entirely.
    ///
    /// In project mode the `-o PATH` override applies to the ENTRY module only
    /// (a single-file build is a synthesized one-entry project whose stdlib
    /// imports compile as real modules); non-entry modules fall back to the
    /// per-origin `target/<profile>/<origin>/deps/<mod>.o` layout so the
    /// Linking pass has a stable per-module input set.  Registration is skipped
    /// for an explicit Asm/Object/IRText artifact (a user-facing file `cc` must
    /// not re-link); Exe and the no-override case register their `.o`.
    static resolve_emit_target(ctx: CompilationContext*) -> EmitTarget {
        mut output: OutputOverride = ctx.options.output;
        if (ctx.project_config != null && !CodegenPasses::is_entry_module_active(ctx)) {
            output = OutputOverride::Default;
        }
        match (output) {
            OutputOverride::IRText(path) => {
                return EmitTarget { is_ir_text: true,
                    emit_path: path,
                    emit_type: LFileType::Object, should_register: false };
            }
            OutputOverride::Asm(path) => {
                return EmitTarget { is_ir_text: false,
                    emit_path: path,
                    emit_type: LFileType::Assembly, should_register: false };
            }
            OutputOverride::Object(path) => {
                return EmitTarget { is_ir_text: false,
                    emit_path: path,
                    emit_type: LFileType::Object, should_register: false };
            }
            _ => {
                return EmitTarget { is_ir_text: false,
                    emit_path: CodegenPasses::legacy_obj_path(ctx),
                    emit_type: LFileType::Object, should_register: true };
            }
        }
    }

    /// The effective target triple for this build (host triple unless a
    /// cryoconfig `target` / CLI `--target` override is set).  Exposed so the
    /// parallel-codegen producer can stamp each emit job with it on the main
    /// thread - a worker must not recompute it (the resolver reads process
    /// state that is only stable to read serially).
    static effective_triple(ctx: CompilationContext*) -> string {
        return ctx.options.target_triple;
    }

    /// Remove the file at `path` if there is one.  A file that cannot be
    /// removed cannot be overwritten either, so the write that follows
    /// fails and says so.
    static remove_previous_output(path: string) -> void {
        match (File::remove(Path::from(path))) {
            Result::Ok(_)  => { }
            Result::Err(_) => { }
        }
    }

    /// E0647: LLVM has no target for `triple`, for LLVM's `reason`.
    static report_missing_target(ctx: mut CompilationContext*, triple: string, mut reason: String) -> void {
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0647_LLVM_BACKEND_FAILED,
            fmt::format("LLVM has no target for the triple `%s`: %s", triple, reason.as_cstr() as string));
        d = d.help("name a triple this compiler's LLVM supports, with `--target` or cryoconfig's `target_triple`; `cryo version --triple` prints the host's");
        ctx.emit_diagnostic(d);
    }

    /// E0605: LLVM refused to run its optimization pipeline over the module
    /// that was to be emitted at `path`.
    static report_optimization_failure(ctx: mut CompilationContext*, path: string) -> void {
        ctx.emit_error(ErrorCode::E0605_OPTIMIZATION_FAILED,
            fmt::format("LLVM's optimization pipeline failed for the module emitted at `%s`", path));
    }

    /// E0647: LLVM could not write the object or assembly file at `path`,
    /// for LLVM's `reason`, which may be empty.
    static report_emit_failure(ctx: mut CompilationContext*, path: string, mut reason: String) -> void {
        if (reason.is_empty()) {
            ctx.emit_error(ErrorCode::E0647_LLVM_BACKEND_FAILED,
                fmt::format("LLVM could not emit `%s`", path));
            return;
        }
        ctx.emit_error(ErrorCode::E0647_LLVM_BACKEND_FAILED,
            fmt::format("LLVM could not emit `%s`: %s", path, reason.as_cstr() as string));
    }

    /// E0900: LLVM's verifier refused module `module_name`, with its
    /// `report` (LLVM's message, disposed here; null for none).  The report
    /// rides as a note cut to 2 KiB: the whole of it can run to megabytes.
    static report_verification_failure(ctx: mut CompilationContext*, module_name: string, report: string) -> void {
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
            fmt::format("LLVM module verification failed for %s", module_name));
        if (report != null) {
            const max_len: i64 = 2048;
            const report_length: i64 = report.length();
            mut note_body: string = report;
            if (report_length > max_len) {
                mut truncated: String = String::from_str(Str::from_raw(report as u8*, max_len));
                note_body = truncated.into_raw();
            }
            diag = diag.with_note("LLVM reports: " + note_body);
            if (report_length > max_len) {
                diag = diag.with_note("(LLVM error truncated)");
            }
        }
        ctx.diagnostics.emit(diag);
        if (report != null) {
            llvm::LLVMDisposeMessage(report as mut void*);
        }
    }

    static run_object_emission(ctx: mut CompilationContext*) -> PassResult {
        if (!ctx.artifacts.ir.is_valid()) {
            return PassResult::ok();
        }

        if (ctx.artifacts.ir.verifiable) {
            const refused: LModule = LModule { raw: ctx.artifacts.ir.llvm_module };
            const report: string = refused.verification_failure();
            if (report != null) {
                CodegenPasses::report_verification_failure(ctx, ctx.artifacts.ir.module_name, report);
                return PassResult::failure(1);
            }
        }

        const target: EmitTarget = CodegenPasses::resolve_emit_target(ctx);

        // IRText is the only kind that doesn't go through LLVM's target-machine
        // emit path; it's a pure text dump of the module IR.
        if (target.is_ir_text) {
            return CodegenPasses::emit_ir_text(ctx, target.emit_path);
        }

        // Resolve the effective triple here too; the object format
        // (ELF / COFF / Mach-O) is selected by the target machine, so
        // a stale host machine here would silently undo the cross-
        // compile we set up in IR generation.
        const obj_triple: string = ctx.options.target_triple;
        mut tm: LTargetMachine = match (LTargetMachine::create_target_machine_with_opt(
                obj_triple, ctx.options.opt_level as i32)) {
            Result::Ok(machine) => { machine }
            Result::Err(reason) => {
                CodegenPasses::report_missing_target(ctx, obj_triple, reason);
                return PassResult::failure(1);
            }
        };

        const mod: LModule = LModule { raw: ctx.artifacts.ir.llvm_module };
        if (!tm.run_optimization_pipeline(mod, ctx.options.opt_level)) {
            tm.dispose();
            CodegenPasses::report_optimization_failure(ctx, target.emit_path);
            return PassResult::failure(1);
        }
        const emitted: Result<(), String> = tm.emit_to_file(mod, target.emit_path, target.emit_type);
        tm.dispose();
        match (emitted) {
            Result::Ok(_) => { }
            Result::Err(reason) => {
                CodegenPasses::report_emit_failure(ctx, target.emit_path, reason);
                return PassResult::failure(1);
            }
        }

        // Store the object file path.
        // NOTE: Deep nested struct field assignment
        // (`ctx.artifacts.linked.object_file_path = ...`) has historically
        // been a source of codegen bugs through multi-deref chains. Assign
        // a full `LinkedOutput` replacement instead.
        ctx.artifacts.linked = LinkedOutput { object_file_path: target.emit_path };

        // Accumulate every module's object path so the linker pass can
        // invoke `cc` once over all of them at the end of Phase 7.
        // Route through `register_object_file`; directly calling
        // `.push()` on a multi-deref field chain has historically landed
        // on a temp copy (push-through-pointer codegen limitation).
        if (target.should_register) {
            ctx.artifacts.register_object_file(target.emit_path);
        }

        if (Log::enabled(LogArea::Link, LogLevel::Debug)) {
            Log::debug(LogArea::Link, f"emitted object {target.emit_path}");
        }

        return PassResult::ok();
    }

    /// Origin output subdir (`"std"`, `"local"`, or `<depname>`) for the
    /// module currently being codegen'd, looked up by its source path.
    /// Falls back to `"local"` for single-file builds / when the module
    /// isn't in the graph.
    static current_origin_subdir(ctx: CompilationContext*) -> string {
        if (ctx.module_graph == null) { return "local"; }
        const idx: i64 = ctx.module_graph.find_module_by_path(ctx.source_file);
        if (idx < 0) { return "local"; }
        const mi: ModuleInfo* = &ctx.module_graph.modules[idx];
        return ModuleInfo::origin_subdir(mi.origin, mi.origin_name);
    }

    /// Build the per-module object path:
    /// `<output_dir>/target/<profile>/<origin>/deps/<safe_module>.o`.
    /// Used when no `-o PATH` override is in effect, and for the per-module
    /// object that feeds the Exe link step in single-file mode.
    static legacy_obj_path(ctx: CompilationContext*) -> string {
        mut output_dir: string = "build/target/release/local/deps";
        if (ctx.project_config != null) {
            output_dir = ctx.project_config.deps_dir_for(
                CodegenPasses::current_origin_subdir(ctx));
        }
        // Object files mirror the module namespace as SUBDIRECTORIES under the
        // origin's `deps/` dir (`std::core::intrinsics` ->
        // `<deps>/std/core/intrinsics.o`), so the build tree mirrors the source
        // tree instead of collapsing every module into one flat folder of
        // `__`-joined stems.  `Manifest::path_module` is the single source of
        // truth for this mapping, shared with the incremental cache probe/reuse
        // and the manifest's artifact prediction; they MUST agree or the
        // predicted path diverges from the emitted one and caching breaks.
        const rel: string = compiler::build_manifest::Manifest::path_module(
            ctx.artifacts.ir.module_name);
        const obj_path: string = Path::from(output_dir).join(f"{rel}.o".as_str()).into_raw();
        // mkdir_p the object's PARENT (the namespace subdirs), which subsumes
        // `deps/` and any `--build-dir=...` prefix; a bare `mkdir` of the deep
        // path would fail and object emission would error "No such file or
        // directory".
        ProjectConfig::mkdir_p(obj_path.parent_dir());
        return obj_path;
    }

    /// Dump the LLVM module to a `.ll` text file at `path`.  Skips the
    /// target machine entirely; IR text is target-independent and the
    /// only failure mode is filesystem (permissions, missing parent).
    static emit_ir_text(ctx: mut CompilationContext*, path_text: string) -> PassResult {
        const path: string = path_text;
        const mod_ref: mut void* = ctx.artifacts.ir.llvm_module;
        mut err: i8* = null;
        const rc: i32 = llvm::LLVMPrintModuleToFile(mod_ref, path, &err as mut void*);
        if (rc != 0) {
            const note: string = if (err != null) { err as string } else { "(no detail)" };
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                fmt::format("failed to write IR text to %s: %s", path, note));
            if (err != null) { llvm::LLVMDisposeMessage(err as mut void*); }
            return PassResult::failure(1);
        }
        if (err != null) { llvm::LLVMDisposeMessage(err as mut void*); }
        ctx.artifacts.linked = LinkedOutput { object_file_path: path };
        Log::debug(LogArea::Codegen, f"emitted ir text {path}");
        return PassResult::ok();
    }


    /// Linking pass.  Invokes the system linker (`cc`) to combine all
    /// per-module object files emitted during Phase 7 into the final
    /// executable at `{output_dir}/{project_name}` (build root).  Pulls link
    /// libs/paths from the parsed cryoconfig, and tacks on the stdlib
    /// archive whenever `no_std` is not set.
    static run_linking(ctx: mut CompilationContext*) -> PassResult {
        if (ctx.artifacts.object_files.length() == 0) {
            // Nothing to link: library/stdlib batch build, or codegen
            // was disabled (LSP mode).  Not an error.
            return PassResult::ok();
        }
        // `-o foo.o` / `foo.s` / `foo.ll` on a single-file build: the
        // entry module's artifact was already written by ObjectEmission
        // directly to the override path; there is no executable to link.
        if (ctx.options.output.is_unlinked_artifact()) {
            return PassResult::ok();
        }
        if (!ctx.project_config.requires_entry_point()) {
            // Library / stdlib target: no executable to produce, but
            // bundle the per-module .o files into a single archive that
            // executable projects can pick up via `<root>/<output>/lib<name>.a`.
            // The stdlib's own build writes `libcryo.a` and its manifest.
            return CodegenPasses::bundle_archive(ctx);
        }

        const cfg: ProjectConfig* = ctx.project_config;
        const output_dir: string = cfg.output_dir;

        // Resolve the toolchain for the effective triple.  For host
        // builds (empty triple, or triple == host) this picks `cc` plus
        // the `-lm -lstdc++` line.  For x86_64 windows-gnu it picks the
        // mingw-w64 driver.  For triples we don't
        // know how to drive end-to-end (aarch64, riscv, windows-msvc,
        // ...) `supported` is false and we keep the historic
        // object-files-only bailout below.
        const effective_triple: string = ctx.options.target_triple;
        const link_cfg: LinkerConfig = LinkerConfig::linker_config_for_triple(effective_triple);

        if (!link_cfg.supported) {
            const obj_only_dir: string = cfg.profile_dir();
            fmt::println(f"Cross-compile: produced {ctx.artifacts.object_files.length()} object file(s) for target '{ctx.options.target_triple}' in {obj_only_dir}");
            fmt::println(f"  (host linker skipped; link with a {ctx.options.target_triple}-aware toolchain, e.g.:");
            fmt::println(f"     clang --target={ctx.options.target_triple} {obj_only_dir}/*/deps/*.o -o <output>)");
            return PassResult::ok();
        }

        // The executable is linked under the per-profile cache
        // (`<output_dir>/target/<profile>/<name>[.exe]`) and HOISTED to
        // the build root afterwards; ensure the per-profile dir exists
        // for custom `--build-dir=...` paths that haven't been
        // pre-created.
        const profile_dir: string = cfg.profile_dir();
        ProjectConfig::mkdir_p(profile_dir);
        // Test-mode builds use a `-test` suffix so the test executable
        // coexists with a normal `cryo run` build of the same project.
        // The `.exe` suffix (Windows targets) goes on top of `-test` so
        // a windows test binary is `<name>-test.exe`.  Routed through
        // `profile_bin_path_for_target` so the same suffix logic the
        // incremental-build manifest uses applies here.
        const exe_path: string = CodegenPasses::profile_bin_path_for_target(cfg, ctx);

        // Build the link command.  libc's system(3) runs `sh -c`, so
        // every interpolated path must be shell-quoted; without it, a
        // working directory with a space breaks the link, and a path
        // containing shell metacharacters is a command-injection hazard.
        //
        // The object list goes in an @response-file rather than inline on
        // the command line, for the SAME reason `bundle_archive` does it:
        // a real project (the self-hosted compiler itself is ~520 objects)
        // blows straight past `cmd /c`'s ~8191-char command-line cap on a
        // native Windows host, where `system(3)` routes through cmd - the
        // historic "The command line is too long." native self-host link
        // failure.  gcc / clang / cc all accept `@file` with one
        // whitespace- or newline-separated, optionally double-quoted entry
        // per object; the `@"%s"` spelling (literal double quotes, not
        // `shell_quote`'s single quotes) matches the archiver precedent so
        // it parses identically under `sh -c` and `cmd /c`.  Same objects,
        // same order, same libs => a byte-identical executable on every
        // host, so selfhost byte-identity is unaffected.
        const link_rsp_path: string = fmt::format("%s.rsp", exe_path).into_raw();
        if (!CodegenPasses::write_rsp_file(link_rsp_path, &ctx.artifacts.object_files)) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                fmt::format("could not open linker response file for writing: %s", link_rsp_path));
            return PassResult::failure(1);
        }

        const link_driver: string = link_cfg.link_driver();
        mut cmd: string = fmt::format("%s -o %s @\"%s\"",
            link_driver, CodegenPasses::link_quote(exe_path), link_rsp_path).into_raw();
        // The prebuilt stdlib archive (`prebuilt_stdlib`) supplies what the
        // program's stdlib modules' objects no longer define.  It comes right
        // after the objects, ahead of the libraries the project names: its
        // members call into those (`std::net::tls` into the OpenSSL a
        // project using it lists), and a library is searched only for what
        // is undefined when the linker reaches it.  The members holding the
        // startup code of a stdlib module the program reaches are named
        // whole before it: nothing refers to startup code, so the linker
        // would leave those members out.
        if (ctx.prebuilt_stdlib != null) {
            for (mut p: i64 = 0; p < ctx.module_graph.topo_order.length(); p++) {
                const info: ModuleInfo* = &ctx.module_graph.modules[ctx.module_graph.topo_order[p]];
                const is_stdlib_module: boolean = match (info.origin) {
                    ModuleOrigin::Stdlib => { true }
                    _ => { false }
                };
                if (!is_stdlib_module) { continue; }
                const namespace_name: string = ctx.intern_table.shown(info.path().decl_name());
                const at: i64 = ctx.prebuilt_stdlib.module_index(namespace_name);
                if (at < 0 || !ctx.prebuilt_stdlib.modules[at].startup) { continue; }
                ctx.artifacts.record_startup(namespace_name,
                    PrebuiltStdlib::startup_priority(true, ctx.prebuilt_stdlib.modules[at].rank as i64));
                cmd = fmt::format("%s %s", cmd, CodegenPasses::link_quote(ctx.prebuilt_stdlib.modules[at].object)).into_raw();
            }
            cmd = fmt::format("%s %s", cmd, CodegenPasses::link_quote(ctx.prebuilt_stdlib.archive())).into_raw();
        }
        // `no_runtime`: freestanding link.  `-nostartfiles` drops crt0 (the
        // runtime provides its own `_start`), `-nostdlib` drops the default
        // libc/libm and the compiler runtime.  The stdlib archive and
        // `extra_system_libs` are also suppressed below.  The tail differs by
        // OS ABI:
        //   - Linux (and other ELF): `-static` removes the dynamic-loader
        //     dependency; the result imports nothing.
        //   - Windows: there is no stable raw-syscall ABI, so the entry reaches
        //     the kernel through ntdll and kernel32.  Set the PE entry to the
        //     runtime's `_start` (the mingw default, `mainCRTStartup`, was
        //     dropped with crt0).  Not `-static`: ntdll is always a DLL,
        //     reached through its import library.  The import libraries
        //     themselves are named by `append_runtime_tier_libs`, AFTER the
        //     tier archives that reference them — naming them here would put
        //     them ahead of those references, which ld would not resolve.
        if (cfg.no_runtime) {
            if (effective_triple.contains("windows")) {
                cmd = fmt::format("%s -nostartfiles -nostdlib -Wl,-e,_start", cmd).into_raw();
            } else {
                cmd = fmt::format("%s -nostartfiles -nostdlib -static", cmd).into_raw();
            }
        }
        // Project-configured linking ([link] in cryoconfig).  -L and -l are
        // single-token args with the value glued to the flag, so the
        // quoting goes around the value only.  `search` -> -L (extra dirs for
        // resolving `system` libs), `system` -> -l, `static` -> the archive
        // path passed to the linker verbatim.
        for (mut i: i64 = 0; i < cfg.link_search.length(); i++) {
            cmd = fmt::format("%s -L%s", cmd, CodegenPasses::link_quote(cfg.link_search[i])).into_raw();
        }
        for (mut i: i64 = 0; i < cfg.link_system.length(); i++) {
            cmd = fmt::format("%s -l%s", cmd, CodegenPasses::link_quote(cfg.link_system[i])).into_raw();
        }
        for (mut i: i64 = 0; i < cfg.link_static.length(); i++) {
            cmd = fmt::format("%s %s", cmd, CodegenPasses::link_quote(cfg.link_static[i])).into_raw();
        }
        // Per-OS overlay ([link.unix] / [link.windows]).  Appended after
        // the common set, so a project can carry platform-divergent libs
        // (e.g. the windows-gnu LLVM import lib + its lib dir vs the host's
        // `-lLLVM-20` under /usr/lib/llvm-20/lib) without the wrong set
        // leaking into a cross-compile.  The OS is read off the effective
        // triple; anything that isn't windows is treated as unix (the host
        // line and every other supported triple today).  Same flag shapes
        // as the common loops above: search -> -L, system -> -l, static
        // -> verbatim path.
        if (effective_triple.contains("windows")) {
            for (mut i: i64 = 0; i < cfg.link_search_windows.length(); i++) {
                cmd = fmt::format("%s -L%s", cmd, CodegenPasses::link_quote(cfg.link_search_windows[i])).into_raw();
            }
            for (mut i: i64 = 0; i < cfg.link_system_windows.length(); i++) {
                cmd = fmt::format("%s -l%s", cmd, CodegenPasses::link_quote(cfg.link_system_windows[i])).into_raw();
            }
            for (mut i: i64 = 0; i < cfg.link_static_windows.length(); i++) {
                cmd = fmt::format("%s %s", cmd, CodegenPasses::link_quote(cfg.link_static_windows[i])).into_raw();
            }
        } else {
            // The `[link.unix]` overlay carries the host libLLVM (`-lLLVM-20`
            // + its `-L/usr/lib/llvm-20/lib` search dir).  On a
            // `--release-static` build we replace that dynamic LLVM with the
            // static `.a` component set from llvm-config (spliced in below),
            // so skip the overlay's search/system entries here.  `[link.unix]`
            // is LLVM-only today; if it ever grows non-LLVM libs, switch this
            // to value-filtering "LLVM-20" rather than skipping the overlay.
            if (!ctx.options.static_link) {
                for (mut i: i64 = 0; i < cfg.link_search_unix.length(); i++) {
                    cmd = fmt::format("%s -L%s", cmd, CodegenPasses::link_quote(cfg.link_search_unix[i])).into_raw();
                }
                for (mut i: i64 = 0; i < cfg.link_system_unix.length(); i++) {
                    cmd = fmt::format("%s -l%s", cmd, CodegenPasses::link_quote(cfg.link_system_unix[i])).into_raw();
                }
            }
            for (mut i: i64 = 0; i < cfg.link_static_unix.length(); i++) {
                cmd = fmt::format("%s %s", cmd, CodegenPasses::link_quote(cfg.link_static_unix[i])).into_raw();
            }
        }
        // `--release-static`: splice the static libLLVM component set
        // (`-L<libdir> -lLLVMCore ... -lrt -ldl -lm -lz -lzstd -lxml2`) from
        // llvm-config in place of the dynamic `-lLLVM-20` skipped above.
        // Placed after the objects and the stdlib archive and before the
        // system libs, so the single-pass static link order is objects ->
        // libcryo.a -> LLVM -> libm/libstdc++.
        if (ctx.options.static_link) {
            const llvm_static: string = CodegenPasses::static_llvm_link_flags(CodegenPasses::pick_llvm_config());
            if (llvm_static.length() == 0) {
                ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    "could not obtain static LLVM link flags from llvm-config (is it installed? set CRYO_LLVM_CONFIG)");
                return PassResult::failure(1);
            }
            cmd = fmt::format("%s %s", cmd, llvm_static).into_raw();
        }
        // A freestanding link has no libc to satisfy the panic/alloc/backtrace
        // lang items, so the tier archives ARE the runtime and must all be on
        // the line.  A hosted link takes its allocator from libc, but still
        // needs the panic funnel (every panic calls the external `__cryo_panic`,
        // so exactly one panic tier must be named or the link fails on an
        // undefined symbol) and the core tier, which owns the entry.
        if (cfg.no_runtime) {
            cmd = CodegenPasses::append_runtime_tier_libs(ctx, cmd, effective_triple);
        } else {
            cmd = CodegenPasses::append_hosted_runtime_libs(ctx, cmd, effective_triple,
                &link_cfg, fmt::format("%s.probe", link_rsp_path).into_raw());
        }
        // Cryo runtime support is fully inline-lowered: every intrinsic
        // with a kind (ptr_diff, fpclass, atomic_*, dirent_*, ...) is
        // emitted directly into LLVM IR by IntrinsicEmitter.  No C runtime to link beyond what the
        // active target's system library line provides.  Under `no_runtime`
        // there is no libc/libm to pull in (they were dropped by
        // `-nostdlib` above), so the system-lib line is suppressed.
        if (!cfg.no_runtime) {
            cmd = fmt::format("%s %s", cmd, link_cfg.extra_system_libs).into_raw();
        }

        // `--release-static`: statically link libc (`-static`) and the C++
        // runtime (`-static-libstdc++ -static-libgcc`) so the produced binary
        // has no `libLLVM-20.so`/`libstdc++.so` runtime dependency.  These are
        // position-independent driver flags, so trailing placement is safe;
        // `-static-libstdc++` makes the earlier `-lstdc++` resolve to the
        // archive.  Linux host only (this branch is the unix link path).
        if (ctx.options.static_link) {
            cmd = fmt::format("%s -static -static-libstdc++ -static-libgcc", cmd).into_raw();
        }

        Log::debug(LogArea::Link, f"linking {ctx.artifacts.object_files.length()} objects into {exe_path}");
        Log::debug(LogArea::Link, f"startup order: {ctx.artifacts.startup_order()}");
        Log::debug(LogArea::Link, f"link command: {cmd}");

        mut link_out: string = "";
        const rc: i32 = CodegenPasses::run_tool(cmd, fmt::format("%s.log", link_rsp_path).into_raw(), &link_out);
        if (rc != 0) {
            // Keep the response file on the failure path: the command in the
            // diagnostic names it with `@`, so deleting it makes that command
            // unreplayable - the linker just reports the missing file instead
            // of the original error.
            ctx.emit_diagnostic(CodegenPasses::tool_failure(
                fmt::format("linker invocation failed (%s exited with %d)", link_driver, rc).into_raw(),
                cmd, link_rsp_path, link_out));
            return PassResult::failure(1);
        }
        // The response file has served its purpose; remove it so it doesn't
        // linger in the per-profile dir (best-effort - a failed unlink is
        // harmless).
        File::remove(Path::from(link_rsp_path));

        Log::debug(LogArea::Link, f"linked executable {exe_path}");

        // Hoist the freshly-linked binary from the per-profile cache up to
        // the build root (`<output_dir>/<name>[.exe]`) so it can be run
        // as `build/<name>[.exe]` regardless of which profile produced
        // it.  libc's system(3) runs `sh -c`, so both paths are
        // shell-quoted.
        const hoisted_exe: string = CodegenPasses::bin_artifact_path_for_target(cfg, ctx);
        ProjectConfig::mkdir_p(output_dir);
        // `hoist_binary` is host-shell-aware: `cp -f` on a POSIX-hosted
        // compiler, `copy /Y` (backslash paths) on a native Windows one.
        const hrc: i32 = CodegenPasses::hoist_binary(exe_path, hoisted_exe);
        if (hrc != 0) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                fmt::format("failed to hoist executable to %s (copy exited with %d)",
                    hoisted_exe, hrc));
            return PassResult::failure(1);
        }
        Log::debug(LogArea::Link, f"hoisted executable {hoisted_exe}");

        // Single-file `-o PATH` (Exe): mirror the hoisted binary to the
        // user's explicit output path.  The path is taken verbatim - no
        // `.exe` auto-append - since `-o` is explicit user intent.
        const exe_out: string = ctx.options.output.path();
        if (ctx.options.output.is_exe() && exe_out.length() > 0) {
            const orc: i32 = CodegenPasses::hoist_binary(hoisted_exe, exe_out);
            if (orc != 0) {
                ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    fmt::format("failed to copy executable to %s (copy exited with %d)",
                        exe_out, orc));
                return PassResult::failure(1);
            }
            Log::debug(LogArea::Link, f"copied executable to the -o path {exe_out}");
        }

        // Under `--emit-llvm`, link the per-module `.ll` files written during
        // code generation into one dump next to the HOISTED executable
        // (`<output_dir>/<name>.ll`), selfhost-check's input for its
        // stage-3/stage-4 byte-identity check.  Without it no `.ll` exists to
        // link.  POSIX-only (a shell glob); a no-op on a Windows-hosted
        // compiler.
        if (ctx.options.emit_llvm) {
            CodegenPasses::emit_linked_ir_dump(profile_dir, fmt::format("%s.ll", hoisted_exe).into_raw());
        }

        return PassResult::ok();
    }




    /// Bundle a library/stdlib target's per-module .o files into a single
    /// archive next to them.  The Stdlib target's is `libcryo.a`, which with
    /// its manifest is the archive programs link (`PrebuiltStdlib`); Library
    /// targets use `lib<project_name>.a` per the usual convention.
    /// `ar rcs` is idempotent; re-runs overwrite the archive cleanly.
    static bundle_archive(ctx: mut CompilationContext*) -> PassResult {
        if (ctx.project_config == null) {
            return PassResult::ok();
        }
        const cfg: ProjectConfig* = ctx.project_config;
        const archive_name: string = match (cfg.target_type) {
            TargetType::Stdlib => { "libcryo.a" }
            _                  => { fmt::format("lib%s.a", cfg.project_name).into_raw() }
        };
        // Archive lands at the build root (`<output_dir>/lib<name>.a`).
        ProjectConfig::mkdir_p(cfg.output_dir);
        const archive_path: string = cfg.lib_archive_path(archive_name);
        const bundled: PassResult = CodegenPasses::bundle_object_list(ctx, archive_path, &ctx.artifacts.object_files);
        if (!bundled.success || !ctx.module_graph.builds_standard_library) {
            return bundled;
        }
        // The stdlib's archive carries its manifest, keyed as a program's
        // build with the same options asks for it.
        const key: string = PrebuiltStdlib::key_of(cfg.project_root, ctx.options.target_triple,
            ctx.options.opt_level, ctx.options.debug_info, ctx.options.unwinds());
        const failure: string = PrebuiltStdlib::write_manifest(cfg.output_dir, key,
            ctx.options.target_triple, ctx.options.opt_level, ctx.options.debug_info,
            ctx.options.unwinds(), &ctx.artifacts.archived);
        if (failure.length() > 0) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR, failure);
            return PassResult::failure(1);
        }
        return bundled;
    }

    /// Archive an explicit object list into `archive_path`: the archiver
    /// behind `bundle_archive` (the `[lib]` / stdlib deliverable).
    static bundle_object_list(
        ctx: mut CompilationContext*, archive_path_text: string, objs: &[string]
    ) -> PassResult {
        const archive_path: string = archive_path_text;
        // Invoke `<ar> rcs <archive> @<response-file>`.  `r` replaces stale
        // members on re-bundle, `c` suppresses the empty-archive warning,
        // `s` writes the symbol index that `ld` consults to satisfy
        // references.
        //
        // Archiver selection mirrors `LinkerConfig::link_driver`'s `CRYO_CC` knob:
        // `CRYO_AR` overrides the default `ar`.  This is what lets a
        // Windows-hosted `cryo.exe` (e.g. run under wine) point at an
        // `llvm-ar.exe` it can actually launch, since the host's ELF `ar`
        // can't run there.
        //
        // The object list goes in an @response-file rather than on the
        // command line for TWO reasons: (1) a real compiler easily exceeds
        // the shell's argv limit on a large project - and under wine
        // `system(3)` routes through `cmd /c`, whose command line caps at
        // ~8191 chars (155 object paths blow straight past it, and cmd
        // truncates rather than erroring, crashing the archiver); (2) it
        // keeps the spawned command short and identical on every host.  Both
        // GNU `ar` and `llvm-ar` accept `@file` with one whitespace- or
        // newline-separated, optionally-quoted entry per object.
        //
        // Paths are wrapped in DOUBLE quotes (not `shell_quote`'s single
        // quotes), matching the cross-platform `c_header_import` precedent:
        // `system(3)` runs `sh -c` on POSIX but `cmd /c` on Windows, and
        // `cmd` treats single quotes as literal characters while honouring
        // double quotes; the archiver's own response-file parser likewise
        // honours double quotes.  The tool token is left unquoted (as
        // `c_header_import` leaves `cc`) so a quoted-path first token can't
        // trip cmd's outer-quote-stripping rule.
        const ar: string = CodegenPasses::pick_archiver();
        const rsp_path: string = fmt::format("%s.rsp", archive_path).into_raw();
        if (!CodegenPasses::write_rsp_file(rsp_path, objs)) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                fmt::format("could not open archiver response file for writing: %s", rsp_path));
            return PassResult::failure(1);
        }

        const cmd: string = fmt::format("%s rcs \"%s\" @\"%s\"", ar, archive_path, rsp_path).into_raw();

        Log::debug(LogArea::Link, f"archiving {objs.length()} objects into {archive_path} (response file {rsp_path})");
        Log::debug(LogArea::Link, f"archive command: {cmd}");

        mut ar_out: string = "";
        const rc: i32 = CodegenPasses::run_tool(cmd, fmt::format("%s.log", rsp_path).into_raw(), &ar_out);
        if (rc != 0) {
            // Retained on failure so the reported command can be re-run; see
            // the project link path for the reasoning.
            ctx.emit_diagnostic(CodegenPasses::tool_failure(
                fmt::format("ar invocation failed (exited with %d)", rc).into_raw(), cmd, rsp_path, ar_out));
            return PassResult::failure(1);
        }
        // Drop the response file now the archiver has read it (best-effort).
        File::remove(Path::from(rsp_path));

        Log::debug(LogArea::Link, f"archived {archive_path} ({objs.length()} objects)");
        return PassResult::ok();
    }

    /// True when the module currently being emitted is the project's
    /// discovery root (the executable entry point / library root).  Used to
    /// scope `-o PATH` overrides: a single-file build is a synthesized
    /// one-entry project whose stdlib imports compile as real modules, so
    /// only the ENTRY module's artifact may honor the override.
    static is_entry_module_active(ctx: CompilationContext*) -> boolean {
        if (ctx.project_config == null) { return false; }
        return CodegenPasses::paths_equal_loose(ctx.source_file,
            ctx.project_config.discovery_root_path());
    }

    /// Returns true if the LLVM function `fn_val` is in the
    /// stripped-functions set.
    static is_stripped(cg: CodegenContext*, fn_val: void*) -> boolean {
        if (fn_val == null) { return false; }
        return cg.diag.is_stripped(fn_val);
    }

    /// Walk a function's basic blocks and instructions; if any call instruction
    /// targets a function whose mangled name is in the stripped-functions set,
    /// return true.  Used by the cascade-strip pass to identify callers of
    /// stripped same-module siblings (e.g. `Array<T>::quicksort` calling a
    /// stripped `Array<T>::partition`).
    static function_calls_stripped(cg: CodegenContext*, fn_val: mut void*) -> boolean {
        if (fn_val == null) { return false; }
        mut bb: mut void* = llvm::LLVMGetFirstBasicBlock(fn_val);
        while (bb != null) {
            mut inst: mut void* = llvm::LLVMGetFirstInstruction(bb);
            while (inst != null) {
                // CallBr (asm goto) does not appear in generated IR.
                const instruction: LValue = LValue { raw: inst };
                if (instruction.opcode() == LOpcode::Call) {
                    // Last operand of a call instruction is the called value.
                    const n: i32 = llvm::LLVMGetNumOperands(inst);
                    if (n > 0) {
                        const callee: void* = llvm::LLVMGetOperand(inst, (n - 1) as u32);
                        if (callee != null && CodegenPasses::is_stripped(cg, callee)) {
                            return true;
                        }
                    }
                }
                inst = llvm::LLVMGetNextInstruction(inst);
            }
            bb = llvm::LLVMGetNextBasicBlock(bb);
        }
        return false;
    }

    /// Create the per-module DWARF scaffolding when `ctx.options.debug_info` is
    /// set: a DIBuilder, a DIFile for the module's source path, a
    /// DICompileUnit, and the module-level `Debug Info Version` / `Dwarf
    /// Version` flags (without which the backend drops all debug metadata).
    /// The handles go on `cg.debug_info` for the function prologue to attach
    /// per-function DISubprograms; `LLVMDIBuilderFinalize` must be called
    /// before verification. No-op when debug info is off.
    static setup_debug_info(ctx: CompilationContext*, cg: mut CodegenContext*) -> void {
        if (!ctx.options.debug_info) { return; }
        const module_raw: mut void* = cg.llvm_module.raw;

        const dib: mut void* = llvm::LLVMCreateDIBuilder(module_raw);

        // DIFile: the module's source file as the program names it, and "."
        // as the directory; debuggers join the two.
        const src: string = ctx.program_file_names.name_of(ctx.source_file);
        const file: mut void* = llvm::LLVMDIBuilderCreateFile(
            dib, src, src.length() as u64, ".", 1);
        cg.debug_info = DebugInfoState { builder: dib, file: file };

        // DICompileUnit: Lang = C (1), EmissionKind = Full (1); other flags off.
        // The builder keeps it; nothing here reads it back.
        const producer: string = "Cryo compiler";
        llvm::LLVMDIBuilderCreateCompileUnit(
            dib, 1, file,
            producer, producer.length() as u64,
            0,            // isOptimized
            "", 0,        // Flags
            0,            // RuntimeVer
            "", 0,        // SplitName
            1,            // EmissionKind = Full
            0,            // DWOId
            0,            // SplitDebugInlining
            0,            // DebugInfoForProfiling
            "", 0,        // SysRoot
            "", 0);       // SDK

        // Module flags (behavior Warning = 1). "Debug Info Version" must be 3
        // (DEBUG_METADATA_VERSION) or LLVM silently strips the debug info.
        // i32 in the per-target codegen context (LType::i32 routes through
        // LContext::current()), so these module-flag constants match the
        // module's context rather than the global one.
        const ver_key: string = "Debug Info Version";
        const dver: mut void* = llvm::LLVMValueAsMetadata(
            llvm::LLVMConstInt(LType::i32().raw, 3, 0));
        llvm::LLVMAddModuleFlag(module_raw, 1, ver_key, ver_key.length() as u64, dver);
        const dwarf_key: string = "Dwarf Version";
        const dwarf: mut void* = llvm::LLVMValueAsMetadata(
            llvm::LLVMConstInt(LType::i32().raw, 4, 0));
        llvm::LLVMAddModuleFlag(module_raw, 1, dwarf_key, dwarf_key.length() as u64, dwarf);
    }

    /// Iterate the module's functions until no more cascade-strips happen.
    /// For each function with a body that calls a stripped sibling, strip it
    /// (which adds it to the stripped set, potentially triggering more
    /// strips on its own callers in the next iteration).
    ///
    /// Emits a warning per cascade strip so the user can see the chain of
    /// downstream casualties from the original codegen failure.  We use a
    /// warning rather than an error here because the *primary* failure is
    /// already reported by `report_invalid_function_body`; cascade entries
    /// are downstream noise that exists only to avoid the worse alternative
    /// of a half-built body that fails LLVM verification.
    static cascade_strip_dependents(cg: mut CodegenContext*) -> void {
        mut iterations: i32 = 0;
        while (iterations < 16) {
            mut newly_stripped: i32 = 0;
            mut fn_val: mut void* = llvm::LLVMGetFirstFunction(cg.llvm_module.raw);
            while (fn_val != null) {
                const next_fn: mut void* = llvm::LLVMGetNextFunction(fn_val);
                // Only consider functions WITH a body.
                const first_bb: void* = llvm::LLVMGetFirstBasicBlock(fn_val);
                if (first_bb != null) {
                    if (CodegenPasses::function_calls_stripped(cg, fn_val)) {
                        // Don't double-strip a function that's already in the set.
                        const fn_name: string = llvm::LLVMGetValueName(fn_val) as string;
                        if (!CodegenPasses::is_stripped(cg, fn_val)) {
                            const fn_name_safe: string = if (fn_name == null) {
                                "<unnamed>"
                            } else {
                                fn_name
                            };
                            mut wdiag: Diagnostic = Diagnostic::warning(
                                ErrorCode::E0633_FUNCTION_BODY_ERROR,
                                fmt::format("codegen: function `%s` transitively stripped because it calls a previously-stripped sibling in this module; see preceding error",
                                    fn_name_safe));
                            cg.diag.emit(wdiag);
                            const wrap: LValue = LValue { raw: fn_val };
                            cg.diag.strip_function_body(wrap);
                            newly_stripped += 1;
                        }
                    }
                }
                fn_val = next_fn;
            }
            if (newly_stripped == 0) { break; }
            iterations += 1;
        }
    }

    // ---- Toolchain probing + path helpers ----

    /// POSIX-shell-safe quote a path or argument for use in `system()` /
    /// `sh -c` commands.  Wraps the input in single quotes and rewrites any
    /// embedded single quote as the four-byte sequence `'\''`; single-quoted
    /// strings are not interpreted by `/bin/sh` at all, so this neutralises
    /// every shell metacharacter (spaces, $, `, *, ;, !, &, etc).
    ///
    /// libc's `system(3)` runs the command through `sh -c`, so any
    /// interpolated user-controlled path needs this treatment.  Without it,
    /// a working directory with a space breaks linking, and a path containing
    /// shell metacharacters is an arbitrary-command-execution hazard.
    static shell_quote(s_text: string) -> string {
        const s: string = s_text;
        const len: i64 = s.length();
        // Worst case: every byte is a single quote, expanding to 4 bytes,
        // plus two outer quotes and a NUL terminator.
        const cap: i64 = len * 4 + 3;
        mut sbuf: String = String::with_capacity(cap);
        sbuf.push_byte('\'' as u8);
        const sb: i8* = s as i8*;
        for (mut i: i64 = 0; i < len; i++) {
            const ch: i8 = sb[i];
            if (ch == '\'') {
                sbuf.push_byte('\'' as u8);
                sbuf.push_byte('\\' as u8);
                sbuf.push_byte('\'' as u8);
                sbuf.push_byte('\'' as u8);
            } else {
                sbuf.push_byte(ch as u8);
            }
        }
        sbuf.push_byte('\'' as u8);
        return sbuf.into_raw();
    }

    /// Pick the static archiver binary.  `CRYO_AR` overrides everything,
    /// mirroring `LinkerConfig::link_driver`'s `CRYO_CC` knob - this is what lets a
    /// Windows-hosted `cryo.exe` under wine point at an `llvm-ar.exe` it can
    /// launch, since the host's ELF `ar` cannot run there.  With no override
    /// the first of `ar`, `llvm-ar`, `llvm-ar-20` found on `PATH` is used
    /// (`ExecutablePath`; nothing is launched to find it): `ar` is there on
    /// every POSIX host and on a mingw box, where binutils ships it.
    static pick_archiver() -> string {
        match (env::var(Str::new("CRYO_AR"))) {
            Option::Some(v) => {
                // Returned as-is, so persist it: `into_raw` yields an owned
                // NUL-terminated `string` (empty is treated as unset below).
                const env_val: string = v.into_raw();
                if (env_val.length() > 0) { return env_val; }
            }
            Option::None => {}
        }
        if (ExecutablePath::find("ar").length() > 0)         { return "ar"; }
        if (ExecutablePath::find("llvm-ar").length() > 0)    { return "llvm-ar"; }
        if (ExecutablePath::find("llvm-ar-20").length() > 0) { return "llvm-ar-20"; }
        return "ar";
    }

    /// Resolve the `llvm-config` binary used to derive the static-link lib set
    /// for `--release-static`.  `CRYO_LLVM_CONFIG` overrides; default
    /// `llvm-config-20` (matches the LLVM 20 the compiler is built against).
    /// Only consulted on the `--release-static` path, so a normal dev build
    /// never needs it present.  The env override is what lets a musl release
    /// build under Alpine point at its own `llvm-config` (which reports the
    /// musl-built static `.a` set) with no source change.
    static pick_llvm_config() -> string {
        match (env::var(Str::new("CRYO_LLVM_CONFIG"))) {
            Option::Some(v) => {
                const env_val: string = v.into_raw();
                if (env_val.length() > 0) { return env_val; }
            }
            Option::None => {}
        }
        return "llvm-config-20";
    }

    /// Slurp `<llvm-config> --ldflags --libs --system-libs --link-static` and
    /// return it as one space-separated flag string (`-L<libdir> -lLLVMCore ...
    /// -lrt -ldl -lm -lz -lzstd -lxml2`) for splicing into the `--release-static`
    /// link line.  This is how the 200+ component `.a` set AND its search dir are
    /// obtained without hardcoding a list/path that would drift across LLVM
    /// packagings - the `-L` from `--ldflags` is what makes this portable to a
    /// musl/Alpine release where the static libs live elsewhere.  llvm-config
    /// emits the sections in flag order: `-L` first, then the component libs,
    /// then the system libs - the correct single-pass static link order.
    /// Returns "" on spawn failure, empty output, or a non-zero exit so the
    /// caller can fail the link with a clear diagnostic.  Captures the tool's
    /// stdout via `Command::output()`.  Runs at link time (after IR is emitted),
    /// so it never touches the `.ll` the selfhost gate compares.
    static static_llvm_link_flags(llvm_config_text: string) -> string {
        const llvm_config: string = llvm_config_text;
        mut probe: Command = Command::new(Str::new(llvm_config));
        probe.arg(Str::new("--ldflags"));
        probe.arg(Str::new("--libs"));
        probe.arg(Str::new("--system-libs"));
        probe.arg(Str::new("--link-static"));
        match (probe.output()) {
            Result::Ok(out) => {
                mut o: Output = out;
                if (!o.status().success()) { return ""; }
                const bytes: &Slice<u8> = o.stdout();
                if (bytes.length() == 0) { return ""; }
                // llvm-config prints `--libs` and `--system-libs` on separate
                // lines; flatten every newline to a space so the result is one
                // flat argument string (libs first, then system libs - the
                // correct single-pass static link order).
                mut flags: String = String::new();
                mut i: i64 = 0;
                while (i < bytes.length()) {
                    const b: u8 = bytes.get(i).unwrap_or(0 as u8);
                    if (b == 10 as u8 || b == 13 as u8) { flags.push_byte(32 as u8); }
                    else { flags.push_byte(b); }
                    i++;
                }
                return flags.into_raw();
            }
            Result::Err(_) => { return ""; }
        }
    }

    /// Byte-wise path equality that treats `/` and `\` as the same
    /// separator.  `ctx.source_file` and `discovery_root_path()` are built
    /// by different code paths and can disagree on separator style on a
    /// native Windows host even when they name the same file.
    static paths_equal_loose(a_text: string, b_text: string) -> boolean {
        const a: string = a_text;
        const b: string = b_text;
        const la: i64 = a.length() as i64;
        const lb: i64 = b.length() as i64;
        if (la != lb) { return false; }
        const ab: i8* = a as i8*;
        const bb: i8* = b as i8*;
        for (mut i: i64 = 0; i < la; i++) {
            const ca: i8 = ab[i];
            const cb: i8 = bb[i];
            if (ca != cb) {
                const ca_sep: boolean = (ca == '/' || ca == '\\');
                const cb_sep: boolean = (cb == '/' || cb == '\\');
                if (!ca_sep || !cb_sep) { return false; }
            }
        }
        return true;
    }

    /// Per-profile link-target path for the active target, with `.exe`
    /// applied on Windows.  Wraps `ProjectConfig::profile_bin_path` so the
    /// suffix logic lives in one place; `run_linking` writes to this path
    /// and the incremental-build manifest in instance.cryo stats it.
    static profile_bin_path_for_target(cfg: ProjectConfig*,
                                         ctx: CompilationContext*) -> string {
        const tri: string = ctx.options.target_triple;
        const lc:  LinkerConfig = LinkerConfig::linker_config_for_triple(tri);
        const path: string = cfg.profile_bin_path(ctx.options.mode.skip_user_main());
        return if (path.ends_with(lc.exe_suffix)) { path } else { path.append(lc.exe_suffix) };
    }

    /// Hoisted (build-root) executable path for the active target, with
    /// `.exe` applied on Windows.  Same shape as
    /// `profile_bin_path_for_target` but lands the file at the user-facing
    /// `<output_dir>/<name>[.exe]` instead of the per-profile cache.
    static bin_artifact_path_for_target(cfg: ProjectConfig*,
                                          ctx: CompilationContext*) -> string {
        const tri: string = ctx.options.target_triple;
        const lc:  LinkerConfig = LinkerConfig::linker_config_for_triple(tri);
        const path: string = cfg.bin_artifact_path(ctx.options.mode.skip_user_main());
        return if (path.ends_with(lc.exe_suffix)) { path } else { path.append(lc.exe_suffix) };
    }
}


// ===========================================================================
// Parallel per-module object emission
// ===========================================================================

/// Where + how a module's IR is emitted, resolved on the MAIN thread by
/// `CodegenPasses::resolve_emit_target` (it needs `ctx` + the module graph)
/// and consumed by both the serial `run_object_emission` and the parallel
/// producer in instance.cryo.
type struct EmitTarget {
    is_ir_text:      boolean;   // pure IR text dump - no target machine
    emit_path:       string;
    emit_type:       LFileType; // Object / Assembly
    should_register: boolean;   // feed this .o to the linker
}

// ---------------------------------------------------------------------------
// Per-module context auditor (gated by CRYO_CTX_AUDIT; zero cost otherwise).
// Reports any LLVM type reachable from a module whose owning LLVMContext is not
// the module's own - i.e. a type that leaked into the process-global context and
// is therefore SHARED across every per-module context.  Such sharing is fatal
// for the zero-copy threaded emitter (concurrent emit would race the shared
// object's use-list), so this is the invariant check that guards it: a green run
// means every module is fully self-contained and safe to emit in parallel.  It
// found the `LLVMAppendBasicBlock` (global-context) leak; keep it as a guard
// against reintroducing that whole class of bug.
// ---------------------------------------------------------------------------
function ctx_audit_type(ty: mut void*, mod_ctx: void*, seen: mut [void*]*,
                        mod_name: string, whence: string) -> void {
    if (ty == null) { return; }
    for (mut i: i64 = 0; i < (*seen).length() as i64; i++) {
        if ((*seen)[i] == ty) { return; }
    }
    (*seen).push(ty);
    if (llvm::LLVMGetTypeContext(ty) != mod_ctx) {
        const ts: string = llvm::LLVMPrintTypeToString(ty) as string;
        fmt::eprintln(f"[ctxaudit] {mod_name}: FOREIGN-CTX type via {whence}: {ts}");
        return;
    }
    const kind: i32 = llvm::LLVMGetTypeKind(ty);
    if (kind == 10) {                       // Struct
        const n: u32 = llvm::LLVMCountStructElementTypes(ty);
        for (mut e: u32 = 0; e < n; e++) {
            ctx_audit_type(llvm::LLVMStructGetTypeAtIndex(ty, e), mod_ctx, seen, mod_name, whence);
        }
    } else if (kind == 11 || kind == 13) {  // Array / Vector
        ctx_audit_type(llvm::LLVMGetElementType(ty), mod_ctx, seen, mod_name, whence);
    } else if (kind == 9) {                 // Function (return type only)
        ctx_audit_type(llvm::LLVMGetReturnType(ty), mod_ctx, seen, mod_name, whence);
    }
}

function ctx_audit_module(module_raw: mut void*, mod_name: string) -> void {
    const mod_ctx: void* = llvm::LLVMGetModuleContext(module_raw);
    mut seen: [void*] = [];
    mut g: mut void* = llvm::LLVMGetFirstGlobal(module_raw);
    while (g != null) {
        ctx_audit_type(llvm::LLVMGlobalGetValueType(g), mod_ctx, &seen, mod_name, "global-valtype");
        const init: mut void* = llvm::LLVMGetInitializer(g);
        if (init != null) {
            ctx_audit_type(llvm::LLVMTypeOf(init), mod_ctx, &seen, mod_name, "global-init");
        }
        g = llvm::LLVMGetNextGlobal(g);
    }
    mut f: mut void* = llvm::LLVMGetFirstFunction(module_raw);
    while (f != null) {
        ctx_audit_type(llvm::LLVMGlobalGetValueType(f), mod_ctx, &seen, mod_name, "fn-type");
        mut bb: mut void* = llvm::LLVMGetFirstBasicBlock(f);
        while (bb != null) {
            mut inst: mut void* = llvm::LLVMGetFirstInstruction(bb);
            while (inst != null) {
                ctx_audit_type(llvm::LLVMTypeOf(inst), mod_ctx, &seen, mod_name, "inst-type");
                const nops: i32 = llvm::LLVMGetNumOperands(inst);
                for (mut k: i32 = 0; k < nops; k++) {
                    const op: mut void* = llvm::LLVMGetOperand(inst, k as u32);
                    if (op != null) {
                        ctx_audit_type(llvm::LLVMTypeOf(op), mod_ctx, &seen, mod_name, "operand-type");
                    }
                }
                inst = llvm::LLVMGetNextInstruction(inst);
            }
            bb = llvm::LLVMGetNextBasicBlock(bb);
        }
        f = llvm::LLVMGetNextFunction(f);
    }
}

type struct EmitJob {
    // ZERO-COPY emit: the producer hands the worker the LIVE module directly,
    // in its OWN `LLVMContext`, plus a target machine built on the MAIN thread.
    // Every module is fully self-contained in its own context (verified by the
    // context auditor - no type leaks into the shared global context), so
    // concurrent `LLVMTargetMachineEmitToFile` over disjoint modules touches no
    // shared LLVM state.  The worker also allocates NO Cryo memory (it makes the
    // raw LLVM emit call and defers error reporting to the main thread), so the
    // compiler's single-threaded bump arena is never accessed off the main
    // thread - no round-trip, no arena pause.
    llvm_module:     mut void*;     // LLVMModuleRef (live), owned by this job
    llvm_context:    mut void*;     // its LLVMContextRef, owned by this job
    tm:              mut void*;     // LLVMTargetMachineRef, built on the main thread
    module_name:     string;
    /// The module's place in the topological codegen order.
    position:        u32;
    emit_path:       string;
    emit_type:       LFileType;
    triple:          string;
    opt_level:       u32;
    should_register: boolean;
    /// False for a module holding a function of no type, which the verifier
    /// would crash on.
    verifiable:      boolean;
    /// The per-module object cache is in effect: the job takes the module's
    /// key, starting from `key_hasher` (the toolchain already folded in).
    keyed:           boolean;
    key_hasher:      ContentHasher;
    /// The key an earlier build emitted the object at `emit_path` under,
    /// when that object is still there.
    reusable:        boolean;
    prior_key:       u128;
    /// The module is past its verification and key, so the job optimizes
    /// and emits it.
    emitting:        boolean;
    verify_failed:   boolean;   // result: the verifier refused the module
    verify_message:  string;    // result: the verifier's report (LLVM-owned)
    key:             u128;      // result: the module's key, when `keyed`
    reused:          boolean;   // result: the earlier object is this build's
    /// Result: the key differs from a reusable object's, so that object must
    /// be removed before this module's is emitted; the main thread removes
    /// it and hands the job back with `emitting` set.
    awaits_emission: boolean;
    optimization_failed: boolean;   // result: LLVM refused the IR pipeline
    ok:              boolean;   // result: emission succeeded
    err_msg:         string;    // LLVM error message on failure (worker-set;
                                // the main thread reports it and disposes it)
    // When the job verified and keyed the module, optimized it and emitted
    // its object, and on which worker (0 = the main thread, worker `w` =
    // `w + 1`), for the time trace.
    verify_start_ns:   i64;
    optimize_start_ns: i64;
    emit_start_ns:     i64;
    end_ns:            i64;
    thread:            u32;
    /// The main thread has seen this slot's job finish.
    handled:           boolean;

    /// A job with nothing in it, for a slot of the emission table.
    static unfilled() -> EmitJob {
        return EmitJob {
            llvm_module: null, llvm_context: null, tm: null,
            module_name: "", position: 0,
            emit_path: "", emit_type: LFileType::Object, triple: "",
            opt_level: 0, should_register: false, verifiable: false,
            keyed: false, key_hasher: ContentHasher::new(), reusable: false, prior_key: 0,
            emitting: false, verify_failed: false, verify_message: null as string,
            key: 0, reused: false, awaits_emission: false,
            optimization_failed: false, ok: false, err_msg: null as string,
            verify_start_ns: 0, optimize_start_ns: 0, emit_start_ns: 0, end_ns: 0, thread: 0,
            handled: false
        };
    }

    /// Verify the module as it will be emitted, take its key, and decide
    /// whether an earlier object stands for it: `reused` when its key is
    /// the reusable object's, `awaits_emission` when there is a reusable
    /// object under another key, else `emitting`.  Allocation-free on the
    /// Cryo side, so a worker may run it.
    verify_and_key(mut &this) -> void {
        const emitted: LModule = LModule { raw: this.llvm_module };
        if (this.verifiable) {
            this.verify_message = emitted.verification_failure();
            if (this.verify_message != null) {
                this.verify_failed = true;
                return;
            }
        }
        if (this.keyed) {
            emitted.fold_bitcode(&this.key_hasher);
            this.key = this.key_hasher.finish128();
            if (this.reusable) {
                if (this.key == this.prior_key) {
                    this.reused = true;
                    this.ok = true;
                    return;
                }
                this.awaits_emission = true;
                return;
            }
        }
        this.emitting = true;
    }

    /// Dispose the job's target machine, module and context, and clear
    /// them so the job reads as released.  Allocation-free on the Cryo
    /// side, so a worker may run it; its results stay for the main thread.
    release(mut &this) -> void {
        if (this.tm != null) {
            mut machine: LTargetMachine = LTargetMachine { raw: this.tm };
            machine.dispose();
            this.tm = null;
        }
        if (this.llvm_module != null) {
            mut released: LModule = LModule { raw: this.llvm_module };
            released.dispose();
            this.llvm_module = null;
        }
        if (this.llvm_context != null) {
            mut context: LContext = LContext { raw: this.llvm_context };
            context.dispose();
            this.llvm_context = null;
        }
    }
}

/// Verify, key, optimize and emit ONE module's object file from its own
/// standalone LLVM context, on the main thread or on a `WorkerPool` worker.
/// Touches only LLVM state private to this job - never `ctx`, the arena, or
/// the intern table - and allocates no Cryo memory, so the main thread keeps
/// the bump arena to itself while it generates the next module's IR: errors
/// are left in the job as LLVM's own message pointers, for the main thread
/// to report and dispose.  The job releases its module, context and target
/// machine when it is done with them - when the module failed verification,
/// was reused, or was emitted - and keeps them when it stops for the main
/// thread to remove an earlier object (`awaits_emission`).  The context is
/// this job's own, so disposing it touches nothing another worker is
/// emitting.  A top-level function, so it can be handed to the pool as a
/// function pointer: a lambda could not call the generic LLVM wrappers it
/// uses.
function codegen_emit_job(job: mut EmitJob*, thread: u32) -> void {
    (*job).thread = thread;
    if ((*job).tm == null || (*job).llvm_module == null) {
        (*job).emitting = true;
        (*job).ok = false;
        (*job).release();
        return;
    }
    if (!(*job).emitting) {
        (*job).verify_start_ns = TimeTrace::now();
        (*job).verify_and_key();
        (*job).optimize_start_ns = TimeTrace::now();
        (*job).emit_start_ns = (*job).optimize_start_ns;
        (*job).end_ns = (*job).optimize_start_ns;
        if ((*job).awaits_emission) { return; }
        if (!(*job).emitting) {
            (*job).release();
            return;
        }
    } else {
        (*job).optimize_start_ns = TimeTrace::now();
    }
    const machine: LTargetMachine = LTargetMachine { raw: (*job).tm };
    if (!machine.run_optimization_pipeline(LModule { raw: (*job).llvm_module }, (*job).opt_level)) {
        (*job).optimization_failed = true;
        (*job).ok = false;
        (*job).end_ns = TimeTrace::now();
        (*job).release();
        return;
    }
    (*job).emit_start_ns = TimeTrace::now();
    mut err: i8* = null;
    const rc: i32 = llvm::LLVMTargetMachineEmitToFile(
        (*job).tm, (*job).llvm_module, (*job).emit_path,
        (*job).emit_type as i32, &err as mut void*);
    (*job).err_msg = err as string;
    (*job).ok = rc == 0;
    (*job).end_ns = TimeTrace::now();
    (*job).release();
}
