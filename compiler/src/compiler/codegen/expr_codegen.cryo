/// Expression Codegen
///
/// Free functions for generating LLVM IR from each of the 24 expression
/// node types.  Each function takes a CodegenContext and the specific
/// node, and stores the result in the context for the caller to retrieve.

namespace Compiler::Codegen::ExprCodegen;

import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Codegen::TypeMap;
import Compiler::Codegen::Context;
import Compiler::CompilationContext;
import Compiler::Types;
import Compiler::Types::TypeRef;
import Compiler::Types::Type;
import Compiler::Types::Arena;
import Compiler::Types::UserDefined;
import Compiler::Types::Compound;
import Compiler::Types::Generic;
import Compiler::AST;
import Compiler::AST::Node;
import Compiler::AST::Expression;
import Compiler::AST::Declaration;
import Compiler::Lex;
import Compiler::Resolver::SymbolStr;
import Compiler::Resolver::InternTable;
import Compiler::Diag;
import Compiler::Diag::SourceSpan;
import std::collections::pair;


// ============================================================================
// Literal
// ============================================================================

/// Parse an integer literal lexeme into a u64.  Recognises C-style hex
/// (`0x`, `0X`), octal (`0`-prefix), binary (`0b`, `0B`) and decimal,
/// and skips an optional leading sign or `_` digit separators.  Returns
/// 0 on a malformed lexeme; the parser should already have rejected
/// those, so this is a defensive fallback rather than a real diagnostic.
///
/// `atoi` (the stdlib intrinsic the codegen used previously) ignores
/// any prefix that isn't a decimal digit, so `atoi("0x80")` returns 0
/// This silently miscompiled every hex constant in the lexer (e.g.
/// `0x80 as u8` → `i8 0`, breaking UTF-8 byte classification entirely).
function parse_int_lexeme(s: string) -> u64 {
    if (s == null) { return 0; }
    mut i: i64 = 0;
    mut negate: boolean = false;
    if (s[0] == '-') { negate = true; i = 1; }
    else if (s[0] == '+') { i = 1; }

    mut base: u64 = 10;
    if (s[i] == '0' && (s[i+1] == 'x' || s[i+1] == 'X')) {
        base = 16; i += 2;
    } else if (s[i] == '0' && (s[i+1] == 'b' || s[i+1] == 'B')) {
        base = 2;  i += 2;
    } else if (s[i] == '0' && s[i+1] >= '0' && s[i+1] <= '7') {
        base = 8;  i += 1;
    }

    mut acc: u64 = 0;
    while (s[i] != '\0') {
        const c: char = s[i];
        if (c == '_') { i += 1; continue; }
        mut digit: u64 = 0;
        if (c >= '0' && c <= '9')        { digit = (c - '0') as u64; }
        else if (c >= 'a' && c <= 'f')   { digit = (c - 'a' + 10) as u64; }
        else if (c >= 'A' && c <= 'F')   { digit = (c - 'A' + 10) as u64; }
        else { break; }
        if (digit >= base) { break; }
        acc = acc * base + digit;
        i += 1;
    }

    if (negate) { return (0 - acc as i64) as u64; }
    return acc;
}

/// Decode a character-literal lexeme: the raw text *between* the quotes,
/// as the lexer hands it over, to its code-point value.  `'\n'` arrives
/// as the two-char string "\n" (backslash + n), not 0x0A, so the C-style
/// escapes are resolved here.  Shared by `codegen_literal` (char literal
/// expressions) and `codegen_pattern_value` (char literal patterns).
function decode_char_lexeme(s: string) -> u64 {
    if (s == null) { return 0; }
    const len: i64 = intrinsics::strlen(s) as i64;
    if (len >= 2 && s[0] == '\\') {
        const esc: char = s[1];
        match (esc) {
            'n'  => { return 10; }
            't'  => { return 9; }
            'r'  => { return 13; }
            '0'  => { return 0; }
            '\\' => { return 92; }
            '\'' => { return 39; }
            '"'  => { return 34; }
            'a'  => { return 7; }
            'b'  => { return 8; }
            'f'  => { return 12; }
            'v'  => { return 11; }
            'x'  => {
                // `\xHH`: two hex digits.  A short `\x` (len < 4) is
                // malformed — fall through to the bare-escape default.
                if (len >= 4) {
                    mut hi: u64 = 0;
                    const c2: char = s[2];
                    if (c2 >= '0' && c2 <= '9') { hi = (c2 - '0') as u64; }
                    else if (c2 >= 'a' && c2 <= 'f') { hi = (c2 - 'a' + 10) as u64; }
                    else if (c2 >= 'A' && c2 <= 'F') { hi = (c2 - 'A' + 10) as u64; }
                    mut lo: u64 = 0;
                    const c3: char = s[3];
                    if (c3 >= '0' && c3 <= '9') { lo = (c3 - '0') as u64; }
                    else if (c3 >= 'a' && c3 <= 'f') { lo = (c3 - 'a' + 10) as u64; }
                    else if (c3 >= 'A' && c3 <= 'F') { lo = (c3 - 'A' + 10) as u64; }
                    return hi * 16 + lo;
                }
            }
            _ => { }
        }
        return esc as u64;
    }
    if (len > 0) {
        return s[0] as u64;
    }
    return 0;
}

/// Parse a tuple-field member name (the SymbolStr behind `t.0`, `t.1`, ...)
/// as a non-negative decimal index, or -1 when the name isn't a pure
/// decimal. Sema validates the index against the tuple's element count;
/// codegen trusts that and just uses this to recover the slot number.
function parse_tuple_member_index(s: string) -> i64 {
    if (s == null) { return -1; }
    const len: i64 = intrinsics::strlen(s) as i64;
    if (len == 0) { return -1; }
    mut acc: i64 = 0;
    for (mut i: i64 = 0; i < len; i++) {
        const c: char = s[i];
        if (c < '0' || c > '9') { return -1; }
        acc = acc * 10 + ((c - '0') as i64);
    }
    return acc;
}

