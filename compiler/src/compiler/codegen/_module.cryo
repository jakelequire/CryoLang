/// Codegen Module
///
/// LLVM IR generation for the Cryo compiler.  Contains the LLVM-C API
/// binding, type-safe wrappers, type mapping, and the IR generation
/// visitor that walks the fully-typed AST to produce LLVM IR.
///
/// Organized into three sub-modules:
///   - `State`   - leaf state components owned by Context / Visitor
///                 (value table, function registry, loop stack, etc.)
///   - `Ops`     - Context-side emitters borrowed by CodegenContext
///                 (flow, intrinsics, resolver, expression ops, decls)
///   - `Visit`   - IR-side visitor sub-emitters held by IRGeneratorVisitor
///                 (expr dispatch + per-AST-node emitters + the visitor itself)
///
/// The top-level files that follow (`Context`, `Passes`, `LLVMTypes`,
/// `TypeMap`, `Util`, `TestMainCodegen`) are the composition root and
/// shared infrastructure.

namespace Compiler::Codegen;

public module State;
public module Ops;
public module Visit;

public module LLVMTypes;
public module TypeMap;
public module AstArena;
public module Abi;
public module Util;
public module Context;
public module Passes;
public module TestMainCodegen;

/// LLVM-C API binding.  All LLVM functions are accessed as llvm::FunctionName().
/// The thin wrapper header declares only the functions we need, avoiding
/// CHeaderProcessor issues with the full LLVM-C headers.
///
/// `![functions_only]`: import the LLVM-C *prototypes* only.  The Bindgen
/// engine would otherwise also emit `llvm_bindings.h`'s ~16 opaque-handle
/// typedefs (`LLVMModuleRef` = void*, …) and anonymous-enum constant blocks
/// (`LLVMIntEQ` = 32, …) into the `llvm::` namespace, which codegen already
/// supplies itself — keeping this prototype-only preserves the self-host
/// fixed point (see HANDOFF §1).
![functions_only]
extern module llvm := "C" {
    #include "../../../llvm_bindings.h"
}
