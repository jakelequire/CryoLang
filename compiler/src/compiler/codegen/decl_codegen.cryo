/// Declaration Codegen
///
/// Handles IR generation for declarations: struct/class/enum types,
/// function signatures, function bodies, methods, globals, extern blocks,
/// and vtables.  Called by IRGeneratorVisitor's visit() overrides.

namespace Compiler::Codegen::DeclCodegen;

import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Codegen::TypeMap;
import Compiler::Codegen::Context;
import Compiler::Codegen::ExprCodegen;
import Compiler::CompilationContext;
import Compiler::DeclIndex;
import Compiler::ModuleGraph;
import Compiler::Types;
import Compiler::Types::TypeRef;
import Compiler::Types::Type;
import Compiler::Types::Arena;
import Compiler::Types::UserDefined;
import Compiler::Types::Compound;
import Compiler::Types::Generic;
import Compiler::Types::GenericRegistry;
import Compiler::AST;
import Compiler::AST::Node;
import Compiler::AST::Declaration;
import Compiler::AST::Statement;
import Compiler::AST::Expression;
import Compiler::Resolver::SymbolStr;
import Compiler::Resolver::InternTable;
import Compiler::Resolver::MangledName;
import Compiler::Resolver::QualifiedName;
import Compiler::Diag;
import Compiler::Diag::SourceSpan;


// ============================================================================
// Phase 1: Forward-declare all named types
// ============================================================================

/// Walk the program and forward-declare all struct/class/enum types as
/// named LLVM struct types.  This must run before function declarations
/// so that parameter and return types can reference these types.
function declare_types(cg: CodegenContext*, program: ProgramNode*) -> void {
    const stmts: ASTNode*[] = program.statements;
    for (mut i: i64 = 0; i < stmts.length; i++) {
        const stmt: ASTNode* = stmts[i];
        if (stmt == null) { continue; }

        const kind: NodeKind = stmt.kind;

        if (kind == NodeKind::StructDeclaration) {
            declare_struct_type(cg, stmt as StructDeclNode*);
        } else if (kind == NodeKind::ClassDeclaration) {
            declare_class_type(cg, stmt as ClassDeclNode*);
        } else if (kind == NodeKind::EnumDeclaration) {
            declare_enum_type(cg, stmt as EnumDeclNode*);
        } else if (kind == NodeKind::ImplementationBlock) {
            // Impl blocks may contain methods we need, but types are
            // already declared via StructDecl/ClassDecl.
        }
    }
}

/// Number of parameters to emit as fixed-arity in an LLVM function type.
/// For variadic Cryo functions (`args...`), the trailing name-only parameter
/// stands in for the vararg bucket — sema needs it to be a local in scope,
/// but LLVM must not see it as a fixed param (there's no callable type for
/// it, and every call site passes a different arity for that slot).
function fixed_param_count(func: FunctionDeclNode*) -> u32 {
    mut count: u32 = func.parameters.length as u32;
    if (func.is_variadic && count > 0) {
        const last: VarDeclNode* = func.parameters[count - 1];
        if (last.type_annotation == null) {
            count = count - 1;
        }
    }
    return count;
}

/// Same shape as `fixed_param_count` but typed for `IntrinsicDeclNode*`.
/// IntrinsicDeclNode and FunctionDeclNode both inherit from DeclarationNode
/// but have different field layouts, so reusing the FunctionDeclNode-typed
/// helper reads `is_variadic` past the end of an IntrinsicDeclNode's
/// allocation and segfaults when the read crosses an unmapped page.
function fixed_param_count_intrinsic(node: IntrinsicDeclNode*) -> u32 {
    mut count: u32 = node.parameters.length as u32;
    if (node.is_variadic && count > 0) {
        const last: VarDeclNode* = node.parameters[count - 1];
        if (last.type_annotation == null) {
            count = count - 1;
        }
    }
    return count;
}

/// Return the name of the trailing `args...` parameter when `func` is
/// variadic and its last parameter is the vararg bucket (no type
/// annotation, so sema couldn't give it a concrete type).  Returns an
/// empty SymbolStr when the function has no such parameter.
function variadic_param_name(func: FunctionDeclNode*) -> SymbolStr {
    if (!func.is_variadic) { return SymbolStr::empty(); }
    const n: i64 = func.parameters.length;
    if (n == 0) { return SymbolStr::empty(); }
    const last: VarDeclNode* = func.parameters[n - 1];
    if (last == null || last.type_annotation != null) {
        return SymbolStr::empty();
    }
    return last.name;
}

/// Declare the `@llvm.va_start.p0` intrinsic in the current LLVM module.
/// Signature: `void (ptr)` — the argument is a pointer to the va_list
/// storage to initialize from the caller's argument area.
function declare_va_start(cg: CodegenContext*) -> LValue {
    mut fn: LValue = cg.llvm_module.get_named_function("llvm.va_start.p0");
    if (fn.is_valid()) { return fn; }
    const ptr_ty: LType = LType::pointer_to(LType::i8());
    const buf: void* = malloc(8);
    const slots: void** = buf as void**;
    slots[0] = ptr_ty.raw;
    const fty: LType = LType::function_type(LType::void_type(), buf, 1, false);
    free(buf);
    fn = cg.llvm_module.add_function("llvm.va_start.p0", fty);
    return fn;
}

/// Declare the `@llvm.va_end.p0` intrinsic — mirror of va_start.
function declare_va_end(cg: CodegenContext*) -> LValue {
    mut fn: LValue = cg.llvm_module.get_named_function("llvm.va_end.p0");
    if (fn.is_valid()) { return fn; }
    const ptr_ty: LType = LType::pointer_to(LType::i8());
    const buf: void* = malloc(8);
    const slots: void** = buf as void**;
    slots[0] = ptr_ty.raw;
    const fty: LType = LType::function_type(LType::void_type(), buf, 1, false);
    free(buf);
    fn = cg.llvm_module.add_function("llvm.va_end.p0", fty);
    return fn;
}

/// Emit va_start for a variadic function's vararg bucket.  Allocates a
/// `[24 x i8]` (System V x86-64 va_list layout; larger than Win64's
/// 8-byte char* so both platforms fit in the same storage) and calls
/// @llvm.va_start on the pointer.  Binds `args_name` to the alloca so
/// that references in the body resolve to the va_list pointer.  Stashes
/// the args name on the context so `codegen_return` can emit `va_end`
/// before every `ret` instruction.
function emit_va_start_for_variadic(cg: CodegenContext*, fn_val: LValue,
                                     args_name: SymbolStr) -> void {
    if (!args_name.is_valid()) {
        cg.current_variadic_arg_id = 0;
        return;
    }
    const va_list_ty: LType = LType::array_of(LType::i8(), 24);
    const va_list_alloca: LValue = cg.create_entry_alloca(
        fn_val, cg.resolve(args_name), va_list_ty);
    const va_start_fn: LValue = declare_va_start(cg);
    const va_start_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(va_start_fn.raw) };
    mut args: LValue[] = [];
    args.push(va_list_alloca);
    mut _result: LValue = LValue::null();
    codegen_call(cg, va_start_fn, va_start_ty, args, "", &_result);
    cg.set_named_value(args_name, va_list_alloca);
    cg.current_variadic_arg_id = args_name.id;
}

/// Emit va_end on the va_list alloca bound to `args_name`, if that
/// binding exists.  Called immediately before every terminating return
/// so the va_list is properly cleaned up on every exit path.
function emit_va_end_if_variadic(cg: CodegenContext*, args_name: SymbolStr) -> void {
    if (!args_name.is_valid()) { return; }
    const va_list_alloca: LValue = cg.get_named_value(args_name);
    if (!va_list_alloca.is_valid()) { return; }
    const va_end_fn: LValue = declare_va_end(cg);
    const va_end_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(va_end_fn.raw) };
    mut args: LValue[] = [];
    args.push(va_list_alloca);
    mut _result: LValue = LValue::null();
    codegen_call(cg, va_end_fn, va_end_ty, args, "", &_result);
}

/// Look up the active variadic arg's SymbolStr from the codegen context.
/// Returns an empty SymbolStr if the current function is not variadic.
function current_variadic_arg(cg: CodegenContext*) -> SymbolStr {
    const id: u32 = cg.current_variadic_arg_id;
    if (id == 0) { return SymbolStr::empty(); }
    return SymbolStr::from_id(id);
}

/// Forward-declare a struct as a named LLVM type and fill its body.
function declare_struct_type(cg: CodegenContext*, node: StructDeclNode*) -> void {
    // Skip generic templates — only monomorphized versions get IR.
    if (node.generic_params.length > 0) {
        return;
    }

    const name: string = cg.resolve(node.name);
    const qname: QualifiedName = QualifiedName::single(cg.get_intern(), name);
    const mangled: string = MangledName::for_struct_type(cg.get_intern(), qname).resolve(cg.get_intern());

    // Look up the Cryo StructType to get field info.
    const type_ref: TypeRef = cg.ctx.decl_index.lookup_type(node.name);
    if (type_ref.is_invalid()) {
        return;
    }

    // Let the type mapper handle forward declaration + body fill.
    cg.type_mapper.map_type(type_ref);
}

/// Forward-declare a class type.
function declare_class_type(cg: CodegenContext*, node: ClassDeclNode*) -> void {
    if (node.generic_params.length > 0) {
        return;
    }

    const type_ref: TypeRef = cg.ctx.decl_index.lookup_type(node.name);
    if (type_ref.is_invalid()) {
        return;
    }

    cg.type_mapper.map_type(type_ref);
}

/// Declare an enum type.
function declare_enum_type(cg: CodegenContext*, node: EnumDeclNode*) -> void {
    if (node.generic_params.length > 0) {
        return;
    }

    const type_ref: TypeRef = cg.ctx.decl_index.lookup_type(node.name);
    if (type_ref.is_invalid()) {
        return;
    }

    cg.type_mapper.map_type(type_ref);
}


// ============================================================================
// Phase 2: Declare all function signatures
// ============================================================================

/// Walk the program and create LLVM function declarations for all
/// functions, methods, and extern blocks.  Also emits module-level global
/// variable declarations so any function body that references a global
/// (regardless of source order — e.g. `clock_gettime(CLOCK_REALTIME, ...)`
/// where the const is declared later in the file) can resolve it.
function declare_functions(cg: CodegenContext*, program: ProgramNode*) -> void {
    const stmts: ASTNode*[] = program.statements;
    for (mut i: i64 = 0; i < stmts.length; i++) {
        const stmt: ASTNode* = stmts[i];
        if (stmt == null) { continue; }

        const kind: NodeKind = stmt.kind;

        if (kind == NodeKind::FunctionDeclaration) {
            declare_function(cg, stmt as FunctionDeclNode*);
        } else if (kind == NodeKind::IntrinsicDeclaration) {
            declare_intrinsic(cg, stmt as IntrinsicDeclNode*);
        } else if (kind == NodeKind::ExternBlock) {
            declare_extern_block(cg, stmt as ExternBlockNode*);
        } else if (kind == NodeKind::ImplementationBlock) {
            declare_impl_block(cg, stmt as ImplBlockNode*);
        } else if (kind == NodeKind::StructDeclaration) {
            declare_struct_methods(cg, stmt as StructDeclNode*);
        } else if (kind == NodeKind::ClassDeclaration) {
            declare_class_methods(cg, stmt as ClassDeclNode*);
        } else if (kind == NodeKind::VariableDeclaration) {
            const var_decl: VarDeclNode* = stmt as VarDeclNode*;
            if (var_decl.is_global) {
                codegen_global_var(cg, var_decl);
            }
        }
    }
}

/// Declare a single function signature (no body generation).
function declare_function(cg: CodegenContext*, node: FunctionDeclNode*) -> void {
    // Skip generic templates.
    if (node.generic_params.length > 0) {
        return;
    }

    // Look up the pre-computed mangled name from the DI.
    const ctx_ptr: CompilationContext* = cg.ctx;
    const intern: InternTable* = ctx_ptr.intern_table;
    const qualified: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
    const di: DeclarationIndex* = ctx_ptr.decl_index;
    mut mangled_sym: SymbolStr = di.lookup_mangled_name(qualified);
    if (!mangled_sym.is_valid()) {
        // Compute and register on first use using the v0.2 mangler.
        const qname: QualifiedName = QualifiedName::from_symbol(qualified);
        mut params: TypeRef[] = [];
        for (mut pi: i64 = 0; pi < node.parameters.length; pi++) {
            const param: VarDeclNode* = node.parameters[pi];
            if (param != null && param.resolved_type.is_valid()) {
                params.push(param.resolved_type);
            }
        }
        const computed: MangledName = MangledName::for_free_function(
            intern, cg.get_arena(), qname, params,
            node.resolved_return_type, node.is_variadic);
        mangled_sym = computed.value;
        di.register_mangled_name(qualified, mangled_sym);
    }
    // The C ABI entry point must be named `main` verbatim — the C
    // runtime's _start references the unmangled symbol.  Override the
    // mangled name for any free function whose source-level name is
    // `main` so the linker can find it.
    const main_sym: SymbolStr = intern.intern("main");
    mut fn_name: string = intern.resolve(mangled_sym);
    if (node.name.equals(main_sym)) {
        fn_name = "main";
    }

    // Build the LLVM function type.
    const ret_ty: LType = map_return_type(cg, node);
    if (!ret_ty.is_valid()) { return; }

    const param_count: u32 = fixed_param_count(node);

    mut fn_type: LType = LType::null();
    if (param_count == 0) {
        fn_type = LType::function_type(ret_ty, null, 0, node.is_variadic);
    } else {
        const buf: void* = malloc(param_count as u64 * 8);
        const slots: void** = buf as void**;
        mut all_valid: boolean = true;
        for (mut i: u32 = 0; i < param_count; i++) {
            const param: VarDeclNode* = node.parameters[i];
            const param_ty: LType = cg.type_mapper.map_type(param.resolved_type);
            if (!param_ty.is_valid()) {
                all_valid = false;
                break;
            }
            slots[i] = param_ty.raw;
        }
        if (!all_valid) {
            free(buf);
            return;
        }
        fn_type = LType::function_type(ret_ty, buf, param_count, node.is_variadic);
        free(buf);
    }

    // Add the function to the LLVM module.
    const fn_val: LValue = cg.llvm_module.add_function(fn_name, fn_type);

    // Register under qualified name (module scope).
    cg.register_function(qualified, fn_val);
}

/// Declare all methods in an impl block.
function declare_impl_block(cg: CodegenContext*, node: ImplBlockNode*) -> void {
    // Skip generic impl blocks.
    if (node.generic_params.length > 0) {
        return;
    }

    // Use TypeResolution's canonical-qualified target when available — it
    // resolves cross-module impl targets (e.g. `implement trait FmtWrite
    // for struct Stdout` in fmt::write where Stdout lives in io::stdio)
    // by walking the bare→qualified table, so the impl's methods land
    // under the same key the type's defining module uses.  Without the
    // canonical resolution, we'd qualify with the CURRENT module and
    // produce `fmt::write::Stdout::write_str`, which `declare_method`
    // can't look up — bodies would be silently dropped and the linker
    // would surface them as undefined references.
    const ctx_ptr: CompilationContext* = cg.ctx;
    mut qualified_target: SymbolStr = SymbolStr::empty();
    if (node.qualified_target_name.is_valid()) {
        qualified_target = node.qualified_target_name;
    } else {
        const target_str: string = ctx_ptr.intern_table.resolve(node.target_type);
        if (strstr(target_str, "::") != null) {
            qualified_target = node.target_type;
        } else if (ctx_ptr.decl_index.lookup_type(node.target_type).is_valid()) {
            qualified_target = node.target_type;
        } else {
            const resolved: SymbolStr = ctx_ptr.decl_index.resolve_qualified(node.target_type);
            if (!resolved.equals(node.target_type)) {
                qualified_target = resolved;
            } else {
                qualified_target = ctx_ptr.qualify_symbol_sym(node.target_type);
            }
        }
    }
    // Skip impls whose target is a generic template — only the
    // monomorphized spec'd clones should produce LLVM symbols.  Mirrors
    // the `generic_params.length > 0` skip above for `implement<T> Foo<T>`;
    // catches the additional case where the impl has no impl-level params
    // but the target type does (e.g. `implement trait Eq for struct String`
    // on `String<A = GlobalAlloc>`).  Without this, the template impl's
    // bodies are codegen'd against the bare-template `this` type, but
    // method registrations live under the spec'd target — so call sites
    // like `this.as_str()` inside the template body fail to resolve.
    if (ctx_ptr.generic_registry != null) {
        const greg: GenericRegistry* = ctx_ptr.generic_registry;
        if (greg.get_template(qualified_target) != null) {
            return;
        }
    }

    for (mut i: i64 = 0; i < node.methods.length; i++) {
        declare_method(cg, node.methods[i], qualified_target);
    }
}

/// Declare methods defined inline within a struct declaration.
function declare_struct_methods(cg: CodegenContext*, node: StructDeclNode*) -> void {
    if (node.generic_params.length > 0) {
        return;
    }
    if (node.methods.length == 0) {
        return;
    }
    // Use the arena's canonical qualified name for the struct type.
    // For specialized structs (e.g., Array_Token), the arena name is
    // the correct DI key (e.g., std::collections::array::Array_Token).
    // qualify_symbol_sym would produce the consuming module's namespace
    // prefix, which doesn't match the DI registration.
    const ctx_ptr: CompilationContext* = cg.ctx;
    const di: DeclarationIndex* = ctx_ptr.decl_index;
    mut qualified: SymbolStr = SymbolStr::empty();
    // Try both local-qualified and bare name in the DI, then get the
    // arena's canonical qualified name from the TypeRef.
    const local_sym: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
    mut di_ref: TypeRef = di.lookup_type(local_sym);
    if (!di_ref.is_valid()) {
        di_ref = di.lookup_type(node.name);
    }
    if (di_ref.is_valid()) {
        const arena: TypeArena* = cg.get_arena();
        qualified = arena.get_qualified_name(di_ref);
    }
    if (!qualified.is_valid()) {
        qualified = local_sym;
    }
    for (mut i: i64 = 0; i < node.methods.length; i++) {
        declare_method(cg, node.methods[i], qualified);
    }
}

/// Declare methods defined inline within a class declaration.
function declare_class_methods(cg: CodegenContext*, node: ClassDeclNode*) -> void {
    if (node.generic_params.length > 0) {
        return;
    }
    // Qualify the class name — node.name is the bare AST name.
    // Break cg.ctx chain into local to avoid C++ compiler double-deref bug.
    const ctx_ptr: CompilationContext* = cg.ctx;
    const qualified: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
    for (mut i: i64 = 0; i < node.methods.length; i++) {
        declare_method(cg, node.methods[i], qualified);
    }

    // Emit the vtable for classes with virtual methods.  Drive this from
    // ClassType.methods + its base chain (populated by the type-resolution
    // pass) so the vtable is inheritance-complete: a subclass's vtable has
    // one slot per virtual method introduced anywhere in the ancestry,
    // in the order of first introduction (root → leaf).  The slot's
    // implementation is the most-derived override present in the chain,
    // falling back to the inherited base implementation when the subclass
    // doesn't override that slot.  Layout discipline is what makes call-site
    // dispatch work: a `Base*` callsite looks up slot N in `Base`'s layout,
    // and any subclass's vtable guarantees slot N at the same index.
    const di: DeclarationIndex* = ctx_ptr.decl_index;
    const type_ref: TypeRef = di.lookup_type(qualified);
    if (type_ref.is_valid()) {
        const arena: TypeArena* = cg.get_arena();
        const t: Type* = arena.lookup(type_ref.id);
        if (t != null && t.kind == TypeKind::Class) {
            const cls: ClassType* = t as ClassType*;
            if (cls.has_virtual_methods) {
                codegen_vtable_for_class(cg, cls);
            }
        }
    }
}

/// Identity of a single vtable slot — the (method_name, param_types)
/// pair.  Two methods occupy the same slot iff the name matches AND
/// every parameter TypeRef matches by arena ID.  Keeps overloaded
/// virtuals in distinct slots while letting overrides collapse back
/// onto the base virtual's slot.
type struct VTableSlot {
    name:        SymbolStr;
    param_types: TypeRef[];
}

/// Structural equality on two param-type lists by arena ID.  The arena
/// canonicalizes types so equal IDs mean equal types regardless of how
/// they were spelled at the source level (including through type
/// aliases, generic instantiations, etc.).
function param_types_equal(a: TypeRef[], b: TypeRef[]) -> boolean {
    if (a.length != b.length) { return false; }
    for (mut i: i64 = 0; i < a.length; i++) {
        if (a[i].id != b[i].id) { return false; }
    }
    return true;
}

/// Like `param_types_equal` but goes through the arena so two TypeRefs
/// that represent the same shape but happen to live under different IDs
/// (e.g., a `ASTVisitor*` registered while ASTVisitor was still a forward
/// declaration vs after the body resolved) compare equal.  Vtable slot
/// matching needs this lenience because override methods declared in a
/// subclass may resolve their parameter types in a slightly different
/// resolution context than the virtual base they override.
function param_types_equal_structural(arena: TypeArena*, intern: InternTable*,
                                       a: TypeRef[], b: TypeRef[]) -> boolean {
    if (a.length != b.length) { return false; }
    for (mut i: i64 = 0; i < a.length; i++) {
        if (a[i].id == b[i].id) { continue; }
        const ta: Type* = arena.lookup(a[i].id);
        const tb: Type* = arena.lookup(b[i].id);
        if (ta == null || tb == null) { return false; }
        if (ta.kind != tb.kind) { return false; }
        // Compare by formatted display so two distinct PointerType IDs
        // that point at the same nominal class compare equal — display
        // names are the canonical source-level identity for these types.
        const sa: string = arena.format_display(ta);
        const sb: string = arena.format_display(tb);
        if (strcmp(sa, sb) != 0) { return false; }
    }
    return true;
}

/// Walk the class's base chain (leaf → root) and collect the ordered
/// list of virtual-method slots.  New `is_virtual` methods append a
/// new slot; `is_override` methods do NOT — they install into an
/// existing slot at vtable-emission time.  The returned list is in
/// root → leaf declaration order, so every subclass's vtable extends
/// the base's layout with its own additions.
function collect_vtable_slots(cg: CodegenContext*, cls: ClassType*) -> VTableSlot[] {
    const arena: TypeArena* = cg.get_arena();

    // Build chain = [cls, ..., root].
    mut chain: ClassType*[] = [];
    mut walk: ClassType* = cls;
    mut depth: i32 = 0;
    while (walk != null && depth < 16) {
        chain.push(walk);
        if (!walk.has_base || !walk.base_class.is_valid()) { break; }
        const base_t: Type* = arena.lookup(walk.base_class.id);
        if (base_t == null || base_t.kind != TypeKind::Class) { break; }
        walk = base_t as ClassType*;
        depth = depth + 1;
    }

    mut slots: VTableSlot[] = [];
    for (mut ci: i64 = chain.length - 1; ci >= 0; ci--) {
        const link: ClassType* = chain[ci];
        for (mut mi: i64 = 0; mi < link.methods.length; mi++) {
            const m: MethodInfo = link.methods[mi];
            if (!m.is_virtual) { continue; }
            mut already: boolean = false;
            for (mut ki: i64 = 0; ki < slots.length; ki++) {
                if (slots[ki].name.equals(m.name) &&
                    param_types_equal(slots[ki].param_types, m.param_types)) {
                    already = true;
                    break;
                }
            }
            if (!already) {
                slots.push(VTableSlot { name: m.name, param_types: m.param_types });
            }
        }
    }
    return slots;
}

/// For a given vtable slot (name + param_types), walk leaf → root and
/// return the first matching method's LLVM function — the most-derived
/// override, falling back to the inherited base implementation when
/// the subclass doesn't override that specific overload.  Resolution
/// goes through the overload-specific mangled name so the correct LLVM
/// function is installed in the slot, not the last-registered one
/// under `Type::method`.
function find_vtable_slot_impl(cg: CodegenContext*, cls: ClassType*,
                                slot_name: SymbolStr, slot_params: TypeRef[]) -> LValue {
    const arena: TypeArena* = cg.get_arena();
    const intern: InternTable* = cg.get_intern();
    mut walk: ClassType* = cls;
    mut depth: i32 = 0;
    while (walk != null && depth < 16) {
        for (mut mi: i64 = 0; mi < walk.methods.length; mi++) {
            const m: MethodInfo = walk.methods[mi];
            if (!m.name.equals(slot_name)) { continue; }
            // Use structural (display-name) equality on params instead of
            // raw-ID matching: an override method's params can resolve to
            // different TypeRef IDs than the virtual base's params even
            // though they're semantically the same type (e.g. `ASTVisitor*`
            // registered before vs. after the visitor module finished
            // resolving).  Strict ID matching here misses every override
            // and the whole vtable bails (every `new <DerivedClass>` then
            // skips the vtable store; runtime virtual dispatch crashes
            // reading a null vtable pointer).
            if (!param_types_equal_structural(arena, intern, m.param_types, slot_params)) { continue; }
            if (!m.is_virtual && !m.is_override) { continue; }
            // Skip pure virtual declarations (virtual without body).
            // Their LLVM function is a bare `declare` that links as an
            // undefined reference.  Keep walking up — a concrete override
            // must come from further up the chain, or the caller's
            // `!impl.is_valid()` bail drops the whole vtable.
            if (m.ast_node != null) {
                const mnode_ck: MethodNode* = m.ast_node as MethodNode*;
                if (mnode_ck != null && mnode_ck.func != null && !mnode_ck.func.has_body()) {
                    continue;
                }
            }
            const type_qname: QualifiedName = QualifiedName::from_symbol(walk.qualified_name);
            const method_str: string = intern.resolve(slot_name);
            // Resolve method's full signature for the v0.2 mangler.
            mut method_ret: TypeRef = TypeRef::invalid();
            mut method_variadic: boolean = false;
            const fn_t: Type* = arena.lookup(m.function_type.id);
            if (fn_t != null && fn_t.kind == TypeKind::Function) {
                const fn_ty: FunctionType* = fn_t as FunctionType*;
                method_ret = fn_ty.return_type;
                method_variadic = fn_ty.is_variadic;
            }
            // MethodInfo.param_types already excludes the receiver.  Default
            // to ImmutRef receiver for virtual methods; if the method has
            // a `mut &this` receiver we recover it from the AST node.
            mut recv_kind: ReceiverKind = ReceiverKind::ImmutRef;
            if (m.ast_node != null) {
                const mn: MethodNode* = m.ast_node as MethodNode*;
                if (mn != null && mn.func != null) {
                    recv_kind = method_receiver_kind(mn.func, mn.is_static, intern);
                }
            }
            const computed: MangledName = MangledName::for_method(
                intern, arena, type_qname, slot_name, recv_kind,
                m.param_types, method_ret, method_variadic);
            mut fn_val: LValue = resolve_function(cg, computed.value);
            if (!fn_val.is_valid()) {
                const type_str: string = intern.resolve(walk.qualified_name);
                const combined: string = format("%s::%s", type_str, method_str);
                fn_val = resolve_function(cg, intern.intern(combined));
            }
            return fn_val;
        }
        if (!walk.has_base || !walk.base_class.is_valid()) { break; }
        const base_t: Type* = arena.lookup(walk.base_class.id);
        if (base_t == null || base_t.kind != TypeKind::Class) { break; }
        walk = base_t as ClassType*;
        depth = depth + 1;
    }
    return LValue::null();
}

/// Return the vtable slot index of (method_name, param_types) in this
/// class's layout, or -1 if no matching virtual slot exists.  Called
/// from codegen dispatch after sema has identified the exact overload
/// via `CallExprNode.resolved_method` — this function just maps that
/// declaration to its slot position.
///
/// Uses *structural* param-type equality (display-name match) rather than
/// strict arena-ID match: an override method's parameter `Foo*` may be
/// registered under a different arena ID than the base method's `Foo*` if
/// the two declarations were resolved before/after `Foo`'s body was sealed,
/// even though they denote the same nominal pointer type.  Without this,
/// `node.accept(this)` on a base-class pointer falls back to a static call
/// to the base accept (which targets vtable slot 0 — the no-op base
/// `visit(BaseNode*)` — silently dropping every visitor traversal).
function vtable_slot_index(cg: CodegenContext*, cls: ClassType*,
                            method_name: SymbolStr, param_types: TypeRef[]) -> i32 {
    const slots: VTableSlot[] = collect_vtable_slots(cg, cls);
    const arena: TypeArena* = cg.get_arena();
    const intern: InternTable* = cg.get_intern();
    for (mut i: i32 = 0; i < slots.length as i32; i++) {
        if (slots[i].name.equals(method_name) &&
            param_types_equal_structural(arena, intern,
                slots[i].param_types, param_types)) {
            return i;
        }
    }
    return -1;
}

/// Emit the vtable global for `cls`.  Slot layout comes from
/// `collect_vtable_slots` (inheritance-complete, overload-aware); each
/// slot's contents come from `find_vtable_slot_impl` (most-derived
/// override wins, inherited base implementation otherwise).
function codegen_vtable_for_class(cg: CodegenContext*, cls: ClassType*) -> void {
    const intern: InternTable* = cg.get_intern();

    const slots: VTableSlot[] = collect_vtable_slots(cg, cls);
    if (slots.length == 0) { return; }

    mut impls: LValue[] = [];
    for (mut i: i64 = 0; i < slots.length; i++) {
        const impl: LValue = find_vtable_slot_impl(cg, cls, slots[i].name, slots[i].param_types);
        if (!impl.is_valid()) {
            // If the slot's implementation isn't declared in this module,
            // skip vtable emission entirely — a half-populated vtable would
            // misdispatch.  Cross-module vtables are handled when the owning
            // module's codegen runs.
            return;
        }
        impls.push(impl);
    }

    const n: u32 = impls.length as u32;
    const fn_ptr_ty: LType = LType::pointer_to(LType::i8());
    const vtable_ty: LType = LType::array_of(fn_ptr_ty, n);

    const buf: void* = malloc(n as u64 * 8);
    const slot_ptrs: void** = buf as void**;
    for (mut i: u32 = 0; i < n; i++) {
        slot_ptrs[i] = llvm::LLVMConstBitCast(impls[i].raw, fn_ptr_ty.raw);
    }
    const init: LValue = LType::const_array(fn_ptr_ty, buf, n);
    free(buf);

    const qname: QualifiedName = QualifiedName::from_symbol(cls.qualified_name);
    const mangled: string = MangledName::for_vtable(intern, qname).resolve(intern);
    const global: LValue = cg.llvm_module.add_global(vtable_ty, mangled);
    global.set_initializer(init);
    global.set_global_constant(true);
    // External linkage so cross-module `new` sites can resolve the vtable
    // symbol at link time.  Internal linkage hides the global from the
    // owning module's .o exports, leaving cross-module references unresolved.
    global.set_linkage(0);  // LLVMExternalLinkage
}

/// Declare a method.  Methods get a `this` pointer as the first parameter.
function declare_method(cg: CodegenContext*, node: MethodNode*, target_type: SymbolStr) -> void {
    const func: FunctionDeclNode* = node.func;
    if (func == null) { return; }

    // Skip generic methods.
    if (func.generic_params.length > 0) {
        return;
    }

    const intern: InternTable* = cg.get_intern();
    const type_str: string = intern.resolve(target_type);
    const method_str: string = intern.resolve(func.name);

    // Build the combined DI key.  Always compute the mangled name fresh
    // from THIS overload's parameter types — the DI cache `lookup_mangled_name`
    // only stores ONE entry per combined key, so for overloaded methods
    // (e.g., every `visit(SomeNode*)` in BaseASTVisitor) using the cached
    // name would map every overload to the first one's mangled name,
    // collide at LLVM level, and leave all but the first-declared overload
    // as unnamed declares without bodies.
    const combined: string = format("%s::%s", type_str, method_str);
    const combined_sym: SymbolStr = intern.intern(combined);
    const ctx_ptr: CompilationContext* = cg.ctx;
    const di: DeclarationIndex* = ctx_ptr.decl_index;
    const arena: TypeArena* = cg.get_arena();
    const type_qname: QualifiedName = QualifiedName::from_symbol(target_type);
    const recv_kind: ReceiverKind = method_receiver_kind(func, node.is_static, intern);
    const method_param_refs: TypeRef[] = method_non_receiver_params(func, intern);
    const computed: MangledName = MangledName::for_method(
        intern, arena, type_qname, func.name, recv_kind,
        method_param_refs, func.resolved_return_type, func.is_variadic);
    const mangled_sym: SymbolStr = computed.value;
    // Cache into DI only if this is the first overload — preserves the
    // existing single-slot behavior for call sites that don't disambiguate.
    if (!di.lookup_mangled_name(combined_sym).is_valid()) {
        di.register_mangled_name(combined_sym, mangled_sym);
    }
    const fn_name: string = intern.resolve(mangled_sym);

    // Build LLVM function type.  Non-static methods prepend a `this` pointer.
    const ret_ty: LType = map_return_type(cg, func);
    if (!ret_ty.is_valid()) { return; }

    const is_instance: boolean = !node.is_static;

    // Detect whether the method already declares an explicit self parameter.
    // Cryo allows three forms: `&this` / `mut &this` (reference, default),
    // and `this` (by-value).  `&this` is stored in `parameters` with the
    // literal name "&this"; `this` by-value is stored with the literal name
    // "this".  In EITHER case we must NOT prepend an extra implicit `this`
    // slot — the explicit param already accounts for the self argument.
    // Only when the method has no self-param at all (e.g., some elaborated
    // methods) should we synthesize the `&this` pointer prefix.
    mut explicit_self_name: string = "";  // "", "&this", "this", or "typed-this"
    for (mut pc0: u32 = 0; pc0 < func.parameters.length as u32; pc0++) {
        const pp0: VarDeclNode* = func.parameters[pc0];
        if (pp0 == null) { continue; }
        const pn: string = intern.resolve(pp0.name);
        if (strcmp(pn, "&this") == 0) {
            explicit_self_name = "&this";
            break;
        }
        if (strcmp(pn, "this") == 0) {
            // Distinguish parser-synthesized by-value `this` (no annotation)
            // from user-written `this: Lexer*` (explicit annotation).  Both
            // count as "self" so we skip the implicit-prefix synthesis, but
            // the LLVM param type comes from different sources: bare `this`
            // uses the struct by value; typed `this` uses the annotation.
            if (pp0.type_annotation == null) {
                explicit_self_name = "this";
            } else {
                explicit_self_name = "typed-this";
            }
            break;
        }
    }

    // Look up the target type.  `&this` forms want `T*`; by-value `this`
    // wants the struct `T` directly.  If there's no explicit self we'll
    // synthesize `T*` as the implicit prefix.
    mut target_mapped: LType = LType::null();
    mut this_ty: LType = LType::null();
    if (is_instance) {
        mut target_ref: TypeRef = di.lookup_type(target_type);
        if (target_ref.is_valid()) {
            target_mapped = cg.type_mapper.map_type(target_ref);
            if (target_mapped.is_valid()) {
                this_ty = LType::pointer_to(target_mapped);
            }
        }
        if (!this_ty.is_valid()) {
            return;
        }
    }

    const prepend_implicit_this: boolean = is_instance && strlen(explicit_self_name) == 0;

    // Count user parameters.  `&this` contributes a ptr slot via the
    // existing param; by-value `this` contributes a struct slot via the
    // existing param; implicit missing self is handled by prepend_implicit_this.
    // For variadic methods (`args...`), skip the trailing name-only param —
    // LLVM's `...` marker covers it.
    const fixed_user_count: u32 = fixed_param_count(func);
    mut user_param_count: u32 = 0;
    for (mut pc: u32 = 0; pc < fixed_user_count; pc++) {
        const pp: VarDeclNode* = func.parameters[pc];
        if (pp != null) { user_param_count = user_param_count + 1; }
    }
    const total_params: u32 = user_param_count + (if (prepend_implicit_this) { 1 } else { 0 } as u32);

    const buf: void* = malloc(total_params as u64 * 8);
    const slots: void** = buf as void**;

    mut idx: u32 = 0;
    if (prepend_implicit_this) {
        slots[0] = this_ty.raw;
        idx = 1;
    }

    mut params_valid: boolean = true;
    for (mut i: u32 = 0; i < fixed_user_count; i++) {
        const param: VarDeclNode* = func.parameters[i];
        if (param == null) { continue; }
        const param_name: string = intern.resolve(param.name);

        // For `&this` and `mut &this`, force the LLVM type to `T*` —
        // parser-synthesized reference annotations may not round-trip
        // through the arena correctly for every method.
        // For by-value `this` with NO type annotation (parser-synthesized
        // self form), use the struct type directly.  But `this: Lexer*`
        // — a user-written explicit annotation on a param named `this`
        // — is just a regular typed parameter; map via resolved_type.
        mut mapped_param: LType = LType::null();
        if (strcmp(param_name, "&this") == 0 && this_ty.is_valid()) {
            mapped_param = this_ty;
        } else if (strcmp(param_name, "this") == 0 && target_mapped.is_valid()
                   && param.type_annotation == null) {
            mapped_param = target_mapped;
        } else {
            mapped_param = cg.type_mapper.map_type(param.resolved_type);
        }
        if (!mapped_param.is_valid()) {
            params_valid = false;
            break;
        }
        slots[idx] = mapped_param.raw;
        idx = idx + 1;
    }

    if (!params_valid) {
        free(buf);
        return;
    }

    const fn_type: LType = LType::function_type(ret_ty, buf, total_params, func.is_variadic);
    free(buf);

    const fn_val: LValue = cg.llvm_module.add_function(fn_name, fn_type);

    // Register under the combined key built above.  Also register against the
    // (name, total-LLVM-arity) composite so that callers can pick the correct
    // overload at call sites (e.g., `Array::new()` vs `Array::new(u64)`).
    // `total_params` matches the arity cross-module externs register with
    // (the FunctionType's param count), keeping the two registration paths
    // interoperable.  Finally register under the unique mangled_sym — that's
    // the key `codegen_method_prologue` uses to look up the right LLVM
    // function for each overload (combined_sym alone is ambiguous because
    // overloads share the same `Type::method` form).
    cg.register_function(combined_sym, fn_val);
    cg.register_function_with_arity(combined_sym, total_params, fn_val);
    cg.register_function(mangled_sym, fn_val);
}

/// Declare an intrinsic function (e.g., malloc, printf, strlen).
/// Intrinsics use C linkage — bare name, no namespace qualification.
function declare_intrinsic(cg: CodegenContext*, node: IntrinsicDeclNode*) -> void {
    const intern: InternTable* = cg.get_intern();
    const name_str: string = intern.resolve(node.name);

    // Map return type.
    mut ret_ty: LType = LType::void_type();
    if (node.has_resolved_return_type()) {
        ret_ty = cg.type_mapper.map_type(node.resolved_return_type);
        if (!ret_ty.is_valid()) { return; }
    }

    const param_count: u32 = fixed_param_count_intrinsic(node);
    mut fn_type: LType = LType::null();

    if (param_count == 0) {
        fn_type = LType::function_type(ret_ty, null, 0, node.is_variadic);
    } else {
        const buf: void* = malloc(param_count as u64 * 8);
        const slots: void** = buf as void**;
        mut all_valid: boolean = true;
        for (mut i: u32 = 0; i < param_count; i++) {
            const param: VarDeclNode* = node.parameters[i];
            const param_ty: LType = cg.type_mapper.map_type(param.resolved_type);
            if (!param_ty.is_valid()) {
                all_valid = false;
                break;
            }
            slots[i] = param_ty.raw;
        }
        if (!all_valid) {
            free(buf);
            return;
        }
        fn_type = LType::function_type(ret_ty, buf, param_count, node.is_variadic);
        free(buf);
    }

    // C linkage: use bare name.
    const fn_val: LValue = cg.llvm_module.add_function(name_str, fn_type);

    // Register under bare name (for identifier lookups like `malloc(...)`)
    cg.register_function(node.name, fn_val);

    // Also register under qualified name (for cross-module resolution).
    const ctx_ptr: CompilationContext* = cg.ctx;
    const qualified: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
    if (!qualified.equals(node.name)) {
        cg.register_function(qualified, fn_val);
    }
}

/// Declare extern block functions.
function declare_extern_block(cg: CodegenContext*, node: ExternBlockNode*) -> void {
    // Get intern table from CompilationContext to avoid CodegenContext offset issues.
    const ctx_ptr: CompilationContext* = cg.ctx;
    const intern: InternTable* = ctx_ptr.intern_table;

    for (mut i: i64 = 0; i < node.functions.length; i++) {
        const func: FunctionDeclNode* = node.functions[i];
        if (func == null) { continue; }

        const name_str: string = intern.resolve(func.name);

        // Extern functions use their bare name (C linkage).
        const ret_ty: LType = map_return_type(cg, func);
        if (!ret_ty.is_valid()) {
            cg.emit_warning_at_span(ErrorCode::E0643_RETURN_TYPE_ERROR,
                format("codegen: extern function '%s' — failed to map return type", name_str),
                func.span);
            continue;
        }
        const param_count: u32 = fixed_param_count(func);

        mut fn_type: LType = LType::null();
        if (param_count == 0) {
            fn_type = LType::function_type(ret_ty, null, 0, func.is_variadic);
        } else {
            const buf: void* = malloc(param_count as u64 * 8);
            const slots: void** = buf as void**;
            mut params_ok: boolean = true;
            for (mut j: u32 = 0; j < param_count; j++) {
                const param: VarDeclNode* = func.parameters[j];
                const mapped_ep: LType = cg.type_mapper.map_type(param.resolved_type);
                if (!mapped_ep.is_valid()) {
                    cg.emit_warning_at_span(ErrorCode::E0642_PARAM_TYPE_ERROR,
                        format("codegen: extern function '%s' — failed to map parameter %d type", name_str, j as i32),
                        param.span);
                    params_ok = false;
                    break;
                }
                slots[j] = mapped_ep.raw;
            }
            if (!params_ok) {
                free(buf);
                continue;
            }
            fn_type = LType::function_type(ret_ty, buf, param_count, func.is_variadic);
            free(buf);
        }

        // Use bare name for C linkage.
        const fn_val: LValue = cg.llvm_module.add_function(name_str, fn_type);
        cg.register_function(func.name, fn_val);
    }
}

/// Declare cross-module extern functions.
///
/// Instead of reading from pre-built CrossModuleFnDescriptor objects
/// (which suffer from struct-copy corruption when the descriptor
/// contains dynamic array fields), query the DeclarationIndex directly
/// for each module's functions and look up their FunctionType in the arena.
// NOTE: on-demand cross-module extern resolution lives in Context:
//   resolve_function / resolve_function_with_arity / resolve_global
// They replaced the old bulk `declare_cross_module_externs` / `declare_cross_module_global_externs`
// pre-pass — only symbols the current module actually references pay the cost.


// ============================================================================
// Phase 3: Generate function bodies
// ============================================================================

/// Generate IR for all function bodies in the program.
/// `visit_fn` is a callback that generates the body using the visitor.
function generate_bodies(cg: CodegenContext*, program: ProgramNode*,
                         visit_fn: void*) -> void {
    const stmts: ASTNode*[] = program.statements;
    for (mut i: i64 = 0; i < stmts.length; i++) {
        const stmt: ASTNode* = stmts[i];
        if (stmt == null) { continue; }

        const kind: NodeKind = stmt.kind;

        if (kind == NodeKind::FunctionDeclaration) {
            const func: FunctionDeclNode* = stmt as FunctionDeclNode*;
            if (func.generic_params.length > 0) { continue; }
            if (func.body == null) { continue; }
            // Body generation happens through the visitor.
        } else if (kind == NodeKind::VariableDeclaration) {
            const var_decl: VarDeclNode* = stmt as VarDeclNode*;
            if (var_decl.is_global) {
                codegen_global_var(cg, var_decl);
            }
        }
    }
}


// ============================================================================
// Global variable codegen
// ============================================================================

/// Generate a global variable declaration with optional initializer.
function codegen_global_var(cg: CodegenContext*, node: VarDeclNode*) -> void {
    // Mangle definitions under the current module's namespace
    // (`C$<namespace>.<name>`) so two modules with the same private
    // `const NAME = …` don't collide at link time.  Cross-module readers
    // pull the same namespace out of `DeclarationIndex::get_global_namespace`.
    const mangled: string = MangledName::for_global(
        cg.get_intern(), cg.ctx.namespace_str, node.name).resolve(cg.get_intern());

    const ty: LType = cg.type_mapper.map_type(node.resolved_type);
    if (!ty.is_valid()) {
        return;
    }

    const global: LValue = cg.llvm_module.add_global(ty, mangled);

    // Initializer: if the source declaration has a literal initializer
    // (e.g., `const BUCKET_OCCUPIED: u8 = 1`), emit it as the constant
    // initializer typed against the global's own type so consumers see
    // the right value.  LLVM globals require a constant initializer, so
    // anything more complex than a literal falls back to zeroinitializer
    // (more involved cases would need a runtime ctor, out of scope here).
    mut init: LValue = LValue::null();
    if (node.has_initializer()
            && node.initializer.kind == NodeKind::Literal) {
        const lit: LiteralNode* = node.initializer as LiteralNode*;
        const tk: i32 = llvm::LLVMGetTypeKind(ty.raw);
        if (lit.literal_kind == LiteralKind::Integer && tk == 8) {
            const ival: u64 = parse_int_lexeme(lit.value);
            init = LType::const_int(ty, ival, true);
        } else if (lit.literal_kind == LiteralKind::Boolean && tk == 8) {
            const bval: u64 = if (lit.value == "true") { 1 } else { 0 };
            init = LType::const_int(ty, bval, false);
        } else if (lit.literal_kind == LiteralKind::Float
                   && (tk == 2 || tk == 3)) {
            mut fval: f64 = 0.0;
            sscanf(lit.value, "%lf", &fval);
            init = LType::const_real(ty, fval);
        } else if (lit.literal_kind == LiteralKind::Null && tk == 12) {
            init = LType::const_pointer_null(ty);
        } else if (lit.literal_kind == LiteralKind::String && tk == 12) {
            // String literal global: store the address of the interned
            // string global as the initializer.  Without this, every
            // `const SOME_TEXT: string = "..."` emits as `null`, which
            // surfaces as literal "(null)" in any printf/format output
            // that consumes the constant.
            init = cg.get_or_create_string_literal(lit.value);
        }
    }
    if (!init.is_valid()) {
        init = LType::const_null(ty);
    }
    global.set_initializer(init);

    if (!node.is_mutable) {
        global.set_global_constant(true);
    }

    cg.register_global(node.name, global);
}


// ============================================================================
// Function body codegen
// ============================================================================

/// Generate the body of a function.  Called from the IRGeneratorVisitor.
///
/// 1. Look up the LLVM function
/// 2. Create entry basic block
/// 3. Create allocas for parameters and store incoming values
/// 4. Push scope, bind parameter names
/// 5. The visitor will visit the body (BlockStmtNode)
/// 6. Handle implicit return for void functions
function codegen_function_prologue(cg: CodegenContext*, node: FunctionDeclNode*) -> LValue {
    const ctx_ptr: CompilationContext* = cg.ctx;
    const qualified: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
    const fn_val: LValue = resolve_function(cg, qualified);
    if (!fn_val.is_valid()) {
        // The prior FunctionDeclaration pass should have produced a
        // declare for this function. When it didn't, the body simply
        // can't land — but emit a warning rather than an error because
        // the upstream gap is the real bug to fix, and a warning lets
        // the build continue so downstream code can be exercised.
        const fname: string = cg.resolve(node.name);
        cg.emit_warning_at_span(ErrorCode::E0606_FUNCTION_GENERATION_ERROR,
            format("codegen: function '%s' has no LLVM declaration in this module — body skipped (the prior FunctionDeclaration pass should have produced one). Calls to this function will fail at link time.", fname),
            node.span);
        return LValue::null();
    }

    // Create entry basic block.
    const entry_bb: LBasicBlock = LBasicBlock::append(fn_val, "entry");
    cg.builder.position_at_end(entry_bb);

    // Create allocas for each parameter and store the incoming value.
    cg.push_scope();

    const fixed_count: u32 = fixed_param_count(node);
    for (mut i: u32 = 0; i < fixed_count; i++) {
        const param: VarDeclNode* = node.parameters[i];
        const param_name: string = cg.resolve(param.name);
        const param_ty: LType = cg.type_mapper.map_type(param.resolved_type);

        if (!param_ty.is_valid()) {
            const fname: string = cg.resolve(node.name);
            cg.emit_warning_at_span(ErrorCode::E0642_PARAM_TYPE_ERROR,
                format("codegen: function '%s', parameter '%s' — could not lower its type to LLVM; body skipped. Calls to this function will fail at link time.",
                    fname, param_name),
                if (param != null) { param.span } else { node.span });
            cg.pop_scope();
            return LValue::null();
        }

        const alloca: LValue = cg.create_entry_alloca(fn_val, param_name, param_ty);
        const arg: LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, i) };
        cg.builder.build_store(arg, alloca);
        cg.set_named_value(param.name, alloca);
    }

    // For variadic functions with an `args...` bucket, set up a va_list
    // so the body can forward varargs to other variadic intrinsics via
    // a v* variant (vsprintf, vfprintf, etc.).  Without this the `args`
    // identifier has no LLVM value and every forwarding call codegens
    // with a null operand.
    emit_va_start_for_variadic(cg, fn_val, variadic_param_name(node));

    return fn_val;
}

/// Emit implicit void return ONLY for void/unit functions.
/// Non-void functions must have explicit returns from the source code.
/// If a non-void function's block has no terminator, body generation
/// failed — the caller will strip it back to a declare.
function codegen_function_epilogue(cg: CodegenContext*, node: FunctionDeclNode*) -> void {
    const current_bb: LBasicBlock = cg.builder.get_insert_block();
    if (current_bb.is_valid() && !current_bb.has_terminator()) {
        const ret_ty: TypeRef = node.resolved_return_type;
        mut is_void: boolean = ret_ty.is_invalid();
        if (!is_void) {
            const t: Type* = cg.lookup_type_by_id(ret_ty.id);
            is_void = t != null && (t.kind == TypeKind::Void || t.kind == TypeKind::Unit);
        }
        if (is_void) {
            emit_va_end_if_variadic(cg, variadic_param_name(node));
            cg.builder.build_ret_void();
        }
        // Non-void: intentionally leave unterminated. The caller
        // detects this and strips the function body.
    }

    // Sweep orphaned blocks that body codegen left empty + unterminated.
    // The classic source is the merge block of an infinite `loop { ... }`
    // (no `break`, so nothing branches into `loop.end`); the same shape
    // appears for any control-flow scaffolding that creates a join block
    // that ends up unused.  Without this fixup the function-body
    // validator strips the WHOLE body to a declare, producing silent
    // link-time `undefined reference` errors.  An empty block has no
    // semantic meaning; terminating it with `unreachable` is a no-op
    // for any reachable path and keeps LLVM happy.
    const fn_val: LValue = cg.builder.get_insert_block().get_parent();
    if (fn_val.is_valid()) {
        mut bb: void* = llvm::LLVMGetFirstBasicBlock(fn_val.raw);
        while (bb != null) {
            const lbb: LBasicBlock = LBasicBlock { raw: bb };
            if (!lbb.has_terminator()
                    && llvm::LLVMGetFirstInstruction(bb) == null) {
                cg.builder.position_at_end(lbb);
                cg.builder.build_unreachable();
            }
            bb = llvm::LLVMGetNextBasicBlock(bb);
        }
    }

    cg.pop_scope();
}

/// Generate function prologue for a method.  Prepends `this` parameter binding.
function codegen_method_prologue(cg: CodegenContext*, node: MethodNode*,
                                  target_type: SymbolStr) -> LValue {
    const func: FunctionDeclNode* = node.func;
    if (func == null) { return LValue::null(); }

    const intern: InternTable* = cg.get_intern();
    const type_str: string = intern.resolve(target_type);
    const method_str: string = intern.resolve(func.name);
    const combined: string = format("%s::%s", type_str, method_str);
    const combined_sym: SymbolStr = intern.intern(combined);

    // Recompute the mangled name from THIS overload's parameter types so
    // overloaded methods (e.g., BaseASTVisitor's 62 `visit(...)` overrides)
    // resolve to their own LLVM function rather than all mapping to the
    // first-declared overload via the ambiguous combined key.  Must mirror
    // the computation in `declare_method` exactly.
    const arena: TypeArena* = cg.get_arena();
    const type_qname: QualifiedName = QualifiedName::from_symbol(target_type);
    const recv_kind: ReceiverKind = method_receiver_kind(func, node.is_static, intern);
    const method_param_refs: TypeRef[] = method_non_receiver_params(func, intern);
    const computed: MangledName = MangledName::for_method(
        intern, arena, type_qname, func.name, recv_kind,
        method_param_refs, func.resolved_return_type, func.is_variadic);
    const mangled_sym: SymbolStr = computed.value;

    // Prefer mangled_sym for overload-correct lookup; fall back to the
    // combined key for paths that only registered the non-overloaded form.
    mut fn_val: LValue = resolve_function(cg, mangled_sym);
    if (!fn_val.is_valid()) {
        fn_val = resolve_function(cg, combined_sym);
    }
    if (!fn_val.is_valid()) {
        // declare_method should have produced an LLVM declare for this
        // method.  When it didn't (e.g. cross-module trait impls whose
        // target lookup misses, or primitive impls whose target qualify
        // resolves to a name DI doesn't know), the body simply can't
        // land.  Emit a warning rather than an error so the build
        // continues — calls to this method will surface as undefined
        // references at link time, which is the correct visibility
        // outcome until the upstream declare path is fixed.
        cg.emit_warning_at_span(ErrorCode::E0619_METHOD_GENERATION_ERROR,
            format("codegen: method '%s::%s' has no LLVM declaration in this module — body skipped (declare_method should have produced one). Calls to this method will fail at link time.",
                type_str, method_str),
            func.span);
        return LValue::null();
    }

    const entry_bb: LBasicBlock = LBasicBlock::append(fn_val, "entry");
    cg.builder.position_at_end(entry_bb);

    cg.push_scope();

    // Detect which of the three self forms (if any) this method uses.
    //   `&this` / `mut &this` — param named "&this", semantically a T*
    //   `this`                — param named "this", semantically a by-value T
    //   (none)                — implicit `&this`; `declare_method` synthesized
    //                           a leading T* in the LLVM function signature
    // The LLVM parameter layout depends on which case we're in — matches the
    // logic in declare_method so named_values and LLVM params line up.
    mut explicit_ref_idx: i64 = -1;    // parameters[i] is "&this"
    mut explicit_val_idx: i64 = -1;    // parameters[i] is bare "this" (by-value self)
    mut explicit_typed_idx: i64 = -1;  // parameters[i] is "this: T*" (user-typed self)
    for (mut pc: i64 = 0; pc < func.parameters.length; pc++) {
        const pp: VarDeclNode* = func.parameters[pc];
        if (pp == null) { continue; }
        const pn: string = cg.resolve(pp.name);
        if (strcmp(pn, "&this") == 0) { explicit_ref_idx = pc; break; }
        if (strcmp(pn, "this") == 0) {
            if (pp.type_annotation == null) {
                explicit_val_idx = pc;
            } else {
                // `this: T*` — user wrote the type out, method takes
                // `this` as a regular typed parameter (e.g. Lexer's
                // helper methods that use this convention).
                explicit_typed_idx = pc;
            }
            break;
        }
    }

    mut param_idx: u32 = 0;

    // Bind `this` for instance methods.  All three forms produce a `this`
    // named-value that's a pointer to the struct — for by-value `this` we
    // alloca+store the struct so member-access GEPs work the same way.
    if (!node.is_static) {
        const qualified_target: SymbolStr = cg.ctx.qualify_symbol_sym(target_type);
        mut target_ref: TypeRef = cg.ctx.decl_index.lookup_type(qualified_target);
        if (target_ref.is_invalid()) {
            target_ref = cg.ctx.decl_index.lookup_type(target_type);
        }
        if (target_ref.is_invalid()) {
            const ts: string = cg.resolve(target_type);
            const ms: string = cg.resolve(func.name);
            cg.emit_error_at_span(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("codegen: method '%s::%s' — target type '%s' not found in declaration index", ts, ms, ts),
                func.span);
            cg.pop_scope();
            return LValue::null();
        }

        const this_sym: SymbolStr = cg.intern_str("this");
        const arg0: LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, 0) };

        if (explicit_val_idx >= 0) {
            // By-value `this`: LLVM param 0 is a struct value.  Alloca it so
            // downstream code (member access, method calls) can treat `this`
            // as a pointer uniformly.
            const target_mapped: LType = cg.type_mapper.map_type(target_ref);
            if (!target_mapped.is_valid()) {
                cg.emit_warning_at_span(ErrorCode::E0609_TYPE_MAPPING_ERROR,
                    format("codegen: method '%s::%s' — could not lower the by-value `this` type to LLVM; body skipped. Calls to this method will fail at link time.",
                        type_str, method_str),
                    func.span);
                cg.pop_scope();
                return LValue::null();
            }
            const slot: LValue = cg.create_entry_alloca(fn_val, "this", target_mapped);
            cg.builder.build_store(arg0, slot);
            cg.set_named_value(this_sym, slot);
        } else if (explicit_typed_idx >= 0) {
            // User-typed `this: T*` — LLVM param 0 is whatever the
            // annotation resolves to (typically a ptr).  Bind `this`
            // directly to that value, same as the `&this` path.
            cg.set_named_value(this_sym, arg0);
        } else {
            // `&this` (explicit or implicit): LLVM param 0 is already a ptr.
            // Store the raw pointer directly in named_values (no alloca).
            cg.set_named_value(this_sym, arg0);
        }

        param_idx = 1;
    }

    // Bind the remaining user parameters.  Skip whichever self form this
    // method uses (we already handled it above).  Cap iteration at the
    // fixed-param count so a trailing `args...` bucket doesn't try to pull
    // an LLVM param that doesn't exist.
    const fixed_count: u32 = fixed_param_count(func);
    for (mut i: u32 = 0; i < fixed_count; i++) {
        const param: VarDeclNode* = func.parameters[i];
        if (param == null) { continue; }
        if (i as i64 == explicit_ref_idx) { continue; }
        if (i as i64 == explicit_val_idx) { continue; }
        if (i as i64 == explicit_typed_idx) { continue; }

        const param_name: string = cg.resolve(param.name);
        const param_ty: LType = cg.type_mapper.map_type(param.resolved_type);
        if (!param_ty.is_valid()) {
            cg.emit_warning_at_span(ErrorCode::E0642_PARAM_TYPE_ERROR,
                format("codegen: method '%s::%s', parameter '%s' — could not lower its type to LLVM; body skipped. Calls to this method will fail at link time.",
                    type_str, method_str, param_name),
                if (param != null) { param.span } else { func.span });
            cg.pop_scope();
            return LValue::null();
        }

        const alloca: LValue = cg.create_entry_alloca(fn_val, param_name, param_ty);
        const arg: LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, param_idx) };
        cg.builder.build_store(arg, alloca);
        cg.set_named_value(param.name, alloca);
        param_idx = param_idx + 1;
    }

    return fn_val;
}


// ============================================================================
// Helpers
// ============================================================================

/// Map a function's return type to an LLVMType.
function map_return_type(cg: CodegenContext*, node: FunctionDeclNode*) -> LType {
    if (node.resolved_return_type.is_invalid()) {
        return LType::void_type();
    }

    const t: Type* = cg.lookup_type_by_id(node.resolved_return_type.id);
    if (t == null || t.kind == TypeKind::Void || t.kind == TypeKind::Unit) {
        return LType::void_type();
    }

    return cg.type_mapper.map_type(node.resolved_return_type);
}
