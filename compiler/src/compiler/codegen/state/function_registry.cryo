/// Function Registry
///
/// Module-local map of function declarations, keyed by LLVM SYMBOL:
/// `SymbolStr.id` -> `LLVMValueRef`.  A symbol names one function, so a
/// second registration under a key is the same value again.
///
/// Leaf component: owns its arrays, holds no back-pointers.

namespace compiler::codegen::state::function_registry;

import compiler::codegen::llvm_types;
import compiler::codegen::llvm_types::{ LValue };
import compiler::resolver::symbol_str;
import compiler::resolver::symbol_str::{ SymbolStr };
import std::core::option;
import std::core::option::{ Option };
import std::collections::{ pair, hashmap };
import std::collections::hashmap::{ HashMap };
import std::collections::pair::{ Pair };


type struct FunctionRegistry {
    by_name: Pair<u32, void*>[];   // (SymbolStr.id, LLVMValueRef)

    // Symbol id -> position in `by_name`, so a lookup is hashed rather than
    // a scan of every function in the module.
    by_name_index:    HashMap<u32, u32>;

    static new() -> FunctionRegistry {
        return FunctionRegistry {
            by_name:          [],
            by_name_index:    HashMap::<u32, u32>::new(),
        };
    }

    register(mut &this, name: SymbolStr, val: LValue) -> void {
        const key: u32 = name.id;
        match (this.by_name_index.get(&key)) {
            Option::Some(pos) => {
                this.by_name[pos as i64].second = val.raw;
                return;
            }
            Option::None => { }
        }
        const new_pos: u32 = this.by_name.length as u32;
        this.by_name.push(Pair::new(key, val.raw));
        this.by_name_index.insert(key, new_pos);
    }

    get(&this, name: SymbolStr) -> LValue {
        return match (this.by_name_index.get(&name.id)) {
            Option::Some(pos) => { LValue { raw: this.by_name[pos as i64].second } }
            Option::None      => { LValue::null() }
        };
    }
}
