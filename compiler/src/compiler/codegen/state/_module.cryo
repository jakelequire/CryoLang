/// Codegen State Modules
///
/// Leaf state components held by `CodegenContext` (and `VisitorState`
/// by the IR visitor).  Each component owns its data, has no back-
/// pointers, and depends only on a thin set of LLVM type wrappers.
/// These are wired into their parent via `wire()` after the parent
/// is at a stable heap address.

namespace compiler::codegen::state;

public module LoopStack;
public module ValueTable;
public module FunctionRegistry;
public module GlobalRegistry;
public module StringCache;
public module DiagSink;
public module VisitorState;
