/// Global Registry
///
/// Module-global variable map: `SymbolStr.id` -> `LLVMValueRef`.
/// Leaf component: owns its array, no back-pointers.

namespace Compiler::Codegen::State::GlobalRegistry;

import Compiler::Codegen::LLVMTypes;
import Compiler::Resolver::SymbolStr;
import std::core::option;
import std::collections::{ pair, hashmap };


type struct GlobalRegistry {
    entries: Pair<u32, void*>[];   // (SymbolStr.id, LLVMValueRef)
    // name SymbolStr.id -> position in `entries`, replacing the linear scan.
    index:   HashMap<u32, u32>;

    static new() -> GlobalRegistry {
        return GlobalRegistry { entries: [], index: HashMap<u32, u32>::new() };
    }

    register(mut &this, name: SymbolStr, val: LValue) -> void {
        const key: u32 = name.id;
        match (this.index.get(&key)) {
            Option::Some(pos) => {
                this.entries[pos as i64].second = val.raw;
                return;
            }
            Option::None => { }
        }
        const new_pos: u32 = this.entries.length as u32;
        this.entries.push(Pair::new(key, val.raw));
        this.index.insert(key, new_pos);
    }

    get(&this, name: SymbolStr) -> LValue {
        return match (this.index.get(&name.id)) {
            Option::Some(pos) => { LValue { raw: this.entries[pos as i64].second } }
            Option::None      => { LValue::null() }
        };
    }
}
