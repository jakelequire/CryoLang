/// Global Registry
///
/// Module-global variable map: a global's registration slot (the index's
/// `GlobalEntry.slot`) -> `LLVMValueRef`.
/// Leaf component: owns its array, no back-pointers.

namespace compiler::codegen::state::global_registry;

import compiler::codegen::llvm_types;
import compiler::codegen::llvm_types::{ LValue };


type struct GlobalRegistry {
    // Indexed by registration slot; null where this module holds no value.
    values: void*[];

    static new() -> GlobalRegistry {
        return GlobalRegistry { values: [] };
    }

    /// Record the value of the global registered at `slot`.
    register(mut &this, slot: i64, val: LValue) -> void {
        if (slot < 0) { return; }
        while (this.values.length <= slot) { this.values.push(null); }
        this.values[slot] = val.raw;
    }

    /// The value of the global registered at `slot`, or null.
    get(&this, slot: i64) -> LValue {
        if (slot < 0 || slot >= this.values.length) { return LValue::null(); }
        return LValue { raw: this.values[slot] };
    }
}
