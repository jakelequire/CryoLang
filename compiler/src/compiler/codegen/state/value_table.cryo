/// Value Table
///
/// Local-scope binding map: `SymbolStr.id` -> `LLVMValueRef` for the
/// current scope chain.  Uses an undo log so `pop_scope()` cheaply
/// restores prior bindings without needing to clone the live map.
///
/// Leaf component: owns its arrays, holds no back-pointers.

namespace Compiler::Codegen::State::ValueTable;

import Compiler::Codegen::LLVMTypes;
import Compiler::Resolver::SymbolStr;
import std::collections::pair;


// ============================================================================
// ValueTable
// ============================================================================

type struct ValueTable {
    named: Pair<u32, void*>[];   // (SymbolStr.id, LLVMValueRef) - live map

    // Undo log: each push_scope() records the log length so the matching
    // pop_scope() can roll the live map back to that point.
    undo:        Pair<u32, void*>[];   // (key, previous LLVMValueRef or null)
    scope_marks: i64[];                // undo log length at each scope push

    static new() -> ValueTable {
        return ValueTable {
            named:       [],
            undo:        [],
            scope_marks: [],
        };
    }

    push_scope(mut &this) -> void {
        this.scope_marks.push(this.undo.length);
    }

    pop_scope(mut &this) -> void {
        if (this.scope_marks.length == 0) {
            return;
        }

        const mark: i64 = this.scope_marks[this.scope_marks.length - 1];
        this.scope_marks.pop();

        // Roll back undo log entries from mark to end.
        for (mut i: i64 = this.undo.length - 1; i >= mark; i--) {
            const key: u32 = this.undo[i].first;
            const prev: void* = this.undo[i].second;

            if (prev == null) {
                this.remove_raw(key);
            } else {
                this.set_raw(key, prev);
            }
        }

        while (this.undo.length > mark) { this.undo.pop(); }
    }

    set(mut &this, name: SymbolStr, val: LValue) -> void {
        const key: u32 = name.id;
        const existing: void* = this.get_raw(key);
        this.undo.push(Pair::new(key, existing));
        this.set_raw(key, val.raw);
    }

    get(&this, name: SymbolStr) -> LValue {
        const raw: void* = this.get_raw(name.id);
        return LValue { raw: raw };
    }

    get_raw(&this, key: u32) -> void* {
        for (mut i: i64 = 0; i < this.named.length; i++) {
            if (this.named[i].first == key) {
                return this.named[i].second;
            }
        }
        return null;
    }

    set_raw(mut &this, key: u32, val: void*) -> void {
        for (mut i: i64 = 0; i < this.named.length; i++) {
            if (this.named[i].first == key) {
                this.named[i].second = val;
                return;
            }
        }
        this.named.push(Pair::new(key, val));
    }

    remove_raw(mut &this, key: u32) -> void {
        for (mut i: i64 = 0; i < this.named.length; i++) {
            if (this.named[i].first == key) {
                const last: i64 = this.named.length - 1;
                if (i < last) {
                    this.named[i] = this.named[last];
                }
                this.named.pop();
                return;
            }
        }
    }
}
