/// Value Table
///
/// Local-scope binding map: a local's binding -> `LLVMValueRef` for the
/// current scope chain.  Uses an undo log so `pop_scope()` cheaply
/// restores prior bindings without needing to clone the live map.
///
/// Keyed by the binding the name layer declared (`sym_id` at the
/// declaration, `Res::Local` at a use), never by the spelling: one function
/// may declare a spelling more than once, and each declaration owns storage
/// of its own.  A pass that writes a local after name resolution stamps it
/// the same way, so a read with no binding names no local.
///
/// Leaf component: owns its arrays, holds no back-pointers.

namespace compiler::codegen::state::value_table;

import compiler::codegen::llvm_types;
import compiler::codegen::llvm_types::{ LValue };
import compiler::resolver::symbol_id;
import compiler::resolver::symbol_id::{ SymbolID };
import std::collections::pair;
import std::collections::pair::{ Pair };


type struct ValueTable {
    bound: Pair<SymbolID, void*>[];   // (binding, LLVMValueRef) - live map

    // Undo log: each push_scope() records the log length so the matching
    // pop_scope() can roll the live map back to that point.
    undo:        Pair<SymbolID, void*>[];   // (key, previous LLVMValueRef or null)
    scope_marks: i64[];                     // undo log length at each scope push

    // Function-persistent bindings: bindings that must outlive the
    // block scope they're declared in (synthesized drop-flag locals - the
    // alloca is function-scoped, but the conditional drop that reads the
    // flag can run at an OUTER scope, after the declaring block popped).
    // Registered without an undo entry so `pop_scope()` never rolls them
    // back; cleared explicitly at the function epilogue.
    persistent_keys: SymbolID[];

    static new() -> ValueTable {
        return ValueTable {
            bound:           [],
            undo:            [],
            scope_marks:     [],
            persistent_keys: [],
        };
    }

    /// Register a binding that survives `pop_scope()`.  Used for
    /// synthesized drop-flag locals whose reader (a conditional drop) may
    /// execute in an enclosing scope.  No undo entry is recorded, so the
    /// rollback in `pop_scope()` leaves it intact.  `clear_persistent()`
    /// removes them at function end.
    set_persistent(mut &this, sym: SymbolID, val: LValue) -> void {
        this.set_raw(sym, val.raw);
        for (mut i: i64 = 0; i < this.persistent_keys.length; i++) {
            if (this.persistent_keys[i].equals(sym)) { return; }
        }
        this.persistent_keys.push(sym);
    }

    /// Drop every persistent binding.  Called from the function epilogue so
    /// a drop flag's binding doesn't outlive its function.
    clear_persistent(mut &this) -> void {
        for (mut i: i64 = 0; i < this.persistent_keys.length; i++) {
            this.remove_raw(this.persistent_keys[i]);
        }
        this.persistent_keys = [];
    }

    push_scope(mut &this) -> void {
        this.scope_marks.push(this.undo.length);
    }

    pop_scope(mut &this) -> void {
        if (this.scope_marks.length == 0) {
            return;
        }

        const mark: i64 = this.scope_marks[this.scope_marks.length - 1];
        this.scope_marks.pop();

        // Roll back undo log entries from mark to end.
        for (mut i: i64 = this.undo.length - 1; i >= mark; i--) {
            const key: SymbolID = this.undo[i].first;
            const prev: void* = this.undo[i].second;

            if (prev == null) {
                this.remove_raw(key);
            } else {
                this.set_raw(key, prev);
            }
        }

        while (this.undo.length > mark) { this.undo.pop(); }
    }

    set(mut &this, sym: SymbolID, val: LValue) -> void {
        const existing: void* = this.get_raw(sym);
        this.undo.push(Pair::new(sym, existing));
        this.set_raw(sym, val.raw);
    }

    /// Bind `sym` with no undo entry, for the span of one synthesized
    /// statement; `remove` unbinds it.
    bind_transient(mut &this, sym: SymbolID, val: LValue) -> void {
        this.set_raw(sym, val.raw);
    }

    remove(mut &this, sym: SymbolID) -> void {
        this.remove_raw(sym);
    }

    /// The storage of the local `sym` binds, or null - which is also the
    /// answer for an invalid `sym`, a name that binds no local.
    get(&this, sym: SymbolID) -> LValue {
        if (!sym.is_valid()) { return LValue::null(); }
        return LValue { raw: this.get_raw(sym) };
    }

    get_raw(&this, key: SymbolID) -> void* {
        for (mut i: i64 = 0; i < this.bound.length; i++) {
            if (this.bound[i].first.equals(key)) {
                return this.bound[i].second;
            }
        }
        return null;
    }

    set_raw(mut &this, key: SymbolID, val: void*) -> void {
        for (mut i: i64 = 0; i < this.bound.length; i++) {
            if (this.bound[i].first.equals(key)) {
                this.bound[i].second = val;
                return;
            }
        }
        this.bound.push(Pair::new(key, val));
    }

    remove_raw(mut &this, key: SymbolID) -> void {
        for (mut i: i64 = 0; i < this.bound.length; i++) {
            if (this.bound[i].first.equals(key)) {
                const last: i64 = this.bound.length - 1;
                if (i < last) {
                    this.bound[i] = this.bound[last];
                }
                this.bound.pop();
                return;
            }
        }
    }
}
