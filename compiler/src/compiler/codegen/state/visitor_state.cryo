/// Visitor State
///
/// Per-IRGeneratorVisitor mutable state shared across the visit()
/// methods.  Held by IRGeneratorVisitor (embedded by value) and, after
/// the IR-gen-side decomposition, referenced by sub-emitters via a
/// `state: VisitorState*` back-pointer.
///
/// `last_value` / `last_is_lvalue` form the visitor's "return channel":
/// each `visit(...)` override stashes its result here, and the caller
/// (often the same visitor recursing through `accept(visitor)`) reads
/// it back.  `current_impl_target` is set while traversing an impl
/// block so method bodies can resolve `Self`.  `lambda_counter` mints
/// unique names for anonymous lambdas within a module.
///
/// Leaf component: owns its fields, holds no back-pointers.

namespace compiler::codegen::state::visitor_state;

import compiler::codegen::llvm_types;
import compiler::resolver::symbol_str;


type struct VisitorState {
    /// Result of the most recent expression codegen.  Each visit(Expr*)
    /// override writes here; recursive callers read it back.
    last_value:     LValue;
    last_is_lvalue: boolean;

    /// Current impl block target type, set during impl-block traversal
    /// so method bodies can resolve `Self` and emit correct mangles.
    current_impl_target: SymbolStr;

    /// Monotonic counter for anonymous-function names (`__lambda_0`,
    /// `__lambda_1`, ...).  Kept unique across modules by qualifying
    /// the emitted symbol with the current namespace at use sites.
    lambda_counter: u64;

    static new() -> VisitorState {
        return VisitorState {
            last_value:          LValue::null(),
            last_is_lvalue:      false,
            current_impl_target: SymbolStr::empty(),
            lambda_counter:      0,
        };
    }
}
