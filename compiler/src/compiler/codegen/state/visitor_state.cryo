/// Visitor State
///
/// Per-IRGeneratorVisitor mutable state shared across the visit()
/// methods.  Held by IRGeneratorVisitor (embedded by value) and, after
/// the IR-gen-side decomposition, referenced by sub-emitters via a
/// `state: VisitorState*` back-pointer.
///
/// `current_impl_target` is set while traversing an impl block so method
/// bodies can resolve `Self`.  `lambda_counter` mints unique names for
/// anonymous lambdas within a module.  What emitting a node produced is
/// returned as an `Emitted`, never left here.
///
/// Leaf component: owns its fields, holds no back-pointers.

namespace compiler::codegen::state::visitor_state;

import compiler::codegen::llvm_types::{ LValue };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::types::type_ref::{ TypeRef };


/// What emitting a node produced: the value, and whether it is a place (an
/// address to load from or store to) rather than the value itself.  A
/// statement produces the value of its trailing expression statement, which
/// is how a block-bodied match arm yields its value; any other statement
/// produces none.
type struct Emitted {
    value:     LValue;
    is_lvalue: boolean;

    static none() -> Emitted { return Emitted { value: LValue::null(), is_lvalue: false }; }
    static rvalue(v: LValue) -> Emitted { return Emitted { value: v, is_lvalue: false }; }
    static place(v: LValue) -> Emitted { return Emitted { value: v, is_lvalue: true }; }
}

type struct VisitorState {
    /// The type whose methods are being emitted - an impl block's owner or
    /// a declaration's own type - while its bodies are walked; invalid
    /// outside one.  A type, not a name: `implement i32` and `for ()` have
    /// an owner and no declaration.
    current_impl_target: TypeRef;

    /// Monotonic counter for anonymous-function names (`__lambda_0`,
    /// `__lambda_1`, ...).  Kept unique across modules by qualifying
    /// the emitted symbol with the current namespace at use sites.
    lambda_counter: u64;

    static new() -> VisitorState {
        return VisitorState {
            current_impl_target: TypeRef::invalid(),
            lambda_counter:      0,
        };
    }
}
