/// Loop Stack
///
/// Per-codegen-context stack of `break` and `continue` target basic
/// blocks.  One entry is pushed when a loop header is emitted and
/// popped when the loop body finishes.  `break` and `continue`
/// statements consult the top of the stack to find their jump target.
///
/// Leaf component: owns its arrays, holds no back-pointers, depends
/// only on the LLVM-types wrapper for `LBasicBlock`.

namespace Compiler::Codegen::State::LoopStack;

import Compiler::Codegen::LLVMTypes;


type struct LoopStack {
    break_targets:    void*[];     // LLVMBasicBlockRef stack
    continue_targets: void*[];     // LLVMBasicBlockRef stack

    static new() -> LoopStack {
        return LoopStack {
            break_targets:    [],
            continue_targets: [],
        };
    }

    push(mut &this, break_bb: LBasicBlock, continue_bb: LBasicBlock) -> void {
        this.break_targets.push(break_bb.raw);
        this.continue_targets.push(continue_bb.raw);
    }

    pop(mut &this) -> void {
        if (this.break_targets.length > 0) {
            this.break_targets.pop();
            this.continue_targets.pop();
        }
    }

    current_break(&this) -> LBasicBlock {
        if (this.break_targets.length == 0) {
            return LBasicBlock::null();
        }
        return LBasicBlock { raw: this.break_targets[this.break_targets.length - 1] };
    }

    current_continue(&this) -> LBasicBlock {
        if (this.continue_targets.length == 0) {
            return LBasicBlock::null();
        }
        return LBasicBlock { raw: this.continue_targets[this.continue_targets.length - 1] };
    }
}
