/// New / Delete Emitter
///
/// `new T { fields }` takes storage from `T`'s `Allocate` or else the
/// global allocator and stores the struct literal's field inits;
/// `new E::V(args)` boxes an enum variant.
///
/// `delete ptr` is the manual-memory dual of an end-of-scope drop:
/// release the pointee as a scope exit releases a value of its type
/// (its `Drop`, then the fields it owns), then hand the pointer to the
/// `Allocate`'s `release`, or free it.
///
/// Holds the same back-pointer bundle as CallEmitter (cg, state,
/// dispatch, enum_variant) - both modules construct heap objects and
/// need argument-expression evaluation + enum-variant building.

namespace compiler::codegen::visit::new_delete_emitter;

import compiler::codegen;
import compiler::codegen::{ context, llvm, llvm_types, type_map, util };
import compiler::codegen::util::{ CodegenUtil };
import compiler::codegen::state::visitor_state;
import compiler::codegen::state::visitor_state::{ Emitted, VisitorState };
import compiler::codegen::visit::{ expr_dispatch, enum_variant_emitter };
import compiler::compilation_context;
import compiler::compilation_context::{ CompilationContext };
import compiler::decl_index;
import compiler::diag;
import compiler::diag::{ diagnostic, ErrorCode, source_span };
import compiler::types;
import compiler::types::{
    arena, compound, generic, generic_registry, IntegerKind, ownership, type_base, type_ref, TypeKind, user_defined
};
import compiler::ast;
import compiler::ast::{ MemberPin, node, expression, statement };
import compiler::resolver::{ symbol_str, intern_table, qualified_name, mangled_name };
import std::collections::pair;
import std::collections::pair::{ Pair };
import std::fmt;
import compiler::ast::expression::{
    CallExpr, DeleteExpr, ExpressionNode, FieldInit,
    MemberAccessExpr, NewExpr, StructExpr
};
import compiler::lex;
import compiler::lex::{ Token, TokenType };
import compiler::ast::statement::{ Stmt };
import compiler::ast::declaration;
import compiler::ast::declaration::{ DeclarationNode, ImplBlock, MethodDecl };
import compiler::resolver::lang_item;
import compiler::resolver::lang_item::{ LangItem };
import compiler::codegen::visit::ir_generator;
import compiler::codegen::visit::ir_generator::{ IRGeneratorVisitor };
import compiler::codegen::context::{ CodegenContext };
import compiler::codegen::llvm_types::{ LType, LTypeKind, LValue };
import compiler::codegen::visit::expr_dispatch::{ ExprDispatch };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::mangled_name::{ MangledName };
import compiler::resolver::qualified_name::{ QualifiedName };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::symbol_id;
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::resolver::res;
import compiler::resolver::res::{ DefId, FamilyOwner, Res };
import compiler::types::arena::{ TypeArena };
import compiler::types::compound::{ PointerType };
import compiler::types::generic_registry::{ GenericRegistry };
import compiler::types::ownership::{ OwnershipQuery };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };
import compiler::types::user_defined::{ EnumType, EnumVariantInfo, StructType };
import compiler::codegen::visit::enum_variant_emitter::{ EnumVariantEmitter };


type struct NewDeleteEmitter {
    cg:           CodegenContext*;
    state:        VisitorState*;
    dispatch:     ExprDispatch*;
    enum_variant: EnumVariantEmitter*;

    static null() -> NewDeleteEmitter {
        return NewDeleteEmitter {
            cg:           null,
            state:        null,
            dispatch:     null,
            enum_variant: null,
        };
    }

    wire(mut &this, cg: CodegenContext*, state: VisitorState*,
                    dispatch: ExprDispatch*, enum_variant: EnumVariantEmitter*) -> void {
        this.cg           = cg;
        this.state        = state;
        this.dispatch     = dispatch;
        this.enum_variant = enum_variant;
    }

    // Allocate

    /// The implementation of the language's `Allocate` that `new` of `ty`
    /// takes its storage from and `delete` returns it to: the struct's own;
    /// null when there is none, and the global allocator serves it.
    allocator_of(mut &this, ty: TypeRef) -> ImplBlock* {
        const registry: GenericRegistry* = this.cg.ctx.generic_registry;
        const trait_id: DefId = registry.wellknown(LangItem::Allocate);
        if (!trait_id.is_valid()) { return null; }
        const t: Type* = this.cg.arena_type(ty);
        if (t == null || t.kind != TypeKind::Struct) { return null; }
        return DeclarationNode::impl_of(registry.select_trait_impl(trait_id, ty, this.cg.get_intern()));
    }

    /// The function `block`'s method for the `Allocate` method `item` lowers
    /// to: the one it writes, or the copy of the trait's default.  Null,
    /// reported, when the implementation has no function code generation
    /// can call.
    allocator_method(mut &this, block: ImplBlock*, item: LangItem, span: SourceSpan) -> LValue {
        const registry: GenericRegistry* = this.cg.ctx.generic_registry;
        const m: MethodDecl* = DeclarationNode::method_of(registry.trait_item_method(
            block, registry.trait_item_position(registry.wellknown(item))));
        mut f: LValue = LValue::null();
        if (m != null && m.func != null) { f = this.cg.resolver.resolve_decl(DeclarationNode::fn_of(m.func).overload_entry); }
        if (!f.is_valid()) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0636_UNDEFINED_FUNCTION_CALL,
                fmt::format("codegen: the `Allocate` implementation has no `%s` to call",
                    item.leaf()), span);
        }
        return f;
    }


    // new T { fields } / new E::V(args)

    emit_new(mut &this, visitor: IRGeneratorVisitor*, e: ExpressionNode*, node: NewExpr*) -> Emitted {
        mut out: Emitted = Emitted::none();
        // Array allocation `new T[n]` is handled up front: it allocates raw
        // memory and the element may be a primitive (`new int[100]`) whose
        // name is a keyword not in the decl index, so the type_name lookup
        // below would fail.  emit_new_array reads the element type from the
        // sema-resolved `T*` result type instead.
        if (node.has_array_size()) {
            return this.emit_new_array(visitor, e, node);
        }

        const intern: InternTable* = this.cg.get_intern();
        const arena_p: TypeArena* = this.cg.get_arena();

        // What `new T` allocates is what sema resolved the node to, read off
        // the node: `resolved_type` is `T*` (a `new` yields a pointer), so the
        // pointee is the type.  The spelling is not consulted: sema already
        // answered it from the name layer's stamp.
        mut type_ref: TypeRef = TypeRef::invalid();
        if (e.has_resolved_type()) {
            const rt: Type* = arena_p.lookup(e.resolved_type);
            if (rt != null && rt.kind == TypeKind::Pointer) {
                type_ref = rt.as_pointer().pointee;
            }
        }
        const t: Type* = this.cg.arena_type(type_ref);
        if (t == null) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0635_TYPE_CONSTRUCTOR_UNDEFINED,
                fmt::format("codegen: 'new': target type '%s' not found",
                    intern.resolve(node.type_name)),
                e.span);
            out.value = LValue::null();
            out.is_lvalue = false;
            return out;
        }

        // Heap-allocated enum variant: the one sema pinned inside the enum
        // the stamp names (a leaf the enum lacks was refused there).
        if (t.kind == TypeKind::Enum && node.has_variant()) {
            const et: EnumType* = t.as_enum();
            const variant: EnumVariantInfo* = CodegenUtil::pinned_variant(et, node.resolved_member);
            if (variant == null) {
                this.cg.diag.emit_error_at_span(ErrorCode::E0635_TYPE_CONSTRUCTOR_UNDEFINED,
                    "codegen: `new T::V(...)` carries no variant pin: no sema walk answered it",
                    e.span);
                out.value = LValue::null();
                out.is_lvalue = false;
                return out;
            }
            mut vargs: [LValue] = [];
            for (mut i: i64 = 0; i < node.arguments.length; i++) {
                vargs.push(this.dispatch.codegen_rvalue(visitor,node.arguments[i]));
            }
            const variant_val: LValue = this.enum_variant.build(et, variant, type_ref, vargs);
            out.value = this.cg.expr_ops.heap_box_enum_variant(et, type_ref, variant_val, e.span);
            out.is_lvalue = false;
            return out;
        }

        const mapped: LType = this.cg.type_mapper.map_type(type_ref);
        // An aggregate's size is the `computed_size` type lowering gave it.
        mut size: u64 = 0;
        if (t.kind == TypeKind::Struct) {
            const st: StructType* = t.as_struct();
            size = st.computed_size;
        } else if (t.kind == TypeKind::Enum) {
            const et: EnumType* = t.as_enum();
            size = et.computed_size;
        } else {
            size = t.size_bytes();
        }
        if (size == 0) { size = 1; }  // safe fallback; malloc(0) is UB on some platforms

        const size_val: LValue = LType::const_int(LType::i64(), size, false);

        // A type with an `Allocate` takes its storage from it; everything
        // else shares the canonical GlobalAlloc via the shared funnel. The
        // bitcast and struct init below are the same whichever allocator
        // supplied the storage.
        const alloc_block: ImplBlock* = this.allocator_of(type_ref);
        mut alloc_fn: LValue = LValue::null();
        if (alloc_block != null) {
            alloc_fn = this.allocator_method(alloc_block, LangItem::AllocateAllocate, e.span);
            if (!alloc_fn.is_valid()) {
                out.value = LValue::null();
                out.is_lvalue = false;
                return out;
            }
        }
        const align: u64 = 16;
        const raw_ptr: LValue = this.cg.expr_ops.emit_raw_alloc(
            alloc_fn, size_val, align, "newtmp", e.span, "'new' expression");
        if (!raw_ptr.is_valid()) {
            out.value = LValue::null();
            out.is_lvalue = false;
            return out;
        }

        // Bitcast to the target struct pointer type.
        mut obj_ptr: LValue = raw_ptr;
        if (mapped.is_valid()) {
            obj_ptr = this.cg.builder.build_pointer_cast(
                raw_ptr, LType::pointer_to(mapped), "newcast");
        }

        // Initialize fields for `new T { fields }`. Without this the malloc'd
        // struct's fields are left uninitialized; every TypeAnnotation* the
        // parser produces would be a pointer to garbage.
        if (node.struct_init != null && t.kind == TypeKind::Struct && mapped.is_valid()) {
            const lit: StructExpr* = ExpressionNode::struct_of(node.struct_init);
            const st: StructType* = t.as_struct();
            for (mut sfi: i64 = 0; sfi < lit.field_inits.length; sfi++) {
                const finit: FieldInit = lit.field_inits[sfi];
                // The field is the one sema pinned on the initializer.
                mut sf_fidx: i64 = -1;
                match (finit.pin) {
                    MemberPin::Field(ix) => { if (ix < st.fields.length) { sf_fidx = ix; } }
                    _                       => { }
                }
                if (sf_fidx >= 0) {
                    const gep: LValue = this.cg.field_gep(t, mapped, obj_ptr, sf_fidx, "field");
                    mut val: LValue = this.dispatch.codegen_rvalue(visitor,finit.value);
                    if (val.is_valid() && gep.is_valid()) {
                        // Widen/narrow integer literal to field's declared
                        // width before storing.  `new ArrayAnnotation { size: -1, ... }`
                        // arrives with `-1` as `i32 -1` but `size` is `i64`
                        // a direct `store i32` writes 4 bytes leaving the
                        // upper 4 bytes of the i64 slot uninitialised, and a
                        // `size < 0` check then sees a huge positive number.
                        // Mirrors codegen_struct_literal and codegen_local_var.
                        const field_llvm_ty: void* = llvm::LLVMStructGetTypeAtIndex(mapped.raw, sf_fidx as u32);
                        const val_ty_raw: void* = llvm::LLVMTypeOf(val.raw);
                        if (field_llvm_ty != null && val_ty_raw != null
                                && LType::kind_of(field_llvm_ty) == LTypeKind::Integer
                                && LType::kind_of(val_ty_raw) == LTypeKind::Integer) {
                            const want_bits: u32 = llvm::LLVMGetIntTypeWidth(field_llvm_ty);
                            const got_bits:  u32 = llvm::LLVMGetIntTypeWidth(val_ty_raw);
                            const field_lty: LType = LType { raw: field_llvm_ty };
                            if (want_bits > got_bits) {
                                mut signed_target: boolean = false;
                                const field_t: Type* = this.cg.arena_type(
                                    st.fields[sf_fidx].field_type);
                                if (field_t != null && field_t.kind == TypeKind::Int) {
                                    const ft_int: IntegerKind = field_t.int_kind();
                                    signed_target = ft_int.is_signed();
                                }
                                if (signed_target) {
                                    val = this.cg.builder.build_sext(val, field_lty, "field.widen");
                                } else {
                                    val = this.cg.builder.build_zext(val, field_lty, "field.widen");
                                }
                            } else if (want_bits < got_bits) {
                                val = this.cg.builder.build_trunc(val, field_lty, "field.trunc");
                            }
                        }
                        this.cg.builder.build_store(val, gep);
                    }
                }
            }
        }

        out.value = obj_ptr;
        out.is_lvalue = false;
        return out;
    }

    // new T[n]  - raw array allocation

    /// Lower `new T[n]` to `malloc(n * sizeof(T))` cast to `T*`.  The memory
    /// is left uninitialized - nothing fills it - matching the doc's
    /// `const arr: int* = new int[100]` example and the low-level framing of
    /// section 14.2 (use `Array<T>` when you want constructed/managed elements).
    /// The element type is read from the sema-resolved `T*` result type so
    /// primitive elements (whose name is a keyword, not a decl-index entry)
    /// resolve the same way user types do.
    emit_new_array(mut &this, visitor: IRGeneratorVisitor*, e: ExpressionNode*, node: NewExpr*) -> Emitted {
        mut out: Emitted = Emitted::none();
        const result_t: Type* = this.cg.arena_type(e.resolved_type);
        if (result_t == null || result_t.kind != TypeKind::Pointer) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0635_TYPE_CONSTRUCTOR_UNDEFINED,
                "codegen: 'new T[n]': could not resolve element type",
                e.span);
            out.value = LValue::null();
            out.is_lvalue = false;
            return out;
        }
        const elem_ref: TypeRef = result_t.as_pointer().pointee;
        const elem_t: Type* = this.cg.arena_type(elem_ref);
        const elem_llvm: LType = this.cg.type_mapper.map_type(elem_ref);

        // Element byte size (same kind-derivation as emit_new: an
        // aggregate's is its `computed_size`).
        mut elem_size: u64 = 0;
        if (elem_t != null) {
            if (elem_t.kind == TypeKind::Struct) {
                elem_size = elem_t.as_struct().computed_size;
            } else if (elem_t.kind == TypeKind::Enum) {
                elem_size = elem_t.as_enum().computed_size;
            } else {
                elem_size = elem_t.size_bytes();
            }
        }
        if (elem_size == 0) { elem_size = 1; }

        // Element count expression -> i64.
        mut count_val: LValue = this.dispatch.codegen_rvalue(visitor, node.array_size);
        if (!count_val.is_valid()) {
            out.value = LValue::null();
            out.is_lvalue = false;
            return out;
        }
        count_val = this.widen_to_i64(count_val);

        // Abort before the multiply wraps: `count * elem_size` overflowing
        // u64 would malloc a too-small block and the element writes would
        // run off the heap. (Same guard class as `Layout::array`.)
        this.cg.expr_ops.emit_array_mul_guard(count_val, elem_size,
            visitor, &node.unwind_cleanup, e.span);

        const elem_size_val: LValue = LType::const_int(LType::i64(), elem_size, false);
        const total: LValue = this.cg.builder.build_mul(
            count_val, elem_size_val, "new.arr.bytes");

        // An element type with an `Allocate` takes the block from it, as
        // `new` of one does.  Array allocations use a fixed 16 alignment.
        const alloc_block: ImplBlock* = this.allocator_of(elem_ref);
        mut alloc_fn: LValue = LValue::null();
        if (alloc_block != null) {
            alloc_fn = this.allocator_method(alloc_block, LangItem::AllocateAllocate, e.span);
            if (!alloc_fn.is_valid()) {
                out.value = LValue::null();
                out.is_lvalue = false;
                return out;
            }
        }
        const raw_ptr: LValue = this.cg.expr_ops.emit_raw_alloc(
            alloc_fn, total, 16, "new.arr", e.span, "'new T[n]'");
        if (!raw_ptr.is_valid()) {
            out.value = LValue::null();
            out.is_lvalue = false;
            return out;
        }

        mut elem_ptr: LValue = raw_ptr;
        if (elem_llvm.is_valid()) {
            elem_ptr = this.cg.builder.build_pointer_cast(
                raw_ptr, LType::pointer_to(elem_llvm), "new.arr.cast");
        }
        out.value = elem_ptr;
        out.is_lvalue = false;
        return out;
    }

    /// Widen an integer value to i64 for use as a malloc byte count.  Array
    /// element counts are non-negative, so a narrower value is zero-extended;
    /// an i64 passes through; a wider value is truncated (defensive).
    widen_to_i64(mut &this, v: LValue) -> LValue {
        const raw_ty: void* = llvm::LLVMTypeOf(v.raw);
        if (LType::kind_of(raw_ty) != LTypeKind::Integer) { return v; }
        const bits: u32 = llvm::LLVMGetIntTypeWidth(raw_ty);
        if (bits == 64) { return v; }
        if (bits > 64)  { return this.cg.builder.build_trunc(v, LType::i64(), "new.arr.cnt"); }
        return this.cg.builder.build_zext(v, LType::i64(), "new.arr.cnt");
    }

    // delete ptr

    emit_delete(mut &this, visitor: IRGeneratorVisitor*, e: ExpressionNode*, node: DeleteExpr*) -> Emitted {
        mut out: Emitted = Emitted::none();
        const span: SourceSpan = e.span;
        // `delete ptr` is the manual-memory dual of an end-of-scope drop:
        //   1. Release the pointee as a scope exit releases a value of its
        //      type: its destructor, if it has one, then its owned fields.
        //   2. Free the allocation.
        // The operand is evaluated exactly once (see below): the pointer
        // is spilled to a temp slot, the release is synthesized as
        // `(*recv).drop()` on a synthetic local reading that slot - bound to
        // the pointee's `Drop` implementation by identity, or left for the
        // type's glue when it has none - and the same spilled pointer is
        // freed.  This
        // makes side-effecting operands (`delete arr.pop()`) safe: the
        // side effects fire once and the destructor and `free` see the
        // identical pointer.
        const operand_type: TypeRef = node.operand.resolved_type;
        const arena_ptr: TypeArena* = this.cg.get_arena();
        const intern_ptr: InternTable* = this.cg.get_intern();
        const registry_ptr: GenericRegistry* = this.cg.ctx.generic_registry;

        mut pointee: TypeRef = TypeRef::invalid();
        if (operand_type.is_valid() && arena_ptr != null) {
            const ot: Type* = arena_ptr.lookup(operand_type);
            if (ot != null && ot.kind == TypeKind::Pointer) {
                const pt: PointerType* = ot.as_pointer();
                pointee = pt.pointee;
            }
        }

        // A type with an `Allocate` returns its storage through that
        // implementation's `release`, never to the global allocator, which
        // does not own it.
        mut release_fn: LValue = LValue::null();
        if (pointee.is_valid()) {
            const alloc_block: ImplBlock* = this.allocator_of(pointee);
            if (alloc_block != null) {
                release_fn = this.allocator_method(alloc_block, LangItem::AllocateRelease, span);
                if (!release_fn.is_valid()) {
                    out.value = LValue::null();
                    out.is_lvalue = false;
                    return out;
                }
            }
        }

        mut should_drop: boolean = false;
        if (pointee.is_valid() && arena_ptr != null && registry_ptr != null
                && intern_ptr != null) {
            should_drop = OwnershipQuery::needs_drop(arena_ptr, registry_ptr,
                                                     intern_ptr, pointee);
        }

        // Evaluate the operand exactly once.  A side-effecting operand
        // (`delete arr.pop()`) must not fire its side effects twice, and
        // the destructor must run on the *same* pointer that is freed - a
        // second evaluation can yield a different pointer (UAF /
        // double-free).  Spill the evaluated pointer to a temp slot and
        // drive both the synthesized `.drop()` and the `free` off it.
        const ptr: LValue = this.dispatch.codegen_rvalue(visitor, node.operand);
        if (!ptr.is_valid()) {
            out.value = LValue::null();
            out.is_lvalue = false;
            return out;
        }

        if (should_drop) {
            // Bind the already-evaluated pointer to a synthetic local so
            // the release (which re-codegens its receiver node) reads the
            // spilled value instead of re-evaluating `node.operand`.  The
            // release is `(*recv).drop()`, the one a scope exit gives a value
            // of the pointee's type: its destructor, if it has one, then the
            // release of the fields it owns.
            const slot_ty: LType = LType::pointer_to(LType::i8());
            // Hoisted to the entry block: `delete` in a loop body would
            // otherwise leave one spill slot behind per iteration.  The slot
            // holds only the pointer for the span of the synthesized `.drop()`
            // below, and the store precedes that read on every iteration.
            const slot: LValue = this.cg.flow.temp_slot(slot_ty, "delete.recv");
            this.cg.builder.build_store(ptr, slot);
            const recv_sym: SymbolStr = intern_ptr.intern("$delete.recv");
            const recv_bind: SymbolID = this.cg.ctx.resolver.alloc_synthetic_binding();
            this.cg.values.bind_transient(recv_bind, slot);

            const drop_sym: SymbolStr = intern_ptr.intern("drop");
            const recv: ExpressionNode* = ExpressionNode::identifier_expr(recv_sym, span);
            ExpressionNode::identifier_of(recv).set_res(Res::Local(recv_bind));
            recv.set_resolved_type(node.operand.resolved_type);
            const deref_tok: Token = Token::new(TokenType::Star, "*",
                span.start_line as int, span.start_col as int);
            mut target: ExpressionNode* = ExpressionNode::synthetic_unary(
                deref_tok, recv, span);
            target.set_resolved_type(pointee);
            mut member: ExpressionNode* = ExpressionNode::member_access_expr(
                target, drop_sym, span, span);
            member.set_resolved_type(TypeRef::invalid());
            mut call: ExpressionNode* = ExpressionNode::call_expr(
                member, span);
            this.cg.bind_destructor_call(call);
            mut stmt: Stmt* = Stmt::expr_stmt(
                call, span);
            visitor.dispatch_node(Node::Stmt(stmt));

            this.cg.values.remove(recv_bind);
        }

        // Free through the canonical `GlobalAlloc` (via `free`):
        // a `delete` of an object that was arena-allocated (the compiler
        // building itself) must NOT reach libc `free` - `GlobalAlloc::
        // deallocate` no-ops arena-owned pointers (bulk-reclaimed at the
        // target boundary) and frees libc-owned ones.  Falls back to a direct
        // `free` when the stdlib is not linked (e.g. `--no-std`).  The shim
        // takes the pointee alignment so the dealloc pairs with the `new`
        // site on platforms where free is alignment-sensitive (Windows
        // `_aligned_free`); the computation mirrors `emit_new`.
        const del_align: u64 = 16;
        if (release_fn.is_valid()) {
            const rel_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(release_fn.raw) };
            const rel_ptr: LValue = this.cg.builder.build_pointer_cast(
                ptr, LType::pointer_to(LType::i8()), "delcast");
            mut rel_args: [Pair<LValue, TypeRef>] = [];
            rel_args.push(Pair::<LValue, TypeRef>::new(rel_ptr, TypeRef::invalid()));
            rel_args.push(Pair::<LValue, TypeRef>::new(
                LType::const_int(LType::i64(), del_align, false), TypeRef::invalid()));
            this.cg.expr_ops.codegen_call(release_fn, rel_ty, rel_args, "");
        } else {
            this.cg.expr_ops.emit_raw_dealloc(ptr, del_align, span);
        }
        out.value = LValue::null();
        out.is_lvalue = false;
        return out;
    }
}
