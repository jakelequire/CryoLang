/// New / Delete Emitter
///
/// `new T(args)` and `new T { fields }` heap-allocate via `malloc`,
/// optionally seed the vtable slot for classes with virtual methods,
/// store struct-literal field inits, then run the constructor with the
/// fresh pointer as `this`.
///
/// `delete ptr` is the manual-memory dual of an end-of-scope drop:
/// if the pointee has a Drop impl, synthesise a `ptr.drop()` method
/// call (routed through the visitor's normal method-dispatch path so
/// inherent/trait/virtual drops all reach the right symbol), then call
/// `free` on the pointer.
///
/// Holds the same back-pointer bundle as CallEmitter (cg, state,
/// dispatch, enum_variant) - both modules construct heap objects and
/// need argument-expression evaluation + enum-variant building.

namespace compiler::codegen::visit::new_delete_emitter;

import compiler::codegen;
import compiler::codegen::{ llvm_types, type_map, context, util };
import compiler::codegen::state::visitor_state;
import compiler::codegen::visit::{ expr_dispatch, enum_variant_emitter };
import compiler::compilation_context;
import compiler::decl_index;
import compiler::diag;
import compiler::diag::{ diagnostic, source_span };
import compiler::types;
import compiler::types::{
    type_ref, type_base, arena, compound, user_defined, generic, generic_registry, ownership
};
import compiler::ast;
import compiler::ast::{ node, visitor, expression, statement };
import compiler::resolver::{ symbol_str, intern_table, qualified_name, mangled_name };
import std::collections::pair;


type struct NewDeleteEmitter {
    cg:           CodegenContext*;
    state:        VisitorState*;
    dispatch:     ExprDispatch*;
    enum_variant: EnumVariantEmitter*;

    static null() -> NewDeleteEmitter {
        return NewDeleteEmitter {
            cg:           null,
            state:        null,
            dispatch:     null,
            enum_variant: null,
        };
    }

    wire(mut &this, cg: CodegenContext*, state: VisitorState*,
                    dispatch: ExprDispatch*, enum_variant: EnumVariantEmitter*) -> void {
        this.cg           = cg;
        this.state        = state;
        this.dispatch     = dispatch;
        this.enum_variant = enum_variant;
    }

    // Arena routing
    //
    // `new T(...)` whose `T` derives from `compiler::ast::node::ASTNode` is
    // routed to the AST arena (compiler::codegen::ast_arena) instead of
    // `malloc`, so the compiler's own parse trees + monomorphized clones can
    // be reclaimed in bulk at each target boundary.  The class-base chain is
    // tiny (e.g. `BinaryExprNode -> ExpressionNode -> ASTNode`) and this runs
    // once per `new` site at compile time, so the walk is negligible.  The
    // `ASTNode` qualified name is unique to the compiler's own source, so
    // routing only ever fires when the compiler compiles itself - user
    // programs that `new` their own classes are unaffected.
    derives_from_astnode(mut &this, t: Type*) -> boolean {
        if (t == null) { return false; }
        const intern: InternTable* = this.cg.get_intern();
        const astnode_sym: SymbolStr = intern.intern("compiler::ast::node::ASTNode");
        mut cur: Type* = t;
        loop {
            if (cur == null || cur.kind != TypeKind::Class) { return false; }
            const ct: ClassType* = cur as ClassType*;
            if (ct.qualified_name.equals(astnode_sym)) { return true; }
            if (!ct.has_base) { return false; }
            cur = this.cg.lookup_type_by_id(ct.base_class.id);
        }
    }


    // new T(args) / new T { fields }

    emit_new(mut &this, visitor: ASTVisitor*, node: NewExprNode*) -> void {
        // Array allocation `new T[n]` is handled up front: it allocates raw
        // memory and the element may be a primitive (`new int[100]`) whose
        // name is a keyword not in the decl index, so the type_name lookup
        // below would fail.  emit_new_array reads the element type from the
        // sema-resolved `T*` result type instead.
        if (node.has_array_size()) {
            this.emit_new_array(visitor, node);
            return;
        }

        // Resolve the type name: try current module's qualified form first,
        // then fall back to the DI's bare->qualified mapping, then the raw
        // name (for already-qualified cases and cross-module aliases).
        const ctx_ptr: CompilationContext* = this.cg.ctx;
        const intern: InternTable* = this.cg.get_intern();
        const di: DeclarationIndex* = this.cg.get_decl_index();

        mut qualified_sym: SymbolStr = ctx_ptr.qualify_symbol_sym_home(node.type_name, node.span.file);
        mut type_ref: TypeRef = di.lookup_type(qualified_sym);
        if (type_ref.is_invalid()) {
            qualified_sym = ctx_ptr.resolve_scoped_or(node.type_name, FILE, LINE);
            type_ref = di.lookup_type(qualified_sym);
        }
        if (type_ref.is_invalid()) {
            qualified_sym = node.type_name;
            type_ref = di.lookup_type(qualified_sym);
        }

        const t: Type* = this.cg.lookup_type_by_id(type_ref.id);
        if (t == null) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0635_TYPE_CONSTRUCTOR_UNDEFINED,
                format("codegen: 'new': target type '%s' not found",
                    intern.resolve(node.type_name)),
                node.span);
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        // Heap-allocated enum variant.  INCOMPLETE.
        if (t.kind == TypeKind::Enum && node.has_variant()) {
            const et: EnumType* = t as EnumType*;
            const variant: EnumVariantInfo* = et.get_variant(node.variant_name);
            if (variant == null) {
                this.cg.diag.emit_error_at_span(ErrorCode::E0635_TYPE_CONSTRUCTOR_UNDEFINED,
                    "codegen: enum variant not found in `new T::V(...)`",
                    node.span);
                this.state.last_value = LValue::null();
                this.state.last_is_lvalue = false;
                return;
            }
            mut vargs: LValue[] = [];
            for (mut i: i64 = 0; i < node.arguments.length; i++) {
                vargs.push(this.dispatch.codegen_rvalue(visitor,node.arguments[i]));
            }
            const variant_val: LValue = this.enum_variant.build(et, variant, type_ref, vargs);
            this.state.last_value = this.cg.expr_ops.heap_box_enum_variant(et, type_ref, variant_val, node.span);
            this.state.last_is_lvalue = false;
            return;
        }

        const mapped: LType = this.cg.type_mapper.map_type(type_ref);
        // Virtual dispatch through `t.size_bytes()` resolves to the base
        // `Type::size_bytes` (which returns 0) when codegen hasn't wired
        // vtable dispatch yet.  Pull `computed_size` directly from the
        // concrete type based on kind; type_lowering already accounted for
        // inheritance in that value.
        mut size: u64 = 0;
        if (t.kind == TypeKind::Class) {
            const ct: ClassType* = t as ClassType*;
            size = ct.computed_size;
        } else if (t.kind == TypeKind::Struct) {
            const st: StructType* = t as StructType*;
            size = st.computed_size;
        } else if (t.kind == TypeKind::Enum) {
            const et: EnumType* = t as EnumType*;
            size = et.computed_size;
        } else {
            size = t.size_bytes();
        }
        if (size == 0) { size = 1; }  // safe fallback; malloc(0) is UB on some platforms

        const size_val: LValue = LType::const_int(LType::i64(), size, false);

        // AST-node `new` (the compiler allocating its own parse trees) routes
        // to the process-global arena; everything else shares the canonical
        // GlobalAlloc via the shared funnel. The bitcast / vtable seed / struct
        // init / ctor call below are byte-identical regardless of storage.
        const is_ast: boolean = this.derives_from_astnode(t);
        mut align: u64 = 16;
        if (t.kind == TypeKind::Class) {
            const ct_a: ClassType* = t as ClassType*;
            if (ct_a.computed_align > 0) { align = ct_a.computed_align; }
        }
        const raw_ptr: LValue = this.cg.expr_ops.emit_raw_alloc(
            is_ast, size_val, align, "newtmp", node.span, "'new' expression");
        if (!raw_ptr.is_valid()) {
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        // Bitcast to the target struct pointer type.
        mut obj_ptr: LValue = raw_ptr;
        if (mapped.is_valid()) {
            obj_ptr = this.cg.builder.build_pointer_cast(
                raw_ptr, LType::pointer_to(mapped), "newcast");
        }

        // Store the vtable pointer at slot 0 for classes with virtual methods.
        // The vtable global is emitted by codegen_vtable_for_class in the
        // owning module's codegen pass.  When `new` is used in a different
        // module than the class declaration, the vtable global isn't yet in
        // the current LLVM module's symbol table; declare it as an extern
        // (no initializer) so the link step resolves it to the owning
        // module's definition.
        if (t.kind == TypeKind::Class) {
            const cls: ClassType* = t as ClassType*;
            if (cls.has_virtual_methods && mapped.is_valid() && obj_ptr.is_valid()) {
                const qname: QualifiedName = QualifiedName::from_symbol(qualified_sym);
                const vtbl_name: string = MangledName::for_vtable(intern, qname).resolve(intern);
                mut vtbl_global: LValue = this.cg.llvm_module.get_named_global(vtbl_name);
                if (!vtbl_global.is_valid()) {
                    // Cross-module reference: emit an extern declaration.
                    // The placeholder type doesn't have to match the
                    // definition exactly: opaque pointers mean we only
                    // store the global's address, and the linker resolves
                    // by symbol name regardless of the IR-level type.
                    const fn_ptr_ty: LType = LType::pointer_to(LType::i8());
                    const placeholder_ty: LType = LType::array_of(fn_ptr_ty, 1);
                    vtbl_global = this.cg.llvm_module.add_global(placeholder_ty, vtbl_name);
                }
                if (vtbl_global.is_valid()) {
                    const vptr_slot: LValue = this.cg.builder.build_struct_gep(
                        mapped, obj_ptr, 0, "vptr.slot");
                    if (vptr_slot.is_valid()) {
                        this.cg.builder.build_store(vtbl_global, vptr_slot);
                    }
                }
            }
        }

        // Initialize fields for `new T { fields }`. Without this the malloc'd
        // struct's fields are left uninitialized; every TypeAnnotation* the
        // parser produces would be a pointer to garbage.
        if (node.struct_init != null && t.kind == TypeKind::Struct && mapped.is_valid()) {
            const lit: StructLiteralNode* = node.struct_init;
            const st: StructType* = t as StructType*;
            for (mut sfi: i64 = 0; sfi < lit.field_inits.length; sfi++) {
                const finit: FieldInit = lit.field_inits[sfi];
                const sf_fidx: i64 = st.field_index(finit.field_name);
                if (sf_fidx >= 0) {
                    const gep: LValue = this.cg.field_gep(t, mapped, obj_ptr, sf_fidx, "field");
                    mut val: LValue = this.dispatch.codegen_rvalue(visitor,finit.value);
                    if (val.is_valid() && gep.is_valid()) {
                        // Widen/narrow integer literal to field's declared
                        // width before storing.  `new ArrayAnnotation { size: -1, ... }`
                        // arrives with `-1` as `i32 -1` but `size` is `i64`
                        // a direct `store i32` writes 4 bytes leaving the
                        // upper 4 bytes of the i64 slot uninitialised, and
                        // `is_dynamic()`'s `size < 0` check then sees a huge
                        // positive number.  Mirrors codegen_struct_literal
                        // and codegen_local_var.
                        const field_llvm_ty: void* = llvm::LLVMStructGetTypeAtIndex(mapped.raw, sf_fidx as u32);
                        const val_ty_raw: void* = llvm::LLVMTypeOf(val.raw);
                        if (field_llvm_ty != null && val_ty_raw != null
                                && LType::kind_of(field_llvm_ty) == LTypeKind::Integer
                                && LType::kind_of(val_ty_raw) == LTypeKind::Integer) {
                            const want_bits: u32 = llvm::LLVMGetIntTypeWidth(field_llvm_ty);
                            const got_bits:  u32 = llvm::LLVMGetIntTypeWidth(val_ty_raw);
                            const field_lty: LType = LType { raw: field_llvm_ty };
                            if (want_bits > got_bits) {
                                mut signed_target: boolean = false;
                                const field_t: Type* = this.cg.lookup_type_by_id(
                                    st.fields[sf_fidx].field_type.id);
                                if (field_t != null && field_t.kind == TypeKind::Int) {
                                    const ft_int: IntType* = field_t as IntType*;
                                    signed_target = ft_int.int_kind.is_signed();
                                }
                                if (signed_target) {
                                    val = this.cg.builder.build_sext(val, field_lty, "field.widen");
                                } else {
                                    val = this.cg.builder.build_zext(val, field_lty, "field.widen");
                                }
                            } else if (want_bits < got_bits) {
                                val = this.cg.builder.build_trunc(val, field_lty, "field.trunc");
                            }
                        }
                        this.cg.builder.build_store(val, gep);
                    }
                }
            }
        }

        // Call the constructor.  Cryo constructors are named like the class
        // itself (e.g. `VoidType(id: u64)` on `class VoidType`).  The DI
        // registered the method under `QualifiedClass::BareClassName`.
        const type_str: string = intern.resolve(qualified_sym);
        const bare_str: string = intern.resolve(node.type_name);
        const ctor_combined: string = format("%s::%s", type_str, bare_str);
        const ctor_sym: SymbolStr = intern.intern(ctor_combined);
        // Constructor LLVM arity = user args + 1 for the implicit `this`.
        const ctor_arity: u32 = (node.arguments.length + 1) as u32;
        mut ctor_fn: LValue = this.cg.resolver.resolve_function_with_arity(ctor_sym, ctor_arity);
        if (!ctor_fn.is_valid()) {
            ctor_fn = this.cg.resolver.resolve_function(ctor_sym);
        }
        if (ctor_fn.is_valid() && obj_ptr.is_valid()) {
            const ctor_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(ctor_fn.raw) };
            if (ctor_ty.is_valid() && LType::kind_of(ctor_ty.raw) == LTypeKind::Function) {
                // Same single-element-literal bug applies here; use push.
                mut ctor_args: Pair<LValue, TypeRef>[] = [];
                ctor_args.push(Pair<LValue, TypeRef>::new(obj_ptr, node.resolved_type));
                for (mut i: i64 = 0; i < node.arguments.length; i++) {
                    const arg_val: LValue = this.dispatch.codegen_rvalue(visitor,node.arguments[i]);
                    ctor_args.push(Pair<LValue, TypeRef>::new(arg_val, node.arguments[i].resolved_type));
                }
                mut ctor_result: LValue = LValue::null();
                ctor_result = this.cg.expr_ops.codegen_call(ctor_fn, ctor_ty, ctor_args, "");
            }
        }

        this.state.last_value = obj_ptr;
        this.state.last_is_lvalue = false;
    }

    // new T[n]  - raw array allocation

    /// Lower `new T[n]` to `malloc(n * sizeof(T))` cast to `T*`.  The memory
    /// is left uninitialized - no constructors run - matching the doc's
    /// `const arr: int* = new int[100]` example and the low-level framing of
    /// section 15.2 (use `Array<T>` when you want constructed/managed elements).
    /// The element type is read from the sema-resolved `T*` result type so
    /// primitive elements (whose name is a keyword, not a decl-index entry)
    /// resolve the same way user types do.
    emit_new_array(mut &this, visitor: ASTVisitor*, node: NewExprNode*) -> void {
        const result_t: Type* = this.cg.lookup_type_by_id(node.resolved_type.id);
        if (result_t == null || result_t.kind != TypeKind::Pointer) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0635_TYPE_CONSTRUCTOR_UNDEFINED,
                "codegen: 'new T[n]': could not resolve element type",
                node.span);
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }
        const elem_ref: TypeRef = (result_t as PointerType*).pointee;
        const elem_t: Type* = this.cg.lookup_type_by_id(elem_ref.id);
        const elem_llvm: LType = this.cg.type_mapper.map_type(elem_ref);

        // Element byte size (same kind-derivation as emit_new: virtual
        // size_bytes() returns 0 for aggregates, so read computed_size).
        mut elem_size: u64 = 0;
        if (elem_t != null) {
            if (elem_t.kind == TypeKind::Class) {
                elem_size = (elem_t as ClassType*).computed_size;
            } else if (elem_t.kind == TypeKind::Struct) {
                elem_size = (elem_t as StructType*).computed_size;
            } else if (elem_t.kind == TypeKind::Enum) {
                elem_size = (elem_t as EnumType*).computed_size;
            } else {
                elem_size = elem_t.size_bytes();
            }
        }
        if (elem_size == 0) { elem_size = 1; }

        // Element count expression -> i64.
        mut count_val: LValue = this.dispatch.codegen_rvalue(visitor, node.array_size);
        if (!count_val.is_valid()) {
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }
        count_val = this.widen_to_i64(count_val);

        // Abort before the multiply wraps: `count * elem_size` overflowing
        // u64 would malloc a too-small block and the element writes would
        // run off the heap. (Same guard class as `Layout::array`.)
        this.cg.expr_ops.emit_array_mul_guard(count_val, elem_size,
            visitor, &node.unwind_cleanup, node.span);

        const elem_size_val: LValue = LType::const_int(LType::i64(), elem_size, false);
        const total: LValue = this.cg.builder.build_mul(
            count_val, elem_size_val, "new.arr.bytes");

        // AST-node element blocks route to the arena (parity with emit_new;
        // AST collections are dynamic `T[]`, not `new T[n]`, so this is
        // expected never to fire). Array allocations use a fixed 16 alignment.
        const is_ast: boolean = this.derives_from_astnode(elem_t);
        const raw_ptr: LValue = this.cg.expr_ops.emit_raw_alloc(
            is_ast, total, 16, "new.arr", node.span, "'new T[n]'");
        if (!raw_ptr.is_valid()) {
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        mut elem_ptr: LValue = raw_ptr;
        if (elem_llvm.is_valid()) {
            elem_ptr = this.cg.builder.build_pointer_cast(
                raw_ptr, LType::pointer_to(elem_llvm), "new.arr.cast");
        }
        this.state.last_value = elem_ptr;
        this.state.last_is_lvalue = false;
    }

    /// Widen an integer value to i64 for use as a malloc byte count.  Array
    /// element counts are non-negative, so a narrower value is zero-extended;
    /// an i64 passes through; a wider value is truncated (defensive).
    widen_to_i64(mut &this, v: LValue) -> LValue {
        const raw_ty: void* = llvm::LLVMTypeOf(v.raw);
        if (LType::kind_of(raw_ty) != LTypeKind::Integer) { return v; }
        const bits: u32 = llvm::LLVMGetIntTypeWidth(raw_ty);
        if (bits == 64) { return v; }
        if (bits > 64)  { return this.cg.builder.build_trunc(v, LType::i64(), "new.arr.cnt"); }
        return this.cg.builder.build_zext(v, LType::i64(), "new.arr.cnt");
    }

    // delete ptr

    emit_delete(mut &this, visitor: ASTVisitor*, node: DeleteExprNode*) -> void {
        // `delete ptr` is the manual-memory dual of an end-of-scope drop:
        //   1. Run the pointee's drop method, if it has one.
        //   2. Free the allocation.
        // The operand is evaluated exactly once (see below): the pointer
        // is spilled to a temp slot, the drop is synthesized as a
        // `.drop()` on a synthetic local reading that slot - routed
        // through the normal method-dispatch path so trait `Drop` impls,
        // inherent `drop`, and virtual class destructors all reach the
        // right symbol - and the same spilled pointer is freed.  This
        // makes side-effecting operands (`delete arr.pop()`) safe: the
        // side effects fire once and the destructor and `free` see the
        // identical pointer.
        const operand_type: TypeRef = node.operand.resolved_type;
        const arena_ptr: TypeArena* = this.cg.get_arena();
        const intern_ptr: InternTable* = this.cg.get_intern();
        const registry_ptr: GenericRegistry* = this.cg.ctx.generic_registry;

        mut pointee: TypeRef = TypeRef::invalid();
        if (operand_type.is_valid() && arena_ptr != null) {
            const ot: Type* = arena_ptr.lookup(operand_type.id);
            if (ot != null && ot.kind == TypeKind::Pointer) {
                const pt: PointerType* = ot as PointerType*;
                pointee = pt.pointee;
            }
        }

        // Arena node: storage came from the AST arena (bulk-reclaimed at the
        // target boundary), so neither free() nor a synthesized drop() is valid
        // here -- free() on arena memory would corrupt the heap.  Evaluate the
        // operand once for its side effects, then no-op, exactly preserving
        // today's behavior (AST nodes are never individually freed).  There are
        // no `delete` sites on AST nodes in-tree today; this guard is defensive.
        if (pointee.is_valid() && arena_ptr != null) {
            const pointee_t: Type* = arena_ptr.lookup(pointee.id);
            if (this.derives_from_astnode(pointee_t)) {
                const _p: LValue = this.dispatch.codegen_rvalue(visitor, node.operand);
                this.state.last_value = LValue::null();
                this.state.last_is_lvalue = false;
                return;
            }
        }

        mut should_drop: boolean = false;
        if (pointee.is_valid() && arena_ptr != null && registry_ptr != null
                && intern_ptr != null) {
            should_drop =
                OwnershipQuery::has_inherent_drop(arena_ptr, registry_ptr,
                                                    intern_ptr, pointee)
                || OwnershipQuery::type_implements_drop(arena_ptr, registry_ptr,
                                                        intern_ptr, pointee);
        }

        // Evaluate the operand exactly once.  A side-effecting operand
        // (`delete arr.pop()`) must not fire its side effects twice, and
        // the destructor must run on the *same* pointer that is freed - a
        // second evaluation can yield a different pointer (UAF /
        // double-free).  Spill the evaluated pointer to a temp slot and
        // drive both the synthesized `.drop()` and the `free` off it.
        const ptr: LValue = this.dispatch.codegen_rvalue(visitor, node.operand);
        if (!ptr.is_valid()) {
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        if (should_drop) {
            // Bind the already-evaluated pointer to a synthetic local so
            // the drop dispatch (which re-codegens its receiver node) reads
            // the spilled value instead of re-evaluating `node.operand`.
            // The slot mirrors a real `T*` local - it holds the pointer
            // value - so the receiver auto-deref in method dispatch behaves
            // identically to a direct `node.operand.drop()`.
            const slot_ty: LType = LType::pointer_to(LType::i8());
            // Hoisted to the entry block: `delete` in a loop body would
            // otherwise leave one spill slot behind per iteration.  The slot
            // holds only the pointer for the span of the synthesized `.drop()`
            // below, and the store precedes that read on every iteration.
            const slot: LValue = this.cg.flow.temp_slot(slot_ty, "delete.recv");
            this.cg.builder.build_store(ptr, slot);
            const recv_sym: SymbolStr = intern_ptr.intern("$delete.recv");
            this.cg.values.set_raw(recv_sym.id, slot.raw);

            const drop_sym: SymbolStr = intern_ptr.intern("drop");
            mut recv: IdentifierNode* = new IdentifierNode(recv_sym, node.span);
            recv.set_resolved_type(node.operand.resolved_type);
            mut member: MemberAccessNode* = new MemberAccessNode(
                recv as ExpressionNode*, drop_sym, node.span, node.span);
            member.set_resolved_type(TypeRef::invalid());
            mut call: CallExprNode* = new CallExprNode(
                member as ExpressionNode*, node.span);
            mut stmt: ExprStmtNode* = new ExprStmtNode(
                call as ExpressionNode*, node.span);
            stmt.accept(visitor);

            this.cg.values.remove_raw(recv_sym.id);
        }

        // Free through the canonical `GlobalAlloc` (via `free`):
        // a `delete` of an object that was arena-allocated (the compiler
        // building itself) must NOT reach libc `free` - `GlobalAlloc::
        // deallocate` no-ops arena-owned pointers (bulk-reclaimed at the
        // target boundary) and frees libc-owned ones.  Falls back to a direct
        // `free` when the stdlib is not linked (e.g. `--no-std`).  The shim
        // takes the pointee alignment so the dealloc pairs with the `new`
        // site on platforms where free is alignment-sensitive (Windows
        // `_aligned_free`); the computation mirrors `emit_new`.
        mut del_align: u64 = 16;
        if (pointee.is_valid() && arena_ptr != null) {
            const del_pt: Type* = arena_ptr.lookup(pointee.id);
            if (del_pt != null && del_pt.kind == TypeKind::Class) {
                const del_cpt: ClassType* = del_pt as ClassType*;
                if (del_cpt.computed_align > 0) { del_align = del_cpt.computed_align; }
            }
        }
        this.cg.expr_ops.emit_raw_dealloc(ptr, del_align, node.span);
        this.state.last_value = LValue::null();
        this.state.last_is_lvalue = false;
    }
}
