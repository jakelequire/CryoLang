/// Codegen Visit Modules
///
/// IR-side visitor sub-emitters held by `IRGeneratorVisitor`.  Each
/// one handles a coherent slice of the visit() dispatch
/// (expressions, patterns, lambdas, calls, ...) and is wired via
/// `IRGeneratorVisitor::wire()` once the visitor is at a stable
/// heap address.
///
/// `ExprDispatch` is the foundation: the visitor's own
/// `codegen_rvalue` / `codegen_lvalue` / `generate_block` helpers
/// live here so the other sub-emitters can recurse into AST
/// expressions through `dispatch.codegen_rvalue(visitor, expr)`
/// without importing the concrete `IRGeneratorVisitor` type.

namespace Compiler::Codegen::Visit;

public module ExprDispatch;
public module PatternEmitter;
public module LambdaEmitter;
public module ArrayLitEmitter;
public module EnumVariantEmitter;
public module CallEmitter;
public module NewDeleteEmitter;
public module BinaryUnaryEmitter;
public module PlaceEmitter;
public module DeclVisitEmitter;
public module IRGenerator;
