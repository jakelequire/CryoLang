/// Pattern Emitter
///
/// Match-arm / pattern lowering: enum-subject normalisation, payload
/// binding, per-arm comparison chain emission, and pattern-value
/// lowering (literal, identifier, enum-tag).  Shared by the `match`
/// statement (`visit(MatchStmtNode*)`) and the `match` expression
/// (`visit(MatchExprNode*)`); both pass through `prepare_match_subject`
/// + `emit_match_arm_comparison` + `bind_arm_enum_payloads`.
///
/// Held by IRGeneratorVisitor (not by CodegenContext), so this module
/// can safely import `compiler::codegen::context` and hold the context
/// pointer directly - no module-graph cycle with `context.cryo`.

namespace compiler::codegen::visit::pattern_emitter;

import compiler::codegen;
import compiler::codegen::{ llvm_types, context, util };
import compiler::types;
import compiler::types::{ type_ref, type_base, compound, user_defined, generic, arena };
import compiler::ast;
import compiler::ast::{ node, pattern };
import compiler::lex;
import compiler::resolver::{ symbol_str, intern_table };


// MatchSubjectInfo: precomputed state for match/if-let pattern codegen.
// Public because callers (visit(MatchStmtNode*), visit(MatchExprNode*))
// receive it from prepare_match_subject and pass it back into the rest
// of the emitter API.

type struct MatchSubjectInfo {
    enum_type:   EnumType*;
    enum_ref:    TypeRef;
    enum_llvm:   LType;
    subject_ptr: LValue;    // ptr to the enum (alloca'd if subject was a value)
    tag_val:     LValue;    // i32 discriminant extracted from subject
    subject_ty:  TypeRef;   // Cryo type of the match subject (pre-unwrap);
                            // drives integer-pattern width + signedness
}


type struct PatternEmitter {
    // Back-pointer set by wire().  Null until wire() runs.
    cg: CodegenContext*;

    /// Stage 1 of two-phase init.  Produces a PatternEmitter with a null
    /// back-pointer; the parent IRGeneratorVisitor calls `wire()` after it
    /// is at its stable (heap) address.
    static null() -> PatternEmitter {
        return PatternEmitter { cg: null };
    }

    /// Stage 2: store the context back-pointer.  Must be called from
    /// `IRGeneratorVisitor::wire()` after the visitor is `Box::leak()`'d.
    wire(mut &this, cg: CodegenContext*) -> void {
        this.cg = cg;
    }


    // Subject preparation

    /// Prepare a match subject: resolve its enum type (if any), normalize to
    /// a ptr (for payload extraction), and pre-extract the i32 tag value.
    prepare_match_subject(mut &this, subject: LValue, subj_ref: TypeRef,
                          subject_addr: LValue, current_fn: LValue) -> MatchSubjectInfo {
        mut info: MatchSubjectInfo = MatchSubjectInfo {
            enum_type:   null,
            enum_ref:    subj_ref,
            enum_llvm:   LType::null(),
            subject_ptr: subject,
            tag_val:     LValue::null(),
            subject_ty:  subj_ref,
        };

        // Unwrap Reference/Pointer/InstantiatedType to find the enum type.
        mut unwrap_ref: TypeRef = subj_ref;
        mut t: Type* = this.cg.lookup_type_by_id(unwrap_ref.id);
        mut depth: i32 = 0;
        while (t != null && depth < 8) {
            if (t.kind == TypeKind::Pointer) {
                const pt: PointerType* = t as PointerType*;
                unwrap_ref = pt.pointee;
                t = this.cg.lookup_type_by_id(unwrap_ref.id);
            } else if (t.kind == TypeKind::Reference) {
                const rt: ReferenceType* = t as ReferenceType*;
                unwrap_ref = rt.referent;
                t = this.cg.lookup_type_by_id(unwrap_ref.id);
            } else if (t.kind == TypeKind::InstantiatedType) {
                const it: InstantiatedType* = t as InstantiatedType*;
                if (it.has_resolved_type()) {
                    unwrap_ref = it.resolved_type;
                    t = this.cg.lookup_type_by_id(unwrap_ref.id);
                } else { break; }
            } else {
                break;
            }
            depth += 1;
        }

        if (t == null || t.kind != TypeKind::Enum) {
            return info;
        }

        info.enum_type = t as EnumType*;
        info.enum_ref  = unwrap_ref;
        info.enum_llvm = this.cg.type_mapper.map_type(unwrap_ref);
        if (!info.enum_llvm.is_valid()) {
            return info;
        }

        // LLVMPointerTypeKind = 12.
        mut is_ptr: boolean = false;
        const subj_llvm_ty: void* = llvm::LLVMTypeOf(subject.raw);
        if (subj_llvm_ty != null && LType::kind_of(subj_llvm_ty) == LTypeKind::Pointer) {
            is_ptr = true;
        }

        if (info.enum_type.is_simple_enum()) {
            // Simple enum: the value IS the tag.  No alloca needed; we either
            // use the subject directly or load it through the ptr - at the
            // enum's discriminant width (`type enum E : i64` -> i64, else i32).
            if (is_ptr) {
                const tag_ty: LType = this.cg.type_mapper.enum_tag_ltype(info.enum_type);
                info.tag_val = this.cg.builder.build_load(
                    tag_ty, subject, "enum.tag");
            } else {
                info.tag_val = subject;
            }
            info.subject_ptr = subject;
            return info;
        }

        // ADT enum: we need a ptr to do struct GEP for tag and payload.
        // Only alloca when the subject is a raw struct value.
        if (is_ptr) {
            info.subject_ptr = subject;
        } else if (subject_addr.is_valid()) {
            // The subject is an addressable owning slot (an Identifier local,
            // possibly hoisted here by DropInsertion). Match in place against
            // that real storage instead of a throwaway `match.subj` copy, so an
            // arm's `mut` payload binding and the subject's scope-exit drop
            // reference ONE slot. Otherwise a binding that reallocs its buffer
            // mid-arm (e.g. `String::as_cstr`) updates only the copy, leaving
            // the drop to free the original's stale pointer (double free).
            info.subject_ptr = subject_addr;
        } else {
            // The scratch copy's slot is hoisted to the entry block, while the
            // store below stays here, where the subject value is live. A `match`
            // reached from inside a loop would otherwise allocate a fresh slot on
            // every iteration and never reclaim it — the stack grows without
            // bound until it overflows, which is a crash rather than a slowdown.
            // Reusing one slot across iterations is safe because the store
            // precedes every read of it within an iteration.
            if (current_fn.is_valid()) {
                info.subject_ptr = this.cg.flow.create_entry_alloca(
                    current_fn, "match.subj", info.enum_llvm);
            } else {
                // No enclosing function to hoist into — extremely unusual; a
                // local alloca still lowers correctly, it just cannot be hoisted.
                info.subject_ptr = this.cg.builder.build_alloca(info.enum_llvm, "match.subj");
            }
            if (info.subject_ptr.is_valid()) {
                this.cg.builder.build_store(subject, info.subject_ptr);
            }
        }

        if (info.subject_ptr.is_valid()) {
            const tag_ptr: LValue = this.cg.builder.build_struct_gep(
                info.enum_llvm, info.subject_ptr, 0, "enum.tag.ptr");
            if (tag_ptr.is_valid()) {
                info.tag_val = this.cg.builder.build_load(
                    LType::i32(), tag_ptr, "enum.tag");
            }
        }

        return info;
    }


    // Arm payload binding

    /// Extract enum variant payload bindings into named values in the current scope.
    /// No-op unless the arm's pattern is an enum pattern with bindings.
    ///
    /// Registers each binding as a pointer to its payload slot.  `codegen_identifier`
    /// treats named values as lvalues, so `codegen_rvalue` loads through the ptr.
    /// Pointing at the payload inside the subject needs no storage of its own,
    /// so an arm binding costs no stack slot however many times it is reached.
    bind_arm_enum_payloads(mut &this, arm: MatchArmNode*, minfo: MatchSubjectInfo) -> void {
        if (minfo.enum_type == null || !minfo.subject_ptr.is_valid()) { return; }
        if (!minfo.enum_llvm.is_valid()) { return; }

        for (mut p: i64 = 0; p < arm.patterns.length; p++) {
            const pat: PatternNode* = arm.patterns[p];
            if (pat == null || pat.pattern_kind != PatternKind::Enum) { continue; }

            const epat: EnumPatternNode* = pat as EnumPatternNode*;
            if (!epat.has_bindings()) { continue; }

            this.bind_enum_payloads_rec(epat, minfo.enum_type, minfo.enum_llvm,
                                        minfo.subject_ptr);

            // Only bind for the first enum pattern in this arm (multi-pattern
            // arms with different variants can't share bindings anyway).
            return;
        }
    }

    /// Byte offset of each payload field of `variant`.  Delegates to the
    /// single layout authority (TypeArena::variant_payload_layout) shared
    /// with construction, drop glue, map_enum, and compute_enum_layout, so
    /// pattern binds can never diverge from where the fields were stored.
    payload_field_offsets(mut &this, variant: EnumVariantInfo*) -> u64[] {
        const arena: TypeArena* = this.cg.get_arena();
        return arena.variant_payload_layout(variant, null, null);
    }

    /// Pointer to payload field `pos` of an ADT enum at `subject_ptr`
    /// (LLVM type `enum_llvm`), bitcast to `field_llvm*`. Null on failure.
    payload_field_ptr(mut &this, enum_llvm: LType, subject_ptr: LValue,
                      offsets: &u64[], pos: i64, field_llvm: LType) -> LValue {
        const payload_ptr: LValue = this.cg.builder.build_struct_gep(
            enum_llvm, subject_ptr, 1, "enum.payload.ptr");
        if (!payload_ptr.is_valid()) { return LValue::null(); }
        mut field_ptr_raw: LValue = payload_ptr;
        if (offsets[pos] != 0) {
            const byte_off: LValue = LType::const_int(LType::i64(), offsets[pos], false);
            const obuf: void* = intrinsics::malloc(8);
            const obuf_arr: void** = obuf as void**;
            obuf_arr[0] = byte_off.raw;
            field_ptr_raw = this.cg.builder.build_gep(
                LType::i8(), payload_ptr, obuf, 1, "enum.field.ptr");
            intrinsics::free(obuf);
        }
        return this.cg.builder.build_bitcast(
            field_ptr_raw, LType::pointer_to(field_llvm), "enum.field.cast");
    }

    /// Unwrap a payload TypeRef to its concrete `EnumType*`, or null when it
    /// is not an enum. Follows InstantiatedType to its resolved spec.
    payload_enum_type(mut &this, ty: TypeRef) -> EnumType* {
        mut t: Type* = this.cg.lookup_type_by_id(ty.id);
        if (t != null && t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (inst.has_resolved_type()) {
                t = this.cg.lookup_type_by_id(inst.resolved_type.id);
            }
        }
        if (t != null && t.kind == TypeKind::Enum) { return t as EnumType*; }
        return null;
    }

    /// Recursively bind an enum pattern's payload elements to named lvalues,
    /// descending through nested sub-patterns (`Some(Some(n))`). `subject_ptr`
    /// points to a value of `enum_type` (LLVM type `enum_llvm`). Reads through
    /// each registered binding load via `codegen_rvalue` using the binding's
    /// resolved_type.
    bind_enum_payloads_rec(mut &this, epat: EnumPatternNode*, enum_type: EnumType*,
                           enum_llvm: LType, subject_ptr: LValue) -> void {
        if (enum_type == null || !subject_ptr.is_valid() || !enum_llvm.is_valid()) {
            return;
        }
        const variant: EnumVariantInfo* = enum_type.get_variant(epat.variant_name);
        if (variant == null || !variant.has_payload()) { return; }
        if (enum_type.is_simple_enum()) { return; }

        const num_payload: i64 = variant.payload_types.length;
        const offsets: u64[] = this.payload_field_offsets(variant);

        for (mut pos: i64 = 0; pos < epat.elements.length; pos++) {
            if (pos >= num_payload) { continue; }
            const pb: PatternBinding* = epat.binding_at(pos);
            const sub: PatternNode* = epat.sub_at(pos);
            if (pb == null && sub == null) { continue; }

            const field_ref: TypeRef = variant.payload_types[pos];
            const field_llvm: LType = this.cg.type_mapper.map_type(field_ref);
            if (!field_llvm.is_valid()) { continue; }
            if (LType::kind_of(field_llvm.raw) == LTypeKind::Void) { continue; }

            const field_ptr: LValue = this.payload_field_ptr(
                enum_llvm, subject_ptr, &offsets, pos, field_llvm);
            if (!field_ptr.is_valid()) { continue; }

            if (pb != null) {
                this.cg.values.set(pb.name, field_ptr);
            } else if (sub != null && sub.pattern_kind == PatternKind::Enum) {
                // Nested enum sub-pattern: recurse using the payload field as
                // the new subject pointer and its concrete enum type.
                const nested_ty: EnumType* = this.payload_enum_type(field_ref);
                if (nested_ty != null) {
                    this.bind_enum_payloads_rec(sub as EnumPatternNode*, nested_ty,
                                                field_llvm, field_ptr);
                }
            }
        }
    }

    /// Materialize a top-level bare-identifier binding (`x => ...` /
    /// `x if (cond) => ...`), which binds the whole subject to a name. The
    /// binding is registered as a pointer-to-storage so `codegen_rvalue`
    /// loads through it like any local. `minfo.subject_ptr` is already a
    /// pointer for ADT enums (and reference/pointer subjects); for a scalar
    /// or simple-enum subject it is the SSA value, so we spill it to a fresh
    /// alloca first. Called in both the arm body and the guard block so each
    /// sees the binding. No-op for wildcard / enum / literal patterns.
    bind_arm_value_bindings(mut &this, arm: MatchArmNode*,
                            minfo: MatchSubjectInfo) -> void {
        for (mut p: i64 = 0; p < arm.patterns.length; p++) {
            const pat: PatternNode* = arm.patterns[p];
            if (pat == null || pat.pattern_kind != PatternKind::Identifier) {
                continue;
            }
            if (!pat.binding_name.is_valid()) { continue; }
            if (!minfo.subject_ptr.is_valid()) { continue; }

            // Already an addressable slot (e.g. an ADT enum's alloca/ptr): bind
            // directly. Otherwise spill the value into a fresh slot of the
            // subject's type.
            mut slot: LValue = minfo.subject_ptr;
            const sp_ty: void* = llvm::LLVMTypeOf(minfo.subject_ptr.raw);
            const is_ptr: boolean = sp_ty != null
                && LType::kind_of(sp_ty) == LTypeKind::Pointer;
            if (!is_ptr) {
                const vty: LType = this.cg.type_mapper.map_type(minfo.subject_ty);
                if (!vty.is_valid()) { continue; }
                // Hoisted like `match.subj` above: a `match` in a loop body
                // would otherwise spill the subject into a fresh slot every
                // iteration and reclaim none of them.  One slot serves every
                // iteration because the store below precedes every read of the
                // binding within the arm that reads it.
                slot = this.cg.flow.temp_slot(vty, "match.bind");
                if (!slot.is_valid()) { continue; }
                this.cg.builder.build_store(minfo.subject_ptr, slot);
            }
            this.cg.values.set(pat.binding_name, slot);
            return;
        }
    }


    // Per-arm comparison chain

    /// Emit the comparison chain for one match arm into the current block.
    /// Handles OR-patterns (`a | b | c => ...`): every pattern is tested in
    /// turn, each branching to `arm_bb` on a hit; a miss falls through to the
    /// next pattern's test, and the final miss falls through to `next_bb`.
    /// A wildcard pattern branches unconditionally (later OR alternatives are
    /// dead).  `name_prefix` namespaces the synthesised intermediate blocks
    /// ("match" for statement matches, "mexpr" for expression matches).
    ///
    /// Shared by `visit(MatchStmtNode*)` and `visit(MatchExprNode*)`: the
    /// per-pattern lowering is identical between them; only the block-name
    /// prefix differs.  On return the builder is positioned at whichever
    /// block emitted the last test (always terminated); the caller is free to
    /// reposition to `next_bb` for the following arm.
    emit_match_arm_comparison(mut &this, arm: MatchArmNode*,
            arm_bb: LBasicBlock, next_bb: LBasicBlock,
            minfo: MatchSubjectInfo, is_string_subj: boolean,
            subject: LValue, current_fn: LValue,
            name_prefix: string) -> void {
        const npat: i64 = arm.patterns.length;
        for (mut p: i64 = 0; p < npat; p++) {
            const pat: PatternNode* = arm.patterns[p];
            if (pat == null) { continue; }

            // Where control goes if THIS pattern doesn't match: the next
            // pattern's test for an OR-arm, otherwise the next arm's test
            // (`next_bb`).  Each non-final OR alternative gets its own block
            // so a miss on `a` still reaches the test for `b` in `a | b`.
            const is_last: boolean = (p + 1 >= npat);
            mut miss_bb: LBasicBlock = next_bb;
            if (!is_last) {
                miss_bb = LBasicBlock::append(current_fn,
                    format("%s.or", name_prefix));
            }

            if (pat.pattern_kind == PatternKind::Wildcard
                || (pat.pattern_kind == PatternKind::Identifier
                    && pat.binding_name.is_valid())) {
                // Wildcard and bare-identifier bindings match unconditionally
                // (an identifier binds the whole subject, like `_` but named);
                // branch straight to the arm body. Any later OR alternatives
                // are unreachable. The binding itself is materialized by
                // `bind_arm_value_bindings` in the arm/guard block. An
                // Identifier whose `binding_name` was cleared by the resolver is
                // a constant-value pattern, not a binding, and falls through to
                // the comparison below.
                this.cg.builder.build_br(arm_bb);
                return;
            }

            mut cmp: LValue = LValue::null();
            // Set when the pattern emits its own complete test (terminating the
            // block via its own branches), so the generic cond_br below is
            // skipped. Used by enum patterns with payload tests (literal
            // payloads / nested sub-patterns).
            mut handled: boolean = false;
            if (pat.pattern_kind == PatternKind::Literal) {
                // For string subjects, build the pattern as a global string
                // pointer and compare via strcmp; `codegen_pattern_value`
                // lowers every literal to an i32 and would compare pointer
                // bits, not content.
                if (is_string_subj) {
                    const pat_text: string = this.cg.resolve(pat.value);
                    const pat_val: LValue =
                        this.cg.str_cache.get_or_create(pat_text, &this.cg.llvm_module);
                    cmp = this.cg.expr_ops.codegen_string_compare(subject, pat_val,
                        TokenType::EqualEqual);
                } else {
                    const pat_val: LValue =
                        this.codegen_pattern_value(pat, minfo.subject_ty);
                    if (pat_val.is_valid()) {
                        const pat_val_coerced: LValue =
                            this.cg.expr_ops.coerce_icmp_operands(subject, pat_val,
                                                 minfo.subject_ty);
                        cmp = this.cg.builder.build_icmp(LIntPredicate::EQ,
                            subject, pat_val_coerced,
                            format("%s.cmp", name_prefix));
                    }
                }
            } else if (pat.pattern_kind == PatternKind::Identifier) {
                // Constant-value pattern: the resolver cleared `binding_name`
                // because the identifier names a `const`. Compare the subject
                // against the constant's loaded value, like a literal arm.
                const pat_val: LValue =
                    this.codegen_pattern_value(pat, minfo.subject_ty);
                if (pat_val.is_valid()) {
                    const coerced: LValue =
                        this.cg.expr_ops.coerce_icmp_operands(subject, pat_val,
                                             minfo.subject_ty);
                    cmp = this.cg.builder.build_icmp(LIntPredicate::EQ,
                        subject, coerced, format("%s.cmp", name_prefix));
                }
            } else if (pat.pattern_kind == PatternKind::Range) {
                // Inclusive `lo..hi` range: `lo <= subject && subject <= hi`.
                // String subjects can't form a range (sema rejects them), so
                // this always operates on the integer/char subject directly.
                cmp = this.codegen_range_compare(pat, minfo.subject_ty,
                                                 subject, name_prefix);
            } else if (pat.pattern_kind == PatternKind::Enum) {
                const epat: EnumPatternNode* = pat as EnumPatternNode*;
                if (minfo.enum_type != null
                        && this.enum_pattern_needs_payload_test(epat)) {
                    // Payload literals (`Some(5)`) or nested sub-patterns
                    // (`Some(Some(n))`) need value/tag checks beyond the outer
                    // tag. Emit the full recursive test, which terminates the
                    // block by branching to arm_bb (full match) / miss_bb.
                    this.emit_enum_pattern_test(epat, minfo.enum_type,
                        minfo.enum_llvm, minfo.subject_ptr, arm_bb, miss_bb,
                        current_fn, name_prefix);
                    handled = true;
                } else if (minfo.enum_type != null && minfo.tag_val.is_valid()) {
                    // Tag-only check (bindings/wildcards in payload need no test).
                    const variant: EnumVariantInfo* =
                        minfo.enum_type.get_variant(epat.variant_name);
                    if (variant != null) {
                        // Match the comparison constant to the tag's width
                        // (discriminant base for simple enums, else i32) so a
                        // non-i32 simple enum's icmp operands agree.
                        const tag_ty: LType = this.cg.type_mapper.enum_tag_ltype(minfo.enum_type);
                        const pat_val: LValue = LType::const_int(
                            tag_ty, variant.tag_value, false);
                        cmp = this.cg.builder.build_icmp(LIntPredicate::EQ,
                            minfo.tag_val, pat_val,
                            format("%s.cmp", name_prefix));
                    }
                }
            }

            if (handled) {
                // The pattern emitted its own terminating branches.
            } else if (cmp.is_valid()) {
                this.cg.builder.build_cond_br(cmp, arm_bb, miss_bb);
            } else {
                // Pattern produced no comparison (a codegen gap); treat it
                // as an unconditional miss so control still reaches the rest
                // of the chain rather than leaving the block unterminated.
                const cur: LBasicBlock = this.cg.builder.get_insert_block();
                if (cur.is_valid() && !cur.has_terminator()) {
                    this.cg.builder.build_br(miss_bb);
                }
            }

            if (!is_last) {
                this.cg.builder.position_at_end(miss_bb);
            }
        }

        // No pattern terminated the current block (empty / all-null pattern
        // list, or a trailing pattern that produced no comparison); fall
        // through to the next arm so the IR stays well-formed.
        const tail: LBasicBlock = this.cg.builder.get_insert_block();
        if (tail.is_valid() && !tail.has_terminator()) {
            this.cg.builder.build_br(next_bb);
        }
    }

    /// True when an enum pattern's payload requires a value/tag check beyond
    /// the outer variant tag: a literal payload (`Some(5)`) or a nested
    /// sub-pattern (`Some(Some(n))`). Bindings and wildcards need no test.
    enum_pattern_needs_payload_test(mut &this, epat: EnumPatternNode*) -> boolean {
        for (mut i: i64 = 0; i < epat.elements.length; i++) {
            const need: boolean = match (epat.elements[i]) {
                PatternElement::LiteralInt(_)    => { true }
                PatternElement::LiteralFloat(_)  => { true }
                PatternElement::Sub(_)           => { true }
                _                                => { false }
            };
            if (need) { return true; }
        }
        return false;
    }

    /// Emit the full match test for an enum pattern against a value of
    /// `enum_type` (LLVM type `enum_llvm`) at `subject_ptr`: check the variant
    /// tag, then each literal-payload value and nested sub-pattern. On a full
    /// match branch to `match_bb`; on any mismatch branch to `miss_bb`.
    /// Recurses for nested enum sub-patterns, so `Some(Some(5))` checks all
    /// levels. Only invoked for ADT enums (those with payloads), so
    /// `subject_ptr` is a real pointer.
    emit_enum_pattern_test(mut &this, epat: EnumPatternNode*, enum_type: EnumType*,
                           enum_llvm: LType, subject_ptr: LValue,
                           match_bb: LBasicBlock, miss_bb: LBasicBlock,
                           current_fn: LValue, name_prefix: string) -> void {
        const variant: EnumVariantInfo* = enum_type.get_variant(epat.variant_name);
        if (variant == null || !subject_ptr.is_valid() || !enum_llvm.is_valid()) {
            this.cg.builder.build_br(miss_bb);
            return;
        }

        // Load the discriminant: a simple enum's value IS the tag; an ADT
        // enum keeps it in struct field 0.
        const tag_ty: LType = this.cg.type_mapper.enum_tag_ltype(enum_type);
        mut tag: LValue = LValue::null();
        if (enum_type.is_simple_enum()) {
            tag = this.cg.builder.build_load(tag_ty, subject_ptr, "enum.tag");
        } else {
            const tag_ptr: LValue = this.cg.builder.build_struct_gep(
                enum_llvm, subject_ptr, 0, "enum.tag.ptr");
            if (!tag_ptr.is_valid()) { this.cg.builder.build_br(miss_bb); return; }
            tag = this.cg.builder.build_load(tag_ty, tag_ptr, "enum.tag");
        }
        const tag_const: LValue = LType::const_int(tag_ty, variant.tag_value, false);
        const tagcmp: LValue = this.cg.builder.build_icmp(LIntPredicate::EQ,
            tag, tag_const, format("%s.tag", name_prefix));

        // Collect payload positions that need a check (literal value / sub).
        const num_payload: i64 = variant.payload_types.length;
        mut checks: i64[] = [];
        for (mut pos: i64 = 0; pos < epat.elements.length; pos++) {
            if (pos >= num_payload) { continue; }
            const needs: boolean = match (epat.elements[pos]) {
                PatternElement::LiteralInt(_)   => { true }
                PatternElement::LiteralFloat(_) => { true }
                PatternElement::Sub(_)          => { true }
                _                               => { false }
            };
            if (needs) { checks.push(pos); }
        }

        if (checks.length == 0) {
            this.cg.builder.build_cond_br(tagcmp, match_bb, miss_bb);
            return;
        }

        // Tag must match before inspecting the payload.
        const tagok: LBasicBlock = LBasicBlock::append(current_fn,
            format("%s.tagok", name_prefix));
        this.cg.builder.build_cond_br(tagcmp, tagok, miss_bb);
        this.cg.builder.position_at_end(tagok);

        const offsets: u64[] = this.payload_field_offsets(variant);
        for (mut ci: i64 = 0; ci < checks.length; ci++) {
            const pos: i64 = checks[ci];
            const is_last: boolean = (ci + 1 >= checks.length);
            const success_bb: LBasicBlock = if (is_last) {
                match_bb
            } else {
                LBasicBlock::append(current_fn, format("%s.pchk", name_prefix))
            };

            const field_ref: TypeRef = variant.payload_types[pos];
            const field_llvm: LType = this.cg.type_mapper.map_type(field_ref);
            const field_ptr: LValue = this.payload_field_ptr(
                enum_llvm, subject_ptr, &offsets, pos, field_llvm);
            if (!field_ptr.is_valid()) { this.cg.builder.build_br(miss_bb); return; }

            match (epat.elements[pos]) {
                PatternElement::LiteralInt(pli) => {
                    const lv: LValue = this.cg.builder.build_load(field_llvm, field_ptr, "pat.fld");
                    const cst: LValue = LType::const_int(field_llvm, pli.value as u64, false);
                    const c: LValue = this.cg.builder.build_icmp(LIntPredicate::EQ, lv, cst, "pat.eq");
                    this.cg.builder.build_cond_br(c, success_bb, miss_bb);
                }
                PatternElement::LiteralFloat(plf) => {
                    const lv: LValue = this.cg.builder.build_load(field_llvm, field_ptr, "pat.fld");
                    const cst: LValue = LType::const_real(field_llvm, plf.value);
                    const c: LValue = this.cg.builder.build_fcmp(LRealPredicate::OEQ, lv, cst, "pat.feq");
                    this.cg.builder.build_cond_br(c, success_bb, miss_bb);
                }
                PatternElement::Sub(ps) => {
                    const sub: PatternNode* = ps.pattern as PatternNode*;
                    const nested_ty: EnumType* = if (sub != null
                            && sub.pattern_kind == PatternKind::Enum) {
                        this.payload_enum_type(field_ref)
                    } else { null };
                    if (nested_ty != null) {
                        this.emit_enum_pattern_test(sub as EnumPatternNode*,
                            nested_ty, field_llvm, field_ptr, success_bb, miss_bb,
                            current_fn, name_prefix);
                    } else {
                        this.cg.builder.build_br(success_bb);
                    }
                }
                _ => { this.cg.builder.build_br(success_bb); }
            }

            if (!is_last) {
                this.cg.builder.position_at_end(success_bb);
            }
        }
    }


    // Pattern-value lowering

    /// Evaluate a pattern to an LLVM value for comparison.
    /// `subj_ty` is the Cryo type of the match subject: integer-literal
    /// patterns are built at the subject's integer width and signedness so
    /// `match (x: i64) { -1 => ... }` compares against a real i64 `-1`
    /// instead of a zero-extended-from-i32 `0x00000000FFFFFFFF`.
    codegen_pattern_value(mut &this, pat: PatternNode*, subj_ty: TypeRef) -> LValue {
        if (pat.pattern_kind == PatternKind::Literal) {
            const intern: InternTable* = this.cg.get_intern();
            return this.lower_scalar_literal(intern.resolve(pat.value),
                                             pat.literal_kind, subj_ty);
        } else if (pat.pattern_kind == PatternKind::Identifier) {
            // Constant-value pattern: `pat.value` holds the const's name (the
            // resolver set it after recognising the identifier as a `const`).
            // Load its value - from a local/parameter slot if present, else the
            // module global - for the icmp. Loaded at the subject's width so the
            // comparison operands agree.
            mut slot: LValue = this.cg.values.get(pat.value);
            if (!slot.is_valid()) {
                slot = this.cg.resolver.resolve_global(pat.value);
            }
            if (slot.is_valid()) {
                mut ty: LType = this.cg.type_mapper.map_type(subj_ty);
                if (!ty.is_valid()) { ty = LType::i32(); }
                return this.cg.builder.build_load(ty, slot, "pat.const");
            }
            return LValue::null();
        }
        return LValue::null();
    }

    /// Lower a single scalar literal (char / boolean / integer) to an LLVM
    /// constant for an `icmp` against the match subject.  `lit_kind` (set by
    /// the parser) says how to read the interned `text`: it can't be guessed
    /// from the text alone - `0` (Integer) and `'0'` (Char) both intern to
    /// "0", and `true`/`false` intern to "true"/"false".  Integer literals
    /// are built at the subject's width and signedness so the icmp operands
    /// match without a lossy widen.  Shared by the single-literal pattern
    /// path (`codegen_pattern_value`) and both bounds of a range pattern
    /// (`codegen_range_compare`).
    lower_scalar_literal(mut &this, text: string, lit_kind: LiteralKind,
                         subj_ty: TypeRef) -> LValue {
        if (lit_kind == LiteralKind::Char) {
            return LType::const_int(LType::i32(),
                                    CodegenUtil::decode_char_lexeme(text), false);
        }
        if (lit_kind == LiteralKind::Boolean) {
            const bval: u64 = if (text == "true") { 1 } else { 0 };
            return LType::const_int(LType::i1(), bval, false);
        }
        if (lit_kind == LiteralKind::Integer) {
            mut lit_ty: LType = LType::i32();
            mut lit_signed: boolean = true;
            const subj_t: Type* = this.cg.lookup_type_by_id(subj_ty.id);
            if (subj_t != null && subj_t.kind == TypeKind::Int) {
                const mapped: LType = this.cg.type_mapper.map_type(subj_ty);
                if (mapped.is_valid()
                        && LType::kind_of(mapped.raw) == LTypeKind::Integer) {
                    lit_ty = mapped;
                }
                lit_signed = this.cg.int_type_is_signed(subj_ty);
            }
            return LType::const_int(lit_ty, text.parse_int<u64>(), lit_signed);
        }
        // String / Float literal patterns don't lower to an `icmp` operand:
        // a string pattern is routed through the caller's string-compare
        // branch, and float literal patterns are not currently supported.
        return LValue::null();
    }

    /// Emit the boolean test for an inclusive `lo..hi` range pattern:
    /// `lo <= subject && subject <= hi`.  Both bounds are lowered at the
    /// subject's integer width (see `lower_scalar_literal`) and the compare
    /// predicate follows the subject's signedness - a `char` subject is
    /// `TypeKind::Char` (not `Int`), so `int_type_is_signed` reports
    /// unsigned, which is what we want (char code points are non-negative
    /// and stored as unsigned i32).  Returns null if either bound fails to
    /// lower, leaving the caller to treat the arm as a non-matching miss.
    codegen_range_compare(mut &this, pat: PatternNode*, subj_ty: TypeRef,
                          subject: LValue, name_prefix: string) -> LValue {
        const intern: InternTable* = this.cg.get_intern();
        const lo_val: LValue = this.lower_scalar_literal(
            intern.resolve(pat.value), pat.literal_kind, subj_ty);
        const hi_val: LValue = this.lower_scalar_literal(
            intern.resolve(pat.high_value), pat.literal_kind, subj_ty);
        if (!lo_val.is_valid() || !hi_val.is_valid()) { return LValue::null(); }

        const lo_c: LValue = this.cg.expr_ops.coerce_icmp_operands(
            subject, lo_val, subj_ty);
        const hi_c: LValue = this.cg.expr_ops.coerce_icmp_operands(
            subject, hi_val, subj_ty);

        mut ge_pred: LIntPredicate = LIntPredicate::UGE;
        mut le_pred: LIntPredicate = LIntPredicate::ULE;
        if (this.cg.int_type_is_signed(subj_ty)) {
            ge_pred = LIntPredicate::SGE;
            le_pred = LIntPredicate::SLE;
        }

        const ge_lo: LValue = this.cg.builder.build_icmp(ge_pred, subject, lo_c,
            format("%s.ge", name_prefix));
        const le_hi: LValue = this.cg.builder.build_icmp(le_pred, subject, hi_c,
            format("%s.le", name_prefix));
        return this.cg.builder.build_and(ge_lo, le_hi,
            format("%s.range", name_prefix));
    }
}
