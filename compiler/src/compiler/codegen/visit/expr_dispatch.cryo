/// Expression Dispatch
///
/// Thin wrapper around `IRGeneratorVisitor::dispatch_node` plus the
/// lvalue->rvalue conversion that codegen needs at most expression sites.
/// Sub-emitters (ArrayLit, Call, Stmt, Expr, Decl, ...) recurse into the
/// AST through it - `dispatch.codegen_rvalue(visitor, expr)` - which
/// returns what the emitter for the expression's kind emitted.

namespace compiler::codegen::visit::expr_dispatch;

import compiler::codegen;
import compiler::codegen::{ llvm_types, context };
import compiler::codegen::state::visitor_state;
import compiler::codegen::state::visitor_state::{ Emitted, VisitorState };
import compiler::types;
import compiler::types::{ compound, type_base, type_ref, TypeKind };
import compiler::ast;
import compiler::ast::{ expression, node, NodeKind, statement };
import utils::logger;
import utils::logger::{ cdebug };
import compiler::lex;
import compiler::lex::{ TokenType };
import std::ffi::libc;
import compiler::ast::expression::{
    ArrayAccessNode, ExpressionNode, IdentifierNode, UnaryExprNode
};
import compiler::ast::statement::{ BlockStmt, Stmt };
import compiler::codegen::visit::ir_generator;
import compiler::codegen::visit::ir_generator::{ IRGeneratorVisitor };
import compiler::codegen::context::{ CodegenContext };
import compiler::codegen::llvm_types::{ LBasicBlock, LType, LValue };
import compiler::types::type_base::{ Type };


type struct ExprDispatch {
    // Back-pointers set by wire().  Null until wire() runs.
    cg:    CodegenContext*;
    state: VisitorState*;

    static null() -> ExprDispatch {
        return ExprDispatch {
            cg:    null,
            state: null,
        };
    }

    wire(mut &this, cg: CodegenContext*, state: VisitorState*) -> void {
        this.cg    = cg;
        this.state = state;
    }


    // Statement / block / expression dispatch

    /// Generate a block of statements: push a scope, dispatch each child
    /// statement through `generate_statement`, pop the scope.  Stops early
    /// once the current basic block has a terminator so we don't emit
    /// unreachable IR after an early return.  The block's value is its last
    /// emitted statement's.
    generate_block(mut &this, visitor: IRGeneratorVisitor*, block: Stmt*) -> Emitted {
        mut out: Emitted = Emitted::none();
        if (block == null) { return out; }
        const b: BlockStmt* = block.as_block();
        this.cg.values.push_scope();
        cdebug("[IRGen]         block (%lld stmts) at %s:%d:%d\n",
               b.statements.length, block.span.file,
               block.span.start_line as i32, block.span.start_col as i32); libc::fflush(null);
        for (mut i: i64 = 0; i < b.statements.length; i++) {
            const current: LBasicBlock = this.cg.builder.get_insert_block();
            if (current.is_valid() && current.has_terminator()) {
                break;
            }
            const stmt: Stmt* = b.statements[i];
            if (stmt != null) {
                out = this.generate_statement(visitor, stmt);
            }
        }
        // Value-block drops (a match-expression arm's own non-yielded locals):
        // stashed here by drop-insertion because they must run AFTER the arm's
        // value statement yet before this scope is popped, so the drop calls
        // still resolve the arm-local bindings.  They produce nothing, so the
        // arm's value is still the block's.  Empty for every non-value block.
        // Skip if the block already terminated (an early exit emitted its own
        // cumulative drops); replaying after a terminator would be unreachable.
        if (b.synth_drops.length > 0) {
            const cur: LBasicBlock = this.cg.builder.get_insert_block();
            if (!(cur.is_valid() && cur.has_terminator())) {
                for (mut i: i64 = 0; i < b.synth_drops.length; i++) {
                    const d: Stmt* = b.synth_drops[i];
                    if (d != null) { this.generate_statement(visitor, d); }
                }
            }
        }
        this.cg.values.pop_scope();
        return out;
    }

    /// Emit a statement through the visitor's dispatch on its kind.
    generate_statement(mut &this, visitor: IRGeneratorVisitor*, stmt: Stmt*) -> Emitted {
        if (stmt == null) { return Emitted::none(); }
        cdebug("[IRGen]           stmt kind=%s\n", stmt.kind.to_string()); libc::fflush(null);
        return visitor.dispatch_node(stmt);
    }

    /// Emit an expression through the visitor's dispatch on its kind.
    generate_expression(mut &this, visitor: IRGeneratorVisitor*, expr: ExpressionNode*) -> Emitted {
        if (expr == null) { return Emitted::none(); }
        cdebug("[IRGen]             expr kind=%s\n", expr.kind.to_string());
        return visitor.dispatch_node(expr);
    }


    // Value-shape helpers (codegen_expr / codegen_rvalue / codegen_lvalue)

    /// Codegen an expression, ensuring the result is an rvalue (loaded).
    codegen_rvalue(mut &this, visitor: IRGeneratorVisitor*, expr: ExpressionNode*) -> LValue {
        if (expr == null) { return LValue::null(); }
        const e: Emitted = this.generate_expression(visitor, expr);
        const v: LValue = e.value;

        if (e.is_lvalue && v.is_valid()) {
            // String-index special case: char is i32 but string storage
            // is i8 per byte.  `codegen_array_access` returns the byte's
            // i8* as lvalue; here we do the i8-load-and-zext so the
            // value has the expected char/i32 type.  Generic map_type
            // load would read 4 bytes from an i8 slot (walking into
            // neighbouring bytes), which is wrong.
            if (expr.kind == NodeKind::ArrayAccess) {
                const aa: ArrayAccessNode* = expr as ArrayAccessNode*;
                const arr_t: Type* = this.cg.arena_type(aa.array.resolved_type);
                if (arr_t != null && arr_t.kind == TypeKind::String) {
                    const byte: LValue = this.cg.builder.build_load(
                        LType::i8(), v, "charbyte");
                    return this.cg.builder.build_zext(byte, LType::i32(), "char");
                }
            }
            // Same special case for `*string`: lex_token does
            // `mut c: char = *this.current as char` to read one ASCII byte.
            // The generic load reads `map_type(char) = i32` (4 bytes), which
            // is wrong for an i8-sized backing store.  Emit i8-load + zext-to-i32.
            if (expr.kind == NodeKind::UnaryExpression) {
                const ue: UnaryExprNode* = expr as UnaryExprNode*;
                if (ue.op.kind == TokenType::Star) {
                    const op_t: Type* = this.cg.arena_type(ue.operand.resolved_type);
                    if (op_t != null && op_t.kind == TypeKind::String) {
                        const byte: LValue = this.cg.builder.build_load(
                            LType::i8(), v, "strbyte");
                        return this.cg.builder.build_zext(byte, LType::i32(), "char");
                    }
                }
            }
            // Variadic bucket: `args` in a variadic function body is
            // bound to the va_list alloca (shape selected per-ABI by
            // `AbiClassifier::va_list_alloca_type`).  When referenced
            // as an rvalue (e.g., forwarded to `vformat(fmt, args)`),
            // return the alloca pointer directly rather than loading;
            // loading the raw buffer isn't meaningful for va_list
            // forwarding, which always takes a pointer on SysV.  On
            // Win64 the same pointer is correct for VaArgs::new /
            // va_arg use; passing it BY VALUE to a `v*printf` callee
            // needs `AbiClassifier::forward_va_list` at the call site.
            if (expr.kind == NodeKind::Identifier) {
                const ident: IdentifierNode* = expr as IdentifierNode*;
                if (this.cg.expr_ops.variadic_args.is_valid() &&
                    ident.res.local_sym().equals(this.cg.expr_ops.variadic_args)) {
                    return v;
                }
            }
            const ty: LType = this.cg.type_mapper.map_type(expr.resolved_type);
            if (ty.is_valid()) {
                return this.cg.builder.build_load(ty, v, "load");
            }
        }
        return v;
    }

    /// Codegen an expression, returning what it emitted, place or value,
    /// without loading a place.
    codegen_lvalue(mut &this, visitor: IRGeneratorVisitor*, expr: ExpressionNode*) -> LValue {
        if (expr == null) { return LValue::null(); }
        return this.generate_expression(visitor, expr).value;
    }
}
