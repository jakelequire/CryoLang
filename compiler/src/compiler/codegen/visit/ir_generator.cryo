/// IR Generator
///
/// The main AST visitor that produces LLVM IR.  `dispatch_node` hands each
/// node to the `visit_*` method for its kind, which returns what it emitted.
/// Delegates to the expression, statement, and declaration codegen
/// modules for the actual IR construction.

namespace compiler::codegen::visit::ir_generator;

import compiler::codegen;
import compiler::codegen::{ context, llvm, llvm_types, type_map, util };
import compiler::codegen::state::visitor_state;
import compiler::codegen::state::visitor_state::{ Emitted, VisitorState };
import compiler::codegen::ops::{ ir_flow_emitter };
import compiler::codegen::visit::{
    expr_dispatch, pattern_emitter, lambda_emitter, array_lit_emitter, enum_variant_emitter,
    call_emitter, new_delete_emitter, binary_unary_emitter, place_emitter, decl_visit_emitter
};
import compiler::compilation_context;
import compiler::compilation_context::{ CompilationContext };
import compiler::decl_index;
import compiler::decl_index::{ DeclarationIndex, GlobalEntry, OverloadId };
import compiler::module_graph;
import compiler::diag;
import compiler::diag::{ diagnostic, ErrorCode, source_span };
import compiler::types;
import compiler::types::{
    arena, compound, generic, generic_registry, IntegerKind, ownership, resolver, type_base, type_ref, TypeKind, user_defined
};
import compiler::ast;
import compiler::ast::{
    declaration, expression, LiteralKind, MemberPin, node, NodeKind, pattern, statement,
    TypeAnnotation
};
import compiler::lex;
import compiler::lex::lexer::{ Lexer };
import compiler::resolver::{ symbol_str, intern_table, qualified_name, mangled_name };
import compiler::resolver::res;
import compiler::resolver::res::{ DefId, Res, ResSlot, SourceLoc };
import utils::logger;
import utils::logger::{ cdebug };
import std::collections::pair;
import std::fmt::float;
import std::ffi::libc;
import std::fmt;
import compiler::ast::declaration::{
    ClassDeclNode, DestructureBinding, DestructureDeclNode, FunctionDeclNode,
    ImplBlockNode, MethodNode, StructDeclNode, UnionDeclNode, VarDeclNode
};
import compiler::ast::expression::{
    CalleePin,
    AlignofExprNode, ArrayAccessNode, ArrayLiteralNode, AwaitExprNode, BinaryExprNode,
    CallExprNode, CastExprNode, DeleteExprNode, ExpressionNode, FieldInit, IdentifierNode,
    IfExprNode, LambdaExprNode, LiteralNode, MatchExprNode, MemberAccessNode, NewExprNode,
    ScopeResolutionNode, SizeofExprNode, StaticMatchExprNode, StructLiteralNode,
    TernaryExprNode, TryExprNode, TupleLiteralNode, TypeofExprNode, UnaryExprNode,
