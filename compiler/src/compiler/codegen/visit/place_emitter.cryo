/// Place Emitter
///
/// Lvalue / place lowering for member access (`obj.field`), array
/// access (`arr[i]`), and tuple index (`t.0`).  Each path GEPs into the
/// container and lands on `state.last_value` with `last_is_lvalue=true`
/// so the caller can assign through or load from it depending on
/// context (rvalue users go through `dispatch.codegen_rvalue` which
/// loads).
///
/// The visit() handlers in `ir_generator.cryo` evaluate the receiver
/// (and index, for array access) via `dispatch.codegen_lvalue` /
/// `dispatch.codegen_rvalue`, then call the corresponding `emit_*`
/// method here to perform the GEP and field-typing.
///
/// Holds `cg`, `state`, `dispatch` back-pointers.  Does not call
/// back into the visitor - `try_codegen_tuple_index` and the two
/// `codegen_*` paths receive everything they need by parameter.

namespace compiler::codegen::visit::place_emitter;

import compiler::codegen;
import compiler::codegen::{ llvm_types, type_map, context, util };
import compiler::codegen::state::visitor_state;
import compiler::codegen::visit::expr_dispatch;
import compiler::compilation_context;
import compiler::decl_index;
import compiler::diag;
import compiler::diag::{ diagnostic, source_span };
import compiler::types;
import compiler::types::{ type_ref, type_base, arena, compound, user_defined };
import compiler::ast;
import compiler::ast::{ node, visitor, expression };
import compiler::resolver::{ symbol_str, intern_table };
import compiler::types::generic;
import std::ffi::libc;


type struct PlaceEmitter {
    cg:       CodegenContext*;
    state:    VisitorState*;
    dispatch: ExprDispatch*;

    static null() -> PlaceEmitter {
        return PlaceEmitter {
            cg:       null,
            state:    null,
            dispatch: null,
        };
    }

    wire(mut &this, cg: CodegenContext*, state: VisitorState*,
                    dispatch: ExprDispatch*) -> void {
        this.cg       = cg;
        this.state    = state;
        this.dispatch = dispatch;
    }


    // Member access (obj.field)

    /// Generate a GEP to a struct/class field.  `site_span` is the source span
    /// of the access expression in the caller; used only to attach a source
    /// snippet to any diagnostic we emit.
    codegen_member_access(mut &this, object_ptr: LValue, object_type: TypeRef, object_is_lvalue: boolean, member: SymbolStr, site_span: SourceSpan) -> void {
        // Auto-deref: if the object is a pointer/reference (e.g., `node: ExprStmtNode*`
        // stored in an alloca), load the pointer value so we can GEP into the struct.
        // This matches C/Rust behavior where `node.field` on a pointer is an implicit
        // deref.  Applied once per call; GEP'd field pointers stay as struct pointers.
        mut obj_ptr: LValue = object_ptr;
        mut obj_type: TypeRef = object_type;
        mut t: Type* = this.cg.lookup_type_by_id(obj_type.id);

        // Unwrap InstantiatedType to its concrete resolved form before kind-based
        // dispatch.  Sema does the same in `check_field_access`; without this,
        // a `Pair<string>` resolves to an `InstantiatedType` whose kind isn't
        // Struct/Class/Array, and every field/length access silently returns null.
        mut inst_depth: i32 = 0;
        while (t != null && t.kind == TypeKind::InstantiatedType && inst_depth < 5) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (!inst.has_resolved_type()) { break; }
            obj_type = inst.resolved_type;
            t = this.cg.lookup_type_by_id(obj_type.id);
            inst_depth += 1;
        }

        if (t != null && (t.kind == TypeKind::Pointer || t.kind == TypeKind::Reference)) {
            if (t.kind == TypeKind::Pointer) {
                const pt: PointerType* = t as PointerType*;
                obj_type = pt.pointee;
            } else {
                const rt: ReferenceType* = t as ReferenceType*;
                obj_type = rt.referent;
            }
            t = this.cg.lookup_type_by_id(obj_type.id);

            // Load the pointer value through the alloca (only when `object_ptr`
            // really is an lvalue pointing at a ptr slot). Under opaque pointers
            // every value has LLVM type `ptr`, so the kind check alone can't
            // distinguish a slot from a raw rvalue; the previous version
            // ALWAYS loaded, which over-derefed any pointer rvalue (e.g. the
            // result of `obj.as_ptr().count` where `as_ptr()` already returned
            // the pointer value, not a slot containing it). Threading the
            // semantic lvalue flag through is the only reliable signal.
            if (object_is_lvalue && obj_ptr.is_valid()) {
                obj_ptr = this.cg.builder.build_load(LType::pointer_to(LType::i8()),
                                                obj_ptr, "autoderef");
            }
        }

        // The pointee of a Pointer/Reference may itself be an InstantiatedType
        // (e.g. `HashMapEntry<u32, i64>` sitting in the arena as the pointee of a
        // `HashMapEntry<u32, i64>*`). Mirror the pre-Pointer unwrap above so the
        // kind dispatch below sees the concrete Struct/Class/Array; without this,
        // field_idx stays -1, the access silently emits no IR, and the
        // half-emitted basic block gets stripped by `is_function_body_valid`.
        mut inst_depth2: i32 = 0;
        while (t != null && t.kind == TypeKind::InstantiatedType && inst_depth2 < 5) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (!inst.has_resolved_type()) { break; }
            obj_type = inst.resolved_type;
            t = this.cg.lookup_type_by_id(obj_type.id);
            inst_depth2 += 1;
        }

        if (t == null) {
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        const tk: TypeKind = t.kind;
        mut field_idx: i64 = -1;

        if (tk == TypeKind::Tuple) {
            // Tuple positional access: parse member SymbolStr as decimal index.
            // Sema already validated bounds; codegen trusts the resolved_type
            // path and just GEPs slot N.
            const member_str: string = this.cg.resolve(member);
            const idx: i64 = CodegenUtil::parse_tuple_member_index(member_str);
            if (idx >= 0) {
                const tup: TupleType* = t as TupleType*;
                if (idx < tup.elements.length) {
                    field_idx = idx;
                }
            }
        } else if (tk == TypeKind::Struct) {
            const st: StructType* = t as StructType*;
            field_idx = st.field_index(member);
        } else if (tk == TypeKind::Class) {
            // A class body is flattened - vtable slot, then ancestors' fields,
            // then its own - so a member's slot is not its index in any one
            // field list.  `member_element_index` owns that arithmetic and is
            // the same routine the body was built from.
            field_idx = this.cg.type_mapper.member_element_index(t, member);
        } else if (tk == TypeKind::Array) {
            const arr_t: ArrayType* = t as ArrayType*;
            const length_sym: SymbolStr = this.cg.intern_str("length");
            if (member.id == length_sym.id) {
                if (arr_t.is_fixed()) {
                    // Fixed array: length is a compile-time constant.
                    this.state.last_value = LType::const_int(LType::i64(), arr_t.size as u64, false);
                    this.state.last_is_lvalue = false;
                    return;
                }
                // Dynamic array { T*, i64 }: length is field 1.
                field_idx = 1;
            }
        }

        if (field_idx < 0) {
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        // Union member access: every field overlaps at offset 0, so the
        // member's lvalue is just the union's address reinterpreted as a
        // pointer to the member's type (a bitcast), NOT a GEP into a slot of
        // the storage blob.  A union returned by value (`f().x`) is first
        // spilled to a temp alloca so we have an address to reinterpret.
        if (tk == TypeKind::Struct) {
            const ust: StructType* = t as StructType*;
            if (ust.is_union) {
                const fld_ty: TypeRef = ust.fields[field_idx].field_type;
                const fld_lty: LType = this.cg.type_mapper.map_type(fld_ty);
                if (!fld_lty.is_valid() || !obj_ptr.is_valid()) {
                    this.cg.diag.emit_error_at_span(ErrorCode::E0622_MEMBER_ACCESS_ERROR,
                        "codegen: union member access: failed to map member type or null object",
                        site_span);
                    this.state.last_value = LValue::null();
                    this.state.last_is_lvalue = false;
                    return;
                }
                mut uptr: LValue = obj_ptr;
                const u_llvm: void* = llvm::LLVMTypeOf(obj_ptr.raw);
                if (u_llvm != null && LType::kind_of(u_llvm) == LTypeKind::Struct) {
                    const u_lty: LType = this.cg.type_mapper.map_type(obj_type);
                    const bb: LBasicBlock = this.cg.builder.get_insert_block();
                    const cur_fn: LValue = bb.get_parent();
                    const tmp: LValue = this.cg.flow.create_entry_alloca(cur_fn, "unionval", u_lty);
                    this.cg.builder.build_store(obj_ptr, tmp);
                    uptr = tmp;
                }
                const cast: LValue = this.cg.builder.build_bitcast(
                    uptr, LType::pointer_to(fld_lty), "unionfield");
                this.state.last_value = cast;
                this.state.last_is_lvalue = true;
                return;
            }
        }

        const struct_ty: LType = this.cg.type_mapper.map_type(obj_type);
        if (!struct_ty.is_valid()) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0622_MEMBER_ACCESS_ERROR,
                "codegen: member access: failed to map object type to LLVM type",
                site_span);
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }
        if (!obj_ptr.is_valid()) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0622_MEMBER_ACCESS_ERROR,
                "codegen: member access: object pointer is null",
                site_span);
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }
        // If `obj_ptr` is a struct VALUE (e.g., a direct return from a
        // function call: `f().field`), it isn't a GEP-able address.  Use
        // `extractvalue` to pull out the field from the value and return
        // an rvalue.  Under opaque pointers an actual pointer has kind
        // Pointer, so checking for Struct here is unambiguous.
        const obj_llvm_ty: void* = llvm::LLVMTypeOf(obj_ptr.raw);
        // From here on the index addresses the BODY, not the field list: a
        // struct's fields can be separated by alignment padding elements.  A
        // class member already arrived as a body slot (see above); a tuple
        // slot and the dynamic-array header are their own element order.
        mut elem_idx: i64 = field_idx;
        if (tk == TypeKind::Struct) {
            elem_idx = this.cg.type_mapper.field_element_index(t, field_idx);
            if (elem_idx < 0) {
                this.cg.diag.emit_error_at_span(ErrorCode::E0622_MEMBER_ACCESS_ERROR,
                    "codegen: member access: field has no slot in the emitted layout",
                    site_span);
                this.state.last_value = LValue::null();
                this.state.last_is_lvalue = false;
                return;
            }
        }
        if (obj_llvm_ty != null && LType::kind_of(obj_llvm_ty) == LTypeKind::Struct) {
            this.state.last_value = this.cg.builder.build_extract_value(
                obj_ptr, elem_idx as u32, "fieldval");
            this.state.last_is_lvalue = false;
            return;
        }
        const gep: LValue = this.cg.builder.build_struct_gep(struct_ty, obj_ptr,
                                                          elem_idx as u32, "fieldptr");
        this.state.last_value = gep;
        this.state.last_is_lvalue = true;
    }

    // Array access (arr[i])


    /// Generate IR for an array indexing operation.
    codegen_array_access(mut &this, array_val: LValue, array_type: TypeRef, array_is_lvalue: boolean, index_val: LValue, site_span: SourceSpan,
                         visitor: ASTVisitor*, idx_sched: ASTNode*[]*) -> void {
        const t: Type* = this.cg.lookup_type_by_id(array_type.id);
        if (t == null) {
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        // Reference indexing: `foo[i]` on a `&T[]` means deref-then-index,
        // mirroring how member access auto-derefs references.  A reference is
        // a pointer at the ABI level holding the address of the referent (the
        // array header `{data, len}`).  Load that address when the reference
        // lives in a slot (the usual lvalue case), otherwise it is already in
        // hand (e.g. a call returning `&T[]`).  Recurse on the referent: the
        // loaded address acts as the array's lvalue.  This is NOT done for raw
        // pointers `T*`, which index as C pointer arithmetic below.
        if (t.kind == TypeKind::Reference) {
            const rt: ReferenceType* = t as ReferenceType*;
            if (!array_val.is_valid()) {
                this.state.last_value = LValue::null();
                this.state.last_is_lvalue = false;
                return;
            }
            mut header_ptr: LValue = array_val;
            if (array_is_lvalue) {
                header_ptr = this.cg.builder.build_load(
                    LType::pointer_to(LType::i8()), array_val, "refderef");
            }
            this.codegen_array_access(header_ptr, rt.referent, true,
                                      index_val, site_span, visitor, idx_sched);
            return;
        }

        // Pointer indexing (C-style `ptr[i]` == `*(ptr + i)`).  When
        // `array_is_lvalue` is true, `array_val` is a slot containing the
        // pointer (e.g. a local variable of type `T*`) and needs a load
        // first.  When false, the pointer value is already in hand
        // (e.g. result of a call returning `T*`) and we GEP directly.
        if (t.kind == TypeKind::Pointer) {
            const pt: PointerType* = t as PointerType*;
            // Pointer-to-array auto-derefs, exactly like the reference case
            // above: load the pointer to get the address of the array header
            // `{data, len}`, then recurse treating that as the array's lvalue.
            // Raw pointers `T*` fall through to C-style pointer arithmetic.
            const pointee_t: Type* = this.cg.lookup_type_by_id(pt.pointee.id);
            if (pointee_t != null && pointee_t.kind == TypeKind::Array) {
                if (!array_val.is_valid()) {
                    this.state.last_value = LValue::null();
                    this.state.last_is_lvalue = false;
                    return;
                }
                mut header_ptr: LValue = array_val;
                if (array_is_lvalue) {
                    header_ptr = this.cg.builder.build_load(
                        LType::pointer_to(LType::i8()), array_val, "ptrarrderef");
                }
                this.codegen_array_access(header_ptr, pt.pointee, true,
                                          index_val, site_span, visitor, idx_sched);
                return;
            }
            const elem_ty: LType = this.cg.type_mapper.map_type(pt.pointee);
            if (!elem_ty.is_valid() || !array_val.is_valid() || !index_val.is_valid()) {
                this.state.last_value = LValue::null();
                this.state.last_is_lvalue = false;
                return;
            }
            mut data_ptr: LValue = array_val;
            if (array_is_lvalue) {
                const ptr_ty: LType = LType::pointer_to(elem_ty);
                data_ptr = this.cg.builder.build_load(ptr_ty, array_val, "ptrload");
            }
            const buf: void* = libc::malloc(8);
            const slots: void** = buf as void**;
            slots[0] = index_val.raw;
            const gep: LValue = this.cg.builder.build_gep(elem_ty, data_ptr, buf, 1, "elemptr");
            libc::free(buf);
            this.state.last_value = gep;
            this.state.last_is_lvalue = true;
            return;
        }

        // String indexing (`s[i]`): treat the string as `i8*` at the LLVM
        // level.  Return the byte's address as an lvalue so it can be used
        // on both sides of an assignment (`c = s[i]` AND `s[i] = c`).  The
        // `char` (i32) vs byte (i8) size mismatch is resolved by the callers
        // (`codegen_rvalue` load-and-zext for reads, the assignment path
        // trunc-and-store for writes; both look for the `TypeKind::String`
        // source type to detect this case).
        if (t.kind == TypeKind::String) {
            if (!array_val.is_valid() || !index_val.is_valid()) {
                this.state.last_value = LValue::null();
                this.state.last_is_lvalue = false;
                return;
            }
            const i8_ty: LType = LType::i8();
            mut data_ptr: LValue = array_val;
            if (array_is_lvalue) {
                const i8_ptr_ty: LType = LType::pointer_to(i8_ty);
                data_ptr = this.cg.builder.build_load(i8_ptr_ty, array_val, "strptr");
            }
            const buf: void* = libc::malloc(8);
            const slots: void** = buf as void**;
            slots[0] = index_val.raw;
            const byte_ptr: LValue = this.cg.builder.build_gep(i8_ty, data_ptr, buf, 1, "charptr");
            libc::free(buf);
            this.state.last_value = byte_ptr;
            this.state.last_is_lvalue = true;
            return;
        }

        if (t.kind != TypeKind::Array) {
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        const arr: ArrayType* = t as ArrayType*;
        const elem_ty: LType = this.cg.type_mapper.map_type(arr.element);
        if (!elem_ty.is_valid()) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0621_ARRAY_OPERATION_ERROR,
                "codegen: array access: failed to map element type",
                site_span);
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }
        if (!array_val.is_valid()) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0621_ARRAY_OPERATION_ERROR,
                "codegen: array access: array value is null",
                site_span);
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }
        if (!index_val.is_valid()) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0621_ARRAY_OPERATION_ERROR,
                "codegen: array access: index value is null",
                site_span);
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        if (arr.is_fixed()) {
            // Fixed array: GEP into [N x T].
            const arr_ty: LType = this.cg.type_mapper.map_type(array_type);
            // Bounds check against the fixed length `N` (a compile-time constant,
            // so an in-range constant index folds away under O2).
            const fx_len: LValue = LType::const_int(LType::i64(), arr.size as u64, false);
            this.emit_bounds_check(index_val, fx_len, visitor, idx_sched, site_span);
            // Build indices: [0, index]
            const zero: LValue = LType::const_int(LType::i64(), 0, false);
            const buf: void* = libc::malloc(16);
            const slots: void** = buf as void**;
            slots[0] = zero.raw;
            slots[1] = index_val.raw;
            const gep: LValue = this.cg.builder.build_gep(arr_ty, array_val, buf, 2, "elemptr");
            libc::free(buf);
            this.state.last_value = gep;
            this.state.last_is_lvalue = true;
        } else {
            // Dynamic array: { T*, i64 } fat pointer.  When the value is in
            // a slot (lvalue, the usual case), load the struct first; when
            // the value is in hand (rvalue, e.g. `f()[i]` where `f` returns
            // `T[]`), use it directly.  Either way, extract field 0 to get
            // the data pointer, then GEP elem_ty by index.
            const arr_ty: LType = this.cg.type_mapper.map_type(array_type);
            mut struct_val: LValue = array_val;
            if (array_is_lvalue) {
                struct_val = this.cg.builder.build_load(arr_ty, array_val, "arrload");
            }
            const data_ptr: LValue = this.cg.builder.build_extract_value(struct_val, 0, "data");
            // Bounds check against the fat array's length field [1] before the
            // element GEP (both data_ptr and len dominate the ok block).
            const dyn_len: LValue = this.cg.builder.build_extract_value(struct_val, 1, "len");
            this.emit_bounds_check(index_val, dyn_len, visitor, idx_sched, site_span);
            const buf: void* = libc::malloc(8);
            const slots: void** = buf as void**;
            slots[0] = index_val.raw;
            const gep: LValue = this.cg.builder.build_gep(elem_ty, data_ptr, buf, 1, "elemptr");
            libc::free(buf);
            this.state.last_value = gep;
            this.state.last_is_lvalue = true;
        }
    }

    /// Emit an array bounds check: `index >= len` raises through `__cryo_panic`
    /// under `--panic=unwind` (with a cleanup landing pad that drops the frame's
    /// live locals) or aborts on the default path, else continues to the element
    /// GEP.  The index is widened to i64 (unsigned), so a narrow or negative
    /// index reads as a huge value and traps.  Leaves the builder at the ok
    /// block.  A provably-in-range constant index folds the branch away under
    /// O2, so the guard has no steady-state cost when safety is statically
    /// provable (mirrors `emit_int_div_guard`).
    emit_bounds_check(mut &this, index_val: LValue, len_val: LValue,
                      visitor: ASTVisitor*, idx_sched: ASTNode*[]*, site_span: SourceSpan) -> void {
        if (!index_val.is_valid() || !len_val.is_valid()) { return; }
        mut idx64: LValue = index_val;
        const idx_ty_raw: void* = llvm::LLVMTypeOf(index_val.raw);
        if (idx_ty_raw != null && llvm::LLVMGetIntTypeWidth(idx_ty_raw) < 64) {
            idx64 = this.cg.builder.build_zext(index_val, LType::i64(), "idx.ext");
        }
        const oob: LValue = this.cg.builder.build_icmp(
            LIntPredicate::UGE, idx64, len_val, "bounds.oob");
        const cur_bb: LBasicBlock = this.cg.builder.get_insert_block();
        if (!cur_bb.is_valid()) { return; }
        const fn: LValue = cur_bb.get_parent();
        const trap_bb: LBasicBlock = LBasicBlock::append(fn, "bounds.trap");
        const ok_bb: LBasicBlock = LBasicBlock::append(fn, "bounds.ok");
        this.cg.builder.build_cond_br(oob, trap_bb, ok_bb);

        this.cg.builder.position_at_end(trap_bb);
        if (this.cg.ctx.project_panic_unwind && !this.cg.intrinsics.no_runtime) {
            this.cg.expr_ops.emit_check_raise(visitor, idx_sched, site_span, "index out of bounds");
        } else {
            // The handler formats the operands, so it gets the index and the
            // length rather than a pre-baked message: "index 5 out of bounds
            // for length 3" needs both values, not just the site.
            mut ops: LValue[] = [idx64, len_val];
            this.cg.intrinsics.emit_check_sink("__cryo_panic_bounds_check",
                                              site_span, &ops);
        }
        this.cg.builder.position_at_end(ok_bb);
    }

    // Tuple index (t.N as t[N])

    try_codegen_tuple_index(mut &this, visitor: ASTVisitor*, aa: ArrayAccessNode*) -> boolean {
        // Walk past pointer/reference/instantiation wrappers to find the
        // underlying tuple kind. Mirrors the unwrap chain in
        // codegen_member_access so `(&t)[0]` works the same as `t[0]`.
        mut walk_ty: TypeRef = aa.array.resolved_type;
        mut walk_t: Type* = this.cg.lookup_type_by_id(walk_ty.id);
        mut depth: i32 = 0;
        while (walk_t != null && depth < 5) {
            if (walk_t.kind == TypeKind::Pointer) {
                const pt: PointerType* = walk_t as PointerType*;
                walk_ty = pt.pointee;
                walk_t = this.cg.lookup_type_by_id(walk_ty.id);
            } else if (walk_t.kind == TypeKind::Reference) {
                const rt: ReferenceType* = walk_t as ReferenceType*;
                walk_ty = rt.referent;
                walk_t = this.cg.lookup_type_by_id(walk_ty.id);
            } else if (walk_t.kind == TypeKind::InstantiatedType) {
                const it: InstantiatedType* = walk_t as InstantiatedType*;
                if (!it.has_resolved_type()) { break; }
                walk_ty = it.resolved_type;
                walk_t = this.cg.lookup_type_by_id(walk_ty.id);
            } else {
                break;
            }
            depth += 1;
        }
        if (walk_t == null || walk_t.kind != TypeKind::Tuple) {
            return false;
        }

        // Sema already validated this; the index is an integer literal
        // in bounds. Read the literal value directly off the AST so we
        // can pass it to build_struct_gep.
        const idx_node: ASTNode* = aa.index as ASTNode*;
        if (idx_node.kind != NodeKind::Literal) { return false; }
        const lit: LiteralNode* = aa.index as LiteralNode*;
        if (lit.literal_kind != LiteralKind::Integer) { return false; }
        const idx: u64 = lit.value.parse_int<u64>();

        const recv: LValue = this.dispatch.codegen_lvalue(visitor,aa.array);
        const recv_is_lvalue: boolean = this.state.last_is_lvalue;
        // Auto-deref reference receivers so `&t[0]` GEPs the underlying
        // tuple, not the reference slot.
        mut obj_ptr: LValue = recv;
        const obj_t: Type* = this.cg.lookup_type_by_id(aa.array.resolved_type.id);
        if (obj_t != null && (obj_t.kind == TypeKind::Pointer
                            || obj_t.kind == TypeKind::Reference)
                && recv_is_lvalue) {
            obj_ptr = this.cg.builder.build_load(
                LType::pointer_to(LType::i8()), recv, "autoderef");
        }

        const tup_ty: LType = this.cg.type_mapper.map_type(walk_ty);
        if (!tup_ty.is_valid() || !obj_ptr.is_valid()) {
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return true;
        }
        const gep: LValue = this.cg.builder.build_struct_gep(
            tup_ty, obj_ptr, idx as u32, "tupelem");
        this.state.last_value = gep;
        this.state.last_is_lvalue = true;
        return true;
    }
}
