/// Enum Variant Emitter
///
/// Build an enum variant value (the literal-form of "construct an enum"):
///   - simple enums          -> return the i32 discriminant constant
///   - ADT no-payload variant -> return `{ tag, zeroinit }`
///   - ADT payload variant   -> alloca, store tag, store payload, load value
///
/// Shared by `visit(CallExprNode*)` (when the call resolves to a variant
/// ctor), `visit(NewExprNode*)` (for `new EnumType::Variant(args)`), and
/// `visit(ScopeResolutionNode*)` (for `EnumType::Variant` zero-args form).
///
/// Holds only `cg: CodegenContext*`; does not touch the visitor's state.

namespace Compiler::Codegen::Visit::EnumVariantEmitter;

import Compiler::Codegen;
import Compiler::Codegen::{ LLVMTypes, Context };
import Compiler::Diag;
import Compiler::Types;
import Compiler::Types::{ TypeRef, Type, UserDefined, Generic, Arena };


type struct EnumVariantEmitter {
    cg: CodegenContext*;

    static null() -> EnumVariantEmitter {
        return EnumVariantEmitter { cg: null };
    }

    wire(mut &this, cg: CodegenContext*) -> void {
        this.cg = cg;
    }


    /// A payload-variant construction whose field type failed to lower
    /// (an uninstantiated generic parameter reaching codegen).  Emitting
    /// the value anyway would leave its payload bytes uninitialised, so
    /// this is a hard error, not a skip.
    report_unresolved_payload(&this, et: EnumType*, variant: EnumVariantInfo*) -> void {
        this.cg.ctx.emit_error(ErrorCode::E0600_CODEGEN_FAILED,
            format("codegen: payload type of enum variant `%s::%s` is unresolved (generic parameter not instantiated); the constructed value would lose its payload",
                   this.cg.resolve(et.qualified_name),
                   this.cg.resolve(variant.name)));
    }

    /// Current LLVM function for entry-block alloca placement.
    get_current_function(&this) -> LValue {
        const bb: LBasicBlock = this.cg.builder.get_insert_block();
        if (!bb.is_valid()) {
            this.cg.ctx.emit_error(ErrorCode::E0600_CODEGEN_FAILED,
                "codegen: builder has no insert block; cannot determine current function");
            return LValue::null();
        }
        return bb.get_parent();
    }


    /// Build an enum variant value.
    /// For simple enums: returns i32 tag constant.
    /// For ADT enums: returns `{ i32 tag, [N x i8] }` with payload stored.
    build(mut &this, et: EnumType*, variant: EnumVariantInfo*,
                     enum_ref: TypeRef, args: LValue[]) -> LValue {
        // The tag's width follows the enum's discriminant base for simple
        // enums (`type enum E : i64`), else i32.  Building the constant at
        // the right width is what stops a large discriminant (e.g.
        // 4294967296) truncating to its low 32 bits.
        const tag_ty: LType = this.cg.type_mapper.enum_tag_ltype(et);
        const tag_val: LValue = LType::const_int(tag_ty, variant.tag_value, false);

        // Simple enum: the tag IS the value.
        if (et.is_simple_enum()) {
            return tag_val;
        }

        // ADT enum: map the full enum type to { i32, [N x i8] }.
        const enum_llvm: LType = this.cg.type_mapper.map_type(enum_ref);
        if (!enum_llvm.is_valid()) {
            return LValue::null();
        }

        // No-payload variant on an ADT enum: return { tag, zeroinit }.
        if (!variant.has_payload()) {
            const null_val: LValue = LType::const_null(enum_llvm);
            const result: LValue = this.cg.builder.build_insert_value(
                null_val, tag_val, 0, "enum.tag");
            return result;
        }

        // Payload variant: alloca, store tag, store payload fields.
        const current_fn: LValue = this.get_current_function();
        const alloca: LValue = this.cg.flow.create_entry_alloca(current_fn, "enum.tmp", enum_llvm);

        // Store tag at field 0 using struct GEP.
        const tag_ptr: LValue = this.cg.builder.build_struct_gep(enum_llvm, alloca, 0, "enum.tag.ptr");
        this.cg.builder.build_store(tag_val, tag_ptr);

        // Get pointer to payload at field 1.
        const payload_ptr: LValue = this.cg.builder.build_struct_gep(enum_llvm, alloca, 1, "enum.payload.ptr");

        // For single-payload variants, store the argument directly.
        // For multi-payload, store each field sequentially.
        if (args.length == 1 && variant.payload_types.length == 1) {
            const payload_ty: LType = this.cg.type_mapper.map_type(variant.payload_types[0]);
            if (!payload_ty.is_valid()) {
                // An unmapped payload type here means the variant is still
                // carrying an uninstantiated generic parameter at emission
                // time (sema failed to stamp the constructor's concrete
                // instantiation).  Silently dropping the store would emit a
                // value whose payload is stack garbage - fail loudly instead.
                this.report_unresolved_payload(et, variant);
                return LValue::null();
            }
            const typed_ptr: LValue = this.cg.builder.build_bitcast(
                payload_ptr, LType::pointer_to(payload_ty), "enum.payload.cast");
            const stored_val: LValue = this.coerce_int_payload(
                args[0], payload_ty, variant.payload_types[0]);
            this.cg.builder.build_store(stored_val, typed_ptr);
        } else {
            // Multi-field payload: field offsets come from the single layout
            // authority (TypeArena::variant_payload_layout) - the same
            // align-up offsets used by pattern binding, drop glue, and the
            // lowered LLVM type - so every reader agrees with these stores.
            const arena: TypeArena* = this.cg.get_arena();
            const offsets: u64[] = arena.variant_payload_layout(variant, null, null);
            for (mut i: i64 = 0; i < args.length && i < variant.payload_types.length as i64; i++) {
                const field_ty: LType = this.cg.type_mapper.map_type(variant.payload_types[i]);
                if (!field_ty.is_valid()) {
                    // Same unresolved-generic hole as the single-payload
                    // path: an argument is present but its field type never
                    // instantiated - dropping the store is a silent
                    // miscompile.
                    this.report_unresolved_payload(et, variant);
                    return LValue::null();
                }
                const byte_offset: LValue = LType::const_int(LType::i64(), offsets[i], false);
                const obuf: void* = intrinsics::malloc(8);
                const obuf_arr: void** = obuf as void**;
                obuf_arr[0] = byte_offset.raw;
                const field_ptr_raw: LValue = this.cg.builder.build_gep(
                    LType::i8(), payload_ptr, obuf, 1, "enum.field.ptr");
                intrinsics::free(obuf);
                const field_ptr: LValue = this.cg.builder.build_bitcast(
                    field_ptr_raw, LType::pointer_to(field_ty), "enum.field.cast");
                const stored_field: LValue = this.coerce_int_payload(
                    args[i], field_ty, variant.payload_types[i]);
                this.cg.builder.build_store(stored_field, field_ptr);
            }
        }

        return this.cg.builder.build_load(enum_llvm, alloca, "enum.val");
    }

    /// Widen / narrow an integer payload value to the variant field's
    /// declared LLVM width before storing.  Without this an `i32` literal
    /// (`Some(5)` - and even `Some(5i64)`, which still reaches codegen as an
    /// `i32` constant) stored into an `i64` payload slot writes only 4 bytes,
    /// leaving the high word as stack garbage; two `Option<i64>::Some(5)`
    /// values then compare unequal.  Mirrors the struct-literal field
    /// coercion in ir_generator and new_delete_emitter.  Non-integer payloads
    /// (and equal widths) pass through untouched.
    coerce_int_payload(&this, val: LValue, field_lty: LType, field_ref: TypeRef) -> LValue {
        if (!field_lty.is_valid()) { return val; }
        const field_raw: void* = field_lty.raw;
        const val_raw: void* = llvm::LLVMTypeOf(val.raw);
        if (field_raw == null || val_raw == null) { return val; }
        if (LType::kind_of(field_raw) != LTypeKind::Integer
                || LType::kind_of(val_raw) != LTypeKind::Integer) {
            return val;
        }
        const want_bits: u32 = llvm::LLVMGetIntTypeWidth(field_raw);
        const got_bits:  u32 = llvm::LLVMGetIntTypeWidth(val_raw);
        if (want_bits > got_bits) {
            // Widen with the field's signedness so a negative narrow literal
            // (`-1`) keeps its sign in the wider slot rather than becoming a
            // large positive value.
            mut signed_target: boolean = false;
            const ft: Type* = this.resolve_payload_type(field_ref);
            if (ft != null && ft.kind == TypeKind::Int) {
                const ft_int: IntType* = ft as IntType*;
                signed_target = ft_int.int_kind.is_signed();
            }
            if (signed_target) {
                return this.cg.builder.build_sext(val, field_lty, "payload.widen");
            }
            return this.cg.builder.build_zext(val, field_lty, "payload.widen");
        }
        if (want_bits < got_bits) {
            return this.cg.builder.build_trunc(val, field_lty, "payload.trunc");
        }
        return val;
    }

    /// Look up a payload field's `Type`, following an `InstantiatedType`
    /// wrapper to its concrete spec'd struct. The wrapper reports size /
    /// alignment 0, so a multi-field payload offset computed off the wrapper
    /// would collapse onto its predecessor. Mirrors the same dereference in
    /// compute_enum_layout (type_map) so the store offsets match the alloc.
    resolve_payload_type(&this, ty: TypeRef) -> Type* {
        mut t: Type* = this.cg.lookup_type_by_id(ty.id);
        if (t != null && t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (inst.has_resolved_type()) {
                const resolved: Type* = this.cg.lookup_type_by_id(inst.resolved_type.id);
                if (resolved != null) { t = resolved; }
            }
        }
        return t;
    }
}
