/// Call Emitter
///
/// Lowering for `node.callee(args)` in all its shapes:
///   - bare-identifier call (`foo(x)`)             -> direct call after sema's mangled-callee
///   - method-on-object (`obj.method(x)`)          -> vtable dispatch when virtual
///   - scope-resolution call (`Mod::fn(x)`)        -> qualified resolver lookup
///   - class/struct construction (`Cls(args)`)     -> alloca + ctor invocation + load
///   - enum variant construction                   -> delegated to EnumVariantEmitter
///   - intrinsic call (`@-prefixed or builtins`)   -> inline IR via IntrinsicEmitter::try_emit
///   - divergent callee (`panic`)                   -> call followed by `unreachable`
///
/// Holds the full bundle of back-pointers needed to evaluate argument
/// expressions (`dispatch`), look up symbols (`cg.resolver`), and
/// construct enum variant values (`enum_variant`).  The visitor passes
/// itself as `ASTVisitor*` so element-expression evaluation can recurse
/// via `accept(visitor)` through `dispatch.codegen_rvalue`.

namespace Compiler::Codegen::Visit::CallEmitter;

import Compiler::Codegen;
import Compiler::Codegen::{ LLVMTypes, TypeMap, Abi, Context, Util };
import Compiler::Codegen::State::VisitorState;
import Compiler::Codegen::Visit::{ ExprDispatch, EnumVariantEmitter };
import Compiler::Codegen::Ops::IntrinsicsCodegen;
import Compiler::CompilationContext;
import Compiler::DeclIndex;
import Compiler::ModuleGraph;
import Compiler::Diag;
import Compiler::Diag::{ Diagnostic, SourceSpan };
import Compiler::Types;
import Compiler::Types::{
    TypeRef, Type, Arena, Compound, UserDefined, Generic,
    GenericRegistry, Ownership, Resolver
};
import Compiler::AST;
import Compiler::AST::{ Node, Visitor, Expression, Statement, Declaration };
import Compiler::Lex;
import Compiler::Resolver::{ SymbolStr, InternTable, QualifiedName, MangledName };
import std::collections::pair;


type struct CallEmitter {
    cg:           CodegenContext*;
    state:        VisitorState*;
    dispatch:     ExprDispatch*;
    enum_variant: EnumVariantEmitter*;

    /// Monotonic counter for naming the synthetic locals that hold enum
    /// payload pointers during drop-glue expansion (see emit_enum_drop_glue).
    glue_seq:     i64;

    static null() -> CallEmitter {
        return CallEmitter {
            cg:           null,
            state:        null,
            dispatch:     null,
            enum_variant: null,
            glue_seq:     0,
        };
    }

    wire(mut &this, cg: CodegenContext*, state: VisitorState*,
                    dispatch: ExprDispatch*, enum_variant: EnumVariantEmitter*) -> void {
        this.cg           = cg;
        this.state        = state;
        this.dispatch     = dispatch;
        this.enum_variant = enum_variant;
    }


    // Small helpers (inlined from IRGeneratorVisitor)

    /// Current LLVM function pointer for entry-block alloca placement.
    get_current_function(&this) -> LValue {
        const bb: LBasicBlock = this.cg.builder.get_insert_block();
        if (!bb.is_valid()) {
            this.cg.ctx.emit_error(ErrorCode::E0600_CODEGEN_FAILED,
                "codegen: builder has no insert block; cannot determine current function");
            return LValue::null();
        }
        return bb.get_parent();
    }


    /// Produce the ADDRESS of a value for auto-ref (a by-value argument
    /// passed to a `&T` parameter).  When `v` is a `load` instruction we
    /// recover its pointer operand - the original lvalue's address - so a
    /// `&mut` borrow sees the caller's storage.  Otherwise (rvalue: a
    /// literal, a global like a string constant, a computed value) we spill
    /// it to a fresh stack slot and return that slot's address.
    /// Stack slot for a value spilled so its address can be taken, allocated in
    /// the function's entry block so a spill inside a loop body doesn't grow
    /// the stack once per iteration.  Falls back to an in-place alloca when the
    /// insert block has no parent function.
    entry_spill_slot(&this, ty: LType, name: string) -> LValue {
        const bb: LBasicBlock = this.cg.builder.get_insert_block();
        if (bb.is_valid()) {
            const fn: LValue = bb.get_parent();
            if (fn.is_valid()) {
                const slot: LValue = this.cg.flow.create_entry_alloca(fn, name, ty);
                if (slot.is_valid()) { return slot; }
            }
        }
        return this.cg.builder.build_alloca(ty, name);
    }

    address_of_value(&this, v: LValue) -> LValue {
        // LLVMOpcode::Load == 27.  On non-instruction values (globals,
        // constants) GetInstructionOpcode won't return 27, so we fall
        // through to the spill path.
        const opcode: i32 = llvm::LLVMGetInstructionOpcode(v.raw);
        if (opcode == 27) {
            const operand: void* = llvm::LLVMGetOperand(v.raw, 0);
            if (operand != null) { return LValue { raw: operand }; }
        }
        const ty: LType = LType { raw: llvm::LLVMTypeOf(v.raw) };
        // Entry-block slot: allocas are only reclaimed at function exit, so
        // spilling here for a call inside a loop body would allocate a fresh
        // slot per iteration.  Only the alloca is hoisted - the store below
        // stays at the current insert point.
        const slot: LValue = this.entry_spill_slot(ty, "argref");
        this.cg.builder.build_store(v, slot);
        return slot;
    }


    // Main emit

    /// Lower `node.callee(args)` into LLVM IR.  Mirrors the visitor's
    /// `override visit(CallExprNode*)`; the visitor passes itself as
    /// `visitor: ASTVisitor*` so argument expressions can recurse via
    /// `accept(visitor)` through `dispatch.codegen_rvalue`.
    emit(mut &this, visitor: ASTVisitor*, node: CallExprNode*) -> void {
        mut callee_val: LValue = LValue::null();

        // Break pointer chains into locals (see the codegen helper note).
        const intern: InternTable* = this.cg.get_intern();

        // Virtual-dispatch state: populated in the MemberAccess branch when
        // the static receiver type declares virtual methods and the called
        // method has a vtable slot.  If set, after we emit arg evaluation
        // and fn_ty lookup, we replace `callee_val` with a vtable-indexed
        // function-pointer load instead of a direct call to the statically
        // resolved function.
        mut vtable_dispatch: boolean = false;
        mut vtable_slot_idx: i32 = -1;
        mut vtable_obj_ref: TypeRef = TypeRef::invalid();

        if (node.callee.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = node.callee as IdentifierNode*;

            // `try_catch(body, data)` - the catch_unwind primitive.  Needs an
            // `invoke` + a catch-all landing pad + a phi (control flow the
            // generic `try_emit` inline path cannot build), so it is special-
            // lowered here rather than through `IntrinsicKind`.  Handles both
            // the bare and `intrinsics::`-qualified call shapes (ScopeResolution
            // branch below).
            if (id.name.equals(intern.intern("try_catch"))) {
                this.emit_catch_unwind(visitor, node);
                return;
            }

            // Intrinsics first: `i32_to_i64`, `ptr_diff`, `bswap32`, etc.
            // are emitted as inline LLVM IR, not as real function calls,
            // so they have no LLVM definition.  If sema pinned
            // `resolved_callee` to an intrinsic's mangled name, the
            // module DOES contain an extern declaration (from
            // declare_function), but no module DEFINES the function;
            // calling it would emit a real call and the link step would
            // fail with `undefined reference`.  Run the inline dispatcher
            // up front to avoid that path.
            const intr_name_str: string = intern.resolve(id.name);
            // `IntrinsicKind::is_name` matches by leaf name only, and that set
            // is broader than the actual intrinsic declarations: it also covers
            // pure-magic forms (`rotl32`, `bswap32`, casts, ...) that are NOT
            // declared anywhere. Without the `user_shadow` guard a user/stdlib
            // function sharing an intrinsic's leaf name (e.g. sha1's `rotl32`)
            // would be silently replaced by inline IR and its body never run.
            // A pinned `resolved_callee` whose leaf is NOT a declared
            // `intrinsic function` is a real function: fall through to the
            // normal-call path below. Genuine intrinsics either have no
            // resolved_callee (pure-magic) or are declared intrinsics
            // (is_intrinsic_decl_name true), so both still inline here.
            const intr_user_shadow: boolean = node.resolved_callee.is_valid()
                && !this.cg.get_decl_index().is_intrinsic_decl_name(id.name);
            if (IntrinsicKind::is_name(intr_name_str) && !intr_user_shadow) {
                // `intr_args` is scoped to this branch: it is built and moved
                // into try_emit unconditionally here, so nothing is left
                // conditionally moved past the if.
                mut intr_args: LValue[] = [];
                for (mut ai: i64 = 0; ai < node.arguments.length; ai++) {
                    intr_args.push(this.dispatch.codegen_rvalue(visitor,node.arguments[ai]));
                }
                // `--panic=unwind` direct-panic drop-completeness: route the
                // panic funnel through an invoke + cleanup landing pad so the
                // frame's live droppable locals drop on unwind (the plain-call
                // `emit_panic_call` path bypasses the invoke-swap and leaks
                // them).  Gated on a hosted unwind build WITH live locals; every
                // other case falls through to the byte-identical `try_emit`
                // plain-call path below.
                if (id.name.equals(intern.intern("panic"))
                    && this.cg.ctx.project_panic_unwind
                    && !this.cg.intrinsics.no_runtime
                    && node.unwind_cleanup.length > 0
                    && intr_args.length >= 3) {
                    this.emit_panic_unwind(visitor, node,
                        intr_args[0], intr_args[1], intr_args[2]);
                    return;
                }
                match (this.cg.intrinsics.try_emit(intr_name_str, intr_args)) {
                    Option::Some(v) => {
                        this.state.last_value = v;
                        this.state.last_is_lvalue = false;
                        return;
                    }
                    Option::None => { }
                }
            }

            // Trust sema: `resolved_callee` is the mangled LLVM symbol
            // chosen by overload resolution (or, for unique-name
            // functions, the canonical mangling registered by
            // declare_function).  Sema runs
            // `try_pin_overload_mangled_callee` on every Identifier
            // call, so any function known to the DeclarationIndex
            // (qualified, bare-aliased, overloaded, or unique) gets
            // pinned to its registered mangled symbol.  Codegen calls
            // `resolve_function_by_mangled` once on that symbol; a
            // qualified/bare/DI-mapping cascade here would only re-resolve
            // names sema has already resolved.
            if (node.resolved_callee.is_valid()) {
                callee_val = this.cg.resolver.resolve_function_by_mangled(node.resolved_callee);
            }

            // 3b. Class / struct constructor call: `ClassName(args)` resolves
            //     to the method named `ClassName` on the class itself,
            //     registered as `{qualified_class}::ClassName`.  Sema sets
            //     the call's resolved_type to the class type for this form.
            //     Unlike the `new` form (which heap-allocates), this emits
            //     a stack-local construction: alloca the object, call the
            //     constructor with the alloca pointer as `this`, then load
            //     the populated value so the caller sees an rvalue of the
            //     class type.
            if (!callee_val.is_valid()) {
                const di: DeclarationIndex* = this.cg.get_decl_index();
                mut type_ref: TypeRef = di.lookup_type(id.name);
                mut ctor_qn: SymbolStr = SymbolStr::empty();
                if (type_ref.is_valid()) {
                    const arena: TypeArena* = this.cg.get_arena();
                    ctor_qn = arena.get_qualified_name(type_ref);
                }
                if (!ctor_qn.is_valid()) {
                    const resolved: SymbolStr = this.cg.ctx.resolve_scoped_or(id.name);
                    if (resolved.is_valid() && !resolved.equals(id.name)) {
                        ctor_qn = resolved;
                        // Refetch the type through the qualified alias
                        // (cross-module types only reachable via DI's
                        // bare->qualified map).
                        if (!type_ref.is_valid()) {
                            type_ref = di.lookup_type(ctor_qn);
                        }
                    }
                }
                if (ctor_qn.is_valid() && type_ref.is_valid()) {
                    const qn_str: string = intern.resolve(ctor_qn);
                    const bare_str: string = intern.resolve(id.name);
                    const combined: string = format("%s::%s", qn_str, bare_str);
                    const ctor_sym: SymbolStr = intern.intern(combined);
                    // Constructor LLVM arity = user args + 1 for `this`.
                    const ctor_arity: u32 = (node.arguments.length + 1) as u32;
                    mut ctor_fn: LValue = this.cg.resolver.resolve_function_with_arity(ctor_sym, ctor_arity);
                    if (!ctor_fn.is_valid()) {
                        ctor_fn = this.cg.resolver.resolve_function(ctor_sym);
                    }
                    if (ctor_fn.is_valid()) {
                        const mapped: LType = this.cg.type_mapper.map_type(type_ref);
                        const current_fn: LValue = this.get_current_function();
                        if (mapped.is_valid() && current_fn.is_valid()) {
                            const obj_alloca: LValue = this.cg.flow.create_entry_alloca(
                                current_fn, "ctor.tmp", mapped);
                            // Vtable slot for classes with virtual methods.
                            const t_for_vtbl: Type* = this.cg.lookup_type_by_id(type_ref.id);
                            if (t_for_vtbl != null && t_for_vtbl.kind == TypeKind::Class) {
                                const cls_vtbl: ClassType* = t_for_vtbl as ClassType*;
                                if (cls_vtbl.has_virtual_methods) {
                                    const qname: QualifiedName = QualifiedName::from_symbol(ctor_qn);
                                    const vtbl_name: string = MangledName::for_vtable(
                                        intern, qname).resolve(intern);
                                    mut vtbl_global: LValue = this.cg.llvm_module.get_named_global(vtbl_name);
                                    if (!vtbl_global.is_valid()) {
                                        // Cross-module reference: declare the
                                        // vtable as extern.  Mirrors the new-
                                        // expression path: the placeholder type
                                        // doesn't need to match the definition
                                        // exactly (opaque pointers), the linker
                                        // resolves by symbol name.  Without
                                        // this, constructor calls into a class
                                        // defined in another module skip the
                                        // vptr init entirely and any virtual
                                        // dispatch on the result reads garbage.
                                        const fn_ptr_ty: LType = LType::pointer_to(LType::i8());
                                        const placeholder_ty: LType = LType::array_of(fn_ptr_ty, 1);
                                        vtbl_global = this.cg.llvm_module.add_global(placeholder_ty, vtbl_name);
                                    }
                                    if (vtbl_global.is_valid()) {
                                        const vptr_slot: LValue = this.cg.builder.build_struct_gep(
                                            mapped, obj_alloca, 0, "vptr.slot");
                                        if (vptr_slot.is_valid()) {
                                            this.cg.builder.build_store(vtbl_global, vptr_slot);
                                        }
                                    }
                                }
                            }
                            const ctor_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(ctor_fn.raw) };
                            if (ctor_ty.is_valid() && LType::kind_of(ctor_ty.raw) == LTypeKind::Function) {
                                mut ctor_args: Pair<LValue, TypeRef>[] = [];
                                ctor_args.push(Pair<LValue, TypeRef>::new(obj_alloca, node.resolved_type));
                                for (mut ci: i64 = 0; ci < node.arguments.length; ci++) {
                                    const carg: LValue = this.dispatch.codegen_rvalue(visitor,node.arguments[ci]);
                                    ctor_args.push(Pair<LValue, TypeRef>::new(carg, node.arguments[ci].resolved_type));
                                }
                                mut ctor_res: LValue = LValue::null();
                                ctor_res = this.cg.expr_ops.codegen_call(ctor_fn, ctor_ty, ctor_args, "");
                            }
                            // Load the constructed value as the expression result.
                            const loaded: LValue = this.cg.builder.build_load(
                                mapped, obj_alloca, "ctor.val");
                            this.state.last_value = loaded;
                            this.state.last_is_lvalue = false;
                            return;
                        }
                    }
                }
            }

            // 4. Function-typed parameter: look in named_values (local scope).
            //    If the identifier refers to a parameter of function type,
            //    it will be stored as an alloca in named_values.  Load the
            //    function pointer and call through it.
            //    We must handle the call here because the loaded value is an
            //    instruction, not a GlobalValue; LLVMGlobalGetValueType
            //    would segfault on it.
            if (!callee_val.is_valid()) {
                const local: LValue = this.cg.values.get(id.name);
                if (local.is_valid()) {
                    // Build the LLVM function type from the Cryo FunctionType.
                    // Unwrap Pointer/Reference if the param type is &fn(...).
                    mut callee_type_ref: TypeRef = id.resolved_type;
                    mut callee_t: Type* = this.cg.lookup_type_by_id(callee_type_ref.id);
                    if (callee_t != null && callee_t.kind == TypeKind::Pointer) {
                        const pt: PointerType* = callee_t as PointerType*;
                        callee_type_ref = pt.pointee;
                        callee_t = this.cg.lookup_type_by_id(callee_type_ref.id);
                    } else if (callee_t != null && callee_t.kind == TypeKind::Reference) {
                        const rt: ReferenceType* = callee_t as ReferenceType*;
                        callee_type_ref = rt.referent;
                        callee_t = this.cg.lookup_type_by_id(callee_type_ref.id);
                    }
                    if (callee_t != null && callee_t.kind == TypeKind::Function) {
                        const ft: FunctionType* = callee_t as FunctionType*;
                        // Route the LLVM function type through the ABI seam
                        // so sret/byval lowering matches the callee - the
                        // callee here is a function pointer loaded from a
                        // local, so `LLVMIsAFunction(callee)` is null and
                        // the call-site attribute-query path can't recover
                        // the ABI on its own.  We compute the plan from
                        // the Cryo FunctionType and pass it explicitly via
                        // `codegen_call_with_plan`.
                        const plan: SignaturePlan = this.cg.abi.classify_signature(
                            ft.param_types, ft.return_type, false);
                        if (!plan.llvm_fn_type.is_valid()) {
                            this.state.last_value = LValue::null();
                            this.state.last_is_lvalue = false;
                            return;
                        }
                        const fn_type: LType = plan.llvm_fn_type;
                        // Map ret_ty for the void-name choice below; the
                        // seam used `void` when sret applied, otherwise
                        // the Direct return slot's type.
                        mut ret_ty: LType = LType::void_type();
                        if (!plan.sret_slot
                                && plan.return_plan.llvm_slots.length > 0) {
                            ret_ty = plan.return_plan.llvm_slots[0];
                        }
                        // Load the function pointer from the alloca.
                        const fn_ptr_llvm: LType = LType::pointer_to(LType::i8());
                        const fn_ptr: LValue = this.cg.builder.build_load(fn_ptr_llvm, local, "fn.ptr.load");
                        // Codegen arguments.
                        mut call_args: Pair<LValue, TypeRef>[] = [];
                        for (mut ai: i64 = 0; ai < node.arguments.length; ai++) {
                            const av: LValue = this.dispatch.codegen_rvalue(visitor,node.arguments[ai]);
                            call_args.push(Pair<LValue, TypeRef>::new(av, node.arguments[ai].resolved_type));
                        }
                        // Build the call via the plan-aware path so sret
                        // is marshalled and byval/sret attributes land on
                        // the call instruction.
                        const void_ty: LType = LType::void_type();
                        const call_name: string = if (ret_ty.raw == void_ty.raw) { "" } else { "calltmp" };
                        mut call_result: LValue = LValue::null();
                        call_result = this.cg.expr_ops.codegen_call_with_plan(
                            fn_ptr, fn_type, plan, call_args, call_name);
                        this.state.last_value = call_result;
                        this.state.last_is_lvalue = false;
                        return;
                    }
                }
            }
        } else if (node.callee.kind == NodeKind::ScopeResolution) {
            // Scope resolution: e.g., LValue::null(), TypeRef::invalid().
            // The scope name may be bare (LValue) while the function was
            // registered under the qualified type name.
            // Resolve the scope name through the DI type map to get the
            // qualified type name, then build the combined key.
            const sr: ScopeResolutionNode* = node.callee as ScopeResolutionNode*;
            const di: DeclarationIndex* = this.cg.get_decl_index();

            // `intrinsics::try_catch(body, data)` - the catch_unwind primitive.
            // See the Identifier-branch twin for why this is special-lowered.
            if (sr.member_name.equals(intern.intern("try_catch"))) {
                this.emit_catch_unwind(visitor, node);
                return;
            }

            // Inline-lower intrinsics referenced via a namespace prefix
            // (e.g., `intrinsics::fpclass`, `intrinsics::ptr_diff`).  The
            // leaf name uniquely identifies the intrinsic; the prefix is
            // ignored because intrinsics live in the global LLVM namespace,
            // not in the source-level module they were declared in.  Run
            // BEFORE the resolved_callee lookup: sema pins
            // `intrinsics::ptr_diff` as a qualified callee symbol, and the
            // declaration table would happily declare it as an extern,
            // causing the linker to look for a real `ptr_diff` symbol that
            // doesn't exist (intrinsics are lowered inline, never linked).
            const sr_leaf_str: string = intern.resolve(sr.member_name);
            // Same guard as the Identifier branch: a qualified call whose leaf
            // collides with an intrinsic name (e.g. `mymod::rotl32`) but
            // resolves to a real, non-intrinsic function must NOT be replaced
            // by inline IR. Genuine `intrinsics::<name>` calls are either
            // pure-magic (no resolved_callee) or declared intrinsics
            // (is_intrinsic_decl_name true), so they still inline.
            const sr_user_shadow: boolean = node.resolved_callee.is_valid()
                && !di.is_intrinsic_decl_name(sr.member_name);
            if (IntrinsicKind::is_name(sr_leaf_str) && !sr_user_shadow) {
                mut sr_args: LValue[] = [];
                for (mut sai: i64 = 0; sai < node.arguments.length; sai++) {
                    sr_args.push(this.dispatch.codegen_rvalue(visitor,node.arguments[sai]));
                }
                // `--panic=unwind` direct-panic drop-completeness (mirrors the
                // Identifier branch): `intrinsics::panic(...)` / `core::panic`'s
                // inner call arrive here as a ScopeResolution intrinsic.  Route
                // through invoke + cleanup pad when the frame has live locals.
                if (sr.member_name.equals(intern.intern("panic"))
                    && this.cg.ctx.project_panic_unwind
                    && !this.cg.intrinsics.no_runtime
                    && node.unwind_cleanup.length > 0
                    && sr_args.length >= 3) {
                    this.emit_panic_unwind(visitor, node,
                        sr_args[0], sr_args[1], sr_args[2]);
                    return;
                }
                match (this.cg.intrinsics.try_emit(sr_leaf_str, sr_args)) {
                    Option::Some(v) => {
                        this.state.last_value = v;
                        this.state.last_is_lvalue = false;
                        return;
                    }
                    Option::None => { }
                }
            }

            // Sema-pinned callee: set by the monomorphizer's body walk
            // for generic free-function calls (`mem::offset(p, n)`,
            // `Layout::array<T>(n)`) AND by sema's `try_resolve_*` static-
            // method / module-function / cimport-function paths.  Routes
            // through `resolve_function_by_mangled`, identical to the
            // Identifier branch.  The fallback chain below still runs for
            // call shapes sema doesn't yet pin (the spec-first lookup
            // based on `node.resolved_type`, enum-variant constructors).
            if (node.resolved_callee.is_valid()) {
                callee_val = this.cg.resolver.resolve_function_by_mangled(node.resolved_callee);
            }

            // Resolve the scope name (e.g., "LValue") to its qualified form
            // (e.g., "Compiler::Codegen::LLVMTypes::LValue") via the DI mapping.
            const resolved_scope: SymbolStr = this.cg.ctx.resolve_scoped_or(sr.scope_name);
            const scope_str: string = intern.resolve(resolved_scope);
            const sr_arity: u32 = node.arguments.length as u32;

            // Spec-first: when `node.resolved_type` is a generic instantiation,
            // the call resolves to the spec'd method (e.g.
            // `Map<string, Argument>::new`), not the bare template (`Map::new`).
            // The bare template is also registered in the DI when the source
            // contains `type struct Map<K,V> { static new() ... }`; the inner
            // `Map` return type resolves to the bare struct, and a bare-mangled
            // declaration ends up in the function table.  Without trying the
            // spec name first, the bare-name lookup at the next step finds
            // that template and emits a call to a symbol nobody defines.
            mut conc_ref0: TypeRef = node.resolved_type;
            mut conc_t0: Type* = this.cg.lookup_type_by_id(conc_ref0.id);
            mut fc0: i32 = 0;
            while (conc_t0 != null && conc_t0.kind == TypeKind::InstantiatedType && fc0 < 5) {
                const ci0: InstantiatedType* = conc_t0 as InstantiatedType*;
                if (ci0.has_resolved_type()) {
                    conc_ref0 = ci0.resolved_type;
                    conc_t0 = this.cg.lookup_type_by_id(conc_ref0.id);
                } else { break; }
                fc0 += 1;
            }
            if (conc_t0 != null) {
                mut conc_name0: string = "";
                if (conc_t0.kind == TypeKind::Struct) {
                    const cst0: StructType* = conc_t0 as StructType*;
                    conc_name0 = intern.resolve(cst0.qualified_name);
                } else if (conc_t0.kind == TypeKind::Class) {
                    const cct0: ClassType* = conc_t0 as ClassType*;
                    conc_name0 = intern.resolve(cct0.qualified_name);
                } else if (conc_t0.kind == TypeKind::Enum) {
                    const cet0: EnumType* = conc_t0 as EnumType*;
                    conc_name0 = intern.resolve(cet0.qualified_name);
                } else if (conc_t0.kind == TypeKind::InstantiatedType) {
                    // Unresolved InstantiatedType: sema's expected_type
                    // fallback returned a generic instantiation that the
                    // monomorphizer hadn't yet pinned to its spec struct
                    // when codegen ran. Compute the deterministic spec
                    // mangled name from `(generic_base, type_args)` and
                    // try to find the registered spec method directly.
                    const ci_unres: InstantiatedType* = conc_t0 as InstantiatedType*;
                    const base_qname: SymbolStr = this.cg.get_arena().get_qualified_name(
                        ci_unres.generic_base);
                    if (base_qname.is_valid()) {
                        const base_qn: QualifiedName = QualifiedName::from_symbol(base_qname);
                        const spec_sym: SymbolStr = MangledName::specialized_identifier(
                            this.cg.get_intern(), this.cg.get_arena(), base_qn,
                            ci_unres.type_args);
                        if (spec_sym.is_valid()) {
                            conc_name0 = intern.resolve(spec_sym);
                        }
                    }
                }
                // Don't overwrite a callee_val that the resolved_callee path
                // already produced; the monomorphizer's pin is authoritative
                // for spec'd generic free-function callees, and rebuilding the
                // lookup key from `node.resolved_type` (the call's return type)
                // collapses spec'd static methods like `Layout::array<Point>`
                // to the bare-template `Layout::array` symbol.
                if (!callee_val.is_valid() && conc_name0.length() > 0) {
                    const member_str0: string = intern.resolve(sr.member_name);
                    const conc_combined0: string = format("%s::%s", conc_name0, member_str0);
                    const conc_sym0: SymbolStr = intern.intern(conc_combined0);
                    callee_val = this.cg.resolver.resolve_function_with_arity(conc_sym0, sr_arity);
                    if (!callee_val.is_valid()) {
                        callee_val = this.cg.resolver.resolve_function(conc_sym0);
                    }
                }
            }

            // Post-substitution combined-key lookup: in spec'd function
            // bodies, AST substituter rewrites `sr.scope_name` from
            // `String` to the bare-leaf spec form (`6String$L...$G`).
            // Sema's pin was on the pre-substitution template form
            // (`String::method`) and the substituter doesn't update
            // `resolved_callee`, so when codegen lands on this branch the
            // pinned symbol is for a function that only exists at
            // template time.  `di.resolve_qualified(sr.scope_name)` maps
            // the bare-leaf spec back to its fully-qualified arena name
            // (registered by specialization.cryo), and the combined
            // `<qualified>::<method>` lookup finds the spec's LLVM
            // symbol.  Sema upstreams the non-spec case via pinned
            // `resolved_callee`; this branch covers the spec-context
            // lookups until AST cloning clears stale callee pins.
            if (!callee_val.is_valid()) {
                const combined: string = format("%s::%s", scope_str, intern.resolve(sr.member_name));
                const sym: SymbolStr = intern.intern(combined);
                callee_val = this.cg.resolver.resolve_function_with_arity(sym, sr_arity);
                if (!callee_val.is_valid()) {
                    callee_val = this.cg.resolver.resolve_function(sym);
                }
            }

            // Module-graph walk: when source writes a shorthand path like
            // `libc::read` or `CHeaderImport::run`, find every module
            // whose namespace ends with `::scope_str` (or equals it).
            // Sema's `resolve_module_qualified_function` mirrors this and
            // pins resolved_callee for non-spec cases; this branch covers
            // call sites whose scope name was substituted (where sema's
            // pin is for the template form) or otherwise didn't pin.
            if (!callee_val.is_valid()) {
                const matches: SymbolStr[] = CallEmitter::collect_namespace_suffix_matches(
                    this.cg, intern, scope_str, sr.member_name, sr_arity);
                if (matches.length == 1) {
                    callee_val = this.cg.resolver.resolve_function_with_arity(matches[0], sr_arity);
                    if (!callee_val.is_valid()) {
                        callee_val = this.cg.resolver.resolve_function(matches[0]);
                    }
                } else if (matches.length > 1) {
                    mut detail: string = "";
                    for (mut k: i64 = 0; k < matches.length; k++) {
                        const alt_str: string = intern.resolve(matches[k]);
                        if (k == 0) { detail = format("  - `%s`", alt_str); }
                        else        { detail = format("%s\n  - `%s`", detail, alt_str); }
                    }
                    const msg: string = format(
                        "ambiguous call `%s::%s`: %lld modules match the namespace suffix `%s` and define `%s`\n%s",
                        scope_str, intern.resolve(sr.member_name),
                        matches.length, scope_str, intern.resolve(sr.member_name), detail);
                    this.cg.diag.emit_error_at_span(
                        ErrorCode::E0154_AMBIGUOUS_CALL, msg, node.span);
                    this.state.last_value = LValue::null();
                    this.state.last_is_lvalue = false;
                    return;
                }
            }

            // Fallback 1: try the bare member name.  Extern "C" functions
            // (e.g., llvm::LLVMGetTypeKind) are registered under their
            // unqualified C name, not the scope-qualified form.
            // Use arity-aware lookup first to discriminate between overloads
            // that share a bare name (e.g., the `read` intrinsic vs the free
            // `std::fs::file::read(path: string)`, both reachable under bare
            // "read" via type_resolution's bare-alias registration).
            if (!callee_val.is_valid()) {
                callee_val = this.cg.resolver.resolve_function_with_arity(sr.member_name, sr_arity);
                if (!callee_val.is_valid()) {
                    callee_val = this.cg.resolver.resolve_function(sr.member_name);
                }
            }

            // If the function wasn't found, check if this is an enum variant
            // constructor (e.g., Option::Some, Result::Ok).  Enum constructors
            // are not registered as functions; synthesize the value inline.
            // Use node.resolved_type (the sema-resolved result type of the call)
            // to find the concrete monomorphized enum, not the scope name
            // (which may still be the generic "Option" template name).
            if (!callee_val.is_valid()) {
                mut real_ref: TypeRef = node.resolved_type;
                mut real_t: Type* = this.cg.lookup_type_by_id(real_ref.id);
                // Follow InstantiatedType chain (may be multiple levels deep).
                mut follow_count: i32 = 0;
                while (real_t != null && real_t.kind == TypeKind::InstantiatedType && follow_count < 5) {
                    const inst: InstantiatedType* = real_t as InstantiatedType*;
                    if (inst.has_resolved_type()) {
                        real_ref = inst.resolved_type;
                        real_t = this.cg.lookup_type_by_id(real_ref.id);
                    } else {
                        break;
                    }
                    follow_count += 1;
                }
                // Also try: the scope name might resolve to a type directly
                // (for cases where resolved_type isn't set on the call node).
                if (real_t == null || (real_t.kind != TypeKind::Enum && real_t.kind != TypeKind::Struct)) {
                    const scope_ref: TypeRef = di.lookup_type(resolved_scope);
                    if (scope_ref.is_valid()) {
                        real_ref = scope_ref;
                        real_t = this.cg.lookup_type_by_id(real_ref.id);
                        mut sc: i32 = 0;
                        while (real_t != null && real_t.kind == TypeKind::InstantiatedType && sc < 5) {
                            const sinst: InstantiatedType* = real_t as InstantiatedType*;
                            if (sinst.has_resolved_type()) {
                                real_ref = sinst.resolved_type;
                                real_t = this.cg.lookup_type_by_id(real_ref.id);
                            } else { break; }
                            sc += 1;
                        }
                    }
                }
                if (real_t != null && real_t.kind == TypeKind::Enum) {
                    const et: EnumType* = real_t as EnumType*;
                    const variant: EnumVariantInfo* = et.get_variant(sr.member_name);
                    if (variant != null) {
                        // Codegen the arguments first.
                        mut vargs: LValue[] = [];
                        for (mut ai: i64 = 0; ai < node.arguments.length; ai++) {
                            vargs.push(this.dispatch.codegen_rvalue(visitor,node.arguments[ai]));
                        }
                        const result: LValue = this.enum_variant.build(et, variant, real_ref, vargs);
                        this.state.last_value = result;
                        this.state.last_is_lvalue = false;
                        return;
                    }
                }
            }
        } else if (node.callee.kind == NodeKind::MemberAccess) {
            // Member access: sema's `resolve_method_overload` pins the
            // mangled LLVM callee on `resolved_callee` for inherent
            // class/struct/enum methods AND for trait-impl methods on
            // non-generic receivers.  Codegen detects the function-
            // pointer-field shortcut, picks up virtual-dispatch state for
            // class receivers, then routes the pinned symbol through
            // `resolve_function_by_mangled`.  The post-specialization
            // fallback at the bottom covers methods on spec'd receivers
            // (InstantiatedType, where sema runs before monomorphization
            // and the receiver's concrete spec name doesn't exist yet).
            const ma: MemberAccessNode* = node.callee as MemberAccessNode*;
            const di: DeclarationIndex* = this.cg.get_decl_index();
            const method_str: string = intern.resolve(ma.member);

            // Function-pointer field call: `receiver.field(args)` where
            // `field` has a Function type.  Sema sets
            // `ma.resolved_type` to that Function; we load the field then
            // call indirectly through the loaded pointer.  Without this,
            // codegen would chase method lookups and bottom out on
            // "no method found" for every callback-style stdlib field.
            mut ma_callee_t: Type* = this.cg.lookup_type_by_id(ma.resolved_type.id);
            // Unwrap pointer/reference to match how function-typed fields
            // land; `fn(...) -> T` stores as a raw function-pointer so the
            // member may resolve to a Function type directly.
            mut ma_fn_type: FunctionType* = null;
            if (ma_callee_t != null && ma_callee_t.kind == TypeKind::Function) {
                ma_fn_type = ma_callee_t as FunctionType*;
            } else if (ma_callee_t != null && ma_callee_t.kind == TypeKind::Pointer) {
                const ppt: PointerType* = ma_callee_t as PointerType*;
                const pin: Type* = this.cg.lookup_type_by_id(ppt.pointee.id);
                if (pin != null && pin.kind == TypeKind::Function) {
                    ma_fn_type = pin as FunctionType*;
                }
            }
            if (ma_fn_type != null) {
                const ft: FunctionType* = ma_fn_type;
                // Route the LLVM function type through the ABI seam so
                // sret/byval lowering matches the callee.  See the
                // sibling fn-pointer site higher in this file for the
                // full rationale; same situation here - the callee is
                // a function pointer loaded from a struct field.
                const plan: SignaturePlan = this.cg.abi.classify_signature(
                    ft.param_types, ft.return_type, false);
                if (!plan.llvm_fn_type.is_valid()) {
                    this.state.last_value = LValue::null();
                    this.state.last_is_lvalue = false;
                    return;
                }
                const llvm_fn_type: LType = plan.llvm_fn_type;
                mut ret_ty: LType = LType::void_type();
                if (!plan.sret_slot
                        && plan.return_plan.llvm_slots.length > 0) {
                    ret_ty = plan.return_plan.llvm_slots[0];
                }
                // Load the fn-pointer value from the field (rvalue).
                const fn_ptr: LValue = this.dispatch.codegen_rvalue(visitor,ma);
                if (!fn_ptr.is_valid()) {
                    this.state.last_value = LValue::null();
                    this.state.last_is_lvalue = false;
                    return;
                }
                // Codegen user args (no implicit `this`; the fn-pointer field
                // is a plain function, not a bound method).
                mut fnp_args: Pair<LValue, TypeRef>[] = [];
                for (mut ai: i64 = 0; ai < node.arguments.length; ai++) {
                    const av: LValue = this.dispatch.codegen_rvalue(visitor,node.arguments[ai]);
                    fnp_args.push(Pair<LValue, TypeRef>::new(av, node.arguments[ai].resolved_type));
                }
                const void_ty: LType = LType::void_type();
                const call_name: string = if (ret_ty.raw == void_ty.raw) { "" } else { "calltmp" };
                mut call_result: LValue = LValue::null();
                call_result = this.cg.expr_ops.codegen_call_with_plan(
                    fn_ptr, llvm_fn_type, plan, fnp_args, call_name);
                this.state.last_value = call_result;
                this.state.last_is_lvalue = false;
                return;
            }

            // Get the object's type, unwrapping pointer/reference.
            mut obj_ref: TypeRef = ma.object.resolved_type;
            mut t: Type* = this.cg.lookup_type_by_id(obj_ref.id);
            if (t != null && t.kind == TypeKind::Pointer) {
                const ptr_t: PointerType* = t as PointerType*;
                obj_ref = ptr_t.pointee;
                t = this.cg.lookup_type_by_id(obj_ref.id);
            } else if (t != null && t.kind == TypeKind::Reference) {
                const ref_t: ReferenceType* = t as ReferenceType*;
                obj_ref = ref_t.referent;
                t = this.cg.lookup_type_by_id(obj_ref.id);
            }

            // Follow InstantiatedType chain to get the concrete type's TypeRef.
            mut inst_depth: i32 = 0;
            while (t != null && t.kind == TypeKind::InstantiatedType && inst_depth < 5) {
                const inst: InstantiatedType* = t as InstantiatedType*;
                if (inst.has_resolved_type()) {
                    obj_ref = inst.resolved_type;
                    t = this.cg.lookup_type_by_id(obj_ref.id);
                } else { break; }
                inst_depth += 1;
            }

            // Also unwrap pointer/reference AFTER InstantiatedType unwrap
            // (some monomorphized types resolve to Pointer<ConcreteStruct>).
            if (t != null && t.kind == TypeKind::Pointer) {
                const ptr_t2: PointerType* = t as PointerType*;
                obj_ref = ptr_t2.pointee;
                t = this.cg.lookup_type_by_id(obj_ref.id);
            } else if (t != null && t.kind == TypeKind::Reference) {
                const ref_t2: ReferenceType* = t as ReferenceType*;
                obj_ref = ref_t2.referent;
                t = this.cg.lookup_type_by_id(obj_ref.id);
            }

            // Use DI type_reverse to get the type's registered name,
            // then look up "QualifiedType::method" in the function map.
            // For ArrayType, use the element-type -> Array_<T> mapping
            // since ArrayType TypeRefs are not canonical.  Only used by
            // the post-specialization fallback below (when sema's pin
            // was empty or its symbol isn't in the LLVM module).
            mut type_sym: SymbolStr = di.lookup_type_name(obj_ref);
            if (!type_sym.is_valid() && t != null && t.kind == TypeKind::Array) {
                const arr_t: ArrayType* = t as ArrayType*;
                // Only dynamic arrays share the `Array_<T>` method registry -
                // fixed-size `T[N]` has no methods of its own and must not be
                // dispatched to `Array<T>::method` (e.g. `Array<T>::drop` would
                // try to free a stack address).  Leaving type_sym empty for
                // T[N] lets `.drop()` fall through to the drop-glue fallback,
                // which synthesizes per-element drops.
                if (arr_t.is_dynamic()) {
                    type_sym = di.lookup_array_type_name(arr_t.element);
                }
            }

            // Check for virtual dispatch: if the STATIC receiver type is a
            // class with virtual methods and sema has resolved this call
            // to a specific method declaration, dispatch indirectly through
            // the object's vtable pointer.  We use the static type (rather
            // than walking to the most-derived type) because the vtable
            // layout is defined by the static type's declaration order;
            // subclass vtables are inheritance-complete, so `slot[idx]`
            // resolves correctly at runtime to whatever override the
            // dynamic type installed.  The slot key is (name, param_types)
            // read directly from sema's resolved method; no string
            // matching, no guessing at arg-type display names, no chance
            // of collapsing overloads.
            if (t != null && t.kind == TypeKind::Class &&
                node.resolved_method != null) {
                const cls_for_vtbl: ClassType* = t as ClassType*;
                if (cls_for_vtbl.has_virtual_methods) {
                    const rm: MethodNode* = node.resolved_method as MethodNode*;
                    if (rm != null && rm.func != null) {
                        const fn_node: FunctionDeclNode* = rm.func;
                        // Extract the resolved method's declared param
                        // types (skipping self) in exact declaration order.
                        mut rm_params: TypeRef[] = [];
                        const this_amp: SymbolStr = intern.intern("&this");
                        const this_val: SymbolStr = intern.intern("this");
                        for (mut pi: i64 = 0; pi < fn_node.parameters.length; pi++) {
                            const pp: VarDeclNode* = fn_node.parameters[pi];
                            if (pp == null) { continue; }
                            if (pp.name.equals(this_amp)) { continue; }
                            if (pp.name.equals(this_val)) { continue; }
                            rm_params.push(pp.resolved_type);
                        }
                        const slot_idx: i32 = this.cg.decl.vtable_slot_index(cls_for_vtbl, fn_node.name, rm_params);
                        if (slot_idx >= 0) {
                            vtable_dispatch = true;
                            vtable_slot_idx = slot_idx;
                            vtable_obj_ref = obj_ref;
                        }
                    }
                }
            }

            // Instance-method calls prepend `&this` at the call site, so the
            // LLVM arity is user-args + 1.  This matches declare_method's
            // `total_params` registration key.
            const ma_arity: u32 = (node.arguments.length + 1) as u32;

            // Trust sema: `resolved_callee` is the mangled LLVM symbol
            // chosen by `resolve_method_overload` for inherent methods on
            // classes / structs / enums (including the base-class walk
            // for inheritance) AND for trait-impl methods on non-generic
            // receivers (e.g. `String::write_bytes` from `implement trait
            // FmtWrite for String`, or primitive trait impls like
            // `Eq for i16`).  Routes through `resolve_function_by_mangled`,
            // identical to the Identifier branch.
            if (node.resolved_callee.is_valid()) {
                callee_val = this.cg.resolver.resolve_function_by_mangled(node.resolved_callee);
                // Method-spec-args ($MG) reconciliation.  A generic INHERENT method
                // spec is emitted under a `$MG<args>$`-disambiguated symbol (see
                // MangledName::with_method_spec_args, fed `func.spec_type_args` by
                // both mono's call-site pin and the codegen definition).  But some
                // resolution paths pin `resolved_callee` to the UNSUFFIXED base
                // method mangle - notably when a call is resolved to an
                // already-monomorphized generic method after mono ran (e.g.
                // `String<GlobalAlloc>`'s `FmtWrite::write_str` calling
                // `this.try_push<Str>`, reached via the injected owner-module spec).
                // The base symbol then misses the emitted `$MG` definition, and the
                // name+arity fallback below would pick a WRONG sibling spec
                // (try_push<Str> -> try_push<i32>, corrupting all formatting).  The
                // call still carries its concrete method type-args on
                // `resolved_type_args`; reconstruct the `$MG` symbol from them and
                // retry.  No-op for non-generic calls (empty args) and for symbols
                // that already resolved.
                if (!callee_val.is_valid() && node.resolved_type_args.length > 0) {
                    const base_mg: MangledName = MangledName { value: node.resolved_callee };
                    const mg: MangledName = base_mg.with_method_spec_args(
                        intern, this.cg.get_arena(), node.resolved_type_args);
                    if (!mg.value.equals(node.resolved_callee)) {
                        callee_val = this.cg.resolver.resolve_function_by_mangled(mg.value);
                    }
                }
            }

            // Post-specialization fallback: when the receiver is a
            // monomorphized InstantiatedType (e.g. `Array<u8, GlobalAlloc>`
            // inside a spec'd `String<GlobalAlloc>::with_capacity`), sema's
            // pin uses the TEMPLATE's mangled symbol, which doesn't exist
            // in the LLVM module (only specs are emitted).  Re-resolve via
            // the post-substitution receiver type name registered in the
            // DI: `lookup_type_name(obj_ref)` returns the spec's qname
            // (e.g. `Array_u8_GlobalAlloc`) and the combined
            // `<spec_qname>::<method>` lookup finds the spec'd LLVM symbol.
            //
            // Long-term: move this into a post-monomorphization re-pin
            // pass that updates `resolved_callee` after AST substitution.
            // Until then this branch handles the spec'd-receiver case.
            if (!callee_val.is_valid() && type_sym.is_valid()) {
                const type_str: string = intern.resolve(type_sym);
                const combined: string = format("%s::%s", type_str, method_str);
                const sym: SymbolStr = intern.intern(combined);
                callee_val = this.cg.resolver.resolve_function_with_arity(sym, ma_arity);
                if (!callee_val.is_valid()) {
                    callee_val = this.cg.resolver.resolve_function(sym);
                }
            }
            if (!callee_val.is_valid() && t != null) {
                mut type_str: string = "";
                if (t.kind == TypeKind::Struct) {
                    const st: StructType* = t as StructType*;
                    type_str = intern.resolve(st.qualified_name);
                } else if (t.kind == TypeKind::Class) {
                    const ct: ClassType* = t as ClassType*;
                    type_str = intern.resolve(ct.qualified_name);
                } else if (t.kind == TypeKind::Enum) {
                    const et: EnumType* = t as EnumType*;
                    type_str = intern.resolve(et.qualified_name);
                } else if (t.kind == TypeKind::Int
                        || t.kind == TypeKind::Float
                        || t.kind == TypeKind::Bool
                        || t.kind == TypeKind::Char
                        || t.kind == TypeKind::String
                        || t.kind == TypeKind::Unit) {
                    // Primitives have no `qualified_name`; the trait-
                    // impl registry keys on the bare display name.
                    type_str = t.display_name();
                }
                if (type_str.length() > 0) {
                    const combined: string = format("%s::%s", type_str, method_str);
                    const sym: SymbolStr = intern.intern(combined);
                    callee_val = this.cg.resolver.resolve_function_with_arity(sym, ma_arity);
                    if (!callee_val.is_valid()) {
                        callee_val = this.cg.resolver.resolve_function(sym);
                    }
                }
            }

        } else {
            callee_val = this.dispatch.codegen_rvalue(visitor,node.callee);
        }

        if (!callee_val.is_valid()) {
            // A `.drop()` on a `Copy` receiver is a no-op: a bitwise-duplicable
            // value owns no resources, so there is nothing to release.  Copy
            // types deliberately carry no `drop` method (having one would make
            // them non-Copy), so the call legitimately fails to resolve - emit
            // nothing rather than erroring.  This is what lets a generic
            // `where T: Drop` container instantiate for a Copy element type:
            // e.g. `Array<PodType>::drop`, whose body calls `element.drop()`
            // per slot before freeing the buffer.  Gated on `Copy` so a failed
            // drop resolution on a genuinely-owning type still surfaces.
            if (node.callee.kind == NodeKind::MemberAccess) {
                const dma: MemberAccessNode* = node.callee as MemberAccessNode*;
                const drop_sym: SymbolStr = intern.intern("drop");
                if (dma.member.equals(drop_sym)
                        && OwnershipQuery::is_copy(this.cg.get_arena(),
                               this.cg.ctx.generic_registry,
                               this.cg.get_intern(),
                               dma.object.resolved_type)) {
                    this.state.last_value = LValue::null();
                    this.state.last_is_lvalue = false;
                    return;
                }
                // Drop glue: a `.drop()` on a non-Copy aggregate that carries
                // no user-written drop (so resolution failed) is expanded into
                // in-place drops of its droppable parts.  Reuses the same
                // `.drop()` lowering recursively (a field that itself lacks a
                // user drop re-enters this path).  In-place + idempotent leaf
                // drops mean re-dropping an already-released part is a no-op.
                if (dma.member.equals(drop_sym)
                        && OwnershipQuery::needs_drop(this.cg.get_arena(),
                               this.cg.ctx.generic_registry,
                               this.cg.get_intern(),
                               dma.object.resolved_type)) {
                    if (this.emit_drop_glue(visitor, dma.object,
                                            dma.object.resolved_type)) {
                        this.state.last_value = LValue::null();
                        this.state.last_is_lvalue = false;
                        return;
                    }
                }
            }

            // Build a rich diagnostic that names the callee (when available)
            // and labels the receiver for member/scope calls.
            mut msg: string = "codegen: call expression: callee function not found";
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0636_UNDEFINED_FUNCTION_CALL, msg);
            diag = diag.at(node.span);

            if (node.callee.kind == NodeKind::Identifier) {
                const id: IdentifierNode* = node.callee as IdentifierNode*;
                const id_str: string = this.cg.resolve(id.name);
                diag = Diagnostic::error(ErrorCode::E0636_UNDEFINED_FUNCTION_CALL,
                    format("codegen: cannot resolve function '%s'", id_str));
                diag = diag.at(node.span);
                diag = diag.also_at(node.callee.span, "no function with this name is in scope");
            } else if (node.callee.kind == NodeKind::ScopeResolution) {
                const sr: ScopeResolutionNode* = node.callee as ScopeResolutionNode*;
                const scope_str: string = intern.resolve(sr.scope_name);
                const member_str: string = intern.resolve(sr.member_name);
                diag = Diagnostic::error(ErrorCode::E0636_UNDEFINED_FUNCTION_CALL,
                    format("codegen: cannot resolve '%s::%s'", scope_str, member_str));
                diag = diag.at(node.span);
                diag = diag.also_at(node.callee.span, "no such associated function");
            } else if (node.callee.kind == NodeKind::MemberAccess) {
                const ma: MemberAccessNode* = node.callee as MemberAccessNode*;
                // Render via the arena's recursive resolver so a generic
                // receiver prints as e.g. `Box<Thing, GlobalAlloc>` rather
                // than the raw arena ids the InstantiatedType's own
                // display_name() falls back to.
                mut type_str: string = "<unknown>";
                const dbg_arena: TypeArena* = this.cg.get_arena();
                if (dbg_arena != null && ma.object.resolved_type.is_valid()) {
                    type_str = dbg_arena.resolve_display_name(ma.object.resolved_type.id);
                }
                const member_str: string = intern.resolve(ma.member);
                diag = Diagnostic::error(ErrorCode::E0636_UNDEFINED_FUNCTION_CALL,
                    format("codegen: no method '%s' found on type '%s'", member_str, type_str));
                diag = diag.at(node.span);
                diag = diag.also_at(ma.object.span, format("receiver has type '%s'", type_str));
                diag = diag.with_note("method lookup walks the class inheritance chain; neither the concrete type nor any base defines this method");
            }

            this.cg.diag.emit(diag);
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        // `Pair<LValue, TypeRef>` per arg; the type drives sext-vs-zext
        // when codegen_call needs to widen a narrow integer to the formal
        // param's LLVM width.  Receivers are pointer/reference-typed and
        // never hit the integer-widening path, but we record the receiver
        // type anyway to keep the array meaningful end-to-end.
        mut args: Pair<LValue, TypeRef>[] = [];
        if (node.callee.kind == NodeKind::MemberAccess) {
            const ma: MemberAccessNode* = node.callee as MemberAccessNode*;
            // For pointer/reference receivers (e.g. `runner: Runner*`),
            // the receiver value is itself the `this` pointer; load it
            // out of the local slot.  For value receivers (`runner: Runner`),
            // take the lvalue address as `this`.
            const recv_t: Type* = this.cg.lookup_type_by_id(ma.object.resolved_type.id);
            mut obj: LValue = LValue::null();
            if (recv_t != null && (recv_t.kind == TypeKind::Pointer
                                || recv_t.kind == TypeKind::Reference)) {
                obj = this.dispatch.codegen_rvalue(visitor,ma.object);
            } else {
                obj = this.dispatch.codegen_lvalue(visitor,ma.object);
                // A value-typed receiver that is an rvalue - a literal
                // (`"x".method()`), a call result, or a method-chain result
                // (`a.f().g()`) - has no backing storage, so `codegen_lvalue`
                // hands back the VALUE rather than an address.  Using that as
                // `&this` is one indirection short and crashes the callee.
                // Spill it to a fresh slot so `this` points at real memory.
                if (obj.is_valid() && !this.state.last_is_lvalue) {
                    const recv_ty: LType = LType { raw: llvm::LLVMTypeOf(obj.raw) };
                    const recv_slot: LValue = this.entry_spill_slot(recv_ty, "recvtmp");
                    this.cg.builder.build_store(obj, recv_slot);
                    obj = recv_slot;
                }
            }
            args.push(Pair<LValue, TypeRef>::new(obj, ma.object.resolved_type));
        }
        // Win64: an argument bound to a `va_list` parameter must be passed BY
        // VALUE (a `char*`), but the program holds the ADDRESS of the va_list
        // storage (`VaArgs::as_ptr` / the `args` bucket lower to `char**`).  Load
        // the stored `char*` out via the ABI seam for each such argument so an
        // imported C `v*` consumer reads from the right slot instead of one
        // indirection off.  `va_forward_fn_type` returns null on SysV-amd64 and
        // for method calls, leaving the loop byte-identical there.
        const va_ft: FunctionType* = this.va_forward_fn_type(node);
        for (mut i: i64 = 0; i < node.arguments.length; i++) {
            mut arg: LValue = this.dispatch.codegen_rvalue(visitor,node.arguments[i]);
            // Auto-ref: sema flagged this by-value argument as bound to a
            // reference (`&T`) parameter, so pass the value's ADDRESS, not
            // the value itself.  Without this, a scalar would be `inttoptr`'d
            // and a pointer-shaped value (`string`) passed one indirection
            // short, then dereferenced by the callee -> crash.
            if (node.arguments[i].autoref && arg.is_valid()) {
                arg = this.address_of_value(arg);
            }
            if (va_ft != null && i < va_ft.param_types.length && arg.is_valid()) {
                const pt: Type* = this.cg.lookup_type_by_id(va_ft.param_types[i].id);
                if (pt != null && pt.kind == TypeKind::VaList) {
                    arg = this.cg.abi.forward_va_list(&this.cg.builder, arg);
                }
            }
            args.push(Pair<LValue, TypeRef>::new(arg, node.arguments[i].resolved_type));
        }

        const fn_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(callee_val.raw) };
        if (!fn_ty.is_valid()) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0602_INVALID_LLVM_TYPE,
                "codegen: call expression: failed to retrieve function type from callee",
                node.span);
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        // Virtual dispatch: replace the direct callee with a vtable-loaded
        // function pointer.  We keep `fn_ty` from the statically resolved
        // function; it describes the correct signature for `LLVMBuildCall2`
        // and matches whatever override got installed in the slot at
        // runtime (since all overrides share the base's signature).
        if (vtable_dispatch && args.length > 0 && args[0].first.is_valid() && vtable_obj_ref.is_valid()) {
            const class_lty: LType = this.cg.type_mapper.map_type(vtable_obj_ref);
            if (class_lty.is_valid()) {
                const vptr_slot: LValue = this.cg.builder.build_struct_gep(
                    class_lty, args[0].first, 0, "vptr.slot");
                if (vptr_slot.is_valid()) {
                    const i8_ptr_ty: LType = LType::pointer_to(LType::i8());
                    const i8_ptr_ptr_ty: LType = LType::pointer_to(i8_ptr_ty);
                    const vtbl: LValue = this.cg.builder.build_load(
                        i8_ptr_ptr_ty, vptr_slot, "vtbl");
                    if (vtbl.is_valid()) {
                        const idx_val: LValue = LType::const_int(
                            LType::i32(), vtable_slot_idx as u64, false);
                        const idx_buf: void* = intrinsics::malloc(8);
                        const idx_slots: void** = idx_buf as void**;
                        idx_slots[0] = idx_val.raw;
                        const fn_slot: LValue = this.cg.builder.build_gep(
                            i8_ptr_ty, vtbl, idx_buf, 1, "vtbl.slot");
                        intrinsics::free(idx_buf);
                        if (fn_slot.is_valid()) {
                            const fn_ptr: LValue = this.cg.builder.build_load(
                                i8_ptr_ty, fn_slot, "vtbl.fn");
                            if (fn_ptr.is_valid()) {
                                callee_val = fn_ptr;
                            }
                        }
                    }
                }
            }
        }

        const ret_ty: LType = this.cg.type_mapper.map_type(node.resolved_type);
        const void_ty: LType = LType::void_type();
        // Void calls and unresolved return types must use empty name;
        // LLVM doesn't allow naming void-typed instructions.  The ABI/
        // definition side (`abi.cryo` classify, `declaration_emitter`)
        // lowers a `Unit`/`Void`/`Never` return to an LLVM `void`-returning
        // function, but `map_type(Unit)` yields an empty `{}` struct (the
        // value representation of unit), not LLVM void.  Keying `is_void`
        // off the mapped LLVM type alone therefore names the call
        // instruction for a unit return (e.g. `Result<(), E>::expect`),
        // which LLVM rejects: "Instruction has a name, but provides a void
        // value!".  Detect the void-returning ABI from the source-level
        // return-type kind to stay in lockstep with the definition side.
        mut ret_kind_is_void: boolean = false;
        if (node.resolved_type.is_valid()) {
            const _rt: Type* = this.cg.lookup_type_by_id(node.resolved_type.id);
            if (_rt != null && (_rt.kind == TypeKind::Unit
                                || _rt.kind == TypeKind::Void
                                || _rt.kind == TypeKind::Never)) {
                ret_kind_is_void = true;
            }
        }
        const is_void: boolean = !ret_ty.is_valid() || ret_ty.raw == void_ty.raw ||
                                  LType::kind_of(ret_ty.raw) == LTypeKind::Void ||
                                  ret_kind_is_void;
        const call_name: string = if (is_void) { "" } else { "calltmp" };
        mut result: LValue = LValue::null();
        // Under `--panic=unwind`, a call whose frame has live droppable locals
        // must be an `invoke`: on unwind, control lands in a cleanup landing pad
        // that drops those locals (innermost-first) then `resume`s into the
        // caller.  DropInsertion recorded the cumulative schedule on
        // `node.unwind_cleanup`; it is empty on the default abort path, so the
        // else-branch below emits the identical plain `call` there.
        const needs_invoke: boolean = this.cg.ctx.project_panic_unwind
            && node.unwind_cleanup.length > 0;
        if (needs_invoke) {
            const cur_fn: LValue = this.get_current_function();
            if (cur_fn.is_valid()) {
                const cont_bb: LBasicBlock = LBasicBlock::append(cur_fn, "invoke.cont");
                const lpad_bb: LBasicBlock = LBasicBlock::append(cur_fn, "invoke.lpad");
                this.cg.expr_ops.invoke_active = true;
                this.cg.expr_ops.invoke_normal = cont_bb;
                this.cg.expr_ops.invoke_lpad   = lpad_bb;
                result = this.cg.expr_ops.codegen_call(callee_val, fn_ty, args, call_name);
                // Clear defensively in case an upstream error path returned
                // before any callee call armed and consumed the flag.
                this.cg.expr_ops.invoke_active = false;
                this.emit_cleanup_landingpad(visitor, node, cur_fn, lpad_bb);
                // `build_call_maybe_invoke` left the builder at `cont_bb`; the
                // return coercion and any `unreachable` below emit there.
            } else {
                result = this.cg.expr_ops.codegen_call(callee_val, fn_ty, args, call_name);
            }
        } else {
            result = this.cg.expr_ops.codegen_call(callee_val, fn_ty, args, call_name);
        }

        // Phase 3 - small-aggregate return coercion.  When the callee
        // was declared with a register-shaped return (Direct-with-
        // coercion for <= 8 byte aggregates, or DirectPair wrapped in
        // an anonymous `{lo, hi}` literal struct for 9-16 byte
        // aggregates), the call instruction yields a different LLVM
        // type than the source struct.  Bridge the gap by spilling the
        // value through a stack temp and re-loading it at the source
        // struct type; both layouts agree byte-for-byte by
        // construction, so the store-then-load round-trips correctly
        // (this is the inverse of the coercion the callee will do on
        // its return).  Phase 1 sret is already handled inside
        // `codegen_call` (returns a struct value loaded from the sret
        // slot whose type matches the expected struct), so the
        // equal-types short-circuit below skips this path there.
        if (result.is_valid() && node.resolved_type.is_valid()) {
            const got_raw: void* = llvm::LLVMTypeOf(result.raw);
            const expected_lty: LType = this.cg.type_mapper.map_type(node.resolved_type);
            const got_kind: LTypeKind = LType::kind_of(got_raw);
            // Detect a coercion-needed mismatch.  The call result type
            // differs from the source-level expected type for any
            // Direct-with-coercion or DirectPair return; reshape via
            // spill-then-reload at the expected type.  Same-handle (no
            // classification mismatch) returns skip the coerce.
            const needs_coerce: boolean = expected_lty.is_valid()
                && got_raw != expected_lty.raw
                && (got_kind == LTypeKind::Integer
                    || got_kind == LTypeKind::Struct
                    || got_kind == LTypeKind::Float
                    || got_kind == LTypeKind::Double
                    || got_kind == LTypeKind::Vector)
                && LType::kind_of(expected_lty.raw) == LTypeKind::Struct;
            if (needs_coerce) {
                const cur_bb_c: LBasicBlock = this.cg.builder.get_insert_block();
                if (cur_bb_c.is_valid()) {
                    const fn_c: LValue = cur_bb_c.get_parent();
                    if (fn_c.is_valid()) {
                        // Alloca with the LARGER of the two sizes so
                        // the store of the (possibly padded) DirectPair
                        // never writes past the slot.  Both shapes
                        // describe the same source-level value so
                        // their storage sizes agree in practice, but
                        // padding rules differ between a named struct
                        // with field alignment and an anonymous
                        // `{i64, i32}` whose tail packs the leftover
                        // bytes only - alloca'ing as the call-result
                        // type and reloading as the source type
                        // covers both directions safely.
                        const got_lty: LType = LType { raw: got_raw };
                        const slot_c: LValue = this.cg.flow.create_entry_alloca(
                            fn_c, "ret.coerce", got_lty);
                        this.cg.builder.build_store(result, slot_c);
                        result = this.cg.builder.build_load(
                            expected_lty, slot_c, "ret.coerced");
                    }
                }
            }
        }

        // Emit `unreachable` after a call to a divergent function - one
        // whose resolved return type is `never` (e.g. `core::panic` /
        // `intrinsics::panic`). Without this, a divergent call in a
        // non-void-returning context (e.g. the `None` arm of
        // `Option<T>::unwrap`) leaves the block without a terminator and
        // the body-validator strips the entire function.
        mut should_unreachable: boolean = false;
        if (node.resolved_type.is_valid()) {
            const _ret_t: Type* = this.cg.lookup_type_by_id(node.resolved_type.id);
            if (_ret_t != null && _ret_t.kind == TypeKind::Never) {
                should_unreachable = true;
            }
        }
        if (should_unreachable) {
            this.cg.builder.build_unreachable();
        }

        this.state.last_value = result;
        this.state.last_is_lvalue = false;
    }

    /// Emit the cleanup landing pad for an `invoke` under `--panic=unwind`.
    /// Builds the `{ ptr, i32 }` `landingpad` at the head of `lpad_bb`
    /// (cleanup-only: no catch clause, so the personality runs destructors and
    /// keeps unwinding rather than catching here), replays the call's drop
    /// schedule (`node.unwind_cleanup`, innermost-first) so live locals are
    /// freed on the unwind path, then `resume`s into the caller's frame.
    /// Attaches `__cryo_personality_v0` to the enclosing function (idempotent).
    /// The builder is restored to the block it was called in (the invoke's
    /// normal continuation) so normal-path codegen resumes there.
    ///
    /// The `landingpad` must be the first instruction in `lpad_bb`, so it is
    /// emitted before the drops; the drops themselves may open init-flag
    /// branches, leaving the builder at a later merge block, so `resume` is
    /// emitted wherever the last drop left off (still dominated by the
    /// landingpad, which is legal).
    emit_cleanup_landingpad(mut &this, visitor: ASTVisitor*, node: CallExprNode*,
                            cur_fn: LValue, lpad_bb: LBasicBlock) -> void {
        this.emit_cleanup_landingpad_sched(visitor, &node.unwind_cleanup, cur_fn, lpad_bb);
    }

    /// Schedule-driven core of `emit_cleanup_landingpad`.  Takes the drop
    /// schedule directly (rather than reading it off a `CallExprNode`) so panic
    /// origins that are NOT ordinary calls - a direct `panic()`, a synthesized
    /// bounds/overflow/div-zero/no-match check - reuse the identical cleanup
    /// landing pad. `sched` is a pointer to the origin node's cumulative
    /// drop-schedule array (innermost-first, each a synthesized drop-call
    /// statement up-cast to `ASTNode*`).
    emit_cleanup_landingpad_sched(mut &this, visitor: ASTVisitor*, sched: ASTNode*[]*,
                                  cur_fn: LValue, lpad_bb: LBasicBlock) -> void {
        const saved_bb: LBasicBlock = this.cg.builder.get_insert_block();

        // Any function with a landing pad needs the personality attached.
        const pers: LValue = this.cg.expr_ops.get_or_decl_personality();
        if (pers.is_valid()) { cur_fn.set_personality_fn(pers); }

        this.cg.builder.position_at_end(lpad_bb);
        const lpad_ty: LType = this.cg.expr_ops.landingpad_type();
        const lp: LValue = this.cg.builder.build_landing_pad(lpad_ty, 0, "lpad");
        lp.set_cleanup(true);

        // Replay the cumulative drop schedule (each a synthesized drop-call
        // statement, up-cast to `ASTNode*` on the node to dodge the
        // Expr<->Stmt import cycle).  Plain calls: `invoke_active` is clear, so
        // a drop that itself unwinds propagates without re-entering this pad.
        for (mut i: i64 = 0; i < sched.length; i++) {
            const d: ASTNode* = sched[i];
            if (d != null) { (d as StatementNode*).accept(visitor); }
        }

        this.cg.builder.build_resume(lp);

        if (saved_bb.is_valid()) { this.cg.builder.position_at_end(saved_bb); }
    }

    /// Direct-panic origin under `--panic=unwind`: emit the raising
    /// `__cryo_panic(msg,file,line)` funnel as an `invoke` into a cleanup
    /// landing pad that drops the frame's live locals (innermost-first) before
    /// the unwind continues, then `resume`s.  Without this the panic intrinsic
    /// lowers to a plain `call` (`emit_panic_call`) that bypasses the ordinary
    /// call's invoke-swap, so a droppable local live at the panic point leaks.
    /// Reuses `node.unwind_cleanup` (DropInsertion populates it for EVERY call,
    /// panic included).  Only taken when the frame has live droppable locals and
    /// the hosted raising funnel applies; the plain-call fast-path (empty
    /// schedule / abort mode / freestanding trap) stays byte-identical through
    /// `emit_panic_call`.
    emit_panic_unwind(mut &this, visitor: ASTVisitor*, node: CallExprNode*,
                      msg: LValue, file: LValue, line: LValue) -> void {
        const cur_fn: LValue = this.get_current_function();
        if (!cur_fn.is_valid()) {
            // No enclosing function to hang a landing pad on; diverge plainly.
            this.cg.intrinsics.emit_panic_call(msg, file, line);
            return;
        }
        const cont_bb: LBasicBlock = LBasicBlock::append(cur_fn, "panic.cont");
        const lpad_bb: LBasicBlock = LBasicBlock::append(cur_fn, "panic.lpad");

        const panic_fn: LValue = this.cg.intrinsics.get_or_decl_cryo_panic();
        const fty: LType = LType { raw: llvm::LLVMGlobalGetValueType(panic_fn.raw) };
        const arg_buf: void* = intrinsics::malloc(24);
        const arg_slots: void** = arg_buf as void**;
        arg_slots[0] = msg.raw;
        arg_slots[1] = file.raw;
        arg_slots[2] = line.raw;

        // Arm the invoke swap so `build_call_maybe_invoke` emits
        // `invoke @__cryo_panic(...) to cont unwind lpad` and leaves the builder
        // at `cont`.
        this.cg.expr_ops.invoke_active = true;
        this.cg.expr_ops.invoke_normal = cont_bb;
        this.cg.expr_ops.invoke_lpad   = lpad_bb;
        this.cg.expr_ops.build_call_maybe_invoke(fty, panic_fn, arg_buf, 3, "");
        this.cg.expr_ops.invoke_active = false;
        intrinsics::free(arg_buf);

        // The funnel is noreturn: its invoke normal-dest is unreachable.
        this.cg.builder.build_unreachable();

        // Cleanup pad: drop the frame's live locals, then resume the unwind.
        this.emit_cleanup_landingpad(visitor, node, cur_fn, lpad_bb);

        this.state.last_value = LValue::null();
        this.state.last_is_lvalue = false;
    }

    /// Lower the `try_catch(body, data)` catch_unwind primitive.  `body` is an
    /// opaque `(void*) -> void` trampoline (the stdlib `catch_unwind` wrapper
    /// builds it, capturing the real body fn-ptr + the result slot in `data`),
    /// so this lowering needs no knowledge of the caught value's type.
    ///
    /// Under `--panic=unwind`:
    ///   invoke body(data) to cu.cont unwind cu.lpad
    /// cu.cont:  br cu.done                        ; body returned normally
    /// cu.lpad:  landingpad {ptr,i32} catch null   ; a panic unwound to here
    ///           br cu.done
    /// cu.done:  %caught = phi i1 [false,cu.cont],[true,cu.lpad]
    /// yielding `%caught` (boolean).  The pad is catch-all + UNCONDITIONAL (it
    /// never inspects the selector): every Cryo panic that unwinds this far is
    /// caught.  Attaching a catch clause here is what makes this frame the
    /// Itanium phase-1 handler, so the intermediate frames' cleanup landing
    /// pads (Phase C) actually run their drops in phase 2.
    ///
    /// `catch_unwind` requires `--panic=unwind`: it is meaningless under the
    /// abort strategy (a panic terminates the process rather than unwinding, so
    /// there is nothing to catch) and its runtime payload accessors live only in
    /// the unwind tier.  Off `--panic=unwind` this is a clear compile error
    /// rather than a plain call that would fail to link with undefined
    /// `__cryo_panic_taken_*` symbols.  The default path never reaches here (the
    /// stdlib `catch_unwind` is generic and uninstantiated unless a program
    /// calls it), so this leaves the default IR byte-identical.
    emit_catch_unwind(mut &this, visitor: ASTVisitor*, node: CallExprNode*) -> void {
        if (node.arguments.length != 2) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0636_UNDEFINED_FUNCTION_CALL,
                "codegen: try_catch expects exactly two arguments (body, data)",
                node.span);
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        if (!this.cg.ctx.project_panic_unwind) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0600_CODEGEN_FAILED,
                "`catch_unwind` requires the unwinding panic strategy; rebuild with `--panic=unwind` (or set `panic = \"unwind\"` in cryoconfig). Under the default `--panic=abort` a panic terminates the process, so there is nothing to catch.",
                node.span);
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        const body_ptr: LValue = this.dispatch.codegen_rvalue(visitor, node.arguments[0]);
        const data_ptr: LValue = this.dispatch.codegen_rvalue(visitor, node.arguments[1]);
        if (!body_ptr.is_valid() || !data_ptr.is_valid()) {
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        // Trampoline LLVM type: `void (ptr)`.
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const param_buf: void* = intrinsics::malloc(8);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ptr_ty.raw;
        const body_fty: LType = LType::function_type(LType::void_type(), param_buf, 1, false);
        intrinsics::free(param_buf);

        const arg_buf: void* = intrinsics::malloc(8);
        const arg_slots: void** = arg_buf as void**;
        arg_slots[0] = data_ptr.raw;

        const bool_ty: LType = LType::i1();

        const cur_fn: LValue = this.get_current_function();
        if (!cur_fn.is_valid()) {
            intrinsics::free(arg_buf);
            this.state.last_value = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        const cont_bb: LBasicBlock = LBasicBlock::append(cur_fn, "cu.cont");
        const lpad_bb: LBasicBlock = LBasicBlock::append(cur_fn, "cu.lpad");
        const done_bb: LBasicBlock = LBasicBlock::append(cur_fn, "cu.done");

        // Any function with a landing pad needs the personality attached.
        const pers: LValue = this.cg.expr_ops.get_or_decl_personality();
        if (pers.is_valid()) { cur_fn.set_personality_fn(pers); }

        // `invoke` is a terminator; the builder must be repositioned to a real
        // block before any further emission (done below at cont_bb).
        this.cg.builder.build_invoke(body_fty, body_ptr, arg_buf, 1, cont_bb, lpad_bb, "");
        intrinsics::free(arg_buf);

        const false_val: LValue = LType::const_int(bool_ty, 0, false);
        const true_val: LValue = LType::const_int(bool_ty, 1, false);

        // Normal edge: body returned; nothing was caught.
        this.cg.builder.position_at_end(cont_bb);
        this.cg.builder.build_br(done_bb);

        // Unwind edge: catch-all landing pad.  The landingpad must be the first
        // non-phi instruction in the block.  No `set_cleanup` - the catch
        // clause alone makes this the phase-1 handler.
        this.cg.builder.position_at_end(lpad_bb);
        const lpad_ty: LType = this.cg.expr_ops.landingpad_type();
        const lp: LValue = this.cg.builder.build_landing_pad(lpad_ty, 1, "cu.eh");
        lp.add_clause(LType::const_pointer_null(ptr_ty));
        this.cg.builder.build_br(done_bb);

        // Merge: caught flag.
        this.cg.builder.position_at_end(done_bb);
        const phi: LValue = this.cg.builder.build_phi(bool_ty, "cu.caught");
        const vals_buf: void* = intrinsics::malloc(16);
        const vals: void** = vals_buf as void**;
        vals[0] = false_val.raw;
        vals[1] = true_val.raw;
        const blks_buf: void* = intrinsics::malloc(16);
        const blks: void** = blks_buf as void**;
        blks[0] = cont_bb.raw;
        blks[1] = lpad_bb.raw;
        phi.add_incoming(vals_buf, blks_buf, 2);
        intrinsics::free(vals_buf);
        intrinsics::free(blks_buf);

        this.state.last_value = phi;
        this.state.last_is_lvalue = false;
    }

    /// The callee's Cryo `FunctionType` when an argument MIGHT need the Win64
    /// `va_list` by-value forwarding load (see the argument loop), else null.
    ///
    /// Gated so the argument loop is byte-identical everywhere it does not
    /// apply: returns null off Win64 (SysV passes the `__va_list_tag[1]` pointer
    /// directly, which already IS the by-value form), and null for method calls
    /// (a `MemberAccess` callee) - methods never take `va_list`, and skipping
    /// them keeps `node.arguments[i]` aligned with `param_types[i]` without a
    /// receiver offset.  `va_list` parameters therefore only arise on the
    /// free/extern call paths handled here.
    va_forward_fn_type(mut &this, node: CallExprNode*) -> FunctionType* {
        if (!this.cg.abi.is_win64()) { return null; }
        if (node.callee == null) { return null; }
        // The callee's bare name keys its `FunctionType` in the DeclarationIndex.
        // Only free / extern-"C" callees (bare identifier or `Scope::member`)
        // carry a `va_list` parameter; methods (`MemberAccess`) never do, so we
        // skip them - which also keeps `node.arguments[i]` aligned with
        // `param_types[i]` (no receiver in the parameter list).
        mut name: SymbolStr = SymbolStr::empty();
        if (node.callee.kind == NodeKind::Identifier) {
            name = (node.callee as IdentifierNode*).name;
        } else if (node.callee.kind == NodeKind::ScopeResolution) {
            name = (node.callee as ScopeResolutionNode*).member_name;
        } else {
            return null;
        }
        if (!name.is_valid()) { return null; }
        const di: DeclarationIndex* = this.cg.get_decl_index();
        if (di == null) { return null; }
        const ft_ref: TypeRef = di.lookup_func_type(name);
        if (!ft_ref.is_valid()) { return null; }
        const ct: Type* = this.cg.lookup_type_by_id(ft_ref.id);
        if (ct == null || ct.kind != TypeKind::Function) { return null; }
        return ct as FunctionType*;
    }

    /// Drop-glue expansion for an aggregate with no user-written `drop`.
    /// Returns true when the receiver type is a kind glue handles, so the
    /// caller suppresses the "no method" error.  Structs/classes recurse
    /// into each droppable field in place; other aggregate kinds are not yet
    /// expanded and return true as a no-op (keeping today's behavior).
    emit_drop_glue(mut &this, visitor: ASTVisitor*, receiver: ExpressionNode*,
                   ty: TypeRef) -> boolean {
        const arena: TypeArena* = this.cg.get_arena();
        if (arena == null) { return false; }

        // Peel InstantiatedType wrappers to the concrete underlying type.
        mut cur: TypeRef = ty;
        mut t: Type* = arena.lookup(cur.id);
        mut guard: i32 = 0;
        while (t != null && t.kind == TypeKind::InstantiatedType && guard < 16) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (!inst.has_resolved_type()) { break; }
            cur = inst.resolved_type;
            t = arena.lookup(cur.id);
            guard = guard + 1;
        }
        if (t == null) { return false; }

        if (t.kind == TypeKind::Struct) {
            const st: StructType* = t as StructType*;
            this.emit_field_drops(visitor, receiver, st.fields);
            return true;
        }
        if (t.kind == TypeKind::Class) {
            const ct: ClassType* = t as ClassType*;
            this.emit_field_drops(visitor, receiver, ct.fields);
            return true;
        }
        if (t.kind == TypeKind::Enum) {
            const et: EnumType* = t as EnumType*;
            this.emit_enum_drop_glue(visitor, receiver, et, cur);
            return true;
        }
        if (t.kind == TypeKind::Array) {
            const at: ArrayType* = t as ArrayType*;
            // Dynamic arrays own their heap buffer via the Array<T> Drop impl
            // (caught upstream by method resolution); only bare fixed-size
            // arrays reach here.  Drop each element in place.
            if (at.is_fixed() &&
                OwnershipQuery::needs_drop(arena, this.cg.ctx.generic_registry,
                                           this.cg.get_intern(), at.element)) {
                this.emit_fixed_array_drops(visitor, receiver, at);
            }
            return true;
        }
        if (t.kind == TypeKind::Tuple) {
            const tt: TupleType* = t as TupleType*;
            this.emit_tuple_element_drops(visitor, receiver, tt);
            return true;
        }
        // User-written `T?` desugars to Option<T> (an Enum, handled above), so
        // no Optional type reaches here; anything else that does owns nothing.
        return true;
    }

    /// Drop each owning element of a tuple in place via synthesized
    /// `receiver.N.drop()` calls.  Tuple positional access is a member access
    /// whose member symbol is the decimal index (see `place_emitter`'s Tuple
    /// branch), so the element access is built exactly like a struct field's
    /// and re-enters the normal `.drop()` lowering - elements without a user
    /// drop recurse back through glue.
    emit_tuple_element_drops(mut &this, visitor: ASTVisitor*,
                             receiver: ExpressionNode*, tt: TupleType*) -> void {
        if (tt == null) { return; }
        const arena: TypeArena* = this.cg.get_arena();
        if (arena == null) { return; }
        const registry: GenericRegistry* = this.cg.ctx.generic_registry;
        const intern: InternTable* = this.cg.get_intern();
        const drop_sym: SymbolStr = intern.intern("drop");
        for (mut i: i64 = 0; i < tt.elements.length; i++) {
            const elem_type: TypeRef = tt.elements[i];
            if (!OwnershipQuery::needs_drop(arena, registry, intern, elem_type)) {
                continue;
            }
            const idx_sym: SymbolStr = intern.intern(format("%ld", i));
            mut elem_access: MemberAccessNode* = new MemberAccessNode(
                receiver, idx_sym, receiver.span, receiver.span);
            elem_access.set_resolved_type(elem_type);
            mut drop_access: MemberAccessNode* = new MemberAccessNode(
                elem_access as ExpressionNode*, drop_sym,
                receiver.span, receiver.span);
            mut call: CallExprNode* = new CallExprNode(
                drop_access as ExpressionNode*, receiver.span);
            mut stmt: ExprStmtNode* = new ExprStmtNode(
                call as ExpressionNode*, receiver.span);
            stmt.accept(visitor);
        }
    }

    /// Drop each element of a fixed-size array in place via synthesized
    /// `receiver[i].drop()` calls.  Re-enters the normal `.drop()` lowering
    /// per element, so elements that themselves lack a user drop recurse
    /// through glue (e.g. an array of structs of strings drops every string).
    emit_fixed_array_drops(mut &this, visitor: ASTVisitor*,
                           receiver: ExpressionNode*, at: ArrayType*) -> void {
        if (at == null) { return; }
        const arena: TypeArena* = this.cg.get_arena();
        if (arena == null) { return; }
        const intern: InternTable* = this.cg.get_intern();
        const drop_sym: SymbolStr = intern.intern("drop");
        const idx_type: TypeRef = arena.get_i64();
        const n: i64 = at.size;
        for (mut i: i64 = 0; i < n; i++) {
            const idx_str: string = format("%ld", i);
            mut idx_lit: LiteralNode* = new LiteralNode(
                idx_str, LiteralKind::Integer, receiver.span);
            idx_lit.set_resolved_type(idx_type);
            mut arr_access: ArrayAccessNode* = new ArrayAccessNode(
                receiver, idx_lit as ExpressionNode*, receiver.span);
            arr_access.set_resolved_type(at.element);
            mut drop_access: MemberAccessNode* = new MemberAccessNode(
                arr_access as ExpressionNode*, drop_sym,
                receiver.span, receiver.span);
            mut call: CallExprNode* = new CallExprNode(
                drop_access as ExpressionNode*, receiver.span);
            mut stmt: ExprStmtNode* = new ExprStmtNode(
                call as ExpressionNode*, receiver.span);
            stmt.accept(visitor);
        }
    }

    /// Synthesize `receiver.field.drop()` for each field whose type needs
    /// drop, routed through the normal `.drop()` lowering (which handles user
    /// drops, Copy no-ops, and recursive glue).  In place: the member access
    /// yields a pointer into the receiver, so a leaf drop nulls that storage
    /// and any later re-drop is a no-op.
    emit_field_drops(mut &this, visitor: ASTVisitor*, receiver: ExpressionNode*,
                     fields: &FieldInfo[]) -> void {
        const arena: TypeArena* = this.cg.get_arena();
        const registry: GenericRegistry* = this.cg.ctx.generic_registry;
        const intern: InternTable* = this.cg.get_intern();
        const drop_sym: SymbolStr = intern.intern("drop");
        for (mut i: i64 = 0; i < fields.length; i++) {
            const f: FieldInfo = fields[i];
            if (!OwnershipQuery::needs_drop(arena, registry, intern, f.field_type)) {
                continue;
            }
            mut field_access: MemberAccessNode* = new MemberAccessNode(
                receiver, f.name, receiver.span, receiver.span);
            field_access.set_resolved_type(f.field_type);
            mut drop_access: MemberAccessNode* = new MemberAccessNode(
                field_access as ExpressionNode*, drop_sym,
                receiver.span, receiver.span);
            mut call: CallExprNode* = new CallExprNode(
                drop_access as ExpressionNode*, receiver.span);
            mut stmt: ExprStmtNode* = new ExprStmtNode(
                call as ExpressionNode*, receiver.span);
            stmt.accept(visitor);
        }
    }

    /// Drop-glue for an enum with no user drop: switch on the discriminant
    /// and drop the active variant's droppable payload(s) in place.  Mirrors
    /// the tag-load + payload-GEP machinery in PatternEmitter; each payload is
    /// registered as a synthetic named lvalue and dropped via the normal
    /// `.drop()` lowering (so a payload that itself lacks a user drop recurses
    /// through glue).  `enum_ref` is the concrete (peeled) enum TypeRef.
    emit_enum_drop_glue(mut &this, visitor: ASTVisitor*, receiver: ExpressionNode*,
                        et: EnumType*, enum_ref: TypeRef) -> void {
        if (et == null) { return; }
        if (et.is_simple_enum()) { return; }   // no payloads -> nothing to drop

        const arena: TypeArena* = this.cg.get_arena();
        const registry: GenericRegistry* = this.cg.ctx.generic_registry;
        const intern: InternTable* = this.cg.get_intern();
        const drop_sym: SymbolStr = intern.intern("drop");

        // Count variants with at least one droppable payload (switch arity).
        mut ndrop: u32 = 0;
        for (mut vi: i64 = 0; vi < et.variants.length; vi++) {
            if (OwnershipQuery::any_needs_drop(arena, registry, intern,
                    et.variants[vi].payload_types, 0)) {
                ndrop = ndrop + 1;
            }
        }
        if (ndrop == 0) { return; }

        // Borrow the receiver's storage (a pointer into it; never a copy).
        const subject_ptr: LValue = this.dispatch.codegen_lvalue(visitor, receiver);
        if (!subject_ptr.is_valid()) { return; }
        const enum_llvm: LType = this.cg.type_mapper.map_type(enum_ref);
        if (!enum_llvm.is_valid()) { return; }

        // tag = enum.0 ; payload base = enum.1
        const tag_ptr: LValue = this.cg.builder.build_struct_gep(
            enum_llvm, subject_ptr, 0, "glue.tag.ptr");
        if (!tag_ptr.is_valid()) { return; }
        const tag: LValue = this.cg.builder.build_load(LType::i32(), tag_ptr, "glue.tag");
        const payload_ptr: LValue = this.cg.builder.build_struct_gep(
            enum_llvm, subject_ptr, 1, "glue.payload.ptr");
        if (!payload_ptr.is_valid()) { return; }

        const cur_bb: LBasicBlock = this.cg.builder.get_insert_block();
        if (!cur_bb.is_valid()) { return; }
        const fn: LValue = cur_bb.get_parent();
        const after_bb: LBasicBlock = LBasicBlock::append(fn, "glue.after");
        const sw: LValue = this.cg.builder.build_switch(tag, after_bb, ndrop);

        for (mut vi: i64 = 0; vi < et.variants.length; vi++) {
            const v: &EnumVariantInfo = &et.variants[vi];
            if (!OwnershipQuery::any_needs_drop(arena, registry, intern,
                    v.payload_types, 0)) {
                continue;   // C-style / all-Copy payloads: default arm (after_bb)
            }
            const drop_bb: LBasicBlock = LBasicBlock::append(fn, "glue.vdrop");
            sw.add_case(LType::const_int(LType::i32(), v.tag_value, false), drop_bb);
            this.cg.builder.position_at_end(drop_bb);

            // Field offsets from the single layout authority
            // (TypeArena::variant_payload_layout) - the SAME align-up
            // offsets construction stored the fields at.  The packed
            // running sum this replaced dropped e.g. `V(u32, String)`'s
            // String from packed offset 4 while construction wrote it at
            // aligned offset 8 - freeing a garbage pointer.
            const offsets: u64[] = arena.variant_payload_layout(v, null, null);
            for (mut pos: i64 = 0; pos < v.payload_types.length; pos++) {
                const pt: TypeRef = v.payload_types[pos];
                if (OwnershipQuery::needs_drop(arena, registry, intern, pt)) {
                    // field_ptr = payload base + offsets[pos] (byte offset)
                    mut field_ptr_raw: LValue = payload_ptr;
                    if (offsets[pos] != 0) {
                        const byte_off: LValue = LType::const_int(LType::i64(), offsets[pos], false);
                        const obuf: void* = intrinsics::malloc(8);
                        const obuf_arr: void** = obuf as void**;
                        obuf_arr[0] = byte_off.raw;
                        field_ptr_raw = this.cg.builder.build_gep(
                            LType::i8(), payload_ptr, obuf, 1, "glue.field.ptr");
                        intrinsics::free(obuf);
                    }
                    const field_llvm: LType = this.cg.type_mapper.map_type(pt);
                    const field_ptr: LValue = this.cg.builder.build_bitcast(
                        field_ptr_raw, LType::pointer_to(field_llvm), "glue.field.cast");
                    // Register the payload pointer as a synthetic lvalue and
                    // drop it via the normal `.drop()` path (handles user
                    // drops, Copy no-ops, and recursive glue).
                    const nm: SymbolStr = intern.intern(
                        format("__glue_payload_%d", this.glue_seq));
                    this.glue_seq = this.glue_seq + 1;
                    this.cg.values.set(nm, field_ptr);
                    mut id_node: IdentifierNode* = new IdentifierNode(nm, receiver.span);
                    id_node.set_resolved_type(pt);
                    mut da: MemberAccessNode* = new MemberAccessNode(
                        id_node as ExpressionNode*, drop_sym, receiver.span, receiver.span);
                    mut call: CallExprNode* = new CallExprNode(
                        da as ExpressionNode*, receiver.span);
                    mut stmt: ExprStmtNode* = new ExprStmtNode(
                        call as ExpressionNode*, receiver.span);
                    stmt.accept(visitor);
                }
            }

            // Branch to the merge block from wherever payload drops left the
            // insert point (a nested glue payload may have added blocks).
            const end_bb: LBasicBlock = this.cg.builder.get_insert_block();
            if (end_bb.is_valid() && !end_bb.has_terminator()) {
                this.cg.builder.build_br(after_bb);
            }
        }

        this.cg.builder.position_at_end(after_bb);
    }

    /// Walk the module graph and return every qualified function name that
    /// matches `<full_namespace>::<member>` where `<full_namespace>` ends with
    /// `::scope_str` (or equals `scope_str` exactly).  Used by the
    /// ScopeResolution codegen path so a shorthand `libc::read` resolves
    /// directly to `std::ffi::libc::read`, instead of falling through to the
    /// last-write-wins bare-name overload slot.
    ///
    /// Only entries that have a probe-able function signature in the codegen
    /// (arity-matched declaration) are returned.  A length-1 result is the
    /// happy path; length > 1 surfaces an E0154 ambiguity at the call site.
    static collect_namespace_suffix_matches(cg: CodegenContext*, intern: InternTable*,
                                              scope_str: string, member: SymbolStr,
                                              arity: u32) -> SymbolStr[] {
        mut result: SymbolStr[] = [];
        const scope_len: i64 = scope_str.length() as i64;
        if (scope_len == 0) { return result; }

        const mg: ModuleGraph* = cg.ctx.module_graph;
        const member_str: string = intern.resolve(member);
        for (mut i: i64 = 0; i < mg.modules.length; i++) {
            const ns_sym: SymbolStr = mg.modules[i].namespace_name;
            if (!ns_sym.is_valid()) { continue; }
            const ns_str: string = intern.resolve(ns_sym);
            const ns_len: i64 = ns_str.length() as i64;

            // Match condition: namespace equals scope_str OR ends with "::scope_str".
            mut is_match: boolean = false;
            if (ns_len == scope_len) {
                is_match = ns_str.eq(scope_str);
            } else if (ns_len > scope_len + 1) {
                const suffix_start: i64 = ns_len - scope_len;
                if (ns_str[suffix_start - 1] == ':' && ns_str[suffix_start - 2] == ':') {
                    is_match = (ns_str + suffix_start) == scope_str;
                }
            }
            if (!is_match) { continue; }

            // Build "<ns>::<member>" and probe the function table.
            const qualified: string = format("%s::%s", ns_str, member_str);
            const q_sym: SymbolStr = intern.intern(qualified);
            const probe: LValue = cg.resolver.resolve_function_with_arity(q_sym, arity);
            if (!probe.is_valid()) { continue; }

            // Dedup: same qualified name shouldn't appear twice (e.g. when
            // the module graph lists the same module under two indices).
            mut dup: boolean = false;
            for (mut k: i64 = 0; k < result.length; k++) {
                if (result[k].id == q_sym.id) { dup = true; break; }
            }
            if (!dup) { result.push(q_sym); }
        }

        // Struct-static form: when `scope_str` is `<ns_suffix>::<TypeLeaf>` (a
        // static method reached via an ABBREVIATED namespace, e.g.
        // `BuildManifest::Manifest::module_source_hash` where the namespace is
        // `Compiler::BuildManifest` and `Manifest` is a struct), the loop above
        // can't match - no module namespace ends with `::BuildManifest::Manifest`
        // because `Manifest` is a type, not a namespace segment.  Split the
        // scope at its final `::` into (namespace-prefix, type-leaf), match
        // modules whose namespace ends with the prefix, and probe
        // `<full_ns>::<TypeLeaf>::<member>`.  This mirrors how the free-function
        // form (`<ns>::<member>`) resolves a shorthand namespace, extended one
        // level for a type-qualified static.  Only attempted when the free-
        // function form found nothing, so it never changes an existing match.
        if (result.length == 0) {
            const ns_prefix: string = QualifiedName::parent_of(scope_str);
            const type_leaf: string = QualifiedName::leaf_of(scope_str);
            const prefix_len: i64 = ns_prefix.length() as i64;
            if (prefix_len > 0 && !type_leaf.eq(scope_str)) {
                for (mut i: i64 = 0; i < mg.modules.length; i++) {
                    const ns_sym: SymbolStr = mg.modules[i].namespace_name;
                    if (!ns_sym.is_valid()) { continue; }
                    const ns_str: string = intern.resolve(ns_sym);
                    const ns_len: i64 = ns_str.length() as i64;

                    mut is_match: boolean = false;
                    if (ns_len == prefix_len) {
                        is_match = ns_str.eq(ns_prefix);
                    } else if (ns_len > prefix_len + 1) {
                        const suffix_start: i64 = ns_len - prefix_len;
                        if (ns_str[suffix_start - 1] == ':' && ns_str[suffix_start - 2] == ':') {
                            is_match = (ns_str + suffix_start) == ns_prefix;
                        }
                    }
                    if (!is_match) { continue; }

                    const qualified: string = format("%s::%s::%s", ns_str, type_leaf, member_str);
                    const q_sym: SymbolStr = intern.intern(qualified);
                    const probe: LValue = cg.resolver.resolve_function_with_arity(q_sym, arity);
                    if (!probe.is_valid()) { continue; }

                    mut dup: boolean = false;
                    for (mut k: i64 = 0; k < result.length; k++) {
                        if (result[k].id == q_sym.id) { dup = true; break; }
                    }
                    if (!dup) { result.push(q_sym); }
                }
            }
        }
        return result;
    }
}
