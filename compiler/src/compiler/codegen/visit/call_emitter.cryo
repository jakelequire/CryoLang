/// Call Emitter
///
/// Lowering for `node.callee(args)` in all its shapes:
///   - bare-identifier call (`foo(x)`)             -> direct call after sema's mangled-callee
///   - method-on-object (`obj.method(x)`)          -> direct call to the pinned method
///   - scope-resolution call (`Mod::fn(x)`)        -> qualified resolver lookup
///   - enum variant construction                   -> delegated to EnumVariantEmitter
///   - intrinsic call (`@-prefixed or builtins`)   -> inline IR via IntrinsicEmitter::try_emit
///   - divergent callee (`panic`)                   -> call followed by `unreachable`
///
/// Holds the full bundle of back-pointers needed to evaluate argument
/// expressions (`dispatch`), look up symbols (`cg.resolver`), and
/// construct enum variant values (`enum_variant`).  The visitor passes
/// itself as `IRGeneratorVisitor*` so element-expression evaluation can recurse
/// through `dispatch.codegen_rvalue`.

namespace compiler::codegen::visit::call_emitter;

import compiler::codegen::{ abi, context, llvm, llvm_types, type_map, util };
import compiler::codegen::util::{ CodegenUtil };
import compiler::codegen::state::visitor_state::{ Emitted, VisitorState };
import compiler::codegen::visit::{ expr_dispatch, enum_variant_emitter };
import compiler::intrinsic_kind::{ IntrinsicKind };
import compiler::compilation_context;
import compiler::decl_index::{ DeclarationIndex };
import compiler::module_graph;
import compiler::diag::{ diagnostic, ErrorCode, source_span };
import compiler::types::{
    arena, compound, generic, generic_registry, ownership, resolver, type_base, type_ref,
    TypeKind, user_defined
};
import compiler::ast::{
    declaration, expression, LiteralKind, MemberPin, node, statement
};
import compiler::lex;
import compiler::resolver::{ symbol_str, intern_table, qualified_name, mangled_name };
import std::collections::pair::{ Pair };
import std::ffi::libc;
import std::fmt;
import compiler::ast::declaration::{ FunctionDecl, MethodDecl, DeclarationNode, TraitDecl, VarDecl };
import compiler::ast::expression::{
    CalleePin,
    CallExpr, ExpressionNode, IdentifierExpr,
    MemberAccessExpr, ScopeResolutionExpr
};
import compiler::ast::statement::{ Stmt };
import compiler::codegen::visit::ir_generator::{ IRGeneratorVisitor };
import compiler::codegen::abi::{ SignaturePlan };
import compiler::codegen::context::{ CodegenContext };
import compiler::codegen::llvm_types::{ LBasicBlock, LLinkage, LType, LTypeKind, LValue };
import compiler::codegen::ops::symbol_resolver::{ SymbolResolver };
import compiler::codegen::ops::declaration_emitter::{ DeclarationEmitter };
import compiler::codegen::visit::expr_dispatch::{ ExprDispatch };
import compiler::diag::diagnostic::{ Diagnostic };
import compiler::diag::source_span::{ SourceSpan };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::mangled_name::{ MangledName };
import compiler::resolver::qualified_name::{ QualifiedName };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::resolver::res::{ DefId, FamilyOwner, Res, ResSlot };
import compiler::types::arena::{ TypeArena };
import compiler::types::compound::{
    ArrayType, FunctionType, PointerType, ReferenceType, TupleType
};
import compiler::types::generic::{ InstantiatedType };
import compiler::types::generic_registry::{ GenericRegistry };
import compiler::resolver::lang_item::{ LangItem };
import compiler::types::ownership::{ OwnershipQuery };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };
import compiler::types::user_defined::{
    EnumType, EnumVariantInfo, FieldInfo, StructType
};
import compiler::codegen::visit::enum_variant_emitter::{ EnumVariantEmitter };


type struct CallEmitter {
    cg:           CodegenContext*;
    state:        VisitorState*;
    dispatch:     ExprDispatch*;
    enum_variant: EnumVariantEmitter*;

    /// Monotonic counter for naming the synthetic locals that hold enum
    /// payload pointers during drop-glue expansion (see emit_enum_drop_glue).
    glue_seq:     i64;

    static null() -> CallEmitter {
        return CallEmitter {
            cg:           null,
            state:        null,
            dispatch:     null,
            enum_variant: null,
            glue_seq:     0,
        };
    }

    wire(mut &this, cg: CodegenContext*, state: VisitorState*,
                    dispatch: ExprDispatch*, enum_variant: EnumVariantEmitter*) -> void {
        this.cg           = cg;
        this.state        = state;
        this.dispatch     = dispatch;
        this.enum_variant = enum_variant;
    }


    // Small helpers (inlined from IRGeneratorVisitor)

    /// Current LLVM function pointer for entry-block alloca placement.
    get_current_function(&this) -> LValue {
        const bb: LBasicBlock = this.cg.builder.get_insert_block();
        if (!bb.is_valid()) {
            this.cg.ctx.emit_error(ErrorCode::E0600_CODEGEN_FAILED,
                "codegen: builder has no insert block; cannot determine current function");
            return LValue::null();
        }
        return bb.get_parent();
    }


    /// Append the location a `![caller_location]` callee reports as its
    /// caller's: the address of `span`'s `Location`, the call's own, or -
    /// inside such a function itself - the address its own caller passed,
    /// so a chain of them reports the first call outside the chain.  A
    /// program that does not declare `Location` passes null, and can make
    /// no `location()` call to read it.
    push_caller_location(mut &this, args: [Pair<LValue, TypeRef>]*, span: SourceSpan) -> void {
        const arena: TypeArena* = this.cg.get_arena();
        const ptr_ty: TypeRef = SymbolResolver::caller_location_params(arena)[0];
        if (this.cg.decl.caller_location.is_valid()) {
            (*args).push(Pair::<LValue, TypeRef>::new(this.cg.decl.caller_location, ptr_ty));
            return;
        }
        const lty: LType = this.location_type();
        if (!lty.is_valid()) {
            (*args).push(Pair::<LValue, TypeRef>::new(
                LType::const_pointer_null(LType::pointer_to(LType::i8())), ptr_ty));
            return;
        }
        const init: LValue = this.cg.intrinsics.location_constant(lty, span);
        mut g: LValue = this.cg.llvm_module.add_global(lty, MangledName::new("caller.location"));
        g.set_initializer(init);
        g.set_global_constant(true);
        g.set_linkage(LLinkage::Private);
        (*args).push(Pair::<LValue, TypeRef>::new(g, ptr_ty));
    }

    /// `location()`: the `Location` of the call, or in a `![caller_location]`
    /// body the one its caller passed the address of.
    emit_location(mut &this, e: ExpressionNode*) -> LValue {
        const lty: LType = this.cg.type_mapper.map_type(e.resolved_type);
        if (this.cg.decl.caller_location.is_valid()) {
            return this.cg.builder.build_load(lty, this.cg.decl.caller_location, "caller.location");
        }
        return this.cg.intrinsics.location_constant(lty, e.span);
    }

    /// The lowered `Location`, or an invalid type when the program does not
    /// declare it.
    location_type(&this) -> LType {
        const def: DefId = this.cg.ctx.generic_registry.wellknown(LangItem::Location);
        if (!def.is_valid()) { return LType::null(); }
        return this.cg.type_mapper.map_type(this.cg.ctx.decl_index.type_of_def(def));
    }

    /// Stack slot for a value spilled so its address can be taken.
    entry_spill_slot(&this, ty: LType, name: string) -> LValue {
        return this.cg.flow.temp_slot(ty, name);
    }

    /// Produce the ADDRESS of a value for auto-ref (a by-value argument
    /// passed to a `&T` parameter).  When `v` is a `load` instruction we
    /// recover its pointer operand - the original lvalue's address - so a
    /// `&mut` borrow sees the caller's storage.  Otherwise (rvalue: a
    /// literal, a global like a string constant, a computed value) we spill
    /// it to a fresh stack slot and return that slot's address.
    address_of_value(&this, v: LValue) -> LValue {
        // LLVMOpcode::Load == 27.  On non-instruction values (globals,
        // constants) GetInstructionOpcode won't return 27, so we fall
        // through to the spill path.
        const opcode: i32 = llvm::LLVMGetInstructionOpcode(v.raw);
        if (opcode == 27) {
            const operand: void* = llvm::LLVMGetOperand(v.raw, 0);
            if (operand != null) { return LValue { raw: operand }; }
        }
        const ty: LType = LType { raw: llvm::LLVMTypeOf(v.raw) };
        // Entry-block slot: allocas are only reclaimed at function exit, so
        // spilling here for a call inside a loop body would allocate a fresh
        // slot per iteration.  Only the alloca is hoisted - the store below
        // stays at the current insert point.
        const slot: LValue = this.entry_spill_slot(ty, "argref");
        this.cg.builder.build_store(v, slot);
        return slot;
    }

    /// The function type of a callee that is a value - a local, a call's
    /// result, any expression - through one pointer or reference (`&fn`);
    /// null when the value is no function.
    value_function_type(&this, ty: TypeRef) -> FunctionType* {
        mut t: Type* = this.cg.arena_type(ty);
        if (t != null && t.kind == TypeKind::Pointer) {
            t = this.cg.arena_type(t.as_pointer().pointee);
        } else if (t != null && t.kind == TypeKind::Reference) {
            t = this.cg.arena_type(t.as_reference().referent);
        }
        if (t == null || t.kind != TypeKind::Function) { return null; }
        return t.as_function();
    }

    /// Call the function pointer `fn_ptr` with the call's arguments.  The
    /// pointer was computed, so it is no LLVM function: neither its type nor
    /// the call site's sret/byval attributes can be read off it, and both
    /// come from `plan`, classified from the value's Cryo function type.
    /// `leading` goes before the call's own arguments: the receiver of a
    /// call through a trait object, nothing for any other call.
    call_through_value(mut &this, visitor: IRGeneratorVisitor*, e: ExpressionNode*, node: CallExpr*,
                       fn_ptr: LValue, plan: SignaturePlan, leading: [Pair<LValue, TypeRef>]) -> Emitted {
        mut out: Emitted = Emitted::none();
        // The seam returns `void` when sret applies, else the Direct
        // return slot's type; a void call gets no result name.
        mut ret_ty: LType = LType::void_type();
        if (!plan.sret_slot && plan.return_plan.llvm_slots.length() > 0) {
            ret_ty = plan.return_plan.llvm_slots[0];
        }
        mut call_args: [Pair<LValue, TypeRef>] = leading;
        for (mut ai: i64 = 0; ai < node.arguments.length(); ai++) {
            mut av: LValue = this.dispatch.codegen_rvalue(visitor,node.arguments[ai]);
            // A by-value argument in a `&T` slot passes its address, as at a
            // direct call: the pointer's type is a reference, whatever the
            // value's LLVM shape (a fixed-size array has no value-to-pointer
            // coercion at the call).
            if (node.arguments[ai].autoref && av.is_valid()) {
                av = this.address_of_value(av);
            }
            call_args.push(Pair::<LValue, TypeRef>::new(av, node.arguments[ai].resolved_type));
        }
        const void_ty: LType = LType::void_type();
        const call_name: string = if (ret_ty.raw == void_ty.raw) { "" } else { "calltmp" };
        const fn_type: LType = plan.llvm_fn_type;
        out.value = this.reshape_call_result(e,
            this.cg.expr_ops.codegen_call_with_plan(fn_ptr, fn_type, plan, call_args, call_name));
        out.is_lvalue = false;
        return out;
    }

    /// A call through a trait object: the function is the word of the
    /// object's table holding the method sema recorded on the call - its
    /// declaring trait, the object's own or a supertrait, and its slot
    /// there - called with the object's data word as its receiver.  The
    /// signature is classified from the trait method's own declaration with
    /// the trait's arguments the object gives put in
    /// (`TypeResolver::object_method_type`, as sema typed the call), since
    /// which function the word holds is known only where the call runs.  `object_t` is the object the receiver reaches
    /// (`TypeArena::object_behind_receiver`): a receiver that is a
    /// reference or pointer to it is the object's address, loaded through
    /// each level.  A call whose method the table does not hold is an
    /// internal error, never a call bound some other way.
    call_through_object(mut &this, visitor: IRGeneratorVisitor*, e: ExpressionNode*, node: CallExpr*,
                        ma: MemberAccessExpr*, object_t: Type*) -> Emitted {
        mut out: Emitted = Emitted::none();
        const registry: GenericRegistry* = this.cg.ctx.generic_registry;
        const slot: i64 = ma.resolved_trait_slot;
        const object_trait: DefId = object_t.as_object().trait_def;
        const index: i64 = registry.object_table_index(object_trait, ma.resolved_trait, slot);
        const decl: TraitDecl* = if (index >= 0) { registry.get_trait_decl(ma.resolved_trait) } else { null };
        if (decl == null) {
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "internal: a call through a trait object reached code generation naming no method of the object's table");
            diag = diag.at(e.span);
            this.cg.diag.emit(diag);
            return out;
        }
        const func: FunctionDecl* = DeclarationNode::fn_of(decl.methods[slot]);
        const resolver: TypeResolver* = this.cg.ctx.type_resolver;
        const object_type: ObjectType* = object_t.as_object();
        mut param_types: [TypeRef] = [];
        for (mut i: i64 = 0; i < func.parameters.length(); i++) {
            param_types.push(resolver.object_method_type(object_type, ma.resolved_trait,
                DeclarationNode::var_of(func.parameters[i]).resolved_type));
        }
        const plan: SignaturePlan = this.cg.abi.classify_signature(&param_types,
            resolver.object_method_type(object_type, ma.resolved_trait, func.resolved_return_type), false);
        if (!plan.llvm_fn_type.is_valid()) { return out; }
        mut object: LValue = this.dispatch.codegen_rvalue(visitor, ma.object);
        if (!object.is_valid()) { return out; }
        mut level: Type* = this.cg.arena_type(ma.object.resolved_type);
        while (level != object_t) {
            const inner: TypeRef = if (level.kind == TypeKind::Reference) {
                level.as_reference().referent
            } else {
                level.as_pointer().pointee
            };
            object = this.cg.builder.build_load(this.cg.type_mapper.map_type(inner), object, "object.through");
            level = this.cg.arena_type(inner);
        }
        const word: LType = LType::pointer_to(LType::i8());
        const data: LValue = this.cg.builder.build_extract_value(object, 0, "object.data");
        const table: LValue = this.cg.builder.build_extract_value(object, 1, "object.table");
        const index_buf: void* = libc::malloc(8);
        const index_slots: void** = index_buf as void**;
        index_slots[0] = LType::const_int(LType::i64(), DeclarationEmitter::object_table_word(index) as u64, false).raw;
        const at: LValue = this.cg.builder.build_gep(word, table, index_buf, 1, "object.slot");
        libc::free(index_buf);
        const fn_ptr: LValue = this.cg.builder.build_load(word, at, "object.method");
        mut leading: [Pair<LValue, TypeRef>] = [];
        leading.push(Pair::<LValue, TypeRef>::new(data, param_types[0]));
        return this.call_through_value(visitor, e, node, fn_ptr, plan, leading);
    }

    /// A call's result at its source type.  When the callee returns a
    /// small aggregate register-shaped (Direct-with-coercion for <= 8 byte
    /// aggregates, or DirectPair wrapped in an anonymous `{lo, hi}` literal
    /// struct for 9-16 byte aggregates), the call instruction yields a
    /// different LLVM type than the source struct.  The value is spilled
    /// through a stack temp and re-loaded at the source struct type; both
    /// layouts agree byte-for-byte by construction, so the store-then-load
    /// round-trips (the inverse of the coercion the callee does on its
    /// return).  An sret call already yields the struct loaded from its
    /// slot, so the equal-types check leaves it alone.
    reshape_call_result(mut &this, e: ExpressionNode*, result: LValue) -> LValue {
        if (!result.is_valid() || !e.resolved_type.is_valid()) { return result; }
        const got_raw: void* = llvm::LLVMTypeOf(result.raw);
        const expected_lty: LType = this.cg.type_mapper.map_type(e.resolved_type);
        const got_kind: LTypeKind = LType::kind_of(got_raw);
        const needs_coerce: boolean = expected_lty.is_valid()
            && got_raw != expected_lty.raw
            && (got_kind == LTypeKind::Integer
                || got_kind == LTypeKind::Struct
                || got_kind == LTypeKind::Float
                || got_kind == LTypeKind::Double
                || got_kind == LTypeKind::Vector)
            && LType::kind_of(expected_lty.raw) == LTypeKind::Struct;
        if (!needs_coerce) { return result; }
        const cur_bb_c: LBasicBlock = this.cg.builder.get_insert_block();
        if (!cur_bb_c.is_valid()) { return result; }
        const fn_c: LValue = cur_bb_c.get_parent();
        if (!fn_c.is_valid()) { return result; }
        // Alloca at the call result's type: the store of a (possibly
        // padded) DirectPair never writes past the slot, and padding rules
        // differ between a named struct with field alignment and an
        // anonymous `{i64, i32}` whose tail packs the leftover bytes only.
        const got_lty: LType = LType { raw: got_raw };
        const slot_c: LValue = this.cg.flow.create_entry_alloca(
            fn_c, "ret.coerce", got_lty);
        this.cg.builder.build_store(result, slot_c);
        return this.cg.builder.build_load(expected_lty, slot_c, "ret.coerced");
    }


    // Main emit

    /// Lower the call `e`, whose payload is `node`, into LLVM IR.  The
    /// visitor's dispatch delegates here, passing itself as `visitor:
    /// IRGeneratorVisitor*` so argument expressions can recurse through
    /// `dispatch.codegen_rvalue`.
    emit(mut &this, visitor: IRGeneratorVisitor*, e: ExpressionNode*, node: CallExpr*) -> Emitted {
        mut out: Emitted = Emitted::none();
        mut callee_val: LValue = LValue::null();

        const id: IdentifierExpr* = ExpressionNode::identifier_of(node.callee);
        if (id != null) {

            // An intrinsic is lowered inline before anything reads the
            // written name: sema pins `resolved_callee` to the intrinsic's
            // entry, and the module carries an extern declaration for it
            // (from declare_function) that nothing defines, so a real call
            // would fail the link with `undefined reference`.
            match (this.emit_pinned_intrinsic(visitor, e, node)) {
                Option::Some(e) => { return e; }
                Option::None    => { }
            }

            // Trust sema: `resolved_callee` is the mangled LLVM symbol
            // chosen by overload resolution (or, for unique-name
            // functions, the canonical mangling registered by
            // declare_function).  Sema runs
            // `try_pin_overload_mangled_callee` on every Identifier
            // call, so any function known to the DeclarationIndex
            // (qualified, bare-aliased, overloaded, or unique) gets
            // pinned - by its symbol, or by a family name that names one.
            // Codegen resolves the pin once, by the kind it says it is; a
            // qualified/bare/DI-mapping cascade here would only re-resolve
            // names sema has already resolved.
            if (node.resolved_callee.is_some()) {
                callee_val = this.cg.resolver.resolve_pinned(node.resolved_callee);
            }

            // 4. Function-typed parameter: look in the value table, by the
            //    binding the identifier is stamped with.  A parameter of
            //    function type is stored there as an alloca.  Load the
            //    function pointer and call through it.
            //    We must handle the call here because the loaded value is an
            //    instruction, not a GlobalValue; LLVMGlobalGetValueType
            //    would segfault on it.
            //    A module's global of function type is called the same way,
            //    through its storage, which the stamp names.
            if (!callee_val.is_valid()) {
                mut local: LValue = this.cg.values.get(id.res.local_sym());
                if (!local.is_valid()) {
                    match (id.res) {
                        ResSlot::Answered(r) => {
                            if (r.def_id().is_valid()) { local = this.cg.resolver.resolve_global_of_def(r.def_id()); }
                        }
                        _ => { }
                    }
                }
                if (local.is_valid()) {
                    const ft: FunctionType* = this.value_function_type(node.callee.resolved_type);
                    if (ft != null) {
                        const plan: SignaturePlan = this.cg.abi.classify_signature(
                            ft.param_types, ft.return_type, false);
                        if (!plan.llvm_fn_type.is_valid()) {
                            out.value = LValue::null();
                            out.is_lvalue = false;
                            return out;
                        }
                        // Load the function pointer from the alloca.
                        const fn_ptr_llvm: LType = LType::pointer_to(LType::i8());
                        const fn_ptr: LValue = this.cg.builder.build_load(fn_ptr_llvm, local, "fn.ptr.load");
                        return this.call_through_value(visitor, e, node, fn_ptr, plan, []);
                    }
                }
            }
        } else if (ExpressionNode::scope_resolution_of(node.callee) != null) {
            // Scope resolution: e.g., LValue::null(), TypeRef::invalid().
            // The scope name may be bare (LValue) while the function was
            // registered under the qualified type name.
            // Resolve the scope name through the DI type map to get the
            // qualified type name, then build the combined key.
            const sr: ScopeResolutionExpr* = ExpressionNode::scope_resolution_of(node.callee);

            // An intrinsic reached through its module (`intrinsics::ptr_diff`)
            // is lowered inline BEFORE the pin is resolved as a callee: the
            // declaration table would declare the pinned symbol as an extern
            // and the link would look for a `ptr_diff` nothing defines.
            match (this.emit_pinned_intrinsic(visitor, e, node)) {
                Option::Some(e) => { return e; }
                Option::None    => { }
            }

            // Sema's pin is the whole answer for a static call: written by
            // sema's static-method / module-function / C-import paths, or by
            // the specialization walk for a generic callee or a generic
            // owner.  It routes through `resolve_pinned`, exactly as the
            // Identifier branch does.  A call with no pin that
            // names no enum variant below is a call the front end never
            // bound, and it is reported as one rather than bound here by a
            // name derived from the spelling or the return type.
            if (node.resolved_callee.is_some()) {
                callee_val = this.cg.resolver.resolve_pinned(node.resolved_callee);
            }

            // No pin: an enum variant constructor (`Option::Some`,
            // `Result::Ok`).  Variants are not registered as functions; the
            // value is synthesized inline.  The enum is the one sema
            // resolved the call TO (`e.resolved_type`, through any chain
            // of instantiations), never the one the scope segment spells: a
            // generic variant's spelling names the template; the variant is
            // the ordinal sema pinned on the path.
            if (!callee_val.is_valid()) {
                mut real_ref: TypeRef = e.resolved_type;
                mut real_t: Type* = this.cg.arena_type(real_ref);
                mut follow_count: i32 = 0;
                while (real_t != null && real_t.kind == TypeKind::InstantiatedType && follow_count < 5) {
                    const inst: InstantiatedType* = real_t.as_instantiated();
                    if (inst.has_resolved_type()) {
                        real_ref = inst.resolved_type;
                        real_t = this.cg.arena_type(real_ref);
                    } else {
                        break;
                    }
                    follow_count += 1;
                }
                if (real_t != null && real_t.kind == TypeKind::Enum) {
                    const et: EnumType* = real_t.as_enum();
                    const variant: EnumVariantInfo* = CodegenUtil::pinned_variant(et, sr.resolved_member);
                    if (variant != null) {
                        // Codegen the arguments first.
                        mut vargs: [LValue] = [];
                        for (mut ai: i64 = 0; ai < node.arguments.length(); ai++) {
                            vargs.push(this.dispatch.codegen_rvalue(visitor,node.arguments[ai]));
                        }
                        const result: LValue = this.enum_variant.build(et, variant, real_ref, vargs);
                        out.value = result;
                        out.is_lvalue = false;
                        return out;
                    }
                }
            }
        } else if (ExpressionNode::member_access_of(node.callee) != null) {
            // Member access: sema's overload selection (or mono's, for a
            // specialization) pins the mangled LLVM callee on
            // `resolved_callee`.  Codegen detects the function-pointer-field
            // shortcut, then routes the pin through `resolve_pinned`.
            const ma: MemberAccessExpr* = ExpressionNode::member_access_of(node.callee);

            // A release of an object (`drop_in_place::<T>` with `T` an
            // object) is no call of the object's trait: an object is `Copy`,
            // so it releases nothing, below.  A call monomorphization pinned
            // is a default the table cannot hold, compiled for the object,
            // and is called as any pinned method is.
            const object_t: Type* = this.cg.ctx.type_arena.object_behind_receiver(ma.object.resolved_type);
            const releases_object: boolean = node.named_method.is_valid()
                && node.named_method.equals(this.cg.ctx.generic_registry.wellknown(LangItem::DropDrop));
            if (object_t != null && !releases_object && !node.resolved_callee.is_some()) {
                return this.call_through_object(visitor, e, node, ma, object_t);
            }

            // Function-pointer field call: `receiver.field(args)` where
            // `field` has a Function type.  What the member IS is its pin:
            // a field read carries the field sema found, and a method
            // callee carries none (the call's own pin answers it).  The
            // access's type cannot tell them apart - a method callee is
            // typed by the method's return, which may itself be a function.
            // The field is loaded and called through.
            mut ma_callee_t: Type* = null;
            if (ma.resolved_member.is_some()) { ma_callee_t = this.cg.arena_type(node.callee.resolved_type); }
            // Unwrap pointer/reference to match how function-typed fields
            // land; `fn(...) -> T` stores as a raw function-pointer so the
            // member may resolve to a Function type directly.
            mut ma_fn_type: FunctionType* = null;
            if (ma_callee_t != null && ma_callee_t.kind == TypeKind::Function) {
                ma_fn_type = ma_callee_t.as_function();
            } else if (ma_callee_t != null && ma_callee_t.kind == TypeKind::Pointer) {
                const ppt: PointerType* = ma_callee_t.as_pointer();
                const pin: Type* = this.cg.arena_type(ppt.pointee);
                if (pin != null && pin.kind == TypeKind::Function) {
                    ma_fn_type = pin.as_function();
                }
            }
            if (ma_fn_type != null) {
                const ft: FunctionType* = ma_fn_type;
                const plan: SignaturePlan = this.cg.abi.classify_signature(
                    ft.param_types, ft.return_type, false);
                if (!plan.llvm_fn_type.is_valid()) {
                    out.value = LValue::null();
                    out.is_lvalue = false;
                    return out;
                }
                // Load the fn-pointer value from the field (rvalue).  No
                // implicit `this`: the field holds a plain function, not a
                // bound method.
                const fn_ptr: LValue = this.dispatch.codegen_rvalue(visitor,node.callee);
                if (!fn_ptr.is_valid()) {
                    out.value = LValue::null();
                    out.is_lvalue = false;
                    return out;
                }
                return this.call_through_value(visitor, e, node, fn_ptr, plan, []);
            }

            // `resolved_callee` is the mangled LLVM symbol selection chose;
            // routed through `resolve_pinned`, identical to the Identifier
            // branch.
            if (node.resolved_callee.is_some()) {
                callee_val = this.cg.resolver.resolve_pinned(node.resolved_callee);
            }

            // Sema's pin is the whole answer for a method call.  A call
            // with no pin has no method: a `.drop()` on a type without a
            // user drop, which the Copy no-op and the drop glue below take.

        } else {
            // Any other callee is a value of function type the program
            // computes - a call's result (`pick()(2.0)`), an element, a
            // parenthesized expression - and is called through.
            const ft: FunctionType* = this.value_function_type(node.callee.resolved_type);
            if (ft != null) {
                const plan: SignaturePlan = this.cg.abi.classify_signature(
                    ft.param_types, ft.return_type, false);
                if (!plan.llvm_fn_type.is_valid()) {
                    out.value = LValue::null();
                    out.is_lvalue = false;
                    return out;
                }
                const fn_ptr: LValue = this.dispatch.codegen_rvalue(visitor,node.callee);
                if (!fn_ptr.is_valid()) {
                    out.value = LValue::null();
                    out.is_lvalue = false;
                    return out;
                }
                return this.call_through_value(visitor, e, node, fn_ptr, plan, []);
            }
            callee_val = this.dispatch.codegen_rvalue(visitor,node.callee);
        }

        if (!callee_val.is_valid()) {
            // A release another pass built (`named_method` is `Drop::drop`'s
            // language item) whose receiver's type has no destructor.  On a
            // `Copy` receiver it is a no-op: a bitwise-duplicable value owns
            // no resources, and a Copy type has no `Drop` implementation
            // (having one would make it non-Copy).  This is how
            // `ptr::drop_in_place::<T>` lowers for a Copy `T`.  Gated on
            // `Copy` so a failed release of a genuinely-owning type still
            // surfaces.
            const releases: boolean = node.named_method.is_valid()
                && node.named_method.equals(this.cg.ctx.generic_registry.wellknown(LangItem::DropDrop));
            if (releases && ExpressionNode::member_access_of(node.callee) != null) {
                const dma: MemberAccessExpr* = ExpressionNode::member_access_of(node.callee);
                if (OwnershipQuery::is_copy(this.cg.get_arena(),
                               this.cg.ctx.generic_registry,
                               this.cg.get_intern(),
                               dma.object.resolved_type)) {
                    out.value = LValue::null();
                    out.is_lvalue = false;
                    return out;
                }
                // Drop glue: the release of a non-Copy aggregate with no
                // destructor is expanded into in-place releases of its
                // droppable parts.  Reuses the same lowering recursively (a
                // field that itself lacks a destructor re-enters this path).
                // In-place + idempotent leaf drops mean re-dropping an
                // already-released part is a no-op.
                if (OwnershipQuery::needs_drop(this.cg.get_arena(),
                               this.cg.ctx.generic_registry,
                               this.cg.get_intern(),
                               dma.object.resolved_type)) {
                    if (this.emit_drop_glue(visitor, dma.object,
                                            dma.object.resolved_type)) {
                        out.value = LValue::null();
                        out.is_lvalue = false;
                        return out;
                    }
                }
            }

            // An assertion, not a diagnosis: monomorphization reports every
            // call nothing binds before code generation starts, and a call
            // synthesized after it is bound by the pass that builds it.
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "internal: code generation found nothing to call for this call; monomorphization reports an unbound call before code generation, so this should never happen");
            diag = diag.at(e.span);
            this.cg.diag.emit(diag);
            out.value = LValue::null();
            out.is_lvalue = false;
            return out;
        }

        // `Pair<LValue, TypeRef>` per arg; the type drives sext-vs-zext
        // when codegen_call needs to widen a narrow integer to the formal
        // param's LLVM width.  Receivers are pointer/reference-typed and
        // never hit the integer-widening path, but we record the receiver
        // type anyway to keep the array meaningful end-to-end.
        // `--panic=unwind`: open a frame for this call's owning temporaries - the
        // consumed receiver (recorded below) plus each positional owning temp
        // (recorded in the arg loop). A panic origin nested in a LATER argument
        // drops the whole live frame; it is closed once the call is built (the
        // callee then owns them). Opened before the receiver so a consumed
        // receiver temp joins this frame.
        if (this.cg.ctx.options.unwinds()) { this.cg.expr_ops.open_arg_temp_frame(); }
        mut args: [Pair<LValue, TypeRef>] = [];
        if (ExpressionNode::member_access_of(node.callee) != null) {
            const ma: MemberAccessExpr* = ExpressionNode::member_access_of(node.callee);
            // For pointer/reference receivers (e.g. `runner: Runner*`),
            // the receiver value is itself the `this` pointer; load it
            // out of the local slot.  For value receivers (`runner: Runner`),
            // take the lvalue address as `this`.
            const recv_t: Type* = this.cg.arena_type(ma.object.resolved_type);
            mut obj: LValue = LValue::null();
            if (recv_t != null && (recv_t.kind == TypeKind::Pointer
                                || recv_t.kind == TypeKind::Reference)) {
                obj = this.dispatch.codegen_rvalue(visitor,ma.object);
            } else {
                const obj_e: Emitted = this.dispatch.generate_expression(visitor, ma.object);
                obj = obj_e.value;
                // A value-typed receiver that is an rvalue - a literal
                // (`"x".method()`), a call result, or a method-chain result
                // (`a.f().g()`) - has no backing storage, so emitting it
                // gives the VALUE rather than an address.  Using that as
                // `&this` is one indirection short and crashes the callee.
                // Spill it to a fresh slot so `this` points at real memory.
                if (obj.is_valid() && !obj_e.is_lvalue) {
                    const recv_ty: LType = LType { raw: llvm::LLVMTypeOf(obj.raw) };
                    const recv_slot: LValue = this.entry_spill_slot(recv_ty, "recvtmp");
                    this.cg.builder.build_store(obj, recv_slot);
                    obj = recv_slot;
                    // A CONSUMED anonymous receiver temp (`make().consume(g())`)
                    // is moved into the call; if a later argument panics before
                    // the call runs, this frame must drop it (the callee never
                    // took it). Record it like a positional owning temp. Gated on
                    // the same consume check DropInsertion uses, so a receiver it
                    // treats as borrowed (still owned elsewhere) is not recorded.
                    if (this.cg.ctx.options.unwinds()
                        && (ExpressionNode::call_of(ma.object) != null
                            || ExpressionNode::struct_of(ma.object) != null)
                        && this.call_consumes_receiver(node)
                        && OwnershipQuery::needs_drop(this.cg.get_arena(),
                               this.cg.ctx.generic_registry, this.cg.get_intern(),
                               ma.object.resolved_type)) {
                        this.record_arg_temp_slot(recv_slot, ma.object.resolved_type,
                                                  ma.object.span);
                    }
                }
            }
            args.push(Pair::<LValue, TypeRef>::new(obj, ma.object.resolved_type));
        }
        // Win64: an argument bound to a `va_list` parameter must be passed BY
        // VALUE (a `char*`), but the program holds the ADDRESS of the va_list
        // storage (`VaArgs::as_ptr` / the `args` bucket lower to `char**`).  Load
        // the stored `char*` out via the ABI seam for each such argument so an
        // imported C `v*` consumer reads from the right slot instead of one
        // indirection off.  `va_forward_fn_type` returns null on SysV-amd64 and
        // for method calls, leaving the loop byte-identical there.
        const va_ft: FunctionType* = this.va_forward_fn_type(node);
        for (mut i: i64 = 0; i < node.arguments.length(); i++) {
            mut arg: LValue = this.dispatch.codegen_rvalue(visitor,node.arguments[i]);
            // Auto-ref: sema flagged this by-value argument as bound to a
            // reference (`&T`) parameter, so pass the value's ADDRESS, not
            // the value itself.  Without this, a scalar would be `inttoptr`'d
            // and a pointer-shaped value (`string`) passed one indirection
            // short, then dereferenced by the callee -> crash.
            if (node.arguments[i].autoref && arg.is_valid()) {
                arg = this.address_of_value(arg);
            }
            if (va_ft != null && i < va_ft.param_types.length() && arg.is_valid()) {
                const pt: Type* = this.cg.arena_type(va_ft.param_types[i]);
                if (pt != null && pt.kind == TypeKind::VaList) {
                    arg = this.cg.abi.forward_va_list(&this.cg.builder, arg);
                }
            }
            // A by-value owning temp (a call / struct-literal result with no AST
            // binding) is invisible to DropInsertion's name-keyed pending-arg
            // machinery; record it so a later argument's panic drops it. Autoref
            // args are borrows (the callee never owns them), so they are skipped.
            if (this.cg.ctx.options.unwinds() && !node.arguments[i].autoref) {
                this.maybe_record_arg_temp(node.arguments[i], arg);
            }
            args.push(Pair::<LValue, TypeRef>::new(arg, node.arguments[i].resolved_type));
        }
        // Close this call's arg-temp frame: its temporaries are now owned by the
        // callee, so the call's own cleanup schedule must not drop them. A panic
        // origin walked while the frame was open already captured them.
        if (this.cg.ctx.options.unwinds()) { this.cg.expr_ops.close_arg_temp_frame(); }

        mut fn_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(callee_val.raw) };
        // A free or extern call is made at the signature the front end
        // PINNED, not at the type the symbol happened to be declared with in
        // this LLVM module: one C name may be declared by two extern blocks
        // with different Cryo signatures, the symbol is declared once, and
        // the second call would otherwise pass its arguments at the first
        // declaration's widths.  A method's symbol is its own mangling, so a
        // method call keeps the declared type.
        if (node.resolved_callee.is_some()
                && (ExpressionNode::identifier_of(node.callee) != null
                    || ExpressionNode::scope_resolution_of(node.callee) != null)) {
            const pinned_ft: TypeRef = this.cg.resolver.call_signature(
                this.cg.resolver.pinned_entry(node.resolved_callee));
            const pinned_t: Type* = if (pinned_ft.is_valid()) { this.cg.arena_type(pinned_ft) } else { null };
            if (pinned_t != null && pinned_t.kind == TypeKind::Function) {
                const pinned_lty: LType = this.cg.resolver.build_function_ltype(pinned_t.as_function());
                if (pinned_lty.is_valid()) { fn_ty = pinned_lty; }
            }
        }
        if (!fn_ty.is_valid()) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0602_INVALID_LLVM_TYPE,
                "codegen: call expression: failed to retrieve function type from callee",
                e.span);
            out.value = LValue::null();
            out.is_lvalue = false;
            return out;
        }

        // The function whose parameters say how the arguments pass.
        const declared: LValue = callee_val;

        const ret_ty: LType = this.cg.type_mapper.map_type(e.resolved_type);
        const void_ty: LType = LType::void_type();
        // Void calls and unresolved return types must use empty name;
        // LLVM doesn't allow naming void-typed instructions.  The ABI/
        // definition side (`abi.cryo` classify, `declaration_emitter`)
        // lowers a `Unit`/`Void`/`Never` return to an LLVM `void`-returning
        // function, but `map_type(Unit)` yields an empty `{}` struct (the
        // value representation of unit), not LLVM void.  Keying `is_void`
        // off the mapped LLVM type alone therefore names the call
        // instruction for a unit return (e.g. `Result<(), E>::expect`),
        // which LLVM rejects: "Instruction has a name, but provides a void
        // value!".  Detect the void-returning ABI from the source-level
        // return-type kind to stay in lockstep with the definition side.
        mut ret_kind_is_void: boolean = false;
        if (e.resolved_type.is_valid()) {
            const _rt: Type* = this.cg.arena_type(e.resolved_type);
            if (_rt != null && (_rt.kind == TypeKind::Unit
                                || _rt.kind == TypeKind::Void
                                || _rt.kind == TypeKind::Never)) {
                ret_kind_is_void = true;
            }
        }
        const is_void: boolean = !ret_ty.is_valid() || ret_ty.raw == void_ty.raw ||
                                  LType::kind_of(ret_ty.raw) == LTypeKind::Void ||
                                  ret_kind_is_void;
        const call_name: string = if (is_void) { "" } else { "calltmp" };
        mut result: LValue = LValue::null();
        // Under `--panic=unwind`, a call whose frame has live droppable locals
        // must be an `invoke`: on unwind, control lands in a cleanup landing pad
        // that drops those locals (innermost-first) then `resume`s into the
        // caller.  DropInsertion recorded the cumulative schedule on
        // `node.unwind_cleanup`; it is empty on the default abort path, so the
        // else-branch below emits the identical plain `call` there.
        // Live anonymous arg temps in an enclosing in-progress call also force an
        // invoke: if this call unwinds, its pad must drop them (the callee that
        // would own them never runs on the unwind path).
        // A `![caller_location]` callee takes the address of its caller's
        // `Location` after its own arguments: this call's place, or, inside
        // another such function, the one that function was given.
        if (this.cg.resolver.caller_located(this.cg.resolver.pinned_entry(node.resolved_callee))) {
            this.push_caller_location(&args, e.span);
        }
        const needs_invoke: boolean = this.cg.ctx.options.unwinds()
            && (node.unwind_cleanup.length() > 0
                || this.cg.expr_ops.has_live_arg_temps());
        if (needs_invoke) {
            const cur_fn: LValue = this.get_current_function();
            if (cur_fn.is_valid()) {
                const cont_bb: LBasicBlock = LBasicBlock::append(cur_fn, "invoke.cont");
                const lpad_bb: LBasicBlock = LBasicBlock::append(cur_fn, "invoke.lpad");
                this.cg.expr_ops.invoke_active = true;
                this.cg.expr_ops.invoke_normal = cont_bb;
                this.cg.expr_ops.invoke_lpad   = lpad_bb;
                result = this.cg.expr_ops.codegen_call_via(callee_val, declared, fn_ty, args, call_name);
                // Clear defensively in case an upstream error path returned
                // before any callee call armed and consumed the flag.
                this.cg.expr_ops.invoke_active = false;
                this.emit_cleanup_landingpad(visitor, node, cur_fn, lpad_bb);
                // `build_call_maybe_invoke` left the builder at `cont_bb`; the
                // return coercion and any `unreachable` below emit there.
            } else {
                result = this.cg.expr_ops.codegen_call_via(callee_val, declared, fn_ty, args, call_name);
            }
        } else {
            result = this.cg.expr_ops.codegen_call_via(callee_val, declared, fn_ty, args, call_name);
        }

        result = this.reshape_call_result(e, result);

        // A user-written `drop` runs IN ADDITION to field glue, not instead of
        // it: the body releases what it names, and the type's own droppable
        // fields are released here, right after the call returns.  Otherwise
        // writing a `drop` silently switches field glue off, and every field
        // the body forgets leaks with no diagnostic - the same type without a
        // `drop` at all has its fields released for it, so adding a destructor
        // would be the one edit that makes a program leak.
        //
        // Emitted at the CALL SITE rather than appended to the body so it
        // covers every release path uniformly: an explicit `.drop()` and the
        // synthesizer's scope-exit drop lower through here alike, and a body
        // that returns early still releases its fields.
        //
        // A field the body already released is released again here.  That is
        // sound only because leaf drops are in-place and null what they free,
        // making the second release a no-op - an invariant this now depends on
        // rather than merely benefits from.
        //
        // A destructor is the method of an implementation of `Drop`, which the
        // call's pin names; a method merely named `drop` is not one, and runs
        // no glue after it.
        if (ExpressionNode::member_access_of(node.callee) != null && node.arguments.length() == 0
                && this.cg.get_decl_index().entry_trait(node.resolved_callee.decl_entry()).equals(
                       this.cg.ctx.defs.parent_of(this.cg.ctx.generic_registry.wellknown(LangItem::DropDrop)))) {
            const gma: MemberAccessExpr* = ExpressionNode::member_access_of(node.callee);
            if (gma.object != null
                    && OwnershipQuery::needs_drop(this.cg.get_arena(),
                           this.cg.ctx.generic_registry,
                           this.cg.get_intern(),
                           gma.object.resolved_type)) {
                this.emit_drop_glue(visitor, gma.object, gma.object.resolved_type);
            }
        }

        // Emit `unreachable` after a call to a divergent function - one
        // whose resolved return type is `never` (e.g. `core::panic` /
        // `intrinsics::panic`). Without this, a divergent call in a
        // non-void-returning context (e.g. the `None` arm of
        // `Option<T>::unwrap`) leaves the block without a terminator and
        // the body-validator strips the entire function.
        mut should_unreachable: boolean = false;
        if (e.resolved_type.is_valid()) {
            const _ret_t: Type* = this.cg.arena_type(e.resolved_type);
            if (_ret_t != null && _ret_t.kind == TypeKind::Never) {
                should_unreachable = true;
            }
        }
        if (should_unreachable) {
            this.cg.builder.build_unreachable();
        }

        out.value = result;
        out.is_lvalue = false;
        return out;
    }

    /// Register an already-materialized owning temp `slot` for drop on the unwind
    /// path: bind it to a synthetic name in the value table and hand a ready-made
    /// `<name>.drop()` statement to the arg-temp stack, which the cleanup landing
    /// pad replays exactly like an ordinary local's drop (user drop, Copy no-op,
    /// and recursive glue all fall out of the normal `.drop()` lowering).  Shared
    /// by the positional-arg path (`maybe_record_arg_temp`) and the
    /// consumed-receiver path (`make().consume(g())`).
    record_arg_temp_slot(mut &this, slot: LValue, ty: TypeRef, span: SourceSpan) -> void {
        if (!slot.is_valid() || !ty.is_valid()) { return; }
        const intern: InternTable* = this.cg.get_intern();
        const nm: SymbolStr = intern.intern(fmt::format("__argtemp_%d", this.glue_seq));
        this.glue_seq = this.glue_seq + 1;
        const nm_sym: SymbolID = this.cg.ctx.resolver.alloc_synthetic_binding();
        this.cg.values.set(nm_sym, slot);
        const id_node: ExpressionNode* = ExpressionNode::identifier_expr(nm, span);
        ExpressionNode::identifier_of(id_node).set_res(Res::Local(nm_sym));
        id_node.set_resolved_type(ty);
        const drop_sym: SymbolStr = intern.intern("drop");
        mut da: ExpressionNode* = ExpressionNode::member_access_expr(
            id_node, drop_sym, span, span);
        mut call: ExpressionNode* = ExpressionNode::call_expr(da, span);
        this.cg.bind_destructor_call(call);
        mut stmt: Stmt* = Stmt::expr_stmt(call, span);
        this.cg.expr_ops.push_arg_temp_drop(stmt);
    }

    /// Record a live owning argument temporary so a panic origin nested in a
    /// LATER argument drops it on the unwind path.  `f(make(), boom())`: make()'s
    /// result is an owning temp with no AST binding, so DropInsertion's name-keyed
    /// pending-arg machinery (which handles NAMED owning args) cannot schedule its
    /// drop.  Spill the value into a stable slot and register it for a pad drop;
    /// the callee still receives the value and drops its own copy on the normal
    /// path, so this slot is dropped ONLY on the unwind path.  Qualifying args:
    ///   - a call / struct-literal result - a fresh owning rvalue temp; and
    ///   - a member access that moves an owning field out of an owned aggregate
    ///     (`f(p.first, g())`), a partial move.  Safe because the owner's drop
    ///     glue already skips the moved-out field (the same poison that keeps the
    ///     normal path from double-freeing it), so the pad drop is that field's
    ///     only drop on the unwind path.
    /// Never a bare identifier (the named machinery covers it; double-tracking
    /// would double-drop).  Caller gates on `--panic=unwind` and skips autoref
    /// (borrowed) args.
    maybe_record_arg_temp(mut &this, arg_expr: ExpressionNode*, arg_val: LValue) -> void {
        if (arg_expr == null || !arg_val.is_valid()) { return; }
        if (ExpressionNode::call_of(arg_expr) == null
            && ExpressionNode::struct_of(arg_expr) == null
            && ExpressionNode::member_access_of(arg_expr) == null) { return; }
        const ty: TypeRef = arg_expr.resolved_type;
        if (!ty.is_valid()) { return; }
        const arena: TypeArena* = this.cg.get_arena();
        if (arena == null) { return; }
        if (!OwnershipQuery::needs_drop(arena, this.cg.ctx.generic_registry,
                                        this.cg.get_intern(), ty)) { return; }
        const lty: LType = this.cg.type_mapper.map_type(ty);
        if (!lty.is_valid()) { return; }
        const slot: LValue = this.entry_spill_slot(lty, "argtemp");
        if (!slot.is_valid()) { return; }
        this.cg.builder.build_store(arg_val, slot);
        this.record_arg_temp_slot(slot, ty, arg_expr.span);
    }

    /// Does the method invoked by `node` consume its receiver by value (an
    /// explicit by-value `this` or an `![sink]`)?  Asks the method the call was
    /// pinned to, exactly as DropInsertion does, so the two passes agree on
    /// which receivers are moved into the call - the invariant that keeps a
    /// consumed anonymous receiver from being both dropped here and left for
    /// some other pass.  A call with no pinned method has no receiver to
    /// consume.
    call_consumes_receiver(&this, node: CallExpr*) -> boolean {
        const m_decl: DeclarationNode* = this.cg.get_decl_index().entry_method(node.resolved_callee.decl_entry());
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m == null) { return false; }
        const arena: TypeArena* = this.cg.get_arena();
        if (arena == null) { return false; }
        return OwnershipQuery::method_consumes_receiver(arena, this.cg.get_intern(), m_decl);
    }

    /// Emit the cleanup landing pad for an `invoke` under `--panic=unwind`.
    /// Builds the `{ ptr, i32 }` `landingpad` at the head of `lpad_bb`
    /// (cleanup-only: no catch clause, so the personality runs destructors and
    /// keeps unwinding rather than catching here), replays the call's drop
    /// schedule (`node.unwind_cleanup`, innermost-first) so live locals are
    /// freed on the unwind path, then `resume`s into the caller's frame.
    /// Attaches `__cryo_personality_v0` to the enclosing function (idempotent).
    /// The builder is restored to the block it was called in (the invoke's
    /// normal continuation) so normal-path codegen resumes there.
    ///
    /// The `landingpad` must be the first instruction in `lpad_bb`, so it is
    /// emitted before the drops; the drops themselves may open init-flag
    /// branches, leaving the builder at a later merge block, so `resume` is
    /// emitted wherever the last drop left off (still dominated by the
    /// landingpad, which is legal).
    /// The schedule-driven core lives on `ExprOps` (reachable from the
    /// synthesized-check origins too); this forwards the ordinary-call schedule
    /// to it.
    emit_cleanup_landingpad(mut &this, visitor: IRGeneratorVisitor*, node: CallExpr*,
                            cur_fn: LValue, lpad_bb: LBasicBlock) -> void {
        this.cg.expr_ops.emit_cleanup_landingpad_sched(
            visitor, &node.unwind_cleanup, cur_fn, lpad_bb);
    }

    /// The kind of the INTRINSIC a call is pinned to, or `Call` when the
    /// call is a function call.  The pin decides, by the kind the
    /// intrinsic's registration put on its entry: any other pin - the
    /// exported `std::core::panic` wrapper, a user's `rotl32`, an `extern
    /// "C"` declaration whose C symbol IS an intrinsic's leaf - is a real
    /// function with a body, whatever its leaf or its symbol; and a call
    /// with NO pin is a call through a VALUE - a parameter, a local or a
    /// field holding a function pointer - which is never an intrinsic,
    /// whatever the value is named.  No spelling is read here.
    pinned_intrinsic_kind(&this, node: CallExpr*) -> IntrinsicKind {
        return node.resolved_callee.intrinsic_kind(this.cg.get_decl_index());
    }

    /// Lower a call pinned to an intrinsic inline, for both callee shapes
    /// (`ptr_diff(..)` and `intrinsics::ptr_diff(..)`).  False when the
    /// call is a function call, or names an intrinsic the dispatcher
    /// declines (an arity it does not take), which then goes through the
    /// pin as a call.
    emit_pinned_intrinsic(mut &this, visitor: IRGeneratorVisitor*, e: ExpressionNode*,
                          node: CallExpr*) -> Option<Emitted> {
        const kind: IntrinsicKind = this.pinned_intrinsic_kind(node);
        if (kind == IntrinsicKind::Call) { return Option::None; }
        // `try_catch(body, data)` - the catch_unwind primitive.  Needs an
        // `invoke` + a catch-all landing pad + a phi (control flow the
        // generic `try_emit` inline path cannot build), so it is special-
        // lowered here rather than by the inline dispatcher.
        if (kind == IntrinsicKind::TryCatch) {
            return Option::Some(this.emit_catch_unwind(visitor, e, node));
        }
        if (kind == IntrinsicKind::Location) {
            return Option::Some(Emitted::rvalue(this.emit_location(e)));
        }
        if (kind == IntrinsicKind::Panic) {
            return Option::Some(this.emit_panic(visitor, node));
        }
        // `args` is scoped to this call: it is built and moved into
        // `try_emit` unconditionally, so nothing is left conditionally
        // moved past the if.
        mut args: [LValue] = [];
        for (mut ai: i64 = 0; ai < node.arguments.length(); ai++) {
            args.push(this.dispatch.codegen_rvalue(visitor, node.arguments[ai]));
        }
        return match (this.cg.intrinsics.try_emit(kind, args)) {
            Option::Some(v) => { Option::Some(Emitted::rvalue(v)) }
            Option::None    => { Option::None }
        };
    }

    /// `intrinsics::panic(message, loc)`: the funnel, given the message and
    /// the address of `loc`.
    emit_panic(mut &this, visitor: IRGeneratorVisitor*, node: CallExpr*) -> Emitted {
        const msg: LValue = this.dispatch.codegen_rvalue(visitor, node.arguments[0]);
        const loc: LValue = this.location_address(this.dispatch.codegen_rvalue(visitor, node.arguments[1]));
        // `--panic=unwind` direct-panic drop-completeness: route the panic
        // funnel through an invoke + cleanup landing pad so the frame's live
        // droppable locals drop on unwind (a plain call bypasses the
        // invoke-swap and leaks them).  Gated on a hosted unwind build WITH
        // live locals; every other case is the plain call.
        if (this.cg.ctx.options.unwinds()
            && !this.cg.intrinsics.no_runtime
            && (node.unwind_cleanup.length() > 0
                || this.cg.expr_ops.has_live_arg_temps())) {
            return this.emit_panic_unwind(visitor, node, msg, loc);
        }
        this.cg.intrinsics.emit_panic_call(msg, loc);
        return Emitted::rvalue(LValue::null());
    }

    /// The address of the `Location` value `v`: a constant one (a
    /// `location()` outside a `![caller_location]` body) as a private
    /// constant, any other through `address_of_value`.
    location_address(mut &this, v: LValue) -> LValue {
        if (llvm::LLVMIsConstant(v.raw) == 0) { return this.address_of_value(v); }
        mut g: LValue = this.cg.llvm_module.add_global(v.type_of(), MangledName::new("panic.location"));
        g.set_initializer(v);
        g.set_global_constant(true);
        g.set_linkage(LLinkage::Private);
        return g;
    }

    /// Direct-panic origin under `--panic=unwind`: emit the funnel as an
    /// `invoke` into a cleanup landing pad that drops the frame's live locals
    /// (innermost-first) before the unwind continues, then `resume`s.  Reuses
    /// `node.unwind_cleanup` (DropInsertion populates it for EVERY call, panic
    /// included).
    emit_panic_unwind(mut &this, visitor: IRGeneratorVisitor*, node: CallExpr*,
                      msg: LValue, loc: LValue) -> Emitted {
        mut out: Emitted = Emitted::none();
        const cur_fn: LValue = this.get_current_function();
        if (!cur_fn.is_valid()) {
            // No enclosing function to hang a landing pad on; diverge plainly.
            this.cg.intrinsics.emit_panic_call(msg, loc);
            return out;
        }
        const cont_bb: LBasicBlock = LBasicBlock::append(cur_fn, "panic.cont");
        const lpad_bb: LBasicBlock = LBasicBlock::append(cur_fn, "panic.lpad");

        const panic_fn: LValue = this.cg.intrinsics.get_or_decl_cryo_panic();
        const fty: LType = LType { raw: llvm::LLVMGlobalGetValueType(panic_fn.raw) };
        const arg_buf: void* = libc::malloc(16);
        const arg_slots: void** = arg_buf as void**;
        arg_slots[0] = msg.raw;
        arg_slots[1] = loc.raw;

        // Arm the invoke swap so `build_call_maybe_invoke` emits
        // `invoke @__cryo_panic(...) to cont unwind lpad` and leaves the
        // builder at `cont`.
        this.cg.expr_ops.invoke_active = true;
        this.cg.expr_ops.invoke_normal = cont_bb;
        this.cg.expr_ops.invoke_lpad   = lpad_bb;
        this.cg.expr_ops.build_call_maybe_invoke(fty, panic_fn, arg_buf, 2, "");
        this.cg.expr_ops.invoke_active = false;
        libc::free(arg_buf);

        // The funnel is noreturn: its invoke normal-dest is unreachable.
        this.cg.builder.build_unreachable();

        // Cleanup pad: drop the frame's live locals, then resume the unwind.
        this.emit_cleanup_landingpad(visitor, node, cur_fn, lpad_bb);

        out.value = LValue::null();
        out.is_lvalue = false;
        return out;
    }

    /// Lower the `try_catch(body, data)` catch_unwind primitive.  `body` is an
    /// opaque `(void*) -> void` trampoline (the stdlib `catch_unwind` wrapper
    /// builds it, capturing the real body fn-ptr + the result slot in `data`),
    /// so this lowering needs no knowledge of the caught value's type.
    ///
    /// Under `--panic=unwind`:
    ///   invoke body(data) to cu.cont unwind cu.lpad
    /// cu.cont:  br cu.done                        ; body returned normally
    /// cu.lpad:  landingpad {ptr,i32} catch null   ; a panic unwound to here
    ///           br cu.done
    /// cu.done:  %caught = phi i1 [false,cu.cont],[true,cu.lpad]
    /// yielding `%caught` (boolean).  The pad is catch-all + UNCONDITIONAL (it
    /// never inspects the selector): every Cryo panic that unwinds this far is
    /// caught.  Attaching a catch clause here is what makes this frame the
    /// Itanium phase-1 handler, so the intermediate frames' cleanup landing
    /// pads (Phase C) actually run their drops in phase 2.
    ///
    /// `catch_unwind` requires `--panic=unwind`: it is meaningless under the
    /// abort strategy (a panic terminates the process rather than unwinding, so
    /// there is nothing to catch) and its runtime payload accessors live only in
    /// the unwind tier.  Off `--panic=unwind` this is a clear compile error
    /// rather than a plain call that would fail to link with undefined
    /// `__cryo_panic_taken_*` symbols.  The default path never reaches here (the
    /// stdlib `catch_unwind` is generic and uninstantiated unless a program
    /// calls it), so this leaves the default IR byte-identical.
    emit_catch_unwind(mut &this, visitor: IRGeneratorVisitor*, e: ExpressionNode*,
                      node: CallExpr*) -> Emitted {
        mut out: Emitted = Emitted::none();
        if (node.arguments.length() != 2) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0636_UNDEFINED_FUNCTION_CALL,
                "codegen: try_catch expects exactly two arguments (body, data)",
                e.span);
            out.value = LValue::null();
            out.is_lvalue = false;
            return out;
        }

        if (!this.cg.ctx.options.unwinds()) {
            this.cg.diag.emit_error_at_span(ErrorCode::E0600_CODEGEN_FAILED,
                "`catch_unwind` requires the unwinding panic strategy; rebuild with `--panic=unwind` (or set `panic = \"unwind\"` in cryoconfig). Under the default `--panic=abort` a panic terminates the process, so there is nothing to catch.",
                e.span);
            out.value = LValue::null();
            out.is_lvalue = false;
            return out;
        }

        const body_ptr: LValue = this.dispatch.codegen_rvalue(visitor, node.arguments[0]);
        const data_ptr: LValue = this.dispatch.codegen_rvalue(visitor, node.arguments[1]);
        if (!body_ptr.is_valid() || !data_ptr.is_valid()) {
            out.value = LValue::null();
            out.is_lvalue = false;
            return out;
        }

        // Trampoline LLVM type: `void (ptr)`.
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const param_buf: void* = libc::malloc(8);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ptr_ty.raw;
        const body_fty: LType = LType::function_type(LType::void_type(), param_buf, 1, false);
        libc::free(param_buf);

        const arg_buf: void* = libc::malloc(8);
        const arg_slots: void** = arg_buf as void**;
        arg_slots[0] = data_ptr.raw;

        const bool_ty: LType = LType::i1();

        const cur_fn: LValue = this.get_current_function();
        if (!cur_fn.is_valid()) {
            libc::free(arg_buf);
            out.value = LValue::null();
            out.is_lvalue = false;
            return out;
        }

        const cont_bb: LBasicBlock = LBasicBlock::append(cur_fn, "cu.cont");
        const lpad_bb: LBasicBlock = LBasicBlock::append(cur_fn, "cu.lpad");
        const done_bb: LBasicBlock = LBasicBlock::append(cur_fn, "cu.done");

        // Any function with a landing pad needs the personality attached.
        const pers: LValue = this.cg.expr_ops.get_or_decl_personality();
        if (pers.is_valid()) { cur_fn.set_personality_fn(pers); }

        // `invoke` is a terminator; the builder must be repositioned to a real
        // block before any further emission (done below at cont_bb).
        this.cg.builder.build_invoke(body_fty, body_ptr, arg_buf, 1, cont_bb, lpad_bb, "");
        libc::free(arg_buf);

        const false_val: LValue = LType::const_int(bool_ty, 0, false);
        const true_val: LValue = LType::const_int(bool_ty, 1, false);

        // Normal edge: body returned; nothing was caught.
        this.cg.builder.position_at_end(cont_bb);
        this.cg.builder.build_br(done_bb);

        // Unwind edge: catch-all landing pad.  The landingpad must be the first
        // non-phi instruction in the block.  No `set_cleanup` - the catch
        // clause alone makes this the phase-1 handler.
        this.cg.builder.position_at_end(lpad_bb);
        const lpad_ty: LType = this.cg.expr_ops.landingpad_type();
        const lp: LValue = this.cg.builder.build_landing_pad(lpad_ty, 1, "cu.eh");
        lp.add_clause(LType::const_pointer_null(ptr_ty));
        this.cg.builder.build_br(done_bb);

        // Merge: caught flag.
        this.cg.builder.position_at_end(done_bb);
        const phi: LValue = this.cg.builder.build_phi(bool_ty, "cu.caught");
        const vals_buf: void* = libc::malloc(16);
        const vals: void** = vals_buf as void**;
        vals[0] = false_val.raw;
        vals[1] = true_val.raw;
        const blks_buf: void* = libc::malloc(16);
        const blks: void** = blks_buf as void**;
        blks[0] = cont_bb.raw;
        blks[1] = lpad_bb.raw;
        phi.add_incoming(vals_buf, blks_buf, 2);
        libc::free(vals_buf);
        libc::free(blks_buf);

        out.value = phi;
        out.is_lvalue = false;
        return out;
    }

    /// The callee's Cryo `FunctionType` when an argument MIGHT need the Win64
    /// `va_list` by-value forwarding load (see the argument loop), else null.
    ///
    /// Gated so the argument loop is byte-identical everywhere it does not
    /// apply: returns null off Win64 (SysV passes the `__va_list_tag[1]` pointer
    /// directly, which already IS the by-value form), and null for method calls
    /// (a `MemberAccess` callee) - methods never take `va_list`, and skipping
    /// them keeps `node.arguments[i]` aligned with `param_types[i]` without a
    /// receiver offset.  `va_list` parameters therefore only arise on the
    /// free/extern call paths handled here.
    va_forward_fn_type(mut &this, node: CallExpr*) -> FunctionType* {
        if (!this.cg.abi.is_win64()) { return null; }
        if (node.callee == null) { return null; }
        // Only free / extern-"C" callees (bare identifier or `Scope::member`)
        // carry a `va_list` parameter; methods (`MemberAccess`) never do, so we
        // skip them - which also keeps `node.arguments[i]` aligned with
        // `param_types[i]` (no receiver in the parameter list).
        if (ExpressionNode::identifier_of(node.callee) == null
                && ExpressionNode::scope_resolution_of(node.callee) == null) {
            return null;
        }
        // The signature is the PINNED callee's: the bare slot under the
        // written leaf is last-writer-wins across every module declaring it,
        // and would hand another module's `write` its parameter list.
        const ft_ref: TypeRef = this.cg.resolver.pinned_signature(node.resolved_callee);
        if (!ft_ref.is_valid()) { return null; }
        const ct: Type* = this.cg.arena_type(ft_ref);
        if (ct == null || ct.kind != TypeKind::Function) { return null; }
        return ct.as_function();
    }

    /// Drop-glue expansion for an aggregate with no user-written `drop`.
    /// Returns true when the receiver type is a kind glue handles, so the
    /// caller suppresses the "no method" error.  Structs recurse
    /// into each droppable field in place; other aggregate kinds are not yet
    /// expanded and return true as a no-op (keeping today's behavior).
    emit_drop_glue(mut &this, visitor: IRGeneratorVisitor*, receiver: ExpressionNode*,
                   ty: TypeRef) -> boolean {
        const arena: TypeArena* = this.cg.get_arena();
        if (arena == null) { return false; }

        // Peel InstantiatedType wrappers to the concrete underlying type.
        mut cur: TypeRef = ty;
        mut t: Type* = arena.lookup(cur);
        mut guard: i32 = 0;
        while (t != null && t.kind == TypeKind::InstantiatedType && guard < 16) {
            const inst: InstantiatedType* = t.as_instantiated();
            if (!inst.has_resolved_type()) { break; }
            cur = inst.resolved_type;
            t = arena.lookup(cur);
            guard = guard + 1;
        }
        if (t == null) { return false; }

        if (t.kind == TypeKind::Struct) {
            const st: StructType* = t.as_struct();
            this.emit_field_drops(visitor, receiver, st.fields);
            return true;
        }
        if (t.kind == TypeKind::Enum) {
            const et: EnumType* = t.as_enum();
            this.emit_enum_drop_glue(visitor, receiver, et, cur);
            return true;
        }
        if (t.kind == TypeKind::Array) {
            const at: ArrayType* = t.as_array();
            // A fixed array owns its elements in place: drop each.
            if (OwnershipQuery::needs_drop(arena, this.cg.ctx.generic_registry,
                                           this.cg.get_intern(), at.element)) {
                this.emit_fixed_array_drops(visitor, receiver, at);
            }
            return true;
        }
        if (t.kind == TypeKind::Tuple) {
            const tt: TupleType* = t.as_tuple();
            this.emit_tuple_element_drops(visitor, receiver, tt);
            return true;
        }
        // User-written `T?` desugars to Option<T> (an Enum, handled above), so
        // no Optional type reaches here; anything else that does owns nothing.
        return true;
    }

    /// Drop each owning element of a tuple in place via synthesized
    /// `receiver.N.drop()` calls.  Tuple positional access is a member access
    /// whose member symbol is the decimal index (see `place_emitter`'s Tuple
    /// branch), so the element access is built exactly like a struct field's
    /// and re-enters the normal `.drop()` lowering - elements without a user
    /// drop recurse back through glue.
    emit_tuple_element_drops(mut &this, visitor: IRGeneratorVisitor*,
                             receiver: ExpressionNode*, tt: TupleType*) -> void {
        if (tt == null) { return; }
        const arena: TypeArena* = this.cg.get_arena();
        if (arena == null) { return; }
        const registry: GenericRegistry* = this.cg.ctx.generic_registry;
        const intern: InternTable* = this.cg.get_intern();
        const drop_sym: SymbolStr = intern.intern("drop");
        for (mut i: i64 = 0; i < tt.elements.length(); i++) {
            const elem_type: TypeRef = tt.elements[i];
            if (!OwnershipQuery::needs_drop(arena, registry, intern, elem_type)) {
                continue;
            }
            const idx_sym: SymbolStr = intern.intern(fmt::format("%ld", i));
            mut elem_access: ExpressionNode* = ExpressionNode::member_access_expr(
                receiver, idx_sym, receiver.span, receiver.span);
            elem_access.set_resolved_type(elem_type);
            // Minted after the last sema walk: the element is the i-th.
            ExpressionNode::member_access_of(elem_access).set_resolved_member(MemberPin::Field(i));
            mut drop_access: ExpressionNode* = ExpressionNode::member_access_expr(
                elem_access, drop_sym,
                receiver.span, receiver.span);
            mut call: ExpressionNode* = ExpressionNode::call_expr(
                drop_access, receiver.span);
            this.cg.bind_destructor_call(call);
            mut stmt: Stmt* = Stmt::expr_stmt(
                call, receiver.span);
            visitor.dispatch_node(Node::Stmt(stmt));
        }
    }

    /// Drop each element of a fixed-size array in place via synthesized
    /// `receiver[i].drop()` calls.  Re-enters the normal `.drop()` lowering
    /// per element, so elements that themselves lack a user drop recurse
    /// through glue (e.g. an array of structs of strings drops every string).
    emit_fixed_array_drops(mut &this, visitor: IRGeneratorVisitor*,
                           receiver: ExpressionNode*, at: ArrayType*) -> void {
        if (at == null) { return; }
        const arena: TypeArena* = this.cg.get_arena();
        if (arena == null) { return; }
        const intern: InternTable* = this.cg.get_intern();
        const drop_sym: SymbolStr = intern.intern("drop");
        const idx_type: TypeRef = arena.get_i64();
        const n: i64 = at.size;
        for (mut i: i64 = 0; i < n; i++) {
            const idx_str: string = fmt::format("%ld", i);
            mut idx_lit: ExpressionNode* = ExpressionNode::literal(
                idx_str, LiteralKind::Integer, receiver.span);
            idx_lit.set_resolved_type(idx_type);
            mut arr_access: ExpressionNode* = ExpressionNode::array_access_expr(
                receiver, idx_lit, receiver.span);
            arr_access.set_resolved_type(at.element);
            mut drop_access: ExpressionNode* = ExpressionNode::member_access_expr(
                arr_access, drop_sym,
                receiver.span, receiver.span);
            mut call: ExpressionNode* = ExpressionNode::call_expr(
                drop_access, receiver.span);
            this.cg.bind_destructor_call(call);
            mut stmt: Stmt* = Stmt::expr_stmt(
                call, receiver.span);
            visitor.dispatch_node(Node::Stmt(stmt));
        }
    }

    /// Synthesize `receiver.field.drop()` for each field whose type needs
    /// drop, routed through the normal `.drop()` lowering (which handles user
    /// drops, Copy no-ops, and recursive glue).  In place: the member access
    /// yields a pointer into the receiver, so a leaf drop nulls that storage
    /// and any later re-drop is a no-op.
    emit_field_drops(mut &this, visitor: IRGeneratorVisitor*, receiver: ExpressionNode*,
                     fields: &[FieldInfo]) -> void {
        const arena: TypeArena* = this.cg.get_arena();
        const registry: GenericRegistry* = this.cg.ctx.generic_registry;
        const intern: InternTable* = this.cg.get_intern();
        const drop_sym: SymbolStr = intern.intern("drop");
        for (mut i: i64 = 0; i < fields.length(); i++) {
            const f: FieldInfo = fields[i];
            if (!OwnershipQuery::needs_drop(arena, registry, intern, f.field_type)) {
                continue;
            }
            mut field_access: ExpressionNode* = ExpressionNode::member_access_expr(
                receiver, f.decl_name().spelling(), receiver.span, receiver.span);
            field_access.set_resolved_type(f.field_type);
            // Minted after the last sema walk: the field is the i-th of the
            // aggregate's own list, which is the list walked here.
            ExpressionNode::member_access_of(field_access).set_resolved_member(MemberPin::Field(i));
            mut drop_access: ExpressionNode* = ExpressionNode::member_access_expr(
                field_access, drop_sym,
                receiver.span, receiver.span);
            mut call: ExpressionNode* = ExpressionNode::call_expr(
                drop_access, receiver.span);
            this.cg.bind_destructor_call(call);
            mut stmt: Stmt* = Stmt::expr_stmt(
                call, receiver.span);
            visitor.dispatch_node(Node::Stmt(stmt));
        }
    }

    /// Drop-glue for an enum with no user drop: switch on the discriminant
    /// and drop the active variant's droppable payload(s) in place.  Mirrors
    /// the tag-load + payload-GEP machinery in PatternEmitter; each payload is
    /// registered as a synthetic named lvalue and dropped via the normal
    /// `.drop()` lowering (so a payload that itself lacks a user drop recurses
    /// through glue).  `enum_ref` is the concrete (peeled) enum TypeRef.
    emit_enum_drop_glue(mut &this, visitor: IRGeneratorVisitor*, receiver: ExpressionNode*,
                        et: EnumType*, enum_ref: TypeRef) -> void {
        if (et == null) { return; }
        if (et.is_simple_enum()) { return; }   // no payloads -> nothing to drop

        const arena: TypeArena* = this.cg.get_arena();
        const registry: GenericRegistry* = this.cg.ctx.generic_registry;
        const intern: InternTable* = this.cg.get_intern();
        const drop_sym: SymbolStr = intern.intern("drop");

        // Count variants with at least one droppable payload (switch arity).
        mut ndrop: u32 = 0;
        for (mut vi: i64 = 0; vi < et.variants.length(); vi++) {
            if (OwnershipQuery::any_needs_drop(arena, registry, intern,
                    et.variants[vi].payload_types, 0)) {
                ndrop = ndrop + 1;
            }
        }
        if (ndrop == 0) { return; }

        // Borrow the receiver's storage (a pointer into it; never a copy).
        const subject_ptr: LValue = this.dispatch.codegen_lvalue(visitor, receiver);
        if (!subject_ptr.is_valid()) { return; }
        const enum_llvm: LType = this.cg.type_mapper.map_type(enum_ref);
        if (!enum_llvm.is_valid()) { return; }

        // tag = enum.0 ; payload base = enum.1
        const tag_ptr: LValue = this.cg.builder.build_struct_gep(
            enum_llvm, subject_ptr, 0, "glue.tag.ptr");
        if (!tag_ptr.is_valid()) { return; }
        const tag: LValue = this.cg.builder.build_load(LType::i32(), tag_ptr, "glue.tag");
        const payload_ptr: LValue = this.cg.builder.build_struct_gep(
            enum_llvm, subject_ptr, 1, "glue.payload.ptr");
        if (!payload_ptr.is_valid()) { return; }

        const cur_bb: LBasicBlock = this.cg.builder.get_insert_block();
        if (!cur_bb.is_valid()) { return; }
        const fn: LValue = cur_bb.get_parent();
        const after_bb: LBasicBlock = LBasicBlock::append(fn, "glue.after");
        const sw: LValue = this.cg.builder.build_switch(tag, after_bb, ndrop);

        for (mut vi: i64 = 0; vi < et.variants.length(); vi++) {
            const v: &EnumVariantInfo = &et.variants[vi];
            if (!OwnershipQuery::any_needs_drop(arena, registry, intern,
                    v.payload_types, 0)) {
                continue;   // C-style / all-Copy payloads: default arm (after_bb)
            }
            const drop_bb: LBasicBlock = LBasicBlock::append(fn, "glue.vdrop");
            sw.add_case(LType::const_int(LType::i32(), v.tag_value, false), drop_bb);
            this.cg.builder.position_at_end(drop_bb);

            // Field offsets from the single layout authority
            // (TypeArena::variant_payload_layout) - the SAME align-up
            // offsets construction stored the fields at.  The packed
            // running sum this replaced dropped e.g. `V(u32, String)`'s
            // String from packed offset 4 while construction wrote it at
            // aligned offset 8 - freeing a garbage pointer.
            const offsets: [u64] = arena.variant_payload_layout(v, null, null);
            for (mut pos: i64 = 0; pos < v.payload_types.length(); pos++) {
                const pt: TypeRef = v.payload_types[pos];
                if (OwnershipQuery::needs_drop(arena, registry, intern, pt)) {
                    // field_ptr = payload base + offsets[pos] (byte offset)
                    mut field_ptr_raw: LValue = payload_ptr;
                    if (offsets[pos] != 0) {
                        const byte_off: LValue = LType::const_int(LType::i64(), offsets[pos], false);
                        const obuf: void* = libc::malloc(8);
                        const obuf_arr: void** = obuf as void**;
                        obuf_arr[0] = byte_off.raw;
                        field_ptr_raw = this.cg.builder.build_gep(
                            LType::i8(), payload_ptr, obuf, 1, "glue.field.ptr");
                        libc::free(obuf);
                    }
                    const field_llvm: LType = this.cg.type_mapper.map_type(pt);
                    const field_ptr: LValue = this.cg.builder.build_bitcast(
                        field_ptr_raw, LType::pointer_to(field_llvm), "glue.field.cast");
                    // Register the payload pointer as a synthetic lvalue and
                    // drop it via the normal `.drop()` path (handles user
                    // drops, Copy no-ops, and recursive glue).
                    const nm: SymbolStr = intern.intern(
                        fmt::format("__glue_payload_%d", this.glue_seq));
                    this.glue_seq = this.glue_seq + 1;
                    const nm_sym: SymbolID = this.cg.ctx.resolver.alloc_synthetic_binding();
                    this.cg.values.set(nm_sym, field_ptr);
                    const id_node: ExpressionNode* = ExpressionNode::identifier_expr(nm, receiver.span);
                    ExpressionNode::identifier_of(id_node).set_res(Res::Local(nm_sym));
                    id_node.set_resolved_type(pt);
                    mut da: ExpressionNode* = ExpressionNode::member_access_expr(
                        id_node, drop_sym, receiver.span, receiver.span);
                    mut call: ExpressionNode* = ExpressionNode::call_expr(
                        da, receiver.span);
                    this.cg.bind_destructor_call(call);
                    mut stmt: Stmt* = Stmt::expr_stmt(
                        call, receiver.span);
                    visitor.dispatch_node(Node::Stmt(stmt));
                }
            }

            // Branch to the merge block from wherever payload drops left the
            // insert point (a nested glue payload may have added blocks).
            const end_bb: LBasicBlock = this.cg.builder.get_insert_block();
            if (end_bb.is_valid() && !end_bb.has_terminator()) {
                this.cg.builder.build_br(after_bb);
            }
        }

        this.cg.builder.position_at_end(after_bb);
    }

    /// Walk the module graph and return every qualified function name that
    /// matches `<full_namespace>::<member>` where `<full_namespace>` ends with
    /// `::scope_str` (or equals `scope_str` exactly).  Used by the
    /// ScopeResolution codegen path so a shorthand `libc::read` resolves
    /// directly to `std::ffi::libc::read`, instead of falling through to the
    /// last-write-wins bare-name overload slot.
    ///
    /// Only entries that have a probe-able function signature in the codegen
    /// (arity-matched declaration) are returned.  A length-1 result is the
    /// happy path; length > 1 surfaces an E0154 ambiguity at the call site.
}
