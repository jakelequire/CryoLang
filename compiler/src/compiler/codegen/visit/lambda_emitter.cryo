/// Lambda Emitter
///
/// Lambda-expression lowering: mint a unique anonymous function symbol,
/// resolve its parameter and return types, materialise the function in
/// the current LLVM module, bind parameters to allocas, recurse the body
/// through the visitor (so each statement dispatches to the right
/// `override visit(...)`), and surface the resulting function-pointer
/// LValue back through the visitor's `state` return channel.
///
/// Holds `cg: CodegenContext*` (heavy machinery - type mapper, function
/// registry, IR-flow allocas, builder) and `state: VisitorState*` (for
/// the per-module `lambda_counter`).  The visitor passes itself as
/// `ASTVisitor*` so body statements can recurse via `accept(visitor)`
/// without importing the concrete `IRGeneratorVisitor` type (which
/// would form a module-graph cycle).

namespace Compiler::Codegen::Visit::LambdaEmitter;

import Compiler::Codegen;
import Compiler::Codegen::{ LLVMTypes, Context, Util };
import Compiler::Codegen::State::VisitorState;
import Compiler::CompilationContext;
import Compiler::Diag;
import Compiler::Types;
import Compiler::Types::{ TypeRef, Resolver };
import Compiler::AST;
import Compiler::AST::{ Node, Visitor, Expression, Statement, Declaration };
import Compiler::Resolver::{ SymbolStr, InternTable };


type struct LambdaEmitter {
    // Back-pointers set by wire().  Null until wire() runs.
    cg:    CodegenContext*;
    state: VisitorState*;

    static null() -> LambdaEmitter {
        return LambdaEmitter {
            cg:    null,
            state: null,
        };
    }

    wire(mut &this, cg: CodegenContext*, state: VisitorState*) -> void {
        this.cg    = cg;
        this.state = state;
    }


    // Lambda emission

    /// Lambda expression codegen.  Two cases:
    ///
    /// 1. **Non-capturing** (`node.is_capturing() == false`): emit an
    ///    anonymous function with the lambda's signature, return its
    ///    function pointer as the lambda's value.  Each parameter must
    ///    carry a type annotation and the return type must be written
    ///    out (`-> T`) - the existing semantics.
    ///
    /// 2. **Capturing** (`node.is_capturing() == true`): Sema has already
    ///    synthesised the closure StructDecl + `__call__` method and
    ///    stamped the lambda's `resolved_type` with the closure struct
    ///    type.  Codegen materialises an instance of that struct here by
    ///    building a transient `StructLiteralNode` whose field-init values
    ///    are `IdentifierNode`s naming each capture, then routing it
    ///    through the visitor's standard dispatch.  No standalone function
    ///    is emitted for the lambda body itself - that lives on the
    ///    synthesised `__call__` method, which goes through ordinary
    ///    method codegen as part of the injected StructDecl.
    ///
    /// `visitor` is the parent IRGeneratorVisitor, accepted as `ASTVisitor*`
    /// so this module doesn't have to import the concrete visitor type
    /// (cycle-avoidance - `ir_generator.cryo` already imports this module
    /// to hold a `LambdaEmitter` field).
    emit(mut &this, visitor: ASTVisitor*, node: LambdaExprNode*) -> void {
        if (node == null) {
            this.state.last_value     = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        if (node.is_capturing()) {
            this.emit_capturing(visitor, node);
            return;
        }

        const ctx_ptr: CompilationContext* = this.cg.ctx;
        const intern:  InternTable*        = this.cg.get_intern();

        // Per-module counter; the namespace prefix keeps cross-module
        // lambda symbols unique at link time (lambdas have external
        // linkage), so each visitor instance can start fresh at 0.
        const lam_idx: u64 = this.state.lambda_counter;
        this.state.lambda_counter += 1;
        const ns_str: string = if (ctx_ptr.has_namespace()) {
            ctx_ptr.namespace_display()
        } else {
            ctx_ptr.source_file
        };
        const lam_name: string = format("%s::__lambda_%lld", ns_str, lam_idx as i64);

        // Resolve return type
        mut ret_ty: LType = LType::void_type();
        if (node.return_type.is_valid()) {
            // Sema already filled it in.
            const mapped: LType = this.cg.type_mapper.map_type(node.return_type);
            if (mapped.is_valid()) { ret_ty = mapped; }
        } else if (node.return_type_ann != null && ctx_ptr.type_resolver != null) {
            mut res_ctx: ResolutionContext = ResolutionContext::new(
                ctx_ptr.source_file, "");
            const ret_ref: TypeRef = ctx_ptr.type_resolver.resolve(node.return_type_ann, &res_ctx);
            if (ret_ref.is_valid()) {
                const mapped: LType = this.cg.type_mapper.map_type(ret_ref);
                if (mapped.is_valid()) { ret_ty = mapped; }
            }
        }

        // Resolve parameter types
        const param_count: u32 = node.parameters.length as u32;
        const param_buf: void* = intrinsics::malloc(param_count as u64 * 8);
        const param_slots: void** = param_buf as void**;
        mut params_valid: boolean = true;

        mut res_ctx2: ResolutionContext = ResolutionContext::new(
            ctx_ptr.source_file, "");

        mut param_refs: TypeRef[] = [];
        for (mut i: u32 = 0; i < param_count; i++) {
            const param: VarDeclNode* = node.parameters[i];
            mut param_ty: LType = LType::null();

            if (param.resolved_type.is_valid()) {
                param_ty = this.cg.type_mapper.map_type(param.resolved_type);
            } else if (param.type_annotation != null && ctx_ptr.type_resolver != null) {
                const pref: TypeRef = ctx_ptr.type_resolver.resolve(
                    param.type_annotation, &res_ctx2);
                param_refs.push(pref);
                if (pref.is_valid()) {
                    param_ty = this.cg.type_mapper.map_type(pref);
                }
            }

            if (!param_ty.is_valid()) {
                this.cg.diag.emit_warning_at_span(ErrorCode::E0600_CODEGEN_FAILED,
                    format("lambda: cannot resolve type for parameter '%s'; lambda skipped",
                        intern.resolve(param.name)),
                    param.span);
                params_valid = false;
                break;
            }
            param_slots[i] = param_ty.raw;
        }

        if (!params_valid) {
            intrinsics::free(param_buf);
            this.state.last_value     = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        // Build LLVM function
        const fn_type: LType  = LType::function_type(ret_ty, param_buf, param_count, false);
        intrinsics::free(param_buf);
        const fn_val: LValue  = this.cg.llvm_module.add_function(lam_name, fn_type);
        if (!fn_val.is_valid()) {
            this.state.last_value     = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        // Register so that cross-module references can find it.
        const lam_sym: SymbolStr = intern.intern(lam_name);
        this.cg.functions.register(lam_sym, fn_val);

        // Save builder insertion point (we're mid-function)
        const saved_bb: LBasicBlock = this.cg.builder.get_insert_block();

        // Build function entry block + body
        const entry_bb: LBasicBlock = LBasicBlock::append(fn_val, "entry");
        this.cg.builder.position_at_end(entry_bb);
        this.cg.values.push_scope();

        // Bind each parameter to an alloca so the body can refer to them.
        for (mut pi: u32 = 0; pi < param_count; pi++) {
            const param: VarDeclNode* = node.parameters[pi];
            const param_name: string  = intern.resolve(param.name);

            // Re-derive the LLVM type for the alloca.
            mut p_ty: LType = LType::null();
            if (param.resolved_type.is_valid()) {
                p_ty = this.cg.type_mapper.map_type(param.resolved_type);
            } else if (pi < param_refs.length as u32 && param_refs[pi as i64].is_valid()) {
                p_ty = this.cg.type_mapper.map_type(param_refs[pi as i64]);
            }
            if (!p_ty.is_valid()) { continue; }

            const alloca: LValue = this.cg.flow.create_entry_alloca(fn_val, param_name, p_ty);
            const arg:    LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, pi) };
            this.cg.builder.build_store(arg, alloca);
            this.cg.values.set(param.name, alloca);
        }

        // Generate the body.  Inline the small generate_block / accept loop
        // here so this module doesn't have to call back through the visitor
        // for the helpers (which aren't on ASTVisitor).
        if (node.body != null) {
            if (node.body.kind == NodeKind::BlockStatement) {
                const blk: BlockStmtNode* = node.body as BlockStmtNode*;
                for (mut bi: i64 = 0; bi < blk.statements.length; bi++) {
                    const current: LBasicBlock = this.cg.builder.get_insert_block();
                    if (current.is_valid() && current.has_terminator()) {
                        break;
                    }
                    const stmt: StatementNode* = blk.statements[bi];
                    if (stmt != null) {
                        stmt.accept(visitor);
                    }
                }
            } else {
                node.body.accept(visitor);
            }
        }

        // Ensure the entry block has a terminator.
        const cur_bb: LBasicBlock = this.cg.builder.get_insert_block();
        if (cur_bb.is_valid() && !cur_bb.has_terminator()) {
            const rk: LTypeKind = type_kind_of(ret_ty.raw);
            if (rk == LTypeKind::Void) {
                this.cg.builder.build_ret_void();
            } else {
                // Non-void without a terminator -> unreachable.
                this.cg.builder.build_unreachable();
            }
        }

        // Sweep orphaned empty blocks (same as codegen_function_epilogue).
        mut sweep_bb: void* = llvm::LLVMGetFirstBasicBlock(fn_val.raw);
        while (sweep_bb != null) {
            const lbb: LBasicBlock = LBasicBlock { raw: sweep_bb };
            if (!lbb.has_terminator()
                    && llvm::LLVMGetFirstInstruction(sweep_bb) == null) {
                this.cg.builder.position_at_end(lbb);
                this.cg.builder.build_unreachable();
            }
            sweep_bb = llvm::LLVMGetNextBasicBlock(sweep_bb);
        }

        this.cg.values.pop_scope();

        // Restore the outer function's insert point
        if (saved_bb.is_valid()) {
            this.cg.builder.position_at_end(saved_bb);
        }

        // The value of a lambda expression is the function pointer itself.
        this.state.last_value     = fn_val;
        this.state.last_is_lvalue = false;
    }

    /// Capturing-lambda codegen: materialise a value of the closure struct
    /// type stamped on `node.resolved_type` by Sema, with each field
    /// initialised from the corresponding captured local in scope.  Built
    /// as a transient `StructLiteralNode` so the normal struct-literal
    /// codegen path handles the alloca + GEP-store sequence; we just
    /// supply identifier-node initialisers whose lookups land on
    /// `cg.values.get(<cap_name>)` for the outer function's allocas.
    ///
    /// No anonymous function is emitted from this site: the lambda's body
    /// lives on the synthesised `<closure_struct>::__call__` method,
    /// emitted by ordinary method codegen when the StructDecl Sema
    /// injected reaches Phase 7's codegen sweep.
    emit_capturing(mut &this, visitor: ASTVisitor*, node: LambdaExprNode*) -> void {
        const closure_ty: TypeRef = node.resolved_type;
        if (!closure_ty.is_valid()) {
            // Sema should have set this; if not, fall back to a null value
            // and let downstream verification catch the bug.
            this.state.last_value     = LValue::null();
            this.state.last_is_lvalue = false;
            return;
        }

        const arena: TypeArena* = this.cg.ctx.type_arena;
        const struct_name: SymbolStr = arena.get_qualified_name(closure_ty);

        mut lit: StructLiteralNode* = new StructLiteralNode(struct_name, node.span);
        lit.set_resolved_type(closure_ty);

        for (mut i: i64 = 0; i < node.captured_names.length; i++) {
            const cap_name: SymbolStr = node.captured_names[i];
            const cap_ty:   TypeRef   = node.captured_types[i];
            mut ident: IdentifierNode* = new IdentifierNode(cap_name, node.span);
            ident.set_resolved_type(cap_ty);
            const init: FieldInit = FieldInit {
                field_name: cap_name,
                value:      ident as ExpressionNode*,
                span:       node.span,
            };
            lit.add_field_init(init);
        }

        // Dispatch through the visitor so the existing StructLiteral
        // codegen path runs (alloca, GEP-store per field, set
        // state.last_value to the alloca address with last_is_lvalue=true).
        lit.accept(visitor);
    }
}
