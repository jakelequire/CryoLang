/// Lambda Emitter
///
/// Lambda-expression lowering: mint a unique anonymous function symbol,
/// resolve its parameter and return types, materialise the function in
/// the current LLVM module, bind parameters to allocas, recurse the body
/// through the visitor's dispatch, and return the resulting
/// function-pointer value.
///
/// Holds `cg: CodegenContext*` (heavy machinery - type mapper, function
/// registry, IR-flow allocas, builder) and `state: VisitorState*` (for
/// the per-module `lambda_counter`).  The visitor passes itself as
/// `IRGeneratorVisitor*` so body statements can recurse through its
/// dispatch.

namespace compiler::codegen::visit::lambda_emitter;

import compiler::codegen::{ context, llvm, llvm_types, util };
import compiler::codegen::state::visitor_state::{ Emitted, VisitorState };
import compiler::compilation_context::{ CompilationContext };
import compiler::diag::{ ErrorCode };
import compiler::types::{ type_ref, resolver };
import compiler::ast::{ declaration, expression, MemberPin, node, statement };
import compiler::resolver::{ symbol_str, intern_table };
import compiler::types::arena::{ TypeArena };
import std::fmt;
import compiler::ast::declaration::{ DeclarationNode, VarDecl };
import compiler::ast::expression::{
    ExpressionNode, FieldInit, LambdaExpr, StructExpr
};
import compiler::ast::statement::{ Stmt, StmtKind };
import compiler::codegen::visit::ir_generator::{ IRGeneratorVisitor };
import compiler::codegen::abi::{ SignaturePlan };
import compiler::codegen::context::{ CodegenContext };
import compiler::codegen::llvm_types::{ LBasicBlock, LLinkage, LType, LTypeKind, LValue };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::types::resolver::{ ResolutionContext };
import compiler::types::type_ref::{ TypeRef };
import compiler::resolver::mangled_name::{ MangledName };


type struct LambdaEmitter {
    // Back-pointers set by wire().  Null until wire() runs.
    cg:    mut CodegenContext*;
    state: mut VisitorState*;

    static null() -> LambdaEmitter {
        return LambdaEmitter {
            cg:    null,
            state: null,
        };
    }

    wire(mut &this, cg: mut CodegenContext*, state: mut VisitorState*) -> void {
        this.cg    = cg;
        this.state = state;
    }


    // Lambda emission

    /// Lambda expression codegen.  Two cases:
    ///
    /// 1. **Non-capturing** (`node.is_capturing() == false`): emit an
    ///    anonymous function with the lambda's signature, return its
    ///    function pointer as the lambda's value.  Each parameter must
    ///    carry a type annotation and the return type must be written
    ///    out (`-> T`) - the existing semantics.
    ///
    /// 2. **Capturing** (`node.is_capturing() == true`): Sema has already
    ///    synthesised the closure StructDecl + `__call__` method and
    ///    stamped the lambda's `resolved_type` with the closure struct
    ///    type.  Codegen materialises an instance of that struct here by
    ///    building a transient struct literal whose field-init values
    ///    are identifiers naming each capture, then routing it
    ///    through the visitor's standard dispatch.  No standalone function
    ///    is emitted for the lambda body itself - that lives on the
    ///    synthesised `__call__` method, which goes through ordinary
    ///    method codegen as part of the injected StructDecl.
    ///
    /// `visitor` is the parent IRGeneratorVisitor, accepted as `IRGeneratorVisitor*`
    /// so this module doesn't have to import the concrete visitor type
    /// (cycle-avoidance - `ir_generator.cryo` already imports this module
    /// to hold a `LambdaEmitter` field).
    emit(mut &this, visitor: mut IRGeneratorVisitor*, e: ExpressionNode*, node: LambdaExpr*) -> Emitted {
        mut out: Emitted = Emitted::none();
        if (node == null) {
            out.value     = LValue::null();
            out.is_lvalue = false;
            return out;
        }

        if (node.is_capturing()) {
            return this.emit_capturing(visitor, e, node);
        }

        const ctx_ptr: CompilationContext* = this.cg.ctx;
        const intern:  mut InternTable*        = this.cg.get_intern();

        // Per-module counter: the name only has to be unique within this
        // module, because the function is internal (below).
        const lam_idx: u64 = this.state.lambda_counter;
        this.state.lambda_counter += 1;
        const lam_leaf: string = fmt::format("__lambda_%lld", lam_idx as i64).into_raw();
        const lam_name: string = if (ctx_ptr.has_namespace()) {
            intern.resolve(ctx_ptr.unit_module.qualified(intern.intern(lam_leaf), intern))
        } else {
            ctx_ptr.source_file + "::" + lam_leaf
        };

        // Resolve return type
        mut ret_ref: TypeRef = node.return_type;
        if (!ret_ref.is_valid() && node.return_type_ann != null) {
            mut res_ctx: ResolutionContext = ResolutionContext::new("");
            // Written at the lambda, inside a body, and resolved there.
            ret_ref = ctx_ptr.type_resolver.resolve(node.return_type_ann, &res_ctx);
        }
        mut ret_ty: LType = LType::void_type();
        if (ret_ref.is_valid()) {
            const mapped: LType = this.cg.type_mapper.map_type(ret_ref);
            if (mapped.is_valid()) { ret_ty = mapped; }
        }

        // Resolve parameter types
        const param_count: u32 = node.parameters.length() as u32;
        mut res_ctx2: ResolutionContext = ResolutionContext::new("");
        // Same body, same module as the return annotation above.

        mut param_refs: [TypeRef] = [];
        mut param_tys: [LType] = [];
        for (mut i: u32 = 0; i < param_count; i++) {
            const param_decl: DeclarationNode* = node.parameters[i];
            const param: VarDecl* = DeclarationNode::var_of(param_decl);
            mut pref: TypeRef = param.resolved_type;
            if (!pref.is_valid() && param.type_annotation != null) {
                pref = ctx_ptr.type_resolver.resolve(param.type_annotation, &res_ctx2);
            }
            const param_ty: LType = if (pref.is_valid()) {
                this.cg.type_mapper.map_type(pref)
            } else {
                LType::null()
            };
            if (!param_ty.is_valid()) {
                this.cg.diag.emit_warning_at_span(ErrorCode::E0600_CODEGEN_FAILED,
                    fmt::format("lambda: cannot resolve type for parameter `%s`; lambda skipped",
                        intern.resolve(param.name)),
                    param_decl.span);
                out.value     = LValue::null();
                out.is_lvalue = false;
                return out;
            }
            param_refs.push(pref);
            param_tys.push(param_ty);
        }

        // The lambda is called through a function value, whose call site
        // lowers its signature through the ABI plan; it is declared through
        // the same plan, so both agree on where the result and each
        // argument travel.
        const plan: SignaturePlan = this.cg.abi.classify_signature(&param_refs, ret_ref, false);
        if (!plan.llvm_fn_type.is_valid()) {
            out.value     = LValue::null();
            out.is_lvalue = false;
            return out;
        }
        const fn_val: LValue  = this.cg.llvm_module.add_function(MangledName::new(lam_name), plan.llvm_fn_type);
        if (!fn_val.is_valid()) {
            out.value     = LValue::null();
            out.is_lvalue = false;
            return out;
        }
        // Internal: only the enclosing function refers to the lambda, and the
        // counter name says nothing about which lambda it is.  Linked
        // externally, two different lambdas - one in the stdlib archive, one
        // in a generic instance a program emits into the same module - share a
        // name, and the program's definition is stripped as one the archive
        // already provides, so its function value calls the archive's lambda.
        fn_val.set_linkage(LLinkage::Internal);
        const sret_pointee: LType = if (plan.sret_slot) { plan.return_plan.pointee_ty } else { LType::null() };
        this.cg.abi.apply_signature_attributes(fn_val, sret_pointee, &plan.param_plans);

        const lam_sym: SymbolStr = intern.intern(lam_name);
        this.cg.functions.register(lam_sym, fn_val);

        // Save builder insertion point (we're mid-function)
        const saved_bb: LBasicBlock = this.cg.builder.get_insert_block();
        // The lambda is a function of its own, never `![caller_location]`: a
        // place made in it is its own, and the enclosing body's hidden
        // argument is not a value of this function.  It is still named for
        // the enclosing function, the one its code is written in.
        const saved_caller_location: LValue = this.cg.decl.caller_location;
        this.cg.decl.caller_location = LValue::null();

        // Build function entry block + body
        const entry_bb: LBasicBlock = LBasicBlock::append(fn_val, "entry");
        this.cg.builder.position_at_end(entry_bb);
        this.cg.values.push_scope();

        // Bind each parameter as a function's prologue does, after the
        // hidden result slot when there is one.
        mut llvm_idx: u32 = if (plan.sret_slot) { 1 } else { 0 } as u32;
        for (mut pi: u32 = 0; pi < param_count; pi++) {
            const param: VarDecl* = DeclarationNode::var_of(node.parameters[pi]);
            llvm_idx += this.cg.decl.bind_incoming_parameter(
                fn_val, llvm_idx, param, param_refs[pi as i64], param_tys[pi as i64]);
        }

        // Generate the body: the small generate_block loop, inline.
        if (node.body != null) {
            match (node.body.kind) {
                StmtKind::Block(blk) => {
                    for (mut bi: i64 = 0; bi < blk.statements.length(); bi++) {
                        const current: LBasicBlock = this.cg.builder.get_insert_block();
                        if (current.is_valid() && current.has_terminator()) {
                            break;
                        }
                        const stmt: Stmt* = blk.statements[bi];
                        if (stmt != null) {
                            visitor.dispatch_node(Node::Stmt(stmt));
                        }
                    }
                }
                _ => { visitor.dispatch_node(Node::Stmt(node.body)); }
            }
        }

        // Ensure the entry block has a terminator.
        const cur_bb: LBasicBlock = this.cg.builder.get_insert_block();
        if (cur_bb.is_valid() && !cur_bb.has_terminator()) {
            const rk: LTypeKind = LType::kind_of(ret_ty.raw);
            if (rk == LTypeKind::Void) {
                this.cg.builder.build_ret_void();
            } else {
                // Non-void without a terminator -> unreachable.
                this.cg.builder.build_unreachable();
            }
        }

        // Sweep orphaned empty blocks (same as codegen_function_epilogue).
        mut sweep_bb: mut void* = llvm::LLVMGetFirstBasicBlock(fn_val.raw);
        while (sweep_bb != null) {
            const lbb: LBasicBlock = LBasicBlock { raw: sweep_bb };
            if (!lbb.has_terminator()
                    && llvm::LLVMGetFirstInstruction(sweep_bb) == null) {
                this.cg.builder.position_at_end(lbb);
                this.cg.builder.build_unreachable();
            }
            sweep_bb = llvm::LLVMGetNextBasicBlock(sweep_bb);
        }

        this.cg.values.pop_scope();

        // Restore the outer function's insert point
        if (saved_bb.is_valid()) {
            this.cg.builder.position_at_end(saved_bb);
        }
        this.cg.decl.caller_location = saved_caller_location;

        // The value of a lambda expression is the function pointer itself.
        out.value     = fn_val;
        out.is_lvalue = false;
        return out;
    }

    /// Capturing-lambda codegen: materialise a value of the closure struct
    /// type Sema stamped as the lambda's resolved type, with each field
    /// initialised from the corresponding captured local in scope.  Built
    /// as a transient struct literal so the normal struct-literal
    /// codegen path handles the alloca + GEP-store sequence, from the
    /// lambda's `capture_values` as the passes before codegen left them.
    ///
    /// No anonymous function is emitted from this site: the lambda's body
    /// lives on the synthesised `<closure_struct>::__call__` method,
    /// emitted by ordinary method codegen when the StructDecl Sema
    /// injected reaches Phase 7's codegen sweep.
    emit_capturing(mut &this, visitor: mut IRGeneratorVisitor*, e: ExpressionNode*,
                   node: LambdaExpr*) -> Emitted {
        mut out: Emitted = Emitted::none();
        const closure_ty: TypeRef = e.resolved_type;
        if (!closure_ty.is_valid()) {
            // Sema should have set this; if not, fall back to a null value
            // and let downstream verification catch the bug.
            out.value     = LValue::null();
            out.is_lvalue = false;
            return out;
        }

        const arena: TypeArena* = this.cg.ctx.type_arena;
        const struct_name: SymbolStr = arena.get_qualified_name(closure_ty).spelling();

        mut lit_e: mut ExpressionNode* = ExpressionNode::struct_expr(struct_name, e.span);
        lit_e.set_resolved_type(closure_ty);
        mut lit: mut StructExpr* = ExpressionNode::struct_of(lit_e);

        for (mut i: i64 = 0; i < node.capture_values.length(); i++) {
            // The closure struct's fields ARE the captures, in this order
            // (`LambdaSynth::synthesize_closure_struct`), so the field this
            // initializer names is the i-th; a literal minted after the last
            // sema walk carries its own answer.
            const init: FieldInit = FieldInit {
                field_name: node.captured_names[i],
                value:      node.capture_values[i],
                span:        e.span,
                pin:         MemberPin::Field(i),
                pin_carried: false,
            };
            lit.add_field_init(init);
        }

        // Dispatch through the visitor so the existing StructLiteral
        // codegen path runs (alloca, GEP-store per field), giving the
        // alloca's address as a place.
        return visitor.dispatch_node(Node::Expr(lit_e));
    }
}
