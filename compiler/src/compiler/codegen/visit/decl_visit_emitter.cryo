/// Declaration Visit Emitter
///
/// Function / impl-block / struct-decl / union-decl visit dispatch
/// (the four AST node kinds whose visit() handlers walk *method
/// bodies* rather than emit expressions).  Shared body-emission
/// helpers (`generate_function_body`, `generate_impl_block`,
/// `generate_method_body`) live here so they
/// can recurse into method bodies via the visitor while honoring the
/// `state.current_impl_target` traversal context.
///
/// Holds `cg`, `state`, `dispatch` back-pointers.  The visitor is
/// passed at each call site as `IRGeneratorVisitor*` so body statements
/// recurse through `dispatch.generate_block(visitor, ...)`.

namespace compiler::codegen::visit::decl_visit_emitter;

import compiler::codegen;
import compiler::codegen::{ context, llvm, llvm_types, util };
import compiler::codegen::state::visitor_state;
import compiler::codegen::state::visitor_state::{ VisitorState };
import compiler::codegen::visit::expr_dispatch;
import compiler::codegen::visit::expr_dispatch::{ ExprDispatch };
import compiler::compilation_context;
import compiler::compilation_context::{ CompilationContext };
import compiler::decl_index;
import compiler::diag;
import compiler::diag::{ diagnostic, source_span };
import compiler::types;
import compiler::types::{ type_ref, type_base, arena, compound, generic, generic_registry };
import compiler::ast;
import compiler::ast::{ node, expression, statement, declaration };
import compiler::resolver::{ symbol_str, intern_table };
import utils::log::{ Log, LogArea, LogLevel };
import std::collections::pair;
import std::collections::pair::{ Pair };
import std::ffi::libc;
import std::fmt;
import compiler::ast::declaration::{
    FunctionDecl, ImplBlock, MethodDecl, StructDecl,
    UnionDecl, DeclarationNode, VarDecl
};
import compiler::ast::expression::{ ExpressionNode };
import compiler::ast::statement::{ Stmt };
import compiler::codegen::visit::ir_generator;
import compiler::codegen::visit::ir_generator::{ IRGeneratorVisitor };
import compiler::codegen::context::{ CodegenContext };
import compiler::codegen::llvm_types::{ LBasicBlock, LLinkage, LType, LTypeKind, LValue };
import compiler::diag::source_span::{ SourceSpan };
import compiler::resolver::mangled_name;
import compiler::resolver::mangled_name::{ MangledName };
import compiler::resolver::symbol_id;
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::types::ownership;
import compiler::types::ownership::{ OwnershipQuery };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::res;
import compiler::resolver::res::{ DefId, FamilyOwner, Res, ResSlot };
import compiler::types::generic_registry::{ GenericRegistry };
import compiler::types::type_ref::{ TypeRef };


type struct DeclVisitEmitter {
    cg:       CodegenContext*;
    state:    VisitorState*;
    dispatch: ExprDispatch*;

    static null() -> DeclVisitEmitter {
        return DeclVisitEmitter {
            cg:       null,
            state:    null,
            dispatch: null,
        };
    }

    wire(mut &this, cg: CodegenContext*, state: VisitorState*,
                    dispatch: ExprDispatch*) -> void {
        this.cg       = cg;
        this.state    = state;
        this.dispatch = dispatch;
    }


    // visit() entry points (called by ir_generator.cryo's overrides)

    emit_function_decl(mut &this, visitor: IRGeneratorVisitor*, node_decl: DeclarationNode*) -> void {
        const node: FunctionDecl* = DeclarationNode::fn_of(node_decl);
        if (node == null) { return; }
        if (node.generic_params.length > 0) { return; }
        if (node.body == null) { return; }
        // `cryo test` synthesizes its own `main`; suppress the user's so
        // the LLVM module has exactly one `main` symbol.  Mirrors the
        // `declare_function` guard.
        if (this.cg.ctx.options.mode.skip_user_main()
                && node.def.is_valid() && node.def.equals(this.cg.ctx.entry_fn)) {
            if (Log::enabled(LogArea::Codegen, LogLevel::Trace)) {
                Log::trace(LogArea::Codegen, "function body of main suppressed in test mode");
            }
            return;
        }
        if (Log::enabled(LogArea::Codegen, LogLevel::Trace)) {
            const fn_name: string = this.cg.resolve(node.name);
            Log::trace(LogArea::Codegen, f"function body {fn_name}");
        }
        this.generate_function_body(visitor, node_decl);
    }

    emit_impl_block_visit(mut &this, visitor: IRGeneratorVisitor*, node: ImplBlock*) -> void {
        if (node == null) { return; }
        if (Log::enabled(LogArea::Codegen, LogLevel::Trace)) {
            const impl_target: string = this.cg.resolve(node.target_type);
            Log::trace(LogArea::Codegen, f"implement block {impl_target} ({node.methods.length} methods)");
        }
        this.generate_impl_block(visitor, node);
        if (node.object_table_symbol.is_valid()) {
            this.cg.decl.emit_object_table(node, this.emit_object_release(visitor, node), node.target_type_span);
        }
    }

    /// The drop word of `block`'s trait-object table: a function of the
    /// value's address that releases the value in full - its type's `Drop`
    /// implementation's `drop`, then every field it owns - or null for a
    /// type that owns nothing.  The body is the release a scope exit
    /// performs, `value.drop()` lowered as any other, on a value at the
    /// function's parameter.  Internal, beside the table that points at it,
    /// which is the function's one use, so its name is no symbol any other
    /// module links against.
    emit_object_release(mut &this, visitor: IRGeneratorVisitor*, block: ImplBlock*) -> LValue {
        const word: LType = LType::pointer_to(LType::i8());
        const owner: TypeRef = this.cg.ctx.decl_index.impl_owner(block, "codegen/trait-object release");
        if (!OwnershipQuery::needs_drop(this.cg.get_arena(), this.cg.ctx.generic_registry,
                this.cg.get_intern(), owner)) {
            return LType::const_null(word);
        }
        const saved: LBasicBlock = this.cg.builder.get_insert_block();
        const param_buf: void* = libc::malloc(8);
        const param_tys: void** = param_buf as void**;
        param_tys[0] = word.raw;
        const fn_ty: LType = LType::function_type(LType::void_type(), param_buf, 1, false);
        libc::free(param_buf);
        // Named after the table, which is one per implementation, so two
        // types' releases in one module are two functions.
        const fn_val: LValue = this.cg.llvm_module.add_function(MangledName::new(
            "__cryo.release." + this.cg.ctx.intern_table.resolve(block.object_table_symbol)), fn_ty);
        fn_val.set_linkage(LLinkage::Internal);
        this.cg.builder.position_at_end(LBasicBlock::append(fn_val, "entry"));
        // The function has no source of its own, so no debug location from
        // the last body emitted may reach it.
        if (this.cg.debug_info.is_on()) {
            llvm::LLVMSetCurrentDebugLocation2(this.cg.builder.raw, null);
        }
        this.cg.values.push_scope();
        const span: SourceSpan = block.target_type_span;
        const value_sym: SymbolID = this.cg.ctx.resolver.alloc_synthetic_binding();
        this.cg.values.set(value_sym, LValue { raw: llvm::LLVMGetParam(fn_val.raw, 0) });
        const value: ExpressionNode* = ExpressionNode::identifier_expr(this.cg.get_intern().intern("value"), span);
        ExpressionNode::identifier_of(value).set_res(Res::Local(value_sym));
        value.set_resolved_type(owner);
        const release: ExpressionNode* = ExpressionNode::call_expr(
            ExpressionNode::member_access_expr(value, this.cg.get_intern().intern("drop"), span, span), span);
        this.cg.bind_destructor_call(release);
        visitor.dispatch_node(Node::Stmt(Stmt::expr_stmt(release, span)));
        this.cg.values.pop_scope();
        this.cg.builder.build_ret_void();
        if (saved.is_valid()) { this.cg.builder.position_at_end(saved); }
        return fn_val;
    }

    emit_struct_decl(mut &this, visitor: IRGeneratorVisitor*, node: StructDecl*) -> void {
        if (node == null) { return; }
        if (node.generic_params.length > 0) { return; }
        if (node.methods.length == 0) { return; }
        if (Log::enabled(LogArea::Codegen, LogLevel::Trace)) {
            const sname: string = this.cg.resolve(node.name);
            Log::trace(LogArea::Codegen, f"struct methods {sname} ({node.methods.length} methods)");
        }
        this.state.current_impl_target = this.cg.ctx.decl_index.type_of_decl(node.def, "codegen/struct method bodies");
        for (mut j: i64 = 0; j < node.methods.length; j++) {
            this.generate_method_body(visitor, node.methods[j]);
        }
        this.state.current_impl_target = TypeRef::invalid();
    }

    /// Emit method bodies for a union declaration.  A union's type is a
    /// StructType, so this mirrors emit_struct_decl exactly.
    emit_union_decl(mut &this, visitor: IRGeneratorVisitor*, node: UnionDecl*) -> void {
        if (node == null) { return; }
        if (node.generic_params.length > 0) { return; }
        if (node.methods.length == 0) { return; }
        this.state.current_impl_target = this.cg.ctx.decl_index.type_of_decl(node.def, "codegen/union method bodies");
        for (mut j: i64 = 0; j < node.methods.length; j++) {
            this.generate_method_body(visitor, node.methods[j]);
        }
        this.state.current_impl_target = TypeRef::invalid();
    }


    // Shared body-emission helpers
    //
    // Called from the top-level visit() overrides above.  Kept as named
    // methods (not visit() overrides) because they're also called from
    // `visit(StructDecl*)` / `visit(UnionDecl*)` to emit each
    // method body without re-entering the visit dispatch for the wrapper.

    /// Generate a function body: prologue, block walk, epilogue, validate.
    generate_function_body(mut &this, visitor: IRGeneratorVisitor*, node_decl: DeclarationNode*) -> void {
        const node: FunctionDecl* = DeclarationNode::fn_of(node_decl);
        // `![naked]`: no prologue/epilogue.  Open the entry block, emit the
        // body (a single `asm { }` block - the directive validator guaranteed
        // this shape), then cap with `unreachable`: inline asm is not a
        // terminator, and the asm itself performs the real control transfer
        // (`ret`, a tail `jmp`, or a syscall that never returns).
        if (node.is_naked) {
            const nfn: LValue = this.cg.decl.codegen_naked_prologue(node_decl);
            if (!nfn.is_valid()) { return; }
            this.dispatch.generate_block(visitor, node.body);
            this.cg.builder.build_unreachable();
            return;
        }
        const fn_val: LValue = this.cg.decl.codegen_function_prologue(node_decl);
        if (!fn_val.is_valid()) {
            return;
        }
        this.dispatch.generate_block(visitor,node.body);
        this.cg.decl.codegen_function_epilogue(node_decl);

        // DWARF: clear the current debug location at the end of the body so
        // it can't leak into the next function or into subprogram-less code
        // (globals / runtime helpers), which the verifier would reject.
        if (this.cg.debug_info.is_on()) {
            llvm::LLVMSetCurrentDebugLocation2(this.cg.builder.raw, null);
        }

        // Validate: if any block lacks a terminator, body generation
        // failed. Strip back to a clean declare rather than emitting
        // broken IR that fails LLVM verification; ALWAYS surface a
        // diagnostic so the user sees a real error instead of a silent
        // `undefined reference` from the linker.
        if (!this.cg.diag.is_function_body_valid(fn_val)) {
            const fname: string = this.cg.resolve(node.name);
            this.cg.diag.report_invalid_function_body(fn_val, fname, node_decl.span);
        }
    }

    /// Compute the module's started globals - those whose initializer no
    /// constant fold answers - in one function that runs before `main`,
    /// each initializer evaluated as it is written and stored, in
    /// declaration order.
    emit_global_initializers(mut &this, visitor: IRGeneratorVisitor*) -> void {
        const fn_val: LValue = this.cg.decl.begin_global_initializer();
        if (!fn_val.is_valid()) { return; }
        for (mut k: i64 = 0; k < this.cg.decl.started.nodes.length; k++) {
            const node_decl: DeclarationNode* = this.cg.decl.started.nodes[k];
            const node: VarDecl* = DeclarationNode::var_of(node_decl);
            const value: LValue = this.dispatch.codegen_rvalue(visitor, node.initializer);
            this.cg.decl.store_started_global(k, value);
        }
        this.cg.decl.finish_global_initializer(fn_val);
        if (!this.cg.diag.is_function_body_valid(fn_val)) {
            this.cg.diag.report_invalid_function_body(fn_val, "__cryo.global_init",
                this.cg.decl.started.nodes[0].span);
        }
    }

    /// Generate every method body for an impl block.
    generate_impl_block(mut &this, visitor: IRGeneratorVisitor*, node: ImplBlock*) -> void {
        if (node.generic_params.length > 0) {
            if (Log::enabled(LogArea::Codegen, LogLevel::Trace)) {
                Log::trace(LogArea::Codegen, "implement block skipped: generic");
            }
            return;
        }

        // Mirror declare_impl_block: skip when the target type is a generic
        // template; only spec'd clones should be codegen'd.
        const cg_ctx: CompilationContext* = this.cg.ctx;
        const greg: GenericRegistry* = cg_ctx.generic_registry;
        if (greg.template_of(node.target_def()) != null) {
            if (Log::enabled(LogArea::Codegen, LogLevel::Trace)) {
                Log::trace(LogArea::Codegen, "implement block skipped: its target is a generic template");
            }
            return;
        }
        this.state.current_impl_target = this.cg.ctx.decl_index.impl_owner(node, "codegen/impl bodies");

        for (mut i: i64 = 0; i < node.methods.length; i++) {
            const m_decl: DeclarationNode* = node.methods[i];
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            const mfunc_decl: DeclarationNode* = m.func;
            const mfunc: FunctionDecl* = DeclarationNode::fn_of(mfunc_decl);
            if (mfunc != null && Log::enabled(LogArea::Codegen, LogLevel::Trace)) {
                const mname: string = this.cg.resolve(mfunc.name);
                Log::trace(LogArea::Codegen, f"method {i}: {mname} (static {m.is_static}, {mfunc.generic_params.length} generic parameters)");
            }
            this.generate_method_body(visitor, m_decl);
        }

        this.state.current_impl_target = TypeRef::invalid();
    }

    /// Generate a method body: prologue, block walk, epilogue, validate.
    generate_method_body(mut &this, visitor: IRGeneratorVisitor*, node_decl: DeclarationNode*) -> void {
        const node: MethodDecl* = DeclarationNode::method_of(node_decl);
        const func_decl: DeclarationNode* = node.func;
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null || func.body == null) { return; }
        if (func.generic_params.length > 0) { return; }
        // Self-returning trait-default templates (combinators) and self-growing
        // inherent templates (`as_ref`) are deferred, unresolved templates
        // instantiated lazily at call sites; emit only their concrete
        // specializations (flag cleared).
        if (func.is_self_returning_default || func.is_lazy_self_growing) { return; }

        const fn_val: LValue = this.cg.decl.codegen_method_prologue(node_decl, this.state.current_impl_target);
        if (!fn_val.is_valid()) {
            return;
        }

        this.dispatch.generate_block(visitor,func.body);
        this.cg.decl.codegen_function_epilogue(func_decl);

        if (!this.cg.diag.is_function_body_valid(fn_val)) {
            const target_str: string = if (this.state.current_impl_target.is_valid()) {
                this.cg.ctx.type_arena.resolve_display_name(this.state.current_impl_target)
            } else { "" };
            const method_str: string = this.cg.resolve(func.name);
            const pretty: string = if (target_str.length() > 0) {
                fmt::format("%s::%s", target_str, method_str)
            } else {
                method_str
            };
            this.cg.diag.report_invalid_function_body(fn_val, pretty, func_decl.span);
        }
    }
}
