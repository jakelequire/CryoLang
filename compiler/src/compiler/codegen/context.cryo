/// Codegen Context
///
/// Per-module LLVM codegen state.  One CodegenContext is created for each
/// compilation module.  Holds the LLVM module, builder, type mapper, and
/// value/scope maps that codegen needs to produce IR.

namespace Compiler::Codegen::Context;

import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Codegen::TypeMap;
import Compiler::Codegen::LoopStack;
import Compiler::Codegen::ValueTable;
import Compiler::Codegen::FunctionRegistry;
import Compiler::Codegen::GlobalRegistry;
import Compiler::Codegen::StringCache;
import Compiler::Codegen::DiagSink;
import Compiler::CompilationContext;
import Compiler::DeclIndex;
import Compiler::Diag;
import Compiler::Diag::Diagnostic;
import Compiler::Diag::SourceSpan;
import Compiler::Diag::Sink;
import Compiler::Types;
import Compiler::Types::TypeRef;
import Compiler::Types::Type;
import Compiler::Types::Arena;
import Compiler::Types::Compound;
import Compiler::Types::Generic;
import Compiler::Resolver::SymbolStr;
import Compiler::Resolver::InternTable;
import Compiler::Resolver::MangledName;
import Compiler::Resolver::QualifiedName;
import std::collections::pair;


// ============================================================================
// CodegenContext
// ============================================================================

type struct CodegenContext {
    // -- LLVM state --
    llvm_module:      LModule;
    builder:     LBuilder;
    type_mapper: TypeMapper;

    // -- Local-scope bindings (named values + push/pop_scope undo log) --
    values: ValueTable;

    // -- Function declarations (by-name and overload-aware) --
    functions: FunctionRegistry;

    // -- Module-global variables --
    globals: GlobalRegistry;

    // -- Deduplicated string literal globals --
    str_cache: StringCache;

    // -- Loop target stack --
    // Push (break_bb, continue_bb) on loop entry; pop on loop exit.
    // `break`/`continue` jump to the top of the stack.
    loops: LoopStack;

    // -- Shared references --
    ctx:    CompilationContext*;
    arena:  TypeArena*;
    intern: InternTable*;

    // -- Active variadic arg name (SymbolStr.id) --
    // Set by the function prologue when entering a variadic body so that
    // `codegen_return` can emit `@llvm.va_end` before every `ret`.  0
    // means the current function is not variadic.
    current_variadic_arg_id: u32;

    // -- Diagnostic routing + stripped-functions set --
    diag: DiagSink;

    /// Create a new codegen context for a module.
    static new(ctx: CompilationContext*, module_name: string) -> CodegenContext {
        const mod: LModule = LModule::create(module_name);
        const builder: LBuilder = LBuilder::create();

        return CodegenContext {
            llvm_module:      mod,
            builder:     builder,
            type_mapper: TypeMapper::new(ctx.type_arena, ctx.intern_table),

            values:    ValueTable::new(),
            functions: FunctionRegistry::new(),
            globals:   GlobalRegistry::new(),
            str_cache: StringCache::new(),

            loops: LoopStack::new(),

            ctx:    ctx,
            arena:  ctx.type_arena,
            intern: ctx.intern_table,

            current_variadic_arg_id: 0,
            diag:                    DiagSink::new(ctx),
        };
    }


    // ========================================================================
    // Safe accessors: route through CompilationContext to dodge subtle
    // struct-offset issues on the large CodegenContext layout that have
    // historically miscalculated `this.<field>` offsets.
    // ========================================================================

    /// Get the InternTable reliably via ctx→intern_table.
    /// Do NOT use `this.intern`; the field offset may be wrong
    /// due to the large CodegenContext struct layout.
    get_intern(&this) -> InternTable* {
        const c: CompilationContext* = this.ctx;
        return c.intern_table;
    }

    /// Get the TypeArena reliably via ctx→type_arena.
    get_arena(&this) -> TypeArena* {
        const c: CompilationContext* = this.ctx;
        return c.type_arena;
    }

    /// Get the DeclarationIndex reliably via ctx→decl_index.
    get_decl_index(&this) -> DeclarationIndex* {
        const c: CompilationContext* = this.ctx;
        return c.decl_index;
    }

    /// Qualify a symbol name with the current module namespace.
    qualify(&this, sym: SymbolStr) -> SymbolStr {
        const c: CompilationContext* = this.ctx;
        return c.qualify_symbol_sym(sym);
    }

    /// Resolve an interned SymbolStr to its string.
    resolve(&this, sym: SymbolStr) -> string {
        const c: CompilationContext* = this.ctx;
        const it: InternTable* = c.intern_table;
        return it.resolve(sym);
    }

    /// Intern a string into the shared InternTable.
    intern_str(&this, text: string) -> SymbolStr {
        const c: CompilationContext* = this.ctx;
        const it: InternTable* = c.intern_table;
        return it.intern(text);
    }

    /// Look up a type in the arena by ID.
    /// Splits the chained `cg.get_arena().lookup(id)` pattern into two
    /// local-typed deref steps; chained method-call resolution across
    /// pointer hops has historically been brittle here.
    lookup_type_by_id(&this, id: u64) -> Type* {
        const c: CompilationContext* = this.ctx;
        const a: TypeArena* = c.type_arena;
        return a.lookup(id);
    }

    /// Whether a Cryo type is a *signed* integer.  Used by the integer
    /// coercion sites (return values, phi operands, match comparisons) to
    /// pick `sext` vs `zext` when widening: a narrow signed value must be
    /// sign-extended (`mut x: i64 = -1` is `-1`, not `0xFFFFFFFF`).
    /// Returns `false` for non-integer / unresolvable types, which keeps
    /// the historical `zext` behaviour for those cases (no regression).
    int_type_is_signed(&this, ty: TypeRef) -> boolean {
        const t: Type* = this.lookup_type_by_id(ty.id);
        if (t != null && t.kind == TypeKind::Int) {
            const it: IntType* = t as IntType*;
            return it.int_kind.is_signed();
        }
        return false;
    }

    // ========================================================================
    // Diagnostic helpers (codegen-local shorthand)
    // ========================================================================

    // Diagnostic trampolines.  TODO(decomposition): callers migrate to
    // `this.diag.emit_error_at_span(...)` etc.
    emit_error_at_span(&this, code: ErrorCode, message: string, span: SourceSpan) -> void {
        this.diag.emit_error_at_span(code, message, span);
    }

    emit_warning_at_span(&this, code: ErrorCode, message: string, span: SourceSpan) -> void {
        this.diag.emit_warning_at_span(code, message, span);
    }

    emit_diagnostic(&this, diag: Diagnostic) -> void {
        this.diag.emit(diag);
    }

    strip_function_body(mut &this, fn_val: LValue) -> void {
        this.diag.strip_function_body(fn_val);
    }

    is_function_body_valid(&this, fn_val: LValue) -> boolean {
        return this.diag.is_function_body_valid(fn_val);
    }

    count_unterminated_blocks(&this, fn_val: LValue,
                              out_total: i32*, out_bad: i32*) -> void {
        this.diag.count_unterminated_blocks(fn_val, out_total, out_bad);
    }

    report_invalid_function_body(mut &this, fn_val: LValue,
                                 pretty_name: string,
                                 span: SourceSpan) -> void {
        this.diag.report_invalid_function_body(fn_val, pretty_name, span);
    }

    // ========================================================================
    // Scope management
    // ========================================================================

    // Scope + named-value trampolines.  TODO(decomposition): callers will
    // migrate to `this.values.push_scope()` / `this.values.set(...)` etc.;
    // these wrappers will be removed.
    push_scope(mut &this) -> void {
        this.values.push_scope();
    }

    pop_scope(mut &this) -> void {
        this.values.pop_scope();
    }


    // ========================================================================
    // Named value access (locals / parameters)
    // ========================================================================

    set_named_value(mut &this, name: SymbolStr, val: LValue) -> void {
        this.values.set(name, val);
    }

    get_named_value(&this, name: SymbolStr) -> LValue {
        return this.values.get(name);
    }


    // ========================================================================
    // Function map
    // ========================================================================

    // Function-registry trampolines.  TODO(decomposition): callers migrate
    // to `this.functions.register(...)` / `this.functions.get(...)` etc.
    register_function(mut &this, name: SymbolStr, val: LValue) -> void {
        this.functions.register(name, val);
    }

    register_function_with_arity(mut &this, name: SymbolStr, arity: u32, val: LValue) -> void {
        this.functions.register_with_arity(name, arity, val);
    }

    get_function(&this, name: SymbolStr) -> LValue {
        return this.functions.get(name);
    }

    get_function_with_arity(&this, name: SymbolStr, arity: u32) -> LValue {
        return this.functions.get_with_arity(name, arity);
    }


    // ========================================================================
    // Global map
    // ========================================================================

    register_global(mut &this, name: SymbolStr, val: LValue) -> void {
        this.globals.register(name, val);
    }

    get_global(&this, name: SymbolStr) -> LValue {
        return this.globals.get(name);
    }


    // ========================================================================
    // String literal dedup
    // ========================================================================

    /// Get or create a global string constant.  Trampoline; callers will
    /// migrate to `this.str_cache.get_or_create(text, this.builder)`.
    get_or_create_string_literal(mut &this, text: string) -> LValue {
        return this.str_cache.get_or_create(text, this.builder);
    }


    // ========================================================================
    // Loop target stack
    // ========================================================================

    // Loop-stack trampolines.  TODO(decomposition): callers will migrate to
    // `this.loops.push(...)` / `this.loops.pop()` / `this.loops.current_break()`
    // / `this.loops.current_continue()` directly, and these wrappers will be
    // removed.
    push_loop(mut &this, break_bb: LBasicBlock, continue_bb: LBasicBlock) -> void {
        this.loops.push(break_bb, continue_bb);
    }

    pop_loop(mut &this) -> void {
        this.loops.pop();
    }

    current_break_target(&this) -> LBasicBlock {
        return this.loops.current_break();
    }

    current_continue_target(&this) -> LBasicBlock {
        return this.loops.current_continue();
    }


    // ========================================================================
    // Utility: entry block alloca
    // ========================================================================

    /// Create an alloca in the entry block of the given function.
    /// This ensures allocas are hoisted to the entry block for mem2reg
    /// promotion by LLVM's optimization passes.
    create_entry_alloca(mut &this, func: LValue, name: string, ty: LType) -> LValue {
        if (!func.is_valid()) {
            return LValue::null();
        }
        if (!ty.is_valid()) {
            return LValue::null();
        }

        // Void is unsized; LLVMBuildAlloca crashes in DataLayout::getPrefTypeAlign.
        // Use LLVMGetTypeKind to detect it instead of `lhs_ty_raw == rhs_ty_raw`:
        // `==` on `void*` has historically lowered to strcmp, which would read
        // from the LLVM type objects as if they were C strings.
        if (type_kind_of(ty.raw) == LTypeKind::Void) {
            return LValue::null();
        }

        // Save current insert point.
        const saved_block: LBasicBlock = this.builder.get_insert_block();

        // Position at the start of the entry block.
        const entry: LBasicBlock = LBasicBlock { raw: llvm::LLVMGetEntryBasicBlock(func.raw) };
        if (!entry.is_valid()) {
            return LValue::null();
        }
        // If the entry block already has a terminator (e.g., the function
        // body has emitted a `br`/`ret`), `position_at_end(entry)` would
        // insert AFTER that terminator, breaking the block.  Position
        // BEFORE the terminator in that case so every alloca lands in a
        // well-formed entry block regardless of when the helper is called.
        const term: void* = llvm::LLVMGetBasicBlockTerminator(entry.raw);
        if (term != null) {
            llvm::LLVMPositionBuilderBefore(this.builder.raw, term);
        } else {
            this.builder.position_at_end(entry);
        }

        const alloca: LValue = this.builder.build_alloca(ty, name);

        // Restore insert point.
        if (saved_block.is_valid()) {
            this.builder.position_at_end(saved_block);
        }

        return alloca;
    }


    // ========================================================================
    // Cleanup
    // ========================================================================

    /// Dispose LLVM resources.  Call only when the LLVM module has been
    /// transferred to artifacts (don't dispose the module if it's still owned).
    dispose_builder(mut &this) -> void {
        this.builder.dispose();
    }


    // ========================================================================
    // Internal helpers
    // ========================================================================

    // Raw value-table trampolines.  TODO(decomposition): callers (currently
    // only internal codegen paths) migrate to `this.values.get_raw(...)` etc.
    get_named_value_raw(&this, key: u32) -> void* {
        return this.values.get_raw(key);
    }

    set_named_value_raw(mut &this, key: u32, val: void*) -> void {
        this.values.set_raw(key, val);
    }

    remove_named_value(mut &this, key: u32) -> void {
        this.values.remove_raw(key);
    }

    // ========================================================================
    // IR-building primitives.  Each emits LLVM IR for a primitive operation
    // and assumes the caller has prepared any inputs (resolved AST nodes,
    // computed LValues etc.).  These are the surface a visit() override
    // reaches for after extracting what it needs from the AST.
    // ========================================================================

    codegen_break(mut &this) -> void {
        const target: LBasicBlock = this.current_break_target();
        if (target.is_valid()) {
            this.builder.build_br(target);
        }
    }

    codegen_continue(mut &this) -> void {
        const target: LBasicBlock = this.current_continue_target();
        if (target.is_valid()) {
            this.builder.build_br(target);
        }
    }

    /// Branch to a target block if the current block has no terminator.
    branch_if_not_terminated(mut &this, target: LBasicBlock) -> void {
        const current: LBasicBlock = this.builder.get_insert_block();
        if (current.is_valid() && !current.has_terminator()) {
            this.builder.build_br(target);
        }
    }

    /// Generate IR for an if/else statement.
    /// Creates then_bb, else_bb (if needed), and merge_bb.
    codegen_if(mut &this, cond: LValue,
               current_fn: LValue,
               has_else: boolean) -> IfBlocks {
        const then_bb: LBasicBlock = LBasicBlock::append(current_fn, "then");
        const else_bb: LBasicBlock = if (has_else) {
            LBasicBlock::append(current_fn, "else")
        } else {
            LBasicBlock::null()
        };
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "ifcont");

        if (has_else) {
            this.builder.build_cond_br(cond, then_bb, else_bb);
        } else {
            this.builder.build_cond_br(cond, then_bb, merge_bb);
        }

        return IfBlocks {
            then_bb:  then_bb,
            else_bb:  else_bb,
            merge_bb: merge_bb,
        };
    }

    /// Create the basic blocks for a while loop.
    codegen_while_header(mut &this, current_fn: LValue) -> LoopBlocks {
        const cond_bb: LBasicBlock = LBasicBlock::append(current_fn, "while.cond");
        const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "while.body");
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "while.end");

        this.builder.build_br(cond_bb);
        this.push_loop(merge_bb, cond_bb);

        return LoopBlocks {
            cond_bb:  cond_bb,
            body_bb:  body_bb,
            merge_bb: merge_bb,
        };
    }

    /// Create basic blocks for a for loop: init -> cond -> body -> update -> cond.
    codegen_for_header(mut &this, current_fn: LValue) -> ForBlocks {
        const cond_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.cond");
        const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.body");
        const update_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.update");
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.end");

        this.push_loop(merge_bb, update_bb);

        return ForBlocks {
            cond_bb:   cond_bb,
            body_bb:   body_bb,
            update_bb: update_bb,
            merge_bb:  merge_bb,
        };
    }

    /// Create basic blocks for a `loop { ... }` infinite loop.
    codegen_loop_header(mut &this, current_fn: LValue) -> LoopBlocks {
        const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "loop.body");
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "loop.end");

        this.builder.build_br(body_bb);
        this.push_loop(merge_bb, body_bb);

        return LoopBlocks {
            cond_bb:  LBasicBlock::null(),
            body_bb:  body_bb,
            merge_bb: merge_bb,
        };
    }

    /// Reshape an icmp RHS to match the LHS width when the subject is a
    /// narrower integer than the pattern value.
    coerce_icmp_operands(mut &this, lhs: LValue, rhs: LValue,
                         subj_ty: TypeRef) -> LValue {
        if (!lhs.is_valid() || !rhs.is_valid()) { return rhs; }
        const lhs_ty_raw: void* = llvm::LLVMTypeOf(lhs.raw);
        const rhs_ty_raw: void* = llvm::LLVMTypeOf(rhs.raw);
        if (type_kind_of(lhs_ty_raw) != LTypeKind::Integer) { return rhs; }
        if (type_kind_of(rhs_ty_raw) != LTypeKind::Integer) { return rhs; }
        const lhs_bits: u32 = llvm::LLVMGetIntTypeWidth(lhs_ty_raw);
        const rhs_bits: u32 = llvm::LLVMGetIntTypeWidth(rhs_ty_raw);
        if (lhs_bits == rhs_bits) { return rhs; }
        const lhs_ty: LType = LType { raw: lhs_ty_raw };
        if (rhs_bits > lhs_bits) {
            return this.builder.build_trunc(rhs, lhs_ty, "match.coerce.trunc");
        }
        if (this.int_type_is_signed(subj_ty)) {
            return this.builder.build_sext(rhs, lhs_ty, "match.coerce.sext");
        }
        return this.builder.build_zext(rhs, lhs_ty, "match.coerce.zext");
    }

    // ========================================================================
    // Function/global resolution.  Each resolver looks up a name in this
    // module's LLVM cache; on a miss it declares a cross-module extern from
    // DeclarationIndex and returns the freshly-cached LValue.  Calls
    // bottom-out at the lazy-extern factories below.
    // ========================================================================

    /// Build an LLVM function type from a Cryo `FunctionType*`.  Returns
    /// `LType::null()` if any parameter or the return type fails to map.
    build_function_ltype(mut &this, ft: FunctionType*) -> LType {
        const ret_ty: LType = this.type_mapper.map_type(ft.return_type);
        if (!ret_ty.is_valid()) { return LType::null(); }

        const param_count: u32 = ft.param_types.length as u32;
        if (param_count == 0) {
            return LType::function_type(ret_ty, null, 0, ft.is_variadic);
        }

        const buf: void* = malloc(param_count as u64 * 8);
        const slots: void** = buf as void**;
        mut valid: boolean = true;
        for (mut j: u32 = 0; j < param_count; j++) {
            const mapped: LType = this.type_mapper.map_type(ft.param_types[j]);
            if (!mapped.is_valid()) { valid = false; break; }
            slots[j] = mapped.raw;
        }
        mut result: LType = LType::null();
        if (valid) {
            result = LType::function_type(ret_ty, buf, param_count, ft.is_variadic);
        }
        free(buf);
        return result;
    }

    /// Declare an extern function for a single (name, func_type_ref) pair, and
    /// register it under both the bare name and the (name, arity) composite key.
    /// If an LLVM symbol with the same mangled name already exists in this
    /// module, reuse it.  Returns the LValue on success, null otherwise.
    declare_extern_function_overload(mut &this, fn_name: SymbolStr,
                                     func_type_ref: TypeRef) -> LValue {
        const arena: TypeArena* = this.get_arena();
        const ft_ptr: Type* = arena.lookup(func_type_ref.id);
        if (ft_ptr == null || ft_ptr.kind != TypeKind::Function) { return LValue::null(); }
        const ft: FunctionType* = ft_ptr as FunctionType*;

        const fn_type: LType = this.build_function_ltype(ft);
        if (!fn_type.is_valid()) { return LValue::null(); }

        const intern: InternTable* = this.ctx.intern_table;
        const di: DeclarationIndex* = this.ctx.decl_index;

        // Prefer the overload-specific mangled name registered for this exact
        // (fn_name, func_type_ref) pair.  Fall back to the single-slot alias
        // only when no overload entry exists.
        mut mangled_sym: SymbolStr = di.lookup_overload_mangled(fn_name, func_type_ref);
        if (!mangled_sym.is_valid()) {
            mangled_sym = di.lookup_mangled_name(fn_name);
        }
        if (!mangled_sym.is_valid()) {
            const ext_qname: QualifiedName = QualifiedName::from_symbol(fn_name);
            mangled_sym = MangledName::for_free_function(
                intern, this.get_arena(), ext_qname, ft.param_types,
                ft.return_type, ft.is_variadic).value;
        }
        const ir_name: string = intern.resolve(mangled_sym);

        mut fn_val: LValue = this.llvm_module.get_named_function(ir_name);
        if (!fn_val.is_valid()) {
            fn_val = this.llvm_module.add_function(ir_name, fn_type);
        }
        this.register_function(fn_name, fn_val);
        this.register_function_with_arity(fn_name, ft.param_types.length as u32, fn_val);
        return fn_val;
    }

    /// Return-type-only fallback: declare a no-arg function for names that
    /// have no full signature in DeclarationIndex but do have a return type.
    declare_extern_function_return_only(mut &this, fn_name: SymbolStr) -> LValue {
        const intern: InternTable* = this.ctx.intern_table;
        const di: DeclarationIndex* = this.ctx.decl_index;
        const ret_ref: TypeRef = di.lookup_func_return(fn_name);
        if (ret_ref.is_invalid()) { return LValue::null(); }

        const ret_ty: LType = this.type_mapper.map_type(ret_ref);
        if (!ret_ty.is_valid()) { return LValue::null(); }

        const fn_type: LType = LType::function_type(ret_ty, null, 0, false);
        mut fb_mangled: SymbolStr = di.lookup_mangled_name(fn_name);
        if (!fb_mangled.is_valid()) {
            const fb_qname: QualifiedName = QualifiedName::from_symbol(fn_name);
            const empty_params: TypeRef[] = [];
            fb_mangled = MangledName::for_free_function(
                intern, this.get_arena(), fb_qname, empty_params, ret_ref, false).value;
        }
        const ir_name: string = intern.resolve(fb_mangled);
        mut fn_val: LValue = this.llvm_module.get_named_function(ir_name);
        if (!fn_val.is_valid()) {
            fn_val = this.llvm_module.add_function(ir_name, fn_type);
        }
        this.register_function(fn_name, fn_val);
        return fn_val;
    }

    /// Returns true iff `name` is defined in the module currently being
    /// compiled.  Used by the resolve_* helpers to avoid turning a stale local
    /// lookup into a stub extern declaration (which would leave the would-be
    /// body without a terminator; the callers rely on declare_functions /
    /// declare_method having registered the handle before body codegen runs).
    owned_by_current_module(&this, mod_sym: SymbolStr) -> boolean {
        if (!mod_sym.is_valid()) { return false; }
        const current: SymbolStr = this.ctx.intern_table.intern(this.ctx.source_file);
        return mod_sym.equals(current);
    }

    /// Look up a function by name, declaring a cross-module extern on demand
    /// when this module hasn't seen it yet.  Returns null when the name is
    /// unknown to the DeclarationIndex OR when the symbol is owned by the
    /// current module (the caller should be using the value that declare_* put
    /// in the map, not a freshly declared extern that would clobber the body).
    resolve_function(mut &this, name: SymbolStr) -> LValue {
        const cached: LValue = this.get_function(name);
        if (cached.is_valid()) { return cached; }

        const di: DeclarationIndex* = this.ctx.decl_index;
        if (this.owned_by_current_module(di.get_function_module(name))) {
            return LValue::null();
        }

        const arena: TypeArena* = this.get_arena();
        const overloads: TypeRef[] = di.lookup_func_type_overloads(name);
        // Two-pass declaration: prefer concrete overloads (no GenericParam
        // anywhere in the signature) over template entries left in DI by
        // sema-time registration of generic methods.  Without this, the
        // template's `Reference(GenericParam)`-typed signature is the first
        // overload to succeed (build_function_ltype lowers `Reference(_)` to
        // opaque `ptr` regardless), so the cross-module extern gets declared
        // under the template's `1H`-placeholder mangled name and the call
        // site never links to the spec.  Pass 1: concrete overloads.  Pass
        // 2: any remaining (template) overloads, only as a fallback when
        // no concrete overload was registered for the name.
        mut first: LValue = LValue::null();
        for (mut i: i64 = 0; i < overloads.length; i++) {
            const ft_ptr: Type* = arena.lookup(overloads[i].id);
            if (ft_ptr == null || ft_ptr.kind != TypeKind::Function) { continue; }
            const ft: FunctionType* = ft_ptr as FunctionType*;
            if (function_type_has_generic_params(arena, ft)) { continue; }
            const v: LValue = this.declare_extern_function_overload(name, overloads[i]);
            if (!first.is_valid() && v.is_valid()) { first = v; }
        }
        if (!first.is_valid()) {
            for (mut i: i64 = 0; i < overloads.length; i++) {
                const v: LValue = this.declare_extern_function_overload(name, overloads[i]);
                if (!first.is_valid() && v.is_valid()) { first = v; }
            }
        }
        if (first.is_valid()) { return first; }

        return this.declare_extern_function_return_only(name);
    }

    /// Resolve a function from a sema-pinned symbol.  See the original
    /// docstring on the free `resolve_function_by_mangled` for the lookup
    /// order; the logic is identical.
    resolve_function_by_mangled(mut &this, pinned: SymbolStr) -> LValue {
        if (!pinned.is_valid()) { return LValue::null(); }

        const intern: InternTable* = this.get_intern();
        const pinned_str: string = intern.resolve(pinned);
        mut v: LValue = this.llvm_module.get_named_function(pinned_str);
        if (v.is_valid()) { return v; }

        const di: DeclarationIndex* = this.ctx.decl_index;
        for (mut i: i64 = 0; i < di.overload_func_keys.length; i++) {
            if (di.overload_func_mangled[i] != pinned.id) { continue; }
            const qual: SymbolStr = SymbolStr::from_id(di.overload_func_keys[i]);
            if (this.owned_by_current_module(di.get_function_module(qual))) {
                return LValue::null();
            }
            v = this.declare_extern_function_overload(qual, di.overload_func_types[i]);
            if (v.is_valid()) { return v; }
        }

        return this.resolve_function(pinned);
    }

    /// Look up an overloaded function by (name, user-arg-count), declaring a
    /// cross-module extern on demand.
    resolve_function_with_arity(mut &this, name: SymbolStr,
                                arity: u32) -> LValue {
        const cached: LValue = this.get_function_with_arity(name, arity);
        if (cached.is_valid()) { return cached; }

        const di: DeclarationIndex* = this.ctx.decl_index;
        if (this.owned_by_current_module(di.get_function_module(name))) {
            return LValue::null();
        }

        const arena: TypeArena* = this.get_arena();
        const overloads: TypeRef[] = di.lookup_func_type_overloads(name);
        // Two-pass: concrete overloads first, then templates as fallback.
        // See `resolve_function` for the rationale.
        for (mut i: i64 = 0; i < overloads.length; i++) {
            const ft_ptr: Type* = arena.lookup(overloads[i].id);
            if (ft_ptr == null || ft_ptr.kind != TypeKind::Function) { continue; }
            const ft: FunctionType* = ft_ptr as FunctionType*;
            if (ft.param_types.length as u32 != arity) { continue; }
            if (function_type_has_generic_params(arena, ft)) { continue; }
            const v: LValue = this.declare_extern_function_overload(name, overloads[i]);
            if (v.is_valid()) { return v; }
        }
        for (mut i: i64 = 0; i < overloads.length; i++) {
            const ft_ptr: Type* = arena.lookup(overloads[i].id);
            if (ft_ptr == null || ft_ptr.kind != TypeKind::Function) { continue; }
            const ft: FunctionType* = ft_ptr as FunctionType*;
            if (ft.param_types.length as u32 != arity) { continue; }
            const v: LValue = this.declare_extern_function_overload(name, overloads[i]);
            if (v.is_valid()) { return v; }
        }
        return LValue::null();
    }

    /// Look up a global by name, declaring a cross-module extern on demand.
    resolve_global(mut &this, name: SymbolStr) -> LValue {
        const cached: LValue = this.get_global(name);
        if (cached.is_valid()) { return cached; }

        const intern: InternTable* = this.ctx.intern_table;
        const di: DeclarationIndex* = this.ctx.decl_index;
        if (this.owned_by_current_module(di.get_global_module(name))) {
            return LValue::null();
        }

        const g_type_ref: TypeRef = di.lookup_global(name);
        if (g_type_ref.is_invalid()) { return LValue::null(); }

        const g_llvm_ty: LType = this.type_mapper.map_type(g_type_ref);
        if (!g_llvm_ty.is_valid()) { return LValue::null(); }

        // Mirror codegen_global_var's mangle: pull the defining namespace out of
        // DI so the extern decl in this module refers to the same LLVM symbol
        // the defining module emits.  Empty namespace → bare `C$<name>` (root-
        // namespace globals).
        const def_ns: SymbolStr = di.get_global_namespace(name);
        const mangled: string = MangledName::for_global(intern, def_ns, name).resolve(intern);

        // Reuse an existing LLVM global if something (e.g. a prior pass) already
        // created one with the same mangled name; identical-name externs share
        // the same symbol at link time.
        mut g_val: LValue = this.llvm_module.get_named_global(mangled);
        if (!g_val.is_valid()) {
            g_val = this.llvm_module.add_global(g_llvm_ty, mangled);
        }
        this.register_global(name, g_val);
        return g_val;
    }

    codegen_sizeof(mut &this, type_ref: TypeRef) -> LValue {
        const t: Type* = this.lookup_type_by_id(type_ref.id);
        if (t != null) {
            const cryo_size: u64 = t.size_bytes();
            if (cryo_size > 0) {
                return LType::const_int(LType::i64(), cryo_size, false);
            }
            // size_bytes() returned 0; typically because TypeLowering hasn't
            // computed the layout for this Type (common for InstantiatedType
            // wrappers like `HashMapEntry<K, V>` that route through a resolved
            // StructType but the wrapper's computed_size never gets propagated).
            // Fall back to LLVM's authoritative size: `LLVMSizeOf` returns a
            // ConstantExpr with the data-layout-correct byte count, which is
            // exactly what `calloc(N, sizeof(T))` needs.
            const lty: LType = this.type_mapper.map_type(type_ref);
            if (lty.is_valid()) {
                return LValue { raw: llvm::LLVMSizeOf(lty.raw) };
            }
        }
        return LType::const_int(LType::i64(), 0, false);
    }

    codegen_alignof(mut &this, type_ref: TypeRef) -> LValue {
        const t: Type* = this.lookup_type_by_id(type_ref.id);
        if (t != null) {
            const cryo_align: u64 = t.alignment();
            if (cryo_align > 0) {
                return LType::const_int(LType::i64(), cryo_align, false);
            }
            // alignment() returned 0; TypeLowering didn't compute a layout
            // for this Type (typically InstantiatedType wrappers like
            // `Array<T>` whose computed_align never gets propagated through
            // the spec'd struct).  Fall back to LLVM's authoritative
            // alignment via `LLVMAlignOf`.  Without this fallback,
            // `Layout::array<T>` returned `Layout { size, alignment: 0 }`,
            // and `GlobalAlloc::reallocate` either failed an alignment
            // assertion or fell into a misaligned-realloc path that crashed.
            const lty: LType = this.type_mapper.map_type(type_ref);
            if (lty.is_valid()) {
                return LValue { raw: llvm::LLVMAlignOf(lty.raw) };
            }
        }
        return LType::const_int(LType::i64(), 0, false);
    }

    codegen_cast(mut &this, val: LValue,
                 from_type: TypeRef, to_type: TypeRef) -> LValue {
        const src_type: Type* = this.lookup_type_by_id(from_type.id);
        const dst_type: Type* = this.lookup_type_by_id(to_type.id);
        if (src_type == null || dst_type == null) {
            return val;
        }

        const dest_ty: LType = this.type_mapper.map_type(to_type);

        const from_kind: TypeKind = src_type.kind;
        const to_kind: TypeKind = dst_type.kind;
        // Treat Char and Bool as integer-like for cast purposes; both are
        // integer types at the LLVM level (i32 and i1 respectively).  Without
        // including Char here, casts like `s[i] as u64` (where `s[i]: char`)
        // fall through to the bitcast fallback and LLVM rejects
        // `bitcast i32 to i64` (bitcast requires same-size operands).
        const from_int: boolean = from_kind == TypeKind::Int || from_kind == TypeKind::Char;
        const from_float: boolean = from_kind == TypeKind::Float;
        const to_int: boolean = to_kind == TypeKind::Int || to_kind == TypeKind::Char;
        const to_float: boolean = to_kind == TypeKind::Float;
        // Treat `String` as a pointer type for cast classification; strings
        // are `i8*` at the LLVM level, so `string as i64` is semantically a
        // ptrtoint (not a bitcast, which requires same-size operands and
        // LLVM rejects for pointer ↔ integer).  Same for `i64 as string`
        // (inttoptr) and `string ↔ some_other_pointer` (pointer_cast / no-op
        // under opaque pointers).
        const from_ptr: boolean = from_kind == TypeKind::Pointer ||
                                  from_kind == TypeKind::Reference ||
                                  from_kind == TypeKind::String;
        const to_ptr: boolean = to_kind == TypeKind::Pointer ||
                                to_kind == TypeKind::Reference ||
                                to_kind == TypeKind::String;

        if (from_int && to_int) {
            mut from_bits: u32 = 0;
            mut signed_src: boolean = false;
            if (from_kind == TypeKind::Int) {
                const from_it: IntType* = src_type as IntType*;
                from_bits = from_it.int_kind.bit_width() as u32;
                signed_src = from_it.int_kind.is_signed();
            } else if (from_kind == TypeKind::Char) {
                from_bits = 32;
                signed_src = false;
            }
            mut to_bits: u32 = 0;
            if (to_kind == TypeKind::Int) {
                const to_it: IntType* = dst_type as IntType*;
                to_bits = to_it.int_kind.bit_width() as u32;
            } else if (to_kind == TypeKind::Char) {
                to_bits = 32;
            }
            if (from_bits == 0 || to_bits == 0 || !val.is_valid()) {
                return val;
            } else if (from_bits > to_bits) {
                return this.builder.build_trunc(val, dest_ty, "trunctmp");
            } else if (from_bits < to_bits) {
                if (signed_src) {
                    return this.builder.build_sext(val, dest_ty, "sexttmp");
                } else {
                    return this.builder.build_zext(val, dest_ty, "zexttmp");
                }
            } else {
                return val;  // Same width, no-op.
            }
        } else if (from_float && to_float) {
            const from_ft: FloatType* = src_type as FloatType*;
            const to_ft: FloatType* = dst_type as FloatType*;
            const from_fk: FloatKind = from_ft.float_kind;
            const to_fk: FloatKind = to_ft.float_kind;
            const from_bits: u64 = from_fk.bit_width();
            const to_bits: u64 = to_fk.bit_width();
            if (from_bits > to_bits) {
                return this.builder.build_fp_trunc(val, dest_ty, "fptrunctmp");
            } else if (from_bits < to_bits) {
                return this.builder.build_fp_ext(val, dest_ty, "fpexttmp");
            } else {
                return val;
            }
        } else if (from_int && to_float) {
            const from_it2: IntType* = src_type as IntType*;
            const from_ik2: IntegerKind = from_it2.int_kind;
            if (from_ik2.is_signed()) {
                return this.builder.build_si_to_fp(val, dest_ty, "sitofptmp");
            } else {
                return this.builder.build_ui_to_fp(val, dest_ty, "uitofptmp");
            }
        } else if (from_float && to_int) {
            const to_it2: IntType* = dst_type as IntType*;
            const to_ik2: IntegerKind = to_it2.int_kind;
            if (to_ik2.is_signed()) {
                return this.builder.build_fp_to_si(val, dest_ty, "fptositmp");
            } else {
                return this.builder.build_fp_to_ui(val, dest_ty, "fptouitmp");
            }
        } else if (from_ptr && to_ptr) {
            return this.builder.build_pointer_cast(val, dest_ty, "ptrcasttmp");
        } else if (from_int && to_ptr) {
            return this.builder.build_int_to_ptr(val, dest_ty, "inttoptr");
        } else if (from_ptr && to_int) {
            return this.builder.build_ptr_to_int(val, dest_ty, "ptrtoint");
        } else if (from_kind == TypeKind::Bool && to_int) {
            return this.builder.build_zext(val, dest_ty, "booltoint");
        } else {
            return this.builder.build_bitcast(val, dest_ty, "bitcasttmp");
        }
    }

    /// Compare two i8* string values using strcmp.
    /// Returns i1: true if equal (==) or not equal (!=).
    codegen_string_compare(mut &this, lhs: LValue, rhs: LValue,
                           op_kind: TokenType) -> LValue {
        // `string == null` / `string != null` must NOT call strcmp; strcmp
        // dereferences both operands, so passing a null operand is undefined
        // behaviour (typically a segfault).  Detect the null-literal case and
        // lower it as a pointer-equality icmp instead.  LLVMIsNull returns 1
        // for the constant null pointer.
        const lhs_is_null: i32 = llvm::LLVMIsNull(lhs.raw);
        const rhs_is_null: i32 = llvm::LLVMIsNull(rhs.raw);
        if (lhs_is_null != 0 || rhs_is_null != 0) {
            const pred: LIntPredicate = if (op_kind == TokenType::EqualEqual) { LIntPredicate::EQ } else { LIntPredicate::NE };
            return this.builder.build_icmp(pred, lhs, rhs, "strnullcmp");
        }

        // Ensure strcmp is declared: i32 strcmp(i8*, i8*)
        const intern: InternTable* = this.get_intern();
        const strcmp_name: string = "strcmp";
        const strcmp_sym: SymbolStr = intern.intern(strcmp_name);
        mut strcmp_fn: LValue = this.resolve_function(strcmp_sym);
        if (!strcmp_fn.is_valid()) {
            const i8_ptr: LType = LType::pointer_to(LType::i8());
            const param_buf: void* = intrinsics::malloc(16);
            const params: void** = param_buf as void**;
            params[0] = i8_ptr.raw;
            params[1] = i8_ptr.raw;
            const strcmp_ty: LType = LType::function_type(LType::i32(), param_buf, 2, false);
            intrinsics::free(param_buf);
            strcmp_fn = this.llvm_module.add_function(strcmp_name, strcmp_ty);
            this.register_function(strcmp_sym, strcmp_fn);
        }

        const strcmp_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(strcmp_fn.raw) };
        const arg_buf: void* = intrinsics::malloc(16);
        const args: void** = arg_buf as void**;
        args[0] = lhs.raw;
        args[1] = rhs.raw;
        const cmp_result: LValue = this.builder.build_call(strcmp_ty, strcmp_fn, arg_buf, 2, "strcmp");
        intrinsics::free(arg_buf);

        const zero: LValue = LType::const_int(LType::i32(), 0, false);
        if (op_kind == TokenType::EqualEqual) {
            return this.builder.build_icmp(LIntPredicate::EQ, cmp_result, zero, "streq");
        } else {
            return this.builder.build_icmp(LIntPredicate::NE, cmp_result, zero, "strne");
        }
    }

    /// Generate IR for a local variable declaration.
    /// `site_span` is the source span of the variable's declaration node; used
    /// for diagnostics when the insert block or parent function are unexpectedly
    /// null (both indicate a codegen-ordering bug, so we point the user at the
    /// declaration that tripped the check).
    codegen_local_var(mut &this, name: SymbolStr,
                      ty: TypeRef, init_val: LValue,
                      has_init: boolean,
                      site_span: SourceSpan) -> void {
        const var_name: string = this.resolve(name);
        const llvm_ty: LType = this.type_mapper.map_type(ty);
        if (!llvm_ty.is_valid()) {
            return;
        }

        // Void is unsized; LLVMBuildAlloca crashes in DataLayout::getAlignment.
        if (type_kind_of(llvm_ty.raw) == LTypeKind::Void) {
            return;
        }

        const current_bb: LBasicBlock = this.builder.get_insert_block();
        if (!current_bb.is_valid()) {
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0607_VARIABLE_GENERATION_ERROR,
                format("codegen: local variable '%s': builder has no insert block", var_name));
            diag = diag.at(site_span);
            diag = diag.with_note("the codegen builder must have an insert block active when a local is declared; this usually means a statement was visited outside of any function body");
            this.emit_diagnostic(diag);
            return;
        }
        const current_fn: LValue = current_bb.get_parent();
        if (!current_fn.is_valid()) {
            this.emit_error_at_span(ErrorCode::E0607_VARIABLE_GENERATION_ERROR,
                format("codegen: local variable '%s': insert block has no parent function", var_name),
                site_span);
            return;
        }

        const alloca: LValue = this.create_entry_alloca(current_fn, var_name, llvm_ty);

        if (has_init && init_val.is_valid()) {
            // Coerce integer literals to the variable's declared width before
            // storing.  `mut i: i64 = 0` arrives with `init_val` as `i32 0`
            // (codegen_literal defaults integer literals to i32 when sema
            // doesn't propagate the expected type) and the i64 alloca is
            // 8 bytes; a direct `store i32` writes only the low 4 bytes,
            // leaving the high 4 uninitialised.  zext/sext to the alloca
            // type so the full slot is written; same idea for the trunc
            // direction (an i64 expression initialising an i32 local).
            mut store_val: LValue = init_val;
            const init_ty_raw: void* = llvm::LLVMTypeOf(init_val.raw);
            if (init_ty_raw != null
                    && type_kind_of(init_ty_raw) == LTypeKind::Integer
                    && type_kind_of(llvm_ty.raw) == LTypeKind::Integer) {
                const want_bits: u32 = llvm::LLVMGetIntTypeWidth(llvm_ty.raw);
                const got_bits:  u32 = llvm::LLVMGetIntTypeWidth(init_ty_raw);
                if (want_bits > got_bits) {
                    // Widen with the variable's signedness; `mut x: i64 = -1`
                    // would otherwise zext the i32 -1 into 0xFFFFFFFF (a huge
                    // positive i64) instead of -1.
                    mut signed_target: boolean = false;
                    const ty_t: Type* = this.lookup_type_by_id(ty.id);
                    if (ty_t != null && ty_t.kind == TypeKind::Int) {
                        const ti: IntType* = ty_t as IntType*;
                        signed_target = ti.int_kind.is_signed();
                    }
                    if (signed_target) {
                        store_val = this.builder.build_sext(init_val, llvm_ty, "init.widen");
                    } else {
                        store_val = this.builder.build_zext(init_val, llvm_ty, "init.widen");
                    }
                } else if (want_bits < got_bits) {
                    store_val = this.builder.build_trunc(init_val, llvm_ty, "init.trunc");
                }
            }
            this.builder.build_store(store_val, alloca);
        }

        this.set_named_value(name, alloca);
    }

    /// Generate IR for a function call.
    /// Coerces integer argument widths to match the callee's LLVM parameter
    /// types (e.g., i8->i32 for memset, i32->i64 for u64 params).
    ///
    /// Each `args[i]` carries the LLVM value (`.first`) and the Cryo-level
    /// type of that arg (`.second`).  The Cryo type drives the sext-vs-zext
    /// choice when the formal param is wider than the supplied value.  Use
    /// `TypeRef::invalid()` for slots where the type isn't known (low-level
    /// callers wiring up malloc/free/abort with already-matched widths);
    /// invalid slots fall back to `zext`.
    codegen_call(mut &this, callee: LValue, callee_type: LType, args: Pair<LValue, TypeRef>[], name: string) -> LValue {
        mut out_value: LValue = LValue::null();
        const n: u32 = args.length as u32;

        if (n == 0) {
            out_value = this.builder.build_call(callee_type, callee, null, 0, name);
            return out_value;
        }

        // Get expected parameter types for argument coercion.
        // callee_type is the function type passed to LLVMBuildCall2.
        // Even though LLVMGetTypeKind may report it as pointer (opaque ptr era),
        // LLVMCountParamTypes still works on function types.
        // Also try LLVMCountParams on the callee value as fallback.
        mut expected_count: u32 = llvm::LLVMCountParamTypes(callee_type.raw);
        mut param_types_buf: void* = null;
        if (expected_count > 0 && expected_count <= 64) {
            param_types_buf = intrinsics::malloc(expected_count as u64 * 8);
            llvm::LLVMGetParamTypes(callee_type.raw, param_types_buf);
        }

        // Build argument array, coercing integer widths where needed.
        const buf: void* = intrinsics::malloc(n as u64 * 8);
        const slots: void** = buf as void**;
        const param_types: void** = param_types_buf as void**;
        for (mut i: u32 = 0; i < n; i++) {
            mut arg_val: LValue = args[i as i64].first;
            const arg_ty_ref: TypeRef = args[i as i64].second;
            if (arg_val.is_valid() && param_types_buf != null && i < expected_count) {
                const expected_ty: void* = param_types[i];
                const actual_ty: void* = llvm::LLVMTypeOf(arg_val.raw);
                // Compare by type kind; void* pointer equality is broken in the
                // Cryo compiler (always returns true), so we cannot rely on
                // expected_ty != actual_ty to detect mismatches.
                const ek: LTypeKind = type_kind_of(expected_ty);
                const ak: LTypeKind = type_kind_of(actual_ty);
                if (ek != ak) {
                    if (ek == LTypeKind::Pointer && ak == LTypeKind::Struct) {
                        // Expected ptr, actual struct: the struct value came from
                        // `codegen_rvalue` loading through some lvalue.  If we can
                        // recover that pre-load address (`val` is a Load whose
                        // only operand is the original pointer), use it directly
                        // that preserves identity so callees that mutate the
                        // struct see the caller's memory.  Otherwise fall back
                        // to a fresh temp alloca + store + addr-of.
                        // LLVMOpcode::Load = 27.
                        mut handled: boolean = false;
                        const opcode: i32 = llvm::LLVMGetInstructionOpcode(arg_val.raw);
                        if (opcode == 27) {
                            const ptr_operand: void* = llvm::LLVMGetOperand(arg_val.raw, 0);
                            if (ptr_operand != null) {
                                arg_val = LValue { raw: ptr_operand };
                                handled = true;
                            }
                        }
                        if (!handled) {
                            const st: LType = LType { raw: actual_ty };
                            const tmp: LValue = this.builder.build_alloca(st, "arg.ref");
                            this.builder.build_store(arg_val, tmp);
                            arg_val = tmp;
                        }
                    } else if (ek == LTypeKind::Struct && ak == LTypeKind::Pointer) {
                        const st: LType = LType { raw: expected_ty };
                        arg_val = this.builder.build_load(st, arg_val, "arg.deref");
                    } else if ((ek == LTypeKind::Float || ek == LTypeKind::Double) && ak == LTypeKind::Pointer) {
                        const ft: LType = LType { raw: expected_ty };
                        arg_val = this.builder.build_load(ft, arg_val, "arg.deref");
                    } else if (ek == LTypeKind::Integer && ak == LTypeKind::Pointer && expected_count > 0 && i == 0) {
                        const it: LType = LType { raw: expected_ty };
                        arg_val = this.builder.build_load(it, arg_val, "arg.deref");
                    } else if (ek == LTypeKind::Pointer && ak == LTypeKind::Integer) {
                        // Expected ptr, actual integer.  For the receiver slot
                        // (i==0) this is a primitive method on an rvalue; spill
                        // to a stack temp and pass the slot's address.  For
                        // non-receiver args keep the legitimate inttoptr.
                        if (i == 0) {
                            const slot_lty: LType = LType { raw: actual_ty };
                            const slot: LValue = this.builder.build_alloca(slot_lty, "recv.slot");
                            this.builder.build_store(arg_val, slot);
                            arg_val = slot;
                        } else {
                            const target: LType = LType { raw: expected_ty };
                            arg_val = LValue { raw: llvm::LLVMBuildIntToPtr(this.builder.raw, arg_val.raw, expected_ty, "arg.i2p") };
                        }
                    } else if (ek == LTypeKind::Integer && ak == LTypeKind::Pointer) {
                        const target: LType = LType { raw: expected_ty };
                        arg_val = LValue { raw: llvm::LLVMBuildPtrToInt(this.builder.raw, arg_val.raw, expected_ty, "arg.p2i") };
                    }
                } else if (ek == LTypeKind::Integer && ak == LTypeKind::Integer) {
                    // Both integers: coerce widths if needed.  Picking sext
                    // vs zext from the *source* Cryo type's signedness is
                    // load-bearing: an i32 holding `-1` (0xFFFFFFFF) widened
                    // to i64 must become 0xFFFFFFFFFFFFFFFF (sext), not
                    // 0x00000000FFFFFFFF (zext).  Defaulting to zext silently
                    // corrupted any negative signed-narrow arg passed to a
                    // wider parameter.
                    const ew: u32 = llvm::LLVMGetIntTypeWidth(expected_ty);
                    const aw: u32 = llvm::LLVMGetIntTypeWidth(actual_ty);
                    if (aw < ew) {
                        const target: LType = LType { raw: expected_ty };
                        mut src_signed: boolean = false;
                        if (arg_ty_ref.is_valid()) {
                            const at_t: Type* = this.lookup_type_by_id(arg_ty_ref.id);
                            if (at_t != null && at_t.kind == TypeKind::Int) {
                                const it: IntType* = at_t as IntType*;
                                src_signed = it.int_kind.is_signed();
                            }
                        }
                        if (src_signed) {
                            arg_val = this.builder.build_sext(arg_val, target, "arg.widen");
                        } else {
                            arg_val = this.builder.build_zext(arg_val, target, "arg.widen");
                        }
                    } else if (aw > ew) {
                        const target: LType = LType { raw: expected_ty };
                        arg_val = this.builder.build_trunc(arg_val, target, "arg.trunc");
                    }
                }
            }
            slots[i] = arg_val.raw;
        }
        if (param_types_buf != null) { intrinsics::free(param_types_buf); }

        out_value = this.builder.build_call(callee_type, callee, buf, n, name);
        intrinsics::free(buf);
        return out_value;
    }

    /// Generate IR for a binary expression.  Handles arithmetic, comparison,
    /// logical short-circuit, and assignment operators.
    codegen_binary(mut &this, lhs_val: LValue, rhs_val: LValue, op_kind: TokenType, result_type: TypeRef) -> LValue {
        mut out_value: LValue = LValue::null();
        if (!lhs_val.is_valid() || !rhs_val.is_valid()) {
            out_value = LValue::null();
            return out_value;
        }
        // Determine if this is integer, float, or pointer arithmetic.
        // Follow InstantiatedType chain to get the concrete type.
        mut t: Type* = this.lookup_type_by_id(result_type.id);
        mut bd: i32 = 0;
        while (t != null && t.kind == TypeKind::InstantiatedType && bd < 5) {
            const binst: InstantiatedType* = t as InstantiatedType*;
            if (binst.has_resolved_type()) {
                t = this.lookup_type_by_id(binst.resolved_type.id);
            } else { break; }
            bd += 1;
        }
        mut t_kind: TypeKind = TypeKind::Error;
        if (t != null) { t_kind = t.kind; }

        // String ops.  Strings are null-terminated `i8*` at the LLVM level.
        //   `==`/`!=` → strcmp
        //   `+` string + string → append (concat into fresh heap buffer)
        //   `+` string + int    → pointer advancement (GEP over i8)
        if (t_kind == TypeKind::String) {
            if (op_kind == TokenType::EqualEqual || op_kind == TokenType::ExclaimEqual) {
                out_value = this.codegen_string_compare(lhs_val, rhs_val, op_kind);
                return out_value;
            }
            if (op_kind == TokenType::Plus) {
                // Decide concat vs pointer-advance by the RHS's LLVM type.
                // Both operands are already rvalues at this point.
                const rhs_llvm: void* = llvm::LLVMTypeOf(rhs_val.raw);
                if (rhs_llvm != null && type_kind_of(rhs_llvm) == LTypeKind::Integer) {
                    // string + int → GEP i8 for pointer arithmetic.  Caller
                    // uses this idiom for substring-from-offset, C-string
                    // walking, etc.
                    const buf: void* = intrinsics::malloc(8);
                    const slots: void** = buf as void**;
                    slots[0] = rhs_val.raw;
                    out_value = this.builder.build_gep(
                        LType::i8(), lhs_val, buf, 1, "ptradv");
                    intrinsics::free(buf);
                    return out_value;
                }
                // string + string → call std::core::primitives::string::append.
                // The stdlib already provides this as a method on `string`;
                // every module gets it via cross-module extern declarations.
                //
                // append's signature is `(&this, other: string) -> string`.  By
                // convention, `&this` on a primitive lowers to a pointer to the
                // storage holding the string (i8**).  The body opens with
                // `load ptr, ptr %0` to deref it back to the string.  Method-call
                // codegen passes the receiver's lvalue for value-typed receivers
                // (see ir_generator.cryo:visit_call_expr); the binary `+` path
                // arrives here with `lhs_val` already loaded as an rvalue (i8*),
                // so spill it back to a temp slot and pass that slot's address.
                // Without this, the callee derefs i8* expecting i8** and reads
                // the first 8 bytes of string content as a "pointer", crashing
                // in strlen.
                const intern: InternTable* = this.get_intern();
                const fn_sym: SymbolStr = intern.intern(
                    "std::core::primitives::string::append");
                const fn_val: LValue = this.resolve_function(fn_sym);
                if (!fn_val.is_valid()) {
                    out_value = LValue::null();
                    return out_value;
                }
                const fn_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(fn_val.raw) };
                const this_ty: LType = LType::pointer_to(LType::i8());
                const this_slot: LValue = this.builder.build_alloca(this_ty, "strcat.this");
                this.builder.build_store(lhs_val, this_slot);
                mut args: Pair<LValue, TypeRef>[] = [];
                args.push(Pair<LValue, TypeRef>::new(this_slot, TypeRef::invalid()));
                args.push(Pair<LValue, TypeRef>::new(rhs_val, TypeRef::invalid()));
                out_value = this.codegen_call(fn_val, fn_ty, args, "strcat");
                return out_value;
            }
            // Ordered comparison between two strings (i.e. raw `char*`
            // buffer walking (`this.current >= this.buffer_end`).  LLVM
            // allows `icmp` directly on matching pointer types; treat as
            // unsigned since address space is unsigned.  Without this,
            // `codegen_binary` fell through to the null-return below and
            // stripped any method body containing such a comparison.
            if (op_kind == TokenType::LAngle || op_kind == TokenType::RAngle ||
                op_kind == TokenType::LessEqual || op_kind == TokenType::GreaterEqual) {
                mut icmp_op: LIntPredicate = LIntPredicate::ULT;
                if (op_kind == TokenType::RAngle) {
                    icmp_op = LIntPredicate::UGT;
                } else if (op_kind == TokenType::LessEqual) {
                    icmp_op = LIntPredicate::ULE;
                } else if (op_kind == TokenType::GreaterEqual) {
                    icmp_op = LIntPredicate::UGE;
                }
                out_value = this.builder.build_icmp(icmp_op, lhs_val, rhs_val, "ptrcmp");
                return out_value;
            }
            out_value = LValue::null();
            return out_value;
        }

        // Enum comparison: compare i32 discriminant tags.
        // For simple enums the value is already i32.
        // For ADT enums extract field 0 (the tag) first.
        if (t_kind == TypeKind::Enum) {
            if (op_kind == TokenType::EqualEqual || op_kind == TokenType::ExclaimEqual) {
                mut lhs_tag: LValue = lhs_val;
                mut rhs_tag: LValue = rhs_val;
                // Check if this is an ADT enum (struct type in LLVM) or simple (i32).
                const lhs_llvm_ty: void* = llvm::LLVMTypeOf(lhs_val.raw);
                if (lhs_llvm_ty != null && type_kind_of(lhs_llvm_ty) == LTypeKind::Struct) {
                    // ADT enum: extract the discriminant tag at field 0
                    // before comparing.  Skipping this would feed the full
                    // struct to icmp and trip "icmp requires integer
                    // operands" at verify time.
                    lhs_tag = this.builder.build_extract_value(lhs_val, 0, "lhs.tag");
                    rhs_tag = this.builder.build_extract_value(rhs_val, 0, "rhs.tag");
                }
                if (op_kind == TokenType::EqualEqual) {
                    out_value = this.builder.build_icmp(LIntPredicate::EQ, lhs_tag, rhs_tag, "enum.eq");
                } else {
                    out_value = this.builder.build_icmp(LIntPredicate::NE, lhs_tag, rhs_tag, "enum.ne");
                }
                return out_value;
            }
            out_value = LValue::null();
            return out_value;
        }

        // Bail out if the operand type is not numeric, pointer/reference, or
        // function.  Operating on void/error/unresolved types crashes LLVM.
        // Function types are included so that `fn_ptr != null` and
        // `fn_ptr == fn_ptr` checks reach the icmp path below; both lower
        // to LLVM `ptr`, so the existing pointer-comparison logic works
        // unchanged.  Reference is included so that `&arr[i] + offset`
        // (which sema types as `&T`, not `T*`) reaches the GEP path below.
        if (t_kind != TypeKind::Int && t_kind != TypeKind::Float &&
            t_kind != TypeKind::Bool && t_kind != TypeKind::Pointer &&
            t_kind != TypeKind::Reference &&
            t_kind != TypeKind::Char && t_kind != TypeKind::Function) {
            out_value = LValue::null();
            return out_value;
        }

        // Pointer + int / Pointer - int → GEP over the pointee type.
        // LLVM rejects `add ptr, i64`; the arithmetic must be expressed
        // as a getelementptr with a scaled integer index.  Matches the
        // string-plus-int path above but for typed pointers (`i8*`, `u8*`
        // etc. used for C-string or buffer walking).  References (`&T`)
        // share the same opaque-ptr representation; route them through the
        // same path by reading the referent type instead of the pointee.
        if ((t_kind == TypeKind::Pointer || t_kind == TypeKind::Reference) &&
            (op_kind == TokenType::Plus || op_kind == TokenType::Minus)) {
            mut elem_ty: TypeRef = TypeRef::invalid();
            if (t_kind == TypeKind::Pointer) {
                const ptr_t: PointerType* = t as PointerType*;
                elem_ty = ptr_t.pointee;
            } else {
                const ref_t: ReferenceType* = t as ReferenceType*;
                elem_ty = ref_t.referent;
            }
            const pointee_lty: LType = this.type_mapper.map_type(elem_ty);
            if (pointee_lty.is_valid()) {
                mut idx: LValue = rhs_val;
                if (op_kind == TokenType::Minus) {
                    idx = this.builder.build_neg(rhs_val, "gep.neg");
                }
                const buf: void* = intrinsics::malloc(8);
                const slots: void** = buf as void**;
                slots[0] = idx.raw;
                out_value = this.builder.build_gep(
                    pointee_lty, lhs_val, buf, 1, "ptradv");
                intrinsics::free(buf);
                return out_value;
            }
        }

        const is_float: boolean = t_kind == TypeKind::Float;
        mut is_signed: boolean = false;
        if (t_kind == TypeKind::Int) {
            const int_t: IntType* = t as IntType*;
            const ik: IntegerKind = int_t.int_kind;
            is_signed = ik.is_signed();
        }

        // Normalize integer operand widths.
        // LLVM requires both operands to binary ops (icmp, add, shl, etc.)
        // to have the same type.  If they differ (e.g., i32 vs i64),
        // extend the narrower one to match the wider.
        mut lhs: LValue = lhs_val;
        mut rhs: LValue = rhs_val;
        if (!is_float) {
            const lhs_ty: void* = llvm::LLVMTypeOf(lhs.raw);
            const rhs_ty: void* = llvm::LLVMTypeOf(rhs.raw);
            const lhs_kind: LTypeKind = type_kind_of(lhs_ty);
            const rhs_kind: LTypeKind = type_kind_of(rhs_ty);
            if (lhs_ty != null && rhs_ty != null &&
                lhs_kind == LTypeKind::Integer && rhs_kind == LTypeKind::Integer) {
                const lhs_w: u32 = llvm::LLVMGetIntTypeWidth(lhs_ty);
                const rhs_w: u32 = llvm::LLVMGetIntTypeWidth(rhs_ty);
                if (lhs_w < rhs_w) {
                    const target: LType = LType { raw: rhs_ty };
                    if (is_signed) {
                        lhs = this.builder.build_sext(lhs, target, "widen");
                    } else {
                        lhs = this.builder.build_zext(lhs, target, "widen");
                    }
                } else if (rhs_w < lhs_w) {
                    const target: LType = LType { raw: lhs_ty };
                    if (is_signed) {
                        rhs = this.builder.build_sext(rhs, target, "widen");
                    } else {
                        rhs = this.builder.build_zext(rhs, target, "widen");
                    }
                }
            } else if (lhs_ty != null && rhs_ty != null &&
                       lhs_kind == LTypeKind::Integer && rhs_kind == LTypeKind::Pointer) {
                // int <op> ptr: coerce int to ptr so icmp on two pointers
                // succeeds.  Address comparisons in stdlib (e.g., aligned_addr
                // < base + offset, where the int side holds a ptrtoint'd
                // address) depend on this normalization.
                const ptr_ty: LType = LType { raw: rhs_ty };
                lhs = this.builder.build_int_to_ptr(lhs, ptr_ty, "int2ptr");
            } else if (lhs_ty != null && rhs_ty != null &&
                       lhs_kind == LTypeKind::Pointer && rhs_kind == LTypeKind::Integer) {
                const ptr_ty: LType = LType { raw: lhs_ty };
                rhs = this.builder.build_int_to_ptr(rhs, ptr_ty, "int2ptr");
            }
        }

        match (op_kind) {
            // Arithmetic
            TokenType::Plus => {
                out_value = if (is_float) {
                    this.builder.build_fadd(lhs, rhs, "addtmp")
                } else {
                    this.builder.build_add(lhs, rhs, "addtmp")
                };
            }
            TokenType::Minus => {
                out_value = if (is_float) {
                    this.builder.build_fsub(lhs, rhs, "subtmp")
                } else {
                    this.builder.build_sub(lhs, rhs, "subtmp")
                };
            }
            TokenType::Star => {
                out_value = if (is_float) {
                    this.builder.build_fmul(lhs, rhs, "multmp")
                } else {
                    this.builder.build_mul(lhs, rhs, "multmp")
                };
            }
            TokenType::Slash => {
                out_value = if (is_float) {
                    this.builder.build_fdiv(lhs, rhs, "divtmp")
                } else { if (is_signed) {
                    this.builder.build_sdiv(lhs, rhs, "divtmp")
                } else {
                    this.builder.build_udiv(lhs, rhs, "divtmp")
                } };
            }
            TokenType::Percent => {
                out_value = if (is_float) {
                    this.builder.build_frem(lhs, rhs, "remtmp")
                } else { if (is_signed) {
                    this.builder.build_srem(lhs, rhs, "remtmp")
                } else {
                    this.builder.build_urem(lhs, rhs, "remtmp")
                } };
            }

            // Comparison
            TokenType::EqualEqual => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OEQ, lhs, rhs, "eqtmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::EQ, lhs, rhs, "eqtmp")
                };
            }
            TokenType::ExclaimEqual => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::ONE, lhs, rhs, "netmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::NE, lhs, rhs, "netmp")
                };
            }
            TokenType::LAngle => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OLT, lhs, rhs, "lttmp")
                } else { if (is_signed) {
                    this.builder.build_icmp(LIntPredicate::SLT, lhs, rhs, "lttmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::ULT, lhs, rhs, "lttmp")
                } };
            }
            TokenType::RAngle => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OGT, lhs, rhs, "gttmp")
                } else { if (is_signed) {
                    this.builder.build_icmp(LIntPredicate::SGT, lhs, rhs, "gttmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::UGT, lhs, rhs, "gttmp")
                } };
            }
            TokenType::LessEqual => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OLE, lhs, rhs, "letmp")
                } else { if (is_signed) {
                    this.builder.build_icmp(LIntPredicate::SLE, lhs, rhs, "letmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::ULE, lhs, rhs, "letmp")
                } };
            }
            TokenType::GreaterEqual => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OGE, lhs, rhs, "getmp")
                } else { if (is_signed) {
                    this.builder.build_icmp(LIntPredicate::SGE, lhs, rhs, "getmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::UGE, lhs, rhs, "getmp")
                } };
            }

            // Bitwise
            TokenType::Amp            => { out_value = this.builder.build_and(lhs, rhs, "andtmp"); }
            TokenType::Pipe           => { out_value = this.builder.build_or(lhs, rhs, "ortmp"); }
            TokenType::Caret          => { out_value = this.builder.build_xor(lhs, rhs, "xortmp"); }
            TokenType::LessLess       => { out_value = this.builder.build_shl(lhs, rhs, "shltmp"); }
            TokenType::GreaterGreater => {
                out_value = if (is_signed) {
                    this.builder.build_ashr(lhs, rhs, "shrtmp")
                } else {
                    this.builder.build_lshr(lhs, rhs, "shrtmp")
                };
            }

            _ => { out_value = LValue::null(); }
        }
        return out_value;
    }

    /// Generate IR for a unary expression.
    codegen_unary(mut &this, operand: LValue, op_kind: TokenType, operand_type: TypeRef) -> LValue {
        mut out_value: LValue = LValue::null();
        const t: Type* = this.lookup_type_by_id(operand_type.id);
        mut t_kind: TypeKind = TypeKind::Error;
        if (t != null) { t_kind = t.kind; }
        const is_float: boolean = t_kind == TypeKind::Float;

        match (op_kind) {
            TokenType::Minus => {
                out_value = if (is_float) {
                    this.builder.build_fneg(operand, "negtmp")
                } else {
                    this.builder.build_neg(operand, "negtmp")
                };
            }
            TokenType::Exclaim => { out_value = this.builder.build_not(operand, "nottmp"); }
            TokenType::Tilde   => { out_value = this.builder.build_not(operand, "bnottmp"); }
            _                  => { out_value = LValue::null(); }
        }
        return out_value;
    }

    /// Promote a value of a fixed-size array slot to a fat pointer
    /// `{T*, i64, i64}` when stored into a dynamic-array field.
    coerce_fixed_array_to_fat_ptr(mut &this, val: LValue, field_type: TypeRef) -> LValue {
        if (!val.is_valid()) { return val; }
        const ft: Type* = this.lookup_type_by_id(field_type.id);
        if (ft == null || ft.kind != TypeKind::Array) { return val; }
        const arr_t: ArrayType* = ft as ArrayType*;
        if (arr_t.is_fixed()) { return val; }

        const got_ty: void* = llvm::LLVMTypeOf(val.raw);
        if (type_kind_of(got_ty) != LTypeKind::Array) { return val; }

        const elem_count: u32 = llvm::LLVMGetArrayLength(got_ty);
        const elem_lty: LType = LType { raw: llvm::LLVMGetElementType(got_ty) };

        const elem_t_raw: Type* = this.lookup_type_by_id(arr_t.element.id);
        mut elem_size: u64 = 1;
        if (elem_t_raw != null && elem_t_raw.size_bytes() > 0) {
            elem_size = elem_t_raw.size_bytes();
        }
        const total_bytes: u64 = elem_size * (elem_count as u64);
        const total_bytes_val: LValue = LType::const_int(LType::i64(), total_bytes, false);

        const current_bb: LBasicBlock = this.builder.get_insert_block();
        if (!current_bb.is_valid()) { return val; }
        const fn_val: LValue = current_bb.get_parent();
        if (!fn_val.is_valid()) { return val; }

        // Stash the fixed array on the stack so we have a source pointer for memcpy.
        const src: LValue = this.create_entry_alloca(fn_val, "arrlit.src", LType { raw: got_ty });
        this.builder.build_store(val, src);

        // malloc(N * sizeof(T)) for the fat-pointer's owned buffer.
        const malloc_fn: LValue = this.resolve_function(this.intern_str("malloc"));
        if (!malloc_fn.is_valid()) { return val; }
        const malloc_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(malloc_fn.raw) };
        mut malloc_args: Pair<LValue, TypeRef>[] = [];
        malloc_args.push(Pair<LValue, TypeRef>::new(total_bytes_val, TypeRef::invalid()));
        mut data_ptr: LValue = LValue::null();
        data_ptr = this.codegen_call(malloc_fn, malloc_ty, malloc_args, "arrlit.heap");
        if (!data_ptr.is_valid()) { return val; }

        llvm::LLVMBuildMemCpy(this.builder.raw,
                              data_ptr.raw, 1,
                              src.raw, 1,
                              total_bytes_val.raw);

        // Build the fat-pointer struct: { data_ptr, count, count }.
        const elem_ptr_lty: LType = LType::pointer_to(elem_lty);
        const i64_ty: LType = LType::i64();
        const buf: void* = intrinsics::malloc(24);
        const slots: void** = buf as void**;
        slots[0] = elem_ptr_lty.raw;
        slots[1] = i64_ty.raw;
        slots[2] = i64_ty.raw;
        const fat_ty: LType = LType::literal_struct(buf, 3, false);
        intrinsics::free(buf);

        const fat: LValue = this.create_entry_alloca(fn_val, "arrlit.fat", fat_ty);
        const ptr_slot: LValue = this.builder.build_struct_gep(fat_ty, fat, 0, "fat.ptr");
        this.builder.build_store(data_ptr, ptr_slot);
        const len_slot: LValue = this.builder.build_struct_gep(fat_ty, fat, 1, "fat.len");
        const count_val: LValue = LType::const_int(LType::i64(), elem_count as u64, false);
        this.builder.build_store(count_val, len_slot);
        const cap_slot: LValue = this.builder.build_struct_gep(fat_ty, fat, 2, "fat.cap");
        this.builder.build_store(count_val, cap_slot);

        return this.builder.build_load(fat_ty, fat, "arrlit.fat.val");
    }


    /// Heap-box an enum variant value for `new T::V(...)`.
    /// Allocates et.computed_size bytes, bitcasts to the enum struct pointer
    /// type, and stores the loaded variant struct value at offset 0.
    /// Returns the typed pointer.
    heap_box_enum_variant(mut &this, et: EnumType*, enum_ref: TypeRef, variant_val: LValue, span: SourceSpan) -> LValue {
        const malloc_fn: LValue = this.resolve_function(this.intern_str("malloc"));
        if (!malloc_fn.is_valid()) {
            this.emit_error_at_span(ErrorCode::E0636_UNDEFINED_FUNCTION_CALL,
                "codegen: new T::V: malloc not declared",
                span);
            return LValue::null();
        }
        const malloc_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(malloc_fn.raw) };
        if (!malloc_ty.is_valid()) {
            this.emit_error_at_span(ErrorCode::E0602_INVALID_LLVM_TYPE,
                "codegen: new T::V: failed to retrieve malloc function type",
                span);
            return LValue::null();
        }

        const size: u64 = et.computed_size;
        if (size == 0) {
            this.emit_error_at_span(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "codegen: enum computed_size is 0 reaching codegen (TypeLowering bug)",
                span);
            return LValue::null();
        }

        const size_val: LValue = LType::const_int(LType::i64(), size, false);
        mut malloc_args: Pair<LValue, TypeRef>[] = [];
        malloc_args.push(Pair<LValue, TypeRef>::new(size_val, TypeRef::invalid()));
        mut raw_ptr: LValue = LValue::null();
        raw_ptr = this.codegen_call(malloc_fn, malloc_ty, malloc_args, "newenum");

        const enum_llvm: LType = this.type_mapper.map_type(enum_ref);
        if (!enum_llvm.is_valid()) {
            this.emit_error_at_span(ErrorCode::E0609_TYPE_MAPPING_ERROR,
                "codegen: new T::V: failed to map enum type",
                span);
            return LValue::null();
        }
        const obj_ptr: LValue = this.builder.build_pointer_cast(
            raw_ptr, LType::pointer_to(enum_llvm), "newenumcast");

        if (variant_val.is_valid() && obj_ptr.is_valid()) {
            this.builder.build_store(variant_val, obj_ptr);
        }

        return obj_ptr;
    }


    // ========================================================================
    // Statement codegen primitives (return + return-value coercion).  Each
    // emits IR for one form of statement, mirroring the AST node kind.
    // ========================================================================


    codegen_return(mut &this, val: LValue, has_value: boolean, src_ty: TypeRef) -> void {
        if (has_value && val.is_valid()) {
            // Unit-returning functions lower to `void` in LLVM (see
            // map_return_type), so a source-level `return unit_expr;`
            // must emit `ret void` rather than `ret {} %unit`; the
            // verifier rejects the latter.  Detect the mismatch by
            // looking at the current function's LLVM return type.
            const cur_bb: LBasicBlock = this.builder.get_insert_block();
            if (cur_bb.is_valid()) {
                const fn: LValue = cur_bb.get_parent();
                if (fn.is_valid()) {
                    const fn_ty_raw: void* = llvm::LLVMGlobalGetValueType(fn.raw);
                    if (type_kind_of(fn_ty_raw) == LTypeKind::Function) {
                        const ret_ty_raw: void* = llvm::LLVMGetReturnType(fn_ty_raw);
                        if (type_kind_of(ret_ty_raw) == LTypeKind::Void) {
                            this.emit_va_end_if_variadic(this.current_variadic_arg());
                            this.builder.build_ret_void();
                            return;
                        }
                    }
                }
            }
            // Coerce the return value to the function's declared return type.
            // Handles common implicit conversions like u64↔ptr (stdlib uses this
            // in `align_up`/`align_down`) and narrower integer returns.
            const coerced: LValue = this.coerce_return_value(val, src_ty);
            this.emit_va_end_if_variadic(this.current_variadic_arg());
            this.builder.build_ret(coerced);
        } else if (!has_value) {
            this.emit_va_end_if_variadic(this.current_variadic_arg());
            this.builder.build_ret_void();
        }
        // If has_value but val is null, expression codegen failed.
        // Don't emit anything; the caller will detect the incomplete
        // function and strip it back to a declare.
    }

    /// Coerce a return-statement value to match the declared return type.
    /// Emits inttoptr/ptrtoint/trunc/sext/zext when the straight ret would fail
    /// LLVM verification.  Returns the original value if no coercion is needed.
    ///
    /// `src_ty` is the Cryo type of the returned *expression*; it drives the
    /// sext-vs-zext choice when the value is narrower than the declared return
    /// type.  Without it a `return some_i32_negative;` from an `-> i64` function
    /// would `zext` and turn `-1` into `0xFFFFFFFF`.
    ///
    /// Comparisons use LLVMGetTypeKind codes (integers) rather than void*
    /// equality; `==` on `void*` currently lowers to strcmp, so we never pull
    /// the raw types into a `==` expression.
    coerce_return_value(mut &this, val: LValue, src_ty: TypeRef) -> LValue {
        const cur_bb: LBasicBlock = this.builder.get_insert_block();
        if (!cur_bb.is_valid()) { return val; }
        const fn: LValue = cur_bb.get_parent();
        if (!fn.is_valid()) { return val; }

        const fn_ty_raw: void* = llvm::LLVMGlobalGetValueType(fn.raw);
        if (type_kind_of(fn_ty_raw) != LTypeKind::Function) {
            return val;
        }
        const want_ty_raw: void* = llvm::LLVMGetReturnType(fn_ty_raw);
        const got_ty_raw: void* = llvm::LLVMTypeOf(val.raw);

        const want_kind: LTypeKind = type_kind_of(want_ty_raw);
        const got_kind:  LTypeKind = type_kind_of(got_ty_raw);
        const want_lty: LType = LType { raw: want_ty_raw };

        if (want_kind == LTypeKind::Pointer && got_kind == LTypeKind::Integer) {
            return this.builder.build_int_to_ptr(val, want_lty, "ret.inttoptr");
        }
        if (want_kind == LTypeKind::Integer && got_kind == LTypeKind::Pointer) {
            return this.builder.build_ptr_to_int(val, want_lty, "ret.ptrtoint");
        }

        // Struct → ptr: arises from `return this` / `return some_lvalue` in a
        // method whose return type is `&Self` (or any reference).  codegen_rvalue
        // dutifully loads the struct from the receiver pointer; the function
        // signature wants the pointer back.  If `val` is a load instruction, we
        // can recover the pre-load address (the load's only operand) and
        // return that, leaving the dead load to be DCE'd by LLVM.
        // LLVMOpcode::Load = 27 (LLVM-C enum, stable across LLVM 14-20).
        if (want_kind == LTypeKind::Pointer && got_kind == LTypeKind::Struct) {
            const opcode: i32 = llvm::LLVMGetInstructionOpcode(val.raw);
            if (opcode == 27) {
                const ptr_operand: void* = llvm::LLVMGetOperand(val.raw, 0);
                if (ptr_operand != null) {
                    return LValue { raw: ptr_operand };
                }
            }
        }
        if (want_kind == LTypeKind::Integer && got_kind == LTypeKind::Integer) {
            const want_bits: u32 = llvm::LLVMGetIntTypeWidth(want_ty_raw);
            const got_bits:  u32 = llvm::LLVMGetIntTypeWidth(got_ty_raw);
            if (want_bits > got_bits) {
                // Widen with the *returned value's* signedness, not zext
                // unconditionally: `return some_i32` from an `-> i64` fn must
                // sign-extend a signed i32 so `-1` stays `-1`.
                if (this.int_type_is_signed(src_ty)) {
                    return this.builder.build_sext(val, want_lty, "ret.sext");
                }
                return this.builder.build_zext(val, want_lty, "ret.zext");
            }
            if (want_bits < got_bits) {
                return this.builder.build_trunc(val, want_lty, "ret.trunc");
            }
        }

        // Fixed-size array `[N x T]` → dynamic fat pointer `{T*, i64}`.  Happens
        // when a function typed `T[]` returns `[a, b, ...]` and sema didn't
        // propagate the dynamic expected_type into the array-literal's resolved
        // shape.  Stash the loaded array on the stack, malloc N*sizeof(T), memcpy
        // the contents, and build the fat pointer, keeping IR verifiable even
        // when upstream inference is incomplete.
        if (want_kind == LTypeKind::Struct && got_kind == LTypeKind::Array) {
            const len: u32 = llvm::LLVMGetArrayLength(got_ty_raw);
            const elem_ty_raw: void* = llvm::LLVMGetElementType(got_ty_raw);
            const elem_size_val: LValue = LValue { raw: llvm::LLVMSizeOf(elem_ty_raw) };
            const len_val: LValue = LType::const_int(LType::i64(), len as u64, false);
            const byte_count: LValue = this.builder.build_mul(
                len_val, elem_size_val, "ret.bytecnt");

            const src_alloca: LValue = this.create_entry_alloca(
                fn, "ret.src", LType { raw: got_ty_raw });
            this.builder.build_store(val, src_alloca);

            const malloc_fn: LValue = this.resolve_function(this.intern_str("malloc"));
            if (!malloc_fn.is_valid()) {
                return val;
            }
            const malloc_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(malloc_fn.raw) };
            mut malloc_args: Pair<LValue, TypeRef>[] = [];
            malloc_args.push(Pair<LValue, TypeRef>::new(byte_count, TypeRef::invalid()));
            mut data_ptr: LValue = LValue::null();
            data_ptr = this.codegen_call(malloc_fn, malloc_ty, malloc_args, "ret.data");
            if (!data_ptr.is_valid()) {
                return val;
            }

            llvm::LLVMBuildMemCpy(this.builder.raw,
                                  data_ptr.raw, 1,
                                  src_alloca.raw, 1,
                                  byte_count.raw);

            const fat_alloca: LValue = this.create_entry_alloca(fn, "ret.fat", want_lty);
            const ptr_slot: LValue = this.builder.build_struct_gep(
                want_lty, fat_alloca, 0, "ret.fat.ptr");
            this.builder.build_store(data_ptr, ptr_slot);
            const len_slot: LValue = this.builder.build_struct_gep(
                want_lty, fat_alloca, 1, "ret.fat.len");
            this.builder.build_store(len_val, len_slot);
            const cap_slot: LValue = this.builder.build_struct_gep(
                want_lty, fat_alloca, 2, "ret.fat.cap");
            this.builder.build_store(len_val, cap_slot);

            const loaded: LValue = this.builder.build_load(want_lty, fat_alloca, "ret.fat.val");
            return loaded;
        }

        return val;
    }

    // ========================================================================
    // Declaration emission.  Phase-1 (forward-declare types) and Phase-2
    // (declare functions, methods, externs, globals, vtables) of the codegen
    // pipeline; called by the Codegen pass before body emission begins.
    // ========================================================================

    /// Walk the program and forward-declare all struct/class/enum types as
    /// named LLVM struct types.  This must run before function declarations
    /// so that parameter and return types can reference these types.
    declare_types(mut &this, program: ProgramNode*) -> void {
        const stmts: ASTNode*[] = program.statements;
        for (mut i: i64 = 0; i < stmts.length; i++) {
            const stmt: ASTNode* = stmts[i];
            if (stmt == null) { continue; }

            match (stmt.kind) {
                NodeKind::StructDeclaration => {
                    this.declare_struct_type(stmt as StructDeclNode*);
                }
                NodeKind::ClassDeclaration => {
                    this.declare_class_type(stmt as ClassDeclNode*);
                }
                NodeKind::EnumDeclaration => {
                    this.declare_enum_type(stmt as EnumDeclNode*);
                }
                // Impl blocks may contain methods we need, but types are
                // already declared via StructDecl/ClassDecl.
                _ => {}
            }
        }
    }

    /// Declare the `@llvm.va_start.p0` intrinsic in the current LLVM module.
    /// Signature: `void (ptr)`: the argument is a pointer to the va_list
    /// storage to initialize from the caller's argument area.
    declare_va_start(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("llvm.va_start.p0");
        if (fn.is_valid()) { return fn; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const buf: void* = intrinsics::malloc(8);
        const slots: void** = buf as void**;
        slots[0] = ptr_ty.raw;
        const fty: LType = LType::function_type(LType::void_type(), buf, 1, false);
        intrinsics::free(buf);
        fn = this.llvm_module.add_function("llvm.va_start.p0", fty);
        return fn;
    }

    /// Declare the `@llvm.va_end.p0` intrinsic, mirror of va_start.
    declare_va_end(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("llvm.va_end.p0");
        if (fn.is_valid()) { return fn; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const buf: void* = intrinsics::malloc(8);
        const slots: void** = buf as void**;
        slots[0] = ptr_ty.raw;
        const fty: LType = LType::function_type(LType::void_type(), buf, 1, false);
        intrinsics::free(buf);
        fn = this.llvm_module.add_function("llvm.va_end.p0", fty);
        return fn;
    }

    /// Emit va_start for a variadic function's vararg bucket.  Allocates a
    /// `[24 x i8]` (System V x86-64 va_list layout; larger than Win64's
    /// 8-byte char* so both platforms fit in the same storage) and calls
    /// @llvm.va_start on the pointer.  Binds `args_name` to the alloca so
    /// that references in the body resolve to the va_list pointer.  Stashes
    /// the args name on the context so `codegen_return` can emit `va_end`
    /// before every `ret` instruction.
    emit_va_start_for_variadic(mut &this, fn_val: LValue, args_name: SymbolStr) -> void {
        if (!args_name.is_valid()) {
            this.current_variadic_arg_id = 0;
            return;
        }
        const va_list_ty: LType = LType::array_of(LType::i8(), 24);
        const va_list_alloca: LValue = this.create_entry_alloca(
            fn_val, this.resolve(args_name), va_list_ty);
        const va_start_fn: LValue = this.declare_va_start();
        const va_start_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(va_start_fn.raw) };
        mut args: Pair<LValue, TypeRef>[] = [];
        args.push(Pair<LValue, TypeRef>::new(va_list_alloca, TypeRef::invalid()));
        mut _result: LValue = LValue::null();
        _result = this.codegen_call(va_start_fn, va_start_ty, args, "");
        this.set_named_value(args_name, va_list_alloca);
        this.current_variadic_arg_id = args_name.id;
    }

    /// Emit va_end on the va_list alloca bound to `args_name`, if that
    /// binding exists.  Called immediately before every terminating return
    /// so the va_list is properly cleaned up on every exit path.
    emit_va_end_if_variadic(mut &this, args_name: SymbolStr) -> void {
        if (!args_name.is_valid()) { return; }
        const va_list_alloca: LValue = this.get_named_value(args_name);
        if (!va_list_alloca.is_valid()) { return; }
        const va_end_fn: LValue = this.declare_va_end();
        const va_end_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(va_end_fn.raw) };
        mut args: Pair<LValue, TypeRef>[] = [];
        args.push(Pair<LValue, TypeRef>::new(va_list_alloca, TypeRef::invalid()));
        mut _result: LValue = LValue::null();
        _result = this.codegen_call(va_end_fn, va_end_ty, args, "");
    }

    /// Look up the active variadic arg's SymbolStr from the codegen context.
    /// Returns an empty SymbolStr if the current function is not variadic.
    current_variadic_arg(mut &this) -> SymbolStr {
        const id: u32 = this.current_variadic_arg_id;
        if (id == 0) { return SymbolStr::empty(); }
        return SymbolStr::from_id(id);
    }

    /// Forward-declare a struct as a named LLVM type and fill its body.
    declare_struct_type(mut &this, node: StructDeclNode*) -> void {
        // Skip generic templates; only monomorphized versions get IR.
        if (node.generic_params.length > 0) {
            return;
        }

        const name: string = this.resolve(node.name);
        const qname: QualifiedName = QualifiedName::single(this.get_intern(), name);
        const mangled: string = MangledName::for_struct_type(this.get_intern(), qname).resolve(this.get_intern());

        // Look up the Cryo StructType to get field info.
        const type_ref: TypeRef = this.ctx.decl_index.lookup_type(node.name);
        if (type_ref.is_invalid()) {
            return;
        }

        // Let the type mapper handle forward declaration + body fill.
        this.type_mapper.map_type(type_ref);
    }

    /// Forward-declare a class type.
    declare_class_type(mut &this, node: ClassDeclNode*) -> void {
        if (node.generic_params.length > 0) {
            return;
        }

        const type_ref: TypeRef = this.ctx.decl_index.lookup_type(node.name);
        if (type_ref.is_invalid()) {
            return;
        }

        this.type_mapper.map_type(type_ref);
    }

    /// Declare an enum type.
    declare_enum_type(mut &this, node: EnumDeclNode*) -> void {
        if (node.generic_params.length > 0) {
            return;
        }

        const type_ref: TypeRef = this.ctx.decl_index.lookup_type(node.name);
        if (type_ref.is_invalid()) {
            return;
        }

        this.type_mapper.map_type(type_ref);
    }

    /// Walk the program and create LLVM function declarations for all
    /// functions, methods, and extern blocks.  Also emits module-level global
    /// variable declarations so any function body that references a global
    /// (regardless of source order, e.g. `clock_gettime(CLOCK_REALTIME, ...)`
    /// where the const is declared later in the file) can resolve it.
    declare_functions(mut &this, program: ProgramNode*) -> void {
        const stmts: ASTNode*[] = program.statements;
        for (mut i: i64 = 0; i < stmts.length; i++) {
            const stmt: ASTNode* = stmts[i];
            if (stmt == null) { continue; }

            match (stmt.kind) {
                NodeKind::FunctionDeclaration => {
                    this.declare_function(stmt as FunctionDeclNode*);
                }
                NodeKind::IntrinsicDeclaration => {
                    this.declare_intrinsic(stmt as IntrinsicDeclNode*);
                }
                NodeKind::ExternBlock => {
                    this.declare_extern_block(stmt as ExternBlockNode*);
                }
                NodeKind::ImplementationBlock => {
                    this.declare_impl_block(stmt as ImplBlockNode*);
                }
                NodeKind::StructDeclaration => {
                    this.declare_struct_methods(stmt as StructDeclNode*);
                }
                NodeKind::ClassDeclaration => {
                    this.declare_class_methods(stmt as ClassDeclNode*);
                }
                NodeKind::VariableDeclaration => {
                    const var_decl: VarDeclNode* = stmt as VarDeclNode*;
                    if (var_decl.is_global) {
                        this.codegen_global_var(var_decl);
                    }
                }
                _ => {}
            }
        }
    }

    /// Declare a single function signature (no body generation).
    declare_function(mut &this, node: FunctionDeclNode*) -> void {
        // Skip generic templates.
        if (node.generic_params.length > 0) {
            return;
        }

        // Compute this overload's func_type_ref so we can look up the
        // overload-specific mangled name.  The bare-keyed `lookup_mangled_name`
        // is last-write-wins: for two `visit(A*)` / `visit(B*)` overloads,
        // both share the qualified name `Mod::visit` and the second one
        // overwrites the first's mangled-name entry.  The overload-keyed
        // table (registered alongside in type_resolution) disambiguates by
        // (name, func_type_ref).
        const ctx_ptr: CompilationContext* = this.ctx;
        const intern: InternTable* = ctx_ptr.intern_table;
        const qualified: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
        const di: DeclarationIndex* = ctx_ptr.decl_index;
        const arena: TypeArena* = this.get_arena();

        mut params: TypeRef[] = [];
        for (mut pi: i64 = 0; pi < node.parameters.length; pi++) {
            const param: VarDeclNode* = node.parameters[pi];
            if (param != null && param.resolved_type.is_valid()) {
                params.push(param.resolved_type);
            }
        }
        const func_type_ref: TypeRef = arena.get_function(
            node.resolved_return_type, params, node.is_variadic);

        mut mangled_sym: SymbolStr = di.lookup_overload_mangled(qualified, func_type_ref);
        if (!mangled_sym.is_valid()) {
            mangled_sym = di.lookup_mangled_name(qualified);
        }
        if (!mangled_sym.is_valid()) {
            // Compute and register on first use using the v0.2 mangler.
            const qname: QualifiedName = QualifiedName::from_symbol(qualified);
            const computed: MangledName = MangledName::for_free_function(
                intern, arena, qname, params,
                node.resolved_return_type, node.is_variadic);
            mangled_sym = computed.value;
            di.register_mangled_name(qualified, mangled_sym);
            di.register_overload_mangled(qualified, func_type_ref, mangled_sym);
        }
        // The C ABI entry point must be named `main` verbatim; the C
        // runtime's _start references the unmangled symbol.  Override the
        // mangled name for any free function whose source-level name is
        // `main` so the linker can find it.
        const main_sym: SymbolStr = intern.intern("main");
        mut fn_name: string = intern.resolve(mangled_sym);
        const is_program_main: boolean = node.name.equals(main_sym);
        if (is_program_main) {
            fn_name = "main";
            // `cryo test` synthesizes its own `main` that drives every
            // discovered `![test]` function; if we also emitted the user's
            // `main` the linker would see two `main` symbols.  Skip
            // declaration (and therefore body emission) in test mode.
            if (this.ctx.mode.skip_user_main()) {
                return;
            }
        }

        // Build the LLVM function type.
        const ret_ty: LType = this.map_return_type(node);
        if (!ret_ty.is_valid()) { return; }

        const param_count: u32 = fixed_param_count(node);

        mut fn_type: LType = LType::null();
        if (is_program_main && param_count == 0) {
            // The C ABI entry point is `int main(int argc, char** argv)`
            // _start always passes argc/argv, and the stdlib's
            // `std::env::args()` reads them through `set_args` (called
            // from the synthesized prologue in `codegen_function_prologue`
            // below).  User source still writes `function main() -> int`;
            // we silently widen the LLVM signature to take argc/argv.
            const argv_ty: LType = LType::pointer_to(LType::pointer_to(LType::i8()));
            const buf: void* = intrinsics::malloc(2 * 8);
            const slots: void** = buf as void**;
            slots[0] = LType::i32().raw;
            slots[1] = argv_ty.raw;
            fn_type = LType::function_type(ret_ty, buf, 2, false);
            intrinsics::free(buf);
        } else if (param_count == 0) {
            fn_type = LType::function_type(ret_ty, null, 0, node.is_variadic);
        } else {
            const buf: void* = intrinsics::malloc(param_count as u64 * 8);
            const slots: void** = buf as void**;
            mut all_valid: boolean = true;
            for (mut i: u32 = 0; i < param_count; i++) {
                const param: VarDeclNode* = node.parameters[i];
                const param_ty: LType = this.type_mapper.map_type(param.resolved_type);
                if (!param_ty.is_valid()) {
                    all_valid = false;
                    break;
                }
                slots[i] = param_ty.raw;
            }
            if (!all_valid) {
                intrinsics::free(buf);
                return;
            }
            fn_type = LType::function_type(ret_ty, buf, param_count, node.is_variadic);
            intrinsics::free(buf);
        }

        // Add the function to the LLVM module.
        const fn_val: LValue = this.llvm_module.add_function(fn_name, fn_type);

        // Register under qualified name (module scope).
        this.register_function(qualified, fn_val);
    }

    /// Declare all methods in an impl block.
    declare_impl_block(mut &this, node: ImplBlockNode*) -> void {
        // Skip generic impl blocks.
        if (node.generic_params.length > 0) {
            return;
        }

        // Use TypeResolution's canonical-qualified target when available; it
        // resolves cross-module impl targets (e.g. `implement trait FmtWrite
        // for struct Stdout` in fmt::write where Stdout lives in io::stdio)
        // by walking the bare→qualified table, so the impl's methods land
        // under the same key the type's defining module uses.  Without the
        // canonical resolution, we'd qualify with the CURRENT module and
        // produce `fmt::write::Stdout::write_str`, which `declare_method`
        // can't look up; bodies would be silently dropped and the linker
        // would surface them as undefined references.
        const ctx_ptr: CompilationContext* = this.ctx;
        mut qualified_target: SymbolStr = SymbolStr::empty();
        if (node.qualified_target_name.is_valid()) {
            qualified_target = node.qualified_target_name;
        } else {
            const target_str: string = ctx_ptr.intern_table.resolve(node.target_type);
            if (intrinsics::strstr(target_str, "::") != null) {
                qualified_target = node.target_type;
            } else if (ctx_ptr.decl_index.lookup_type(node.target_type).is_valid()) {
                qualified_target = node.target_type;
            } else {
                const resolved: SymbolStr = ctx_ptr.decl_index.resolve_qualified(node.target_type);
                if (!resolved.equals(node.target_type)) {
                    qualified_target = resolved;
                } else {
                    qualified_target = ctx_ptr.qualify_symbol_sym(node.target_type);
                }
            }
        }
        // Skip impls whose target is a generic template; only the
        // monomorphized spec'd clones should produce LLVM symbols.  Mirrors
        // the `generic_params.length > 0` skip above for `implement<T> Foo<T>`;
        // catches the additional case where the impl has no impl-level params
        // but the target type does (e.g. `implement trait Eq for struct String`
        // on `String<A = GlobalAlloc>`).  Without this, the template impl's
        // bodies are codegen'd against the bare-template `this` type, but
        // method registrations live under the spec'd target; so call sites
        // like `this.as_str()` inside the template body fail to resolve.
        if (ctx_ptr.generic_registry != null) {
            const greg: GenericRegistry* = ctx_ptr.generic_registry;
            if (greg.get_template(qualified_target) != null) {
                return;
            }
        }

        for (mut i: i64 = 0; i < node.methods.length; i++) {
            this.declare_method(node.methods[i], qualified_target);
        }
    }

    /// Declare methods defined inline within a struct declaration.
    declare_struct_methods(mut &this, node: StructDeclNode*) -> void {
        if (node.generic_params.length > 0) {
            return;
        }
        if (node.methods.length == 0) {
            return;
        }
        // Use the arena's canonical qualified name for the struct type.
        // For specialized structs (e.g., Array_Token), the arena name is
        // the correct DI key (e.g., std::collections::array::Array_Token).
        // qualify_symbol_sym would produce the consuming module's namespace
        // prefix, which doesn't match the DI registration.
        const ctx_ptr: CompilationContext* = this.ctx;
        const di: DeclarationIndex* = ctx_ptr.decl_index;
        mut qualified: SymbolStr = SymbolStr::empty();
        // Try both local-qualified and bare name in the DI, then get the
        // arena's canonical qualified name from the TypeRef.
        const local_sym: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
        mut di_ref: TypeRef = di.lookup_type(local_sym);
        if (!di_ref.is_valid()) {
            di_ref = di.lookup_type(node.name);
        }
        if (di_ref.is_valid()) {
            const arena: TypeArena* = this.get_arena();
            qualified = arena.get_qualified_name(di_ref);
        }
        if (!qualified.is_valid()) {
            qualified = local_sym;
        }
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            this.declare_method(node.methods[i], qualified);
        }
    }

    /// Declare methods defined inline within a class declaration.
    declare_class_methods(mut &this, node: ClassDeclNode*) -> void {
        if (node.generic_params.length > 0) {
            return;
        }
        // Qualify the class name; node.name is the bare AST name.
        // Split `this.ctx.qualify_symbol_sym(...)` via a local: double-deref
        // chains have historically been a source of subtle codegen bugs.
        const ctx_ptr: CompilationContext* = this.ctx;
        const qualified: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            this.declare_method(node.methods[i], qualified);
        }

        // Emit the vtable for classes with virtual methods.  Drive this from
        // ClassType.methods + its base chain (populated by the type-resolution
        // pass) so the vtable is inheritance-complete: a subclass's vtable has
        // one slot per virtual method introduced anywhere in the ancestry,
        // in the order of first introduction (root → leaf).  The slot's
        // implementation is the most-derived override present in the chain,
        // falling back to the inherited base implementation when the subclass
        // doesn't override that slot.  Layout discipline is what makes call-site
        // dispatch work: a `Base*` callsite looks up slot N in `Base`'s layout,
        // and any subclass's vtable guarantees slot N at the same index.
        const di: DeclarationIndex* = ctx_ptr.decl_index;
        const type_ref: TypeRef = di.lookup_type(qualified);
        if (type_ref.is_valid()) {
            const arena: TypeArena* = this.get_arena();
            const t: Type* = arena.lookup(type_ref.id);
            if (t != null && t.kind == TypeKind::Class) {
                const cls: ClassType* = t as ClassType*;
                if (cls.has_virtual_methods) {
                    this.codegen_vtable_for_class(cls);
                }
            }
        }
    }

    /// Walk the class's base chain (leaf → root) and collect the ordered
    /// list of virtual-method slots.  New `is_virtual` methods append a
    /// new slot; `is_override` methods do NOT; they install into an
    /// existing slot at vtable-emission time.  The returned list is in
    /// root → leaf declaration order, so every subclass's vtable extends
    /// the base's layout with its own additions.
    collect_vtable_slots(mut &this, cls: ClassType*) -> VTableSlot[] {
        const arena: TypeArena* = this.get_arena();

        // Build chain = [cls, ..., root].
        mut chain: ClassType*[] = [];
        mut walk: ClassType* = cls;
        mut depth: i32 = 0;
        while (walk != null && depth < 16) {
            chain.push(walk);
            if (!walk.has_base || !walk.base_class.is_valid()) { break; }
            const base_t: Type* = arena.lookup(walk.base_class.id);
            if (base_t == null || base_t.kind != TypeKind::Class) { break; }
            walk = base_t as ClassType*;
            depth += 1;
        }

        mut slots: VTableSlot[] = [];
        for (mut ci: i64 = chain.length - 1; ci >= 0; ci--) {
            const link: ClassType* = chain[ci];
            for (mut mi: i64 = 0; mi < link.methods.length; mi++) {
                const m: MethodInfo = link.methods[mi];
                if (!m.is_virtual) { continue; }
                mut already: boolean = false;
                for (mut ki: i64 = 0; ki < slots.length; ki++) {
                    if (slots[ki].name.equals(m.name) &&
                        param_types_equal(slots[ki].param_types, m.param_types)) {
                        already = true;
                        break;
                    }
                }
                if (!already) {
                    slots.push(VTableSlot { name: m.name, param_types: m.param_types });
                }
            }
        }
        return slots;
    }

    /// For a given vtable slot (name + param_types), walk leaf → root and
    /// return the first matching method's LLVM function: the most-derived
    /// override, falling back to the inherited base implementation when
    /// the subclass doesn't override that specific overload.  Resolution
    /// goes through the overload-specific mangled name so the correct LLVM
    /// function is installed in the slot, not the last-registered one
    /// under `Type::method`.
    find_vtable_slot_impl(mut &this, cls: ClassType*, slot_name: SymbolStr, slot_params: TypeRef[]) -> LValue {
        const arena: TypeArena* = this.get_arena();
        const intern: InternTable* = this.get_intern();
        mut walk: ClassType* = cls;
        mut depth: i32 = 0;
        while (walk != null && depth < 16) {
            for (mut mi: i64 = 0; mi < walk.methods.length; mi++) {
                const m: MethodInfo = walk.methods[mi];
                if (!m.name.equals(slot_name)) { continue; }
                // Use structural (display-name) equality on params instead of
                // raw-ID matching: an override method's params can resolve to
                // different TypeRef IDs than the virtual base's params even
                // though they're semantically the same type (e.g. `ASTVisitor*`
                // registered before vs. after the visitor module finished
                // resolving).  Strict ID matching here misses every override
                // and the whole vtable bails (every `new <DerivedClass>` then
                // skips the vtable store; runtime virtual dispatch crashes
                // reading a null vtable pointer).
                if (!param_types_equal_structural(arena, intern, m.param_types, slot_params)) { continue; }
                if (!m.is_virtual && !m.is_override) { continue; }
                // Skip pure virtual declarations (virtual without body).
                // Their LLVM function is a bare `declare` that links as an
                // undefined reference.  Keep walking up; a concrete override
                // must come from further up the chain, or the caller's
                // `!impl.is_valid()` bail drops the whole vtable.
                if (m.ast_node != null) {
                    const mnode_ck: MethodNode* = m.ast_node as MethodNode*;
                    if (mnode_ck != null && mnode_ck.func != null && !mnode_ck.func.has_body()) {
                        continue;
                    }
                }
                const type_qname: QualifiedName = QualifiedName::from_symbol(walk.qualified_name);
                const method_str: string = intern.resolve(slot_name);
                // Resolve method's full signature for the v0.2 mangler.
                mut method_ret: TypeRef = TypeRef::invalid();
                mut method_variadic: boolean = false;
                const fn_t: Type* = arena.lookup(m.function_type.id);
                if (fn_t != null && fn_t.kind == TypeKind::Function) {
                    const fn_ty: FunctionType* = fn_t as FunctionType*;
                    method_ret = fn_ty.return_type;
                    method_variadic = fn_ty.is_variadic;
                }
                // MethodInfo.param_types already excludes the receiver.  Default
                // to ImmutRef receiver for virtual methods; if the method has
                // a `mut &this` receiver we recover it from the AST node.
                mut recv_kind: ReceiverKind = ReceiverKind::ImmutRef;
                if (m.ast_node != null) {
                    const mn: MethodNode* = m.ast_node as MethodNode*;
                    if (mn != null && mn.func != null) {
                        recv_kind = method_receiver_kind(mn.func, mn.is_static, intern);
                    }
                }
                const computed: MangledName = MangledName::for_method(
                    intern, arena, type_qname, slot_name, recv_kind,
                    m.param_types, method_ret, method_variadic);
                // Look up the LLVM function by its mangled name directly
                // in the module.  resolve_function/this.get_function cache by
                // bare or qualified name, which is last-write-wins for
                // overloaded virtuals; the cache would hand out whichever
                // overload was declared most recently regardless of which
                // slot we're filling, populating every inherited slot with
                // the same (wrong) function.
                const mangled_str: string = intern.resolve(computed.value);
                mut fn_val: LValue = this.llvm_module.get_named_function(mangled_str);
                if (!fn_val.is_valid()) {
                    fn_val = this.resolve_function(computed.value);
                }
                if (!fn_val.is_valid()) {
                    const type_str: string = intern.resolve(walk.qualified_name);
                    const combined: string = format("%s::%s", type_str, method_str);
                    fn_val = this.resolve_function(intern.intern(combined));
                }
                return fn_val;
            }
            if (!walk.has_base || !walk.base_class.is_valid()) { break; }
            const base_t: Type* = arena.lookup(walk.base_class.id);
            if (base_t == null || base_t.kind != TypeKind::Class) { break; }
            walk = base_t as ClassType*;
            depth += 1;
        }
        return LValue::null();
    }

    /// Return the vtable slot index of (method_name, param_types) in this
    /// class's layout, or -1 if no matching virtual slot exists.  Called
    /// from codegen dispatch after sema has identified the exact overload
    /// via `CallExprNode.resolved_method`; this function just maps that
    /// declaration to its slot position.
    ///
    /// Uses *structural* param-type equality (display-name match) rather than
    /// strict arena-ID match: an override method's parameter `Foo*` may be
    /// registered under a different arena ID than the base method's `Foo*` if
    /// the two declarations were resolved before/after `Foo`'s body was sealed,
    /// even though they denote the same nominal pointer type.  Without this,
    /// `node.accept(this)` on a base-class pointer falls back to a static call
    /// to the base accept (which targets vtable slot 0, the no-op base
    /// `visit(BaseNode*)`; silently dropping every visitor traversal).
    vtable_slot_index(mut &this, cls: ClassType*, method_name: SymbolStr, param_types: TypeRef[]) -> i32 {
        const slots: VTableSlot[] = this.collect_vtable_slots(cls);
        const arena: TypeArena* = this.get_arena();
        const intern: InternTable* = this.get_intern();
        for (mut i: i32 = 0; i < slots.length as i32; i++) {
            if (slots[i].name.equals(method_name) &&
                param_types_equal_structural(arena, intern,
                    slots[i].param_types, param_types)) {
                return i;
            }
        }
        return -1;
    }

    /// Emit the vtable global for `cls`.  Slot layout comes from
    /// `collect_vtable_slots` (inheritance-complete, overload-aware); each
    /// slot's contents come from `find_vtable_slot_impl` (most-derived
    /// override wins, inherited base implementation otherwise).
    codegen_vtable_for_class(mut &this, cls: ClassType*) -> void {
        const intern: InternTable* = this.get_intern();

        const slots: VTableSlot[] = this.collect_vtable_slots(cls);
        if (slots.length == 0) { return; }

        mut impls: LValue[] = [];
        for (mut i: i64 = 0; i < slots.length; i++) {
            const impl: LValue = this.find_vtable_slot_impl(cls, slots[i].name, slots[i].param_types);
            if (!impl.is_valid()) {
                // If the slot's implementation isn't declared in this module,
                // skip vtable emission entirely; a half-populated vtable would
                // misdispatch.  Cross-module vtables are handled when the owning
                // module's codegen runs.
                return;
            }
            impls.push(impl);
        }

        const n: u32 = impls.length as u32;
        const fn_ptr_ty: LType = LType::pointer_to(LType::i8());
        const vtable_ty: LType = LType::array_of(fn_ptr_ty, n);

        const buf: void* = intrinsics::malloc(n as u64 * 8);
        const slot_ptrs: void** = buf as void**;
        for (mut i: u32 = 0; i < n; i++) {
            slot_ptrs[i] = llvm::LLVMConstBitCast(impls[i].raw, fn_ptr_ty.raw);
        }
        const init: LValue = LType::const_array(fn_ptr_ty, buf, n);
        intrinsics::free(buf);

        const qname: QualifiedName = QualifiedName::from_symbol(cls.qualified_name);
        const mangled: string = MangledName::for_vtable(intern, qname).resolve(intern);
        const global: LValue = this.llvm_module.add_global(vtable_ty, mangled);
        global.set_initializer(init);
        global.set_global_constant(true);
        // External linkage so cross-module `new` sites can resolve the vtable
        // symbol at link time.  Internal linkage hides the global from the
        // owning module's .o exports, leaving cross-module references unresolved.
        global.set_linkage(LLinkage::External);
    }

    /// Declare a method.  Methods get a `this` pointer as the first parameter.
    declare_method(mut &this, node: MethodNode*, target_type: SymbolStr) -> void {
        const func: FunctionDeclNode* = node.func;
        if (func == null) { return; }

        // Skip generic methods.
        if (func.generic_params.length > 0) {
            return;
        }

        const intern: InternTable* = this.get_intern();
        const type_str: string = intern.resolve(target_type);
        const method_str: string = intern.resolve(func.name);

        // Build the combined DI key.  Always compute the mangled name fresh
        // from THIS overload's parameter types; the DI cache `lookup_mangled_name`
        // only stores ONE entry per combined key, so for overloaded methods
        // (e.g., every `visit(SomeNode*)` in BaseASTVisitor) using the cached
        // name would map every overload to the first one's mangled name,
        // collide at LLVM level, and leave all but the first-declared overload
        // as unnamed declares without bodies.
        const combined: string = format("%s::%s", type_str, method_str);
        const combined_sym: SymbolStr = intern.intern(combined);
        const ctx_ptr: CompilationContext* = this.ctx;
        const di: DeclarationIndex* = ctx_ptr.decl_index;
        const arena: TypeArena* = this.get_arena();
        const type_qname: QualifiedName = QualifiedName::from_symbol(target_type);
        const recv_kind: ReceiverKind = method_receiver_kind(func, node.is_static, intern);
        const method_param_refs: TypeRef[] = method_non_receiver_params(func, intern);
        const computed: MangledName = MangledName::for_method(
            intern, arena, type_qname, func.name, recv_kind,
            method_param_refs, func.resolved_return_type, func.is_variadic);
        const mangled_sym: SymbolStr = computed.value;
        // Cache into DI only if this is the first overload; preserves the
        // existing single-slot behavior for call sites that don't disambiguate.
        if (!di.lookup_mangled_name(combined_sym).is_valid()) {
            di.register_mangled_name(combined_sym, mangled_sym);
        }
        const fn_name: string = intern.resolve(mangled_sym);

        // Build LLVM function type.  Non-static methods prepend a `this` pointer.
        const ret_ty: LType = this.map_return_type(func);
        if (!ret_ty.is_valid()) { return; }

        const is_instance: boolean = !node.is_static;

        // Detect whether the method already declares an explicit self parameter.
        // Cryo allows three forms: `&this` / `mut &this` (reference, default),
        // and `this` (by-value).  `&this` is stored in `parameters` with the
        // literal name "&this"; `this` by-value is stored with the literal name
        // "this".  In EITHER case we must NOT prepend an extra implicit `this`
        // slot; the explicit param already accounts for the self argument.
        // Only when the method has no self-param at all (e.g., some elaborated
        // methods) should we synthesize the `&this` pointer prefix.
        mut explicit_self_name: string = "";  // "", "&this", "this", or "typed-this"
        for (mut pc0: u32 = 0; pc0 < func.parameters.length as u32; pc0++) {
            const pp0: VarDeclNode* = func.parameters[pc0];
            if (pp0 == null) { continue; }
            const pn: string = intern.resolve(pp0.name);
            if (intrinsics::strcmp(pn, "&this") == 0) {
                explicit_self_name = "&this";
                break;
            }
            if (intrinsics::strcmp(pn, "this") == 0) {
                // Distinguish parser-synthesized by-value `this` (no annotation)
                // from user-written `this: Lexer*` (explicit annotation).  Both
                // count as "self" so we skip the implicit-prefix synthesis, but
                // the LLVM param type comes from different sources: bare `this`
                // uses the struct by value; typed `this` uses the annotation.
                if (pp0.type_annotation == null) {
                    explicit_self_name = "this";
                } else {
                    explicit_self_name = "typed-this";
                }
                break;
            }
        }

        // Look up the target type.  `&this` forms want `T*`; by-value `this`
        // wants the struct `T` directly.  If there's no explicit self we'll
        // synthesize `T*` as the implicit prefix.
        mut target_mapped: LType = LType::null();
        mut this_ty: LType = LType::null();
        if (is_instance) {
            mut target_ref: TypeRef = di.lookup_type(target_type);
            if (!target_ref.is_valid()) {
                // The unit type `()` isn't in the DeclarationIndex (it's a
                // primitive owned by the arena, never registered through the
                // decl-collection pass).  Fall back to the arena's canonical
                // unit TypeRef so `implement trait Drop for ()` and similar
                // get a real LLVM declaration.  Detected by the literal `()`
                // suffix on the qualified target name.
                const target_str: string = intern.resolve(target_type);
                const tlen: u64 = intrinsics::strlen(target_str);
                if (tlen >= 2 && target_str[tlen - 2] == 0x28 /* '(' */
                              && target_str[tlen - 1] == 0x29 /* ')' */) {
                    target_ref = arena.get_unit();
                }
            }
            if (target_ref.is_valid()) {
                target_mapped = this.type_mapper.map_type(target_ref);
                if (target_mapped.is_valid()) {
                    this_ty = LType::pointer_to(target_mapped);
                }
            }
            if (!this_ty.is_valid()) {
                return;
            }
        }

        const prepend_implicit_this: boolean = is_instance && intrinsics::strlen(explicit_self_name) == 0;

        // Count user parameters.  `&this` contributes a ptr slot via the
        // existing param; by-value `this` contributes a struct slot via the
        // existing param; implicit missing self is handled by prepend_implicit_this.
        // For variadic methods (`args...`), skip the trailing name-only param;
        // LLVM's `...` marker covers it.
        const fixed_user_count: u32 = fixed_param_count(func);
        mut user_param_count: u32 = 0;
        for (mut pc: u32 = 0; pc < fixed_user_count; pc++) {
            const pp: VarDeclNode* = func.parameters[pc];
            if (pp != null) { user_param_count += 1; }
        }
        const total_params: u32 = user_param_count + (if (prepend_implicit_this) { 1 } else { 0 } as u32);

        const buf: void* = intrinsics::malloc(total_params as u64 * 8);
        const slots: void** = buf as void**;

        mut idx: u32 = 0;
        if (prepend_implicit_this) {
            slots[0] = this_ty.raw;
            idx = 1;
        }

        mut params_valid: boolean = true;
        for (mut i: u32 = 0; i < fixed_user_count; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null) { continue; }
            const param_name: string = intern.resolve(param.name);

            // For `&this` and `mut &this`, force the LLVM type to `T*`;
            // parser-synthesized reference annotations may not round-trip
            // through the arena correctly for every method.
            // For by-value `this` with NO type annotation (parser-synthesized
            // self form), use the struct type directly.  But `this: Lexer*`
            // a user-written explicit annotation on a param named `this`
            // is just a regular typed parameter; map via resolved_type.
            mut mapped_param: LType = LType::null();
            if (intrinsics::strcmp(param_name, "&this") == 0 && this_ty.is_valid()) {
                mapped_param = this_ty;
            } else if (intrinsics::strcmp(param_name, "this") == 0 && target_mapped.is_valid()
                       && param.type_annotation == null) {
                mapped_param = target_mapped;
            } else {
                mapped_param = this.type_mapper.map_type(param.resolved_type);
            }
            if (!mapped_param.is_valid()) {
                params_valid = false;
                break;
            }
            slots[idx] = mapped_param.raw;
            idx += 1;
        }

        if (!params_valid) {
            intrinsics::free(buf);
            return;
        }

        const fn_type: LType = LType::function_type(ret_ty, buf, total_params, func.is_variadic);
        intrinsics::free(buf);

        const fn_val: LValue = this.llvm_module.add_function(fn_name, fn_type);

        // Register under the combined key built above.  Also register against the
        // (name, total-LLVM-arity) composite so that callers can pick the correct
        // overload at call sites (e.g., `Array::new()` vs `Array::new(u64)`).
        // `total_params` matches the arity cross-module externs register with
        // (the FunctionType's param count), keeping the two registration paths
        // interoperable.  Finally register under the unique mangled_sym; that's
        // the key `codegen_method_prologue` uses to look up the right LLVM
        // function for each overload (combined_sym alone is ambiguous because
        // overloads share the same `Type::method` form).
        this.register_function(combined_sym, fn_val);
        this.register_function_with_arity(combined_sym, total_params, fn_val);
        this.register_function(mangled_sym, fn_val);
    }

    /// Declare an intrinsic function (e.g., malloc, printf, strlen).
    /// Intrinsics use C linkage: bare name, no namespace qualification.
    declare_intrinsic(mut &this, node: IntrinsicDeclNode*) -> void {
        const intern: InternTable* = this.get_intern();
        const name_str: string = intern.resolve(node.name);

        // Map return type.
        mut ret_ty: LType = LType::void_type();
        if (node.has_resolved_return_type()) {
            ret_ty = this.type_mapper.map_type(node.resolved_return_type);
            if (!ret_ty.is_valid()) { return; }
        }

        const param_count: u32 = fixed_param_count_intrinsic(node);
        mut fn_type: LType = LType::null();

        if (param_count == 0) {
            fn_type = LType::function_type(ret_ty, null, 0, node.is_variadic);
        } else {
            const buf: void* = intrinsics::malloc(param_count as u64 * 8);
            const slots: void** = buf as void**;
            mut all_valid: boolean = true;
            for (mut i: u32 = 0; i < param_count; i++) {
                const param: VarDeclNode* = node.parameters[i];
                const param_ty: LType = this.type_mapper.map_type(param.resolved_type);
                if (!param_ty.is_valid()) {
                    all_valid = false;
                    break;
                }
                slots[i] = param_ty.raw;
            }
            if (!all_valid) {
                intrinsics::free(buf);
                return;
            }
            fn_type = LType::function_type(ret_ty, buf, param_count, node.is_variadic);
            intrinsics::free(buf);
        }

        // C linkage: use bare name.
        const fn_val: LValue = this.llvm_module.add_function(name_str, fn_type);

        // Register under bare name (for identifier lookups like `malloc(...)`)
        this.register_function(node.name, fn_val);

        // Also register under qualified name (for cross-module resolution).
        const ctx_ptr: CompilationContext* = this.ctx;
        const qualified: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
        if (!qualified.equals(node.name)) {
            this.register_function(qualified, fn_val);
        }
    }

    /// Declare extern block functions.
    declare_extern_block(mut &this, node: ExternBlockNode*) -> void {
        // Get intern table from CompilationContext to avoid CodegenContext offset issues.
        const ctx_ptr: CompilationContext* = this.ctx;
        const intern: InternTable* = ctx_ptr.intern_table;

        for (mut i: i64 = 0; i < node.functions.length; i++) {
            const func: FunctionDeclNode* = node.functions[i];
            if (func == null) { continue; }

            const name_str: string = intern.resolve(func.name);

            // Extern functions use their bare name (C linkage).
            const ret_ty: LType = this.map_return_type(func);
            if (!ret_ty.is_valid()) {
                this.emit_warning_at_span(ErrorCode::E0643_RETURN_TYPE_ERROR,
                    format("codegen: extern function '%s': failed to map return type", name_str),
                    func.span);
                continue;
            }
            const param_count: u32 = fixed_param_count(func);

            mut fn_type: LType = LType::null();
            if (param_count == 0) {
                fn_type = LType::function_type(ret_ty, null, 0, func.is_variadic);
            } else {
                const buf: void* = intrinsics::malloc(param_count as u64 * 8);
                const slots: void** = buf as void**;
                mut params_ok: boolean = true;
                for (mut j: u32 = 0; j < param_count; j++) {
                    const param: VarDeclNode* = func.parameters[j];
                    const mapped_ep: LType = this.type_mapper.map_type(param.resolved_type);
                    if (!mapped_ep.is_valid()) {
                        this.emit_warning_at_span(ErrorCode::E0642_PARAM_TYPE_ERROR,
                            format("codegen: extern function '%s': failed to map parameter %d type", name_str, j as i32),
                            param.span);
                        params_ok = false;
                        break;
                    }
                    slots[j] = mapped_ep.raw;
                }
                if (!params_ok) {
                    intrinsics::free(buf);
                    continue;
                }
                fn_type = LType::function_type(ret_ty, buf, param_count, func.is_variadic);
                intrinsics::free(buf);
            }

            // Use bare name for C linkage.
            const fn_val: LValue = this.llvm_module.add_function(name_str, fn_type);
            this.register_function(func.name, fn_val);
        }
    }

    /// Generate IR for all function bodies in the program.
    /// `visit_fn` is a callback that generates the body using the visitor.
    generate_bodies(mut &this, program: ProgramNode*, visit_fn: void*) -> void {
        const stmts: ASTNode*[] = program.statements;
        for (mut i: i64 = 0; i < stmts.length; i++) {
            const stmt: ASTNode* = stmts[i];
            if (stmt == null) { continue; }

            const kind: NodeKind = stmt.kind;

            if (kind == NodeKind::FunctionDeclaration) {
                const func: FunctionDeclNode* = stmt as FunctionDeclNode*;
                if (func.generic_params.length > 0) { continue; }
                if (func.body == null) { continue; }
                // Body generation happens through the visitor.
            } else if (kind == NodeKind::VariableDeclaration) {
                const var_decl: VarDeclNode* = stmt as VarDeclNode*;
                if (var_decl.is_global) {
                    this.codegen_global_var(var_decl);
                }
            }
        }
    }

    /// Generate a global variable declaration with optional initializer.
    codegen_global_var(mut &this, node: VarDeclNode*) -> void {
        // Mangle definitions under the current module's namespace
        // (`C$<namespace>.<name>`) so two modules with the same private
        // `const NAME = ...` don't collide at link time.  Cross-module readers
        // pull the same namespace out of `DeclarationIndex::get_global_namespace`.
        const mangled: string = MangledName::for_global(
            this.get_intern(), this.ctx.namespace_str, node.name).resolve(this.get_intern());

        const ty: LType = this.type_mapper.map_type(node.resolved_type);
        if (!ty.is_valid()) {
            return;
        }

        const global: LValue = this.llvm_module.add_global(ty, mangled);

        // Initializer: if the source declaration has a literal initializer
        // (e.g., `const BUCKET_OCCUPIED: u8 = 1`), emit it as the constant
        // initializer typed against the global's own type so consumers see
        // the right value.  LLVM globals require a constant initializer, so
        // anything more complex than a literal falls back to zeroinitializer
        // (more involved cases would need a runtime ctor, out of scope here).
        mut init: LValue = LValue::null();
        // Peel one layer of cast so initializers like
        // `const HEX_LOWER: u8* = "0123456789abcdef"` route to the
        // string-literal branch below.  Without this, the cast wraps the
        // literal and the global lands on the `null` fallback at the bottom
        // of this function, leaving HEX_LOWER null at runtime, which
        // segfaults the moment a downstream consumer indexes it.
        mut init_expr: ExpressionNode* = node.initializer;
        if (init_expr != null && init_expr.kind == NodeKind::CastExpression) {
            const ce: CastExprNode* = init_expr as CastExprNode*;
            if (ce.expression != null && ce.expression.kind == NodeKind::Literal) {
                init_expr = ce.expression;
            }
        }
        if (init_expr != null && init_expr.kind == NodeKind::Literal) {
            const lit: LiteralNode* = init_expr as LiteralNode*;
            const tk: LTypeKind = type_kind_of(ty.raw);
            if (lit.literal_kind == LiteralKind::Integer && tk == LTypeKind::Integer) {
                const ival: u64 = parse_int_lexeme(lit.value);
                init = LType::const_int(ty, ival, true);
            } else if (lit.literal_kind == LiteralKind::Boolean && tk == LTypeKind::Integer) {
                const bval: u64 = if (lit.value == "true") { 1 } else { 0 };
                init = LType::const_int(ty, bval, false);
            } else if (lit.literal_kind == LiteralKind::Float
                       && (tk == LTypeKind::Float || tk == LTypeKind::Double)) {
                mut fval: f64 = 0.0;
                intrinsics::sscanf(lit.value, "%lf", &fval);
                init = LType::const_real(ty, fval);
            } else if (lit.literal_kind == LiteralKind::Null && tk == LTypeKind::Pointer) {
                init = LType::const_pointer_null(ty);
            } else if (lit.literal_kind == LiteralKind::String && tk == LTypeKind::Pointer) {
                // String literal global: store the address of the interned
                // string global as the initializer.  Without this, every
                // `const SOME_TEXT: string = "..."` emits as `null`, which
                // surfaces as literal "(null)" in any printf/format output
                // that consumes the constant.
                init = this.get_or_create_string_literal(lit.value);
            }
        }
        if (!init.is_valid()) {
            init = LType::const_null(ty);
        }
        global.set_initializer(init);

        if (!node.is_mutable) {
            global.set_global_constant(true);
        }

        this.register_global(node.name, global);
    }

    /// Generate the body of a function.  Called from the IRGeneratorVisitor.
    ///
    /// 1. Look up the LLVM function
    /// 2. Create entry basic block
    /// 3. Create allocas for parameters and store incoming values
    /// 4. Push scope, bind parameter names
    /// 5. The visitor will visit the body (BlockStmtNode)
    /// 6. Handle implicit return for void functions
    codegen_function_prologue(mut &this, node: FunctionDeclNode*) -> LValue {
        const ctx_ptr: CompilationContext* = this.ctx;
        const intern: InternTable* = ctx_ptr.intern_table;
        const qualified: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
        const di: DeclarationIndex* = ctx_ptr.decl_index;
        const arena: TypeArena* = this.get_arena();

        // Body emission must attach to the LLVM function for THIS exact
        // overload, not whichever one was registered last under the bare
        // qualified-name cache.  Build the same func_type_ref declare_function
        // used to derive the mangled name, then fetch by name from the LLVM
        // module directly.  Falls back to the bare cache for non-overloaded
        // functions (no overload-keyed entry registered).
        mut params: TypeRef[] = [];
        for (mut pi: i64 = 0; pi < node.parameters.length; pi++) {
            const param: VarDeclNode* = node.parameters[pi];
            if (param != null && param.resolved_type.is_valid()) {
                params.push(param.resolved_type);
            }
        }
        const func_type_ref: TypeRef = arena.get_function(
            node.resolved_return_type, params, node.is_variadic);
        const overload_mangled: SymbolStr = di.lookup_overload_mangled(qualified, func_type_ref);

        mut fn_val: LValue = LValue::null();
        if (overload_mangled.is_valid()) {
            // `main` is special-cased to keep its unmangled C ABI symbol;
            // mirror declare_function's override so we look up "main" not
            // the mangled form.
            const main_sym: SymbolStr = intern.intern("main");
            mut ir_name: string = intern.resolve(overload_mangled);
            if (node.name.equals(main_sym)) {
                ir_name = "main";
            }
            fn_val = this.llvm_module.get_named_function(ir_name);
        }
        if (!fn_val.is_valid()) {
            fn_val = this.resolve_function(qualified);
        }
        if (!fn_val.is_valid()) {
            // The prior FunctionDeclaration pass should have produced a
            // declare for this function. When it didn't, the body simply
            // can't land; emit a warning rather than an error because
            // the upstream gap is the real bug to fix, and a warning lets
            // the build continue so downstream code can be exercised.
            const fname: string = this.resolve(node.name);
            this.emit_warning_at_span(ErrorCode::E0606_FUNCTION_GENERATION_ERROR,
                format("codegen: function '%s' has no LLVM declaration in this module; body skipped (the prior FunctionDeclaration pass should have produced one). Calls to this function will fail at link time.", fname),
                node.span);
            return LValue::null();
        }

        // Create entry basic block.
        const entry_bb: LBasicBlock = LBasicBlock::append(fn_val, "entry");
        this.builder.position_at_end(entry_bb);

        // Create allocas for each parameter and store the incoming value.
        this.push_scope();

        const fixed_count: u32 = fixed_param_count(node);
        for (mut i: u32 = 0; i < fixed_count; i++) {
            const param: VarDeclNode* = node.parameters[i];
            const param_name: string = this.resolve(param.name);
            const param_ty: LType = this.type_mapper.map_type(param.resolved_type);

            if (!param_ty.is_valid()) {
                const fname: string = this.resolve(node.name);
                this.emit_warning_at_span(ErrorCode::E0642_PARAM_TYPE_ERROR,
                    format("codegen: function '%s', parameter '%s': could not lower its type to LLVM; body skipped. Calls to this function will fail at link time.",
                        fname, param_name),
                    if (param != null) { param.span } else { node.span });
                this.pop_scope();
                return LValue::null();
            }

            const alloca: LValue = this.create_entry_alloca(fn_val, param_name, param_ty);
            const arg: LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, i) };
            this.builder.build_store(arg, alloca);
            this.set_named_value(param.name, alloca);
        }

        // For variadic functions with an `args...` bucket, set up a va_list
        // so the body can forward varargs to other variadic intrinsics via
        // a v* variant (vsprintf, vfprintf, etc.).  Without this the `args`
        // identifier has no LLVM value and every forwarding call codegens
        // with a null operand.
        this.emit_va_start_for_variadic(fn_val, variadic_param_name(node));

        // Program-main prologue: publish argc/argv to the standard library
        // before the user's body runs, so `std::env::args()` returns the
        // real argv instead of an empty slice.  `declare_function` widened
        // main's LLVM signature to `i32 (i32, ptr)`; the user's source has
        // no parameters, so we read the synthetic params via LLVMGetParam
        // and forward them through the regular function-resolution path.
        const intern: InternTable* = this.get_intern();
        const main_sym: SymbolStr = intern.intern("main");
        if (node.name.equals(main_sym) && fixed_param_count(node) == 0) {
            this.emit_set_args_call(fn_val);
        }

        return fn_val;
    }

    /// Emit `std::env::set_args(argc, argv)` at the entry of the program's
    /// main function.  Looks the function up by qualified name so the
    /// mangled symbol is whatever `MangledName::for_free_function` decides
    /// No hardcoded mangle.  Silent no-op if the stdlib (or `set_args`
    /// specifically) isn't available, which keeps `--no-std` builds and
    /// freestanding mains compiling.
    emit_set_args_call(mut &this, main_fn: LValue) -> void {
        const intern: InternTable* = this.get_intern();
        const set_args_sym: SymbolStr = intern.intern("std::env::set_args");
        const set_args_fn: LValue = this.resolve_function(set_args_sym);
        if (!set_args_fn.is_valid()) { return; }

        const set_args_ty: LType = LType {
            raw: llvm::LLVMGlobalGetValueType(set_args_fn.raw),
        };
        if (!set_args_ty.is_valid()) { return; }

        const argc: LValue = LValue { raw: llvm::LLVMGetParam(main_fn.raw, 0) };
        const argv: LValue = LValue { raw: llvm::LLVMGetParam(main_fn.raw, 1) };

        mut args: Pair<LValue, TypeRef>[] = [];
        args.push(Pair<LValue, TypeRef>::new(argc, TypeRef::invalid()));
        args.push(Pair<LValue, TypeRef>::new(argv, TypeRef::invalid()));
        mut result: LValue = LValue::null();
        result = this.codegen_call(set_args_fn, set_args_ty, args, "");
    }

    /// Emit implicit void return ONLY for void/unit functions.
    /// Non-void functions must have explicit returns from the source code.
    /// If a non-void function's block has no terminator, body generation
    /// failed; the caller will strip it back to a declare.
    codegen_function_epilogue(mut &this, node: FunctionDeclNode*) -> void {
        const current_bb: LBasicBlock = this.builder.get_insert_block();
        if (current_bb.is_valid() && !current_bb.has_terminator()) {
            const ret_ty: TypeRef = node.resolved_return_type;
            mut is_void: boolean = ret_ty.is_invalid();
            if (!is_void) {
                const t: Type* = this.lookup_type_by_id(ret_ty.id);
                is_void = t != null && (t.kind == TypeKind::Void || t.kind == TypeKind::Unit);
            }
            if (is_void) {
                this.emit_va_end_if_variadic(variadic_param_name(node));
                this.builder.build_ret_void();
            }
            // Non-void: intentionally leave unterminated. The caller
            // detects this and strips the function body.
        }

        // Sweep orphaned blocks that body codegen left empty + unterminated.
        // The classic source is the merge block of an infinite `loop { ... }`
        // (no `break`, so nothing branches into `loop.end`); the same shape
        // appears for any control-flow scaffolding that creates a join block
        // that ends up unused.  Without this fixup the function-body
        // validator strips the WHOLE body to a declare, producing silent
        // link-time `undefined reference` errors.  An empty block has no
        // semantic meaning; terminating it with `unreachable` is a no-op
        // for any reachable path and keeps LLVM happy.
        const fn_val: LValue = this.builder.get_insert_block().get_parent();
        if (fn_val.is_valid()) {
            mut bb: void* = llvm::LLVMGetFirstBasicBlock(fn_val.raw);
            while (bb != null) {
                const lbb: LBasicBlock = LBasicBlock { raw: bb };
                if (!lbb.has_terminator()
                        && llvm::LLVMGetFirstInstruction(bb) == null) {
                    this.builder.position_at_end(lbb);
                    this.builder.build_unreachable();
                }
                bb = llvm::LLVMGetNextBasicBlock(bb);
            }
        }

        this.pop_scope();
    }

    /// Generate function prologue for a method.  Prepends `this` parameter binding.
    codegen_method_prologue(mut &this, node: MethodNode*, target_type: SymbolStr) -> LValue {
        const func: FunctionDeclNode* = node.func;
        if (func == null) { return LValue::null(); }

        const intern: InternTable* = this.get_intern();
        const type_str: string = intern.resolve(target_type);
        const method_str: string = intern.resolve(func.name);
        const combined: string = format("%s::%s", type_str, method_str);
        const combined_sym: SymbolStr = intern.intern(combined);

        // Recompute the mangled name from THIS overload's parameter types so
        // overloaded methods (e.g., BaseASTVisitor's 62 `visit(...)` overrides)
        // resolve to their own LLVM function rather than all mapping to the
        // first-declared overload via the ambiguous combined key.  Must mirror
        // the computation in `declare_method` exactly.
        const arena: TypeArena* = this.get_arena();
        const type_qname: QualifiedName = QualifiedName::from_symbol(target_type);
        const recv_kind: ReceiverKind = method_receiver_kind(func, node.is_static, intern);
        const method_param_refs: TypeRef[] = method_non_receiver_params(func, intern);
        const computed: MangledName = MangledName::for_method(
            intern, arena, type_qname, func.name, recv_kind,
            method_param_refs, func.resolved_return_type, func.is_variadic);
        const mangled_sym: SymbolStr = computed.value;

        // Prefer mangled_sym for overload-correct lookup; fall back to the
        // combined key for paths that only registered the non-overloaded form.
        mut fn_val: LValue = this.resolve_function(mangled_sym);
        if (!fn_val.is_valid()) {
            fn_val = this.resolve_function(combined_sym);
        }
        if (!fn_val.is_valid()) {
            // declare_method should have produced an LLVM declare for this
            // method.  When it didn't (e.g. cross-module trait impls whose
            // target lookup misses, or primitive impls whose target qualify
            // resolves to a name DI doesn't know), the body simply can't
            // land.  Emit a warning rather than an error so the build
            // continues; calls to this method will surface as undefined
            // references at link time, which is the correct visibility
            // outcome until the upstream declare path is fixed.
            this.emit_warning_at_span(ErrorCode::E0619_METHOD_GENERATION_ERROR,
                format("codegen: method '%s::%s' has no LLVM declaration in this module; body skipped (declare_method should have produced one). Calls to this method will fail at link time.",
                    type_str, method_str),
                func.span);
            return LValue::null();
        }

        const entry_bb: LBasicBlock = LBasicBlock::append(fn_val, "entry");
        this.builder.position_at_end(entry_bb);

        this.push_scope();

        // Detect which of the three self forms (if any) this method uses.
        //   `&this` / `mut &this`: param named "&this", semantically a T*
        //   `this`               : param named "this", semantically a by-value T
        //   (none)               : implicit `&this`; `declare_method` synthesized
        //                           a leading T* in the LLVM function signature
        // The LLVM parameter layout depends on which case we're in; matches the
        // logic in declare_method so named_values and LLVM params line up.
        mut explicit_ref_idx: i64 = -1;    // parameters[i] is "&this"
        mut explicit_val_idx: i64 = -1;    // parameters[i] is bare "this" (by-value self)
        mut explicit_typed_idx: i64 = -1;  // parameters[i] is "this: T*" (user-typed self)
        for (mut pc: i64 = 0; pc < func.parameters.length; pc++) {
            const pp: VarDeclNode* = func.parameters[pc];
            if (pp == null) { continue; }
            const pn: string = this.resolve(pp.name);
            if (intrinsics::strcmp(pn, "&this") == 0) { explicit_ref_idx = pc; break; }
            if (intrinsics::strcmp(pn, "this") == 0) {
                if (pp.type_annotation == null) {
                    explicit_val_idx = pc;
                } else {
                    // `this: T*`: user wrote the type out, method takes
                    // `this` as a regular typed parameter (e.g. Lexer's
                    // helper methods that use this convention).
                    explicit_typed_idx = pc;
                }
                break;
            }
        }

        mut param_idx: u32 = 0;

        // Bind `this` for instance methods.  All three forms produce a `this`
        // named-value that's a pointer to the struct; for by-value `this` we
        // alloca+store the struct so member-access GEPs work the same way.
        if (!node.is_static) {
            const qualified_target: SymbolStr = this.ctx.qualify_symbol_sym(target_type);
            mut target_ref: TypeRef = this.ctx.decl_index.lookup_type(qualified_target);
            if (target_ref.is_invalid()) {
                target_ref = this.ctx.decl_index.lookup_type(target_type);
            }
            if (target_ref.is_invalid()) {
                // Unit-target impls (`implement trait Drop for ()`):
                // unit type lives in the arena, not the DeclarationIndex.
                // Detected by the literal `()` suffix on the qualified target
                // name; mirrors the fallback in declare_method.
                const target_str: string = this.resolve(target_type);
                const tlen: u64 = intrinsics::strlen(target_str);
                if (tlen >= 2 && target_str[tlen - 2] == 0x28 /* '(' */
                              && target_str[tlen - 1] == 0x29 /* ')' */) {
                    target_ref = this.get_arena().get_unit();
                }
            }
            if (target_ref.is_invalid()) {
                const ts: string = this.resolve(target_type);
                const ms: string = this.resolve(func.name);
                this.emit_error_at_span(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    format("codegen: method '%s::%s': target type '%s' not found in declaration index", ts, ms, ts),
                    func.span);
                this.pop_scope();
                return LValue::null();
            }

            const this_sym: SymbolStr = this.intern_str("this");
            const arg0: LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, 0) };

            if (explicit_val_idx >= 0) {
                // By-value `this`: LLVM param 0 is a struct value.  Alloca it so
                // downstream code (member access, method calls) can treat `this`
                // as a pointer uniformly.
                const target_mapped: LType = this.type_mapper.map_type(target_ref);
                if (!target_mapped.is_valid()) {
                    this.emit_warning_at_span(ErrorCode::E0609_TYPE_MAPPING_ERROR,
                        format("codegen: method '%s::%s': could not lower the by-value `this` type to LLVM; body skipped. Calls to this method will fail at link time.",
                            type_str, method_str),
                        func.span);
                    this.pop_scope();
                    return LValue::null();
                }
                const slot: LValue = this.create_entry_alloca(fn_val, "this", target_mapped);
                this.builder.build_store(arg0, slot);
                this.set_named_value(this_sym, slot);
            } else if (explicit_typed_idx >= 0) {
                // User-typed `this: T*`: LLVM param 0 is whatever the
                // annotation resolves to (typically a ptr).  Bind `this`
                // directly to that value, same as the `&this` path.
                this.set_named_value(this_sym, arg0);
            } else {
                // `&this` (explicit or implicit): LLVM param 0 is already a ptr.
                // Store the raw pointer directly in named_values (no alloca).
                this.set_named_value(this_sym, arg0);
            }

            param_idx = 1;
        }

        // Bind the remaining user parameters.  Skip whichever self form this
        // method uses (we already handled it above).  Cap iteration at the
        // fixed-param count so a trailing `args...` bucket doesn't try to pull
        // an LLVM param that doesn't exist.
        const fixed_count: u32 = fixed_param_count(func);
        for (mut i: u32 = 0; i < fixed_count; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null) { continue; }
            if (i as i64 == explicit_ref_idx) { continue; }
            if (i as i64 == explicit_val_idx) { continue; }
            if (i as i64 == explicit_typed_idx) { continue; }

            const param_name: string = this.resolve(param.name);
            const param_ty: LType = this.type_mapper.map_type(param.resolved_type);
            if (!param_ty.is_valid()) {
                this.emit_warning_at_span(ErrorCode::E0642_PARAM_TYPE_ERROR,
                    format("codegen: method '%s::%s', parameter '%s': could not lower its type to LLVM; body skipped. Calls to this method will fail at link time.",
                        type_str, method_str, param_name),
                    if (param != null) { param.span } else { func.span });
                this.pop_scope();
                return LValue::null();
            }

            const alloca: LValue = this.create_entry_alloca(fn_val, param_name, param_ty);
            const arg: LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, param_idx) };
            this.builder.build_store(arg, alloca);
            this.set_named_value(param.name, alloca);
            param_idx += 1;
        }

        return fn_val;
    }

    /// Map a function's return type to an LLVMType.
    map_return_type(mut &this, node: FunctionDeclNode*) -> LType {
        if (node.resolved_return_type.is_invalid()) {
            return LType::void_type();
        }

        const t: Type* = this.lookup_type_by_id(node.resolved_return_type.id);
        if (t == null || t.kind == TypeKind::Void || t.kind == TypeKind::Unit) {
            return LType::void_type();
        }

        return this.type_mapper.map_type(node.resolved_return_type);
    }

    // ========================================================================
    // Intrinsics codegen.  Inline-lowers calls to compiler-recognized
    // intrinsics (ptr arithmetic, sext/zext, rotates, abort, panic, ...
    // dispatched by name through `try_emit_intrinsic_call`).
    // ========================================================================

    auto_deref_to(mut &this, val: LValue, expected: LType) -> LValue {
        if (!val.is_valid() || !expected.is_valid()) { return val; }
        const actual_ty: void* = llvm::LLVMTypeOf(val.raw);
        if (actual_ty == null) { return val; }
        if (type_kind_of(actual_ty) == LTypeKind::Pointer) {
            return this.builder.build_load(expected, val, "deref");
        }
        return val;
    }

    get_or_decl_unary_intrinsic(mut &this, name: string, ty: LType) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function(name);
        if (fn.is_valid()) { return fn; }
        const param_buf: void* = intrinsics::malloc(8);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 1, false);
        intrinsics::free(param_buf);
        return this.llvm_module.add_function(name, fn_ty);
    }

    get_or_decl_ctlz_cttz(mut &this, name: string, ty: LType) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function(name);
        if (fn.is_valid()) { return fn; }
        const param_buf: void* = intrinsics::malloc(16);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        param_slots[1] = LType::i1().raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 2, false);
        intrinsics::free(param_buf);
        return this.llvm_module.add_function(name, fn_ty);
    }

    get_or_decl_funnel_shift(mut &this, name: string, ty: LType) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function(name);
        if (fn.is_valid()) { return fn; }
        const param_buf: void* = intrinsics::malloc(24);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        param_slots[1] = ty.raw;
        param_slots[2] = ty.raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 3, false);
        intrinsics::free(param_buf);
        return this.llvm_module.add_function(name, fn_ty);
    }

    call1(mut &this, fn: LValue, fn_ty: LType, a: LValue, name: string) -> LValue {
        const buf: void* = intrinsics::malloc(8);
        const slots: void** = buf as void**;
        slots[0] = a.raw;
        const r: LValue = this.builder.build_call(fn_ty, fn, buf, 1, name);
        intrinsics::free(buf);
        return r;
    }

    call2(mut &this, fn: LValue, fn_ty: LType, a: LValue, b: LValue, name: string) -> LValue {
        const buf: void* = intrinsics::malloc(16);
        const slots: void** = buf as void**;
        slots[0] = a.raw;
        slots[1] = b.raw;
        const r: LValue = this.builder.build_call(fn_ty, fn, buf, 2, name);
        intrinsics::free(buf);
        return r;
    }

    call3(mut &this, fn: LValue, fn_ty: LType, a: LValue, b: LValue, c: LValue, name: string) -> LValue {
        const buf: void* = intrinsics::malloc(24);
        const slots: void** = buf as void**;
        slots[0] = a.raw;
        slots[1] = b.raw;
        slots[2] = c.raw;
        const r: LValue = this.builder.build_call(fn_ty, fn, buf, 3, name);
        intrinsics::free(buf);
        return r;
    }

    emit_ptr_offset(mut &this, base: LValue, off: LValue, label: string) -> LValue {
        const idx_buf: void* = intrinsics::malloc(8);
        const idx_slots: void** = idx_buf as void**;
        idx_slots[0] = off.raw;
        const r: LValue = this.builder.build_gep(LType::i8(), base, idx_buf, 1, label);
        intrinsics::free(idx_buf);
        return r;
    }

    emit_ptr_diff(mut &this, a: LValue, b: LValue) -> LValue {
        const i64_ty: LType = LType::i64();
        const ai: LValue = this.builder.build_ptr_to_int(a, i64_ty, "p.a");
        const bi: LValue = this.builder.build_ptr_to_int(b, i64_ty, "p.b");
        return this.builder.build_sub(ai, bi, "ptr.diff");
    }

    emit_unary_llvm(mut &this, iname: string, ty: LType, x: LValue, narrow_to_i32: boolean, label: string) -> LValue {
        const fn: LValue = this.get_or_decl_unary_intrinsic(iname, ty);
        if (!fn.is_valid()) { return LValue::null(); }
        const param_buf: void* = intrinsics::malloc(8);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 1, false);
        intrinsics::free(param_buf);
        const raw: LValue = this.call1(fn, fn_ty, x, label);
        if (narrow_to_i32 && llvm::LLVMGetIntTypeWidth(ty.raw) != 32) {
            return this.builder.build_trunc(raw, LType::i32(), "narrow.i32");
        }
        return raw;
    }

    emit_clz_or_ctz(mut &this, iname: string, ty: LType, x: LValue) -> LValue {
        const fn: LValue = this.get_or_decl_ctlz_cttz(iname, ty);
        if (!fn.is_valid()) { return LValue::null(); }
        const param_buf: void* = intrinsics::malloc(16);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        param_slots[1] = LType::i1().raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 2, false);
        intrinsics::free(param_buf);
        // is_zero_undef = false: zero input returns the bit width.
        const flag: LValue = LType::const_int(LType::i1(), 0, false);
        const raw: LValue = this.call2(fn, fn_ty, x, flag, "clztmp");
        if (llvm::LLVMGetIntTypeWidth(ty.raw) != 32) {
            return this.builder.build_trunc(raw, LType::i32(), "narrow.i32");
        }
        return raw;
    }

    emit_rotate(mut &this, iname: string, ty: LType, x: LValue, n: LValue) -> LValue {
        const fn: LValue = this.get_or_decl_funnel_shift(iname, ty);
        if (!fn.is_valid()) { return LValue::null(); }
        const param_buf: void* = intrinsics::malloc(24);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        param_slots[1] = ty.raw;
        param_slots[2] = ty.raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 3, false);
        intrinsics::free(param_buf);
        // Rotate signature is `(value, n: u32)`; funnel-shift wants the
        // shift amount in the same width as the value.  For 64-bit rotates,
        // widen the i32 shift count to i64.  Note: `void*` equality is
        // currently broken (always true), so we compare integer widths via
        // LLVMGetIntTypeWidth instead of `ty.raw == ...raw`.
        mut shift: LValue = n;
        const target_width: u32 = llvm::LLVMGetIntTypeWidth(ty.raw);
        if (target_width == 64) {
            shift = this.builder.build_zext(shift, LType::i64(), "rot.shift.zext");
        }
        return this.call3(fn, fn_ty, x, x, shift, "rot");
    }

    /// Inline-lower a bare-name function call to LLVM IR.  Returns true if
    /// `name` matches a known intrinsic and *out_value was set; false if
    /// the call should fall through to the normal function-resolution path.
    try_emit_intrinsic_call(mut &this, name: string, args: LValue[]) -> Option<LValue> {
        const kind: IntrinsicKind = lookup_intrinsic_kind(name);

        // Argument-count checks: every recognized intrinsic has a fixed
        // arity, so this is a single guard.
        const expected: i64 = match (kind) {
            IntrinsicKind::NotIntrinsic => { -1 }
            IntrinsicKind::PtrAdd       => { 2 }
            IntrinsicKind::PtrSub       => { 2 }
            IntrinsicKind::PtrDiff      => { 2 }
            IntrinsicKind::Rotl32       => { 2 }
            IntrinsicKind::Rotl64       => { 2 }
            IntrinsicKind::Rotr32       => { 2 }
            IntrinsicKind::Rotr64       => { 2 }
            // panic(message: string, file: string, line: u32)
            IntrinsicKind::Panic        => { 3 }
            // atomic_fence(order: i32): single arg.  isfinite, dirent_*
            // also single arg, so they fall through to the default below.
            _                           => { 1 }
        };
        if (expected < 0)            { return Option::None; }
        if (args.length != expected) { return Option::None; }

        // Auto-deref pointer args for value-arg intrinsics: handles the
        // pervasive `intrinsic(&this)` pattern in stdlib's primitives.cryo.
        // No-op for the pointer-arg intrinsics (PtrAdd/PtrSub/PtrDiff) since
        // intrinsic_src_type returns null for those.
        const src_ty: LType = intrinsic_src_type(kind);
        mut a0: LValue = args[0];
        if (src_ty.is_valid()) {
            a0 = this.auto_deref_to(a0, src_ty);
        }
        // Second argument (rotate count) is i32; auto-deref if pointer.
        mut a1: LValue = if (args.length >= 2) { args[1] } else { LValue::null() };
        const is_rotate: boolean = match (kind) {
            IntrinsicKind::Rotl32 => { true }
            IntrinsicKind::Rotl64 => { true }
            IntrinsicKind::Rotr32 => { true }
            IntrinsicKind::Rotr64 => { true }
            _                     => { false }
        };
        if (is_rotate && a1.is_valid()) {
            a1 = this.auto_deref_to(a1, LType::i32());
        }

        mut out_value: LValue = match (kind) {
            IntrinsicKind::NotIntrinsic => { LValue::null() }   // unreachable

            // -- Pointer arithmetic (no auto-deref of args[0]; these
            //    intentionally accept and produce pointers). --
            IntrinsicKind::PtrAdd  => { this.emit_ptr_offset(args[0], args[1], "ptr.add") }
            IntrinsicKind::PtrSub  => {
                const negged: LValue = this.builder.build_neg(args[1], "ptr.off.neg");
                this.emit_ptr_offset(args[0], negged, "ptr.sub")
            }
            IntrinsicKind::PtrDiff => { this.emit_ptr_diff(args[0], args[1]) }

            // -- Signed widening (sext) --
            IntrinsicKind::SExt8To16   => { this.builder.build_sext(a0, LType::i16(), "sext") }
            IntrinsicKind::SExt8To32   => { this.builder.build_sext(a0, LType::i32(), "sext") }
            IntrinsicKind::SExt8To64   => { this.builder.build_sext(a0, LType::i64(), "sext") }
            IntrinsicKind::SExt16To32  => { this.builder.build_sext(a0, LType::i32(), "sext") }
            IntrinsicKind::SExt16To64  => { this.builder.build_sext(a0, LType::i64(), "sext") }
            IntrinsicKind::SExt32To64  => { this.builder.build_sext(a0, LType::i64(), "sext") }

            // -- Signed narrowing (trunc) --
            IntrinsicKind::Trunc64To32 => { this.builder.build_trunc(a0, LType::i32(), "trunc") }
            IntrinsicKind::Trunc64To16 => { this.builder.build_trunc(a0, LType::i16(), "trunc") }
            IntrinsicKind::Trunc64To8  => { this.builder.build_trunc(a0, LType::i8(),  "trunc") }
            IntrinsicKind::Trunc32To16 => { this.builder.build_trunc(a0, LType::i16(), "trunc") }
            IntrinsicKind::Trunc32To8  => { this.builder.build_trunc(a0, LType::i8(),  "trunc") }
            IntrinsicKind::Trunc16To8  => { this.builder.build_trunc(a0, LType::i8(),  "trunc") }

            // -- Unsigned widening (zext) --
            IntrinsicKind::ZExt8To16   => { this.builder.build_zext(a0, LType::i16(), "zext") }
            IntrinsicKind::ZExt8To32   => { this.builder.build_zext(a0, LType::i32(), "zext") }
            IntrinsicKind::ZExt8To64   => { this.builder.build_zext(a0, LType::i64(), "zext") }
            IntrinsicKind::ZExt16To32  => { this.builder.build_zext(a0, LType::i32(), "zext") }
            IntrinsicKind::ZExt16To64  => { this.builder.build_zext(a0, LType::i64(), "zext") }
            IntrinsicKind::ZExt32To64  => { this.builder.build_zext(a0, LType::i64(), "zext") }

            // -- Unsigned narrowing (trunc; LLVM doesn't distinguish signed
            //    from unsigned at the type level, so this emits the same
            //    instruction as the signed variants above) --
            IntrinsicKind::UTrunc64To32 => { this.builder.build_trunc(a0, LType::i32(), "trunc") }
            IntrinsicKind::UTrunc64To16 => { this.builder.build_trunc(a0, LType::i16(), "trunc") }
            IntrinsicKind::UTrunc64To8  => { this.builder.build_trunc(a0, LType::i8(),  "trunc") }
            IntrinsicKind::UTrunc32To16 => { this.builder.build_trunc(a0, LType::i16(), "trunc") }
            IntrinsicKind::UTrunc32To8  => { this.builder.build_trunc(a0, LType::i8(),  "trunc") }
            IntrinsicKind::UTrunc16To8  => { this.builder.build_trunc(a0, LType::i8(),  "trunc") }

            // -- Same-width sign conversions (no-op) --
            IntrinsicKind::SignBitcast8  => { a0 }
            IntrinsicKind::SignBitcast32 => { a0 }
            IntrinsicKind::SignBitcast64 => { a0 }

            // -- Float widening / narrowing --
            IntrinsicKind::FpExt32To64   => { this.builder.build_fp_ext(a0, LType::f64(), "fpext") }
            IntrinsicKind::FpTrunc64To32 => { this.builder.build_fp_trunc(a0, LType::f32(), "fptrunc") }

            // -- Signed int → float --
            IntrinsicKind::SiToF32         => { this.builder.build_si_to_fp(a0, LType::f32(), "sitofp") }
            IntrinsicKind::SiToF64Fromi32  => { this.builder.build_si_to_fp(a0, LType::f64(), "sitofp") }
            IntrinsicKind::SiToF64Fromi64  => { this.builder.build_si_to_fp(a0, LType::f64(), "sitofp") }

            // -- Unsigned int → float --
            IntrinsicKind::UiToF32         => { this.builder.build_ui_to_fp(a0, LType::f32(), "uitofp") }
            IntrinsicKind::UiToF64Fromu32  => { this.builder.build_ui_to_fp(a0, LType::f64(), "uitofp") }
            IntrinsicKind::UiToF64Fromu64  => { this.builder.build_ui_to_fp(a0, LType::f64(), "uitofp") }

            // -- Float → signed int --
            IntrinsicKind::FpToSi32Fromf32 => { this.builder.build_fp_to_si(a0, LType::i32(), "fptosi") }
            IntrinsicKind::FpToSi32Fromf64 => { this.builder.build_fp_to_si(a0, LType::i32(), "fptosi") }
            IntrinsicKind::FpToSi64Fromf64 => { this.builder.build_fp_to_si(a0, LType::i64(), "fptosi") }

            // -- Float → unsigned int --
            IntrinsicKind::FpToUi32Fromf32 => { this.builder.build_fp_to_ui(a0, LType::i32(), "fptoui") }
            IntrinsicKind::FpToUi32Fromf64 => { this.builder.build_fp_to_ui(a0, LType::i32(), "fptoui") }
            IntrinsicKind::FpToUi64Fromf64 => { this.builder.build_fp_to_ui(a0, LType::i64(), "fptoui") }

            // -- Bit operations --
            IntrinsicKind::Bswap16    => { this.emit_unary_llvm("llvm.bswap.i16", LType::i16(), a0, false, "bswap") }
            IntrinsicKind::Bswap32    => { this.emit_unary_llvm("llvm.bswap.i32", LType::i32(), a0, false, "bswap") }
            IntrinsicKind::Bswap64    => { this.emit_unary_llvm("llvm.bswap.i64", LType::i64(), a0, false, "bswap") }
            IntrinsicKind::Popcount32 => { this.emit_unary_llvm("llvm.ctpop.i32", LType::i32(), a0, true, "ctpop") }
            IntrinsicKind::Popcount64 => { this.emit_unary_llvm("llvm.ctpop.i64", LType::i64(), a0, true, "ctpop") }
            IntrinsicKind::Clz32 => { this.emit_clz_or_ctz("llvm.ctlz.i32", LType::i32(), a0) }
            IntrinsicKind::Clz64 => { this.emit_clz_or_ctz("llvm.ctlz.i64", LType::i64(), a0) }
            IntrinsicKind::Ctz32 => { this.emit_clz_or_ctz("llvm.cttz.i32", LType::i32(), a0) }
            IntrinsicKind::Ctz64 => { this.emit_clz_or_ctz("llvm.cttz.i64", LType::i64(), a0) }
            IntrinsicKind::Rotl32 => { this.emit_rotate("llvm.fshl.i32", LType::i32(), a0, a1) }
            IntrinsicKind::Rotl64 => { this.emit_rotate("llvm.fshl.i64", LType::i64(), a0, a1) }
            IntrinsicKind::Rotr32 => { this.emit_rotate("llvm.fshr.i32", LType::i32(), a0, a1) }
            IntrinsicKind::Rotr64 => { this.emit_rotate("llvm.fshr.i64", LType::i64(), a0, a1) }

            // -- atomic_fence(order): emit `fence seq_cst`.  The order arg
            //    is ignored; we always emit SequentiallyConsistent.  Returns
            //    void; we synthesize a void value.  The Ordering enum value
            //    7 = SequentiallyConsistent. --
            IntrinsicKind::AtomicFence => {
                llvm::LLVMBuildFence(this.builder.raw, 7, 0, "");
                LValue::null()
            }

            // -- isfinite(x): fcmp oeq (x - x), 0; true iff x is finite.
            //    NaN/±inf produce NaN in `x - x`, and oeq with NaN is false. --
            IntrinsicKind::IsFinite => {
                const diff: LValue = this.builder.build_fsub(a0, a0, "is_fin.diff");
                const zero: LValue = LType::const_real(LType::f64(), 0.0);
                this.builder.build_fcmp(LRealPredicate::OEQ, diff, zero, "is_fin")
            }

            // -- dirent_name(entry) → entry == null ? "" : (entry + 19).
            //    d_name is at byte offset 19 in glibc's struct dirent.  The
            //    GEP returns a `char *` which is exactly Cryo's `string`. --
            IntrinsicKind::DirentName  => { this.emit_dirent_name(args[0]) }
            IntrinsicKind::DirentType  => { this.emit_dirent_type(args[0]) }

            // -- panic(msg, file, line) → ensure @panic is declared, call it,
            //    then build_unreachable since panic diverges.  The dispatcher's
            //    early return in visit_call_expr bypasses the post-call
            //    divergent-name check, so the unreachable must be emitted here.
            //    Returns LValue::null() (panic returns void). --
            IntrinsicKind::Panic       => { this.emit_panic_call(args[0], args[1], args[2]) }
        };

        return Option::Some(out_value);
    }

    /// Emit `call @panic(msg, file, line); unreachable`.  Ensures the
    /// `@panic` runtime function is declared in the current module first.
    emit_panic_call(mut &this, msg: LValue, file: LValue, line: LValue) -> LValue {
        this.emit_panic_runtime();
        const panic_fn: LValue = this.llvm_module.get_named_function("panic");
        if (!panic_fn.is_valid()) { return LValue::null(); }
        // Match emit_panic_runtime's declared signature: (ptr, ptr, i32) -> void.
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const param_buf: void* = intrinsics::malloc(24);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ptr_ty.raw;
        param_slots[1] = ptr_ty.raw;
        param_slots[2] = LType::i32().raw;
        const fty: LType = LType::function_type(LType::void_type(), param_buf, 3, false);
        intrinsics::free(param_buf);
        const arg_buf: void* = intrinsics::malloc(24);
        const arg_slots: void** = arg_buf as void**;
        arg_slots[0] = msg.raw;
        arg_slots[1] = file.raw;
        arg_slots[2] = line.raw;
        this.builder.build_call(fty, panic_fn, arg_buf, 3, "");
        intrinsics::free(arg_buf);
        this.builder.build_unreachable();
        return LValue::null();
    }

    emit_dirent_name(mut &this, entry: LValue) -> LValue {
        const i8_ty: LType = LType::i8();
        const ptr_ty: LType = LType::pointer_to(i8_ty);
        // GEP entry, +19 → ptr to d_name
        const off: LValue = LType::const_int(LType::i64(), 19, false);
        const idx_buf: void* = intrinsics::malloc(8);
        const idx_slots: void** = idx_buf as void**;
        idx_slots[0] = off.raw;
        const name_ptr: LValue = this.builder.build_gep(i8_ty, entry, idx_buf, 1, "d_name");
        intrinsics::free(idx_buf);
        // Null guard: if entry is null, return "" (a global empty string).
        const empty: LValue = this.builder.build_global_string_ptr("", "d_name.empty");
        const is_null: LValue = this.builder.build_icmp(
            LIntPredicate::EQ, entry, LType::const_pointer_null(ptr_ty), "d_name.is_null");
        return this.builder.build_select(is_null, empty, name_ptr, "d_name.sel");
    }

    emit_dirent_type(mut &this, entry: LValue) -> LValue {
        const i8_ty: LType = LType::i8();
        const i32_ty: LType = LType::i32();
        const ptr_ty: LType = LType::pointer_to(i8_ty);
        // GEP entry, +18 → ptr to d_type (i8)
        const off: LValue = LType::const_int(LType::i64(), 18, false);
        const idx_buf: void* = intrinsics::malloc(8);
        const idx_slots: void** = idx_buf as void**;
        idx_slots[0] = off.raw;
        const type_ptr: LValue = this.builder.build_gep(i8_ty, entry, idx_buf, 1, "d_type.ptr");
        intrinsics::free(idx_buf);
        const type_byte: LValue = this.builder.build_load(i8_ty, type_ptr, "d_type.byte");
        const widened: LValue = this.builder.build_zext(type_byte, i32_ty, "d_type.i32");

        // Map POSIX DT_* values to FileType enum ordinals.  The intrinsic
        // contract (see stdlib/fs/dir.cryo and stdlib/core/intrinsics.cryo:
        // "returns i32 mapped to FileType ordinals") expects ordinals, not
        // raw d_type bytes.  Callers like module_loader.cryo's
        // `if (dtype == 1)` (directory) and `else if (dtype == 0)` (file)
        // depend on this remapping; without it, Linux's DT_DIR=4 / DT_REG=8
        // would never match and every .cryo entry would be skipped during
        // pre-scan.
        //
        //   DT_REG(8)   → FileType::File(0)
        //   DT_DIR(4)   → FileType::Directory(1)
        //   DT_LNK(10)  → FileType::Symlink(2)
        //   DT_BLK(6)   → FileType::BlockDevice(3)
        //   DT_CHR(2)   → FileType::CharDevice(4)
        //   DT_FIFO(1)  → FileType::Fifo(5)
        //   DT_SOCK(12) → FileType::Socket(6)
        //   otherwise   → FileType::Unknown(7)
        const c_dt_fifo: LValue = LType::const_int(i32_ty, 1,  false);
        const c_dt_chr:  LValue = LType::const_int(i32_ty, 2,  false);
        const c_dt_dir:  LValue = LType::const_int(i32_ty, 4,  false);
        const c_dt_blk:  LValue = LType::const_int(i32_ty, 6,  false);
        const c_dt_reg:  LValue = LType::const_int(i32_ty, 8,  false);
        const c_dt_lnk:  LValue = LType::const_int(i32_ty, 10, false);
        const c_dt_sock: LValue = LType::const_int(i32_ty, 12, false);

        const ft_file:    LValue = LType::const_int(i32_ty, 0, false);
        const ft_dir:     LValue = LType::const_int(i32_ty, 1, false);
        const ft_symlink: LValue = LType::const_int(i32_ty, 2, false);
        const ft_block:   LValue = LType::const_int(i32_ty, 3, false);
        const ft_char:    LValue = LType::const_int(i32_ty, 4, false);
        const ft_fifo:    LValue = LType::const_int(i32_ty, 5, false);
        const ft_socket:  LValue = LType::const_int(i32_ty, 6, false);
        const ft_unknown: LValue = LType::const_int(i32_ty, 7, false);

        // Chain of selects, defaulting to Unknown.
        mut mapped: LValue = ft_unknown;
        const is_sock: LValue = this.builder.build_icmp(LIntPredicate::EQ, widened, c_dt_sock, "is_sock");
        mapped = this.builder.build_select(is_sock, ft_socket,  mapped, "ft.sock");
        const is_lnk:  LValue = this.builder.build_icmp(LIntPredicate::EQ, widened, c_dt_lnk,  "is_lnk");
        mapped = this.builder.build_select(is_lnk,  ft_symlink, mapped, "ft.lnk");
        const is_reg:  LValue = this.builder.build_icmp(LIntPredicate::EQ, widened, c_dt_reg,  "is_reg");
        mapped = this.builder.build_select(is_reg,  ft_file,    mapped, "ft.reg");
        const is_blk:  LValue = this.builder.build_icmp(LIntPredicate::EQ, widened, c_dt_blk,  "is_blk");
        mapped = this.builder.build_select(is_blk,  ft_block,   mapped, "ft.blk");
        const is_dir:  LValue = this.builder.build_icmp(LIntPredicate::EQ, widened, c_dt_dir,  "is_dir");
        mapped = this.builder.build_select(is_dir,  ft_dir,     mapped, "ft.dir");
        const is_chr:  LValue = this.builder.build_icmp(LIntPredicate::EQ, widened, c_dt_chr,  "is_chr");
        mapped = this.builder.build_select(is_chr,  ft_char,    mapped, "ft.chr");
        const is_fifo: LValue = this.builder.build_icmp(LIntPredicate::EQ, widened, c_dt_fifo, "is_fifo");
        mapped = this.builder.build_select(is_fifo, ft_fifo,    mapped, "ft.fifo");

        // Null guard: return File(0) if entry is null (matches the prior
        // behaviour where the null check yielded 0).
        const zero: LValue = LType::const_int(i32_ty, 0, false);
        const is_null: LValue = this.builder.build_icmp(
            LIntPredicate::EQ, entry, LType::const_pointer_null(ptr_ty), "d_type.is_null");
        return this.builder.build_select(is_null, zero, mapped, "d_type.sel");
    }

    get_or_decl_vasprintf(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("vasprintf");
        if (fn.is_valid()) { return fn; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const buf: void* = intrinsics::malloc(24);
        const slots: void** = buf as void**;
        slots[0] = ptr_ty.raw;   // char**
        slots[1] = ptr_ty.raw;   // const char* fmt
        slots[2] = ptr_ty.raw;   // va_list (pointer-to-bucket on SysV)
        const fty: LType = LType::function_type(LType::i32(), buf, 3, false);
        intrinsics::free(buf);
        return this.llvm_module.add_function("vasprintf", fty);
    }

    get_or_decl_va_start(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("llvm.va_start.p0");
        if (fn.is_valid()) { return fn; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const buf: void* = intrinsics::malloc(8);
        const slots: void** = buf as void**;
        slots[0] = ptr_ty.raw;
        const fty: LType = LType::function_type(LType::void_type(), buf, 1, false);
        intrinsics::free(buf);
        return this.llvm_module.add_function("llvm.va_start.p0", fty);
    }

    get_or_decl_va_end(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("llvm.va_end.p0");
        if (fn.is_valid()) { return fn; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const buf: void* = intrinsics::malloc(8);
        const slots: void** = buf as void**;
        slots[0] = ptr_ty.raw;
        const fty: LType = LType::function_type(LType::void_type(), buf, 1, false);
        intrinsics::free(buf);
        return this.llvm_module.add_function("llvm.va_end.p0", fty);
    }

    /// Declare libc `abort` extern: `void abort(void) __attribute__((noreturn))`.
    get_or_decl_abort(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("abort");
        if (fn.is_valid()) { return fn; }
        const fty: LType = LType::function_type(LType::void_type(), null, 0, false);
        return this.llvm_module.add_function("abort", fty);
    }

    /// Emit the `@panic(msg, file, line)` runtime function into the current
    /// module if it hasn't been emitted yet.  Idempotent.  Backs the bare
    /// `intrinsics::panic` calls emitted by `std::prelude::panic` and the
    /// `Option::unwrap`/`Result::unwrap` family; those produce a direct
    /// `call @panic(...)` with no body; without this, the linker fails on
    /// `undefined reference to 'panic'`.
    ///
    /// The body just calls libc `abort()` and emits `unreachable`; on a
    /// future iteration we can route through `fprintf(stderr, ...)` to print
    /// the message, but that requires extra externs.
    emit_panic_runtime(mut &this) -> void {
        mut panic_fn: LValue = this.llvm_module.get_named_function("panic");
        if (panic_fn.is_valid()) {
            const first_bb: void* = llvm::LLVMGetFirstBasicBlock(panic_fn.raw);
            if (first_bb != null) { return; }
        }

        // Declare panic as `(ptr msg, ptr file, i32 line) -> void` if not
        // already present.
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        if (!panic_fn.is_valid()) {
            const param_buf: void* = intrinsics::malloc(24);
            const param_slots: void** = param_buf as void**;
            param_slots[0] = ptr_ty.raw;
            param_slots[1] = ptr_ty.raw;
            param_slots[2] = LType::i32().raw;
            const fty: LType = LType::function_type(LType::void_type(), param_buf, 3, false);
            intrinsics::free(param_buf);
            panic_fn = this.llvm_module.add_function("panic", fty);
        }
        if (!panic_fn.is_valid()) { return; }

        // linkonce_odr: every module gets a copy; linker collapses them.
        panic_fn.set_linkage(LLinkage::LinkOnceODR);

        const saved_bb: LBasicBlock = this.builder.get_insert_block();
        const entry_bb: LBasicBlock = LBasicBlock::append(panic_fn, "entry");
        this.builder.position_at_end(entry_bb);

        const abort_fn: LValue = this.get_or_decl_abort();
        const abort_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(abort_fn.raw) };
        mut a_args: Pair<LValue, TypeRef>[] = [];
        mut a_res: LValue = LValue::null();
        a_res = this.codegen_call(abort_fn, abort_ty, a_args, "");
        this.builder.build_unreachable();

        if (saved_bb.is_valid()) {
            this.builder.position_at_end(saved_bb);
        }
    }

    /// Emit the `@format` runtime function into the current module if it
    /// hasn't been emitted yet.  Idempotent.  Called once per module before
    /// user IR-gen; the linkonce_odr linkage means the linker collapses all
    /// 100+ copies down to one.
    emit_format_runtime(mut &this) -> void {
        // If `format` already has a basic block, it's already defined here.
        mut fmt_fn: LValue = this.llvm_module.get_named_function("format");
        if (fmt_fn.is_valid()) {
            const first_bb: void* = llvm::LLVMGetFirstBasicBlock(fmt_fn.raw);
            if (first_bb != null) { return; }
        }

        // Declare format as `(ptr, ...) -> ptr` if it doesn't exist yet.
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        if (!fmt_fn.is_valid()) {
            const param_buf: void* = intrinsics::malloc(8);
            const param_slots: void** = param_buf as void**;
            param_slots[0] = ptr_ty.raw;
            const fty: LType = LType::function_type(ptr_ty, param_buf, 1, true);
            intrinsics::free(param_buf);
            fmt_fn = this.llvm_module.add_function("format", fty);
        }
        if (!fmt_fn.is_valid()) { return; }

        // linkonce_odr: all copies emitted across modules merge to one.
        fmt_fn.set_linkage(LLinkage::LinkOnceODR);

        // Save & restore the builder's insertion position so we don't
        // disturb whatever else is being generated for this module.
        const saved_bb: LBasicBlock = this.builder.get_insert_block();

        const entry_bb: LBasicBlock = LBasicBlock::append(fmt_fn, "entry");
        this.builder.position_at_end(entry_bb);

        // Allocate va_list (24 bytes, System V x86-64 layout) and the
        // string out-pointer.
        const va_list_ty: LType = LType::array_of(LType::i8(), 24);
        const va_alloca: LValue = this.builder.build_alloca(va_list_ty, "va");
        const strp_alloca: LValue = this.builder.build_alloca(ptr_ty, "strp");
        this.builder.build_store(LType::const_pointer_null(ptr_ty), strp_alloca);

        // va_start(&va)
        const va_start_fn: LValue = this.get_or_decl_va_start();
        const va_start_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(va_start_fn.raw) };
        mut vs_args: Pair<LValue, TypeRef>[] = [];
        vs_args.push(Pair<LValue, TypeRef>::new(va_alloca, TypeRef::invalid()));
        mut vs_res: LValue = LValue::null();
        vs_res = this.codegen_call(va_start_fn, va_start_ty, vs_args, "");

        // n = vasprintf(strp, fmt, &va)
        const vasprintf_fn: LValue = this.get_or_decl_vasprintf();
        const vasprintf_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(vasprintf_fn.raw) };
        const fmt_param: LValue = LValue { raw: llvm::LLVMGetParam(fmt_fn.raw, 0) };
        mut va_args: Pair<LValue, TypeRef>[] = [];
        va_args.push(Pair<LValue, TypeRef>::new(strp_alloca, TypeRef::invalid()));
        va_args.push(Pair<LValue, TypeRef>::new(fmt_param, TypeRef::invalid()));
        va_args.push(Pair<LValue, TypeRef>::new(va_alloca, TypeRef::invalid()));
        mut n_result: LValue = LValue::null();
        n_result = this.codegen_call(vasprintf_fn, vasprintf_ty, va_args, "n");

        // va_end(&va)
        const va_end_fn: LValue = this.get_or_decl_va_end();
        const va_end_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(va_end_fn.raw) };
        mut ve_args: Pair<LValue, TypeRef>[] = [];
        ve_args.push(Pair<LValue, TypeRef>::new(va_alloca, TypeRef::invalid()));
        mut ve_res: LValue = LValue::null();
        ve_res = this.codegen_call(va_end_fn, va_end_ty, ve_args, "");

        // %neg = (n < 0); %buf = load strp; %ret = select neg, null, buf
        const zero32: LValue = LType::const_int(LType::i32(), 0, false);
        const is_neg: LValue = this.builder.build_icmp(LIntPredicate::SLT, n_result, zero32, "neg");
        const buf_loaded: LValue = this.builder.build_load(ptr_ty, strp_alloca, "buf");
        const null_ret: LValue = LType::const_pointer_null(ptr_ty);
        const ret_val: LValue = this.builder.build_select(is_neg, null_ret, buf_loaded, "ret");
        this.builder.build_ret(ret_val);

        // Restore builder.
        if (saved_bb.is_valid()) {
            this.builder.position_at_end(saved_bb);
        }
    }
}


// ============================================================================
// Block-result structs returned by the control-flow codegen primitives.
// Kept top-level (a class method can't return a type defined inside the
// class) so that visit() overrides can name the type when destructuring.
// ============================================================================

type struct IfBlocks {
    then_bb:  LBasicBlock;
    else_bb:  LBasicBlock;
    merge_bb: LBasicBlock;
}

type struct LoopBlocks {
    cond_bb:  LBasicBlock;
    body_bb:  LBasicBlock;
    merge_bb: LBasicBlock;
}

type struct ForBlocks {
    cond_bb:   LBasicBlock;
    body_bb:   LBasicBlock;
    update_bb: LBasicBlock;
    merge_bb:  LBasicBlock;
}


// ============================================================================
// On-demand cross-module extern declaration
// ============================================================================
//
// These helpers replace the old `declare_cross_module_externs` /
// `declare_cross_module_global_externs` pre-pass that walked every function
// and global in every module and emitted an LLVM `declare` in the current
// module regardless of whether it was referenced.  The bulk pass was
// O(modules × functions × overloads) per compiled module, crippling for
// stdlib-heavy programs with many generic specializations.
//
// Instead, codegen calls `resolve_function` / `resolve_function_with_arity`
// / `resolve_global` at each cross-module reference.  The helpers:
//   1. Fast-path: check the context's own function/global map.
//   2. Slow-path: look up the signature in `DeclarationIndex`, emit an
//      `external` declaration in the current LLVM module, register it,
//      and return the handle.
// This mirrors what LLVM itself does via `Module::getOrInsertFunction`.

/// Returns true if the FunctionType reaches a GenericParam / BoundedParam
/// anywhere in its return type or parameter types (walking through
/// References, Pointers, Arrays, Optionals, Tuples, and InstantiatedTypes
/// with no resolved_type).  Used by extern-overload declaration to filter
/// out sema-time registrations of still-generic templates whose param
/// signatures would otherwise lower to opaque `ptr` and produce a wrong
/// mangled name.
function type_ref_has_generic_params(arena: TypeArena*, ty: TypeRef) -> boolean {
    if (!ty.is_valid()) { return false; }
    return type_has_generic_params_walker(arena, ty, 0);
}

function type_has_generic_params_walker(arena: TypeArena*, ty: TypeRef, depth: i32) -> boolean {
    if (depth > 8) { return false; }
    if (!ty.is_valid()) { return false; }
    const t: Type* = arena.lookup(ty.id);
    if (t == null) { return false; }
    const k: TypeKind = t.kind;
    if (k == TypeKind::GenericParam || k == TypeKind::BoundedParam) {
        return true;
    }
    if (k == TypeKind::Reference) {
        const r: ReferenceType* = t as ReferenceType*;
        return type_has_generic_params_walker(arena, r.referent, depth + 1);
    }
    if (k == TypeKind::Pointer) {
        const p: PointerType* = t as PointerType*;
        return type_has_generic_params_walker(arena, p.pointee, depth + 1);
    }
    if (k == TypeKind::Array) {
        const a: ArrayType* = t as ArrayType*;
        return type_has_generic_params_walker(arena, a.element, depth + 1);
    }
    if (k == TypeKind::Optional) {
        const o: OptionalType* = t as OptionalType*;
        return type_has_generic_params_walker(arena, o.wrapped, depth + 1);
    }
    if (k == TypeKind::Tuple) {
        const tu: TupleType* = t as TupleType*;
        for (mut i: i64 = 0; i < tu.elements.length; i++) {
            if (type_has_generic_params_walker(arena, tu.elements[i], depth + 1)) {
                return true;
            }
        }
        return false;
    }
    if (k == TypeKind::InstantiatedType) {
        const inst: InstantiatedType* = t as InstantiatedType*;
        if (inst.has_resolved_type()) {
            return type_has_generic_params_walker(arena, inst.resolved_type, depth + 1);
        }
        // Un-resolved InstantiatedType: walk its type_args for generic
        // params (e.g. `Foo<T>` where T is still a template param).
        for (mut i: i64 = 0; i < inst.type_args.length; i++) {
            if (type_has_generic_params_walker(arena, inst.type_args[i], depth + 1)) {
                return true;
            }
        }
        return false;
    }
    return false;
}

function function_type_has_generic_params(arena: TypeArena*, ft: FunctionType*) -> boolean {
    if (type_ref_has_generic_params(arena, ft.return_type)) { return true; }
    for (mut i: i64 = 0; i < ft.param_types.length; i++) {
        if (type_ref_has_generic_params(arena, ft.param_types[i])) { return true; }
    }
    return false;
}
