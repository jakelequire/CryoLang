/// Codegen Context
///
/// Per-module LLVM codegen state.  One CodegenContext is created for each
/// compilation module.  Holds the LLVM module, builder, type mapper, and
/// value/scope maps that codegen needs to produce IR.

namespace Compiler::Codegen::Context;

import Compiler::Codegen;
import Compiler::Codegen::{ LLVMTypes, TypeMap, Abi };
import Compiler::Codegen::State::{ LoopStack, ValueTable, FunctionRegistry, GlobalRegistry, StringCache, DiagSink };
import Compiler::Codegen::Ops::{ IRFlowEmitter, SymbolResolver, IntrinsicEmitter, ExprOps, DeclarationEmitter };
import Compiler::CompilationContext;
import Compiler::DeclIndex;
import Compiler::Diag;
import Compiler::Diag::{ Diagnostic, SourceSpan, Sink };
import Compiler::Types;
import Compiler::Types::{ TypeRef, Type, Arena, Compound, Generic };
import Compiler::Resolver::{ SymbolStr, InternTable, MangledName, QualifiedName };
import std::collections::pair;


type struct CodegenContext {
    // -- LLVM state --
    llvm_module: LModule;
    builder:     LBuilder;
    type_mapper: TypeMapper;

    // -- ABI lowering classifier (SysV x86-64 today; per-target later).
    //    Owns the cached LLVM attribute-kind IDs and holds a back-pointer
    //    to `type_mapper`, set by `wire()`. --
    abi: AbiClassifier;

    // -- Local-scope bindings (named values + push/pop_scope undo log) --
    values: ValueTable;

    // -- Function declarations (by-name and overload-aware) --
    functions: FunctionRegistry;

    // -- Module-global variables --
    globals: GlobalRegistry;

    // -- Deduplicated string literal globals --
    str_cache: StringCache;

    // -- Loop target stack --
    // Push (break_bb, continue_bb) on loop entry; pop on loop exit.
    // `break`/`continue` jump to the top of the stack.
    loops: LoopStack;

    // -- Control-flow IR primitives (codegen_if/while/for/loop, allocas,
    //    break/continue, terminator guards).  Holds back-pointers to
    //    `builder` and `loops`, set by `wire()` after this context is at
    //    a stable address. --
    flow: IRFlowEmitter;

    // -- Cross-module name resolution + extern declaration for functions
    //    and globals.  Holds back-pointers to llvm_module, type_mapper,
    //    functions, globals, and ctx. --
    resolver: SymbolResolver;

    // -- Inline lowering for bare-name intrinsics + per-module @panic /
    //    @format runtime helpers. --
    intrinsics: IntrinsicEmitter;

    // -- AST-agnostic expression-level helpers: sizeof/alignof, casts,
    //    binary/unary, calls, locals, returns + variadic-arg lifecycle. --
    expr_ops: ExprOps;

    // -- Phase-1 (forward-declare types) and Phase-2 (declare functions,
    //    methods, externs, globals, vtables) of the codegen pipeline,
    //    plus function/method prologue/epilogue lowering. --
    decl: DeclarationEmitter;

    // -- Shared references --
    ctx: CompilationContext*;

    // -- Diagnostic routing + stripped-functions set --
    diag: DiagSink;

    /// Create a new codegen context for a module.
    static new(ctx: CompilationContext*, module_name: string) -> CodegenContext {
        const mod: LModule = LModule::create(module_name);
        const builder: LBuilder = LBuilder::create();

        // ABI lowering rules depend on the resolved target triple
        // (CLI `--target=...` / cryoconfig `target_triple` / host
        // fallback).  The classifier holds an `AbiKind` so its
        // per-target branches (va_list shape today; aggregate
        // classification later) dispatch without consulting the
        // triple again on every call.
        const abi_triple: string = LTargetMachine::resolve_effective_triple(ctx.target_triple);

        return CodegenContext {
            llvm_module: mod,
            builder:     builder,
            type_mapper: TypeMapper::new(ctx.type_arena, ctx.intern_table, ctx.diagnostics),
            abi:         AbiClassifier::for_triple(abi_triple),

            values:    ValueTable::new(),
            functions: FunctionRegistry::new(),
            globals:   GlobalRegistry::new(),
            str_cache: StringCache::new(),

            loops:      LoopStack::new(),
            flow:       IRFlowEmitter::null(),
            resolver:   SymbolResolver::null(),
            intrinsics: IntrinsicEmitter::null(),
            expr_ops:   ExprOps::null(),
            decl:       DeclarationEmitter::null(),

            ctx:  ctx,
            diag: DiagSink::new(ctx),
        };
    }

    /// Two-phase init step 2: wire up back-pointers on sub-components.
    /// Must be called AFTER this context is at its stable (heap) address;
    /// see `passes.cryo` where the context is `Box::leak()`'d and then
    /// `wire()`'d.  Wiring before the move would leave back-pointers
    /// dangling at the source slot.
    wire(mut &this) -> void {
        this.flow.wire(&this.builder, &this.loops);

        this.abi.wire(&this.type_mapper);

        this.resolver.wire(&this.llvm_module, &this.type_mapper, &this.abi,
                           &this.functions, &this.globals, this.ctx);

        this.intrinsics.wire(&this.llvm_module, &this.builder, &this.abi,
                             this.ctx.project_no_runtime,
                             this.ctx.project_panic_unwind);

        this.expr_ops.wire(&this.llvm_module, &this.builder, &this.type_mapper,
                           &this.abi,
                           &this.values, &this.functions, &this.flow,
                           &this.resolver, &this.intrinsics, &this.diag, this.ctx);

        this.decl.wire(&this.llvm_module, &this.builder, &this.type_mapper,
                       &this.abi,
                       &this.values, &this.functions, &this.globals,
                       &this.str_cache, &this.flow, &this.resolver,
                       &this.expr_ops, &this.intrinsics, &this.diag, this.ctx);
    }


    // Convenience accessors that route through CompilationContext.  Kept
    // because the post-decomposition struct is slim and the accessors
    // are a stable API consumed by sub-components that don't import
    // `CompilationContext` directly.

    /// Get the InternTable via ctx.intern_table.
    get_intern(&this) -> InternTable* {
        const c: CompilationContext* = this.ctx;
        return c.intern_table;
    }

    /// Get the TypeArena reliably via ctx->type_arena.
    get_arena(&this) -> TypeArena* {
        const c: CompilationContext* = this.ctx;
        return c.type_arena;
    }

    /// Get the DeclarationIndex reliably via ctx->decl_index.
    get_decl_index(&this) -> DeclarationIndex* {
        const c: CompilationContext* = this.ctx;
        return c.decl_index;
    }

    /// Qualify a symbol name with the current module namespace.
    qualify(&this, sym: SymbolStr) -> SymbolStr {
        const c: CompilationContext* = this.ctx;
        return c.qualify_symbol_sym(sym);
    }

    /// Resolve an interned SymbolStr to its string.
    resolve(&this, sym: SymbolStr) -> string {
        const c: CompilationContext* = this.ctx;
        const it: InternTable* = c.intern_table;
        return it.resolve(sym);
    }

    /// Intern a string into the shared InternTable.
    intern_str(&this, text: string) -> SymbolStr {
        const c: CompilationContext* = this.ctx;
        const it: InternTable* = c.intern_table;
        return it.intern(text);
    }

    /// Look up a type in the arena by ID.
    /// Splits the chained `cg.get_arena().lookup(id)` pattern into two
    /// local-typed deref steps; chained method-call resolution across
    /// pointer hops has historically been brittle here.
    lookup_type_by_id(&this, id: u64) -> Type* {
        const c: CompilationContext* = this.ctx;
        const a: TypeArena* = c.type_arena;
        return a.lookup(id);
    }

    /// Whether a Cryo type is a *signed* integer.  Used by the integer
    /// coercion sites (return values, phi operands, match comparisons) to
    /// pick `sext` vs `zext` when widening: a narrow signed value must be
    /// sign-extended (`mut x: i64 = -1` is `-1`, not `0xFFFFFFFF`).
    /// Returns `false` for non-integer / unresolvable types, which keeps
    /// the historical `zext` behaviour for those cases (no regression).
    int_type_is_signed(&this, ty: TypeRef) -> boolean {
        const t: Type* = this.lookup_type_by_id(ty.id);
        if (t != null && t.kind == TypeKind::Int) {
            const it: IntType* = t as IntType*;
            return it.int_kind.is_signed();
        }
        return false;
    }

    // Cleanup

    /// Dispose LLVM resources.  Call only when the LLVM module has been
    /// transferred to artifacts (don't dispose the module if it's still owned).
    dispose_builder(mut &this) -> void {
        this.builder.dispose();
    }
}


