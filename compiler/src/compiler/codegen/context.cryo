/// Codegen Context
///
/// Per-module LLVM codegen state.  One CodegenContext is created for each
/// compilation module.  Holds the LLVM module, builder, type mapper, and
/// value/scope maps that codegen needs to produce IR.

namespace Compiler::Codegen::Context;

import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Codegen::TypeMap;
import Compiler::CompilationContext;
import Compiler::DeclIndex;
import Compiler::Diag;
import Compiler::Diag::Diagnostic;
import Compiler::Diag::SourceSpan;
import Compiler::Diag::Sink;
import Compiler::Types;
import Compiler::Types::TypeRef;
import Compiler::Types::Type;
import Compiler::Types::Arena;
import Compiler::Types::Compound;
import Compiler::Types::Generic;
import Compiler::Resolver::SymbolStr;
import Compiler::Resolver::InternTable;
import Compiler::Resolver::MangledName;
import Compiler::Resolver::QualifiedName;
import std::collections::pair;


// ============================================================================
// CodegenContext
// ============================================================================

type struct CodegenContext {
    // -- LLVM state --
    llvm_module:      LModule;
    builder:     LBuilder;
    type_mapper: TypeMapper;

    // -- Named values: SymbolStr.id -> LLVMValueRef raw pointer --
    // Local variables and parameters in the current scope.
    named: Pair<u32, void*>[];

    // -- Scope undo log (same pattern as sema's TypeCheckVisitor) --
    // On push_scope(), record the undo log length.  On pop_scope(), roll
    // back all bindings added since the push.
    undo:         Pair<u32, void*>[];  // (SymbolStr.id, previous LLVMValueRef or null)
    scope_marks:  i64[];              // undo log length at each scope push

    // -- Function map: SymbolStr.id -> LLVMValueRef --
    funcs: Pair<u32, void*>[];

    // -- Overload-aware function map: (SymbolStr.id, arity) -> LLVMValueRef.
    //    Parallel arrays so callers can disambiguate `Array::new()` from
    //    `Array::new(u64)` without collapsing to a single last-wins entry.
    func_overload_keys:    u32[];
    func_overload_arities: u32[];
    func_overload_values:  void*[];

    // -- Global map: SymbolStr.id -> LLVMValueRef --
    globals: Pair<u32, void*>[];

    // -- String literal dedup --
    str_lits: Pair<string, void*>[];

    // -- Break/Continue target stack (for loops) --
    break_targets:    void*[];     // LLVMBasicBlockRef stack
    continue_targets: void*[];     // LLVMBasicBlockRef stack

    // -- Shared references --
    ctx:    CompilationContext*;
    arena:  TypeArena*;
    intern: InternTable*;

    // -- Active variadic arg name (SymbolStr.id) --
    // Set by the function prologue when entering a variadic body so that
    // `codegen_return` can emit `@llvm.va_end` before every `ret`.  0
    // means the current function is not variadic.
    current_variadic_arg_id: u32;

    // -- Stripped-functions set --
    // Mangled LLVM names of functions whose body was attempted-but-stripped
    // in this module (`is_function_body_valid` returned false →
    // `strip_function_body` deleted all blocks).  Used by the post-codegen
    // cascade-strip pass to identify same-module declare-only callees and
    // strip their callers too, so an `Array<T>::quicksort` body that calls
    // a stripped `partition` doesn't emit a dangling extern at link time.
    // Cross-module externs are NOT in this set, so they're unaffected.
    stripped_func_names: string[];

    /// Create a new codegen context for a module.
    static new(ctx: CompilationContext*, module_name: string) -> CodegenContext {
        const mod: LModule = LModule::create(module_name);
        const builder: LBuilder = LBuilder::create();

        return CodegenContext {
            llvm_module:      mod,
            builder:     builder,
            type_mapper: TypeMapper::new(ctx.type_arena, ctx.intern_table),

            named:        [],
            undo:         [],
            scope_marks:  [],

            funcs:        [],

            func_overload_keys:    [],
            func_overload_arities: [],
            func_overload_values:  [],

            globals:   [],

            str_lits:   [],

            break_targets:    [],
            continue_targets: [],

            ctx:    ctx,
            arena:  ctx.type_arena,
            intern: ctx.intern_table,

            current_variadic_arg_id: 0,
            stripped_func_names: [],
        };
    }


    // ========================================================================
    // Safe accessors: route through CompilationContext to dodge subtle
    // struct-offset issues on the large CodegenContext layout that have
    // historically miscalculated `this.<field>` offsets.
    // ========================================================================

    /// Get the InternTable reliably via ctx→intern_table.
    /// Do NOT use `this.intern`; the field offset may be wrong
    /// due to the large CodegenContext struct layout.
    get_intern(&this) -> InternTable* {
        const c: CompilationContext* = this.ctx;
        return c.intern_table;
    }

    /// Get the TypeArena reliably via ctx→type_arena.
    get_arena(&this) -> TypeArena* {
        const c: CompilationContext* = this.ctx;
        return c.type_arena;
    }

    /// Get the DeclarationIndex reliably via ctx→decl_index.
    get_decl_index(&this) -> DeclarationIndex* {
        const c: CompilationContext* = this.ctx;
        return c.decl_index;
    }

    /// Qualify a symbol name with the current module namespace.
    qualify(&this, sym: SymbolStr) -> SymbolStr {
        const c: CompilationContext* = this.ctx;
        return c.qualify_symbol_sym(sym);
    }

    /// Resolve an interned SymbolStr to its string.
    resolve(&this, sym: SymbolStr) -> string {
        const c: CompilationContext* = this.ctx;
        const it: InternTable* = c.intern_table;
        return it.resolve(sym);
    }

    /// Intern a string into the shared InternTable.
    intern_str(&this, text: string) -> SymbolStr {
        const c: CompilationContext* = this.ctx;
        const it: InternTable* = c.intern_table;
        return it.intern(text);
    }

    /// Look up a type in the arena by ID.
    /// Splits the chained `cg.get_arena().lookup(id)` pattern into two
    /// local-typed deref steps; chained method-call resolution across
    /// pointer hops has historically been brittle here.
    lookup_type_by_id(&this, id: u64) -> Type* {
        const c: CompilationContext* = this.ctx;
        const a: TypeArena* = c.type_arena;
        return a.lookup(id);
    }

    /// Whether a Cryo type is a *signed* integer.  Used by the integer
    /// coercion sites (return values, phi operands, match comparisons) to
    /// pick `sext` vs `zext` when widening: a narrow signed value must be
    /// sign-extended (`mut x: i64 = -1` is `-1`, not `0xFFFFFFFF`).
    /// Returns `false` for non-integer / unresolvable types, which keeps
    /// the historical `zext` behaviour for those cases (no regression).
    int_type_is_signed(&this, ty: TypeRef) -> boolean {
        const t: Type* = this.lookup_type_by_id(ty.id);
        if (t != null && t.kind == TypeKind::Int) {
            const it: IntType* = t as IntType*;
            return it.int_kind.is_signed();
        }
        return false;
    }

    // ========================================================================
    // Diagnostic helpers (codegen-local shorthand)
    // ========================================================================

    /// Emit an error with a source span. Shorthand for
    /// `this.ctx.emit_error_at(code, msg, span)`; prefer this over
    /// `ctx.emit_error` whenever the triggering AST node is in scope; the
    /// span gives the renderer a file:line arrow and source snippet.
    emit_error_at_span(&this, code: ErrorCode, message: string, span: SourceSpan) -> void {
        this.ctx.emit_error_at(code, message, span);
    }

    /// Emit a warning with a source span.
    emit_warning_at_span(&this, code: ErrorCode, message: string, span: SourceSpan) -> void {
        mut diag: Diagnostic = Diagnostic::warning(code, message);
        diag = diag.at(span);
        this.emit_diagnostic(diag);
    }

    /// Emit a pre-built Diagnostic.  Use this when you need the builder
    /// API (secondary labels, notes, suggestions) that the `_at_span`
    /// helpers don't expose.  Breaks the chained access through
    /// `this.ctx.diagnostics` into intermediate locals; the chained form
    /// trips a type-resolver limitation when written inline.
    emit_diagnostic(&this, diag: Diagnostic) -> void {
        const c: CompilationContext* = this.ctx;
        const sink: DiagnosticSink* = c.diagnostics;
        sink.emit(diag);
    }

    /// Strip all basic blocks from a function, reverting it to a declare.
    /// Used when body generation fails: better a clean declare than
    /// a half-built define that fails LLVM verification.  Also records the
    /// function's mangled LLVM name in `stripped_func_names` so the
    /// post-codegen cascade pass can strip callers in the same module.
    strip_function_body(mut &this, fn_val: LValue) -> void {
        if (!fn_val.is_valid()) { return; }
        const fn_name: string = llvm::LLVMGetValueName(fn_val.raw) as string;
        if (fn_name != null) {
            this.stripped_func_names.push(fn_name);
        }
        mut bb: void* = llvm::LLVMGetFirstBasicBlock(fn_val.raw);
        while (bb != null) {
            const next: void* = llvm::LLVMGetNextBasicBlock(bb);
            llvm::LLVMDeleteBasicBlock(bb);
            bb = next;
        }
    }

    /// Check whether a function's IR is valid (all blocks terminated).
    /// Returns false if any basic block lacks a terminator.
    is_function_body_valid(&this, fn_val: LValue) -> boolean {
        if (!fn_val.is_valid()) { return false; }
        mut bb: void* = llvm::LLVMGetFirstBasicBlock(fn_val.raw);
        while (bb != null) {
            const term: void* = llvm::LLVMGetBasicBlockTerminator(bb);
            if (term == null) { return false; }
            bb = llvm::LLVMGetNextBasicBlock(bb);
        }
        return true;
    }

    /// Count basic blocks in a function partitioned by whether they have a
    /// terminator.  Both counts are written through the out-parameters.
    /// Used by `report_invalid_function_body` to phrase the diagnostic.
    count_unterminated_blocks(&this, fn_val: LValue,
                              out_total: i32*, out_bad: i32*) -> void {
        *out_total = 0;
        *out_bad   = 0;
        if (!fn_val.is_valid()) { return; }
        mut bb: void* = llvm::LLVMGetFirstBasicBlock(fn_val.raw);
        while (bb != null) {
            *out_total = *out_total + 1;
            const term: void* = llvm::LLVMGetBasicBlockTerminator(bb);
            if (term == null) {
                *out_bad = *out_bad + 1;
            }
            bb = llvm::LLVMGetNextBasicBlock(bb);
        }
    }

    /// Report that body codegen left a function in an invalid state, then
    /// strip its blocks.  Use this instead of calling `strip_function_body`
    /// directly so the failure surfaces as a `file:line` diagnostic
    /// rather than a silent dropped body that only reveals itself as an
    /// `undefined reference` at link time.
    ///
    /// `pretty_name` should be a human-readable identifier (e.g. the
    /// source-level qualified name like `Foo::bar` for a method, or the
    /// bare function name for a free function).  `span` should point at
    /// the offending declaration.  Both are best-effort; even with
    /// `SourceSpan::empty()` we still report the LLVM mangled name.
    report_invalid_function_body(mut &this, fn_val: LValue,
                                 pretty_name: string,
                                 span: SourceSpan) -> void {
        if (!fn_val.is_valid()) { return; }
        mut total: i32 = 0;
        mut bad:   i32 = 0;
        this.count_unterminated_blocks(fn_val, &total, &bad);
        const llvm_name: string = llvm::LLVMGetValueName(fn_val.raw) as string;
        const llvm_name_safe: string = if (llvm_name == null) { "<unnamed>" } else { llvm_name };
        const msg: string = format(
            "codegen: function '%s' (LLVM '%s') left %d of %d basic block(s) unterminated; body discarded (this is a codegen bug, please report it)",
            pretty_name, llvm_name_safe, bad, total);
        this.emit_error_at_span(ErrorCode::E0633_FUNCTION_BODY_ERROR, msg, span);
        this.strip_function_body(fn_val);
    }

    // ========================================================================
    // Scope management
    // ========================================================================

    /// Push a new scope level.  Records the current undo log length so
    /// pop_scope() knows how far to roll back.
    push_scope(mut &this) -> void {
        this.scope_marks.push(this.undo.length);
    }

    /// Pop the current scope.  Restores all named value bindings to their
    /// state at the matching push_scope().
    pop_scope(mut &this) -> void {
        if (this.scope_marks.length == 0) {
            return;
        }

        const mark: i64 = this.scope_marks[this.scope_marks.length - 1];
        this.scope_marks.pop();

        // Roll back undo log entries from mark to end.
        for (mut i: i64 = this.undo.length - 1; i >= mark; i--) {
            const key: u32 = this.undo[i].first;
            const prev: void* = this.undo[i].second;

            if (prev == null) {
                // This was a new binding; remove it.
                this.remove_named_value(key);
            } else {
                // Restore previous value.
                this.set_named_value_raw(key, prev);
            }
        }

        // Truncate undo log.
        while (this.undo.length > mark) { this.undo.pop(); }
    }


    // ========================================================================
    // Named value access (locals / parameters)
    // ========================================================================

    /// Set a named value in the current scope.  Records the previous
    /// binding (if any) in the undo log for rollback on pop_scope().
    set_named_value(mut &this, name: SymbolStr, val: LValue) -> void {
        const key: u32 = name.id;

        // Record undo entry: find existing binding.
        const existing: void* = this.get_named_value_raw(key);
        this.undo.push(Pair::new(key, existing));

        // Set or update the binding.
        this.set_named_value_raw(key, val.raw);
    }

    /// Look up a named value.  Returns null LValue if not found.
    get_named_value(&this, name: SymbolStr) -> LValue {
        const raw: void* = this.get_named_value_raw(name.id);
        return LValue { raw: raw };
    }


    // ========================================================================
    // Function map
    // ========================================================================

    /// Register a function by name.
    register_function(mut &this, name: SymbolStr, val: LValue) -> void {
        const key: u32 = name.id;
        // Update existing or append.
        for (mut i: i64 = 0; i < this.funcs.length; i++) {
            if (this.funcs[i].first == key) {
                this.funcs[i].second = val.raw;
                return;
            }
        }
        this.funcs.push(Pair::new(key, val.raw));
    }

    /// Register a function against a (name, user-arg-count) composite key so
    /// overloaded methods (e.g., `Array::new()` vs `Array::new(u64)`) stay
    /// distinct.  The regular `register_function` still records the last-
    /// seen overload for callers that don't disambiguate by arity.
    register_function_with_arity(mut &this, name: SymbolStr, arity: u32, val: LValue) -> void {
        const key: u32 = name.id;
        for (mut i: i64 = 0; i < this.func_overload_keys.length; i++) {
            if (this.func_overload_keys[i] == key && this.func_overload_arities[i] == arity) {
                this.func_overload_values[i] = val.raw;
                return;
            }
        }
        this.func_overload_keys.push(key);
        this.func_overload_arities.push(arity);
        this.func_overload_values.push(val.raw);
    }

    /// Look up a function by name.
    get_function(&this, name: SymbolStr) -> LValue {
        const key: u32 = name.id;
        for (mut i: i64 = 0; i < this.funcs.length; i++) {
            if (this.funcs[i].first == key) {
                return LValue { raw: this.funcs[i].second };
            }
        }
        return LValue::null();
    }

    /// Look up an overloaded function by (name, user-arg-count).  Returns
    /// null if no matching overload is registered; callers should fall back
    /// to `get_function` for code paths that weren't arity-annotated.
    get_function_with_arity(&this, name: SymbolStr, arity: u32) -> LValue {
        const key: u32 = name.id;
        for (mut i: i64 = 0; i < this.func_overload_keys.length; i++) {
            if (this.func_overload_keys[i] == key && this.func_overload_arities[i] == arity) {
                return LValue { raw: this.func_overload_values[i] };
            }
        }
        return LValue::null();
    }


    // ========================================================================
    // Global map
    // ========================================================================

    register_global(mut &this, name: SymbolStr, val: LValue) -> void {
        const key: u32 = name.id;
        for (mut i: i64 = 0; i < this.globals.length; i++) {
            if (this.globals[i].first == key) {
                this.globals[i].second = val.raw;
                return;
            }
        }
        this.globals.push(Pair::new(key, val.raw));
    }

    get_global(&this, name: SymbolStr) -> LValue {
        const key: u32 = name.id;
        for (mut i: i64 = 0; i < this.globals.length; i++) {
            if (this.globals[i].first == key) {
                return LValue { raw: this.globals[i].second };
            }
        }
        return LValue::null();
    }


    // ========================================================================
    // String literal dedup
    // ========================================================================

    /// Get or create a global string constant.  Deduplicates identical strings.
    get_or_create_string_literal(mut &this, text: string) -> LValue {
        // Check dedup cache.
        for (mut i: i64 = 0; i < this.str_lits.length; i++) {
            if (this.str_lits[i].first == text) {
                return LValue { raw: this.str_lits[i].second };
            }
        }

        // Create a new global string.
        const name: string = format(".str.%d", this.str_lits.length);
        const val: LValue = this.builder.build_global_string_ptr(text, name);

        this.str_lits.push(Pair::new(text, val.raw));

        return val;
    }


    // ========================================================================
    // Loop target stack
    // ========================================================================

    push_loop(mut &this, break_bb: LBasicBlock, continue_bb: LBasicBlock) -> void {
        this.break_targets.push(break_bb.raw);
        this.continue_targets.push(continue_bb.raw);
    }

    pop_loop(mut &this) -> void {
        if (this.break_targets.length > 0) {
            this.break_targets.pop();
            this.continue_targets.pop();
        }
    }

    current_break_target(&this) -> LBasicBlock {
        if (this.break_targets.length == 0) {
            return LBasicBlock::null();
        }
        return LBasicBlock { raw: this.break_targets[this.break_targets.length - 1] };
    }

    current_continue_target(&this) -> LBasicBlock {
        if (this.continue_targets.length == 0) {
            return LBasicBlock::null();
        }
        return LBasicBlock { raw: this.continue_targets[this.continue_targets.length - 1] };
    }


    // ========================================================================
    // Utility: entry block alloca
    // ========================================================================

    /// Create an alloca in the entry block of the given function.
    /// This ensures allocas are hoisted to the entry block for mem2reg
    /// promotion by LLVM's optimization passes.
    create_entry_alloca(mut &this, func: LValue, name: string, ty: LType) -> LValue {
        if (!func.is_valid()) {
            return LValue::null();
        }
        if (!ty.is_valid()) {
            return LValue::null();
        }

        // Void is unsized; LLVMBuildAlloca crashes in DataLayout::getPrefTypeAlign.
        // Use LLVMGetTypeKind to detect it instead of `lhs_ty_raw == rhs_ty_raw`:
        // `==` on `void*` has historically lowered to strcmp, which would read
        // from the LLVM type objects as if they were C strings.
        if (type_kind_of(ty.raw) == LTypeKind::Void) {
            return LValue::null();
        }

        // Save current insert point.
        const saved_block: LBasicBlock = this.builder.get_insert_block();

        // Position at the start of the entry block.
        const entry: LBasicBlock = LBasicBlock { raw: llvm::LLVMGetEntryBasicBlock(func.raw) };
        if (!entry.is_valid()) {
            return LValue::null();
        }
        // If the entry block already has a terminator (e.g., the function
        // body has emitted a `br`/`ret`), `position_at_end(entry)` would
        // insert AFTER that terminator, breaking the block.  Position
        // BEFORE the terminator in that case so every alloca lands in a
        // well-formed entry block regardless of when the helper is called.
        const term: void* = llvm::LLVMGetBasicBlockTerminator(entry.raw);
        if (term != null) {
            llvm::LLVMPositionBuilderBefore(this.builder.raw, term);
        } else {
            this.builder.position_at_end(entry);
        }

        const alloca: LValue = this.builder.build_alloca(ty, name);

        // Restore insert point.
        if (saved_block.is_valid()) {
            this.builder.position_at_end(saved_block);
        }

        return alloca;
    }


    // ========================================================================
    // Cleanup
    // ========================================================================

    /// Dispose LLVM resources.  Call only when the LLVM module has been
    /// transferred to artifacts (don't dispose the module if it's still owned).
    dispose_builder(mut &this) -> void {
        this.builder.dispose();
    }


    // ========================================================================
    // Internal helpers
    // ========================================================================

    get_named_value_raw(&this, key: u32) -> void* {
        for (mut i: i64 = 0; i < this.named.length; i++) {
            if (this.named[i].first == key) {
                return this.named[i].second;
            }
        }
        return null;
    }

    set_named_value_raw(mut &this, key: u32, val: void*) -> void {
        for (mut i: i64 = 0; i < this.named.length; i++) {
            if (this.named[i].first == key) {
                this.named[i].second = val;
                return;
            }
        }
        this.named.push(Pair::new(key, val));
    }

    remove_named_value(mut &this, key: u32) -> void {
        for (mut i: i64 = 0; i < this.named.length; i++) {
            if (this.named[i].first == key) {
                // Swap with last and pop.
                const last: i64 = this.named.length - 1;
                if (i < last) {
                    this.named[i] = this.named[last];
                }
                this.named.pop();
                return;
            }
        }
    }

    // ========================================================================
    // IR-building primitives.  Each emits LLVM IR for a primitive operation
    // and assumes the caller has prepared any inputs (resolved AST nodes,
    // computed LValues etc.).  These are the surface a visit() override
    // reaches for after extracting what it needs from the AST.
    // ========================================================================

    codegen_break(mut &this) -> void {
        const target: LBasicBlock = this.current_break_target();
        if (target.is_valid()) {
            this.builder.build_br(target);
        }
    }

    codegen_continue(mut &this) -> void {
        const target: LBasicBlock = this.current_continue_target();
        if (target.is_valid()) {
            this.builder.build_br(target);
        }
    }

    /// Branch to a target block if the current block has no terminator.
    branch_if_not_terminated(mut &this, target: LBasicBlock) -> void {
        const current: LBasicBlock = this.builder.get_insert_block();
        if (current.is_valid() && !current.has_terminator()) {
            this.builder.build_br(target);
        }
    }

    /// Generate IR for an if/else statement.
    /// Creates then_bb, else_bb (if needed), and merge_bb.
    codegen_if(mut &this, cond: LValue,
               current_fn: LValue,
               has_else: boolean) -> IfBlocks {
        const then_bb: LBasicBlock = LBasicBlock::append(current_fn, "then");
        const else_bb: LBasicBlock = if (has_else) {
            LBasicBlock::append(current_fn, "else")
        } else {
            LBasicBlock::null()
        };
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "ifcont");

        if (has_else) {
            this.builder.build_cond_br(cond, then_bb, else_bb);
        } else {
            this.builder.build_cond_br(cond, then_bb, merge_bb);
        }

        return IfBlocks {
            then_bb:  then_bb,
            else_bb:  else_bb,
            merge_bb: merge_bb,
        };
    }

    /// Create the basic blocks for a while loop.
    codegen_while_header(mut &this, current_fn: LValue) -> LoopBlocks {
        const cond_bb: LBasicBlock = LBasicBlock::append(current_fn, "while.cond");
        const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "while.body");
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "while.end");

        this.builder.build_br(cond_bb);
        this.push_loop(merge_bb, cond_bb);

        return LoopBlocks {
            cond_bb:  cond_bb,
            body_bb:  body_bb,
            merge_bb: merge_bb,
        };
    }

    /// Create basic blocks for a for loop: init -> cond -> body -> update -> cond.
    codegen_for_header(mut &this, current_fn: LValue) -> ForBlocks {
        const cond_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.cond");
        const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.body");
        const update_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.update");
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.end");

        this.push_loop(merge_bb, update_bb);

        return ForBlocks {
            cond_bb:   cond_bb,
            body_bb:   body_bb,
            update_bb: update_bb,
            merge_bb:  merge_bb,
        };
    }

    /// Create basic blocks for a `loop { ... }` infinite loop.
    codegen_loop_header(mut &this, current_fn: LValue) -> LoopBlocks {
        const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "loop.body");
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "loop.end");

        this.builder.build_br(body_bb);
        this.push_loop(merge_bb, body_bb);

        return LoopBlocks {
            cond_bb:  LBasicBlock::null(),
            body_bb:  body_bb,
            merge_bb: merge_bb,
        };
    }

    /// Reshape an icmp RHS to match the LHS width when the subject is a
    /// narrower integer than the pattern value.
    coerce_icmp_operands(mut &this, lhs: LValue, rhs: LValue,
                         subj_ty: TypeRef) -> LValue {
        if (!lhs.is_valid() || !rhs.is_valid()) { return rhs; }
        const lhs_ty_raw: void* = llvm::LLVMTypeOf(lhs.raw);
        const rhs_ty_raw: void* = llvm::LLVMTypeOf(rhs.raw);
        if (type_kind_of(lhs_ty_raw) != LTypeKind::Integer) { return rhs; }
        if (type_kind_of(rhs_ty_raw) != LTypeKind::Integer) { return rhs; }
        const lhs_bits: u32 = llvm::LLVMGetIntTypeWidth(lhs_ty_raw);
        const rhs_bits: u32 = llvm::LLVMGetIntTypeWidth(rhs_ty_raw);
        if (lhs_bits == rhs_bits) { return rhs; }
        const lhs_ty: LType = LType { raw: lhs_ty_raw };
        if (rhs_bits > lhs_bits) {
            return this.builder.build_trunc(rhs, lhs_ty, "match.coerce.trunc");
        }
        if (this.int_type_is_signed(subj_ty)) {
            return this.builder.build_sext(rhs, lhs_ty, "match.coerce.sext");
        }
        return this.builder.build_zext(rhs, lhs_ty, "match.coerce.zext");
    }

    // ========================================================================
    // Function/global resolution.  Each resolver looks up a name in this
    // module's LLVM cache; on a miss it declares a cross-module extern from
    // DeclarationIndex and returns the freshly-cached LValue.  Calls
    // bottom-out at the lazy-extern factories below.
    // ========================================================================

    /// Build an LLVM function type from a Cryo `FunctionType*`.  Returns
    /// `LType::null()` if any parameter or the return type fails to map.
    build_function_ltype(mut &this, ft: FunctionType*) -> LType {
        const ret_ty: LType = this.type_mapper.map_type(ft.return_type);
        if (!ret_ty.is_valid()) { return LType::null(); }

        const param_count: u32 = ft.param_types.length as u32;
        if (param_count == 0) {
            return LType::function_type(ret_ty, null, 0, ft.is_variadic);
        }

        const buf: void* = malloc(param_count as u64 * 8);
        const slots: void** = buf as void**;
        mut valid: boolean = true;
        for (mut j: u32 = 0; j < param_count; j++) {
            const mapped: LType = this.type_mapper.map_type(ft.param_types[j]);
            if (!mapped.is_valid()) { valid = false; break; }
            slots[j] = mapped.raw;
        }
        mut result: LType = LType::null();
        if (valid) {
            result = LType::function_type(ret_ty, buf, param_count, ft.is_variadic);
        }
        free(buf);
        return result;
    }

    /// Declare an extern function for a single (name, func_type_ref) pair, and
    /// register it under both the bare name and the (name, arity) composite key.
    /// If an LLVM symbol with the same mangled name already exists in this
    /// module, reuse it.  Returns the LValue on success, null otherwise.
    declare_extern_function_overload(mut &this, fn_name: SymbolStr,
                                     func_type_ref: TypeRef) -> LValue {
        const arena: TypeArena* = this.get_arena();
        const ft_ptr: Type* = arena.lookup(func_type_ref.id);
        if (ft_ptr == null || ft_ptr.kind != TypeKind::Function) { return LValue::null(); }
        const ft: FunctionType* = ft_ptr as FunctionType*;

        const fn_type: LType = this.build_function_ltype(ft);
        if (!fn_type.is_valid()) { return LValue::null(); }

        const intern: InternTable* = this.ctx.intern_table;
        const di: DeclarationIndex* = this.ctx.decl_index;

        // Prefer the overload-specific mangled name registered for this exact
        // (fn_name, func_type_ref) pair.  Fall back to the single-slot alias
        // only when no overload entry exists.
        mut mangled_sym: SymbolStr = di.lookup_overload_mangled(fn_name, func_type_ref);
        if (!mangled_sym.is_valid()) {
            mangled_sym = di.lookup_mangled_name(fn_name);
        }
        if (!mangled_sym.is_valid()) {
            const ext_qname: QualifiedName = QualifiedName::from_symbol(fn_name);
            mangled_sym = MangledName::for_free_function(
                intern, this.get_arena(), ext_qname, ft.param_types,
                ft.return_type, ft.is_variadic).value;
        }
        const ir_name: string = intern.resolve(mangled_sym);

        mut fn_val: LValue = this.llvm_module.get_named_function(ir_name);
        if (!fn_val.is_valid()) {
            fn_val = this.llvm_module.add_function(ir_name, fn_type);
        }
        this.register_function(fn_name, fn_val);
        this.register_function_with_arity(fn_name, ft.param_types.length as u32, fn_val);
        return fn_val;
    }

    /// Return-type-only fallback: declare a no-arg function for names that
    /// have no full signature in DeclarationIndex but do have a return type.
    declare_extern_function_return_only(mut &this, fn_name: SymbolStr) -> LValue {
        const intern: InternTable* = this.ctx.intern_table;
        const di: DeclarationIndex* = this.ctx.decl_index;
        const ret_ref: TypeRef = di.lookup_func_return(fn_name);
        if (ret_ref.is_invalid()) { return LValue::null(); }

        const ret_ty: LType = this.type_mapper.map_type(ret_ref);
        if (!ret_ty.is_valid()) { return LValue::null(); }

        const fn_type: LType = LType::function_type(ret_ty, null, 0, false);
        mut fb_mangled: SymbolStr = di.lookup_mangled_name(fn_name);
        if (!fb_mangled.is_valid()) {
            const fb_qname: QualifiedName = QualifiedName::from_symbol(fn_name);
            const empty_params: TypeRef[] = [];
            fb_mangled = MangledName::for_free_function(
                intern, this.get_arena(), fb_qname, empty_params, ret_ref, false).value;
        }
        const ir_name: string = intern.resolve(fb_mangled);
        mut fn_val: LValue = this.llvm_module.get_named_function(ir_name);
        if (!fn_val.is_valid()) {
            fn_val = this.llvm_module.add_function(ir_name, fn_type);
        }
        this.register_function(fn_name, fn_val);
        return fn_val;
    }

    /// Returns true iff `name` is defined in the module currently being
    /// compiled.  Used by the resolve_* helpers to avoid turning a stale local
    /// lookup into a stub extern declaration (which would leave the would-be
    /// body without a terminator; the callers rely on declare_functions /
    /// declare_method having registered the handle before body codegen runs).
    owned_by_current_module(&this, mod_sym: SymbolStr) -> boolean {
        if (!mod_sym.is_valid()) { return false; }
        const current: SymbolStr = this.ctx.intern_table.intern(this.ctx.source_file);
        return mod_sym.equals(current);
    }

    /// Look up a function by name, declaring a cross-module extern on demand
    /// when this module hasn't seen it yet.  Returns null when the name is
    /// unknown to the DeclarationIndex OR when the symbol is owned by the
    /// current module (the caller should be using the value that declare_* put
    /// in the map, not a freshly declared extern that would clobber the body).
    resolve_function(mut &this, name: SymbolStr) -> LValue {
        const cached: LValue = this.get_function(name);
        if (cached.is_valid()) { return cached; }

        const di: DeclarationIndex* = this.ctx.decl_index;
        if (this.owned_by_current_module(di.get_function_module(name))) {
            return LValue::null();
        }

        const arena: TypeArena* = this.get_arena();
        const overloads: TypeRef[] = di.lookup_func_type_overloads(name);
        // Two-pass declaration: prefer concrete overloads (no GenericParam
        // anywhere in the signature) over template entries left in DI by
        // sema-time registration of generic methods.  Without this, the
        // template's `Reference(GenericParam)`-typed signature is the first
        // overload to succeed (build_function_ltype lowers `Reference(_)` to
        // opaque `ptr` regardless), so the cross-module extern gets declared
        // under the template's `1H`-placeholder mangled name and the call
        // site never links to the spec.  Pass 1: concrete overloads.  Pass
        // 2: any remaining (template) overloads, only as a fallback when
        // no concrete overload was registered for the name.
        mut first: LValue = LValue::null();
        for (mut i: i64 = 0; i < overloads.length; i++) {
            const ft_ptr: Type* = arena.lookup(overloads[i].id);
            if (ft_ptr == null || ft_ptr.kind != TypeKind::Function) { continue; }
            const ft: FunctionType* = ft_ptr as FunctionType*;
            if (function_type_has_generic_params(arena, ft)) { continue; }
            const v: LValue = this.declare_extern_function_overload(name, overloads[i]);
            if (!first.is_valid() && v.is_valid()) { first = v; }
        }
        if (!first.is_valid()) {
            for (mut i: i64 = 0; i < overloads.length; i++) {
                const v: LValue = this.declare_extern_function_overload(name, overloads[i]);
                if (!first.is_valid() && v.is_valid()) { first = v; }
            }
        }
        if (first.is_valid()) { return first; }

        return this.declare_extern_function_return_only(name);
    }

    /// Resolve a function from a sema-pinned symbol.  See the original
    /// docstring on the free `resolve_function_by_mangled` for the lookup
    /// order; the logic is identical.
    resolve_function_by_mangled(mut &this, pinned: SymbolStr) -> LValue {
        if (!pinned.is_valid()) { return LValue::null(); }

        const intern: InternTable* = this.get_intern();
        const pinned_str: string = intern.resolve(pinned);
        mut v: LValue = this.llvm_module.get_named_function(pinned_str);
        if (v.is_valid()) { return v; }

        const di: DeclarationIndex* = this.ctx.decl_index;
        for (mut i: i64 = 0; i < di.overload_func_keys.length; i++) {
            if (di.overload_func_mangled[i] != pinned.id) { continue; }
            const qual: SymbolStr = SymbolStr::from_id(di.overload_func_keys[i]);
            if (this.owned_by_current_module(di.get_function_module(qual))) {
                return LValue::null();
            }
            v = this.declare_extern_function_overload(qual, di.overload_func_types[i]);
            if (v.is_valid()) { return v; }
        }

        return this.resolve_function(pinned);
    }

    /// Look up an overloaded function by (name, user-arg-count), declaring a
    /// cross-module extern on demand.
    resolve_function_with_arity(mut &this, name: SymbolStr,
                                arity: u32) -> LValue {
        const cached: LValue = this.get_function_with_arity(name, arity);
        if (cached.is_valid()) { return cached; }

        const di: DeclarationIndex* = this.ctx.decl_index;
        if (this.owned_by_current_module(di.get_function_module(name))) {
            return LValue::null();
        }

        const arena: TypeArena* = this.get_arena();
        const overloads: TypeRef[] = di.lookup_func_type_overloads(name);
        // Two-pass: concrete overloads first, then templates as fallback.
        // See `resolve_function` for the rationale.
        for (mut i: i64 = 0; i < overloads.length; i++) {
            const ft_ptr: Type* = arena.lookup(overloads[i].id);
            if (ft_ptr == null || ft_ptr.kind != TypeKind::Function) { continue; }
            const ft: FunctionType* = ft_ptr as FunctionType*;
            if (ft.param_types.length as u32 != arity) { continue; }
            if (function_type_has_generic_params(arena, ft)) { continue; }
            const v: LValue = this.declare_extern_function_overload(name, overloads[i]);
            if (v.is_valid()) { return v; }
        }
        for (mut i: i64 = 0; i < overloads.length; i++) {
            const ft_ptr: Type* = arena.lookup(overloads[i].id);
            if (ft_ptr == null || ft_ptr.kind != TypeKind::Function) { continue; }
            const ft: FunctionType* = ft_ptr as FunctionType*;
            if (ft.param_types.length as u32 != arity) { continue; }
            const v: LValue = this.declare_extern_function_overload(name, overloads[i]);
            if (v.is_valid()) { return v; }
        }
        return LValue::null();
    }

    /// Look up a global by name, declaring a cross-module extern on demand.
    resolve_global(mut &this, name: SymbolStr) -> LValue {
        const cached: LValue = this.get_global(name);
        if (cached.is_valid()) { return cached; }

        const intern: InternTable* = this.ctx.intern_table;
        const di: DeclarationIndex* = this.ctx.decl_index;
        if (this.owned_by_current_module(di.get_global_module(name))) {
            return LValue::null();
        }

        const g_type_ref: TypeRef = di.lookup_global(name);
        if (g_type_ref.is_invalid()) { return LValue::null(); }

        const g_llvm_ty: LType = this.type_mapper.map_type(g_type_ref);
        if (!g_llvm_ty.is_valid()) { return LValue::null(); }

        // Mirror codegen_global_var's mangle: pull the defining namespace out of
        // DI so the extern decl in this module refers to the same LLVM symbol
        // the defining module emits.  Empty namespace → bare `C$<name>` (root-
        // namespace globals).
        const def_ns: SymbolStr = di.get_global_namespace(name);
        const mangled: string = MangledName::for_global(intern, def_ns, name).resolve(intern);

        // Reuse an existing LLVM global if something (e.g. a prior pass) already
        // created one with the same mangled name; identical-name externs share
        // the same symbol at link time.
        mut g_val: LValue = this.llvm_module.get_named_global(mangled);
        if (!g_val.is_valid()) {
            g_val = this.llvm_module.add_global(g_llvm_ty, mangled);
        }
        this.register_global(name, g_val);
        return g_val;
    }

    codegen_sizeof(mut &this, type_ref: TypeRef) -> LValue {
        const t: Type* = this.lookup_type_by_id(type_ref.id);
        if (t != null) {
            const cryo_size: u64 = t.size_bytes();
            if (cryo_size > 0) {
                return LType::const_int(LType::i64(), cryo_size, false);
            }
            // size_bytes() returned 0; typically because TypeLowering hasn't
            // computed the layout for this Type (common for InstantiatedType
            // wrappers like `HashMapEntry<K, V>` that route through a resolved
            // StructType but the wrapper's computed_size never gets propagated).
            // Fall back to LLVM's authoritative size: `LLVMSizeOf` returns a
            // ConstantExpr with the data-layout-correct byte count, which is
            // exactly what `calloc(N, sizeof(T))` needs.
            const lty: LType = this.type_mapper.map_type(type_ref);
            if (lty.is_valid()) {
                return LValue { raw: llvm::LLVMSizeOf(lty.raw) };
            }
        }
        return LType::const_int(LType::i64(), 0, false);
    }

    codegen_alignof(mut &this, type_ref: TypeRef) -> LValue {
        const t: Type* = this.lookup_type_by_id(type_ref.id);
        if (t != null) {
            const cryo_align: u64 = t.alignment();
            if (cryo_align > 0) {
                return LType::const_int(LType::i64(), cryo_align, false);
            }
            // alignment() returned 0; TypeLowering didn't compute a layout
            // for this Type (typically InstantiatedType wrappers like
            // `Array<T>` whose computed_align never gets propagated through
            // the spec'd struct).  Fall back to LLVM's authoritative
            // alignment via `LLVMAlignOf`.  Without this fallback,
            // `Layout::array<T>` returned `Layout { size, alignment: 0 }`,
            // and `GlobalAlloc::reallocate` either failed an alignment
            // assertion or fell into a misaligned-realloc path that crashed.
            const lty: LType = this.type_mapper.map_type(type_ref);
            if (lty.is_valid()) {
                return LValue { raw: llvm::LLVMAlignOf(lty.raw) };
            }
        }
        return LType::const_int(LType::i64(), 0, false);
    }

    codegen_cast(mut &this, val: LValue,
                 from_type: TypeRef, to_type: TypeRef) -> LValue {
        const src_type: Type* = this.lookup_type_by_id(from_type.id);
        const dst_type: Type* = this.lookup_type_by_id(to_type.id);
        if (src_type == null || dst_type == null) {
            return val;
        }

        const dest_ty: LType = this.type_mapper.map_type(to_type);

        const from_kind: TypeKind = src_type.kind;
        const to_kind: TypeKind = dst_type.kind;
        // Treat Char and Bool as integer-like for cast purposes; both are
        // integer types at the LLVM level (i32 and i1 respectively).  Without
        // including Char here, casts like `s[i] as u64` (where `s[i]: char`)
        // fall through to the bitcast fallback and LLVM rejects
        // `bitcast i32 to i64` (bitcast requires same-size operands).
        const from_int: boolean = from_kind == TypeKind::Int || from_kind == TypeKind::Char;
        const from_float: boolean = from_kind == TypeKind::Float;
        const to_int: boolean = to_kind == TypeKind::Int || to_kind == TypeKind::Char;
        const to_float: boolean = to_kind == TypeKind::Float;
        // Treat `String` as a pointer type for cast classification; strings
        // are `i8*` at the LLVM level, so `string as i64` is semantically a
        // ptrtoint (not a bitcast, which requires same-size operands and
        // LLVM rejects for pointer ↔ integer).  Same for `i64 as string`
        // (inttoptr) and `string ↔ some_other_pointer` (pointer_cast / no-op
        // under opaque pointers).
        const from_ptr: boolean = from_kind == TypeKind::Pointer ||
                                  from_kind == TypeKind::Reference ||
                                  from_kind == TypeKind::String;
        const to_ptr: boolean = to_kind == TypeKind::Pointer ||
                                to_kind == TypeKind::Reference ||
                                to_kind == TypeKind::String;

        if (from_int && to_int) {
            mut from_bits: u32 = 0;
            mut signed_src: boolean = false;
            if (from_kind == TypeKind::Int) {
                const from_it: IntType* = src_type as IntType*;
                from_bits = from_it.int_kind.bit_width() as u32;
                signed_src = from_it.int_kind.is_signed();
            } else if (from_kind == TypeKind::Char) {
                from_bits = 32;
                signed_src = false;
            }
            mut to_bits: u32 = 0;
            if (to_kind == TypeKind::Int) {
                const to_it: IntType* = dst_type as IntType*;
                to_bits = to_it.int_kind.bit_width() as u32;
            } else if (to_kind == TypeKind::Char) {
                to_bits = 32;
            }
            if (from_bits == 0 || to_bits == 0 || !val.is_valid()) {
                return val;
            } else if (from_bits > to_bits) {
                return this.builder.build_trunc(val, dest_ty, "trunctmp");
            } else if (from_bits < to_bits) {
                if (signed_src) {
                    return this.builder.build_sext(val, dest_ty, "sexttmp");
                } else {
                    return this.builder.build_zext(val, dest_ty, "zexttmp");
                }
            } else {
                return val;  // Same width, no-op.
            }
        } else if (from_float && to_float) {
            const from_ft: FloatType* = src_type as FloatType*;
            const to_ft: FloatType* = dst_type as FloatType*;
            const from_fk: FloatKind = from_ft.float_kind;
            const to_fk: FloatKind = to_ft.float_kind;
            const from_bits: u64 = from_fk.bit_width();
            const to_bits: u64 = to_fk.bit_width();
            if (from_bits > to_bits) {
                return this.builder.build_fp_trunc(val, dest_ty, "fptrunctmp");
            } else if (from_bits < to_bits) {
                return this.builder.build_fp_ext(val, dest_ty, "fpexttmp");
            } else {
                return val;
            }
        } else if (from_int && to_float) {
            const from_it2: IntType* = src_type as IntType*;
            const from_ik2: IntegerKind = from_it2.int_kind;
            if (from_ik2.is_signed()) {
                return this.builder.build_si_to_fp(val, dest_ty, "sitofptmp");
            } else {
                return this.builder.build_ui_to_fp(val, dest_ty, "uitofptmp");
            }
        } else if (from_float && to_int) {
            const to_it2: IntType* = dst_type as IntType*;
            const to_ik2: IntegerKind = to_it2.int_kind;
            if (to_ik2.is_signed()) {
                return this.builder.build_fp_to_si(val, dest_ty, "fptositmp");
            } else {
                return this.builder.build_fp_to_ui(val, dest_ty, "fptouitmp");
            }
        } else if (from_ptr && to_ptr) {
            return this.builder.build_pointer_cast(val, dest_ty, "ptrcasttmp");
        } else if (from_int && to_ptr) {
            return this.builder.build_int_to_ptr(val, dest_ty, "inttoptr");
        } else if (from_ptr && to_int) {
            return this.builder.build_ptr_to_int(val, dest_ty, "ptrtoint");
        } else if (from_kind == TypeKind::Bool && to_int) {
            return this.builder.build_zext(val, dest_ty, "booltoint");
        } else {
            return this.builder.build_bitcast(val, dest_ty, "bitcasttmp");
        }
    }

    /// Compare two i8* string values using strcmp.
    /// Returns i1: true if equal (==) or not equal (!=).
    codegen_string_compare(mut &this, lhs: LValue, rhs: LValue,
                           op_kind: TokenType) -> LValue {
        // `string == null` / `string != null` must NOT call strcmp; strcmp
        // dereferences both operands, so passing a null operand is undefined
        // behaviour (typically a segfault).  Detect the null-literal case and
        // lower it as a pointer-equality icmp instead.  LLVMIsNull returns 1
        // for the constant null pointer.
        const lhs_is_null: i32 = llvm::LLVMIsNull(lhs.raw);
        const rhs_is_null: i32 = llvm::LLVMIsNull(rhs.raw);
        if (lhs_is_null != 0 || rhs_is_null != 0) {
            const pred: LIntPredicate = if (op_kind == TokenType::EqualEqual) { LIntPredicate::EQ } else { LIntPredicate::NE };
            return this.builder.build_icmp(pred, lhs, rhs, "strnullcmp");
        }

        // Ensure strcmp is declared: i32 strcmp(i8*, i8*)
        const intern: InternTable* = this.get_intern();
        const strcmp_name: string = "strcmp";
        const strcmp_sym: SymbolStr = intern.intern(strcmp_name);
        mut strcmp_fn: LValue = this.resolve_function(strcmp_sym);
        if (!strcmp_fn.is_valid()) {
            const i8_ptr: LType = LType::pointer_to(LType::i8());
            const param_buf: void* = intrinsics::malloc(16);
            const params: void** = param_buf as void**;
            params[0] = i8_ptr.raw;
            params[1] = i8_ptr.raw;
            const strcmp_ty: LType = LType::function_type(LType::i32(), param_buf, 2, false);
            intrinsics::free(param_buf);
            strcmp_fn = this.llvm_module.add_function(strcmp_name, strcmp_ty);
            this.register_function(strcmp_sym, strcmp_fn);
        }

        const strcmp_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(strcmp_fn.raw) };
        const arg_buf: void* = intrinsics::malloc(16);
        const args: void** = arg_buf as void**;
        args[0] = lhs.raw;
        args[1] = rhs.raw;
        const cmp_result: LValue = this.builder.build_call(strcmp_ty, strcmp_fn, arg_buf, 2, "strcmp");
        intrinsics::free(arg_buf);

        const zero: LValue = LType::const_int(LType::i32(), 0, false);
        if (op_kind == TokenType::EqualEqual) {
            return this.builder.build_icmp(LIntPredicate::EQ, cmp_result, zero, "streq");
        } else {
            return this.builder.build_icmp(LIntPredicate::NE, cmp_result, zero, "strne");
        }
    }

    /// Generate IR for a local variable declaration.
    /// `site_span` is the source span of the variable's declaration node; used
    /// for diagnostics when the insert block or parent function are unexpectedly
    /// null (both indicate a codegen-ordering bug, so we point the user at the
    /// declaration that tripped the check).
    codegen_local_var(mut &this, name: SymbolStr,
                      ty: TypeRef, init_val: LValue,
                      has_init: boolean,
                      site_span: SourceSpan) -> void {
        const var_name: string = this.resolve(name);
        const llvm_ty: LType = this.type_mapper.map_type(ty);
        if (!llvm_ty.is_valid()) {
            return;
        }

        // Void is unsized; LLVMBuildAlloca crashes in DataLayout::getAlignment.
        if (type_kind_of(llvm_ty.raw) == LTypeKind::Void) {
            return;
        }

        const current_bb: LBasicBlock = this.builder.get_insert_block();
        if (!current_bb.is_valid()) {
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0607_VARIABLE_GENERATION_ERROR,
                format("codegen: local variable '%s': builder has no insert block", var_name));
            diag = diag.at(site_span);
            diag = diag.with_note("the codegen builder must have an insert block active when a local is declared; this usually means a statement was visited outside of any function body");
            this.emit_diagnostic(diag);
            return;
        }
        const current_fn: LValue = current_bb.get_parent();
        if (!current_fn.is_valid()) {
            this.emit_error_at_span(ErrorCode::E0607_VARIABLE_GENERATION_ERROR,
                format("codegen: local variable '%s': insert block has no parent function", var_name),
                site_span);
            return;
        }

        const alloca: LValue = this.create_entry_alloca(current_fn, var_name, llvm_ty);

        if (has_init && init_val.is_valid()) {
            // Coerce integer literals to the variable's declared width before
            // storing.  `mut i: i64 = 0` arrives with `init_val` as `i32 0`
            // (codegen_literal defaults integer literals to i32 when sema
            // doesn't propagate the expected type) and the i64 alloca is
            // 8 bytes; a direct `store i32` writes only the low 4 bytes,
            // leaving the high 4 uninitialised.  zext/sext to the alloca
            // type so the full slot is written; same idea for the trunc
            // direction (an i64 expression initialising an i32 local).
            mut store_val: LValue = init_val;
            const init_ty_raw: void* = llvm::LLVMTypeOf(init_val.raw);
            if (init_ty_raw != null
                    && type_kind_of(init_ty_raw) == LTypeKind::Integer
                    && type_kind_of(llvm_ty.raw) == LTypeKind::Integer) {
                const want_bits: u32 = llvm::LLVMGetIntTypeWidth(llvm_ty.raw);
                const got_bits:  u32 = llvm::LLVMGetIntTypeWidth(init_ty_raw);
                if (want_bits > got_bits) {
                    // Widen with the variable's signedness; `mut x: i64 = -1`
                    // would otherwise zext the i32 -1 into 0xFFFFFFFF (a huge
                    // positive i64) instead of -1.
                    mut signed_target: boolean = false;
                    const ty_t: Type* = this.lookup_type_by_id(ty.id);
                    if (ty_t != null && ty_t.kind == TypeKind::Int) {
                        const ti: IntType* = ty_t as IntType*;
                        signed_target = ti.int_kind.is_signed();
                    }
                    if (signed_target) {
                        store_val = this.builder.build_sext(init_val, llvm_ty, "init.widen");
                    } else {
                        store_val = this.builder.build_zext(init_val, llvm_ty, "init.widen");
                    }
                } else if (want_bits < got_bits) {
                    store_val = this.builder.build_trunc(init_val, llvm_ty, "init.trunc");
                }
            }
            this.builder.build_store(store_val, alloca);
        }

        this.set_named_value(name, alloca);
    }

    /// Generate IR for a function call.
    /// Coerces integer argument widths to match the callee's LLVM parameter
    /// types (e.g., i8->i32 for memset, i32->i64 for u64 params).
    ///
    /// Each `args[i]` carries the LLVM value (`.first`) and the Cryo-level
    /// type of that arg (`.second`).  The Cryo type drives the sext-vs-zext
    /// choice when the formal param is wider than the supplied value.  Use
    /// `TypeRef::invalid()` for slots where the type isn't known (low-level
    /// callers wiring up malloc/free/abort with already-matched widths);
    /// invalid slots fall back to `zext`.
    codegen_call(mut &this, callee: LValue, callee_type: LType, args: Pair<LValue, TypeRef>[], name: string) -> LValue {
        mut out_value: LValue = LValue::null();
        const n: u32 = args.length as u32;

        if (n == 0) {
            out_value = this.builder.build_call(callee_type, callee, null, 0, name);
            return out_value;
        }

        // Get expected parameter types for argument coercion.
        // callee_type is the function type passed to LLVMBuildCall2.
        // Even though LLVMGetTypeKind may report it as pointer (opaque ptr era),
        // LLVMCountParamTypes still works on function types.
        // Also try LLVMCountParams on the callee value as fallback.
        mut expected_count: u32 = llvm::LLVMCountParamTypes(callee_type.raw);
        mut param_types_buf: void* = null;
        if (expected_count > 0 && expected_count <= 64) {
            param_types_buf = intrinsics::malloc(expected_count as u64 * 8);
            llvm::LLVMGetParamTypes(callee_type.raw, param_types_buf);
        }

        // Build argument array, coercing integer widths where needed.
        const buf: void* = intrinsics::malloc(n as u64 * 8);
        const slots: void** = buf as void**;
        const param_types: void** = param_types_buf as void**;
        for (mut i: u32 = 0; i < n; i++) {
            mut arg_val: LValue = args[i as i64].first;
            const arg_ty_ref: TypeRef = args[i as i64].second;
            if (arg_val.is_valid() && param_types_buf != null && i < expected_count) {
                const expected_ty: void* = param_types[i];
                const actual_ty: void* = llvm::LLVMTypeOf(arg_val.raw);
                // Compare by type kind; void* pointer equality is broken in the
                // Cryo compiler (always returns true), so we cannot rely on
                // expected_ty != actual_ty to detect mismatches.
                const ek: LTypeKind = type_kind_of(expected_ty);
                const ak: LTypeKind = type_kind_of(actual_ty);
                if (ek != ak) {
                    if (ek == LTypeKind::Pointer && ak == LTypeKind::Struct) {
                        // Expected ptr, actual struct: the struct value came from
                        // `codegen_rvalue` loading through some lvalue.  If we can
                        // recover that pre-load address (`val` is a Load whose
                        // only operand is the original pointer), use it directly
                        // that preserves identity so callees that mutate the
                        // struct see the caller's memory.  Otherwise fall back
                        // to a fresh temp alloca + store + addr-of.
                        // LLVMOpcode::Load = 27.
                        mut handled: boolean = false;
                        const opcode: i32 = llvm::LLVMGetInstructionOpcode(arg_val.raw);
                        if (opcode == 27) {
                            const ptr_operand: void* = llvm::LLVMGetOperand(arg_val.raw, 0);
                            if (ptr_operand != null) {
                                arg_val = LValue { raw: ptr_operand };
                                handled = true;
                            }
                        }
                        if (!handled) {
                            const st: LType = LType { raw: actual_ty };
                            const tmp: LValue = this.builder.build_alloca(st, "arg.ref");
                            this.builder.build_store(arg_val, tmp);
                            arg_val = tmp;
                        }
                    } else if (ek == LTypeKind::Struct && ak == LTypeKind::Pointer) {
                        const st: LType = LType { raw: expected_ty };
                        arg_val = this.builder.build_load(st, arg_val, "arg.deref");
                    } else if ((ek == LTypeKind::Float || ek == LTypeKind::Double) && ak == LTypeKind::Pointer) {
                        const ft: LType = LType { raw: expected_ty };
                        arg_val = this.builder.build_load(ft, arg_val, "arg.deref");
                    } else if (ek == LTypeKind::Integer && ak == LTypeKind::Pointer && expected_count > 0 && i == 0) {
                        const it: LType = LType { raw: expected_ty };
                        arg_val = this.builder.build_load(it, arg_val, "arg.deref");
                    } else if (ek == LTypeKind::Pointer && ak == LTypeKind::Integer) {
                        // Expected ptr, actual integer.  For the receiver slot
                        // (i==0) this is a primitive method on an rvalue; spill
                        // to a stack temp and pass the slot's address.  For
                        // non-receiver args keep the legitimate inttoptr.
                        if (i == 0) {
                            const slot_lty: LType = LType { raw: actual_ty };
                            const slot: LValue = this.builder.build_alloca(slot_lty, "recv.slot");
                            this.builder.build_store(arg_val, slot);
                            arg_val = slot;
                        } else {
                            const target: LType = LType { raw: expected_ty };
                            arg_val = LValue { raw: llvm::LLVMBuildIntToPtr(this.builder.raw, arg_val.raw, expected_ty, "arg.i2p") };
                        }
                    } else if (ek == LTypeKind::Integer && ak == LTypeKind::Pointer) {
                        const target: LType = LType { raw: expected_ty };
                        arg_val = LValue { raw: llvm::LLVMBuildPtrToInt(this.builder.raw, arg_val.raw, expected_ty, "arg.p2i") };
                    }
                } else if (ek == LTypeKind::Integer && ak == LTypeKind::Integer) {
                    // Both integers: coerce widths if needed.  Picking sext
                    // vs zext from the *source* Cryo type's signedness is
                    // load-bearing: an i32 holding `-1` (0xFFFFFFFF) widened
                    // to i64 must become 0xFFFFFFFFFFFFFFFF (sext), not
                    // 0x00000000FFFFFFFF (zext).  Defaulting to zext silently
                    // corrupted any negative signed-narrow arg passed to a
                    // wider parameter.
                    const ew: u32 = llvm::LLVMGetIntTypeWidth(expected_ty);
                    const aw: u32 = llvm::LLVMGetIntTypeWidth(actual_ty);
                    if (aw < ew) {
                        const target: LType = LType { raw: expected_ty };
                        mut src_signed: boolean = false;
                        if (arg_ty_ref.is_valid()) {
                            const at_t: Type* = this.lookup_type_by_id(arg_ty_ref.id);
                            if (at_t != null && at_t.kind == TypeKind::Int) {
                                const it: IntType* = at_t as IntType*;
                                src_signed = it.int_kind.is_signed();
                            }
                        }
                        if (src_signed) {
                            arg_val = this.builder.build_sext(arg_val, target, "arg.widen");
                        } else {
                            arg_val = this.builder.build_zext(arg_val, target, "arg.widen");
                        }
                    } else if (aw > ew) {
                        const target: LType = LType { raw: expected_ty };
                        arg_val = this.builder.build_trunc(arg_val, target, "arg.trunc");
                    }
                }
            }
            slots[i] = arg_val.raw;
        }
        if (param_types_buf != null) { intrinsics::free(param_types_buf); }

        out_value = this.builder.build_call(callee_type, callee, buf, n, name);
        intrinsics::free(buf);
        return out_value;
    }

    /// Generate IR for a binary expression.  Handles arithmetic, comparison,
    /// logical short-circuit, and assignment operators.
    codegen_binary(mut &this, lhs_val: LValue, rhs_val: LValue, op_kind: TokenType, result_type: TypeRef) -> LValue {
        mut out_value: LValue = LValue::null();
        if (!lhs_val.is_valid() || !rhs_val.is_valid()) {
            out_value = LValue::null();
            return out_value;
        }
        // Determine if this is integer, float, or pointer arithmetic.
        // Follow InstantiatedType chain to get the concrete type.
        mut t: Type* = this.lookup_type_by_id(result_type.id);
        mut bd: i32 = 0;
        while (t != null && t.kind == TypeKind::InstantiatedType && bd < 5) {
            const binst: InstantiatedType* = t as InstantiatedType*;
            if (binst.has_resolved_type()) {
                t = this.lookup_type_by_id(binst.resolved_type.id);
            } else { break; }
            bd += 1;
        }
        mut t_kind: TypeKind = TypeKind::Error;
        if (t != null) { t_kind = t.kind; }

        // String ops.  Strings are null-terminated `i8*` at the LLVM level.
        //   `==`/`!=` → strcmp
        //   `+` string + string → append (concat into fresh heap buffer)
        //   `+` string + int    → pointer advancement (GEP over i8)
        if (t_kind == TypeKind::String) {
            if (op_kind == TokenType::EqualEqual || op_kind == TokenType::ExclaimEqual) {
                out_value = this.codegen_string_compare(lhs_val, rhs_val, op_kind);
                return out_value;
            }
            if (op_kind == TokenType::Plus) {
                // Decide concat vs pointer-advance by the RHS's LLVM type.
                // Both operands are already rvalues at this point.
                const rhs_llvm: void* = llvm::LLVMTypeOf(rhs_val.raw);
                if (rhs_llvm != null && type_kind_of(rhs_llvm) == LTypeKind::Integer) {
                    // string + int → GEP i8 for pointer arithmetic.  Caller
                    // uses this idiom for substring-from-offset, C-string
                    // walking, etc.
                    const buf: void* = intrinsics::malloc(8);
                    const slots: void** = buf as void**;
                    slots[0] = rhs_val.raw;
                    out_value = this.builder.build_gep(
                        LType::i8(), lhs_val, buf, 1, "ptradv");
                    intrinsics::free(buf);
                    return out_value;
                }
                // string + string → call std::core::primitives::string::append.
                // The stdlib already provides this as a method on `string`;
                // every module gets it via cross-module extern declarations.
                //
                // append's signature is `(&this, other: string) -> string`.  By
                // convention, `&this` on a primitive lowers to a pointer to the
                // storage holding the string (i8**).  The body opens with
                // `load ptr, ptr %0` to deref it back to the string.  Method-call
                // codegen passes the receiver's lvalue for value-typed receivers
                // (see ir_generator.cryo:visit_call_expr); the binary `+` path
                // arrives here with `lhs_val` already loaded as an rvalue (i8*),
                // so spill it back to a temp slot and pass that slot's address.
                // Without this, the callee derefs i8* expecting i8** and reads
                // the first 8 bytes of string content as a "pointer", crashing
                // in strlen.
                const intern: InternTable* = this.get_intern();
                const fn_sym: SymbolStr = intern.intern(
                    "std::core::primitives::string::append");
                const fn_val: LValue = this.resolve_function(fn_sym);
                if (!fn_val.is_valid()) {
                    out_value = LValue::null();
                    return out_value;
                }
                const fn_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(fn_val.raw) };
                const this_ty: LType = LType::pointer_to(LType::i8());
                const this_slot: LValue = this.builder.build_alloca(this_ty, "strcat.this");
                this.builder.build_store(lhs_val, this_slot);
                mut args: Pair<LValue, TypeRef>[] = [];
                args.push(Pair<LValue, TypeRef>::new(this_slot, TypeRef::invalid()));
                args.push(Pair<LValue, TypeRef>::new(rhs_val, TypeRef::invalid()));
                out_value = this.codegen_call(fn_val, fn_ty, args, "strcat");
                return out_value;
            }
            // Ordered comparison between two strings (i.e. raw `char*`
            // buffer walking (`this.current >= this.buffer_end`).  LLVM
            // allows `icmp` directly on matching pointer types; treat as
            // unsigned since address space is unsigned.  Without this,
            // `codegen_binary` fell through to the null-return below and
            // stripped any method body containing such a comparison.
            if (op_kind == TokenType::LAngle || op_kind == TokenType::RAngle ||
                op_kind == TokenType::LessEqual || op_kind == TokenType::GreaterEqual) {
                mut icmp_op: LIntPredicate = LIntPredicate::ULT;
                if (op_kind == TokenType::RAngle) {
                    icmp_op = LIntPredicate::UGT;
                } else if (op_kind == TokenType::LessEqual) {
                    icmp_op = LIntPredicate::ULE;
                } else if (op_kind == TokenType::GreaterEqual) {
                    icmp_op = LIntPredicate::UGE;
                }
                out_value = this.builder.build_icmp(icmp_op, lhs_val, rhs_val, "ptrcmp");
                return out_value;
            }
            out_value = LValue::null();
            return out_value;
        }

        // Enum comparison: compare i32 discriminant tags.
        // For simple enums the value is already i32.
        // For ADT enums extract field 0 (the tag) first.
        if (t_kind == TypeKind::Enum) {
            if (op_kind == TokenType::EqualEqual || op_kind == TokenType::ExclaimEqual) {
                mut lhs_tag: LValue = lhs_val;
                mut rhs_tag: LValue = rhs_val;
                // Check if this is an ADT enum (struct type in LLVM) or simple (i32).
                const lhs_llvm_ty: void* = llvm::LLVMTypeOf(lhs_val.raw);
                if (lhs_llvm_ty != null && type_kind_of(lhs_llvm_ty) == LTypeKind::Struct) {
                    // ADT enum: extract the discriminant tag at field 0
                    // before comparing.  Skipping this would feed the full
                    // struct to icmp and trip "icmp requires integer
                    // operands" at verify time.
                    lhs_tag = this.builder.build_extract_value(lhs_val, 0, "lhs.tag");
                    rhs_tag = this.builder.build_extract_value(rhs_val, 0, "rhs.tag");
                }
                if (op_kind == TokenType::EqualEqual) {
                    out_value = this.builder.build_icmp(LIntPredicate::EQ, lhs_tag, rhs_tag, "enum.eq");
                } else {
                    out_value = this.builder.build_icmp(LIntPredicate::NE, lhs_tag, rhs_tag, "enum.ne");
                }
                return out_value;
            }
            out_value = LValue::null();
            return out_value;
        }

        // Bail out if the operand type is not numeric, pointer/reference, or
        // function.  Operating on void/error/unresolved types crashes LLVM.
        // Function types are included so that `fn_ptr != null` and
        // `fn_ptr == fn_ptr` checks reach the icmp path below; both lower
        // to LLVM `ptr`, so the existing pointer-comparison logic works
        // unchanged.  Reference is included so that `&arr[i] + offset`
        // (which sema types as `&T`, not `T*`) reaches the GEP path below.
        if (t_kind != TypeKind::Int && t_kind != TypeKind::Float &&
            t_kind != TypeKind::Bool && t_kind != TypeKind::Pointer &&
            t_kind != TypeKind::Reference &&
            t_kind != TypeKind::Char && t_kind != TypeKind::Function) {
            out_value = LValue::null();
            return out_value;
        }

        // Pointer + int / Pointer - int → GEP over the pointee type.
        // LLVM rejects `add ptr, i64`; the arithmetic must be expressed
        // as a getelementptr with a scaled integer index.  Matches the
        // string-plus-int path above but for typed pointers (`i8*`, `u8*`
        // etc. used for C-string or buffer walking).  References (`&T`)
        // share the same opaque-ptr representation; route them through the
        // same path by reading the referent type instead of the pointee.
        if ((t_kind == TypeKind::Pointer || t_kind == TypeKind::Reference) &&
            (op_kind == TokenType::Plus || op_kind == TokenType::Minus)) {
            mut elem_ty: TypeRef = TypeRef::invalid();
            if (t_kind == TypeKind::Pointer) {
                const ptr_t: PointerType* = t as PointerType*;
                elem_ty = ptr_t.pointee;
            } else {
                const ref_t: ReferenceType* = t as ReferenceType*;
                elem_ty = ref_t.referent;
            }
            const pointee_lty: LType = this.type_mapper.map_type(elem_ty);
            if (pointee_lty.is_valid()) {
                mut idx: LValue = rhs_val;
                if (op_kind == TokenType::Minus) {
                    idx = this.builder.build_neg(rhs_val, "gep.neg");
                }
                const buf: void* = intrinsics::malloc(8);
                const slots: void** = buf as void**;
                slots[0] = idx.raw;
                out_value = this.builder.build_gep(
                    pointee_lty, lhs_val, buf, 1, "ptradv");
                intrinsics::free(buf);
                return out_value;
            }
        }

        const is_float: boolean = t_kind == TypeKind::Float;
        mut is_signed: boolean = false;
        if (t_kind == TypeKind::Int) {
            const int_t: IntType* = t as IntType*;
            const ik: IntegerKind = int_t.int_kind;
            is_signed = ik.is_signed();
        }

        // Normalize integer operand widths.
        // LLVM requires both operands to binary ops (icmp, add, shl, etc.)
        // to have the same type.  If they differ (e.g., i32 vs i64),
        // extend the narrower one to match the wider.
        mut lhs: LValue = lhs_val;
        mut rhs: LValue = rhs_val;
        if (!is_float) {
            const lhs_ty: void* = llvm::LLVMTypeOf(lhs.raw);
            const rhs_ty: void* = llvm::LLVMTypeOf(rhs.raw);
            const lhs_kind: LTypeKind = type_kind_of(lhs_ty);
            const rhs_kind: LTypeKind = type_kind_of(rhs_ty);
            if (lhs_ty != null && rhs_ty != null &&
                lhs_kind == LTypeKind::Integer && rhs_kind == LTypeKind::Integer) {
                const lhs_w: u32 = llvm::LLVMGetIntTypeWidth(lhs_ty);
                const rhs_w: u32 = llvm::LLVMGetIntTypeWidth(rhs_ty);
                if (lhs_w < rhs_w) {
                    const target: LType = LType { raw: rhs_ty };
                    if (is_signed) {
                        lhs = this.builder.build_sext(lhs, target, "widen");
                    } else {
                        lhs = this.builder.build_zext(lhs, target, "widen");
                    }
                } else if (rhs_w < lhs_w) {
                    const target: LType = LType { raw: lhs_ty };
                    if (is_signed) {
                        rhs = this.builder.build_sext(rhs, target, "widen");
                    } else {
                        rhs = this.builder.build_zext(rhs, target, "widen");
                    }
                }
            } else if (lhs_ty != null && rhs_ty != null &&
                       lhs_kind == LTypeKind::Integer && rhs_kind == LTypeKind::Pointer) {
                // int <op> ptr: coerce int to ptr so icmp on two pointers
                // succeeds.  Address comparisons in stdlib (e.g., aligned_addr
                // < base + offset, where the int side holds a ptrtoint'd
                // address) depend on this normalization.
                const ptr_ty: LType = LType { raw: rhs_ty };
                lhs = this.builder.build_int_to_ptr(lhs, ptr_ty, "int2ptr");
            } else if (lhs_ty != null && rhs_ty != null &&
                       lhs_kind == LTypeKind::Pointer && rhs_kind == LTypeKind::Integer) {
                const ptr_ty: LType = LType { raw: lhs_ty };
                rhs = this.builder.build_int_to_ptr(rhs, ptr_ty, "int2ptr");
            }
        }

        match (op_kind) {
            // Arithmetic
            TokenType::Plus => {
                out_value = if (is_float) {
                    this.builder.build_fadd(lhs, rhs, "addtmp")
                } else {
                    this.builder.build_add(lhs, rhs, "addtmp")
                };
            }
            TokenType::Minus => {
                out_value = if (is_float) {
                    this.builder.build_fsub(lhs, rhs, "subtmp")
                } else {
                    this.builder.build_sub(lhs, rhs, "subtmp")
                };
            }
            TokenType::Star => {
                out_value = if (is_float) {
                    this.builder.build_fmul(lhs, rhs, "multmp")
                } else {
                    this.builder.build_mul(lhs, rhs, "multmp")
                };
            }
            TokenType::Slash => {
                out_value = if (is_float) {
                    this.builder.build_fdiv(lhs, rhs, "divtmp")
                } else { if (is_signed) {
                    this.builder.build_sdiv(lhs, rhs, "divtmp")
                } else {
                    this.builder.build_udiv(lhs, rhs, "divtmp")
                } };
            }
            TokenType::Percent => {
                out_value = if (is_float) {
                    this.builder.build_frem(lhs, rhs, "remtmp")
                } else { if (is_signed) {
                    this.builder.build_srem(lhs, rhs, "remtmp")
                } else {
                    this.builder.build_urem(lhs, rhs, "remtmp")
                } };
            }

            // Comparison
            TokenType::EqualEqual => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OEQ, lhs, rhs, "eqtmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::EQ, lhs, rhs, "eqtmp")
                };
            }
            TokenType::ExclaimEqual => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::ONE, lhs, rhs, "netmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::NE, lhs, rhs, "netmp")
                };
            }
            TokenType::LAngle => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OLT, lhs, rhs, "lttmp")
                } else { if (is_signed) {
                    this.builder.build_icmp(LIntPredicate::SLT, lhs, rhs, "lttmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::ULT, lhs, rhs, "lttmp")
                } };
            }
            TokenType::RAngle => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OGT, lhs, rhs, "gttmp")
                } else { if (is_signed) {
                    this.builder.build_icmp(LIntPredicate::SGT, lhs, rhs, "gttmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::UGT, lhs, rhs, "gttmp")
                } };
            }
            TokenType::LessEqual => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OLE, lhs, rhs, "letmp")
                } else { if (is_signed) {
                    this.builder.build_icmp(LIntPredicate::SLE, lhs, rhs, "letmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::ULE, lhs, rhs, "letmp")
                } };
            }
            TokenType::GreaterEqual => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OGE, lhs, rhs, "getmp")
                } else { if (is_signed) {
                    this.builder.build_icmp(LIntPredicate::SGE, lhs, rhs, "getmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::UGE, lhs, rhs, "getmp")
                } };
            }

            // Bitwise
            TokenType::Amp            => { out_value = this.builder.build_and(lhs, rhs, "andtmp"); }
            TokenType::Pipe           => { out_value = this.builder.build_or(lhs, rhs, "ortmp"); }
            TokenType::Caret          => { out_value = this.builder.build_xor(lhs, rhs, "xortmp"); }
            TokenType::LessLess       => { out_value = this.builder.build_shl(lhs, rhs, "shltmp"); }
            TokenType::GreaterGreater => {
                out_value = if (is_signed) {
                    this.builder.build_ashr(lhs, rhs, "shrtmp")
                } else {
                    this.builder.build_lshr(lhs, rhs, "shrtmp")
                };
            }

            _ => { out_value = LValue::null(); }
        }
        return out_value;
    }

    /// Generate IR for a unary expression.
    codegen_unary(mut &this, operand: LValue, op_kind: TokenType, operand_type: TypeRef) -> LValue {
        mut out_value: LValue = LValue::null();
        const t: Type* = this.lookup_type_by_id(operand_type.id);
        mut t_kind: TypeKind = TypeKind::Error;
        if (t != null) { t_kind = t.kind; }
        const is_float: boolean = t_kind == TypeKind::Float;

        match (op_kind) {
            TokenType::Minus => {
                out_value = if (is_float) {
                    this.builder.build_fneg(operand, "negtmp")
                } else {
                    this.builder.build_neg(operand, "negtmp")
                };
            }
            TokenType::Exclaim => { out_value = this.builder.build_not(operand, "nottmp"); }
            TokenType::Tilde   => { out_value = this.builder.build_not(operand, "bnottmp"); }
            _                  => { out_value = LValue::null(); }
        }
        return out_value;
    }

    /// Promote a value of a fixed-size array slot to a fat pointer
    /// `{T*, i64, i64}` when stored into a dynamic-array field.
    coerce_fixed_array_to_fat_ptr(mut &this, val: LValue, field_type: TypeRef) -> LValue {
        if (!val.is_valid()) { return val; }
        const ft: Type* = this.lookup_type_by_id(field_type.id);
        if (ft == null || ft.kind != TypeKind::Array) { return val; }
        const arr_t: ArrayType* = ft as ArrayType*;
        if (arr_t.is_fixed()) { return val; }

        const got_ty: void* = llvm::LLVMTypeOf(val.raw);
        if (type_kind_of(got_ty) != LTypeKind::Array) { return val; }

        const elem_count: u32 = llvm::LLVMGetArrayLength(got_ty);
        const elem_lty: LType = LType { raw: llvm::LLVMGetElementType(got_ty) };

        const elem_t_raw: Type* = this.lookup_type_by_id(arr_t.element.id);
        mut elem_size: u64 = 1;
        if (elem_t_raw != null && elem_t_raw.size_bytes() > 0) {
            elem_size = elem_t_raw.size_bytes();
        }
        const total_bytes: u64 = elem_size * (elem_count as u64);
        const total_bytes_val: LValue = LType::const_int(LType::i64(), total_bytes, false);

        const current_bb: LBasicBlock = this.builder.get_insert_block();
        if (!current_bb.is_valid()) { return val; }
        const fn_val: LValue = current_bb.get_parent();
        if (!fn_val.is_valid()) { return val; }

        // Stash the fixed array on the stack so we have a source pointer for memcpy.
        const src: LValue = this.create_entry_alloca(fn_val, "arrlit.src", LType { raw: got_ty });
        this.builder.build_store(val, src);

        // malloc(N * sizeof(T)) for the fat-pointer's owned buffer.
        const malloc_fn: LValue = this.resolve_function(this.intern_str("malloc"));
        if (!malloc_fn.is_valid()) { return val; }
        const malloc_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(malloc_fn.raw) };
        mut malloc_args: Pair<LValue, TypeRef>[] = [];
        malloc_args.push(Pair<LValue, TypeRef>::new(total_bytes_val, TypeRef::invalid()));
        mut data_ptr: LValue = LValue::null();
        data_ptr = this.codegen_call(malloc_fn, malloc_ty, malloc_args, "arrlit.heap");
        if (!data_ptr.is_valid()) { return val; }

        llvm::LLVMBuildMemCpy(this.builder.raw,
                              data_ptr.raw, 1,
                              src.raw, 1,
                              total_bytes_val.raw);

        // Build the fat-pointer struct: { data_ptr, count, count }.
        const elem_ptr_lty: LType = LType::pointer_to(elem_lty);
        const i64_ty: LType = LType::i64();
        const buf: void* = intrinsics::malloc(24);
        const slots: void** = buf as void**;
        slots[0] = elem_ptr_lty.raw;
        slots[1] = i64_ty.raw;
        slots[2] = i64_ty.raw;
        const fat_ty: LType = LType::literal_struct(buf, 3, false);
        intrinsics::free(buf);

        const fat: LValue = this.create_entry_alloca(fn_val, "arrlit.fat", fat_ty);
        const ptr_slot: LValue = this.builder.build_struct_gep(fat_ty, fat, 0, "fat.ptr");
        this.builder.build_store(data_ptr, ptr_slot);
        const len_slot: LValue = this.builder.build_struct_gep(fat_ty, fat, 1, "fat.len");
        const count_val: LValue = LType::const_int(LType::i64(), elem_count as u64, false);
        this.builder.build_store(count_val, len_slot);
        const cap_slot: LValue = this.builder.build_struct_gep(fat_ty, fat, 2, "fat.cap");
        this.builder.build_store(count_val, cap_slot);

        return this.builder.build_load(fat_ty, fat, "arrlit.fat.val");
    }


    /// Heap-box an enum variant value for `new T::V(...)`.
    /// Allocates et.computed_size bytes, bitcasts to the enum struct pointer
    /// type, and stores the loaded variant struct value at offset 0.
    /// Returns the typed pointer.
    heap_box_enum_variant(mut &this, et: EnumType*, enum_ref: TypeRef, variant_val: LValue, span: SourceSpan) -> LValue {
        const malloc_fn: LValue = this.resolve_function(this.intern_str("malloc"));
        if (!malloc_fn.is_valid()) {
            this.emit_error_at_span(ErrorCode::E0636_UNDEFINED_FUNCTION_CALL,
                "codegen: new T::V: malloc not declared",
                span);
            return LValue::null();
        }
        const malloc_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(malloc_fn.raw) };
        if (!malloc_ty.is_valid()) {
            this.emit_error_at_span(ErrorCode::E0602_INVALID_LLVM_TYPE,
                "codegen: new T::V: failed to retrieve malloc function type",
                span);
            return LValue::null();
        }

        const size: u64 = et.computed_size;
        if (size == 0) {
            this.emit_error_at_span(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "codegen: enum computed_size is 0 reaching codegen (TypeLowering bug)",
                span);
            return LValue::null();
        }

        const size_val: LValue = LType::const_int(LType::i64(), size, false);
        mut malloc_args: Pair<LValue, TypeRef>[] = [];
        malloc_args.push(Pair<LValue, TypeRef>::new(size_val, TypeRef::invalid()));
        mut raw_ptr: LValue = LValue::null();
        raw_ptr = this.codegen_call(malloc_fn, malloc_ty, malloc_args, "newenum");

        const enum_llvm: LType = this.type_mapper.map_type(enum_ref);
        if (!enum_llvm.is_valid()) {
            this.emit_error_at_span(ErrorCode::E0609_TYPE_MAPPING_ERROR,
                "codegen: new T::V: failed to map enum type",
                span);
            return LValue::null();
        }
        const obj_ptr: LValue = this.builder.build_pointer_cast(
            raw_ptr, LType::pointer_to(enum_llvm), "newenumcast");

        if (variant_val.is_valid() && obj_ptr.is_valid()) {
            this.builder.build_store(variant_val, obj_ptr);
        }

        return obj_ptr;
    }

}


// ============================================================================
// Block-result structs returned by the control-flow codegen primitives.
// Kept top-level (a class method can't return a type defined inside the
// class) so that visit() overrides can name the type when destructuring.
// ============================================================================

type struct IfBlocks {
    then_bb:  LBasicBlock;
    else_bb:  LBasicBlock;
    merge_bb: LBasicBlock;
}

type struct LoopBlocks {
    cond_bb:  LBasicBlock;
    body_bb:  LBasicBlock;
    merge_bb: LBasicBlock;
}

type struct ForBlocks {
    cond_bb:   LBasicBlock;
    body_bb:   LBasicBlock;
    update_bb: LBasicBlock;
    merge_bb:  LBasicBlock;
}


// ============================================================================
// On-demand cross-module extern declaration
// ============================================================================
//
// These helpers replace the old `declare_cross_module_externs` /
// `declare_cross_module_global_externs` pre-pass that walked every function
// and global in every module and emitted an LLVM `declare` in the current
// module regardless of whether it was referenced.  The bulk pass was
// O(modules × functions × overloads) per compiled module, crippling for
// stdlib-heavy programs with many generic specializations.
//
// Instead, codegen calls `resolve_function` / `resolve_function_with_arity`
// / `resolve_global` at each cross-module reference.  The helpers:
//   1. Fast-path: check the context's own function/global map.
//   2. Slow-path: look up the signature in `DeclarationIndex`, emit an
//      `external` declaration in the current LLVM module, register it,
//      and return the handle.
// This mirrors what LLVM itself does via `Module::getOrInsertFunction`.

/// Returns true if the FunctionType reaches a GenericParam / BoundedParam
/// anywhere in its return type or parameter types (walking through
/// References, Pointers, Arrays, Optionals, Tuples, and InstantiatedTypes
/// with no resolved_type).  Used by extern-overload declaration to filter
/// out sema-time registrations of still-generic templates whose param
/// signatures would otherwise lower to opaque `ptr` and produce a wrong
/// mangled name.
function type_ref_has_generic_params(arena: TypeArena*, ty: TypeRef) -> boolean {
    if (!ty.is_valid()) { return false; }
    return type_has_generic_params_walker(arena, ty, 0);
}

function type_has_generic_params_walker(arena: TypeArena*, ty: TypeRef, depth: i32) -> boolean {
    if (depth > 8) { return false; }
    if (!ty.is_valid()) { return false; }
    const t: Type* = arena.lookup(ty.id);
    if (t == null) { return false; }
    const k: TypeKind = t.kind;
    if (k == TypeKind::GenericParam || k == TypeKind::BoundedParam) {
        return true;
    }
    if (k == TypeKind::Reference) {
        const r: ReferenceType* = t as ReferenceType*;
        return type_has_generic_params_walker(arena, r.referent, depth + 1);
    }
    if (k == TypeKind::Pointer) {
        const p: PointerType* = t as PointerType*;
        return type_has_generic_params_walker(arena, p.pointee, depth + 1);
    }
    if (k == TypeKind::Array) {
        const a: ArrayType* = t as ArrayType*;
        return type_has_generic_params_walker(arena, a.element, depth + 1);
    }
    if (k == TypeKind::Optional) {
        const o: OptionalType* = t as OptionalType*;
        return type_has_generic_params_walker(arena, o.wrapped, depth + 1);
    }
    if (k == TypeKind::Tuple) {
        const tu: TupleType* = t as TupleType*;
        for (mut i: i64 = 0; i < tu.elements.length; i++) {
            if (type_has_generic_params_walker(arena, tu.elements[i], depth + 1)) {
                return true;
            }
        }
        return false;
    }
    if (k == TypeKind::InstantiatedType) {
        const inst: InstantiatedType* = t as InstantiatedType*;
        if (inst.has_resolved_type()) {
            return type_has_generic_params_walker(arena, inst.resolved_type, depth + 1);
        }
        // Un-resolved InstantiatedType: walk its type_args for generic
        // params (e.g. `Foo<T>` where T is still a template param).
        for (mut i: i64 = 0; i < inst.type_args.length; i++) {
            if (type_has_generic_params_walker(arena, inst.type_args[i], depth + 1)) {
                return true;
            }
        }
        return false;
    }
    return false;
}

function function_type_has_generic_params(arena: TypeArena*, ft: FunctionType*) -> boolean {
    if (type_ref_has_generic_params(arena, ft.return_type)) { return true; }
    for (mut i: i64 = 0; i < ft.param_types.length; i++) {
        if (type_ref_has_generic_params(arena, ft.param_types[i])) { return true; }
    }
    return false;
}
