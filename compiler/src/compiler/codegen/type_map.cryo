/// Type Mapper
///
/// Converts Cryo TypeRef handles to LLVM IR types.  Caches results by
/// TypeRef.id for deduplication and O(1) repeated lookups.  Handles all
/// 25 TypeKind variants including recursive struct types (forward-declare
/// then fill body).

namespace Compiler::Codegen::TypeMap;

import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Types;
import Compiler::Types::{ TypeRef, Type, Arena, Compound, UserDefined, Generic };
import Compiler::Resolver::{ SymbolStr, InternTable, MangledName, QualifiedName };
import Compiler::Diag;
import Compiler::Diag::{ Diagnostic, Sink };
import std::core::option;
import std::collections::{ pair, hashmap };


// Cross-module shared type cache
//
// Why this is a module-level singleton:
// One CodegenContext (and one TypeMapper) is constructed per Cryo module.
// `map_struct` / `map_class` / `forward_declare_struct` all call
// `LLVMStructCreateNamed(global_ctx, mangled_name)`.  LLVM's global context
// is process-wide, and creating a second named struct with the same name in
// it auto-renames the second to `<name>.N`.  So without sharing, module A
// emits `%C$3CLI.7Command` while module B emits `%C$3CLI.7Command.1`; and
// the linker can't merge them back together.
//
// The fix: every TypeMapper across every module reads/writes the SAME
// cache.  The first module that maps `MyStruct` calls LLVMStructCreateNamed
// once and stashes the handle here; every subsequent module hits the cache
// and references the existing handle, so all per-module IR uses the same
// `%MyStruct` identifier.
//
// Cryo compilation is single-threaded, so no synchronization is needed.
// Stored as a heap-allocated TypeMapperCache* rather than two raw arrays
// to sidestep the question of whether module-level dynamic-array globals
// initialize reliably (a known historical wart).

type struct TypeMapperCache {
    // O(1) (TypeRef.id -> LLVMTypeRef) map.  A flat
    // `Pair<u64, void*>[]` linear-scanned on every lookup/store would
    // make `map_type` one of the hottest frontend functions (~5% self-time),
    // since every call scans the whole cache; hashed lookup avoids the
    // scan.  Same idea as `FunctionRegistry`.
    cache: HashMap<u64, void*>;

    static new() -> TypeMapperCache {
        return TypeMapperCache { cache: HashMap<u64, void*>::new() };
    }

    lookup(&this, id: u64) -> LType {
        return match (this.cache.get(&id)) {
            Option::Some(raw) => { LType { raw: raw } }
            Option::None      => { LType::null() }
        };
    }

    store(mut &this, id: u64, ty: LType) -> void {
        this.cache.insert(id, ty.raw);
    }

    /// Lazy-init accessor for the cross-module type cache.  Idempotent;
    /// every call after the first returns the same handle.
    static get_shared_type_cache() -> TypeMapperCache* {
        if (g_shared_type_cache == null) {
            const _box: Box<TypeMapperCache> = Box<TypeMapperCache>::new(TypeMapperCache::new());
            g_shared_type_cache = _box.leak();
        }
        return g_shared_type_cache;
    }

    /// Drop the shared type cache so the next codegen pass starts with an
    /// empty (TypeRef.id -> LLVMTypeRef) map.  Required when running
    /// multiple project compiles in the same process; TypeArena.next_id
    /// resets to 1 per compile, so cached entries from a prior compile
    /// would otherwise be returned for unrelated types in the new compile.
    static reset_shared_type_cache() -> void {
        g_shared_type_cache = null;
    }
}

mut g_shared_type_cache: TypeMapperCache* = null;


type struct TypeMapper {
    arena:  TypeArena*;
    intern: InternTable*;
    // Diagnostic sink for reporting unsound lowerings (e.g. a struct field
    // whose type cannot be lowered to LLVM).  Nullable: a TypeMapper built
    // without one degrades to silent placeholder substitution, but every
    // codegen-path TypeMapper is wired with the CompilationContext's sink so
    // an unmappable field fails the compile instead of shipping a corrupt
    // layout.
    diag:   DiagnosticSink*;

    static new(arena: TypeArena*, intern: InternTable*, diag: DiagnosticSink*) -> TypeMapper {
        return TypeMapper {
            arena:  arena,
            intern: intern,
            diag:   diag,
        };
    }

    /// Report that a user-defined type could not be lowered soundly because
    /// one or more fields had types that don't map to an LLVM type.  The
    /// emitted error fails the current codegen pass, so no binary ships with
    /// the wrong layout.  A reachable hit means an un-substituted generic
    /// parameter or an unresolved/error type slipped past sema/monomorphization
    /// into codegen -- i.e. a compiler bug, not user error.
    report_unmappable_fields(&this, struct_name: string, bad_count: u32, first_bad: u32) -> void {
        if (this.diag == null) { return; }
        const msg: string = format(
            "codegen: type '%s' has %u field(s) whose type could not be lowered to LLVM (first at field index %u); the type was left without a layout. This is a compiler bug -- an un-substituted generic parameter or unresolved type reached codegen. Please report it.",
            struct_name, bad_count, first_bad);
        const sink: DiagnosticSink* = this.diag;
        sink.emit(Diagnostic::error(ErrorCode::E0600_CODEGEN_FAILED, msg));
    }

    /// Primary entry point.  Returns the LLVMType for a Cryo TypeRef.
    map_type(mut &this, ty: TypeRef) -> LType {
        if (ty.is_invalid()) {
            return LType::null();
        }

        const cached: LType = this.lookup_cache(ty.id);
        if (cached.is_valid()) {
            return cached;
        }

        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) {
            return LType::null();
        }

        const result: LType = this.map_type_impl(t);
        if (result.is_valid()) {
            this.store_cache(ty.id, result);
        }
        return result;
    }

    /// Map a Type* directly (for internal use when we already have the pointer).
    map_type_ptr(mut &this, t: Type*) -> LType {
        if (t == null) {
            return LType::null();
        }
        const cached: LType = this.lookup_cache(t.id);
        if (cached.is_valid()) {
            return cached;
        }
        const result: LType = this.map_type_impl(t);
        if (result.is_valid()) {
            this.store_cache(t.id, result);
        }
        return result;
    }

    /// Forward-declare a named struct type.  Returns an opaque struct that
    /// can be referenced by pointer before its body is filled in.
    forward_declare_struct(mut &this, name: string, type_id: u64) -> LType {
        const ctx: LContext = LContext::current();
        const llvm_ty: LType = LType::named_struct(ctx, name);
        this.store_cache(type_id, llvm_ty);
        return llvm_ty;
    }

    // Internal dispatch

    map_type_impl(mut &this, t: Type*) -> LType {
        return match (t.kind) {
            TypeKind::Void             => { LType::void_type() }
            TypeKind::Unit             => { this.map_unit() }
            TypeKind::Bool             => { LType::i1() }
            TypeKind::Int              => { this.map_int(t as IntType*) }
            TypeKind::Float            => { this.map_float(t as FloatType*) }
            TypeKind::Char             => { LType::i32() }
            TypeKind::String           => { this.map_string() }
            TypeKind::Never            => { LType::void_type() }
            // `va_list` lowers to an opaque pointer: a C va_list argument is
            // always passed as one pointer-width value (SysV decays
            // `__va_list_tag[1]` to a pointer; Win64 va_list is `char*`), and
            // this matches what a variadic function's `args` bucket already is.
            TypeKind::VaList           => { LType::pointer_to(LType::i8()) }
            TypeKind::Pointer          => { this.map_pointer(t as PointerType*) }
            TypeKind::Reference        => { this.map_reference(t as ReferenceType*) }
            TypeKind::Array            => { this.map_array(t as ArrayType*) }
            TypeKind::Function         => { this.map_function(t as FunctionType*) }
            TypeKind::Tuple            => { this.map_tuple(t as TupleType*) }
            TypeKind::Optional         => { this.map_optional(t as OptionalType*) }
            TypeKind::Struct           => { this.map_struct(t as StructType*) }
            TypeKind::Class            => { this.map_class(t as ClassType*) }
            TypeKind::Enum             => { this.map_enum(t as EnumType*) }
            TypeKind::Trait            => { LType::i8() }
            TypeKind::TypeAlias        => { this.map_type_alias(t as TypeAliasType*) }
            TypeKind::GenericParam     => { LType::null() }
            TypeKind::BoundedParam     => { LType::null() }
            TypeKind::InstantiatedType => { this.map_instantiated(t as InstantiatedType*) }
            TypeKind::AssocProjection  => { LType::null() }
            TypeKind::FunctionTemplate => { LType::null() }
            TypeKind::Error            => { LType::null() }
        };
    }


    // Primitive type mappers

    /// Unit type -> empty struct {}
    map_unit(mut &this) -> LType {
        return LType::literal_struct(null, 0, false);
    }

    /// IntType -> LLVMIntType with correct bit width.
    map_int(mut &this, t: IntType*) -> LType {
        return LType::int_type(t.int_kind.bit_width() as u32);
    }

    /// FloatType -> LLVMFloatType or LLVMDoubleType.
    map_float(mut &this, t: FloatType*) -> LType {
        return match (t.float_kind) {
            FloatKind::F32 => { LType::f32() }
            FloatKind::F64 => { LType::f64() }
        };
    }

    /// String -> i8* (null-terminated C string pointer).
    /// When a proper fat-pointer string type is introduced later,
    /// this will change to a named struct { i8*, i64 } with runtime support.
    map_string(mut &this) -> LType {
        return LType::pointer_to(LType::i8());
    }


    // Compound type mappers

    /// Pointer -> LLVMPointerType(pointee, 0)
    map_pointer(mut &this, t: PointerType*) -> LType {
        const pointee: LType = this.map_type(t.pointee);
        if (!pointee.is_valid()) {
            return LType::pointer_to(LType::i8());  // fallback to i8* for void*
        }
        // Void is not a valid LLVM pointee; LLVMBuildAlloca(VoidType) crashes
        // because void is unsized. Use i8 as the canonical void-pointer element.
        const vt: LType = LType::void_type();
        if (pointee.raw == vt.raw) {
            return LType::pointer_to(LType::i8());
        }
        return LType::pointer_to(pointee);
    }

    /// Reference -> pointer at IR level.
    map_reference(mut &this, t: ReferenceType*) -> LType {
        const referent: LType = this.map_type(t.referent);
        if (!referent.is_valid()) {
            return LType::pointer_to(LType::i8());
        }
        const vt: LType = LType::void_type();
        if (referent.raw == vt.raw) {
            return LType::pointer_to(LType::i8());
        }
        return LType::pointer_to(referent);
    }

    /// Array -> fixed: [N x T]; dynamic: { T*, i64, i64 }
    /// Dynamic layout must match stdlib's `Array<T>` struct
    /// (`stdlib/collections/array.cryo`: ptr, len, cap) so that calls to
    /// `Array<T>::push`/`pop`/`reserve` operate on `T[]` fields safely.
    map_array(mut &this, t: ArrayType*) -> LType {
        const elem: LType = this.map_type(t.element);
        if (!elem.is_valid()) {
            return LType::null();
        }

        if (t.is_fixed()) {
            return LType::array_of(elem, t.size as u32);
        }

        const elem_ptr: LType = LType::pointer_to(elem);
        const i64_ty: LType = LType::i64();
        const buf: void* = intrinsics::malloc(24);
        const slots: void** = buf as void**;
        slots[0] = elem_ptr.raw;
        slots[1] = i64_ty.raw;
        slots[2] = i64_ty.raw;
        const result: LType = LType::literal_struct(buf, 3, false);
        intrinsics::free(buf);
        return result;
    }

    /// FunctionType -> LLVMFunctionType(ret, params, is_variadic)
    map_function(mut &this, t: FunctionType*) -> LType {
        // Function values are always passed as pointers in LLVM; you cannot
        // allocate a function type on the stack.  Return an opaque pointer type.
        // The underlying function signature is captured when the function is
        // declared, not when a variable of function type is created.
        return LType::pointer_to(LType::i8());
    }

    /// Tuple -> anonymous struct { elem0, elem1, ... }
    map_tuple(mut &this, t: TupleType*) -> LType {
        const n: u32 = t.elements.length as u32;
        const buf: void* = intrinsics::malloc(n as u64 * 8);
        const slots: void** = buf as void**;
        mut has_null: boolean = false;
        for (mut i: u32 = 0; i < n; i++) {
            const mapped: LType = this.map_type(t.elements[i]);
            if (!mapped.is_valid()) {
                has_null = true;
                break;
            }
            slots[i] = mapped.raw;
        }
        if (has_null) {
            intrinsics::free(buf);
            return LType::null();
        }
        const result: LType = LType::literal_struct(buf, n, false);
        intrinsics::free(buf);
        return result;
    }

    /// Optional<T> -> { T, i1 } (value + has_value flag)
    map_optional(mut &this, t: OptionalType*) -> LType {
        const wrapped: LType = this.map_type(t.wrapped);
        if (!wrapped.is_valid()) { return LType::null(); }
        const i1_ty: LType = LType::i1();
        const buf: void* = intrinsics::malloc(16);
        const slots: void** = buf as void**;
        slots[0] = wrapped.raw;
        slots[1] = i1_ty.raw;
        const result: LType = LType::literal_struct(buf, 2, false);
        intrinsics::free(buf);
        return result;
    }


    // User-defined type mappers

    /// StructType -> named LLVM struct with fields.
    /// If already forward-declared (in cache), just returns it.
    ///
    /// Honours layout directives recorded on the StructType:
    ///   * `repr_packed` -> emit the LLVM struct as `packed`, so LLVM
    ///     skips per-field padding.  Matches `compute_struct_layout`'s
    ///     own packed branch so `sizeof(T)` and the LLVM-level type
    ///     agree.
    ///   * `repr_transparent` -> no codegen change needed beyond what
    ///     the field list already produces; layout equivalence to the
    ///     inner field is enforced by `compute_struct_layout`.
    map_struct(mut &this, t: StructType*) -> LType {
        const mangled: string = MangledName::for_struct_type(this.intern, QualifiedName::from_symbol(t.qualified_name)).resolve(this.intern);

        // Check if already forward-declared.
        const cached: LType = this.lookup_cache(t.id);
        if (cached.is_valid()) {
            return cached;
        }

        const ctx: LContext = LContext::current();

        // Reuse an existing identified struct of the same mangled name.
        // Monomorphization can hand the same struct a fresh type id (e.g.
        // an enum payload `Frame` resolved inside a specialized generic
        // body vs. the canonical `Frame`); without this, a second
        // `LLVMStructCreateNamed` mints `Name.0`, a distinct type, and a
        // phi/store bridging the two fails LLVM verification.  If the
        // existing handle is still opaque it is mid-construction (a
        // recursive reference); the original creator fills its body.
        const existing: LType = LType::struct_by_name(ctx, mangled);
        if (existing.is_valid()) {
            this.store_cache(t.id, existing);
            return existing;
        }

        // Forward-declare to handle recursive references.
        mut llvm_ty: LType = LType::named_struct(ctx, mangled);
        this.store_cache(t.id, llvm_ty);

        const packed: boolean = t.repr_packed;

        // Union: an untagged overlay.  Lower to a struct with ONE storage
        // element `[K x iA]`, where iA is an integer of the union's alignment
        // (1->i8, 2->i16, 4->i32, 8->i64, else i128) and K = size/align.
        // TypeLowering guarantees `computed_size` is a multiple of
        // `computed_align`, so this reproduces both the size and the alignment
        // exactly.  Members are read/written via a bitcast at offset 0
        // (place_emitter), so the element type only has to carry size+align.
        if (t.is_union && t.fields.length > 0) {
            mut u_align: u64 = t.computed_align;
            if (u_align == 0) { u_align = 1; }
            mut u_size: u64 = t.computed_size;
            if (u_size < u_align) { u_size = u_align; }
            mut elem: LType = LType::i128();
            if (u_align == 1)      { elem = LType::i8();  }
            else if (u_align == 2) { elem = LType::i16(); }
            else if (u_align == 4) { elem = LType::i32(); }
            else if (u_align == 8) { elem = LType::i64(); }
            const count: u32 = (u_size / u_align) as u32;
            const blob: LType = LType::array_of(elem, count);
            const ubuf: void* = intrinsics::malloc(8);
            const uslots: void** = ubuf as void**;
            uslots[0] = blob.raw;
            llvm_ty.set_struct_body(ubuf, 1, false);
            intrinsics::free(ubuf);
            return llvm_ty;
        }

        // Build field type array.
        const n: u32 = t.fields.length as u32;
        if (n > 0) {
            const buf: void* = intrinsics::malloc(n as u64 * 8);
            const slots: void** = buf as void**;
            // A field whose type can't be lowered to LLVM means an
            // un-substituted generic or unresolved type reached codegen -- a
            // compiler bug.  We must NOT invent a placeholder layout: that
            // would silently produce a struct with wrong field offsets.
            // Report it to the Diag system (fails the pass) and abort the
            // body without calling set_struct_body, leaving the type opaque.
            mut bad_fields: u32 = 0;
            mut first_bad:  u32 = 0;
            for (mut i: u32 = 0; i < n; i++) {
                const ft: LType = this.map_type(t.fields[i].field_type);
                if (ft.is_valid()) {
                    slots[i] = ft.raw;
                } else {
                    if (bad_fields == 0) { first_bad = i; }
                    bad_fields += 1;
                }
            }
            if (bad_fields > 0) {
                intrinsics::free(buf);
                this.report_unmappable_fields(mangled, bad_fields, first_bad);
                return LType::null();
            }
            llvm_ty.set_struct_body(buf, n, packed);
            intrinsics::free(buf);
        } else {
            llvm_ty.set_struct_body(null, 0, packed);
        }

        return llvm_ty;
    }

    /// ClassType -> struct with inheritance flattened (Itanium-ABI style):
    ///   [ vtable ptr, if any ancestor has virtual methods ]
    ///   [ root class's fields, then each derived class's fields in order ]
    ///   [ this class's own fields ]
    /// A subclass pointer is valid as a base pointer because their struct
    /// layouts share a prefix; no bitcast needed for upcasts.
    map_class(mut &this, t: ClassType*) -> LType {
        const mangled: string = MangledName::for_struct_type(this.intern, QualifiedName::from_symbol(t.qualified_name)).resolve(this.intern);

        const cached: LType = this.lookup_cache(t.id);
        if (cached.is_valid()) {
            return cached;
        }

        const ctx: LContext = LContext::current();

        // Reuse an existing identified struct of the same mangled name
        // across type ids (see `map_struct` for the rationale).
        const existing: LType = LType::struct_by_name(ctx, mangled);
        if (existing.is_valid()) {
            this.store_cache(t.id, existing);
            return existing;
        }

        mut llvm_ty: LType = LType::named_struct(ctx, mangled);
        this.store_cache(t.id, llvm_ty);

        // Walk the base chain: chain[0] is this class; chain[N-1] is the root.
        // Any ancestor with virtual methods means this subclass also carries
        // a vtable pointer at slot 0.
        mut chain: ClassType*[] = [];
        mut any_virtual: boolean = false;
        mut walk: ClassType* = t;
        mut depth: i32 = 0;
        while (walk != null && depth < 16) {
            chain.push(walk);
            if (walk.has_virtual_methods) { any_virtual = true; }
            if (!walk.has_base || !walk.base_class.is_valid()) { break; }
            const base_t: Type* = this.arena.lookup(walk.base_class.id);
            if (base_t == null || base_t.kind != TypeKind::Class) { break; }
            walk = base_t as ClassType*;
            depth += 1;
        }

        // Total slot count = vtable (if any) + sum of each class's own fields.
        mut total: u32 = if (any_virtual) { 1 } else { 0 } as u32;
        for (mut ci: i64 = 0; ci < chain.length; ci++) {
            total += chain[ci].fields.length as u32;
        }

        if (total == 0) {
            llvm_ty.set_struct_body(null, 0, false);
            return llvm_ty;
        }

        const buf: void* = intrinsics::malloc(total as u64 * 8);
        const slots: void** = buf as void**;

        mut idx: u32 = 0;
        if (any_virtual) {
            const vptr_ty: LType = LType::pointer_to(LType::pointer_to(LType::i8()));
            slots[0] = vptr_ty.raw;
            idx = 1;
        }

        // Emit fields in root -> derived order so a Derived* shares a prefix
        // with Base* at the LLVM-struct level.  A field that can't be lowered
        // to LLVM means an un-substituted generic or unresolved type reached
        // codegen -- a compiler bug.  We must NOT invent a placeholder slot:
        // that would silently give the class wrong field offsets.  Track the
        // failures and, if any, report to Diag (fails the pass) and abort
        // without calling set_struct_body, leaving the type opaque.  Because
        // set_struct_body is skipped on failure, an unfilled `buf` slot never
        // reaches LLVM (it would otherwise segfault checkBody on a null slot).
        mut bad_fields: u32 = 0;
        mut first_bad:  u32 = 0;
        for (mut ci: i64 = chain.length - 1; ci >= 0; ci--) {
            const link: ClassType* = chain[ci];
            for (mut i: u32 = 0; i < link.fields.length as u32; i++) {
                if (idx >= total) { break; }
                const ft: LType = this.map_type(link.fields[i].field_type);
                if (ft.is_valid()) {
                    slots[idx] = ft.raw;
                } else {
                    if (bad_fields == 0) { first_bad = idx; }
                    bad_fields += 1;
                }
                idx += 1;
            }
        }

        if (bad_fields > 0) {
            intrinsics::free(buf);
            this.report_unmappable_fields(mangled, bad_fields, first_bad);
            return LType::null();
        }

        llvm_ty.set_struct_body(buf, total, false);
        intrinsics::free(buf);

        return llvm_ty;
    }

    /// EnumType -> simple: i32; ADT: { i32, [N x int_align] payload }
    /// where the payload's element type is chosen to match the largest
    /// variant's alignment.  Using `[N x i8]` for ptr-payloads broke
    /// because LLVM gives the struct only 4-byte alignment, putting the
    /// payload at offset 4; but `compute_enum_layout` (and therefore
    /// `sizeof`/malloc/clone) places the payload at offset 8 with 8-byte
    /// alignment.  Match the alignment by promoting the array element
    /// type so LLVM's struct layout agrees with the source-side layout.
    /// The LLVM integer type for an enum's discriminant tag.  A SIMPLE
    /// (C-style) enum with an explicit `: T` base lowers its tag - which is
    /// the whole value - at T's width; everything else (ADT enums, and
    /// simple enums without an annotation) keeps the default i32.  Used by
    /// map_enum and by the variant / pattern emitters so the tag width is
    /// consistent end-to-end.
    enum_tag_ltype(mut &this, t: EnumType*) -> LType {
        if (t.is_simple_enum() && t.discriminant_type.is_valid()) {
            const lt: LType = this.map_type(t.discriminant_type);
            if (lt.is_valid()) { return lt; }
        }
        return LType::i32();
    }

    map_enum(mut &this, t: EnumType*) -> LType {
        if (t.is_simple_enum()) {
            return this.enum_tag_ltype(t);
        }

        // ADT enum: each variant's aligned payload size/alignment comes from
        // the single layout authority (TypeArena::variant_payload_layout,
        // the same function behind compute_enum_layout in
        // passes/type_lowering and every payload emitter), so the LLVM
        // struct lines up with the source-language layout by construction.
        mut max_payload_size:  u64 = 0;
        mut max_payload_align: u64 = 1;
        for (mut i: i64 = 0; i < t.variants.length; i++) {
            const v: &EnumVariantInfo = &t.variants[i];
            if (!v.has_payload()) { continue; }

            mut v_total: u64 = 0;
            mut v_align: u64 = 1;
            this.arena.variant_payload_layout(v, &v_total, &v_align);

            if (v_total > max_payload_size)  { max_payload_size  = v_total; }
            if (v_align > max_payload_align) { max_payload_align = v_align; }
        }

        // Round payload size up to overall alignment so it splits cleanly
        // into `elem_count` array elements of size `elem_align`.
        const overall_rem: u64 = max_payload_size % max_payload_align;
        const padded_payload: u64 = if (max_payload_align > 1 && overall_rem != 0) {
            max_payload_size + (max_payload_align - overall_rem)
        } else { max_payload_size };

        // Pick payload element type to match alignment.  An i64 element
        // forces LLVM to align field 1 to 8, which inserts the 4 bytes
        // of padding after the i32 tag exactly where the source layout
        // expects it.  Falls back to i8 only when no payload variant
        // exists or alignment is 1 (no padding needed).
        mut elem_align: u64 = 1;
        mut elem_ty: LType = LType::i8();
        if (max_payload_align >= 8) {
            elem_align = 8;
            elem_ty    = LType::i64();
        } else if (max_payload_align >= 4) {
            elem_align = 4;
            elem_ty    = LType::i32();
        } else if (max_payload_align >= 2) {
            elem_align = 2;
            elem_ty    = LType::i16();
        }
        const elem_count: u32 = (padded_payload / elem_align) as u32;

        // { i32 tag, [elem_count x elem_ty] payload }.  ADT enums ALWAYS
        // lower to a struct so `build_enum_variant` can struct-gep the
        // tag field at index 0 and the payload at index 1.  When every
        // variant's payload is zero-sized, elem_count=0 keeps the layout
        // as a 2-field struct rather than collapsing to a raw i32.
        const i32_ty: LType = LType::i32();
        const buf: void* = intrinsics::malloc(16);
        const slots: void** = buf as void**;
        slots[0] = i32_ty.raw;
        const payload_ty: LType = LType::array_of(elem_ty, elem_count);
        slots[1] = payload_ty.raw;
        const result: LType = LType::literal_struct(buf, 2, false);
        intrinsics::free(buf);
        return result;
    }


    // Alias / Instantiated type mappers

    /// TypeAlias -> delegates to target type.
    map_type_alias(mut &this, t: TypeAliasType*) -> LType {
        if (t.has_target()) {
            return this.map_type(t.target);
        }
        return LType::null();
    }

    /// InstantiatedType -> delegates to resolved_type.
    /// By the time codegen runs, all instantiated types have been resolved
    /// by the monomorphization pass.
    map_instantiated(mut &this, t: InstantiatedType*) -> LType {
        if (t.has_resolved_type()) {
            return this.map_type(t.resolved_type);
        }
        return LType::null();
    }


    // Cache

    /// Cache reads / writes go through the module-level shared cache so
    /// every module's TypeMapper participates in one cross-module dedup
    /// pool.
    lookup_cache(&this, id: u64) -> LType {
        const cache: TypeMapperCache* = TypeMapperCache::get_shared_type_cache();
        return cache.lookup(id);
    }

    store_cache(mut &this, id: u64, ty: LType) -> void {
        const cache: TypeMapperCache* = TypeMapperCache::get_shared_type_cache();
        cache.store(id, ty);
    }
}
