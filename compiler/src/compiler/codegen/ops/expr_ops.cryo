/// Expression Ops
///
/// AST-agnostic codegen helpers for expression-level operations: literal
/// sizeof/alignof, casts, binary/unary ops, function calls, local-var
/// allocation, returns, variadic-arg lifecycle, and the coercions that
/// keep LLVM verification happy.  Each helper assumes the caller has
/// already evaluated any inputs (resolved AST nodes, computed LValues
/// etc.) - these are the surface a visit() override reaches for after
/// extracting what it needs from the AST.
///
/// Holds back-pointers to the LLVM builder, module, type mapper, value
/// table, function registry, IR-flow emitter, name resolver, intrinsic
/// emitter, diag sink, and `CompilationContext`.  Does NOT import the
/// parent Context module to avoid a module-graph cycle.

namespace compiler::codegen::ops::expr_ops;

import compiler::codegen;
import compiler::codegen::{ llvm_types, type_map, abi };
import compiler::codegen::state::{ value_table, function_registry, diag_sink };
import compiler::codegen::ops::ir_flow_emitter;
import compiler::codegen::ops::{ symbol_resolver, intrinsic_emitter };
import compiler::compilation_context;
import compiler::diag;
import compiler::diag::{ diagnostic, source_span };
// AST access is otherwise avoided here (see the module doc), but the shared
// `--panic=unwind` cleanup landing pad must replay drop-call statements via
// `accept(visitor)`, which needs the node + visitor types.  This is a downward
// dependency (Codegen already depends on AST), not a cycle.
import compiler::ast;
import compiler::ast::{ node, visitor, statement };
import compiler::types;
import compiler::types::{ type_ref, type_base, arena, compound, user_defined };
import compiler::resolver::{ symbol_str, intern_table };
import compiler::lex;
import std::collections::pair;
import compiler::types::generic;
import std::ffi::libc;


type struct ExprOps {
    llvm_module: LModule*;
    builder:     LBuilder*;
    type_mapper: TypeMapper*;
    abi:         AbiClassifier*;
    values:      ValueTable*;
    functions:   FunctionRegistry*;
    flow:        IRFlowEmitter*;
    resolver:    SymbolResolver*;
    intrinsics:  IntrinsicEmitter*;
    diag:        DiagSink*;
    ctx:         CompilationContext*;

    /// Active variadic-arg name (SymbolStr.id).  Set by the function
    /// prologue when entering a variadic body so that `codegen_return`
    /// can emit `@llvm.va_end` before every `ret`.  0 means the current
    /// function is not variadic.
    current_variadic_arg_id: u32;

    /// Transient `invoke` swap state, armed by CallEmitter around a single
    /// `codegen_call` when the current frame has live droppable locals under
    /// `--panic=unwind`.  While `invoke_active`, `build_call_maybe_invoke`
    /// emits an `invoke` (normal edge -> `invoke_normal`, unwind edge ->
    /// `invoke_lpad`) in place of a plain `call`, repositions the builder at
    /// the normal block, and clears the flag so at most one invoke is emitted
    /// per activation.  Inactive on the default abort path => plain `call`,
    /// byte-identical IR.
    invoke_active: boolean;
    invoke_normal: LBasicBlock;
    invoke_lpad:   LBasicBlock;

    /// Live anonymous owning argument temporaries (`--panic=unwind` only).
    /// `f(make(), boom())`: make()'s result is an owning temp with no AST
    /// binding, so DropInsertion's name-keyed pending-arg machinery cannot
    /// schedule its drop. CallEmitter spills each such temp to a stable slot,
    /// registers it under a synthetic name in the value table, and pushes a
    /// ready-made `<name>.drop()` statement here. A panic origin nested in a
    /// LATER argument (a call that unwinds, or a synthesized div/bounds/no-match/
    /// overflow check) drops the WHOLE live stack in its cleanup pad before the
    /// unwind continues: at the panic point the enclosing calls have not run
    /// (their args are still evaluating), so nobody else will drop these temps.
    /// `arg_temp_frames[k]` records where the k-th in-progress call's temps
    /// begin, so CallEmitter truncates them once that call is fully built (the
    /// callee now owns them). Populated only under a hosted unwind build, so the
    /// default abort path allocates nothing and its IR is unchanged.
    arg_temp_drops:  ASTNode*[];
    arg_temp_frames: i64[];

    /// Set while a cleanup landing pad replays its drops. The synthesized
    /// `<name>.drop()` calls route back through the ordinary call path, whose
    /// invoke decision consults `arg_temp_drops`; without this guard a drop
    /// emitted inside the pad would itself become an invoke that re-drops the
    /// same stack. Suppresses only the arg-temp half of the invoke decision.
    suppress_arg_temp_invoke: boolean;

    static null() -> ExprOps {
        return ExprOps {
            llvm_module: null,
            builder:     null,
            type_mapper: null,
            abi:         null,
            values:      null,
            functions:   null,
            flow:        null,
            resolver:    null,
            intrinsics:  null,
            diag:        null,
            ctx:         null,
            current_variadic_arg_id: 0,
            invoke_active: false,
            invoke_normal: LBasicBlock::null(),
            invoke_lpad:   LBasicBlock::null(),
            arg_temp_drops:  [],
            arg_temp_frames: [],
            suppress_arg_temp_invoke: false,
        };
    }

    wire(mut &this,
         llvm_module: LModule*, builder: LBuilder*,
         type_mapper: TypeMapper*, abi: AbiClassifier*,
         values: ValueTable*,
         functions: FunctionRegistry*, flow: IRFlowEmitter*,
         resolver: SymbolResolver*, intrinsics: IntrinsicEmitter*,
         diag: DiagSink*, ctx: CompilationContext*) -> void {
        this.llvm_module = llvm_module;
        this.builder     = builder;
        this.type_mapper = type_mapper;
        this.abi         = abi;
        this.values      = values;
        this.functions   = functions;
        this.flow        = flow;
        this.resolver    = resolver;
        this.intrinsics  = intrinsics;
        this.diag        = diag;
        this.ctx         = ctx;
    }


    // Small ctx-routed accessors (inlined so ExprOps doesn't have to
    // import the parent Context module).

    lookup_type_by_id(&this, id: u64) -> Type* {
        const c: CompilationContext* = this.ctx;
        const a: TypeArena* = c.type_arena;
        return a.lookup(id);
    }

    /// Lowered byte size of the aggregate an argument feeds into
    /// register-shaped parameter slot(s), or 0 when the argument is not
    /// such an aggregate.  Used by the call-argument marshallers to
    /// decide Direct-with-coercion (<= 8 -> one register) vs DirectPair
    /// (9-16 -> two registers) lowering of a small-aggregate parameter.
    ///
    /// Three argument shapes carry an aggregate destined for registers:
    ///   - a loaded struct *value* (`ak == Struct`): size of `actual_ty`.
    ///   - the *address* of an lvalue whose Cryo type is the aggregate
    ///     (`ak == Pointer`, `arg_ty_ref` maps to a struct).
    ///   - a pointer / reference *to* the aggregate (`T*` / `&T`): the
    ///     pointee maps to a struct.
    /// Sizes come from the lowered LLVM struct via the module data
    /// layout, so unresolved `InstantiatedType` wrappers (whose Cryo
    /// `size_bytes()` would be 0) still classify correctly - `map_type`
    /// resolves them where the classifier's source-type unwrap cannot.
    agg_register_size(mut &this, actual_ty: void*,
                      arg_ty_ref: TypeRef, ak: LTypeKind) -> u64 {
        if (ak == LTypeKind::Struct) {
            return this.llvm_module.abi_size_of(LType { raw: actual_ty });
        }
        if (ak != LTypeKind::Pointer || !arg_ty_ref.is_valid()) { return 0; }
        // Address of the aggregate itself.
        const mapped: LType = this.type_mapper.map_type(arg_ty_ref);
        if (mapped.is_valid() && LType::kind_of(mapped.raw) == LTypeKind::Struct) {
            return this.llvm_module.abi_size_of(mapped);
        }
        // Pointer / reference to the aggregate.
        const t: Type* = this.lookup_type_by_id(arg_ty_ref.id);
        if (t == null) { return 0; }
        mut pointee: TypeRef = TypeRef::invalid();
        if (t.kind == TypeKind::Pointer) {
            pointee = (t as PointerType*).pointee;
        } else if (t.kind == TypeKind::Reference) {
            pointee = (t as ReferenceType*).referent;
        }
        if (!pointee.is_valid()) { return 0; }
        const pmapped: LType = this.type_mapper.map_type(pointee);
        if (pmapped.is_valid() && LType::kind_of(pmapped.raw) == LTypeKind::Struct) {
            return this.llvm_module.abi_size_of(pmapped);
        }
        return 0;
    }

    int_type_is_signed(&this, ty: TypeRef) -> boolean {
        const t: Type* = this.lookup_type_by_id(ty.id);
        if (t == null) { return false; }
        if (t.kind != TypeKind::Int) { return false; }
        const it: IntType* = t as IntType*;
        return it.int_kind.is_signed();
    }

    intern_str(&this, text: string) -> SymbolStr {
        const c: CompilationContext* = this.ctx;
        const i: InternTable* = c.intern_table;
        return i.intern(text);
    }

    resolve(&this, sym: SymbolStr) -> string {
        const c: CompilationContext* = this.ctx;
        const i: InternTable* = c.intern_table;
        return i.resolve(sym);
    }


    // sizeof / alignof

    codegen_sizeof(mut &this, type_ref: TypeRef) -> LValue {
        const t: Type* = this.lookup_type_by_id(type_ref.id);
        if (t != null) {
            const cryo_size: u64 = t.size_bytes();
            if (cryo_size > 0) {
                return LType::const_int(LType::i64(), cryo_size, false);
            }
            // size_bytes() returned 0; typically because TypeLowering
            // hasn't computed the layout for this Type (common for
            // InstantiatedType wrappers like `HashMapEntry<K, V>` that
            // route through a resolved StructType but the wrapper's
            // computed_size never gets propagated).  Fall back to LLVM's
            // authoritative size: `LLVMSizeOf` returns a ConstantExpr
            // with the data-layout-correct byte count, which is exactly
            // what `calloc(N, sizeof(T))` needs.
            const lty: LType = this.type_mapper.map_type(type_ref);
            if (lty.is_valid()) {
                return LValue { raw: llvm::LLVMSizeOf(lty.raw) };
            }
        }
        return LType::const_int(LType::i64(), 0, false);
    }

    codegen_alignof(mut &this, type_ref: TypeRef) -> LValue {
        const t: Type* = this.lookup_type_by_id(type_ref.id);
        if (t != null) {
            const cryo_align: u64 = t.alignment();
            if (cryo_align > 0) {
                return LType::const_int(LType::i64(), cryo_align, false);
            }
            // alignment() returned 0; TypeLowering didn't compute a
            // layout for this Type (typically InstantiatedType wrappers
            // like `Array<T>` whose computed_align never gets propagated
            // through the spec'd struct).  Fall back to LLVM's
            // authoritative alignment via `LLVMAlignOf`.  Without this
            // fallback, `Layout::array<T>` returned `Layout { size,
            // alignment: 0 }`, and `GlobalAlloc::reallocate` either
            // failed an alignment assertion or fell into a misaligned-
            // realloc path that crashed.
            const lty: LType = this.type_mapper.map_type(type_ref);
            if (lty.is_valid()) {
                return LValue { raw: llvm::LLVMAlignOf(lty.raw) };
            }
        }
        return LType::const_int(LType::i64(), 0, false);
    }


    // Casts

    codegen_cast(mut &this, val: LValue,
                 from_type: TypeRef, to_type: TypeRef) -> LValue {
        const src_type: Type* = this.lookup_type_by_id(from_type.id);
        const dst_type: Type* = this.lookup_type_by_id(to_type.id);
        if (src_type == null || dst_type == null) {
            return val;
        }

        const dest_ty: LType = this.type_mapper.map_type(to_type);

        const from_kind: TypeKind = src_type.kind;
        const to_kind: TypeKind = dst_type.kind;
        // Treat Char and Bool as integer-like for cast purposes; both
        // are integer types at the LLVM level (i32 and i1 respectively).
        // Without including Char here, casts like `s[i] as u64` (where
        // `s[i]: char`) fall through to the bitcast fallback and LLVM
        // rejects `bitcast i32 to i64` (bitcast requires same-size
        // operands).
        // A SIMPLE enum is its integer discriminant at the LLVM level, so
        // `E as int` / `int as E` is an integer cast at the discriminant's
        // width (handled in the int<->int block below; the default tag is
        // i32).  ADT enums are structs and fall through to the other paths.
        const from_enum: boolean = from_kind == TypeKind::Enum &&
                                   (src_type as EnumType*).is_simple_enum();
        const to_enum: boolean = to_kind == TypeKind::Enum &&
                                 (dst_type as EnumType*).is_simple_enum();
        const from_int: boolean = from_kind == TypeKind::Int || from_kind == TypeKind::Char || from_enum;
        const from_float: boolean = from_kind == TypeKind::Float;
        const to_int: boolean = to_kind == TypeKind::Int || to_kind == TypeKind::Char || to_enum;
        const to_float: boolean = to_kind == TypeKind::Float;
        // Treat `String`, `VaList` and `Function` as pointer types for cast
        // classification; all three are a pointer at the LLVM level, so
        // `string as i64` / `fnptr as u64` is semantically a ptrtoint (not a
        // bitcast, which requires same-size operands and LLVM rejects for
        // pointer <-> integer).  Same for `i64 as string` (inttoptr) and
        // `string <-> some_other_pointer` (pointer_cast / no-op under opaque
        // pointers).  A function VALUE is already the address of the code, not
        // a value needing a load, which is why it belongs here rather than
        // among the aggregates the bitcast fallback serves.
        const from_ptr: boolean = from_kind == TypeKind::Pointer ||
                                  from_kind == TypeKind::Reference ||
                                  from_kind == TypeKind::String ||
                                  from_kind == TypeKind::VaList ||
                                  from_kind == TypeKind::Function;
        const to_ptr: boolean = to_kind == TypeKind::Pointer ||
                                to_kind == TypeKind::Reference ||
                                to_kind == TypeKind::String ||
                                to_kind == TypeKind::VaList ||
                                to_kind == TypeKind::Function;

        if (from_int && to_int) {
            mut from_bits: u32 = 0;
            mut signed_src: boolean = false;
            if (from_kind == TypeKind::Int) {
                const from_it: IntType* = src_type as IntType*;
                from_bits = from_it.int_kind.bit_width() as u32;
                signed_src = from_it.int_kind.is_signed();
            } else if (from_kind == TypeKind::Char) {
                from_bits = 32;
                signed_src = false;
            } else if (from_enum) {
                // Width + signedness from the enum's discriminant base
                // (`type enum E : u8` -> 8/unsigned); default tag is i32.
                from_bits = 32;
                signed_src = true;
                const fet: EnumType* = src_type as EnumType*;
                if (fet.discriminant_type.is_valid()) {
                    const fdt: Type* = this.lookup_type_by_id(fet.discriminant_type.id);
                    if (fdt != null && fdt.kind == TypeKind::Int) {
                        from_bits = (fdt as IntType*).int_kind.bit_width() as u32;
                        signed_src = (fdt as IntType*).int_kind.is_signed();
                    }
                }
            }
            mut to_bits: u32 = 0;
            if (to_kind == TypeKind::Int) {
                const to_it: IntType* = dst_type as IntType*;
                to_bits = to_it.int_kind.bit_width() as u32;
            } else if (to_kind == TypeKind::Char) {
                to_bits = 32;
            } else if (to_enum) {
                to_bits = 32;
                const tet: EnumType* = dst_type as EnumType*;
                if (tet.discriminant_type.is_valid()) {
                    const tdt: Type* = this.lookup_type_by_id(tet.discriminant_type.id);
                    if (tdt != null && tdt.kind == TypeKind::Int) {
                        to_bits = (tdt as IntType*).int_kind.bit_width() as u32;
                    }
                }
            }
            if (from_bits == 0 || to_bits == 0 || !val.is_valid()) {
                return val;
            } else if (from_bits > to_bits) {
                return this.builder.build_trunc(val, dest_ty, "trunctmp");
            } else if (from_bits < to_bits) {
                if (signed_src) {
                    return this.builder.build_sext(val, dest_ty, "sexttmp");
                } else {
                    return this.builder.build_zext(val, dest_ty, "zexttmp");
                }
            } else {
                return val;  // Same width, no-op.
            }
        } else if (from_float && to_float) {
            const from_ft: FloatType* = src_type as FloatType*;
            const to_ft: FloatType* = dst_type as FloatType*;
            const from_fk: FloatKind = from_ft.float_kind;
            const to_fk: FloatKind = to_ft.float_kind;
            const from_bits: u64 = from_fk.bit_width();
            const to_bits: u64 = to_fk.bit_width();
            if (from_bits > to_bits) {
                return this.builder.build_fp_trunc(val, dest_ty, "fptrunctmp");
            } else if (from_bits < to_bits) {
                return this.builder.build_fp_ext(val, dest_ty, "fpexttmp");
            } else {
                return val;
            }
        } else if (from_int && to_float) {
            const from_it2: IntType* = src_type as IntType*;
            const from_ik2: IntegerKind = from_it2.int_kind;
            if (from_ik2.is_signed()) {
                return this.builder.build_si_to_fp(val, dest_ty, "sitofptmp");
            } else {
                return this.builder.build_ui_to_fp(val, dest_ty, "uitofptmp");
            }
        } else if (from_float && to_int) {
            const to_it2: IntType* = dst_type as IntType*;
            const to_ik2: IntegerKind = to_it2.int_kind;
            if (to_ik2.is_signed()) {
                return this.builder.build_fp_to_si(val, dest_ty, "fptositmp");
            } else {
                return this.builder.build_fp_to_ui(val, dest_ty, "fptouitmp");
            }
        } else if (from_ptr && to_ptr) {
            return this.builder.build_pointer_cast(val, dest_ty, "ptrcasttmp");
        } else if (from_int && to_ptr) {
            return this.builder.build_int_to_ptr(val, dest_ty, "inttoptr");
        } else if (from_ptr && to_int) {
            return this.builder.build_ptr_to_int(val, dest_ty, "ptrtoint");
        } else if (from_kind == TypeKind::Bool && to_int) {
            return this.builder.build_zext(val, dest_ty, "booltoint");
        } else {
            return this.builder.build_bitcast(val, dest_ty, "bitcasttmp");
        }
    }


    // String comparison

    /// Compare two i8* string values using strcmp.
    /// Returns i1: true if equal (==) or not equal (!=).
    codegen_string_compare(mut &this, lhs: LValue, rhs: LValue,
                           op_kind: TokenType) -> LValue {
        // `string == null` / `string != null` must NOT call strcmp;
        // strcmp dereferences both operands, so passing a null operand
        // is undefined behaviour (typically a segfault).  Detect the
        // null-literal case and lower it as a pointer-equality icmp
        // instead.  LLVMIsNull returns 1 for the constant null pointer.
        const lhs_is_null: i32 = llvm::LLVMIsNull(lhs.raw);
        const rhs_is_null: i32 = llvm::LLVMIsNull(rhs.raw);
        if (lhs_is_null != 0 || rhs_is_null != 0) {
            const pred: LIntPredicate = if (op_kind == TokenType::EqualEqual) { LIntPredicate::EQ } else { LIntPredicate::NE };
            return this.builder.build_icmp(pred, lhs, rhs, "strnullcmp");
        }

        // Ensure strcmp is declared: i32 strcmp(i8*, i8*)
        const strcmp_sym: SymbolStr = this.intern_str("strcmp");
        mut strcmp_fn: LValue = this.resolver.resolve_function(strcmp_sym);
        if (!strcmp_fn.is_valid()) {
            const i8_ptr: LType = LType::pointer_to(LType::i8());
            const param_buf: void* = libc::malloc(16);
            const params: void** = param_buf as void**;
            params[0] = i8_ptr.raw;
            params[1] = i8_ptr.raw;
            const strcmp_ty: LType = LType::function_type(LType::i32(), param_buf, 2, false);
            libc::free(param_buf);
            strcmp_fn = this.llvm_module.add_function("strcmp", strcmp_ty);
            this.functions.register(strcmp_sym, strcmp_fn);
        }

        const strcmp_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(strcmp_fn.raw) };
        const arg_buf: void* = libc::malloc(16);
        const args: void** = arg_buf as void**;
        args[0] = lhs.raw;
        args[1] = rhs.raw;
        const cmp_result: LValue = this.builder.build_call(strcmp_ty, strcmp_fn, arg_buf, 2, "strcmp");
        libc::free(arg_buf);

        const zero: LValue = LType::const_int(LType::i32(), 0, false);
        if (op_kind == TokenType::EqualEqual) {
            return this.builder.build_icmp(LIntPredicate::EQ, cmp_result, zero, "streq");
        } else {
            return this.builder.build_icmp(LIntPredicate::NE, cmp_result, zero, "strne");
        }
    }


    // Local variable declaration

    /// Generate IR for a local variable declaration.
    /// `site_span` is the source span of the variable's declaration
    /// node; used for diagnostics when the insert block or parent
    /// function are unexpectedly null (both indicate a codegen-ordering
    /// bug, so we point the user at the declaration that tripped the
    /// check).
    codegen_local_var(mut &this, name: SymbolStr,
                      ty: TypeRef, init_val: LValue,
                      has_init: boolean,
                      site_span: SourceSpan,
                      persistent_name: boolean) -> void {
        const var_name: string = this.resolve(name);
        const llvm_ty: LType = this.type_mapper.map_type(ty);
        if (!llvm_ty.is_valid()) {
            return;
        }

        // Void is unsized; LLVMBuildAlloca crashes in DataLayout::getAlignment.
        if (LType::kind_of(llvm_ty.raw) == LTypeKind::Void) {
            return;
        }

        const current_bb: LBasicBlock = this.builder.get_insert_block();
        if (!current_bb.is_valid()) {
            mut d: Diagnostic = Diagnostic::error(
                ErrorCode::E0607_VARIABLE_GENERATION_ERROR,
                format("codegen: local variable '%s': builder has no insert block", var_name));
            d = d.at(site_span);
            d = d.with_note("the codegen builder must have an insert block active when a local is declared; this usually means a statement was visited outside of any function body");
            this.diag.emit(d);
            return;
        }
        const current_fn: LValue = current_bb.get_parent();
        if (!current_fn.is_valid()) {
            this.diag.emit_error_at_span(ErrorCode::E0607_VARIABLE_GENERATION_ERROR,
                format("codegen: local variable '%s': insert block has no parent function", var_name),
                site_span);
            return;
        }

        const alloca: LValue = this.flow.create_entry_alloca(current_fn, var_name, llvm_ty);

        // `![align(N)]` raises a type's alignment, but LLVM sizes an alloca
        // from the ABI alignment of the MAPPED type, which carries no record
        // of the attribute - the padding that makes the type N bytes wide does
        // not make it N-aligned.  Raise the slot to what the type declares, or
        // the object is placed on a boundary the code generated against that
        // type already assumes it is on: a fault on the addresses that happen
        // to be wrong, and silent corruption of the neighbouring slot on the
        // ones that happen to be survivable.  Only ever raised - LLVM's own
        // choice is the floor.
        const decl_ty: Type* = this.lookup_type_by_id(ty.id);
        if (decl_ty != null) {
            const want_align: u64 = decl_ty.alignment();
            if (want_align > 0 && want_align > alloca.alignment() as u64) {
                alloca.set_alignment(want_align as u32);
            }
        }

        // Drop-flag slot: default it to false in the entry block so the
        // conditional drop's read is defined on every path, even ones that
        // skip this declaration (see ValueTable::set_persistent and
        // FlowEmitter::zero_init_in_entry).
        if (persistent_name) {
            this.flow.zero_init_in_entry(current_fn, alloca, llvm_ty);
        }

        if (has_init && init_val.is_valid()) {
            // Coerce integer literals to the variable's declared width
            // before storing.  `mut i: i64 = 0` arrives with `init_val`
            // as `i32 0` (codegen_literal defaults integer literals to
            // i32 when sema doesn't propagate the expected type) and
            // the i64 alloca is 8 bytes; a direct `store i32` writes
            // only the low 4 bytes, leaving the high 4 uninitialised.
            // zext/sext to the alloca type so the full slot is written;
            // same idea for the trunc direction (an i64 expression
            // initialising an i32 local).
            mut store_val: LValue = init_val;
            const init_ty_raw: void* = llvm::LLVMTypeOf(init_val.raw);
            if (init_ty_raw != null
                    && LType::kind_of(init_ty_raw) == LTypeKind::Integer
                    && LType::kind_of(llvm_ty.raw) == LTypeKind::Integer) {
                const want_bits: u32 = llvm::LLVMGetIntTypeWidth(llvm_ty.raw);
                const got_bits:  u32 = llvm::LLVMGetIntTypeWidth(init_ty_raw);
                if (want_bits > got_bits) {
                    // Widen with the variable's signedness; `mut x: i64 = -1`
                    // would otherwise zext the i32 -1 into 0xFFFFFFFF (a
                    // huge positive i64) instead of -1.
                    mut signed_target: boolean = false;
                    const ty_t: Type* = this.lookup_type_by_id(ty.id);
                    if (ty_t != null && ty_t.kind == TypeKind::Int) {
                        const ti: IntType* = ty_t as IntType*;
                        signed_target = ti.int_kind.is_signed();
                    }
                    if (signed_target) {
                        store_val = this.builder.build_sext(init_val, llvm_ty, "init.widen");
                    } else {
                        store_val = this.builder.build_zext(init_val, llvm_ty, "init.widen");
                    }
                } else if (want_bits < got_bits) {
                    store_val = this.builder.build_trunc(init_val, llvm_ty, "init.trunc");
                }
            }
            this.builder.build_store(store_val, alloca);
        }

        // Drop-flag locals register persistently: the conditional drop that
        // reads the flag can execute in an enclosing scope, after the block
        // that declared it has popped (the alloca itself is function-scoped).
        if (persistent_name) {
            this.values.set_persistent(name, alloca);
        } else {
            this.values.set(name, alloca);
        }
    }


    // Function call (with argument width / pointer coercion)

    /// Generate IR for a function call.  Coerces integer argument widths
    /// to match the callee's LLVM parameter types (e.g., i8->i32 for
    /// memset, i32->i64 for u64 params).
    ///
    /// Each `args[i]` carries the LLVM value (`.first`) and the Cryo-
    /// level type of that arg (`.second`).  The Cryo type drives the
    /// sext-vs-zext choice when the formal param is wider than the
    /// supplied value.  Use `TypeRef::invalid()` for slots where the
    /// type isn't known (low-level callers wiring up malloc/free/abort
    /// with already-matched widths); invalid slots fall back to `zext`.
    codegen_call(mut &this, callee: LValue, callee_type: LType, args: Pair<LValue, TypeRef>[], name: string) -> LValue {
        // Phase 1 - sret marshalling.  If the callee was declared with
        // `sret(%T)` on parameter slot 0, the LLVM-level signature is
        // `void f(ptr sret(%T), ...source params...)`.  Allocate a result
        // slot, prepend its address as the hidden first argument,
        // apply the sret call-site attribute, and synthesise the
        // struct value back to upstream callers by loading from the
        // slot.  This keeps `codegen_call`'s contract intact: callers
        // still get a struct value back from a struct-returning call.
        const sret_pointee: LType = this.abi.sret_pointee_of(callee);
        if (sret_pointee.is_valid()) {
            const cur_bb: LBasicBlock = this.builder.get_insert_block();
            mut fn_for_alloca: LValue = LValue::null();
            if (cur_bb.is_valid()) {
                fn_for_alloca = cur_bb.get_parent();
            }
            if (!fn_for_alloca.is_valid()) {
                // No enclosing function - extremely unusual; fall back
                // to the legacy path rather than crashing on alloca.
                return this.codegen_call_direct(callee, callee_type, args, name);
            }
            const slot: LValue = this.flow.create_entry_alloca(
                fn_for_alloca, "sret.tmp", sret_pointee);

            // Build the marshalled arg list: [slot, ...args].
            mut marshalled: Pair<LValue, TypeRef>[] = [];
            marshalled.push(Pair<LValue, TypeRef>::new(slot, TypeRef::invalid()));
            for (mut ai: i64 = 0; ai < args.length; ai++) {
                // Reconstruct from the (Copy) members rather than copying the
                // Pair element wholesale: Pair has an inherent Drop, so a
                // value-copy out of `args` reads as a droppable-element move
                // even though LValue/TypeRef are Copy and the drop is a no-op.
                marshalled.push(Pair<LValue, TypeRef>::new(args[ai].first, args[ai].second));
            }

            const call_val: LValue = this.codegen_call_direct(
                callee, callee_type, marshalled, "");
            if (call_val.is_valid()) {
                this.abi.apply_sret_call_attribute(call_val, sret_pointee);
            }

            // Synthesise the struct return value upstream callers
            // expect, by loading the freshly-written slot.
            const loaded: LValue = this.builder.build_load(
                sret_pointee, slot, name);
            return loaded;
        }

        return this.codegen_call_direct(callee, callee_type, args, name);
    }

    /// Variant of `codegen_call` for callees whose ABI cannot be
    /// recovered from LLVM function-attribute queries - primarily
    /// function-pointer invocations where `LLVMIsAFunction(callee)`
    /// is null and `sret_pointee_of` / `byval_pointee_of_param`
    /// silently return null.  Caller supplies the `SignaturePlan`
    /// it computed from the Cryo `FunctionType`, and this routine
    /// marshals the sret slot (if any), invokes
    /// `codegen_call_direct`, applies sret + byval call-site
    /// attributes from the plan, and loads the result back out of
    /// the sret slot when applicable.  The `callee_type` must equal
    /// `plan.llvm_fn_type`.
    codegen_call_with_plan(mut &this, callee: LValue, callee_type: LType,
                           plan: SignaturePlan, args: Pair<LValue, TypeRef>[],
                           name: string) -> LValue {
        const sret_pointee: LType = if (plan.sret_slot) {
            plan.return_plan.pointee_ty
        } else {
            LType::null()
        };

        if (sret_pointee.is_valid()) {
            const cur_bb: LBasicBlock = this.builder.get_insert_block();
            mut fn_for_alloca: LValue = LValue::null();
            if (cur_bb.is_valid()) {
                fn_for_alloca = cur_bb.get_parent();
            }
            if (!fn_for_alloca.is_valid()) {
                return this.codegen_call_direct(callee, callee_type, args, name);
            }
            const slot: LValue = this.flow.create_entry_alloca(
                fn_for_alloca, "sret.tmp", sret_pointee);

            mut marshalled: Pair<LValue, TypeRef>[] = [];
            marshalled.push(Pair<LValue, TypeRef>::new(slot, TypeRef::invalid()));
            for (mut ai: i64 = 0; ai < args.length; ai++) {
                // Reconstruct from the (Copy) members rather than copying the
                // Pair element wholesale: Pair has an inherent Drop, so a
                // value-copy out of `args` reads as a droppable-element move
                // even though LValue/TypeRef are Copy and the drop is a no-op.
                marshalled.push(Pair<LValue, TypeRef>::new(args[ai].first, args[ai].second));
            }

            const call_val: LValue = this.codegen_call_direct(
                callee, callee_type, marshalled, "");
            this.abi.apply_call_site_attrs_from_plan(call_val, &plan);

            return this.builder.build_load(sret_pointee, slot, name);
        }

        const call_val: LValue = this.codegen_call_direct(
            callee, callee_type, args, name);
        this.abi.apply_call_site_attrs_from_plan(call_val, &plan);
        return call_val;
    }

    /// Stack slot for an ABI coercion spill.  Only the alloca is hoisted to
    /// the entry block; the store stays where the caller emits it.
    coercion_slot(mut &this, ty: LType, name: string) -> LValue {
        return this.flow.temp_slot(ty, name);
    }

    /// Coerce one call argument from the LLVM type it actually has to the
    /// type the callee's signature declares for its slot.  Dispatch is keyed on
    /// the (expected, actual) `LTypeKind` pair; `slot_index` distinguishes the
    /// receiver slot, whose pointer/integer disagreements mean something
    /// different from an ordinary argument's.
    ///
    /// Shared by the 1:1 marshalling loop and by `codegen_call_direct_dp_expand`'s
    /// non-expanded slots.  The DirectPair path used to carry its own reduced copy
    /// implementing 4 of these branches, so a call that needed an expanded 9-16
    /// byte aggregate arg AND any of the missing coercions on another arg passed a
    /// wrong-typed value silently.
    coerce_call_arg(mut &this, expected_ty: void*, arg_val_in: LValue,
                    arg_ty_ref: TypeRef, slot_index: u32,
                    expected_count: u32) -> LValue {
        mut arg_val: LValue = arg_val_in;
        // Every spill slot below goes through `coercion_slot`, not
        // `build_alloca`: a coerced call inside a loop body would otherwise
        // allocate a fresh slot per iteration.
        const actual_ty: void* = llvm::LLVMTypeOf(arg_val.raw);
        // Compare by LLVM type kind first to dispatch to
        // shape-aware coercion branches (ptr<->struct, ptr<->int,
        // struct->scalar, etc.).  When kinds match we fall
        // through to the equal-kinds branches further down
        // and use direct void* identity (`expected_ty !=
        // actual_ty`) to catch named-vs-literal struct
        // mismatches and similar.
        const ek: LTypeKind = LType::kind_of(expected_ty);
        const ak: LTypeKind = LType::kind_of(actual_ty);

        // A <= 8 byte aggregate parameter lowers to a single
        // register slot (Direct-with-coercion).  When the
        // source arrives as a *pointer* (the address of an lvalue,
        // or a `T*` / `&T` pointing at the aggregate) facing a
        // register-shaped slot, the register must hold the
        // aggregate's bytes, so load them through the pointer.
        // The generic `Integer <- Pointer` branch below would
        // otherwise `ptrtoint` the address itself and pass the
        // pointer where the callee expects the aggregate's
        // contents (e.g. the 8-byte `LBuilder` reached via
        // `this.builder: LBuilder*`, whose `.raw` handle would
        // become the struct's address - a runtime crash the
        // verifier can't catch).  The struct-*value* case is
        // handled by the Integer/Float/Double/Vector <- Struct
        // branch below.
        mut agg_coerced: boolean = false;
        const ek_reg_c: boolean = ek == LTypeKind::Integer
            || ek == LTypeKind::Float
            || ek == LTypeKind::Double
            || ek == LTypeKind::Vector;
        if (arg_val.is_valid() && ek_reg_c && ak == LTypeKind::Pointer) {
            const asz_c: u64 = this.agg_register_size(
                actual_ty, arg_ty_ref, ak);
            if (asz_c > 0 && asz_c <= 8) {
                const reg_lty: LType = LType { raw: expected_ty };
                arg_val = this.builder.build_load(
                    reg_lty, arg_val, "arg.coerced");
                agg_coerced = true;
            }
        }

        if (!agg_coerced && ek != ak) {
            if (ek == LTypeKind::Pointer && ak == LTypeKind::Struct) {
                // Expected ptr, actual struct: the struct value
                // came from `codegen_rvalue` loading through
                // some lvalue.  If we can recover that pre-load
                // address (`val` is a Load whose only operand is
                // the original pointer), use it directly - that
                // preserves identity so callees that mutate the
                // struct see the caller's memory.  Otherwise
                // fall back to a fresh temp alloca + store +
                // addr-of.  LLVMOpcode::Load = 27.
                mut handled: boolean = false;
                const opcode: i32 = llvm::LLVMGetInstructionOpcode(arg_val.raw);
                if (opcode == 27) {
                    const ptr_operand: void* = llvm::LLVMGetOperand(arg_val.raw, 0);
                    if (ptr_operand != null) {
                        arg_val = LValue { raw: ptr_operand };
                        handled = true;
                    }
                }
                if (!handled) {
                    const st: LType = LType { raw: actual_ty };
                    const tmp: LValue = this.coercion_slot(st, "arg.ref");
                    this.builder.build_store(arg_val, tmp);
                    arg_val = tmp;
                }
            } else if (ek == LTypeKind::Pointer
                       && (ak == LTypeKind::Float || ak == LTypeKind::Double)) {
                // Expected a pointer (a `&f32`/`&f64` reference
                // parameter), but the argument arrived as a loaded
                // SSE scalar.  This happens when a reference-typed
                // binding - e.g. a float payload bound by
                // `match (&opt) { Some(b) => ... }` - is passed bare
                // to a `&Self` parameter; the conditional `Eq`/`Ord`
                // impls on `Option<f64>` do exactly this via
                // `a.equals(b)`.  `codegen_rvalue` loaded the referent
                // to a `double`/`float`, so recover the address rather
                // than passing the value: there is no float<->pointer
                // auto-coercion, and passing the scalar trips the LLVM
                // verifier ("Call parameter type does not match
                // function signature").  Mirror the `ptr <- struct`
                // branch above - reuse the Load's source pointer when
                // possible (identity-preserving, matching the
                // receiver-side autoref), else spill to a temp slot
                // and take its address.  LLVMOpcode::Load = 27.
                mut handled_f: boolean = false;
                const opcode_f: i32 = llvm::LLVMGetInstructionOpcode(arg_val.raw);
                if (opcode_f == 27) {
                    const ptr_operand_f: void* = llvm::LLVMGetOperand(arg_val.raw, 0);
                    if (ptr_operand_f != null) {
                        arg_val = LValue { raw: ptr_operand_f };
                        handled_f = true;
                    }
                }
                if (!handled_f) {
                    const fst: LType = LType { raw: actual_ty };
                    const ftmp: LValue = this.coercion_slot(fst, "arg.faddr");
                    this.builder.build_store(arg_val, ftmp);
                    arg_val = ftmp;
                }
            } else if (ek == LTypeKind::Struct && ak == LTypeKind::Pointer) {
                const st: LType = LType { raw: expected_ty };
                arg_val = this.builder.build_load(st, arg_val, "arg.deref");
            } else if ((ek == LTypeKind::Float || ek == LTypeKind::Double) && ak == LTypeKind::Pointer) {
                const ft: LType = LType { raw: expected_ty };
                arg_val = this.builder.build_load(ft, arg_val, "arg.deref");
            } else if (ek == LTypeKind::Integer && ak == LTypeKind::Pointer && expected_count > 0 && slot_index == 0) {
                const it: LType = LType { raw: expected_ty };
                arg_val = this.builder.build_load(it, arg_val, "arg.deref");
            } else if (ek == LTypeKind::Pointer && ak == LTypeKind::Integer) {
                // Expected ptr, actual integer.  For the
                // receiver slot (i==0) this is a primitive
                // method on an rvalue; spill to a stack temp and
                // pass the slot's address.
                if (slot_index == 0) {
                    const slot_lty: LType = LType { raw: actual_ty };
                    const slot: LValue = this.coercion_slot(slot_lty, "recv.slot");
                    this.builder.build_store(arg_val, slot);
                    arg_val = slot;
                } else if (llvm::LLVMGetInstructionOpcode(arg_val.raw) == 27) {
                    // The integer is a Load of an lvalue, not a
                    // genuine value-as-address.  This is the
                    // integer twin of the float bug above: a
                    // reference-typed binding (an integer payload
                    // bound by `match (&x) { Some(b) => ... }`)
                    // passed bare to a `&T` parameter; codegen_rvalue
                    // loaded the referent to an integer.  Naively
                    // `inttoptr`-ing that VALUE would pass e.g.
                    // address 0x1 for the payload 1, so the callee's
                    // `*other` would dereference garbage and segfault at
                    // runtime (the verifier is happy because
                    // inttoptr does yield a `ptr`).  Recover the
                    // address instead, exactly like the `ptr <-
                    // struct`/`ptr <- float` branches: reuse the
                    // Load's source pointer (identity-preserving,
                    // matching the receiver-side autoref).
                    // LLVMOpcode::Load = 27.  Non-Load integers
                    // (literal `0`/`null` constants, computed
                    // address values) keep the legitimate inttoptr
                    // below.
                    mut handled_i: boolean = false;
                    const ptr_operand_i: void* = llvm::LLVMGetOperand(arg_val.raw, 0);
                    if (ptr_operand_i != null) {
                        arg_val = LValue { raw: ptr_operand_i };
                        handled_i = true;
                    }
                    if (!handled_i) {
                        arg_val = LValue { raw: llvm::LLVMBuildIntToPtr(this.builder.raw, arg_val.raw, expected_ty, "arg.i2p") };
                    }
                } else {
                    arg_val = LValue { raw: llvm::LLVMBuildIntToPtr(this.builder.raw, arg_val.raw, expected_ty, "arg.i2p") };
                }
            } else if (ek == LTypeKind::Integer && ak == LTypeKind::Pointer) {
                arg_val = LValue { raw: llvm::LLVMBuildPtrToInt(this.builder.raw, arg_val.raw, expected_ty, "arg.p2i") };
            } else if ((ek == LTypeKind::Integer
                        || ek == LTypeKind::Float
                        || ek == LTypeKind::Double
                        || ek == LTypeKind::Vector)
                       && ak == LTypeKind::Struct) {
                // Small-aggregate param passed by value.  The
                // callee's LLVM signature has a register-sized
                // scalar slot (integer for INTEGER class,
                // float/double for single-field SSE class,
                // `<2 x float>` for two-F32 SSE class) where the
                // Cryo source type is a <= 8-byte struct.  Spill
                // the struct value to a slot typed as the
                // scalar/vector and reload it; the slot's storage
                // size matches the struct's byte width by
                // construction.  This is the inverse of the
                // receiver-side coercion on the callee side.
                const slot_lty: LType = LType { raw: expected_ty };
                const slot_p: LValue = this.coercion_slot(slot_lty, "arg.coerce");
                this.builder.build_store(arg_val, slot_p);
                arg_val = this.builder.build_load(slot_lty, slot_p, "arg.coerced");
            } else if (ek == LTypeKind::Struct
                       && (ak == LTypeKind::Integer
                           || ak == LTypeKind::Float
                           || ak == LTypeKind::Double
                           || ak == LTypeKind::Vector)) {
                // Inverse case - the arg is a register-shaped
                // scalar/vector coming out of a <= 8-byte
                // aggregate return (Direct-with-coercion), but
                // the receiving param wants the source-level
                // named struct.  Alloca with the scalar type so
                // the store doesn't overflow, then reload at the
                // named struct.
                const slot_lty: LType = LType { raw: actual_ty };
                const slot_p: LValue = this.coercion_slot(slot_lty, "arg.reshape");
                this.builder.build_store(arg_val, slot_p);
                const exp_lty: LType = LType { raw: expected_ty };
                arg_val = this.builder.build_load(exp_lty, slot_p, "arg.reshaped");
            }
        } else if (ek == LTypeKind::Struct && ak == LTypeKind::Struct
                   && expected_ty != actual_ty) {
            // Both Struct but distinct LLVM types: the arg is
            // the anonymous `{lo, hi}` literal struct from a
            // DirectPair-classified callee return (or
            // another layout-compatible-but-not-identical
            // struct, e.g. anonymous `Option<i32>` layout vs.
            // the source-level named type).  Spill-then-reload
            // at the expected named struct.  Catches cases
            // where the post-call coercion couldn't fire
            // (e.g. node.resolved_type didn't resolve fully
            // through generic instantiation) but the param-
            // type disagreement is unambiguous.
            const slot_lty: LType = LType { raw: actual_ty };
            const slot_p: LValue = this.coercion_slot(slot_lty, "arg.reshape");
            this.builder.build_store(arg_val, slot_p);
            const exp_lty: LType = LType { raw: expected_ty };
            arg_val = this.builder.build_load(exp_lty, slot_p, "arg.reshaped");
        } else if (ek == LTypeKind::Integer && ak == LTypeKind::Integer) {
            // Both integers: coerce widths if needed.  Picking
            // sext vs zext from the *source* Cryo type's
            // signedness is load-bearing: an i32 holding `-1`
            // (0xFFFFFFFF) widened to i64 must become
            // 0xFFFFFFFFFFFFFFFF (sext), not 0x00000000FFFFFFFF
            // (zext).  Defaulting to zext silently corrupted any
            // negative signed-narrow arg passed to a wider
            // parameter.
            const ew: u32 = llvm::LLVMGetIntTypeWidth(expected_ty);
            const aw: u32 = llvm::LLVMGetIntTypeWidth(actual_ty);
            if (aw < ew) {
                const target: LType = LType { raw: expected_ty };
                mut src_signed: boolean = false;
                if (arg_ty_ref.is_valid()) {
                    const at_t: Type* = this.lookup_type_by_id(arg_ty_ref.id);
                    if (at_t != null && at_t.kind == TypeKind::Int) {
                        const it: IntType* = at_t as IntType*;
                        src_signed = it.int_kind.is_signed();
                    }
                }
                if (src_signed) {
                    arg_val = this.builder.build_sext(arg_val, target, "arg.widen");
                } else {
                    arg_val = this.builder.build_zext(arg_val, target, "arg.widen");
                }
            } else if (aw > ew) {
                const target: LType = LType { raw: expected_ty };
                arg_val = this.builder.build_trunc(arg_val, target, "arg.trunc");
            }
        }
        return arg_val;
    }

    /// Emit the callee call, choosing `invoke` over `call` when CallEmitter
    /// has armed the transient invoke state for this call (the frame has live
    /// droppable locals under `--panic=unwind`).  On `invoke`, control returns
    /// to `invoke_normal` on success and `invoke_lpad` (a cleanup landing pad)
    /// on unwind; the builder is left at `invoke_normal` so post-call codegen
    /// (sret load, byval attrs, return coercion) continues on the normal path,
    /// NOT after the invoke terminator.  The flag is consumed on first use so a
    /// single activation emits exactly one invoke (args are fully emitted
    /// before this point, so no nested call re-enters the armed state).
    build_call_maybe_invoke(mut &this, fn_ty: LType, fn_val: LValue,
                            args: void*, num_args: u32, name: string) -> LValue {
        if (this.invoke_active) {
            this.invoke_active = false;
            const then_bb: LBasicBlock = this.invoke_normal;
            const catch_bb: LBasicBlock = this.invoke_lpad;
            const inv: LValue = this.builder.build_invoke(
                fn_ty, fn_val, args, num_args, then_bb, catch_bb, name);
            this.builder.position_at_end(then_bb);
            return inv;
        }
        return this.builder.build_call(fn_ty, fn_val, args, num_args, name);
    }

    /// Get-or-declare the exception personality routine `__cryo_personality_v0`
    /// against the shared Itanium `_Unwind_*` Level-1 ABI:
    /// `i32 (i32 version, i32 actions, i64 exn_class, ptr exn, ptr context)`.
    /// Attached to every function that grows a cleanup landing pad; the
    /// definition is linked in from the `panic/unwind` runtime tier under
    /// `--panic=unwind`.
    get_or_decl_personality(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("__cryo_personality_v0");
        if (fn.is_valid()) { return fn; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const param_buf: void* = libc::malloc(40);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = LType::i32().raw;
        param_slots[1] = LType::i32().raw;
        param_slots[2] = LType::i64().raw;
        param_slots[3] = ptr_ty.raw;
        param_slots[4] = ptr_ty.raw;
        const fty: LType = LType::function_type(LType::i32(), param_buf, 5, false);
        libc::free(param_buf);
        return this.llvm_module.add_function("__cryo_personality_v0", fty);
    }

    /// The `{ ptr, i32 }` landing-pad result type (exception object pointer +
    /// selector).  LLVM uniques literal struct types by structure within a
    /// context, so this returns the same type on every call in a module.
    landingpad_type(mut &this) -> LType {
        const elems_buf: void* = libc::malloc(16);
        const elems: void** = elems_buf as void**;
        elems[0] = LType::pointer_to(LType::i8()).raw;
        elems[1] = LType::i32().raw;
        const t: LType = LType::literal_struct(elems_buf, 2, false);
        libc::free(elems_buf);
        return t;
    }

    // ---- live anonymous arg-temp tracking (`--panic=unwind`) -------------
    //
    // A dedicated stack (kept in small methods so CallEmitter never manipulates
    // it inline - an inline array-stack push/pop embedded in the large call
    // emitter miscompiled the inc-4 named path). CallEmitter opens a frame per
    // in-progress call, pushes a `<name>.drop()` statement per anonymous owning
    // temp, and closes the frame once the call is fully built.

    /// Open a frame for a call whose arguments are about to be evaluated.
    open_arg_temp_frame(mut &this) -> void {
        this.arg_temp_frames.push(this.arg_temp_drops.length);
    }

    /// Close the innermost frame: the call is fully built, so its argument
    /// temporaries are now owned by the callee and drop out of the live set.
    /// Read-then-truncate (mirrors DropInserter::close_pending_arg_frame).
    close_arg_temp_frame(mut &this) -> void {
        const top: i64 = this.arg_temp_frames.length;
        if (top == 0) { return; }
        const start: i64 = this.arg_temp_frames[top - 1];
        this.arg_temp_frames.pop();
        while (this.arg_temp_drops.length > start) {
            this.arg_temp_drops.pop();
        }
    }

    /// Record a ready-made `<name>.drop()` statement for a live anonymous owning
    /// arg temp (built by CallEmitter, whose name is bound to the temp's slot in
    /// the value table).
    push_arg_temp_drop(mut &this, stmt: ASTNode*) -> void {
        if (stmt != null) { this.arg_temp_drops.push(stmt); }
    }

    /// True when a panic origin must invoke into a cleanup pad to drop live
    /// anonymous arg temps.  Suppressed while a pad is already replaying its
    /// drops, so a drop-call emitted inside the pad does not re-invoke.
    has_live_arg_temps(&this) -> boolean {
        return this.arg_temp_drops.length > 0 && !this.suppress_arg_temp_invoke;
    }

    /// Schedule-driven cleanup landing pad for `--panic=unwind`, shared by the
    /// ordinary-call path (CallEmitter forwards to here) and the synthesized
    /// check origins.  Builds a cleanup-only `landingpad` at `lpad_bb`, drops the
    /// live anonymous arg temps (whole stack, most-recent first - at the panic
    /// point the enclosing calls have not run, so this pad is the only one that
    /// frees them), replays the drop schedule (`sched`, innermost-first, each a
    /// drop-call statement up-cast to `ASTNode*`) via `accept(visitor)`, then
    /// `resume`s.  Attaches the personality to `cur_fn` (idempotent) and restores
    /// the builder to where it was called from.  `invoke_active` is clear here,
    /// so a drop that itself unwinds propagates without re-entering this pad; the
    /// arg-temp invoke path is suppressed across both replays so a drop-call does
    /// not re-drop the stack.
    emit_cleanup_landingpad_sched(mut &this, visitor: ASTVisitor*, sched: ASTNode*[]*,
                                  cur_fn: LValue, lpad_bb: LBasicBlock) -> void {
        const saved_bb: LBasicBlock = this.builder.get_insert_block();
        const pers: LValue = this.get_or_decl_personality();
        if (pers.is_valid()) { cur_fn.set_personality_fn(pers); }
        this.builder.position_at_end(lpad_bb);
        const lpad_ty: LType = this.landingpad_type();
        const lp: LValue = this.builder.build_landing_pad(lpad_ty, 0, "lpad");
        lp.set_cleanup(true);
        const saved_suppress: boolean = this.suppress_arg_temp_invoke;
        this.suppress_arg_temp_invoke = true;
        for (mut a: i64 = this.arg_temp_drops.length - 1; a >= 0; a--) {
            const t: ASTNode* = this.arg_temp_drops[a];
            if (t != null) { (t as StatementNode*).accept(visitor); }
        }
        for (mut i: i64 = 0; i < sched.length; i++) {
            const d: ASTNode* = sched[i];
            if (d != null) { (d as StatementNode*).accept(visitor); }
        }
        this.suppress_arg_temp_invoke = saved_suppress;
        this.builder.build_resume(lp);
        if (saved_bb.is_valid()) { this.builder.position_at_end(saved_bb); }
    }

    /// Emit a diverging raise through `__cryo_panic(msg, file, line)` for a
    /// synthesized check (div-by-zero, non-exhaustive match, `new[]` overflow)
    /// under `--panic=unwind`.  When the frame has live droppable locals
    /// (`sched` non-empty) the raise is an `invoke` into a cleanup landing pad
    /// that drops them before the unwind continues; otherwise a plain `call`.
    /// Either way it diverges (`unreachable` on the normal edge).  Callers gate
    /// this on `ctx.project_panic_unwind` and keep the `abort` trap on the
    /// default path, so emitted IR is unchanged there.
    emit_panic_diverge_cleanup(mut &this, visitor: ASTVisitor*, sched: ASTNode*[]*,
                               msg: LValue, file: LValue, line: LValue) -> void {
        const panic_fn: LValue = this.intrinsics.get_or_decl_cryo_panic();
        if (!panic_fn.is_valid()) { return; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const param_buf: void* = libc::malloc(24);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ptr_ty.raw;
        param_slots[1] = ptr_ty.raw;
        param_slots[2] = LType::i32().raw;
        const fty: LType = LType::function_type(LType::void_type(), param_buf, 3, false);
        libc::free(param_buf);
        const arg_buf: void* = libc::malloc(24);
        const arg_slots: void** = arg_buf as void**;
        arg_slots[0] = msg.raw;
        arg_slots[1] = file.raw;
        arg_slots[2] = line.raw;

        // Live anonymous arg temps also demand the invoke+pad path even when the
        // frame has no named schedule (`sched` empty): a div/bounds/no-match/
        // overflow check nested in a later argument must drop the temps built by
        // earlier arguments before the unwind leaves the frame.
        const has_cleanup: boolean = (sched != null && sched.length > 0)
            || this.has_live_arg_temps();
        if (has_cleanup) {
            const cur_bb: LBasicBlock = this.builder.get_insert_block();
            const cur_fn: LValue = cur_bb.get_parent();
            const cont_bb: LBasicBlock = LBasicBlock::append(cur_fn, "check.cont");
            const lpad_bb: LBasicBlock = LBasicBlock::append(cur_fn, "check.lpad");
            this.invoke_active = true;
            this.invoke_normal = cont_bb;
            this.invoke_lpad   = lpad_bb;
            this.build_call_maybe_invoke(fty, panic_fn, arg_buf, 3, "");
            this.invoke_active = false;
            libc::free(arg_buf);
            this.builder.build_unreachable();
            this.emit_cleanup_landingpad_sched(visitor, sched, cur_fn, lpad_bb);
        } else {
            this.builder.build_call(fty, panic_fn, arg_buf, 3, "");
            libc::free(arg_buf);
            this.builder.build_unreachable();
        }
    }

    /// Build the `(message, file, line)` args for a synthesized check from a
    /// compile-time `message` and the origin's `span`, then raise + clean up via
    /// `emit_panic_diverge_cleanup`.  The shared body of every synthesized-check
    /// raise (div-by-zero, non-exhaustive match, `new[]` overflow).
    emit_check_raise(mut &this, visitor: ASTVisitor*, sched: ASTNode*[]*,
                     span: SourceSpan, message: string) -> void {
        const msg: LValue = this.builder.build_global_string_ptr(message, "check.msg");
        mut filename: string = span.file;
        if (filename == null || filename.length() == 0) { filename = "<unknown>"; }
        const file: LValue = this.builder.build_global_string_ptr(filename, "check.file");
        const line: LValue = LType::const_int(LType::i32(), span.start_line as u64, false);
        this.emit_panic_diverge_cleanup(visitor, sched, msg, file, line);
    }

    /// The pre-Phase-1 call lowering: coerce integer widths to match
    /// the callee's expected param types, then `build_call`.  Split out
    /// of `codegen_call` so the sret-marshalling wrapper can call
    /// through to the same coercion logic.
    codegen_call_direct(mut &this, callee: LValue, callee_type: LType, args: Pair<LValue, TypeRef>[], name: string) -> LValue {
        mut out_value: LValue = LValue::null();
        const n: u32 = args.length as u32;

        if (n == 0) {
            out_value = this.build_call_maybe_invoke(callee_type, callee, null, 0, name);
            return out_value;
        }

        // Get expected parameter types for argument coercion.
        // callee_type is the function type passed to LLVMBuildCall2.
        // Even though LLVMGetTypeKind may report it as pointer (opaque
        // ptr era), LLVMCountParamTypes still works on function types.
        // Also try LLVMCountParams on the callee value as fallback.
        mut expected_count: u32 = llvm::LLVMCountParamTypes(callee_type.raw);
        mut param_types_buf: void* = null;
        if (expected_count > 0 && expected_count <= 64) {
            param_types_buf = libc::malloc(expected_count as u64 * 8);
            llvm::LLVMGetParamTypes(callee_type.raw, param_types_buf);
        }

        // DirectPair param expansion path.  When the callee's LLVM
        // signature has more parameter slots than the source arg list
        // provides, the surplus came from a 9-16 byte aggregate that
        // `classify_param` lowered to two register slots (DirectPair).
        // Re-route to the expansion-aware marshalling routine; the 1:1
        // path below stays the hot shape for every other call site.
        // This fires for ordinary Cryo-internal calls (any function
        // taking a 9-16 byte aggregate by value), not just extern-C.
        if (param_types_buf != null && expected_count > n) {
            const r: LValue = this.codegen_call_direct_dp_expand(
                callee, callee_type, args, param_types_buf, expected_count, name);
            libc::free(param_types_buf);
            return r;
        }

        // Build argument array, coercing integer widths where needed.
        const buf: void* = libc::malloc(n as u64 * 8);
        const slots: void** = buf as void**;
        const param_types: void** = param_types_buf as void**;
        for (mut i: u32 = 0; i < n; i++) {
            mut arg_val: LValue = args[i as i64].first;
            const arg_ty_ref: TypeRef = args[i as i64].second;
            if (arg_val.is_valid() && param_types_buf != null && i < expected_count) {
                arg_val = this.coerce_call_arg(param_types[i], arg_val,
                                               arg_ty_ref, i, expected_count);
            }
            slots[i] = arg_val.raw;
        }
        if (param_types_buf != null) { libc::free(param_types_buf); }

        out_value = this.build_call_maybe_invoke(callee_type, callee, buf, n, name);
        libc::free(buf);

        // Phase 2 - propagate `byval(%T)` from the callee's parameter
        // attributes onto the matching call-site slots.  In this 1:1 path
        // each source arg fills exactly one LLVM slot, so the LLVM slot
        // index equals the source ordinal and `n` slots were emitted.
        this.apply_byval_call_attributes(callee, out_value, n);

        return out_value;
    }

    /// Propagate the callee's `byval(%T)` parameter attributes onto the
    /// matching call-site argument slots.  Driven off the *LLVM slot
    /// index*, not the source-argument ordinal: `byval_pointee_of_param`
    /// queries the callee's LLVM parameter at index `s`, and the call was
    /// built with one argument per LLVM slot (`buf[s]`), so the same `s`
    /// names both ends.  This matters when a 9-16 byte DirectPair param
    /// (two slots) precedes a >16 byte byval param: the byval attribute
    /// must land on its true slot, not on the source ordinal (which lags
    /// by the surplus DirectPair slot).  The struct -> ptr coercion in
    /// the marshalling loops already arranged for each byval slot to be a
    /// pointer-to-temp; the attribute tells the backend this is a
    /// by-value copy (not aliasing).  Skipped for function-pointer
    /// callees: `byval_pointee_of_param` is gated by `LLVMIsAFunction`
    /// and silently returns null in that case (tracked under the
    /// function-pointer ABI gap).
    apply_byval_call_attributes(mut &this, callee: LValue, call_val: LValue,
                                slot_count: u32) -> void {
        if (!call_val.is_valid()) { return; }
        for (mut s: u32 = 0; s < slot_count; s++) {
            const pointee_b: LType = this.abi.byval_pointee_of_param(callee, s);
            if (pointee_b.is_valid()) {
                this.abi.apply_byval_call_attribute(call_val, s, pointee_b);
            }
        }
    }


    /// DirectPair param expansion variant of `codegen_call_direct`.
    /// Walks source args alongside expected LLVM slots, materialising one
    /// source aggregate into two LLVM register args when it is a 9-16
    /// byte aggregate facing a register pair.  The aggregate arrives as a
    /// struct value, an lvalue address, or a pointer/reference to the
    /// aggregate; `agg_register_size` recovers its size from the lowered
    /// LLVM type in every case.  Reached via the early dispatch in
    /// `codegen_call_direct` (when `expected_count > n`); ordinary
    /// Cryo-internal calls hit this, not just extern-C.
    codegen_call_direct_dp_expand(mut &this, callee: LValue, callee_type: LType,
                                  args: Pair<LValue, TypeRef>[],
                                  param_types_buf: void*, expected_count: u32,
                                  name: string) -> LValue {
        const n: u32 = args.length as u32;
        const param_types: void** = param_types_buf as void**;
        const buf: void* = libc::malloc(expected_count as u64 * 8);
        const slots: void** = buf as void**;

        mut source_idx: u32 = 0;
        mut llvm_slot_idx: u32 = 0;
        while (source_idx < n && llvm_slot_idx < expected_count) {
            mut arg_val: LValue = args[source_idx as i64].first;
            const arg_ty_ref: TypeRef = args[source_idx as i64].second;
            const expected_ty: void* = param_types[llvm_slot_idx];
            // A null argument means an upstream codegen failure already
            // produced (and queued) a diagnostic for the argument
            // expression - e.g. an unresolved nested callee. Bail rather
            // than calling `LLVMTypeOf(null)` (a hard segfault inside
            // libLLVM): the function-body validator sees the unterminated
            // body and the queued error surfaces normally.
            if (arg_val.raw == null) {
                libc::free(buf);
                return LValue::null();
            }
            const actual_ty: void* = llvm::LLVMTypeOf(arg_val.raw);
            const ek: LTypeKind = LType::kind_of(expected_ty);
            const ak: LTypeKind = LType::kind_of(actual_ty);

            // Determine whether this source arg feeds a 9-16 byte
            // DirectPair parameter - two consecutive register slots that
            // a single source aggregate splits across.
            //
            // The aggregate arrives either as a loaded struct *value*
            // (`ak == Struct`) or as the *address* of an lvalue
            // (`ak == Pointer` facing a register-shaped expected slot - a
            // genuine pointer parameter always faces a `Pointer` slot, so
            // a register slot opposite a pointer source means the callee
            // split an aggregate into registers).
            //
            // Slot count comes from the *lowered* LLVM size when the
            // source is a recognisable aggregate (`actual_ty` for a
            // value, `map_type(arg_ty_ref)` for a struct address) -
            // `map_type` resolves even unresolved `InstantiatedType`
            // wrappers whose Cryo `size_bytes()` would be 0, so it never
            // under-counts the way the classifier's source-type unwrap
            // can.  When the source carries no struct size (e.g. a
            // `string` literal implicitly coerced to a `Str` parameter,
            // where the value is a bare `i8*`), the callee's slot budget
            // is the authority: a positive surplus of unfilled slots over
            // remaining source args, with a register pair ahead, means
            // this arg owns both slots.  Under-counting here would leave
            // the `hi` register a null operand (codegen crash in
            // `CallInst::init` / verifier failure / heap corruption).
            const ek_is_reg: boolean = ek == LTypeKind::Integer
                || ek == LTypeKind::Float
                || ek == LTypeKind::Double
                || ek == LTypeKind::Vector;
            mut next_is_reg: boolean = false;
            if (llvm_slot_idx + 1 < expected_count) {
                const nk: LTypeKind = LType::kind_of(param_types[llvm_slot_idx + 1]);
                next_is_reg = nk == LTypeKind::Integer
                    || nk == LTypeKind::Float
                    || nk == LTypeKind::Double
                    || nk == LTypeKind::Vector;
            }

            mut agg_size: u64 = 0;
            mut agg_from_value: boolean = false;   // struct value in hand
            mut agg_ptr: LValue = LValue::null();   // address of the aggregate
            if (ek_is_reg) {
                agg_size = this.agg_register_size(actual_ty, arg_ty_ref, ak);
                if (ak == LTypeKind::Struct) {
                    agg_from_value = true;
                } else if (ak == LTypeKind::Pointer) {
                    agg_ptr = arg_val;
                }
            }

            // DirectPair: a 9-16 byte aggregate fills two register slots.
            mut do_dp: boolean = false;
            if (ek_is_reg && next_is_reg) {
                if (agg_size > 8 && agg_size <= 16) {
                    do_dp = true;
                } else if (ak == LTypeKind::Pointer && agg_size == 0) {
                    // Source is a bare pointer with no struct size (a
                    // primitive coerced to a register-pair aggregate).
                    // Fall back to the callee's slot budget.
                    const slots_left: u32 = expected_count - llvm_slot_idx;
                    const args_left: u32 = n - source_idx;
                    if (slots_left > args_left) { do_dp = true; }
                }
            }

            if (do_dp) {
                // Obtain a pointer to the aggregate's storage: spill a
                // struct value to a temp, or use the lvalue / coerced
                // address directly.  GEP at byte offsets 0 and 8 (via an
                // i8 base type) for the two halves and load each at its
                // slot's LLVM type.
                mut src_ptr: LValue = agg_ptr;
                if (agg_from_value) {
                    const struct_lty: LType = LType { raw: actual_ty };
                    src_ptr = this.coercion_slot(struct_lty, "arg.dp.tmp");
                    this.builder.build_store(arg_val, src_ptr);
                }

                // Lo half: load directly from the aggregate (offset 0).
                const lo_lty: LType = LType { raw: expected_ty };
                const lo_val: LValue = this.builder.build_load(lo_lty, src_ptr, "arg.dp.lo");

                // Hi half: GEP `i8, ptr %src, i64 8` then load.
                const i8_ty: LType = LType::i8();
                const idx_buf: void* = libc::malloc(8);
                const idx_arr: void** = idx_buf as void**;
                const eight: LValue = LType::const_int(LType::i64(), 8, false);
                idx_arr[0] = eight.raw;
                const hi_ptr: LValue = this.builder.build_gep(
                    i8_ty, src_ptr, idx_buf, 1, "arg.dp.hi.ptr");
                libc::free(idx_buf);

                const hi_lty: LType = LType { raw: param_types[llvm_slot_idx + 1] };
                const hi_val: LValue = this.builder.build_load(hi_lty, hi_ptr, "arg.dp.hi");

                slots[llvm_slot_idx] = lo_val.raw;
                slots[llvm_slot_idx + 1] = hi_val.raw;
                llvm_slot_idx += 2;
                source_idx += 1;
                continue;
            }

            // Direct-with-coercion for a <= 8 byte aggregate passed by
            // *address*: load it through the pointer into one register
            // slot.  (The struct-*value* <= 8 case is handled by the
            // Integer/Float/Double/Vector <- Struct branch below.)
            if (ek_is_reg && agg_size > 0 && agg_size <= 8 && !agg_from_value
                    && agg_ptr.is_valid()) {
                const reg_lty: LType = LType { raw: expected_ty };
                const reg_val: LValue = this.builder.build_load(
                    reg_lty, agg_ptr, "arg.coerced");
                slots[llvm_slot_idx] = reg_val.raw;
                llvm_slot_idx += 1;
                source_idx += 1;
                continue;
            }

            // Non-expanded slots take the same coercion path as the 1:1
            // marshalling loop; `source_idx` is the source ordinal, so the
            // receiver-slot branches key off it rather than the LLVM slot.
            if (arg_val.is_valid()) {
                arg_val = this.coerce_call_arg(expected_ty, arg_val, arg_ty_ref,
                                               source_idx as u32, expected_count);
            }

            slots[llvm_slot_idx] = arg_val.raw;
            llvm_slot_idx += 1;
            source_idx += 1;
        }

        const out: LValue = this.build_call_maybe_invoke(
            callee_type, callee, buf, expected_count, name);
        libc::free(buf);

        // Phase 2 - byval propagation, driven off the LLVM slot index.
        // The DirectPair expansion above fills slots 0..expected_count
        // directly (one source aggregate can own two slots), so a >16
        // byte byval param sits at its true LLVM slot, which is also the
        // index `byval_pointee_of_param` queries.  Without this pass a
        // call mixing a DirectPair arg with a byval arg silently dropped
        // the byval attribute (ABI break: the backend treated the
        // pointer as aliasing rather than a by-value copy).
        this.apply_byval_call_attributes(callee, out, expected_count);

        return out;
    }


    // Binary / unary operations

    /// Generate IR for a binary expression.  Handles arithmetic,
    /// comparison, logical short-circuit, and assignment operators.
    codegen_binary(mut &this, lhs_val: LValue, rhs_val: LValue, op_kind: TokenType, result_type: TypeRef, rhs_type: TypeRef,
                   visitor: ASTVisitor*, div_sched: ASTNode*[]*, div_span: SourceSpan) -> LValue {
        mut out_value: LValue = LValue::null();
        if (!lhs_val.is_valid() || !rhs_val.is_valid()) {
            out_value = LValue::null();
            return out_value;
        }
        // Determine if this is integer, float, or pointer arithmetic.
        // Follow InstantiatedType chain to get the concrete type.
        mut t: Type* = this.lookup_type_by_id(result_type.id);
        mut bd: i32 = 0;
        while (t != null && t.kind == TypeKind::InstantiatedType && bd < 5) {
            const binst: InstantiatedType* = t as InstantiatedType*;
            if (binst.has_resolved_type()) {
                t = this.lookup_type_by_id(binst.resolved_type.id);
            } else { break; }
            bd += 1;
        }
        mut t_kind: TypeKind = TypeKind::Error;
        if (t != null) { t_kind = t.kind; }

        // String ops.  Strings are null-terminated `i8*` at the LLVM level.
        //   `==`/`!=` -> strcmp
        //   `+` string + string -> append (concat into fresh heap buffer)
        //   `+` string + int    -> pointer advancement (GEP over i8)
        if (t_kind == TypeKind::String) {
            if (op_kind == TokenType::EqualEqual || op_kind == TokenType::ExclaimEqual) {
                out_value = this.codegen_string_compare(lhs_val, rhs_val, op_kind);
                return out_value;
            }
            if (op_kind == TokenType::Plus) {
                // Decide concat vs pointer-advance by the RHS's LLVM type.
                // Both operands are already rvalues at this point.
                const rhs_llvm: void* = llvm::LLVMTypeOf(rhs_val.raw);
                if (rhs_llvm != null && LType::kind_of(rhs_llvm) == LTypeKind::Integer) {
                    // string + int -> GEP i8 for pointer arithmetic.
                    // Caller uses this idiom for substring-from-offset,
                    // C-string walking, etc.
                    const buf: void* = libc::malloc(8);
                    const slots: void** = buf as void**;
                    slots[0] = rhs_val.raw;
                    out_value = this.builder.build_gep(
                        LType::i8(), lhs_val, buf, 1, "ptradv");
                    libc::free(buf);
                    return out_value;
                }
                // string + string -> call std::core::primitives::string::append.
                // The stdlib already provides this as a method on
                // `string`; every module gets it via cross-module extern
                // declarations.
                //
                // append's signature is `(&this, other: string) -> string`.
                // By convention, `&this` on a primitive lowers to a
                // pointer to the storage holding the string (i8**).
                // The body opens with `load ptr, ptr %0` to deref it
                // back to the string.  Method-call codegen passes the
                // receiver's lvalue for value-typed receivers (see
                // ir_generator.cryo:visit_call_expr); the binary `+`
                // path arrives here with `lhs_val` already loaded as an
                // rvalue (i8*), so spill it back to a temp slot and
                // pass that slot's address.  Without this, the callee
                // derefs i8* expecting i8** and reads the first 8 bytes
                // of string content as a "pointer", crashing in strlen.
                const fn_sym: SymbolStr = this.intern_str(
                    "std::core::primitives::string::append");
                const fn_val: LValue = this.resolver.resolve_function(fn_sym);
                if (!fn_val.is_valid()) {
                    out_value = LValue::null();
                    return out_value;
                }
                const fn_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(fn_val.raw) };
                const this_ty: LType = LType::pointer_to(LType::i8());
                const this_slot: LValue = this.coercion_slot(this_ty, "strcat.this");
                this.builder.build_store(lhs_val, this_slot);
                mut args: Pair<LValue, TypeRef>[] = [];
                args.push(Pair<LValue, TypeRef>::new(this_slot, TypeRef::invalid()));
                args.push(Pair<LValue, TypeRef>::new(rhs_val, TypeRef::invalid()));
                out_value = this.codegen_call(fn_val, fn_ty, args, "strcat");
                return out_value;
            }
            if (op_kind == TokenType::Minus) {
                // string - int -> retreat the i8* cursor by `int` bytes.
                // Only `string - numeric` reaches here (`string - string`
                // is not a valid `-`), so there is no concat ambiguity.
                // Mirrors the `+` advance with a negated offset.  Without
                // this, `-` fell through to the null-return below and
                // silently miscompiled.
                const neg: LValue = this.builder.build_neg(rhs_val, "stroff.neg");
                const buf: void* = libc::malloc(8);
                const slots: void** = buf as void**;
                slots[0] = neg.raw;
                out_value = this.builder.build_gep(
                    LType::i8(), lhs_val, buf, 1, "ptrret");
                libc::free(buf);
                return out_value;
            }
            // Ordered comparison between two strings (i.e. raw `char*`
            // buffer walking (`this.current >= this.buffer_end`).  LLVM
            // allows `icmp` directly on matching pointer types; treat as
            // unsigned since address space is unsigned.  Without this,
            // `codegen_binary` fell through to the null-return below and
            // stripped any method body containing such a comparison.
            if (op_kind == TokenType::LAngle || op_kind == TokenType::RAngle ||
                op_kind == TokenType::LessEqual || op_kind == TokenType::GreaterEqual) {
                mut icmp_op: LIntPredicate = LIntPredicate::ULT;
                if (op_kind == TokenType::RAngle) {
                    icmp_op = LIntPredicate::UGT;
                } else if (op_kind == TokenType::LessEqual) {
                    icmp_op = LIntPredicate::ULE;
                } else if (op_kind == TokenType::GreaterEqual) {
                    icmp_op = LIntPredicate::UGE;
                }
                out_value = this.builder.build_icmp(icmp_op, lhs_val, rhs_val, "ptrcmp");
                return out_value;
            }
            out_value = LValue::null();
            return out_value;
        }

        // Enum comparison: compare i32 discriminant tags.
        // For simple enums the value is already i32.
        // For ADT enums extract field 0 (the tag) first.
        if (t_kind == TypeKind::Enum) {
            if (op_kind == TokenType::EqualEqual || op_kind == TokenType::ExclaimEqual) {
                mut lhs_tag: LValue = lhs_val;
                mut rhs_tag: LValue = rhs_val;
                // Check if this is an ADT enum (struct type in LLVM) or simple (i32).
                const lhs_llvm_ty: void* = llvm::LLVMTypeOf(lhs_val.raw);
                if (lhs_llvm_ty != null && LType::kind_of(lhs_llvm_ty) == LTypeKind::Struct) {
                    // ADT enum: extract the discriminant tag at field 0
                    // before comparing.  Skipping this would feed the
                    // full struct to icmp and trip "icmp requires
                    // integer operands" at verify time.
                    lhs_tag = this.builder.build_extract_value(lhs_val, 0, "lhs.tag");
                    rhs_tag = this.builder.build_extract_value(rhs_val, 0, "rhs.tag");
                }
                if (op_kind == TokenType::EqualEqual) {
                    out_value = this.builder.build_icmp(LIntPredicate::EQ, lhs_tag, rhs_tag, "enum.eq");
                } else {
                    out_value = this.builder.build_icmp(LIntPredicate::NE, lhs_tag, rhs_tag, "enum.ne");
                }
                return out_value;
            }
            out_value = LValue::null();
            return out_value;
        }

        // Bail out if the operand type is not numeric, pointer/reference,
        // or function.  Operating on void/error/unresolved types crashes
        // LLVM.  Function types are included so that `fn_ptr != null` and
        // `fn_ptr == fn_ptr` checks reach the icmp path below; both lower
        // to LLVM `ptr`, so the existing pointer-comparison logic works
        // unchanged.  Reference is included so that `&arr[i] + offset`
        // (which sema types as `&T`, not `T*`) reaches the GEP path below.
        if (t_kind != TypeKind::Int && t_kind != TypeKind::Float &&
            t_kind != TypeKind::Bool && t_kind != TypeKind::Pointer &&
            t_kind != TypeKind::Reference &&
            t_kind != TypeKind::Char && t_kind != TypeKind::Function) {
            out_value = LValue::null();
            return out_value;
        }

        // Pointer + int / Pointer - int -> GEP over the pointee type.
        // LLVM rejects `add ptr, i64`; the arithmetic must be expressed
        // as a getelementptr with a scaled integer index.  Matches the
        // string-plus-int path above but for typed pointers (`i8*`,
        // `u8*` etc. used for C-string or buffer walking).  References
        // (`&T`) share the same opaque-ptr representation; route them
        // through the same path by reading the referent type instead of
        // the pointee.
        if ((t_kind == TypeKind::Pointer || t_kind == TypeKind::Reference) &&
            (op_kind == TokenType::Plus || op_kind == TokenType::Minus)) {
            mut elem_ty: TypeRef = TypeRef::invalid();
            if (t_kind == TypeKind::Pointer) {
                const ptr_t: PointerType* = t as PointerType*;
                elem_ty = ptr_t.pointee;
            } else {
                const ref_t: ReferenceType* = t as ReferenceType*;
                elem_ty = ref_t.referent;
            }
            const pointee_lty: LType = this.type_mapper.map_type(elem_ty);
            if (pointee_lty.is_valid()) {
                mut idx: LValue = rhs_val;
                if (op_kind == TokenType::Minus) {
                    idx = this.builder.build_neg(rhs_val, "gep.neg");
                }
                const buf: void* = libc::malloc(8);
                const slots: void** = buf as void**;
                slots[0] = idx.raw;
                out_value = this.builder.build_gep(
                    pointee_lty, lhs_val, buf, 1, "ptradv");
                libc::free(buf);
                return out_value;
            }
        }

        // Provisional: `result_type` is the LEFT operand's type (the caller
        // passes `node.left.resolved_type`), so it cannot settle this on its
        // own - `i32 + f32` arrives claiming to be integer arithmetic, and a
        // comparison arrives as `bool`.  The operand normalization below decides
        // it from the values actually being combined.
        mut is_float: boolean = t_kind == TypeKind::Float;
        mut is_signed: boolean = false;
        if (t_kind == TypeKind::Int) {
            const int_t: IntType* = t as IntType*;
            const ik: IntegerKind = int_t.int_kind;
            is_signed = ik.is_signed();
        }

        // Right operand's OWN signedness.  When the narrower operand is the
        // RHS it must be zero-/sign-extended according to its own type, not
        // the left/result type's: pairing an unsigned narrow RHS (e.g. u16)
        // with a signed wider LHS (e.g. i32) and sign-extending it silently
        // corrupts every value with the RHS's top bit set.  Follow the
        // InstantiatedType chain exactly like `t` above so generic contexts
        // behave identically to concrete ones.
        mut rhs_is_signed: boolean = false;
        mut rt: Type* = this.lookup_type_by_id(rhs_type.id);
        mut rbd: i32 = 0;
        while (rt != null && rt.kind == TypeKind::InstantiatedType && rbd < 5) {
            const rinst: InstantiatedType* = rt as InstantiatedType*;
            if (rinst.has_resolved_type()) {
                rt = this.lookup_type_by_id(rinst.resolved_type.id);
            } else { break; }
            rbd += 1;
        }
        if (rt != null && rt.kind == TypeKind::Int) {
            const rint: IntType* = rt as IntType*;
            rhs_is_signed = rint.int_kind.is_signed();
        }

        // Normalize integer operand widths.
        // LLVM requires both operands to binary ops (icmp, add, shl, etc.)
        // to have the same type.  If they differ (e.g., i32 vs i64),
        // extend the narrower one to match the wider.
        mut lhs: LValue = lhs_val;
        mut rhs: LValue = rhs_val;
        const lhs_ty: void* = llvm::LLVMTypeOf(lhs.raw);
        const rhs_ty: void* = llvm::LLVMTypeOf(rhs.raw);
        const lhs_kind: LTypeKind = LType::kind_of(lhs_ty);
        const rhs_kind: LTypeKind = LType::kind_of(rhs_ty);
        const lhs_fp: boolean = lhs_kind == LTypeKind::Float
                             || lhs_kind == LTypeKind::Double;
        const rhs_fp: boolean = rhs_kind == LTypeKind::Float
                             || rhs_kind == LTypeKind::Double;
        // A float on EITHER side makes this float arithmetic, and the other
        // operand converts up to it: the wider float when both are floats, the
        // float itself when the other side is an integer.  Without this the
        // pair reaches LLVM as `fadd float, double` or `add i32, float` and the
        // module fails verification naming no user construct - the operand
        // widths are the ONLY thing that fixes it, because `is_float` above is
        // read off one operand.  Restricted to an integer partner so pointer
        // and aggregate operands keep their own paths.
        if (lhs_ty != null && rhs_ty != null && (lhs_fp || rhs_fp)
                && (lhs_fp || lhs_kind == LTypeKind::Integer)
                && (rhs_fp || rhs_kind == LTypeKind::Integer)) {
            mut target_raw: void* = lhs_ty;
            if (!lhs_fp) {
                target_raw = rhs_ty;
            } else if (rhs_fp && rhs_kind == LTypeKind::Double
                    && lhs_kind != LTypeKind::Double) {
                target_raw = rhs_ty;
            }
            const target: LType = LType { raw: target_raw };
            // Each integer converts by its OWN signedness, for the reason the
            // width path sign-extends by its own: reading an unsigned operand
            // as signed changes the value, not just the representation.
            if (!lhs_fp) {
                if (is_signed) {
                    lhs = this.builder.build_si_to_fp(lhs, target, "widen.sitofp");
                } else {
                    lhs = this.builder.build_ui_to_fp(lhs, target, "widen.uitofp");
                }
            } else if (lhs_ty != target_raw) {
                lhs = this.builder.build_fp_ext(lhs, target, "widen.fpext");
            }
            if (!rhs_fp) {
                if (rhs_is_signed) {
                    rhs = this.builder.build_si_to_fp(rhs, target, "widen.sitofp");
                } else {
                    rhs = this.builder.build_ui_to_fp(rhs, target, "widen.uitofp");
                }
            } else if (rhs_ty != target_raw) {
                rhs = this.builder.build_fp_ext(rhs, target, "widen.fpext");
            }
            is_float = true;
        } else if (!is_float) {
            if (lhs_ty != null && rhs_ty != null &&
                lhs_kind == LTypeKind::Integer && rhs_kind == LTypeKind::Integer) {
                const lhs_w: u32 = llvm::LLVMGetIntTypeWidth(lhs_ty);
                const rhs_w: u32 = llvm::LLVMGetIntTypeWidth(rhs_ty);
                if (lhs_w < rhs_w) {
                    const target: LType = LType { raw: rhs_ty };
                    if (is_signed) {
                        lhs = this.builder.build_sext(lhs, target, "widen");
                    } else {
                        lhs = this.builder.build_zext(lhs, target, "widen");
                    }
                } else if (rhs_w < lhs_w) {
                    const target: LType = LType { raw: lhs_ty };
                    if (rhs_is_signed) {
                        rhs = this.builder.build_sext(rhs, target, "widen");
                    } else {
                        rhs = this.builder.build_zext(rhs, target, "widen");
                    }
                }
            } else if (lhs_ty != null && rhs_ty != null &&
                       lhs_kind == LTypeKind::Integer && rhs_kind == LTypeKind::Pointer) {
                // int <op> ptr: coerce int to ptr so icmp on two
                // pointers succeeds.  Address comparisons in stdlib
                // (e.g., aligned_addr < base + offset, where the int
                // side holds a ptrtoint'd address) depend on this
                // normalization.
                const ptr_ty: LType = LType { raw: rhs_ty };
                lhs = this.builder.build_int_to_ptr(lhs, ptr_ty, "int2ptr");
            } else if (lhs_ty != null && rhs_ty != null &&
                       lhs_kind == LTypeKind::Pointer && rhs_kind == LTypeKind::Integer) {
                const ptr_ty: LType = LType { raw: lhs_ty };
                rhs = this.builder.build_int_to_ptr(rhs, ptr_ty, "int2ptr");
            }
        }

        // Mixed-sign integer comparison must compare TRUE integer values.
        // Choosing one signed/unsigned icmp predicate from a single operand
        // reinterprets the other operand's bits: `(1_u32 > -1_i32)` wrongly
        // returns false because UGT reads -1 as 4294967295.  The operands
        // are already width-normalized above (each extended per its own
        // signedness), so the value-preserving form is exact for every width.
        if (!is_float && this.is_int_compare_op(op_kind) &&
                t_kind == TypeKind::Int &&
                rt != null && rt.kind == TypeKind::Int &&
                is_signed != rhs_is_signed) {
            return this.codegen_mixed_sign_compare(op_kind, is_signed, lhs, rhs);
        }

        match (op_kind) {
            // Arithmetic
            TokenType::Plus => {
                out_value = if (is_float) {
                    this.builder.build_fadd(lhs, rhs, "addtmp")
                } else {
                    this.builder.build_add(lhs, rhs, "addtmp")
                };
            }
            TokenType::Minus => {
                out_value = if (is_float) {
                    this.builder.build_fsub(lhs, rhs, "subtmp")
                } else {
                    this.builder.build_sub(lhs, rhs, "subtmp")
                };
            }
            TokenType::Star => {
                out_value = if (is_float) {
                    this.builder.build_fmul(lhs, rhs, "multmp")
                } else {
                    this.builder.build_mul(lhs, rhs, "multmp")
                };
            }
            TokenType::Slash => {
                // Guard before the divide.  IEEE-754 fdiv is total
                // (x/0 -> +/-inf, 0/0 -> NaN) so float skips the guard;
                // integer sdiv/udiv on a zero divisor (and signed
                // INT_MIN / -1) are LLVM UB and must trap explicitly.
                if (!is_float) {
                    this.emit_int_div_guard(lhs, rhs, is_signed, visitor, div_sched, div_span);
                }
                out_value = if (is_float) {
                    this.builder.build_fdiv(lhs, rhs, "divtmp")
                } else { if (is_signed) {
                    this.builder.build_sdiv(lhs, rhs, "divtmp")
                } else {
                    this.builder.build_udiv(lhs, rhs, "divtmp")
                } };
            }
            TokenType::Percent => {
                if (!is_float) {
                    this.emit_int_div_guard(lhs, rhs, is_signed, visitor, div_sched, div_span);
                }
                out_value = if (is_float) {
                    this.builder.build_frem(lhs, rhs, "remtmp")
                } else { if (is_signed) {
                    this.builder.build_srem(lhs, rhs, "remtmp")
                } else {
                    this.builder.build_urem(lhs, rhs, "remtmp")
                } };
            }

            // Comparison
            TokenType::EqualEqual => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OEQ, lhs, rhs, "eqtmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::EQ, lhs, rhs, "eqtmp")
                };
            }
            TokenType::ExclaimEqual => {
                out_value = if (is_float) {
                    // UNE (unordered-or-not-equal), not ONE: IEEE requires
                    // `NaN != NaN` to be true, and `!=` must be the negation
                    // of `==` (OEQ).  ONE (ordered) wrongly returns false for
                    // any NaN operand, breaking f32/f64::is_nan.
                    this.builder.build_fcmp(LRealPredicate::UNE, lhs, rhs, "netmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::NE, lhs, rhs, "netmp")
                };
            }
            TokenType::LAngle => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OLT, lhs, rhs, "lttmp")
                } else { if (is_signed) {
                    this.builder.build_icmp(LIntPredicate::SLT, lhs, rhs, "lttmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::ULT, lhs, rhs, "lttmp")
                } };
            }
            TokenType::RAngle => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OGT, lhs, rhs, "gttmp")
                } else { if (is_signed) {
                    this.builder.build_icmp(LIntPredicate::SGT, lhs, rhs, "gttmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::UGT, lhs, rhs, "gttmp")
                } };
            }
            TokenType::LessEqual => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OLE, lhs, rhs, "letmp")
                } else { if (is_signed) {
                    this.builder.build_icmp(LIntPredicate::SLE, lhs, rhs, "letmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::ULE, lhs, rhs, "letmp")
                } };
            }
            TokenType::GreaterEqual => {
                out_value = if (is_float) {
                    this.builder.build_fcmp(LRealPredicate::OGE, lhs, rhs, "getmp")
                } else { if (is_signed) {
                    this.builder.build_icmp(LIntPredicate::SGE, lhs, rhs, "getmp")
                } else {
                    this.builder.build_icmp(LIntPredicate::UGE, lhs, rhs, "getmp")
                } };
            }

            // Bitwise
            TokenType::Amp            => { out_value = this.builder.build_and(lhs, rhs, "andtmp"); }
            TokenType::Pipe           => { out_value = this.builder.build_or(lhs, rhs, "ortmp"); }
            TokenType::Caret          => { out_value = this.builder.build_xor(lhs, rhs, "xortmp"); }
            TokenType::LessLess       => { out_value = this.builder.build_shl(lhs, rhs, "shltmp"); }
            TokenType::GreaterGreater => {
                out_value = if (is_signed) {
                    this.builder.build_ashr(lhs, rhs, "shrtmp")
                } else {
                    this.builder.build_lshr(lhs, rhs, "shrtmp")
                };
            }

            _ => { out_value = LValue::null(); }
        }
        return out_value;
    }

    /// True for the six integer comparison operators.
    is_int_compare_op(&this, op: TokenType) -> boolean {
        return op == TokenType::LAngle      || op == TokenType::RAngle ||
               op == TokenType::LessEqual   || op == TokenType::GreaterEqual ||
               op == TokenType::EqualEqual  || op == TokenType::ExclaimEqual;
    }

    /// Swap a comparison operator's sense (`<`<->`>`, `<=`<->`>=`).  `==`/`!=`
    /// are symmetric and returned unchanged.  Used to re-express an
    /// unsigned-LHS mixed comparison from the signed operand's perspective.
    flip_compare_op(&this, op: TokenType) -> TokenType {
        match (op) {
            TokenType::LAngle       => { return TokenType::RAngle; }
            TokenType::RAngle       => { return TokenType::LAngle; }
            TokenType::LessEqual    => { return TokenType::GreaterEqual; }
            TokenType::GreaterEqual => { return TokenType::LessEqual; }
            _                       => { return op; }
        }
    }

    /// Value-preserving comparison of a signed against an unsigned integer
    /// of the same (already width-normalized) LLVM width.  A negative signed
    /// value is mathematically less than EVERY unsigned value; a
    /// non-negative one compares bit-for-bit as unsigned.  This is the fix
    /// for the order-dependent bug where a single predicate reinterprets one
    /// operand's bits (`(1_u32 > -1_i32)` must be true, not false).
    ///
    /// Note this also makes equality value-correct: `-1_i32 == 4294967295_u32`
    /// is FALSE (distinct integers) rather than bit-equal true.
    codegen_mixed_sign_compare(mut &this, op_kind: TokenType,
                               lhs_is_signed: boolean,
                               lhs: LValue, rhs: LValue) -> LValue {
        // Normalize to (s = signed operand, u = unsigned operand) and an
        // operator read from the signed operand's perspective, so the logic
        // below is always `s <op> u`.
        mut s:  LValue    = lhs;
        mut u:  LValue    = rhs;
        mut op: TokenType = op_kind;
        if (!lhs_is_signed) {
            s  = rhs;
            u  = lhs;
            op = this.flip_compare_op(op_kind);
        }
        const s_ty: LType = LType { raw: llvm::LLVMTypeOf(s.raw) };
        const zero: LValue = LType::const_int(s_ty, 0, false);
        const s_neg: LValue =
            this.builder.build_icmp(LIntPredicate::SLT, s, zero, "ms.neg");
        const s_nonneg: LValue =
            this.builder.build_icmp(LIntPredicate::SGE, s, zero, "ms.nonneg");
        mut out: LValue = LValue::null();
        match (op) {
            TokenType::LAngle => {
                const c: LValue = this.builder.build_icmp(LIntPredicate::ULT, s, u, "ms.ult");
                out = this.builder.build_or(s_neg, c, "ms.lt");
            }
            TokenType::LessEqual => {
                const c: LValue = this.builder.build_icmp(LIntPredicate::ULE, s, u, "ms.ule");
                out = this.builder.build_or(s_neg, c, "ms.le");
            }
            TokenType::RAngle => {
                const c: LValue = this.builder.build_icmp(LIntPredicate::UGT, s, u, "ms.ugt");
                out = this.builder.build_and(s_nonneg, c, "ms.gt");
            }
            TokenType::GreaterEqual => {
                const c: LValue = this.builder.build_icmp(LIntPredicate::UGE, s, u, "ms.uge");
                out = this.builder.build_and(s_nonneg, c, "ms.ge");
            }
            TokenType::EqualEqual => {
                // s == u  <=>  s >= 0  AND  bits equal (s<0 => s!=u since u>=0).
                const c: LValue = this.builder.build_icmp(LIntPredicate::EQ, s, u, "ms.eqbits");
                out = this.builder.build_and(s_nonneg, c, "ms.eq");
            }
            TokenType::ExclaimEqual => {
                const c: LValue = this.builder.build_icmp(LIntPredicate::NE, s, u, "ms.nebits");
                out = this.builder.build_or(s_neg, c, "ms.ne");
            }
            _ => { out = LValue::null(); }
        }
        return out;
    }

    /// Emit a runtime trap before an integer divide/modulo.  LLVM treats
    /// `sdiv`/`udiv`/`srem`/`urem` as having undefined behavior when the
    /// divisor is zero (and for signed, additionally when computing
    /// `INT_MIN / -1` since the mathematical result overflows the result
    /// width).  Both cases lower to SIGFPE on x86 today, but UB lets the
    /// optimizer assume they can't happen and silently delete surrounding
    /// code, so guarding here keeps the language honest about its
    /// "no hidden control flow" promise.
    ///
    /// IR shape (signed case; unsigned omits the INT_MIN/-1 arm):
    ///
    ///   %iszero = icmp eq %rhs, 0
    ///   %neg1   = icmp eq %rhs, -1          ; signed only
    ///   %imin   = icmp eq %lhs, INT_MIN     ; signed only
    ///   %ovf    = and  %neg1, %imin         ; signed only
    ///   %trap   = or   %iszero, %ovf        ; signed only
    ///   br i1 %trap, label %div.trap, label %div.ok
    /// div.trap:
    ///   call void @abort()
    ///   unreachable
    /// div.ok:
    ///   <caller continues with the div/rem here>
    ///
    /// Leaves the builder positioned at the ok block.  For non-zero
    /// constant divisors LLVM's optimizer folds the branch away in O2
    /// builds (default), so the guard has no steady-state runtime cost
    /// when the compiler can prove safety statically.
    emit_int_div_guard(mut &this, lhs: LValue, rhs: LValue, is_signed: boolean,
                       visitor: ASTVisitor*, div_sched: ASTNode*[]*, div_span: SourceSpan) -> void {
        const rhs_ty_raw: void* = llvm::LLVMTypeOf(rhs.raw);
        if (rhs_ty_raw == null) { return; }
        const rhs_ty: LType = LType { raw: rhs_ty_raw };
        const zero: LValue = LType::const_int(rhs_ty, 0 as u64, false);
        const is_zero: LValue = this.builder.build_icmp(
            LIntPredicate::EQ, rhs, zero, "div.iszero");

        mut trap_cond: LValue = is_zero;
        if (is_signed) {
            const lhs_ty_raw: void* = llvm::LLVMTypeOf(lhs.raw);
            const lhs_ty: LType = LType { raw: lhs_ty_raw };
            const width: u32 = llvm::LLVMGetIntTypeWidth(lhs_ty_raw);
            // -1 is all-ones in two's complement at any width; const_int
            // with sign_extend=true sign-extends the i64 value to the
            // target width, giving the canonical -1 bit pattern.
            const minus_one: LValue = LType::const_int(
                rhs_ty, 0xFFFFFFFFFFFFFFFF as u64, true);
            // INT_MIN = 1 << (width - 1) for the lhs width.  LLVMConstInt
            // truncates the u64 to the target width, so 0x8000... lands
            // as the right bit pattern at any width <= 64.
            const shift: u64 = (width as u64) - (1 as u64);
            const imin_val: u64 = (1 as u64) << shift;
            const int_min: LValue = LType::const_int(lhs_ty, imin_val, false);
            const rhs_is_neg1: LValue = this.builder.build_icmp(
                LIntPredicate::EQ, rhs, minus_one, "div.rhsneg1");
            const lhs_is_intmin: LValue = this.builder.build_icmp(
                LIntPredicate::EQ, lhs, int_min, "div.lhsmin");
            const overflow: LValue = this.builder.build_and(
                rhs_is_neg1, lhs_is_intmin, "div.ovf");
            trap_cond = this.builder.build_or(is_zero, overflow, "div.trap");
        }

        const cur_bb: LBasicBlock = this.builder.get_insert_block();
        if (!cur_bb.is_valid()) { return; }
        const fn: LValue = cur_bb.get_parent();
        const trap_bb: LBasicBlock = LBasicBlock::append(fn, "div.trap");
        const ok_bb: LBasicBlock = LBasicBlock::append(fn, "div.ok");

        this.builder.build_cond_br(trap_cond, trap_bb, ok_bb);

        // Trap arm.  `--panic=unwind` (hosted): raise through `__cryo_panic`
        // (call-or-invoke + cleanup) so the failure unwinds and drops the
        // frame's live locals.  Default abort path: `call @abort();
        // unreachable` - a bare `unreachable` lowers to no instruction on x86
        // and would silently slide into adjacent code, so abort guarantees a
        // clean SIGABRT.  Byte-identical on the default path.
        this.builder.position_at_end(trap_bb);
        if (this.ctx.project_panic_unwind && !this.intrinsics.no_runtime) {
            this.emit_check_raise(visitor, div_sched, div_span, "attempt to divide by zero");
        } else {
            mut dz_ops: LValue[] = [];
            this.intrinsics.emit_check_sink("__cryo_panic_div_zero", div_span, &dz_ops);
        }

        // OK arm: caller continues with the div/rem here.
        this.builder.position_at_end(ok_bb);
    }

    /// Emit a runtime guard that aborts if `count * elem_size` - the byte
    /// count feeding an array `malloc` (`new T[n]`) - would overflow u64.
    /// A wrapped product mallocs a too-small block, after which the caller
    /// writes `count` elements past the allocation: the same heap-overflow
    /// class already guarded in `Layout::array` / `Pool::grow`.
    ///
    /// `elem_size` is a compile-time constant, so the bound `U64_MAX /
    /// elem_size` is folded here and compared against `count` with a single
    /// unsigned compare - no runtime division (which would itself need a
    /// zero-guard). The count is treated as unsigned, so a negative literal
    /// (`new int[-1]`) reads as a huge value and traps too. 1-byte elements
    /// can never overflow, so the guard is elided. Leaves the builder at the
    /// ok block; mirrors `emit_int_div_guard`'s trap shape.
    emit_array_mul_guard(mut &this, count_i64: LValue, elem_size: u64,
                         visitor: ASTVisitor*, ovf_sched: ASTNode*[]*, ovf_span: SourceSpan) -> void {
        if (elem_size <= (1 as u64)) { return; }
        const u64_max: u64 = (0 as u64) - (1 as u64);
        const max_count: u64 = u64_max / elem_size;
        const max_val: LValue = LType::const_int(LType::i64(), max_count, false);
        const overflow: LValue = this.builder.build_icmp(
            LIntPredicate::UGT, count_i64, max_val, "new.arr.ovf");

        const cur_bb: LBasicBlock = this.builder.get_insert_block();
        if (!cur_bb.is_valid()) { return; }
        const fn: LValue = cur_bb.get_parent();
        const trap_bb: LBasicBlock = LBasicBlock::append(fn, "new.arr.trap");
        const ok_bb: LBasicBlock = LBasicBlock::append(fn, "new.arr.ok");

        this.builder.build_cond_br(overflow, trap_bb, ok_bb);

        // Trap arm.  `--panic=unwind` (hosted): raise + cleanup so the failure
        // unwinds and drops the frame's live locals.  Default abort path: `call
        // @abort(); unreachable` - a clean SIGABRT instead of a silently
        // truncated allocation.  Byte-identical on the default path.
        this.builder.position_at_end(trap_bb);
        if (this.ctx.project_panic_unwind && !this.intrinsics.no_runtime) {
            this.emit_check_raise(visitor, ovf_sched, ovf_span, "arithmetic overflow");
        } else {
            // `op` 2 = multiply: this guard is the array-size product. The
            // handler formats "arithmetic overflow (op 2): <lhs>, <rhs>", so it
            // takes the raw operands rather than a pre-baked message.
            mut ovf_ops: LValue[] = [
                LType::const_int(LType::i32(), 2, false),
                count_i64,
                LType::const_int(LType::i64(), elem_size, false)
            ];
            this.intrinsics.emit_check_sink("__cryo_panic_overflow", ovf_span, &ovf_ops);
        }

        this.builder.position_at_end(ok_bb);
    }

    /// Generate IR for a unary expression.
    codegen_unary(mut &this, operand: LValue, op_kind: TokenType, operand_type: TypeRef) -> LValue {
        mut out_value: LValue = LValue::null();
        const t: Type* = this.lookup_type_by_id(operand_type.id);
        mut t_kind: TypeKind = TypeKind::Error;
        if (t != null) { t_kind = t.kind; }
        const is_float: boolean = t_kind == TypeKind::Float;

        match (op_kind) {
            TokenType::Minus => {
                out_value = if (is_float) {
                    this.builder.build_fneg(operand, "negtmp")
                } else {
                    this.builder.build_neg(operand, "negtmp")
                };
            }
            TokenType::Exclaim => { out_value = this.builder.build_not(operand, "nottmp"); }
            TokenType::Tilde   => { out_value = this.builder.build_not(operand, "bnottmp"); }
            _                  => { out_value = LValue::null(); }
        }
        return out_value;
    }


    // Coercions

    /// Reshape an icmp RHS to match the LHS width when the subject is a
    /// narrower integer than the pattern value.
    coerce_icmp_operands(mut &this, lhs: LValue, rhs: LValue,
                         subj_ty: TypeRef) -> LValue {
        if (!lhs.is_valid() || !rhs.is_valid()) { return rhs; }
        const lhs_ty_raw: void* = llvm::LLVMTypeOf(lhs.raw);
        const rhs_ty_raw: void* = llvm::LLVMTypeOf(rhs.raw);
        if (LType::kind_of(lhs_ty_raw) != LTypeKind::Integer) { return rhs; }
        if (LType::kind_of(rhs_ty_raw) != LTypeKind::Integer) { return rhs; }
        const lhs_bits: u32 = llvm::LLVMGetIntTypeWidth(lhs_ty_raw);
        const rhs_bits: u32 = llvm::LLVMGetIntTypeWidth(rhs_ty_raw);
        if (lhs_bits == rhs_bits) { return rhs; }
        const lhs_ty: LType = LType { raw: lhs_ty_raw };
        if (rhs_bits > lhs_bits) {
            return this.builder.build_trunc(rhs, lhs_ty, "match.coerce.trunc");
        }
        if (this.int_type_is_signed(subj_ty)) {
            return this.builder.build_sext(rhs, lhs_ty, "match.coerce.sext");
        }
        return this.builder.build_zext(rhs, lhs_ty, "match.coerce.zext");
    }

    /// Promote a value of a fixed-size array slot to a fat pointer
    /// `{T*, i64, i64}` when stored into a dynamic-array field.
    coerce_fixed_array_to_fat_ptr(mut &this, val: LValue, field_type: TypeRef) -> LValue {
        if (!val.is_valid()) { return val; }
        const ft: Type* = this.lookup_type_by_id(field_type.id);
        if (ft == null || ft.kind != TypeKind::Array) { return val; }
        const arr_t: ArrayType* = ft as ArrayType*;
        if (arr_t.is_fixed()) { return val; }

        const got_ty: void* = llvm::LLVMTypeOf(val.raw);
        if (LType::kind_of(got_ty) != LTypeKind::Array) { return val; }

        const elem_count: u32 = llvm::LLVMGetArrayLength(got_ty);
        const elem_lty: LType = LType { raw: llvm::LLVMGetElementType(got_ty) };

        const elem_t_raw: Type* = this.lookup_type_by_id(arr_t.element.id);
        mut elem_size: u64 = 1;
        if (elem_t_raw != null && elem_t_raw.size_bytes() > 0) {
            elem_size = elem_t_raw.size_bytes();
        }
        const total_bytes: u64 = elem_size * (elem_count as u64);
        const total_bytes_val: LValue = LType::const_int(LType::i64(), total_bytes, false);

        const current_bb: LBasicBlock = this.builder.get_insert_block();
        if (!current_bb.is_valid()) { return val; }
        const fn_val: LValue = current_bb.get_parent();
        if (!fn_val.is_valid()) { return val; }

        // Stash the fixed array on the stack so we have a source pointer for memcpy.
        const src: LValue = this.flow.create_entry_alloca(fn_val, "arrlit.src", LType { raw: got_ty });
        this.builder.build_store(val, src);

        // malloc(N * sizeof(T)) for the fat-pointer's owned buffer.
        const malloc_fn: LValue = this.resolver.resolve_function(this.intern_str("malloc"));
        if (!malloc_fn.is_valid()) { return val; }
        const malloc_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(malloc_fn.raw) };
        mut malloc_args: Pair<LValue, TypeRef>[] = [];
        malloc_args.push(Pair<LValue, TypeRef>::new(total_bytes_val, TypeRef::invalid()));
        mut data_ptr: LValue = LValue::null();
        data_ptr = this.codegen_call(malloc_fn, malloc_ty, malloc_args, "arrlit.heap");
        if (!data_ptr.is_valid()) { return val; }

        llvm::LLVMBuildMemCpy(this.builder.raw,
                              data_ptr.raw, 1,
                              src.raw, 1,
                              total_bytes_val.raw);

        // Build the fat-pointer struct: { data_ptr, count, count }.
        const elem_ptr_lty: LType = LType::pointer_to(elem_lty);
        const i64_ty: LType = LType::i64();
        const buf: void* = libc::malloc(24);
        const slots: void** = buf as void**;
        slots[0] = elem_ptr_lty.raw;
        slots[1] = i64_ty.raw;
        slots[2] = i64_ty.raw;
        const fat_ty: LType = LType::literal_struct(buf, 3, false);
        libc::free(buf);

        const fat: LValue = this.flow.create_entry_alloca(fn_val, "arrlit.fat", fat_ty);
        const ptr_slot: LValue = this.builder.build_struct_gep(fat_ty, fat, 0, "fat.ptr");
        this.builder.build_store(data_ptr, ptr_slot);
        const len_slot: LValue = this.builder.build_struct_gep(fat_ty, fat, 1, "fat.len");
        const count_val: LValue = LType::const_int(LType::i64(), elem_count as u64, false);
        this.builder.build_store(count_val, len_slot);
        const cap_slot: LValue = this.builder.build_struct_gep(fat_ty, fat, 2, "fat.cap");
        this.builder.build_store(count_val, cap_slot);

        return this.builder.build_load(fat_ty, fat, "arrlit.fat.val");
    }


    // Heap allocation / deallocation funnel

    /// The single heap-allocation site every `new` / `new[]` / array-literal /
    /// box routes through, so "the allocator" is one lookup instead of a copy
    /// of the fallback ladder per emitter (a precondition for making the
    /// allocator a weak, overridable `__cryo_alloc` lang item).
    ///
    /// Resolution ladder, emitting the exact same call each caller did:
    ///   - `is_ast_node` (the compiler allocating its own AST nodes): the
    ///     process-global AST arena (`cryo_ast_arena_alloc`), bulk-reclaimed at
    ///     each target boundary.
    ///   - otherwise the canonical `GlobalAlloc` via `std::alloc::allocator::alloc`
    ///     (`{size, align}`), so every heap object shares the same arena routing.
    ///   - if the stdlib is not linked (`--no-std`), a direct libc `malloc`
    ///     (`{size}` only — no alignment).
    ///
    /// `size_val` is a computed i64 value; `align` is a compile-time constant
    /// (built into an i64 constant here). `label` names the result SSA value.
    /// `what` names the construct for diagnostics. Returns a null `LValue`
    /// (after emitting a diagnostic) when no allocator can be resolved.
    emit_raw_alloc(mut &this, is_ast_node: boolean, size_val: LValue, align: u64,
                   label: string, span: SourceSpan, what: string) -> LValue {
        const align_val: LValue = LType::const_int(LType::i64(), align, false);

        if (is_ast_node) {
            const arena_fn: LValue = this.resolver.resolve_function(
                this.intern_str("compiler::codegen::ast_arena::cryo_ast_arena_alloc"));
            if (!arena_fn.is_valid()) {
                this.diag.emit_error_at_span(ErrorCode::E0636_UNDEFINED_FUNCTION_CALL,
                    format("codegen: %s: AST arena allocator not declared", what), span);
                return LValue::null();
            }
            const arena_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(arena_fn.raw) };
            mut arena_args: Pair<LValue, TypeRef>[] = [];
            arena_args.push(Pair<LValue, TypeRef>::new(size_val, TypeRef::invalid()));
            arena_args.push(Pair<LValue, TypeRef>::new(align_val, TypeRef::invalid()));
            return this.codegen_call(arena_fn, arena_ty, arena_args, label);
        }

        const raw_fn: LValue = this.resolver.resolve_function(
            this.intern_str("std::alloc::allocator::alloc"));
        if (raw_fn.is_valid()) {
            const raw_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(raw_fn.raw) };
            mut raw_args: Pair<LValue, TypeRef>[] = [];
            raw_args.push(Pair<LValue, TypeRef>::new(size_val, TypeRef::invalid()));
            raw_args.push(Pair<LValue, TypeRef>::new(align_val, TypeRef::invalid()));
            return this.codegen_call(raw_fn, raw_ty, raw_args, label);
        }

        // Freestanding: `-nostdlib` means there is no libc `malloc` to fall
        // back to, and `no_std` means the stdlib allocator above never resolves
        // either — so without this step every `new` in a freestanding program
        // fails codegen with "'malloc' not declared".  Route to the allocator
        // lang item, which the alloc tier supplies.
        if (this.intrinsics != null && this.intrinsics.no_runtime) {
            const rt_fn: LValue = this.intrinsics.get_or_decl_cryo_alloc();
            if (rt_fn.is_valid()) {
                const rt_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(rt_fn.raw) };
                mut rt_args: Pair<LValue, TypeRef>[] = [];
                rt_args.push(Pair<LValue, TypeRef>::new(size_val, TypeRef::invalid()));
                rt_args.push(Pair<LValue, TypeRef>::new(align_val, TypeRef::invalid()));
                return this.codegen_call(rt_fn, rt_ty, rt_args, label);
            }
        }

        const malloc_fn: LValue = this.resolver.resolve_function(this.intern_str("malloc"));
        if (!malloc_fn.is_valid()) {
            this.diag.emit_error_at_span(ErrorCode::E0636_UNDEFINED_FUNCTION_CALL,
                format("codegen: %s: 'malloc' not declared", what), span);
            return LValue::null();
        }
        const malloc_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(malloc_fn.raw) };
        if (!malloc_ty.is_valid()) {
            this.diag.emit_error_at_span(ErrorCode::E0602_INVALID_LLVM_TYPE,
                format("codegen: %s: failed to retrieve malloc function type", what), span);
            return LValue::null();
        }
        mut malloc_args: Pair<LValue, TypeRef>[] = [];
        malloc_args.push(Pair<LValue, TypeRef>::new(size_val, TypeRef::invalid()));
        return this.codegen_call(malloc_fn, malloc_ty, malloc_args, label);
    }

    /// The dealloc counterpart to `emit_raw_alloc`, for `delete`. Bitcasts the
    /// pointer to `i8*`, then frees through `std::alloc::allocator::free`
    /// (`{ptr, align}` — the shim takes the alignment so it pairs with the
    /// aligned `alloc` on platforms where free is alignment-sensitive), or a
    /// direct libc `free` (`{ptr}`) when the stdlib is not linked. A null or
    /// invalid pointer is a silent no-op (nothing was allocated).
    emit_raw_dealloc(mut &this, ptr: LValue, align: u64, span: SourceSpan) -> void {
        // Freestanding: pair with the `__cryo_alloc` the allocation went
        // through, for the same reason there is no libc `free` here either.
        // The lang item's `size` parameter is passed 0: a `delete` site does not
        // carry the allocation size, and the tier recovers the exact mapping
        // from its own header rather than the argument.
        if (this.intrinsics != null && this.intrinsics.no_runtime && ptr.is_valid()) {
            const rt_fn: LValue = this.intrinsics.get_or_decl_cryo_dealloc();
            if (rt_fn.is_valid()) {
                const rt_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(rt_fn.raw) };
                const rt_ptr: LValue = this.builder.build_pointer_cast(
                    ptr, LType::pointer_to(LType::i8()), "delcast");
                mut rt_args: Pair<LValue, TypeRef>[] = [];
                rt_args.push(Pair<LValue, TypeRef>::new(rt_ptr, TypeRef::invalid()));
                rt_args.push(Pair<LValue, TypeRef>::new(
                    LType::const_int(LType::i64(), 0, false), TypeRef::invalid()));
                rt_args.push(Pair<LValue, TypeRef>::new(
                    LType::const_int(LType::i64(), align, false), TypeRef::invalid()));
                this.codegen_call(rt_fn, rt_ty, rt_args, "");
                return;
            }
        }

        mut free_fn: LValue = this.resolver.resolve_function(
            this.intern_str("std::alloc::allocator::free"));
        const free_via_shim: boolean = free_fn.is_valid();
        if (!free_via_shim) {
            free_fn = this.resolver.resolve_function(this.intern_str("free"));
        }
        if (!free_fn.is_valid() || !ptr.is_valid()) { return; }

        const void_ptr: LValue = this.builder.build_pointer_cast(
            ptr, LType::pointer_to(LType::i8()), "delcast");
        const free_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(free_fn.raw) };
        if (!free_ty.is_valid()) {
            this.diag.emit_error_at_span(ErrorCode::E0602_INVALID_LLVM_TYPE,
                "codegen: 'delete' expression: failed to retrieve free function type",
                span);
            return;
        }
        mut free_args: Pair<LValue, TypeRef>[] = [];
        free_args.push(Pair<LValue, TypeRef>::new(void_ptr, TypeRef::invalid()));
        if (free_via_shim) {
            const align_val: LValue = LType::const_int(LType::i64(), align, false);
            free_args.push(Pair<LValue, TypeRef>::new(align_val, TypeRef::invalid()));
        }
        this.codegen_call(free_fn, free_ty, free_args, "");
    }


    // Heap-box enum variant

    /// Heap-box an enum variant value for `new T::V(...)`.  Allocates
    /// `et.computed_size` bytes, bitcasts to the enum struct pointer
    /// type, and stores the loaded variant struct value at offset 0.
    /// Returns the typed pointer.
    heap_box_enum_variant(mut &this, et: EnumType*, enum_ref: TypeRef, variant_val: LValue, span: SourceSpan) -> LValue {
        const size: u64 = et.computed_size;
        if (size == 0) {
            this.diag.emit_error_at_span(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "codegen: enum computed_size is 0 reaching codegen (TypeLowering bug)",
                span);
            return LValue::null();
        }

        const size_val: LValue = LType::const_int(LType::i64(), size, false);
        // Box the enum through the shared allocation funnel, exactly like
        // `new T()` in new_delete_emitter, so a boxed `new T::V` shares the
        // per-target arena routing.
        const raw_ptr: LValue = this.emit_raw_alloc(false, size_val, 16, "newenum", span, "new T::V");
        if (!raw_ptr.is_valid()) { return LValue::null(); }

        const enum_llvm: LType = this.type_mapper.map_type(enum_ref);
        if (!enum_llvm.is_valid()) {
            this.diag.emit_error_at_span(ErrorCode::E0609_TYPE_MAPPING_ERROR,
                "codegen: new T::V: failed to map enum type",
                span);
            return LValue::null();
        }
        const obj_ptr: LValue = this.builder.build_pointer_cast(
            raw_ptr, LType::pointer_to(enum_llvm), "newenumcast");

        if (variant_val.is_valid() && obj_ptr.is_valid()) {
            this.builder.build_store(variant_val, obj_ptr);
        }

        return obj_ptr;
    }


    // Variadic argument lifecycle

    /// Declare the `@llvm.va_start.p0` intrinsic in the current LLVM
    /// module.  Signature: `void (ptr)`: the argument is a pointer to
    /// the va_list storage to initialize from the caller's argument
    /// area.
    declare_va_start(mut &this) -> LValue {
        return this.intrinsics.get_or_decl_va_start();
    }

    /// Declare the `@llvm.va_end.p0` intrinsic, mirror of va_start.
    declare_va_end(mut &this) -> LValue {
        return this.intrinsics.get_or_decl_va_end();
    }

    /// Emit va_start for a variadic function's vararg bucket.
    /// Allocates the per-target va_list storage (selected by
    /// `AbiClassifier::va_list_alloca_type`: `[24 x i8]` for SysV-amd64,
    /// `i8*` for Win64) and calls `@llvm.va_start` on the pointer.  Binds
    /// `args_name` to the alloca so that references in the body resolve
    /// to the va_list pointer.  The body wraps it in a safe `VaArgs` via
    /// `VaArgs::new(args)` to read typed values, or forwards it directly
    /// to a C `v*printf` callee.  Stashes the args name on `this` so
    /// `codegen_return` can emit `va_end` before every `ret`.
    ///
    /// Forwarding the bucket to a `v*printf`-style callee that takes
    /// `va_list` by value still needs an ABI-aware load on Win64; see
    /// `AbiClassifier::forward_va_list`.  The format runtime helper
    /// (`emit_format_runtime`) is the only built-in forwarder today;
    /// user-code forwarding would need to consult the same seam.
    emit_va_start_for_variadic(mut &this, fn_val: LValue, args_name: SymbolStr) -> void {
        if (!args_name.is_valid()) {
            this.current_variadic_arg_id = 0;
            return;
        }
        const va_list_ty: LType = this.abi.va_list_alloca_type();
        const va_list_alloca: LValue = this.flow.create_entry_alloca(
            fn_val, this.resolve(args_name), va_list_ty);
        const va_start_fn: LValue = this.declare_va_start();
        const va_start_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(va_start_fn.raw) };
        mut sargs: Pair<LValue, TypeRef>[] = [];
        sargs.push(Pair<LValue, TypeRef>::new(va_list_alloca, TypeRef::invalid()));
        mut _result: LValue = LValue::null();
        _result = this.codegen_call(va_start_fn, va_start_ty, sargs, "");
        this.values.set(args_name, va_list_alloca);
        this.current_variadic_arg_id = args_name.id;
    }

    /// Emit va_end on the va_list alloca bound to `args_name`, if that
    /// binding exists.  Called immediately before every terminating
    /// return so the va_list is properly cleaned up on every exit path.
    emit_va_end_if_variadic(mut &this, args_name: SymbolStr) -> void {
        if (!args_name.is_valid()) { return; }
        const va_list_alloca: LValue = this.values.get(args_name);
        if (!va_list_alloca.is_valid()) { return; }
        const va_end_fn: LValue = this.declare_va_end();
        const va_end_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(va_end_fn.raw) };
        mut args: Pair<LValue, TypeRef>[] = [];
        args.push(Pair<LValue, TypeRef>::new(va_list_alloca, TypeRef::invalid()));
        mut _result: LValue = LValue::null();
        _result = this.codegen_call(va_end_fn, va_end_ty, args, "");
    }

    /// Look up the active variadic arg's SymbolStr from `this`.  Returns
    /// an empty SymbolStr if the current function is not variadic.
    current_variadic_arg(mut &this) -> SymbolStr {
        const id: u32 = this.current_variadic_arg_id;
        if (id == 0) { return SymbolStr::empty(); }
        return SymbolStr::from_id(id);
    }


    // Return statement

    codegen_return(mut &this, val: LValue, has_value: boolean, src_ty: TypeRef) -> void {
        if (has_value && val.is_valid()) {
            // Unit-returning functions lower to `void` in LLVM (see
            // map_return_type), so a source-level `return unit_expr;`
            // must emit `ret void` rather than `ret {} %unit`; the
            // verifier rejects the latter.  Detect the mismatch by
            // looking at the current function's LLVM return type.
            const cur_bb: LBasicBlock = this.builder.get_insert_block();
            if (cur_bb.is_valid()) {
                const fn: LValue = cur_bb.get_parent();
                if (fn.is_valid()) {
                    // Phase 1 - sret: if this function was declared
                    // with `sret(%T)` on its hidden param 0, the
                    // LLVM-level signature is `void f(ptr sret(%T), ...)`.
                    // Store the returned value through that pointer
                    // and emit `ret void`, *before* the void-check
                    // below routes a unit-style return.  Callers
                    // observe the result via the slot they passed in.
                    const sret_pointee: LType = this.abi.sret_pointee_of(fn);
                    if (sret_pointee.is_valid()) {
                        const sret_ptr: LValue = LValue {
                            raw: llvm::LLVMGetParam(fn.raw, 0),
                        };
                        // `val` is typically the struct loaded from a
                        // local by `codegen_rvalue`; sometimes it is
                        // still a pointer (e.g. `return this_lvalue`).
                        // Normalise to a struct value before storing
                        // through the sret slot.
                        mut store_val: LValue = val;
                        const got_ty_raw: void* = llvm::LLVMTypeOf(val.raw);
                        if (LType::kind_of(got_ty_raw) == LTypeKind::Pointer) {
                            store_val = this.builder.build_load(
                                sret_pointee, val, "sret.load");
                        }
                        this.builder.build_store(store_val, sret_ptr);
                        this.emit_va_end_if_variadic(this.current_variadic_arg());
                        this.builder.build_ret_void();
                        return;
                    }

                    const fn_ty_raw: void* = llvm::LLVMGlobalGetValueType(fn.raw);
                    if (LType::kind_of(fn_ty_raw) == LTypeKind::Function) {
                        const ret_ty_raw: void* = llvm::LLVMGetReturnType(fn_ty_raw);
                        if (LType::kind_of(ret_ty_raw) == LTypeKind::Void) {
                            this.emit_va_end_if_variadic(this.current_variadic_arg());
                            this.builder.build_ret_void();
                            return;
                        }

                        // Defining-side return coercion.  When the
                        // function's LLVM return type is a register-
                        // shaped scalar/pair (Integer/Float/Double/Vector
                        // for <=8 byte aggregates, anonymous `{lo, hi}`
                        // Struct for 9-16 byte DirectPair returns) but
                        // the source value is a struct, spill the
                        // struct to a stack temp and reload it at the
                        // declared LLVM return type.  Inverse of the
                        // post-call coercion in `call_emitter.cryo`;
                        // see that file for the structural-comparison
                        // rationale (Cryo's void* != doesn't reliably
                        // distinguish distinct LLVM type handles).
                        const got_ty_raw: void* = llvm::LLVMTypeOf(val.raw);
                        if (got_ty_raw != null && got_ty_raw != ret_ty_raw) {
                            const ret_k: LTypeKind = LType::kind_of(ret_ty_raw);
                            const got_k: LTypeKind = LType::kind_of(got_ty_raw);
                            const ret_is_reg: boolean = (ret_k == LTypeKind::Integer
                                || ret_k == LTypeKind::Float
                                || ret_k == LTypeKind::Double
                                || ret_k == LTypeKind::Vector
                                || ret_k == LTypeKind::Struct);
                            const do_coerce: boolean = got_k == LTypeKind::Struct && ret_is_reg;
                            if (do_coerce) {
                                const src_lty: LType = LType { raw: got_ty_raw };
                                const slot: LValue = this.flow.create_entry_alloca(
                                    fn, "ret.coerce.src", src_lty);
                                this.builder.build_store(val, slot);
                                const ret_lty: LType = LType { raw: ret_ty_raw };
                                const coerced_v: LValue = this.builder.build_load(
                                    ret_lty, slot, "ret.coerce.val");
                                this.emit_va_end_if_variadic(this.current_variadic_arg());
                                this.builder.build_ret(coerced_v);
                                return;
                            }
                        }
                    }
                }
            }
            // Coerce the return value to the function's declared return
            // type.  Handles common implicit conversions like u64<->ptr
            // (stdlib uses this in `align_up`/`align_down`) and narrower
            // integer returns.
            const coerced: LValue = this.coerce_return_value(val, src_ty);
            this.emit_va_end_if_variadic(this.current_variadic_arg());
            this.builder.build_ret(coerced);
        } else if (!has_value) {
            this.emit_va_end_if_variadic(this.current_variadic_arg());
            this.builder.build_ret_void();
        }
        // If has_value but val is null, expression codegen failed.
        // Don't emit anything; the caller will detect the incomplete
        // function and strip it back to a declare.
    }

    /// Coerce a return-statement value to match the declared return
    /// type.  Emits inttoptr/ptrtoint/trunc/sext/zext when the straight
    /// ret would fail LLVM verification.  Returns the original value if
    /// no coercion is needed.
    ///
    /// `src_ty` is the Cryo type of the returned *expression*; it drives
    /// the sext-vs-zext choice when the value is narrower than the
    /// declared return type.  Without it a `return some_i32_negative;`
    /// from an `-> i64` function would `zext` and turn `-1` into
    /// `0xFFFFFFFF`.
    ///
    /// Branches use `LLVMGetTypeKind`-based dispatch because the same
    /// LLVM kind covers many source-level shapes (`Integer` for every
    /// width, `Pointer` for typed pointers / refs / opaque pointers,
    /// etc.); raw `void* != void*` would force a separate branch per
    /// LLVM type handle, which is much noisier.
    coerce_return_value(mut &this, val: LValue, src_ty: TypeRef) -> LValue {
        const cur_bb: LBasicBlock = this.builder.get_insert_block();
        if (!cur_bb.is_valid()) { return val; }
        const fn: LValue = cur_bb.get_parent();
        if (!fn.is_valid()) { return val; }

        const fn_ty_raw: void* = llvm::LLVMGlobalGetValueType(fn.raw);
        if (LType::kind_of(fn_ty_raw) != LTypeKind::Function) {
            return val;
        }
        const want_ty_raw: void* = llvm::LLVMGetReturnType(fn_ty_raw);
        const got_ty_raw: void* = llvm::LLVMTypeOf(val.raw);

        const want_kind: LTypeKind = LType::kind_of(want_ty_raw);
        const got_kind:  LTypeKind = LType::kind_of(got_ty_raw);
        const want_lty: LType = LType { raw: want_ty_raw };

        if (want_kind == LTypeKind::Pointer && got_kind == LTypeKind::Integer) {
            return this.builder.build_int_to_ptr(val, want_lty, "ret.inttoptr");
        }
        if (want_kind == LTypeKind::Integer && got_kind == LTypeKind::Pointer) {
            return this.builder.build_ptr_to_int(val, want_lty, "ret.ptrtoint");
        }

        // Struct -> ptr: arises from `return this` / `return some_lvalue`
        // in a method whose return type is `&Self` (or any reference).
        // codegen_rvalue dutifully loads the struct from the receiver
        // pointer; the function signature wants the pointer back.  If
        // `val` is a load instruction, we can recover the pre-load
        // address (the load's only operand) and return that, leaving
        // the dead load to be DCE'd by LLVM.  LLVMOpcode::Load = 27
        // (LLVM-C enum, stable across LLVM 14-20).
        if (want_kind == LTypeKind::Pointer && got_kind == LTypeKind::Struct) {
            const opcode: i32 = llvm::LLVMGetInstructionOpcode(val.raw);
            if (opcode == 27) {
                const ptr_operand: void* = llvm::LLVMGetOperand(val.raw, 0);
                if (ptr_operand != null) {
                    return LValue { raw: ptr_operand };
                }
            }
        }
        if (want_kind == LTypeKind::Integer && got_kind == LTypeKind::Integer) {
            const want_bits: u32 = llvm::LLVMGetIntTypeWidth(want_ty_raw);
            const got_bits:  u32 = llvm::LLVMGetIntTypeWidth(got_ty_raw);
            if (want_bits > got_bits) {
                // Widen with the *returned value's* signedness, not zext
                // unconditionally: `return some_i32` from an `-> i64`
                // fn must sign-extend a signed i32 so `-1` stays `-1`.
                if (this.int_type_is_signed(src_ty)) {
                    return this.builder.build_sext(val, want_lty, "ret.sext");
                }
                return this.builder.build_zext(val, want_lty, "ret.zext");
            }
            if (want_bits < got_bits) {
                return this.builder.build_trunc(val, want_lty, "ret.trunc");
            }
        }

        // Fixed-size array `[N x T]` -> dynamic fat pointer `{T*, i64}`.
        // Happens when a function typed `T[]` returns `[a, b, ...]` and
        // sema didn't propagate the dynamic expected_type into the
        // array-literal's resolved shape.  Stash the loaded array on the
        // stack, malloc N*sizeof(T), memcpy the contents, and build the
        // fat pointer, keeping IR verifiable even when upstream
        // inference is incomplete.
        if (want_kind == LTypeKind::Struct && got_kind == LTypeKind::Array) {
            const len: u32 = llvm::LLVMGetArrayLength(got_ty_raw);
            const elem_ty_raw: void* = llvm::LLVMGetElementType(got_ty_raw);
            const elem_size_val: LValue = LValue { raw: llvm::LLVMSizeOf(elem_ty_raw) };
            const len_val: LValue = LType::const_int(LType::i64(), len as u64, false);
            const byte_count: LValue = this.builder.build_mul(
                len_val, elem_size_val, "ret.bytecnt");

            const src_alloca: LValue = this.flow.create_entry_alloca(
                fn, "ret.src", LType { raw: got_ty_raw });
            this.builder.build_store(val, src_alloca);

            const malloc_fn: LValue = this.resolver.resolve_function(this.intern_str("malloc"));
            if (!malloc_fn.is_valid()) {
                return val;
            }
            const malloc_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(malloc_fn.raw) };
            mut malloc_args: Pair<LValue, TypeRef>[] = [];
            malloc_args.push(Pair<LValue, TypeRef>::new(byte_count, TypeRef::invalid()));
            mut data_ptr: LValue = LValue::null();
            data_ptr = this.codegen_call(malloc_fn, malloc_ty, malloc_args, "ret.data");
            if (!data_ptr.is_valid()) {
                return val;
            }

            llvm::LLVMBuildMemCpy(this.builder.raw,
                                  data_ptr.raw, 1,
                                  src_alloca.raw, 1,
                                  byte_count.raw);

            const fat_alloca: LValue = this.flow.create_entry_alloca(fn, "ret.fat", want_lty);
            const ptr_slot: LValue = this.builder.build_struct_gep(
                want_lty, fat_alloca, 0, "ret.fat.ptr");
            this.builder.build_store(data_ptr, ptr_slot);
            const len_slot: LValue = this.builder.build_struct_gep(
                want_lty, fat_alloca, 1, "ret.fat.len");
            this.builder.build_store(len_val, len_slot);
            const cap_slot: LValue = this.builder.build_struct_gep(
                want_lty, fat_alloca, 2, "ret.fat.cap");
            this.builder.build_store(len_val, cap_slot);

            const loaded: LValue = this.builder.build_load(want_lty, fat_alloca, "ret.fat.val");
            return loaded;
        }

        return val;
    }
}
