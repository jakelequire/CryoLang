/// Codegen Ops Modules
///
/// Context-side sub-emitters held by `CodegenContext`.  Each one
/// borrows specific sub-fields of the context (LLVM builder, type
/// mapper, function registry, etc.) via back-pointers set by
/// `CodegenContext::wire()`.  These modules emit IR for operations
/// that are AST-agnostic at the surface - they receive already-
/// evaluated LValues / TypeRefs / Symbols from callers and produce
/// the corresponding LLVM IR.

namespace compiler::codegen::ops;

public module IRFlowEmitter;
public module SymbolResolver;
public module IntrinsicsCodegen;
public module IntrinsicEmitter;
public module ExprOps;
public module DeclarationEmitter;
