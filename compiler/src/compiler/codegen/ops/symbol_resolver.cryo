/// Symbol Resolver
///
/// On-demand cross-module extern declaration for functions and globals.
/// A bulk pre-pass that walked every function and global in every module
/// would be `O(modules x functions x overloads)` per compiled module,
/// crippling for stdlib-heavy programs with many generic specializations.
///
/// Instead, codegen resolves each cross-module reference on demand:
///   1. the function this module already holds under the SYMBOL;
///   2. else an `external` declaration emitted from the `DeclarationIndex`
///      entry registered under that symbol, then held.
///
/// A callee reaches here as the front end pinned it (`CalleePin`): the
/// symbol itself, or - for the pins written before the symbol existed - a
/// FAMILY name that must name one symbol.  The pin says which; nothing here
/// tries one and then the other, and nothing here chooses among a family's
/// signatures.
///
/// This mirrors what LLVM itself does via `Module::getOrInsertFunction`.
///
/// Borrows the LLVM module, the type mapper, the function/global
/// registries, and the compilation context via back-pointers set by
/// `CodegenContext::wire()`.

namespace compiler::codegen::ops::symbol_resolver;

import compiler::codegen;
import compiler::codegen::{ llvm_types, type_map, abi };
import compiler::diag::{ ErrorCode, source_span };
import compiler::diag::source_span::{ SourceSpan };
import compiler::codegen::state::{ function_registry, global_registry };
import compiler::compilation_context;
import compiler::compilation_context::{ CompilationContext };
import compiler::ast::{ expression, node, declaration, NodeKind };
import compiler::ast::expression::{ CalleePin };
import compiler::ast::node::{ ASTNode };
import compiler::ast::declaration::{ FunctionDeclNode, MethodNode };
import compiler::decl_index;
import compiler::decl_index::{ DeclarationIndex, GlobalEntry };
import compiler::types;
import compiler::types::{ arena, compound, generic, type_base, type_ref, TypeKind };
import compiler::resolver::{ symbol_str, intern_table, mangled_name, qualified_name, res };
import compiler::resolver::res::{ DefId };
import compiler::decl_index::{ OverloadId };
import std::fmt;
import compiler::codegen::abi::{ AbiAttr, AbiClassifier, ArgClass, ParamPlan, SignaturePlan };
import compiler::codegen::llvm_types::{ LModule, LType, LValue };
import compiler::codegen::state::function_registry::{ FunctionRegistry };
import compiler::codegen::state::global_registry::{ GlobalRegistry };
import compiler::codegen::type_map::{ TypeMapper };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::mangled_name::{ MangledName };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::types::arena::{ TypeArena };
import compiler::types::compound::{
    ArrayType, FunctionType, OptionalType, PointerType, ReferenceType, TupleType
};
import compiler::types::generic::{ InstantiatedType };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };


type struct SymbolResolver {
    // Back-pointers (set by wire()).
    llvm_module: LModule*;
    type_mapper: TypeMapper*;
    abi:         AbiClassifier*;
    functions:   FunctionRegistry*;
    globals:     GlobalRegistry*;
    ctx:         CompilationContext*;

    /// The `![inline]` functions another module defines that this module
    /// calls, in the order first called: each was declared here, and its
    /// body is emitted here after the module's own (`inline_bodies.cryo`).
    inline_copies: [OverloadId];

    static null() -> SymbolResolver {
        return SymbolResolver {
            llvm_module: null,
            type_mapper: null,
            abi:         null,
            functions:   null,
            globals:     null,
            ctx:         null,
            inline_copies: [],
        };
    }

    wire(mut &this, llvm_module: LModule*, type_mapper: TypeMapper*,
         abi: AbiClassifier*,
         functions: FunctionRegistry*, globals: GlobalRegistry*,
         ctx: CompilationContext*) -> void {
        this.llvm_module = llvm_module;
        this.type_mapper = type_mapper;
        this.abi         = abi;
        this.functions   = functions;
        this.globals     = globals;
        this.ctx         = ctx;
    }


    // Function-type construction

    /// Build an LLVM function type from a Cryo `FunctionType*`, routing
    /// through the ABI seam so cross-module extern declarations agree
    /// with the defining module's lowering (sret / byval / ...).
    /// Returns `LType::null()` if classification fails (e.g. an
    /// un-lowered struct or an invalid TypeRef in `ft`).
    build_function_ltype(mut &this, ft: FunctionType*) -> LType {
        const plan: SignaturePlan = this.build_function_plan(ft);
        return plan.llvm_fn_type;
    }

    /// Full SignaturePlan for a Cryo `FunctionType*`.  Returned to the
    /// extern-declare path so it can attach the same `sret(%T)` /
    /// `byval(%T)` attributes the defining module attached, without
    /// re-running classification.
    build_function_plan(mut &this, ft: FunctionType*) -> SignaturePlan {
        return this.abi.classify_signature(
            ft.param_types, ft.return_type, ft.is_variadic);
    }


    // Cross-module extern declaration

    /// Declare the cross-module extern `symbol` at `func_type_ref`'s
    /// signature and register it under that symbol.  An LLVM function already
    /// so named is reused.  Null when the signature cannot be lowered.
    declare_extern_function_as(mut &this, func_type_ref: TypeRef, symbol: SymbolStr) -> LValue {
        const arena: TypeArena* = this.ctx.type_arena;
        const ft_ptr: Type* = arena.lookup(func_type_ref);
        if (ft_ptr == null || ft_ptr.kind != TypeKind::Function) { return LValue::null(); }
        const ft: FunctionType* = ft_ptr.as_function();

        const fn_type: LType = this.build_function_ltype(ft);
        if (!fn_type.is_valid()) { return LValue::null(); }

        const ir_name: string = this.ctx.intern_table.resolve(symbol);
        mut fn_val: LValue = this.llvm_module.get_named_function(MangledName::new(ir_name));
        if (!fn_val.is_valid()) {
            fn_val = this.llvm_module.add_function(MangledName::new(ir_name), fn_type);
            // Cross-module extern must carry the same `sret(%T)` /
            // `byval(%T)` attributes the defining module attached;
            // otherwise call sites and the callee disagree on whether
            // a hidden pointer is present and which slots own copies.
            // Only attach on the first declaration - a pre-existing
            // symbol already carries whatever attributes the defining
            // module attached.
            const xplan: SignaturePlan = this.build_function_plan(ft);
            if (xplan.sret_slot && xplan.return_plan.pointee_ty.is_valid()) {
                this.abi.apply_sret_attribute(fn_val, xplan.return_plan.pointee_ty);
            }
            for (mut xi: i64 = 0; xi < xplan.param_plans.length; xi++) {
                const xpp: &ParamPlan = &xplan.param_plans[xi];
                if (xpp.cls == ArgClass::Indirect
                        && xpp.attr == AbiAttr::ByVal
                        && xpp.pointee_ty.is_valid()) {
                    const xslot: u32 = AbiClassifier::llvm_slot_index_of_param(
                        xplan.param_plans, xplan.sret_slot, xi);
                    this.abi.apply_byval_attribute(fn_val, xslot, xpp.pointee_ty);
                }
            }
        }
        this.functions.register(symbol, fn_val);
        return fn_val;
    }


    /// Whether `source_file` is the file of the module being compiled.  A
    /// global the module itself defines is read from its own registry; an
    /// extern declared for it would clobber the definition.
    owned_by_current_module(&this, source_file: SymbolStr) -> boolean {
        if (!source_file.is_valid()) { return false; }
        const current: SymbolStr = this.ctx.intern_table.intern(this.ctx.source_file);
        return source_file.equals(current);
    }


    // Function / global resolution (held symbol + lazy extern)

    /// The function this module already holds under `sym`: one the declare
    /// passes registered (a definition, a pinned extern, a `![symbol]`-bound
    /// body under its Cryo symbol), else an LLVM function so named.
    held_symbol(&this, sym: SymbolStr) -> LValue {
        const cached: LValue = this.functions.get(sym);
        if (cached.is_valid()) { return cached; }
        return this.llvm_module.get_named_function(MangledName::new(this.ctx.intern_table.resolve(sym)));
    }

    /// The two argument types a `![caller_location]` function takes after
    /// its own, the caller's `FILE` and `LINE`: in its definition, in every
    /// module's declaration of it, and at every call.
    static caller_location_params(arena: TypeArena*) -> [TypeRef] {
        return [arena.get_string(), arena.get_u32()];
    }

    /// Whether entry `id` declares a `![caller_location]` function.
    caller_located(&this, id: OverloadId) -> boolean {
        return FunctionDeclNode::caller_located(this.ctx.decl_index.entry_decl(id));
    }

    /// The signature entry `id` is called at: its own, followed, for a
    /// `![caller_location]` function, by the caller's location.  Invalid
    /// for an invalid id.
    call_signature(&this, id: OverloadId) -> TypeRef {
        const sig: TypeRef = this.ctx.decl_index.entry_signature(id);
        if (!this.caller_located(id)) { return sig; }
        const arena: TypeArena* = this.ctx.type_arena;
        const st: Type* = arena.lookup(sig);
        if (st == null || st.kind != TypeKind::Function) { return TypeRef::invalid(); }
        const ft: FunctionType* = st.as_function();
        mut ps: [TypeRef] = [];
        for (mut i: i64 = 0; i < ft.param_types.length; i++) { ps.push(ft.param_types[i]); }
        const extra: [TypeRef] = SymbolResolver::caller_location_params(arena);
        for (mut i: i64 = 0; i < extra.length; i++) { ps.push(extra[i]); }
        return arena.get_function(ft.return_type, ps, ft.is_variadic);
    }

    /// A function by DECLARATION.  The entry gives both the symbol and the
    /// signature: held by this module under that symbol, else declared
    /// extern at that signature - and, for an `![inline]` body, queued for
    /// this module's copy of it.  Null for an invalid id or a signature
    /// that does not lower.
    resolve_decl(mut &this, id: OverloadId) -> LValue {
        const di: DeclarationIndex* = this.ctx.decl_index;
        const sym: SymbolStr = di.entry_symbol(id).spelling();
        if (!sym.is_valid()) { return LValue::null(); }
        const v: LValue = this.held_symbol(sym);
        if (v.is_valid()) { return v; }
        const declared: LValue = this.declare_extern_function_as(this.call_signature(id), sym);
        if (declared.is_valid() && di.inline_body(id).is_some()) {
            this.inline_copies.push(id);
        }
        return declared;
    }

    /// The constructor of the type definition `d` taking `arity` LLVM
    /// parameters (the receiver among them), read off the constructors the
    /// type registered - asked by the type, never by its leaf.  A signature
    /// carrying a generic parameter is a template and names none.  Several
    /// constructors of that arity is an internal error: the front end's pin
    /// selects among them.
    resolve_constructor(mut &this, d: DefId, arity: i64) -> LValue {
        const di: DeclarationIndex* = this.ctx.decl_index;
        const arena: TypeArena* = this.ctx.type_arena;
        const entries: [OverloadId] = di.constructor_entries_of(d);
        mut found: OverloadId = OverloadId::invalid();
        for (mut i: i64 = 0; i < entries.length; i++) {
            const t: Type* = arena.lookup(di.entry_signature(entries[i]));
            if (t == null || t.kind != TypeKind::Function) { continue; }
            const f: FunctionType* = t.as_function();
            if (f.param_types.length != arity) { continue; }
            if (SymbolResolver::function_type_has_generic_params(arena, f)) { continue; }
            if (found.is_valid()) {
                this.ctx.emit_error_at(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    "codegen: a construction names several constructors of one arity and was not pinned to one of them",
                    SourceSpan::none());
                return LValue::null();
            }
            found = entries[i];
        }
        if (!found.is_valid()) { return LValue::null(); }
        return this.resolve_decl(found);
    }

    /// The function the definition `d` is, for the calls codegen
    /// synthesizes itself to a declaration it holds the identity of (the
    /// allocator's entry points, `std::env::set_args`): the entry its
    /// signature was registered as.
    resolve_function(mut &this, d: DefId) -> LValue {
        if (!d.is_valid()) { return LValue::null(); }
        return this.resolve_decl(this.ctx.decl_index.entry_of_def(d));
    }

    /// The entry a pin names, by the kind of answer the pin says it is: a
    /// declaration's own, an instance's copy's.  One question each; a pin
    /// of the one kind is never asked as another.  Invalid for no pin.
    pinned_entry(&this, pin: CalleePin) -> OverloadId {
        return match (pin) {
            CalleePin::Decl(e)     => { e }
            CalleePin::Instance(i) => { this.ctx.decl_index.entry_of_instance(i) }
            _                      => { OverloadId::invalid() }
        };
    }

    /// The signature of a pinned callee; invalid for an unpinned callee.
    pinned_signature(&this, pin: CalleePin) -> TypeRef {
        return this.ctx.decl_index.entry_signature(this.pinned_entry(pin));
    }

    /// A pinned callee, through its entry.
    resolve_pinned(mut &this, pin: CalleePin) -> LValue {
        return this.resolve_decl(this.pinned_entry(pin));
    }

    /// The global registered at `slot` - the coordinate sema pinned on a
    /// qualified path (`MemberPin::Global`) - from its registration slot,
    /// asked by the slot; nothing here is keyed by a name.  In-module, it
    /// is the value `codegen_global_var` registered; cross-module, an
    /// extern declared under the same mangling the defining module emits.
    resolve_global_at(mut &this, slot: i64) -> LValue {
        return this.resolve_global_entry(this.ctx.decl_index.global_entry_at(slot));
    }

    /// The global the definition `d` names - a bare identifier's or a
    /// constant pattern's stamp - from its registration slot, asked by the
    /// id; the index splits the name to the slot's key, not this reader.
    resolve_global_of_def(mut &this, d: DefId) -> LValue {
        return this.resolve_global_entry(
            this.ctx.global_entry_of_def(d));
    }

    /// The value of the global whose slot `entry` is: in-module, the value
    /// `codegen_global_var` registered; cross-module, an extern declared
    /// under the same mangling the defining module emits, cached under the
    /// same slot.  Null for an entry that is not `valid`, and for one this
    /// module defines but has not emitted yet - never an extern for a
    /// module's own global.
    resolve_global_entry(mut &this, entry: GlobalEntry) -> LValue {
        if (!entry.valid) { return LValue::null(); }
        const intern: InternTable* = this.ctx.intern_table;
        const cached: LValue = this.globals.get(entry.slot);
        if (cached.is_valid()) { return cached; }
        if (this.owned_by_current_module(entry.source_file)) { return LValue::null(); }

        const g_llvm_ty: LType = this.type_mapper.map_type(entry.type_ref);
        if (!g_llvm_ty.is_valid()) { return LValue::null(); }

        const mangled: MangledName = if (entry.extern_symbol.is_valid()) {
            MangledName::new(intern.resolve(entry.extern_symbol))
        } else {
            MangledName::for_global(intern, entry.declared_in.decl_name(), entry.leaf)
        };
        mut g_val: LValue = this.llvm_module.get_named_global(mangled);
        if (!g_val.is_valid()) {
            g_val = this.llvm_module.add_global(g_llvm_ty, mangled);
            if (entry.thread_local) {
                g_val.set_thread_local(true);
            }
        }
        this.globals.register(entry.slot, g_val);
        return g_val;
    }



    // Free helpers used by resolver passes

    /// Returns true if the FunctionType reaches a GenericParam
    /// anywhere in its return type or parameter types (walking through
    /// References, Pointers, Arrays, Optionals, Tuples, and InstantiatedTypes
    /// with no resolved_type).  Used by extern-overload declaration to filter
    /// out sema-time registrations of still-generic templates whose param
    /// signatures would otherwise lower to opaque `ptr` and produce a wrong
    /// mangled name.
    static type_ref_has_generic_params(arena: TypeArena*, ty: TypeRef) -> boolean {
        if (!ty.is_valid()) { return false; }
        return SymbolResolver::type_has_generic_params_walker(arena, ty, 0);
    }

    static type_has_generic_params_walker(arena: TypeArena*, ty: TypeRef, depth: i32) -> boolean {
        if (depth > 8) { return false; }
        if (!ty.is_valid()) { return false; }
        const t: Type* = arena.lookup(ty);
        if (t == null) { return false; }
        const k: TypeKind = t.kind;
        if (k == TypeKind::GenericParam) {
            return true;
        }
        if (k == TypeKind::Reference) {
            const r: ReferenceType* = t.as_reference();
            return SymbolResolver::type_has_generic_params_walker(arena, r.referent, depth + 1);
        }
        if (k == TypeKind::Pointer) {
            const p: PointerType* = t.as_pointer();
            return SymbolResolver::type_has_generic_params_walker(arena, p.pointee, depth + 1);
        }
        if (k == TypeKind::Array) {
            const a: ArrayType* = t.as_array();
            return SymbolResolver::type_has_generic_params_walker(arena, a.element, depth + 1);
        }
        if (k == TypeKind::Optional) {
            const o: OptionalType* = t.as_optional();
            return SymbolResolver::type_has_generic_params_walker(arena, o.wrapped, depth + 1);
        }
        if (k == TypeKind::Tuple) {
            const tu: TupleType* = t.as_tuple();
            for (mut i: i64 = 0; i < tu.elements.length; i++) {
                if (SymbolResolver::type_has_generic_params_walker(arena, tu.elements[i], depth + 1)) {
                    return true;
                }
            }
            return false;
        }
        if (k == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t.as_instantiated();
            if (inst.has_resolved_type()) {
                return SymbolResolver::type_has_generic_params_walker(arena, inst.resolved_type, depth + 1);
            }
            // Un-resolved InstantiatedType: walk its type_args for generic
            // params (e.g. `Foo<T>` where T is still a template param).
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                if (SymbolResolver::type_has_generic_params_walker(arena, inst.type_args[i], depth + 1)) {
                    return true;
                }
            }
            return false;
        }
        return false;
    }

    static function_type_has_generic_params(arena: TypeArena*, ft: FunctionType*) -> boolean {
        if (SymbolResolver::type_ref_has_generic_params(arena, ft.return_type)) { return true; }
        for (mut i: i64 = 0; i < ft.param_types.length; i++) {
            if (SymbolResolver::type_ref_has_generic_params(arena, ft.param_types[i])) { return true; }
        }
        return false;
    }

}
