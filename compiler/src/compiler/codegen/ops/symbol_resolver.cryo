/// Symbol Resolver
///
/// On-demand cross-module extern declaration for functions and globals.
/// A bulk pre-pass that walked every function and global in every module
/// would be `O(modules x functions x overloads)` per compiled module,
/// crippling for stdlib-heavy programs with many generic specializations.
///
/// Instead, codegen resolves each cross-module reference on demand:
///   1. the function this module already holds under the SYMBOL;
///   2. else an `external` declaration emitted from the `DeclarationIndex`
///      entry registered under that symbol, then held.
///
/// A callee reaches here as the symbol the front end pinned, or - for the
/// pins written before the symbol existed - as a FAMILY name that must name
/// one symbol.  Nothing here chooses among a family's signatures.
///
/// This mirrors what LLVM itself does via `Module::getOrInsertFunction`.
///
/// Borrows the LLVM module, the type mapper, the function/global
/// registries, and the compilation context via back-pointers set by
/// `CodegenContext::wire()`.

namespace compiler::codegen::ops::symbol_resolver;

import compiler::codegen;
import compiler::codegen::{ llvm_types, type_map, abi };
import compiler::diag::{ ErrorCode, source_span };
import compiler::diag::source_span::{ SourceSpan };
import compiler::codegen::state::{ function_registry, global_registry };
import compiler::compilation_context;
import compiler::compilation_context::{ CompilationContext };
import compiler::decl_index;
import compiler::decl_index::{ DeclarationIndex };
import compiler::types;
import compiler::types::{ arena, compound, generic, type_base, type_ref, TypeKind };
import compiler::resolver::{ symbol_str, intern_table, mangled_name, qualified_name };
import std::fmt;
import compiler::codegen::abi::{ AbiAttr, AbiClassifier, ArgClass, ParamPlan, SignaturePlan };
import compiler::codegen::llvm_types::{ LModule, LType, LValue };
import compiler::codegen::state::function_registry::{ FunctionRegistry };
import compiler::codegen::state::global_registry::{ GlobalRegistry };
import compiler::codegen::type_map::{ TypeMapper };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::mangled_name::{ MangledName };
import compiler::resolver::qualified_name::{ QualifiedName };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::types::arena::{ TypeArena };
import compiler::types::compound::{
    ArrayType, FunctionType, OptionalType, PointerType, ReferenceType, TupleType
};
import compiler::types::generic::{ InstantiatedType };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };


type struct SymbolResolver {
    // Back-pointers (set by wire()).
    llvm_module: LModule*;
    type_mapper: TypeMapper*;
    abi:         AbiClassifier*;
    functions:   FunctionRegistry*;
    globals:     GlobalRegistry*;
    ctx:         CompilationContext*;

    static null() -> SymbolResolver {
        return SymbolResolver {
            llvm_module: null,
            type_mapper: null,
            abi:         null,
            functions:   null,
            globals:     null,
            ctx:         null,
        };
    }

    wire(mut &this, llvm_module: LModule*, type_mapper: TypeMapper*,
         abi: AbiClassifier*,
         functions: FunctionRegistry*, globals: GlobalRegistry*,
         ctx: CompilationContext*) -> void {
        this.llvm_module = llvm_module;
        this.type_mapper = type_mapper;
        this.abi         = abi;
        this.functions   = functions;
        this.globals     = globals;
        this.ctx         = ctx;
    }


    // Function-type construction

    /// Build an LLVM function type from a Cryo `FunctionType*`, routing
    /// through the ABI seam so cross-module extern declarations agree
    /// with the defining module's lowering (sret / byval / ...).
    /// Returns `LType::null()` if classification fails (e.g. an
    /// un-lowered struct or an invalid TypeRef in `ft`).
    build_function_ltype(mut &this, ft: FunctionType*) -> LType {
        const plan: SignaturePlan = this.build_function_plan(ft);
        return plan.llvm_fn_type;
    }

    /// Full SignaturePlan for a Cryo `FunctionType*`.  Returned to the
    /// extern-declare path so it can attach the same `sret(%T)` /
    /// `byval(%T)` attributes the defining module attached, without
    /// re-running classification.
    build_function_plan(mut &this, ft: FunctionType*) -> SignaturePlan {
        return this.abi.classify_signature(
            ft.param_types, ft.return_type, ft.is_variadic);
    }


    // Cross-module extern declaration

    /// The LLVM symbol of signature `ft` of family `name`: the entry's own
    /// registered symbol, else the family's single slot (an `extern "C"`
    /// family registers no per-signature symbol; its slot is the C name),
    /// else the mangling of the pair itself.
    family_symbol(&this, name: SymbolStr, ft: TypeRef) -> SymbolStr {
        const di: DeclarationIndex* = this.ctx.decl_index;
        mut sym: SymbolStr = di.lookup_overload_mangled(name, ft);
        if (!sym.is_valid()) { sym = di.lookup_mangled_name(name); }
        if (sym.is_valid()) { return sym; }
        const arena: TypeArena* = this.ctx.type_arena;
        const ft_ptr: Type* = arena.lookup(ft.id);
        if (ft_ptr == null || ft_ptr.kind != TypeKind::Function) { return SymbolStr::empty(); }
        const f: FunctionType* = ft_ptr as FunctionType*;
        return MangledName::for_free_function(
            this.ctx.intern_table, arena, QualifiedName::from_symbol(name),
            f.param_types, f.return_type, f.is_variadic).value;
    }

    /// Declare the cross-module extern `symbol` at `func_type_ref`'s
    /// signature and register it under that symbol.  An LLVM function already
    /// so named is reused.  Null when the signature cannot be lowered.
    declare_extern_function_as(mut &this, func_type_ref: TypeRef, symbol: SymbolStr) -> LValue {
        const arena: TypeArena* = this.ctx.type_arena;
        const ft_ptr: Type* = arena.lookup(func_type_ref.id);
        if (ft_ptr == null || ft_ptr.kind != TypeKind::Function) { return LValue::null(); }
        const ft: FunctionType* = ft_ptr as FunctionType*;

        const fn_type: LType = this.build_function_ltype(ft);
        if (!fn_type.is_valid()) { return LValue::null(); }

        const ir_name: string = this.ctx.intern_table.resolve(symbol);
        mut fn_val: LValue = this.llvm_module.get_named_function(ir_name);
        if (!fn_val.is_valid()) {
            fn_val = this.llvm_module.add_function(ir_name, fn_type);
            // Cross-module extern must carry the same `sret(%T)` /
            // `byval(%T)` attributes the defining module attached;
            // otherwise call sites and the callee disagree on whether
            // a hidden pointer is present and which slots own copies.
            // Only attach on the first declaration - a pre-existing
            // symbol already carries whatever attributes the defining
            // module attached.
            const xplan: SignaturePlan = this.build_function_plan(ft);
            if (xplan.sret_slot && xplan.return_plan.pointee_ty.is_valid()) {
                this.abi.apply_sret_attribute(fn_val, xplan.return_plan.pointee_ty);
            }
            for (mut xi: i64 = 0; xi < xplan.param_plans.length; xi++) {
                const xpp: &ParamPlan = &xplan.param_plans[xi];
                if (xpp.cls == ArgClass::Indirect
                        && xpp.attr == AbiAttr::ByVal
                        && xpp.pointee_ty.is_valid()) {
                    const xslot: u32 = AbiClassifier::llvm_slot_index_of_param(
                        xplan.param_plans, xplan.sret_slot, xi);
                    this.abi.apply_byval_attribute(fn_val, xslot, xpp.pointee_ty);
                }
            }
        }
        this.functions.register(symbol, fn_val);
        return fn_val;
    }


    /// Returns true if `mod_sym` is the module currently being compiled.  A
    /// global the module itself defines is read from its own registry; an
    /// extern declared for it would clobber the definition.
    owned_by_current_module(&this, mod_sym: SymbolStr) -> boolean {
        if (!mod_sym.is_valid()) { return false; }
        const current: SymbolStr = this.ctx.intern_table.intern(this.ctx.source_file);
        return mod_sym.equals(current);
    }


    // Function / global resolution (held symbol + lazy extern)

    /// The function this module already holds under `sym`: one the declare
    /// passes registered (a definition, a pinned extern, a `![symbol]`-bound
    /// body under its Cryo symbol), else an LLVM function so named.
    held_symbol(&this, sym: SymbolStr) -> LValue {
        const cached: LValue = this.functions.get(sym);
        if (cached.is_valid()) { return cached; }
        return this.llvm_module.get_named_function(this.ctx.intern_table.resolve(sym));
    }

    /// A function by SYMBOL.  Held by this module, else declared extern from
    /// the index entry registered under that symbol: the entry gives the
    /// signature and the symbol stays the caller's - re-deriving it from the
    /// entry's (name, type) would hand back whichever entry of that type
    /// registered first, and `Display::fmt<W>` and `Debug::fmt<W>` on one
    /// receiver share a type and differ only in the symbol.  Several entries
    /// can share one symbol (a trait-impl method under its qualified and its
    /// bare combined name); the first whose signature lowers is declared.
    /// Null for a symbol neither this module nor the index knows.
    resolve_symbol(mut &this, sym: SymbolStr) -> LValue {
        mut v: LValue = this.held_symbol(sym);
        if (v.is_valid()) { return v; }
        const di: DeclarationIndex* = this.ctx.decl_index;
        match (di.mangled_to_overload_pos.get_ref(&sym.id)) {
            Option::Some(positions) => {
                for (mut k: i64 = 0; k < (*positions).length; k++) {
                    const pos: u32 = (*positions)[k];
                    v = this.declare_extern_function_as(di.overload_func_types[pos as i64], sym);
                    if (v.is_valid()) { return v; }
                }
            }
            Option::None => { }
        }
        return LValue::null();
    }

    /// A function by its FAMILY name - the canonical name every signature of
    /// one declaration is registered under - when the family names ONE
    /// symbol, among its signatures of `arity` when one is given.  A
    /// signature carrying a generic parameter is a template and names none;
    /// two declarations under one leaf that are the same C symbol are one
    /// function.  A family naming several symbols is not resolvable by
    /// name: the arguments select among them, that selection is the front
    /// end's pin, and a name reaching here for such a family is an internal
    /// error, never a choice made here.
    resolve_family(mut &this, name: SymbolStr, arity: i64) -> LValue {
        const di: DeclarationIndex* = this.ctx.decl_index;
        const arena: TypeArena* = this.ctx.type_arena;
        const overloads: TypeRef[] = di.lookup_func_type_overloads(name);
        mut sym: SymbolStr = SymbolStr::empty();
        mut ft: TypeRef = TypeRef::invalid();
        for (mut i: i64 = 0; i < overloads.length; i++) {
            const t: Type* = arena.lookup(overloads[i].id);
            if (t == null || t.kind != TypeKind::Function) { continue; }
            const f: FunctionType* = t as FunctionType*;
            if (arity >= 0 && f.param_types.length != arity) { continue; }
            if (SymbolResolver::function_type_has_generic_params(arena, f)) { continue; }
            const s: SymbolStr = this.family_symbol(name, overloads[i]);
            if (!s.is_valid()) { continue; }
            if (sym.is_valid() && !s.equals(sym)) {
                this.ctx.emit_error_at(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    fmt::format("codegen: `%s` names several functions and the call was not pinned to one of them",
                                this.ctx.intern_table.resolve(name)),
                    SourceSpan::none());
                return LValue::null();
            }
            sym = s;
            ft = overloads[i];
        }
        if (!sym.is_valid()) { return LValue::null(); }
        const held: LValue = this.held_symbol(sym);
        if (held.is_valid()) { return held; }
        return this.declare_extern_function_as(ft, sym);
    }

    /// A function by canonical name, for the calls codegen synthesizes
    /// itself (the allocator shims, `string::append`, `std::env::set_args`).
    resolve_function(mut &this, name: SymbolStr) -> LValue {
        return this.resolve_family(name, -1);
    }

    /// A pinned callee.  A pin is a symbol and resolves as one; a pin that is
    /// a family name instead - a module-qualified call, a static on a
    /// specialization, a specialization's own name, each written before its
    /// symbol exists to be pinned - resolves through the family, which must
    /// name one symbol.
    resolve_function_by_mangled(mut &this, pinned: SymbolStr) -> LValue {
        if (!pinned.is_valid()) { return LValue::null(); }
        const v: LValue = this.resolve_symbol(pinned);
        if (v.is_valid()) { return v; }
        return this.resolve_family(pinned, -1);
    }

    /// Look up a global by name, declaring a cross-module extern on demand.
    resolve_global(mut &this, name: SymbolStr) -> LValue {
        const cached: LValue = this.globals.get(name);
        if (cached.is_valid()) { return cached; }

        const intern: InternTable* = this.ctx.intern_table;
        const di: DeclarationIndex* = this.ctx.decl_index;
        if (this.owned_by_current_module(di.get_global_module(name))) {
            return LValue::null();
        }

        const g_type_ref: TypeRef = di.lookup_global(name);
        if (g_type_ref.is_invalid()) { return LValue::null(); }

        const g_llvm_ty: LType = this.type_mapper.map_type(g_type_ref);
        if (!g_llvm_ty.is_valid()) { return LValue::null(); }

        // Mirror codegen_global_var's mangle: pull the defining namespace
        // out of DI so the extern decl in this module refers to the same
        // LLVM symbol the defining module emits.  Empty namespace -> bare
        // `C$<name>` (root-namespace globals).
        // An IMPORTED global has exactly one symbol in the whole program - the
        // one the C library exports - so a reader must not mangle it under the
        // declaring module's namespace the way it does for a global Cryo
        // defines.  Mangling it asks the linker for a name nobody emits.
        const def_ns: SymbolStr = di.get_global_namespace(name);
        const ext_sym: SymbolStr = di.global_extern_symbol(name);
        const mangled: string = if (ext_sym.is_valid()) {
            intern.resolve(ext_sym)
        } else {
            MangledName::for_global(intern, def_ns, name).resolve(intern)
        };

        // Reuse an existing LLVM global if something (e.g. a prior pass)
        // already created one with the same mangled name; identical-name
        // externs share the same symbol at link time.
        mut g_val: LValue = this.llvm_module.get_named_global(mangled);
        if (!g_val.is_valid()) {
            g_val = this.llvm_module.add_global(g_llvm_ty, mangled);
            // A cross-module reference to a `![thread_local]` global must
            // itself be thread-local, or it references the TLS symbol with a
            // non-TLS relocation and fails to link.
            if (di.is_global_thread_local(name)) {
                g_val.set_thread_local(true);
            }
        }
        this.globals.register(name, g_val);
        return g_val;
    }

    /// The global `name` as declared by the module whose namespace is `ns` -
    /// the module a qualified reference's stamp names.  In-module, it is the
    /// value `codegen_global_var` registered under the bare leaf; cross-module,
    /// an extern declared under the same mangling the defining module emits,
    /// cached under the namespace-qualified key.  Null when that module
    /// declares no such global: the answer is then that nothing does, not a
    /// licence to ask another module.
    resolve_global_in_namespace(mut &this, name: SymbolStr, ns: SymbolStr) -> LValue {
        const intern: InternTable* = this.ctx.intern_table;
        const di: DeclarationIndex* = this.ctx.decl_index;
        mut def_module: SymbolStr = SymbolStr::empty();
        const g_type_ref: TypeRef = di.find_global_in_namespace(name, ns, &def_module);
        if (g_type_ref.is_invalid()) { return LValue::null(); }
        if (this.owned_by_current_module(def_module)) { return this.globals.get(name); }

        const cache_key: SymbolStr = intern.intern(
            fmt::format("%s::%s", intern.resolve(ns), intern.resolve(name)));
        const cached: LValue = this.globals.get(cache_key);
        if (cached.is_valid()) { return cached; }

        const g_llvm_ty: LType = this.type_mapper.map_type(g_type_ref);
        if (!g_llvm_ty.is_valid()) { return LValue::null(); }

        const ext_sym: SymbolStr = di.global_extern_symbol(name);
        const mangled: string = if (ext_sym.is_valid()) {
            intern.resolve(ext_sym)
        } else {
            MangledName::for_global(intern, ns, name).resolve(intern)
        };
        mut g_val: LValue = this.llvm_module.get_named_global(mangled);
        if (!g_val.is_valid()) {
            g_val = this.llvm_module.add_global(g_llvm_ty, mangled);
            if (di.is_global_thread_local(name)) {
                g_val.set_thread_local(true);
            }
        }
        this.globals.register(cache_key, g_val);
        return g_val;
    }



    // Free helpers used by resolver passes

    /// Returns true if the FunctionType reaches a GenericParam / BoundedParam
    /// anywhere in its return type or parameter types (walking through
    /// References, Pointers, Arrays, Optionals, Tuples, and InstantiatedTypes
    /// with no resolved_type).  Used by extern-overload declaration to filter
    /// out sema-time registrations of still-generic templates whose param
    /// signatures would otherwise lower to opaque `ptr` and produce a wrong
    /// mangled name.
    static type_ref_has_generic_params(arena: TypeArena*, ty: TypeRef) -> boolean {
        if (!ty.is_valid()) { return false; }
        return SymbolResolver::type_has_generic_params_walker(arena, ty, 0);
    }

    static type_has_generic_params_walker(arena: TypeArena*, ty: TypeRef, depth: i32) -> boolean {
        if (depth > 8) { return false; }
        if (!ty.is_valid()) { return false; }
        const t: Type* = arena.lookup(ty.id);
        if (t == null) { return false; }
        const k: TypeKind = t.kind;
        if (k == TypeKind::GenericParam || k == TypeKind::BoundedParam) {
            return true;
        }
        if (k == TypeKind::Reference) {
            const r: ReferenceType* = t as ReferenceType*;
            return SymbolResolver::type_has_generic_params_walker(arena, r.referent, depth + 1);
        }
        if (k == TypeKind::Pointer) {
            const p: PointerType* = t as PointerType*;
            return SymbolResolver::type_has_generic_params_walker(arena, p.pointee, depth + 1);
        }
        if (k == TypeKind::Array) {
            const a: ArrayType* = t as ArrayType*;
            return SymbolResolver::type_has_generic_params_walker(arena, a.element, depth + 1);
        }
        if (k == TypeKind::Optional) {
            const o: OptionalType* = t as OptionalType*;
            return SymbolResolver::type_has_generic_params_walker(arena, o.wrapped, depth + 1);
        }
        if (k == TypeKind::Tuple) {
            const tu: TupleType* = t as TupleType*;
            for (mut i: i64 = 0; i < tu.elements.length; i++) {
                if (SymbolResolver::type_has_generic_params_walker(arena, tu.elements[i], depth + 1)) {
                    return true;
                }
            }
            return false;
        }
        if (k == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (inst.has_resolved_type()) {
                return SymbolResolver::type_has_generic_params_walker(arena, inst.resolved_type, depth + 1);
            }
            // Un-resolved InstantiatedType: walk its type_args for generic
            // params (e.g. `Foo<T>` where T is still a template param).
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                if (SymbolResolver::type_has_generic_params_walker(arena, inst.type_args[i], depth + 1)) {
                    return true;
                }
            }
            return false;
        }
        return false;
    }

    static function_type_has_generic_params(arena: TypeArena*, ft: FunctionType*) -> boolean {
        if (SymbolResolver::type_ref_has_generic_params(arena, ft.return_type)) { return true; }
        for (mut i: i64 = 0; i < ft.param_types.length; i++) {
            if (SymbolResolver::type_ref_has_generic_params(arena, ft.param_types[i])) { return true; }
        }
        return false;
    }

}
