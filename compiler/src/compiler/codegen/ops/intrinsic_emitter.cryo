/// Intrinsic Emitter
///
/// Inline-lowering for the bare-name intrinsics declared in
/// `stdlib/core/intrinsics.cryo` (sign-extension, pointer arithmetic,
/// rotates, ctlz/cttz, fp/int conversions, atomic_fence, fpclass,
/// cheap fp math (fabs/floor/ceil/ftrunc/round/copysign/sqrt/fma),
/// dirent_name/type, panic).  Also emits the per-module `@panic` and
/// `@format` runtime helpers as `linkonce_odr` definitions so the linker
/// can collapse copies across translation units.
///
/// Methods are kind-driven: `try_emit(name, args)` runs
/// `IntrinsicKind::from_name` from `IntrinsicsCodegen`, validates arity,
/// and dispatches to a per-kind LLVM emission path.  Returns
/// `Option::None` when the call should fall through to the regular
/// function-resolution path.
///
/// Holds back-pointers to the LLVM builder and module set by
/// `CodegenContext::wire()`.  Does NOT import the parent Context module
/// to avoid a module-graph cycle; the runtime-helper paths emit LLVM
/// calls directly via `LBuilder::build_call` instead of routing through
/// the parent's `codegen_call` helper.

namespace Compiler::Codegen::Ops::IntrinsicEmitter;

import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Codegen::Abi;
import Compiler::Codegen::Ops::IntrinsicsCodegen;


type struct IntrinsicEmitter {
    llvm_module: LModule*;
    builder:     LBuilder*;
    /// Back-pointer to the per-context ABI classifier.  Read by
    /// `emit_format_runtime` to pick the va_list alloca shape and
    /// forwarding form for the active target (SysV-amd64 vs Win64).
    /// Null between `null()` and `wire()`.
    abi:         AbiClassifier*;
    /// `[compiler] no_runtime`: in a freestanding build there is no `@panic`
    /// runtime (it prints via libc and `abort()`s), so `emit_panic_call`
    /// routes divergent check failures through `llvm.trap` (`ud2`, no libc)
    /// instead.  Wired from `ctx.project_no_runtime`.
    no_runtime:  boolean;

    /// `--panic=unwind`: route `emit_panic_call` to the external raising
    /// `__cryo_panic` (linked from the `panic/unwind` runtime tier) instead of
    /// the per-module `linkonce_odr` libc `@panic`, so a panic RAISES and the
    /// Phase-C cleanup landing pads run as the unwind passes through their
    /// frames.  Wired from `ctx.project_panic_unwind`; false on the default
    /// abort path keeps the emitted IR byte-identical.
    panic_unwind: boolean;

    static null() -> IntrinsicEmitter {
        return IntrinsicEmitter {
            llvm_module:  null,
            builder:      null,
            abi:          null,
            no_runtime:   false,
            panic_unwind: false,
        };
    }

    wire(mut &this, llvm_module: LModule*, builder: LBuilder*,
         abi: AbiClassifier*, no_runtime: boolean, panic_unwind: boolean) -> void {
        this.llvm_module  = llvm_module;
        this.builder      = builder;
        this.abi          = abi;
        this.no_runtime   = no_runtime;
        this.panic_unwind = panic_unwind;
    }


    // Auto-deref helper (inlined from CodegenContext to avoid the module
    // cycle that storing a CodegenContext* back-pointer would introduce).

    auto_deref_to(mut &this, val: LValue, expected: LType) -> LValue {
        if (!val.is_valid() || !expected.is_valid()) { return val; }
        const actual_ty: void* = llvm::LLVMTypeOf(val.raw);
        if (actual_ty == null) { return val; }
        if (LType::kind_of(actual_ty) == LTypeKind::Pointer) {
            return this.builder.build_load(expected, val, "deref");
        }
        return val;
    }

    /// Attach an `any`-selection comdat keyed on `name` to a runtime
    /// helper function so the COFF linker dedupes the per-module copies
    /// of `linkonce_odr` definitions.  On ELF this is also valid (the
    /// section group folds silently); on COFF without the comdat the
    /// mingw-w64 linker rejects the second module's copy as a
    /// "multiple definition" error.  Selection kind is the LLVM-C
    /// default `LLVMAnyComdatSelectionKind` (0) - "pick any, all
    /// definitions are equivalent" - which is the right pick for
    /// linkonce_odr.
    attach_runtime_comdat(mut &this, fn_val: LValue, name: string) -> void {
        if (!fn_val.is_valid()) { return; }
        const comdat: void* = llvm::LLVMGetOrInsertComdat(
            this.llvm_module.raw, name);
        if (comdat == null) { return; }
        llvm::LLVMSetComdat(fn_val.raw, comdat);
    }


    // Per-kind LLVM-intrinsic factories

    get_or_decl_unary_intrinsic(mut &this, name: string, ty: LType) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function(name);
        if (fn.is_valid()) { return fn; }
        const param_buf: void* = intrinsics::malloc(8);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 1, false);
        intrinsics::free(param_buf);
        return this.llvm_module.add_function(name, fn_ty);
    }

    get_or_decl_ctlz_cttz(mut &this, name: string, ty: LType) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function(name);
        if (fn.is_valid()) { return fn; }
        const param_buf: void* = intrinsics::malloc(16);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        param_slots[1] = LType::i1().raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 2, false);
        intrinsics::free(param_buf);
        return this.llvm_module.add_function(name, fn_ty);
    }

    /// `declare T @name(T, T)` - homogeneous binary LLVM intrinsics
    /// (llvm.copysign.*).
    get_or_decl_binary_intrinsic(mut &this, name: string, ty: LType) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function(name);
        if (fn.is_valid()) { return fn; }
        const param_buf: void* = intrinsics::malloc(16);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        param_slots[1] = ty.raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 2, false);
        intrinsics::free(param_buf);
        return this.llvm_module.add_function(name, fn_ty);
    }

    /// `declare T @name(T, T, T)` - homogeneous ternary LLVM intrinsics
    /// (llvm.fshl/fshr funnel shifts, llvm.fma.*).
    get_or_decl_ternary_intrinsic(mut &this, name: string, ty: LType) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function(name);
        if (fn.is_valid()) { return fn; }
        const param_buf: void* = intrinsics::malloc(24);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        param_slots[1] = ty.raw;
        param_slots[2] = ty.raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 3, false);
        intrinsics::free(param_buf);
        return this.llvm_module.add_function(name, fn_ty);
    }

    /// `declare void @name()` - zero-arg void intrinsics (llvm.trap /
    /// llvm.debugtrap).
    get_or_decl_void_noarg(mut &this, name: string) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function(name);
        if (fn.is_valid()) { return fn; }
        const fn_ty: LType = LType::function_type(LType::void_type(), null, 0, false);
        return this.llvm_module.add_function(name, fn_ty);
    }

    /// `declare ptr @name(i32)` - llvm.frameaddress.p0 / llvm.returnaddress.
    /// Emits the call; `level` (a0) is the constant frame index.
    emit_addr_intrinsic(mut &this, name: string, level: LValue) -> LValue {
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        mut fn: LValue = this.llvm_module.get_named_function(name);
        if (!fn.is_valid()) {
            const dbuf: void* = intrinsics::malloc(8);
            const dslots: void** = dbuf as void**;
            dslots[0] = LType::i32().raw;
            const decl_ty: LType = LType::function_type(ptr_ty, dbuf, 1, false);
            intrinsics::free(dbuf);
            fn = this.llvm_module.add_function(name, decl_ty);
        }
        const cbuf: void* = intrinsics::malloc(8);
        const cslots: void** = cbuf as void**;
        cslots[0] = LType::i32().raw;
        const call_ty: LType = LType::function_type(ptr_ty, cbuf, 1, false);
        intrinsics::free(cbuf);
        return this.call1(fn, call_ty, level, "addr");
    }

    // `declare i1 @llvm.is.fpclass.f64(double, i32)`.  The i32 test mask is
    // an immarg at the call site; the declared parameter type is plain i32.
    get_or_decl_fpclass(mut &this, name: string, val_ty: LType, mask_ty: LType) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function(name);
        if (fn.is_valid()) { return fn; }
        const param_buf: void* = intrinsics::malloc(16);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = val_ty.raw;
        param_slots[1] = mask_ty.raw;
        const fn_ty: LType = LType::function_type(LType::i1(), param_buf, 2, false);
        intrinsics::free(param_buf);
        return this.llvm_module.add_function(name, fn_ty);
    }


    // Direct LLVM call helpers (sized-arg variants for the intrinsic paths)

    call1(mut &this, fn: LValue, fn_ty: LType, a: LValue, name: string) -> LValue {
        const buf: void* = intrinsics::malloc(8);
        const slots: void** = buf as void**;
        slots[0] = a.raw;
        const r: LValue = this.builder.build_call(fn_ty, fn, buf, 1, name);
        intrinsics::free(buf);
        return r;
    }

    call2(mut &this, fn: LValue, fn_ty: LType, a: LValue, b: LValue, name: string) -> LValue {
        const buf: void* = intrinsics::malloc(16);
        const slots: void** = buf as void**;
        slots[0] = a.raw;
        slots[1] = b.raw;
        const r: LValue = this.builder.build_call(fn_ty, fn, buf, 2, name);
        intrinsics::free(buf);
        return r;
    }

    call3(mut &this, fn: LValue, fn_ty: LType, a: LValue, b: LValue, c: LValue, name: string) -> LValue {
        const buf: void* = intrinsics::malloc(24);
        const slots: void** = buf as void**;
        slots[0] = a.raw;
        slots[1] = b.raw;
        slots[2] = c.raw;
        const r: LValue = this.builder.build_call(fn_ty, fn, buf, 3, name);
        intrinsics::free(buf);
        return r;
    }


    // Per-intrinsic IR emission helpers

    emit_ptr_diff(mut &this, a: LValue, b: LValue) -> LValue {
        const i64_ty: LType = LType::i64();
        const ai: LValue = this.builder.build_ptr_to_int(a, i64_ty, "p.a");
        const bi: LValue = this.builder.build_ptr_to_int(b, i64_ty, "p.b");
        return this.builder.build_sub(ai, bi, "ptr.diff");
    }

    emit_unary_llvm(mut &this, iname: string, ty: LType, x: LValue, narrow_to_i32: boolean, label: string) -> LValue {
        const fn: LValue = this.get_or_decl_unary_intrinsic(iname, ty);
        if (!fn.is_valid()) { return LValue::null(); }
        const param_buf: void* = intrinsics::malloc(8);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 1, false);
        intrinsics::free(param_buf);
        const raw: LValue = this.call1(fn, fn_ty, x, label);
        if (narrow_to_i32 && llvm::LLVMGetIntTypeWidth(ty.raw) != 32) {
            return this.builder.build_trunc(raw, LType::i32(), "narrow.i32");
        }
        return raw;
    }

    emit_clz_or_ctz(mut &this, iname: string, ty: LType, x: LValue) -> LValue {
        const fn: LValue = this.get_or_decl_ctlz_cttz(iname, ty);
        if (!fn.is_valid()) { return LValue::null(); }
        const param_buf: void* = intrinsics::malloc(16);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        param_slots[1] = LType::i1().raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 2, false);
        intrinsics::free(param_buf);
        // is_zero_undef = false: zero input returns the bit width.
        const flag: LValue = LType::const_int(LType::i1(), 0, false);
        const raw: LValue = this.call2(fn, fn_ty, x, flag, "clztmp");
        if (llvm::LLVMGetIntTypeWidth(ty.raw) != 32) {
            return this.builder.build_trunc(raw, LType::i32(), "narrow.i32");
        }
        return raw;
    }

    emit_rotate(mut &this, iname: string, ty: LType, x: LValue, n: LValue) -> LValue {
        const fn: LValue = this.get_or_decl_ternary_intrinsic(iname, ty);
        if (!fn.is_valid()) { return LValue::null(); }
        const param_buf: void* = intrinsics::malloc(24);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        param_slots[1] = ty.raw;
        param_slots[2] = ty.raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 3, false);
        intrinsics::free(param_buf);
        // Rotate signature is `(value, n: u32)`; funnel-shift wants the
        // shift amount in the same width as the value.  For 64-bit
        // rotates, widen the i32 shift count to i64.  We read the value
        // type's bit width directly (LLVMGetIntTypeWidth) rather than
        // comparing LLVM type handles: the width is exactly what decides
        // whether the i32 shift count needs widening.
        mut shift: LValue = n;
        const target_width: u32 = llvm::LLVMGetIntTypeWidth(ty.raw);
        if (target_width == 64) {
            shift = this.builder.build_zext(shift, LType::i64(), "rot.shift.zext");
        }
        return this.call3(fn, fn_ty, x, x, shift, "rot");
    }

    /// Emit `call T @iname(T x, T y)` for a homogeneous binary LLVM
    /// intrinsic (llvm.copysign.f64).
    emit_binary_llvm(mut &this, iname: string, ty: LType, x: LValue, y: LValue, label: string) -> LValue {
        const fn: LValue = this.get_or_decl_binary_intrinsic(iname, ty);
        if (!fn.is_valid()) { return LValue::null(); }
        const param_buf: void* = intrinsics::malloc(16);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        param_slots[1] = ty.raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 2, false);
        intrinsics::free(param_buf);
        return this.call2(fn, fn_ty, x, y, label);
    }

    /// Emit `call T @iname(T x, T y, T z)` for a homogeneous ternary LLVM
    /// intrinsic (llvm.fma.f64).
    emit_ternary_llvm(mut &this, iname: string, ty: LType, x: LValue, y: LValue, z: LValue, label: string) -> LValue {
        const fn: LValue = this.get_or_decl_ternary_intrinsic(iname, ty);
        if (!fn.is_valid()) { return LValue::null(); }
        const param_buf: void* = intrinsics::malloc(24);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ty.raw;
        param_slots[1] = ty.raw;
        param_slots[2] = ty.raw;
        const fn_ty: LType = LType::function_type(ty, param_buf, 3, false);
        intrinsics::free(param_buf);
        return this.call3(fn, fn_ty, x, y, z, label);
    }

    // Emit `call i1 @llvm.is.fpclass.f64(double x, i32 <mask>)`.
    //
    // The test mask must be an LLVM immarg (compile-time constant): stdlib
    // callers always pass an integer literal, so we read the constant value
    // out of `mask_val` and rebuild it as a fresh i32 constant operand.  A
    // non-constant mask is unreachable in practice (the intrinsic is stdlib-
    // internal); it degrades to mask 0 (always-false) rather than emitting
    // invalid IR, mirroring the atomic-ordering fallback.
    emit_fpclass(mut &this, x: LValue, mask_val: LValue) -> LValue {
        const val_ty:  LType = LType::f64();
        const mask_ty: LType = LType::i32();
        const fn: LValue = this.get_or_decl_fpclass("llvm.is.fpclass.f64", val_ty, mask_ty);
        if (!fn.is_valid()) { return LValue::null(); }
        mut mask_bits: u64 = 0;
        if (mask_val.is_valid() && llvm::LLVMIsConstant(mask_val.raw) != 0) {
            mask_bits = llvm::LLVMConstIntGetZExtValue(mask_val.raw);
        }
        const mask_const: LValue = LType::const_int(mask_ty, mask_bits, false);
        const param_buf: void* = intrinsics::malloc(16);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = val_ty.raw;
        param_slots[1] = mask_ty.raw;
        const fn_ty: LType = LType::function_type(LType::i1(), param_buf, 2, false);
        intrinsics::free(param_buf);
        return this.call2(fn, fn_ty, x, mask_const, "fpclass");
    }


    // Atomic op helpers
    //
    // The `order` argument of every atomic intrinsic MUST be a
    // compile-time constant Ordering enum value: LLVM's atomic ordering
    // is part of the instruction itself, not a runtime operand.  We
    // verify with LLVMIsConstant and extract the value with
    // LLVMConstIntGetZExtValue; a non-constant falls back to SeqCst
    // (the safest ordering), which should be unreachable in practice
    // because std::sync::atomic only passes Ordering enum constants.

    extract_ordering_arg(mut &this, order_val: LValue) -> i32 {
        if (llvm::LLVMIsConstant(order_val.raw) == 0) {
            return 7;  // SequentiallyConsistent fallback
        }
        return llvm::LLVMConstIntGetZExtValue(order_val.raw) as i32;
    }

    /// Emit `load atomic Ty, Ptr ordering, align Bytes`.
    emit_atomic_load(mut &this, width_ty: LType, align_bytes: u32,
                     ptr: LValue, order_val: LValue) -> LValue {
        const order: i32 = this.extract_ordering_arg(order_val);
        return this.builder.build_atomic_load(width_ty, ptr, order, align_bytes, "atom.load");
    }

    /// Emit `store atomic Val, Ptr ordering, align Bytes`.  Returns a
    /// null LValue since stores are void.
    emit_atomic_store(mut &this, align_bytes: u32,
                      ptr: LValue, val: LValue, order_val: LValue) -> LValue {
        const order: i32 = this.extract_ordering_arg(order_val);
        this.builder.build_atomic_store(val, ptr, order, align_bytes);
        return LValue::null();
    }

    /// Emit `atomicrmw Op Ptr, Val ordering`.  `op_code` is an
    /// LLVMAtomicRMWBinOp value (Xchg=0, Add=1, Sub=2, And=3, Nand=4,
    /// Or=5, Xor=6, Max=7, Min=8, UMax=9, UMin=10).  Returns the
    /// pre-modification value of `*ptr`.
    emit_atomic_rmw(mut &this, op_code: i32,
                    ptr: LValue, val: LValue, order_val: LValue) -> LValue {
        const order: i32 = this.extract_ordering_arg(order_val);
        return this.builder.build_atomic_rmw(op_code, ptr, val, order);
    }

    /// Emit a single `cmpxchg`, extract both halves of its `{T, i1}`
    /// aggregate result, zext the success flag to Cryo's i8 boolean,
    /// store it through `out_ok`, and return the loaded value as the
    /// intrinsic's result.  One instruction in IR; no duplication.
    emit_atomic_cmpxchg(mut &this,
                        ptr: LValue, cmp: LValue, new_val: LValue,
                        succ_val: LValue, fail_val: LValue,
                        out_ok: LValue) -> LValue {
        const succ: i32 = this.extract_ordering_arg(succ_val);
        const fail: i32 = this.extract_ordering_arg(fail_val);
        const agg: LValue = this.builder.build_atomic_cmpxchg(
            ptr, cmp, new_val, succ, fail
        );
        const old_val: LValue = this.builder.build_extract_value(agg, 0, "cx.val");
        const ok_i1:   LValue = this.builder.build_extract_value(agg, 1, "cx.ok");
        const ok_i8:   LValue = this.builder.build_zext(ok_i1, LType::i8(), "cx.ok.i8");
        this.builder.build_store(ok_i8, out_ok);
        return old_val;
    }


    // Dispatcher

    /// Inline-lower a bare-name function call to LLVM IR.  Returns
    /// `Option::Some(value)` if `name` matches a known intrinsic, or
    /// `Option::None` if the call should fall through to the normal
    /// function-resolution path.
    try_emit(mut &this, name: string, args: LValue[]) -> Option<LValue> {
        const kind: IntrinsicKind = IntrinsicKind::from_name(name);

        // Argument-count checks: every recognized intrinsic has a fixed
        // arity, so this is a single guard.
        const expected: i64 = match (kind) {
            IntrinsicKind::NotIntrinsic => { -1 }
            IntrinsicKind::PtrDiff      => { 2 }
            IntrinsicKind::Rotl32       => { 2 }
            IntrinsicKind::Rotl64       => { 2 }
            IntrinsicKind::Rotr32       => { 2 }
            IntrinsicKind::Rotr64       => { 2 }
            // panic(message: string, file: string, line: u32)
            IntrinsicKind::Panic        => { 3 }
            // Atomic loads: (ptr, order) - 2 args.
            IntrinsicKind::AtomicLoadU8    => { 2 }
            IntrinsicKind::AtomicLoadU32   => { 2 }
            IntrinsicKind::AtomicLoadU64   => { 2 }
            // Atomic stores and RMW ops: (ptr, value, order) - 3 args.
            IntrinsicKind::AtomicStoreU8   => { 3 }
            IntrinsicKind::AtomicStoreU32  => { 3 }
            IntrinsicKind::AtomicStoreU64  => { 3 }
            IntrinsicKind::AtomicAddU8     => { 3 }
            IntrinsicKind::AtomicAddU32    => { 3 }
            IntrinsicKind::AtomicAddU64    => { 3 }
            IntrinsicKind::AtomicSubU8     => { 3 }
            IntrinsicKind::AtomicSubU32    => { 3 }
            IntrinsicKind::AtomicSubU64    => { 3 }
            IntrinsicKind::AtomicAndU8     => { 3 }
            IntrinsicKind::AtomicAndU32    => { 3 }
            IntrinsicKind::AtomicAndU64    => { 3 }
            IntrinsicKind::AtomicOrU8      => { 3 }
            IntrinsicKind::AtomicOrU32     => { 3 }
            IntrinsicKind::AtomicOrU64     => { 3 }
            IntrinsicKind::AtomicXorU8     => { 3 }
            IntrinsicKind::AtomicXorU32    => { 3 }
            IntrinsicKind::AtomicXorU64    => { 3 }
            IntrinsicKind::AtomicSwapU8    => { 3 }
            IntrinsicKind::AtomicSwapU32   => { 3 }
            IntrinsicKind::AtomicSwapU64   => { 3 }
            // cmpxchg: (ptr, cmp, new, succ_order, fail_order, out_ok)
            IntrinsicKind::AtomicCmpxchgU8  => { 6 }
            IntrinsicKind::AtomicCmpxchgU32 => { 6 }
            IntrinsicKind::AtomicCmpxchgU64 => { 6 }
            // vprintf(fmt, va) - 2 args; vfprintf(file, fmt, va) - 3 args.
            IntrinsicKind::Vprintf  => { 2 }
            IntrinsicKind::Vfprintf => { 3 }
            // fpclass(value: f64, test: i32): value + constant test mask.
            IntrinsicKind::FpClass      => { 2 }
            // trap()/debugtrap(): zero args.  frame_address/return_address
            // take one (constant) level arg and fall through to the default.
            IntrinsicKind::Trap         => { 0 }
            IntrinsicKind::DebugTrap    => { 0 }
            // copysign64(magnitude, sign); fma64(x, y, z).  The remaining
            // cheap-math intrinsics are unary and use the default below.
            IntrinsicKind::Copysign64   => { 2 }
            IntrinsicKind::Fma64        => { 3 }
            // atomic_fence(order: i32): single arg.  dirent_* also single
            // arg, so they fall through to the default below.
            _                           => { 1 }
        };
        if (expected < 0)            { return Option::None; }
        if (args.length != expected) { return Option::None; }

        // Auto-deref pointer args for value-arg intrinsics: handles the
        // pervasive `intrinsic(&this)` pattern in stdlib's
        // primitives.cryo.  No-op for the pointer-arg intrinsic
        // (PtrDiff) since src_type returns null for it.
        const src_ty: LType = kind.src_type();
        // Guard args[0]: zero-arg intrinsics (trap/debugtrap) have no args[0].
        mut a0: LValue = if (args.length >= 1) { args[0] } else { LValue::null() };
        if (src_ty.is_valid() && a0.is_valid()) {
            a0 = this.auto_deref_to(a0, src_ty);
        }
        // Second argument (rotate count) is i32; auto-deref if pointer.
        mut a1: LValue = if (args.length >= 2) { args[1] } else { LValue::null() };
        const is_rotate: boolean = match (kind) {
            IntrinsicKind::Rotl32 => { true }
            IntrinsicKind::Rotl64 => { true }
            IntrinsicKind::Rotr32 => { true }
            IntrinsicKind::Rotr64 => { true }
            _                     => { false }
        };
        if (is_rotate && a1.is_valid()) {
            a1 = this.auto_deref_to(a1, LType::i32());
        }

        mut out_value: LValue = match (kind) {
            IntrinsicKind::NotIntrinsic => { LValue::null() }   // unreachable

            // -- Pointer arithmetic (no auto-deref of args[0]; this
            //    intentionally accepts pointers and produces a count). --
            IntrinsicKind::PtrDiff => { this.emit_ptr_diff(args[0], args[1]) }

            // -- Signed widening (sext) --
            IntrinsicKind::SExt8To16   => { this.builder.build_sext(a0, LType::i16(), "sext") }
            IntrinsicKind::SExt8To32   => { this.builder.build_sext(a0, LType::i32(), "sext") }
            IntrinsicKind::SExt8To64   => { this.builder.build_sext(a0, LType::i64(), "sext") }
            IntrinsicKind::SExt16To32  => { this.builder.build_sext(a0, LType::i32(), "sext") }
            IntrinsicKind::SExt16To64  => { this.builder.build_sext(a0, LType::i64(), "sext") }
            IntrinsicKind::SExt32To64  => { this.builder.build_sext(a0, LType::i64(), "sext") }

            // -- Signed narrowing (trunc) --
            IntrinsicKind::Trunc64To32 => { this.builder.build_trunc(a0, LType::i32(), "trunc") }
            IntrinsicKind::Trunc64To16 => { this.builder.build_trunc(a0, LType::i16(), "trunc") }
            IntrinsicKind::Trunc64To8  => { this.builder.build_trunc(a0, LType::i8(),  "trunc") }
            IntrinsicKind::Trunc32To16 => { this.builder.build_trunc(a0, LType::i16(), "trunc") }
            IntrinsicKind::Trunc32To8  => { this.builder.build_trunc(a0, LType::i8(),  "trunc") }
            IntrinsicKind::Trunc16To8  => { this.builder.build_trunc(a0, LType::i8(),  "trunc") }

            // -- Unsigned widening (zext) --
            IntrinsicKind::ZExt8To16   => { this.builder.build_zext(a0, LType::i16(), "zext") }
            IntrinsicKind::ZExt8To32   => { this.builder.build_zext(a0, LType::i32(), "zext") }
            IntrinsicKind::ZExt8To64   => { this.builder.build_zext(a0, LType::i64(), "zext") }
            IntrinsicKind::ZExt16To32  => { this.builder.build_zext(a0, LType::i32(), "zext") }
            IntrinsicKind::ZExt16To64  => { this.builder.build_zext(a0, LType::i64(), "zext") }
            IntrinsicKind::ZExt32To64  => { this.builder.build_zext(a0, LType::i64(), "zext") }

            // -- Unsigned narrowing (trunc; LLVM doesn't distinguish
            //    signed from unsigned at the type level, so this emits
            //    the same instruction as the signed variants above) --
            IntrinsicKind::UTrunc64To32 => { this.builder.build_trunc(a0, LType::i32(), "trunc") }
            IntrinsicKind::UTrunc64To16 => { this.builder.build_trunc(a0, LType::i16(), "trunc") }
            IntrinsicKind::UTrunc64To8  => { this.builder.build_trunc(a0, LType::i8(),  "trunc") }
            IntrinsicKind::UTrunc32To16 => { this.builder.build_trunc(a0, LType::i16(), "trunc") }
            IntrinsicKind::UTrunc32To8  => { this.builder.build_trunc(a0, LType::i8(),  "trunc") }
            IntrinsicKind::UTrunc16To8  => { this.builder.build_trunc(a0, LType::i8(),  "trunc") }

            // -- Same-width sign conversions (no-op) --
            IntrinsicKind::SignBitcast8  => { a0 }
            IntrinsicKind::SignBitcast32 => { a0 }
            IntrinsicKind::SignBitcast64 => { a0 }

            // -- Float widening / narrowing --
            IntrinsicKind::FpExt32To64   => { this.builder.build_fp_ext(a0, LType::f64(), "fpext") }
            IntrinsicKind::FpTrunc64To32 => { this.builder.build_fp_trunc(a0, LType::f32(), "fptrunc") }

            // -- Signed int -> float --
            IntrinsicKind::SiToF32         => { this.builder.build_si_to_fp(a0, LType::f32(), "sitofp") }
            IntrinsicKind::SiToF64Fromi32  => { this.builder.build_si_to_fp(a0, LType::f64(), "sitofp") }
            IntrinsicKind::SiToF64Fromi64  => { this.builder.build_si_to_fp(a0, LType::f64(), "sitofp") }

            // -- Unsigned int -> float --
            IntrinsicKind::UiToF32         => { this.builder.build_ui_to_fp(a0, LType::f32(), "uitofp") }
            IntrinsicKind::UiToF64Fromu32  => { this.builder.build_ui_to_fp(a0, LType::f64(), "uitofp") }
            IntrinsicKind::UiToF64Fromu64  => { this.builder.build_ui_to_fp(a0, LType::f64(), "uitofp") }

            // -- Float -> signed int --
            IntrinsicKind::FpToSi32Fromf32 => { this.builder.build_fp_to_si(a0, LType::i32(), "fptosi") }
            IntrinsicKind::FpToSi32Fromf64 => { this.builder.build_fp_to_si(a0, LType::i32(), "fptosi") }
            IntrinsicKind::FpToSi64Fromf64 => { this.builder.build_fp_to_si(a0, LType::i64(), "fptosi") }

            // -- Float -> unsigned int --
            IntrinsicKind::FpToUi32Fromf32 => { this.builder.build_fp_to_ui(a0, LType::i32(), "fptoui") }
            IntrinsicKind::FpToUi32Fromf64 => { this.builder.build_fp_to_ui(a0, LType::i32(), "fptoui") }
            IntrinsicKind::FpToUi64Fromf64 => { this.builder.build_fp_to_ui(a0, LType::i64(), "fptoui") }

            // -- Bit operations --
            IntrinsicKind::Bswap16    => { this.emit_unary_llvm("llvm.bswap.i16", LType::i16(), a0, false, "bswap") }
            IntrinsicKind::Bswap32    => { this.emit_unary_llvm("llvm.bswap.i32", LType::i32(), a0, false, "bswap") }
            IntrinsicKind::Bswap64    => { this.emit_unary_llvm("llvm.bswap.i64", LType::i64(), a0, false, "bswap") }
            IntrinsicKind::Popcount32 => { this.emit_unary_llvm("llvm.ctpop.i32", LType::i32(), a0, true, "ctpop") }
            IntrinsicKind::Popcount64 => { this.emit_unary_llvm("llvm.ctpop.i64", LType::i64(), a0, true, "ctpop") }
            IntrinsicKind::Clz32 => { this.emit_clz_or_ctz("llvm.ctlz.i32", LType::i32(), a0) }
            IntrinsicKind::Clz64 => { this.emit_clz_or_ctz("llvm.ctlz.i64", LType::i64(), a0) }
            IntrinsicKind::Ctz32 => { this.emit_clz_or_ctz("llvm.cttz.i32", LType::i32(), a0) }
            IntrinsicKind::Ctz64 => { this.emit_clz_or_ctz("llvm.cttz.i64", LType::i64(), a0) }
            IntrinsicKind::Rotl32 => { this.emit_rotate("llvm.fshl.i32", LType::i32(), a0, a1) }
            IntrinsicKind::Rotl64 => { this.emit_rotate("llvm.fshl.i64", LType::i64(), a0, a1) }
            IntrinsicKind::Rotr32 => { this.emit_rotate("llvm.fshr.i32", LType::i32(), a0, a1) }
            IntrinsicKind::Rotr64 => { this.emit_rotate("llvm.fshr.i64", LType::i64(), a0, a1) }

            // -- atomic_fence(order): emit `fence <order>`.  The Ordering is
            //    part of the instruction (extracted as a constant, SeqCst
            //    fallback).  A fence only accepts Acquire(4)/Release(5)/
            //    AcqRel(6)/SeqCst(7); orderings weaker than Acquire (a
            //    relaxed fence is a no-op and is invalid LLVM IR) clamp up to
            //    SeqCst.  Returns void; we synthesize a void value. --
            IntrinsicKind::AtomicFence => {
                mut order: i32 = this.extract_ordering_arg(args[0]);
                if (order < 4) { order = 7; }
                llvm::LLVMBuildFence(this.builder.raw, order, 0, "");
                LValue::null()
            }

            // -- fpclass(x, test): llvm.is.fpclass.f64(x, test); true when
            //    x's IEEE-754 class is selected by the constant `test`
            //    bitmask.  Exception-free, unlike the old `(x-x)==0` trick. --
            IntrinsicKind::FpClass => { this.emit_fpclass(a0, a1) }

            // -- trap(): `call void @llvm.trap()` then `unreachable`.  llvm.trap
            //    lowers to `ud2` (SIGILL) with no libc dependency - the
            //    divergent sink for a `no_runtime` check failure.  Declared
            //    `-> never`, but the dispatcher's early return bypasses the
            //    post-call divergent-name check (see Panic), so the
            //    `unreachable` is emitted here. --
            IntrinsicKind::Trap => {
                const fn: LValue = this.get_or_decl_void_noarg("llvm.trap");
                if (fn.is_valid()) {
                    const fty: LType = LType::function_type(LType::void_type(), null, 0, false);
                    this.builder.build_call(fty, fn, null, 0, "");
                }
                this.builder.build_unreachable();
                LValue::null()
            }

            // -- debugtrap(): `call void @llvm.debugtrap()`.  A breakpoint that
            //    RETURNS, so no trailing `unreachable`. --
            IntrinsicKind::DebugTrap => {
                const fn: LValue = this.get_or_decl_void_noarg("llvm.debugtrap");
                if (fn.is_valid()) {
                    const fty: LType = LType::function_type(LType::void_type(), null, 0, false);
                    this.builder.build_call(fty, fn, null, 0, "");
                }
                LValue::null()
            }

            // -- frame_address(n) / return_address(n): `ptr @llvm.frameaddress.p0(i32)`
            //    / `ptr @llvm.returnaddress(i32)`.  `n` (a0) must be a constant
            //    (LLVM immarg); n=0 is the current frame.  For the backtrace. --
            IntrinsicKind::FrameAddress  => { this.emit_addr_intrinsic("llvm.frameaddress.p0", a0) }
            IntrinsicKind::ReturnAddress => { this.emit_addr_intrinsic("llvm.returnaddress", a0) }

            // -- Cheap IEEE-754 math: each lowers to the matching LLVM float
            //    intrinsic.  a0 is auto-deref'd via src_type above; the extra
            //    value args of copysign64/fma64 are deref'd here since the
            //    shared a1 path only handles the rotate count. --
            IntrinsicKind::Fabs64   => { this.emit_unary_llvm("llvm.fabs.f64",  LType::f64(), a0, false, "fabs") }
            IntrinsicKind::Fabs32   => { this.emit_unary_llvm("llvm.fabs.f32",  LType::f32(), a0, false, "fabs") }
            IntrinsicKind::Floor64  => { this.emit_unary_llvm("llvm.floor.f64", LType::f64(), a0, false, "floor") }
            IntrinsicKind::Ceil64   => { this.emit_unary_llvm("llvm.ceil.f64",  LType::f64(), a0, false, "ceil") }
            IntrinsicKind::FTrunc64 => { this.emit_unary_llvm("llvm.trunc.f64", LType::f64(), a0, false, "ftrunc") }
            IntrinsicKind::Round64  => { this.emit_unary_llvm("llvm.round.f64", LType::f64(), a0, false, "round") }
            IntrinsicKind::Sqrt64   => { this.emit_unary_llvm("llvm.sqrt.f64",  LType::f64(), a0, false, "sqrt") }
            IntrinsicKind::Sqrt32   => { this.emit_unary_llvm("llvm.sqrt.f32",  LType::f32(), a0, false, "sqrt") }
            IntrinsicKind::Copysign64 => {
                const sign: LValue = this.auto_deref_to(a1, LType::f64());
                this.emit_binary_llvm("llvm.copysign.f64", LType::f64(), a0, sign, "copysign")
            }
            IntrinsicKind::Fma64 => {
                const y: LValue = this.auto_deref_to(a1, LType::f64());
                const z: LValue = this.auto_deref_to(args[2], LType::f64());
                this.emit_ternary_llvm("llvm.fma.f64", LType::f64(), a0, y, z, "fma")
            }

            // -- dirent_name(entry) -> entry == null ? "" : (entry + 19).
            //    d_name is at byte offset 19 in glibc's struct dirent.
            //    The GEP returns a `char *` which is exactly Cryo's
            //    `string`. --
            IntrinsicKind::DirentName  => { this.emit_dirent_name(args[0]) }
            IntrinsicKind::DirentType  => { this.emit_dirent_type(args[0]) }

            // -- panic(msg, file, line) -> ensure @panic is declared, call
            //    it, then build_unreachable since panic diverges.  The
            //    dispatcher's early return in visit_call_expr bypasses
            //    the post-call divergent-name check, so the unreachable
            //    must be emitted here.  Returns LValue::null() (panic
            //    returns void). --
            IntrinsicKind::Panic       => { this.emit_panic_call(args[0], args[1], args[2]) }

            // -- va_arg_*(va): pluck the next variadic argument of the given
            //    width from the va_list `va` points at.  `args[0]` is the
            //    va_list pointer (the prologue's `[24 x i8]` alloca); not
            //    auto-deref'd (src_type returns null).  Pointer and
            //    string both read an opaque `ptr`.  Lowering is per-ABI; see
            //    `emit_va_arg` for why SysV must not use the `va_arg`
            //    instruction. --
            IntrinsicKind::VaArgI32    => { this.emit_va_arg(args[0], LType::i32(), false) }
            IntrinsicKind::VaArgU32    => { this.emit_va_arg(args[0], LType::i32(), false) }
            IntrinsicKind::VaArgI64    => { this.emit_va_arg(args[0], LType::i64(), false) }
            IntrinsicKind::VaArgU64    => { this.emit_va_arg(args[0], LType::i64(), false) }
            IntrinsicKind::VaArgF64    => { this.emit_va_arg(args[0], LType::f64(), true) }
            IntrinsicKind::VaArgPtr    => { this.emit_va_arg(args[0], LType::pointer_to(LType::i8()), false) }
            IntrinsicKind::VaArgString => { this.emit_va_arg(args[0], LType::pointer_to(LType::i8()), false) }

            // -- vprintf(fmt, va) / vfprintf(file, fmt, va): forward the
            //    va_list bucket through the ABI seam (by address on SysV,
            //    loaded char* by value on Win64) and call the libc routine.
            //    `args[..]` come in raw (src_type returns null,
            //    so no auto-deref): fmt/file are already pointers and the
            //    va arg is the prologue's va_list alloca. --
            IntrinsicKind::Vprintf  => { this.emit_vprintf(args[0], args[1]) }
            IntrinsicKind::Vfprintf => { this.emit_vfprintf(args[0], args[1], args[2]) }

            // -- Atomic load: (ptr, order). Width fixed by suffix; alignment
            //    matches the operand's natural alignment (REQUIRED by LLVM
            //    for atomic loads/stores). --
            IntrinsicKind::AtomicLoadU8  => { this.emit_atomic_load(LType::i8(),  1, args[0], args[1]) }
            IntrinsicKind::AtomicLoadU32 => { this.emit_atomic_load(LType::i32(), 4, args[0], args[1]) }
            IntrinsicKind::AtomicLoadU64 => { this.emit_atomic_load(LType::i64(), 8, args[0], args[1]) }

            // -- Atomic store: (ptr, value, order). --
            IntrinsicKind::AtomicStoreU8  => { this.emit_atomic_store(1, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicStoreU32 => { this.emit_atomic_store(4, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicStoreU64 => { this.emit_atomic_store(8, args[0], args[1], args[2]) }

            // -- Atomic RMW: (ptr, value, order); op_code is the
            //    LLVMAtomicRMWBinOp value (Xchg=0 / Add=1 / Sub=2 / And=3 /
            //    Or=5 / Xor=6).  No Nand exposed at the stdlib boundary. --
            IntrinsicKind::AtomicAddU8  => { this.emit_atomic_rmw(1, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicAddU32 => { this.emit_atomic_rmw(1, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicAddU64 => { this.emit_atomic_rmw(1, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicSubU8  => { this.emit_atomic_rmw(2, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicSubU32 => { this.emit_atomic_rmw(2, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicSubU64 => { this.emit_atomic_rmw(2, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicAndU8  => { this.emit_atomic_rmw(3, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicAndU32 => { this.emit_atomic_rmw(3, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicAndU64 => { this.emit_atomic_rmw(3, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicOrU8   => { this.emit_atomic_rmw(5, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicOrU32  => { this.emit_atomic_rmw(5, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicOrU64  => { this.emit_atomic_rmw(5, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicXorU8  => { this.emit_atomic_rmw(6, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicXorU32 => { this.emit_atomic_rmw(6, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicXorU64 => { this.emit_atomic_rmw(6, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicSwapU8 => { this.emit_atomic_rmw(0, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicSwapU32 => { this.emit_atomic_rmw(0, args[0], args[1], args[2]) }
            IntrinsicKind::AtomicSwapU64 => { this.emit_atomic_rmw(0, args[0], args[1], args[2]) }

            // -- Compare-and-swap: (ptr, cmp, new, succ_order, fail_order,
            //    out_ok). Emits one cmpxchg, extracts both halves, writes
            //    the ok flag through out_ok, returns the loaded value. --
            IntrinsicKind::AtomicCmpxchgU8 => {
                this.emit_atomic_cmpxchg(args[0], args[1], args[2], args[3], args[4], args[5])
            }
            IntrinsicKind::AtomicCmpxchgU32 => {
                this.emit_atomic_cmpxchg(args[0], args[1], args[2], args[3], args[4], args[5])
            }
            IntrinsicKind::AtomicCmpxchgU64 => {
                this.emit_atomic_cmpxchg(args[0], args[1], args[2], args[3], args[4], args[5])
            }
        };

        return Option::Some(out_value);
    }


    // Per-intrinsic emission paths

    /// Get-or-declare the external raising panic funnel `__cryo_panic(msg, file,
    /// line)` (defined by the `panic/unwind` runtime tier, resolved at link).
    /// Signature `(ptr, ptr, i32) -> void`, matching the abort funnel's call
    /// shape; the caller emits `unreachable` after the call since it diverges.
    get_or_decl_cryo_panic(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("__cryo_panic");
        if (fn.is_valid()) { return fn; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const param_buf: void* = intrinsics::malloc(24);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ptr_ty.raw;
        param_slots[1] = ptr_ty.raw;
        param_slots[2] = LType::i32().raw;
        const fty: LType = LType::function_type(LType::void_type(), param_buf, 3, false);
        intrinsics::free(param_buf);
        return this.llvm_module.add_function("__cryo_panic", fty);
    }

    /// Emit `call @panic(msg, file, line); unreachable`.  Ensures the
    /// `@panic` runtime function is declared in the current module first.
    emit_panic_call(mut &this, msg: LValue, file: LValue, line: LValue) -> LValue {
        // Freestanding: no libc-backed `@panic` runtime.  A check failure
        // diverges through `llvm.trap` (`ud2`/SIGILL) instead.  The message
        // is discarded - there is nothing to print to.
        if (this.no_runtime) {
            const trap_fn: LValue = this.get_or_decl_void_noarg("llvm.trap");
            if (trap_fn.is_valid()) {
                const trap_fty: LType = LType::function_type(LType::void_type(), null, 0, false);
                this.builder.build_call(trap_fty, trap_fn, null, 0, "");
            }
            this.builder.build_unreachable();
            return LValue::null();
        }
        // Every panic goes through the external `__cryo_panic`, declared here and
        // defined by whichever panic tier the link line names: `panic/abort`
        // prints and terminates, `panic/unwind` raises through libunwind so the
        // cleanup landing pads on the enclosing calls run as the unwind passes
        // through.  Which strategy a program gets is a link-time choice, not a
        // codegen one, which is why nothing here branches on it.
        const panic_fn: LValue = this.get_or_decl_cryo_panic();
        if (!panic_fn.is_valid()) { return LValue::null(); }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const param_buf: void* = intrinsics::malloc(24);
        const param_slots: void** = param_buf as void**;
        param_slots[0] = ptr_ty.raw;
        param_slots[1] = ptr_ty.raw;
        param_slots[2] = LType::i32().raw;
        const fty: LType = LType::function_type(LType::void_type(), param_buf, 3, false);
        intrinsics::free(param_buf);
        const arg_buf: void* = intrinsics::malloc(24);
        const arg_slots: void** = arg_buf as void**;
        arg_slots[0] = msg.raw;
        arg_slots[1] = file.raw;
        arg_slots[2] = line.raw;
        this.builder.build_call(fty, panic_fn, arg_buf, 3, "");
        intrinsics::free(arg_buf);
        this.builder.build_unreachable();
        return LValue::null();
    }

    emit_dirent_name(mut &this, entry: LValue) -> LValue {
        const i8_ty: LType = LType::i8();
        const ptr_ty: LType = LType::pointer_to(i8_ty);
        // GEP entry, +offset -> ptr to d_name.  `d_name` sits at byte 19 in
        // glibc's `struct dirent` but at byte 8 in mingw-w64's (which has no
        // d_off/d_type fields: long d_ino[4] + u16 d_reclen[2] + u16
        // d_namlen[2] = 8).  Reading the glibc offset on Windows yields
        // garbage names and breaks module discovery.
        const dn_off: u64 = this.abi.is_win64() ? 8 : 19;
        const off: LValue = LType::const_int(LType::i64(), dn_off, false);
        const idx_buf: void* = intrinsics::malloc(8);
        const idx_slots: void** = idx_buf as void**;
        idx_slots[0] = off.raw;
        const name_ptr: LValue = this.builder.build_gep(i8_ty, entry, idx_buf, 1, "d_name");
        intrinsics::free(idx_buf);
        // Null guard: if entry is null, return "" (a global empty string).
        const empty: LValue = this.builder.build_global_string_ptr("", "d_name.empty");
        const is_null: LValue = this.builder.build_icmp(
            LIntPredicate::EQ, entry, LType::const_pointer_null(ptr_ty), "d_name.is_null");
        return this.builder.build_select(is_null, empty, name_ptr, "d_name.sel");
    }

    emit_dirent_type(mut &this, entry: LValue) -> LValue {
        const i8_ty: LType = LType::i8();
        const i32_ty: LType = LType::i32();
        const ptr_ty: LType = LType::pointer_to(i8_ty);
        // GEP entry, +18 -> ptr to d_type (i8)
        const off: LValue = LType::const_int(LType::i64(), 18, false);
        const idx_buf: void* = intrinsics::malloc(8);
        const idx_slots: void** = idx_buf as void**;
        idx_slots[0] = off.raw;
        const type_ptr: LValue = this.builder.build_gep(i8_ty, entry, idx_buf, 1, "d_type.ptr");
        intrinsics::free(idx_buf);
        const type_byte: LValue = this.builder.build_load(i8_ty, type_ptr, "d_type.byte");
        const widened: LValue = this.builder.build_zext(type_byte, i32_ty, "d_type.i32");

        // Map POSIX DT_* values to FileType enum ordinals.  The intrinsic
        // contract (see stdlib/fs/dir.cryo and stdlib/core/intrinsics.cryo:
        // "returns i32 mapped to FileType ordinals") expects ordinals, not
        // raw d_type bytes.  Callers like module_loader.cryo's
        // `if (dtype == 1)` (directory) and `else if (dtype == 0)` (file)
        // depend on this remapping; without it, Linux's DT_DIR=4 / DT_REG=8
        // would never match and every .cryo entry would be skipped during
        // pre-scan.
        //
        //   DT_REG(8)   -> FileType::File(0)
        //   DT_DIR(4)   -> FileType::Directory(1)
        //   DT_LNK(10)  -> FileType::Symlink(2)
        //   DT_BLK(6)   -> FileType::BlockDevice(3)
        //   DT_CHR(2)   -> FileType::CharDevice(4)
        //   DT_FIFO(1)  -> FileType::Fifo(5)
        //   DT_SOCK(12) -> FileType::Socket(6)
        //   otherwise   -> FileType::Unknown(7)
        const c_dt_fifo: LValue = LType::const_int(i32_ty, 1,  false);
        const c_dt_chr:  LValue = LType::const_int(i32_ty, 2,  false);
        const c_dt_dir:  LValue = LType::const_int(i32_ty, 4,  false);
        const c_dt_blk:  LValue = LType::const_int(i32_ty, 6,  false);
        const c_dt_reg:  LValue = LType::const_int(i32_ty, 8,  false);
        const c_dt_lnk:  LValue = LType::const_int(i32_ty, 10, false);
        const c_dt_sock: LValue = LType::const_int(i32_ty, 12, false);

        const ft_file:    LValue = LType::const_int(i32_ty, 0, false);
        const ft_dir:     LValue = LType::const_int(i32_ty, 1, false);
        const ft_symlink: LValue = LType::const_int(i32_ty, 2, false);
        const ft_block:   LValue = LType::const_int(i32_ty, 3, false);
        const ft_char:    LValue = LType::const_int(i32_ty, 4, false);
        const ft_fifo:    LValue = LType::const_int(i32_ty, 5, false);
        const ft_socket:  LValue = LType::const_int(i32_ty, 6, false);
        const ft_unknown: LValue = LType::const_int(i32_ty, 7, false);

        // Chain of selects, defaulting to Unknown.
        mut mapped: LValue = ft_unknown;
        const is_sock: LValue = this.builder.build_icmp(LIntPredicate::EQ, widened, c_dt_sock, "is_sock");
        mapped = this.builder.build_select(is_sock, ft_socket,  mapped, "ft.sock");
        const is_lnk:  LValue = this.builder.build_icmp(LIntPredicate::EQ, widened, c_dt_lnk,  "is_lnk");
        mapped = this.builder.build_select(is_lnk,  ft_symlink, mapped, "ft.lnk");
        const is_reg:  LValue = this.builder.build_icmp(LIntPredicate::EQ, widened, c_dt_reg,  "is_reg");
        mapped = this.builder.build_select(is_reg,  ft_file,    mapped, "ft.reg");
        const is_blk:  LValue = this.builder.build_icmp(LIntPredicate::EQ, widened, c_dt_blk,  "is_blk");
        mapped = this.builder.build_select(is_blk,  ft_block,   mapped, "ft.blk");
        const is_dir:  LValue = this.builder.build_icmp(LIntPredicate::EQ, widened, c_dt_dir,  "is_dir");
        mapped = this.builder.build_select(is_dir,  ft_dir,     mapped, "ft.dir");
        const is_chr:  LValue = this.builder.build_icmp(LIntPredicate::EQ, widened, c_dt_chr,  "is_chr");
        mapped = this.builder.build_select(is_chr,  ft_char,    mapped, "ft.chr");
        const is_fifo: LValue = this.builder.build_icmp(LIntPredicate::EQ, widened, c_dt_fifo, "is_fifo");
        mapped = this.builder.build_select(is_fifo, ft_fifo,    mapped, "ft.fifo");

        // Null guard: return File(0) if entry is null (matches the prior
        // behaviour where the null check yielded 0).
        const zero: LValue = LType::const_int(i32_ty, 0, false);
        const is_null: LValue = this.builder.build_icmp(
            LIntPredicate::EQ, entry, LType::const_pointer_null(ptr_ty), "d_type.is_null");
        return this.builder.build_select(is_null, zero, mapped, "d_type.sel");
    }


    // Runtime helper declarations + bodies

    get_or_decl_vasprintf(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("vasprintf");
        if (fn.is_valid()) { return fn; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const buf: void* = intrinsics::malloc(24);
        const slots: void** = buf as void**;
        slots[0] = ptr_ty.raw;   // char**
        slots[1] = ptr_ty.raw;   // const char* fmt
        slots[2] = ptr_ty.raw;   // va_list (pointer-to-bucket on SysV)
        const fty: LType = LType::function_type(LType::i32(), buf, 3, false);
        intrinsics::free(buf);
        return this.llvm_module.add_function("vasprintf", fty);
    }

    /// Declare libc `void* memcpy(void* dst, const void* src, size_t n)` if
    /// absent.  Used by the `format` runtime to relocate the `vasprintf` result
    /// out of the libc buffer into arena-aware storage.
    get_or_decl_memcpy(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("memcpy");
        if (fn.is_valid()) { return fn; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const buf: void* = intrinsics::malloc(24);
        const slots: void** = buf as void**;
        slots[0] = ptr_ty.raw;   // void* dst
        slots[1] = ptr_ty.raw;   // const void* src
        slots[2] = LType::i64().raw;   // size_t n
        const fty: LType = LType::function_type(ptr_ty, buf, 3, false);
        intrinsics::free(buf);
        return this.llvm_module.add_function("memcpy", fty);
    }

    /// Declare libc `void free(void* ptr)` if absent.  Used by the `format`
    /// runtime to release the temporary `vasprintf` libc buffer after its
    /// contents have been copied into arena-aware storage.
    get_or_decl_free(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("free");
        if (fn.is_valid()) { return fn; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const buf: void* = intrinsics::malloc(8);
        const slots: void** = buf as void**;
        slots[0] = ptr_ty.raw;   // void* ptr
        const fty: LType = LType::function_type(LType::void_type(), buf, 1, false);
        intrinsics::free(buf);
        return this.llvm_module.add_function("free", fty);
    }

    /// Declare libc `int vprintf(const char* fmt, va_list)` if absent.
    /// The intrinsic-declaration pass usually emits this already (from the
    /// `intrinsic function vprintf` decl); we re-derive the identical
    /// `i32 (ptr, ptr)` type as a fallback so the lowering is self-sufficient
    /// even if the call is the first reference.  The second `ptr` is the
    /// forwarded va_list (the alloca address on SysV, a loaded `char*` on
    /// Win64 - both are pointer-shaped at the LLVM boundary).
    get_or_decl_vprintf(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("vprintf");
        if (fn.is_valid()) { return fn; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const buf: void* = intrinsics::malloc(16);
        const slots: void** = buf as void**;
        slots[0] = ptr_ty.raw;   // const char* fmt
        slots[1] = ptr_ty.raw;   // va_list
        const fty: LType = LType::function_type(LType::i32(), buf, 2, false);
        intrinsics::free(buf);
        return this.llvm_module.add_function("vprintf", fty);
    }

    /// Declare libc `int vfprintf(FILE* stream, const char* fmt, va_list)`
    /// if absent.  Mirror of `get_or_decl_vprintf` with the leading stream
    /// pointer.
    get_or_decl_vfprintf(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("vfprintf");
        if (fn.is_valid()) { return fn; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const buf: void* = intrinsics::malloc(24);
        const slots: void** = buf as void**;
        slots[0] = ptr_ty.raw;   // FILE* stream
        slots[1] = ptr_ty.raw;   // const char* fmt
        slots[2] = ptr_ty.raw;   // va_list
        const fty: LType = LType::function_type(LType::i32(), buf, 3, false);
        intrinsics::free(buf);
        return this.llvm_module.add_function("vfprintf", fty);
    }

    /// Pluck the next variadic argument of type `ty` from the va_list `va`
    /// points at.
    ///
    /// Win64 lowers through the LLVM `va_arg` INSTRUCTION: its va_list is a
    /// bare `char*` and the backend's align-and-bump expansion is correct at
    /// every -O level.  SysV-amd64 must NOT use the instruction: the X86
    /// backend's -O0 expansion reloads the va_list pointer from a stack slot
    /// that is never written (reproduced with a bare `va_arg ptr %p, i64`
    /// through `llc-20 -O0`: the in-register branch does an "8-byte Reload"
    /// from an unspilled slot and dereferences garbage).  At -O1+ the pointer
    /// happens to stay in a register, which is why the bug only bites
    /// unoptimized builds.  clang never emits the instruction for SysV for
    /// exactly this reason; mirror it with the inline register-save-area
    /// walk in `emit_va_arg_sysv`.
    emit_va_arg(mut &this, va: LValue, ty: LType, is_fp: boolean) -> LValue {
        if (this.abi.is_win64()) {
            return this.builder.build_va_arg(va, ty, "va.arg");
        }
        return this.emit_va_arg_sysv(va, ty, is_fp);
    }

    /// Inline SysV-amd64 `va_arg` expansion (the same IR clang emits).
    ///
    /// `__va_list_tag` layout (24 bytes):
    ///   +0  gp_offset: u32          next GP slot in reg_save_area (..48)
    ///   +4  fp_offset: u32          next FP slot (48..176)
    ///   +8  overflow_arg_area: ptr  stack-passed arguments
    ///   +16 reg_save_area: ptr      spilled rdi..r9 then xmm0..xmm7
    ///
    /// GP class (ints/pointers): 8-byte register slots, the next argument is
    /// in a register while gp_offset <= 40 (48 - 8).  FP class (f64):
    /// 16-byte slots starting at +48, in a register while fp_offset <= 160
    /// (176 - 16).  Either class bumps the overflow (stack) cursor by 8 - an
    /// f64 occupies a single eightbyte on the stack.
    emit_va_arg_sysv(mut &this, va: LValue, ty: LType, is_fp: boolean) -> LValue {
        const i32_ty: LType = LType::i32();
        const ptr_ty: LType = LType::pointer_to(LType::i8());

        mut off_byte: u64 = 0;    // gp_offset lives at +0
        mut limit:    u64 = 40;   // last gp_offset with a free GP slot
        mut step:     u64 = 8;    // GP register slot size
        if (is_fp) { off_byte = 4; limit = 160; step = 16; }

        const fn_val: LValue = this.builder.get_insert_block().get_parent();
        const in_reg_bb: LBasicBlock = LBasicBlock::append(fn_val, "va.in_reg");
        const in_mem_bb: LBasicBlock = LBasicBlock::append(fn_val, "va.in_mem");
        const end_bb:    LBasicBlock = LBasicBlock::append(fn_val, "va.end");

        // off = *(u32*)(va + off_byte); fits = off <= limit
        const off_p: LValue = this.gep_byte_const(va, off_byte, "va.off_p");
        const off: LValue = this.builder.build_load(i32_ty, off_p, "va.off");
        const fits: LValue = this.builder.build_icmp(
            LIntPredicate::ULE, off,
            LType::const_int(i32_ty, limit, false), "va.fits");
        this.builder.build_cond_br(fits, in_reg_bb, in_mem_bb);

        // in_reg: addr = reg_save_area + off; *off_p = off + step
        this.builder.position_at_end(in_reg_bb);
        const rsa_p: LValue = this.gep_byte_const(va, 16, "va.rsa_p");
        const rsa: LValue = this.builder.build_load(ptr_ty, rsa_p, "va.rsa");
        const reg_addr: LValue = this.gep_byte_value(rsa, off, "va.reg_addr");
        const bumped: LValue = this.builder.build_add(
            off, LType::const_int(i32_ty, step, false), "va.off.next");
        this.builder.build_store(bumped, off_p);
        this.builder.build_br(end_bb);

        // in_mem: addr = overflow_arg_area; overflow_arg_area += 8
        this.builder.position_at_end(in_mem_bb);
        const ovf_p: LValue = this.gep_byte_const(va, 8, "va.ovf_p");
        const mem_addr: LValue = this.builder.build_load(ptr_ty, ovf_p, "va.ovf");
        const ovf_next: LValue = this.gep_byte_const(mem_addr, 8, "va.ovf.next");
        this.builder.build_store(ovf_next, ovf_p);
        this.builder.build_br(end_bb);

        // end: load the argument through phi(addr)
        this.builder.position_at_end(end_bb);
        const addr: LValue = this.builder.build_phi(ptr_ty, "va.addr");
        const vals_buf: void* = intrinsics::malloc(16);
        const vals: void** = vals_buf as void**;
        const blks_buf: void* = intrinsics::malloc(16);
        const blks: void** = blks_buf as void**;
        vals[0] = reg_addr.raw;
        blks[0] = in_reg_bb.raw;
        vals[1] = mem_addr.raw;
        blks[1] = in_mem_bb.raw;
        addr.add_incoming(vals_buf, blks_buf, 2);
        intrinsics::free(vals_buf);
        intrinsics::free(blks_buf);
        return this.builder.build_load(ty, addr, "va.arg");
    }

    /// `base + byte_off` as an `i8` GEP with a constant offset.
    gep_byte_const(mut &this, base: LValue, byte_off: u64, name: string) -> LValue {
        return this.gep_byte_value(
            base, LType::const_int(LType::i64(), byte_off, false), name);
    }

    /// `base + off` as an `i8` GEP where `off` is an integer LValue.
    gep_byte_value(mut &this, base: LValue, off: LValue, name: string) -> LValue {
        const idx_buf: void* = intrinsics::malloc(8);
        const idx: void** = idx_buf as void**;
        idx[0] = off.raw;
        const out: LValue = this.builder.build_gep(LType::i8(), base, idx_buf, 1, name);
        intrinsics::free(idx_buf);
        return out;
    }

    /// Emit `call i32 @vprintf(fmt, forward_va_list(va))`.  The va_list
    /// `va_alloca` is the enclosing variadic function's prologue alloca;
    /// `forward_va_list` selects the per-ABI forwarding form so Win64 loads
    /// the `char*` before the call instead of passing the alloca pointer
    /// (which the callee would see as `char**`, the root cause of garbage
    /// formatted output on Windows).
    emit_vprintf(mut &this, fmt: LValue, va_alloca: LValue) -> LValue {
        const fn_val: LValue = this.get_or_decl_vprintf();
        const fn_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(fn_val.raw) };
        const va_fwd: LValue = this.abi.forward_va_list(this.builder, va_alloca);
        const buf: void* = intrinsics::malloc(16);
        const slots: void** = buf as void**;
        slots[0] = fmt.raw;
        slots[1] = va_fwd.raw;
        const r: LValue = this.builder.build_call(fn_ty, fn_val, buf, 2, "vprintf");
        intrinsics::free(buf);
        return r;
    }

    /// Emit `call i32 @vfprintf(file, fmt, forward_va_list(va))`.  Mirror of
    /// `emit_vprintf` with the leading stream argument.
    emit_vfprintf(mut &this, file: LValue, fmt: LValue, va_alloca: LValue) -> LValue {
        const fn_val: LValue = this.get_or_decl_vfprintf();
        const fn_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(fn_val.raw) };
        const va_fwd: LValue = this.abi.forward_va_list(this.builder, va_alloca);
        const buf: void* = intrinsics::malloc(24);
        const slots: void** = buf as void**;
        slots[0] = file.raw;
        slots[1] = fmt.raw;
        slots[2] = va_fwd.raw;
        const r: LValue = this.builder.build_call(fn_ty, fn_val, buf, 3, "vfprintf");
        intrinsics::free(buf);
        return r;
    }

    get_or_decl_va_start(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("llvm.va_start.p0");
        if (fn.is_valid()) { return fn; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const buf: void* = intrinsics::malloc(8);
        const slots: void** = buf as void**;
        slots[0] = ptr_ty.raw;
        const fty: LType = LType::function_type(LType::void_type(), buf, 1, false);
        intrinsics::free(buf);
        return this.llvm_module.add_function("llvm.va_start.p0", fty);
    }

    get_or_decl_va_end(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("llvm.va_end.p0");
        if (fn.is_valid()) { return fn; }
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        const buf: void* = intrinsics::malloc(8);
        const slots: void** = buf as void**;
        slots[0] = ptr_ty.raw;
        const fty: LType = LType::function_type(LType::void_type(), buf, 1, false);
        intrinsics::free(buf);
        return this.llvm_module.add_function("llvm.va_end.p0", fty);
    }

    // -- Freestanding check handlers (`runtime/abi/lang_items.def`) -----------
    //
    // Under `no_runtime` a failed check has no libc to fall back on: a `call
    // @abort` cannot be resolved by a `-nostdlib` link at all, which is what
    // made every panic tier of `runtime/` fail its own acceptance check while
    // still compiling. These route the five check sites to the runtime's own
    // handlers instead, which format the operands and diverge through
    // `__cryo_panic` (exit 101 for the abort tier, an unwind for the unwind
    // tier — chosen by which archive is on the link line, no caller change).

    /// A private constant `SourceLoc` — `{ i8* file, i32 line, i32 col }`, the
    /// `layout.def` POD — for one check site, returning its ADDRESS.
    ///
    /// Passed by pointer rather than by value so neither side has to classify a
    /// 16-byte POD by hand under two different C ABIs. Still zero-alloc: the
    /// initializer is entirely compile-time data, so this is a `.rodata` entry,
    /// not a runtime construction.
    emit_source_loc_ptr(mut &this, span: SourceSpan) -> LValue {
        mut filename: string = span.file;
        if (filename == null || filename.length() == 0) { filename = "<unknown>"; }
        const file: LValue = this.builder.build_global_string_ptr(filename, "srcloc.file");
        const line: LValue = LType::const_int(LType::i32(), span.start_line as u64, false);
        const col:  LValue = LType::const_int(LType::i32(), span.start_col as u64, false);

        const buf: void* = intrinsics::malloc(24);
        const slots: void** = buf as void**;
        slots[0] = file.raw;
        slots[1] = line.raw;
        slots[2] = col.raw;
        const init: LValue = LType::const_struct(buf, 3, false);
        intrinsics::free(buf);

        mut g: LValue = this.llvm_module.add_global(init.type_of(), "srcloc");
        g.set_initializer(init);
        g.set_global_constant(true);
        g.set_linkage(LLinkage::Private);
        return g;
    }

    /// Get-or-declare one of the runtime's check handlers. Every one takes the
    /// `SourceLoc*` first and returns void (declared `-> never` on the runtime
    /// side; the caller emits the `unreachable`).
    get_or_decl_check_handler(mut &this, name: string, extra: i64) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function(name);
        if (fn.is_valid()) { return fn; }
        const count: i64 = 1 + extra;
        const param_buf: void* = intrinsics::malloc((count * 8) as u64);
        const slots: void** = param_buf as void**;
        slots[0] = LType::pointer_to(LType::i8()).raw;
        // `op` is the only u32 operand and it is always the FIRST extra; the
        // rest are u64. Matches the `lang_items.def` signatures exactly.
        for (mut i: i64 = 1; i < count; i++) {
            if (name == "__cryo_panic_overflow" && i == 1) {
                slots[i] = LType::i32().raw;
            } else {
                slots[i] = LType::i64().raw;
            }
        }
        const fty: LType = LType::function_type(LType::void_type(), param_buf,
                                                count as u32, false);
        intrinsics::free(param_buf);
        return this.llvm_module.add_function(name, fty);
    }

    /// `call @<handler>(&srcloc, <operands...>); unreachable`.
    ///
    /// Returns false when there is no handler for this shape, so the caller can
    /// keep its previous behaviour rather than emit a call to nothing.
    emit_check_handler_call(mut &this, name: string, span: SourceSpan,
                            operands: &LValue[]) -> boolean {
        const fn: LValue = this.get_or_decl_check_handler(name, operands.length);
        if (!fn.is_valid()) { return false; }
        const loc: LValue = this.emit_source_loc_ptr(span);

        const count: i64 = 1 + operands.length;
        const arg_buf: void* = intrinsics::malloc((count * 8) as u64);
        const slots: void** = arg_buf as void**;
        slots[0] = loc.raw;
        for (mut i: i64 = 0; i < operands.length; i++) {
            slots[i + 1] = operands[i].raw;
        }
        const fty: LType = LType { raw: llvm::LLVMGlobalGetValueType(fn.raw) };
        this.builder.build_call(fty, fn, arg_buf, count as u32, "");
        intrinsics::free(arg_buf);
        this.builder.build_unreachable();
        return true;
    }

    /// The freestanding sink for a check site: route to the runtime handler when
    /// `no_runtime`, else the libc `abort` the hosted abort strategy has always
    /// used. `operands` are the handler's extra arguments, already widened to
    /// the declared types.
    emit_check_sink(mut &this, name: string, span: SourceSpan,
                    operands: &LValue[]) -> void {
        if (this.no_runtime) {
            if (this.emit_check_handler_call(name, span, operands)) { return; }
        }
        const abort_fn: LValue = this.get_or_decl_abort();
        const abort_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(abort_fn.raw) };
        this.builder.build_call(abort_ty, abort_fn, null, 0, "");
        this.builder.build_unreachable();
    }

    /// Declare libc `abort` extern: `void abort(void) __attribute__((noreturn))`.
    get_or_decl_abort(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("abort");
        if (fn.is_valid()) { return fn; }
        const fty: LType = LType::function_type(LType::void_type(), null, 0, false);
        return this.llvm_module.add_function("abort", fty);
    }

    /// Declare the allocator lang item `__cryo_alloc(u64 size, u64 align) ->
    /// void*` (see `runtime/abi/lang_items.def`).  Idempotent.
    ///
    /// The alloc tier defines this `![weak]`, so a program that wants its own
    /// allocator supplies a strong definition and the linker prefers it — which
    /// is the whole point of routing allocation through a named symbol instead
    /// of open-coding a `malloc` call.
    get_or_decl_cryo_alloc(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("__cryo_alloc");
        if (fn.is_valid()) { return fn; }
        const param_buf: void* = intrinsics::malloc(16);
        const slots: void** = param_buf as void**;
        slots[0] = LType::i64().raw;
        slots[1] = LType::i64().raw;
        const fty: LType = LType::function_type(
            LType::pointer_to(LType::i8()), param_buf, 2, false);
        intrinsics::free(param_buf);
        return this.llvm_module.add_function("__cryo_alloc", fty);
    }

    /// Declare the deallocator lang item
    /// `__cryo_dealloc(void* ptr, u64 size, u64 align)`.  Idempotent.
    get_or_decl_cryo_dealloc(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("__cryo_dealloc");
        if (fn.is_valid()) { return fn; }
        const param_buf: void* = intrinsics::malloc(24);
        const slots: void** = param_buf as void**;
        slots[0] = LType::pointer_to(LType::i8()).raw;
        slots[1] = LType::i64().raw;
        slots[2] = LType::i64().raw;
        const fty: LType = LType::function_type(LType::void_type(), param_buf,
                                                3, false);
        intrinsics::free(param_buf);
        return this.llvm_module.add_function("__cryo_dealloc", fty);
    }

    /// Emit the `@format` runtime function into the current module if it
    /// hasn't been emitted yet.  Idempotent.  Called once per module
    /// before user IR-gen; the linkonce_odr linkage means the linker
    /// collapses all 100+ copies down to one.
    emit_format_runtime(mut &this, alloc_fn: LValue) -> void {
        // If `format` already has a basic block, it's already defined here.
        mut fmt_fn: LValue = this.llvm_module.get_named_function("format");
        if (fmt_fn.is_valid()) {
            const first_bb: void* = llvm::LLVMGetFirstBasicBlock(fmt_fn.raw);
            if (first_bb != null) { return; }
        }

        // Declare format as `(ptr, ...) -> ptr` if it doesn't exist yet.
        const ptr_ty: LType = LType::pointer_to(LType::i8());
        if (!fmt_fn.is_valid()) {
            const param_buf: void* = intrinsics::malloc(8);
            const param_slots: void** = param_buf as void**;
            param_slots[0] = ptr_ty.raw;
            const fty: LType = LType::function_type(ptr_ty, param_buf, 1, true);
            intrinsics::free(param_buf);
            fmt_fn = this.llvm_module.add_function("format", fty);
        }
        if (!fmt_fn.is_valid()) { return; }

        // linkonce_odr: all copies emitted across modules merge to one.
        fmt_fn.set_linkage(LLinkage::LinkOnceODR);
        this.attach_runtime_comdat(fmt_fn, "format");

        // Save & restore the builder's insertion position so we don't
        // disturb whatever else is being generated for this module.
        const saved_bb: LBasicBlock = this.builder.get_insert_block();

        const entry_bb: LBasicBlock = LBasicBlock::append(fmt_fn, "entry");
        this.builder.position_at_end(entry_bb);

        // Allocate va_list (shape selected by the active ABI -
        // `[24 x i8]` for SysV-amd64, `i8*` for Win64) and the string
        // out-pointer.
        const va_list_ty: LType = this.abi.va_list_alloca_type();
        const va_alloca: LValue = this.builder.build_alloca(va_list_ty, "va");
        const strp_alloca: LValue = this.builder.build_alloca(ptr_ty, "strp");
        this.builder.build_store(LType::const_pointer_null(ptr_ty), strp_alloca);

        // va_start(&va) - direct LLVM call; the runtime helpers are
        // fixed-signature so we don't need codegen_call.  va_start /
        // va_end always take the alloca address, regardless of ABI.
        const va_start_fn: LValue = this.get_or_decl_va_start();
        const va_start_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(va_start_fn.raw) };
        const vs_buf: void* = intrinsics::malloc(8);
        const vs_slots: void** = vs_buf as void**;
        vs_slots[0] = va_alloca.raw;
        this.builder.build_call(va_start_ty, va_start_fn, vs_buf, 1, "");
        intrinsics::free(vs_buf);

        // n = vasprintf(strp, fmt, va)
        //   - SysV passes the va_list (= __va_list_tag[1]) by address
        //     => third arg is the alloca pointer.
        //   - Win64 passes the va_list (= char*) by value => third arg
        //     is the loaded i8* out of the alloca.
        // The forwarding form lives on AbiClassifier so the seam
        // dispatches without re-classifying the triple here.
        const va_fwd: LValue = this.abi.forward_va_list(this.builder, va_alloca);
        const vasprintf_fn: LValue = this.get_or_decl_vasprintf();
        const vasprintf_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(vasprintf_fn.raw) };
        const fmt_param: LValue = LValue { raw: llvm::LLVMGetParam(fmt_fn.raw, 0) };
        const va_buf: void* = intrinsics::malloc(24);
        const va_slots: void** = va_buf as void**;
        va_slots[0] = strp_alloca.raw;
        va_slots[1] = fmt_param.raw;
        va_slots[2] = va_fwd.raw;
        const n_result: LValue = this.builder.build_call(vasprintf_ty, vasprintf_fn, va_buf, 3, "n");
        intrinsics::free(va_buf);

        // va_end(&va)
        const va_end_fn: LValue = this.get_or_decl_va_end();
        const va_end_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(va_end_fn.raw) };
        const ve_buf: void* = intrinsics::malloc(8);
        const ve_slots: void** = ve_buf as void**;
        ve_slots[0] = va_alloca.raw;
        this.builder.build_call(va_end_ty, va_end_fn, ve_buf, 1, "");
        intrinsics::free(ve_buf);

        // -- Relocate the vasprintf result into arena-aware storage ----------
        // `vasprintf` malloc'd `*strp` through libc, which the per-target arena
        // never sees.  When `alloc_fn` (`alloc`) resolved, copy the
        // formatted string into a `GlobalAlloc` buffer (arena while the compiler
        // has it active, plain libc in every other program) and free the libc
        // temp, so a long-running host that recompiles per keystroke (the LSP)
        // reclaims every leaked `format()` result at the next arena reset instead
        // of leaking it to libc forever.  Behaviour-preserving for normal
        // programs: `alloc` with the arena inactive IS libc `malloc`,
        // and callers that `free()` the result still hit the GlobalAlloc-aware
        // free.  Branchless and safe on the failure/OOM paths - the copy size
        // folds to 0 and the freed pointer is nulled when `n < 0` (where `*strp`
        // is POSIX-undefined), and when the arena allocation itself returns null.
        if (alloc_fn.is_valid()) {
            const zero32b: LValue = LType::const_int(LType::i32(), 0, false);
            const one32:   LValue = LType::const_int(LType::i32(), 1, false);
            const neg2: LValue = this.builder.build_icmp(
                LIntPredicate::SLT, n_result, zero32b, "fneg");
            const n1: LValue = this.builder.build_add(n_result, one32, "n1");
            const size_pre: LValue = this.builder.build_select(neg2, zero32b, n1, "szpre");
            const size64: LValue = this.builder.build_zext(size_pre, LType::i64(), "sz64");
            const old_buf2: LValue = this.builder.build_load(ptr_ty, strp_alloca, "obuf");
            const null_p: LValue = LType::const_pointer_null(ptr_ty);
            const safe_old: LValue = this.builder.build_select(neg2, null_p, old_buf2, "sold");

            const alloc_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(alloc_fn.raw) };
            const one64: LValue = LType::const_int(LType::i64(), 1, false);
            const ga_buf: void* = intrinsics::malloc(16);
            const ga_slots: void** = ga_buf as void**;
            ga_slots[0] = size64.raw;
            ga_slots[1] = one64.raw;
            const new_buf: LValue = this.builder.build_call(alloc_ty, alloc_fn, ga_buf, 2, "fbuf");
            intrinsics::free(ga_buf);

            // cpy_size = new_buf ? size64 : 0 - never memcpy into a null OOM dst.
            const new_null: LValue = this.builder.build_icmp(
                LIntPredicate::EQ, new_buf, null_p, "fnull");
            const zero64: LValue = LType::const_int(LType::i64(), 0, false);
            const cpy_size: LValue = this.builder.build_select(new_null, zero64, size64, "csz");

            const memcpy_fn: LValue = this.get_or_decl_memcpy();
            const memcpy_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(memcpy_fn.raw) };
            const mc_buf: void* = intrinsics::malloc(24);
            const mc_slots: void** = mc_buf as void**;
            mc_slots[0] = new_buf.raw;
            mc_slots[1] = safe_old.raw;
            mc_slots[2] = cpy_size.raw;
            this.builder.build_call(memcpy_ty, memcpy_fn, mc_buf, 3, "");
            intrinsics::free(mc_buf);

            // free(safe_old) - release the libc vasprintf temp (null when n<0).
            const free_fn: LValue = this.get_or_decl_free();
            const free_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(free_fn.raw) };
            const fr_buf: void* = intrinsics::malloc(8);
            const fr_slots: void** = fr_buf as void**;
            fr_slots[0] = safe_old.raw;
            this.builder.build_call(free_ty, free_fn, fr_buf, 1, "");
            intrinsics::free(fr_buf);

            // Publish the relocated buffer; the tail loads strp and returns it
            // (selecting null when n<0).
            this.builder.build_store(new_buf, strp_alloca);
        }

        // %neg = (n < 0); %buf = load strp; %ret = select neg, null, buf
        const zero32: LValue = LType::const_int(LType::i32(), 0, false);
        const is_neg: LValue = this.builder.build_icmp(LIntPredicate::SLT, n_result, zero32, "neg");
        const buf_loaded: LValue = this.builder.build_load(ptr_ty, strp_alloca, "buf");
        const null_ret: LValue = LType::const_pointer_null(ptr_ty);
        const ret_val: LValue = this.builder.build_select(is_neg, null_ret, buf_loaded, "ret");
        this.builder.build_ret(ret_val);

        // Restore builder.
        if (saved_bb.is_valid()) {
            this.builder.position_at_end(saved_bb);
        }
    }
}
