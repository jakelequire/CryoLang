/// Declaration Emitter
///
/// Phase-1 (forward-declare types) and Phase-2 (declare functions,
/// methods, externs, globals, vtables) of the codegen pipeline; called
/// by the Codegen pass before body emission begins.  Also owns the
/// function-prologue / function-epilogue / method-prologue lowering
/// that materializes parameter allocas, binds `this` / args slots, and
/// emits the leading va_start / trailing va_end for variadic bodies.
///
/// Holds back-pointers to every codegen subsystem: LLVM handles, the
/// type mapper, value/function/global registries, the IR-flow emitter,
/// name resolver, expression-ops, intrinsic emitter, diag sink, and
/// `CompilationContext`.  Does NOT import the parent Context module to
/// avoid a module-graph cycle.

namespace Compiler::Codegen::Ops::DeclarationEmitter;

import Compiler::Codegen;
import Compiler::Codegen::{ LLVMTypes, TypeMap, Abi, Util };
import Compiler::Codegen::State::{ ValueTable, FunctionRegistry, GlobalRegistry, StringCache, DiagSink };
import Compiler::Codegen::Ops::{ IRFlowEmitter, SymbolResolver, IntrinsicEmitter, ExprOps };
import Compiler::CompilationContext;
import Compiler::DeclIndex;
import Compiler::Diag;
import Compiler::Diag::{ Diagnostic, SourceSpan };
import Compiler::Types;
import Compiler::Types::{ TypeRef, Type, Arena, Compound, UserDefined, Generic, Ownership };
import Compiler::AST;
import Compiler::AST::{ Node, Declaration };
import Compiler::Resolver::{ SymbolStr, InternTable, MangledName, QualifiedName };
import std::collections::pair;
import std::fmt::float;
import Compiler::AST::Expression;
import Compiler::Types::GenericRegistry;


type struct DeclarationEmitter {
    llvm_module: LModule*;
    builder:     LBuilder*;
    type_mapper: TypeMapper*;
    abi:         AbiClassifier*;
    values:      ValueTable*;
    functions:   FunctionRegistry*;
    globals:     GlobalRegistry*;
    str_cache:   StringCache*;
    flow:        IRFlowEmitter*;
    resolver:    SymbolResolver*;
    expr_ops:    ExprOps*;
    intrinsics:  IntrinsicEmitter*;
    diag:        DiagSink*;
    ctx:         CompilationContext*;

    static null() -> DeclarationEmitter {
        return DeclarationEmitter {
            llvm_module: null,
            builder:     null,
            type_mapper: null,
            abi:         null,
            values:      null,
            functions:   null,
            globals:     null,
            str_cache:   null,
            flow:        null,
            resolver:    null,
            expr_ops:    null,
            intrinsics:  null,
            diag:        null,
            ctx:         null,
        };
    }

    wire(mut &this,
         llvm_module: LModule*, builder: LBuilder*,
         type_mapper: TypeMapper*, abi: AbiClassifier*,
         values: ValueTable*,
         functions: FunctionRegistry*, globals: GlobalRegistry*,
         str_cache: StringCache*,
         flow: IRFlowEmitter*, resolver: SymbolResolver*,
         expr_ops: ExprOps*, intrinsics: IntrinsicEmitter*,
         diag: DiagSink*, ctx: CompilationContext*) -> void {
        this.llvm_module = llvm_module;
        this.builder     = builder;
        this.type_mapper = type_mapper;
        this.abi         = abi;
        this.values      = values;
        this.functions   = functions;
        this.globals     = globals;
        this.str_cache   = str_cache;
        this.flow        = flow;
        this.resolver    = resolver;
        this.expr_ops    = expr_ops;
        this.intrinsics  = intrinsics;
        this.diag        = diag;
        this.ctx         = ctx;
    }


    // Small ctx-routed accessors (inlined so DeclarationEmitter doesn't
    // have to import the parent Context module).

    get_intern(&this) -> InternTable* {
        const c: CompilationContext* = this.ctx;
        return c.intern_table;
    }

    get_arena(&this) -> TypeArena* {
        const c: CompilationContext* = this.ctx;
        return c.type_arena;
    }

    get_decl_index(&this) -> DeclarationIndex* {
        const c: CompilationContext* = this.ctx;
        return c.decl_index;
    }

    qualify(&this, sym: SymbolStr) -> SymbolStr {
        const c: CompilationContext* = this.ctx;
        return c.qualify_symbol_sym(sym);
    }

    /// Qualified name for a function declaration, honoring a canonical
    /// (template-derived) namespace stamped on injected generic specs.
    ///
    /// Free-function / static-method-generic specializations have no arena
    /// type to carry a location-independent name (unlike type specs, whose
    /// methods key off the type's arena qualified name).  Phase 6a stamps the
    /// spec's TEMPLATE namespace onto the cloned FunctionDeclNode's
    /// `source_module` field; reading it back here makes the emitted definition
    /// symbol a function of the template module rather than of whichever module
    /// emits the body, so callers (who derive the same canonical name via the
    /// DeclarationIndex) link to it regardless of placement.  Non-spec
    /// functions have an empty `source_module` and fall back to the ambient
    /// module namespace.  Must stay in lockstep with the DI registration in
    /// `TypeResolutionPasses::register_decl_in_index` (FunctionDeclaration).
    fn_qualified_name(&this, node: FunctionDeclNode*) -> SymbolStr {
        if (node.source_module != "") {
            const i: InternTable* = this.get_intern();
            return i.intern(node.source_module + "::" + i.resolve(node.name));
        }
        const c: CompilationContext* = this.ctx;
        return c.qualify_symbol_sym(node.name);
    }

    resolve(&this, sym: SymbolStr) -> string {
        const i: InternTable* = this.get_intern();
        return i.resolve(sym);
    }

    intern_str(&this, text: string) -> SymbolStr {
        const i: InternTable* = this.get_intern();
        return i.intern(text);
    }

    lookup_type_by_id(&this, id: u64) -> Type* {
        const a: TypeArena* = this.get_arena();
        return a.lookup(id);
    }

    int_type_is_signed(&this, ty: TypeRef) -> boolean {
        const t: Type* = this.lookup_type_by_id(ty.id);
        if (t == null) { return false; }
        if (t.kind != TypeKind::Int) { return false; }
        const it: IntType* = t as IntType*;
        return it.int_kind.is_signed();
    }


    // Declaration emission.  Phase-1 (forward-declare types) and Phase-2
    // (declare functions, methods, externs, globals, vtables) of the codegen
    // pipeline; called by the Codegen pass before body emission begins.

    /// Walk the program and forward-declare all struct/class/enum types as
    /// named LLVM struct types.  This must run before function declarations
    /// so that parameter and return types can reference these types.
    declare_types(mut &this, program: ProgramNode*) -> void {
        const stmts: &ASTNode*[] = &program.statements;
        for (mut i: i64 = 0; i < stmts.length; i++) {
            const stmt: ASTNode* = stmts[i];
            if (stmt == null) { continue; }

            match (stmt.kind) {
                NodeKind::StructDeclaration => {
                    this.declare_struct_type(stmt as StructDeclNode*);
                }
                NodeKind::UnionDeclaration => {
                    this.declare_union_type(stmt as UnionDeclNode*);
                }
                NodeKind::ClassDeclaration => {
                    this.declare_class_type(stmt as ClassDeclNode*);
                }
                NodeKind::EnumDeclaration => {
                    this.declare_enum_type(stmt as EnumDeclNode*);
                }
                // Impl blocks may contain methods we need, but types are
                // already declared via StructDecl/ClassDecl.
                _ => {}
            }
        }
    }

    /// Declare the `@llvm.va_start.p0` intrinsic in the current LLVM module.
    /// Signature: `void (ptr)`: the argument is a pointer to the va_list
    /// storage to initialize from the caller's argument area.

    /// Forward-declare a struct as a named LLVM type and fill its body.
    declare_struct_type(mut &this, node: StructDeclNode*) -> void {
        // Skip generic templates; only monomorphized versions get IR.
        if (node.generic_params.length > 0) {
            return;
        }

        // Look up the Cryo StructType to get field info.
        const type_ref: TypeRef = this.ctx.decl_index.lookup_type(node.name);
        if (type_ref.is_invalid()) {
            return;
        }

        // Let the type mapper handle forward declaration + body fill.
        this.type_mapper.map_type(type_ref);
    }

    /// Forward-declare a union type.  A union's arena type is a StructType
    /// (with is_union set), so this mirrors declare_struct_type exactly: the
    /// type mapper emits the union's storage-blob LLVM body.
    declare_union_type(mut &this, node: UnionDeclNode*) -> void {
        if (node.generic_params.length > 0) {
            return;
        }
        const type_ref: TypeRef = this.ctx.decl_index.lookup_type(node.name);
        if (type_ref.is_invalid()) {
            return;
        }
        this.type_mapper.map_type(type_ref);
    }

    /// Forward-declare a class type.
    declare_class_type(mut &this, node: ClassDeclNode*) -> void {
        if (node.generic_params.length > 0) {
            return;
        }

        const type_ref: TypeRef = this.ctx.decl_index.lookup_type(node.name);
        if (type_ref.is_invalid()) {
            return;
        }

        this.type_mapper.map_type(type_ref);
    }

    /// Declare an enum type.
    declare_enum_type(mut &this, node: EnumDeclNode*) -> void {
        if (node.generic_params.length > 0) {
            return;
        }

        const type_ref: TypeRef = this.ctx.decl_index.lookup_type(node.name);
        if (type_ref.is_invalid()) {
            return;
        }

        this.type_mapper.map_type(type_ref);
    }

    /// Walk the program and create LLVM function declarations for all
    /// functions, methods, and extern blocks.  Also emits module-level global
    /// variable declarations so any function body that references a global
    /// (regardless of source order, e.g. `clock_gettime(CLOCK_REALTIME, ...)`
    /// where the const is declared later in the file) can resolve it.
    declare_functions(mut &this, program: ProgramNode*) -> void {
        const stmts: &ASTNode*[] = &program.statements;
        for (mut i: i64 = 0; i < stmts.length; i++) {
            const stmt: ASTNode* = stmts[i];
            if (stmt == null) { continue; }

            match (stmt.kind) {
                NodeKind::FunctionDeclaration => {
                    this.declare_function(stmt as FunctionDeclNode*);
                }
                NodeKind::IntrinsicDeclaration => {
                    this.declare_intrinsic(stmt as IntrinsicDeclNode*);
                }
                NodeKind::ExternBlock => {
                    this.declare_extern_block(stmt as ExternBlockNode*);
                }
                NodeKind::ImplementationBlock => {
                    this.declare_impl_block(stmt as ImplBlockNode*);
                }
                NodeKind::StructDeclaration => {
                    this.declare_struct_methods(stmt as StructDeclNode*);
                }
                NodeKind::UnionDeclaration => {
                    this.declare_union_methods(stmt as UnionDeclNode*);
                }
                NodeKind::ClassDeclaration => {
                    this.declare_class_methods(stmt as ClassDeclNode*);
                }
                NodeKind::VariableDeclaration => {
                    const var_decl: VarDeclNode* = stmt as VarDeclNode*;
                    if (var_decl.is_global) {
                        this.codegen_global_var(var_decl);
                    }
                }
                _ => {}
            }
        }
    }

    /// Declare a single function signature (no body generation).
    /// A monomorphization gets `weak_odr` linkage.  It is a pure function of
    /// (template, type-args): every module that instantiates the same generic
    /// with the same arguments clones the same source into the same symbol, so
    /// duplicate definitions are equivalent by construction and the linker may
    /// keep any one.  This is what lets a spec be emitted at its USE SITE - 
    /// where two modules instantiating the same generic each emit it - without a
    /// multiple-definition error.
    ///
    /// NOT `linkonce_odr`, which additionally permits LLVM to DISCARD a
    /// definition that its own module never references.  A spec is placed with
    /// the module owning its type argument, which frequently does not call it - 
    /// `Drop for Array<Str, GlobalAlloc>` lands in `collections::str`, and only
    /// the compiler's `CLI` module ever invokes it.  Under `linkonce_odr` that
    /// body vanished from `str.o`, which the host build hid (the stdlib ARCHIVE
    /// carried another copy) and the Windows cross-build exposed at link time:
    /// cross targets link per-target objects with no archive.  `weak_odr` keeps
    /// the definition.
    ///
    /// The definition also gets an `any`-selection COMDAT keyed on its symbol.
    /// On ELF that just folds the section group; on COFF it is mandatory.
    /// Without it LLVM lowers a weak definition as a strong `.weak.<sym>` plus a
    /// weak-external alias, and `x86_64-w64-mingw32-ld` leaves the alias
    /// unresolved - the Windows cross-link failed with "undefined reference" to
    /// symbols that `nm` showed defined in the very object doing the
    /// referencing.  A COMDAT is how C++ emits inline functions, and it is what
    /// `IntrinsicEmitter::attach_runtime_comdat` already does for the runtime
    /// helpers.
    ///
    /// `main` is exempt: it is the C entry point, must be strong, and is never a
    /// specialization anyway (the guard only documents the invariant).
    apply_spec_linkage(mut &this, fn_val: LValue, node: FunctionDeclNode*,
                       fn_name: string, is_program_main: boolean) -> void {
        if (node == null || is_program_main) { return; }
        if (!node.is_specialization || !fn_val.is_valid()) { return; }
        fn_val.set_linkage(LLinkage::WeakODR);
        const comdat: void* = llvm::LLVMGetOrInsertComdat(
            this.llvm_module.raw, fn_name);
        if (comdat != null) { llvm::LLVMSetComdat(fn_val.raw, comdat); }
    }

    /// Apply the `![weak]` / `![naked]` / `![section("...")]` directive effects
    /// to a just-declared function/method DEFINITION.  Shared by
    /// declare_function and declare_method so all definition paths stay
    /// consistent.  `fn_name` is the emitted LLVM symbol (used to key the weak
    /// COMDAT).  Caller gates on the presence of a body: these only apply to
    /// definitions, never bodyless externs.
    apply_directive_effects(mut &this, fn_val: LValue, node: FunctionDeclNode*,
                            fn_name: string) -> void {
        if (node == null || !fn_val.is_valid()) { return; }
        // `![weak]`: weak definition (WeakAny) so a strong definition in
        // another object overrides it - the user-overridable runtime symbols
        // (global allocator, panic handler).  Attach an any-selection COMDAT
        // for the same COFF reason apply_spec_linkage does: without it,
        // mingw-ld leaves a bare weak definition's weak-external alias
        // unresolved on the Windows cross-link.
        if (node.is_weak) {
            fn_val.set_linkage(LLinkage::WeakAny);
            const comdat: void* = llvm::LLVMGetOrInsertComdat(
                this.llvm_module.raw, fn_name);
            if (comdat != null) { llvm::LLVMSetComdat(fn_val.raw, comdat); }
        }
        // `![naked]`: the LLVM `naked` attribute; prologue/epilogue emission is
        // separately skipped in the body pass (see codegen_function_prologue).
        if (node.is_naked) {
            this.abi.apply_naked_attribute(fn_val);
        }
        // `![section("name")]`: object-file section placement for the symbol.
        if (node.link_section.length() > 0) {
            llvm::LLVMSetSection(fn_val.raw, node.link_section);
        }
    }

    declare_function(mut &this, node: FunctionDeclNode*) -> void {
        // Skip generic templates.
        if (node.generic_params.length > 0) {
            return;
        }

        // Compute this overload's func_type_ref so we can look up the
        // overload-specific mangled name.  The bare-keyed `lookup_mangled_name`
        // is last-write-wins: for two `visit(A*)` / `visit(B*)` overloads,
        // both share the qualified name `Mod::visit` and the second one
        // overwrites the first's mangled-name entry.  The overload-keyed
        // table (registered alongside in type_resolution) disambiguates by
        // (name, func_type_ref).
        const ctx_ptr: CompilationContext* = this.ctx;
        const intern: InternTable* = ctx_ptr.intern_table;
        const qualified: SymbolStr = this.fn_qualified_name(node);
        const di: DeclarationIndex* = ctx_ptr.decl_index;
        const arena: TypeArena* = this.get_arena();

        mut params: TypeRef[] = [];
        for (mut pi: i64 = 0; pi < node.parameters.length; pi++) {
            const param: VarDeclNode* = node.parameters[pi];
            if (param != null && param.resolved_type.is_valid()) {
                params.push(param.resolved_type);
            }
        }
        const func_type_ref: TypeRef = arena.get_function(
            node.resolved_return_type, params, node.is_variadic);

        mut mangled_sym: SymbolStr = di.lookup_overload_mangled(qualified, func_type_ref);
        if (!mangled_sym.is_valid()) {
            mangled_sym = di.lookup_mangled_name(qualified);
        }
        if (!mangled_sym.is_valid()) {
            // Compute and register on first use using the mangler.
            const qname: QualifiedName = QualifiedName::from_symbol(qualified);
            const computed: MangledName = MangledName::for_free_function(
                intern, arena, qname, params,
                node.resolved_return_type, node.is_variadic);
            mangled_sym = computed.value;
            di.register_mangled_name(qualified, mangled_sym);
            di.register_overload_mangled(qualified, func_type_ref, mangled_sym);
        }
        // The C ABI entry point must be named `main` verbatim; the C
        // runtime's _start references the unmangled symbol.  Override the
        // mangled name for any free function whose source-level name is
        // `main` so the linker can find it.
        const main_sym: SymbolStr = intern.intern("main");
        mut fn_name: string = intern.resolve(mangled_sym);
        const is_program_main: boolean = node.name.equals(main_sym);
        // Under `--panic=unwind` the user's `main` runs under an internal symbol
        // and a synthesized `main` wrapper (emitted just after this declaration)
        // invokes it inside a catch-all landing pad: an otherwise-uncaught panic
        // then finds a phase-1 handler at the root, so phase 2 runs every
        // intermediate frame's cleanup pad (destructors execute) before the
        // wrapper reports and exits 101.  Gated so the default abort path emits
        // `main` exactly as before (byte-identical).  `no_runtime` has no C
        // `main` to wrap.
        const wrap_main_unwind: boolean = is_program_main
            && this.ctx.project_panic_unwind && !this.ctx.project_no_runtime;
        if (is_program_main) {
            fn_name = "main";
            // `cryo test` synthesizes its own `main` that drives every
            // discovered `![test]` function; if we also emitted the user's
            // `main` the linker would see two `main` symbols.  Skip
            // declaration (and therefore body emission) in test mode.
            if (this.ctx.mode.skip_user_main()) {
                return;
            }
            if (wrap_main_unwind) {
                fn_name = "__cryo_user_main";
            }
        }
        // `![no_mangle]` / `![symbol("...")]`: emit under the requested symbol
        // instead of the mangled name.  `declare_method` (:966) and
        // `declare_extern_block` (:1375) already honor this; `declare_function`
        // historically did not, so the directive silently no-opped on free
        // function definitions.  `main` keeps its C-runtime-mandated name above.
        if (!is_program_main && node.has_link_name) {
            fn_name = node.link_name;
        }

        // Build the LLVM function type via the ABI seam.  Phase 1 + 2:
        // the classifier promotes >16-byte aggregates to `Indirect`
        // (sret on returns, byval on params), so the produced LLVM
        // signature looks like `void f(ptr sret(%T), ptr byval(%P), ...)`.
        // Phase 1/2 attribute attachment happens just below.
        const param_count: u32 = CodegenUtil::fixed_param_count(node);

        mut fn_type:    LType         = LType::null();
        mut sret_pointee: LType       = LType::null();   // null => no sret
        // Captured plan from the seam.  Used after `add_function` to
        // walk param classifications and apply `byval(%T)` to any
        // Indirect parameter.  Empty when the main-widening branch
        // builds `fn_type` open-coded (main can't have aggregate
        // parameters in source, so byval never applies there).
        mut plan_param_plans: ParamPlan[] = [];
        // Under `no_runtime` there is no C runtime calling `main`, so we do
        // NOT widen its signature to argc/argv/envp (nor emit the
        // set_args/set_env prologue below): a freestanding entry is a
        // separate `![naked] _start`, and `main` - if present - keeps its
        // declared signature.
        if (is_program_main && param_count == 0 && !this.ctx.project_no_runtime) {
            // The C ABI entry point is
            // `int main(int argc, char** argv, char** envp)`.  The C
            // runtime always passes all three, and the stdlib reads argv
            // through `set_args` and envp through `set_env` (both called
            // from the synthesized prologue in `codegen_function_prologue`
            // below), backing `std::env::args()` / `std::env::vars()`.
            // User source still writes `function main() -> int`; we
            // silently widen the LLVM signature to take argc/argv/envp.
            // This widening is not expressible in the ABI seam (it adds
            // synthetic parameters not in the source signature), so it
            // stays open-coded here.  `envp` shares argv's `char**` type.
            const ret_ty: LType = this.map_return_type(node);
            if (!ret_ty.is_valid()) { return; }
            const argv_ty: LType = LType::pointer_to(LType::pointer_to(LType::i8()));
            const buf: void* = intrinsics::malloc(3 * 8);
            const slots: void** = buf as void**;
            slots[0] = LType::i32().raw;
            slots[1] = argv_ty.raw;
            slots[2] = argv_ty.raw;
            fn_type = LType::function_type(ret_ty, buf, 3, false);
            intrinsics::free(buf);
        } else {
            mut params: TypeRef[] = [];
            for (mut i: u32 = 0; i < param_count; i++) {
                const param: VarDeclNode* = node.parameters[i];
                if (param != null && param.resolved_type.is_valid()) {
                    params.push(param.resolved_type);
                }
            }
            const plan: SignaturePlan = this.abi.classify_signature(
                params, node.resolved_return_type, node.is_variadic);
            if (!plan.llvm_fn_type.is_valid()) { return; }
            fn_type = plan.llvm_fn_type;
            if (plan.sret_slot) {
                sret_pointee = plan.return_plan.pointee_ty;
            }
            // Deep-clone the plans (ParamPlan owns `llvm_slots`, so a bitwise
            // copy would alias the array into a second owner and double-free
            // when the local `plan` is dropped at block exit).
            plan_param_plans = [];
            for (mut pp: i64 = 0; pp < plan.param_plans.length; pp++) {
                plan_param_plans.push(plan.param_plans[pp].clone());
            }
        }

        // Add the function to the LLVM module.
        const fn_val: LValue = this.llvm_module.add_function(fn_name, fn_type);
        this.apply_spec_linkage(fn_val, node, fn_name, is_program_main);

        // `--panic=unwind`: `fn_val` is now `__cryo_user_main`; synthesize the
        // `main` wrapper that catches an uncaught panic at the root (see
        // `wrap_main_unwind`).
        if (wrap_main_unwind) {
            this.emit_main_unwind_wrapper(fn_val, fn_type);
        }

        // Phase 1: attach `sret(%T)` to LLVM parameter slot 0 when the
        // classifier promoted the return to Indirect.  Call sites detect
        // this attribute via `AbiClassifier::sret_pointee_of` and
        // marshal a hidden result-slot pointer; the function-body
        // prologue and `codegen_return` likewise consult it so the
        // LLVM-level signature stays `void f(ptr sret(%T), ...)`
        // end-to-end.
        if (sret_pointee.is_valid()) {
            this.abi.apply_sret_attribute(fn_val, sret_pointee);
        }

        // Phase 2: attach `byval(%T)` to each LLVM parameter slot whose
        // source param is a large aggregate.  The LLVM slot index of a
        // source param accounts for the hidden sret slot AND for earlier
        // params that expanded to multiple slots (DirectPair = 2), so it
        // is computed via `llvm_slot_index_of_param` rather than the raw
        // source ordinal.  Skipped when the main-widening branch ran
        // (empty plan_param_plans).
        const sret_present_fn: boolean = sret_pointee.is_valid();
        // Track the running LLVM slot index while scanning params instead of
        // calling llvm_slot_index_of_param, which takes plan_param_plans by
        // value - a move inside the loop that would conditionally consume the
        // array.  `running_slot` at param `pi` equals the sret offset plus the
        // slot count of every earlier param, exactly what the helper returns,
        // and in O(n) rather than O(n^2).
        mut running_slot: u32 = if (sret_present_fn) { 1 } else { 0 } as u32;
        for (mut pi: i64 = 0; pi < plan_param_plans.length; pi++) {
            const pp_fn: &ParamPlan = &plan_param_plans[pi];
            if (pp_fn.cls == ArgClass::Indirect
                    && pp_fn.attr == AbiAttr::ByVal
                    && pp_fn.pointee_ty.is_valid()) {
                this.abi.apply_byval_attribute(fn_val, running_slot, pp_fn.pointee_ty);
            }
            running_slot += pp_fn.llvm_slots.length as u32;
        }

        // `![inline]` / `![noinline]`: attach the LLVM `alwaysinline` /
        // `noinline` function attribute.  Only meaningful on a definition,
        // so gate on the presence of a body (bodyless extern/forward
        // declarations would carry a dead attribute).  The directive
        // validator already guarantees the two are mutually exclusive.
        if (node.body != null) {
            if (node.is_inline) {
                this.abi.apply_inline_attribute(fn_val);
            } else if (node.is_noinline) {
                this.abi.apply_noinline_attribute(fn_val);
            }
            // `-g`: keep a frame pointer so `perf record -g` can unwind
            // cheaply and accurately.
            if (this.ctx.emit_debug_info) {
                this.abi.apply_frame_pointer_attribute(fn_val);
            }
            // `![weak]` / `![naked]` / `![section]` linkage-and-placement.
            this.apply_directive_effects(fn_val, node, fn_name);
        }

        // Register under qualified name (module scope).
        this.functions.register(qualified, fn_val);
        // `![no_mangle]` / `![symbol("...")]`: call sites resolve a free
        // function through its Cryo mangled symbol
        // (`resolve_function_by_mangled` on `node.resolved_callee`).  With a
        // link-name override the LLVM definition is named `link_name`, not the
        // mangled symbol, so also register this fn_val under the mangled key -
        // mirroring `declare_method`, whose registration under the mangled key
        // is what makes `![symbol]` "invisible to callers" (see
        // symbol_resolver.cryo:249).  Without it the by-mangled lookup misses
        // and synthesizes a phantom extern under the now-nonexistent mangled
        // name, producing an undefined-reference link error.  Gated on
        // has_link_name so normal functions are byte-unchanged.
        if (node.has_link_name) {
            this.functions.register(mangled_sym, fn_val);
        }
    }

    /// Declare all methods in an impl block.
    declare_impl_block(mut &this, node: ImplBlockNode*) -> void {
        // Skip generic impl blocks.
        if (node.generic_params.length > 0) {
            return;
        }

        // Use TypeResolution's canonical-qualified target when available; it
        // resolves cross-module impl targets (e.g. `implement trait FmtWrite
        // for struct Stdout` in fmt::write where Stdout lives in io::stdio)
        // by walking the bare->qualified table, so the impl's methods land
        // under the same key the type's defining module uses.  Without the
        // canonical resolution, we'd qualify with the CURRENT module and
        // produce `fmt::write::Stdout::write_str`, which `declare_method`
        // can't look up; bodies would be silently dropped and the linker
        // would surface them as undefined references.
        const ctx_ptr: CompilationContext* = this.ctx;
        mut qualified_target: SymbolStr = SymbolStr::empty();
        if (node.qualified_target_name.is_valid()) {
            qualified_target = node.qualified_target_name;
        } else {
            const target_str: string = ctx_ptr.intern_table.resolve(node.target_type);
            if (target_str.contains("::")) {
                qualified_target = node.target_type;
            } else if (ctx_ptr.decl_index.lookup_type(node.target_type).is_valid()) {
                qualified_target = node.target_type;
            } else {
                const resolved: SymbolStr = ctx_ptr.resolve_scoped_or(node.target_type, FILE, LINE);
                if (!resolved.equals(node.target_type)) {
                    qualified_target = resolved;
                } else {
                    qualified_target = ctx_ptr.qualify_symbol_sym(node.target_type);
                }
            }
        }
        // Skip impls whose target is a generic template; only the
        // monomorphized spec'd clones should produce LLVM symbols.  Mirrors
        // the `generic_params.length > 0` skip above for `implement<T> Foo<T>`;
        // catches the additional case where the impl has no impl-level params
        // but the target type does (e.g. `implement trait Eq for struct String`
        // on `String<A = GlobalAlloc>`).  Without this, the template impl's
        // bodies are codegen'd against the bare-template `this` type, but
        // method registrations live under the spec'd target; so call sites
        // like `this.as_str()` inside the template body fail to resolve.
        if (ctx_ptr.generic_registry != null) {
            const greg: GenericRegistry* = ctx_ptr.generic_registry;
            if (greg.get_template(qualified_target) != null) {
                return;
            }
        }

        for (mut i: i64 = 0; i < node.methods.length; i++) {
            this.declare_method(node.methods[i], qualified_target);
        }
    }

    /// The arena's CANONICAL qualified name for a struct/union/class decl - 
    /// the key its methods are registered under, and therefore the prefix every
    /// caller's cross-module reference mangles.
    ///
    /// `qualify_symbol_sym` would stamp the EMITTING module's namespace, which
    /// is only the canonical one by coincidence.  For an injected monomorph the
    /// two diverge: a spec is placed in the module owning its type argument
    /// (`Array<u8, GlobalAlloc>` -> `alloc::allocator`), while its canonical
    /// identity stays with the template (`collections::array::5Array$Lh_...$G`).
    /// Deriving the name from the emitting module would rename the symbol -
    /// `raw_buffer::RawBuffer$Lh...::new_in` would become
    /// `allocator::RawBuffer$Lh...::new_in` - so callers, which mangle the
    /// canonical form, could not resolve it (E0636 / undefined reference).
    ///
    /// The DI lookups only hit when the emitting module happens to be the
    /// canonical one, so fall through to the arena's bare-name alias, which the
    /// monomorphizer registers for every spec (`TypeArena::add_name_alias`).
    canonical_type_ref(mut &this, name: SymbolStr) -> TypeRef {
        const ctx_ptr: CompilationContext* = this.ctx;
        const di: DeclarationIndex* = ctx_ptr.decl_index;
        mut tref: TypeRef = di.lookup_type(ctx_ptr.qualify_symbol_sym(name));
        if (!tref.is_valid()) { tref = di.lookup_type(name); }
        if (!tref.is_valid()) { tref = this.get_arena().lookup_by_name(name); }
        return tref;
    }

    canonical_type_qname(mut &this, name: SymbolStr) -> SymbolStr {
        const tref: TypeRef = this.canonical_type_ref(name);
        if (tref.is_valid()) {
            const q: SymbolStr = this.get_arena().get_qualified_name(tref);
            if (q.is_valid()) { return q; }
        }
        return this.ctx.qualify_symbol_sym(name);
    }

    /// Declare methods defined inline within a struct declaration.
    declare_struct_methods(mut &this, node: StructDeclNode*) -> void {
        if (node.generic_params.length > 0) {
            return;
        }
        if (node.methods.length == 0) {
            return;
        }
        const qualified: SymbolStr = this.canonical_type_qname(node.name);
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            this.declare_method(node.methods[i], qualified);
        }
    }

    /// Declare methods defined inline within a union declaration.  Mirrors
    /// declare_struct_methods (a union's type is a StructType).
    declare_union_methods(mut &this, node: UnionDeclNode*) -> void {
        if (node.generic_params.length > 0) {
            return;
        }
        if (node.methods.length == 0) {
            return;
        }
        const qualified: SymbolStr = this.canonical_type_qname(node.name);
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            this.declare_method(node.methods[i], qualified);
        }
    }

    /// Declare methods defined inline within a class declaration.
    declare_class_methods(mut &this, node: ClassDeclNode*) -> void {
        if (node.generic_params.length > 0) {
            return;
        }
        const di_ref: TypeRef = this.canonical_type_ref(node.name);
        const qualified: SymbolStr = this.canonical_type_qname(node.name);
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            this.declare_method(node.methods[i], qualified);
        }

        // Emit the vtable for classes with virtual methods.  Drive this from
        // ClassType.methods + its base chain (populated by the type-resolution
        // pass) so the vtable is inheritance-complete: a subclass's vtable has
        // one slot per virtual method introduced anywhere in the ancestry,
        // in the order of first introduction (root -> leaf).  The slot's
        // implementation is the most-derived override present in the chain,
        // falling back to the inherited base implementation when the subclass
        // doesn't override that slot.  Layout discipline is what makes call-site
        // dispatch work: a `Base*` callsite looks up slot N in `Base`'s layout,
        // and any subclass's vtable guarantees slot N at the same index.
        if (di_ref.is_valid()) {
            const arena: TypeArena* = this.get_arena();
            const t: Type* = arena.lookup(di_ref.id);
            if (t != null && t.kind == TypeKind::Class) {
                const cls: ClassType* = t as ClassType*;
                if (cls.has_virtual_methods) {
                    this.codegen_vtable_for_class(cls);
                }
            }
        }
    }

    /// Walk the class's base chain (leaf -> root) and collect the ordered
    /// list of virtual-method slots.  New `is_virtual` methods append a
    /// new slot; `is_override` methods do NOT; they install into an
    /// existing slot at vtable-emission time.  The returned list is in
    /// root -> leaf declaration order, so every subclass's vtable extends
    /// the base's layout with its own additions.
    collect_vtable_slots(mut &this, cls: ClassType*) -> VTableSlot[] {
        const arena: TypeArena* = this.get_arena();

        // Build chain = [cls, ..., root].
        mut chain: ClassType*[] = [];
        mut walk: ClassType* = cls;
        mut depth: i32 = 0;
        while (walk != null && depth < 16) {
            chain.push(walk);
            if (!walk.has_base || !walk.base_class.is_valid()) { break; }
            const base_t: Type* = arena.lookup(walk.base_class.id);
            if (base_t == null || base_t.kind != TypeKind::Class) { break; }
            walk = base_t as ClassType*;
            depth += 1;
        }

        mut slots: VTableSlot[] = [];
        for (mut ci: i64 = chain.length - 1; ci >= 0; ci--) {
            const link: ClassType* = chain[ci];
            for (mut mi: i64 = 0; mi < link.methods.length; mi++) {
                const m: &MethodInfo = &link.methods[mi];
                if (!m.is_virtual) { continue; }
                mut already: boolean = false;
                for (mut ki: i64 = 0; ki < slots.length; ki++) {
                    // Must use the SAME param equality as `find_vtable_slot_impl`
                    // / `vtable_slot_index`, or slot construction and slot
                    // lookup disagree: two virtual declarations of the same
                    // overload counted as distinct here produce two slots, while
                    // a laxer lookup then matches both to one method - a
                    // duplicate slot / index skew.
                    if (slots[ki].name.equals(m.name) &&
                        CodegenUtil::param_types_equal(
                            slots[ki].param_types, m.param_types)) {
                        already = true;
                        break;
                    }
                }
                if (!already) {
                    // Own an independent copy of the param-type ids; moving
                    // `m.param_types` out of the slice-element copy `m` would
                    // alias the array and double-free. TypeRef is Copy.
                    mut pt_copy: TypeRef[] = [];
                    for (mut pk: i64 = 0; pk < m.param_types.length; pk++) {
                        pt_copy.push(m.param_types[pk]);
                    }
                    slots.push(VTableSlot { name: m.name, param_types: pt_copy });
                }
            }
        }
        return slots;
    }

    /// For a given vtable slot (name + param_types), walk leaf -> root and
    /// return the first matching method's LLVM function: the most-derived
    /// override, falling back to the inherited base implementation when
    /// the subclass doesn't override that specific overload.  Resolution
    /// goes through the overload-specific mangled name so the correct LLVM
    /// function is installed in the slot, not the last-registered one
    /// under `Type::method`.
    find_vtable_slot_impl(mut &this, cls: ClassType*, slot_name: SymbolStr, slot_params: &TypeRef[]) -> LValue {
        const arena: TypeArena* = this.get_arena();
        const intern: InternTable* = this.get_intern();
        mut walk: ClassType* = cls;
        mut depth: i32 = 0;
        while (walk != null && depth < 16) {
            for (mut mi: i64 = 0; mi < walk.methods.length; mi++) {
                const m: &MethodInfo = &walk.methods[mi];
                if (!m.name.equals(slot_name)) { continue; }
                // Param equality must agree with `collect_vtable_slots`, which
                // built these slots.  It relies on canonical type identity: an
                // override's params and the virtual base's params denote the
                // same types and therefore share arena ids, even when the two
                // declarations resolved at different points (e.g. `ASTVisitor*`
                // registered before vs. after the visitor module finished
                // resolving).  If that ever stopped holding, this would miss
                // every override and the whole vtable would bail (every
                // `new <DerivedClass>` then skips the vtable store; runtime
                // virtual dispatch crashes reading a null vtable pointer).
                if (!CodegenUtil::param_types_equal(m.param_types, slot_params)) { continue; }
                if (!m.is_virtual && !m.is_override) { continue; }
                // Skip pure virtual declarations (virtual without body).
                // Their LLVM function is a bare `declare` that links as an
                // undefined reference.  Keep walking up; a concrete override
                // must come from further up the chain, or the caller's
                // `!impl.is_valid()` bail drops the whole vtable.
                if (m.ast_node != null) {
                    const mnode_ck: MethodNode* = m.ast_node as MethodNode*;
                    if (mnode_ck != null && mnode_ck.func != null && !mnode_ck.func.has_body()) {
                        continue;
                    }
                }
                const type_qname: QualifiedName = QualifiedName::from_symbol(walk.qualified_name);
                const method_str: string = intern.resolve(slot_name);
                // Resolve method's full signature for the mangler.
                mut method_ret: TypeRef = TypeRef::invalid();
                mut method_variadic: boolean = false;
                const fn_t: Type* = arena.lookup(m.function_type.id);
                if (fn_t != null && fn_t.kind == TypeKind::Function) {
                    const fn_ty: FunctionType* = fn_t as FunctionType*;
                    method_ret = fn_ty.return_type;
                    method_variadic = fn_ty.is_variadic;
                }
                // MethodInfo.param_types already excludes the receiver.  Default
                // to ImmutRef receiver for virtual methods; if the method has
                // a `mut &this` receiver we recover it from the AST node.
                mut recv_kind: ReceiverKind = ReceiverKind::ImmutRef;
                if (m.ast_node != null) {
                    const mn: MethodNode* = m.ast_node as MethodNode*;
                    if (mn != null && mn.func != null) {
                        recv_kind = DeclarationIndex::method_receiver_kind(mn.func, mn.is_static, intern);
                    }
                }
                const computed: MangledName = MangledName::for_method(
                    intern, arena, type_qname, slot_name, recv_kind,
                    m.param_types, method_ret, method_variadic);
                // Look up the LLVM function by its mangled name directly
                // in the module.  resolve_function/this.get_function cache by
                // bare or qualified name, which is last-write-wins for
                // overloaded virtuals; the cache would hand out whichever
                // overload was declared most recently regardless of which
                // slot we're filling, populating every inherited slot with
                // the same (wrong) function.
                const mangled_str: string = intern.resolve(computed.value);
                mut fn_val: LValue = this.llvm_module.get_named_function(mangled_str);
                if (!fn_val.is_valid()) {
                    fn_val = this.resolver.resolve_function(computed.value);
                }
                if (!fn_val.is_valid()) {
                    const type_str: string = intern.resolve(walk.qualified_name);
                    const combined: string = format("%s::%s", type_str, method_str);
                    fn_val = this.resolver.resolve_function(intern.intern(combined));
                }
                return fn_val;
            }
            if (!walk.has_base || !walk.base_class.is_valid()) { break; }
            const base_t: Type* = arena.lookup(walk.base_class.id);
            if (base_t == null || base_t.kind != TypeKind::Class) { break; }
            walk = base_t as ClassType*;
            depth += 1;
        }
        return LValue::null();
    }

    /// Return the vtable slot index of (method_name, param_types) in this
    /// class's layout, or -1 if no matching virtual slot exists.  Called
    /// from codegen dispatch after sema has identified the exact overload
    /// via `CallExprNode.resolved_method`; this function just maps that
    /// declaration to its slot position.
    ///
    /// Param-type matching goes through `param_types_equal` (canonical arena-id
    /// compare), the same relation `collect_vtable_slots` used to build the
    /// slots.  It matters that an override's parameter `Foo*` and the base
    /// method's `Foo*` share one id even when the two declarations resolved
    /// before/after `Foo`'s body was sealed - that is exactly what canonical
    /// type identity provides.  Were they to diverge, `node.accept(this)` on a
    /// base-class pointer would fall back to a static call to the base accept
    /// (which targets vtable slot 0, the no-op base `visit(BaseNode*)`;
    /// silently dropping every visitor traversal).
    vtable_slot_index(mut &this, cls: ClassType*, method_name: SymbolStr, param_types: TypeRef[]) -> i32 {
        const slots: VTableSlot[] = this.collect_vtable_slots(cls);
        for (mut i: i32 = 0; i < slots.length as i32; i++) {
            if (slots[i].name.equals(method_name) &&
                CodegenUtil::param_types_equal(
                    slots[i].param_types, param_types)) {
                return i;
            }
        }
        return -1;
    }

    /// Emit the vtable global for `cls`.  Slot layout comes from
    /// `collect_vtable_slots` (inheritance-complete, overload-aware); each
    /// slot's contents come from `find_vtable_slot_impl` (most-derived
    /// override wins, inherited base implementation otherwise).
    codegen_vtable_for_class(mut &this, cls: ClassType*) -> void {
        const intern: InternTable* = this.get_intern();

        const slots: VTableSlot[] = this.collect_vtable_slots(cls);
        if (slots.length == 0) { return; }

        mut impls: LValue[] = [];
        for (mut i: i64 = 0; i < slots.length; i++) {
            const impl: LValue = this.find_vtable_slot_impl(cls, slots[i].name, slots[i].param_types);
            if (!impl.is_valid()) {
                // If the slot's implementation isn't declared in this module,
                // skip vtable emission entirely; a half-populated vtable would
                // misdispatch.  Cross-module vtables are handled when the owning
                // module's codegen runs.
                return;
            }
            impls.push(impl);
        }

        const n: u32 = impls.length as u32;
        const fn_ptr_ty: LType = LType::pointer_to(LType::i8());
        const vtable_ty: LType = LType::array_of(fn_ptr_ty, n);

        const buf: void* = intrinsics::malloc(n as u64 * 8);
        const slot_ptrs: void** = buf as void**;
        for (mut i: u32 = 0; i < n; i++) {
            slot_ptrs[i] = llvm::LLVMConstBitCast(impls[i].raw, fn_ptr_ty.raw);
        }
        const init: LValue = LType::const_array(fn_ptr_ty, buf, n);
        intrinsics::free(buf);

        const qname: QualifiedName = QualifiedName::from_symbol(cls.qualified_name);
        const mangled: string = MangledName::for_vtable(intern, qname).resolve(intern);
        const global: LValue = this.llvm_module.add_global(vtable_ty, mangled);
        global.set_initializer(init);
        global.set_global_constant(true);
        // External linkage so cross-module `new` sites can resolve the vtable
        // symbol at link time.  Internal linkage hides the global from the
        // owning module's .o exports, leaving cross-module references unresolved.
        global.set_linkage(LLinkage::External);
    }

    /// Declare a method.  Methods get a `this` pointer as the first parameter.
    declare_method(mut &this, node: MethodNode*, target_type: SymbolStr) -> void {
        const func: FunctionDeclNode* = node.func;
        if (func == null) { return; }

        // Skip generic methods.
        if (func.generic_params.length > 0) {
            return;
        }
        // Skip self-returning trait-default templates (combinators) and
        // self-growing inherent templates (`as_ref`): they are deferred,
        // unresolved templates instantiated lazily at call sites; the concrete
        // spec (flag cleared) is what gets emitted.  Mangling the unresolved
        // template would hit an invalid TypeRef and ICE.
        if (func.is_self_returning_default || func.is_lazy_self_growing) {
            return;
        }

        const intern: InternTable* = this.get_intern();
        const type_str: string = intern.resolve(target_type);
        const method_str: string = intern.resolve(func.name);

        // Build the combined DI key.  Always compute the mangled name fresh
        // from THIS overload's parameter types; the DI cache `lookup_mangled_name`
        // only stores ONE entry per combined key, so for overloaded methods
        // (e.g., every `visit(SomeNode*)` in BaseASTVisitor) using the cached
        // name would map every overload to the first one's mangled name,
        // collide at LLVM level, and leave all but the first-declared overload
        // as unnamed declares without bodies.
        const combined: string = format("%s::%s", type_str, method_str);
        const combined_sym: SymbolStr = intern.intern(combined);
        const ctx_ptr: CompilationContext* = this.ctx;
        const di: DeclarationIndex* = ctx_ptr.decl_index;
        const arena: TypeArena* = this.get_arena();
        const type_qname: QualifiedName = QualifiedName::from_symbol(target_type);
        const recv_kind: ReceiverKind = DeclarationIndex::method_receiver_kind(func, node.is_static, intern);
        const method_param_refs: TypeRef[] = DeclarationIndex::method_non_receiver_params(func, intern);
        const computed_base: MangledName = MangledName::for_method_or_trait_impl(
            intern, arena, type_qname, func.origin_trait, func.name, recv_kind,
            method_param_refs, func.resolved_return_type, func.is_variadic);
        // Fold in the generic-method spec's type args (`$MG...`) so two specs of one
        // method whose signature doesn't depend on the method param get distinct
        // symbols.  Empty for every non-spec method -> byte-unchanged.  Must mirror
        // the mono pin (call_specializer `mangled_symbol_for_spec_method`) exactly.
        const computed: MangledName = computed_base.with_method_spec_args(
            intern, arena, func.spec_type_args);
        const mangled_sym: SymbolStr = computed.value;
        // Cache into DI only if this is the first overload; preserves the
        // existing single-slot behavior for call sites that don't disambiguate.
        if (!di.lookup_mangled_name(combined_sym).is_valid()) {
            di.register_mangled_name(combined_sym, mangled_sym);
        }
        // `![symbol("sym")]` overrides the LLVM symbol name ONLY (the C++ binding
        // generator uses it to pin a non-virtual C++ method to its mangled
        // Itanium symbol, e.g. `_ZNK5Point3sumEv`).  Cryo call sites resolve the
        // method through the `this.functions` registry below (keyed on
        // `combined_sym`/`mangled_sym`, both still pointing at this fn_val), so
        // the override is invisible to callers - it just renames the linked
        // symbol, exactly like the extern-block path in `declare_extern_block`.
        mut fn_name: string = intern.resolve(mangled_sym);
        if (func.has_link_name) { fn_name = func.link_name; }

        // Build LLVM function type.  Non-static methods prepend a `this` pointer.
        //
        // Method params keep the legacy receiver-override loop below
        // (the parser-synthesized reference annotations on `&this`
        // don't always round-trip through the arena, so the seam's
        // `classify_param(t -> map_type(t))` flow can't safely classify
        // them).  But the *return type* must agree with what
        // `build_function_ltype` would produce for a cross-module
        // extern of this method - if it doesn't, externs declared via
        // the seam in another module would get sret while this
        // definition wouldn't, and call sites would crash on the
        // mismatch.  So we classify just the return here and let the
        // seam decide on sret.
        const ret_plan: ParamPlan = this.abi.classify_return(
            func.resolved_return_type);
        mut ret_ty: LType = LType::null();
        mut sret_pointee: LType = LType::null();
        if (ret_plan.cls == ArgClass::Indirect) {
            ret_ty = LType::void_type();
            sret_pointee = ret_plan.pointee_ty;
        } else if (ret_plan.cls == ArgClass::DirectPair
                && ret_plan.llvm_slots.length == 2) {
            // DirectPair return: wrap the two eightbyte slots in an
            // anonymous LLVM literal struct so the signature reads
            // e.g. `{i64, i64}` - matches what `build_llvm_fn_type`
            // produces for free functions taking the same return.
            const dp_buf: void* = intrinsics::malloc(2 * 8);
            const dp_slots: void** = dp_buf as void**;
            dp_slots[0] = ret_plan.llvm_slots[0].raw;
            dp_slots[1] = ret_plan.llvm_slots[1].raw;
            ret_ty = LType::literal_struct(dp_buf, 2, false);
            intrinsics::free(dp_buf);
        } else if (ret_plan.llvm_slots.length > 0) {
            ret_ty = ret_plan.llvm_slots[0];
        } else {
            ret_ty = LType::void_type();
        }
        if (!ret_ty.is_valid()) { return; }

        const is_instance: boolean = !node.is_static;

        // Detect whether the method already declares an explicit self parameter.
        // Cryo allows three forms: `&this` / `mut &this` (reference, default),
        // and `this` (by-value).  `&this` is stored in `parameters` with the
        // literal name "&this"; `this` by-value is stored with the literal name
        // "this".  In EITHER case we must NOT prepend an extra implicit `this`
        // slot; the explicit param already accounts for the self argument.
        // Only when the method has no self-param at all (e.g., some elaborated
        // methods) should we synthesize the `&this` pointer prefix.
        mut explicit_self_name: string = "";  // "", "&this", "this", or "typed-this"
        for (mut pc0: u32 = 0; pc0 < func.parameters.length as u32; pc0++) {
            const pp0: VarDeclNode* = func.parameters[pc0];
            if (pp0 == null) { continue; }
            const pn: string = intern.resolve(pp0.name);
            if (pn == "&this") {
                explicit_self_name = "&this";
                break;
            }
            if (pn.eq("this")) {
                // Distinguish parser-synthesized by-value `this` (no annotation)
                // from user-written `this: Lexer*` (explicit annotation).  Both
                // count as "self" so we skip the implicit-prefix synthesis, but
                // the LLVM param type comes from different sources: bare `this`
                // uses the struct by value; typed `this` uses the annotation.
                if (pp0.type_annotation == null) {
                    explicit_self_name = "this";
                } else {
                    explicit_self_name = "typed-this";
                }
                break;
            }
        }

        // Look up the target type.  `&this` forms want `T*`; by-value `this`
        // wants the struct `T` directly.  If there's no explicit self we'll
        // synthesize `T*` as the implicit prefix.
        mut target_mapped: LType = LType::null();
        mut this_ty: LType = LType::null();
        if (is_instance) {
            mut target_ref: TypeRef = di.lookup_type(target_type);
            if (!target_ref.is_valid()) {
                // The unit type `()` isn't in the DeclarationIndex (it's a
                // primitive owned by the arena, never registered through the
                // decl-collection pass).  Fall back to the arena's canonical
                // unit TypeRef so `implement trait Drop for ()` and similar
                // get a real LLVM declaration.  Detected by the literal `()`
                // suffix on the qualified target name.
                const target_str: string = intern.resolve(target_type);
                const tlen: u64 = target_str.length();
                if (tlen >= 2 && target_str[tlen - 2] == 0x28 /* '(' */
                              && target_str[tlen - 1] == 0x29 /* ')' */) {
                    target_ref = arena.get_unit();
                }
            }
            if (target_ref.is_valid()) {
                target_mapped = this.type_mapper.map_type(target_ref);
                if (target_mapped.is_valid()) {
                    this_ty = LType::pointer_to(target_mapped);
                }
            }
            if (!this_ty.is_valid()) {
                return;
            }
        }

        const prepend_implicit_this: boolean = is_instance && explicit_self_name.length() == 0;

        // Count user parameters.  `&this` contributes a ptr slot via the
        // existing param; by-value `this` contributes a struct slot via the
        // existing param; implicit missing self is handled by prepend_implicit_this.
        // For variadic methods (`args...`), skip the trailing name-only param;
        // LLVM's `...` marker covers it.
        const fixed_user_count: u32 = CodegenUtil::fixed_param_count(func);
        mut user_param_count: u32 = 0;
        for (mut pc: u32 = 0; pc < fixed_user_count; pc++) {
            const pp: VarDeclNode* = func.parameters[pc];
            if (pp != null) { user_param_count += 1; }
        }
        // sret-returning methods get a hidden `ptr sret(%T)` parameter
        // prepended at LLVM slot 0; source parameters (including `this`)
        // shift to slot 1..N.  The attribute is attached after
        // `add_function` below, mirroring `declare_function`.
        const has_sret_slot: boolean = sret_pointee.is_valid();
        const sret_inc: u32 = if (has_sret_slot) { 1 } else { 0 } as u32;

        // Pre-classify each non-receiver source param so we know how
        // many LLVM slots it contributes (DirectPair = 2,
        // everything else = 1).  Receivers (`&this` / by-value
        // `this`) always contribute one slot; the override logic
        // keeps them out of the seam.  We build each plan in
        // final form to avoid re-assigning across move-checker
        // boundaries.
        mut user_plans: ParamPlan[] = [];
        mut total_user_slots: u32 = 0;
        for (mut i: u32 = 0; i < fixed_user_count; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null) {
                mut empty_slots: LType[] = [];
                user_plans.push(ParamPlan {
                    cryo_type:  TypeRef::invalid(),
                    cls:      ArgClass::Direct,
                    llvm_slots: empty_slots,
                    attr:       AbiAttr::None,
                    pointee_ty: LType::null(),
                });
                continue;
            }
            const param_name_pre: string = intern.resolve(param.name);
            const is_amp_this: boolean =
                param_name_pre == "&this" && this_ty.is_valid();
            const is_val_this: boolean =
                param_name_pre.eq("this")
                && target_mapped.is_valid() && param.type_annotation == null;
            if (is_amp_this) {
                mut s_amp: LType[] = [];
                s_amp.push(this_ty);
                total_user_slots += 1;
                user_plans.push(ParamPlan {
                    cryo_type:  param.resolved_type,
                    cls:      ArgClass::Direct,
                    llvm_slots: s_amp,
                    attr:       AbiAttr::None,
                    pointee_ty: LType::null(),
                });
            } else if (is_val_this) {
                // By-value `this` (consuming self) must use the SAME ABI
                // classification as an ordinary by-value parameter, so the
                // definition's receiver slot matches the caller's extern
                // declaration.  The caller classify_param-coerces an
                // <=8-byte struct receiver to a register scalar (e.g.
                // `%Range` -> `i64`); pushing the raw struct type here made
                // the definition's signature disagree with the call site
                // (define `%Range %0` vs call `i64`), so the receiver bytes
                // were mis-passed and every field the body read back was
                // garbage.  The prologue stores the (coerced) param into the
                // `this` alloca; opaque-pointer stores reinterpret it back to
                // the struct, exactly as the normal value-param path does.
                mut recv_tref_v: TypeRef = di.lookup_type(target_type);
                if (!recv_tref_v.is_valid()) { recv_tref_v = param.resolved_type; }
                const pplan_v: ParamPlan = this.abi.classify_param(recv_tref_v);
                total_user_slots += pplan_v.llvm_slots.length as u32;
                user_plans.push(pplan_v);
            } else {
                const pplan_n: ParamPlan = this.abi.classify_param(param.resolved_type);
                total_user_slots += pplan_n.llvm_slots.length as u32;
                user_plans.push(pplan_n);
            }
        }

        const total_params: u32 = total_user_slots
            + (if (prepend_implicit_this) { 1 } else { 0 } as u32)
            + sret_inc;

        const buf: void* = intrinsics::malloc(total_params as u64 * 8);
        const slots: void** = buf as void**;

        // Parallel array tracking the byval pointee for each LLVM
        // parameter slot.  `LType::null()` for slots that are NOT
        // byval.  Walked after `add_function` to attach the
        // `byval(%T)` attribute to the right LLVM indices.
        mut byval_pointees: LType[] = [];
        for (mut bi: u32 = 0; bi < total_params; bi++) {
            byval_pointees.push(LType::null());
        }

        mut idx: u32 = 0;
        if (has_sret_slot) {
            slots[idx] = LType::pointer_to(LType::i8()).raw;
            idx += 1;
        }
        if (prepend_implicit_this) {
            slots[idx] = this_ty.raw;
            idx += 1;
        }

        mut params_valid: boolean = true;
        for (mut i: u32 = 0; i < fixed_user_count; i++) {
            const pplan: &ParamPlan = &user_plans[i as i64];
            if (pplan.cls == ArgClass::Indirect
                    && pplan.attr == AbiAttr::ByVal
                    && pplan.pointee_ty.is_valid()) {
                slots[idx] = LType::pointer_to(LType::i8()).raw;
                byval_pointees[idx] = pplan.pointee_ty;
                idx += 1;
                continue;
            }
            if (pplan.llvm_slots.length == 0) {
                // Defensive: fall back to map_type so we don't emit
                // a malformed signature.  This branch only fires for
                // null params (which the loop above produced an
                // empty plan for).
                const param: VarDeclNode* = func.parameters[i];
                const fallback: LType = if (param != null) {
                    this.type_mapper.map_type(param.resolved_type)
                } else {
                    LType::null()
                };
                if (!fallback.is_valid()) {
                    params_valid = false;
                    break;
                }
                slots[idx] = fallback.raw;
                idx += 1;
                continue;
            }
            for (mut si: i64 = 0; si < pplan.llvm_slots.length; si++) {
                const slot_ty: LType = pplan.llvm_slots[si];
                if (!slot_ty.is_valid()) {
                    params_valid = false;
                    break;
                }
                slots[idx] = slot_ty.raw;
                idx += 1;
            }
            if (!params_valid) { break; }
        }

        if (!params_valid) {
            intrinsics::free(buf);
            return;
        }

        const fn_type: LType = LType::function_type(ret_ty, buf, total_params, func.is_variadic);
        intrinsics::free(buf);

        const fn_val: LValue = this.llvm_module.add_function(fn_name, fn_type);
        this.apply_spec_linkage(fn_val, node.func, fn_name, false);

        // Attach `sret(%T)` to LLVM param 0 when the classifier promoted
        // the return.  This must match what `build_function_ltype`
        // produces for a cross-module extern of this same method -
        // otherwise the call site marshals one way and the callee
        // expects the other.
        if (sret_pointee.is_valid()) {
            this.abi.apply_sret_attribute(fn_val, sret_pointee);
        }

        // Attach `byval(%T)` to any parameter slot the classifier
        // promoted to Indirect.  `byval_pointees` is indexed by LLVM
        // slot, so we can just walk it.
        for (mut bvi: u32 = 0; bvi < total_params; bvi++) {
            const pointee_bv: LType = byval_pointees[bvi as i64];
            if (pointee_bv.is_valid()) {
                this.abi.apply_byval_attribute(fn_val, bvi, pointee_bv);
            }
        }

        // `![inline]` / `![noinline]` on a method: mirror the free-function
        // path.  The flags live on the wrapped FunctionDeclNode (`func`),
        // set by directive_processing.  Gate on a body so bodyless declares
        // don't carry a dead attribute.
        if (func.body != null) {
            if (func.is_inline) {
                this.abi.apply_inline_attribute(fn_val);
            } else if (func.is_noinline) {
                this.abi.apply_noinline_attribute(fn_val);
            }
            // `-g`: keep a frame pointer (see free-function path).
            if (this.ctx.emit_debug_info) {
                this.abi.apply_frame_pointer_attribute(fn_val);
            }
            // `![weak]` / `![section]` on a method (naked is function-only).
            this.apply_directive_effects(fn_val, func, fn_name);
        }

        // Register under the combined key built above.  Also register against the
        // (name, total-LLVM-arity) composite so that callers can pick the correct
        // overload at call sites (e.g., `Array::new()` vs `Array::new(u64)`).
        // `total_params` matches the arity cross-module externs register with
        // (the FunctionType's param count), keeping the two registration paths
        // interoperable.  Finally register under the unique mangled_sym; that's
        // the key `codegen_method_prologue` uses to look up the right LLVM
        // function for each overload (combined_sym alone is ambiguous because
        // overloads share the same `Type::method` form).
        // The arity tracked in the function registry is the *source-level*
        // arity (counting any implicit `&this`, but *not* the hidden
        // sret slot, and *not* counting per-source-param LLVM slot
        // expansion like DirectPair).  Call-site lookups in
        // `call_emitter.cryo` count source arguments and need to match
        // what extern registrations record (`ft.param_types.length` -
        // also source-level).
        const registry_arity: u32 = user_param_count
            + (if (prepend_implicit_this) { 1 } else { 0 } as u32);
        this.functions.register(combined_sym, fn_val);
        this.functions.register_with_arity(combined_sym, registry_arity, fn_val);
        this.functions.register(mangled_sym, fn_val);
    }

    /// Declare an intrinsic function (e.g., malloc, printf, strlen).
    /// Intrinsics use C linkage: bare name, no namespace qualification.
    declare_intrinsic(mut &this, node: IntrinsicDeclNode*) -> void {
        const intern: InternTable* = this.get_intern();
        const name_str: string = intern.resolve(node.name);

        // Route the LLVM function-type through the ABI seam.  Intrinsics
        // are flat C signatures with no receiver, so the seam handles
        // them directly without any pre-lowering.
        const ret_ref: TypeRef = if (node.has_resolved_return_type()) {
            node.resolved_return_type
        } else {
            TypeRef::invalid()
        };
        const param_count: u32 = CodegenUtil::fixed_param_count_intrinsic(node);
        mut params: TypeRef[] = [];
        for (mut i: u32 = 0; i < param_count; i++) {
            const param: VarDeclNode* = node.parameters[i];
            if (param != null && param.resolved_type.is_valid()) {
                params.push(param.resolved_type);
            }
        }
        const plan: SignaturePlan = this.abi.classify_signature(
            params, ret_ref, node.is_variadic);
        if (!plan.llvm_fn_type.is_valid()) { return; }
        const fn_type: LType = plan.llvm_fn_type;

        // C linkage: use bare name.
        const fn_val: LValue = this.llvm_module.add_function(name_str, fn_type);

        // Register under bare name (for identifier lookups like `malloc(...)`)
        this.functions.register(node.name, fn_val);

        // Also register under qualified name (for cross-module resolution).
        const ctx_ptr: CompilationContext* = this.ctx;
        const qualified: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
        if (!qualified.equals(node.name)) {
            this.functions.register(qualified, fn_val);
        }
    }

    /// Declare extern block functions.
    declare_extern_block(mut &this, node: ExternBlockNode*) -> void {
        // Get intern table from CompilationContext to avoid CodegenContext offset issues.
        const ctx_ptr: CompilationContext* = this.ctx;
        const intern: InternTable* = ctx_ptr.intern_table;

        for (mut i: i64 = 0; i < node.functions.length; i++) {
            const func: FunctionDeclNode* = node.functions[i];
            if (func == null) { continue; }

            const name_str: string = intern.resolve(func.name);
            const param_count: u32 = CodegenUtil::fixed_param_count(func);

            // Route the extern declaration through the Phase 1 + 2 + 3
            // extern-C seam so the LLVM function type matches the SysV
            // C ABI: large aggregate returns get sret, large aggregate
            // params get byval, small aggregate returns are coerced
            // into a register-sized integer (Phase 3).
            mut params: TypeRef[] = [];
            for (mut pi: u32 = 0; pi < param_count; pi++) {
                const param_pi: VarDeclNode* = func.parameters[pi];
                if (param_pi != null && param_pi.resolved_type.is_valid()) {
                    params.push(param_pi.resolved_type);
                }
            }
            const plan: SignaturePlan = this.abi.classify_signature_extern_c(
                params, func.resolved_return_type, func.is_variadic);
            if (!plan.llvm_fn_type.is_valid()) {
                this.diag.emit_warning_at_span(ErrorCode::E0643_RETURN_TYPE_ERROR,
                    format("codegen: extern function '%s': failed to classify signature", name_str),
                    func.span);
                continue;
            }
            const fn_type: LType = plan.llvm_fn_type;

            // Use the bare source name for C linkage, unless `![symbol("...")]`
            // overrode the linker symbol - then the LLVM declaration is
            // named for the C library symbol while Cryo callers still
            // resolve through `func.name` via the registry below.
            mut link_str: string = name_str;
            if (func.has_link_name) { link_str = func.link_name; }
            const fn_val: LValue = this.llvm_module.add_function(link_str, fn_type);

            // Apply sret + byval attributes for any Indirect slots the
            // classifier produced.  Phase 3's `Direct`-with-coercion
            // small-aggregate slot is *not* an attribute - it lowers
            // to a plain integer return that the call site bitcasts.
            if (plan.sret_slot && plan.return_plan.pointee_ty.is_valid()) {
                this.abi.apply_sret_attribute(fn_val, plan.return_plan.pointee_ty);
            }
            for (mut xi: i64 = 0; xi < plan.param_plans.length; xi++) {
                const xpp: &ParamPlan = &plan.param_plans[xi];
                if (xpp.cls == ArgClass::Indirect
                        && xpp.attr == AbiAttr::ByVal
                        && xpp.pointee_ty.is_valid()) {
                    const exslot: u32 = AbiClassifier::llvm_slot_index_of_param(
                        plan.param_plans, plan.sret_slot, xi);
                    this.abi.apply_byval_attribute(fn_val, exslot, xpp.pointee_ty);
                }
            }

            this.functions.register(func.name, fn_val);
        }
    }

    /// Generate a global variable declaration with optional initializer.
    codegen_global_var(mut &this, node: VarDeclNode*) -> void {
        // Mangle definitions under the current module's namespace
        // (`C$<namespace>.<name>`) so two modules with the same private
        // `const NAME = ...` don't collide at link time.  Cross-module readers
        // pull the same namespace out of `DeclarationIndex::get_global_namespace`.
        // A C-imported global const mangles under its alias namespace instead,
        // so two extern-module imports in one file each defining the same const
        // name (e.g. `a::FOO` and `b::FOO`) emit distinct symbols.
        const def_ns: SymbolStr = if (!node.binding_namespace.is_empty()) {
            node.binding_namespace
        } else {
            this.ctx.namespace_str
        };
        // An IMPORTED global names storage another object owns, so it takes the
        // bare linker symbol rather than the namespace mangling - the mangling
        // exists to keep two modules' same-named globals apart, and there is
        // only ever one `errno`.  `![symbol("...")]` overrides it for a C name
        // that is not a Cryo identifier.
        const mangled: string = if (node.is_extern_import) {
            if (node.link_name.length() > 0) { node.link_name }
            else { this.get_intern().resolve(node.name) }
        } else {
            MangledName::for_global(
                this.get_intern(), def_ns, node.name).resolve(this.get_intern())
        };

        const ty: LType = this.type_mapper.map_type(node.resolved_type);
        if (!ty.is_valid()) {
            return;
        }

        const global: LValue = this.llvm_module.add_global(ty, mangled);

        // Same reason a local's slot is raised: the mapped type reproduces the
        // WIDTH an `![align(N)]` type declares but not its boundary, so LLVM
        // places the object on the fields' alignment instead.  A global is an
        // object placement like any other, and the code generated against the
        // type already assumes the declared boundary.  Only ever raised -
        // LLVM's own choice is the floor.
        const gty: Type* = this.lookup_type_by_id(node.resolved_type.id);
        if (gty != null) {
            const want_align: u64 = gty.alignment();
            if (want_align > 0 && want_align > global.alignment() as u64) {
                global.set_alignment(want_align as u32);
            }
        }

        // An imported global is a DECLARATION: leaving it with no initializer is
        // what makes it external in LLVM.  Giving it one - even the
        // zeroinitializer every other global falls back to - would define the
        // symbol here and collide with the library at link time.  It is also
        // never marked LLVM-constant, including when written `const`: `const`
        // governs what Cryo may write, while the owning library stays free to
        // change the value, and promising otherwise would license folding a
        // stale read.
        if (node.is_extern_import) {
            this.globals.register(this.global_cache_key(node), global);
            return;
        }

        // Initializer: if the source declaration has a literal initializer
        // (e.g., `const BUCKET_OCCUPIED: u8 = 1`), emit it as the constant
        // initializer typed against the global's own type so consumers see
        // the right value.  LLVM globals require a constant initializer, so
        // anything more complex than a literal falls back to zeroinitializer
        // (more involved cases would need a runtime ctor, out of scope here).
        mut init: LValue = LValue::null();
        // Peel one layer of cast so initializers like
        // `const HEX_LOWER: u8* = "0123456789abcdef"` route to the
        // string-literal branch below.  Without this, the cast wraps the
        // literal and the global lands on the `null` fallback at the bottom
        // of this function, leaving HEX_LOWER null at runtime, which
        // segfaults the moment a downstream consumer indexes it.
        mut init_expr: ExpressionNode* = node.initializer;
        if (init_expr != null && init_expr.kind == NodeKind::CastExpression) {
            const ce: CastExprNode* = init_expr as CastExprNode*;
            if (ce.expression != null && ce.expression.kind == NodeKind::Literal) {
                init_expr = ce.expression;
            }
        }
        if (init_expr != null && init_expr.kind == NodeKind::Literal) {
            const lit: LiteralNode* = init_expr as LiteralNode*;
            const tk: LTypeKind = LType::kind_of(ty.raw);
            if (lit.literal_kind == LiteralKind::Integer && tk == LTypeKind::Integer) {
                if (llvm::LLVMGetIntTypeWidth(ty.raw) == 128) {
                    // 128-bit global: build from the digit string so a value
                    // above u64::MAX isn't truncated by the u64 const_int path.
                    mut radix: u8 = 10;
                    const digits: string = CodegenUtil::int_literal_clean(lit.value, &radix);
                    init = LType::const_int_of_string(ty, digits, radix);
                } else {
                    const ival: u64 = lit.value.parse_int<u64>();
                    init = LType::const_int(ty, ival, true);
                }
            } else if (lit.literal_kind == LiteralKind::Boolean && tk == LTypeKind::Integer) {
                const bval: u64 = if (lit.value == "true") { 1 } else { 0 };
                init = LType::const_int(ty, bval, false);
            } else if (lit.literal_kind == LiteralKind::Float
                       && (tk == LTypeKind::Float || tk == LTypeKind::Double)) {
                const fval: f64 = float::parse_f64(lit.value).unwrap_or(0.0);
                init = LType::const_real(ty, fval);
            } else if (lit.literal_kind == LiteralKind::Null && tk == LTypeKind::Pointer) {
                init = LType::const_pointer_null(ty);
            } else if (lit.literal_kind == LiteralKind::String && tk == LTypeKind::Pointer) {
                // String literal global: store the address of the interned
                // string global as the initializer.  Without this, every
                // `const SOME_TEXT: string = "..."` emits as `null`, which
                // surfaces as literal "(null)" in any printf/format output
                // that consumes the constant.
                init = this.str_cache.get_or_create(lit.value, this.llvm_module);
            }
        }
        // Fold a constant-expression initializer that isn't a bare literal -
        // unary minus or simple arithmetic on float literals, e.g.
        // `const F64_MIN: f64 = -1.79e308;` or `const X: f64 = 0.0 - 1.5;`.
        // Without this the leading `-` / the operation is dropped and the
        // global silently lands on the `const_null` (0.0) fallback below.
        // Only runs when `init` is still invalid (the path that today emits
        // 0), so no currently-correct const can change.
        if (!init.is_valid() && init_expr != null) {
            const tkf: LTypeKind = LType::kind_of(ty.raw);
            if (tkf == LTypeKind::Float || tkf == LTypeKind::Double) {
                mut folded: f64 = 0.0;
                if (DeclarationEmitter::try_fold_const_real(init_expr, &folded)) {
                    init = LType::const_real(ty, folded);
                }
            } else if (tkf == LTypeKind::Integer) {
                // Integer const-expression initializer that isn't a bare literal -
                // unary minus / bitwise-not / arithmetic, e.g. `const EOF: i32 = -1;`
                // or `const FLAGS: u32 = (1 << 4) | (1 << 2)`.  A negative literal
                // parses as a UnaryExpression (not a Literal), so without this the
                // leading `-` is dropped and the global silently lands on the
                // `const_null` (0) fallback below - a real miscompile for every
                // negative module-level integer constant (EOF, AT_FDCWD, the EAI_*
                // family, INVALID_HANDLE_VALUE, ...).  Only widths <= 64 fold here;
                // the u64 two's-complement result truncates to the global's width
                // in LLVMConstInt, which is exact for those types.
                if (llvm::LLVMGetIntTypeWidth(ty.raw) <= 64) {
                    mut ifold: u64 = 0;
                    if (DeclarationEmitter::try_fold_const_int(init_expr, &ifold)) {
                        init = LType::const_int(ty, ifold, true);
                    }
                }
            }
        }
        // Struct-literal const initializer, e.g. the bindgen importer lowers a
        // C compound-literal macro `#define RAYWHITE (Color){245,245,245,255}`
        // to `const RAYWHITE: Color = Color { r: 245, ... }`.  Build a constant
        // aggregate from the field initializers (each must fold to a scalar
        // constant); decline to the zeroinitializer fallback below otherwise.
        // Only runs when `init` is still invalid, so no currently-correct const
        // can change.
        if (!init.is_valid() && init_expr != null
            && init_expr.kind == NodeKind::StructLiteral
            && LType::kind_of(ty.raw) == LTypeKind::Struct) {
            init = DeclarationEmitter::try_const_struct(
                this.type_mapper, gty, init_expr as StructLiteralNode*, ty);
        }
        if (!init.is_valid()) {
            init = LType::const_null(ty);
        }
        global.set_initializer(init);

        if (!node.is_mutable) {
            global.set_global_constant(true);
        }

        // `![thread_local]`: emit as an LLVM thread-local global so each thread
        // gets its own instance (see set_thread_local).
        if (node.is_thread_local) {
            global.set_thread_local(true);
        }

        // A C-imported const is referenced only as `cit::NAME` (a
        // ScopeResolution), which `resolve_global` probes under the qualified
        // key.  `resolve_global` checks this cache before its cross-module
        // (owned-by-current-module) short-circuit, so register under the
        // qualified key - the bare key would never be hit and would risk a
        // last-write-wins collision between two imports' same-named consts.
        this.globals.register(this.global_cache_key(node), global);
    }

    /// The key a global is cached under for later reference resolution.  A
    /// C-imported global is reachable only as `alias::NAME` (a ScopeResolution),
    /// which `resolve_global` probes under the qualified key; the bare key would
    /// never be hit, and two imports declaring the same name would race to
    /// last-write-wins under it.
    global_cache_key(&this, node: VarDeclNode*) -> SymbolStr {
        if (!node.binding_namespace.is_empty()) {
            return this.ctx.qualify_binding_sym(node.name, node.binding_namespace);
        }
        return node.name;
    }

    /// Generate the body of a function.  Called from the IRGeneratorVisitor.
    ///
    /// 1. Look up the LLVM function
    /// 2. Create entry basic block
    /// 3. Create allocas for parameters and store incoming values
    /// 4. Push scope, bind parameter names
    /// 5. The visitor will visit the body (BlockStmtNode)
    /// 6. Handle implicit return for void functions
    /// Attach a DWARF DISubprogram to `fn_val` and set the builder's
    /// current debug location to the function's declaration line, scoped
    /// to that subprogram. Called from the prologue once the builder is at
    /// the entry block; every instruction emitted afterward inherits the
    /// location. No-op unless `-g` populated `ctx.di_builder`. The
    /// subroutine type carries no parameter list (sufficient for
    /// function-level file:line backtraces; per-argument types and
    /// per-statement line granularity are follow-ups).
    emit_debug_subprogram(mut &this, fn_val: LValue, node: FunctionDeclNode*) -> void {
        const ctx_ptr: CompilationContext* = this.ctx;
        if (!ctx_ptr.emit_debug_info || ctx_ptr.di_builder == null) { return; }
        if (!fn_val.is_valid()) { return; }

        const dib:  void* = ctx_ptr.di_builder;
        const file: void* = ctx_ptr.di_file;

        mut line: u32 = node.span.start_line;
        if (line == 0) { line = 1; }

        // Idempotent: if `fn_val` already carries a DISubprogram, REUSE it. A
        // function whose prologue is emitted more than once in this module (a
        // generic spec placed/walked twice - e.g. `Layout_of<T>` routed into a
        // consumer module) would otherwise get a SECOND `LLVMDIBuilderCreateFunction`
        // and `LLVMSetSubprogram`, detaching the first subprogram while the
        // instructions it already scoped keep pointing at it -> the verifier
        // rejects "!dbg attachment points at wrong subprogram" (`-g`/`--dev`
        // only; release emits no debug info so the double emission was silently
        // tolerated). Reusing the existing subprogram keeps every instruction in
        // the function scoped to one SP.
        mut sp: void* = llvm::LLVMGetSubprogram(fn_val.raw);
        if (sp == null) {
            const subroutine_ty: void* = llvm::LLVMDIBuilderCreateSubroutineType(
                dib, file, null, 0, 0);

            // DW_AT_name: module-qualified source name (e.g.
            // "Compiler::Codegen::State::FunctionRegistry::get") so same-named
            // methods are distinguishable in a backtrace, rather than the bare
            // leaf name.
            const disp_sym: SymbolStr = ctx_ptr.qualify_symbol_sym(node.name);
            const name: string = this.resolve(disp_sym);
            const name_len: u64 = name.length();

            // DW_AT_linkage_name: the function's actual ELF symbol (the mangled
            // name LLVM emits for `fn_val`).  Setting this to exactly the ELF
            // symbol is what lets perf/gdb/lldb bridge a sampled address -> ELF
            // symbol -> this DISubprogram and surface the readable DW_AT_name
            // instead of the raw mangled symbol.  This slot must be the ELF
            // symbol, not the source name, or the bridge never matches.
            mut link_len: u64 = 0;
            const linkage: string = llvm::LLVMGetValueName2(fn_val.raw, &link_len);

            // IsOptimized: reflect the build's opt level so debuggers know to
            // warn about optimized-out locals / reordered code.
            mut is_opt: i32 = 0;
            if (ctx_ptr.opt_level > 0) { is_opt = 1; }

            sp = llvm::LLVMDIBuilderCreateFunction(
                dib, file, name, name_len, linkage, link_len, file, line,
                subroutine_ty,
                0,        // IsLocalToUnit
                1,        // IsDefinition
                line,     // ScopeLine
                0,        // Flags
                is_opt);  // IsOptimized
            llvm::LLVMSetSubprogram(fn_val.raw, sp);
        }

        mut col: u32 = node.span.start_col;
        if (col == 0) { col = 1; }
        // Debug metadata is context-scoped; build it in the same per-target
        // context as the module/builder (LContext::current()), not the global
        // one, or LLVM asserts on a context mismatch.
        const loc: void* = llvm::LLVMDIBuilderCreateDebugLocation(
            LContext::current().raw, line, col, sp, null);
        llvm::LLVMSetCurrentDebugLocation2(this.builder.raw, loc);
    }

    /// Minimal prologue for a `![naked]` function: resolve the declared LLVM
    /// function (registered by declare_function under its qualified name) and
    /// open its entry block.  Deliberately emits NO parameter allocas, NO
    /// arg-setup prologue, and pushes NO value scope - a naked body is a single
    /// `asm { }` block that runs on the caller's frame and cannot name its
    /// parameters.  Returns null (with a diagnostic) when no declaration
    /// exists.  The caller caps the entry block with `unreachable` after
    /// emitting the asm (inline asm is not a terminator; the asm performs the
    /// real control transfer).
    codegen_naked_prologue(mut &this, node: FunctionDeclNode*) -> LValue {
        const qualified: SymbolStr = this.fn_qualified_name(node);
        const fn_val: LValue = this.functions.get(qualified);
        if (!fn_val.is_valid()) {
            const fname: string = this.resolve(node.name);
            this.diag.emit_warning_at_span(ErrorCode::E0606_FUNCTION_GENERATION_ERROR,
                format("codegen: naked function '%s' has no LLVM declaration in this module; body skipped.", fname),
                node.span);
            return LValue::null();
        }
        const entry_bb: LBasicBlock = LBasicBlock::append(fn_val, "entry");
        this.builder.position_at_end(entry_bb);
        return fn_val;
    }

    codegen_function_prologue(mut &this, node: FunctionDeclNode*) -> LValue {
        const ctx_ptr: CompilationContext* = this.ctx;
        const intern: InternTable* = ctx_ptr.intern_table;
        // Same canonical-namespace resolution as `declare_function` so the
        // body attaches to the exact LLVM function the signature pass declared
        // (template-derived for injected free-fn / static-method-generic specs).
        const qualified: SymbolStr = this.fn_qualified_name(node);
        const di: DeclarationIndex* = ctx_ptr.decl_index;
        const arena: TypeArena* = this.get_arena();

        // Body emission must attach to the LLVM function for THIS exact
        // overload, not whichever one was registered last under the bare
        // qualified-name cache.  Build the same func_type_ref declare_function
        // used to derive the mangled name, then fetch by name from the LLVM
        // module directly.  Falls back to the bare cache for non-overloaded
        // functions (no overload-keyed entry registered).
        mut params: TypeRef[] = [];
        for (mut pi: i64 = 0; pi < node.parameters.length; pi++) {
            const param: VarDeclNode* = node.parameters[pi];
            if (param != null && param.resolved_type.is_valid()) {
                params.push(param.resolved_type);
            }
        }
        const func_type_ref: TypeRef = arena.get_function(
            node.resolved_return_type, params, node.is_variadic);
        const overload_mangled: SymbolStr = di.lookup_overload_mangled(qualified, func_type_ref);

        mut fn_val: LValue = LValue::null();
        if (overload_mangled.is_valid()) {
            // `main` is special-cased to keep its unmangled C ABI symbol;
            // mirror declare_function's override so we look up "main" not
            // the mangled form.
            const main_sym: SymbolStr = intern.intern("main");
            mut ir_name: string = intern.resolve(overload_mangled);
            if (node.name.equals(main_sym)) {
                ir_name = "main";
                // Under `--panic=unwind` declare_function emitted the user body's
                // function under the internal symbol (the `main` symbol is the
                // synthesized catch wrapper); attach the body to that same symbol.
                if (this.ctx.project_panic_unwind && !this.ctx.project_no_runtime) {
                    ir_name = "__cryo_user_main";
                }
            }
            fn_val = this.llvm_module.get_named_function(ir_name);
        }
        if (!fn_val.is_valid()) {
            fn_val = this.resolver.resolve_function(qualified);
        }
        if (!fn_val.is_valid()) {
            // IRGeneration's declare-functions phase should have produced a
            // declare for this function before any body is emitted. When it
            // didn't, the body simply can't land; emit a warning rather than
            // an error because the upstream gap is the real bug to fix, and a
            // warning lets the build continue so downstream code can be
            // exercised.
            const fname: string = this.resolve(node.name);
            this.diag.emit_warning_at_span(ErrorCode::E0606_FUNCTION_GENERATION_ERROR,
                format("codegen: function '%s' has no LLVM declaration in this module; body skipped (the declare-functions phase should have produced one). Calls to this function will fail at link time.", fname),
                node.span);
            return LValue::null();
        }

        const entry_bb: LBasicBlock = LBasicBlock::append(fn_val, "entry");
        this.builder.position_at_end(entry_bb);

        // DWARF: attach a DISubprogram + set the entry debug location
        // BEFORE any body instructions, so the prologue allocas and the
        // whole body inherit a !dbg location (the verifier requires one on
        // inlinable calls in a function that carries debug info). No-op
        // unless `-g`.
        this.emit_debug_subprogram(fn_val, node);

        // Create allocas for each parameter and store the incoming value.
        this.values.push_scope();

        // Phase 1: if this function was declared with sret, LLVM
        // parameter slot 0 is the hidden result pointer (not a regular
        // source parameter).  Source parameters start at LLVM index 1.
        // Codegen_return reads the same slot via LLVMGetParam(fn, 0).
        const is_sret_fn: boolean = this.abi.sret_pointee_of(fn_val).is_valid();
        mut llvm_idx: u32 = if (is_sret_fn) { 1 } else { 0 } as u32;

        const fixed_count: u32 = CodegenUtil::fixed_param_count(node);
        for (mut i: u32 = 0; i < fixed_count; i++) {
            const param: VarDeclNode* = node.parameters[i];
            const param_name: string = this.resolve(param.name);
            const param_ty: LType = this.type_mapper.map_type(param.resolved_type);

            if (!param_ty.is_valid()) {
                const fname: string = this.resolve(node.name);
                this.diag.emit_warning_at_span(ErrorCode::E0642_PARAM_TYPE_ERROR,
                    format("codegen: function '%s', parameter '%s': could not lower its type to LLVM; body skipped. Calls to this function will fail at link time.",
                        fname, param_name),
                    if (param != null) { param.span } else { node.span });
                this.values.pop_scope();
                return LValue::null();
            }

            // Phase 2 - byval: the LLVM parameter at this slot is a
            // `ptr` pointing at a caller-allocated copy of the value.
            // We bind that pointer directly to the source name (same
            // pattern `&this` uses in `codegen_method_prologue`) so
            // member-access GEPs and `load(name)` reach the right
            // memory.  An alloca-and-store would type-mismatch (`ptr`
            // stored into an alloca-of-struct) and lose the byval
            // semantics besides.
            const byval_pointee: LType =
                this.abi.byval_pointee_of_param(fn_val, llvm_idx);
            if (byval_pointee.is_valid()) {
                const arg: LValue = LValue {
                    raw: llvm::LLVMGetParam(fn_val.raw, llvm_idx),
                };
                this.values.set(param.name, arg);
                llvm_idx += 1;
                continue;
            }

            // Query the classifier so we know how many LLVM slots this
            // source param consumes.  Direct <= 8 byte
            // aggregate: one register-shaped slot whose bytes match
            // the source struct (opaque-pointer store at the source-
            // typed alloca round-trips).  DirectPair 9-16 byte: two
            // register-shaped slots, lo + hi, stored at offsets 0
            // and 8 of a source-typed alloca.  Plain Direct: one
            // slot whose type matches the source, stored normally.
            const pplan: ParamPlan = this.abi.classify_param(param.resolved_type);
            if (pplan.cls == ArgClass::DirectPair
                    && pplan.llvm_slots.length == 2) {
                const alloca: LValue = this.flow.create_entry_alloca(
                    fn_val, param_name, param_ty);
                const lo_arg: LValue = LValue {
                    raw: llvm::LLVMGetParam(fn_val.raw, llvm_idx),
                };
                const hi_arg: LValue = LValue {
                    raw: llvm::LLVMGetParam(fn_val.raw, llvm_idx + 1),
                };
                this.builder.build_store(lo_arg, alloca);
                // GEP at byte offset 8 via i8 base, mirroring the
                // call-site DirectPair expansion.
                const i8_ty: LType = LType::i8();
                const idx_buf: void* = intrinsics::malloc(8);
                const idx_slots: void** = idx_buf as void**;
                const eight: LValue = LType::const_int(LType::i64(), 8, false);
                idx_slots[0] = eight.raw;
                const hi_ptr: LValue = this.builder.build_gep(
                    i8_ty, alloca, idx_buf, 1, "param.hi.ptr");
                intrinsics::free(idx_buf);
                this.builder.build_store(hi_arg, hi_ptr);
                this.values.set(param.name, alloca);
                llvm_idx += 2;
                continue;
            }

            const alloca: LValue = this.flow.create_entry_alloca(fn_val, param_name, param_ty);
            const arg: LValue = LValue {
                raw: llvm::LLVMGetParam(fn_val.raw, llvm_idx),
            };
            this.builder.build_store(arg, alloca);
            this.values.set(param.name, alloca);
            llvm_idx += 1;
        }

        // For variadic functions with an `args...` bucket, set up a va_list
        // so the body can forward varargs to other variadic intrinsics via
        // a v* variant (vsprintf, vfprintf, etc.).  Without this the `args`
        // identifier has no LLVM value and every forwarding call codegens
        // with a null operand.
        this.expr_ops.emit_va_start_for_variadic(fn_val, CodegenUtil::variadic_param_name(node));

        // Program-main prologue: publish argc/argv to the standard library
        // before the user's body runs, so `std::env::args()` returns the
        // real argv instead of an empty slice.  `declare_function` widened
        // main's LLVM signature to `i32 (i32, ptr)`; the user's source has
        // no parameters, so we read the synthetic params via LLVMGetParam
        // and forward them through the regular function-resolution path.
        // `intern` is already bound at the top of this function.
        // Suppressed under `no_runtime`: main's signature was NOT widened
        // (no argc/argv/envp), so there are no synthetic params to publish,
        // and `std::env` is not linked in a freestanding build.
        const main_sym: SymbolStr = intern.intern("main");
        if (node.name.equals(main_sym) && CodegenUtil::fixed_param_count(node) == 0
            && !this.ctx.project_no_runtime) {
            this.emit_set_args_call(fn_val);
            this.emit_set_env_call(fn_val);
        }

        return fn_val;
    }

    /// Emit `std::env::set_args(argc, argv)` at the entry of the program's
    /// main function.  Looks the function up by qualified name so the
    /// mangled symbol is whatever `MangledName::for_free_function` decides
    /// No hardcoded mangle.  Silent no-op if the stdlib (or `set_args`
    /// specifically) isn't available, which keeps `--no-std` builds and
    /// freestanding mains compiling.
    emit_set_args_call(mut &this, main_fn: LValue) -> void {
        const intern: InternTable* = this.get_intern();
        const set_args_sym: SymbolStr = intern.intern("std::env::set_args");
        const set_args_fn: LValue = this.resolver.resolve_function(set_args_sym);
        if (!set_args_fn.is_valid()) { return; }

        const set_args_ty: LType = LType {
            raw: llvm::LLVMGlobalGetValueType(set_args_fn.raw),
        };
        if (!set_args_ty.is_valid()) { return; }

        const argc: LValue = LValue { raw: llvm::LLVMGetParam(main_fn.raw, 0) };
        const argv: LValue = LValue { raw: llvm::LLVMGetParam(main_fn.raw, 1) };

        mut args: Pair<LValue, TypeRef>[] = [];
        args.push(Pair<LValue, TypeRef>::new(argc, TypeRef::invalid()));
        args.push(Pair<LValue, TypeRef>::new(argv, TypeRef::invalid()));
        mut result: LValue = LValue::null();
        result = this.expr_ops.codegen_call(set_args_fn, set_args_ty, args, "");
    }

    /// Emit `std::env::set_env(envp)` at the entry of the program's main,
    /// publishing the environment pointer the C runtime passed as main's
    /// third argument so `std::env::vars()` can enumerate it.  Mirrors
    /// `emit_set_args_call`: looked up by qualified name (no hardcoded
    /// mangle) and a silent no-op when the stdlib (or `set_env`) is absent,
    /// so `--no-std` and freestanding mains still compile.  The main-widening
    /// branch above gave main a synthetic third `char**` param at index 2.
    emit_set_env_call(mut &this, main_fn: LValue) -> void {
        const intern: InternTable* = this.get_intern();
        const set_env_sym: SymbolStr = intern.intern("std::env::set_env");
        const set_env_fn: LValue = this.resolver.resolve_function(set_env_sym);
        if (!set_env_fn.is_valid()) { return; }

        const set_env_ty: LType = LType {
            raw: llvm::LLVMGlobalGetValueType(set_env_fn.raw),
        };
        if (!set_env_ty.is_valid()) { return; }

        const envp: LValue = LValue { raw: llvm::LLVMGetParam(main_fn.raw, 2) };

        mut args: Pair<LValue, TypeRef>[] = [];
        args.push(Pair<LValue, TypeRef>::new(envp, TypeRef::invalid()));
        mut result: LValue = LValue::null();
        result = this.expr_ops.codegen_call(set_env_fn, set_env_ty, args, "");
    }

    /// Get-or-declare the external root-catch reporter `__cryo_panic_finish()`
    /// (`void() -> never`, defined by the `panic/unwind` runtime tier): report
    /// the stashed panic payload and exit 101.  Called only from the `main`
    /// wrapper's catch pad.
    get_or_decl_panic_finish(mut &this) -> LValue {
        mut fn: LValue = this.llvm_module.get_named_function("__cryo_panic_finish");
        if (fn.is_valid()) { return fn; }
        const fty: LType = LType::function_type(LType::void_type(), null, 0, false);
        return this.llvm_module.add_function("__cryo_panic_finish", fty);
    }

    /// Synthesize the `--panic=unwind` root-catch wrapper.  `user_main` is the
    /// user's `main` (declared under the internal symbol `__cryo_user_main` with
    /// signature `fn_type`); this emits a strong C `main` of the same signature
    /// that forwards its arguments to `__cryo_user_main` inside a catch-all
    /// landing pad:
    ///
    ///   define i32 @main(...) personality @__cryo_personality_v0 {
    ///   entry: %r = invoke @__cryo_user_main(...args) to %cont unwind %lpad
    ///   cont:  ret %r                       ; normal exit
    ///   lpad:  landingpad {ptr,i32} catch null
    ///          call @__cryo_panic_finish()  ; report + exit 101; never returns
    ///          unreachable
    ///   }
    ///
    /// Reaching the pad means a panic unwound out of `main` uncaught; being the
    /// phase-1 handler makes phase 2 run every intermediate frame's cleanup pad
    /// first, so destructors execute before the process ends.  The catch is
    /// catch-all + unconditional (the selector is never inspected).
    emit_main_unwind_wrapper(mut &this, user_main: LValue, fn_type: LType) -> void {
        const wrapper: LValue = this.llvm_module.add_function("main", fn_type);
        if (!wrapper.is_valid()) { return; }

        const pers: LValue = this.expr_ops.get_or_decl_personality();
        if (pers.is_valid()) { wrapper.set_personality_fn(pers); }

        const saved_bb: LBasicBlock = this.builder.get_insert_block();

        const entry_bb: LBasicBlock = LBasicBlock::append(wrapper, "entry");
        const cont_bb:  LBasicBlock = LBasicBlock::append(wrapper, "cont");
        const lpad_bb:  LBasicBlock = LBasicBlock::append(wrapper, "lpad");

        this.builder.position_at_end(entry_bb);

        // Forward every parameter (argc/argv/envp, or the user signature) to
        // __cryo_user_main.
        const nparams: u32 = llvm::LLVMCountParamTypes(fn_type.raw);
        mut arg_buf: void* = null;
        if (nparams > 0) {
            arg_buf = intrinsics::malloc(nparams as u64 * 8);
            const arg_slots: void** = arg_buf as void**;
            for (mut i: u32 = 0; i < nparams; i++) {
                arg_slots[i] = wrapper.get_param(i).raw;
            }
        }
        const r: LValue = this.builder.build_invoke(
            fn_type, user_main, arg_buf, nparams, cont_bb, lpad_bb, "");
        if (arg_buf != null) { intrinsics::free(arg_buf); }

        // Normal exit: return the user main's result (or void).
        this.builder.position_at_end(cont_bb);
        const ret_ty: LType = LType { raw: llvm::LLVMGetReturnType(fn_type.raw) };
        if (LType::kind_of(ret_ty.raw) == LTypeKind::Void) {
            this.builder.build_ret_void();
        } else {
            this.builder.build_ret(r);
        }

        // Uncaught panic reached the root: catch-all, report + exit 101.
        this.builder.position_at_end(lpad_bb);
        const lpad_ty: LType = this.expr_ops.landingpad_type();
        const lp: LValue = this.builder.build_landing_pad(lpad_ty, 1, "eh");
        lp.add_clause(LType::const_pointer_null(LType::pointer_to(LType::i8())));
        const finish_fn: LValue = this.get_or_decl_panic_finish();
        const finish_ty: LType = LType::function_type(LType::void_type(), null, 0, false);
        this.builder.build_call(finish_ty, finish_fn, null, 0, "");
        this.builder.build_unreachable();

        if (saved_bb.is_valid()) { this.builder.position_at_end(saved_bb); }
    }

    /// Emit implicit void return ONLY for void/unit functions.
    /// Non-void functions must have explicit returns from the source code.
    /// If a non-void function's block has no terminator, body generation
    /// failed; the caller will strip it back to a declare.
    ///
    /// `never` is the exception: it declares that control does not leave the
    /// function normally, so falling off the end is unreachable rather than a
    /// missing `return`.  The compiler cannot verify the claim - the divergent
    /// primitives a `never` body ends in (`sys::exit`, `abort`) are typed
    /// `void` - so the annotation is taken at its word, exactly as the call
    /// side already does when it emits `unreachable` after a `never`-returning
    /// call.  Without this the block stays unterminated and the body validator
    /// discards the whole function.
    codegen_function_epilogue(mut &this, node: FunctionDeclNode*) -> void {
        const current_bb: LBasicBlock = this.builder.get_insert_block();
        if (current_bb.is_valid() && !current_bb.has_terminator()) {
            const ret_ty: TypeRef = node.resolved_return_type;
            mut is_void: boolean = ret_ty.is_invalid();
            mut is_never: boolean = false;
            if (!is_void) {
                const t: Type* = this.lookup_type_by_id(ret_ty.id);
                is_void = t != null && (t.kind == TypeKind::Void || t.kind == TypeKind::Unit);
                is_never = t != null && t.kind == TypeKind::Never;
            }
            if (is_void) {
                this.expr_ops.emit_va_end_if_variadic(CodegenUtil::variadic_param_name(node));
                this.builder.build_ret_void();
            } else if (is_never) {
                this.expr_ops.emit_va_end_if_variadic(CodegenUtil::variadic_param_name(node));
                this.builder.build_unreachable();
            }
            // Other non-void: intentionally leave unterminated. The caller
            // detects this and strips the function body.
        }

        // Sweep orphaned blocks that body codegen left unterminated.
        // The classic source is the merge block of an infinite `loop { ... }`
        // (no `break`, so nothing branches into `loop.end`); the same shape
        // appears for any control-flow scaffolding that creates a join block
        // that ends up unused.  Without this fixup the function-body
        // validator strips the WHOLE body to a declare, producing silent
        // link-time `undefined reference` errors.
        //
        // Two unterminated-but-dead shapes need terminating:
        //   (a) the block is empty (a pure join scaffold), or
        //   (b) the block has NO predecessors (nothing branches to it) yet
        //       still holds instructions - e.g. `loop.end` after an infinite
        //       loop, into which end-of-scope drop glue for an owning local
        //       was emitted.  These are unreachable, so `unreachable` is a
        //       no-op for any real path.
        // A reachable block left unterminated (a genuine missing `return` in
        // a non-void function) HAS predecessors and is intentionally left
        // alone so the validator strips the body.  The entry block is never
        // swept on the no-predecessor rule: it has no predecessors by
        // definition but is reachable as the function entry.
        const fn_val: LValue = this.builder.get_insert_block().get_parent();
        if (fn_val.is_valid()) {
            const entry_bb: void* = llvm::LLVMGetEntryBasicBlock(fn_val.raw);
            mut bb: void* = llvm::LLVMGetFirstBasicBlock(fn_val.raw);
            while (bb != null) {
                const lbb: LBasicBlock = LBasicBlock { raw: bb };
                if (!lbb.has_terminator()) {
                    const is_empty: boolean = llvm::LLVMGetFirstInstruction(bb) == null;
                    mut no_preds: boolean = false;
                    if (bb != entry_bb) {
                        const bb_val: void* = llvm::LLVMBasicBlockAsValue(bb);
                        no_preds = llvm::LLVMGetFirstUse(bb_val) == null;
                    }
                    if (is_empty || no_preds) {
                        this.builder.position_at_end(lbb);
                        this.builder.build_unreachable();
                    }
                }
                bb = llvm::LLVMGetNextBasicBlock(bb);
            }
        }

        this.values.clear_persistent();
        this.values.pop_scope();
    }

    /// Generate function prologue for a method.  Prepends `this` parameter binding.
    codegen_method_prologue(mut &this, node: MethodNode*, target_type: SymbolStr) -> LValue {
        const func: FunctionDeclNode* = node.func;
        if (func == null) { return LValue::null(); }

        const intern: InternTable* = this.get_intern();
        const type_str: string = intern.resolve(target_type);
        const method_str: string = intern.resolve(func.name);
        const combined: string = format("%s::%s", type_str, method_str);
        const combined_sym: SymbolStr = intern.intern(combined);

        // Recompute the mangled name from THIS overload's parameter types so
        // overloaded methods (e.g., BaseASTVisitor's 62 `visit(...)` overrides)
        // resolve to their own LLVM function rather than all mapping to the
        // first-declared overload via the ambiguous combined key.  Must mirror
        // the computation in `declare_method` exactly.
        const arena: TypeArena* = this.get_arena();
        const type_qname: QualifiedName = QualifiedName::from_symbol(target_type);
        const recv_kind: ReceiverKind = DeclarationIndex::method_receiver_kind(func, node.is_static, intern);
        const method_param_refs: TypeRef[] = DeclarationIndex::method_non_receiver_params(func, intern);
        const computed_base: MangledName = MangledName::for_method_or_trait_impl(
            intern, arena, type_qname, func.origin_trait, func.name, recv_kind,
            method_param_refs, func.resolved_return_type, func.is_variadic);
        // Mirror declare_method's `$MG...` spec-args disambiguator exactly.
        const computed: MangledName = computed_base.with_method_spec_args(
            intern, arena, func.spec_type_args);
        const mangled_sym: SymbolStr = computed.value;

        // Prefer mangled_sym for overload-correct lookup; fall back to the
        // combined key for paths that only registered the non-overloaded form.
        mut fn_val: LValue = this.resolver.resolve_function(mangled_sym);
        if (!fn_val.is_valid()) {
            fn_val = this.resolver.resolve_function(combined_sym);
        }
        if (!fn_val.is_valid()) {
            // declare_method should have produced an LLVM declare for this
            // method.  When it didn't (e.g. cross-module trait impls whose
            // target lookup misses, or primitive impls whose target qualify
            // resolves to a name DI doesn't know), the body simply can't
            // land.  Emit a warning rather than an error so the build
            // continues; calls to this method will surface as undefined
            // references at link time, which is the correct visibility
            // outcome until the upstream declare path is fixed.
            this.diag.emit_warning_at_span(ErrorCode::E0619_METHOD_GENERATION_ERROR,
                format("codegen: method '%s::%s' has no LLVM declaration in this module; body skipped (declare_method should have produced one). Calls to this method will fail at link time.",
                    type_str, method_str),
                func.span);
            return LValue::null();
        }

        const entry_bb: LBasicBlock = LBasicBlock::append(fn_val, "entry");
        this.builder.position_at_end(entry_bb);

        this.values.push_scope();

        // Phase 1: if this method was declared with sret, LLVM
        // parameter slot 0 is the hidden result pointer and the
        // *real* parameters (including `this`) start at index 1.
        // `codegen_return` reads the sret slot via LLVMGetParam(fn, 0)
        // independently; here we only need to offset the receiver/
        // user-param binding loop.
        const is_sret_method: boolean = this.abi.sret_pointee_of(fn_val).is_valid();
        const sret_off: u32 = if (is_sret_method) { 1 } else { 0 } as u32;

        // Detect which of the three self forms (if any) this method uses.
        //   `&this` / `mut &this`: param named "&this", semantically a T*
        //   `this`               : param named "this", semantically a by-value T
        //   (none)               : implicit `&this`; `declare_method` synthesized
        //                           a leading T* in the LLVM function signature
        // The LLVM parameter layout depends on which case we're in; matches the
        // logic in declare_method so named_values and LLVM params line up.
        mut explicit_ref_idx: i64 = -1;    // parameters[i] is "&this"
        mut explicit_val_idx: i64 = -1;    // parameters[i] is bare "this" (by-value self)
        mut explicit_typed_idx: i64 = -1;  // parameters[i] is "this: T*" (user-typed self)
        for (mut pc: i64 = 0; pc < func.parameters.length; pc++) {
            const pp: VarDeclNode* = func.parameters[pc];
            if (pp == null) { continue; }
            const pn: string = this.resolve(pp.name);
            if (pn == "&this") { explicit_ref_idx = pc; break; }
            if (pn.eq("this")) {
                if (pp.type_annotation == null) {
                    explicit_val_idx = pc;
                } else {
                    // `this: T*`: user wrote the type out, method takes
                    // `this` as a regular typed parameter (e.g. Lexer's
                    // helper methods that use this convention).
                    explicit_typed_idx = pc;
                }
                break;
            }
        }

        mut param_idx: u32 = 0 + sret_off;

        // Bind `this` for instance methods.  All three forms produce a `this`
        // named-value that's a pointer to the struct; for by-value `this` we
        // alloca+store the struct so member-access GEPs work the same way.
        if (!node.is_static) {
            const qualified_target: SymbolStr = this.ctx.qualify_symbol_sym(target_type);
            mut target_ref: TypeRef = this.ctx.decl_index.lookup_type(qualified_target);
            if (target_ref.is_invalid()) {
                target_ref = this.ctx.decl_index.lookup_type(target_type);
            }
            if (target_ref.is_invalid()) {
                // Unit-target impls (`implement trait Drop for ()`):
                // unit type lives in the arena, not the DeclarationIndex.
                // Detected by the literal `()` suffix on the qualified target
                // name; mirrors the fallback in declare_method.
                const target_str: string = this.resolve(target_type);
                const tlen: u64 = target_str.length();
                if (tlen >= 2 && target_str[tlen - 2] == 0x28 /* '(' */
                              && target_str[tlen - 1] == 0x29 /* ')' */) {
                    target_ref = this.get_arena().get_unit();
                }
            }
            if (target_ref.is_invalid()) {
                const ts: string = this.resolve(target_type);
                const ms: string = this.resolve(func.name);
                this.diag.emit_error_at_span(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    format("codegen: method '%s::%s': target type '%s' not found in declaration index", ts, ms, ts),
                    func.span);
                this.values.pop_scope();
                return LValue::null();
            }

            const this_sym: SymbolStr = this.intern_str("this");
            // LLVM index for the receiver is `sret_off` (0 normally, 1 when sret).
            const arg0: LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, sret_off) };

            // Number of LLVM slots the receiver occupies, so the user-param
            // loop below starts at the right index.  Default 1 (a pointer for
            // `&this`/typed, a single coerced value for a small by-value `this`).
            mut recv_slots: u32 = 1;
            if (explicit_val_idx >= 0) {
                // By-value `this`: alloca it so downstream code (member access,
                // method calls) can treat `this` as a pointer uniformly.  The
                // receiver follows the same ABI as any by-value parameter: a
                // `byval` pointer (>16 bytes), a `DirectPair` (9-16 bytes, two
                // LLVM slots), or a single coerced/Direct slot (<= 8 bytes).
                // Chaining makes the receiver an adapter that exceeds 8 bytes
                // (`TakeIter<TakeIter<...>>`), so handling only the single-slot
                // case dropped the receiver's upper half and corrupted `this`.
                const target_mapped: LType = this.type_mapper.map_type(target_ref);
                if (!target_mapped.is_valid()) {
                    this.diag.emit_warning_at_span(ErrorCode::E0609_TYPE_MAPPING_ERROR,
                        format("codegen: method '%s::%s': could not lower the by-value `this` type to LLVM; body skipped. Calls to this method will fail at link time.",
                            type_str, method_str),
                        func.span);
                    this.values.pop_scope();
                    return LValue::null();
                }
                const recv_byval_pointee: LType =
                    this.abi.byval_pointee_of_param(fn_val, sret_off);
                if (recv_byval_pointee.is_valid()) {
                    // byval: the LLVM param IS a pointer to the receiver struct;
                    // bind it directly (copy semantics already handled by the ABI).
                    this.values.set(this_sym, arg0);
                    recv_slots = 1;
                } else {
                    const recv_plan: ParamPlan = this.abi.classify_param(target_ref);
                    if (recv_plan.cls == ArgClass::DirectPair
                            && recv_plan.llvm_slots.length == 2) {
                        const slot: LValue = this.flow.create_entry_alloca(
                            fn_val, "this", target_mapped);
                        const lo_arg: LValue = LValue {
                            raw: llvm::LLVMGetParam(fn_val.raw, sret_off) };
                        const hi_arg: LValue = LValue {
                            raw: llvm::LLVMGetParam(fn_val.raw, sret_off + 1) };
                        this.builder.build_store(lo_arg, slot);
                        const i8_ty: LType = LType::i8();
                        const idx_buf: void* = intrinsics::malloc(8);
                        const idx_slots: void** = idx_buf as void**;
                        const eight: LValue = LType::const_int(LType::i64(), 8, false);
                        idx_slots[0] = eight.raw;
                        const hi_ptr: LValue = this.builder.build_gep(
                            i8_ty, slot, idx_buf, 1, "this.hi.ptr");
                        intrinsics::free(idx_buf);
                        this.builder.build_store(hi_arg, hi_ptr);
                        this.values.set(this_sym, slot);
                        recv_slots = 2;
                    } else {
                        const slot: LValue = this.flow.create_entry_alloca(
                            fn_val, "this", target_mapped);
                        this.builder.build_store(arg0, slot);
                        this.values.set(this_sym, slot);
                        recv_slots = 1;
                    }
                }
            } else if (explicit_typed_idx >= 0) {
                // User-typed `this: T*`: LLVM param 0 is whatever the
                // annotation resolves to (typically a ptr).  Bind `this`
                // directly to that value, same as the `&this` path.
                this.values.set(this_sym, arg0);
            } else {
                // `&this` (explicit or implicit): LLVM param 0 is already a ptr.
                // Store the raw pointer directly in named_values (no alloca).
                this.values.set(this_sym, arg0);
            }

            param_idx = recv_slots + sret_off;
        }

        // Bind the remaining user parameters.  Skip whichever self form this
        // method uses (we already handled it above).  Cap iteration at the
        // fixed-param count so a trailing `args...` bucket doesn't try to pull
        // an LLVM param that doesn't exist.
        const fixed_count: u32 = CodegenUtil::fixed_param_count(func);
        for (mut i: u32 = 0; i < fixed_count; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null) { continue; }
            if (i as i64 == explicit_ref_idx) { continue; }
            if (i as i64 == explicit_val_idx) { continue; }
            if (i as i64 == explicit_typed_idx) { continue; }

            const param_name: string = this.resolve(param.name);
            const param_ty: LType = this.type_mapper.map_type(param.resolved_type);
            if (!param_ty.is_valid()) {
                this.diag.emit_warning_at_span(ErrorCode::E0642_PARAM_TYPE_ERROR,
                    format("codegen: method '%s::%s', parameter '%s': could not lower its type to LLVM; body skipped. Calls to this method will fail at link time.",
                        type_str, method_str, param_name),
                    if (param != null) { param.span } else { func.span });
                this.values.pop_scope();
                return LValue::null();
            }

            // Phase 2 - byval on a method's non-receiver param: see
            // `codegen_function_prologue` for the rationale.  Binding
            // the byval `ptr` directly preserves the copy semantics
            // and matches the LLVM signature.
            const byval_pointee_m: LType =
                this.abi.byval_pointee_of_param(fn_val, param_idx);
            if (byval_pointee_m.is_valid()) {
                const arg: LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, param_idx) };
                this.values.set(param.name, arg);
                param_idx += 1;
                continue;
            }

            // DirectPair: two LLVM slots, store lo at +0 and hi at +8
            // of a source-typed alloca.  Other Direct shapes (<= 8 byte
            // coerced and plain) use a single slot.
            const pplan_m: ParamPlan = this.abi.classify_param(param.resolved_type);
            if (pplan_m.cls == ArgClass::DirectPair
                    && pplan_m.llvm_slots.length == 2) {
                const alloca: LValue = this.flow.create_entry_alloca(
                    fn_val, param_name, param_ty);
                const lo_arg: LValue = LValue {
                    raw: llvm::LLVMGetParam(fn_val.raw, param_idx),
                };
                const hi_arg: LValue = LValue {
                    raw: llvm::LLVMGetParam(fn_val.raw, param_idx + 1),
                };
                this.builder.build_store(lo_arg, alloca);
                const i8_ty: LType = LType::i8();
                const idx_buf: void* = intrinsics::malloc(8);
                const idx_slots: void** = idx_buf as void**;
                const eight: LValue = LType::const_int(LType::i64(), 8, false);
                idx_slots[0] = eight.raw;
                const hi_ptr: LValue = this.builder.build_gep(
                    i8_ty, alloca, idx_buf, 1, "param.hi.ptr");
                intrinsics::free(idx_buf);
                this.builder.build_store(hi_arg, hi_ptr);
                this.values.set(param.name, alloca);
                param_idx += 2;
                continue;
            }

            const arg: LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, param_idx) };
            const alloca: LValue = this.flow.create_entry_alloca(fn_val, param_name, param_ty);
            this.builder.build_store(arg, alloca);
            this.values.set(param.name, alloca);
            param_idx += 1;
        }

        return fn_val;
    }

    /// Map a function's return type to an LLVMType.
    map_return_type(mut &this, node: FunctionDeclNode*) -> LType {
        if (node.resolved_return_type.is_invalid()) {
            return LType::void_type();
        }

        const t: Type* = this.lookup_type_by_id(node.resolved_return_type.id);
        if (t == null || t.kind == TypeKind::Void || t.kind == TypeKind::Unit) {
            return LType::void_type();
        }

        return this.type_mapper.map_type(node.resolved_return_type);
    }

    // Intrinsics codegen.  Inline-lowers calls to compiler-recognized
    // intrinsics (ptr arithmetic, sext/zext, rotates, abort, panic, ...
    // dispatched by name through `try_emit_intrinsic_call`).

    auto_deref_to(mut &this, val: LValue, expected: LType) -> LValue {
        if (!val.is_valid() || !expected.is_valid()) { return val; }
        const actual_ty: void* = llvm::LLVMTypeOf(val.raw);
        if (actual_ty == null) { return val; }
        if (LType::kind_of(actual_ty) == LTypeKind::Pointer) {
            return this.builder.build_load(expected, val, "deref");
        }
        return val;
    }


    /// Fold a float-typed const initializer expression to an `f64` constant:
    /// float/integer literals, unary `-`/`+`, and binary `+ - * /`. Returns
    /// false for anything outside that set (identifiers, calls, etc.), which the
    /// caller leaves on the zeroinitializer fallback. Mirrors sema's
    /// `try_fold_const_i64` but in `f64` (IEEE saturates, so no overflow guards).
    /// This is what makes `const F64_MIN: f64 = -1.79e308;` carry its real value
    /// instead of silently becoming 0.0.
    static try_fold_const_real(expr: ExpressionNode*, out: f64*) -> boolean {
        if (expr == null) { return false; }
        const node: ASTNode* = expr as ASTNode*;
        if (node.kind == NodeKind::Literal) {
            const lit: LiteralNode* = expr as LiteralNode*;
            if (lit.literal_kind == LiteralKind::Float) {
                *out = float::parse_f64(lit.value).unwrap_or(0.0);
                return true;
            }
            if (lit.literal_kind == LiteralKind::Integer) {
                const iv: u64 = lit.value.parse_int<u64>();
                *out = iv as f64;
                return true;
            }
            return false;
        }
        if (node.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = expr as UnaryExprNode*;
            mut a: f64 = 0.0;
            if (!DeclarationEmitter::try_fold_const_real(u.operand, &a)) { return false; }
            if (u.op.lexeme == "-") { *out = 0.0 - a; return true; }
            if (u.op.lexeme == "+") { *out = a; return true; }
            return false;
        }
        if (node.kind == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = expr as BinaryExprNode*;
            mut x: f64 = 0.0;
            mut y: f64 = 0.0;
            if (!DeclarationEmitter::try_fold_const_real(b.left, &x)) { return false; }
            if (!DeclarationEmitter::try_fold_const_real(b.right, &y)) { return false; }
            const op: string = b.op.lexeme;
            if (op == "+") { *out = x + y; return true; }
            if (op == "-") { *out = x - y; return true; }
            if (op == "*") { *out = x * y; return true; }
            if (op == "/") { *out = x / y; return true; }
            return false;
        }
        return false;
    }

    /// Constant-fold an INTEGER const initializer to its 64-bit two's-complement
    /// bit pattern.  Handles integer/bool literals, unary `-`/`+`/`~`, and the
    /// binary operators that are bit-exact in two's complement regardless of
    /// signedness (`+ - * << & | ^`).  Sign-dependent operators (`>> / %`) and
    /// anything else (identifiers, calls) return false, leaving the caller on
    /// the zeroinitializer fallback - so the folder is correct-or-decline, never
    /// silently wrong.  Computing in u64 keeps every accepted operation
    /// well-defined wrapping (codegen emits plain LLVMBuildAdd/Sub/Mul) and
    /// bit-identical to the signed result, which is what makes
    /// `const EOF: i32 = -1;` carry 0xFFFFFFFF instead of silently becoming 0.
    static try_fold_const_int(expr: ExpressionNode*, out: u64*) -> boolean {
        if (expr == null) { return false; }
        const node: ASTNode* = expr as ASTNode*;
        if (node.kind == NodeKind::Literal) {
            const lit: LiteralNode* = expr as LiteralNode*;
            if (lit.literal_kind == LiteralKind::Integer) {
                *out = lit.value.parse_int<u64>();
                return true;
            }
            if (lit.literal_kind == LiteralKind::Boolean) {
                *out = if (lit.value == "true") { 1 } else { 0 };
                return true;
            }
            return false;
        }
        if (node.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = expr as UnaryExprNode*;
            mut a: u64 = 0;
            if (!DeclarationEmitter::try_fold_const_int(u.operand, &a)) { return false; }
            const op: string = u.op.lexeme;
            if (op == "-") { *out = 0 - a; return true; }
            if (op == "+") { *out = a;        return true; }
            if (op == "~") { *out = ~a;       return true; }
            return false;
        }
        if (node.kind == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = expr as BinaryExprNode*;
            mut x: u64 = 0;
            mut y: u64 = 0;
            if (!DeclarationEmitter::try_fold_const_int(b.left, &x)) { return false; }
            if (!DeclarationEmitter::try_fold_const_int(b.right, &y)) { return false; }
            const op: string = b.op.lexeme;
            if (op == "+")  { *out = x + y;  return true; }
            if (op == "-")  { *out = x - y;  return true; }
            if (op == "*")  { *out = x * y;  return true; }
            if (op == "&")  { *out = x & y;  return true; }
            if (op == "|")  { *out = x | y;  return true; }
            if (op == "^")  { *out = x ^ y;  return true; }
            if (op == "<<") { *out = x << y; return true; }
            return false;
        }
        return false;
    }

    /// Build a constant struct aggregate for a module-level struct-literal const
    /// initializer (`const RAYWHITE: Color = Color { r: 245, ... }`, the shape
    /// the bindgen importer lowers a C compound-literal macro to).  The importer
    /// emits the field initializers in struct DECLARATION order, so a positional
    /// zip against the LLVM struct's element types is exact.  Every field init
    /// must fold to a scalar constant (`try_fold_const_int`/`try_fold_const_real`);
    /// any non-constant field, or a field-count mismatch (an unexpected shape),
    /// returns an invalid value so the caller declines to the zeroinitializer
    /// fallback - correct-or-decline, never a silently wrong layout.
    /// `layout` is the Cryo type whose field list `sl` initializes, so a field
    /// can be placed at the element that actually holds it: a body may carry
    /// alignment padding elements the field list has no member for.  Padding
    /// elements are zero-filled.  A body with a DIFFERENT element count than
    /// fields-plus-padding is an unexpected shape and declines, as before -
    /// but the count alone can no longer decide, because padding makes a
    /// correct body wider than its field list.
    static try_const_struct(mapper: TypeMapper*, layout: Type*,
                            sl: StructLiteralNode*, ty: LType) -> LValue {
        const n: u32 = llvm::LLVMCountStructElementTypes(ty.raw);
        if (n == 0 || mapper == null || layout == null) { return LValue::null(); }
        // Every field initialized, in declaration order - the shape the
        // importer emits.  A partial literal still declines: filling only some
        // fields here would silently define the rest as zero.
        mut field_count: i64 = -1;
        if (layout.kind == TypeKind::Struct) { field_count = (layout as StructType*).fields.length; }
        else if (layout.kind == TypeKind::Class) { field_count = (layout as ClassType*).fields.length; }
        if (field_count < 0 || sl.field_inits.length != field_count) { return LValue::null(); }
        const buf: void* = intrinsics::malloc((n as u64) * 8);
        const slots: void** = buf as void**;
        // Zero every element first, so any padding element is a well-formed
        // constant even though no field initializer names it.
        mut ok: boolean = true;
        for (mut z: u32 = 0u32; z < n; z++) {
            const zty: void* = llvm::LLVMStructGetTypeAtIndex(ty.raw, z);
            const zval: LValue = LType::const_null(LType { raw: zty });
            if (!zval.is_valid()) { ok = false; break; }
            slots[z as i64] = zval.raw;
        }
        for (mut i: u32 = 0u32; ok && i < sl.field_inits.length as u32; i++) {
            const elem: i64 = mapper.field_element_index(layout, i as i64);
            if (elem < 0 || elem as u32 >= n) { ok = false; break; }
            const fty_raw: void* = llvm::LLVMStructGetTypeAtIndex(ty.raw, elem as u32);
            const fty: LType = LType { raw: fty_raw };
            const fk: LTypeKind = LType::kind_of(fty_raw);
            const fexpr: ExpressionNode* = sl.field_inits[i as i64].value;
            mut slot: LValue = LValue::null();
            if (fk == LTypeKind::Integer) {
                mut iv: u64 = 0;
                if (DeclarationEmitter::try_fold_const_int(fexpr, &iv)) {
                    slot = LType::const_int(fty, iv, true);
                }
            } else if (fk == LTypeKind::Float || fk == LTypeKind::Double) {
                mut fv: f64 = 0.0;
                if (DeclarationEmitter::try_fold_const_real(fexpr, &fv)) {
                    slot = LType::const_real(fty, fv);
                }
            }
            if (!slot.is_valid()) { ok = false; break; }
            slots[elem] = slot.raw;
        }
        if (!ok) { intrinsics::free(buf); return LValue::null(); }
        const v: LValue = LType::const_named_struct(ty, buf, n);
        intrinsics::free(buf);
        return v;
    }
}
