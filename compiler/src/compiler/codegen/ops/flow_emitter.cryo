/// IR Flow Emitter
///
/// Control-flow IR primitives: `if`/`while`/`for`/`loop` block layouts,
/// `break`/`continue` jumps to the current loop's targets, terminator
/// guards, and entry-block `alloca` hoisting (for LLVM's `mem2reg`).
///
/// Borrows the LLVM builder and the per-context loop stack via back-
/// pointers set by `CodegenContext::wire()`.  Holds no owned state.

namespace Compiler::Codegen::Ops::IRFlowEmitter;

import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Codegen::State::LoopStack;


// Block-result structs returned by the control-flow primitives.
// Kept top-level (a method can't return a type defined inside its struct)
// so that visit() overrides can name the type when destructuring.

type struct IfBlocks {
    then_bb:  LBasicBlock;
    else_bb:  LBasicBlock;
    merge_bb: LBasicBlock;
}

type struct LoopBlocks {
    cond_bb:  LBasicBlock;
    body_bb:  LBasicBlock;
    merge_bb: LBasicBlock;
}

type struct ForBlocks {
    cond_bb:   LBasicBlock;
    body_bb:   LBasicBlock;
    update_bb: LBasicBlock;
    merge_bb:  LBasicBlock;
}


type struct IRFlowEmitter {
    // Back-pointers set by wire().  Null until wire() runs.
    builder: LBuilder*;
    loops:   LoopStack*;

    /// Stage 1 of two-phase init.  Produces an IRFlowEmitter with null
    /// back-pointers; the parent calls `wire()` once it is at its stable
    /// (heap) address.
    static null() -> IRFlowEmitter {
        return IRFlowEmitter {
            builder: null,
            loops:   null,
        };
    }

    /// Stage 2 of two-phase init.  Stores the back-pointers.  Must be
    /// called from `CodegenContext::wire()` after the context is at its
    /// stable address (e.g. after `Box::leak()`).
    wire(mut &this, builder: LBuilder*, loops: LoopStack*) -> void {
        this.builder = builder;
        this.loops   = loops;
    }


    // Loop control

    codegen_break(mut &this) -> void {
        const target: LBasicBlock = this.loops.current_break();
        if (target.is_valid()) {
            this.builder.build_br(target);
        }
    }

    codegen_continue(mut &this) -> void {
        const target: LBasicBlock = this.loops.current_continue();
        if (target.is_valid()) {
            this.builder.build_br(target);
        }
    }

    /// Branch to a target block if the current block has no terminator.
    branch_if_not_terminated(mut &this, target: LBasicBlock) -> void {
        const current: LBasicBlock = this.builder.get_insert_block();
        if (current.is_valid() && !current.has_terminator()) {
            this.builder.build_br(target);
        }
    }


    // Control-flow shapes

    /// Generate IR for an if/else statement.  Creates then_bb, else_bb (if
    /// needed), and merge_bb.
    codegen_if(mut &this, cond: LValue,
               current_fn: LValue,
               has_else: boolean) -> IfBlocks {
        const then_bb: LBasicBlock = LBasicBlock::append(current_fn, "then");
        const else_bb: LBasicBlock = if (has_else) {
            LBasicBlock::append(current_fn, "else")
        } else {
            LBasicBlock::null()
        };
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "ifcont");

        if (has_else) {
            this.builder.build_cond_br(cond, then_bb, else_bb);
        } else {
            this.builder.build_cond_br(cond, then_bb, merge_bb);
        }

        return IfBlocks {
            then_bb:  then_bb,
            else_bb:  else_bb,
            merge_bb: merge_bb,
        };
    }

    /// Create the basic blocks for a while loop.
    codegen_while_header(mut &this, current_fn: LValue) -> LoopBlocks {
        const cond_bb: LBasicBlock = LBasicBlock::append(current_fn, "while.cond");
        const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "while.body");
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "while.end");

        this.builder.build_br(cond_bb);
        this.loops.push(merge_bb, cond_bb);

        return LoopBlocks {
            cond_bb:  cond_bb,
            body_bb:  body_bb,
            merge_bb: merge_bb,
        };
    }

    /// Create basic blocks for a for loop: init -> cond -> body -> update -> cond.
    codegen_for_header(mut &this, current_fn: LValue) -> ForBlocks {
        const cond_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.cond");
        const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.body");
        const update_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.update");
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "for.end");

        this.loops.push(merge_bb, update_bb);

        return ForBlocks {
            cond_bb:   cond_bb,
            body_bb:   body_bb,
            update_bb: update_bb,
            merge_bb:  merge_bb,
        };
    }

    /// Create the basic blocks for a `do { ... } while (cond);` loop.  Unlike
    /// `while`, the body runs before the condition is tested, so entry jumps
    /// straight into the body; the body then falls into `cond_bb`, which loops
    /// back to the body while `cond` holds.  `break` exits to `merge_bb`;
    /// `continue` jumps to `cond_bb` (re-tests the condition, matching C).
    codegen_do_while_header(mut &this, current_fn: LValue) -> LoopBlocks {
        const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "dowhile.body");
        const cond_bb: LBasicBlock = LBasicBlock::append(current_fn, "dowhile.cond");
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "dowhile.end");

        this.builder.build_br(body_bb);          // body runs at least once
        this.loops.push(merge_bb, cond_bb);      // break->merge, continue->cond

        return LoopBlocks {
            cond_bb:  cond_bb,
            body_bb:  body_bb,
            merge_bb: merge_bb,
        };
    }

    /// Create basic blocks for a `loop { ... }` infinite loop.
    codegen_loop_header(mut &this, current_fn: LValue) -> LoopBlocks {
        const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "loop.body");
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "loop.end");

        this.builder.build_br(body_bb);
        this.loops.push(merge_bb, body_bb);

        return LoopBlocks {
            cond_bb:  LBasicBlock::null(),
            body_bb:  body_bb,
            merge_bb: merge_bb,
        };
    }


    // Entry-block alloca hoisting

    /// Create an alloca in the entry block of the given function.  This
    /// ensures allocas are hoisted to the entry block for `mem2reg`
    /// promotion by LLVM's optimization passes.
    create_entry_alloca(mut &this, func: LValue, name: string, ty: LType) -> LValue {
        if (!func.is_valid()) {
            return LValue::null();
        }
        if (!ty.is_valid()) {
            return LValue::null();
        }

        // Void is unsized; LLVMBuildAlloca crashes in DataLayout::getPrefTypeAlign.
        if (LType::kind_of(ty.raw) == LTypeKind::Void) {
            return LValue::null();
        }

        const saved_block: LBasicBlock = this.builder.get_insert_block();

        const entry: LBasicBlock = LBasicBlock { raw: llvm::LLVMGetEntryBasicBlock(func.raw) };
        if (!entry.is_valid()) {
            return LValue::null();
        }
        // If the entry block already has a terminator (e.g., the function
        // body has emitted a `br`/`ret`), `position_at_end(entry)` would
        // insert AFTER that terminator, breaking the block.  Position
        // BEFORE the terminator in that case so every alloca lands in a
        // well-formed entry block regardless of when the helper is called.
        const term: void* = llvm::LLVMGetBasicBlockTerminator(entry.raw);
        if (term != null) {
            llvm::LLVMPositionBuilderBefore(this.builder.raw, term);
        } else {
            this.builder.position_at_end(entry);
        }

        const alloca: LValue = this.builder.build_alloca(ty, name);

        if (saved_block.is_valid()) {
            this.builder.position_at_end(saved_block);
        }

        return alloca;
    }

    /// Entry-block slot for a compiler-synthesized temporary, resolving the
    /// enclosing function from the builder's current position.  An alloca is
    /// only reclaimed when its function returns, never at the end of the block
    /// that emitted it, so a slot built at the insert point costs a fresh one
    /// per iteration when the expression sits in a loop body: the frame grows
    /// without bound and a loop that runs long enough overflows the stack.
    /// Hoisting to the entry block gives every iteration the same slot, which
    /// is safe wherever the store precedes every read of it within an
    /// iteration - true of a materialized rvalue, whose lifetime ends with the
    /// statement that created it.  Falls back to an in-place alloca when the
    /// insert block has no parent function, there being no entry block to
    /// hoist into; the slot is then per-iteration but still correct.
    temp_slot(mut &this, ty: LType, name: string) -> LValue {
        const bb: LBasicBlock = this.builder.get_insert_block();
        if (bb.is_valid()) {
            const fn: LValue = bb.get_parent();
            if (fn.is_valid()) {
                const slot: LValue = this.create_entry_alloca(fn, name, ty);
                if (slot.is_valid()) { return slot; }
            }
        }
        return this.builder.build_alloca(ty, name);
    }

    /// Store a zeroinitializer into `alloca` in the function ENTRY block, so
    /// the slot reads a defined value on every path - including paths that
    /// never reach the declaring statement.  Used for synthesized
    /// conditional-drop flags: their decl (with its `store false`) can sit
    /// inside a conditional arm, but the flag is read at an outer scope that
    /// other arms also reach; an entry-block default of `false`
    /// ("not moved -> drop fires; the drop glue then tag-guards") keeps the
    /// read defined and the semantics correct.  Positions before the entry
    /// terminator when present, mirroring create_entry_alloca.
    zero_init_in_entry(mut &this, func: LValue, alloca: LValue, ty: LType) -> void {
        if (!func.is_valid() || !alloca.is_valid() || !ty.is_valid()) { return; }
        const saved_block: LBasicBlock = this.builder.get_insert_block();
        const entry: LBasicBlock = LBasicBlock { raw: llvm::LLVMGetEntryBasicBlock(func.raw) };
        if (!entry.is_valid()) { return; }
        const term: void* = llvm::LLVMGetBasicBlockTerminator(entry.raw);
        if (term != null) {
            llvm::LLVMPositionBuilderBefore(this.builder.raw, term);
        } else {
            this.builder.position_at_end(entry);
        }
        this.builder.build_store(LType::const_null(ty), alloca);
        if (saved_block.is_valid()) {
            this.builder.position_at_end(saved_block);
        }
    }
}
