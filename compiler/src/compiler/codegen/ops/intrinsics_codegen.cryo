/// Intrinsic Codegen
///
/// Inline-lowering for the bare-name intrinsics declared in
/// `stdlib/core/intrinsics.cryo`.  Each call is emitted directly as the
/// equivalent LLVM IR rather than routed through a runtime helper, so the
/// produced binary has no separate C runtime dependency for these
/// primitives.
///
/// Layout:
///   - `IntrinsicKind`:          one variant per recognized intrinsic.
///   - `lookup_intrinsic_kind`:  name to kind (single source of truth).
///   - `try_emit_intrinsic_call`: kind-driven LLVM IR emission.
///
/// Adding a new intrinsic: add an enum variant, one row in
/// `lookup_intrinsic_kind`, one match arm in the dispatcher.

namespace Compiler::Codegen::Ops::IntrinsicsCodegen;

import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Codegen::Util;
import std::collections::pair;


// ============================================================================
// IntrinsicKind: every intrinsic the dispatcher knows how to emit
// ============================================================================

type enum IntrinsicKind {
    NotIntrinsic;            // sentinel: unrecognized name

    // Pointer arithmetic
    PtrAdd; PtrSub; PtrDiff;

    // Signed integer widening (sext)
    SExt8To16; SExt8To32; SExt8To64;
    SExt16To32; SExt16To64;
    SExt32To64;

    // Signed integer narrowing (trunc); same primitive used for unsigned
    Trunc64To32; Trunc64To16; Trunc64To8;
    Trunc32To16; Trunc32To8;
    Trunc16To8;

    // Unsigned integer widening (zext)
    ZExt8To16; ZExt8To32; ZExt8To64;
    ZExt16To32; ZExt16To64;
    ZExt32To64;

    // Unsigned narrowing: distinct variants so the dispatcher's name-to-IR
    // mapping stays explicit; emitted IR is the same `trunc`.
    UTrunc64To32; UTrunc64To16; UTrunc64To8;
    UTrunc32To16; UTrunc32To8;
    UTrunc16To8;

    // Same-width sign conversions (no-op IR; LLVM doesn't distinguish
    // signed from unsigned at the type level).  Split by width so the
    // auto-deref step loads the correct number of bits when the caller
    // passes `&this`.
    SignBitcast8;
    SignBitcast32;
    SignBitcast64;

    // Float widening / narrowing
    FpExt32To64; FpTrunc64To32;

    // Signed int → float
    SiToF32; SiToF64Fromi32; SiToF64Fromi64;

    // Unsigned int → float
    UiToF32; UiToF64Fromu32; UiToF64Fromu64;

    // Float → signed int
    FpToSi32Fromf32; FpToSi32Fromf64; FpToSi64Fromf64;

    // Float → unsigned int
    FpToUi32Fromf32; FpToUi32Fromf64; FpToUi64Fromf64;

    // Bit operations (LLVM intrinsics)
    Bswap16; Bswap32; Bswap64;
    Popcount32; Popcount64;
    Clz32; Clz64; Ctz32; Ctz64;
    Rotl32; Rotl64; Rotr32; Rotr64;

    // Memory ordering: `fence seq_cst`.  The order argument is accepted
    // for ABI compatibility but always lowered as SequentiallyConsistent.
    AtomicFence;

    // Float predicate: `(x - x) == 0` is true iff x is finite (NaN and
    // ±inf both produce NaN in `x - x`, and NaN compares unequal to 0).
    IsFinite;

    // Linux dirent struct field accessors.  Layout assumed: d_type at
    // offset 18 (i8), d_name at offset 19 (char[256]).  Matches glibc.
    DirentName;
    DirentType;

    // `intrinsic function panic(message: string, file: string, line: u32)`:
    // direct call to the `@panic` runtime symbol emitted by
    // `emit_panic_runtime`.  Callers like `core::panic::panic` invoke
    // `intrinsics::panic(...)` to reach the runtime; without this
    // intrinsic kind the ScopeResolution callee path resolves
    // `intrinsics::panic` back through bare-name lookup, which finds
    // the wrapper `core::panic::panic` in the same module and produces
    // an infinite-recursion call.  Always followed by `unreachable`
    // since panic diverges (`@panic` body is `abort(); unreachable`).
    Panic;

    // Variadic-argument pluck: `va_arg_*(va: void*) -> T`.  Each lowers to
    // a single LLVM `va_arg` instruction reading the next argument of the
    // matching width from the va_list `va` points at.  Only the C-promoted
    // scalar set is exposed (i8/i16/bool promote to i32, f32 to f64 in a
    // variadic call), so there is no VaArg{I8,I16,F32,Bool} variant.
    VaArgI32; VaArgU32; VaArgI64; VaArgU64; VaArgF64; VaArgPtr; VaArgString;
}


// ============================================================================
// Name → kind (single source of truth)
// ============================================================================

function lookup_intrinsic_kind(name: string) -> IntrinsicKind {
    return match (name) {
        // Pointer arithmetic
        "ptr_add"  => { IntrinsicKind::PtrAdd }
        "ptr_sub"  => { IntrinsicKind::PtrSub }
        "ptr_diff" => { IntrinsicKind::PtrDiff }

        // Signed widening
        "i8_to_i16"  => { IntrinsicKind::SExt8To16 }
        "i8_to_i32"  => { IntrinsicKind::SExt8To32 }
        "i8_to_i64"  => { IntrinsicKind::SExt8To64 }
        "i16_to_i32" => { IntrinsicKind::SExt16To32 }
        "i16_to_i64" => { IntrinsicKind::SExt16To64 }
        "i32_to_i64" => { IntrinsicKind::SExt32To64 }

        // Signed narrowing
        "i64_to_i32" => { IntrinsicKind::Trunc64To32 }
        "i64_to_i16" => { IntrinsicKind::Trunc64To16 }
        "i64_to_i8"  => { IntrinsicKind::Trunc64To8 }
        "i32_to_i16" => { IntrinsicKind::Trunc32To16 }
        "i32_to_i8"  => { IntrinsicKind::Trunc32To8 }
        "i16_to_i8"  => { IntrinsicKind::Trunc16To8 }

        // Unsigned widening
        "u8_to_u16"  => { IntrinsicKind::ZExt8To16 }
        "u8_to_u32"  => { IntrinsicKind::ZExt8To32 }
        "u8_to_u64"  => { IntrinsicKind::ZExt8To64 }
        "u16_to_u32" => { IntrinsicKind::ZExt16To32 }
        "u16_to_u64" => { IntrinsicKind::ZExt16To64 }
        "u32_to_u64" => { IntrinsicKind::ZExt32To64 }

        // Unsigned narrowing
        "u64_to_u32" => { IntrinsicKind::UTrunc64To32 }
        "u64_to_u16" => { IntrinsicKind::UTrunc64To16 }
        "u64_to_u8"  => { IntrinsicKind::UTrunc64To8 }
        "u32_to_u16" => { IntrinsicKind::UTrunc32To16 }
        "u32_to_u8"  => { IntrinsicKind::UTrunc32To8 }
        "u16_to_u8"  => { IntrinsicKind::UTrunc16To8 }

        // Same-width sign conversions
        "i32_to_u32" | "u32_to_i32" => { IntrinsicKind::SignBitcast32 }
        "i64_to_u64" | "u64_to_i64" => { IntrinsicKind::SignBitcast64 }
        "i8_to_u8"   | "u8_to_i8"   => { IntrinsicKind::SignBitcast8 }

        // Float widening / narrowing
        "f32_to_f64" => { IntrinsicKind::FpExt32To64 }
        "f64_to_f32" => { IntrinsicKind::FpTrunc64To32 }

        // Signed int → float
        "i32_to_f32" => { IntrinsicKind::SiToF32 }
        "i32_to_f64" => { IntrinsicKind::SiToF64Fromi32 }
        "i64_to_f64" => { IntrinsicKind::SiToF64Fromi64 }

        // Unsigned int → float
        "u32_to_f32" => { IntrinsicKind::UiToF32 }
        "u32_to_f64" => { IntrinsicKind::UiToF64Fromu32 }
        "u64_to_f64" => { IntrinsicKind::UiToF64Fromu64 }

        // Float → signed int
        "f32_to_i32" => { IntrinsicKind::FpToSi32Fromf32 }
        "f64_to_i32" => { IntrinsicKind::FpToSi32Fromf64 }
        "f64_to_i64" => { IntrinsicKind::FpToSi64Fromf64 }

        // Float → unsigned int
        "f32_to_u32" => { IntrinsicKind::FpToUi32Fromf32 }
        "f64_to_u32" => { IntrinsicKind::FpToUi32Fromf64 }
        "f64_to_u64" => { IntrinsicKind::FpToUi64Fromf64 }

        // Bit ops
        "bswap16"    => { IntrinsicKind::Bswap16 }
        "bswap32"    => { IntrinsicKind::Bswap32 }
        "bswap64"    => { IntrinsicKind::Bswap64 }
        "popcount32" => { IntrinsicKind::Popcount32 }
        "popcount64" => { IntrinsicKind::Popcount64 }
        "clz32"      => { IntrinsicKind::Clz32 }
        "clz64"      => { IntrinsicKind::Clz64 }
        "ctz32"      => { IntrinsicKind::Ctz32 }
        "ctz64"      => { IntrinsicKind::Ctz64 }
        "rotl32"     => { IntrinsicKind::Rotl32 }
        "rotl64"     => { IntrinsicKind::Rotl64 }
        "rotr32"     => { IntrinsicKind::Rotr32 }
        "rotr64"     => { IntrinsicKind::Rotr64 }

        // Memory ordering / float predicate / dirent
        "atomic_fence" => { IntrinsicKind::AtomicFence }
        "isfinite"     => { IntrinsicKind::IsFinite }
        "dirent_name"  => { IntrinsicKind::DirentName }
        "dirent_type"  => { IntrinsicKind::DirentType }

        // Runtime panic: see comment on IntrinsicKind::Panic for why
        // this routes through the dispatcher rather than name-resolution.
        "panic"        => { IntrinsicKind::Panic }

        // Variadic-argument pluck helpers
        "va_arg_i32"    => { IntrinsicKind::VaArgI32 }
        "va_arg_u32"    => { IntrinsicKind::VaArgU32 }
        "va_arg_i64"    => { IntrinsicKind::VaArgI64 }
        "va_arg_u64"    => { IntrinsicKind::VaArgU64 }
        "va_arg_f64"    => { IntrinsicKind::VaArgF64 }
        "va_arg_ptr"    => { IntrinsicKind::VaArgPtr }
        "va_arg_string" => { IntrinsicKind::VaArgString }

        _ => { IntrinsicKind::NotIntrinsic }
    };
}

/// Fast prefilter for the call site: avoids paying argument-codegen cost
/// for normal (non-intrinsic) function calls.  Just delegates to the kind
/// lookup so the recognized-name set has exactly one definition.
function is_intrinsic_name(name: string) -> boolean {
    return match (lookup_intrinsic_kind(name)) {
        IntrinsicKind::NotIntrinsic => { false }
        _                           => { true  }
    };
}


// ============================================================================
// Argument coercion
// ============================================================================
//
// Stdlib code (primitives.cryo) routinely calls these intrinsics with
// `&this` rather than `this`, passing a primitive by reference instead
// of by value.  When an intrinsic expects an integer/float value but the
// caller passed a pointer, load through the pointer first.


/// Source-type lookup for the unary cast / bit-op intrinsics: used by
/// the dispatcher to auto-deref `&this`-style pointer args before
/// emitting the LLVM cast/intrinsic.
function intrinsic_src_type(kind: IntrinsicKind) -> LType {
    return match (kind) {
        // Signed casts
        IntrinsicKind::SExt8To16   => { LType::i8() }
        IntrinsicKind::SExt8To32   => { LType::i8() }
        IntrinsicKind::SExt8To64   => { LType::i8() }
        IntrinsicKind::SExt16To32  => { LType::i16() }
        IntrinsicKind::SExt16To64  => { LType::i16() }
        IntrinsicKind::SExt32To64  => { LType::i32() }
        IntrinsicKind::Trunc64To32 => { LType::i64() }
        IntrinsicKind::Trunc64To16 => { LType::i64() }
        IntrinsicKind::Trunc64To8  => { LType::i64() }
        IntrinsicKind::Trunc32To16 => { LType::i32() }
        IntrinsicKind::Trunc32To8  => { LType::i32() }
        IntrinsicKind::Trunc16To8  => { LType::i16() }
        // Unsigned casts (LLVM-untyped ints share width with signed)
        IntrinsicKind::ZExt8To16    => { LType::i8() }
        IntrinsicKind::ZExt8To32    => { LType::i8() }
        IntrinsicKind::ZExt8To64    => { LType::i8() }
        IntrinsicKind::ZExt16To32   => { LType::i16() }
        IntrinsicKind::ZExt16To64   => { LType::i16() }
        IntrinsicKind::ZExt32To64   => { LType::i32() }
        IntrinsicKind::UTrunc64To32 => { LType::i64() }
        IntrinsicKind::UTrunc64To16 => { LType::i64() }
        IntrinsicKind::UTrunc64To8  => { LType::i64() }
        IntrinsicKind::UTrunc32To16 => { LType::i32() }
        IntrinsicKind::UTrunc32To8  => { LType::i32() }
        IntrinsicKind::UTrunc16To8  => { LType::i16() }
        // Float
        IntrinsicKind::FpExt32To64   => { LType::f32() }
        IntrinsicKind::FpTrunc64To32 => { LType::f64() }
        IntrinsicKind::SiToF32         => { LType::i32() }
        IntrinsicKind::SiToF64Fromi32  => { LType::i32() }
        IntrinsicKind::SiToF64Fromi64  => { LType::i64() }
        IntrinsicKind::UiToF32         => { LType::i32() }
        IntrinsicKind::UiToF64Fromu32  => { LType::i32() }
        IntrinsicKind::UiToF64Fromu64  => { LType::i64() }
        IntrinsicKind::FpToSi32Fromf32 => { LType::f32() }
        IntrinsicKind::FpToSi32Fromf64 => { LType::f64() }
        IntrinsicKind::FpToSi64Fromf64 => { LType::f64() }
        IntrinsicKind::FpToUi32Fromf32 => { LType::f32() }
        IntrinsicKind::FpToUi32Fromf64 => { LType::f64() }
        IntrinsicKind::FpToUi64Fromf64 => { LType::f64() }
        // Bit ops: source is the same width as the operation
        IntrinsicKind::Bswap16    => { LType::i16() }
        IntrinsicKind::Bswap32    => { LType::i32() }
        IntrinsicKind::Bswap64    => { LType::i64() }
        IntrinsicKind::Popcount32 => { LType::i32() }
        IntrinsicKind::Popcount64 => { LType::i64() }
        IntrinsicKind::Clz32      => { LType::i32() }
        IntrinsicKind::Clz64      => { LType::i64() }
        IntrinsicKind::Ctz32      => { LType::i32() }
        IntrinsicKind::Ctz64      => { LType::i64() }
        IntrinsicKind::Rotl32     => { LType::i32() }
        IntrinsicKind::Rotl64     => { LType::i64() }
        IntrinsicKind::Rotr32     => { LType::i32() }
        IntrinsicKind::Rotr64     => { LType::i64() }
        // Same-width sign conversions
        IntrinsicKind::SignBitcast8  => { LType::i8() }
        IntrinsicKind::SignBitcast32 => { LType::i32() }
        IntrinsicKind::SignBitcast64 => { LType::i64() }
        // isfinite consumes an f64 by value
        IntrinsicKind::IsFinite      => { LType::f64() }
        // Pointer args (atomic_fence's i32 order, dirent's void*): no
        // auto-deref needed; handled directly by the match arm.
        _ => { LType::null() }
    };
}


