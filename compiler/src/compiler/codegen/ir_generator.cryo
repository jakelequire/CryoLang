/// IR Generator
///
/// The main AST visitor that produces LLVM IR.  Uses direct dispatch
/// by NodeKind (no vtable).  Delegates to the expression, statement,
/// and declaration codegen modules for the actual IR construction.

namespace Compiler::Codegen::IRGenerator;

import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Codegen::TypeMap;
import Compiler::Codegen::Context;
import Compiler::Codegen::DeclCodegen;
import Compiler::Codegen::ExprCodegen;
import Compiler::Codegen::StmtCodegen;
import Compiler::Codegen::IntrinsicsCodegen;
import Compiler::CompilationContext;
import Compiler::DeclIndex;
import Compiler::ModuleGraph;
import Compiler::Diag;
import Compiler::Diag::Diagnostic;
import Compiler::Diag::SourceSpan;
import Compiler::Types;
import Compiler::Types::TypeRef;
import Compiler::Types::Type;
import Compiler::Types::Arena;
import Compiler::Types::Compound;
import Compiler::Types::UserDefined;
import Compiler::Types::Generic;
import Compiler::Types::GenericRegistry;
import Compiler::Types::Ownership;
import Compiler::Types::Resolver;
import Compiler::AST;
import Compiler::AST::Node;
import Compiler::AST::Visitor;
import Compiler::AST::Expression;
import Compiler::AST::Statement;
import Compiler::AST::Declaration;
import Compiler::AST::Pattern;
import Compiler::Lex;
import Compiler::Resolver::SymbolStr;
import Compiler::Resolver::InternTable;
import Compiler::Resolver::QualifiedName;
import Compiler::Resolver::MangledName;
import Utils::Logger;
import std::collections::pair;


// ============================================================================
// Lambda counter: monotonically incrementing index used to generate unique
// anonymous-function names like `__lambda_0`, `__lambda_1`, ...
// Module-level (process-wide) so that lambdas in different Cryo source
// modules never collide at the LLVM global-context level.
// ============================================================================

mut g_lambda_counter: u64 = 0;


// ============================================================================
// MatchSubjectInfo: precomputed state for match/if-let pattern codegen.
// ============================================================================

type struct MatchSubjectInfo {
    enum_type:   EnumType*;
    enum_ref:    TypeRef;
    enum_llvm:   LType;
    subject_ptr: LValue;    // ptr to the enum (alloca'd if subject was a value)
    tag_val:     LValue;    // i32 discriminant extracted from subject
    subject_ty:  TypeRef;   // Cryo type of the match subject (pre-unwrap);
                            // drives integer-pattern width + signedness
}


// ============================================================================
// IRGeneratorVisitor
// ============================================================================

type class IRGeneratorVisitor : BaseASTVisitor {
public:
    cg: CodegenContext*;

    /// Result of the most recent expression codegen.
    last_value:     LValue;
    last_is_lvalue: boolean;

    /// Current impl block target type (set during impl block traversal).
    current_impl_target: SymbolStr;

    IRGeneratorVisitor(cg: CodegenContext*) : BaseASTVisitor() {
        this.cg              = cg;
        this.last_value      = LValue::null();
        this.last_is_lvalue  = false;
        this.current_impl_target = SymbolStr::empty();
    }


    // ========================================================================
    // Helpers to break deep chains for C++ compiler compatibility
    // ========================================================================

    /// Get the current function from the builder's insert block.
    get_current_function(mut &this) -> LValue {
        const bb: LBasicBlock = this.cg.builder.get_insert_block();
        if (!bb.is_valid()) {
            this.cg.ctx.emit_error(ErrorCode::E0600_CODEGEN_FAILED,
                "codegen: builder has no insert block; cannot determine current function");
            return LValue::null();
        }
        return bb.get_parent();
    }

    /// Look up a type in the declaration index.
    lookup_type(mut &this, name: SymbolStr) -> TypeRef {
        const ctx_ptr: CompilationContext* = this.cg.ctx;
        return ctx_ptr.decl_index.lookup_type(name);
    }

    /// Determine whether an AST call callee resolves to a known
    /// divergent (non-returning) function.  Drives the post-call
    /// `unreachable` emission without relying on string-comparing the
    /// emitted LLVM symbol name to a hard-coded mangle.
    ///
    /// Recognized:
    ///   - bare `panic` (the intrinsic / legacy stdlib path)
    ///   - any function `panic` whose containing namespace ends in
    ///     `::core::panic` or `::prelude` (matches the new stdlib's
    ///     `std::core::panic::panic` and the legacy `std::prelude::panic`)
    ///
    /// When the language gains `-> never` return-type syntax this is
    /// the path that should subsume the special cases.
    is_divergent_callee(mut &this, callee: ExpressionNode*) -> boolean {
        if (callee == null) { return false; }
        const intern: InternTable* = this.cg.get_intern();

        if (callee.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = callee as IdentifierNode*;
            const name_str: string = intern.resolve(id.name);
            if (intrinsics::strcmp(name_str, "panic") == 0) { return true; }
            return false;
        }

        if (callee.kind == NodeKind::ScopeResolution) {
            const sr: ScopeResolutionNode* = callee as ScopeResolutionNode*;
            const member_str: string = intern.resolve(sr.member_name);
            if (intrinsics::strcmp(member_str, "panic") != 0) { return false; }

            const scope_str: string = intern.resolve(sr.scope_name);
            const slen: i64 = intrinsics::strlen(scope_str) as i64;
            // Match `<...>::core::panic`.
            if (slen >= 11) {
                const tail11: string = (scope_str + (slen - 11)) as string;
                if (intrinsics::strcmp(tail11, "core::panic") == 0) { return true; }
            }
            // Match `<...>::prelude` and the bare `prelude` form.
            if (slen >= 7) {
                const tail7: string = (scope_str + (slen - 7)) as string;
                if (intrinsics::strcmp(tail7, "prelude") == 0) { return true; }
            }
            // Match `intrinsics` / `core::intrinsics` (the stdlib's
            // panic emerges through this layer too).
            if (slen >= 10) {
                const tail10: string = (scope_str + (slen - 10)) as string;
                if (intrinsics::strcmp(tail10, "intrinsics") == 0) { return true; }
            }
            if (intrinsics::strcmp(scope_str, "intrinsics") == 0) { return true; }
            return false;
        }

        return false;
    }

    /// Resolve a sizeof/alignof operand TypeAnnotation to a concrete TypeRef
    /// at codegen time.  Drives the operand through the type_resolver so that
    /// generic args (e.g., `HashMapEntry<K, V>` after substitution by the
    /// monomorphizer) are honoured.  Returns invalid if the resolver is
    /// unavailable or the annotation can't be resolved; callers fall back
    /// to a name-based lookup.
    resolve_sizeof_operand_type(mut &this, ann: TypeAnnotation*) -> TypeRef {
        if (ann == null) { return TypeRef::invalid(); }
        const ctx_ptr: CompilationContext* = this.cg.ctx;
        if (ctx_ptr.type_resolver == null) { return TypeRef::invalid(); }
        mut res_ctx: ResolutionContext = ResolutionContext::new(
            ctx_ptr.source_file, "");
        return ctx_ptr.type_resolver.resolve(ann, &res_ctx);
    }

    // ========================================================================
    // Top-level program generation
    // ========================================================================

    /// Generate IR for an entire module's program.
    /// Three-pass approach:
    ///   1. Forward-declare all types
    ///   2. Declare all function signatures
    ///   3. Generate function bodies
    generate_program(mut &this, program: ProgramNode*) -> boolean {
        if (program == null) {
            cdebug("[IRGen] generate_program: program is null\n"); fflush(null);
            return false;
        }

        cdebug("[IRGen] Phase 1: declare_types...\n"); fflush(null);
        declare_types(this.cg, program);
        cdebug("[IRGen] Phase 1: done\n"); fflush(null);

        cdebug("[IRGen] Phase 2: declare_functions...\n"); fflush(null);
        declare_functions(this.cg, program);
        cdebug("[IRGen] Phase 2: done\n"); fflush(null);

        cdebug("[IRGen] Phase 3: generate bodies (%lld stmts)...\n", program.statements.length); fflush(null);
        const stmts: ASTNode*[] = program.statements;
        for (mut i: i64 = 0; i < stmts.length; i++) {
            const stmt: ASTNode* = stmts[i];
            if (stmt == null) { continue; }

            match (stmt.kind) {
                NodeKind::FunctionDeclaration => {
                    const func: FunctionDeclNode* = stmt as FunctionDeclNode*;
                    if (func.generic_params.length > 0) { continue; }
                    if (func.body == null) { continue; }
                    const fn_name: string = this.cg.resolve(func.name);
                    // `cryo test` synthesizes its own `main`; suppress the
                    // user's so the LLVM module has exactly one `main`
                    // symbol.  Mirrors the `declare_function` guard.
                    if (this.cg.ctx.mode.skip_user_main()
                            && intrinsics::strcmp(fn_name, "main") == 0) {
                        cdebug("[IRGen]   [%lld] func body: main (suppressed by test mode)\n", i);
                        fflush(null);
                        continue;
                    }
                    cdebug("[IRGen]   [%lld] func body: %s\n", i, fn_name); fflush(null);
                    this.generate_function_body(func);
                    cdebug("[IRGen]   [%lld] func done\n", i); fflush(null);
                }
                NodeKind::ImplementationBlock => {
                    const impl_node: ImplBlockNode* = stmt as ImplBlockNode*;
                    const impl_target: string = this.cg.resolve(impl_node.target_type);
                    cdebug("[IRGen]   [%lld] impl block: %s (%lld methods)\n",
                           i, impl_target, impl_node.methods.length); fflush(null);
                    this.generate_impl_block(impl_node);
                    cdebug("[IRGen]   [%lld] impl done\n", i); fflush(null);
                }
                NodeKind::StructDeclaration => {
                    const struct_node: StructDeclNode* = stmt as StructDeclNode*;
                    if (struct_node.generic_params.length > 0) { continue; }
                    if (struct_node.methods.length > 0) {
                        const sname: string = this.cg.resolve(struct_node.name);
                        cdebug("[IRGen]   [%lld] struct methods: %s (%lld methods)\n",
                               i, sname, struct_node.methods.length); fflush(null);
                        // Use the arena's canonical qualified name for specialized
                        // structs so method keys match the DI registration.
                        const s_di: DeclarationIndex* = this.cg.get_decl_index();
                        const s_local: SymbolStr = this.cg.qualify(struct_node.name);
                        mut s_ref: TypeRef = s_di.lookup_type(s_local);
                        if (!s_ref.is_valid()) {
                            s_ref = s_di.lookup_type(struct_node.name);
                        }
                        if (s_ref.is_valid()) {
                            const s_arena: TypeArena* = this.cg.get_arena();
                            const s_qname: SymbolStr = s_arena.get_qualified_name(s_ref);
                            if (s_qname.is_valid()) {
                                this.current_impl_target = s_qname;
                            } else {
                                this.current_impl_target = s_local;
                            }
                        } else {
                            this.current_impl_target = s_local;
                        }
                        for (mut j: i64 = 0; j < struct_node.methods.length; j++) {
                            this.generate_method_body(struct_node.methods[j]);
                        }
                        this.current_impl_target = SymbolStr::empty();
                        cdebug("[IRGen]   [%lld] struct methods done\n", i); fflush(null);
                    }
                }
                NodeKind::ClassDeclaration => {
                    const class_node: ClassDeclNode* = stmt as ClassDeclNode*;
                    if (class_node.generic_params.length > 0) { continue; }
                    if (class_node.methods.length > 0) {
                        const cname: string = this.cg.resolve(class_node.name);
                        cdebug("[IRGen]   [%lld] class methods: %s (%lld methods)\n",
                               i, cname, class_node.methods.length); fflush(null);
                        this.current_impl_target = this.cg.qualify(class_node.name);
                        for (mut j: i64 = 0; j < class_node.methods.length; j++) {
                            this.generate_method_body(class_node.methods[j]);
                        }
                        this.current_impl_target = SymbolStr::empty();
                        cdebug("[IRGen]   [%lld] class methods done\n", i); fflush(null);
                    }
                }
                NodeKind::VariableDeclaration => {
                    // Globals are emitted in Phase 2 (declare_functions) so they
                    // are visible to function bodies regardless of source order.
                }
                _ => {}
            }
        }

        cdebug("[IRGen] Phase 3: all bodies done\n"); fflush(null);
        return true;
    }


    // ========================================================================
    // Direct codegen methods (bypass vtable dispatch)
    // ========================================================================

    /// Generate a function body directly, without virtual dispatch.
    generate_function_body(mut &this, node: FunctionDeclNode*) -> void {
        const fn_val: LValue = codegen_function_prologue(this.cg, node);
        if (!fn_val.is_valid()) {
            cdebug("[IRGen]     func prologue failed\n"); fflush(null);
            return;
        }
        cdebug("[IRGen]     func prologue ok, generating block...\n"); fflush(null);
        this.generate_block(node.body);
        cdebug("[IRGen]     func block done, epilogue...\n"); fflush(null);
        codegen_function_epilogue(this.cg, node);

        // Validate: if any block lacks a terminator, body generation
        // failed. Strip back to a clean declare rather than emitting
        // broken IR that fails LLVM verification; ALWAYS surface a
        // diagnostic so the user sees a real error instead of a silent
        // `undefined reference` from the linker.
        if (!this.cg.is_function_body_valid(fn_val)) {
            const fname: string = this.cg.resolve(node.name);
            this.cg.report_invalid_function_body(fn_val, fname, node.span);
        }
    }

    /// Generate an impl block directly.
    generate_impl_block(mut &this, node: ImplBlockNode*) -> void {
        if (node.generic_params.length > 0) {
            cdebug("[IRGen]     impl skipped (generic)\n"); fflush(null);
            return;
        }

        // Prefer TypeResolution's canonical-qualified target so cross-
        // module trait impls (`implement trait FmtWrite for struct
        // Stdout` in fmt::write where Stdout lives in io::stdio) emit
        // method bodies under the same key declare_method registered
        // them under.  Mirrors the resolution logic in declare_impl_block.
        const di_ptr: DeclarationIndex* = this.cg.get_decl_index();
        mut qualified_impl_target: SymbolStr = SymbolStr::empty();
        if (node.qualified_target_name.is_valid()) {
            qualified_impl_target = node.qualified_target_name;
        } else {
            const impl_target_str: string = this.cg.resolve(node.target_type);
            if (intrinsics::strstr(impl_target_str, "::") != null) {
                qualified_impl_target = node.target_type;
            } else if (di_ptr.lookup_type(node.target_type).is_valid()) {
                qualified_impl_target = node.target_type;
            } else {
                const resolved: SymbolStr = di_ptr.resolve_qualified(node.target_type);
                if (!resolved.equals(node.target_type)) {
                    qualified_impl_target = resolved;
                } else {
                    qualified_impl_target = this.cg.qualify(node.target_type);
                }
            }
        }
        // Mirror declare_impl_block: skip when the target type is a generic
        // template; only spec'd clones should be codegen'd.
        const cg_ctx: CompilationContext* = this.cg.ctx;
        if (cg_ctx.generic_registry != null) {
            const greg: GenericRegistry* = cg_ctx.generic_registry;
            if (greg.get_template(qualified_impl_target) != null) {
                cdebug("[IRGen]     impl skipped (template target)\n"); fflush(null);
                return;
            }
        }
        this.current_impl_target = qualified_impl_target;

        for (mut i: i64 = 0; i < node.methods.length; i++) {
            const m: MethodNode* = node.methods[i];
            const mfunc: FunctionDeclNode* = m.func;
            if (mfunc != null) {
                const mname: string = this.cg.resolve(mfunc.name);
                cdebug("[IRGen]     method[%lld]: %s (static=%d, generic=%lld, body=%p)\n",
                       i, mname, m.is_static as i32,
                       mfunc.generic_params.length, mfunc.body as void*); fflush(null);
            }
            this.generate_method_body(m);
            cdebug("[IRGen]     method[%lld] done\n", i); fflush(null);
        }

        this.current_impl_target = SymbolStr::empty();
    }

    /// Generate a method body directly.
    generate_method_body(mut &this, node: MethodNode*) -> void {
        const func: FunctionDeclNode* = node.func;
        if (func == null || func.body == null) { return; }
        if (func.generic_params.length > 0) { return; }

        cdebug("[IRGen]       method prologue...\n"); fflush(null);
        const fn_val: LValue = codegen_method_prologue(
            this.cg, node, this.current_impl_target);
        if (!fn_val.is_valid()) {
            cdebug("[IRGen]       method prologue FAILED\n"); fflush(null);
            return;
        }

        // Constructor with base-class delegation (`Parser(...) : ExprParser(...)`):
        // emit the base-class constructor call before the body so the inherited
        // fields (e.g. ParserBase's `tokens`/`pos`) are properly initialised.
        // Without this, every derived-class constructor returns immediately
        // after storing its params into locals, and downstream uses of inherited
        // fields read garbage.
        if (node.is_constructor && node.has_base_ctor()) {
            this.emit_base_ctor_call(node, fn_val);
        }

        cdebug("[IRGen]       method body block...\n"); fflush(null);
        this.generate_block(func.body);
        cdebug("[IRGen]       method body done, epilogue...\n"); fflush(null);
        codegen_function_epilogue(this.cg, func);

        if (!this.cg.is_function_body_valid(fn_val)) {
            const target_str: string = this.cg.resolve(this.current_impl_target);
            const method_str: string = this.cg.resolve(func.name);
            const pretty: string = if (intrinsics::strlen(target_str) > 0) {
                format("%s::%s", target_str, method_str)
            } else {
                method_str
            };
            this.cg.report_invalid_function_body(fn_val, pretty, func.span);
        }
    }

    /// Emit the immediate base-class constructor call for a derived-class
    /// constructor with `: BaseClass(args)` initialisation.  `this` (the LLVM
    /// param 0 of the enclosing constructor) is passed as the receiver, and
    /// `node.base_ctor_args` are codegen'd as rvalues for the remaining args.
    emit_base_ctor_call(mut &this, node: MethodNode*, fn_val: LValue) -> void {
        const intern: InternTable* = this.cg.get_intern();
        const di: DeclarationIndex* = this.cg.get_decl_index();
        const ctx_ptr: CompilationContext* = this.cg.ctx;

        // Resolve the base class name (e.g. bare "ExprParser") to its
        // qualified form so we can build the constructor's mangled lookup
        // key (`QualifiedBase::BareBase`).
        mut base_qualified: SymbolStr = ctx_ptr.qualify_symbol_sym(node.base_ctor_name);
        mut base_type: TypeRef = di.lookup_type(base_qualified);
        if (base_type.is_invalid()) {
            base_qualified = di.resolve_qualified(node.base_ctor_name);
            base_type = di.lookup_type(base_qualified);
        }
        if (base_type.is_invalid()) {
            base_qualified = node.base_ctor_name;
            base_type = di.lookup_type(base_qualified);
        }
        if (base_type.is_invalid()) { cdebug("[BCTOR-BAIL] type invalid\n"); return; }

        const base_qualified_str: string = intern.resolve(base_qualified);
        const base_bare_str: string = intern.resolve(node.base_ctor_name);
        const ctor_combined: string = format("%s::%s", base_qualified_str, base_bare_str);
        const ctor_sym: SymbolStr = intern.intern(ctor_combined);

        // Constructor LLVM arity = user args + 1 for the implicit `this`.
        const ctor_arity: u32 = (node.base_ctor_args.length + 1) as u32;
        mut ctor_fn: LValue = resolve_function_with_arity(this.cg, ctor_sym, ctor_arity);
        if (!ctor_fn.is_valid()) {
            ctor_fn = resolve_function(this.cg, ctor_sym);
        }
        if (!ctor_fn.is_valid()) {
            cdebug("[BCTOR-BAIL] ctor not found: '%s' arity=%u\n", ctor_combined, ctor_arity);
            return;
        }

        const ctor_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(ctor_fn.raw) };
        if (!ctor_ty.is_valid()) { cdebug("[BCTOR-BAIL] ctor_ty invalid\n"); return; }

        // `this` is LLVM param 0 of the enclosing constructor.
        const this_arg: LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, 0) };

        mut ctor_args: Pair<LValue, TypeRef>[] = [];
        ctor_args.push(Pair<LValue, TypeRef>::new(this_arg, base_type));
        mut any_arg_invalid: boolean = false;
        for (mut i: i64 = 0; i < node.base_ctor_args.length; i++) {
            const arg_node: ExpressionNode* = node.base_ctor_args[i];
            mut arg: LValue = this.codegen_rvalue(arg_node);
            if (!arg.is_valid()) {
                any_arg_invalid = true;
                break;
            }
            // codegen_rvalue's load step short-circuits when the arg's
            // `resolved_type` doesn't map to a valid LType: base ctor
            // args from `Parser(...) : ExprParser(tokens, source_file, ctx)`
            // are AST identifiers wired up by the parser before sema fully
            // resolves them, so we sometimes get the alloca address back
            // instead of the loaded value.  With opaque pointers the
            // mismatch is invisible to LLVM (`ptr` either way), and the
            // chain Parser → ExprParser → ParserBase ends up storing the
            // OUTER constructor's local-`%ctx` alloca address into
            // `this.ctx`, leaving the parser's `ctx` field pointing at
            // dead stack frame data the moment from_context returns.
            //
            // codegen_rvalue's load step short-circuits when the arg's
            // `resolved_type` doesn't map to a valid LType: base ctor
            // args from `Parser(...) : ExprParser(tokens, source_file, ctx)`
            // are AST identifiers wired up by the parser before sema fully
            // resolves them, so we sometimes get the alloca address back
            // instead of the loaded value.  codegen_rvalue clears
            // last_is_lvalue unconditionally before returning, so we
            // can't use that flag; check the value's opcode directly.
            // If `arg.raw` is still an alloca instruction (opcode 26),
            // codegen_rvalue skipped its load and we need to deref here
            // before passing to the base ctor.  Restrict to pointer /
            // integer / float allocas; aggregate (struct) allocas get
            // the load via codegen_call's ek=10/ak=12 coercion, so
            // pre-loading would double-deref.
            const opcode: i32 = llvm::LLVMGetInstructionOpcode(arg.raw);
            if (opcode == 26) {
                const alloc_ty: void* = llvm::LLVMGetAllocatedType(arg.raw);
                if (alloc_ty != null) {
                    const alloc_kind: LTypeKind = type_kind_of(alloc_ty);
                    if (alloc_kind == LTypeKind::Pointer || alloc_kind == LTypeKind::Integer
                            || alloc_kind == LTypeKind::Float || alloc_kind == LTypeKind::Double) {
                        const alloc_lty: LType = LType { raw: alloc_ty };
                        arg = this.cg.builder.build_load(
                            alloc_lty, arg, "base.arg.load");
                    }
                }
            }
            ctor_args.push(Pair<LValue, TypeRef>::new(arg, arg_node.resolved_type));
        }
        if (any_arg_invalid) { cdebug("[BCTOR-BAIL] any_arg_invalid\n"); return; }

        mut ctor_result: LValue = LValue::null();
        codegen_call(this.cg, ctor_fn, ctor_ty, ctor_args, "", &ctor_result);
    }

    /// Generate a block of statements directly (no virtual dispatch).
    generate_block(mut &this, block: BlockStmtNode*) -> void {
        if (block == null) { return; }
        this.cg.push_scope();
        cdebug("[IRGen]         block (%lld stmts) at %s:%d:%d\n",
               block.statements.length, block.span.file,
               block.span.start_line as i32, block.span.start_col as i32); fflush(null);
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            const current: LBasicBlock = this.cg.builder.get_insert_block();
            if (current.is_valid() && current.has_terminator()) {
                break;
            }
            const stmt: StatementNode* = block.statements[i];
            if (stmt != null) {
                this.generate_statement(stmt);
            }
        }
        this.cg.pop_scope();
    }


    // ========================================================================
    // Statement dispatch (by NodeKind)
    // ========================================================================

    /// Dispatch a statement via double-dispatch (`stmt.accept(this)` →
    /// runtime type calls the right `override visit(SpecificType*)`).
    /// Each statement kind has its own `override visit(...)` below, so
    /// adding a new statement type only requires implementing the
    /// corresponding visitor method.  Unknown kinds fall through to
    /// `BaseASTVisitor`'s no-op defaults silently.
    generate_statement(mut &this, stmt: StatementNode*) -> void {
        if (stmt == null) { return; }
        cdebug("[IRGen]           stmt kind=%s\n", stmt.kind.to_string()); fflush(null);
        stmt.accept(this);
    }

    override visit(mut &this, node: BlockStmtNode*) -> void {
        this.generate_block(node);
    }

    override visit(mut &this, node: BreakStmtNode*) -> void {
        codegen_break(this.cg);
    }

    override visit(mut &this, node: ContinueStmtNode*) -> void {
        codegen_continue(this.cg);
    }

    override visit(mut &this, node: ExprStmtNode*) -> void {
        if (node.expression != null) {
            this.codegen_rvalue(node.expression);
        }
    }

    override visit(mut &this, node: UnsafeBlockStmtNode*) -> void {
        this.generate_block(node.block);
    }


    // ========================================================================
    // Statement visitors
    // ========================================================================

    override visit(mut &this, node: ReturnStmtNode*) -> void {
        // Drops attached to the return run *after* the expression value
        // is materialised; the expression may borrow a local that's
        // about to be dropped.  See ReturnStmtNode.synth_drops and the
        // ReturnStatement arm in passes/drop_insertion.cryo.
        if (node.expression != null) {
            const val: LValue = this.codegen_rvalue(node.expression);
            for (mut i: i64 = 0; i < node.synth_drops.length; i++) {
                const d: StatementNode* = node.synth_drops[i];
                if (d != null) { d.accept(this); }
            }
            codegen_return(this.cg, val, true, node.expression.resolved_type);
        } else {
            for (mut i: i64 = 0; i < node.synth_drops.length; i++) {
                const d: StatementNode* = node.synth_drops[i];
                if (d != null) { d.accept(this); }
            }
            codegen_return(this.cg, LValue::null(), false, TypeRef::invalid());
        }
    }

    override visit(mut &this, node: IfStmtNode*) -> void {
        const cond: LValue = this.codegen_rvalue(node.condition);
        const current_fn: LValue = this.get_current_function();
        const blocks: IfBlocks = codegen_if(this.cg, cond, current_fn,
                                             node.else_stmt != null);
        this.cg.builder.position_at_end(blocks.then_bb);
        if (node.then_stmt != null) {
            this.generate_statement(node.then_stmt);
        }
        branch_if_not_terminated(this.cg, blocks.merge_bb);
        if (node.else_stmt != null) {
            this.cg.builder.position_at_end(blocks.else_bb);
            this.generate_statement(node.else_stmt);
            branch_if_not_terminated(this.cg, blocks.merge_bb);
        }
        this.cg.builder.position_at_end(blocks.merge_bb);
    }

    override visit(mut &this, node: WhileStmtNode*) -> void {
        const current_fn: LValue = this.get_current_function();
        const blocks: LoopBlocks = codegen_while_header(this.cg, current_fn);
        this.cg.builder.position_at_end(blocks.cond_bb);
        const cond: LValue = this.codegen_rvalue(node.condition);
        this.cg.builder.build_cond_br(cond, blocks.body_bb, blocks.merge_bb);
        this.cg.builder.position_at_end(blocks.body_bb);
        if (node.body != null) {
            this.generate_statement(node.body);
        }
        branch_if_not_terminated(this.cg, blocks.cond_bb);
        this.cg.pop_loop();
        this.cg.builder.position_at_end(blocks.merge_bb);
    }

    override visit(mut &this, node: ForStmtNode*) -> void {
        const current_fn: LValue = this.get_current_function();
        this.cg.push_scope();
        if (node.init != null) {
            this.generate_statement(node.init as StatementNode*);
        }
        const blocks: ForBlocks = codegen_for_header(this.cg, current_fn);
        this.cg.builder.build_br(blocks.cond_bb);
        this.cg.builder.position_at_end(blocks.cond_bb);
        if (node.condition != null) {
            const cond: LValue = this.codegen_rvalue(node.condition);
            this.cg.builder.build_cond_br(cond, blocks.body_bb, blocks.merge_bb);
        } else {
            this.cg.builder.build_br(blocks.body_bb);
        }
        this.cg.builder.position_at_end(blocks.body_bb);
        if (node.body != null) {
            this.generate_statement(node.body);
        }
        branch_if_not_terminated(this.cg, blocks.update_bb);
        this.cg.builder.position_at_end(blocks.update_bb);
        if (node.update != null) {
            this.codegen_rvalue(node.update);
        }
        branch_if_not_terminated(this.cg, blocks.cond_bb);
        this.cg.pop_loop();
        this.cg.pop_scope();
        this.cg.builder.position_at_end(blocks.merge_bb);
    }

    override visit(mut &this, node: LoopStmtNode*) -> void {
        const current_fn: LValue = this.get_current_function();
        const blocks: LoopBlocks = codegen_loop_header(this.cg, current_fn);
        this.cg.builder.position_at_end(blocks.body_bb);
        if (node.body != null) {
            this.generate_statement(node.body);
        }
        branch_if_not_terminated(this.cg, blocks.body_bb);
        this.cg.pop_loop();
        this.cg.builder.position_at_end(blocks.merge_bb);
    }

    override visit(mut &this, node: MatchStmtNode*) -> void {
        if (node.subject == null || node.arms.length == 0) { return; }

        const current_fn: LValue = this.get_current_function();
        if (!current_fn.is_valid()) { return; }

        // Evaluate the subject expression.
        const subject: LValue = this.codegen_rvalue(node.subject);
        if (!subject.is_valid()) { return; }

        // Resolve the enum type (if subject is an enum), normalize to ptr, and
        // pre-extract the tag value for pattern comparison.
        const minfo: MatchSubjectInfo = this.prepare_match_subject(
            subject, node.subject.resolved_type, current_fn);

        // String subjects need strcmp for pattern comparison, not icmp
        // (strings are i8* at the LLVM level and icmp would compare
        // pointer addresses, not content).
        const subj_t: Type* = this.cg.lookup_type_by_id(node.subject.resolved_type.id);
        const is_string_subj: boolean = subj_t != null &&
            subj_t.kind == TypeKind::String;

        const num_arms: i64 = node.arms.length;

        // Create basic blocks: one per arm, a dedicated no_match block, and a merge.
        // no_match_bb is the terminus of the comparison chain when no arm fires;
        // it gets `unreachable` so a runtime discriminant outside the matched
        // set traps cleanly instead of falling through into the next function
        // in the binary (which is what bug-in-the-wild triggered when a garbage
        // SocketAddr's IpAddr discriminant was neither V4 nor V6).
        mut arm_bbs: LBasicBlock[] = [];
        for (mut i: i64 = 0; i < num_arms; i++) {
            const name: string = format("match.arm%lld", i);
            arm_bbs.push(LBasicBlock::append(current_fn, name));
        }
        const no_match_bb: LBasicBlock = LBasicBlock::append(current_fn, "match.no_match");
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "match.end");

        // Generate the comparison chain.
        // For each arm, compare subject against the pattern(s).
        // Wildcard (_) matches unconditionally; branch directly.
        for (mut i: i64 = 0; i < num_arms; i++) {
            const arm: MatchArmNode* = node.arms[i];
            if (arm == null) { continue; }

            // Determine the next block to fall through to if this arm doesn't match.
            // The last arm's "no match" edge points at no_match_bb so non-matching
            // discriminants hit `unreachable` rather than the post-match join.
            mut next_bb: LBasicBlock = no_match_bb;
            if (i + 1 < num_arms) {
                next_bb = LBasicBlock::append(current_fn, format("match.test%lld", i + 1));
            }

            // Emit the OR-pattern comparison chain for this arm.  A hit on
            // any pattern branches to arm_bbs[i]; a full miss falls through
            // to next_bb.
            this.emit_match_arm_comparison(arm, arm_bbs[i], next_bb,
                minfo, is_string_subj, subject, current_fn, "match");

            // Position at next_bb for the next test (if not the last arm).
            if (i + 1 < num_arms) {
                this.cg.builder.position_at_end(next_bb);
            }
        }

        // Generate each arm's body.
        mut any_arm_falls_through: boolean = false;
        for (mut i: i64 = 0; i < num_arms; i++) {
            const arm: MatchArmNode* = node.arms[i];
            if (arm == null) { continue; }

            this.cg.builder.position_at_end(arm_bbs[i]);

            // Bind enum pattern payloads (scoped to arm body).
            this.cg.push_scope();
            this.bind_arm_enum_payloads(arm, minfo);

            if (arm.body != null) {
                this.generate_statement(arm.body);
            }
            const cur_after: LBasicBlock = this.cg.builder.get_insert_block();
            const arm_falls: boolean = cur_after.is_valid() && !cur_after.has_terminator();
            if (arm_falls) { any_arm_falls_through = true; }
            branch_if_not_terminated(this.cg, merge_bb);
            this.cg.pop_scope();
        }

        // no_match_bb is reached when the discriminant matched no arm.
        // Emit `call @abort(); unreachable` rather than a bare `unreachable`:
        // LLVM's x86 backend lowers a bare `unreachable` to *no instruction*,
        // so a runtime fall-through silently slides into whatever code is
        // laid out next in the binary (the original symptom: pack_sockaddr_in
        // sliding into TcpStream::connect, then recursing to a stack-overflow
        // SIGSEGV).  The abort+unreachable pair guarantees a clean SIGABRT.
        // If a wildcard arm exists, no_match_bb has no incoming edges and
        // LLVM elides the whole thing; either way the IR stays well-formed.
        if (!no_match_bb.has_terminator()) {
            this.cg.builder.position_at_end(no_match_bb);
            const abort_fn: LValue = get_or_decl_abort(this.cg);
            const abort_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(abort_fn.raw) };
            mut a_args: Pair<LValue, TypeRef>[] = [];
            mut a_res: LValue = LValue::null();
            codegen_call(this.cg, abort_fn, abort_ty, a_args, "", &a_res);
            this.cg.builder.build_unreachable();
        }

        this.cg.builder.position_at_end(merge_bb);
        // If every arm terminated internally (return/break/panic), no edge
        // reaches merge_bb and the function-body validator would strip the
        // body to a bare declare.  Emit `unreachable` to keep the IR
        // verifiable.
        if (!any_arm_falls_through && !merge_bb.has_terminator()) {
            this.cg.builder.build_unreachable();
        }
    }

    /// Prepare a match subject: resolve its enum type (if any), normalize to
    /// a ptr (for payload extraction), and pre-extract the i32 tag value.
    prepare_match_subject(mut &this, subject: LValue, subj_ref: TypeRef,
                          current_fn: LValue) -> MatchSubjectInfo {
        mut info: MatchSubjectInfo = MatchSubjectInfo {
            enum_type:   null,
            enum_ref:    subj_ref,
            enum_llvm:   LType::null(),
            subject_ptr: subject,
            tag_val:     LValue::null(),
            subject_ty:  subj_ref,
        };

        // Unwrap Reference/Pointer/InstantiatedType to find the enum type.
        mut unwrap_ref: TypeRef = subj_ref;
        mut t: Type* = this.cg.lookup_type_by_id(unwrap_ref.id);
        mut depth: i32 = 0;
        while (t != null && depth < 8) {
            if (t.kind == TypeKind::Pointer) {
                const pt: PointerType* = t as PointerType*;
                unwrap_ref = pt.pointee;
                t = this.cg.lookup_type_by_id(unwrap_ref.id);
            } else if (t.kind == TypeKind::Reference) {
                const rt: ReferenceType* = t as ReferenceType*;
                unwrap_ref = rt.referent;
                t = this.cg.lookup_type_by_id(unwrap_ref.id);
            } else if (t.kind == TypeKind::InstantiatedType) {
                const it: InstantiatedType* = t as InstantiatedType*;
                if (it.has_resolved_type()) {
                    unwrap_ref = it.resolved_type;
                    t = this.cg.lookup_type_by_id(unwrap_ref.id);
                } else { break; }
            } else {
                break;
            }
            depth += 1;
        }

        if (t == null || t.kind != TypeKind::Enum) {
            return info;
        }

        info.enum_type = t as EnumType*;
        info.enum_ref  = unwrap_ref;
        info.enum_llvm = this.cg.type_mapper.map_type(unwrap_ref);
        if (!info.enum_llvm.is_valid()) {
            return info;
        }

        // LLVMPointerTypeKind = 12.
        mut is_ptr: boolean = false;
        const subj_llvm_ty: void* = llvm::LLVMTypeOf(subject.raw);
        if (subj_llvm_ty != null && type_kind_of(subj_llvm_ty) == LTypeKind::Pointer) {
            is_ptr = true;
        }

        if (info.enum_type.is_simple_enum()) {
            // Simple enum: the value IS the i32 tag.  No alloca needed; we
            // either use the subject directly or load one i32 through the ptr.
            if (is_ptr) {
                info.tag_val = this.cg.builder.build_load(
                    LType::i32(), subject, "enum.tag");
            } else {
                info.tag_val = subject;
            }
            info.subject_ptr = subject;
            return info;
        }

        // ADT enum: we need a ptr to do struct GEP for tag and payload.
        // Only alloca when the subject is a raw struct value.  Alloca goes in
        // the current block (not the entry block) so it stays before the
        // match's own control flow; `create_entry_alloca` can't be used here
        // because if visit_match_stmt runs mid-function the entry block already
        // has a terminator.
        if (is_ptr) {
            info.subject_ptr = subject;
        } else {
            info.subject_ptr = this.cg.builder.build_alloca(info.enum_llvm, "match.subj");
            if (info.subject_ptr.is_valid()) {
                this.cg.builder.build_store(subject, info.subject_ptr);
            }
        }

        if (info.subject_ptr.is_valid()) {
            const tag_ptr: LValue = this.cg.builder.build_struct_gep(
                info.enum_llvm, info.subject_ptr, 0, "enum.tag.ptr");
            if (tag_ptr.is_valid()) {
                info.tag_val = this.cg.builder.build_load(
                    LType::i32(), tag_ptr, "enum.tag");
            }
        }

        return info;
    }

    /// Extract enum variant payload bindings into named values in the current scope.
    /// No-op unless the arm's pattern is an enum pattern with bindings.
    ///
    /// Registers each binding as a pointer to its payload slot.  `codegen_identifier`
    /// treats named values as lvalues, so `codegen_rvalue` loads through the ptr.
    /// This avoids creating entry-block allocas after the entry block has been
    /// terminated (cryoc's `create_entry_alloca` uses position_at_end and would
    /// emit allocas after the terminator).
    bind_arm_enum_payloads(mut &this, arm: MatchArmNode*, minfo: MatchSubjectInfo) -> void {
        if (minfo.enum_type == null || !minfo.subject_ptr.is_valid()) { return; }
        if (!minfo.enum_llvm.is_valid()) { return; }

        for (mut p: i64 = 0; p < arm.patterns.length; p++) {
            const pat: PatternNode* = arm.patterns[p];
            if (pat == null || pat.pattern_kind != PatternKind::Enum) { continue; }

            const epat: EnumPatternNode* = pat as EnumPatternNode*;
            if (epat.binding_names.length == 0) { continue; }

            const variant: EnumVariantInfo* = minfo.enum_type.get_variant(epat.variant_name);
            if (variant == null || !variant.has_payload()) { continue; }

            // Simple enum (no payload on any variant) → nothing to bind.
            if (minfo.enum_type.is_simple_enum()) { continue; }

            // GEP to payload field (field 1 of { i32 tag, [N x i8] payload }).
            const payload_ptr: LValue = this.cg.builder.build_struct_gep(
                minfo.enum_llvm, minfo.subject_ptr, 1, "enum.payload.ptr");
            if (!payload_ptr.is_valid()) { continue; }

            // Precompute payload field offsets (sum of earlier field sizes).
            const num_payload: i64 = variant.payload_types.length;
            mut offsets: u64[] = [];
            mut running: u64 = 0;
            for (mut pi: i64 = 0; pi < num_payload; pi++) {
                offsets.push(running);
                const ft: Type* = this.cg.lookup_type_by_id(variant.payload_types[pi].id);
                if (ft != null) {
                    running += ft.size_bytes();
                }
            }

            for (mut bi: i64 = 0; bi < epat.binding_names.length; bi++) {
                const pos: i64 = epat.binding_positions[bi];
                if (pos < 0 || pos >= num_payload) { continue; }

                const field_ref: TypeRef = variant.payload_types[pos];
                const field_llvm: LType = this.cg.type_mapper.map_type(field_ref);
                if (!field_llvm.is_valid()) { continue; }
                if (type_kind_of(field_llvm.raw) == LTypeKind::Void) { continue; }

                // field_ptr = payload_ptr + offsets[pos] (byte offset via i8 GEP).
                mut field_ptr_raw: LValue = payload_ptr;
                if (offsets[pos] != 0) {
                    const byte_off: LValue = LType::const_int(
                        LType::i64(), offsets[pos], false);
                    const obuf: void* = intrinsics::malloc(8);
                    const obuf_arr: void** = obuf as void**;
                    obuf_arr[0] = byte_off.raw;
                    field_ptr_raw = this.cg.builder.build_gep(
                        LType::i8(), payload_ptr, obuf, 1, "enum.field.ptr");
                    intrinsics::free(obuf);
                }
                const field_ptr: LValue = this.cg.builder.build_bitcast(
                    field_ptr_raw, LType::pointer_to(field_llvm), "enum.field.cast");

                // Register the ptr-to-payload as a named lvalue.  Reads through
                // the binding will load via `codegen_rvalue` using the
                // identifier's resolved_type.
                if (field_ptr.is_valid()) {
                    this.cg.set_named_value(epat.binding_names[bi], field_ptr);
                }
            }

            // Only bind for the first enum pattern in this arm (multi-pattern
            // arms with different variants can't share bindings anyway).
            return;
        }
    }

    /// Emit the comparison chain for one match arm into the current block.
    /// Handles OR-patterns (`a | b | c => ...`): every pattern is tested in
    /// turn, each branching to `arm_bb` on a hit; a miss falls through to the
    /// next pattern's test, and the final miss falls through to `next_bb`.
    /// A wildcard pattern branches unconditionally (later OR alternatives are
    /// dead).  `name_prefix` namespaces the synthesised intermediate blocks
    /// ("match" for statement matches, "mexpr" for expression matches).
    ///
    /// Shared by `visit(MatchStmtNode*)` and `visit(MatchExprNode*)`: the
    /// per-pattern lowering is identical between them; only the block-name
    /// prefix differs.  On return the builder is positioned at whichever
    /// block emitted the last test (always terminated); the caller is free to
    /// reposition to `next_bb` for the following arm.
    emit_match_arm_comparison(mut &this, arm: MatchArmNode*,
            arm_bb: LBasicBlock, next_bb: LBasicBlock,
            minfo: MatchSubjectInfo, is_string_subj: boolean,
            subject: LValue, current_fn: LValue,
            name_prefix: string) -> void {
        const npat: i64 = arm.patterns.length;
        for (mut p: i64 = 0; p < npat; p++) {
            const pat: PatternNode* = arm.patterns[p];
            if (pat == null) { continue; }

            // Where control goes if THIS pattern doesn't match: the next
            // pattern's test for an OR-arm, otherwise the next arm's test
            // (`next_bb`).  Each non-final OR alternative gets its own block
            // so a miss on `a` still reaches the test for `b` in `a | b`.
            const is_last: boolean = (p + 1 >= npat);
            mut miss_bb: LBasicBlock = next_bb;
            if (!is_last) {
                miss_bb = LBasicBlock::append(current_fn,
                    format("%s.or", name_prefix));
            }

            if (pat.pattern_kind == PatternKind::Wildcard) {
                // Wildcard matches unconditionally; branch straight to the
                // arm body; any later OR alternatives are unreachable.
                this.cg.builder.build_br(arm_bb);
                return;
            }

            mut cmp: LValue = LValue::null();
            if (pat.pattern_kind == PatternKind::Literal
                || pat.pattern_kind == PatternKind::Identifier) {
                // For string subjects, build the pattern as a global string
                // pointer and compare via strcmp; `codegen_pattern_value`
                // lowers every literal to an i32 and would compare pointer
                // bits, not content.
                if (is_string_subj) {
                    const pat_text: string = this.cg.resolve(pat.value);
                    const pat_val: LValue =
                        this.cg.get_or_create_string_literal(pat_text);
                    codegen_string_compare(this.cg, subject, pat_val,
                        TokenType::EqualEqual, &cmp);
                } else {
                    const pat_val: LValue =
                        this.codegen_pattern_value(pat, minfo.subject_ty);
                    if (pat_val.is_valid()) {
                        const pat_val_coerced: LValue =
                            coerce_icmp_operands(this.cg, subject, pat_val,
                                                 minfo.subject_ty);
                        cmp = this.cg.builder.build_icmp(LIntPredicate::EQ,
                            subject, pat_val_coerced,
                            format("%s.cmp", name_prefix));
                    }
                }
            } else if (pat.pattern_kind == PatternKind::Enum) {
                // Enum pattern: compare the subject's tag to the variant tag.
                if (minfo.enum_type != null && minfo.tag_val.is_valid()) {
                    const epat: EnumPatternNode* = pat as EnumPatternNode*;
                    const variant: EnumVariantInfo* =
                        minfo.enum_type.get_variant(epat.variant_name);
                    if (variant != null) {
                        const pat_val: LValue = LType::const_int(
                            LType::i32(), variant.tag_value, false);
                        cmp = this.cg.builder.build_icmp(LIntPredicate::EQ,
                            minfo.tag_val, pat_val,
                            format("%s.cmp", name_prefix));
                    }
                }
            }

            if (cmp.is_valid()) {
                this.cg.builder.build_cond_br(cmp, arm_bb, miss_bb);
            } else {
                // Pattern produced no comparison (a codegen gap); treat it
                // as an unconditional miss so control still reaches the rest
                // of the chain rather than leaving the block unterminated.
                const cur: LBasicBlock = this.cg.builder.get_insert_block();
                if (cur.is_valid() && !cur.has_terminator()) {
                    this.cg.builder.build_br(miss_bb);
                }
            }

            if (!is_last) {
                this.cg.builder.position_at_end(miss_bb);
            }
        }

        // No pattern terminated the current block (empty / all-null pattern
        // list, or a trailing pattern that produced no comparison); fall
        // through to the next arm so the IR stays well-formed.
        const tail: LBasicBlock = this.cg.builder.get_insert_block();
        if (tail.is_valid() && !tail.has_terminator()) {
            this.cg.builder.build_br(next_bb);
        }
    }

    /// Evaluate a pattern to an LLVM value for comparison.
    /// `subj_ty` is the Cryo type of the match subject: integer-literal
    /// patterns are built at the subject's integer width and signedness so
    /// `match (x: i64) { -1 => ... }` compares against a real i64 `-1`
    /// instead of a zero-extended-from-i32 `0x00000000FFFFFFFF`.
    codegen_pattern_value(mut &this, pat: PatternNode*, subj_ty: TypeRef) -> LValue {
        if (pat.pattern_kind == PatternKind::Literal) {
            // `pat.literal_kind` (set by the parser) says how to read the
            // interned `value` text.  It can't be guessed from the text:
            // `0` (Integer) and `'0'` (Char) both intern to "0", and
            // `true`/`false` intern to "true"/"false".  The old length
            // heuristic ("1 char ⇒ char literal") mis-emitted every
            // single-digit integer pattern as a char and every boolean
            // pattern as 0; so e.g. `match (n) { 0 => ... }` never fired.
            const intern: InternTable* = this.cg.get_intern();
            const text: string = intern.resolve(pat.value);
            if (pat.literal_kind == LiteralKind::Char) {
                return LType::const_int(LType::i32(),
                                        decode_char_lexeme(text), false);
            }
            if (pat.literal_kind == LiteralKind::Boolean) {
                const bval: u64 = if (text == "true") { 1 } else { 0 };
                return LType::const_int(LType::i1(), bval, false);
            }
            if (pat.literal_kind == LiteralKind::Integer) {
                // Build the literal at the subject's integer width so the
                // icmp operands match without a lossy widen.  Falls back to
                // i32 when the subject type isn't a resolvable integer.
                mut lit_ty: LType = LType::i32();
                mut lit_signed: boolean = true;
                const subj_t: Type* = this.cg.lookup_type_by_id(subj_ty.id);
                if (subj_t != null && subj_t.kind == TypeKind::Int) {
                    const mapped: LType = this.cg.type_mapper.map_type(subj_ty);
                    if (mapped.is_valid()
                            && type_kind_of(mapped.raw) == LTypeKind::Integer) {
                        lit_ty = mapped;
                    }
                    lit_signed = this.cg.int_type_is_signed(subj_ty);
                }
                return LType::const_int(lit_ty, parse_int_lexeme(text), lit_signed);
            }
            // String / Float literal patterns don't lower to an `icmp`
            // operand here: a string pattern is routed through the caller's
            // string-compare branch before reaching this, and a float
            // literal pattern is not currently supported.
            return LValue::null();
        } else if (pat.pattern_kind == PatternKind::Identifier) {
            // Identifier pattern: could be an enum variant name.
            // Look it up as a named value or try to resolve as an enum discriminant.
            const val: LValue = this.cg.get_named_value(pat.value);
            if (val.is_valid()) {
                // Load the named value.
                const ty: LType = LType::i32();
                return this.cg.builder.build_load(ty, val, "pat.load");
            }
            // Try as a scope-resolved enum variant (e.g., TokenType::Plus).
            // The value field might contain just the variant name.
            // For simple enums, variants are sequential i32 constants.
            // This needs the enum type info to resolve the discriminant.
            return LValue::null();
        }
        return LValue::null();
    }

    override visit(mut &this, node: DeclStmtNode*) -> void {
        if (node.declaration != null) {
            // Double-dispatch via accept(); runtime type picks the
            // right `override visit(VarDeclNode*)` or
            // `override visit(DestructureDeclNode*)`.  Other declaration
            // kinds inside a stmt-level decl are silently ignored
            // (BaseASTVisitor's no-op default).
            node.declaration.accept(this);
        }
    }

    override visit(mut &this, node: VarDeclNode*) -> void {
        if (node.is_global) { return; }
        mut init_val: LValue = LValue::null();
        const has_init: boolean = node.initializer != null;
        if (has_init) {
            init_val = this.codegen_rvalue(node.initializer);
        }
        codegen_local_var(this.cg, node.name, node.resolved_type,
                          init_val, has_init, node.span);
    }

    /// Lower a struct destructure declaration into N field reads + N allocas.
    /// Picks `extractvalue` (for SSA struct values) vs `struct_gep + load`
    /// (for stored structs) per source, same dispatch as codegen_member_access.
    override visit(mut &this, node: DestructureDeclNode*) -> void {
        if (node.initializer == null) { return; }
        if (!node.resolved_type.is_valid()) { return; }

        // Pull the struct fields off the resolved type so we can map binding
        // names → field indices.
        const ty: Type* = this.cg.lookup_type_by_id(node.resolved_type.id);
        if (ty == null) { return; }

        mut fields_arr: FieldInfo[] = [];
        if (ty.kind == TypeKind::Struct) {
            const st: StructType* = ty as StructType*;
            fields_arr = st.fields;
        } else if (ty.kind == TypeKind::Class) {
            const ct: ClassType* = ty as ClassType*;
            fields_arr = ct.fields;
        } else {
            return;  // sema already errored on non-struct destructure
        }

        const struct_lty: LType = this.cg.type_mapper.map_type(node.resolved_type);
        if (!struct_lty.is_valid()) { return; }

        // Codegen the initializer once.  `last_value`/`last_is_lvalue` after
        // generate_expression mirror the conventions used by member-access:
        // an alloca pointer (lvalue) or an SSA struct value (rvalue).  The
        // LLVMTypeOf check below is the same defensive recheck that
        // codegen_member_access does; under opaque pointers an alloca
        // address is `ptr` (kind 12), so a kind-10 (struct) means the
        // value is already in SSA form, regardless of last_is_lvalue.
        this.generate_expression(node.initializer);
        const src_val: LValue = this.last_value;
        if (!src_val.is_valid()) { return; }

        const src_llvm_ty: void* = llvm::LLVMTypeOf(src_val.raw);
        const src_is_struct_value: boolean = src_llvm_ty != null
            && type_kind_of(src_llvm_ty) == LTypeKind::Struct;

        for (mut i: i64 = 0; i < node.bindings.length; i++) {
            const b: DestructureBinding = node.bindings[i];
            if (!b.resolved_type.is_valid()) { continue; }

            mut field_idx: i64 = -1;
            for (mut k: i64 = 0; k < fields_arr.length; k++) {
                if (fields_arr[k].name.id == b.source_field.id) {
                    field_idx = k;
                    break;
                }
            }
            if (field_idx < 0) { continue; }

            mut field_val: LValue = LValue::null();
            if (src_is_struct_value) {
                field_val = this.cg.builder.build_extract_value(
                    src_val, field_idx as u32, "destruct.field");
            } else {
                const field_ptr: LValue = this.cg.builder.build_struct_gep(
                    struct_lty, src_val, field_idx as u32, "destruct.fieldptr");
                const field_lty: LType = this.cg.type_mapper.map_type(b.resolved_type);
                if (!field_lty.is_valid()) { continue; }
                field_val = this.cg.builder.build_load(field_lty, field_ptr, "destruct.fieldval");
            }

            codegen_local_var(this.cg, b.local_name, b.resolved_type,
                              field_val, true, b.span);
        }
    }


    // ========================================================================
    // Expression helpers
    // ========================================================================

    /// Codegen an expression and return the resulting value.
    codegen_expr(mut &this, expr: ExpressionNode*) -> LValue {
        if (expr == null) { return LValue::null(); }
        this.generate_expression(expr);
        return this.last_value;
    }

    /// Codegen an expression, ensuring the result is an rvalue (loaded).
    codegen_rvalue(mut &this, expr: ExpressionNode*) -> LValue {
        if (expr == null) { return LValue::null(); }
        this.generate_expression(expr);

        if (this.last_is_lvalue && this.last_value.is_valid()) {
            // String-index special case: char is i32 but string storage
            // is i8 per byte.  `codegen_array_access` returns the byte's
            // i8* as lvalue; here we do the i8-load-and-zext so the
            // value has the expected char/i32 type.  Generic map_type
            // load would read 4 bytes from an i8 slot (walking into
            // neighbouring bytes), which is wrong.
            if (expr.kind == NodeKind::ArrayAccess) {
                const aa: ArrayAccessNode* = expr as ArrayAccessNode*;
                const arr_t: Type* = this.cg.lookup_type_by_id(aa.array.resolved_type.id);
                if (arr_t != null && arr_t.kind == TypeKind::String) {
                    const byte: LValue = this.cg.builder.build_load(
                        LType::i8(), this.last_value, "charbyte");
                    this.last_value = this.cg.builder.build_zext(
                        byte, LType::i32(), "char");
                    this.last_is_lvalue = false;
                    return this.last_value;
                }
            }
            // Same special case for `*string`: lex_token does
            // `mut c: char = *this.current as char` to read one ASCII byte.
            // The generic load reads `map_type(char) = i32` (4 bytes), which
            // is wrong for an i8-sized backing store.  Emit i8-load + zext-to-i32.
            if (expr.kind == NodeKind::UnaryExpression) {
                const ue: UnaryExprNode* = expr as UnaryExprNode*;
                if (ue.op.kind == TokenType::Star) {
                    const op_t: Type* = this.cg.lookup_type_by_id(ue.operand.resolved_type.id);
                    if (op_t != null && op_t.kind == TypeKind::String) {
                        const byte: LValue = this.cg.builder.build_load(
                            LType::i8(), this.last_value, "strbyte");
                        this.last_value = this.cg.builder.build_zext(
                            byte, LType::i32(), "char");
                        this.last_is_lvalue = false;
                        return this.last_value;
                    }
                }
            }
            // Variadic bucket: `args` in a variadic function body is
            // bound to a `[24 x i8]` va_list alloca.  When referenced
            // as an rvalue (e.g., forwarded to `vformat(fmt, args)`),
            // return the alloca pointer directly rather than loading;
            // loading the raw [24 x i8] array value isn't meaningful
            // for va_list forwarding, which always takes a pointer.
            if (expr.kind == NodeKind::Identifier) {
                const ident: IdentifierNode* = expr as IdentifierNode*;
                if (this.cg.current_variadic_arg_id != 0 &&
                    ident.name.id == this.cg.current_variadic_arg_id) {
                    this.last_is_lvalue = false;
                    return this.last_value;
                }
            }
            const ty: LType = this.cg.type_mapper.map_type(expr.resolved_type);
            if (ty.is_valid()) {
                const loaded: LValue = this.cg.builder.build_load(ty, this.last_value, "load");
                this.last_value = loaded;
            }
            this.last_is_lvalue = false;
        }
        return this.last_value;
    }

    /// Codegen an expression, ensuring the result is an lvalue (address).
    codegen_lvalue(mut &this, expr: ExpressionNode*) -> LValue {
        if (expr == null) { return LValue::null(); }
        this.generate_expression(expr);
        return this.last_value;
    }


    // ========================================================================
    // Expression dispatch (by NodeKind)
    // ========================================================================

    /// Dispatch an expression via double-dispatch (`expr.accept(this)`).
    /// Each expression kind has its own `override visit(SpecificType*)`
    /// below.  Unknown kinds fall through to BaseASTVisitor's no-op
    /// defaults; `last_value` stays at its previous value, which the
    /// caller (codegen_rvalue / codegen_lvalue) treats as "no result".
    generate_expression(mut &this, expr: ExpressionNode*) -> void {
        if (expr == null) { return; }
        cdebug("[IRGen]             expr kind=%s\n", expr.kind.to_string());
        expr.accept(this);
    }

    override visit(mut &this, node: LiteralNode*) -> void {
        codegen_literal(this.cg, node,
                        &this.last_value, &this.last_is_lvalue);
    }

    override visit(mut &this, node: IdentifierNode*) -> void {
        codegen_identifier(this.cg, node,
                           &this.last_value, &this.last_is_lvalue);
    }

    override visit(mut &this, node: MemberAccessNode*) -> void {
        const obj: LValue = this.codegen_lvalue(node.object);
        // Mirror codegen_array_access: capture last_is_lvalue from
        // generating the receiver expression. `f().field` leaves
        // last_is_lvalue=false so the autoderef inside member-access
        // codegen knows not to over-load the call's pointer rvalue.
        const obj_is_lvalue: boolean = this.last_is_lvalue;
        codegen_member_access(this.cg, obj, node.object.resolved_type,
                              obj_is_lvalue, node.member,
                              &this.last_value, &this.last_is_lvalue,
                              node.span);
    }

    override visit(mut &this, node: ArrayAccessNode*) -> void {
        // Tuple bracket indexing is a struct GEP. Sema validated the
        // index at compile time, so we can read the literal value
        // here and skip codegen_array_access entirely (which is sized
        // around dynamic-index arrays/strings/pointers).
        if (this.try_codegen_tuple_index(node)) {
            return;
        }
        const arr: LValue = this.codegen_lvalue(node.array);
        // codegen_lvalue is misnamed; it doesn't enforce lvalue-ness,
        // it just returns whatever generate_expression produced.  For
        // `f()[i]` the call leaves last_is_lvalue=false, telling the
        // array-access codegen to skip the lvalue load it would do
        // for a stored pointer.
        const arr_is_lvalue: boolean = this.last_is_lvalue;
        const idx: LValue = this.codegen_rvalue(node.index);
        codegen_array_access(this.cg, arr, node.array.resolved_type,
                             arr_is_lvalue, idx,
                             &this.last_value, &this.last_is_lvalue,
                             node.span);
    }

    override visit(mut &this, node: CastExprNode*) -> void {
        const src_t: Type* = this.cg.lookup_type_by_id(node.expression.resolved_type.id);
        const dst_t: Type* = this.cg.lookup_type_by_id(node.resolved_target.id);
        const dst_is_ptr_like: boolean = dst_t != null &&
            (dst_t.kind == TypeKind::Pointer || dst_t.kind == TypeKind::String);

        if (src_t != null && dst_t != null &&
            dst_t.kind == TypeKind::Pointer &&
            (src_t.kind == TypeKind::Class || src_t.kind == TypeKind::Struct)) {
            // Class/Struct value → Pointer: reference upcast.  The
            // object's lvalue is already a pointer to storage;
            // pointer-cast it to the target pointer type.  Avoids
            // the illegal `bitcast %struct to ptr` that would
            // otherwise come out of the generic cast path.
            const addr: LValue = this.codegen_lvalue(node.expression);
            const dst_lty: LType = this.cg.type_mapper.map_type(node.resolved_target);
            if (addr.is_valid() && dst_lty.is_valid()) {
                this.last_value = this.cg.builder.build_pointer_cast(
                    addr, dst_lty, "upcast");
            } else {
                this.last_value = addr;
            }
            this.last_is_lvalue = false;
        } else if (src_t != null && dst_is_ptr_like &&
                   src_t.kind == TypeKind::Array) {
            // Array → Pointer / String: extract the data-pointer
            // field from the fat-pointer `{ptr, i64}` struct.
            // Fixed arrays (`[N x T]`) don't have a fat pointer;
            // their lvalue is already a pointer to the storage, so
            // pointer-cast that directly.  For dynamic arrays we
            // need an explicit extract to avoid the illegal
            // `bitcast { ptr, i64 } to ptr` that the generic path
            // emits.
            const arr_t: ArrayType* = src_t as ArrayType*;
            const dst_lty: LType = this.cg.type_mapper.map_type(node.resolved_target);
            if (arr_t.is_fixed()) {
                const addr: LValue = this.codegen_lvalue(node.expression);
                if (addr.is_valid() && dst_lty.is_valid()) {
                    this.last_value = this.cg.builder.build_pointer_cast(
                        addr, dst_lty, "arrcast");
                } else {
                    this.last_value = addr;
                }
            } else {
                const val: LValue = this.codegen_rvalue(node.expression);
                const data_ptr: LValue = this.cg.builder.build_extract_value(
                    val, 0, "arrdata");
                if (data_ptr.is_valid() && dst_lty.is_valid()) {
                    this.last_value = this.cg.builder.build_pointer_cast(
                        data_ptr, dst_lty, "arrcast");
                } else {
                    this.last_value = data_ptr;
                }
            }
            this.last_is_lvalue = false;
        } else {
            const val: LValue = this.codegen_rvalue(node.expression);
            codegen_cast(this.cg, val, node.expression.resolved_type,
                         node.resolved_target, &this.last_value);
            this.last_is_lvalue = false;
        }
    }

    override visit(mut &this, node: SizeofExprNode*) -> void {
        mut sz_type_ref: TypeRef = this.resolve_sizeof_operand_type(node.type_ann);
        if (!sz_type_ref.is_valid()) {
            sz_type_ref = this.lookup_type(node.type_name);
        }
        codegen_sizeof(this.cg, sz_type_ref, &this.last_value);
        this.last_is_lvalue = false;
    }

    override visit(mut &this, node: AlignofExprNode*) -> void {
        mut al_type_ref: TypeRef = this.resolve_sizeof_operand_type(node.type_ann);
        if (!al_type_ref.is_valid()) {
            al_type_ref = this.lookup_type(node.type_name);
        }
        codegen_alignof(this.cg, al_type_ref, &this.last_value);
        this.last_is_lvalue = false;
    }

    override visit(mut &this, node: IfExprNode*) -> void {
        // IfExpr has the same field layout as TernaryExpr; delegate
        // to keep a single codegen path for both shapes.
        this.visit(node as TernaryExprNode*);
    }


    // ========================================================================
    // Expression visitors
    // ========================================================================

    /// Binary expression: direct dispatch.
    override visit(mut &this, node: BinaryExprNode*) -> void {
        const op: TokenType = node.op.kind;

        // Assignment
        if (op == TokenType::Equal) {
            const addr: LValue = this.codegen_lvalue(node.left);
            const val: LValue = this.codegen_rvalue(node.right);
            if (!addr.is_valid() || !val.is_valid()) {
                mut diag: Diagnostic = Diagnostic::error(
                    ErrorCode::E0614_ASSIGNMENT_ERROR,
                    "codegen: assignment: target or value produced null");
                diag = diag.at(node.span);
                if (!addr.is_valid()) {
                    diag = diag.also_at(node.left.span, "left-hand side did not produce a valid lvalue");
                }
                if (!val.is_valid()) {
                    diag = diag.also_at(node.right.span, "right-hand side did not produce a valid rvalue");
                }
                this.cg.emit_diagnostic(diag);
                this.last_value = LValue::null();
                this.last_is_lvalue = false;
                return;
            }
            // Narrow-store fix: the LHS may be an i8 slot (string char,
            // pointer-to-i8 element, array-of-i8 element) while the RHS
            // is an i32 char or other wider int.  LLVM's `store` writes
            // the value's full width; without truncation we'd emit a
            // 4-byte i32 store over a 1-byte slot, clobbering the next
            // 3 bytes.  This is what produced the `name_buf[k] = '_'`
            // miscompile in passes.cryo (only the first colon was
            // replaced; the next 3 bytes became zeros).
            //
            // Decide based on the destination element's *resolved type*
            // (i.e. the type of `node.left` itself) so this covers
            // String, Pointer-to-i8, and Array-of-i8 in a single check.
            mut store_val: LValue = val;
            const dest_t: Type* = this.cg.lookup_type_by_id(node.left.resolved_type.id);
            mut needs_chartrunc: boolean = false;
            if (dest_t != null) {
                if (dest_t.kind == TypeKind::Char) {
                    // `s[i] = c` where the indexable is a Cryo `string`:
                    // the destination type maps to char (i32 at semantic
                    // level) but the underlying byte slot is i8.
                    needs_chartrunc = true;
                } else if (dest_t.kind == TypeKind::Int) {
                    const it: IntType* = dest_t as IntType*;
                    if (it.int_kind == IntegerKind::I8 ||
                        it.int_kind == IntegerKind::U8) {
                        needs_chartrunc = true;
                    }
                }
            }
            if (needs_chartrunc) {
                store_val = this.cg.builder.build_trunc(val, LType::i8(), "chartrunc");
            }
            this.cg.builder.build_store(store_val, addr);
            this.last_value = val;
            this.last_is_lvalue = false;
            return;
        }

        // Compound assignment.  Each compound op (`+=`, `-=`, `*=`, `/=`,
        // `%=`, `&=`, `|=`, `^=`, `<<=`, `>>=`) loads the LHS, computes the
        // arithmetic / bitwise / shift result using its base operator, then
        // stores the narrowed result back.  Bitwise (`&=`/`|=`/`^=`) and
        // shift (`<<=`/`>>=`) were silently miscompiled before; the
        // BinaryExprNode fell through to the "regular binary" path below,
        // which calls codegen_rvalue(left) (a load) and codegen_binary
        // with the compound op kind, producing an expression result but
        // never storing it back.
        if (op == TokenType::PlusEqual    || op == TokenType::MinusEqual ||
            op == TokenType::StarEqual    || op == TokenType::SlashEqual ||
            op == TokenType::PercentEqual ||
            op == TokenType::AmpEqual     || op == TokenType::PipeEqual  ||
            op == TokenType::CaretEqual   ||
            op == TokenType::LessLessEqual || op == TokenType::GreaterGreaterEqual) {
            const addr: LValue = this.codegen_lvalue(node.left);
            if (!addr.is_valid()) {
                mut diag: Diagnostic = Diagnostic::error(
                    ErrorCode::E0614_ASSIGNMENT_ERROR,
                    "codegen: compound assignment target produced null lvalue");
                diag = diag.at(node.span);
                diag = diag.also_at(node.left.span, "this expression must be assignable");
                this.cg.emit_diagnostic(diag);
                this.last_value = LValue::null();
                this.last_is_lvalue = false;
                return;
            }
            const lhs_ty: LType = this.cg.type_mapper.map_type(node.left.resolved_type);
            if (!lhs_ty.is_valid()) {
                this.cg.emit_error_at_span(ErrorCode::E0609_TYPE_MAPPING_ERROR,
                    "codegen: compound assignment: failed to map left-hand side type",
                    node.left.span);
                this.last_value = LValue::null();
                this.last_is_lvalue = false;
                return;
            }
            const lhs_loaded: LValue = this.cg.builder.build_load(lhs_ty, addr, "compoundlhs");
            const rhs: LValue = this.codegen_rvalue(node.right);
            const base_op: TokenType = match (op) {
                TokenType::PlusEqual          => { TokenType::Plus    }
                TokenType::MinusEqual         => { TokenType::Minus   }
                TokenType::StarEqual          => { TokenType::Star    }
                TokenType::SlashEqual         => { TokenType::Slash   }
                TokenType::PercentEqual       => { TokenType::Percent }
                TokenType::AmpEqual           => { TokenType::Amp     }
                TokenType::PipeEqual          => { TokenType::Pipe    }
                TokenType::CaretEqual         => { TokenType::Caret   }
                TokenType::LessLessEqual      => { TokenType::LessLess }
                TokenType::GreaterGreaterEqual => { TokenType::GreaterGreater }
                _                             => { TokenType::Plus }
            };
            mut result: LValue = LValue::null();
            codegen_binary(this.cg, lhs_loaded, rhs, base_op, node.resolved_type, &result);
            // Narrow-store fix: codegen_binary normalizes operand widths to
            // the wider of lhs/rhs, so when the LHS slot is a narrow int
            // (char / i8 / u8) and the RHS is wider, `result` is wider than
            // the destination.  `store` writes the full result width; left
            // unfixed, `buf[k] += '_'` over an i8 slot clobbers the next
            // 3 bytes, the same class of bug that produced the chartrunc
            // path on the plain `=` branch above.  Truncate when the
            // stored type's LLVM width exceeds the destination slot's.
            mut store_val: LValue = result;
            if (result.is_valid()) {
                const res_ty: void* = llvm::LLVMTypeOf(result.raw);
                if (type_kind_of(res_ty) == LTypeKind::Integer &&
                    type_kind_of(lhs_ty.raw) == LTypeKind::Integer) {
                    const res_w: u32 = llvm::LLVMGetIntTypeWidth(res_ty);
                    const lhs_w: u32 = llvm::LLVMGetIntTypeWidth(lhs_ty.raw);
                    if (res_w > lhs_w) {
                        store_val = this.cg.builder.build_trunc(result, lhs_ty, "compound.trunc");
                    }
                }
            }
            this.cg.builder.build_store(store_val, addr);
            this.last_value = store_val;
            this.last_is_lvalue = false;
            return;
        }

        // Logical short-circuit
        if (op == TokenType::AmpAmp || op == TokenType::PipePipe) {
            this.visit_logical_short_circuit(node);
            return;
        }

        // Regular binary
        const lhs: LValue = this.codegen_rvalue(node.left);
        const rhs: LValue = this.codegen_rvalue(node.right);
        mut result: LValue = LValue::null();
        codegen_binary(this.cg, lhs, rhs, op, node.left.resolved_type, &result);
        this.last_value = result;
        this.last_is_lvalue = false;
    }

    /// Unary expression: direct dispatch.
    override visit(mut &this, node: UnaryExprNode*) -> void {
        const op: TokenType = node.op.kind;
        if (op == TokenType::Star) {
            const op_t: Type* = this.cg.lookup_type_by_id(node.operand.resolved_type.id);
            mut is_ptr_like: boolean = false;
            if (op_t != null) {
                is_ptr_like = op_t.kind == TypeKind::Pointer ||
                              op_t.kind == TypeKind::Reference ||
                              op_t.kind == TypeKind::String;
            }
            mut deref_addr: LValue = LValue::null();
            if (is_ptr_like) {
                // Pointer/reference operand: codegen_rvalue loads the
                // operand's value (the pointer itself), giving us the
                // address to dereference.
                deref_addr = this.codegen_rvalue(node.operand);
            } else {
                // Value-typed operand reached `*`; this is the
                // method-receiver case where sema types `this` as the
                // bare owner (`Option<T>`, etc.) but the ABI passes a
                // pointer.  codegen_lvalue yields the address of the
                // operand's storage; loading it produces the value.
                deref_addr = this.codegen_lvalue(node.operand);
            }
            if (!deref_addr.is_valid()) {
                this.last_value = LValue::null();
                this.last_is_lvalue = false;
                return;
            }
            // The dereferenced expression is always an lvalue: it
            // names a memory location that callers can either read
            // (via codegen_rvalue → emit a load) or write (via the
            // assignment path → use as a store destination).  The
            // previous code set `last_is_lvalue = is_ptr_like`, which
            // dropped the load step for value-typed operands and
            // stored the *address bits* in place of the dereferenced
            // value, observable as `const x: Option<T> = *this`
            // emitting `store ptr %this, ptr %x` instead of the
            // 32-byte value copy, garbaging the enum discriminant.
            this.last_value = deref_addr;
            this.last_is_lvalue = true;
            return;
        }
        if (op == TokenType::Amp) {
            // codegen_lvalue runs generate_expression and returns last_value;
            // it doesn't enforce lvalue-ness.  When the operand is an rvalue
            // (literal, call result, arithmetic), `last_value` IS the value
            // itself, not an address.  Returning it here makes `&literal`
            // lower to `inttoptr (i32 N to ptr)` once arg coercion converts
            // the i32 to ptr; every callee that dereferences then crashes.
            // Materialize an rvalue into a stack temp and pass that addr.
            const v: LValue = this.codegen_lvalue(node.operand);
            if (!v.is_valid()) {
                this.last_value = LValue::null();
                this.last_is_lvalue = false;
                return;
            }
            mut addr: LValue = v;
            if (!this.last_is_lvalue) {
                const ty: LType = this.cg.type_mapper.map_type(node.operand.resolved_type);
                if (ty.is_valid()) {
                    addr = this.cg.builder.build_alloca(ty, "addrof.tmp");
                    this.cg.builder.build_store(v, addr);
                }
            }
            this.last_value = addr;
            this.last_is_lvalue = false;
            return;
        }
        if (op == TokenType::PlusPlus || op == TokenType::MinusMinus) {
            const addr: LValue = this.codegen_lvalue(node.operand);
            const ty: LType = this.cg.type_mapper.map_type(node.operand.resolved_type);
            if (!addr.is_valid() || !ty.is_valid()) {
                this.last_value = LValue::null();
                this.last_is_lvalue = false;
                return;
            }
            const old: LValue = this.cg.builder.build_load(ty, addr, "incdec.old");
            // Pointer ++/-- must lower to a GEP over the pointee, not an
            // integer add; LLVM rejects `add ptr, i64`.  `++p` advances
            // one pointee-sized slot; `--p` retreats one.  Mirrors the
            // `ptr + int` path in codegen_binary (expr_codegen.cryo).
            const op_t: Type* = this.cg.lookup_type_by_id(node.operand.resolved_type.id);
            mut is_ptr: boolean = false;
            mut elem_ty_ref: TypeRef = TypeRef::invalid();
            if (op_t != null) {
                if (op_t.kind == TypeKind::Pointer) {
                    is_ptr = true;
                    const ptr_t: PointerType* = op_t as PointerType*;
                    elem_ty_ref = ptr_t.pointee;
                } else if (op_t.kind == TypeKind::Reference) {
                    is_ptr = true;
                    const ref_t: ReferenceType* = op_t as ReferenceType*;
                    elem_ty_ref = ref_t.referent;
                }
            }
            mut updated: LValue = LValue::null();
            if (is_ptr) {
                const pointee_lty: LType = this.cg.type_mapper.map_type(elem_ty_ref);
                if (!pointee_lty.is_valid()) {
                    this.last_value = LValue::null();
                    this.last_is_lvalue = false;
                    return;
                }
                const step: i64 = if (op == TokenType::PlusPlus) { 1 } else { -1 };
                const idx_val: LValue = LType::const_int(LType::i64(), step as u64, true);
                const buf: void* = intrinsics::malloc(8);
                const slots: void** = buf as void**;
                slots[0] = idx_val.raw;
                updated = this.cg.builder.build_gep(
                    pointee_lty, old, buf, 1, "incdec.gep");
                intrinsics::free(buf);
            } else {
                const one: LValue = LType::const_int(ty, 1, false);
                updated = if (op == TokenType::PlusPlus) {
                    this.cg.builder.build_add(old, one, "inctmp")
                } else {
                    this.cg.builder.build_sub(old, one, "dectmp")
                };
            }
            this.cg.builder.build_store(updated, addr);
            // Postfix `a++` / `a--` returns the pre-update value; prefix
            // `++a` / `--a` returns the updated value.  Without this
            // branch (and the matching is_postfix discriminator on
            // UnaryExprNode), every form returned the old value, so
            // `const x: int = ++b;` bound x to b's pre-increment value.
            this.last_value = if (node.is_postfix) { old } else { updated };
            this.last_is_lvalue = false;
            return;
        }
        const operand: LValue = this.codegen_rvalue(node.operand);
        mut result: LValue = LValue::null();
        codegen_unary(this.cg, operand, op, node.operand.resolved_type, &result);
        this.last_value = result;
        this.last_is_lvalue = false;
    }

    /// Call expression: direct dispatch.
    override visit(mut &this, node: CallExprNode*) -> void {
        mut callee_val: LValue = LValue::null();

        // Break pointer chains into locals for C++ compiler compatibility.
        const ctx_ptr: CompilationContext* = this.cg.ctx;
        const intern: InternTable* = this.cg.get_intern();

        // Virtual-dispatch state: populated in the MemberAccess branch when
        // the static receiver type declares virtual methods and the called
        // method has a vtable slot.  If set, after we emit arg evaluation
        // and fn_ty lookup, we replace `callee_val` with a vtable-indexed
        // function-pointer load instead of a direct call to the statically
        // resolved function.
        mut vtable_dispatch: boolean = false;
        mut vtable_slot_idx: i32 = -1;
        mut vtable_obj_ref: TypeRef = TypeRef::invalid();

        if (node.callee.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = node.callee as IdentifierNode*;
            const id_arity: u32 = node.arguments.length as u32;

            // Intrinsics first: `i32_to_i64`, `ptr_add`, `bswap32`, etc.
            // are emitted as inline LLVM IR, not as real function calls,
            // so they have no LLVM definition.  If sema pinned
            // `resolved_callee` to an intrinsic's mangled name, the
            // module DOES contain an extern declaration (from
            // declare_function), but no module DEFINES the function;
            // calling it would emit a real call and the link step would
            // fail with `undefined reference`.  Run the inline dispatcher
            // up front to avoid that path.
            const intr_name_str: string = intern.resolve(id.name);
            mut intr_args: LValue[] = [];
            mut intr_args_evaluated: boolean = false;
            mut intr_result: LValue = LValue::null();
            if (is_intrinsic_name(intr_name_str)) {
                for (mut ai: i64 = 0; ai < node.arguments.length; ai++) {
                    intr_args.push(this.codegen_rvalue(node.arguments[ai]));
                }
                intr_args_evaluated = true;
                if (try_emit_intrinsic_call(this.cg, intr_name_str, intr_args, &intr_result)) {
                    this.last_value = intr_result;
                    this.last_is_lvalue = false;
                    return;
                }
            }

            // Trust sema: `resolved_callee` is the mangled LLVM symbol
            // chosen by overload resolution (or, for unique-name
            // functions, the canonical mangling registered by
            // declare_function).  Sema runs
            // `try_pin_overload_mangled_callee` on every Identifier
            // call, so any function known to the DeclarationIndex
            // (qualified, bare-aliased, overloaded, or unique) gets
            // pinned to its registered mangled symbol.  Codegen calls
            // `resolve_function_by_mangled` once on that symbol; the
            // qualified/bare/DI-mapping cascade that used to live here
            // was re-resolving names sema had already resolved.  See
            // memory/feedback_codegen_architecture_rules.md.
            if (node.resolved_callee.is_valid()) {
                callee_val = resolve_function_by_mangled(this.cg, node.resolved_callee);
            }

            // 3b. Class / struct constructor call: `ClassName(args)` resolves
            //     to the method named `ClassName` on the class itself,
            //     registered as `{qualified_class}::ClassName`.  Sema sets
            //     the call's resolved_type to the class type for this form.
            //     Unlike the `new` form (which heap-allocates), this emits
            //     a stack-local construction: alloca the object, call the
            //     constructor with the alloca pointer as `this`, then load
            //     the populated value so the caller sees an rvalue of the
            //     class type.
            if (!callee_val.is_valid()) {
                const di: DeclarationIndex* = this.cg.get_decl_index();
                mut type_ref: TypeRef = di.lookup_type(id.name);
                mut ctor_qn: SymbolStr = SymbolStr::empty();
                if (type_ref.is_valid()) {
                    const arena: TypeArena* = this.cg.get_arena();
                    ctor_qn = arena.get_qualified_name(type_ref);
                }
                if (!ctor_qn.is_valid()) {
                    const resolved: SymbolStr = di.resolve_qualified(id.name);
                    if (resolved.is_valid() && !resolved.equals(id.name)) {
                        ctor_qn = resolved;
                        // Refetch the type through the qualified alias
                        // (cross-module types only reachable via DI's
                        // bare→qualified map).
                        if (!type_ref.is_valid()) {
                            type_ref = di.lookup_type(ctor_qn);
                        }
                    }
                }
                if (ctor_qn.is_valid() && type_ref.is_valid()) {
                    const qn_str: string = intern.resolve(ctor_qn);
                    const bare_str: string = intern.resolve(id.name);
                    const combined: string = format("%s::%s", qn_str, bare_str);
                    const ctor_sym: SymbolStr = intern.intern(combined);
                    // Constructor LLVM arity = user args + 1 for `this`.
                    const ctor_arity: u32 = (node.arguments.length + 1) as u32;
                    mut ctor_fn: LValue = resolve_function_with_arity(this.cg, ctor_sym, ctor_arity);
                    if (!ctor_fn.is_valid()) {
                        ctor_fn = resolve_function(this.cg, ctor_sym);
                    }
                    if (ctor_fn.is_valid()) {
                        const mapped: LType = this.cg.type_mapper.map_type(type_ref);
                        const current_fn: LValue = this.get_current_function();
                        if (mapped.is_valid() && current_fn.is_valid()) {
                            const obj_alloca: LValue = this.cg.create_entry_alloca(
                                current_fn, "ctor.tmp", mapped);
                            // Vtable slot for classes with virtual methods.
                            const t_for_vtbl: Type* = this.cg.lookup_type_by_id(type_ref.id);
                            if (t_for_vtbl != null && t_for_vtbl.kind == TypeKind::Class) {
                                const cls_vtbl: ClassType* = t_for_vtbl as ClassType*;
                                if (cls_vtbl.has_virtual_methods) {
                                    const qname: QualifiedName = QualifiedName::from_symbol(ctor_qn);
                                    const vtbl_name: string = MangledName::for_vtable(
                                        intern, qname).resolve(intern);
                                    mut vtbl_global: LValue = this.cg.llvm_module.get_named_global(vtbl_name);
                                    if (!vtbl_global.is_valid()) {
                                        // Cross-module reference: declare the
                                        // vtable as extern.  Mirrors the new-
                                        // expression path: the placeholder type
                                        // doesn't need to match the definition
                                        // exactly (opaque pointers), the linker
                                        // resolves by symbol name.  Without
                                        // this, constructor calls into a class
                                        // defined in another module skip the
                                        // vptr init entirely and any virtual
                                        // dispatch on the result reads garbage.
                                        const fn_ptr_ty: LType = LType::pointer_to(LType::i8());
                                        const placeholder_ty: LType = LType::array_of(fn_ptr_ty, 1);
                                        vtbl_global = this.cg.llvm_module.add_global(placeholder_ty, vtbl_name);
                                    }
                                    if (vtbl_global.is_valid()) {
                                        const vptr_slot: LValue = this.cg.builder.build_struct_gep(
                                            mapped, obj_alloca, 0, "vptr.slot");
                                        if (vptr_slot.is_valid()) {
                                            this.cg.builder.build_store(vtbl_global, vptr_slot);
                                        }
                                    }
                                }
                            }
                            const ctor_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(ctor_fn.raw) };
                            if (ctor_ty.is_valid() && type_kind_of(ctor_ty.raw) == LTypeKind::Function) {
                                mut ctor_args: Pair<LValue, TypeRef>[] = [];
                                ctor_args.push(Pair<LValue, TypeRef>::new(obj_alloca, node.resolved_type));
                                for (mut ci: i64 = 0; ci < node.arguments.length; ci++) {
                                    const carg: LValue = this.codegen_rvalue(node.arguments[ci]);
                                    ctor_args.push(Pair<LValue, TypeRef>::new(carg, node.arguments[ci].resolved_type));
                                }
                                mut ctor_res: LValue = LValue::null();
                                codegen_call(this.cg, ctor_fn, ctor_ty, ctor_args, "", &ctor_res);
                            }
                            // Load the constructed value as the expression result.
                            const loaded: LValue = this.cg.builder.build_load(
                                mapped, obj_alloca, "ctor.val");
                            this.last_value = loaded;
                            this.last_is_lvalue = false;
                            return;
                        }
                    }
                }
            }

            // 4. Function-typed parameter: look in named_values (local scope).
            //    If the identifier refers to a parameter of function type,
            //    it will be stored as an alloca in named_values.  Load the
            //    function pointer and call through it.
            //    We must handle the call here because the loaded value is an
            //    instruction, not a GlobalValue; LLVMGlobalGetValueType
            //    would segfault on it.
            if (!callee_val.is_valid()) {
                const local: LValue = this.cg.get_named_value(id.name);
                if (local.is_valid()) {
                    // Build the LLVM function type from the Cryo FunctionType.
                    // Unwrap Pointer/Reference if the param type is &fn(...).
                    mut callee_type_ref: TypeRef = id.resolved_type;
                    mut callee_t: Type* = this.cg.lookup_type_by_id(callee_type_ref.id);
                    if (callee_t != null && callee_t.kind == TypeKind::Pointer) {
                        const pt: PointerType* = callee_t as PointerType*;
                        callee_type_ref = pt.pointee;
                        callee_t = this.cg.lookup_type_by_id(callee_type_ref.id);
                    } else if (callee_t != null && callee_t.kind == TypeKind::Reference) {
                        const rt: ReferenceType* = callee_t as ReferenceType*;
                        callee_type_ref = rt.referent;
                        callee_t = this.cg.lookup_type_by_id(callee_type_ref.id);
                    }
                    if (callee_t != null && callee_t.kind == TypeKind::Function) {
                        const ft: FunctionType* = callee_t as FunctionType*;
                        // Map return type.
                        const ret_ty: LType = this.cg.type_mapper.map_type(ft.return_type);
                        if (!ret_ty.is_valid()) {
                            this.last_value = LValue::null();
                            this.last_is_lvalue = false;
                            return;
                        }
                        // Map parameter types.
                        const param_count: u32 = ft.param_types.length as u32;
                        mut fn_type: LType = LType::null();
                        if (param_count == 0) {
                            fn_type = LType::function_type(ret_ty, null, 0, false);
                        } else {
                            const pbuf: void* = intrinsics::malloc(param_count as u64 * 8);
                            const pslots: void** = pbuf as void**;
                            mut valid: boolean = true;
                            for (mut pi: u32 = 0; pi < param_count; pi++) {
                                const pt: LType = this.cg.type_mapper.map_type(ft.param_types[pi]);
                                if (!pt.is_valid()) { valid = false; break; }
                                pslots[pi] = pt.raw;
                            }
                            if (!valid) {
                                intrinsics::free(pbuf);
                                this.last_value = LValue::null();
                                this.last_is_lvalue = false;
                                return;
                            }
                            fn_type = LType::function_type(ret_ty, pbuf, param_count, false);
                            intrinsics::free(pbuf);
                        }
                        // Load the function pointer from the alloca.
                        const fn_ptr_llvm: LType = LType::pointer_to(LType::i8());
                        const fn_ptr: LValue = this.cg.builder.build_load(fn_ptr_llvm, local, "fn.ptr.load");
                        // Codegen arguments.
                        mut call_args: Pair<LValue, TypeRef>[] = [];
                        for (mut ai: i64 = 0; ai < node.arguments.length; ai++) {
                            const av: LValue = this.codegen_rvalue(node.arguments[ai]);
                            call_args.push(Pair<LValue, TypeRef>::new(av, node.arguments[ai].resolved_type));
                        }
                        // Build the call.
                        const void_ty: LType = LType::void_type();
                        const call_name: string = if (ret_ty.raw == void_ty.raw) { "" } else { "calltmp" };
                        mut call_result: LValue = LValue::null();
                        codegen_call(this.cg, fn_ptr, fn_type, call_args, call_name, &call_result);
                        this.last_value = call_result;
                        this.last_is_lvalue = false;
                        return;
                    }
                }
            }
        } else if (node.callee.kind == NodeKind::ScopeResolution) {
            // Scope resolution: e.g., LValue::null(), TypeRef::invalid().
            // The scope name may be bare (LValue) while the function was
            // registered under the qualified type name.
            // Resolve the scope name through the DI type map to get the
            // qualified type name, then build the combined key.
            const sr: ScopeResolutionNode* = node.callee as ScopeResolutionNode*;
            const di: DeclarationIndex* = this.cg.get_decl_index();

            // Inline-lower intrinsics referenced via a namespace prefix
            // (e.g., `intrinsics::isfinite`, `intrinsics::ptr_add`).  The
            // leaf name uniquely identifies the intrinsic; the prefix is
            // ignored because intrinsics live in the global LLVM namespace,
            // not in the source-level module they were declared in.  Run
            // BEFORE the resolved_callee lookup: sema pins
            // `intrinsics::ptr_add` as a qualified callee symbol, and the
            // declaration table would happily declare it as an extern,
            // causing the linker to look for a real `ptr_add` symbol that
            // doesn't exist (intrinsics are lowered inline, never linked).
            const sr_leaf_str: string = intern.resolve(sr.member_name);
            if (is_intrinsic_name(sr_leaf_str)) {
                mut sr_args: LValue[] = [];
                for (mut sai: i64 = 0; sai < node.arguments.length; sai++) {
                    sr_args.push(this.codegen_rvalue(node.arguments[sai]));
                }
                mut sr_intr_result: LValue = LValue::null();
                if (try_emit_intrinsic_call(this.cg, sr_leaf_str, sr_args, &sr_intr_result)) {
                    this.last_value = sr_intr_result;
                    this.last_is_lvalue = false;
                    return;
                }
            }

            // Sema-pinned callee: set by the monomorphizer's body walk
            // for generic free-function calls (`mem::offset(p, n)`,
            // `Layout::array<T>(n)`) AND by sema's `try_resolve_*` static-
            // method / module-function / cimport-function paths.  Routes
            // through `resolve_function_by_mangled`, identical to the
            // Identifier branch.  The fallback chain below still runs for
            // call shapes sema doesn't yet pin (the spec-first lookup
            // based on `node.resolved_type`, enum-variant constructors).
            if (node.resolved_callee.is_valid()) {
                callee_val = resolve_function_by_mangled(
                    this.cg, node.resolved_callee);
            }

            // Resolve the scope name (e.g., "LValue") to its qualified form
            // (e.g., "Compiler::Codegen::LLVMTypes::LValue") via the DI mapping.
            const resolved_scope: SymbolStr = di.resolve_qualified(sr.scope_name);
            const scope_str: string = intern.resolve(resolved_scope);
            const sr_arity: u32 = node.arguments.length as u32;

            // Spec-first: when `node.resolved_type` is a generic instantiation,
            // the call resolves to the spec'd method (e.g.
            // `Map<string, Argument>::new`), not the bare template (`Map::new`).
            // The bare template is also registered in the DI when the source
            // contains `type struct Map<K,V> { static new() ... }`; the inner
            // `Map` return type resolves to the bare struct, and a bare-mangled
            // declaration ends up in the function table.  Without trying the
            // spec name first, the bare-name lookup at the next step finds
            // that template and emits a call to a symbol nobody defines.
            mut conc_ref0: TypeRef = node.resolved_type;
            mut conc_t0: Type* = this.cg.lookup_type_by_id(conc_ref0.id);
            mut fc0: i32 = 0;
            while (conc_t0 != null && conc_t0.kind == TypeKind::InstantiatedType && fc0 < 5) {
                const ci0: InstantiatedType* = conc_t0 as InstantiatedType*;
                if (ci0.has_resolved_type()) {
                    conc_ref0 = ci0.resolved_type;
                    conc_t0 = this.cg.lookup_type_by_id(conc_ref0.id);
                } else { break; }
                fc0 += 1;
            }
            if (conc_t0 != null) {
                mut conc_name0: string = "";
                if (conc_t0.kind == TypeKind::Struct) {
                    const cst0: StructType* = conc_t0 as StructType*;
                    conc_name0 = intern.resolve(cst0.qualified_name);
                } else if (conc_t0.kind == TypeKind::Class) {
                    const cct0: ClassType* = conc_t0 as ClassType*;
                    conc_name0 = intern.resolve(cct0.qualified_name);
                } else if (conc_t0.kind == TypeKind::Enum) {
                    const cet0: EnumType* = conc_t0 as EnumType*;
                    conc_name0 = intern.resolve(cet0.qualified_name);
                } else if (conc_t0.kind == TypeKind::InstantiatedType) {
                    // Unresolved InstantiatedType: sema's expected_type
                    // fallback returned a generic instantiation that the
                    // monomorphizer hadn't yet pinned to its spec struct
                    // when codegen ran. Compute the deterministic spec
                    // mangled name from `(generic_base, type_args)` and
                    // try to find the registered spec method directly.
                    const ci_unres: InstantiatedType* = conc_t0 as InstantiatedType*;
                    const base_qname: SymbolStr = this.cg.arena.get_qualified_name(
                        ci_unres.generic_base);
                    if (base_qname.is_valid()) {
                        const base_qn: QualifiedName = QualifiedName::from_symbol(base_qname);
                        const spec_sym: SymbolStr = MangledName::specialized_identifier(
                            this.cg.get_intern(), this.cg.arena, base_qn,
                            ci_unres.type_args);
                        if (spec_sym.is_valid()) {
                            conc_name0 = intern.resolve(spec_sym);
                        }
                    }
                }
                // Don't overwrite a callee_val that the resolved_callee path
                // already produced; the monomorphizer's pin is authoritative
                // for spec'd generic free-function callees, and rebuilding the
                // lookup key from `node.resolved_type` (the call's return type)
                // collapses spec'd static methods like `Layout::array<Point>`
                // to the bare-template `Layout::array` symbol.
                if (!callee_val.is_valid() && intrinsics::strlen(conc_name0) > 0) {
                    const member_str0: string = intern.resolve(sr.member_name);
                    const conc_combined0: string = format("%s::%s", conc_name0, member_str0);
                    const conc_sym0: SymbolStr = intern.intern(conc_combined0);
                    callee_val = resolve_function_with_arity(this.cg, conc_sym0, sr_arity);
                    if (!callee_val.is_valid()) {
                        callee_val = resolve_function(this.cg, conc_sym0);
                    }
                }
            }

            // Post-substitution combined-key lookup: in spec'd function
            // bodies, AST substituter rewrites `sr.scope_name` from
            // `String` to the bare-leaf spec form (`6String$L...$G`).
            // Sema's pin was on the pre-substitution template form
            // (`String::method`) and the substituter doesn't update
            // `resolved_callee`, so when codegen lands on this branch the
            // pinned symbol is for a function that only exists at
            // template time.  `di.resolve_qualified(sr.scope_name)` maps
            // the bare-leaf spec back to its fully-qualified arena name
            // (registered by specialization.cryo), and the combined
            // `<qualified>::<method>` lookup finds the spec's LLVM
            // symbol.  Sema upstreams the non-spec case via pinned
            // `resolved_callee`; this branch covers the spec-context
            // lookups until AST cloning clears stale callee pins.
            if (!callee_val.is_valid()) {
                const combined: string = format("%s::%s", scope_str, intern.resolve(sr.member_name));
                const sym: SymbolStr = intern.intern(combined);
                callee_val = resolve_function_with_arity(this.cg, sym, sr_arity);
                if (!callee_val.is_valid()) {
                    callee_val = resolve_function(this.cg, sym);
                }
            }

            // Module-graph walk: when source writes a shorthand path like
            // `libc::read` or `CHeaderImport::run`, find every module
            // whose namespace ends with `::scope_str` (or equals it).
            // Sema's `resolve_module_qualified_function` mirrors this and
            // pins resolved_callee for non-spec cases; this branch covers
            // call sites whose scope name was substituted (where sema's
            // pin is for the template form) or otherwise didn't pin.
            if (!callee_val.is_valid()) {
                const matches: SymbolStr[] = collect_namespace_suffix_matches(
                    this.cg, intern, scope_str, sr.member_name, sr_arity);
                if (matches.length == 1) {
                    callee_val = resolve_function_with_arity(this.cg, matches[0], sr_arity);
                    if (!callee_val.is_valid()) {
                        callee_val = resolve_function(this.cg, matches[0]);
                    }
                } else if (matches.length > 1) {
                    mut detail: string = "";
                    for (mut k: i64 = 0; k < matches.length; k++) {
                        const alt_str: string = intern.resolve(matches[k]);
                        if (k == 0) { detail = format("  - `%s`", alt_str); }
                        else        { detail = format("%s\n  - `%s`", detail, alt_str); }
                    }
                    const msg: string = format(
                        "ambiguous call `%s::%s`: %lld modules match the namespace suffix `%s` and define `%s`\n%s",
                        scope_str, intern.resolve(sr.member_name),
                        matches.length, scope_str, intern.resolve(sr.member_name), detail);
                    this.cg.emit_error_at_span(
                        ErrorCode::E0154_AMBIGUOUS_CALL, msg, node.span);
                    this.last_value = LValue::null();
                    this.last_is_lvalue = false;
                    return;
                }
            }

            // Fallback 1: try the bare member name.  Extern "C" functions
            // (e.g., llvm::LLVMGetTypeKind) are registered under their
            // unqualified C name, not the scope-qualified form.
            // Use arity-aware lookup first to discriminate between overloads
            // that share a bare name (e.g., the `read` intrinsic vs the free
            // `std::fs::file::read(path: string)`, both reachable under bare
            // "read" via type_resolution's bare-alias registration).
            if (!callee_val.is_valid()) {
                callee_val = resolve_function_with_arity(
                    this.cg, sr.member_name, sr_arity);
                if (!callee_val.is_valid()) {
                    callee_val = resolve_function(this.cg, sr.member_name);
                }
            }

            // If the function wasn't found, check if this is an enum variant
            // constructor (e.g., Option::Some, Result::Ok).  Enum constructors
            // are not registered as functions; synthesize the value inline.
            // Use node.resolved_type (the sema-resolved result type of the call)
            // to find the concrete monomorphized enum, not the scope name
            // (which may still be the generic "Option" template name).
            if (!callee_val.is_valid()) {
                mut real_ref: TypeRef = node.resolved_type;
                mut real_t: Type* = this.cg.lookup_type_by_id(real_ref.id);
                // Follow InstantiatedType chain (may be multiple levels deep).
                mut follow_count: i32 = 0;
                while (real_t != null && real_t.kind == TypeKind::InstantiatedType && follow_count < 5) {
                    const inst: InstantiatedType* = real_t as InstantiatedType*;
                    if (inst.has_resolved_type()) {
                        real_ref = inst.resolved_type;
                        real_t = this.cg.lookup_type_by_id(real_ref.id);
                    } else {
                        break;
                    }
                    follow_count += 1;
                }
                // Also try: the scope name might resolve to a type directly
                // (for cases where resolved_type isn't set on the call node).
                if (real_t == null || (real_t.kind != TypeKind::Enum && real_t.kind != TypeKind::Struct)) {
                    const scope_ref: TypeRef = di.lookup_type(resolved_scope);
                    if (scope_ref.is_valid()) {
                        real_ref = scope_ref;
                        real_t = this.cg.lookup_type_by_id(real_ref.id);
                        mut sc: i32 = 0;
                        while (real_t != null && real_t.kind == TypeKind::InstantiatedType && sc < 5) {
                            const sinst: InstantiatedType* = real_t as InstantiatedType*;
                            if (sinst.has_resolved_type()) {
                                real_ref = sinst.resolved_type;
                                real_t = this.cg.lookup_type_by_id(real_ref.id);
                            } else { break; }
                            sc += 1;
                        }
                    }
                }
                if (real_t != null && real_t.kind == TypeKind::Enum) {
                    const et: EnumType* = real_t as EnumType*;
                    const variant: EnumVariantInfo* = et.get_variant(sr.member_name);
                    if (variant != null) {
                        // Codegen the arguments first.
                        mut vargs: LValue[] = [];
                        for (mut ai: i64 = 0; ai < node.arguments.length; ai++) {
                            vargs.push(this.codegen_rvalue(node.arguments[ai]));
                        }
                        const result: LValue = this.build_enum_variant(et, variant, real_ref, vargs);
                        this.last_value = result;
                        this.last_is_lvalue = false;
                        return;
                    }
                }
            }
        } else if (node.callee.kind == NodeKind::MemberAccess) {
            // Member access: sema's `resolve_method_overload` pins the
            // mangled LLVM callee on `resolved_callee` for inherent
            // class/struct/enum methods AND for trait-impl methods on
            // non-generic receivers.  Codegen detects the function-
            // pointer-field shortcut, picks up virtual-dispatch state for
            // class receivers, then routes the pinned symbol through
            // `resolve_function_by_mangled`.  The post-specialization
            // fallback at the bottom covers methods on spec'd receivers
            // (InstantiatedType, where sema runs before monomorphization
            // and the receiver's concrete spec name doesn't exist yet).
            const ma: MemberAccessNode* = node.callee as MemberAccessNode*;
            const di: DeclarationIndex* = this.cg.get_decl_index();
            const method_str: string = intern.resolve(ma.member);

            // Function-pointer field call: `receiver.field(args)` where
            // `field` has a Function type.  Sema sets
            // `ma.resolved_type` to that Function; we load the field then
            // call indirectly through the loaded pointer.  Without this,
            // codegen would chase method lookups and bottom out on
            // "no method found" for every callback-style stdlib field.
            mut ma_callee_t: Type* = this.cg.lookup_type_by_id(ma.resolved_type.id);
            // Unwrap pointer/reference to match how function-typed fields
            // land; `fn(...) -> T` stores as a raw function-pointer so the
            // member may resolve to a Function type directly.
            mut ma_fn_type: FunctionType* = null;
            if (ma_callee_t != null && ma_callee_t.kind == TypeKind::Function) {
                ma_fn_type = ma_callee_t as FunctionType*;
            } else if (ma_callee_t != null && ma_callee_t.kind == TypeKind::Pointer) {
                const ppt: PointerType* = ma_callee_t as PointerType*;
                const pin: Type* = this.cg.lookup_type_by_id(ppt.pointee.id);
                if (pin != null && pin.kind == TypeKind::Function) {
                    ma_fn_type = pin as FunctionType*;
                }
            }
            if (ma_fn_type != null) {
                const ft: FunctionType* = ma_fn_type;
                const ret_ty: LType = this.cg.type_mapper.map_type(ft.return_type);
                if (!ret_ty.is_valid()) {
                    this.last_value = LValue::null();
                    this.last_is_lvalue = false;
                    return;
                }
                const param_count: u32 = ft.param_types.length as u32;
                mut llvm_fn_type: LType = LType::null();
                if (param_count == 0) {
                    llvm_fn_type = LType::function_type(ret_ty, null, 0, false);
                } else {
                    const pbuf: void* = intrinsics::malloc(param_count as u64 * 8);
                    const pslots: void** = pbuf as void**;
                    mut all_valid: boolean = true;
                    for (mut pi: u32 = 0; pi < param_count; pi++) {
                        const pty: LType = this.cg.type_mapper.map_type(ft.param_types[pi]);
                        if (!pty.is_valid()) { all_valid = false; break; }
                        pslots[pi] = pty.raw;
                    }
                    if (!all_valid) {
                        intrinsics::free(pbuf);
                        this.last_value = LValue::null();
                        this.last_is_lvalue = false;
                        return;
                    }
                    llvm_fn_type = LType::function_type(ret_ty, pbuf, param_count, false);
                    intrinsics::free(pbuf);
                }
                // Load the fn-pointer value from the field (rvalue).
                const fn_ptr: LValue = this.codegen_rvalue(ma);
                if (!fn_ptr.is_valid()) {
                    this.last_value = LValue::null();
                    this.last_is_lvalue = false;
                    return;
                }
                // Codegen user args (no implicit `this`; the fn-pointer field
                // is a plain function, not a bound method).
                mut fnp_args: Pair<LValue, TypeRef>[] = [];
                for (mut ai: i64 = 0; ai < node.arguments.length; ai++) {
                    const av: LValue = this.codegen_rvalue(node.arguments[ai]);
                    fnp_args.push(Pair<LValue, TypeRef>::new(av, node.arguments[ai].resolved_type));
                }
                const void_ty: LType = LType::void_type();
                const call_name: string = if (ret_ty.raw == void_ty.raw) { "" } else { "calltmp" };
                mut call_result: LValue = LValue::null();
                codegen_call(this.cg, fn_ptr, llvm_fn_type, fnp_args, call_name, &call_result);
                this.last_value = call_result;
                this.last_is_lvalue = false;
                return;
            }

            // Get the object's type, unwrapping pointer/reference.
            mut obj_ref: TypeRef = ma.object.resolved_type;
            mut t: Type* = this.cg.lookup_type_by_id(obj_ref.id);
            if (t != null && t.kind == TypeKind::Pointer) {
                const ptr_t: PointerType* = t as PointerType*;
                obj_ref = ptr_t.pointee;
                t = this.cg.lookup_type_by_id(obj_ref.id);
            } else if (t != null && t.kind == TypeKind::Reference) {
                const ref_t: ReferenceType* = t as ReferenceType*;
                obj_ref = ref_t.referent;
                t = this.cg.lookup_type_by_id(obj_ref.id);
            }

            // Follow InstantiatedType chain to get the concrete type's TypeRef.
            mut inst_depth: i32 = 0;
            while (t != null && t.kind == TypeKind::InstantiatedType && inst_depth < 5) {
                const inst: InstantiatedType* = t as InstantiatedType*;
                if (inst.has_resolved_type()) {
                    obj_ref = inst.resolved_type;
                    t = this.cg.lookup_type_by_id(obj_ref.id);
                } else { break; }
                inst_depth += 1;
            }

            // Also unwrap pointer/reference AFTER InstantiatedType unwrap
            // (some monomorphized types resolve to Pointer<ConcreteStruct>).
            if (t != null && t.kind == TypeKind::Pointer) {
                const ptr_t2: PointerType* = t as PointerType*;
                obj_ref = ptr_t2.pointee;
                t = this.cg.lookup_type_by_id(obj_ref.id);
            } else if (t != null && t.kind == TypeKind::Reference) {
                const ref_t2: ReferenceType* = t as ReferenceType*;
                obj_ref = ref_t2.referent;
                t = this.cg.lookup_type_by_id(obj_ref.id);
            }

            // Use DI type_reverse to get the type's registered name,
            // then look up "QualifiedType::method" in the function map.
            // For ArrayType, use the element-type → Array_<T> mapping
            // since ArrayType TypeRefs are not canonical.  Only used by
            // the post-specialization fallback below (when sema's pin
            // was empty or its symbol isn't in the LLVM module).
            mut type_sym: SymbolStr = di.lookup_type_name(obj_ref);
            if (!type_sym.is_valid() && t != null && t.kind == TypeKind::Array) {
                const arr_t: ArrayType* = t as ArrayType*;
                type_sym = di.lookup_array_type_name(arr_t.element);
            }

            // Check for virtual dispatch: if the STATIC receiver type is a
            // class with virtual methods and sema has resolved this call
            // to a specific method declaration, dispatch indirectly through
            // the object's vtable pointer.  We use the static type (rather
            // than walking to the most-derived type) because the vtable
            // layout is defined by the static type's declaration order;
            // subclass vtables are inheritance-complete, so `slot[idx]`
            // resolves correctly at runtime to whatever override the
            // dynamic type installed.  The slot key is (name, param_types)
            // read directly from sema's resolved method; no string
            // matching, no guessing at arg-type display names, no chance
            // of collapsing overloads.
            if (t != null && t.kind == TypeKind::Class &&
                node.resolved_method != null) {
                const cls_for_vtbl: ClassType* = t as ClassType*;
                if (cls_for_vtbl.has_virtual_methods) {
                    const rm: MethodNode* = node.resolved_method as MethodNode*;
                    if (rm != null && rm.func != null) {
                        const fn_node: FunctionDeclNode* = rm.func;
                        // Extract the resolved method's declared param
                        // types (skipping self) in exact declaration order.
                        mut rm_params: TypeRef[] = [];
                        const this_amp: SymbolStr = intern.intern("&this");
                        const this_val: SymbolStr = intern.intern("this");
                        for (mut pi: i64 = 0; pi < fn_node.parameters.length; pi++) {
                            const pp: VarDeclNode* = fn_node.parameters[pi];
                            if (pp == null) { continue; }
                            if (pp.name.equals(this_amp)) { continue; }
                            if (pp.name.equals(this_val)) { continue; }
                            rm_params.push(pp.resolved_type);
                        }
                        const slot_idx: i32 = vtable_slot_index(
                            this.cg, cls_for_vtbl, fn_node.name, rm_params);
                        if (slot_idx >= 0) {
                            vtable_dispatch = true;
                            vtable_slot_idx = slot_idx;
                            vtable_obj_ref = obj_ref;
                        }
                    }
                }
            }

            // Instance-method calls prepend `&this` at the call site, so the
            // LLVM arity is user-args + 1.  This matches declare_method's
            // `total_params` registration key.
            const ma_arity: u32 = (node.arguments.length + 1) as u32;

            // Trust sema: `resolved_callee` is the mangled LLVM symbol
            // chosen by `resolve_method_overload` for inherent methods on
            // classes / structs / enums (including the base-class walk
            // for inheritance) AND for trait-impl methods on non-generic
            // receivers (e.g. `String::write_bytes` from `implement trait
            // FmtWrite for String`, or primitive trait impls like
            // `Eq for i16`).  Routes through `resolve_function_by_mangled`,
            // identical to the Identifier branch.
            if (node.resolved_callee.is_valid()) {
                callee_val = resolve_function_by_mangled(
                    this.cg, node.resolved_callee);
            }

            // Post-specialization fallback: when the receiver is a
            // monomorphized InstantiatedType (e.g. `Array<u8, GlobalAlloc>`
            // inside a spec'd `String<GlobalAlloc>::with_capacity`), sema's
            // pin uses the TEMPLATE's mangled symbol, which doesn't exist
            // in the LLVM module (only specs are emitted).  Re-resolve via
            // the post-substitution receiver type name registered in the
            // DI: `lookup_type_name(obj_ref)` returns the spec's qname
            // (e.g. `Array_u8_GlobalAlloc`) and the combined
            // `<spec_qname>::<method>` lookup finds the spec'd LLVM symbol.
            //
            // Long-term: move this into a post-monomorphization re-pin
            // pass that updates `resolved_callee` after AST substitution.
            // Until then this branch handles the spec'd-receiver case.
            if (!callee_val.is_valid() && type_sym.is_valid()) {
                const type_str: string = intern.resolve(type_sym);
                const combined: string = format("%s::%s", type_str, method_str);
                const sym: SymbolStr = intern.intern(combined);
                callee_val = resolve_function_with_arity(this.cg, sym, ma_arity);
                if (!callee_val.is_valid()) {
                    callee_val = resolve_function(this.cg, sym);
                }
            }
            if (!callee_val.is_valid() && t != null) {
                mut type_str: string = "";
                if (t.kind == TypeKind::Struct) {
                    const st: StructType* = t as StructType*;
                    type_str = intern.resolve(st.qualified_name);
                } else if (t.kind == TypeKind::Class) {
                    const ct: ClassType* = t as ClassType*;
                    type_str = intern.resolve(ct.qualified_name);
                } else if (t.kind == TypeKind::Enum) {
                    const et: EnumType* = t as EnumType*;
                    type_str = intern.resolve(et.qualified_name);
                } else if (t.kind == TypeKind::Int
                        || t.kind == TypeKind::Float
                        || t.kind == TypeKind::Bool
                        || t.kind == TypeKind::Char
                        || t.kind == TypeKind::String
                        || t.kind == TypeKind::Unit) {
                    // Primitives have no `qualified_name`; the trait-
                    // impl registry keys on the bare display name.
                    type_str = t.display_name();
                }
                if (intrinsics::strlen(type_str) > 0) {
                    const combined: string = format("%s::%s", type_str, method_str);
                    const sym: SymbolStr = intern.intern(combined);
                    callee_val = resolve_function_with_arity(this.cg, sym, ma_arity);
                    if (!callee_val.is_valid()) {
                        callee_val = resolve_function(this.cg, sym);
                    }
                }
            }

        } else {
            callee_val = this.codegen_rvalue(node.callee);
        }

        if (!callee_val.is_valid()) {
            // Build a rich diagnostic that names the callee (when available)
            // and labels the receiver for member/scope calls.
            mut msg: string = "codegen: call expression: callee function not found";
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0636_UNDEFINED_FUNCTION_CALL, msg);
            diag = diag.at(node.span);

            if (node.callee.kind == NodeKind::Identifier) {
                const id: IdentifierNode* = node.callee as IdentifierNode*;
                const id_str: string = this.cg.resolve(id.name);
                diag = Diagnostic::error(ErrorCode::E0636_UNDEFINED_FUNCTION_CALL,
                    format("codegen: cannot resolve function '%s'", id_str));
                diag = diag.at(node.span);
                diag = diag.also_at(node.callee.span, "no function with this name is in scope");
            } else if (node.callee.kind == NodeKind::ScopeResolution) {
                const sr: ScopeResolutionNode* = node.callee as ScopeResolutionNode*;
                const scope_str: string = intern.resolve(sr.scope_name);
                const member_str: string = intern.resolve(sr.member_name);
                diag = Diagnostic::error(ErrorCode::E0636_UNDEFINED_FUNCTION_CALL,
                    format("codegen: cannot resolve '%s::%s'", scope_str, member_str));
                diag = diag.at(node.span);
                diag = diag.also_at(node.callee.span, "no such associated function");
            } else if (node.callee.kind == NodeKind::MemberAccess) {
                const ma: MemberAccessNode* = node.callee as MemberAccessNode*;
                mut type_str: string = "<unknown>";
                const dbg_t: Type* = this.cg.lookup_type_by_id(ma.object.resolved_type.id);
                if (dbg_t != null) {
                    type_str = dbg_t.display_name();
                }
                const member_str: string = intern.resolve(ma.member);
                diag = Diagnostic::error(ErrorCode::E0636_UNDEFINED_FUNCTION_CALL,
                    format("codegen: no method '%s' found on type '%s'", member_str, type_str));
                diag = diag.at(node.span);
                diag = diag.also_at(ma.object.span, format("receiver has type '%s'", type_str));
                diag = diag.with_note("method lookup walks the class inheritance chain; neither the concrete type nor any base defines this method");
            }

            this.cg.emit_diagnostic(diag);
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }

        // `Pair<LValue, TypeRef>` per arg; the type drives sext-vs-zext
        // when codegen_call needs to widen a narrow integer to the formal
        // param's LLVM width.  Receivers are pointer/reference-typed and
        // never hit the integer-widening path, but we record the receiver
        // type anyway to keep the array meaningful end-to-end.
        mut args: Pair<LValue, TypeRef>[] = [];
        if (node.callee.kind == NodeKind::MemberAccess) {
            const ma: MemberAccessNode* = node.callee as MemberAccessNode*;
            // For pointer/reference receivers (e.g. `runner: Runner*`),
            // the receiver value is itself the `this` pointer; load it
            // out of the local slot.  For value receivers (`runner: Runner`),
            // take the lvalue address as `this`.
            const recv_t: Type* = this.cg.lookup_type_by_id(ma.object.resolved_type.id);
            mut obj: LValue = LValue::null();
            if (recv_t != null && (recv_t.kind == TypeKind::Pointer
                                || recv_t.kind == TypeKind::Reference)) {
                obj = this.codegen_rvalue(ma.object);
            } else {
                obj = this.codegen_lvalue(ma.object);
            }
            args.push(Pair<LValue, TypeRef>::new(obj, ma.object.resolved_type));
        }
        for (mut i: i64 = 0; i < node.arguments.length; i++) {
            const arg: LValue = this.codegen_rvalue(node.arguments[i]);
            args.push(Pair<LValue, TypeRef>::new(arg, node.arguments[i].resolved_type));
        }

        const fn_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(callee_val.raw) };
        if (!fn_ty.is_valid()) {
            this.cg.emit_error_at_span(ErrorCode::E0602_INVALID_LLVM_TYPE,
                "codegen: call expression: failed to retrieve function type from callee",
                node.span);
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }

        // Virtual dispatch: replace the direct callee with a vtable-loaded
        // function pointer.  We keep `fn_ty` from the statically resolved
        // function; it describes the correct signature for `LLVMBuildCall2`
        // and matches whatever override got installed in the slot at
        // runtime (since all overrides share the base's signature).
        if (vtable_dispatch && args.length > 0 && args[0].first.is_valid() && vtable_obj_ref.is_valid()) {
            const class_lty: LType = this.cg.type_mapper.map_type(vtable_obj_ref);
            if (class_lty.is_valid()) {
                const vptr_slot: LValue = this.cg.builder.build_struct_gep(
                    class_lty, args[0].first, 0, "vptr.slot");
                if (vptr_slot.is_valid()) {
                    const i8_ptr_ty: LType = LType::pointer_to(LType::i8());
                    const i8_ptr_ptr_ty: LType = LType::pointer_to(i8_ptr_ty);
                    const vtbl: LValue = this.cg.builder.build_load(
                        i8_ptr_ptr_ty, vptr_slot, "vtbl");
                    if (vtbl.is_valid()) {
                        const idx_val: LValue = LType::const_int(
                            LType::i32(), vtable_slot_idx as u64, false);
                        const idx_buf: void* = intrinsics::malloc(8);
                        const idx_slots: void** = idx_buf as void**;
                        idx_slots[0] = idx_val.raw;
                        const fn_slot: LValue = this.cg.builder.build_gep(
                            i8_ptr_ty, vtbl, idx_buf, 1, "vtbl.slot");
                        intrinsics::free(idx_buf);
                        if (fn_slot.is_valid()) {
                            const fn_ptr: LValue = this.cg.builder.build_load(
                                i8_ptr_ty, fn_slot, "vtbl.fn");
                            if (fn_ptr.is_valid()) {
                                callee_val = fn_ptr;
                            }
                        }
                    }
                }
            }
        }

        const ret_ty: LType = this.cg.type_mapper.map_type(node.resolved_type);
        const void_ty: LType = LType::void_type();
        // Void calls and unresolved return types must use empty name;
        // LLVM doesn't allow naming void-typed instructions.
        const is_void: boolean = !ret_ty.is_valid() || ret_ty.raw == void_ty.raw ||
                                  type_kind_of(ret_ty.raw) == LTypeKind::Void;
        const call_name: string = if (is_void) { "" } else { "calltmp" };
        mut result: LValue = LValue::null();
        codegen_call(this.cg, callee_val, fn_ty, args, call_name, &result);

        // Emit `unreachable` after calls to divergent functions.  Two
        // cases handled here:
        //   1. The callee's resolved return type is `never`.
        //   2. The callee resolves to a known divergent function from
        //      the stdlib (`panic` intrinsic; `core::panic::panic` and the
        //      legacy `prelude::panic` wrapper).  These are declared
        //      `-> void` in source for bootstrap compatibility but
        //      semantically diverge.
        // Without this, calls in a non-void-returning context (e.g. the
        // `None` arm of `Option<T>::unwrap`) leave the block without a
        // terminator and the body-validator strips the entire function.
        mut should_unreachable: boolean = false;
        if (node.resolved_type.is_valid()) {
            const _ret_t: Type* = this.cg.lookup_type_by_id(node.resolved_type.id);
            if (_ret_t != null && _ret_t.kind == TypeKind::Never) {
                should_unreachable = true;
            }
        }
        if (!should_unreachable && this.is_divergent_callee(node.callee)) {
            should_unreachable = true;
        }
        if (should_unreachable) {
            this.cg.builder.build_unreachable();
        }

        this.last_value = result;
        this.last_is_lvalue = false;
    }

    /// `t[N]` on a tuple receiver. Returns true when handled; sets
    /// `last_value` to the field GEP and `last_is_lvalue=true` so the
    /// caller can use the result on either side of an assignment.
    /// Returns false for non-tuple receivers; caller falls through to
    /// the normal array-access path.
    try_codegen_tuple_index(mut &this, aa: ArrayAccessNode*) -> boolean {
        // Walk past pointer/reference/instantiation wrappers to find the
        // underlying tuple kind. Mirrors the unwrap chain in
        // codegen_member_access so `(&t)[0]` works the same as `t[0]`.
        mut walk_ty: TypeRef = aa.array.resolved_type;
        mut walk_t: Type* = this.cg.lookup_type_by_id(walk_ty.id);
        mut depth: i32 = 0;
        while (walk_t != null && depth < 5) {
            if (walk_t.kind == TypeKind::Pointer) {
                const pt: PointerType* = walk_t as PointerType*;
                walk_ty = pt.pointee;
                walk_t = this.cg.lookup_type_by_id(walk_ty.id);
            } else if (walk_t.kind == TypeKind::Reference) {
                const rt: ReferenceType* = walk_t as ReferenceType*;
                walk_ty = rt.referent;
                walk_t = this.cg.lookup_type_by_id(walk_ty.id);
            } else if (walk_t.kind == TypeKind::InstantiatedType) {
                const it: InstantiatedType* = walk_t as InstantiatedType*;
                if (!it.has_resolved_type()) { break; }
                walk_ty = it.resolved_type;
                walk_t = this.cg.lookup_type_by_id(walk_ty.id);
            } else {
                break;
            }
            depth += 1;
        }
        if (walk_t == null || walk_t.kind != TypeKind::Tuple) {
            return false;
        }

        // Sema already validated this; the index is an integer literal
        // in bounds. Read the literal value directly off the AST so we
        // can pass it to build_struct_gep.
        const idx_node: ASTNode* = aa.index as ASTNode*;
        if (idx_node.kind != NodeKind::Literal) { return false; }
        const lit: LiteralNode* = aa.index as LiteralNode*;
        if (lit.literal_kind != LiteralKind::Integer) { return false; }
        const idx: u64 = parse_int_lexeme(lit.value);

        const recv: LValue = this.codegen_lvalue(aa.array);
        const recv_is_lvalue: boolean = this.last_is_lvalue;
        // Auto-deref reference receivers so `&t[0]` GEPs the underlying
        // tuple, not the reference slot.
        mut obj_ptr: LValue = recv;
        const obj_t: Type* = this.cg.lookup_type_by_id(aa.array.resolved_type.id);
        if (obj_t != null && (obj_t.kind == TypeKind::Pointer
                            || obj_t.kind == TypeKind::Reference)
                && recv_is_lvalue) {
            obj_ptr = this.cg.builder.build_load(
                LType::pointer_to(LType::i8()), recv, "autoderef");
        }

        const tup_ty: LType = this.cg.type_mapper.map_type(walk_ty);
        if (!tup_ty.is_valid() || !obj_ptr.is_valid()) {
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return true;
        }
        const gep: LValue = this.cg.builder.build_struct_gep(
            tup_ty, obj_ptr, idx as u32, "tupelem");
        this.last_value = gep;
        this.last_is_lvalue = true;
        return true;
    }

    /// Tuple literal: direct dispatch. Sema tags `resolved_type` with the
    /// arena's TupleType (deduped by element types), so the layout follows
    /// `map_tuple` (anonymous LLVM struct of element types in order).
    override visit(mut &this, node: TupleLiteralNode*) -> void {
        const type_ref: TypeRef = node.resolved_type;
        mut element_values: LValue[] = [];
        for (mut i: i64 = 0; i < node.elements.length; i++) {
            element_values.push(this.codegen_rvalue(node.elements[i]));
        }
        codegen_tuple_literal(this.cg, type_ref, element_values,
                              &this.last_value, &this.last_is_lvalue,
                              node.span);
    }

    /// Struct literal: direct dispatch.
    override visit(mut &this, node: StructLiteralNode*) -> void {
        // Use the sema-tagged `resolved_type`; it's the authoritative
        // TypeRef produced by `lookup_type_by_sym`, which does the full
        // resolution cascade (current-module qualify, DI direct, scope
        // chain, arena leaf index).  Cryo objects never have valid
        // bare-name lookups (only C externs do), so there's no point
        // in falling back to `decl_index.lookup_type(node.struct_type)`
        // with the user's source-level identifier.
        const type_ref: TypeRef = node.resolved_type;
        mut field_names: SymbolStr[] = [];
        mut field_values: LValue[] = [];
        for (mut i: i64 = 0; i < node.field_inits.length; i++) {
            const init: FieldInit = node.field_inits[i];
            field_names.push(init.field_name);
            field_values.push(this.codegen_rvalue(init.value));
        }
        codegen_struct_literal(this.cg, type_ref, field_names, field_values,
                               &this.last_value, &this.last_is_lvalue,
                               node.span);
    }

    /// Array literal: direct dispatch.
    override visit(mut &this, node: ArrayLiteralNode*) -> void {
        // Fill form `[value; N]`: single element repeated N times.  Needs
        // its own codegen path: allocate the backing storage, run a fill
        // loop writing the value at every slot, and (for dynamic arrays)
        // wire up the fat-pointer struct.  The element-form path below
        // would write only slot 0 and GEP as if the alloca's outer type
        // were a flat array, which is wrong for both fixed `[N x T]`
        // alloca shapes and dynamic `{T*, i64}` fat pointers.
        const is_fill: boolean = (node.repeat_count > 0 || node.repeat_count_expr != null)
                                 && node.elements.length == 1;
        if (is_fill) {
            this.visit_fill_array_literal(node);
            return;
        }

        const arr_t_raw: Type* = this.cg.lookup_type_by_id(node.resolved_type.id);
        mut is_dynamic: boolean = false;
        mut arr_type_ptr: ArrayType* = null;
        if (arr_t_raw != null && arr_t_raw.kind == TypeKind::Array) {
            arr_type_ptr = arr_t_raw as ArrayType*;
            if (!arr_type_ptr.is_fixed()) {
                is_dynamic = true;
            }
        }
        if (is_dynamic) {
            this.visit_dynamic_array_literal(node, arr_type_ptr);
            return;
        }

        const ty: LType = this.cg.type_mapper.map_type(node.resolved_type);
        if (!ty.is_valid()) {
            this.cg.emit_error_at_span(ErrorCode::E0609_TYPE_MAPPING_ERROR,
                "codegen: array literal: failed to map array type",
                node.span);
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }
        const current_fn: LValue = this.get_current_function();
        if (!current_fn.is_valid()) {
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }
        const alloca: LValue = this.cg.create_entry_alloca(current_fn, "arrlit", ty);

        for (mut i: i64 = 0; i < node.elements.length; i++) {
            const elem: LValue = this.codegen_rvalue(node.elements[i]);
            const idx: LValue = LType::const_int(LType::i64(), i as u64, false);
            const buf: void* = intrinsics::malloc(16);
            const buf_arr: void** = buf as void**;
            const zero_idx: LValue = LType::const_int(LType::i64(), 0, false);
            buf_arr[0] = zero_idx.raw;
            buf_arr[1] = idx.raw;
            const gep: LValue = this.cg.builder.build_gep(ty, alloca, buf, 2, "arrelem");
            intrinsics::free(buf);
            this.cg.builder.build_store(elem, gep);
        }

        this.last_value = alloca;
        this.last_is_lvalue = true;
    }

    /// Emit element-form `[a, b, c]` where the expected type is a dynamic
    /// array `T[]` (fat pointer `{T*, i64}`).  Malloc a buffer for N elements,
    /// store each element into it, then stash (data, len) into the fat
    /// pointer alloca.  Without this path, we'd alloca `[N x T]` and hand
    /// back a fixed-size array to a caller expecting `{ptr, i64}`, failing
    /// LLVM verification.
    visit_dynamic_array_literal(mut &this, node: ArrayLiteralNode*,
                                 arr_type: ArrayType*) -> void {
        const elem_ty: LType = this.cg.type_mapper.map_type(arr_type.element);
        if (!elem_ty.is_valid()) {
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }
        const current_fn: LValue = this.get_current_function();
        if (!current_fn.is_valid()) {
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }
        const fat_ty: LType = this.cg.type_mapper.map_type(node.resolved_type);
        if (!fat_ty.is_valid()) {
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }
        const fat: LValue = this.cg.create_entry_alloca(current_fn, "arrlit", fat_ty);

        const count: i64 = node.elements.length;
        const count_val: LValue = LType::const_int(LType::i64(), count as u64, false);

        mut data_ptr: LValue = LValue::null();
        if (count > 0) {
            // Stride must come from LLVM's data layout, not the cryo arena's
            // `size_bytes()`. Element layout is computed lazily and may still
            // be 0 here (e.g. when the literal is inside a struct ctor whose
            // own layout pass hasn't reached the element's StructType yet;
            // falling back to `1` would emit `malloc(count * 1)` and cascade
            // into heap corruption at the next allocation. `codegen_sizeof`
            // tries `size_bytes()` first and falls back to `LLVMSizeOf`,
            // which is always data-layout-correct.
            mut elem_size_val: LValue = LValue::null();
            codegen_sizeof(this.cg, arr_type.element, &elem_size_val);
            const byte_count: LValue = this.cg.builder.build_mul(
                count_val, elem_size_val, "bytecnt");

            const malloc_fn: LValue = resolve_function(this.cg, this.cg.intern_str("malloc"));
            if (!malloc_fn.is_valid()) {
                this.last_value = LValue::null();
                this.last_is_lvalue = false;
                return;
            }
            const malloc_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(malloc_fn.raw) };
            mut malloc_args: Pair<LValue, TypeRef>[] = [];
            malloc_args.push(Pair<LValue, TypeRef>::new(byte_count, TypeRef::invalid()));
            codegen_call(this.cg, malloc_fn, malloc_ty, malloc_args, "arrdata", &data_ptr);
            if (!data_ptr.is_valid()) {
                this.last_value = LValue::null();
                this.last_is_lvalue = false;
                return;
            }

            for (mut i: i64 = 0; i < count; i++) {
                const elem: LValue = this.codegen_rvalue(node.elements[i]);
                if (!elem.is_valid()) { continue; }
                const idx: LValue = LType::const_int(LType::i64(), i as u64, false);
                const buf: void* = intrinsics::malloc(8);
                const buf_arr: void** = buf as void**;
                buf_arr[0] = idx.raw;
                const slot: LValue = this.cg.builder.build_gep(
                    elem_ty, data_ptr, buf, 1, "arrelem");
                intrinsics::free(buf);
                this.cg.builder.build_store(elem, slot);
            }
        } else {
            data_ptr = LType::const_null(LType::pointer_to(elem_ty));
        }

        const ptr_slot: LValue = this.cg.builder.build_struct_gep(
            fat_ty, fat, 0, "fat.ptr");
        this.cg.builder.build_store(data_ptr, ptr_slot);
        const len_slot: LValue = this.cg.builder.build_struct_gep(
            fat_ty, fat, 1, "fat.len");
        this.cg.builder.build_store(count_val, len_slot);
        const cap_slot: LValue = this.cg.builder.build_struct_gep(
            fat_ty, fat, 2, "fat.cap");
        this.cg.builder.build_store(count_val, cap_slot);

        this.last_value = fat;
        this.last_is_lvalue = true;
    }

    /// Emit codegen for `[value; N]` (fill form).  N may be a compile-time
    /// constant (fixed array) or a runtime expression (dynamic array).
    visit_fill_array_literal(mut &this, node: ArrayLiteralNode*) -> void {
        const arr_t_raw: Type* = this.cg.lookup_type_by_id(node.resolved_type.id);
        if (arr_t_raw == null || arr_t_raw.kind != TypeKind::Array) {
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }
        const arr_type: ArrayType* = arr_t_raw as ArrayType*;
        const elem_ty: LType = this.cg.type_mapper.map_type(arr_type.element);
        if (!elem_ty.is_valid()) {
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }
        const current_fn: LValue = this.get_current_function();
        if (!current_fn.is_valid()) {
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }

        // Compute count as i64.  Either from the static `repeat_count`
        // field or by evaluating `repeat_count_expr` and widening.
        mut count_val: LValue = LValue::null();
        if (node.repeat_count_expr != null) {
            const raw: LValue = this.codegen_rvalue(node.repeat_count_expr);
            if (raw.is_valid()) {
                const raw_ty: void* = llvm::LLVMTypeOf(raw.raw);
                if (raw_ty != null && type_kind_of(raw_ty) == LTypeKind::Integer) {
                    const width: u32 = llvm::LLVMGetIntTypeWidth(raw_ty);
                    if (width < 64) {
                        count_val = this.cg.builder.build_zext(raw, LType::i64(), "cnt.widen");
                    } else if (width > 64) {
                        count_val = this.cg.builder.build_trunc(raw, LType::i64(), "cnt.trunc");
                    } else {
                        count_val = raw;
                    }
                } else {
                    count_val = raw;
                }
            }
        } else {
            count_val = LType::const_int(LType::i64(), node.repeat_count as u64, false);
        }
        if (!count_val.is_valid()) {
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }

        // Compute the fill value.  Coerce the RHS integer width to match
        // the element type; common case: `[0; N]` for `i8[]` where 0 is
        // an i32 literal and slots want i8.
        mut fill_val: LValue = this.codegen_rvalue(node.elements[0]);
        if (fill_val.is_valid()) {
            const fill_llvm_ty: void* = llvm::LLVMTypeOf(fill_val.raw);
            if (fill_llvm_ty != null &&
                type_kind_of(fill_llvm_ty) == LTypeKind::Integer &&
                type_kind_of(elem_ty.raw) == LTypeKind::Integer) {
                const fw: u32 = llvm::LLVMGetIntTypeWidth(fill_llvm_ty);
                const ew: u32 = llvm::LLVMGetIntTypeWidth(elem_ty.raw);
                if (fw < ew) {
                    fill_val = this.cg.builder.build_zext(fill_val, elem_ty, "fill.widen");
                } else if (fw > ew) {
                    fill_val = this.cg.builder.build_trunc(fill_val, elem_ty, "fill.trunc");
                }
            }
        }

        if (arr_type.is_fixed()) {
            // Fixed `[value; N]` where N is a compile-time constant.
            // Alloca `[N x T]` and fill loop.  `gep_element_type` is T;
            // GEP needs `[N x T]` + indices `[0, i]` to land on slot i.
            const arr_lty: LType = LType::array_of(elem_ty, arr_type.size as u32);
            const alloca: LValue = this.cg.create_entry_alloca(current_fn, "arrlit", arr_lty);
            this.emit_fill_loop_indexed(current_fn, arr_lty, alloca,
                                         elem_ty, fill_val, count_val);
            this.last_value = alloca;
            this.last_is_lvalue = true;
        } else {
            // Dynamic `{T*, i64}` fat pointer.  Alloca the struct, malloc
            // a buffer of `count * sizeof(T)` bytes, fill it, then store
            // the (data_ptr, count) into the fat pointer.
            const fat_ty: LType = this.cg.type_mapper.map_type(node.resolved_type);
            const fat: LValue = this.cg.create_entry_alloca(current_fn, "arrlit", fat_ty);

            // Stride from LLVM's data layout; see visit_dynamic_array_literal
            // for why size_bytes() can be 0 here.
            mut elem_size_val: LValue = LValue::null();
            codegen_sizeof(this.cg, arr_type.element, &elem_size_val);
            const byte_count: LValue = this.cg.builder.build_mul(
                count_val, elem_size_val, "bytecnt");

            const malloc_fn: LValue = resolve_function(this.cg, this.cg.intern_str("malloc"));
            if (!malloc_fn.is_valid()) {
                this.last_value = LValue::null();
                this.last_is_lvalue = false;
                return;
            }
            const malloc_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(malloc_fn.raw) };
            mut malloc_args: Pair<LValue, TypeRef>[] = [];
            malloc_args.push(Pair<LValue, TypeRef>::new(byte_count, TypeRef::invalid()));
            mut data_ptr: LValue = LValue::null();
            codegen_call(this.cg, malloc_fn, malloc_ty, malloc_args, "filldata", &data_ptr);
            if (!data_ptr.is_valid()) {
                this.last_value = LValue::null();
                this.last_is_lvalue = false;
                return;
            }

            this.emit_fill_loop_raw(current_fn, elem_ty, data_ptr, fill_val, count_val);

            const ptr_slot: LValue = this.cg.builder.build_struct_gep(
                fat_ty, fat, 0, "fat.ptr");
            this.cg.builder.build_store(data_ptr, ptr_slot);
            const len_slot: LValue = this.cg.builder.build_struct_gep(
                fat_ty, fat, 1, "fat.len");
            this.cg.builder.build_store(count_val, len_slot);
            const cap_slot: LValue = this.cg.builder.build_struct_gep(
                fat_ty, fat, 2, "fat.cap");
            this.cg.builder.build_store(count_val, cap_slot);

            this.last_value = fat;
            this.last_is_lvalue = true;
        }
    }

    /// Fill `[N x T]`-typed storage by looping through indices [0..count)
    /// and storing `fill_val` at each slot via a two-index GEP.
    emit_fill_loop_indexed(mut &this, current_fn: LValue, arr_ty: LType,
                            base: LValue, elem_ty: LType,
                            fill_val: LValue, count_val: LValue) -> void {
        const cond_bb: LBasicBlock = LBasicBlock::append(current_fn, "fill.cond");
        const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "fill.body");
        const end_bb: LBasicBlock = LBasicBlock::append(current_fn, "fill.end");

        // Alloca the counter in the CURRENT block, not via create_entry_alloca.
        // The entry block may already hold allocas for preceding locals and
        // is about to get its `br cond_bb` terminator; inserting another
        // alloca via `position_at_end(entry)` after we've emitted a
        // terminator there lands the instruction after the terminator and
        // breaks the block.  Inline alloca keeps the block well-formed and
        // LLVM still optimizes it correctly.
        const i_slot: LValue = this.cg.builder.build_alloca(LType::i64(), "fill.i");
        this.cg.builder.build_store(
            LType::const_int(LType::i64(), 0, false), i_slot);
        this.cg.builder.build_br(cond_bb);

        this.cg.builder.position_at_end(cond_bb);
        const cur: LValue = this.cg.builder.build_load(LType::i64(), i_slot, "fill.cur");
        const done: LValue = this.cg.builder.build_icmp(LIntPredicate::UGE, cur, count_val, "fill.done");
        this.cg.builder.build_cond_br(done, end_bb, body_bb);

        this.cg.builder.position_at_end(body_bb);
        const buf: void* = intrinsics::malloc(16);
        const buf_arr: void** = buf as void**;
        buf_arr[0] = LType::const_int(LType::i64(), 0, false).raw;
        buf_arr[1] = cur.raw;
        const slot: LValue = this.cg.builder.build_gep(arr_ty, base, buf, 2, "fill.slot");
        intrinsics::free(buf);
        if (fill_val.is_valid() && slot.is_valid()) {
            this.cg.builder.build_store(fill_val, slot);
        }
        const one: LValue = LType::const_int(LType::i64(), 1, false);
        const nxt: LValue = this.cg.builder.build_add(cur, one, "fill.nxt");
        this.cg.builder.build_store(nxt, i_slot);
        this.cg.builder.build_br(cond_bb);

        this.cg.builder.position_at_end(end_bb);
    }

    /// Fill a raw element-typed pointer (dynamic buffer from malloc) by
    /// looping through indices [0..count) with a single-index GEP.
    emit_fill_loop_raw(mut &this, current_fn: LValue, elem_ty: LType,
                        base: LValue, fill_val: LValue, count_val: LValue) -> void {
        const cond_bb: LBasicBlock = LBasicBlock::append(current_fn, "fill.cond");
        const body_bb: LBasicBlock = LBasicBlock::append(current_fn, "fill.body");
        const end_bb: LBasicBlock = LBasicBlock::append(current_fn, "fill.end");

        // See `emit_fill_loop_indexed` above for why this alloca goes in
        // the current block, not via `create_entry_alloca`.
        const i_slot: LValue = this.cg.builder.build_alloca(LType::i64(), "fill.i");
        this.cg.builder.build_store(
            LType::const_int(LType::i64(), 0, false), i_slot);
        this.cg.builder.build_br(cond_bb);

        this.cg.builder.position_at_end(cond_bb);
        const cur: LValue = this.cg.builder.build_load(LType::i64(), i_slot, "fill.cur");
        const done: LValue = this.cg.builder.build_icmp(LIntPredicate::UGE, cur, count_val, "fill.done");
        this.cg.builder.build_cond_br(done, end_bb, body_bb);

        this.cg.builder.position_at_end(body_bb);
        const buf: void* = intrinsics::malloc(8);
        const buf_arr: void** = buf as void**;
        buf_arr[0] = cur.raw;
        const slot: LValue = this.cg.builder.build_gep(elem_ty, base, buf, 1, "fill.slot");
        intrinsics::free(buf);
        if (fill_val.is_valid() && slot.is_valid()) {
            this.cg.builder.build_store(fill_val, slot);
        }
        const one: LValue = LType::const_int(LType::i64(), 1, false);
        const nxt: LValue = this.cg.builder.build_add(cur, one, "fill.nxt");
        this.cg.builder.build_store(nxt, i_slot);
        this.cg.builder.build_br(cond_bb);

        this.cg.builder.position_at_end(end_bb);
    }

    /// Lambda expression: emit an anonymous non-capturing function and return
    /// its function pointer.  Only explicit-type, non-capturing lambdas are
    /// supported: each parameter must carry a type annotation, and the return
    /// type must be written out (`-> T`) in the source.  Captures are not
    /// implemented yet (no closure environment is built).
    override visit(mut &this, node: LambdaExprNode*) -> void {
        if (node == null) {
            this.last_value    = LValue::null();
            this.last_is_lvalue = false;
            return;
        }

        const ctx_ptr: CompilationContext* = this.cg.ctx;
        const intern:  InternTable*        = this.cg.get_intern();

        // ── Generate a unique function name ───────────────────────────────────
        const lam_idx: u64 = g_lambda_counter;
        g_lambda_counter += 1;
        const lam_name: string = format("__lambda_%lld", lam_idx as i64);

        // ── Resolve return type ───────────────────────────────────────────────
        mut ret_ty: LType = LType::void_type();
        if (node.return_type.is_valid()) {
            // Sema already filled it in.
            const mapped: LType = this.cg.type_mapper.map_type(node.return_type);
            if (mapped.is_valid()) { ret_ty = mapped; }
        } else if (node.return_type_ann != null && ctx_ptr.type_resolver != null) {
            mut res_ctx: ResolutionContext = ResolutionContext::new(
                ctx_ptr.source_file, "");
            const ret_ref: TypeRef = ctx_ptr.type_resolver.resolve(node.return_type_ann, &res_ctx);
            if (ret_ref.is_valid()) {
                const mapped: LType = this.cg.type_mapper.map_type(ret_ref);
                if (mapped.is_valid()) { ret_ty = mapped; }
            }
        }

        // ── Resolve parameter types ───────────────────────────────────────────
        const param_count: u32 = node.parameters.length as u32;
        const param_buf: void* = intrinsics::malloc(param_count as u64 * 8);
        const param_slots: void** = param_buf as void**;
        mut params_valid: boolean = true;

        mut res_ctx2: ResolutionContext = ResolutionContext::new(
            ctx_ptr.source_file, "");

        mut param_refs: TypeRef[] = [];
        for (mut i: u32 = 0; i < param_count; i++) {
            const param: VarDeclNode* = node.parameters[i];
            mut param_ty: LType = LType::null();

            if (param.resolved_type.is_valid()) {
                param_ty = this.cg.type_mapper.map_type(param.resolved_type);
            } else if (param.type_annotation != null && ctx_ptr.type_resolver != null) {
                const pref: TypeRef = ctx_ptr.type_resolver.resolve(
                    param.type_annotation, &res_ctx2);
                param_refs.push(pref);
                if (pref.is_valid()) {
                    param_ty = this.cg.type_mapper.map_type(pref);
                }
            }

            if (!param_ty.is_valid()) {
                this.cg.emit_warning_at_span(ErrorCode::E0600_CODEGEN_FAILED,
                    format("lambda: cannot resolve type for parameter '%s'; lambda skipped",
                        intern.resolve(param.name)),
                    param.span);
                params_valid = false;
                break;
            }
            param_slots[i] = param_ty.raw;
        }

        if (!params_valid) {
            intrinsics::free(param_buf);
            this.last_value    = LValue::null();
            this.last_is_lvalue = false;
            return;
        }

        // ── Build LLVM function ───────────────────────────────────────────────
        const fn_type: LType  = LType::function_type(ret_ty, param_buf, param_count, false);
        intrinsics::free(param_buf);
        const fn_val: LValue  = this.cg.llvm_module.add_function(lam_name, fn_type);
        if (!fn_val.is_valid()) {
            this.last_value    = LValue::null();
            this.last_is_lvalue = false;
            return;
        }

        // Register so that cross-module references can find it.
        const lam_sym: SymbolStr = intern.intern(lam_name);
        this.cg.register_function(lam_sym, fn_val);

        // ── Save builder insertion point (we're mid-function) ─────────────────
        const saved_bb: LBasicBlock = this.cg.builder.get_insert_block();

        // ── Build function entry block + body ─────────────────────────────────
        const entry_bb: LBasicBlock = LBasicBlock::append(fn_val, "entry");
        this.cg.builder.position_at_end(entry_bb);
        this.cg.push_scope();

        // Bind each parameter to an alloca so the body can refer to them.
        for (mut pi: u32 = 0; pi < param_count; pi++) {
            const param: VarDeclNode* = node.parameters[pi];
            const param_name: string  = intern.resolve(param.name);

            // Re-derive the LLVM type for the alloca.
            mut p_ty: LType = LType::null();
            if (param.resolved_type.is_valid()) {
                p_ty = this.cg.type_mapper.map_type(param.resolved_type);
            } else if (pi < param_refs.length as u32 && param_refs[pi as i64].is_valid()) {
                p_ty = this.cg.type_mapper.map_type(param_refs[pi as i64]);
            }
            if (!p_ty.is_valid()) { continue; }

            const alloca: LValue = this.cg.create_entry_alloca(fn_val, param_name, p_ty);
            const arg:    LValue = LValue { raw: llvm::LLVMGetParam(fn_val.raw, pi) };
            this.cg.builder.build_store(arg, alloca);
            this.cg.set_named_value(param.name, alloca);
        }

        // Generate the body.
        if (node.body != null) {
            if (node.body.kind == NodeKind::BlockStatement) {
                this.generate_block(node.body as BlockStmtNode*);
            } else {
                this.generate_statement(node.body);
            }
        }

        // Ensure the entry block has a terminator.
        const cur_bb: LBasicBlock = this.cg.builder.get_insert_block();
        if (cur_bb.is_valid() && !cur_bb.has_terminator()) {
            const rk: LTypeKind = type_kind_of(ret_ty.raw);
            if (rk == LTypeKind::Void) {
                this.cg.builder.build_ret_void();
            } else {
                // Non-void without a terminator → unreachable.
                this.cg.builder.build_unreachable();
            }
        }

        // Sweep orphaned empty blocks (same as codegen_function_epilogue).
        mut sweep_bb: void* = llvm::LLVMGetFirstBasicBlock(fn_val.raw);
        while (sweep_bb != null) {
            const lbb: LBasicBlock = LBasicBlock { raw: sweep_bb };
            if (!lbb.has_terminator()
                    && llvm::LLVMGetFirstInstruction(sweep_bb) == null) {
                this.cg.builder.position_at_end(lbb);
                this.cg.builder.build_unreachable();
            }
            sweep_bb = llvm::LLVMGetNextBasicBlock(sweep_bb);
        }

        this.cg.pop_scope();

        // ── Restore the outer function's insert point ─────────────────────────
        if (saved_bb.is_valid()) {
            this.cg.builder.position_at_end(saved_bb);
        }

        // The value of a lambda expression is the function pointer itself.
        this.last_value    = fn_val;
        this.last_is_lvalue = false;
    }

    /// Scope resolution: direct dispatch.
    override visit(mut &this, node: ScopeResolutionNode*) -> void {
        const intern: InternTable* = this.cg.get_intern();
        const di: DeclarationIndex* = this.cg.get_decl_index();

        // ── 1. Simple combined lookup (bare scope_name::member_name) ─────────
        const scope_str_bare: string = this.cg.resolve(node.scope_name);
        const member_str: string     = this.cg.resolve(node.member_name);
        const combined_bare: string  = format("%s::%s", scope_str_bare, member_str);
        const sym_bare: SymbolStr    = this.cg.intern_str(combined_bare);

        mut fn_val: LValue = resolve_function(this.cg, sym_bare);
        if (fn_val.is_valid()) {
            this.last_value    = fn_val;
            this.last_is_lvalue = false;
            return;
        }

        // ── 2. Qualified scope lookup ─────────────────────────────────────────
        // Static methods are registered under their fully-qualified owner name
        // (e.g. `MyNS::Handler::greet_static`).  Resolve the scope name through
        // the DI type map; the same approach the call-site path uses.
        const resolved_scope: SymbolStr = di.resolve_qualified(node.scope_name);
        const scope_str_qual: string    = intern.resolve(resolved_scope);
        const combined_qual: string     = format("%s::%s", scope_str_qual, member_str);
        const sym_qual: SymbolStr       = intern.intern(combined_qual);

        if (!sym_qual.equals(sym_bare)) {
            fn_val = this.cg.get_function(sym_qual);
            if (!fn_val.is_valid()) {
                fn_val = resolve_function(this.cg, sym_qual);
            }
            if (fn_val.is_valid()) {
                this.last_value    = fn_val;
                this.last_is_lvalue = false;
                return;
            }
        }

        // ── 3. Global variable lookups ────────────────────────────────────────
        const global: LValue = resolve_global(this.cg, sym_bare);
        if (global.is_valid()) {
            this.last_value    = global;
            this.last_is_lvalue = true;
            return;
        }
        // Bare-name global lookup. Top-level `const X: T = ...` declarations
        // register globals under their bare name (e.g. `O_RDWR`); when
        // referenced as `libc::O_RDWR` from another module the combined-
        // name lookup misses, so also try the bare member name. Globals
        // are unique LLVM symbols at link time, so the bare name resolves
        // to the same definition regardless of which module references it.
        const bare_global: LValue = resolve_global(this.cg, node.member_name);
        if (bare_global.is_valid()) {
            this.last_value    = bare_global;
            this.last_is_lvalue = true;
            return;
        }

        // ── 4. Enum variant reference (e.g., Option::None) ───────────────────
        // Use resolved_type from sema to find the concrete enum type.
        // Follow InstantiatedType chain (may be multiple levels).
        mut real_ref: TypeRef = node.resolved_type;
        mut real_t: Type* = this.cg.lookup_type_by_id(real_ref.id);
        mut sr_depth: i32 = 0;
        while (real_t != null && real_t.kind == TypeKind::InstantiatedType && sr_depth < 5) {
            const inst: InstantiatedType* = real_t as InstantiatedType*;
            if (inst.has_resolved_type()) {
                real_ref = inst.resolved_type;
                real_t = this.cg.lookup_type_by_id(real_ref.id);
            } else { break; }
            sr_depth += 1;
        }
        if (real_t != null && real_t.kind == TypeKind::Enum) {
            const et: EnumType* = real_t as EnumType*;
            const variant: EnumVariantInfo* = et.get_variant(node.member_name);
            if (variant != null) {
                mut no_args: LValue[] = [];
                this.last_value = this.build_enum_variant(et, variant, real_ref, no_args);
                this.last_is_lvalue = false;
                return;
            }
        }

        this.last_value    = LValue::null();
        this.last_is_lvalue = false;
    }

    /// Match expression: produces a value via phi node.
    /// Same comparison chain as visit_match_stmt, but each arm evaluates
    /// to a value and the merge block collects them with a phi.
    override visit(mut &this, node: MatchExprNode*) -> void {
        if (node.subject == null || node.arms.length == 0) {
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }

        const current_fn: LValue = this.get_current_function();
        if (!current_fn.is_valid()) {
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }

        const subject: LValue = this.codegen_rvalue(node.subject);
        if (!subject.is_valid()) {
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }

        const minfo: MatchSubjectInfo = this.prepare_match_subject(
            subject, node.subject.resolved_type, current_fn);

        // String subjects need strcmp (i8* content compare), not icmp
        // (which would compare pointer addresses).
        const e_subj_t: Type* = this.cg.lookup_type_by_id(node.subject.resolved_type.id);
        const is_string_subj_e: boolean = e_subj_t != null &&
            e_subj_t.kind == TypeKind::String;

        const num_arms: i64 = node.arms.length;

        // Create basic blocks: one per arm + a no_match trap + merge.
        mut arm_bbs: LBasicBlock[] = [];
        for (mut i: i64 = 0; i < num_arms; i++) {
            arm_bbs.push(LBasicBlock::append(current_fn, format("mexpr.arm%lld", i)));
        }
        // no_match block traps when the discriminant matches no arm; same
        // rationale as visit_match_stmt: without the trap, control silently
        // slides into adjacent function code.  No phi predecessor is added
        // for this block since it doesn't reach merge_bb.
        const default_bb: LBasicBlock = LBasicBlock::append(current_fn, "mexpr.no_match");
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "mexpr.end");

        // Comparison chain, same as visit_match_stmt.
        for (mut i: i64 = 0; i < num_arms; i++) {
            const arm: MatchArmNode* = node.arms[i];
            if (arm == null) { continue; }

            mut next_bb: LBasicBlock = default_bb;
            if (i + 1 < num_arms) {
                next_bb = LBasicBlock::append(current_fn, format("mexpr.test%lld", i + 1));
            }

            // Emit the OR-pattern comparison chain for this arm (see
            // visit(MatchStmtNode*); identical lowering, "mexpr" prefix).
            this.emit_match_arm_comparison(arm, arm_bbs[i], next_bb,
                minfo, is_string_subj_e, subject, current_fn, "mexpr");

            if (i + 1 < num_arms) {
                this.cg.builder.position_at_end(next_bb);
            }
        }

        // Generate arm bodies and collect values + end blocks for phi.
        // Allocate num_arms + 1 for the default block entry.
        const result_ty: LType = this.cg.type_mapper.map_type(node.resolved_type);
        mut phi_vals: void* = intrinsics::malloc((num_arms + 1) as u64 * 8);
        mut phi_blks: void* = intrinsics::malloc((num_arms + 1) as u64 * 8);
        const phi_vals_arr: void** = phi_vals as void**;
        const phi_blks_arr: void** = phi_blks as void**;
        mut phi_count: u32 = 0;

        for (mut i: i64 = 0; i < num_arms; i++) {
            const arm: MatchArmNode* = node.arms[i];
            if (arm == null) { continue; }

            this.cg.builder.position_at_end(arm_bbs[i]);

            this.cg.push_scope();
            this.bind_arm_enum_payloads(arm, minfo);

            // Match expression arms produce values.
            // The arm body is a statement; for expression arms, it's typically
            // a block with a trailing expression or a single expression statement.
            mut arm_val: LValue = LValue::null();
            if (arm.body != null) {
                this.generate_statement(arm.body);
                arm_val = this.last_value;
            }

            const arm_end: LBasicBlock = this.cg.builder.get_insert_block();
            const arm_terminated: boolean = arm_end.is_valid() && arm_end.has_terminator();

            // Coerce the arm value to the phi's result type BEFORE emitting
            // the branch.  `coerce_to_phi_type` may insert a `zext`/`sext`/
            // `inttoptr` at the builder's current position; if we br first,
            // those coercion instructions land AFTER the terminator, which
            // (a) makes the block end with a non-terminator instruction so
            // `LLVMGetBasicBlockTerminator` returns null, (b) gets the body
            // stripped by `is_function_body_valid`.  Coerce-then-branch
            // keeps the order valid.
            mut coerced_val: LValue = LValue::null();
            if (!arm_terminated && arm_end.is_valid() && arm_val.is_valid()) {
                coerced_val = coerce_to_phi_type(this.cg, arm_val, result_ty,
                                                 node.resolved_type);
            }
            if (!arm_terminated && arm_end.is_valid()) {
                this.cg.builder.build_br(merge_bb);
            }

            // Only add to phi for arms that branch to merge (not terminated
            // by return/break). Every predecessor of merge_bb needs a phi entry.
            if (!arm_terminated && arm_end.is_valid()) {
                if (coerced_val.is_valid()) {
                    phi_vals_arr[phi_count] = coerced_val.raw;
                } else if (result_ty.is_valid()) {
                    // Arm produced no value; use undef as placeholder.
                    phi_vals_arr[phi_count] = llvm::LLVMGetUndef(result_ty.raw);
                } else {
                    this.cg.pop_scope();
                    continue;
                }
                phi_blks_arr[phi_count] = arm_end.raw;
                phi_count += 1;
            }
            this.cg.pop_scope();
        }

        // No arm matched; trap with `call @abort(); unreachable`.  Bare
        // `unreachable` lowers to nothing on x86, letting a runtime
        // fall-through silently continue into the next function in the
        // binary; the abort call guarantees a clean SIGABRT.  If the match
        // is exhaustive (e.g., wildcard arm), default_bb is unreachable and
        // LLVM elides it.
        if (!default_bb.has_terminator()) {
            this.cg.builder.position_at_end(default_bb);
            const abort_fn_e: LValue = get_or_decl_abort(this.cg);
            const abort_ty_e: LType = LType { raw: llvm::LLVMGlobalGetValueType(abort_fn_e.raw) };
            mut a_args_e: Pair<LValue, TypeRef>[] = [];
            mut a_res_e: LValue = LValue::null();
            codegen_call(this.cg, abort_fn_e, abort_ty_e, a_args_e, "", &a_res_e);
            this.cg.builder.build_unreachable();
        }

        this.cg.builder.position_at_end(merge_bb);

        if (phi_count > 0 && result_ty.is_valid()) {
            const phi: LValue = this.cg.builder.build_phi(result_ty, "mexpr.val");
            phi_add_incoming(phi, phi_vals, phi_blks, phi_count);
            this.last_value = phi;
        } else {
            this.last_value = LValue::null();
        }
        this.last_is_lvalue = false;

        intrinsics::free(phi_vals);
        intrinsics::free(phi_blks);
    }

    /// Ternary/if expression: direct dispatch.
    override visit(mut &this, node: TernaryExprNode*) -> void {
        const cond: LValue = this.codegen_rvalue(node.condition);
        const current_fn: LValue = this.get_current_function();
        const then_bb: LBasicBlock = LBasicBlock::append(current_fn, "ternary.then");
        const else_bb: LBasicBlock = LBasicBlock::append(current_fn, "ternary.else");
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "ternary.merge");
        this.cg.builder.build_cond_br(cond, then_bb, else_bb);

        this.cg.builder.position_at_end(then_bb);
        const then_val: LValue = this.codegen_rvalue(node.true_expr);
        const then_end: LBasicBlock = this.cg.builder.get_insert_block();
        branch_if_not_terminated(this.cg, merge_bb);

        this.cg.builder.position_at_end(else_bb);
        const else_val: LValue = this.codegen_rvalue(node.false_expr);
        const else_end: LBasicBlock = this.cg.builder.get_insert_block();
        branch_if_not_terminated(this.cg, merge_bb);

        this.cg.builder.position_at_end(merge_bb);
        const ty: LType = this.cg.type_mapper.map_type(node.resolved_type);
        const phi: LValue = this.cg.builder.build_phi(ty, "ternary");
        const vals: void* = intrinsics::malloc(16);
        const blks: void* = intrinsics::malloc(16);
        const vals_arr: void** = vals as void**;
        const blks_arr: void** = blks as void**;
        vals_arr[0] = then_val.raw;
        vals_arr[1] = else_val.raw;
        blks_arr[0] = then_end.raw;
        blks_arr[1] = else_end.raw;
        phi_add_incoming(phi, vals, blks, 2);
        intrinsics::free(vals);
        intrinsics::free(blks);
        this.last_value = phi;
        this.last_is_lvalue = false;
    }

    /// Try operator `expr?`: sema lowered it to an equivalent `match`
    /// stored on `desugared`, so codegen just emits that.  `desugared` is
    /// non-null for any `TryExprNode` that passed semantic analysis; a null
    /// here means sema rejected the operand, and a diagnostic already fired.
    override visit(mut &this, node: TryExprNode*) -> void {
        if (node.desugared != null) {
            node.desugared.accept(this);
            return;
        }
        this.cg.emit_error_at_span(ErrorCode::E0600_CODEGEN_FAILED,
            "codegen: `?` operator was not lowered by semantic analysis",
            node.span);
        this.last_value     = LValue::null();
        this.last_is_lvalue = false;
    }

    /// New expression (heap allocation): direct dispatch.
    override visit(mut &this, node: NewExprNode*) -> void {
        // Resolve the type name: try current module's qualified form first,
        // then fall back to the DI's bare→qualified mapping, then the raw
        // name (for already-qualified cases and cross-module aliases).
        const ctx_ptr: CompilationContext* = this.cg.ctx;
        const intern: InternTable* = this.cg.get_intern();
        const di: DeclarationIndex* = this.cg.get_decl_index();

        mut qualified_sym: SymbolStr = ctx_ptr.qualify_symbol_sym(node.type_name);
        mut type_ref: TypeRef = di.lookup_type(qualified_sym);
        if (type_ref.is_invalid()) {
            qualified_sym = di.resolve_qualified(node.type_name);
            type_ref = di.lookup_type(qualified_sym);
        }
        if (type_ref.is_invalid()) {
            qualified_sym = node.type_name;
            type_ref = di.lookup_type(qualified_sym);
        }

        const t: Type* = this.cg.lookup_type_by_id(type_ref.id);
        if (t == null) {
            this.cg.emit_error_at_span(ErrorCode::E0635_TYPE_CONSTRUCTOR_UNDEFINED,
                format("codegen: 'new': target type '%s' not found",
                    intern.resolve(node.type_name)),
                node.span);
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }

        // Heap-allocated enum variant: see HANDOFF.md Bug #15.  INCOMPLETE.
        if (t.kind == TypeKind::Enum && node.has_variant()) {
            const et: EnumType* = t as EnumType*;
            const variant: EnumVariantInfo* = et.get_variant(node.variant_name);
            if (variant == null) {
                this.cg.emit_error_at_span(ErrorCode::E0635_TYPE_CONSTRUCTOR_UNDEFINED,
                    "codegen: enum variant not found in `new T::V(...)`",
                    node.span);
                this.last_value = LValue::null();
                this.last_is_lvalue = false;
                return;
            }
            mut vargs: LValue[] = [];
            for (mut i: i64 = 0; i < node.arguments.length; i++) {
                vargs.push(this.codegen_rvalue(node.arguments[i]));
            }
            const variant_val: LValue = this.build_enum_variant(et, variant, type_ref, vargs);
            this.last_value = heap_box_enum_variant(this.cg, et, type_ref, variant_val, node.span);
            this.last_is_lvalue = false;
            return;
        }

        const malloc_fn: LValue = resolve_function(this.cg, this.cg.intern_str("malloc"));
        if (!malloc_fn.is_valid()) {
            this.cg.emit_error_at_span(ErrorCode::E0636_UNDEFINED_FUNCTION_CALL,
                "codegen: 'new' expression: 'malloc' not declared",
                node.span);
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }
        const malloc_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(malloc_fn.raw) };
        if (!malloc_ty.is_valid()) {
            this.cg.emit_error_at_span(ErrorCode::E0602_INVALID_LLVM_TYPE,
                "codegen: 'new' expression: failed to retrieve malloc function type",
                node.span);
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }

        const mapped: LType = this.cg.type_mapper.map_type(type_ref);
        // Virtual dispatch through `t.size_bytes()` resolves to the base
        // `Type::size_bytes` (which returns 0) when cryoc's codegen hasn't
        // wired vtable dispatch yet.  Pull `computed_size` directly from the
        // concrete type based on kind; type_lowering already accounted for
        // inheritance in that value.
        mut size: u64 = 0;
        if (t.kind == TypeKind::Class) {
            const ct: ClassType* = t as ClassType*;
            size = ct.computed_size;
        } else if (t.kind == TypeKind::Struct) {
            const st: StructType* = t as StructType*;
            size = st.computed_size;
        } else if (t.kind == TypeKind::Enum) {
            const et: EnumType* = t as EnumType*;
            size = et.computed_size;
        } else {
            size = t.size_bytes();
        }
        if (size == 0) { size = 1; }  // safe fallback; malloc(0) is UB on some platforms

        const size_val: LValue = LType::const_int(LType::i64(), size, false);
        // Avoid the single-element array literal form (`[size_val]`); the C++
        // Cryo compiler miscompiles it: emits `alloca [1 x T]` but then loads
        // as `Array<T>` (3-field struct), reading 16 bytes of stack garbage
        // into the length/capacity fields.  Downstream code that reads
        // `args.length` (e.g., `codegen_call`) then feeds the garbage into
        // `LLVMBuildCall2` as NumArgs → `bad_alloc`.  `push` on an empty
        // array initializes the struct correctly.
        mut malloc_args: Pair<LValue, TypeRef>[] = [];
        malloc_args.push(Pair<LValue, TypeRef>::new(size_val, TypeRef::invalid()));
        mut raw_ptr: LValue = LValue::null();
        codegen_call(this.cg, malloc_fn, malloc_ty, malloc_args, "newtmp", &raw_ptr);

        // Bitcast to the target struct pointer type.
        mut obj_ptr: LValue = raw_ptr;
        if (mapped.is_valid()) {
            obj_ptr = this.cg.builder.build_pointer_cast(
                raw_ptr, LType::pointer_to(mapped), "newcast");
        }

        // Store the vtable pointer at slot 0 for classes with virtual methods.
        // The vtable global is emitted by codegen_vtable_for_class in the
        // owning module's codegen pass.  When `new` is used in a different
        // module than the class declaration, the vtable global isn't yet in
        // the current LLVM module's symbol table; declare it as an extern
        // (no initializer) so the link step resolves it to the owning
        // module's definition.
        if (t.kind == TypeKind::Class) {
            const cls: ClassType* = t as ClassType*;
            if (cls.has_virtual_methods && mapped.is_valid() && obj_ptr.is_valid()) {
                const qname: QualifiedName = QualifiedName::from_symbol(qualified_sym);
                const vtbl_name: string = MangledName::for_vtable(intern, qname).resolve(intern);
                mut vtbl_global: LValue = this.cg.llvm_module.get_named_global(vtbl_name);
                if (!vtbl_global.is_valid()) {
                    // Cross-module reference: emit an extern declaration.
                    // The placeholder type doesn't have to match the
                    // definition exactly: opaque pointers mean we only
                    // store the global's address, and the linker resolves
                    // by symbol name regardless of the IR-level type.
                    const fn_ptr_ty: LType = LType::pointer_to(LType::i8());
                    const placeholder_ty: LType = LType::array_of(fn_ptr_ty, 1);
                    vtbl_global = this.cg.llvm_module.add_global(placeholder_ty, vtbl_name);
                }
                if (vtbl_global.is_valid()) {
                    const vptr_slot: LValue = this.cg.builder.build_struct_gep(
                        mapped, obj_ptr, 0, "vptr.slot");
                    if (vptr_slot.is_valid()) {
                        this.cg.builder.build_store(vtbl_global, vptr_slot);
                    }
                }
            }
        }

        // Initialize fields for `new T { fields }`. Without this the malloc'd
        // struct's fields are left uninitialized; every TypeAnnotation* the
        // parser produces would be a pointer to garbage. See HANDOFF Bug #15.
        if (node.struct_init != null && t.kind == TypeKind::Struct && mapped.is_valid()) {
            const lit: StructLiteralNode* = node.struct_init;
            const st: StructType* = t as StructType*;
            for (mut sfi: i64 = 0; sfi < lit.field_inits.length; sfi++) {
                const finit: FieldInit = lit.field_inits[sfi];
                const sf_fidx: i64 = st.field_index(finit.field_name);
                if (sf_fidx >= 0) {
                    const gep: LValue = this.cg.builder.build_struct_gep(mapped, obj_ptr, sf_fidx as u32, "field");
                    mut val: LValue = this.codegen_rvalue(finit.value);
                    if (val.is_valid() && gep.is_valid()) {
                        // Widen/narrow integer literal to field's declared
                        // width before storing.  `new ArrayAnnotation { size: -1, ... }`
                        // arrives with `-1` as `i32 -1` but `size` is `i64`
                        // a direct `store i32` writes 4 bytes leaving the
                        // upper 4 bytes of the i64 slot uninitialised, and
                        // `is_dynamic()`'s `size < 0` check then sees a huge
                        // positive number.  Mirrors codegen_struct_literal
                        // and codegen_local_var.
                        const field_llvm_ty: void* = llvm::LLVMStructGetTypeAtIndex(mapped.raw, sf_fidx as u32);
                        const val_ty_raw: void* = llvm::LLVMTypeOf(val.raw);
                        if (field_llvm_ty != null && val_ty_raw != null
                                && type_kind_of(field_llvm_ty) == LTypeKind::Integer
                                && type_kind_of(val_ty_raw) == LTypeKind::Integer) {
                            const want_bits: u32 = llvm::LLVMGetIntTypeWidth(field_llvm_ty);
                            const got_bits:  u32 = llvm::LLVMGetIntTypeWidth(val_ty_raw);
                            const field_lty: LType = LType { raw: field_llvm_ty };
                            if (want_bits > got_bits) {
                                mut signed_target: boolean = false;
                                const field_t: Type* = this.cg.lookup_type_by_id(
                                    st.fields[sf_fidx].field_type.id);
                                if (field_t != null && field_t.kind == TypeKind::Int) {
                                    const ft_int: IntType* = field_t as IntType*;
                                    signed_target = ft_int.int_kind.is_signed();
                                }
                                if (signed_target) {
                                    val = this.cg.builder.build_sext(val, field_lty, "field.widen");
                                } else {
                                    val = this.cg.builder.build_zext(val, field_lty, "field.widen");
                                }
                            } else if (want_bits < got_bits) {
                                val = this.cg.builder.build_trunc(val, field_lty, "field.trunc");
                            }
                        }
                        this.cg.builder.build_store(val, gep);
                    }
                }
            }
        }

        // Call the constructor.  Cryo constructors are named like the class
        // itself (e.g. `VoidType(id: u64)` on `class VoidType`).  The DI
        // registered the method under `QualifiedClass::BareClassName`.
        const type_str: string = intern.resolve(qualified_sym);
        const bare_str: string = intern.resolve(node.type_name);
        const ctor_combined: string = format("%s::%s", type_str, bare_str);
        const ctor_sym: SymbolStr = intern.intern(ctor_combined);
        // Constructor LLVM arity = user args + 1 for the implicit `this`.
        const ctor_arity: u32 = (node.arguments.length + 1) as u32;
        mut ctor_fn: LValue = resolve_function_with_arity(this.cg, ctor_sym, ctor_arity);
        if (!ctor_fn.is_valid()) {
            ctor_fn = resolve_function(this.cg, ctor_sym);
        }
        if (ctor_fn.is_valid() && obj_ptr.is_valid()) {
            const ctor_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(ctor_fn.raw) };
            if (ctor_ty.is_valid() && type_kind_of(ctor_ty.raw) == LTypeKind::Function) {
                // Same single-element-literal bug applies here; use push.
                mut ctor_args: Pair<LValue, TypeRef>[] = [];
                ctor_args.push(Pair<LValue, TypeRef>::new(obj_ptr, node.resolved_type));
                for (mut i: i64 = 0; i < node.arguments.length; i++) {
                    const arg_val: LValue = this.codegen_rvalue(node.arguments[i]);
                    ctor_args.push(Pair<LValue, TypeRef>::new(arg_val, node.arguments[i].resolved_type));
                }
                mut ctor_result: LValue = LValue::null();
                codegen_call(this.cg, ctor_fn, ctor_ty, ctor_args, "", &ctor_result);
            }
        }

        this.last_value = obj_ptr;
        this.last_is_lvalue = false;
    }

    /// Delete expression (heap free): direct dispatch.
    override visit(mut &this, node: DeleteExprNode*) -> void {
        // `delete ptr` is the manual-memory dual of an end-of-scope drop:
        //   1. Run the pointee's drop method, if it has one.
        //   2. Free the allocation.
        // The drop call is synthesized as `operand.drop()` and routed
        // through the normal method-dispatch path so trait `Drop` impls,
        // inherent `drop`, and virtual class destructors all reach the
        // right symbol.  The operand expression is then evaluated a
        // second time for the free; safe for identifiers and member
        // access on locals (the common case) but the caller should avoid
        // side-effecting operands like `delete some_fn()`.
        const operand_type: TypeRef = node.operand.resolved_type;
        const arena_ptr: TypeArena* = this.cg.get_arena();
        const intern_ptr: InternTable* = this.cg.get_intern();
        const registry_ptr: GenericRegistry* = this.cg.ctx.generic_registry;

        mut pointee: TypeRef = TypeRef::invalid();
        if (operand_type.is_valid() && arena_ptr != null) {
            const ot: Type* = arena_ptr.lookup(operand_type.id);
            if (ot != null && ot.kind == TypeKind::Pointer) {
                const pt: PointerType* = ot as PointerType*;
                pointee = pt.pointee;
            }
        }

        mut should_drop: boolean = false;
        if (pointee.is_valid() && arena_ptr != null && registry_ptr != null
                && intern_ptr != null) {
            should_drop =
                OwnershipQuery::has_inherent_drop(arena_ptr, registry_ptr,
                                                    intern_ptr, pointee)
                || OwnershipQuery::type_implements_drop(arena_ptr, registry_ptr,
                                                        intern_ptr, pointee);
        }

        if (should_drop) {
            const drop_sym: SymbolStr = intern_ptr.intern("drop");
            mut member: MemberAccessNode* = new MemberAccessNode(
                node.operand, drop_sym, node.span, node.span);
            member.set_resolved_type(TypeRef::invalid());
            mut call: CallExprNode* = new CallExprNode(
                member as ExpressionNode*, node.span);
            mut stmt: ExprStmtNode* = new ExprStmtNode(
                call as ExpressionNode*, node.span);
            stmt.accept(this);
        }

        const ptr: LValue = this.codegen_rvalue(node.operand);
        const free_fn: LValue = resolve_function(this.cg, this.cg.intern_str("free"));
        if (free_fn.is_valid() && ptr.is_valid()) {
            const void_ptr: LValue = this.cg.builder.build_pointer_cast(
                ptr, LType::pointer_to(LType::i8()), "delcast");
            const free_ty: LType = LType { raw: llvm::LLVMGlobalGetValueType(free_fn.raw) };
            if (free_ty.is_valid()) {
                mut free_args: Pair<LValue, TypeRef>[] = [];
                free_args.push(Pair<LValue, TypeRef>::new(void_ptr, TypeRef::invalid()));
                mut result: LValue = LValue::null();
                codegen_call(this.cg, free_fn, free_ty, free_args, "", &result);
            } else {
                this.cg.emit_error_at_span(ErrorCode::E0602_INVALID_LLVM_TYPE,
                    "codegen: 'delete' expression: failed to retrieve free function type",
                    node.span);
            }
        }
        this.last_value = LValue::null();
        this.last_is_lvalue = false;
    }

    /// Short-circuit evaluation for && and ||.
    visit_logical_short_circuit(mut &this, node: BinaryExprNode*) -> void {
        const is_and: boolean = node.op.kind == TokenType::AmpAmp;

        const lhs: LValue = this.codegen_rvalue(node.left);
        const current_bb: LBasicBlock = this.cg.builder.get_insert_block();
        const current_fn: LValue = this.get_current_function();

        const rhs_bb: LBasicBlock = LBasicBlock::append(current_fn, "sc.rhs");
        const merge_bb: LBasicBlock = LBasicBlock::append(current_fn, "sc.merge");

        if (is_and) {
            // &&: if lhs is false, short-circuit to merge with false.
            this.cg.builder.build_cond_br(lhs, rhs_bb, merge_bb);
        } else {
            // ||: if lhs is true, short-circuit to merge with true.
            this.cg.builder.build_cond_br(lhs, merge_bb, rhs_bb);
        }

        // Evaluate RHS.
        this.cg.builder.position_at_end(rhs_bb);
        const rhs: LValue = this.codegen_rvalue(node.right);
        const rhs_end_bb: LBasicBlock = this.cg.builder.get_insert_block();
        branch_if_not_terminated(this.cg, merge_bb);

        // If either operand failed to lower (e.g. `entry.key == key` where K
        // is a struct that doesn't support `==`, or any expression that
        // codegen_rvalue couldn't reduce to a value), don't synthesize a
        // phi with a null incoming; that produces invalid IR that LLVM
        // verification rejects. Leave merge_bb unterminated and signal
        // failure so the caller's downstream codegen also bails, which
        // ultimately leaves the function body unterminated and triggers
        // `is_function_body_valid` to strip the whole body. That's the
        // pre-existing "give up cleanly on lowering errors" path; before
        // this guard the SC branch was the one place that emitted broken
        // IR instead of bailing.
        if (!lhs.is_valid() || !rhs.is_valid()) {
            this.cg.builder.position_at_end(merge_bb);
            this.last_value = LValue::null();
            this.last_is_lvalue = false;
            return;
        }

        // Merge with phi.
        this.cg.builder.position_at_end(merge_bb);
        const phi: LValue = this.cg.builder.build_phi(LType::i1(), "sc.result");

        // Add incoming values.
        const vals_buf: void* = intrinsics::malloc(16);
        const vals: void** = vals_buf as void**;
        const blocks_buf: void* = intrinsics::malloc(16);
        const blocks: void** = blocks_buf as void**;

        vals[0] = lhs.raw;
        blocks[0] = current_bb.raw;
        vals[1] = rhs.raw;
        blocks[1] = rhs_end_bb.raw;
        phi_add_incoming(phi, vals_buf, blocks_buf, 2);

        intrinsics::free(vals_buf);
        intrinsics::free(blocks_buf);

        this.last_value = phi;
        this.last_is_lvalue = false;
    }

    // ========================================================================
    // Enum variant construction (inline)
    // ========================================================================

    /// Build an enum variant value.
    /// For simple enums: returns i32 tag constant.
    /// For ADT enums: returns { i32 tag, [N x i8] } with payload stored.
    build_enum_variant(mut &this, et: EnumType*, variant: EnumVariantInfo*,
                       enum_ref: TypeRef, args: LValue[]) -> LValue {
        const tag_val: LValue = LType::const_int(LType::i32(), variant.tag_value, false);

        // Simple enum: just an i32 tag.
        if (et.is_simple_enum()) {
            return tag_val;
        }

        // ADT enum: map the full enum type to { i32, [N x i8] }.
        const enum_llvm: LType = this.cg.type_mapper.map_type(enum_ref);
        if (!enum_llvm.is_valid()) {
            return LValue::null();
        }

        // No-payload variant on an ADT enum: return { tag, zeroinit }.
        if (!variant.has_payload()) {
            const null_val: LValue = LType::const_null(enum_llvm);
            const result: LValue = this.cg.builder.build_insert_value(
                null_val, tag_val, 0, "enum.tag");
            return result;
        }

        // Payload variant: alloca, store tag, store payload fields.
        const current_fn: LValue = this.get_current_function();
        const alloca: LValue = this.cg.create_entry_alloca(current_fn, "enum.tmp", enum_llvm);

        // Store tag at field 0 using struct GEP.
        const tag_ptr: LValue = this.cg.builder.build_struct_gep(enum_llvm, alloca, 0, "enum.tag.ptr");
        this.cg.builder.build_store(tag_val, tag_ptr);

        // Get pointer to payload at field 1.
        const payload_ptr: LValue = this.cg.builder.build_struct_gep(enum_llvm, alloca, 1, "enum.payload.ptr");

        // For single-payload variants, store the argument directly.
        // For multi-payload, store each field sequentially.
        if (args.length == 1 && variant.payload_types.length == 1) {
            const payload_ty: LType = this.cg.type_mapper.map_type(variant.payload_types[0]);
            if (payload_ty.is_valid()) {
                const typed_ptr: LValue = this.cg.builder.build_bitcast(
                    payload_ptr, LType::pointer_to(payload_ty), "enum.payload.cast");
                this.cg.builder.build_store(args[0], typed_ptr);
            }
        } else {
            // Multi-field payload: lay out sequentially.
            mut offset: u64 = 0;
            for (mut i: i64 = 0; i < args.length && i < variant.payload_types.length as i64; i++) {
                const field_ty: LType = this.cg.type_mapper.map_type(variant.payload_types[i]);
                if (!field_ty.is_valid()) { continue; }
                const byte_offset: LValue = LType::const_int(LType::i64(), offset, false);
                const obuf: void* = intrinsics::malloc(8);
                const obuf_arr: void** = obuf as void**;
                obuf_arr[0] = byte_offset.raw;
                const field_ptr_raw: LValue = this.cg.builder.build_gep(
                    LType::i8(), payload_ptr, obuf, 1, "enum.field.ptr");
                intrinsics::free(obuf);
                const field_ptr: LValue = this.cg.builder.build_bitcast(
                    field_ptr_raw, LType::pointer_to(field_ty), "enum.field.cast");
                this.cg.builder.build_store(args[i], field_ptr);
                // Advance offset by the field's size.
                const ft: Type* = this.cg.lookup_type_by_id(variant.payload_types[i].id);
                if (ft != null) {
                    offset += ft.size_bytes();
                }
            }
        }

        // Load and return the complete enum value.
        return this.cg.builder.build_load(enum_llvm, alloca, "enum.val");
    }


    // ========================================================================
    // Unsupported AST node kinds
    // ========================================================================
    //
    // The parser builds these nodes for syntactic completeness, but no
    // codegen lowering exists yet.  Without these overrides the default
    // no-op in BaseASTVisitor leaves `last_value` stale from the previous
    // expression, which the caller would silently consume; a real
    // miscompile vector.  Emit a clear diagnostic instead and clear
    // `last_value` so downstream code fails loudly rather than wrongly.

    override visit(mut &this, node: AwaitExprNode*) -> void {
        this.cg.emit_error_at_span(ErrorCode::E0600_CODEGEN_FAILED,
            "codegen: 'await' expressions are not implemented",
            node.span);
        this.last_value     = LValue::null();
        this.last_is_lvalue = false;
    }

    override visit(mut &this, node: YieldExprNode*) -> void {
        this.cg.emit_error_at_span(ErrorCode::E0600_CODEGEN_FAILED,
            "codegen: 'yield' expressions are not implemented",
            node.span);
        this.last_value     = LValue::null();
        this.last_is_lvalue = false;
    }

    override visit(mut &this, node: TypeofExprNode*) -> void {
        this.cg.emit_error_at_span(ErrorCode::E0600_CODEGEN_FAILED,
            "codegen: 'typeof' expressions are not implemented",
            node.span);
        this.last_value     = LValue::null();
        this.last_is_lvalue = false;
    }

    override visit(mut &this, node: DoWhileStmtNode*) -> void {
        this.cg.emit_error_at_span(ErrorCode::E0600_CODEGEN_FAILED,
            "codegen: 'do { ... } while (...)' statements are not implemented; use 'while' or 'loop' instead",
            node.span);
    }

    override visit(mut &this, node: SwitchStmtNode*) -> void {
        this.cg.emit_error_at_span(ErrorCode::E0600_CODEGEN_FAILED,
            "codegen: 'switch' statements are not implemented; use 'match' instead",
            node.span);
    }

    override visit(mut &this, node: CaseStmtNode*) -> void {
        this.cg.emit_error_at_span(ErrorCode::E0600_CODEGEN_FAILED,
            "codegen: 'case' statements are not implemented; use 'match' arms instead",
            node.span);
    }
}


// ============================================================================
// Phi-operand coercion
// ============================================================================

/// Coerce `val` to match `expected` for use as a phi-node operand.  LLVM
/// requires every phi incoming to have the phi's result type exactly, and
/// match arms routinely produce differently-sized integers (e.g. an i32
/// payload binding in one arm vs an i64 literal in another, both feeding a
/// phi typed by the outer `const x: i64 =` declaration).  Mirrors the
/// widening/narrowing logic in `coerce_return_value`; returns the original
/// value when no cheap conversion applies.  LLVM kind codes: 0=void, 8=int,
/// 10=struct, 12=pointer.
///
/// `result_ty` is the Cryo type of the whole match/if expression — every
/// arm must produce a value compatible with it, so its signedness drives
/// the sext-vs-zext choice when an arm value is narrower than the phi type.
function coerce_to_phi_type(cg: CodegenContext*, val: LValue,
                             expected: LType, result_ty: TypeRef) -> LValue {
    if (!val.is_valid() || !expected.is_valid()) { return val; }

    // NB: do NOT compare `void*`-typed LLVMTypeRef values with `==`; the
    // C++ Cryo bootstrap compiler lowers that to strcmp, which returns
    // "equal" for structurally-different types and short-circuits the
    // coercion path.  Dispatch on kind + width instead.
    const got_ty: void* = llvm::LLVMTypeOf(val.raw);
    const want_ty: void* = expected.raw;
    const gk: LTypeKind = type_kind_of(got_ty);
    const wk: LTypeKind = type_kind_of(want_ty);

    // int ↔ int: widen or narrow.
    if (gk == LTypeKind::Integer && wk == LTypeKind::Integer) {
        const gw: u32 = llvm::LLVMGetIntTypeWidth(got_ty);
        const ww: u32 = llvm::LLVMGetIntTypeWidth(want_ty);
        if (gw == ww) { return val; }
        if (gw < ww) {
            // Widen with the result type's signedness: a signed match arm
            // feeding a wider signed phi must sext, or `-1` becomes a huge
            // positive value.
            if (cg.int_type_is_signed(result_ty)) {
                return cg.builder.build_sext(val, expected, "mexpr.widen");
            }
            return cg.builder.build_zext(val, expected, "mexpr.widen");
        }
        return cg.builder.build_trunc(val, expected, "mexpr.trunc");
    }

    // int → ptr / ptr → int: match the `coerce_return_value` conventions.
    if (gk == LTypeKind::Integer && wk == LTypeKind::Pointer) {
        return LValue { raw: llvm::LLVMBuildIntToPtr(cg.builder.raw, val.raw, want_ty, "mexpr.i2p") };
    }
    if (gk == LTypeKind::Pointer && wk == LTypeKind::Integer) {
        return LValue { raw: llvm::LLVMBuildPtrToInt(cg.builder.raw, val.raw, want_ty, "mexpr.p2i") };
    }

    // Same-kind struct/ptr/etc with different SHAPE is not safely
    // convertible at this level; return as-is and let LLVM verification
    // surface the mismatch.
    return val;
}


// ============================================================================
// Module-graph suffix matching for `Shorthand::member` ScopeResolution
// ============================================================================

/// Walk the module graph and return every qualified function name that
/// matches `<full_namespace>::<member>` where `<full_namespace>` ends with
/// `::scope_str` (or equals `scope_str` exactly).  Used by the
/// ScopeResolution codegen path so a shorthand `libc::read` resolves
/// directly to `std::ffi::libc::read`, instead of falling through to the
/// last-write-wins bare-name overload slot.
///
/// Only entries that have a probe-able function signature in the codegen
/// (arity-matched declaration) are returned.  A length-1 result is the
/// happy path; length > 1 surfaces an E0154 ambiguity at the call site.
function collect_namespace_suffix_matches(cg: CodegenContext*, intern: InternTable*,
                                          scope_str: string, member: SymbolStr,
                                          arity: u32) -> SymbolStr[] {
    mut result: SymbolStr[] = [];
    const scope_len: i64 = intrinsics::strlen(scope_str) as i64;
    if (scope_len == 0) { return result; }

    const mg: ModuleGraph* = cg.ctx.module_graph;
    const member_str: string = intern.resolve(member);
    for (mut i: i64 = 0; i < mg.modules.length; i++) {
        const ns_sym: SymbolStr = mg.modules[i].namespace_name;
        if (!ns_sym.is_valid()) { continue; }
        const ns_str: string = intern.resolve(ns_sym);
        const ns_len: i64 = intrinsics::strlen(ns_str) as i64;

        // Match condition: namespace equals scope_str OR ends with "::scope_str".
        mut is_match: boolean = false;
        if (ns_len == scope_len) {
            is_match = intrinsics::strcmp(ns_str, scope_str) == 0;
        } else if (ns_len > scope_len + 1) {
            const suffix_start: i64 = ns_len - scope_len;
            if (ns_str[suffix_start - 1] == ':' && ns_str[suffix_start - 2] == ':') {
                is_match = intrinsics::strcmp(ns_str + suffix_start, scope_str) == 0;
            }
        }
        if (!is_match) { continue; }

        // Build "<ns>::<member>" and probe the function table.
        const qualified: string = format("%s::%s", ns_str, member_str);
        const q_sym: SymbolStr = intern.intern(qualified);
        const probe: LValue = resolve_function_with_arity(cg, q_sym, arity);
        if (!probe.is_valid()) { continue; }

        // Dedup: same qualified name shouldn't appear twice (e.g. when
        // the module graph lists the same module under two indices).
        mut dup: boolean = false;
        for (mut k: i64 = 0; k < result.length; k++) {
            if (result[k].id == q_sym.id) { dup = true; break; }
        }
        if (!dup) { result.push(q_sym); }
    }
    return result;
}
