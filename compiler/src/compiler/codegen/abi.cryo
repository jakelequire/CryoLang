/// ABI Lowering
///
/// Turns a Cryo function signature into an *ABI-lowered* LLVM signature
/// plus a per-parameter / per-return lowering plan that codegen consults
/// at every declaration site, call site, prologue, and `return`.
///
/// The classifier is the single source of truth for "how does this
/// parameter / return value cross the function-call boundary".  Codegen
/// must never inspect Cryo types directly to decide that - it asks the
/// `AbiClassifier` (owned by `CodegenContext::abi`, borrowed by
/// sub-components through their own back-pointer).
///
/// `ParamPlan`, `SignaturePlan`, `ArgClass`, and `AbiAttr` are plain data
/// types kept at module scope so call sites can name them in `const` and
/// loop variables.  The state (cached LLVM attribute-kind IDs, the
/// back-pointer to `TypeMapper`) and every routine that needs state live
/// on `AbiClassifier`.
///
/// Phased rollout (see commit history):
///   * **Phase 0**: classify every value as `Direct`, producing the same
///     LLVM signature codegen built before the seam existed.  Proved the
///     seam was wired via `selfhost-check`.
///   * **Phase 1**: sret promotion for `>16` byte aggregate returns.
///   * **Phase 2**: byval promotion for `>16` byte aggregate parameters.
///   * **Phase 3 (partial)**: extern-C small aggregate returns (<=8 bytes)
///     coerced to a register-sized integer.
///   * **Object refactor**: free functions + file-scope mutables collapsed
///     into the stateful `AbiClassifier`.  Behaviour-preserving; the seam
///     for future targets (AArch64, Win64) and a SignaturePlan cache.
///
/// Target scope: SysV x86-64 only.  Other targets plug in later behind
/// the same `AbiClassifier` surface - an instance per target, swapped
/// at construction.

namespace Compiler::Codegen::Abi;

import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Codegen::TypeMap;
import Compiler::Types;
import Compiler::Types::TypeRef;
import Compiler::Types::Type;
import Compiler::Types::Arena;
import Compiler::Types::Compound;
import Compiler::Types::UserDefined;
import Compiler::Types::Generic;


// ArgClass / AbiAttr / ParamPlan / SignaturePlan

/// How a single Cryo parameter or return value is transmitted at the
/// LLVM-IR boundary.
type enum ArgClass {
    /// Pass / return the value as-is in one register-sized LLVM slot.
    /// `llvm_slots.length == 1`.
    Direct;
    /// Split into exactly two register-sized eightbytes (SysV x86-64
    /// rule 3).  `llvm_slots.length == 2`.
    DirectPair;
    /// Passed via a hidden pointer.  For a parameter this lowers to a
    /// single `ptr byval(%T)`; for a return value to a hidden first
    /// `ptr sret(%T)` parameter and an LLVM-level `void` return.
    /// `llvm_slots.length == 1` (the pointer).
    Indirect;
    /// Zero-sized value - produces no LLVM slot at all.
    /// `llvm_slots.length == 0`.
    Ignore;
}

/// Optional attribute that codegen must attach to the LLVM parameter
/// slot (and the matching call-site argument).  Carried separately from
/// `ArgClass` so the call site can inspect both axes cheaply.
type enum AbiAttr {
    None;
    ByVal;     // attached to a parameter slot whose class is `Indirect`
    SRet;      // attached to the hidden return-pointer parameter
}

type struct ParamPlan {
    /// The Cryo source-language type this plan was derived from.  Kept
    /// around so call sites can re-lower / inspect the value's
    /// home-language form (e.g. for `coerce_return_value`'s widening).
    cryo_type:  TypeRef;
    /// How the value crosses the boundary.
    cls:      ArgClass;
    /// The LLVM types this parameter expands to (0, 1, or 2 slots).
    llvm_slots: LType[];
    /// Optional attribute to attach to the LLVM parameter slot.
    attr:       AbiAttr;
    /// For `Indirect` parameters / returns: the underlying pointee LLVM
    /// type so codegen can emit `byval(%T)` / `sret(%T)` correctly.
    /// `LType::null()` when not applicable.
    pointee_ty: LType;

    /// Deep copy.  `llvm_slots` (the only owning field; LType is Copy) is
    /// rebuilt into an independent buffer so a clone can be stored in a
    /// second owner without double-freeing this plan's slots.
    clone(&this) -> ParamPlan {
        mut slots_c: LType[] = [];
        for (mut i: i64 = 0; i < this.llvm_slots.length; i++) {
            slots_c.push(this.llvm_slots[i]);
        }
        return ParamPlan {
            cryo_type:  this.cryo_type,
            cls:        this.cls,
            llvm_slots: slots_c,
            attr:       this.attr,
            pointee_ty: this.pointee_ty,
        };
    }
}

type struct SignaturePlan {
    /// Classification of the return value.  `Indirect` means the LLVM
    /// function takes a hidden first parameter (`ptr sret(%T)`) and
    /// returns void.
    return_plan:  ParamPlan;
    /// One plan per source-language parameter (excluding the variadic
    /// trailing `args...` bucket which lowers to LLVM's `...` marker
    /// outside this seam).
    param_plans:  ParamPlan[];
    /// The fully-lowered LLVM function type.  Built by `build_llvm_fn_type`
    /// from the slot list each plan contributes.
    llvm_fn_type: LType;
    /// True iff `return_plan.cls == Indirect`, in which case LLVM
    /// param 0 is the result pointer.  Cached here so prologue / call /
    /// return sites don't have to re-derive it.
    sret_slot:    boolean;
    /// Mirrors LLVMFunctionType's `is_variadic` flag for callers that
    /// already have the `SignaturePlan` and don't want to thread the
    /// original FunctionDeclNode through.
    is_variadic:  boolean;
}


// AbiClassifier
//
/// A flattened scalar leaf of an aggregate, produced by
/// `AbiClassifier::collect_abi_leaves` and consumed by
/// `eightbyte_slot_type`.  `offset` is the leaf's absolute byte offset
/// inside the top-level aggregate; `is_float`/`is_f32` carry its SysV
/// class so a bucket whose every leaf is a float is classified SSE even
/// when those floats live inside nested structs / arrays.
type struct AbiLeaf {
    offset:   u64;
    is_float: boolean;
    is_f32:   boolean;
}

// Per-codegen-context object that owns the ABI seam.  Constructed once
// in `CodegenContext::new` (via `AbiClassifier::null()`) and wired in
// `CodegenContext::wire()` with a back-pointer to the per-context
// `TypeMapper`.  Sub-components (DeclarationEmitter, ExprOps,
// SymbolResolver, and the call-emitter visitor) hold their own
// `AbiClassifier*` back-pointer and route every `classify_*` /
// `apply_*` / `*_pointee_of` call through it.
//
// The `*_attr_kind` fields cache `LLVMGetEnumAttributeKindForName`
// lookups, which are stable for the process but cost one LLVM call
// otherwise.  They live on the object (not in file-scope mutables) so
// that future per-target classifiers each have their own cache - and so
// the seam carries no module-scope mutable state.

type struct AbiClassifier {
    /// Back-pointer to the owning context's `TypeMapper`.  Threaded
    /// into every classify_* method so call sites no longer pass it
    /// explicitly.  Null between `null()` construction and `wire()`.
    type_mapper: TypeMapper*;
    /// Cached `LLVMGetEnumAttributeKindForName("sret", 4)`.  0 => unset
    /// (the LLVM API never returns 0 for a real attribute kind).
    sret_kind:   u32;
    /// Cached `LLVMGetEnumAttributeKindForName("byval", 5)`.
    byval_kind:  u32;

    /// Stage 1 of two-phase init.  Produces an AbiClassifier with a
    /// null back-pointer; the parent calls `wire()` once it is at its
    /// stable (heap) address.
    static null() -> AbiClassifier {
        return AbiClassifier {
            type_mapper: null,
            sret_kind:   0,
            byval_kind:  0,
        };
    }

    /// Stage 2 of two-phase init.  Stores the TypeMapper back-pointer.
    /// Must be called from `CodegenContext::wire()` after the context
    /// is at its stable address.
    wire(mut &this, type_mapper: TypeMapper*) -> void {
        this.type_mapper = type_mapper;
    }


    // Signature-level entry points

    /// Classify a free-function / extern signature.  `params` is the
    /// source-language parameter list (excluding the variadic trailing
    /// bucket); `return_type` may be invalid for `void`/`unit` returns.
    classify_signature(mut &this,
                       params: &TypeRef[],
                       return_type: TypeRef,
                       is_variadic: boolean) -> SignaturePlan {
        const return_plan: ParamPlan = this.classify_return(return_type);

        mut param_plans: ParamPlan[] = [];
        for (mut i: i64 = 0; i < params.length; i++) {
            param_plans.push(this.classify_param((*params)[i]));
        }

        const sret: boolean = return_plan.cls == ArgClass::Indirect;
        const llvm_fn_ty: LType = build_llvm_fn_type(
            return_plan, param_plans, is_variadic);

        return SignaturePlan {
            return_plan:  return_plan,
            param_plans:  param_plans,
            llvm_fn_type: llvm_fn_ty,
            sret_slot:    sret,
            is_variadic:  is_variadic,
        };
    }

    /// `extern "C"` signature classification.  Now identical to the
    /// Cryo-internal `classify_signature` - both callees lower small
    /// aggregates the same way (byval for >16 bytes, register coercion
    /// for <=8, DirectPair for 9-16).  Retained as an alias for the
    /// extern-declare call site.
    classify_signature_extern_c(mut &this,
                                params: TypeRef[],
                                return_type: TypeRef,
                                is_variadic: boolean) -> SignaturePlan {
        return this.classify_signature(params, return_type, is_variadic);
    }

    /// Classify a method signature.  The implicit receiver (a `&this` /
    /// `mut &this` pointer, or a by-value `this` struct copy in the
    /// rare case where the user wrote `this` by value) is always
    /// treated as `Direct`: it is either already a pointer or a value
    /// the caller has passed in a register the same way the underlying
    /// scalar would be.  Future phases may revisit by-value `this` once
    /// eightbyte classification lands; for now structures-by-value go
    /// through the same Direct path as today.
    ///
    /// `this_llvm_ty` is the LLVM type of the receiver slot - typically
    /// `T*` for the common `&this`/implicit form.  Passing it in directly
    /// keeps this function decoupled from the receiver-resolution logic
    /// in `declare_method`.
    classify_method_signature(mut &this,
                              this_llvm_ty: LType,
                              has_explicit_self: boolean,
                              params: TypeRef[],
                              return_type: TypeRef,
                              is_variadic: boolean) -> SignaturePlan {
        // For methods we don't yet feed the receiver through the
        // classifier; pre-pend a `Direct` plan for it so call sites see
        // a uniform `param_plans` shape.  Once eightbyte classification
        // arrives this is the seam where by-value `this` will be split
        // correctly.
        const return_plan: ParamPlan = this.classify_return(return_type);

        mut param_plans: ParamPlan[] = [];
        if (this_llvm_ty.is_valid()) {
            mut slots: LType[] = [];
            slots.push(this_llvm_ty);
            param_plans.push(ParamPlan {
                cryo_type:  TypeRef::invalid(),
                cls:      ArgClass::Direct,
                llvm_slots: slots,
                attr:       AbiAttr::None,
                pointee_ty: LType::null(),
            });
        }
        for (mut i: i64 = 0; i < params.length; i++) {
            param_plans.push(this.classify_param(params[i]));
        }

        const sret: boolean = return_plan.cls == ArgClass::Indirect;
        const llvm_fn_ty: LType = build_llvm_fn_type(
            return_plan, param_plans, is_variadic);

        return SignaturePlan {
            return_plan:  return_plan,
            param_plans:  param_plans,
            llvm_fn_type: llvm_fn_ty,
            sret_slot:    sret,
            is_variadic:  is_variadic,
        };
    }


    // Per-type classification

    /// Classify a parameter for the SysV x86-64 ABI:
    ///   - > 16 byte aggregate -> `Indirect` + `ByVal` (a single `ptr`
    ///     slot, with the struct type in `pointee_ty`).
    ///   - <= 8 byte aggregate -> one register-shaped eightbyte slot
    ///     (`Direct`, `pointee_ty` set as the coercion sentinel).
    ///   - 9-16 byte aggregate -> two eightbyte slots (`DirectPair`).
    /// Each eightbyte's slot type is chosen by `eightbyte_slot_type`
    /// (SSE / INTEGER / `<2 x float>`).
    ///
    /// This is the same surface for Cryo-internal and `extern "C"`
    /// callees; `classify_param_extern_c` is retained only as an alias.
    /// The call-argument marshaller (`codegen_call_direct` /
    /// `codegen_call_direct_dp_expand`) and the prologue
    /// (`codegen_function_prologue` / `codegen_method_prologue`) consume
    /// these plans symmetrically - see `agg_register_size` for how the
    /// call site recovers the coerced aggregate's size from the *lowered*
    /// LLVM type (which stays correct even when an argument carries an
    /// unresolved `InstantiatedType` whose Cryo `size_bytes()` is 0).
    ///
    /// Tuple, Optional, and ADT enum (Result) follow the same SysV rules
    /// as Struct / Class.
    classify_param(mut &this, t: TypeRef) -> ParamPlan {
        const tm: TypeMapper* = this.type_mapper;
        if (!t.is_valid()) {
            return ParamPlan {
                cryo_type:  t,
                cls:      ArgClass::Direct,
                llvm_slots: [],
                attr:       AbiAttr::None,
                pointee_ty: LType::null(),
            };
        }

        const arena: TypeArena* = tm.arena;
        const ty: Type* = arena.lookup(t.id);
        if (ty == null) {
            mut slots_fb: LType[] = [];
            const lty_fb: LType = tm.map_type(t);
            if (lty_fb.is_valid()) { slots_fb.push(lty_fb); }
            return ParamPlan {
                cryo_type:  t,
                cls:      ArgClass::Direct,
                llvm_slots: slots_fb,
                attr:       AbiAttr::None,
                pointee_ty: LType::null(),
            };
        }

        // Follow type aliases / instantiated types to the concrete
        // kind so a `type alias Foo = LargeStruct` follows the same
        // rule as a direct `LargeStruct` parameter.
        mut concrete: Type* = ty;
        if (concrete.kind == TypeKind::TypeAlias) {
            const alias: TypeAliasType* = concrete as TypeAliasType*;
            if (alias.has_target()) {
                const tgt: Type* = arena.lookup(alias.target.id);
                if (tgt != null) { concrete = tgt; }
            }
        }
        if (concrete.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = concrete as InstantiatedType*;
            if (inst.has_resolved_type()) {
                const res: Type* = arena.lookup(inst.resolved_type.id);
                if (res != null) { concrete = res; }
            }
        }

        const is_aggregate: boolean = match (concrete.kind) {
            TypeKind::Struct   => { true }
            TypeKind::Class    => { true }
            TypeKind::Enum     => { true }
            TypeKind::Tuple    => { true }
            TypeKind::Optional => { true }
            _ => { false }
        };

        if (is_aggregate) {
            const sz: u64 = concrete.size_bytes();
            if (sz > 16) {
                // Phase 2: large aggregate -> byval.
                const pointee: LType = tm.map_type(t);
                mut slots_iv: LType[] = [];
                slots_iv.push(LType::pointer_to(LType::i8()));
                return ParamPlan {
                    cryo_type:  t,
                    cls:      ArgClass::Indirect,
                    llvm_slots: slots_iv,
                    attr:       AbiAttr::ByVal,
                    pointee_ty: pointee,
                };
            }
            if (sz > 0 && sz <= 8) {
                // <= 8-byte aggregate -> single eightbyte slot.  The
                // eightbyte is classified SSE (`double`/`float` when the
                // bucket is one float-class field that fully occupies it)
                // or INTEGER otherwise.  The call site spills the struct
                // value to a temp and reloads it as the scalar; the
                // prologue does the inverse on the callee side.
                const orig: LType = tm.map_type(t);
                const slot: LType = this.eightbyte_slot_type(concrete, 0, sz);
                if (slot.is_valid()) {
                    mut slots_d: LType[] = [];
                    slots_d.push(slot);
                    return ParamPlan {
                        cryo_type:  t,
                        cls:      ArgClass::Direct,
                        llvm_slots: slots_d,
                        attr:       AbiAttr::None,
                        pointee_ty: orig,   // coercion target
                    };
                }
            }
            if (sz > 8 && sz <= 16) {
                // 9-16 byte aggregate -> DirectPair (two eightbyte slots,
                // each classified independently).  The call site expands
                // the single source-struct arg into two LLVM arg slots;
                // the prologue reassembles them into a source-typed alloca.
                const orig: LType = tm.map_type(t);
                const lo_slot: LType = this.eightbyte_slot_type(concrete, 0, 8);
                const hi_slot: LType = this.eightbyte_slot_type(concrete, 8, sz);
                if (lo_slot.is_valid() && hi_slot.is_valid()) {
                    mut slots_dp: LType[] = [];
                    slots_dp.push(lo_slot);
                    slots_dp.push(hi_slot);
                    return ParamPlan {
                        cryo_type:  t,
                        cls:      ArgClass::DirectPair,
                        llvm_slots: slots_dp,
                        attr:       AbiAttr::None,
                        pointee_ty: orig,   // coercion target
                    };
                }
            }
        }

        // Non-aggregate, or an aggregate whose eightbyte classification
        // bailed: plain `Direct` of the mapped LLVM type.
        mut slots: LType[] = [];
        const lty: LType = tm.map_type(t);
        if (lty.is_valid()) { slots.push(lty); }
        return ParamPlan {
            cryo_type:  t,
            cls:      ArgClass::Direct,
            llvm_slots: slots,
            attr:       AbiAttr::None,
            pointee_ty: LType::null(),
        };
    }

    /// `extern "C"` parameter classification.  Identical to the
    /// Cryo-internal `classify_param` (same byval / register-coercion /
    /// DirectPair surface), so this is now a thin alias kept only for
    /// naming symmetry with `classify_signature_extern_c`.
    classify_param_extern_c(mut &this, t: TypeRef) -> ParamPlan {
        return this.classify_param(t);
    }

    /// Classify a single eightbyte bucket of an aggregate type into its
    /// SysV class slot.  Returns the LLVM type that should occupy this
    /// eightbyte register slot.
    ///
    /// The bucket is the half-open byte interval `[bucket_start,
    /// bucket_end)` of the aggregate (typically `[0..8)` or
    /// `[8..16)`).  Recursively flattens the aggregate's scalar leaf
    /// fields (descending into nested structs / fixed arrays) whose
    /// offsets fall in the interval and applies SysV's rules:
    ///   - All fields are floats AND the bucket has exactly one field
    ///     that fully fills the bucket-relevant bytes => SSE class.
    ///     Slot type is `double` (for f64) or `float` (for f32).
    ///   - Mixed / integer / multiple-float bucket => INTEGER class.
    ///     Slot type is the smallest power-of-two integer that holds
    ///     `bucket_size` bytes (`eightbyte_integer_type`).
    ///
    /// Multi-float SSE: when the bucket has more than one float-class
    /// field and every such field is F32, promote to `<2 x float>` so
    /// the SSE-vector calling convention matches what clang emits for
    /// `struct { float a, b; }`.  Any other mixed bucket (e.g. a single
    /// F32 in a half-occupied 8-byte bucket, or F32+F64) falls back to
    /// INTEGER.
    eightbyte_slot_type(mut &this, ty: Type*, bucket_start: u64, bucket_end: u64) -> LType {
        const bucket_size: u64 = bucket_end - bucket_start;

        // Recursively flatten the aggregate into its scalar leaf fields so
        // a float nested inside a member struct / fixed array still
        // contributes SSE class to its eightbyte.  SysV classifies
        // eightbytes recursively; a direct-fields-only walk wrongly
        // demoted `struct { struct { f64 } inner; f64 y; }` (and similar)
        // to INTEGER class, so the value crossed the C ABI in GP registers
        // while clang/gcc used XMM - silently corrupting extern-C interop.
        const leaves: AbiLeaf[] = this.collect_abi_leaves(ty, 0, 0);

        mut count: i64 = 0;
        mut all_floats: boolean = true;
        mut all_f32: boolean = true;
        mut single_is_f32: boolean = false;

        for (mut i: i64 = 0; i < leaves.length; i++) {
            const off: u64 = leaves[i].offset;
            // A leaf belongs to this bucket iff its offset falls inside
            // `[bucket_start, bucket_end)`.  (Leaves that straddle the
            // boundary don't arise for natural layouts; scalar leaves are
            // <= 8 bytes and naturally aligned.)
            if (off >= bucket_start && off < bucket_end) {
                count += 1;
                if (!leaves[i].is_float) {
                    all_floats = false;
                    all_f32 = false;
                } else {
                    single_is_f32 = leaves[i].is_f32;
                    if (!leaves[i].is_f32) { all_f32 = false; }
                }
            }
        }

        // Single float-class leaf fully owning the bucket => SSE.
        if (count == 1 && all_floats) {
            if (single_is_f32) { return LType::f32(); }
            return LType::f64();
        }

        // Two F32 leaves packing one full eightbyte => `<2 x float>`, the
        // SSE-vector shape clang emits for `struct { float a, b; }`.
        if (count == 2 && all_f32 && bucket_size == 8) {
            return LType::vector_of(LType::f32(), 2);
        }

        // Mixed / integer / empty bucket => INTEGER class.
        return eightbyte_integer_type(bucket_size);
    }

    /// Recursively flatten an aggregate into its scalar leaf fields,
    /// recording each leaf's absolute byte offset (relative to the
    /// top-level aggregate) and whether it is a float (SSE class).
    /// Nested structs, classes, and fixed-size arrays are expanded so a
    /// float buried inside a nested aggregate still contributes SSE class
    /// to its eightbyte - matching how clang/gcc classify SysV
    /// eightbytes.  Everything else (ints, pointers, enums, tuples,
    /// optionals, dynamic-array fat pointers) becomes a single
    /// INTEGER-class leaf.  `depth` guards against pathological /
    /// recursive value types (which the front end can currently accept).
    collect_abi_leaves(mut &this, ty: Type*, base: u64, depth: i32) -> AbiLeaf[] {
        mut out: AbiLeaf[] = [];
        if (ty == null || depth > 16) { return out; }
        const arena: TypeArena* = this.type_mapper.arena;

        // Resolve aliases / instantiated wrappers to the concrete kind so
        // a nested `type alias` or generic field is classified by what it
        // actually is.
        mut c: Type* = ty;
        mut guard: i32 = 0;
        while (c != null && guard < 8) {
            if (c.kind == TypeKind::TypeAlias) {
                const al: TypeAliasType* = c as TypeAliasType*;
                if (al.has_target()) {
                    const tg: Type* = arena.lookup(al.target.id);
                    if (tg != null) { c = tg; guard += 1; continue; }
                }
                break;
            }
            if (c.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = c as InstantiatedType*;
                if (inst.has_resolved_type()) {
                    const rs: Type* = arena.lookup(inst.resolved_type.id);
                    if (rs != null) { c = rs; guard += 1; continue; }
                }
                break;
            }
            break;
        }
        if (c == null) { return out; }

        match (c.kind) {
            TypeKind::Float => {
                const flt: FloatType* = c as FloatType*;
                out.push(AbiLeaf {
                    offset:   base,
                    is_float: true,
                    is_f32:   flt.float_kind == FloatKind::F32,
                });
            }
            TypeKind::Struct => {
                const st: StructType* = c as StructType*;
                for (mut i: i64 = 0; i < st.fields.length; i++) {
                    const ft: Type* = arena.lookup(st.fields[i].field_type.id);
                    const sub: AbiLeaf[] = this.collect_abi_leaves(
                        ft, base + st.fields[i].offset, depth + 1);
                    for (mut j: i64 = 0; j < sub.length; j++) { out.push(sub[j]); }
                }
            }
            TypeKind::Class => {
                const ct: ClassType* = c as ClassType*;
                for (mut i: i64 = 0; i < ct.fields.length; i++) {
                    const ft: Type* = arena.lookup(ct.fields[i].field_type.id);
                    const sub: AbiLeaf[] = this.collect_abi_leaves(
                        ft, base + ct.fields[i].offset, depth + 1);
                    for (mut j: i64 = 0; j < sub.length; j++) { out.push(sub[j]); }
                }
            }
            TypeKind::Array => {
                const at: ArrayType* = c as ArrayType*;
                const elem: Type* = arena.lookup(at.element.id);
                mut stride: u64 = 0;
                if (elem != null) { stride = elem.size_bytes(); }
                if (at.is_fixed() && elem != null && stride > 0) {
                    for (mut k: i64 = 0; k < at.size; k++) {
                        const sub: AbiLeaf[] = this.collect_abi_leaves(
                            elem, base + (k as u64) * stride, depth + 1);
                        for (mut j: i64 = 0; j < sub.length; j++) { out.push(sub[j]); }
                    }
                } else {
                    // Dynamic array (fat pointer) or unsized element => INTEGER.
                    out.push(AbiLeaf { offset: base, is_float: false, is_f32: false });
                }
            }
            _ => {
                // Int, Bool, Char, Pointer, Enum, Tuple, Optional, etc.:
                // a single INTEGER-class leaf at this offset.
                out.push(AbiLeaf { offset: base, is_float: false, is_f32: false });
            }
        }
        return out;
    }

    /// Phase 3 - Direct-with-coercion: small (<= 8 byte) aggregate
    /// returns are passed in a single integer register (SysV INTEGER
    /// eightbyte).  Used by `classify_return_extern_c` to lower extern
    /// declarations so `extern "C" function div(i32, i32) -> DivT`
    /// becomes `i64 @div(i32, i32)` - matching what clang emits and
    /// what real libc expects.
    ///
    /// Returns a Direct plan whose `llvm_slots[0]` is an integer type
    /// and whose `pointee_ty` records the original struct LLVM type so
    /// the call site knows what to coerce back to.  The unusual use of
    /// `pointee_ty` for a non-Indirect plan is the "coercion target"
    /// signal - call/return marshallers check it.
    classify_small_aggregate_int(mut &this,
                                 t: TypeRef, size_bytes: u64) -> ParamPlan {
        const tm: TypeMapper* = this.type_mapper;
        const orig: LType = tm.map_type(t);
        const int_slot: LType = eightbyte_integer_type(size_bytes);
        mut slots: LType[] = [];
        slots.push(int_slot);
        return ParamPlan {
            cryo_type:  t,
            cls:      ArgClass::Direct,
            llvm_slots: slots,
            attr:       AbiAttr::None,
            pointee_ty: orig,   // sentinel: non-null on a Direct plan => coerce
        };
    }

    /// `extern "C"` return classification.  Identical to the
    /// Cryo-internal `classify_return` (same sret / register-coercion /
    /// DirectPair surface), so this is now a thin alias kept only for
    /// naming symmetry with `classify_signature_extern_c`.
    classify_return_extern_c(mut &this, t: TypeRef) -> ParamPlan {
        return this.classify_return(t);
    }

    /// Classify a return value: sret for > 16 byte aggregates, <= 8 byte
    /// Direct-with-coercion, and 9-16 byte DirectPair.  Used for both
    /// Cryo-internal and extern-C returns now that `codegen_return`
    /// knows how to coerce a struct value into the declared
    /// register-shaped return type.
    ///
    /// Tuples, Optional<T>, and Result<T,E> (an ADT enum) all classify
    /// as aggregates and follow the SysV rules.  Tuple lives at
    /// `TypeKind::Tuple`, Optional at `TypeKind::Optional`, Result at
    /// `TypeKind::Enum`.  All flow through the same size-based promotion
    /// paths below.
    classify_return(mut &this, t: TypeRef) -> ParamPlan {
        const tm: TypeMapper* = this.type_mapper;
        if (!t.is_valid()) {
            mut slots: LType[] = [];
            slots.push(LType::void_type());
            return ParamPlan {
                cryo_type:  t,
                cls:      ArgClass::Ignore,
                llvm_slots: slots,
                attr:       AbiAttr::None,
                pointee_ty: LType::null(),
            };
        }
        const arena: TypeArena* = tm.arena;
        const ty: Type* = arena.lookup(t.id);
        if (ty == null || ty.kind == TypeKind::Void || ty.kind == TypeKind::Unit) {
            mut slots: LType[] = [];
            slots.push(LType::void_type());
            return ParamPlan {
                cryo_type:  t,
                cls:      ArgClass::Ignore,
                llvm_slots: slots,
                attr:       AbiAttr::None,
                pointee_ty: LType::null(),
            };
        }

        // Unwrap aliases / instantiations to the concrete kind so a
        // `type alias Foo = LargeStruct` follows the same rule as
        // returning `LargeStruct` directly.
        mut concrete: Type* = ty;
        if (concrete.kind == TypeKind::TypeAlias) {
            const alias: TypeAliasType* = concrete as TypeAliasType*;
            if (alias.has_target()) {
                const tgt: Type* = arena.lookup(alias.target.id);
                if (tgt != null) { concrete = tgt; }
            }
        }
        if (concrete.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = concrete as InstantiatedType*;
            if (inst.has_resolved_type()) {
                const res: Type* = arena.lookup(inst.resolved_type.id);
                if (res != null) { concrete = res; }
            }
        }

        const is_aggregate: boolean = match (concrete.kind) {
            TypeKind::Struct   => { true }
            TypeKind::Class    => { true }
            TypeKind::Enum     => {
                // Simple enums lower to i32 (size 4); ADT enums lower
                // to a struct that may well exceed 16 bytes.  The
                // size_bytes() gate below filters either way, so
                // accept both here.  Result<T,E> lives here.
                true
            }
            TypeKind::Tuple    => { true }
            TypeKind::Optional => { true }
            _ => { false }
        };

        if (is_aggregate) {
            const sz: u64 = concrete.size_bytes();
            if (sz > 16) {
                // Phase 1: large aggregate -> sret.
                const pointee: LType = tm.map_type(t);
                mut slots: LType[] = [];
                slots.push(LType::pointer_to(LType::i8()));
                return ParamPlan {
                    cryo_type:  t,
                    cls:      ArgClass::Indirect,
                    llvm_slots: slots,
                    attr:       AbiAttr::SRet,
                    pointee_ty: pointee,
                };
            }
            if (sz > 0 && sz <= 8) {
                // Phase 3: <= 8 byte aggregate -> single eightbyte slot.
                const orig: LType = tm.map_type(t);
                const slot: LType = this.eightbyte_slot_type(concrete, 0, sz);
                if (slot.is_valid()) {
                    mut slots_d: LType[] = [];
                    slots_d.push(slot);
                    return ParamPlan {
                        cryo_type:  t,
                        cls:      ArgClass::Direct,
                        llvm_slots: slots_d,
                        attr:       AbiAttr::None,
                        pointee_ty: orig,   // coercion target
                    };
                }
            }
            if (sz > 8 && sz <= 16) {
                // Phase 3: 9-16 byte aggregate -> DirectPair.
                const orig: LType = tm.map_type(t);
                const lo_slot: LType = this.eightbyte_slot_type(concrete, 0, 8);
                const hi_slot: LType = this.eightbyte_slot_type(concrete, 8, sz);
                if (lo_slot.is_valid() && hi_slot.is_valid()) {
                    mut slots_dp: LType[] = [];
                    slots_dp.push(lo_slot);
                    slots_dp.push(hi_slot);
                    return ParamPlan {
                        cryo_type:  t,
                        cls:      ArgClass::DirectPair,
                        llvm_slots: slots_dp,
                        attr:       AbiAttr::None,
                        pointee_ty: orig,   // coercion target
                    };
                }
            }
        }

        const lty: LType = tm.map_type(t);
        mut slots: LType[] = [];
        slots.push(lty);
        return ParamPlan {
            cryo_type:  t,
            cls:      ArgClass::Direct,
            llvm_slots: slots,
            attr:       AbiAttr::None,
            pointee_ty: LType::null(),
        };
    }


    // Attribute application
    //
    // `LLVMGetEnumAttributeKindForName` returns a stable-for-the-process
    // integer for each named attribute; we cache the IDs for "sret" and
    // "byval" so the lookup runs once per classifier.  These are *type*
    // attributes (they carry the pointee type), which matches modern
    // LLVM semantics where `sret(%T)` / `byval(%T)` are required since
    // opaque pointers landed.

    sret_attr_kind(mut &this) -> u32 {
        if (this.sret_kind == 0) {
            this.sret_kind = llvm::LLVMGetEnumAttributeKindForName("sret", 4);
        }
        return this.sret_kind;
    }

    byval_attr_kind(mut &this) -> u32 {
        if (this.byval_kind == 0) {
            this.byval_kind = llvm::LLVMGetEnumAttributeKindForName("byval", 5);
        }
        return this.byval_kind;
    }

    /// Apply an `sret(%T)` type attribute to LLVM parameter slot 0 of a
    /// function declaration.  LLVM's attribute-index convention is
    /// 1-based, so "param 0" is index 1.
    apply_sret_attribute(mut &this, fn_val: LValue, pointee_ty: LType) -> void {
        if (!fn_val.is_valid() || !pointee_ty.is_valid()) { return; }
        const ctx: LContext = LContext::global();
        const kind: u32 = this.sret_attr_kind();
        const attr: void* = llvm::LLVMCreateTypeAttribute(ctx.raw, kind, pointee_ty.raw);
        llvm::LLVMAddAttributeAtIndex(fn_val.raw, 1, attr);
    }

    /// Apply an `sret(%T)` type attribute to a call instruction's
    /// hidden first argument.  Mirrors `apply_sret_attribute` but for
    /// the call site (the function-side attribute is independent of the
    /// call-site attribute in LLVM; both must be set for the optimiser
    /// and verifier to treat the hidden slot correctly).
    apply_sret_call_attribute(mut &this, call_val: LValue, pointee_ty: LType) -> void {
        if (!call_val.is_valid() || !pointee_ty.is_valid()) { return; }
        const ctx: LContext = LContext::global();
        const kind: u32 = this.sret_attr_kind();
        const attr: void* = llvm::LLVMCreateTypeAttribute(ctx.raw, kind, pointee_ty.raw);
        llvm::LLVMAddCallSiteAttribute(call_val.raw, 1, attr);
    }

    /// Apply a `byval(%T)` attribute to LLVM parameter slot `llvm_idx`
    /// (0-based among LLVM params) of a function declaration.  The
    /// attribute carries the pointee type, which both pins the copy
    /// size and tells the backend the alignment requirement.
    apply_byval_attribute(mut &this, fn_val: LValue, llvm_idx: u32, pointee_ty: LType) -> void {
        if (!fn_val.is_valid() || !pointee_ty.is_valid()) { return; }
        const ctx: LContext = LContext::global();
        const kind: u32 = this.byval_attr_kind();
        const attr: void* = llvm::LLVMCreateTypeAttribute(ctx.raw, kind, pointee_ty.raw);
        // Attribute index is 1-based, so LLVM param 0 -> attribute index 1.
        llvm::LLVMAddAttributeAtIndex(fn_val.raw, llvm_idx + 1, attr);
    }

    /// Apply a `byval(%T)` attribute to a call instruction's parameter
    /// at LLVM index `llvm_idx`.  The call-site attribute is independent
    /// of the function-side attribute in LLVM; both must be set for the
    /// optimiser and verifier to treat the slot correctly.
    apply_byval_call_attribute(mut &this, call_val: LValue, llvm_idx: u32, pointee_ty: LType) -> void {
        if (!call_val.is_valid() || !pointee_ty.is_valid()) { return; }
        const ctx: LContext = LContext::global();
        const kind: u32 = this.byval_attr_kind();
        const attr: void* = llvm::LLVMCreateTypeAttribute(ctx.raw, kind, pointee_ty.raw);
        llvm::LLVMAddCallSiteAttribute(call_val.raw, llvm_idx + 1, attr);
    }

    /// Detect whether an LLVM function declaration was built with an
    /// `sret(%T)` attribute on its hidden first parameter.  Returns
    /// `LType::null()` when the function is not sret; otherwise returns
    /// the pointee type (`%T`) so call sites can allocate a matching
    /// result slot.
    ///
    /// Used by `codegen_call` to decide whether to marshal a hidden
    /// first argument - this avoids needing a SignaturePlan cache
    /// because the attribute IS the persistent record of the
    /// classification.
    sret_pointee_of(mut &this, fn_val: LValue) -> LType {
        if (!fn_val.is_valid()) { return LType::null(); }
        // The attribute APIs only accept function-typed LLVMValueRefs.
        // At call sites the "callee" can be a function pointer loaded
        // from a struct field (e.g. a virtual method through a vtable,
        // or a function value bound to a local) - passing such a value
        // to `LLVMGetEnumAttributeAtIndex` is undefined behaviour and
        // crashes LLVM in practice.  `LLVMIsAFunction` does the isa
        // cast for us and returns null for non-functions, gating the
        // query safely.
        const as_fn: void* = llvm::LLVMIsAFunction(fn_val.raw);
        if (as_fn == null) { return LType::null(); }
        const kind: u32 = this.sret_attr_kind();
        const attr_raw: void* = llvm::LLVMGetEnumAttributeAtIndex(fn_val.raw, 1, kind);
        if (attr_raw == null) { return LType::null(); }
        const pointee_raw: void* = llvm::LLVMGetTypeAttributeValue(attr_raw);
        if (pointee_raw == null) { return LType::null(); }
        return LType { raw: pointee_raw };
    }

    /// Returns the byval pointee type for parameter slot `llvm_idx`
    /// (0-based among LLVM params), or `LType::null()` when the slot is
    /// not byval.  Gated by `LLVMIsAFunction` like `sret_pointee_of` so
    /// it is safe to call on function pointers.
    byval_pointee_of_param(mut &this, fn_val: LValue, llvm_idx: u32) -> LType {
        if (!fn_val.is_valid()) { return LType::null(); }
        const as_fn: void* = llvm::LLVMIsAFunction(fn_val.raw);
        if (as_fn == null) { return LType::null(); }
        const kind: u32 = this.byval_attr_kind();
        const attr_raw: void* = llvm::LLVMGetEnumAttributeAtIndex(fn_val.raw, llvm_idx + 1, kind);
        if (attr_raw == null) { return LType::null(); }
        const pointee_raw: void* = llvm::LLVMGetTypeAttributeValue(attr_raw);
        if (pointee_raw == null) { return LType::null(); }
        return LType { raw: pointee_raw };
    }

    /// Apply sret + byval call-site attributes derived from a
    /// pre-computed `SignaturePlan`.  Used by call sites that cannot
    /// rely on the function-attribute query path (e.g. function-pointer
    /// invocations, where `LLVMIsAFunction(callee)` is null and
    /// `sret_pointee_of` / `byval_pointee_of_param` silently return
    /// null).
    ///
    /// For direct calls to named functions the attribute query already
    /// applies these inside `codegen_call`; calling this helper there
    /// would double-apply.  It is the explicit dual to the query path.
    apply_call_site_attrs_from_plan(mut &this, call_val: LValue, plan: SignaturePlan*) -> void {
        if (!call_val.is_valid()) { return; }
        if (plan.sret_slot && plan.return_plan.pointee_ty.is_valid()) {
            this.apply_sret_call_attribute(call_val, plan.return_plan.pointee_ty);
        }
        for (mut i: i64 = 0; i < plan.param_plans.length; i++) {
            const pp: &ParamPlan = &plan.param_plans[i];
            if (pp.cls == ArgClass::Indirect
                    && pp.attr == AbiAttr::ByVal
                    && pp.pointee_ty.is_valid()) {
                const slot_i: u32 = llvm_slot_index_of_param(
                    plan.param_plans, plan.sret_slot, i);
                this.apply_byval_call_attribute(call_val, slot_i, pp.pointee_ty);
            }
        }
    }
}


// Free-function helpers
//
// Pure helpers that need no `AbiClassifier` state; kept at module scope
// so anyone with a `SignaturePlan*` / `ParamPlan*` / size in hand can
// call them without routing through an instance.

/// Pick the LLVM integer type for an INTEGER-class eightbyte of the
/// given byte length.  Matches what clang emits for small struct
/// returns/params (e.g. `{i32, i32}` of size 8 lowers to `i64`, a
/// 5-byte struct to `i40` rounded - we use the smallest power-of-two
/// container >= size_bytes to stay register-shaped: i8 / i16 / i32 / i64).
function eightbyte_integer_type(size_bytes: u64) -> LType {
    if (size_bytes == 0) { return LType::null(); }
    if (size_bytes <= 1) { return LType::i8();  }
    if (size_bytes <= 2) { return LType::i16(); }
    if (size_bytes <= 4) { return LType::i32(); }
    return LType::i64();
}

/// Returns true iff `plan` is a Direct slot that carries a coercion
/// signal (`pointee_ty` set on a Direct plan).  Used by call/return
/// marshallers to detect "the LLVM type and the Cryo source type
/// disagree; bitcast between them."
function is_coerced_direct(plan: ParamPlan*) -> boolean {
    return plan.cls == ArgClass::Direct
        && plan.pointee_ty.is_valid();
}

/// Number of LLVM parameter slots produced by a plan.  Equivalent to
/// the loop in `build_llvm_fn_type` for the param-count axis but
/// exposed so callers (prologue, call site) can walk `LLVMGetParam`
/// indices without re-running the assembly.
function llvm_param_count(plan: SignaturePlan*) -> u32 {
    mut total: u32 = 0;
    if (plan.sret_slot) { total += 1; }
    for (mut i: i64 = 0; i < plan.param_plans.length; i++) {
        total += plan.param_plans[i].llvm_slots.length as u32;
    }
    return total;
}

/// LLVM slot index at which source parameter `param_idx` begins.
/// Accounts for the hidden `sret` slot (slot 0 when present) and for any
/// earlier parameters that expand to more than one LLVM slot - a
/// DirectPair parameter occupies two slots, so every parameter after it
/// is shifted.  Per-parameter attribute application (`byval`) MUST use
/// this rather than the source ordinal `param_idx + sret_off`: with
/// DirectPair params the ordinal no longer equals the LLVM slot index,
/// and a `byval(%T)` attached at the wrong index lands on an incompatible
/// (non-pointer) slot - an LLVM verifier failure.
function llvm_slot_index_of_param(param_plans: &ParamPlan[],
                                  sret: boolean, param_idx: i64) -> u32 {
    mut idx: u32 = if (sret) { 1 } else { 0 } as u32;
    mut i: i64 = 0;
    while (i < param_idx && i < param_plans.length) {
        idx += (*param_plans)[i].llvm_slots.length as u32;
        i += 1;
    }
    return idx;
}

/// Concatenate every plan's `llvm_slots` (return prepended when
/// `Indirect`, parameters in order) into the slot array LLVM's
/// `LLVMFunctionType` consumes.  Returns the assembled function type.
///
/// `return_plan` / `param_plans` are borrowed: this only reads the plans to
/// assemble the LLVM type, so the caller keeps ownership for the SignaturePlan.
function build_llvm_fn_type(return_plan:  &ParamPlan,
                            param_plans:  &ParamPlan[],
                            is_variadic:  boolean) -> LType {
    // Step 1: pick the LLVM return type.  `Indirect` returns become
    // `void` because the value is written through the hidden sret
    // pointer; everything else uses the single Direct slot.  `DirectPair`
    // wraps its two slots in an anonymous LLVM struct so the function
    // signature reads e.g. `{i64, i32} f(...)` - the call site coerces
    // back to the source struct via store-then-load.  Ignore returns
    // also use `void` (their slots[0] was preset to void).
    mut ret_ty: LType = LType::void_type();
    if (return_plan.cls == ArgClass::DirectPair
            && return_plan.llvm_slots.length == 2) {
        const dp_buf: void* = intrinsics::malloc(2 * 8);
        const dp_slots: void** = dp_buf as void**;
        dp_slots[0] = return_plan.llvm_slots[0].raw;
        dp_slots[1] = return_plan.llvm_slots[1].raw;
        ret_ty = LType::literal_struct(dp_buf, 2, false);
        intrinsics::free(dp_buf);
    } else if (return_plan.cls != ArgClass::Indirect
            && return_plan.llvm_slots.length > 0) {
        ret_ty = return_plan.llvm_slots[0];
    }

    // Step 2: count parameter slots.  `Indirect` return contributes a
    // hidden first ptr slot; each parameter contributes 0, 1, or 2.
    mut total: u32 = 0;
    if (return_plan.cls == ArgClass::Indirect) { total += 1; }
    for (mut i: i64 = 0; i < param_plans.length; i++) {
        total += (*param_plans)[i].llvm_slots.length as u32;
    }

    if (total == 0) {
        if (!ret_ty.is_valid()) { return LType::null(); }
        return LType::function_type(ret_ty, null, 0, is_variadic);
    }

    const buf: void* = intrinsics::malloc(total as u64 * 8);
    const slots: void** = buf as void**;
    mut idx: u32 = 0;
    mut all_valid: boolean = ret_ty.is_valid();

    // The hidden sret slot is always `ptr` (pointer to the return type).
    if (return_plan.cls == ArgClass::Indirect) {
        slots[idx] = LType::pointer_to(LType::i8()).raw;
        idx += 1;
    }

    for (mut pi: i64 = 0; pi < param_plans.length; pi++) {
        const pp: &ParamPlan = &(*param_plans)[pi];
        for (mut si: i64 = 0; si < pp.llvm_slots.length; si++) {
            const slot: LType = pp.llvm_slots[si];
            if (!slot.is_valid()) { all_valid = false; }
            slots[idx] = slot.raw;
            idx += 1;
        }
    }

    if (!all_valid) {
        intrinsics::free(buf);
        return LType::null();
    }

    const fn_ty: LType = LType::function_type(ret_ty, buf, total, is_variadic);
    intrinsics::free(buf);
    return fn_ty;
}
