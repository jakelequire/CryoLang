///! ParserBase
///!
///! Base class providing the token cursor, source span construction, error
///! reporting, and recovery infrastructure shared by all parser layers.

namespace Compiler::Parser::ParserBase;

import Compiler::Lex;
import Compiler::Diag;
import Compiler::Diag::{ SourceSpan, Diagnostic, Suggestion };
import Compiler::AST::{ Statement, Expression };
import Compiler::CompilationContext;
import Compiler::Resolver::SymbolStr;
import Utils::Logger;
import std::collections::string;
import std::collections::str;
import std::fmt::float;


type class ParserBase {
public:
    /// Parse a brace-delimited block containing statements and expressions.
    /// Base implementation returns null; overridden by ExprParser (limited)
    /// and Parser (full statement support including for/if/while).
    virtual parse_inner_block() -> BlockStmtNode* {
        return null;
    }

    /// Parse a standalone expression from a separate token stream, on a
    /// fresh parser instance.  Used by f-string desugaring to parse each
    /// `{...}` hole without disturbing this parser's own token stream (which
    /// is owned - reassigning it would drop the live tokens).  Overridden by
    /// `Parser` to spin up a real sub-`Parser`; the base returns null.
    virtual parse_expr_from_tokens(toks: Token[]) -> ExpressionNode* {
        return null;
    }

    tokens:        Token[];
    pos:           int;
    source_file:   string;
    ctx:           CompilationContext*;
    panic_mode:    boolean;
    error_count:   int;
    scope_depth:   int;
    brace_depth:   int;
    paren_depth:   int;
    bracket_depth: int;
    // Names bound as parameters or locals in the function being parsed, used
    // to settle `ident <` in expression position.  `f(a < b, c > (d))` is a
    // generic call and a pair of comparisons under the same grammar, and the
    // token scan cannot tell them apart; knowing `a` names a local settles it,
    // because a local is not a generic function or type.
    //
    // Reset per parameter list, so a name is only ever consulted inside the
    // function that bound it.  Deliberately flat rather than a scope stack: a
    // name declared in an inner block stays listed for the rest of the
    // function, which only ever biases toward the comparison reading, and
    // calling a generic whose name a local in the same function shadows is
    // pathological either way.
    local_names:   SymbolStr[];
    // Module-level names collected up front by `scan_module_names`, which
    // settles the same `ident <` question for names that are not locals.
    // Gathered by a token pre-scan rather than as declarations are parsed
    // because the parse is single-pass: a global or generic declared further
    // down the file must still be known to a function above it.
    //
    // `global_value_names` bind values, so their `<` is a comparison;
    // `generic_decl_names` are declared with type parameters, so theirs opens
    // type arguments. A name in neither - anything imported, most obviously -
    // falls through to the token scan.
    global_value_names: SymbolStr[];
    generic_decl_names: SymbolStr[];
    // Paren-less `if`/`while`/`for`/`match` conditions forbid a bare struct
    // literal (`if Foo { .. }` is the loop body, not a struct value).  When a
    // condition is parsed without surrounding `()`, this records the bracketing
    // depth (`paren_depth + bracket_depth`) at which struct literals must be
    // suppressed; descending into `(` / `[` raises the depth and re-enables
    // them automatically.  -1 means "no restriction active" (the default and
    // the state inside a fully parenthesized condition).
    no_struct_lit_depth: int;
    // Recursive-descent depth of `parse_unary`. Prefix-operator chains
    // (`----...x`, `!!!...x`) recurse once per operator with no bracketing
    // token for advance() to count, so they need their own guard or a few
    // hundred thousand levels overflow the native stack and crash the
    // compiler (SIGSEGV). Incremented around the single recursive call in
    // parse_unary; see the UNARY_DEPTH_LIMIT guard there.
    unary_depth:   int;

    // Recursive-descent depth of the right-associative expression-operator
    // chains: assignment (`a = b = c ...`), null-coalesce (`a ?? b ?? c ...`),
    // and the ternary conditional's else branch (`a ? b : c ? d : e ...`).
    // Each recurses once per operator with no bracketing token for advance()
    // to count, so a pathological chain overflows the native stack and
    // crashes the compiler (SIGSEGV) - the same failure mode as unary_depth,
    // but these three were missing a guard. A single shared counter is used
    // (not one per operator) because the operators interleave on the native
    // stack: `a ? (b = (c ?? ...))` nests through all three, and it is the
    // cumulative stack depth that matters. Incremented around each recursive
    // call; see the EXPR_DEPTH_LIMIT guards in expr_parser.
    expr_depth:    int;

    // Recursive-descent depth of parse_type_annotation. Nested type forms -
    // references (`&&&&...T`), generics (`Option<Option<...>>`), and
    // parenthesized/grouping types (`(((...T)))`) - each recurse through
    // parse_type_annotation; `&`/`?` nesting in particular has no bracketing
    // token for advance() to count, so a pathological annotation overflows the
    // native stack and crashes the compiler (SIGSEGV). Incremented around the
    // body in the parse_type_annotation guard wrapper. Capping here also bounds
    // every downstream annotation walker (e.g. type_resolution's
    // rewrite_this_type_annotation), since nothing deeper can ever be parsed.
    type_depth:    int;

    // Set by parse_parameter_list when a bare `...` is encountered (no
    // accompanying name like `args...`). Callers that build a function
    // node check this after parsing the parameter list and forward the
    // variadic flag onto the node. Reset on entry to parse_parameter_list.
    pending_bare_variadic: boolean;

    // Set by parse_parameter when a named `args...` form is seen. Callers
    // forward the variadic flag onto the function node the same way as
    // pending_bare_variadic. Reset on entry to parse_parameter_list.
    pending_named_variadic: boolean;

    // Set by consume_right_angle when it encounters `>>` while expecting a
    // single `>`: advances past the `>>` and leaves this flag so the *next*
    // consume_right_angle (closing the outer generic) consumes the virtual
    // remaining `>` without re-reading the token stream.
    pending_right_angle: boolean;

    // Doc comment accumulation
    pending_doc_comments: string[];

    // Source line where the most recently pushed doc comment ended.
    // -1 means no pending doc.  Used to enforce "doc is immediately
    // above the decl"; `take_documentation` discards the cluster
    // when there's a blank-line gap between the last doc and the
    // current token.  Same check inside `push_doc` discards an
    // earlier cluster when a NEW doc appears after a gap, so two
    // doc clusters separated by blank lines never merge.
    last_doc_end_line: int;

    // For self-referential type detection
    current_type_name: string;

    // Set by `parse_fstring` when an f-string (`f"..."`) is parsed.  The
    // top-level Parser copies it onto the ProgramNode so AutoImport can
    // inject the f-string runtime import; see ProgramNode.uses_fstring.
    used_fstring: boolean;

    // Span of the f-string currently being desugared.  Held in a field so
    // the `fstr_*` desugar helpers don't take it as a by-value `SourceSpan`
    // parameter (mixing a trailing struct-by-value with several scalar args
    // tripped a calling-convention mismatch).
    fstr_span: SourceSpan;


    ParserBase(tokens: Token[], source_file: string, ctx: CompilationContext*) {
        this.tokens       = tokens;
        this.pos          = 0;
        this.source_file  = source_file;
        this.ctx          = ctx;
        this.panic_mode   = false;
        this.error_count  = 0;
        this.scope_depth  = 0;
        this.brace_depth  = 0;
        this.paren_depth  = 0;
        this.bracket_depth = 0;
        this.local_names  = [];
        this.global_value_names = [];
        this.generic_decl_names = [];
        this.no_struct_lit_depth = -1;
        this.unary_depth  = 0;
        this.expr_depth   = 0;
        this.type_depth   = 0;

        this.pending_bare_variadic  = false;
        this.pending_named_variadic = false;
        this.pending_right_angle    = false;

        this.pending_doc_comments = [];
        this.last_doc_end_line    = -1;
        this.current_type_name    = "";
        this.used_fstring         = false;
        this.fstr_span            = SourceSpan::none();
    }


    /// Peek at the current token without consuming it.
    current() -> Token {
        if (this.pos >= this.tokens.length) {
            return Token::eof(0, 0);
        }
        return this.tokens[this.pos];
    }

    /// Peek at a token at offset from current position.
    peek_at(offset: int) -> Token {
        const idx: int = this.pos + offset;
        if (idx < 0 || idx >= this.tokens.length) {
            return Token::eof(0, 0);
        }
        return this.tokens[idx];
    }

    /// Consume the current token and return it.
    /// Skips over comments and doc comments, tracking bracket depth.
    advance() -> Token {
        if (this.pos >= this.tokens.length) {
            return Token::eof(0, 0);
        }

        const tok: Token = this.tokens[this.pos];
        this.pos += 1;

        // Track bracket depth
        match (&tok.kind) {
            TokenType::LBrace   => { this.brace_depth += 1; }
            TokenType::RBrace   => { this.brace_depth -= 1; }
            TokenType::LParen   => { this.paren_depth += 1; }
            TokenType::RParen   => { this.paren_depth -= 1; }
            TokenType::LSquare  => { this.bracket_depth += 1; }
            TokenType::RSquare  => { this.bracket_depth -= 1; }
            _ => {}
        }

        // Skip over comments, collecting doc comments
        while (this.pos < this.tokens.length) {
            const next: Token = this.tokens[this.pos];
            match (&next.kind) {
                TokenType::Comment => {
                    this.pos += 1;
                }
                TokenType::DocCommentLine => {
                    this.push_doc(next);
                    this.pos += 1;
                }
                TokenType::DocCommentBlock => {
                    this.push_doc(next);
                    this.pos += 1;
                }
                _ => { break; }
            }
        }

        return tok;
    }

    /// Check if the current token is of the given kind.
    check(kind: TokenType) -> boolean {
        return this.current().kind == kind;
    }

    /// True when a bare struct literal must be suppressed at the current
    /// position: a paren-less condition set `no_struct_lit_depth`, and we are
    /// still at that same bracketing depth (not inside a `(` / `[` group that
    /// would make a following `{` unambiguous again).  See `no_struct_lit_depth`.
    struct_lit_suppressed() -> boolean {
        return this.no_struct_lit_depth >= 0
            && (this.paren_depth + this.bracket_depth) == this.no_struct_lit_depth;
    }

    /// Check if the current token is any of the given kinds.
    check_any(kinds: TokenType[]) -> boolean {
        const cur: TokenType = this.current().kind;
        for (mut i: int = 0; i < kinds.length; i++) {
            if (cur == kinds[i]) {
                return true;
            }
        }
        return false;
    }

    /// Consume and return true if the current token matches the given kind.
    match_tok(kind: TokenType) -> boolean {
        if (this.check(kind)) {
            this.advance();
            return true;
        }
        return false;
    }

    /// Consume and return true if the current token matches any of the given kinds.
    match_any(kinds: TokenType[]) -> boolean {
        if (this.check_any(kinds)) {
            this.advance();
            return true;
        }
        return false;
    }

    /// Expect and consume a token of the given kind.
    /// Reports an error and enters panic mode if the token doesn't match.
    consume(kind: TokenType, message: string) -> Token {
        if (this.check(kind)) {
            return this.advance();
        }

        LOG_DEBUG(LogComponent::Parser, "[Parser] consume() failed: expected '%s', found '%s' at line %d",
            message, this.current().lexeme, this.current().line);
        this.error_expected_with_insert(kind, message);
        return this.current();
    }

    /// Map a TokenType whose source representation is a fixed literal
    /// (delimiters, common punctuators, the assignment / arrow / fat-arrow
    /// operators) to that literal.  Returns the empty string for kinds
    /// whose source form is variable (identifiers, literals, keywords
    /// that may be spelled differently across configurations), in which
    /// case the caller skips the auto-insert quickfix.  Keep this list
    /// conservative - every entry here drives a machine-applicable edit,
    /// so a wrong mapping would auto-apply broken code.
    static literal_for_token(kind: TokenType) -> string {
        return match (kind) {
            TokenType::Semicolon   => { ";"  }
            TokenType::Comma       => { ","  }
            TokenType::Colon       => { ":"  }
            TokenType::ColonColon  => { "::" }
            TokenType::LParen      => { "("  }
            TokenType::RParen      => { ")"  }
            TokenType::LBrace      => { "{"  }
            TokenType::RBrace      => { "}"  }
            TokenType::LSquare     => { "["  }
            TokenType::RSquare     => { "]"  }
            TokenType::LAngle      => { "<"  }
            TokenType::RAngle      => { ">"  }
            TokenType::Arrow       => { "->" }
            TokenType::FatArrow    => { "=>" }
            TokenType::Equal       => { "="  }
            _                      => { ""   }
        };
    }

    /// Like `error_expected`, but when the expected token has a fixed
    /// source form (see `literal_for_token`), attach a machine-applicable
    /// suggestion that inserts the literal at the end of the previous
    /// real token.  This turns "expected ';'" into a one-click fix for
    /// the missing-semicolon / missing-comma / missing-paren cases that
    /// dominate parser-error UX.
    error_expected_with_insert(kind: TokenType, expected: string) -> void {
        const tok: Token = this.current();
        const message: string = format("expected %s, found '%s'", expected, tok.lexeme);
        const literal: string = ParserBase::literal_for_token(kind);
        if (literal == "") {
            // No safe auto-insertion; fall back to the plain error.
            this.report_error(ErrorCode::E0100_EXPECTED_TOKEN, message);
            return;
        }

        // Anchor: the END of the most recently consumed real token.  For
        // the missing-`;` case this places the caret just after the
        // expression - exactly where the user expects it.  When there's
        // no prior token (start of input), fall through to the unadorned
        // error so we don't synthesise a span at column 0.
        mut anchor_line: u32 = 0;
        mut anchor_col:  u32 = 0;
        mut found_prev:  boolean = false;
        mut idx: int = this.pos - 1;
        while (idx >= 0 && idx < this.tokens.length) {
            const k: TokenType = this.tokens[idx].kind;
            if (k == TokenType::Comment
                    || k == TokenType::DocCommentLine
                    || k == TokenType::DocCommentBlock) {
                idx -= 1;
                continue;
            }
            const prev: Token = this.tokens[idx];
            anchor_line = prev.line as u32;
            anchor_col  = prev.column as u32 + prev.source_length as u32;
            found_prev  = true;
            break;
        }
        if (!found_prev) {
            this.report_error(ErrorCode::E0100_EXPECTED_TOKEN, message);
            return;
        }

        this.panic_mode = true;
        this.error_count += 1;
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0100_EXPECTED_TOKEN, message);
        diag = diag.at(this.current_span());
        const insert_span: SourceSpan = SourceSpan::new(
            this.source_file,
            anchor_line, anchor_col,
            anchor_line, anchor_col);
        diag = diag.suggest(Suggestion::machine_applicable(
            insert_span, literal,
            format("insert `%s` here", literal)));
        this.ctx.emit_diagnostic(diag);
    }

    /// Check if we've reached the end of the token stream.
    is_at_end() -> boolean {
        return this.pos >= this.tokens.length || this.check(TokenType::EOF);
    }

    /// Create a SourceSpan from a single token.  Uses the token's
    /// `source_length` (set by the lexer) rather than `lexeme.length()`
    /// These differ for string literals, where the escape-processed
    /// lexeme is shorter than the original source extent.
    span_from_token(tok: Token) -> SourceSpan {
        const end_col: u32 = tok.column as u32 + tok.source_length as u32;
        return SourceSpan::new(
            this.source_file,
            tok.line as u32, tok.column as u32,
            tok.line as u32, end_col
        );
    }

    /// Get the span of the current token.
    current_span() -> SourceSpan {
        return this.span_from_token(this.current());
    }

    /// Create a span from a start token to the previously consumed token.
    /// `advance()` skips over comments and doc-comments after each
    /// real consumption, so `tokens[pos - 1]` may be a comment that
    /// followed the last real token.  Walk backwards over those to
    /// find the actual end of the consumed range; without this, a
    /// `namespace X;` followed by `///` doc comments on later lines
    /// gets a span ending at the last doc comment instead of `;`.
    span_from(start: Token) -> SourceSpan {
        mut idx: int = this.pos - 1;
        while (idx >= 0 && idx < this.tokens.length) {
            const k: TokenType = this.tokens[idx].kind;
            if (k == TokenType::Comment
                    || k == TokenType::DocCommentLine
                    || k == TokenType::DocCommentBlock) {
                idx -= 1;
                continue;
            }
            break;
        }
        if (idx >= 0 && idx < this.tokens.length) {
            const end_tok: Token = this.tokens[idx];
            const end_col: u32 = end_tok.column as u32 + end_tok.source_length as u32;
            return SourceSpan::new(
                this.source_file,
                start.line as u32, start.column as u32,
                end_tok.line as u32, end_col
            );
        }
        return this.span_from_token(start);
    }

    /// Parse a numeric-constant token's lexeme as a signed 64-bit integer.
    /// Recognizes `0x` / `0X` hex, `0b` / `0B` binary, `0o` / `0O` octal,
    /// and decimal, with optional leading sign and `_` digit separators.
    /// A bare leading zero is decimal, not octal (`077` == 77).  Returns
    /// 0 on a malformed lexeme; the lexer should have
    /// already rejected those.  Mirrors the codegen-side parse_int_lexeme
    /// so that enum discriminants, pattern integer literals, and codegen
    /// agree on the value of every numeric constant.
    static parse_numeric_lexeme_i64(s: string) -> i64 {
        if (s == null) { return 0; }
        const len: i64 = s.length() as i64;
        if (len == 0) { return 0; }
        mut i: i64 = 0;
        mut negate: boolean = false;
        if (s[0] == '-') { negate = true; i = 1; }
        else if (s[0] == '+') { i = 1; }

        mut base: i64 = 10;
        if (i + 1 < len && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) {
            base = 16; i += 2;
        } else if (i + 1 < len && s[i] == '0' && (s[i + 1] == 'b' || s[i + 1] == 'B')) {
            base = 2;  i += 2;
        } else if (i + 1 < len && s[i] == '0' && (s[i + 1] == 'o' || s[i + 1] == 'O')) {
            base = 8;  i += 2;
        }

        // Accumulate in u64 with a hard overflow guard: a literal that needs
        // more than 64 bits (e.g. `0x1_0000_0000_0000_0000` or a 25-digit
        // decimal) would wrap silently to an arbitrary small/negative value
        // - dangerous for the parser-side callers (fixed-array sizes, enum
        // discriminants, pattern literals) that have no later value-range
        // check. Saturate to u64::MAX instead so the value is at worst
        // obviously-too-big (a giant array size fails loudly at codegen)
        // rather than a plausible small wrap. The array-size caller also
        // reports E0010 up front via `numeric_lexeme_overflows_u64`.
        const u64_max: u64 = (0 as u64) - (1 as u64);
        const ubase: u64 = base as u64;
        mut acc: u64 = 0;
        mut overflowed: boolean = false;
        while (i < len) {
            const c: char = s[i];
            if (c == '_') { i += 1; continue; }
            mut digit: i64 = -1;
            if (c >= '0' && c <= '9')      { digit = (c as i64) - ('0' as i64); }
            else if (c >= 'a' && c <= 'f') { digit = (c as i64) - ('a' as i64) + 10; }
            else if (c >= 'A' && c <= 'F') { digit = (c as i64) - ('A' as i64) + 10; }
            else { break; }
            if (digit >= base) { break; }
            const ud: u64 = digit as u64;
            // acc * ubase + ud overflows u64 if acc > (u64_max - ud) / ubase.
            if (acc > (u64_max - ud) / ubase) {
                overflowed = true;
                break;
            }
            acc = acc * ubase + ud;
            i += 1;
        }
        if (overflowed) { acc = u64_max; }

        if (negate) { return -(acc as i64); }
        return acc as i64;
    }

    /// True when the integer lexeme `s` needs more than 64 bits, i.e. when
    /// `parse_numeric_lexeme_i64` would have to saturate. Lets a caller that
    /// cares (the fixed-array-size path) report a precise diagnostic instead
    /// of silently using the saturated value. Honours the `0x`/`0o`/`0b`
    /// prefixes, `_` separators, and a leading sign, mirroring the parser.
    static numeric_lexeme_overflows_u64(s: string) -> boolean {
        if (s == null) { return false; }
        const len: i64 = s.length() as i64;
        if (len == 0) { return false; }
        mut i: i64 = 0;
        if (s[0] == '-' || s[0] == '+') { i = 1; }
        mut base: i64 = 10;
        if (i + 1 < len && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) {
            base = 16; i += 2;
        } else if (i + 1 < len && s[i] == '0' && (s[i + 1] == 'b' || s[i + 1] == 'B')) {
            base = 2;  i += 2;
        } else if (i + 1 < len && s[i] == '0' && (s[i + 1] == 'o' || s[i + 1] == 'O')) {
            base = 8;  i += 2;
        }
        const u64_max: u64 = (0 as u64) - (1 as u64);
        const ubase: u64 = base as u64;
        mut acc: u64 = 0;
        while (i < len) {
            const c: char = s[i];
            if (c == '_') { i += 1; continue; }
            mut digit: i64 = -1;
            if (c >= '0' && c <= '9')      { digit = (c as i64) - ('0' as i64); }
            else if (c >= 'a' && c <= 'f') { digit = (c as i64) - ('a' as i64) + 10; }
            else if (c >= 'A' && c <= 'F') { digit = (c as i64) - ('A' as i64) + 10; }
            else { break; }
            if (digit >= base) { break; }
            const ud: u64 = digit as u64;
            if (acc > (u64_max - ud) / ubase) { return true; }
            acc = acc * ubase + ud;
            i += 1;
        }
        return false;
    }

    /// Strip surrounding double-quote characters from a string-literal
    /// lexeme.  The lexer keeps the quotes in the lexeme (`"foo"`); this
    /// returns just the content (`foo`).  Returns the input unchanged if
    /// it doesn't start and end with `"`.
    static unquote_string_lexeme(s: string) -> string {
        if (s == null) { return ""; }
        const len: i64 = s.length() as i64;
        if (len < 2 || s[0] != '"' || s[len - 1] != '"') {
            return s;
        }
        const inner_len: i64 = len - 2;
        mut out: String = String::from_str(Str::from_raw((s + 1) as u8*, inner_len as u64));
        return out.into_raw();
    }

    /// Parse a numeric-constant token's lexeme as f64.  Defers to
    /// libc `sscanf` for full C99 float syntax (mantissa, exponent, hex
    /// floats not supported here; the lexer doesn't emit them).
    static parse_numeric_lexeme_f64(s: string) -> f64 {
        return float::parse_f64(s).unwrap_or(0.0);
    }

    /// True if `s` looks like a float literal (contains `.`, `e`, or `E`).
    /// Used by pattern parsing to pick between LiteralInt and LiteralFloat
    /// when the token kind alone (NumericConstant) doesn't distinguish them.
    static is_float_lexeme(s: string) -> boolean {
        if (s == null) { return false; }
        const llen: u32 = s.length() as u32;
        for (mut i: u32 = 0; i < llen; i++) {
            const c: char = s[i];
            if (c == '.' || c == 'e' || c == 'E') { return true; }
        }
        return false;
    }

    /// Merge two spans into one covering both.
    static merge_spans(a: SourceSpan, b: SourceSpan) -> SourceSpan {
        mut start_line: u32 = a.start_line;
        mut start_col:  u32 = a.start_col;
        mut end_line:   u32 = b.end_line;
        mut end_col:    u32 = b.end_col;

        if (b.start_line < a.start_line ||
            (b.start_line == a.start_line && b.start_col < a.start_col)) {
            start_line = b.start_line;
            start_col  = b.start_col;
        }
        if (a.end_line > b.end_line ||
            (a.end_line == b.end_line && a.end_col > b.end_col)) {
            end_line = a.end_line;
            end_col  = a.end_col;
        }

        return SourceSpan::new(a.file, start_line, start_col, end_line, end_col);
    }


    /// Report an error at the current position.
    report_error(code: ErrorCode, message: string) -> void {
        LOG_DEBUG(LogComponent::Parser, "[Parser] Error %s: %s at line %d",
            code.format(), message, this.current().line);
        this.panic_mode = true;
        this.error_count += 1;
        this.ctx.emit_error_at(code, message, this.current_span());
    }

    /// Report an error at a specific span.
    report_error_at(code: ErrorCode, message: string, span: SourceSpan) -> void {
        this.panic_mode = true;
        this.error_count += 1;
        this.ctx.emit_error_at(code, message, span);
    }

    /// Report a construct that parses cleanly but is not allowed here.
    ///
    /// Unlike `report_error*`, this leaves `panic_mode` clear: the token stream
    /// is still synchronized, and entering panic mode would abandon the rest of
    /// the construct mid-expression and bury the real shape of the declaration.
    report_invalid_at(code: ErrorCode, message: string, span: SourceSpan) -> void {
        this.error_count += 1;
        this.ctx.emit_error_at(code, message, span);
    }

    /// Report "expected X, found Y" error.
    error_expected(expected: string) -> void {
        const tok: Token = this.current();
        const message: string = format("expected %s, found '%s'", expected, tok.lexeme);
        this.report_error(ErrorCode::E0100_EXPECTED_TOKEN, message);
    }

    /// Report "unexpected token X" error.
    error_unexpected() -> void {
        const tok: Token = this.current();
        const message: string = format("unexpected token '%s'", tok.lexeme);
        this.report_error(ErrorCode::E0101_UNEXPECTED_TOKEN, message);
    }

    /// Report "unexpected EOF" error.
    error_eof(context: string) -> void {
        const message: string = format("unexpected end of file while parsing %s", context);
        this.report_error(ErrorCode::E0112_UNEXPECTED_EOF, message);
    }


    /// Consume tokens until we find a synchronization point.
    /// Clears panic_mode when a recovery point is reached.
    synchronize() -> void {
        LOG_DEBUG(LogComponent::Parser, "[Parser] synchronize() entry at pos %d", this.pos);
        this.panic_mode = false;

        while (!this.is_at_end()) {
            // Sync after semicolons
            if (this.check(TokenType::Semicolon)) {
                this.advance();
                return;
            }

            // Sync at declaration starts
            if (this.is_declaration_start()) {
                return;
            }

            // Sync at statement starts
            if (this.is_statement_start()) {
                return;
            }

            // Sync at closing braces (end of block)
            if (this.check(TokenType::RBrace)) {
                return;
            }

            this.advance();
        }
    }

    /// Check if the current token could start a declaration.
    is_declaration_start() -> boolean {
        const kind: TokenType = this.current().kind;
        return match (kind) {
            TokenType::KwFunction  => { true }
            TokenType::KwConst     => { true }
            TokenType::KwMut       => { true }
            TokenType::KwType      => { true }
            TokenType::KwStruct    => { true }
            TokenType::KwClass     => { true }
            TokenType::KwEnum      => { true }
            TokenType::KwTrait     => { true }
            TokenType::KwImport    => { true }
            TokenType::KwModule    => { true }
            TokenType::KwExtern    => { true }
            TokenType::KwImplement => { true }
            TokenType::KwPublic    => { true }
            TokenType::KwPrivate   => { true }
            TokenType::KwProtected => { true }
            TokenType::KwNamespace => { true }
            TokenType::KwIntrinsic => { true }
            TokenType::KwStatic    => { true }
            TokenType::KwAsync     => { true }
            _                      => { false }
        };
    }

    /// Check if the current token could start a statement.
    is_statement_start() -> boolean {
        const kind: TokenType = this.current().kind;
        return match (kind) {
            TokenType::KwIf       => { true }
            TokenType::KwWhile    => { true }
            TokenType::KwFor      => { true }
            TokenType::KwDo       => { true }
            TokenType::KwLoop     => { true }
            TokenType::KwReturn   => { true }
            TokenType::KwBreak    => { true }
            TokenType::KwContinue => { true }
            TokenType::KwMatch    => { true }
            TokenType::KwUnsafe   => { true }
            TokenType::LBrace     => { true }
            _                     => { false }
        };
    }

    /// Check if current token is a keyword that starts a statement (excludes LBrace).
    /// Used in match arm blocks where '{' could be an expression block.
    is_statement_keyword() -> boolean {
        const kind: TokenType = this.current().kind;
        return match (kind) {
            TokenType::KwIf       => { true }
            TokenType::KwWhile    => { true }
            TokenType::KwFor      => { true }
            TokenType::KwDo       => { true }
            TokenType::KwLoop     => { true }
            TokenType::KwReturn   => { true }
            TokenType::KwBreak    => { true }
            TokenType::KwContinue => { true }
            TokenType::KwMatch    => { true }
            TokenType::KwUnsafe   => { true }
            TokenType::KwConst    => { true }
            TokenType::KwMut      => { true }
            _                     => { false }
        };
    }


    /// Intern a token's lexeme via the compilation context.
    intern_lexeme(tok: Token) -> SymbolStr {
        return this.ctx.intern(tok.lexeme);
    }

    /// Skip doc comment tokens and accumulate their text.
    collect_doc_comments() -> void {
        while (this.pos < this.tokens.length) {
            const tok: Token = this.current();
            match (&tok.kind) {
                TokenType::DocCommentLine => {
                    this.push_doc(tok);
                    this.pos += 1;
                }
                TokenType::DocCommentBlock => {
                    this.push_doc(tok);
                    this.pos += 1;
                }
                TokenType::Comment => {
                    this.pos += 1;
                }
                _ => { break; }
            }
        }
    }

    /// Push one doc-comment token's lexeme into `pending_doc_comments`,
    /// updating `last_doc_end_line`.  When the new doc starts after a
    /// blank-line gap from the previous pending doc, the earlier
    /// cluster is discarded; a doc cluster is the maximal run of
    /// consecutive doc-comment lines / blocks with no source-line
    /// gaps between them.  Block doc comments span multiple lines;
    /// `count_newlines_in_str` counts how many to derive the end line.
    push_doc(mut &this, tok: Token) -> void {
        const start_line: int = tok.line;
        const end_line:   int = start_line + ParserBase::count_newlines_in_str(tok.lexeme);
        if (this.last_doc_end_line >= 0 && start_line > this.last_doc_end_line + 1) {
            this.pending_doc_comments = [];
        }
        this.pending_doc_comments.push(tok.lexeme);
        this.last_doc_end_line = end_line;
    }

    /// True when the pending doc cluster is a `///!` inner-doc banner
    /// Its first line's lexeme starts with `///!`.  Inner doc
    /// documents the enclosing module rather than "the next item", so
    /// `take_documentation` exempts it from the blank-line adjacency
    /// rule: every file in the tree separates its `///!` banner from
    /// the `namespace` decl with a blank line.
    pending_doc_is_bang_banner() -> boolean {
        if (this.pending_doc_comments.length == 0) { return false; }
        const first: string = this.pending_doc_comments[0];
        if (first == null) { return false; }
        // `string` is NUL-terminated, so a lexeme shorter than 4 bytes
        // just compares unequal at the terminator; no OOB read.
        return first[0] == '/' && first[1] == '/'
            && first[2] == '/' && first[3] == '!';
    }

    /// Extract and clear pending doc comments, joining them with
    /// newlines.  Discards the cluster (returns "") when there's a
    /// blank-line gap between the last doc and the current token;
    /// the spec is "doc must be immediately above the decl", so a
    /// doc separated from the decl by a blank line doesn't count.
    /// `///!` inner-doc banners are exempt (see
    /// `pending_doc_is_bang_banner`): they document the module and
    /// conventionally sit a blank line above the `namespace` decl.
    take_documentation() -> string {
        if (this.pending_doc_comments.length == 0) {
            return "";
        }
        if (!this.pending_doc_is_bang_banner()
            && this.last_doc_end_line >= 0
            && this.current().line > this.last_doc_end_line + 1) {
            this.pending_doc_comments = [];
            this.last_doc_end_line = -1;
            return "";
        }
        mut result: string = "";
        for (mut i: int = 0; i < this.pending_doc_comments.length; i++) {
            if (i > 0) {
                result = result.append("\n");
            }
            result = result.append(this.pending_doc_comments[i]);
        }
        this.pending_doc_comments = [];
        this.last_doc_end_line = -1;
        return result;
    }

    /// Increment scope depth.
    enter_scope() -> void {
        this.scope_depth += 1;
    }

    /// Decrement scope depth.
    exit_scope() -> void {
        this.scope_depth -= 1;
    }

    /// Forget the previous function's bindings. Called when a parameter list
    /// starts, which is the one point every function and method passes through
    /// before its body.
    reset_local_names() -> void {
        this.local_names = [];
    }

    /// Record `name` as bound in the function being parsed.
    note_local_name(name: SymbolStr) -> void {
        if (!name.is_valid()) { return; }
        this.local_names.push(name);
    }

    /// Whether `name` is bound as a parameter or local here. A true answer
    /// means an `ident <` that follows cannot open type arguments.
    is_local_name(name: SymbolStr) -> boolean {
        if (!name.is_valid()) { return false; }
        for (mut i: int = 0; i < this.local_names.length; i++) {
            if (this.local_names[i].id == name.id) { return true; }
        }
        return false;
    }

    /// Whether `name` is a module-level `const`/`mut` binding.
    is_global_value_name(name: SymbolStr) -> boolean {
        if (!name.is_valid()) { return false; }
        for (mut i: int = 0; i < this.global_value_names.length; i++) {
            if (this.global_value_names[i].id == name.id) { return true; }
        }
        return false;
    }

    /// Whether `name` is declared in this module WITH type parameters.
    is_generic_decl_name(name: SymbolStr) -> boolean {
        if (!name.is_valid()) { return false; }
        for (mut i: int = 0; i < this.generic_decl_names.length; i++) {
            if (this.generic_decl_names[i].id == name.id) { return true; }
        }
        return false;
    }

    /// Whether `name` is known to bind a VALUE rather than a function or type,
    /// which makes a following `<` a comparison rather than type arguments.
    binds_a_value(name: SymbolStr) -> boolean {
        if (this.is_local_name(name)) { return true; }
        // A local shadows a module-level declaration, so the generic check
        // only applies to names no local has claimed.
        if (this.is_generic_decl_name(name)) { return false; }
        return this.is_global_value_name(name);
    }

    /// Collect module-level names before parsing, walking the token array
    /// directly. Only nesting depth zero counts: a `const` inside a function
    /// body is a local, and a `function` inside a type body is a method whose
    /// name is reached through a receiver rather than bare.
    ///
    /// Both forms are recognised by shape alone, which is unambiguous in
    /// declaration position - `function NAME <` and `type KIND NAME <` open
    /// type parameters, with none of the guesswork the expression position
    /// needs.
    scan_module_names() -> void {
        mut depth: int = 0;
        mut i: int = 0;
        while (i < this.tokens.length) {
            const k: TokenType = this.tokens[i].kind;

            if (k == TokenType::LBrace) { depth += 1; i += 1; continue; }
            if (k == TokenType::RBrace) { depth -= 1; i += 1; continue; }

            if (depth != 0) { i += 1; continue; }

            // `const NAME` / `mut NAME` at depth zero: a module global.
            if (k == TokenType::KwConst || k == TokenType::KwMut) {
                if (i + 1 < this.tokens.length &&
                    this.tokens[i + 1].kind == TokenType::Identifier) {
                    this.global_value_names.push(
                        this.ctx.intern(this.tokens[i + 1].lexeme));
                }
                i += 1;
                continue;
            }

            // `function NAME <` : a generic function.
            if (k == TokenType::KwFunction) {
                if (i + 2 < this.tokens.length &&
                    this.tokens[i + 1].kind == TokenType::Identifier &&
                    this.tokens[i + 2].kind == TokenType::LAngle) {
                    this.generic_decl_names.push(
                        this.ctx.intern(this.tokens[i + 1].lexeme));
                }
                i += 1;
                continue;
            }

            // `type KIND NAME <` : a generic struct/union/class/enum/trait.
            // The alias form `type NAME<T> = ...` puts the name one slot
            // earlier, so both offsets are checked.
            if (k == TokenType::KwType) {
                if (i + 3 < this.tokens.length &&
                    this.tokens[i + 2].kind == TokenType::Identifier &&
                    this.tokens[i + 3].kind == TokenType::LAngle) {
                    this.generic_decl_names.push(
                        this.ctx.intern(this.tokens[i + 2].lexeme));
                } else if (i + 2 < this.tokens.length &&
                           this.tokens[i + 1].kind == TokenType::Identifier &&
                           this.tokens[i + 2].kind == TokenType::LAngle) {
                    this.generic_decl_names.push(
                        this.ctx.intern(this.tokens[i + 1].lexeme));
                }
                i += 1;
                continue;
            }

            i += 1;
        }
    }

    /// Handle `>>` splitting for nested generics.
    /// When expecting `>` but finding `>>`, advance past the whole `>>` and
    /// raise `pending_right_angle` so the *next* `consume_right_angle()`
    /// (closing the outer generic) finds the virtual second `>` without
    /// re-reading the token stream.
    consume_right_angle() -> void {
        if (this.pending_right_angle) {
            this.pending_right_angle = false;
            return;
        }
        if (this.check(TokenType::RAngle)) {
            this.advance();
            return;
        }
        if (this.check(TokenType::GreaterGreater)) {
            this.advance();
            this.pending_right_angle = true;
            return;
        }
        this.error_expected("'>'");
    }

    /// Count the number of `'\n'` bytes in `s`.  Used to compute the
    /// end-line of a multi-line block doc comment from its lexeme so
    /// the doc-cluster gap check sees a `/** ... */` spanning multiple
    /// lines correctly.
    static count_newlines_in_str(s: string) -> int {
        const len: i64 = s.length() as i64;
        mut n: int = 0;
        for (mut i: i64 = 0; i < len; i++) {
            if (s[i] == '\n' as i8) { n += 1; }
        }
        return n;
    }
}
