///! ExprParser
///!
///! Expression and type annotation parsing layer.  Extends ParserBase with
///! Pratt-style precedence-climbing for binary operators, prefix/postfix
///! unary handling, and recursive type annotation parsing.

namespace Compiler::Parser::ExprParser;
import ffi::libc;

import Compiler::Lex;
import Compiler::Lex::Lexer;
import Compiler::Diag;
import Compiler::Diag::SourceSpan;
import Compiler::AST;
import Compiler::AST::{ Node, Expression, Statement, Declaration, Pattern };
import Compiler::CompilationContext;
import Compiler::Resolver::{ SymbolStr, QualifiedName };
import Compiler::Parser::ParserBase;
import Utils::Logger;


// Monotonic counter for synthetic `??`-desugar binding names.  Match-arm
// bindings are arm-scoped so a fixed name would already be collision-free,
// but a unique suffix keeps nested `??` readable in AST dumps and the LSP.
mut g_coalesce_counter: u32 = 0;

// Monotonic counter for synthetic `for-in` iterator bindings
// (`__cryo_for_iter_N`).  Each for-in desugars to a block that owns a
// fresh `mut __cryo_for_iter_N` and drives it through `Iterator::next`.
// Nested and sibling for-in loops in the same function each get their
// own suffix so AST dumps and LSP hover stay legible.
public mut g_for_in_counter: u32 = 0;


type class ExprParser : ParserBase {
public:
    /// Parse a brace-delimited block containing statements and expressions.
    /// ExprParser provides a limited version (const/mut, return, expressions).
    /// Parser overrides this with full statement parsing (for, if, while, etc.).
    override parse_inner_block() -> BlockStmtNode* {
        return this.parse_lambda_block_body();
    }

    ExprParser(tokens: Token[], source_file: string, ctx: CompilationContext*)
        : ParserBase(tokens, source_file, ctx) {
    }


    // Expression Parsing: Entry Points

    /// Top-level expression entry point.
    parse_expression() -> ExpressionNode* {
        LOG_DEBUG(LogComponent::Parser, "[ExprParser] parse_expression()");
        return this.parse_assignment();
    }

    /// Parse assignment expression (right-associative).
    /// assignment = pipe ( ( '=' | '+=' | ... ) assignment )?
    parse_assignment() -> ExpressionNode* {
        mut left: ExpressionNode* = this.parse_pipe();
        if (left == null || this.panic_mode) { return left; }

        if (this.current().kind.is_assignment_op()) {
            // EXPR_DEPTH_LIMIT: a chain `a = b = c = ...` recurses once per
            // `=` with no bracketing token to bound it. Guard before advance()
            // so no token is consumed on the error path. 256 is far beyond any
            // realistic hand-written nesting.
            if (this.expr_depth > 256) {
                this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                    "expression nesting too deep (assignment recursion limit exceeded)");
                return left;
            }
            const op: Token = this.advance();
            this.expr_depth += 1;
            const right: ExpressionNode* = this.parse_assignment();
            this.expr_depth -= 1;
            if (right == null) {
                this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                    "expected expression after assignment operator");
                return left;
            }
            const span: SourceSpan = ParserBase::merge_spans(left.span, right.span);
            return new BinaryExprNode(op, left, right, span);
        }

        return left;
    }

    /// Pipe + null-coalescing precedence level, sitting between assignment
    /// and the ternary conditional, lower-binding than every arithmetic and
    /// logical operator.  So `a + b |> f` is `(a + b) |> f` and `x ?? y + z`
    /// is `x ?? (y + z)`.  All three operators are pure syntactic sugar and
    /// are desugared here, so sema and codegen never see `|>`, `<|`, or `??`:
    ///
    ///   x |> f          =>  f(x)
    ///   x |> f(a, b)    =>  f(x, a, b)     (piped value prepended)
    ///   f <| x          =>  f(x)
    ///   f(a, b) <| x    =>  f(a, b, x)     (piped value appended)
    ///   a ?? b          =>  match (a) { Option::Some(v) => { v }
    ///                                  Option::None    => { b } }
    ///
    /// Pipes are left-associative (`x |> f |> g` is `g(f(x))`).  `??` is
    /// right-associative and lower-binding than the pipes, so `a ?? b ?? c`
    /// is `a ?? (b ?? c)`, which is what makes the chain type-check:
    /// each `??` is `Option<T> ?? T -> T`, so the rightmost operand is the
    /// bare `T` fallback and every operand to its left is an `Option<T>`.
    parse_pipe() -> ExpressionNode* {
        mut left: ExpressionNode* = this.parse_conditional();
        if (left == null || this.panic_mode) { return left; }

        // Left-associative pipe chain.
        while (this.check(TokenType::PipeGreater)
                || this.check(TokenType::LessPipe)) {
            const op: Token = this.advance();
            const right: ExpressionNode* = this.parse_conditional();
            if (right == null) {
                this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                    format("expected expression after '%s'", op.lexeme));
                return left;
            }
            const span: SourceSpan = ParserBase::merge_spans(left.span, right.span);
            if (op.kind == TokenType::PipeGreater) {
                // x |> f : f is `right`, piped value is `left`, prepend.
                left = this.desugar_pipe(right, left, true, span);
            } else {
                // f <| x : f is `left`, piped value is `right`, append.
                left = this.desugar_pipe(left, right, false, span);
            }
        }

        // Right-associative `??`: recurse on the RHS so `a ?? b ?? c`
        // nests as `a ?? (b ?? c)`.
        if (this.check(TokenType::QuestionQuestion)) {
            // EXPR_DEPTH_LIMIT: a chain `a ?? b ?? c ...` recurses once per
            // `??` with no bracketing token to bound it. Guard before advance()
            // so no token is consumed on the error path.
            if (this.expr_depth > 256) {
                this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                    "expression nesting too deep (null-coalesce recursion limit exceeded)");
                return left;
            }
            this.advance();
            this.expr_depth += 1;
            const right: ExpressionNode* = this.parse_pipe();
            this.expr_depth -= 1;
            if (right == null) {
                this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                    "expected expression after '??'");
                return left;
            }
            const span: SourceSpan = ParserBase::merge_spans(left.span, right.span);
            left = this.desugar_null_coalesce(left, right, span);
        }
        return left;
    }

    /// Build a call from a pipe operator.  `callable` is the function side
    /// (an existing CallExprNode whose argument list we extend, or a bare
    /// callable (identifier, member access, or scope resolution) that we
    /// wrap in a fresh call).  `value` is the piped operand; `prepend` puts
    /// it first (`|>`), otherwise last (`<|`).
    desugar_pipe(callable: ExpressionNode*, value: ExpressionNode*,
                 prepend: boolean, span: SourceSpan) -> ExpressionNode* {
        if (callable.kind == NodeKind::CallExpression) {
            mut call: CallExprNode* = callable as CallExprNode*;
            mut new_args: ExpressionNode*[] = [];
            if (prepend) {
                new_args.push(value);
                for (mut i: i64 = 0; i < call.arguments.length; i++) {
                    new_args.push(call.arguments[i]);
                }
            } else {
                for (mut i: i64 = 0; i < call.arguments.length; i++) {
                    new_args.push(call.arguments[i]);
                }
                new_args.push(value);
            }
            call.arguments = new_args;
            call.span = span;
            return call as ExpressionNode*;
        }
        // Bare callable: wrap it in a fresh call with the piped value as
        // the sole argument.
        mut call: CallExprNode* = new CallExprNode(callable, span);
        call.add_argument(value);
        return call as ExpressionNode*;
    }

    /// `a ?? b` => `match (a) { Option::Some(v) => { v } Option::None => { b } }`.
    /// `a` becomes the match scrutinee so it is evaluated exactly once, and
    /// `b` lands in the `None` arm so it is only evaluated when `a` is `None`.
    desugar_null_coalesce(left: ExpressionNode*, right: ExpressionNode*,
                          span: SourceSpan) -> ExpressionNode* {
        g_coalesce_counter += 1;
        const bind_str:  string    = format("__cryo_coalesce_%u", g_coalesce_counter);
        const bind_name: SymbolStr = this.ctx.intern(bind_str);

        mut match_expr: MatchExprNode* = new MatchExprNode(left, span);

        // Some(v) => { v }
        mut some_pat: EnumPatternNode* = new EnumPatternNode(span);
        some_pat.set_enum_name(this.ctx.intern("Option"));
        some_pat.set_variant_name(this.ctx.intern("Some"));
        const pb: PatternBinding* = new PatternBinding { name: bind_name, span: span };
        some_pat.add_element(PatternElement::Binding(pb));
        mut some_arm: MatchArmNode* = new MatchArmNode(span);
        some_arm.add_pattern(some_pat as PatternNode*);
        const some_ident: IdentifierNode* = new IdentifierNode(bind_name, span);
        const some_stmt:  ExprStmtNode*   = new ExprStmtNode(some_ident as ExpressionNode*, span);
        mut some_block: BlockStmtNode* = new BlockStmtNode(span);
        some_block.add_statement(some_stmt as StatementNode*);
        some_arm.set_body(some_block as StatementNode*);
        match_expr.add_arm(some_arm);

        // None => { b }
        mut none_pat: EnumPatternNode* = new EnumPatternNode(span);
        none_pat.set_enum_name(this.ctx.intern("Option"));
        none_pat.set_variant_name(this.ctx.intern("None"));
        mut none_arm: MatchArmNode* = new MatchArmNode(span);
        none_arm.add_pattern(none_pat as PatternNode*);
        const none_stmt: ExprStmtNode* = new ExprStmtNode(right, right.span);
        mut none_block: BlockStmtNode* = new BlockStmtNode(right.span);
        none_block.add_statement(none_stmt as StatementNode*);
        none_arm.set_body(none_block as StatementNode*);
        match_expr.add_arm(none_arm);

        return match_expr as ExpressionNode*;
    }

    /// Parse ternary conditional (right-associative).
    /// conditional = binary ( '?' expression ':' conditional )?
    parse_conditional() -> ExpressionNode* {
        mut expr: ExpressionNode* = this.parse_binary_expression(2);
        if (expr == null || this.panic_mode) { return expr; }

        if (this.check(TokenType::Question)) {
            // EXPR_DEPTH_LIMIT: a chain `a ? b : c ? d : e ...` recurses once
            // per `:` (the right-associative else branch) with no bracketing
            // token to bound it. Guard before advance() so no token is
            // consumed on the error path.
            if (this.expr_depth > 256) {
                this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                    "expression nesting too deep (ternary recursion limit exceeded)");
                return expr;
            }
            this.advance();
            this.expr_depth += 1;
            const true_expr: ExpressionNode* = this.parse_expression();
            if (true_expr == null) {
                this.expr_depth -= 1;
                this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                    "expected expression after '?'");
                return expr;
            }
            this.consume(TokenType::Colon, "':'");
            const false_expr: ExpressionNode* = this.parse_conditional();
            this.expr_depth -= 1;
            if (false_expr == null) {
                this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                    "expected expression after ':'");
                return expr;
            }
            const span: SourceSpan = ParserBase::merge_spans(expr.span, false_expr.span);
            return new TernaryExprNode(expr, true_expr, false_expr, span);
        }

        return expr;
    }

    /// Pratt-style precedence-climbing binary expression parser.
    /// binary = cast ( binop binary )*
    parse_binary_expression(min_prec: int) -> ExpressionNode* {
        mut left: ExpressionNode* = this.parse_cast();
        if (left == null || this.panic_mode) { return left; }

        while (true) {
            const prec: int = this.current().kind.binary_precedence();
            if (prec < min_prec || prec == 0) {
                break;
            }

            const op: Token = this.advance();
            const right: ExpressionNode* = this.parse_binary_expression(prec + 1);
            if (right == null) {
                this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                    format("expected expression after '%s'", op.lexeme));
                return left;
            }
            const span: SourceSpan = ParserBase::merge_spans(left.span, right.span);
            if (op.kind == TokenType::Spaceship) {
                // `a <=> b` => `a.compare(&b)`.  Three-way comparison is
                // sugar for the `Ord` trait method, so sema and codegen
                // never see `<=>`; they just see an ordinary method call
                // that resolves to the concrete `Ord` impl and yields an
                // `Ordering`.  `&b` matches `compare`'s `other: &This`.
                const amp_tok: Token = Token::new(
                    TokenType::Amp, "&", op.line, op.column);
                mut ref_right_node: UnaryExprNode* =
                    new UnaryExprNode(amp_tok, right, right.span);
                // Compiler-synthesized address-of a temporary: exempt from
                // the user-facing "no address-of a literal" check (E0223).
                ref_right_node.is_synthetic = true;
                const ref_right: ExpressionNode* =
                    ref_right_node as ExpressionNode*;
                const compare_name: SymbolStr = this.ctx.intern("compare");
                const member: MemberAccessNode* = new MemberAccessNode(
                    left, compare_name, this.span_from_token(op), span);
                mut call: CallExprNode* =
                    new CallExprNode(member as ExpressionNode*, span);
                call.add_argument(ref_right);
                left = call as ExpressionNode*;
            } else if (op.kind == TokenType::DotDot ||
                       op.kind == TokenType::DotDotEq) {
                // `a..b`  => `Range::new(a, b)`
                // `a..=b` => `RangeInclusive::new(a, b)`.  The range types
                // are stdlib (`std::core::ops`); sema/codegen never see a
                // dedicated range operator, just a static constructor call.
                const ctor_scope: SymbolStr = this.ctx.intern(
                    if (op.kind == TokenType::DotDotEq) {
                        "RangeInclusive"
                    } else {
                        "Range"
                    });
                const new_name: SymbolStr = this.ctx.intern("new");
                const sr: ScopeResolutionNode* = new ScopeResolutionNode(
                    ctor_scope, new_name, span);
                mut call: CallExprNode* =
                    new CallExprNode(sr as ExpressionNode*, span);
                call.add_argument(left);
                call.add_argument(right);
                left = call as ExpressionNode*;
            } else {
                left = new BinaryExprNode(op, left, right, span);
            }
        }

        return left;
    }

    /// Parse cast expression: unary ( 'as' type )*
    parse_cast() -> ExpressionNode* {
        mut expr: ExpressionNode* = this.parse_unary();
        if (expr == null || this.panic_mode) { return expr; }

        while (this.check(TokenType::KwAs)) {
            this.advance();
            // `as const T*` casts to a pointer-to-const; the const binds to the
            // first pointer suffix (threaded via parse_type_suffixes_q).
            mut pending_const: boolean = false;
            if (this.check(TokenType::KwConst)) {
                this.advance();
                pending_const = true;
            }
            // Parse base type first, then selectively apply suffixes.
            // This resolves the ambiguity: `x as u64 * 8` should be
            // (x as u64) * 8, not x as (u64*) followed by orphaned 8.
            // We consume * as pointer suffix only if it's NOT followed
            // by a token that could start an expression (number, ident, etc.).
            mut target: TypeAnnotation* = this.parse_base_type();
            if (target == null) {
                this.report_error(ErrorCode::E0104_EXPECTED_TYPE,
                    "expected type after 'as'");
                return expr;
            }
            // Apply pointer/array suffixes only when * is not an operator.
            // Disambiguate: `x as u64 * 8` -> (x as u64) * 8, not x as (u64*)
            // Heuristic: * is a pointer suffix if followed by a non-expression
            // token (;  )  }  ]  ,  as  EOF).  Otherwise it's multiplication.
            if (this.check(TokenType::Star) && this.is_star_pointer_suffix()) {
                target = this.parse_type_suffixes_q(target, pending_const);
            } else if (!this.check(TokenType::Star)) {
                // Non-star suffixes ([], ?) are unambiguous
                target = this.parse_type_suffixes_q(target, pending_const);
            }
            const span: SourceSpan = ParserBase::merge_spans(expr.span, this.current_span());
            expr = new CastExprNode(expr, target, span);
        }

        return expr;
    }

    /// Parse unary prefix expression.
    /// unary = ( '-' | '!' | '*' | '&' | '~' | '++' | '--' ) unary | postfix
    parse_unary() -> ExpressionNode* {
        if (this.current().kind.is_unary_prefix_op()) {
            // Guard against unbounded recursion on pathological prefix
            // chains like `----...x` / `!!!...x`: each operator recurses
            // through parse_unary with no bracket token for advance() to
            // count, so a few hundred thousand levels overflow the native
            // stack and crash the compiler.  256 is far beyond any
            // realistic hand-written nesting; the check sits before
            // advance() so no token is consumed on the error path.
            if (this.unary_depth > 256) {
                this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                    "expression nesting too deep (unary-operator recursion limit exceeded)");
                return null;
            }
            const op: Token = this.advance();
            this.unary_depth += 1;
            const operand: ExpressionNode* = this.parse_unary();
            this.unary_depth -= 1;
            if (operand == null) {
                this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                    format("expected expression after unary '%s'", op.lexeme));
                return null;
            }
            const span: SourceSpan = ParserBase::merge_spans(
                this.span_from_token(op), operand.span);
            return new UnaryExprNode(op, operand, span);
        }

        return this.parse_primary_with_postfix();
    }


    // Primary + Postfix

    /// Parse a primary expression and then handle any postfix operations.
    parse_primary_with_postfix() -> ExpressionNode* {
        LOG_DEBUG(LogComponent::Parser, "[ExprParser] parse_primary_with_postfix()");
        mut expr: ExpressionNode* = this.parse_primary();
        if (expr == null || this.panic_mode) { return expr; }
        return this.parse_postfix(expr);
    }

    /// Parse postfix operations: call, index, member access, ++/--.
    parse_postfix(mut expr: ExpressionNode*) -> ExpressionNode* {
        while (true) {
            if (this.panic_mode || this.is_at_end()) { break; }

            if (this.check(TokenType::LParen)) {
                expr = this.parse_call_args(expr);
            } else if (this.check(TokenType::LSquare)) {
                expr = this.parse_array_access_expr(expr);
            } else if (this.check(TokenType::Period)) {
                expr = this.parse_member_access_expr(expr);
            } else if (this.check(TokenType::Arrow)) {
                // Pointer member access (treat like member access)
                this.advance();
                const member_tok: Token       = this.consume(TokenType::Identifier, "member name");
                const member: SymbolStr       = this.intern_lexeme(member_tok);
                const member_span: SourceSpan = this.span_from_token(member_tok);
                const span: SourceSpan        = ParserBase::merge_spans(expr.span, member_span);

                // First dereference, then member access
                const deref_op: Token        = Token::new(TokenType::Star, "*", member_tok.line, member_tok.column);
                const deref: ExpressionNode* = new UnaryExprNode(deref_op, expr, expr.span);

                expr = new MemberAccessNode(deref, member, member_span, span);
            } else if (this.check(TokenType::ColonColon)) {
                // Scope resolution.  For chained paths like `alpha::utils::run`,
                // join the prior `ScopeResolutionNode`'s scope and member into
                // a single dotted scope name so the full qualifier is
                // preserved on the new node.  Without this, the parser
                // collapses `alpha::utils::run` to a node whose `scope_name`
                // is just `utils`, losing the `alpha` prefix and making it
                // indistinguishable from a shorthand `utils::run`, which
                // breaks both the codegen module-graph walk and the
                // E0154 ambiguity detector.
                this.advance();
                mut scope_name: SymbolStr = SymbolStr::empty();
                if (expr.kind == NodeKind::ScopeResolution) {
                    const psr: ScopeResolutionNode* = expr as ScopeResolutionNode*;
                    const scope_part: string  = this.ctx.intern_table.resolve(psr.scope_name);
                    const member_part: string = this.ctx.intern_table.resolve(psr.member_name);
                    if (strlen(scope_part) > 0) {
                        scope_name = this.ctx.intern_table.intern(
                            format("%s::%s", scope_part, member_part));
                    } else {
                        scope_name = psr.member_name;
                    }
                } else {
                    scope_name = this.get_expr_name(expr);
                }
                const no_gen_args: TypeAnnotation*[] = [];
                expr = this.parse_scope_member(scope_name, no_gen_args, expr.span);
            } else if (this.check(TokenType::LBrace)
                       && expr.kind == NodeKind::ScopeResolution
                       && this.is_struct_literal_ahead()) {
                // Qualified struct literal at the tail of a *deep* scope path
                // (`A::B::C::Type { ... }`).  The 2-segment case is handled in
                // `parse_identifier_or_call`; this branch covers the longer
                // paths assembled by the `::` handling above.  Build the
                // literal under the fully-qualified `scope::member` name so
                // sema resolves the right type — without it the trailing
                // `{...}` was parsed against the bare scope name, skipping
                // field validation and miscompiling to garbage.  Mirrors the
                // bare-name path's `is_struct_literal_ahead()` guard, so it
                // adds no new ambiguity beyond what already applies there.
                const sr: ScopeResolutionNode* = expr as ScopeResolutionNode*;
                const scope_s: string  = this.ctx.intern_table.resolve(sr.scope_name);
                const member_s: string = this.ctx.intern_table.resolve(sr.member_name);
                const qname: SymbolStr = this.ctx.intern_table.intern(
                    format("%s::%s", scope_s, member_s));
                // Deep-clone the member generic args; `sr` owns its pointees.
                mut sl_gen: TypeAnnotation*[] = [];
                for (mut gi: i64 = 0; gi < sr.generic_args.length; gi++) {
                    sl_gen.push(TypeAnnotation::clone_ptr(sr.generic_args[gi]));
                }
                // Synthesize a start token from the scope path's span so the
                // literal's overall span covers `A::B::C::Type { ... }`.
                const start_tok: Token = Token::new(TokenType::Identifier, "",
                    expr.span.start_line as int, expr.span.start_col as int);
                expr = this.parse_struct_literal_body(qname, sl_gen, start_tok);
            } else if (this.check(TokenType::PlusPlus) || this.check(TokenType::MinusMinus)) {
                // Postfix increment/decrement.  Mark the node so codegen
                // returns the old (pre-update) value; prefix forms (handled
                // in parse_unary) leave is_postfix=false and yield the
                // updated value.
                const op: Token        = this.advance();
                const span: SourceSpan = ParserBase::merge_spans(expr.span, this.span_from_token(op));
                mut un: UnaryExprNode* = new UnaryExprNode(op, expr, span);
                un.is_postfix = true;
                expr = un;
            } else if (this.check(TokenType::Question)
                       && this.peek_at(1).kind.question_terminates()) {
                // Postfix try operator `expr?`.  The lookahead distinguishes
                // it from the ternary `?` (which `parse_conditional`, our
                // caller, handles; see `try_question_terminates`.  The
                // operand may itself be a try (`a()?` then more postfix),
                // so the loop continues.  Sema lowers this to the
                // equivalent `match` once the operand's type is known.
                const op: Token        = this.advance();
                const span: SourceSpan = ParserBase::merge_spans(expr.span, this.span_from_token(op));
                expr = new TryExprNode(expr, span);
            } else {
                break;
            }
        }
        return expr;
    }


    // Primary Expressions

    /// Parse a primary expression (literals, identifiers, grouping, etc.).
    parse_primary() -> ExpressionNode* {
        LOG_DEBUG(LogComponent::Parser, "[ExprParser] parse_primary() token='%s'", this.current().lexeme);
        if (this.panic_mode || this.is_at_end()) { return null; }

        const tok: Token = this.current();

        if (tok.kind == TokenType::NumericConstant) {
            return this.parse_number_literal();
        }

        if (tok.kind == TokenType::StringLiteral) {
            return this.parse_string_literal();
        }

        if (tok.kind == TokenType::FStringLiteral) {
            return this.parse_fstring();
        }

        if (tok.kind == TokenType::CharConstant) {
            return this.parse_char_literal();
        }

        if (tok.kind == TokenType::KwTrue || tok.kind == TokenType::KwFalse) {
            const btok: Token = this.advance();
            const value: string = btok.lexeme;
            return new LiteralNode(value, LiteralKind::Boolean, this.span_from_token(btok));
        }

        if (tok.kind == TokenType::KwNull) {
            const ntok: Token = this.advance();
            return new LiteralNode("null", LiteralKind::Null, this.span_from_token(ntok));
        }

        if (tok.kind == TokenType::KwThis) {
            const ttok: Token = this.advance();
            const name: SymbolStr = this.intern_lexeme(ttok);
            return new IdentifierNode(name, this.span_from_token(ttok));
        }

        if (tok.kind == TokenType::KwIf) {
            return this.parse_if_expression();
        }

        // `static match (T) { ... }` in expression position (e.g.
        // `return static match (T) {...}`). Checked before any bare-`match`
        // path; `static` alone never starts an expression otherwise.
        if (tok.kind == TokenType::KwStatic && this.peek_at(1).kind == TokenType::KwMatch) {
            return this.parse_static_match_expression();
        }

        if (tok.kind == TokenType::KwMatch) {
            return this.parse_match_expression();
        }

        if (tok.kind == TokenType::KwNew) {
            return this.parse_new_expression();
        }

        if (tok.kind == TokenType::KwSizeof) {
            return this.parse_sizeof_expression();
        }

        if (tok.kind == TokenType::KwAlignof) {
            return this.parse_alignof_expression();
        }

        // Typeof expression: typeof(expr)
        if (tok.kind == TokenType::KwTypeof) {
            return this.parse_typeof_expression();
        }

        // Delete expression: delete expr
        if (tok.kind == TokenType::KwDelete) {
            return this.parse_delete_expression();
        }

        // Await expression: await expr
        if (tok.kind == TokenType::KwAwait) {
            return this.parse_await_expression();
        }

        // Yield expression: yield [expr]
        if (tok.kind == TokenType::KwYield) {
            return this.parse_yield_expression();
        }

        if (tok.kind == TokenType::LSquare) {
            return this.parse_array_literal();
        }

        // 'move' lambda prefix: `move (params) -> T { body }`.  Opts
        // the closure into capture-by-move semantics: non-Copy captures
        // are permitted and become move sites on the outer binding;
        // the synthesized closure struct gets a Drop that drops each
        // non-Copy field.  Bare `move` (not followed by a lambda) is
        // a parse error.
        if (tok.kind == TokenType::KwMove) {
            const move_tok: Token = this.advance();
            if (!this.check(TokenType::LParen)) {
                this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                    "expected '(' after 'move' to begin lambda parameter list");
                return null;
            }
            mut inner: ExpressionNode* = this.parse_paren_expr_or_lambda();
            if (inner == null) { return null; }
            if (inner.kind != NodeKind::LambdaExpression) {
                this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                    "'move' must be followed by a lambda expression");
                return null;
            }
            mut lambda: LambdaExprNode* = inner as LambdaExprNode*;
            lambda.is_move = true;
            lambda.span    = this.span_from(move_tok);
            return lambda;
        }

        // Parenthesized expression, tuple, or lambda
        if (tok.kind == TokenType::LParen) {
            return this.parse_paren_expr_or_lambda();
        }

        // Identifier (including scope resolution, generic calls, struct literals)
        if (tok.kind == TokenType::Identifier) {
            return this.parse_identifier_or_call();
        }

        // Primitive type used as identifier (e.g., i32::max_value())
        if (this.is_primitive_type_token()) {
            const ptok: Token = this.advance();
            const name: SymbolStr = this.intern_lexeme(ptok);
            return new IdentifierNode(name, this.span_from_token(ptok));
        }

        // Any remaining keyword used as identifier (for built-in function names, etc.)
        if (tok.kind.is_keyword()) {
            const ktok: Token = this.advance();
            const name: SymbolStr = this.intern_lexeme(ktok);
            return new IdentifierNode(name, this.span_from_token(ktok));
        }

        this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
            format("expected expression, found '%s'", tok.lexeme));
        return null;
    }


    // Primary Helpers

    /// Parse a numeric literal.
    parse_number_literal() -> ExpressionNode* {
        const tok: Token = this.advance();
        // Determine if float or integer by checking for '.' or 'e'/'E'
        // Special base literals (0x, 0b, 0o) are always integers.
        mut kind: LiteralKind = LiteralKind::Integer;
        mut is_special_base: boolean = false;
        if (tok.lexeme.length() >= 2) {
            if (tok.lexeme[0] == '0') {
                const p: char = tok.lexeme[1];
                if (p == 'x' || p == 'X' || p == 'b' || p == 'B' || p == 'o' || p == 'O') {
                    is_special_base = true;
                }
            }
        }
        if (!is_special_base) {
            for (mut i: int = 0; i < tok.lexeme.length(); i++) {
                const c: char = tok.lexeme[i];
                if (c == '.' || c == 'e' || c == 'E') {
                    kind = LiteralKind::Float;
                    break;
                }
            }
        }
        return new LiteralNode(tok.lexeme, kind, this.span_from_token(tok));
    }

    /// Parse a string literal.
    parse_string_literal() -> ExpressionNode* {
        const tok: Token = this.advance();
        return new LiteralNode(tok.lexeme, LiteralKind::String, this.span_from_token(tok));
    }

    /// Parse a character literal.
    parse_char_literal() -> ExpressionNode* {
        const tok: Token = this.advance();
        return new LiteralNode(tok.lexeme, LiteralKind::Char, this.span_from_token(tok));
    }

    /// Parse an f-string `f"...{expr}...{expr:?}..."` and desugar it, here
    /// in the parser, into a chain of `fmt_*` builder calls that produce an
    /// owned `String`.  See `std::fmt::interp` for the runtime the chain
    /// targets and the desugar shape.
    ///
    /// Display vs Debug is chosen purely by the hole's format spec (`{}` ->
    /// Display, `{:?}` -> Debug), which is fully known here at parse time,
    /// so the entire desugar is built now and the rest of the pipeline only
    /// ever sees ordinary calls.  Each generic `fmt_append_display`/`_debug`
    /// call has its `T` inferred from the `&expr` argument by the
    /// monomorphizer, exactly like a hand-written `format_to_string(&x)`;
    /// building the chain pre-monomorphization is what makes that work.
    ///
    /// `{{` / `}}` are literal braces; standard escapes (`\n`, `\t`, ...) in
    /// the literal chunks are processed via the same routine as plain
    /// strings.  Only `{}` and `{:?}` specs are recognised for now.
    parse_fstring() -> ExpressionNode* {
        const tok: Token = this.advance();
        this.used_fstring = true;
        // Stash the span so the desugar helpers can read it from a field
        // rather than taking it as a by-value struct parameter.
        this.fstr_span = this.span_from_token(tok);
        const raw: string = tok.lexeme;
        const len: i64 = libc::strlen(raw) as i64;

        // acc := fmt_new()
        mut acc: ExpressionNode* = this.fstr_call0("fmt_new");

        // Literal runs are tracked as `[chunk_start, i)` index ranges into
        // `raw` and materialised with `substr` — no manual byte buffer.  A
        // `{{` / `}}` escape flushes the run up to and including the first
        // brace, then skips the second, so the literal brace survives.
        mut chunk_start: i64 = 0;
        mut i: i64 = 0;
        while (i < len) {
            const c: char = *(raw + i) as char;

            if (c == '{') {
                if (i + 1 < len && (*(raw + i + 1) as char) == '{') {
                    // `{{`: flush through the first brace, skip the second.
                    acc = this.fstr_flush_range(acc, raw, chunk_start, i + 1);
                    chunk_start = i + 2;
                    i += 2;
                    continue;
                }
                // Hole: flush the literal run before it.
                acc = this.fstr_flush_range(acc, raw, chunk_start, i);

                // Scan to the matching '}', tracking brace depth and
                // skipping string/char literals so braces inside them
                // (e.g. `foo("}")`) don't terminate the hole early.
                mut depth: i64 = 0;
                mut j: i64 = i + 1;
                mut closed: boolean = false;
                while (j < len) {
                    const cj: char = *(raw + j) as char;
                    if (cj == '"' || cj == '\'') {
                        j = this.fstr_skip_quoted(raw, len, j, cj);
                        continue;
                    }
                    if (cj == '{') {
                        depth += 1;
                    } else if (cj == '}') {
                        if (depth == 0) { closed = true; break; }
                        depth -= 1;
                    }
                    j += 1;
                }
                if (!closed) {
                    this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                        "unterminated `{` in f-string");
                    return acc;
                }

                const hole_len: i64 = j - (i + 1);
                const hole_src: string = raw.substr(i + 1, hole_len);

                // Split off a trailing `:?` Debug spec, if present.
                const tl: i64 = this.fstr_rstrip_len(hole_src);
                const is_debug: boolean = this.fstr_spec_is_debug(hole_src, tl);
                mut expr_src: string = hole_src;
                if (is_debug) {
                    expr_src = hole_src.substr(0, tl - 2);
                }

                const inner: ExpressionNode* = this.fstr_parse_hole(expr_src);
                chunk_start = j + 1; // literal run resumes past the closing '}'
                i = j + 1;
                if (inner == null) {
                    this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                        "expected an expression inside f-string `{...}`");
                    continue;
                }
                // &inner: synthetic address-of, exempt from the user-facing
                // no-address-of-a-literal check (E0223) so `f"{42}"` works.
                const amp: Token = Token::new(TokenType::Amp, "&", tok.line, tok.column);
                mut ref_node: UnaryExprNode* = new UnaryExprNode(amp, inner, this.fstr_span);
                ref_node.is_synthetic = true;

                const helper: string =
                    if (is_debug) { "fmt_append_debug" } else { "fmt_append_display" };
                acc = this.fstr_call2(helper, acc, ref_node as ExpressionNode*);
                continue;
            }

            if (c == '}') {
                if (i + 1 < len && (*(raw + i + 1) as char) == '}') {
                    // `}}`: flush through the first brace, skip the second.
                    acc = this.fstr_flush_range(acc, raw, chunk_start, i + 1);
                    chunk_start = i + 2;
                    i += 2;
                    continue;
                }
                this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                    "unmatched `}` in f-string (write `}}` for a literal brace)");
                return acc;
            }

            i += 1;
        }

        // Flush the trailing literal run.
        acc = this.fstr_flush_range(acc, raw, chunk_start, len);
        return acc;
    }

    /// Flush the literal run `raw[start, end)` into `acc` as a
    /// `fmt_append_lit(acc, "<escape-processed>")` call.  No-op when empty.
    /// Uses `this.fstr_span` for synthesized node spans.
    fstr_flush_range(acc: ExpressionNode*, raw: string,
                     start: i64, end: i64) -> ExpressionNode* {
        if (end <= start) { return acc; }
        const text_raw: string = raw.substr(start, end - start);
        const text: string = Lexer::process_escape_sequences(text_raw);
        const lit: LiteralNode* = new LiteralNode(text, LiteralKind::String, this.fstr_span);
        return this.fstr_call2("fmt_append_lit", acc, lit as ExpressionNode*);
    }

    /// Build a zero-argument free-function call `name()`.
    fstr_call0(name: string) -> ExpressionNode* {
        const id: IdentifierNode* = new IdentifierNode(this.ctx.intern(name), this.fstr_span);
        mut call: CallExprNode* = new CallExprNode(id as ExpressionNode*, this.fstr_span);
        return call as ExpressionNode*;
    }

    /// Build a two-argument free-function call `name(a, b)`.
    fstr_call2(name: string, a: ExpressionNode*, b: ExpressionNode*) -> ExpressionNode* {
        const id: IdentifierNode* = new IdentifierNode(this.ctx.intern(name), this.fstr_span);
        mut call: CallExprNode* = new CallExprNode(id as ExpressionNode*, this.fstr_span);
        call.add_argument(a);
        call.add_argument(b);
        return call as ExpressionNode*;
    }

    /// Sub-lex and parse a hole's source text as a standalone expression.
    /// Reuses the full expression grammar (so `f"{a + b.c()}"` parses
    /// correctly) by lexing the hole into its own token stream and handing
    /// it to a fresh sub-parser via `parse_expr_from_tokens` (overridden on
    /// the concrete `Parser`).  A separate parser is used so the hole's
    /// tokens never displace this parser's own (owned) token stream.
    fstr_parse_hole(src: string) -> ExpressionNode* {
        mut lx: Lexer = Lexer::new("<fstring>", src, this.ctx.diagnostics);
        const hole_toks: Token[] = lx.lex();
        return this.parse_expr_from_tokens(hole_toks);
    }

    /// Length of `s` with trailing ASCII whitespace trimmed.
    fstr_rstrip_len(s: string) -> i64 {
        mut n: i64 = libc::strlen(s) as i64;
        while (n > 0) {
            const ch: char = *(s + n - 1) as char;
            if (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r') {
                n -= 1;
            } else {
                break;
            }
        }
        return n;
    }

    /// True if the hole text `s` (whose trimmed length is `tl`) ends with a
    /// `:?` Debug spec.  Early-returns keep the `s + tl - 2` deref guarded by
    /// the length check without relying on `&&` short-circuit evaluation.
    fstr_spec_is_debug(s: string, tl: i64) -> boolean {
        if (tl < 2) { return false; }
        const c2: char = *(s + tl - 2) as char;
        const c1: char = *(s + tl - 1) as char;
        return c2 == ':' && c1 == '?';
    }

    /// Advance past a string/char literal in a hole scan.  `j` indexes the
    /// opening quote `q`; returns the index just past the closing quote (or
    /// end-of-template if unterminated, leaving the outer scan to fail).
    fstr_skip_quoted(src: string, len: i64, j: i64, q: char) -> i64 {
        mut k: i64 = j + 1;
        while (k < len) {
            const ck: char = *(src + k) as char;
            if (ck == '\\') { k += 2; continue; }
            if (ck == q) { return k + 1; }
            k += 1;
        }
        return k;
    }

    /// Parse an identifier, handling scope resolution, generic calls, and struct literals.
    parse_identifier_or_call() -> ExpressionNode* {
        const tok: Token = this.advance();
        const name: SymbolStr = this.intern_lexeme(tok);
        mut expr: ExpressionNode* = new IdentifierNode(name, this.span_from_token(tok));

        // Check for generic args: Name<T, U>
        if (this.check(TokenType::LAngle) && this.is_generic_call_ahead()) {
            const gen_args: TypeAnnotation*[] = this.parse_generic_args();

            // After generic args, check what follows
            if (this.check(TokenType::LParen)) {
                // Generic function call: func<T>(args)
                // Check if uppercase first char -> struct constructor
                if (tok.lexeme.length() > 0 && tok.lexeme[0] >= 'A' && tok.lexeme[0] <= 'Z') {
                    // Could be struct constructor or function call; check for '{'
                    // For now treat all Name<T>(...) as call
                }
                mut call: CallExprNode* = new CallExprNode(expr, expr.span);
                call.set_generic_args(gen_args);
                this.advance(); // consume '('
                if (!this.check(TokenType::RParen)) {
                    while (true) {
                        const arg: ExpressionNode* = this.parse_expression();
                        if (arg != null) {
                            call.add_argument(arg);
                        }
                        if (!this.match_tok(TokenType::Comma)) {
                            break;
                        }
                    }
                }
                this.consume(TokenType::RParen, "')'");
                call.span = this.span_from(tok);
                return call;
            } else if (this.check(TokenType::LBrace)) {
                // Generic struct literal: Name<T> { field: value }
                return this.parse_struct_literal_body(name, gen_args, tok);
            } else if (this.check(TokenType::ColonColon)) {
                // Generic scope resolution: Name<T>::member
                this.advance(); // consume '::'
                expr = this.parse_scope_member(name, gen_args, this.span_from_token(tok));
            } else {
                // Generic args parsed but no `(`, `{`, or `::` follows: this is
                // a generic function-reference VALUE, e.g. `tramp<i32>` used as
                // a value (passed/cast/assigned, not called). Attach the args to
                // the identifier so the monomorphizer can instantiate the named
                // template for them and codegen can reference the specialized
                // symbol. `expr` is the IdentifierNode built at the top of this
                // routine; nothing else has consumed it yet.
                (expr as IdentifierNode*).set_generic_args(gen_args);
            }
            // Generic args parsed but nothing useful follows; just continue with postfix
        }

        // Check for scope resolution without generic args: Name::member
        if (this.check(TokenType::ColonColon)) {
            this.advance(); // consume '::'
            const no_gen_args: TypeAnnotation*[] = [];
            expr = this.parse_scope_member(name, no_gen_args, this.span_from_token(tok));
        }

        // Check for struct literal: Name { field: value }
        // Relies on structural heuristic (ident followed by '{' then 'field:' pattern)
        // rather than naming conventions, so lowercase type names work too.
        //
        // When a scope resolution was parsed above (`Module::Type`), `expr` is
        // a ScopeResolutionNode and `name` holds only the leading segment
        // ("Module"). A trailing struct-literal body must be built under the
        // *qualified* `Module::Type` name — otherwise sema resolves the literal
        // against the bare scope name, fails to find a type, skips field
        // validation, and codegen emits garbage. This is what makes
        // `ModB::Widget { ... }` work for same-leaf-name types in different
        // modules (member generic args carry through for `Module::Type<T> {}`).
        if (this.check(TokenType::LBrace) && this.is_struct_literal_ahead()) {
            mut lit_name: SymbolStr = name;
            mut lit_gen: TypeAnnotation*[] = [];
            if (expr.kind == NodeKind::ScopeResolution) {
                const sr: ScopeResolutionNode* = expr as ScopeResolutionNode*;
                const scope_s: string  = this.ctx.intern_table.resolve(sr.scope_name);
                const member_s: string = this.ctx.intern_table.resolve(sr.member_name);
                lit_name = this.ctx.intern_table.intern(
                    format("%s::%s", scope_s, member_s));
                // Deep-clone: `sr` owns its `generic_args` pointees; a shallow
                // alias would let both `sr` and the struct literal free the
                // same nodes. Mirrors the `new Type {}` clone at the heap path.
                for (mut gi: i64 = 0; gi < sr.generic_args.length; gi++) {
                    lit_gen.push(TypeAnnotation::clone_ptr(sr.generic_args[gi]));
                }
            }
            return this.parse_struct_literal_body(lit_name, lit_gen, tok);
        }

        return expr;
    }

    /// Check if what follows '{' looks like a struct literal (field: value pattern).
    is_struct_literal_ahead() -> boolean {
        // Look for pattern: { identifier : expr
        if (!this.check(TokenType::LBrace)) { return false; }
        const tok1: Token = this.peek_at(1);
        const tok2: Token = this.peek_at(2);
        if (tok1.kind == TokenType::Identifier && tok2.kind == TokenType::Colon) {
            return true;
        }
        // Shorthand field init: { ident , ... } or { ident }
        if (tok1.kind == TokenType::Identifier &&
            (tok2.kind == TokenType::Comma || tok2.kind == TokenType::RBrace)) {
            return true;
        }
        // Empty struct literal: {}
        if (tok1.kind == TokenType::RBrace) {
            return true;
        }
        return false;
    }

    /// Parse the body of a struct literal after the name and optional generic args.
    parse_struct_literal_body(name: SymbolStr, gen_args: TypeAnnotation*[], start: Token) -> ExpressionNode* {
        mut lit: StructLiteralNode* = new StructLiteralNode(name, this.span_from_token(start));
        if (gen_args.length > 0) {
            lit.set_generic_args(gen_args);
        }

        this.consume(TokenType::LBrace, "'{'");

        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            const field_tok: Token = this.consume(TokenType::Identifier, "field name");
            const field_name: SymbolStr = this.intern_lexeme(field_tok);

            // Shorthand field init: { field } is sugar for { field: field }
            mut value: ExpressionNode* = null;
            if (this.check(TokenType::Colon)) {
                this.advance(); // consume ':'
                value = this.parse_expression();
            } else {
                // Shorthand: create an identifier expression referencing the same name
                value = new IdentifierNode(field_name, this.span_from_token(field_tok));
            }

            const field_span: SourceSpan = this.span_from(field_tok);
            const init: FieldInit = FieldInit {
                field_name: field_name,
                value:      value,
                span:       field_span,
            };
            lit.add_field_init(init);

            if (!this.match_tok(TokenType::Comma)) {
                break;
            }
        }

        this.consume(TokenType::RBrace, "'}'");
        lit.span = this.span_from(start);
        return lit;
    }

    /// Parse parenthesized expression, tuple literal, or lambda.
    parse_paren_expr_or_lambda() -> ExpressionNode* {
        // Guard against unbounded recursion on pathological input like
        // `((((((...))))))`: each nested group recurses through
        // parse_expression, and a few thousand levels overflow the native
        // stack and crash the compiler.  `paren_depth` is maintained by
        // advance(); 256 is far beyond any realistic hand-written nesting.
        if (this.paren_depth > 256) {
            this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                "expression nesting too deep (parenthesis recursion limit exceeded)");
            return null;
        }
        const start: Token = this.advance(); // consume '('

        // Empty parens: () -> could be void or lambda params
        if (this.check(TokenType::RParen)) {
            this.advance();
            if (this.check(TokenType::Arrow)) {
                // Lambda with no parameters: () -> body
                return this.parse_lambda_after_params([], start);
            }
            // Void literal / unit value: create null literal
            return new LiteralNode("void", LiteralKind::Null, this.span_from(start));
        }

        // Check for lambda: (name: Type, ...) -> body
        // Lambda pattern: identifier ':' means parameter declaration
        if (this.check(TokenType::Identifier) && this.peek_at(1).kind == TokenType::Colon) {
            return this.parse_lambda_expression(start);
        }

        // Parse as expression (possibly tuple)
        const first: ExpressionNode* = this.parse_expression();
        if (first == null) {
            this.consume(TokenType::RParen, "')'");
            return null;
        }

        // Check for tuple: (expr, expr, ...)
        if (this.check(TokenType::Comma)) {
            mut tup: TupleLiteralNode* = new TupleLiteralNode(this.span_from_token(start));
            tup.add_element(first);
            while (this.match_tok(TokenType::Comma)) {
                if (this.check(TokenType::RParen)) { break; }
                const elem: ExpressionNode* = this.parse_expression();
                if (elem != null) {
                    tup.add_element(elem);
                }
            }
            this.consume(TokenType::RParen, "')'");
            tup.span = this.span_from(start);
            return tup;
        }

        // Parenthesized expression
        this.consume(TokenType::RParen, "')'");
        return first;
    }

    /// Parse a lambda starting from the parameter list (after '(' was consumed).
    /// Lambdas accept a stripped-down parameter form: `name` or `name: Type`,
    /// without `mut`, default values, or variadics. Kept inline (rather than
    /// delegating to Parser::parse_parameter_list) because ExprParser does
    /// not extend Parser and pulling the helper down would require either
    /// duplicating it on ParserBase or threading a Parser* through.
    parse_lambda_expression(start: Token) -> ExpressionNode* {
        mut params: VarDeclNode*[] = [];
        while (!this.check(TokenType::RParen) && !this.is_at_end()) {
            const name_tok: Token = this.consume(TokenType::Identifier, "parameter name");
            const pname: SymbolStr = this.intern_lexeme(name_tok);
            mut param: VarDeclNode* = new VarDeclNode(pname, this.span_from_token(name_tok));

            if (this.match_tok(TokenType::Colon)) {
                const ptype: TypeAnnotation* = this.parse_type_annotation();
                param.set_type_annotation(ptype);
            }

            params.push(param);
            if (!this.match_tok(TokenType::Comma)) {
                break;
            }
        }
        this.consume(TokenType::RParen, "')'");

        return this.parse_lambda_after_params(params, start);
    }

    /// Parse the rest of a lambda after its parameter list has been parsed.
    /// Handles both expression bodies and block bodies:
    ///   () -> T { return value; }   (block body)
    ///   () -> T expr                (expression body)
    ///   (x: A) -> C { ... }         (block body with params)
    parse_lambda_after_params(params: VarDeclNode*[], start: Token) -> ExpressionNode* {
        this.consume(TokenType::Arrow, "'->'");

        mut lambda: LambdaExprNode* = new LambdaExprNode(this.span_from_token(start));
        for (mut i: int = 0; i < params.length; i++) {
            lambda.add_parameter(params[i]);
        }

        // Parse return type annotation (everything before '{' or the expression).
        // The return type is between '->' and either '{' (block body) or the
        // expression start.  We parse a type annotation if the next token
        // looks like a type (identifier, keyword, paren for tuple/fn types).
        // If the next token is '{', there's no explicit return type.
        if (!this.check(TokenType::LBrace)) {
            // There's a return type before the body; store it for codegen.
            const ret_ann: TypeAnnotation* = this.parse_type_annotation();
            lambda.set_return_type_ann(ret_ann);
        }

        // Body: block body { ... }.  Cryo v1.0 requires a braced body for
        // every lambda.  A brace-less, single-expression form like
        // `(n: i32) -> i32 n * 2` used to be accepted by the parser but
        // codegen wrapped the body in an ExprStmt rather than a return -
        // so the lambda evaluated the expression and discarded it,
        // leaving a void-returning function in a non-void return slot
        // and producing a SIGSEGV at the first call.  Until the form
        // is properly desugared to `{ return expr; }`, reject it with a
        // clear diagnostic pointing at the braced form.
        if (this.check(TokenType::LBrace)) {
            const block_start: Token = this.current();
            // Route through the virtual `parse_inner_block` hook so Parser's
            // full-statement override (if/while/for/loop/match/switch/break/
            // continue, plus the const-mut-return-expr forms ExprParser can
            // handle on its own) takes effect.  At runtime `this` is a
            // Parser* whenever a top-down compile is in progress; the
            // ExprParser-only fallback (`parse_lambda_block_body` below) is
            // kept as the base for any standalone ExprParser instantiation.
            const block: BlockStmtNode* = this.parse_inner_block();
            lambda.set_body(block);
        } else {
            this.report_error(ErrorCode::E0108_EXPECTED_BRACE,
                "expected '{' to begin lambda body; the brace-less single-expression form is not supported in v1.0 - wrap the body in `{ return expr; }`");
            // Consume the candidate expression so we don't cascade into a
            // parse-recovery storm.  Wrap it as a discarded statement; the
            // E0108 above is the user-facing error.
            const body_expr: ExpressionNode* = this.parse_expression();
            if (body_expr != null) {
                const expr_stmt: ExprStmtNode* = new ExprStmtNode(body_expr, body_expr.span);
                const block: BlockStmtNode* = new BlockStmtNode(body_expr.span);
                block.add_statement(expr_stmt);
                lambda.set_body(block);
            }
        }

        lambda.span = this.span_from(start);
        return lambda;
    }

    /// Parse a lambda block body: { statement; statement; ... }
    /// Simplified block parser for ExprParser (can't call Parser's parse_block_statement).
    /// Handles return statements and expression statements.
    parse_lambda_block_body() -> BlockStmtNode* {
        const start: Token = this.advance(); // consume '{'
        mut block: BlockStmtNode* = new BlockStmtNode(this.span_from_token(start));

        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            // Return statement
            if (this.check(TokenType::KwReturn)) {
                const ret_start: Token = this.advance(); // consume 'return'
                mut ret_expr: ExpressionNode* = null;
                if (!this.check(TokenType::Semicolon) && !this.check(TokenType::RBrace)) {
                    ret_expr = this.parse_expression();
                }
                this.consume(TokenType::Semicolon, "';'");
                const ret: ReturnStmtNode* = new ReturnStmtNode(ret_expr, this.span_from(ret_start));
                block.add_statement(ret);
                continue;
            }

            // Variable declaration (const/mut)
            if (this.check(TokenType::KwConst) || this.check(TokenType::KwMut)) {
                const is_mut: boolean = this.check(TokenType::KwMut);
                const decl_start: Token = this.advance(); // consume const/mut
                const name_tok: Token = this.consume(TokenType::Identifier, "variable name");
                const vname: SymbolStr = this.intern_lexeme(name_tok);
                mut decl: VarDeclNode* = new VarDeclNode(vname, this.span_from_token(decl_start));
                decl.set_mutable(is_mut);
                decl.set_kw_span(this.span_from_token(decl_start));
                if (this.match_tok(TokenType::Colon)) {
                    decl.set_type_annotation(this.parse_type_annotation());
                }
                if (this.match_tok(TokenType::Equal)) {
                    decl.set_initializer(this.parse_expression());
                }
                this.consume(TokenType::Semicolon, "';'");
                const ds: DeclStmtNode* = new DeclStmtNode(decl, this.span_from(decl_start));
                block.add_statement(ds);
                continue;
            }

            // Expression statement
            const expr: ExpressionNode* = this.parse_expression();
            if (expr != null) {
                this.consume(TokenType::Semicolon, "';'");
                const es: ExprStmtNode* = new ExprStmtNode(expr, expr.span);
                block.add_statement(es);
            } else {
                this.error_unexpected();
                this.advance();
            }
        }

        this.consume(TokenType::RBrace, "'}'");
        block.span = this.span_from(start);
        return block;
    }

    /// Parse an array literal: [ expr, expr, ... ]
    parse_array_literal() -> ExpressionNode* {
        // BRACKET_DEPTH_LIMIT: nested array literals (`[[[...]]]`) recurse
        // through parse_expression for each element, overflowing the native
        // stack (SIGSEGV) on pathological depth. `bracket_depth` is maintained
        // by advance(); 256 is well past any realistic literal. report_error
        // sets panic_mode, so the caller unwinds without re-reading the `[`.
        if (this.bracket_depth > 256) {
            this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                "array-literal nesting too deep (recursion limit exceeded)");
            return null;
        }
        const start: Token = this.advance(); // consume '['
        mut arr: ArrayLiteralNode* = new ArrayLiteralNode(this.span_from_token(start));

        if (!this.check(TokenType::RSquare)) {
            const first: ExpressionNode* = this.parse_expression();
            if (first != null) {
                arr.add_element(first);

                // Check for repeat syntax: [value; count]
                if (this.check(TokenType::Semicolon)) {
                    this.advance();
                    const count_expr: ExpressionNode* = this.parse_expression();
                    if (count_expr != null) {
                        arr.set_repeat_count_expr(count_expr);
                    }
                } else {
                    // Regular array: [a, b, c]
                    while (this.match_tok(TokenType::Comma)) {
                        if (this.check(TokenType::RSquare)) { break; }
                        const elem: ExpressionNode* = this.parse_expression();
                        if (elem != null) {
                            arr.add_element(elem);
                        }
                    }
                }
            }
        }

        this.consume(TokenType::RSquare, "']'");
        arr.span = this.span_from(start);
        return arr;
    }

    /// Parse a new expression: new Type(args) or new Type[size]
    parse_new_expression() -> ExpressionNode* {
        const start: Token = this.advance(); // consume 'new'
        // The target type is usually a user-defined name (Identifier), but
        // `new T[n]` array allocation also accepts a primitive element type
        // whose name is a keyword (`new int[100]`, `new u8[1024]`).  Accept
        // either: a primitive keyword's lexeme ("int", "u8", ...) interns the
        // same way an identifier would, and resolve_new_expr falls back to
        // primitive resolution for it.
        mut type_tok: Token = this.current();
        if (this.is_primitive_type_token()) {
            this.advance();
        } else {
            type_tok = this.consume(TokenType::Identifier, "type name");
        }
        const type_name: SymbolStr = this.intern_lexeme(type_tok);
        mut node: NewExprNode* = new NewExprNode(type_name, this.span_from_token(start));

        // Optional generic args on the type: new Type<T>(...)
        // Scope `scope_gen_args` to this branch: it is moved into the node
        // unconditionally here and never read afterwards, so a branch-local
        // binding leaves nothing conditionally moved past the if.
        if (this.check(TokenType::LAngle) && this.is_generic_call_ahead()) {
            const scope_gen_args: TypeAnnotation*[] = this.parse_generic_args();
            node.set_generic_args(scope_gen_args);
        }

        // Enum variant construction: new EnumType::Variant(args)
        // The '::' means this is a heap-allocated enum variant, not a struct.
        // Consume the ::Variant(args) and store the variant name + arguments
        // on the NewExprNode.  Codegen reads variant_name to dispatch to
        // build_enum_variant; without it, the class-`new` path would just
        // malloc and return uninitialized memory, leaving every callsite
        // with a TypeAnnotation pointer whose tag/payload bytes look like
        // glibc bin-head pointers (the original Bug #15 symptom).
        if (this.check(TokenType::ColonColon)) {
            this.advance(); // consume '::'
            // Consume the variant name (identifier or keyword like 'new')
            if (this.check(TokenType::Identifier) || this.current().kind.is_keyword()) {
                const variant_tok: Token = this.advance();
                node.set_variant_name(this.intern_lexeme(variant_tok));
            }
            // Parse call arguments: new Enum::Variant(payload)
            if (this.check(TokenType::LParen)) {
                this.advance();
                if (!this.check(TokenType::RParen)) {
                    while (true) {
                        const arg: ExpressionNode* = this.parse_expression();
                        if (arg != null) {
                            node.add_argument(arg);
                        }
                        if (!this.match_tok(TokenType::Comma)) {
                            break;
                        }
                    }
                }
                this.consume(TokenType::RParen, "')'");
            }
            node.span = this.span_from(start);
            return node;
        }

        if (this.check(TokenType::LParen)) {
            // Constructor call: new Type(args)
            this.advance();
            if (!this.check(TokenType::RParen)) {
                while (true) {
                    const arg: ExpressionNode* = this.parse_expression();
                    if (arg != null) {
                        node.add_argument(arg);
                    }
                    if (!this.match_tok(TokenType::Comma)) {
                        break;
                    }
                }
            }
            this.consume(TokenType::RParen, "')'");
        } else if (this.check(TokenType::LBrace)) {
            // Heap-allocated struct literal: new Type { field: value, ... }
            // Parse the struct literal body and attach it to the NewExprNode
            // so sema knows to return a pointer type.
            // Independent DEEP copy: `TypeAnnotation*[]` owns its pointees
            // (drop frees each node, like `ASTCloner::clone_type_annotations`),
            // so the struct literal must get its own cloned nodes — a shallow
            // pointer copy would let both arrays free the same nodes.
            mut gen: TypeAnnotation*[] = [];
            for (mut gi: i64 = 0; gi < node.generic_args.length; gi++) { gen.push(TypeAnnotation::clone_ptr(node.generic_args[gi])); }
            const lit: StructLiteralNode* = this.parse_struct_literal_body(type_name, gen, start) as StructLiteralNode*;
            node.struct_init = lit;
            node.span = this.span_from_token(start);
            return node;
        } else if (this.check(TokenType::LSquare)) {
            // Array allocation: new Type[size]
            this.advance();
            const size_expr: ExpressionNode* = this.parse_expression();
            if (size_expr != null) {
                node.set_array_size(size_expr);
            }
            this.consume(TokenType::RSquare, "']'");
        }

        node.span = this.span_from(start);
        return node;
    }

    /// Parse sizeof(Type): supports qualified names and generic args.
    /// sizeof(Foo), sizeof(Foo::Bar), sizeof(RcControlBlock<T>)
    parse_sizeof_expression() -> ExpressionNode* {
        const start: Token = this.advance(); // consume 'sizeof'
        this.consume(TokenType::LParen, "'('");
        const type_tok: Token = this.current();
        const type_name: SymbolStr = this.intern_lexeme(type_tok);
        const type_span: SourceSpan = this.span_from_token(type_tok);

        // Parse the full type expression (with generics, references, etc.)
        // and stash it on the node so that monomorphization can substitute
        // generic params and type_resolution can produce a concrete
        // resolved_type for codegen.  Without this, `sizeof(HashMapEntry<K, V>)`
        // collapses to bare `HashMapEntry` at codegen and the spec lookup fails.
        const ann: TypeAnnotation* = this.parse_type_annotation();

        this.consume(TokenType::RParen, "')'");
        const node: SizeofExprNode* = new SizeofExprNode(type_name, type_span, this.span_from(start));
        if (ann != null) { node.set_type_ann(ann); }
        return node;
    }

    /// Parse alignof(Type): supports qualified names and generic args.
    parse_alignof_expression() -> ExpressionNode* {
        const start: Token = this.advance(); // consume 'alignof'
        this.consume(TokenType::LParen, "'('");
        const type_tok: Token = this.current();
        const type_name: SymbolStr = this.intern_lexeme(type_tok);
        const type_span: SourceSpan = this.span_from_token(type_tok);

        // Parse the full type expression; see parse_sizeof_expression for
        // why we don't just consume and discard the generic args.
        const ann: TypeAnnotation* = this.parse_type_annotation();

        this.consume(TokenType::RParen, "')'");
        const node: AlignofExprNode* = new AlignofExprNode(type_name, type_span, this.span_from(start));
        if (ann != null) { node.set_type_ann(ann); }
        return node;
    }

    /// Parse typeof(expr)
    parse_typeof_expression() -> ExpressionNode* {
        const start: Token = this.advance(); // consume 'typeof'
        this.consume(TokenType::LParen, "'('");
        const operand: ExpressionNode* = this.parse_expression();
        this.consume(TokenType::RParen, "')'");
        return new TypeofExprNode(operand, this.span_from(start));
    }

    /// Parse delete expr
    parse_delete_expression() -> ExpressionNode* {
        const start: Token = this.advance(); // consume 'delete'
        const operand: ExpressionNode* = this.parse_unary();
        return new DeleteExprNode(operand, this.span_from(start));
    }

    /// Parse await expr
    parse_await_expression() -> ExpressionNode* {
        const start: Token = this.advance(); // consume 'await'
        const operand: ExpressionNode* = this.parse_unary();
        return new AwaitExprNode(operand, this.span_from(start));
    }

    /// Parse yield [expr]: value is optional (bare yield)
    parse_yield_expression() -> ExpressionNode* {
        const start: Token = this.advance(); // consume 'yield'
        mut operand: ExpressionNode* = null;
        // yield without value if followed by ; or }
        if (!this.check(TokenType::Semicolon) && !this.check(TokenType::RBrace)) {
            operand = this.parse_expression();
        }
        return new YieldExprNode(operand, this.span_from(start));
    }

    /// Parse a parenthesized condition: '(' expression ')'.
    /// Shared by if, match, while, switch, and do-while parsing.
    parse_paren_condition() -> ExpressionNode* {
        this.consume(TokenType::LParen, "'('");
        const expr: ExpressionNode* = this.parse_expression();
        this.consume(TokenType::RParen, "')'");
        return expr;
    }

    /// Parse if expression: if (cond) { then } else { else }
    parse_if_expression() -> ExpressionNode* {
        const start: Token = this.advance(); // consume 'if'
        const condition: ExpressionNode* = this.parse_paren_condition();

        // Then branch: expect a block with a single expression
        this.consume(TokenType::LBrace, "'{'");
        const then_expr: ExpressionNode* = this.parse_expression();
        this.consume(TokenType::RBrace, "'}'");

        // Else branch
        mut else_expr: ExpressionNode* = null;
        if (this.match_tok(TokenType::KwElse)) {
            this.consume(TokenType::LBrace, "'{'");
            else_expr = this.parse_expression();
            this.consume(TokenType::RBrace, "'}'");
        }

        const span: SourceSpan = this.span_from(start);
        return new IfExprNode(condition, then_expr, else_expr, span);
    }

    /// Parse match expression: match (subject) { arms }
    parse_match_expression() -> ExpressionNode* {
        const start: Token = this.advance(); // consume 'match'
        const subject: ExpressionNode* = this.parse_paren_condition();
        this.consume(TokenType::LBrace, "'{'");

        mut match_expr: MatchExprNode* = new MatchExprNode(subject, this.span_from_token(start));

        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            const before_pos: int = this.pos;
            const arm: MatchArmNode* = this.parse_expr_match_arm();
            if (arm != null) {
                match_expr.add_arm(arm);
            }
            if (this.panic_mode) {
                this.synchronize();
            }
            // Progress guard: synchronize() stops at statement-start tokens
            // without advancing.  Without this, a malformed scrutinee can
            // leave the cursor on a non-pattern token and we loop forever.
            if (this.pos == before_pos) {
                this.advance();
            }
        }

        this.consume(TokenType::RBrace, "'}'");
        match_expr.span = this.span_from(start);
        return match_expr;
    }

    /// Parse static match expression: `static match (Type) { type-arms }`.
    /// The scrutinee and each arm's left-hand side are TYPE annotations
    /// (commonly the generic parameter `T`); a `_` arm is the wildcard
    /// default. Arm bodies parse exactly like regular match-expression arms.
    parse_static_match_expression() -> ExpressionNode* {
        const start: Token = this.advance(); // consume 'static'
        this.advance();                      // consume 'match'
        this.consume(TokenType::LParen, "'('");
        const scrutinee: TypeAnnotation* = this.parse_type_annotation();
        this.consume(TokenType::RParen, "')'");
        this.consume(TokenType::LBrace, "'{'");

        mut sm: StaticMatchExprNode* = new StaticMatchExprNode(
            scrutinee, this.span_from_token(start));

        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            const before_pos: int = this.pos;
            const arm: StaticMatchArmNode* = this.parse_static_match_arm();
            if (arm != null) {
                sm.add_arm(arm);
            }
            if (this.panic_mode) {
                this.synchronize();
            }
            if (this.pos == before_pos) {
                this.advance();
            }
        }

        this.consume(TokenType::RBrace, "'}'");
        sm.span = this.span_from(start);
        return sm;
    }

    /// Parse one static-match arm: `<type> => body` or `_ => body`. A `_`
    /// leaves `type_pattern` null (wildcard). Body is a block or a single
    /// expression wrapped in a block, mirroring parse_expr_match_arm.
    parse_static_match_arm() -> StaticMatchArmNode* {
        const start: Token = this.current();
        mut arm: StaticMatchArmNode* = new StaticMatchArmNode(
            this.span_from_token(start));

        if (this.check(TokenType::Identifier) && this.current().lexeme == "_") {
            this.advance(); // wildcard `_`; type_pattern stays null
        } else {
            const ty: TypeAnnotation* = this.parse_type_annotation();
            arm.set_type_pattern(ty);
        }

        this.consume(TokenType::FatArrow, "'=>'");

        if (this.check(TokenType::LBrace)) {
            const block: BlockStmtNode* = this.parse_inner_block();
            arm.set_body(block);
        } else {
            const body_expr: ExpressionNode* = this.parse_expression();
            if (body_expr != null) {
                const stmt: ExprStmtNode* = new ExprStmtNode(body_expr, body_expr.span);
                const block: BlockStmtNode* = new BlockStmtNode(body_expr.span);
                block.add_statement(stmt);
                arm.set_body(block);
            }
        }

        arm.span = this.span_from(start);
        return arm;
    }

    /// Parse match arm patterns and the '=>' arrow.
    /// Returns a MatchArmNode with patterns set but body NOT set.
    /// Shared between expression match (ExprParser) and statement match (Parser).
    parse_match_arm_patterns() -> MatchArmNode* {
        const start: Token = this.current();
        mut arm: MatchArmNode* = new MatchArmNode(this.span_from_token(start));

        // Parse pattern(s) separated by |
        while (true) {
            const pat: PatternNode* = this.parse_pattern_internal();
            if (pat != null) {
                arm.add_pattern(pat);
            }
            if (!this.match_tok(TokenType::Pipe)) {
                break;
            }
        }

        // Optional pattern guard: `pattern if (cond) => ...`. The condition is
        // parenthesized to match Cryo's `if`/`while`/`match` surface. A guard
        // applies to the whole arm (all OR-alternatives share it) and is
        // checked after the pattern matches; a false guard falls through to
        // the next arm (see sema/codegen).
        if (this.check(TokenType::KwIf)) {
            this.advance(); // consume 'if'
            const guard: ExpressionNode* = this.parse_paren_condition();
            arm.set_guard(guard);
        }

        this.consume(TokenType::FatArrow, "'=>'");
        return arm;
    }

    /// Parse a single match arm for expression context: pattern => expr.
    /// Uses shared parse_match_arm_patterns() for pattern + '=>', then
    /// handles the body as a single expression (possibly braced).
    /// See also: Parser::parse_match_arm() for statement context.
    parse_expr_match_arm() -> MatchArmNode* {
        const start: Token = this.current();
        mut arm: MatchArmNode* = this.parse_match_arm_patterns();

        // Body is either a block or a single expression.
        // Block bodies are parsed via parse_inner_block(), which Parser
        // overrides to support full statements (for, if, while, etc.).
        if (this.check(TokenType::LBrace)) {
            const block: BlockStmtNode* = this.parse_inner_block();
            arm.set_body(block);
        } else {
            const body_expr: ExpressionNode* = this.parse_expression();
            if (body_expr != null) {
                const stmt: ExprStmtNode* = new ExprStmtNode(body_expr, body_expr.span);
                const block: BlockStmtNode* = new BlockStmtNode(body_expr.span);
                block.add_statement(stmt);
                arm.set_body(block);
            }
        }

        arm.span = this.span_from(start);
        return arm;
    }

    /// Parse a variable declaration inside a match expression arm block.
    /// Handles: const name: Type = expr;  /  mut name = expr;
    /// Lightweight version that doesn't need full Parser::parse_declaration.
    parse_match_arm_var_decl() -> VarDeclNode* {
        const start: Token = this.current();
        const is_mutable: boolean = this.check(TokenType::KwMut);
        this.advance(); // consume const/mut

        const name_tok: Token = this.consume(TokenType::Identifier, "variable name");
        const name: SymbolStr = this.intern_lexeme(name_tok);
        mut node: VarDeclNode* = new VarDeclNode(name, this.span_from_token(start));
        node.set_mutable(is_mutable);
        node.set_name_span(this.span_from_token(name_tok));
        node.set_kw_span(this.span_from_token(start));

        // Optional type annotation: `: Type`
        if (this.match_tok(TokenType::Colon)) {
            node.set_type_annotation(this.parse_type_annotation());
        }

        // Optional initializer: `= expr`
        if (this.match_tok(TokenType::Equal)) {
            node.set_initializer(this.parse_expression());
        }

        this.match_tok(TokenType::Semicolon);
        node.span = this.span_from(start);
        return node;
    }

    /// Parse a pattern (internal, used by match expressions and statements).
    parse_pattern_internal() -> PatternNode* {
        const start: Token = this.current();

        // Wildcard: _
        if (this.check(TokenType::Identifier) && this.current().lexeme == "_") {
            this.advance();
            return new PatternNode(PatternKind::Wildcard, this.span_from(start));
        }

        // Enum pattern: EnumName::Variant or EnumName::Variant(bindings)
        if (this.check(TokenType::Identifier) && this.peek_at(1).kind == TokenType::ColonColon) {
            return this.parse_enum_pattern_internal();
        }

        // Literal pattern (number, string, char, bool)
        if (this.current().kind == TokenType::NumericConstant ||
            this.current().kind == TokenType::StringLiteral ||
            this.current().kind == TokenType::CharConstant ||
            this.current().kind == TokenType::KwTrue ||
            this.current().kind == TokenType::KwFalse) {
            const lit_tok: Token = this.advance();
            mut pat: PatternNode* = new PatternNode(PatternKind::Literal, this.span_from(start));
            pat.set_value(this.intern_lexeme(lit_tok));
            // Record which kind of literal this is.  Codegen cannot recover
            // it from the interned text alone; `0` and `'0'` both intern
            // to "0", `true`/`false` to "true"/"false", so without this
            // it would mis-emit single-digit ints as chars and bools as 0.
            pat.set_literal_kind(match (lit_tok.kind) {
                TokenType::NumericConstant => { LiteralKind::Integer }
                TokenType::StringLiteral   => { LiteralKind::String }
                TokenType::CharConstant    => { LiteralKind::Char }
                TokenType::KwTrue          => { LiteralKind::Boolean }
                TokenType::KwFalse         => { LiteralKind::Boolean }
                _                          => { LiteralKind::Integer }
            });
            return this.finish_range_pattern(pat);
        }

        // Negative number literal: -123
        if (this.check(TokenType::Minus) && this.peek_at(1).kind == TokenType::NumericConstant) {
            this.advance(); // consume '-'
            const lit_tok: Token = this.advance();
            const neg_value: string = "-" + lit_tok.lexeme;
            mut pat: PatternNode* = new PatternNode(PatternKind::Literal, this.span_from(start));
            pat.set_value(this.ctx.intern(neg_value));
            pat.set_literal_kind(LiteralKind::Integer);
            return this.finish_range_pattern(pat);
        }

        // Identifier pattern (binding)
        if (this.check(TokenType::Identifier)) {
            const id_tok: Token = this.advance();
            mut pat: PatternNode* = new PatternNode(PatternKind::Identifier, this.span_from(start));
            pat.set_binding_name(this.intern_lexeme(id_tok));
            return pat;
        }

        this.report_error(ErrorCode::E0113_INVALID_PATTERN,
            format("expected pattern, found '%s'", this.current().lexeme));
        return null;
    }

    /// If the next token is `..` or `..=`, extend a just-parsed literal
    /// pattern into an inclusive range pattern (matching `lo <= x <= hi`).
    /// Both spellings are accepted and both are inclusive in pattern
    /// position (`..=` is the explicit inclusive form; `..` is inclusive
    /// here too, unlike a range *expression* where `..` is exclusive).  The
    /// low bound is already in `pat` (its `value` + `literal_kind`); this
    /// consumes the operator and the high-bound literal, records the high
    /// text in `high_value`, and flips the kind to `Range`.  Returns `pat`
    /// unchanged when there is no range operator.
    ///
    /// Only integer and char literals form a range, and both ends must be
    /// the same kind: the two bounds share a single `literal_kind`, so a
    /// mixed `'a'..9` would make codegen decode one end with the wrong
    /// reader.  Such cases are rejected here rather than silently miscompiled.
    finish_range_pattern(mut &this, pat: PatternNode*) -> PatternNode* {
        if (!this.check(TokenType::DotDot)
            && !this.check(TokenType::DotDotEq)) { return pat; }

        if (pat.literal_kind != LiteralKind::Integer
            && pat.literal_kind != LiteralKind::Char) {
            this.report_error(ErrorCode::E0113_INVALID_PATTERN,
                "range patterns require integer or char bounds");
            return pat;
        }

        this.advance(); // consume '..' or '..='

        // High bound: an optional leading '-' then a numeric / char literal.
        mut neg: boolean = false;
        if (this.check(TokenType::Minus)) {
            this.advance();
            neg = true;
        }

        const hi_tok: Token = this.current();
        mut hi_kind: LiteralKind = LiteralKind::Integer;
        if (hi_tok.kind == TokenType::NumericConstant) {
            hi_kind = LiteralKind::Integer;
        } else if (hi_tok.kind == TokenType::CharConstant) {
            hi_kind = LiteralKind::Char;
        } else {
            this.report_error(ErrorCode::E0113_INVALID_PATTERN,
                format("expected a literal high bound after '..', found '%s'",
                       hi_tok.lexeme));
            return pat;
        }

        if (neg && hi_kind != LiteralKind::Integer) {
            this.report_error(ErrorCode::E0113_INVALID_PATTERN,
                "'-' is only valid before an integer range bound");
            return pat;
        }
        if (hi_kind != pat.literal_kind) {
            this.report_error(ErrorCode::E0113_INVALID_PATTERN,
                "range pattern bounds must be the same kind (both char or both integer)");
            return pat;
        }

        this.advance(); // consume the high-bound literal
        mut hi_text: string = hi_tok.lexeme;
        if (neg) { hi_text = "-" + hi_text; }
        pat.set_high_value(this.ctx.intern(hi_text));
        pat.set_pattern_kind(PatternKind::Range);
        return pat;
    }

    /// Parse an enum pattern: EnumName::Variant or EnumName::Variant(bindings)
    /// Also accepts namespace-qualified enum paths like
    /// `Protocol::JsonRpc::IncomingMessage::Request(req)`: every segment but
    /// the last is folded into the enum name (joined with `::`), and the
    /// final identifier becomes the variant name.  The match-arm consumer
    /// (sema) only needs the enum's resolved type; the joined string is
    /// purely for diagnostics.
    parse_enum_pattern_internal() -> PatternNode* {
        const start: Token = this.current();
        const first_tok: Token = this.advance(); // first identifier
        this.consume(TokenType::ColonColon, "'::'");
        mut variant_tok: Token = this.consume(TokenType::Identifier, "variant name");

        // Walk extra `::` segments.  Once we see `Foo::Bar`, if `Bar` is
        // followed by another `::` then `Bar` is just another namespace
        // segment and the *next* identifier is a candidate variant name.
        // Repeat until the lookahead is no longer `::`.
        mut enum_path: string = first_tok.lexeme;
        while (this.check(TokenType::ColonColon)) {
            enum_path = format("%s::%s", enum_path, variant_tok.lexeme);
            this.advance(); // consume '::'
            variant_tok = this.consume(TokenType::Identifier, "variant name");
        }

        mut pat: EnumPatternNode* = new EnumPatternNode(this.span_from_token(start));
        pat.set_enum_name(this.ctx.intern(enum_path));
        pat.set_variant_name(this.intern_lexeme(variant_tok));

        // Optional destructuring: Variant(a, b, _)
        if (this.check(TokenType::LParen)) {
            this.advance();
            while (!this.check(TokenType::RParen) && !this.is_at_end()) {
                // Optional `mut` modifier on a binding: purely syntactic
                // here; the binding itself is mutable when the matched arm
                // value is mutable (no separate AST flag needed).
                if (this.check(TokenType::KwMut)) {
                    this.advance();
                }
                if (this.current().lexeme == "_") {
                    const ws: SourceSpan = this.current_span();
                    this.advance();
                    const wc: PatternWildcard* = new PatternWildcard { span: ws };
                    pat.add_element(PatternElement::Wildcard(wc));
                } else if (this.check(TokenType::Identifier)
                        && this.peek_at(1).kind == TokenType::ColonColon) {
                    // Nested enum sub-pattern: `Some(Some(n))`,
                    // `Branch(Leaf(x), r)`. A qualified `Ident::...` element is
                    // itself an enum pattern; recurse and store it as a Sub
                    // element (sema/codegen destructure it level by level).
                    const sub: PatternNode* = this.parse_enum_pattern_internal();
                    const ps: PatternSub* = new PatternSub {
                        pattern: sub as void*,
                        span:    sub.span,
                    };
                    pat.add_element(PatternElement::Sub(ps));
                } else if (this.check(TokenType::Identifier) || this.current().kind.is_keyword()) {
                    const bind_tok: Token = this.advance();
                    const bs: SourceSpan = this.span_from_token(bind_tok);
                    const bn: SymbolStr = this.intern_lexeme(bind_tok);
                    const pb: PatternBinding* = new PatternBinding { name: bn, span: bs };
                    pat.add_element(PatternElement::Binding(pb));
                } else if (this.check(TokenType::NumericConstant)
                        || (this.check(TokenType::Minus)
                            && this.peek_at(1).kind == TokenType::NumericConstant)) {
                    mut sign: i64 = 1;
                    if (this.match_tok(TokenType::Minus)) { sign = -1; }
                    const num_tok: Token = this.advance();
                    const ns: SourceSpan = this.span_from_token(num_tok);
                    if (ParserBase::is_float_lexeme(num_tok.lexeme)) {
                        const fv: f64 = ParserBase::parse_numeric_lexeme_f64(
                            num_tok.lexeme);
                        const signed_fv: f64 = if (sign < 0) { 0.0 - fv } else { fv };
                        const pf: PatternLiteralFloat* = new PatternLiteralFloat {
                            value: signed_fv, span: ns,
                        };
                        pat.add_element(PatternElement::LiteralFloat(pf));
                    } else {
                        const iv: i64 = ParserBase::parse_numeric_lexeme_i64(
                            num_tok.lexeme);
                        const pi: PatternLiteralInt* = new PatternLiteralInt {
                            value: sign * iv, span: ns,
                        };
                        pat.add_element(PatternElement::LiteralInt(pi));
                    }
                } else {
                    this.report_error(ErrorCode::E0113_INVALID_PATTERN,
                        "expected binding, wildcard, or literal in enum pattern");
                    break;
                }

                if (!this.match_tok(TokenType::Comma)) {
                    break;
                }
            }
            this.consume(TokenType::RParen, "')'");
        }

        pat.span = this.span_from(start);
        return pat;
    }


    // Postfix Helpers

    /// Parse function call arguments: callee(arg1, arg2, ...)
    parse_call_args(callee: ExpressionNode*) -> CallExprNode* {
        // PAREN_DEPTH_LIMIT: nested calls (`f(f(f(...)))`) recurse through
        // parse_expression for each argument, overflowing the native stack
        // (SIGSEGV) on pathological depth. `paren_depth` is maintained by
        // advance(); 256 is well past any realistic call nesting. report_error
        // sets panic_mode, so parse_postfix breaks instead of re-reading `(`.
        if (this.paren_depth > 256) {
            this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                "call nesting too deep (recursion limit exceeded)");
            return null;
        }
        this.advance(); // consume '('
        mut call: CallExprNode* = new CallExprNode(callee, callee.span);

        // If the callee is a member access whose name carried explicit type
        // arguments (`obj.method<T>`), promote those onto the call so the
        // sema/mono layers see a generic call rather than a bare member ref.
        if (callee.kind == NodeKind::MemberAccess) {
            const ma: MemberAccessNode* = callee as MemberAccessNode*;
            if (ma.generic_args.length > 0) {
                // Independent DEEP copy: `set_generic_args` stores and owns the
                // array, and `TypeAnnotation*[]` owns its pointees, so the call
                // node and the member-access node must each get their own cloned
                // nodes — a shallow pointer copy double-frees the shared nodes.
                mut ga_copy: TypeAnnotation*[] = [];
                for (mut gi: i64 = 0; gi < ma.generic_args.length; gi++) { ga_copy.push(TypeAnnotation::clone_ptr(ma.generic_args[gi])); }
                call.set_generic_args(ga_copy);
            }
        }

        if (!this.check(TokenType::RParen)) {
            while (true) {
                const arg: ExpressionNode* = this.parse_expression();
                if (arg != null) {
                    call.add_argument(arg);
                }
                if (!this.match_tok(TokenType::Comma)) {
                    break;
                }
            }
        }

        const end: Token = this.consume(TokenType::RParen, "')'");
        call.span = ParserBase::merge_spans(callee.span, this.span_from_token(end));
        return call;
    }

    /// Parse array access: array[index]
    parse_array_access_expr(array: ExpressionNode*) -> ArrayAccessNode* {
        // BRACKET_DEPTH_LIMIT: nested index expressions (`a[a[a[...]]]`)
        // recurse through parse_expression for the index, overflowing the
        // native stack (SIGSEGV) on pathological depth. `bracket_depth` is
        // maintained by advance(); 256 is well past any realistic indexing.
        // report_error sets panic_mode, so parse_postfix breaks instead of
        // re-reading `[`.
        if (this.bracket_depth > 256) {
            this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                "index nesting too deep (recursion limit exceeded)");
            return null;
        }
        this.advance(); // consume '['
        const index: ExpressionNode* = this.parse_expression();
        const end: Token = this.consume(TokenType::RSquare, "']'");
        const span: SourceSpan = ParserBase::merge_spans(array.span, this.span_from_token(end));
        return new ArrayAccessNode(array, index, span);
    }

    /// Parse member access: object.member or object.method<T, U>
    parse_member_access_expr(object: ExpressionNode*) -> MemberAccessNode* {
        this.advance(); // consume '.'
        // Tuple field access: `t.0`, `t.1`, etc. Accept a numeric constant
        // as the member name. The lexeme ("0", "1", ...) is interned as a
        // SymbolStr exactly like a named field; sema branches on the
        // receiver's TypeKind to interpret it as a positional index when
        // the receiver is a TupleType.
        //
        // Chained tuple indices like `t.1.0` are tricky: the lexer eats
        // `1.0` as a single float token. When we see a NumericConstant
        // whose lexeme contains a `.`, split it back into a chain of
        // member accesses (`(t.1).0`). The parser doesn't have to worry
        // about three-part `1.2.3`; the lexer already breaks at the
        // second dot, leaving `.3` as a separate Period+NumericConstant.
        mut member_tok: Token = this.current();
        if (member_tok.kind == TokenType::Identifier
                || member_tok.kind == TokenType::NumericConstant) {
            this.advance();
        } else {
            member_tok = this.consume(TokenType::Identifier, "member name");
        }

        if (member_tok.kind == TokenType::NumericConstant) {
            const dot_pos: i64 = ExprParser::lexeme_first_dot(member_tok.lexeme);
            if (dot_pos >= 0) {
                const lex_len: i64 = strlen(member_tok.lexeme) as i64;
                const first_str: string = member_tok.lexeme.substr(0, dot_pos as u64);
                const rest_str: string = member_tok.lexeme.substr((dot_pos + 1) as u64, (lex_len - dot_pos - 1) as u64);
                const first_sym: SymbolStr = this.ctx.intern(first_str);
                const rest_sym: SymbolStr = this.ctx.intern(rest_str);
                const tok_span: SourceSpan = this.span_from_token(member_tok);
                const inner_span: SourceSpan = ParserBase::merge_spans(
                    object.span, tok_span);
                const inner: MemberAccessNode* = new MemberAccessNode(
                    object, first_sym, tok_span, inner_span);
                return new MemberAccessNode(
                    inner as ExpressionNode*, rest_sym, tok_span, inner_span);
            }
        }

        const member: SymbolStr = this.intern_lexeme(member_tok);
        const member_span: SourceSpan = this.span_from_token(member_tok);
        const span: SourceSpan = ParserBase::merge_spans(object.span, member_span);
        mut node: MemberAccessNode* = new MemberAccessNode(object, member, member_span, span);

        // Pick up explicit type arguments on the member: `obj.method<T, U>(...)`.
        // Mirrors the same lookahead that scope-resolution and primary
        // identifiers already do; without it `obj.cast<T>()` parses as
        // `(obj.cast) < T > ()` (comparison + shift) and the call
        // disappears.
        if (this.check(TokenType::LAngle) && this.is_generic_call_ahead()) {
            const member_gen_args: TypeAnnotation*[] = this.parse_generic_args();
            node.set_generic_args(member_gen_args);
        }

        return node;
    }


    // Scope Resolution Helper

    /// Consume a member name after '::' has already been consumed, create a
    /// ScopeResolutionNode, and parse any generic args on the member.
    /// `scope_name`       - the left-hand identifier (e.g. "Foo" in Foo::bar)
    /// `scope_gen_args`   - generic args on the scope (e.g. <T> in Foo<T>::bar), empty if none
    /// `start_span`       - span of the left-hand side (for merged span)
    parse_scope_member(scope_name: SymbolStr, scope_gen_args: TypeAnnotation*[], start_span: SourceSpan) -> ScopeResolutionNode* {
        // Accept identifiers and any keyword as member names after '::'.
        // Keywords like `new`, `default`, `function`, `optional`, `type`
        // can all be used as static method / variant names.
        const member_tok: Token = if (this.check(TokenType::Identifier) ||
                                      this.current().kind.is_keyword()) {
            this.advance()
        } else {
            this.consume(TokenType::Identifier, "member name after '::'")
        };
        const member_name: SymbolStr = this.intern_lexeme(member_tok);
        const span: SourceSpan = ParserBase::merge_spans(start_span, this.span_from_token(member_tok));
        mut sr: ScopeResolutionNode* = new ScopeResolutionNode(scope_name, member_name, span);

        // Set scope-level generic args if present (e.g. Foo<T>::bar)
        if (scope_gen_args.length > 0) {
            sr.set_scope_generic_args(scope_gen_args);
        }

        // Check for generic args on the member itself: Foo::bar<U>
        if (this.check(TokenType::LAngle) && this.is_generic_call_ahead()) {
            const member_gen_args: TypeAnnotation*[] = this.parse_generic_args();
            sr.set_generic_args(member_gen_args);
        }

        return sr;
    }


    // Generic Disambiguation

    /// Scan forward to determine if `<` begins generic type arguments.
    /// Returns true if we find a matching `>` followed by `(`, `{`, or `::`.
    is_generic_call_ahead() -> boolean {
        mut angle_depth: int = 1;
        mut offset: int = 1;
        const max_lookahead: int = 200;

        while (offset < max_lookahead) {
            const tok: Token = this.peek_at(offset);

            // EOF: not a generic
            if (tok.kind == TokenType::EOF) { return false; }

            if (tok.kind == TokenType::LAngle) {
                angle_depth += 1;
            } else if (tok.kind == TokenType::RAngle) {
                angle_depth -= 1;
                if (angle_depth == 0) {
                    // Check what follows the closing >
                    const next: Token = this.peek_at(offset + 1);
                    if (next.kind == TokenType::LParen ||
                        next.kind == TokenType::LBrace ||
                        next.kind == TokenType::ColonColon) {
                        return true;
                    }
                    // Also allow > followed by > (nested generic closing)
                    if (next.kind == TokenType::RAngle) {
                        return true;
                    }
                    // Also allow > at end of type annotation context (e.g., in parameter lists)
                    // or before type suffixes (*, [], ?)
                    if (next.kind == TokenType::Comma)     { return true; }
                    if (next.kind == TokenType::RParen)    { return true; }
                    if (next.kind == TokenType::Semicolon) { return true; }
                    if (next.kind == TokenType::Equal)     { return true; }
                    if (next.kind == TokenType::Star)      { return true; }
                    if (next.kind == TokenType::LSquare)   { return true; }
                    if (next.kind == TokenType::Question)  { return true; }
                    if (next.kind == TokenType::Arrow)     { return true; }
                    // Generic function-reference value cast: `tramp<i32> as void*`.
                    // Without this, `<` is mis-parsed as less-than and the cast
                    // fails to parse. (GAP 1a)
                    if (next.kind == TokenType::KwAs)      { return true; }
                    // Trait-impl follower: `Foo<T> for Bar`. Only meaningful
                    // when parsing a trait annotation inside parse_impl block.
                    if (next.kind == TokenType::KwFor)     { return true; }
                    // `Bar<T> where ...` in impl blocks.
                    if (next.kind == TokenType::KwWhere)   { return true; }
                    return false;
                }
            } else if (tok.kind == TokenType::GreaterGreater) {
                // >> could be two > tokens for nested generics
                angle_depth -= 2;
                if (angle_depth <= 0) {
                    return true;
                }
            }

            // Tokens that cannot appear in type arguments -> not generic
            if (tok.kind == TokenType::Semicolon ||
                tok.kind == TokenType::LBrace ||
                tok.kind == TokenType::RBrace ||
                tok.kind == TokenType::KwIf ||
                tok.kind == TokenType::KwWhile ||
                tok.kind == TokenType::KwFor ||
                tok.kind == TokenType::KwReturn) {
                return false;
            }

            offset += 1;
        }

        return false;
    }

    /// Parse generic type arguments: <T1, T2*, Array<int>, ...>
    /// Returns structured TypeAnnotation nodes, preserving pointer, array,
    /// optional, and nested generic structure.
    parse_generic_args() -> TypeAnnotation*[] {
        mut args: TypeAnnotation*[] = [];
        this.advance(); // consume '<'

        while (!this.check(TokenType::RAngle) &&
               !this.check(TokenType::GreaterGreater) &&
               !this.is_at_end()) {
            const ann: TypeAnnotation* = this.parse_type_annotation();
            if (ann != null) {
                args.push(ann);
            } else {
                this.report_error(ErrorCode::E0104_EXPECTED_TYPE,
                    format("expected type in generic arguments, found '%s'", this.current().lexeme));
                break;
            }

            // A nested generic arg ending in `>>` (e.g. `Option<Option<T>>`)
            // makes the inner `consume_right_angle` eat the whole `>>` and
            // raise `pending_right_angle` - the virtual second `>` already
            // closes THIS level too.  Stop here so the trailing
            // `consume_right_angle()` below consumes that virtual `>`; without
            // this, the comma check would greedily swallow a following
            // `, next_param` as another type arg.
            if (this.pending_right_angle) {
                break;
            }

            if (!this.match_tok(TokenType::Comma)) {
                break;
            }
        }

        this.consume_right_angle();
        return args;
    }

    // Type Annotation Parsing

    /// Parse a full type annotation.
    parse_type_annotation() -> TypeAnnotation* {
        // TYPE_DEPTH_LIMIT: every nested type form (&T, Option<T>, (T), T?)
        // recurses through here, and `&`/`?` nesting has no bracketing token
        // for advance() to count, so `&&&&...T` / `Option<Option<...>>` /
        // `(((...T)))` would otherwise blow the native stack and crash the
        // compiler. Guard before recursing; 256 is far beyond any real type.
        if (this.type_depth > 256) {
            this.report_error(ErrorCode::E0104_EXPECTED_TYPE,
                "type nesting too deep (recursion limit exceeded)");
            return null;
        }
        this.type_depth += 1;
        const result: TypeAnnotation* = this.parse_type_annotation_inner();
        this.type_depth -= 1;
        return result;
    }

    parse_type_annotation_inner() -> TypeAnnotation* {
        LOG_DEBUG(LogComponent::Parser, "[ExprParser] parse_type_annotation()");
        // Reference types: &T, &mut T, or the alternate `mut &T` form
        // (mut before ampersand) used by stdlib-next.
        if (this.check(TokenType::Amp)) {
            return this.parse_reference_type();
        }
        if (this.check(TokenType::KwMut) && this.peek_at(1).kind == TokenType::Amp) {
            this.advance(); // consume `mut`
            return this.parse_reference_type_with_mutability(true);
        }

        // Parenthesized types: tuple `(T, U)`, 1-tuple `(T,)`, grouping `(T)`,
        // unit `()`, or function `(T, U) -> R`. Disambiguated by the trailing
        // comma (grouping vs 1-tuple) and a following `->` (function type).
        if (this.check(TokenType::LParen)) {
            return this.parse_paren_type();
        }

        // Bracket tuple types `[T, U]` were the pre-1.0 spelling; tuples now
        // use the parenthesized form `(T, U)`. A *leading* `[` in type
        // position is unambiguously the old tuple form (array suffixes
        // `T[]`/`T[N]` are postfix, handled by parse_type_suffixes), so emit a
        // targeted migration diagnostic instead of letting it fall through to
        // a generic "expected type" error.
        if (this.check(TokenType::LSquare)) {
            this.report_error(ErrorCode::E0104_EXPECTED_TYPE,
                "bracket tuple types '[T, U]' are no longer supported; use '(T, U)'");
            return null;
        }

        // `implement Trait + Trait2` opaque type. `implement` is already a
        // reserved keyword (it heads `implement` blocks), so it can never be
        // a type name; seeing it at the start of a type annotation is an
        // unambiguous opaque-type marker.
        if (this.check(TokenType::KwImplement)) {
            return this.parse_impl_trait_type();
        }

        // `const T*` FFI pointer-to-const. The `const` qualifies the pointee,
        // so it binds to the first pointer suffix (`parse_type_suffixes`
        // consumes the pending flag for the nearest `*`). A `const` with no
        // following `*` has no representation on a value type and is dropped,
        // matching C (top-level const on a by-value param is meaningless).
        if (this.check(TokenType::KwConst)) {
            this.advance(); // consume `const`
            const cbase: TypeAnnotation* = this.parse_base_type();
            if (cbase == null) { return null; }
            return this.parse_type_suffixes_q(cbase, true);
        }

        // Base type + optional suffixes
        const base: TypeAnnotation* = this.parse_base_type();
        if (base == null) { return null; }
        return this.parse_type_suffixes(base);
    }

    /// Parse `implement Trait + Trait2 + ...`. Each bound is a base type
    /// (`Named` or `Generic`, e.g. `Iterator<i32>`); pointer/array/optional
    /// suffixes are not meaningful on a trait bound, so `parse_base_type` is
    /// used directly rather than `parse_type_annotation`.
    parse_impl_trait_type() -> TypeAnnotation* {
        const start: Token = this.current();
        this.advance(); // consume `implement`
        mut bounds: TypeAnnotation*[] = [];
        while (true) {
            const bound: TypeAnnotation* = this.parse_base_type();
            if (bound == null) { break; }
            bounds.push(bound);
            if (!this.match_tok(TokenType::Plus)) { break; }
        }
        const imp: ImplTraitAnnotation* = new ImplTraitAnnotation {
            bounds:   bounds,
            resolved: TypeRef::invalid(),
            span:     this.span_from(start),
        };
        return new TypeAnnotation::ImplTrait(imp);
    }

    /// Parse a base type (primitive, `This`, or named).
    parse_base_type() -> TypeAnnotation* {
        const tok: Token = this.current();

        // Void
        if (tok.kind == TokenType::KwVoid) {
            this.advance();
            const name: SymbolStr = this.ctx.intern("void");
            const ann: PrimitiveAnnotation* = new PrimitiveAnnotation {
                name: name,
                span: this.span_from_token(tok),
            };
            return new TypeAnnotation::Primitive(ann);
        }

        // `This` placeholder: only meaningful inside trait/impl scopes;
        // sema (Phase B.1) substitutes the implementing type. A trailing
        // `::Member` makes it an associated-type projection `This::Item`,
        // captured as a Projection node (the base is the keyword `This`, which
        // can't be flattened into an identifier qualified-name like `I::Item`).
        if (tok.kind == TokenType::KwThisType) {
            this.advance();
            mut base_ann: TypeAnnotation* = new TypeAnnotation::ThisType(
                new ThisTypeAnnotation { span: this.span_from_token(tok) }
            );
            while (this.check(TokenType::ColonColon)) {
                this.advance(); // consume '::'
                const mem_tok: Token = this.consume(TokenType::Identifier,
                    "associated type name after '::'");
                const pj: ProjectionAnnotation* = new ProjectionAnnotation {
                    base:         base_ann,
                    member:       this.ctx.intern(mem_tok.lexeme),
                    owning_trait: SymbolStr::empty(),
                    resolved:     TypeRef::invalid(),
                    span:         this.span_from(tok),
                };
                base_ann = new TypeAnnotation::Projection(pj);
            }
            return base_ann;
        }

        // `typeof(expr)` in type position (decltype): resolves to the operand
        // expression's static type.  The operand is stored opaquely (the AST
        // root can't name ExpressionNode); sema casts it back and derives the
        // type, caching it in `resolved`.  Value-position `typeof` is parsed
        // separately as a TypeofExprNode (parse_typeof_expression).
        if (tok.kind == TokenType::KwTypeof) {
            this.advance();
            this.consume(TokenType::LParen, "'('");
            const operand: ExpressionNode* = this.parse_expression();
            this.consume(TokenType::RParen, "')'");
            const to: TypeofAnnotation* = new TypeofAnnotation {
                operand:  operand as void*,
                resolved: TypeRef::invalid(),
                span:     this.span_from_token(tok),
            };
            return new TypeAnnotation::Typeof(to);
        }

        // Primitive types
        if (this.is_primitive_type_token()) {
            this.advance();
            const name: SymbolStr = this.ctx.intern(tok.lexeme);
            const ann: PrimitiveAnnotation* = new PrimitiveAnnotation {
                name: name,
                span: this.span_from_token(tok),
            };
            return new TypeAnnotation::Primitive(ann);
        }

        // Named type (user-defined)
        if (tok.kind == TokenType::Identifier) {
            this.advance();
            mut qn: QualifiedName = QualifiedName::empty();
            qn.push(this.ctx.get_intern_table(), tok.lexeme);

            // Handle qualified names: A::B::C
            while (this.check(TokenType::ColonColon)) {
                this.advance();
                const next: Token = this.current();
                // The segment after `::` must be an identifier. `Foo::123` /
                // `Foo::*` used to silently absorb the bogus token into the
                // qualified name, producing a confusing "type `Foo::123` not
                // found" later instead of pointing at the offending token.
                if (next.kind != TokenType::Identifier) {
                    this.report_error(ErrorCode::E0104_EXPECTED_TYPE,
                        format("expected an identifier after `::`, found '%s'",
                            next.lexeme));
                    break;
                }
                qn.push(this.ctx.get_intern_table(), next.lexeme);
                this.advance();
            }

            const name: SymbolStr = this.ctx.intern(qn.display(this.ctx.get_intern_table()));

            // Check for generic parameters: Type<A, B>
            if (this.check(TokenType::LAngle) && this.is_generic_call_ahead()) {
                const base_ann: TypeAnnotation* = new TypeAnnotation::Named(
                    new NamedAnnotation {
                        name: name,
                        span: this.span_from_token(tok),
                        pre_resolved: TypeRef::invalid(),
                    }
                );

                const type_args: TypeAnnotation*[] = this.parse_generic_args();

                const gen_ann: GenericAnnotation* = new GenericAnnotation {
                    base: base_ann,
                    args: type_args,
                    span: this.span_from(tok),
                };
                return new TypeAnnotation::Generic(gen_ann);
            }

            const named_ann: NamedAnnotation* = new NamedAnnotation {
                name: name,
                span: this.span_from_token(tok),
                pre_resolved: TypeRef::invalid(),
            };
            return new TypeAnnotation::Named(named_ann);
        }

        this.report_error(ErrorCode::E0104_EXPECTED_TYPE,
            format("expected type, found '%s'", tok.lexeme));
        return null;
    }

    /// Check if * after a cast type is a pointer suffix (not multiplication).
    /// Returns true if the token AFTER * is not an expression start,
    /// meaning * should be parsed as a pointer type suffix.
    is_star_pointer_suffix() -> boolean {
        const after: Token = this.peek_at(1);
        if (after.kind == TokenType::Semicolon) { return true; }
        if (after.kind == TokenType::RParen) { return true; }
        if (after.kind == TokenType::RBrace) { return true; }
        if (after.kind == TokenType::RSquare) { return true; }
        if (after.kind == TokenType::Comma) { return true; }
        if (after.kind == TokenType::KwAs) { return true; }
        if (after.kind == TokenType::EOF) { return true; }
        // * followed by ) or another * (e.g., void** ) is pointer
        if (after.kind == TokenType::Star) { return true; }
        return false;
    }

    /// Parse type suffixes: *, [], [N], ?
    parse_type_suffixes(base: TypeAnnotation*) -> TypeAnnotation* {
        return this.parse_type_suffixes_q(base, false);
    }

    /// As `parse_type_suffixes`, but `pending_const` marks the pointee of the
    /// nearest `*` suffix as const (`const T*`). The flag is consumed by the
    /// first pointer only; subsequent levels default to non-const.
    parse_type_suffixes_q(base: TypeAnnotation*, pending_const: boolean) -> TypeAnnotation* {
        mut result: TypeAnnotation* = base;
        mut ptr_const: boolean = pending_const;

        while (true) {
            // Pointer suffix: T*
            if (this.check(TokenType::Star)) {
                this.advance();
                const ptr_ann: PointerAnnotation* = new PointerAnnotation {
                    inner:    result,
                    is_const: ptr_const,
                    span:     this.current_span(),
                };
                ptr_const = false; // const binds to the innermost pointer only
                result = new TypeAnnotation::Pointer(ptr_ann);
            }
            // Array suffix: T[] or T[N]
            else if (this.check(TokenType::LSquare)) {
                this.advance();
                if (this.check(TokenType::RSquare)) {
                    // Heap-backed dynamic array: T[]
                    this.advance();
                    const arr_ann: ArrayAnnotation* = new ArrayAnnotation {
                        element: result,
                        size:    ArrayAnnotation::heap_dynamic_size(),
                        span:    this.current_span(),
                    };
                    result = new TypeAnnotation::Array(arr_ann);
                } else {
                    // Fixed-size array: T[N] or T[CONST_NAME]
                    // Parse the size as a numeric constant or identifier (const ref)
                    const size_tok: Token = this.current();
                    mut size: i64 = 0;
                    if (size_tok.kind == TokenType::NumericConstant) {
                        // Decode the full numeric lexeme: this honours the
                        // `0x`/`0o`/`0b` base prefixes and `_` separators that
                        // a hand-rolled decimal scan would silently drop (e.g.
                        // `T[0xFF]` must be 255, not 0).
                        // A size that needs more than 64 bits would saturate to
                        // a meaningless value; reject it up front rather than
                        // build a garbage array type.
                        if (ParserBase::numeric_lexeme_overflows_u64(size_tok.lexeme)) {
                            this.report_error(ErrorCode::E0010_NUMBER_TOO_LARGE,
                                format("array size `%s` does not fit in 64 bits",
                                    size_tok.lexeme));
                        }
                        size = ParserBase::parse_numeric_lexeme_i64(size_tok.lexeme);
                        this.advance();
                    } else if (size_tok.kind == TokenType::Identifier) {
                        // Named constant: T[BTREE_MAX_KEYS].  Mark it
                        // fixed-pending (size resolved later) - distinct from
                        // a heap-backed `T[]` so ownership analysis does not
                        // free its (nonexistent) heap buffer.  Still
                        // `is_dynamic()`, so layout and codegen are unchanged.
                        size = ArrayAnnotation::fixed_pending_size();
                        this.advance();
                    } else {
                        // Computed-size expression: also a fixed array
                        // awaiting resolution.
                        size = ArrayAnnotation::fixed_pending_size();
                        this.advance();
                    }
                    this.consume(TokenType::RSquare, "']'");
                    const arr_ann: ArrayAnnotation* = new ArrayAnnotation {
                        element: result,
                        size:    size,
                        span:    this.current_span(),
                    };
                    result = new TypeAnnotation::Array(arr_ann);
                }
            }
            // Optional suffix: `T?` is sugar for `Option<T>`. Desugar here in
            // the parser so every later pass (resolver, monomorphizer, sema,
            // codegen) treats it identically to an explicit `Option<T>` - there
            // is no separate Optional type to keep wired up, and `T?` unifies
            // with `Option<T>` for free. `Option` resolves via the prelude from
            // any module, exactly as a hand-written `Option<T>` does.
            else if (this.check(TokenType::Question)) {
                this.advance();
                const opt_base: TypeAnnotation* = new TypeAnnotation::Named(
                    new NamedAnnotation {
                        name:         this.ctx.intern("Option"),
                        span:         this.current_span(),
                        pre_resolved: TypeRef::invalid(),
                    }
                );
                mut opt_args: TypeAnnotation*[] = [];
                opt_args.push(result);
                const opt_gen: GenericAnnotation* = new GenericAnnotation {
                    base: opt_base,
                    args: opt_args,
                    span: this.current_span(),
                };
                result = new TypeAnnotation::Generic(opt_gen);
            }
            else {
                break;
            }
        }

        return result;
    }

    /// Parse a reference type: `&T` or `&mut T`. The leading `&` is at
    /// current position; mutability is determined by an optional `mut`
    /// after the ampersand.
    parse_reference_type() -> TypeAnnotation* {
        const start: Token = this.advance(); // consume '&'
        mut is_mutable: boolean = false;
        if (this.check(TokenType::KwMut)) {
            this.advance();
            is_mutable = true;
        }
        return this.finish_reference_type(start, is_mutable);
    }

    /// Parse a reference type when the caller has already consumed a
    /// leading `mut` modifier (the `mut &T` form). Current must be `&`.
    parse_reference_type_with_mutability(is_mutable: boolean) -> TypeAnnotation* {
        const start: Token = this.advance(); // consume '&'
        return this.finish_reference_type(start, is_mutable);
    }

    /// Inner-type + node assembly shared by both reference forms.
    finish_reference_type(start: Token, is_mutable: boolean) -> TypeAnnotation* {
        const inner: TypeAnnotation* = this.parse_type_annotation();
        if (inner == null) { return null; }
        const ref_ann: ReferenceAnnotation* = new ReferenceAnnotation {
            inner:      inner,
            is_mutable: is_mutable,
            span:       this.span_from(start),
        };
        return new TypeAnnotation::Reference(ref_ann);
    }

    /// Parse a parenthesized type. One entry point for every `(...)` type:
    ///   `()`          -> unit type (empty TupleAnnotation; the resolver
    ///                    canonicalizes it to UnitType). Unit *is* the empty
    ///                    tuple; there is no separate `(,)` spelling.
    ///   `(T)`         -> grouping: just `T` (no trailing comma).
    ///   `(T,)`        -> 1-tuple (trailing comma disambiguates from grouping).
    ///   `(T, U, ...)` -> tuple type.
    ///   `(T, U) -> R` -> function type (also `() -> R`).
    /// The trailing comma (grouping vs 1-tuple) and a following `->` (function
    /// type) are the two disambiguators.
    parse_paren_type() -> TypeAnnotation* {
        const start: Token = this.advance(); // consume '('

        mut params: TypeAnnotation*[] = [];
        mut trailing_comma: boolean = false;
        if (!this.check(TokenType::RParen)) {
            while (true) {
                const param: TypeAnnotation* = this.parse_type_annotation();
                if (param != null) {
                    params.push(param);
                }
                if (!this.match_tok(TokenType::Comma)) {
                    break;
                }
                // A comma was consumed; if `)` follows it was a trailing comma
                // (`(T,)` 1-tuple) - stop without expecting another element.
                if (this.check(TokenType::RParen)) {
                    trailing_comma = true;
                    break;
                }
            }
        }
        this.consume(TokenType::RParen, "')'");

        // Function type: (params) -> return_type   (covers `() -> R` too).
        if (this.check(TokenType::Arrow)) {
            this.advance();
            const ret: TypeAnnotation* = this.parse_type_annotation();
            const fn_ann: FunctionAnnotation* = new FunctionAnnotation {
                parameters:  params,
                return_type: ret,
                span:        this.span_from(start),
            };
            return new TypeAnnotation::Function(fn_ann);
        }

        // `()` -> unit type (empty TupleAnnotation, canonicalized downstream).
        if (params.length == 0) {
            const unit_ann: TupleAnnotation* = new TupleAnnotation {
                elements: params,
                span:     this.span_from(start),
            };
            return new TypeAnnotation::Tuple(unit_ann);
        }

        // `(T)` with no trailing comma -> grouping; the inner type is complete
        // (it already ran through parse_type_annotation, suffixes included).
        if (params.length == 1 && !trailing_comma) {
            return params[0];
        }

        // `(T,)` 1-tuple or `(T, U, ...)` tuple. Allow type suffixes so
        // `(i32, i32)*`, `(i32, i32)?`, `(i32, i32)[]` all work.
        const tup_ann: TupleAnnotation* = new TupleAnnotation {
            elements: params,
            span:     this.span_from(start),
        };
        return this.parse_type_suffixes(new TypeAnnotation::Tuple(tup_ann));
    }

    /// Parse the DEPRECATED bracket tuple type `[T, U, V]`. Retained only for
    /// bootstrap compatibility (the pinned compiler builds the stdlib, which
    /// still uses `[...]`); new code should use the parenthesized form
    /// `(T, U)`. To be removed once the stdlib is migrated and re-pinned.
    /// Empty `[]` is invalid (use `()` for unit). Lowers to the same
    /// TupleAnnotation as `(...)`.
    // Type Helper Predicates

    /// Check if the current token starts a type annotation.
    is_type_start() -> boolean {
        if (this.is_primitive_type_token()) { return true; }
        return match (&this.current().kind) {
            TokenType::Identifier => { true }
            TokenType::KwVoid     => { true }
            TokenType::Amp        => { true }
            TokenType::LParen     => { true }
            _                     => { false }
        };
    }

    /// Check if the current token is a primitive type keyword.
    is_primitive_type_token() -> boolean {
        return match (&this.current().kind) {
            TokenType::KwBoolean => { true }
            TokenType::KwInt     => { true }
            TokenType::KwI8      => { true }
            TokenType::KwI16     => { true }
            TokenType::KwI32     => { true }
            TokenType::KwI64     => { true }
            TokenType::KwI128    => { true }
            TokenType::KwUint    => { true }
            TokenType::KwUint8   => { true }
            TokenType::KwUint16  => { true }
            TokenType::KwUint32  => { true }
            TokenType::KwUint64  => { true }
            TokenType::KwUint128 => { true }
            TokenType::KwIsize   => { true }
            TokenType::KwUsize   => { true }
            TokenType::KwFloat   => { true }
            TokenType::KwF32     => { true }
            TokenType::KwF64     => { true }
            TokenType::KwDouble  => { true }
            TokenType::KwChar    => { true }
            TokenType::KwString  => { true }
            _                    => { false }
        };
    }


    /// Try to extract the name from an expression node (for scope resolution).
    get_expr_name(expr: ExpressionNode*) -> SymbolStr {
        const node: ASTNode* = expr as ASTNode*;
        if (node.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = expr as IdentifierNode*;
            return id.name;
        }
        if (node.kind == NodeKind::ScopeResolution) {
            const sr: ScopeResolutionNode* = expr as ScopeResolutionNode*;
            return sr.member_name;
        }
        if (node.kind == NodeKind::CallExpression) {
            const call: CallExprNode* = expr as CallExprNode*;
            return this.get_expr_name(call.callee);
        }
        return SymbolStr::empty();
    }

    // Find the first '.' in a numeric lexeme like "1.0": returns its byte
    // index, or -1 if none. Used by `parse_member_access_expr` to split a
    // float-shaped token back into a chain of tuple indices when the lexer
    // has eaten the dot.
    static lexeme_first_dot(s: string) -> i64 {
        if (s == null) { return -1; }
        const len: i64 = strlen(s) as i64;
        for (mut i: i64 = 0; i < len; i++) {
            if (s[i] == '.') { return i; }
        }
        return -1;
    }
}
