///! Parser
///!
///! Top-level parser class extending ExprParser with statement and declaration
///! parsing.  This is the main entry point for the parsing pass.

namespace Compiler::Parser::Parser;

import Compiler::Lex;
import Compiler::Diag;
import Compiler::Diag::{ SourceSpan, Diagnostic, Suggestion };
import Compiler::AST;
import Compiler::AST::{ Node, Expression, Statement, Declaration, Pattern };
import Compiler::CompilationContext;
import Compiler::Resolver::{ SymbolStr, QualifiedName };
import Compiler::Resolver::Res;
import Compiler::Parser::{ ParserBase, ExprParser };
import Utils::Logger;
import Compiler::Types::TypeRef;


/// The `static` / `async` run parsed ahead of a method head.
type struct MethodModifiers {
    is_static: boolean;
    is_async:  boolean;
    /// Extent of the consumed keywords. They are read before the method node
    /// exists, so they fall outside its own `span`; the member keeps them for
    /// `outer_span()` (see `DeclarationNode::note_modifier_span`).
    span:      SourceSpan;
}

type class Parser : ExprParser {
public:
    /// Module-scope `static_assert(...)` items collected during the top-level
    /// parse and attached to the ProgramNode before it is returned. Kept off
    /// the statement stream so they need no NodeKind / visitor handling.
    static_assert_items: StaticAssertItem*[];

    Parser(tokens: Token[], source_file: string, ctx: CompilationContext*)
        : ExprParser(tokens, source_file, ctx) {
        this.static_assert_items = [];
    }

    /// Parse a standalone expression from `toks` on a fresh sub-`Parser`,
    /// sharing this parser's source file and compilation context (intern
    /// table, diagnostics).  Used by f-string hole desugaring.  A separate
    /// parser is used so the hole's token stream never displaces this
    /// parser's own (owned) tokens.
    override parse_expr_from_tokens(toks: Token[]) -> ExpressionNode* {
        mut sub: Parser = Parser(toks, this.source_file, this.ctx);
        return sub.parse_expression();
    }

    /// Override ExprParser's limited block parser with full statement support.
    /// This allows match expression arms and lambda bodies to contain any
    /// statement (for, if, while, etc.), not just const/return/expressions.
    /// Unlike parse_block_statement(), semicolons are optional before '}'
    /// (the last expression in the block is the arm's return value).
    override parse_inner_block() -> BlockStmtNode* {
        // BRACE_DEPTH_LIMIT: nested blocks (`{{{...}}}`, and the block bodies
        // of nested `if`/`match`/`while`/`for`) recurse through here with no
        // expression-level bracketing for the unary/expr/type guards to catch,
        // so a pathological depth overflows the native stack (SIGSEGV).
        // `brace_depth` is maintained by advance(); 256 is far beyond any
        // realistic hand-written nesting. Return an empty block (not null) so
        // the many callers that don't null-check a body never deref null; the
        // enclosing block loop's no-progress guard force-advances past the
        // unconsumed `{`, so this also terminates rather than spinning.
        if (this.brace_depth > 256) {
            this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                "block nesting too deep (recursion limit exceeded)");
            return new BlockStmtNode(this.current_span());
        }
        const bstart: Token = this.advance(); // consume '{'
        mut block: BlockStmtNode* = new BlockStmtNode(this.span_from_token(bstart));

        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            const before_pos: int = this.pos;
            if (this.panic_mode) {
                if (this.check(TokenType::RBrace)) {
                    this.panic_mode = false;
                    break;
                }
                this.synchronize();
                if (this.check(TokenType::RBrace) || this.is_at_end()) { break; }
            }

            // `static match` is a statement, not a declaration, even though
            // `is_declaration_start()` reports `static` (for `static function`).
            const is_static_match: boolean =
                this.check(TokenType::KwStatic) &&
                this.peek_at(1).kind == TokenType::KwMatch;
            if (this.is_declaration_start() && !is_static_match) {
                const decl: ASTNode* = this.parse_declaration(false, "");
                if (decl != null) {
                    const decl_stmt: DeclStmtNode* = new DeclStmtNode(
                        decl as DeclarationNode*, decl.span);
                    block.add_statement(decl_stmt);
                }
            } else if (is_static_match || this.is_statement_keyword()) {
                const stmt: StatementNode* = this.parse_statement();
                if (stmt != null) {
                    block.add_statement(stmt);
                }
            } else {
                // Expression: semicolon optional before '}'
                const expr: ExpressionNode* = this.parse_expression();
                if (expr != null) {
                    const stmt: ExprStmtNode* = new ExprStmtNode(expr, expr.span);
                    block.add_statement(stmt);
                }
                this.match_tok(TokenType::Semicolon);
            }

            // Progress guard: avoid infinite loops when an error-recovery path
            // returns without consuming any tokens.
            if (this.pos == before_pos) { this.advance(); }
        }

        this.consume(TokenType::RBrace, "'}'");
        block.span = this.span_from(bstart);
        return block;
    }

    /// Create a parser from the compilation context's token stream.
    /// The parser OWNS its `tokens` buffer (ParserBase.tokens), so it must
    /// receive an independent copy rather than aliasing the ctx-owned lexer
    /// output (`ctx.artifacts.tokens.tokens`): otherwise both the parser and
    /// the context would free the same buffer.  Token is Copy, so this is a
    /// shallow element-wise duplication.
    static from_context(ctx: CompilationContext*) -> Parser {
        mut toks_copy: Token[] = [];
        const src_len: i64 = ctx.artifacts.tokens.tokens.length;
        for (mut i: i64 = 0; i < src_len; i++) {
            toks_copy.push(ctx.artifacts.tokens.tokens[i]);
        }
        return Parser(
            toks_copy,
            ctx.artifacts.tokens.source_file,
            ctx
        );
    }

    /// True if the AST node is a declaration that can carry attached
    /// directives (i.e. inherits from `DeclarationNode`).
    static is_attachable_decl(node: ASTNode*) -> boolean {
        if (node == null) { return false; }
        return match (node.kind) {
            NodeKind::FunctionDeclaration   => { true }
            NodeKind::StructDeclaration     => { true }
            NodeKind::UnionDeclaration      => { true }
            NodeKind::ClassDeclaration      => { true }
            NodeKind::EnumDeclaration       => { true }
            NodeKind::TraitDeclaration      => { true }
            NodeKind::TypeAliasDeclaration  => { true }
            NodeKind::VariableDeclaration   => { true }
            NodeKind::ImplementationBlock   => { true }
            NodeKind::ExternBlock           => { true }
            NodeKind::ImportDeclaration     => { true }
            NodeKind::ModuleDeclaration     => { true }
            NodeKind::IntrinsicDeclaration  => { true }
            NodeKind::IntrinsicConstDeclaration => { true }
            _                               => { false }
        };
    }

    /// Record a leading modifier keyword (`public` / `private`) on a
    /// declaration that has just been parsed.  The keyword is consumed
    /// before the declaration's own parse begins, so it falls outside the
    /// node's `span`; `DeclarationNode::outer_span` folds it back in for
    /// consumers that need the full written extent.  Nodes that can't carry
    /// one (a recovery `null`, a non-declaration) are ignored - the same
    /// gate `is_attachable_decl` applies to directives.
    static note_decl_modifier(node: ASTNode*, span: SourceSpan) -> void {
        if (!Parser::is_attachable_decl(node)) { return; }
        const decl: DeclarationNode* = node as DeclarationNode*;
        decl.note_modifier_span(span);
    }


    // Entry Point

    /// Parse the entire program, producing a ProgramNode.
    parse() -> ProgramNode* {
        // Module-level names first: the parse is single-pass, but deciding
        // whether an `ident <` opens type arguments needs to know about
        // declarations further down the file.
        this.scan_module_names();

        // Skip leading comments/doc comments
        this.collect_doc_comments();
        LOG_DEBUG(LogComponent::Parser, "[Parser] parse() starting parsing...");

        const start: Token = this.current();
        mut program: ProgramNode* = new ProgramNode(this.span_from_token(start));

        while (!this.is_at_end()) {
            if (this.panic_mode) {
                this.synchronize();
                if (this.is_at_end()) { break; }
            }

            // Collect doc comments before each top-level item
            this.collect_doc_comments();
            if (this.is_at_end()) { break; }

            // Drain consecutive `![...]` directives so we can attach them
            // to the next declaration.
            mut pending: DirectiveNode*[] = [];
            while (this.check(TokenType::BangBracket)) {
                const d: DirectiveNode* = this.parse_directive();
                if (d != null) { pending.push(d); }
                this.collect_doc_comments();
                if (this.is_at_end()) { break; }
            }

            if (this.is_at_end()) {
                for (mut i: i64 = 0; i < pending.length; i++) {
                    program.add_statement(pending[i] as ASTNode*);
                }
                break;
            }

            // Module-level `asm { ... }` (naked / global asm, no operands),
            // lowered to LLVM module inline asm.  `pending` (its `![arch]` /
            // `![clobber]`) is lifted into the node.
            if (this.check(TokenType::KwAsm)) {
                const asm_node: AsmBlockStmtNode* = this.parse_asm_block(pending, true);
                program.add_statement(asm_node as ASTNode*);
                continue;
            }

            const node: ASTNode* = this.parse_top_level();
            if (node != null) {
                if (pending.length > 0 && Parser::is_attachable_decl(node)) {
                    const decl: DeclarationNode* = node as DeclarationNode*;
                    for (mut i: i64 = 0; i < pending.length; i++) {
                        decl.add_directive(pending[i]);
                    }
                } else {
                    for (mut i: i64 = 0; i < pending.length; i++) {
                        program.add_statement(pending[i] as ASTNode*);
                    }
                }
                program.add_statement(node);
                Parser::hoist_extern_globals(program, node);
            } else if (pending.length > 0) {
                for (mut i: i64 = 0; i < pending.length; i++) {
                    program.add_statement(pending[i] as ASTNode*);
                }
            }
        }

        program.span = this.span_from(start);

        // Propagate "this module used an f-string" so AutoImport can inject
        // the f-string runtime import (std::fmt::interp).
        program.uses_fstring = this.used_fstring;

        // Set the file's namespace from its `namespace X::Y::Z;` line.
        // The parser converts that line into a `ModuleDeclNode`; the
        // first such node in the statement list is, by convention, the
        // file's own namespace (subsequent `public module ...;` lines
        // are sub-module re-exports).  Skipping over directive nodes
        // keeps `![config(...)]`-prefixed files producing the right
        // `namespace_name`.
        for (mut i: i64 = 0; i < program.statements.length; i++) {
            const s: ASTNode* = program.statements[i];
            if (s == null) { continue; }
            if (s.kind == NodeKind::Directive) { continue; }
            if (s.kind == NodeKind::ModuleDeclaration) {
                const m: ModuleDeclNode* = s as ModuleDeclNode*;
                program.set_namespace_name(m.path);
            }
            break;
        }

        // Attach module-scope `static_assert(...)` items collected during the
        // parse to the ProgramNode side list.
        for (mut sa: i64 = 0; sa < this.static_assert_items.length; sa++) {
            program.add_static_assert(this.static_assert_items[sa]);
        }

        return program;
    }

    /// Parse a module-scope `static_assert(cond)` or
    /// `static_assert(cond, "message")`. The leading `static_assert` identifier
    /// is current. Stashes a StaticAssertItem; emits nothing to the AST.
    parse_static_assert() -> void {
        const start: Token = this.advance(); // consume the `static_assert` keyword
        this.consume(TokenType::LParen, "'('");
        const cond: ExpressionNode* = this.parse_expression();
        mut msg: string = "";
        if (this.check(TokenType::Comma)) {
            this.advance(); // consume ','
            if (this.check(TokenType::StringLiteral)) {
                msg = this.current().lexeme;
                this.advance();
            }
        }
        this.consume(TokenType::RParen, "')'");
        this.consume(TokenType::Semicolon, "';'");
        const item: StaticAssertItem* = new StaticAssertItem {
            cond:    cond as void*,
            message: msg,
            span:    this.span_from(start),
        };
        this.static_assert_items.push(item);
    }


    // Top-Level Dispatch

    /// Dispatch to the appropriate declaration or statement parser based on
    /// the current token.
    parse_top_level() -> ASTNode* {
        LOG_DEBUG(LogComponent::Parser, "[Parser] parse_top_level() token='%s'", this.current().lexeme);
        const tok: Token = this.current();
        const doc: string = this.take_documentation();

        // Namespace declaration.  A `///!` banner immediately above the
        // `namespace X::Y;` line is the module's documentation; attach
        // it so the LSP can surface it on hover.
        if (tok.kind == TokenType::KwNamespace) {
            const ns: ASTNode* = this.parse_namespace_declaration();
            if (ns != null && doc != "") {
                (ns as ModuleDeclNode*).set_documentation(doc);
            }
            return ns;
        }

        // Module declaration (public module Foo;)
        if (tok.kind == TokenType::KwPublic && this.peek_at(1).kind == TokenType::KwModule) {
            const md: ModuleDeclNode* = this.parse_module_declaration();
            if (md != null && doc != "") {
                md.set_documentation(doc);
            }
            return md;
        }

        // Public declarations
        if (tok.kind == TokenType::KwPublic) {
            const vis_span: SourceSpan = this.span_from_token(tok);
            this.advance(); // consume 'public'
            const decl: ASTNode* = this.parse_declaration(true, doc);
            Parser::note_decl_modifier(decl, vis_span);
            return decl;
        }

        // Private declarations
        if (tok.kind == TokenType::KwPrivate) {
            const vis_span: SourceSpan = this.span_from_token(tok);
            this.advance();
            const decl: ASTNode* = this.parse_declaration(false, doc);
            Parser::note_decl_modifier(decl, vis_span);
            return decl;
        }

        // Import declaration
        if (tok.kind == TokenType::KwImport) {
            const imp: ImportDeclNode* = this.parse_import_declaration();
            if (imp != null && doc != "") {
                imp.set_documentation(doc);
            }
            return imp;
        }

        // Export declaration (symbol re-export).
        if (tok.kind == TokenType::KwExport) {
            const exp: ImportDeclNode* = this.parse_export_declaration();
            if (exp != null && doc != "") {
                exp.set_documentation(doc);
            }
            return exp;
        }

        // Extern block, or the C-header import form `extern module name := "C"`.
        if (tok.kind == TokenType::KwExtern) {
            if (this.peek_at(1).kind == TokenType::KwModule) {
                const cext: ExternBlockNode* = this.parse_extern_module_cimport();
                if (cext != null && doc != "") {
                    cext.set_documentation(doc);
                }
                return cext;
            }
            const ext: ExternBlockNode* = this.parse_extern_block();
            if (ext != null && doc != "") {
                ext.set_documentation(doc);
            }
            return ext;
        }

        // Implement block
        if (tok.kind == TokenType::KwImplement) {
            const impl_blk: ImplBlockNode* = this.parse_implementation_block();
            if (impl_blk != null && doc != "") {
                impl_blk.set_documentation(doc);
            }
            return impl_blk;
        }

        // Directive: ![name] or ![name(args)]
        if (tok.kind == TokenType::BangBracket) {
            return this.parse_directive();
        }

        // `static_assert(cond)` / `static_assert(cond, "message")` at module
        // scope. `static_assert` is a reserved keyword. The item is stashed on
        // the parser and attached to the ProgramNode; nothing is added to the
        // statement stream, so this returns null.
        if (tok.kind == TokenType::KwStaticAssert) {
            this.parse_static_assert();
            return null;
        }

        // Regular declaration (function, type, const, mut, etc.).
        // Top-level declarations are public by default; modules export
        // their surface, and individual items can opt out with the
        // `private` keyword.  Types are unconditionally exported in
        // name resolution today, so the practical effect of flipping
        // the default is on free `function` decls: a bare `function
        // foo() {}` is now visible to wildcard imports, matching the
        // long-standing stdlib convention where every free function is
        // written without a `public` prefix.
        return this.parse_declaration(true, doc);
    }

    /// Parse a declaration based on the current token.
    parse_declaration(is_public: boolean, doc: string) -> ASTNode* {
        LOG_DEBUG(LogComponent::Parser, "[Parser] parse_declaration() token='%s'", this.current().lexeme);
        const tok: Token = this.current();

        // Function declaration
        if (tok.kind == TokenType::KwFunction) {
            const func: FunctionDeclNode* = this.parse_function_declaration(is_public);
            if (func != null && doc != "") {
                func.set_documentation(doc);
            }
            return func;
        }

        // `async function` - an async fn is parsed as an ordinary function
        // carrying the `is_async` flag; the async lowering in SemanticAnalysis
        // rewrites it into a state-machine struct + `Future` impl.
        if (tok.kind == TokenType::KwAsync && this.peek_at(1).kind == TokenType::KwFunction) {
            const async_span: SourceSpan = this.span_from_token(tok);
            this.advance(); // consume 'async'
            const func: FunctionDeclNode* = this.parse_function_declaration(is_public);
            if (func != null) {
                func.set_async(true);
                func.note_modifier_span(async_span);
                if (doc != "") { func.set_documentation(doc); }
            }
            return func;
        }

        // Variable declaration: const or mut.  If the next-after token is `{`
        // it's a struct destructure binding (`const { f }: T = expr;`); these
        // are body-only (no global destructures), so the global path stays on
        // the VarDeclNode form.
        if (tok.kind == TokenType::KwConst || tok.kind == TokenType::KwMut) {
            if (this.peek_at(1).kind == TokenType::LBrace && this.scope_depth > 0) {
                return this.parse_destructure_decl();
            }
            const vd: VarDeclNode* = this.parse_variable_declaration();
            if (vd != null) {
                if (doc != "") { vd.set_documentation(doc); }
                if (this.scope_depth == 0) { vd.set_global(true); }
            }
            return vd;
        }

        // Type declarations: type struct/class/enum/trait/alias
        if (tok.kind == TokenType::KwType) {
            const next: Token = this.peek_at(1);

            if (next.kind == TokenType::KwStruct) {
                const sd: StructDeclNode* = this.parse_struct_declaration();
                if (sd != null) {
                    sd.set_public(is_public);
                    if (doc != "") { sd.set_documentation(doc); }
                }
                return sd;
            }
            if (next.kind == TokenType::KwUnion) {
                const ud: UnionDeclNode* = this.parse_union_declaration();
                if (ud != null) {
                    ud.set_public(is_public);
                    if (doc != "") { ud.set_documentation(doc); }
                }
                return ud;
            }
            if (next.kind == TokenType::KwClass) {
                const cd: ClassDeclNode* = this.parse_class_declaration();
                if (cd != null) {
                    cd.set_public(is_public);
                    if (doc != "") { cd.set_documentation(doc); }
                }
                return cd;
            }
            if (next.kind == TokenType::KwEnum) {
                const ed: EnumDeclNode* = this.parse_enum_declaration();
                if (ed != null) {
                    ed.set_public(is_public);
                    if (doc != "") { ed.set_documentation(doc); }
                }
                return ed;
            }
            if (next.kind == TokenType::KwTrait) {
                const td: TraitDeclNode* = this.parse_trait_declaration();
                if (td != null && doc != "") { td.set_documentation(doc); }
                return td;
            }

            // Type alias: type Alias = Target;
            return this.parse_type_alias_declaration();
        }

        // Static keyword before function
        if (tok.kind == TokenType::KwStatic && this.peek_at(1).kind == TokenType::KwFunction) {
            const static_span: SourceSpan = this.span_from_token(tok);
            this.advance(); // consume 'static'
            const func: FunctionDeclNode* = this.parse_function_declaration(is_public);
            if (func != null) {
                func.set_static(true);
                func.note_modifier_span(static_span);
                if (doc != "") { func.set_documentation(doc); }
            }
            return func;
        }

        // Intrinsic declaration or intrinsic const
        if (tok.kind == TokenType::KwIntrinsic) {
            // Peek ahead: intrinsic const -> IntrinsicConstDecl
            if (this.peek_at(1).kind == TokenType::KwConst) {
                const ic: IntrinsicConstDeclNode* = this.parse_intrinsic_const_declaration();
                if (ic != null && doc != "") { ic.set_documentation(doc); }
                return ic;
            }
            const intr: IntrinsicDeclNode* = this.parse_intrinsic_declaration();
            if (intr != null && doc != "") { intr.set_documentation(doc); }
            return intr;
        }

        // Fall through to statement
        return this.parse_statement();
    }


    // Declaration Parsing

    /// Parse a variable declaration: const/mut name: Type = expr;
    /// The variable name may be a keyword used as an identifier
    /// (e.g. `mut string: String`, `const default: i32`).
    parse_variable_declaration() -> VarDeclNode* {
        const start: Token = this.current();
        const is_mutable: boolean = this.current().kind == TokenType::KwMut;
        this.advance(); // consume 'const' or 'mut'

        mut name_tok: Token = this.current();
        if (name_tok.kind == TokenType::Identifier || name_tok.kind.is_keyword()) {
            this.advance();
        } else {
            name_tok = this.consume(TokenType::Identifier, "variable name");
        }
        const name: SymbolStr = this.intern_lexeme(name_tok);
        // Only inside a function body: at depth 0 this is a module-level
        // global, which shares a namespace with functions and types and so
        // says nothing about whether a later `ident <` opens type arguments.
        if (this.scope_depth > 0) {
            this.note_local_name(name);
        }
        mut node: VarDeclNode* = new VarDeclNode(name, this.span_from_token(start));
        node.set_mutable(is_mutable);
        node.set_name_span(this.span_from_token(name_tok));
        // The leading `const`/`mut` keyword's exact span - recorded
        // separately from the whole-declaration span so E0218 can emit a
        // precise replace-keyword quickfix.
        node.set_kw_span(this.span_from_token(start));

        // Type annotation.  Normally required, but elided form
        // `const name = (params) -> Ret { ... };` is accepted when the
        // initializer is a lambda expression - the type would otherwise
        // be the redundant `(Args) -> Ret` (already written on the RHS).
        // Sema enforces the lambda-only rule and emits E0104 if a
        // non-lambda initializer (or none) appears without an annotation.
        if (this.match_tok(TokenType::Colon)) {
            const type_ann: TypeAnnotation* = this.parse_type_annotation();
            node.set_type_annotation(type_ann);
        }

        // Optional initializer
        if (this.match_tok(TokenType::Equal)) {
            const init: ExpressionNode* = this.parse_expression();
            node.set_initializer(init);
        }

        this.consume(TokenType::Semicolon, "';'");
        node.span = this.span_from(start);
        return node;
    }

    /// Parse a struct destructure declaration: `const { f1, f2: alias, mut f3 }: T = expr;`.
    /// Caller has confirmed the next-after-const/mut token is `{`.
    parse_destructure_decl() -> DestructureDeclNode* {
        const start: Token = this.current();
        const is_mutable: boolean = this.current().kind == TokenType::KwMut;
        this.advance(); // consume 'const' or 'mut'

        mut node: DestructureDeclNode* = new DestructureDeclNode(this.span_from_token(start));
        node.set_mutable(is_mutable);

        this.consume(TokenType::LBrace, "'{'");

        // Comma-separated bindings.  Empty `{}` is rejected here; the user
        // can express "consume without binding" with a unit-pattern when we
        // add rest-patterns post-v1.
        if (this.check(TokenType::RBrace)) {
            this.report_error(ErrorCode::E0104_EXPECTED_TYPE,
                "destructure pattern must bind at least one field");
        }

        mut first: boolean = true;
        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            if (!first) {
                if (!this.match_tok(TokenType::Comma)) { break; }
                if (this.check(TokenType::RBrace)) { break; } // trailing comma
            }
            first = false;

            const entry_start: Token = this.current();

            // Optional per-field `mut`
            mut entry_mut: boolean = false;
            if (this.check(TokenType::KwMut)) {
                this.advance();
                entry_mut = true;
            }

            // Source field name
            mut field_tok: Token = this.current();
            if (field_tok.kind == TokenType::Identifier || field_tok.kind.is_keyword()) {
                this.advance();
            } else {
                field_tok = this.consume(TokenType::Identifier, "field name");
            }
            const source_field: SymbolStr = this.intern_lexeme(field_tok);
            const field_span: SourceSpan = this.span_from_token(field_tok);

            // Optional `: alias` rename
            mut local_name: SymbolStr = source_field;
            mut name_span: SourceSpan = field_span;
            if (this.match_tok(TokenType::Colon)) {
                mut alias_tok: Token = this.current();
                if (alias_tok.kind == TokenType::Identifier || alias_tok.kind.is_keyword()) {
                    this.advance();
                } else {
                    alias_tok = this.consume(TokenType::Identifier, "rename target");
                }
                local_name = this.intern_lexeme(alias_tok);
                name_span = this.span_from_token(alias_tok);
            }

            const entry_span: SourceSpan = this.span_from(entry_start);
            const binding: DestructureBinding = DestructureBinding::new(
                source_field, local_name, entry_mut || is_mutable,
                entry_span, name_span);
            node.add_binding(binding);
        }

        this.consume(TokenType::RBrace, "'}'");

        // Required `: Type` annotation
        if (this.match_tok(TokenType::Colon)) {
            const type_ann: TypeAnnotation* = this.parse_type_annotation();
            node.set_type_annotation(type_ann);
        } else {
            this.report_error(ErrorCode::E0104_EXPECTED_TYPE,
                "destructure binding requires ': Type' after the pattern");
        }

        // Initializer is mandatory for destructure (can't bind fields of nothing)
        if (this.match_tok(TokenType::Equal)) {
            const init: ExpressionNode* = this.parse_expression();
            node.set_initializer(init);
        } else {
            this.report_error(ErrorCode::E0104_EXPECTED_TYPE,
                "destructure binding requires an initializer (`= expr`)");
        }

        this.consume(TokenType::Semicolon, "';'");
        node.span = this.span_from(start);
        return node;
    }

    /// Parse a function declaration: `function name<T>(params) -> RetType { body }`.
    /// The leading `function` keyword is optional: trait bodies use the
    /// keyword-less `name(params) -> RetType;` form for declarations.
    parse_function_declaration(is_public: boolean) -> FunctionDeclNode* {
        LOG_DEBUG(LogComponent::Parser, "[Parser] parse_function_declaration()");
        const start: Token = this.current();
        if (this.check(TokenType::KwFunction)) {
            this.advance(); // consume 'function'
        }
        // Accept keywords as function names (e.g., any, type, default)
        mut name_tok: Token = this.current();
        if (name_tok.kind == TokenType::Identifier || name_tok.kind.is_keyword()) {
            this.advance();
        } else {
            name_tok = this.consume(TokenType::Identifier, "function name");
        }
        const name: SymbolStr = this.intern_lexeme(name_tok);
        mut func: FunctionDeclNode* = new FunctionDeclNode(name, this.span_from_token(start));
        func.set_public(is_public);
        func.set_name_span(this.span_from_token(name_tok));

        // Optional generic parameters
        if (this.check(TokenType::LAngle)) {
            const gen_params: GenericParamNode*[] = this.parse_generic_params();
            for (mut i: int = 0; i < gen_params.length; i++) {
                func.add_generic_param(gen_params[i]);
            }
        }

        this.parse_function_param_list_into(func);

        // Optional return type
        if (this.match_tok(TokenType::Arrow)) {
            const ret_type: TypeAnnotation* = this.parse_type_annotation();
            func.set_return_type_annotation(ret_type);
        }

        // Optional where clause
        if (this.check(TokenType::KwWhere)) {
            const bounds: TraitBound[] = this.parse_trait_bounds();
            for (mut i: int = 0; i < bounds.length; i++) {
                func.add_trait_bound(bounds[i].clone());
            }
        }

        // Function body or semicolon (forward declaration)
        if (this.check(TokenType::LBrace)) {
            const body: BlockStmtNode* = this.parse_block_statement();
            func.set_body(body);
        } else {
            this.consume(TokenType::Semicolon, "';' or '{'");
        }

        func.span = this.span_from(start);
        return func;
    }

    /// Emit E0359 for `protected` (block or inline form) used inside a struct.
    /// `is_block` controls the suggestion text (`public:` vs `public`).
    emit_protected_in_struct_error(kw_tok: Token, is_block: boolean) -> void {
        const kw_span: SourceSpan = this.span_from_token(kw_tok);
        this.panic_mode = true;
        this.error_count += 1;
        const msg: string = if (is_block) {
            "`protected:` is not allowed in structs (structs do not support inheritance)"
        } else {
            "`protected` is not allowed in structs (structs do not support inheritance)"
        };
        const sugg_text: string = if (is_block) { "public" } else { "public" };
        const sugg_label: string = if (is_block) { "change to `public:`" } else { "change to `public`" };
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0359_PROTECTED_IN_STRUCT, msg);
        diag = diag.at(kw_span);
        diag = diag.suggest(Suggestion::single(kw_span, sugg_text, sugg_label,
            Applicability::MaybeIncorrect));
        this.ctx.emit_diagnostic(diag);
    }

    /// Parse `'(' params ')'` directly into `func`, also forwarding bare
    /// (`...`) and named (`name...`) variadic markers. Shared by free-fn,
    /// method, and constructor parsing so the variadic-detection rules don't
    /// drift across the three sites.
    parse_function_param_list_into(func: FunctionDeclNode*) -> void {
        this.consume(TokenType::LParen, "'('");
        if (!this.check(TokenType::RParen)) {
            const params: VarDeclNode*[] = this.parse_parameter_list();
            for (mut i: int = 0; i < params.length; i++) {
                func.add_parameter(params[i]);
            }
        }
        if (this.pending_bare_variadic || this.pending_named_variadic) {
            func.set_variadic(true);
            this.pending_bare_variadic  = false;
            this.pending_named_variadic = false;
        }
        this.consume(TokenType::RParen, "')'");
    }

    /// Parse a parameter list (inside parentheses).
    ///
    /// A bare `...` (no accompanying name) sets `this.pending_bare_variadic`
    /// instead of producing a parameter; the named form `args...` sets
    /// `this.pending_named_variadic` after pushing the parameter. Callers
    /// forward either flag onto the function node they're building.
    parse_parameter_list() -> VarDeclNode*[] {
        mut params: VarDeclNode*[] = [];
        this.pending_bare_variadic  = false;
        this.pending_named_variadic = false;
        // Every function and method reaches its body through here, so this is
        // where the previous one's bindings stop being in scope.
        this.reset_local_names();

        while (true) {
            // Bare variadic: `...` with no preceding name. Common in extern
            // C declarations like `printf(format: string, ...)`.
            if (this.check(TokenType::Ellipsis)) {
                this.advance();
                this.pending_bare_variadic = true;
                break;
            }

            const param: VarDeclNode* = this.parse_parameter();
            if (param != null) {
                this.note_local_name(param.name);
                params.push(param);
            }

            if (!this.match_tok(TokenType::Comma)) {
                break;
            }
        }

        return params;
    }

    /// Parse a single parameter: [mut] name: Type [= default]
    parse_parameter() -> VarDeclNode* {
        const start: Token = this.current();
        mut is_mutable: boolean = false;
        // Span of the leading `mut` keyword if present; otherwise an
        // anchor for "insert `mut` here" - used by E0218 to suggest
        // marking a param mutable in place.
        mut kw_span: SourceSpan = SourceSpan::none();

        // Optional 'mut' keyword
        if (this.check(TokenType::KwMut)) {
            is_mutable = true;
            kw_span = this.span_from_token(start);
            this.advance();
        }

        // Check for &this parameter (method self reference). Synthesize the
        // reference-to-receiver type annotation so FunctionSignature can
        // resolve the self parameter: inside a struct/class/impl the receiver
        // is `&CurrentType`; inside a trait declaration it is `&This`, a
        // placeholder that downstream impl-method resolution rewrites to
        // each concrete impl target.
        if (this.check(TokenType::Amp) && this.peek_at(1).kind == TokenType::KwThis) {
            this.advance(); // consume '&'
            this.advance(); // consume 'this'
            const pname: SymbolStr = this.ctx.intern("&this");
            const span: SourceSpan = this.span_from(start);
            mut param: VarDeclNode* = new VarDeclNode(pname, span);
            param.set_mutable(is_mutable);

            mut inner: TypeAnnotation* = null;
            if (this.current_type_name != "") {
                const type_name: SymbolStr = this.ctx.intern(this.current_type_name);
                // The receiver of `implement string { ... }` denotes the
                // primitive, not a name to look up.  This synthesis runs from
                // the impl target's TEXT rather than its token, so the token
                // test that shapes every written annotation cannot be reached
                // from here; asking the keyword table restores it.  Without
                // this the receiver is a named annotation no scope can answer,
                // and it resolves only by falling through a name lookup into
                // the same primitive table the keyword names directly.
                if (TokenType::from_keyword(this.current_type_name).is_primitive_type()) {
                    const prim_ann: PrimitiveAnnotation* = new PrimitiveAnnotation {
                        name: type_name,
                        span: span,
                    };
                    inner = new TypeAnnotation::Primitive(prim_ann);
                } else if (this.current_type_name == "()") {
                    // The unit target is spelled `()`, which is not a keyword,
                    // so the primitive test above cannot reach it.  A WRITTEN
                    // `()` parses as the empty tuple, and the unit type has no
                    // named form - `ASTTypeSubstituter::rewrite_to_unit` states
                    // the same rule for substitution.  Synthesizing a name here
                    // would give `implement trait Drop for ()` a receiver that
                    // no scope can answer, purely because the receiver is typed
                    // from the target's TEXT rather than its syntax.
                    mut unit_elems: TypeAnnotation*[] = [];
                    const tup_ann: TupleAnnotation* = new TupleAnnotation {
                        elements: unit_elems,
                        span:     span,
                    };
                    inner = new TypeAnnotation::Tuple(tup_ann);
                } else {
                    const named_ann: NamedAnnotation* = new NamedAnnotation {
                        name: type_name,
                        span: span,
                        pre_resolved: TypeRef::invalid(),
                        res: ResSlot::Pending,
                    };
                    inner = new TypeAnnotation::Named(named_ann);
                }
            } else {
                const tt_ann: ThisTypeAnnotation* = new ThisTypeAnnotation { span: span };
                inner = new TypeAnnotation::ThisType(tt_ann);
            }
            const ref_ann: ReferenceAnnotation* = new ReferenceAnnotation {
                inner:      inner,
                is_mutable: is_mutable,
                span:       span,
            };
            param.set_type_annotation(new TypeAnnotation::Reference(ref_ann));

            return param;
        }

        // Accept keywords as parameter names (e.g., this, default, type, value).
        // Keywords like 'this' for pass-by-value self, 'default' for fallback values, etc.
        // are common parameter names that shouldn't be reserved.
        mut name_tok: Token = this.current();
        if (name_tok.kind == TokenType::Identifier || name_tok.kind.is_keyword()) {
            this.advance();
        } else {
            name_tok = this.consume(TokenType::Identifier, "parameter name");
        }
        const pname: SymbolStr = this.intern_lexeme(name_tok);
        mut param: VarDeclNode* = new VarDeclNode(pname, this.span_from_token(name_tok));
        param.set_mutable(is_mutable);
        param.set_name_span(this.span_from_token(name_tok));
        // If no `mut` keyword was consumed, point kw_span at a zero-width
        // anchor just before the parameter name so a downstream E0218
        // fix can insert `mut ` at exactly the right place.
        if (!kw_span.has_location()) {
            const ns: SourceSpan = this.span_from_token(name_tok);
            kw_span = SourceSpan::new(ns.file, ns.start_line, ns.start_col,
                                      ns.start_line, ns.start_col);
        }
        param.set_kw_span(kw_span);

        // Variadic parameter: name... (e.g., args...). Signal the caller
        // by setting pending_named_variadic; the param itself has no type
        // annotation but remains in the parameter list so the body can
        // reference it by name.
        if (this.check(TokenType::Ellipsis)) {
            this.advance(); // consume '...'
            param.set_mutable(false);
            this.pending_named_variadic = true;
            return param;
        }

        // Type annotation
        if (this.match_tok(TokenType::Colon)) {
            const type_ann: TypeAnnotation* = this.parse_type_annotation();
            param.set_type_annotation(type_ann);
        }

        // Default value
        if (this.match_tok(TokenType::Equal)) {
            const default_val: ExpressionNode* = this.parse_expression();
            param.set_initializer(default_val);
        }

        param.span = this.span_from(start);
        return param;
    }

    /// Parse a struct declaration: type struct Name<T> { fields, methods }
    parse_struct_declaration() -> StructDeclNode* {
        LOG_DEBUG(LogComponent::Parser, "[Parser] parse_struct_declaration()");
        const start: Token = this.advance(); // consume 'type'
        this.advance(); // consume 'struct'

        const name_tok: Token = this.consume(TokenType::Identifier, "struct name");
        const name: SymbolStr = this.intern_lexeme(name_tok);
        mut node: StructDeclNode* = new StructDeclNode(name, this.span_from_token(start));
        node.set_name_span(this.span_from_token(name_tok));
        this.current_type_name = name_tok.lexeme;

        // Optional generic parameters
        if (this.check(TokenType::LAngle)) {
            const gen_params: GenericParamNode*[] = this.parse_generic_params();
            for (mut i: int = 0; i < gen_params.length; i++) {
                node.add_generic_param(gen_params[i]);
            }
        }

        this.consume(TokenType::LBrace, "'{'");
        this.parse_type_body(node, null, null);
        this.consume(TokenType::RBrace, "'}'");

        this.current_type_name = "";
        node.span = this.span_from(start);
        return node;
    }

    /// Parse a union declaration: type union Name<T> { fields, methods }
    /// Shares the struct member-grammar; an untagged C-style union where all
    /// fields overlap at offset 0 (see UnionDeclNode).
    parse_union_declaration() -> UnionDeclNode* {
        LOG_DEBUG(LogComponent::Parser, "[Parser] parse_union_declaration()");
        const start: Token = this.advance(); // consume 'type'
        this.advance(); // consume 'union'

        const name_tok: Token = this.consume(TokenType::Identifier, "union name");
        const name: SymbolStr = this.intern_lexeme(name_tok);
        mut node: UnionDeclNode* = new UnionDeclNode(name, this.span_from_token(start));
        node.set_name_span(this.span_from_token(name_tok));
        this.current_type_name = name_tok.lexeme;

        // Optional generic parameters
        if (this.check(TokenType::LAngle)) {
            const gen_params: GenericParamNode*[] = this.parse_generic_params();
            for (mut i: int = 0; i < gen_params.length; i++) {
                node.add_generic_param(gen_params[i]);
            }
        }

        this.consume(TokenType::LBrace, "'{'");
        this.parse_type_body(null, null, node);
        this.consume(TokenType::RBrace, "'}'");

        this.current_type_name = "";
        node.span = this.span_from(start);
        return node;
    }

    /// Parse a class declaration: type class Name<T> : Base { fields, methods }
    parse_class_declaration() -> ClassDeclNode* {
        LOG_DEBUG(LogComponent::Parser, "[Parser] parse_class_declaration()");
        const start: Token = this.advance(); // consume 'type'
        this.advance(); // consume 'class'

        const name_tok: Token = this.consume(TokenType::Identifier, "class name");
        const name: SymbolStr = this.intern_lexeme(name_tok);
        mut node: ClassDeclNode* = new ClassDeclNode(name, this.span_from_token(start));
        node.set_name_span(this.span_from_token(name_tok));
        this.current_type_name = name_tok.lexeme;

        // Optional generic parameters
        if (this.check(TokenType::LAngle)) {
            const gen_params: GenericParamNode*[] = this.parse_generic_params();
            for (mut i: int = 0; i < gen_params.length; i++) {
                node.add_generic_param(gen_params[i]);
            }
        }

        // Optional base class: : BaseClass
        if (this.match_tok(TokenType::Colon)) {
            const base_tok: Token = this.consume(TokenType::Identifier, "base class name");
            node.set_base_class(this.intern_lexeme(base_tok),
                                this.span_from_token(base_tok));
        }

        this.consume(TokenType::LBrace, "'{'");
        this.parse_type_body(null, node, null);
        this.consume(TokenType::RBrace, "'}'");

        this.current_type_name = "";
        node.span = this.span_from(start);
        return node;
    }

    /// Parse the body of a struct or class declaration (fields, methods, visibility).
    ///
    /// Visibility rules:
    ///   Struct: all members default to public.  `public:` and `private:` blocks
    ///            are allowed but optional.  `protected:` is an error (no inheritance).
    ///   Class: no default visibility.  Every member MUST appear inside an explicit
    ///            `public:`, `private:`, or `protected:` block.
    parse_type_body(struct_node: StructDeclNode*, class_node: ClassDeclNode*,
                    union_node: UnionDeclNode*) -> void {
        // Unions share the struct member-grammar (default-public, no
        // `protected`); only their layout/codegen differ.
        const is_struct: boolean = (struct_node != null) || (union_node != null);

        // Structs default to public; classes have no default (sentinel).
        mut current_visibility: Visibility = Visibility::Public;
        mut has_visibility_block: boolean = is_struct;  // structs implicitly "have" one

        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            this.collect_doc_comments();
            if (this.check(TokenType::RBrace)) { break; }
            const doc: string = this.take_documentation();

            // Visibility labels: public: / private: / protected:
            if (this.peek_at(1).kind == TokenType::Colon) {
                mut matched: boolean = true;
                match (this.current().kind) {
                    TokenType::KwPublic    => { current_visibility = Visibility::Public; }
                    TokenType::KwPrivate   => { current_visibility = Visibility::Private; }
                    TokenType::KwProtected => {
                        if (is_struct) {
                            this.emit_protected_in_struct_error(this.current(), true);
                            current_visibility = Visibility::Public;
                        } else {
                            current_visibility = Visibility::Protected;
                        }
                    }
                    _ => { matched = false; }
                }
                if (matched) {
                    has_visibility_block = true;
                    this.advance(); this.advance(); // consume keyword + ':'
                    continue;
                }
            }

            // Inline visibility for the next member: `private foo()`,
            // `public bar: T;`, or `protected baz()`.  Distinguished
            // from block-form labels (above) by the absence of a
            // trailing `:`.  Applies to one member only; the block-
            // level `current_visibility` is untouched, so a single
            // inline opt-out doesn't shift the rest of the section.
            mut member_visibility: Visibility = current_visibility;
            mut had_inline_visibility: boolean = false;
            // Where that inline keyword sat, for the member's `outer_span()`:
            // it is consumed here, before the member node exists, so nothing
            // else records it.  Stays `none()` for block-form visibility,
            // whose label is not part of any one member.
            mut member_modifier_span: SourceSpan = SourceSpan::none();
            if (this.peek_at(1).kind != TokenType::Colon) {
                mut matched: boolean = true;
                match (this.current().kind) {
                    TokenType::KwPublic    => { member_visibility = Visibility::Public; }
                    TokenType::KwPrivate   => { member_visibility = Visibility::Private; }
                    TokenType::KwProtected => {
                        if (is_struct) {
                            this.emit_protected_in_struct_error(this.current(), false);
                            this.advance();
                            continue;
                        }
                        member_visibility = Visibility::Protected;
                    }
                    _ => { matched = false; }
                }
                if (matched) {
                    had_inline_visibility = true;
                    member_modifier_span = this.span_from_token(this.current());
                    this.advance(); // consume keyword
                }
            }

            // For classes, every member must declare visibility; either
            // via a block marker (`public:`) or an inline keyword
            // (`private foo()`).  Structs default to public so the
            // check is class-only.
            if (!has_visibility_block && !had_inline_visibility) {
                this.report_error(ErrorCode::E0360_MISSING_VISIBILITY_BLOCK,
                    "class members must declare visibility (block-form `public:` / `private:` / `protected:`, or inline `public` / `private` / `protected`)");
            }

            // Drain consecutive `![...]` directives so we can attach them
            // to the next member.  Visibility labels above already
            // continue'd past this point, so directives placed between
            // labels and members reach this drain.  If the next thing
            // turns out to be a field, the directives are still attached
            // (FieldDeclNode is a DeclarationNode); the directive_
            // processing pass will surface a placement error if the
            // directive isn't valid on a field.
            mut pending_dirs: DirectiveNode*[] = [];
            while (this.check(TokenType::BangBracket)) {
                const d: DirectiveNode* = this.parse_directive();
                if (d != null) { pending_dirs.push(d); }
                this.collect_doc_comments();
                if (this.check(TokenType::RBrace) || this.is_at_end()) { break; }
            }
            if (this.check(TokenType::RBrace) || this.is_at_end()) { break; }

            // A leading `async` is consumed ahead of the member head, so every
            // member kind below sees it: only a method can carry it, and the
            // kinds that cannot are rejected where they are built rather than
            // dropping the keyword silently. `static` is deliberately NOT
            // hoisted here — `static Name()` has always meant a static method
            // named after the type, not a constructor, and hoisting it would
            // change that.
            mut member_is_async: boolean = false;
            if (this.check(TokenType::KwAsync) && this.at_method_modifier()) {
                member_is_async = true;
                member_modifier_span = SourceSpan::covering(member_modifier_span,
                    this.span_from_token(this.current()));
                this.advance();
            }

            // Constructor: ClassName(params) { body }
            if (this.check(TokenType::Identifier) && this.current().lexeme == this.current_type_name &&
                this.peek_at(1).kind == TokenType::LParen) {
                const method: MethodNode* = this.parse_constructor(member_visibility);
                if (method != null) {
                    // A constructor runs to completion at a fixed point in an
                    // object's lifetime: it has no caller that could hold and
                    // poll a future, and the object does not exist until it
                    // returns.
                    if (member_is_async) {
                        this.report_invalid_at(ErrorCode::E0364_INVALID_ASYNC_MEMBER,
                            "a constructor cannot be `async`: it must produce a fully initialized object before any caller can observe it, so there is nothing to suspend into",
                            member_modifier_span);
                    }
                    if (doc != "") { method.set_documentation(doc); }
                    for (mut pi: i64 = 0; pi < pending_dirs.length; pi++) {
                        method.add_directive(pending_dirs[pi]);
                    }
                    method.note_modifier_span(member_modifier_span);
                    if (struct_node != null) { struct_node.add_method(method); }
                    if (class_node != null) { class_node.add_method(method); }
                    if (union_node != null) { union_node.add_method(method); }
                }
                continue;
            }

            // Destructor: ~ClassName() { body }
            if (this.check(TokenType::Tilde)) {
                const method: MethodNode* = this.parse_destructor(member_visibility);
                if (method != null) {
                    // A destructor is called by drop insertion at scope exit,
                    // from contexts that have no executor and cannot wait.
                    if (member_is_async) {
                        this.report_invalid_at(ErrorCode::E0364_INVALID_ASYNC_MEMBER,
                            "a destructor cannot be `async`: it is called by drop insertion at scope exit, where there is no executor to poll a future",
                            member_modifier_span);
                    }
                    if (doc != "") { method.set_documentation(doc); }
                    for (mut pi: i64 = 0; pi < pending_dirs.length; pi++) {
                        method.add_directive(pending_dirs[pi]);
                    }
                    method.note_modifier_span(member_modifier_span);
                    if (struct_node != null) { struct_node.add_method(method); }
                    if (class_node != null) { class_node.add_method(method); }
                    if (union_node != null) { union_node.add_method(method); }
                }
                continue;
            }

            // Static method or static field
            if (this.check(TokenType::KwStatic)) {
                const method: MethodNode* = this.parse_method_with_modifiers(
                    member_visibility, true, false, false, member_is_async);
                if (method != null) {
                    if (doc != "") { method.set_documentation(doc); }
                    for (mut pi: i64 = 0; pi < pending_dirs.length; pi++) {
                        method.add_directive(pending_dirs[pi]);
                    }
                    method.note_modifier_span(member_modifier_span);
                    if (struct_node != null) { struct_node.add_method(method); }
                    if (class_node != null) { class_node.add_method(method); }
                    if (union_node != null) { union_node.add_method(method); }
                }
                continue;
            }

            // Virtual method
            if (this.check(TokenType::KwVirtual)) {
                const method: MethodNode* = this.parse_method_with_modifiers(
                    member_visibility, false, true, false, member_is_async);
                if (method != null) {
                    if (doc != "") { method.set_documentation(doc); }
                    for (mut pi: i64 = 0; pi < pending_dirs.length; pi++) {
                        method.add_directive(pending_dirs[pi]);
                    }
                    method.note_modifier_span(member_modifier_span);
                    if (struct_node != null) { struct_node.add_method(method); }
                    if (class_node != null) { class_node.add_method(method); }
                    if (union_node != null) { union_node.add_method(method); }
                }
                continue;
            }

            // Override method
            if (this.check(TokenType::KwOverride)) {
                const method: MethodNode* = this.parse_method_with_modifiers(
                    member_visibility, false, false, true, member_is_async);
                if (method != null) {
                    if (doc != "") { method.set_documentation(doc); }
                    for (mut pi: i64 = 0; pi < pending_dirs.length; pi++) {
                        method.add_directive(pending_dirs[pi]);
                    }
                    method.note_modifier_span(member_modifier_span);
                    if (struct_node != null) { struct_node.add_method(method); }
                    if (class_node != null) { class_node.add_method(method); }
                    if (union_node != null) { union_node.add_method(method); }
                }
                continue;
            }

            // Method: name(params) -> RetType { body }
            // Or field: name: Type;
            // `name` is normally an Identifier, but a keyword may name a
            // method (`as<T>()`, `type()`) or a field (`type: u32;`);
            // mirrors the keyword-as-member-name support after `.` and `::`.
            // What follows the name decides which: `(`/`<` means method, `:`
            // means field.  A C header is free to use `type` as a member name
            // and the binding generator cannot rename it without breaking the
            // ABI it exists to preserve, so a member position that rejects
            // keywords makes such a field unreachable from the language.
            if (this.check(TokenType::Identifier) || this.current().kind.is_keyword()) {
                // Disambiguate: method vs field
                // Method pattern: name ( or name < (generic method)
                const next: Token = this.peek_at(1);
                if (next.kind == TokenType::LParen || next.kind == TokenType::LAngle) {
                    const method: MethodNode* = this.parse_method(member_visibility);
                    if (method != null) {
                        if (member_is_async && method.func != null) { method.func.set_async(true); }
                        if (doc != "") { method.set_documentation(doc); }
                        for (mut pi: i64 = 0; pi < pending_dirs.length; pi++) {
                            method.add_directive(pending_dirs[pi]);
                        }
                        method.note_modifier_span(member_modifier_span);
                        if (struct_node != null) { struct_node.add_method(method); }
                        if (class_node != null) { class_node.add_method(method); }
                        if (union_node != null) { union_node.add_method(method); }
                    }
                } else if (this.check(TokenType::Identifier)
                           || next.kind == TokenType::Colon) {
                    if (member_is_async) {
                        this.report_invalid_at(ErrorCode::E0364_INVALID_ASYNC_MEMBER,
                            "only a method can be `async`; a field holds a value, not a computation to suspend",
                            member_modifier_span);
                    }
                    const field: FieldDeclNode* = this.parse_field_declaration();
                    if (field != null) {
                        field.set_visibility(member_visibility);
                        if (doc != "") { field.set_documentation(doc); }
                        for (mut pi: i64 = 0; pi < pending_dirs.length; pi++) {
                            field.add_directive(pending_dirs[pi]);
                        }
                        field.note_modifier_span(member_modifier_span);
                        if (struct_node != null) { struct_node.add_field(field); }
                        if (class_node != null) { class_node.add_field(field); }
                        if (union_node != null) { union_node.add_field(field); }
                    }
                } else {
                    // A keyword followed by neither `(`/`<` nor `:` names no
                    // member shape that exists.
                    this.error_unexpected();
                    this.advance();
                }
                continue;
            }

            // Unknown token in type body
            this.error_unexpected();
            this.advance();
        }

    }

    /// Parse a constructor: ClassName(params) [: BaseClass(args)] { body }
    parse_constructor(visibility: Visibility) -> MethodNode* {
        const start: Token = this.current();
        const name_tok: Token = this.advance(); // consume class name
        const name: SymbolStr = this.intern_lexeme(name_tok);

        // Parse as function declaration
        mut func: FunctionDeclNode* = new FunctionDeclNode(name, this.span_from_token(start));

        this.parse_function_param_list_into(func);

        mut method: MethodNode* = new MethodNode(func, this.span_from_token(start));
        method.set_constructor(true);
        method.set_visibility(visibility);

        // Optional base constructor call: : Base(args)
        if (this.match_tok(TokenType::Colon)) {
            const base_tok: Token = this.consume(TokenType::Identifier, "base class name");
            method.set_base_ctor_name(this.intern_lexeme(base_tok));
            this.consume(TokenType::LParen, "'('");
            while (!this.check(TokenType::RParen) && !this.is_at_end()) {
                const arg: ExpressionNode* = this.parse_expression();
                if (arg != null) {
                    method.add_base_ctor_arg(arg);
                }
                if (!this.match_tok(TokenType::Comma)) { break; }
            }
            this.consume(TokenType::RParen, "')'");
        }

        // Optional return type: -> Type (allowed on constructors for factory patterns)
        if (this.match_tok(TokenType::Arrow)) {
            const ret_ann: TypeAnnotation* = this.parse_type_annotation();
            func.set_return_type_annotation(ret_ann);
        }

        // Body
        if (this.check(TokenType::LBrace)) {
            const body: BlockStmtNode* = this.parse_block_statement();
            func.set_body(body);
        }

        method.span = this.span_from(start);
        return method;
    }

    /// Parse a destructor: ~ClassName() { body }
    parse_destructor(visibility: Visibility) -> MethodNode* {
        const start: Token = this.advance(); // consume '~'
        const name_tok: Token = this.advance(); // consume class name
        const name: SymbolStr = this.ctx.intern("~" + name_tok.lexeme);

        mut func: FunctionDeclNode* = new FunctionDeclNode(name, this.span_from_token(start));

        this.consume(TokenType::LParen, "'('");
        this.consume(TokenType::RParen, "')'");

        mut method: MethodNode* = new MethodNode(func, this.span_from_token(start));
        method.set_destructor(true);
        method.set_visibility(visibility);

        // Check for = default
        if (this.match_tok(TokenType::Equal)) {
            if (this.check(TokenType::KwDefault)) {
                this.advance();
                method.set_default_destructor(true);
                this.consume(TokenType::Semicolon, "';'");
                method.span = this.span_from(start);
                return method;
            }
        }

        if (this.check(TokenType::LBrace)) {
            const body: BlockStmtNode* = this.parse_block_statement();
            func.set_body(body);
        }

        method.span = this.span_from(start);
        return method;
    }

    /// True when the current token is a method MODIFIER keyword rather than a
    /// method NAME.
    ///
    /// A keyword may legally name a method (`as<T>()`, `type()`), so `static` /
    /// `async` read as modifiers only when what follows is neither a parameter
    /// list nor a generic-parameter list. Without this test, declaring a method
    /// called `async` or `static` would stop parsing.
    at_method_modifier() -> boolean {
        if (!this.check(TokenType::KwStatic) && !this.check(TokenType::KwAsync)) { return false; }
        const next: TokenType = this.peek_at(1).kind;
        return next != TokenType::LParen && next != TokenType::LAngle;
    }

    /// Consume the run of `static` / `async` keywords at the cursor. They may
    /// appear in either order and both may be present, so `static async f()`
    /// and `async static f()` are the same declaration. `prefix` seeds the
    /// returned extent, so a visibility keyword already consumed by the caller
    /// stays part of the member's `outer_span()`.
    consume_method_modifiers(prefix: SourceSpan) -> MethodModifiers {
        mut m: MethodModifiers = MethodModifiers {
            is_static: false, is_async: false, span: prefix };
        while (this.at_method_modifier()) {
            if (this.check(TokenType::KwStatic)) { m.is_static = true; } else { m.is_async = true; }
            m.span = SourceSpan::covering(m.span, this.span_from_token(this.current()));
            this.advance();
        }
        return m;
    }

    /// Parse a method with optional modifiers (static, async, virtual, override).
    ///
    /// The keyword that selected this path is still at the cursor and is
    /// consumed here; a `static` / `async` run may follow it. `virtual async` /
    /// `override async` are accepted by the grammar and rejected by sema, which
    /// can say why (each override would return a different future type, so they
    /// cannot share a vtable slot) instead of leaving a parse error on `async`.
    parse_method_with_modifiers(visibility: Visibility, is_static: boolean,
                                 is_virtual: boolean, is_override: boolean,
                                 is_async: boolean) -> MethodNode* {
        this.advance(); // consume modifier keyword
        const extra: MethodModifiers = this.consume_method_modifiers(SourceSpan::none());

        const method: MethodNode* = this.parse_method(visibility);
        if (method != null) {
            if (is_static || extra.is_static) { method.set_static(true); }
            if (is_virtual) { method.set_virtual(true); }
            if (is_override) { method.set_override(true); }
            if ((is_async || extra.is_async) && method.func != null) { method.func.set_async(true); }
        }
        return method;
    }

    /// Parse a method: name<T>(params) -> RetType { body }
    parse_method(visibility: Visibility) -> MethodNode* {
        const start: Token = this.current();
        const name_tok: Token = this.advance(); // consume method name
        const name: SymbolStr = this.intern_lexeme(name_tok);

        mut func: FunctionDeclNode* = new FunctionDeclNode(name, this.span_from_token(start));
        func.set_name_span(this.span_from_token(name_tok));

        // Optional generic parameters
        if (this.check(TokenType::LAngle)) {
            const gen_params: GenericParamNode*[] = this.parse_generic_params();
            for (mut i: int = 0; i < gen_params.length; i++) {
                func.add_generic_param(gen_params[i]);
            }
        }

        this.parse_function_param_list_into(func);

        // Optional return type
        if (this.match_tok(TokenType::Arrow)) {
            const ret_type: TypeAnnotation* = this.parse_type_annotation();
            func.set_return_type_annotation(ret_type);
        }

        // Optional `where T: Bound` clause; methods may further constrain
        // the enclosing impl's generic parameters.
        if (this.check(TokenType::KwWhere)) {
            const bounds: TraitBound[] = this.parse_trait_bounds();
            for (mut wi: int = 0; wi < bounds.length; wi++) {
                func.add_trait_bound(bounds[wi].clone());
            }
        }

        mut method: MethodNode* = new MethodNode(func, this.span_from_token(start));
        method.set_visibility(visibility);

        // Body or semicolon
        if (this.check(TokenType::LBrace)) {
            const body: BlockStmtNode* = this.parse_block_statement();
            func.set_body(body);
        } else {
            this.consume(TokenType::Semicolon, "';' or '{'");
        }

        method.span = this.span_from(start);
        return method;
    }

    /// Parse a field declaration: name: Type [= default];
    parse_field_declaration() -> FieldDeclNode* {
        const start: Token = this.current();
        const name_tok: Token = this.advance(); // consume field name
        const name: SymbolStr = this.intern_lexeme(name_tok);
        mut field: FieldDeclNode* = new FieldDeclNode(name, this.span_from_token(start));
        field.set_name_span(this.span_from_token(name_tok));

        // Type annotation
        this.consume(TokenType::Colon, "':'");
        const type_ann: TypeAnnotation* = this.parse_type_annotation();
        field.set_type_annotation(type_ann);

        // Optional default value
        if (this.match_tok(TokenType::Equal)) {
            const default_val: ExpressionNode* = this.parse_expression();
            field.set_default_value(default_val);
        }

        this.consume(TokenType::Semicolon, "';'");
        field.span = this.span_from(start);
        return field;
    }

    /// Parse an enum declaration: type enum Name<T> { variants }
    parse_enum_declaration() -> EnumDeclNode* {
        LOG_DEBUG(LogComponent::Parser, "[Parser] parse_enum_declaration()");
        const start: Token = this.advance(); // consume 'type'
        this.advance(); // consume 'enum'

        const name_tok: Token = this.consume(TokenType::Identifier, "enum name");
        const name: SymbolStr = this.intern_lexeme(name_tok);
        mut node: EnumDeclNode* = new EnumDeclNode(name, this.span_from_token(start));
        node.set_name_span(this.span_from_token(name_tok));

        // Optional generic parameters
        if (this.check(TokenType::LAngle)) {
            const gen_params: GenericParamNode*[] = this.parse_generic_params();
            for (mut i: int = 0; i < gen_params.length; i++) {
                node.add_generic_param(gen_params[i]);
            }
        }

        // Optional explicit discriminant type: `type enum Foo : i32 { ... }`.
        // Used by FFI enums whose values need a specific ABI width.
        if (this.match_tok(TokenType::Colon)) {
            const disc: TypeAnnotation* = this.parse_type_annotation();
            if (disc != null) {
                node.set_discriminant_annotation(disc);
            }
        }

        this.consume(TokenType::LBrace, "'{'");

        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            const before_pos: int = this.pos;
            this.collect_doc_comments();
            if (this.check(TokenType::RBrace)) { break; }
            const doc: string = this.take_documentation();

            const variant: EnumVariantNode* = this.parse_enum_variant();
            if (variant != null) {
                if (doc != "") { variant.set_documentation(doc); }
                node.add_variant(variant);
            }

            // Progress guard: parse_enum_variant recovers via non-advancing
            // consume(), so a stray separator (e.g. a Rust-style `,` between
            // variants, where Cryo expects `;`) parks the cursor on the
            // offending token and the loop would spin forever.  Skip it so
            // the error is reported once and parsing continues.
            if (this.pos == before_pos) { this.advance(); }
        }

        this.consume(TokenType::RBrace, "'}'");
        node.span = this.span_from(start);
        return node;
    }

    /// Parse an enum variant: Name; or Name(Type); or Name = value;
    parse_enum_variant() -> EnumVariantNode* {
        const start: Token = this.current();
        const name_tok: Token = this.consume(TokenType::Identifier, "variant name");
        const name: SymbolStr = this.intern_lexeme(name_tok);
        mut variant: EnumVariantNode* = new EnumVariantNode(name, this.span_from_token(start));
        variant.set_name_span(this.span_from_token(name_tok));

        // Associated types: Variant(Type1, Type2)
        // Uses parse_type_annotation() so generics, pointers, arrays, etc.
        // are parsed into structured TypeAnnotation* trees; no flat strings.
        if (this.check(TokenType::LParen)) {
            this.advance();
            while (!this.check(TokenType::RParen) && !this.is_at_end()) {
                const ann: TypeAnnotation* = this.parse_type_annotation();
                if (ann != null) {
                    variant.add_associated_type(ann);
                }
                if (!this.match_tok(TokenType::Comma)) { break; }
            }
            this.consume(TokenType::RParen, "')'");
        }

        // Explicit value: Variant = 42  (also accepts 0x2A, 0b101010, 052)
        if (this.match_tok(TokenType::Equal)) {
            mut sign: i64 = 1;
            if (this.match_tok(TokenType::Minus)) { sign = -1; }
            else if (this.match_tok(TokenType::Plus)) { sign = 1; }
            const val_tok: Token = this.current();
            if (val_tok.kind == TokenType::NumericConstant) {
                this.advance();
                const v: i64 = ParserBase::parse_numeric_lexeme_i64(val_tok.lexeme);
                variant.set_explicit_value(sign * v);
            } else {
                this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                    format("expected integer literal after '=', found '%s'",
                        val_tok.lexeme));
            }
        }

        this.consume(TokenType::Semicolon, "';'");
        variant.span = this.span_from(start);
        return variant;
    }

    /// Parse a trait declaration: type trait Name<T> [: Base] { methods }
    parse_trait_declaration() -> TraitDeclNode* {
        LOG_DEBUG(LogComponent::Parser, "[Parser] parse_trait_declaration()");
        const start: Token = this.advance(); // consume 'type'
        this.advance(); // consume 'trait'

        const name_tok: Token = this.consume(TokenType::Identifier, "trait name");
        const name: SymbolStr = this.intern_lexeme(name_tok);
        mut node: TraitDeclNode* = new TraitDeclNode(name, this.span_from_token(start));
        node.set_name_span(this.span_from_token(name_tok));

        // Optional generic parameters
        if (this.check(TokenType::LAngle)) {
            const gen_params: GenericParamNode*[] = this.parse_generic_params();
            for (mut i: int = 0; i < gen_params.length; i++) {
                node.add_generic_param(gen_params[i]);
            }
        }

        // Optional base traits: : Trait1, Trait2<T>
        if (this.match_tok(TokenType::Colon)) {
            while (true) {
                const base_tok: Token = this.consume(TokenType::Identifier, "base trait name");
                const base_name: SymbolStr = this.intern_lexeme(base_tok);
                mut type_args: TypeAnnotation*[] = [];

                if (this.check(TokenType::LAngle)) {
                    type_args = this.parse_generic_args();
                }

                const info: BaseTraitInfo = BaseTraitInfo {
                    name:            base_name,
                    type_parameters: type_args,
                };
                node.add_base_trait(info);

                if (!this.match_tok(TokenType::Comma)) { break; }
            }
        }

        this.consume(TokenType::LBrace, "'{'");

        // Parse trait methods (declarations, possibly with default bodies).
        // Each method may carry an optional `static` modifier (no receiver).
        // Method bodies use the keyword-less `name(params) -> Ret { body }`
        // form; parse_function_declaration treats the leading `function`
        // keyword as optional.
        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            this.collect_doc_comments();
            if (this.check(TokenType::RBrace)) { break; }

            // Associated-type member: `type Item;` or `type Item: Bound;`.
            // Intercepted before the method path because `type` is a keyword
            // and would otherwise be taken as a (keyword-named) method head.
            if (this.check(TokenType::KwType)) {
                const assoc: AssocTypeDeclNode* = this.parse_assoc_type_decl();
                if (assoc != null) { node.add_assoc_type(assoc); }
                continue;
            }

            // An `async` trait method IS allowed: it desugars to an implicit
            // associated type plus a projection return (`type ReadFut;` and
            // `read(&this, n) -> This::ReadFut`), which each impl binds to its
            // own synthesized future. `is_async` is kept on the node and
            // `TypeResolutionPasses::desugar_async_trait_methods` performs that
            // rewrite once the trait's signatures resolve.
            mut trait_mods: MethodModifiers = this.consume_method_modifiers(SourceSpan::none());
            const is_static: boolean = trait_mods.is_static;

            // Method name can be an identifier OR a keyword used as a name
            // (e.g. `from`, `default`, `into`). The leading `function`
            // keyword is also accepted for explicit declarations.
            const head: TokenType = this.current().kind;
            if (head == TokenType::Identifier || head == TokenType::KwFunction
                || head.is_keyword()) {
                const func: FunctionDeclNode* = this.parse_function_declaration(false);
                if (func != null) {
                    if (is_static) { func.set_static(true); }
                    if (trait_mods.is_async) { func.set_async(true); }
                    node.add_method(func);
                }
            } else {
                this.error_unexpected();
                this.advance();
            }
        }

        this.consume(TokenType::RBrace, "'}'");
        node.span = this.span_from(start);
        return node;
    }

    /// Parse an associated-type declaration inside a trait body:
    /// `type Item;` or `type Item: Copy + Clone;`. The leading `type` keyword
    /// is consumed here. Declaration-site bounds are captured as trait refs
    /// (empty for the unbounded form).
    parse_assoc_type_decl() -> AssocTypeDeclNode* {
        const start: Token = this.advance(); // consume 'type'
        const name_tok: Token = this.consume(TokenType::Identifier, "associated type name");

        mut bounds: TraitRef[] = [];
        if (this.match_tok(TokenType::Colon)) {
            while (true) {
                bounds.push(this.parse_trait_ref());
                if (!this.match_tok(TokenType::Plus)) { break; }
            }
        }

        this.consume(TokenType::Semicolon, "';'");

        mut node: AssocTypeDeclNode* = malloc(sizeof(AssocTypeDeclNode)) as AssocTypeDeclNode*;
        *node = AssocTypeDeclNode {
            name:   this.intern_lexeme(name_tok),
            bounds: bounds,
            span:   this.span_from(start),
        };
        return node;
    }

    /// Parse a type alias: type Alias = Target; or type Alias<T> = Target;
    parse_type_alias_declaration() -> TypeAliasDeclNode* {
        const start: Token = this.advance(); // consume 'type'
        const name_tok: Token = this.consume(TokenType::Identifier, "type alias name");
        const name: SymbolStr = this.intern_lexeme(name_tok);
        mut node: TypeAliasDeclNode* = new TypeAliasDeclNode(name, this.span_from_token(start));
        node.set_name_span(this.span_from_token(name_tok));

        // Optional generic parameters
        if (this.check(TokenType::LAngle)) {
            const gen_params: GenericParamNode*[] = this.parse_generic_params();
            for (mut gi: int = 0; gi < gen_params.length; gi++) {
                node.add_generic_param(gen_params[gi]);
            }
        }

        this.consume(TokenType::Equal, "'='");
        const target: TypeAnnotation* = this.parse_type_annotation();
        node.set_target_annotation(target);
        this.consume(TokenType::Semicolon, "';'");

        node.span = this.span_from(start);
        return node;
    }

    /// Parse an import declaration (5 styles).
    parse_import_declaration() -> ImportDeclNode* {
        return this.parse_import_form(false);
    }

    /// Parse an export declaration: the import form minus the wildcard.
    /// `export A::B::{X, Y};`, `export A::B as C;`, `export A::B;`.
    parse_export_declaration() -> ImportDeclNode* {
        return this.parse_import_form(true);
    }

    /// Shared body of `import` and `export`.  They differ in exactly two
    /// places - whether a `*` form is accepted, and the flag stamped on the
    /// node - so they share one production rather than drifting as two.
    parse_import_form(is_export: boolean) -> ImportDeclNode* {
        LOG_DEBUG(LogComponent::Parser, "[Parser] parse_import_form(is_export=%d)",
                  is_export as i32);
        const start: Token = this.advance(); // consume 'import' / 'export'

        // Build module path incrementally: A::B::C
        // Accept keywords as path segments (e.g., import collections::string)
        //
        // NOTE: We build the path string via intern() at each step to pin
        // intermediate results on the heap.  QualifiedName::display() uses
        // string::append() + InternTable::resolve(), which share a static
        // sprintf buffer and corrupt multi-segment paths via aliasing.
        mut first_tok: Token = this.current();
        if (first_tok.kind == TokenType::Identifier || first_tok.kind.is_keyword()) {
            this.advance();
        } else {
            first_tok = this.consume(TokenType::Identifier, "module name");
        }
        // Intern the first segment to get a heap-pinned copy
        mut path_sym: SymbolStr = this.ctx.intern(first_tok.lexeme);

        // Per-segment tracking for the LSP; each segment's name +
        // span gets stamped on the resulting `ImportDeclNode` so
        // hover/go-to-def can target an individual segment.
        mut seg_names: SymbolStr[] = [];
        mut seg_spans: SourceSpan[] = [];
        seg_names.push(this.ctx.intern(first_tok.lexeme));
        seg_spans.push(this.span_from_token(first_tok));

        while (this.check(TokenType::ColonColon)) {
            this.advance();
            const next: Token = this.current();
            // Could be identifier or * (wildcard)
            if (next.kind == TokenType::Star) {
                // Wildcard import: import A::B::*
                this.advance();
                if (is_export) {
                    // Rejected at the grammar, so no later stage has to decide
                    // what it means.  Under a glob re-export an importer's
                    // in-scope set changes when a child module gains a
                    // declaration - a name arriving with neither end having
                    // written it down.  `M::*` stays legal as a LOCAL import,
                    // where the blast radius is the one file that wrote it.
                    this.report_invalid_at(ErrorCode::E0111_INVALID_SYNTAX,
                        "`export` does not accept `*`; name each item as `export A::B::{ X, Y };`, or re-export the module itself as `export A::B;`",
                        this.span_from_token(next));
                    this.consume(TokenType::Semicolon, "';'");
                    return null;
                }
                const pinned: string = this.ctx.resolve_str(path_sym);
                const star_path: string = format("%s::*", pinned);
                mut imp: ImportDeclNode* = new ImportDeclNode(star_path, ImportStyle::Wildcard, this.span_from_token(start));
                for (mut i: i64 = 0; i < seg_names.length; i++) {
                    imp.add_path_segment(seg_names[i], seg_spans[i]);
                }
                this.consume(TokenType::Semicolon, "';'");
                imp.span = this.span_from(start);
                return imp;
            }
            if (next.kind == TokenType::LBrace) {
                // Selective import: import A::B::{X, Y}
                this.advance(); // consume '{'
                const path: string = this.ctx.resolve_str(path_sym);
                mut imp: ImportDeclNode* = new ImportDeclNode(path, ImportStyle::Specific, this.span_from_token(start));
                imp.is_export = is_export;
                for (mut i: i64 = 0; i < seg_names.length; i++) {
                    imp.add_path_segment(seg_names[i], seg_spans[i]);
                }
                while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
                    const item_tok: Token = this.consume(TokenType::Identifier, "import name");
                    imp.add_specific_import(this.intern_lexeme(item_tok));
                    if (!this.match_tok(TokenType::Comma)) { break; }
                }
                this.consume(TokenType::RBrace, "'}'");
                this.consume(TokenType::Semicolon, "';'");
                imp.span = this.span_from(start);
                return imp;
            }
            // Append "::segment" and intern to pin on the heap
            const prev: string = this.ctx.resolve_str(path_sym);
            path_sym = this.ctx.intern(format("%s::%s", prev, next.lexeme));
            seg_names.push(this.ctx.intern(next.lexeme));
            seg_spans.push(this.span_from_token(next));
            this.advance();
        }

        const path: string = this.ctx.resolve_str(path_sym);
        mut imp: ImportDeclNode* = new ImportDeclNode(path, ImportStyle::Wildcard, this.span_from_token(start));
        imp.is_export = is_export;
        for (mut i: i64 = 0; i < seg_names.length; i++) {
            imp.add_path_segment(seg_names[i], seg_spans[i]);
        }

        // Optional alias: import A::B as C
        if (this.check(TokenType::KwAs)) {
            this.advance();
            const alias_tok: Token = this.consume(TokenType::Identifier, "alias name");
            imp.set_alias(this.intern_lexeme(alias_tok));
        }

        this.consume(TokenType::Semicolon, "';'");
        imp.span = this.span_from(start);
        return imp;
    }

    /// Parse a namespace declaration: namespace A::B;
    /// Accepts keywords as path segments (e.g., std::collections::string).
    parse_namespace_declaration() -> ASTNode* {
        const start: Token = this.advance(); // consume 'namespace'
        mut qn: QualifiedName = QualifiedName::empty();
        mut seg_names: SymbolStr[] = [];
        mut seg_spans: SourceSpan[] = [];

        // Accept identifiers or keywords as namespace segments
        mut first_tok: Token = this.current();
        if (first_tok.kind == TokenType::Identifier || first_tok.kind.is_keyword()) {
            this.advance();
        } else {
            first_tok = this.consume(TokenType::Identifier, "namespace name");
        }
        qn.push(this.ctx.get_intern_table(), first_tok.lexeme);
        seg_names.push(this.ctx.intern(first_tok.lexeme));
        seg_spans.push(this.span_from_token(first_tok));

        while (this.check(TokenType::ColonColon)) {
            this.advance();
            mut next: Token = this.current();
            if (next.kind == TokenType::Identifier || next.kind.is_keyword()) {
                this.advance();
            } else {
                next = this.consume(TokenType::Identifier, "namespace segment");
            }
            qn.push(this.ctx.get_intern_table(), next.lexeme);
            seg_names.push(this.ctx.intern(next.lexeme));
            seg_spans.push(this.span_from_token(next));
        }

        this.consume(TokenType::Semicolon, "';'");

        // Create a module declaration node representing the namespace
        const span: SourceSpan = this.span_from(start);
        mut node: ModuleDeclNode* = new ModuleDeclNode(
            qn.display(this.ctx.get_intern_table()), true, span);
        for (mut i: i64 = 0; i < seg_names.length; i++) {
            node.add_path_segment(seg_names[i], seg_spans[i]);
        }
        return node;
    }

    /// Parse a module declaration: public module Name;
    /// Accepts keywords as path segments (e.g., public module collections::string;).
    parse_module_declaration() -> ModuleDeclNode* {
        const start: Token = this.current();
        mut is_public: boolean = false;
        if (this.check(TokenType::KwPublic)) {
            is_public = true;
            this.advance();
        }
        this.consume(TokenType::KwModule, "'module'");
        mut name_tok: Token = this.current();
        if (name_tok.kind == TokenType::Identifier || name_tok.kind.is_keyword()) {
            this.advance();
        } else {
            name_tok = this.consume(TokenType::Identifier, "module name");
        }

        // Handle qualified module names: A::B
        mut qn: QualifiedName = QualifiedName::empty();
        mut seg_names: SymbolStr[] = [];
        mut seg_spans: SourceSpan[] = [];
        qn.push(this.ctx.get_intern_table(), name_tok.lexeme);
        seg_names.push(this.ctx.intern(name_tok.lexeme));
        seg_spans.push(this.span_from_token(name_tok));
        while (this.check(TokenType::ColonColon)) {
            this.advance();
            mut next: Token = this.current();
            if (next.kind == TokenType::Identifier || next.kind.is_keyword()) {
                this.advance();
            } else {
                next = this.consume(TokenType::Identifier, "module name segment");
            }
            qn.push(this.ctx.get_intern_table(), next.lexeme);
            seg_names.push(this.ctx.intern(next.lexeme));
            seg_spans.push(this.span_from_token(next));
        }

        this.consume(TokenType::Semicolon, "';'");
        const span: SourceSpan = this.span_from(start);
        mut node: ModuleDeclNode* = new ModuleDeclNode(
            qn.display(this.ctx.get_intern_table()), is_public, span);
        for (mut i: i64 = 0; i < seg_names.length; i++) {
            node.add_path_segment(seg_names[i], seg_spans[i]);
        }
        return node;
    }

    /// Parse an implementation block. Two shapes:
    ///
    ///   Inherent (existing):
    ///     implement [enum|struct|class] Name[<T>] { ... }
    ///     implement boolean { ... }
    ///
    ///   Trait impl (G1, G2):
    ///     implement [<T, ...>] trait <TraitPath>[<args>] for [enum|struct|class]
    ///         Name[<args>] [where T: Bound + Bound2, U: Other] { ... }
    ///
    /// The leading `<T, ...>` after `implement` carries the impl's own generic
    /// parameters and is only used for generic trait impls. For inherent impls
    /// the existing `Name<T>` form continues to populate generic_params.
    /// Inspect the upcoming tokens for a trait-impl head with the
    /// `trait` keyword missing.  Returns:
    ///   0: pattern doesn't match (proceed as a normal inherent impl)
    ///   1: `<Path>[<args>] for ...` form (just `trait` missing)
    ///   2: `<struct|enum|class> <Path>[<args>] for ...` form
    ///       (`trait` missing AND a spurious kind tag is sitting in the
    ///       trait position; kind tags belong on the target after `for`)
    detect_missing_trait_form() -> int {
        mut off: int = 0;
        mut had_kind_tag: boolean = false;
        const first: TokenType = this.peek_at(0).kind;
        if (first == TokenType::KwStruct
            || first == TokenType::KwUnion
            || first == TokenType::KwEnum
            || first == TokenType::KwClass) {
            had_kind_tag = true;
            off = 1;
        }
        if (this.peek_at(off).kind != TokenType::Identifier) { return 0; }
        off += 1;
        // Walk `Ident (:: Ident)*` for paths like `module::Trait`.
        while (true) {
            if (this.peek_at(off).kind != TokenType::ColonColon) { break; }
            if (this.peek_at(off + 1).kind != TokenType::Identifier) { break; }
            off += 2;
        }
        // Optional `< ... >` generic args. The walk terminates on `depth == 0`
        // (balanced) or EOF (giving up); no artificial step cap needed since
        // `off` strictly increases each iteration.
        if (this.peek_at(off).kind == TokenType::LAngle) {
            mut depth: int = 1;
            off += 1;
            while (depth > 0) {
                const k: TokenType = this.peek_at(off).kind;
                if (k == TokenType::EOF) { return 0; }
                if (k == TokenType::LAngle) { depth += 1; }
                else if (k == TokenType::RAngle) { depth -= 1; }
                else if (k == TokenType::GreaterGreater) {
                    depth -= 2;
                    if (depth < 0) { depth = 0; }
                }
                off += 1;
            }
        }
        if (this.peek_at(off).kind != TokenType::KwFor) { return 0; }
        return if (had_kind_tag) { 2 } else { 1 };
    }

    parse_implementation_block() -> ImplBlockNode* {
        LOG_DEBUG(LogComponent::Parser, "[Parser] parse_implementation_block()");
        const start: Token = this.advance(); // consume 'implement'

        // (G2) Optional `<T, ...>` directly after `implement`: generic params
        // for a trait impl head: `implement<T> trait Iter<T> for Range<T>`.
        mut leading_gen_params: GenericParamNode*[] = [];
        if (this.check(TokenType::LAngle)) {
            leading_gen_params = this.parse_generic_params();
        }

        // (G1) Optional `trait <Path>[<args>] for`: the trait-impl prefix.
        // MUST sit before the existing keyword/identifier consume so that
        // `trait` (a keyword) is not mistaken for the target type name.
        mut trait_ann: TypeAnnotation* = null;
        if (this.check(TokenType::KwTrait)) {
            this.advance(); // consume 'trait'
            trait_ann = this.parse_type_annotation();
            this.consume(TokenType::KwFor, "'for'");
        } else {
            // Detect trait-impl heads that are missing the `trait` keyword
            // (and possibly carry a spurious struct/enum/class kind tag in
            // the trait position).  Both shapes are common copy-paste
            // mistakes; emit a tailored diagnostic and recover by parsing
            // the path before `for` as the trait annotation, exactly as
            // if `trait` had been written.
            const detect: int = this.detect_missing_trait_form();
            if (detect == 1) {
                // `implement <Path> for ...`: just `trait` is missing.
                const sugg_span: SourceSpan = this.current_span();
                const head: string = this.current().lexeme;
                mut diag: Diagnostic = Diagnostic::error(
                    ErrorCode::E0101_UNEXPECTED_TOKEN,
                    "missing `trait` keyword in `implement ... for ...` block");
                diag = diag.at(sugg_span);
                diag = diag.with_note("trait impls are written `implement trait <TraitName> for <TypeName> { ... }`; the `trait` keyword distinguishes a trait impl from an inherent impl");
                diag = diag.with_note("inherent impls (no `for` clause) use `implement <TypeName> { ... }`, optionally with a `struct`/`enum`/`class` kind tag on the target");
                diag = diag.suggest(Suggestion::replace(sugg_span,
                    format("trait %s", head),
                    "insert `trait` before the trait name"));
                this.ctx.diagnostics.emit(diag);
                this.error_count += 1;
                trait_ann = this.parse_type_annotation();
                this.consume(TokenType::KwFor, "'for'");
            } else if (detect == 2) {
                // `implement <KindTag> <Path> for ...`: kind tag in the
                // wrong position.  `struct`/`enum`/`class` are only valid
                // on the *target* type (after `for`), never on the trait
                // name.  The user almost certainly meant `trait` here.
                const tag_tok: Token = this.current();
                const tag_span: SourceSpan = this.current_span();
                const name_tok: Token = this.peek_at(1);
                mut diag: Diagnostic = Diagnostic::error(
                    ErrorCode::E0101_UNEXPECTED_TOKEN,
                    format("`%s` is not valid before a trait name", tag_tok.lexeme));
                diag = diag.at(tag_span);
                diag = diag.with_note(format("the `struct`/`enum`/`class` kind tag is only allowed on the *target* type after `for`; on the trait side, use `trait` (you wrote `implement %s %s for ...`)",
                    tag_tok.lexeme, name_tok.lexeme));
                diag = diag.with_note("the canonical form is `implement trait <TraitName> for [<KindTag>] <TypeName> { ... }`");
                diag = diag.suggest(Suggestion::replace(tag_span, "trait",
                    format("replace `%s` with `trait`", tag_tok.lexeme)));
                this.ctx.diagnostics.emit(diag);
                this.error_count += 1;
                this.advance(); // skip the spurious kind tag
                trait_ann = this.parse_type_annotation();
                this.consume(TokenType::KwFor, "'for'");
            }
        }

        // Optional type keyword (enum, struct, union, class)
        if (this.check(TokenType::KwEnum) || this.check(TokenType::KwStruct)
            || this.check(TokenType::KwUnion) || this.check(TokenType::KwClass)) {
            this.advance();
        }

        // Accept identifier, primitive type keyword, or the empty tuple
        // `()` (the unit type) as the target type name.
        //   * Identifiers cover user-defined types.
        //   * Keywords cover primitive shapes: `implement boolean { ... }`.
        //   * `()` lets stdlib give the unit type a Drop impl so generic
        //     containers bound `V: Drop` work for `V = ()` instantiations
        //     (e.g. `HashMap<T, ()>` underpinning `HashSet<T>`).
        mut type_tok: Token = this.current();
        mut type_name: SymbolStr = SymbolStr::empty();
        // Spelling of the target, which is NOT the target token's lexeme for the
        // unit type: `()` is two tokens and `type_tok` keeps only the `(`.  This
        // is what types the `&this` receiver below, so taking the lexeme gives
        // that receiver the name `(`, which names nothing and resolves to an
        // invalid type - while `()` is a registered type name.
        mut type_text: string = "";
        if (type_tok.kind == TokenType::LParen
                && this.peek_at(1).kind == TokenType::RParen) {
            const lparen: Token = this.advance();         // consume '('
            const _rparen: Token = this.advance();         // consume ')'
            type_tok = lparen;
            type_name = this.ctx.intern("()");
            type_text = "()";
        } else if (type_tok.kind == TokenType::Identifier
                || type_tok.kind.is_keyword()) {
            this.advance();
            type_name = this.intern_lexeme(type_tok);
            type_text = type_tok.lexeme;
        } else {
            type_tok = this.consume(TokenType::Identifier, "type name");
            type_name = this.intern_lexeme(type_tok);
            type_text = type_tok.lexeme;
        }
        mut node: ImplBlockNode* = new ImplBlockNode(type_name, this.span_from_token(start));
        node.set_target_type_span(this.span_from_token(type_tok));
        this.current_type_name = type_text;

        // Attach the trait annotation and the leading generic params (if any)
        // collected before the target name was known.
        if (trait_ann != null) {
            node.set_trait_annotation(trait_ann);
        }
        for (mut lgi: int = 0; lgi < leading_gen_params.length; lgi++) {
            node.add_generic_param(leading_gen_params[lgi]);
        }

        // Optional generic params/args after target name.
        // For inherent impls (no leading trait annotation), `Name<T>` is the
        // existing generic-params form; keep populating generic_params.
        // For trait impls, `Bar<T>` are the target's type args; the binding
        // already lives in the leading generic_params, so we consume the
        // tokens but discard the structured args. Sema (Phase B) re-derives
        // them from the impl's generic_params and the target's declaration.
        if (this.check(TokenType::LAngle)) {
            if (trait_ann == null) {
                const gen_params: GenericParamNode*[] = this.parse_generic_params();
                for (mut gi: int = 0; gi < gen_params.length; gi++) {
                    node.add_generic_param(gen_params[gi]);
                }
            } else {
                // The target's type args (e.g. `<T>` in `for Range<T>`).
                // The binding lives in the leading generic_params; sema
                // re-derives the structured form, but we keep the args so
                // `This` in a synthesized default method can be rewritten to
                // the full Self type `Range<T>` instead of the bare `Range`.
                node.set_target_args(this.parse_generic_args());
            }
        }

        // (G2) Optional `where T: Bound, ...` clause.
        if (this.check(TokenType::KwWhere)) {
            const bounds: TraitBound[] = this.parse_trait_bounds();
            for (mut wi: int = 0; wi < bounds.length; wi++) {
                node.add_where_bound(bounds[wi].clone());
            }
        }

        this.consume(TokenType::LBrace, "'{'");

        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            this.collect_doc_comments();
            if (this.check(TokenType::RBrace)) { break; }
            const doc: string = this.take_documentation();

            // Drain `![...]` directives so we can attach them to the
            // next method.  Mirrors the type-body drain in
            // parse_type_body; same shape, same attach-on-success
            // discipline.
            mut pending_dirs: DirectiveNode*[] = [];
            while (this.check(TokenType::BangBracket)) {
                const d: DirectiveNode* = this.parse_directive();
                if (d != null) { pending_dirs.push(d); }
                this.collect_doc_comments();
                if (this.check(TokenType::RBrace) || this.is_at_end()) { break; }
            }
            if (this.check(TokenType::RBrace) || this.is_at_end()) { break; }

            // Associated-type binding: `type Item = T;`. The explicit body
            // form of binding a trait's associated type in this impl (the
            // positional header form `Iterator<T>` is desugared to the same
            // binding later, in TypeResolution).
            if (this.check(TokenType::KwType)) {
                this.advance(); // consume 'type'
                const an_tok: Token = this.consume(TokenType::Identifier, "associated type name");
                this.consume(TokenType::Equal, "'='");
                const bound_ann: TypeAnnotation* = this.parse_type_annotation();
                this.consume(TokenType::Semicolon, "';'");
                if (bound_ann != null) {
                    node.add_assoc_binding(this.intern_lexeme(an_tok), bound_ann);
                }
                continue;
            }

            // Methods in impl blocks. A keyword may name a method (`as<T>()`);
            // `type` bindings are handled above, so any other keyword here is
            // a method name (mirrors keyword-as-member-name after `.`/`::`).
            if (this.check(TokenType::Identifier) || this.check(TokenType::KwFunction) ||
                this.check(TokenType::KwStatic) || this.check(TokenType::KwPublic) ||
                this.check(TokenType::KwPrivate) || this.current().kind.is_keyword()) {

                mut vis: Visibility = Visibility::Public;
                mut is_static: boolean = false;
                // These keywords are consumed before the method node exists,
                // so they fall outside its `span`; keep their extent for
                // `outer_span()` (see `DeclarationNode::note_modifier_span`).
                mut modifier_span: SourceSpan = SourceSpan::none();

                if (this.check(TokenType::KwPublic)) {
                    vis = Visibility::Public;
                    modifier_span = this.span_from_token(this.current());
                    this.advance();
                } else if (this.check(TokenType::KwPrivate)) {
                    vis = Visibility::Private;
                    modifier_span = this.span_from_token(this.current());
                    this.advance();
                }

                const mods: MethodModifiers = this.consume_method_modifiers(modifier_span);
                is_static = mods.is_static;
                modifier_span = mods.span;

                const method: MethodNode* = this.parse_method(vis);
                if (method != null) {
                    if (is_static) { method.set_static(true); }
                    if (mods.is_async && method.func != null) { method.func.set_async(true); }
                    if (doc != "") { method.set_documentation(doc); }
                    for (mut pi: i64 = 0; pi < pending_dirs.length; pi++) {
                        method.add_directive(pending_dirs[pi]);
                    }
                    method.note_modifier_span(modifier_span);
                    node.add_method(method);
                }
            } else {
                this.error_unexpected();
                this.advance();
            }
        }

        this.consume(TokenType::RBrace, "'}'");
        this.current_type_name = "";
        node.span = this.span_from(start);
        return node;
    }

    /// Parse an extern block: extern "C" { function declarations }
    parse_extern_block() -> ExternBlockNode* {
        const start: Token = this.advance(); // consume 'extern'
        mut linkage: string = "C";

        // Optional linkage type: "C"
        if (this.check(TokenType::StringLiteral)) {
            linkage = this.current().lexeme;
            this.advance();
        }

        mut node: ExternBlockNode* = new ExternBlockNode(linkage, this.span_from_token(start));

        this.consume(TokenType::LBrace, "'{'");

        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            this.collect_doc_comments();
            if (this.check(TokenType::RBrace)) { break; }

            // Drain `![...]` directives (e.g. `![symbol("sym")]`) so they
            // attach to the next extern function.  Mirrors the impl-body
            // and top-level directive drains.
            mut pending_dirs: DirectiveNode*[] = [];
            while (this.check(TokenType::BangBracket)) {
                const d: DirectiveNode* = this.parse_directive();
                if (d != null) { pending_dirs.push(d); }
                this.collect_doc_comments();
                if (this.check(TokenType::RBrace) || this.is_at_end()) { break; }
            }
            if (this.check(TokenType::RBrace) || this.is_at_end()) { break; }

            if (this.check(TokenType::KwFunction)) {
                const func: FunctionDeclNode* = this.parse_extern_function();
                if (func != null) {
                    for (mut pi: i64 = 0; pi < pending_dirs.length; pi++) {
                        func.add_directive(pending_dirs[pi]);
                    }
                    node.add_function(func);
                }
            } else if (this.check(TokenType::KwMut) || this.check(TokenType::KwConst)) {
                const gvar: VarDeclNode* = this.parse_extern_global();
                if (gvar != null) {
                    for (mut pi: i64 = 0; pi < pending_dirs.length; pi++) {
                        gvar.add_directive(pending_dirs[pi]);
                    }
                    node.add_global(gvar);
                }
            } else {
                this.error_unexpected();
                this.advance();
            }
        }

        this.consume(TokenType::RBrace, "'}'");
        node.span = this.span_from(start);
        return node;
    }

    /// Parse the CImport form: `extern module name := "C" { #include "..." }`
    /// 'extern' is current. The keyword-led spelling groups with other `extern`
    /// declarations and reuses the existing `module` keyword.
    parse_extern_module_cimport() -> ExternBlockNode* {
        const start: Token = this.advance(); // consume 'extern'
        this.advance();                      // consume 'module'
        const alias_tok: Token = this.current();
        const alias: SymbolStr = this.intern_lexeme(alias_tok);
        this.advance();                      // consume the alias identifier
        this.consume(TokenType::Colon, "':'");
        this.consume(TokenType::Equal, "'='");
        return this.finish_cimport_block(alias, start);
    }

    /// Shared tail for both CImport spellings: with `start` at the leading
    /// `extern` token and the cursor positioned at the linkage string, parse
    /// `"C" { #include ... }` into a namespace-aliased ExternBlockNode.
    finish_cimport_block(alias: SymbolStr, start: Token) -> ExternBlockNode* {
        mut linkage: string = "C";

        // Linkage type: "C"
        if (this.check(TokenType::StringLiteral)) {
            linkage = this.current().lexeme;
            this.advance();
        }

        mut node: ExternBlockNode* = new ExternBlockNode(linkage, this.span_from_token(start));
        node.set_namespace_alias(alias);

        this.consume(TokenType::LBrace, "'{'");

        // Parse #include directives
        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            if (this.check(TokenType::Hash)) {
                this.advance(); // consume '#'

                // Expect 'include' identifier
                if (!this.check(TokenType::Identifier) || this.current().lexeme != "include") {
                    this.report_error(ErrorCode::E0101_UNEXPECTED_TOKEN,
                        "expected 'include' after '#' in extern C import block");
                    this.advance();
                    continue;
                }
                this.advance(); // consume 'include'

                // Parse the include path. Two C-style forms:
                //   #include "foo.h"   quoted  -> local include, resolved
                //                                 relative to this file's dir
                //   #include <stdio.h> angle   -> system include, resolved
                //                                 by the C preprocessor's
                //                                 system search path
                if (this.check(TokenType::StringLiteral)) {
                    const path: string = this.current().lexeme;
                    this.advance(); // consume string literal
                    node.add_include_path(path);
                } else if (this.check(TokenType::LAngle)) {
                    this.advance(); // consume '<'
                    // Reconstruct the bracketed path from its component
                    // tokens (`stdio` `.` `h` -> "stdio.h"). Header paths
                    // contain no whitespace, so concatenating the lexemes
                    // is faithful to the source.
                    mut sys_path: string = "";
                    while (!this.check(TokenType::RAngle)
                            && !this.check(TokenType::RBrace)
                            && !this.is_at_end()) {
                        sys_path = format("%s%s", sys_path, this.current().lexeme);
                        this.advance();
                    }
                    if (!this.check(TokenType::RAngle)) {
                        this.report_error(ErrorCode::E0100_EXPECTED_TOKEN,
                            "expected '>' to close a system '#include <...>' path");
                        continue;
                    }
                    this.advance(); // consume '>'
                    node.add_system_include_path(sys_path);
                } else {
                    this.report_error(ErrorCode::E0100_EXPECTED_TOKEN,
                        "expected a quoted \"path\" or <path> after #include");
                    this.advance();
                    continue;
                }
            } else {
                this.report_error(ErrorCode::E0101_UNEXPECTED_TOKEN,
                    "expected '#include' directive in extern C import block");
                this.advance();
            }
        }

        this.consume(TokenType::RBrace, "'}'");
        node.span = this.span_from(start);
        return node;
    }

    /// Parse an extern function declaration (no body).
    parse_extern_function() -> FunctionDeclNode* {
        const func: FunctionDeclNode* = this.parse_function_declaration(false);
        return func;
    }

    /// Parse an imported global inside an `extern "C"` block:
    ///   `mut errno_value: i32;`  /  `const build_id: u8*;`
    ///
    /// The declaration names storage that belongs to another object, which
    /// rules out both halves of an ordinary global: an initializer would DEFINE
    /// the symbol here and collide with the library at link time, and the type
    /// cannot be inferred because there is nothing to infer it from.  `mut` and
    /// `const` still say what CRYO may do with it - `const` is not a promise
    /// about the library, which remains free to change the value.
    parse_extern_global() -> VarDeclNode* {
        mut node: VarDeclNode* = this.parse_variable_declaration();
        if (node == null) { return null; }
        node.is_global = true;
        node.is_extern_import = true;
        if (node.initializer != null) {
            this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                "an imported global cannot have an initializer: its storage is defined by the library being linked, not here");
        }
        if (node.type_annotation == null) {
            this.report_error(ErrorCode::E0104_EXPECTED_TYPE,
                "an imported global needs a type annotation: there is no initializer to infer one from");
        }
        return node;
    }

    /// Move an `extern "C"` block's imported globals into the top-level
    /// statement stream.  They ARE top-level globals - only their storage lives
    /// elsewhere - so hoisting lets the declaration index, name resolution, type
    /// resolution and codegen reach them through the paths that already handle
    /// globals, instead of each learning to look inside an extern block.
    static hoist_extern_globals(program: ProgramNode*, node: ASTNode*) -> void {
        if (program == null || node == null) { return; }
        if (node.kind != NodeKind::ExternBlock) { return; }
        const blk: ExternBlockNode* = node as ExternBlockNode*;
        for (mut i: i64 = 0; i < blk.globals.length; i++) {
            program.add_statement(blk.globals[i] as ASTNode*);
        }
    }

    /// Parse an intrinsic declaration:
    ///   intrinsic name(params) -> RetType { body }
    ///   intrinsic function name(params) -> RetType;    (stdlib form)
    parse_intrinsic_declaration() -> IntrinsicDeclNode* {
        const start: Token = this.advance(); // consume 'intrinsic'
        // Allow optional 'function' keyword: intrinsic function malloc(...)
        if (this.check(TokenType::KwFunction)) {
            this.advance(); // consume 'function'
        }
        const name_tok: Token = this.consume(TokenType::Identifier, "intrinsic name");
        const name: SymbolStr = this.intern_lexeme(name_tok);
        mut node: IntrinsicDeclNode* = new IntrinsicDeclNode(name, this.span_from_token(start));

        // Parameter list
        this.consume(TokenType::LParen, "'('");
        if (!this.check(TokenType::RParen)) {
            const params: VarDeclNode*[] = this.parse_parameter_list();
            for (mut i: int = 0; i < params.length; i++) {
                const p: VarDeclNode* = params[i];
                // Detect variadic marker: the `args...` param has no type
                // annotation (parse_parameter returns it early on `...`).
                if (p.type_annotation == null && i == params.length - 1) {
                    node.set_variadic(true);
                } else {
                    node.add_parameter(p);
                }
            }
        }
        if (this.pending_bare_variadic) {
            node.set_variadic(true);
            this.pending_bare_variadic = false;
        }
        this.consume(TokenType::RParen, "')'");

        // Optional return type
        if (this.match_tok(TokenType::Arrow)) {
            const ret_ann: TypeAnnotation* = this.parse_type_annotation();
            node.set_return_type_annotation(ret_ann);
        }

        // Optional body
        if (this.check(TokenType::LBrace)) {
            const body: BlockStmtNode* = this.parse_block_statement();
            node.set_body(body);
        } else {
            this.consume(TokenType::Semicolon, "';'");
        }

        node.span = this.span_from(start);
        return node;
    }

    /// Parse an intrinsic const declaration: intrinsic const NAME: Type;
    parse_intrinsic_const_declaration() -> IntrinsicConstDeclNode* {
        const start: Token = this.advance(); // consume 'intrinsic'
        this.advance(); // consume 'const'
        const name_tok: Token = this.consume(TokenType::Identifier, "intrinsic const name");
        const name: SymbolStr = this.intern_lexeme(name_tok);
        mut node: IntrinsicConstDeclNode* = new IntrinsicConstDeclNode(name, this.span_from_token(start));

        // Type annotation: : Type
        if (this.match_tok(TokenType::Colon)) {
            node.type_annotation = this.parse_type_annotation();
        }

        this.consume(TokenType::Semicolon, "';'");
        node.span = this.span_from(start);
        return node;
    }

    /// Parse generic type parameters: <T, U: Constraint, A = DefaultType>
    /// Default annotation (`= Type`) follows any optional constraints and is
    /// substituted by sema when the param is omitted at instantiation time.
    parse_generic_params() -> GenericParamNode*[] {
        mut params: GenericParamNode*[] = [];
        this.advance(); // consume '<'

        while (!this.check(TokenType::RAngle) &&
               !this.check(TokenType::GreaterGreater) &&
               !this.is_at_end()) {
            const start: Token = this.current();
            const name_tok: Token = this.consume(TokenType::Identifier, "type parameter name");
            const name: SymbolStr = this.intern_lexeme(name_tok);
            mut param: GenericParamNode* = new GenericParamNode(name, this.span_from_token(start));

            // Optional constraints: T: Constraint1 + Constraint2
            if (this.match_tok(TokenType::Colon)) {
                while (true) {
                    const constraint_tok: Token = this.consume(TokenType::Identifier, "constraint name");
                    param.add_constraint(this.intern_lexeme(constraint_tok));
                    if (!this.match_tok(TokenType::Plus)) { break; }
                }
            }

            // Optional default type: T = DefaultType (after constraints, before , or >)
            if (this.match_tok(TokenType::Equal)) {
                const default_ann: TypeAnnotation* = this.parse_type_annotation();
                if (default_ann != null) {
                    param.set_default_annotation(default_ann);
                }
            }

            param.span = this.span_from(start);
            params.push(param);

            if (!this.match_tok(TokenType::Comma)) {
                break;
            }
        }

        this.consume_right_angle();
        return params;
    }

    /// Parse trait bounds: `where T: Trait, U: A + B, W: io::Write`.
    /// Each bound is one type parameter with one or more `+`-separated trait
    /// refs. Each ref may itself be a `::`-qualified path.
    parse_trait_bounds() -> TraitBound[] {
        mut bounds: TraitBound[] = [];
        this.advance(); // consume 'where'

        while (true) {
            const start_tok: Token = this.current();

            // Subject: a bare type parameter (`T`) or an associated-type
            // projection (`This::Item`, `I::Item`). A projection routes through
            // `parse_projection_subject` (which builds the Projection node) and
            // leaves `type_parameter` empty; a bare param keeps the historical
            // path so the param-name-keyed machinery downstream is unchanged.
            mut type_param: SymbolStr = SymbolStr::empty();
            mut subject: TypeAnnotation* = null;
            const is_projection: boolean =
                this.check(TokenType::KwThisType)
                || (this.check(TokenType::Identifier)
                    && this.peek_at(1).kind == TokenType::ColonColon);
            if (is_projection) {
                subject = this.parse_projection_subject();
            } else {
                const type_param_tok: Token =
                    this.consume(TokenType::Identifier, "type parameter");
                type_param = this.intern_lexeme(type_param_tok);
            }

            this.consume(TokenType::Colon, "':'");

            mut refs: TraitRef[] = [];
            while (true) {
                refs.push(this.parse_trait_ref());
                if (!this.match_tok(TokenType::Plus)) { break; }
            }

            const bound: TraitBound = TraitBound {
                type_parameter: type_param,
                subject_type:   subject,
                trait_refs:     refs,
                span:           this.span_from(start_tok),
            };
            bounds.push(bound);

            if (!this.match_tok(TokenType::Comma)) { break; }
        }

        return bounds;
    }

    /// Parse a single (possibly qualified, optionally generic) trait
    /// reference: `Name`, `path::to::Name`, `Name<T>`, `Name<T, U>`, or
    /// `path::to::Name<T>`.  Returns the captured path segments, any
    /// generic-arg annotations, and the source span.
    parse_trait_ref() -> TraitRef {
        const start: Token = this.current();
        const head_tok: Token = this.consume(TokenType::Identifier, "trait name");
        mut path: SymbolStr[] = [];
        path.push(this.intern_lexeme(head_tok));

        while (this.check(TokenType::ColonColon)) {
            this.advance(); // consume '::'
            const seg_tok: Token = this.consume(TokenType::Identifier, "trait path segment");
            path.push(this.intern_lexeme(seg_tok));
        }

        mut type_args: TypeAnnotation*[] = [];
        if (this.check(TokenType::LAngle)) {
            type_args = this.parse_generic_args();
        }

        return TraitRef {
            path:      path,
            // Identity needs the writing module's imports, which the parser
            // does not have; TypeResolution stamps it.
            resolved_name: SymbolStr::empty(),
            type_args: type_args,
            span:      this.span_from(start),
        };
    }

    /// Consume the next token as a directive name.  Accepts a regular
    /// identifier OR any keyword token whose lexeme is an identifier-shaped
    /// word (`inline`, `static`, `extern`, `if`, `unsafe`, ...) so the
    /// directive vocabulary isn't artificially limited by reserved words.
    consume_directive_name() -> Token {
        const tok: Token = this.current();
        if (tok.kind == TokenType::Identifier || tok.kind.is_keyword()) {
            return this.advance();
        }
        this.report_error(ErrorCode::E0105_EXPECTED_IDENTIFIER,
            format("expected directive name, found '%s'", tok.lexeme));
        return this.advance();
    }

    /// Parse a directive: ![name] or ![name(args)]
    /// The opening `![` is a single fused token (BangBracket).  Arguments
    /// can be: bare identifier, string literal, integer literal, boolean
    /// literal, `key = value` pair, or a nested directive call
    /// (e.g. `![cfg(any(unix, windows))]`).
    parse_directive() -> DirectiveNode* {
        const start: Token = this.advance(); // consume '!['

        const kind_tok: Token = this.consume_directive_name();
        mut dir: DirectiveNode* = new DirectiveNode(kind_tok.lexeme, this.span_from_token(start));

        if (this.check(TokenType::LParen)) {
            this.advance();
            if (!this.check(TokenType::RParen)) {
                while (true) {
                    const a: DirectiveArg = this.parse_directive_arg();
                    dir.add_arg(a);
                    if (!this.match_tok(TokenType::Comma)) { break; }
                }
            }
            this.consume(TokenType::RParen, "')'");
        }

        this.consume(TokenType::RSquare, "']'");
        dir.span = this.span_from(start);
        return dir;
    }

    /// Parse a single directive argument.  Uses the same grammar whether
    /// the argument appears at the top level (`![attr(arg, ...)]`) or
    /// inside a nested call (`cfg(any(unix))`).
    parse_directive_arg() -> DirectiveArg {
        const start: Token = this.current();

        // Boolean literal: true / false
        if (start.kind == TokenType::KwTrue) {
            this.advance();
            return DirectiveArg::bool_lit(true, this.span_from_token(start));
        }
        if (start.kind == TokenType::KwFalse) {
            this.advance();
            return DirectiveArg::bool_lit(false, this.span_from_token(start));
        }

        // String literal: "foo"
        if (start.kind == TokenType::StringLiteral) {
            const tok: Token = this.advance();
            const content: string = ParserBase::unquote_string_lexeme(tok.lexeme);
            return DirectiveArg::string_lit(content, this.span_from_token(tok));
        }

        // Integer literal: 16, 0xFF, 0b101, ...
        if (start.kind == TokenType::NumericConstant) {
            const tok: Token = this.advance();
            const v: i64 = ParserBase::parse_numeric_lexeme_i64(tok.lexeme);
            return DirectiveArg::int_lit(v, tok.lexeme, this.span_from_token(tok));
        }

        // Identifier: bare ident, key=value, or nested call.
        // Also accept any keyword whose lexeme reads as an identifier
        // (e.g. `inline`, `static`, `if`, `unsafe`) so directive names
        // and arg names aren't restricted to non-reserved words.
        if (start.kind == TokenType::Identifier || start.kind.is_keyword()) {
            const id_tok: Token = this.advance();

            // Nested directive call: name(args...)
            if (this.check(TokenType::LParen)) {
                mut nested: DirectiveNode* = new DirectiveNode(
                    id_tok.lexeme, this.span_from_token(id_tok));
                this.advance(); // consume '('
                if (!this.check(TokenType::RParen)) {
                    while (true) {
                        const inner: DirectiveArg = this.parse_directive_arg();
                        nested.add_arg(inner);
                        if (!this.match_tok(TokenType::Comma)) { break; }
                    }
                }
                this.consume(TokenType::RParen, "')'");
                nested.span = this.span_from(id_tok);
                return DirectiveArg::nested_call(nested, this.span_from(id_tok));
            }

            // key = value
            if (this.check(TokenType::Equal)) {
                this.advance(); // consume '='
                return this.parse_directive_kv(id_tok);
            }

            // Bare identifier
            return DirectiveArg::ident(id_tok.lexeme, this.span_from_token(id_tok));
        }

        // Anything else is a syntax error inside a directive arg list.
        this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
            format("expected directive argument (identifier, literal, or nested call), got '%s'",
                start.lexeme));
        this.advance(); // skip the bad token to make progress
        return DirectiveArg::ident(start.lexeme, this.span_from_token(start));
    }

    /// Helper: build a `key = value` arg given that `key` and `=` are
    /// already consumed.  Caller passes the identifier token for `key`.
    parse_directive_kv(key_tok: Token) -> DirectiveArg {
        const v_tok: Token = this.current();
        mut kv: DirectiveArg = DirectiveArg {
            kind:       DirectiveArgKind::KeyValue,
            name:       key_tok.lexeme,
            str_value:  "",
            int_value:  0,
            bool_value: false,
            value_kind: DirectiveArgKind::Ident,
            nested:     null,
            span:       this.span_from(key_tok),
        };

        match (v_tok.kind) {
            TokenType::KwTrue => {
                this.advance();
                kv.value_kind = DirectiveArgKind::BoolLit;
                kv.bool_value = true;
            }
            TokenType::KwFalse => {
                this.advance();
                kv.value_kind = DirectiveArgKind::BoolLit;
                kv.bool_value = false;
            }
            TokenType::StringLiteral => {
                this.advance();
                kv.value_kind = DirectiveArgKind::StringLit;
                kv.str_value  = ParserBase::unquote_string_lexeme(v_tok.lexeme);
            }
            TokenType::NumericConstant => {
                this.advance();
                kv.value_kind = DirectiveArgKind::IntLit;
                kv.int_value  = ParserBase::parse_numeric_lexeme_i64(v_tok.lexeme);
                kv.str_value  = v_tok.lexeme;
            }
            TokenType::Identifier => {
                this.advance();
                kv.value_kind = DirectiveArgKind::Ident;
                kv.str_value  = v_tok.lexeme;
            }
            _ => {
                this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                    format("expected literal or identifier after '=' in directive, got '%s'",
                        v_tok.lexeme));
            }
        }

        kv.span = this.span_from(key_tok);
        return kv;
    }


    // Statement Parsing

    /// Parse a statement based on the current token.
    parse_statement() -> StatementNode* {
        LOG_DEBUG(LogComponent::Parser, "[Parser] parse_statement() token='%s'", this.current().lexeme);
        if (this.panic_mode || this.is_at_end()) { return null; }

        const tok: Token = this.current();

        // Statement-position directive on a block: `![dir] { ... }`.
        // Drains consecutive directives and attaches them to the
        // following block.  Evaluated by the ConfigGating pass.
        if (tok.kind == TokenType::BangBracket) {
            mut pending: DirectiveNode*[] = [];
            while (this.check(TokenType::BangBracket)) {
                const d: DirectiveNode* = this.parse_directive();
                if (d != null) { pending.push(d); }
                if (this.is_at_end()) { break; }
            }
            // `![arch(...)] ![clobber(...)] asm { ... }`
            if (this.check(TokenType::KwAsm)) {
                return this.parse_asm_block(pending, false);
            }
            if (!this.check(TokenType::LBrace)) {
                this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                    format("expected '{' after `![...]` directive in statement position; got '%s'",
                        this.current().lexeme));
                return null;
            }
            mut block: BlockStmtNode* = this.parse_block_statement();
            if (block == null) { return null; }
            for (mut i: i64 = 0; i < pending.length; i++) {
                block.add_directive(pending[i]);
            }
            return block;
        }

        if (tok.kind == TokenType::LBrace) {
            return this.parse_block_statement();
        }

        if (tok.kind == TokenType::KwIf) {
            return this.parse_if_statement();
        }

        if (tok.kind == TokenType::KwWhile) {
            return this.parse_while_statement();
        }

        if (tok.kind == TokenType::KwDo) {
            return this.parse_do_while_statement();
        }

        if (tok.kind == TokenType::KwLoop) {
            return this.parse_loop_statement();
        }

        if (tok.kind == TokenType::KwFor) {
            return this.parse_for_statement();
        }

        // `static match (T) { ... }` in statement position (e.g. an
        // `Atomic<T>::store` body whose arms yield no value). Checked before
        // the bare-`match` path.
        if (tok.kind == TokenType::KwStatic && this.peek_at(1).kind == TokenType::KwMatch) {
            return this.parse_static_match_statement();
        }

        if (tok.kind == TokenType::KwMatch) {
            return this.parse_match_statement();
        }

        if (tok.kind == TokenType::KwReturn) {
            return this.parse_return_statement();
        }

        if (tok.kind == TokenType::KwBreak) {
            return this.parse_break_statement();
        }

        if (tok.kind == TokenType::KwContinue) {
            return this.parse_continue_statement();
        }

        if (tok.kind == TokenType::KwUnsafe) {
            return this.parse_unsafe_block();
        }

        // Bare `asm { ... }` (no preceding directive; arch is required and
        // its absence is reported by the directive-processing pass).
        if (tok.kind == TokenType::KwAsm) {
            mut empty: DirectiveNode*[] = [];
            return this.parse_asm_block(empty, false);
        }

        // Variable declarations (as statements).  Peek past `const`/`mut`:
        // if the next token is `{`, this is a struct destructure binding
        // (`const { f }: T = expr;`); otherwise the standard var decl path.
        if (tok.kind == TokenType::KwConst || tok.kind == TokenType::KwMut) {
            if (this.peek_at(1).kind == TokenType::LBrace) {
                const dd: DestructureDeclNode* = this.parse_destructure_decl();
                if (dd != null) {
                    return new DeclStmtNode(dd, dd.span);
                }
                return null;
            }
            const var_decl: VarDeclNode* = this.parse_variable_declaration();
            if (var_decl != null) {
                return new DeclStmtNode(var_decl, var_decl.span);
            }
            return null;
        }

        return this.parse_expression_statement();
    }

    /// Parse a block statement: { statement* }
    parse_block_statement() -> BlockStmtNode* {
        // BRACE_DEPTH_LIMIT: see parse_inner_block. Nested block statements
        // (and the bodies of nested if/match/while/for, which route here)
        // recurse with no expression-bracketing token to bound them, so a
        // pathological depth crashes the compiler (SIGSEGV). Cap via the
        // advance()-maintained brace_depth; return an empty block so no caller
        // dereferences null and the enclosing loop's no-progress guard makes
        // forward progress past the unconsumed `{`.
        if (this.brace_depth > 256) {
            this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                "block nesting too deep (recursion limit exceeded)");
            return new BlockStmtNode(this.current_span());
        }
        const start: Token = this.advance(); // consume '{'
        this.enter_scope();
        mut block: BlockStmtNode* = new BlockStmtNode(this.span_from_token(start));

        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            const before_pos: int = this.pos;
            if (this.panic_mode) {
                this.synchronize();
                if (this.check(TokenType::RBrace) || this.is_at_end()) { break; }
            }

            this.collect_doc_comments();
            if (this.check(TokenType::RBrace)) { break; }
            const doc: string = this.take_documentation();

            // Inside a block, we can have declarations or statements.
            // `is_declaration_start()` reports `static` as a declaration start
            // (for `static function`), but `static match` is a STATEMENT - route
            // it to parse_statement instead of parse_declaration.
            const is_static_match: boolean =
                this.check(TokenType::KwStatic) &&
                this.peek_at(1).kind == TokenType::KwMatch;
            if (this.is_declaration_start() && !is_static_match) {
                const decl: ASTNode* = this.parse_declaration(false, doc);
                if (decl != null) {
                    // Wrap declaration in a DeclStmtNode if it's a DeclarationNode
                    // Otherwise it might already be a StatementNode
                    const decl_stmt: DeclStmtNode* = new DeclStmtNode(decl as DeclarationNode*, decl.span);
                    block.add_statement(decl_stmt);
                }
            } else {
                const stmt: StatementNode* = this.parse_statement();
                if (stmt != null) {
                    block.add_statement(stmt);
                }
            }

            // Progress guard: a faulty parse_statement that returned null
            // without advancing (e.g. panic_mode tripped early) would otherwise
            // loop forever on the same token.
            if (this.pos == before_pos) {
                this.advance();
            }
        }

        this.consume(TokenType::RBrace, "'}'");
        this.exit_scope();
        block.span = this.span_from(start);
        return block;
    }

    /// Parse an if statement: if (cond) stmt [else stmt]
    parse_if_statement() -> IfStmtNode* {
        const start: Token = this.advance(); // consume 'if'
        const condition: ExpressionNode* = this.parse_paren_condition();

        const then_stmt: StatementNode* = this.parse_statement_or_block();

        mut else_stmt: StatementNode* = null;
        if (this.match_tok(TokenType::KwElse)) {
            else_stmt = this.parse_statement_or_block();
        }

        const span: SourceSpan = this.span_from(start);
        return new IfStmtNode(condition, then_stmt, else_stmt, span);
    }

    /// Parse a while statement: while (cond) stmt
    parse_while_statement() -> WhileStmtNode* {
        const start: Token = this.advance(); // consume 'while'
        const condition: ExpressionNode* = this.parse_paren_condition();

        const body: StatementNode* = this.parse_statement_or_block();
        return new WhileStmtNode(condition, body, this.span_from(start));
    }

    /// Parse a loop statement: loop { body }
    parse_loop_statement() -> LoopStmtNode* {
        const start: Token = this.advance(); // consume 'loop'
        const body: StatementNode* = this.parse_statement_or_block();
        return new LoopStmtNode(body, this.span_from(start));
    }

    /// Parse a do-while statement: do stmt while (cond);
    parse_do_while_statement() -> DoWhileStmtNode* {
        const start: Token = this.advance(); // consume 'do'
        const body: StatementNode* = this.parse_statement_or_block();
        this.consume(TokenType::KwWhile, "'while'");
        const condition: ExpressionNode* = this.parse_paren_condition();
        this.consume(TokenType::Semicolon, "';'");
        return new DoWhileStmtNode(body, condition, this.span_from(start));
    }

    /// Parse a for statement: for (init; cond; update) body
    /// or for-in: for (item in collection) body
    parse_for_statement() -> StatementNode* {
        const start: Token = this.advance(); // consume 'for'
        // The surrounding `()` are optional: `for (x in it)` and `for x in it`
        // (and the C-style `for init; cond; upd`) are both accepted.  When
        // omitted, the trailing header expression (collection / update) is parsed
        // with bare struct literals suppressed so the following `{` reads as the
        // loop body.
        const has_paren: boolean = this.match_tok(TokenType::LParen);

        // For-in syntax: `for (x in iter) body` desugars at parse time into
        //
        //     {
        //         mut __cryo_for_iter_N = <collection>;
        //         loop {
        //             match (__cryo_for_iter_N.next()) {
        //                 Option::Some(x) => { <body> }
        //                 Option::None    => { break; }
        //             }
        //         }
        //     }
        //
        // The collection expression is evaluated exactly once (it becomes
        // the initializer of `__cryo_for_iter_N`).  Type inference for the
        // iterator binding piggybacks on the `is_auto` carve-out in sema
        // (same path lambda bindings use); the binding's type is taken
        // from the initializer once the latter is resolved.  Drop of the
        // iterator is handled by the existing scope-exit drop synthesis
        // on the outer block.
        if (this.check(TokenType::Identifier) && this.peek_at(1).kind == TokenType::KwIn) {
            const iter_tok: Token = this.advance();             // bound name (`x`)
            this.advance();                                     // consume 'in'
            mut collection: ExpressionNode* = null;
            if (has_paren) { collection = this.parse_expression(); }
            else           { collection = this.parse_expr_no_struct_lit(); }
            if (collection == null) {
                this.report_error(ErrorCode::E0102_EXPECTED_EXPRESSION,
                    "expected an iterator expression after `in`");
                if (has_paren) { this.consume(TokenType::RParen, "')'"); }
                return this.parse_statement_or_block();
            }
            if (has_paren) { this.consume(TokenType::RParen, "')'"); }
            const body: StatementNode* = this.parse_statement_or_block();
            const full_span: SourceSpan = this.span_from(start);
            return this.build_for_in_desugar(iter_tok, collection, body, full_span);
        }

        // C-style for: for (init; cond; update) body
        mut init: ASTNode* = null;
        if (!this.check(TokenType::Semicolon)) {
            if (this.check(TokenType::KwConst) || this.check(TokenType::KwMut)) {
                init = this.parse_variable_declaration();
            } else {
                const expr: ExpressionNode* = this.parse_expression();
                this.consume(TokenType::Semicolon, "';'");
                init = expr;
            }
        } else {
            this.advance(); // consume ';'
        }

        mut condition: ExpressionNode* = null;
        if (!this.check(TokenType::Semicolon)) {
            condition = this.parse_expression();
        }
        this.consume(TokenType::Semicolon, "';'");

        mut update: ExpressionNode* = null;
        if (has_paren) {
            if (!this.check(TokenType::RParen)) {
                update = this.parse_expression();
            }
            this.consume(TokenType::RParen, "')'");
        } else {
            // Paren-less: the update runs until the loop body's `{`.
            if (!this.check(TokenType::LBrace)) {
                update = this.parse_expr_no_struct_lit();
            }
        }

        const body: StatementNode* = this.parse_statement_or_block();
        return new ForStmtNode(init, condition, update, body, this.span_from(start));
    }

    /// Synthesise the desugaring of `for (x in collection) body` into:
    ///
    ///     {
    ///         mut __cryo_for_iter_N = collection;
    ///         loop {
    ///             match (__cryo_for_iter_N.next()) {
    ///                 Option::Some(x) => { body }
    ///                 Option::None    => { break; }
    ///             }
    ///         }
    ///     }
    ///
    /// Each for-in gets a fresh `N` so nested / sibling loops never alias.
    /// The iterator binding carries `is_auto = true`; sema's existing
    /// initializer-type back-fill (same path used for lambda-bound `const`
    /// vars) supplies its type.  The user's loop variable is bound by the
    /// `Some(x)` arm pattern, which already means `break` / `continue` /
    /// `return` inside the body behave like an ordinary `loop`.
    build_for_in_desugar(iter_tok: Token, collection: ExpressionNode*,
                         body: StatementNode*, full_span: SourceSpan) -> StatementNode* {
        const iter_span: SourceSpan = this.span_from_token(iter_tok);
        const user_name: SymbolStr  = this.intern_lexeme(iter_tok);

        // Fresh synthetic name `__cryo_for_iter_N`.
        g_for_in_counter += 1;
        const iter_str:  string    = format("__cryo_for_iter_%u", g_for_in_counter);
        const iter_name: SymbolStr = this.ctx.intern(iter_str);

        // `mut __cryo_for_iter_N = collection;`
        mut iter_decl: VarDeclNode* = new VarDeclNode(iter_name, full_span);
        iter_decl.set_mutable(true);
        iter_decl.set_auto(true);                      // type from initializer
        iter_decl.set_initializer(collection);
        const iter_decl_stmt: DeclStmtNode* = new DeclStmtNode(
            iter_decl as DeclarationNode*, full_span);

        // `__cryo_for_iter_N.next()` - match scrutinee.
        const iter_ident:  IdentifierNode*    = new IdentifierNode(iter_name, full_span);
        const next_name:   SymbolStr          = this.ctx.intern("next");
        const next_member: MemberAccessNode*  = new MemberAccessNode(
            iter_ident as ExpressionNode*, next_name, full_span, full_span);
        const next_call:   CallExprNode*      = new CallExprNode(
            next_member as ExpressionNode*, full_span);

        // `Option::Some(x) => { body }`
        const opt_name:  SymbolStr = this.ctx.intern("Option");
        const some_name: SymbolStr = this.ctx.intern("Some");
        const none_name: SymbolStr = this.ctx.intern("None");

        mut some_pat: EnumPatternNode* = new EnumPatternNode(iter_span);
        some_pat.set_enum_name(opt_name);
        some_pat.set_variant_name(some_name);
        const pb: PatternBinding* = new PatternBinding { name: user_name, span: iter_span };
        some_pat.add_element(PatternElement::Binding(pb));

        mut some_arm: MatchArmNode* = new MatchArmNode(full_span);
        some_arm.add_pattern(some_pat as PatternNode*);
        // The user's body block becomes the arm body verbatim.  If the
        // body parsed as a non-block statement, wrap it so the arm body
        // is always a block (matches the rest of the parser's invariant).
        mut some_body: BlockStmtNode* = null;
        if (body != null && (body as ASTNode*).kind == NodeKind::BlockStatement) {
            some_body = body as BlockStmtNode*;
        } else {
            some_body = new BlockStmtNode(if (body != null) { body.span } else { full_span });
            if (body != null) { some_body.add_statement(body); }
        }
        some_arm.set_body(some_body as StatementNode*);

        // `Option::None => { break; }`
        mut none_pat: EnumPatternNode* = new EnumPatternNode(full_span);
        none_pat.set_enum_name(opt_name);
        none_pat.set_variant_name(none_name);

        mut none_arm: MatchArmNode* = new MatchArmNode(full_span);
        none_arm.add_pattern(none_pat as PatternNode*);
        mut none_body: BlockStmtNode* = new BlockStmtNode(full_span);
        none_body.add_statement(new BreakStmtNode(full_span) as StatementNode*);
        none_arm.set_body(none_body as StatementNode*);

        // `match (__cryo_for_iter_N.next()) { Some(x)=>..., None=>... }`
        mut match_stmt: MatchStmtNode* = new MatchStmtNode(
            next_call as ExpressionNode*, full_span);
        match_stmt.add_arm(some_arm);
        match_stmt.add_arm(none_arm);

        // `loop { <match> }`
        mut loop_body: BlockStmtNode* = new BlockStmtNode(full_span);
        loop_body.add_statement(match_stmt as StatementNode*);
        const loop_stmt: LoopStmtNode* = new LoopStmtNode(
            loop_body as StatementNode*, full_span);

        // `{ <iter_decl_stmt>; <loop_stmt>; }`
        mut outer: BlockStmtNode* = new BlockStmtNode(full_span);
        outer.add_statement(iter_decl_stmt as StatementNode*);
        outer.add_statement(loop_stmt as StatementNode*);
        return outer as StatementNode*;
    }

    /// Parse a match statement: match (expr) { arms }
    parse_match_statement() -> MatchStmtNode* {
        const start: Token = this.advance(); // consume 'match'
        const subject: ExpressionNode* = this.parse_paren_condition();
        this.consume(TokenType::LBrace, "'{'");

        mut match_stmt: MatchStmtNode* = new MatchStmtNode(subject, this.span_from_token(start));

        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            const before_pos: int = this.pos;
            const arm: MatchArmNode* = this.parse_match_arm();
            if (arm != null) {
                match_stmt.add_arm(arm);
            }
            if (this.panic_mode) {
                this.synchronize();
            }
            // Progress guard: if neither parse_match_arm nor synchronize
            // advanced the cursor, force one token of progress so we don't
            // loop forever on a token that can't start a pattern (e.g. a
            // KwReturn left over after a malformed scrutinee; synchronize
            // stops at statement-start tokens without consuming them).
            if (this.pos == before_pos) {
                this.advance();
            }
        }

        this.consume(TokenType::RBrace, "'}'");
        match_stmt.span = this.span_from(start);
        return match_stmt;
    }

    /// Parse a static match statement: `static match (Type) { type-arms }`.
    /// Used when arms yield no value. Reuses parse_static_match_arm (inherited
    /// from ExprParser); arm blocks parse full statements via the Parser
    /// override of parse_inner_block.
    parse_static_match_statement() -> StaticMatchStmtNode* {
        const start: Token = this.advance(); // consume 'static'
        this.advance();                      // consume 'match'
        this.consume(TokenType::LParen, "'('");
        const scrutinee: TypeAnnotation* = this.parse_type_annotation();
        this.consume(TokenType::RParen, "')'");
        this.consume(TokenType::LBrace, "'{'");

        mut sm: StaticMatchStmtNode* = new StaticMatchStmtNode(
            scrutinee, this.span_from_token(start));

        while (!this.check(TokenType::RBrace) && !this.is_at_end()) {
            const before_pos: int = this.pos;
            const arm: StaticMatchArmNode* = this.parse_static_match_arm();
            if (arm != null) {
                sm.add_arm(arm);
            }
            if (this.panic_mode) {
                this.synchronize();
            }
            if (this.pos == before_pos) {
                this.advance();
            }
        }

        this.consume(TokenType::RBrace, "'}'");
        sm.span = this.span_from(start);
        return sm;
    }

    /// Parse a match arm for statement context: pattern => { body }.
    /// Uses shared parse_match_arm_patterns() for pattern + '=>', then
    /// handles the body as a full block (declarations, statements, expressions).
    /// See also: ExprParser::parse_expr_match_arm() for expression context.
    parse_match_arm() -> MatchArmNode* {
        const start: Token = this.current();
        mut arm: MatchArmNode* = this.parse_match_arm_patterns();

        if (this.check(TokenType::LBrace)) {
            // Block body - semicolons optional before `}`, same shape as
            // parse_inner_block (used for function bodies / loop bodies).
            arm.set_body(this.parse_inner_block());
        } else {
            // Single statement/expression
            const stmt: StatementNode* = this.parse_statement();
            if (stmt != null) {
                arm.set_body(stmt);
            }
        }

        arm.span = this.span_from(start);
        return arm;
    }

    /// Parse a return statement: return [expr];
    parse_return_statement() -> ReturnStmtNode* {
        const start: Token = this.advance(); // consume 'return'
        mut expr: ExpressionNode* = null;

        if (!this.check(TokenType::Semicolon) && !this.check(TokenType::RBrace)) {
            expr = this.parse_expression();
        }

        // Semicolon is required, but optional after expressions that end
        // with '}' (struct literals, match expressions, blocks).
        // This allows: return ArenaChunk { field: value }
        if (!this.match_tok(TokenType::Semicolon)) {
            // Only error if we're not at a '}' (which means the expression
            // was a struct/match/block that consumed the '}' already, and
            // the next token is the function's closing brace).
            if (!this.check(TokenType::RBrace)) {
                this.consume(TokenType::Semicolon, "';'");
            }
        }
        return new ReturnStmtNode(expr, this.span_from(start));
    }

    /// Parse a break statement: break;
    parse_break_statement() -> BreakStmtNode* {
        const start: Token = this.advance(); // consume 'break'
        this.consume(TokenType::Semicolon, "';'");
        return new BreakStmtNode(this.span_from(start));
    }

    /// Parse a continue statement: continue;
    parse_continue_statement() -> ContinueStmtNode* {
        const start: Token = this.advance(); // consume 'continue'
        this.consume(TokenType::Semicolon, "';'");
        return new ContinueStmtNode(this.span_from(start));
    }

    /// Parse an expression statement: expr;
    parse_expression_statement() -> ExprStmtNode* {
        const expr: ExpressionNode* = this.parse_expression();
        if (expr == null) {
            // Try to recover
            if (!this.is_at_end()) {
                this.advance();
            }
            return null;
        }
        this.consume(TokenType::Semicolon, "';'");
        return new ExprStmtNode(expr, expr.span);
    }

    /// Parse an unsafe block: unsafe { ... }
    parse_unsafe_block() -> UnsafeBlockStmtNode* {
        const start: Token = this.advance(); // consume 'unsafe'
        const block: BlockStmtNode* = this.parse_block_statement();
        return new UnsafeBlockStmtNode(block, this.span_from(start));
    }

    /// Parse an inline-assembly block: `asm { ...raw asm... }`.
    ///
    /// The body is captured as raw assembly text (comments already stripped
    /// by `advance()`), with `${...}` operand references pulled out into typed
    /// operands.  Bare `{` / `}` are literal assembly (so e.g. AVX-512 masks
    /// `{k1}` pass straight through); brace depth is tracked to find the
    /// block's closing `}`.  Exact inter-token spacing is reconstructed from
    /// column deltas so tight sequences like AT&T `%rax` / `$60` stay glued
    /// while `mov rax, 60` keeps its spaces.  `pending` are the `![arch(...)]`
    /// / `![clobber(...)]` directives already drained by the caller; arch,
    /// dialect and clobbers are lifted out of them here (validated later by
    /// the directive-processing pass).
    ///
    /// Operand grammar inside `${ }` (LLVM-prefix style):
    ///   `${x}`        input, any general register
    ///   `${=x}`       output
    ///   `${+x}`       in-out
    ///   `${x:"rax"}`  pin to a specific register
    ///   `${x:m}`      memory operand (passed by address)
    ///   `${x:i}`      immediate ; `${x:r}` explicit general register
    parse_asm_block(pending: DirectiveNode*[], is_module: boolean) -> AsmBlockStmtNode* {
        const start: Token = this.advance(); // consume 'asm'
        mut node: AsmBlockStmtNode* = new AsmBlockStmtNode(this.span_from_token(start));
        node.is_module_level = is_module;

        // Lift arch / dialect / clobbers out of the attached directives.
        for (mut i: i64 = 0; i < pending.length; i++) {
            const d: DirectiveNode* = pending[i];
            if (d == null) { continue; }
            node.add_directive(d);
            if (d.directive_kind == "arch") {
                if (d.args.length >= 1 && d.args[0].kind == DirectiveArgKind::Ident) {
                    node.arch = d.args[0].name;
                }
                if (d.args.length >= 2 && d.args[1].kind == DirectiveArgKind::Ident) {
                    if (d.args[1].name == "intel") { node.dialect = AsmDialect::Intel; }
                    else { node.dialect = AsmDialect::ATT; }
                }
            } else if (d.directive_kind == "clobber") {
                for (mut j: i64 = 0; j < d.args.length; j++) {
                    if (d.args[j].kind == DirectiveArgKind::Ident) {
                        node.add_clobber(d.args[j].name);
                    }
                }
            }
        }

        this.consume(TokenType::LBrace, "'{'");

        mut current_text: string = "";
        mut prev_line: int = -1;
        mut prev_end_col: int = -1;
        // Names parallel to `node.operands`, for dedup of repeated `${x}` refs.
        mut names: string[] = [];
        // Brace depth inside the block.  Bare `{` / `}` are literal assembly
        // text (so e.g. AVX-512 masks `{k1}` pass straight through); only the
        // `}` that returns depth to 0 terminates the block.  `${...}` operand
        // braces never reach this counter - the operand path consumes them.
        mut depth: i64 = 1;

        while (true) {
            if (this.is_at_end()) {
                this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                    "unterminated `asm { ... }` block (missing '}')");
                break;
            }
            const tok: Token = this.current();

            // Whitespace separating this unit from the previous emitted one.
            mut sep: string = "";
            if (prev_line >= 0) {
                if (tok.line != prev_line) {
                    sep = "\n";
                } else {
                    mut n: int = tok.column - prev_end_col;
                    mut k: int = 0;
                    while (k < n) { sep = sep + " "; k = k + 1; }
                }
            }

            // `${ ... }` operand reference.  A bare `{` (no leading `$`) is
            // literal assembly, handled by the brace-depth logic below.
            if (tok.kind == TokenType::Dollar
                    && this.peek_at(1).kind == TokenType::LBrace) {
                current_text = current_text + sep;
                if (current_text != "") { node.add_piece(AsmPiece::raw(current_text)); }
                current_text = "";

                this.advance(); // consume '$'
                this.advance(); // consume '{'

                mut dir: AsmOpDir = AsmOpDir::In;
                if (this.check(TokenType::Equal)) { this.advance(); dir = AsmOpDir::Out; }
                else if (this.check(TokenType::Plus)) { this.advance(); dir = AsmOpDir::InOut; }

                // Record a plain identifier operand's name so repeated refs
                // to the same variable collapse to one operand.
                mut opname: string = "";
                if (this.check(TokenType::Identifier)) {
                    const nxt: Token = this.peek_at(1);
                    if (nxt.kind == TokenType::RBrace || nxt.kind == TokenType::Colon) {
                        opname = this.current().lexeme;
                    }
                }
                const expr: ExpressionNode* = this.parse_expression();

                mut ck: AsmConstraintKind = AsmConstraintKind::Reg;
                mut pin: string = "";
                if (this.check(TokenType::Colon)) {
                    this.advance();
                    if (this.check(TokenType::StringLiteral)) {
                        const s: Token = this.advance();
                        ck = AsmConstraintKind::Pinned;
                        pin = ParserBase::unquote_string_lexeme(s.lexeme);
                    } else if (this.check(TokenType::Identifier)) {
                        const c: Token = this.advance();
                        if (c.lexeme == "m") { ck = AsmConstraintKind::Memory; }
                        else if (c.lexeme == "i") { ck = AsmConstraintKind::Imm; }
                        else if (c.lexeme == "r") { ck = AsmConstraintKind::Reg; }
                        else {
                            this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                                format("unknown asm operand constraint '%s' (expected r, m, i, or a \"register\")",
                                    c.lexeme));
                        }
                    } else {
                        this.report_error(ErrorCode::E0111_INVALID_SYNTAX,
                            "expected an asm operand constraint after ':' (a \"register\", m, i, or r)");
                    }
                }
                const rb: Token = this.consume(TokenType::RBrace, "'}'");
                prev_line = rb.line;
                prev_end_col = rb.column + rb.source_length;

                // Dedup by identifier name; merge directions (in + out => inout).
                mut idx: i64 = -1;
                if (opname != "") {
                    mut j: i64 = 0;
                    while (j < names.length) {
                        if (names[j] == opname) { idx = j; break; }
                        j = j + 1;
                    }
                }
                if (idx >= 0) {
                    mut existing: AsmOperand* = node.operands[idx];
                    if (existing.direction != dir) { existing.direction = AsmOpDir::InOut; }
                    if (existing.constraint == AsmConstraintKind::Reg
                            && ck != AsmConstraintKind::Reg) {
                        existing.constraint = ck;
                        existing.pinned_reg = pin;
                    }
                } else {
                    const op: AsmOperand* = new AsmOperand(dir, expr, ck, pin);
                    idx = node.add_operand(op);
                    names.push(opname);
                }
                node.add_piece(AsmPiece::operand(idx));
                continue;
            }

            // Closing `}`: at depth 0 it terminates the block; deeper, it is
            // a literal brace in the assembly.
            if (tok.kind == TokenType::RBrace) {
                depth = depth - 1;
                if (depth == 0) {
                    if (current_text != "") { node.add_piece(AsmPiece::raw(current_text)); }
                    this.advance(); // consume closing '}'
                    break;
                }
                current_text = current_text + sep + "}";
                prev_line = tok.line;
                prev_end_col = tok.column + tok.source_length;
                this.advance();
                continue;
            }

            // Literal `{` in the assembly (e.g. an AVX-512 mask `{k1}`).
            if (tok.kind == TokenType::LBrace) {
                depth = depth + 1;
                current_text = current_text + sep + "{";
                prev_line = tok.line;
                prev_end_col = tok.column + tok.source_length;
                this.advance();
                continue;
            }

            // Ordinary raw assembly token.  For a FUNCTION-level block a
            // literal `$` (AT&T immediate prefix, e.g. `$60`) must be doubled
            // to `$$` because LLVM uses `$` as the operand-reference escape in
            // the inline-asm template.  Module-level asm is emitted verbatim
            // (no operand substitution), so `$` must stay a single `$` there.
            // `$` only ever arrives as its own Dollar token.
            mut piece_text: string = tok.lexeme;
            if (tok.kind == TokenType::Dollar && !is_module) { piece_text = "$$"; }
            current_text = current_text + sep + piece_text;
            prev_line = tok.line;
            prev_end_col = tok.column + tok.source_length;
            this.advance();
        }

        node.span = this.span_from(start);
        return node;
    }

    /// Helper: parse a statement that should be a block, or wrap in one.
    parse_statement_or_block() -> StatementNode* {
        if (this.check(TokenType::LBrace)) {
            return this.parse_block_statement();
        }
        return this.parse_statement();
    }
}
