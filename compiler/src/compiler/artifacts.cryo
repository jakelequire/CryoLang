///! Phase Artifacts
///!
///! Explicit data-flow containers for each compilation phase's output.
///! Replaces scattered state on CompilerInstance (_ast_root, _loaded_file,
///! _compiled_asts, etc.) with typed structs that make the data pipeline
///! visible: Lexing writes tokens, Parsing reads tokens and writes ast, etc.

namespace compiler::artifacts;

import compiler::lex::{ Token };
import compiler::ast::node::{ ProgramNode };

/// The result of lexing a source file.
type struct TokenStream {
    tokens:         [Token];
    source_file:    string;

    static empty() -> TokenStream {
        return TokenStream {
            tokens:         [],
            source_file:    "",
        };
    }

    static new(tokens: [Token], source_file_text: string) -> TokenStream {
        const source_file: string = source_file_text;
        return TokenStream {
            tokens:         tokens,
            source_file:    source_file,
        };
    }

    is_valid(&this) -> boolean {
        return this.tokens.length() > 0;
    }

}

/// The result of parsing a token stream into an AST.
type struct ASTOutput {
    root:           mut ProgramNode*;
    namespace_name: string;

    static empty() -> ASTOutput {
        return ASTOutput {
            root:           null,
            namespace_name: "",
        };
    }

    is_valid(&this) -> boolean {
        return this.root != null;
    }

    /// Typed accessor for the AST root. Centralizes the single cast.
    program(&this) -> ProgramNode* {
        return this.root as ProgramNode*;
    }
}


// TODO: (Placeholder) Opaque until @cImport available and actual LLVM module type can be used instead of void*.

/// Generated LLVM IR module.
type struct IROutput {
    llvm_module: mut void*;    // Opaque until @cImport available
    module_name: string;

    static empty() -> IROutput {
        return IROutput {
            llvm_module: null,
            module_name: "",
        };
    }

    is_valid(&this) -> boolean {
        return this.llvm_module != null;
    }
}

/// Path to the emitted object file or executable.
type struct LinkedOutput {
    object_file_path: string;

    static empty() -> LinkedOutput {
        return LinkedOutput {
            object_file_path: "",
        };
    }

}

/// A module's startup code - the function computing its started globals -
/// and the priority it runs at: the lower runs first.
type struct StartupCode {
    module_name: string;
    priority:    u32;
}

/// What the stdlib's own build records of each module for the archive's
/// manifest: its place in the build, whether it has startup code, its
/// object, and every symbol the object defines that another object can
/// link against.
type struct ArchivedModule {
    namespace_name: string;
    rank:           u32;
    startup:        boolean;
    object:         string;
    symbols:        [string];
}

/// Collects outputs from every compilation phase.
/// Passes write their results here; downstream passes read from here.
type struct PhaseArtifacts {
    tokens:     TokenStream;
    ast:        ASTOutput;
    ir:         IROutput;
    // A module LLVM's verifier refused.  It is never optimized or emitted;
    // it is kept only so `--emit-llvm` can write the IR that was refused.
    unverified_ir: IROutput;
    linked:     LinkedOutput;

    // Multi-module codegen: accumulated per-module object file paths.
    object_files: [string];

    /// The startup code of every module this build generated code for, and
    /// of every module whose startup code the program takes from the
    /// stdlib archive.
    startup: [StartupCode];

    /// The stdlib's own build: every module it archives, in build order.
    archived: [ArchivedModule];

    static new() -> PhaseArtifacts {
        return PhaseArtifacts {
            tokens:            TokenStream::empty(),
            ast:               ASTOutput::empty(),
            ir:                IROutput::empty(),
            unverified_ir:     IROutput::empty(),
            linked:            LinkedOutput::empty(),
            object_files:      [],
            startup:           [],
            archived:          [],
        };
    }

    record_archived(mut &this, entry: ArchivedModule) -> void {
        this.archived.push(entry);
    }

    record_startup(mut &this, module_name_text: string, priority: u32) -> void {
        const module_name: string = module_name_text;
        this.startup.push(StartupCode { module_name: module_name, priority: priority });
    }

    /// The modules with startup code, in the order it runs, comma-separated.
    startup_order(&this) -> string {
        mut order: [i64] = [];
        for (mut i: i64 = 0; i < this.startup.length(); i++) {
            mut at: i64 = order.length();
            order.push(i);
            while (at > 0 && this.startup[order[at - 1]].priority > this.startup[i].priority) {
                order[at] = order[at - 1];
                at = at - 1;
            }
            order[at] = i;
        }
        mut text: string = "";
        for (mut k: i64 = 0; k < order.length(); k++) {
            if (k > 0) { text = text + ", "; }
            text = text + this.startup[order[k]].module_name;
        }
        return text;
    }

    /// Record an emitted object file path.  Accessed through `mut &this`
    /// so `.push()` lands on the actual `object_files` array; reaching it
    /// via a multi-deref field chain (`ctx.artifacts.object_files.push(...)`)
    /// has historically pushed into a temporary copy and silently lost the
    /// entry.
    register_object_file(mut &this, path_text: string) -> void {
        const path: string = path_text;
        this.object_files.push(path);
    }
}
