///! Dependency Cache
///!
///! Locates the global cryo cache and lays out per-dependency directories
///! inside it.  The cache is shared across projects on a single machine
///! so that repeated `cryo fetch` calls don't re-clone identical repos.
///!
///! Layout under `<cache_root>/`:
///!
///!   git/<short id>/                 - bare clone, refreshed by `git fetch`
///!   git/<short id>.lock/            - held while a process changes either
///!   src/<short id>/<sha>/           - the files of the resolved commit, as
///!                                     git stores them (no working tree)
///!
///! Cache root resolution (first match wins):
///!   1. $CRYO_HOME/cache             (explicit override for CI / sandboxes)
///!   2. $XDG_CACHE_HOME/cryo         (Linux/freedesktop convention)
///!   3. $HOME/.cache/cryo            (POSIX fallback)
///!   4. /tmp/cryo-cache              (no-HOME fallback; warned)

namespace compiler::deps::cache;
import std::env;

import std::fs::directory::{ Directory };
import std::fs::path::{ Path, PathBuf };
import std::fmt;
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::encoding::sha256::{ Sha256 };
import compiler::utils::directory_lock::{ DirectoryLock };
import compiler::deps::git_url::{ GitUrl };

/// A repository's cache lock older than this was left by a process that
/// died: an hour, longer than any fetch takes.
const REPOSITORY_LOCK_EXPIRY_SECONDS: i64 = 3600;

/// Stateless namespace for the per-machine dependency cache layout.
/// All entry points are `static`; there is no instance state - the
/// cache lives on disk and is addressed purely by URL/SHA.
type struct Cache {

    // Cache root

    /// Resolve the cache root directory.  Creates intermediate dirs on
    /// first use.  Returns the absolute (or env-relative) path; never empty.
    ///
    /// Resolution (first match wins):
    ///   1. `$CRYO_HOME/cache`                     explicit override (CI / portable)
    ///   2. per-OS default (see `default_cache_root`):
    ///        Windows  `%LOCALAPPDATA%\cryo`  ->  `%USERPROFILE%\.cache\cryo`
    ///        Unix     `$XDG_CACHE_HOME/cryo` ->  `$HOME/.cache/cryo`
    ///   3. a temp dir (warned) only when no user directory resolves at all.
    static cache_root() -> PathBuf {
        // An EMPTY env var counts as unset (Windows shells often export "").
        const root: PathBuf = match (Cache::variable_with_suffix("CRYO_HOME", "")) {
            Option::Some(home) => { Cache::root_in_home(home.as_path()) }
            Option::None       => { Cache::default_cache_root() }
        };
        Cache::create_directory(root.as_path());
        return root;
    }

    /// The environment variable `name` with `suffix` appended, when it is
    /// set to anything but the empty string.
    static variable_with_suffix(name: Str, suffix: Str) -> Option<PathBuf> {
        match (env::var(name)) {
            Option::Some(value) => {
                mut text: String = value;
                if (text.length() == 0) { return Option::None; }
                text.push(suffix);
                return Option::Some(PathBuf::from(text.as_str()));
            }
            Option::None => { return Option::None; }
        }
    }

    /// Create the directory `path` names, and its parents.  One that cannot
    /// be created is reported with the reason here; what is written into it
    /// next then fails with its own error.
    static create_directory(path: Path) -> void {
        match (Directory::create_all(path)) {
            Result::Ok(_)      => { }
            Result::Err(error) => { fmt::eprintln(f"warning: cannot create {path.as_str()}: {error}"); }
        }
    }

    /// Windows per-user cache root: `%LOCALAPPDATA%\cryo` (the non-roaming,
    /// machine-local app-data convention), then `%USERPROFILE%\.cache\cryo`,
    /// then a `%TEMP%` last resort.  Forward slashes join the suffix to match
    /// the `/`-joined paths layered on top (Windows accepts mixed separators).
    ![target(windows)]
    static default_cache_root() -> PathBuf {
        match (Cache::variable_with_suffix("LOCALAPPDATA", "/cryo")) {
            Option::Some(root) => { return root; }
            Option::None       => { }
        }
        match (Cache::variable_with_suffix("USERPROFILE", "/.cache/cryo")) {
            Option::Some(root) => { return root; }
            Option::None       => { }
        }
        match (Cache::variable_with_suffix("TEMP", "/cryo-cache")) {
            Option::Some(root) => {
                fmt::eprintf("warning: LOCALAPPDATA and USERPROFILE unset; using %%TEMP%% for the cryo cache\n");
                return root;
            }
            Option::None => { }
        }
        fmt::eprintf("warning: no user directory resolved; using C:/tmp/cryo-cache\n");
        return PathBuf::from("C:/tmp/cryo-cache");
    }

    /// Unix per-user cache root: `$XDG_CACHE_HOME/cryo` (XDG Base Directory),
    /// then `$HOME/.cache/cryo`, then `/tmp/cryo-cache`.
    ![target(unix)]
    static default_cache_root() -> PathBuf {
        match (Cache::variable_with_suffix("XDG_CACHE_HOME", "/cryo")) {
            Option::Some(root) => { return root; }
            Option::None       => { }
        }
        match (Cache::variable_with_suffix("HOME", "/.cache/cryo")) {
            Option::Some(root) => { return root; }
            Option::None       => { }
        }
        fmt::eprintf("warning: $HOME and $XDG_CACHE_HOME unset; using /tmp/cryo-cache\n");
        return PathBuf::from("/tmp/cryo-cache");
    }

    /// `<cache_root>/git/<short id>`: bare clone for a given remote URL.
    static git_dir_for(url: Str) -> PathBuf {
        const id: String = Cache::short_id(url);
        return Cache::cache_root().join("git").join(id.as_str());
    }

    /// The lock of the cache's entries for `url`, `<cache_root>/git/<short
    /// id>.lock`: held while one process clones or fetches that repository
    /// or extracts one of its commits, since builds and tests running at
    /// once share the cache.  One left by a process that died is cleared
    /// after an hour, longer than any fetch takes.
    static repository_lock(url: Str) -> DirectoryLock {
        const git: PathBuf = Cache::cache_root().join("git");
        Cache::create_directory(git.as_path());
        const id: String = Cache::short_id(url);
        const path: PathBuf = git.join(f"{id}.lock".as_str());
        return DirectoryLock::new(path.as_path().as_str(), f"to fetch {url}".as_str(), REPOSITORY_LOCK_EXPIRY_SECONDS);
    }

    /// `<cache_root>/src/<short id>/<sha>`: the files of one commit, as git
    /// stores them.  Several commits of one remote can sit side by side
    /// (two projects pinning different versions).
    static extraction_dir_for(url: Str, sha: Str) -> PathBuf {
        return Cache::extraction_dir_in(Cache::cache_root().as_path(), url, sha);
    }

    /// The cache root a `$CRYO_HOME` of `home` gives: `<home>/cache`.
    static root_in_home(home: Path) -> PathBuf {
        return home.join("cache");
    }

    /// `<root>/src/<short id>/<sha>`: where the cache at `root` keeps the
    /// files of commit `sha` of `url`.
    static extraction_dir_in(root: Path, url: Str, sha: Str) -> PathBuf {
        const id: String = Cache::short_id(url);
        return root.join("src").join(id.as_str()).join(sha);
    }

    /// The directory name a repository's cache entries are kept under: the
    /// first 16 hex digits of the SHA-256 of its identity
    /// (`GitUrl::canonical`), then `-` and the identity's last path
    /// segment, each byte outside letters, digits, `.`, `-` and `_` written
    /// `_` (`https://example.com/acme/json5.git` -> `<16 hex digits>-json5`).
    /// Every spelling of one repository's URL shares the entry, the digest
    /// tells repositories apart, so two that end alike never share one, and
    /// the length stays the same however long the URL is, which keeps a
    /// cached file's path inside the operating system's limit.
    static short_id(url: Str) -> String {
        const identity: String = GitUrl::canonical(url);
        mut out: String = Sha256::digest(identity.as_str().as_bytes()).to_hex();
        out.truncate(16);
        out.push("-");
        const segment: Str = identity.as_str();
        mut start: i64 = 0;
        for (mut i: i64 = 0; i < segment.length(); i++) {
            const byte: u8 = segment.byte_at(i).unwrap_or(0);
            if (byte == '/' as u8 || byte == ':' as u8) { start = i + 1; }
        }
        for (mut i: i64 = start; i < segment.length(); i++) {
            const byte: u8 = segment.byte_at(i).unwrap_or(0);
            const c: char = byte as char;
            const safe: boolean = c.is_alphanumeric() || c == '.' || c == '-' || c == '_';
            out.push_byte(if (safe) { byte } else { '_' as u8 });
        }
        return out;
    }
}
