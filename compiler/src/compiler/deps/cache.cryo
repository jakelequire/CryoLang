///! Dependency Cache
///!
///! Locates the global cryo cache and lays out per-dependency directories
///! inside it.  The cache is shared across projects on a single machine
///! so that repeated `cryo fetch` calls don't re-clone identical repos.
///!
///! Layout under `<cache_root>/`:
///!
///!   git/<sanitized-url>/                 - bare clone, refreshed by `git fetch`
///!   checkouts/<sanitized-url>/<sha>/     - working tree at the resolved commit
///!
///! Cache root resolution (first match wins):
///!   1. $CRYO_HOME/cache             (explicit override for CI / sandboxes)
///!   2. $XDG_CACHE_HOME/cryo         (Linux/freedesktop convention)
///!   3. $HOME/.cache/cryo            (POSIX fallback)
///!   4. /tmp/cryo-cache              (no-HOME fallback; warned)

namespace compiler::deps::cache;
import std::env;

import std::fs::directory::{ Directory };
import std::fs::path::{ Path, PathBuf };
import std::fmt;
import std::collections::str::{ Str };
import std::collections::string::{ String };


/// Stateless namespace for the per-machine dependency cache layout.
/// All entry points are `static`; there is no instance state - the
/// cache lives on disk and is addressed purely by URL/SHA.
type struct Cache {

    // Cache root

    /// Resolve the cache root directory.  Creates intermediate dirs on
    /// first use.  Returns the absolute (or env-relative) path; never empty.
    ///
    /// Resolution (first match wins):
    ///   1. `$CRYO_HOME/cache`                     explicit override (CI / portable)
    ///   2. per-OS default (see `default_cache_root`):
    ///        Windows  `%LOCALAPPDATA%\cryo`  ->  `%USERPROFILE%\.cache\cryo`
    ///        Unix     `$XDG_CACHE_HOME/cryo` ->  `$HOME/.cache/cryo`
    ///   3. a temp dir (warned) only when no user directory resolves at all.
    static cache_root() -> PathBuf {
        // An EMPTY env var counts as unset (Windows shells often export "").
        const root: PathBuf = match (Cache::variable_with_suffix("CRYO_HOME", "/cache")) {
            Option::Some(home) => { home }
            Option::None       => { Cache::default_cache_root() }
        };
        Cache::create_directory(root.as_path());
        return root;
    }

    /// The environment variable `name` with `suffix` appended, when it is
    /// set to anything but the empty string.
    static variable_with_suffix(name: Str, suffix: Str) -> Option<PathBuf> {
        match (env::var(name)) {
            Option::Some(value) => {
                mut text: String = value;
                if (text.length() == 0) { return Option::None; }
                text.push(suffix);
                return Option::Some(PathBuf::from(text.as_str()));
            }
            Option::None => { return Option::None; }
        }
    }

    /// Create the directory `path` names, and its parents.  One that cannot
    /// be created is reported with the reason here; what is written into it
    /// next then fails with its own error.
    static create_directory(path: Path) -> void {
        match (Directory::create_all(path)) {
            Result::Ok(_)      => { }
            Result::Err(error) => { fmt::eprintln(f"warning: cannot create {path.as_str()}: {error}"); }
        }
    }

    /// Windows per-user cache root: `%LOCALAPPDATA%\cryo` (the non-roaming,
    /// machine-local app-data convention), then `%USERPROFILE%\.cache\cryo`,
    /// then a `%TEMP%` last resort.  Forward slashes join the suffix to match
    /// the `/`-joined paths layered on top (Windows accepts mixed separators).
    ![target(windows)]
    static default_cache_root() -> PathBuf {
        match (Cache::variable_with_suffix("LOCALAPPDATA", "/cryo")) {
            Option::Some(root) => { return root; }
            Option::None       => { }
        }
        match (Cache::variable_with_suffix("USERPROFILE", "/.cache/cryo")) {
            Option::Some(root) => { return root; }
            Option::None       => { }
        }
        match (Cache::variable_with_suffix("TEMP", "/cryo-cache")) {
            Option::Some(root) => {
                fmt::eprintf("warning: LOCALAPPDATA and USERPROFILE unset; using %%TEMP%% for the cryo cache\n");
                return root;
            }
            Option::None => { }
        }
        fmt::eprintf("warning: no user directory resolved; using C:/tmp/cryo-cache\n");
        return PathBuf::from("C:/tmp/cryo-cache");
    }

    /// Unix per-user cache root: `$XDG_CACHE_HOME/cryo` (XDG Base Directory),
    /// then `$HOME/.cache/cryo`, then `/tmp/cryo-cache`.
    ![target(unix)]
    static default_cache_root() -> PathBuf {
        match (Cache::variable_with_suffix("XDG_CACHE_HOME", "/cryo")) {
            Option::Some(root) => { return root; }
            Option::None       => { }
        }
        match (Cache::variable_with_suffix("HOME", "/.cache/cryo")) {
            Option::Some(root) => { return root; }
            Option::None       => { }
        }
        fmt::eprintf("warning: $HOME and $XDG_CACHE_HOME unset; using /tmp/cryo-cache\n");
        return PathBuf::from("/tmp/cryo-cache");
    }

    /// `<cache_root>/git/<sanitized>`: bare clone for a given remote URL.
    static git_dir_for(url: Str) -> PathBuf {
        const sanitized: String = Cache::sanitize_url(url);
        return Cache::cache_root().join("git").join(sanitized.as_str());
    }

    /// `<cache_root>/checkouts/<sanitized>/<sha>`: working tree at a
    /// specific resolved commit.  Multiple SHAs from the same remote can
    /// coexist (e.g., when two projects pin different versions).
    static checkout_dir_for(url: Str, sha: Str) -> PathBuf {
        const sanitized: String = Cache::sanitize_url(url);
        return Cache::cache_root().join("checkouts").join(sanitized.as_str()).join(sha);
    }


    // URL sanitization

    /// Normalize a remote URL into a filesystem-safe directory name.
    ///
    /// Examples:
    ///   https://github.com/foo/bar.git     ->  github.com_foo_bar
    ///   git@github.com:foo/bar.git         ->  github.com_foo_bar
    ///   ssh://git@github.com/foo/bar       ->  github.com_foo_bar
    ///
    /// Collisions between distinct URLs that normalize to the same name
    /// are theoretically possible but vanishingly unlikely for real-world
    /// remotes; we accept the risk for a much friendlier cache layout
    /// than a raw hash would give.
    static sanitize_url(url: Str) -> String {
        // Stripped in this order, so `ssh://git@host` loses both.
        const schemes: [Str; 5] = [Str::new("https://"), Str::new("http://"), Str::new("ssh://"),
                                   Str::new("git://"), Str::new("git@")];
        mut rest: Str = url;
        for (mut i: i64 = 0; i < 5; i++) {
            rest = rest.strip_prefix(&schemes[i]).unwrap_or(rest);
        }
        const git_suffix: Str = Str::new(".git");
        rest = rest.strip_suffix(&git_suffix).unwrap_or(rest);

        // Replace path-unfriendly bytes with '_'; a byte is kept as it is,
        // so a name in UTF-8 stays the same bytes.
        mut out: String = String::with_capacity(rest.length());
        for (mut i: i64 = 0; i < rest.length(); i++) {
            const byte: u8 = rest.byte_at(i).unwrap_or(0);
            const c: char = byte as char;
            const safe: boolean = c.is_alphanumeric() || c == '.' || c == '-' || c == '_';
            out.push_byte(if (safe) { byte } else { '_' as u8 });
        }
        return out;
    }
}
