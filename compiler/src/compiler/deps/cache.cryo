///! Dependency Cache
///!
///! Locates the global cryo cache and lays out per-dependency directories
///! inside it.  The cache is shared across projects on a single machine
///! so that repeated `cryo fetch` calls don't re-clone identical repos.
///!
///! Layout under `<cache_root>/`:
///!
///!   git/<sanitized-url>/                 - bare clone, refreshed by `git fetch`
///!   checkouts/<sanitized-url>/<sha>/     - working tree at the resolved commit
///!
///! Cache root resolution (first match wins):
///!   1. $CRYO_HOME/cache             (explicit override for CI / sandboxes)
///!   2. $XDG_CACHE_HOME/cryo         (Linux/freedesktop convention)
///!   3. $HOME/.cache/cryo            (POSIX fallback)
///!   4. /tmp/cryo-cache              (no-HOME fallback; warned)

namespace compiler::deps::cache;
import std::env;

import utils::logger;
import std::fs::dir;
import std::fs::path;
import std::fmt;
import std::collections::str;
import std::collections::string;
import std::ffi::libc;


/// Stateless namespace for the per-machine dependency cache layout.
/// All entry points are `static`; there is no instance state - the
/// cache lives on disk and is addressed purely by URL/SHA.
type struct Cache {

    // Cache root

    /// Resolve the cache root directory.  Creates intermediate dirs on
    /// first use.  Returns the absolute (or env-relative) path; never empty.
    ///
    /// Resolution (first match wins):
    ///   1. `$CRYO_HOME/cache`                     explicit override (CI / portable)
    ///   2. per-OS default (see `default_cache_root`):
    ///        Windows  `%LOCALAPPDATA%\cryo`  ->  `%USERPROFILE%\.cache\cryo`
    ///        Unix     `$XDG_CACHE_HOME/cryo` ->  `$HOME/.cache/cryo`
    ///   3. a temp dir (warned) only when no user directory resolves at all.
    static cache_root() -> string {
        // An EMPTY env var counts as unset (Windows shells often export "").
        match (env::var(Str::new("CRYO_HOME"))) {
            Option::Some(v) => {
                mut s: String = v;
                if (s.length() > 0) {
                    s.push(Str::new("/cache"));
                    const root: string = s.into_raw();
                    dir::create_dir_all(Path::from(root));
                    return root;
                }
            }
            Option::None => {}
        }
        const root: string = Cache::default_cache_root();
        dir::create_dir_all(Path::from(root));
        return root;
    }

    /// Windows per-user cache root: `%LOCALAPPDATA%\cryo` (the non-roaming,
    /// machine-local app-data convention), then `%USERPROFILE%\.cache\cryo`,
    /// then a `%TEMP%` last resort.  Forward slashes join the suffix to match
    /// the `/`-joined paths layered on top (Windows accepts mixed separators).
    ![target(windows)]
    static default_cache_root() -> string {
        match (env::var(Str::new("LOCALAPPDATA"))) {
            Option::Some(v) => {
                mut s: String = v;
                if (s.length() > 0) { s.push(Str::new("/cryo")); return s.into_raw(); }
            }
            Option::None => {}
        }
        match (env::var(Str::new("USERPROFILE"))) {
            Option::Some(v) => {
                mut s: String = v;
                if (s.length() > 0) { s.push(Str::new("/.cache/cryo")); return s.into_raw(); }
            }
            Option::None => {}
        }
        match (env::var(Str::new("TEMP"))) {
            Option::Some(v) => {
                mut s: String = v;
                if (s.length() > 0) {
                    fmt::eprintf("warning: LOCALAPPDATA and USERPROFILE unset; using %%TEMP%% for the cryo cache\n");
                    s.push(Str::new("/cryo-cache"));
                    return s.into_raw();
                }
            }
            Option::None => {}
        }
        fmt::eprintf("warning: no user directory resolved; using C:/tmp/cryo-cache\n");
        return "C:/tmp/cryo-cache";
    }

    /// Unix per-user cache root: `$XDG_CACHE_HOME/cryo` (XDG Base Directory),
    /// then `$HOME/.cache/cryo`, then `/tmp/cryo-cache`.
    ![target(unix)]
    static default_cache_root() -> string {
        match (env::var(Str::new("XDG_CACHE_HOME"))) {
            Option::Some(v) => {
                mut s: String = v;
                if (s.length() > 0) { s.push(Str::new("/cryo")); return s.into_raw(); }
            }
            Option::None => {}
        }
        match (env::var(Str::new("HOME"))) {
            Option::Some(v) => {
                mut s: String = v;
                if (s.length() > 0) { s.push(Str::new("/.cache/cryo")); return s.into_raw(); }
            }
            Option::None => {}
        }
        fmt::eprintf("warning: $HOME and $XDG_CACHE_HOME unset; using /tmp/cryo-cache\n");
        return "/tmp/cryo-cache";
    }

    /// `<cache_root>/git/<sanitized>`: bare clone for a given remote URL.
    static git_dir_for(url: string) -> string {
        return format("%s/git/%s", Cache::cache_root(), Cache::sanitize_url(url));
    }

    /// `<cache_root>/checkouts/<sanitized>/<sha>`: working tree at a
    /// specific resolved commit.  Multiple SHAs from the same remote can
    /// coexist (e.g., when two projects pin different versions).
    static checkout_dir_for(url: string, sha: string) -> string {
        return format("%s/checkouts/%s/%s",
                      Cache::cache_root(), Cache::sanitize_url(url), sha);
    }


    // URL sanitization

    /// Normalize a remote URL into a filesystem-safe directory name.
    ///
    /// Examples:
    ///   https://github.com/foo/bar.git     ->  github.com_foo_bar
    ///   git@github.com:foo/bar.git         ->  github.com_foo_bar
    ///   ssh://git@github.com/foo/bar       ->  github.com_foo_bar
    ///
    /// Collisions between distinct URLs that normalize to the same name
    /// are theoretically possible but vanishingly unlikely for real-world
    /// remotes; we accept the risk for a much friendlier cache layout
    /// than a raw hash would give.
    static sanitize_url(url: string) -> string {
        mut s: string = url;

        // Strip recognized scheme prefixes.
        s = s.strip_prefix("https://");
        s = s.strip_prefix("http://");
        s = s.strip_prefix("ssh://");
        s = s.strip_prefix("git://");
        s = s.strip_prefix("git@");

        // Strip trailing ".git" if present.
        const slen: i64 = s.length() as i64;
        if (slen >= 4
                && s[slen-4] == '.' && s[slen-3] == 'g'
                && s[slen-2] == 'i' && s[slen-1] == 't') {
            s = s.substr(0, slen - 4);
        }

        // Replace path-unfriendly characters with '_'.
        const out_len: i64 = s.length() as i64;
        mut buf: i8* = libc::malloc(out_len as u64 + 1) as i8*;
        for (mut i: i64 = 0; i < out_len; i++) {
            const c: char = s[i];
            const safe: boolean =
                   (c >= 'a' && c <= 'z')
                || (c >= 'A' && c <= 'Z')
                || (c >= '0' && c <= '9')
                || c == '.' || c == '-' || c == '_';
            buf[i as u64] = if (safe) { c as i8 } else { '_' as i8 };
        }
        buf[out_len as u64] = 0;
        return buf as string;
    }
}
