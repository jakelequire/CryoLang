/// Dependencies Module
///
/// Everything behind `[dependencies]`: locating the global cache, driving
/// `git`, hashing a package's files, parsing semver constraints,
/// reading/writing the lockfile, and the top-level resolver that ties them
/// together for `cryo build/fetch/update`.

namespace compiler::deps;

module {
    Cache;
    Content;
    Git;
    GitUrl;
    Semver;
    Lockfile;
    DepResolver;
}
