/// Dependencies Module
///
/// Everything behind `[dependencies]`: locating the global cache, driving
/// `git`, parsing semver constraints, reading/writing the lockfile, and the
/// top-level resolver that ties them together for `cryo build/fetch/update`.

namespace Compiler::Deps;

public module Cache;
public module Git;
public module Semver;
public module Lockfile;
public module DepResolver;
