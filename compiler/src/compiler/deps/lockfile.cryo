///! Lockfile: `cryoconfig.lock`
///!
///! Pins each git dependency to the SHA that was resolved by the most
///! recent `cryo fetch` / `cryo update`.  Path deps are not pinned.
///!
///! Format (INI-ish, matching the cryoconfig parser):
///!
///!   version = 1
///!
///!   [[package]]
///!   name     = "cqlite"
///!   url      = "https://github.com/jakelequire/cqlite.git"
///!   ref_kind = "version"   # version | tag | branch | rev
///!   ref_val  = "0.1.0"
///!   sha      = "abcdef..."
///!
///! The `ref_kind`/`ref_val` round-trip preserves the user's intent;
///! a stale lockfile that mismatches the current cryoconfig is detected
///! by comparing those fields and triggers a re-resolve.

namespace Compiler::Deps::Lockfile;
import ffi::libc;

import Utils::Logger;
import std::fs::file;
import std::fs::path;
import std::fmt;
import std::collections::str;
import std::collections::string;


/// A single entry pinned in the lockfile.
type struct LockedDep {
    name:     string;
    url:      string;
    ref_kind: string;   // "version" | "tag" | "branch" | "rev"
    ref_val:  string;
    sha:      string;   // 40-char full SHA

    static empty() -> LockedDep {
        return LockedDep {
            name: "", url: "", ref_kind: "", ref_val: "", sha: "",
        };
    }
}

type struct Lockfile {
    /// Format version of the lockfile itself.  Bumped if we ever
    /// reshape the schema; older files would be regenerated.
    schema_version: i64;
    packages:       LockedDep[];

    static empty() -> Lockfile {
        return Lockfile { schema_version: 1, packages: [] };
    }

    /// Find the locked entry for `name`, or null if absent.
    find(&this, name: string) -> LockedDep* {
        for (mut i: int = 0; i < this.packages.length; i++) {
            if (libc::strcmp(this.packages[i].name, name) == 0) {
                return &this.packages[i];
            }
        }
        return null;
    }
}

const CURRENT_SCHEMA_VERSION: i64 = 1;


// Parsing

/// Read and parse `path`.  Missing file -> empty Lockfile (not an
/// error; it just means `cryo fetch` hasn't run yet).  Malformed
/// content prints a warning and is also treated as empty so the next
/// fetch can rebuild it.
function read(path: string) -> Lockfile {
    mut content: string = "";
    match (file::read_to_string(Path::from_cstr(path))) {
        Result::Ok(s)  => { content = s.into_raw(); }
        Result::Err(_) => { return Lockfile::empty(); }
    }

    mut lock:   Lockfile = Lockfile::empty();
    mut current_section: string = "";
    mut cur_idx: i64 = -1;

    mut pos: i64 = 0;
    const len: i64 = libc::strlen(content) as i64;

    while (pos < len) {
        const line_start: i64 = pos;
        while (pos < len && content[pos] != 10) { pos += 1; }
        const line: string = content.substr(line_start, pos - line_start);
        if (pos < len) { pos += 1; }

        const trimmed: string = line.trim();
        if (libc::strlen(trimmed) == 0) { continue; }
        if (trimmed[0] == '#') { continue; }

        if (trimmed[0] == '[') {
            const t_len: i64 = libc::strlen(trimmed) as i64;
            const is_array: boolean = t_len >= 4
                && trimmed[1] == '['
                && trimmed[t_len-1] == ']' && trimmed[t_len-2] == ']';
            if (is_array) {
                current_section = trimmed.substr(2, t_len - 4);
                if (libc::strcmp(current_section, "package") == 0) {
                    lock.packages.push(LockedDep::empty());
                    cur_idx = lock.packages.length as i64 - 1;
                } else {
                    cur_idx = -1;
                }
            } else {
                const close: i64 = trimmed.find_char(']' as i8);
                if (close > 1) {
                    current_section = trimmed.substr(1, close - 1);
                }
                cur_idx = -1;
            }
            continue;
        }

        const eq: i64 = trimmed.find_char('=' as i8);
        if (eq < 0) { continue; }
        const key_slice: string = trimmed.substr(0, eq);
        const key: string   = key_slice.trim();
        const val_slice: string = trimmed.substr(eq + 1, libc::strlen(trimmed) as i64 - eq - 1);
        const val_raw: string = val_slice.trim();
        const val: string   = val_raw.strip_quotes();

        if (libc::strcmp(current_section, "") == 0) {
            // Top-level keys.
            if (libc::strcmp(key, "version") == 0) {
                lock.schema_version = val.parse_int();
            }
        } else if (libc::strcmp(current_section, "package") == 0 && cur_idx >= 0) {
            match (key) {
                "name"     => { lock.packages[cur_idx].name     = val; }
                "url"      => { lock.packages[cur_idx].url      = val; }
                "ref_kind" => { lock.packages[cur_idx].ref_kind = val; }
                "ref_val"  => { lock.packages[cur_idx].ref_val  = val; }
                "sha"      => { lock.packages[cur_idx].sha      = val; }
                _          => { }
            }
        }
    }

    if (lock.schema_version != CURRENT_SCHEMA_VERSION) {
        fmt::eprintln(f"warning: {path} has schema_version={lock.schema_version}; expected {CURRENT_SCHEMA_VERSION}; regenerate via `cryo fetch`");
    }

    return lock;
}


// Writing

/// Write `lock` to `path`, overwriting any existing file.
/// Entries are emitted in insertion order so diffs stay readable.
function write(path: string, lock: Lockfile*) -> boolean {
    const f: void* = libc::fopen(path, "w");
    if (f == null) {
        fmt::eprintln(f"error: cannot open {path} for writing");
        return false;
    }

    libc::fputs("# Auto-generated by `cryo fetch`. Do not edit by hand.\n", f);
    libc::fputs("# Re-run `cryo fetch` after changing cryoconfig dependencies.\n", f);
    intrinsics::fprintf(f, "version = %lld\n\n", lock.schema_version);

    for (mut i: int = 0; i < lock.packages.length; i++) {
        const p: LockedDep = lock.packages[i];
        libc::fputs("[[package]]\n", f);
        intrinsics::fprintf(f, "name     = \"%s\"\n", p.name);
        intrinsics::fprintf(f, "url      = \"%s\"\n", p.url);
        intrinsics::fprintf(f, "ref_kind = \"%s\"\n", p.ref_kind);
        intrinsics::fprintf(f, "ref_val  = \"%s\"\n", p.ref_val);
        intrinsics::fprintf(f, "sha      = \"%s\"\n\n", p.sha);
    }

    libc::fclose(f);
    return true;
}


// Internal string helpers
