///! Lockfile: `cryoconfig.lock`
///!
///! A single per-project JSON document that pins build inputs which would
///! otherwise be resolved from mutable machine state:
///!
///!   - `packages` - each git dependency pinned to the commit resolved by the
///!     most recent `cryo fetch` / `cryo update`, with the content hash of the
///!     commit's files, which every build checks the cache against (path deps
///!     are not pinned).
///!   - `vendor` - each imported `vendor::<Name>` binding pinned by the CONTENT
///!     HASH of the generated `.cryo` it was built against, per target triple.
///!     This is a reproducibility *detector*: a normal build records/updates it,
///!     and `--locked` fails the build when the resolved bindings drift from it
///!     (e.g. a system header or libclang upgrade silently changed the API).
///!
///! Format (JSON, so it round-trips through `std::encoding::json` like the vendor
///! registry - no second config dialect):
///!
///!   { "schema_version": 3,
///!     "packages": [
///!       { "url": "https://github.com/.../cqlite.git",
///!         "version": "0.1.0", "ref_kind": "branch", "ref_val": "main",
///!         "commit": "abcdef...", "content": "sha256-0123..." } ],
///!     "vendor": [
///!       { "name": "RayLib", "triple": "x86_64-linux-gnu",
///!         "binding_sha": "f75c06ab..." } ] }
///!
///! A package is found by its repository's identity (`GitUrl::canonical`,
///! the same for every spelling of its URL) and the ref its cryoconfig
///! entry writes, never by the entry's table key, which is local to one
///! cryoconfig.  An entry whose ref no longer matches the cryoconfig is not
///! found, and the dep resolver resolves again.  A schema 2 file is read with its `sha` as
///! the commit and no content, which `cryo fetch` records; a malformed or
///! legacy (pre-JSON) file parses as empty and is regenerated by the next
///! `cryo fetch` / build.

namespace compiler::deps::lockfile;

import compiler::build_manifest::{ Manifest };
import std::fs::file::{ File };
import std::fs::file;
import std::fs::path::{ Path };
import std::fmt;
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::hash::{ Fnv128Hasher };
import std::core::mem;
import std::encoding::json;
import std::encoding::value::{ Object, Value };
import compiler::deps::git_url::{ GitUrl };


/// A single git dependency pinned in the lockfile.
type struct LockedDep with [Clone] {
    /// The URL as the cryoconfig wrote it.  Every spelling of one
    /// repository's URL finds the entry (`GitUrl::canonical`).
    url:      String;
    ref_kind: String;   // "tag" | "branch" | "rev", or "" for the default branch
    ref_val:  String;
    /// The commit the ref resolved to: 40 lower-case hex digits.
    commit:   String;
    /// `sha256-<hex>`, the commit's files as `PackageContent::of_directory`
    /// hashes them; empty when read from a schema 2 file, which recorded none.
    content:  String;
    /// The `[lib] version` of the commit's cryoconfig when it was fetched;
    /// empty in a file that recorded none.  A fetch keeps the pinned commit
    /// only while this meets the dependency's `version` requirement.
    version:  String;
}

/// A single vendored binding pinned by the content hash of its generated
/// `.cryo`, per target triple.  `binding_sha` is the OUTPUT identity (a hash of
/// the bytes the compiler actually consumes), not the provenance/input key - so
/// a cosmetic toolchain bump that produces byte-identical bindings does not read
/// as drift, while any real change to the bound API does.
type struct LockedVendor with [Clone] {
    name:        String;   // the import namespace, e.g. "RayLib"
    triple:      String;   // normalized target triple ("host" for a host build)
    binding_sha: String;   // hex FNV-1a of the generated bindings file

    /// Content hash of a generated bindings file, or empty when it can't be
    /// read.  Reuses the build manifest's FNV-1a folding so the whole
    /// compiler hashes one way (and this matches how `provenance_key` folds
    /// file bytes).
    static file_sha(path: Path) -> String {
        if (!path.exists()) { return String::new(); }
        mut h: Fnv128Hasher = Fnv128Hasher::new();
        Manifest::fold_file(&h, path.as_str());
        return String::from_string(Manifest::hex128(h.finish128()));
    }
}

type struct Lockfile {
    /// Format version of the lockfile itself: 3, packages found by URL and
    /// ref with their content hashes.  A schema 2 file (packages by table
    /// key, no content) is read and rewritten by `cryo fetch`; any other
    /// version is warned about, and `cryo fetch` regenerates it.
    schema_version: i64;
    packages:       [LockedDep];
    vendor:         [LockedVendor];

    static empty() -> Lockfile {
        return Lockfile { schema_version: CURRENT_SCHEMA_VERSION, packages: [], vendor: [] };
    }

    /// The locked package of the repository `url` names, however it is
    /// spelled, at the ref `ref_kind` / `ref_val`, or null if absent.
    find(&this, url: Str, ref_kind: Str, ref_val: Str) -> const LockedDep* {
        const identity: String = GitUrl::canonical(url);
        for (mut i: i64 = 0; i < this.packages.length(); i++) {
            if (GitUrl::canonical(this.packages[i].url.as_str()) == identity
                    && this.packages[i].ref_kind.as_str() == ref_kind
                    && this.packages[i].ref_val.as_str() == ref_val) {
                return &this.packages[i];
            }
        }
        return null;
    }

    /// Whether any locked package is of the repository `url` names, at
    /// whatever ref.
    pins_url(&this, url: Str) -> boolean {
        const identity: String = GitUrl::canonical(url);
        for (mut i: i64 = 0; i < this.packages.length(); i++) {
            if (GitUrl::canonical(this.packages[i].url.as_str()) == identity) { return true; }
        }
        return false;
    }


    /// Read a string field off a JSON object, or an empty one when it is
    /// absent or not a string.
    static jstr(parent: Value*, key: Str) -> String {
        match (parent.get(key)) {
            Option::Some(vp) => {
                match (vp.as::<Str>()) {
                    Option::Some(vs) => { return String::from_str(vs); }
                    Option::None => { return String::new(); }
                }
            }
            Option::None => { return String::new(); }
        }
    }

    /// Read and parse `path`.  A missing, malformed, or legacy (pre-JSON INI)
    /// file yields an empty Lockfile - never an error, since the next
    /// `cryo fetch` / build rebuilds it cleanly.
    static read(path: Path) -> Lockfile {
        const content: String = match (File::read_text(path)) {
            Result::Ok(text) => { text }
            Result::Err(_) => { return Lockfile::empty(); }
        };
        mut root: Value = match (json::Json::parse(content.as_str())) {
            Result::Ok(v)      => { v }
            Result::Err(e)     => { mem::drop(e); return Lockfile::empty(); }
        };

        mut lock: Lockfile = Lockfile::empty();
        match (root.get(Str::new("schema_version"))) {
            Option::Some(sv) => {
                match (sv.as::<i64>()) {
                    Option::Some(n) => { lock.schema_version = n; }
                    Option::None    => { }
                }
            }
            Option::None => { }
        }

        match (root.get(Str::new("packages"))) {
            Option::Some(pkgs) => {
                const n: i64 = pkgs.length();
                for (mut i: i64 = 0; i < n; i++) {
                    match (pkgs.at(i)) {
                        Option::Some(ep) => {
                            // Schema 2 called the commit `sha` and recorded
                            // no content.
                            const commit_key: Str = if (lock.schema_version == 2) { Str::new("sha") } else { Str::new("commit") };
                            lock.packages.push(LockedDep {
                                url:      Lockfile::jstr(ep, Str::new("url")),
                                ref_kind: Lockfile::jstr(ep, Str::new("ref_kind")),
                                ref_val:  Lockfile::jstr(ep, Str::new("ref_val")),
                                commit:   Lockfile::jstr(ep, commit_key),
                                content:  Lockfile::jstr(ep, Str::new("content")),
                                version:  Lockfile::jstr(ep, Str::new("version")),
                            });
                        }
                        Option::None => { }
                    }
                }
            }
            Option::None => { }
        }

        match (root.get(Str::new("vendor"))) {
            Option::Some(vens) => {
                const n: i64 = vens.length();
                for (mut i: i64 = 0; i < n; i++) {
                    match (vens.at(i)) {
                        Option::Some(ep) => {
                            lock.vendor.push(LockedVendor {
                                name:        Lockfile::jstr(ep, Str::new("name")),
                                triple:      Lockfile::jstr(ep, Str::new("triple")),
                                binding_sha: Lockfile::jstr(ep, Str::new("binding_sha")),
                            });
                        }
                        Option::None => { }
                    }
                }
            }
            Option::None => { }
        }

        mem::drop(root);
        // A schema 2 file is read as it is, to be rewritten by `cryo fetch`.
        if (lock.schema_version != CURRENT_SCHEMA_VERSION && lock.schema_version != 2) {
            fmt::eprintln(f"warning: {path.as_str()} has schema_version={lock.schema_version}; expected {CURRENT_SCHEMA_VERSION}; regenerate via `cryo fetch`");
        }
        return lock;
    }

    /// Write `lock` to `path`, overwriting any existing file.  Entries are
    /// emitted in insertion order so diffs stay readable.
    static write(path: Path, lock: &Lockfile) -> boolean {
        mut root: Object = Object::new();
        root.put("schema_version", Value::integer_value(CURRENT_SCHEMA_VERSION));

        mut pkgs: Array<Value> = Array::<Value>::new();
        for (mut i: i64 = 0; i < lock.packages.length(); i++) {
            mut o: Object = Object::new();
            o.put("url",      Value::from(lock.packages[i].url.as_str()));
            o.put("version",  Value::from(lock.packages[i].version.as_str()));
            o.put("ref_kind", Value::from(lock.packages[i].ref_kind.as_str()));
            o.put("ref_val",  Value::from(lock.packages[i].ref_val.as_str()));
            o.put("commit",   Value::from(lock.packages[i].commit.as_str()));
            o.put("content",  Value::from(lock.packages[i].content.as_str()));
            pkgs.push(Value::Object(o));
        }
        root.put("packages", Value::Array(pkgs));

        mut vens: Array<Value> = Array::<Value>::new();
        for (mut i: i64 = 0; i < lock.vendor.length(); i++) {
            mut o: Object = Object::new();
            o.put("name",        Value::from(lock.vendor[i].name.as_str()));
            o.put("triple",      Value::from(lock.vendor[i].triple.as_str()));
            o.put("binding_sha", Value::from(lock.vendor[i].binding_sha.as_str()));
            vens.push(Value::Object(o));
        }
        root.put("vendor", Value::Array(vens));

        mut doc: Value = Value::Object(root);
        mut text: String = json::Json::to_pretty_text(&doc);
        mem::drop(doc);

        text.push_byte(10 as u8);        // trailing newline (matches prior fputs)
        const ok: boolean = match (File::write_bytes(Path::from(path), text.as_bytes())) {
            Result::Ok(_)  => { true }
            Result::Err(_) => {
                fmt::eprintln(f"error: cannot open {path.as_str()} for writing");
                false
            }
        };
        mem::drop(text);
        return ok;
    }
}

const CURRENT_SCHEMA_VERSION: i64 = 3;
