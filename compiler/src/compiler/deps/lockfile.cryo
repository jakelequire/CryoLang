///! Lockfile: `cryoconfig.lock`
///!
///! A single per-project JSON document that pins build inputs which would
///! otherwise be resolved from mutable machine state:
///!
///!   - `packages` - each git dependency pinned to the SHA resolved by the most
///!     recent `cryo fetch` / `cryo update` (path deps are not pinned).
///!   - `vendor` - each imported `vendor::<Name>` binding pinned by the CONTENT
///!     HASH of the generated `.cryo` it was built against, per target triple.
///!     This is a reproducibility *detector*: a normal build records/updates it,
///!     and `--locked` fails the build when the resolved bindings drift from it
///!     (e.g. a system header or libclang upgrade silently changed the API).
///!
///! Format (JSON, so it round-trips through `std::json` like the vendor
///! registry - no second config dialect):
///!
///!   { "schema_version": 2,
///!     "packages": [
///!       { "name": "cqlite", "url": "https://github.com/.../cqlite.git",
///!         "ref_kind": "version", "ref_val": "0.1.0", "sha": "abcdef..." } ],
///!     "vendor": [
///!       { "name": "RayLib", "triple": "x86_64-linux-gnu",
///!         "binding_sha": "f75c06ab..." } ] }
///!
///! A stale `packages` entry (its `ref_kind`/`ref_val` no longer match the
///! cryoconfig) triggers a re-resolve in the dep resolver; a malformed or
///! legacy (pre-JSON) file parses as empty and is regenerated by the next
///! `cryo fetch` / build.

namespace Compiler::Deps::Lockfile;

import Utils::Logger;
import Compiler::BuildManifest;
import std::fs::file;
import std::fs::path;
import std::fs::metadata;
import std::fmt;
import std::collections::str;
import std::collections::string;
import std::core::option;
import std::core::hash;
import std::json::{ value, parser, serializer };


/// A single git dependency pinned in the lockfile.
type struct LockedDep {
    name:     string;
    url:      string;
    ref_kind: string;   // "version" | "tag" | "branch" | "rev"
    ref_val:  string;
    sha:      string;   // 40-char full SHA

    static empty() -> LockedDep {
        return LockedDep {
            name: "", url: "", ref_kind: "", ref_val: "", sha: "",
        };
    }
}

/// A single vendored binding pinned by the content hash of its generated
/// `.cryo`, per target triple.  `binding_sha` is the OUTPUT identity (a hash of
/// the bytes the compiler actually consumes), not the provenance/input key - so
/// a cosmetic toolchain bump that produces byte-identical bindings does not read
/// as drift, while any real change to the bound API does.
type struct LockedVendor {
    name:        string;   // the import namespace, e.g. "RayLib"
    triple:      string;   // normalized target triple ("host" for a host build)
    binding_sha: string;   // hex FNV-1a of the generated bindings file

    static empty() -> LockedVendor {
        return LockedVendor { name: "", triple: "", binding_sha: "" };
    }

    /// Content hash of a generated bindings file, or "" when it can't be read.
    /// Reuses the build manifest's FNV-1a folding so the whole compiler hashes
    /// one way (and this matches how `provenance_key` folds file bytes).
    static file_sha(path: string) -> string {
        if (!metadata::exists(Path::from(path))) { return ""; }
        mut h: DefaultHasher = DefaultHasher::new();
        Manifest::fold_file(&h, path);
        return h.finish().to_hex_padded_str(16);
    }
}

type struct Lockfile {
    /// Format version of the lockfile itself.  Bumped if we ever reshape the
    /// schema; older files fail to match and are regenerated.  1 -> 2: switched
    /// the on-disk format from INI to JSON and added the `vendor` section.
    schema_version: i64;
    packages:       LockedDep[];
    vendor:         LockedVendor[];

    static empty() -> Lockfile {
        return Lockfile { schema_version: CURRENT_SCHEMA_VERSION, packages: [], vendor: [] };
    }

    /// Find the locked package for `name`, or null if absent.
    find(&this, name: string) -> LockedDep* {
        for (mut i: int = 0; i < this.packages.length; i++) {
            if (this.packages[i].name.eq(name)) {
                return &this.packages[i];
            }
        }
        return null;
    }

    /// Find the locked vendor binding for (`name`, `triple`), or null if absent.
    find_vendor(&this, name: string, triple: string) -> LockedVendor* {
        for (mut i: int = 0; i < this.vendor.length; i++) {
            if (this.vendor[i].name.eq(name) && this.vendor[i].triple.eq(triple)) {
                return &this.vendor[i];
            }
        }
        return null;
    }

    /// Read a string field off a JSON object, or "" when absent/non-string.
    static jstr(parent: JsonValue*, key: string) -> string {
        match (parent.get(Str::from(key))) {
            Option::Some(vp) => {
                match (vp.as<Str>()) {
                    Option::Some(vs) => {
                        mut owned: String = String::from_str(vs);
                        return owned.into_raw();
                    }
                    Option::None => { return ""; }
                }
            }
            Option::None => { return ""; }
        }
    }

    /// Read and parse `path`.  A missing, malformed, or legacy (pre-JSON INI)
    /// file yields an empty Lockfile - never an error, since the next
    /// `cryo fetch` / build rebuilds it cleanly.
    static read(path: string) -> Lockfile {
        mut content: string = "";
        match (file::read_to_string(Path::from(path))) {
            Result::Ok(s)  => { content = s.into_raw(); }
            Result::Err(_) => { return Lockfile::empty(); }
        }
        mut root: JsonValue = match (parser::parse(Str::from(content))) {
            Result::Ok(v)      => { v }
            Result::Err(mut e) => { e.drop(); return Lockfile::empty(); }
        };

        mut lock: Lockfile = Lockfile::empty();
        match (root.get(Str::new("schema_version"))) {
            Option::Some(sv) => {
                match (sv.as<i64>()) {
                    Option::Some(n) => { lock.schema_version = n; }
                    Option::None    => { }
                }
            }
            Option::None => { }
        }

        match (root.get(Str::new("packages"))) {
            Option::Some(pkgs) => {
                const n: u64 = pkgs.length();
                for (mut i: u64 = 0; i < n; i++) {
                    match (pkgs.at(i)) {
                        Option::Some(ep) => {
                            lock.packages.push(LockedDep {
                                name:     Lockfile::jstr(ep, "name"),
                                url:      Lockfile::jstr(ep, "url"),
                                ref_kind: Lockfile::jstr(ep, "ref_kind"),
                                ref_val:  Lockfile::jstr(ep, "ref_val"),
                                sha:      Lockfile::jstr(ep, "sha"),
                            });
                        }
                        Option::None => { }
                    }
                }
            }
            Option::None => { }
        }

        match (root.get(Str::new("vendor"))) {
            Option::Some(vens) => {
                const n: u64 = vens.length();
                for (mut i: u64 = 0; i < n; i++) {
                    match (vens.at(i)) {
                        Option::Some(ep) => {
                            lock.vendor.push(LockedVendor {
                                name:        Lockfile::jstr(ep, "name"),
                                triple:      Lockfile::jstr(ep, "triple"),
                                binding_sha: Lockfile::jstr(ep, "binding_sha"),
                            });
                        }
                        Option::None => { }
                    }
                }
            }
            Option::None => { }
        }

        root.drop();
        if (lock.schema_version != CURRENT_SCHEMA_VERSION) {
            fmt::eprintln(f"warning: {path} has schema_version={lock.schema_version}; expected {CURRENT_SCHEMA_VERSION}; regenerate via `cryo fetch`");
        }
        return lock;
    }

    /// Write `lock` to `path`, overwriting any existing file.  Entries are
    /// emitted in insertion order so diffs stay readable.
    static write(path: string, lock: Lockfile*) -> boolean {
        mut root: JsonObject = JsonObject::new();
        root.put("schema_version", JsonValue::int_value(CURRENT_SCHEMA_VERSION));

        mut pkgs: Array<JsonValue> = Array<JsonValue>::new();
        for (mut i: i64 = 0; i < lock.packages.length; i++) {
            mut o: JsonObject = JsonObject::new();
            o.put("name",     JsonValue::from(lock.packages[i].name));
            o.put("url",      JsonValue::from(lock.packages[i].url));
            o.put("ref_kind", JsonValue::from(lock.packages[i].ref_kind));
            o.put("ref_val",  JsonValue::from(lock.packages[i].ref_val));
            o.put("sha",      JsonValue::from(lock.packages[i].sha));
            pkgs.push(JsonValue::Object(o));
        }
        root.put("packages", JsonValue::Array(pkgs));

        mut vens: Array<JsonValue> = Array<JsonValue>::new();
        for (mut i: i64 = 0; i < lock.vendor.length; i++) {
            mut o: JsonObject = JsonObject::new();
            o.put("name",        JsonValue::from(lock.vendor[i].name));
            o.put("triple",      JsonValue::from(lock.vendor[i].triple));
            o.put("binding_sha", JsonValue::from(lock.vendor[i].binding_sha));
            vens.push(JsonValue::Object(o));
        }
        root.put("vendor", JsonValue::Array(vens));

        mut doc: JsonValue = JsonValue::Object(root);
        mut text: String = serializer::stringify_pretty(&doc);
        doc.drop();

        text.push_byte(10 as u8);        // trailing newline (matches prior fputs)
        const ok: boolean = match (file::write(Path::from(path), text.as_bytes())) {
            Result::Ok(_)  => { true }
            Result::Err(_) => {
                fmt::eprintln(f"error: cannot open {path} for writing");
                false
            }
        };
        text.drop();
        return ok;
    }
}

const CURRENT_SCHEMA_VERSION: i64 = 2;
