///! Versions and version requirements.
///!
///! A library's version is the `version` key of its cryoconfig's `[lib]`
///! section: `MAJOR.MINOR.PATCH`, optionally followed by `-<pre-release>`
///! and `+<build>`, each a dot-separated run of letters, digits and `-`.
///! A consumer's `version = "..."` in `[dependencies]` is a requirement
///! that version must meet:
///!
///!   "1.2.3", "^1.2.3"  1.2.3 or later, below 2.0.0
///!   "0.2.3", "^0.2.3"  0.2.3 or later, below 0.3.0 (below 1.0.0, the
///!                      minor version is the one that breaks)
///!   "0.0.3"            0.0.3 only
///!   "1.2", "1"         1.2.0 or later below 2.0.0; 1.0.0 or later below 2.0.0
///!   "0.1"              0.1.0 or later, below 0.2.0
///!   "~1.2.3", "~1.2"   1.2.3 (or 1.2.0) or later, below 1.3.0
///!   "=1.2.3"           1.2.3 only
///!
///! A pre-release version (`1.0.0-rc.1`) meets only a requirement that names
///! a pre-release of the same `MAJOR.MINOR.PATCH`, and orders below the
///! release.

namespace compiler::deps::semver;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::slice::{ Slice };


/// A parsed version.  The build metadata after `+` is accepted and does not
/// take part in any comparison.
type struct Version with [Clone] {
    major: i64;
    minor: i64;
    patch: i64;
    /// The text after `-`, empty for a release.
    pre_release: String;

    /// Parse `source` as a library's version: `MAJOR.MINOR.PATCH`, then an
    /// optional `-<pre-release>` and `+<build>`.  `None` for anything else,
    /// a leading `v` and surrounding spaces included.
    static parse(source: Str) -> Option<Version> {
        const parts: (Option<Version>, i64) = Version::parse_components(source);
        if (parts.1 != 3) { return Option::None; }
        return parts.0.clone();
    }

    /// Parse one to three dot-separated components from the start of
    /// `source` and the pre-release and build after them; the version
    /// (missing components zero) and how many components were written.
    /// `None` when `source` is not that shape: no component, more than
    /// three, a component that is not a decimal number or has a leading
    /// zero, or a pre-release or build that is empty or holds anything but
    /// letters, digits, `-` and `.`.  A version writes all three; a
    /// requirement may write fewer.
    static parse_components(source: Str) -> (Option<Version>, i64) {
        const bytes: &Slice<u8> = source.as_bytes();
        const length: i64 = bytes.length();
        mut values: [i64; 3] = [0; 3];
        mut written: i64 = 0;
        mut i: i64 = 0;
        while (written < 3) {
            if (written > 0) {
                if (i >= length || bytes[i] != '.' as u8) { break; }
                i += 1;
            }
            const start: i64 = i;
            match (u64::parse_radix_prefix(bytes.subslice(i, length), 10)) {
                Option::Some(run) => { values[written] = run.0 as i64; i += run.1; }
                Option::None      => { return (Option::None, 0); }
            }
            // A number that does not fit stops before a digit; `01` is not
            // a version component.
            if (i < length && bytes[i].is_digit()) { return (Option::None, 0); }
            if (i - start > 1 && bytes[start] == '0' as u8) { return (Option::None, 0); }
            written += 1;
        }
        if (written == 0) { return (Option::None, 0); }
        mut pre_release: String = String::new();
        if (i < length && bytes[i] == '-' as u8) {
            const start: i64 = i + 1;
            i = Version::identifiers_end(bytes, start);
            if (i == start) { return (Option::None, 0); }
            pre_release = String::from_str(source.byte_substring(start, i));
        }
        if (i < length && bytes[i] == '+' as u8) {
            const start: i64 = i + 1;
            i = Version::identifiers_end(bytes, start);
            if (i == start) { return (Option::None, 0); }
        }
        if (i != length) { return (Option::None, 0); }
        return (Option::Some(Version {
            major: values[0], minor: values[1], patch: values[2], pre_release: pre_release,
        }), written);
    }

    /// Where the run of letters, digits, `-` and `.` starting at `start`
    /// in `bytes` ends.
    static identifiers_end(bytes: &Slice<u8>, start: i64) -> i64 {
        mut i: i64 = start;
        while (i < bytes.length()
                && (bytes[i].is_alpha() || bytes[i].is_digit() || bytes[i] == '-' as u8 || bytes[i] == '.' as u8)) {
            i += 1;
        }
        return i;
    }

    /// The version a git tag names: the tag with one leading `v` or `V`
    /// dropped, parsed as a version; `None` for a tag that names none
    /// (`stable`, `release-2`).
    static of_tag(tag: Str) -> Option<Version> {
        match (tag.strip_prefix("v")) {
            Option::Some(rest) => { return Version::parse(rest); }
            Option::None       => { }
        }
        match (tag.strip_prefix("V")) {
            Option::Some(rest) => { return Version::parse(rest); }
            Option::None       => { }
        }
        return Version::parse(tag);
    }

    /// The version `source`, which `parse` refuses, was most likely written
    /// for: the text with surrounding spaces and one leading `v` dropped and
    /// any missing minor or patch zero (`v0.1` -> `0.1.0`); `None` when that
    /// is not a version either.
    static nearest(source: Str) -> Option<Version> {
        const trimmed: Str = source.trim();
        const body: Str = match (trimmed.strip_prefix("v")) {
            Option::Some(rest) => { rest }
            Option::None       => { trimmed }
        };
        const parts: (Option<Version>, i64) = Version::parse_components(body);
        return parts.0.clone();
    }

    /// The version written out: `MAJOR.MINOR.PATCH`, then `-<pre-release>`
    /// when it has one.
    text(&this) -> String {
        mut written: String = f"{this.major}.{this.minor}.{this.patch}";
        if (this.pre_release.length() > 0) { written.append(f"-{this.pre_release}"); }
        return written;
    }

    /// Negative when this version orders below `other`, zero when they are
    /// the same version, positive when above.  A pre-release orders below its
    /// release; two pre-releases of one release order by their text.
    compare(&this, other: &Version) -> i64 {
        if (this.major != other.major) { return this.major - other.major; }
        if (this.minor != other.minor) { return this.minor - other.minor; }
        if (this.patch != other.patch) { return this.patch - other.patch; }
        const mine: boolean = this.pre_release.length() > 0;
        const theirs: boolean = other.pre_release.length() > 0;
        if (mine != theirs) { return if (mine) { -1 } else { 1 }; }
        if (this.pre_release.as_str() == other.pre_release.as_str()) { return 0; }
        return if (this.pre_release.as_str() < other.pre_release.as_str()) { -1 } else { 1 };
    }

    /// The series this version belongs to, written out: the versions that
    /// may replace it without breaking a program, which share its major
    /// (`2`), or below 1.0.0 its minor too (`0.2`).  A build holds one
    /// series of a library.
    series(&this) -> String {
        if (this.major > 0) { return f"{this.major}"; }
        return f"0.{this.minor}";
    }

    /// Whether `other` has the same major, minor and patch.
    same_release(&this, other: &Version) -> boolean {
        return this.major == other.major && this.minor == other.minor && this.patch == other.patch;
    }
}


/// How a requirement bounds the versions above its own.
type enum RequirementKind {
    /// No `^`, or `^`: up to the next version that may break.
    Compatible;
    /// `~`: up to the next minor version (the next major, when only the
    /// major is written).
    Close;
    /// `=`: the written components exactly.
    Exact;
}

/// A consumer's `version = "..."`: the versions of a library it accepts.
type struct Requirement {
    kind:    RequirementKind;
    /// The written version, missing components zero.
    lowest:  Version;
    /// How many of `MAJOR.MINOR.PATCH` were written: 1 to 3.
    written: i64;

    /// Parse a requirement; `None` when `source` is not one of the forms
    /// this module's header lists.
    static parse(source: Str) -> Option<Requirement> {
        mut kind: RequirementKind = RequirementKind::Compatible;
        mut body: Str = source;
        match (source.strip_prefix("^")) {
            Option::Some(rest) => { body = rest; }
            Option::None       => { }
        }
        match (source.strip_prefix("~")) {
            Option::Some(rest) => { kind = RequirementKind::Close; body = rest; }
            Option::None       => { }
        }
        match (source.strip_prefix("=")) {
            Option::Some(rest) => { kind = RequirementKind::Exact; body = rest; }
            Option::None       => { }
        }
        const parsed: (Option<Version>, i64) = Version::parse_components(body);
        match (parsed.0.clone()) {
            Option::Some(lowest) => {
                return Option::Some(Requirement { kind: kind, lowest: lowest, written: parsed.1 });
            }
            Option::None => { return Option::None; }
        }
    }

    /// The series (`Version::series`) every version this requirement
    /// accepts belongs to; `None` for `0` and `~0`, which accept every
    /// version below 1.0.0.
    series(&this) -> Option<String> {
        if (this.lowest.major == 0 && this.written == 1) { return Option::None; }
        return Option::Some(this.lowest.series());
    }

    /// Whether `version` meets this requirement.
    satisfied_by(&this, version: &Version) -> boolean {
        // A pre-release is chosen only by naming one of its release.
        if (version.pre_release.length() > 0
                && !(this.lowest.pre_release.length() > 0 && this.lowest.same_release(version))) {
            return false;
        }
        if (version.compare(&this.lowest) < 0) { return false; }
        // The first component that may differ: every one before it must
        // equal the requirement's.
        mut fixed: i64 = 0;
        match (this.kind) {
            RequirementKind::Exact => { fixed = this.written; }
            RequirementKind::Close => { fixed = if (this.written == 1) { 1 } else { 2 }; }
            RequirementKind::Compatible => {
                // Below 1.0.0 the first non-zero written component breaks;
                // with every written one zero, the last written one does.
                fixed = 1;
                if (this.lowest.major == 0) {
                    fixed = this.written;
                    if (this.written >= 2 && this.lowest.minor != 0) { fixed = 2; }
                }
            }
        }
        if (fixed >= 1 && version.major != this.lowest.major) { return false; }
        if (fixed >= 2 && version.minor != this.lowest.minor) { return false; }
        if (fixed >= 3 && version.patch != this.lowest.patch) { return false; }
        return true;
    }
}
