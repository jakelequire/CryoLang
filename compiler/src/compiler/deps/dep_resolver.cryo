///! Dependency Resolver
///!
///! Top-level orchestrator for `[dependencies]`.  Walks the dep
///! tree from a consumer's cryoconfig and either:
///!
///!   - Build mode:  reads `cryoconfig.lock`, extracts any missing
///!                  commit from its bare clone, and returns the source roots the
///!                  module loader should scan.  No network, no
///!                  lockfile writes; everything must already be
///!                  resolved.
///!
///!   - Fetch mode:  resolves git deps against their remotes,
///!                  re-using existing lockfile entries when their
///!                  ref-spec is unchanged, extracts each pinned
///!                  commit's files, and writes a fresh lockfile.
///!
///!   - Update mode: like Fetch but ignores existing lockfile entries
///!                  entirely; every git dep is re-resolved.
///!
///! Recursion: the resolver follows the `[dependencies]` of every
///! dep it visits.  Cycles are broken by tracking visited project
///! roots; a duplicate is a no-op rather than an error.
///!
///! A build holds one version of each library.  Every entry naming a
///! library makes a `LibraryRequest`; `choose` refuses requests for two
///! major versions and takes the newest version every requirement accepts,
///! and the graph is walked again until each library is built at its choice.

namespace compiler::deps::dep_resolver;

import std::fs::path::{ Path, PathBuf };
import std::collections::string::{ String };
import std::fmt;
import compiler::project_config::{ Dependency, DepKind, GitRefKind, ProjectConfig };
import compiler::deps::{ cache, git, semver, lockfile };
import std::collections::str;
import compiler::deps::cache::{ Cache };
import compiler::deps::content::{ PackageContent };
import compiler::deps::git::{ Git };
import compiler::deps::git_url::{ GitUrl };
import compiler::module_graph::{ PackageDeclaration };
import compiler::deps::lockfile::{ LockedDep, LockedVendor, Lockfile };
import compiler::deps::semver::{ Requirement, Version };
import compiler::utils::directory_lock::{ DirectoryLock };


/// What the resolver is asked to do.
type enum ResolveMode {
    /// Read-only against the lockfile.  Hard error if anything is
    /// missing or stale.
    Build;
    /// Resolve everything; reuse existing lockfile entries when the
    /// ref-spec is unchanged.  Writes a new lockfile.
    Fetch;
    /// Force re-resolution: ignore any existing lockfile entry.
    Update;
}


/// A single harvested dependency source root, tagged with the owning
/// dependency's name so the orchestrator can classify each loaded module's
/// origin and route its object/IR output into a `<depname>/` subtree.
type struct DepRoot {
    /// Path in the form the module loader expects: relative-to-consumer
    /// for path deps (the loader prefixes `project_root`), absolute for
    /// git deps.  This is what gets pushed into the loader's scan list.
    path:  string;
    /// The dependency's name (the `[dependencies]` table key) - used as
    /// the per-package output folder name.
    name:  string;
    /// The package's identity: its directory, canonicalized
    /// (`DepKey`), the same however a cryoconfig spells the path to it.
    package: String;
    /// Whether this root is the source directory of the package's `[lib]`,
    /// whose `lib.cryo` declares the library's namespace.
    library: boolean;
}

/// One `[dependencies]` entry that names a library, as the walk found it:
/// who writes it, what it accepts, and which version its own ref or path
/// names.  A build holds one version of each library, so the requests for
/// one library are settled together (`DepResolver::choose`).
type struct LibraryRequest with [Clone] {
    /// The library's identity: a git repository's `GitUrl::canonical` and
    /// subdir, or a path package's `DepKey`.
    library: String;
    /// The name its `[lib]` gives it.
    library_name: String;
    /// The entry's table key.
    name: String;
    /// Who writes the entry: `the program`, or a package's name and version.
    requester: String;
    /// Whether the program's own cryoconfig writes the entry.
    from_program: boolean;
    /// The cryoconfig that writes the entry.
    config: String;
    /// The entry's source, as a cryoconfig writes it: `git = "<url>"` and its
    /// ref, or `path = "<path>"`.
    source: String;
    /// Where the version was read: the URL and commit, or the directory.
    shown: String;
    /// The entry's `version` requirement; empty when it writes none.
    requirement: String;
    /// The `[lib] version` of what the entry's own ref or path names.
    version: String;
    /// The commit the entry's own ref names; empty for a path dependency.
    commit: String;
    /// The commit the walk built for it: the library's chosen one, once
    /// there is a choice, else its own.
    walked: String;

    /// The series of versions this request accepts: its requirement's, or
    /// when it writes none, the series of the version it names.  `None`
    /// when either accepts every version below 1.0.0 or says no version.
    series(&this) -> Option<String> {
        if (this.requirement.length() > 0) {
            match (Requirement::parse(this.requirement.as_str())) {
                Option::Some(requirement) => { return requirement.series(); }
                Option::None              => { return Option::None; }
            }
        }
        match (Version::parse(this.version.as_str())) {
            Option::Some(version) => { return Option::Some(version.series()); }
            Option::None          => { return Option::None; }
        }
    }

    /// The series of the version this request names, which a requirement
    /// accepting it and every later version that does not break it writes;
    /// the version as written when it does not parse.
    version_series(&this) -> String {
        match (Version::parse(this.version.as_str())) {
            Option::Some(parsed) => { return parsed.series(); }
            Option::None         => { return this.version.clone(); }
        }
    }

    /// The entry, as its cryoconfig would write it to take `source` with the
    /// requirement `requirement`.
    rewritten(&this, source: str::Str, requirement: str::Str) -> String {
        return f"{this.name} = {{ {source}, version = \"{requirement}\" }}";
    }
}

type struct ResolveOutcome {
    /// Source roots the module loader should add to its scan list, each
    /// tagged with its owning dependency name.  Always populated even when
    /// `failed` is true (so debug builds can see partial progress); the
    /// caller MUST check `failed` before proceeding.
    roots:  [DepRoot];
    /// Every `[dependencies]` entry of every cryoconfig walked, the
    /// program's included, once per (declarer, declared) pair, each
    /// package named by its `DepKey`.
    declarations: [PackageDeclaration];
    /// Every `[dependencies]` entry of every cryoconfig walked, in the
    /// order the walk reached them.
    requests: [LibraryRequest];
    /// True <=> at least one dep failed to resolve.
    failed: boolean;
    /// The lockfile produced by Fetch/Update.  In Build mode this is
    /// just the file we read in (returned for caller convenience).
    lock:   Lockfile;

    static empty() -> ResolveOutcome {
        return ResolveOutcome {
            roots:        [],
            declarations: [],
            requests:     [],
            failed:       false,
            lock:         Lockfile::empty(),
        };
    }

    /// Record that `declarer`'s cryoconfig names `declared`.
    declare(mut &this, declarer: str::Str, declared: str::Str) -> void {
        for (mut i: i64 = 0; i < this.declarations.length(); i++) {
            if (this.declarations[i].declarer.as_str() == declarer
                    && this.declarations[i].declared.as_str() == declared) { return; }
        }
        this.declarations.push(PackageDeclaration {
            declarer: String::from_str(declarer),
            declared: String::from_str(declared),
        });
    }
}


// Visited tracker (cycle detection)

/// A package's identity: its directory, canonicalized, so that every
/// spelling of the path to one package - `a`, `b/../a`, a checkout reached
/// by two cryoconfigs - names it once.  Two deps with the same key produce
/// the same source roots, so each is resolved only once even when the dep
/// graph has diamonds, and declarations name packages by it.
type struct DepKey with [Eq, Clone] {
    val: String;

    /// The key of the package in `directory`, which exists; `None` when
    /// the operating system cannot canonicalize it.
    static for_directory(directory: Path) -> Option<DepKey> {
        match (directory.canonicalize()) {
            Result::Ok(canonical) => { return Option::Some(DepKey { val: String::from_str(canonical.as_path().as_str()) }); }
            Result::Err(_)        => { return Option::None; }
        }
    }
}


/// Top-level orchestrator for `[dependencies]` resolution.  All entry
/// points are `static`; per-resolve state is threaded through explicit
/// parameters (`ResolveOutcome`, the visited set) rather than instance
/// fields.
type struct DepResolver {

    /// Resolve every `[dependencies]` entry reachable from `top_config`.
    ///
    /// `lock_path` is the path to `cryoconfig.lock` next to the consumer's
    /// cryoconfig.  In Build mode we read it; in Fetch/Update we (re)write
    /// it.
    static resolve(top_config: ProjectConfig*,
                     mode: ResolveMode,
                     lock_path: Path) -> ResolveOutcome {
        // Existing lockfile drives Build mode and seeds Fetch mode's
        // "reuse the entry if spec unchanged" optimization.  Update
        // ignores it entirely.
        mut existing: Lockfile = match (mode) {
            ResolveMode::Update => { Lockfile::empty() }
            _ => { Lockfile::read(lock_path) }
        };
        // Every git entry pinned by this run, so that walking the graph
        // again fetches and extracts nothing again.
        mut pinned: Lockfile = Lockfile::empty();
        // The request whose version each library is built at.
        mut chosen: [LibraryRequest] = [];
        mut outcome: ResolveOutcome = ResolveOutcome::empty();
        mut new_lock: Lockfile = Lockfile::empty();

        // A build holds one version of each library, and the version chosen
        // decides which dependencies that library brings in.  So the graph
        // is walked with the choices the walk before it made, until every
        // library is built at the version chosen for it.  Each choice is the
        // newest version some entry names, so a graph settles within as many
        // walks as there are entries pinned, and one that does not is
        // refused rather than walked for ever.
        mut walks: i64 = 0;
        while (true) {
            outcome = ResolveOutcome::empty();
            new_lock = Lockfile::empty();
            mut visited: [DepKey] = [];
            DepResolver::walk_deps(top_config, str::Str::from(""), Path::from(""), true, mode, &existing, &pinned, &chosen, &new_lock, &visited, &outcome);
            // The requests a failed walk did make are settled too, so every
            // refusal is reported at once.
            match (DepResolver::choose(&outcome.requests)) {
                Option::Some(choice) => { chosen = choice; }
                Option::None         => { outcome.failed = true; }
            }
            if (outcome.failed) { break; }
            const unsettled: Option<LibraryRequest> = DepResolver::built_elsewhere(&outcome.requests, &chosen);
            if (unsettled.is_none()) { break; }
            walks += 1;
            if (walks > pinned.packages.length() + 1) {
                const request: LibraryRequest = unsettled.unwrap();
                fmt::eprintln(f"error: the dependencies do not settle on one version of `{request.library_name}`: each version chosen for it brings in entries that choose another");
                fmt::eprintln(f"  help: name, in each cryoconfig that asks for `{request.library_name}`, a `branch`, `tag` or `rev` whose version meets every requirement on it");
                outcome.failed = true;
                break;
            }
        }
        if (!outcome.failed && mode != ResolveMode::Build) {
            DepResolver::report_unified(&outcome.requests, &chosen);
        }

        // Write the lockfile only on the success path of Fetch/Update.
        // A failed Fetch leaves the on-disk lock untouched so the user's
        // last good state is preserved.
        const should_write: boolean = !outcome.failed
            && (mode == ResolveMode::Fetch || mode == ResolveMode::Update);
        if (should_write) {
            // The lockfile has two independently-managed sections: `packages`
            // (this resolver) and `vendor` (the build's reproducibility pins).
            // We only rebuilt `packages`, so carry the on-disk `vendor` section
            // over verbatim instead of clobbering it with our empty one.
            const disk: Lockfile = Lockfile::read(lock_path);
            for (mut vi: i64 = 0; vi < disk.vendor.length(); vi++) {
                new_lock.vendor.push(disk.vendor[vi].clone());
            }
            Lockfile::write(lock_path, &new_lock);
        }

        // Each arm consumes BOTH lockfiles: one is moved into the outcome,
        // the other is moved into a throwaway local so scope-exit drop glue
        // reclaims it. Returning a match-expression that moved only one
        // binding per arm left the other moved on some paths but not others,
        // so its drop was suppressed on the path it survived - a leak (Build
        // leaked new_lock; Fetch/Update leaked existing). Lockfile has no
        // user `drop`, so we rely on glue via the discard binding.
        match (mode) {
            ResolveMode::Build => {
                mut _discard: Lockfile = new_lock;
                outcome.lock = existing;
            }
            _ => {
                mut _discard: Lockfile = existing;
                outcome.lock = new_lock;
            }
        }
        return outcome;
    }


    // Walk

    /// Recursive walk: for each dep in `cfg.dependencies`, resolve it and
    /// then descend into the dep's own `[dependencies]`.  `declarer` is the
    /// identity of the package `cfg` belongs to ("" for the program), and
    /// `base` its directory in the form the loader takes a root in: ""
    /// for the program, relative to the program's root below a path
    /// dependency, absolute below a git one.  A path dependency's `path`
    /// is relative to the cryoconfig that writes it, so it is joined onto
    /// that package's `base`.  `on_this_machine` says where `cfg`'s package
    /// came from: the program, and every package reached from it through
    /// path dependencies and `file://` repositories alone, is on this
    /// machine; a package fetched from a remote, and everything below it,
    /// is not, and may not name a `file://` repository.
    ///
    /// Cycle detection keys deps by their directory; see `DepKey`.
    ///
    /// `pinned` holds every git entry this run has pinned, and `chosen` the
    /// request each library's version is taken from, empty on the first
    /// walk (see `resolve`).
    static walk_deps(cfg: const ProjectConfig*,
                       declarer: str::Str,
                       base: Path,
                       on_this_machine: boolean,
                       mode: ResolveMode,
                       existing: Lockfile*,
                       pinned: mut Lockfile*,
                       chosen: &[LibraryRequest],
                       new_lock: mut Lockfile*,
                       visited: mut [DepKey]*,
                       outcome: mut ResolveOutcome*) -> void {
        for (mut i: i64 = 0; i < cfg.dependencies.length(); i++) {
            const dep: const Dependency* = &cfg.dependencies[i];

            match (dep.kind) {
                DepKind::Invalid => {
                    // Parser already emitted a diagnostic.  Mark failure
                    // and skip; there's no recoverable path for an
                    // invalid dep schema.
                    outcome.failed = true;
                }
                DepKind::Path => {
                    DepResolver::resolve_path_dep(cfg, declarer, base, on_this_machine, dep, mode, existing, pinned, chosen, new_lock, visited, outcome);
                }
                DepKind::Git => {
                    DepResolver::resolve_git_dep(cfg, declarer, base, on_this_machine, dep, mode, existing, pinned, chosen, new_lock, visited, outcome);
                }
            }
        }
    }

    /// The request `dep`, an entry of `cfg`, makes of the library
    /// `library`, whose cryoconfig is `dep_cfg` and whose own ref names
    /// `commit` (empty for a path dependency).  `declarer` and `base` are
    /// `cfg`'s package, as `walk_deps` takes them.
    static request_of(cfg: const ProjectConfig*, declarer: str::Str, base: Path, dep: const Dependency*,
                      library: String, dep_cfg: const ProjectConfig*, shown: String, commit: String) -> LibraryRequest {
        const requester: String = if (declarer.length() == 0) { String::from_str(str::Str::new("the program")) }
            else { f"`{str::Str::from(cfg.lib.name)}` {str::Str::from(cfg.lib.version)}" };
        const config: String = if (base.is_empty()) { String::from_str(str::Str::new("cryoconfig")) }
            else { String::from_str(base.join("cryoconfig").as_path().as_str()) };
        mut source: String = if (commit.length() > 0) { f"git = \"{dep.git_url}\"" } else { f"path = \"{dep.path}\"" };
        const ref_key: str::Str = GitRefKind::key_name(dep.ref_kind);
        if (ref_key.length() > 0) { source.append(f", {ref_key} = \"{dep.ref_val}\""); }
        return LibraryRequest {
            library:      library,
            library_name: String::from_str(str::Str::from(dep_cfg.lib.name)),
            name:         dep.name.clone(),
            requester:    requester,
            from_program: declarer.length() == 0,
            config:      config,
            source:       source,
            shown:        shown,
            requirement:  dep.version_requirement.clone(),
            version:      String::from_str(str::Str::from(dep_cfg.lib.version)),
            commit:       commit.clone(),
            walked:       commit,
        };
    }

    /// Path dep: resolved by joining the consumer's project root with
    /// the relative path.  We then read the dep's own cryoconfig and
    /// recurse, harvesting its source roots into `outcome.roots`.
    static resolve_path_dep(cfg: const ProjectConfig*,
                              declarer: str::Str,
                              base: Path,
                              on_this_machine: boolean,
                              dep: const Dependency*,
                              mode: ResolveMode,
                              existing: Lockfile*,
                              pinned: mut Lockfile*,
                              chosen: &[LibraryRequest],
                              new_lock: mut Lockfile*,
                              visited: mut [DepKey]*,
                              outcome: mut ResolveOutcome*) -> void {
        const dep_root: PathBuf = if (cfg.project_root.eq(".")) { PathBuf::from(dep.path.as_str()) }
            else { Path::from(cfg.project_root).join(dep.path.as_str()) };
        const dep_config: PathBuf = dep_root.join("cryoconfig");
        if (!dep_root.as_path().exists()) {
            fmt::eprintln(f"error: path dependency '{dep.name}' names {dep_root.as_path().as_str()}, which does not exist");
            outcome.failed = true;
            return;
        }
        if (!dep_config.as_path().exists()) {
            fmt::eprintln(f"error: path dependency '{dep.name}' has no cryoconfig at {dep_root.as_path().as_str()}");
            fmt::eprintln("  help: a dependency is a Cryo project; its directory holds a cryoconfig with a [lib] section");
            outcome.failed = true;
            return;
        }

        const found: Option<DepKey> = DepResolver::key_declared_by(declarer, dep, dep_root.as_path(), outcome);
        if (found.is_none()) { return; }
        const key: DepKey = found.unwrap();

        // Every entry naming the package makes its request, whichever
        // reaches it first.
        const dep_cfg: ProjectConfig = ProjectConfig::parse(dep_config.into_raw());
        if (dep_cfg.error_count > 0) {
            fmt::eprintln(f"error: dependency '{dep.name}' has invalid cryoconfig at {dep_root.as_path().as_str()}");
            outcome.failed = true;
            return;
        }
        if (DepResolver::library_version(dep, &dep_cfg, dep_root.as_path(), String::new()).is_none()) {
            outcome.failed = true;
            return;
        }
        outcome.requests.push(DepResolver::request_of(cfg, declarer, base, dep, key.val.clone(), &dep_cfg,
            String::from_str(dep_root.as_path().as_str()), String::new()));
        if (visited.contains(&key)) { return; }
        visited.push(key.clone());
        // The loader prefixes a relative root with the program's project
        // root itself, so a path dependency's roots are handed over relative
        // to it (or absolute, below a git dependency).
        const package_base: PathBuf = if (base.is_empty()) { PathBuf::from(dep.path.as_str()) }
            else { base.join(dep.path.as_str()) };
        DepResolver::harvest_roots(&dep_cfg, package_base.as_path(), dep.name.as_str(), key.val.as_str(), outcome);
        DepResolver::walk_deps(&dep_cfg, key.val.as_str(), package_base.as_path(), on_this_machine, mode, existing, pinned, chosen, new_lock, visited, outcome);
    }

    /// The identity of the package `dep` names, in `directory`, recorded as
    /// declared by `declarer`; `None`, with the build failed, when the
    /// directory cannot be canonicalized.
    static key_declared_by(declarer: str::Str, dep: const Dependency*, directory: Path,
                           outcome: mut ResolveOutcome*) -> Option<DepKey> {
        match (DepKey::for_directory(directory)) {
            Option::Some(key) => {
                outcome.declare(declarer, key.val.as_str());
                return Option::Some(key);
            }
            Option::None => {
                fmt::eprintln(f"error: dependency '{dep.name}': cannot resolve the directory {directory.as_str()}");
                outcome.failed = true;
                return Option::None;
            }
        }
    }

    /// Git dep: the source-of-truth for what's on disk is the lockfile.
    /// In Build mode we trust the lockfile completely; in Fetch/Update we
    /// (re)resolve the ref to a SHA, extract the commit's files, and write
    /// a fresh lockfile entry.
    /// The walk enters the commit chosen for the library (`resolve`), which
    /// is the entry's own until another entry names a newer version.
    static resolve_git_dep(cfg: const ProjectConfig*,
                             declarer: str::Str,
                             base: Path,
                             on_this_machine: boolean,
                             dep: const Dependency*,
                             mode: ResolveMode,
                             existing: Lockfile*,
                             pinned: mut Lockfile*,
                             chosen: &[LibraryRequest],
                             new_lock: mut Lockfile*,
                             visited: mut [DepKey]*,
                             outcome: mut ResolveOutcome*) -> void {
        const local_repository: boolean = match (GitUrl::package_on_this_machine(on_this_machine, dep.git_url.as_str())) {
            Option::Some(local) => { local }
            Option::None => {
                fmt::eprintln(f"error: dependency '{dep.name}' names a repository on this machine ({dep.git_url}), from a package fetched from a remote");
                fmt::eprintln("  help: only the program, and packages on this machine, may name a `file://` repository");
                outcome.failed = true;
                return;
            }
        };

        const url: str::Str = dep.git_url.as_str();
        const ref_kind: str::Str = GitRefKind::key_name(dep.ref_kind);
        // An entry this run has pinned already is not fetched, extracted or
        // checked again.
        const earlier: const LockedDep* = pinned.find(url, ref_kind, dep.ref_val.as_str());
        mut found_entry: Option<LockedDep> = Option::None;
        if (earlier != null) {
            found_entry = Option::Some(earlier.clone());
        } else {
            // Builds and tests running at once share the cache, so its
            // entries for one repository are read and made under that
            // repository's lock.
            mut lock: DirectoryLock = Cache::repository_lock(url);
            match (lock.take()) {
                Result::Ok(_)    => { }
                Result::Err(why) => {
                    fmt::eprintln(f"error: dependency '{dep.name}': {why}");
                    outcome.failed = true;
                    return;
                }
            }
            found_entry = DepResolver::cached_commit(dep, mode, existing);
            lock.release();
        }
        mut entry: LockedDep = match (found_entry) {
            Option::Some(found) => { found }
            Option::None        => { outcome.failed = true; return; }
        };
        const sha: String = entry.commit.clone();

        // Every entry naming the repository is checked and makes its
        // request, whichever reaches its package first.
        const dep_root: PathBuf = DepResolver::package_directory(dep, sha.as_str());
        const own: Option<ProjectConfig> = DepResolver::package_config(dep, dep_root.as_path());
        if (own.is_none()) { outcome.failed = true; return; }
        const dep_cfg: ProjectConfig = own.unwrap();
        match (DepResolver::library_version(dep, &dep_cfg, dep_root.as_path(), sha.clone())) {
            Option::Some(version) => { entry.version = version; }
            Option::None          => { outcome.failed = true; return; }
        }
        if (earlier == null) {
            if (mode != ResolveMode::Build) {
                const selected: String = if (ref_kind.length() > 0) { f"{ref_kind} {dep.ref_val}" } else { String::from_str(str::Str::new("default branch")) };
                fmt::println(f"[deps] {dep.name} {entry.version} from {dep.git_url} ({selected}, commit {sha.as_str().byte_substring(0, 12)})");
            }
            pinned.packages.push(entry.clone());
        }
        if (mode != ResolveMode::Build && new_lock.find(url, ref_kind, dep.ref_val.as_str()) == null) {
            new_lock.packages.push(entry);
        }

        // One repository's subdirectories are libraries of their own.
        mut library: String = GitUrl::canonical(url);
        if (dep.subdir.length() > 0) { library.append(f"//{dep.subdir}"); }
        mut request: LibraryRequest = DepResolver::request_of(cfg, declarer, base, dep, library, &dep_cfg,
            f"{dep.git_url} at commit {sha.as_str().byte_substring(0, 12)}", sha.clone());
        for (mut i: i64 = 0; i < chosen.length(); i++) {
            if (chosen[i].library == request.library) { request.walked = chosen[i].commit.clone(); }
        }
        const walked: String = request.walked.clone();
        outcome.requests.push(request);
        if (walked == sha) {
            DepResolver::enter_git_package(declarer, local_repository, dep, dep_root.as_path(), &dep_cfg, mode, existing, pinned, chosen, new_lock, visited, outcome);
            return;
        }
        const walked_root: PathBuf = DepResolver::package_directory(dep, walked.as_str());
        match (DepResolver::package_config(dep, walked_root.as_path())) {
            Option::Some(walked_cfg) => {
                DepResolver::enter_git_package(declarer, local_repository, dep, walked_root.as_path(), &walked_cfg, mode, existing, pinned, chosen, new_lock, visited, outcome);
            }
            Option::None => { outcome.failed = true; }
        }
    }

    /// The directory of the package git dependency `dep` names at `commit`:
    /// the commit's extraction in the cache, and the entry's `subdir` below.
    static package_directory(dep: const Dependency*, commit: str::Str) -> PathBuf {
        const checkout: PathBuf = Cache::extraction_dir_for(dep.git_url.as_str(), commit);
        if (dep.subdir.length() > 0) { return checkout.join(dep.subdir.as_str()); }
        return checkout;
    }

    /// The cryoconfig of the package `dep` names, in `directory`; `None`
    /// once the failure is reported, when it has none or it is malformed.
    static package_config(dep: const Dependency*, directory: Path) -> Option<ProjectConfig> {
        const config_path: PathBuf = directory.join("cryoconfig");
        if (!config_path.as_path().exists()) {
            fmt::eprintln(f"error: dependency '{dep.name}' has no cryoconfig at {directory.as_str()}");
            return Option::None;
        }
        const parsed: ProjectConfig = ProjectConfig::parse(config_path.into_raw());
        if (parsed.error_count > 0) {
            fmt::eprintln(f"error: dependency '{dep.name}' has invalid cryoconfig at {directory.as_str()}");
            return Option::None;
        }
        return Option::Some(parsed);
    }

    /// Walk into the package git dependency `dep` is built from, in
    /// `directory` with the cryoconfig `dep_cfg`: once per directory, which
    /// is one commit of one repository, its roots harvested by their
    /// absolute paths, since the consumer's root says nothing about where
    /// the cache is.
    static enter_git_package(declarer: str::Str,
                             local_repository: boolean,
                             dep: const Dependency*,
                             directory: Path,
                             dep_cfg: const ProjectConfig*,
                             mode: ResolveMode,
                             existing: Lockfile*,
                             pinned: mut Lockfile*,
                             chosen: &[LibraryRequest],
                             new_lock: mut Lockfile*,
                             visited: mut [DepKey]*,
                             outcome: mut ResolveOutcome*) -> void {
        const found: Option<DepKey> = DepResolver::key_declared_by(declarer, dep, directory, outcome);
        if (found.is_none()) { return; }
        const key: DepKey = found.unwrap();
        if (visited.contains(&key)) { return; }
        visited.push(key.clone());
        DepResolver::harvest_roots(dep_cfg, directory, dep.name.as_str(), key.val.as_str(), outcome);
        DepResolver::walk_deps(dep_cfg, key.val.as_str(), directory, local_repository, mode, existing, pinned, chosen, new_lock, visited, outcome);
    }

    /// The lock entry of git dependency `dep`, whose commit's files are
    /// extracted in the cache, its repository's lock held.  A build takes it
    /// from the lock file, re-extracts it from the bare clone when its files
    /// are missing, and checks them against the recorded content hash.  A
    /// fetch keeps the locked commit while the entry's ref is unchanged and
    /// its recorded version meets the `version` requirement; an update, or a
    /// fetch that cannot keep it, resolves the ref again.  Either extracts
    /// what no longer matches and answers a new entry, whose `version` the
    /// caller fills in from the commit's cryoconfig.  `None` once the
    /// failure is reported.
    static cached_commit(dep: const Dependency*, mode: ResolveMode, existing: Lockfile*) -> Option<LockedDep> {
        mut sha: String = String::new();
        const url: str::Str = dep.git_url.as_str();
        const ref_kind: str::Str = GitRefKind::key_name(dep.ref_kind);
        match (mode) {
            ResolveMode::Build => {
                const locked: const LockedDep* = existing.find(url, ref_kind, dep.ref_val.as_str());
                if (locked == null) {
                    if (existing.pins_url(url)) {
                        fmt::eprintln(f"error: lockfile entry for '{dep.name}' is stale (cryoconfig changed); run `cryo fetch`");
                    } else {
                        fmt::eprintln(f"error: dependency '{dep.name}' is not pinned; run `cryo fetch`");
                    }
                    return Option::None;
                }
                sha = locked.commit.clone();
                if (!GitUrl::is_commit_id(sha.as_str())) {
                    fmt::eprintln(f"error: lockfile entry for '{dep.name}' holds `{sha}`, which is not a commit id; run `cryo fetch`");
                    return Option::None;
                }
                if (locked.content.length() == 0) {
                    fmt::eprintln(f"error: lockfile entry for '{dep.name}' records no content hash; run `cryo fetch`");
                    return Option::None;
                }
                // A missing extraction is made again from the bare clone,
                // which is local: a build starts no network fetch.
                if (!Git::extract(dep.name.as_str(), url, sha.as_str(), false)) {
                    return Option::None;
                }
                // The files are checked on every build, so a cached file
                // edited by hand, or made by another tool, is never compiled.
                const extraction: PathBuf = Cache::extraction_dir_for(url, sha.as_str());
                match (PackageContent::of_directory(extraction.as_path())) {
                    Result::Ok(found) => {
                        if (found != locked.content) {
                            fmt::eprintln(f"error: the files of dependency '{dep.name}' in the cache are not those of commit {sha}, which cryoconfig.lock pins");
                            fmt::eprintln(f"  note: {extraction.as_path().as_str()} hashes to {found}; the lock records {locked.content}");
                            fmt::eprintln("  help: run `cryo fetch`, which extracts the commit's files again");
                            return Option::None;
                        }
                    }
                    Result::Err(why) => {
                        fmt::eprintln(f"error: cannot check the files of dependency '{dep.name}' in the cache: {why}");
                        fmt::eprintln("  help: run `cryo fetch`, which extracts the commit's files again");
                        return Option::None;
                    }
                }
                return Option::Some(locked.clone());
            }
            _ => {
                // Fetch/Update: reuse the locked commit if (Fetch only) the
                // dep's ref is unchanged and its version is still accepted;
                // otherwise resolve again.
                mut reused: boolean = false;
                mut recorded: String = String::new();
                if (mode == ResolveMode::Fetch) {
                    const locked: const LockedDep* = existing.find(url, ref_kind, dep.ref_val.as_str());
                    if (locked != null && GitUrl::is_commit_id(locked.commit.as_str())
                            && DepResolver::accepts(dep.version_requirement.as_str(), locked.version.as_str())) {
                        sha      = locked.commit.clone();
                        recorded = locked.content.clone();
                        reused   = true;
                    }
                }
                // An extraction whose files still hash to what the lock
                // records is kept.  Any other is made again from the bare
                // clone, so the content a lock records always comes from git
                // and never from a cache that was changed.  A reused pin
                // needs the bare clone then too (a committed lock on a fresh
                // cache), but not its remote refs refreshed.
                const kept: boolean = reused && recorded.length() > 0 && Git::is_extracted(url, sha.as_str())
                    && PackageContent::of_directory(Cache::extraction_dir_for(url, sha.as_str()).as_path()).unwrap_or(String::new()) == recorded;
                if (!kept && !Git::ensure_bare_clone(url, !reused)) {
                    return Option::None;
                }
                if (!reused) {
                    sha = Git::resolve_ref_to_sha(url, dep.ref_kind, dep.ref_val.as_str());
                    if (sha.length() == 0) {
                        return Option::None;
                    }
                }
                if (!kept && !Git::extract(dep.name.as_str(), url, sha.as_str(), true)) {
                    return Option::None;
                }
                const content: String = match (PackageContent::of_directory(Cache::extraction_dir_for(url, sha.as_str()).as_path())) {
                    Result::Ok(found) => { found }
                    Result::Err(why)  => {
                        fmt::eprintln(f"error: cannot hash the files of dependency '{dep.name}': {why}");
                        return Option::None;
                    }
                };
                return Option::Some(LockedDep {
                    url:      dep.git_url.clone(),
                    ref_kind: String::from_str(ref_kind),
                    ref_val:  dep.ref_val.clone(),
                    commit:   sha,
                    content:  content,
                    version:  String::new(),
                });
            }
        }
    }

    /// Whether `version`, a library's `[lib] version` as written, meets
    /// `requirement`, a `version` requirement as written; true when it is
    /// empty, and false for an empty or malformed version when it is not.
    static accepts(requirement: str::Str, version: str::Str) -> boolean {
        if (requirement.length() == 0) { return true; }
        match (Requirement::parse(requirement)) {
            Option::Some(parsed_requirement) => {
                match (Version::parse(version)) {
                    Option::Some(parsed) => { return parsed_requirement.satisfied_by(&parsed); }
                    Option::None         => { return false; }
                }
            }
            Option::None => { return false; }
        }
    }

    /// The version of the library `dep` names, whose cryoconfig is
    /// `dep_cfg` in `directory`; `None` once the failure is reported.  A
    /// dependency is a library: its cryoconfig has a `[lib]`.  A git
    /// dependency's library says its version, and so does a path
    /// dependency's when `dep` writes a `version` requirement (which
    /// `choose` holds it to, with every other request for the library).  A
    /// git dependency pinned by a tag that names a version, `v0.2.0`, must
    /// find that version in the tagged commit's cryoconfig.  `commit` is the
    /// git dependency's commit, and empty for a path dependency.
    static library_version(dep: const Dependency*, dep_cfg: const ProjectConfig*, directory: Path,
                           commit: String) -> Option<String> {
        const config_path: PathBuf = directory.join("cryoconfig");
        const shown: String = if (commit.length() > 0) { f"{dep.git_url} at commit {commit.as_str().byte_substring(0, 12)}" }
            else { String::from_str(directory.as_str()) };
        if (!dep_cfg.lib.is_present()) {
            fmt::eprintln(f"error: dependency '{dep.name}' is not a library: {config_path.as_path().as_str()} has no [lib] section");
            fmt::eprintln(f"  help: a library's cryoconfig names it, its sources and its version:");
            fmt::eprintln(f"        [lib]");
            fmt::eprintln(f"        name = \"{dep.name}\"");
            fmt::eprintln(f"        source_dir = \"src\"");
            fmt::eprintln(f"        version = \"0.1.0\"");
            return Option::None;
        }
        const version: String = String::from_str(str::Str::from(dep_cfg.lib.version));
        if (version.length() == 0) {
            if (commit.length() == 0 && dep.version_requirement.length() == 0) { return Option::Some(version); }
            fmt::eprintln(f"error: dependency '{dep.name}' ({shown}) does not say its version");
            if (commit.length() > 0) {
                fmt::eprintln("  help: the library's cryoconfig says it under [lib]: `version = \"0.1.0\"`; commit that to the repository, then run `cryo update`");
            } else {
                fmt::eprintln(f"  help: the library's cryoconfig says it under [lib]: add `version = \"0.1.0\"` to {config_path.as_path().as_str()}");
            }
            return Option::None;
        }
        match (dep.ref_kind) {
            GitRefKind::Tag => {
                match (Version::of_tag(dep.ref_val.as_str())) {
                    Option::Some(tagged) => {
                        const said: Option<Version> = Version::parse(version.as_str());
                        if (said.is_none() || said.unwrap().compare(&tagged) != 0) {
                            fmt::eprintln(f"error: dependency '{dep.name}' names the tag `{dep.ref_val}`, and the library's cryoconfig at that tag says version {version}");
                            fmt::eprintln(f"  help: a tag that names a version must agree with `[lib] version`; to take this commit anyway, write `rev = \"{commit}\"` in place of `tag = \"{dep.ref_val}\"`");
                            return Option::None;
                        }
                    }
                    Option::None => { }
                }
            }
            _ => { }
        }
        return Option::Some(version);
    }


    // One version of each library

    /// The request each library is built at, one per library, in the order
    /// the walk first reached it; `None` once every failure is reported.
    static choose(requests: &[LibraryRequest]) -> Option<[LibraryRequest]> {
        mut choice: [LibraryRequest] = [];
        mut failed: boolean = false;
        for (mut i: i64 = 0; i < requests.length(); i++) {
            mut reached_before: boolean = false;
            for (mut j: i64 = 0; j < i; j++) {
                if (requests[j].library == requests[i].library) { reached_before = true; }
            }
            if (reached_before) { continue; }
            mut group: [LibraryRequest] = [];
            for (mut j: i64 = i; j < requests.length(); j++) {
                if (requests[j].library == requests[i].library) { group.push(requests[j].clone()); }
            }
            match (DepResolver::choose_version(&group)) {
                Option::Some(chosen) => { choice.push(chosen); }
                Option::None         => { failed = true; }
            }
        }
        if (failed) { return Option::None; }
        return Option::Some(choice);
    }

    /// The request one library is built at, of `group`, every request for
    /// it; `None` once the failure is reported.  A build holds one series of
    /// a library (`Version::series`), so requests that ask for two are
    /// refused, naming who asks for which.  Each request's own version must
    /// meet its own requirement.  Of the versions the requests name, the
    /// newest that every requirement accepts is chosen: the first request
    /// naming it, when two commits say one version.
    static choose_version(group: &[LibraryRequest]) -> Option<LibraryRequest> {
        // The newest version a request names, which a refusal's help moves
        // the others to.
        mut newest: i64 = 0;
        for (mut k: i64 = 1; k < group.length(); k++) {
            if (DepResolver::version_order(group[k].version.as_str(), group[newest].version.as_str()) > 0) { newest = k; }
        }
        mut series: String = String::new();
        for (mut k: i64 = 0; k < group.length(); k++) {
            const asked: String = group[k].series().unwrap_or(String::new());
            if (asked.length() == 0) { continue; }
            if (series.length() == 0) {
                series = asked;
            } else if (series != asked) {
                DepResolver::report_two_series(group, newest);
                return Option::None;
            }
        }
        mut refused: boolean = false;
        for (mut k: i64 = 0; k < group.length(); k++) {
            if (!DepResolver::accepts(group[k].requirement.as_str(), group[k].version.as_str())) {
                DepResolver::report_unaccepted(&group[k]);
                refused = true;
            }
        }
        if (refused) { return Option::None; }
        mut best: i64 = -1;
        for (mut k: i64 = 0; k < group.length(); k++) {
            mut accepted_by_all: boolean = true;
            for (mut r: i64 = 0; r < group.length(); r++) {
                if (!DepResolver::accepts(group[r].requirement.as_str(), group[k].version.as_str())) { accepted_by_all = false; }
            }
            if (accepted_by_all
                    && (best < 0 || DepResolver::version_order(group[k].version.as_str(), group[best].version.as_str()) > 0)) {
                best = k;
            }
        }
        if (best < 0) {
            DepResolver::report_no_common_version(group, newest);
            return Option::None;
        }
        return Option::Some(group[best].clone());
    }

    /// Negative when the version `left` orders below `right`, zero when
    /// they are the same, positive when above; a version that does not
    /// parse orders below every one that does.
    static version_order(left: str::Str, right: str::Str) -> i64 {
        match (Version::parse(left)) {
            Option::Some(parsed_left) => {
                match (Version::parse(right)) {
                    Option::Some(parsed_right) => { return parsed_left.compare(&parsed_right); }
                    Option::None               => { return 1; }
                }
            }
            Option::None => {
                if (Version::parse(right).is_some()) { return -1; }
                return 0;
            }
        }
    }

    /// The entry `request` names its library by, as its cryoconfig writes it.
    static written_entry(request: const LibraryRequest*) -> String {
        if (request.requirement.length() > 0) {
            return request.rewritten(request.source.as_str(), request.requirement.as_str());
        }
        return f"{request.name} = {{ {request.source} }}";
    }

    /// The fix that moves `request` to `target`'s version, the newest one
    /// asked for: the entry rewritten to name it and accept its series, in
    /// the program's cryoconfig, or, for a request a dependency makes, the
    /// entry a version of that dependency would write.
    static report_move(request: const LibraryRequest*, target: const LibraryRequest*) -> void {
        const target_series: String = target.version_series();
        // An entry whose own ref already names the version keeps its source.
        const source: str::Str = if (request.version == target.version) { request.source.as_str() } else { target.source.as_str() };
        const entry: String = request.rewritten(source, target_series.as_str());
        if (request.from_program) {
            fmt::eprintln(f"  help: to build {target.library_name} {target.version}, write `{entry}` in {request.config}");
        } else {
            fmt::eprintln(f"  help: {request.requester} asks for another version; a version of it whose cryoconfig writes `{entry}` builds with {target.library_name} {target.version}");
        }
    }

    /// Refuse `group`, the requests for one library, which ask for more
    /// than one series of it; `newest` indexes the request naming the
    /// newest version.
    static report_two_series(group: &[LibraryRequest], newest: i64) -> void {
        const target: const LibraryRequest* = &group[newest];
        fmt::eprintln(f"error: the program needs more than one major version of `{target.library_name}` ({target.library}), and a build holds one version of each library");
        for (mut k: i64 = 0; k < group.length(); k++) {
            const asked: String = group[k].series().unwrap_or(group[k].version.clone());
            fmt::eprintln(f"  note: {group[k].requester} asks for version {asked}: {group[k].config} writes `{DepResolver::written_entry(&group[k])}`, which names {group[k].library_name} {group[k].version}");
        }
        // The newest version's own series, whatever its request accepts.
        const target_series: String = target.version_series();
        for (mut k: i64 = 0; k < group.length(); k++) {
            const asked: String = group[k].series().unwrap_or(String::new());
            if (asked.length() > 0 && asked != target_series) { DepResolver::report_move(&group[k], target); }
        }
    }

    /// Refuse `group`, the requests for one library, none of whose versions
    /// every requirement accepts; `newest` indexes the request naming the
    /// newest version.
    static report_no_common_version(group: &[LibraryRequest], newest: i64) -> void {
        const target: const LibraryRequest* = &group[newest];
        fmt::eprintln(f"error: no version of `{target.library_name}` ({target.library}) meets every requirement on it");
        for (mut k: i64 = 0; k < group.length(); k++) {
            fmt::eprintln(f"  note: {group[k].requester} requires {group[k].requirement}: {group[k].config} writes `{DepResolver::written_entry(&group[k])}`, which names {group[k].library_name} {group[k].version}");
        }
        for (mut k: i64 = 0; k < group.length(); k++) {
            if (!DepResolver::accepts(group[k].requirement.as_str(), target.version.as_str())) {
                DepResolver::report_move(&group[k], target);
            }
        }
    }

    /// Refuse `request`, whose own version does not meet its own requirement.
    static report_unaccepted(request: const LibraryRequest*) -> void {
        fmt::eprintln(f"error: dependency '{request.name}' requires version {request.requirement}, and {request.shown} is version {request.version}");
        const accepted: String = request.version_series();
        fmt::eprintln(f"  help: to accept version {request.version}, write `{request.rewritten(request.source.as_str(), accepted.as_str())}`; or name a `branch`, `tag` or `rev` whose cryoconfig says a version that meets {request.requirement}");
    }

    /// The first git request in `requests` the walk did not build at the
    /// commit `chosen` holds for its library, or `None` when every one was.
    static built_elsewhere(requests: &[LibraryRequest], chosen: &[LibraryRequest]) -> Option<LibraryRequest> {
        for (mut i: i64 = 0; i < requests.length(); i++) {
            for (mut j: i64 = 0; j < chosen.length(); j++) {
                if (chosen[j].library == requests[i].library && chosen[j].commit != requests[i].walked) {
                    return Option::Some(requests[i].clone());
                }
            }
        }
        return Option::None;
    }

    /// Say, for each request in `requests` built at another entry's version
    /// than its own, which version it is built at.
    static report_unified(requests: &[LibraryRequest], chosen: &[LibraryRequest]) -> void {
        for (mut i: i64 = 0; i < requests.length(); i++) {
            if (requests[i].walked == requests[i].commit) { continue; }
            for (mut j: i64 = 0; j < chosen.length(); j++) {
                if (chosen[j].library == requests[i].library) {
                    fmt::println(f"[deps] {requests[i].name}: {requests[i].requester} names {requests[i].library_name} {requests[i].version}, built at {chosen[j].version}, the newest version every entry for it accepts");
                }
            }
        }
    }


    /// Harvest a dep's published source roots into `outcome.roots`, each
    /// joined onto `base`: the form the loader expects, relative for a path
    /// dependency (the loader prefixes the consumer's root) and absolute for
    /// a git one.  Each root is tagged with `package`, the dependency's
    /// identity.
    static harvest_roots(dep_cfg: const ProjectConfig*,
                           base: Path,
                           dep_name: str::Str,
                           package: str::Str,
                           outcome: mut ResolveOutcome*) -> void {
        // `DepRoot` is string-typed: it feeds the loader's scan list and
        // `ModuleInfo.origin_name`, which are.
        const name: string = String::from_str(dep_name).into_raw();
        if (dep_cfg.lib.is_present() && dep_cfg.lib.source_dir.length() > 0) {
            outcome.roots.push(DepRoot {
                path: base.join(dep_cfg.lib.source_dir).into_raw(),
                name: name,
                package: String::from_str(package),
                library: true,
            });
        }
        for (mut j: i64 = 0; j < dep_cfg.source_paths.length(); j++) {
            outcome.roots.push(DepRoot {
                path: base.join(dep_cfg.source_paths[j]).into_raw(),
                name: name,
                package: String::from_str(package),
                library: false,
            });
        }
    }
}
