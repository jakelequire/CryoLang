///! Dependency Resolver
///!
///! Top-level orchestrator for `[dependencies]`.  Walks the dep
///! tree from a consumer's cryoconfig and either:
///!
///!   - Build mode:  reads `cryoconfig.lock`, materializes any missing
///!                  checkouts, and returns the source roots the
///!                  module loader should scan.  No network, no
///!                  lockfile writes; everything must already be
///!                  resolved.
///!
///!   - Fetch mode:  resolves git deps against their remotes,
///!                  re-using existing lockfile entries when their
///!                  ref-spec is unchanged, materializes the
///!                  checkouts, and writes a fresh lockfile.
///!
///!   - Update mode: like Fetch but ignores existing lockfile entries
///!                  entirely; every git dep is re-resolved.
///!
///! Recursion: the resolver follows the `[dependencies]` of every
///! dep it visits.  Cycles are broken by tracking visited project
///! roots; a duplicate is a no-op rather than an error.

namespace Compiler::Deps::DepResolver;

import Utils::Logger;
import std::fs::metadata;
import std::fs::path;
import std::fmt;
import Compiler::ProjectConfig;
import Compiler::Deps::{ Cache, Git, Semver, Lockfile };


/// What the resolver is asked to do.
type enum ResolveMode {
    /// Read-only against the lockfile.  Hard error if anything is
    /// missing or stale.
    Build;
    /// Resolve everything; reuse existing lockfile entries when the
    /// ref-spec is unchanged.  Writes a new lockfile.
    Fetch;
    /// Force re-resolution: ignore any existing lockfile entry.
    Update;
}


/// A single harvested dependency source root, tagged with the owning
/// dependency's name so the orchestrator can classify each loaded module's
/// origin and route its object/IR output into a `<depname>/` subtree.
type struct DepRoot {
    /// Path in the form the module loader expects: relative-to-consumer
    /// for path deps (the loader prefixes `project_root`), absolute for
    /// git deps.  This is what gets pushed into the loader's scan list.
    path:  string;
    /// The dependency's name (the `[dependencies]` table key) — used as
    /// the per-package output folder name.
    name:  string;
}

type struct ResolveOutcome {
    /// Source roots the module loader should add to its scan list, each
    /// tagged with its owning dependency name.  Always populated even when
    /// `failed` is true (so debug builds can see partial progress); the
    /// caller MUST check `failed` before proceeding.
    roots:  DepRoot[];
    /// True <=> at least one dep failed to resolve.
    failed: boolean;
    /// The lockfile produced by Fetch/Update.  In Build mode this is
    /// just the file we read in (returned for caller convenience).
    lock:   Lockfile;

    static empty() -> ResolveOutcome {
        return ResolveOutcome {
            roots:  [],
            failed: false,
            lock:   Lockfile::empty(),
        };
    }
}


// Visited tracker (cycle detection)

/// Identity keys we hand to the visited set.  Two deps with the
/// same key produce the same source roots, so we resolve each
/// only once even when the dep graph has diamonds.
type struct DepKey {
    /// "path:<abs>" or "git:<sanitized-url>@<sha>".
    val: string;

    static for_path(abs_path: string) -> DepKey {
        return DepKey { val: format("path:%s", abs_path) };
    }
    static for_git(url: string, sha: string) -> DepKey {
        return DepKey { val: format("git:%s@%s", Cache::sanitize_url(url), sha) };
    }
}


/// Resolve every `[dependencies]` entry reachable from `top_config`.
///
/// `lock_path` is the path to `cryoconfig.lock` next to the consumer's
/// cryoconfig.  In Build mode we read it; in Fetch/Update we (re)write
/// it.
function resolve(top_config: ProjectConfig*,
                 mode: ResolveMode,
                 lock_path: string) -> ResolveOutcome {
    mut outcome: ResolveOutcome = ResolveOutcome::empty();
    mut visited: string[] = [];

    // Existing lockfile drives Build mode and seeds Fetch mode's
    // "reuse the entry if spec unchanged" optimization.  Update
    // ignores it entirely.
    mut existing: Lockfile = match (mode) {
        ResolveMode::Update => { Lockfile::empty() }
        _ => { Lockfile::read(lock_path) }
    };
    mut new_lock: Lockfile = Lockfile::empty();

    walk_deps(top_config, mode, &existing, &new_lock, &visited, &outcome);

    // Write the lockfile only on the success path of Fetch/Update.
    // A failed Fetch leaves the on-disk lock untouched so the user's
    // last good state is preserved.
    const should_write: boolean = !outcome.failed
        && (mode == ResolveMode::Fetch || mode == ResolveMode::Update);
    if (should_write) {
        Lockfile::write(lock_path, &new_lock);
    }

    // Each arm consumes BOTH lockfiles: one is moved into the outcome,
    // the other is moved into a throwaway local so scope-exit drop glue
    // reclaims it. Returning a match-expression that moved only one
    // binding per arm left the other moved on some paths but not others,
    // so its drop was suppressed on the path it survived - a leak (Build
    // leaked new_lock; Fetch/Update leaked existing). Lockfile has no
    // user `drop`, so we rely on glue via the discard binding.
    match (mode) {
        ResolveMode::Build => {
            mut discard: Lockfile = new_lock;
            outcome.lock = existing;
        }
        _ => {
            mut discard: Lockfile = existing;
            outcome.lock = new_lock;
        }
    }
    return outcome;
}


// Walk

/// Recursive walk: for each dep in `cfg.dependencies`, resolve it and
/// then descend into the dep's own `[dependencies]`.
///
/// Cycle detection keys deps by `(kind, identifier)`; see `DepKey`.
function walk_deps(cfg: ProjectConfig*,
                   mode: ResolveMode,
                   existing: Lockfile*,
                   new_lock: Lockfile*,
                   visited: string[]*,
                   outcome: ResolveOutcome*) -> void {
    for (mut i: int = 0; i < cfg.dependencies.length; i++) {
        const dep: Dependency = cfg.dependencies[i];

        match (dep.kind) {
            DepKind::Invalid => {
                // Parser already emitted a diagnostic.  Mark failure
                // and skip; there's no recoverable path for an
                // invalid dep schema.
                outcome.failed = true;
            }
            DepKind::Path => {
                resolve_path_dep(cfg, dep, mode, existing, new_lock, visited, outcome);
            }
            DepKind::Git => {
                resolve_git_dep(cfg, dep, mode, existing, new_lock, visited, outcome);
            }
        }
    }
}

/// Path dep: resolved by joining the consumer's project root with
/// the relative path.  We then read the dep's own cryoconfig and
/// recurse, harvesting its source roots into `outcome.roots`.
function resolve_path_dep(cfg: ProjectConfig*,
                          dep: Dependency,
                          mode: ResolveMode,
                          existing: Lockfile*,
                          new_lock: Lockfile*,
                          visited: string[]*,
                          outcome: ResolveOutcome*) -> void {
    const dep_root: string = join_path(cfg.project_root, dep.path);
    if (!metadata::exists(Path::from_cstr(format("%s/cryoconfig", dep_root)))) {
        cdebug("[deps] path dep '%s': no cryoconfig at %s\n", dep.name, dep_root);
        return;
    }

    const key: DepKey = DepKey::for_path(dep_root);
    if (already_visited(visited, key.val)) { return; }
    push_visited(visited, key.val);

    const dep_cfg: ProjectConfig = ProjectConfig::parse(
        format("%s/cryoconfig", dep_root));
    if (dep_cfg.error_count > 0) {
        fmt::eprintln(f"error: dependency '{dep.name}' has invalid cryoconfig at {dep_root}");
        outcome.failed = true;
        return;
    }
    harvest_roots(&dep_cfg, dep_root, dep.path, dep.name, outcome);
    walk_deps(&dep_cfg, mode, existing, new_lock, visited, outcome);
}

/// Git dep: the source-of-truth for what's on disk is the lockfile.
/// In Build mode we trust the lockfile completely; in Fetch/Update we
/// (re)resolve the ref to a SHA, materialize the checkout, and write
/// a fresh lockfile entry.
function resolve_git_dep(cfg: ProjectConfig*,
                         dep: Dependency,
                         mode: ResolveMode,
                         existing: Lockfile*,
                         new_lock: Lockfile*,
                         visited: string[]*,
                         outcome: ResolveOutcome*) -> void {
    mut sha: string = "";

    match (mode) {
        ResolveMode::Build => {
            const locked: LockedDep* = existing.find(dep.name);
            if (locked == null) {
                fmt::eprintln(f"error: dependency '{dep.name}' is not pinned; run `cryo fetch`");
                outcome.failed = true;
                return;
            }
            if (!locked_matches_dep(locked, dep)) {
                fmt::eprintln(f"error: lockfile entry for '{dep.name}' is stale (cryoconfig changed); run `cryo fetch`");
                outcome.failed = true;
                return;
            }
            sha = locked.sha;
            if (!Git::is_checkout_present(dep.git_url, sha)) {
                if (!Git::materialize_checkout(dep.git_url, sha)) {
                    outcome.failed = true;
                    return;
                }
            }
        }
        _ => {
            // Fetch/Update: reuse the locked SHA if (Fetch only) the
            // dep's spec is unchanged; otherwise re-resolve.
            mut reused: boolean = false;
            if (mode == ResolveMode::Fetch) {
                const locked: LockedDep* = existing.find(dep.name);
                if (locked != null && locked_matches_dep(locked, dep)) {
                    sha    = locked.sha;
                    reused = true;
                }
            }
            if (!reused) {
                if (!Git::ensure_bare_clone(dep.git_url, true)) {
                    outcome.failed = true;
                    return;
                }
                sha = resolve_to_sha(dep);
                if (intrinsics::strlen(sha) == 0) {
                    outcome.failed = true;
                    return;
                }
            }
            if (!Git::materialize_checkout(dep.git_url, sha)) {
                outcome.failed = true;
                return;
            }
            // Append to the new lockfile.
            mut entry: LockedDep = LockedDep::empty();
            entry.name     = dep.name;
            entry.url      = dep.git_url;
            entry.ref_kind = ref_kind_label(dep.ref_kind);
            entry.ref_val  = dep.ref_val;
            entry.sha      = sha;
            new_lock.packages.push(entry);
        }
    }

    // Cycle detection: scoped to this URL@SHA pair.
    const key: DepKey = DepKey::for_git(dep.git_url, sha);
    if (already_visited(visited, key.val)) { return; }
    push_visited(visited, key.val);

    const co_dir: string = Git::checkout_path(dep.git_url, sha);
    const dep_root: string = if (intrinsics::strlen(dep.subdir) > 0) {
        format("%s/%s", co_dir, dep.subdir)
    } else {
        co_dir
    };

    const dep_cryo: string = format("%s/cryoconfig", dep_root);
    if (!metadata::exists(Path::from_cstr(dep_cryo))) {
        fmt::eprintln(f"error: dependency '{dep.name}' has no cryoconfig at {dep_root}");
        outcome.failed = true;
        return;
    }
    const dep_cfg: ProjectConfig = ProjectConfig::parse(dep_cryo);
    if (dep_cfg.error_count > 0) {
        fmt::eprintln(f"error: dependency '{dep.name}' has invalid cryoconfig at {dep_root}");
        outcome.failed = true;
        return;
    }
    // Harvest using the absolute checkout path so source roots are
    // self-contained; the consumer's project_root is irrelevant for
    // git deps.
    harvest_roots_abs(&dep_cfg, dep_root, dep.name, outcome);
    walk_deps(&dep_cfg, mode, existing, new_lock, visited, outcome);
}


/// Resolve a git dep's ref-spec to a 40-char SHA.  Handles each
/// `GitRefKind` flavour; returns "" on failure (and prints).
function resolve_to_sha(dep: Dependency) -> string {
    match (dep.ref_kind) {
        GitRefKind::Version => {
            const c: Constraint = Semver::parse_constraint(dep.ref_val);
            if (!c.valid) {
                fmt::eprintln(f"error: dependency '{dep.name}' has invalid version constraint '{dep.ref_val}'");
                return "";
            }
            const tags: string[] = Git::list_tags(dep.git_url);
            const best: string = Semver::select_best_tag(c, tags);
            if (intrinsics::strlen(best) == 0) {
                fmt::eprintln(f"error: no tag in {dep.git_url} satisfies version '{dep.ref_val}'");
                return "";
            }
            return Git::resolve_ref_to_sha(
                dep.git_url, GitRefKind::Tag, best);
        }
        GitRefKind::Tag => {
            return Git::resolve_ref_to_sha(
                dep.git_url, GitRefKind::Tag, dep.ref_val);
        }
        GitRefKind::Branch => {
            return Git::resolve_ref_to_sha(
                dep.git_url, GitRefKind::Branch, dep.ref_val);
        }
        GitRefKind::Rev => {
            return Git::resolve_ref_to_sha(
                dep.git_url, GitRefKind::Rev, dep.ref_val);
        }
        GitRefKind::None => {
            // parse_inline_table_into_dep would have flagged this.
            return "";
        }
    }
}

/// Does the locked entry's recorded ref-spec still match the cryoconfig?
/// Comparing on (url, ref_kind, ref_val) catches the "user changed
/// `version = ...`" case and forces a re-resolve.
function locked_matches_dep(locked: LockedDep*, dep: Dependency) -> boolean {
    if (intrinsics::strcmp(locked.url, dep.git_url) != 0) { return false; }
    if (intrinsics::strcmp(locked.ref_kind, ref_kind_label(dep.ref_kind)) != 0) { return false; }
    if (intrinsics::strcmp(locked.ref_val, dep.ref_val) != 0) { return false; }
    return true;
}

/// String label for a `GitRefKind`; used in lockfile round-tripping.
/// Free function (rather than a method on the enum) to side-step the
/// "unsized enum return in impl block" codegen wart.
function ref_kind_label(k: GitRefKind) -> string {
    return match (k) {
        GitRefKind::Version => { "version" }
        GitRefKind::Tag     => { "tag" }
        GitRefKind::Branch  => { "branch" }
        GitRefKind::Rev     => { "rev" }
        GitRefKind::None    => { "" }
    };
}

/// Harvest a dep's published source roots into `outcome.roots`.
/// `dep_root` is the dep's project root on disk; `path_for_loader`
/// is the form the loader expects (relative for path deps so the
/// loader prefixes consumer_root, absolute for git deps).
function harvest_roots(dep_cfg: ProjectConfig*,
                       dep_root: string,
                       path_for_loader: string,
                       dep_name: string,
                       outcome: ResolveOutcome*) -> void {
    if (dep_cfg.lib.is_present() && intrinsics::strlen(dep_cfg.lib.source_dir) > 0) {
        outcome.roots.push(DepRoot {
            path: format("%s/%s", path_for_loader, dep_cfg.lib.source_dir),
            name: dep_name,
        });
    }
    for (mut j: int = 0; j < dep_cfg.source_paths.length; j++) {
        outcome.roots.push(DepRoot {
            path: format("%s/%s", path_for_loader, dep_cfg.source_paths[j]),
            name: dep_name,
        });
    }
}

/// Same as `harvest_roots` but always uses absolute paths; git deps
/// live outside the consumer's project tree.
function harvest_roots_abs(dep_cfg: ProjectConfig*,
                           dep_root: string,
                           dep_name: string,
                           outcome: ResolveOutcome*) -> void {
    if (dep_cfg.lib.is_present() && intrinsics::strlen(dep_cfg.lib.source_dir) > 0) {
        outcome.roots.push(DepRoot {
            path: format("%s/%s", dep_root, dep_cfg.lib.source_dir),
            name: dep_name,
        });
    }
    for (mut j: int = 0; j < dep_cfg.source_paths.length; j++) {
        outcome.roots.push(DepRoot {
            path: format("%s/%s", dep_root, dep_cfg.source_paths[j]),
            name: dep_name,
        });
    }
}

/// `<base>/<rel>` with a defensive shortcut when `base` is "." or empty.
function join_path(base: string, rel: string) -> string {
    if (intrinsics::strlen(base) == 0 || intrinsics::strcmp(base, ".") == 0) {
        return rel;
    }
    return format("%s/%s", base, rel);
}

function already_visited(visited: string[]*, key: string) -> boolean {
    for (mut i: int = 0; i < visited.length; i++) {
        if (intrinsics::strcmp(visited[i], key) == 0) { return true; }
    }
    return false;
}

function push_visited(visited: string[]*, key: string) -> void {
    visited.push(key);
}
