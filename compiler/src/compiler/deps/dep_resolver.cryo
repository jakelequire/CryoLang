///! Dependency Resolver
///!
///! Top-level orchestrator for `[dependencies]`.  Walks the dep
///! tree from a consumer's cryoconfig and either:
///!
///!   - Build mode:  reads `cryoconfig.lock`, materializes any missing
///!                  checkouts, and returns the source roots the
///!                  module loader should scan.  No network, no
///!                  lockfile writes; everything must already be
///!                  resolved.
///!
///!   - Fetch mode:  resolves git deps against their remotes,
///!                  re-using existing lockfile entries when their
///!                  ref-spec is unchanged, materializes the
///!                  checkouts, and writes a fresh lockfile.
///!
///!   - Update mode: like Fetch but ignores existing lockfile entries
///!                  entirely; every git dep is re-resolved.
///!
///! Recursion: the resolver follows the `[dependencies]` of every
///! dep it visits.  Cycles are broken by tracking visited project
///! roots; a duplicate is a no-op rather than an error.

namespace compiler::deps::dep_resolver;

import utils::log::{ Log, LogArea };
import std::fs::path::{ Path, PathBuf };
import std::collections::string::{ String };
import std::fmt;
import compiler::project_config::{ Dependency, DepKind, GitRefKind, ProjectConfig };
import compiler::deps::{ cache, git, semver, lockfile };
import std::collections::str;
import compiler::deps::cache::{ Cache };
import compiler::deps::git::{ Git };
import compiler::deps::lockfile::{ LockedDep, LockedVendor, Lockfile };
import compiler::deps::semver::{ Constraint };


/// What the resolver is asked to do.
type enum ResolveMode {
    /// Read-only against the lockfile.  Hard error if anything is
    /// missing or stale.
    Build;
    /// Resolve everything; reuse existing lockfile entries when the
    /// ref-spec is unchanged.  Writes a new lockfile.
    Fetch;
    /// Force re-resolution: ignore any existing lockfile entry.
    Update;
}


/// A single harvested dependency source root, tagged with the owning
/// dependency's name so the orchestrator can classify each loaded module's
/// origin and route its object/IR output into a `<depname>/` subtree.
type struct DepRoot {
    /// Path in the form the module loader expects: relative-to-consumer
    /// for path deps (the loader prefixes `project_root`), absolute for
    /// git deps.  This is what gets pushed into the loader's scan list.
    path:  string;
    /// The dependency's name (the `[dependencies]` table key) - used as
    /// the per-package output folder name.
    name:  string;
}

type struct ResolveOutcome {
    /// Source roots the module loader should add to its scan list, each
    /// tagged with its owning dependency name.  Always populated even when
    /// `failed` is true (so debug builds can see partial progress); the
    /// caller MUST check `failed` before proceeding.
    roots:  [DepRoot];
    /// True <=> at least one dep failed to resolve.
    failed: boolean;
    /// The lockfile produced by Fetch/Update.  In Build mode this is
    /// just the file we read in (returned for caller convenience).
    lock:   Lockfile;

    static empty() -> ResolveOutcome {
        return ResolveOutcome {
            roots:  [],
            failed: false,
            lock:   Lockfile::empty(),
        };
    }
}


// Visited tracker (cycle detection)

/// Identity keys we hand to the visited set.  Two deps with the
/// same key produce the same source roots, so we resolve each
/// only once even when the dep graph has diamonds.
type struct DepKey with [Eq] {
    /// "path:<abs>" or "git:<sanitized-url>@<sha>".
    val: String;

    static for_path(abs_path: str::Str) -> DepKey {
        return DepKey { val: f"path:{abs_path}" };
    }
    static for_git(url: str::Str, sha: str::Str) -> DepKey {
        const sanitized: String = Cache::sanitize_url(url);
        return DepKey { val: f"git:{sanitized}@{sha}" };
    }
}


/// Top-level orchestrator for `[dependencies]` resolution.  All entry
/// points are `static`; per-resolve state is threaded through explicit
/// parameters (`ResolveOutcome`, the visited set) rather than instance
/// fields.
type struct DepResolver {

    /// Resolve every `[dependencies]` entry reachable from `top_config`.
    ///
    /// `lock_path` is the path to `cryoconfig.lock` next to the consumer's
    /// cryoconfig.  In Build mode we read it; in Fetch/Update we (re)write
    /// it.
    static resolve(top_config: ProjectConfig*,
                     mode: ResolveMode,
                     lock_path: Path) -> ResolveOutcome {
        mut outcome: ResolveOutcome = ResolveOutcome::empty();
        mut visited: [DepKey] = [];

        // Existing lockfile drives Build mode and seeds Fetch mode's
        // "reuse the entry if spec unchanged" optimization.  Update
        // ignores it entirely.
        mut existing: Lockfile = match (mode) {
            ResolveMode::Update => { Lockfile::empty() }
            _ => { Lockfile::read(lock_path) }
        };
        mut new_lock: Lockfile = Lockfile::empty();

        DepResolver::walk_deps(top_config, mode, &existing, &new_lock, &visited, &outcome);

        // Write the lockfile only on the success path of Fetch/Update.
        // A failed Fetch leaves the on-disk lock untouched so the user's
        // last good state is preserved.
        const should_write: boolean = !outcome.failed
            && (mode == ResolveMode::Fetch || mode == ResolveMode::Update);
        if (should_write) {
            // The lockfile has two independently-managed sections: `packages`
            // (this resolver) and `vendor` (the build's reproducibility pins).
            // We only rebuilt `packages`, so carry the on-disk `vendor` section
            // over verbatim instead of clobbering it with our empty one.
            const disk: Lockfile = Lockfile::read(lock_path);
            for (mut vi: i64 = 0; vi < disk.vendor.length(); vi++) {
                new_lock.vendor.push(disk.vendor[vi].clone());
            }
            Lockfile::write(lock_path, &new_lock);
        }

        // Each arm consumes BOTH lockfiles: one is moved into the outcome,
        // the other is moved into a throwaway local so scope-exit drop glue
        // reclaims it. Returning a match-expression that moved only one
        // binding per arm left the other moved on some paths but not others,
        // so its drop was suppressed on the path it survived - a leak (Build
        // leaked new_lock; Fetch/Update leaked existing). Lockfile has no
        // user `drop`, so we rely on glue via the discard binding.
        match (mode) {
            ResolveMode::Build => {
                mut _discard: Lockfile = new_lock;
                outcome.lock = existing;
            }
            _ => {
                mut _discard: Lockfile = existing;
                outcome.lock = new_lock;
            }
        }
        return outcome;
    }


    // Walk

    /// Recursive walk: for each dep in `cfg.dependencies`, resolve it and
    /// then descend into the dep's own `[dependencies]`.
    ///
    /// Cycle detection keys deps by `(kind, identifier)`; see `DepKey`.
    static walk_deps(cfg: const ProjectConfig*,
                       mode: ResolveMode,
                       existing: Lockfile*,
                       new_lock: mut Lockfile*,
                       visited: mut [DepKey]*,
                       outcome: mut ResolveOutcome*) -> void {
        for (mut i: i64 = 0; i < cfg.dependencies.length(); i++) {
            const dep: const Dependency* = &cfg.dependencies[i];

            match (dep.kind) {
                DepKind::Invalid => {
                    // Parser already emitted a diagnostic.  Mark failure
                    // and skip; there's no recoverable path for an
                    // invalid dep schema.
                    outcome.failed = true;
                }
                DepKind::Path => {
                    DepResolver::resolve_path_dep(cfg, dep, mode, existing, new_lock, visited, outcome);
                }
                DepKind::Git => {
                    DepResolver::resolve_git_dep(cfg, dep, mode, existing, new_lock, visited, outcome);
                }
            }
        }
    }

    /// Path dep: resolved by joining the consumer's project root with
    /// the relative path.  We then read the dep's own cryoconfig and
    /// recurse, harvesting its source roots into `outcome.roots`.
    static resolve_path_dep(cfg: const ProjectConfig*,
                              dep: const Dependency*,
                              mode: ResolveMode,
                              existing: Lockfile*,
                              new_lock: mut Lockfile*,
                              visited: mut [DepKey]*,
                              outcome: mut ResolveOutcome*) -> void {
        const dep_root: PathBuf = if (cfg.project_root.eq(".")) { PathBuf::from(dep.path.as_str()) }
            else { Path::from(cfg.project_root).join(dep.path.as_str()) };
        const dep_config: PathBuf = dep_root.join("cryoconfig");
        if (!dep_config.as_path().exists()) {
            Log::warn(LogArea::Deps, f"path dependency '{dep.name}': no cryoconfig at {dep_root.as_path().as_str()}");
            return;
        }

        const key: DepKey = DepKey::for_path(dep_root.as_path().as_str());
        if (visited.contains(&key)) { return; }
        visited.push(key);

        const dep_cfg: ProjectConfig = ProjectConfig::parse(dep_config.into_raw());
        if (dep_cfg.error_count > 0) {
            fmt::eprintln(f"error: dependency '{dep.name}' has invalid cryoconfig at {dep_root.as_path().as_str()}");
            outcome.failed = true;
            return;
        }
        // The loader prefixes a path dependency's roots with the consumer's
        // project root itself, so they are handed over relative.
        DepResolver::harvest_roots(&dep_cfg, Path::from(dep.path.as_str()), dep.name.as_str(), outcome);
        DepResolver::walk_deps(&dep_cfg, mode, existing, new_lock, visited, outcome);
    }

    /// Git dep: the source-of-truth for what's on disk is the lockfile.
    /// In Build mode we trust the lockfile completely; in Fetch/Update we
    /// (re)resolve the ref to a SHA, materialize the checkout, and write
    /// a fresh lockfile entry.
    static resolve_git_dep(cfg: const ProjectConfig*,
                             dep: const Dependency*,
                             mode: ResolveMode,
                             existing: Lockfile*,
                             new_lock: mut Lockfile*,
                             visited: mut [DepKey]*,
                             outcome: mut ResolveOutcome*) -> void {
        mut sha: String = String::new();

        match (mode) {
            ResolveMode::Build => {
                const locked: const LockedDep* = existing.find(dep.name.as_str());
                if (locked == null) {
                    fmt::eprintln(f"error: dependency '{dep.name}' is not pinned; run `cryo fetch`");
                    outcome.failed = true;
                    return;
                }
                if (!DepResolver::locked_matches_dep(locked, dep)) {
                    fmt::eprintln(f"error: lockfile entry for '{dep.name}' is stale (cryoconfig changed); run `cryo fetch`");
                    outcome.failed = true;
                    return;
                }
                sha = locked.sha.clone();
                if (!Git::is_checkout_present(dep.git_url.as_str(), sha.as_str())) {
                    if (!Git::materialize_checkout(dep.git_url.as_str(), sha.as_str())) {
                        outcome.failed = true;
                        return;
                    }
                }
            }
            _ => {
                // Fetch/Update: reuse the locked SHA if (Fetch only) the
                // dep's spec is unchanged; otherwise re-resolve.
                mut reused: boolean = false;
                if (mode == ResolveMode::Fetch) {
                    const locked: const LockedDep* = existing.find(dep.name.as_str());
                    if (locked != null && DepResolver::locked_matches_dep(locked, dep)) {
                        sha    = locked.sha.clone();
                        reused = true;
                    }
                }
                if (!reused) {
                    if (!Git::ensure_bare_clone(dep.git_url.as_str(), true)) {
                        outcome.failed = true;
                        return;
                    }
                    sha = DepResolver::resolve_to_sha(dep);
                    if (sha.length() == 0) {
                        outcome.failed = true;
                        return;
                    }
                }
                if (!Git::materialize_checkout(dep.git_url.as_str(), sha.as_str())) {
                    outcome.failed = true;
                    return;
                }
                // Append to the new lockfile.
                new_lock.packages.push(LockedDep {
                    name:     dep.name.clone(),
                    url:      dep.git_url.clone(),
                    ref_kind: String::from_str(DepResolver::ref_kind_label(dep.ref_kind)),
                    ref_val:  dep.ref_val.clone(),
                    sha:      sha.clone(),
                });
            }
        }

        // Cycle detection: scoped to this URL@SHA pair.
        const key: DepKey = DepKey::for_git(dep.git_url.as_str(), sha.as_str());
        if (visited.contains(&key)) { return; }
        visited.push(key);

        const checkout: PathBuf = Git::checkout_path(dep.git_url.as_str(), sha.as_str());
        const dep_root: PathBuf = if (dep.subdir.length() > 0) {
            checkout.join(dep.subdir.as_str())
        } else {
            checkout
        };

        const dep_cryo: PathBuf = dep_root.join("cryoconfig");
        if (!dep_cryo.as_path().exists()) {
            fmt::eprintln(f"error: dependency '{dep.name}' has no cryoconfig at {dep_root.as_path().as_str()}");
            outcome.failed = true;
            return;
        }
        const dep_cfg: ProjectConfig = ProjectConfig::parse(dep_cryo.into_raw());
        if (dep_cfg.error_count > 0) {
            fmt::eprintln(f"error: dependency '{dep.name}' has invalid cryoconfig at {dep_root.as_path().as_str()}");
            outcome.failed = true;
            return;
        }
        // Harvest using the absolute checkout path so source roots are
        // self-contained; the consumer's project_root is irrelevant for
        // git deps.
        DepResolver::harvest_roots(&dep_cfg, dep_root.as_path(), dep.name.as_str(), outcome);
        DepResolver::walk_deps(&dep_cfg, mode, existing, new_lock, visited, outcome);
    }


    /// Resolve a git dep's ref-spec to a 40-char SHA.  Handles each
    /// `GitRefKind` flavour; returns "" on failure (and prints).
    static resolve_to_sha(dep: const Dependency*) -> String {
        match (dep.ref_kind) {
            GitRefKind::Version => {
                const c: Constraint = Constraint::parse(dep.ref_val.as_str());
                if (!c.valid) {
                    fmt::eprintln(f"error: dependency '{dep.name}' has invalid version constraint '{dep.ref_val}'");
                    return String::new();
                }
                const tags: [String] = Git::list_tags(dep.git_url.as_str());
                const best: String = Constraint::select_best_tag(c, &tags);
                if (best.length() == 0) {
                    fmt::eprintln(f"error: no tag in {dep.git_url} satisfies version '{dep.ref_val}'");
                    return String::new();
                }
                return Git::resolve_ref_to_sha(
                    dep.git_url.as_str(), GitRefKind::Tag, best.as_str());
            }
            GitRefKind::Tag => {
                return Git::resolve_ref_to_sha(
                    dep.git_url.as_str(), GitRefKind::Tag, dep.ref_val.as_str());
            }
            GitRefKind::Branch => {
                return Git::resolve_ref_to_sha(
                    dep.git_url.as_str(), GitRefKind::Branch, dep.ref_val.as_str());
            }
            GitRefKind::Rev => {
                return Git::resolve_ref_to_sha(
                    dep.git_url.as_str(), GitRefKind::Rev, dep.ref_val.as_str());
            }
            GitRefKind::None => {
                // parse_inline_table_into_dep would have flagged this.
                return String::new();
            }
        }
    }

    /// Does the locked entry's recorded ref-spec still match the cryoconfig?
    /// Comparing on (url, ref_kind, ref_val) catches the "user changed
    /// `version = ...`" case and forces a re-resolve.
    static locked_matches_dep(locked: const LockedDep*, dep: const Dependency*) -> boolean {
        if (locked.url.as_str() != dep.git_url.as_str()) { return false; }
        if (locked.ref_kind.as_str() != DepResolver::ref_kind_label(dep.ref_kind)) { return false; }
        if (locked.ref_val.as_str() != dep.ref_val.as_str()) { return false; }
        return true;
    }

    /// String label for a `GitRefKind`; used in lockfile round-tripping
    /// (the inverse of parsing the `ref_kind` field back into the enum).
    static ref_kind_label(k: GitRefKind) -> str::Str {
        return match (k) {
            GitRefKind::Version => { str::Str::from("version") }
            GitRefKind::Tag     => { str::Str::from("tag") }
            GitRefKind::Branch  => { str::Str::from("branch") }
            GitRefKind::Rev     => { str::Str::from("rev") }
            GitRefKind::None    => { str::Str::from("") }
        };
    }

    /// Harvest a dep's published source roots into `outcome.roots`, each
    /// joined onto `base`: the form the loader expects, relative for a path
    /// dependency (the loader prefixes the consumer's root) and absolute for
    /// a git one.
    static harvest_roots(dep_cfg: const ProjectConfig*,
                           base: Path,
                           dep_name: str::Str,
                           outcome: mut ResolveOutcome*) -> void {
        // `DepRoot` is string-typed: it feeds the loader's scan list and
        // `ModuleInfo.origin_name`, which are.
        const name: string = String::from_str(dep_name).into_raw();
        if (dep_cfg.lib.is_present() && dep_cfg.lib.source_dir.length() > 0) {
            outcome.roots.push(DepRoot {
                path: base.join(dep_cfg.lib.source_dir).into_raw(),
                name: name,
            });
        }
        for (mut j: i64 = 0; j < dep_cfg.source_paths.length(); j++) {
            outcome.roots.push(DepRoot {
                path: base.join(dep_cfg.source_paths[j]).into_raw(),
                name: name,
            });
        }
    }
}
