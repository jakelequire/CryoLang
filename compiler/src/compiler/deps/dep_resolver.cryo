///! Dependency Resolver
///!
///! Top-level orchestrator for `[dependencies]`.  Walks the dep
///! tree from a consumer's cryoconfig and either:
///!
///!   - Build mode:  reads `cryoconfig.lock`, extracts any missing
///!                  commit from its bare clone, and returns the source roots the
///!                  module loader should scan.  No network, no
///!                  lockfile writes; everything must already be
///!                  resolved.
///!
///!   - Fetch mode:  resolves git deps against their remotes,
///!                  re-using existing lockfile entries when their
///!                  ref-spec is unchanged, extracts each pinned
///!                  commit's files, and writes a fresh lockfile.
///!
///!   - Update mode: like Fetch but ignores existing lockfile entries
///!                  entirely; every git dep is re-resolved.
///!
///! Recursion: the resolver follows the `[dependencies]` of every
///! dep it visits.  Cycles are broken by tracking visited project
///! roots; a duplicate is a no-op rather than an error.

namespace compiler::deps::dep_resolver;

import std::fs::path::{ Path, PathBuf };
import std::collections::string::{ String };
import std::fmt;
import compiler::project_config::{ Dependency, DepKind, GitRefKind, ProjectConfig };
import compiler::deps::{ cache, git, semver, lockfile };
import std::collections::str;
import compiler::deps::cache::{ Cache };
import compiler::deps::content::{ PackageContent };
import compiler::deps::git::{ Git };
import compiler::deps::git_url::{ GitUrl };
import compiler::module_graph::{ PackageDeclaration };
import compiler::deps::lockfile::{ LockedDep, LockedVendor, Lockfile };
import compiler::deps::semver::{ Requirement, Version };
import compiler::utils::directory_lock::{ DirectoryLock };


/// What the resolver is asked to do.
type enum ResolveMode {
    /// Read-only against the lockfile.  Hard error if anything is
    /// missing or stale.
    Build;
    /// Resolve everything; reuse existing lockfile entries when the
    /// ref-spec is unchanged.  Writes a new lockfile.
    Fetch;
    /// Force re-resolution: ignore any existing lockfile entry.
    Update;
}


/// A single harvested dependency source root, tagged with the owning
/// dependency's name so the orchestrator can classify each loaded module's
/// origin and route its object/IR output into a `<depname>/` subtree.
type struct DepRoot {
    /// Path in the form the module loader expects: relative-to-consumer
    /// for path deps (the loader prefixes `project_root`), absolute for
    /// git deps.  This is what gets pushed into the loader's scan list.
    path:  string;
    /// The dependency's name (the `[dependencies]` table key) - used as
    /// the per-package output folder name.
    name:  string;
    /// The package's identity: its directory, canonicalized
    /// (`DepKey`), the same however a cryoconfig spells the path to it.
    package: String;
    /// Whether this root is the source directory of the package's `[lib]`,
    /// whose `lib.cryo` declares the library's namespace.
    library: boolean;
}

type struct ResolveOutcome {
    /// Source roots the module loader should add to its scan list, each
    /// tagged with its owning dependency name.  Always populated even when
    /// `failed` is true (so debug builds can see partial progress); the
    /// caller MUST check `failed` before proceeding.
    roots:  [DepRoot];
    /// Every `[dependencies]` entry of every cryoconfig walked, the
    /// program's included, once per (declarer, declared) pair, each
    /// package named by its `DepKey`.
    declarations: [PackageDeclaration];
    /// True <=> at least one dep failed to resolve.
    failed: boolean;
    /// The lockfile produced by Fetch/Update.  In Build mode this is
    /// just the file we read in (returned for caller convenience).
    lock:   Lockfile;

    static empty() -> ResolveOutcome {
        return ResolveOutcome {
            roots:        [],
            declarations: [],
            failed:       false,
            lock:         Lockfile::empty(),
        };
    }

    /// Record that `declarer`'s cryoconfig names `declared`.
    declare(mut &this, declarer: str::Str, declared: str::Str) -> void {
        for (mut i: i64 = 0; i < this.declarations.length(); i++) {
            if (this.declarations[i].declarer.as_str() == declarer
                    && this.declarations[i].declared.as_str() == declared) { return; }
        }
        this.declarations.push(PackageDeclaration {
            declarer: String::from_str(declarer),
            declared: String::from_str(declared),
        });
    }
}


// Visited tracker (cycle detection)

/// A package's identity: its directory, canonicalized, so that every
/// spelling of the path to one package - `a`, `b/../a`, a checkout reached
/// by two cryoconfigs - names it once.  Two deps with the same key produce
/// the same source roots, so each is resolved only once even when the dep
/// graph has diamonds, and declarations name packages by it.
type struct DepKey with [Eq, Clone] {
    val: String;

    /// The key of the package in `directory`, which exists; `None` when
    /// the operating system cannot canonicalize it.
    static for_directory(directory: Path) -> Option<DepKey> {
        match (directory.canonicalize()) {
            Result::Ok(canonical) => { return Option::Some(DepKey { val: String::from_str(canonical.as_path().as_str()) }); }
            Result::Err(_)        => { return Option::None; }
        }
    }
}


/// Top-level orchestrator for `[dependencies]` resolution.  All entry
/// points are `static`; per-resolve state is threaded through explicit
/// parameters (`ResolveOutcome`, the visited set) rather than instance
/// fields.
type struct DepResolver {

    /// Resolve every `[dependencies]` entry reachable from `top_config`.
    ///
    /// `lock_path` is the path to `cryoconfig.lock` next to the consumer's
    /// cryoconfig.  In Build mode we read it; in Fetch/Update we (re)write
    /// it.
    static resolve(top_config: ProjectConfig*,
                     mode: ResolveMode,
                     lock_path: Path) -> ResolveOutcome {
        mut outcome: ResolveOutcome = ResolveOutcome::empty();
        mut visited: [DepKey] = [];

        // Existing lockfile drives Build mode and seeds Fetch mode's
        // "reuse the entry if spec unchanged" optimization.  Update
        // ignores it entirely.
        mut existing: Lockfile = match (mode) {
            ResolveMode::Update => { Lockfile::empty() }
            _ => { Lockfile::read(lock_path) }
        };
        mut new_lock: Lockfile = Lockfile::empty();

        DepResolver::walk_deps(top_config, str::Str::from(""), Path::from(""), true, mode, &existing, &new_lock, &visited, &outcome);

        // Write the lockfile only on the success path of Fetch/Update.
        // A failed Fetch leaves the on-disk lock untouched so the user's
        // last good state is preserved.
        const should_write: boolean = !outcome.failed
            && (mode == ResolveMode::Fetch || mode == ResolveMode::Update);
        if (should_write) {
            // The lockfile has two independently-managed sections: `packages`
            // (this resolver) and `vendor` (the build's reproducibility pins).
            // We only rebuilt `packages`, so carry the on-disk `vendor` section
            // over verbatim instead of clobbering it with our empty one.
            const disk: Lockfile = Lockfile::read(lock_path);
            for (mut vi: i64 = 0; vi < disk.vendor.length(); vi++) {
                new_lock.vendor.push(disk.vendor[vi].clone());
            }
            Lockfile::write(lock_path, &new_lock);
        }

        // Each arm consumes BOTH lockfiles: one is moved into the outcome,
        // the other is moved into a throwaway local so scope-exit drop glue
        // reclaims it. Returning a match-expression that moved only one
        // binding per arm left the other moved on some paths but not others,
        // so its drop was suppressed on the path it survived - a leak (Build
        // leaked new_lock; Fetch/Update leaked existing). Lockfile has no
        // user `drop`, so we rely on glue via the discard binding.
        match (mode) {
            ResolveMode::Build => {
                mut _discard: Lockfile = new_lock;
                outcome.lock = existing;
            }
            _ => {
                mut _discard: Lockfile = existing;
                outcome.lock = new_lock;
            }
        }
        return outcome;
    }


    // Walk

    /// Recursive walk: for each dep in `cfg.dependencies`, resolve it and
    /// then descend into the dep's own `[dependencies]`.  `declarer` is the
    /// identity of the package `cfg` belongs to ("" for the program), and
    /// `base` its directory in the form the loader takes a root in: ""
    /// for the program, relative to the program's root below a path
    /// dependency, absolute below a git one.  A path dependency's `path`
    /// is relative to the cryoconfig that writes it, so it is joined onto
    /// that package's `base`.  `on_this_machine` says where `cfg`'s package
    /// came from: the program, and every package reached from it through
    /// path dependencies and `file://` repositories alone, is on this
    /// machine; a package fetched from a remote, and everything below it,
    /// is not, and may not name a `file://` repository.
    ///
    /// Cycle detection keys deps by their directory; see `DepKey`.
    static walk_deps(cfg: const ProjectConfig*,
                       declarer: str::Str,
                       base: Path,
                       on_this_machine: boolean,
                       mode: ResolveMode,
                       existing: Lockfile*,
                       new_lock: mut Lockfile*,
                       visited: mut [DepKey]*,
                       outcome: mut ResolveOutcome*) -> void {
        for (mut i: i64 = 0; i < cfg.dependencies.length(); i++) {
            const dep: const Dependency* = &cfg.dependencies[i];

            match (dep.kind) {
                DepKind::Invalid => {
                    // Parser already emitted a diagnostic.  Mark failure
                    // and skip; there's no recoverable path for an
                    // invalid dep schema.
                    outcome.failed = true;
                }
                DepKind::Path => {
                    DepResolver::resolve_path_dep(cfg, declarer, base, on_this_machine, dep, mode, existing, new_lock, visited, outcome);
                }
                DepKind::Git => {
                    DepResolver::resolve_git_dep(cfg, declarer, on_this_machine, dep, mode, existing, new_lock, visited, outcome);
                }
            }
        }
    }

    /// Path dep: resolved by joining the consumer's project root with
    /// the relative path.  We then read the dep's own cryoconfig and
    /// recurse, harvesting its source roots into `outcome.roots`.
    static resolve_path_dep(cfg: const ProjectConfig*,
                              declarer: str::Str,
                              base: Path,
                              on_this_machine: boolean,
                              dep: const Dependency*,
                              mode: ResolveMode,
                              existing: Lockfile*,
                              new_lock: mut Lockfile*,
                              visited: mut [DepKey]*,
                              outcome: mut ResolveOutcome*) -> void {
        const dep_root: PathBuf = if (cfg.project_root.eq(".")) { PathBuf::from(dep.path.as_str()) }
            else { Path::from(cfg.project_root).join(dep.path.as_str()) };
        const dep_config: PathBuf = dep_root.join("cryoconfig");
        if (!dep_root.as_path().exists()) {
            fmt::eprintln(f"error: path dependency '{dep.name}' names {dep_root.as_path().as_str()}, which does not exist");
            outcome.failed = true;
            return;
        }
        if (!dep_config.as_path().exists()) {
            fmt::eprintln(f"error: path dependency '{dep.name}' has no cryoconfig at {dep_root.as_path().as_str()}");
            fmt::eprintln("  help: a dependency is a Cryo project; its directory holds a cryoconfig with a [lib] section");
            outcome.failed = true;
            return;
        }

        const found: Option<DepKey> = DepResolver::key_declared_by(declarer, dep, dep_root.as_path(), outcome);
        if (found.is_none()) { return; }
        const key: DepKey = found.unwrap();
        if (visited.contains(&key)) { return; }
        visited.push(key.clone());

        const dep_cfg: ProjectConfig = ProjectConfig::parse(dep_config.into_raw());
        if (dep_cfg.error_count > 0) {
            fmt::eprintln(f"error: dependency '{dep.name}' has invalid cryoconfig at {dep_root.as_path().as_str()}");
            outcome.failed = true;
            return;
        }
        if (DepResolver::library_version(dep, &dep_cfg, dep_root.as_path(), String::new()).is_none()) {
            outcome.failed = true;
            return;
        }
        // The loader prefixes a relative root with the program's project
        // root itself, so a path dependency's roots are handed over relative
        // to it (or absolute, below a git dependency).
        const package_base: PathBuf = if (base.is_empty()) { PathBuf::from(dep.path.as_str()) }
            else { base.join(dep.path.as_str()) };
        DepResolver::harvest_roots(&dep_cfg, package_base.as_path(), dep.name.as_str(), key.val.as_str(), outcome);
        DepResolver::walk_deps(&dep_cfg, key.val.as_str(), package_base.as_path(), on_this_machine, mode, existing, new_lock, visited, outcome);
    }

    /// The identity of the package `dep` names, in `directory`, recorded as
    /// declared by `declarer`; `None`, with the build failed, when the
    /// directory cannot be canonicalized.
    static key_declared_by(declarer: str::Str, dep: const Dependency*, directory: Path,
                           outcome: mut ResolveOutcome*) -> Option<DepKey> {
        match (DepKey::for_directory(directory)) {
            Option::Some(key) => {
                outcome.declare(declarer, key.val.as_str());
                return Option::Some(key);
            }
            Option::None => {
                fmt::eprintln(f"error: dependency '{dep.name}': cannot resolve the directory {directory.as_str()}");
                outcome.failed = true;
                return Option::None;
            }
        }
    }

    /// Git dep: the source-of-truth for what's on disk is the lockfile.
    /// In Build mode we trust the lockfile completely; in Fetch/Update we
    /// (re)resolve the ref to a SHA, extract the commit's files, and write
    /// a fresh lockfile entry.
    static resolve_git_dep(cfg: const ProjectConfig*,
                             declarer: str::Str,
                             on_this_machine: boolean,
                             dep: const Dependency*,
                             mode: ResolveMode,
                             existing: Lockfile*,
                             new_lock: mut Lockfile*,
                             visited: mut [DepKey]*,
                             outcome: mut ResolveOutcome*) -> void {
        mut sha: String = String::new();
        const local_repository: boolean = match (GitUrl::package_on_this_machine(on_this_machine, dep.git_url.as_str())) {
            Option::Some(local) => { local }
            Option::None => {
                fmt::eprintln(f"error: dependency '{dep.name}' names a repository on this machine ({dep.git_url}), from a package fetched from a remote");
                fmt::eprintln("  help: only the program, and packages on this machine, may name a `file://` repository");
                outcome.failed = true;
                return;
            }
        };

        // Builds and tests running at once share the cache, so its entries
        // for one repository are read and made under that repository's lock.
        mut lock: DirectoryLock = Cache::repository_lock(dep.git_url.as_str());
        match (lock.take()) {
            Result::Ok(_)    => { }
            Result::Err(why) => {
                fmt::eprintln(f"error: dependency '{dep.name}': {why}");
                outcome.failed = true;
                return;
            }
        }
        const pinned: Option<LockedDep> = DepResolver::cached_commit(dep, mode, existing);
        lock.release();
        mut entry: LockedDep = match (pinned) {
            Option::Some(found) => { found }
            Option::None        => { outcome.failed = true; return; }
        };
        sha = entry.commit.clone();

        const checkout: PathBuf = Cache::extraction_dir_for(dep.git_url.as_str(), sha.as_str());
        const dep_root: PathBuf = if (dep.subdir.length() > 0) {
            checkout.join(dep.subdir.as_str())
        } else {
            checkout
        };

        const dep_cryo: PathBuf = dep_root.join("cryoconfig");
        if (!dep_cryo.as_path().exists()) {
            fmt::eprintln(f"error: dependency '{dep.name}' has no cryoconfig at {dep_root.as_path().as_str()}");
            outcome.failed = true;
            return;
        }

        // Every entry naming the repository is checked and locked, whichever
        // reaches its package first.
        const dep_cfg: ProjectConfig = ProjectConfig::parse(dep_cryo.into_raw());
        if (dep_cfg.error_count > 0) {
            fmt::eprintln(f"error: dependency '{dep.name}' has invalid cryoconfig at {dep_root.as_path().as_str()}");
            outcome.failed = true;
            return;
        }
        match (DepResolver::library_version(dep, &dep_cfg, dep_root.as_path(), sha.clone())) {
            Option::Some(version) => { entry.version = version; }
            Option::None          => { outcome.failed = true; return; }
        }
        if (mode != ResolveMode::Build) {
            const ref_key: str::Str = GitRefKind::key_name(dep.ref_kind);
            const selected: String = if (ref_key.length() > 0) { f"{ref_key} {dep.ref_val}" } else { String::from_str(str::Str::new("default branch")) };
            fmt::println(f"[deps] {dep.name} {entry.version} from {dep.git_url} ({selected}, commit {sha.as_str().byte_substring(0, 12)})");
            new_lock.packages.push(entry);
        }

        // Cycle detection: one package directory is one checkout of one
        // commit, so this is scoped to the URL, the commit and the subdir.
        const found: Option<DepKey> = DepResolver::key_declared_by(declarer, dep, dep_root.as_path(), outcome);
        if (found.is_none()) { return; }
        const key: DepKey = found.unwrap();
        if (visited.contains(&key)) { return; }
        visited.push(key.clone());
        // Harvest using the absolute checkout path so source roots are
        // self-contained; the consumer's project_root is irrelevant for
        // git deps.
        DepResolver::harvest_roots(&dep_cfg, dep_root.as_path(), dep.name.as_str(), key.val.as_str(), outcome);
        DepResolver::walk_deps(&dep_cfg, key.val.as_str(), dep_root.as_path(), local_repository, mode, existing, new_lock, visited, outcome);
    }

    /// The lock entry of git dependency `dep`, whose commit's files are
    /// extracted in the cache, its repository's lock held.  A build takes it
    /// from the lock file, re-extracts it from the bare clone when its files
    /// are missing, and checks them against the recorded content hash.  A
    /// fetch keeps the locked commit while the entry's ref is unchanged and
    /// its recorded version meets the `version` requirement; an update, or a
    /// fetch that cannot keep it, resolves the ref again.  Either extracts
    /// what no longer matches and answers a new entry, whose `version` the
    /// caller fills in from the commit's cryoconfig.  `None` once the
    /// failure is reported.
    static cached_commit(dep: const Dependency*, mode: ResolveMode, existing: Lockfile*) -> Option<LockedDep> {
        mut sha: String = String::new();
        const url: str::Str = dep.git_url.as_str();
        const ref_kind: str::Str = GitRefKind::key_name(dep.ref_kind);
        match (mode) {
            ResolveMode::Build => {
                const locked: const LockedDep* = existing.find(url, ref_kind, dep.ref_val.as_str());
                if (locked == null) {
                    if (existing.pins_url(url)) {
                        fmt::eprintln(f"error: lockfile entry for '{dep.name}' is stale (cryoconfig changed); run `cryo fetch`");
                    } else {
                        fmt::eprintln(f"error: dependency '{dep.name}' is not pinned; run `cryo fetch`");
                    }
                    return Option::None;
                }
                sha = locked.commit.clone();
                if (!GitUrl::is_commit_id(sha.as_str())) {
                    fmt::eprintln(f"error: lockfile entry for '{dep.name}' holds `{sha}`, which is not a commit id; run `cryo fetch`");
                    return Option::None;
                }
                if (locked.content.length() == 0) {
                    fmt::eprintln(f"error: lockfile entry for '{dep.name}' records no content hash; run `cryo fetch`");
                    return Option::None;
                }
                // A missing extraction is made again from the bare clone,
                // which is local: a build starts no network fetch.
                if (!Git::extract(dep.name.as_str(), url, sha.as_str(), false)) {
                    return Option::None;
                }
                // The files are checked on every build, so a cached file
                // edited by hand, or made by another tool, is never compiled.
                const extraction: PathBuf = Cache::extraction_dir_for(url, sha.as_str());
                match (PackageContent::of_directory(extraction.as_path())) {
                    Result::Ok(found) => {
                        if (found != locked.content) {
                            fmt::eprintln(f"error: the files of dependency '{dep.name}' in the cache are not those of commit {sha}, which cryoconfig.lock pins");
                            fmt::eprintln(f"  note: {extraction.as_path().as_str()} hashes to {found}; the lock records {locked.content}");
                            fmt::eprintln("  help: run `cryo fetch`, which extracts the commit's files again");
                            return Option::None;
                        }
                    }
                    Result::Err(why) => {
                        fmt::eprintln(f"error: cannot check the files of dependency '{dep.name}' in the cache: {why}");
                        fmt::eprintln("  help: run `cryo fetch`, which extracts the commit's files again");
                        return Option::None;
                    }
                }
                return Option::Some(locked.clone());
            }
            _ => {
                // Fetch/Update: reuse the locked commit if (Fetch only) the
                // dep's ref is unchanged and its version is still accepted;
                // otherwise resolve again.
                mut reused: boolean = false;
                mut recorded: String = String::new();
                if (mode == ResolveMode::Fetch) {
                    const locked: const LockedDep* = existing.find(url, ref_kind, dep.ref_val.as_str());
                    if (locked != null && GitUrl::is_commit_id(locked.commit.as_str())
                            && DepResolver::accepts(dep, locked.version.as_str())) {
                        sha      = locked.commit.clone();
                        recorded = locked.content.clone();
                        reused   = true;
                    }
                }
                // An extraction whose files still hash to what the lock
                // records is kept.  Any other is made again from the bare
                // clone, so the content a lock records always comes from git
                // and never from a cache that was changed.  A reused pin
                // needs the bare clone then too (a committed lock on a fresh
                // cache), but not its remote refs refreshed.
                const kept: boolean = reused && recorded.length() > 0 && Git::is_extracted(url, sha.as_str())
                    && PackageContent::of_directory(Cache::extraction_dir_for(url, sha.as_str()).as_path()).unwrap_or(String::new()) == recorded;
                if (!kept && !Git::ensure_bare_clone(url, !reused)) {
                    return Option::None;
                }
                if (!reused) {
                    sha = Git::resolve_ref_to_sha(url, dep.ref_kind, dep.ref_val.as_str());
                    if (sha.length() == 0) {
                        return Option::None;
                    }
                }
                if (!kept && !Git::extract(dep.name.as_str(), url, sha.as_str(), true)) {
                    return Option::None;
                }
                const content: String = match (PackageContent::of_directory(Cache::extraction_dir_for(url, sha.as_str()).as_path())) {
                    Result::Ok(found) => { found }
                    Result::Err(why)  => {
                        fmt::eprintln(f"error: cannot hash the files of dependency '{dep.name}': {why}");
                        return Option::None;
                    }
                };
                return Option::Some(LockedDep {
                    url:      dep.git_url.clone(),
                    ref_kind: String::from_str(ref_kind),
                    ref_val:  dep.ref_val.clone(),
                    commit:   sha,
                    content:  content,
                    version:  String::new(),
                });
            }
        }
    }

    /// Whether `version`, a library's `[lib] version` as written, meets
    /// `dep`'s `version` requirement; true when `dep` writes none, and false
    /// for an empty or malformed version when it does.
    static accepts(dep: const Dependency*, version: str::Str) -> boolean {
        if (dep.version_requirement.length() == 0) { return true; }
        match (Requirement::parse(dep.version_requirement.as_str())) {
            Option::Some(requirement) => {
                match (Version::parse(version)) {
                    Option::Some(parsed) => { return requirement.satisfied_by(&parsed); }
                    Option::None         => { return false; }
                }
            }
            Option::None => { return false; }
        }
    }

    /// The version of the library `dep` names, whose cryoconfig is
    /// `dep_cfg` in `directory`, held to what `dep` asks of it; `None` once
    /// the failure is reported.  A dependency is a library: its cryoconfig
    /// has a `[lib]`.  A git dependency's library says its version, and
    /// so does a path dependency's when `dep` writes a `version`
    /// requirement, which the version must meet.  A git dependency pinned
    /// by a tag that names a version, `v0.2.0`, must find that version in
    /// the tagged commit's cryoconfig.  `commit` is the git dependency's
    /// commit, and empty for a path dependency.
    static library_version(dep: const Dependency*, dep_cfg: const ProjectConfig*, directory: Path,
                           commit: String) -> Option<String> {
        const config_path: PathBuf = directory.join("cryoconfig");
        const shown: String = if (commit.length() > 0) { f"{dep.git_url} at commit {commit.as_str().byte_substring(0, 12)}" }
            else { String::from_str(directory.as_str()) };
        if (!dep_cfg.lib.is_present()) {
            fmt::eprintln(f"error: dependency '{dep.name}' is not a library: {config_path.as_path().as_str()} has no [lib] section");
            fmt::eprintln(f"  help: a library's cryoconfig names it, its sources and its version:");
            fmt::eprintln(f"        [lib]");
            fmt::eprintln(f"        name = \"{dep.name}\"");
            fmt::eprintln(f"        source_dir = \"src\"");
            fmt::eprintln(f"        version = \"0.1.0\"");
            return Option::None;
        }
        const version: String = String::from_str(str::Str::from(dep_cfg.lib.version));
        if (version.length() == 0) {
            if (commit.length() == 0 && dep.version_requirement.length() == 0) { return Option::Some(version); }
            fmt::eprintln(f"error: dependency '{dep.name}' ({shown}) does not say its version");
            if (commit.length() > 0) {
                fmt::eprintln("  help: the library's cryoconfig says it under [lib]: `version = \"0.1.0\"`; commit that to the repository, then run `cryo update`");
            } else {
                fmt::eprintln(f"  help: the library's cryoconfig says it under [lib]: add `version = \"0.1.0\"` to {config_path.as_path().as_str()}");
            }
            return Option::None;
        }
        if (!DepResolver::accepts(dep, version.as_str())) {
            fmt::eprintln(f"error: dependency '{dep.name}' requires version {dep.version_requirement}, and {shown} is version {version}");
            // The requirement that accepts this version and every later one
            // that does not break it: its major, or below 1.0.0 its minor too.
            mut accepted: String = version.clone();
            match (Version::parse(version.as_str())) {
                Option::Some(parsed) => {
                    accepted = f"{parsed.major}";
                    if (parsed.major == 0) { accepted.push(f".{parsed.minor}"); }
                }
                Option::None => { }
            }
            mut source: String = if (commit.length() > 0) { f"git = \"{dep.git_url}\"" } else { f"path = \"{dep.path}\"" };
            const ref_key: str::Str = GitRefKind::key_name(dep.ref_kind);
            if (ref_key.length() > 0) { source.push(f", {ref_key} = \"{dep.ref_val}\""); }
            fmt::eprintln(f"  help: to accept version {version}, write `{dep.name} = {{ {source}, version = \"{accepted}\" }}`; or name a `branch`, `tag` or `rev` whose cryoconfig says a version that meets {dep.version_requirement}");
            return Option::None;
        }
        match (dep.ref_kind) {
            GitRefKind::Tag => {
                match (Version::of_tag(dep.ref_val.as_str())) {
                    Option::Some(tagged) => {
                        const said: Option<Version> = Version::parse(version.as_str());
                        if (said.is_none() || said.unwrap().compare(&tagged) != 0) {
                            fmt::eprintln(f"error: dependency '{dep.name}' names the tag `{dep.ref_val}`, and the library's cryoconfig at that tag says version {version}");
                            fmt::eprintln(f"  help: a tag that names a version must agree with `[lib] version`; to take this commit anyway, write `rev = \"{commit}\"` in place of `tag = \"{dep.ref_val}\"`");
                            return Option::None;
                        }
                    }
                    Option::None => { }
                }
            }
            _ => { }
        }
        return Option::Some(version);
    }


    /// Harvest a dep's published source roots into `outcome.roots`, each
    /// joined onto `base`: the form the loader expects, relative for a path
    /// dependency (the loader prefixes the consumer's root) and absolute for
    /// a git one.  Each root is tagged with `package`, the dependency's
    /// identity.
    static harvest_roots(dep_cfg: const ProjectConfig*,
                           base: Path,
                           dep_name: str::Str,
                           package: str::Str,
                           outcome: mut ResolveOutcome*) -> void {
        // `DepRoot` is string-typed: it feeds the loader's scan list and
        // `ModuleInfo.origin_name`, which are.
        const name: string = String::from_str(dep_name).into_raw();
        if (dep_cfg.lib.is_present() && dep_cfg.lib.source_dir.length() > 0) {
            outcome.roots.push(DepRoot {
                path: base.join(dep_cfg.lib.source_dir).into_raw(),
                name: name,
                package: String::from_str(package),
                library: true,
            });
        }
        for (mut j: i64 = 0; j < dep_cfg.source_paths.length(); j++) {
            outcome.roots.push(DepRoot {
                path: base.join(dep_cfg.source_paths[j]).into_raw(),
                name: name,
                package: String::from_str(package),
                library: false,
            });
        }
    }
}
