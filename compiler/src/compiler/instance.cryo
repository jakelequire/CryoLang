/// Compiler Instance
///
/// Thin orchestrator that creates a CompilationContext with the right
/// CompileMode, builds the appropriate PassRegistry pipeline, validates
/// it, and runs it.  Every entry point follows the same flow:
///   create context -> build pipeline -> validate -> run -> return result
///
/// Mode-specific behavior comes from CompileMode policy methods queried
/// by individual passes, not from flags on this struct.

namespace Compiler::Instance;


import Compiler::CompileMode;
import Compiler::CompilationContext;
import Compiler::Diag;
import Compiler::Diag::Diagnostic;
import Compiler::Artifacts;
import Compiler::Passes::PassID;
import Compiler::Passes::PassRegistry;
import Compiler::ModuleGraph;
import Compiler::ModuleLoader;
import Compiler::ProjectConfig;
import Compiler::BuildManifest;
import Compiler::DepsResolver;
import Compiler::Codegen;
import Compiler::Codegen::LLVMTypes;
import Compiler::Codegen::TestMainCodegen;
import Compiler::Codegen::TypeMap;
import Compiler::Lex;
import Compiler::Lex::Lexer;
import Compiler::AST::Node;
import Compiler::AST::Dumper;
import Compiler::Resolver::InternTable;
import Compiler::Resolver::SymbolStr;
import Compiler::Resolver::MangledName;
import Utils;
import Utils::File;
import Utils::Logger;

type struct CompilerConfig {
    debug:              boolean;
    show_ast:           boolean;
    verbose_passes:     boolean;
    emit_llvm:          boolean;
    /// CLI override for project output_dir.  Empty string ("") means
    /// "use whatever the cryoconfig says".  Set from `--build-dir=...`
    /// in cmd_project.  Lets stage 3/4 self-host runs land in distinct
    /// directories so their emitted IR/.o can be diff'd for fixed-point
    /// equivalence.
    output_dir_override: string;
    /// CLI override for the standard library root.  Empty string ("")
    /// means "use the search-order fallback chain".  Set from
    /// `--stdlib=PATH`.  Takes priority over `$CRYO_STDLIB` and every
    /// implicit candidate path.
    stdlib_path_override: string;
    /// `cryo test` build flag.  When true, `compile_project` runs in
    /// `CompileMode::Test`: src/ + tests/ are both compiled, the user's
    /// `main` is suppressed, and a synthesized test main drives every
    /// `![test]` function through `std::test::runner::run_all`.  The
    /// produced executable lands at `<output_dir>/bin/<name>-test`.
    test_mode:           boolean;
    /// CLI override for the codegen target triple (`--target=TRIPLE`).
    /// Empty string ("") means "fall back to cryoconfig's `target` key,
    /// then to the host triple from LLVM".  Takes priority over the
    /// cryoconfig value so a single project config can be cross-compiled
    /// to multiple targets without editing the file.
    target_triple_override: string;
    /// Single-file `-o PATH` / `--output PATH` override.  Empty string
    /// ("") keeps the legacy `build/obj/<module>.o` layout.  Output
    /// kind is inferred from the path extension into `output_kind`
    /// so codegen can branch without re-parsing.
    output_path_override: string;
    /// Output kind for single-file `-o PATH`.  `OutputKind::None`
    /// keeps the legacy emission path; the other variants pick the
    /// emit-to-file mode in codegen (Asm/Object) or trigger the
    /// IR-text dump / `cc` link flow (IRText/Exe).
    output_kind:         OutputKind;
    /// CLI override for the LLVM optimization level (`--opt-level=N`,
    /// 0..3). `-1` means "unset" => fall back to cryoconfig `[compiler]
    /// optimize`. Takes priority over the cryoconfig value so a single
    /// project can be built optimized or debuggable without editing the
    /// file. Read in `compile_project_with_ctx`.
    opt_level_override:  i32;
    /// `-g` / `--debug-info`: emit DWARF debug info (source file/line +
    /// per-function scopes) so gdb/lldb can show file:line backtraces.
    /// Opt-in; default off. Independent of the optimization level (a
    /// `-g -O2` build still carries line info, just with optimized code).
    emit_debug_info:     boolean;
    /// CLI override for the build profile (`--release` / `--dev` /
    /// `--profile=NAME`). Empty string ("") means "use the cryoconfig
    /// `[profile] default`, then the built-in `release`". The selected
    /// profile names the per-profile cache subtree and supplies the default
    /// optimization level / debug-info state.
    profile_override:    string;
    /// Incremental build short-circuit. When true (default), a build whose
    /// inputs fingerprint matches the saved one and whose artifacts still
    /// exist is skipped, and a build manifest + fingerprint sidecar are
    /// written on success. `--no-incremental` turns this off for a full,
    /// reproducible build; selfhost-check passes it so every stage rebuilds
    /// and the stage-3/stage-4 IR comparison stays meaningful.
    incremental:         boolean;

    static default() -> CompilerConfig {
        return CompilerConfig {
            debug:               false,
            show_ast:            false,
            verbose_passes:      false,
            emit_llvm:           false,
            output_dir_override: "",
            stdlib_path_override: "",
            test_mode:           false,
            target_triple_override: "",
            output_path_override: "",
            output_kind:         OutputKind::None,
            opt_level_override:  -1,
            emit_debug_info:     false,
            profile_override:    "",
            incremental:         true,
        };
    }

    static debug_config() -> CompilerConfig {
        return CompilerConfig {
            debug:               true,
            show_ast:            true,
            verbose_passes:      true,
            emit_llvm:           false,
            output_dir_override: "",
            stdlib_path_override: "",
            test_mode:           false,
            target_triple_override: "",
            output_path_override: "",
            output_kind:         OutputKind::None,
            opt_level_override:  -1,
            emit_debug_info:     false,
            profile_override:    "",
            incremental:         true,
        };
    }
}


type struct CompilationResult {
    success:       boolean;
    error_count:   u32;
    warning_count: u32;
    output_path:   string;
    /// The stdlib root this build resolved (possibly relative). Surfaced
    /// so `cryo test` can export it as `$CRYO_STDLIB` for the test
    /// runtime's compile-fail helpers. Empty for `--no-std` builds.
    stdlib_root:   string;

    static ok(output_path: string) -> CompilationResult {
        return CompilationResult {
            success:       true,
            error_count:   0,
            warning_count: 0,
            output_path:   output_path,
            stdlib_root:   "",
        };
    }

    static ok_with_warnings(output_path: string, warnings: u32) -> CompilationResult {
        return CompilationResult {
            success:       true,
            error_count:   0,
            warning_count: warnings,
            output_path:   output_path,
            stdlib_root:   "",
        };
    }

    static failed(errors: u32, warnings: u32) -> CompilationResult {
        return CompilationResult {
            success:       false,
            error_count:   errors,
            warning_count: warnings,
            output_path:   "",
            stdlib_root:   "",
        };
    }
}


// Stdlib root resolution
//
// Search order, first hit wins:
//   0. --stdlib=PATH                      - CLI override (highest priority)
//   1. $CRYO_STDLIB                       - explicit stdlib pointer (env)
//   2. $CRYO_HOME/stdlib                  - install-root pointer (env)
//   3. $CRYO_HOME/share/cryo/stdlib       - FHS layout under install root
//   4. <bindir>/../stdlib                 - in-repo + symlink installs
//   5. <bindir>/../share/cryo/stdlib      - FHS-style system install
//   6. <cryoconfig stdlib_root>           - project-pinned (relative or abs)
//   7. <project_root>/../stdlib           - legacy: project-relative
//   8. ../stdlib                          - legacy: cwd-relative
//
// (2)/(3) are the recommended cross-platform mechanism: `install.sh`
// writes `CRYO_HOME` into the user's shell rc, and every install (Linux,
// macOS, other) finds the stdlib without needing `/proc/self/exe`.
// (4)/(5) read /proc/self/exe so an existing in-tree or symlink install
// (`/usr/local/bin/cryo` -> `<repo>/bin/cryo`) resolves to the repo's
// stdlib without any env var (Linux only; on non-Linux the readlink
// fails and we fall through to the cryoconfig / legacy candidates).
// (6) is for projects that vendor a custom stdlib or pin a version.
//
// Relative `cryoconfig stdlib_root` values are resolved against the
// project root so `stdlib_root = "../stdlib"` does the obvious thing.
//
// `tried_out` accumulates the candidate paths that were probed and
// rejected; the caller renders these in a hard-error diagnostic when
// resolution fails so users see exactly where the compiler looked.

function resolve_stdlib_root(cli_override: string,
                             cryoconfig_override: string,
                             project_root: string,
                             tried_out: string[]*) -> string {
    // 0. CLI override.
    if (intrinsics::strlen(cli_override) > 0) {
        if (File::exists(cli_override + "/lib.cryo")) {
            return cli_override;
        }
        if (tried_out != null) {
            tried_out.push(format("%s  (--stdlib)", cli_override));
        }
    }

    // 1. Explicit env var.
    const env_raw: i8* = intrinsics::getenv("CRYO_STDLIB") as i8*;
    if (env_raw != null) {
        const env_path: string = env_raw as string;
        if (File::exists(env_path + "/lib.cryo")) {
            return env_path;
        }
        if (tried_out != null) {
            tried_out.push(format("%s  ($CRYO_STDLIB)", env_path));
        }
    }

    // 2. + 3. Install-root env var.  install.sh writes CRYO_HOME into
    // the user's shell rc; the stdlib lives under it at either
    // `<CRYO_HOME>/stdlib` (the simple layout install.sh creates today)
    // or `<CRYO_HOME>/share/cryo/stdlib` (FHS layout, in case packagers
    // pick that).  Cross-platform; does not depend on /proc/self/exe.
    const home_raw: i8* = intrinsics::getenv("CRYO_HOME") as i8*;
    if (home_raw != null) {
        const home_path: string = home_raw as string;
        const cand_home_simple: string = home_path + "/stdlib";
        if (File::exists(cand_home_simple + "/lib.cryo")) {
            return cand_home_simple;
        }
        if (tried_out != null) {
            tried_out.push(format("%s  ($CRYO_HOME/stdlib)", cand_home_simple));
        }
        const cand_home_share: string = home_path + "/share/cryo/stdlib";
        if (File::exists(cand_home_share + "/lib.cryo")) {
            return cand_home_share;
        }
        if (tried_out != null) {
            tried_out.push(format("%s  ($CRYO_HOME/share/cryo/stdlib)", cand_home_share));
        }
    }

    // 4. + 5. Binary-relative via /proc/self/exe.  Single 4 KiB scratch
    // buffer is leaked once per compile; same pattern as the path
    // concatenations below, and only happens once per `cryo build`.
    mut exe_buf: i8* = intrinsics::malloc(4096) as i8*;
    const exe_len: i64 = intrinsics::readlink("/proc/self/exe", exe_buf, 4096);
    if (exe_len > 0 && exe_len < 4096) {
        exe_buf[exe_len as u64] = 0;
        const exe_path: string = exe_buf as string;
        // dirname: walk back to the final '/'.
        mut dir_end: u64 = (exe_len - 1) as u64;
        while (dir_end > 0) {
            if (exe_path[dir_end] == '/') { break; }
            dir_end -= 1;
        }
        if (dir_end > 0) {
            exe_buf[dir_end] = 0;
            const bindir: string = exe_buf as string;
            const cand_repo: string = bindir + "/../stdlib";
            if (File::exists(cand_repo + "/lib.cryo")) {
                return cand_repo;
            }
            if (tried_out != null) {
                tried_out.push(format("%s  (binary-relative)", cand_repo));
            }
            const cand_sys: string = bindir + "/../share/cryo/stdlib";
            if (File::exists(cand_sys + "/lib.cryo")) {
                return cand_sys;
            }
            if (tried_out != null) {
                tried_out.push(format("%s  (binary-relative share)", cand_sys));
            }
        }
    }

    // 6. cryoconfig `[project] stdlib_root`.  Absolute paths used as-is;
    // relative paths resolved against project_root so a project nested
    // anywhere in the filesystem can still reach a sibling stdlib via
    // `stdlib_root = "../shared-stdlib"`.
    if (intrinsics::strlen(cryoconfig_override) > 0) {
        mut cand_cfg: string = cryoconfig_override;
        if (cryoconfig_override[0] != '/' && intrinsics::strlen(project_root) > 0) {
            cand_cfg = project_root + "/" + cryoconfig_override;
        }
        if (File::exists(cand_cfg + "/lib.cryo")) {
            return cand_cfg;
        }
        if (tried_out != null) {
            tried_out.push(format("%s  ([project] stdlib_root)", cand_cfg));
        }
    }

    // 7. <project_root>/../stdlib
    const cand_proj: string = project_root + "/../stdlib";
    if (File::exists(cand_proj + "/lib.cryo")) {
        return cand_proj;
    }
    if (tried_out != null) {
        tried_out.push(format("%s  (project-relative)", cand_proj));
    }
    // 8. ../stdlib (cwd-relative)
    if (File::exists("../stdlib/lib.cryo")) {
        return "../stdlib";
    }
    if (tried_out != null) {
        tried_out.push("../stdlib  (cwd-relative)");
    }
    return "";
}


/// Path to the lockfile next to a given cryoconfig.
function lock_path_for(consumer_root: string) -> string {
    if (intrinsics::strlen(consumer_root) == 0 || intrinsics::strcmp(consumer_root, ".") == 0) {
        return "cryoconfig.lock";
    }
    return format("%s/cryoconfig.lock", consumer_root);
}

/// Build a ProjectConfig view that compiles the `[lib]` half of a
/// multi-target project as a Library.  Inherits debug/optimize/no_std/
/// stdlib + linkage settings from the base config; overrides only the
/// fields that select what to compile and what to name the output.
function make_lib_view(base: ProjectConfig) -> ProjectConfig {
    mut view: ProjectConfig = base;
    view.target_type  = TargetType::Library;
    // Read through `view` (a full copy of `base`) rather than `base`, which
    // was just moved into `view` - keeps `make_lib_view` move-clean.
    view.project_name = view.lib.name;
    view.source_dir   = view.lib.source_dir;
    return view;
}

/// Build a ProjectConfig view that compiles a single `[[bin]]` entry
/// as an Executable.  As with `make_lib_view`, inherits everything
/// other than what selects the entry point and names the output.
function make_bin_view(base: ProjectConfig, bin: BinTarget) -> ProjectConfig {
    mut view: ProjectConfig = base;
    view.target_type  = TargetType::Executable;
    view.project_name = bin.name;
    view.entry_point  = bin.entry_point;
    return view;
}


type struct CompilerInstance {
    config: CompilerConfig;

    static new(config: CompilerConfig) -> CompilerInstance {
        return CompilerInstance {
            config: config,
        };
    }

    // Shared pipeline orchestration

    /// Run a pipeline on a context, handling AST dump, diagnostics, and
    /// result construction.  All single-file compile_* methods delegate here.
    run_pipeline(&this, ctx: CompilationContext*, pipeline: PassRegistry*,
                 output_path: string) -> CompilationResult {
        pipeline.set_verbose(this.config.verbose_passes);

        if (!pipeline.validate()) {
            LOG_DEBUG(LogComponent::General, "[Compiler] Pipeline validation FAILED");
            return CompilationResult::failed(1, 0);
        }

        const success: boolean = pipeline.run_all(ctx);

        // Write .ll text file when --emit-llvm is set (single-file mode).
        if (this.config.emit_llvm && ctx.artifacts.ir.is_valid()) {
            const ll_path: string = format("%s.ll", output_path);
            mut ll_err: i8* = null;
            const ll_ok: i32 = llvm::LLVMPrintModuleToFile(
                ctx.artifacts.ir.llvm_module, ll_path, &ll_err as void*);
            if (ll_ok == 0) {
                intrinsics::fprintf(g_stderr,
                    "[Compiler] LLVM IR emitted: %s\n", ll_path);
            } else if (ll_err != null) {
                intrinsics::fprintf(g_stderr,
                    "warning: failed to write %s: %s\n",
                    ll_path, ll_err as string);
                llvm::LLVMDisposeMessage(ll_err as void*);
            }
        }

        // Dump AST if --ast was requested
        if (this.config.show_ast && ctx.artifacts.ast.is_valid()) {
            const ast_root: ProgramNode* = ctx.artifacts.ast.root;
            ASTDumper::dump(ast_root, ctx.intern_table);
        }

        // Print diagnostic summary when ANY diagnostic was emitted (errors
        // or warnings) or in debug mode.  Without flushing on warnings,
        // codegen warnings about silently-dropped function bodies (e.g.
        // missing LLVM declarations for cross-module trait impls) are
        // collected but never rendered, so the user sees a green build
        // followed by `undefined reference` link-time failures.
        //
        // LSP mode: skip the terminal-rendered output entirely.  The
        // language server consumes `ctx.diagnostics.diagnostics`
        // directly and emits them as JSON over stdout; an extra render
        // to stderr would (a) try to read source from disk via the
        // diag span's `file:` URI path and (b) print colour codes that
        // confuse the editor's log capture.
        const skip_flush: boolean = match (ctx.mode) {
            CompileMode::Lsp => { true }
            _                => { false }
        };
        if (!skip_flush
                && (ctx.diagnostics.has_errors()
                    || ctx.diagnostics.has_warnings()
                    || this.config.debug)) {
            ctx.diagnostics.flush();
            if (ctx.diag_renderer != null) {
                ctx.diag_renderer.print_summary(
                    ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
            }
        }

        if (this.config.debug) {
            // const r: Resolver * = ctx.get_resolver();
            // if (r != null) { r.debug_dump(); }
            ctx.type_arena.debug_dump();
        }

        LOG_DEBUG(LogComponent::General, "[Compiler] Finished: %s (%u errors, %u warnings)",
            ctx.source_file, ctx.diagnostics.error_count, ctx.diagnostics.warning_count);

        if (success) {
            return CompilationResult::ok_with_warnings(
                output_path, ctx.diagnostics.warning_count);
        }
        return CompilationResult::failed(
            ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
    }


    /// Compile a single source file with stdlib linking and prelude.
    compile_file(&this, source: string) -> CompilationResult {
        LOG_DEBUG(LogComponent::General, "[Compiler] compile_file: %s", source);
        if (this.config.debug) {
            LOG_DEBUG(LogComponent::General, "[Compiler] Compiling: %s (mode: single-file)", source);
        }

        if (!File::exists(source)) {
            LOG_DEBUG(LogComponent::General, "[Compiler] Error: File not found: %s", source);
            return CompilationResult::failed(1, 0);
        }

        mut ctx: CompilationContext = CompilationContext::new(CompileMode::SingleFile, source);
        ctx.debug_mode = this.config.debug;
        // Single-file has no cryoconfig; honor a `--opt-level=N` override
        // when present, otherwise keep the default O2 (ctx.opt_level == 2).
        if (this.config.opt_level_override >= 0) {
            mut lvl: i32 = this.config.opt_level_override;
            if (lvl > 3) { lvl = 3; }
            ctx.opt_level = lvl as u32;
        }
        ctx.emit_debug_info = this.config.emit_debug_info;
        ctx.target_triple = this.config.target_triple_override;
        ctx.output_path_override = this.config.output_path_override;
        ctx.output_kind          = this.config.output_kind;
        // Resolve stdlib root so the Linking pass can find libcryo.a
        // when single-file Exe (`-o foo`) shells out to `cc`.  Failure
        // to resolve isn't fatal here; non-Exe single-file output
        // (object/asm/IR text) doesn't link at all, and Exe will only
        // fail at link time if the program actually references stdlib
        // symbols.
        mut tried: string[] = [];
        // Single-file mode: no cryoconfig, so the cryoconfig override is empty.
        ctx.stdlib_root = resolve_stdlib_root(this.config.stdlib_path_override, "", "", &tried);
        mut pipeline: PassRegistry = PassRegistry::build_standard_pipeline();
        return this.run_pipeline(&ctx, &pipeline, ctx.artifacts.linked.object_file_path);
    }

    /// Compile a single source file in raw mode (no stdlib, no prelude).
    compile_raw(&this, source: string) -> CompilationResult {
        if (this.config.debug) {
            LOG_DEBUG(LogComponent::General, "[Compiler] Compiling: %s (mode: raw)", source);
        }

        if (!File::exists(source)) {
            LOG_DEBUG(LogComponent::General, "[Compiler] Error: File not found: %s", source);
            return CompilationResult::failed(1, 0);
        }

        mut ctx: CompilationContext = CompilationContext::new(CompileMode::Raw, source);
        ctx.debug_mode = this.config.debug;
        ctx.target_triple = this.config.target_triple_override;
        ctx.output_path_override = this.config.output_path_override;
        ctx.output_kind          = this.config.output_kind;
        mut pipeline: PassRegistry = PassRegistry::build_raw_pipeline();
        return this.run_pipeline(&ctx, &pipeline, ctx.artifacts.linked.object_file_path);
    }

    /// Compile for `cryo check`: frontend + semantic analysis, no codegen,
    /// but with normal diagnostic flush so the user sees warnings/errors.
    /// `compile_for_lsp` cannot serve this path because `CompileMode::Lsp`
    /// suppresses the end-of-pipeline flush (the LSP surfaces diagnostics
    /// via JSON-RPC instead), which made `cryo check` silently swallow
    /// every warning including the unknown-directive warning.
    compile_for_check(&this, source: string) -> CompilationResult {
        if (!File::exists(source)) {
            intrinsics::fprintf(g_stderr,
                "error: file not found: %s\n", source);
            return CompilationResult::failed(1, 0);
        }

        mut ctx: CompilationContext = CompilationContext::new(CompileMode::SingleFile, source);
        ctx.debug_mode = this.config.debug;
        mut tried: string[] = [];
        ctx.stdlib_root = resolve_stdlib_root(this.config.stdlib_path_override, "", "", &tried);
        mut pipeline: PassRegistry = PassRegistry::build_frontend_pipeline();
        return this.run_pipeline(&ctx, &pipeline, "");
    }

    /// Compile for LSP: frontend + semantic analysis, no codegen.
    compile_for_lsp(&this, source: string) -> CompilationResult {
        if (!File::exists(source)) {
            return CompilationResult::failed(1, 0);
        }

        MangledName::set_lsp_safe(true);
        mut ctx: CompilationContext = CompilationContext::new(CompileMode::Lsp, source);
        mut pipeline: PassRegistry = PassRegistry::build_frontend_pipeline();
        return this.run_pipeline(&ctx, &pipeline, "");
    }

    /// Compile for LSP from in-memory content (no file on disk).
    compile_for_lsp_content(&this, virtual_path: string, content: string) -> CompilationResult {
        MangledName::set_lsp_safe(true);
        mut ctx: CompilationContext = CompilationContext::new(CompileMode::Lsp, virtual_path);
        ctx.artifacts.tokens = TokenStream::new([], virtual_path, content);
        mut pipeline: PassRegistry = PassRegistry::build_frontend_pipeline();
        return this.run_pipeline(&ctx, &pipeline, "");
    }

    /// Compile for LSP into a caller-owned context.
    /// Single-file mode: parses + type-checks just the one file the
    /// editor is showing, with no project context.  Cross-file
    /// references resolve to invalid TypeRefs; in LSP-safe mode the
    /// mangler emits a poison sentinel instead of panicking, so this
    /// path can run post-NameResolution passes without crashing the
    /// daemon.  Used as a fallback when we can't find a cryoconfig.
    /// For real diagnostics, route through `compile_for_lsp_project_into`.
    compile_for_lsp_content_into(&this, ctx: CompilationContext*,
                                 virtual_path: string, content: string) -> CompilationResult {
        MangledName::set_lsp_safe(true);
        // Same risk as the multi-target build path: TypeArena.next_id
        // resets every compile, so without clearing the (TypeRef.id ->
        // LLVMTypeRef) cache between LSP recompiles every fresh TypeRef
        // would alias a stale entry from a prior keystroke's compile.
        Compiler::Codegen::TypeMap::reset_shared_type_cache();
        ctx.artifacts.tokens = TokenStream::new([], virtual_path, content);
        mut pipeline: PassRegistry = PassRegistry::build_frontend_pipeline();
        return this.run_pipeline(ctx, &pipeline, "");
    }

    /// Compile a whole project for the LSP, with one module's source
    /// overridden by the editor buffer.  Discovers every `.cryo` in
    /// the project (per the cryoconfig at `config_path`), parses and
    /// type-checks the lot, but reads `override_path`'s content from
    /// `override_content` instead of the file on disk.
    ///
    /// The resulting `CompilationContext` has the same populated AST,
    /// resolver, type arena, and decl index that a real build would
    /// The LSP uses this for diagnostics, hover, go-to-def, and
    /// completion.  Codegen is gated off via `CompileMode::Lsp` so
    /// no LLVM IR is emitted; everything stops cleanly at TypeLowering.
    compile_for_lsp_project_into(&this, ctx: CompilationContext*,
                                 config_path: string,
                                 override_path: string,
                                 override_content: string) -> CompilationResult {
        MangledName::set_lsp_safe(true);
        ctx.lsp_override_path    = override_path;
        ctx.lsp_override_content = override_content;
        mut config: ProjectConfig = ProjectConfig::parse(config_path);
        if (this.config.output_dir_override != ""
                && intrinsics::strlen(this.config.output_dir_override) > 0) {
            config.output_dir = this.config.output_dir_override;
        }
        if (this.config.target_triple_override != ""
                && intrinsics::strlen(this.config.target_triple_override) > 0) {
            config.target_triple = this.config.target_triple_override;
        }
        // Multi-target projects ([lib] + [[bin]]) need a single view
        // picked: the orchestrator only handles one target at a time
        // and `compile_project_multi` builds them in sequence.  The
        // LSP picks the view whose discovery graph actually reaches
        // the file the user is editing; picking the lib unconditionally
        // would miss bin entry points (e.g. `src/main.cryo`) that no
        // module under the lib's `_module.cryo` imports.
        //
        // Heuristic:
        //   1. If override matches a `[[bin]]` entry_point, use that bin view.
        //   2. Else if a `[lib]` is present, use the lib view.
        //   3. Else use the first `[[bin]]`.
        // Single-target configs fall through unchanged.
        if (config.is_multi_target()) {
            mut chosen: int = -1;
            for (mut bi: int = 0; bi < config.bins.length; bi++) {
                const bin_full: string = format("%s/%s",
                    config.project_root, config.bins[bi].entry_point);
                if (intrinsics::strcmp(bin_full, override_path) == 0) {
                    chosen = bi;
                    break;
                }
            }
            if (chosen >= 0) {
                // BinTarget is Copy; pull the selection out before `config`
                // is moved into make_bin_view so the read isn't after-move.
                const sel: BinTarget = config.bins[chosen];
                config = make_bin_view(config, sel);
            } else if (config.lib.is_present()) {
                config = make_lib_view(config);
            } else if (config.bins.length > 0) {
                const sel: BinTarget = config.bins[0];
                config = make_bin_view(config, sel);
            }
        }
        return this.compile_project_with_ctx(ctx, config);
    }

    /// Switch to a module AND load its AST from the local buffers.
    /// Also restores the saved resolver scope if available.
    static load_module(ctx: CompilationContext*, intern: InternTable*,
                       ast_buf: void*, mod_idx: u32, mod_count: u32) -> void {
        // Set source file, namespace, resolver module
        ctx.switch_to_module(mod_idx as i64);
        // Load AST from local buffer
        if (ast_buf != null && mod_idx < mod_count) {
            const slot: void** = intrinsics::ptr_add(ast_buf, (mod_idx * 8) as i64) as void**;
            const ast: ProgramNode* = *slot as ProgramNode*;
            if (ast != null) {
                // Borrow the stored ModuleInfo; a value copy would shallow-alias
                // its owning arrays and double-free them at scope exit.
                const info: ModuleInfo* = &ctx.module_graph.modules[mod_idx];
                const ns: string = intern.resolve(info.namespace_name);
                ctx.artifacts.ast = ASTOutput {
                    root: ast,
                    namespace_name: ns,
                };
            }
        }
    }

    /// Like load_module but also restores saved scope from scope_buf.
    static load_module_with_scope(ctx: CompilationContext*, intern: InternTable*,
                                   ast_buf: void*, scope_buf: void*,
                                   mod_idx: u32, mod_count: u32) -> void {
        CompilerInstance::load_module(ctx, intern, ast_buf, mod_idx, mod_count);
        // Restore saved scope
        if (scope_buf != null && mod_idx < mod_count && ctx.resolver != null) {
            const sc_slot: u64* = intrinsics::ptr_add(scope_buf, (mod_idx * 8) as i64) as u64*;
            const saved_scope: u64 = *sc_slot;
            if (saved_scope > 0) {
                const info: ModuleInfo* = &ctx.module_graph.modules[mod_idx];
                ctx.resolver.set_module_with_scope(info.name, saved_scope);
            }
        }
    }

    /// Compile a multi-module project using whole-program multi-pass.
    /// Parses cryoconfig, discovers all modules, then runs each pipeline
    /// stage across ALL modules before advancing to the next stage.
    compile_project(&this, config_path: string) -> CompilationResult {
        LOG_DEBUG(LogComponent::General, "[Compiler] compile_project: %s", config_path);

        // Phase 0: Parse project configuration
        mut config: ProjectConfig = ProjectConfig::parse(config_path);
        if (config.error_count > 0) {
            // ProjectConfig::parse already wrote diagnostics to stderr;
            // bail before any module discovery / codegen runs against
            // a half-validated config.
            return CompilationResult::failed(config.error_count as u32, 0);
        }
        // CLI `--build-dir=PATH` overrides the cryoconfig output_dir
        // before any consumer (codegen .ll/.o paths, link bin path)
        // reads it.  Required for self-host fixed-point testing
        // (S3 -> S4 vs S4 -> S5) where each stage needs its own output tree.
        if (this.config.output_dir_override != ""
                && intrinsics::strlen(this.config.output_dir_override) > 0) {
            config.output_dir = this.config.output_dir_override;
        }
        // CLI `--target=TRIPLE` overrides the cryoconfig `target` key.
        // Empty string in either slot means "build for the host".
        if (this.config.target_triple_override != ""
                && intrinsics::strlen(this.config.target_triple_override) > 0) {
            config.target_triple = this.config.target_triple_override;
        }

        // Mirror cryoconfig `debug = true` into the global compiler debug
        // gate so the [Tag] trace printfs fire.  Only flips it ON; CLI
        // `--debug` already turned it on if present, and we don't want
        // `debug = false` in cryoconfig to override that.
        if (config.debug) {
            set_compiler_debug(true);
        }

        // Multi-target projects ([lib] and/or [[bin]]) build each output
        // in sequence in this process.  CodegenContext, TypeArena, and
        // the codegen-side g_shared_type_cache are reset between
        // targets so state from the prior compile doesn't leak into
        // the next.
        if (config.is_multi_target()) {
            return this.compile_project_multi(config);
        }
        return this.compile_project_with_config(config);
    }

    /// Drive a multi-target build: the [lib] (when present) followed by
    /// each [[bin]] in declaration order.  Stops at the first failure.
    /// Returns the last bin's output path so `cryo run` works against
    /// the trailing executable.
    compile_project_multi(&this, base: ProjectConfig) -> CompilationResult {
        // In-process iteration: each target gets its own
        // CompilationContext, and the codegen-side `g_shared_type_cache`
        // is cleared at the top of compile_project_with_config.  That
        // cache is the only meaningful process-global state with a
        // TypeRef.id key; without resetting it, the second target gets
        // back the first target's stale LLVMTypeRef and crashes during
        // IRGen on the first generic instantiation it tries to map.
        mut last_output: string = "";

        if (base.lib.is_present()) {
            cdebug("[Compiler] Multi-target: building lib '%s' from %s\n",
                base.lib.name, base.lib.source_dir);
            // Clone so `base` survives for the per-bin views below.
            const lib_view: ProjectConfig = make_lib_view(base.clone());
            const r: CompilationResult = this.compile_project_with_config(lib_view);
            if (!r.success) { return r; }
        }

        for (mut i: int = 0; i < base.bins.length; i++) {
            cdebug("[Compiler] Multi-target: building bin '%s' from %s\n",
                base.bins[i].name, base.bins[i].entry_point);
            // Clone `base` per iteration; make_bin_view consumes its first arg.
            const sel: BinTarget = base.bins[i];
            const bin_view: ProjectConfig = make_bin_view(base.clone(), sel);
            const r: CompilationResult = this.compile_project_with_config(bin_view);
            if (!r.success) { return r; }
            if (intrinsics::strlen(r.output_path) > 0) { last_output = r.output_path; }
        }

        return CompilationResult::ok(last_output);
    }

    /// Compile a single target view of a project.  Shared between the
    /// legacy single-target path and each iteration of
    /// `compile_project_multi`.
    compile_project_with_config(&this, config: ProjectConfig) -> CompilationResult {
        const root_path: string = config.discovery_root_path();

        cdebug("[Compiler] Project: %s (target: %s, root: %s, no_std: %d)\n",
            config.project_name, config.target_type.label(), root_path, config.no_std as int);

        if (!File::exists(root_path)) {
            // Route to stderr: stdout in LSP mode owns the JSON-RPC stream;
            // any stray byte desynchronises Content-Length framing.  These
            // fire before a CompilationContext exists, so we can't route
            // through ctx.diagnostics yet.
            if (config.requires_entry_point()) {
                intrinsics::fprintf(g_stderr,
                    "error: entry point not found: %s\n", root_path);
            } else {
                intrinsics::fprintf(g_stderr,
                    "error: library root not found: %s\n", root_path);
                intrinsics::fprintf(g_stderr,
                    "  expected lib.cryo in source_dir '%s'\n", config.source_dir);
            }
            return CompilationResult::failed(1, 0);
        }

        // Phase 1: Create context and discover modules
        // Select compile mode based on target type, with a `cryo test`
        // override:
        //   --test (any executable) -> Test         (suppresses user main,
        //                                           synthesizes test main)
        //   Executable              -> MultiModule  (auto-imports, stdlib
        //                                           linking, main transform)
        //   Library                 -> MultiModule  (auto-imports, stdlib
        //                                           linking, no main transform)
        //   Stdlib                  -> StdlibBatch  (no auto-imports, no
        //                                           stdlib linking, no main
        //                                           transform)
        const mode: CompileMode = if (this.config.test_mode
                                       && config.requires_entry_point()) {
            CompileMode::Test
        } else {
            match (config.target_type) {
                TargetType::Stdlib  => { CompileMode::StdlibBatch }
                _                   => { CompileMode::MultiModule }
            }
        };
        // Heap-allocate CompilationContext to avoid stack overflow.
        // The struct is very large (InternTable, ModuleGraph, DiagnosticSink, etc.)
        // and keeping it on the stack alongside phase locals exhausts the default 8MB limit.
        const _box_ctx: Box<CompilationContext> = Box<CompilationContext>::new(
            CompilationContext::new(mode, root_path));
        mut ctx: CompilationContext* = _box_ctx.leak();
        return this.compile_project_with_ctx(ctx, config);
    }

    /// Drive the multi-module orchestration against a caller-provided
    /// context.  Lets the language server compile the whole project
    /// (every module, every phase) while keeping the resulting `ctx`
    /// alive afterwards so hover / definition / completion handlers
    /// can walk the populated AST + resolver + type arena.
    ///
    /// The caller is responsible for:
    ///   - Allocating `ctx` (heap, via `Box::leak`) with the correct
    ///     `CompileMode`: `Lsp` for the language server entry,
    ///     whatever `compile_project_with_config` picks for CLI builds.
    ///   - Setting `ctx.lsp_override_path` + `ctx.lsp_override_content`
    ///     before this call when the editor buffer should win over
    ///     the on-disk version of one of the discovered modules.
    compile_project_with_ctx(&this, ctx: CompilationContext*,
                             mut config: ProjectConfig) -> CompilationResult {
        // Drop any cached (TypeRef.id -> LLVMTypeRef) entries from a prior
        // compile in this process.  TypeArena.next_id resets to 1 every
        // compile, so without this every fresh TypeRef would alias a
        // stale cache entry from the previous run.
        Compiler::Codegen::TypeMap::reset_shared_type_cache();

        const root_path: string = config.discovery_root_path();
        ctx.debug_mode = this.config.debug;

        // Resolve the build profile. Precedence: CLI `--release`/`--dev`/
        // `--profile=NAME` > cryoconfig `[profile] default` > built-in
        // `release`. The selected name flows into `config.profile` BEFORE the
        // clone below, so the per-profile cache subtree
        // (`<output_dir>/.cryo/<profile>/`) is consistent across codegen,
        // linking, and the manifest.
        if (intrinsics::strlen(this.config.profile_override) > 0) {
            config.profile = this.config.profile_override;
        }

        // Optimization level. Base comes from the profile (debug => O0,
        // release => O2); an explicit `[compiler] optimize` wins over the
        // profile, and `--opt-level=N` wins over everything.
        ctx.opt_level = ProjectConfig::profile_base_opt_level(config.profile);
        if (config.opt_level_explicit) {
            ctx.opt_level = config.opt_level;
        }
        if (this.config.opt_level_override >= 0) {
            mut lvl: i32 = this.config.opt_level_override;
            if (lvl > 3) { lvl = 3; }
            ctx.opt_level = lvl as u32;
        }
        // Debug info: base from the profile (debug => on), forced on by
        // `-g` / `--debug-info` regardless of profile.
        ctx.emit_debug_info = ProjectConfig::profile_base_debug_info(config.profile)
            || this.config.emit_debug_info;
        ctx.project_no_std = config.no_std;
        ctx.target_triple = config.target_triple;

        // Box an independent clone so the local `config` stays usable for the
        // rest of this function (stdlib resolution, dep scan, loader setup);
        // the leaked box owns the copy that lives for `ctx`'s lifetime.
        const _box_config: Box<ProjectConfig> = Box<ProjectConfig>::new(config.clone());
        ctx.set_project_config(_box_config.leak());

        // Resolve stdlib root.  See resolve_stdlib_root above for the
        // full priority chain (CLI -> $CRYO_STDLIB -> $CRYO_HOME ->
        // binary-relative -> cryoconfig stdlib_root -> legacy fallbacks).
        mut stdlib_root: string = "";
        if (!config.no_std) {
            mut tried: string[] = [];
            stdlib_root = resolve_stdlib_root(
                this.config.stdlib_path_override,
                config.stdlib_root,
                config.project_root,
                &tried);
            if (intrinsics::strlen(stdlib_root) > 0) {
                cdebug("[Compiler] Stdlib root: %s\n", stdlib_root);
            } else {
                // No prelude available: hard-fail rather than silently
                // compile a project that can't see `Result`, `String`,
                // etc.  Pass `--no-std` (or set `no_std = true` in
                // cryoconfig) for genuinely freestanding builds.
                intrinsics::fprintf(g_stderr,
                    "error: cannot locate the Cryo standard library\n");
                intrinsics::fprintf(g_stderr,
                    "  none of the candidate paths contained a 'lib.cryo':\n");
                for (mut ti: i64 = 0; ti < tried.length; ti++) {
                    intrinsics::fprintf(g_stderr, "    %s\n", tried[ti]);
                }
                intrinsics::fprintf(g_stderr,
                    "  fix one of:\n");
                intrinsics::fprintf(g_stderr,
                    "    --stdlib=PATH                            (one-off override)\n");
                intrinsics::fprintf(g_stderr,
                    "    export CRYO_STDLIB=/path/to/stdlib       (explicit env)\n");
                intrinsics::fprintf(g_stderr,
                    "    export CRYO_HOME=/path/to/install        (install root; stdlib at $CRYO_HOME/stdlib)\n");
                intrinsics::fprintf(g_stderr,
                    "    [project] stdlib_root = \"...\"            (in cryoconfig; relative to project_root)\n");
                intrinsics::fprintf(g_stderr,
                    "    --no-std                                 (build without the standard library)\n");
                return CompilationResult::failed(1, 0);
            }
        }
        ctx.stdlib_root = stdlib_root;

        // Effective scan roots = own [project].source_paths, then a
        // resolved view of each [dependencies] entry's source roots.
        // The loader appends each to project_root and pre-scans them so
        // imports targeting the dep's namespaces resolve.
        mut effective_roots: string[] = [];
        for (mut ip: int = 0; ip < config.source_paths.length; ip++) {
            effective_roots.push(config.source_paths[ip]);
        }
        // Build mode: read the lockfile, materialize any missing git
        // checkouts, harvest source roots.  Failure here means the user
        // hasn't run `cryo fetch` yet (or the lockfile is stale relative
        // to cryoconfig); we surface a hard error rather than dropping
        // dep roots and reporting confusing "namespace not found"
        // diagnostics later.
        const lock_path: string = lock_path_for(config.project_root);
        const dep_outcome: ResolveOutcome = DepsResolver::resolve(
            &config, ResolveMode::Build, lock_path);
        if (dep_outcome.failed) {
            return CompilationResult::failed(1, 0);
        }
        for (mut dr: int = 0; dr < dep_outcome.roots.length; dr++) {
            effective_roots.push(dep_outcome.roots[dr]);
            cdebug("[Compiler] Dependency scan root: %s\n", dep_outcome.roots[dr]);
        }

        mut loader: ModuleLoader = ModuleLoader::new(
            config.project_root, root_path, stdlib_root, config.no_std,
            effective_roots);

        // LSP mode: feed the loader the editor buffer for the active
        // file so import-discovery sees the imports the user is typing
        // *now*, not whatever's on disk.  Without this, a freshly
        // typed `import std::collections::str` is invisible to the
        // discovery walk and `Str::from_cstr` fails to resolve.
        if (intrinsics::strlen(ctx.lsp_override_path) > 0) {
            loader.set_lsp_override(
                ctx.lsp_override_path, ctx.lsp_override_content);
        }

        const discovery_ok: boolean = loader.discover_project(
            ctx.intern_table, ctx.module_graph, ctx.diagnostics,
            root_path, this.config.debug);

        if (!discovery_ok) {
            // Flush deferred diagnostics so the user actually SEES the
            // reason discovery failed (E0500 module-not-found, parse
            // errors during quick-scan, etc.).  Without this, the
            // normal end-of-pipeline flush at line ~395 never runs
            // because we early-return here, and the user gets only
            // the bare "Module discovery failed" line with no
            // underlying cause.  Mode-gated like the main flush:
            // LSP mode owns stdout for JSON-RPC, so we skip rendering
            // there and let the LSP's diagnostic-publish path surface
            // the same diagnostics through `textDocument/publishDiagnostics`.
            const skip_flush_disc: boolean = match (ctx.mode) {
                CompileMode::Lsp => { true }
                _                => { false }
            };
            if (!skip_flush_disc) {
                ctx.diagnostics.flush();
                if (ctx.diag_renderer != null) {
                    ctx.diag_renderer.print_summary(
                        ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
                }
            }
            // Diagnostics carrying the actual failure reason were already
            // flushed above (gated on non-LSP mode).  This trailing marker
            // goes to stderr (never stdout) to avoid corrupting the
            // LSP JSON-RPC stream when the daemon embeds the compiler.
            intrinsics::fprintf(g_stderr, "error: module discovery failed\n");
            return CompilationResult::failed(ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
        }

        // Discover the prelude and its submodules (primitives, etc.) when
        // auto-imports are enabled.  Module discovery runs before AutoImport
        // injects the synthetic `import std::prelude`, so prelude submodules
        // wouldn't otherwise be discovered.
        if (ctx.mode.auto_imports_enabled() && !config.no_std && intrinsics::strlen(stdlib_root) > 0) {
            const prelude_path: string = stdlib_root + "/prelude.cryo";
            if (File::exists(prelude_path)) {
                loader.discover_module(
                    ctx.intern_table, ctx.module_graph, ctx.diagnostics,
                    prelude_path, this.config.debug);
            }
        }

        // `cryo test`: discover every `.cryo` file under `<project_root>/tests/`
        // as a top-level module.  Test files are leaves in the import graph
        // (nothing in `src/` imports them) so the entry-point-driven walk
        // would never reach them.  We scan first to populate `ns_map`,
        // then discover each file.  Also force-discover the runtime
        // entry points (`std::env`, `std::test::runner`) so they reach the
        // DI; the synthesized test main calls them by mangled name and
        // `lookup_mangled_name` returns invalid otherwise.
        if (ctx.mode.skip_user_main()) {
            const tests_dir: string = format("%s/tests", config.project_root);
            if (File::exists(tests_dir)) {
                loader.scan_all_project_files(tests_dir, this.config.debug);
                loader.discover_tests_directory(
                    ctx.intern_table, ctx.module_graph, ctx.diagnostics,
                    tests_dir, this.config.debug);
                cdebug("[Compiler] tests/ discovery complete from %s\n", tests_dir);
            } else {
                cdebug("[Compiler] tests/ directory not found at %s; running with no tests\n",
                    tests_dir);
            }
            if (!config.no_std && intrinsics::strlen(stdlib_root) > 0) {
                const env_path: string = format("%s/env/_module.cryo", stdlib_root);
                if (File::exists(env_path)) {
                    loader.discover_module(
                        ctx.intern_table, ctx.module_graph, ctx.diagnostics,
                        env_path, this.config.debug);
                }
                const runner_path: string = format("%s/test/runner.cryo", stdlib_root);
                if (File::exists(runner_path)) {
                    loader.discover_module(
                        ctx.intern_table, ctx.module_graph, ctx.diagnostics,
                        runner_path, this.config.debug);
                }
            }
        }

        // Force-discover the f-string runtime (std::fmt::interp), but ONLY
        // when some discovered module (entry graph, prelude, OR a test file)
        // actually uses an f-string.  Done after ALL discovery so the
        // `uses_fstring` flag reflects test files too.  It is deliberately
        // NOT in the prelude: its transitive deps (ffi::libc etc.) would
        // otherwise be pulled into every program and their globally-visible
        // C shims (`strstr`/`realpath`, which return `u8*`) would collide
        // with code using the `core::intrinsics` shims (which return `i8*`) —
        // exactly what broke the compiler's own self-build.  AutoImport
        // injects `import std::fmt::interp` into the f-string-using modules
        // for symbol visibility; this (gated on the same usage) puts the
        // module in the graph so it links, since the injection happens after
        // discovery.
        if (ctx.mode.auto_imports_enabled() && !config.no_std
                && intrinsics::strlen(stdlib_root) > 0
                && ctx.module_graph.uses_fstring) {
            const interp_path: string = stdlib_root + "/fmt/interp.cryo";
            if (File::exists(interp_path)) {
                loader.discover_module(
                    ctx.intern_table, ctx.module_graph, ctx.diagnostics,
                    interp_path, this.config.debug);
            }
        }

        cdebug("[Compiler] After discovery: module_count=%u, modules.length=%u\n",
            ctx.module_graph.module_count(), ctx.module_graph.modules.length);
        cdebug("[Compiler] name_index.length=%u\n", ctx.module_graph.name_index.length());

        if (ctx.module_graph.module_count() == 0) {
            intrinsics::fprintf(g_stderr, "error: no modules discovered\n");
            return CompilationResult::failed(1, 0);
        }

        // Compute topological order
        cdebug("[Compiler] Calling compute_order()...\n");
        if (!ctx.module_graph.compute_order()) {
            ctx.emit_error(ErrorCode::E0501_CIRCULAR_IMPORT,
                "circular module dependency detected; cannot determine compilation order");
            return CompilationResult::failed(ctx.diagnostics.error_count, 0);
        }

        const order: &u32[] = &ctx.module_graph.topo_order;
        const n: u32 = order.length as u32;

        cdebug("[Compiler] Discovered %u modules, compilation order:\n", n);
        for (mut i: u32 = 0; i < n; i++) {
            const info: ModuleInfo* = &ctx.module_graph.modules[order[i]];
            cdebug("  [%u] %s (%s)\n", i,
                ctx.intern_table.resolve(info.name), info.file_path);
        }

        // Incremental whole-build fingerprint + short-circuit.
        //
        // Build the input set (every discovered module, in topo order) and a
        // fingerprint over it + the resolved knobs + the compiler and stdlib
        // binaries. The locals persist to the manifest write at the end of a
        // successful build, so everything is computed once here.
        //
        // Gated on `incremental` (off via `--no-incremental`, which selfhost
        // passes so every stage does a full, comparable rebuild) and on
        // `codegen_enabled()` (LSP mode needs the full AST and produces no
        // artifact, so it always falls through).
        const do_incremental: boolean =
            this.config.incremental && ctx.mode.codegen_enabled();
        mut mod_entries: BuildManifest::ModuleEntry[] = [];
        mut manifest_artifacts: string[] = [];
        mut manifest_stdlib_archive: string = "";
        mut build_fp_hex: string = "";
        if (do_incremental) {
            for (mut i: u32 = 0; i < n; i++) {
                const minfo: ModuleInfo* = &ctx.module_graph.modules[order[i]];
                mod_entries.push(BuildManifest::ModuleEntry {
                    namespace_name: ctx.intern_table.resolve(minfo.name),
                    source_path:    minfo.file_path,
                });
            }
            if (!config.no_std && intrinsics::strlen(stdlib_root) > 0) {
                manifest_stdlib_archive = format("%s/.bin/libcryo.a", stdlib_root);
            }
            // Final artifact path(s) this build will produce.
            if (config.requires_entry_point()) {
                manifest_artifacts.push(
                    ctx.project_config.bin_artifact_path(ctx.mode.skip_user_main()));
            } else {
                const archive_name: string = match (config.target_type) {
                    TargetType::Stdlib => { "libcryo.a" }
                    _                  => { format("lib%s.a", config.project_name) }
                };
                manifest_artifacts.push(ctx.project_config.lib_archive_path(archive_name));
            }
            const build_fp: u64 = BuildManifest::compute_fingerprint(
                ctx.project_config, &mod_entries, ctx.opt_level,
                ctx.emit_debug_info, manifest_stdlib_archive);
            build_fp_hex = BuildManifest::u64_to_hex(build_fp);

            if (BuildManifest::is_up_to_date(ctx.project_config, build_fp_hex,
                                             &manifest_artifacts)) {
                // Nothing changed and the artifact still exists: skip
                // frontend, codegen, and linking entirely.
                const up_to_date_out: string = if (config.requires_entry_point()) {
                    manifest_artifacts[0]
                } else {
                    ""
                };
                intrinsics::printf("%s is up to date (%s)\n",
                    config.project_name, config.profile);
                mut utd_result: CompilationResult = CompilationResult::ok(up_to_date_out);
                utd_result.stdlib_root = ctx.stdlib_root;
                return utd_result;
            }
        }

        // Allocate local buffers for per-module ASTs and scopes.
        // Using local variables avoids deep nested struct field assignment
        // (ctx.module_graph.field = x) which the codegen may not persist.
        const buf_size: u64 = n as u64 * 8;
        const ast_buf: void* = intrinsics::malloc(buf_size);
        intrinsics::memset(ast_buf, 0, buf_size);
        const scope_buf: void* = intrinsics::malloc(buf_size);
        intrinsics::memset(scope_buf, 0, buf_size);

        // Phase 2: Frontend: lex, parse, validate all modules in topo order
        cdebug("[Compiler] Phase 2: Building frontend pipeline...\n");
        mut pipeline: PassRegistry = PassRegistry::new();
        pipeline.set_verbose(this.config.verbose_passes);
        cdebug("[Compiler] Phase 2: Calling set_passes...\n");
        pipeline.set_passes([PassID::Lexing, PassID::Parsing,
                             PassID::ConfigGating,
                             PassID::ASTValidation, PassID::CHeaderImport]);
        cdebug("[Compiler] Phase 2: Calling validate...\n");
        const phase2_valid: boolean = pipeline.validate();
        cdebug("[Compiler] Phase 2: validate returned %d\n", phase2_valid as int);

        for (mut i: u32 = 0; i < n; i++) {
            const mod_idx: u32 = order[i];
            cdebug("[Compiler] Phase 2: Processing module %u (index %u)\n", i, mod_idx);
            ctx.switch_to_module(mod_idx as i64);
            cdebug("[Compiler] Phase 2: Module %u path='%s'\n", i, ctx.source_file);
            cdebug("[Compiler] Phase 2: Calling run_all for module %u...\n", i);
            if (!pipeline.run_all(ctx)) {
                intrinsics::fprintf(g_stderr,
                    "error: frontend pipeline failed for module %u\n", i);
                return this.project_failure_release(ctx, ast_buf, scope_buf);
            }
            cdebug("[Compiler] Phase 2: Module %u succeeded\n", i);
            // Save the parsed AST using local buffer
            const ast_slot: void** = intrinsics::ptr_add(ast_buf, (mod_idx * 8) as i64) as void**;
            *ast_slot = ctx.artifacts.ast.root as void*;
            // Mirror into the module_graph's per-module AST table so
            // out-of-band consumers (the LSP for hover/definition) can
            // retrieve a module's AST after the orchestrator returns;
            // the local `ast_buf` goes out of scope at end of function.
            ctx.module_graph.set_module_ast(mod_idx, ctx.artifacts.ast.root);
            pipeline.reset();
            ctx.provisions.clear();
        }

        // Phase 3: Module Resolution: auto-import, import resolution, name resolution
        pipeline.set_passes([PassID::AutoImport, PassID::ImportResolution, PassID::NameResolution]);
        {
            mut initial3: ProvisionSet = ProvisionSet::empty();
            initial3.mark(Provision::ASTValidated);
            pipeline.validate_with_initial(initial3);
        }

        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module(ctx, ctx.intern_table, ast_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            if (!pipeline.run_all(ctx)) {
                return this.project_failure_release(ctx, ast_buf, scope_buf);
            }
            // Save the resolver's scope to local buffer
            if (ctx.resolver != null && ctx.active_module_index >= 0) {
                const scope_val: u64 = ctx.resolver.get_current_scope_id();
                const sc_idx: u32 = ctx.active_module_index as u32;
                if (sc_idx < n) {
                    const sc_slot: u64* = intrinsics::ptr_add(scope_buf, (sc_idx * 8) as i64) as u64*;
                    *sc_slot = scope_val;
                }
            }
            pipeline.reset();
        }

        // Phase 4a: TypeDeclaration: register all type NAMES in the arena
        // across all modules before resolving any signatures.  This handles
        // forward references (e.g., node.cryo uses ASTVisitor* which is
        // defined in visitor.cryo, but visitor depends on node).
        pipeline.set_passes([PassID::TypeDeclaration]);
        {
            mut initial4a: ProvisionSet = ProvisionSet::empty();
            initial4a.mark(Provision::ASTValidated);
            initial4a.mark(Provision::NamesResolved);
            pipeline.validate_with_initial(initial4a);
        }

        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module_with_scope(ctx, ctx.intern_table, ast_buf, scope_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::ImportsDiscovered);
            ctx.provisions.mark(Provision::ModulesLoaded);
            ctx.provisions.mark(Provision::ModuleOrder);
            ctx.provisions.mark(Provision::NamesResolved);
            if (!pipeline.run_all(ctx)) {
                return this.project_failure_release(ctx, ast_buf, scope_buf);
            }
            pipeline.reset();
        }

        // Phase 4b.0: TemplateRegistration across ALL modules first.
        //
        // The DefaultExpansion pass in Phase 4b.1 rewrites bare references
        // to all-default-generic types (e.g. `String` -> `String<GlobalAlloc>`)
        // by consulting the shared GenericRegistry.  For the rewrite of a
        // bare `T` to fire, the template for `T` must already be in the
        // registry - i.e. the module that *declares* `T` must have run
        // TemplateRegistration before *any* module's DefaultExpansion.
        //
        // The previous structure ran the trio
        // `[DefaultExpansion, FunctionSignature, TemplateRegistration]` as
        // one per-module loop and relied on module `order[]` being
        // strictly dependents-after-dependencies.  That assumption fails
        // whenever the import graph perturbs the topological sort: e.g.
        // `compiler/src/compiler/diag/renderer.cryo` adds
        // `import std::collections::string;` and the new edge can place
        // a consumer (`std::collections::str`, which uses `String` in
        // `Str::to_ascii_lowercase`) before its declarer
        // (`std::collections::string`) in `order[]`.  In that case
        // str.cryo's DefaultExpansion ran with an empty registry, its
        // bare `String` references were never rewritten, monomorphization
        // never specialised `String<GlobalAlloc>::push` for that
        // call site, and the link failed with an undefined reference to
        // the bare-template method.
        //
        // Running TemplateRegistration across all modules first makes
        // the cross-module visibility invariant true by construction:
        // every template is in the registry before any DefaultExpansion
        // runs, regardless of where the module sits in `order[]`.
        pipeline.set_passes([PassID::TemplateRegistration]);
        {
            mut initial4b0: ProvisionSet = ProvisionSet::empty();
            initial4b0.mark(Provision::ASTValidated);
            initial4b0.mark(Provision::NamesResolved);
            initial4b0.mark(Provision::TypeDeclarations);
            pipeline.validate_with_initial(initial4b0);
        }

        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module_with_scope(ctx, ctx.intern_table, ast_buf, scope_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::ImportsDiscovered);
            ctx.provisions.mark(Provision::ModulesLoaded);
            ctx.provisions.mark(Provision::ModuleOrder);
            ctx.provisions.mark(Provision::NamesResolved);
            ctx.provisions.mark(Provision::TypeDeclarations);
            if (!pipeline.run_all(ctx)) {
                return this.project_failure_release(ctx, ast_buf, scope_buf);
            }
            pipeline.reset();
        }

        // Phase 4b.1: DefaultExpansion + FunctionSignature.
        // With TemplateRegistration now globally complete, DefaultExpansion
        // sees every cross-module template; FunctionSignature then resolves
        // the rewritten annotations.  FunctionSignature must run after
        // DefaultExpansion in the same module's iteration: annotation
        // resolution is guarded by `!resolved_type.is_valid()`, so a later
        // re-walk would skip them.
        pipeline.set_passes([PassID::DefaultExpansion,
                             PassID::FunctionSignature]);
        {
            mut initial4b: ProvisionSet = ProvisionSet::empty();
            initial4b.mark(Provision::ASTValidated);
            initial4b.mark(Provision::NamesResolved);
            initial4b.mark(Provision::TypeDeclarations);
            initial4b.mark(Provision::TemplatesRegistered);
            pipeline.validate_with_initial(initial4b);
        }

        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module_with_scope(ctx, ctx.intern_table, ast_buf, scope_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::ImportsDiscovered);
            ctx.provisions.mark(Provision::ModulesLoaded);
            ctx.provisions.mark(Provision::ModuleOrder);
            ctx.provisions.mark(Provision::NamesResolved);
            ctx.provisions.mark(Provision::TypeDeclarations);
            ctx.provisions.mark(Provision::TemplatesRegistered);
            if (!pipeline.run_all(ctx)) {
                return this.project_failure_release(ctx, ast_buf, scope_buf);
            }
            pipeline.reset();
        }

        // Phase 5: Type Resolution
        pipeline.set_passes([PassID::TypeResolution, PassID::StructFieldTypeSync]);
        {
            mut initial5: ProvisionSet = ProvisionSet::empty();
            initial5.mark(Provision::ASTValidated);
            initial5.mark(Provision::NamesResolved);
            initial5.mark(Provision::TypeDeclarations);
            initial5.mark(Provision::FunctionSignatures);
            initial5.mark(Provision::TemplatesRegistered);
            pipeline.validate_with_initial(initial5);
        }

        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module_with_scope(ctx, ctx.intern_table, ast_buf, scope_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::NamesResolved);
            ctx.provisions.mark(Provision::TypeDeclarations);
            ctx.provisions.mark(Provision::FunctionSignatures);
            ctx.provisions.mark(Provision::TemplatesRegistered);
            if (!pipeline.run_all(ctx)) {
                return this.project_failure_release(ctx, ast_buf, scope_buf);
            }
            pipeline.reset();
        }

        // Phase 6a: Specialization: monomorphize ALL modules before validation.
        // GenericValidation walks the shared TypeArena which contains
        // InstantiatedTypes from every module.  If we ran validation
        // per-module inside the same loop as monomorphization, the first
        // module's validation would see unmonomorphized types created by
        // later modules during Phase 5 (TypeResolution).  Splitting into
        // 6a (mono) and 6b (validation+sema) ensures every module has
        // completed monomorphization before any validation runs.
        // Phase 6a-i: DirectiveProcessing for ALL modules first. This must
        // complete for every module before any Monomorphization runs.
        // Mono clones generic templates, and a template's `![repr]` /
        // `![align]` layout flags are only set once *its* module's
        // DirectiveProcessing has run. The mono worklist is global and
        // drained per-module, so a spec requested by an early module would
        // otherwise be cloned before its (later) template module's
        // directives were processed, silently dropping the layout onto
        // every instantiation. (Mono lists `DirectivesProcessed` as an
        // *optional* requirement, so the pass framework won't enforce this
        // ordering for us - we sequence it explicitly here.)
        pipeline.set_passes([PassID::DirectiveProcessing]);
        {
            mut init6ai: ProvisionSet = ProvisionSet::empty();
            init6ai.mark(Provision::ASTValidated);
            init6ai.mark(Provision::NamesResolved);
            init6ai.mark(Provision::TypesResolved);
            init6ai.mark(Provision::StructFieldsSynced);
            pipeline.validate_with_initial(init6ai);
        }
        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module_with_scope(ctx, ctx.intern_table, ast_buf, scope_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::NamesResolved);
            ctx.provisions.mark(Provision::TypeDeclarations);
            ctx.provisions.mark(Provision::FunctionSignatures);
            ctx.provisions.mark(Provision::TemplatesRegistered);
            ctx.provisions.mark(Provision::TypesResolved);
            ctx.provisions.mark(Provision::StructFieldsSynced);
            if (!pipeline.run_all(ctx)) {
                return this.project_failure_release(ctx, ast_buf, scope_buf);
            }
            pipeline.reset();
        }

        // Phase 6a-ii: Monomorphization + GenericExpressionResolution for
        // ALL modules, now that every template carries its final layout.
        pipeline.set_passes([
            PassID::Monomorphization,
            PassID::GenericExpressionResolution,
        ]);
        {
            mut initial6a: ProvisionSet = ProvisionSet::empty();
            initial6a.mark(Provision::ASTValidated);
            initial6a.mark(Provision::NamesResolved);
            initial6a.mark(Provision::TypesResolved);
            initial6a.mark(Provision::StructFieldsSynced);
            initial6a.mark(Provision::DirectivesProcessed);
            pipeline.validate_with_initial(initial6a);
        }

        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module_with_scope(ctx, ctx.intern_table, ast_buf, scope_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::NamesResolved);
            ctx.provisions.mark(Provision::TypeDeclarations);
            ctx.provisions.mark(Provision::FunctionSignatures);
            ctx.provisions.mark(Provision::TemplatesRegistered);
            ctx.provisions.mark(Provision::TypesResolved);
            ctx.provisions.mark(Provision::StructFieldsSynced);
            ctx.provisions.mark(Provision::DirectivesProcessed);
            if (!pipeline.run_all(ctx)) {
                return this.project_failure_release(ctx, ast_buf, scope_buf);
            }
            pipeline.reset();
        }

        // End bootstrap mode: the DI is now fully populated from Phase 5
        // and Phase 6a (GenericExpressionResolution registered all specializations).
        // TypeResolver will no longer fall back to arena lookups (steps 4/4a).
        if (ctx.type_resolver != null) {
            ctx.type_resolver.end_bootstrap();
        }

        // Invariant: every queued specialization must be drained before
        // Phase 6b starts.  Phase 6b's sema walks the shared TypeArena
        // expecting every InstantiatedType wrapper to point at a
        // specialized AST that's already been emitted.  A non-empty
        // worklist here means a Phase 6a pass exited early without
        // draining; the system would still produce output but sema
        // would silently see unresolved generic params, and the bug
        // would surface as a downstream codegen mangle/link failure.
        // Cheap insurance for an invariant the pass order silently relies on.
        if (ctx.monomorphizer != null && !ctx.monomorphizer.worklist_empty()) {
            const remaining: i64 = ctx.monomorphizer.pending_count();
            ctx.diagnostics.emit(Diagnostic::error(
                ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("monomorphizer worklist not drained between Phase 6a and 6b (%d pending)",
                    remaining)));
            return this.project_failure_release(ctx, ast_buf, scope_buf);
        }

        // Phase 6b: Validation + Semantic Analysis + Codegen Preparation.
        // Now that every module has been monomorphized and specialized ASTs
        // injected, GenericValidation can safely walk the entire arena
        // without false positives from not-yet-monomorphized modules.
        pipeline.set_passes([
            PassID::GenericValidation,
            PassID::FunctionBodyTypeCheck,
            PassID::MoveCheck,
            PassID::DropInsertion,
            PassID::TypeLowering,
        ]);
        {
            mut initial6b: ProvisionSet = ProvisionSet::empty();
            initial6b.mark(Provision::ASTValidated);
            initial6b.mark(Provision::NamesResolved);
            initial6b.mark(Provision::TypesResolved);
            initial6b.mark(Provision::StructFieldsSynced);
            initial6b.mark(Provision::MonomorphizationComplete);
            initial6b.mark(Provision::GenericExpressionsResolved);
            pipeline.validate_with_initial(initial6b);
        }

        mut phase6_failed: boolean = false;
        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module_with_scope(ctx, ctx.intern_table, ast_buf, scope_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::NamesResolved);
            ctx.provisions.mark(Provision::TypeDeclarations);
            ctx.provisions.mark(Provision::FunctionSignatures);
            ctx.provisions.mark(Provision::TemplatesRegistered);
            ctx.provisions.mark(Provision::TypesResolved);
            ctx.provisions.mark(Provision::StructFieldsSynced);
            ctx.provisions.mark(Provision::MonomorphizationComplete);
            ctx.provisions.mark(Provision::GenericExpressionsResolved);
            if (!pipeline.run_all(ctx)) {
                phase6_failed = true;
            }
            pipeline.reset();
        }

        // Dump ASTs if requested (even on errors, for debugging)
        if (this.config.show_ast) {
            for (mut i: u32 = 0; i < n; i++) {
                const mi: u32 = order[i];
                if (mi < n && ast_buf != null) {
                    const dump_slot: void** = intrinsics::ptr_add(ast_buf, (mi * 8) as i64) as void**;
                    const dump_ast: ProgramNode* = *dump_slot as ProgramNode*;
                    if (dump_ast != null) {
                        const mod_info: ModuleInfo* = &ctx.module_graph.modules[mi];
                        intrinsics::printf("\n=== AST: %s ===\n", mod_info.file_path);
                        ASTDumper::dump(dump_ast, ctx.intern_table);
                    }
                }
            }
        }

        if (this.config.debug) {
            ctx.type_arena.debug_dump();
        }

        // Build cross-module function descriptors from front-end data.
        // This populates ModuleGraph.cross_module_fns so codegen can create
        // extern declarations without re-scanning ASTs or type arenas.
        if (!phase6_failed) {
            for (mut i: u32 = 0; i < n; i++) {
                const mod_idx: u32 = order[i];
                const mod_info: ModuleInfo* = &ctx.module_graph.modules[mod_idx];
                const mod_sym: SymbolStr = ctx.intern(mod_info.file_path);
                build_cross_module_descriptors(
                    ctx.module_graph, mod_sym, ctx.decl_index, ctx.type_arena);
            }
        }

        // Phase 7: Per-module codegen: IR generation, optimization, object emission.
        // Each module gets its own LLVM module. Cross-module references use extern
        // declarations from ModuleGraph.cross_module_fns.
        cdebug("[Compiler] Phase 7 gate: phase6_failed=%d, codegen_enabled=%d, errors=%u\n",
            phase6_failed as int, ctx.mode.codegen_enabled() as int, ctx.diagnostics.error_count);
        if (!phase6_failed && ctx.mode.codegen_enabled()) {
            cdebug("[Compiler] Phase 7: Codegen (%u modules)\n", n);

            // Per-module LLVM IR (`.ll`) output dir. Lives under the hidden
            // per-profile cache (`<output_dir>/.cryo/<profile>/ir`); the
            // linker's combined-IR dump (`run_linking`) globs this same dir,
            // and selfhost-check's stage-3/stage-4 byte-identity gate reads
            // the resulting `<name>.ll`. Keep this path in lockstep with
            // `ProjectConfig::ir_dir()`.
            mut ir_dir: string = "build/.cryo/release/ir";
            if (ctx.project_config != null) {
                ir_dir = ctx.project_config.ir_dir();
            }

            pipeline.set_passes([
                PassID::IRGeneration,
                PassID::ObjectEmission,
            ]);
            {
                mut initial7: ProvisionSet = ProvisionSet::empty();
                initial7.mark(Provision::ASTValidated);
                initial7.mark(Provision::NamesResolved);
                initial7.mark(Provision::TypesResolved);
                initial7.mark(Provision::StructFieldsSynced);
                initial7.mark(Provision::MonomorphizationComplete);
                initial7.mark(Provision::GenericExpressionsResolved);
                initial7.mark(Provision::GenericsValidated);
                initial7.mark(Provision::BodiesTypeChecked);
                initial7.mark(Provision::TypesLowered);
                initial7.mark(Provision::FunctionsDeclared);
                pipeline.validate_with_initial(initial7);
            }

            for (mut i: u32 = 0; i < n; i++) {
                const _mi: ModuleInfo* = &ctx.module_graph.modules[order[i]];
                const _mn: string = ctx.intern_table.resolve(_mi.name);
                cdebug("[Compiler] Phase 7: module %u/%u (%s)\n", i, n, _mn);
                CompilerInstance::load_module_with_scope(
                    ctx, ctx.intern_table, ast_buf, scope_buf, order[i], n);
                ctx.provisions.clear();
                ctx.provisions.mark(Provision::Tokens);
                ctx.provisions.mark(Provision::AST);
                ctx.provisions.mark(Provision::ASTValidated);
                ctx.provisions.mark(Provision::NamesResolved);
                ctx.provisions.mark(Provision::TypeDeclarations);
                ctx.provisions.mark(Provision::FunctionSignatures);
                ctx.provisions.mark(Provision::TemplatesRegistered);
                ctx.provisions.mark(Provision::TypesResolved);
                ctx.provisions.mark(Provision::StructFieldsSynced);
                ctx.provisions.mark(Provision::MonomorphizationComplete);
                ctx.provisions.mark(Provision::GenericExpressionsResolved);
                ctx.provisions.mark(Provision::GenericsValidated);
                ctx.provisions.mark(Provision::BodiesTypeChecked);
                ctx.provisions.mark(Provision::TypesLowered);
                ctx.provisions.mark(Provision::FunctionsDeclared);

                const pipeline_ok: boolean = pipeline.run_all(ctx);

                if (ctx.artifacts.ir.is_valid()) {
                    const mod_info: ModuleInfo* = &ctx.module_graph.modules[order[i]];
                    const mod_name: string = ctx.intern_table.resolve(mod_info.name);

                    // Write .ll text file when --emit-llvm is set
                    // (either via CLI flag or cryoconfig args).
                    if (this.config.emit_llvm || config.emit_llvm) {
                        const mn_len: u64 = intrinsics::strlen(mod_name);
                        const mn_buf: i8* = intrinsics::malloc(mn_len + 1) as i8*;
                        intrinsics::memcpy(mn_buf as void*, mod_name as void*, mn_len);
                        mn_buf[mn_len] = 0;
                        for (mut k: u64 = 0; k < mn_len; k++) {
                            if (mn_buf[k] == ':') { mn_buf[k] = '_'; }
                        }
                        ProjectConfig::mkdir_p(ir_dir);
                        const ll_path: string = format("%s/%s.ll", ir_dir, mn_buf as string);
                        mut ll_err: i8* = null;
                        const ll_ok: i32 = llvm::LLVMPrintModuleToFile(
                            ctx.artifacts.ir.llvm_module, ll_path, &ll_err as void*);
                        if (ll_ok != 0 && ll_err != null) {
                            intrinsics::fprintf(g_stderr,
                                "warning: failed to write %s: %s\n",
                                ll_path, ll_err as string);
                            llvm::LLVMDisposeMessage(ll_err as void*);
                        }
                        intrinsics::free(mn_buf as void*);
                    }

                    if (pipeline_ok) {
                        cdebug("[Compiler] Phase 7: IR + obj for module %u (%s)\n", i, mod_name);
                    } else {
                        cdebug("[Compiler] Phase 7: IR generated for module %u (%s)\n", i, mod_name);
                    }
                } else if (!pipeline_ok) {
                    intrinsics::fprintf(g_stderr,
                        "error: codegen failed for module %u\n", i);
                }

                // Dispose the LLVM module to free LLVM global context memory.
                // Without this, each module's LLVMModuleRef leaks and LLVM's
                // internal type tables grow until they exhaust the stack.
                if (ctx.artifacts.ir.is_valid()) {
                    mut lmod: LModule = LModule { raw: ctx.artifacts.ir.llvm_module };
                    lmod.dispose();
                    ctx.artifacts.ir = IROutput::empty();
                }
                pipeline.reset();
            }

            // Phase 7b: synthesize the test-runner main when in test mode.
            // Walks the directive registry for `![test]` records, builds
            // a fresh LLVM module containing the descriptor table + main,
            // emits it to disk, and registers it with the linker artifacts.
            if (!ctx.diagnostics.has_errors() && ctx.mode.skip_user_main()) {
                cdebug("[Compiler] Phase 7b: Synthesizing test main\n");
                const test_result: PassResult = TestMainCodegen::run_test_main_codegen(ctx);
                if (!test_result.success) {
                    intrinsics::fprintf(g_stderr,
                        "error: test-main synthesis failed\n");
                }
            }

            // Phase 8: link the per-module objects into the final binary.
            // Only runs when Phase 7 produced at least one object (executable
            // targets); library/stdlib builds short-circuit inside run_linking.
            if (!ctx.diagnostics.has_errors() && ctx.artifacts.object_files.length > 0) {
                cdebug("[Compiler] Phase 8: Linking (%lld objects)\n",
                    ctx.artifacts.object_files.length);
                const link_result: PassResult = CodegenPasses::run_linking(ctx);
                if (!link_result.success) {
                    intrinsics::fprintf(g_stderr,
                        "error: linking failed\n");
                }
            }
        }

        // Print diagnostic summary on errors, warnings, or debug mode.
        // Without flushing on warnings, codegen-side warnings about
        // silently-dropped function bodies never reach the user; the
        // build looks green, then the linker fails with `undefined
        // reference`.
        // Skip terminal flush in LSP mode; same rationale as in
        // `run_pipeline`: the renderer fprintfs to `g_stderr` which
        // a host that drives the compiler purely as a library hasn't
        // necessarily wired up (the LSP, for one, gets `NULL`).  The
        // language server reads `ctx.diagnostics.diagnostics` directly
        // and emits them as JSON over stdout.
        const skip_flush: boolean = match (ctx.mode) {
            CompileMode::Lsp => { true }
            _                => { false }
        };
        if (!skip_flush
                && (ctx.diagnostics.has_errors()
                    || ctx.diagnostics.has_warnings()
                    || this.config.debug)) {
            ctx.diagnostics.flush();
            if (ctx.diag_renderer != null) {
                ctx.diag_renderer.print_summary(
                    ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
            }
        }

        if (ctx.diagnostics.has_errors()) {
            return CompilationResult::failed(
                ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
        }
        // Construct the executable path the linker just produced
        // (`<output_dir>/<project_name>`, at the build root — same shape as
        // `ProjectConfig::bin_artifact_path` / CodegenPasses::run_linking) so
        // `cryo run` knows where to exec.  Library / stdlib targets have no
        // entry point, so we leave output_path empty for those.  Test-mode
        // builds add a `-test` suffix to coexist with a regular build of the
        // same project; `run_linking` applies the same suffix.
        mut exe_path: string = "";
        if (ctx.project_config != null
                && ctx.project_config.requires_entry_point()) {
            exe_path = ctx.project_config.bin_artifact_path(ctx.mode.skip_user_main());
        }

        // Build succeeded: record the fingerprint sidecar (consulted by the
        // next build's short-circuit) and the human/tooling-facing manifest.
        // Gated on `do_incremental`; the fingerprint locals were computed
        // before the frontend ran. Side files only; no effect on the IR.
        if (do_incremental && ctx.project_config != null) {
            BuildManifest::write_fingerprint(ctx.project_config, build_fp_hex);
            BuildManifest::write_manifest(
                ctx.project_config, &mod_entries, ctx.opt_level,
                ctx.emit_debug_info, build_fp_hex, &manifest_artifacts,
                manifest_stdlib_archive);
        }

        mut ok_result: CompilationResult = CompilationResult::ok(exe_path);
        ok_result.stdlib_root = ctx.stdlib_root;
        intrinsics::free(ast_buf);
        intrinsics::free(scope_buf);
        return ok_result;
    }

    /// Release the per-module AST / scope buffers allocated by
    /// `compile_project_with_ctx` and forward to `project_failure`.
    /// Used at every failure return inside the orchestrator so the
    /// LSP daemon (which calls back into `compile_project_with_ctx`
    /// once per project change) does not leak ~16 bytes per module
    /// per recompile.
    project_failure_release(&this, ctx: CompilationContext*,
                            ast_buf: void*, scope_buf: void*)
            -> CompilationResult {
        intrinsics::free(ast_buf);
        intrinsics::free(scope_buf);
        return this.project_failure(ctx);
    }

    /// Helper: build a failure result from context diagnostics.
    project_failure(&this, ctx: CompilationContext*) -> CompilationResult {
        // Same LSP-mode skip as the success path in compile_project_with_ctx:
        // the renderer's stderr stream may be `NULL` when the compiler runs
        // as a library inside another process.  The diagnostic array stays
        // populated for the LSP to read and emit as JSON.
        const skip_flush: boolean = match (ctx.mode) {
            CompileMode::Lsp => { true }
            _                => { false }
        };
        if (!skip_flush) {
            ctx.diagnostics.flush();
            if (ctx.diag_renderer != null) {
                ctx.diag_renderer.print_summary(
                    ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
            }
        }
        return CompilationResult::failed(
            ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
    }

}
