/// Compiler Instance
///
/// Thin orchestrator that creates a CompilationContext with the right
/// CompileMode, builds the appropriate PassRegistry pipeline, validates
/// it, and runs it.  Every entry point follows the same flow:
///   create context -> build pipeline -> validate -> run -> return result
///
/// Mode-specific behavior comes from CompileMode policy methods queried
/// by individual passes, not from flags on this struct.

namespace Compiler::Instance;

import Compiler::{
    CompileMode, CompilationContext, Diag, Artifacts, ModuleGraph,
    ModuleLoader, ProjectConfig, BuildManifest, Codegen, Lex
};
import Compiler::Passes::{
    PassID, PassRegistry, Specialization
};
import Compiler::Codegen::{
    LLVMTypes, Passes, TestMainCodegen, TypeMap
};
import Compiler::Resolver::{
    InternTable, SymbolStr, MangledName
};
import Compiler::Resolver::Res;
import Compiler::AST::{ Node, Declaration, Dumper, NodeKind };
import Compiler::Deps::DepResolver;
import Compiler::Deps::Lockfile;
import Compiler::Vendor::AutoVendor;
import Compiler::Diag::Diagnostic;
import Compiler::Lex::Lexer;
import Compiler::ResolveCounter;
import Utils;
import Utils::Logger;
import std::fmt;
import std::fs::metadata;
import std::fs::path;
import std::env;
import std::thread;
import std::time::clock;
import std::collections::string;
import std::collections::str;
import std::core::hash;
import std::core::mem;

// Default codegen worker count: the online CPU count.  Object emission is
// parallelized by fanning each module out to a child `cryo __emit-obj` PROCESS
// (see the codegen loop + `CodegenPasses::run_multiprocess_emit`): a process
// boundary is required because in-process threading of LLVM codegen corrupts
// process-global LLVM state (it crashed on both Linux and Windows).  The
// multi-process path is byte-identical to serial and stable; it engages only
// above `CODEGEN_MULTIPROC_MIN_MODULES` so small builds skip the spawn +
// bitcode round-trip overhead.  `CRYO_CODEGEN_THREADS=N` overrides (1 = serial).
function codegen_default_threads() -> u32 { return thread::available_parallelism(); }

// Below this module count the bitcode round-trip + child-process spawn cost
// outweighs the parallel-emit win, so codegen stays serial + in-process.
const CODEGEN_MULTIPROC_MIN_MODULES: u32 = 16u32;

type struct CompilerConfig {
    debug:              boolean;
    show_ast:           boolean;
    verbose_passes:     boolean;
    emit_llvm:          boolean;
    /// CLI override for project output_dir.  Empty string ("") means
    /// "use whatever the cryoconfig says".  Set from `--build-dir=...`
    /// in cmd_project.  Lets stage 3/4 self-host runs land in distinct
    /// directories so their emitted IR/.o can be diff'd for fixed-point
    /// equivalence.
    output_dir_override: string;
    /// CLI override for the standard library root.  Empty string ("")
    /// means "use the search-order fallback chain".  Set from
    /// `--stdlib=PATH`.  Takes priority over `$CRYO_STDLIB` and every
    /// implicit candidate path.
    stdlib_path_override: string;
    /// `cryo test` build flag.  When true, `compile_project` runs in
    /// `CompileMode::Test`: src/ + tests/ are both compiled, the user's
    /// `main` is suppressed, and a synthesized test main drives every
    /// `![test]` function through `std::test::runner::run_all`.  The
    /// produced executable lands at `<output_dir>/<name>-test`.
    test_mode:           boolean;
    /// CLI override for the codegen target triple (`--target=TRIPLE`).
    /// Empty string ("") means "fall back to cryoconfig's `target` key,
    /// then to the host triple from LLVM".  Takes priority over the
    /// cryoconfig value so a single project config can be cross-compiled
    /// to multiple targets without editing the file.
    target_triple_override: string;
    /// Single-file `-o PATH` / `--output PATH` override.  Empty string
    /// ("") keeps the per-origin `target/<profile>/<origin>/deps/<module>.o`
    /// layout.  Output
    /// kind is inferred from the path extension into `output_kind`
    /// so codegen can branch without re-parsing.
    output_path_override: string;
    /// Output kind for single-file `-o PATH`.  `OutputKind::None`
    /// keeps the legacy emission path; the other variants pick the
    /// emit-to-file mode in codegen (Asm/Object) or trigger the
    /// IR-text dump / `cc` link flow (IRText/Exe).
    output_kind:         OutputKind;
    /// CLI override for the LLVM optimization level (`--opt-level=N`,
    /// 0..3). `-1` means "unset" => fall back to cryoconfig `[compiler]
    /// optimize`. Takes priority over the cryoconfig value so a single
    /// project can be built optimized or debuggable without editing the
    /// file. Read in `compile_project_with_ctx`.
    opt_level_override:  i32;
    /// `-g` / `--debug-info`: emit DWARF debug info (source file/line +
    /// per-function scopes) so gdb/lldb can show file:line backtraces.
    /// Opt-in; default off. Independent of the optimization level (a
    /// `-g -O2` build still carries line info, just with optimized code).
    emit_debug_info:     boolean;
    /// CLI override for the build profile (`--release` / `--dev` /
    /// `--profile=NAME`). Empty string ("") means "use the cryoconfig
    /// `[profile] default`, then the built-in `release`". The selected
    /// profile names the per-profile cache subtree and supplies the default
    /// optimization level / debug-info state.
    profile_override:    string;
    /// Incremental build short-circuit. When true (default), a build whose
    /// inputs fingerprint matches the saved one and whose artifacts still
    /// exist is skipped, and a build manifest + fingerprint sidecar are
    /// written on success. `--no-incremental` turns this off for a full,
    /// reproducible build; selfhost-check passes it so every stage rebuilds
    /// and the stage-3/stage-4 IR comparison stays meaningful.
    incremental:         boolean;
    /// `--release-static`: link the compiler statically against libLLVM (the
    /// `.a` component set from `llvm-config --link-static`) plus a static C++
    /// runtime, producing a self-contained binary with no `libLLVM-20.so`
    /// runtime dependency.  Distribution-only; default off so every dev build
    /// keeps the fast dynamic link.  Linux host only for v1.  Consumed at link
    /// time in `CodegenPasses::run_linking`; does not affect emitted IR.
    release_static:      boolean;
    /// `--no-std`: build without the standard library (no prelude, no
    /// stdlib module discovery, no libcryo.a at link time).  For project
    /// builds this is OR'd with the cryoconfig `no_std` key (the flag can
    /// force a freestanding build on, never off); for single-file builds
    /// it is the only way to opt out of the auto-imported stdlib.
    no_std:              boolean;
    /// `--no-runtime`: freestanding build - suppress the implicit `main`
    /// widening / prologue and the `@panic` runtime, route check failures to
    /// `llvm.trap`, and link with `-nostartfiles -nostdlib -static`.  OR'd
    /// with the cryoconfig `no_runtime` key for project builds (can force on,
    /// never off).  How `runtime/core` is built.  Implies nothing about the
    /// stdlib - pair with `--no-std` for a fully freestanding build.
    no_runtime:          boolean;
    /// `--panic=<abort|unwind>`: which panic strategy to emit and link.  Unlike
    /// `no_std`/`no_runtime` this is a CHOICE rather than a switch, so it is
    /// not OR'd: an explicit flag overrides the cryoconfig in either direction,
    /// and `Unspecified` (the default here) leaves the project's own answer
    /// alone.  `ProjectConfig::resolve_panic_unwind` turns it into a boolean.
    panic:               PanicStrategy;
    /// `--locked`: verify the `cryoconfig.lock` vendor section instead of
    /// updating it - the build FAILS if a resolved vendor binding's content
    /// hash drifts from the lock (or has no lock entry).  The reproducibility
    /// CI gate.  Off => a normal build records/updates the lock in place.
    locked:              boolean;
    /// `--codegen-threads=N`: worker count for parallel object emission.
    /// `-1` means "unset" => fall back to cryoconfig `[compiler]
    /// codegen_threads`, then to the online CPU count.  `1` forces serial
    /// (single-threaded) codegen.  Takes priority over the cryoconfig value.
    /// Object bytes are independent of the worker count, so this only trades
    /// build speed vs. cores - never output.
    codegen_threads_override: i32;

    static default() -> CompilerConfig {
        return CompilerConfig {
            debug:               false,
            show_ast:            false,
            verbose_passes:      false,
            emit_llvm:           false,
            output_dir_override: "",
            stdlib_path_override: "",
            test_mode:           false,
            target_triple_override: "",
            output_path_override: "",
            output_kind:         OutputKind::None,
            opt_level_override:  -1,
            emit_debug_info:     false,
            profile_override:    "",
            incremental:         true,
            release_static:      false,
            no_std:              false,
            no_runtime:          false,
            panic:               PanicStrategy::Unspecified,
            locked:              false,
            codegen_threads_override: -1,
        };
    }

    static debug_config() -> CompilerConfig {
        return CompilerConfig {
            debug:               true,
            show_ast:            true,
            verbose_passes:      true,
            emit_llvm:           false,
            output_dir_override: "",
            stdlib_path_override: "",
            test_mode:           false,
            target_triple_override: "",
            output_path_override: "",
            output_kind:         OutputKind::None,
            opt_level_override:  -1,
            emit_debug_info:     false,
            profile_override:    "",
            incremental:         true,
            release_static:      false,
            no_std:              false,
            no_runtime:          false,
            panic:               PanicStrategy::Unspecified,
            locked:              false,
            codegen_threads_override: -1,
        };
    }
}


type struct CompilationResult {
    success:       boolean;
    error_count:   u32;
    warning_count: u32;
    output_path:   string;
    /// The stdlib root this build resolved (possibly relative). Surfaced
    /// so `cryo test` can export it as `$CRYO_STDLIB` for the test
    /// runtime's compile-fail helpers. Empty for `--no-std` builds.
    stdlib_root:   string;

    static ok(output_path: string) -> CompilationResult {
        return CompilationResult {
            success:       true,
            error_count:   0,
            warning_count: 0,
            output_path:   output_path,
            stdlib_root:   "",
        };
    }

    static ok_with_warnings(output_path: string, warnings: u32) -> CompilationResult {
        return CompilationResult {
            success:       true,
            error_count:   0,
            warning_count: warnings,
            output_path:   output_path,
            stdlib_root:   "",
        };
    }

    static failed(errors: u32, warnings: u32) -> CompilationResult {
        return CompilationResult {
            success:       false,
            error_count:   errors,
            warning_count: warnings,
            output_path:   "",
            stdlib_root:   "",
        };
    }
}


// Stdlib root resolution
//
// Search order, first hit wins:
//   0. --stdlib=PATH                      - CLI override (highest priority)
//   1. $CRYO_STDLIB                       - explicit stdlib pointer (env)
//   2. $CRYO_HOME/stdlib                  - install-root pointer (env)
//   3. $CRYO_HOME/share/cryo/stdlib       - FHS layout under install root
//   4. <bindir>/../stdlib                 - in-repo + symlink installs
//   5. <bindir>/../share/cryo/stdlib      - FHS-style system install
//   6. <cryoconfig stdlib_root>           - project-pinned (relative or abs)
//   7. <project_root>/../stdlib           - legacy: project-relative
//   8. ../stdlib                          - legacy: cwd-relative
//
// (2)/(3) are the recommended cross-platform mechanism: `install.sh`
// writes `CRYO_HOME` into the user's shell rc, and every install (Linux,
// macOS, other) finds the stdlib without needing `/proc/self/exe`.
// (4)/(5) resolve the running binary's own location so an in-tree or
// symlink install (`/usr/local/bin/cryo` -> `<repo>/bin/cryo`, or a
// `bin/cryo.exe` sitting beside `stdlib/`) finds the repo's stdlib with
// no env var.  `env::current_exe()` reads `/proc/self/exe` on Unix and
// `GetModuleFileNameA` on Windows, so the dirname scan must accept BOTH
// `/` and `\` separators (the Windows path is backslash-delimited).
// (6) is for projects that vendor a custom stdlib or pin a version.
//
// Relative `cryoconfig stdlib_root` values are resolved against the
// project root so `stdlib_root = "../stdlib"` does the obvious thing.
//
// `tried_out` accumulates the candidate paths that were probed and
// rejected; the caller renders these in a hard-error diagnostic when
// resolution fails so users see exactly where the compiler looked.


type struct CompilerInstance {
    config: CompilerConfig;

    static new(config: CompilerConfig) -> CompilerInstance {
        return CompilerInstance {
            config: config,
        };
    }

    /// Duplicate a survivor `string` into a fresh libc allocation that is
    /// independent of any CompilationContext-owned (interned / arena)
    /// storage.  Used to copy a build's result strings out before the
    /// per-target context is torn down (`release_per_target`), so the
    /// returned `CompilationResult` can never alias freed memory.
    /// `""` and ordinary strings both dup cleanly; the small copy is
    /// intentionally leaked (it outlives the build).
    static dup_survivor(s: string) -> string {
        return String::from_str(Str::new(s)).into_raw();
    }

    /// Build a ProjectConfig view that compiles the `[lib]` half of a
    /// multi-target project as a Library.  Inherits debug/optimize/no_std/
    /// stdlib + linkage settings from the base config; overrides only the
    /// fields that select what to compile and what to name the output.
    static make_lib_view(base: ProjectConfig) -> ProjectConfig {
        mut view: ProjectConfig = base;
        view.target_type  = TargetType::Library;
        // Read through `view` (a full copy of `base`) rather than `base`, which
        // was just moved into `view` - keeps `make_lib_view` move-clean.
        view.project_name = view.lib.name;
        view.source_dir   = view.lib.source_dir;
        return view;
    }

    /// Build a ProjectConfig view that compiles a single `[[bin]]` entry
    /// as an Executable.  As with `make_lib_view`, inherits everything
    /// other than what selects the entry point and names the output.
    static make_bin_view(base: ProjectConfig, bin: BinTarget) -> ProjectConfig {
        mut view: ProjectConfig = base;
        view.target_type  = TargetType::Executable;
        view.project_name = bin.name;
        view.entry_point  = bin.entry_point;
        return view;
    }

    /// Build a ProjectConfig view that compiles one `[[lib]]` workspace
    /// member as a Library.  Unlike `make_lib_view` (which reads the singular
    /// `[lib]`), the member is passed explicitly: name + source_dir select
    /// what to compile and name the `lib<name>.a` archive.  Everything else
    /// (no_std/no_runtime/optimize/link/stdlib) is inherited from `base`, so
    /// members share the project-level `[compiler]` config.
    static make_lib_member_view(base: ProjectConfig, lib: LibTarget) -> ProjectConfig {
        mut view: ProjectConfig = base;
        view.target_type  = TargetType::Library;
        view.project_name = lib.name;
        view.source_dir   = lib.source_dir;
        return view;
    }

    // Shared pipeline orchestration

    /// Run a pipeline on a context, handling AST dump, diagnostics, and
    /// result construction.  All single-file compile_* methods delegate here.
    run_pipeline(&this, ctx: CompilationContext*, pipeline: PassRegistry*,
                 output_path: string) -> CompilationResult {
        pipeline.set_verbose(this.config.verbose_passes);

        if (!pipeline.validate()) {
            LOG_DEBUG(LogComponent::General, "[Compiler] Pipeline validation FAILED");
            return CompilationResult::failed(1, 0);
        }

        const success: boolean = pipeline.run_all(ctx);

        // Write .ll text file when --emit-llvm is set (single-file mode).
        if (this.config.emit_llvm && ctx.artifacts.ir.is_valid()) {
            const ll_path: string = format("%s.ll", output_path);
            mut ll_err: i8* = null;
            const ll_ok: i32 = llvm::LLVMPrintModuleToFile(
                ctx.artifacts.ir.llvm_module, ll_path, &ll_err as void*);
            if (ll_ok == 0) {
                fmt::eprintln(f"[Compiler] LLVM IR emitted: {ll_path}");
            } else if (ll_err != null) {
                fmt::eprintln(f"warning: failed to write {ll_path}: {ll_err as string}");
                llvm::LLVMDisposeMessage(ll_err as void*);
            }
        }

        // Dump AST if --ast was requested
        if (this.config.show_ast && ctx.artifacts.ast.is_valid()) {
            const ast_root: ProgramNode* = ctx.artifacts.ast.root;
            ASTDumper::dump(ast_root, ctx.intern_table);
        }

        // Print diagnostic summary when ANY diagnostic was emitted (errors
        // or warnings) or in debug mode.  Without flushing on warnings,
        // codegen warnings about silently-dropped function bodies (e.g.
        // missing LLVM declarations for cross-module trait impls) are
        // collected but never rendered, so the user sees a green build
        // followed by `undefined reference` link-time failures.
        //
        // LSP mode: skip the terminal-rendered output entirely.  The
        // language server consumes `ctx.diagnostics.diagnostics`
        // directly and emits them as JSON over stdout; an extra render
        // to stderr would (a) try to read source from disk via the
        // diag span's `file:` URI path and (b) print colour codes that
        // confuse the editor's log capture.
        const skip_flush: boolean = match (ctx.mode) {
            CompileMode::Lsp => { true }
            _                => { false }
        };
        if (!skip_flush
                && (ctx.diagnostics.has_errors()
                    || ctx.diagnostics.has_warnings()
                    || this.config.debug)) {
            ctx.diagnostics.flush();
            if (ctx.diag_renderer != null) {
                ctx.diag_renderer.print_summary(
                    ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
            }
        }

        if (this.config.debug) {
            // const r: Resolver * = ctx.get_resolver();
            // if (r != null) { r.debug_dump(); }
            ctx.type_arena.debug_dump();
        }

        LOG_DEBUG(LogComponent::General, "[Compiler] Finished: %s (%u errors, %u warnings)",
            ctx.source_file, ctx.diagnostics.error_count, ctx.diagnostics.warning_count);

        if (success) {
            return CompilationResult::ok_with_warnings(
                output_path, ctx.diagnostics.warning_count);
        }
        return CompilationResult::failed(
            ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
    }


    /// Compile a single source file with stdlib linking and prelude.
    ///
    /// Implemented as a synthesized one-entry project: the file's
    /// directory becomes the project root, the file becomes the entry
    /// point, and the build routes through the same multi-module
    /// orchestrator real cryoconfig projects use.  That is what makes
    /// the stdlib visible here: without module discovery, the
    /// AutoImport-injected `import std::prelude` would resolve against an
    /// empty module graph and every stdlib symbol (`printf`, `String`, ...)
    /// would fail with E0202.
    /// Project mode compiles the std modules into the graph like any
    /// other import, so a program behaves identically whether it is
    /// built as `cryo build hello.cryo` or as a one-file project.
    ///
    /// Artifacts follow the project layout (`<dir>/build/<stem>` plus
    /// the per-profile cache), and a `-o PATH` override is honored on
    /// top of it: the entry module's Object/Asm/IRText artifact, or a
    /// mirror of the linked executable, lands at PATH (see
    /// `run_object_emission` / `run_linking`).  `--no-std` opts out of
    /// the stdlib entirely for freestanding single files.
    compile_file(&this, source: string) -> CompilationResult {
        LOG_DEBUG(LogComponent::General, "[Compiler] compile_file: %s", source);
        if (this.config.debug) {
            LOG_DEBUG(LogComponent::General, "[Compiler] Compiling: %s (mode: single-file)", source);
        }

        if (!metadata::exists(Path::from(source))) {
            fmt::eprintln(f"error: file not found: {source}");
            return CompilationResult::failed(1, 0);
        }

        mut config: ProjectConfig = ProjectConfig::default();
        config.project_root = source.parent_dir();
        config.entry_point  = source.basename();
        config.project_name = source.stem();
        config.no_std       = this.config.no_std;
        config.no_runtime   = this.config.no_runtime;
        config.panic        = this.config.panic;
        config.emit_llvm    = this.config.emit_llvm;
        // Artifacts land NEXT TO THE SOURCE FILE, not in the invoking
        // directory: output_dir is consumed as-is by the build-layout
        // helpers (profile_dir / bin_artifact_path), so a relative
        // "build" would resolve against the CWD and `cryo build
        // sub/hello.cryo` would scatter its build tree away from the
        // file it belongs to.
        if (config.project_root.length() > 0
                && !config.project_root.eq(".")) {
            config.output_dir = format("%s/build", config.project_root);
        }
        // CLI `--target=TRIPLE`; `--opt-level` / `-g` / profile flags
        // flow through `this.config` inside compile_project_with_ctx,
        // exactly as they do for a cryoconfig build.
        if (this.config.target_triple_override.length() > 0) {
            config.target_triple = this.config.target_triple_override;
        }
        mut result: CompilationResult = this.compile_project_with_config(config);
        // `-o PATH`: the user's artifact lives at PATH (the mirrored
        // executable for Exe; the entry module's object/asm/IR dump for
        // the other kinds).  Report that as the build's output so
        // `Compiled -> ...` and any caller that consumes the result
        // point at the user's path, not the internal build layout.
        if (result.success
                && this.config.output_path_override.length() > 0) {
            result.output_path = this.config.output_path_override;
        }
        return result;
    }

    /// Compile a single source file in raw mode (no stdlib, no prelude).
    compile_raw(&this, source: string) -> CompilationResult {
        if (this.config.debug) {
            LOG_DEBUG(LogComponent::General, "[Compiler] Compiling: %s (mode: raw)", source);
        }

        if (!metadata::exists(Path::from(source))) {
            LOG_DEBUG(LogComponent::General, "[Compiler] Error: File not found: %s", source);
            return CompilationResult::failed(1, 0);
        }

        mut ctx: CompilationContext = CompilationContext::new(CompileMode::Raw, source);
        ctx.debug_mode = this.config.debug;
        ctx.target_triple = this.config.target_triple_override;
        ctx.output_path_override = this.config.output_path_override;
        ctx.output_kind          = this.config.output_kind;
        // Raw mode runs full codegen (IRGen/ObjectEmission), so it shares the
        // process-wide (TypeRef.id -> LLVMTypeRef) cache. TypeArena.next_id
        // resets to 1 per compile, so a prior compile's entries would alias
        // unrelated types here. Every other codegen entry resets it
        // (compile_project_with_ctx, compile_for_lsp_content_into); raw was the
        // one that didn't.
        Compiler::Codegen::TypeMap::TypeMapperCache::reset_shared_type_cache();
        Compiler::Codegen::AstArena::cryo_ast_arena_reset();
        mut pipeline: PassRegistry = PassRegistry::build_raw_pipeline();
        return this.run_pipeline(&ctx, &pipeline, ctx.artifacts.linked.object_file_path);
    }

    /// Compile for `cryo check`: frontend + semantic analysis, no codegen,
    /// but with normal diagnostic flush so the user sees warnings/errors.
    /// `compile_for_lsp` cannot serve this path because `CompileMode::Lsp`
    /// suppresses the end-of-pipeline flush (the LSP surfaces diagnostics
    /// via JSON-RPC instead), which made `cryo check` silently swallow
    /// every warning including the unknown-directive warning.
    ///
    /// This routes through the SAME multi-module project driver as
    /// `compile_file` / `cryo build` (via `compile_project_with_ctx`), differing
    /// only in `CompileMode::Check`, which gates codegen off after TypeLowering.
    /// The earlier single-file frontend pipeline (`build_frontend_pipeline` over
    /// one module) never loaded the imported stdlib modules, so a reference to a
    /// stdlib type like `String`/`Str`/`Array` failed to resolve (a spurious
    /// E0203/E0233 that a real build did not report).  Loading the whole module
    /// graph the way a build does makes `check` agree with `build`.
    compile_for_check(&this, source: string) -> CompilationResult {
        if (!metadata::exists(Path::from(source))) {
            fmt::eprintln(f"error: file not found: {source}");
            return CompilationResult::failed(1, 0);
        }

        // Synthesize the same single-file project view `compile_file` builds,
        // so module discovery finds this file as the entry point and follows
        // its imports (including the prelude + stdlib) into the module graph.
        mut config: ProjectConfig = ProjectConfig::default();
        config.project_root = source.parent_dir();
        config.entry_point  = source.basename();
        config.project_name = source.stem();
        config.no_std       = this.config.no_std;
        config.no_runtime   = this.config.no_runtime;
        config.panic        = this.config.panic;
        if (this.config.target_triple_override.length() > 0) {
            config.target_triple = this.config.target_triple_override;
        }

        const root_path: string = config.discovery_root_path();
        if (!metadata::exists(Path::from(root_path))) {
            fmt::eprintln(f"error: entry point not found: {root_path}");
            return CompilationResult::failed(1, 0);
        }

        // Heap-allocate the context (it is large) exactly as
        // `compile_project_with_config` does; `compile_project_with_ctx` is a
        // supported direct entry (the LSP uses it too) and resolves the stdlib
        // root itself from `this.config.stdlib_path_override`.
        const _box_ctx: Box<CompilationContext> = Box<CompilationContext>::new(
            CompilationContext::new(CompileMode::Check, root_path));
        mut ctx: CompilationContext* = _box_ctx.leak();
        ctx.debug_mode = this.config.debug;
        return this.compile_project_with_ctx(ctx, config);
    }

    /// Compile for LSP: frontend + semantic analysis, no codegen.
    compile_for_lsp(&this, source: string) -> CompilationResult {
        if (!metadata::exists(Path::from(source))) {
            return CompilationResult::failed(1, 0);
        }

        MangledName::set_lsp_safe(true);
        mut ctx: CompilationContext = CompilationContext::new(CompileMode::Lsp, source);
        mut pipeline: PassRegistry = PassRegistry::build_frontend_pipeline();
        return this.run_pipeline(&ctx, &pipeline, "");
    }


    /// Compile for LSP into a caller-owned context.
    /// Single-file mode: parses + type-checks just the one file the
    /// editor is showing, with no project context.  Cross-file
    /// references resolve to invalid TypeRefs; in LSP-safe mode the
    /// mangler emits a poison sentinel instead of panicking, so this
    /// path can run post-NameResolution passes without crashing the
    /// daemon.  Used as a fallback when we can't find a cryoconfig.
    /// For real diagnostics, route through `compile_for_lsp_project_into`.
    compile_for_lsp_content_into(&this, ctx: CompilationContext*,
                                 virtual_path: string, content: string) -> CompilationResult {
        MangledName::set_lsp_safe(true);
        // Same risk as the multi-target build path: TypeArena.next_id
        // resets every compile, so without clearing the (TypeRef.id ->
        // LLVMTypeRef) cache between LSP recompiles every fresh TypeRef
        // would alias a stale entry from a prior keystroke's compile.
        Compiler::Codegen::TypeMap::TypeMapperCache::reset_shared_type_cache();
        // NB: the arena is NOT reset here.  The LSP session owns the arena
        // lifecycle - it resets + activates routing before constructing `ctx`
        // (so this single-file path's whole container heap - intern strings,
        // resolver maps, type tables, decl index - is arena-backed and bulk
        // reclaimed by the next recompile, instead of leaking to libc every
        // keystroke as it did when this path reset but never activated routing)
        // and deactivates on return.  Resetting here would free the just-built,
        // session-owned `ctx` out from under this compile.
        ctx.artifacts.tokens = TokenStream::new([], virtual_path, content);
        mut pipeline: PassRegistry = PassRegistry::build_frontend_pipeline();
        return this.run_pipeline(ctx, &pipeline, "");
    }

    /// Compile a whole project for the LSP, with one module's source
    /// overridden by the editor buffer.  Discovers every `.cryo` in
    /// the project (per the cryoconfig at `config_path`), parses and
    /// type-checks the lot, but reads `override_path`'s content from
    /// `override_content` instead of the file on disk.
    ///
    /// The resulting `CompilationContext` has the same populated AST,
    /// resolver, type arena, and decl index that a real build would
    /// The LSP uses this for diagnostics, hover, go-to-def, and
    /// completion.  Codegen is gated off via `CompileMode::Lsp` so
    /// no LLVM IR is emitted; everything stops cleanly at TypeLowering.
    compile_for_lsp_project_into(&this, ctx: CompilationContext*,
                                 config_path: string,
                                 override_path: string,
                                 override_content: string) -> CompilationResult {
        MangledName::set_lsp_safe(true);
        ctx.lsp_override_path    = override_path;
        ctx.lsp_override_content = override_content;
        mut config: ProjectConfig = ProjectConfig::parse(config_path);
        if (this.config.output_dir_override != ""
                && this.config.output_dir_override.length() > 0) {
            config.output_dir = this.config.output_dir_override;
        }
        if (this.config.target_triple_override != ""
                && this.config.target_triple_override.length() > 0) {
            config.target_triple = this.config.target_triple_override;
        }
        // Multi-target projects ([lib] + [[bin]]) need a single view
        // picked: the orchestrator only handles one target at a time
        // and `compile_project_multi` builds them in sequence.  The
        // LSP picks the view whose discovery graph actually reaches
        // the file the user is editing; picking the lib unconditionally
        // would miss bin entry points (e.g. `src/main.cryo`) that no
        // module under the lib's `_module.cryo` imports.
        //
        // Heuristic:
        //   1. If override matches a `[[bin]]` entry_point, use that bin view.
        //   2. Else if a `[lib]` is present, use the lib view.
        //   3. Else use the first `[[bin]]`.
        // Single-target configs fall through unchanged.
        if (config.is_multi_target()) {
            mut chosen: int = -1;
            for (mut bi: int = 0; bi < config.bins.length; bi++) {
                const bin_full: string = format("%s/%s",
                    config.project_root, config.bins[bi].entry_point);
                if (bin_full.eq(override_path)) {
                    chosen = bi;
                    break;
                }
            }
            if (chosen >= 0) {
                // BinTarget is Copy; pull the selection out before `config`
                // is moved into make_bin_view so the read isn't after-move.
                const sel: BinTarget = config.bins[chosen];
                config = CompilerInstance::make_bin_view(config, sel);
            } else if (config.lib.is_present()) {
                config = CompilerInstance::make_lib_view(config);
            } else if (config.bins.length > 0) {
                const sel: BinTarget = config.bins[0];
                config = CompilerInstance::make_bin_view(config, sel);
            }
        }
        return this.compile_project_with_ctx(ctx, config);
    }

    /// Switch to a module AND load its AST from the local buffers.
    /// Also restores the saved resolver scope if available.
    static load_module(ctx: CompilationContext*, intern: InternTable*,
                       ast_buf: void*, mod_idx: u32, mod_count: u32) -> void {
        // Set source file, namespace, resolver module
        ctx.switch_to_module(mod_idx as i64);
        // Load AST from local buffer
        if (ast_buf != null && mod_idx < mod_count) {
            const slot: void** = (ast_buf as void**) + mod_idx;
            const ast: ProgramNode* = *slot as ProgramNode*;
            if (ast != null) {
                // Borrow the stored ModuleInfo; a value copy would shallow-alias
                // its owning arrays and double-free them at scope exit.
                const info: ModuleInfo* = &ctx.module_graph.modules[mod_idx];
                const ns: string = intern.resolve(info.namespace_name);
                ctx.artifacts.ast = ASTOutput {
                    root: ast,
                    namespace_name: ns,
                };
            }
        }
    }

    /// Compile a multi-module project using whole-program multi-pass.
    /// Parses cryoconfig, discovers all modules, then runs each pipeline
    /// stage across ALL modules before advancing to the next stage.
    compile_project(&this, config_path: string) -> CompilationResult {
        LOG_DEBUG(LogComponent::General, "[Compiler] compile_project: %s", config_path);

        // Project configuration
        mut config: ProjectConfig = ProjectConfig::parse(config_path);
        if (config.error_count > 0) {
            // ProjectConfig::parse already wrote diagnostics to stderr;
            // bail before any module discovery / codegen runs against
            // a half-validated config.
            return CompilationResult::failed(config.error_count as u32, 0);
        }
        // CLI `--build-dir=PATH` overrides the cryoconfig output_dir
        // before any consumer (codegen .ll/.o paths, link bin path)
        // reads it.  Required for self-host fixed-point testing
        // (S3 -> S4 vs S4 -> S5) where each stage needs its own output tree.
        if (this.config.output_dir_override != ""
                && this.config.output_dir_override.length() > 0) {
            config.output_dir = this.config.output_dir_override;
        }
        // CLI `--target=TRIPLE` overrides the cryoconfig `target` key.
        // Empty string in either slot means "build for the host".
        if (this.config.target_triple_override != ""
                && this.config.target_triple_override.length() > 0) {
            config.target_triple = this.config.target_triple_override;
        }
        // CLI `--no-std` forces a freestanding build on top of whatever
        // the cryoconfig says.  One-directional: the flag can only turn
        // no_std ON (there is no `--std` to override a project that
        // declared itself freestanding).
        if (this.config.no_std) {
            config.no_std = true;
        }
        // Same one-directional force for `--no-runtime`.
        if (this.config.no_runtime) {
            config.no_runtime = true;
        }
        // NOT one-directional: `--panic=` names a strategy, so an explicit flag
        // has to be able to select abort as well as unwind.  `pick` keeps the
        // project's answer when the CLI said nothing.
        config.panic = PanicStrategy::pick(config.panic, this.config.panic);

        // Mirror cryoconfig `debug = true` into the global compiler debug
        // gate so the [Tag] trace printfs fire.  Only flips it ON; CLI
        // `--debug` already turned it on if present, and we don't want
        // `debug = false` in cryoconfig to override that.
        if (config.debug) {
            set_compiler_debug(true);
        }

        // Multi-target projects ([lib] and/or [[bin]]) build each output
        // in sequence in this process.  CodegenContext, TypeArena, and
        // the codegen-side g_shared_type_cache are reset between
        // targets so state from the prior compile doesn't leak into
        // the next.
        if (config.is_multi_target()) {
            return this.compile_project_multi(config);
        }
        return this.compile_project_with_config(config);
    }

    /// Drive a multi-target build: the [lib] (when present) followed by
    /// each [[bin]] in declaration order.  Stops at the first failure.
    /// Returns the last bin's output path so `cryo run` works against
    /// the trailing executable.
    compile_project_multi(&this, base: ProjectConfig) -> CompilationResult {
        // In-process iteration: each target gets its own
        // CompilationContext, and the codegen-side `g_shared_type_cache`
        // is cleared at the top of compile_project_with_config.  That
        // cache is the only meaningful process-global state with a
        // TypeRef.id key; without resetting it, the second target gets
        // back the first target's stale LLVMTypeRef and crashes during
        // IRGen on the first generic instantiation it tries to map.
        mut last_output: string = "";

        // Compile-once, link-twice: when the project declares BOTH a `[lib]`
        // and at least one `[[bin]]`, the bin's whole-program compile already
        // emits every object the `[lib]` archive would contain (the bin's
        // import closure covers the lib's, e.g. the `cryo` bin over the whole
        // compiler `[lib]`).  Rather than run a second full `[lib]` compile,
        // the FIRST bin derives `lib<lib.name>.a` from its own object set
        // (minus its entry module) after it links - see
        // `bundle_lib_from_bin` and `compile_project_with_ctx`.  The bin's
        // compile is unchanged, so the executable stays byte-identical; only
        // the redundant lib pass is dropped.  A `[lib]` with no `[[bin]]`
        // (library-only project) still gets its own full compile below.
        const derive_lib: boolean = base.lib.is_present() && base.bins.length > 0;

        if (base.lib.is_present() && !derive_lib) {
            cdebug("[Compiler] Multi-target: building lib '%s' from %s\n",
                base.lib.name, base.lib.source_dir);
            // Clone so `base` survives for the per-bin views below.
            const lib_view: ProjectConfig = CompilerInstance::make_lib_view(base.clone());
            const r: CompilationResult = this.compile_project_with_config(lib_view);
            if (!r.success) { return r; }
        }

        for (mut i: int = 0; i < base.bins.length; i++) {
            cdebug("[Compiler] Multi-target: building bin '%s' from %s\n",
                base.bins[i].name, base.bins[i].entry_point);
            // Clone `base` per iteration; make_bin_view consumes its first arg.
            const sel: BinTarget = base.bins[i];
            mut bin_view: ProjectConfig = CompilerInstance::make_bin_view(base.clone(), sel);
            // Derive the `[lib]` archive from the first bin's objects.
            if (derive_lib && i == 0) {
                bin_view.bundle_lib_from_bin = base.lib.name;
            }
            const r: CompilationResult = this.compile_project_with_config(bin_view);
            if (!r.success) { return r; }
            if (r.output_path.length() > 0) { last_output = r.output_path; }
        }

        // Workspace `[[lib]]` members: build each as an independent library
        // archive from its own source_dir.  Each member flows through the same
        // single-target library path as a lone `target_type = "library"`
        // project, so `run_linking` archives `lib<name>.a` with no extra work.
        // A fresh CompilationContext per member (in compile_project_with_config)
        // isolates the module graph, so members with disjoint namespaces do not
        // interfere; each member's name keys its own archive + incremental state.
        for (mut i: int = 0; i < base.libs.length; i++) {
            cdebug("[Compiler] Workspace: building lib '%s' from %s\n",
                base.libs[i].name, base.libs[i].source_dir);
            // Clone `base` per iteration; make_lib_member_view consumes its first arg.
            const sel: LibTarget = base.libs[i];
            const lib_view: ProjectConfig = CompilerInstance::make_lib_member_view(base.clone(), sel);
            const r: CompilationResult = this.compile_project_with_config(lib_view);
            if (!r.success) { return r; }
            if (r.output_path.length() > 0) { last_output = r.output_path; }
        }

        return CompilationResult::ok(last_output);
    }

    /// Union the import closure of the compiler-injected module `ns` into
    /// `out`, for folding into every per-module cache key.
    ///
    /// Absent is not an error: the prelude is skipped under `no_std` and the
    /// f-string runtime is only discovered when an f-string is actually used,
    /// so a missing module simply contributes nothing.  A closure that comes
    /// back SHORT is different, and raises `out_short` - the widened key would
    /// then be missing inputs exactly like an unresolvable dependency name,
    /// and the caller declines to serve those modules from cache.
    mark_implicit_closure(&this, ctx: CompilationContext*, ns: string, n: u32,
                          out: boolean[]*, out_short: boolean*) -> void {
        if (ctx == null || out == null) { return; }
        const idx: i64 = ctx.module_graph.find_module_index(ctx.intern_table.intern(ns));
        if (idx < 0 || idx >= n as i64) { return; }
        mut short_walk: boolean = false;
        const clos: boolean[] =
            ctx.module_graph.compute_import_closure(idx as u32, n, &short_walk);
        for (mut i: u32 = 0; i < n; i++) {
            if (clos[i as i64]) { (*out)[i as i64] = true; }
        }
        if (short_walk && out_short != null) { *out_short = true; }
    }

    /// Compile a single target view of a project.  Shared between the
    /// legacy single-target path and each iteration of
    /// `compile_project_multi`.
    compile_project_with_config(&this, config: ProjectConfig) -> CompilationResult {
        const root_path: string = config.discovery_root_path();

        cdebug("[Compiler] Project: %s (target: %s, root: %s, no_std: %d, no_runtime: %d)\n",
            config.project_name, config.target_type.label(), root_path,
            config.no_std as int, config.no_runtime as int);

        if (!metadata::exists(Path::from(root_path))) {
            // Route to stderr: stdout in LSP mode owns the JSON-RPC stream;
            // any stray byte desynchronises Content-Length framing.  These
            // fire before a CompilationContext exists, so we can't route
            // through ctx.diagnostics yet.
            if (config.requires_entry_point()) {
                fmt::eprintln(f"error: entry point not found: {root_path}");
            } else {
                fmt::eprintln(f"error: library root not found: {root_path}");
                fmt::eprintln(f"  expected lib.cryo in source_dir '{config.source_dir}'");
            }
            return CompilationResult::failed(1, 0);
        }

        // Module discovery: create context and discover modules
        // Select compile mode based on target type, with a `cryo test`
        // override:
        //   --test (any executable) -> Test         (suppresses user main,
        //                                           synthesizes test main)
        //   Executable              -> MultiModule  (auto-imports, stdlib
        //                                           linking, main transform)
        //   Library                 -> MultiModule  (auto-imports, stdlib
        //                                           linking, no main transform)
        //   Stdlib                  -> StdlibBatch  (no auto-imports, no
        //                                           stdlib linking, no main
        //                                           transform)
        const mode: CompileMode = if (this.config.test_mode
                                       && config.requires_entry_point()) {
            CompileMode::Test
        } else {
            match (config.target_type) {
                TargetType::Stdlib  => { CompileMode::StdlibBatch }
                _                   => { CompileMode::MultiModule }
            }
        };
        // Heap-allocate CompilationContext to avoid stack overflow.
        // The struct is very large (InternTable, ModuleGraph, DiagnosticSink, etc.)
        // and keeping it on the stack alongside phase locals exhausts the default 8MB limit.
        const _box_ctx: Box<CompilationContext> = Box<CompilationContext>::new(
            CompilationContext::new(mode, root_path));
        mut ctx: CompilationContext* = _box_ctx.leak();
        mut result: CompilationResult = this.compile_project_with_ctx(ctx, config);
        // Per-target teardown.  Copy the survivor strings out of any
        // context-owned (interned) storage FIRST, then reclaim this target's
        // heap so a multi-target (`[lib]` + `[[bin]]`) build does not stack
        // both contexts into peak RSS.  Ordering matters: the dup must run
        // while the interned bytes are still valid, before the teardown frees
        // them.  The LSP entry (`compile_project_with_ctx`) bypasses this
        // method and keeps its context alive.
        result.output_path = CompilerInstance::dup_survivor(result.output_path);
        result.stdlib_root = CompilerInstance::dup_survivor(result.stdlib_root);
        ctx.release_per_target();
        // Release this target's arena chunks back to the OS (the bulk of the
        // per-target heap) so the next target builds from a low baseline
        // instead of climbing on top of the prior target's retained arena.
        Compiler::Codegen::AstArena::cryo_ast_arena_release();
        return result;
    }

    /// Drive the multi-module orchestration against a caller-provided
    /// context.  Lets the language server compile the whole project
    /// (every module, every phase) while keeping the resulting `ctx`
    /// alive afterwards so hover / definition / completion handlers
    /// can walk the populated AST + resolver + type arena.
    ///
    /// The caller is responsible for:
    ///   - Allocating `ctx` (heap, via `Box::leak`) with the correct
    ///     `CompileMode`: `Lsp` for the language server entry,
    ///     whatever `compile_project_with_config` picks for CLI builds.
    ///   - Setting `ctx.lsp_override_path` + `ctx.lsp_override_content`
    ///     before this call when the editor buffer should win over
    ///     the on-disk version of one of the discovered modules.
    compile_project_with_ctx(&this, ctx: CompilationContext*,
                             mut config: ProjectConfig) -> CompilationResult {
        // Drop any cached (TypeRef.id -> LLVMTypeRef) entries from a prior
        // compile in this process.  TypeArena.next_id resets to 1 every
        // compile, so without this every fresh TypeRef would alias a
        // stale cache entry from the previous run.
        Compiler::Codegen::TypeMap::TypeMapperCache::reset_shared_type_cache();
        // Reclaim the previous target's AST nodes (parse trees + monomorphized
        // clones) in bulk.  Each target uses its own heap-leaked
        // CompilationContext, so the prior target's `preserved_asts` /
        // `spec_entries` are never read again - only the arena memory needs
        // releasing, and only here.  No-op on the first target.  NB: if the
        // context ever becomes shared across targets, those node-pointer arrays
        // would dangle after this reset and must be cleared here too.
        //
        // LSP EXCEPTION: the language server owns the arena lifecycle at the
        // session level - it resets the arena and activates routing BEFORE
        // constructing the `ctx` it passes here (so the ctx + its sub-components
        // are arena-backed), and deactivates on return.  Running the reset here
        // would free that session-owned ctx mid-compile, and deactivating here
        // would push discovery/frontend allocations back to libc (the very leak
        // this arrangement fixes).  So both are gated to the non-LSP build path.
        const lsp_owns_arena: boolean = match (ctx.mode) {
            CompileMode::Lsp => { true }
            _                => { false }
        };
        if (!lsp_owns_arena) {
            Compiler::Codegen::AstArena::cryo_ast_arena_reset();
            // Defensive: guarantee this target STARTS with arena routing OFF, so
            // its survivor construction (below, pre-activation) always lands in
            // libc - even on the impossible-by-construction path where a prior
            // target leaked the active flag.  The bracket re-enables it at Frontend.
            Compiler::Codegen::AstArena::cryo_alloc_arena_set_active(false);
        }
        // Same defensive reset for the LLVM context: dispose any leftover from
        // a prior target so this target starts on the global-context fallback
        // until its own context is published at Frontend.
        Compiler::Codegen::LLVMTypes::dispose_codegen_context();

        // CRYO_TIMINGS phase profiling.  All marks are captured regardless;
        // the report only prints (success path) when the env var is set, so
        // the overhead on a normal build is a handful of `clock_gettime`s.
        const tm_on: boolean = CompilerInstance::timing_enabled();
        const tm_entry:        i64 = Instant::now().as_nanos();
        mut tm_discovery_end:  i64 = 0;
        mut tm_frontend_end:   i64 = 0;
        mut tm_mono_end:       i64 = 0;
        mut tm_sema_end:       i64 = 0;
        mut tm_codegen_end:    i64 = 0;
        mut tm_link_end:       i64 = 0;

        const root_path: string = config.discovery_root_path();
        ctx.debug_mode = this.config.debug;

        // Single-file `-o PATH` redirect.  compile_file sets these on
        // the CompilerConfig; cryoconfig project builds leave them
        // empty.  ObjectEmission applies the override to the ENTRY
        // module's artifact and Linking mirrors the executable to the
        // override path (Exe) or skips the link entirely (Object /
        // Asm / IRText).
        ctx.output_path_override = this.config.output_path_override;
        ctx.output_kind          = this.config.output_kind;

        // Resolve the build profile. Precedence: CLI `--release`/`--dev`/
        // `--profile=NAME` > cryoconfig `[profile] default` > built-in
        // `release`. The selected name flows into `config.profile` BEFORE the
        // clone below, so the per-profile cache subtree
        // (`<output_dir>/target/<profile>/`) is consistent across codegen,
        // linking, and the manifest.
        if (this.config.profile_override.length() > 0) {
            config.profile = this.config.profile_override;
        }

        // Optimization level. Base comes from the profile (debug => O0,
        // release => O2); an explicit `[compiler] optimize` wins over the
        // profile, and `--opt-level=N` wins over everything.
        ctx.opt_level = ProjectConfig::profile_base_opt_level(config.profile);
        if (config.opt_level_explicit) {
            ctx.opt_level = config.opt_level;
        }
        if (this.config.opt_level_override >= 0) {
            mut lvl: i32 = this.config.opt_level_override;
            if (lvl > 3) { lvl = 3; }
            ctx.opt_level = lvl as u32;
        }
        // Debug info: base from the profile (debug => on), forced on by
        // `-g` / `--debug-info` regardless of profile.
        ctx.emit_debug_info = ProjectConfig::profile_base_debug_info(config.profile)
            || this.config.emit_debug_info;
        ctx.project_no_std = config.no_std;
        ctx.project_no_runtime = config.no_runtime;
        ctx.project_panic_unwind = config.resolve_panic_unwind();
        ctx.target_triple = config.target_triple;
        // Distribution-only static link (see CompilerConfig.release_static).
        // Consumed at link time; has no effect on emitted IR.
        ctx.release_static = this.config.release_static;

        // Box an independent clone so the local `config` stays usable for the
        // rest of this function (stdlib resolution, dep scan, loader setup);
        // the leaked box owns the copy that lives for `ctx`'s lifetime.
        const _box_config: Box<ProjectConfig> = Box<ProjectConfig>::new(config.clone());
        ctx.set_project_config(_box_config.leak());

        // Resolve stdlib root.  See resolve_stdlib_root above for the
        // full priority chain (CLI -> $CRYO_STDLIB -> $CRYO_HOME ->
        // binary-relative -> cryoconfig stdlib_root -> legacy fallbacks).
        mut stdlib_root: string = "";
        if (!config.no_std) {
            mut tried: string[] = [];
            stdlib_root = CompilerInstance::resolve_stdlib_root(
                this.config.stdlib_path_override,
                config.stdlib_root,
                config.project_root,
                &tried);
            if (stdlib_root.length() > 0) {
                cdebug("[Compiler] Stdlib root: %s\n", stdlib_root);
            } else {
                // No prelude available: hard-fail rather than silently
                // compile a project that can't see `Result`, `String`,
                // etc.  Pass `--no-std` (or set `no_std = true` in
                // cryoconfig) for genuinely freestanding builds.
                fmt::eprintf("error: cannot locate the Cryo standard library\n");
                fmt::eprintf("  none of the candidate paths contained a 'lib.cryo':\n");
                for (mut ti: i64 = 0; ti < tried.length; ti++) {
                    fmt::eprintln(f"    {tried[ti]}");
                }
                fmt::eprintf("  fix one of:\n");
                fmt::eprintf("    --stdlib=PATH                            (one-off override)\n");
                fmt::eprintf("    export CRYO_STDLIB=/path/to/stdlib       (explicit env)\n");
                fmt::eprintf("    export CRYO_HOME=/path/to/install        (install root; stdlib at $CRYO_HOME/stdlib)\n");
                fmt::eprintf("    [project] stdlib_root = \"...\"            (in cryoconfig; relative to project_root)\n");
                fmt::eprintf("    --no-std                                 (build without the standard library)\n");
                return CompilationResult::failed(1, 0);
            }
        }
        ctx.stdlib_root = stdlib_root;

        // NB (LSP): the language server owns the per-recompile arena lifecycle at
        // the SESSION level (`CompilerSession::recompile`): it resets the arena
        // and activates routing BEFORE constructing this `ctx`, so the whole
        // context - including its sub-components (DeclarationIndex, ModuleGraph,
        // InternTable, DiagnosticSink) and everything discovery/frontend/sema/mono
        // allocate below - is arena-backed and reclaimed in bulk by the next
        // recompile's reset, then deactivates routing when this returns.  Routing
        // is therefore already ACTIVE here in LSP mode; the `set_active(true)` at
        // the codegen boundary (~1396) is a no-op for LSP and the real activation
        // for builds, and the reset at the top of this method is gated OFF for LSP
        // (resetting here would free the session-owned `ctx` mid-compile).  The
        // compile-epoch guard makes this safe: a stale session always recompiles
        // before any handler reads its ctx, so nothing is read across a reset.

        // Effective scan roots = own [project].source_paths, then a
        // resolved view of each [dependencies] entry's source roots.
        // The loader appends each to project_root and pre-scans them so
        // imports targeting the dep's namespaces resolve.
        mut effective_roots: string[] = [];
        for (mut ip: int = 0; ip < config.source_paths.length; ip++) {
            effective_roots.push(config.source_paths[ip]);
        }
        // Build mode: read the lockfile, materialize any missing git
        // checkouts, harvest source roots.  Failure here means the user
        // hasn't run `cryo fetch` yet (or the lockfile is stale relative
        // to cryoconfig); we surface a hard error rather than dropping
        // dep roots and reporting confusing "namespace not found"
        // diagnostics later.
        const lock_path: string = CompilerInstance::lock_path_for(config.project_root);
        const dep_outcome: ResolveOutcome = DepResolver::resolve(
            &config, ResolveMode::Build, lock_path);
        if (dep_outcome.failed) {
            return CompilationResult::failed(1, 0);
        }
        for (mut dr: int = 0; dr < dep_outcome.roots.length; dr++) {
            effective_roots.push(dep_outcome.roots[dr].path);
            cdebug("[Compiler] Dependency scan root: %s (%s)\n",
                dep_outcome.roots[dr].path, dep_outcome.roots[dr].name);
        }

        mut loader: ModuleLoader = ModuleLoader::new(
            config.project_root, root_path, stdlib_root, config.no_std,
            effective_roots);

        // Vendor libraries: honor any cryoconfig `[vendor.<Name>]` pins first,
        // generating bindings for each pinned triple on a cache miss (this is
        // the only libclang work on the build path; the loader stays read-only
        // over the generated `.cryo`).  Then enable `import vendor::Name`
        // resolution against the global registry - loaded AFTER the hook so it
        // sees freshly auto-vendored bindings - keyed on this build's effective
        // target triple, with the pins overriding it per library.
        AutoVendor::ensure_pins(&config.vendor_pins, config.target_triple);
        // Mirror resolved vendor bindings into the project build tree under
        // `<profile_dir>/vendor/<Name>/` so the generated `.cryo` (and its
        // object/IR output) is visible alongside std/local; empty when there's
        // no build folder (e.g. LSP), where the loader falls back to the cache.
        const vendor_build_root: string =
            if (ctx.project_config != null) {
                ctx.project_config.vendor_dir()
            } else {
                ""
            };
        loader.set_vendor_context(
            config.target_triple, &config.vendor_pins, vendor_build_root);

        // LSP mode: feed the loader the editor buffer for the active
        // file so import-discovery sees the imports the user is typing
        // *now*, not whatever's on disk.  Without this, a freshly
        // typed `import std::collections::str` is invisible to the
        // discovery walk and `Str::from` fails to resolve.
        if (ctx.lsp_override_path.length() > 0) {
            loader.set_lsp_override(
                ctx.lsp_override_path, ctx.lsp_override_content);
        }

        const discovery_ok: boolean = loader.discover_project(
            ctx.intern_table, ctx.module_graph, ctx.diagnostics,
            root_path, this.config.debug);

        if (!discovery_ok) {
            // Flush deferred diagnostics so the user actually SEES the
            // reason discovery failed (E0500 module-not-found, parse
            // errors during quick-scan, etc.).  Without this, the
            // normal end-of-pipeline flush at line ~395 never runs
            // because we early-return here, and the user gets only
            // the bare "Module discovery failed" line with no
            // underlying cause.  Mode-gated like the main flush:
            // LSP mode owns stdout for JSON-RPC, so we skip rendering
            // there and let the LSP's diagnostic-publish path surface
            // the same diagnostics through `textDocument/publishDiagnostics`.
            const skip_flush_disc: boolean = match (ctx.mode) {
                CompileMode::Lsp => { true }
                _                => { false }
            };
            if (!skip_flush_disc) {
                ctx.diagnostics.flush();
                if (ctx.diag_renderer != null) {
                    ctx.diag_renderer.print_summary(
                        ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
                }
            }
            // Diagnostics carrying the actual failure reason were already
            // flushed above (gated on non-LSP mode).  This trailing marker
            // goes to stderr (never stdout) to avoid corrupting the
            // LSP JSON-RPC stream when the daemon embeds the compiler.
            fmt::eprintf("error: module discovery failed\n");
            // Deactivate the arena in case LSP mode activated it early (above);
            // no-op on the build path, which activates only at ~1396.  Keeps the
            // active flag from leaking past this pre-frontend early return.
            Compiler::Codegen::AstArena::cryo_alloc_arena_set_active(false);
            return CompilationResult::failed(ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
        }

        // Merge the native link metadata of every vendor library this build
        // imported into the project config `run_linking` consumes, so the
        // binary links against them with no hand-written `[link]` flags.
        if (ctx.project_config != null) {
            loader.merge_vendor_links(ctx.project_config);
        }

        // Vendor reproducibility lock: record (or, under `--locked`, verify) the
        // content hash of every vendored binding this build resolved against, in
        // the `cryoconfig.lock` vendor section.  A normal build pins/updates it;
        // `--locked` instead FAILS when a binding drifts from the lock (e.g. a
        // system header or libclang upgrade silently changed the bound API).
        const used_locks: LockedVendor[] = loader.collect_vendor_locks();
        if (used_locks.length > 0) {
            if (!CompilerInstance::sync_vendor_lock(lock_path, &used_locks, this.config.locked)) {
                // Only `--locked` returns false (a drift/missing-entry gate
                // failure); the diagnostic was already printed.
                return CompilationResult::failed(1, 0);
            }
        }

        // Discover the prelude and its submodules (primitives, etc.) when
        // auto-imports are enabled.  Module discovery runs before AutoImport
        // injects the synthetic `import std::prelude`, so prelude submodules
        // wouldn't otherwise be discovered.
        if (ctx.mode.auto_imports_enabled() && !config.no_std && stdlib_root.length() > 0) {
            const prelude_path: string = stdlib_root + "/prelude.cryo";
            if (metadata::exists(Path::from(prelude_path))) {
                loader.discover_module(
                    ctx.intern_table, ctx.module_graph, ctx.diagnostics,
                    prelude_path, this.config.debug);
            }
        }

        // `cryo test`: discover every `.cryo` file under `<project_root>/tests/`
        // as a top-level module.  Test files are leaves in the import graph
        // (nothing in `src/` imports them) so the entry-point-driven walk
        // would never reach them.  We scan first to populate `ns_map`,
        // then discover each file.  Also force-discover the runtime
        // entry points (`std::env`, `std::test::runner`) so they reach the
        // DI; the synthesized test main calls them by mangled name and
        // `lookup_mangled_name` returns invalid otherwise.
        if (ctx.mode.skip_user_main()) {
            const tests_dir: string = format("%s/tests", config.project_root);
            if (metadata::exists(Path::from(tests_dir))) {
                loader.scan_all_project_files(tests_dir, this.config.debug);
                loader.discover_tests_directory(
                    ctx.intern_table, ctx.module_graph, ctx.diagnostics,
                    tests_dir, this.config.debug);
                cdebug("[Compiler] tests/ discovery complete from %s\n", tests_dir);
            } else {
                cdebug("[Compiler] tests/ directory not found at %s; running with no tests\n",
                    tests_dir);
            }
            if (!config.no_std && stdlib_root.length() > 0) {
                const env_path: string = format("%s/env/_module.cryo", stdlib_root);
                if (metadata::exists(Path::from(env_path))) {
                    loader.discover_module(
                        ctx.intern_table, ctx.module_graph, ctx.diagnostics,
                        env_path, this.config.debug);
                }
                const runner_path: string = format("%s/test/runner.cryo", stdlib_root);
                if (metadata::exists(Path::from(runner_path))) {
                    loader.discover_module(
                        ctx.intern_table, ctx.module_graph, ctx.diagnostics,
                        runner_path, this.config.debug);
                }
            }
        }

        // Force-discover the f-string runtime (std::fmt::interp), but ONLY
        // when some discovered module (entry graph, prelude, OR a test file)
        // actually uses an f-string.  Done after ALL discovery so the
        // `uses_fstring` flag reflects test files too.  It is deliberately
        // NOT in the prelude: its transitive deps (ffi::libc etc.) would
        // otherwise be pulled into every program and their globally-visible
        // C shims (`strstr`/`realpath`, which return `u8*`) would collide
        // with code using the `core::intrinsics` shims (which return `i8*`) - 
        // exactly what broke the compiler's own self-build.  AutoImport
        // injects `import std::fmt::interp` into the f-string-using modules
        // for symbol visibility; this (gated on the same usage) puts the
        // module in the graph so it links, since the injection happens after
        // discovery.
        if (ctx.mode.auto_imports_enabled() && !config.no_std
                && stdlib_root.length() > 0
                && ctx.module_graph.uses_fstring) {
            const interp_path: string = stdlib_root + "/fmt/interp.cryo";
            if (metadata::exists(Path::from(interp_path))) {
                loader.discover_module(
                    ctx.intern_table, ctx.module_graph, ctx.diagnostics,
                    interp_path, this.config.debug);
            }
        }

        cdebug("[Compiler] After discovery: module_count=%u, modules.length=%u\n",
            ctx.module_graph.module_count(), ctx.module_graph.modules.length);
        cdebug("[Compiler] name_index.length=%u\n", ctx.module_graph.name_index.length());

        // Classify each discovered module's origin from its file_path so
        // codegen and the build manifest route object/IR output into the
        // matching per-package subtree (`std/`, `local/`, `<depname>/`).
        // Done after ALL discovery so late-discovered stdlib modules
        // (prelude, test runner, fmt::interp) are tagged Stdlib too.  The
        // dep-root prefix mirrors ModuleLoader's scan-root form: relative
        // dep roots are prefixed with project_root before scanning.
        const vendor_root: string =
            if (ctx.project_config != null) {
                ctx.project_config.vendor_dir()
            } else {
                ""
            };
        for (mut mci: u32 = 0; mci < ctx.module_graph.modules.length; mci++) {
            const mci_info: ModuleInfo* = &ctx.module_graph.modules[mci];
            const fpath: string = mci_info.file_path;
            // Vendored bindings the loader copied into `<profile_dir>/vendor/
            // <Name>/<Name>.cryo`.  Checked first (most specific path); the
            // library name is the immediate parent directory, carried in
            // origin_name so output routes to `vendor/<Name>/{deps,ir}`.
            if (vendor_root.length() > 0 && fpath.is_under(vendor_root)) {
                mci_info.origin = ModuleOrigin::Vendor;
                mci_info.origin_name = fpath.parent_dir().basename();
                // Warnings pointing into a generated binding are not the
                // consuming author's to act on; the sink drops them from here on.
                ctx.diagnostics.mark_vendor_file(fpath);
                continue;
            }
            if (!config.no_std && stdlib_root.length() > 0
                    && fpath.is_under(stdlib_root)) {
                mci_info.origin = ModuleOrigin::Stdlib;
                mci_info.origin_name = "";
                continue;
            }
            mut matched_dep: boolean = false;
            for (mut drc: int = 0; drc < dep_outcome.roots.length; drc++) {
                const dr_path: string = dep_outcome.roots[drc].path;
                const dr_base: string =
                    if (config.project_root.length() == 0
                        || config.project_root.eq(".")) {
                        dr_path
                    } else {
                        format("%s/%s", config.project_root, dr_path)
                    };
                if (fpath.is_under(dr_base)) {
                    mci_info.origin = ModuleOrigin::Dep;
                    mci_info.origin_name = dep_outcome.roots[drc].name;
                    matched_dep = true;
                    break;
                }
            }
            if (!matched_dep) {
                mci_info.origin = ModuleOrigin::Local;
                mci_info.origin_name = "";
            }
        }

        // Feed per-module import lists into the DeclarationIndex so
        // `resolve_qualified_scoped` can disambiguate same-leaf names by the use
        // site's imports.  Keyed on namespace (ModuleInfo.name == namespace_name
        // == the declared namespace; dependencies are also namespace names).
        // decl_index stores these as resolved SymbolStr ids rather than reaching
        // a ModuleGraph* back-pointer: Cryo forbids the resulting import cycle
        // (module_graph.cryo already imports DeclIndex).  Done once here, after
        // discovery, where every module's namespace + dependency edges are known
        // and before any pass calls the resolver.
        // Prelude re-export set, DERIVED from `stdlib/prelude.cryo`'s
        // `public module` declarations rather than transcribed into a constant.
        // The loader records each declaration's resolved namespace on the
        // declaring module (`ModuleInfo.submodules`), so the prelude's own
        // entry in the graph already carries exactly the set the source spells.
        //
        // Two things this fixes beyond the sync hazard: the list can no longer
        // drift from the file it mirrors, and under `--no-std` it now comes out
        // EMPTY - the old constant registered 12 std namespaces as "prelude"
        // even when no prelude was loaded.
        const prelude_ns_sym: SymbolStr = ctx.intern_table.intern("std::prelude");
        mut prelude_set: SymbolStr[] = [];
        for (mut pmi: u32 = 0; pmi < ctx.module_graph.modules.length; pmi++) {
            const pm: ModuleInfo* = &ctx.module_graph.modules[pmi];
            if (pm.namespace_name.id != prelude_ns_sym.id) { continue; }
            for (mut psi: i64 = 0; psi < pm.submodules.length; psi++) {
                prelude_set.push(pm.submodules[psi]);
                ResolveCounter::path_prelude(
                    ctx.intern_table.resolve(pm.submodules[psi]));
            }
        }
        ctx.decl_index.register_prelude_namespaces(prelude_set);
        // Modules carrying at least one `export`.  Collected once so the
        // closure below scans only re-exporters instead of the whole graph per
        // visible namespace; on a program that writes no `export` this list is
        // empty and the closure costs nothing.
        mut reexporters: u32[] = [];
        for (mut rxi: u32 = 0; rxi < ctx.module_graph.modules.length; rxi++) {
            if (ctx.module_graph.modules[rxi].reexports.length > 0) {
                reexporters.push(rxi);
            }
        }
        for (mut imi: u32 = 0; imi < ctx.module_graph.modules.length; imi++) {
            const imi_info: ModuleInfo* = &ctx.module_graph.modules[imi];
            // What a module can SEE is its dependency edges PLUS the brace-list
            // items, which are deliberately not dependencies (they would create
            // false cycles in `compute_order`).  Passing only `dependencies`
            // made `ns_imports` answer "not imported" for 68% of the
            // visibility questions it was asked - see docs/name-resolution.md
            // §8.1.
            mut imi_visible: SymbolStr[] = [];
            for (mut di: i64 = 0; di < imi_info.dependencies.length; di++) {
                imi_visible.push(imi_info.dependencies[di]);
            }
            for (mut vi: i64 = 0; vi < imi_info.imported_namespaces.length; vi++) {
                imi_visible.push(imi_info.imported_namespaces[vi]);
            }
            // Re-export closure: importing a module grants what that module
            // re-exports, and what THAT one re-exports, without limit.
            //
            // `imi_visible` is both the worklist and the visited set - a
            // namespace already present is never appended again - which is what
            // terminates the walk.  It cannot terminate on the graph being
            // acyclic, because mutual re-export is legal by design.
            //
            // Every file sharing a namespace is consulted, not the first match:
            // a namespace can span files, and "whichever the graph enumerated
            // first" is the directory-order defect this spec exists to remove.
            mut wi: i64 = 0;
            while (wi < imi_visible.length) {
                const via: SymbolStr = imi_visible[wi];
                wi = wi + 1;
                for (mut ri: i64 = 0; ri < reexporters.length; ri++) {
                    const src: ModuleInfo* =
                        &ctx.module_graph.modules[reexporters[ri]];
                    if (src.name.id != via.id) { continue; }
                    for (mut si: i64 = 0; si < src.reexports.length; si++) {
                        const re_ns: SymbolStr = src.reexports[si];
                        if (re_ns.id == imi_info.namespace_name.id) { continue; }
                        mut re_seen: boolean = false;
                        for (mut qi: i64 = 0; qi < imi_visible.length; qi++) {
                            if (imi_visible[qi].id == re_ns.id) { re_seen = true; }
                        }
                        if (!re_seen) { imi_visible.push(re_ns); }
                    }
                }
            }
            ctx.decl_index.register_module_imports(
                imi_info.namespace_name, &imi_visible);
            // Same set, dumped for the §5.1 path-churn audit.  Emitted here
            // rather than reconstructed offline so the classifier asks the
            // compiler's own reachability question - a regex over `import`
            // lines cannot see brace-list items or the prelude.
            const imi_ns_str: string =
                ctx.intern_table.resolve(imi_info.namespace_name);
            for (mut si: i64 = 0; si < imi_visible.length; si++) {
                ResolveCounter::path_scope(
                    imi_ns_str, ctx.intern_table.resolve(imi_visible[si]));
            }
        }

        // Experimental gate: consuming a C++ vendor library (binding_source
        // "cxx-headers" / language "c++") requires opting in via
        // `[experimental] cxx_ffi = true`, because the Strategy-A C++ bindgen
        // (mangled-symbol binding, no shim) is still experimental.  Checked
        // here - after origin classification - so each vendored library's name
        // (ModuleOrigin::Vendor + origin_name) and its registry entry are both
        // in hand; emitting E0505 through ctx gives a clean, actionable error
        // rather than the misleading "module not found" a loader-level gate
        // (no diagnostic sink) would surface.  `cryo vendor` registration is
        // intentionally not gated - it runs without a project cryoconfig.
        if (ctx.project_config != null && !ctx.project_config.cxx_ffi) {
            mut cxx_gated: boolean = false;
            for (mut gi: u32 = 0; gi < ctx.module_graph.modules.length; gi++) {
                const ginfo: ModuleInfo* = &ctx.module_graph.modules[gi];
                const is_vendor: boolean = match (ginfo.origin) {
                    ModuleOrigin::Vendor => { true }
                    _ => { false }
                };
                if (!is_vendor) { continue; }
                const vidx: i64 =
                    loader.vendor_registry.find_index(ginfo.origin_name);
                if (vidx < 0) { continue; }
                if (!loader.vendor_registry.entries[vidx].is_cxx()) { continue; }
                ctx.emit_error(ErrorCode::E0505_EXPERIMENTAL_FEATURE,
                    format("`import vendor::%s` uses the experimental C++ binding generator",
                        ginfo.origin_name));
                cxx_gated = true;
            }
            if (cxx_gated) {
                ctx.emit_help(
                    "C++ FFI (Strategy-A mangled-symbol binding) is experimental; enable it by adding `[experimental]` with `cxx_ffi = true` to this project's cryoconfig");
                // Render the deferred diagnostics: this early return is between
                // the discovery and end-of-compile flush points, so without
                // this the buffered E0505 would never reach the terminal.
                ctx.diagnostics.flush();
                return CompilationResult::failed(ctx.diagnostics.error_count, 0);
            }
        }

        if (ctx.module_graph.module_count() == 0) {
            fmt::eprintf("error: no modules discovered\n");
            return CompilationResult::failed(1, 0);
        }

        // Compute topological order
        cdebug("[Compiler] Calling compute_order()...\n");
        if (!ctx.module_graph.compute_order()) {
            // Name the modules that could not be placed.  Without this the
            // user saw only "Project compilation failed (1 errors, ...)" with
            // no diagnostic at all: the cycle listing went to the debug
            // channel, and the E0501 below was buffered but never flushed.
            mut cyc: string = "";
            const unplaced: &u32[] = &ctx.module_graph.topo_unplaced;
            for (mut ui: i64 = 0; ui < unplaced.length; ui++) {
                const uinfo: ModuleInfo* =
                    &ctx.module_graph.modules[unplaced[ui]];
                const uname: string = ctx.intern_table.resolve(uinfo.name);
                if (cyc.length() > 0) { cyc = cyc + ", "; }
                cyc = cyc + uname;
            }
            const cyc_msg: string = if (cyc.length() > 0) {
                format("circular module dependency detected; cannot determine "
                       "compilation order. Modules in the cycle: %s", cyc)
            } else {
                "circular module dependency detected; cannot determine compilation order"
            };
            ctx.emit_error(ErrorCode::E0501_CIRCULAR_IMPORT, cyc_msg);
            // Diagnostics are buffered until flush(); an early return that
            // skips it silently discards the error (same defect the E0505
            // path above documents).
            ctx.diagnostics.flush();
            return CompilationResult::failed(ctx.diagnostics.error_count, 0);
        }

        const order: &u32[] = &ctx.module_graph.topo_order;
        const n: u32 = order.length as u32;
        tm_discovery_end = Instant::now().as_nanos();

        cdebug("[Compiler] Discovered %u modules, compilation order:\n", n);
        for (mut i: u32 = 0; i < n; i++) {
            const info: ModuleInfo* = &ctx.module_graph.modules[order[i]];
            cdebug("  [%u] %s (%s)\n", i,
                ctx.intern_table.resolve(info.name), info.file_path);
        }

        // Incremental whole-build fingerprint + short-circuit.
        //
        // Build the input set (every discovered module, in topo order) and a
        // fingerprint over it + the resolved knobs + the compiler and stdlib
        // binaries. The locals persist to the manifest write at the end of a
        // successful build, so everything is computed once here.
        //
        // Gated on `incremental` (off via `--no-incremental`, which selfhost
        // passes so every stage does a full, comparable rebuild) and on
        // `codegen_enabled()` (LSP mode needs the full AST and produces no
        // artifact, so it always falls through).
        // `-o PATH` builds always run: the override artifact lives
        // outside the manifest's artifact list, so the short-circuit
        // could otherwise report "up to date" while the user's deleted
        // or stale `-o` output is never regenerated.
        const do_incremental: boolean =
            this.config.incremental && ctx.mode.codegen_enabled()
            && this.config.output_path_override.length() == 0;
        mut mod_entries: BuildManifest::ModuleEntry[] = [];
        mut manifest_artifacts: string[] = [];
        mut manifest_stdlib_archive: string = "";
        mut build_fp_hex: string = "";

        // Per-module incremental cache.  Computed after Specialization (section below),
        // consumed by the SemanticAnalysis/Codegen skip and the success-path sidecar write.
        //   pm_cached[m]   : module index m may reuse its on-disk .o
        //   pm_key_names[m]: namespace of module m (parallel to pm_key_hex)
        //   pm_key_hex[m]  : current cache key of module m
        //   pm_active      : the per-module cache is in effect this build
        mut pm_cached:    boolean[] = [];
        mut pm_key_names: string[]  = [];
        mut pm_key_hex:   string[]  = [];
        mut pm_active:    boolean    = false;
        if (do_incremental) {
            for (mut i: u32 = 0; i < n; i++) {
                const minfo: ModuleInfo* = &ctx.module_graph.modules[order[i]];
                mod_entries.push(BuildManifest::ModuleEntry {
                    namespace_name: ctx.intern_table.resolve(minfo.name),
                    source_path:    minfo.file_path,
                    origin_subdir:  ModuleInfo::origin_subdir(minfo.origin, minfo.origin_name),
                    origin_kind:    ModuleInfo::origin_kind_label(minfo.origin),
                });
            }
            if (!config.no_std && stdlib_root.length() > 0) {
                // Same per-target resolution the link uses, so the
                // freshness dependency names the archive that will actually
                // be linked rather than a flat path another target may own.
                manifest_stdlib_archive = CodegenPasses::stdlib_archive_path(
                    stdlib_root,
                    LTargetMachine::resolve_effective_triple(ctx.target_triple));
            }
            // Final artifact path(s) this build will produce.  For
            // executables, require BOTH the hoisted build-root binary (index
            // 0, the runnable path) AND the per-profile link target: if either
            // is missing the short-circuit is skipped, so a deleted
            // `build/<name>` forces a re-hoist and a deleted per-profile
            // artifact forces a relink.
            if (config.requires_entry_point()) {
                // Route through the target-aware helpers so a windows-gnu
                // cross-build looks for `build/<name>.exe` and
                // `build/.../release/<name>.exe`, not the suffix-less path
                // run_linking writes nothing to.  Without this the
                // incremental short-circuit always sees the artifact as
                // missing on Windows and re-links every build.
                manifest_artifacts.push(
                    CodegenPasses::bin_artifact_path_for_target(ctx.project_config, ctx));
                manifest_artifacts.push(
                    CodegenPasses::profile_bin_path_for_target(ctx.project_config, ctx));
            } else {
                const archive_name: string = match (config.target_type) {
                    TargetType::Stdlib => { "libcryo.a" }
                    _                  => { format("lib%s.a", config.project_name) }
                };
                manifest_artifacts.push(ctx.project_config.lib_archive_path(archive_name));
            }
            const manifest: BuildManifest::Manifest = Compiler::BuildManifest::Manifest::new(
                ctx.project_config, ctx.opt_level, ctx.emit_debug_info,
                manifest_stdlib_archive);
            const build_fp: u128 = manifest.compute_fingerprint(&mod_entries);
            build_fp_hex = Compiler::BuildManifest::Manifest::hex128(build_fp);

            if (manifest.is_up_to_date(build_fp_hex, &manifest_artifacts)) {
                // Nothing changed and the artifact still exists: skip
                // frontend, codegen, and linking entirely.
                const up_to_date_out: string = if (config.requires_entry_point()) {
                    manifest_artifacts[0]
                } else {
                    ""
                };
                fmt::println(f"{config.project_name} is up to date ({config.profile})");
                mut utd_result: CompilationResult = CompilationResult::ok(up_to_date_out);
                utd_result.stdlib_root = ctx.stdlib_root;
                return utd_result;
            }
        }

        // -- Per-target arena: ACTIVATE ----------------------------------
        // From here through linking, every `T[]`/`HashMap`/`Box`/`String`
        // allocation (the frontend/mono/sema/codegen container heap, ~1 GB)
        // bumps the per-target arena instead of libc, to be bulk-reclaimed at
        // the next target's reset rather than leaking with this target's
        // heap-leaked CompilationContext.  Placed AFTER the up-to-date
        // short-circuit and every pre-pass error return (those stay inactive)
        // and AFTER the cross-reset survivors are built (the ProjectConfig
        // clone at ~844, ctx.stdlib_root at ~879).  Deactivated before result
        // construction below (success) and in `project_failure_release` (every
        // pass-failure path), so the active flag never leaks past a target.
        Compiler::Codegen::AstArena::cryo_alloc_arena_set_active(true);

        // -- Per-target LLVM context: CREATE -----------------------------
        // Publish a fresh LLVMContextRef for this target's codegen.  All leaf
        // LLVM type/module/builder factories route through it (LContext::
        // current()), so disposing it at the target boundary reclaims the
        // ~385 MiB of type tables + named structs that otherwise stack in the
        // never-disposed global context across the lib+bin builds.  Created
        // here (before any LLVM type is built - frontend/mono/sema/codegen all
        // follow) and disposed on every exit path alongside the arena flip.
        //
        // LSP mode skips this: codegen is gated off (line ~1726) and the only
        // passes that run - frontend/sema/mono + the Cryo-side TypeLowering
        // (layouts, recursive-type + static_assert checks; no LLVM types) - never
        // touch the codegen context.  Creating an LLVMContext per keystroke and
        // disposing it frees back to LLVM's libc allocator, which retains the
        // pages (RSS never drops), so an editing session climbs even though the
        // context is logically freed each compile.  Skipping the create avoids
        // that entirely; the null disposes downstream are no-ops.
        match (ctx.mode) {
            CompileMode::Lsp => { }
            _ => { Compiler::Codegen::LLVMTypes::set_codegen_context_new(); }
        }

        // Allocate local buffers for per-module ASTs and scopes.
        // Using local variables avoids deep nested struct field assignment
        // (ctx.module_graph.field = x) which the codegen may not persist.
        const buf_size: u64 = n as u64 * 8;
        const ast_buf: void* = intrinsics::malloc(buf_size);
        mem::zero<u8>(ast_buf as u8*, buf_size);

        mut pipeline: PassRegistry = PassRegistry::new();
        pipeline.set_verbose(this.config.verbose_passes);

        // Run each stage across ALL modules before advancing to the next; see
        // the stage-driver block below for why the ordering is load-bearing.
        if (!this.run_frontend(ctx, &pipeline, ast_buf)) {
            return this.project_failure_release(ctx, ast_buf);
        }
        if (!this.run_module_resolution(ctx, &pipeline, ast_buf)) {
            return this.project_failure_release(ctx, ast_buf);
        }
        if (!this.collect_type_declarations(ctx, &pipeline, ast_buf)) {
            return this.project_failure_release(ctx, ast_buf);
        }

        if (!this.register_templates(ctx, &pipeline, ast_buf)) {
            return this.project_failure_release(ctx, ast_buf);
        }
        if (!this.expand_defaults_and_signatures(ctx, &pipeline, ast_buf)) {
            return this.project_failure_release(ctx, ast_buf);
        }
        if (!this.resolve_types(ctx, &pipeline, ast_buf)) {
            return this.project_failure_release(ctx, ast_buf);
        }

        tm_frontend_end = Instant::now().as_nanos();

        // Specialization runs as three ordered stages across all modules:
        // directives (layout flags) -> body typecheck (mono-after-sema) ->
        // monomorphization.  Each must complete for EVERY module before the
        // next begins (see the stage-driver block for the invariants).
        if (!this.process_directives(ctx, &pipeline, ast_buf)) {
            return this.project_failure_release(ctx, ast_buf);
        }
        if (!this.typecheck_bodies(ctx, &pipeline, ast_buf)) {
            return this.project_failure_release(ctx, ast_buf);
        }
        if (!this.monomorphize(ctx, &pipeline, ast_buf)) {
            return this.project_failure_release(ctx, ast_buf);
        }

        // Spec routing: deferred injection of the specs mono created, before
        // semantic analysis so the DI is fully populated for sema.
        if (!this.route_specializations(ctx, ast_buf)) {
            return this.project_failure_release(ctx, ast_buf);
        }

        // Soundness assertion: every specialization must have been routed to an
        // owner module.  A leftover means its owner key matched no module, so
        // its definition would never be emitted -> link failure.  Fail loudly
        // here rather than producing a silently broken binary.
        if (ctx.monomorphizer != null) {
            const orphaned: i64 = ctx.monomorphizer.uninjected_spec_count();
            if (orphaned > 0) {
                ctx.diagnostics.emit(Diagnostic::error(
                    ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    format("spec routing left %d specialization(s) unowned (no module matched their owner key)",
                        orphaned)));
                return this.project_failure_release(ctx, ast_buf);
            }
        }

        // Invariant: every queued specialization must be drained before
        // semantic analysis starts.  Its sema walks the shared TypeArena
        // expecting every InstantiatedType wrapper to point at a
        // specialized AST that's already been emitted.  A non-empty
        // worklist here means a specialization pass exited early without
        // draining; the system would still produce output but sema
        // would silently see unresolved generic params, and the bug
        // would surface as a downstream codegen mangle/link failure.
        // Cheap insurance for an invariant the pass order silently relies on.
        if (ctx.monomorphizer != null && !ctx.monomorphizer.worklist_empty()) {
            const remaining: i64 = ctx.monomorphizer.pending_count();
            ctx.diagnostics.emit(Diagnostic::error(
                ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("monomorphizer worklist not drained between monomorphization and semantic analysis (%d pending)",
                    remaining)));
            return this.project_failure_release(ctx, ast_buf);
        }

        tm_mono_end = Instant::now().as_nanos();

        // ====================================================================
        // Per-module incremental cache: decide which modules can reuse their
        // on-disk object file instead of re-running SemanticAnalysis + Codegen.
        // Whole-program monomorphization (Phases 1-6a) has just finished, so
        // spec ownership and every module's source are final.  Two key
        // formulas (see build_manifest.cryo for the soundness argument):
        //   - a module that OWNS specializations folds a GLOBAL digest of all
        //     source hashes (its .o embeds instances whose type-args can come
        //     from any consumer) => rebuild on any source change;
        //   - a module that owns none folds only its transitive import
        //     closure's source hashes (every layout its .o can depend on is
        //     reachable there) => unaffected by unrelated edits.
        // Bias is toward rebuilding: anything unprovable disables the cache.
        // ====================================================================
        if (do_incremental && ctx.project_config != null) {
            pm_active = true;

            // Per-module source hashes (indexed by module index).
            mut pm_src_h: u128[] = [];
            for (mut m: u32 = 0; m < n; m++) {
                const mi: ModuleInfo* = &ctx.module_graph.modules[m];
                pm_src_h.push(Compiler::BuildManifest::Manifest::module_source_hash(
                    ctx.intern_table.resolve(mi.name),
                    ModuleInfo::origin_subdir(mi.origin, mi.origin_name),
                    mi.file_path));
            }

            const pm_tool_fp: u128 = Compiler::BuildManifest::Manifest::toolchain_fingerprint(
                ctx.project_config, ctx.opt_level, ctx.emit_debug_info);

            // Spec ownership.  A spec whose owner can't be attributed to a
            // module would let a stale .o win, so disable the cache (full
            // rebuild) rather than risk a miscompile.
            mut pm_owns_spec: boolean[] = [];
            for (mut m: u32 = 0; m < n; m++) { pm_owns_spec.push(false); }
            if (ctx.monomorphizer != null) {
                const sc: i64 = ctx.monomorphizer.spec_count();
                for (mut s: i64 = 0; s < sc; s++) {
                    const os: SymbolStr = ctx.monomorphizer.spec_owner_source_at(s);
                    if (!os.is_valid()) { pm_active = false; continue; }
                    const oidx: i64 = ctx.module_graph.find_module_by_path(
                        ctx.intern_table.resolve(os));
                    if (oidx >= 0 && oidx < n as i64) {
                        pm_owns_spec[oidx] = true;
                    } else {
                        pm_active = false;
                    }
                }
                // Generic-METHOD specs (attached to an impl block / receiver decl)
                // are not in `spec_entries`; their emitting module is recorded
                // separately.  Flag it too - otherwise an upstream owner that only a
                // DOWNSTREAM module's spec demand reaches (`Logger` -> `Stderr::write<Str>`
                // in `io::stdio`) is misclassified as a leaf, its stale object (which
                // predates the spec) is reused, and the definition is missing at link.
                const mc: i64 = ctx.monomorphizer.spec_owner_module_count();
                for (mut s: i64 = 0; s < mc; s++) {
                    const key: SymbolStr = ctx.monomorphizer.spec_owner_module_at(s);
                    if (!key.is_valid()) { pm_active = false; continue; }
                    const src: SymbolStr = ctx.module_graph.source_file_for_owner_key(
                        key, ctx.intern_table);
                    if (!src.is_valid()) { pm_active = false; continue; }
                    const midx: i64 = ctx.module_graph.find_module_by_path(
                        ctx.intern_table.resolve(src));
                    if (midx >= 0 && midx < n as i64) {
                        pm_owns_spec[midx] = true;
                    } else {
                        pm_active = false;
                    }
                }
            }

            // Global digest over every module's source hash, in topo order.
            mut pm_global_h: Fnv128Hasher = Fnv128Hasher::new();
            pm_global_h.fold(pm_tool_fp);
            for (mut i: u32 = 0; i < n; i++) {
                pm_global_h.fold(pm_src_h[order[i] as i64]);
            }
            const pm_global: u128 = pm_global_h.finish128();

            const pm_prior: BuildManifest::ModuleKeyTable =
                Compiler::BuildManifest::ModuleKeyTable::read_module_keys(ctx.project_config.module_keys_path());

            // Per-module key (indexed by module index, parallel arrays).
            // `pm_closure_ok` clears for any module whose import closure came
            // back short; such a module is never served from cache.
            mut pm_closure_ok: boolean[] = [];
            for (mut m: u32 = 0; m < n; m++) { pm_cached.push(false); pm_closure_ok.push(true); }

            // Modules the compiler imports on a module's behalf - the prelude,
            // and the f-string runtime when an f-string appears anywhere - are
            // force-discovered AFTER the import graph is built and never get a
            // dependency edge from the modules that go on to import them.  The
            // closure walk therefore cannot reach them, and unlike an
            // unresolvable dependency name nothing reports the gap: the walk
            // completes, just short.  A layout change to a prelude-reachable
            // type would leave every consumer's key unchanged while its `.o`
            // still had the old field offsets baked in.
            //
            // Folded into every leaf key rather than repaired by adding the
            // edges: `dependencies` also drives name resolution and link
            // order, and which modules actually receive the injection is not
            // settled until AutoImport runs, so widening the key is the change
            // that cannot be wrong in the dangerous direction.  Owner modules
            // already fold the global digest and so are covered.
            mut pm_implicit: boolean[] = [];
            for (mut i: u32 = 0; i < n; i++) { pm_implicit.push(false); }
            mut pm_implicit_short: boolean = false;
            if (ctx.mode.auto_imports_enabled() && !config.no_std) {
                this.mark_implicit_closure(ctx, "std::prelude", n,
                                           &pm_implicit, &pm_implicit_short);
                if (ctx.module_graph.uses_fstring) {
                    this.mark_implicit_closure(ctx, "std::fmt::interp", n,
                                               &pm_implicit, &pm_implicit_short);
                }
            }
            for (mut m: u32 = 0; m < n; m++) {
                const mi: ModuleInfo* = &ctx.module_graph.modules[m];
                const ns: string = ctx.intern_table.resolve(mi.name);
                mut k: Fnv128Hasher = Fnv128Hasher::new();
                k.fold(pm_tool_fp);
                if (pm_owns_spec[m as i64]) {
                    k.fold("owner");
                    k.fold(pm_global);
                } else {
                    k.fold("leaf");
                    mut clos_incomplete: boolean = false;
                    const clos: boolean[] =
                        ctx.module_graph.compute_import_closure(m, n, &clos_incomplete);
                    for (mut i: u32 = 0; i < n; i++) {
                        // The implicit set is unioned in rather than folded
                        // separately so a module reached BOTH ways still folds
                        // exactly once and the key stays order-stable.
                        if (clos[order[i] as i64] || pm_implicit[order[i] as i64]) {
                            k.fold(pm_src_h[order[i] as i64]);
                        }
                    }
                    // An unresolvable dependency name left the closure short, so
                    // this key doesn't cover everything the module was compiled
                    // against.  Rebuild rather than risk a stale `.o`.
                    if (clos_incomplete) { pm_closure_ok[m as i64] = false; }
                    // Same reasoning for the implicit set: if the prelude's own
                    // closure came back short, the widened key is short too.
                    if (pm_implicit_short) { pm_closure_ok[m as i64] = false; }
                }
                pm_key_names.push(ns);
                pm_key_hex.push(Compiler::BuildManifest::Manifest::hex128(k.finish128()));
            }

            // Cached if the prior key matches AND the .o is still on disk.
            if (pm_active) {
                for (mut m: u32 = 0; m < n; m++) {
                    if (!pm_closure_ok[m as i64]) { continue; }
                    const mi: ModuleInfo* = &ctx.module_graph.modules[m];
                    const prior_k: string = pm_prior.lookup(pm_key_names[m as i64]);
                    if (prior_k == "") { continue; }
                    if (prior_k != pm_key_hex[m as i64]) { continue; }
                    const objp: string = format("%s/%s.o",
                        ctx.project_config.deps_dir_for(
                            ModuleInfo::origin_subdir(mi.origin, mi.origin_name)),
                        Compiler::BuildManifest::Manifest::path_module(ctx.intern_table.resolve(mi.name)));
                    if (metadata::exists(Path::from(objp))) {
                        pm_cached[m as i64] = true;
                    }
                }
            }
        }

        // Semantic analysis: GenericValidation + MoveCheck + DropInsertion +
        // Codegen preparation.  Now that every module has been monomorphized and
        // specialized ASTs injected, GenericValidation can safely walk the
        // entire arena without false positives from not-yet-monomorphized
        // modules.  FunctionBodyTypeCheck already ran in `typecheck_bodies`
        // (before mono); this stage is post-mono validation only.
        // BodiesTypeChecked is an INCOMING
        // provision here (sema provided it earlier) so MoveCheck's requirement
        // is satisfied.
        pipeline.set_passes([
            PassID::GenericValidation,
            PassID::FunctionBodyTypeCheck,
            PassID::MoveCheck,
            PassID::DeadCodeAnalysis,
            PassID::DropInsertion,
            PassID::TypeLowering,
        ]);
        {
            mut initial6b: ProvisionSet = ProvisionSet::empty();
            initial6b.mark(Provision::ASTValidated);
            initial6b.mark(Provision::NamesResolved);
            initial6b.mark(Provision::TypesResolved);
            initial6b.mark(Provision::StructFieldsSynced);
            initial6b.mark(Provision::MonomorphizationComplete);
            initial6b.mark(Provision::GenericExpressionsResolved);
            initial6b.mark(Provision::BodiesTypeChecked);
            pipeline.validate_with_initial(initial6b);
        }

        mut phase6_failed: boolean = false;
        for (mut i: u32 = 0; i < n; i++) {
            // Cached module: its source + dependencies are unchanged, so its
            // bodies already type-/move-checked clean in the build that
            // produced the reusable .o.  Skip sema/lowering entirely; nothing
            // downstream (cross-module descriptors, other modules' codegen,
            // linking) reads a cached module's lowered AST.
            if (pm_active && pm_cached[order[i] as i64]) { continue; }
            CompilerInstance::load_module(ctx, ctx.intern_table, ast_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::NamesResolved);
            ctx.provisions.mark(Provision::TypeDeclarations);
            ctx.provisions.mark(Provision::FunctionSignatures);
            ctx.provisions.mark(Provision::TemplatesRegistered);
            ctx.provisions.mark(Provision::TypesResolved);
            ctx.provisions.mark(Provision::StructFieldsSynced);
            ctx.provisions.mark(Provision::MonomorphizationComplete);
            ctx.provisions.mark(Provision::GenericExpressionsResolved);
            ctx.provisions.mark(Provision::BodiesTypeChecked);
            if (!pipeline.run_all(ctx)) {
                phase6_failed = true;
            }
            pipeline.reset();
        }

        tm_sema_end = Instant::now().as_nanos();

        // Dump ASTs if requested (even on errors, for debugging)
        if (this.config.show_ast) {
            for (mut i: u32 = 0; i < n; i++) {
                const mi: u32 = order[i];
                if (mi < n && ast_buf != null) {
                    const dump_slot: void** = (ast_buf as void**) + mi;
                    const dump_ast: ProgramNode* = *dump_slot as ProgramNode*;
                    if (dump_ast != null) {
                        const mod_info: ModuleInfo* = &ctx.module_graph.modules[mi];
                        fmt::println(f"\n=== AST: {mod_info.file_path} ===");
                        ASTDumper::dump(dump_ast, ctx.intern_table);
                    }
                }
            }
        }

        if (this.config.debug) {
            ctx.type_arena.debug_dump();
        }

        // Invariant guard (gated by CRYO_TYPE_AUDIT): canonical type identity.
        // Off by default; zero cost when unset.
        //
        // Checks the property the whole interner exists to provide - for any two
        // TypeRefs denoting the same semantic type, `a.id == b.id`.  Run HERE,
        // after every stage that mints or mutates types in place
        // (monomorphization's `swap_wrapper_to_concrete`, sema's resolution) and
        // before codegen consumes those ids, so a fork is caught at its widest
        // point rather than after it has already skewed a vtable or a mangle.
        //
        // A violation is an ICE rather than a warning: forked identity produces
        // wrong output, not a diagnostic, so continuing past it just buries the
        // symptom somewhere further downstream.
        match (env::var(Str::new("CRYO_TYPE_AUDIT"))) {
            Option::Some(_) => {
                const forked: i64 = ctx.type_arena.verify_canonical_identity();
                if (forked > 0) {
                    ctx.diagnostics.emit(Diagnostic::error(
                        ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                        format("canonical type identity violated: %d interned entr(ies) do not resolve to themselves by their own key (type identity has forked)",
                            forked)));
                    phase6_failed = true;
                } else {
                    fmt::eprintln("[type-audit] canonical type identity OK (0 violations)");
                }
            }
            Option::None => { }
        }

        // Codegen: per-module IR generation, optimization, object emission.
        // Each module gets its own LLVM module. Cross-module references are
        // resolved through SymbolResolver.
        cdebug("[Compiler] Codegen gate: phase6_failed=%d, codegen_enabled=%d, errors=%u\n",
            phase6_failed as int, ctx.mode.codegen_enabled() as int, ctx.diagnostics.error_count);
        if (!phase6_failed && ctx.mode.codegen_enabled()) {
            cdebug("[Compiler] Codegen: %u modules\n", n);

            // Concise per-package build summary.  Codegen only runs on a real
            // (non-short-circuited) build and never under LSP, so this is safe
            // to print to stdout.  Test mode owns its own runner output, so
            // skip the summary there to keep `cryo test` output clean.
            if (!ctx.mode.skip_user_main()) {
                mut n_std: u32 = 0;
                mut n_local: u32 = 0;
                mut n_dep: u32 = 0;
                mut n_vendor: u32 = 0;
                for (mut si: u32 = 0; si < n; si++) {
                    const sinfo: ModuleInfo* = &ctx.module_graph.modules[order[si]];
                    match (sinfo.origin) {
                        ModuleOrigin::Stdlib => { n_std += 1; }
                        ModuleOrigin::Dep    => { n_dep += 1; }
                        ModuleOrigin::Local  => { n_local += 1; }
                        ModuleOrigin::Vendor => { n_vendor += 1; }
                    }
                }
                fmt::printf(
                    "Building %s [%s]: %u local",
                    config.project_name, config.profile, n_local);
                if (n_std > 0) { fmt::printf(", %u std", n_std); }
                if (n_dep > 0) { fmt::printf(", %u dep", n_dep); }
                if (n_vendor > 0) { fmt::printf(", %u vendor", n_vendor); }
                fmt::printf(" module(s)\n");

                // Report how many modules' objects are being reused from the
                // per-module incremental cache vs. recompiled this build.
                if (pm_active) {
                    mut n_reused: u32 = 0;
                    for (mut si: u32 = 0; si < n; si++) {
                        if (pm_cached[order[si] as i64]) { n_reused += 1; }
                    }
                    if (n_reused > 0) {
                        fmt::println(f"  reusing {n_reused} cached object(s), recompiling {n - n_reused}");
                    }
                }
            }

            // Per-module LLVM IR (`.ll`) output dir is computed PER MODULE at
            // the write site below, grouped by origin under the per-profile
            // cache (`<output_dir>/target/<profile>/<origin>/ir`). The linker's
            // combined-IR dump (`run_linking`) globs `<profile>/*/ir/*.ll`
            // across all origins, and selfhost-check's stage-3/stage-4
            // byte-identity gate reads the resulting `<name>.ll`. Keep these
            // paths in lockstep with `ProjectConfig::ir_dir_for()`.

            // Parallel per-module object emission (see
            // .todo/plans/PARALLEL-CODEGEN.md).  The per-module pipeline now
            // runs IR generation ONLY; object emission is split off so it can
            // run on a worker pool.  IR generation stays SERIAL - it reads
            // shared compiler state (arena, intern table, lazily-declared
            // cross-module externs) - while each module's LLVM module + context
            // is self-contained and emits independently.
            pipeline.set_passes([
                PassID::IRGeneration,
            ]);
            {
                mut initial7: ProvisionSet = ProvisionSet::empty();
                initial7.mark(Provision::ASTValidated);
                initial7.mark(Provision::NamesResolved);
                initial7.mark(Provision::TypesResolved);
                initial7.mark(Provision::StructFieldsSynced);
                initial7.mark(Provision::MonomorphizationComplete);
                initial7.mark(Provision::GenericExpressionsResolved);
                initial7.mark(Provision::GenericsValidated);
                initial7.mark(Provision::BodiesTypeChecked);
                initial7.mark(Provision::TypesLowered);
                pipeline.validate_with_initial(initial7);
            }

            // Resolve the requested worker count: CLI `--codegen-threads=N`
            // (CompilerConfig) wins, then cryoconfig `[compiler] codegen_threads`
            // (ProjectConfig), else -1 (auto = online CPU count).  Never affects
            // emitted bytes.
            mut cg_req: i32 = this.config.codegen_threads_override;
            if (cg_req < 0 && config.codegen_threads >= 0) {
                cg_req = config.codegen_threads as i32;
            }
            if (cg_req < 0 && ctx.project_config != null
                && ctx.project_config.codegen_threads >= 0) {
                cg_req = ctx.project_config.codegen_threads as i32;
            }
            const cg_threads: u32 = CompilerInstance::codegen_thread_count(n, cg_req);

            // Object emission runs the per-module LLVM backend (SelectionDAG /
            // regalloc at O2) - the build's single most expensive phase - across
            // `cg_threads` workers.  Default mode is IN-PROCESS THREADED: each
            // module has its own `LLVMContext` + target machine, so a
            // thread-enabled libLLVM emits them concurrently with no shared
            // mutable state (the recipe rustc/ThinLTO use).  Two alternates via
            // `CRYO_CODEGEN_MODE`:
            //   * "process" - each object compiled by a child `cryo __emit-obj`
            //     from bitcode (full process isolation; costs a bitcode
            //     round-trip). Kept as a fallback / cross-check.
            //   * "serial" - force single-threaded in-process emit.
            // `cg_threads == 1` is serial regardless of mode.  Threaded emit is
            // batched to at most `cg_batch_cap` live modules (a peak-RSS guard).
            const cg_mode: string = CompilerInstance::codegen_mode();
            mut multiproc: boolean = cg_mode == "process"
                && cg_threads > 1 && n >= CODEGEN_MULTIPROC_MIN_MODULES;
            mut self_exe:  string = "";
            if (multiproc) {
                match (env::current_exe()) {
                    Option::Some(s) => { self_exe = s.into_raw(); }
                    Option::None    => { multiproc = false; }
                }
            }
            // In-flight cap for the threaded path: bounds live LLVM contexts so
            // the whole target's modules never sit in memory at once.  `serial`
            // mode (or a 1-thread build) caps at 1 -> flush every module
            // immediately, byte-identical to the serial path.
            mut cg_batch_cap: u32 = cg_threads;
            if (cg_mode == "serial" || cg_threads <= 1) { cg_batch_cap = 1; }

            // The per-TARGET codegen context (published before sema/mono) is
            // superseded by per-MODULE contexts below; dispose it up front so
            // the first `set_codegen_context_new_keep_prior` doesn't orphan it.
            Compiler::Codegen::LLVMTypes::dispose_codegen_context();

            // Per-topo-position object path to hand the linker ("" = nothing to
            // register: a cached hit records its own path, an IRText/Asm/-o
            // artifact isn't relinked, or the module failed).  Registering AFTER
            // the whole loop, in topo order, keeps the linker's input order
            // identical regardless of the order objects finish emitting.
            mut cg_obj: string[] = [];
            mut cg_failed: boolean = false;
            for (mut r: u32 = 0; r < n; r++) { cg_obj.push(""); }

            // Multi-process collection: parallel arrays of (bitcode, object)
            // paths + topo position, one per module emitted out-of-process.
            mut mp_bc:  string[] = [];
            mut mp_obj: string[] = [];
            mut mp_pos: u32[] = [];

            // In-process serial fallback batch (used when `!multiproc`).
            mut cg_jobs: EmitJob[] = [];
            mut cg_pos:  u32[] = [];

            for (mut i: u32 = 0; i < n; i++) {
                const _mi: ModuleInfo* = &ctx.module_graph.modules[order[i]];
                const _mn: string = ctx.intern_table.resolve(_mi.name);
                cdebug("[Compiler] Codegen: module %u/%u (%s)\n", i, n, _mn);
                // Cached module: reuse the on-disk object instead of
                // regenerating IR + emitting it.  Recorded at this topo
                // position; registered with everything else below.
                if (pm_active && pm_cached[order[i] as i64]) {
                    cg_obj[i as i64] = format("%s/%s.o",
                        ctx.project_config.deps_dir_for(
                            ModuleInfo::origin_subdir(_mi.origin, _mi.origin_name)),
                        Compiler::BuildManifest::Manifest::path_module(_mn));
                    cdebug("[Compiler] Codegen: reused cached object %s\n", cg_obj[i as i64]);
                    continue;
                }

                // Fresh per-module LLVM context - KEPT alive: its emit job owns
                // it and disposes it after `emit_to_file`, so it must not be
                // freed here (a concurrent worker may still be reading it).  The
                // context-bound TypeRef->LLVMTypeRef cache is reset in lockstep
                // (a ref minted in one context is invalid in the next).  Each
                // `.o` is self-contained (types re-declared per module), so
                // per-module contexts leave objects byte-identical - the
                // selfhost byte-identity gate is the arbiter.
                Compiler::Codegen::LLVMTypes::set_codegen_context_new_keep_prior();
                Compiler::Codegen::TypeMap::TypeMapperCache::reset_shared_type_cache();

                CompilerInstance::load_module(
                    ctx, ctx.intern_table, ast_buf, order[i], n);
                ctx.provisions.clear();
                ctx.provisions.mark(Provision::Tokens);
                ctx.provisions.mark(Provision::AST);
                ctx.provisions.mark(Provision::ASTValidated);
                ctx.provisions.mark(Provision::NamesResolved);
                ctx.provisions.mark(Provision::TypeDeclarations);
                ctx.provisions.mark(Provision::FunctionSignatures);
                ctx.provisions.mark(Provision::TemplatesRegistered);
                ctx.provisions.mark(Provision::TypesResolved);
                ctx.provisions.mark(Provision::StructFieldsSynced);
                ctx.provisions.mark(Provision::MonomorphizationComplete);
                ctx.provisions.mark(Provision::GenericExpressionsResolved);
                ctx.provisions.mark(Provision::GenericsValidated);
                ctx.provisions.mark(Provision::BodiesTypeChecked);
                ctx.provisions.mark(Provision::TypesLowered);

                const _gen_ok: boolean = pipeline.run_all(ctx);

                if (!ctx.artifacts.ir.is_valid()) {
                    // IR generation failed for this module.  The fresh context
                    // has no module to emit; reclaim it now.
                    fmt::eprintln(f"error: codegen failed for module {CompilerInstance::codegen_module_name(ctx, i)}");
                    cg_failed = true;
                    Compiler::Codegen::LLVMTypes::dispose_codegen_context();
                    pipeline.reset();
                    continue;
                }

                const mod_info: ModuleInfo* = &ctx.module_graph.modules[order[i]];
                const mod_name: string = ctx.intern_table.resolve(mod_info.name);

                // Invariant guard (gated by CRYO_CTX_AUDIT): every module must be
                // self-contained in its own context for the zero-copy threaded
                // emitter to be safe.  Off by default; zero cost when unset.
                match (env::var(Str::new("CRYO_CTX_AUDIT"))) {
                    Option::Some(_) => {
                        Compiler::Codegen::Passes::ctx_audit_module(
                            ctx.artifacts.ir.llvm_module, mod_name);
                    }
                    Option::None => { }
                }

                // Write the `.ll` text dump while the module is still on the main
                // thread (before it is handed to a worker), when --emit-llvm is
                // set via CLI flag or cryoconfig args.
                if (this.config.emit_llvm || config.emit_llvm) {
                    mut ir_dir: string = "build/target/release/local/ir";
                    if (ctx.project_config != null) {
                        ir_dir = ctx.project_config.ir_dir_for(
                            ModuleInfo::origin_subdir(
                                mod_info.origin, mod_info.origin_name));
                    }
                    // IR (`.ll`) files mirror the module namespace as
                    // SUBDIRECTORIES under `ir/`, exactly like the object files
                    // under `deps/` - same `Manifest::path_module` mapping - so the
                    // IR tree mirrors the source tree instead of one flat folder
                    // of `__`-joined stems.
                    const ll_rel: string =
                        Compiler::BuildManifest::Manifest::path_module(mod_name);
                    const ll_path: string = format("%s/%s.ll", ir_dir, ll_rel);
                    ProjectConfig::mkdir_p(ll_path.parent_dir());
                    mut ll_err: i8* = null;
                    const ll_ok: i32 = llvm::LLVMPrintModuleToFile(
                        ctx.artifacts.ir.llvm_module, ll_path, &ll_err as void*);
                    if (ll_ok != 0 && ll_err != null) {
                        fmt::eprintln(f"warning: failed to write {ll_path}: {ll_err as string}");
                        llvm::LLVMDisposeMessage(ll_err as void*);
                    }
                }

                // Resolve WHERE/HOW to emit on the MAIN thread (needs ctx + the
                // module graph).
                const tgt: EmitTarget = CodegenPasses::resolve_emit_target(ctx);
                if (tgt.is_ir_text || !tgt.should_register) {
                    // An IR text dump, or an explicit `-o` Asm/Object artifact
                    // for the entry module - rare, entry-only, never fanned out.
                    // Emit in-process now and reclaim this module + context.
                    CodegenPasses::run_object_emission(ctx);
                    mut lmod0: LModule = LModule { raw: ctx.artifacts.ir.llvm_module };
                    lmod0.dispose();
                    ctx.artifacts.ir = IROutput::empty();
                    Compiler::Codegen::LLVMTypes::dispose_codegen_context();
                    pipeline.reset();
                    continue;
                }

                if (multiproc) {
                    // Serialize the module to bitcode and dispose it immediately
                    // (one live context at a time - lower peak RSS than the
                    // in-process batch), then hand its path to a child process.
                    const bc_path: string = format("%s.bc", tgt.emit_path);
                    mut lmbc: LModule = LModule { raw: ctx.artifacts.ir.llvm_module };
                    const wrote: boolean = lmbc.write_bitcode(bc_path);
                    lmbc.dispose();
                    ctx.artifacts.ir = IROutput::empty();
                    Compiler::Codegen::LLVMTypes::dispose_codegen_context();
                    pipeline.reset();
                    if (wrote) {
                        mp_bc.push(bc_path);
                        mp_obj.push(tgt.emit_path);
                        mp_pos.push(i);
                    } else {
                        fmt::eprintln(f"error: codegen failed for module {CompilerInstance::codegen_module_name(ctx, i)}");
                        cg_failed = true;
                    }
                    continue;
                }

                // In-process THREADED emit (ZERO-COPY).  Hand the worker the LIVE
                // module in its own context, plus a target machine built HERE on
                // the main thread (LLVM target setup is single-threaded, and this
                // keeps the worker allocation-free).  The module + context stay
                // alive - owned by the job - until the batch flush disposes them
                // after join; `set_codegen_context_new_keep_prior` (next
                // iteration) mints a fresh context without touching this one.
                // Every module is fully self-contained in its own context, so
                // concurrent emit shares no LLVM state.  Jobs accumulate until the
                // batch reaches `cg_batch_cap`, then emit across `cg_threads`
                // workers; `cg_batch_cap == 1` flushes one at a time, byte-
                // identical to a serial build.
                const cg_tri: string = CodegenPasses::effective_triple(ctx);
                mut cg_tm: LTargetMachine = LTargetMachine::create_target_machine_with_opt(
                    cg_tri, ctx.opt_level as i32);
                cg_jobs.push(EmitJob {
                    llvm_module:     ctx.artifacts.ir.llvm_module,
                    llvm_context:    Compiler::Codegen::LLVMTypes::current_codegen_context(),
                    tm:              cg_tm.raw,
                    emit_path:       tgt.emit_path,
                    emit_type:       tgt.emit_type,
                    triple:          cg_tri,
                    opt_level:       ctx.opt_level,
                    should_register: tgt.should_register,
                    ok:              false,
                    err_msg:         null as string
                });
                cg_pos.push(i);
                // Detach the module from ctx (the job owns it now); do NOT
                // dispose the context here - the job holds it until post-join.
                ctx.artifacts.ir = IROutput::empty();
                pipeline.reset();

                if (cg_jobs.length as u32 >= cg_batch_cap) {
                    CompilerInstance::emit_jobs_threaded(&cg_jobs, cg_threads);
                    for (mut b: i64 = 0; b < cg_jobs.length as i64; b++) {
                        const p: u32 = cg_pos[b];
                        if (cg_jobs[b].ok &&
                            !metadata::exists(Path::from(cg_jobs[b].emit_path))) {
                            // Reported success and wrote nothing. In an
                            // incremental build the previous build's object is
                            // still on disk and would be archived in its place,
                            // silently, so this has to fail the build.
                            fmt::eprintln(f"error: codegen wrote no object for module {CompilerInstance::codegen_module_name(ctx, p)}");
                            cg_failed = true;
                        } else if (cg_jobs[b].ok) {
                            cg_obj[p as i64] = cg_jobs[b].emit_path;
                        } else {
                            const emsg: string = cg_jobs[b].err_msg;
                            if (emsg != null as string) {
                                fmt::eprintln(f"error: codegen failed for module {CompilerInstance::codegen_module_name(ctx, p)}: {emsg}");
                            } else {
                                fmt::eprintln(f"error: codegen failed for module {CompilerInstance::codegen_module_name(ctx, p)}");
                            }
                            cg_failed = true;
                        }
                        if (cg_jobs[b].err_msg != null as string) {
                            llvm::LLVMDisposeMessage(cg_jobs[b].err_msg as void*);
                        }
                    }
                    cg_jobs.clear();
                    cg_pos.clear();
                }
            }

            // Flush any remaining accumulated jobs (the final partial batch).
            if (cg_jobs.length > 0) {
                CompilerInstance::emit_jobs_threaded(&cg_jobs, cg_threads);
                for (mut b: i64 = 0; b < cg_jobs.length as i64; b++) {
                    const p: u32 = cg_pos[b];
                    if (cg_jobs[b].ok &&
                        !metadata::exists(Path::from(cg_jobs[b].emit_path))) {
                        fmt::eprintln(f"error: codegen wrote no object for module {CompilerInstance::codegen_module_name(ctx, p)}");
                        cg_failed = true;
                    } else if (cg_jobs[b].ok) {
                        cg_obj[p as i64] = cg_jobs[b].emit_path;
                    } else {
                        const emsg: string = cg_jobs[b].err_msg;
                        if (emsg != null as string) {
                            fmt::eprintln(f"error: codegen failed for module {CompilerInstance::codegen_module_name(ctx, p)}: {emsg}");
                        } else {
                            fmt::eprintln(f"error: codegen failed for module {CompilerInstance::codegen_module_name(ctx, p)}");
                        }
                        cg_failed = true;
                    }
                    if (cg_jobs[b].err_msg != null as string) {
                        llvm::LLVMDisposeMessage(cg_jobs[b].err_msg as void*);
                    }
                }
                cg_jobs.clear();
                cg_pos.clear();
            }

            // Fan the multi-process emit out to child processes, then record
            // each object (verifying it exists so a crashed worker fails the
            // build rather than silently dropping an object).
            if (multiproc) {
                mut mf_dir: string = "build";
                if (ctx.project_config != null) {
                    mf_dir = ctx.project_config.deps_dir_for("local");
                }
                ProjectConfig::mkdir_p(mf_dir);
                const manifest: string = format("%s/.cryo_emit_manifest.txt", mf_dir);
                const mp_triple: string = CodegenPasses::effective_triple(ctx);
                const emit_ok: boolean = CodegenPasses::run_multiprocess_emit(
                    &mp_bc, &mp_obj, mp_triple, ctx.opt_level, cg_threads,
                    self_exe, manifest);
                if (!emit_ok) { cg_failed = true; }
                for (mut k: i64 = 0; k < mp_pos.length as i64; k++) {
                    if (metadata::exists(Path::from(mp_obj[k]))) {
                        cg_obj[mp_pos[k] as i64] = mp_obj[k];
                    } else {
                        fmt::eprintln(f"error: codegen failed for module {CompilerInstance::codegen_module_name(ctx, mp_pos[k])}");
                        cg_failed = true;
                    }
                }
            }

            // The last per-module context was disposed above; NULL the global
            // (do not dispose) before the target-end teardown, or it double-frees.
            Compiler::Codegen::LLVMTypes::clear_codegen_context_ptr();

            // Register every module's object in topo order - link-stable
            // regardless of the order objects finished emitting.
            for (mut i: u32 = 0; i < n; i++) {
                if (cg_obj[i as i64].length() > 0) {
                    ctx.artifacts.register_object_file(cg_obj[i as i64]);
                }
            }

            tm_codegen_end = Instant::now().as_nanos();

            // test-main synthesis: synthesize the test-runner main when in test mode.
            // Walks the directive registry for `![test]` records, builds
            // a fresh LLVM module containing the descriptor table + main,
            // emits it to disk, and registers it with the linker artifacts.
            if (!ctx.diagnostics.has_errors() && ctx.mode.skip_user_main()) {
                cdebug("[Compiler] test-main synthesis: Synthesizing test main\n");
                const test_result: PassResult = TestMainCodegen::run_test_main_codegen(ctx);
                if (!test_result.success) {
                    fmt::eprintf("error: test-main synthesis failed\n");
                    // The synthesis pass emits a diagnostic on every failure path
                    // (build_test_main / emit_object), but guard defensively: if a
                    // future path returns failure without recording one, the final
                    // has_errors() gate would report a green build with a broken or
                    // missing test binary (a silent CI false-green).
                    if (!ctx.diagnostics.has_errors()) {
                        ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                            "test-main synthesis failed");
                    }
                }
            }

            // Linking: link the per-module objects into the final binary.
            // Only runs when Codegen produced at least one object (executable
            // targets); library/stdlib builds short-circuit inside run_linking.
            if (!ctx.diagnostics.has_errors() && ctx.artifacts.object_files.length > 0) {
                cdebug("[Compiler] Linking: %lld objects\n",
                    ctx.artifacts.object_files.length);
                const link_result: PassResult = CodegenPasses::run_linking(ctx);
                if (!link_result.success) {
                    fmt::eprintf("error: linking failed\n");
                }
            }

            // Compile-once, link-twice: when the multi-target driver tagged this
            // bin to also produce a `[lib]` archive (`bundle_lib_from_bin`), bundle
            // `lib<name>.a` from the objects this bin just linked, minus the entry
            // module's object (so the library carries no `main`).  This reuses the
            // bin's whole-program object set instead of a second full `[lib]`
            // compile; the executable above is untouched (byte-identical).  The
            // archive reflects exactly what links into the executable, so it may
            // omit `[lib]`-only modules the bin's closure never reaches - an
            // accepted trade-off (nothing links this archive; a missing symbol
            // would surface as a loud link error, never a silent miscompile).
            if (config.bundle_lib_from_bin.length() > 0
                    && !ctx.diagnostics.has_errors()
                    && ctx.project_config != null) {
                // Identify the entry module's object to keep it out of the
                // library archive (a library carries no `main`).  Match the
                // module whose file_path ends with the bin's relative
                // entry_point (`src/main.cryo`) - form-independent, unlike the
                // strict path compare, so it works whether the loader stored an
                // absolute or a relative path.
                // cg_obj is indexed by TOPO POSITION; the module at position ti
                // is modules[order[ti]] (see the codegen loop above).
                mut entry_obj: string = "";
                if (config.entry_point.length() > 0) {
                    for (mut ti: u32 = 0; ti < n; ti++) {
                        if (ctx.module_graph.modules[order[ti] as i64].file_path.ends_with(
                                config.entry_point)) {
                            entry_obj = cg_obj[ti as i64];
                            break;
                        }
                    }
                }
                mut lib_objs: string[] = [];
                for (mut oi: i64 = 0; oi < ctx.artifacts.object_files.length; oi++) {
                    const o: string = ctx.artifacts.object_files[oi];
                    if (o.length() == 0) { continue; }
                    if (entry_obj.length() > 0 && o == entry_obj) { continue; }
                    lib_objs.push(o);
                }
                const lib_archive: string = ctx.project_config.lib_archive_path(
                    format("lib%s.a", config.bundle_lib_from_bin));
                ProjectConfig::mkdir_p(ctx.project_config.output_dir);
                const bres: PassResult = CodegenPasses::bundle_object_list(
                    ctx, lib_archive, &lib_objs);
                if (!bres.success) {
                    fmt::eprintf("error: deriving %s from bin objects failed\n", lib_archive);
                } else {
                    cdebug("[Compiler] Compile-once: derived %s from %lld bin object(s)\n",
                        lib_archive, lib_objs.length);
                }
            }
            tm_link_end = Instant::now().as_nanos();
        }

        // Print diagnostic summary on errors, warnings, or debug mode.
        // Without flushing on warnings, codegen-side warnings about
        // silently-dropped function bodies never reach the user; the
        // build looks green, then the linker fails with `undefined
        // reference`.
        // Skip terminal flush in LSP mode; same rationale as in
        // `run_pipeline`: the renderer fprintfs to `g_stderr` which
        // a host that drives the compiler purely as a library hasn't
        // necessarily wired up (the LSP, for one, gets `NULL`).  The
        // language server reads `ctx.diagnostics.diagnostics` directly
        // and emits them as JSON over stdout.

        // A stage required a node's `Res` and no resolver had written one.
        // That is an internal error rather than a licence to search: the
        // consumer was handed `Err` and stopped, so whatever was built below it
        // rests on a refusal nobody diagnosed.
        //
        // Raised only when nothing else failed.  A build that already emitted
        // an error may legitimately have skipped the pass that would have
        // written the answer, and a second, misleading error would bury the
        // real one.  It has to precede the flush below, or the diagnostic lands
        // in a buffer nothing prints.
        //
        // Tallies are per-process, so a `require` reached inside a forked
        // codegen child is not represented here.
        // Spelled in full because the namespace `Compiler::Resolver::Res` and
        // the enum `Res` it declares share a spelling, and a bare `Res::`
        // qualifier binds the type.
        const pending: u64 = Compiler::Resolver::Res::pending_bug_count();
        if (!ctx.diagnostics.has_errors() && pending > 0) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("%llu path-bearing node(s) reached a stage requiring name resolution with no `Res` recorded; first required at %s",
                    pending, Compiler::Resolver::Res::pending_bug_first_site()));
        }

        // A consumer held a canonical name the declaration index does not
        // hold.  Raised on the same terms and for the same reason as the
        // tally above: a name-layer answer is only worth having if the
        // registration it names exists, and a consumer that quietly looked
        // elsewhere would turn the defect into a wrong type instead.
        const unreg: u64 = Compiler::Resolver::Res::unregistered_def_count();
        if (!ctx.diagnostics.has_errors() && unreg > 0) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("%llu canonical name(s) named no registered declaration; first consumed at %s",
                    unreg, Compiler::Resolver::Res::unregistered_def_first_site()));
        }

        const skip_flush: boolean = match (ctx.mode) {
            CompileMode::Lsp => { true }
            _                => { false }
        };
        if (!skip_flush
                && (ctx.diagnostics.has_errors()
                    || ctx.diagnostics.has_warnings()
                    || this.config.debug)) {
            ctx.diagnostics.flush();
            if (ctx.diag_renderer != null) {
                ctx.diag_renderer.print_summary(
                    ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
            }
        }

        // -- Per-target arena: DEACTIVATE (success path) -----------------
        // Frontend -> codegen -> linking are done.  Turn routing off so the
        // cross-reset survivors built below (the returned `exe_path`, the
        // manifest side-files) land in libc and outlive the next target's
        // reset.  Free/realloc still recognise arena pointers via `owns()`,
        // so this flip never strands a live arena block to libc `free`.
        Compiler::Codegen::AstArena::cryo_alloc_arena_set_active(false);

        // -- Per-target LLVM context: DISPOSE (success path) -------------
        // Codegen + linking are done (linking reads on-disk objects, not LLVM
        // modules; the per-module LLVMModuleRefs were each disposed in the
        // Codegen loop).  Free this target's whole LLVM context now so its
        // type tables don't survive into the next target.  Nothing below
        // touches LLVM (exe_path + manifest are pure string/file work).
        Compiler::Codegen::LLVMTypes::dispose_codegen_context();

        if (ctx.diagnostics.has_errors()) {
            return CompilationResult::failed(
                ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
        }
        // Construct the executable path the linker just produced
        // (`<output_dir>/<project_name>[.exe]`, at the build root - same
        // shape as `bin_artifact_path_for_target` / CodegenPasses::run_linking)
        // so `cryo run` knows where to exec.  Library / stdlib targets have
        // no entry point, so we leave output_path empty for those.  Test-mode
        // builds add a `-test` suffix to coexist with a regular build of the
        // same project; `run_linking` applies the same suffix.  On Windows
        // targets the helper appends `.exe` so the reported path matches
        // what the linker actually wrote.
        mut exe_path: string = "";
        if (ctx.project_config != null
                && ctx.project_config.requires_entry_point()) {
            exe_path = CodegenPasses::bin_artifact_path_for_target(ctx.project_config, ctx);
        }

        // Build succeeded: record the fingerprint sidecar (consulted by the
        // next build's short-circuit) and the human/tooling-facing manifest.
        // Gated on `do_incremental`; the fingerprint locals were computed
        // before the frontend ran. Side files only; no effect on the IR.
        if (do_incremental && ctx.project_config != null) {
            const manifest: BuildManifest::Manifest = Compiler::BuildManifest::Manifest::new(
                ctx.project_config, ctx.opt_level, ctx.emit_debug_info,
                manifest_stdlib_archive);
            manifest.write_fingerprint(build_fp_hex);
            manifest.write_manifest(&mod_entries, build_fp_hex, &manifest_artifacts);
            // Per-module cache keys for the NEXT build to consult.  Written
            // whenever they were computed: every module not marked cached was
            // just recompiled, so its key now matches its on-disk .o.
            if (pm_key_names.length > 0) {
                Compiler::BuildManifest::ModuleKeyTable::write_module_keys(
                    ctx.project_config.module_keys_path(),
                    &pm_key_names, &pm_key_hex);
            }
        }

        // CRYO_TIMINGS report: per-phase wall time + the frontend/backend
        // split that gates the per-module-incremental design (only the
        // backend - SemanticAnalysis + Codegen + link - is cacheable per module; the
        // frontend and whole-program monomorphization must always run).
        if (tm_on) {
            // Use the last mark that actually fired as the build end, so the
            // report is sane for library/codegen-disabled builds too.
            mut tm_end: i64 = tm_sema_end;
            if (tm_codegen_end > tm_end) { tm_end = tm_codegen_end; }
            if (tm_link_end > tm_end)    { tm_end = tm_link_end; }
            const total: i64 = tm_end - tm_entry;
            const fe: i64 = tm_mono_end - tm_entry;
            const be: i64 = tm_end - tm_mono_end;
            fmt::println(f"\n=== cryo build timings ({config.project_name}) ===");
            CompilerInstance::timing_fmt("discovery (discovery)", tm_discovery_end - tm_entry, total);
            CompilerInstance::timing_fmt("frontend (frontend)", tm_frontend_end - tm_discovery_end, total);
            CompilerInstance::timing_fmt("monomorphization (6a)", tm_mono_end - tm_frontend_end, total);
            CompilerInstance::timing_fmt("sema/lowering (6b)", tm_sema_end - tm_mono_end, total);
            if (tm_codegen_end > 0) {
                CompilerInstance::timing_fmt("codegen+objects (7)", tm_codegen_end - tm_sema_end, total);
            }
            if (tm_link_end > 0) {
                CompilerInstance::timing_fmt("link (8)", tm_link_end - tm_codegen_end, total);
            }
            fmt::printf("  %-28s\n", "----");
            CompilerInstance::timing_fmt("FRONTEND (1-6a, uncacheable)", fe, total);
            CompilerInstance::timing_fmt("BACKEND  (6b+7+link, cacheable)", be, total);
            CompilerInstance::timing_fmt("TOTAL", total, total);
        }

        // Name-resolution instrumentation (Phase 0 of the name-resolution
        // unification plan, `.todo/NAME_RESOLUTION_PLAN.md`).  Pure
        // measurement; no-op unless CRYO_RESOLVE_COUNTER is set.  Pin
        // CRYO_CODEGEN_THREADS=1 for a baseline, or multiprocess codegen
        // drops the child tallies.
        ResolveCounter::report();

        mut ok_result: CompilationResult = CompilationResult::ok(exe_path);
        ok_result.stdlib_root = ctx.stdlib_root;
        intrinsics::free(ast_buf);
        return ok_result;
    }

    // ========================================================================
    // Multi-module stage drivers
    //
    // `compile_project_with_ctx` runs the pipeline one STAGE at a time across
    // ALL modules before advancing, rather than one module through all stages.
    // Cross-module invariants force this: e.g. every template must be
    // registered (register_templates) before any module's default-expansion
    // runs, and every module must be monomorphized before generic validation
    // walks the shared arena.  Each driver below owns one such stage; the
    // provision marks are the exact per-module preconditions that stage's
    // passes consume.  All return false on the first module that fails, and
    // the caller performs the buffer-releasing failure return.
    // ========================================================================

    /// Frontend: Lexing, Parsing, ConfigGating, ASTValidation, CHeaderImport
    /// over every module in topological order.  Records each module's parse
    /// tree into `ast_buf` and the module_graph AST table (for out-of-band LSP
    /// consumers).
    run_frontend(&this, ctx: CompilationContext*, pipeline: PassRegistry*,
                 ast_buf: void*) -> boolean {
        const order: &u32[] = &ctx.module_graph.topo_order;
        const n: u32 = order.length as u32;
        cdebug("[Compiler] Frontend: %u module(s)\n", n);
        pipeline.set_passes([PassID::Lexing, PassID::Parsing,
                             PassID::ConfigGating,
                             PassID::ASTValidation, PassID::CHeaderImport]);
        pipeline.validate();

        for (mut i: u32 = 0; i < n; i++) {
            const mod_idx: u32 = order[i];
            ctx.switch_to_module(mod_idx as i64);
            if (!pipeline.run_all(ctx)) {
                fmt::eprintln(f"error: frontend pipeline failed for module {i}");
                return false;
            }
            // Save the parsed AST using local buffer
            const ast_slot: void** = (ast_buf as void**) + mod_idx;
            *ast_slot = ctx.artifacts.ast.root as void*;
            // Mirror into the module_graph's per-module AST table so
            // out-of-band consumers (the LSP for hover/definition) can
            // retrieve a module's AST after the orchestrator returns;
            // the local `ast_buf` goes out of scope at end of function.
            ctx.module_graph.set_module_ast(mod_idx, ctx.artifacts.ast.root);
            pipeline.reset();
            ctx.provisions.clear();
        }
        return true;
    }

    /// Module resolution, in two sweeps over every module: AutoImport +
    /// ImportResolution + NameDeclaration, then NameResolution.
    ///
    /// The sweeps are separate because an import is answered from the declaring
    /// module's EXPORTS, which exist only once that module has been declared.
    /// Declaring and walking a module together makes that a property of the
    /// topological order, and inside an import cycle no order can put every
    /// declarer first: the module walked first processes its import against a
    /// partner that has exported nothing, declares no symbol for it, and the
    /// name stays absent from its scope for the whole compilation.  Declaring
    /// every module first makes the invariant true by construction - the same
    /// reason `register_templates` runs across all modules before any
    /// DefaultExpansion consults the registry.
    run_module_resolution(&this, ctx: CompilationContext*, pipeline: PassRegistry*,
                          ast_buf: void*) -> boolean {
        const order: &u32[] = &ctx.module_graph.topo_order;
        const n: u32 = order.length as u32;

        pipeline.set_passes([PassID::AutoImport, PassID::ImportResolution,
                             PassID::NameDeclaration]);
        {
            mut initial3: ProvisionSet = ProvisionSet::empty();
            initial3.mark(Provision::ASTValidated);
            pipeline.validate_with_initial(initial3);
        }

        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module(ctx, ctx.intern_table, ast_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            if (!pipeline.run_all(ctx)) {
                return false;
            }
            pipeline.reset();
        }

        pipeline.set_passes([PassID::NameResolution]);
        {
            mut initial3b: ProvisionSet = ProvisionSet::empty();
            initial3b.mark(Provision::ASTValidated);
            initial3b.mark(Provision::NamesDeclared);
            pipeline.validate_with_initial(initial3b);
        }

        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module(ctx, ctx.intern_table, ast_buf,
                                                     order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::ImportsDiscovered);
            ctx.provisions.mark(Provision::ModulesLoaded);
            ctx.provisions.mark(Provision::ModuleOrder);
            ctx.provisions.mark(Provision::NamesDeclared);
            if (!pipeline.run_all(ctx)) {
                return false;
            }
            pipeline.reset();
        }
        return true;
    }

    /// TypeDeclaration: register all type NAMES in the arena across all modules
    /// before resolving any signatures.  Handles forward references (e.g.
    /// node.cryo uses ASTVisitor* defined in visitor.cryo, which depends on
    /// node).
    collect_type_declarations(&this, ctx: CompilationContext*, pipeline: PassRegistry*,
                              ast_buf: void*) -> boolean {
        const order: &u32[] = &ctx.module_graph.topo_order;
        const n: u32 = order.length as u32;
        pipeline.set_passes([PassID::TypeDeclaration]);
        {
            mut initial4a: ProvisionSet = ProvisionSet::empty();
            initial4a.mark(Provision::ASTValidated);
            initial4a.mark(Provision::NamesResolved);
            pipeline.validate_with_initial(initial4a);
        }

        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module(ctx, ctx.intern_table, ast_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::ImportsDiscovered);
            ctx.provisions.mark(Provision::ModulesLoaded);
            ctx.provisions.mark(Provision::ModuleOrder);
            ctx.provisions.mark(Provision::NamesResolved);
            if (!pipeline.run_all(ctx)) {
                return false;
            }
            pipeline.reset();
        }
        return true;
    }

    /// TemplateRegistration across ALL modules first, so every generic template
    /// is in the shared registry before any module's DefaultExpansion consults
    /// it.  Making the cross-module visibility invariant true by construction
    /// (rather than relying on topo order) fixes bare-template rewrites when the
    /// import graph places a consumer before its declarer in `order[]`.
    register_templates(&this, ctx: CompilationContext*, pipeline: PassRegistry*,
                       ast_buf: void*) -> boolean {
        const order: &u32[] = &ctx.module_graph.topo_order;
        const n: u32 = order.length as u32;
        pipeline.set_passes([PassID::TemplateRegistration]);
        {
            mut initial4b0: ProvisionSet = ProvisionSet::empty();
            initial4b0.mark(Provision::ASTValidated);
            initial4b0.mark(Provision::NamesResolved);
            initial4b0.mark(Provision::TypeDeclarations);
            pipeline.validate_with_initial(initial4b0);
        }

        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module(ctx, ctx.intern_table, ast_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::ImportsDiscovered);
            ctx.provisions.mark(Provision::ModulesLoaded);
            ctx.provisions.mark(Provision::ModuleOrder);
            ctx.provisions.mark(Provision::NamesResolved);
            ctx.provisions.mark(Provision::TypeDeclarations);
            if (!pipeline.run_all(ctx)) {
                return false;
            }
            pipeline.reset();
        }
        return true;
    }

    /// DefaultExpansion + FunctionSignature.  With templates globally
    /// registered, DefaultExpansion sees every cross-module template and
    /// FunctionSignature resolves the rewritten annotations.  The two run in
    /// one module iteration because signature resolution is guarded by
    /// `!resolved_type.is_valid()`, so a later re-walk would skip them.
    expand_defaults_and_signatures(&this, ctx: CompilationContext*, pipeline: PassRegistry*,
                                   ast_buf: void*) -> boolean {
        const order: &u32[] = &ctx.module_graph.topo_order;
        const n: u32 = order.length as u32;
        pipeline.set_passes([PassID::DefaultExpansion,
                             PassID::FunctionSignature]);
        {
            mut initial4b: ProvisionSet = ProvisionSet::empty();
            initial4b.mark(Provision::ASTValidated);
            initial4b.mark(Provision::NamesResolved);
            initial4b.mark(Provision::TypeDeclarations);
            initial4b.mark(Provision::TemplatesRegistered);
            pipeline.validate_with_initial(initial4b);
        }

        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module(ctx, ctx.intern_table, ast_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::ImportsDiscovered);
            ctx.provisions.mark(Provision::ModulesLoaded);
            ctx.provisions.mark(Provision::ModuleOrder);
            ctx.provisions.mark(Provision::NamesResolved);
            ctx.provisions.mark(Provision::TypeDeclarations);
            ctx.provisions.mark(Provision::TemplatesRegistered);
            if (!pipeline.run_all(ctx)) {
                return false;
            }
            pipeline.reset();
        }
        return true;
    }

    /// TypeResolution + StructFieldTypeSync over every module.
    resolve_types(&this, ctx: CompilationContext*, pipeline: PassRegistry*,
                  ast_buf: void*) -> boolean {
        const order: &u32[] = &ctx.module_graph.topo_order;
        const n: u32 = order.length as u32;
        pipeline.set_passes([PassID::TypeResolution, PassID::StructFieldTypeSync]);
        {
            mut initial5: ProvisionSet = ProvisionSet::empty();
            initial5.mark(Provision::ASTValidated);
            initial5.mark(Provision::NamesResolved);
            initial5.mark(Provision::TypeDeclarations);
            initial5.mark(Provision::FunctionSignatures);
            initial5.mark(Provision::TemplatesRegistered);
            pipeline.validate_with_initial(initial5);
        }

        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module(ctx, ctx.intern_table, ast_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::NamesResolved);
            ctx.provisions.mark(Provision::TypeDeclarations);
            ctx.provisions.mark(Provision::FunctionSignatures);
            ctx.provisions.mark(Provision::TemplatesRegistered);
            if (!pipeline.run_all(ctx)) {
                return false;
            }
            pipeline.reset();
        }
        return CompilerInstance::check_export_grants(ctx);
    }

    /// Report every `export` that names something it cannot grant (E0241).
    ///
    /// Run here, once, after the LAST module's type resolution rather than
    /// inside the per-module pass: a declaration's visibility is recorded as
    /// its own module resolves, and `is_candidate_public` answers "public" for
    /// anything not yet recorded.  Asked mid-stage, the same export would be
    /// accepted or rejected depending on where its target landed in topological
    /// order - the discovery-order defect this spec exists to remove, relocated
    /// into a diagnostic.
    ///
    /// Only the brace form can fail this way.  A bare `export A::B;` names a
    /// module, and a path that names no module is already E0500 at discovery.
    static check_export_grants(ctx: CompilationContext*) -> boolean {
        const intern: InternTable* = ctx.intern_table;
        mut ok: boolean = true;
        for (mut mi: u32 = 0; mi < ctx.module_graph.modules.length; mi++) {
            const root: ProgramNode* = ctx.module_graph.get_module_ast(mi);
            if (root == null) { continue; }
            for (mut si: i64 = 0; si < root.statements.length; si++) {
                const stmt: ASTNode* = root.statements[si];
                if (stmt == null) { continue; }
                if (stmt.kind != NodeKind::ImportDeclaration) { continue; }
                const exp: ImportDeclNode* = stmt as ImportDeclNode*;
                if (!exp.is_export) { continue; }
                for (mut ii: i64 = 0; ii < exp.specific_imports.length; ii++) {
                    const item: SymbolStr = exp.specific_imports[ii];
                    const item_str: string = intern.resolve(item);
                    const qual_str: string =
                        format("%s::%s", exp.module_path, item_str);
                    const qual: SymbolStr = intern.intern(qual_str);

                    // An item naming a SUBMODULE grants that module, exactly as
                    // the same item in an `import` brace list does.
                    if (ctx.module_graph.find_module_index(qual) >= 0) { continue; }

                    // Ask the index the same question the gate asks, so an
                    // export and a use site can never disagree about whether a
                    // name exists.
                    const alts: SymbolStr[] =
                        ctx.decl_index.lookup_qualified_alternatives(item);
                    mut found: boolean = false;
                    for (mut ai: i64 = 0; ai < alts.length; ai++) {
                        if (alts[ai].id == qual.id) { found = true; }
                    }

                    if (found) {
                        if (ctx.decl_index.is_candidate_public(qual)) { continue; }
                        mut pdiag: Diagnostic = Diagnostic::error(
                            ErrorCode::E0241_EXPORT_NOT_GRANTABLE,
                            format("`%s` is private in `%s` and cannot be re-exported",
                                   item_str, exp.module_path));
                        if (exp.span.has_location()) {
                            pdiag = pdiag.at_with_label(exp.span,
                                "an export cannot widen visibility");
                        }
                        pdiag = pdiag.with_note(format(
                            "`%s` is declared `private`, so no importer may name it through any number of re-exports",
                            item_str));
                        ctx.emit_diagnostic(pdiag);
                        ok = false;
                        continue;
                    }

                    // Silent unless the leaf resolves NOWHERE.  A leaf that
                    // exists elsewhere but not under this path is equally an
                    // error, but claiming so requires the index to be complete
                    // for every declaration kind, and a wrong E0241 would
                    // reject a legal program.  The narrower claim needs only
                    // that the index knows the name at all.
                    if (alts.length > 0) { continue; }
                    mut ndiag: Diagnostic = Diagnostic::error(
                        ErrorCode::E0241_EXPORT_NOT_GRANTABLE,
                        format("`%s` is not declared in `%s`",
                               item_str, exp.module_path));
                    if (exp.span.has_location()) {
                        ndiag = ndiag.at_with_label(exp.span,
                            "no such item to re-export");
                    }
                    ndiag = ndiag.with_note(
                        "an export names an item the path declares, or a submodule of it");
                    ctx.emit_diagnostic(ndiag);
                    ok = false;
                }
            }
        }
        return ok;
    }

    /// DirectiveProcessing for ALL modules, before any Monomorphization.  Mono
    /// clones generic templates, and a template's `![repr]`/`![align]` layout
    /// flags are only set once *its* module's directives have run; since the
    /// mono worklist is global, a spec requested by an early module would
    /// otherwise be cloned before its (later) template module's directives were
    /// processed, silently dropping the layout onto every instantiation.
    process_directives(&this, ctx: CompilationContext*, pipeline: PassRegistry*,
                       ast_buf: void*) -> boolean {
        const order: &u32[] = &ctx.module_graph.topo_order;
        const n: u32 = order.length as u32;
        pipeline.set_passes([PassID::DirectiveProcessing]);
        {
            mut init6ai: ProvisionSet = ProvisionSet::empty();
            init6ai.mark(Provision::ASTValidated);
            init6ai.mark(Provision::NamesResolved);
            init6ai.mark(Provision::TypesResolved);
            init6ai.mark(Provision::StructFieldsSynced);
            pipeline.validate_with_initial(init6ai);
        }
        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module(ctx, ctx.intern_table, ast_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::NamesResolved);
            ctx.provisions.mark(Provision::TypeDeclarations);
            ctx.provisions.mark(Provision::FunctionSignatures);
            ctx.provisions.mark(Provision::TemplatesRegistered);
            ctx.provisions.mark(Provision::TypesResolved);
            ctx.provisions.mark(Provision::StructFieldsSynced);
            if (!pipeline.run_all(ctx)) {
                return false;
            }
            pipeline.reset();
        }
        return true;
    }

    /// FunctionBodyTypeCheck (semantic analysis) for ALL modules, BEFORE
    /// Monomorphization - the mono-after-sema flip.  Sema is the single source
    /// of truth for resolved types; it needs every module's directives
    /// processed (so layout flags are visible) but must precede mono so it, not
    /// mono, resolves generic call return types.
    typecheck_bodies(&this, ctx: CompilationContext*, pipeline: PassRegistry*,
                     ast_buf: void*) -> boolean {
        const order: &u32[] = &ctx.module_graph.topo_order;
        const n: u32 = order.length as u32;
        pipeline.set_passes([PassID::FunctionBodyTypeCheck]);
        {
            mut init6sema: ProvisionSet = ProvisionSet::empty();
            init6sema.mark(Provision::ASTValidated);
            init6sema.mark(Provision::NamesResolved);
            init6sema.mark(Provision::TypesResolved);
            init6sema.mark(Provision::StructFieldsSynced);
            init6sema.mark(Provision::DirectivesProcessed);
            pipeline.validate_with_initial(init6sema);
        }
        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module(ctx, ctx.intern_table, ast_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::NamesResolved);
            ctx.provisions.mark(Provision::TypeDeclarations);
            ctx.provisions.mark(Provision::FunctionSignatures);
            ctx.provisions.mark(Provision::TemplatesRegistered);
            ctx.provisions.mark(Provision::TypesResolved);
            ctx.provisions.mark(Provision::StructFieldsSynced);
            ctx.provisions.mark(Provision::DirectivesProcessed);
            if (!pipeline.run_all(ctx)) {
                return false;
            }
            pipeline.reset();
        }
        return true;
    }

    /// Monomorphization + GenericExpressionResolution for ALL modules, now that
    /// every template carries its final layout and sema has resolved the types
    /// mono specializes.
    monomorphize(&this, ctx: CompilationContext*, pipeline: PassRegistry*,
                 ast_buf: void*) -> boolean {
        const order: &u32[] = &ctx.module_graph.topo_order;
        const n: u32 = order.length as u32;
        pipeline.set_passes([
            PassID::Monomorphization,
            PassID::GenericExpressionResolution,
        ]);
        {
            mut initial6a: ProvisionSet = ProvisionSet::empty();
            initial6a.mark(Provision::ASTValidated);
            initial6a.mark(Provision::NamesResolved);
            initial6a.mark(Provision::TypesResolved);
            initial6a.mark(Provision::StructFieldsSynced);
            initial6a.mark(Provision::DirectivesProcessed);
            pipeline.validate_with_initial(initial6a);
        }

        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module(ctx, ctx.intern_table, ast_buf, order[i], n);
            ctx.provisions.clear();
            ctx.provisions.mark(Provision::Tokens);
            ctx.provisions.mark(Provision::AST);
            ctx.provisions.mark(Provision::ASTValidated);
            ctx.provisions.mark(Provision::NamesResolved);
            ctx.provisions.mark(Provision::TypeDeclarations);
            ctx.provisions.mark(Provision::FunctionSignatures);
            ctx.provisions.mark(Provision::TemplatesRegistered);
            ctx.provisions.mark(Provision::TypesResolved);
            ctx.provisions.mark(Provision::StructFieldsSynced);
            ctx.provisions.mark(Provision::DirectivesProcessed);
            if (!pipeline.run_all(ctx)) {
                return false;
            }
            pipeline.reset();
        }
        return true;
    }

    /// Spec routing: send every specialization mono created to its
    /// DETERMINISTIC owner module (the template's defining module) and
    /// register + inject it there, so a spec's object-file home is a function
    /// of its template, not of which module first demanded it.  Each owner
    /// module is loaded as `ctx` so AST placement and DeclarationIndex
    /// ownership stay consistent.  Runs while still in bootstrap mode so spec
    /// registration can fall back to the arena.
    route_specializations(&this, ctx: CompilationContext*,
                          ast_buf: void*) -> boolean {
        const order: &u32[] = &ctx.module_graph.topo_order;
        const n: u32 = order.length as u32;
        for (mut i: u32 = 0; i < n; i++) {
            CompilerInstance::load_module(ctx, ctx.intern_table, ast_buf, order[i], n);
            if (!SpecializationPasses::route_specializations_to_owners(ctx).success) {
                return false;
            }
        }
        return true;
    }

    /// Release the per-module AST / scope buffers allocated by
    /// `compile_project_with_ctx` and forward to `project_failure`.
    /// Used at every failure return inside the orchestrator so the
    /// LSP daemon (which calls back into `compile_project_with_ctx`
    /// once per project change) does not leak ~16 bytes per module
    /// per recompile.
    project_failure_release(&this, ctx: CompilationContext*,
                            ast_buf: void*)
            -> CompilationResult {
        // Per-target arena: DEACTIVATE (failure path).  This is the single
        // chokepoint for all 12 pass-failure returns in
        // compile_project_with_ctx, so the active flag never leaks past a
        // failed target into the next target's survivor construction.
        Compiler::Codegen::AstArena::cryo_alloc_arena_set_active(false);
        // Dispose this target's LLVM context too (frees any modules/types
        // built before the failure).  Single chokepoint for all 12
        // pass-failure returns, so the context never leaks past a failed target.
        Compiler::Codegen::LLVMTypes::dispose_codegen_context();
        intrinsics::free(ast_buf);
        return this.project_failure(ctx);
    }

    /// Helper: build a failure result from context diagnostics.
    project_failure(&this, ctx: CompilationContext*) -> CompilationResult {
        // Same LSP-mode skip as the success path in compile_project_with_ctx:
        // the renderer's stderr stream may be `NULL` when the compiler runs
        // as a library inside another process.  The diagnostic array stays
        // populated for the LSP to read and emit as JSON.
        const skip_flush: boolean = match (ctx.mode) {
            CompileMode::Lsp => { true }
            _                => { false }
        };
        if (!skip_flush) {
            ctx.diagnostics.flush();
            if (ctx.diag_renderer != null) {
                ctx.diag_renderer.print_summary(
                    ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
            }
        }
        return CompilationResult::failed(
            ctx.diagnostics.error_count, ctx.diagnostics.warning_count);
    }


    static resolve_stdlib_root(cli_override: string,
                                 cryoconfig_override: string,
                                 project_root: string,
                                 tried_out: string[]*) -> string {
        // 0. CLI override.
        if (cli_override.length() > 0) {
            if (metadata::exists(Path::from(cli_override + "/lib.cryo"))) {
                return cli_override;
            }
            if (tried_out != null) {
                tried_out.push(format("%s  (--stdlib)", cli_override));
            }
        }

        // 1. Explicit env var.
        match (env::var(Str::new("CRYO_STDLIB"))) {
            Option::Some(v) => {
                // Returned directly on match, so the value must outlive this
                // scope: `into_raw` hands back an owned, NUL-terminated raw
                // `string` (leaked once, like an environ pointer).
                const env_path: string = v.into_raw();
                if (metadata::exists(Path::from(env_path + "/lib.cryo"))) {
                    return env_path;
                }
                if (tried_out != null) {
                    tried_out.push(format("%s  ($CRYO_STDLIB)", env_path));
                }
            }
            Option::None => {}
        }

        // 2. + 3. Install-root env var.  install.sh writes CRYO_HOME into
        // the user's shell rc; the stdlib lives under it at either
        // `<CRYO_HOME>/stdlib` (the simple layout install.sh creates today)
        // or `<CRYO_HOME>/share/cryo/stdlib` (FHS layout, in case packagers
        // pick that).  Cross-platform; does not depend on /proc/self/exe.
        match (env::var(Str::new("CRYO_HOME"))) {
            Option::Some(v) => {
                // Move into a local so the env value drops cleanly at scope
                // exit; a borrowed cstr view builds the (independently
                // allocated) candidate paths, which outlive the drop.
                mut s: String = v;
                const home_path: string = s.as_cstr() as string;
                const cand_home_simple: string = home_path + "/stdlib";
                if (metadata::exists(Path::from(cand_home_simple + "/lib.cryo"))) {
                    return cand_home_simple;
                }
                if (tried_out != null) {
                    tried_out.push(format("%s  ($CRYO_HOME/stdlib)", cand_home_simple));
                }
                const cand_home_share: string = home_path + "/share/cryo/stdlib";
                if (metadata::exists(Path::from(cand_home_share + "/lib.cryo"))) {
                    return cand_home_share;
                }
                if (tried_out != null) {
                    tried_out.push(format("%s  ($CRYO_HOME/share/cryo/stdlib)", cand_home_share));
                }
            }
            Option::None => {}
        }

        // 4. + 5. Binary-relative via /proc/self/exe.  Single 4 KiB scratch
        // buffer is leaked once per compile; same pattern as the path
        // concatenations below, and only happens once per `cryo build`.
        mut self_exe: string = "";
        match (env::current_exe()) {
            Option::Some(s) => { self_exe = s.into_raw(); }
            Option::None    => {}
        }
        const exe_len: i64 = self_exe.length() as i64;
        if (exe_len > 0) {
            mut exe_buf: i8* = self_exe as i8*;
            const exe_path: string = self_exe;
            // dirname: walk back to the final path separator.  `current_exe()`
            // yields a forward-slash path on Unix (`/proc/self/exe`) but a
            // BACKSLASH path on Windows (`GetModuleFileNameA` returns
            // `C:\...\bin\cryo.exe`), so both separators must terminate the
            // scan - otherwise the Windows path has no `/`, `dir_end` walks to
            // 0, the whole binary-relative block is skipped, and auto-detection
            // silently fails.
            mut dir_end: u64 = (exe_len - 1) as u64;
            while (dir_end > 0) {
                if (exe_path[dir_end] == '/' || exe_path[dir_end] == '\\') { break; }
                dir_end -= 1;
            }
            if (dir_end > 0) {
                exe_buf[dir_end] = 0;
                const bindir: string = exe_buf as string;
                const cand_repo: string = bindir + "/../stdlib";
                if (metadata::exists(Path::from(cand_repo + "/lib.cryo"))) {
                    return cand_repo;
                }
                if (tried_out != null) {
                    tried_out.push(format("%s  (binary-relative)", cand_repo));
                }
                const cand_sys: string = bindir + "/../share/cryo/stdlib";
                if (metadata::exists(Path::from(cand_sys + "/lib.cryo"))) {
                    return cand_sys;
                }
                if (tried_out != null) {
                    tried_out.push(format("%s  (binary-relative share)", cand_sys));
                }
            }
        }

        // 6. cryoconfig `[project] stdlib_root`.  Absolute paths used as-is;
        // relative paths resolved against project_root so a project nested
        // anywhere in the filesystem can still reach a sibling stdlib via
        // `stdlib_root = "../shared-stdlib"`.
        if (cryoconfig_override.length() > 0) {
            mut cand_cfg: string = cryoconfig_override;
            if (cryoconfig_override[0] != '/' && project_root.length() > 0) {
                cand_cfg = project_root + "/" + cryoconfig_override;
            }
            if (metadata::exists(Path::from(cand_cfg + "/lib.cryo"))) {
                return cand_cfg;
            }
            if (tried_out != null) {
                tried_out.push(format("%s  ([project] stdlib_root)", cand_cfg));
            }
        }

        // 7. <project_root>/../stdlib
        const cand_proj: string = project_root + "/../stdlib";
        if (metadata::exists(Path::from(cand_proj + "/lib.cryo"))) {
            return cand_proj;
        }
        if (tried_out != null) {
            tried_out.push(format("%s  (project-relative)", cand_proj));
        }
        // 8. ../stdlib (cwd-relative)
        if (metadata::exists(Path::from("../stdlib/lib.cryo"))) {
            return "../stdlib";
        }
        if (tried_out != null) {
            tried_out.push("../stdlib  (cwd-relative)");
        }
        return "";
    }

    /// Path to the lockfile next to a given cryoconfig.
    static lock_path_for(consumer_root: string) -> string {
        if (consumer_root.length() == 0 || consumer_root.eq(".")) {
            return "cryoconfig.lock";
        }
        return format("%s/cryoconfig.lock", consumer_root);
    }

    /// Reconcile `used` (the vendor bindings this build resolved) with the
    /// `cryoconfig.lock` vendor section.
    ///   - `locked == false`: pin missing entries and update changed ones,
    ///     writing the lock only when something changed.  Always returns true.
    ///   - `locked == true`:  VERIFY only - never writes; prints a diagnostic
    ///     and returns false if any used binding is absent from the lock or its
    ///     content hash drifted.  Returns true when every binding matches.
    /// The packages section is preserved because `read` loads it and `write`
    /// emits it back untouched.
    static sync_vendor_lock(lock_path: string, used: &LockedVendor[], locked: boolean) -> boolean {
        mut lock: Lockfile = Lockfile::read(lock_path);
        mut changed: boolean = false;
        mut drift:   boolean = false;
        for (mut i: i64 = 0; i < used.length; i++) {
            mut found: i64 = -1;
            for (mut j: i64 = 0; j < lock.vendor.length; j++) {
                if (lock.vendor[j].name.eq(used[i].name)
                        && lock.vendor[j].triple.eq(used[i].triple)) {
                    found = j;
                    break;
                }
            }
            if (found < 0) {
                if (locked) {
                    fmt::eprintf("error: --locked: vendor '%s' (triple '%s') has no entry in %s.\n        Run a normal build to record it, then commit the lockfile.\n",
                        used[i].name, used[i].triple, lock_path);
                    drift = true;
                } else {
                    lock.vendor.push(LockedVendor {
                        name:        used[i].name,
                        triple:      used[i].triple,
                        binding_sha: used[i].binding_sha,
                    });
                    changed = true;
                }
            } else if (!lock.vendor[found].binding_sha.eq(used[i].binding_sha)) {
                if (locked) {
                    fmt::eprintf("error: --locked: vendor '%s' (triple '%s') bindings drifted from %s.\n        locked %s, built %s. Run `cryo vendor rebuild %s` and re-lock, or restore the toolchain.\n",
                        used[i].name, used[i].triple, lock_path,
                        lock.vendor[found].binding_sha, used[i].binding_sha, used[i].name);
                    drift = true;
                } else {
                    fmt::eprintf("note: vendor '%s' (triple '%s') bindings changed; updating %s (%s -> %s).\n",
                        used[i].name, used[i].triple, lock_path,
                        lock.vendor[found].binding_sha, used[i].binding_sha);
                    lock.vendor[found].binding_sha = used[i].binding_sha;
                    changed = true;
                }
            }
        }
        if (locked) {
            return !drift;
        }
        if (changed && !Lockfile::write(lock_path, &lock)) {
            fmt::eprintf("warning: could not write vendor pins to %s\n", lock_path);
        }
        return true;
    }

    /// True when the `CRYO_TIMINGS` env var is set to a non-empty value.  Gates
    /// the per-phase wall-time report printed at the end of a successful build.
    static timing_enabled() -> boolean {
        match (env::var(Str::new("CRYO_TIMINGS"))) {
            Option::Some(v) => { return v.length() > 0; }
            Option::None => { return false; }
        }
    }

    /// Render a nanosecond span as milliseconds with one decimal place, plus
    /// its share of `total_ns`.  Pure formatting helper for the timing report.
    static timing_fmt(label: string, span_ns: i64, total_ns: i64) -> void {
        const ms_x10: i64 = (span_ns + 50000) / 100000;
        mut pct: i64 = 0;
        if (total_ns > 0) {
            pct = (span_ns * 100 + total_ns / 2) / total_ns;
        }
        fmt::printf("  %-28s %6lld.%lld ms  (%lld%%)\n",
            label, ms_x10 / 10, ms_x10 % 10, pct);
    }

    /// Parallel-codegen worker count.  `CRYO_CODEGEN_THREADS` overrides; 0/1
    /// mean serial (the byte-identical fallback, kept for selfhost-diff
    /// bisection and `--no-parallel`-style debugging).  The default is the
    /// online CPU count, clamped to the module count so a small build never
    /// oversubscribes.  A per-batch cap of `nthreads` in-flight modules is what
    /// bounds LLVM-side memory (see the codegen loop).
    static codegen_thread_count(module_count: u32, requested: i32) -> u32 {
        mut n: u32 = codegen_default_threads();
        if (requested >= 1) {
            // Explicit CLI `--codegen-threads` / cryoconfig `codegen_threads`
            // (1 = serial).  Wins over everything below.
            n = requested as u32;
        } else {
            // Unset: honor a `CRYO_CODEGEN_THREADS` env override (a debugging
            // escape hatch - the flag / cryoconfig key are the intended UI),
            // else the online CPU count.
            match (env::var(Str::new("CRYO_CODEGEN_THREADS"))) {
                Option::Some(v) => {
                    // Parse a leading unsigned count from the BORROWED view and
                    // let the owned String drop at the arm's end - no
                    // `into_raw`/`free` of the buffer.
                    const s: Str = v.as_str();
                    const len: u64 = s.length;
                    const p: u8* = s.as_ptr();
                    mut acc: u32 = 0;
                    mut got: boolean = false;
                    mut k: u64 = 0;
                    while (k < len) {
                        const ch: u8 = p[k];
                        if (ch >= 48 && ch <= 57) {
                            acc = acc * 10 + ((ch - 48) as u32);
                            got = true;
                            k = k + 1;
                        } else { break; }
                    }
                    if (got && acc >= 1) { n = acc; }
                }
                Option::None => { }
            }
        }
        if (module_count > 0 && n > module_count) { n = module_count; }
        if (n < 1) { n = 1; }
        return n;
    }

    /// Codegen parallelism mode from `CRYO_CODEGEN_MODE` (default "thread").
    ///   "thread" - in-process threaded emit (each module its own context +
    ///               target machine; the default).
    ///   "process" - out-of-process emit via child `cryo __emit-obj` from
    ///               bitcode (full isolation; a bitcode round-trip cost).
    ///   "serial" - force single-threaded in-process emit.
    /// An unrecognized value falls back to "thread".
    static codegen_mode() -> string {
        match (env::var(Str::new("CRYO_CODEGEN_MODE"))) {
            Option::Some(v) => {
                // Borrowed view drives the compare; the owned String drops at
                // the arm's end. The result is a static literal, never the view.
                mut s: String = v;
                const view: string = s.as_cstr() as string;
                mut out: string = "thread";
                if (view == "process") { out = "process"; }
                else if (view == "serial") { out = "serial"; }
                return out;
            }
            Option::None => { return "thread"; }
        }
    }

    /// Emit a batch of ready modules' objects IN-PROCESS on the main thread
    /// (the serial path: `CRYO_CODEGEN_MODE=serial` / a 1-thread or tiny build).
    /// Emits each live module, then disposes the modules/contexts/target
    /// machines (`dispose_emit_jobs`).
    static emit_jobs_serial(jobs: EmitJob[]*) -> void {
        const cnt: i64 = (*jobs).length as i64;
        for (mut j: i64 = 0; j < cnt; j++) {
            codegen_emit_job(&(*jobs)[j]);
        }
        CompilerInstance::dispose_emit_jobs(jobs);
    }

    /// Dispose every job's target machine, module, and context.  Runs on the
    /// MAIN thread after all emits complete (LLVM disposal must not interleave
    /// with concurrent emit).
    static dispose_emit_jobs(jobs: EmitJob[]*) -> void {
        const cnt: i64 = (*jobs).length as i64;
        for (mut j: i64 = 0; j < cnt; j++) {
            if ((*jobs)[j].tm != null) {
                mut t: LTargetMachine = LTargetMachine { raw: (*jobs)[j].tm };
                t.dispose();
            }
            if ((*jobs)[j].llvm_module != null) {
                mut m: LModule = LModule { raw: (*jobs)[j].llvm_module };
                m.dispose();
            }
            if ((*jobs)[j].llvm_context != null) {
                mut c: LContext = LContext { raw: (*jobs)[j].llvm_context };
                c.dispose();
            }
        }
    }

    /// Emit a batch of ready modules' objects IN-PROCESS across a thread pool - 
    /// the true multi-threaded codegen path.  ZERO-COPY: each job carries its
    /// LIVE module in its own `LLVMContext` plus a main-thread-built target
    /// machine; a worker just runs `LLVMTargetMachineEmitToFile`.  Two things
    /// make this safe with a thread-enabled libLLVM (`LLVMIsMultithreaded()==1`
    /// on both the linked Linux `libLLVM.so` and the Windows `LLVM-C.dll`):
    ///   1. Every module is fully self-contained in its own context (the context
    ///      auditor confirms NO type leaks into the shared global context - the
    ///      last such leak was `LLVMAppendBasicBlock`, now `...InContext`), so
    ///      concurrent emit over disjoint modules touches no shared LLVM state.
    ///   2. A worker allocates NO Cryo memory (raw emit call; error reporting
    ///      deferred to the main thread), so the compiler's single-threaded bump
    ///      arena is never accessed off the main thread - no pause needed.
    /// A standalone C++ harness driving the same concurrent emit over these
    /// modules never faults, confirming the LLVM side was never the problem.
    ///
    /// Correctness invariants:
    ///   * The caller finalizes `jobs` (no more pushes) BEFORE calling here, so
    ///     the base pointer the workers index is stable - no realloc dangles it.
    ///   * Workers take DISJOINT round-robin slices, so the only writes
    ///     (`job.ok`) never alias; no lock is needed.
    ///   * Modules/contexts/target machines are disposed on the MAIN thread
    ///     after every worker has joined (`dispose_emit_jobs`).
    ///   * Workers get 64 MiB stacks: LLVM's SelectionDAG recurses deep and
    ///     overflows the ~1 MiB default thread stack.
    /// The name of the module sitting at `pos` in the topological codegen
    /// order, for a failure message.
    ///
    /// A bare index names nothing the reader can open, and it indexes the
    /// ORDER rather than the module graph, so it does not agree with any
    /// numbering the build prints elsewhere - which sends the reader looking
    /// through whichever module happens to carry that id, usually somebody
    /// else's. Returns a placeholder rather than failing: this runs only on a
    /// path that is already reporting an error.
    static codegen_module_name(ctx: CompilationContext*, pos: u32) -> string {
        if (ctx == null) { return "<unknown>"; }
        const order: &u32[] = &ctx.module_graph.topo_order;
        if (pos as i64 >= order.length) { return "<unknown>"; }
        const mi: u32 = order[pos as i64];
        if (mi as i64 >= ctx.module_graph.modules.length) { return "<unknown>"; }
        const info: ModuleInfo* = &ctx.module_graph.modules[mi as i64];
        return ctx.intern_table.resolve(info.name);
    }

    /// `nthreads <= 1` (or a single job) runs the batch inline via
    /// `emit_jobs_serial`, keeping a serial build byte-identical.
    static emit_jobs_threaded(jobs: EmitJob[]*, nthreads: u32) -> void {
        const cnt: i64 = (*jobs).length as i64;
        if (cnt <= 0) { return; }
        if (nthreads <= 1 || cnt <= 1) {
            CompilerInstance::emit_jobs_serial(jobs);
            return;
        }

        mut nw: u32 = nthreads;
        if ((nw as i64) > cnt) { nw = cnt as u32; }

        // Build the per-worker contexts COMPLETELY before spawning any thread:
        // each `EmitWorkerCtx` points at `wcs`'s own storage, so a push after a
        // worker held a pointer into it could realloc and dangle. Fill first,
        // then spawn.
        const base: EmitJob* = (*jobs).as_ptr();
        mut wcs: EmitWorkerCtx[] = [];
        for (mut w: u32 = 0; w < nw; w++) {
            wcs.push(EmitWorkerCtx { jobs: base, count: cnt, start: w, stride: nw });
        }

        // 64 MiB per-worker stacks (SelectionDAG recursion depth).  No arena
        // pause: the workers are allocation-free (see the doc comment), so the
        // single-threaded arena is untouched while they run.
        mut s: thread::Scope = thread::Scope::new_with_stack(64u64 * 1024u64 * 1024);
        for (mut w: u32 = 0; w < nw; w++) {
            s.spawn<EmitWorkerCtx*>(&wcs[w], emit_worker_entry);
        }
        s.join_all();

        // All workers joined; dispose on the main thread.
        CompilerInstance::dispose_emit_jobs(jobs);
    }
}
