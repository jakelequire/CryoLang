/// Declaration Index
///
/// The single post-creation lookup point for resolved declarations.
/// Populated incrementally by TypeResolution and Specialization passes;
/// queried by Sema, codegen, and future consumers.
///
/// Type names are registered under their qualified name only
/// (e.g. "BattleTest::Point").  All callers must qualify names before
/// registration or lookup.  The TypeArena's internal caches are for
/// allocation-time deduplication only; all consumption-time type
/// lookups should go through this index.
///
/// Each registration method is idempotent; re-registering a name with a
/// new TypeRef simply overwrites the old entry.

namespace Compiler::DeclIndex;

import Compiler::AST::Declaration;
import Compiler::Types;
import Compiler::Types::{ TypeRef, Type, Compound, Arena };
import Compiler::Resolver::{ SymbolStr, InternTable, MangledName, QualifiedName };
import std::core::option;
import std::collections::{ hashmap, pair };


/// Outcome of import-scoped bare-leaf name resolution
/// (`DeclarationIndex::resolve_qualified_scoped`).  Distinguishes a clean
/// unique resolution, a same-module (local) definition, a genuine
/// import-visible ambiguity (a hard error the caller must diagnose), and a
/// clean miss.  `Ambiguous` carries no payload; the caller re-fetches the
/// candidate set via `lookup_qualified_alternatives` for the diagnostic.
type enum ScopeResolution {
    NotFound;
    Unique(SymbolStr);
    SameModule(SymbolStr);
    Ambiguous;
}

implement enum ScopeResolution {
    /// The resolved qualified name for a clean/local resolution, or `bare`
    /// unchanged on a miss or ambiguity.  Lets call sites that only want a
    /// name stay one-liners; ambiguity is surfaced separately via
    /// `is_ambiguous` at the authoritative
    /// (type-resolution / sema) sites that own the diagnostic.
    resolved_or(&this, bare: SymbolStr) -> SymbolStr {
        match (&this) {
            ScopeResolution::Unique(q)     => { return q; }
            ScopeResolution::SameModule(q) => { return q; }
            _                              => { return bare; }
        }
    }

    is_ambiguous(&this) -> boolean {
        match (&this) {
            ScopeResolution::Ambiguous => { return true; }
            _                          => { return false; }
        }
    }

    is_found(&this) -> boolean {
        match (&this) {
            ScopeResolution::NotFound => { return false; }
            _                         => { return true; }
        }
    }
}


type struct DeclarationIndex {
    // Function name -> return type
    func_returns:   HashMap<u32, TypeRef>;

    // Function name -> FunctionType TypeRef (full signature in the arena)
    func_type_refs: HashMap<u32, TypeRef>;

    // Packed(type_id, method_id) -> return type
    method_returns: HashMap<u64, TypeRef>;

    // Type name -> TypeRef (for struct, class, enum, trait lookups)
    type_map:       HashMap<u32, TypeRef>;

    // Global variable name -> TypeRef
    global_vars:    HashMap<u32, TypeRef>;

    // Reverse: TypeRef.id -> SymbolStr.id (for looking up a type's name)
    type_reverse:   HashMap<u64, u32>;

    // Per-module declaration ownership.
    // Used by codegen to enumerate "all functions/types defined in Module X".
    // The global maps above remain the fast-path for lookup during sema;
    // these arrays are the slow-path for per-module enumeration.
    module_funcs:        Pair<u32, u32>[];    // .first = SymbolStr.id of function, .second = SymbolStr.id of module
    module_types:        Pair<u32, u32>[];    // .first = SymbolStr.id of type, .second = SymbolStr.id of module
    module_global_keys:       u32[];  // SymbolStr.id of global variable
    module_global_modules:    u32[];  // SymbolStr.id of defining module (source_file)
    module_global_namespaces: u32[];  // SymbolStr.id of defining namespace (e.g.,
                                      // "std::collections::hashmap"). Used by
                                      // codegen to mangle definitions and cross-
                                      // module references with a module-qualified
                                      // path so two modules can each declare the
                                      // same private `const NAME = ...` without
                                      // colliding at link time.

    // Qualified function name -> mangled LLVM symbol name.
    // Computed once at registration time so codegen never mangles.
    mangled_names:       HashMap<u32, u32>;

    // Array element TypeRef.id -> concrete Array_<T> qualified name SymbolStr.id.
    // Populated by the specialization pass so codegen can resolve T[].method()
    // to the monomorphized Array_T struct without name reconstruction.
    array_elem_to_type:  HashMap<u64, u32>;

    // Implicit-conversion registry: Packed(arg_type_id, return_type_id) ->
    // Packed(type_name_id << 32 | method_name_id).  Populated in
    // DirectiveProcessing from `![implicit]` single-param non-generic
    // converters: a static method `Type::method` (type_name_id != 0) or a
    // free function (type_name_id == 0, method_name_id = the function name).
    // Sema reads it at a type-incompatible coercion site (call argument or
    // typed binding) and synthesizes the converter call (e.g. `string` ->
    // `Str` via `Str::new`) instead of emitting E0214/E0200.  Keyed on the
    // resolved canonical arena ids, exactly the ids the use site sees.
    implicit_converters: HashMap<u64, u64>;

    // Static-method converters whose owning type is GENERIC (e.g.
    // `String::from_string` on `String<A>`).  `.first` = owner type-name
    // SymbolStr.id, `.second` = method-name SymbolStr.id.  The
    // monomorphizer force-instantiates each for its default type args so a
    // sema-synthesized `Owner<defaults>::method(arg)` call has a real spec
    // to link against (a non-generic owner like `Str` needs no such help).
    generic_converter_methods: Pair<u32, u32>[];

    // Function overload registry: parallel arrays keyed by function
    // name (SymbolStr.id), storing every registered FunctionType TypeRef
    // and its overload-specific mangled name.  `func_type_refs` and
    // `mangled_names` above each keep only the last registration per
    // name, which collapses overloads like `String::new()` and
    // `String::new(u64)` to a single entry.  Cross-module extern
    // declaration needs every overload's signature AND mangled name,
    // so it walks these arrays instead.
    overload_func_keys:    u32[];     // SymbolStr.id of function name
    overload_func_types:   TypeRef[]; // FunctionType TypeRef for this overload
    overload_func_mangled: u32[];     // SymbolStr.id of mangled LLVM name (0 = unset)
    overload_func_owner:   u32[];     // SymbolStr.id of the owning declaration's
                                      // QUALIFIED name (0 = legacy/global claim:
                                      // extern "C" twins, combined-name and
                                      // qualified-name registrations).  Lets two
                                      // same-signature declarations from different
                                      // modules coexist under one bare leaf
                                      // (`intrinsics::free` vs `alloc::heap::free`)
                                      // instead of being merged into a single
                                      // last-writer-owned entry, and lets the
                                      // bare-call binder filter candidates by the
                                      // use site's imports.

    // Bare-name -> all qualified names ever registered for it.
    // Populated by `register_name_mapping`.
    bare_alts:           Pair<u32, u32>[];    // .first = bare SymbolStr.id, .second = qualified SymbolStr.id

    // --- O(1) indices over the flat arrays above ---------------------------
    // These map a SymbolStr.id key to the position(s) it occupies in the
    // parallel arrays, so registration de-dup and per-name lookups no longer
    // linear-scan every function/overload in the whole program.  Maintained
    // in lockstep with each array push.

    // Function name SymbolStr.id -> positions in the `overload_func_*` arrays.
    overload_index:      HashMap<u32, u32[]>;
    // Bare name SymbolStr.id -> positions in `bare_alts`.
    bare_alts_index:     HashMap<u32, u32[]>;
    // Function SymbolStr.id -> first defining module id (get_function_module
    // is first-wins) plus a packed (func.id, module.id) membership set used by
    // is_function_in_module and the per-module registration de-dup.
    module_func_first:   HashMap<u32, u32>;
    module_func_pairs:   HashMap<u64, boolean>;
    // Mangled LLVM name SymbolStr.id -> positions in the `overload_func_*`
    // arrays (registration order).  Reverse of `overload_func_mangled`, so
    // `resolve_function_by_mangled` finds an overload by its mangled symbol
    // without scanning every registered overload in the program (~3% frontend
    // self-time).  A multimap, not a single slot: a trait-impl method is
    // registered under both its qualified and bare combined names, which emit
    // the identical LLVM symbol but only one of which yields a valid extern at
    // resolve time - the consumer must try each, like the original linear scan.
    mangled_to_overload_pos: HashMap<u32, u32[]>;

    // Leaf-name SymbolStr.id of every `intrinsic function` declaration (the
    // compiler-lowered ones in `core::intrinsics`: memcpy, ptr_diff, panic,
    // atomic_*, ...).  Codegen's inline-intrinsic dispatcher matches a call's
    // leaf name against `IntrinsicKind::is_name`, which is broader than this
    // set (it also covers pure-magic forms like `rotl32`/`bswap32` that have
    // NO declaration).  This set lets codegen tell a genuine intrinsic call
    // from a user/stdlib function that merely shares an intrinsic's leaf name:
    // a pinned `resolved_callee` whose leaf is NOT in here is a real function
    // and must NOT be silently replaced by inline IR.  See
    // `is_intrinsic_decl_name`.
    intrinsic_names:     HashMap<u32, boolean>;

    // Bare C symbol -> owning module/file (intern id) for symbols claimed by an
    // `extern "C"` block specifically. Lets the resolver warn (W0011) when a
    // SECOND extern block tries to claim an already-extern-owned bare slot
    // (e.g. two vendor libs both export `printf`), while staying silent on the
    // intentional intrinsic-wins / function-wins cases (those never record an
    // entry here). See type_resolution.cryo extern-block handling.
    extern_bare_owner:   HashMap<u32, u32>;

    // --- Import-scoped name resolution (resolve_qualified_scoped) -----------
    // Everything below is keyed on the NAMESPACE identity space (e.g.
    // `std::alloc::rc`, `CryoTests::Tests::Lang::LeafDispatchA`), the one space
    // shared by a type's qualified name (namespace = qualified minus leaf),
    // `ModuleInfo.dependencies` (stored as namespace names), and the use site's
    // `current_module_name()`.  It is deliberately stored as resolved SymbolStr
    // ids rather than reached via a ModuleGraph/CompilationContext back-pointer:
    // Cryo forbids circular imports (the module graph must be a DAG), and both
    // module_graph.cryo and compilation_context.cryo already import DeclIndex,
    // so a back-pointer here would be a compile-time module cycle.

    // Use-site namespace SymbolStr.id -> the namespace ids it imports (a copy of
    // that module's `ModuleInfo.dependencies`).  Populated once per module by
    // the orchestrator (instance.cryo) after module discovery.
    module_imports:      HashMap<u32, u32[]>;

    // Namespace SymbolStr.ids re-exported by `std::prelude` (the modules whose
    // public types - Rc, Box, Option, Range, ... - are auto-in-scope in every
    // module).  A LOCAL type whose leaf collides with one of these is a hard
    // conflict (ambiguous), not a silent shadow.  Populated once.
    prelude_ns:          u32[];

    // Qualified type-name SymbolStr.id -> is_public.  Lets import-scoped
    // same-leaf resolution (resolve_qualified_scoped) exclude a PRIVATE
    // cross-module candidate from the visible set so it can't manufacture a
    // false ambiguity on the E0154 static-call-scope path.  Populated by
    // `register_decl_in_index` (type_resolution.cryo) alongside
    // `register_name_mapping`, so every name that can appear as a same-leaf
    // candidate carries a verdict.  A name absent from this map (single-file /
    // C-import types, which never enter the alternatives set) is treated as
    // public (permissive).
    //
    // NOTE on the mechanism hierarchy: this is a SECONDARY guard, not the
    // primary privacy gate.  A bare TYPE NAME is resolved by the NameResolver
    // first, which today exports types unconditionally (see name_resolution.cryo
    // declare_type - `private` on a type is not honored there) and owns the
    // E0203 import-ambiguity diagnostic; the authoritative cross-module privacy
    // check is the ModuleTypeRegistry (E0503).  So for a pure type-name
    // collision the NameResolver front-runs this map.  It still does real work
    // for the import-scoped static-call/template lookups that consult
    // resolve_qualified_scoped directly, and it makes `is_candidate_public`
    // honest rather than a permanently-empty stub.
    type_visibility:     HashMap<u32, boolean>;


    static new() -> DeclarationIndex {
        return DeclarationIndex {
            func_returns:        HashMap<u32, TypeRef>::new(),
            func_type_refs:      HashMap<u32, TypeRef>::new(),
            method_returns:      HashMap<u64, TypeRef>::new(),
            type_map:            HashMap<u32, TypeRef>::new(),
            global_vars:         HashMap<u32, TypeRef>::new(),
            type_reverse:        HashMap<u64, u32>::new(),
            array_elem_to_type:  HashMap<u64, u32>::new(),
            implicit_converters: HashMap<u64, u64>::new(),
            generic_converter_methods: [],
            module_funcs:        [],
            module_types:        [],
            module_global_keys:       [],
            module_global_modules:    [],
            module_global_namespaces: [],
            mangled_names:       HashMap<u32, u32>::new(),
            overload_func_keys:    [],
            overload_func_types:   [],
            overload_func_mangled: [],
            overload_func_owner:   [],
            bare_alts:      [],
            overload_index:     HashMap<u32, u32[]>::new(),
            bare_alts_index:    HashMap<u32, u32[]>::new(),
            module_func_first:  HashMap<u32, u32>::new(),
            module_func_pairs:  HashMap<u64, boolean>::new(),
            mangled_to_overload_pos: HashMap<u32, u32[]>::new(),
            intrinsic_names:    HashMap<u32, boolean>::new(),
            extern_bare_owner:  HashMap<u32, u32>::new(),
            module_imports:     HashMap<u32, u32[]>::new(),
            prelude_ns:         [],
            type_visibility:    HashMap<u32, boolean>::new(),
        };
    }


    // Registration (called by TypeResolution & Specialization passes)

    /// Register a function's return type.
    ///
    /// Intrinsic durability: once a declared `intrinsic function` owns a
    /// leaf (see `register_intrinsic_function_type`), a later same-leaf
    /// regular function must not overwrite the single-slot return type -
    /// the intrinsic's own registration runs BEFORE it is marked, so this
    /// guard never blocks the intrinsic itself, and either registration
    /// order converges on the intrinsic's binding.
    register_function(mut &this, name: SymbolStr, return_type: TypeRef) -> void {
        if (this.intrinsic_names.contains_key(&name.id)) { return; }
        this.func_returns.insert(name.id, return_type);
    }

    /// Register an implicit-conversion converter `(arg_ty) -> ret_ty`.
    /// `type_name_id` is the owning type's bare-name SymbolStr.id for a
    /// static-method converter (`Type::method`), or 0 for a free-function
    /// converter; `method_name_id` is the static method's / function's bare
    /// name.  First-wins so a single converter per (arg, ret) pair is
    /// deterministic regardless of module load order.
    register_implicit_converter(mut &this, arg_id: u64, ret_id: u64,
                                type_name_id: u32, method_name_id: u32) -> void {
        const key: u64 = DeclarationIndex::pack_converter_key(arg_id, ret_id);
        if (!this.implicit_converters.contains_key(&key)) {
            const value: u64 =
                ((type_name_id as u64) << 32) | (method_name_id as u64);
            this.implicit_converters.insert(key, value);
        }
    }

    /// Record a static-method converter on a GENERIC owner type so the
    /// monomorphizer can force-instantiate it.  De-duplicated by
    /// (type, method).
    register_generic_converter_method(mut &this, type_id: u32,
                                      method_id: u32) -> void {
        for (mut i: i64 = 0; i < this.generic_converter_methods.length; i++) {
            const e: &Pair<u32, u32> = &this.generic_converter_methods[i];
            if (e.first == type_id && e.second == method_id) { return; }
        }
        this.generic_converter_methods.push(
            Pair<u32, u32>::new(type_id, method_id));
    }

    /// Register a function's FunctionType TypeRef (full signature in the arena).
    /// `func_type_refs` is a single-slot map (last wins); use the parallel
    /// overload arrays below when every overload matters (cross-module
    /// extern declaration).  Legacy entry point: the overload entry is owned
    /// by nobody (owner 0 = global claim).
    register_function_type(mut &this, name: SymbolStr, func_type_ref: TypeRef) -> void {
        this.register_function_type_owned(name, func_type_ref, SymbolStr::empty());
    }

    /// Owner-aware variant: `owner` is the declaring function's QUALIFIED
    /// name, stamped on the overload entry so two same-signature declarations
    /// from different modules keep separate entries (separate mangled slots),
    /// and so the bare-call binder can filter candidates by the use site's
    /// imports.  De-dup is by (name, TypeRef, owner): re-registering the same
    /// declaration is a no-op; a same-signature declaration from a DIFFERENT
    /// owner appends its own entry instead of silently adopting (and later
    /// re-mangling) the first claimant's.
    register_function_type_owned(mut &this, name: SymbolStr, func_type_ref: TypeRef,
                                 owner: SymbolStr) -> void {
        // Intrinsic durability: the single-slot signature of an
        // intrinsic-owned leaf is not overwritable by regular registrations
        // (the intrinsic itself writes it in `register_intrinsic_function_type`).
        if (!this.intrinsic_names.contains_key(&name.id)) {
            this.func_type_refs.insert(name.id, func_type_ref);
        }
        // Also append to the overload list so cross-module extern
        // declaration can enumerate every overload's signature -- scoped to
        // this name's positions via the overload_index instead of scanning
        // every overload in the program.
        match (this.overload_index.get_ref(&name.id)) {
            Option::Some(positions) => {
                mut k: i64 = 0;
                while (k < (*positions).length) {
                    const pos: u32 = (*positions)[k];
                    if (this.overload_func_types[pos as i64].id == func_type_ref.id
                        && this.overload_func_owner[pos as i64] == owner.id) {
                        return;
                    }
                    k = k + 1;
                }
            }
            Option::None => { }
        }
        const new_pos: u32 = this.overload_func_keys.length as u32;
        this.overload_func_keys.push(name.id);
        this.overload_func_types.push(func_type_ref);
        this.overload_func_mangled.push(0);
        this.overload_func_owner.push(owner.id);
        const slot: u32[]* = this.overload_index.get_or_insert(name.id, []);
        (*slot).push(new_pos);
    }

    /// Like `register_function_type`, but claims SOLE ownership of the bare
    /// leaf name for a compiler intrinsic: any previously-registered overload
    /// (an `extern "C"` libc twin such as `malloc`/`strlen`/`fopen`) is
    /// dropped from the overload index so the leaf-name dispatcher sees only
    /// the intrinsic. An intrinsic is never overloaded, so sole ownership is
    /// correct, and this makes bare-name resolution order-independent: an
    /// intrinsic must win unqualified resolution even when `ffi::libc`
    /// topo-sorts ahead of `core::intrinsics` and its extern twin registers
    /// first (which otherwise strands `malloc`/`strlen`/... at codegen with
    /// an ambiguous second overload, E0636). The qualified `libc::<name>`
    /// form registered separately stays available regardless.
    register_intrinsic_function_type(mut &this, name: SymbolStr, func_type_ref: TypeRef,
                                     owner: SymbolStr) -> void {
        // Record the leaf name as a genuine intrinsic declaration so codegen
        // can distinguish it from a user function that shares the leaf name
        // (see `is_intrinsic_decl_name` and the inline-dispatch guards in
        // call_emitter).  From this point on the leaf's single-slot bindings
        // (func_type_refs / func_returns / mangled_names) are durable: the
        // intrinsic-durability guards in the register_* methods refuse
        // non-intrinsic overwrites, so a later same-leaf regular function
        // (e.g. `alloc::heap::free`) can no longer silently rebind bare
        // calls program-wide.  `owner` is the intrinsic's qualified name
        // (`std::core::intrinsics::free`), stamped on the overload entry for
        // import-scoped candidate reporting.
        this.intrinsic_names.insert(name.id, true);
        this.func_type_refs.insert(name.id, func_type_ref);
        const new_pos: u32 = this.overload_func_keys.length as u32;
        this.overload_func_keys.push(name.id);
        this.overload_func_types.push(func_type_ref);
        this.overload_func_mangled.push(0);
        this.overload_func_owner.push(owner.id);
        // Sole bare ownership drops the UNOWNED claimants only: extern "C"
        // twins (owner 0), whose divergent Cryo signature would otherwise
        // shadow the intrinsic (see method doc).  OWNED same-leaf regular
        // functions (`fs::write` vs intrinsic `write`) keep their entries -
        // they coexist by owner identity and the bare-call binder picks by
        // signature + use-site imports - which also makes this registration
        // order-robust when a regular fn's module registered first.
        mut positions: u32[] = [];
        match (this.overload_index.get_ref(&name.id)) {
            Option::Some(prev) => {
                mut k: i64 = 0;
                while (k < (*prev).length) {
                    const pos: u32 = (*prev)[k];
                    if (this.overload_func_owner[pos as i64] != 0) {
                        positions.push(pos);
                    }
                    k = k + 1;
                }
            }
            Option::None => { }
        }
        positions.push(new_pos);
        this.overload_index.insert(name.id, positions);
    }

    /// True iff `name`'s leaf was declared as a compiler `intrinsic function`
    /// (see `register_intrinsic_function_type`).  Codegen uses this to avoid
    /// silently lowering a user/stdlib function to inline IR just because its
    /// leaf name collides with an entry in `IntrinsicKind::is_name`: a call
    /// with a pinned `resolved_callee` whose leaf is NOT a declared intrinsic
    /// is a real function and must be emitted as a normal call.
    is_intrinsic_decl_name(&this, name: SymbolStr) -> boolean {
        return this.intrinsic_names.contains_key(&name.id);
    }

    /// Record that an `extern "C"` block claimed the bare C symbol `name`,
    /// owned by `module` (an interned file/module id). Called only when the
    /// bare slot is actually claimed by an extern block.
    note_extern_bare_owner(mut &this, name: SymbolStr, module: SymbolStr) -> void {
        this.extern_bare_owner.insert(name.id, module.id);
    }

    /// The module/file id that first claimed bare C symbol `name` via an
    /// `extern "C"` block, or 0 if no extern block owns it (i.e. the bare slot
    /// is unclaimed or owned by an intrinsic / regular function).
    extern_bare_owner_of(&this, name: SymbolStr) -> u32 {
        return match (this.extern_bare_owner.get(&name.id)) {
            Option::Some(m) => { m }
            Option::None    => { 0 }
        };
    }

    /// Associate an overload-specific mangled LLVM name with a registered
    /// (name, func_type_ref) pair.  Cross-module extern declaration uses
    /// this to emit the right LLVM symbol per overload instead of the
    /// single mangled name stored in `mangled_names`.
    register_overload_mangled(mut &this, name: SymbolStr, func_type_ref: TypeRef,
                               mangled: SymbolStr) -> void {
        // Legacy (owner-blind) entry point: matches the first entry with this
        // signature.  Owner-aware callers use `register_overload_mangled_owned`
        // so a same-signature entry from a different declaration is never
        // restamped.
        match (this.overload_index.get_ref(&name.id)) {
            Option::Some(positions) => {
                mut k: i64 = 0;
                while (k < (*positions).length) {
                    const pos: u32 = (*positions)[k];
                    if (this.overload_func_types[pos as i64].id == func_type_ref.id) {
                        const prev: u32 = this.overload_func_mangled[pos as i64];
                        // Intrinsic durability: never restamp the intrinsic's
                        // own entry (its mangled IS the leaf name) with a
                        // different symbol; try the next same-signature entry
                        // (the caller's own) instead.
                        if (this.intrinsic_names.contains_key(&name.id)
                            && prev == name.id && mangled.id != name.id) {
                            k = k + 1;
                            continue;
                        }
                        this.overload_func_mangled[pos as i64] = mangled.id;
                        // Record the reverse mapping only when this position
                        // newly takes this mangled id, so repeated registration
                        // of the same (pos, mangled) pair never duplicates the
                        // bucket entry.
                        if (prev != mangled.id) {
                            const slot: u32[]* = this.mangled_to_overload_pos.get_or_insert(mangled.id, []);
                            (*slot).push(pos);
                        }
                        return;
                    }
                    k = k + 1;
                }
            }
            Option::None => { }
        }
    }

    /// Owner-aware variant of `register_overload_mangled`: stamps the entry
    /// matching (name, signature, owner) exactly, so two same-signature
    /// declarations under one bare leaf each keep their own mangled symbol.
    register_overload_mangled_owned(mut &this, name: SymbolStr, func_type_ref: TypeRef,
                                    owner: SymbolStr, mangled: SymbolStr) -> void {
        match (this.overload_index.get_ref(&name.id)) {
            Option::Some(positions) => {
                mut k: i64 = 0;
                while (k < (*positions).length) {
                    const pos: u32 = (*positions)[k];
                    if (this.overload_func_types[pos as i64].id == func_type_ref.id
                        && this.overload_func_owner[pos as i64] == owner.id) {
                        const prev: u32 = this.overload_func_mangled[pos as i64];
                        this.overload_func_mangled[pos as i64] = mangled.id;
                        if (prev != mangled.id) {
                            const slot: u32[]* = this.mangled_to_overload_pos.get_or_insert(mangled.id, []);
                            (*slot).push(pos);
                        }
                        return;
                    }
                    k = k + 1;
                }
            }
            Option::None => { }
        }
    }

    /// Return every (FunctionType, mangled-name) pair registered under
    /// the given name.  Parallel arrays: `types[i]` goes with `mangled[i]`.
    /// A mangled SymbolStr.id of 0 means no overload-specific mangled name
    /// was registered; callers should fall back to `lookup_mangled_name`.
    lookup_func_type_overloads(&this, name: SymbolStr) -> TypeRef[] {
        mut result: TypeRef[] = [];
        match (this.overload_index.get_ref(&name.id)) {
            Option::Some(positions) => {
                mut k: i64 = 0;
                while (k < (*positions).length) {
                    result.push(this.overload_func_types[(*positions)[k] as i64]);
                    k = k + 1;
                }
            }
            Option::None => { }
        }
        return result;
    }

    lookup_overload_mangled(&this, name: SymbolStr, func_type_ref: TypeRef) -> SymbolStr {
        // Signature match; scans past unmangled entries so a same-signature
        // pair (possible under a bare leaf since entries became per-owner)
        // still yields the entry that actually carries a symbol.
        match (this.overload_index.get_ref(&name.id)) {
            Option::Some(positions) => {
                mut k: i64 = 0;
                while (k < (*positions).length) {
                    const pos: u32 = (*positions)[k];
                    if (this.overload_func_types[pos as i64].id == func_type_ref.id) {
                        const mid: u32 = this.overload_func_mangled[pos as i64];
                        if (mid != 0) {
                            return SymbolStr::from_id(mid);
                        }
                    }
                    k = k + 1;
                }
            }
            Option::None => { }
        }
        return SymbolStr::empty();
    }

    /// Owner-aware mangled lookup: the entry matching (name, signature,
    /// owner) exactly, or empty.
    lookup_overload_mangled_owned(&this, name: SymbolStr, func_type_ref: TypeRef,
                                  owner: u32) -> SymbolStr {
        match (this.overload_index.get_ref(&name.id)) {
            Option::Some(positions) => {
                mut k: i64 = 0;
                while (k < (*positions).length) {
                    const pos: u32 = (*positions)[k];
                    if (this.overload_func_types[pos as i64].id == func_type_ref.id
                        && this.overload_func_owner[pos as i64] == owner) {
                        const mid: u32 = this.overload_func_mangled[pos as i64];
                        if (mid != 0) { return SymbolStr::from_id(mid); }
                        return SymbolStr::empty();
                    }
                    k = k + 1;
                }
            }
            Option::None => { }
        }
        return SymbolStr::empty();
    }

    /// Every overload entry registered under `name`, with its owning
    /// declaration's qualified-name id (0 = legacy/global claim) and its
    /// mangled-symbol id (0 = unset), as three parallel arrays the caller
    /// indexes together.  The bare-call binder uses the owners to filter
    /// candidates by the use site's imports and to name candidates in the
    /// E0154 ambiguity diagnostic.
    lookup_func_overload_owners(&this, name: SymbolStr) -> u32[] {
        mut result: u32[] = [];
        match (this.overload_index.get_ref(&name.id)) {
            Option::Some(positions) => {
                mut k: i64 = 0;
                while (k < (*positions).length) {
                    result.push(this.overload_func_owner[(*positions)[k] as i64]);
                    k = k + 1;
                }
            }
            Option::None => { }
        }
        return result;
    }

    /// The FunctionType of the overload entry that carries this mangled LLVM
    /// symbol, or invalid.  The pinned `resolved_callee` is ground truth for
    /// a call's signature: name-based return lookups (`func_returns` bare
    /// slots) are single-slot and can legitimately belong to a DIFFERENT
    /// same-leaf declaration (an intrinsic-owned leaf keeps the intrinsic's),
    /// so a re-resolution of an already-pinned call must read the entry the
    /// pin actually points at.
    lookup_func_type_by_mangled(&this, mangled: SymbolStr) -> TypeRef {
        match (this.mangled_to_overload_pos.get_ref(&mangled.id)) {
            Option::Some(positions) => {
                if ((*positions).length > 0) {
                    return this.overload_func_types[(*positions)[0] as i64];
                }
            }
            Option::None => { }
        }
        return TypeRef::invalid();
    }

    /// Parallel to `lookup_func_type_overloads` / `lookup_func_overload_owners`:
    /// each entry's mangled-symbol id (0 = unset).
    lookup_func_overload_mangleds(&this, name: SymbolStr) -> u32[] {
        mut result: u32[] = [];
        match (this.overload_index.get_ref(&name.id)) {
            Option::Some(positions) => {
                mut k: i64 = 0;
                while (k < (*positions).length) {
                    result.push(this.overload_func_mangled[(*positions)[k] as i64]);
                    k = k + 1;
                }
            }
            Option::None => { }
        }
        return result;
    }

    /// Register a method's return type on a specific type.
    register_method(mut &this, type_sym: SymbolStr, method_sym: SymbolStr,
                    return_type: TypeRef) -> void {
        const key: u64 = DeclarationIndex::pack_method_key(type_sym, method_sym);
        this.method_returns.insert(key, return_type);
    }

    /// Register a named type (struct, class, enum, trait) under its
    /// qualified name (e.g. "Module::Point").  Callers must qualify the
    /// name before calling.
    register_type(mut &this, qualified_name: SymbolStr, ty: TypeRef) -> void {
        this.type_map.insert(qualified_name.id, ty);

        // Reverse map: TypeRef.id -> qualified name
        this.type_reverse.insert(ty.id, qualified_name.id);
    }

    /// Register a mapping from an array element TypeRef to the concrete
    /// Array_<T> struct's qualified name.  Called by the specialization
    /// pass after monomorphizing Array<T>.
    register_array_element_type(mut &this, element: TypeRef, array_struct_name: SymbolStr) -> void {
        this.array_elem_to_type.insert(element.id, array_struct_name.id);
    }

    /// Look up the concrete Array_<T> struct name for a given element type.
    lookup_array_type_name(&this, element: TypeRef) -> SymbolStr {
        return match (this.array_elem_to_type.get(&element.id)) {
            Option::Some(val) => { SymbolStr::from_id(val) }
            Option::None      => { SymbolStr::empty() }
        };
    }

    /// Register a reverse-only mapping (TypeRef -> qualified name) without
    /// touching the forward type_map.  Used to make additional TypeRefs
    /// (e.g., InstantiatedType, ArrayType) resolvable to an already-
    /// registered concrete type's qualified name.
    register_type_reverse_only(mut &this, qualified_name: SymbolStr, ty: TypeRef) -> void {
        this.type_reverse.insert(ty.id, qualified_name.id);
    }

    /// Register a type alias that maps to an existing type without
    /// overwriting the reverse map.  Use this for aliases like
    /// "double" -> f64 or "int" -> i32 so that reverse lookup returns
    /// the canonical name, not the alias.
    register_type_forward_only(mut &this, alias_name: SymbolStr, ty: TypeRef) -> void {
        this.type_map.insert(alias_name.id, ty);
    }

    /// Register a global variable's type.
    register_global(mut &this, name: SymbolStr, ty: TypeRef) -> void {
        this.global_vars.insert(name.id, ty);
    }

    /// Register a global with its defining module so codegen can walk the
    /// per-module list to emit cross-module externs.  Callers already set
    /// the shared type map via register_global; this method is additive.
    /// `namespace` is the namespace this module declares (e.g.
    /// `std::collections::hashmap`); codegen mangles the global as
    /// `C$<namespace>.<name>` so two modules with the same private
    /// `const NAME = ...` don't collide.  Pass an empty SymbolStr when no
    /// namespace is set (the global stays bare-mangled).
    register_global_with_module(mut &this, name: SymbolStr, ty: TypeRef,
                                 module: SymbolStr, namespace: SymbolStr) -> void {
        this.register_global(name, ty);
        // Dedup so re-processing doesn't grow the list unboundedly.
        for (mut i: i64 = 0; i < this.module_global_keys.length; i++) {
            if (this.module_global_keys[i] == name.id &&
                this.module_global_modules[i] == module.id) {
                // Refresh the recorded namespace in case the global was
                // first registered before its namespace was set.
                this.module_global_namespaces[i] = namespace.id;
                return;
            }
        }
        this.module_global_keys.push(name.id);
        this.module_global_modules.push(module.id);
        this.module_global_namespaces.push(namespace.id);
    }

    /// Convenience: register all methods from a MethodNode*[] array on a type.
    register_methods(mut &this, type_sym: SymbolStr, methods: MethodNode*[]) -> void {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const method: MethodNode* = methods[i];
            if (method == null || method.func == null) { continue; }
            this.register_method(type_sym, method.func.name,
                                 method.func.resolved_return_type);
        }
    }

    /// Register methods with full per-module visibility.
    /// This adds each method to the per-module function list under the
    /// combined key "QualifiedType::method" so that cross-module externs
    /// can declare them and codegen can find them.
    register_methods_with_module(mut &this, type_sym: SymbolStr, methods: &MethodNode*[],
                                  module: SymbolStr, intern: InternTable*,
                                  arena: TypeArena*) -> void {
        this.register_methods_with_module_aliased(
            type_sym, SymbolStr::empty(), methods, module, intern, arena);
    }

    /// Same as `register_methods_with_module` but also registers a bare-name
    /// alias for the combined key (e.g. both `std::core::primitives::string::substring`
    /// AND `string::substring`) in the function/overload registries.  Lets
    /// callers that only know the bare type name (namely codegen's
    /// MemberAccess path on primitives) still find the signature.
    register_methods_with_module_aliased(mut &this,
                                          type_sym: SymbolStr, bare_alias: SymbolStr,
                                          methods: &MethodNode*[],
                                          module: SymbolStr, intern: InternTable*,
                                          arena: TypeArena*) -> void {
        const type_str: string = intern.resolve(type_sym);
        const bare_str: string = if (bare_alias.is_valid()) { intern.resolve(bare_alias) } else { "" };
        for (mut i: i64 = 0; i < methods.length; i++) {
            const method: MethodNode* = methods[i];
            if (method == null || method.func == null) { continue; }
            // Self-returning trait defaults (combinators) are deferred
            // templates with unresolved signatures - they are instantiated
            // lazily at call sites and the concrete spec is registered there
            // (`register_spec_method_in_di`).  Mangling the unresolved
            // template here would hit an invalid TypeRef and ICE.
            if (method.func.is_self_returning_default) { continue; }
            const func: FunctionDeclNode* = method.func;

            // Register in method_returns under the qualified type (existing
            // behavior) AND under the bare alias (so lookup_method_return
            // works for both forms on primitive impls).
            this.register_method(type_sym, func.name, func.resolved_return_type);
            if (bare_alias.is_valid()) {
                this.register_method(bare_alias, func.name, func.resolved_return_type);
            }

            // Build combined key "QualifiedType::method".
            const method_str: string = intern.resolve(func.name);
            const combined: string = format("%s::%s", type_str, method_str);
            const combined_sym: SymbolStr = intern.intern(combined);

            // Build full FunctionType.  Cryo allows three self forms on
            // non-static methods:
            //   `&this` / `mut &this`: stored as a param named "&this",
            //                             semantically a `T*`
            //   `this`:                stored as a param named "this",
            //                             semantically a by-value `T`
            //   (none):                implicit `&this`; synthesize `T*`
            // Only synthesize the prefix when the parameter list contains
            // NEITHER of the explicit forms, otherwise we'd double-count.
            const this_name: SymbolStr = intern.intern("&this");
            const this_val_name: SymbolStr = intern.intern("this");
            mut has_explicit_self: boolean = false;
            for (mut ps: i64 = 0; ps < func.parameters.length; ps++) {
                const pps: VarDeclNode* = func.parameters[ps];
                if (pps == null) { continue; }
                if (pps.name.equals(this_name) || pps.name.equals(this_val_name)) {
                    has_explicit_self = true;
                    break;
                }
            }

            mut param_types: TypeRef[] = [];
            if (!method.is_static && !has_explicit_self) {
                const target_ref: TypeRef = this.lookup_type(type_sym);
                if (target_ref.is_valid()) {
                    const this_ptr_ref: TypeRef = arena.get_pointer_to(target_ref);
                    param_types.push(this_ptr_ref);
                }
            }
            // Collect all explicit parameter types.  `&this` / `mut &this`
            // carry a resolved pointer type from type resolution, but a
            // by-value `this` receiver is left WITHOUT a resolved_type;
            // recover it as the target struct by value (`T`) so the
            // cross-module FunctionType keeps the receiver slot.  Skipping
            // it (the `is_valid()` gate alone) drops the receiver, leaving
            // the extern declaration one argument short of the definition
            // emitted by `declare_method` (which classifies the receiver
            // from the target type directly) - every cross-module call to
            // a by-value method then fails LLVM verification with
            // "incorrect number of arguments".
            for (mut p: i64 = 0; p < func.parameters.length; p++) {
                const param: VarDeclNode* = func.parameters[p];
                if (param == null) { continue; }
                if (param.resolved_type.is_valid()) {
                    param_types.push(param.resolved_type);
                } else if (param.name.equals(this_val_name)) {
                    const recv_ref: TypeRef = this.lookup_type(type_sym);
                    if (recv_ref.is_valid()) {
                        param_types.push(recv_ref);
                    }
                }
            }
            // An unresolved return type cannot be mangled (encode_type_ref
            // ICEs on an invalid TypeRef).  This happens in `check` mode, where
            // monomorphization - which resolves impl-method signatures in a full
            // build - does not run, so a trait-impl method whose trait declares
            // an associated-type projection (`-> Option<This::Item>`) can reach
            // here before its concrete return type is filled.  The mangled
            // symbol only feeds codegen/linking, which `check` skips, so skip
            // the FunctionType registration + mangle rather than aborting the
            // whole compiler.  A full build always has a valid type here (the
            // guard never fires), so this is a no-op for codegen paths.
            if (!func.resolved_return_type.is_valid()) { continue; }
            const func_type_ref: TypeRef = arena.get_function(
                func.resolved_return_type, param_types, func.is_variadic);

            // Register with full signature for cross-module externs.
            this.register_function(combined_sym, func.resolved_return_type);
            this.register_function_type(combined_sym, func_type_ref);

            // Compute and store the mangled LLVM symbol name.  The
            // receiver-kind / non-receiver-params split is shared with the
            // codegen vtable-resolution path (see method_receiver_kind).
            const type_qname: QualifiedName = QualifiedName::from_symbol(type_sym);
            const receiver_kind: ReceiverKind = DeclarationIndex::method_receiver_kind(
                func, method.is_static, intern);
            const method_param_refs: TypeRef[] = DeclarationIndex::method_non_receiver_params(
                func, intern);
            const method_sym: SymbolStr = func.name;
            const mangled_base: MangledName = MangledName::for_method_or_trait_impl(
                intern, arena, type_qname, func.origin_trait, method_sym, receiver_kind,
                method_param_refs, func.resolved_return_type, func.is_variadic);
            // Fold in a generic-method spec's type args (`$MG...`) so the DI stores
            // the same disambiguated symbol the codegen definition + mono pin use;
            // otherwise a cross-module extern of `name<i64>` vs `name<u64>` (whose
            // shared signature mangles identically) would collide.  No-op (empty
            // spec_type_args) for every template / non-spec method.
            const mangled: MangledName = mangled_base.with_method_spec_args(
                intern, arena, func.spec_type_args);
            // A method bound with `![symbol("sym")]` (the C++ binding generator)
            // resolves to the foreign mangled symbol, not the Cryo mangling - so
            // register THAT as the DI symbol, making every consuming module emit
            // it for the cross-module extern.  Read from the parsed directive on
            // the MethodNode (DirectiveProcessing runs later than this pass).
            // Empty for an ordinary method -> Cryo mangling, byte-unchanged.
            const link_str: string = method.link_directive_symbol();
            const eff_mangled: SymbolStr = if (!link_str.eq("")) {
                intern.intern(link_str)
            } else {
                mangled.value
            };
            this.register_mangled_name(combined_sym, eff_mangled);

            // Also associate this overload's mangled name with its
            // FunctionType in the overload registry, so cross-module
            // extern declaration can emit the right LLVM symbol per
            // overload (not just the last-registered one).
            this.register_overload_mangled(combined_sym, func_type_ref, eff_mangled);

            // Bare-name alias.  For impl blocks on primitives (e.g. `implement
            // string`) the qualified form is `std::core::primitives::string::substring`
            // but the consumer (sema + codegen MemberAccess path) only has
            // the bare type name "string".  Mirror the qualified registration
            // under "string::substring" so resolve_function / resolve_function_with_arity
            // finds the signature regardless of which form the call site
            // used.  The LLVM symbol (`mangled.value`) is identical; linking
            // converges on the one defining module.
            if (bare_alias.is_valid()) {
                const bare_combined: string = format("%s::%s", bare_str, method_str);
                const bare_combined_sym: SymbolStr = intern.intern(bare_combined);
                if (bare_combined_sym.id != combined_sym.id) {
                    this.register_function(bare_combined_sym, func.resolved_return_type);
                    this.register_function_type(bare_combined_sym, func_type_ref);
                    this.register_mangled_name(bare_combined_sym, eff_mangled);
                    this.register_overload_mangled(bare_combined_sym, func_type_ref, eff_mangled);
                }
            }

            // Add to per-module list.  Skip if this (combined_sym, module)
            // pair was already added by a prior overload; multiple
            // overloads of the same method share one per-module entry.
            const pair_key: u64 =
                ((combined_sym.id as u64) << 32) | (module.id as u64);
            if (!this.module_func_pairs.contains_key(&pair_key)) {
                this.module_funcs.push(Pair<u32, u32>::new(combined_sym.id, module.id));
            }
            this.note_module_func(combined_sym.id, module.id);
        }
    }


    // Lookups (called by Sema and future passes)

    /// Look up a function's return type by name.
    lookup_func_return(&this, name: SymbolStr) -> TypeRef {
        return match (this.func_returns.get(&name.id)) {
            Option::Some(val) => { val }
            Option::None      => { TypeRef::invalid() }
        };
    }

    /// Look up a function's FunctionType TypeRef (full signature).
    lookup_func_type(&this, name: SymbolStr) -> TypeRef {
        return match (this.func_type_refs.get(&name.id)) {
            Option::Some(val) => { val }
            Option::None      => { TypeRef::invalid() }
        };
    }

    /// Look up a method's return type by (type, method) names.
    lookup_method_return(&this, type_sym: SymbolStr, method_sym: SymbolStr) -> TypeRef {
        const key: u64 = DeclarationIndex::pack_method_key(type_sym, method_sym);
        return match (this.method_returns.get(&key)) {
            Option::Some(val) => { val }
            Option::None      => { TypeRef::invalid() }
        };
    }

    /// Look up an implicit converter for `(arg_ty) -> ret_ty` by their
    /// canonical arena ids.  Returns the packed value
    /// `(type_name_id << 32) | method_name_id`, or 0 if none is registered.
    /// `type_name_id == 0` denotes a free-function converter; otherwise the
    /// converter is the static method `type_name::method_name`.
    lookup_implicit_converter(&this, arg_id: u64, ret_id: u64) -> u64 {
        const key: u64 = DeclarationIndex::pack_converter_key(arg_id, ret_id);
        return match (this.implicit_converters.get(&key)) {
            Option::Some(v) => { v }
            Option::None    => { 0 }
        };
    }

    /// Look up a named type by its SymbolStr.
    lookup_type(&this, name: SymbolStr) -> TypeRef {
        return match (this.type_map.get(&name.id)) {
            Option::Some(val) => { val }
            Option::None      => { TypeRef::invalid() }
        };
    }

    /// Look up a global variable's type by name.
    lookup_global(&this, name: SymbolStr) -> TypeRef {
        return match (this.global_vars.get(&name.id)) {
            Option::Some(val) => { val }
            Option::None      => { TypeRef::invalid() }
        };
    }

    /// Reverse-lookup: get the SymbolStr for a TypeRef.
    lookup_type_name(&this, ty: TypeRef) -> SymbolStr {
        return match (this.type_reverse.get(&ty.id)) {
            Option::Some(val) => { SymbolStr::from_id(val) }
            Option::None      => { SymbolStr::empty() }
        };
    }


    // Per-module registration (called alongside global registration)

    /// Maintain the O(1) module-func indices alongside a `module_funcs`
    /// push: record first-wins module ownership and (func, module)
    /// membership.  Idempotent, so it is safe to call on every push.
    note_module_func(mut &this, name_id: u32, module_id: u32) -> void {
        if (!this.module_func_first.contains_key(&name_id)) {
            this.module_func_first.insert(name_id, module_id);
        }
        const pk: u64 = ((name_id as u64) << 32) | (module_id as u64);
        this.module_func_pairs.insert(pk, true);
    }

    /// Register a function with its defining module for per-module enumeration.
    register_function_with_module(mut &this, name: SymbolStr, return_type: TypeRef,
                                  module: SymbolStr) -> void {
        this.register_function(name, return_type);
        this.module_funcs.push(Pair<u32, u32>::new(name.id, module.id));
        this.note_module_func(name.id, module.id);
    }

    /// Register a function type with its defining module for per-module enumeration.
    /// Also computes and stores the mangled LLVM symbol name.
    register_function_type_with_module(mut &this, name: SymbolStr,
                                       return_type: TypeRef, func_type_ref: TypeRef,
                                       module: SymbolStr, intern: InternTable*,
                                       arena: TypeArena*) -> void {
        this.register_function(name, return_type);
        this.register_function_type(name, func_type_ref);

        // Compute the mangled symbol name including the full signature.
        const qname: QualifiedName = QualifiedName::from_symbol(name);
        // Borrow the FunctionType's param list rather than aliasing it into an
        // owning local: a `mut params: TypeRef[] = ...; params = fn_ty.param_types`
        // local would free the FunctionType's buffer when it drops (the
        // signature array is still owned by the arena type) - a use-after-free
        // the mangler hit while reading the borrowed params.
        const empty_params: TypeRef[] = [];
        mut params: &TypeRef[] = &empty_params;
        mut is_variadic: boolean = false;
        const ft: Type* = arena.lookup(func_type_ref.id);
        if (ft != null && ft.kind == TypeKind::Function) {
            const fn_ty: FunctionType* = ft as FunctionType*;
            params = &fn_ty.param_types;
            is_variadic = fn_ty.is_variadic;
        }
        const mangled: MangledName = MangledName::for_free_function(
            intern, arena, qname, params, return_type, is_variadic);
        this.register_mangled_name(name, mangled.value);
        // Pin the mangled name to this exact overload so cross-module extern
        // declaration can pick the right LLVM symbol when the bare-name slot
        // has been overwritten by another module's free function (e.g.,
        // `read` is the intrinsic in std::core::intrinsics AND a free
        // function in std::fs::file; bare "read" -> mangled-name maps to
        // whichever was registered last).
        this.register_overload_mangled(name, func_type_ref, mangled.value);

        this.module_funcs.push(Pair<u32, u32>::new(name.id, module.id));
        this.note_module_func(name.id, module.id);
    }

    /// Register a type with its defining module for per-module enumeration.
    register_type_with_module(mut &this, qualified_name: SymbolStr, ty: TypeRef,
                              module: SymbolStr) -> void {
        this.register_type(qualified_name, ty);
        this.module_types.push(Pair<u32, u32>::new(qualified_name.id, module.id));
    }


    /// Store the mangled LLVM symbol name for a function or method.
    /// Called at registration time so codegen never computes mangling.
    ///
    /// Intrinsic durability: a declared intrinsic's bare leaf maps to the
    /// intrinsic's own C symbol - which IS the leaf name (`free` -> `free`) -
    /// permanently.  A later same-leaf regular function writing its q-mangled
    /// symbol into this single slot would silently redirect every blind
    /// bare-name fallback (codegen `resolve_function`, extern declaration)
    /// into a module the caller never imported.  The intrinsic's own write
    /// (mangled == leaf) always passes, so registration order converges.
    register_mangled_name(mut &this, qualified: SymbolStr, mangled: SymbolStr) -> void {
        if (this.intrinsic_names.contains_key(&qualified.id)
            && mangled.id != qualified.id) {
            return;
        }
        this.mangled_names.insert(qualified.id, mangled.id);
    }

    /// Look up the pre-computed mangled LLVM symbol name.
    lookup_mangled_name(&this, qualified: SymbolStr) -> SymbolStr {
        return match (this.mangled_names.get(&qualified.id)) {
            Option::Some(val) => { SymbolStr::from_id(val) }
            Option::None      => { SymbolStr::empty() }
        };
    }

    /// Register a bare -> qualified name mapping.
    /// Called by type_resolution when registering both forms.
    /// Also records the qualified name in the per-bare alternatives list
    /// so codegen can detect ambiguous bare-name fallbacks.
    register_name_mapping(mut &this, bare: SymbolStr, qualified: SymbolStr) -> void {
        // Append to alternatives list, deduped by (bare, qualified) pair --
        // scoped to this bare name's positions via bare_alts_index.
        match (this.bare_alts_index.get_ref(&bare.id)) {
            Option::Some(positions) => {
                mut k: i64 = 0;
                while (k < (*positions).length) {
                    if (this.bare_alts[(*positions)[k] as i64].second == qualified.id) {
                        return;
                    }
                    k = k + 1;
                }
            }
            Option::None => { }
        }
        const new_pos: u32 = this.bare_alts.length as u32;
        this.bare_alts.push(Pair<u32, u32>::new(bare.id, qualified.id));
        const slot: u32[]* = this.bare_alts_index.get_or_insert(bare.id, []);
        (*slot).push(new_pos);
    }

    // --- Import-scoped resolution: population + query -----------------------

    /// Record a module's import list (its `ModuleInfo.dependencies`, which are
    /// namespace names) under its own namespace, for later use-site scoping.
    /// Called once per module by the orchestrator after module discovery.
    register_module_imports(mut &this, module_ns: SymbolStr, imports: &SymbolStr[]) -> void {
        mut ids: u32[] = [];
        for (mut i: i64 = 0; i < imports.length; i++) {
            ids.push(imports[i].id);
        }
        this.module_imports.insert(module_ns.id, ids);
    }

    /// Seed the prelude re-export set from the fixed list in
    /// `stdlib/prelude.cryo`.  These namespaces' public types (Rc, Box, Option,
    /// Result, Range, Iterator, Array, Slice, ...) are auto-in-scope in every
    /// module via the injected `import std::prelude`, so a LOCAL same-leaf type
    /// collides with them.  They arrive as `public module` SUBMODULES of the
    /// prelude, which the loader does NOT record as dependency edges, so they
    /// can't be derived from the graph - this mirrors `stdlib/prelude.cryo`
    /// directly.  KEEP IN SYNC if the prelude's `public module` set changes (it
    /// is deliberately small and stable).
    seed_prelude_namespaces(mut &this, intern: InternTable*) -> void {
        mut ns: SymbolStr[] = [];
        ns.push(intern.intern("std::core"));
        ns.push(intern.intern("std::core::option"));
        ns.push(intern.intern("std::core::result"));
        ns.push(intern.intern("std::core::primitives"));
        ns.push(intern.intern("std::core::intrinsics"));
        ns.push(intern.intern("std::core::varargs"));
        ns.push(intern.intern("std::collections::array"));
        ns.push(intern.intern("std::core::slice"));
        ns.push(intern.intern("std::core::ops"));
        ns.push(intern.intern("std::core::iter"));
        ns.push(intern.intern("std::alloc::box"));
        ns.push(intern.intern("std::alloc::rc"));
        this.register_prelude_namespaces(ns);
    }

    /// Record the namespaces re-exported by `std::prelude` (deduped).  A local
    /// same-leaf as any type in these namespaces is a hard conflict.
    register_prelude_namespaces(mut &this, prelude: SymbolStr[]) -> void {
        for (mut i: i64 = 0; i < prelude.length; i++) {
            const id: u32 = prelude[i].id;
            mut seen: boolean = false;
            for (mut j: i64 = 0; j < this.prelude_ns.length; j++) {
                if (this.prelude_ns[j] == id) { seen = true; }
            }
            if (!seen) { this.prelude_ns.push(id); }
        }
    }

    /// Record a type's visibility (keyed by its qualified name) so same-leaf
    /// resolution can exclude a private cross-module candidate.
    set_type_visibility(mut &this, qualified: SymbolStr, is_public: boolean) -> void {
        this.type_visibility.insert(qualified.id, is_public);
    }

    /// The defining namespace of a qualified name (everything before the leaf),
    /// re-interned as a SymbolStr in the shared table so its id is comparable
    /// with the import/prelude/use-site namespace ids.  A bare name (no `::`)
    /// yields the empty SymbolStr.
    namespace_of(&this, qualified: SymbolStr, intern: InternTable*) -> SymbolStr {
        const full: string = intern.resolve(qualified);
        const qn: QualifiedName = QualifiedName::parse(intern, full);
        if (qn.depth() <= 1) { return SymbolStr::empty(); }
        return intern.intern(qn.display_parent(intern));
    }

    is_prelude_ns(&this, ns: SymbolStr) -> boolean {
        for (mut i: i64 = 0; i < this.prelude_ns.length; i++) {
            if (this.prelude_ns[i] == ns.id) { return true; }
        }
        return false;
    }

    /// Whether the module `use_site_ns` imports (depends on) `target_ns`.
    ns_imports(&this, use_site_ns: SymbolStr, target_ns: SymbolStr) -> boolean {
        match (this.module_imports.get_ref(&use_site_ns.id)) {
            Option::Some(ids) => {
                mut k: i64 = 0;
                while (k < (*ids).length) {
                    if ((*ids)[k] == target_ns.id) { return true; }
                    k = k + 1;
                }
            }
            Option::None => { }
        }
        return false;
    }

    /// Visibility verdict for a candidate; permissive default (see
    /// `type_visibility`).
    is_candidate_public(&this, qualified: SymbolStr) -> boolean {
        return match (this.type_visibility.get(&qualified.id)) {
            Option::Some(v) => { v }
            Option::None    => { true }
        };
    }

    /// Resolve a bare leaf to the qualified name the USE SITE actually means,
    /// using its namespace + import list.  This is import-aware: it only
    /// differs from a context-free lookup when a leaf has MORE THAN ONE
    /// registered qualified form (a same-leaf collision); a unique leaf
    /// resolves identically and cheaply.
    ///
    /// Precedence (a local definition beats imports; a prelude name is special):
    ///   1. exactly one candidate            -> Unique
    ///   2. a same-namespace (local) candidate:
    ///        - also a prelude-name candidate -> Ambiguous  (local vs prelude
    ///          is a hard conflict; the local must be renamed or qualified)
    ///        - otherwise                     -> SameModule (local wins)
    ///   3. no local candidate: keep the public candidates whose namespace is
    ///      imported (or preluded):
    ///        - exactly one  -> Unique
    ///        - two or more  -> Ambiguous  (caller demands qualification)
    ///        - none visible -> NotFound   (a later "undefined" error owns it)
    resolve_qualified_scoped(&this, bare: SymbolStr, use_site_ns: SymbolStr,
                             intern: InternTable*) -> ScopeResolution {
        const cands: SymbolStr[] = this.lookup_qualified_alternatives(bare);
        if (cands.length == 0) { return ScopeResolution::NotFound; }
        if (cands.length == 1) { return ScopeResolution::Unique(cands[0]); }

        mut local:   SymbolStr[] = [];
        mut visible: SymbolStr[] = [];
        mut prelude_hit: boolean = false;
        for (mut i: i64 = 0; i < cands.length; i++) {
            const c: SymbolStr = cands[i];
            const c_ns: SymbolStr = this.namespace_of(c, intern);
            if (c_ns.id == use_site_ns.id) {
                local.push(c);
                continue;
            }
            const c_prelude: boolean = this.is_prelude_ns(c_ns);
            if (c_prelude) { prelude_hit = true; }
            if ((c_prelude || this.ns_imports(use_site_ns, c_ns))
                && this.is_candidate_public(c)) {
                visible.push(c);
            }
        }

        if (local.length >= 1) {
            if (prelude_hit)        { return ScopeResolution::Ambiguous; }
            if (local.length == 1)  { return ScopeResolution::SameModule(local[0]); }
            return ScopeResolution::Ambiguous;
        }
        if (visible.length == 1) { return ScopeResolution::Unique(visible[0]); }
        if (visible.length == 0) { return ScopeResolution::NotFound; }
        return ScopeResolution::Ambiguous;
    }

    /// Convenience wrapper returning the resolved qualified name, or `bare`
    /// unchanged on a miss/ambiguity.
    /// Use at non-authoritative sites (codegen, which receives already-qualified
    /// names); authoritative sites call `resolve_qualified_scoped` directly so
    /// they can diagnose `Ambiguous`.
    resolve_qualified_scoped_or(&this, bare: SymbolStr, use_site_ns: SymbolStr,
                                intern: InternTable*) -> SymbolStr {
        return this.resolve_qualified_scoped(bare, use_site_ns, intern).resolved_or(bare);
    }

    /// Context-FREE canonicalization: fold a bare leaf to its qualified form
    /// only when that form is UNAMBIGUOUS (exactly one registered candidate);
    /// otherwise return the input unchanged.  Unlike `resolve_qualified_scoped`,
    /// this deliberately ignores the use site - it exists for the few consumers
    /// that need a module-INDEPENDENT identity (cross-module coherence keys in
    /// `type_name_key` / where-clause keying), where a use-site-dependent answer
    /// would key the same type differently from different modules and break
    /// dedup.  A colliding leaf stays bare here (callers fall back to the arena
    /// type id, which is itself canonical), which is strictly MORE
    /// module-independent than a last-write-wins pick.
    canonical_qualified(&this, bare: SymbolStr) -> SymbolStr {
        const cands: SymbolStr[] = this.lookup_qualified_alternatives(bare);
        if (cands.length == 1) { return cands[0]; }
        return bare;
    }

    /// Return every qualified name registered under the given bare name.
    /// `length > 1` means dispatching through the bare-name fallback would
    /// be ambiguous: the overload slot is last-write-wins, so two free
    /// functions of the same simple name in sibling namespaces collapse
    /// onto a single LLVM symbol.  Codegen uses this to emit E0154
    /// (ambiguous call) instead of silently misrouting.
    lookup_qualified_alternatives(&this, bare: SymbolStr) -> SymbolStr[] {
        mut result: SymbolStr[] = [];
        match (this.bare_alts_index.get_ref(&bare.id)) {
            Option::Some(positions) => {
                mut k: i64 = 0;
                while (k < (*positions).length) {
                    result.push(SymbolStr::from_id(this.bare_alts[(*positions)[k] as i64].second));
                    k = k + 1;
                }
            }
            Option::None => { }
        }
        return result;
    }

    // Per-module queries (used by codegen to enumerate module exports)

    /// Get all function names defined in a specific module.
    get_functions_in_module(&this, module: SymbolStr) -> SymbolStr[] {
        mut result: SymbolStr[] = [];
        for (mut i: i64 = 0; i < this.module_funcs.length; i++) {
            if (this.module_funcs[i].second == module.id) {
                result.push(SymbolStr::from_id(this.module_funcs[i].first));
            }
        }
        return result;
    }

    /// Get all type names defined in a specific module.
    get_types_in_module(&this, module: SymbolStr) -> SymbolStr[] {
        mut result: SymbolStr[] = [];
        for (mut i: i64 = 0; i < this.module_types.length; i++) {
            if (this.module_types[i].second == module.id) {
                result.push(SymbolStr::from_id(this.module_types[i].first));
            }
        }
        return result;
    }

    /// Get all global variable names defined in a specific module.
    get_globals_in_module(&this, module: SymbolStr) -> SymbolStr[] {
        mut result: SymbolStr[] = [];
        for (mut i: i64 = 0; i < this.module_global_keys.length; i++) {
            if (this.module_global_modules[i] == module.id) {
                result.push(SymbolStr::from_id(this.module_global_keys[i]));
            }
        }
        return result;
    }

    /// Check if a function is defined in a specific module.
    is_function_in_module(&this, name: SymbolStr, module: SymbolStr) -> boolean {
        const pk: u64 = ((name.id as u64) << 32) | (module.id as u64);
        return this.module_func_pairs.contains_key(&pk);
    }

    /// Get the defining module for a function. Returns empty SymbolStr if not found.
    get_function_module(&this, name: SymbolStr) -> SymbolStr {
        return match (this.module_func_first.get(&name.id)) {
            Option::Some(val) => { SymbolStr::from_id(val) }
            Option::None      => { SymbolStr::empty() }
        };
    }

    /// Get the defining module for a type. Returns empty SymbolStr if not found.
    get_type_module(&this, name: SymbolStr) -> SymbolStr {
        for (mut i: i64 = 0; i < this.module_types.length; i++) {
            if (this.module_types[i].first == name.id) {
                return SymbolStr::from_id(this.module_types[i].second);
            }
        }
        return SymbolStr::empty();
    }

    /// Get the defining module for a global. Returns empty SymbolStr if not found.
    get_global_module(&this, name: SymbolStr) -> SymbolStr {
        for (mut i: i64 = 0; i < this.module_global_keys.length; i++) {
            if (this.module_global_keys[i] == name.id) {
                return SymbolStr::from_id(this.module_global_modules[i]);
            }
        }
        return SymbolStr::empty();
    }

    /// Get the defining namespace for a global. Returns empty SymbolStr if
    /// not found or if the global was registered without a namespace.
    /// `resolve_global` uses this to mangle a cross-module extern with the
    /// same module-qualified name the defining module emits.
    get_global_namespace(&this, name: SymbolStr) -> SymbolStr {
        for (mut i: i64 = 0; i < this.module_global_keys.length; i++) {
            if (this.module_global_keys[i] == name.id) {
                return SymbolStr::from_id(this.module_global_namespaces[i]);
            }
        }
        return SymbolStr::empty();
    }

    /// Combines a type's SymbolStr.id and a method's SymbolStr.id into a single
    /// u64 key.  Uses the upper 32 bits for the type and lower 32 bits for the
    /// method name.  Uses bit shift instead of multiply-by-2^32, since the
    /// literal 4294967296 overflows i32 and silently becomes 0.
    static pack_method_key(type_sym: SymbolStr, method_sym: SymbolStr) -> u64 {
        return ((type_sym.id as u64) << 32) | (method_sym.id as u64);
    }

    /// Pack an implicit-converter registry key from the argument and return
    /// TypeRef ids.  Mirrors `pack_method_key`'s 32-bit interleave; arena ids
    /// fit comfortably in 32 bits in practice.
    static pack_converter_key(arg_id: u64, ret_id: u64) -> u64 {
        return (arg_id << 32) | (ret_id & 0xFFFFFFFF);
    }


    /// Decode the receiver kind for a method given its AST.  This is the
    /// single source of truth used by every mangler call site so the
    /// produced symbol names converge.
    ///
    ///   `&this`          -> ImmutRef        (encoded as $s)
    ///   `mut &this`      -> MutRef          (encoded as $m)
    ///   `this` (by value)-> None            (regular first param)
    ///   no explicit self -> ImmutRef        (implicit `&this` for non-static)
    ///   static method    -> None
    static method_receiver_kind(func: FunctionDeclNode*, is_static: boolean,
                                  intern: InternTable*) -> ReceiverKind {
        if (is_static || func == null) { return ReceiverKind::None; }

        const this_ref_name: SymbolStr = intern.intern("&this");
        const this_val_name: SymbolStr = intern.intern("this");

        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null) { continue; }
            if (param.name.equals(this_ref_name)) {
                if (param.is_mutable) { return ReceiverKind::MutRef; }
                return ReceiverKind::ImmutRef;
            }
            if (param.name.equals(this_val_name)) {
                return ReceiverKind::None;
            }
        }
        // Non-static method with no explicit receiver: implicit `&this`.
        return ReceiverKind::ImmutRef;
    }

    /// Collect the non-receiver parameter TypeRefs for use with the
    /// `for_method` mangler.  Strips out `&this` (always a marker) but
    /// keeps `this` (since its by-value form is encoded as a regular param).
    static method_non_receiver_params(func: FunctionDeclNode*,
                                        intern: InternTable*) -> TypeRef[] {
        mut out: TypeRef[] = [];
        if (func == null) { return out; }

        const this_ref_name: SymbolStr = intern.intern("&this");

        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null || !param.resolved_type.is_valid()) { continue; }
            if (param.name.equals(this_ref_name)) { continue; }
            out.push(param.resolved_type);
        }
        return out;
    }
}
