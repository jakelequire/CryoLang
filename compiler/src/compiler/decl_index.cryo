/// Declaration Index
///
/// The single post-creation lookup point for resolved declarations.
/// Populated incrementally by TypeResolution and Specialization passes;
/// queried by Sema, codegen, and future consumers.
///
/// Type names are registered under their qualified name only
/// (e.g. "BattleTest::Point").  All callers must qualify names before
/// registration or lookup.  The TypeArena's internal caches are for
/// allocation-time deduplication only; all consumption-time type
/// lookups should go through this index.
///
/// Each registration method is idempotent; re-registering a name with a
/// new TypeRef simply overwrites the old entry.

namespace compiler::decl_index;

import compiler::ast::{ NodeKind, TypeAnnotation };
import compiler::ast::node::{ ASTNode };
import compiler::ast::declaration;
import compiler::ast::declaration::{ FunctionDeclNode, ImplBlockNode, MethodNode, VarDeclNode };
import compiler::types;
import compiler::types::{ arena, compound, type_base, type_ref, TypeKind };
import compiler::resolver::{ symbol_str, intern_table, mangled_name, qualified_name };
import compiler::resolver::res;
import compiler::resolver::res::{ DeclVisibility, DefId, DefKind, FamilyOwner, Res, ResSlot, DefTable };
import compiler::diag::source_span;
import compiler::diag::source_span::{ SourceSpan };
import std::core::option;
import std::core::option::{ Option };
import std::collections::{ hashmap, pair };
import std::fmt;
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::mangled_name::{ MangledName, ReceiverKind };
import compiler::resolver::qualified_name::{ QualifiedName };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::decl_name::{ DeclName };
import compiler::module_graph;
import compiler::module_graph::{ ModulePath };
import compiler::types::arena::{ TypeArena };
import compiler::types::compound::{ FunctionType };
import compiler::types::substitution::{ TypeSubstitution };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };
import std::collections::hashmap::{ HashMap };
import std::collections::pair::{ Pair };
import compiler::intrinsic_kind;
import compiler::intrinsic_kind::{ IntrinsicKind };
import utils::text::{ Text };
import std::core::hash::{ Hash, Hasher };
import std::core::cmp::{ Eq };
import compiler::types::type_ref::{ TypeKey };
import compiler::types::user_defined;
import compiler::types::user_defined::{ ClassType, EnumType, MethodInfo, StructType };


/// One global's registration slot, read by value: the key the slot is
/// under (its leaf and the module that declared it), the global's type as
/// that module declared it, the source file that declared it, the linker
/// symbol when another object owns the storage, and whether it is
/// thread-local.
/// A reader holding one asks it, and asks the index nothing further by
/// name; `valid` is false for a slot that does not exist.
type struct GlobalEntry {
    valid:         boolean;
    /// The registration slot this entry was read from: the coordinate a
    /// node carries (`MemberPin::Global`) so codegen reads the slot back
    /// with `global_entry_at` and asks nothing by name.  -1 when not `valid`.
    slot:          i64;
    leaf:          SymbolStr;
    declared_in:   ModulePath;
    type_ref:      TypeRef;
    source_file:   SymbolStr;
    extern_symbol: SymbolStr;
    thread_local:  boolean;

    static none() -> GlobalEntry {
        return GlobalEntry {
            valid: false, slot: -1, leaf: SymbolStr::empty(), declared_in: ModulePath::none(),
            type_ref: TypeRef::invalid(), source_file: SymbolStr::empty(),
            extern_symbol: SymbolStr::empty(), thread_local: false,
        };
    }
}


/// The tag the next `DeclarationIndex` is made with.  Starts above 0, the
/// invalid id's tag, so no index owns the invalid id.
mut g_overload_index_tags: u32 = 0;

/// A signature's position in the index's function registry: the identity of
/// one registered declaration signature, which a call pins and codegen reads
/// the symbol and signature off.  Minted only here, by `register_signature`,
/// and read only here: the position is private to this module, so an id
/// cannot be built from a number anywhere else - an in-range position would
/// silently name whichever entry sits there.  It carries the tag of the
/// index that made it, and the index reads its registry only through
/// `slot_of`, which refuses an id another index made: a second index's
/// positions start at 0 too, so a position alone names SOME entry in any
/// index.
type struct OverloadId {
private:
    /// Position in the registry's parallel arrays; `0xFFFFFFFF` for none.
    pos: u32;
    /// The tag of the index that made this id; 0 for the invalid id.
    table: u32;

    /// The id of the entry at registry position `pos` of the index tagged
    /// `table`.  Registration's mint.
    static at_position(pos: u32, table: u32) -> OverloadId {
        return OverloadId { pos: pos, table: table };
    }

public:
    /// The id naming no entry, for a slot that must hold one before an
    /// answer exists.
    static invalid() -> OverloadId {
        return OverloadId { pos: 4294967295, table: 0 };
    }

    is_valid(&this) -> boolean {
        return this.pos != 4294967295;
    }

    equals(&this, other: OverloadId) -> boolean {
        return this.pos == other.pos && this.table == other.table;
    }
}

/// The key a family is stored under: the owner's definition and the member
/// leaf, packed.  Made only by `family_slot`, the member-function door's
/// key, so a family table is handed nothing a caller composed.  `none()`
/// (0) is the key of no family: an owner this index never registered.
type struct FamilySlot {
private:
    packed: u64;

public:
    static none() -> FamilySlot {
        return FamilySlot { packed: 0 };
    }

    is_none(&this) -> boolean {
        return this.packed == 0;
    }
}

implement trait Hash for struct FamilySlot {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher {
        this.packed.hash(hasher);
    }
}

implement trait Eq for struct FamilySlot {
    equals(&this, other: &FamilySlot) -> boolean {
        return this.packed == other.packed;
    }
}

/// The key of an owner's copy of a method definition: the owner type and
/// the definition's slot, packed.  Made only by `copy_key`.
type struct CopyKey {
private:
    packed: u64;
}

implement trait Hash for struct CopyKey {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher {
        this.packed.hash(hasher);
    }
}

implement trait Eq for struct CopyKey {
    equals(&this, other: &CopyKey) -> boolean {
        return this.packed == other.packed;
    }
}

/// The key of an implicit conversion: the argument type and the return
/// type, packed.  Made only by `converter_key`.
type struct ConversionKey {
private:
    packed: u64;
}

implement trait Hash for struct ConversionKey {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher {
        this.packed.hash(hasher);
    }
}

implement trait Eq for struct ConversionKey {
    equals(&this, other: &ConversionKey) -> boolean {
        return this.packed == other.packed;
    }
}


type struct DeclarationIndex {
    /// The compilation's definitions, for a definition's path.  Borrowed;
    /// set by `CompilationContext`, which owns it.
    defs: DefTable*;
    // Family slot (`family_slot`) -> the last signature registered in it
    private func_type_refs: HashMap<FamilySlot, TypeRef>;

    // Reverse: a type -> the definition it was registered as, made by the
    // registration; a type's name is read off the definition.
    type_reverse:   HashMap<TypeKey, DefId>;

    // The definition's slot in `defs` -> the type it was registered as;
    // invalid for a slot no type registration reached.
    def_types:      TypeRef[];

    // The definition's slot in `defs` -> the entry its signature was
    // registered as; invalid for a slot no function registration reached.
    def_entries:    OverloadId[];

    // A type definition's slot in `defs` -> the family its constructors
    // are registered in (`family_slot`); 0 for a type that registered none.
    ctor_families:  FamilySlot[];

    // The definition's slot in `defs` -> the declaration the name layer
    // registered it for: a method's `MethodNode`, or a trait's declared
    // method's `FunctionDeclNode`; null for a slot that is no method.
    method_decls:   ASTNode*[];

    // (owner type << 32 | a method definition's slot in `defs`) -> the
    // entry of the owner's copy of that method: an instance's clone of its
    // template's method, a type's copy of a trait's default.
    copy_entries:   HashMap<CopyKey, OverloadId>;

    // A generic function's instance - the arena instantiation of its
    // template's placeholder with the type arguments - -> the entry its copy
    // registered.
    instance_entries: HashMap<TypeKey, OverloadId>;

    // A global definition's slot in `defs` -> its registration slot in the
    // `module_global_*` arrays; -1 for a slot no global registration reached.
    def_globals:              i64[];
    private module_global_leaves:     u32[];  // SymbolStr.id of the global's own name
    module_global_files:      u32[];  // SymbolStr.id of the defining source file
    module_global_declared_in: ModulePath[];  // the defining module
                                      // (`std::collections::hashmap`).  Codegen
                                      // mangles definitions and cross-module
                                      // references under its path, so two
                                      // modules can each declare the same
                                      // private `const NAME = ...` without
                                      // colliding at link time.
    module_global_types:      TypeRef[];  // parallel to module_global_leaves: the
                                      // global's type as its declaration has it.
    module_global_threadlocal: boolean[];  // parallel to module_global_leaves:
                                      // whether the global is `![thread_local]`,
                                      // so a cross-module extern reference is
                                      // marked thread-local too (else it would
                                      // reference a TLS symbol with a non-TLS
                                      // relocation and fail to link).
    private module_global_extern_syms: u32[];  // parallel to module_global_leaves: the
                                      // linker symbol of a global whose storage
                                      // another object owns (an `extern` C
                                      // global), 0 for one Cryo defines.  An
                                      // imported global binds ONE symbol
                                      // program-wide - the one the C library
                                      // exports - and a reader mangling the
                                      // reference `C$<ns>.<name>` as it does for
                                      // a Cryo definition asks the linker for a
                                      // symbol nobody emits (`errno`).

    // Array element type -> the concrete `Array<T>` instantiation.
    // Populated by the specialization pass so codegen can resolve T[].method()
    // to the monomorphized Array_T struct without name reconstruction.
    array_elem_to_type:  HashMap<TypeKey, TypeRef>;

    // Implicit-conversion registry: Packed(arg_type_id, return_type_id) ->
    // the converter's definition.  Populated in DirectiveProcessing from
    // `![implicit]` single-param non-generic converters: a static method
    // or a free function.  Sema reads it at a type-incompatible coercion
    // site (call argument or typed binding) and synthesizes a call bound to
    // that definition (e.g. `string` -> `Str` via `Str::new`) instead of
    // emitting E0214/E0200.  Keyed on the resolved canonical arena ids,
    // exactly the ids the use site sees.
    implicit_converters: HashMap<ConversionKey, DefId>;

    // Function registry: one entry per (family, signature, alias, symbol),
    // in parallel arrays; an entry's position is its `OverloadId`.  The
    // family is the owner and leaf every signature of a declaration is
    // registered under; `func_type_refs` above keeps only the last signature
    // per family, which collapses overloads like `String::new()` and
    // `String::new(u64)`.
    // The symbol is part of the identity: two declarations can share a family
    // and a signature and be two definitions (`Display::fmt` and
    // `Debug::fmt` on one type, an inherent method beside a trait's, two
    // specializations of a generic method whose signature does not mention
    // its parameter), and a registration carrying a symbol the entry does
    // not already hold appends rather than restamps.
    overload_func_types:   TypeRef[]; // FunctionType TypeRef of this entry
    private overload_func_mangled: u32[];     // SymbolStr.id of the linker symbol
    overload_func_span:    SourceSpan[]; // where the entry's declaration is written
    overload_func_decl:    ASTNode*[];   // the declaration the entry was first
                                      // registered for: a method's MethodNode,
                                      // a function's FunctionDeclNode; null for
                                      // an entry registered with no node
    overload_func_trait:   DefId[];     // SymbolStr.id of the trait a trait-impl
                                      // method implements, else 0: an inherent
                                      // method beside a trait's under one key
                                      // and signature is told apart here, so a
                                      // `Type::method` path can prefer the
                                      // inherent one.
    overload_func_owner_return: TypeRef[]; // the entry's return in its OWNER's
                                      // parameters: an implement block's method
                                      // returns in the block's own parameters,
                                      // bound here to the owner's through the
                                      // head, because every reader substitutes
                                      // the owner's arguments into it (a
                                      // receiver's, a turbofish on the owner).
                                      // The signature's own return otherwise.
    private overload_func_family: FamilySlot[]; // the family the entry is registered in
                                      // (`family_slot`), so a definition's
                                      // overloads are read off its own entry.
    overload_func_intrinsic: IntrinsicKind[]; // how a call pinned to the entry
                                      // lowers: an `intrinsic function` codegen
                                      // lowers inline (ptr_diff, panic, atomic_*,
                                      // ...), else `Call`.  The kind is on the
                                      // ENTRY, read from the declaration where it
                                      // was registered, so a pin to
                                      // a function sharing the intrinsic's
                                      // leaf or its C symbol (`libc::malloc`
                                      // beside `intrinsics::malloc`) is not
                                      // mistaken for it: no spelling is
                                      // compared to decide it.

    // --- O(1) indices over the flat arrays above ---------------------------
    // These map a SymbolStr.id key to the position(s) it occupies in the
    // parallel arrays, so registration de-dup and per-name lookups no longer
    // linear-scan every function/overload in the whole program.  Maintained
    // in lockstep with each array push.

    // Family slot (`family_slot`) -> positions in the `overload_func_*` arrays.
    private overload_index:      HashMap<FamilySlot, u32[]>;

    // C symbol -> (key, function type id) of the FIRST `extern "C"` block
    // declaration carrying it, for W0011: a later extern block declaring the
    // same symbol with another signature is reported against this one.
private:
    ![allow(lookup_by_spelling, reason = "a C symbol is the linker's name for an extern declaration, not a name in the program; two declarations of one symbol are compared by it")]
    extern_symbol_first: HashMap<u32, Pair<u32, u64>>;
public:

    // --- Module reachability and declaration visibility --------------------
    // Everything below is keyed by module (`ModulePath`), handed in by the
    // orchestrator rather than reached through a ModuleGraph back-pointer:
    // module_graph.cryo already imports this module, so a back-pointer here
    // would be a compile-time module cycle.

    // A module's path id -> the path ids of the modules it can see through its
    // imports.  Populated once per module by the orchestrator (instance.cryo)
    // after module discovery.
private:
    ![allow(lookup_by_spelling, reason = "keyed by a module's path, which only the module graph makes and which names exactly one module")]
    module_imports:      HashMap<u32, u32[]>;
public:

    // The modules `std::prelude` re-exports (those whose public types - Rc,
    // Box, Option, Range, ... - are auto-in-scope in every module).  A LOCAL
    // type whose leaf collides with one of these is a hard conflict
    // (ambiguous), not a silent shadow.  Populated once.
    prelude_modules:     ModulePath[];


    /// The method families holding a method whose SIGNATURE the name layer
    /// refused - a parameter or return type naming nothing the writer can
    /// see - by family slot (`family_slot`: the owner's definition and the
    /// leaf).  Such a method registers no signature: one with the refused
    /// parameter dropped is a different method's, and one with no return
    /// type cannot be mangled.  What the set carries is that the name IS
    /// declared, so a call to it reports nothing: the defect was reported
    /// where the type was written, and "no method named" against a
    /// declaration that exists is a second report of the first, stated as
    /// something false.  A free function's refusal is recorded on its
    /// definition (`DefTable::signature_refused`).
    private refused_methods:     HashMap<FamilySlot, boolean>;

private:
    /// This index's tag, distinct from every other index the process made;
    /// stamped on each `OverloadId` it mints and checked by `slot_of`.
    overload_tag:        u32;

public:
    static new(defs: DefTable*) -> DeclarationIndex {
        g_overload_index_tags = g_overload_index_tags + 1;
        return DeclarationIndex {
            defs: defs,
            func_type_refs:      HashMap::<FamilySlot, TypeRef>::new(),
            type_reverse:        HashMap::<TypeKey, DefId>::new(),
            def_types:           [],
            def_entries:         [],
            ctor_families:       [],
            method_decls:        [],
            copy_entries:        HashMap::<CopyKey, OverloadId>::new(),
            instance_entries:    HashMap::<TypeKey, OverloadId>::new(),
            array_elem_to_type:  HashMap::<TypeKey, TypeRef>::new(),
            implicit_converters: HashMap::<ConversionKey, DefId>::new(),
            def_globals:              [],
            module_global_leaves:     [],
            module_global_threadlocal: [],
            module_global_extern_syms: [],
            module_global_files:      [],
            module_global_declared_in: [],
            module_global_types:      [],
            overload_func_types:   [],
            overload_func_mangled: [],
            overload_func_trait:   [],
            overload_func_span:    [],
            overload_func_decl:    [],
            overload_func_owner_return: [],
            overload_func_family: [],
            overload_func_intrinsic: [],
            overload_index:     HashMap::<FamilySlot, u32[]>::new(),
            extern_symbol_first: HashMap::<u32, Pair<u32, u64>>::new(),
            module_imports:     HashMap::<u32, u32[]>::new(),
            prelude_modules:    [],
            refused_methods:    HashMap::<FamilySlot, boolean>::new(),
            overload_tag:       g_overload_index_tags,
        };
    }

    /// The registry position of `id`, a valid id this index made.  One
    /// another index made is refused here: its position names an entry in
    /// SOME registry, and answering it would read whichever entry sits there.
    slot_of(&this, id: OverloadId) -> i64 {
        if (id.table != this.overload_tag) { DeclarationIndex::refuse(id.pos, id.table, this.overload_tag); }
        return id.pos as i64;
    }

    /// The refusal `slot_of` raises, kept out of the read it guards.
    static refuse(pos: u32, made_by: u32, read_by: u32) -> void {
        panic(fmt::format(
            "internal compiler error: a signature id made by index %u (position %u) was read against index %u (the invalid id carries 0)",
            made_by, pos, read_by), FILE, LINE);
    }


    // Registration (called by TypeResolution & Specialization passes)

    /// Register `converter`, the definition of a function or static method,
    /// as the implicit conversion `(arg_ty) -> ret_ty`.  First-wins so a
    /// single converter per (arg, ret) pair is deterministic regardless of
    /// module load order.
    register_implicit_converter(mut &this, arg_ty: TypeRef, ret_ty: TypeRef, converter: DefId) -> void {
        if (!converter.is_valid()) { return; }
        const key: ConversionKey = DeclarationIndex::converter_key(arg_ty, ret_ty);
        if (!this.implicit_converters.contains_key(&key)) {
            this.implicit_converters.insert(key, converter);
        }
    }

    /// The slot family `(owner, leaf)` is stored under: the owner's
    /// definition and the leaf, packed.  The definition is read here - a
    /// `Def`'s own, a `Type`'s the definition it was registered as - so a
    /// caller hands over the owner it holds and never composes a key.  Keyed
    /// by the definition's slot, one above it so the root (no definition)
    /// keeps its own: two owners written under one path are two owners.  A
    /// template's own families carry the top bit of the definition's half,
    /// so they never meet the definition's `Def` families.  0, which no
    /// family is stored under, for a type this index never registered: it
    /// owns no family here.
private:
    ![allow(lookup_by_spelling, reason = "a family is a member leaf asked of an owner identity, the member-function door's own key")]
    family_slot(&this, owner: FamilyOwner, leaf: SymbolStr) -> FamilySlot {
        mut template: boolean = false;
        const d: DefId = match (owner) {
            FamilyOwner::Def(od) => { od }
            FamilyOwner::Type(t) => {
                const td: DefId = this.registered_def(t);
                if (!td.is_valid()) { return FamilySlot::none(); }
                td
            }
            FamilyOwner::Template(td) => {
                if (!td.is_valid()) { return FamilySlot::none(); }
                template = true;
                td
            }
        };
        mut at: u64 = if (d.is_valid()) { (this.defs.slot(d) as u64) + 1 } else { 0 };
        if (template) { at = at | 2147483648; }
        return FamilySlot { packed: (at << 32) | (leaf.id as u64) };
    }

public:
    /// The owner's path: a `Def`'s own, a `Type`'s the definition it was
    /// registered as; empty for the root and for a type never registered.
    /// Text only: the mangled name a signature is emitted under, and a
    /// diagnostic that spells the family.  Never a key.
    family_owner_path(&this, owner: FamilyOwner) -> DeclName {
        return match (owner) {
            FamilyOwner::Def(d) | FamilyOwner::Template(d) => { this.defs.path_of(d) }
            FamilyOwner::Type(t) => { this.defs.path_of(this.registered_def(t)) }
        };
    }

    /// Drop every overload position previously registered for the family
    /// `(owner, leaf)` so the next registration is its sole signature.
    /// Needed when a declaration's signature is rewritten mid-compile (an
    /// `async function` becomes a constructor returning its Future struct):
    /// the stale Output-return overload must not shadow the new struct-return
    /// one at call sites, where overload resolution enumerates
    /// `lookup_func_type_overloads`.
    reset_family(mut &this, owner: FamilyOwner, leaf: SymbolStr) -> void {
        const slot: FamilySlot = this.family_slot(owner, leaf);
        if (slot.is_none()) { return; }
        mut empty: u32[] = [];
        this.overload_index.insert(slot, empty);
    }

    /// `reset_family` for the family entry `e` was registered in, read off
    /// the entry: a declaration whose signature is rewritten names its own
    /// family by the entry it was registered as.
    reset_family_of_entry(mut &this, e: OverloadId) -> void {
        if (!e.is_valid()) { return; }
        const slot: FamilySlot = this.overload_func_family[this.slot_of(e)];
        if (slot.is_none()) { return; }
        mut empty: u32[] = [];
        this.overload_index.insert(slot, empty);
    }

    /// Register one signature of a declaration: the entry in the family
    /// `(owner, leaf)` with signature `func_type_ref`, emitted under the
    /// linker `symbol`, implementing `trait_sym` (empty for anything but a
    /// trait-impl method).
    /// Registering the same signature and symbol in one family
    /// again answers the existing entry; a different symbol under the same
    /// family and signature is a different definition and appends its own.
    /// The id is the declaration's identity for every later consumer: the
    /// registrar stamps it on the node, and a call pins it.  `decl` is that
    /// node, answered by `entry_decl`; an entry answered again keeps the
    /// node it was first registered for.  `owner_return` is the return in
    /// the owner's parameters (`entry_owner_return`), kept the same way.
    ![allow(lookup_by_spelling, reason = "a duplicate-declaration check: the same signature and linker symbol in one family is the same declaration registered again; the leaf only names the family, the member-function door's own key")]
    register_signature(mut &this, owner: FamilyOwner, leaf: SymbolStr, func_type_ref: TypeRef,
                       owner_return: TypeRef, symbol: SymbolStr, trait_sym: DefId,
                       span: SourceSpan, decl: ASTNode*) -> OverloadId {
        const slot: FamilySlot = this.family_slot(owner, leaf);
        if (slot.is_none()) { return OverloadId::invalid(); }
        this.func_type_refs.insert(slot, func_type_ref);
        match (this.overload_index.get_ref(&slot)) {
            Option::Some(positions) => {
                for (mut k: i64 = 0; k < (*positions).length; k++) {
                    const pos: u32 = (*positions)[k];
                    if (this.overload_func_types[pos as i64].equals(func_type_ref)
                            && this.overload_func_mangled[pos as i64] == symbol.id) {
                        return OverloadId::at_position(pos, this.overload_tag);
                    }
                }
            }
            Option::None => { }
        }
        const id: OverloadId = this.file_entry(slot, func_type_ref, owner_return, symbol, trait_sym, span, decl);
        const positions: u32[]* = this.overload_index.get_or_insert(slot, []);
        (*positions).push(this.slot_of(id) as u32);
        return id;
    }

    /// A new entry, recorded as belonging to the family stored under
    /// `slot` (`FamilySlot::none()` for none); the caller files it in that
    /// family.
    ![allow(lookup_by_spelling, reason = "the entry's linker symbol, stored with the entry; it keys no store")]
    file_entry(mut &this, slot: FamilySlot, func_type_ref: TypeRef, owner_return: TypeRef,
               symbol: SymbolStr, trait_sym: DefId, span: SourceSpan, decl: ASTNode*) -> OverloadId {
        const new_pos: u32 = this.overload_func_types.length as u32;
        this.overload_func_types.push(func_type_ref);
        this.overload_func_mangled.push(symbol.id);
        this.overload_func_trait.push(trait_sym);
        this.overload_func_span.push(span);
        this.overload_func_decl.push(decl);
        this.overload_func_owner_return.push(owner_return);
        this.overload_func_family.push(slot);
        this.overload_func_intrinsic.push(IntrinsicKind::Call);
        return OverloadId::at_position(new_pos, this.overload_tag);
    }

    /// Register a copy of a function - a monomorphized instance, a
    /// closure-argument specialization - under no family.  Nothing looks a
    /// copy up by owner and leaf: a call reaches it by the pin its minter
    /// wrote (the entry, or the instance it is recorded under).  Its linker
    /// symbol is mangled from `home`'s path - the module of what it copies -
    /// and the name it was minted with, as a declaration's is from its
    /// family's.
    ![allow(lookup_by_spelling, reason = "the copy's own minted name, mangled into its symbol; it keys no store")]
    register_copy_signature(mut &this, home: FamilyOwner, minted: SymbolStr,
                            return_type: TypeRef, func_type_ref: TypeRef,
                            intern: InternTable*, arena: TypeArena*,
                            span: SourceSpan, decl: ASTNode*) -> OverloadId {
        const symbol: SymbolStr = this.mangle_function_symbol(home, minted, return_type, func_type_ref, intern, arena);
        return this.file_entry(FamilySlot::none(), func_type_ref, return_type, symbol, DefId::invalid(), span, decl);
    }

    /// The trait entry `id`'s declaration implements; empty for an inherent
    /// method, a free function, or an invalid id.
    entry_trait(&this, id: OverloadId) -> DefId {
        if (!id.is_valid()) { return DefId::invalid(); }
        return this.overload_func_trait[this.slot_of(id)];
    }

    /// Where entry `id`'s declaration is written; `none()` for an invalid id.
    entry_span(&this, id: OverloadId) -> SourceSpan {
        if (!id.is_valid()) { return SourceSpan::none(); }
        return this.overload_func_span[this.slot_of(id)];
    }

    /// The declaration entry `id` was registered for - a method's
    /// `MethodNode`, a function's `FunctionDeclNode` - or null for an
    /// invalid id or an entry registered with no node.
    entry_decl(&this, id: OverloadId) -> ASTNode* {
        if (!id.is_valid()) { return null; }
        return this.overload_func_decl[this.slot_of(id)];
    }

    /// The method entry `id` was registered for; null when it names a
    /// function or no node.
    entry_method(&this, id: OverloadId) -> MethodNode* {
        const d: ASTNode* = this.entry_decl(id);
        if (d == null || d.kind != NodeKind::MethodDeclaration) { return null; }
        return d as MethodNode*;
    }

    /// The linker symbol of entry `id`; empty for an invalid id.
    entry_symbol(&this, id: OverloadId) -> SymbolStr {
        if (!id.is_valid()) { return SymbolStr::empty(); }
        return SymbolStr::from_id(this.overload_func_mangled[this.slot_of(id)]);
    }

    /// The return of entry `id` in its owner's parameters: what a reader
    /// substituting the owner's arguments - a receiver's, a turbofish on
    /// the owner - substitutes into.  An implement block's method's own
    /// signature returns in the block's parameters, which no owner argument
    /// names.  Invalid for an invalid id.
    entry_owner_return(&this, id: OverloadId) -> TypeRef {
        if (!id.is_valid()) { return TypeRef::invalid(); }
        return this.overload_func_owner_return[this.slot_of(id)];
    }

    /// The signature of entry `id`; invalid for an invalid id.
    entry_signature(&this, id: OverloadId) -> TypeRef {
        if (!id.is_valid()) { return TypeRef::invalid(); }
        return this.overload_func_types[this.slot_of(id)];
    }

    /// Door `member-function`.  A member is written as a leaf after an owner
    /// the name layer already bound, so the question takes the owner's
    /// identity and the leaf's text; a family is the functions an owner
    /// declares under one leaf, and overloads are told apart by signature,
    /// not by name.
    ///
    /// Every entry of the family `(owner, leaf)`, in registration order.
    lookup_family_entries(&this, owner: FamilyOwner, leaf: SymbolStr) -> OverloadId[] {
        mut result: OverloadId[] = [];
        const slot: FamilySlot = this.family_slot(owner, leaf);
        match (this.overload_index.get_ref(&slot)) {
            Option::Some(positions) => {
                for (mut k: i64 = 0; k < (*positions).length; k++) {
                    result.push(OverloadId::at_position((*positions)[k], this.overload_tag));
                }
            }
            Option::None => { }
        }
        return result;
    }

    /// The entry the function or method definition `d`'s signature was
    /// registered as, or invalid when `d` is invalid or no registration
    /// reached it (a generic owner's method is registered per instance, and
    /// an instance is no definition).
    /// Asked by the definition, not by its parent and leaf: those name the
    /// family, which holds every overload declared under the leaf.
    entry_of_def(&this, d: DefId) -> OverloadId {
        if (!d.is_valid()) { return OverloadId::invalid(); }
        const slot: i64 = this.defs.slot(d);
        if (slot >= this.def_entries.length) { return OverloadId::invalid(); }
        return this.def_entries[slot];
    }

    /// Every entry of the family the function or method definition `d` is
    /// registered in - its overloads, `d`'s own among them - in
    /// registration order; empty when no registration reached `d`.  The
    /// family is the one `d`'s own entry was registered in, read off the
    /// entry.
    family_entries_of_def(&this, d: DefId) -> OverloadId[] {
        const e: OverloadId = this.entry_of_def(d);
        if (!e.is_valid()) { return []; }
        return this.entries_in_family(this.overload_func_family[this.slot_of(e)]);
    }

    /// Every constructor entry of the type definition `d`, in registration
    /// order; empty for a type that registered none.
    constructor_entries_of(&this, d: DefId) -> OverloadId[] {
        if (!d.is_valid()) { return []; }
        const slot: i64 = this.defs.slot(d);
        if (slot >= this.ctor_families.length || this.ctor_families[slot].is_none()) { return []; }
        return this.entries_in_family(this.ctor_families[slot]);
    }

    /// The entries registered in the family stored under `slot`.
    entries_in_family(&this, slot: FamilySlot) -> OverloadId[] {
        mut result: OverloadId[] = [];
        match (this.overload_index.get_ref(&slot)) {
            Option::Some(positions) => {
                for (mut k: i64 = 0; k < (*positions).length; k++) {
                    result.push(OverloadId::at_position((*positions)[k], this.overload_tag));
                }
            }
            Option::None => { }
        }
        return result;
    }

    /// Keep `decl` as the declaration the method definition `d` was
    /// registered for (`CompilationContext::define_method`).
    keep_method_decl(mut &this, d: DefId, decl: ASTNode*) -> void {
        const slot: i64 = this.defs.slot(d);
        while (this.method_decls.length <= slot) { this.method_decls.push(null); }
        this.method_decls[slot] = decl;
    }

    /// The entry of `owner`'s method for the method definition `d`: `d`'s
    /// own when `d` is declared on `owner`, else the owner's copy of it - an
    /// instance's clone of its template's method, a type's copy of a trait's
    /// default.  Invalid when `owner` has neither.  Asked by identity, so a
    /// caller that holds a method's definition never names the method.
    method_entry_on(&this, owner: TypeRef, d: DefId) -> OverloadId {
        if (!d.is_valid()) { return OverloadId::invalid(); }
        if (this.defs.parent_of(d).equals(this.registered_def(owner))) { return this.entry_of_def(d); }
        return match (this.copy_entries.get(&this.copy_key(owner, d))) {
            Option::Some(e) => { e }
            Option::None    => { OverloadId::invalid() }
        };
    }

    /// Record `e` as the entry of the generic function instance `inst`.
    record_instance(mut &this, inst: TypeRef, e: OverloadId) -> void {
        if (!inst.is_valid() || !e.is_valid()) { return; }
        this.instance_entries.insert(inst.table_key(), e);
    }

    /// The entry the copy of the generic function instance `inst` registered;
    /// invalid before that copy is registered.
    entry_of_instance(&this, inst: TypeRef) -> OverloadId {
        if (!inst.is_valid()) { return OverloadId::invalid(); }
        return match (this.instance_entries.get(&inst.table_key())) {
            Option::Some(e) => { e }
            Option::None    => { OverloadId::invalid() }
        };
    }

    /// The key of `owner`'s copy of the method definition `d`.
    copy_key(&this, owner: TypeRef, d: DefId) -> CopyKey {
        return CopyKey { packed: (owner.key() << 32) | (this.defs.slot(d) as u64) };
    }

    /// The function of the method definition `d`: a type's or an
    /// implementation's method, or a trait's declared method, which is
    /// registered as the function itself.  Null when `d` names no method.
    method_func_of(&this, d: DefId) -> FunctionDeclNode* {
        const decl: ASTNode* = this.method_decl_of(d);
        if (decl == null) { return null; }
        if (decl.kind == NodeKind::MethodDeclaration) { return (decl as MethodNode*).func; }
        if (decl.kind == NodeKind::FunctionDeclaration) { return decl as FunctionDeclNode*; }
        return null;
    }

    /// The declaration the method definition `d` was registered for, or
    /// null when `d` is invalid or names no method.
    method_decl_of(&this, d: DefId) -> ASTNode* {
        if (!d.is_valid()) { return null; }
        const slot: i64 = this.defs.slot(d);
        if (slot >= this.method_decls.length) { return null; }
        return this.method_decls[slot];
    }

    /// Refuse a method registered under the family `(owner, leaf)` whose
    /// definition says otherwise: the name layer registered the definition
    /// from the declaration where it is written, and this index files the
    /// method under the type the implementation head or the type body
    /// resolved to, so the two answer where a method lives independently.
    /// The definition must be a method of `owner`, under the method's own
    /// leaf, registered for this very node.  A method with no definition is
    /// a copy (a trait default placed here, a monomorphized clone) and is
    /// not checked.
    ![allow(lookup_by_spelling, reason = "a self-check: one method's definition leaf and its declaration's written name must agree; nothing is looked up by either")]
    check_method_def(&this, owner: TypeRef, method: MethodNode*, intern: InternTable*) -> void {
        const d: DefId = method.func.def;
        if (!d.is_valid()) { return; }
        if (this.defs.kind_of(d) == DefKind::Method
                && this.defs.parent_of(d).equals(this.registered_def(owner))
                && this.defs.leaf_of(d).spelling().equals(method.func.name)
                && this.method_decl_of(d) == method as ASTNode*) {
            return;
        }
        panic(fmt::format(
            "internal compiler error: method `%s` is registered on `%s`, and its definition says it is `%s` of `%s`",
            intern.resolve(method.func.name), intern.shown(this.family_owner_path(FamilyOwner::Type(owner))),
            intern.shown(this.defs.leaf_of(d)),
            intern.shown(this.family_owner_path(FamilyOwner::Def(this.defs.parent_of(d))))), FILE, LINE);
    }

    /// Record the kind an `intrinsic function` declaration's entry `id`
    /// lowers as.  Its leaf is a key in no function table: an intrinsic is
    /// reached through its module (`intrinsics::free`) like every
    /// declaration, and its bare spelling is an error where it is declared
    /// in no scope.  Codegen reads the kind off the pin, so a function
    /// sharing an intrinsic's leaf is never taken for it.
    mark_intrinsic(mut &this, id: OverloadId, kind: IntrinsicKind) -> void {
        if (!id.is_valid()) { return; }
        this.overload_func_intrinsic[this.slot_of(id)] = kind;
    }

    /// How a call pinned to entry `id` lowers; `Call` for an invalid id.
    entry_intrinsic_kind(&this, id: OverloadId) -> IntrinsicKind {
        if (!id.is_valid()) { return IntrinsicKind::Call; }
        return this.overload_func_intrinsic[this.slot_of(id)];
    }

    /// The signature of every entry of the family `(owner, leaf)`, in
    /// registration order (`lookup_family_entries` gives the entries
    /// themselves).
    lookup_func_type_overloads(&this, owner: FamilyOwner, leaf: SymbolStr) -> TypeRef[] {
        mut result: TypeRef[] = [];
        const slot: FamilySlot = this.family_slot(owner, leaf);
        match (this.overload_index.get_ref(&slot)) {
            Option::Some(positions) => {
                mut k: i64 = 0;
                while (k < (*positions).length) {
                    result.push(this.overload_func_types[(*positions)[k] as i64]);
                    k = k + 1;
                }
            }
            Option::None => { }
        }
        return result;
    }

    /// Record an `extern "C"` block's declaration `key` of the C symbol
    /// `sym` with signature `func_type_ref`.  The first declaration of a
    /// symbol is what a later one is compared against; a second record is
    /// not kept, because the record exists for W0011's evidence and not for
    /// binding - a call binds the declaration its stamp names.
    ![allow(lookup_by_spelling, reason = "a duplicate-declaration check: two extern blocks declaring one C symbol are compared by it; a C symbol is the linker's name, not a name in the program")]
    note_extern_symbol(mut &this, sym: SymbolStr, key: SymbolStr, func_type_ref: TypeRef) -> void {
        if (this.extern_symbol_first.contains_key(&sym.id)) { return; }
        this.extern_symbol_first.insert(sym.id, Pair::<u32, u64>::new(key.id, func_type_ref.key()));
    }

    /// The key of the extern block declaration first recorded for the C
    /// symbol `sym` when its signature is not `func_type_ref`, else empty:
    /// two extern blocks disagreeing about one C name's Cryo signature,
    /// which W0011 reports.  An identical redeclaration shares the interned
    /// function type and is not a conflict; an intrinsic reaching the same
    /// symbol is not an extern block and is not recorded here.
    ![allow(lookup_by_spelling, reason = "a duplicate-declaration check: two extern blocks declaring one C symbol are compared by it; a C symbol is the linker's name, not a name in the program")]
    extern_symbol_conflict(&this, sym: SymbolStr, func_type_ref: TypeRef) -> SymbolStr {
        match (this.extern_symbol_first.get_ref(&sym.id)) {
            Option::Some(first) => {
                if ((*first).second != func_type_ref.key()) { return SymbolStr::from_id((*first).first); }
            }
            Option::None => { }
        }
        return SymbolStr::empty();
    }

    /// The DEFINITION a type names, or an invalid id when the type is not a
    /// declared one.  The one door from a type to its definition.
    ///
    /// For a reader that holds a type rather than a written path - a
    /// synthesizer building a reference to it, a trait projection asking for
    /// its trait's declaration - so the id is derived from the type instead
    /// of looked up from a spelling.
    ///
    /// This is a mint because it reads this index rather than a spelling:
    /// `lookup_type_name` answers only for a type registered here, so a
    /// caller cannot reach a `DefId` for something never declared.
    ///
    /// An instantiation is reduced to the template it instantiates first,
    /// because a `Res` names a definition and never an instantiation - the
    /// invariant that lets `ASTCloner` copy one verbatim.  Reading the name
    /// off `Option<i32>` instead of `Option` would record a per-call-site
    /// answer for a declaration that has exactly one.
    def_of(&this, ty: TypeRef, arena: TypeArena*) -> DefId {
        if (arena == null || !ty.is_valid()) { return DefId::invalid(); }
        const base: TypeRef = arena.inst_generic_base(ty);
        if (base.is_valid()) {
            const bd: DefId = this.registered_def(base);
            if (bd.is_valid()) { return bd; }
        }
        return this.registered_def(ty);
    }

    /// The definition `ty` was registered as, or an invalid id when it was
    /// never registered here.
    registered_def(&this, ty: TypeRef) -> DefId {
        return match (this.type_reverse.get(&ty.table_key())) {
            Option::Some(d) => { d }
            Option::None    => { DefId::invalid() }
        };
    }

    /// Register the named type (struct, class, enum, trait, alias) that the
    /// definition `def` is, with its visibility verdict.  The verdict is
    /// recorded here, with the key, so no registered type is ever asked
    /// about before it has one.
    ///
    /// `def` is the id the declaration was given where it was declared - the
    /// name layer's binding, a synthesizer's registration - and this makes
    /// none of its own: a second id for one declaration would compare unequal
    /// to the first.  The type is kept under the definition, for
    /// `type_of_def`, and nowhere else: a definition's path is display text,
    /// and two definitions written under one path are two types.
    register_type(mut &this, def: DefId, ty: TypeRef, is_public: boolean) -> void {
        this.type_reverse.insert(ty.table_key(), def);
        this.defs.record_visibility(def, is_public);
        const slot: i64 = this.defs.slot(def);
        while (this.def_types.length <= slot) { this.def_types.push(TypeRef::invalid()); }
        this.def_types[slot] = ty;
    }

    /// Register the concrete `Array<T>` specialization a dynamic `T[]`
    /// dispatches through, keyed by its element type: an `ArrayType` is not
    /// canonical (many TypeRefs describe one `T[]`) but its element is.
    /// Called by the specialization pass after monomorphizing `Array<T>`.
    register_array_element_type(mut &this, element: TypeRef, array_struct: TypeRef) -> void {
        this.array_elem_to_type.insert(element.table_key(), array_struct);
    }

    /// The concrete `Array<T>` specialization for a given element type; the
    /// owner a method call on `T[]` resolves against.
    lookup_array_type(&this, element: TypeRef) -> TypeRef {
        return match (this.array_elem_to_type.get(&element.table_key())) {
            Option::Some(val) => { val }
            Option::None      => { TypeRef::invalid() }
        };
    }

    /// The registered name of that specialization.
    lookup_array_type_name(&this, element: TypeRef) -> SymbolStr {
        return this.lookup_type_name(this.lookup_array_type(element));
    }

    /// Register a reverse-only mapping (TypeRef -> definition) without
    /// touching the definition's own type.  Used to make additional TypeRefs
    /// (e.g., InstantiatedType, ArrayType) resolvable to an already-
    /// registered concrete type's qualified name.
    register_type_reverse_only(mut &this, def: DefId, ty: TypeRef) -> void {
        this.type_reverse.insert(ty.table_key(), def);
    }

    /// Register the global definition `def`, declared as `leaf` by the module
    /// `declared_in` in `source_file`, under its definition: one slot per
    /// definition, so a second registration of the same declaration refreshes
    /// what the first recorded (its module, type and thread-local flag)
    /// rather than adding a slot.  Codegen mangles the global as
    /// `C$<module path>.<leaf>`; `declared_in` is none for a unit declaring
    /// no namespace (the global stays bare-mangled).
    ![allow(lookup_by_spelling, reason = "records the declaration's own leaf and source file as data for mangling and ownership; the slot is keyed by the definition")]
    register_global(mut &this, def: DefId, leaf: SymbolStr, ty: TypeRef,
                    source_file: SymbolStr, declared_in: ModulePath,
                    thread_local: boolean) -> void {
        const i: i64 = this.global_slot_of_def(def);
        if (i >= 0) {
            this.module_global_declared_in[i] = declared_in;
            this.module_global_threadlocal[i] = thread_local;
            this.module_global_types[i] = ty;
            return;
        }
        const ds: i64 = this.defs.slot(def);
        while (this.def_globals.length <= ds) { this.def_globals.push(-1); }
        this.def_globals[ds] = this.module_global_leaves.length;
        this.module_global_leaves.push(leaf.id);
        this.module_global_files.push(source_file.id);
        this.module_global_declared_in.push(declared_in);
        this.module_global_threadlocal.push(thread_local);
        this.module_global_extern_syms.push(0);
        this.module_global_types.push(ty);
    }

    /// The registration slot of the global definition `def`, or -1 when `def`
    /// is invalid or no global registration reached it.
    global_slot_of_def(&this, def: DefId) -> i64 {
        if (!def.is_valid()) { return -1; }
        const ds: i64 = this.defs.slot(def);
        if (ds >= this.def_globals.length) { return -1; }
        return this.def_globals[ds];
    }

    /// The global definition `def` is, from its registration slot, or an
    /// entry that is not `valid`.
    global_entry_of_def(&this, def: DefId) -> GlobalEntry {
        return this.global_entry_at(this.global_slot_of_def(def));
    }

    /// The slot at position `i`, read by value.
    global_entry_at(&this, i: i64) -> GlobalEntry {
        if (i < 0) { return GlobalEntry::none(); }
        return GlobalEntry {
            valid:         true,
            slot:          i,
            leaf:          SymbolStr::from_id(this.module_global_leaves[i]),
            declared_in:   this.module_global_declared_in[i],
            type_ref:      this.module_global_types[i],
            source_file:   SymbolStr::from_id(this.module_global_files[i]),
            extern_symbol: SymbolStr::from_id(this.module_global_extern_syms[i]),
            thread_local:  this.module_global_threadlocal[i],
        };
    }

    /// Door `member-global`.  A qualified path's member is written as a leaf
    /// after a module the name layer already bound (`libc::FIONBIO`), so the
    /// question takes the module's identity and the leaf's text; the leaf
    /// alone cannot answer, since two modules may each declare it.
    ///
    /// The global the module `m` declares as `leaf`, or an entry that is not
    /// `valid`.  No module is the root, which a unit with no `namespace`
    /// declaration registers its globals under.
    global_in_module(&this, leaf: SymbolStr, m: ModulePath) -> GlobalEntry {
        for (mut i: i64 = 0; i < this.module_global_leaves.length; i++) {
            if (this.module_global_leaves[i] != leaf.id) { continue; }
            if (!this.module_global_declared_in[i].equals(m)) { continue; }
            return this.global_entry_at(i);
        }
        return GlobalEntry::none();
    }

    /// Record that the global definition `def` binds linker symbol `sym`.
    /// A global whose type never resolved has no slot; it was diagnosed at
    /// the declaration and nothing references it.
    ![allow(lookup_by_spelling, reason = "records a C library's linker symbol as data; the slot is keyed by the definition")]
    record_global_extern_symbol(mut &this, def: DefId, sym: SymbolStr) -> void {
        const i: i64 = this.global_slot_of_def(def);
        if (i >= 0) { this.module_global_extern_syms[i] = sym.id; }
    }

    /// Mark the global definition `def` thread-local.  The `![thread_local]`
    /// directive is applied AFTER TypeResolution registered the global with
    /// the flag false, so the registration is corrected rather than made.
    mark_global_thread_local(mut &this, def: DefId) -> void {
        const i: i64 = this.global_slot_of_def(def);
        if (i >= 0) { this.module_global_threadlocal[i] = true; }
    }



    /// Register a type's inline or impl-block methods under the key the
    /// type itself is registered under.  The owner is the TYPE: the key is
    /// read off this index's reverse map, so the caller derives none, and
    /// a type this index holds no key for is a registration it never saw
    /// - recorded, nothing registered, because a key guessed here would be
    /// a second registration under a name no reader asks.
    register_methods(mut &this, owner: TypeRef, methods: &MethodNode*[],
                     intern: InternTable*, arena: TypeArena*, site: Text) -> void {
        this.register_methods_through(owner, methods, null, intern, arena, site);
    }

    /// `register_methods` for an implement block's methods.  A return is
    /// written in the block's own parameters, and every reader of the
    /// returns this index holds substitutes the OWNER's into it (a
    /// receiver's arguments, a turbofish on the owner), so each is stored
    /// with `head` applied - the block's parameters bound to the owner's
    /// through its head (`TraitChecker::add_head_param_bindings`).  Null or
    /// empty `head` stores the return as written.
    ![allow(lookup_by_spelling, reason = "records each method's link symbol, mangled from its trait's path; the entry is keyed by the definition")]
    register_methods_through(mut &this, owner: TypeRef, methods: &MethodNode*[],
                             head: TypeSubstitution*, intern: InternTable*,
                             arena: TypeArena*, site: Text) -> void {
        const type_sym: SymbolStr = this.lookup_type_name(owner);
        if (!type_sym.is_valid()) {
            compiler::resolver::res::record_unregistered_def(site);
            return;
        }
        for (mut i: i64 = 0; i < methods.length; i++) {
            const method: MethodNode* = methods[i];
            if (method == null || method.func == null) { continue; }
            this.check_method_def(owner, method, intern);
            // Self-returning trait defaults (combinators) are deferred
            // templates with unresolved signatures - they are instantiated
            // lazily at call sites and the concrete spec is registered there
            // (`register_spec_method_in_di`).  Mangling the unresolved
            // template here would hit an invalid TypeRef and ICE.
            if (method.func.is_self_returning_default) { continue; }
            const func: FunctionDeclNode* = method.func;

            // A signature the name layer refused registers nothing under
            // the key - a call finds the refusal there and stays silent.
            if (DeclarationIndex::signature_is_refused(func)) {
                this.mark_method_signature_refused(owner, func.name);
                continue;
            }

            mut ret: TypeRef = func.resolved_return_type;
            if (head != null && head.params.length > 0 && ret.is_valid()) {
                const owned: TypeRef = head.apply(ret, arena);
                if (owned.is_valid()) { ret = owned; }
            }

            // Build full FunctionType.  A non-static method's receiver is one
            // of its parameters, written or synthesized: `&this` /
            // `mut &this` semantically a `T*`, `this` a by-value `T`.
            mut param_types: TypeRef[] = [];
            // Collect all parameter types.  `&this` / `mut &this`
            // carry a resolved pointer type from type resolution, but a
            // by-value `this` receiver is left WITHOUT a resolved_type;
            // recover it as the target struct by value (`T`) so the
            // cross-module FunctionType keeps the receiver slot.  Skipping
            // it (the `is_valid()` gate alone) drops the receiver, leaving
            // the extern declaration one argument short of the definition
            // emitted by `declare_method` (which classifies the receiver
            // from the target type directly) - every cross-module call to
            // a by-value method then fails LLVM verification with
            // "incorrect number of arguments".
            for (mut p: i64 = 0; p < func.parameters.length; p++) {
                const param: VarDeclNode* = func.parameters[p];
                if (param == null) { continue; }
                if (param.resolved_type.is_valid()) {
                    param_types.push(param.resolved_type);
                } else if (param.is_value_receiver()) {
                    const recv_ref: TypeRef = this.type_of_def(this.registered_def(owner));
                    if (recv_ref.is_valid()) {
                        param_types.push(recv_ref);
                    }
                }
            }
            // An unresolved return type cannot be mangled (encode_type_ref
            // ICEs on an invalid TypeRef).  This happens in `check` mode, where
            // monomorphization - which resolves impl-method signatures in a full
            // build - does not run, so a trait-impl method whose trait declares
            // an associated-type projection (`-> Option<This::Item>`) can reach
            // here before its concrete return type is filled.  The mangled
            // symbol only feeds codegen/linking, which `check` skips, so skip
            // the FunctionType registration + mangle rather than aborting the
            // whole compiler.  A full build always has a valid type here (the
            // guard never fires), so this is a no-op for codegen paths.
            if (!func.resolved_return_type.is_valid()) { continue; }
            const func_type_ref: TypeRef = arena.get_function(
                func.resolved_return_type, param_types, func.is_variadic);

            // Compute the mangled LLVM symbol name.  The
            // receiver-kind / non-receiver-params split is shared with the
            // codegen vtable-resolution path (see method_receiver_kind).
            const type_qname: QualifiedName = QualifiedName::from_symbol(type_sym);
            const receiver_kind: ReceiverKind = DeclarationIndex::method_receiver_kind(
                func, method.is_static, intern);
            const method_param_refs: TypeRef[] = DeclarationIndex::method_non_receiver_params(
                func, intern);
            const method_sym: SymbolStr = func.name;
            const mangled_base: MangledName = MangledName::for_method_or_trait_impl(
                intern, arena, type_qname, this.defs.path_of(func.origin_trait).spelling(), method_sym, receiver_kind,
                method_param_refs, func.resolved_return_type, func.is_variadic);
            // Fold in a generic-method spec's type args (`$MG...`) so the DI stores
            // the same disambiguated symbol the codegen definition + mono pin use;
            // otherwise a cross-module extern of `name<i64>` vs `name<u64>` (whose
            // shared signature mangles identically) would collide.  No-op (empty
            // spec_type_args) for every template / non-spec method.
            const mangled: MangledName = mangled_base.with_method_spec_args(
                intern, arena, func.spec_type_args);
            // A method bound with `![symbol("sym")]` (the C++ binding generator)
            // resolves to the foreign mangled symbol, not the Cryo mangling - so
            // register THAT as the DI symbol, making every consuming module emit
            // it for the cross-module extern.  Read from the parsed directive on
            // the MethodNode (DirectiveProcessing runs later than this pass).
            // Empty for an ordinary method -> Cryo mangling, byte-unchanged.
            const link_str: string = method.link_directive_symbol();
            const eff_mangled: SymbolStr = if (!link_str.eq("")) {
                intern.intern(link_str)
            } else {
                intern.intern(mangled.as_string())
            };
            // The entry is the declaration's identity: stamped on the node
            // so every consumer holding the node - the definition emitter,
            // a call sema or mono binds to it, a vtable slot - reads the
            // symbol and signature registration wrote, and mangles nothing.
            const entry: OverloadId = this.keep_def_entry(func.def, this.register_signature(
                FamilyOwner::Type(owner), func.name, func_type_ref, ret, eff_mangled, func.origin_trait,
                if (func.has_name_span()) { func.name_span } else { func.span }, method as ASTNode*));
            func.set_overload_entry(entry);
            // A constructor's family is its type's: `Node(1)` and `new
            // Node(1)` name the type, and its constructors are asked by it.
            if (method.is_constructor && entry.is_valid()) {
                const td: DefId = this.registered_def(owner);
                if (td.is_valid()) {
                    const ts: i64 = this.defs.slot(td);
                    while (this.ctor_families.length <= ts) { this.ctor_families.push(FamilySlot::none()); }
                    this.ctor_families[ts] = this.overload_func_family[this.slot_of(entry)];
                }
            }
            // A copy is the owner's method for the definition it stands for.
            // A specialization of a generic method is that definition AND
            // its own type arguments, an instance this table does not hold,
            // whether or not its symbol carries those arguments.
            const instance: boolean = method.spec_of != null && method.spec_of.func != null
                && method.spec_of.func.generic_params.length > 0;
            if (func.copy_of.is_valid() && func.spec_type_args.length == 0 && !instance && entry.is_valid()) {
                this.copy_entries.insert(this.copy_key(owner, func.copy_of), entry);
            }
        }
    }

    /// Register a generic type's own methods - written in its declaration or
    /// in an implement block for it - in families owned by the template's
    /// definition `template`, so the member-function door answers a member
    /// asked of the template: inside the generic body, where the receiver is
    /// the body's own unminted instantiation.  An instance's methods are
    /// registered on the instance when it is minted; these entries are the
    /// declarations, with their signatures in the template's parameters, no
    /// linker symbol, and no definition kept for them, so nothing emits or
    /// calls them.  Two methods of one signature (an inherent method and a
    /// trait's, or two traits') are two entries: an entry is its method, and
    /// registering a method again answers the entry it already has.
    register_template_methods(mut &this, template: DefId, methods: &MethodNode*[],
                              arena: TypeArena*) -> void {
        if (!template.is_valid()) { return; }
        for (mut i: i64 = 0; i < methods.length; i++) {
            const method: MethodNode* = methods[i];
            if (method == null || method.func == null) { continue; }
            const func: FunctionDeclNode* = method.func;
            if (DeclarationIndex::signature_is_refused(func)) { continue; }
            const slot: FamilySlot = this.family_slot(FamilyOwner::Template(template), func.name);
            if (slot.is_none()) { continue; }
            mut registered: boolean = false;
            match (this.overload_index.get_ref(&slot)) {
                Option::Some(positions) => {
                    for (mut k: i64 = 0; k < (*positions).length; k++) {
                        if (this.overload_func_decl[(*positions)[k] as i64] == method as ASTNode*) { registered = true; }
                    }
                }
                Option::None => { }
            }
            if (registered) { continue; }
            mut param_types: TypeRef[] = [];
            for (mut p: i64 = 0; p < func.parameters.length; p++) {
                const param: VarDeclNode* = func.parameters[p];
                if (param != null && param.resolved_type.is_valid()) { param_types.push(param.resolved_type); }
            }
            const func_type_ref: TypeRef = if (func.resolved_return_type.is_valid()) {
                arena.get_function(func.resolved_return_type, param_types, func.is_variadic)
            } else {
                TypeRef::invalid()
            };
            const id: OverloadId = this.file_entry(slot, func_type_ref, func.resolved_return_type,
                SymbolStr::empty(), func.origin_trait,
                if (func.has_name_span()) { func.name_span } else { func.span }, method as ASTNode*);
            const positions: u32[]* = this.overload_index.get_or_insert(slot, []);
            (*positions).push(this.slot_of(id) as u32);
        }
    }

    /// Whether `m` is one of `set`, by identity.
    static holds_method(set: &MethodNode*[], m: MethodNode*) -> boolean {
        if (m == null) { return false; }
        for (mut i: i64 = 0; i < set.length; i++) {
            if (set[i] == m) { return true; }
        }
        return false;
    }

    /// The methods of the family `(owner, leaf)`, in registration order: the
    /// member-function door's entries, each read back as the method it was
    /// registered for.  An entry registered for a free function is not one.
    methods_named(&this, owner: FamilyOwner, leaf: SymbolStr) -> MethodNode*[] {
        const entries: OverloadId[] = this.lookup_family_entries(owner, leaf);
        mut out: MethodNode*[] = [];
        for (mut i: i64 = 0; i < entries.length; i++) {
            const m: MethodNode* = this.entry_method(entries[i]);
            if (m != null) { out.push(m); }
        }
        return out;
    }

    /// The method type `ty` holds for its family under `leaf`: the first of
    /// the type's own method records whose declaration the member-function
    /// door answers for `(ty, leaf)`, or null.  A struct's, a class's own
    /// (its bases hold theirs) or an enum's.
    type_method(&this, ty: TypeRef, leaf: SymbolStr, arena: TypeArena*) -> MethodInfo* {
        const t: Type* = arena.lookup(ty);
        if (t == null) { return null; }
        const no_methods: MethodInfo[] = [];
        mut methods: &MethodInfo[] = &no_methods;
        if (t.kind == TypeKind::Struct) {
            methods = &(t as StructType*).methods;
        } else if (t.kind == TypeKind::Class) {
            methods = &(t as ClassType*).methods;
        } else if (t.kind == TypeKind::Enum) {
            methods = &(t as EnumType*).methods;
        } else {
            return null;
        }
        const named: MethodNode*[] = this.methods_named(FamilyOwner::Type(ty), leaf);
        for (mut i: i64 = 0; i < methods.length; i++) {
            if (DeclarationIndex::holds_method(&named, methods[i].ast_node as MethodNode*)) { return &methods[i]; }
        }
        return null;
    }


    // Lookups (called by Sema and future passes)

    /// The signature last registered in the family `(owner, leaf)`.  A
    /// function's return type is this signature's; there is no second map
    /// keyed by the same family that could answer differently.
    lookup_func_type(&this, owner: FamilyOwner, leaf: SymbolStr) -> TypeRef {
        const slot: FamilySlot = this.family_slot(owner, leaf);
        return match (this.func_type_refs.get(&slot)) {
            Option::Some(val) => { val }
            Option::None      => { TypeRef::invalid() }
        };
    }

    /// The function type the stamp `r` names, or invalid when it names no
    /// definition.
    ///
    /// Keyed by the `Res` and not by a spelling, because the two do not select
    /// the same declaration: a canonical name identifies ONE, while the bare
    /// `func_type_refs` slot is single-slot last-write-wins across every module
    /// declaring that leaf.  Three modules declare `sleep` with three different
    /// signatures, so a call to an imported one asked by leaf can be handed
    /// `libc::sleep`'s - and this type is what expected-type propagation gives
    /// the arguments.
    func_type_of_res(&this, r: res::Res) -> TypeRef {
        return this.func_type_of_def(r.def_id());
    }

    /// The function type of the definition `d`: the signature its own
    /// declaration was registered with (`entry_of_def`).  Invalid when `d`
    /// names none or no registration reached it.  Asked by the definition and
    /// not by its family - its parent and leaf - because a family holds every
    /// overload declared under the leaf, and its slot keeps whichever
    /// registered last.
    func_type_of_def(&this, d: DefId) -> TypeRef {
        return this.entry_signature(this.entry_of_def(d));
    }

    /// The TYPE the stamp `r` names, or invalid when it names no definition
    /// or the definition is not a type.  Sibling of `func_type_of_res`, for
    /// the same reason.
    type_of_res(&this, r: res::Res) -> TypeRef {
        return this.type_of_def(r.def_id());
    }

    /// The type an impl head is for, off the head's stamp - the one reader
    /// of that stamp for every pass that walks an impl block.
    ///
    /// One answering path per kind of answer the slot can carry, each an
    /// exact lookup under the key that kind supplies, never a retry of one
    /// key under another.  A `Def` is canonical, so the index holds it or the
    /// declaration never registered - recorded against `site`.  A written
    /// primitive is `PrimTy` and names no declaration, because a primitive
    /// owns members without being declared anywhere; the primitive table's
    /// answer is its identity, and its definition (`DefTable::primitive`) is
    /// what its type is registered under.  An unanswered slot belongs to the cloner, which
    /// leaves a specialization alone because a `Res` names a definition and
    /// a specialization is not one - there the monomorphizer's `spec_owner`,
    /// the instantiation's own arena id, is the carrier.  Every head a
    /// synthesizer builds is stamped by that synthesizer.
    ///
    /// Nothing else can name a type here: a type parameter, a local and an
    /// already-failed resolution each name something that is not a
    /// declaration, so there is no key to look one up under.
    impl_owner(&this, node: ImplBlockNode*, site: Text) -> TypeRef {
        return match (node.res) {
            ResSlot::Answered(r) => {
                match (r) {
                    Res::Def(q) => {
                        const found: TypeRef = this.type_of_def(q);
                        if (!found.is_valid()) { compiler::resolver::res::record_unregistered_def(site); }
                        found
                    }
                    Res::PrimTy(n) => { this.type_of_def(this.defs.primitive(n)) }
                    _              => { TypeRef::invalid() }
                }
            }
            _ => { node.spec_owner }
        };
    }

    /// The owner implement block `node` is for: the definition its head
    /// names, a type's or a primitive's (a template's, whose methods are kept
    /// under `FamilyOwner::Template` of it, is the caller's to tell apart),
    /// or, for a specialization's clone, which names none, the instantiation
    /// it was placed on.
    impl_family_owner(&this, node: ImplBlockNode*) -> FamilyOwner {
        return match (node.res) {
            ResSlot::Answered(r) => {
                match (r) {
                    Res::Def(q)    => { FamilyOwner::Def(q) }
                    Res::PrimTy(n) => { FamilyOwner::Def(this.defs.primitive(n)) }
                    _              => { FamilyOwner::Def(DefId::invalid()) }
                }
            }
            _ => { FamilyOwner::Type(node.spec_owner) }
        };
    }

    /// The type of the declaration whose registration stamped `d` on its
    /// node.  A door, not a lookup with a fallback: the stamp is written by
    /// the registration that minted it, so an invalid `d` is a node no
    /// registration reached and a valid one the index does not answer is a
    /// registration lost after it stamped.  Neither is a licence to ask by
    /// another key - the only other key is one re-derived from the node,
    /// which names the wrong module for a trait default's `async` future -
    /// so both are recorded and the caller gets an invalid type, which stops
    /// it as a real failure would.
    type_of_decl(&this, d: DefId, site: Text) -> TypeRef {
        if (!d.is_valid()) {
            compiler::resolver::res::record_unstamped_decl(site);
            return TypeRef::invalid();
        }
        const found: TypeRef = this.type_of_def(d);
        if (!found.is_valid()) { compiler::resolver::res::record_unregistered_def(site); }
        return found;
    }
    /// The type the definition `d` was registered as, or invalid when `d`
    /// names none or no type registration reached it.  Sibling of
    /// `func_type_of_def`.  Asked by the definition, not by its path: a
    /// function and a type may share a path, and a lookup by path hands the
    /// function the type.
    type_of_def(&this, d: DefId) -> TypeRef {
        if (!d.is_valid()) { return TypeRef::invalid(); }
        const slot: i64 = this.defs.slot(d);
        if (slot >= this.def_types.length) { return TypeRef::invalid(); }
        return this.def_types[slot];
    }

    /// Look up an implicit converter for `(arg_ty) -> ret_ty` by their
    /// canonical arena types: the converter's definition, or an invalid id
    /// if none is registered.
    lookup_implicit_converter(&this, arg_ty: TypeRef, ret_ty: TypeRef) -> DefId {
        const key: ConversionKey = DeclarationIndex::converter_key(arg_ty, ret_ty);
        return match (this.implicit_converters.get(&key)) {
            Option::Some(v) => { v }
            Option::None    => { DefId::invalid() }
        };
    }

    /// Reverse-lookup: get the SymbolStr for a TypeRef.
    lookup_type_name(&this, ty: TypeRef) -> SymbolStr {
        return this.defs.path_of(this.registered_def(ty)).spelling();
    }

    /// Register a free function's signature under its key `name`, emitted
    /// under `symbol` when one is given (an `extern "C"` declaration's C
    /// name, a `![symbol]` link name, an intrinsic's bare name) and under
    /// the Cryo mangling of the signature otherwise.  Answers the entry,
    /// which the caller stamps on the node, and keeps it under `def`, the
    /// definition the signature declares, for `entry_of_def`; `def` is
    /// invalid for a clone or a synthesized function, which declares none of
    /// its own.
    register_function_signature(mut &this, owner: FamilyOwner, leaf: SymbolStr,
                                return_type: TypeRef, func_type_ref: TypeRef,
                                intern: InternTable*, arena: TypeArena*,
                                symbol: SymbolStr, span: SourceSpan, def: DefId,
                                decl: ASTNode*) -> OverloadId {
        const sym: SymbolStr = if (symbol.is_valid()) {
            symbol
        } else {
            this.mangle_function_symbol(owner, leaf, return_type, func_type_ref, intern, arena)
        };
        return this.keep_def_entry(def,
            this.register_signature(owner, leaf, func_type_ref, return_type, sym, DefId::invalid(), span, decl));
    }

    /// The Cryo mangling of a free function named `leaf` under `owner`,
    /// with signature `func_type_ref`: the qualified name it encodes is the
    /// owner's path and the leaf, as a definition's own path is composed.
    ![allow(lookup_by_spelling, reason = "a declaration's own name, mangled into its symbol; it keys no store")]
    mangle_function_symbol(&this, owner: FamilyOwner, leaf: SymbolStr, return_type: TypeRef,
                           func_type_ref: TypeRef, intern: InternTable*, arena: TypeArena*) -> SymbolStr {
        const owner_path: DeclName = this.family_owner_path(owner);
        const name: SymbolStr = if (owner_path.is_valid()) {
            intern.intern(intern.shown(owner_path) + "::" + intern.resolve(leaf))
        } else {
            leaf
        };
        const qname: QualifiedName = QualifiedName::from_symbol(name);
        // Borrow the FunctionType's param list rather than aliasing it into an
        // owning local: a `mut params: TypeRef[] = ...; params = fn_ty.param_types`
        // local would free the FunctionType's buffer when it drops (the
        // signature array is still owned by the arena type) - a use-after-free
        // the mangler hit while reading the borrowed params.
        const empty_params: TypeRef[] = [];
        mut params: &TypeRef[] = &empty_params;
        mut is_variadic: boolean = false;
        const ft: Type* = arena.lookup(func_type_ref);
        if (ft != null && ft.kind == TypeKind::Function) {
            const fn_ty: FunctionType* = ft as FunctionType*;
            params = &fn_ty.param_types;
            is_variadic = fn_ty.is_variadic;
        }
        const mangled: MangledName = MangledName::for_free_function(
            intern, arena, qname, params, return_type, is_variadic);
        return intern.intern(mangled.as_string());
    }

    /// Keep `entry` under the definition `def` for `entry_of_def`, and
    /// answer it; nothing is kept for an invalid `def` or entry.
    keep_def_entry(mut &this, def: DefId, entry: OverloadId) -> OverloadId {
        if (def.is_valid() && entry.is_valid()) {
            const slot: i64 = this.defs.slot(def);
            while (this.def_entries.length <= slot) { this.def_entries.push(OverloadId::invalid()); }
            this.def_entries[slot] = entry;
        }
        return entry;
    }


    // --- Import-scoped resolution: population + query -----------------------

    /// Record the modules module `m` can see through its imports, for later
    /// use-site scoping.  Called once per module by the orchestrator after
    /// module discovery.
    register_module_imports(mut &this, m: ModulePath, imports: &ModulePath[]) -> void {
        mut ids: u32[] = [];
        for (mut i: i64 = 0; i < imports.length; i++) {
            ids.push(imports[i].as_sym().id);
        }
        this.module_imports.insert(m.as_sym().id, ids);
    }

    /// Record the namespaces re-exported by `std::prelude` (deduped).  A local
    /// same-leaf as any type in these namespaces is a hard conflict.
    ///
    /// These namespaces' public types (Rc, Box, Option, Result, Range,
    /// Iterator, Array, Slice, ...) are auto-in-scope in every module via the
    /// injected `import std::prelude`.
    ///
    /// The list is DERIVED from `stdlib/prelude.cryo`'s `public module`
    /// declarations by the caller (`instance.cryo`), which reads them off the
    /// module graph.  It arrives as a parameter for the same reason
    /// `register_module_imports` does: `module_graph.cryo` already imports this
    /// module, so reaching a `ModuleGraph*` back the other way is a cycle Cryo
    /// forbids.
    register_prelude_namespaces(mut &this, prelude: ModulePath[]) -> void {
        for (mut i: i64 = 0; i < prelude.length; i++) {
            mut seen: boolean = false;
            for (mut j: i64 = 0; j < this.prelude_modules.length; j++) {
                if (this.prelude_modules[j].equals(prelude[i])) { seen = true; }
            }
            if (!seen) { this.prelude_modules.push(prelude[i]); }
        }
    }

    /// Record a function's visibility on its definition: a type's is
    /// recorded by `register_type`.  A type and a function declared under one
    /// leaf are two definitions with a verdict each.
    ///
    /// It does not gate bare function calls.  A bare `foo()` binds from its
    /// stamp, and the name layer refuses a private declaration at the import
    /// that would have bound it; the verdict is read for a QUALIFIED call's
    /// callee (`hidden_from`), where a module's own private items are never
    /// refused because the modules are compared first.
    set_decl_visibility(mut &this, def: DefId, is_public: boolean) -> void {
        this.defs.record_visibility(def, is_public);
    }

    /// Record that the family `(owner, method)` holds a method whose
    /// signature was refused.  A type this index never registered owns no
    /// family, and records nothing.
    ![allow(lookup_by_spelling, reason = "a family is a member leaf asked of an owner identity, the member-function door's own key")]
    mark_method_signature_refused(mut &this, owner: TypeRef, method: SymbolStr) -> void {
        const slot: FamilySlot = this.family_slot(FamilyOwner::Type(owner), method);
        if (slot.is_none()) { return; }
        this.refused_methods.insert(slot, true);
    }

    /// Whether the family `(owner, method)` holds a method whose signature
    /// was refused.
    ![allow(lookup_by_spelling, reason = "a family is a member leaf asked of an owner identity, the member-function door's own key")]
    method_signature_refused(&this, owner: TypeRef, method: SymbolStr) -> boolean {
        const slot: FamilySlot = this.family_slot(FamilyOwner::Type(owner), method);
        if (slot.is_none()) { return false; }
        return this.refused_methods.contains_key(&slot);
    }

    /// Whether `func`'s written signature carries a name the name layer
    /// refused: its return type, or any parameter's.  Asked only of a slot
    /// that resolved to no type - a resolved slot was not refused, and
    /// `refused` reads the annotation's stamp through `require`, which a
    /// synthesized declaration's annotation may not carry.  A `this`
    /// receiver has no annotation and is never refused.
    static signature_is_refused(func: FunctionDeclNode*) -> boolean {
        if (func == null) { return false; }
        if (!func.resolved_return_type.is_valid()
                && TypeAnnotation::refused(func.return_type_annotation)) { return true; }
        for (mut p: i64 = 0; p < func.parameters.length; p++) {
            const param: VarDeclNode* = func.parameters[p];
            if (param == null || param.resolved_type.is_valid()) { continue; }
            if (TypeAnnotation::refused(param.type_annotation)) { return true; }
        }
        return false;
    }

    /// The namespaces reachable without an import, as recorded.
    ///
    /// The visibility relation and the scope walk's outermost tier are the same
    /// set asked two ways, so both read this one registration; a prelude the
    /// one accepts and the other does not bind is the gap that sends a name to
    /// a leaf-index search instead of to its module.
    prelude_namespaces(&this) -> ModulePath[] {
        mut out: ModulePath[] = [];
        for (mut i: i64 = 0; i < this.prelude_modules.length; i++) {
            out.push(this.prelude_modules[i]);
        }
        return out;
    }

    is_prelude_ns(&this, ns: ModulePath) -> boolean {
        for (mut i: i64 = 0; i < this.prelude_modules.length; i++) {
            if (this.prelude_modules[i].equals(ns)) { return true; }
        }
        return false;
    }

    /// Whether the module `use_site_ns` imports (depends on) `target_ns`.
    ns_imports(&this, use_site_ns: ModulePath, target_ns: ModulePath) -> boolean {
        match (this.module_imports.get_ref(&use_site_ns.as_sym().id)) {
            Option::Some(ids) => {
                mut k: i64 = 0;
                while (k < (*ids).length) {
                    if ((*ids)[k] == target_ns.as_sym().id) { return true; }
                    k = k + 1;
                }
            }
            Option::None => { }
        }
        return false;
    }

    /// Whether the definition `d` is private to a module other than
    /// `use_module`: declared in another module, and recorded as not public
    /// by its registration.  False for a definition of `use_module` itself,
    /// or one declared in no module.
    ///
    /// Every registration records a verdict (a type's with `register_type`,
    /// a function's beside its signature), so a definition with none never
    /// registered - recorded as such, which fails the build; the answer given
    /// meanwhile is the top-level default rather than a refusal that would
    /// report a public item as private.
    hidden_from(&this, d: DefId, use_module: DefId) -> boolean {
        if (!d.is_valid() || !use_module.is_valid()) { return false; }
        const home: DefId = this.defs.module_of(d);
        if (!home.is_valid() || home.equals(use_module)) { return false; }
        return match (this.defs.visibility_of(d)) {
            DeclVisibility::Public     => { false }
            DeclVisibility::Private    => { true }
            DeclVisibility::Unrecorded => {
                compiler::resolver::res::record_unregistered_def(
                    Text::new("decl_index: visibility of a definition no registration recorded a verdict for"));
                false
            }
        };
    }

    /// The implicit-converter registry key of the argument and return
    /// types: the upper 32 bits the argument's number, the lower 32 the
    /// return's.
    static converter_key(arg_ty: TypeRef, ret_ty: TypeRef) -> ConversionKey {
        return ConversionKey { packed: (arg_ty.key() << 32) | (ret_ty.key() & 0xFFFFFFFF) };
    }


    /// Decode the receiver kind for a method given its AST.  This is the
    /// single source of truth used by every mangler call site so the
    /// produced symbol names converge.
    ///
    ///   `&this`          -> ImmutRef        (encoded as $s)
    ///   `mut &this`      -> MutRef          (encoded as $m)
    ///   `this` (by value)-> None            (regular first param)
    ///   static method    -> None
    static method_receiver_kind(func: FunctionDeclNode*, is_static: boolean,
                                  intern: InternTable*) -> ReceiverKind {
        if (is_static || func == null) { return ReceiverKind::None; }

        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null) { continue; }
            if (param.is_ref_receiver()) {
                if (param.is_mutable) { return ReceiverKind::MutRef; }
                return ReceiverKind::ImmutRef;
            }
            if (param.is_value_receiver()) {
                return ReceiverKind::None;
            }
        }
        // No receiver parameter, so there is no receiver to encode.  Every
        // non-static method carries one, written or synthesized.
        return ReceiverKind::None;
    }

    /// Collect the non-receiver parameter TypeRefs for use with the
    /// `for_method` mangler.  Strips out `&this` (always a marker) but
    /// keeps `this` (since its by-value form is encoded as a regular param).
    static method_non_receiver_params(func: FunctionDeclNode*,
                                        intern: InternTable*) -> TypeRef[] {
        mut out: TypeRef[] = [];
        if (func == null) { return out; }

        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null || !param.resolved_type.is_valid()) { continue; }
            if (param.is_ref_receiver()) { continue; }
            out.push(param.resolved_type);
        }
        return out;
    }
}
