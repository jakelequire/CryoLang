/// AST Expression Nodes
///
/// ExpressionNode base and all 19 concrete expression classes.

namespace Compiler::AST::Expression;

import Compiler::Diag;
import Compiler::AST;
import Compiler::Diag::SourceSpan;
import Compiler::Lex;
import Compiler::AST::Node;
import Compiler::Types::TypeRef;
import Compiler::Resolver::SymbolStr;

type class ExpressionNode : ASTNode {
public:
    resolved_type: TypeRef;

    /// Set by sema when this expression is a by-value argument passed to a
    /// reference (`&T`) parameter.  Codegen reads it to take the value's
    /// address (auto-ref) rather than passing the value itself.  Defaults
    /// to false; only the call-argument resolution paths set it.
    autoref: boolean;

    ExpressionNode(kind: NodeKind, span: SourceSpan) : ASTNode(kind, span) {
        this.resolved_type = TypeRef::invalid();
        this.autoref       = false;
    }

    set_resolved_type(t: TypeRef) -> void { this.resolved_type = t; }
    has_resolved_type() -> boolean        { return this.resolved_type.is_valid(); }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


// Concrete Expression Nodes

type class LiteralNode : ExpressionNode {
public:
    value:        string;
    literal_kind: LiteralKind;

    LiteralNode(value: string, literal_kind: LiteralKind, span: SourceSpan)
        : ExpressionNode(NodeKind::Literal, span) {
        this.value        = value;
        this.literal_kind = literal_kind;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class IdentifierNode : ExpressionNode {
public:
    name:                SymbolStr;
    is_global_reference: boolean;

    /// Turbofish type args on a bare function-reference value, e.g.
    /// `tramp<i32>` used as a value (not called: not followed by `(`).
    /// Empty for ordinary identifiers. When set, the identifier names a
    /// generic function template instantiated for these args; the
    /// monomorphizer pins `resolved_callee` to the specialized symbol so
    /// codegen references the monomorphized function instead of the bare
    /// template (which is skipped at codegen).
    generic_args:        TypeAnnotation*[];

    /// Specialized callee symbol for a generic function-reference value,
    /// pinned by the monomorphizer (mirrors `CallExprNode.resolved_callee`).
    /// Empty for non-generic identifiers.
    resolved_callee:     SymbolStr;

    IdentifierNode(name: SymbolStr, span: SourceSpan)
        : ExpressionNode(NodeKind::Identifier, span) {
        this.name                = name;
        this.is_global_reference = false;
        this.generic_args        = [];
        this.resolved_callee     = SymbolStr::empty();
    }

    set_global_reference(v: boolean) -> void {
        this.is_global_reference = v;
    }

    set_generic_args(args: TypeAnnotation*[]) -> void {
        this.generic_args = args;
    }

    set_resolved_callee(name: SymbolStr) -> void {
        this.resolved_callee = name;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class BinaryExprNode : ExpressionNode {
public:
    op:    Token;
    left:  ExpressionNode*;
    right: ExpressionNode*;

    BinaryExprNode(op: Token, left: ExpressionNode*, right: ExpressionNode*, span: SourceSpan)
        : ExpressionNode(NodeKind::BinaryExpression, span) {
        this.op    = op;
        this.left  = left;
        this.right = right;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class UnaryExprNode : ExpressionNode {
public:
    op:         Token;
    operand:    ExpressionNode*;
    /// True for postfix ++/-- (`a++`, `a--`), false for prefix and all
    /// other unary ops.  Codegen uses this to decide whether `a++` returns
    /// the old value (postfix) or `++a` returns the new value (prefix).
    /// Without this discriminator both forms emit the same node and codegen
    /// always returned the old value, silently turning `++a` into the same
    /// as `a++` for expression-value purposes.
    is_postfix: boolean;
    /// True for compiler-synthesized unary nodes (e.g. the `&rhs` produced
    /// when desugaring `a <=> b` into `a.compare(&rhs)`). Semantic checks
    /// that constrain user syntax - such as "no address-of a literal"
    /// (E0223) - skip synthesized nodes, which legitimately take the
    /// address of a temporary the compiler just materialized.
    is_synthetic: boolean;

    UnaryExprNode(op: Token, operand: ExpressionNode*, span: SourceSpan)
        : ExpressionNode(NodeKind::UnaryExpression, span) {
        this.op           = op;
        this.operand      = operand;
        this.is_postfix   = false;
        this.is_synthetic = false;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class TernaryExprNode : ExpressionNode {
public:
    condition:  ExpressionNode*;
    true_expr:  ExpressionNode*;
    false_expr: ExpressionNode*;

    TernaryExprNode(condition: ExpressionNode*, true_expr: ExpressionNode*,
                    false_expr: ExpressionNode*, span: SourceSpan)
        : ExpressionNode(NodeKind::TernaryExpression, span) {
        this.condition  = condition;
        this.true_expr  = true_expr;
        this.false_expr = false_expr;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class IfExprNode : ExpressionNode {
public:
    condition: ExpressionNode*;
    then_expr: ExpressionNode*;
    else_expr: ExpressionNode*;

    IfExprNode(condition: ExpressionNode*, then_expr: ExpressionNode*,
               else_expr: ExpressionNode*, span: SourceSpan)
        : ExpressionNode(NodeKind::IfExpression, span) {
        this.condition = condition;
        this.then_expr = then_expr;
        this.else_expr = else_expr;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class MatchExprNode : ExpressionNode {
public:
    subject: ExpressionNode*;
    arms:    MatchArmNode*[];

    MatchExprNode(subject: ExpressionNode*, span: SourceSpan)
        : ExpressionNode(NodeKind::MatchExpression, span) {
        this.subject = subject;
        this.arms    = [];
    }

    add_arm(arm: MatchArmNode*) -> void {
        this.arms.push(arm);
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


/// `static match (T) { u32 => {...} bool => {...} _ => {...} }` — compile-time
/// type dispatch. The scrutinee is a TYPE annotation (commonly a generic
/// parameter), and each arm's pattern is a TYPE. The monomorphizer resolves the
/// (now-concrete, post-substitution) scrutinee and prunes every arm whose type
/// does not match, BEFORE type-checking, leaving a single live arm. Sema and
/// codegen then treat the reduced node as "evaluate the one arm's block, yield
/// its trailing expression" — see StaticMatchArmNode.
type class StaticMatchExprNode : ExpressionNode {
public:
    scrutinee: TypeAnnotation*;
    arms:      StaticMatchArmNode*[];

    StaticMatchExprNode(scrutinee: TypeAnnotation*, span: SourceSpan)
        : ExpressionNode(NodeKind::StaticMatchExpression, span) {
        this.scrutinee = scrutinee;
        this.arms      = [];
    }

    add_arm(arm: StaticMatchArmNode*) -> void {
        this.arms.push(arm);
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class CallExprNode : ExpressionNode {
public:
    callee:       ExpressionNode*;
    arguments:    ExpressionNode*[];
    generic_args: TypeAnnotation*[];
    /// Sema-resolved method declaration for method calls.  Typed as
    /// `ASTNode*` to avoid a circular import between Expression and
    /// Declaration; always downcast to `MethodNode*` at the use site.
    /// Set by sema after overload resolution picks a specific method;
    /// null for non-method calls (free functions, scope-resolution,
    /// function-pointer calls) and for calls sema couldn't resolve.
    /// Codegen reads this to find the correct vtable slot; the resolved
    /// declaration uniquely pins (name, param types), which is the slot
    /// identity.
    resolved_method: ASTNode*;

    /// Sema-resolved specialized callee symbol for generic free-function
    /// calls.  When `identity<i32>(42)` or `alloc_entry(map, h, k, v)`
    /// (with K/V/A inferred from arg types) reaches sema, the bare-name
    /// `identity` template is renamed to its specialization
    /// (e.g. `identity$Li32$G`) by the AST specializer.  Sema computes
    /// that spec symbol here so codegen can look up the concrete
    /// LLVM function instead of the bare template (which is skipped
    /// at codegen).  Empty for non-generic free-function calls.
    resolved_callee: SymbolStr;

    /// Sema-resolved concrete type-arg bindings for a generic free-function
    /// call, parallel to the template's generic-parameter declaration order.
    /// Sema's `check_generic_free_call` infers (or reads the turbofish for)
    /// these and stores them here so the monomorphizer can enqueue the exact
    /// instantiation WITHOUT re-running its own inference - sema is the sole
    /// source of truth for resolved types (mono-after-sema).  Empty for
    /// non-generic free calls and for calls sema deferred.
    resolved_type_args: TypeRef[];

    CallExprNode(callee: ExpressionNode*, span: SourceSpan)
        : ExpressionNode(NodeKind::CallExpression, span) {
        this.callee             = callee;
        this.arguments          = [];
        this.generic_args       = [];
        this.resolved_method    = null;
        this.resolved_callee    = SymbolStr::empty();
        this.resolved_type_args = [];
    }

    add_argument(arg: ExpressionNode*) -> void {
        this.arguments.push(arg);
    }

    /// Replace the argument at `idx` in place.  Used by sema when it
    /// rewrites a call argument (e.g. wrapping it in an implicit-conversion
    /// call).  Caller must ensure `idx` is in range.
    set_argument(idx: i64, arg: ExpressionNode*) -> void {
        this.arguments[idx] = arg;
    }

    set_generic_args(args: TypeAnnotation*[]) -> void {
        this.generic_args = args;
    }

    set_resolved_method(m: ASTNode*) -> void {
        this.resolved_method = m;
    }

    set_resolved_callee(name: SymbolStr) -> void {
        this.resolved_callee = name;
    }

    set_resolved_type_args(args: TypeRef[]) -> void {
        this.resolved_type_args = args;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class NewExprNode : ExpressionNode {
public:
    type_name:    SymbolStr;
    /// Set when the source spelling was `new EnumType::Variant(args)`.
    /// Empty for plain class `new` like `new Foo(args)`.  Codegen
    /// dispatches to enum-variant construction (build_enum_variant)
    /// when this is non-empty, since enums don't have class-style
    /// constructors that the class-`new` path can call.
    variant_name: SymbolStr;
    generic_args: TypeAnnotation*[];
    arguments:    ExpressionNode*[];
    array_size:   ExpressionNode*;
    struct_init:  StructLiteralNode*;

    NewExprNode(type_name: SymbolStr, span: SourceSpan)
        : ExpressionNode(NodeKind::NewExpression, span) {
        this.type_name    = type_name;
        this.variant_name = SymbolStr::empty();
        this.generic_args = [];
        this.arguments    = [];
        this.array_size   = null;
        this.struct_init  = null;
    }

    has_array_size() -> boolean { return this.array_size != null; }
    has_struct_init() -> boolean { return this.struct_init != null; }
    has_variant() -> boolean { return this.variant_name.is_valid(); }

    add_argument(arg: ExpressionNode*) -> void {
        this.arguments.push(arg);
    }

    set_generic_args(args: TypeAnnotation*[]) -> void {
        this.generic_args = args;
    }

    set_array_size(size: ExpressionNode*) -> void {
        this.array_size = size;
    }

    set_variant_name(name: SymbolStr) -> void {
        this.variant_name = name;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class SizeofExprNode : ExpressionNode {
public:
    type_name: SymbolStr;
    type_span: SourceSpan;
    /// Full type-annotation form (e.g., `HashMapEntry<K, V>`).  Captured
    /// by the parser so generic args survive cloning/substitution and
    /// codegen can resolve to the correct specialization.  May be null
    /// if the AST was built without going through the parser path.
    type_ann: TypeAnnotation*;

    SizeofExprNode(type_name: SymbolStr, type_span: SourceSpan, span: SourceSpan)
        : ExpressionNode(NodeKind::SizeofExpression, span) {
        this.type_name = type_name;
        this.type_span = type_span;
        this.type_ann  = null;
    }

    set_type_ann(ann: TypeAnnotation*) -> void { this.type_ann = ann; }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class AlignofExprNode : ExpressionNode {
public:
    type_name: SymbolStr;
    type_span: SourceSpan;
    /// Full type-annotation form (e.g., `HashMapEntry<K, V>`).  Same
    /// rationale as SizeofExprNode.type_ann.
    type_ann: TypeAnnotation*;

    AlignofExprNode(type_name: SymbolStr, type_span: SourceSpan, span: SourceSpan)
        : ExpressionNode(NodeKind::AlignofExpression, span) {
        this.type_name = type_name;
        this.type_span = type_span;
        this.type_ann  = null;
    }

    set_type_ann(ann: TypeAnnotation*) -> void { this.type_ann = ann; }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class CastExprNode : ExpressionNode {
public:
    expression:        ExpressionNode*;
    target_annotation: TypeAnnotation*;
    resolved_target:   TypeRef;

    CastExprNode(expression: ExpressionNode*, target_annotation: TypeAnnotation*,
                 span: SourceSpan)
        : ExpressionNode(NodeKind::CastExpression, span) {
        this.expression        = expression;
        this.target_annotation = target_annotation;
        this.resolved_target   = TypeRef::invalid();
    }

    has_resolved_target() -> boolean { return this.resolved_target.is_valid(); }

    set_resolved_target(t: TypeRef) -> void {
        this.resolved_target = t;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


/// A field initializer in a struct literal (e.g., `name: value`).
type struct FieldInit {
    field_name: SymbolStr;
    value:      ExpressionNode*;
    span:       SourceSpan;
}

type class StructLiteralNode : ExpressionNode {
public:
    struct_type:  SymbolStr;
    generic_args: TypeAnnotation*[];
    field_inits:  FieldInit[];

    StructLiteralNode(struct_type: SymbolStr, span: SourceSpan)
        : ExpressionNode(NodeKind::StructLiteral, span) {
        this.struct_type  = struct_type;
        this.generic_args = [];
        this.field_inits  = [];
    }

    set_generic_args(args: TypeAnnotation*[]) -> void {
        this.generic_args = args;
    }

    add_field_init(init: FieldInit) -> void {
        this.field_inits.push(init);
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class ArrayLiteralNode : ExpressionNode {
public:
    elements:          ExpressionNode*[];
    element_type:      string;
    repeat_count:      i64;
    repeat_count_expr: ExpressionNode*;

    ArrayLiteralNode(span: SourceSpan)
        : ExpressionNode(NodeKind::ArrayLiteral, span) {
        this.elements          = [];
        this.element_type      = "";
        this.repeat_count      = 0;
        this.repeat_count_expr = null;
    }

    add_element(elem: ExpressionNode*) -> void {
        this.elements.push(elem);
    }

    set_element_type(t: string) -> void {
        this.element_type = t;
    }

    set_repeat_count(count: i64) -> void {
        this.repeat_count = count;
    }

    set_repeat_count_expr(expr: ExpressionNode*) -> void {
        this.repeat_count_expr = expr;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class TupleLiteralNode : ExpressionNode {
public:
    elements: ExpressionNode*[];

    TupleLiteralNode(span: SourceSpan)
        : ExpressionNode(NodeKind::TupleLiteral, span) {
        this.elements = [];
    }

    add_element(elem: ExpressionNode*) -> void {
        this.elements.push(elem);
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class LambdaExprNode : ExpressionNode {
public:
    parameters:      VarDeclNode*[];
    return_type:     TypeRef;
    return_type_ann: TypeAnnotation*;
    body:            StatementNode*;
    // Free variables referenced by the body that resolve to outer-function
    // locals - parallel arrays populated by Sema::resolve_lambda when the
    // body references an enclosing-scope binding.  Empty for non-capturing
    // lambdas; the codegen path branches on `captured_names.length == 0`.
    // Spans point at the *use* site that first triggered the capture (for
    // future diagnostics, e.g. non-Copy capture rejection).
    captured_names:  SymbolStr[];
    captured_types:  TypeRef[];
    captured_spans:  SourceSpan[];
    // `move (...) -> T { ... }` opts the closure into capture-by-move
    // semantics: non-Copy captures are permitted (and become move sites
    // on the outer binding), and the synthesized closure struct gets a
    // Drop method that drops each non-Copy field.
    is_move:         boolean;

    LambdaExprNode(span: SourceSpan)
        : ExpressionNode(NodeKind::LambdaExpression, span) {
        this.parameters      = [];
        this.return_type     = TypeRef::invalid();
        this.return_type_ann = null;
        this.body            = null;
        this.captured_names  = [];
        this.captured_types  = [];
        this.captured_spans  = [];
        this.is_move         = false;
    }

    add_parameter(param: VarDeclNode*) -> void {
        this.parameters.push(param);
    }

    set_return_type(t: TypeRef) -> void {
        this.return_type = t;
    }

    set_return_type_ann(ann: TypeAnnotation*) -> void {
        this.return_type_ann = ann;
    }

    set_body(b: StatementNode*) -> void {
        this.body = b;
    }

    /// Record a free-variable use of an outer-scope binding.  Idempotent:
    /// a name already in `captured_names` is not re-added (the body may
    /// reference the same outer local multiple times).
    add_capture(name: SymbolStr, ty: TypeRef, span: SourceSpan) -> void {
        for (mut i: i64 = 0; i < this.captured_names.length; i++) {
            if (this.captured_names[i].id == name.id) { return; }
        }
        this.captured_names.push(name);
        this.captured_types.push(ty);
        this.captured_spans.push(span);
    }

    is_capturing() -> boolean {
        return this.captured_names.length > 0;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class ArrayAccessNode : ExpressionNode {
public:
    array: ExpressionNode*;
    index: ExpressionNode*;

    ArrayAccessNode(array: ExpressionNode*, index: ExpressionNode*, span: SourceSpan)
        : ExpressionNode(NodeKind::ArrayAccess, span) {
        this.array = array;
        this.index = index;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class MemberAccessNode : ExpressionNode {
public:
    object:       ExpressionNode*;
    member:       SymbolStr;
    member_span:  SourceSpan;
    /// Explicit type arguments after the member name: `obj.method<T, U>(...)`.
    /// Empty when the member name has no `<...>` clause.  Carried here so
    /// the call expression that wraps the member access can pick them up.
    generic_args: TypeAnnotation*[];
    /// Disambiguating trait for this method call when two traits declare a
    /// same-named method (e.g. `Display::fmt` / `Debug::fmt`) and the
    /// receiver implements both.  The receiver's concrete type alone can't
    /// say which the caller meant; the bound (`where T: Debug`) or the
    /// enclosing trait-impl context can.  Set PRE-monomorphization by
    /// `annotate_bound_dispatch_in_module` (the bound is only known then)
    /// and consulted by the monomorphizer's trait-impl method lookups so
    /// the spec picks the right trait's impl.  Empty when there is no such
    /// disambiguation to make.
    resolved_trait: SymbolStr;

    MemberAccessNode(object: ExpressionNode*, member: SymbolStr,
                     member_span: SourceSpan, span: SourceSpan)
        : ExpressionNode(NodeKind::MemberAccess, span) {
        this.object         = object;
        this.member         = member;
        this.member_span    = member_span;
        this.generic_args   = [];
        this.resolved_trait = SymbolStr::empty();
    }

    set_generic_args(args: TypeAnnotation*[]) -> void {
        this.generic_args = args;
    }

    set_resolved_trait(t: SymbolStr) -> void {
        this.resolved_trait = t;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class ScopeResolutionNode : ExpressionNode {
public:
    scope_name:         SymbolStr;
    member_name:        SymbolStr;
    generic_args:       TypeAnnotation*[];
    scope_generic_args: TypeAnnotation*[];

    ScopeResolutionNode(scope_name: SymbolStr, member_name: SymbolStr, span: SourceSpan)
        : ExpressionNode(NodeKind::ScopeResolution, span) {
        this.scope_name         = scope_name;
        this.member_name        = member_name;
        this.generic_args       = [];
        this.scope_generic_args = [];
    }

    set_generic_args(args: TypeAnnotation*[]) -> void {
        this.generic_args = args;
    }

    set_scope_generic_args(args: TypeAnnotation*[]) -> void {
        this.scope_generic_args = args;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


// Typeof Expression: typeof(expr)

type class TypeofExprNode : ExpressionNode {
public:
    operand: ExpressionNode*;

    TypeofExprNode(operand: ExpressionNode*, span: SourceSpan)
        : ExpressionNode(NodeKind::TypeofExpression, span) {
        this.operand = operand;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


// Delete Expression: delete expr

type class DeleteExprNode : ExpressionNode {
public:
    operand: ExpressionNode*;

    DeleteExprNode(operand: ExpressionNode*, span: SourceSpan)
        : ExpressionNode(NodeKind::DeleteExpression, span) {
        this.operand = operand;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


// Await Expression: await expr

type class AwaitExprNode : ExpressionNode {
public:
    operand: ExpressionNode*;

    AwaitExprNode(operand: ExpressionNode*, span: SourceSpan)
        : ExpressionNode(NodeKind::AwaitExpression, span) {
        this.operand = operand;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


// Yield Expression: yield expr (or bare yield)

type class YieldExprNode : ExpressionNode {
public:
    operand: ExpressionNode*;

    YieldExprNode(operand: ExpressionNode*, span: SourceSpan)
        : ExpressionNode(NodeKind::YieldExpression, span) {
        this.operand = operand;
    }

    has_operand() -> boolean { return this.operand != null; }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


// Try Expression: the postfix `?` error/absence-propagation operator
//
// `expr?` on a `Result<T, E>` yields `T` when `expr` is `Ok`, and otherwise
// early-returns `Result::Err(e)` from the enclosing function; on an
// `Option<T>` it yields `T` for `Some` and early-returns `Option::None` for
// `None`.  The parser cannot pick the desugar shape; that depends on
// whether the operand is a `Result` or an `Option`, which is type
// information, so the parser emits this node verbatim and semantic
// analysis lowers it: `resolve_try_expr` builds the equivalent
// `match` expression (with a `return` in the failure arm) and stores it
// in `desugared`.  Every post-sema consumer (codegen, drop insertion,
// move check) forwards through `desugared`, so they only ever deal with
// an ordinary `MatchExprNode`.  `desugared` is null until sema runs.
type class TryExprNode : ExpressionNode {
public:
    operand:   ExpressionNode*;
    desugared: ExpressionNode*;

    TryExprNode(operand: ExpressionNode*, span: SourceSpan)
        : ExpressionNode(NodeKind::TryExpression, span) {
        this.operand   = operand;
        this.desugared = null;
    }

    has_desugar() -> boolean { return this.desugared != null; }

    set_desugared(d: ExpressionNode*) -> void { this.desugared = d; }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}
