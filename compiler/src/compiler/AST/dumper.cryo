/// AST Dumper
///
/// Prints a formatted AST tree to stdout using tree-drawing characters and a
/// name per kind of node.  A `Walk` whose every hook prints its node's line
/// and then its children.

namespace compiler::ast::dumper;

import compiler::diag;
import compiler::diag::source_span;
import compiler::diag::source_span::{ SourceSpan };
import compiler::ast;
import compiler::ast::{
    declaration, expression, LiteralKind, node, pattern, statement, TypeAnnotation, walk
};
import compiler::resolver::{ symbol_str, intern_table };
import std::fmt;
import compiler::ast::declaration::{
    ClassDeclNode, DestructureBinding, DestructureDecl, EnumDecl,
    EnumVariant, ExternBlock, FieldDecl, FunctionDecl, DeclarationNode, GenericParamDecl,
    ImplBlock, ImportDecl, IntrinsicDecl, MethodDecl,
    ModuleDecl, StructDecl, TraitDecl, TypeAliasDecl, UnionDecl,
    VarDecl
};
import compiler::ast::expression::{
    AlignofExpr, ArrayAccessNode, ArrayExpr, AwaitExprNode, BinaryExprNode,
    CallExprNode, CastExpr, DeleteExpr, ExpressionNode, FieldInit, IdentifierNode,
    IfExpr, LambdaExprNode, LiteralExpr, MatchExpr, MemberAccessNode, NewExpr,
    ScopeResolutionNode, SizeofExpr, StaticMatchExpr, StructExpr,
    TernaryExpr, TryExpr, TupleExpr, TypeofExpr, UnaryExpr,
    YieldExpr
};
import compiler::ast::node::{ ASTNode, ProgramNode };
import compiler::ast::pattern::{
    BindingPattern, ConstantPattern, DirectiveArg, DirectiveNode, EnumPattern, LiteralPattern,
    MatchArmNode, Pattern, RangePattern, StaticMatchArmNode
};
import compiler::ast::statement::{
    AsmBlockStmt, AsmOperand, BlockStmt, DeclStmt, DoWhileStmt, ExprStmt, ForStmt, IfStmt,
    LoopStmt, MatchStmt, ReturnStmt, StaticMatchStmt, Stmt, UnsafeBlockStmt, WhileStmt
};
import compiler::ast::walk::{ Walk };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::symbol_str::{ SymbolStr };

/// Prints a tree whose every line knows whether it is its parent's last
/// child, so each hook names its children itself, with that flag, rather
/// than taking the default walk.
type struct ASTDumper {
    is_last_stack: [boolean];
    intern_table:  InternTable*;

    /// Dump the AST rooted at `root` to stdout.
    static dump(root: ProgramNode*, intern: InternTable*) -> void {
        if (root == null) {
            fmt::printf("(null)\n");
            return;
        }

        mut dumper: ASTDumper = ASTDumper { is_last_stack: [], intern_table: intern };
        dumper.walk_node(root);
    }

    // Tree drawing helpers

    /// Print the tree-drawing prefix for the current nesting level.
    print_prefix(&this) -> void {
        fmt::printf("\x1b[37m");  // Tree color (light gray)
        const depth: int = this.is_last_stack.length as int;
        for (mut i: int = 0; i < depth; i++) {
            if (i == depth - 1) {
                if (this.is_last_stack[i]) {
                    fmt::printf("`-");
                } else {
                    fmt::printf("|-");
                }
            } else {
                if (this.is_last_stack[i]) {
                    fmt::printf("  ");
                } else {
                    fmt::printf("| ");
                }
            }
        }
        fmt::printf("\x1b[0m");  // Reset
    }

    /// Print source location in `<line:N:N>` format.
    print_location(&this, span: SourceSpan) -> void {
        if (span.has_location()) {
            fmt::printf("\x1b[90m <line:%u:%u>\x1b[0m", span.start_line, span.start_col);
        }
    }

    /// Print a TypeAnnotation to stdout.
    print_type_annotation(&this, ann: TypeAnnotation*) -> void {
        if (ann == null) { fmt::printf("<unresolved>"); return; }
        match (*ann) {
            TypeAnnotation::Primitive(p) => { fmt::printf("%s", this.resolve(p.name)); }
            TypeAnnotation::Named(n) => { fmt::printf("%s", this.resolve(n.name)); }
            TypeAnnotation::Pointer(p) => {
                this.print_type_annotation(p.inner);
                fmt::printf("*");
            }
            TypeAnnotation::Reference(r) => {
                if (r.is_mutable) { fmt::printf("mut &"); }
                else { fmt::printf("&"); }
                this.print_type_annotation(r.inner);
            }
            TypeAnnotation::Array(a) => {
                // A length written as a constant expression is folded after
                // parsing; the dump shows where it stands, not its value.
                fmt::printf("[");
                this.print_type_annotation(a.element);
                if (a.size >= 0) { fmt::printf("; %lld", a.size); }
                else if (a.size_expr != null) { fmt::printf("; <expr>"); }
                fmt::printf("]");
            }
            TypeAnnotation::Function(f) => {
                fmt::printf("(");
                for (mut i: i64 = 0; i < f.parameters.length; i++) {
                    if (i > 0) { fmt::printf(", "); }
                    this.print_type_annotation(f.parameters[i]);
                }
                fmt::printf(") -> ");
                this.print_type_annotation(f.return_type);
            }
            TypeAnnotation::Tuple(t) => {
                fmt::printf("(");
                for (mut i: i64 = 0; i < t.elements.length; i++) {
                    if (i > 0) { fmt::printf(", "); }
                    this.print_type_annotation(t.elements[i]);
                }
                fmt::printf(")");
            }
            TypeAnnotation::Generic(g) => {
                this.print_type_annotation(g.base);
                fmt::printf("<");
                for (mut i: i64 = 0; i < g.args.length; i++) {
                    if (i > 0) { fmt::printf(", "); }
                    this.print_type_annotation(g.args[i]);
                }
                fmt::printf(">");
            }
            TypeAnnotation::Typeof(t) => {
                fmt::printf("typeof(...)");
            }
            TypeAnnotation::ThisType(t) => {
                fmt::printf("This");
            }
            TypeAnnotation::ImplTrait(imp) => {
                fmt::printf("implement ");
                for (mut i: i64 = 0; i < imp.bounds.length; i++) {
                    if (i > 0) { fmt::printf(" + "); }
                    this.print_type_annotation(imp.bounds[i]);
                }
            }
            TypeAnnotation::Projection(proj) => {
                this.print_type_annotation(proj.base);
                fmt::printf("::%s", this.resolve(proj.member));
            }
        }
    }

    /// Resolve a SymbolStr to its string representation.
    resolve(&this, sym: SymbolStr) -> string {
        return this.intern_table.resolve(sym);
    }

    // Child traversal

    push_level(mut &this, is_last: boolean) -> void {
        this.is_last_stack.push(is_last);
    }

    pop_level(mut &this) -> void {
        if (this.is_last_stack.length > 0) {
            this.is_last_stack.pop();
        }
    }

    /// Push indentation, dump the child by its kind, pop.
    dump_child(mut &this, node: ASTNode*, is_last: boolean) -> void {
        if (node == null) { return; }
        this.push_level(is_last);
        this.walk_node(node);
        this.pop_level();
    }

    /// A leaf pattern's line: its kind's label, then `value` and a range's
    /// `high` bound where the kind has them.
    print_pattern(mut &this, p: Pattern*, label: string, value: SymbolStr, high: SymbolStr) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;36mPattern\x1b[0m");
        this.print_location(p.span);
        fmt::printf(" %s", label);
        if (value.is_valid()) {
            fmt::printf(" '%s'", this.resolve(value));
        }
        if (high.is_valid()) {
            fmt::printf("..'%s'", this.resolve(high));
        }
        fmt::printf("\n");
    }
}

implement trait Walk for struct ASTDumper {
    // Program

    walk_program(mut &this, node: ProgramNode*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mTranslationUnitDecl\x1b[0m");
        this.print_location(node.span);
        if (node.namespace_name != "") {
            fmt::printf(" \x1b[1;37m'%s'\x1b[0m", node.namespace_name);
        }
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.statements.length; i++) {
            const is_last: boolean = (i == node.statements.length - 1);
            this.dump_child(node.statements[i], is_last);
        }
    }


    // Expressions

    walk_literal(mut &this, e: ExpressionNode*, node: LiteralExpr*) -> void {
        this.print_prefix();

        fmt::printf("\x1b[1;33m");  // Bold Yellow for literals
        match (node.literal_kind) {
            LiteralKind::Integer => { fmt::printf("IntegerLiteral"); }
            LiteralKind::Float   => { fmt::printf("FloatLiteral"); }
            LiteralKind::String  => { fmt::printf("StringLiteral"); }
            LiteralKind::Char    => { fmt::printf("CharLiteral"); }
            LiteralKind::Boolean => { fmt::printf("BooleanLiteral"); }
            LiteralKind::Null    => { fmt::printf("NullLiteral"); }
        }
        fmt::printf("\x1b[0m");

        this.print_location(e.span);
        fmt::printf(" \x1b[1;37m%s\x1b[0m", node.value);

        // Show type
        fmt::printf(" \x1b[1;31m'");
        match (node.literal_kind) {
            LiteralKind::Integer => { fmt::printf("int"); }
            LiteralKind::Float   => { fmt::printf("float"); }
            LiteralKind::String  => { fmt::printf("string"); }
            LiteralKind::Char    => { fmt::printf("char"); }
            LiteralKind::Boolean => { fmt::printf("boolean"); }
            LiteralKind::Null    => { fmt::printf("null"); }
        }
        fmt::printf("'\x1b[0m");
        fmt::printf("\n");
    }

    walk_identifier(mut &this, node: IdentifierNode*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;36mDeclRefExpr\x1b[0m");
        this.print_location(node.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.name));
        fmt::printf("\n");
    }

    walk_binary(mut &this, node: BinaryExprNode*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mBinaryOperator\x1b[0m");
        this.print_location(node.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", node.op.lexeme);
        fmt::printf("\n");

        this.dump_child(node.left as ASTNode*, false);
        this.dump_child(node.right as ASTNode*, true);
    }

    walk_unary(mut &this, e: ExpressionNode*, node: UnaryExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mUnaryOperator\x1b[0m");
        this.print_location(e.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", node.op.lexeme);
        fmt::printf("\n");

        this.dump_child(node.operand as ASTNode*, true);
    }

    walk_ternary(mut &this, e: ExpressionNode*, node: TernaryExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mTernaryExpr\x1b[0m");
        this.print_location(e.span);
        fmt::printf("\n");

        this.dump_child(node.condition as ASTNode*, false);
        this.dump_child(node.true_expr as ASTNode*, false);
        this.dump_child(node.false_expr as ASTNode*, true);
    }

    walk_if_expr(mut &this, e: ExpressionNode*, node: IfExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mIfExpr\x1b[0m");
        this.print_location(e.span);
        fmt::printf("\n");

        const has_else: boolean = (node.else_expr != null);
        this.dump_child(node.condition as ASTNode*, false);
        this.dump_child(node.then_expr as ASTNode*, !has_else);
        if (has_else) {
            this.dump_child(node.else_expr as ASTNode*, true);
        }
    }

    walk_match_expr(mut &this, e: ExpressionNode*, node: MatchExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mMatchExpr\x1b[0m");
        this.print_location(e.span);
        fmt::printf("\n");

        const arm_count: int = node.arms.length as int;
        this.dump_child(node.subject as ASTNode*, arm_count == 0);
        for (mut i: int = 0; i < arm_count; i++) {
            const is_last: boolean = (i == arm_count - 1);
            this.dump_child(node.arms[i] as ASTNode*, is_last);
        }
    }

    walk_static_match_expr(mut &this, e: ExpressionNode*, node: StaticMatchExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mStaticMatchExpr\x1b[0m on ");
        this.print_type_annotation(node.scrutinee);
        this.print_location(e.span);
        fmt::printf("\n");

        const arm_count: int = node.arms.length as int;
        for (mut i: int = 0; i < arm_count; i++) {
            const is_last: boolean = (i == arm_count - 1);
            this.dump_child(node.arms[i] as ASTNode*, is_last);
        }
    }

    walk_call(mut &this, node: CallExprNode*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mCallExpr\x1b[0m");
        this.print_location(node.span);
        if (node.generic_args.length > 0) {
            fmt::printf(" \x1b[1;36m<");
            for (mut i: i64 = 0; i < node.generic_args.length; i++) {
                if (i > 0) { fmt::printf(", "); }
                this.print_type_annotation(node.generic_args[i]);
            }
            fmt::printf(">\x1b[0m");
        }
        fmt::printf("\n");

        const arg_count: int = node.arguments.length as int;
        this.dump_child(node.callee as ASTNode*, arg_count == 0);
        for (mut i: int = 0; i < arg_count; i++) {
            const is_last: boolean = (i == arg_count - 1);
            this.dump_child(node.arguments[i] as ASTNode*, is_last);
        }
    }

    walk_new(mut &this, e: ExpressionNode*, node: NewExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mNewExpr\x1b[0m");
        this.print_location(e.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.type_name));
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.arguments.length; i++) {
            const is_last: boolean = (i == node.arguments.length - 1) && !node.has_array_size() && !node.has_struct_init();
            this.dump_child(node.arguments[i] as ASTNode*, is_last);
        }
        if (node.has_array_size()) {
            this.dump_child(node.array_size as ASTNode*, !node.has_struct_init());
        }
        if (node.has_struct_init()) {
            this.dump_child(node.struct_init as ASTNode*, true);
        }
    }

    walk_sizeof(mut &this, e: ExpressionNode*, node: SizeofExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mSizeofExpr\x1b[0m");
        this.print_location(e.span);
        fmt::printf(" ");
        this.print_type_annotation(node.type_ann);
        fmt::printf("\n");
    }

    walk_alignof(mut &this, e: ExpressionNode*, node: AlignofExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mAlignofExpr\x1b[0m");
        this.print_location(e.span);
        fmt::printf(" ");
        this.print_type_annotation(node.type_ann);
        fmt::printf("\n");
    }

    walk_cast(mut &this, e: ExpressionNode*, node: CastExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mCastExpr\x1b[0m");
        this.print_location(e.span);
        if (node.target_annotation != null) {
            fmt::printf(" \x1b[1;31m'");
            this.print_type_annotation(node.target_annotation);
            fmt::printf("'\x1b[0m");
        }
        fmt::printf("\n");

        this.dump_child(node.expression as ASTNode*, true);
    }

    walk_struct_literal(mut &this, e: ExpressionNode*, node: StructExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mStructLiteral\x1b[0m");
        this.print_location(e.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.struct_type));
        fmt::printf("\n");

        // FieldInit is a plain struct (not an ASTNode), handle inline.
        for (mut i: i64 = 0; i < node.field_inits.length; i++) {
            const is_last: boolean = (i == node.field_inits.length - 1);
            const init: FieldInit = node.field_inits[i];

            this.push_level(is_last);
            this.print_prefix();
            fmt::printf("\x1b[1;32mFieldInit\x1b[0m \x1b[1;37m'%s'\x1b[0m", this.resolve(init.field_name));
            fmt::printf("\n");
            if (init.value != null) {
                this.dump_child(init.value as ASTNode*, true);  // ExpressionNode* -> ASTNode* (upcast)
            }
            this.pop_level();
        }
    }

    walk_array_literal(mut &this, e: ExpressionNode*, node: ArrayExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mArrayLiteral\x1b[0m");
        this.print_location(e.span);
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.elements.length; i++) {
            const is_last: boolean = (i == node.elements.length - 1);
            this.dump_child(node.elements[i] as ASTNode*, is_last);
        }
    }

    walk_tuple_literal(mut &this, e: ExpressionNode*, node: TupleExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mTupleLiteral\x1b[0m");
        this.print_location(e.span);
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.elements.length; i++) {
            const is_last: boolean = (i == node.elements.length - 1);
            this.dump_child(node.elements[i] as ASTNode*, is_last);
        }
    }

    walk_lambda(mut &this, node: LambdaExprNode*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mLambdaExpr\x1b[0m");
        this.print_location(node.span);
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            const is_last: boolean = (i == node.parameters.length - 1) && (node.body == null);
            this.dump_child(node.parameters[i] as ASTNode*, is_last);
        }
        if (node.body != null) {
            this.dump_child(node.body as ASTNode*, true);
        }
    }

    walk_array_access(mut &this, node: ArrayAccessNode*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mArrayAccessExpr\x1b[0m");
        this.print_location(node.span);
        fmt::printf("\n");

        this.dump_child(node.array as ASTNode*, false);
        this.dump_child(node.index as ASTNode*, true);
    }

    walk_member_access(mut &this, node: MemberAccessNode*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mMemberAccessExpr\x1b[0m");
        this.print_location(node.span);
        fmt::printf(" \x1b[1;37m.%s\x1b[0m", this.resolve(node.member));
        fmt::printf("\n");

        this.dump_child(node.object as ASTNode*, true);
    }

    walk_scope_resolution(mut &this, node: ScopeResolutionNode*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mScopeResolutionExpr\x1b[0m");
        this.print_location(node.span);
        if (node.impl_trait != null) {
            fmt::printf(" \x1b[1;37m(");
            this.print_type_annotation(node.impl_trait);
            fmt::printf(" for)\x1b[0m");
        }
        // Print scope name with generic args if present
        if (node.scope_generic_args.length > 0) {
            fmt::printf(" \x1b[1;37m'%s<", this.resolve(node.scope_name));
            for (mut i: i64 = 0; i < node.scope_generic_args.length; i++) {
                if (i > 0) { fmt::printf(", "); }
                this.print_type_annotation(node.scope_generic_args[i]);
            }
            fmt::printf(">'::'%s'\x1b[0m", this.resolve(node.member_name));
        } else {
            fmt::printf(" \x1b[1;37m'%s'::'%s'\x1b[0m", this.resolve(node.scope_name), this.resolve(node.member_name));
        }
        fmt::printf("\n");
    }

    walk_typeof(mut &this, e: ExpressionNode*, node: TypeofExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mTypeofExpr\x1b[0m");
        this.print_location(e.span);
        fmt::printf("\n");
        this.push_level(true);
        this.dump_child(node.operand as ASTNode*, true);
        this.pop_level();
    }

    walk_delete(mut &this, e: ExpressionNode*, node: DeleteExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mDeleteExpr\x1b[0m");
        this.print_location(e.span);
        fmt::printf("\n");
        this.push_level(true);
        this.dump_child(node.operand as ASTNode*, true);
        this.pop_level();
    }

    walk_await(mut &this, node: AwaitExprNode*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mAwaitExpr\x1b[0m");
        this.print_location(node.span);
        fmt::printf("\n");
        this.push_level(true);
        this.dump_child(node.operand as ASTNode*, true);
        this.pop_level();
    }

    walk_try(mut &this, e: ExpressionNode*, node: TryExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mTryExpr\x1b[0m");
        this.print_location(e.span);
        fmt::printf("\n");
        this.push_level(true);
        this.dump_child(node.operand as ASTNode*, true);
        this.pop_level();
    }

    walk_yield(mut &this, e: ExpressionNode*, node: YieldExpr*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;32mYieldExpr\x1b[0m");
        this.print_location(e.span);
        fmt::printf("\n");
        if (node.operand != null) {
            this.push_level(true);
            this.dump_child(node.operand as ASTNode*, true);
            this.pop_level();
        }
    }


    // Statements

    walk_block(mut &this, s: Stmt*, node: BlockStmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mCompoundStmt\x1b[0m");
        this.print_location(s.span);
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.statements.length; i++) {
            const is_last: boolean = (i == node.statements.length - 1);
            this.dump_child(node.statements[i] as ASTNode*, is_last);
        }
    }

    walk_unsafe_block(mut &this, s: Stmt*, node: UnsafeBlockStmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mUnsafeBlockStmt\x1b[0m");
        this.print_location(s.span);
        fmt::printf("\n");

        if (node.block != null) {
            this.dump_child(node.block as ASTNode*, true);
        }
    }

    walk_asm_block(mut &this, s: Stmt*, node: AsmBlockStmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mAsmBlockStmt\x1b[0m arch=%s ops=%lld", node.arch, node.operands.length);
        this.print_location(s.span);
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.operands.length; i++) {
            const op: AsmOperand = node.operands[i];
            if (op.expr != null) {
                this.dump_child(op.expr as ASTNode*, i == node.operands.length - 1);
            }
        }
    }

    walk_return(mut &this, s: Stmt*, node: ReturnStmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mReturnStmt\x1b[0m");
        this.print_location(s.span);
        fmt::printf("\n");

        if (node.expression != null) {
            this.dump_child(node.expression as ASTNode*, true);
        }
    }

    walk_if(mut &this, s: Stmt*, node: IfStmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mIfStmt\x1b[0m");
        this.print_location(s.span);
        fmt::printf("\n");

        const has_else: boolean = node.else_stmt != null;
        this.dump_child(node.condition as ASTNode*, false);
        this.dump_child(node.then_stmt as ASTNode*, !has_else);
        if (has_else) {
            this.dump_child(node.else_stmt as ASTNode*, true);
        }
    }

    walk_while(mut &this, s: Stmt*, node: WhileStmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mWhileStmt\x1b[0m");
        this.print_location(s.span);
        fmt::printf("\n");

        this.dump_child(node.condition as ASTNode*, false);
        this.dump_child(node.body as ASTNode*, true);
    }

    walk_do_while(mut &this, s: Stmt*, node: DoWhileStmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mDoWhileStmt\x1b[0m");
        this.print_location(s.span);
        fmt::printf("\n");

        this.dump_child(node.body as ASTNode*, false);
        this.dump_child(node.condition as ASTNode*, true);
    }

    walk_for(mut &this, s: Stmt*, node: ForStmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mForStmt\x1b[0m");
        this.print_location(s.span);
        fmt::printf("\n");

        const has_update: boolean = (node.update != null);
        const has_body: boolean = (node.body != null);

        this.dump_child(node.init, false);
        this.dump_child(node.condition as ASTNode*, !has_update && !has_body);
        if (has_update) {
            this.dump_child(node.update as ASTNode*, !has_body);
        }
        if (has_body) {
            this.dump_child(node.body as ASTNode*, true);
        }
    }

    walk_match_stmt(mut &this, s: Stmt*, node: MatchStmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mMatchStmt\x1b[0m");
        this.print_location(s.span);
        fmt::printf("\n");

        const arm_count: int = node.arms.length as int;
        this.dump_child(node.subject as ASTNode*, arm_count == 0);
        for (mut i: int = 0; i < arm_count; i++) {
            const is_last: boolean = (i == arm_count - 1);
            this.dump_child(node.arms[i] as ASTNode*, is_last);
        }
    }

    walk_static_match_stmt(mut &this, s: Stmt*, node: StaticMatchStmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mStaticMatchStmt\x1b[0m on ");
        this.print_type_annotation(node.scrutinee);
        this.print_location(s.span);
        fmt::printf("\n");

        const arm_count: int = node.arms.length as int;
        for (mut i: int = 0; i < arm_count; i++) {
            const is_last: boolean = (i == arm_count - 1);
            this.dump_child(node.arms[i] as ASTNode*, is_last);
        }
    }

    walk_break(mut &this, s: Stmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mBreakStmt\x1b[0m");
        this.print_location(s.span);
        fmt::printf("\n");
    }

    walk_continue(mut &this, s: Stmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mContinueStmt\x1b[0m");
        this.print_location(s.span);
        fmt::printf("\n");
    }

    walk_expr_stmt(mut &this, s: Stmt*, node: ExprStmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mExprStmt\x1b[0m");
        this.print_location(s.span);
        fmt::printf("\n");

        this.dump_child(node.expression as ASTNode*, true);
    }

    walk_decl_stmt(mut &this, s: Stmt*, node: DeclStmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mDeclStmt\x1b[0m");
        this.print_location(s.span);
        fmt::printf("\n");

        this.dump_child(node.declaration as ASTNode*, true);
    }

    walk_loop(mut &this, s: Stmt*, node: LoopStmt*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mLoopStmt\x1b[0m");
        this.print_location(s.span);
        fmt::printf("\n");

        this.push_level(true);
        this.dump_child(node.body as ASTNode*, true);
        this.pop_level();
    }


    // Declarations

    walk_var(mut &this, d: DeclarationNode*, node: VarDecl*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mVarDecl\x1b[0m");
        this.print_location(d.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.name));
        const var_ann: TypeAnnotation* = node.type_annotation;
        if (var_ann != null) {
            fmt::printf(" \x1b[1;31m'");
            this.print_type_annotation(var_ann);
            fmt::printf("'\x1b[0m");
        }
        if (node.is_mutable) { fmt::printf(" mutable"); } else { fmt::printf(" const"); }
        if (node.is_global)  { fmt::printf(" global"); }
        fmt::printf("\n");

        if (node.has_initializer()) {
            this.dump_child(node.initializer as ASTNode*, true);
        }
    }

    walk_destructure(mut &this, d: DeclarationNode*, node: DestructureDecl*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mDestructureDecl\x1b[0m");
        this.print_location(d.span);
        fmt::printf(" {");
        for (mut i: i64 = 0; i < node.bindings.length; i++) {
            const b: DestructureBinding = node.bindings[i];
            if (i > 0) { fmt::printf(", "); }
            if (b.is_mutable) { fmt::printf("mut "); }
            const src: string = this.resolve(b.source_field);
            const loc: string = this.resolve(b.local_name);
            if (b.source_field.id == b.local_name.id) {
                fmt::printf("%s", src);
            } else {
                fmt::printf("%s: %s", src, loc);
            }
        }
        fmt::printf("}");
        const ann: TypeAnnotation* = node.type_annotation;
        if (ann != null) {
            fmt::printf(" \x1b[1;31m'");
            this.print_type_annotation(ann);
            fmt::printf("'\x1b[0m");
        }
        if (node.is_mutable) { fmt::printf(" mutable"); } else { fmt::printf(" const"); }
        fmt::printf("\n");

        if (node.initializer != null) {
            this.dump_child(node.initializer as ASTNode*, true);
        }
    }

    walk_function(mut &this, node_decl: DeclarationNode*, node: FunctionDecl*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mFunctionDecl\x1b[0m");
        this.print_location(node_decl.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.name));

        // Print function signature: '(param_types...) -> return_type'
        fmt::printf(" \x1b[1;31m'(");
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            if (i > 0) { fmt::printf(", "); }
            const p_decl: DeclarationNode* = node.parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            const ann: TypeAnnotation* = p.type_annotation;
            if (ann != null) {
                this.print_type_annotation(ann);
            } else {
                fmt::printf("<unresolved>");
            }
        }
        fmt::printf(") -> ");
        const ret_ann: TypeAnnotation* = node.return_type_annotation;
        if (ret_ann != null) {
            this.print_type_annotation(ret_ann);
        } else {
            fmt::printf("void");
        }
        fmt::printf("'\x1b[0m");
        fmt::printf("\n");

        // Generic params
        for (mut i: i64 = 0; i < node.generic_params.length; i++) {
            const is_last: boolean = (i == node.generic_params.length - 1)
                && (node.parameters.length == 0) && !node.has_body();
            this.dump_child(node.generic_params[i] as ASTNode*, is_last);
        }

        // Parameters
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            const is_last: boolean = (i == node.parameters.length - 1) && !node.has_body();
            this.dump_child(node.parameters[i] as ASTNode*, is_last);
        }

        // Body
        if (node.has_body()) {
            this.dump_child(node.body as ASTNode*, true);
        }
    }

    walk_method(mut &this, node_decl: DeclarationNode*, node: MethodDecl*) -> void {
        this.print_prefix();

        fmt::printf("\x1b[1;35m");
        if (node.is_constructor) {
            fmt::printf("ConstructorDecl");
        } else if (node.is_destructor) {
            fmt::printf("DestructorDecl");
        } else {
            fmt::printf("MethodDecl");
        }
        fmt::printf("\x1b[0m");
        this.print_location(node_decl.span);

        if (node.func != null) {
            fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(DeclarationNode::fn_of(node.func).name));

            // Print method signature
            const fn_decl: DeclarationNode* = node.func;
            const fn: FunctionDecl* = DeclarationNode::fn_of(fn_decl);
            fmt::printf(" \x1b[1;31m'(");
            for (mut i: i64 = 0; i < fn.parameters.length; i++) {
                if (i > 0) { fmt::printf(", "); }
                const p_decl: DeclarationNode* = fn.parameters[i];
                const p: VarDecl* = DeclarationNode::var_of(p_decl);
                const ann: TypeAnnotation* = p.type_annotation;
                if (ann != null) {
                    this.print_type_annotation(ann);
                } else {
                    fmt::printf("<unresolved>");
                }
            }
            fmt::printf(") -> ");
            const ret_ann: TypeAnnotation* = fn.return_type_annotation;
            if (ret_ann != null) {
                this.print_type_annotation(ret_ann);
            } else {
                fmt::printf("void");
            }
            fmt::printf("'\x1b[0m");
        }

        fmt::printf(" %s", node.visibility.label());
        if (node.is_static)   { fmt::printf(" static"); }
        if (node.is_virtual)  { fmt::printf(" virtual"); }
        if (node.is_override) { fmt::printf(" override"); }
        if (node.has_base_ctor()) {
            fmt::printf(" \x1b[1;36m: %s(...)\x1b[0m", this.resolve(node.base_ctor_name));
        }
        fmt::printf("\n");

        // Dump base constructor arguments
        if (node.has_base_ctor() && node.base_ctor_args.length > 0) {
            for (mut i: i64 = 0; i < node.base_ctor_args.length; i++) {
                const is_last: boolean = (i == node.base_ctor_args.length - 1)
                    && (node.func == null || (!DeclarationNode::fn_of(node.func).has_body() && DeclarationNode::fn_of(node.func).parameters.length == 0));
                this.dump_child(node.base_ctor_args[i] as ASTNode*, is_last);
            }
        }

        // Dump the inner function's parameters + body
        if (node.func != null) {
            for (mut i: i64 = 0; i < DeclarationNode::fn_of(node.func).parameters.length; i++) {
                const is_last: boolean = (i == DeclarationNode::fn_of(node.func).parameters.length - 1)
                    && !DeclarationNode::fn_of(node.func).has_body();
                this.dump_child(DeclarationNode::fn_of(node.func).parameters[i] as ASTNode*, is_last);
            }
            if (DeclarationNode::fn_of(node.func).has_body()) {
                this.dump_child(DeclarationNode::fn_of(node.func).body as ASTNode*, true);
            }
        }
    }

    walk_intrinsic(mut &this, d: DeclarationNode*, node: IntrinsicDecl*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mIntrinsicDecl\x1b[0m");
        this.print_location(d.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.name));
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            const is_last: boolean = (i == node.parameters.length - 1) && node.body == null;
            this.dump_child(node.parameters[i] as ASTNode*, is_last);
        }
        if (node.body != null) {
            this.dump_child(node.body as ASTNode*, true);
        }
    }

    walk_import(mut &this, d: DeclarationNode*, node: ImportDecl*) -> void {
        this.print_prefix();
        if (node.is_export) {
            fmt::printf("\x1b[1;35mExportDecl\x1b[0m");
        } else {
            fmt::printf("\x1b[1;35mImportDecl\x1b[0m");
        }
        this.print_location(d.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.intern_table.resolve(node.module_path));
        if (node.has_alias()) {
            fmt::printf(" as \x1b[1;37m'%s'\x1b[0m", this.intern_table.resolve(node.alias));
        }
        fmt::printf("\n");
    }

    walk_module(mut &this, d: DeclarationNode*, node: ModuleDecl*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mModuleDecl\x1b[0m");
        this.print_location(d.span);
        if (node.is_public) {
            fmt::printf(" \x1b[1;37m'public module %s'\x1b[0m", node.path);
        } else {
            fmt::printf(" \x1b[1;37m'module %s'\x1b[0m", node.path);
        }
        fmt::printf("\n");
    }

    walk_struct(mut &this, d: DeclarationNode*, node: StructDecl*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mStructDecl\x1b[0m");
        this.print_location(d.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.name));
        if (node.is_generic()) { fmt::printf(" generic"); }
        fmt::printf("\n");

        // Generic params
        for (mut i: i64 = 0; i < node.generic_params.length; i++) {
            const is_last: boolean = (i == node.generic_params.length - 1)
                && (node.fields.length == 0) && (node.methods.length == 0);
            this.dump_child(node.generic_params[i] as ASTNode*, is_last);
        }

        // Fields: each dumped through its own declaration hook
        for (mut i: i64 = 0; i < node.fields.length; i++) {
            const is_last: boolean = (i == node.fields.length - 1) && (node.methods.length == 0);
            this.dump_child(node.fields[i] as ASTNode*, is_last);
        }

        // Methods: dispatched through visitor (MethodDecl has its own visit)
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            const is_last: boolean = (i == node.methods.length - 1);
            this.dump_child(node.methods[i] as ASTNode*, is_last);
        }
    }

    walk_union(mut &this, d: DeclarationNode*, node: UnionDecl*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mUnionDecl\x1b[0m");
        this.print_location(d.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.name));
        if (node.is_generic()) { fmt::printf(" generic"); }
        fmt::printf("\n");

        // Generic params
        for (mut i: i64 = 0; i < node.generic_params.length; i++) {
            const is_last: boolean = (i == node.generic_params.length - 1)
                && (node.fields.length == 0) && (node.methods.length == 0);
            this.dump_child(node.generic_params[i] as ASTNode*, is_last);
        }

        // Fields: each dumped through its own declaration hook
        for (mut i: i64 = 0; i < node.fields.length; i++) {
            const is_last: boolean = (i == node.fields.length - 1) && (node.methods.length == 0);
            this.dump_child(node.fields[i] as ASTNode*, is_last);
        }

        // Methods: dispatched through visitor (MethodDecl has its own visit)
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            const is_last: boolean = (i == node.methods.length - 1);
            this.dump_child(node.methods[i] as ASTNode*, is_last);
        }
    }

    walk_class(mut &this, node: ClassDeclNode*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mClassDecl\x1b[0m");
        this.print_location(node.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.name));
        if (node.has_base_class()) {
            fmt::printf(" : \x1b[1;37m'%s'\x1b[0m", this.resolve(node.base_class));
        }
        if (node.is_generic()) { fmt::printf(" generic"); }
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.generic_params.length; i++) {
            const is_last: boolean = (i == node.generic_params.length - 1)
                && (node.fields.length == 0) && (node.methods.length == 0);
            this.dump_child(node.generic_params[i] as ASTNode*, is_last);
        }

        for (mut i: i64 = 0; i < node.fields.length; i++) {
            const is_last: boolean = (i == node.fields.length - 1) && (node.methods.length == 0);
            this.dump_child(node.fields[i] as ASTNode*, is_last);
        }

        for (mut i: i64 = 0; i < node.methods.length; i++) {
            const is_last: boolean = (i == node.methods.length - 1);
            this.dump_child(node.methods[i] as ASTNode*, is_last);
        }
    }

    walk_enum(mut &this, d: DeclarationNode*, node: EnumDecl*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mEnumDecl\x1b[0m");
        this.print_location(d.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.name));
        if (node.is_generic()) { fmt::printf(" generic"); }
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.generic_params.length; i++) {
            const is_last: boolean = (i == node.generic_params.length - 1)
                && (node.variants.length == 0);
            this.dump_child(node.generic_params[i] as ASTNode*, is_last);
        }

        // Variants: dispatched through the walker's declaration shape
        for (mut i: i64 = 0; i < node.variants.length; i++) {
            const is_last: boolean = (i == node.variants.length - 1);
            this.dump_child(node.variants[i] as ASTNode*, is_last);
        }
    }

    walk_enum_variant(mut &this, d: DeclarationNode*, node: EnumVariant*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mEnumVariant\x1b[0m");
        this.print_location(d.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.name));
        if (node.has_value) {
            fmt::printf(" = %d", node.explicit_value);
        }
        if (node.associated_types.length > 0) {
            fmt::printf(" (");
            for (mut i: i64 = 0; i < node.associated_types.length; i++) {
                if (i > 0) { fmt::printf(", "); }
                this.print_type_annotation(node.associated_types[i]);
            }
            fmt::printf(")");
        }
        fmt::printf("\n");
    }

    walk_trait(mut &this, d: DeclarationNode*, node: TraitDecl*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mTraitDecl\x1b[0m");
        this.print_location(d.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.name));
        if (node.is_generic()) { fmt::printf(" generic"); }
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.generic_params.length; i++) {
            const is_last: boolean = (i == node.generic_params.length - 1)
                && (node.methods.length == 0);
            this.dump_child(node.generic_params[i] as ASTNode*, is_last);
        }

        for (mut i: i64 = 0; i < node.methods.length; i++) {
            const is_last: boolean = (i == node.methods.length - 1);
            this.dump_child(node.methods[i] as ASTNode*, is_last);
        }
    }

    walk_type_alias(mut &this, d: DeclarationNode*, node: TypeAliasDecl*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mTypeAliasDecl\x1b[0m");
        this.print_location(d.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.alias_name));
        if (node.is_generic()) {
            fmt::printf(" \x1b[95mgeneric\x1b[0m");
        }
        if (node.target_annotation != null) {
            fmt::printf(" \x1b[1;31m= '");
            this.print_type_annotation(node.target_annotation);
            fmt::printf("'\x1b[0m");
        }
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.generic_params.length; i++) {
            const is_last: boolean = (i == node.generic_params.length - 1)
                && (node.target_annotation == null);
            this.dump_child(node.generic_params[i] as ASTNode*, is_last);
        }
    }

    walk_impl(mut &this, d: DeclarationNode*, node: ImplBlock*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mImplementBlock\x1b[0m");
        this.print_location(d.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.target_type));
        if (node.is_trait_impl()) {
            fmt::printf(" trait=");
            this.print_type_annotation(node.trait_annotation);
        }
        if (node.is_generic()) { fmt::printf(" \x1b[1;33mgeneric\x1b[0m"); }
        if (node.where_bounds.length > 0) {
            fmt::printf(" where=%d bounds", node.where_bounds.length as int);
        }
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.generic_params.length; i++) {
            const is_last: boolean = (i == node.generic_params.length - 1)
                && (node.methods.length == 0);
            this.dump_child(node.generic_params[i] as ASTNode*, is_last);
        }

        for (mut i: i64 = 0; i < node.methods.length; i++) {
            const is_last: boolean = (i == node.methods.length - 1);
            this.dump_child(node.methods[i] as ASTNode*, is_last);
        }
    }

    walk_extern_block(mut &this, d: DeclarationNode*, node: ExternBlock*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mExternBlock\x1b[0m");
        this.print_location(d.span);
        if (node.linkage_type != "") {
            fmt::printf(" \x1b[1;37m'%s'\x1b[0m", node.linkage_type);
        }
        if (node.is_c_import()) {
            const alias: string = this.resolve(node.namespace_alias);
            fmt::printf(" \x1b[1;36mCImport '%s'\x1b[0m", alias);
            if (node.include_paths.length > 0) {
                fmt::printf(" (%d includes)", node.include_paths.length);
            }
        }
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.functions.length; i++) {
            const is_last: boolean = (i == node.functions.length - 1);
            this.dump_child(node.functions[i] as ASTNode*, is_last);
        }
    }

    walk_field(mut &this, d: DeclarationNode*, node: FieldDecl*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;35mFieldDecl\x1b[0m");
        this.print_location(d.span);
        const resolved_name: string = this.resolve(node.name);

        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", resolved_name);
        if (node.has_type_annotation()) {
            fmt::printf(" \x1b[1;31m'");
            this.print_type_annotation(node.type_annotation);
            fmt::printf("'\x1b[0m");
        }
        fmt::printf(" %s", node.visibility.label());
        fmt::printf("\n");

        if (node.has_default_value()) {
            this.dump_child(node.default_value as ASTNode*, true);
        }
    }

    walk_generic_param(mut &this, d: DeclarationNode*, node: GenericParamDecl*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[95mGenericParam\x1b[0m");
        this.print_location(d.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", this.resolve(node.name));
        if (node.default_annotation != null) {
            fmt::printf(" = ");
            this.print_type_annotation(node.default_annotation);
        }
        fmt::printf("\n");
    }


    // Pattern, Match Arm, Directive

    walk_match_arm(mut &this, node: MatchArmNode*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mMatchArm\x1b[0m");
        this.print_location(node.span);
        fmt::printf("\n");

        for (mut i: i64 = 0; i < node.patterns.length; i++) {
            const is_last: boolean = (i == node.patterns.length - 1) && (node.body == null);
            this.dump_child(node.patterns[i] as ASTNode*, is_last);
        }
        if (node.body != null) {
            this.dump_child(node.body as ASTNode*, true);
        }
    }

    walk_static_match_arm(mut &this, node: StaticMatchArmNode*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;34mStaticMatchArm\x1b[0m ");
        if (node.type_patterns.length == 0) {
            fmt::printf("_");
        } else {
            for (mut i: i64 = 0; i < node.type_patterns.length; i++) {
                if (i > 0) { fmt::printf(" | "); }
                this.print_type_annotation(node.type_patterns[i]);
            }
        }
        this.print_location(node.span);
        fmt::printf("\n");

        if (node.body != null) {
            this.dump_child(node.body as ASTNode*, true);
        }
    }

    walk_wildcard_pattern(mut &this, p: Pattern*) -> void {
        this.print_pattern(p, "wildcard", SymbolStr::empty(), SymbolStr::empty());
    }

    walk_literal_pattern(mut &this, p: Pattern*, n: LiteralPattern*) -> void {
        this.print_pattern(p, "literal", n.value, SymbolStr::empty());
    }

    walk_range_pattern(mut &this, p: Pattern*, n: RangePattern*) -> void {
        this.print_pattern(p, "range", n.low, n.high);
    }

    walk_binding_pattern(mut &this, p: Pattern*, n: BindingPattern*) -> void {
        this.print_pattern(p, "identifier", SymbolStr::empty(), SymbolStr::empty());
    }

    walk_constant_pattern(mut &this, p: Pattern*, n: ConstantPattern*) -> void {
        this.print_pattern(p, "identifier", n.name, SymbolStr::empty());
    }

    walk_enum_pattern(mut &this, p: Pattern*, n: EnumPattern*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[1;36mEnumPattern\x1b[0m");
        this.print_location(p.span);
        if (n.enum_name.is_valid()) {
            fmt::printf(" \x1b[1;37m'%s'::'%s'\x1b[0m", this.resolve(n.enum_name), this.resolve(n.variant_name));
        }
        fmt::printf("\n");
    }

    walk_directive(mut &this, node: DirectiveNode*) -> void {
        this.print_prefix();
        fmt::printf("\x1b[95mDirective\x1b[0m");
        this.print_location(node.span);
        fmt::printf(" \x1b[1;37m'%s'\x1b[0m", node.directive_kind.as_string());
        const argc: i64 = node.args.length;
        if (argc > 0) {
            fmt::printf(" (");
            for (mut i: i64 = 0; i < argc; i++) {
                if (i > 0) { fmt::printf(", "); }
                const a: DirectiveArg = node.args[i];
                fmt::printf("%s", a.to_text());
            }
            fmt::printf(")");
        }
        fmt::printf("\n");
    }
}
