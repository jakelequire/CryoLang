/// AST Module
///
/// Abstract Syntax Tree node classes for the Cryo compiler.
/// Uses class inheritance with the visitor pattern: each node type extends
/// `ASTNode` and dispatches through `accept(visitor)`.

namespace Compiler::AST;

public module Node;
public module Expression;
public module Statement;
public module Declaration;
public module Pattern;
public module Visitor;
public module Cloner;
public module Substituter;
public module Specializer;
public module Dumper;
public module NodeLocator;

import Compiler::Diag;
import Compiler::Diag::SourceSpan;
import Compiler::Types::TypeRef;
import Compiler::Resolver::SymbolStr;

/// Discriminator for all AST node types.
type enum NodeKind {
    // Base categories
    Expression; Statement; Declaration;

    // Expressions (25)
    Literal; Identifier; BinaryExpression; UnaryExpression; TernaryExpression;
    IfExpression; MatchExpression; StaticMatchExpression; CallExpression; NewExpression;
    SizeofExpression; AlignofExpression; CastExpression;
    StructLiteral; ArrayLiteral; TupleLiteral; LambdaExpression;
    ArrayAccess; MemberAccess; ScopeResolution;
    TypeofExpression; DeleteExpression; AwaitExpression;
    YieldExpression; AsyncExpression; TryExpression;

    // Statements (15)
    BlockStatement; UnsafeBlockStatement; ReturnStatement;
    IfStatement; WhileStatement; DoWhileStatement; ForStatement;
    MatchStatement; StaticMatchStatement; SwitchStatement; CaseStatement;
    BreakStatement; ContinueStatement; ExpressionStatement; DeclarationStatement;
    LoopStatement;

    // Declarations (18)
    VariableDeclaration; DestructureDeclaration; FunctionDeclaration; MethodDeclaration;
    IntrinsicDeclaration; IntrinsicConstDeclaration;
    ImportDeclaration; ModuleDeclaration;
    StructDeclaration; ClassDeclaration; EnumDeclaration; EnumVariant;
    TraitDeclaration; TypeAliasDeclaration; ImplementationBlock; ExternBlock;
    FieldDeclaration; GenericParamDeclaration;

    // Other
    Program; MatchArm; StaticMatchArm; Pattern; EnumPattern; Directive; Unknown;
}

implement enum NodeKind {
    to_string(&this) -> string {
        return match (this) {
            NodeKind::Expression                => { "Expression" }
            NodeKind::Statement                 => { "Statement" }
            NodeKind::Declaration               => { "Declaration" }
            NodeKind::Literal                   => { "Literal" }
            NodeKind::Identifier                => { "Identifier" }
            NodeKind::BinaryExpression          => { "BinaryExpression" }
            NodeKind::UnaryExpression           => { "UnaryExpression" }
            NodeKind::TernaryExpression         => { "TernaryExpression" }
            NodeKind::IfExpression              => { "IfExpression" }
            NodeKind::MatchExpression           => { "MatchExpression" }
            NodeKind::StaticMatchExpression     => { "StaticMatchExpression" }
            NodeKind::CallExpression            => { "CallExpression" }
            NodeKind::NewExpression             => { "NewExpression" }
            NodeKind::SizeofExpression          => { "SizeofExpression" }
            NodeKind::AlignofExpression         => { "AlignofExpression" }
            NodeKind::CastExpression            => { "CastExpression" }
            NodeKind::StructLiteral             => { "StructLiteral" }
            NodeKind::ArrayLiteral              => { "ArrayLiteral" }
            NodeKind::TupleLiteral              => { "TupleLiteral" }
            NodeKind::LambdaExpression          => { "LambdaExpression" }
            NodeKind::ArrayAccess               => { "ArrayAccess" }
            NodeKind::MemberAccess              => { "MemberAccess" }
            NodeKind::ScopeResolution           => { "ScopeResolution" }
            NodeKind::TypeofExpression          => { "TypeofExpression" }
            NodeKind::DeleteExpression          => { "DeleteExpression" }
            NodeKind::AwaitExpression           => { "AwaitExpression" }
            NodeKind::YieldExpression           => { "YieldExpression" }
            NodeKind::AsyncExpression           => { "AsyncExpression" }
            NodeKind::TryExpression             => { "TryExpression" }
            NodeKind::BlockStatement            => { "BlockStatement" }
            NodeKind::UnsafeBlockStatement      => { "UnsafeBlockStatement" }
            NodeKind::ReturnStatement           => { "ReturnStatement" }
            NodeKind::IfStatement               => { "IfStatement" }
            NodeKind::WhileStatement            => { "WhileStatement" }
            NodeKind::DoWhileStatement          => { "DoWhileStatement" }
            NodeKind::ForStatement              => { "ForStatement" }
            NodeKind::MatchStatement            => { "MatchStatement" }
            NodeKind::StaticMatchStatement      => { "StaticMatchStatement" }
            NodeKind::SwitchStatement           => { "SwitchStatement" }
            NodeKind::CaseStatement             => { "CaseStatement" }
            NodeKind::BreakStatement            => { "BreakStatement" }
            NodeKind::ContinueStatement         => { "ContinueStatement" }
            NodeKind::ExpressionStatement       => { "ExpressionStatement" }
            NodeKind::DeclarationStatement      => { "DeclarationStatement" }
            NodeKind::LoopStatement             => { "LoopStatement" }
            NodeKind::VariableDeclaration       => { "VariableDeclaration" }
            NodeKind::DestructureDeclaration    => { "DestructureDeclaration" }
            NodeKind::FunctionDeclaration       => { "FunctionDeclaration" }
            NodeKind::MethodDeclaration         => { "MethodDeclaration" }
            NodeKind::IntrinsicDeclaration      => { "IntrinsicDeclaration" }
            NodeKind::IntrinsicConstDeclaration => { "IntrinsicConstDeclaration" }
            NodeKind::ImportDeclaration         => { "ImportDeclaration" }
            NodeKind::ModuleDeclaration         => { "ModuleDeclaration" }
            NodeKind::StructDeclaration         => { "StructDeclaration" }
            NodeKind::ClassDeclaration          => { "ClassDeclaration" }
            NodeKind::EnumDeclaration           => { "EnumDeclaration" }
            NodeKind::EnumVariant               => { "EnumVariant" }
            NodeKind::TraitDeclaration          => { "TraitDeclaration" }
            NodeKind::TypeAliasDeclaration      => { "TypeAliasDeclaration" }
            NodeKind::ImplementationBlock       => { "ImplementationBlock" }
            NodeKind::ExternBlock               => { "ExternBlock" }
            NodeKind::FieldDeclaration          => { "FieldDeclaration" }
            NodeKind::GenericParamDeclaration   => { "GenericParamDeclaration" }
            NodeKind::Program                   => { "Program" }
            NodeKind::MatchArm                  => { "MatchArm" }
            NodeKind::StaticMatchArm            => { "StaticMatchArm" }
            NodeKind::Pattern                   => { "Pattern" }
            NodeKind::EnumPattern               => { "EnumPattern" }
            NodeKind::Directive                 => { "Directive" }
            NodeKind::Unknown                   => { "Unknown" }
        };
    }
}

type enum Visibility {
    Public;
    Private;
    Protected;
}

implement enum Visibility {
    label(&this) -> string {
        return match (this) {
            Visibility::Public    => { "public" }
            Visibility::Private   => { "private" }
            Visibility::Protected => { "protected" }
        };
    }
}

type enum ImportStyle {
    Wildcard;
    Specific;
}

type enum LiteralKind {
    Integer;
    Float;
    String;
    Char;
    Boolean;
    Null;
}

implement enum LiteralKind {
    to_string(&this) -> string {
        return match (this) {
            LiteralKind::Integer => { "Integer" }
            LiteralKind::Float   => { "Float" }
            LiteralKind::String  => { "String" }
            LiteralKind::Char    => { "Char" }
            LiteralKind::Boolean => { "Boolean" }
            LiteralKind::Null    => { "Null" }
        };
    }
}

type enum PatternKind {
    Literal;
    Identifier;
    Wildcard;
    Enum;
    Range;
}


// TypeAnnotation: Unresolved type from the parser

type enum TypeAnnotation {
    Primitive(PrimitiveAnnotation*);
    Named(NamedAnnotation*);
    Pointer(PointerAnnotation*);
    Reference(ReferenceAnnotation*);
    Array(ArrayAnnotation*);
    Function(FunctionAnnotation*);
    Tuple(TupleAnnotation*);
    Optional(OptionalAnnotation*);
    Generic(GenericAnnotation*);
    /// `typeof(expr)` in type position (decltype-style): resolves to the
    /// static type of the operand expression. See TypeofAnnotation.
    Typeof(TypeofAnnotation*);
    /// `This` placeholder inside trait declarations and impl blocks.
    /// The parser captures it as a tagged sentinel; sema later resolves it
    /// to the implementing type (Phase B.1).
    ThisType(ThisTypeAnnotation*);
    /// `implement Trait` in return / binding position. An OPAQUE ALIAS for a
    /// single concrete type the compiler infers (from the function body's
    /// `return` exprs, or from the initializer of a local binding) and
    /// caches into `ImplTraitAnnotation.resolved`. Cryo is fully
    /// monomorphizing with no type erasure, so this is not `dyn`/existential
    /// — it merely lets the name be elided. See ImplTraitAnnotation.
    ImplTrait(ImplTraitAnnotation*);
}


// TypeAnnotation deep-copy

implement enum TypeAnnotation {
    /// Deep-copy this type annotation tree, allocating fresh nodes.
    clone(&this) -> TypeAnnotation* {
        const result: TypeAnnotation* = malloc(sizeof(TypeAnnotation)) as TypeAnnotation*;

        match (this) {
            TypeAnnotation::Primitive(prim) => {
                const p: PrimitiveAnnotation* = malloc(sizeof(PrimitiveAnnotation)) as PrimitiveAnnotation*;
                *p = PrimitiveAnnotation { name: prim.name, span: prim.span };
                *result = TypeAnnotation::Primitive(p);
            }
            TypeAnnotation::Named(named) => {
                const n: NamedAnnotation* = malloc(sizeof(NamedAnnotation)) as NamedAnnotation*;
                *n = NamedAnnotation {
                    name: named.name,
                    span: named.span,
                    pre_resolved: named.pre_resolved,
                };
                *result = TypeAnnotation::Named(n);
            }
            TypeAnnotation::Pointer(ptr) => {
                const p: PointerAnnotation* = malloc(sizeof(PointerAnnotation)) as PointerAnnotation*;
                *p = PointerAnnotation {
                    inner: TypeAnnotation::clone_ptr(ptr.inner),
                    span:  ptr.span,
                };
                *result = TypeAnnotation::Pointer(p);
            }
            TypeAnnotation::Reference(ref) => {
                const r: ReferenceAnnotation* = malloc(sizeof(ReferenceAnnotation)) as ReferenceAnnotation*;
                *r = ReferenceAnnotation {
                    inner:      TypeAnnotation::clone_ptr(ref.inner),
                    is_mutable: ref.is_mutable,
                    span:       ref.span,
                };
                *result = TypeAnnotation::Reference(r);
            }
            TypeAnnotation::Array(arr) => {
                const a: ArrayAnnotation* = malloc(sizeof(ArrayAnnotation)) as ArrayAnnotation*;
                *a = ArrayAnnotation {
                    element: TypeAnnotation::clone_ptr(arr.element),
                    size:    arr.size,
                    span:    arr.span,
                };
                *result = TypeAnnotation::Array(a);
            }
            TypeAnnotation::Function(func) => {
                mut new_params: TypeAnnotation*[] = [];
                for (mut i: i64 = 0; i < func.parameters.length; i++) {
                    new_params.push(TypeAnnotation::clone_ptr(func.parameters[i]));
                }
                const f: FunctionAnnotation* = malloc(sizeof(FunctionAnnotation)) as FunctionAnnotation*;
                *f = FunctionAnnotation {
                    parameters:  new_params,
                    return_type: TypeAnnotation::clone_ptr(func.return_type),
                    span:        func.span,
                };
                *result = TypeAnnotation::Function(f);
            }
            TypeAnnotation::Tuple(tup) => {
                mut new_elems: TypeAnnotation*[] = [];
                for (mut i: i64 = 0; i < tup.elements.length; i++) {
                    new_elems.push(TypeAnnotation::clone_ptr(tup.elements[i]));
                }
                const t: TupleAnnotation* = malloc(sizeof(TupleAnnotation)) as TupleAnnotation*;
                *t = TupleAnnotation {
                    elements: new_elems,
                    span:     tup.span,
                };
                *result = TypeAnnotation::Tuple(t);
            }
            TypeAnnotation::Optional(opt) => {
                const o: OptionalAnnotation* = malloc(sizeof(OptionalAnnotation)) as OptionalAnnotation*;
                *o = OptionalAnnotation {
                    inner: TypeAnnotation::clone_ptr(opt.inner),
                    span:  opt.span,
                };
                *result = TypeAnnotation::Optional(o);
            }
            TypeAnnotation::Generic(gen) => {
                mut new_args: TypeAnnotation*[] = [];
                for (mut i: i64 = 0; i < gen.args.length; i++) {
                    new_args.push(TypeAnnotation::clone_ptr(gen.args[i]));
                }
                const g: GenericAnnotation* = malloc(sizeof(GenericAnnotation)) as GenericAnnotation*;
                *g = GenericAnnotation {
                    base: TypeAnnotation::clone_ptr(gen.base),
                    args: new_args,
                    span: gen.span,
                };
                *result = TypeAnnotation::Generic(g);
            }
            TypeAnnotation::Typeof(to) => {
                const t: TypeofAnnotation* = malloc(sizeof(TypeofAnnotation)) as TypeofAnnotation*;
                // Shallow-share the operand expression: cloning expression
                // nodes isn't available from the AST root module, and a
                // non-generic `typeof` operand resolves to a single concrete
                // type, so sharing is safe.  Carry the cached `resolved` so a
                // clone taken after sema keeps the already-derived type.
                *t = TypeofAnnotation {
                    operand:  to.operand,
                    resolved: to.resolved,
                    span:     to.span,
                };
                *result = TypeAnnotation::Typeof(t);
            }
            TypeAnnotation::ThisType(t) => {
                const tt: ThisTypeAnnotation* = malloc(sizeof(ThisTypeAnnotation)) as ThisTypeAnnotation*;
                *tt = ThisTypeAnnotation { span: t.span };
                *result = TypeAnnotation::ThisType(tt);
            }
            TypeAnnotation::ImplTrait(imp) => {
                mut new_bounds: TypeAnnotation*[] = [];
                for (mut i: i64 = 0; i < imp.bounds.length; i++) {
                    new_bounds.push(TypeAnnotation::clone_ptr(imp.bounds[i]));
                }
                const it: ImplTraitAnnotation* = malloc(sizeof(ImplTraitAnnotation)) as ImplTraitAnnotation*;
                // Deliberately DROP the cached `resolved`: a clone is taken
                // when specializing a generic method, and the original may
                // have been inferred in the template context (e.g.
                // `BufIter<T>`).  The body travels with the clone and is
                // substituted to concrete types, so the spec re-infers a
                // fresh, correctly-substituted `resolved` (`BufIter<i32>`).
                // Carrying the template's value here would poison every
                // specialization with the unsubstituted type.
                *it = ImplTraitAnnotation {
                    bounds:   new_bounds,
                    resolved: TypeRef::invalid(),
                    span:     imp.span,
                };
                *result = TypeAnnotation::ImplTrait(it);
            }
        }

        return result;
    }

    /// Clone a possibly-null TypeAnnotation pointer.
    static clone_ptr(ann: TypeAnnotation*) -> TypeAnnotation* {
        if (ann == null) { return null; }
        return (*ann).clone();
    }
}


type struct PrimitiveAnnotation {
    name: SymbolStr;
    span: SourceSpan;
}

type struct NamedAnnotation {
    name:         SymbolStr;
    span:         SourceSpan;
    /// Pre-resolved TypeRef set by the AST substituter when this Named
    /// annotation was produced by replacing a generic parameter with a
    /// concrete type argument. The TypeResolver short-circuits to this
    /// value instead of re-deriving it from `name`, which avoids round-
    /// tripping a long mangled spec name (e.g.
    /// `std::collections::array::5Array$LN$L...$G$G`) through the scope
    /// chain. Default `TypeRef::invalid()` for parser-produced annotations.
    pre_resolved: TypeRef;
}

type struct PointerAnnotation {
    inner: TypeAnnotation*;
    span:  SourceSpan;
}

type struct ReferenceAnnotation {
    inner:      TypeAnnotation*;
    is_mutable: boolean;
    span:       SourceSpan;
}

type struct ArrayAnnotation {
    element: TypeAnnotation*;
    size:    i64;
    span:    SourceSpan;

    // Sentinel `size` values for the two `size < 0` array shapes; the
    // resolver copies `size` verbatim into `ArrayType`, whose matching
    // `heap_dynamic_size()` / `fixed_pending_size()` are authoritative.
    //   heap-dynamic `T[]`  : owns a heap buffer (droppable)
    //   fixed-pending `T[N]`: named-const / computed N, resolved later
    static heap_dynamic_size()  -> i64 { return -1; }
    static fixed_pending_size() -> i64 { return -2; }
}

type struct FunctionAnnotation {
    parameters:  TypeAnnotation*[];
    return_type: TypeAnnotation*;
    span:        SourceSpan;
}

type struct TupleAnnotation {
    elements: TypeAnnotation*[];
    span:     SourceSpan;
}

type struct OptionalAnnotation {
    inner: TypeAnnotation*;
    span:  SourceSpan;
}

type struct GenericAnnotation {
    base: TypeAnnotation*;
    args: TypeAnnotation*[];
    span: SourceSpan;
}

/// `typeof(expr)` used in type position (decltype-style); resolves to the
/// static type of `operand`.
type struct TypeofAnnotation {
    /// The operand expression, stored opaquely as `void*` (really an
    /// `ExpressionNode*`).  The AST root module can't import
    /// `Compiler::AST::Expression` without a module cycle, so the pointer is
    /// kept untyped here; the parser stashes it and sema casts it back to
    /// `ExpressionNode*` to resolve the operand's type.
    operand:  void*;
    /// The operand's static type, cached by sema (which alone can resolve an
    /// expression's type, and only once the operand is in scope).  The
    /// TypeResolver returns this directly - it has no expression resolver of
    /// its own.  `TypeRef::invalid()` until sema fills it.
    resolved: TypeRef;
    span:     SourceSpan;
}

/// `This` placeholder. Carries no name; the implementing type is supplied
/// later by sema using the enclosing trait/impl context.
type struct ThisTypeAnnotation {
    span: SourceSpan;
}

/// `implement Trait + Trait2 + ...` in return / binding position. Each bound
/// is itself a type annotation (typically `Generic(Named("Iterator"), [args])`
/// or a bare `Named`), so the existing substituter/resolver machinery
/// recurses into the bounds for free. `resolved` caches the single concrete
/// type the opaque alias stands for — inferred from the function body's
/// `return` exprs (return position) or from the initializer (local binding).
/// `TypeRef::invalid()` until inference fills it; the TypeResolver returns
/// it directly, exactly like `TypeofAnnotation.resolved`.
type struct ImplTraitAnnotation {
    bounds:   TypeAnnotation*[];
    resolved: TypeRef;
    span:     SourceSpan;
}

/// A generic type parameter declaration (e.g., `T: Default`).
type struct GenericParam {
    name:        SymbolStr;
    constraints: SymbolStr[];
    span:        SourceSpan;
}

/// A reference to a trait inside a where clause. `path` holds the segments
/// of the qualified name (e.g., `["io", "Write"]` for `where W: io::Write`,
/// or `["Eq"]` for the unqualified form). `type_args` holds optional
/// generic-argument annotations (e.g., `[&JsonValue]` for
/// `where T: TryFrom<&JsonValue>`); empty for non-generic trait references.
type struct TraitRef {
    path:      SymbolStr[];
    type_args: TypeAnnotation*[];
    span:      SourceSpan;

    /// Deep copy into independently-owned arrays (SymbolStr and the
    /// TypeAnnotation* handles are Copy), so a clone can be stored in a
    /// second owner without aliasing this one's buffers.
    clone(&this) -> TraitRef {
        mut path_c: SymbolStr[] = [];
        mut args_c: TypeAnnotation*[] = [];
        for (mut i: i64 = 0; i < this.path.length; i++)      { path_c.push(this.path[i]); }
        for (mut i: i64 = 0; i < this.type_args.length; i++) { args_c.push(this.type_args[i]); }
        return TraitRef { path: path_c, type_args: args_c, span: this.span };
    }
}

/// A trait bound from a where clause (e.g., `where T: Default`,
/// `where T: Hash + Eq`, `where W: io::Write`).
///
/// `trait_refs` holds one entry per `+`-separated trait. A bare
/// `where T: Trait` is a single-element array; `where T: A + B` has two;
/// each entry carries its own (possibly qualified) path.
type struct TraitBound {
    type_parameter: SymbolStr;
    trait_refs:     TraitRef[];
    span:           SourceSpan;

    /// Deep copy; clones each (owning) TraitRef into an independent buffer so
    /// the result can be stored in a second owner without a double-free.
    clone(&this) -> TraitBound {
        mut refs_c: TraitRef[] = [];
        for (mut i: i64 = 0; i < this.trait_refs.length; i++) {
            refs_c.push(this.trait_refs[i].clone());
        }
        return TraitBound {
            type_parameter: this.type_parameter,
            trait_refs:     refs_c,
            span:           this.span,
        };
    }
}

/// A pattern element inside an enum pattern (e.g., binding, wildcard, literal).
/// `Sub` carries a nested sub-pattern for one-or-more-levels-deep
/// destructuring (`Some(Some(n))`, `Branch(Leaf(x), r)`).
type enum PatternElement {
    Binding(PatternBinding*);
    Wildcard(PatternWildcard*);
    LiteralInt(PatternLiteralInt*);
    LiteralFloat(PatternLiteralFloat*);
    LiteralBool(PatternLiteralBool*);
    LiteralString(PatternLiteralString*);
    Sub(PatternSub*);
}

type struct PatternBinding {
    name: SymbolStr;
    span: SourceSpan;
}

type struct PatternWildcard {
    span: SourceSpan;
}

type struct PatternLiteralInt {
    value: i64;
    span:  SourceSpan;
}

type struct PatternLiteralFloat {
    value: f64;
    span:  SourceSpan;
}

type struct PatternLiteralBool {
    value: boolean;
    span:  SourceSpan;
}

type struct PatternLiteralString {
    value: string;
    span:  SourceSpan;
}

/// A nested sub-pattern element (`Some(Some(n))`, `Branch(Leaf(x), _)`).
/// The pattern is stored opaquely as `void*` (really a
/// `Compiler::AST::Pattern::PatternNode*`): the AST root module can't import
/// the Pattern module without a cycle, so consumers (parser/sema/codegen)
/// cast it back. Mirrors `TypeofAnnotation.operand`.
type struct PatternSub {
    pattern: void*;
    span:    SourceSpan;
}

/// Base trait info for trait inheritance (e.g., `trait Foo : Bar<T>`).
type struct BaseTraitInfo {
    name:            SymbolStr;
    type_parameters: TypeAnnotation*[];
}
