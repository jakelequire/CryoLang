/// AST Cloner
///
/// Deep-clones AST subtrees.  `dispatch_node` hands a node to the `visit_*`
/// method for its kind, which allocates a new node, copies scalar fields,
/// and recursively clones children.
/// Resolved type fields are left as TypeRef::invalid() on clones (the constructor
/// default); the type substituter fills them during generic specialization.
///
/// Used by the monomorphization pipeline: the ASTSpecializer clones a generic
/// declaration, then the ASTTypeSubstituter rewrites the clone's type annotations.

namespace compiler::ast::cloner;

import compiler::diag;
import compiler::ast;
import compiler::ast::{
    declaration, expression, node, NodeKind, pattern, PatternBinding, PatternElement,
    PatternKind, PatternSub, statement, TypeAnnotation
};
import compiler::resolver::symbol_str;
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::types::type_ref;
import compiler::types::type_ref::{ TypeRef };
import compiler::ast::declaration::{
    ClassDeclNode, DeclarationNode, DestructureBinding, DestructureDeclNode, EnumDeclNode,
    EnumVariantNode, ExternBlockNode, FieldDeclNode, FunctionDeclNode, GenericParamNode,
    ImplBlockNode, ImportDeclNode, IntrinsicConstDeclNode, IntrinsicDeclNode, MethodNode,
    ModuleDeclNode, StructDeclNode, TraitDeclNode, TypeAliasDeclNode, UnionDeclNode,
    VarDeclNode
};
import compiler::ast::expression::{
    AlignofExprNode, ArrayAccessNode, ArrayLiteralNode, AwaitExprNode, BinaryExprNode,
    CallExprNode, CastExprNode, DeleteExprNode, ExpressionNode, FieldInit, IdentifierNode,
    IfExprNode, LambdaExprNode, LiteralNode, MatchExprNode, MemberAccessNode, NewExprNode,
    ScopeResolutionNode, SizeofExprNode, StaticMatchExprNode, StructLiteralNode,
    TernaryExprNode, TryExprNode, TupleLiteralNode, TypeofExprNode, UnaryExprNode,
    YieldExprNode
};
import compiler::ast::node::{ ASTNode, ProgramNode };
import compiler::ast::pattern::{
    DirectiveArg, DirectiveArgKind, DirectiveNode, EnumPatternNode, MatchArmNode,
    PatternNode, StaticMatchArmNode
};
import compiler::ast::statement::{
    AsmBlockStmtNode, AsmOperand, AsmPiece, BlockStmtNode, BreakStmtNode, ContinueStmtNode,
    DeclStmtNode, DoWhileStmtNode, ExprStmtNode, ForStmtNode, IfStmtNode, LoopStmtNode,
    MatchStmtNode, ReturnStmtNode, StatementNode, StaticMatchStmtNode, UnsafeBlockStmtNode,
    WhileStmtNode
};

type struct ASTCloner {
    /// One-shot specialization name applied at the first decl-level visit
    /// (StructDeclNode / ClassDeclNode / EnumDeclNode / FunctionDeclNode).
    /// `consume_spec_name()` reads and clears it so child decls keep their
    /// own names.
    spec_name: SymbolStr;

    /// When true, the next decl-level visit drops `generic_params`, producing
    /// a concrete specialization. Read-and-clear via `consume_skip_generics()`.
    skip_generics: boolean;

    /// When true, every cloned expression carries its template's type, for
    /// the substitution the copy is made under to rewrite.  Off for a clone
    /// the type check walks again, which types what is untyped and passes
    /// over what is typed.
    carries_types: boolean;

    static new() -> ASTCloner {
        return ASTCloner {
            spec_name:     SymbolStr::empty(),
            skip_generics: false,
            carries_types: false,
        };
    }

    /// A cloner for a copy monomorphization makes: its expressions carry
    /// their template's types.
    static for_monomorphization() -> ASTCloner {
        mut c: ASTCloner = ASTCloner::new();
        c.carries_types  = true;
        return c;
    }

    /// Create a cloner configured for specialization. The first matching
    /// decl-level visit will apply `name` and drop generic_params.
    static for_specialization(name: SymbolStr) -> ASTCloner {
        mut c: ASTCloner   = ASTCloner::for_monomorphization();
        c.spec_name        = name;
        c.skip_generics    = true;
        return c;
    }

    /// Read and clear the one-shot specialization name, falling back to
    /// `original` when not specializing.
    consume_spec_name(mut &this, original: SymbolStr) -> SymbolStr {
        if (this.spec_name.is_valid()) {
            const name: SymbolStr = this.spec_name;
            this.spec_name = SymbolStr::empty();
            return name;
        }
        return original;
    }

    /// Read and clear the skip_generics flag.
    consume_skip_generics(mut &this) -> boolean {
        const skip: boolean = this.skip_generics;
        this.skip_generics = false;
        return skip;
    }


    // Top-level entry points

    /// The copy of `n`, made by the method for its kind; null for null.
    dispatch_node(mut &this, n: ASTNode*) -> ASTNode* {
        if (n == null) { return null; }
        match (n.kind) {
            NodeKind::Program                   => { return this.visit_program(n as ProgramNode*); }

            NodeKind::Literal                   => { return this.visit_literal(n as LiteralNode*); }
            NodeKind::Identifier                => { return this.visit_identifier(n as IdentifierNode*); }
            NodeKind::BinaryExpression          => { return this.visit_binary(n as BinaryExprNode*); }
            NodeKind::UnaryExpression           => { return this.visit_unary(n as UnaryExprNode*); }
            NodeKind::TernaryExpression         => { return this.visit_ternary(n as TernaryExprNode*); }
            NodeKind::IfExpression              => { return this.visit_if_expr(n as IfExprNode*); }
            NodeKind::MatchExpression           => { return this.visit_match_expr(n as MatchExprNode*); }
            NodeKind::StaticMatchExpression     => { return this.visit_static_match_expr(n as StaticMatchExprNode*); }
            NodeKind::CallExpression            => { return this.visit_call(n as CallExprNode*); }
            NodeKind::NewExpression             => { return this.visit_new(n as NewExprNode*); }
            NodeKind::SizeofExpression          => { return this.visit_sizeof(n as SizeofExprNode*); }
            NodeKind::AlignofExpression         => { return this.visit_alignof(n as AlignofExprNode*); }
            NodeKind::CastExpression            => { return this.visit_cast(n as CastExprNode*); }
            NodeKind::StructLiteral             => { return this.visit_struct_literal(n as StructLiteralNode*); }
            NodeKind::ArrayLiteral              => { return this.visit_array_literal(n as ArrayLiteralNode*); }
            NodeKind::TupleLiteral              => { return this.visit_tuple_literal(n as TupleLiteralNode*); }
            NodeKind::LambdaExpression          => { return this.visit_lambda(n as LambdaExprNode*); }
            NodeKind::ArrayAccess               => { return this.visit_array_access(n as ArrayAccessNode*); }
            NodeKind::MemberAccess              => { return this.visit_member_access(n as MemberAccessNode*); }
            NodeKind::ScopeResolution           => { return this.visit_scope_resolution(n as ScopeResolutionNode*); }
            NodeKind::TypeofExpression          => { return this.visit_typeof(n as TypeofExprNode*); }
            NodeKind::DeleteExpression          => { return this.visit_delete(n as DeleteExprNode*); }
            NodeKind::AwaitExpression           => { return this.visit_await(n as AwaitExprNode*); }
            NodeKind::YieldExpression           => { return this.visit_yield(n as YieldExprNode*); }
            NodeKind::TryExpression             => { return this.visit_try(n as TryExprNode*); }

            NodeKind::BlockStatement            => { return this.visit_block(n as BlockStmtNode*); }
            NodeKind::UnsafeBlockStatement      => { return this.visit_unsafe_block(n as UnsafeBlockStmtNode*); }
            NodeKind::AsmBlockStatement         => { return this.visit_asm_block(n as AsmBlockStmtNode*); }
            NodeKind::ReturnStatement           => { return this.visit_return(n as ReturnStmtNode*); }
            NodeKind::IfStatement               => { return this.visit_if(n as IfStmtNode*); }
            NodeKind::WhileStatement            => { return this.visit_while(n as WhileStmtNode*); }
            NodeKind::DoWhileStatement          => { return this.visit_do_while(n as DoWhileStmtNode*); }
            NodeKind::ForStatement              => { return this.visit_for(n as ForStmtNode*); }
            NodeKind::MatchStatement            => { return this.visit_match_stmt(n as MatchStmtNode*); }
            NodeKind::StaticMatchStatement      => { return this.visit_static_match_stmt(n as StaticMatchStmtNode*); }
            NodeKind::BreakStatement            => { return this.visit_break(n as BreakStmtNode*); }
            NodeKind::ContinueStatement         => { return this.visit_continue(n as ContinueStmtNode*); }
            NodeKind::ExpressionStatement       => { return this.visit_expr_stmt(n as ExprStmtNode*); }
            NodeKind::DeclarationStatement      => { return this.visit_decl_stmt(n as DeclStmtNode*); }
            NodeKind::LoopStatement             => { return this.visit_loop(n as LoopStmtNode*); }

            NodeKind::VariableDeclaration       => { return this.visit_var(n as VarDeclNode*); }
            NodeKind::DestructureDeclaration    => { return this.visit_destructure(n as DestructureDeclNode*); }
            NodeKind::FunctionDeclaration       => { return this.visit_function(n as FunctionDeclNode*); }
            NodeKind::MethodDeclaration         => { return this.visit_method(n as MethodNode*); }
            NodeKind::IntrinsicDeclaration      => { return this.visit_intrinsic(n as IntrinsicDeclNode*); }
            NodeKind::IntrinsicConstDeclaration => { return this.visit_intrinsic_const(n as IntrinsicConstDeclNode*); }
            NodeKind::ImportDeclaration         => { return this.visit_import(n as ImportDeclNode*); }
            NodeKind::ModuleDeclaration         => { return this.visit_module(n as ModuleDeclNode*); }
            NodeKind::StructDeclaration         => { return this.visit_struct(n as StructDeclNode*); }
            NodeKind::UnionDeclaration          => { return this.visit_union(n as UnionDeclNode*); }
            NodeKind::ClassDeclaration          => { return this.visit_class(n as ClassDeclNode*); }
            NodeKind::TraitDeclaration          => { return this.visit_trait(n as TraitDeclNode*); }
            NodeKind::TypeAliasDeclaration      => { return this.visit_type_alias(n as TypeAliasDeclNode*); }
            NodeKind::EnumDeclaration           => { return this.visit_enum(n as EnumDeclNode*); }
            NodeKind::EnumVariant               => { return this.visit_enum_variant(n as EnumVariantNode*); }
            NodeKind::ImplementationBlock       => { return this.visit_impl(n as ImplBlockNode*); }
            NodeKind::ExternBlock               => { return this.visit_extern_block(n as ExternBlockNode*); }
            NodeKind::FieldDeclaration          => { return this.visit_field(n as FieldDeclNode*); }
            NodeKind::GenericParamDeclaration   => { return this.visit_generic_param(n as GenericParamNode*); }

            NodeKind::MatchArm                  => { return this.visit_match_arm(n as MatchArmNode*); }
            NodeKind::StaticMatchArm            => { return this.visit_static_match_arm(n as StaticMatchArmNode*); }
            NodeKind::Directive                 => { return this.visit_directive(n as DirectiveNode*); }
            NodeKind::Pattern                   => { return this.clone_pattern(n as PatternNode*); }

            // Kinds no node is built with.
            NodeKind::EnumPattern | NodeKind::Expression | NodeKind::Statement
            | NodeKind::Declaration | NodeKind::AsyncExpression | NodeKind::Unknown => { return null; }
        }
    }

    /// Clone any ASTNode.
    clone_node(mut &this, node: ASTNode*) -> ASTNode* {
        if (node == null) { return null; }
        return ASTCloner::keep_generated(node, this.dispatch_node(node));
    }

    /// `copy`, marked generated when `node` is: a copy of a node the compiler
    /// wrote is one too.
    static keep_generated(node: ASTNode*, copy: ASTNode*) -> ASTNode* {
        if (copy != null) { copy.generated = node.generated; }
        return copy;
    }

    /// Clone an expression node (cast wrapper).
    clone_expr(mut &this, node: ExpressionNode*) -> ExpressionNode* {
        if (node == null) { return null; }
        const e: ExpressionNode* = ASTCloner::keep_generated(node, this.dispatch_node(node))
            as ExpressionNode*;
        if (this.carries_types && e != null && !e.resolved_type.is_valid()) {
            e.set_resolved_type(node.resolved_type);
        }
        return e;
    }

    /// Clone a statement node (cast wrapper).
    clone_stmt(mut &this, node: StatementNode*) -> StatementNode* {
        if (node == null) { return null; }
        return ASTCloner::keep_generated(node, this.dispatch_node(node)) as StatementNode*;
    }

    /// Clone a declaration node (cast wrapper).
    clone_decl(mut &this, node: DeclarationNode*) -> DeclarationNode* {
        if (node == null) { return null; }
        return ASTCloner::keep_generated(node, this.dispatch_node(node)) as DeclarationNode*;
    }


    // Type annotation cloning: delegates to TypeAnnotation::clone()

    /// Deep-copy a type annotation tree.  Null-safe wrapper around
    /// the TypeAnnotation::clone() method defined in compiler::ast.
    clone_type_annotation(mut &this, ann: TypeAnnotation*) -> TypeAnnotation* {
        return TypeAnnotation::clone_ptr(ann);
    }

    /// Deep-copy an array of type annotations.
    clone_type_annotations(mut &this, anns: &[TypeAnnotation*]) -> [TypeAnnotation*] {
        mut result: [TypeAnnotation*] = [];
        for (mut i: i64 = 0; i < anns.length; i++) {
            result.push(TypeAnnotation::clone_ptr(anns[i]));
        }
        return result;
    }


    // Helper: copy DeclarationNode base fields

    copy_decl_base(mut &this, src: DeclarationNode*, dst: DeclarationNode*) -> void {
        dst.documentation = src.documentation;
        dst.source_file = src.source_file;
        dst.name_span     = src.name_span;
        dst.has_error     = src.has_error;
        for (mut i: i64 = 0; i < src.attached_directives.length; i++) {
            const orig: DirectiveNode* = src.attached_directives[i];
            if (orig != null) {
                dst.attached_directives.push(this.visit_directive(orig) as DirectiveNode*);
            }
        }
    }


    // Expression visitors

    visit_literal(mut &this, node: LiteralNode*) -> ASTNode* {
        mut c: LiteralNode* = new LiteralNode(node.value, node.literal_kind, node.span);
        c.has_error = node.has_error;
        // The suffix is the literal's type. A generic template body is cloned
        // once per specialization, so dropping it here would silently re-type
        // every suffixed literal inside a template back to the default width.
        c.suffix    = node.suffix;
        c.byte_length = node.byte_length;
        return c;
    }

    visit_identifier(mut &this, node: IdentifierNode*) -> ASTNode* {
        mut c: IdentifierNode* = new IdentifierNode(node.name, node.span);
        c.is_global_reference = node.is_global_reference;
        c.is_this_keyword     = node.is_this_keyword;
        c.is_this_type_keyword = node.is_this_type_keyword;
        c.has_error           = node.has_error;
        c.generic_args        = this.clone_type_annotations(node.generic_args);
        c.resolved_callee     = node.resolved_callee;
        c.res                 = node.res;
        mut vta: [TypeRef] = [];
        for (mut i: i64 = 0; i < node.value_type_args.length; i++) { vta.push(node.value_type_args[i]); }
        c.value_type_args     = vta;
        c.value_template      = node.value_template;
        // Carry sema's type for the identifier.  A generic template body sema
        // type-checked is cloned per specialization; the monomorphizer dispatches
        // a method call on its receiver's `resolved_type`, and that receiver is
        // commonly a local/parameter identifier (e.g. `raw.cast<..>()` where
        // `raw` is a `match`-bound local).  Codegen re-resolves identifier types
        // from their declaration, so carrying a still-generic type here is safe;
        // the monomorphizer applies the active substitution at its walk.
        c.set_resolved_type(node.resolved_type);
        return c;
    }

    visit_binary(mut &this, node: BinaryExprNode*) -> ASTNode* {
        mut c: BinaryExprNode* = new BinaryExprNode(
            node.op,
            this.clone_expr(node.left),
            this.clone_expr(node.right),
            node.span
        );
        c.has_error = node.has_error;
        // Carry an operator-overload desugar (built at sema for a bounded-param
        // operand) into the specialization so the substituter can concretize
        // its stashed type-args and codegen finds the trait-method call.
        if (node.desugared_call != null) {
            c.desugared_call = this.clone_expr(node.desugared_call);
        }
        c.desugar_by_bound = node.desugar_by_bound;
        c.append_entry = node.append_entry;
        return c;
    }

    visit_unary(mut &this, node: UnaryExprNode*) -> ASTNode* {
        mut c: UnaryExprNode* = new UnaryExprNode(
            node.op,
            this.clone_expr(node.operand),
            node.span
        );
        c.has_error    = node.has_error;
        c.is_postfix   = node.is_postfix;
        c.is_synthetic = node.is_synthetic;
        if (node.desugared_call != null) {
            c.desugared_call = this.clone_expr(node.desugared_call);
        }
        c.desugar_by_bound = node.desugar_by_bound;
        return c;
    }

    visit_ternary(mut &this, node: TernaryExprNode*) -> ASTNode* {
        mut c: TernaryExprNode* = new TernaryExprNode(
            this.clone_expr(node.condition),
            this.clone_expr(node.true_expr),
            this.clone_expr(node.false_expr),
            node.span
        );
        c.has_error = node.has_error;
        return c;
    }

    visit_if_expr(mut &this, node: IfExprNode*) -> ASTNode* {
        mut c: IfExprNode* = new IfExprNode(
            this.clone_expr(node.condition),
            this.clone_expr(node.then_expr),
            this.clone_expr(node.else_expr),
            node.span
        );
        c.has_error = node.has_error;
        return c;
    }

    visit_match_expr(mut &this, node: MatchExprNode*) -> ASTNode* {
        mut c: MatchExprNode* = new MatchExprNode(
            this.clone_expr(node.subject), node.span
        );
        for (mut i: i64 = 0; i < node.arms.length; i++) {
            c.add_arm(this.clone_match_arm(node.arms[i]));
        }
        c.has_error = node.has_error;
        return c;
    }

    visit_static_match_expr(mut &this, node: StaticMatchExprNode*) -> ASTNode* {
        mut c: StaticMatchExprNode* = new StaticMatchExprNode(
            this.clone_type_annotation(node.scrutinee), node.span
        );
        for (mut i: i64 = 0; i < node.arms.length; i++) {
            c.add_arm(this.clone_static_match_arm(node.arms[i]));
        }
        c.has_error = node.has_error;
        return c;
    }

    visit_call(mut &this, node: CallExprNode*) -> ASTNode* {
        mut c: CallExprNode* = new CallExprNode(
            this.clone_expr(node.callee), node.span
        );
        for (mut i: i64 = 0; i < node.arguments.length; i++) {
            c.add_argument(this.clone_expr(node.arguments[i]));
        }
        c.generic_args = this.clone_type_annotations(node.generic_args);
        c.resolved_callee = node.resolved_callee;
        c.named_method = node.named_method;
        c.template_method = node.template_method;
        c.template_recv = node.template_recv;
        // The template pin travels with the clone for the same reason the
        // type-arg stash does: the clone is what mono specializes, and
        // re-picking the template by bare name there can land on a different
        // module's same-named generic.
        c.resolved_template = node.resolved_template;
        // Carry sema's stashed type-arg bindings into the clone so the
        // monomorphizer can enqueue this call's instantiation by applying the
        // active specialization subst to them (mono-after-sema), instead of
        // re-inferring.  Element-wise copy: TypeRef is Copy but the array owns
        // its buffer, so a by-value assignment would alias and double-free.
        mut rta: [TypeRef] = [];
        for (mut i: i64 = 0; i < node.resolved_type_args.length; i++) {
            rta.push(node.resolved_type_args[i]);
        }
        c.resolved_type_args = rta;
        mut bps: [TypeRef] = [];
        for (mut i: i64 = 0; i < node.bound_params.length; i++) {
            bps.push(node.bound_params[i]);
        }
        c.bound_params = bps;
        mut btas: [TypeRef] = [];
        for (mut i: i64 = 0; i < node.bound_trait_args.length; i++) {
            btas.push(node.bound_trait_args[i]);
        }
        c.bound_trait_args = btas;
        c.has_error = node.has_error;
        return c;
    }

    visit_new(mut &this, node: NewExprNode*) -> ASTNode* {
        mut c: NewExprNode* = new NewExprNode(node.type_name, node.span);
        c.variant_name    = node.variant_name;
        c.res             = node.res;
        c.resolved_member = node.resolved_member;
        c.pin_carried     = node.pin_carried;
        for (mut i: i64 = 0; i < node.arguments.length; i++) {
            c.add_argument(this.clone_expr(node.arguments[i]));
        }
        c.generic_args = this.clone_type_annotations(node.generic_args);
        if (node.has_array_size()) {
            c.set_array_size(this.clone_expr(node.array_size));
        }
        if (node.has_struct_init()) {
            c.struct_init = this.clone_expr(node.struct_init) as StructLiteralNode*;
        }
        c.has_error = node.has_error;
        return c;
    }

    visit_sizeof(mut &this, node: SizeofExprNode*) -> ASTNode* {
        mut c: SizeofExprNode* = new SizeofExprNode(
            this.clone_type_annotation(node.type_ann), node.span);
        // The operand's type is carried as every decided type is; a copy's
        // substitution rewrites it with the annotation.
        c.set_operand_type(node.operand_type);
        c.has_error = node.has_error;
        return c;
    }

    visit_alignof(mut &this, node: AlignofExprNode*) -> ASTNode* {
        mut c: AlignofExprNode* = new AlignofExprNode(
            this.clone_type_annotation(node.type_ann), node.span);
        c.set_operand_type(node.operand_type);
        c.has_error = node.has_error;
        return c;
    }

    visit_cast(mut &this, node: CastExprNode*) -> ASTNode* {
        mut c: CastExprNode* = new CastExprNode(
            this.clone_expr(node.expression),
            this.clone_type_annotation(node.target_annotation),
            node.span
        );
        // The target the walk decided, carried as every other type is; a copy's
        // substitution rewrites it with the annotation.
        c.set_resolved_target(node.resolved_target);
        c.has_error = node.has_error;
        return c;
    }

    visit_struct_literal(mut &this, node: StructLiteralNode*) -> ASTNode* {
        mut c: StructLiteralNode* = new StructLiteralNode(node.struct_type, node.span);
        c.generic_args = this.clone_type_annotations(node.generic_args);
        c.res          = node.res;
        for (mut i: i64 = 0; i < node.field_inits.length; i++) {
            const fi: FieldInit = node.field_inits[i];
            c.add_field_init(FieldInit {
                field_name: fi.field_name,
                value:      this.clone_expr(fi.value),
                span:        fi.span,
                pin:         fi.pin,
                pin_carried: fi.pin_carried,
            });
        }
        c.has_error = node.has_error;
        return c;
    }

    visit_array_literal(mut &this, node: ArrayLiteralNode*) -> ASTNode* {
        mut c: ArrayLiteralNode* = new ArrayLiteralNode(node.span);
        for (mut i: i64 = 0; i < node.elements.length; i++) {
            c.add_element(this.clone_expr(node.elements[i]));
        }
        c.repeat_count = node.repeat_count;
        if (node.repeat_count_expr != null) {
            c.set_repeat_count_expr(this.clone_expr(node.repeat_count_expr));
        }
        c.has_error = node.has_error;
        return c;
    }

    visit_tuple_literal(mut &this, node: TupleLiteralNode*) -> ASTNode* {
        mut c: TupleLiteralNode* = new TupleLiteralNode(node.span);
        for (mut i: i64 = 0; i < node.elements.length; i++) {
            c.add_element(this.clone_expr(node.elements[i]));
        }
        c.has_error = node.has_error;
        return c;
    }

    visit_lambda(mut &this, node: LambdaExprNode*) -> ASTNode* {
        mut c: LambdaExprNode* = new LambdaExprNode(node.span);
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            c.add_parameter(this.clone_var_decl(node.parameters[i]));
        }
        if (node.return_type.is_valid()) {
            c.set_return_type(node.return_type);
        }
        if (node.return_type_ann != null) {
            c.set_return_type_ann(node.return_type_ann.clone());
        }
        if (node.body != null) {
            c.set_body(this.clone_stmt(node.body));
        }
        // Captures are normally populated during Sema, which runs after
        // cloning, so this loop is a no-op in practice; defensive in case
        // an already-sema'd lambda is ever cloned later.
        for (mut k: i64 = 0; k < node.captured_names.length; k++) {
            c.add_capture(node.captured_names[k],
                          node.captured_syms[k],
                          node.captured_types[k],
                          node.captured_spans[k]);
        }
        c.is_move   = node.is_move;
        c.has_error = node.has_error;
        return c;
    }

    visit_array_access(mut &this, node: ArrayAccessNode*) -> ASTNode* {
        mut c: ArrayAccessNode* = new ArrayAccessNode(
            this.clone_expr(node.array),
            this.clone_expr(node.index),
            node.span
        );
        c.has_error = node.has_error;
        // Carry an index-operator-overload desugar (`*(a.index(i))`, built at
        // sema for a bounded-param or generic container) into the specialization
        // so the substituter can concretize its type-args and codegen finds it.
        if (node.desugared_call != null) {
            c.desugared_call = this.clone_expr(node.desugared_call);
        }
        return c;
    }

    visit_member_access(mut &this, node: MemberAccessNode*) -> ASTNode* {
        mut c: MemberAccessNode* = new MemberAccessNode(
            this.clone_expr(node.object),
            node.member,
            node.member_span,
            node.span
        );
        c.generic_args    = this.clone_type_annotations(node.generic_args);
        c.resolved_trait  = node.resolved_trait;
        c.resolved_trait_slot = node.resolved_trait_slot;
        c.resolved_member = node.resolved_member;
        c.pin_carried     = node.pin_carried;
        c.has_error       = node.has_error;
        return c;
    }

    visit_scope_resolution(mut &this, node: ScopeResolutionNode*) -> ASTNode* {
        mut c: ScopeResolutionNode* = new ScopeResolutionNode(
            node.scope_name, node.member_name, node.span
        );
        c.generic_args       = this.clone_type_annotations(node.generic_args);
        c.scope_generic_args = this.clone_type_annotations(node.scope_generic_args);
        // Copied verbatim: a `Res` names a definition, so it stays true for a
        // copy of the syntax that named it.  A clone that dropped it would
        // re-ask the question from wherever the cloner happens to be standing,
        // which is the whole reason the answer is on the node.
        c.scope_res = node.scope_res;
        c.resolved_callee = node.resolved_callee;
        c.resolved_member = node.resolved_member;
        c.pin_carried = node.pin_carried;
        c.scope_is_this_type = node.scope_is_this_type;
        mut vta: [TypeRef] = [];
        for (mut i: i64 = 0; i < node.value_type_args.length; i++) { vta.push(node.value_type_args[i]); }
        c.value_type_args = vta;
        c.value_template = node.value_template;
        c.spec_owner = node.spec_owner;
        c.impl_trait = this.clone_type_annotation(node.impl_trait);
        c.resolved_trait = node.resolved_trait;
        c.template_method = node.template_method;
        c.member_def = node.member_def;
        c.has_error = node.has_error;
        return c;
    }

    visit_typeof(mut &this, node: TypeofExprNode*) -> ASTNode* {
        mut c: TypeofExprNode* = new TypeofExprNode(
            this.clone_expr(node.operand), node.span
        );
        c.has_error = node.has_error;
        return c;
    }

    visit_delete(mut &this, node: DeleteExprNode*) -> ASTNode* {
        mut c: DeleteExprNode* = new DeleteExprNode(
            this.clone_expr(node.operand), node.span
        );
        c.has_error = node.has_error;
        return c;
    }

    visit_await(mut &this, node: AwaitExprNode*) -> ASTNode* {
        mut c: AwaitExprNode* = new AwaitExprNode(
            this.clone_expr(node.operand), node.span
        );
        c.has_error = node.has_error;
        return c;
    }

    visit_yield(mut &this, node: YieldExprNode*) -> ASTNode* {
        const operand: ExpressionNode* = node.has_operand()
            ? this.clone_expr(node.operand)
            : null;
        mut c: YieldExprNode* = new YieldExprNode(operand, node.span);
        c.has_error = node.has_error;
        return c;
    }

    visit_try(mut &this, node: TryExprNode*) -> ASTNode* {
        mut c: TryExprNode* = new TryExprNode(
            this.clone_expr(node.operand), node.span
        );
        // `desugared` is normally null at clone time (monomorphization runs
        // before sema lowers `?`), but clone it defensively if present so a
        // post-sema clone stays self-consistent.
        if (node.desugared != null) {
            c.desugared = this.clone_expr(node.desugared);
            // The desugared `match` takes the operand node ITSELF as its
            // subject. Cloning the two independently splits that sharing, and
            // the halves are read by different consumers: call specialization
            // and dispatch annotation walk `operand`, while codegen emits
            // `desugared`. A split clone therefore emits a call that nothing
            // specialized — `?` on a generic free function stopped resolving at
            // codegen. Re-point the copy so the invariant survives the clone.
            //
            // The async lowering deliberately breaks the sharing (it hoists an
            // `await` out of the subject into a temp), so this only re-points
            // when the original still holds it.
            if (node.desugared.kind == NodeKind::MatchExpression
                    && (node.desugared as MatchExprNode*).subject == node.operand) {
                (c.desugared as MatchExprNode*).subject = c.operand;
            }
        }
        c.has_error = node.has_error;
        return c;
    }


    // Statement visitors

    visit_block(mut &this, node: BlockStmtNode*) -> ASTNode* {
        mut c: BlockStmtNode* = new BlockStmtNode(node.span);
        for (mut i: i64 = 0; i < node.statements.length; i++) {
            c.add_statement(this.clone_stmt(node.statements[i]));
        }
        // ConfigGating runs strictly before any clone-emitting pass
        // (Monomorphization etc.), so attached_directives on a block
        // are always empty by the time we reach the cloner.  Skipping
        // the copy avoids burdening the cloner with directive-graph
        // walking that would otherwise be dead code.
        c.has_error = node.has_error;
        return c;
    }

    visit_unsafe_block(mut &this, node: UnsafeBlockStmtNode*) -> ASTNode* {
        const cloned_block: BlockStmtNode* = this.dispatch_node(node.block) as BlockStmtNode*;
        mut c: UnsafeBlockStmtNode* = new UnsafeBlockStmtNode(cloned_block, node.span);
        c.has_error = node.has_error;
        return c;
    }

    visit_asm_block(mut &this, node: AsmBlockStmtNode*) -> ASTNode* {
        mut c: AsmBlockStmtNode* = new AsmBlockStmtNode(node.span);
        c.arch = node.arch;
        c.dialect = node.dialect;
        c.is_module_level = node.is_module_level;
        c.has_error = node.has_error;
        for (mut i: i64 = 0; i < node.operands.length; i++) {
            mut op: AsmOperand = node.operands[i].clone();
            op.expr = this.clone_expr(op.expr);
            c.add_operand(op);
        }
        for (mut i: i64 = 0; i < node.pieces.length; i++) {
            c.add_piece(node.pieces[i].clone());
        }
        for (mut i: i64 = 0; i < node.clobbers.length; i++) {
            c.add_clobber(node.clobbers[i]);
        }
        for (mut i: i64 = 0; i < node.attached_directives.length; i++) {
            c.add_directive(node.attached_directives[i]);
        }
        return c;
    }

    visit_return(mut &this, node: ReturnStmtNode*) -> ASTNode* {
        mut c: ReturnStmtNode* = new ReturnStmtNode(
            this.clone_expr(node.expression), node.span
        );
        c.has_error = node.has_error;
        return c;
    }

    visit_if(mut &this, node: IfStmtNode*) -> ASTNode* {
        mut c: IfStmtNode* = new IfStmtNode(
            this.clone_expr(node.condition),
            this.clone_stmt(node.then_stmt),
            this.clone_stmt(node.else_stmt),
            node.span
        );
        c.has_error = node.has_error;
        return c;
    }

    visit_while(mut &this, node: WhileStmtNode*) -> ASTNode* {
        mut c: WhileStmtNode* = new WhileStmtNode(
            this.clone_expr(node.condition),
            this.clone_stmt(node.body),
            node.span
        );
        c.has_error = node.has_error;
        return c;
    }

    visit_do_while(mut &this, node: DoWhileStmtNode*) -> ASTNode* {
        mut c: DoWhileStmtNode* = new DoWhileStmtNode(
            this.clone_stmt(node.body),
            this.clone_expr(node.condition),
            node.span
        );
        c.has_error = node.has_error;
        return c;
    }

    visit_for(mut &this, node: ForStmtNode*) -> ASTNode* {
        mut c: ForStmtNode* = new ForStmtNode(
            this.clone_node(node.init),
            this.clone_expr(node.condition),
            this.clone_expr(node.update),
            this.clone_stmt(node.body),
            node.span
        );
        c.has_error = node.has_error;
        return c;
    }

    visit_match_stmt(mut &this, node: MatchStmtNode*) -> ASTNode* {
        mut c: MatchStmtNode* = new MatchStmtNode(
            this.clone_expr(node.subject), node.span
        );
        for (mut i: i64 = 0; i < node.arms.length; i++) {
            c.add_arm(this.clone_match_arm(node.arms[i]));
        }
        c.has_error = node.has_error;
        return c;
    }

    visit_static_match_stmt(mut &this, node: StaticMatchStmtNode*) -> ASTNode* {
        mut c: StaticMatchStmtNode* = new StaticMatchStmtNode(
            this.clone_type_annotation(node.scrutinee), node.span
        );
        for (mut i: i64 = 0; i < node.arms.length; i++) {
            c.add_arm(this.clone_static_match_arm(node.arms[i]));
        }
        c.has_error = node.has_error;
        return c;
    }

    visit_break(mut &this, node: BreakStmtNode*) -> ASTNode* {
        mut c: BreakStmtNode* = new BreakStmtNode(node.span);
        c.has_error = node.has_error;
        return c;
    }

    visit_continue(mut &this, node: ContinueStmtNode*) -> ASTNode* {
        mut c: ContinueStmtNode* = new ContinueStmtNode(node.span);
        c.has_error = node.has_error;
        return c;
    }

    visit_expr_stmt(mut &this, node: ExprStmtNode*) -> ASTNode* {
        mut c: ExprStmtNode* = new ExprStmtNode(
            this.clone_expr(node.expression), node.span
        );
        c.has_error = node.has_error;
        return c;
    }

    visit_decl_stmt(mut &this, node: DeclStmtNode*) -> ASTNode* {
        mut c: DeclStmtNode* = new DeclStmtNode(
            this.clone_decl(node.declaration), node.span
        );
        c.has_error = node.has_error;
        return c;
    }

    visit_loop(mut &this, node: LoopStmtNode*) -> ASTNode* {
        mut c: LoopStmtNode* = new LoopStmtNode(
            this.clone_stmt(node.body), node.span
        );
        c.has_error = node.has_error;
        return c;
    }


    // Declaration visitors

    visit_var(mut &this, node: VarDeclNode*) -> ASTNode* {
        const c: VarDeclNode* = this.clone_var_decl(node);
        // A local declaration's decided type is carried, and a copy's
        // substitution rewrites it.  Only the statement: a parameter's type
        // is the copy's signature, which monomorphization builds itself.
        c.resolved_type = node.resolved_type;
        return c;
    }

    visit_destructure(mut &this, node: DestructureDeclNode*) -> ASTNode* {
        mut c: DestructureDeclNode* = new DestructureDeclNode(node.span);
        this.copy_decl_base(node, c);
        c.set_mutable(node.is_mutable);
        for (mut i: i64 = 0; i < node.bindings.length; i++) {
            const b: DestructureBinding = node.bindings[i];
            mut nb: DestructureBinding = DestructureBinding::new(
                b.source_field, b.local_name, b.is_mutable, b.span, b.name_span);
            nb.sym_id = b.sym_id;
            nb.resolved_type = b.resolved_type;
            nb.field_index = b.field_index;
            c.add_binding(nb);
        }
        c.resolved_type = node.resolved_type;
        if (node.has_type_annotation()) {
            c.set_type_annotation(this.clone_type_annotation(node.type_annotation));
        }
        if (node.has_initializer()) {
            c.set_initializer(this.clone_expr(node.initializer));
        }
        return c;
    }

    visit_function(mut &this, node: FunctionDeclNode*) -> ASTNode* {
        const name: SymbolStr = this.consume_spec_name(node.name);
        const skip_gp: boolean = this.consume_skip_generics();
        mut c: FunctionDeclNode* = new FunctionDeclNode(name, node.span);
        this.copy_decl_base(node, c);
        c.is_public   = node.is_public;
        c.is_static   = node.is_static;
        c.is_async    = node.is_async;
        c.is_inline   = node.is_inline;
        c.is_noinline = node.is_noinline;
        c.is_caller_located = node.is_caller_located;
        c.is_variadic = node.is_variadic;
        c.is_synthesized_body = node.is_synthesized_body;
        c.is_synth_default = node.is_synth_default;
        c.is_intrinsic = node.is_intrinsic;
        c.is_self_returning_default = node.is_self_returning_default;
        c.is_lazy_self_growing = node.is_lazy_self_growing;
        c.link_name     = node.link_name;
        c.has_link_name = node.has_link_name;
        // Preserve the originating trait so a SPECIALIZED generic trait
        // method (e.g. `Str::Debug::fmt<String>` cloned from `fmt<W>`)
        // mangles with its trait and doesn't collide with the same-named
        // method of another trait on the same type (`Str::Display::fmt`).
        // Without this the two specs share one symbol and dispatch silently
        // resolves to whichever was emitted, breaking Debug.
        c.set_origin_trait(node.origin_trait);
        c.set_async_fut_slot(node.async_fut_slot);
        // A copy stands for the definition its source is, or for the one
        // its source already stood for.
        c.copy_of = if (node.def.is_valid()) { node.def } else { node.copy_of };
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            c.add_parameter(this.clone_var_decl(node.parameters[i]));
        }
        if (!skip_gp) {
            for (mut i: i64 = 0; i < node.generic_params.length; i++) {
                c.add_generic_param(this.clone_generic_param(node.generic_params[i]));
            }
        }
        // A copy owns its bounds as it owns its parameters: a bound's
        // projection subject caches what it resolved to in its own
        // signature's context, which is not the source's.
        for (mut i: i64 = 0; i < node.trait_bounds.length; i++) {
            c.add_trait_bound(node.trait_bounds[i].clone());
        }
        if (node.return_type_annotation != null) {
            c.set_return_type_annotation(this.clone_type_annotation(node.return_type_annotation));
        }
        if (node.has_body()) {
            c.set_body(this.dispatch_node(node.body) as BlockStmtNode*);
        }
        return c;
    }

    visit_method(mut &this, node: MethodNode*) -> ASTNode* {
        const cloned_func: FunctionDeclNode* = this.clone_func_decl(node.func);
        mut c: MethodNode* = new MethodNode(cloned_func, node.span);
        this.copy_decl_base(node, c);
        c.visibility            = node.visibility;
        c.is_constructor        = node.is_constructor;
        c.is_destructor         = node.is_destructor;
        c.is_static             = node.is_static;
        c.is_default_destructor = node.is_default_destructor;
        c.is_virtual            = node.is_virtual;
        c.is_override           = node.is_override;
        // `![sink]` must survive monomorphization: a cloned generic method
        // (e.g. Option<T>::unwrap specialized for a concrete T) still
        // consumes its receiver, and drop-insertion relies on this flag to
        // suppress the receiver's scope-exit drop (otherwise glue would
        // double-free a payload the method copied out).
        c.is_sink               = node.is_sink;
        c.base_ctor_name        = node.base_ctor_name;
        mut cloned_args: [ExpressionNode*] = [];
        for (mut i: i64 = 0; i < node.base_ctor_args.length; i++) {
            cloned_args.push(this.clone_expr(node.base_ctor_args[i]));
        }
        c.base_ctor_args = cloned_args;
        return c;
    }

    visit_intrinsic(mut &this, node: IntrinsicDeclNode*) -> ASTNode* {
        mut c: IntrinsicDeclNode* = new IntrinsicDeclNode(node.name, node.span);
        this.copy_decl_base(node, c);
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            c.add_parameter(this.clone_var_decl(node.parameters[i]));
        }
        if (node.has_body()) {
            c.set_body(this.dispatch_node(node.body) as BlockStmtNode*);
        }
        // resolved_return_type left as TypeRef::invalid() (constructor default)
        return c;
    }

    visit_intrinsic_const(mut &this, node: IntrinsicConstDeclNode*) -> ASTNode* {
        mut c: IntrinsicConstDeclNode* = new IntrinsicConstDeclNode(node.name, node.span);
        this.copy_decl_base(node, c);
        if (node.type_annotation != null) {
            c.type_annotation = node.type_annotation.clone();
        }
        // resolved_type left as TypeRef::invalid() (constructor default)
        c.def = node.def;
        return c;
    }

    visit_import(mut &this, node: ImportDeclNode*) -> ASTNode* {
        mut c: ImportDeclNode* = new ImportDeclNode(node.module_path, node.style, node.span);
        this.copy_decl_base(node, c);
        c.alias = node.alias;
        c.specific_imports = node.specific_imports;
        c.specific_aliases = node.specific_aliases;
        c.specific_spans = node.specific_spans;
        c.specific_alias_spans = node.specific_alias_spans;
        c.specific_defs = node.specific_defs;
        c.specific_def_entries = node.specific_def_entries;
        c.is_export = node.is_export;
        c.path_entry = node.path_entry;
        c.resolved_module = node.resolved_module;
        return c;
    }

    visit_module(mut &this, node: ModuleDeclNode*) -> ASTNode* {
        mut c: ModuleDeclNode* = new ModuleDeclNode(node.path, node.is_public, node.span);
        this.copy_decl_base(node, c);
        return c;
    }

    visit_struct(mut &this, node: StructDeclNode*) -> ASTNode* {
        const name: SymbolStr = this.consume_spec_name(node.name);
        const skip_gp: boolean = this.consume_skip_generics();
        mut c: StructDeclNode* = new StructDeclNode(name, node.span);
        this.copy_decl_base(node, c);
        // Carry `![repr(...)]` / `![align]` onto the specialization so the
        // monomorphizer can stamp the chosen layout on the concrete type
        // (DirectiveProcessing runs before mono and never sees specialized
        // decls). copy_decl_base only copies the raw directive nodes, not
        // these resolved flags.
        c.repr_c           = node.repr_c;
        c.repr_packed      = node.repr_packed;
        c.repr_transparent = node.repr_transparent;
        c.min_alignment    = node.min_alignment;
        c.async_recv_slot  = node.async_recv_slot;
        c.is_public        = node.is_public;
        c.where_bounds     = node.where_bounds;
        if (!skip_gp) {
            for (mut i: i64 = 0; i < node.generic_params.length; i++) {
                c.add_generic_param(this.clone_generic_param(node.generic_params[i]));
            }
        }
        for (mut i: i64 = 0; i < node.fields.length; i++) {
            c.add_field(this.clone_field_decl(node.fields[i]));
        }
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            c.add_method(this.dispatch_node(node.methods[i]) as MethodNode*);
        }
        // Bindgen-only blob accessors (shallow: shares the value_type annotation
        // pointers, as elsewhere in cloning).  Empty for every parser-produced
        // struct, so this is a no-op outside the C-import path.
        for (mut i: i64 = 0; i < node.binding_accessors.length; i++) {
            c.add_accessor(node.binding_accessors[i]);
        }
        return c;
    }

    visit_union(mut &this, node: UnionDeclNode*) -> ASTNode* {
        const name: SymbolStr = this.consume_spec_name(node.name);
        const skip_gp: boolean = this.consume_skip_generics();
        mut c: UnionDeclNode* = new UnionDeclNode(name, node.span);
        this.copy_decl_base(node, c);
        // See StructDeclNode clone: carry layout flags onto the spec so the
        // monomorphizer can stamp the chosen layout on the concrete type.
        c.repr_c            = node.repr_c;
        c.repr_packed       = node.repr_packed;
        c.repr_transparent  = node.repr_transparent;
        c.min_alignment     = node.min_alignment;
        c.is_public         = node.is_public;
        c.where_bounds      = node.where_bounds;
        c.binding_namespace = node.binding_namespace;
        if (!skip_gp) {
            for (mut i: i64 = 0; i < node.generic_params.length; i++) {
                c.add_generic_param(this.clone_generic_param(node.generic_params[i]));
            }
        }
        for (mut i: i64 = 0; i < node.fields.length; i++) {
            c.add_field(this.clone_field_decl(node.fields[i]));
        }
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            c.add_method(this.dispatch_node(node.methods[i]) as MethodNode*);
        }
        return c;
    }

    visit_class(mut &this, node: ClassDeclNode*) -> ASTNode* {
        const name: SymbolStr = this.consume_spec_name(node.name);
        const skip_gp: boolean = this.consume_skip_generics();
        mut c: ClassDeclNode* = new ClassDeclNode(name, node.span);
        this.copy_decl_base(node, c);
        // See StructDeclNode clone: carry layout flags onto the spec.
        c.repr_c           = node.repr_c;
        c.repr_packed      = node.repr_packed;
        c.repr_transparent = node.repr_transparent;
        c.min_alignment    = node.min_alignment;
        c.is_public        = node.is_public;
        c.where_bounds     = node.where_bounds;
        c.base_class = node.base_class;
        c.base_res   = node.base_res;
        c.base_span  = node.base_span;
        if (!skip_gp) {
            for (mut i: i64 = 0; i < node.generic_params.length; i++) {
                c.add_generic_param(this.clone_generic_param(node.generic_params[i]));
            }
        }
        for (mut i: i64 = 0; i < node.fields.length; i++) {
            c.add_field(this.clone_field_decl(node.fields[i]));
        }
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            c.add_method(this.dispatch_node(node.methods[i]) as MethodNode*);
        }
        return c;
    }

    visit_trait(mut &this, node: TraitDeclNode*) -> ASTNode* {
        mut c: TraitDeclNode* = new TraitDeclNode(node.name, node.span);
        this.copy_decl_base(node, c);
        for (mut i: i64 = 0; i < node.generic_params.length; i++) {
            c.add_generic_param(this.clone_generic_param(node.generic_params[i]));
        }
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            c.add_method(this.clone_func_decl(node.methods[i]));
        }
        for (mut i: i64 = 0; i < node.base_traits.length; i++) {
            c.add_base_trait(node.base_traits[i].clone());
        }
        c.sym_id      = node.sym_id;
        return c;
    }

    visit_type_alias(mut &this, node: TypeAliasDeclNode*) -> ASTNode* {
        mut c: TypeAliasDeclNode* = new TypeAliasDeclNode(node.alias_name, node.span);
        this.copy_decl_base(node, c);
        for (mut i: i64 = 0; i < node.generic_params.length; i++) {
            c.add_generic_param(this.clone_generic_param(node.generic_params[i]));
        }
        if (node.target_annotation != null) {
            c.set_target_annotation(this.clone_type_annotation(node.target_annotation));
        }
        // resolved_target left as TypeRef::invalid() (constructor default)
        return c;
    }

    visit_enum(mut &this, node: EnumDeclNode*) -> ASTNode* {
        const name: SymbolStr = this.consume_spec_name(node.name);
        const skip_gp: boolean = this.consume_skip_generics();
        mut c: EnumDeclNode* = new EnumDeclNode(name, node.span);
        this.copy_decl_base(node, c);
        // See StructDeclNode clone: carry layout flags onto the spec.
        c.repr_c        = node.repr_c;
        c.min_alignment = node.min_alignment;
        c.is_public     = node.is_public;
        c.where_bounds  = node.where_bounds;
        if (!skip_gp) {
            for (mut i: i64 = 0; i < node.generic_params.length; i++) {
                c.add_generic_param(this.clone_generic_param(node.generic_params[i]));
            }
        }
        if (node.discriminant_annotation != null) {
            c.set_discriminant_annotation(this.clone_type_annotation(node.discriminant_annotation));
        }
        for (mut i: i64 = 0; i < node.variants.length; i++) {
            c.add_variant(this.clone_enum_variant(node.variants[i]));
        }
        return c;
    }

    visit_enum_variant(mut &this, node: EnumVariantNode*) -> ASTNode* {
        mut c: EnumVariantNode* = this.clone_enum_variant(node);
        return c;
    }

    visit_impl(mut &this, node: ImplBlockNode*) -> ASTNode* {
        mut c: ImplBlockNode* = new ImplBlockNode(node.target_type, node.span);
        this.copy_decl_base(node, c);
        for (mut i: i64 = 0; i < node.generic_params.length; i++) {
            c.add_generic_param(this.clone_generic_param(node.generic_params[i]));
        }
        if (node.trait_annotation != null) {
            c.set_trait_annotation(this.clone_type_annotation(node.trait_annotation));
        }
        c.set_target_args(this.clone_type_annotations(node.target_args));
        mut tats: [TypeRef] = [];
        for (mut i: i64 = 0; i < node.trait_arg_types.length; i++) { tats.push(node.trait_arg_types[i]); }
        c.trait_arg_types = tats;
        // where_bounds: shallow array copy. TraitBound entries are not mutated
        // post-construction (parser fills them, sema reads them), so the inner
        // trait_refs arrays can be shared safely.
        c.where_bounds = node.where_bounds;
        // `target_type_span` is deliberately NOT copied.
        // `trait_def` IS copied: specializing an impl rewrites
        // which type it is for, never which trait it provides, so the
        // template's trait identity is the clone's.
        c.trait_def = node.trait_def;
        // `res` is NOT copied:
        // a specialization rebinds WHICH type the head is for, and the stamp
        // names the template's definition.  A clone whose `target_type` the
        // monomorphizer rewrote to the spec would otherwise carry a stamp
        // naming the generic base beside a spelling naming the instantiation,
        // and a consumer reading the stamp would bind the head to the template.
        // Left unanswered, the spelling stays the single carrier of which
        // specialization the clone is for.
        // Associated-type bindings (`type Item = T;` / positional-header
        // desugar) and monomorphizer-recovered derived element bindings. These
        // are how `This::Item` projections and self-returning default methods
        // resolve concretely. Omitting them left eager-specialized generic-trait
        // impls with empty bindings -> E0636-class projection failures. The
        // annotations are owning pointers, so deep-clone them (no aliasing).
        for (mut i: i64 = 0; i < node.derived_param_names.length; i++) {
            c.add_derived_param(node.derived_param_syms[i], node.derived_param_names[i],
                                node.derived_param_types[i]);
        }
        for (mut i: i64 = 0; i < node.assoc_binding_names.length; i++) {
            c.assoc_binding_names.push(node.assoc_binding_names[i]);
            c.assoc_binding_slots.push(node.assoc_binding_slots[i]);
            c.assoc_binding_annotations.push(this.clone_type_annotation(node.assoc_binding_annotations[i]));
        }
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            c.add_method(this.dispatch_node(node.methods[i]) as MethodNode*);
        }
        return c;
    }

    visit_extern_block(mut &this, node: ExternBlockNode*) -> ASTNode* {
        mut c: ExternBlockNode* = new ExternBlockNode(node.linkage_type, node.span);
        this.copy_decl_base(node, c);
        for (mut i: i64 = 0; i < node.functions.length; i++) {
            c.add_function(this.clone_func_decl(node.functions[i]));
        }
        return c;
    }

    visit_field(mut &this, node: FieldDeclNode*) -> ASTNode* {
        const c: FieldDeclNode* = this.clone_field_decl(node);
        return c;
    }

    visit_generic_param(mut &this, node: GenericParamNode*) -> ASTNode* {
        const c: GenericParamNode* = this.clone_generic_param(node);
        return c;
    }


    // Other visitors

    visit_program(mut &this, node: ProgramNode*) -> ASTNode* {
        mut c: ProgramNode* = new ProgramNode(node.span);
        c.namespace_name = node.namespace_name;
        for (mut i: i64 = 0; i < node.statements.length; i++) {
            c.add_statement(this.clone_node(node.statements[i]));
        }
        c.has_error = node.has_error;
        return c;
    }

    visit_match_arm(mut &this, node: MatchArmNode*) -> ASTNode* {
        const c: MatchArmNode* = this.clone_match_arm(node);
        return c;
    }

    visit_pattern(mut &this, node: PatternNode*) -> ASTNode* {
        mut c: PatternNode* = new PatternNode(node.pattern_kind, node.span);
        c.value        = node.value;
        c.binding_name = node.binding_name;
        c.literal_kind = node.literal_kind;
        c.high_value   = node.high_value;
        c.const_res    = node.const_res;
        c.binding_sym  = node.binding_sym;
        c.has_error    = node.has_error;
        return c;
    }

    visit_enum_pattern(mut &this, node: EnumPatternNode*) -> ASTNode* {
        mut c: EnumPatternNode* = new EnumPatternNode(node.span);
        c.value        = node.value;
        c.binding_name = node.binding_name;
        c.literal_kind = node.literal_kind;
        c.high_value   = node.high_value;
        c.enum_name       = node.enum_name;
        c.variant_name    = node.variant_name;
        c.res             = node.res;
        c.resolved_member = node.resolved_member;
        c.pin_carried     = node.pin_carried;
        // Deep-clone the elements. A `Sub` element OWNS a nested PatternNode
        // that the substituter rewrites in place, so two specializations must
        // not alias it. (Before this, nested patterns like `Some(Some(n))`
        // aliased the template and skipped substitution -> a generic body
        // miscompiled to invalid IR.)
        //
        // A `Binding` is rewritten in place too: the async lowering
        // alpha-renames every arm binding of a body it turns into a state
        // machine. A shared `PatternBinding` therefore lets one copy's rename
        // reach the others, whose bodies still read the original name — the
        // shape that made an `async` trait DEFAULT body with both an `await`
        // and a bound arm fail to resolve that binding in every impl.
        //
        // The remaining leaves (Wildcard/Literal*) introduce no name and are
        // never rewritten, so they stay shared. Rebuilding the array
        // element-wise also avoids aliasing the whole buffer.
        mut new_elems: [PatternElement] = [];
        for (mut i: i64 = 0; i < node.elements.length; i++) {
            const el: PatternElement = node.elements[i];
            match (el) {
                PatternElement::Sub(sub) => {
                    mut ns: PatternSub* = new PatternSub {
                        pattern: null,
                        span:    sub.span,
                    };
                    if (sub.pattern != null) {
                        ns.pattern = this.clone_pattern(sub.pattern as PatternNode*) as void*;
                    }
                    new_elems.push(PatternElement::Sub(ns));
                }
                PatternElement::Binding(pb) => {
                    const nb: PatternBinding* = new PatternBinding {
                        name:   pb.name,
                        span:   pb.span,
                        sym_id: pb.sym_id,
                        resolved_type: TypeRef::invalid(),
                        written_mut: pb.written_mut,
                    };
                    new_elems.push(PatternElement::Binding(nb));
                }
                _ => { new_elems.push(el); }
            }
        }
        c.elements     = new_elems;
        c.has_error    = node.has_error;
        return c;
    }

    visit_directive(mut &this, node: DirectiveNode*) -> ASTNode* {
        mut c: DirectiveNode* = new DirectiveNode(node.directive_kind, node.span);
        // Deep-clone typed args; nested DirectiveNode* references must be
        // cloned recursively so two callers don't alias the same nested call.
        for (mut i: i64 = 0; i < node.args.length; i++) {
            const orig: DirectiveArg = node.args[i];
            mut copy: DirectiveArg = orig;
            if (orig.kind == DirectiveArgKind::Nested && orig.nested != null) {
                copy.nested = this.visit_directive(orig.nested) as DirectiveNode*;
            }
            c.args.push(copy);
        }
        c.has_error = node.has_error;
        return c;
    }


    // Typed clone helpers (avoid code duplication)

    /// Clone a VarDeclNode.
    clone_var_decl(mut &this, node: VarDeclNode*) -> VarDeclNode* {
        mut c: VarDeclNode* = new VarDeclNode(node.name, node.span);
        this.copy_decl_base(node, c);
        c.is_mutable       = node.is_mutable;
        c.is_auto          = node.is_auto;
        c.is_global        = node.is_global;
        c.is_capture_alias = node.is_capture_alias;
        c.is_drop_flag     = node.is_drop_flag;
        c.binding_namespace = node.binding_namespace;
        c.is_thread_local  = node.is_thread_local;
        // Losing these turns an imported global back into one Cryo defines: the
        // clone would be mangled under its module's namespace and emitted with
        // an initializer, so every reader asks the linker for a symbol the C
        // library never exports.
        c.is_extern_import = node.is_extern_import;
        c.link_name        = node.link_name;
        // A clone of a method's receiver is still the receiver.
        c.receiver         = node.receiver;
        // The clone is the same binding as far as every per-binding rib is
        // concerned: a specialization's body binds what the template's body
        // bound, and the uses inside it carry the template's `Res::Local`.
        // Dropping this would leave the clone's declaration and its own uses
        // keyed differently.
        c.sym_id           = node.sym_id;
        c.def              = node.def;
        if (node.has_initializer()) {
            c.set_initializer(this.clone_expr(node.initializer));
        }
        if (node.has_type_annotation()) {
            c.set_type_annotation(this.clone_type_annotation(node.type_annotation));
        }
        // resolved_type left as TypeRef::invalid() (constructor default)
        return c;
    }

    /// Clone a FunctionDeclNode.
    clone_func_decl(mut &this, node: FunctionDeclNode*) -> FunctionDeclNode* {
        mut c: FunctionDeclNode* = new FunctionDeclNode(node.name, node.span);
        this.copy_decl_base(node, c);
        c.is_public   = node.is_public;
        c.is_static   = node.is_static;
        c.is_async    = node.is_async;
        c.is_inline   = node.is_inline;
        c.is_noinline = node.is_noinline;
        c.is_caller_located = node.is_caller_located;
        c.is_variadic = node.is_variadic;
        c.is_synthesized_body = node.is_synthesized_body;
        c.is_synth_default = node.is_synth_default;
        c.is_intrinsic = node.is_intrinsic;
        c.is_self_returning_default = node.is_self_returning_default;
        c.is_lazy_self_growing = node.is_lazy_self_growing;
        c.link_name     = node.link_name;
        c.has_link_name = node.has_link_name;
        // Preserve the originating trait so a SPECIALIZED generic trait
        // method (e.g. `Str::Debug::fmt<String>` cloned from `fmt<W>`)
        // mangles with its trait and doesn't collide with the same-named
        // method of another trait on the same type (`Str::Display::fmt`).
        // Without this the two specs share one symbol and dispatch silently
        // resolves to whichever was emitted, breaking Debug.
        c.set_origin_trait(node.origin_trait);
        c.set_async_fut_slot(node.async_fut_slot);
        // A copy stands for the definition its source is, or for the one
        // its source already stood for.
        c.copy_of = if (node.def.is_valid()) { node.def } else { node.copy_of };
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            c.add_parameter(this.clone_var_decl(node.parameters[i]));
        }
        for (mut i: i64 = 0; i < node.generic_params.length; i++) {
            c.add_generic_param(this.clone_generic_param(node.generic_params[i]));
        }
        // A copy owns its bounds as it owns its parameters: a bound's
        // projection subject caches what it resolved to in its own
        // signature's context, which is not the source's.
        for (mut i: i64 = 0; i < node.trait_bounds.length; i++) {
            c.add_trait_bound(node.trait_bounds[i].clone());
        }
        if (node.return_type_annotation != null) {
            c.set_return_type_annotation(this.clone_type_annotation(node.return_type_annotation));
        }
        if (node.has_body()) {
            c.set_body(this.dispatch_node(node.body) as BlockStmtNode*);
        }
        // resolved_return_type left as TypeRef::invalid() (constructor default)
        return c;
    }

    /// Clone a FieldDeclNode.
    clone_field_decl(mut &this, node: FieldDeclNode*) -> FieldDeclNode* {
        mut c: FieldDeclNode* = new FieldDeclNode(node.name, node.span);
        this.copy_decl_base(node, c);
        c.visibility = node.visibility;
        if (node.has_default_value()) {
            c.set_default_value(this.clone_expr(node.default_value));
        }
        if (node.has_type_annotation()) {
            c.set_type_annotation(this.clone_type_annotation(node.type_annotation));
        }
        // resolved_type left as TypeRef::invalid() (constructor default)
        return c;
    }

    /// Clone a GenericParamNode.
    clone_generic_param(mut &this, node: GenericParamNode*) -> GenericParamNode* {
        mut c: GenericParamNode* = new GenericParamNode(node.name, node.span);
        this.copy_decl_base(node, c);
        // The template's symbol, as every `Res` in the body is the template's.
        c.set_sym_id(node.sym_id);
        if (node.default_annotation != null) {
            c.set_default_annotation(this.clone_type_annotation(node.default_annotation));
        }
        return c;
    }

    /// Clone an EnumVariantNode.
    clone_enum_variant(mut &this, node: EnumVariantNode*) -> EnumVariantNode* {
        mut c: EnumVariantNode* = new EnumVariantNode(node.name, node.span);
        this.copy_decl_base(node, c);
        // Deep-clone type annotations (not shallow copy)
        for (mut i: i64 = 0; i < node.associated_types.length; i++) {
            c.add_associated_type(this.clone_type_annotation(node.associated_types[i]));
        }
        c.explicit_value   = node.explicit_value;
        c.has_value        = node.has_value;
        return c;
    }

    /// Clone a single pattern node.
    clone_pattern(mut &this, pat: PatternNode*) -> PatternNode* {
        if (pat == null) { return null; }
        if (pat.pattern_kind == PatternKind::Enum) {
            return this.visit_enum_pattern(pat as EnumPatternNode*) as PatternNode*;
        }
        return this.visit_pattern(pat) as PatternNode*;
    }

    /// Clone a MatchArmNode.
    clone_match_arm(mut &this, node: MatchArmNode*) -> MatchArmNode* {
        mut c: MatchArmNode* = new MatchArmNode(node.span);
        for (mut i: i64 = 0; i < node.patterns.length; i++) {
            c.add_pattern(this.clone_pattern(node.patterns[i]));
        }
        if (node.guard != null) {
            c.set_guard(this.clone_expr(node.guard));
        }
        if (node.body != null) {
            c.set_body(this.clone_stmt(node.body));
        }
        c.has_error = node.has_error;
        return c;
    }

    /// Clone a StaticMatchArmNode (type-pattern(s) + body). An empty
    /// `type_patterns` is the wildcard `_` and clones to an empty list.
    clone_static_match_arm(mut &this, node: StaticMatchArmNode*) -> StaticMatchArmNode* {
        mut c: StaticMatchArmNode* = new StaticMatchArmNode(node.span);
        for (mut i: i64 = 0; i < node.type_patterns.length; i++) {
            c.add_type_pattern(this.clone_type_annotation(node.type_patterns[i]));
        }
        if (node.body != null) {
            c.set_body(this.clone_stmt(node.body));
        }
        c.has_error = node.has_error;
        return c;
    }

    /// Whether any of `arms` lists more than one type.
    static has_multi_type_arm(arms: &[StaticMatchArmNode*]) -> boolean {
        for (mut i: i64 = 0; i < arms.length; i++) {
            if (arms[i] != null && arms[i].type_patterns.length > 1) { return true; }
        }
        return false;
    }

    /// `arms` with each arm that lists several types split into one arm per
    /// listed type, in order, each holding its own copy of the body (the
    /// first keeps the original).  An arm is checked, and an instantiation
    /// copies it, under the one type that selects it: a body shared by
    /// several types would carry one type's answers - a method it calls,
    /// the width of an operator - into the others'.  The copies are untyped
    /// and keep the name layer's stamps, as a copy monomorphization makes.
    static split_multi_type_arms(arms: &[StaticMatchArmNode*]) -> [StaticMatchArmNode*] {
        mut out: [StaticMatchArmNode*] = [];
        for (mut i: i64 = 0; i < arms.length; i++) {
            const arm: StaticMatchArmNode* = arms[i];
            if (arm == null || arm.type_patterns.length < 2) {
                out.push(arm);
                continue;
            }
            for (mut p: i64 = 0; p < arm.type_patterns.length; p++) {
                mut one: StaticMatchArmNode* = new StaticMatchArmNode(arm.span);
                one.add_type_pattern(arm.type_patterns[p]);
                if (p == 0) {
                    one.set_body(arm.body);
                } else {
                    mut cloner: ASTCloner = ASTCloner::new();
                    one.set_body(cloner.clone_stmt(arm.body));
                }
                one.has_error = arm.has_error;
                out.push(one);
            }
        }
        return out;
    }

    visit_static_match_arm(mut &this, node: StaticMatchArmNode*) -> ASTNode* {
        return this.clone_static_match_arm(node) as ASTNode*;
    }
}
