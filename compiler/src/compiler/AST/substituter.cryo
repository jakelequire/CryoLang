/// AST Type Substituter
///
/// Walks a cloned AST and rewrites type annotations and generic name references
/// to reflect concrete type arguments.  Used after ASTCloner to transform a
/// generic declaration clone into a concrete specialization.
///
/// Example: For `Array<T>` specialized with T=i32:
///   - Named("T") annotations -> Named("i32") or Primitive("i32")
///   - StructDeclNode.name "Array" -> "Array_i32"
///   - generic_args [Named("T")] -> [Named("i32")] (via substitute_annotation)
///   - generic_params cleared (the specialization is concrete)

namespace compiler::ast::substituter;

import compiler::diag;
import compiler::ast;
import compiler::ast::{
    ArrayAnnotation, declaration, expression, FunctionAnnotation, GenericAnnotation,
    MemberPin, NamedAnnotation, node, NodeKind, pattern, PatternElement, PatternKind, PointerAnnotation,
    PrimitiveAnnotation, ProjectionAnnotation, statement, TupleAnnotation, TypeAnnotation,
    visitor
};
import compiler::types;
import compiler::types::{ arena, substitution, TypeKind };
import std::fmt;
import compiler::resolver::{ symbol_str, intern_table };
import compiler::resolver::res;
import compiler::resolver::res::{ DefId, ResSlot };
import compiler::diag::source_span;
import compiler::diag::source_span::{ SourceSpan };
import compiler::types::type_ref;
import compiler::types::type_ref::{ TypeRef };
import compiler::ast::declaration::{
    ClassDeclNode, DestructureDeclNode, EnumDeclNode, EnumVariantNode, FieldDeclNode,
    FunctionDeclNode, ImplBlockNode, MethodNode, StructDeclNode, TraitDeclNode,
    TypeAliasDeclNode, UnionDeclNode, VarDeclNode
};
import compiler::ast::expression::{
    CalleePin,
    AlignofExprNode, ArrayAccessNode, ArrayLiteralNode, AwaitExprNode, BinaryExprNode,
    CallExprNode, CastExprNode, DeleteExprNode, ExpressionNode, IdentifierNode, IfExprNode,
    LambdaExprNode, MatchExprNode, MemberAccessNode, NewExprNode, ScopeResolutionNode,
    SizeofExprNode, StaticMatchExprNode, StructLiteralNode, TernaryExprNode, TryExprNode,
    TupleLiteralNode, TypeofExprNode, UnaryExprNode, YieldExprNode
};
import compiler::ast::pattern::{
    EnumPatternNode, MatchArmNode, PatternNode, StaticMatchArmNode
};
import compiler::ast::statement::{
    AsmBlockStmtNode, AsmOperand, BlockStmtNode, DeclStmtNode, DoWhileStmtNode,
    ExprStmtNode, ForStmtNode, IfStmtNode, LoopStmtNode, MatchStmtNode, ReturnStmtNode,
    StaticMatchStmtNode, UnsafeBlockStmtNode, WhileStmtNode
};
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::symbol_id;
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::types::arena::{ TypeArena };
import compiler::ast::node::{ ASTNode };
import compiler::types::substitution::{ TypeSubstitution };
import compiler::ast::visitor::{ BaseASTVisitor };


type class ASTTypeSubstituter : BaseASTVisitor {
public:
    subst:             TypeSubstitution*;
    arena:             TypeArena*;
    intern_table:      InternTable*;
    /// The declaration being specialized, or an invalid id when the caller
    /// specializes none of its own (a method signature re-substituted under
    /// its owner's arguments, a trait default's bodies).  A written name
    /// denotes the specialization being built exactly when its stamp names
    /// this declaration.  Its spelling cannot say so: a generic function may
    /// share its name with a type, and the function's own signature and body
    /// then name the TYPE.
    template:          DefId;
    spec_name:         SymbolStr;         // "Array_i32"
    /// The symbols the parameters were declared as.  A written `T` in the
    /// cloned body carries its declaration's symbol in its stamp, and it is
    /// rewritten only when that symbol is one of these: a trait default's
    /// own `<U>` copied under an `implement<U>` keeps its `U` while the
    /// impl's is rewritten, which no comparison of spellings can do.
    param_syms:        SymbolID[];
    /// The arena id the specialization will occupy, or invalid when the caller
    /// has none.  Attached as `pre_resolved` to every annotation rewritten to
    /// `spec_name`, so a synthesized mangled name never has to be re-derived
    /// through the scope chain - which cannot answer it, because "which module
    /// is this name written in" is not a question a name the substituter just
    /// minted has.  Invalid means the annotation keeps today's by-name route.
    spec_typeref:      TypeRef;

    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    ASTTypeSubstituter(subst: TypeSubstitution*, arena: TypeArena*,
                       intern_table: InternTable*,
                       template: DefId, spec_name: SymbolStr,
                       param_syms: SymbolID[],
                       spec_typeref: TypeRef)
        : BaseASTVisitor() {
        this.subst             = subst;
        this.arena             = arena;
        this.intern_table      = intern_table;
        this.template          = template;
        this.spec_name         = spec_name;
        this.param_syms        = param_syms;
        this.spec_typeref      = spec_typeref;
    }

    /// The name a rewritten annotation carries beside its argument's
    /// TypeRef: the declaration's qualified name, or the arena's display of
    /// a type that has none.  A label for diagnostics and debug output -
    /// every annotation carrying it carries the TypeRef too, and the
    /// resolver answers with that first.
    arg_label(&this, arg: TypeRef) -> SymbolStr {
        if (this.arena.lookup(arg) == null) {
            return this.intern_table.intern(fmt::format("unknown_%llu", arg.key()));
        }
        const qname: SymbolStr = this.arena.get_qualified_name(arg);
        if (qname.is_valid()) { return qname; }
        return this.intern_table.intern(this.arena.resolve_display_name(arg));
    }

    /// Drop a callee pin, which - unlike a member pin - cannot cross a
    /// substitution.  A `CalleePin::Family` holds the minted identifier of
    /// one specialization, and a body cloned from a template carries whichever
    /// sibling specialized first: `Request::write_to<W>` calls
    /// `this.headers.write_to(writer)`, the nested `Headers::write_to<W>` is
    /// pinned to `<TcpStream>` the first time it specializes, and the clone
    /// takes that pin into `write_to<TlsStream>` - a `TlsStream*` passed to
    /// the TcpStream implementation.  The symbol is not a coordinate inside a
    /// declaration the way a field index is; until a pin names the template
    /// and the substitution instead, dropping it is the only correct answer
    /// and the monomorphizer's discovery re-infers this body's callee.  A pin
    /// leaves a clone through this door and no other.
    drop_stale_callee_pin(&this, node: CallExprNode*) -> void {
        node.set_resolved_callee(CalleePin::None);
    }

    /// Whether a path call's method node is the same in every instantiation
    /// of the body it sits in: sema bound `(Debug for Str)::fmt(&view, f)`
    /// to the generic method `fmt<W>` of `Str`, and no substitution makes
    /// that path name another declaration - only the method's own type
    /// arguments move, and `resolved_type_args` carries those.  Two things
    /// would make it another declaration: an owner the substitution reaches
    /// (a receiver that mentions a type parameter belongs to a generic
    /// owner, whose specialization holds its own copy), and a node that is
    /// already one specialization of the method (a method with no type
    /// parameters of its own left), which is a sibling's answer.
    template_path_method_crosses(&this, node: CallExprNode*) -> boolean {
        if (node.callee == null || (node.callee as ASTNode*).kind != NodeKind::ScopeResolution) { return false; }
        if (node.resolved_method == null) { return false; }
        const m: MethodNode* = node.resolved_method as MethodNode*;
        if (m.func == null || m.func.generic_params.length == 0 || m.func.parameters.length == 0) { return false; }
        const recv: VarDeclNode* = m.func.parameters[0];
        if (recv == null || !recv.is_receiver() || !recv.resolved_type.is_valid()) { return false; }
        return !this.arena.contains_generic_param(recv.resolved_type);
    }

    /// The same drop for a path's callee - see the overload above.
    drop_stale_callee_pin(&this, node: ScopeResolutionNode*) -> void {
        node.set_resolved_callee(CalleePin::None);
    }

    /// Whether a written name's stamp answers with the declaration being
    /// specialized.  An unanswered name names nothing, so it is never the
    /// template.
    names_template(&this, slot: ResSlot) -> boolean {
        if (!this.template.is_valid()) { return false; }
        return match (slot) {
            ResSlot::Answered(r) => { r.def_id().equals(this.template) }
            _                    => { false }
        };
    }

    /// Whether a path's scope segment is the declaration being specialized:
    /// the name layer stopped on it as a type, with only the member left.
    scope_names_template(&this, slot: ResSlot) -> boolean {
        if (!this.template.is_valid()) { return false; }
        match (slot) {
            ResSlot::Answered(r) => {
                match (r) {
                    res::Res::TypeRelative(b, trailing) => {
                        if (trailing != 1) { return false; }
                        return match (b) {
                            res::ResBase::Def(d) => { d.equals(this.template) }
                            _                    => { false }
                        };
                    }
                    _ => { return false; }
                }
            }
            _ => { return false; }
        }
    }

    /// The slot of the parameter `sym`, or -1 when it is none of this
    /// substitution's - including an invalid symbol, which names nothing.
    param_slot(&this, sym: SymbolID) -> i64 {
        if (!sym.is_valid()) { return -1; }
        for (mut i: i64 = 0; i < this.param_syms.length; i++) {
            if (this.param_syms[i].equals(sym)) { return i; }
        }
        return -1;
    }


    // Substitution lookup

    /// Return the TypeRef for the i-th generic param's concrete substitution.
    /// Returns the value as-is from the substitution (which may be an
    /// InstantiatedType wrapper, a Struct, a primitive, etc.). Critically,
    /// this does NOT unwrap InstantiatedType -> resolved_type: the natural
    /// resolve_generic path returns the InstantiatedType wrapper, and if
    /// pre_resolved diverged from that we'd produce two different TypeRefs
    /// for the same logical type, breaking dedup downstream and causing
    /// spurious type-mismatch errors.
    resolved_arg_typeref(&this, i: i64) -> TypeRef {
        if (this.subst == null) { return TypeRef::invalid(); }
        if (i < 0 || i >= this.subst.replacements.length) {
            return TypeRef::invalid();
        }
        return this.subst.replacements[i];
    }

    /// If `ty` is a Pointer in the arena, return its pointee TypeRef.
    /// Returns TypeRef::invalid() otherwise.  Helper for the pointer-arm
    /// of `substitute_named_annotation`, which needs the pointee to attach
    /// as `pre_resolved` on the inner Named annotation.  Delegates to the
    /// arena to keep `Type*` / `PointerType*` references out of this module.
    unwrap_pointer_pointee(&this, ty: TypeRef) -> TypeRef {
        if (!ty.is_valid()) { return TypeRef::invalid(); }
        return this.arena.pointer_pointee_of(ty);
    }


    // Type annotation substitution

    /// Substitute type parameters in a type annotation.
    /// Returns a new annotation if changes were made, or the original if not.
    substitute_annotation(ann: TypeAnnotation*) -> TypeAnnotation* {
        if (ann == null) { return null; }

        match (*ann) {
            TypeAnnotation::Named(named) => {
                return this.substitute_named_annotation(ann, named);
            }
            TypeAnnotation::Primitive(prim) => {
                // Primitives never contain generic params
                return ann;
            }
            TypeAnnotation::Pointer(ptr) => {
                // In-place: recurse into inner (cloned AST)
                this.substitute_annotation(ptr.inner);
                return ann;
            }
            TypeAnnotation::Reference(ref) => {
                this.substitute_annotation(ref.inner);
                return ann;
            }
            TypeAnnotation::Array(arr) => {
                this.substitute_annotation(arr.element);
                return ann;
            }
            TypeAnnotation::Function(func) => {
                return this.substitute_function_annotation(ann, func);
            }
            TypeAnnotation::Tuple(tup) => {
                return this.substitute_tuple_annotation(ann, tup);
            }
            TypeAnnotation::Generic(gen) => {
                return this.substitute_generic_annotation(ann, gen);
            }
            TypeAnnotation::Typeof(to) => {
                // Pass through: the operand is an opaque expression node this
                // generic-param substituter doesn't walk.  `typeof` over a
                // generic-typed operand isn't specialized (documented limit).
                return ann;
            }
            TypeAnnotation::ThisType(t) => {
                // Pass through during generic-param substitution. Phase B.1
                // resolves `This` to the implementing type using a separate
                // trait/impl-context walk; this substituter only rewrites
                // generic type parameters.
                return ann;
            }
            TypeAnnotation::ImplTrait(imp) => {
                // Recurse into each bound so `implement Iterator<T>` becomes
                // `implement Iterator<i32>` under a `T -> i32` substitution. The
                // cached `resolved` (if already inferred) is a concrete
                // TypeRef carrying the unsubstituted owner generic; return
                // inference re-runs per specialization, so leaving it as-is
                // here is safe (the lowered concrete annotation, not this
                // ImplTrait, is what survives into a specialized body).
                for (mut i: i64 = 0; i < imp.bounds.length; i++) {
                    this.substitute_annotation(imp.bounds[i]);
                }
                return ann;
            }
            TypeAnnotation::Projection(proj) => {
                // Rewrite the base under the substitution: `This::Item` keeps
                // its `This` base (resolved later by the trait/impl walk), but a
                // generic-param base `I::Item` becomes `<concrete>::Item` so the
                // projection resolves against the specialized type. The member
                // name and any cached `resolved` are dropped on clone, so this
                // re-resolves fresh per specialization.
                proj.base = this.substitute_annotation(proj.base);
                return ann;
            }
        }

    }


    // Annotation substitution helpers

    substitute_named_annotation(ann: TypeAnnotation*, named: NamedAnnotation*) -> TypeAnnotation* {
        // Associated-type projection on a generic param written as a FLAT
        // qualified name (`I::Item` - only `This::Item` is a Projection node).
        // The stamp says which parameter the path is rooted at; when it is one
        // of our substituted params, rewrite the whole thing to a `Projection`
        // over the param's concrete replacement, so a field/signature type
        // `(I::Item)->O` becomes a real projection over `IntSeq` that the
        // resolver reduces to the member type.
        const pi: i64 = this.param_slot(named.relative_param_sym());
        if (pi >= 0) {
            const nm_str: string = this.intern_table.resolve(named.name);
            const nm_len: i64 = nm_str.length() as i64;
            mut sep: i64 = -1;
            mut k: i64 = 0;
            while (k + 1 < nm_len) {
                if (nm_str[k] == ':' && nm_str[k + 1] == ':') { sep = k; break; }
                k = k + 1;
            }
            if (sep > 0) {
                const member_str: string = nm_str.substring((sep + 2) as u32, (nm_len - sep - 2) as u32);
                const member_sym: SymbolStr = this.intern_table.intern(member_str);
                const base_pre: TypeRef = this.resolved_arg_typeref(pi);
                const base_named: NamedAnnotation* = new NamedAnnotation {
                    name:         this.arg_label(base_pre),
                    span:         named.span,
                    pre_resolved: base_pre,
                    res: ResSlot::Pending,
                };
                const base_ann: TypeAnnotation* =
                    new TypeAnnotation::Named(base_named);
                const proj: ProjectionAnnotation* = new ProjectionAnnotation {
                    base:         base_ann,
                    member:       member_sym,
                    rooted_at:    named.relative_param_sym(),
                    owner_trait:  DefId::invalid(),
                    resolved:     TypeRef::invalid(),
                    span:         named.span,
                };
                *ann = TypeAnnotation::Projection(proj);
                return ann;
            }
        }

        // The parameter this annotation names, when it is one of ours.
        const i: i64 = this.param_slot(named.param_sym());
        if (i >= 0) {
            // The annotation's shape is the argument's KIND, read off the
            // arena.  Its printed text cannot say it: a function type
            // returning a pointer prints ending in `*` and one returning an
            // array ending in `[]`, and neither is a pointer or an array.
            const arg: TypeRef = this.resolved_arg_typeref(i);
            match (this.arena.kind_of(arg)) {
                // `()` has no Named form; the empty tuple is the unit.
                TypeKind::Unit => {
                    ASTTypeSubstituter::rewrite_to_unit(ann, named.span);
                    return ann;
                }
                TypeKind::Void | TypeKind::Bool | TypeKind::Int | TypeKind::Float
                | TypeKind::Char | TypeKind::String | TypeKind::Never => {
                    ASTTypeSubstituter::rewrite_to_primitive(ann, this.arg_label(arg), named.span);
                    return ann;
                }
                // The pointee carries its TypeRef: sizeof/alignof in a
                // specialized body read it, and the label names nothing the
                // specializing module can reach.
                TypeKind::Pointer => {
                    const pointee: TypeRef = this.unwrap_pointer_pointee(arg);
                    ASTTypeSubstituter::rewrite_to_pointer(
                        ann, this.intern_table.intern(this.arena.resolve_display_name(pointee)),
                        pointee, named.span);
                    return ann;
                }
                _ => {}
            }
            // A dynamic array's element carries its TypeRef, as a pointee
            // does; without it an element that is not a type in scope at the
            // specialization resolves to nothing and mangling fails.
            const element: TypeRef = this.arena.dynamic_array_element_of(arg);
            if (element.is_valid()) {
                ASTTypeSubstituter::rewrite_to_array(
                    ann, this.intern_table.intern(this.arena.resolve_display_name(element)),
                    element, named.span);
                return ann;
            }
            // Anything else stays Named, answered by the argument itself:
            // the substitution holds the TypeRef the user gave, and the
            // resolver takes `pre_resolved` before it reads the name.
            named.name = this.arg_label(arg);
            named.pre_resolved = arg;
            return ann;
        }

        // A name whose stamp is the template denotes the specialization.
        // e.g. `&this` on `Pair<T>` has annotation Reference(Named("Pair"))
        // which must become Reference(Named("Pair_string")) after substitution.
        //
        // Carries the answer with the name, exactly as the generic-param branch
        // above does.  `spec_name` is minted here and registered under the
        // TEMPLATE's module, so resolving it by name later only works while the
        // resolution context happens to be homed on that module - which makes
        // the home of every WRITTEN annotation in the clone unmovable.  The id
        // is the same one `reserve_spec_names` will publish, so this cannot fork
        // type identity.
        if (this.names_template(named.res)) {
            named.name = this.spec_name;
            if (this.spec_typeref.is_valid()) {
                named.pre_resolved = this.spec_typeref;
            }
            return ann;
        }

        return ann;
    }

    substitute_function_annotation(ann: TypeAnnotation*, func: FunctionAnnotation*) -> TypeAnnotation* {
        // In-place: recurse into params and return type (cloned AST)
        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            this.substitute_annotation(func.parameters[i]);
        }
        this.substitute_annotation(func.return_type);
        return ann;
    }

    substitute_tuple_annotation(ann: TypeAnnotation*, tup: TupleAnnotation*) -> TypeAnnotation* {
        // In-place: recurse into elements (cloned AST)
        for (mut i: i64 = 0; i < tup.elements.length; i++) {
            this.substitute_annotation(tup.elements[i]);
        }
        return ann;
    }

    substitute_generic_annotation(ann: TypeAnnotation*, gen: GenericAnnotation*) -> TypeAnnotation* {
        // A Generic is a self-reference to the outer type ONLY when its
        // base names the template AND its args (BEFORE substitution)
        // are exactly the outer type's generic param names in declaration
        // order. Without the args check, an inner generic-method's
        // signature like `cast<U> -> NonNull<U>` (declared on `NonNull<T>`)
        // would be misclassified as a self-reference: `is_named_matching_base`
        // sees `NonNull` and collapses to the spec name, dropping U entirely.
        // The spec'd cast then has return type `NonNull_<outer_T>` instead
        // of being parameterized over U, and every later `cast<V>` request
        // resolves to that wrong identity-cast sibling.
        mut is_self_type: boolean = this.is_named_matching_base(gen.base)
                                  && this.args_are_outer_param_refs(gen.args);

        if (is_self_type) {
            // Substitute the base (NonNull -> NonNull_u8) and collapse to
            // bare Named; the args are already encoded in the spec name,
            // so keeping the Generic wrapper would cause the resolver to
            // build a spurious `NonNull_u8<u8>` instantiation.
            this.substitute_annotation(gen.base);
            *ann = *gen.base;
            return ann;
        }

        // Different instantiation of the same generic (e.g. `NonNull<U>`
        // inside a `cast<U>` method on `NonNull<T>`, or an explicitly
        // re-typed `NonNull<i32>` literal). Substitute the args so any
        // references to outer params get rewritten, but leave the base
        // name alone; rewriting it to the spec name would falsely encode
        // the outer type's args.
        for (mut i: i64 = 0; i < gen.args.length; i++) {
            this.substitute_annotation(gen.args[i]);
        }
        return ann;
    }

    /// True if `args` is a leading prefix of the outer type's parameters
    /// (each `args[i]` is a `Named` stamped with `param_syms[i]`). Allows
    /// shorter arg lists so generics with defaults like `RawBuffer<T,
    /// A = GlobalAlloc>` recognise `RawBuffer<T>` (one arg) as a
    /// self-reference; the trailing defaulted positions still resolve
    /// to whatever the current spec used. Empty `args` is also a self-
    /// reference (a bare unparameterized name).
    args_are_outer_param_refs(&this, args: &TypeAnnotation*[]) -> boolean {
        if (args.length > this.param_syms.length) { return false; }
        for (mut i: i64 = 0; i < args.length; i++) {
            const a: TypeAnnotation* = args[i];
            if (a == null) { return false; }
            mut matched: boolean = false;
            match (*a) {
                TypeAnnotation::Named(named) => {
                    matched = named.param_sym().is_valid()
                        && named.param_sym().equals(this.param_syms[i]);
                }
                _ => { matched = false; }
            }
            if (!matched) { return false; }
        }
        return true;
    }

    /// Whether the annotation is a name whose stamp is the template.
    is_named_matching_base(ann: TypeAnnotation*) -> boolean {
        if (ann == null) { return false; }
        match (*ann) {
            TypeAnnotation::Named(named) => {
                return this.names_template(named.res);
            }
            _ => { return false; }
        }
    }


    // TypeAnnotation-level generic_args substitution

    /// Substitute type parameters in generic arg annotations.
    /// Delegates to substitute_annotation() for each element, preserving
    /// the full structure (pointers, arrays, nested generics, etc.).
    substitute_generic_type_args(args: &TypeAnnotation*[]) -> TypeAnnotation*[] {
        mut result: TypeAnnotation*[] = [];
        for (mut i: i64 = 0; i < args.length; i++) {
            result.push(this.substitute_annotation(args[i]));
        }
        return result;
    }


    // Declaration visitors: rename + substitute annotations

    override visit(node: StructDeclNode*) -> void {
        // Rename + generic_params clearing happen at clone time via
        // ASTCloner::for_specialization; this visitor only walks annotations.
        for (mut i: i64 = 0; i < node.fields.length; i++) {
            this.visit(node.fields[i]);
        }
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            node.methods[i].accept(this);
        }
    }

    override visit(node: UnionDeclNode*) -> void {
        // Mirror StructDeclNode: walk field/method annotations for substitution.
        for (mut i: i64 = 0; i < node.fields.length; i++) {
            this.visit(node.fields[i]);
        }
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            node.methods[i].accept(this);
        }
    }

    override visit(node: ClassDeclNode*) -> void {
        for (mut i: i64 = 0; i < node.fields.length; i++) {
            this.visit(node.fields[i]);
        }
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            node.methods[i].accept(this);
        }
    }

    override visit(node: EnumDeclNode*) -> void {
        for (mut i: i64 = 0; i < node.variants.length; i++) {
            node.variants[i].accept(this);
        }
    }

    override visit(node: EnumVariantNode*) -> void {
        // Substitute type annotations in associated types.
        // Now uses structured TypeAnnotation*; the same substitute_annotation()
        // used for fields, parameters, etc.
        for (mut i: i64 = 0; i < node.associated_types.length; i++) {
            this.substitute_annotation(node.associated_types[i]);
        }
    }

    override visit(node: FunctionDeclNode*) -> void {
        // Substitute parameter type annotations
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            this.visit(node.parameters[i]);
        }
        // Substitute return type annotation
        if (node.return_type_annotation != null) {
            this.substitute_annotation(node.return_type_annotation);
        }
        // Recurse into body - EXCEPT for self-returning trait defaults
        // (combinators like `take` returning `TakeIter<This>`).  Their bodies
        // are re-cloned and re-resolved per receiver by the monomorphizer's
        // lazy `try_instantiate_self_returning_default`; the spec'd impl copy
        // here is only used as the clone source.  The base->spec rename would
        // otherwise rewrite the combinator's OWN constructor call
        // (`TakeIter::new`) when the adapter is implemented for the adapter
        // itself (chaining `TakeIter` over a `TakeIter`), pinning the constructor to the inner spec and breaking
        // `r.take(a).take(b)`.  The signature above IS still substituted, so
        // method lookup and the per-receiver re-resolution both see the right
        // return type.
        if (node.has_body() && !node.is_self_returning_default
                && !node.is_lazy_self_growing) {
            node.body.accept(this);
        }
    }

    override visit(node: MethodNode*) -> void {
        // Delegate to function
        node.func.accept(this);
        // Substitute base_ctor_args expressions
        for (mut i: i64 = 0; i < node.base_ctor_args.length; i++) {
            node.base_ctor_args[i].accept(this);
        }
    }

    override visit(node: DestructureDeclNode*) -> void {
        if (node.type_annotation != null) {
            node.type_annotation = this.substitute_annotation(node.type_annotation);
        }
        if (node.initializer != null) {
            node.initializer.accept(this);
        }
    }

    override visit(node: ImplBlockNode*) -> void {
        if (node.trait_annotation != null) {
            this.substitute_annotation(node.trait_annotation);
        }
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            node.methods[i].accept(this);
        }
    }

    override visit(node: TypeAliasDeclNode*) -> void {
        if (node.target_annotation != null) {
            node.target_annotation = this.substitute_annotation(node.target_annotation);
        }
    }

    override visit(node: TraitDeclNode*) -> void {
        node.generic_params = [];
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            node.methods[i].accept(this);
        }
    }

    override visit(node: CastExprNode*) -> void {
        node.expression.accept(this);
        if (node.target_annotation != null) {
            node.target_annotation = this.substitute_annotation(node.target_annotation);
        }
    }


    // Expression visitors: rewrite generic_args

    override visit(node: CallExprNode*) -> void {
        node.callee.accept(this);
        for (mut i: i64 = 0; i < node.arguments.length; i++) {
            node.arguments[i].accept(this);
        }
        if (node.generic_args.length > 0) {
            node.generic_args = this.substitute_generic_type_args(node.generic_args);
        }
        // A callee pin does not cross a substitution - `drop_stale_callee_pin`
        // says why - and neither does the method node beside it, which is one
        // sibling specialization's declaration.  The monomorphizer's discovery
        // re-infers both for this body.  A path's template method on an owner
        // no substitution reaches is the exception: it names the declaration
        // this body's call specializes, in every instantiation alike.
        if (!this.template_path_method_crosses(node)) { node.resolved_method = null; }
        this.drop_stale_callee_pin(node);
        // `resolved_type_args` is sema's stash of this call's generic type-arg
        // bindings, expressed in the TEMPLATE's params (e.g. `H`/`W`).  Unlike
        // the pins above it is NEVER a stale sibling's concrete value (only sema
        // writes it, always abstractly), so substitute rather than clear:
        // applying THIS spec's subst concretizes it for this instantiation
        // (`H` -> `DefaultHasher`).  Lets the monomorphizer enqueue the call's
        // instantiation from sema's bindings without re-inferring.  A no-op on
        // an already-concrete element (subst's domain is the template params).
        if (node.resolved_type_args.length > 0 && this.subst != null) {
            mut sub_rta: TypeRef[] = [];
            for (mut i: i64 = 0; i < node.resolved_type_args.length; i++) {
                sub_rta.push(this.subst.apply(node.resolved_type_args[i], this.arena));
            }
            node.set_resolved_type_args(sub_rta);
        }
    }

    /// Generic function-reference value `name<Args>` used as a value (GAP 1):
    /// rewrite its turbofish args from outer params to the spec's concrete
    /// types (`thread_trampoline<C,T>` -> `thread_trampoline<String,String>`)
    /// so the monomorphizer's discovery walk can resolve them and pin the
    /// specialized callee. Ordinary identifiers (no turbofish) are untouched.
    override visit(node: IdentifierNode*) -> void {
        if (node.generic_args.length > 0) {
            node.generic_args = this.substitute_generic_type_args(node.generic_args);
        }
    }

    override visit(node: NewExprNode*) -> void {
        const is_self: boolean = this.names_template(node.res)
            && (node.generic_args.length == 0
                || this.args_are_outer_param_refs(node.generic_args));
        // A self-reference denotes the enclosing specialization, recorded as the
        // arena id that specialization already has rather than by rewriting the
        // spelling to the mangled spec name.  `type_name` therefore keeps what
        // the SOURCE wrote in every phase, so it cannot come to mean something
        // different from the `res` beside it, which names the DEFINITION and is
        // copied verbatim by every clone.  The id is a POINTER to the spec
        // because that is what `new` evaluates to.
        // A self-reference arriving with no reserved id has nothing left to
        // denote once the spelling is stable, and is left unresolved.
        if (is_self && this.spec_typeref.is_valid()) {
            node.set_resolved_type(this.arena.get_pointer_to(this.spec_typeref));
        }
        for (mut i: i64 = 0; i < node.arguments.length; i++) {
            node.arguments[i].accept(this);
        }
        if (node.generic_args.length > 0) {
            node.generic_args = this.substitute_generic_type_args(node.generic_args);
        }
        if (node.array_size != null) {
            node.array_size.accept(this);
        }
        if (node.struct_init != null) {
            node.struct_init.accept(this);
        }
        // A variant's ordinal is the same in every instantiation of the enum,
        // so the pin crosses the substitution; the mark records that the walk
        // over this clone did not produce it.
        node.carry_resolved_member();
    }

    override visit(node: StructLiteralNode*) -> void {
        // A self-reference denotes the enclosing specialization, and it is
        // recorded as the arena id that specialization already has - not by
        // rewriting the spelling to the mangled spec name.  `struct_type`
        // therefore keeps what the SOURCE wrote in every phase, so it cannot
        // come to mean something different from the `res` beside it, which
        // names the DEFINITION and is copied verbatim by every clone.  The id
        // is the same carrier `pre_resolved` already is for annotations.
        //
        // The collapse rule: the stamp names the template, and either no generic
        // args or args that echo the outer type's params in order.  An inner
        // generic-method literal like `NonNull<U> { ... }` inside a `cast<U>`
        // on `NonNull<T>` names the same template but is a different
        // instantiation, and freezing it at the outer spec's args binds every
        // later `cast<V>` to the wrong sibling.
        const is_self: boolean = this.names_template(node.res)
            && (node.generic_args.length == 0
                || this.args_are_outer_param_refs(node.generic_args));
        // A self-reference arriving with no reserved id has nothing left to
        // denote once the spelling is stable, and is left unresolved.
        if (is_self && this.spec_typeref.is_valid()) {
            node.set_resolved_type(this.spec_typeref);
        }
        if (node.generic_args.length > 0) {
            node.generic_args = this.substitute_generic_type_args(node.generic_args);
        }
        for (mut i: i64 = 0; i < node.field_inits.length; i++) {
            const val: ExpressionNode* = node.field_inits[i].value;
            if (val != null) {
                val.accept(this);
            }
            // A field's position in its owner is the same in every
            // instantiation, so the pin crosses the substitution.
            node.field_inits[i].pin_carried = node.field_inits[i].pin.is_some();
        }
    }

    override visit(node: ScopeResolutionNode*) -> void {
        // ScopeResolution carries TWO arg lists:
        //   * scope_generic_args: args on the scope (`Pair<T>::method`)
        //   * generic_args:       args on the method (`Pair::method<U>`)
        // Only the scope args participate in the self-type collapse.
        const is_self: boolean = this.scope_names_template(node.scope_res)
            && (node.scope_generic_args.length == 0
                || this.args_are_outer_param_refs(node.scope_generic_args));
        // True when the else-branch below retargets the scope segment at a
        // DIFFERENT declaration (a generic param bound to a concrete type),
        // which is the one rewrite a carried member pin cannot survive.
        mut rewrote_owner: boolean = false;
        if (is_self) {
            node.scope_name = this.spec_name;
            // The id beside the name, as a written annotation gets: the
            // spelling minted here is registered under the TEMPLATE's module
            // and names nothing from anywhere else.
            if (this.spec_typeref.is_valid()) {
                node.spec_owner = this.spec_typeref;
            }
        } else {
            // Substitute generic-param scope names too; `T::default()`
            // inside `fn f<T>() where T: Default` becomes `i32::default()`
            // when monomorphized with T=i32.  The stamp beside the name
            // still says `GenericParam` - a `Res` names a definition, and
            // the clone's syntax is the template's - so the arena id is
            // recorded as well: it is the only carrier of which type the
            // segment now means that is not a spelling to be looked up.
            const si: i64 = this.param_slot(node.scope_res.relative_param_sym());
            if (si >= 0) {
                rewrote_owner = true;
                const arg_ref: TypeRef = this.resolved_arg_typeref(si);
                node.scope_name = this.arg_label(arg_ref);
                if (arg_ref.is_valid()) { node.spec_owner = arg_ref; }
            }
        }
        if (node.generic_args.length > 0) {
            node.generic_args = this.substitute_generic_type_args(node.generic_args);
        }
        if (node.scope_generic_args.length > 0) {
            node.scope_generic_args = this.substitute_generic_type_args(node.scope_generic_args);
        }
        // The head's trait is a written type too (`(From<T> for P)::from`).
        if (node.impl_trait != null) {
            node.impl_trait = this.substitute_annotation(node.impl_trait);
        }
        // The same reason a call's pin is cleared: the scope segment above may
        // now name a different owner than the one the template's walk pinned
        // the function for, and sema's walk over this body pins it again.
        this.drop_stale_callee_pin(node);
        // The member pin crosses the substitution - a variant's ordinal and a
        // global's slot are the same in every instantiation - EXCEPT where the
        // branch above retargeted the scope segment at another declaration
        // (`T::m` with `T` bound to a concrete type): there the coordinates
        // belong to the old owner and name nothing in the new one.  That
        // branch runs, and no path reaching it has ever carried a member pin.
        if (rewrote_owner) {
            node.set_resolved_member(MemberPin::None);
        } else {
            node.carry_resolved_member();
        }
    }

    override visit(node: SizeofExprNode*) -> void {
        // Substitute generic params inside the operand annotation
        // (e.g., `HashMapEntry<K, V>` -> `HashMapEntry<S, j>`).
        if (node.type_ann != null) {
            this.substitute_annotation(node.type_ann);
            // The annotation now names a different type, so any resolution of
            // the old one describes the template rather than this
            // specialization. Dropped rather than kept: a stale size is a
            // wrong answer, an absent one is re-derived from the annotation.
            node.set_operand_type(TypeRef::invalid());
        }
    }

    override visit(node: AlignofExprNode*) -> void {
        if (node.type_ann != null) {
            this.substitute_annotation(node.type_ann);
            node.set_operand_type(TypeRef::invalid());
        }
    }


    override visit(node: TypeofExprNode*) -> void {
        if (node.operand != null) { node.operand.accept(this); }
    }

    override visit(node: DeleteExprNode*) -> void {
        if (node.operand != null) { node.operand.accept(this); }
    }

    override visit(node: AwaitExprNode*) -> void {
        if (node.operand != null) { node.operand.accept(this); }
    }

    override visit(node: YieldExprNode*) -> void {
        if (node.operand != null) { node.operand.accept(this); }
    }

    override visit(node: TryExprNode*) -> void {
        // Monomorphization runs before sema lowers `?`, so only `operand`
        // is populated here; recurse into `desugared` too if a post-sema
        // clone is ever substituted.
        if (node.operand != null)   { node.operand.accept(this); }
        if (node.desugared != null) { node.desugared.accept(this); }
    }


    // Statement visitors: recurse into children

    override visit(node: BlockStmtNode*) -> void {
        for (mut i: i64 = 0; i < node.statements.length; i++) {
            node.statements[i].accept(this);
        }
    }

    override visit(node: UnsafeBlockStmtNode*) -> void {
        node.block.accept(this);
    }

    override visit(node: AsmBlockStmtNode*) -> void {
        for (mut i: i64 = 0; i < node.operands.length; i++) {
            const op: AsmOperand* = node.operands[i];
            if (op != null && op.expr != null) {
                op.expr.accept(this);
            }
        }
    }

    override visit(node: ReturnStmtNode*) -> void {
        if (node.expression != null) {
            node.expression.accept(this);
        }
    }

    override visit(node: IfStmtNode*) -> void {
        node.condition.accept(this);
        node.then_stmt.accept(this);
        if (node.else_stmt != null) {
            node.else_stmt.accept(this);
        }
    }

    override visit(node: WhileStmtNode*) -> void {
        node.condition.accept(this);
        node.body.accept(this);
    }

    override visit(node: DoWhileStmtNode*) -> void {
        node.body.accept(this);
        node.condition.accept(this);
    }

    override visit(node: LoopStmtNode*) -> void {
        if (node.body != null) { node.body.accept(this); }
    }

    override visit(node: ForStmtNode*) -> void {
        if (node.init != null) { node.init.accept(this); }
        if (node.condition != null) { node.condition.accept(this); }
        if (node.update != null) { node.update.accept(this); }
        node.body.accept(this);
    }

    override visit(node: MatchStmtNode*) -> void {
        node.subject.accept(this);
        for (mut i: i64 = 0; i < node.arms.length; i++) {
            this.visit(node.arms[i]);
        }
    }

    override visit(node: StaticMatchStmtNode*) -> void {
        node.scrutinee = this.substitute_annotation(node.scrutinee);
        for (mut i: i64 = 0; i < node.arms.length; i++) {
            this.visit(node.arms[i]);
        }
    }

    /// Walk a static-match arm: rewrite the type pattern (T -> concrete) and
    /// the body. Dead arms are substituted harmlessly here; the monomorphizer
    /// prunes them before any type-checking sees them.
    override visit(arm: StaticMatchArmNode*) -> void {
        for (mut i: i64 = 0; i < arm.type_patterns.length; i++) {
            arm.type_patterns[i] = this.substitute_annotation(arm.type_patterns[i]);
        }
        if (arm.body != null) {
            arm.body.accept(this);
        }
    }

    /// Walk a match arm: visit patterns then walk the body.
    override visit(arm: MatchArmNode*) -> void {
        for (mut j: i64 = 0; j < arm.patterns.length; j++) {
            const pat: PatternNode* = arm.patterns[j];
            if (pat.pattern_kind == PatternKind::Enum) {
                this.visit(pat as EnumPatternNode*);
            }
            // Other pattern kinds have no type annotations to substitute
        }
        if (arm.body != null) {
            arm.body.accept(this);
        }
    }

    override visit(node: ExprStmtNode*) -> void {
        node.expression.accept(this);
    }

    override visit(node: DeclStmtNode*) -> void {
        node.declaration.accept(this);
    }

    // Remaining expression visitors: recurse into children

    override visit(node: BinaryExprNode*) -> void {
        node.left.accept(this);
        node.right.accept(this);
        // Rewrite the operator-overload call's stashed type-args (T -> concrete)
        // so a bounded-param `a + b` specializes to the right trait-method spec.
        if (node.desugared_call != null) { node.desugared_call.accept(this); }
    }

    override visit(node: UnaryExprNode*) -> void {
        node.operand.accept(this);
        if (node.desugared_call != null) { node.desugared_call.accept(this); }
    }

    override visit(node: TernaryExprNode*) -> void {
        node.condition.accept(this);
        node.true_expr.accept(this);
        node.false_expr.accept(this);
    }

    override visit(node: IfExprNode*) -> void {
        node.condition.accept(this);
        node.then_expr.accept(this);
        if (node.else_expr != null) {
            node.else_expr.accept(this);
        }
    }

    override visit(node: MatchExprNode*) -> void {
        node.subject.accept(this);
        for (mut i: i64 = 0; i < node.arms.length; i++) {
            this.visit(node.arms[i]);
        }
    }

    override visit(node: StaticMatchExprNode*) -> void {
        node.scrutinee = this.substitute_annotation(node.scrutinee);
        for (mut i: i64 = 0; i < node.arms.length; i++) {
            this.visit(node.arms[i]);
        }
    }

    override visit(node: ArrayLiteralNode*) -> void {
        for (mut i: i64 = 0; i < node.elements.length; i++) {
            node.elements[i].accept(this);
        }
        if (node.repeat_count_expr != null) {
            node.repeat_count_expr.accept(this);
        }
    }

    override visit(node: TupleLiteralNode*) -> void {
        for (mut i: i64 = 0; i < node.elements.length; i++) {
            node.elements[i].accept(this);
        }
    }

    override visit(node: LambdaExprNode*) -> void {
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            this.visit(node.parameters[i]);
        }
        if (node.body != null) {
            node.body.accept(this);
        }
    }

    override visit(node: ArrayAccessNode*) -> void {
        node.array.accept(this);
        node.index.accept(this);
        // Rewrite the index-overload call's stashed type-args (T -> concrete)
        // so `a[i]` on a bounded param / generic container specializes to the
        // right `Index::index` spec.
        if (node.desugared_call != null) { node.desugared_call.accept(this); }
    }

    override visit(node: MemberAccessNode*) -> void {
        node.object.accept(this);
        if (node.generic_args.length > 0) {
            node.generic_args = this.substitute_generic_type_args(node.generic_args);
        }
        // A field's position in its owner is the same in the template and in
        // every instantiation of it, so the pin crosses the substitution and
        // mono's own reads before the post-monomorphization walk
        // (`derive_receiver_type`) find it.
        node.carry_resolved_member();
    }

    override visit(node: EnumPatternNode*) -> void {
        if (this.names_template(node.res)) {
            node.enum_name = this.spec_name;
        }
        // The enum is the same declaration under another instantiation, so the
        // variant's ordinal still names the same variant.
        node.carry_resolved_member();
        // Recurse into nested sub-patterns (`Some(Some(n))`, `Branch(Leaf(x),
        // r)`) so their enum_name is substituted too. Without this, a nested
        // pattern in a generic body kept the unsubstituted (template) name.
        // Explicit kind dispatch (not accept()) to reliably reach this
        // override for a nested EnumPatternNode.
        for (mut i: i64 = 0; i < node.elements.length; i++) {
            match (node.elements[i]) {
                PatternElement::Sub(sub) => {
                    if (sub.pattern != null) {
                        const child: PatternNode* = sub.pattern as PatternNode*;
                        if (child.pattern_kind == PatternKind::Enum) {
                            this.visit(child as EnumPatternNode*);
                        }
                    }
                }
                _ => { }
            }
        }
    }

    override visit(node: VarDeclNode*) -> void {
        if (node.type_annotation != null) {
            node.type_annotation = this.substitute_annotation(node.type_annotation);
        }
        if (node.initializer != null) {
            node.initializer.accept(this);
        }
    }

    override visit(node: FieldDeclNode*) -> void {
        if (node.type_annotation != null) {
            node.type_annotation = this.substitute_annotation(node.type_annotation);
        }
        if (node.default_value != null) {
            node.default_value.accept(this);
        }
    }

    /// Rewrite a TypeAnnotation* in-place from Named to Primitive variant.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    static rewrite_to_primitive(ann: TypeAnnotation*, name: SymbolStr, span: SourceSpan) -> void {
        const prim: PrimitiveAnnotation* = new PrimitiveAnnotation { name: name, span: span };
        *ann = TypeAnnotation::Primitive(prim);
    }

    /// Rewrite a TypeAnnotation* in-place from Named to Pointer(Named(inner)).
    /// `inner_pre_resolved` is the inner type's TypeRef when known (the
    /// substituter has it from `subst.replacements[i]`'s pointee), and it is
    /// what the inner Named answers with: a rewritten spelling carries no
    /// stamp, so without it a type the reading module cannot reach by that
    /// spelling (`Entry<K,V>` inside a `Layout::array<Entry<K,V>*>` clone)
    /// resolves to nothing.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    static rewrite_to_pointer(ann: TypeAnnotation*, inner_name: SymbolStr,
                                inner_pre_resolved: TypeRef, span: SourceSpan) -> void {
        const inner_named: NamedAnnotation* = new NamedAnnotation {
            name: inner_name,
            span: span,
            pre_resolved: inner_pre_resolved,
            res: ResSlot::Pending,
        };
        const inner_ann: TypeAnnotation* = new TypeAnnotation::Named(inner_named);
        const ptr: PointerAnnotation* = new PointerAnnotation { inner: inner_ann, is_const: false, span: span };
        *ann = TypeAnnotation::Pointer(ptr);
    }

    /// Rewrite a TypeAnnotation* in-place from Named to Array(Named(inner), -1).
    /// `inner_pre_resolved` is the element type's TypeRef when known (the
    /// substituter has it from `subst.replacements[i]`'s array element). Mirrors
    /// `rewrite_to_pointer`: without it, the inner Named is resolved by bare name
    /// in a fresh empty ResolutionContext, which fails for any element that isn't a
    /// bare-name-resolvable type - e.g. a pointer element (`i32*[]`, the inner
    /// display `i32*` names no type) or a user-defined type out of scope at the
    /// spec site - yielding an `Array<invalid>` that later ICEs the mangler.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    static rewrite_to_array(ann: TypeAnnotation*, inner_name: SymbolStr,
                              inner_pre_resolved: TypeRef, span: SourceSpan) -> void {
        const inner_named: NamedAnnotation* = new NamedAnnotation {
            name: inner_name,
            span: span,
            pre_resolved: inner_pre_resolved,
            res: ResSlot::Pending,
        };
        const inner_ann: TypeAnnotation* = new TypeAnnotation::Named(inner_named);
        const arr: ArrayAnnotation* = new ArrayAnnotation {
            element: inner_ann, size: ArrayAnnotation::heap_dynamic_size(),
            size_expr: null, span: span };
        *ann = TypeAnnotation::Array(arr);
    }

    /// Rewrite a TypeAnnotation* in-place to the empty-tuple (unit) annotation.
    /// Used when a generic param is substituted with `()`, which is not a Named
    /// type and cannot survive as Named("()") through the resolver.
    static rewrite_to_unit(ann: TypeAnnotation*, span: SourceSpan) -> void {
        mut empty_elems: TypeAnnotation*[] = [];
        const tup: TupleAnnotation* = new TupleAnnotation { elements: empty_elems, span: span };
        *ann = TypeAnnotation::Tuple(tup);
    }

}
