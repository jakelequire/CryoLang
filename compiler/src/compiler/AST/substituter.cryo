/// AST Type Substituter
///
/// Walks a cloned AST and rewrites type annotations and generic name references
/// to reflect concrete type arguments.  Used after ASTCloner to transform a
/// generic declaration clone into a concrete specialization.
///
/// Example: For `Array<T>` specialized with T=i32:
///   - Named("T") annotations -> Named("i32") or Primitive("i32")
///   - StructDeclNode.name "Array" -> "Array_i32"
///   - generic_args [Named("T")] -> [Named("i32")] (via substitute_annotation)
///   - generic_params cleared (the specialization is concrete)

namespace Compiler::AST::Substituter;

import Compiler::Diag;
import Compiler::AST;
import Compiler::Types::Arena;
import Compiler::Resolver::SymbolStr;
import Compiler::AST::Node;
import Compiler::AST::Expression;
import Compiler::AST::Statement;
import Compiler::AST::Declaration;
import Compiler::AST::Pattern;
import Compiler::AST::Visitor;
import Compiler::Types;
import Compiler::Types::Substitution;
import Compiler::Resolver::InternTable;


/// Check if a type name string is a primitive type name.
/// Used by the substituter to produce Primitive annotations instead of
/// Named("i32") when a generic param is substituted with a primitive.
function is_primitive_type_name(name: string) -> boolean {
    return intrinsics::strcmp(name, "void") == 0
        || intrinsics::strcmp(name, "boolean") == 0
        || intrinsics::strcmp(name, "char") == 0
        || intrinsics::strcmp(name, "string") == 0
        || intrinsics::strcmp(name, "i8") == 0
        || intrinsics::strcmp(name, "i16") == 0
        || intrinsics::strcmp(name, "i32") == 0
        || intrinsics::strcmp(name, "i64") == 0
        || intrinsics::strcmp(name, "i128") == 0
        || intrinsics::strcmp(name, "u8") == 0
        || intrinsics::strcmp(name, "u16") == 0
        || intrinsics::strcmp(name, "u32") == 0
        || intrinsics::strcmp(name, "u64") == 0
        || intrinsics::strcmp(name, "u128") == 0
        || intrinsics::strcmp(name, "usize") == 0
        || intrinsics::strcmp(name, "f32") == 0
        || intrinsics::strcmp(name, "f64") == 0
        || intrinsics::strcmp(name, "never") == 0;
}

/// Rewrite a TypeAnnotation* in-place from Named to Primitive variant.
function rewrite_to_primitive(ann: TypeAnnotation*, name: SymbolStr, span: SourceSpan) -> void {
    const prim: PrimitiveAnnotation* = new PrimitiveAnnotation { name: name, span: span };
    *ann = TypeAnnotation::Primitive(prim);
}

/// Rewrite a TypeAnnotation* in-place from Named to Pointer(Named(inner)).
/// `inner_pre_resolved` is the inner type's TypeRef when known (the
/// substituter has it from `subst.replacements[i]`'s pointee). Without it,
/// `resolve_sizeof_operand_type` resolves the inner Named by name with a
/// fresh empty ResolutionContext, which fails for any user-defined type
/// the call-site can't reach by bare name (e.g. `Entry<K,V>` from inside
/// the `Layout::array<Entry<K,V>*>` spec'd body (no scope, no imports),
/// and `codegen_sizeof` then falls through to 0.
function rewrite_to_pointer(ann: TypeAnnotation*, inner_name: SymbolStr,
                            inner_pre_resolved: TypeRef, span: SourceSpan) -> void {
    const inner_named: NamedAnnotation* = new NamedAnnotation {
        name: inner_name,
        span: span,
        pre_resolved: inner_pre_resolved,
    };
    const inner_ann: TypeAnnotation* = intrinsics::malloc(sizeof(TypeAnnotation)) as TypeAnnotation*;
    *inner_ann = TypeAnnotation::Named(inner_named);
    const ptr: PointerAnnotation* = new PointerAnnotation { inner: inner_ann, span: span };
    *ann = TypeAnnotation::Pointer(ptr);
}

/// Rewrite a TypeAnnotation* in-place from Named to Array(Named(inner), -1).
function rewrite_to_array(ann: TypeAnnotation*, inner_name: SymbolStr, span: SourceSpan) -> void {
    const inner_named: NamedAnnotation* = new NamedAnnotation {
        name: inner_name,
        span: span,
        pre_resolved: TypeRef::invalid(),
    };
    const inner_ann: TypeAnnotation* = intrinsics::malloc(sizeof(TypeAnnotation)) as TypeAnnotation*;
    *inner_ann = TypeAnnotation::Named(inner_named);
    const arr: ArrayAnnotation* = new ArrayAnnotation {
        element: inner_ann, size: ArrayAnnotation::heap_dynamic_size(), span: span };
    *ann = TypeAnnotation::Array(arr);
}

/// Rewrite a TypeAnnotation* in-place to the empty-tuple (unit) annotation.
/// Used when a generic param is substituted with `()`, which is not a Named
/// type and cannot survive as Named("()") through the resolver.
function rewrite_to_unit(ann: TypeAnnotation*, span: SourceSpan) -> void {
    mut empty_elems: TypeAnnotation*[] = [];
    const tup: TupleAnnotation* = new TupleAnnotation { elements: empty_elems, span: span };
    *ann = TypeAnnotation::Tuple(tup);
}

type class ASTTypeSubstituter : BaseASTVisitor {
public:
    subst:             TypeSubstitution*;
    arena:             TypeArena*;
    intern_table:      InternTable*;
    base_name:         SymbolStr;         // "Array"
    spec_name:         SymbolStr;         // "Array_i32"
    param_names:       SymbolStr[];       // ["T"]
    type_arg_displays: SymbolStr[];       // ["i32"]

    ASTTypeSubstituter(subst: TypeSubstitution*, arena: TypeArena*,
                       intern_table: InternTable*,
                       base_name: SymbolStr, spec_name: SymbolStr,
                       param_names: SymbolStr[], type_arg_displays: SymbolStr[])
        : BaseASTVisitor() {
        this.subst             = subst;
        this.arena             = arena;
        this.intern_table      = intern_table;
        this.base_name         = base_name;
        this.spec_name         = spec_name;
        this.param_names       = param_names;
        this.type_arg_displays = type_arg_displays;
    }


    // Substitution lookup

    /// Return the TypeRef for the i-th generic param's concrete substitution.
    /// Returns the value as-is from the substitution (which may be an
    /// InstantiatedType wrapper, a Struct, a primitive, etc.). Critically,
    /// this does NOT unwrap InstantiatedType -> resolved_type: the natural
    /// resolve_generic path returns the InstantiatedType wrapper, and if
    /// pre_resolved diverged from that we'd produce two different TypeRefs
    /// for the same logical type, breaking dedup downstream and causing
    /// spurious type-mismatch errors.
    resolved_arg_typeref(&this, i: i64) -> TypeRef {
        if (this.subst == null) { return TypeRef::invalid(); }
        if (i < 0 || i >= this.subst.replacements.length) {
            return TypeRef::invalid();
        }
        return this.subst.replacements[i];
    }

    /// If `ty` is a Pointer in the arena, return its pointee TypeRef.
    /// Returns TypeRef::invalid() otherwise.  Helper for the pointer-arm
    /// of `substitute_named_annotation`, which needs the pointee to attach
    /// as `pre_resolved` on the inner Named annotation.  Delegates to the
    /// arena to keep `Type*` / `PointerType*` references out of this module.
    unwrap_pointer_pointee(&this, ty: TypeRef) -> TypeRef {
        if (!ty.is_valid()) { return TypeRef::invalid(); }
        return this.arena.pointer_pointee_of(ty.id);
    }


    // Type annotation substitution

    /// Substitute type parameters in a type annotation.
    /// Returns a new annotation if changes were made, or the original if not.
    substitute_annotation(ann: TypeAnnotation*) -> TypeAnnotation* {
        if (ann == null) { return null; }

        match (*ann) {
            TypeAnnotation::Named(named) => {
                return this.substitute_named_annotation(ann, named);
            }
            TypeAnnotation::Primitive(prim) => {
                // Primitives never contain generic params
                return ann;
            }
            TypeAnnotation::Pointer(ptr) => {
                // In-place: recurse into inner (cloned AST)
                this.substitute_annotation(ptr.inner);
                return ann;
            }
            TypeAnnotation::Reference(ref) => {
                this.substitute_annotation(ref.inner);
                return ann;
            }
            TypeAnnotation::Array(arr) => {
                this.substitute_annotation(arr.element);
                return ann;
            }
            TypeAnnotation::Optional(opt) => {
                this.substitute_annotation(opt.inner);
                return ann;
            }
            TypeAnnotation::Function(func) => {
                return this.substitute_function_annotation(ann, func);
            }
            TypeAnnotation::Tuple(tup) => {
                return this.substitute_tuple_annotation(ann, tup);
            }
            TypeAnnotation::Generic(gen) => {
                return this.substitute_generic_annotation(ann, gen);
            }
            TypeAnnotation::Typeof(to) => {
                // Pass through: the operand is an opaque expression node this
                // generic-param substituter doesn't walk.  `typeof` over a
                // generic-typed operand isn't specialized (documented limit).
                return ann;
            }
            TypeAnnotation::ThisType(t) => {
                // Pass through during generic-param substitution. Phase B.1
                // resolves `This` to the implementing type using a separate
                // trait/impl-context walk; this substituter only rewrites
                // generic type parameters.
                return ann;
            }
            TypeAnnotation::ImplTrait(imp) => {
                // Recurse into each bound so `implement Iterator<T>` becomes
                // `implement Iterator<i32>` under a `T -> i32` substitution. The
                // cached `resolved` (if already inferred) is a concrete
                // TypeRef carrying the unsubstituted owner generic; return
                // inference re-runs per specialization, so leaving it as-is
                // here is safe (the lowered concrete annotation, not this
                // ImplTrait, is what survives into a specialized body).
                for (mut i: i64 = 0; i < imp.bounds.length; i++) {
                    this.substitute_annotation(imp.bounds[i]);
                }
                return ann;
            }
        }

        return ann;
    }


    // Annotation substitution helpers

    substitute_named_annotation(ann: TypeAnnotation*, named: NamedAnnotation*) -> TypeAnnotation* {
        // Check if this named annotation is one of our generic params.
        for (mut i: i64 = 0; i < this.param_names.length; i++) {
            if (named.name.equals(this.param_names[i])) {
                // Instead of blindly setting named.name (which produces
                // Named("i32"), Named("void*"), Named("Foo[]") that the
                // resolver must parse), produce the correct annotation kind.
                const display: string = this.intern_table.resolve(this.type_arg_displays[i]);
                const display_len: i64 = intrinsics::strlen(display) as i64;

                // Unit type `()` has no Named form; it must become an empty Tuple
                // annotation so resolve_tuple produces a valid unit TypeRef.
                if (display_len == 2 && display[0] == '(' && display[1] == ')') {
                    rewrite_to_unit(ann, named.span);
                    return ann;
                }
                // Primitive type? -> Primitive annotation
                if (is_primitive_type_name(display)) {
                    rewrite_to_primitive(ann, this.type_arg_displays[i], named.span);
                    return ann;
                }
                // Pointer suffix? -> Pointer(Named(inner))
                if (display_len > 1 && display[display_len - 1] == '*') {
                    const inner_str: string = display.substr(0, display_len - 1);
                    const inner_sym: SymbolStr = this.intern_table.intern(inner_str);
                    // Unwrap one Pointer level off the substitution arg so
                    // the inner Named gets a pre_resolved TypeRef. Critical
                    // for sizeof/alignof in spec'd bodies; without it the
                    // resolver falls back to bare-name lookup and fails for
                    // any user-defined type not in scope at the spec site.
                    const inner_pre: TypeRef = this.unwrap_pointer_pointee(
                        this.resolved_arg_typeref(i));
                    rewrite_to_pointer(ann, inner_sym, inner_pre, named.span);
                    return ann;
                }
                // Array suffix? -> Array(Named(inner), -1)
                if (display_len > 2 && display[display_len - 2] == '[' && display[display_len - 1] == ']') {
                    const inner_str: string = display.substr(0, display_len - 2);
                    const inner_sym: SymbolStr = this.intern_table.intern(inner_str);
                    rewrite_to_array(ann, inner_sym, named.span);
                    return ann;
                }
                // User-defined type: keep as Named with new name, and attach
                // the pre-resolved TypeRef so the resolver doesn't need to
                // re-derive it from the (potentially very long) mangled spec
                // name. The substituter owns the answer here: subst.replacements[i]
                // is the concrete TypeRef the user gave for this generic param.
                // If it's still wrapped in InstantiatedType, follow through to
                // the resolved struct/enum/class so resolve_named's caller sees
                // a usable type immediately.
                named.name = this.type_arg_displays[i];
                named.pre_resolved = this.resolved_arg_typeref(i);
                return ann;
            }
        }

        // Rewrite the base type name to the specialized name.
        // e.g. `&this` on `Pair<T>` has annotation Reference(Named("Pair"))
        // which must become Reference(Named("Pair_string")) after substitution.
        if (named.name.equals(this.base_name)) {
            named.name = this.spec_name;
            return ann;
        }

        return ann;
    }

    substitute_function_annotation(ann: TypeAnnotation*, func: FunctionAnnotation*) -> TypeAnnotation* {
        // In-place: recurse into params and return type (cloned AST)
        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            this.substitute_annotation(func.parameters[i]);
        }
        this.substitute_annotation(func.return_type);
        return ann;
    }

    substitute_tuple_annotation(ann: TypeAnnotation*, tup: TupleAnnotation*) -> TypeAnnotation* {
        // In-place: recurse into elements (cloned AST)
        for (mut i: i64 = 0; i < tup.elements.length; i++) {
            this.substitute_annotation(tup.elements[i]);
        }
        return ann;
    }

    substitute_generic_annotation(ann: TypeAnnotation*, gen: GenericAnnotation*) -> TypeAnnotation* {
        // A Generic is a self-reference to the outer type ONLY when its
        // base name matches base_name AND its args (BEFORE substitution)
        // are exactly the outer type's generic param names in declaration
        // order. Without the args check, an inner generic-method's
        // signature like `cast<U> -> NonNull<U>` (declared on `NonNull<T>`)
        // would be misclassified as a self-reference: `is_named_matching_base`
        // sees `NonNull` and collapses to the spec name, dropping U entirely.
        // The spec'd cast then has return type `NonNull_<outer_T>` instead
        // of being parameterized over U, and every later `cast<V>` request
        // resolves to that wrong identity-cast sibling.
        mut is_self_type: boolean = this.is_named_matching_base(gen.base)
                                  && this.args_are_outer_param_refs(gen.args);

        if (is_self_type) {
            // Substitute the base (NonNull -> NonNull_u8) and collapse to
            // bare Named; the args are already encoded in the spec name,
            // so keeping the Generic wrapper would cause the resolver to
            // build a spurious `NonNull_u8<u8>` instantiation.
            this.substitute_annotation(gen.base);
            *ann = *gen.base;
            return ann;
        }

        // Different instantiation of the same generic (e.g. `NonNull<U>`
        // inside a `cast<U>` method on `NonNull<T>`, or an explicitly
        // re-typed `NonNull<i32>` literal). Substitute the args so any
        // references to outer params get rewritten, but leave the base
        // name alone; rewriting it to the spec name would falsely encode
        // the outer type's args.
        for (mut i: i64 = 0; i < gen.args.length; i++) {
            this.substitute_annotation(gen.args[i]);
        }
        return ann;
    }

    /// True if `args` is a leading prefix of the outer type's param
    /// names (each `args[i]` is exactly `Named(param_names[i])`). Allows
    /// shorter arg lists so generics with defaults like `RawBuffer<T,
    /// A = GlobalAlloc>` recognise `RawBuffer<T>` (one arg) as a
    /// self-reference; the trailing defaulted positions still resolve
    /// to whatever the current spec used. Empty `args` is also a self-
    /// reference (a bare unparameterized name).
    args_are_outer_param_refs(&this, args: &TypeAnnotation*[]) -> boolean {
        if (args.length > this.param_names.length) { return false; }
        for (mut i: i64 = 0; i < args.length; i++) {
            const a: TypeAnnotation* = args[i];
            if (a == null) { return false; }
            mut matched: boolean = false;
            match (*a) {
                TypeAnnotation::Named(named) => {
                    matched = named.name.equals(this.param_names[i]);
                }
                _ => { matched = false; }
            }
            if (!matched) { return false; }
        }
        return true;
    }

    /// Helper: returns true if the annotation is Named(base_name).
    is_named_matching_base(ann: TypeAnnotation*) -> boolean {
        if (ann == null) { return false; }
        match (*ann) {
            TypeAnnotation::Named(named) => {
                return named.name.equals(this.base_name);
            }
            _ => { return false; }
        }
        return false;
    }


    // TypeAnnotation-level generic_args substitution

    /// Substitute type parameters in generic arg annotations.
    /// Delegates to substitute_annotation() for each element, preserving
    /// the full structure (pointers, arrays, nested generics, etc.).
    substitute_generic_type_args(args: &TypeAnnotation*[]) -> TypeAnnotation*[] {
        mut result: TypeAnnotation*[] = [];
        for (mut i: i64 = 0; i < args.length; i++) {
            result.push(this.substitute_annotation(args[i]));
        }
        return result;
    }


    // Declaration visitors: rename + substitute annotations

    override visit(node: StructDeclNode*) -> void {
        // Rename + generic_params clearing happen at clone time via
        // ASTCloner::for_specialization; this visitor only walks annotations.
        for (mut i: i64 = 0; i < node.fields.length; i++) {
            this.visit(node.fields[i]);
        }
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            node.methods[i].accept(this);
        }
    }

    override visit(node: ClassDeclNode*) -> void {
        for (mut i: i64 = 0; i < node.fields.length; i++) {
            this.visit(node.fields[i]);
        }
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            node.methods[i].accept(this);
        }
    }

    override visit(node: EnumDeclNode*) -> void {
        for (mut i: i64 = 0; i < node.variants.length; i++) {
            node.variants[i].accept(this);
        }
    }

    override visit(node: EnumVariantNode*) -> void {
        // Substitute type annotations in associated types.
        // Now uses structured TypeAnnotation*; the same substitute_annotation()
        // used for fields, parameters, etc.
        for (mut i: i64 = 0; i < node.associated_types.length; i++) {
            this.substitute_annotation(node.associated_types[i]);
        }
    }

    override visit(node: FunctionDeclNode*) -> void {
        // Substitute parameter type annotations
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            this.visit(node.parameters[i]);
        }
        // Substitute return type annotation
        if (node.return_type_annotation != null) {
            this.substitute_annotation(node.return_type_annotation);
        }
        // Recurse into body - EXCEPT for self-returning trait defaults
        // (combinators like `take` returning `TakeIter<This>`).  Their bodies
        // are re-cloned and re-resolved per receiver by the monomorphizer's
        // lazy `try_instantiate_self_returning_default`; the spec'd impl copy
        // here is only used as the clone source.  The base->spec rename would
        // otherwise rewrite the combinator's OWN constructor call
        // (`TakeIter::new`) when the adapter is implemented for a type whose
        // base name collides with the adapter's (chaining `TakeIter` over a
        // `TakeIter`), pinning the constructor to the inner spec and breaking
        // `r.take(a).take(b)`.  The signature above IS still substituted, so
        // method lookup and the per-receiver re-resolution both see the right
        // return type.
        if (node.has_body() && !node.is_self_returning_default) {
            node.body.accept(this);
        }
    }

    override visit(node: MethodNode*) -> void {
        // Delegate to function
        node.func.accept(this);
        // Substitute base_ctor_args expressions
        for (mut i: i64 = 0; i < node.base_ctor_args.length; i++) {
            node.base_ctor_args[i].accept(this);
        }
    }

    override visit(node: DestructureDeclNode*) -> void {
        if (node.type_annotation != null) {
            node.type_annotation = this.substitute_annotation(node.type_annotation);
        }
        if (node.initializer != null) {
            node.initializer.accept(this);
        }
    }

    override visit(node: ImplBlockNode*) -> void {
        if (node.trait_annotation != null) {
            this.substitute_annotation(node.trait_annotation);
        }
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            node.methods[i].accept(this);
        }
    }

    override visit(node: TypeAliasDeclNode*) -> void {
        if (node.target_annotation != null) {
            node.target_annotation = this.substitute_annotation(node.target_annotation);
        }
    }

    override visit(node: TraitDeclNode*) -> void {
        node.generic_params = [];
        for (mut i: i64 = 0; i < node.methods.length; i++) {
            node.methods[i].accept(this);
        }
    }

    override visit(node: CastExprNode*) -> void {
        node.expression.accept(this);
        if (node.target_annotation != null) {
            node.target_annotation = this.substitute_annotation(node.target_annotation);
        }
    }


    // Expression visitors: rewrite generic_args

    override visit(node: CallExprNode*) -> void {
        node.callee.accept(this);
        for (mut i: i64 = 0; i < node.arguments.length; i++) {
            node.arguments[i].accept(this);
        }
        if (node.generic_args.length > 0) {
            node.generic_args = this.substitute_generic_type_args(node.generic_args);
        }
        // Specialization changes the concrete types of this call's receiver
        // and arguments, so a `resolved_callee` / `resolved_method` pinned for
        // the pre-substitution template (or copied by the cloner from a SIBLING
        // specialization) is stale for THIS instantiation.  The classic break:
        // `Request::write_to<W>` calls `this.headers.write_to(writer)`; the
        // nested `Headers::write_to<W>` got pinned to `<TcpStream>` the first
        // time `write_to` specialized, and the cloner copies that pin into
        // every later `write_to<S>` body - so `write_to<TlsStream>` wrongly
        // calls `Headers::write_to<TcpStream>` (passing a `TlsStream*` to the
        // TcpStream impl: garbage fd, EBADF, plaintext on the wire).  Clear the
        // pins so the monomorphizer's discovery re-infers the right spec for
        // this body; codegen's resolver re-derives any discovery doesn't pin.
        node.resolved_method = null;
        node.set_resolved_callee(SymbolStr::empty());
    }

    /// Generic function-reference value `name<Args>` used as a value (GAP 1):
    /// rewrite its turbofish args from outer params to the spec's concrete
    /// types (`thread_trampoline<C,T>` -> `thread_trampoline<String,String>`)
    /// so the monomorphizer's discovery walk can resolve them and pin the
    /// specialized callee. Ordinary identifiers (no turbofish) are untouched.
    override visit(node: IdentifierNode*) -> void {
        if (node.generic_args.length > 0) {
            node.generic_args = this.substitute_generic_type_args(node.generic_args);
        }
    }

    override visit(node: NewExprNode*) -> void {
        const is_self: boolean = node.type_name.equals(this.base_name)
            && (node.generic_args.length == 0
                || this.args_are_outer_param_refs(node.generic_args));
        if (is_self) {
            node.type_name = this.spec_name;
        }
        for (mut i: i64 = 0; i < node.arguments.length; i++) {
            node.arguments[i].accept(this);
        }
        if (node.generic_args.length > 0) {
            node.generic_args = this.substitute_generic_type_args(node.generic_args);
        }
        if (node.array_size != null) {
            node.array_size.accept(this);
        }
        if (node.struct_init != null) {
            node.struct_init.accept(this);
        }
    }

    override visit(node: StructLiteralNode*) -> void {
        // Only collapse to the spec name when this literal is a true
        // self-reference: same base, and either no generic args or args
        // that exactly echo the outer type's params in order. An inner
        // generic-method literal like `NonNull<U> { ... }` inside a
        // `cast<U>` on `NonNull<T>` shares the base name but is a
        // different instantiation; renaming `NonNull` to `NonNull_u8`
        // would falsely freeze the literal at the outer spec's args.
        const is_self: boolean = node.struct_type.equals(this.base_name)
            && (node.generic_args.length == 0
                || this.args_are_outer_param_refs(node.generic_args));
        if (is_self) {
            node.struct_type = this.spec_name;
        }
        if (node.generic_args.length > 0) {
            node.generic_args = this.substitute_generic_type_args(node.generic_args);
        }
        for (mut i: i64 = 0; i < node.field_inits.length; i++) {
            const val: ExpressionNode* = node.field_inits[i].value;
            if (val != null) {
                val.accept(this);
            }
        }
    }

    override visit(node: ScopeResolutionNode*) -> void {
        // ScopeResolution carries TWO arg lists:
        //   * scope_generic_args: args on the scope (`Pair<T>::method`)
        //   * generic_args:       args on the method (`Pair::method<U>`)
        // Only the scope args participate in the self-type collapse.
        const is_self: boolean = node.scope_name.equals(this.base_name)
            && (node.scope_generic_args.length == 0
                || this.args_are_outer_param_refs(node.scope_generic_args));
        if (is_self) {
            node.scope_name = this.spec_name;
        } else {
            // Substitute generic-param scope names too; `T::default()`
            // inside `fn f<T>() where T: Default` becomes `i32::default()`
            // when monomorphized with T=i32.  Without this, the spec's
            // body still names `T`, sema's static-call resolver finds
            // no matching type/trait, and emits E0233.
            for (mut i: i64 = 0; i < this.param_names.length; i++) {
                if (node.scope_name.equals(this.param_names[i])) {
                    node.scope_name = this.type_arg_displays[i];
                    break;
                }
            }
        }
        if (node.generic_args.length > 0) {
            node.generic_args = this.substitute_generic_type_args(node.generic_args);
        }
        if (node.scope_generic_args.length > 0) {
            node.scope_generic_args = this.substitute_generic_type_args(node.scope_generic_args);
        }
    }

    override visit(node: SizeofExprNode*) -> void {
        for (mut i: i64 = 0; i < this.param_names.length; i++) {
            if (node.type_name.equals(this.param_names[i])) {
                node.type_name = this.type_arg_displays[i];
                break;
            }
        }
        if (node.type_name.equals(this.base_name)) {
            node.type_name = this.spec_name;
        }
        // Recursively substitute generic params inside the full type
        // annotation (e.g., `HashMapEntry<K, V>` -> `HashMapEntry<S, j>`).
        if (node.type_ann != null) {
            this.substitute_annotation(node.type_ann);
        }
    }

    override visit(node: AlignofExprNode*) -> void {
        for (mut i: i64 = 0; i < this.param_names.length; i++) {
            if (node.type_name.equals(this.param_names[i])) {
                node.type_name = this.type_arg_displays[i];
                break;
            }
        }
        if (node.type_name.equals(this.base_name)) {
            node.type_name = this.spec_name;
        }
        if (node.type_ann != null) {
            this.substitute_annotation(node.type_ann);
        }
    }


    override visit(node: TypeofExprNode*) -> void {
        if (node.operand != null) { node.operand.accept(this); }
    }

    override visit(node: DeleteExprNode*) -> void {
        if (node.operand != null) { node.operand.accept(this); }
    }

    override visit(node: AwaitExprNode*) -> void {
        if (node.operand != null) { node.operand.accept(this); }
    }

    override visit(node: YieldExprNode*) -> void {
        if (node.operand != null) { node.operand.accept(this); }
    }

    override visit(node: TryExprNode*) -> void {
        // Monomorphization runs before sema lowers `?`, so only `operand`
        // is populated here; recurse into `desugared` too if a post-sema
        // clone is ever substituted.
        if (node.operand != null)   { node.operand.accept(this); }
        if (node.desugared != null) { node.desugared.accept(this); }
    }


    // Statement visitors: recurse into children

    override visit(node: BlockStmtNode*) -> void {
        for (mut i: i64 = 0; i < node.statements.length; i++) {
            node.statements[i].accept(this);
        }
    }

    override visit(node: UnsafeBlockStmtNode*) -> void {
        node.block.accept(this);
    }

    override visit(node: ReturnStmtNode*) -> void {
        if (node.expression != null) {
            node.expression.accept(this);
        }
    }

    override visit(node: IfStmtNode*) -> void {
        node.condition.accept(this);
        node.then_stmt.accept(this);
        if (node.else_stmt != null) {
            node.else_stmt.accept(this);
        }
    }

    override visit(node: WhileStmtNode*) -> void {
        node.condition.accept(this);
        node.body.accept(this);
    }

    override visit(node: DoWhileStmtNode*) -> void {
        node.body.accept(this);
        node.condition.accept(this);
    }

    override visit(node: LoopStmtNode*) -> void {
        if (node.body != null) { node.body.accept(this); }
    }

    override visit(node: ForStmtNode*) -> void {
        if (node.init != null) { node.init.accept(this); }
        if (node.condition != null) { node.condition.accept(this); }
        if (node.update != null) { node.update.accept(this); }
        node.body.accept(this);
    }

    override visit(node: MatchStmtNode*) -> void {
        node.subject.accept(this);
        for (mut i: i64 = 0; i < node.arms.length; i++) {
            this.visit(node.arms[i]);
        }
    }

    /// Walk a match arm: visit patterns then walk the body.
    override visit(arm: MatchArmNode*) -> void {
        for (mut j: i64 = 0; j < arm.patterns.length; j++) {
            const pat: PatternNode* = arm.patterns[j];
            if (pat.pattern_kind == PatternKind::Enum) {
                this.visit(pat as EnumPatternNode*);
            }
            // Other pattern kinds have no type annotations to substitute
        }
        if (arm.body != null) {
            arm.body.accept(this);
        }
    }

    override visit(node: SwitchStmtNode*) -> void {
        node.expression.accept(this);
        for (mut i: i64 = 0; i < node.cases.length; i++) {
            node.cases[i].accept(this);
        }
    }

    override visit(node: CaseStmtNode*) -> void {
        if (node.value != null) { node.value.accept(this); }
        node.body.accept(this);
    }

    override visit(node: ExprStmtNode*) -> void {
        node.expression.accept(this);
    }

    override visit(node: DeclStmtNode*) -> void {
        node.declaration.accept(this);
    }

    // Remaining expression visitors: recurse into children

    override visit(node: BinaryExprNode*) -> void {
        node.left.accept(this);
        node.right.accept(this);
    }

    override visit(node: UnaryExprNode*) -> void {
        node.operand.accept(this);
    }

    override visit(node: TernaryExprNode*) -> void {
        node.condition.accept(this);
        node.true_expr.accept(this);
        node.false_expr.accept(this);
    }

    override visit(node: IfExprNode*) -> void {
        node.condition.accept(this);
        node.then_expr.accept(this);
        if (node.else_expr != null) {
            node.else_expr.accept(this);
        }
    }

    override visit(node: MatchExprNode*) -> void {
        node.subject.accept(this);
        for (mut i: i64 = 0; i < node.arms.length; i++) {
            this.visit(node.arms[i]);
        }
    }

    override visit(node: ArrayLiteralNode*) -> void {
        for (mut i: i64 = 0; i < node.elements.length; i++) {
            node.elements[i].accept(this);
        }
        // Substitute element_type string (element_type stays string, resolve SymbolStr for comparison)
        for (mut i: i64 = 0; i < this.param_names.length; i++) {
            if (node.element_type == this.intern_table.resolve(this.param_names[i])) {
                node.element_type = this.intern_table.resolve(this.type_arg_displays[i]);
                break;
            }
        }
        if (node.repeat_count_expr != null) {
            node.repeat_count_expr.accept(this);
        }
    }

    override visit(node: TupleLiteralNode*) -> void {
        for (mut i: i64 = 0; i < node.elements.length; i++) {
            node.elements[i].accept(this);
        }
    }

    override visit(node: LambdaExprNode*) -> void {
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            this.visit(node.parameters[i]);
        }
        if (node.body != null) {
            node.body.accept(this);
        }
    }

    override visit(node: ArrayAccessNode*) -> void {
        node.array.accept(this);
        node.index.accept(this);
    }

    override visit(node: MemberAccessNode*) -> void {
        node.object.accept(this);
        if (node.generic_args.length > 0) {
            node.generic_args = this.substitute_generic_type_args(node.generic_args);
        }
    }

    override visit(node: MatchArmNode*) -> void {
        for (mut i: i64 = 0; i < node.patterns.length; i++) {
            node.patterns[i].accept(this);
        }
        if (node.body != null) {
            node.body.accept(this);
        }
    }

    override visit(node: EnumPatternNode*) -> void {
        if (node.enum_name.equals(this.base_name)) {
            node.enum_name = this.spec_name;
        }
    }

    override visit(node: VarDeclNode*) -> void {
        if (node.type_annotation != null) {
            node.type_annotation = this.substitute_annotation(node.type_annotation);
        }
        if (node.initializer != null) {
            node.initializer.accept(this);
        }
    }

    override visit(node: FieldDeclNode*) -> void {
        if (node.type_annotation != null) {
            node.type_annotation = this.substitute_annotation(node.type_annotation);
        }
        if (node.default_value != null) {
            node.default_value.accept(this);
        }
    }
}
