/// AST Position Lookup
///
/// `find_innermost_node_at(root, line, character)` walks the AST and
/// returns the deepest `ASTNode*` whose `span` covers (line, character),
/// or `null` when no node matches.  Both inputs are 1-based to match
/// the compiler's `SourceSpan` convention; LSP callers convert their
/// 0-based positions before invoking.
///
/// Dispatch is by `NodeKind` rather than the visitor pattern.  The
/// visitor needs ~50 method overrides per concrete walker; this file
/// recurses inline through the children that actually exist for each
/// kind, which keeps the walk in one place.  Kinds with no children
/// (Identifier, Literal, the various leaf statements) terminate the
/// recursion automatically — `descend` returns null and the caller
/// keeps the current node as the innermost match.
///
/// "Innermost" semantics: we descend into the FIRST child whose span
/// covers the cursor.  Two siblings with overlapping spans is normally
/// a parser bug; if it happens, we pick the leftmost one.
namespace Compiler::AST::NodeLocator;

import Compiler::AST;
import Compiler::AST::Node;
import Compiler::AST::Expression;
import Compiler::AST::Statement;
import Compiler::AST::Declaration;
import Compiler::Diag::SourceSpan;
import Compiler::ModuleGraph;
import Compiler::Resolver::SymbolStr;
import Compiler::Resolver::InternTable;
import Compiler::Types::TypeRef;


/// True when (line, character) falls within `span` inclusive of both
/// endpoints.  Spanless nodes (start_line == 0) never match — they
/// have no editor coordinate to compare against.
public function span_contains(span: SourceSpan, line: u32, character: u32) -> boolean {
    if (span.start_line == 0 as u32) { return false; }
    if (line < span.start_line) { return false; }
    if (line > span.end_line)   { return false; }
    if (line == span.start_line && character < span.start_col) { return false; }
    if (line == span.end_line   && character > span.end_col)   { return false; }
    return true;
}


/// Walk `root` and return the innermost `ASTNode*` whose span covers
/// (line, character).  Returns `null` when the cursor falls outside
/// every top-level statement (typical for cursor-on-blank-line above
/// the first declaration).
public function find_innermost_node_at(root: ProgramNode*,
                                        line: u32, character: u32) -> ASTNode* {
    if (root == null) { return null; }
    for (mut i: i64 = 0; i < root.statements.length; i++) {
        const stmt: ASTNode* = root.statements[i];
        if (stmt == null) { continue; }
        if (!span_contains(stmt.span, line, character)) { continue; }
        return walk_node(stmt, line, character);
    }
    return null;
}


/// Generic descent: given an `ASTNode*` known to cover the position,
/// look for a child whose span ALSO covers it.  When one is found,
/// recurse; otherwise return the input as the innermost match.
function walk_node(node: ASTNode*, line: u32, character: u32) -> ASTNode* {
    if (node == null) { return null; }

    const child: ASTNode* = first_covering_child(node, line, character);
    if (child == null) { return node; }
    return walk_node(child, line, character);
}


/// Return the first child of `node` whose span covers (line, character),
/// or `null` if no child does.  Per-kind dispatch: each branch knows
/// the structural children of its node type.  Add new node kinds here
/// when they need to participate in position lookup — leaving a kind
/// out is harmless (the walk just stops at that node).
function first_covering_child(node: ASTNode*,
                               line: u32, character: u32) -> ASTNode* {
    match (node.kind) {
        // -- Expressions --
        NodeKind::BinaryExpression => {
            const e: BinaryExprNode* = node as BinaryExprNode*;
            return pick(e.left as ASTNode*, e.right as ASTNode*, null, null,
                        line, character);
        }
        NodeKind::UnaryExpression => {
            const e: UnaryExprNode* = node as UnaryExprNode*;
            return pick(e.operand as ASTNode*, null, null, null, line, character);
        }
        NodeKind::TernaryExpression => {
            const e: TernaryExprNode* = node as TernaryExprNode*;
            return pick(e.condition as ASTNode*, e.true_expr as ASTNode*,
                        e.false_expr as ASTNode*, null, line, character);
        }
        NodeKind::IfExpression => {
            const e: IfExprNode* = node as IfExprNode*;
            return pick(e.condition as ASTNode*, e.then_expr as ASTNode*,
                        e.else_expr as ASTNode*, null, line, character);
        }
        NodeKind::CallExpression => {
            const e: CallExprNode* = node as CallExprNode*;
            const callee_match: ASTNode* = pick_one(e.callee as ASTNode*, line, character);
            if (callee_match != null) { return callee_match; }
            return pick_array_expr(e.arguments, line, character);
        }
        NodeKind::NewExpression => {
            const e: NewExprNode* = node as NewExprNode*;
            return pick_array_expr(e.arguments, line, character);
        }
        NodeKind::CastExpression => {
            const e: CastExprNode* = node as CastExprNode*;
            return pick(e.expression as ASTNode*, null, null, null, line, character);
        }
        NodeKind::MemberAccess => {
            const e: MemberAccessNode* = node as MemberAccessNode*;
            return pick(e.object as ASTNode*, null, null, null, line, character);
        }
        NodeKind::ArrayAccess => {
            const e: ArrayAccessNode* = node as ArrayAccessNode*;
            return pick(e.array as ASTNode*, e.index as ASTNode*, null, null,
                        line, character);
        }
        NodeKind::ArrayLiteral => {
            const e: ArrayLiteralNode* = node as ArrayLiteralNode*;
            return pick_array_expr(e.elements, line, character);
        }
        NodeKind::TupleLiteral => {
            const e: TupleLiteralNode* = node as TupleLiteralNode*;
            return pick_array_expr(e.elements, line, character);
        }
        NodeKind::StructLiteral => {
            // StructLiteral fields are name=expr pairs.  Descend into
            // each `FieldInit.value` so the cursor on a value
            // expression (an identifier, a `Foo::Bar` ScopeResolution,
            // a literal) reaches the inner node.  When the cursor is
            // on the field name itself the descent finds nothing and
            // the caller falls back to the StructLiteral hover branch
            // — which classifies cursor-on-name vs cursor-on-head.
            const e: StructLiteralNode* = node as StructLiteralNode*;
            for (mut i: i64 = 0; i < e.field_inits.length; i++) {
                const v: ExpressionNode* = e.field_inits[i].value;
                if (v != null && span_contains(v.span, line, character)) {
                    return v as ASTNode*;
                }
            }
            return null;
        }
        NodeKind::TypeofExpression => {
            const e: TypeofExprNode* = node as TypeofExprNode*;
            return pick(e.operand as ASTNode*, null, null, null, line, character);
        }
        NodeKind::DeleteExpression => {
            const e: DeleteExprNode* = node as DeleteExprNode*;
            return pick(e.operand as ASTNode*, null, null, null, line, character);
        }
        NodeKind::AwaitExpression => {
            const e: AwaitExprNode* = node as AwaitExprNode*;
            return pick(e.operand as ASTNode*, null, null, null, line, character);
        }
        NodeKind::YieldExpression => {
            const e: YieldExprNode* = node as YieldExprNode*;
            return pick(e.operand as ASTNode*, null, null, null, line, character);
        }
        NodeKind::LambdaExpression => {
            const e: LambdaExprNode* = node as LambdaExprNode*;
            return pick(e.body as ASTNode*, null, null, null, line, character);
        }
        NodeKind::MatchExpression => {
            const e: MatchExprNode* = node as MatchExprNode*;
            const subj: ASTNode* = pick_one(e.subject as ASTNode*, line, character);
            if (subj != null) { return subj; }
            return pick_array_arm(e.arms, line, character);
        }

        // -- Statements --
        NodeKind::BlockStatement => {
            const s: BlockStmtNode* = node as BlockStmtNode*;
            return pick_array_stmt(s.statements, line, character);
        }
        NodeKind::UnsafeBlockStatement => {
            const s: UnsafeBlockStmtNode* = node as UnsafeBlockStmtNode*;
            return pick(s.block as ASTNode*, null, null, null, line, character);
        }
        NodeKind::ReturnStatement => {
            const s: ReturnStmtNode* = node as ReturnStmtNode*;
            return pick(s.expression as ASTNode*, null, null, null, line, character);
        }
        NodeKind::IfStatement => {
            const s: IfStmtNode* = node as IfStmtNode*;
            return pick(s.condition as ASTNode*, s.then_stmt as ASTNode*,
                        s.else_stmt as ASTNode*, null, line, character);
        }
        NodeKind::WhileStatement => {
            const s: WhileStmtNode* = node as WhileStmtNode*;
            return pick(s.condition as ASTNode*, s.body as ASTNode*, null, null,
                        line, character);
        }
        NodeKind::DoWhileStatement => {
            const s: DoWhileStmtNode* = node as DoWhileStmtNode*;
            return pick(s.body as ASTNode*, s.condition as ASTNode*, null, null,
                        line, character);
        }
        NodeKind::ForStatement => {
            const s: ForStmtNode* = node as ForStmtNode*;
            return pick(s.init, s.condition as ASTNode*,
                        s.update as ASTNode*, s.body as ASTNode*,
                        line, character);
        }
        NodeKind::LoopStatement => {
            const s: LoopStmtNode* = node as LoopStmtNode*;
            return pick(s.body as ASTNode*, null, null, null, line, character);
        }
        NodeKind::ExpressionStatement => {
            const s: ExprStmtNode* = node as ExprStmtNode*;
            return pick(s.expression as ASTNode*, null, null, null, line, character);
        }
        NodeKind::DeclarationStatement => {
            const s: DeclStmtNode* = node as DeclStmtNode*;
            return pick(s.declaration as ASTNode*, null, null, null, line, character);
        }
        NodeKind::MatchStatement => {
            const s: MatchStmtNode* = node as MatchStmtNode*;
            const subj: ASTNode* = pick_one(s.subject as ASTNode*, line, character);
            if (subj != null) { return subj; }
            return pick_array_arm(s.arms, line, character);
        }
        NodeKind::MatchArm => {
            const a: MatchArmNode* = node as MatchArmNode*;
            // Patterns first — `ENOENT` in `ENOENT => { … }` is a
            // PatternNode with `pattern_kind = Identifier`.  Hover
            // dispatch resolves the pattern's `value` SymbolStr
            // through the resolver to recover the const it names.
            const pat_match: ASTNode* = pick_array_pattern(
                a.patterns, line, character);
            if (pat_match != null) { return pat_match; }
            return pick(a.body as ASTNode*, null, null, null, line, character);
        }

        // -- Declarations --
        NodeKind::VariableDeclaration => {
            const d: VarDeclNode* = node as VarDeclNode*;
            return pick(d.initializer as ASTNode*, null, null, null, line, character);
        }
        NodeKind::FunctionDeclaration => {
            const d: FunctionDeclNode* = node as FunctionDeclNode*;
            // Body almost always covers the cursor; parameters span the
            // signature line so they're checked first.
            const param_match: ASTNode* = pick_array_var(
                d.parameters, line, character);
            if (param_match != null) { return param_match; }
            return pick(d.body as ASTNode*, null, null, null, line, character);
        }
        NodeKind::MethodDeclaration => {
            const d: MethodNode* = node as MethodNode*;
            if (d.func == null) { return null; }
            // Stop at MethodNode when the cursor is on the method's
            // name token — otherwise the walk descends into the inner
            // FunctionDeclNode and the hover renders as a free
            // function with a `function` keyword.  The method-name
            // case is more useful, so let the MethodDeclaration
            // hover branch handle it.
            if (span_contains(d.func.name_span, line, character)) { return null; }
            // Drive descent into the inner `FunctionDeclNode`'s
            // params and body directly: parse_method leaves
            // `func.span` covering only the method-name token, so a
            // generic `pick(d.func)` span check would miss every
            // position inside the params or body and the walk would
            // stop at MethodNode (whole method) instead of the
            // identifier under the cursor.
            const f: FunctionDeclNode* = d.func;
            const param_match: ASTNode* = pick_array_var(
                f.parameters, line, character);
            if (param_match != null) { return param_match; }
            if (f.body != null && span_contains(f.body.span, line, character)) {
                return f.body as ASTNode*;
            }
            return null;
        }
        NodeKind::StructDeclaration => {
            const d: StructDeclNode* = node as StructDeclNode*;
            const f: ASTNode* = pick_array_field(d.fields, line, character);
            if (f != null) { return f; }
            return pick_array_method(d.methods, line, character);
        }
        NodeKind::ClassDeclaration => {
            const d: ClassDeclNode* = node as ClassDeclNode*;
            const f: ASTNode* = pick_array_field(d.fields, line, character);
            if (f != null) { return f; }
            return pick_array_method(d.methods, line, character);
        }
        NodeKind::EnumDeclaration => {
            // Descend into variants so a hover on `NotFound` inside
            // `type enum X { NotFound; … }` reaches the
            // `EnumVariantNode` directly.  Without this descent the
            // walk stops at `EnumDeclaration` and the hover renders
            // the enum head instead of the specific variant.
            const d: EnumDeclNode* = node as EnumDeclNode*;
            return pick_array_variant(d.variants, line, character);
        }
        NodeKind::TraitDeclaration => {
            // Trait methods are stored as bare `FunctionDeclNode*` (no
            // `MethodNode` wrapper, since trait decls have no instance
            // bodies in the inherent-method sense).  Without this
            // descent the locator stops at TraitDeclaration and any
            // hover inside a trait method's signature renders the
            // trait head instead of the method.
            const d: TraitDeclNode* = node as TraitDeclNode*;
            return pick_array_function(d.methods, line, character);
        }
        NodeKind::ImplementationBlock => {
            // `synthesize_default_trait_methods` (TypeResolution) clones
            // default-bodied trait methods INTO this impl's `methods`
            // array.  The clones retain spans from the trait decl's
            // source file (e.g. `io/traits.cryo`), so a line-only match
            // can land on a synthesized method whose line number
            // happens to overlap the impl head in the impl's own file.
            // Filter to methods whose span.file matches the impl
            // block's span.file so position lookup only sees real
            // source positions in the file we're walking.
            const d: ImplBlockNode* = node as ImplBlockNode*;
            return pick_array_method_in_file(
                d.methods, d.span.file, line, character);
        }
        _ => { return null; }
    }
}


// ============================================================================
// pick* — scan a small fixed set of children + return the first that
// covers the cursor.  Avoids the boilerplate of writing the same
// `if (a != null && contains) return a;` chain per node kind.
// ============================================================================

function pick(a: ASTNode*, b: ASTNode*, c: ASTNode*, d: ASTNode*,
              line: u32, character: u32) -> ASTNode* {
    if (a != null && span_contains(a.span, line, character)) { return a; }
    if (b != null && span_contains(b.span, line, character)) { return b; }
    if (c != null && span_contains(c.span, line, character)) { return c; }
    if (d != null && span_contains(d.span, line, character)) { return d; }
    return null;
}

function pick_one(a: ASTNode*, line: u32, character: u32) -> ASTNode* {
    if (a != null && span_contains(a.span, line, character)) { return a; }
    return null;
}

function pick_array_expr(arr: ExpressionNode*[], line: u32, character: u32) -> ASTNode* {
    for (mut i: i64 = 0; i < arr.length; i++) {
        const elem: ExpressionNode* = arr[i];
        if (elem != null && span_contains(elem.span, line, character)) {
            return elem as ASTNode*;
        }
    }
    return null;
}

function pick_array_stmt(arr: StatementNode*[], line: u32, character: u32) -> ASTNode* {
    for (mut i: i64 = 0; i < arr.length; i++) {
        const elem: StatementNode* = arr[i];
        if (elem != null && span_contains(elem.span, line, character)) {
            return elem as ASTNode*;
        }
    }
    return null;
}

function pick_array_var(arr: VarDeclNode*[], line: u32, character: u32) -> ASTNode* {
    for (mut i: i64 = 0; i < arr.length; i++) {
        const elem: VarDeclNode* = arr[i];
        if (elem != null && span_contains(elem.span, line, character)) {
            return elem as ASTNode*;
        }
    }
    return null;
}

function pick_array_method(arr: MethodNode*[], line: u32, character: u32) -> ASTNode* {
    for (mut i: i64 = 0; i < arr.length; i++) {
        const elem: MethodNode* = arr[i];
        if (elem != null && span_contains(elem.span, line, character)) {
            return elem as ASTNode*;
        }
    }
    return null;
}

/// Bare-function variant — `TraitDeclNode.methods` is a
/// `FunctionDeclNode*[]` rather than `MethodNode*[]`, so it can't go
/// through `pick_array_method`.
function pick_array_function(arr: FunctionDeclNode*[], line: u32, character: u32) -> ASTNode* {
    for (mut i: i64 = 0; i < arr.length; i++) {
        const elem: FunctionDeclNode* = arr[i];
        if (elem != null && span_contains(elem.span, line, character)) {
            return elem as ASTNode*;
        }
    }
    return null;
}

/// Like `pick_array_method`, but skips methods whose span.file differs
/// from `expected_file`.  Used by the ImplementationBlock dispatch:
/// `synthesize_default_trait_methods` clones default-bodied trait
/// methods into the impl's `methods` array, and the clones retain
/// spans from the trait decl's source file.  Without the file filter
/// a line-only match can pick a synthesized method whose line range
/// overlaps the impl head in the impl's own file.
function pick_array_method_in_file(arr: MethodNode*[], expected_file: string,
                                    line: u32, character: u32) -> ASTNode* {
    for (mut i: i64 = 0; i < arr.length; i++) {
        const elem: MethodNode* = arr[i];
        if (elem == null) { continue; }
        if (!same_file(elem.span.file, expected_file)) { continue; }
        if (span_contains(elem.span, line, character)) {
            return elem as ASTNode*;
        }
    }
    return null;
}

/// String equality on file paths.  Both args may be null; null/empty
/// counts as "unknown" and never matches a known file.
function same_file(a: string, b: string) -> boolean {
    if (a == null || b == null) { return false; }
    return strcmp(a, b) == 0;
}

function pick_array_field(arr: FieldDeclNode*[], line: u32, character: u32) -> ASTNode* {
    for (mut i: i64 = 0; i < arr.length; i++) {
        const elem: FieldDeclNode* = arr[i];
        if (elem != null && span_contains(elem.span, line, character)) {
            return elem as ASTNode*;
        }
    }
    return null;
}

function pick_array_arm(arr: MatchArmNode*[], line: u32, character: u32) -> ASTNode* {
    for (mut i: i64 = 0; i < arr.length; i++) {
        const elem: MatchArmNode* = arr[i];
        if (elem != null && span_contains(elem.span, line, character)) {
            return elem as ASTNode*;
        }
    }
    return null;
}

function pick_array_variant(arr: EnumVariantNode*[], line: u32, character: u32) -> ASTNode* {
    for (mut i: i64 = 0; i < arr.length; i++) {
        const elem: EnumVariantNode* = arr[i];
        if (elem != null && span_contains(elem.span, line, character)) {
            return elem as ASTNode*;
        }
    }
    return null;
}

function pick_array_pattern(arr: PatternNode*[], line: u32, character: u32) -> ASTNode* {
    for (mut i: i64 = 0; i < arr.length; i++) {
        const elem: PatternNode* = arr[i];
        if (elem != null && span_contains(elem.span, line, character)) {
            return elem as ASTNode*;
        }
    }
    return null;
}


// ============================================================================
// Per-node-kind type extraction for hover.
//
// Most expressions stash their resolved type on `ExpressionNode.resolved_type`
// (which the LSP can read after sema completes); declarations store theirs
// on the per-class field (`VarDeclNode.resolved_type`,
// `FunctionDeclNode.resolved_return_type`).  Returning `TypeRef::invalid()`
// signals "no type info available" — the hover handler renders nothing
// in that case rather than guessing.
// ============================================================================

public function resolved_type_of(node: ASTNode*) -> TypeRef {
    if (node == null) { return TypeRef::invalid(); }

    // All ExpressionNode subclasses carry resolved_type on the base.
    // The compiler treats Expression / its concrete kinds uniformly,
    // so a single downcast suffices for the whole expression family.
    if (is_expression_kind(node.kind)) {
        const e: ExpressionNode* = node as ExpressionNode*;
        return e.resolved_type;
    }

    match (node.kind) {
        NodeKind::VariableDeclaration => {
            const d: VarDeclNode* = node as VarDeclNode*;
            return d.resolved_type;
        }
        NodeKind::FunctionDeclaration => {
            const d: FunctionDeclNode* = node as FunctionDeclNode*;
            return d.resolved_return_type;
        }
        NodeKind::MethodDeclaration => {
            const d: MethodNode* = node as MethodNode*;
            if (d.func == null) { return TypeRef::invalid(); }
            return d.func.resolved_return_type;
        }
        _ => { return TypeRef::invalid(); }
    }
}

/// Span of a `TypeAnnotation*` — every variant carries a `span`
/// field stamped by the parser, but it's tucked inside the variant
/// payload rather than on the enum itself.  Returns `SourceSpan::none()`
/// for null inputs so callers can chain into `span_contains` without
/// extra null-checking.
public function annotation_span(ann: TypeAnnotation*) -> SourceSpan {
    if (ann == null) { return SourceSpan::none(); }
    return match (*ann) {
        TypeAnnotation::Primitive(p) => { p.span }
        TypeAnnotation::Named(n)     => { n.span }
        TypeAnnotation::Pointer(p)   => { p.span }
        TypeAnnotation::Reference(r) => { r.span }
        TypeAnnotation::Array(a)     => { a.span }
        TypeAnnotation::Function(f)  => { f.span }
        TypeAnnotation::Tuple(t)     => { t.span }
        TypeAnnotation::Optional(o)  => { o.span }
        TypeAnnotation::Generic(g)   => { g.span }
        TypeAnnotation::ThisType(tt) => { tt.span }
    };
}

/// Return the `name_span` of a declaration node — the narrow range
/// covering just the declared identifier (e.g. `body_str` in
/// `const body_str: Str = …;`).  Returns `SourceSpan::none()` for
/// non-declarations, for nodes whose name span the parser hasn't
/// stamped, and for `MethodNode` (which delegates to its inner
/// `FunctionDeclNode`).
public function name_span_of(node: ASTNode*) -> SourceSpan {
    if (node == null) { return SourceSpan::none(); }
    if (node.kind == NodeKind::MethodDeclaration) {
        const m: MethodNode* = node as MethodNode*;
        if (m.func == null) { return SourceSpan::none(); }
        return m.func.name_span;
    }
    if (!is_declaration_kind(node.kind)) { return SourceSpan::none(); }
    const d: DeclarationNode* = node as DeclarationNode*;
    return d.name_span;
}

function is_declaration_kind(k: NodeKind) -> boolean {
    return match (k) {
        NodeKind::VariableDeclaration       => { true }
        NodeKind::DestructureDeclaration    => { true }
        NodeKind::FunctionDeclaration       => { true }
        NodeKind::MethodDeclaration         => { true }
        NodeKind::IntrinsicDeclaration      => { true }
        NodeKind::IntrinsicConstDeclaration => { true }
        NodeKind::StructDeclaration         => { true }
        NodeKind::ClassDeclaration          => { true }
        NodeKind::EnumDeclaration           => { true }
        NodeKind::EnumVariant               => { true }
        NodeKind::TraitDeclaration          => { true }
        NodeKind::TypeAliasDeclaration      => { true }
        NodeKind::ImplementationBlock       => { true }
        NodeKind::ExternBlock               => { true }
        NodeKind::FieldDeclaration          => { true }
        NodeKind::GenericParamDeclaration   => { true }
        _ => { false }
    };
}

function is_expression_kind(k: NodeKind) -> boolean {
    return match (k) {
        NodeKind::Literal           => { true }
        NodeKind::Identifier        => { true }
        NodeKind::BinaryExpression  => { true }
        NodeKind::UnaryExpression   => { true }
        NodeKind::TernaryExpression => { true }
        NodeKind::IfExpression      => { true }
        NodeKind::MatchExpression   => { true }
        NodeKind::CallExpression    => { true }
        NodeKind::NewExpression     => { true }
        NodeKind::SizeofExpression  => { true }
        NodeKind::AlignofExpression => { true }
        NodeKind::CastExpression    => { true }
        NodeKind::StructLiteral     => { true }
        NodeKind::ArrayLiteral      => { true }
        NodeKind::TupleLiteral      => { true }
        NodeKind::LambdaExpression  => { true }
        NodeKind::ArrayAccess       => { true }
        NodeKind::MemberAccess      => { true }
        NodeKind::ScopeResolution   => { true }
        NodeKind::TypeofExpression  => { true }
        NodeKind::DeleteExpression  => { true }
        NodeKind::AwaitExpression   => { true }
        NodeKind::YieldExpression   => { true }
        NodeKind::AsyncExpression   => { true }
        _ => { false }
    };
}


// ============================================================================
// Whole-graph decl lookup (LSP signature hover / go-to-definition).
//
// These walk every module's parsed AST looking for a matching decl.
// O(modules × top-level statements × methods) per call — fine for
// hover (one lookup per request, bounded by source size); not for
// hot paths.  Add a per-namespace decl-index here when callers want
// to query it on every keystroke.
// ============================================================================

/// Find a method named `method_name` on a type/impl-target named
/// `type_name`.  `type_name` may be either bare (`Str`, as the parser
/// stores it on `StructDeclNode.name`) or qualified
/// (`std::collections::str::Str`, as `decl_index.lookup_type_name`
/// returns) — the matcher pre-extracts the leaf segment so both
/// shapes hit.  Returns `null` when no struct, class, enum, or
/// impl-block defines a matching method.
public function find_method_in_modules(graph: ModuleGraph*,
                                        intern: InternTable*,
                                        type_name: SymbolStr,
                                        method_name: SymbolStr) -> MethodNode* {
    if (graph == null) { return null; }
    const type_leaf: string = if (intern != null) {
        leaf_segment_str(intern.resolve(type_name))
    } else { "" };
    const n: u32 = graph.module_count();
    for (mut mi: u32 = 0; mi < n; mi++) {
        const ast: ProgramNode* = graph.get_module_ast(mi);
        if (ast == null) { continue; }
        for (mut si: i64 = 0; si < ast.statements.length; si++) {
            const stmt: ASTNode* = unwrap_decl_stmt(ast.statements[si]);
            const found: MethodNode* = match_methods_on_type(
                stmt, intern, type_name, type_leaf, method_name);
            if (found != null) { return found; }
        }
    }
    return null;
}

/// Last segment after the final `::`, matching `extract_leaf_segment`
/// in `Compiler::Types::Arena`.  Local copy because the locator
/// avoids a cross-module dependency on the arena module.
function leaf_segment_str(s: string) -> string {
    const len: i64 = strlen(s) as i64;
    mut last_sep: i64 = -1;
    for (mut i: i64 = 0; i + 1 < len; i++) {
        if (s[i] == ':' && s[i + 1] == ':') { last_sep = i; }
    }
    if (last_sep < 0) { return s; }
    const start: i64 = last_sep + 2;
    if (start >= len) { return ""; }
    return ptr_add(s as void*, start) as string;
}

/// True when `decl_name` matches `type_name` either by SymbolStr id
/// (caller passed the bare name) or by string content vs. the
/// pre-extracted leaf (caller passed a qualified name).
function type_name_matches(intern: InternTable*, decl_name: SymbolStr,
                            type_name: SymbolStr, type_leaf: string) -> boolean {
    if (decl_name.equals(type_name)) { return true; }
    if (intern == null || strlen(type_leaf) == 0) { return false; }
    const dn: string = intern.resolve(decl_name);
    return strcmp(dn, type_leaf) == 0;
}

/// Find a top-level free function named `name` anywhere in the
/// module graph.  Used for `Module::function`-style scope-resolution
/// hover where the scope is a namespace, not a type.
public function find_function_in_modules(graph: ModuleGraph*,
                                          name: SymbolStr) -> FunctionDeclNode* {
    if (graph == null) { return null; }
    const n: u32 = graph.module_count();
    for (mut mi: u32 = 0; mi < n; mi++) {
        const ast: ProgramNode* = graph.get_module_ast(mi);
        if (ast == null) { continue; }
        for (mut si: i64 = 0; si < ast.statements.length; si++) {
            const stmt: ASTNode* = unwrap_decl_stmt(ast.statements[si]);
            if (stmt == null) { continue; }
            if (stmt.kind != NodeKind::FunctionDeclaration) { continue; }
            const f: FunctionDeclNode* = stmt as FunctionDeclNode*;
            if (f.name.equals(name)) { return f; }
        }
    }
    return null;
}

/// Find a top-level (global) `const`/`mut` variable named `name`
/// anywhere in the module graph.  Used by the LSP to surface const
/// values through name lookup when the resolver's span→symbol map
/// doesn't apply — for instance, match-arm identifier patterns
/// (which Cryo treats as fresh bindings rather than const compares),
/// where the user still wants to see the const's value.
public function find_const_in_modules(graph: ModuleGraph*,
                                       name: SymbolStr) -> VarDeclNode* {
    if (graph == null) { return null; }
    const n: u32 = graph.module_count();
    for (mut mi: u32 = 0; mi < n; mi++) {
        const ast: ProgramNode* = graph.get_module_ast(mi);
        if (ast == null) { continue; }
        for (mut si: i64 = 0; si < ast.statements.length; si++) {
            const stmt: ASTNode* = unwrap_decl_stmt(ast.statements[si]);
            if (stmt == null) { continue; }
            if (stmt.kind != NodeKind::VariableDeclaration) { continue; }
            const v: VarDeclNode* = stmt as VarDeclNode*;
            if (v.is_global && v.name.equals(name)) { return v; }
        }
    }
    return null;
}

/// Find a `ProgramNode` whose `namespace_name` matches `path`
/// exactly (e.g. `"std::core"`).  Used by the LSP to render hovers
/// for individual import-path segments — each segment maps to a
/// namespace-rooted file (the `_module.cryo` for non-leaf segments,
/// the actual source file for the leaf).  Returns `null` when no
/// module in the graph declares that namespace.
public function find_program_by_namespace(graph: ModuleGraph*,
                                           path: string) -> ProgramNode* {
    if (graph == null) { return null; }
    const n: u32 = graph.module_count();
    for (mut mi: u32 = 0; mi < n; mi++) {
        const ast: ProgramNode* = graph.get_module_ast(mi);
        if (ast == null) { continue; }
        if (strcmp(ast.namespace_name, path) == 0) { return ast; }
    }
    return null;
}

/// `ProgramNode.statements` mixes raw decl nodes and `DeclStmtNode`
/// wrappers depending on how the parser shaped that file's top-level
/// list.  Unwrap so callers can branch on the inner decl's `NodeKind`
/// directly.
function unwrap_decl_stmt(node: ASTNode*) -> ASTNode* {
    if (node == null) { return null; }
    if (node.kind != NodeKind::DeclarationStatement) { return node; }
    const d: DeclStmtNode* = node as DeclStmtNode*;
    return d.declaration as ASTNode*;
}

function match_methods_on_type(stmt: ASTNode*, intern: InternTable*,
                                type_name: SymbolStr, type_leaf: string,
                                method_name: SymbolStr) -> MethodNode* {
    if (stmt == null) { return null; }
    match (stmt.kind) {
        NodeKind::StructDeclaration => {
            const d: StructDeclNode* = stmt as StructDeclNode*;
            if (!type_name_matches(intern, d.name, type_name, type_leaf)) { return null; }
            return method_by_name(d.methods, method_name);
        }
        NodeKind::ClassDeclaration => {
            const d: ClassDeclNode* = stmt as ClassDeclNode*;
            if (!type_name_matches(intern, d.name, type_name, type_leaf)) { return null; }
            return method_by_name(d.methods, method_name);
        }
        NodeKind::EnumDeclaration => {
            const d: EnumDeclNode* = stmt as EnumDeclNode*;
            if (!type_name_matches(intern, d.name, type_name, type_leaf)) { return null; }
            // EnumDeclNode currently has no methods array; methods
            // for enums live in ImplBlockNode.  Match struct/class
            // pattern when that changes.
            return null;
        }
        NodeKind::ImplementationBlock => {
            const d: ImplBlockNode* = stmt as ImplBlockNode*;
            if (!type_name_matches(intern, d.target_type, type_name, type_leaf)) {
                return null;
            }
            return method_by_name(d.methods, method_name);
        }
        _ => { return null; }
    }
}

function method_by_name(methods: MethodNode*[], name: SymbolStr) -> MethodNode* {
    for (mut i: i64 = 0; i < methods.length; i++) {
        const m: MethodNode* = methods[i];
        if (m == null || m.func == null) { continue; }
        if (m.func.name.equals(name)) { return m; }
    }
    return null;
}

/// Find the owner type-name for a `MethodNode` by reverse-walking
/// every module's top-level decls.  Returns `SymbolStr::empty()` when
/// the method isn't owned by any struct/class/impl-block in the graph
/// (shouldn't happen for parsed source, but the locator gracefully
/// renders no prefix in that case).
public function find_method_owner(graph: ModuleGraph*,
                                   method: MethodNode*) -> SymbolStr {
    if (graph == null || method == null) { return SymbolStr::empty(); }
    const n: u32 = graph.module_count();
    for (mut mi: u32 = 0; mi < n; mi++) {
        const ast: ProgramNode* = graph.get_module_ast(mi);
        if (ast == null) { continue; }
        for (mut si: i64 = 0; si < ast.statements.length; si++) {
            const stmt: ASTNode* = unwrap_decl_stmt(ast.statements[si]);
            if (stmt == null) { continue; }
            const owner: SymbolStr = owner_if_contains(stmt, method);
            if (owner.is_valid()) { return owner; }
        }
    }
    return SymbolStr::empty();
}

function owner_if_contains(stmt: ASTNode*, method: MethodNode*) -> SymbolStr {
    match (stmt.kind) {
        NodeKind::StructDeclaration => {
            const d: StructDeclNode* = stmt as StructDeclNode*;
            if (methods_contains(d.methods, method)) { return d.name; }
            return SymbolStr::empty();
        }
        NodeKind::ClassDeclaration => {
            const d: ClassDeclNode* = stmt as ClassDeclNode*;
            if (methods_contains(d.methods, method)) { return d.name; }
            return SymbolStr::empty();
        }
        NodeKind::ImplementationBlock => {
            const d: ImplBlockNode* = stmt as ImplBlockNode*;
            if (methods_contains(d.methods, method)) { return d.target_type; }
            return SymbolStr::empty();
        }
        _ => { return SymbolStr::empty(); }
    }
}

function methods_contains(arr: MethodNode*[], target: MethodNode*) -> boolean {
    for (mut i: i64 = 0; i < arr.length; i++) {
        if (arr[i] == target) { return true; }
    }
    return false;
}


/// Reverse-walk the module graph to find the struct/class/impl/trait
/// whose method body contains the position `(line, character)` in
/// `file_path`.  Returns the owner's name as SymbolStr — useful for
/// resolving `this.field` hovers where the receiver expression's
/// resolved_type didn't survive sema (generic bodies, partial
/// compiles) but the cursor position is still inside a method body.
///
/// Returns `SymbolStr::empty()` when no enclosing method covers the
/// position.  Caller treats that as "fall through to the regular
/// type-lookup path."
public function find_enclosing_method_owner(graph: ModuleGraph*,
                                             file_path: string,
                                             line: u32,
                                             character: u32) -> SymbolStr {
    if (graph == null || file_path == "") { return SymbolStr::empty(); }
    if (strlen(file_path) == 0 as u64)    { return SymbolStr::empty(); }

    const mod_idx: i64 = graph.find_module_by_path(file_path);
    if (mod_idx < 0) { return SymbolStr::empty(); }
    const ast: ProgramNode* = graph.get_module_ast(mod_idx as u32);
    if (ast == null) { return SymbolStr::empty(); }

    for (mut si: i64 = 0; si < ast.statements.length; si++) {
        const stmt: ASTNode* = unwrap_decl_stmt(ast.statements[si]);
        if (stmt == null) { continue; }
        const owner: SymbolStr = enclosing_owner_of(stmt, line, character);
        if (owner.is_valid()) { return owner; }
    }
    return SymbolStr::empty();
}

function enclosing_owner_of(stmt: ASTNode*, line: u32, character: u32) -> SymbolStr {
    match (stmt.kind) {
        NodeKind::StructDeclaration => {
            const d: StructDeclNode* = stmt as StructDeclNode*;
            if (method_body_contains_at(d.methods, line, character)) {
                return d.name;
            }
            return SymbolStr::empty();
        }
        NodeKind::ClassDeclaration => {
            const d: ClassDeclNode* = stmt as ClassDeclNode*;
            if (method_body_contains_at(d.methods, line, character)) {
                return d.name;
            }
            return SymbolStr::empty();
        }
        NodeKind::ImplementationBlock => {
            const d: ImplBlockNode* = stmt as ImplBlockNode*;
            if (method_body_contains_at(d.methods, line, character)) {
                return d.target_type;
            }
            return SymbolStr::empty();
        }
        NodeKind::TraitDeclaration => {
            // Trait method bodies (default impls) — for the `Self`
            // hover case.  Trait methods are FunctionDeclNode here.
            const d: TraitDeclNode* = stmt as TraitDeclNode*;
            for (mut fi: i64 = 0; fi < d.methods.length; fi++) {
                const f: FunctionDeclNode* = d.methods[fi];
                if (f != null && f.body != null
                        && span_contains(f.body.span, line, character)) {
                    return d.name;
                }
            }
            return SymbolStr::empty();
        }
        _ => { return SymbolStr::empty(); }
    }
}

function method_body_contains_at(arr: MethodNode*[], line: u32, character: u32) -> boolean {
    for (mut i: i64 = 0; i < arr.length; i++) {
        const m: MethodNode* = arr[i];
        if (m == null || m.func == null || m.func.body == null) { continue; }
        if (span_contains(m.func.body.span, line, character)) { return true; }
    }
    return false;
}


/// Reverse-walk the module graph to find the trait that declares
/// `func` as one of its methods.  Trait methods are stored bare as
/// `FunctionDeclNode*` (not `MethodNode*`), so the regular
/// `find_method_owner` doesn't reach them.  Returns the trait's name
/// (`Display`, `Hash`, ...) or `SymbolStr::empty()` when `func`
/// belongs to no trait — the caller treats that as a free function.
public function find_trait_for_function(graph: ModuleGraph*,
                                         func: FunctionDeclNode*) -> SymbolStr {
    if (graph == null || func == null) { return SymbolStr::empty(); }
    const n: u32 = graph.module_count();
    for (mut mi: u32 = 0; mi < n; mi++) {
        const ast: ProgramNode* = graph.get_module_ast(mi);
        if (ast == null) { continue; }
        for (mut si: i64 = 0; si < ast.statements.length; si++) {
            const stmt: ASTNode* = unwrap_decl_stmt(ast.statements[si]);
            if (stmt == null) { continue; }
            if (stmt.kind != NodeKind::TraitDeclaration) { continue; }
            const td: TraitDeclNode* = stmt as TraitDeclNode*;
            for (mut fi: i64 = 0; fi < td.methods.length; fi++) {
                if (td.methods[fi] == func) { return td.name; }
            }
        }
    }
    return SymbolStr::empty();
}


/// Find a type declaration named `type_name` anywhere in the module
/// graph.  Matches struct, class, enum, trait, and type-alias decls;
/// `type_name` may be bare (`Str`) or qualified
/// (`std::collections::str::Str`) — the leaf-aware matcher accepts
/// both.  Used by go-to-definition to jump from a use site (a
/// scope-resolution token, an identifier, or a name in a type
/// annotation) to the declaring node.  Returns `null` when no decl
/// matches.
public function find_type_decl_in_modules(graph: ModuleGraph*,
                                           intern: InternTable*,
                                           type_name: SymbolStr) -> ASTNode* {
    if (graph == null) { return null; }
    const type_leaf: string = if (intern != null) {
        leaf_segment_str(intern.resolve(type_name))
    } else { "" };
    const n: u32 = graph.module_count();
    for (mut mi: u32 = 0; mi < n; mi++) {
        const ast: ProgramNode* = graph.get_module_ast(mi);
        if (ast == null) { continue; }
        for (mut si: i64 = 0; si < ast.statements.length; si++) {
            const stmt: ASTNode* = unwrap_decl_stmt(ast.statements[si]);
            if (stmt == null) { continue; }
            if (decl_name_matches(stmt, intern, type_name, type_leaf)) {
                return stmt;
            }
        }
    }
    return null;
}

function decl_name_matches(stmt: ASTNode*, intern: InternTable*,
                            type_name: SymbolStr, type_leaf: string) -> boolean {
    match (stmt.kind) {
        NodeKind::StructDeclaration => {
            const d: StructDeclNode* = stmt as StructDeclNode*;
            return type_name_matches(intern, d.name, type_name, type_leaf);
        }
        NodeKind::ClassDeclaration => {
            const d: ClassDeclNode* = stmt as ClassDeclNode*;
            return type_name_matches(intern, d.name, type_name, type_leaf);
        }
        NodeKind::EnumDeclaration => {
            const d: EnumDeclNode* = stmt as EnumDeclNode*;
            return type_name_matches(intern, d.name, type_name, type_leaf);
        }
        NodeKind::TraitDeclaration => {
            const d: TraitDeclNode* = stmt as TraitDeclNode*;
            return type_name_matches(intern, d.name, type_name, type_leaf);
        }
        NodeKind::TypeAliasDeclaration => {
            const d: TypeAliasDeclNode* = stmt as TypeAliasDeclNode*;
            return type_name_matches(intern, d.alias_name, type_name, type_leaf);
        }
        _ => { return false; }
    }
    return false;
}


/// Walk a `TypeAnnotation*` tree and return the innermost
/// `NamedAnnotation*` whose span contains (line, character).  Used by
/// go-to-definition to identify which token in a complex annotation
/// (e.g. `HashMap<K, V>` or `&mut Foo*`) the cursor sits on, so the
/// caller can resolve that name to its declaring node.  Returns
/// `null` when no named segment matches — `_ => { null }` covers
/// `Primitive` (no decl to jump to) and `ThisType` (the implementing
/// type is supplied by sema, not the parser).
public function find_named_annotation_at(ann: TypeAnnotation*,
                                          line: u32, ch: u32) -> NamedAnnotation* {
    if (ann == null) { return null; }
    if (!span_contains(annotation_span(ann), line, ch)) { return null; }
    match (*ann) {
        TypeAnnotation::Named(n) => { return n; }
        TypeAnnotation::Pointer(p) => {
            return find_named_annotation_at(p.inner, line, ch);
        }
        TypeAnnotation::Reference(r) => {
            return find_named_annotation_at(r.inner, line, ch);
        }
        TypeAnnotation::Optional(o) => {
            return find_named_annotation_at(o.inner, line, ch);
        }
        TypeAnnotation::Array(a) => {
            return find_named_annotation_at(a.element, line, ch);
        }
        TypeAnnotation::Generic(g) => {
            const base_hit: NamedAnnotation* = find_named_annotation_at(
                g.base, line, ch);
            if (base_hit != null) { return base_hit; }
            for (mut i: i64 = 0; i < g.args.length; i++) {
                const arg_hit: NamedAnnotation* = find_named_annotation_at(
                    g.args[i], line, ch);
                if (arg_hit != null) { return arg_hit; }
            }
            return null;
        }
        TypeAnnotation::Tuple(t) => {
            for (mut i: i64 = 0; i < t.elements.length; i++) {
                const hit: NamedAnnotation* = find_named_annotation_at(
                    t.elements[i], line, ch);
                if (hit != null) { return hit; }
            }
            return null;
        }
        TypeAnnotation::Function(f) => {
            for (mut i: i64 = 0; i < f.parameters.length; i++) {
                const hit: NamedAnnotation* = find_named_annotation_at(
                    f.parameters[i], line, ch);
                if (hit != null) { return hit; }
            }
            return find_named_annotation_at(f.return_type, line, ch);
        }
        _ => { return null; }
    }
    return null;
}
