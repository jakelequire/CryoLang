/// AST Position Lookup
///
/// `NodeLocator::first_covering_child(node, line, character)` returns the
/// first child of a node whose `span` covers (line, character), or `null`;
/// a caller walks down by repeating it, which is how the language server
/// finds the innermost node at a cursor.  Positions are 1-based to match
/// the compiler's `SourceSpan` convention; the server converts its
/// 0-based positions before asking.
///
/// Dispatch is by `NodeKind` rather than the visitor pattern.  The
/// visitor needs ~50 method overrides per concrete walker; this file
/// recurses inline through the children that actually exist for each
/// kind, which keeps the walk in one place.  Kinds with no children
/// (Identifier, Literal, the various leaf statements) have no covering
/// child, so the walk stops at them.
///
/// "Innermost" semantics: the walk descends into the FIRST child whose
/// span covers the cursor.  Two siblings with overlapping spans is
/// normally a parser bug; if it happens, the leftmost one is taken.
namespace compiler::ast::node_locator;

import compiler::ast;
import compiler::ast::{
    declaration, expression, NamedAnnotation, node, NodeKind, statement, TypeAnnotation
};
import compiler::diag::source_span;
import compiler::diag::source_span::{ SourceSpan };
import compiler::ast::pattern;
import compiler::ast::pattern::{ MatchArmNode, Pattern, StaticMatchArmNode };
import compiler::ast::declaration::{
    ClassDeclNode, DeclarationNode, DeclKind,
    FunctionDecl, ImplBlock, MethodDecl, StructDecl,
    TraitDecl, UnionDecl, VarDecl
};
import compiler::ast::expression::{
    ArrayAccessNode, ArrayLiteralNode, AwaitExprNode, BinaryExprNode, CallExprNode,
    CastExprNode, ExprKind, ExpressionNode, IfExprNode, LambdaExprNode,
    MatchExprNode, MemberAccessNode, StaticMatchExprNode, StructLiteralNode,
    TernaryExprNode, UnaryExprNode
};
import compiler::ast::node::{ ASTNode };
import compiler::ast::statement::{ Stmt, StmtKind };


/// True when (line, character) falls within `span` inclusive of both
/// endpoints.  Spanless nodes (start_line == 0) never match; they
/// have no editor coordinate to compare against.
public function span_contains(span: SourceSpan, line: u32, character: u32) -> boolean {
    if (span.start_line == 0 as u32) { return false; }
    if (line < span.start_line) { return false; }
    if (line > span.end_line)   { return false; }
    if (line == span.start_line && character < span.start_col) { return false; }
    if (line == span.end_line   && character > span.end_col)   { return false; }
    return true;
}


/// Span of a `TypeAnnotation*`: every variant carries a `span`
/// field stamped by the parser, but it's tucked inside the variant
/// payload rather than on the enum itself.  Returns `SourceSpan::none()`
/// for null inputs so callers can chain into `span_contains` without
/// extra null-checking.
public function annotation_span(ann: TypeAnnotation*) -> SourceSpan {
    if (ann == null) { return SourceSpan::none(); }
    return match (*ann) {
        TypeAnnotation::Primitive(p) => { p.span }
        TypeAnnotation::Named(n)     => { n.span }
        TypeAnnotation::Pointer(p)   => { p.span }
        TypeAnnotation::Reference(r) => { r.span }
        TypeAnnotation::Array(a)     => { a.span }
        TypeAnnotation::Function(f)  => { f.span }
        TypeAnnotation::Tuple(t)     => { t.span }
        TypeAnnotation::Generic(g)   => { g.span }
        TypeAnnotation::Typeof(to)   => { to.span }
        TypeAnnotation::ThisType(tt) => { tt.span }
        TypeAnnotation::ImplTrait(imp) => { imp.span }
        TypeAnnotation::Projection(proj) => { proj.span }
    };
}

/// Return the `name_span` of a declaration node: the narrow range
/// covering just the declared identifier (e.g. `body_str` in
/// `const body_str: Str = ...;`).  Returns `SourceSpan::none()` for
/// non-declarations, for nodes whose name span the parser hasn't
/// stamped, and for `MethodDecl` (which delegates to its inner
/// `FunctionDecl`).
public function name_span_of(node: ASTNode*) -> SourceSpan {
    if (node == null) { return SourceSpan::none(); }
    if (DeclarationNode::method_of(node) != null) {
        const m_decl: DeclarationNode* = DeclarationNode::with_shape(node);
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m.func == null) { return SourceSpan::none(); }
        return m.func.name_span;
    }
    if (!node.kind.is_declaration()) { return SourceSpan::none(); }
    const d: DeclarationNode* = node as DeclarationNode*;
    return d.name_span;
}


/// Walk a `TypeAnnotation*` tree and return the innermost
/// `NamedAnnotation*` whose span contains (line, character).  Used by
/// go-to-definition to identify which token in a complex annotation
/// (e.g. `HashMap<K, V>` or `&mut Foo*`) the cursor sits on, so the
/// caller can resolve that name to its declaring node.  Returns
/// `null` when no named segment matches; `_ => { null }` covers
/// `Primitive` (no decl to jump to) and `ThisType` (the implementing
/// type is supplied by sema, not the parser).
public function find_named_annotation_at(ann: TypeAnnotation*,
                                          line: u32, ch: u32) -> NamedAnnotation* {
    if (ann == null) { return null; }
    if (!span_contains(annotation_span(ann), line, ch)) { return null; }
    match (*ann) {
        TypeAnnotation::Named(n) => { return n; }
        TypeAnnotation::Pointer(p) => {
            return find_named_annotation_at(p.inner, line, ch);
        }
        TypeAnnotation::Reference(r) => {
            return find_named_annotation_at(r.inner, line, ch);
        }
        TypeAnnotation::Array(a) => {
            return find_named_annotation_at(a.element, line, ch);
        }
        TypeAnnotation::Generic(g) => {
            const base_hit: NamedAnnotation* = find_named_annotation_at(
                g.base, line, ch);
            if (base_hit != null) { return base_hit; }
            for (mut i: i64 = 0; i < g.args.length; i++) {
                const arg_hit: NamedAnnotation* = find_named_annotation_at(
                    g.args[i], line, ch);
                if (arg_hit != null) { return arg_hit; }
            }
            return null;
        }
        TypeAnnotation::Tuple(t) => {
            for (mut i: i64 = 0; i < t.elements.length; i++) {
                const hit: NamedAnnotation* = find_named_annotation_at(
                    t.elements[i], line, ch);
                if (hit != null) { return hit; }
            }
            return null;
        }
        TypeAnnotation::Function(f) => {
            for (mut i: i64 = 0; i < f.parameters.length; i++) {
                const hit: NamedAnnotation* = find_named_annotation_at(
                    f.parameters[i], line, ch);
                if (hit != null) { return hit; }
            }
            return find_named_annotation_at(f.return_type, line, ch);
        }
        _ => { return null; }
    }
}


/// The position walk's per-kind descent, as stateless `static`s.
type struct NodeLocator {

    /// Return the first child of `node` whose span covers (line, character),
    /// or `null` if no child does.  Per-kind dispatch: each branch knows
    /// the structural children of its node type.  Add new node kinds here
    /// when they need to participate in position lookup; leaving a kind
    /// out is harmless (the walk just stops at that node).
    static first_covering_child(node: ASTNode*,
                                   line: u32, character: u32) -> ASTNode* {
        match (node.kind) {
            // -- Expressions --
            NodeKind::BinaryExpression => {
                const e: BinaryExprNode* = node as BinaryExprNode*;
                return NodeLocator::pick(e.left as ASTNode*, e.right as ASTNode*, null, null,
                            line, character);
            }
            NodeKind::UnaryExpression => {
                const e: UnaryExprNode* = node as UnaryExprNode*;
                return NodeLocator::pick(e.operand as ASTNode*, null, null, null, line, character);
            }
            NodeKind::TernaryExpression => {
                const e: TernaryExprNode* = node as TernaryExprNode*;
                return NodeLocator::pick(e.condition as ASTNode*, e.true_expr as ASTNode*,
                            e.false_expr as ASTNode*, null, line, character);
            }
            NodeKind::IfExpression => {
                const e: IfExprNode* = node as IfExprNode*;
                return NodeLocator::pick(e.condition as ASTNode*, e.then_expr as ASTNode*,
                            e.else_expr as ASTNode*, null, line, character);
            }
            NodeKind::CallExpression => {
                const e: CallExprNode* = node as CallExprNode*;
                const callee_match: ASTNode* = NodeLocator::pick_one(e.callee as ASTNode*, line, character);
                if (callee_match != null) { return callee_match; }
                return NodeLocator::pick_array_expr(e.arguments, line, character);
            }
            NodeKind::CastExpression => {
                const e: CastExprNode* = node as CastExprNode*;
                return NodeLocator::pick(e.expression as ASTNode*, null, null, null, line, character);
            }
            NodeKind::MemberAccess => {
                const e: MemberAccessNode* = node as MemberAccessNode*;
                return NodeLocator::pick(e.object as ASTNode*, null, null, null, line, character);
            }
            NodeKind::ArrayAccess => {
                const e: ArrayAccessNode* = node as ArrayAccessNode*;
                return NodeLocator::pick(e.array as ASTNode*, e.index as ASTNode*, null, null,
                            line, character);
            }
            NodeKind::ArrayLiteral => {
                const e: ArrayLiteralNode* = node as ArrayLiteralNode*;
                return NodeLocator::pick_array_expr(e.elements, line, character);
            }
            NodeKind::StructLiteral => {
                // StructLiteral fields are name=expr pairs.  Descend into
                // each `FieldInit.value` so the cursor on a value
                // expression (an identifier, a `Foo::Bar` ScopeResolution,
                // a literal) reaches the inner node.  When the cursor is
                // on the field name itself the descent finds nothing and
                // the caller falls back to the StructLiteral hover branch
                // which classifies cursor-on-name vs cursor-on-head.
                const e: StructLiteralNode* = node as StructLiteralNode*;
                for (mut i: i64 = 0; i < e.field_inits.length; i++) {
                    const v: ExpressionNode* = e.field_inits[i].value;
                    if (v != null && span_contains(v.span, line, character)) {
                        return v as ASTNode*;
                    }
                }
                return null;
            }
            NodeKind::Expression => {
                // `sizeof` and `alignof` hold a type annotation, no child
                // expression to descend into.
                return match ((node as ExpressionNode*).shape) {
                    ExprKind::Typeof(e) => {
                        NodeLocator::pick(e.operand as ASTNode*, null, null, null, line, character)
                    }
                    ExprKind::New(e) => {
                        NodeLocator::pick_array_expr(e.arguments, line, character)
                    }
                    ExprKind::Tuple(e) => {
                        NodeLocator::pick_array_expr(e.elements, line, character)
                    }
                    ExprKind::Delete(e) => {
                        NodeLocator::pick(e.operand as ASTNode*, null, null, null, line, character)
                    }
                    ExprKind::Yield(e) => {
                        NodeLocator::pick(e.operand as ASTNode*, null, null, null, line, character)
                    }
                    // The source operand, not the synthetic desugar: hover
                    // and go-to-definition want the spans the user typed.
                    ExprKind::Try(e) => {
                        NodeLocator::pick(e.operand as ASTNode*, null, null, null, line, character)
                    }
                    ExprKind::Sizeof(_)  => { null }
                    ExprKind::Alignof(_) => { null }
                    ExprKind::Legacy     => { null }
                };
            }
            NodeKind::AwaitExpression => {
                const e: AwaitExprNode* = node as AwaitExprNode*;
                return NodeLocator::pick(e.operand as ASTNode*, null, null, null, line, character);
            }
            NodeKind::LambdaExpression => {
                const e: LambdaExprNode* = node as LambdaExprNode*;
                return NodeLocator::pick(e.body as ASTNode*, null, null, null, line, character);
            }
            NodeKind::MatchExpression => {
                const e: MatchExprNode* = node as MatchExprNode*;
                const subj: ASTNode* = NodeLocator::pick_one(e.subject as ASTNode*, line, character);
                if (subj != null) { return subj; }
                return NodeLocator::pick_array_arm(e.arms, line, character);
            }
            NodeKind::StaticMatchExpression => {
                const e: StaticMatchExprNode* = node as StaticMatchExprNode*;
                for (mut i: i64 = 0; i < e.arms.length; i++) {
                    const arm: StaticMatchArmNode* = e.arms[i];
                    if (arm == null || arm.body == null) { continue; }
                    const hit: ASTNode* = NodeLocator::pick(arm.body as ASTNode*, null, null, null,
                                               line, character);
                    if (hit != null) { return hit; }
                }
                return null;
            }

            NodeKind::Statement => {
                return NodeLocator::stmt_covering_child(node as Stmt*, line, character);
            }
            NodeKind::MatchArm => {
                const a: MatchArmNode* = node as MatchArmNode*;
                // Patterns first: `ENOENT` in `ENOENT => { ... }` is a
                // `Constant` pattern, whose stamp names the constant.
                const pat_match: ASTNode* = NodeLocator::pick_array_pattern(
                    a.patterns, line, character);
                if (pat_match != null) { return pat_match; }
                return NodeLocator::pick(a.body as ASTNode*, null, null, null, line, character);
            }

            // -- Declarations --
            NodeKind::ClassDeclaration => {
                const d: ClassDeclNode* = node as ClassDeclNode*;
                const f: ASTNode* = NodeLocator::pick_array_decl(d.fields, line, character);
                if (f != null) { return f; }
                return NodeLocator::pick_array_method(d.methods, line, character);
            }
            NodeKind::Declaration => {
                match ((node as DeclarationNode*).shape) {
                    DeclKind::Method(d) => {
                        if (d.func == null) { return null; }
                        // Stop at the method when the cursor is on its name
                        // token; otherwise the walk descends into the inner
                        // function and the hover renders as a free function
                        // with a `function` keyword.  The method-name case is
                        // more useful, so let the method's hover branch
                        // handle it.
                        if (span_contains(d.func.name_span, line, character)) { return null; }
                        // Drive descent into the inner `FunctionDecl`'s
                        // params and body directly: parse_method leaves
                        // `func.span` covering only the method-name token, so a
                        // generic `pick(d.func)` span check would miss every
                        // position inside the params or body and the walk would
                        // stop at MethodDecl (whole method) instead of the
                        // identifier under the cursor.
                        const f_decl: DeclarationNode* = d.func;
                        const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
                        const param_match: ASTNode* = NodeLocator::pick_array_decl(
                            f.parameters, line, character);
                        if (param_match != null) { return param_match; }
                        if (f.body != null && span_contains(f.body.span, line, character)) {
                            return f.body as ASTNode*;
                        }
                        return null;
                    }
                    DeclKind::Function(d) => {
                        // Body almost always covers the cursor; parameters span the
                        // signature line so they're checked first.
                        const param_match: ASTNode* = NodeLocator::pick_array_decl(
                            d.parameters, line, character);
                        if (param_match != null) { return param_match; }
                        return NodeLocator::pick(d.body as ASTNode*, null, null, null, line, character);
                    }
                    // Trait methods are stored as bare function declarations
                    // (no `MethodDecl` wrapper, since trait decls have no instance
                    // bodies in the inherent-method sense).  Without this
                    // descent the locator stops at the trait and any hover
                    // inside a trait method's signature renders the trait head
                    // instead of the method.
                    DeclKind::Trait(d) => {
                        return NodeLocator::pick_array_decl(d.methods, line, character);
                    }
                    // Extern declarations are bare function declarations on the
                    // block's `functions` array, exactly like trait methods.
                    // Without this descent the locator stops at the block and
                    // hovering `syscall` in `extern "C" { function syscall(...) }`
                    // finds no declaration.
                    DeclKind::Extern(d) => {
                        return NodeLocator::pick_array_decl(d.functions, line, character);
                    }
                    // Descend into variants so a hover on `NotFound` inside
                    // `type enum X { NotFound; ... }` reaches the variant's
                    // declaration directly; otherwise the walk stops at the
                    // enum and the hover renders its head.
                    DeclKind::Enum(d) => {
                        return NodeLocator::pick_array_decl(d.variants, line, character);
                    }
                    DeclKind::Union(d) => {
                        const f: ASTNode* = NodeLocator::pick_array_decl(d.fields, line, character);
                        if (f != null) { return f; }
                        return NodeLocator::pick_array_method(d.methods, line, character);
                    }
                    DeclKind::Struct(d) => {
                        const f: ASTNode* = NodeLocator::pick_array_decl(d.fields, line, character);
                        if (f != null) { return f; }
                        return NodeLocator::pick_array_method(d.methods, line, character);
                    }
                    // `synthesize_default_trait_methods` (TypeResolution)
                    // clones default-bodied trait methods INTO this impl's
                    // `methods` array.  The clones retain spans from the
                    // trait decl's source file (e.g. `io/traits.cryo`), so a
                    // line-only match can land on a synthesized method whose
                    // line number happens to overlap the impl head in the
                    // impl's own file.  Filter to methods whose span.file
                    // matches the impl block's span.file so position lookup
                    // only sees real source positions in the file we're
                    // walking.
                    DeclKind::Impl(d) => {
                        return NodeLocator::pick_array_method_in_file(
                            d.methods, node.span.file, line, character);
                    }
                    DeclKind::Variable(d) => {
                        return NodeLocator::pick(d.initializer as ASTNode*, null, null, null, line, character);
                    }
                    DeclKind::Destructure(_) | DeclKind::Import(_) | DeclKind::Intrinsic(_)
                    | DeclKind::Module(_) | DeclKind::Variant(_)
                    | DeclKind::TypeAlias(_) | DeclKind::Field(_) | DeclKind::GenericParam(_)
                    | DeclKind::Legacy => { return null; }
                }
            }
            _ => { return null; }
        }
    }

    /// `first_covering_child` for a statement.  An `asm` block's operands
    /// are not descended into, and `break` / `continue` have no children.
    static stmt_covering_child(s: Stmt*, line: u32, character: u32) -> ASTNode* {
        match (s.shape) {
            StmtKind::Block(n) => {
                return NodeLocator::pick_array_stmt(n.statements, line, character);
            }
            StmtKind::UnsafeBlock(n) => {
                return NodeLocator::pick(n.block as ASTNode*, null, null, null, line, character);
            }
            StmtKind::Return(n) => {
                return NodeLocator::pick(n.expression as ASTNode*, null, null, null, line, character);
            }
            StmtKind::If(n) => {
                return NodeLocator::pick(n.condition as ASTNode*, n.then_stmt as ASTNode*,
                            n.else_stmt as ASTNode*, null, line, character);
            }
            StmtKind::While(n) => {
                return NodeLocator::pick(n.condition as ASTNode*, n.body as ASTNode*, null, null,
                            line, character);
            }
            StmtKind::DoWhile(n) => {
                return NodeLocator::pick(n.body as ASTNode*, n.condition as ASTNode*, null, null,
                            line, character);
            }
            StmtKind::For(n) => {
                return NodeLocator::pick(n.init, n.condition as ASTNode*,
                            n.update as ASTNode*, n.body as ASTNode*,
                            line, character);
            }
            StmtKind::Loop(n) => {
                return NodeLocator::pick(n.body as ASTNode*, null, null, null, line, character);
            }
            StmtKind::Expr(n) => {
                return NodeLocator::pick(n.expression as ASTNode*, null, null, null, line, character);
            }
            StmtKind::Decl(n) => {
                return NodeLocator::pick(n.declaration as ASTNode*, null, null, null, line, character);
            }
            StmtKind::Match(n) => {
                const subj: ASTNode* = NodeLocator::pick_one(n.subject as ASTNode*, line, character);
                if (subj != null) { return subj; }
                return NodeLocator::pick_array_arm(n.arms, line, character);
            }
            StmtKind::StaticMatch(n) => {
                for (mut i: i64 = 0; i < n.arms.length; i++) {
                    const arm: StaticMatchArmNode* = n.arms[i];
                    if (arm == null || arm.body == null) { continue; }
                    const hit: ASTNode* = NodeLocator::pick(arm.body as ASTNode*, null, null, null,
                                               line, character);
                    if (hit != null) { return hit; }
                }
                return null;
            }
            StmtKind::Asm(_)   => { return null; }
            StmtKind::Break    => { return null; }
            StmtKind::Continue => { return null; }
        }
    }

    static pick(a: ASTNode*, b: ASTNode*, c: ASTNode*, d: ASTNode*,
                  line: u32, character: u32) -> ASTNode* {
        const ha: ASTNode* = NodeLocator::pick_one(a, line, character);
        if (ha != null) { return ha; }
        const hb: ASTNode* = NodeLocator::pick_one(b, line, character);
        if (hb != null) { return hb; }
        const hc: ASTNode* = NodeLocator::pick_one(c, line, character);
        if (hc != null) { return hc; }
        return NodeLocator::pick_one(d, line, character);
    }

    /// `a` when it holds the position.  A node the compiler wrote spells
    /// nothing at its span, so the walk looks through it to the written
    /// node under it holding the position, if any: a hole of an f-string
    /// is found under the lowering's calls, not as one of them.
    static pick_one(a: ASTNode*, line: u32, character: u32) -> ASTNode* {
        if (a == null || !span_contains(a.span, line, character)) { return null; }
        if (a.generated) { return NodeLocator::first_covering_child(a, line, character); }
        return a;
    }

    static pick_array_expr(arr: &[ExpressionNode*], line: u32, character: u32) -> ASTNode* {
        for (mut i: i64 = 0; i < arr.length; i++) {
            const hit: ASTNode* = NodeLocator::pick_one(arr[i] as ASTNode*, line, character);
            if (hit != null) { return hit; }
        }
        return null;
    }

    /// The statement holding the position.  A statement the compiler wrote
    /// beside a written one can share its span (a release after a discarded
    /// value), so it is looked through as `pick_one` looks through any node
    /// the compiler wrote, and the walk goes on to the next.
    static pick_array_stmt(arr: &[Stmt*], line: u32, character: u32) -> ASTNode* {
        for (mut i: i64 = 0; i < arr.length; i++) {
            const hit: ASTNode* = NodeLocator::pick_one(arr[i] as ASTNode*, line, character);
            if (hit != null) { return hit; }
        }
        return null;
    }

    static pick_array_method(arr: &[DeclarationNode*], line: u32, character: u32) -> ASTNode* {
        for (mut i: i64 = 0; i < arr.length; i++) {
            const elem_decl: DeclarationNode* = arr[i];
            const elem: MethodDecl* = DeclarationNode::method_of(elem_decl);
            if (elem != null && span_contains(elem_decl.span, line, character)) {
                return elem_decl as ASTNode*;
            }
        }
        return null;
    }

    /// Like `pick_array_method`, but skips methods whose span.file differs
    /// from `expected_file`.  Used by the implement-block dispatch:
    /// `synthesize_default_trait_methods` clones default-bodied trait
    /// methods into the impl's `methods` array, and the clones retain
    /// spans from the trait decl's source file.  Without the file filter
    /// a line-only match can pick a synthesized method whose line range
    /// overlaps the impl head in the impl's own file.
    static pick_array_method_in_file(arr: &[DeclarationNode*], expected_file: string,
                                        line: u32, character: u32) -> ASTNode* {
        for (mut i: i64 = 0; i < arr.length; i++) {
            const elem_decl: DeclarationNode* = arr[i];
            const elem: MethodDecl* = DeclarationNode::method_of(elem_decl);
            if (elem == null) { continue; }
            if (!NodeLocator::same_file(elem_decl.span.file, expected_file)) { continue; }
            if (span_contains(elem_decl.span, line, character)) {
                return elem_decl as ASTNode*;
            }
        }
        return null;
    }

    /// String equality on file paths.  Both args may be null; null/empty
    /// counts as "unknown" and never matches a known file.
    static same_file(a: string, b: string) -> boolean {
        if (a == null || b == null) { return false; }
        return a.eq(b);
    }

    static pick_array_arm(arr: &[MatchArmNode*], line: u32, character: u32) -> ASTNode* {
        for (mut i: i64 = 0; i < arr.length; i++) {
            const elem: MatchArmNode* = arr[i];
            if (elem != null && span_contains(elem.span, line, character)) {
                return elem as ASTNode*;
            }
        }
        return null;
    }

    static pick_array_decl(arr: &[DeclarationNode*], line: u32, character: u32) -> ASTNode* {
        for (mut i: i64 = 0; i < arr.length; i++) {
            const elem: DeclarationNode* = arr[i];
            if (elem != null && span_contains(elem.span, line, character)) {
                return elem as ASTNode*;
            }
        }
        return null;
    }

    static pick_array_pattern(arr: &[Pattern*], line: u32, character: u32) -> ASTNode* {
        for (mut i: i64 = 0; i < arr.length; i++) {
            const elem: Pattern* = arr[i];
            if (elem != null && span_contains(elem.span, line, character)) {
                return elem as ASTNode*;
            }
        }
        return null;
    }

    /// `ProgramNode.statements` mixes raw decl nodes and `DeclStmt`
    /// wrappers depending on how the parser shaped that file's top-level
    /// list.  Unwrap so callers can branch on the inner decl's `NodeKind`
    /// directly.
    static unwrap_decl_stmt(node: ASTNode*) -> ASTNode* {
        if (node == null) { return null; }
        if (node.kind != NodeKind::Statement) { return node; }
        return match ((node as Stmt*).shape) {
            StmtKind::Decl(d) => { d.declaration as ASTNode* }
            _                 => { node }
        };
    }

}
