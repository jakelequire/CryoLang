/// AST Statement Nodes
///
/// `Stmt`, the header every statement shares, and one payload struct per
/// kind of statement.

namespace compiler::ast::statement;

import compiler::diag;
import compiler::ast::{ TypeAnnotation };
import compiler::diag::source_span::{ SourceSpan };
import compiler::ast::node::{ Node };
import compiler::ast::expression::{ ExpressionNode };
import compiler::ast::declaration::{ DeclarationNode };
import compiler::ast::pattern::{ DirectiveNode, MatchArmNode, StaticMatchArmNode };
import compiler::ast::walk::{ Walk };
import compiler::codegen::ast_arena::{ cryo_ast_arena_alloc };

/// Every statement: what all kinds share, and which kind of statement it is.
type struct Stmt {
    span:      SourceSpan;
    has_error: boolean;
    /// The compiler wrote this node where the source spells nothing, and
    /// gave it the span of the source it stands for; a reader asking what is
    /// written at a position (the editor) looks through it.
    generated: boolean;
    kind:      StmtKind;

    /// A statement of `kind` at `span`.
    static of(kind: StmtKind, span: SourceSpan) -> Stmt* {
        return new Stmt { span: span, has_error: false, generated: false, kind: kind };
    }

    /// `{ }`, with no statements yet.
    static block(span: SourceSpan) -> Stmt* {
        return Stmt::of(StmtKind::Block(BlockStmt::new()), span);
    }

    /// `unsafe` over `block`, which is a block statement.
    static unsafe_block(block: Stmt*, span: SourceSpan) -> Stmt* {
        return Stmt::of(StmtKind::UnsafeBlock(new UnsafeBlockStmt { block: block }), span);
    }

    /// `return expression;`, or a bare `return;` when `expression` is null.
    static return_stmt(expression: ExpressionNode*, span: SourceSpan) -> Stmt* {
        return Stmt::of(StmtKind::Return(new ReturnStmt { expression: expression, synth_drops: [] }), span);
    }

    /// `if (condition) then_stmt else else_stmt`; `else_stmt` may be null.
    static if_stmt(condition: ExpressionNode*, then_stmt: Stmt*, else_stmt: Stmt*,
                   span: SourceSpan) -> Stmt* {
        return Stmt::of(StmtKind::If(new IfStmt {
            condition: condition, then_stmt: then_stmt, else_stmt: else_stmt,
        }), span);
    }

    static while_stmt(condition: ExpressionNode*, body: Stmt*, span: SourceSpan) -> Stmt* {
        return Stmt::of(StmtKind::While(new WhileStmt { condition: condition, body: body }), span);
    }

    static do_while_stmt(body: Stmt*, condition: ExpressionNode*, span: SourceSpan) -> Stmt* {
        return Stmt::of(StmtKind::DoWhile(new DoWhileStmt { body: body, condition: condition }), span);
    }

    /// `for (init; condition; update) body`; each of the first three may be
    /// absent.
    static for_stmt(init: Node, condition: ExpressionNode*, update: ExpressionNode*,
                    body: Stmt*, span: SourceSpan) -> Stmt* {
        return Stmt::of(StmtKind::For(new ForStmt {
            init: init, condition: condition, update: update, body: body,
        }), span);
    }

    static break_stmt(span: SourceSpan) -> Stmt* {
        return Stmt::of(StmtKind::Break, span);
    }

    static continue_stmt(span: SourceSpan) -> Stmt* {
        return Stmt::of(StmtKind::Continue, span);
    }

    static expr_stmt(expression: ExpressionNode*, span: SourceSpan) -> Stmt* {
        return Stmt::of(StmtKind::Expr(new ExprStmt { expression: expression }), span);
    }

    static decl_stmt(declaration: DeclarationNode*, span: SourceSpan) -> Stmt* {
        return Stmt::of(StmtKind::Decl(new DeclStmt { declaration: declaration }), span);
    }

    /// `loop body`.
    static loop_stmt(body: Stmt*, span: SourceSpan) -> Stmt* {
        return Stmt::of(StmtKind::Loop(new LoopStmt { body: body }), span);
    }

    /// The block this statement is.  For a statement whose kind is fixed by
    /// where it stands - a function's body, the block under `unsafe` - so
    /// any other kind here is a compiler defect.
    as_block(&this) -> BlockStmt* {
        match (this.kind) {
            StmtKind::Block(b) => { return b; }
            _ => { unreachable(); }
        }
    }

    /// The statement's full written extent: `span` (which starts at a
    /// block's `{`) widened to cover the `![...]` directives that gate a
    /// block.  Anything highlighting the gated construct as a whole - the
    /// LSP's inactive-region dimming - needs the directive included, since
    /// that is what the reader sees as the reason the block is compiled
    /// out.  Mirrors `DeclarationNode::outer_span`.
    outer_span(&this) -> SourceSpan {
        mut out: SourceSpan = this.span;
        match (this.kind) {
            StmtKind::Block(b) => {
                for (mut i: i64 = 0; i < b.attached_directives.length(); i++) {
                    const d: DirectiveNode* = b.attached_directives[i];
                    if (d != null) {
                        out = SourceSpan::covering(out, d.span);
                    }
                }
            }
            _ => {}
        }
        return out;
    }
}

/// `new` of a node takes its storage from the AST arena; `delete` of one
/// releases nothing, since the arena is reclaimed whole.
implement trait Allocate for struct Stmt {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

/// What a statement is, one variant per kind.
type enum StmtKind {
    Block(BlockStmt*);
    UnsafeBlock(UnsafeBlockStmt*);
    Asm(AsmBlockStmt*);
    Return(ReturnStmt*);
    If(IfStmt*);
    While(WhileStmt*);
    DoWhile(DoWhileStmt*);
    For(ForStmt*);
    Match(MatchStmt*);
    StaticMatch(StaticMatchStmt*);
    Break;
    Continue;
    Expr(ExprStmt*);
    Decl(DeclStmt*);
    Loop(LoopStmt*);
}


type struct BlockStmt {
    statements: [Stmt*];
    /// Directives written as `![name(args)]` immediately preceding this
    /// block when it appears in statement position (e.g. `![windows] { ... }`
    /// inside a function body).  Evaluated by the ConfigGating pass:
    /// active blocks are kept, inactive ones have their `statements` list
    /// emptied so codegen sees a no-op block.  Empty for blocks that are
    /// the unconditional body of a function/if/while/etc.
    attached_directives: [DirectiveNode*];
    /// Drop calls synthesised by drop-insertion for a match-*expression* arm
    /// body (a "value block"): the arm's own non-yielded locals.  They must run
    /// AFTER the arm's value expression is materialised (it may read them) and
    /// without displacing the value statement, which stays last for codegen's
    /// arm-value extraction.  Emitting them as trailing statements would make
    /// codegen mistake a drop for the arm value; emitting them before the value
    /// statement would free a local the value expression still reads.  So they
    /// are stashed here and replayed at the end of `generate_block`, which
    /// keeps the value statement's value as the block's.  Empty for every
    /// non-value block.  Mirrors `ReturnStmt.synth_drops`.
    synth_drops: [Stmt*];
    /// True for a block of releases written just ahead of a `return` that
    /// must run after every local the return leaves has been released: the
    /// values an async function's future holds in its fields, whose scopes
    /// enclose every local still on the stack.  Every pass before drop
    /// insertion sees an ordinary block; drop insertion moves it behind the
    /// return's own releases.
    after_return_releases: boolean;

    static new() -> BlockStmt* {
        return new BlockStmt { statements: [], attached_directives: [], synth_drops: [],
                               after_return_releases: false };
    }

    add_statement(mut &this, stmt: Stmt*) -> void {
        this.statements.push(stmt);
    }

    add_directive(mut &this, d: DirectiveNode*) -> void {
        if (d != null) { this.attached_directives.push(d); }
    }

    has_directives(&this) -> boolean { return this.attached_directives.length() > 0; }

    /// Visit the statements in order.
    static walk_children<V>(n: BlockStmt*, v: mut &V) -> void where V: Walk {
        for (mut i: i64 = 0; i < n.statements.length(); i++) { v.walk_stmt(n.statements[i]); }
    }
}


type struct UnsafeBlockStmt {
    /// A block statement.
    block: Stmt*;

    static walk_children<V>(n: UnsafeBlockStmt*, v: mut &V) -> void where V: Walk {
        v.walk_stmt(n.block);
    }
}


/// Assembly dialect for an `asm` block, selected by the mandatory
/// `![arch(<arch>, <dialect>)]` directive.  Maps to LLVM's
/// `LLVMInlineAsmDialect` (ATT = 0, Intel = 1).
type enum AsmDialect {
    ATT;
    Intel;
}

/// Direction of an `asm` operand, from its `{...}` prefix:
///   `{x}` -> In, `{=x}` -> Out, `{+x}` -> InOut.
type enum AsmOpDir {
    In;
    Out;
    InOut;
}

/// Constraint class of an `asm` operand, from its `:...` suffix.
///   (none) / `:r` -> Reg (any general register)
///   `:"rax"`      -> Pinned (a specific register, name in `pinned_reg`)
///   `:m`          -> Memory (operand passed by address)
///   `:i`          -> Imm (immediate)
type enum AsmConstraintKind {
    Reg;
    Pinned;
    Memory;
    Imm;
}

/// One operand of an `asm` block: a Cryo expression bound into the
/// assembly with a direction and a constraint class.  See `emit_asm_block`
/// in codegen/ir_generator.cryo for lowering.
type struct AsmOperand {
    direction: AsmOpDir;
    /// The Cryo operand.  Inputs are read as rvalues; outputs / in-outs
    /// must be assignable lvalues (the call result is stored back).
    expr: ExpressionNode*;
    constraint: AsmConstraintKind;
    /// Register name when `constraint == Pinned` (e.g. "rax"); else "".
    pinned_reg: string;
}

/// A copy that shares the operand's expression; the AST cloner replaces
/// `expr` with its own copy of the expression.
implement trait Clone for struct AsmOperand {
    clone(&this) -> AsmOperand {
        return AsmOperand {
            direction:  this.direction,
            expr:       this.expr,
            constraint: this.constraint,
            pinned_reg: this.pinned_reg,
        };
    }
}

/// One chunk of an `asm` template: either raw assembly text or a
/// reference to an operand (by index into `AsmBlockStmt.operands`).
/// Codegen concatenates the pieces, substituting `$N` for operand refs
/// (N assigned in outputs-first constraint order).
type struct AsmPiece {
    is_operand: boolean;
    /// Raw assembly text when `!is_operand`.
    text: string;
    /// Index into `operands` when `is_operand`.
    operand_index: i64;

    static raw(text: string) -> AsmPiece {
        return AsmPiece { is_operand: false, text: text, operand_index: 0 };
    }

    static operand(index: i64) -> AsmPiece {
        return AsmPiece { is_operand: true, text: "", operand_index: index };
    }
}

implement trait Clone for struct AsmPiece {
    clone(&this) -> AsmPiece {
        return AsmPiece {
            is_operand:    this.is_operand,
            text:          this.text,
            operand_index: this.operand_index,
        };
    }
}

/// `asm { ... }` inline-assembly block.  The body is captured as raw text
/// pieces interleaved with `{...}` operand references.  A mandatory
/// `![arch(<arch>, <dialect>)]` directive selects the target arch (used to
/// gate the block in the ConfigGating pass) and the dialect.  An optional
/// `![clobber(...)]` directive lists clobbered registers / `flags` / `memory`.
/// A module-level `asm { ... }` (no operands) lowers to module inline asm.
type struct AsmBlockStmt {
    /// Target architecture from `![arch(...)]` (e.g. "x86_64").
    arch: string;
    dialect: AsmDialect;
    operands: [AsmOperand];
    pieces: [AsmPiece];
    /// Clobber tokens from `![clobber(...)]` (register names, "flags", "memory").
    clobbers: [string];
    /// True when written at module scope (naked / global asm, no operands).
    is_module_level: boolean;
    /// The `![arch(...)]` / `![clobber(...)]` directives, kept for the
    /// directive-processing validation pass.
    attached_directives: [DirectiveNode*];

    static new() -> AsmBlockStmt* {
        return new AsmBlockStmt {
            arch:                "",
            dialect:             AsmDialect::ATT,
            operands:            [],
            pieces:              [],
            clobbers:            [],
            is_module_level:     false,
            attached_directives: [],
        };
    }

    add_operand(mut &this, op: AsmOperand) -> i64 {
        this.operands.push(op);
        return this.operands.length() - 1;
    }

    add_piece(mut &this, p: AsmPiece) -> void {
        this.pieces.push(p);
    }

    add_clobber(mut &this, name: string) -> void {
        this.clobbers.push(name);
    }

    add_directive(mut &this, d: DirectiveNode*) -> void {
        if (d != null) { this.attached_directives.push(d); }
    }

    static walk_children<V>(n: AsmBlockStmt*, v: mut &V) -> void where V: Walk {
        for (mut i: i64 = 0; i < n.operands.length(); i++) { v.walk_expr(n.operands[i].expr); }
    }
}


type struct ReturnStmt {
    /// The returned value; null for a bare `return;`.
    expression: ExpressionNode*;
    /// Drop calls synthesised by the drop-insertion pass that must run
    /// at function exit *after* `expression` has been evaluated.  These
    /// can't be emitted as statements *before* the return because the
    /// return expression may borrow a local that is being dropped; see
    /// `walk_stmt_into` in passes/drop_insertion.cryo and the matching
    /// sequencing for a return in codegen/ir_generator.cryo.
    synth_drops: [Stmt*];

    static walk_children<V>(n: ReturnStmt*, v: mut &V) -> void where V: Walk {
        v.walk_expr(n.expression);
    }
}


type struct IfStmt {
    condition: ExpressionNode*;
    then_stmt: Stmt*;
    /// Null when there is no `else`.
    else_stmt: Stmt*;

    static walk_children<V>(n: IfStmt*, v: mut &V) -> void where V: Walk {
        v.walk_expr(n.condition);
        v.walk_stmt(n.then_stmt);
        v.walk_stmt(n.else_stmt);
    }
}


type struct WhileStmt {
    condition: ExpressionNode*;
    body:      Stmt*;

    static walk_children<V>(n: WhileStmt*, v: mut &V) -> void where V: Walk {
        v.walk_expr(n.condition);
        v.walk_stmt(n.body);
    }
}


type struct DoWhileStmt {
    body:      Stmt*;
    condition: ExpressionNode*;

    static walk_children<V>(n: DoWhileStmt*, v: mut &V) -> void where V: Walk {
        v.walk_stmt(n.body);
        v.walk_expr(n.condition);
    }
}


type struct ForStmt {
    /// A variable declaration or an expression; an absent expression when
    /// omitted.
    init:      Node;
    condition: ExpressionNode*;
    update:    ExpressionNode*;
    body:      Stmt*;

    static walk_children<V>(n: ForStmt*, v: mut &V) -> void where V: Walk {
        v.walk_node(n.init);
        v.walk_expr(n.condition);
        v.walk_expr(n.update);
        v.walk_stmt(n.body);
    }
}


type struct MatchStmt {
    subject: ExpressionNode*;
    arms:    [MatchArmNode*];

    /// `--panic=unwind` cleanup schedule for the synthesized non-exhaustive
    /// `no_match` guard, so a scrutinee matching no arm runs the frame's local
    /// destructors on unwind.  See `CallExpr.unwind_cleanup`.
    unwind_cleanup: [Stmt*];

    static new(subject: ExpressionNode*) -> MatchStmt* {
        return new MatchStmt { subject: subject, arms: [], unwind_cleanup: [] };
    }

    add_arm(mut &this, arm: MatchArmNode*) -> void {
        this.arms.push(arm);
    }

    static walk_children<V>(n: MatchStmt*, v: mut &V) -> void where V: Walk {
        v.walk_expr(n.subject);
        for (mut i: i64 = 0; i < n.arms.length(); i++) { v.walk_node(Node::Arm(n.arms[i])); }
    }
}


/// Statement-position `static match (T) { ... }` - used when arms yield no value
/// (e.g. an `Atomic<T>::store` body). Same compile-time pruning semantics as
/// StaticMatchExpr; the reduced single arm's block is emitted for effect.
type struct StaticMatchStmt {
    scrutinee: TypeAnnotation*;
    arms:      [StaticMatchArmNode*];

    static new(scrutinee: TypeAnnotation*) -> StaticMatchStmt* {
        return new StaticMatchStmt { scrutinee: scrutinee, arms: [] };
    }

    add_arm(mut &this, arm: StaticMatchArmNode*) -> void {
        this.arms.push(arm);
    }

    static walk_children<V>(n: StaticMatchStmt*, v: mut &V) -> void where V: Walk {
        v.walk_annotation(n.scrutinee);
        for (mut i: i64 = 0; i < n.arms.length(); i++) { v.walk_node(Node::StaticArm(n.arms[i])); }
    }
}


type struct ExprStmt {
    expression: ExpressionNode*;

    static walk_children<V>(n: ExprStmt*, v: mut &V) -> void where V: Walk {
        v.walk_expr(n.expression);
    }
}


type struct DeclStmt {
    declaration: DeclarationNode*;

    static walk_children<V>(n: DeclStmt*, v: mut &V) -> void where V: Walk {
        v.walk_decl(n.declaration);
    }
}


/// `loop { body }`: runs until a `break` leaves it.
type struct LoopStmt {
    body: Stmt*;

    static walk_children<V>(n: LoopStmt*, v: mut &V) -> void where V: Walk {
        v.walk_stmt(n.body);
    }
}


/// `new` of a statement payload takes its storage from the AST arena, as the
/// header's does.
implement trait Allocate for struct BlockStmt {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct UnsafeBlockStmt {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct AsmBlockStmt {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct ReturnStmt {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct IfStmt {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct WhileStmt {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct DoWhileStmt {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct ForStmt {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct MatchStmt {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct StaticMatchStmt {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct ExprStmt {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct DeclStmt {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct LoopStmt {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}
