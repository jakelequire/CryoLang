/// AST Statement Nodes
///
/// StatementNode base and all 14 concrete statement classes.

namespace Compiler::AST::Statement;

import Compiler::Diag;
import Compiler::AST;
import Compiler::Diag::SourceSpan;
import Compiler::AST::Node;
import Compiler::AST::Expression;
import Compiler::AST::Declaration;
import Compiler::AST::Pattern;
import Compiler::AST::Visitor;

type class StatementNode : ASTNode {
public:
    StatementNode(kind: NodeKind, span: SourceSpan) : ASTNode(kind, span) {}

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


// Concrete Statement Nodes

type class BlockStmtNode : StatementNode {
public:
    statements: StatementNode*[];
    /// Directives written as `![name(args)]` immediately preceding this
    /// block when it appears in statement position (e.g. `![windows] { ... }`
    /// inside a function body).  Evaluated by the ConfigGating pass:
    /// active blocks are kept, inactive ones have their `statements` list
    /// emptied so codegen sees a no-op block.  Empty for blocks that are
    /// the unconditional body of a function/if/while/etc.
    attached_directives: DirectiveNode*[];
    /// Drop calls synthesised by drop-insertion for a match-*expression* arm
    /// body (a "value block"): the arm's own non-yielded locals.  They must run
    /// AFTER the arm's value expression is materialised (it may read them) and
    /// without displacing the value statement, which stays last for codegen's
    /// arm-value extraction.  Emitting them as trailing statements would make
    /// codegen mistake a drop for the arm value; emitting them before the value
    /// statement would free a local the value expression still reads.  So they
    /// are stashed here and replayed at the end of `generate_block` (preserving
    /// `state.last_value`).  Empty for every non-value block.  Mirrors
    /// `ReturnStmtNode.synth_drops`.
    synth_drops: StatementNode*[];

    BlockStmtNode(span: SourceSpan) : StatementNode(NodeKind::BlockStatement, span) {
        this.statements = [];
        this.attached_directives = [];
        this.synth_drops = [];
    }

    add_statement(stmt: StatementNode*) -> void {
        this.statements.push(stmt);
    }

    add_directive(d: DirectiveNode*) -> void {
        if (d != null) { this.attached_directives.push(d); }
    }

    has_directives() -> boolean { return this.attached_directives.length > 0; }

    /// The block's full written extent: `span` (which starts at `{`) widened
    /// to cover the `![...]` directives that gate it.  Anything highlighting
    /// the gated construct as a whole - the LSP's inactive-region dimming -
    /// needs the directive included, since that is what the reader sees as
    /// the reason the block is compiled out.  Mirrors
    /// `DeclarationNode::outer_span`.
    outer_span(&this) -> SourceSpan {
        mut out: SourceSpan = this.span;
        for (mut i: i64 = 0; i < this.attached_directives.length; i++) {
            const d: DirectiveNode* = this.attached_directives[i];
            if (d != null) {
                out = SourceSpan::covering(out, d.span);
            }
        }
        return out;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class UnsafeBlockStmtNode : StatementNode {
public:
    block: BlockStmtNode*;

    UnsafeBlockStmtNode(block: BlockStmtNode*, span: SourceSpan)
        : StatementNode(NodeKind::UnsafeBlockStatement, span) {
        this.block = block;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


/// Assembly dialect for an `asm` block, selected by the mandatory
/// `![arch(<arch>, <dialect>)]` directive.  Maps to LLVM's
/// `LLVMInlineAsmDialect` (ATT = 0, Intel = 1).
type enum AsmDialect {
    ATT;
    Intel;
}

/// Direction of an `asm` operand, from its `{...}` prefix:
///   `{x}` -> In, `{=x}` -> Out, `{+x}` -> InOut.
type enum AsmOpDir {
    In;
    Out;
    InOut;
}

/// Constraint class of an `asm` operand, from its `:...` suffix.
///   (none) / `:r` -> Reg (any general register)
///   `:"rax"`      -> Pinned (a specific register, name in `pinned_reg`)
///   `:m`          -> Memory (operand passed by address)
///   `:i`          -> Imm (immediate)
type enum AsmConstraintKind {
    Reg;
    Pinned;
    Memory;
    Imm;
}

/// One operand of an `asm` block: a Cryo expression bound into the
/// assembly with a direction and a constraint class.  See
/// `visit(AsmBlockStmtNode*)` in codegen/ir_generator.cryo for lowering.
type class AsmOperand {
public:
    direction: AsmOpDir;
    /// The Cryo operand.  Inputs are read as rvalues; outputs / in-outs
    /// must be assignable lvalues (the call result is stored back).
    expr: ExpressionNode*;
    constraint: AsmConstraintKind;
    /// Register name when `constraint == Pinned` (e.g. "rax"); else "".
    pinned_reg: string;

    AsmOperand(direction: AsmOpDir, expr: ExpressionNode*,
               constraint: AsmConstraintKind, pinned_reg: string) {
        this.direction = direction;
        this.expr = expr;
        this.constraint = constraint;
        this.pinned_reg = pinned_reg;
    }
}

/// One chunk of an `asm` template: either raw assembly text or a
/// reference to an operand (by index into `AsmBlockStmtNode.operands`).
/// Codegen concatenates the pieces, substituting `$N` for operand refs
/// (N assigned in outputs-first constraint order).
type class AsmPiece {
public:
    is_operand: boolean;
    /// Raw assembly text when `!is_operand`.
    text: string;
    /// Index into `operands` when `is_operand`.
    operand_index: i64;

    AsmPiece(is_operand: boolean, text: string, operand_index: i64) {
        this.is_operand = is_operand;
        this.text = text;
        this.operand_index = operand_index;
    }

    static raw(text: string) -> AsmPiece* {
        return new AsmPiece(false, text, 0);
    }

    static operand(index: i64) -> AsmPiece* {
        return new AsmPiece(true, "", index);
    }
}

/// `asm { ... }` inline-assembly block.  The body is captured as raw text
/// pieces interleaved with `{...}` operand references.  A mandatory
/// `![arch(<arch>, <dialect>)]` directive selects the target arch (used to
/// gate the block in the ConfigGating pass) and the dialect.  An optional
/// `![clobber(...)]` directive lists clobbered registers / `flags` / `memory`.
/// A module-level `asm { ... }` (no operands) lowers to module inline asm.
type class AsmBlockStmtNode : StatementNode {
public:
    /// Target architecture from `![arch(...)]` (e.g. "x86_64").
    arch: string;
    dialect: AsmDialect;
    operands: AsmOperand*[];
    pieces: AsmPiece*[];
    /// Clobber tokens from `![clobber(...)]` (register names, "flags", "memory").
    clobbers: string[];
    /// True when written at module scope (naked / global asm, no operands).
    is_module_level: boolean;
    /// The `![arch(...)]` / `![clobber(...)]` directives, kept for the
    /// directive-processing validation pass.
    attached_directives: DirectiveNode*[];

    AsmBlockStmtNode(span: SourceSpan)
        : StatementNode(NodeKind::AsmBlockStatement, span) {
        this.arch = "";
        this.dialect = AsmDialect::ATT;
        this.operands = [];
        this.pieces = [];
        this.clobbers = [];
        this.is_module_level = false;
        this.attached_directives = [];
    }

    add_operand(op: AsmOperand*) -> i64 {
        this.operands.push(op);
        return this.operands.length - 1;
    }

    add_piece(p: AsmPiece*) -> void {
        this.pieces.push(p);
    }

    add_clobber(name: string) -> void {
        this.clobbers.push(name);
    }

    add_directive(d: DirectiveNode*) -> void {
        if (d != null) { this.attached_directives.push(d); }
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class ReturnStmtNode : StatementNode {
public:
    expression: ExpressionNode*;
    /// Drop calls synthesised by the drop-insertion pass that must run
    /// at function exit *after* `expression` has been evaluated.  These
    /// can't be emitted as statements *before* the return because the
    /// return expression may borrow a local that is being dropped; see
    /// `walk_stmt_into` in passes/drop_insertion.cryo and the matching
    /// sequencing in `visit(ReturnStmtNode*)` in codegen/ir_generator.cryo.
    synth_drops: StatementNode*[];

    ReturnStmtNode(expression: ExpressionNode*, span: SourceSpan)
        : StatementNode(NodeKind::ReturnStatement, span) {
        this.expression = expression;
        this.synth_drops = [];
    }

    has_expression() -> boolean { return this.expression != null; }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class IfStmtNode : StatementNode {
public:
    condition: ExpressionNode*;
    then_stmt: StatementNode*;
    else_stmt: StatementNode*;

    IfStmtNode(condition: ExpressionNode*, then_stmt: StatementNode*,
               else_stmt: StatementNode*, span: SourceSpan)
        : StatementNode(NodeKind::IfStatement, span) {
        this.condition = condition;
        this.then_stmt = then_stmt;
        this.else_stmt = else_stmt;
    }

    has_else() -> boolean { return this.else_stmt != null; }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class WhileStmtNode : StatementNode {
public:
    condition: ExpressionNode*;
    body:      StatementNode*;

    WhileStmtNode(condition: ExpressionNode*, body: StatementNode*, span: SourceSpan)
        : StatementNode(NodeKind::WhileStatement, span) {
        this.condition = condition;
        this.body      = body;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class DoWhileStmtNode : StatementNode {
public:
    body:      StatementNode*;
    condition: ExpressionNode*;

    DoWhileStmtNode(body: StatementNode*, condition: ExpressionNode*, span: SourceSpan)
        : StatementNode(NodeKind::DoWhileStatement, span) {
        this.body      = body;
        this.condition = condition;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class ForStmtNode : StatementNode {
public:
    init:      ASTNode*;
    condition: ExpressionNode*;
    update:    ExpressionNode*;
    body:      StatementNode*;

    ForStmtNode(init: ASTNode*, condition: ExpressionNode*,
                update: ExpressionNode*, body: StatementNode*, span: SourceSpan)
        : StatementNode(NodeKind::ForStatement, span) {
        this.init      = init;
        this.condition = condition;
        this.update    = update;
        this.body      = body;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class MatchStmtNode : StatementNode {
public:
    subject: ExpressionNode*;
    arms:    MatchArmNode*[];

    /// `--panic=unwind` cleanup schedule for the synthesized non-exhaustive
    /// `no_match` guard, so a scrutinee matching no arm runs the frame's local
    /// destructors on unwind.  See `CallExprNode.unwind_cleanup`.
    unwind_cleanup: ASTNode*[];

    MatchStmtNode(subject: ExpressionNode*, span: SourceSpan)
        : StatementNode(NodeKind::MatchStatement, span) {
        this.subject = subject;
        this.arms    = [];
        this.unwind_cleanup = [];
    }

    add_arm(arm: MatchArmNode*) -> void {
        this.arms.push(arm);
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


/// Statement-position `static match (T) { ... }` - used when arms yield no value
/// (e.g. an `Atomic<T>::store` body). Same compile-time pruning semantics as
/// StaticMatchExprNode; the reduced single arm's block is emitted for effect.
type class StaticMatchStmtNode : StatementNode {
public:
    scrutinee: TypeAnnotation*;
    arms:      StaticMatchArmNode*[];

    StaticMatchStmtNode(scrutinee: TypeAnnotation*, span: SourceSpan)
        : StatementNode(NodeKind::StaticMatchStatement, span) {
        this.scrutinee = scrutinee;
        this.arms      = [];
    }

    add_arm(arm: StaticMatchArmNode*) -> void {
        this.arms.push(arm);
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class BreakStmtNode : StatementNode {
public:
    BreakStmtNode(span: SourceSpan) : StatementNode(NodeKind::BreakStatement, span) {}

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class ContinueStmtNode : StatementNode {
public:
    ContinueStmtNode(span: SourceSpan) : StatementNode(NodeKind::ContinueStatement, span) {}

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class ExprStmtNode : StatementNode {
public:
    expression: ExpressionNode*;

    ExprStmtNode(expression: ExpressionNode*, span: SourceSpan)
        : StatementNode(NodeKind::ExpressionStatement, span) {
        this.expression = expression;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class DeclStmtNode : StatementNode {
public:
    declaration: DeclarationNode*;

    DeclStmtNode(declaration: DeclarationNode*, span: SourceSpan)
        : StatementNode(NodeKind::DeclarationStatement, span) {
        this.declaration = declaration;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


// Loop Statement: loop { body }  (infinite loop, break to exit)

type class LoopStmtNode : StatementNode {
public:
    body: StatementNode*;

    LoopStmtNode(body: StatementNode*, span: SourceSpan)
        : StatementNode(NodeKind::LoopStatement, span) {
        this.body = body;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}
