/// AST Declaration Nodes
///
/// DeclarationNode base and all 17 concrete declaration classes.
///
/// String type convention:
///   SymbolStr: identifiers and names that may be looked up (e.g., variable
///               names, type names, field names, import aliases).  Interned
///               for O(1) equality.
///   string:   paths, qualified paths, documentation, literal values, and
///               other user-visible text that is never used as a lookup key.

namespace Compiler::AST::Declaration;

import Compiler::Diag;
import Compiler::Diag::SourceSpan;
import Compiler::AST;
import Compiler::AST::{ Node, Expression, Statement, Pattern };
import Compiler::Types::TypeRef;
import Compiler::Resolver::SymbolStr;

type class DeclarationNode : ASTNode {
public:
    documentation:       string;
    source_module:       string;
    name_span:           SourceSpan;
    /// Directives written as `![name(args)]` immediately preceding this
    /// declaration in source order.
    attached_directives: DirectiveNode*[];

    DeclarationNode(kind: NodeKind, span: SourceSpan) : ASTNode(kind, span) {
        this.documentation       = "";
        this.source_module       = "";
        this.name_span           = SourceSpan::none();
        this.attached_directives = [];
    }

    has_documentation() -> boolean { return this.documentation != ""; }
    is_from_import() -> boolean    { return this.source_module != ""; }
    has_name_span() -> boolean     { return this.name_span.has_location(); }
    has_directives() -> boolean    { return this.attached_directives.length > 0; }

    set_documentation(doc: string) -> void  { this.documentation = doc; }
    set_source_module(mod: string) -> void  { this.source_module = mod; }
    set_name_span(span: SourceSpan) -> void { this.name_span = span; }
    add_directive(d: DirectiveNode*) -> void {
        if (d != null) { this.attached_directives.push(d); }
    }

    find_directive(&this, name: string) -> DirectiveNode* {
        for (mut i: i64 = 0; i < this.attached_directives.length; i++) {
            const d: DirectiveNode* = this.attached_directives[i];
            if (d != null && d.directive_kind.eq(name)) {
                return d;
            }
        }
        return null;
    }

    has_directive(&this, name: string) -> boolean {
        return this.find_directive(name) != null;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


// Concrete Declaration Nodes

type class VarDeclNode : DeclarationNode {
public:
    name:            SymbolStr;
    initializer:     ExpressionNode*;
    is_mutable:      boolean;
    is_auto:         boolean;
    is_global:       boolean;
    type_annotation: TypeAnnotation*;
    resolved_type:   TypeRef;
    /// Location of the binding's mutability keyword (`const` or `mut`).
    /// For parameters that did NOT carry a `mut` keyword, this is the
    /// zero-width point just before the parameter name - an "insert
    /// `mut ` here" anchor that lets E0218 emit a precise quickfix.
    /// `SourceSpan::none()` when the parser had no keyword to record
    /// (synthesized declarations, errored input).
    kw_span:         SourceSpan;
    /// True for synthesized non-owning aliases (today: the shadow bindings
    /// inside a `move` lambda's `__call__` body, which alias a captured
    /// non-Copy field of `this` so the body can keep its original name
    /// resolution but doesn't double-drop with the closure-struct's own
    /// drop).  drop_insertion skips the scope-exit drop for these bindings.
    is_capture_alias: boolean;
    /// True for synthesized conditional-drop flag locals
    /// (`<name>__dropflag<N>`).  Their alloca is function-scoped but the
    /// conditional drop that reads them can run in an OUTER scope, after the
    /// declaring block popped; codegen registers their name binding
    /// persistently (see ValueTable::set_persistent) so the reader still
    /// resolves it.  Set by drop_insertion::make_drop_flag_decl.
    is_drop_flag: boolean;
    /// When set, this global was synthesized by the C-header import engine and
    /// is reachable ONLY through its extern-module alias namespace
    /// (`cit::SOME_CONST`, via the decl_index qualified key) — never bare.
    /// Mirrors StructDeclNode/EnumDeclNode/TypeAliasDeclNode.binding_namespace.
    /// Empty for ordinary source-level declarations.
    binding_namespace: SymbolStr;

    VarDeclNode(name: SymbolStr, span: SourceSpan)
        : DeclarationNode(NodeKind::VariableDeclaration, span) {
        this.name             = name;
        this.initializer      = null;
        this.is_mutable       = false;
        this.is_auto          = false;
        this.is_global        = false;
        this.type_annotation  = null;
        this.resolved_type    = TypeRef::invalid();
        this.kw_span          = SourceSpan::none();
        this.is_capture_alias = false;
        this.is_drop_flag     = false;
        this.binding_namespace = SymbolStr::empty();
    }

    has_initializer() -> boolean     { return this.initializer != null; }
    has_type_annotation() -> boolean { return this.type_annotation != null; }
    has_resolved_type() -> boolean   { return this.resolved_type.is_valid(); }
    has_kw_span() -> boolean         { return this.kw_span.has_location(); }

    set_initializer(expr: ExpressionNode*) -> void  { this.initializer = expr; }
    set_mutable(v: boolean) -> void                 { this.is_mutable = v; }
    set_auto(v: boolean) -> void                    { this.is_auto = v; }
    set_global(v: boolean) -> void                  { this.is_global = v; }
    set_type_annotation(a: TypeAnnotation*) -> void { this.type_annotation = a; }
    set_resolved_type(t: TypeRef) -> void           { this.resolved_type = t; }
    set_kw_span(s: SourceSpan) -> void              { this.kw_span = s; }
    set_capture_alias(v: boolean) -> void           { this.is_capture_alias = v; }
    set_drop_flag(v: boolean) -> void               { this.is_drop_flag = v; }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


// DestructureDeclNode: `const { f1, f2: alias, mut f3 }: T = expr;`
//
// Binds individual fields of a struct/class value to fresh locals.  Full
// destructure (every field of T bound) consumes the RHS, which the move-
// checker treats as a composite move; drop is suppressed on the RHS root.

type struct DestructureBinding {
    source_field:  SymbolStr;     // field name on the struct
    local_name:    SymbolStr;     // bound local (== source_field unless renamed)
    is_mutable:    boolean;       // per-field mut
    span:          SourceSpan;    // span of the whole binding entry
    name_span:     SourceSpan;    // span of just the local name
    resolved_type: TypeRef;       // sema fills from the struct field's type

    static new(source_field: SymbolStr, local_name: SymbolStr, is_mutable: boolean,
               span: SourceSpan, name_span: SourceSpan) -> DestructureBinding {
        return DestructureBinding {
            source_field:  source_field,
            local_name:    local_name,
            is_mutable:    is_mutable,
            span:          span,
            name_span:     name_span,
            resolved_type: TypeRef::invalid(),
        };
    }
}


type class DestructureDeclNode : DeclarationNode {
public:
    bindings:        DestructureBinding[];
    type_annotation: TypeAnnotation*;
    initializer:     ExpressionNode*;
    resolved_type:   TypeRef;       // resolved composite type
    is_mutable:      boolean;       // declaration-level (`const` vs `mut`)

    DestructureDeclNode(span: SourceSpan)
        : DeclarationNode(NodeKind::DestructureDeclaration, span) {
        this.bindings        = [];
        this.type_annotation = null;
        this.initializer     = null;
        this.resolved_type   = TypeRef::invalid();
        this.is_mutable      = false;
    }

    has_initializer() -> boolean     { return this.initializer != null; }
    has_type_annotation() -> boolean { return this.type_annotation != null; }
    has_resolved_type() -> boolean   { return this.resolved_type.is_valid(); }

    add_binding(b: DestructureBinding) -> void {
        this.bindings.push(b);
    }

    set_initializer(expr: ExpressionNode*) -> void  { this.initializer = expr; }
    set_type_annotation(a: TypeAnnotation*) -> void { this.type_annotation = a; }
    set_resolved_type(t: TypeRef) -> void           { this.resolved_type = t; }
    set_mutable(v: boolean) -> void                 { this.is_mutable = v; }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class FunctionDeclNode : DeclarationNode {
public:
    name:                   SymbolStr;
    parameters:             VarDeclNode*[];
    generic_params:         GenericParamNode*[];
    trait_bounds:           TraitBound[];
    body:                   BlockStmtNode*;
    is_public:              boolean;
    is_static:              boolean;
    /// `![inline]` was applied: codegen attaches LLVM `alwaysinline`.
    is_inline:              boolean;
    /// `![noinline]` was applied: codegen attaches LLVM `noinline`.  Kept
    /// distinct from `!is_inline` so the unspecified default (neither flag)
    /// emits no inlining attribute at all - the two directives are mutually
    /// exclusive and the validator rejects applying both.
    is_noinline:            boolean;
    is_variadic:            boolean;
    /// `![implicit]` was applied. Permits the inference engine to recover
    /// omitted generic type args at a call site by unifying this function's
    /// declared return type against the call's expected type. Set by
    /// directive_processing; consumed by the monomorphizer's call inference.
    is_implicit:            boolean;
    /// Set when this function was synthesized by cloning a trait default
    /// method into an impl block (see `synthesize_default_trait_methods`).
    /// The monomorphizer's call-site inference uses it to know a generic
    /// trait method on a non-generic owner needs specializing through the
    /// trait-impl fallback - hand-written trait methods reach that point
    /// through their own route and must not be re-specialized there.
    is_synth_default:       boolean;
    /// Set on a synthesized trait-default clone whose return type mentions
    /// `This` (e.g. the iterator combinators `map`/`filter`/`take` returning
    /// `MapIter<This, ...>`).  Such methods are self-referential: synthesized
    /// into an adapter's own impl they would instantiate `Adapter<Adapter<…>>`
    /// ad infinitum.  They must therefore be instantiated lazily (only when
    /// actually called), like generic methods - never eagerly per impl.  The
    /// monomorphizer skips them in `resolve_methods` and drives them through
    /// the call-site inference path instead.
    is_self_returning_default: boolean;
    /// Anti-tower flag for an INHERENT method whose return (or a param) is a
    /// strict structural superterm of its owner (e.g. `Option<T>::as_ref ->
    /// Option<T*>`). Eagerly materializing it would instantiate
    /// `Option<T*>` -> `Option<T**>` -> ... without bound. Like
    /// `is_self_returning_default` it is deferred from eager mono/codegen and
    /// driven through the call-site lazy path, BUT - unlike a trait-default
    /// combinator - it MUST stay visible to the DeclarationIndex and sema call
    /// resolution (an inherent method has no trait to resolve through), so it
    /// is a SEPARATE flag checked only at the materialization/codegen sites.
    is_lazy_self_growing:   boolean;
    /// `![link("name")]` linker-symbol override for an extern function.
    /// When `has_link_name` is set, codegen names the LLVM declaration
    /// `link_name` instead of the Cryo source name, so the symbol resolved
    /// at link time is the C library's, while Cryo callers still use the
    /// declared name.
    link_name:              string;
    has_link_name:          boolean;
    return_type_annotation: TypeAnnotation*;
    resolved_return_type:   TypeRef;
    /// When this function is a method of an `implement trait T for U` block,
    /// the trait's leaf name (e.g. `Eq`).  Empty for inherent methods and
    /// free functions.  Stamped during type resolution and read by every
    /// mangling site so a trait-impl method's symbol carries its trait
    /// (`C$tr$<trait>$f<owner>-<method>`); without it two distinct traits
    /// that define a same-named method for the same type mangle identically
    /// and collide at link time.  See `MangledName::for_method_or_trait_impl`.
    origin_trait:           SymbolStr;
    /// Concrete type arguments of a generic-METHOD specialization (`m<T>` with
    /// `T = i64`), set by the monomorphizer's `specialize_method` on the cloned
    /// spec.  Empty on every template / non-spec function.  Folded into the
    /// mangled symbol (`$MG…`) at both the mono call-site pin and the codegen
    /// definition so that two specs of one method whose SIGNATURE doesn't
    /// depend on `T` (e.g. `name<T>() -> string`) get distinct LLVM symbols
    /// instead of collapsing onto the first.  See
    /// `MangledName::with_method_spec_args`.
    spec_type_args:         TypeRef[];

    FunctionDeclNode(name: SymbolStr, span: SourceSpan)
        : DeclarationNode(NodeKind::FunctionDeclaration, span) {
        this.name                   = name;
        this.parameters             = [];
        this.generic_params         = [];
        this.trait_bounds           = [];
        this.body                   = null;
        this.is_public              = false;
        this.is_static              = false;
        this.is_inline              = false;
        this.is_noinline            = false;
        this.is_variadic            = false;
        this.is_implicit            = false;
        this.is_synth_default       = false;
        this.is_self_returning_default = false;
        this.is_lazy_self_growing   = false;
        this.link_name              = "";
        this.has_link_name          = false;
        this.return_type_annotation = null;
        this.resolved_return_type   = TypeRef::invalid();
        this.origin_trait           = SymbolStr::empty();
        this.spec_type_args         = [];
    }

    has_body() -> boolean                 { return this.body != null; }
    is_generic() -> boolean               { return this.generic_params.length > 0; }
    has_resolved_return_type() -> boolean { return this.resolved_return_type.is_valid(); }

    add_parameter(param: VarDeclNode*) -> void {
        this.parameters.push(param);
    }

    add_generic_param(param: GenericParamNode*) -> void {
        this.generic_params.push(param);
    }

    add_trait_bound(bound: TraitBound) -> void {
        this.trait_bounds.push(bound);
    }

    set_name(n: SymbolStr) -> void                           { this.name = n; }
    set_body(b: BlockStmtNode*) -> void                     { this.body = b; }
    set_public(v: boolean) -> void                          { this.is_public = v; }
    set_static(v: boolean) -> void                          { this.is_static = v; }
    set_inline(v: boolean) -> void                          { this.is_inline = v; }
    set_noinline(v: boolean) -> void                        { this.is_noinline = v; }
    set_variadic(v: boolean) -> void                        { this.is_variadic = v; }
    set_implicit(v: boolean) -> void                        { this.is_implicit = v; }
    set_synth_default(v: boolean) -> void                   { this.is_synth_default = v; }
    set_self_returning_default(v: boolean) -> void          { this.is_self_returning_default = v; }
    set_lazy_self_growing(v: boolean) -> void               { this.is_lazy_self_growing = v; }
    set_return_type_annotation(a: TypeAnnotation*) -> void  { this.return_type_annotation = a; }
    set_resolved_return_type(t: TypeRef) -> void             { this.resolved_return_type = t; }
    set_origin_trait(t: SymbolStr) -> void                   { this.origin_trait = t; }
    set_spec_type_args(a: TypeRef[]) -> void                 { this.spec_type_args = a; }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


/// Method node uses composition: holds a FunctionDeclNode* for the function
/// signature and body, plus method-specific flags.
type class MethodNode : DeclarationNode {
public:
    func:                  FunctionDeclNode*;
    visibility:            Visibility;
    is_constructor:        boolean;
    is_destructor:         boolean;
    is_static:             boolean;
    is_default_destructor: boolean;
    is_virtual:            boolean;
    is_override:           boolean;
    /// `![sink]` was applied to this method.  Set by
    /// directive_processing.  Tells move-check + drop-insertion to
    /// treat the call as moving the receiver, even when the receiver
    /// is syntactically `&this` / `mut &this`.  See the
    /// `OwnershipQuery::method_consumes_receiver` helper.
    is_sink:               boolean;
    base_ctor_name:        SymbolStr;
    base_ctor_args:        ExpressionNode*[];

    MethodNode(func: FunctionDeclNode*, span: SourceSpan)
        : DeclarationNode(NodeKind::MethodDeclaration, span) {
        this.func                  = func;
        this.visibility            = Visibility::Public;
        this.is_constructor        = false;
        this.is_destructor         = false;
        this.is_static             = false;
        this.is_default_destructor = false;
        this.is_virtual            = false;
        this.is_override           = false;
        this.is_sink               = false;
        this.base_ctor_name        = SymbolStr::empty();
        this.base_ctor_args        = [];
    }

    has_base_ctor() -> boolean { return this.base_ctor_name.is_valid(); }

    set_visibility(v: Visibility) -> void       { this.visibility = v; }
    set_constructor(v: boolean) -> void         { this.is_constructor = v; }
    set_destructor(v: boolean) -> void          { this.is_destructor = v; }
    set_static(v: boolean) -> void              { this.is_static = v; }
    set_default_destructor(v: boolean) -> void  { this.is_default_destructor = v; }
    set_virtual(v: boolean) -> void             { this.is_virtual = v; }
    set_override(v: boolean) -> void            { this.is_override = v; }
    set_sink(v: boolean) -> void                { this.is_sink = v; }
    set_base_ctor_name(name: SymbolStr) -> void  { this.base_ctor_name = name; }

    add_base_ctor_arg(arg: ExpressionNode*) -> void {
        this.base_ctor_args.push(arg);
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class IntrinsicDeclNode : DeclarationNode {
public:
    name:                    SymbolStr;
    parameters:              VarDeclNode*[];
    body:                    BlockStmtNode*;
    resolved_return_type:    TypeRef;
    return_type_annotation:  TypeAnnotation*;
    is_variadic:             boolean;

    IntrinsicDeclNode(name: SymbolStr, span: SourceSpan)
        : DeclarationNode(NodeKind::IntrinsicDeclaration, span) {
        this.name                    = name;
        this.parameters              = [];
        this.body                    = null;
        this.resolved_return_type    = TypeRef::invalid();
        this.return_type_annotation  = null;
        this.is_variadic             = false;
    }

    has_body() -> boolean                 { return this.body != null; }
    has_resolved_return_type() -> boolean { return this.resolved_return_type.is_valid(); }

    add_parameter(param: VarDeclNode*) -> void {
        this.parameters.push(param);
    }

    set_body(b: BlockStmtNode*) -> void                          { this.body = b; }
    set_resolved_return_type(t: TypeRef) -> void                 { this.resolved_return_type = t; }
    set_return_type_annotation(a: TypeAnnotation*) -> void       { this.return_type_annotation = a; }
    set_variadic(v: boolean) -> void                             { this.is_variadic = v; }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class IntrinsicConstDeclNode : DeclarationNode {
public:
    name:            SymbolStr;
    type_annotation: TypeAnnotation*;
    resolved_type:   TypeRef;

    IntrinsicConstDeclNode(name: SymbolStr, span: SourceSpan)
        : DeclarationNode(NodeKind::IntrinsicConstDeclaration, span) {
        this.name            = name;
        this.type_annotation = null;
        this.resolved_type   = TypeRef::invalid();
    }

    has_resolved_type() -> boolean        { return this.resolved_type.is_valid(); }
    set_resolved_type(t: TypeRef) -> void { this.resolved_type = t; }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class ImportDeclNode : DeclarationNode {
public:
    module_path:      string;        // qualified path (e.g., "Compiler::AST")
    alias:            SymbolStr;     // identifier name for `import ... as Alias`
    specific_imports: SymbolStr[];
    style:            ImportStyle;

    /// Per-segment metadata for `import std::core::panic;`:
    /// `path_segments[i]` is the i-th identifier and
    /// `path_segment_spans[i]` is its exact span in source.  Used by
    /// the LSP to dispatch hover/go-to on an individual segment
    /// (`std` shows the `std` namespace's public modules; `core` the
    /// `std::core` ones; etc.).  Aligned with `module_path`'s
    /// `::`-joined form so the i-th segment's effective namespace is
    /// `segments[0..=i]` joined by `::`.
    path_segments:      SymbolStr[];
    path_segment_spans: SourceSpan[];

    ImportDeclNode(module_path: string, style: ImportStyle, span: SourceSpan)
        : DeclarationNode(NodeKind::ImportDeclaration, span) {
        this.module_path        = module_path;
        this.alias              = SymbolStr::empty();
        this.specific_imports   = [];
        this.style              = style;
        this.path_segments      = [];
        this.path_segment_spans = [];
    }

    has_alias() -> boolean { return !this.alias.is_empty(); }

    set_alias(a: SymbolStr) -> void { this.alias = a; }

    add_specific_import(name: SymbolStr) -> void {
        this.specific_imports.push(name);
    }

    add_path_segment(name: SymbolStr, span: SourceSpan) -> void {
        this.path_segments.push(name);
        this.path_segment_spans.push(span);
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class ModuleDeclNode : DeclarationNode {
public:
    path:      string;
    is_public: boolean;

    /// Per-segment metadata mirroring `ImportDeclNode`, populated by
    /// the parser for both `namespace X::Y::Z;` and
    /// `public module X::Y;` decls so the LSP can hover/go-to on an
    /// individual segment.
    path_segments:      SymbolStr[];
    path_segment_spans: SourceSpan[];

    ModuleDeclNode(path: string, is_public: boolean, span: SourceSpan)
        : DeclarationNode(NodeKind::ModuleDeclaration, span) {
        this.path               = path;
        this.is_public          = is_public;
        this.path_segments      = [];
        this.path_segment_spans = [];
    }

    add_path_segment(name: SymbolStr, span: SourceSpan) -> void {
        this.path_segments.push(name);
        this.path_segment_spans.push(span);
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class StructDeclNode : DeclarationNode {
public:
    name:           SymbolStr;
    generic_params: GenericParamNode*[];
    fields:         FieldDeclNode*[];
    methods:        MethodNode*[];
    /// Layout attributes derived from `![repr(...)]` / `![align(N)]`
    /// directives.  Populated by the DirectiveProcessing pass before
    /// TypeResolution copies them onto the StructType so TypeLowering
    /// and codegen can read the chosen layout.  `repr_c`, `repr_packed`,
    /// and `repr_transparent` are mutually exclusive (enforced by
    /// DirectiveProcessing).  `min_alignment` is 0 when no `![align]`
    /// directive applies; otherwise a power-of-two byte count.
    repr_c:           boolean;
    repr_packed:      boolean;
    repr_transparent: boolean;
    min_alignment:    u64;
    /// `public` (the default at top level) vs `private`. Drives cross-module
    /// visibility: a `private` type is only nameable within its own module.
    is_public:        boolean;
    /// When set, this struct is qualified under this extern-module *alias*
    /// namespace instead of the importing file's `namespace`.  Set ONLY by
    /// the C-header import engine (`Compiler::Bindgen`) for a struct/union
    /// synthesized from an `extern module probe := "C" { #include ... }`
    /// block, so it registers as `probe::Point` just like the block's extern
    /// functions register as `probe::fn`.  Empty for every parser-produced
    /// struct.  A dedicated channel kept separate from `source_module` (which
    /// the monomorphizer uses for spec namespaces).  See
    /// CompilationContext::qualify_binding_sym.
    binding_namespace: SymbolStr;

    StructDeclNode(name: SymbolStr, span: SourceSpan)
        : DeclarationNode(NodeKind::StructDeclaration, span) {
        this.name              = name;
        this.generic_params    = [];
        this.fields            = [];
        this.methods           = [];
        this.repr_c            = false;
        this.repr_packed       = false;
        this.repr_transparent  = false;
        this.min_alignment     = 0;
        this.is_public         = true;
        this.binding_namespace = SymbolStr::empty();
    }

    is_generic() -> boolean { return this.generic_params.length > 0; }
    set_name(n: SymbolStr) -> void { this.name = n; }
    set_public(p: boolean) -> void { this.is_public = p; }

    add_generic_param(param: GenericParamNode*) -> void {
        this.generic_params.push(param);
    }

    add_field(field: FieldDeclNode*) -> void {
        this.fields.push(field);
    }

    add_method(method: MethodNode*) -> void {
        this.methods.push(method);
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class ClassDeclNode : DeclarationNode {
public:
    name:           SymbolStr;
    generic_params: GenericParamNode*[];
    fields:         FieldDeclNode*[];
    methods:        MethodNode*[];
    base_class:     SymbolStr;
    /// Layout attributes - see StructDeclNode for the full description.
    repr_c:           boolean;
    repr_packed:      boolean;
    repr_transparent: boolean;
    min_alignment:    u64;
    /// `public`/`private` - see StructDeclNode.is_public.
    is_public:        boolean;

    ClassDeclNode(name: SymbolStr, span: SourceSpan)
        : DeclarationNode(NodeKind::ClassDeclaration, span) {
        this.name             = name;
        this.generic_params   = [];
        this.fields           = [];
        this.methods          = [];
        this.base_class       = SymbolStr::empty();
        this.repr_c           = false;
        this.repr_packed      = false;
        this.repr_transparent = false;
        this.min_alignment    = 0;
        this.is_public        = true;
    }

    is_generic() -> boolean     { return this.generic_params.length > 0; }
    has_base_class() -> boolean { return this.base_class.is_valid(); }
    set_name(n: SymbolStr) -> void { this.name = n; }
    set_public(p: boolean) -> void { this.is_public = p; }

    add_generic_param(param: GenericParamNode*) -> void {
        this.generic_params.push(param);
    }

    add_field(field: FieldDeclNode*) -> void {
        this.fields.push(field);
    }

    add_method(method: MethodNode*) -> void {
        this.methods.push(method);
    }

    set_base_class(name: SymbolStr) -> void {
        this.base_class = name;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


/// An associated-type member declared inside a trait body: `type Item;` or
/// `type Item: Copy + Clone;`. `bounds` holds the declaration-site trait
/// constraints (empty for an unbounded `type Item;`). Stored on
/// `TraitDeclNode.assoc_types`; bound concretely per-impl (see ImplBlockNode's
/// assoc bindings) and projected via `TypeAnnotation::Projection`.
type struct AssocTypeDeclNode {
    name:   SymbolStr;
    bounds: TraitRef[];
    span:   SourceSpan;
}

type class TraitDeclNode : DeclarationNode {
public:
    name:           SymbolStr;
    generic_params: GenericParamNode*[];
    methods:        FunctionDeclNode*[];
    base_traits:    BaseTraitInfo[];
    /// Associated-type members (`type Item;`). Empty for traits without any.
    assoc_types:    AssocTypeDeclNode*[];

    TraitDeclNode(name: SymbolStr, span: SourceSpan)
        : DeclarationNode(NodeKind::TraitDeclaration, span) {
        this.name           = name;
        this.generic_params = [];
        this.methods        = [];
        this.base_traits    = [];
        this.assoc_types    = [];
    }

    is_generic() -> boolean { return this.generic_params.length > 0; }
    has_assoc_types() -> boolean { return this.assoc_types.length > 0; }

    add_generic_param(param: GenericParamNode*) -> void {
        this.generic_params.push(param);
    }

    add_method(method: FunctionDeclNode*) -> void {
        this.methods.push(method);
    }

    add_base_trait(info: BaseTraitInfo) -> void {
        this.base_traits.push(info);
    }

    add_assoc_type(decl: AssocTypeDeclNode*) -> void {
        this.assoc_types.push(decl);
    }

    /// The associated-type decl named `n`, or null if the trait has none such.
    lookup_assoc_type(&this, n: SymbolStr) -> AssocTypeDeclNode* {
        for (mut i: i64 = 0; i < this.assoc_types.length; i++) {
            if (this.assoc_types[i].name.equals(n)) { return this.assoc_types[i]; }
        }
        return null;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class TypeAliasDeclNode : DeclarationNode {
public:
    alias_name:        SymbolStr;
    generic_params:    GenericParamNode*[];
    target_annotation: TypeAnnotation*;
    resolved_target:   TypeRef;
    /// See StructDeclNode.binding_namespace: set only for a C-imported typedef
    /// synthesized into an extern module's alias namespace.
    binding_namespace: SymbolStr;

    TypeAliasDeclNode(alias_name: SymbolStr, span: SourceSpan)
        : DeclarationNode(NodeKind::TypeAliasDeclaration, span) {
        this.alias_name        = alias_name;
        this.generic_params    = [];
        this.target_annotation = null;
        this.resolved_target   = TypeRef::invalid();
        this.binding_namespace = SymbolStr::empty();
    }

    is_generic() -> boolean          { return this.generic_params.length > 0; }
    has_resolved_target() -> boolean { return this.resolved_target.is_valid(); }

    add_generic_param(param: GenericParamNode*) -> void {
        this.generic_params.push(param);
    }
    set_target_annotation(a: TypeAnnotation*) -> void  { this.target_annotation = a; }
    set_resolved_target(t: TypeRef) -> void            { this.resolved_target = t; }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class EnumDeclNode : DeclarationNode {
public:
    name:           SymbolStr;
    generic_params: GenericParamNode*[];
    variants:       EnumVariantNode*[];
    /// Optional explicit discriminant type: `type enum Foo : i32 { ... }`.
    /// Null when omitted (the default integer width applies). Used by FFI
    /// enums that must round-trip through a specific C ABI width.
    discriminant_annotation: TypeAnnotation*;
    /// Layout attributes derived from `![repr(...)]` / `![align(N)]`.
    /// `repr_c` is accepted for enums (currently a no-op marker; full
    /// C-ABI layout for ADT enums is post-1.0 work).  `repr_packed` is
    /// rejected for enums by DirectiveProcessing.  `min_alignment` is
    /// honoured by TypeLowering.
    repr_c:           boolean;
    min_alignment:    u64;
    /// `public`/`private` - see StructDeclNode.is_public.
    is_public:        boolean;
    /// See StructDeclNode.binding_namespace: set only for a C-imported enum
    /// synthesized into an extern module's alias namespace.
    binding_namespace: SymbolStr;

    EnumDeclNode(name: SymbolStr, span: SourceSpan)
        : DeclarationNode(NodeKind::EnumDeclaration, span) {
        this.name                    = name;
        this.generic_params          = [];
        this.variants                = [];
        this.discriminant_annotation = null;
        this.repr_c                  = false;
        this.min_alignment           = 0;
        this.is_public               = true;
        this.binding_namespace       = SymbolStr::empty();
    }

    is_generic() -> boolean { return this.generic_params.length > 0; }
    has_discriminant_annotation(&this) -> boolean { return this.discriminant_annotation != null; }
    set_name(n: SymbolStr) -> void { this.name = n; }
    set_public(p: boolean) -> void { this.is_public = p; }

    add_generic_param(param: GenericParamNode*) -> void {
        this.generic_params.push(param);
    }

    add_variant(variant: EnumVariantNode*) -> void {
        this.variants.push(variant);
    }

    set_discriminant_annotation(mut &this, ann: TypeAnnotation*) -> void {
        this.discriminant_annotation = ann;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class EnumVariantNode : DeclarationNode {
public:
    name:             SymbolStr;
    associated_types: TypeAnnotation*[];
    explicit_value:   i64;
    has_value:        boolean;

    EnumVariantNode(name: SymbolStr, span: SourceSpan)
        : DeclarationNode(NodeKind::EnumVariant, span) {
        this.name             = name;
        this.associated_types = [];
        this.explicit_value   = 0;
        this.has_value        = false;
    }

    add_associated_type(t: TypeAnnotation*) -> void {
        this.associated_types.push(t);
    }

    set_explicit_value(v: i64) -> void {
        this.explicit_value = v;
        this.has_value      = true;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class ImplBlockNode : DeclarationNode {
public:
    target_type:    SymbolStr;
    /// The qualified target name as DI/sema registered it (e.g. `i32` ->
    /// `std::core::hash::i32` for an impl in `namespace std::core::hash`,
    /// or `std::collections::array::Array_i32` for spec'd structs).  Set
    /// by the TypeResolution pass when registering the impl in the DI.
    /// Used by the monomorphizer when registering newly-created spec
    /// methods, so the spec's DI keys line up with the keys sema-time
    /// registration used for the template.  Empty until stamped.
    qualified_target_name: SymbolStr;
    generic_params: GenericParamNode*[];
    /// The target type's own type arguments as written after `for`
    /// (the `<T>` in `implement<T> trait Iterator<T> for Range<T>`).
    /// Captured so `This` in a cloned default method's signature can be
    /// rewritten to the full Self type `Range<T>` rather than the bare
    /// `Range`, which would drop the args and mis-resolve.  Empty for
    /// non-generic targets and inherent impls.
    target_args:    TypeAnnotation*[];
    methods:        MethodNode*[];
    /// The trait being implemented. Null = inherent impl (existing form).
    /// Non-null = `implement [<T>] trait <Path>[<args>] for <Target>` form.
    /// Holds the trait reference as a TypeAnnotation so the trait's own
    /// generic args (e.g. `Iterator<T>`) are preserved verbatim.
    trait_annotation: TypeAnnotation*;
    /// `where T: Bound + Bound2, U: Other` constraints from the impl head.
    /// Empty for impls without a where clause.
    where_bounds:   TraitBound[];
    /// Source span of the target-type lexeme in the impl head (the
    /// `Stdin` in `implement trait Read for struct Stdin {`).  Used by
    /// the LSP to detect cursor on the target name and render the
    /// type's hover / jump to its declaration.
    target_type_span: SourceSpan;

    /// Concrete trait-element bindings captured at impl-specialization time
    /// (parallel arrays: name -> resolved concrete TypeRef).  Populated by the
    /// monomorphizer for a SPEC'd trait impl whose Self type doesn't carry the
    /// trait's element as a struct parameter - e.g. `A` in
    /// `implement<I, A> Iterator<A> for TakeIter<I> where I: Iterator<A>`,
    /// where `A` is recovered from the where-bound (`A := i32`) rather than from
    /// a struct arg.  A self-returning default method (`map`/`filter`) cloned
    /// into such an impl keeps that element name (`A`) bare in its signature;
    /// when the default is lazily specialized at a chained call site
    /// (`r.take(n).map(f)`), `specialize_method` re-seeds these bindings into its
    /// resolution context so the element resolves concretely instead of leaving
    /// an unresolved `Named("A")` that would reject the spec (E0636).  Empty on
    /// template impls and on impls whose element is already a struct parameter.
    derived_param_names: SymbolStr[];
    derived_param_types: TypeRef[];

    /// Associated-type bindings this impl provides for the trait, as written
    /// (parallel arrays: name -> annotation). Two sources feed these:
    ///   * the explicit body form `type Item = T;`
    ///   * positional-sugar desugaring of the impl header: for a trait with 0
    ///     generic params and 1 associated type, `implement Iterator<A> for X`
    ///     binds `Item := A` (see the desugar in TypeResolution).
    /// `TypeAnnotation::Projection(This::Item)` resolves through these.
    assoc_binding_names:       SymbolStr[];
    assoc_binding_annotations: TypeAnnotation*[];

    ImplBlockNode(target_type: SymbolStr, span: SourceSpan)
        : DeclarationNode(NodeKind::ImplementationBlock, span) {
        this.target_type           = target_type;
        this.qualified_target_name = SymbolStr::empty();
        this.generic_params        = [];
        this.target_args           = [];
        this.methods               = [];
        this.trait_annotation      = null;
        this.where_bounds          = [];
        this.target_type_span      = SourceSpan::none();
        this.derived_param_names   = [];
        this.derived_param_types   = [];
        this.assoc_binding_names       = [];
        this.assoc_binding_annotations = [];
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }

    is_generic() -> boolean { return this.generic_params.length > 0; }
    is_trait_impl(&this) -> boolean { return this.trait_annotation != null; }
    set_target_type(n: SymbolStr) -> void { this.target_type = n; }

    set_target_type_span(mut &this, sp: SourceSpan) -> void {
        this.target_type_span = sp;
    }

    add_generic_param(param: GenericParamNode*) -> void {
        this.generic_params.push(param);
    }

    set_target_args(mut &this, args: TypeAnnotation*[]) -> void {
        this.target_args = args;
    }

    set_trait_annotation(mut &this, ann: TypeAnnotation*) -> void {
        this.trait_annotation = ann;
    }

    add_where_bound(mut &this, bound: TraitBound) -> void {
        this.where_bounds.push(bound);
    }

    add_method(m: MethodNode*) -> void {
        this.methods.push(m);
    }

    /// Record a concrete trait-element binding recovered at impl-spec time.
    /// See `derived_param_names` / `derived_param_types`.
    add_derived_param(mut &this, name: SymbolStr, ty: TypeRef) -> void {
        this.derived_param_names.push(name);
        this.derived_param_types.push(ty);
    }

    /// Concrete element type previously cached for `name`, or invalid.
    lookup_derived_param(&this, name: SymbolStr) -> TypeRef {
        for (mut i: i64 = 0; i < this.derived_param_names.length; i++) {
            if (this.derived_param_names[i].equals(name)) {
                return this.derived_param_types[i];
            }
        }
        return TypeRef::invalid();
    }

    /// Record an associated-type binding (`type Item = T;` or desugared from
    /// the positional header). The annotation is stored as written; it is
    /// resolved against the impl's generic params during type resolution.
    add_assoc_binding(mut &this, name: SymbolStr, ann: TypeAnnotation*) -> void {
        this.assoc_binding_names.push(name);
        this.assoc_binding_annotations.push(ann);
    }

    /// The annotation bound for associated type `name`, or null if unbound.
    lookup_assoc_binding(&this, name: SymbolStr) -> TypeAnnotation* {
        for (mut i: i64 = 0; i < this.assoc_binding_names.length; i++) {
            if (this.assoc_binding_names[i].equals(name)) {
                return this.assoc_binding_annotations[i];
            }
        }
        return null;
    }
}


type class ExternBlockNode : DeclarationNode {
public:
    linkage_type:    string;
    namespace_alias: SymbolStr;
    include_paths:   string[];
    /// Parallel to `include_paths`: true for an angle-bracket system
    /// include (`#include <stdio.h>`, resolved via the C preprocessor's
    /// system search path), false for a quoted include (`#include
    /// "foo.h"`, resolved relative to the importing file's directory).
    include_is_system: boolean[];
    functions:       FunctionDeclNode*[];

    ExternBlockNode(linkage_type: string, span: SourceSpan)
        : DeclarationNode(NodeKind::ExternBlock, span) {
        this.linkage_type    = linkage_type;
        this.namespace_alias = SymbolStr::empty();
        this.include_paths   = [];
        this.include_is_system = [];
        this.functions       = [];
    }

    /// Whether this is a CImport block (extern module name := "C" { #include ... })
    is_c_import(&this) -> boolean {
        return this.namespace_alias.id != 0;
    }

    set_namespace_alias(mut &this, alias: SymbolStr) -> void {
        this.namespace_alias = alias;
    }

    /// Add a quoted include (`#include "foo.h"`), resolved relative to
    /// the importing file's directory.
    add_include_path(mut &this, path: string) -> void {
        this.include_paths.push(path);
        this.include_is_system.push(false);
    }

    /// Add an angle-bracket system include (`#include <stdio.h>`),
    /// resolved via the C preprocessor's system search path.
    add_system_include_path(mut &this, path: string) -> void {
        this.include_paths.push(path);
        this.include_is_system.push(true);
    }

    add_function(mut &this, func: FunctionDeclNode*) -> void {
        this.functions.push(func);
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class FieldDeclNode : DeclarationNode {
public:
    name:            SymbolStr;
    visibility:      Visibility;
    default_value:   ExpressionNode*;
    type_annotation: TypeAnnotation*;
    resolved_type:   TypeRef;

    FieldDeclNode(name: SymbolStr, span: SourceSpan)
        : DeclarationNode(NodeKind::FieldDeclaration, span) {
        this.name            = name;
        this.visibility      = Visibility::Public;
        this.default_value   = null;
        this.type_annotation = null;
        this.resolved_type   = TypeRef::invalid();
    }

    has_default_value() -> boolean   { return this.default_value != null; }
    has_type_annotation() -> boolean { return this.type_annotation != null; }
    has_resolved_type() -> boolean   { return this.resolved_type.is_valid(); }

    set_visibility(v: Visibility) -> void           { this.visibility = v; }
    set_default_value(v: ExpressionNode*) -> void   { this.default_value = v; }
    set_type_annotation(a: TypeAnnotation*) -> void { this.type_annotation = a; }
    set_resolved_type(t: TypeRef) -> void           { this.resolved_type = t; }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


type class GenericParamNode : DeclarationNode {
public:
    name:               SymbolStr;
    constraints:        SymbolStr[];
    /// Default type annotation for `<T, A = DefaultType>`. Null when no
    /// default is provided. Sema substitutes this when the param is omitted
    /// at instantiation time. Lifetime parallels the rest of the AST node.
    default_annotation: TypeAnnotation*;

    GenericParamNode(name: SymbolStr, span: SourceSpan)
        : DeclarationNode(NodeKind::GenericParamDeclaration, span) {
        this.name               = name;
        this.constraints        = [];
        this.default_annotation = null;
    }

    add_constraint(c: SymbolStr) -> void {
        this.constraints.push(c);
    }

    has_default_annotation(&this) -> boolean {
        return this.default_annotation != null;
    }

    set_default_annotation(mut &this, ann: TypeAnnotation*) -> void {
        this.default_annotation = ann;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}
