/// AST Pattern & Miscellaneous Nodes
///
/// Pattern, MatchArmNode, StaticMatchArmNode and DirectiveNode.

namespace compiler::ast::pattern;

import compiler::diag;
import compiler::ast;
import compiler::ast::{
    LiteralKind, MemberPin, PatternBinding, PatternElement, TypeAnnotation
};
import compiler::diag::source_span;
import compiler::diag::source_span::{ SourceSpan };
import compiler::ast::node;
import compiler::ast::statement;
import compiler::ast::statement::{ Stmt };
import compiler::ast::expression;
import compiler::ast::expression::{ ExpressionNode };
import compiler::ast::walk::{ Walk };
import compiler::codegen::ast_arena::{ cryo_ast_arena_alloc };
import compiler::resolver::symbol_str;
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::res;
import compiler::resolver::res::{ Res, ResSlot };
import compiler::resolver::symbol_id;
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::types::type_ref;
import compiler::types::type_ref::{ TypeRef };
import std::fmt;
import compiler::ast::node::{ Node };
import utils::keyword::{ Keyword };


/// Every pattern: what all kinds share, and which kind of pattern it is.
type struct Pattern {
    span:      SourceSpan;
    has_error: boolean;
    /// The compiler wrote this node where the source spells nothing.
    generated: boolean;
    kind:      PatternKind;

    /// A pattern of `kind` at `span`.
    static of(kind: PatternKind, span: SourceSpan) -> Pattern* {
        return new Pattern { span: span, has_error: false, generated: false, kind: kind };
    }

    /// `_`.
    static wildcard(span: SourceSpan) -> Pattern* {
        return Pattern::of(PatternKind::Wildcard, span);
    }

    /// A literal whose text is `value`; `literal_kind` says which literal
    /// the text spells.
    static literal(value: SymbolStr, literal_kind: LiteralKind, span: SourceSpan) -> Pattern* {
        return Pattern::of(PatternKind::Literal(LiteralPattern::new(value, literal_kind)), span);
    }

    /// A name, binding the whole subject; name resolution turns it into a
    /// `Constant` when the name is a constant's.
    static binding(name: SymbolStr, span: SourceSpan) -> Pattern* {
        return Pattern::of(PatternKind::Binding(BindingPattern::new(name)), span);
    }

    /// `Enum::Variant`, with no elements yet.
    static enum_variant(enum_name: SymbolStr, variant_name: SymbolStr, span: SourceSpan) -> Pattern* {
        return Pattern::of(PatternKind::Enum(EnumPattern::new(enum_name, variant_name, span)), span);
    }

    /// The enum pattern this is, or null for another kind.
    enum_payload(&this) -> EnumPattern* {
        return match (this.kind) {
            PatternKind::Enum(e) => { e }
            _                    => { null }
        };
    }

    /// Whether this pattern accepts every value without a test: `_`, or a
    /// name that binds.
    is_irrefutable(&this) -> boolean {
        return match (this.kind) {
            PatternKind::Wildcard   => { true }
            PatternKind::Binding(_) => { true }
            _                       => { false }
        };
    }
}

/// `new` of a node takes its storage from the AST arena; `delete` of one
/// releases nothing, since the arena is reclaimed whole.
implement trait Allocate for struct Pattern {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

/// What a pattern is, one variant per kind.
type enum PatternKind {
    Wildcard;
    Literal(LiteralPattern*);
    Range(RangePattern*);
    Binding(BindingPattern*);
    Constant(ConstantPattern*);
    Enum(EnumPattern*);
}

/// A literal pattern: `value` is the literal's text.  Which literal that is
/// cannot be recovered from the text - `0` and `'0'` both intern to "0", and
/// `true` / `false` to "true" / "false" - so `literal_kind` says it, and
/// codegen emits the constant it names.
type struct LiteralPattern {
    value:        SymbolStr;
    literal_kind: LiteralKind;

    static new(value: SymbolStr, literal_kind: LiteralKind) -> LiteralPattern* {
        return new LiteralPattern { value: value, literal_kind: literal_kind };
    }
}

/// An inclusive range `low..high` (or `low..=high`).  Both bounds are the
/// same kind of literal, integer or char, so they share `literal_kind`.
type struct RangePattern {
    low:          SymbolStr;
    high:         SymbolStr;
    literal_kind: LiteralKind;

    static new(low: SymbolStr, high: SymbolStr, literal_kind: LiteralKind) -> RangePattern* {
        return new RangePattern { low: low, high: high, literal_kind: literal_kind };
    }
}

/// A name that binds the whole subject.
type struct BindingPattern {
    name:         SymbolStr;
    /// The binding the name layer declared for it, and the payload of every
    /// `Res::Local` stamped on a use of it.  The binding is the whole
    /// subject, so a pass that tracks ownership keys it here and links it to
    /// the subject exactly as it does an enum payload; without it `y =>
    /// { consume(y); }` gives the subject away with nobody seeing it, and the
    /// subject is released again at its scope exit.
    binding_sym:  SymbolID;
    /// The binding's type, as sema bound it against the subject.  Invalid
    /// until sema walks the arm; a clone is typed when its own body is
    /// checked.
    binding_type: TypeRef;

    static new(name: SymbolStr) -> BindingPattern* {
        return new BindingPattern {
            name:         name,
            binding_sym:  SymbolID::invalid(),
            binding_type: TypeRef::invalid(),
        };
    }
}

/// A name that is a constant's: the subject is compared against the
/// constant's value.  Name resolution makes one from a `Binding` whose name
/// it finds bound to a constant.
type struct ConstantPattern {
    name: SymbolStr;
    /// What the constant is, stamped by NameResolution from the scope the
    /// pattern was written in - a module-level constant by its canonical
    /// name, a local one as the local it is.  The leaf alone cannot say
    /// which module's constant that is.
    res:  ResSlot;

    static new(name: SymbolStr) -> ConstantPattern* {
        return new ConstantPattern { name: name, res: ResSlot::Pending };
    }
}

/// `Enum::Variant` or `Enum::Variant(elements)`.
type struct EnumPattern {
    enum_name:    SymbolStr;
    variant_name: SymbolStr;
    elements:     [PatternElement];
    // Per-segment spans so tooling (LSP hover) can tell the cursor apart on
    // the enum-path side (`Option` in `Option::Some`) from the variant side
    // (`Some`).  Default to the whole pattern's span;
    // `parse_enum_pattern_internal` overrides them for real source.
    enum_span:    SourceSpan;
    variant_span: SourceSpan;

    /// What `enum_name` names, stamped by NameResolution from the scope the
    /// pattern was written in.  A pattern names one enum outright, so there is
    /// no trailing segment and `TypeRelative` never appears here.
    res:          ResSlot;

    /// The variant `variant_name` names inside the enum the SUBJECT is
    /// (`Variant(ordinal)`), as sema found it on its committed walk; codegen
    /// reads the tag and the payload layout from it.  `None` until sema
    /// answers - the symbolic walk over a generic body does not, since it
    /// may check the pattern against a type that is not its own.
    resolved_member: MemberPin;

    /// Whether `resolved_member` reached this node through a substituted
    /// clone rather than from a walk over the node itself - `MemberPin`'s
    /// carriage rule.
    pin_carried: boolean;

    static new(enum_name: SymbolStr, variant_name: SymbolStr, span: SourceSpan) -> EnumPattern* {
        return new EnumPattern {
            enum_name:       enum_name,
            variant_name:    variant_name,
            elements:        [],
            enum_span:       span,
            variant_span:    span,
            res:             ResSlot::Pending,
            resolved_member: MemberPin::None,
            pin_carried:     false,
        };
    }

    /// Record what the pattern's enum name refers to.  First answer wins.
    set_res(mut &this, r: Res) -> void {
        this.res.answer(r);
    }

    set_resolved_member(mut &this, pin: MemberPin) -> void {
        this.resolved_member = pin;
        this.pin_carried     = false;
    }

    /// Keep the pin a clone inherited and mark it carried.
    carry_resolved_member(mut &this) -> void {
        this.pin_carried = this.resolved_member.is_some();
    }

    set_segment_spans(mut &this, enum_span: SourceSpan, variant_span: SourceSpan) -> void {
        this.enum_span    = enum_span;
        this.variant_span = variant_span;
    }

    add_element(mut &this, elem: PatternElement) -> void {
        this.elements.push(elem);
    }

    /// Returns the binding at element-position `i`, or null if that element
    /// is not a binding. Sema, codegen, and the monomorphizer iterate
    /// `elements` and call this to grab the name+span for binding registration.
    binding_at(&this, i: i64) -> PatternBinding* {
        if (i < 0 || i >= this.elements.length()) { return null; }
        return match (this.elements[i]) {
            PatternElement::Binding(pb) => { pb }
            _                           => { null }
        };
    }

    /// Returns the nested sub-pattern at element-position `i` (for
    /// `Some(Some(n))`-style nesting), or null when that element is a leaf
    /// (binding / wildcard / literal).
    sub_at(&this, i: i64) -> Pattern* {
        if (i < 0 || i >= this.elements.length()) { return null; }
        return match (this.elements[i]) {
            PatternElement::Sub(ps) => { ps.pattern }
            _                       => { null }
        };
    }

    /// True if this pattern introduces any bindings - directly (a `Binding`
    /// element) or through a nested sub-pattern. Codegen uses this to decide
    /// whether to walk payloads for binding extraction.
    has_bindings(&this) -> boolean {
        for (mut i: i64 = 0; i < this.elements.length(); i++) {
            match (this.elements[i]) {
                PatternElement::Binding(_) => { return true; }
                PatternElement::Sub(_)     => { return true; }
                _                          => {}
            }
        }
        return false;
    }

    /// Visit the nested sub-patterns in source order.
    static walk_children<V>(n: EnumPattern*, v: mut &V) -> void where V: Walk {
        for (mut i: i64 = 0; i < n.elements.length(); i++) { v.walk_node(Node::Pattern(n.sub_at(i))); }
    }
}

/// `new` of a pattern payload takes its storage from the AST arena, as the
/// header's does.
implement trait Allocate for struct LiteralPattern {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct RangePattern {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct BindingPattern {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct ConstantPattern {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

implement trait Allocate for struct EnumPattern {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

/// One arm of a `match`: its patterns, an optional guard and the body.
type struct MatchArmNode {
    span:      SourceSpan;
    has_error: boolean;
    /// The compiler wrote this node where the source spells nothing.
    generated: boolean;
    patterns:  [Pattern*];
    body:      Stmt*;
    /// Optional pattern guard: `pattern if (cond) => body`. When non-null,
    /// the arm matches only if every pattern matches AND `guard` evaluates
    /// to `true`; a false guard falls through to the next arm. The guard is
    /// type-checked as a `boolean` in a scope where the arm's pattern
    /// bindings are visible. Null for an unguarded arm.
    guard:     ExpressionNode*;

    /// An arm at `span` with no patterns, guard or body yet.
    static new(span: SourceSpan) -> MatchArmNode* {
        return new MatchArmNode {
            span: span, has_error: false, generated: false,
            patterns: [], body: null, guard: null,
        };
    }

    add_pattern(mut &this, pat: Pattern*) -> void {
        this.patterns.push(pat);
    }

    set_body(mut &this, b: Stmt*) -> void {
        this.body = b;
    }

    set_guard(mut &this, g: ExpressionNode*) -> void {
        this.guard = g;
    }

    /// Visit the patterns, the guard and the body in source order.
    static walk_children<V>(n: MatchArmNode*, v: mut &V) -> void where V: Walk {
        for (mut i: i64 = 0; i < n.patterns.length(); i++) { v.walk_node(Node::Pattern(n.patterns[i])); }
        v.walk_expr(n.guard);
        v.walk_stmt(n.body);
    }
}

implement trait Allocate for struct MatchArmNode {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}

/// One arm of a `static match`: `<type> | <type> | ... => <body>`. Each pattern
/// is a TYPE annotation; one or more `|`-separated types share the arm's body
/// (the arm matches if the scrutinee equals ANY of them, mirroring the `|`
/// alternation of a regular match arm). An empty `type_patterns` is the wildcard
/// `_` (default), which must be last. `body` is a block (or a single-statement
/// block synthesized by the parser), exactly like a regular match arm. There is
/// no `guard` - matching is purely on type identity, resolved at monomorphization.
type struct StaticMatchArmNode {
    span:          SourceSpan;
    has_error:     boolean;
    /// The compiler wrote this node where the source spells nothing.
    generated:     boolean;
    type_patterns: [TypeAnnotation*];
    body:          Stmt*;

    /// An arm at `span` with no patterns or body yet.
    static new(span: SourceSpan) -> StaticMatchArmNode* {
        return new StaticMatchArmNode {
            span: span, has_error: false, generated: false,
            type_patterns: [], body: null,
        };
    }

    add_type_pattern(mut &this, t: TypeAnnotation*) -> void { this.type_patterns.push(t); }
    set_body(mut &this, b: Stmt*) -> void          { this.body = b; }

    /// Visit the types the arm lists, then the body.
    static walk_children<V>(n: StaticMatchArmNode*, v: mut &V) -> void where V: Walk {
        v.walk_annotations(&n.type_patterns);
        v.walk_stmt(n.body);
    }
}

implement trait Allocate for struct StaticMatchArmNode {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}


// DirectiveNode + Typed Arguments

/// Kind of a directive argument.  Args can be bare identifiers, literals,
/// `key = value` pairs, or nested directive calls (e.g. `cfg(any(unix))`).
type enum DirectiveArgKind {
    Ident;       // bare ident, e.g. ![inline] or ![cfg(unix)]
    StringLit;   // ![deprecated("use bar")]
    IntLit;      // ![align(16)]
    BoolLit;     // ![enabled(true)]
    KeyValue;    // ![target(os = "windows")]
    Nested;      // ![cfg(any(unix, windows))]
}

/// A single argument inside a directive's `(...)` list.
///
/// Field meaning by `kind`:
///   Ident      -> `name` = identifier text
///   StringLit  -> `str_value` = string content (unquoted)
///   IntLit     -> `int_value` = numeric value, `str_value` = original text
///   BoolLit    -> `bool_value` = true/false
///   KeyValue   -> `name` = key, `value_kind` selects which payload field
///                carries the value (str_value / int_value / bool_value /
///                Ident text in `str_value`).
///   Nested     -> `nested` = pointer to the nested DirectiveNode
type struct DirectiveArg {
    kind:        DirectiveArgKind;
    name:        string;
    str_value:   string;
    int_value:   i64;
    bool_value:  boolean;
    value_kind:  DirectiveArgKind;
    nested:      DirectiveNode*;
    span:        SourceSpan;

    static ident(text: string, span: SourceSpan) -> DirectiveArg {
        return DirectiveArg {
            kind:       DirectiveArgKind::Ident,
            name:       text,
            str_value:  "",
            int_value:  0,
            bool_value: false,
            value_kind: DirectiveArgKind::Ident,
            nested:     null,
            span:       span,
        };
    }

    static string_lit(content_text: string, span: SourceSpan) -> DirectiveArg {
        const content: string = content_text;
        return DirectiveArg {
            kind:       DirectiveArgKind::StringLit,
            name:       "",
            str_value:  content,
            int_value:  0,
            bool_value: false,
            value_kind: DirectiveArgKind::Ident,
            nested:     null,
            span:       span,
        };
    }

    static int_lit(value: i64, raw_text: string, span: SourceSpan) -> DirectiveArg {
        const raw: string = raw_text;
        return DirectiveArg {
            kind:       DirectiveArgKind::IntLit,
            name:       "",
            str_value:  raw,
            int_value:  value,
            bool_value: false,
            value_kind: DirectiveArgKind::Ident,
            nested:     null,
            span:       span,
        };
    }

    static bool_lit(value: boolean, span: SourceSpan) -> DirectiveArg {
        return DirectiveArg {
            kind:       DirectiveArgKind::BoolLit,
            name:       "",
            str_value:  "",
            int_value:  0,
            bool_value: value,
            value_kind: DirectiveArgKind::Ident,
            nested:     null,
            span:       span,
        };
    }

    static nested_call(call: DirectiveNode*, span: SourceSpan) -> DirectiveArg {
        return DirectiveArg {
            kind:       DirectiveArgKind::Nested,
            name:       "",
            str_value:  "",
            int_value:  0,
            bool_value: false,
            value_kind: DirectiveArgKind::Ident,
            nested:     call,
            span:       span,
        };
    }

    /// Render this arg as a human-readable string for diagnostics or the
    /// legacy `arguments: [string]` view.
    to_text(&this) -> string {
        if (this.kind == DirectiveArgKind::Ident) {
            return this.name;
        }
        if (this.kind == DirectiveArgKind::StringLit) {
            return fmt::format("\"%s\"", this.str_value);
        }
        if (this.kind == DirectiveArgKind::IntLit) {
            return this.str_value;
        }
        if (this.kind == DirectiveArgKind::BoolLit) {
            if (this.bool_value) { return "true"; }
            return "false";
        }
        if (this.kind == DirectiveArgKind::KeyValue) {
            mut v: string = "?";
            if (this.value_kind == DirectiveArgKind::Ident)     { v = this.str_value; }
            if (this.value_kind == DirectiveArgKind::StringLit) { v = fmt::format("\"%s\"", this.str_value); }
            if (this.value_kind == DirectiveArgKind::IntLit)    { v = this.str_value; }
            if (this.value_kind == DirectiveArgKind::BoolLit) {
                if (this.bool_value) { v = "true"; } else { v = "false"; }
            }
            return fmt::format("%s = %s", this.name, v);
        }
        if (this.kind == DirectiveArgKind::Nested) {
            if (this.nested != null) { return this.nested.directive_kind.as_string(); }
            return "<null>";
        }
        return "?";
    }
}

type struct DirectiveNode {
    span:           SourceSpan;
    has_error:      boolean;
    /// The compiler wrote this node where the source spells nothing.
    generated:      boolean;
    /// The directive's name, or a platform atom when this node is nested in
    /// a gate (`windows` in `![config(windows)]`): matched against the
    /// compiler's own tables, never used to find a declaration.
    directive_kind: Keyword;
    args:           [DirectiveArg];

    /// `![directive_kind]` at `span`, with no arguments yet.
    static new(directive_kind: Keyword, span: SourceSpan) -> DirectiveNode* {
        return new DirectiveNode {
            span: span, has_error: false, generated: false,
            directive_kind: directive_kind, args: [],
        };
    }

    add_arg(mut &this, a: DirectiveArg) -> void {
        this.args.push(a);
    }
}

implement trait Allocate for struct DirectiveNode {
    static allocate(size: u64, align: u64) -> void* {
        return cryo_ast_arena_alloc(size, align);
    }
}
