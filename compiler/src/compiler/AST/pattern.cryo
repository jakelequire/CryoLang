/// AST Pattern & Miscellaneous Nodes
///
/// PatternNode, EnumPatternNode, MatchArmNode, and DirectiveNode.

namespace Compiler::AST::Pattern;

import Compiler::Diag;
import Compiler::AST;
import Compiler::Diag::SourceSpan;
import Compiler::AST::Node;
import Compiler::AST::Statement;
import Compiler::Resolver::SymbolStr;


// ============================================================================
// PatternNode
// ============================================================================

type class PatternNode : ASTNode {
public:
    pattern_kind: PatternKind;
    value:        SymbolStr;
    binding_name: SymbolStr;
    /// For `PatternKind::Literal` patterns only: which kind of literal the
    /// `value` text denotes.  This disambiguation cannot be recovered from
    /// the text; `0` (the integer) and `'0'` (the char) both intern to
    /// the string "0", and `true` / `false` intern to "true" / "false";
    /// so codegen relies on this field to emit the right constant instead
    /// of guessing.  Defaults to `Integer`; unused for non-Literal kinds.
    literal_kind: LiteralKind;

    PatternNode(span: SourceSpan) : ASTNode(NodeKind::Pattern, span) {
        this.pattern_kind = PatternKind::Wildcard;
        this.value        = SymbolStr::empty();
        this.binding_name = SymbolStr::empty();
        this.literal_kind = LiteralKind::Integer;
    }

    PatternNode(kind: PatternKind, span: SourceSpan) : ASTNode(NodeKind::Pattern, span) {
        this.pattern_kind = kind;
        this.value        = SymbolStr::empty();
        this.binding_name = SymbolStr::empty();
        this.literal_kind = LiteralKind::Integer;
    }

    set_pattern_kind(k: PatternKind) -> void  { this.pattern_kind = k; }
    set_value(v: SymbolStr) -> void           { this.value = v; }
    set_binding_name(n: SymbolStr) -> void    { this.binding_name = n; }
    set_literal_kind(k: LiteralKind) -> void  { this.literal_kind = k; }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


// ============================================================================
// EnumPatternNode
// ============================================================================

type class EnumPatternNode : PatternNode {
public:
    enum_name:    SymbolStr;
    variant_name: SymbolStr;
    elements:     PatternElement[];

    EnumPatternNode(span: SourceSpan) : PatternNode(PatternKind::Enum, span) {
        this.enum_name    = SymbolStr::empty();
        this.variant_name = SymbolStr::empty();
        this.elements     = [];
    }

    set_enum_name(n: SymbolStr) -> void    { this.enum_name = n; }
    set_variant_name(n: SymbolStr) -> void { this.variant_name = n; }

    add_element(elem: PatternElement) -> void {
        this.elements.push(elem);
    }

    /// Returns the binding at element-position `i`, or null if that element
    /// is not a binding. Sema, codegen, and the monomorphizer iterate
    /// `elements` and call this to grab the name+span for binding registration.
    binding_at(i: i64) -> PatternBinding* {
        if (i < 0 || i >= this.elements.length) { return null; }
        return match (this.elements[i]) {
            PatternElement::Binding(pb) => { pb }
            _                           => { null }
        };
    }

    /// True if this pattern has any binding elements (skips arms with only
    /// wildcards/literals).
    has_bindings() -> boolean {
        for (mut i: i64 = 0; i < this.elements.length; i++) {
            match (this.elements[i]) {
                PatternElement::Binding(_) => { return true; }
                _                          => {}
            }
        }
        return false;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


// ============================================================================
// MatchArmNode
// ============================================================================

type class MatchArmNode : ASTNode {
public:
    patterns: PatternNode*[];
    body:     StatementNode*;

    MatchArmNode(span: SourceSpan) : ASTNode(NodeKind::MatchArm, span) {
        this.patterns = [];
        this.body     = null;
    }

    add_pattern(pat: PatternNode*) -> void {
        this.patterns.push(pat);
    }

    set_body(b: StatementNode*) -> void {
        this.body = b;
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}


// ============================================================================
// DirectiveNode + Typed Arguments
// ============================================================================

/// Kind of a directive argument.  Args can be bare identifiers, literals,
/// `key = value` pairs, or nested directive calls (e.g. `cfg(any(unix))`).
type enum DirectiveArgKind {
    Ident;       // bare ident, e.g. ![inline] or ![cfg(unix)]
    StringLit;   // ![deprecated("use bar")]
    IntLit;      // ![align(16)]
    BoolLit;     // ![enabled(true)]
    KeyValue;    // ![target(os = "windows")]
    Nested;      // ![cfg(any(unix, windows))]
}

/// A single argument inside a directive's `(...)` list.
///
/// Field meaning by `kind`:
///   Ident      → `name` = identifier text
///   StringLit  → `str_value` = string content (unquoted)
///   IntLit     → `int_value` = numeric value, `str_value` = original text
///   BoolLit    → `bool_value` = true/false
///   KeyValue   → `name` = key, `value_kind` selects which payload field
///                carries the value (str_value / int_value / bool_value /
///                Ident text in `str_value`).
///   Nested     → `nested` = pointer to the nested DirectiveNode
type struct DirectiveArg {
    kind:        DirectiveArgKind;
    name:        string;
    str_value:   string;
    int_value:   i64;
    bool_value:  boolean;
    value_kind:  DirectiveArgKind;
    nested:      DirectiveNode*;
    span:        SourceSpan;

    static ident(text: string, span: SourceSpan) -> DirectiveArg {
        return DirectiveArg {
            kind:       DirectiveArgKind::Ident,
            name:       text,
            str_value:  "",
            int_value:  0,
            bool_value: false,
            value_kind: DirectiveArgKind::Ident,
            nested:     null,
            span:       span,
        };
    }

    static string_lit(content: string, span: SourceSpan) -> DirectiveArg {
        return DirectiveArg {
            kind:       DirectiveArgKind::StringLit,
            name:       "",
            str_value:  content,
            int_value:  0,
            bool_value: false,
            value_kind: DirectiveArgKind::Ident,
            nested:     null,
            span:       span,
        };
    }

    static int_lit(value: i64, raw: string, span: SourceSpan) -> DirectiveArg {
        return DirectiveArg {
            kind:       DirectiveArgKind::IntLit,
            name:       "",
            str_value:  raw,
            int_value:  value,
            bool_value: false,
            value_kind: DirectiveArgKind::Ident,
            nested:     null,
            span:       span,
        };
    }

    static bool_lit(value: boolean, span: SourceSpan) -> DirectiveArg {
        return DirectiveArg {
            kind:       DirectiveArgKind::BoolLit,
            name:       "",
            str_value:  "",
            int_value:  0,
            bool_value: value,
            value_kind: DirectiveArgKind::Ident,
            nested:     null,
            span:       span,
        };
    }

    static nested_call(call: DirectiveNode*, span: SourceSpan) -> DirectiveArg {
        return DirectiveArg {
            kind:       DirectiveArgKind::Nested,
            name:       "",
            str_value:  "",
            int_value:  0,
            bool_value: false,
            value_kind: DirectiveArgKind::Ident,
            nested:     call,
            span:       span,
        };
    }

    /// Render this arg as a human-readable string for diagnostics or the
    /// legacy `arguments: string[]` view.
    to_text(&this) -> string {
        if (this.kind == DirectiveArgKind::Ident) {
            return this.name;
        }
        if (this.kind == DirectiveArgKind::StringLit) {
            return format("\"%s\"", this.str_value);
        }
        if (this.kind == DirectiveArgKind::IntLit) {
            return this.str_value;
        }
        if (this.kind == DirectiveArgKind::BoolLit) {
            if (this.bool_value) { return "true"; }
            return "false";
        }
        if (this.kind == DirectiveArgKind::KeyValue) {
            mut v: string = "?";
            if (this.value_kind == DirectiveArgKind::Ident)     { v = this.str_value; }
            if (this.value_kind == DirectiveArgKind::StringLit) { v = format("\"%s\"", this.str_value); }
            if (this.value_kind == DirectiveArgKind::IntLit)    { v = this.str_value; }
            if (this.value_kind == DirectiveArgKind::BoolLit) {
                if (this.bool_value) { v = "true"; } else { v = "false"; }
            }
            return format("%s = %s", this.name, v);
        }
        if (this.kind == DirectiveArgKind::Nested) {
            if (this.nested != null) { return this.nested.directive_kind; }
            return "<null>";
        }
        return "?";
    }
}

type class DirectiveNode : ASTNode {
public:
    directive_kind: string;
    args:           DirectiveArg[];

    DirectiveNode(directive_kind: string, span: SourceSpan)
        : ASTNode(NodeKind::Directive, span) {
        this.directive_kind = directive_kind;
        this.args           = [];
    }

    add_arg(a: DirectiveArg) -> void {
        this.args.push(a);
    }

    /// True if any argument matches the given identifier name.
    has_ident_arg(&this, name: string) -> boolean {
        for (mut i: i64 = 0; i < this.args.length; i++) {
            const a: DirectiveArg = this.args[i];
            if (a.kind == DirectiveArgKind::Ident && strcmp(a.name, name) == 0) {
                return true;
            }
        }
        return false;
    }

    /// Look up the value of a `key = value` arg, returning the rendered
    /// string text or "" if not present.
    find_kv(&this, key: string) -> string {
        for (mut i: i64 = 0; i < this.args.length; i++) {
            const a: DirectiveArg = this.args[i];
            if (a.kind == DirectiveArgKind::KeyValue && strcmp(a.name, key) == 0) {
                return a.str_value;
            }
        }
        return "";
    }

    override accept(visitor: ASTVisitor*) -> void {
        visitor.visit(this);
    }
}
