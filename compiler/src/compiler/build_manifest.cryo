///! Build Manifest + Incremental Fingerprint
///!
///! Emits a self-describing per-profile `build-manifest.json` under
///! `<output_dir>/target/<profile>/` and a machine-readable fingerprint
///! sidecar under `<output_dir>/target/<profile>/local/incremental/<name>.fp`.
///!
///! The fingerprint is a 64-bit FNV-1a digest over EVERY build input:
///!   - the compiler binary's own bytes (so a changed compiler rebuilds),
///!   - the resolved knobs (opt level, debug info, emit-llvm, no-std,
///!     target triple, profile, and the `[link]` lists),
///!   - the stdlib archive's bytes (when linked), and
///!   - the full content of every discovered source module.
///!
///! The whole-build fingerprint is the OUTER fast path: if nothing changed
///! and the artifacts still exist, the entire compile+link is skipped before
///! the frontend even runs.
///!
///! When the whole-build fingerprint DOES differ, a per-module cache (the
///! `*.modkeys` sidecar) decides which modules' objects can be reused so the
///! backend (Phase 6b sema + Phase 7 codegen, which measurement puts at ~90%
///! of build time) only re-runs for modules that actually changed. Because
///! Cryo monomorphizes across ALL modules before per-module codegen (Phase
///! 6a), a module's `.o` is not a pure function of its own source — so the
///! per-module key is computed two ways (see `module_source_hash` /
///! `toolchain_fingerprint` here and the key derivation in
///! `instance.cryo::compile_project_with_ctx`):
///!   - a module that OWNS specializations (its `.o` embeds monomorphized
///!     instances whose type-args can come from any consumer) folds a GLOBAL
///!     digest of every module's source hash — it rebuilds whenever any
///!     source changes (conservative but always sound);
///!   - a module that owns NO specializations folds only the source hashes of
///!     its transitive import closure — every type whose layout its `.o`
///!     depends on is reachable through that closure, so a leaf edit leaves
///!     unrelated modules cached.
///! Bias is always toward rebuilding: a false cache miss is merely slow, a
///! false hit is a miscompile.

namespace Compiler::BuildManifest;

import Compiler::ProjectConfig;
import Utils::File;
import Utils::Logger;
import std::core::hash;
import std::core::primitives;
import std::collections::string;
import std::collections::array;
import std::json::value;
import std::json::serializer;
import std::env;

/// A source module feeding the build, as the fingerprint + manifest see it.
type struct ModuleEntry {
    namespace_name: string;   // e.g. "std::core::primitives"
    source_path:    string;   // path on disk
    origin_subdir:  string;   // output package subtree: "std" | "local" | <depname>
    origin_kind:    string;   // "stdlib" | "local" | "dep"
}


// FNV-1a folding helpers

/// Fold a single byte into a running FNV-1a state, via the canonical
/// `core::hash` FNV-1a so the offset basis + prime live in one place.
function fnv_byte(state: u64, b: u8) -> u64 {
    mut h: DefaultHasher = DefaultHasher::from_state(state);
    h.write_u8(b);
    return h.finish();
}

/// Fold a NUL-terminated string's bytes into the state, plus a separator so
/// adjacent concatenations can't collide ("ab"+"c" vs "a"+"bc").
function fnv_str(state: u64, s: string) -> u64 {
    mut h: u64 = state;
    const len: u64 = intrinsics::strlen(s);
    const b: i8* = s as i8*;
    for (mut i: u64 = 0; i < len; i++) {
        h = fnv_byte(h, b[i] as u8);
    }
    return fnv_byte(h, 0);
}

/// Fold a u64 (8 bytes, low byte first) into the state.
function fnv_u64(state: u64, v: u64) -> u64 {
    mut h: u64 = state;
    mut x: u64 = v;
    for (mut i: u64 = 0; i < 8; i++) {
        h = fnv_byte(h, (x & 255) as u8);
        x = x >> 8;
    }
    return h;
}

/// Fold a file's full byte content (NULs included) into the state. A
/// missing or unreadable file folds a distinct marker so it still perturbs
/// the fingerprint. The byte count is mixed in last as a length guard.
function fnv_file(state: u64, path: string) -> u64 {
    mut h: u64 = state;
    if (!File::exists(path)) {
        return fnv_str(h, "<missing>");
    }
    mut f: File = File::new(path);
    f.load();
    if (!f.is_loaded()) {
        return fnv_str(h, "<unreadable>");
    }
    const n: u64 = f.size();
    const d: i8* = f.data();
    for (mut i: u64 = 0; i < n; i++) {
        h = fnv_byte(h, d[i] as u8);
    }
    f.close();
    return fnv_u64(h, n);
}


// Compiler self-fingerprint

/// Path to the running compiler binary, or "" on failure. Delegates to
/// `std::env::current_exe` (which handles `/proc/self/exe` on Unix and
/// `GetModuleFileNameA` on Windows) instead of reimplementing readlink.
function self_exe_path() -> string {
    match (env::current_exe()) {
        Option::Some(s) => { return s.into_raw(); }
        Option::None    => { return ""; }
    }
}

/// FNV-1a digest of the running compiler's own bytes. Changes whenever the
/// compiler changes, invalidating every cached build it produced.
function compiler_fingerprint() -> u64 {
    const exe: string = self_exe_path();
    mut h: u64 = DefaultHasher::offset_basis();
    if (intrinsics::strlen(exe) == 0) {
        return fnv_str(h, "<unknown-compiler>");
    }
    return fnv_file(h, exe);
}


// Whole-build fingerprint

/// Combined fingerprint over every build input. `opt_level` / `debug_info`
/// are the RESOLVED values (after profile + CLI overrides), so a `--dev`
/// vs `--release` switch produces distinct fingerprints. `stdlib_archive`
/// is "" for `--no-std` builds.
function compute_fingerprint(cfg: ProjectConfig*, modules: &ModuleEntry[],
                             opt_level: u32, debug_info: boolean,
                             stdlib_archive: string) -> u64 {
    mut h: u64 = DefaultHasher::offset_basis();
    h = fnv_u64(h, compiler_fingerprint());
    // Resolved knobs.
    h = fnv_u64(h, opt_level as u64);
    const dbg_b:  u8 = if (debug_info)    { 1 } else { 0 };
    const ell_b:  u8 = if (cfg.emit_llvm) { 1 } else { 0 };
    const nstd_b: u8 = if (cfg.no_std)    { 1 } else { 0 };
    h = fnv_byte(h, dbg_b);
    h = fnv_byte(h, ell_b);
    h = fnv_byte(h, nstd_b);
    h = fnv_str(h, cfg.target_triple);
    h = fnv_str(h, cfg.profile);
    // [link] lists affect the final binary but not the .o files.
    for (mut i: i64 = 0; i < cfg.link_system.length; i++) { h = fnv_str(h, cfg.link_system[i]); }
    for (mut i: i64 = 0; i < cfg.link_search.length; i++) { h = fnv_str(h, cfg.link_search[i]); }
    for (mut i: i64 = 0; i < cfg.link_static.length; i++) { h = fnv_str(h, cfg.link_static[i]); }
    // Stdlib archive bytes (so a rebuilt stdlib invalidates dependents).
    if (intrinsics::strlen(stdlib_archive) > 0) {
        h = fnv_file(h, stdlib_archive);
    }
    // Every source module, in topo order: namespace + origin (output
    // location) + full content.  Folding origin_subdir means moving a module
    // between packages (which changes where its .o lands) invalidates the
    // cache even when its source bytes are unchanged.
    for (mut i: i64 = 0; i < modules.length; i++) {
        h = fnv_str(h, modules[i].namespace_name);
        h = fnv_str(h, modules[i].origin_subdir);
        h = fnv_file(h, modules[i].source_path);
    }
    return h;
}


// Per-module cache key components

/// The FNV-1a seed, exposed so the orchestrator can fold module keys with
/// the same hash family used everywhere else in this module.
function fnv_seed() -> u64 {
    return DefaultHasher::offset_basis();
}

/// FNV-1a digest of a SINGLE module's identity + content, mirroring exactly
/// the per-module folding `compute_fingerprint` does (namespace + output
/// subtree + full file bytes). Used as the atom of every per-module cache
/// key; folding `origin_subdir` means relocating a module between packages
/// (which changes where its `.o` lands) invalidates its key.
function module_source_hash(namespace_name: string, origin_subdir: string,
                            source_path: string) -> u64 {
    mut h: u64 = DefaultHasher::offset_basis();
    h = fnv_str(h, namespace_name);
    h = fnv_str(h, origin_subdir);
    h = fnv_file(h, source_path);
    return h;
}

/// FNV-1a digest of the toolchain inputs that affect EVERY object file: the
/// compiler's own bytes plus the resolved codegen knobs. Deliberately
/// excludes the source modules, the stdlib archive, and the `[link]` lists —
/// those are folded per-module (sources) or only affect the final link
/// (archive / link lists), not an individual `.o`. Every per-module key
/// folds this, so a changed compiler or a `--dev`/`--release` switch
/// invalidates the whole per-module cache.
function toolchain_fingerprint(cfg: ProjectConfig*, opt_level: u32,
                               debug_info: boolean) -> u64 {
    mut h: u64 = DefaultHasher::offset_basis();
    h = fnv_u64(h, compiler_fingerprint());
    h = fnv_u64(h, opt_level as u64);
    const dbg_b:  u8 = if (debug_info)    { 1 } else { 0 };
    const ell_b:  u8 = if (cfg.emit_llvm) { 1 } else { 0 };
    const nstd_b: u8 = if (cfg.no_std)    { 1 } else { 0 };
    h = fnv_byte(h, dbg_b);
    h = fnv_byte(h, ell_b);
    h = fnv_byte(h, nstd_b);
    h = fnv_str(h, cfg.target_triple);
    h = fnv_str(h, cfg.profile);
    return h;
}


// Per-module key sidecar (*.modkeys): `namespace<TAB>keyhex` per line

/// Prior per-module cache keys, loaded from the `*.modkeys` sidecar. Parallel
/// `names`/`keys` arrays; `lookup` returns the stored key hex for a namespace
/// or "" when absent (a never-before-seen module always rebuilds).
type struct ModuleKeyTable {
    names: string[];
    keys:  string[];

    static empty() -> ModuleKeyTable {
        return ModuleKeyTable { names: [], keys: [] };
    }

    lookup(&this, name: string) -> string {
        for (mut i: i64 = 0; i < this.names.length; i++) {
            if (intrinsics::strcmp(this.names[i], name) == 0) {
                return this.keys[i];
            }
        }
        return "";
    }
}

/// Copy `len` bytes from `data+start` into a fresh NUL-terminated string.
function modkeys_slice(data: i8*, start: u64, len: u64) -> string {
    const out: i8* = intrinsics::malloc(len + 1) as i8*;
    if (len > 0) {
        intrinsics::memcpy(out as void*, intrinsics::ptr_add(data as void*, start) as void*, len);
    }
    out[len] = 0;
    return out as string;
}

/// Parse the `*.modkeys` sidecar into a `ModuleKeyTable`. A missing or
/// unreadable file yields an empty table (every module then rebuilds, which
/// is the safe default). Lines without a TAB separator are skipped.
function read_module_keys(path: string) -> ModuleKeyTable {
    mut t: ModuleKeyTable = ModuleKeyTable::empty();
    if (!File::exists(path)) { return t; }
    mut f: File = File::new(path);
    f.load();
    if (!f.is_loaded()) { return t; }
    const data: i8* = f.data();
    const n: u64 = f.size();
    mut i: u64 = 0;
    while (i < n) {
        const name_start: u64 = i;
        while (i < n && data[i] != 9 && data[i] != 10) { i = i + 1; }
        mut name: string = "";
        mut keyh: string = "";
        if (i < n && data[i] == 9) {
            name = modkeys_slice(data, name_start, i - name_start);
            i = i + 1;                       // skip TAB
            const key_start: u64 = i;
            while (i < n && data[i] != 10) { i = i + 1; }
            keyh = modkeys_slice(data, key_start, i - key_start);
        } else {
            // No TAB before end-of-line: skip the rest of this line.
            while (i < n && data[i] != 10) { i = i + 1; }
        }
        if (i < n && data[i] == 10) { i = i + 1; }   // skip newline
        if (intrinsics::strlen(name) > 0 && intrinsics::strlen(keyh) > 0) {
            t.names.push(name);
            t.keys.push(keyh);
        }
    }
    f.close();
    return t;
}

/// Write the `*.modkeys` sidecar (`namespace<TAB>keyhex` per line). The
/// caller must have created the incremental dir (e.g. via `write_fingerprint`,
/// which always runs alongside this on the success path).
function write_module_keys(path: string, names: &string[],
                           keys: &string[]) -> void {
    const f: void* = intrinsics::fopen(path, "w");
    if (f == null) {
        intrinsics::fprintf(g_stderr,
            "warning: cannot write per-module cache keys to %s\n", path);
        return;
    }
    for (mut i: i64 = 0; i < names.length; i++) {
        intrinsics::fprintf(f, "%s\t%s\n", names[i], keys[i]);
    }
    intrinsics::fclose(f);
}


// Hex / string helpers

/// Lowercase 16-char hex of a u64, via the canonical
/// `core::primitives::u64::to_hex_padded_buf` (zero-padded, width 16).
function u64_to_hex(v: u64) -> string {
    const buf: i8* = intrinsics::malloc(17) as i8*;
    v.to_hex_padded_buf(buf as u8*, 16);
    buf[16] = 0;
    return buf as string;
}

/// Read a file's content with trailing whitespace/newlines stripped, or ""
/// when the file is absent or unreadable.
function read_file_trimmed(path: string) -> string {
    if (!File::exists(path)) { return ""; }
    mut f: File = File::new(path);
    f.load();
    if (!f.is_loaded()) { return ""; }
    const raw: string = f.content();
    mut len: i64 = intrinsics::strlen(raw) as i64;
    while (len > 0 && (raw[len - 1] == 10 || raw[len - 1] == 13
                       || raw[len - 1] == 32 || raw[len - 1] == 9)) {
        len -= 1;
    }
    if (len <= 0) { return ""; }
    const out: i8* = intrinsics::malloc(len as u64 + 1) as i8*;
    intrinsics::memcpy(out as void*, raw as void*, len as u64);
    out[len] = 0;
    return out as string;
}

/// Mangle a namespace to its object-file stem (`::` -> `_`), matching
/// `CodegenPasses::legacy_obj_path`.
function mangle_module(ns: string) -> string {
    const len: u64 = intrinsics::strlen(ns);
    const buf: i8* = intrinsics::malloc(len + 1) as i8*;
    intrinsics::memcpy(buf as void*, ns as void*, len);
    buf[len] = 0;
    for (mut i: u64 = 0; i < len; i++) {
        if (buf[i] == ':') { buf[i] = '_'; }
    }
    return buf as string;
}


// Up-to-date check + writing

/// True when the saved fingerprint matches `fp_hex` AND every artifact still
/// exists on disk. A missing sidecar or any missing artifact forces a build.
function is_up_to_date(cfg: ProjectConfig*, fp_hex: string,
                       artifacts: &string[]) -> boolean {
    const saved: string = read_file_trimmed(cfg.fingerprint_path());
    if (intrinsics::strlen(saved) == 0) { return false; }
    if (intrinsics::strcmp(saved, fp_hex) != 0) { return false; }
    for (mut i: i64 = 0; i < artifacts.length; i++) {
        if (!File::exists(artifacts[i])) { return false; }
    }
    return true;
}

/// Write the fingerprint sidecar (`incremental/inputs.fp`), creating the
/// incremental dir first.
function write_fingerprint(cfg: ProjectConfig*, fp_hex: string) -> void {
    ProjectConfig::mkdir_p(cfg.incremental_dir());
    const path: string = cfg.fingerprint_path();
    const f: void* = intrinsics::fopen(path, "w");
    if (f == null) {
        intrinsics::fprintf(g_stderr,
            "warning: cannot write build fingerprint to %s\n", path);
        return;
    }
    intrinsics::fprintf(f, "%s\n", fp_hex);
    intrinsics::fclose(f);
}

/// File size in bytes via `fseek`/`ftell`, without reading the contents.
/// Returns -1 when the file can't be opened.
function file_size_bytes(path: string) -> i64 {
    const h: void* = intrinsics::fopen(path, "rb");
    if (h == null) { return -1 as i64; }
    intrinsics::fseek(h, 0 as i64, 2);   // SEEK_END
    const n: i64 = intrinsics::ftell(h);
    intrinsics::fclose(h);
    return n;
}

/// Write the human/tooling-facing per-profile `build-manifest.json` at
/// `<output_dir>/target/<profile>/build-manifest.json`.
function write_manifest(cfg: ProjectConfig*, modules: &ModuleEntry[],
                        opt_level: u32, debug_info: boolean,
                        fp_hex: string, artifacts: &string[],
                        stdlib_archive: string) -> void {
    ProjectConfig::mkdir_p(cfg.profile_dir());
    const path: string = cfg.manifest_path();
    const f: void* = intrinsics::fopen(path, "w");
    if (f == null) {
        intrinsics::fprintf(g_stderr,
            "warning: cannot write build manifest to %s\n", path);
        return;
    }

    const compiler_fp: string = u64_to_hex(compiler_fingerprint());

    mut root: JsonObject = JsonObject::new();
    root.put("schema_version",       JsonValue::uint_value(2));
    root.put("generated_by",         JsonValue::from_cstr("cryo"));
    root.put("compiler_fingerprint", JsonValue::from_cstr(compiler_fp));
    root.put("project",              JsonValue::from_cstr(cfg.project_name));
    root.put("profile",              JsonValue::from_cstr(cfg.profile));
    root.put("target_type",          JsonValue::from_cstr(cfg.target_type.label()));
    root.put("target_triple",        JsonValue::from_cstr(cfg.target_triple));
    root.put("opt_level",            JsonValue::uint_value(opt_level as u64));
    root.put("debug_info",           JsonValue::bool_value(debug_info));
    root.put("emit_llvm",            JsonValue::bool_value(cfg.emit_llvm));
    root.put("no_std",               JsonValue::bool_value(cfg.no_std));
    root.put("stdlib_archive",       JsonValue::from_cstr(stdlib_archive));
    root.put("inputs_fingerprint",   JsonValue::from_cstr(fp_hex));

    // artifacts: absolute/cwd-relative paths, matching what `cryo run` execs.
    root.put("artifacts", JsonValue::string_array(artifacts));

    // [link] section snapshot.
    mut link: JsonObject = JsonObject::new();
    link.put("system", JsonValue::string_array(&cfg.link_system));
    link.put("search", JsonValue::string_array(&cfg.link_search));
    link.put("static", JsonValue::string_array(&cfg.link_static));
    root.put("link", JsonValue::Object(link));

    // modules: namespace + source + origin + object path + size.
    mut mods: Array<JsonValue> = Array<JsonValue>::new();
    for (mut i: i64 = 0; i < modules.length; i++) {
        const obj: string = format("%s/%s.o",
            cfg.deps_dir_for(modules[i].origin_subdir),
            mangle_module(modules[i].namespace_name));
        const obj_size: i64 = file_size_bytes(obj);
        mut m: JsonObject = JsonObject::new();
        m.put("namespace",   JsonValue::from_cstr(modules[i].namespace_name));
        m.put("source",      JsonValue::from_cstr(modules[i].source_path));
        m.put("origin",      JsonValue::from_cstr(modules[i].origin_subdir));
        m.put("kind",        JsonValue::from_cstr(modules[i].origin_kind));
        m.put("opt_level",   JsonValue::uint_value(opt_level as u64));
        m.put("debug_info",  JsonValue::bool_value(debug_info));
        m.put("object",      JsonValue::from_cstr(obj));
        m.put("object_size", JsonValue::int_value(obj_size));
        mods.push(JsonValue::Object(m));
    }
    root.put("modules", JsonValue::Array(mods));

    mut doc: JsonValue = JsonValue::Object(root);
    mut text: String = serializer::stringify_pretty(&doc);
    doc.drop();

    intrinsics::fwrite(text.as_ptr() as void*, 1, text.length(), f);
    intrinsics::fputs("\n", f);
    text.drop();
    intrinsics::fclose(f);
}
