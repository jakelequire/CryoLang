///! Build Manifest + Incremental Fingerprint
///!
///! Emits a self-describing per-profile `build-manifest.json` under
///! `<output_dir>/target/<profile>/` and a machine-readable fingerprint
///! sidecar under `<output_dir>/target/<profile>/local/incremental/<name>.fp`.
///!
///! The fingerprint is a 128-bit digest (`ContentHasher`) over EVERY build input:
///!   - the compiler binary's own bytes (so a changed compiler rebuilds),
///!   - the resolved knobs (opt level, debug info, emit-llvm, no-std,
///!     target triple, profile, and the `[link]` lists),
///!   - the stdlib archive's bytes (when linked), and
///!   - the full content of every discovered source module.
///!
///! The whole-build fingerprint is the OUTER fast path: if nothing changed
///! and the artifacts still exist, the entire compile+link is skipped before
///! the frontend even runs.
///!
///! When the whole-build fingerprint DOES differ, a per-module cache (the
///! `*.modkeys` sidecar) decides which modules' objects can be reused, so the
///! backend runs only for modules whose object would change.  A module's
///! object is a function of the bitcode its IR generation produces and the
///! toolchain (`toolchain_fingerprint`), so its key is a digest of exactly
///! those: the front end and IR generation run for every module in every
///! build, and a module whose bitcode is unchanged reuses its object.
///!
///! The whole-build fingerprint, up-to-date check, and `build-manifest.json`
///! write are bundled on the `Manifest` object, which captures the build's
///! config + resolved knobs once so the per-build inputs aren't threaded
///! through every call. The pure digest/hex folding helpers stay free because
///! the per-module-key loop in `instance.cryo` folds them directly.

namespace compiler::build_manifest;

import compiler::project_config::{ ProjectConfig };
import utils::build_stamp::{ BuildStamp, StampSlot };
import utils::log::{ Log, LogArea };
import std::fs::file::{ File };
import std::fs::file;
import std::fs::path::{ Path };
import std::fmt;
import std::env;
import std::core::{ hash, primitives };
import std::collections::string::{ String };
import std::collections::array::{ Array };
import std::json::{ value, serializer };
import std::collections::str::{ Str };
import std::core::hash::{ Hasher };
import std::core::slice::{ Slice };
import std::core::mem;
import std::json::value::{ JsonObject, JsonValue };

/// The running compiler's digest, once taken (`Manifest::compiler_fingerprint`).
mut g_compiler_fingerprint: u128 = 0;
mut g_compiler_fingerprint_taken: boolean = false;

const CONTENT_C1: u64 = 0x87c37b91114253d5;
const CONTENT_C2: u64 = 0x4cf5ad432745937f;

/// The 128-bit digest every build fingerprint and cache key is taken with:
/// MurmurHash3's x64 128-bit construction, sixteen bytes a step.  A digest
/// of the compiler's own executable is part of every build's key, so the
/// hasher's speed over tens of megabytes is the cost of every build.  Bytes
/// fed one at a time and bytes fed as a run give the same digest.
type struct ContentHasher {
    h1:     u64;
    h2:     u64;
    /// Bytes not yet making a whole sixteen-byte block, in `tail[0..tail_length]`.
    tail:   [u8; 16];
    tail_length: u64;
    length: u64;

    static new() -> ContentHasher {
        return ContentHasher { h1: 0, h2: 0, tail: [0; 16], tail_length: 0, length: 0 };
    }

    static rotate_left(x: u64, r: u64) -> u64 {
        return (x << r) | (x >> (64 - r));
    }

    static final_mix(k_in: u64) -> u64 {
        mut k: u64 = k_in;
        k = k ^ (k >> 33);
        k = k * 0xff51afd7ed558ccd;
        k = k ^ (k >> 33);
        k = k * 0xc4ceb9fe1a85ec53;
        k = k ^ (k >> 33);
        return k;
    }

    /// The little-endian word at `p`, read a byte at a time so it needs no
    /// alignment.
    static word_at(p: u8*) -> u64 {
        return (p[0] as u64) | ((p[1] as u64) << 8) | ((p[2] as u64) << 16)
            | ((p[3] as u64) << 24) | ((p[4] as u64) << 32) | ((p[5] as u64) << 40)
            | ((p[6] as u64) << 48) | ((p[7] as u64) << 56);
    }

    mix_block(mut &this, low: u64, high: u64) -> void {
        mut k1: u64 = low * CONTENT_C1;
        k1 = ContentHasher::rotate_left(k1, 31) * CONTENT_C2;
        this.h1 = this.h1 ^ k1;
        this.h1 = ContentHasher::rotate_left(this.h1, 27) + this.h2;
        this.h1 = this.h1 * 5 + 0x52dce729;
        mut k2: u64 = high * CONTENT_C2;
        k2 = ContentHasher::rotate_left(k2, 33) * CONTENT_C1;
        this.h2 = this.h2 ^ k2;
        this.h2 = ContentHasher::rotate_left(this.h2, 31) + this.h1;
        this.h2 = this.h2 * 5 + 0x38495ab5;
    }

    /// Feed `count` bytes starting at `data`.
    write_run(mut &this, data: u8*, count: i64) -> void {
        mut i: i64 = 0;
        while (i < count && this.tail_length > 0) {
            this.write_u8(data[i]);
            i = i + 1;
        }
        while (i + 16 <= count) {
            this.mix_block(ContentHasher::word_at(data + i), ContentHasher::word_at(data + i + 8));
            this.length = this.length + 16;
            i = i + 16;
        }
        while (i < count) {
            this.write_u8(data[i]);
            i = i + 1;
        }
    }

    /// The full 128-bit digest, first half high.
    finish128(&this) -> u128 {
        mut h1: u64 = this.h1;
        mut h2: u64 = this.h2;
        mut k1: u64 = 0;
        mut k2: u64 = 0;
        for (mut i: u64 = 0; i < this.tail_length; i++) {
            if (i < 8) {
                k1 = k1 | ((this.tail[i] as u64) << (i * 8));
            } else {
                k2 = k2 | ((this.tail[i] as u64) << ((i - 8) * 8));
            }
        }
        if (this.tail_length > 8) {
            k2 = k2 * CONTENT_C2;
            k2 = ContentHasher::rotate_left(k2, 33) * CONTENT_C1;
            h2 = h2 ^ k2;
        }
        if (this.tail_length > 0) {
            k1 = k1 * CONTENT_C1;
            k1 = ContentHasher::rotate_left(k1, 31) * CONTENT_C2;
            h1 = h1 ^ k1;
        }
        const total: u64 = this.length + this.tail_length;
        h1 = h1 ^ total;
        h2 = h2 ^ total;
        h1 = h1 + h2;
        h2 = h2 + h1;
        h1 = ContentHasher::final_mix(h1);
        h2 = ContentHasher::final_mix(h2);
        h1 = h1 + h2;
        h2 = h2 + h1;
        return ((h1 as u128) << 64) | (h2 as u128);
    }
}

implement trait Hasher for struct ContentHasher {
    write_u8(mut &this, value: u8) -> void {
        this.tail[this.tail_length] = value;
        this.tail_length = this.tail_length + 1;
        if (this.tail_length == 16) {
            this.mix_block(ContentHasher::word_at(&this.tail[0]), ContentHasher::word_at(&this.tail[8]));
            this.length = this.length + 16;
            this.tail_length = 0;
        }
    }

    write_bytes(mut &this, bytes: &Slice<u8>) -> void {
        this.write_run(bytes.as_ptr(), bytes.length());
    }

    finish(&this) -> u64 {
        return this.finish128() as u64;
    }
}

/// A source module feeding the build, as the fingerprint + manifest see it.
type struct ModuleEntry {
    namespace_name: string;   // e.g. "std::core::primitives"
    source_path:    string;   // path on disk
    origin_subdir:  string;   // output package subtree: "std" | "local" | <depname>
    origin_kind:    string;   // "stdlib" | "local" | "dep"
}


/// Prior per-module cache keys, loaded from the `*.modkeys` sidecar. Parallel
/// `names`/`keys` arrays; `lookup` returns the stored key hex for a namespace
/// or "" when absent (a never-before-seen module always rebuilds).
type struct ModuleKeyTable {
    names:      [string];
    keys:       [string];

    static empty() -> ModuleKeyTable {
        return ModuleKeyTable { names: [], keys: [] };
    }

    lookup(&this, name: string) -> string {
        for (mut i: i64 = 0; i < this.names.length(); i++) {
            if (this.names[i].eq(name)) {
                return this.keys[i];
            }
        }
        return "";
    }

    /// Copy `len` bytes from `data+start` into a fresh NUL-terminated string.
    static modkeys_slice(data: i8*, start: u64, len: u64) -> string {
        mut s: String = String::from_str(Str::from_raw((data + start) as u8*, len));
        return s.into_raw();
    }

    /// Parse the `*.modkeys` sidecar into a `ModuleKeyTable`. A missing or
    /// unreadable file yields an empty table (every module then rebuilds, which
    /// is the safe default). Lines without a TAB separator are skipped.
    ///
    /// Kept a free function (not a `ModuleKeyTable` static): a static method here
    /// resolves through the leaf-name dispatcher, where `read`/`write` collide
    /// with the same-arity `read`/`write` intrinsics and a reference-array static
    /// fails codegen resolution outright (E0636). The distinctly-named free
    /// function sidesteps both.
    static read_module_keys(path_text: string) -> ModuleKeyTable {
        const path: string = path_text;
        mut t: ModuleKeyTable = ModuleKeyTable::empty();
        if (!Path::from(path).exists()) { return t; }
        mut content: string = "";
        match (File::read_text(Path::from(path))) {
            Result::Ok(s)  => { content = s.into_raw(); }
            Result::Err(_) => { return t; }
        }
        const data: i8* = content as i8*;
        const n: u64 = content.length() as u64;
        mut i: u64 = 0;
        while (i < n) {
            const name_start: u64 = i;
            while (i < n && data[i] != 9 && data[i] != 10) { i = i + 1; }
            mut name: string = "";
            mut keyh: string = "";
            if (i < n && data[i] == 9) {
                name = ModuleKeyTable::modkeys_slice(data, name_start, i - name_start);
                i = i + 1;                       // skip TAB
                const key_start: u64 = i;
                while (i < n && data[i] != 9 && data[i] != 10) { i = i + 1; }
                keyh = ModuleKeyTable::modkeys_slice(data, key_start, i - key_start);
            }
            // Anything after the key is not part of the table.
            while (i < n && data[i] != 10) { i = i + 1; }
            if (i < n && data[i] == 10) { i = i + 1; }   // skip newline
            if (name.length() > 0 && keyh.length() > 0) {
                t.names.push(name);
                t.keys.push(keyh);
            }
        }
        return t;
    }

    /// Write the `*.modkeys` sidecar (`namespace<TAB>keyhex` per line). The
    /// caller must have created the incremental dir (e.g. via
    /// `Manifest::write_fingerprint`, which always runs alongside this on the
    /// success path).
    static write_module_keys(path: string, names: &[string], keys: &[string]) -> void {
        mut text: String = String::new();
        for (mut i: i64 = 0; i < names.length(); i++) {
            text.push(Str::new(names[i]));
            text.push_byte(9 as u8);     // TAB
            text.push(Str::new(keys[i]));
            text.push_byte(10 as u8);    // LF
        }
        match (File::write_bytes(Path::from(path), text.as_bytes())) {
            Result::Ok(_)  => {}
            Result::Err(_) => {
                fmt::eprintln(f"warning: cannot write per-module cache keys to {path}");
            }
        }
        mem::drop(text);
    }
}


// Build manifest object

/// Captures one build's config + resolved knobs so the whole-build
/// fingerprint, up-to-date short-circuit, and `build-manifest.json` write
/// share a single source of truth. `build_shape` is the digest of every
/// resolved option that shapes the build (`BuildOptions.fold_build_shape`);
/// `opt_level`, `debug_info` and `target_triple` are the resolved values the
/// manifest records. `stdlib_archive` and its key are "" for a build that
/// links no stdlib archive. The varying per-build inputs (the source module
/// list and the artifact paths) are passed to the methods that need them.
type struct Manifest {
    cfg:                ProjectConfig*;
    build_shape:        u128;
    opt_level:          u32;
    debug_info:         boolean;
    target_triple:      string;
    stdlib_archive:     string;
    stdlib_archive_key: string;

    static new(cfg: ProjectConfig*, build_shape: u128, opt_level: u32, debug_info: boolean,
               target_triple_text: string, stdlib_archive_text: string,
               stdlib_archive_key_text: string) -> Manifest {
        const target_triple: string = target_triple_text;
        const stdlib_archive: string = stdlib_archive_text;
        const stdlib_archive_key: string = stdlib_archive_key_text;
        return Manifest {
            cfg:                cfg,
            build_shape:        build_shape,
            opt_level:          opt_level,
            debug_info:         debug_info,
            target_triple:      target_triple,
            stdlib_archive:     stdlib_archive,
            stdlib_archive_key: stdlib_archive_key,
        };
    }

    /// Combined fingerprint over every build input.
    compute_fingerprint(&this, modules: &[ModuleEntry]) -> u128 {
        mut h: ContentHasher = ContentHasher::new();
        h.fold(Manifest::compiler_fingerprint());
        h.fold(this.build_shape);
        h.fold(this.cfg.profile);
        // [link] lists affect the final binary but not the .o files.
        for (mut i: i64 = 0; i < this.cfg.link_system.length(); i++) { h.fold(this.cfg.link_system[i]); }
        for (mut i: i64 = 0; i < this.cfg.link_search.length(); i++) { h.fold(this.cfg.link_search[i]); }
        for (mut i: i64 = 0; i < this.cfg.link_static.length(); i++) { h.fold(this.cfg.link_static[i]); }
        // The stdlib archive, by its key: the key is every input that decides
        // the archive's bytes, and an archive opens only under the key its
        // manifest records, so a rebuilt stdlib changes it.
        h.fold(this.stdlib_archive_key);
        // Every source module, in topo order: namespace + origin (output
        // location) + full content.  Folding origin_subdir means moving a
        // module between packages (which changes where its .o lands)
        // invalidates the cache even when its source bytes are unchanged.
        for (mut i: i64 = 0; i < modules.length(); i++) {
            h.fold(modules[i].namespace_name);
            h.fold(modules[i].origin_subdir);
            Manifest::fold_file(&h, modules[i].source_path);
        }
        return h.finish128();
    }

    /// True when the saved fingerprint matches `fp_hex` AND every artifact
    /// still exists on disk. A missing sidecar or any missing artifact forces
    /// a build.
    is_up_to_date(&this, fp_hex_text: string, artifacts: &[string]) -> boolean {
        const fp_hex: string = fp_hex_text;
        const saved: string = Manifest::read_file_trimmed(this.cfg.fingerprint_path());
        if (saved.length() == 0) { return false; }
        if (!saved.eq(fp_hex)) { return false; }
        for (mut i: i64 = 0; i < artifacts.length(); i++) {
            if (!Path::from(artifacts[i]).exists()) { return false; }
        }
        return true;
    }

    /// Write the fingerprint sidecar (`incremental/inputs.fp`) the next
    /// build's short-circuit compares, creating the incremental dir first.
    /// A build that reported warnings records none: skipping the next build
    /// would skip reporting them, so the next build analyses the program
    /// again, and reuses every object whose bitcode is unchanged.
    write_fingerprint(&this, fp_hex_text: string, reported_warnings: boolean) -> void {
        const fp_hex: string = fp_hex_text;
        ProjectConfig::mkdir_p(this.cfg.incremental_dir());
        const path: string = this.cfg.fingerprint_path();
        if (reported_warnings) {
            if (Path::from(path).exists()) {
                match (File::remove(Path::from(path))) {
                    Result::Ok(_)  => {}
                    Result::Err(_) => {
                        fmt::eprintln(f"warning: cannot remove the build fingerprint {path}; the next build may skip reporting this build's warnings");
                    }
                }
            }
            return;
        }
        mut text: String = String::new();
        text.push(Str::new(fp_hex));
        text.push_byte(10 as u8);        // LF
        match (File::write_bytes(Path::from(path), text.as_bytes())) {
            Result::Ok(_)  => {}
            Result::Err(_) => {
                fmt::eprintln(f"warning: cannot write build fingerprint to {path}");
            }
        }
        mem::drop(text);
    }

    /// Write the human/tooling-facing per-profile `build-manifest.json` at
    /// `<output_dir>/target/<profile>/build-manifest.json`.
    write_manifest(&this, modules: &[ModuleEntry], fp_hex_text: string,
                   artifacts: &[string]) -> void {
        const fp_hex: string = fp_hex_text;
        ProjectConfig::mkdir_p(this.cfg.profile_dir());
        const path: string = this.cfg.manifest_path();

        const cfp: u128 = Manifest::compiler_fingerprint();
        const compiler_fp: string = Manifest::hex128(cfp);

        mut root: JsonObject = JsonObject::new();
        root.put("schema_version",       JsonValue::uint_value(2));
        root.put("generated_by",         JsonValue::from("cryo"));
        root.put("compiler_fingerprint", JsonValue::from(compiler_fp));
        root.put("project",              JsonValue::from(this.cfg.project_name));
        root.put("profile",              JsonValue::from(this.cfg.profile));
        root.put("target_type",          JsonValue::from(this.cfg.target_type.label()));
        root.put("target_triple",        JsonValue::from(this.target_triple));
        root.put("opt_level",            JsonValue::uint_value(this.opt_level as u64));
        root.put("debug_info",           JsonValue::bool_value(this.debug_info));
        root.put("emit_llvm",            JsonValue::bool_value(this.cfg.emit_llvm));
        root.put("no_std",               JsonValue::bool_value(this.cfg.no_std));
        root.put("no_runtime",           JsonValue::bool_value(this.cfg.no_runtime));
        root.put("stdlib_archive",       JsonValue::from(this.stdlib_archive));
        root.put("inputs_fingerprint",   JsonValue::from(fp_hex));

        // artifacts: absolute/cwd-relative paths, matching what `cryo run` execs.
        root.put("artifacts", JsonValue::string_array(artifacts));

        // [link] section snapshot.
        mut link: JsonObject = JsonObject::new();
        link.put("system", JsonValue::string_array(&this.cfg.link_system));
        link.put("search", JsonValue::string_array(&this.cfg.link_search));
        link.put("static", JsonValue::string_array(&this.cfg.link_static));
        root.put("link", JsonValue::Object(link));

        // modules: namespace + source + origin + object path + size.
        mut mods: Array<JsonValue> = Array::<JsonValue>::new();
        for (mut i: i64 = 0; i < modules.length(); i++) {
            const obj: string = Path::from(this.cfg.deps_dir_for(modules[i].origin_subdir))
                .join(f"{Manifest::path_module(modules[i].namespace_name)}.o".as_str()).into_raw();
            const obj_size: i64 = Manifest::file_size_bytes(obj);
            mut m: JsonObject = JsonObject::new();
            m.put("namespace",   JsonValue::from(modules[i].namespace_name));
            m.put("source",      JsonValue::from(modules[i].source_path));
            m.put("origin",      JsonValue::from(modules[i].origin_subdir));
            m.put("kind",        JsonValue::from(modules[i].origin_kind));
            m.put("opt_level",   JsonValue::uint_value(this.opt_level as u64));
            m.put("debug_info",  JsonValue::bool_value(this.debug_info));
            m.put("object",      JsonValue::from(obj));
            m.put("object_size", JsonValue::int_value(obj_size));
            mods.push(JsonValue::Object(m));
        }
        root.put("modules", JsonValue::Array(mods));

        mut doc: JsonValue = JsonValue::Object(root);
        mut text: String = serializer::stringify_pretty(&doc);
        mem::drop(doc);

        text.push_byte(10 as u8);        // trailing newline (matches prior fputs)
        match (File::write_bytes(Path::from(path), text.as_bytes())) {
            Result::Ok(_)  => {}
            Result::Err(_) => {
                fmt::eprintln(f"warning: cannot write build manifest to {path}");
            }
        }
        mem::drop(text);
    }

    /// A 128-bit digest as 32 lowercase hex characters, high half first.
    /// The single renderer for every fingerprint the build records, so a
    /// digest has one textual form wherever it appears - manifest, `.fp`
    /// sidecar, or `.modkeys` table.
    static hex128(d: u128) -> string {
        const hi: u64 = (d >> 64) as u64;
        const lo: u64 = d as u64;
        return hi.to_hex_padded_str(16) + lo.to_hex_padded_str(16);
    }

    /// Fold a file's full byte content (NULs included) into the running digest
    /// `h`. A missing or unreadable file folds a distinct marker so it still
    /// perturbs the fingerprint. The byte count is mixed in last as a length
    /// guard. File reading is compiler-specific, so this lives here and drives
    /// the canonical `Hasher::fold` for the actual byte mixing.
    static fold_file<H>(h: mut H*, path_text: string) -> void
    where H: Hasher {
        Manifest::fold_file_contents::<H>(h, path_text, false);
    }

    /// `fold_file`, reading a binary's build stamp as zeros when
    /// `clear_stamp` is set.
    static fold_file_contents<H>(h: mut H*, path_text: string, clear_stamp: boolean) -> void
    where H: Hasher {
        const path: string = path_text;
        if (!Path::from(path).exists()) {
            h.fold("<missing>");
            return;
        }
        match (File::read_bytes(Path::from(path))) {
            Result::Ok(data) => {
                mut bytes: Array<u8> = data;
                const n: i64 = bytes.length();
                const d: mut u8* = bytes.as_mutable_ptr();
                if (clear_stamp) {
                    StampSlot::clear_text(d, n);
                }
                h.write_bytes(Slice::from_raw(d, n));
                mem::drop(bytes);
                h.fold(n);
            }
            Result::Err(_) => {
                h.fold("<unreadable>");
            }
        }
    }

    /// Path to the running compiler binary, or "" on failure. Delegates to
    /// `std::env::current_exe` (which handles `/proc/self/exe` on Unix and
    /// `GetModuleFileNameA` on Windows) instead of reimplementing readlink.
    static self_exe_path() -> string {
        match (env::current_exe()) {
            Option::Some(s) => { return s.into_raw(); }
            Option::None    => { return ""; }
        }
    }

    /// Digest of the running compiler's own bytes. Changes whenever the
    /// compiler changes, invalidating every cached build it produced.  It is
    /// the digest `cryo stamp` recorded when the stamp holds one for a binary
    /// of this one's size, and `binary_fingerprint` of the binary otherwise.
    /// Taken once per process: the binary does not change while it runs.
    static compiler_fingerprint() -> u128 {
        if (g_compiler_fingerprint_taken) { return g_compiler_fingerprint; }
        const exe: string = Manifest::self_exe_path();
        if (exe.length() == 0) {
            mut h: ContentHasher = ContentHasher::new();
            h.fold("<unknown-compiler>");
            g_compiler_fingerprint = h.finish128();
        } else {
            mut size: i64 = -1;
            match (Path::from(exe).metadata()) {
                Result::Ok(m)  => { size = m.length(); }
                Result::Err(_) => { }
            }
            match (BuildStamp::running().recorded_fingerprint(size)) {
                Option::Some(recorded) => {
                    g_compiler_fingerprint = recorded;
                    Log::debug(LogArea::Driver, "compiler fingerprint read from the build stamp");
                }
                Option::None => {
                    g_compiler_fingerprint = Manifest::binary_fingerprint(exe);
                    Log::debug(LogArea::Driver, "compiler fingerprint computed from the binary: its stamp records none for its size");
                }
            }
        }
        g_compiler_fingerprint_taken = true;
        return g_compiler_fingerprint;
    }

    /// Digest of the binary at `path`, its build stamp read as zeros:
    /// `cryo stamp` rewrites the stamp in place and it changes nothing the
    /// compiler emits, so a new stamp is not a new compiler.  This is what
    /// `cryo stamp` records and what a run of that binary is identified by.
    static binary_fingerprint(path: string) -> u128 {
        mut h: ContentHasher = ContentHasher::new();
        Manifest::fold_file_contents(&h, path, true);
        return h.finish128();
    }

    /// Digest of what emitting a module's object reads besides its bitcode:
    /// the compiler's own bytes (its backend), the optimization level the
    /// backend runs at and the resolved triple its target machine is made
    /// for.  Every per-module key folds this with the module's bitcode.
    static toolchain_fingerprint(opt_level: u32, target_triple_text: string) -> u128 {
        const target_triple: string = target_triple_text;
        mut h: ContentHasher = ContentHasher::new();
        h.fold(Manifest::compiler_fingerprint());
        h.fold(opt_level);
        h.fold(target_triple);
        return h.finish128();
    }

    /// Read a file's content with trailing whitespace/newlines stripped, or ""
    /// when the file is absent or unreadable.
    static read_file_trimmed(path_text: string) -> string {
        const path: string = path_text;
        mut raw: string = "";
        match (File::read_text(Path::from(path))) {
            Result::Ok(s)  => { raw = s.into_raw(); }
            Result::Err(_) => { return ""; }
        }
        mut len: i64 = raw.length() as i64;
        while (len > 0 && (raw[len - 1] == 10 || raw[len - 1] == 13
                           || raw[len - 1] == 32 || raw[len - 1] == 9)) {
            len -= 1;
        }
        if (len <= 0) { return ""; }
        mut s: String = String::from_str(Str::from_raw(raw as u8*, len as u64));
        return s.into_raw();
    }


    /// Map a namespace to its object-file RELATIVE PATH: each `::` becomes a
    /// directory separator (`std::core::intrinsics` -> `std/core/intrinsics`),
    /// while a lone `_` inside a segment (`raw_buffer`) is preserved.  Object
    /// files are laid out in per-namespace SUBDIRECTORIES under the origin's
    /// `deps/` dir (rather than one flat folder of `__`-joined stems), so the
    /// build tree mirrors the source tree.  Every site that names a module's
    /// `.o` - fresh emit (`legacy_obj_path`), the incremental cache probe/reuse,
    /// and this manifest's artifact prediction - MUST route through here, or the
    /// predicted path and the emitted path diverge and caching breaks.
    static path_module(ns: string) -> string {
        return ns.replace("::", "/");
    }

    /// File size in bytes via `fs::metadata`, without reading the contents.
    /// Returns -1 when the file can't be stat'd.
    static file_size_bytes(path_text: string) -> i64 {
        const path: string = path_text;
        match (Path::from(path).metadata()) {
            Result::Ok(m)  => { return m.length(); }
            Result::Err(_) => { return -1 as i64; }
        }
    }
}
