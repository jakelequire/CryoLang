// TEMPORARY - the read-only borrow fallout probe.  Deleted in the session that adds it.

namespace compiler::readonly_probe;

import std::env;
import std::fmt;
import std::process;
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::fs::file::{ File, OpenOptions };
import std::fs::path::{ Path };
import compiler::diag::source_span::{ SourceSpan };

type struct ReadOnlyProbe {
    unused: u8;

    /// Append `category|file:line:col` to the file `CRYO_READONLY_PROBE` names.
    static record(category: string, span: SourceSpan) -> void {
        match (env::var(Str::new("CRYO_READONLY_PROBE"))) {
            Option::Some(value) => {
                const path: String = value;
                mut options: OpenOptions = OpenOptions::new();
                options = options.write(true).append(true).create(true);
                const own_path: string = fmt::format("%s.%d", path.as_cstr() as string, process::id());
                match (File::open_with(Path::from(Str::new(own_path)), &options)) {
                    Result::Ok(opened) => {
                        mut file: File = opened;
                        mut directory: string = "";
                        match (env::var(Str::new("PWD"))) {
                            Option::Some(pwd) => {
                                const pwd_text: String = pwd;
                                directory = fmt::format("%s/", pwd_text.as_cstr() as string);
                            }
                            Option::None => { }
                        }
                        const text: string = fmt::format("%s|%s%s:%u:%u\n", category, directory, span.file, span.start_line, span.start_col);
                        match (file.write(Str::new(text))) {
                            Result::Ok(_)  => { }
                            Result::Err(_) => { }
                        }
                    }
                    Result::Err(_) => { }
                }
            }
            Option::None => { }
        }
    }
}
