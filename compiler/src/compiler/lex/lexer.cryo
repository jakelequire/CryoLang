namespace Compiler::Lex::Lexer;

import Compiler::Lex;
import Compiler::Diag;
import Compiler::Diag::SourceSpan;
import Compiler::Diag::Diagnostic;
import Compiler::Diag::Suggestion;
import Compiler::Diag::Sink;
import Utils::Logger;
import std::collections::string;
import std::collections::str;

type struct Lexer {
private:
    path:             string;
    source:           string;
    buffer:           string;
    current:          string;
    buffer_start:     string;
    buffer_end:       string;
    spot_content:     string;
    current_location: SourceLocation;
    current_token:    Token;
    previous_token:   Token;
    token_count:      u64;
    sink:             DiagnosticSink*;

public:
    /// `source` is the already-loaded, NUL-terminated source text.  The
    /// caller owns the read: on-disk files come from
    /// `fs::file::read_to_string(...).into_raw()`, in-memory buffers
    /// (LSP overrides, f-string sub-lexing) are passed through verbatim.
    static new(path: string, source: string, sink: DiagnosticSink*) -> Lexer {
        return Lexer {
            path:             path,
            source:           source,
            buffer:           "",
            current:          "",
            buffer_start:     "",
            buffer_end:       "",
            spot_content:     "",
            current_location: SourceLocation::new(path, 1, 1),
            current_token:    Token::new(TokenType::Unknown, "", 1, 1),
            previous_token:   Token::new(TokenType::Unknown, "", 1, 1),
            token_count:      0,
            sink:             sink,
        };
    }

    lex(&this) -> Token[] {
        LOG_DEBUG(LogComponent::Lexer, "[Lexer] lex() entry: file=%s", this.path);

        const size: u64 = this.source.length() as u64;
        LOG_DEBUG(LogComponent::Lexer, "[Lexer] Source ready, size=%d bytes", size);

        this.buffer       = this.source;
        this.buffer_start = this.buffer;
        this.buffer_end   = this.buffer + (size as i64);
        this.current      = this.buffer_start;

        mut tokens: Token[] = [];

        while (!this.at_end()) {
            const tok: Token = this.lex_token();
            tokens.push(tok);
            this.previous_token = tok;
        }

        const eof: Token = this.make_token(TokenType::EOF, "");
        tokens.push(eof);

        LOG_DEBUG(LogComponent::Lexer, "[Lexer] Lexing complete, total tokens: %d", tokens.length);
        return tokens;
    }

private:
    lex_token(&this) -> Token {
        this.skip_whitespace();

        if (this.at_end()) {
            return this.make_token(TokenType::EOF, "");
        }

        // Comments must be detected BEFORE advance():
        // Check for // and /* patterns using peek/peek_ahead to avoid
        // relying on post-advance pointer arithmetic (this.current - 1).
        if (this.peek() == '/') {
            const next_ch: char = this.peek_ahead(1);

            if (next_ch == '/') {
                // Line comment (//) or doc comment (///)
                this.advance(); // consume first '/'
                if (this.peek_ahead(1) == '/') {
                    return this.lex_doc_comment();
                }
                return this.lex_comment();
            }

            if (next_ch == '*') {
                // Block comment (/* */) or doc comment (/** */)
                this.advance(); // consume first '/'
                if (this.peek_ahead(1) == '*') {
                    return this.lex_doc_comment();
                }
                return this.lex_comment();
            }
        }

        const token_start: string = this.current;
        const c: char = this.advance();

        // f-string prefix: `f"..."`.  Must precede the is_alpha check
        // because `f` is alpha and would otherwise lex as the identifier
        // `f` followed by a plain string literal.  Only the immediate
        // `f"` digraph triggers this; a bare `f` (or `foo`) still lexes as
        // an identifier.
        if (c == 'f' && this.peek() == '"') {
            this.advance(); // consume the opening quote
            return this.lex_fstring();
        }

        if (Lexer::is_alpha(c)) {
            return this.lex_identifier();
        }

        if (Lexer::is_digit(c)) {
            return this.lex_number();
        }

        if (c == '"') {
            return this.lex_string(c);
        }

        if (c == '\'') {
            return this.lex_character();
        }

        const punct_kind: TokenType = this.lex_punctuator(c);
        if (punct_kind != TokenType::Unknown) {
            const punct_len: u64 = (this.current as i64 - token_start as i64) as u64;
            const punct_lexeme: string = token_start.substr(0, punct_len);
            return this.make_token(punct_kind, punct_lexeme);
        }

        LOG_DEBUG(LogComponent::Lexer, "[Lexer] Unexpected character at line %d col %d", this.current_location.line, this.current_location.column);
        return this.emit_error(ErrorCode::E0001_UNEXPECTED_CHARACTER, "Unexpected character");
    }

    lex_identifier(&this) -> Token {
        // Back up one character: lex_token() already consumed the first char via advance()
        const start: string = this.current - 1;

        while (!this.at_end()) {
            if (Lexer::is_alnum(this.peek())) {
                this.advance();
            } else {
                break;
            }
        }

        const len: u64 = (this.current as i64 - start as i64) as u64;
        const text: string = start.substr(0, len);
        const kw_kind: TokenType = TokenType::from_keyword(text);
        const kind: TokenType = if (kw_kind == TokenType::Unknown) { TokenType::Identifier } else { kw_kind };

        return this.make_token(kind, text);
    }

    lex_number(&this) -> Token {
        // Back up one character: lex_token() already consumed the first digit via advance()
        const start: string = this.current - 1;

        mut is_special_base: boolean = false;
        // Set once a fractional part or exponent is seen, so the suffix
        // check below can reject an integer type suffix on a float
        // literal (`1.5u8`, `2.0i32`).
        mut is_float: boolean = false;

        // Special base prefixes (0x, 0b, 0o)
        if (*start == '0' && !this.at_end()) {
            const prefix: char = this.peek();

            // A lone `_` advances the cursor without contributing a digit,
            // so a "cursor moved" check (`current == start`) wrongly accepts
            // `0x_`/`0b_`/`0o_` and values them as a silent 0. Track whether
            // an actual digit (not just a separator) was seen.
            mut saw_digit: boolean = false;

            if (prefix == 'x' || prefix == 'X') {
                this.advance(); // consume 'x'/'X'

                while (!this.at_end() && (Lexer::is_hex_digit(this.peek()) || this.peek() == '_')) {
                    if (this.peek() != '_') { saw_digit = true; }
                    this.advance();
                }

                if (!saw_digit) {
                    LOG_DEBUG(LogComponent::Lexer, "[Lexer] Invalid hexadecimal number at line %d", this.current_location.line);
                    return this.emit_error(ErrorCode::E0007_INVALID_HEX, "Invalid hexadecimal number");
                }

                is_special_base = true;

            } else if (prefix == 'b' || prefix == 'B') {
                this.advance(); // consume 'b'/'B'

                while (!this.at_end() && (this.peek() == '0' || this.peek() == '1' || this.peek() == '_')) {
                    if (this.peek() != '_') { saw_digit = true; }
                    this.advance();
                }

                if (!saw_digit) {
                    LOG_DEBUG(LogComponent::Lexer, "[Lexer] Invalid binary number at line %d", this.current_location.line);
                    return this.emit_error(ErrorCode::E0008_INVALID_BINARY, "Invalid binary number");
                }

                is_special_base = true;

            } else if (prefix == 'o' || prefix == 'O') {
                this.advance(); // consume 'o'/'O'

                while (!this.at_end()) {
                    const ch: char = this.peek();
                    if ((ch >= '0' && ch <= '7') || ch == '_') {
                        if (ch != '_') { saw_digit = true; }
                        this.advance();
                    } else {
                        break;
                    }
                }

                if (!saw_digit) {
                    LOG_DEBUG(LogComponent::Lexer, "[Lexer] Invalid octal number at line %d", this.current_location.line);
                    return this.emit_error(ErrorCode::E0009_INVALID_OCTAL, "Invalid octal number");
                }

                is_special_base = true;
            }
        }

        if (!is_special_base) {
            while (!this.at_end() && (Lexer::is_digit(this.peek()) || this.peek() == '_')) {
                this.advance();
            }

            if (!this.at_end() && this.peek() == '.') {
                const next: char = this.peek_ahead(1);
                if (Lexer::is_digit(next)) {
                    is_float = true;
                    this.advance(); // consume '.'
                    while (!this.at_end() && (Lexer::is_digit(this.peek()) || this.peek() == '_')) {
                        this.advance();
                    }
                }
            }

            if (!this.at_end() && (this.peek() == 'e' || this.peek() == 'E')) {
                is_float = true;
                this.advance();
                if (!this.at_end()) {
                    if (this.peek() == '+' || this.peek() == '-') {
                        this.advance();
                    }
                }
                // A float exponent must carry at least one digit. `1e`, `1e+`,
                // `2e-` previously lexed and were silently valued as the
                // mantissa (the downstream sscanf("%lf") stops at the stray
                // 'e'), so `1e` became 1.0 with no diagnostic. Mirror the
                // empty-hex/bin/oct rejection above.
                if (this.at_end() || !Lexer::is_digit(this.peek())) {
                    LOG_DEBUG(LogComponent::Lexer, "[Lexer] Malformed float exponent at line %d", this.current_location.line);
                    return this.emit_error(ErrorCode::E0011_LEXING_EXCEPTION,
                        "malformed float literal: the exponent has no digits");
                }
                while (!this.at_end() && (Lexer::is_digit(this.peek()) || this.peek() == '_')) {
                    this.advance();
                }
            }
        }

        // Type suffixes (u8, i32, f64, etc.)
        if (!this.at_end() && Lexer::is_alpha(this.peek())) {
            const suffix_start: string = this.current;

            while (!this.at_end() && Lexer::is_alnum(this.peek())) {
                this.advance();
            }

            const suffix_len: u64 = (this.current as i64 - suffix_start as i64) as u64;
            const suffix: string = suffix_start.substr(0, suffix_len);

            if (!Lexer::is_valid_numeric_suffix(suffix)) {
                // Not a valid suffix, backtrack
                this.current = suffix_start;
            } else if (is_float && !Lexer::is_float_suffix(suffix)) {
                // A float literal (has a fractional part or exponent) may
                // only carry a float suffix. `1.5u8` / `2.0i32` were
                // previously accepted with the contradictory integer
                // suffix riding along in the lexeme.
                return this.emit_error(ErrorCode::E0011_LEXING_EXCEPTION,
                    "integer type suffix on a floating-point literal; use `f32`/`f64` or drop the suffix");
            }
        }

        const len: u64 = (this.current as i64 - start as i64) as u64;
        const lexeme: string = start.substr(0, len);

        return this.make_token(TokenType::NumericConstant, lexeme);
    }

    lex_string(&this, quote: char) -> Token {
        // Capture the position of the opening quote.  The dispatcher
        // consumed it via `advance()` immediately before calling
        // `lex_string`, so `current_location.column` is one past it
        // and `current` points to the first body byte.
        const start_line: int = this.current_location.line;
        const start_col:  int = this.current_location.column - 1;

        const start: string = this.current;

        while (!this.at_end() && this.peek() != quote) {
            if (this.peek() == '\\' && !this.at_end()) {
                this.advance(); // consume backslash
                if (!this.at_end()) {
                    this.advance(); // consume escaped character
                }
            } else {
                if (this.peek() == '\n') {
                    this.current_location.newline();
                }
                this.advance();
            }
        }

        if (this.at_end()) {
            LOG_DEBUG(LogComponent::Lexer, "[Lexer] Unterminated string literal at line %d", this.current_location.line);
            return this.emit_error_close_literal(
                ErrorCode::E0002_UNTERMINATED_STRING,
                "Unterminated string literal",
                "\"");
        }

        this.advance(); // consume closing quote

        // Extract raw content without surrounding quotes:
        // `start` already points past the opening quote, so offset=0.
        // Subtract 1 for the closing quote that was just consumed.
        const raw_len: u64 = (this.current as i64 - start as i64 - 1) as u64;
        const raw_text: string = start.substr(0, raw_len);

        const processed: string = Lexer::process_escape_sequences(raw_text);

        // Source extent covers both quotes plus every byte between
        // them (including escape digraphs, which the processed lexeme
        // collapses to one byte).  Computing from raw_len + 2 keeps
        // the math self-evident.
        const source_length: int = (raw_len + 2 as u64) as int;

        return Token::new_with_extent(
            TokenType::StringLiteral, processed,
            start_line, start_col, source_length);
    }

    /// Lex an f-string `f"..."`.  The dispatcher consumed both the `f`
    /// and the opening `"`, so `current` points at the first body byte.
    ///
    /// Unlike `lex_string`, escape sequences are NOT processed here and the
    /// raw template (everything up to the closing quote, braces included)
    /// is stored verbatim in the lexeme.  The parser splits the template on
    /// `{`/`}`, sub-parses each hole as an expression, and processes the
    /// per-chunk escapes there.  We still skip `\X` digraphs while scanning
    /// so an escaped quote `\"` doesn't terminate the literal early.
    lex_fstring(&this) -> Token {
        const start_line: int = this.current_location.line;
        // The `f` and the `"` were both consumed by the dispatcher, so the
        // opening `f` sits two columns back from `current`.
        const start_col:  int = this.current_location.column - 2;

        const start: string = this.current;

        while (!this.at_end() && this.peek() != '"') {
            if (this.peek() == '\\' && !this.at_end()) {
                this.advance(); // consume backslash
                if (!this.at_end()) {
                    this.advance(); // consume escaped character
                }
            } else {
                if (this.peek() == '\n') {
                    this.current_location.newline();
                }
                this.advance();
            }
        }

        if (this.at_end()) {
            LOG_DEBUG(LogComponent::Lexer, "[Lexer] Unterminated f-string literal at line %d", this.current_location.line);
            return this.emit_error_close_literal(
                ErrorCode::E0002_UNTERMINATED_STRING,
                "Unterminated f-string literal",
                "\"");
        }

        this.advance(); // consume closing quote

        // Raw template without the surrounding quotes: `start` points past
        // the opening quote, subtract 1 for the closing quote consumed above.
        const raw_len: u64 = (this.current as i64 - start as i64 - 1) as u64;
        const raw_text: string = start.substr(0, raw_len);

        // Source extent covers `f`, both quotes, and every body byte.
        const source_length: int = (raw_len + 3 as u64) as int;

        return Token::new_with_extent(
            TokenType::FStringLiteral, raw_text,
            start_line, start_col, source_length);
    }

    lex_character(&this) -> Token {
        const start: string = this.current;
        // `lex_token()` already consumed the opening `'` via advance(), so
        // `current_location.column` sits one past it - the opening quote's
        // own column is one back.  Capture it for an accurate token span;
        // `make_token` would instead derive the column from the
        // quote-stripped lexeme length and land two columns too far right.
        const start_line: int = this.current_location.line;
        const start_col:  int = this.current_location.column - 1;

        // Escape sequence
        if (this.peek() == '\\') {
            this.advance(); // consume backslash
            if (!this.at_end()) {
                const escape_char: char = this.peek();
                this.advance(); // consume the escape character (n, t, r, etc.)

                // Handle hex escape sequences (\xHH)
                if (escape_char == 'x') {
                    mut i: int = 0;
                    while (i < 2 && !this.at_end() && Lexer::is_hex_digit(this.peek())) {
                        this.advance();
                        i++;
                    }
                } else if (escape_char == 'u') {
                    // Unicode escape \u{HEX}: consume the brace-delimited
                    // codepoint so its body isn't mistaken for extra
                    // characters (which would mis-report `'\u{1F600}'` as a
                    // multi-character literal).
                    if (!this.at_end() && this.peek() == '{') {
                        this.advance(); // consume '{'
                        while (!this.at_end() && Lexer::is_hex_digit(this.peek())) {
                            this.advance();
                        }
                        if (!this.at_end() && this.peek() == '}') {
                            this.advance(); // consume '}'
                        }
                    }
                }
            }
        } else {
            // UTF-8 multi-byte character handling
            const first_byte: u8 = this.peek() as u8;

            if (first_byte < 0x80 as u8) {
                // ASCII (0xxxxxxx)
                this.advance();
            } else if ((first_byte & 0xE0 as u8) == (0xC0 as u8)) {
                // 2-byte UTF-8 (110xxxxx 10xxxxxx)
                this.advance();
                if (!this.at_end() && ((this.peek() as u8) & (0xC0 as u8)) == (0x80 as u8)) {
                    this.advance();
                }
            } else if ((first_byte & 0xF0 as u8) == (0xE0 as u8)) {
                // 3-byte UTF-8 (1110xxxx 10xxxxxx 10xxxxxx)
                this.advance();
                if (!this.at_end() && ((this.peek() as u8) & (0xC0 as u8)) == (0x80 as u8)) {
                    this.advance();
                    if (!this.at_end() && ((this.peek() as u8) & (0xC0 as u8)) == (0x80 as u8)) {
                        this.advance();
                    }
                }
            } else if ((first_byte & 0xF8 as u8) == (0xF0 as u8)) {
                // 4-byte UTF-8 (11110xxx 10xxxxxx 10xxxxxx 10xxxxxx)
                this.advance();
                if (!this.at_end() && ((this.peek() as u8) & (0xC0 as u8)) == (0x80 as u8)) {
                    this.advance();
                    if (!this.at_end() && ((this.peek() as u8) & (0xC0 as u8)) == (0x80 as u8)) {
                        this.advance();
                        if (!this.at_end() && ((this.peek() as u8) & (0xC0 as u8)) == (0x80 as u8)) {
                            this.advance();
                        }
                    }
                }
            } else {
                // Invalid UTF-8 byte, consume it anyway
                this.advance();
            }
        }

        if (this.at_end() || this.peek() != '\'') {
            // Distinguish a genuinely unterminated literal from a multi-
            // character one like 'AB'. Scan the rest of the line for a
            // closing quote: if one exists, the user wrote too many
            // characters (not an unterminated literal), and the
            // close-the-literal autofix would be actively harmful - it would
            // turn 'AB' into 'A'B'. Consume through the closing quote so the
            // error doesn't cascade into a second diagnostic on the tail.
            mut found_close: boolean = false;
            while (!this.at_end() && this.peek() != '\n') {
                if (this.peek() == '\'') { found_close = true; break; }
                this.advance();
            }
            if (found_close) {
                this.advance(); // consume the closing quote (recovery)
                return this.emit_error_multi_char_literal();
            }
            LOG_DEBUG(LogComponent::Lexer, "[Lexer] Unterminated character literal at line %d", this.current_location.line);
            return this.emit_error_close_literal(
                ErrorCode::E0003_UNTERMINATED_CHAR,
                "Unterminated character literal",
                "'");
        }
        this.advance(); // consume closing '\''

        // `start` points past the opening quote; subtract 1 for closing quote.
        const len: u64 = (this.current as i64 - start as i64 - 1) as u64;
        const lexeme: string = start.substr(0, len);

        return Token::new(TokenType::CharConstant, lexeme, start_line, start_col);
    }

    lex_comment(&this) -> Token {
        // `this.current` points to the second character of the comment opener
        // (the second '/' for //, or '*' for /*).  Back up one for the token start.
        const start: string = this.current - 1;
        const opener: char = *this.current as char;

        if (opener == '/') {
            this.advance(); // consume second '/'
            while (!this.at_end() && this.peek() != '\n') {
                this.advance();
            }

        } else if (opener == '*') {
            this.advance(); // consume '*'

            while (!this.at_end()) {
                if (this.peek() == '*' && this.peek_ahead(1) == '/') {
                    this.advance(); // consume '*'
                    this.advance(); // consume '/'
                    break;
                }
                if (this.peek() == '\n') {
                    this.current_location.newline();
                }
                this.advance();
            }
        }

        const len: u64 = (this.current as i64 - start as i64) as u64;
        const lexeme: string = start.substr(0, len);

        return this.make_token(TokenType::Comment, lexeme);
    }

    lex_doc_comment(&this) -> Token {
        // `this.current` points to the second character of the opener.
        // Back up one for the token start.
        const start: string = this.current - 1;
        mut doc_kind: TokenType = TokenType::Unknown;

        if (this.peek() == '/' && this.peek_ahead(1) == '/') {
            doc_kind = TokenType::DocCommentLine;
            this.advance(); // consume second '/'
            this.advance(); // consume third '/'

            // Skip optional space after ///
            if (this.peek() == ' ') {
                this.advance();
            }

            while (!this.at_end() && this.peek() != '\n') {
                this.advance();
            }

        } else if (this.peek() == '*' && this.peek_ahead(1) == '*') {
            doc_kind = TokenType::DocCommentBlock;
            this.advance(); // consume '*'
            this.advance(); // consume second '*'

            // Skip optional space or newline after /**
            if (this.peek() == ' ' || this.peek() == '\n') {
                if (this.peek() == '\n') {
                    this.current_location.newline();
                }
                this.advance();
            }

            while (!this.at_end()) {
                if (this.peek() == '*' && this.peek_ahead(1) == '/') {
                    this.advance(); // consume '*'
                    this.advance(); // consume '/'
                    break;
                }
                if (this.peek() == '\n') {
                    this.current_location.newline();
                }
                this.advance();
            }

        } else {
            return this.lex_comment();
        }

        const len: u64 = (this.current as i64 - start as i64) as u64;
        const lexeme: string = start.substr(0, len);

        return this.make_token(doc_kind, lexeme);
    }

    lex_punctuator(&this, c: char) -> TokenType {
        match (c) {
            '('  => { return TokenType::LParen;     }
            ')'  => { return TokenType::RParen;     }
            '{'  => { return TokenType::LBrace;     }
            '}'  => { return TokenType::RBrace;     }
            '['  => { return TokenType::LSquare;    }
            ']'  => { return TokenType::RSquare;    }
            ';'  => { return TokenType::Semicolon;  }
            ','  => { return TokenType::Comma;      }
            '%' => {
                if (this.peek() == '=') { this.advance(); return TokenType::PercentEqual; }
                return TokenType::Percent;
            }
            '^' => {
                if (this.peek() == '=') { this.advance(); return TokenType::CaretEqual; }
                return TokenType::Caret;
            }
            '~'  => { return TokenType::Tilde;      }
            '!' => {
                if (this.peek() == '=') { this.advance(); return TokenType::ExclaimEqual; }
                if (this.peek() == '[') { this.advance(); return TokenType::BangBracket; }
                return TokenType::Exclaim;
            }
            '@'  => { return TokenType::At;         }
            '#' => {
                if (this.peek() == '#') { this.advance(); return TokenType::HashHash; }
                return TokenType::Hash;
            }
            '$'  => { return TokenType::Dollar;     }
            '\\' => { return TokenType::Backslash;  }

            '.' => {
                if (this.peek() == '.') {
                    if (this.peek_ahead(1) == '.') {
                        this.advance();
                        this.advance();
                        return TokenType::Ellipsis;
                    }
                    if (this.peek_ahead(1) == '=') {
                        this.advance();
                        this.advance();
                        return TokenType::DotDotEq;
                    }
                    this.advance();
                    return TokenType::DotDot;
                }
                return TokenType::Period;
            }

            '+' => {
                if (this.peek() == '+') { this.advance(); return TokenType::PlusPlus;   }
                if (this.peek() == '=') { this.advance(); return TokenType::PlusEqual;  }
                return TokenType::Plus;
            }

            '-' => {
                if (this.peek() == '-') { this.advance(); return TokenType::MinusMinus; }
                if (this.peek() == '=') { this.advance(); return TokenType::MinusEqual; }
                if (this.peek() == '>') { this.advance(); return TokenType::Arrow;      }
                return TokenType::Minus;
            }

            '*' => {
                if (this.peek() == '=') { this.advance(); return TokenType::StarEqual; }
                return TokenType::Star;
            }

            '/' => {
                if (this.peek() == '=') { this.advance(); return TokenType::SlashEqual; }
                return TokenType::Slash;
            }

            '=' => {
                if (this.peek() == '=') { this.advance(); return TokenType::EqualEqual; }
                if (this.peek() == '>') { this.advance(); return TokenType::FatArrow;   }
                return TokenType::Equal;
            }

            '<' => {
                if (this.peek() == '=') {
                    this.advance();
                    if (this.peek() == '>') { this.advance(); return TokenType::Spaceship;      }
                    return TokenType::LessEqual;
                }
                if (this.peek() == '<') {
                    this.advance();
                    if (this.peek() == '=') { this.advance(); return TokenType::LessLessEqual;  }
                    return TokenType::LessLess;
                }
                if (this.peek() == '|') { this.advance(); return TokenType::LessPipe; }
                return TokenType::LAngle;
            }

            '>' => {
                if (this.peek() == '=') {
                    this.advance();
                    return TokenType::GreaterEqual;
                }
                if (this.peek() == '>') {
                    this.advance();
                    if (this.peek() == '=') { this.advance(); return TokenType::GreaterGreaterEqual; }
                    return TokenType::GreaterGreater;
                }
                return TokenType::RAngle;
            }

            '&' => {
                if (this.peek() == '&') { this.advance(); return TokenType::AmpAmp;   }
                if (this.peek() == '=') { this.advance(); return TokenType::AmpEqual; }
                return TokenType::Amp;
            }

            '|' => {
                if (this.peek() == '|') { this.advance(); return TokenType::PipePipe;     }
                if (this.peek() == '=') { this.advance(); return TokenType::PipeEqual;    }
                if (this.peek() == '>') { this.advance(); return TokenType::PipeGreater;  }
                return TokenType::Pipe;
            }

            '?' => {
                if (this.peek() == '?') { this.advance(); return TokenType::QuestionQuestion; }
                if (this.peek() == '.') { this.advance(); return TokenType::QuestionDot;      }
                return TokenType::Question;
            }

            ':' => {
                if (this.peek() == ':') { this.advance(); return TokenType::ColonColon; }
                return TokenType::Colon;
            }

            _ => { return TokenType::Unknown; }
        }
    }

    skip_whitespace(&this) -> void {
        while(!this.at_end() && Lexer::is_whitespace(this.peek())) {
            const c: char = this.peek();
            if (c == '\n') {
                this.current++;
                this.current_location.newline();
            } else {
                this.advance();
            }
        }
    }

    advance(&this) -> char {
        if (this.at_end()) {
            return '\0';
        }

        mut c: char = *this.current as char;
        this.current++;

        this.current_location.increment_char(c);

        return c;
    }

    peek(&this) -> char {
        const offset: int = 0;
        if (this.current + offset >= this.buffer_end) {
            return '\0';
        }
        return *(this.current + offset) as char;
    }

    peek_ahead(&this, offset: int) -> char {
        if (this.current + offset >= this.buffer_end) {
            return '\0';
        }
        return *(this.current + offset) as char;
    }

    at_end(&this) -> boolean {
        return this.current >= this.buffer_end;
    }

    make_token(&this, kind: TokenType, lexeme: string) -> Token {
        return Token::new(
            kind,
            lexeme,
            this.current_location.line,
            (this.current_location.column - lexeme.length()) as i32
        );
    }

    /// Emit a diagnostic and return an Unknown token.
    /// The error is recorded in the DiagnosticSink immediately so downstream
    /// passes never need to inspect Unknown token lexemes.
    emit_error(&this, code: ErrorCode, message: string) -> Token {
        if (this.sink != null) {
            const span: SourceSpan = SourceSpan::new(
                this.path,
                this.current_location.line as u32,
                this.current_location.column as u32,
                this.current_location.line as u32,
                this.current_location.column as u32 + 1
            );
            mut diag: Diagnostic = Diagnostic::error(code, message);
            diag = diag.at(span);
            this.sink.emit(diag);
        }
        return Token::new(
            TokenType::Unknown,
            message,
            this.current_location.line,
            this.current_location.column
        );
    }

    /// Like `emit_error`, but attaches a machine-applicable suggestion
    /// that inserts `insertion` at the literal's start-of-body position.
    /// Used by the unterminated-string / unterminated-char paths so the
    /// user's editor can close the literal in one click.  `body_line` /
    /// `body_col` point at the byte AFTER the opening quote (where the
    /// missing closer logically belongs); the suggestion uses a
    /// zero-width span at the current end-of-stream position so the
    /// insertion lands at the cursor, exactly where the user dropped
    /// the closing quote.
    emit_error_close_literal(&this, code: ErrorCode, message: string,
                              insertion: string) -> Token {
        if (this.sink != null) {
            const span: SourceSpan = SourceSpan::new(
                this.path,
                this.current_location.line as u32,
                this.current_location.column as u32,
                this.current_location.line as u32,
                this.current_location.column as u32 + 1
            );
            mut diag: Diagnostic = Diagnostic::error(code, message);
            diag = diag.at(span);
            const ins_span: SourceSpan = SourceSpan::new(
                this.path,
                this.current_location.line as u32,
                this.current_location.column as u32,
                this.current_location.line as u32,
                this.current_location.column as u32
            );
            diag = diag.suggest(Suggestion::machine_applicable(
                ins_span, insertion,
                format("close the literal with `%s`", insertion)));
            this.sink.emit(diag);
        }
        return Token::new(
            TokenType::Unknown,
            message,
            this.current_location.line,
            this.current_location.column
        );
    }

    /// Report a multi-character character literal (`'AB'`).  Unlike the
    /// unterminated case this attaches NO insert-quote autofix (that would
    /// produce `'A'B'`); instead it points the user at a string literal.
    emit_error_multi_char_literal(&this) -> Token {
        const msg: string = "character literal may only contain one codepoint";
        if (this.sink != null) {
            const span: SourceSpan = SourceSpan::new(
                this.path,
                this.current_location.line as u32,
                this.current_location.column as u32,
                this.current_location.line as u32,
                this.current_location.column as u32 + 1
            );
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0003_UNTERMINATED_CHAR, msg);
            diag = diag.at(span);
            diag = diag.with_note(
                "a `'...'` literal holds a single character; use double quotes for a string");
            this.sink.emit(diag);
        }
        return Token::new(
            TokenType::Unknown,
            msg,
            this.current_location.line,
            this.current_location.column
        );
    }

private:
    static is_alpha(c: char) -> boolean {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
    }

    static is_digit(c: char) -> boolean {
        return c >= '0' && c <= '9';
    }

    static is_alnum(c: char) -> boolean {
        return Lexer::is_alpha(c) || Lexer::is_digit(c);
    }

    static is_hex_digit(c: char) -> boolean {
        return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
    }

    static is_whitespace(c: char) -> boolean {
        return c == ' ' || c == '\t' || c == '\n' || c == '\r';
    }

    /// True if `s` is one of the accepted numeric-literal type suffixes
    /// (e.g. `42u32`, `1.5f64`, `0xffi8`). Kept as a single source of truth
    /// so adding a new primitive width touches one list instead of several.
    static is_valid_numeric_suffix(s: string) -> boolean {
        const table: string[] = [
            "i8", "i16", "i32", "i64", "i128",
            "u8", "u16", "u32", "u64", "u128",
            "f32", "f64",
            "isize", "usize"
        ];
        for (mut i: i64 = 0; i < table.length; i++) {
            if (s == table[i]) { return true; }
        }
        return false;
    }

    /// True if `s` is a floating-point type suffix (`f32`/`f64`). Used to
    /// reject an integer suffix on a float literal (`1.5u8`).
    static is_float_suffix(s: string) -> boolean {
        return s == "f32" || s == "f64";
    }

    /// Processes escape sequences in a string literal, converting backslash
    /// sequences (e.g. \n, \t, \\) into their actual character values.
    static process_escape_sequences(raw: string) -> string {
        const len: i64 = raw.length() as i64;
        if (len == 0) {
            return raw;
        }

        // Build into an owned String; escapes only shrink, so with_capacity
        // reserves enough that no reallocation occurs.
        mut buf: String = String::with_capacity((len + 1) as u64);
        mut ri: i64 = 0;  // read index

        while (ri < len) {
            const c: char = *(raw + ri) as char;

            if (c != '\\' || ri + 1 >= len) {
                buf.push_byte(c as u8);
                ri += 1;
                continue;
            }

            // We have a backslash; look at the next character
            const esc: char = *(raw + ri + 1) as char;
            ri += 2; // consume both backslash and escape char

            match (esc) {
                'n'  => { buf.push_byte('\n' as u8); }
                't'  => { buf.push_byte('\t' as u8); }
                'r'  => { buf.push_byte('\r' as u8); }
                '\\' => { buf.push_byte('\\' as u8); }
                '\'' => { buf.push_byte('\'' as u8); }
                '"'  => { buf.push_byte('"' as u8); }
                '0'  => { buf.push_byte('\0' as u8); }
                'x'  => {
                    // Hex escape: \xHH (exactly up to 2 hex digits).  A
                    // `\x` with no following hex digit is malformed; emit
                    // it literally rather than silently materialising a NUL
                    // byte (the old behaviour wrote `val == 0`, truncating
                    // the bogus escape to `\0` and corrupting the string).
                    mut val: i64 = 0;
                    mut digits: int = 0;
                    while (digits < 2 && ri < len && Lexer::is_hex_digit(*(raw + ri))) {
                        const d: char = *(raw + ri) as char;
                        mut dv: i64 = 0;
                        if (d >= '0' && d <= '9')      { dv = d as i64 - '0' as i64; }
                        else if (d >= 'a' && d <= 'f') { dv = d as i64 - 'a' as i64 + 10; }
                        else if (d >= 'A' && d <= 'F') { dv = d as i64 - 'A' as i64 + 10; }
                        val = val * 16 + dv;
                        ri += 1;
                        digits += 1;
                    }
                    if (digits == 0) {
                        buf.push_byte('\\' as u8);
                        buf.push_byte('x' as u8);
                    } else {
                        buf.push_byte(val as u8);
                    }
                }
                'u'  => {
                    // Unicode escape: \u{HEX} - parse the brace-delimited
                    // codepoint and emit its UTF-8 encoding.  Malformed
                    // forms (missing `{`, no digits, codepoint out of the
                    // Unicode range) are preserved literally so a downstream
                    // pass reports them rather than this silently dropping
                    // bytes.
                    if (ri < len && *(raw + ri) as char == '{') {
                        ri += 1; // consume '{'
                        mut cp: i64 = 0;
                        mut ndig: int = 0;
                        while (ri < len && Lexer::is_hex_digit(*(raw + ri))) {
                            const d: char = *(raw + ri) as char;
                            mut dv: i64 = 0;
                            if (d >= '0' && d <= '9')      { dv = d as i64 - '0' as i64; }
                            else if (d >= 'a' && d <= 'f') { dv = d as i64 - 'a' as i64 + 10; }
                            else if (d >= 'A' && d <= 'F') { dv = d as i64 - 'A' as i64 + 10; }
                            cp = cp * 16 + dv;
                            ri += 1;
                            ndig += 1;
                        }
                        const closed: boolean = ri < len && *(raw + ri) as char == '}';
                        if (closed) { ri += 1; } // consume '}'
                        if (ndig > 0 && closed && cp <= 0x10FFFF) {
                            Lexer::encode_utf8(&buf, cp);
                        } else {
                            // Malformed: preserve the `\u` we consumed; the
                            // brace/digit bytes were already copied past or
                            // will be re-scanned as ordinary characters.
                            buf.push_byte('\\' as u8);
                            buf.push_byte('u' as u8);
                        }
                    } else {
                        buf.push_byte('\\' as u8);
                        buf.push_byte('u' as u8);
                    }
                }
                _ => {
                    // Unknown escape; preserve both characters
                    buf.push_byte('\\' as u8);
                    buf.push_byte(esc as u8);
                }
            }
        }

        return buf.into_raw();
    }

    /// Encode Unicode codepoint `cp` (assumed <= 0x10FFFF) as UTF-8, appending
    /// its 1–4 bytes to `buf`.  Used by `process_escape_sequences` for `\u{HEX}`.
    static encode_utf8(buf: mut &String, cp: i64) -> void {
        if (cp <= 0x7F) {
            buf.push_byte(cp as u8);
        } else if (cp <= 0x7FF) {
            buf.push_byte((0xC0 | (cp >> 6)) as u8);
            buf.push_byte((0x80 | (cp & 0x3F)) as u8);
        } else if (cp <= 0xFFFF) {
            buf.push_byte((0xE0 | (cp >> 12)) as u8);
            buf.push_byte((0x80 | ((cp >> 6) & 0x3F)) as u8);
            buf.push_byte((0x80 | (cp & 0x3F)) as u8);
        } else {
            buf.push_byte((0xF0 | (cp >> 18)) as u8);
            buf.push_byte((0x80 | ((cp >> 12) & 0x3F)) as u8);
            buf.push_byte((0x80 | ((cp >> 6) & 0x3F)) as u8);
            buf.push_byte((0x80 | (cp & 0x3F)) as u8);
        }
    }
}

