///! Compile-time integer constant values.
///!
///! Cryo `const` declarations are emitted as runtime globals, so their values
///! are not otherwise available to the frontend.  A fixed array size
///! (`u8[CHUNK]`) has to know the value at type-resolution time - a size that
///! never resolves produces an array descriptor with no storage behind it -
///! so module-level integer constants are recorded here during name
///! declaration and folded on demand.
///!
///! Folding is DEFERRED rather than done at the declaration: an initializer
///! may name a constant or an enum that a later module declares, and the
///! declaration pass runs over every module before anything is walked.  A
///! constant folded eagerly at its own declaration could only ever see what
///! preceded it in source order.
///!
///! This lives outside `DeclIndex` on purpose: the name resolver populates the
///! table and `DeclIndex` already imports the resolver, so hanging it off the
///! declaration index would close an import cycle.
///!
///! Naming: entries are keyed by CANONICAL qualified name
///! (`std::io::traits::CHUNK`), which is what `Res::Def` carries, so a
///! qualified use is a single exact lookup and never a search.  A written
///! qualifier is NOT a key: a use site may spell a module by any whole-segment
///! suffix of its namespace, so the spelling does not identify a module and
///! matching against it is the suffix search `docs/name-resolution.md` §5.1
///! forbids.  The resolver already decided what the qualifier names, with the
///! writer's imports in hand; this reads that answer.
///!
///! A bare name is the exception, and a known one.  An `IdentifierNode` carries
///! no `Res` slot, so there is no stamp to read and `by_bare` answers from a
///! program-wide leaf map - the global-visibility mechanism §1 names as the
///! root cause. It is counted (`ConstLeafHits`, a B1 row) so the residue is
///! watched rather than invisible, and it retires when a bare identifier is
///! stamped. Two same-named constants answer only when they fold to the same
///! value, which keeps that step from silently picking one.
///!
///! `ConstEval` is the ONE folder for every position that wants a compile-time
///! integer: an array size, a `[value; N]` repeat count, and a `static_assert`
///! condition.  They differ only in which capabilities exist at their point in
///! the pipeline - an array size is fixed before any layout is computed, so
///! `sizeof` is not a constant there - and a capability is passed as a
///! pointer that may be null rather than as a separate folder.

namespace compiler::const_table;

import compiler::ast;
import compiler::ast::{ node, expression, declaration };
import compiler::resolver::{ symbol_str, intern_table };
import compiler::resolver::res;
import compiler::resolve_counter;
import compiler::types::{ type_ref, arena };
import compiler::types::type_base;
import std::core::option;
import std::collections::hashmap;
import std::fmt::float;


/// Largest magnitude representable in i64, as u64.  Folding bails above this
/// rather than wrapping into a negative size.
const CONST_I64_MAX_MAG: u64 = 9223372036854775807;

/// Fold states for one entry.  Only a SUCCESS is memoized: a fold can fail
/// for want of a capability that a later position supplies, so caching the
/// failure would make the answer depend on which position asked first.
/// `Folding` is the cycle guard - a constant whose initializer names itself,
/// directly or through another constant, is not a compile-time integer.
const CONST_PENDING: i32 = 0;
const CONST_FOLDING: i32 = 1;
const CONST_FOLDED:  i32 = 2;


/// One module-level `const`, with the initializer it is folded from.
///
/// `init` is borrowed from the AST, which outlives the table.
type struct ConstEntry {
    module_ns: SymbolStr;
    init:      ExpressionNode*;
    value:     i64;
    state:     i32;
    /// The same initializer folded as a REAL, memoized separately.
    ///
    /// Separate slots rather than one numeric slot because the two folds accept
    /// different expressions and must not answer for each other: `1 / 2` is 0
    /// as an integer and 0.5 as a real, so a value cached by one question would
    /// be a wrong answer to the other. The INDEX is shared - a constant is
    /// named the same ways whatever its type - and only the interpretation
    /// differs.
    real_value: f64;
    real_state: i32;
    /// Whether the declaration named an INTEGER primitive.
    ///
    /// The reading of an initializer is the DECLARED TYPE's to choose, not the
    /// expression's: `1 / 2` is 0 in `const H: i64` and 0.5 in `const H: f64`,
    /// so a real fold that re-interprets the initializer of an integer constant
    /// answers with a value that constant never had.  False for a real, for a
    /// non-primitive, and for an absent annotation - all of which leave the
    /// choice to the expression, which is what an unannotated constant wants.
    int_typed: boolean;
    /// Next entry sharing this leaf name, or -1.  A bare use folds every
    /// candidate on the chain and answers only when they agree.
    next_same_bare: i64;
}


type struct ConstantTable {
    entries: ConstEntry[];
    /// Qualified name id -> index into `entries`.
    by_qualified: HashMap<u32, i64>;
    /// Bare leaf name id -> index of the first entry with that leaf.
    by_bare: HashMap<u32, i64>;

    /// Module-level `type enum` declarations, so `Enum::Variant` folds to its
    /// discriminant.  Keyed ONLY by canonical qualified name: the resolver
    /// says which type a written scope names, so there is nothing here for a
    /// spelling to be matched against.
    enums: EnumDeclNode*[];
    enums_by_qualified: HashMap<u32, i64>;

    static new() -> ConstantTable {
        return ConstantTable {
            entries:            [],
            by_qualified:       HashMap<u32, i64>::new(),
            by_bare:            HashMap<u32, i64>::new(),
            enums:              [],
            enums_by_qualified: HashMap<u32, i64>::new(),
        };
    }

    /// Record `qualified` (and its bare leaf) as a constant initialized from
    /// `init`, written in module `module_ns`.
    ///
    /// Re-registering the same qualified name replaces its initializer rather
    /// than adding a second entry, which keeps repeated passes over a module
    /// idempotent and keeps a module from making its own name ambiguous
    /// against itself.
    register(mut &this, qualified: SymbolStr, bare: SymbolStr,
             module_ns: SymbolStr, init: ExpressionNode*,
             int_typed: boolean) -> void {
        match (this.by_qualified.get(&qualified.id)) {
            Option::Some(existing) => {
                this.entries[existing].module_ns  = module_ns;
                this.entries[existing].init       = init;
                this.entries[existing].value      = 0;
                this.entries[existing].state      = CONST_PENDING;
                this.entries[existing].real_value = 0.0;
                this.entries[existing].real_state = CONST_PENDING;
                this.entries[existing].int_typed  = int_typed;
                return;
            }
            Option::None => { }
        }

        // Push at the head of the leaf chain: the order candidates are folded
        // in cannot matter, since a bare name answers only when they agree.
        mut head: i64 = -1;
        match (this.by_bare.get(&bare.id)) {
            Option::Some(h) => { head = h; }
            Option::None    => { }
        }

        const idx: i64 = this.entries.length;
        this.entries.push(ConstEntry {
            module_ns:      module_ns,
            init:           init,
            value:          0,
            state:          CONST_PENDING,
            real_value:     0.0,
            real_state:     CONST_PENDING,
            int_typed:      int_typed,
            next_same_bare: head,
        });
        this.by_qualified.insert(qualified.id, idx);
        this.by_bare.insert(bare.id, idx);
    }

    /// Record a module-level enum declaration under its canonical qualified
    /// name - the key `Res::TypeRelative`'s base carries.  Re-registering the
    /// same name replaces the node.
    register_enum(mut &this, qualified: SymbolStr, node: EnumDeclNode*) -> void {
        if (node == null) { return; }
        match (this.enums_by_qualified.get(&qualified.id)) {
            Option::Some(existing) => { this.enums[existing] = node; return; }
            Option::None => { }
        }
        const idx: i64 = this.enums.length;
        this.enums.push(node);
        this.enums_by_qualified.insert(qualified.id, idx);
    }

    /// The entry a BARE name denotes, or -1.
    ///
    /// Two steps, and only the first is scoped: the use site's own module, then
    /// a program-wide leaf map.  That second step is a global leaf index - it
    /// answers from any module in the program with no import in hand, which is
    /// the mechanism `docs/name-resolution.md` §1 names as the root cause.
    ///
    /// It cannot be replaced the way the qualified path was.  A qualified path
    /// hangs off a `ScopeResolutionNode`, which carries a `Res`; a bare name is
    /// an `IdentifierNode`, which carries no slot to read.  It is counted
    /// (`ConstLeafHits`) so the residue is a number the B1 gate watches rather
    /// than an invisible one, and it retires when a bare identifier is stamped.
    bare_index_of(&this, name: SymbolStr, module_ns: SymbolStr,
                  intern: InternTable*) -> i64 {
        if (intern != null && module_ns.is_valid()) {
            const qualified: SymbolStr =
                ConstantTable::intern_qualified(intern, module_ns, name);
            if (qualified.is_valid()) {
                match (this.by_qualified.get(&qualified.id)) {
                    Option::Some(i) => { return i; }
                    Option::None    => { }
                }
            }
        }

        // A module with no namespace registers its constants under the bare
        // name itself, so this is that module's own scope, not a search.
        match (this.by_qualified.get(&name.id)) {
            Option::Some(i) => { return i; }
            Option::None    => { }
        }

        resolve_counter::Site::ConstLeafCalls.bump();
        return match (this.by_bare.get(&name.id)) {
            Option::Some(i) => {
                resolve_counter::Site::ConstLeafHits.bump();
                // Which constant, and which module asked without an import in
                // hand: the tally alone cannot say whether the residue is one
                // stubborn name or a spread, and those need different fixes.
                if (intern != null) {
                    resolve_counter::path_hit(
                        "CONST-BARE-LEAF", intern.resolve(module_ns),
                        intern.resolve(name), "");
                }
                i
            }
            Option::None => { -1 }
        };
    }

    /// Whether `ann` names an integer primitive, which is what decides how the
    /// declaration's initializer is READ.
    ///
    /// `char` counts: whatever its width settles at, it is not a real, and the
    /// question here is only which of the two folds may interpret the
    /// initializer.  Anything that is not a primitive - a type name, an alias,
    /// an absent annotation - answers false and leaves the choice to the
    /// expression's own shape.
    static declares_integer(ann: TypeAnnotation*, intern: InternTable*) -> boolean {
        if (ann == null || intern == null) { return false; }
        return match (*ann) {
            TypeAnnotation::Primitive(p) => {
                const n: string = intern.resolve(p.name);
                return n == "i8"  || n == "i16" || n == "i32"  || n == "i64"
                    || n == "i128"|| n == "u8"  || n == "u16"  || n == "u32"
                    || n == "u64" || n == "u128"|| n == "int"  || n == "isize"
                    || n == "usize" || n == "char" || n == "boolean";
            }
            _ => { false }
        };
    }

    /// Intern `<ns>::<leaf>`.
    static intern_qualified(intern: InternTable*, ns: SymbolStr,
                            leaf: SymbolStr) -> SymbolStr {
        if (intern == null) { return SymbolStr::empty(); }
        const joined: string = format("%s::%s", intern.resolve(ns), intern.resolve(leaf));
        return intern.intern(joined);
    }

    /// Decode an integer literal lexeme, honouring `0x`/`0o`/`0b` prefixes and
    /// `_` separators.  False on overflow past u64 or on a stray character.
    static parse_int_literal(text: string, out: u64*) -> boolean {
        if (text == null) { return false; }
        mut i: i64 = 0;
        mut base: u64 = 10;
        if (text[0] == '0' && text[1] != 0) {
            const c: char = text[1];
            if (c == 'x' || c == 'X') { base = 16; i = 2; }
            else if (c == 'o' || c == 'O') { base = 8;  i = 2; }
            else if (c == 'b' || c == 'B') { base = 2;  i = 2; }
        }

        mut acc: u64 = 0;
        mut saw_digit: boolean = false;
        while (text[i] != 0) {
            const c: char = text[i];
            i = i + 1;
            if (c == '_') { continue; }
            mut d: u64 = 0;
            if (c >= '0' && c <= '9')      { d = (c - '0') as u64; }
            else if (c >= 'a' && c <= 'f') { d = ((c - 'a') as u64) + 10; }
            else if (c >= 'A' && c <= 'F') { d = ((c - 'A') as u64) + 10; }
            else { return false; }         // type suffix or stray character
            if (d >= base) { return false; }
            // Overflow check before the multiply-add.
            const limit: u64 = 18446744073709551615;
            if (acc > (limit - d) / base) { return false; }
            acc = acc * base + d;
            saw_digit = true;
        }
        if (!saw_digit) { return false; }
        *out = acc;
        return true;
    }
}


/// Everything a compile-time integer fold is allowed to consult.
///
/// A null capability is a NARROWER ENVIRONMENT, not a different rule.  Sema
/// selects an integer literal's width before any name is bound, so it folds
/// with no table and an identifier is simply not a constant there; an array
/// size is fixed before TypeLowering computes a single layout, so `sizeof` is
/// not a constant there either.  The positions that share this folder must
/// share its answers wherever they share its capabilities - that is the
/// property that keeps `T[N]` and `[v; N]` agreeing about `N`.
type struct ConstEval {
    table:  ConstantTable*;
    intern: InternTable*;
    /// Layouts, for `sizeof`/`alignof`.  Null until TypeLowering has run.
    arena:  TypeArena*;
    /// The module the expression being folded was WRITTEN in, which is what a
    /// bare name is resolved against.
    module_ns: SymbolStr;

    static new(table: ConstantTable*, intern: InternTable*, arena: TypeArena*,
               module_ns: SymbolStr) -> ConstEval {
        return ConstEval {
            table: table, intern: intern, arena: arena, module_ns: module_ns,
        };
    }

    /// A folder with no name binding and no layouts: literal arithmetic only.
    static literals_only() -> ConstEval {
        return ConstEval {
            table: null, intern: null, arena: null,
            module_ns: SymbolStr::empty(),
        };
    }

    /// The same capabilities, reading names as another module wrote them.
    in_module(&this, module_ns: SymbolStr) -> ConstEval {
        return ConstEval {
            table: this.table, intern: this.intern, arena: this.arena,
            module_ns: module_ns,
        };
    }

    /// Fold a compile-time integer expression to its `i64` value.
    ///
    /// Returns false for anything non-constant, for any step that would
    /// overflow i64 or divide by a constant zero, and for a name this
    /// environment cannot bind.  Bailing is always safe: callers either leave
    /// a width unchanged or report the position as non-constant.
    ///
    /// Booleans fold as 0/1 so a comparison composes with arithmetic; a caller
    /// that wants a count rejects a negative result itself.
    fold(&this, expr: ExpressionNode*, out: i64*) -> boolean {
        if (expr == null) { return false; }
        const node: ASTNode* = expr as ASTNode*;

        if (node.kind == NodeKind::Literal) {
            const lit: LiteralNode* = expr as LiteralNode*;
            if (lit.literal_kind == LiteralKind::Boolean) {
                *out = if (lit.value == "true") { 1 } else { 0 };
                return true;
            }
            if (lit.literal_kind != LiteralKind::Integer) { return false; }
            // `value` is the whole lexeme, suffix included; the lexer already
            // found the boundary, so strip rather than re-derive it - a digit
            // scan cannot tell `0x1f64` (no suffix) from `0x1u8`.
            mut text: string = lit.value;
            const slen: i64 = lit.suffix.length() as i64;
            if (slen > 0) {
                const vlen: i64 = lit.value.length() as i64;
                if (vlen <= slen) { return false; }
                text = lit.value.substr(0, (vlen - slen) as u64);
            }
            mut v: u64 = 0;
            if (!ConstantTable::parse_int_literal(text, &v)) { return false; }
            if (v > CONST_I64_MAX_MAG) { return false; }
            *out = v as i64;
            return true;
        }

        if (node.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = expr as IdentifierNode*;
            return this.fold_named(id.name, out);
        }

        if (node.kind == NodeKind::ScopeResolution) {
            const sr: ScopeResolutionNode* = expr as ScopeResolutionNode*;
            return this.fold_scoped(sr, out);
        }

        if (node.kind == NodeKind::CastExpression) {
            const c: CastExprNode* = expr as CastExprNode*;
            mut v: i64 = 0;
            if (!this.fold(c.expression, &v)) { return false; }
            return ConstEval::wrap_to_primitive(
                this.primitive_name_of(c.target_annotation), v, out);
        }

        if (node.kind == NodeKind::SizeofExpression) {
            const s: SizeofExprNode* = expr as SizeofExprNode*;
            // `operand_type`, never `resolved_type`: the latter is the type of
            // the `sizeof` EXPRESSION (`u64`), so reading it here measures the
            // count instead of the thing being counted.
            if (this.arena == null || !s.operand_type.is_valid()) { return false; }
            const t: Type* = this.arena.lookup(s.operand_type.id);
            if (t == null) { return false; }
            *out = t.size_bytes() as i64;
            return true;
        }

        if (node.kind == NodeKind::AlignofExpression) {
            const a: AlignofExprNode* = expr as AlignofExprNode*;
            if (this.arena == null || !a.operand_type.is_valid()) { return false; }
            const t: Type* = this.arena.lookup(a.operand_type.id);
            if (t == null) { return false; }
            *out = t.alignment() as i64;
            return true;
        }

        if (node.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = expr as UnaryExprNode*;
            mut a: i64 = 0;
            if (!this.fold(u.operand, &a)) { return false; }
            if (u.op.lexeme == "-") { *out = 0 - a; return true; }
            if (u.op.lexeme == "+") { *out = a;     return true; }
            if (u.op.lexeme == "~") { *out = ~a;    return true; }
            if (u.op.lexeme == "!") { *out = if (a == 0) { 1 } else { 0 }; return true; }
            return false;
        }

        if (node.kind == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = expr as BinaryExprNode*;
            mut x: i64 = 0;
            mut y: i64 = 0;
            if (!this.fold(b.left,  &x)) { return false; }
            if (!this.fold(b.right, &y)) { return false; }
            return ConstEval::apply_binary(b.op.lexeme, x, y, out);
        }

        return false;
    }

    /// Fold a compile-time REAL expression to its `f64` value.
    ///
    /// The same environment and the same index as `fold`, interpreting the
    /// expression as a real instead of an integer.  It exists because a real
    /// initializer reaches exactly the same dead end an integer one did: an
    /// unfolded module-level initializer is not diagnosed, it is emitted as
    /// zero, so a folder that cannot read a name publishes 0.0 for
    /// `const D: f64 = A * B;`.
    ///
    /// An INTEGER-valued subexpression folds here too, promoted - that is what
    /// makes `2.0 * 3` and `RADIUS * COUNT` mean what they read as. The integer
    /// folder is asked for those rather than duplicated, so a shape either
    /// folder accepts has one implementation and cannot drift.
    ///
    /// Division needs no signedness detour as it does in the integer folder:
    /// `/` is exact-in-kind for reals, and it is the operator a derived real
    /// constant is most often written with.
    fold_real(&this, expr: ExpressionNode*, out: f64*) -> boolean {
        if (expr == null) { return false; }
        const node: ASTNode* = expr as ASTNode*;

        if (node.kind == NodeKind::Literal) {
            const lit: LiteralNode* = expr as LiteralNode*;
            if (lit.literal_kind == LiteralKind::Float) {
                // The lexeme carries any type suffix; the lexer already found
                // the boundary, so strip it rather than re-deriving it.
                mut text: string = lit.value;
                const slen: i64 = lit.suffix.length() as i64;
                if (slen > 0) {
                    const vlen: i64 = lit.value.length() as i64;
                    if (vlen <= slen) { return false; }
                    text = lit.value.substr(0, (vlen - slen) as u64);
                }
                match (float::parse_f64(text)) {
                    Option::Some(v) => { *out = v; return true; }
                    Option::None    => { return false; }
                }
            }
            // A non-float literal is an integer-valued constant; fall through.
        }

        if (node.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = expr as IdentifierNode*;
            if (this.fold_named_real(id.name, out)) { return true; }
            // Not a real constant - it may still be an integer one.
        }

        if (node.kind == NodeKind::ScopeResolution) {
            // Terminal, unlike the bare-name case above: the qualifier's own
            // answer says which kind of thing the member is, so one dispatch
            // settles both the real and the integer reading and there is no
            // second question left for the promotion below to ask.
            const sr: ScopeResolutionNode* = expr as ScopeResolutionNode*;
            return this.fold_scoped_real(sr, out);
        }

        if (node.kind == NodeKind::CastExpression) {
            const c: CastExprNode* = expr as CastExprNode*;
            // The cast's own width is applied by the emitter against the
            // global's type, so the operand folds once and converts once.
            return this.fold_real(c.expression, out);
        }

        if (node.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = expr as UnaryExprNode*;
            mut a: f64 = 0.0;
            if (!this.fold_real(u.operand, &a)) { return false; }
            if (u.op.lexeme == "-") { *out = 0.0 - a; return true; }
            if (u.op.lexeme == "+") { *out = a;       return true; }
            return false;
        }

        if (node.kind == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = expr as BinaryExprNode*;
            mut x: f64 = 0.0;
            mut y: f64 = 0.0;
            if (!this.fold_real(b.left,  &x)) { return false; }
            if (!this.fold_real(b.right, &y)) { return false; }
            const op: string = b.op.lexeme;
            if (op == "+") { *out = x + y; return true; }
            if (op == "-") { *out = x - y; return true; }
            if (op == "*") { *out = x * y; return true; }
            // Division by zero is NOT refused: IEEE gives it an answer, and it
            // is the same answer the emitted code would compute, so declining
            // would replace an infinity with the zero the fallback publishes.
            if (op == "/") { *out = x / y; return true; }
            return false;
        }

        // Anything else this environment can evaluate is integer-valued
        // (a named integer constant, an enum variant, `sizeof`), promoted.
        mut iv: i64 = 0;
        if (this.fold(expr, &iv)) { *out = iv as f64; return true; }
        return false;
    }

    /// Fold a bare name: a constant of that leaf, wherever it was declared.
    fold_named(&this, name: SymbolStr, out: i64*) -> boolean {
        if (this.table == null) { return false; }
        const idx: i64 = this.table.bare_index_of(name, this.module_ns, this.intern);
        if (idx < 0) { return false; }
        return this.fold_chain(idx, out);
    }

    /// Fold `scope::member`, from what the RESOLVER said the scope names.
    ///
    /// The written qualifier is not consulted.  A use site may spell a module
    /// by any whole-segment suffix of its namespace, so the spelling does not
    /// identify a module and matching against it is the suffix search
    /// `docs/name-resolution.md` §5.1 forbids.  `scope_res` already carries the
    /// canonical answer, decided once by the pass that had the writer's imports
    /// in hand, and this reads it.
    ///
    /// Two answers are meaningful here and they are different questions:
    /// `Def` means the scope named a MODULE, so the member is a constant of
    /// that module; `TypeRelative` means it named a TYPE, so the member is an
    /// enum variant of it.  Anything else is not a compile-time integer.
    fold_scoped(&this, sr: ScopeResolutionNode*, out: i64*) -> boolean {
        if (this.table == null || this.intern == null) { return false; }
        return this.fold_scoped_res(
            sr.scope_res.require("ConstEval::fold_scoped"), sr.member_name, out);
    }

    /// `fold_scoped`, from an answer already read off the node.
    ///
    /// Split from the read so that a real fold can dispatch on the SAME answer
    /// without requiring the slot a second time: `require` records a pending
    /// bug for an unstamped node, so asking twice would count one unstamped
    /// path as two.
    fold_scoped_res(&this, r: Res, member: SymbolStr, out: i64*) -> boolean {
        if (this.table == null || this.intern == null) { return false; }

        return match (r) {
            Res::Def(ns) => {
                const key: SymbolStr = ConstantTable::intern_qualified(
                    this.intern, ns.qualified_name(), member);
                if (!key.is_valid()) { return false; }
                return match (this.table.by_qualified.get(&key.id)) {
                    Option::Some(i) => { this.fold_entry(i, out) }
                    Option::None    => { false }
                };
            }
            Res::TypeRelative(base, trailing) => {
                // `Enum::Variant` is one trailing segment past the type.  A
                // longer tail is an associated item, which is sema's.
                if (trailing != 1) { return false; }
                return match (base) {
                    ResBase::Def(q) => {
                        const qn: SymbolStr = q.qualified_name();
                        return match (this.table.enums_by_qualified.get(&qn.id)) {
                            Option::Some(ei) => {
                                ConstEval::variant_tag_of(
                                    this.table.enums[ei], member, out)
                            }
                            Option::None => { false }
                        };
                    }
                    _ => { false }
                };
            }
            _ => { false }
        };
    }

    /// The discriminant `decl` gives `member`, or false when it has no such
    /// variant.  A variant carrying a payload is a constructor, not a value,
    /// so it is not a compile-time integer.
    static variant_tag_of(decl: EnumDeclNode*, member: SymbolStr,
                          out: i64*) -> boolean {
        if (decl == null) { return false; }
        const tags: i64[] = decl.variant_tags();
        for (mut i: i64 = 0; i < decl.variants.length; i++) {
            const v: EnumVariantNode* = decl.variants[i];
            if (v == null) { continue; }
            if (v.name.id != member.id) { continue; }
            if (v.associated_types.length > 0) { return false; }
            *out = tags[i];
            return true;
        }
        return false;
    }

    /// Fold every constant sharing one leaf name and answer only if they
    /// agree.  A candidate whose initializer is not a compile-time integer is
    /// skipped rather than poisoning the name: it could never have answered.
    fold_chain(&this, head: i64, out: i64*) -> boolean {
        mut answered: boolean = false;
        mut answer: i64 = 0;
        mut i: i64 = head;
        while (i >= 0) {
            mut v: i64 = 0;
            if (this.fold_entry(i, &v)) {
                if (answered && v != answer) { return false; }
                answered = true;
                answer   = v;
            }
            i = this.table.entries[i].next_same_bare;
        }
        if (!answered) { return false; }
        *out = answer;
        return true;
    }

    /// Fold one entry's initializer, in the module that WROTE it, and memoize
    /// the value.
    ///
    /// Only success is memoized - a fold that failed for want of a capability
    /// must be able to succeed at a position that has one.  `Folding` is the
    /// cycle guard: a constant reached from its own initializer is not a
    /// compile-time integer, and without the guard the recursion has no floor.
    fold_entry(&this, idx: i64, out: i64*) -> boolean {
        if (this.table == null) { return false; }
        if (idx < 0 || idx >= this.table.entries.length) { return false; }

        const state: i32 = this.table.entries[idx].state;
        if (state == CONST_FOLDED)  { *out = this.table.entries[idx].value; return true; }
        if (state == CONST_FOLDING) { return false; }

        const init: ExpressionNode* = this.table.entries[idx].init;
        if (init == null) { return false; }

        this.table.entries[idx].state = CONST_FOLDING;
        mut v: i64 = 0;
        const inner: ConstEval = this.in_module(this.table.entries[idx].module_ns);
        const ok: boolean = inner.fold(init, &v);
        if (!ok) {
            this.table.entries[idx].state = CONST_PENDING;
            return false;
        }
        this.table.entries[idx].value = v;
        this.table.entries[idx].state = CONST_FOLDED;
        *out = v;
        return true;
    }

    /// `fold_named`, as a real.
    fold_named_real(&this, name: SymbolStr, out: f64*) -> boolean {
        if (this.table == null) { return false; }
        const idx: i64 = this.table.bare_index_of(name, this.module_ns, this.intern);
        if (idx < 0) { return false; }
        return this.fold_chain_real(idx, out);
    }

    /// `fold_scoped`, as a real.
    ///
    /// A module's constant is folded as a real in its own right, because that
    /// is the only reading under which a float initializer is a value at all:
    /// asking the integer folder for `Scalar::PI` and promoting its answer
    /// fails at the float literal inside, and a global initializer that fails
    /// to fold is not diagnosed - it is emitted as zero.
    ///
    /// Everything else a scope can name is integer-valued - an enum variant's
    /// discriminant - so it is decoded once by the integer arm and promoted,
    /// rather than given a second decoder here that could disagree with it.
    fold_scoped_real(&this, sr: ScopeResolutionNode*, out: f64*) -> boolean {
        if (this.table == null || this.intern == null) { return false; }

        const r: Res = sr.scope_res.require("ConstEval::fold_scoped_real");
        return match (r) {
            Res::Def(ns) => {
                const key: SymbolStr = ConstantTable::intern_qualified(
                    this.intern, ns.qualified_name(), sr.member_name);
                if (!key.is_valid()) { return false; }
                return match (this.table.by_qualified.get(&key.id)) {
                    Option::Some(i) => { this.fold_entry_real(i, out) }
                    Option::None    => { false }
                };
            }
            _ => {
                mut iv: i64 = 0;
                if (!this.fold_scoped_res(r, sr.member_name, &iv)) { return false; }
                *out = iv as f64;
                return true;
            }
        };
    }

    /// `fold_chain`, as a real: every candidate sharing the leaf must agree.
    fold_chain_real(&this, head: i64, out: f64*) -> boolean {
        mut answered: boolean = false;
        mut answer: f64 = 0.0;
        mut i: i64 = head;
        while (i >= 0) {
            mut v: f64 = 0.0;
            if (this.fold_entry_real(i, &v)) {
                if (answered && v != answer) { return false; }
                answered = true;
                answer   = v;
            }
            i = this.table.entries[i].next_same_bare;
        }
        if (!answered) { return false; }
        *out = answer;
        return true;
    }

    /// `fold_entry`, as a real, memoized in the entry's own real slots and
    /// guarded against cycles the same way.
    fold_entry_real(&this, idx: i64, out: f64*) -> boolean {
        if (this.table == null) { return false; }
        if (idx < 0 || idx >= this.table.entries.length) { return false; }

        const state: i32 = this.table.entries[idx].real_state;
        if (state == CONST_FOLDED)  { *out = this.table.entries[idx].real_value; return true; }
        if (state == CONST_FOLDING) { return false; }

        const init: ExpressionNode* = this.table.entries[idx].init;
        if (init == null) { return false; }

        this.table.entries[idx].real_state = CONST_FOLDING;
        mut v: f64 = 0.0;
        const inner: ConstEval = this.in_module(this.table.entries[idx].module_ns);
        // An integer-typed constant is folded as an INTEGER and promoted, never
        // re-read as a real.  Its value is what its own declaration produced -
        // `const H: i64 = 1 / 2;` is 0 - and a real reading of the same
        // initializer answers 0.5, a number that constant never held at any
        // position.  The declared type is the only thing that can settle this;
        // the initializer looks identical either way.
        mut ok: boolean = false;
        if (this.table.entries[idx].int_typed) {
            mut iv: i64 = 0;
            ok = inner.fold(init, &iv);
            if (ok) { v = iv as f64; }
        } else {
            ok = inner.fold_real(init, &v);
        }
        if (!ok) {
            this.table.entries[idx].real_state = CONST_PENDING;
            return false;
        }
        this.table.entries[idx].real_value = v;
        this.table.entries[idx].real_state = CONST_FOLDED;
        *out = v;
        return true;
    }

    /// The primitive name a cast targets, or "" when the target is anything
    /// else.  Only a primitive target has a width known without resolving a
    /// name, and a cast to a user type is not an integer anyway.
    primitive_name_of(&this, ann: TypeAnnotation*) -> string {
        if (ann == null || this.intern == null) { return ""; }
        return match (*ann) {
            TypeAnnotation::Primitive(p) => { this.intern.resolve(p.name) }
            _ => { "" }
        };
    }

    /// Wrap `v` to the width and signedness of the primitive `prim`, the way
    /// the emitted cast will, so `Slot::B as u8` folds to what the program
    /// observes rather than to the unwrapped operand.
    ///
    /// False for anything an `i64` cannot carry: a float, a 128-bit width, and
    /// a negative value cast to a 64-bit unsigned type.  `char` is excluded
    /// because its width is not settled.
    static wrap_to_primitive(prim: string, v: i64, out: i64*) -> boolean {
        if (prim == "boolean") { *out = if (v != 0) { 1 } else { 0 }; return true; }

        mut bits: i64 = 0;
        mut is_signed: boolean = true;
        if (prim == "i8")   { bits = 8;  is_signed = true; }
        else if (prim == "i16")   { bits = 16; is_signed = true; }
        else if (prim == "i32" || prim == "int") { bits = 32; is_signed = true; }
        else if (prim == "i64" || prim == "isize") { bits = 64; is_signed = true; }
        else if (prim == "u8")    { bits = 8;  is_signed = false; }
        else if (prim == "u16")   { bits = 16; is_signed = false; }
        else if (prim == "u32" || prim == "uint") { bits = 32; is_signed = false; }
        else if (prim == "u64" || prim == "usize") { bits = 64; is_signed = false; }
        if (bits == 0) { return false; }

        if (bits == 64) {
            if (!is_signed && v < 0) { return false; }
            *out = v;
            return true;
        }

        const mask: i64 = (1 << bits) - 1;
        const low: i64 = v & mask;
        if (is_signed) {
            const sign_bit: i64 = 1 << (bits - 1);
            if ((low & sign_bit) != 0) { *out = low - (mask + 1); } else { *out = low; }
        } else {
            *out = low;
        }
        return true;
    }

    /// Evaluate `x <op> y` with overflow and divide-by-zero guarded; false
    /// means the result is not representable and the fold must bail.
    static apply_binary(op: string, x: i64, y: i64, out: i64*) -> boolean {
        const I64MAX: i64 = CONST_I64_MAX_MAG as i64;
        const I64MIN: i64 = (0 - I64MAX) - 1;

        if (op == "+") {
            if (y > 0 && x > I64MAX - y) { return false; }
            if (y < 0 && x < I64MIN - y) { return false; }
            *out = x + y; return true;
        }
        if (op == "-") {
            if (y < 0 && x > I64MAX + y) { return false; }
            if (y > 0 && x < I64MIN + y) { return false; }
            *out = x - y; return true;
        }
        if (op == "*") {
            if (x == 0 || y == 0) { *out = 0; return true; }
            // I64MIN has no positive counterpart; the re-division check below
            // would itself trap on it.
            if (x == I64MIN || y == I64MIN) { return false; }
            const p: i64 = x * y;
            if (p / y != x) { return false; }
            *out = p; return true;
        }
        if (op == "/" || op == "%") {
            if (y == 0) { return false; }
            if (x == I64MIN && y == 0 - 1) { return false; }
            if (op == "/") { *out = x / y; } else { *out = x % y; }
            return true;
        }
        if (op == "<<") {
            if (y < 0 || y >= 64) { return false; }
            const s: i64 = x << y;
            if ((s >> y) != x) { return false; }
            *out = s; return true;
        }
        if (op == ">>") {
            if (y < 0 || y >= 64) { return false; }
            *out = x >> y; return true;
        }
        if (op == "&") { *out = x & y; return true; }
        if (op == "|") { *out = x | y; return true; }
        if (op == "^") { *out = x ^ y; return true; }

        if (op == "==") { *out = if (x == y) { 1 } else { 0 }; return true; }
        if (op == "!=") { *out = if (x != y) { 1 } else { 0 }; return true; }
        if (op == "<")  { *out = if (x <  y) { 1 } else { 0 }; return true; }
        if (op == "<=") { *out = if (x <= y) { 1 } else { 0 }; return true; }
        if (op == ">")  { *out = if (x >  y) { 1 } else { 0 }; return true; }
        if (op == ">=") { *out = if (x >= y) { 1 } else { 0 }; return true; }
        if (op == "&&") { *out = if (x != 0 && y != 0) { 1 } else { 0 }; return true; }
        if (op == "||") { *out = if (x != 0 || y != 0) { 1 } else { 0 }; return true; }
        return false;
    }
}
