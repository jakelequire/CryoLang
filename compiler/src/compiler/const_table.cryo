///! Compile-time integer constant values.
///!
///! Cryo `const` declarations are emitted as runtime globals, so their values
///! are not otherwise available to the frontend.  A fixed array size
///! (`[u8; CHUNK]`) has to know the value at type-resolution time - a size that
///! never resolves produces an array descriptor with no storage behind it -
///! so module-level integer constants are recorded here during name
///! declaration and folded on demand.
///!
///! Folding is DEFERRED rather than done at the declaration: an initializer
///! may name a constant or an enum that a later module declares, and the
///! declaration pass runs over every module before anything is walked.  A
///! constant folded eagerly at its own declaration could only ever see what
///! preceded it in source order.
///!
///! This lives outside `DeclIndex` on purpose: the name resolver populates the
///! table and `DeclIndex` already imports the resolver, so hanging it off the
///! declaration index would close an import cycle.
///!
///! Naming: entries are keyed by CANONICAL qualified name
///! (`std::io::traits::CHUNK`), which is what `Res::Def` carries, so a
///! qualified use is a single exact lookup and never a search.  A written
///! qualifier is NOT a key: a use site may spell a module by any whole-segment
///! suffix of its namespace, so the spelling does not identify a module and
///! matching against it would find a module by searching for its spelling,
///! which name lookup forbids.  The resolver already decided what the qualifier names, with the
///! writer's imports in hand; this reads that answer.
///!
///! A bare name is read the same way: an `IdentifierExpr` carries the
///! resolver's answer for it, and a `Def` is the constant's canonical name.
///! A local, a type parameter or an unanswered slot names no module-level
///! constant, and no leaf map stands in for them - a program-wide leaf index
///! answers from any module with no import in hand, so it would answer a
///! constant the writing module cannot see.
///!
///! `ConstEval` is the ONE folder for every position that wants a compile-time
///! integer: an array size, a `[value; N]` repeat count, and a `static_assert`
///! condition.  They differ only in which capabilities exist at their point in
///! the pipeline - an array size is fixed before any layout is computed, so
///! `sizeof` is not a constant there - and a capability is passed as a
///! pointer that may be null rather than as a separate folder.
///!
///! A folded value is a `FoldedInteger`: wide enough for every value of every
///! integer type at once, so `u128::MAX` and `i128::MIN` are both constants,
///! and a fold that would leave that range bails.

namespace compiler::const_table;

import compiler::ast::{ declaration, expression, LiteralKind, node, TypeAnnotation };
import compiler::resolver::{ symbol_str, intern_table };
import compiler::resolver::res::{ Res, ResBase, ResSlot, DefTable, DefId, DefKey };
import compiler::types::{ type_ref, arena };
import compiler::types::type_base::{ Type };
import std::core::option::{ Option };
import std::collections::hashmap::{ HashMap };
import std::fmt;
import compiler::ast::declaration::{ DeclarationNode, EnumDecl };
import compiler::ast::expression::{
    AlignofExpr, BinaryExpr, CastExpr, ExpressionNode, IdentifierExpr,
    LiteralExpr, ScopeResolutionExpr, SizeofExpr, UnaryExpr
};
import compiler::lex::{ TokenType };
import compiler::lex::lexer::{ Lexer };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::types::arena::{ TypeArena };


/// Fold states for one entry.  Only a SUCCESS is memoized: a fold can fail
/// for want of a capability that a later position supplies, so caching the
/// failure would make the answer depend on which position asked first.
/// `Folding` is the cycle guard - a constant whose initializer names itself,
/// directly or through another constant, is not a compile-time integer.
const CONST_PENDING: i32 = 0;
const CONST_FOLDING: i32 = 1;
const CONST_FOLDED:  i32 = 2;


/// One module-level `const`, with the initializer it is folded from.
///
/// `init` is borrowed from the AST, which outlives the table.
type struct ConstEntry {
    init:      ExpressionNode*;
    value:     FoldedInteger;
    state:     i32;
    /// The same initializer folded as a REAL, memoized separately.
    ///
    /// Separate slots rather than one numeric slot because the two folds accept
    /// different expressions and must not answer for each other: `1 / 2` is 0
    /// as an integer and 0.5 as a real, so a value cached by one question would
    /// be a wrong answer to the other. The INDEX is shared - a constant is
    /// named the same ways whatever its type - and only the interpretation
    /// differs.
    real_value: f64;
    real_state: i32;
    /// Whether the declaration named an INTEGER primitive.
    ///
    /// The reading of an initializer is the DECLARED TYPE's to choose, not the
    /// expression's: `1 / 2` is 0 in `const H: i64` and 0.5 in `const H: f64`,
    /// so a real fold that re-interprets the initializer of an integer constant
    /// answers with a value that constant never had.  False for a real, for a
    /// non-primitive, and for an absent annotation - all of which leave the
    /// choice to the expression, which is what an unannotated constant wants.
    int_typed: boolean;
    /// The primitive the declaration names, or "" for any other annotation
    /// and for none.  An integer-typed constant's folded value is wrapped to
    /// it, so the compile-time value is the one the program reads.
    declared: string;
}


type struct ConstantTable {
    /// The compilation's definitions, for a definition's slot.  Borrowed;
    /// set by `CompilationContext`, which owns it.
    defs: DefTable*;
    entries: [ConstEntry];
    /// The constant's definition -> index into `entries`.
    by_def: HashMap<DefKey, i64>;

    /// Module-level `type enum` declarations, so `Enum::Variant` folds to its
    /// discriminant.  Keyed by the enum's definition: the resolver says which
    /// type a written scope names, so there is nothing here for a spelling to
    /// be matched against.
    enums: [EnumDecl*];
    enums_by_def: HashMap<DefKey, i64>;

    /// The constants each type declares (`Point::ORIGIN`, `i32::MAX`),
    /// parallel arrays: the owning type's definition (a primitive's
    /// included), the constant's leaf, and the constant's definition.
    /// Read only through `type_constant`.
private:
    type_constant_owners: [DefId];
    type_constant_leaves: [SymbolStr];
    type_constant_defs:   [DefId];

public:
    static new(defs: DefTable*) -> ConstantTable {
        return ConstantTable {
            defs: defs,
            entries:      [],
            by_def:       HashMap::<DefKey, i64>::new(),
            enums:        [],
            enums_by_def: HashMap::<DefKey, i64>::new(),
            type_constant_owners: [],
            type_constant_leaves: [],
            type_constant_defs:   [],
        };
    }

    /// Record `def` as the constant the type `owner` declares as `leaf`.
    /// False, recording nothing, when `owner` already declares a constant
    /// under `leaf`: the caller reports the redeclaration.
    declare_type_constant(mut &this, owner: DefId, leaf: SymbolStr, def: DefId) -> boolean {
        if (this.type_constant(owner, leaf).is_valid()) { return false; }
        this.type_constant_owners.push(owner);
        this.type_constant_leaves.push(leaf);
        this.type_constant_defs.push(def);
        return true;
    }

    /// The type a path's qualifier names, as the owner its constants are
    /// recorded under: a declared type's definition, or a primitive's.
    /// Invalid for a qualifier that names neither.
    type_constant_owner(&this, base: ResBase) -> DefId {
        return match (base) {
            ResBase::Def(d)    => { d }
            ResBase::PrimTy(p) => { this.defs.primitive(p) }
            _                  => { DefId::invalid() }
        };
    }

    /// The constant the type `owner` declares as `leaf`, or the invalid id.
    /// The one door for a type's constant: a path `T::NAME` with `T` a
    /// type is answered here, whichever pass asks.
    type_constant(&this, owner: DefId, leaf: SymbolStr) -> DefId {
        if (!owner.is_valid()) { return DefId::invalid(); }
        for (mut i: i64 = 0; i < this.type_constant_defs.length(); i++) {
            if (this.type_constant_leaves[i].id == leaf.id && this.type_constant_owners[i].equals(owner)) {
                return this.type_constant_defs[i];
            }
        }
        return DefId::invalid();
    }

    /// Record the constant `def` as initialized from `init`.
    ///
    /// Re-registering the same definition replaces its initializer rather
    /// than adding a second entry, which keeps repeated passes over a module
    /// idempotent.  A declaration with no definition records nothing.
    /// `declared` is the primitive the declaration names (`declared_primitive`).
    register(mut &this, def: DefId, init: ExpressionNode*,
             declared: string) -> void {
        if (!def.is_valid()) { return; }
        const int_typed: boolean = declared.length() > 0
            && ResBase::reads_as_integer(ResBase::primitive_position(declared));
        const key: DefKey = this.defs.table_key(def);
        match (this.by_def.get(&key)) {
            Option::Some(existing) => {
                this.entries[existing].init       = init;
                this.entries[existing].value      = FoldedInteger::unsigned(0);
                this.entries[existing].state      = CONST_PENDING;
                this.entries[existing].real_value = 0.0;
                this.entries[existing].real_state = CONST_PENDING;
                this.entries[existing].int_typed  = int_typed;
                this.entries[existing].declared   = declared;
                return;
            }
            Option::None => { }
        }

        const idx: i64 = this.entries.length();
        this.entries.push(ConstEntry {
            init:           init,
            value:          FoldedInteger::unsigned(0),
            state:          CONST_PENDING,
            real_value:     0.0,
            real_state:     CONST_PENDING,
            int_typed:      int_typed,
            declared:       declared,
        });
        this.by_def.insert(key, idx);
    }

    /// Record a module-level enum declaration under its definition - the
    /// one `Res::TypeRelative`'s base carries.  Re-registering the same
    /// definition replaces the node.
    register_enum(mut &this, node: EnumDecl*) -> void {
        if (node == null || !node.def.is_valid()) { return; }
        const key: DefKey = this.defs.table_key(node.def);
        match (this.enums_by_def.get(&key)) {
            Option::Some(existing) => { this.enums[existing] = node; return; }
            Option::None => { }
        }
        const idx: i64 = this.enums.length();
        this.enums.push(node);
        this.enums_by_def.insert(key, idx);
    }

    /// The entry of the constant `d`, or -1 when `d` is no constant this
    /// table holds.
    index_of(&this, d: DefId) -> i64 {
        if (!d.is_valid()) { return -1; }
        return match (this.by_def.get(&this.defs.table_key(d))) {
            Option::Some(i) => { i }
            Option::None    => { -1 }
        };
    }

    /// The primitive `ann` names, which decides how the declaration's
    /// initializer is READ and what its folded value is wrapped to; "" for
    /// anything that is not a primitive - a type name, an alias, an absent
    /// annotation - which leaves the choice to the expression's own shape.
    static declared_primitive(ann: TypeAnnotation*, intern: InternTable*) -> string {
        if (ann == null || intern == null) { return ""; }
        return match (*ann) {
            TypeAnnotation::Primitive(p) => { ConstantTable::keyword_primitive(p.name, intern) }
            _ => { "" }
        };
    }

    /// A keyword annotation's primitive, by its own spelling: an alias
    /// keyword's lexeme (`int`, `uint`) folds to the primitive it spells, so
    /// no width table here carries a second spelling of one type.
    static keyword_primitive(name: SymbolStr, intern: InternTable*) -> string {
        const lexeme: string = intern.resolve(name);
        const canon: string = ResBase::primitive_of_alias(lexeme);
        return if (canon.length() > 0) { canon } else { lexeme };
    }


    /// Decode an integer literal lexeme, honouring `0x`/`0o`/`0b` prefixes and
    /// `_` separators.  None on overflow past u128 or on a stray character.
    static parse_int_literal(text_text: string) -> Option<u128> {
        const text: string = text_text;
        if (text == null) { return Option::None; }
        mut i: i64 = 0;
        mut base: u128 = 10;
        if (text[0] == '0' && text[1] != 0) {
            const c: char = text[1];
            if (c == 'x' || c == 'X') { base = 16; i = 2; }
            else if (c == 'o' || c == 'O') { base = 8;  i = 2; }
            else if (c == 'b' || c == 'B') { base = 2;  i = 2; }
        }

        mut acc: u128 = 0;
        mut saw_digit: boolean = false;
        while (text[i] != 0) {
            const c: char = text[i];
            i = i + 1;
            if (c == '_') { continue; }
            // A type suffix or stray character is no hex digit: -1.
            const value: i32 = c.hex_value();
            if (value < 0) { return Option::None; }
            const d: u128 = value as u128;
            if (d >= base) { return Option::None; }
            // Overflow check before the multiply-add.
            if (acc > (u128::MAX - d) / base) { return Option::None; }
            acc = acc * base + d;
            saw_digit = true;
        }
        if (!saw_digit) { return Option::None; }
        return Option::Some(acc);
    }
}


/// A folded integer: any value of any integer type, `i128::MIN` through
/// `u128::MAX`, held as a 129-bit two's-complement number - `bits` its low
/// 128 bits and `negative` its sign.  Every operation answers None when its
/// result would leave that range, so a fold never carries a value no integer
/// type holds.
type struct FoldedInteger {
    bits: u128;
    negative: boolean;

    static of(value: i128) -> FoldedInteger {
        return FoldedInteger { bits: value as u128, negative: value < 0 };
    }

    static unsigned(value: u128) -> FoldedInteger {
        return FoldedInteger { bits: value, negative: false };
    }

    static truth(holds: boolean) -> FoldedInteger {
        return FoldedInteger::unsigned(if (holds) { 1 } else { 0 });
    }

    is_zero(&this) -> boolean {
        return !this.negative && this.bits == 0;
    }

    /// The value as an `i128`, when it is one.
    to_i128(&this) -> Option<i128> {
        if (this.negative != (this.bits > i128::MAX as u128)) { return Option::None; }
        return Option::Some(this.bits as i128);
    }

    /// The value's 64-bit two's-complement bit pattern, when it has one:
    /// from `i64::MIN` through `u64::MAX`.
    to_64_bit_pattern(&this) -> Option<u64> {
        if (this.negative && (this.bits as i128) < i64::MIN as i128) { return Option::None; }
        if (!this.negative && this.bits > u64::MAX as u128) { return Option::None; }
        return Option::Some(this.bits as u64);
    }

    to_f64(&this) -> f64 {
        if (this.negative) { return (this.bits as i128) as f64; }
        return this.bits as f64;
    }

    /// The value in decimal, sign included.
    to_decimal_str(&this) -> string {
        if (this.negative) { return (this.bits as i128).to_decimal_str(); }
        return this.bits.to_decimal_str();
    }

    /// The distance from zero; `i128::MIN`'s, 2^127, is a `u128` too.
    magnitude(&this) -> u128 {
        if (this.negative) { return ~this.bits + 1; }
        return this.bits;
    }

    /// The value with sign `negative` and distance from zero `magnitude`.
    static signed(negative: boolean, magnitude: u128) -> Option<FoldedInteger> {
        if (!negative || magnitude == 0) {
            return Option::Some(FoldedInteger::unsigned(magnitude));
        }
        if (magnitude > (i128::MAX as u128) + 1) { return Option::None; }
        return Option::Some(FoldedInteger { bits: ~magnitude + 1, negative: true });
    }

    /// The 129-bit result `bits`/`negative`, when it is in range: a negative
    /// value below `i128::MIN` has its top bit clear.
    static checked(bits: u128, negative: boolean) -> Option<FoldedInteger> {
        if (negative && bits <= i128::MAX as u128) { return Option::None; }
        return Option::Some(FoldedInteger { bits: bits, negative: negative });
    }

    negate(&this) -> Option<FoldedInteger> {
        return FoldedInteger::signed(!this.negative, this.magnitude());
    }

    add(&this, other: FoldedInteger) -> Option<FoldedInteger> {
        const bits: u128 = this.bits + other.bits;
        const carry: boolean = bits < this.bits;
        const negative: boolean = (this.negative != other.negative) != carry;
        // Two operands of one sign whose sum has the other overflowed 129 bits.
        if (this.negative == other.negative && negative != this.negative) { return Option::None; }
        return FoldedInteger::checked(bits, negative);
    }

    subtract(&this, other: FoldedInteger) -> Option<FoldedInteger> {
        const bits: u128 = this.bits - other.bits;
        const borrow: boolean = this.bits < other.bits;
        const negative: boolean = (this.negative != other.negative) != borrow;
        // Operands of different signs whose difference has the subtrahend's
        // sign overflowed 129 bits.
        if (this.negative != other.negative && negative != this.negative) { return Option::None; }
        return FoldedInteger::checked(bits, negative);
    }

    multiply(&this, other: FoldedInteger) -> Option<FoldedInteger> {
        const left: u128 = this.magnitude();
        const right: u128 = other.magnitude();
        if (left != 0 && right > u128::MAX / left) { return Option::None; }
        return FoldedInteger::signed(this.negative != other.negative, left * right);
    }

    /// The quotient truncated toward zero, or the remainder taking the
    /// dividend's sign when `remainder`; None for a zero divisor.
    divide(&this, other: FoldedInteger, remainder: boolean) -> Option<FoldedInteger> {
        if (other.is_zero()) { return Option::None; }
        const left: u128 = this.magnitude();
        const right: u128 = other.magnitude();
        if (remainder) { return FoldedInteger::signed(this.negative, left % right); }
        return FoldedInteger::signed(this.negative != other.negative, left / right);
    }

    /// `this * 2^count`, for a count below 128.
    shift_left(&this, count: FoldedInteger) -> Option<FoldedInteger> {
        if (count.negative || count.bits >= 128) { return Option::None; }
        return this.multiply(FoldedInteger::unsigned((1 as u128) << count.bits));
    }

    /// The 129-bit arithmetic shift, for a count below 128: a negative value
    /// shifts its sign in.
    shift_right(&this, count: FoldedInteger) -> Option<FoldedInteger> {
        if (count.negative || count.bits >= 128) { return Option::None; }
        mut bits: u128 = this.bits >> count.bits;
        if (this.negative && count.bits > 0) { bits = bits | (u128::MAX << (128 - count.bits)); }
        return Option::Some(FoldedInteger { bits: bits, negative: this.negative });
    }

    bitwise_and(&this, other: FoldedInteger) -> Option<FoldedInteger> {
        return FoldedInteger::checked(this.bits & other.bits, this.negative && other.negative);
    }

    bitwise_or(&this, other: FoldedInteger) -> Option<FoldedInteger> {
        return FoldedInteger::checked(this.bits | other.bits, this.negative || other.negative);
    }

    bitwise_xor(&this, other: FoldedInteger) -> Option<FoldedInteger> {
        return FoldedInteger::checked(this.bits ^ other.bits, this.negative != other.negative);
    }

    bitwise_not(&this) -> Option<FoldedInteger> {
        return FoldedInteger::checked(~this.bits, !this.negative);
    }

    /// `this <op> other` for a binary operator a fold accepts; None for any
    /// other operator and for a result out of range.  A comparison or
    /// logical operator answers 0 or 1.
    apply(&this, op: TokenType, other: FoldedInteger) -> Option<FoldedInteger> {
        return match (op) {
            TokenType::Plus           => { this.add(other) }
            TokenType::Minus          => { this.subtract(other) }
            TokenType::Star           => { this.multiply(other) }
            TokenType::Slash          => { this.divide(other, false) }
            TokenType::Percent        => { this.divide(other, true) }
            TokenType::LessLess       => { this.shift_left(other) }
            TokenType::GreaterGreater => { this.shift_right(other) }
            TokenType::Amp            => { this.bitwise_and(other) }
            TokenType::Pipe           => { this.bitwise_or(other) }
            TokenType::Caret          => { this.bitwise_xor(other) }
            TokenType::EqualEqual     => { Option::Some(FoldedInteger::truth(this.equals(other))) }
            TokenType::ExclaimEqual   => { Option::Some(FoldedInteger::truth(!this.equals(other))) }
            TokenType::LAngle         => { Option::Some(FoldedInteger::truth(this.less_than(other))) }
            TokenType::LessEqual      => { Option::Some(FoldedInteger::truth(!other.less_than(*this))) }
            TokenType::RAngle         => { Option::Some(FoldedInteger::truth(other.less_than(*this))) }
            TokenType::GreaterEqual   => { Option::Some(FoldedInteger::truth(!this.less_than(other))) }
            TokenType::AmpAmp         => { Option::Some(FoldedInteger::truth(!this.is_zero() && !other.is_zero())) }
            TokenType::PipePipe       => { Option::Some(FoldedInteger::truth(!this.is_zero() || !other.is_zero())) }
            _                         => { Option::None }
        };
    }

    equals(&this, other: FoldedInteger) -> boolean {
        return this.negative == other.negative && this.bits == other.bits;
    }

    less_than(&this, other: FoldedInteger) -> boolean {
        if (this.negative != other.negative) { return this.negative; }
        return this.bits < other.bits;
    }
}


/// Everything a compile-time integer fold is allowed to consult.
///
/// A null capability is a NARROWER ENVIRONMENT, not a different rule.  Sema
/// selects an integer literal's width before any name is bound, so it folds
/// with no table and an identifier is simply not a constant there; an array
/// size is fixed before TypeLowering computes a single layout, so `sizeof` is
/// not a constant there either.  The positions that share this folder must
/// share its answers wherever they share its capabilities - that is the
/// property that keeps `[T; N]` and `[v; N]` agreeing about `N`.
type struct ConstEval {
    table:  ConstantTable*;
    intern: InternTable*;
    /// Layouts, for `sizeof`/`alignof`.  Null until TypeLowering has run.
    arena:  TypeArena*;

    static new(table: ConstantTable*, intern: InternTable*, arena: TypeArena*) -> ConstEval {
        return ConstEval { table: table, intern: intern, arena: arena };
    }

    /// A folder with no name binding and no layouts: literal arithmetic only.
    static literals_only() -> ConstEval {
        return ConstEval { table: null, intern: null, arena: null };
    }

    /// Fold a compile-time integer expression to its value.
    ///
    /// None for anything non-constant, for any step that would leave the
    /// range of every integer type (`i128::MIN` through `u128::MAX`) or
    /// divide by a constant zero, and for a name this environment cannot
    /// bind.  Bailing is always safe: callers either leave a width unchanged
    /// or report the position as non-constant.
    ///
    /// Booleans fold as 0/1 so a comparison composes with arithmetic; a caller
    /// that wants a count rejects a negative result itself.
    fold(&this, expr: ExpressionNode*) -> Option<FoldedInteger> {
        if (expr == null) { return Option::None; }
        const node: ExpressionNode* = expr;

        const lit: LiteralExpr* = ExpressionNode::literal_of(expr);
        if (lit != null) {
            if (lit.literal_kind == LiteralKind::Boolean) {
                return Option::Some(FoldedInteger::truth(lit.value == "true"));
            }
            // A character is its Unicode scalar value, read by the one
            // decoder of a character literal.
            if (lit.literal_kind == LiteralKind::Char) {
                return Option::Some(FoldedInteger::unsigned(Lexer::char_literal_value(lit.value) as u128));
            }
            if (lit.literal_kind != LiteralKind::Integer) { return Option::None; }
            // `value` is the whole lexeme, suffix included; the lexer already
            // found the boundary, so strip rather than re-derive it - a digit
            // scan cannot tell `0x1f64` (no suffix) from `0x1u8`.
            mut text: string = lit.value;
            const slen: i64 = lit.suffix.length() as i64;
            if (slen > 0) {
                const vlen: i64 = lit.value.length() as i64;
                if (vlen <= slen) { return Option::None; }
                text = lit.value.substr(0, (vlen - slen) as i64);
            }
            return match (ConstantTable::parse_int_literal(text)) {
                Option::Some(v) => { Option::Some(FoldedInteger::unsigned(v)) }
                Option::None    => { Option::None }
            };
        }

        const id: IdentifierExpr* = ExpressionNode::identifier_of(node);
        if (id != null) {
            return this.fold_named(id);
        }

        const sr: ScopeResolutionExpr* = ExpressionNode::scope_resolution_of(node);
        if (sr != null) {
            return this.fold_scoped(sr);
        }

        const fold_cast: CastExpr* = ExpressionNode::cast_of(node);
        if (fold_cast != null) {
            return match (this.fold(fold_cast.expression)) {
                Option::Some(v) => {
                    ConstEval::wrap_to_primitive(
                        this.primitive_name_of(fold_cast.target_annotation), v)
                }
                Option::None => { Option::None }
            };
        }

        const sz: SizeofExpr* = ExpressionNode::sizeof_of(node);
        if (sz != null) {
            // `operand_type`, never `resolved_type`: the latter is the type of
            // the `sizeof` EXPRESSION (`u64`), so reading it here measures the
            // count instead of the thing being counted.
            if (this.arena == null || !sz.operand_type.is_valid()) { return Option::None; }
            const t: Type* = this.arena.lookup(sz.operand_type);
            if (t == null) { return Option::None; }
            return Option::Some(FoldedInteger::unsigned(t.size_bytes() as u128));
        }

        const al: AlignofExpr* = ExpressionNode::alignof_of(node);
        if (al != null) {
            if (this.arena == null || !al.operand_type.is_valid()) { return Option::None; }
            const t: Type* = this.arena.lookup(al.operand_type);
            if (t == null) { return Option::None; }
            return Option::Some(FoldedInteger::unsigned(t.alignment() as u128));
        }

        const u: UnaryExpr* = ExpressionNode::unary_of(node);
        if (u != null) {
            return match (this.fold(u.operand)) {
                Option::Some(a) => {
                    match (u.op.kind) {
                        TokenType::Minus   => { a.negate() }
                        TokenType::Tilde   => { a.bitwise_not() }
                        TokenType::Exclaim => { Option::Some(FoldedInteger::truth(a.is_zero())) }
                        _                  => { Option::None }
                    }
                }
                Option::None => { Option::None }
            };
        }

        const b: BinaryExpr* = ExpressionNode::binary_of(node);
        if (b != null) {
            // The right operand is not folded when the left is not a constant.
            return match (this.fold(b.left)) {
                Option::Some(x) => {
                    match (this.fold(b.right)) {
                        Option::Some(y) => { x.apply(b.op.kind, y) }
                        Option::None    => { Option::None }
                    }
                }
                Option::None => { Option::None }
            };
        }

        return Option::None;
    }

    /// Fold a compile-time REAL expression to its `f64` value.
    ///
    /// The same environment and the same index as `fold`, interpreting the
    /// expression as a real instead of an integer.  It exists because a real
    /// initializer reaches exactly the same dead end an integer one did: an
    /// unfolded module-level initializer is not diagnosed, it is emitted as
    /// zero, so a folder that cannot read a name publishes 0.0 for
    /// `const D: f64 = A * B;`.
    ///
    /// An INTEGER-valued subexpression folds here too, promoted - that is what
    /// makes `2.0 * 3` and `RADIUS * COUNT` mean what they read as. The integer
    /// folder is asked for those rather than duplicated, so a shape either
    /// folder accepts has one implementation and cannot drift.
    ///
    /// Division needs no signedness detour as it does in the integer folder:
    /// `/` is exact-in-kind for reals, and it is the operator a derived real
    /// constant is most often written with.
    fold_real(&this, expr: ExpressionNode*) -> Option<f64> {
        if (expr == null) { return Option::None; }
        const node: ExpressionNode* = expr;

        const lit: LiteralExpr* = ExpressionNode::literal_of(expr);
        if (lit != null) {
            if (lit.literal_kind == LiteralKind::Float) {
                return Lexer::float_literal_value(lit.value);
            }
            // A non-float literal is an integer-valued constant; fall through.
        }

        const id: IdentifierExpr* = ExpressionNode::identifier_of(node);
        if (id != null) {
            const named: Option<f64> = this.fold_named_real(id);
            if (named.is_some()) { return named; }
            // Not a real constant - it may still be an integer one.
        }

        // Terminal, unlike the bare-name case above: the qualifier's own
        // answer says which kind of thing the member is, so one dispatch
        // settles both the real and the integer reading and there is no
        // second question left for the promotion below to ask.
        const sr: ScopeResolutionExpr* = ExpressionNode::scope_resolution_of(node);
        if (sr != null) {
            return this.fold_scoped_real(sr);
        }

        // The cast's own width is applied by the emitter against the global's
        // type, so the operand folds once and converts once.
        const real_cast: CastExpr* = ExpressionNode::cast_of(node);
        if (real_cast != null) {
            return this.fold_real(real_cast.expression);
        }

        const u: UnaryExpr* = ExpressionNode::unary_of(node);
        if (u != null) {
            if (u.op.kind != TokenType::Minus) { return Option::None; }
            return match (this.fold_real(u.operand)) {
                Option::Some(a) => { Option::Some(0.0 - a) }
                Option::None    => { Option::None }
            };
        }

        const b: BinaryExpr* = ExpressionNode::binary_of(node);
        if (b != null) {
            const x: Option<f64> = this.fold_real(b.left);
            if (x.is_none()) { return Option::None; }
            const y: Option<f64> = this.fold_real(b.right);
            if (y.is_none()) { return Option::None; }
            const op: TokenType = b.op.kind;
            if (op == TokenType::Plus) { return Option::Some(x.unwrap() + y.unwrap()); }
            if (op == TokenType::Minus) { return Option::Some(x.unwrap() - y.unwrap()); }
            if (op == TokenType::Star) { return Option::Some(x.unwrap() * y.unwrap()); }
            // Division by zero is NOT refused: IEEE gives it an answer, and it
            // is the same answer the emitted code would compute, so declining
            // would replace an infinity with the zero the fallback publishes.
            if (op == TokenType::Slash) { return Option::Some(x.unwrap() / y.unwrap()); }
            return Option::None;
        }

        // Anything else this environment can evaluate is integer-valued
        // (a named integer constant, an enum variant, `sizeof`), promoted.
        return ConstEval::promoted(this.fold(expr));
    }

    /// A folded integer as a real.
    static promoted(value: Option<FoldedInteger>) -> Option<f64> {
        return match (value) {
            Option::Some(v) => { Option::Some(v.to_f64()) }
            Option::None    => { Option::None }
        };
    }

    /// The entry a bare name's STAMP denotes, or -1.  A `Def` is the
    /// constant's definition, the key the table is built under; every
    /// other answer - a local, a type parameter, a type, no answer - names
    /// no module-level constant.
    stamped_index_of(&this, id: IdentifierExpr*) -> i64 {
        if (this.table == null) { return -1; }
        return match (id.res) {
            ResSlot::Answered(r) => {
                match (r) {
                    Res::Def(d) => { this.table.index_of(d) }
                    _ => { -1 }
                }
            }
            _ => { -1 }
        };
    }

    /// Fold a bare name: the constant its stamp names.
    fold_named(&this, id: IdentifierExpr*) -> Option<FoldedInteger> {
        const idx: i64 = this.stamped_index_of(id);
        if (idx < 0) { return Option::None; }
        return this.fold_entry(idx);
    }

    /// Fold `scope::member`, from what the RESOLVER said the scope names.
    ///
    /// The written qualifier is not consulted.  A use site may spell a module
    /// by any whole-segment suffix of its namespace, so the spelling does not
    /// identify a module and matching against it would find a module by
    /// searching for its spelling.  `scope_res` already carries the
    /// canonical answer, decided once by the pass that had the writer's imports
    /// in hand, and this reads it.
    ///
    /// Two answers are meaningful here and they are different questions:
    /// `Def` means the scope named a MODULE, so the member is the constant
    /// the name layer bound in that module (`member_def`); `TypeRelative`
    /// means it named a TYPE, so the member is a constant the type declares
    /// (`u8::MAX`, `Point::LIMIT`) or an enum variant of it.  Anything else
    /// is not a compile-time integer.
    fold_scoped(&this, sr: ScopeResolutionExpr*) -> Option<FoldedInteger> {
        if (this.table == null || this.intern == null) { return Option::None; }
        return this.fold_scoped_res(
            sr.scope_res.require("ConstEval::fold_scoped"), sr);
    }

    /// `fold_scoped`, from an answer already read off the node.
    ///
    /// Split from the read so that a real fold can dispatch on the SAME answer
    /// without requiring the slot a second time: `require` records a pending
    /// bug for an unstamped node, so asking twice would count one unstamped
    /// path as two.
    fold_scoped_res(&this, r: Res, sr: ScopeResolutionExpr*) -> Option<FoldedInteger> {
        if (this.table == null || this.intern == null) { return Option::None; }

        return match (r) {
            Res::Def(_) => {
                const i: i64 = this.table.index_of(sr.member_def);
                if (i < 0) { return Option::None; }
                return this.fold_entry(i);
            }
            Res::TypeRelative(base, trailing) => {
                // A type's constant or `Enum::Variant`, one trailing segment
                // past the type.
                if (trailing != 1) { return Option::None; }
                const constant: i64 = this.table.index_of(this.table.type_constant(
                    this.table.type_constant_owner(base), sr.member_name));
                if (constant >= 0) { return this.fold_entry(constant); }
                return match (base) {
                    ResBase::Def(q) => {
                        return match (this.table.enums_by_def.get(&this.table.defs.table_key(q))) {
                            Option::Some(ei) => {
                                ConstEval::variant_tag_of(this.table.enums[ei], sr.member_name)
                            }
                            Option::None => { Option::None }
                        };
                    }
                    _ => { Option::None }
                };
            }
            _ => { Option::None }
        };
    }

    /// The discriminant `decl` gives `member`, or None when it has no such
    /// variant.  A variant carrying a payload is a constructor, not a value,
    /// so it is not a compile-time integer.
    static variant_tag_of(decl: EnumDecl*, member: SymbolStr) -> Option<FoldedInteger> {
        if (decl == null) { return Option::None; }
        const i: i64 = decl.variant_position(member);
        if (i < 0) { return Option::None; }
        if (DeclarationNode::variant_of(decl.variants[i]).associated_types.length() > 0) { return Option::None; }
        const tags: [i64] = decl.variant_tags();
        return Option::Some(FoldedInteger::of(tags[i] as i128));
    }

    /// Fold one entry's initializer and memoize the value.
    ///
    /// Only success is memoized - a fold that failed for want of a capability
    /// must be able to succeed at a position that has one.  `Folding` is the
    /// cycle guard: a constant reached from its own initializer is not a
    /// compile-time integer, and without the guard the recursion has no floor.
    ///
    /// An integer-typed constant's value is its initializer's wrapped to the
    /// declared type, as the stored global is: `const A: u8 = B + 200` with
    /// `B` at 100 is 44 at every use, never 300 in an array size and 44 at
    /// run time.
    fold_entry(&this, idx: i64) -> Option<FoldedInteger> {
        if (this.table == null) { return Option::None; }
        if (idx < 0 || idx >= this.table.entries.length()) { return Option::None; }

        const state: i32 = this.table.entries[idx].state;
        if (state == CONST_FOLDED)  { return Option::Some(this.table.entries[idx].value); }
        if (state == CONST_FOLDING) { return Option::None; }

        const init: ExpressionNode* = this.table.entries[idx].init;
        if (init == null) { return Option::None; }

        this.table.entries[idx].state = CONST_FOLDING;
        mut folded: Option<FoldedInteger> = this.fold(init);
        if (this.table.entries[idx].int_typed) {
            folded = match (folded) {
                Option::Some(v) => {
                    ConstEval::wrap_to_primitive(this.table.entries[idx].declared, v)
                }
                Option::None => { Option::None }
            };
        }
        return match (folded) {
            Option::Some(v) => {
                this.table.entries[idx].value = v;
                this.table.entries[idx].state = CONST_FOLDED;
                Option::Some(v)
            }
            Option::None => {
                this.table.entries[idx].state = CONST_PENDING;
                Option::None
            }
        };
    }

    /// `fold_named`, as a real.
    fold_named_real(&this, id: IdentifierExpr*) -> Option<f64> {
        const idx: i64 = this.stamped_index_of(id);
        if (idx < 0) { return Option::None; }
        return this.fold_entry_real(idx);
    }

    /// `fold_scoped`, as a real.
    ///
    /// A module's constant is folded as a real in its own right, because that
    /// is the only reading under which a float initializer is a value at all:
    /// asking the integer folder for `Scalar::PI` and promoting its answer
    /// fails at the float literal inside, and a global initializer that fails
    /// to fold is not diagnosed - it is emitted as zero.
    ///
    /// Everything else a scope can name is integer-valued - an enum variant's
    /// discriminant - so it is decoded once by the integer arm and promoted,
    /// rather than given a second decoder here that could disagree with it.
    fold_scoped_real(&this, sr: ScopeResolutionExpr*) -> Option<f64> {
        if (this.table == null || this.intern == null) { return Option::None; }

        const r: Res = sr.scope_res.require("ConstEval::fold_scoped_real");
        return match (r) {
            Res::Def(_) => {
                const i: i64 = this.table.index_of(sr.member_def);
                if (i < 0) { return Option::None; }
                return this.fold_entry_real(i);
            }
            Res::TypeRelative(base, 1) => {
                const constant: i64 = this.table.index_of(this.table.type_constant(
                    this.table.type_constant_owner(base), sr.member_name));
                if (constant >= 0) { return this.fold_entry_real(constant); }
                return ConstEval::promoted(this.fold_scoped_res(r, sr));
            }
            _ => {
                return ConstEval::promoted(this.fold_scoped_res(r, sr));
            }
        };
    }

    /// `fold_entry`, as a real, memoized in the entry's own real slots and
    /// guarded against cycles the same way.
    fold_entry_real(&this, idx: i64) -> Option<f64> {
        if (this.table == null) { return Option::None; }
        if (idx < 0 || idx >= this.table.entries.length()) { return Option::None; }

        const state: i32 = this.table.entries[idx].real_state;
        if (state == CONST_FOLDED)  { return Option::Some(this.table.entries[idx].real_value); }
        if (state == CONST_FOLDING) { return Option::None; }

        const init: ExpressionNode* = this.table.entries[idx].init;
        if (init == null) { return Option::None; }

        this.table.entries[idx].real_state = CONST_FOLDING;
        // An integer-typed constant is folded as an INTEGER and promoted, never
        // re-read as a real.  Its value is what its own declaration produced -
        // `const H: i64 = 1 / 2;` is 0 - and a real reading of the same
        // initializer answers 0.5, a number that constant never held at any
        // position.  The declared type is the only thing that can settle this;
        // the initializer looks identical either way.
        const folded: Option<f64> = if (this.table.entries[idx].int_typed) {
            ConstEval::promoted(this.fold_entry(idx))
        } else {
            this.fold_real(init)
        };
        return match (folded) {
            Option::Some(v) => {
                this.table.entries[idx].real_value = v;
                this.table.entries[idx].real_state = CONST_FOLDED;
                Option::Some(v)
            }
            Option::None => {
                this.table.entries[idx].real_state = CONST_PENDING;
                Option::None
            }
        };
    }

    /// The primitive name a cast targets, or "" when the target is anything
    /// else.  Only a primitive target has a width known without resolving a
    /// name, and a cast to a user type is not an integer anyway.
    primitive_name_of(&this, ann: TypeAnnotation*) -> string {
        if (ann == null || this.intern == null) { return ""; }
        return match (*ann) {
            TypeAnnotation::Primitive(p) => { ConstantTable::keyword_primitive(p.name, this.intern) }
            _ => { "" }
        };
    }

    /// Wrap `v` to the width and signedness of the primitive `prim`, the way
    /// the emitted cast will, so `Slot::B as u8` folds to what the program
    /// observes rather than to the unwrapped operand.
    ///
    /// None for a float, which a folded integer cannot carry.  A `char` is a
    /// 32-bit unsigned scalar.
    static wrap_to_primitive(prim: string, v: FoldedInteger) -> Option<FoldedInteger> {
        if (prim == "boolean") { return Option::Some(FoldedInteger::truth(!v.is_zero())); }

        mut bits: u128 = 0;
        mut is_signed: boolean = true;
        if (prim == "char") { bits = 32; is_signed = false; }
        else if (prim == "i8")   { bits = 8;  is_signed = true; }
        else if (prim == "i16")   { bits = 16; is_signed = true; }
        else if (prim == "i32")   { bits = 32; is_signed = true; }
        else if (prim == "i64" || prim == "isize") { bits = 64; is_signed = true; }
        else if (prim == "i128")  { bits = 128; is_signed = true; }
        else if (prim == "u8")    { bits = 8;  is_signed = false; }
        else if (prim == "u16")   { bits = 16; is_signed = false; }
        else if (prim == "u32")   { bits = 32; is_signed = false; }
        else if (prim == "u64" || prim == "usize") { bits = 64; is_signed = false; }
        else if (prim == "u128")  { bits = 128; is_signed = false; }
        if (bits == 0) { return Option::None; }

        if (bits == 128) {
            if (is_signed) { return Option::Some(FoldedInteger::of(v.bits as i128)); }
            return Option::Some(FoldedInteger::unsigned(v.bits));
        }

        const mask: u128 = ((1 as u128) << bits) - 1;
        const low: u128 = v.bits & mask;
        const sign_bit: u128 = (1 as u128) << (bits - 1);
        if (is_signed && (low & sign_bit) != 0) {
            return Option::Some(FoldedInteger { bits: low | ~mask, negative: true });
        }
        return Option::Some(FoldedInteger::unsigned(low));
    }
}
