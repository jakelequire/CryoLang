///! Build stamp
///!
///! What a built compiler knows about the checkout it was built from: the
///! commit, its date, the branch, `git describe`, whether tracked files
///! differed from the commit, and the build profile.  None of it is compiled
///! in.  The compiler carries a fixed region, `BUILD_STAMP`, that `cryo stamp`
///! rewrites in the linked binary, so every object the compiler emits and
///! every object it is built from stays the same at every commit, and a
///! binary nobody stamped reports `unknown`.
namespace compiler::utils::build_stamp;

import std::fmt;
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::slice::{ Slice };
import std::fs::file::{ File };
import std::fs::file;
import std::fs::path::{ Path };
import std::process::command::{ Command, Output };

/// The region `cryo stamp` rewrites.  `marker` opens it and is the only copy
/// of its sixteen bytes in a built binary, which is how the region is found
/// in a stripped one; code that needs those bytes reads `BUILD_STAMP.marker`,
/// since a literal spelling them would be a second copy.  `text` is
/// `key=value` lines ended by a NUL, all zero when unstamped.
type struct StampSlot {
    marker: [u8; 16];
    text:   [u8; 496];
}

/// Mutable and externally visible: a read of it is a load of whatever bytes
/// the binary holds, never the zeros it was compiled with.
mut BUILD_STAMP: StampSlot = StampSlot {
    marker: [67, 82, 89, 79, 45, 66, 85, 73, 76, 68, 45, 83, 84, 65, 77, 80],
    text:   [0; 496],
};

/// `text`'s length.  The last byte stays NUL, so a stamp holds one fewer.
const SLOT_TEXT_LEN: i64 = 496;

implement struct StampSlot {
    /// Offset of the text of the one stamp region in `data`, or -1 when
    /// `data` holds none.  `*count` is the number of markers found; a
    /// binary holding more than one has no region to answer with.
    static locate(data: u8*, n: i64, count: mut i64*) -> i64 {
        const marker_len: i64 = 16;
        *count = 0;
        mut found: i64 = -1;
        if (n < marker_len + SLOT_TEXT_LEN) { return -1; }
        const first: u8 = BUILD_STAMP.marker[0];
        const last_start: i64 = n - marker_len - SLOT_TEXT_LEN;
        for (mut i: i64 = 0; i <= last_start; i++) {
            if (data[i] != first) { continue; }
            mut matched: boolean = true;
            for (mut k: i64 = 1; k < marker_len; k++) {
                if (data[i + k] != BUILD_STAMP.marker[k]) { matched = false; break; }
            }
            if (matched) {
                *count = *count + 1;
                found = i + marker_len;
            }
        }
        if (*count != 1) { return -1; }
        return found;
    }

    /// Zero the stamp text inside `data`, the bytes of a whole binary, so a
    /// digest over them is the same for every stamp.  A binary with no
    /// single region is left as it is.
    static clear_text(data: mut u8*, n: i64) -> void {
        mut count: i64 = 0;
        const at: i64 = StampSlot::locate(data, n, &count);
        if (at < 0) { return; }
        for (mut i: i64 = 0; i < SLOT_TEXT_LEN; i++) {
            data[at + i] = 0;
        }
    }

    /// Write `text` into the stamp region of the binary at `path`, zeroing
    /// the rest of it.  Returns "" on success or the reason the binary was
    /// left as it was, phrased to follow "cannot stamp <path>: ".  An unchanged region is not rewritten, so
    /// stamping twice from one checkout leaves the file untouched.
    static write_into(path: string, text: Str) -> String {
        const text_len: i64 = text.length();
        if (text_len >= SLOT_TEXT_LEN) {
            return f"the stamp is {text_len} bytes; the region holds {SLOT_TEXT_LEN - 1}";
        }
        match (File::read_bytes(Path::from(path))) {
            Result::Ok(data) => {
                mut bytes: Array<u8> = data;
                const n: i64 = bytes.length();
                const d: mut u8* = bytes.as_mutable_pointer();
                mut count: i64 = 0;
                const at: i64 = StampSlot::locate(d, n, &count);
                if (at < 0) {
                    return f"it holds {count} stamp regions; expected exactly one";
                }
                mut changed: boolean = false;
                for (mut i: i64 = 0; i < SLOT_TEXT_LEN; i++) {
                    const want: u8 = if (i < text_len) { text.byte_at(i).unwrap_or(0 as u8) } else { 0 };
                    if (d[at + i] != want) {
                        d[at + i] = want;
                        changed = true;
                    }
                }
                if (changed) {
                    match (File::write_bytes(Path::from(path), Slice::<u8>::from_raw(d, n))) {
                        Result::Ok(_) => {}
                        Result::Err(_) => { return String::from("it cannot be written"); }
                    }
                }
                return String::new();
            }
            Result::Err(_) => {
                return String::from("it cannot be read");
            }
        }
    }
}

/// The fields of a stamp.  Each is "" when the binary was not stamped.
/// `fingerprint` is the binary's digest with its stamp text read as zeros,
/// and `bytes` its size, both when it was stamped; they are recorded inside
/// or outside a checkout.  `commits` is the number of commits in the
/// commit's history, which numbers a pre-release.
type struct BuildStamp {
    commit:      String;
    commits:     String;
    date:        String;
    branch:      String;
    describe:    String;
    dirty:       String;
    profile:     String;
    fingerprint: String;
    bytes:       String;
}

implement struct BuildStamp {
    static empty() -> BuildStamp {
        return BuildStamp {
            commit: String::new(), commits: String::new(), date: String::new(), branch: String::new(),
            describe: String::new(), dirty: String::new(), profile: String::new(),
            fingerprint: String::new(), bytes: String::new(),
        };
    }

    /// The digest recorded for this binary, when it was recorded for one of
    /// `size` bytes.  A link writes the region as zeros and only `cryo stamp`
    /// fills it, so a recorded digest was taken over this binary's bytes
    /// unless the file was edited in place after stamping; an edit that
    /// changes its size (a strip) is refused here, and its digest must be
    /// taken again.
    recorded_fingerprint(&this, size: i64) -> Option<u128> {
        if (this.fingerprint.length() != 32) { return Option::None; }
        if (size < 0) { return Option::None; }
        const written: String = f"{size}";
        if (this.bytes.as_str() != written.as_str()) { return Option::None; }
        return u128::parse_literal(this.fingerprint.as_bytes(), 16);
    }

    /// The stamp of the running binary.
    static running() -> BuildStamp {
        const text: string = &BUILD_STAMP.text[0] as string;
        return BuildStamp::parse(Str::new(text));
    }

    /// Read `key=value` lines.  A key it does not know is skipped, so a
    /// stamp written by a newer `cryo stamp` still reads.
    static parse(text: Str) -> BuildStamp {
        mut stamp: BuildStamp = BuildStamp::empty();
        for (line in text.split(&Str::new("\n"))) {
            match (line.split_once(&Str::new("="))) {
                Option::Some(field) => {
                    const key: Str = field.first;
                    const value: Str = field.second;
                    if (key == Str::new("commit")) { stamp.commit = String::from_str(value); }
                    else if (key == Str::new("commits")) { stamp.commits = String::from_str(value); }
                    else if (key == Str::new("date")) { stamp.date = String::from_str(value); }
                    else if (key == Str::new("branch")) { stamp.branch = String::from_str(value); }
                    else if (key == Str::new("describe")) { stamp.describe = String::from_str(value); }
                    else if (key == Str::new("dirty")) { stamp.dirty = String::from_str(value); }
                    else if (key == Str::new("profile")) { stamp.profile = String::from_str(value); }
                    else if (key == Str::new("fingerprint")) { stamp.fingerprint = String::from_str(value); }
                    else if (key == Str::new("bytes")) { stamp.bytes = String::from_str(value); }
                }
                Option::None => {}
            }
        }
        return stamp;
    }

    /// The text `parse` reads back: the checkout's fields when there is a
    /// commit, then the fingerprint when there is one.  "" when there is
    /// neither, so writing it clears a region.
    render(&this) -> String {
        mut text: String = String::new();
        if (this.is_stamped()) {
            text.append(f"commit={this.commit}\ncommits={this.commits}\ndate={this.date}\nbranch={this.branch}\n");
            text.append(f"describe={this.describe}\ndirty={this.dirty}\nprofile={this.profile}\n");
        }
        if (!this.fingerprint.is_empty()) {
            text.append(f"fingerprint={this.fingerprint}\nbytes={this.bytes}\n");
        }
        return text;
    }

    is_stamped(&this) -> boolean {
        return !this.commit.is_empty();
    }

    /// `core`, then `-prerelease` when there is one, numbered `.<commits>`
    /// when the stamp counted them (`1.0.0-alpha.4073`: one pre-release per
    /// commit, ordered as the history is), then the build: `+` and the
    /// commit's first eight hex digits, `-dirty` when tracked files differed
    /// from it, or `+unknown` when the binary was not stamped.
    version(&this, core: Str, prerelease: Str) -> String {
        mut v: String = String::from_str(core);
        if (!prerelease.is_empty()) {
            v.append("-");
            v.append(prerelease);
            if (!this.commits.is_empty()) {
                v.append(".");
                v.append(this.commits.as_str());
            }
        }
        if (!this.is_stamped()) {
            v.append("+unknown");
            return v;
        }
        v.append("+");
        v.append(this.commit.as_str().byte_substring(0, 8));
        if (this.dirty.as_str() == Str::new("yes")) {
            v.append("-dirty");
        }
        return v;
    }

    /// Query the git checkout the current directory is in.  Paths in
    /// `exclude` are named from the top of the checkout, and a change to
    /// one of them does not make the tree dirty: they are the files the
    /// build that asks for the stamp is itself writing.  Outside a checkout,
    /// or with no `git`, the stamp is empty.
    static from_checkout(exclude: [string], profile: Str) -> BuildStamp {
        mut stamp: BuildStamp = BuildStamp::empty();
        stamp.commit = BuildStamp::git_line(["rev-parse", "HEAD"]);
        if (stamp.commit.length() == 0) { return stamp; }
        stamp.commits  = BuildStamp::git_line(["rev-list", "--count", "HEAD"]);
        stamp.date    = BuildStamp::git_line(["log", "-1", "--format=%cs", "HEAD"]);
        stamp.branch   = BuildStamp::git_line(["rev-parse", "--abbrev-ref", "HEAD"]);
        stamp.describe = BuildStamp::git_line(["describe", "--always", "--tags"]);
        stamp.profile  = String::from_str(profile);

        // A build rewrites tracked files' timestamps without changing their
        // bytes, which leaves git's stat cache stale; refresh it so only a
        // real content difference reads as dirty.  It exits non-zero when it
        // refreshed anything, which says nothing about the tree.
        BuildStamp::git_status(["update-index", "-q", "--refresh"]);
        mut diff: [string] = ["diff-index", "--quiet", "HEAD", "--"];
        for (mut i: i64 = 0; i < exclude.length(); i++) {
            diff.push(":(top,exclude)" + exclude[i]);
        }
        const status: i32 = BuildStamp::git_status(diff);
        stamp.dirty = String::from(if (status == 0) { "no" } else { "yes" });
        return stamp;
    }

    /// The first line `git <args>` prints, or "" when it fails.
    static git_line(args: [string]) -> String {
        mut cmd: Command = Command::new(Str::new("git"));
        for (mut i: i64 = 0; i < args.length(); i++) {
            cmd.argument(Str::new(args[i]));
        }
        match (cmd.output()) {
            Result::Ok(out) => {
                mut o: Output = out;
                if (!o.status().success()) { return String::new(); }
                const bytes: &Slice<u8> = o.stdout();
                mut line: String = String::new();
                for (mut i: i64 = 0; i < bytes.length(); i++) {
                    const b: u8 = bytes.get(i).unwrap_or(0 as u8);
                    if (b == 10 as u8 || b == 13 as u8) { break; }
                    line.push_byte(b);
                }
                return line;
            }
            Result::Err(_) => { return String::new(); }
        }
    }

    /// `git <args>`'s exit code; -1 when it could not be run.
    static git_status(args: [string]) -> i32 {
        mut cmd: Command = Command::new(Str::new("git"));
        for (mut i: i64 = 0; i < args.length(); i++) {
            cmd.argument(Str::new(args[i]));
        }
        match (cmd.output()) {
            Result::Ok(out) => {
                mut o: Output = out;
                return o.status().exit_code().unwrap_or(-1);
            }
            Result::Err(_) => { return -1; }
        }
    }
}

/// What `cryo version --verbose` prints beneath the version line.  Every
/// field is text; one that could not be read is "".
type struct VersionReport {
    version: String;
    binary:  String;
    size:    String;
    stamp:   BuildStamp;
    llvm:    string;
    target:  string;
    stdlib:  string;
}

implement struct VersionReport {
    /// The version line, a blank line, then one labelled line per field,
    /// with `unknown` for a field nobody could read.
    render(&this) -> String {
        mut out: String = f"{this.version}\n\n";
        VersionReport::line(&out, "binary:", this.binary.as_str());
        VersionReport::line(&out, "size:", this.size.as_str());
        VersionReport::line(&out, "commit:", this.stamp.commit.as_str());
        VersionReport::line(&out, "commit-date:", this.stamp.date.as_str());
        VersionReport::line(&out, "branch:", this.stamp.branch.as_str());
        VersionReport::line(&out, "describe:", this.stamp.describe.as_str());
        VersionReport::line(&out, "dirty:", this.stamp.dirty.as_str());
        VersionReport::line(&out, "llvm:", this.llvm);
        VersionReport::line(&out, "target:", this.target);
        VersionReport::line(&out, "stdlib:", this.stdlib);
        VersionReport::line(&out, "profile:", this.stamp.profile.as_str());
        return out;
    }

    /// Append `label` padded to its column, then `value`, or `unknown` when
    /// `value` is empty, and a newline.
    static line(out: mut &String, label: string, value: Str) -> void {
        out.append(fmt::format("%-14s", label));
        if (value.is_empty()) { out.append(Str::new("unknown")); } else { out.append(value); }
        out.append(Str::new("\n"));
    }
}
