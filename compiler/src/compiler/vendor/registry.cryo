///! Vendor Library Registry
///!
///! A per-machine registry of vendored C libraries.  `cryo vendor <path>`
///! records a library here once; thereafter `import vendor::Name` resolves to
///! the library's generated `.cryo` bindings and its native link metadata is
///! merged into the project's link command automatically.
///!
///! Storage: a single JSON document at `<cache_root>/vendor/registry.json`
///! (the same `$CRYO_HOME` -> XDG -> $HOME cache-root chain the dependency
///! cache uses).  Reuses `std::encoding::json` for both read and write so there is no
///! second config format.  Shape:
///!
///!   { "schema_version": 1,
///!     "libraries": [
///!       { "key": "raylib", "name": "RayLib", "source_path": "...",
///!         "binding_source": "headers",
///!         "headers": [...], "include_dirs": [...], "defines": [...],
///!         "link": { "system": [...], "search": [...], "static": [...],
///!                   "system_windows": [...], ... , "system_unix": [...], ... },
///!         "cache": [ { "triple": "host", "file": ".../RayLib.cryo", "key": "" } ] } ] }
///!
///! The `cache` array is keyed on the target triple so multiple triples
///! coexist (cross-compilation regenerates lazily on a cache miss).  An empty
///! triple (host build) is normalized to the literal "host" on both the write
///! and resolve sides so it survives as a directory-name component.

namespace compiler::vendor::registry;

import std::ffi::libc;
import std::process;
import std::sys::syscall;
import compiler::deps::cache::{ Cache };
import compiler::project_config::{ ProjectConfig };
import std::fs::file::{ File, OpenOptions };
import std::fs::path::{ Path, PathBuf };
import std::fmt;
import std::thread;
import std::time::duration::{ Duration };
import std::collections::string::{ String };
import std::collections::str::{ Str };
import std::core::option::{ Option };
import std::encoding::json::{ value, parser, serializer };
import std::encoding::json::value::{ JsonObject, JsonValue };
import std::encoding::json::convert::{ ToJson };
import std::core::mem;

const VENDOR_SCHEMA_VERSION: i64 = 1;

/// Native link metadata for a vendored library.  Mirrors the three
/// intent-named roles of `ProjectConfig`'s `[link]` section (system -> `-l`,
/// search -> `-L`, static -> verbatim archive path) plus the per-OS overlays,
/// so merging into a project's link command is a field-for-field append.
/// The elements are `string`s because they are appended to the project
/// config's own link arrays, which hold `string`s for the whole build.
type struct VendorLink {
    system:          [string];
    search:          [string];
    static_libs:     [string];
    system_windows:  [string];
    search_windows:  [string];
    static_windows:  [string];
    system_unix:     [string];
    search_unix:     [string];
    static_unix:     [string];

    static empty() -> VendorLink {
        return VendorLink {
            system: [], search: [], static_libs: [],
            system_windows: [], search_windows: [], static_windows: [],
            system_unix: [], search_unix: [], static_unix: [],
        };
    }
}

/// One (triple -> generated bindings file) cache slot, with the provenance
/// `key` the cache is validated against.
type struct VendorCacheItem {
    triple: String;
    file:   String;
    key:    String;
}

/// One registered library.
type struct VendorEntry {
    key:            String;   // registry key (the source dir basename, lowercased)
    name:           String;   // import namespace, e.g. "RayLib"
    source_path:    String;   // absolute path to the vendored C project
    binding_source: String;   // "headers" (C/libclang) | "cxx-headers" (C++/libclang, direct mangled) | "manual" (pre-written) | "cxx-shim" (reserved, unimplemented)
    headers:        [String];
    include_dirs:   [String];
    defines:        [String];
    /// Source language for libclang: "c" (default) or "c++".  Empty means "c".
    /// `binding_source: "cxx-headers"` implies "c++".  Selects `-x c++`.
    language:       String;
    /// C++ standard for `-std=` (e.g. "c++17"); empty defaults to "c++17".
    /// Ignored for C bindings.
    std:            String;
    link:           VendorLink;
    cache:          [VendorCacheItem];

    /// True when this entry binds C++ headers (direct mangled-symbol binding).
    is_cxx(&this) -> boolean {
        return this.binding_source.as_str() == Str::new("cxx-headers")
            || this.language.as_str() == Str::new("c++");
    }

    /// True when the bindings are generated from the manifest's headers by
    /// libclang (C or C++), rather than copied from a pre-written file.
    is_generated(&this) -> boolean {
        return this.binding_source.as_str() == Str::new("headers")
            || this.binding_source.as_str() == Str::new("cxx-headers");
    }

    /// The libclang source language for this entry: "c++" for a C++ binding,
    /// else "c".
    lang_arg(&this) -> Str {
        if (this.is_cxx()) { return Str::new("c++"); }
        return Str::new("c");
    }

    /// The generated bindings path for `triple`, or "" if not yet cached.
    cache_file_for(&this, triple: Str) -> Str {
        for (mut i: i64 = 0; i < this.cache.length(); i++) {
            if (this.cache[i].triple.as_str() == triple) {
                return this.cache[i].file.as_str();
            }
        }
        return Str::new("");
    }

    /// The stored provenance key for `triple`, or "" if not cached.  Compared
    /// against a freshly computed key (`VendorGenerator::provenance_key`) to
    /// decide a cache hit vs. a regeneration.
    cache_key_for(&this, triple: Str) -> Str {
        for (mut i: i64 = 0; i < this.cache.length(); i++) {
            if (this.cache[i].triple.as_str() == triple) {
                return this.cache[i].key.as_str();
            }
        }
        return Str::new("");
    }

    /// Record (or replace) the bindings file for `triple`.
    set_cache(mut &this, triple: Str, file_path: Str, provenance_key: Str) -> void {
        for (mut i: i64 = 0; i < this.cache.length(); i++) {
            if (this.cache[i].triple.as_str() == triple) {
                this.cache[i].file = String::from_str(file_path);
                this.cache[i].key  = String::from_str(provenance_key);
                return;
            }
        }
        this.cache.push(VendorCacheItem {
            triple: String::from_str(triple),
            file:   String::from_str(file_path),
            key:    String::from_str(provenance_key),
        });
    }
}

/// The whole registry: a flat list of entries (each carries its own key), so
/// no JSON object-key enumeration is needed on read.
type struct VendorRegistry {
    entries: [VendorEntry];

    static empty() -> VendorRegistry {
        return VendorRegistry { entries: [] };
    }

    // Paths

    /// `<cache_root>/vendor`: the vendor subtree of the shared cache.
    static vendor_root() -> PathBuf {
        const root: PathBuf = Cache::cache_root().join("vendor");
        Cache::create_directory(root.as_path());
        return root;
    }

    /// `<vendor_root>/registry.json`.
    static registry_path() -> PathBuf {
        return VendorRegistry::vendor_root().join("registry.json");
    }

    /// `<vendor_root>/<key>/<triple>`: per-(library, triple) cache dir.
    static cache_dir_for(key: Str, triple: Str) -> PathBuf {
        const directory: PathBuf = VendorRegistry::vendor_root().join(key)
            .join(VendorRegistry::normalize_triple(triple));
        Cache::create_directory(directory.as_path());
        return directory;
    }

    /// A host build carries an empty target triple; map it to "host" so it
    /// survives as a path component and matches on the resolve side.
    static normalize_triple(triple: Str) -> Str {
        if (triple.length() == 0) { return Str::new("host"); }
        return triple;
    }

    // Lookup

    /// Index of the entry matching `lib` by import namespace (exact) or by
    /// registry key (case-insensitive), or -1.  The import side uses the
    /// namespace (`vendor::RayLib`); the CLI uses the key (`raylib`).
    find_index(&this, lib: Str) -> i64 {
        for (mut i: i64 = 0; i < this.entries.length(); i++) {
            if (this.entries[i].name.as_str() == lib) { return i; }
        }
        for (mut i: i64 = 0; i < this.entries.length(); i++) {
            if (this.entries[i].key.as_str().equals_case_insensitive(&lib)) { return i; }
        }
        return -1;
    }

    // Mutation

    /// Insert `entry`, replacing any existing entry with the same key.
    upsert(mut &this, entry: VendorEntry) -> void {
        for (mut i: i64 = 0; i < this.entries.length(); i++) {
            if (this.entries[i].key == entry.key) {
                this.entries[i] = entry;
                return;
            }
        }
        this.entries.push(entry);
    }

    /// Remove the entry matching `lib` (by name or key).  Returns true if one
    /// was removed.
    remove(mut &this, lib: Str) -> boolean {
        const idx: i64 = this.find_index(lib);
        if (idx < 0) { return false; }
        return this.remove_at(idx);
    }

    /// Remove the entry at `idx`.  A caller that already knows which entry it
    /// means must delete by index rather than by name: `find_index` resolves a
    /// string against every entry's import namespace before any key, so a key
    /// that collides with another library's namespace would delete that other
    /// library.  Removing shifts the tail down, so a caller deleting several
    /// entries has to walk indices downwards.
    remove_at(mut &this, idx: i64) -> boolean {
        if (idx < 0 || idx >= this.entries.length()) { return false; }
        // `remove` moves the element out and shifts the tail down; binding it
        // lets the owned entry drop at scope exit (no double free).
        const _gone: VendorEntry = this.entries.remove(idx);
        return true;
    }

    // Persistence

    /// Load the global registry, or an empty one if the file is missing or
    /// malformed (a malformed registry must not wedge every build; `cryo
    /// vendor` rewrites it cleanly).
    static load_global() -> VendorRegistry {
        const path: PathBuf = VendorRegistry::registry_path();
        if (!path.as_path().exists()) {
            return VendorRegistry::empty();
        }
        const content: String = match (File::read_text(path.as_path())) {
            Result::Ok(s)  => { s }
            Result::Err(_) => { return VendorRegistry::empty(); }
        };
        mut root: JsonValue = match (parser::parse(content.as_str())) {
            Result::Ok(v)      => { v }
            Result::Err(e)     => { mem::drop(e); return VendorRegistry::empty(); }
        };

        mut reg: VendorRegistry = VendorRegistry::empty();
        match (root.get(Str::new("libraries"))) {
            Option::Some(libs) => {
                const n: i64 = libs.length();
                for (mut i: i64 = 0; i < n; i++) {
                    match (libs.at(i)) {
                        Option::Some(ep) => {
                            reg.entries.push(VendorRegistry::read_entry(ep));
                        }
                        Option::None => { }
                    }
                }
            }
            Option::None => { }
        }
        mem::drop(root);
        return reg;
    }

    /// Serialize and write the registry to its global path.  Returns false on
    /// an I/O failure (reported by the caller).
    ///
    /// The write is ATOMIC: the JSON is written to a pid-unique temp file and
    /// then `rename`d over the real path.  rename() is atomic within a
    /// filesystem, so a concurrent reader (or a crash mid-write) never observes
    /// a half-written registry - it sees either the complete old file or the
    /// complete new one.  This is what keeps `load_global`'s "malformed ->
    /// empty" fallback from being triggered by an interrupted writer, which
    /// would otherwise silently drop every registered library.
    save_global(&this) -> boolean {
        const path: PathBuf = VendorRegistry::registry_path();
        mut root: JsonObject = JsonObject::new();
        root.put("schema_version", JsonValue::integer_value(VENDOR_SCHEMA_VERSION));

        mut libs: Array<JsonValue> = Array::<JsonValue>::new();
        for (mut i: i64 = 0; i < this.entries.length(); i++) {
            libs.push(VendorRegistry::entry_to_json(&this.entries[i]));
        }
        root.put("libraries", JsonValue::Array(libs));

        mut doc: JsonValue = JsonValue::Object(root);
        mut text: String = serializer::stringify_pretty(&doc);
        mem::drop(doc);

        const temporary: String = f"{path.as_path().as_str()}.tmp.{process::id()}";
        text.push_byte(10 as u8);        // trailing newline
        match (File::write_bytes(Path::from(temporary.as_str()), text.as_bytes())) {
            Result::Ok(_)  => {}
            Result::Err(_) => { mem::drop(text); return false; }
        }
        mem::drop(text);
        // `rename_to` replaces an existing registry in one step, so a reader
        // never sees it half written.
        if (Path::from(temporary.as_str()).rename_to(path.as_path()).is_err()) {
            match (File::remove(Path::from(temporary.as_str()))) {
                Result::Ok(_)  => { }
                // A temporary file left behind is never read: its name
                // carries this process's id, and nothing looks for it.
                Result::Err(_) => { }
            }
            return false;
        }
        return true;
    }

    // Link merge

    /// Append `entry`'s link metadata into a project config's link arrays.
    /// Field-for-field; `run_linking` then emits the `-l`/`-L`/archive flags
    /// (and the per-OS overlays) exactly as for a hand-written `[link]`.
    static merge_entry_link(cfg: mut ProjectConfig*, entry: &VendorEntry) -> void {
        for (mut i: i64 = 0; i < entry.link.system.length(); i++) {
            cfg.link_system.push(entry.link.system[i]);
        }
        for (mut i: i64 = 0; i < entry.link.search.length(); i++) {
            cfg.link_search.push(entry.link.search[i]);
        }
        for (mut i: i64 = 0; i < entry.link.static_libs.length(); i++) {
            cfg.link_static.push(entry.link.static_libs[i]);
        }
        for (mut i: i64 = 0; i < entry.link.system_windows.length(); i++) {
            cfg.link_system_windows.push(entry.link.system_windows[i]);
        }
        for (mut i: i64 = 0; i < entry.link.search_windows.length(); i++) {
            cfg.link_search_windows.push(entry.link.search_windows[i]);
        }
        for (mut i: i64 = 0; i < entry.link.static_windows.length(); i++) {
            cfg.link_static_windows.push(entry.link.static_windows[i]);
        }
        for (mut i: i64 = 0; i < entry.link.system_unix.length(); i++) {
            cfg.link_system_unix.push(entry.link.system_unix[i]);
        }
        for (mut i: i64 = 0; i < entry.link.search_unix.length(); i++) {
            cfg.link_search_unix.push(entry.link.search_unix[i]);
        }
        for (mut i: i64 = 0; i < entry.link.static_unix.length(); i++) {
            cfg.link_static_unix.push(entry.link.static_unix[i]);
        }
        // A C++ library pulls in the C++ runtime; auto-add `-lstdc++` so a
        // vendored C++ binding links without the user having to remember it.
        // Needed on BOTH platforms: the Itanium ABI (Linux + the mingw-w64
        // toolchain Cryo targets on Windows) puts class typeinfo / vtables in
        // libstdc++, so a bound class with any virtual member fails to link
        // without it.  Per-OS so each `cc`/`gcc` link gets the flag; a duplicate
        // (user already listed it) is harmless - the linker dedups.
        if (entry.is_cxx()) {
            cfg.link_system_unix.push("stdc++");
            cfg.link_system_windows.push("stdc++");
        }
    }

    // JSON helpers

    /// A string field of a JSON object as an owned String, or `fallback`
    /// when it is absent or not a string.
    static text_field(parent: JsonValue*, key: Str, fallback: Str) -> String {
        match (parent.get(key)) {
            Option::Some(field) => {
                match (field.as::<Str>()) {
                    Option::Some(text) => { return String::from_str(text); }
                    Option::None       => { }
                }
            }
            Option::None => { }
        }
        return String::from_str(fallback);
    }

    /// The string elements of an array field of a JSON object, each owned
    /// (empty when the field is absent; a non-string element is skipped).
    static text_list_field(parent: JsonValue*, key: Str) -> [String] {
        mut out: [String] = [];
        match (parent.get(key)) {
            Option::Some(list) => {
                const n: i64 = list.length();
                for (mut i: i64 = 0; i < n; i++) {
                    match (list.at(i)) {
                        Option::Some(element) => {
                            match (element.as::<Str>()) {
                                Option::Some(text) => { out.push(String::from_str(text)); }
                                Option::None       => { }
                            }
                        }
                        Option::None => { }
                    }
                }
            }
            Option::None => { }
        }
        return out;
    }

    /// `text_list_field` as `string`s for a `VendorLink` array, which the
    /// build's link command reads after the registry is gone (see
    /// `VendorLink`).
    static link_list_field(parent: JsonValue*, key: Str) -> [string] {
        mut owned: [String] = VendorRegistry::text_list_field(parent, key);
        mut out: [string] = [];
        while (owned.length() > 0) {
            out.push(owned.remove(0).into_raw());
        }
        return out;
    }

    /// Parse one library entry object.
    static read_entry(ep: JsonValue*) -> VendorEntry {
        mut entry: VendorEntry = VendorEntry {
            key:            VendorRegistry::text_field(ep, Str::new("key"), Str::new("")),
            name:           VendorRegistry::text_field(ep, Str::new("name"), Str::new("")),
            source_path:    VendorRegistry::text_field(ep, Str::new("source_path"), Str::new("")),
            binding_source: VendorRegistry::text_field(ep, Str::new("binding_source"), Str::new("headers")),
            headers:        VendorRegistry::text_list_field(ep, Str::new("headers")),
            include_dirs:   VendorRegistry::text_list_field(ep, Str::new("include_dirs")),
            defines:        VendorRegistry::text_list_field(ep, Str::new("defines")),
            language:       VendorRegistry::text_field(ep, Str::new("language"), Str::new("")),
            std:            VendorRegistry::text_field(ep, Str::new("std"), Str::new("")),
            link:           VendorLink::empty(),
            cache:          [],
        };
        match (ep.get(Str::new("link"))) {
            Option::Some(lp) => { entry.link = VendorRegistry::read_link(lp); }
            Option::None     => { }
        }
        match (ep.get(Str::new("cache"))) {
            Option::Some(cp) => {
                const n: i64 = cp.length();
                for (mut i: i64 = 0; i < n; i++) {
                    match (cp.at(i)) {
                        Option::Some(itp) => {
                            entry.cache.push(VendorCacheItem {
                                triple: VendorRegistry::text_field(itp, Str::new("triple"), Str::new("")),
                                file:   VendorRegistry::text_field(itp, Str::new("file"), Str::new("")),
                                key:    VendorRegistry::text_field(itp, Str::new("key"), Str::new("")),
                            });
                        }
                        Option::None => { }
                    }
                }
            }
            Option::None => { }
        }
        return entry;
    }

    /// Parse the `link` sub-object.
    static read_link(lp: JsonValue*) -> VendorLink {
        return VendorLink {
            system:          VendorRegistry::link_list_field(lp, Str::new("system")),
            search:          VendorRegistry::link_list_field(lp, Str::new("search")),
            static_libs:     VendorRegistry::link_list_field(lp, Str::new("static")),
            system_windows:  VendorRegistry::link_list_field(lp, Str::new("system_windows")),
            search_windows:  VendorRegistry::link_list_field(lp, Str::new("search_windows")),
            static_windows:  VendorRegistry::link_list_field(lp, Str::new("static_windows")),
            system_unix:     VendorRegistry::link_list_field(lp, Str::new("system_unix")),
            search_unix:     VendorRegistry::link_list_field(lp, Str::new("search_unix")),
            static_unix:     VendorRegistry::link_list_field(lp, Str::new("static_unix")),
        };
    }

    /// Serialize one entry to a JSON value.
    static entry_to_json(entry: &VendorEntry) -> JsonValue {
        mut obj: JsonObject = JsonObject::new();
        obj.put("key",            entry.key.to_json());
        obj.put("name",           entry.name.to_json());
        obj.put("source_path",    entry.source_path.to_json());
        obj.put("binding_source", entry.binding_source.to_json());
        obj.put("headers",        entry.headers.to_json());
        obj.put("include_dirs",   entry.include_dirs.to_json());
        obj.put("defines",        entry.defines.to_json());
        obj.put("language",       entry.language.to_json());
        obj.put("std",            entry.std.to_json());

        mut link: JsonObject = JsonObject::new();
        link.put("system",         JsonValue::string_array(&entry.link.system));
        link.put("search",         JsonValue::string_array(&entry.link.search));
        link.put("static",         JsonValue::string_array(&entry.link.static_libs));
        link.put("system_windows", JsonValue::string_array(&entry.link.system_windows));
        link.put("search_windows", JsonValue::string_array(&entry.link.search_windows));
        link.put("static_windows", JsonValue::string_array(&entry.link.static_windows));
        link.put("system_unix",    JsonValue::string_array(&entry.link.system_unix));
        link.put("search_unix",    JsonValue::string_array(&entry.link.search_unix));
        link.put("static_unix",    JsonValue::string_array(&entry.link.static_unix));
        obj.put("link", JsonValue::Object(link));

        mut cache: Array<JsonValue> = Array::<JsonValue>::new();
        for (mut i: i64 = 0; i < entry.cache.length(); i++) {
            mut c: JsonObject = JsonObject::new();
            c.put("triple", entry.cache[i].triple.to_json());
            c.put("file",   entry.cache[i].file.to_json());
            c.put("key",    entry.cache[i].key.to_json());
            cache.push(JsonValue::Object(c));
        }
        obj.put("cache", JsonValue::Array(cache));

        return JsonValue::Object(obj);
    }
}

/// A best-effort advisory lock over the global registry so that concurrent
/// `cryo vendor` invocations and parallel auto-vendoring builds serialize their
/// load -> mutate -> save instead of racing (the lost-update case: two writers
/// each load the old registry, add a different library, and the second save
/// drops the first's entry).
///
/// It is a plain `O_EXCL` lock file at `<vendor_root>/registry.lock`.  By
/// design it never WEDGES a build: `acquire` spins for a few seconds and, if
/// the lock is still held (a genuinely concurrent writer, or a stale file left
/// by a crashed process), gives up and proceeds UNLOCKED with a warning.  That
/// degraded window is still corruption-safe because `save_global` writes
/// atomically - the worst case is a rare lost update, recovered by re-running.
///
/// No `Drop` impl on purpose (the compiler defines none anywhere, and a
/// stack-scoped destructor across this subsystem's many early-return paths is
/// exactly the move-checker hazard to avoid): callers `acquire` then `release`
/// explicitly, and `release` is idempotent / a no-op on a non-holding handle.
type struct VendorLock {
    path: PathBuf;
    held: boolean;

    /// Take the registry lock, spinning up to ~5s (50 * 100ms).  Always returns
    /// a handle; the caller does not branch on success - it just calls `release`
    /// when the critical section ends (a no-op if the lock was not acquired).
    static acquire() -> VendorLock {
        const lock_path: PathBuf = VendorRegistry::vendor_root().join("registry.lock");
        // `create_new` => O_CREAT|O_EXCL: the open succeeds for exactly one
        // racer (the file's creator) and fails with EEXIST for the rest.  Going
        // through `std::fs::file` keeps the flag values correct on Windows too
        // (the raw `libc::O_*` constants are Linux-only).
        mut opts: OpenOptions = OpenOptions::new();
        opts = opts.write(true).create_new(true);
        for (mut tries: i32 = 0; tries < 50; tries++) {
            match (File::open_with(lock_path.as_path(), &opts)) {
                Result::Ok(fh) => {
                    // The lock token is the file's existence; we don't write to
                    // it.  Close the fd now (the file stays until `release`).
                    mem::drop(fh);
                    return VendorLock { path: lock_path, held: true };
                }
                Result::Err(_) => {
                    // EEXIST (held by another racer) or a transient error: back
                    // off and retry.
                }
            }
            thread::sleep(Duration::from_milliseconds(100));
        }
        fmt::eprint(f"warning: vendor registry lock is held ({lock_path.as_path().as_str()}); proceeding without it.\n         If no other `cryo` is running, this is a stale lock - delete that file.\n");
        return VendorLock { path: lock_path, held: false };
    }

    /// Release the lock if this handle holds it.  Idempotent and safe to call
    /// on a handle returned from a timed-out `acquire`.
    release(mut &this) -> void {
        if (this.held) {
            match (File::remove(this.path.as_path())) {
                Result::Ok(_)      => { }
                Result::Err(error) => {
                    fmt::eprintln(f"warning: cannot remove the vendor registry lock {this.path.as_path().as_str()}: {error}; delete that file before the next `cryo` run waits on it");
                }
            }
            this.held = false;
        }
    }
}
