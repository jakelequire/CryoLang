/// LiteralResolver
///
/// Types literal expressions and answers the literal-shape questions the call /
/// binary resolvers ask.  Integer and float literals are width-polymorphic: when
/// a concrete `expected_type` is in scope they adopt it (with an overflow check);
/// otherwise they fall back to the canonical default width.
///
/// This collaborator owns the *single* literal-default rule.  The width->bound
/// mapping and the default-width selection both live in `Helpers`
/// (`sema_int_unsigned_bound` / `sema_default_int_type`) so there is one source
/// of truth.

namespace Compiler::Sema::LiteralResolver;

import Compiler::Types::TypeRef;
import Compiler::Types::Type;
import Compiler::Types::Arena;
import Compiler::Types::Compound;
import Compiler::Lex;
import Compiler::AST;
import Compiler::AST::Expression;
import Compiler::Diag;
import Compiler::CompilationContext;
import Compiler::Sema::State;
import Compiler::Sema::Helpers;
import std::fmt;
import Compiler::Diag::Diagnostic;
import Compiler::Types;

type struct LiteralResolver {
    arena: TypeArena*;
    ctx:   CompilationContext*;
    state: SemaState*;

    static null() -> LiteralResolver {
        return LiteralResolver { arena: null, ctx: null, state: null };
    }

    wire(mut &this, arena: TypeArena*, ctx: CompilationContext*, state: SemaState*) -> void {
        this.arena = arena;
        this.ctx   = ctx;
        this.state = state;
    }

    /// Type a literal of any kind.
    resolve_literal(&this, lit: LiteralNode*) -> TypeRef {
        return match (lit.literal_kind) {
            LiteralKind::Integer => { this.resolve_integer_literal(lit) }
            LiteralKind::Float   => { this.resolve_float_literal(lit) }
            LiteralKind::String  => { this.arena.get_string() }
            LiteralKind::Char    => { this.arena.get_char() }
            LiteralKind::Boolean => { this.arena.get_bool() }
            LiteralKind::Null    => {
                // Type `null` as `void*` (Pointer to Void) rather than bare Void:
                // the `void* <-> T*` rule in TypeChecker handles assignment to any
                // concrete pointer type without a dedicated `void -> Pointer`
                // widening, preserving null semantics without letting arbitrary
                // void-typed expressions widen.
                this.arena.get_pointer_to(this.arena.get_void())
            }
        };
    }

    /// Type an integer literal.  Adopts an integer `expected_type` (bounds-checked
    /// against its width); otherwise falls back to the default width.
    resolve_integer_literal(&this, lit: LiteralNode*) -> TypeRef {
        // A type suffix names the literal's type outright, so it settles the
        // question before either the expected-type adoption or the magnitude
        // default: `7u64` is a u64 wherever it appears.  The width bound is
        // then checked against what the author wrote rather than against the
        // surrounding context, so `300u8` is caught even in an i32 position.
        // Where the suffix disagrees with the context, the literal keeps its
        // own type and ordinary assignment checking reports the mismatch -
        // previously the suffix was validated by the lexer and then discarded,
        // so a contradiction was silently resolved in the context's favour.
        const suffixed: TypeRef = sema_numeric_suffix_type(this.arena, lit.suffix);
        if (suffixed.is_valid()) {
            const st: Type* = this.arena.lookup(suffixed.id);
            if (st != null && st.kind == TypeKind::Int) {
                const sit: IntType* = st as IntType*;
                const smax: u64 = sema_int_unsigned_bound(sit.int_kind.bit_width());
                if (smax != 0 && int_literal_exceeds(lit.value, smax)) {
                    this.ctx.emit_error_at(
                        ErrorCode::E0010_NUMBER_TOO_LARGE,
                        format("integer literal `%s` is out of range for type `%s`",
                            lit.value, sit.int_kind.to_string()),
                        lit.span);
                }
            }
            this.warn_if_suffix_redundant(lit, suffixed);
            return suffixed;
        }
        if (this.state.expected_type.is_valid()) {
            const exp: Type* = this.arena.lookup(this.state.expected_type.id);
            if (exp != null && exp.kind == TypeKind::Int) {
                const it: IntType* = exp as IntType*;
                // Bound the literal by what fits in the target's bit width (its
                // unsigned max).  Catches genuine overflow (`u8 = 99999999`) while
                // admitting two's-complement bit-pattern initializers up to the
                // width.  128-bit bounds exceed u64, so they are left unchecked
                // (sema_int_unsigned_bound returns 0 there).
                const max_mag: u64 = sema_int_unsigned_bound(it.int_kind.bit_width());
                if (max_mag != 0 && int_literal_exceeds(lit.value, max_mag)) {
                    this.ctx.emit_error_at(
                        ErrorCode::E0010_NUMBER_TOO_LARGE,
                        format("integer literal `%s` is out of range for type `%s`",
                            lit.value, it.int_kind.to_string()),
                        lit.span);
                } else if (max_mag != 0 && it.int_kind.is_signed()) {
                    // The literal fits the width's bit pattern but, for a signed
                    // type, exceeds the representable signed range: a bare
                    // `i8 = 200` stores the two's-complement pattern (-56).  This
                    // is deliberate (bit-pattern initializers up to the width are
                    // admitted), so it is a lint (W0012), not an error.  Threshold
                    // at 2^(w-1) = (max_mag >> 1) + 1 so a valid min-magnitude
                    // negative (`i8 = -128`, whose literal magnitude is 128) is
                    // NOT flagged: only magnitudes strictly beyond 2^(w-1) - which
                    // are representable as neither a positive nor the negative
                    // min - warn.
                    const signed_min_mag: u64 = (max_mag >> 1) + 1;
                    if (int_literal_exceeds(lit.value, signed_min_mag)) {
                        mut diag: Diagnostic = Diagnostic::warning(
                            ErrorCode::W0012_SIGNED_LITERAL_OUT_OF_RANGE,
                            format("integer literal `%s` is outside the range of signed type `%s`; it is stored as its two's-complement bit pattern (wraps to a negative value)",
                                lit.value, it.int_kind.to_string()));
                        diag = diag.at(lit.span);
                        this.ctx.emit_diagnostic(diag);
                    }
                }
                return this.state.expected_type;
            }
            // `char` is a 32-bit unsigned Unicode scalar, so an integer literal
            // in a `char` position adopts `char` the same way one in a `u8`
            // position adopts `u8`.  This is what keeps `buf[n] = 0` (writing a
            // NUL terminator into a `char[]`) cast-free.  Without it the literal
            // falls back to the `i32` default and then has to cross the
            // Char/Int width lattice in `check_compatibility`, which correctly
            // refuses a signed 32-bit value narrowing into an unsigned 32-bit
            // one - turning every NUL terminator into an error.
            if (exp != null && exp.kind == TypeKind::Char) {
                const char_max: u64 = sema_int_unsigned_bound(32);
                if (char_max != 0 && int_literal_exceeds(lit.value, char_max)) {
                    this.ctx.emit_error_at(
                        ErrorCode::E0010_NUMBER_TOO_LARGE,
                        format("integer literal `%s` is out of range for type `char`",
                            lit.value),
                        lit.span);
                }
                return this.state.expected_type;
            }
        }
        // No integer expected-type hint: pick the narrowest default width that
        // holds the literal's magnitude (i32 -> i64 -> u64).
        return sema_default_int_type(this.arena, lit.value);
    }

    /// Type a float literal: a type suffix settles it, else adopt a float
    /// `expected_type`, else default to f64.
    resolve_float_literal(&this, lit: LiteralNode*) -> TypeRef {
        const suffixed: TypeRef = sema_numeric_suffix_type(this.arena, lit.suffix);
        if (suffixed.is_valid()) {
            this.warn_if_suffix_redundant(lit, suffixed);
            return suffixed;
        }
        if (this.state.expected_type.is_valid()) {
            const exp: Type* = this.arena.lookup(this.state.expected_type.id);
            if (exp != null && exp.kind == TypeKind::Float) {
                return this.state.expected_type;
            }
        }
        return this.arena.get_f64();
    }

    /// Warn when a literal's type suffix names exactly the type the literal
    /// would have had anyway, so deleting it is provably behaviour-preserving.
    /// Redundancy is decided by re-running the no-suffix rule (adopt a numeric
    /// expected type, else the width default) and comparing: a suffix is only
    /// reported where the surrounding context already settles the same type.
    /// Where it does NOT - a bare `mut x = 7u64`, or a generic parameter
    /// reachable from no other argument - the suffix is load-bearing and stays
    /// silent.
    warn_if_suffix_redundant(&this, lit: LiteralNode*, suffixed: TypeRef) -> void {
        // Judge only the FIRST resolution. An un-annotated `mut x = 7u64` is
        // typed by resolving its initializer, after which the declaration
        // re-resolves that same literal with the now-known type as the expected
        // type - a context derived FROM this suffix. Comparing against it would
        // call every such suffix redundant and delete the only thing typing the
        // local. On a re-resolution the node already carries its type, which is
        // exactly the signal that the surrounding context is no longer
        // independent of it.
        if (lit.has_resolved_type()) { return; }
        const contextual: TypeRef = this.type_without_suffix(lit);
        if (!contextual.is_valid()) { return; }
        if (contextual.id != suffixed.id) { return; }
        mut diag: Diagnostic = Diagnostic::warning(
            ErrorCode::W0014_REDUNDANT_NUMERIC_SUFFIX,
            format("redundant type suffix `%s` on numeric literal `%s`; the surrounding context already types it",
                lit.suffix, lit.value));
        diag = diag.at(lit.span);
        this.ctx.emit_diagnostic(diag);
    }

    /// The type this literal would take with its suffix removed.
    type_without_suffix(&this, lit: LiteralNode*) -> TypeRef {
        if (lit.literal_kind == LiteralKind::Float) {
            if (this.state.expected_type.is_valid()) {
                const fexp: Type* = this.arena.lookup(this.state.expected_type.id);
                if (fexp != null && fexp.kind == TypeKind::Float) {
                    return this.state.expected_type;
                }
            }
            return this.arena.get_f64();
        }
        if (this.state.expected_type.is_valid()) {
            const exp: Type* = this.arena.lookup(this.state.expected_type.id);
            if (exp != null && (exp.kind == TypeKind::Int || exp.kind == TypeKind::Char)) {
                return this.state.expected_type;
            }
        }
        return sema_default_int_type(this.arena, lit.value);
    }

    /// Whether the current `expected_type` hint is a concrete integer type (so a
    /// literal/constant being resolved would already adopt it).
    expected_type_is_int_type(&this) -> boolean {
        if (!this.state.expected_type.is_valid()) { return false; }
        const e: Type* = this.arena.lookup(this.state.expected_type.id);
        return e != null && e.kind == TypeKind::Int;
    }

    /// Whether an integer-literal argument fits the target integer type's width.
    int_literal_fits_target(&this, arg: ExpressionNode*, target: TypeRef) -> boolean {
        if (!is_numeric_literal_expr(arg)) { return false; }
        const lit: LiteralNode* = arg as LiteralNode*;
        if (lit.literal_kind != LiteralKind::Integer) { return false; }
        const t: Type* = this.arena.lookup(target.id);
        if (t == null || t.kind != TypeKind::Int) { return false; }
        const it: IntType* = t as IntType*;
        const max_mag: u64 = sema_int_unsigned_bound(it.int_kind.bit_width());
        if (max_mag == 0) { return false; }
        return !int_literal_exceeds(lit.value, max_mag);
    }

    /// True when `ty` resolves to a signed integer type.  Decides whether a
    /// negative numeric-literal argument may adopt a parameter's type: a SIGNED
    /// slot is the i64::MIN-width fix; an UNSIGNED slot would turn `-1` huge.
    is_signed_int_type(&this, ty: TypeRef) -> boolean {
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null || t.kind != TypeKind::Int) { return false; }
        return (t as IntType*).int_kind.is_signed();
    }
}
