/// MemberResolver
///
/// Member and index expression resolution: `obj.field` / `obj.0` / `obj.method`
/// (field access, tuple index, method-as-value, field-typed-as-function), `arr[i]`
/// / `tup[0]`, plus the field/method/type visibility enforcement (E0353/E0503).
///
/// `resolve_member_access` / `resolve_array_access` recurse into the receiver via
/// the dispatch seam, so they take `visitor: ASTVisitor*`.  The visibility and
/// template-field helpers are pure callbacks.
///
/// Env (arena/intern/ctx/checker) + peers: state, types (TypeUtils), symbolic
/// (SymbolicChecker), binding (MethodBinding), diag (Diagnostics), dispatch.

namespace Compiler::Sema::MemberResolver;

import Compiler::Types::{
    TypeRef, Type, Arena, Compound, UserDefined, Generic, Checker, Ownership, TypeKind
};
import Compiler::Resolver::{ SymbolStr, InternTable };
import Compiler::AST;
import Compiler::AST::{ Node, Visitor, Expression, Declaration };
import Compiler::Lex;
import Compiler::Diag;
import Compiler::Diag::{ Diagnostic, SourceSpan };
import Compiler::CompilationContext;
import Compiler::ResolveCounter;
import Compiler::Sema::{
    State, TypeUtils, SymbolicChecker, MethodBinding, Diagnostics, Dispatch, Helpers
};
import std::fmt;
import Compiler::Types::GenericRegistry;

type struct MemberResolver {
    arena:    TypeArena*;
    intern:   InternTable*;
    ctx:      CompilationContext*;
    checker:  TypeChecker*;
    state:    SemaState*;
    types:    TypeUtils*;
    symbolic: SymbolicChecker*;
    binding:  MethodBinding*;
    diag:     Diagnostics*;
    dispatch: SemaDispatch*;

    static null() -> MemberResolver {
        return MemberResolver {
            arena: null, intern: null, ctx: null, checker: null, state: null,
            types: null, symbolic: null, binding: null, diag: null, dispatch: null,
        };
    }

    wire(mut &this, arena: TypeArena*, intern: InternTable*, ctx: CompilationContext*,
                    checker: TypeChecker*, state: SemaState*, types: TypeUtils*,
                    symbolic: SymbolicChecker*, binding: MethodBinding*,
                    diag: Diagnostics*, dispatch: SemaDispatch*) -> void {
        this.arena    = arena;
        this.intern   = intern;
        this.ctx      = ctx;
        this.checker  = checker;
        this.state    = state;
        this.types    = types;
        this.symbolic = symbolic;
        this.binding  = binding;
        this.diag     = diag;
        this.dispatch = dispatch;
    }


    // -- Member access (`obj.field` / `obj.0` / `obj.method`) --

    resolve_member_access(mut &this, visitor: ASTVisitor*, member: MemberAccessNode*) -> TypeRef {
        const obj_type: TypeRef = this.dispatch.resolve_expr(visitor, member.object);
        if (!obj_type.is_valid()) { return TypeRef::invalid(); }

        // Access rooted at the abstract generic owner (`this.value` in a `Box<T>`
        // method): resolve the field off the owner template's AST.  Checked BEFORE
        // the unresolved bail (the owner self-instantiation carries abstract params).
        if (this.symbolic.symbolic_is_generic_owner_receiver(obj_type)) {
            const owner_field: TypeRef =
                this.symbolic.symbolic_resolve_owner_field(obj_type, member.member);
            if (owner_field.is_valid()) {
                member.set_resolved_type(owner_field);
                return owner_field;
            }
        }
        // Symbolic walk: a `void`/abstract receiver is unresolved, not fieldless.
        if (this.symbolic.symbolic_type_unresolved(obj_type)) { return TypeRef::invalid(); }

        // Tuple positional access (`t.0`); walks past pointer/reference/inst wrappers.
        mut walk_ty: TypeRef = obj_type;
        mut walk_t: Type* = this.arena.lookup(walk_ty.id);
        mut depth: i32 = 0;
        while (walk_t != null && depth < 5) {
            match (walk_t.kind) {
                TypeKind::Pointer => {
                    walk_ty = (walk_t as PointerType*).pointee;
                    walk_t = this.arena.lookup(walk_ty.id);
                }
                TypeKind::Reference => {
                    walk_ty = (walk_t as ReferenceType*).referent;
                    walk_t = this.arena.lookup(walk_ty.id);
                }
                TypeKind::InstantiatedType => {
                    const it: InstantiatedType* = walk_t as InstantiatedType*;
                    if (!it.has_resolved_type()) { break; }
                    walk_ty = it.resolved_type;
                    walk_t = this.arena.lookup(walk_ty.id);
                }
                _ => { break; }
            }
            depth += 1;
        }
        if (walk_t != null && walk_t.kind == TypeKind::Tuple) {
            const tup: TupleType* = walk_t as TupleType*;
            const member_str: string = this.intern.resolve(member.member);
            const idx: i64 = parse_tuple_index(member_str);
            const m_span: SourceSpan = if (member.member_span.has_location()) {
                member.member_span
            } else {
                member.span
            };
            if (idx < 0) {
                this.ctx.emit_error_at(ErrorCode::E0204_UNDEFINED_FIELD,
                    format("expected a tuple index after `.`, got `%s`", member_str), m_span);
                return TypeRef::invalid();
            }
            if (idx >= tup.elements.length) {
                this.ctx.emit_error_at(ErrorCode::E0204_UNDEFINED_FIELD,
                    format("tuple index %lld is out of bounds for tuple with %lld elements",
                           idx, tup.elements.length), m_span);
                return TypeRef::invalid();
            }
            return tup.elements[idx];
        }

        // Struct/class field access via TypeChecker.
        const result: TypeCheckResult = this.checker.check_field_access(obj_type, member.member);
        if (result.success) {
            const acc_span: SourceSpan = if (member.member_span.has_location()) {
                member.member_span
            } else {
                member.span
            };
            this.enforce_field_visibility(obj_type, member.member, acc_span);
            // Mono-after-sema: substitute the receiver's type_args so a template
            // field types concretely (`.second -> i64`).
            return this.binding.subst_method_return_from_receiver(obj_type, result.result_type);
        }

        // Mono-after-sema: read the field off the generic BASE template's AST and
        // substitute the receiver's type_args (`Pair<u32,i64>` pre-mono).
        const field_ret: TypeRef = this.resolve_field_via_template(obj_type, member.member);
        if (field_ret.is_valid()) { return field_ret; }

        // Symbolic walk: an unwrapped `void`/abstract receiver - defer.
        if (this.symbolic.symbolic_type_unresolved(walk_ty)) { return TypeRef::invalid(); }

        // Method lookup with inheritance, from the *dereferenced* receiver symbol.
        const type_sym: SymbolStr = this.types.lookup_type_sym(walk_ty);
        if (type_sym.is_valid()) {
            const method_ret: TypeRef =
                this.binding.lookup_method_with_inheritance(walk_ty, type_sym, member.member);
            if (method_ret.is_valid()) {
                const acc_span: SourceSpan = if (member.member_span.has_location()) {
                    member.member_span
                } else {
                    member.span
                };
                this.enforce_method_visibility(obj_type, member.member, acc_span,
                    ResolveCounter::Site::MethodVisMember);
                return method_ret;
            }

            // Deref coercion: the receiver has no such field or method, but if it
            // implements `Deref<Target>`, retry the lookup on the pointee - `b.field`
            // / `b.method()` on a `Box<Foo>` becomes `(*b.deref()).field` - repeating
            // while the pointee is itself a `Deref` type (bounded).  Because
            // `*(b.deref())` is a place, coerced access serves reads, writes, and
            // method receivers uniformly, and codegen needs nothing new.
            const coerced: TypeRef = this.try_deref_coercion(visitor, member);
            if (coerced.is_valid()) { return coerced; }

            const type_name: string = this.intern.resolve(type_sym);
            const member_name: string = this.intern.resolve(member.member);
            const m_span: SourceSpan = if (member.member_span.has_location()) {
                member.member_span
            } else {
                member.span
            };
            mut d: Diagnostic = Diagnostic::error(
                ErrorCode::E0204_UNDEFINED_FIELD,
                format("no field or method `%s` on type `%s`", member_name, type_name));
            d = d.at_with_label(m_span, "unknown field or method");
            const cands: string[] = this.diag.collect_struct_or_class_member_names(obj_type);
            d = this.diag.attach_did_you_mean(d, member_name, cands, "field or method", m_span);
            this.ctx.emit_diagnostic(d);
        }

        return TypeRef::invalid();
    }

    /// Deref coercion: `member.object`'s type has no `member.member`.  If it
    /// implements `Deref<Target>`, rewrite the access onto the pointee - 
    /// `obj.member` -> `(*obj.deref()).member` - and retry, repeating while the
    /// pointee is itself a `Deref` type (bounded).  On success `member.object` is
    /// committed to the `*(obj.deref())` chain (a place, so reads / writes /
    /// method receivers all work) and the member's type returned; otherwise the
    /// original `member.object` is left untouched and `invalid` returned.
    /// Restricted to concrete user receivers; a bounded `T: Deref` param is not
    /// coerced (its abstract pointee has no field/method to bind pre-mono).
    try_deref_coercion(mut &this, visitor: ASTVisitor*, member: MemberAccessNode*) -> TypeRef {
        if (member.object == null) { return TypeRef::invalid(); }
        if (this.ctx.generic_registry == null) { return TypeRef::invalid(); }
        const deref_leaf: SymbolStr   = this.intern.intern("Deref");
        const deref_method: SymbolStr = this.intern.intern("deref");
        mut cur_obj: ExpressionNode* = member.object;
        mut cur_ty:  TypeRef         = member.object.resolved_type;
        mut guard: i32 = 0;
        while (guard < 6) {
            guard += 1;
            // Peel references to the concrete receiver; a raw pointer keeps its
            // native field auto-deref and never needs `Deref`.
            mut base_ty: TypeRef = cur_ty;
            mut t: Type* = this.arena.lookup(base_ty.id);
            mut rd: i32 = 0;
            while (t != null && t.kind == TypeKind::Reference && rd < 4) {
                base_ty = (t as ReferenceType*).referent;
                t = this.arena.lookup(base_ty.id);
                rd += 1;
            }
            if (t == null) { return TypeRef::invalid(); }
            const is_user: boolean = t.kind == TypeKind::Struct || t.kind == TypeKind::Class
                                  || t.kind == TypeKind::Enum   || t.kind == TypeKind::InstantiatedType;
            if (!is_user) { return TypeRef::invalid(); }
            const impl_block: ImplBlockNode* = OwnershipQuery::resolve_trait_impl_for_type(
                this.arena, this.ctx.generic_registry, this.intern, deref_leaf, base_ty);
            if (impl_block == null) { return TypeRef::invalid(); }
            // Build `*(cur_obj.deref())` and resolve it to the pointee `Target`.
            const member_acc: MemberAccessNode* =
                new MemberAccessNode(cur_obj, deref_method, member.span, member.span);
            mut call: CallExprNode* = new CallExprNode(member_acc as ExpressionNode*, member.span);
            const star_tok: Token = Token::new(TokenType::Star, "*",
                member.span.start_line as int, member.span.start_col as int);
            mut star: UnaryExprNode* = new UnaryExprNode(star_tok, call as ExpressionNode*, member.span);
            star.is_synthetic = true;
            const star_expr: ExpressionNode* = star as ExpressionNode*;
            const target_ty: TypeRef = this.dispatch.resolve_expr(visitor, star_expr);
            if (!target_ty.is_valid()) { return TypeRef::invalid(); }
            // Re-attempt the field / method lookup on `Target`.
            const r: TypeRef = this.member_type_on(member, target_ty);
            if (r.is_valid()) {
                member.object = star_expr;
                member.set_resolved_type(r);
                return r;
            }
            // Chain deeper: the pointee may itself implement `Deref`.
            cur_obj = star_expr;
            cur_ty  = target_ty;
        }
        return TypeRef::invalid();
    }

    /// Resolve `member.member` as a field (incl. generic-template field) or
    /// method on the ALREADY-RESOLVED receiver type `obj_type`, enforcing
    /// visibility on success.  Returns the member's type, or `invalid` on a
    /// genuine miss - emits no diagnostic.  Used by Deref coercion to probe each
    /// pointee in the chain without perturbing the direct-access path.
    member_type_on(mut &this, member: MemberAccessNode*, obj_type: TypeRef) -> TypeRef {
        const acc_span: SourceSpan = if (member.member_span.has_location()) {
            member.member_span
        } else {
            member.span
        };
        // Field.
        const result: TypeCheckResult = this.checker.check_field_access(obj_type, member.member);
        if (result.success) {
            this.enforce_field_visibility(obj_type, member.member, acc_span);
            return this.binding.subst_method_return_from_receiver(obj_type, result.result_type);
        }
        // Generic base-template field.
        const field_ret: TypeRef = this.resolve_field_via_template(obj_type, member.member);
        if (field_ret.is_valid()) { return field_ret; }
        // Method (from the dereferenced receiver symbol).
        mut walk_ty: TypeRef = obj_type;
        mut walk_t: Type* = this.arena.lookup(walk_ty.id);
        mut depth: i32 = 0;
        while (walk_t != null && depth < 5) {
            match (walk_t.kind) {
                TypeKind::Pointer => {
                    walk_ty = (walk_t as PointerType*).pointee;
                    walk_t = this.arena.lookup(walk_ty.id);
                }
                TypeKind::Reference => {
                    walk_ty = (walk_t as ReferenceType*).referent;
                    walk_t = this.arena.lookup(walk_ty.id);
                }
                TypeKind::InstantiatedType => {
                    const it: InstantiatedType* = walk_t as InstantiatedType*;
                    if (!it.has_resolved_type()) { break; }
                    walk_ty = it.resolved_type;
                    walk_t = this.arena.lookup(walk_ty.id);
                }
                _ => { break; }
            }
            depth += 1;
        }
        const type_sym: SymbolStr = this.types.lookup_type_sym(walk_ty);
        if (type_sym.is_valid()) {
            const method_ret: TypeRef =
                this.binding.lookup_method_with_inheritance(walk_ty, type_sym, member.member);
            if (method_ret.is_valid()) {
                this.enforce_method_visibility(obj_type, member.member, acc_span,
                    ResolveCounter::Site::MethodVisMember);
                return method_ret;
            }
        }
        return TypeRef::invalid();
    }

    /// Mono-after-sema: resolve a FIELD off the generic BASE template's AST when
    /// the receiver is an unresolved generic instantiation, substituting type_args.
    resolve_field_via_template(mut &this, recv_type: TypeRef, field: SymbolStr) -> TypeRef {
        if (this.ctx.generic_registry == null) { return TypeRef::invalid(); }
        const inst: InstantiatedType* = this.types.peel_to_instantiation(recv_type);
        if (inst == null) { return TypeRef::invalid(); }
        const tmpl: TemplateEntry* =
            this.ctx.generic_registry.get_template_by_type_id(inst.generic_base.id);
        if (tmpl == null || tmpl.ast_node == null) { return TypeRef::invalid(); }
        mut abstract_field: TypeRef = TypeRef::invalid();
        if (tmpl.node_kind == NodeKind::StructDeclaration) {
            const sn: StructDeclNode* = tmpl.ast_node as StructDeclNode*;
            for (mut i: i64 = 0; i < sn.fields.length; i++) {
                const f: FieldDeclNode* = sn.fields[i];
                if (f != null && f.name.equals(field) && f.resolved_type.is_valid()) {
                    abstract_field = f.resolved_type;
                    break;
                }
            }
        } else if (tmpl.node_kind == NodeKind::UnionDeclaration) {
            const un: UnionDeclNode* = tmpl.ast_node as UnionDeclNode*;
            for (mut i: i64 = 0; i < un.fields.length; i++) {
                const f: FieldDeclNode* = un.fields[i];
                if (f != null && f.name.equals(field) && f.resolved_type.is_valid()) {
                    abstract_field = f.resolved_type;
                    break;
                }
            }
        } else if (tmpl.node_kind == NodeKind::ClassDeclaration) {
            const cn: ClassDeclNode* = tmpl.ast_node as ClassDeclNode*;
            for (mut i: i64 = 0; i < cn.fields.length; i++) {
                const f: FieldDeclNode* = cn.fields[i];
                if (f != null && f.name.equals(field) && f.resolved_type.is_valid()) {
                    abstract_field = f.resolved_type;
                    break;
                }
            }
        } else {
            return TypeRef::invalid();
        }
        if (!abstract_field.is_valid()) { return TypeRef::invalid(); }
        return this.binding.subst_method_return_from_receiver(recv_type, abstract_field);
    }

    /// If `field_name` on `obj_type` is a Function-typed field, tag the member with
    /// that type (so codegen emits an indirect call) and return its return type.
    try_field_function_call(&this, obj_type: TypeRef, field_name: SymbolStr,
                            member: MemberAccessNode*) -> TypeRef {
        const t: Type* = this.arena.lookup(obj_type.id);
        if (t == null) { return TypeRef::invalid(); }
        mut check_t: Type* = t;
        if (check_t.kind == TypeKind::Reference) {
            check_t = this.arena.lookup((check_t as ReferenceType*).referent.id);
            if (check_t == null) { return TypeRef::invalid(); }
        }
        if (check_t.kind == TypeKind::Struct) {
            const st: StructType* = check_t as StructType*;
            for (mut i: i64 = 0; i < st.fields.length; i++) {
                if (st.fields[i].name.id == field_name.id) {
                    const f_type: TypeRef = st.fields[i].field_type;
                    const ft: Type* = this.arena.lookup(f_type.id);
                    if (ft != null && ft.kind == TypeKind::Function) {
                        if (member != null) { member.set_resolved_type(f_type); }
                        return (ft as FunctionType*).return_type;
                    }
                    return TypeRef::invalid();
                }
            }
        } else if (check_t.kind == TypeKind::Class) {
            const ct: ClassType* = check_t as ClassType*;
            for (mut i: i64 = 0; i < ct.fields.length; i++) {
                if (ct.fields[i].name.id == field_name.id) {
                    const f_type: TypeRef = ct.fields[i].field_type;
                    const ft: Type* = this.arena.lookup(f_type.id);
                    if (ft != null && ft.kind == TypeKind::Function) {
                        if (member != null) { member.set_resolved_type(f_type); }
                        return (ft as FunctionType*).return_type;
                    }
                    return TypeRef::invalid();
                }
            }
        }
        return TypeRef::invalid();
    }


    // -- Index access (`arr[i]` / `tup[0]`) --

    resolve_array_access(mut &this, visitor: ASTVisitor*, access: ArrayAccessNode*) -> TypeRef {
        // Idempotent: a prior resolution may have rewritten `a[i]` into
        // `*(a.index(i))`.  Return its type without re-running
        // `check_index_access` (which would re-reject the user-typed base and
        // re-emit a spurious error on the post-monomorphization verify pass).
        if (access.desugared_call != null) { return access.desugared_call.resolved_type; }
        const array_type: TypeRef = this.dispatch.resolve_expr(visitor, access.array);
        const index_type: TypeRef = this.dispatch.resolve_expr(visitor, access.index);
        if (!array_type.is_valid()) { return TypeRef::invalid(); }
        if (this.symbolic.symbolic_type_unresolved(array_type)) { return TypeRef::invalid(); }

        // Tuple bracket indexing (`t[0]`): compile-time bounds-checked integer.
        mut walk_ty: TypeRef = array_type;
        mut walk_t: Type* = this.arena.lookup(walk_ty.id);
        mut depth: i32 = 0;
        while (walk_t != null && depth < 5) {
            if (walk_t.kind == TypeKind::Pointer) {
                walk_ty = (walk_t as PointerType*).pointee;
                walk_t = this.arena.lookup(walk_ty.id);
            } else if (walk_t.kind == TypeKind::Reference) {
                walk_ty = (walk_t as ReferenceType*).referent;
                walk_t = this.arena.lookup(walk_ty.id);
            } else if (walk_t.kind == TypeKind::InstantiatedType) {
                const it: InstantiatedType* = walk_t as InstantiatedType*;
                if (!it.has_resolved_type()) { break; }
                walk_ty = it.resolved_type;
                walk_t = this.arena.lookup(walk_ty.id);
            } else {
                break;
            }
            depth += 1;
        }
        if (walk_t != null && walk_t.kind == TypeKind::Tuple) {
            const tup: TupleType* = walk_t as TupleType*;
            const idx: i64 = sema_const_int_index(access.index);
            if (idx < 0) {
                this.ctx.emit_error_at(ErrorCode::E0200_TYPE_MISMATCH,
                    "tuple index must be a non-negative integer literal; runtime indices are not supported on tuples",
                    access.span);
                return TypeRef::invalid();
            }
            if (idx >= tup.elements.length) {
                this.ctx.emit_error_at(ErrorCode::E0204_UNDEFINED_FIELD,
                    format("tuple index %lld is out of bounds for tuple with %lld elements",
                           idx, tup.elements.length), access.span);
                return TypeRef::invalid();
            }
            return tup.elements[idx];
        }

        const result: TypeCheckResult = this.checker.check_index_access(array_type, index_type);
        if (result.success) { return result.result_type; }

        // Index operator overloading: `check_index_access` rejected a base with
        // no primitive indexing rule.  A concrete user aggregate (or a generic
        // param bounded by `Index`) that implements `Index<Idx, Output>` rewrites
        // `a[i]` into `*(a.index(i))` - the deref of the returned `Output*` is a
        // place, so the one desugar serves read / write / compound assignment.
        // Arrays, slices, strings, pointers, pointer-to-array, and references
        // all succeed above and never reach here, so the hot indexing path stays
        // byte-identical.
        const de: ExpressionNode* = this.try_index_overload(visitor, access, array_type);
        if (de != null) {
            access.desugared_call = de;
            return de.resolved_type;
        }
        if (this.emit_index_missing_impl(array_type, access.span)) {
            return TypeRef::invalid();
        }
        if (result.error_message != null && result.error_message.length() > 0) {
            this.ctx.emit_error_at(ErrorCode::E0200_TYPE_MISMATCH, result.error_message, access.span);
        }
        return TypeRef::invalid();
    }

    /// Build + resolve the index desugar `*(a.index(i))` when the base type
    /// `ty` overloads `[]`: a concrete user aggregate
    /// (Struct/Class/Enum/InstantiatedType) with a registered `Index` impl, or
    /// a generic param bounded by `Index`.  Returns the resolved desugar
    /// expression (its `resolved_type` is the element type = the deref of the
    /// method's `Output*`) for the caller to stash, or null when no overload
    /// applies.  Deliberately does NOT unwrap pointers / references: a raw
    /// pointer or `&T` keeps its primitive indexing rule (which already
    /// succeeded in `check_index_access`), mirroring the arithmetic desugar.
    try_index_overload(mut &this, visitor: ASTVisitor*, access: ArrayAccessNode*,
                       ty: TypeRef) -> ExpressionNode* {
        mut base_ty: TypeRef = ty;
        mut t: Type* = this.arena.lookup(base_ty.id);
        if (t == null) { return null; }
        // Auto-deref a reference base (`&Vec`): `check_index_access` on a
        // reference recurses to the referent and fails for a user Index type, so
        // a by-reference container reaches here typed as `Reference`.  Unwrap it
        // (indexing a reference has no primitive rule that could be perturbed) so
        // `v[i]` on a `&T` parameter overloads exactly like on a value - the
        // method call auto-derefs the receiver.  Raw pointers are left alone:
        // `Vec*[i]` keeps its C pointer-arithmetic meaning (which already
        // succeeded in `check_index_access` and never reaches here).
        mut rdepth: i32 = 0;
        while (t != null && t.kind == TypeKind::Reference && rdepth < 4) {
            base_ty = (t as ReferenceType*).referent;
            t = this.arena.lookup(base_ty.id);
            rdepth += 1;
        }
        if (t == null) { return null; }
        const index_leaf: SymbolStr = this.intern.intern("Index");
        mut overloads: boolean = false;
        if (t.kind == TypeKind::BoundedParam) {
            overloads = this.bounded_param_has_index(t as BoundedParamType*, index_leaf);
        } else if (t.kind == TypeKind::Struct || t.kind == TypeKind::Class
                || t.kind == TypeKind::Enum || t.kind == TypeKind::InstantiatedType) {
            const impl_block: ImplBlockNode* = OwnershipQuery::resolve_trait_impl_for_type(
                this.arena, this.ctx.generic_registry, this.intern, index_leaf, base_ty);
            overloads = impl_block != null;
        } else {
            return null;
        }
        if (!overloads) { return null; }

        // Build `*(a.index(i))`.  The index expression is passed BY VALUE - the
        // trait is `index(&this, idx: Idx)`, not `&Idx` - so no synthetic `&`.
        const index_method: SymbolStr = this.intern.intern("index");
        const member: MemberAccessNode* =
            new MemberAccessNode(access.array, index_method, access.span, access.span);
        mut call: CallExprNode* = new CallExprNode(member as ExpressionNode*, access.span);
        call.add_argument(access.index);
        const star_tok: Token = Token::new(TokenType::Star, "*",
            access.span.start_line as int, access.span.start_col as int);
        mut deref: UnaryExprNode* = new UnaryExprNode(star_tok, call as ExpressionNode*, access.span);
        deref.is_synthetic = true;
        const de: ExpressionNode* = deref as ExpressionNode*;
        const rty: TypeRef = this.dispatch.resolve_expr(visitor, de);
        if (!rty.is_valid()) { return null; }
        return de;
    }

    /// True when a generic `BoundedParam`'s bounds (or their super-traits, to
    /// bounded depth) name the `Index` trait, so `a[i]` on that param overloads.
    bounded_param_has_index(&this, bp: BoundedParamType*, index_leaf: SymbolStr) -> boolean {
        for (mut i: i64 = 0; i < bp.bounds.length; i++) {
            if (this.trait_bound_names(bp.bounds[i], index_leaf, 0)) { return true; }
        }
        return false;
    }

    /// True when `bound` resolves to a `TraitType` whose leaf is `leaf`, or
    /// (transitively, to bounded depth) one of its super-traits is.
    trait_bound_names(&this, bound: TypeRef, leaf: SymbolStr, depth: i32) -> boolean {
        if (depth > 4) { return false; }
        const bt: Type* = this.arena.lookup(bound.id);
        if (bt == null || bt.kind != TypeKind::Trait) { return false; }
        const tt: TraitType* = bt as TraitType*;
        const bl: SymbolStr = OwnershipQuery::leaf_segment(this.intern, tt.qualified_name);
        if (bl.is_valid() && bl.equals(leaf)) { return true; }
        for (mut i: i64 = 0; i < tt.super_traits.length; i++) {
            if (this.trait_bound_names(tt.super_traits[i], leaf, depth + 1)) { return true; }
        }
        return false;
    }

    /// When `[]` hits a user type lacking an `Index` impl, emit a diagnostic that
    /// names the missing trait instead of the generic "cannot index".  Returns
    /// true when it emitted (caller skips the fallback); false for non-user bases
    /// (a genuine primitive index error keeps its original message).
    emit_index_missing_impl(mut &this, ty: TypeRef, span: SourceSpan) -> boolean {
        mut t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return false; }
        // Look through references so `&UserType` (a by-reference container that
        // still lacks an `Index` impl) gets the trait-naming diagnostic too.
        mut rdepth: i32 = 0;
        while (t != null && t.kind == TypeKind::Reference && rdepth < 4) {
            t = this.arena.lookup((t as ReferenceType*).referent.id);
            rdepth += 1;
        }
        if (t == null) { return false; }
        const is_user: boolean = t.kind == TypeKind::Struct || t.kind == TypeKind::Class
                              || t.kind == TypeKind::Enum || t.kind == TypeKind::InstantiatedType;
        if (!is_user) { return false; }
        const name: string = this.arena.format_display(t);
        this.ctx.emit_error_at(ErrorCode::E0200_TYPE_MISMATCH,
            format("`%s` cannot be indexed with `[]`; add `implement trait Index<Idx, Output> ... for %s` (its `index` must return `Output*`)",
                name, name), span);
        return true;
    }


    // -- Visibility enforcement --

    /// True when `candidate` is `ancestor_id` or descends from it through the
    /// class base chain (depth-guarded).  Permits `protected` access from subclasses.
    is_subclass_of(mut &this, candidate: Type*, ancestor_id: u64) -> boolean {
        mut cur: Type* = candidate;
        mut depth: i32 = 0;
        while (cur != null && depth < 32) {
            if (cur.id == ancestor_id) { return true; }
            if (cur.kind != TypeKind::Class) { return false; }
            const cc: ClassType* = cur as ClassType*;
            if (cc.has_base && cc.base_class.is_valid()) {
                cur = this.arena.lookup(cc.base_class.id);
            } else {
                return false;
            }
            depth += 1;
        }
        return false;
    }

    /// The type whose method body a generated `async` future carries, or null
    /// when `owner` is not such a future.
    ///
    /// Lowering an `async` METHOD moves its statements verbatim into the `poll`
    /// of a synthesized future struct.  From that point the enclosing type is the
    /// future rather than the method's owner, so a body that reads its own type's
    /// private fields would be judged an outsider (E0353) - even though nothing
    /// about it left the type, and the very same statements passed the check
    /// before lowering.  Granting the future its origin's access is what keeps
    /// `async` from being a visibility downgrade.
    ///
    /// The origin is read off the receiver slot the future stores it in, named
    /// `this$recv`.  `$` cannot appear in a source identifier, so no
    /// user-written struct can claim this; and a free `async function`'s future
    /// has no receiver slot, so it inherits nothing.
    async_origin_owner(&this, owner: TypeRef) -> Type* {
        mut t: Type* = this.arena.lookup(owner.id);
        if (t != null && t.kind != TypeKind::Struct) {
            // A future generic in its owner arrives as an `InstantiatedType`
            // whose fields specialization has not filled in yet; the template it
            // came from is what carries the slot.
            const base: TypeRef = this.arena.inst_generic_base(owner);
            t = if (base.is_valid()) { this.arena.lookup(base.id) } else { null };
        }
        if (t == null || t.kind != TypeKind::Struct) { return null; }
        const st: StructType* = t as StructType*;
        const recv: FieldInfo* = st.get_field(this.intern.intern("this$recv"));
        if (recv == null) { return null; }
        // The slot is a pointer for a `&this` receiver and the owner by value
        // otherwise; either way this peels to the owner itself.
        return this.types.unwrap_to_base_type(recv.field_type);
    }

    /// Emit E0353 when a private/protected field is accessed outside its declaring
    /// type (allowing `protected` from subclasses).  No-op for public/non-aggregate.
    enforce_field_visibility(mut &this, recv_type: TypeRef,
                             field_name: SymbolStr, span: SourceSpan) -> void {
        const base: Type* = this.types.unwrap_to_base_type(recv_type);
        if (base == null) { return; }

        mut field: FieldInfo* = null;
        mut declaring_t: Type* = null;
        mut declaring_name: string = "";

        if (base.kind == TypeKind::Struct) {
            mut st: StructType* = base as StructType*;
            field = st.get_field(field_name);
            if (field != null) { declaring_t = base; declaring_name = st.display_name(); }
        } else if (base.kind == TypeKind::Class) {
            mut current: ClassType* = base as ClassType*;
            while (current != null) {
                field = current.get_field(field_name);
                if (field != null) {
                    declaring_t = current as Type*;
                    declaring_name = current.display_name();
                    break;
                }
                if (current.has_base && current.base_class.is_valid()) {
                    const parent_t: Type* = this.arena.lookup(current.base_class.id);
                    if (parent_t != null && parent_t.kind == TypeKind::Class) {
                        current = parent_t as ClassType*;
                    } else {
                        current = null;
                    }
                } else {
                    current = null;
                }
            }
        }

        if (field == null) { return; }
        if (field.is_public) { return; }

        if (this.state.current_owner_type.is_valid()) {
            const owner: Type* = this.types.unwrap_to_base_type(this.state.current_owner_type);
            if (owner != null && declaring_t != null) {
                if (owner.id == declaring_t.id) { return; }
                if (field.is_protected && this.is_subclass_of(owner, declaring_t.id)) { return; }
            }
            const origin: Type* = this.async_origin_owner(this.state.current_owner_type);
            if (origin != null && declaring_t != null) {
                if (origin.id == declaring_t.id) { return; }
                if (field.is_protected && this.is_subclass_of(origin, declaring_t.id)) { return; }
            }
        }

        const vis_word: string = if (field.is_protected) { "protected" } else { "private" };
        const field_str: string = this.intern.resolve(field_name);
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0353_PRIVATE_ACCESS,
            format("field `%s` of `%s` is %s", field_str, declaring_name, vis_word));
        d = d.at_with_label(span, format("%s field accessed outside `%s`", vis_word, declaring_name));
        this.ctx.emit_diagnostic(d);
    }

    /// Method-call counterpart to `enforce_field_visibility` (E0353).
    ///
    /// `door` records WHICH lane offered the method, because a gate that cannot
    /// say which lane it caught cannot show that the lane a corpus entry was
    /// written for is the lane that fired.  The static lane reached this
    /// function through no path at all until it was given a door: every caller
    /// was a member access, so `Type::method()` crossed module boundaries and
    /// executed.
    enforce_method_visibility(mut &this, recv_type: TypeRef,
                              method_name: SymbolStr, span: SourceSpan,
                              door: ResolveCounter::Site) -> void {
        const base: Type* = this.types.unwrap_to_base_type(recv_type);
        if (base == null) { return; }

        mut method: MethodInfo* = null;
        mut declaring_t: Type* = null;
        mut declaring_name: string = "";

        if (base.kind == TypeKind::Struct) {
            mut st: StructType* = base as StructType*;
            method = st.get_method(method_name);
            if (method != null) { declaring_t = base; declaring_name = st.display_name(); }
        } else if (base.kind == TypeKind::Class) {
            mut current: ClassType* = base as ClassType*;
            while (current != null) {
                method = current.get_method(method_name);
                if (method != null) {
                    declaring_t = current as Type*;
                    declaring_name = current.display_name();
                    break;
                }
                if (current.has_base && current.base_class.is_valid()) {
                    const parent_t: Type* = this.arena.lookup(current.base_class.id);
                    if (parent_t != null && parent_t.kind == TypeKind::Class) {
                        current = parent_t as ClassType*;
                    } else {
                        current = null;
                    }
                } else {
                    current = null;
                }
            }
        }

        if (method == null) { return; }
        if (method.is_public) { return; }

        if (this.state.current_owner_type.is_valid()) {
            const owner: Type* = this.types.unwrap_to_base_type(this.state.current_owner_type);
            if (owner != null && declaring_t != null) {
                if (owner.id == declaring_t.id) { return; }
                if (method.is_protected && this.is_subclass_of(owner, declaring_t.id)) { return; }
            }
            const origin: Type* = this.async_origin_owner(this.state.current_owner_type);
            if (origin != null && declaring_t != null) {
                if (origin.id == declaring_t.id) { return; }
                if (method.is_protected && this.is_subclass_of(origin, declaring_t.id)) { return; }
            }
        }

        ResolveCounter::Site::MethodVisReject.bump();
        door.bump();
        const vis_word: string = if (method.is_protected) { "protected" } else { "private" };
        const method_str: string = this.intern.resolve(method_name);
        ResolveCounter::vis_gate_reject(door.label(),
            this.current_module_name(), format("%s::%s", declaring_name, method_str));
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0353_PRIVATE_ACCESS,
            format("method `%s` of `%s` is %s", method_str, declaring_name, vis_word));
        d = d.at_with_label(span, format("%s method called outside `%s`", vis_word, declaring_name));
        this.ctx.emit_diagnostic(d);
    }

    /// Module identity for the code currently being checked.
    current_module_name(&this) -> string {
        if (this.ctx.has_namespace()) { return this.ctx.namespace_display(); }
        return this.ctx.source_file;
    }

    /// Reject a user-written reference to a cross-module `private` type (E0503).
    ///
    /// Asks the RESOLVED QUALIFIED SYMBOL, and asks it from the module that
    /// WROTE the name.  Both halves are load-bearing, and each replaces a
    /// decision that was keyed on the bare leaf:
    ///
    ///   - a leaf-keyed question is "is any `Hidden` anywhere public?", which
    ///     one unrelated module declaring a public `Hidden` answers yes - so a
    ///     module the use site never imports could switch this error off for a
    ///     private type in a module it does.  A per-symbol verdict cannot be
    ///     masked by a declaration the name does not resolve to.
    ///   - the use site used to come from the ambient cursor, which is parked on
    ///     whichever module is being processed rather than on the one that wrote
    ///     the syntax.  A verdict computed against it describes the walk.
    ///
    /// Refuses to judge when the span names no module: an invalid namespace
    /// compares unequal to every real one, so judging against it would read
    /// "I don't know where this was written" as "written somewhere else" and
    /// reject everything - the false-positive direction, which is the one that
    /// costs.
    check_type_name_visibility(mut &this, name: SymbolStr, span: SourceSpan) -> void {
        if (this.state.in_symbolic_check) { return; }
        if (this.ctx == null || this.ctx.decl_index == null) { return; }
        const use_ns: SymbolStr = this.ctx.module_ns_sym_of_file(span.file);
        if (!use_ns.is_valid()) { return; }
        const q: SymbolStr = this.ctx.resolve_scoped_or_at(name, span.file, FILE, LINE);
        const owner_ns: SymbolStr = this.ctx.decl_index.namespace_of(q, this.intern);
        if (!owner_ns.is_valid()) { return; }
        // A module always sees its own types, public or not.
        if (owner_ns.id == use_ns.id) { return; }
        if (this.ctx.decl_index.is_candidate_public(q)) { return; }
        const owner: string = this.intern.resolve(owner_ns);
        const leaf_str: string =
            this.intern.resolve(OwnershipQuery::leaf_segment(this.intern, q));
        ResolveCounter::vis_gate_reject("type name", this.intern.resolve(use_ns),
            this.intern.resolve(q));
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0503_PRIVATE_SYMBOL_ACCESS,
            format("type `%s` is private to module `%s`", leaf_str, owner));
        d = d.at_with_label(span,
            format("`%s` cannot be named outside its module `%s`", leaf_str, owner));
        this.ctx.emit_diagnostic(d);
    }

    /// Walk a user-written type annotation, checking every `Named` leaf for
    /// cross-module private access.  Skips `pre_resolved` leaves (mangled specs).
    check_annotation_visibility(mut &this, ann: TypeAnnotation*) -> void {
        if (ann == null) { return; }
        match (*ann) {
            TypeAnnotation::Named(n) => {
                if (n.pre_resolved.is_valid()) { return; }
                this.check_type_name_visibility(n.name, n.span);
            }
            TypeAnnotation::Generic(g) => {
                this.check_annotation_visibility(g.base);
                for (mut i: i64 = 0; i < g.args.length; i++) {
                    this.check_annotation_visibility(g.args[i]);
                }
            }
            TypeAnnotation::Pointer(p)   => { this.check_annotation_visibility(p.inner); }
            TypeAnnotation::Reference(r)  => { this.check_annotation_visibility(r.inner); }
            TypeAnnotation::Array(a)     => { this.check_annotation_visibility(a.element); }
            TypeAnnotation::Tuple(t)     => {
                for (mut i: i64 = 0; i < t.elements.length; i++) {
                    this.check_annotation_visibility(t.elements[i]);
                }
            }
            TypeAnnotation::Function(f)  => {
                this.check_annotation_visibility(f.return_type);
                for (mut i: i64 = 0; i < f.parameters.length; i++) {
                    this.check_annotation_visibility(f.parameters[i]);
                }
            }
            TypeAnnotation::ImplTrait(imp) => {
                for (mut i: i64 = 0; i < imp.bounds.length; i++) {
                    this.check_annotation_visibility(imp.bounds[i]);
                }
            }
            _ => {}
        }
    }
}
