/// MemberResolver
///
/// Member and index expression resolution: `obj.field` / `obj.0` / `obj.method`
/// (field access, tuple index, method-as-value, field-typed-as-function), `arr[i]`
/// / `tup[0]`, plus the field/method/type visibility enforcement (E0353/E0503).
///
/// `resolve_member_access` / `resolve_array_access` recurse into the receiver via
/// the dispatch seam, so they take `visitor: SemaVisitor*`.  The visibility and
/// template-field helpers are pure callbacks.
///
/// Env (arena/intern/ctx/checker) + peers: state, types (TypeUtils), symbolic
/// (SymbolicChecker), binding (MethodBinding), diag (Diagnostics), dispatch.

namespace compiler::sema::member_resolver;

import compiler::types::{
    type_ref, type_base, arena, compound, user_defined, generic, checker, ownership, trait_checker, TypeKind
};
import compiler::resolver::{ symbol_str, intern_table };
import compiler::ast;
import compiler::ast::{ declaration, expression, MemberPin, node, TypeAnnotation, Visibility };
import compiler::lex;
import compiler::lex::{ Token, TokenType };
import compiler::diag;
import compiler::diag::{ diagnostic, ErrorCode, source_span, suggestion };
import compiler::compilation_context;
import compiler::compilation_context::{ CompilationContext };
import compiler::sema::{
    state, type_utils, symbolic_checker, method_binding, diagnostics, helpers
};
import std::fmt;
import compiler::types::generic_registry;
import compiler::types::generic_registry::{ GenericRegistry, TemplateEntry, TemplateKind };
import compiler::resolver::lang_item;
import compiler::resolver::lang_item::{ LangItem };
import compiler::ast::declaration::{
    DeclarationNode, FieldDecl, FunctionDecl, ImplBlock, MethodDecl, StructDecl, UnionDecl
};
import compiler::ast::expression::{
    ArrayAccessExpr, CallExpr, ExpressionNode, MemberAccessExpr
};
import compiler::sema::sema;
import compiler::sema::sema::{ SemaVisitor };
import compiler::diag::diagnostic::{ Diagnostic };
import compiler::diag::source_span::{ SourceSpan };
import compiler::diag::suggestion::{ Applicability, Suggestion };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::res::{ DefId, FamilyOwner };
import compiler::decl_index::{ OverloadId };
import compiler::module_graph;
import compiler::module_graph::{ ModulePath };
import compiler::sema::diagnostics::{ Diagnostics };
import compiler::sema::helpers::{ parse_tuple_index, sema_const_int_index };
import compiler::sema::method_binding::{ MethodBinding };
import compiler::sema::state::{ SemaState };
import compiler::sema::symbolic_checker::{ SymbolicChecker };
import compiler::sema::type_utils::{ TypeUtils };
import compiler::types::arena::{ TypeArena };
import compiler::types::checker::{ TypeChecker, TypeCheckResult };
import compiler::types::compound::{ ArrayType, FunctionType, PointerType, ReferenceType, TupleType };
import compiler::types::generic::{ GenericParamType, InstantiatedType };
import compiler::types::trait_checker::{ TraitChecker };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };
import compiler::types::user_defined::{
    FieldInfo, MethodInfo, StructType, TraitType
};

/// A field as the member door found it: its type as seen through the
/// receiver, and its `index` in the owner's field list, for the access to
/// be pinned to.  `visibility` and `declared_in` are what the visibility
/// check asks, read off the arena entry or, for a field of a generic
/// template, off its declaration: one answer whichever the door read, so a
/// template's private field is as private as a concrete type's.  `owner`
/// is the type declaring it, for the diagnostic.  `index` is -1 for an
/// array's `length`, which has a type and no slot and is public.
type struct FieldAnswer {
    ty:          TypeRef;
    visibility:  Visibility;
    declared_in: ModulePath;
    owner:       Type*;
    index:       i64;

    static none() -> FieldAnswer {
        return FieldAnswer { ty: TypeRef::invalid(), visibility: Visibility::Public, declared_in: ModulePath::none(),
                             owner: null, index: -1 };
    }

    found(&this) -> boolean { return this.ty.is_valid(); }
}

type struct MemberResolver {
    arena:    TypeArena*;
    intern:   InternTable*;
    ctx:      CompilationContext*;
    checker:  TypeChecker*;
    state:    SemaState*;
    types:    TypeUtils*;
    symbolic: SymbolicChecker*;
    binding:  MethodBinding*;
    diag:     Diagnostics*;

    static null() -> MemberResolver {
        return MemberResolver {
            arena: null, intern: null, ctx: null, checker: null, state: null,
            types: null, symbolic: null, binding: null, diag: null,
        };
    }

    wire(mut &this, arena: TypeArena*, intern: InternTable*, ctx: CompilationContext*,
                    checker: TypeChecker*, state: SemaState*, types: TypeUtils*,
                    symbolic: SymbolicChecker*, binding: MethodBinding*,
                    diag: Diagnostics*) -> void {
        this.arena    = arena;
        this.intern   = intern;
        this.ctx      = ctx;
        this.checker  = checker;
        this.state    = state;
        this.types    = types;
        this.symbolic = symbolic;
        this.binding  = binding;
        this.diag     = diag;
    }


    // -- Member access (`obj.field` / `obj.0` / `obj.method`) --

    resolve_member_access(mut &this, visitor: SemaVisitor*, member_e: ExpressionNode*,
                          member: MemberAccessExpr*) -> TypeRef {
        const obj_type: TypeRef = visitor.resolve_expr(member.object);
        if (!obj_type.is_valid()) { return TypeRef::invalid(); }

        // Symbolic walk: a `void`/abstract receiver is unresolved, not
        // fieldless - except the abstract generic owner itself (`this.value`
        // in a `Box<T>` method), whose fields its template declares, and an
        // instantiation not yet minted (`node.key` on an `Entry<K, V>*`),
        // whose field is its template's seen through the arguments.  A call
        // on such a field (`node.key.equals(key)` under `where K: Eq`) is
        // typed, and so directed by the bound, where it is written.
        const unresolved: boolean = this.symbolic.symbolic_type_unresolved(obj_type);
        if (unresolved && !this.symbolic.symbolic_is_generic_owner_receiver(obj_type)) {
            const through: FieldAnswer = this.field_of(obj_type, member.member);
            if (!through.found()) {
                const param: GenericParamType* = this.binding.receiver_type_param(obj_type);
                if (param != null) { this.report_param_receiver_field(member_e, member, param); }
                return TypeRef::invalid();
            }
            this.pin_field(member, &through,
                if (member.member_span.has_location()) { member.member_span } else { member_e.span });
            return through.ty;
        }

        // Tuple positional access (`t.0`); walks past pointer/reference/inst wrappers.
        mut walk_ty: TypeRef = obj_type;
        mut walk_t: Type* = this.arena.lookup(walk_ty);
        mut depth: i32 = 0;
        while (walk_t != null && depth < 5) {
            match (walk_t.kind) {
                TypeKind::Pointer => {
                    walk_ty = walk_t.as_pointer().pointee;
                    walk_t = this.arena.lookup(walk_ty);
                }
                TypeKind::Reference => {
                    walk_ty = walk_t.as_reference().referent;
                    walk_t = this.arena.lookup(walk_ty);
                }
                TypeKind::InstantiatedType => {
                    const it: InstantiatedType* = walk_t.as_instantiated();
                    if (!it.has_resolved_type()) { break; }
                    walk_ty = it.resolved_type;
                    walk_t = this.arena.lookup(walk_ty);
                }
                _ => { break; }
            }
            depth += 1;
        }
        if (walk_t != null && walk_t.kind == TypeKind::Tuple) {
            const tup: TupleType* = walk_t.as_tuple();
            const member_str: string = this.intern.resolve(member.member);
            const idx: i64 = parse_tuple_index(member_str);
            const m_span: SourceSpan = if (member.member_span.has_location()) {
                member.member_span
            } else {
                member_e.span
            };
            if (idx < 0) {
                this.ctx.emit_error_at(ErrorCode::E0204_UNDEFINED_FIELD,
                    fmt::format("expected a tuple index after `.`, got `%s`", member_str), m_span);
                return TypeRef::invalid();
            }
            if (idx >= tup.elements.length()) {
                this.ctx.emit_error_at(ErrorCode::E0204_UNDEFINED_FIELD,
                    fmt::format("tuple index %lld is out of bounds for tuple with %lld elements",
                           idx, tup.elements.length()), m_span);
                return TypeRef::invalid();
            }
            member.set_resolved_member(MemberPin::Field(idx));
            return tup.elements[idx];
        }
        // A trait object reaches its value only through the trait's methods;
        // the value's fields are not known where the object is used.
        if (walk_t != null && walk_t.kind == TypeKind::Object) {
            const o_span: SourceSpan = if (member.member_span.has_location()) { member.member_span } else { member_e.span };
            this.ctx.emit_error_at(ErrorCode::E0204_UNDEFINED_FIELD,
                fmt::format("no field `%s` on `%s`: a trait object has no fields",
                    this.intern.resolve(member.member), this.arena.format_display(walk_t)), o_span);
            return TypeRef::invalid();
        }

        const acc_span: SourceSpan = if (member.member_span.has_location()) {
            member.member_span
        } else {
            member_e.span
        };
        const fa: FieldAnswer = this.field_of(obj_type, member.member);
        if (fa.found()) {
            this.pin_field(member, &fa, acc_span);
            return fa.ty;
        }

        // Symbolic walk: an unwrapped `void`/abstract receiver - defer.
        if (unresolved || this.symbolic.symbolic_type_unresolved(walk_ty)) { return TypeRef::invalid(); }

        // Method lookup from the *dereferenced* receiver symbol.
        const type_sym: SymbolStr = this.types.lookup_type_sym(walk_ty);
        if (type_sym.is_valid()) {
            const type_name: string = this.intern.resolve(type_sym);
            const method_ret: TypeRef =
                this.method_return_through_door(walk_ty, member);
            if (method_ret.is_valid()) {
                this.report_method_read(member, type_name, acc_span);
                return TypeRef::invalid();
            }

            // Deref coercion: the receiver has no such field or method, but if it
            // implements `Deref<Target>`, retry the lookup on the pointee - `b.field`
            // on a `Box<Foo>` becomes `(*b.deref()).field` - repeating while the
            // pointee is itself a `Deref` type (bounded).  Because `*(b.deref())`
            // is a place, coerced access serves reads and writes uniformly, and
            // codegen needs nothing new.  The pointee answering with a method
            // (no field pinned) is the same misreading as above.
            const coerced: TypeRef = this.try_deref_coercion(visitor, member_e, member);
            if (coerced.is_valid()) {
                if (!member.resolved_member.is_some()) {
                    this.report_method_read(member, type_name, acc_span);
                    return TypeRef::invalid();
                }
                return coerced;
            }

            const member_name: string = this.intern.resolve(member.member);
            const m_span: SourceSpan = if (member.member_span.has_location()) {
                member.member_span
            } else {
                member_e.span
            };
            mut d: Diagnostic = Diagnostic::error(
                ErrorCode::E0204_UNDEFINED_FIELD,
                fmt::format("no field or method `%s` on type `%s`", member_name, type_name));
            d = d.at_with_label(m_span, "unknown field or method");
            // A constant of the type is reached through the type, not a value.
            if (this.ctx.const_table.type_constant(this.ctx.decl_index.def_of(walk_ty, this.arena),
                    member.member).is_valid()) {
                d = d.help(fmt::format("`%s` is a constant of `%s`; write `%s::%s`",
                    member_name, type_name, type_name, member_name));
            } else {
                const cands: [string] = this.diag.collect_struct_member_names(obj_type);
                d = d.did_you_mean(member_name, cands, "field or method", m_span);
            }
            this.ctx.emit_diagnostic(d);
            return TypeRef::invalid();
        }

        // A receiver with no type symbol - a function type - names no type
        // that declares fields or methods; only an error-typed receiver stays
        // silent, its error already reported.
        if (walk_t != null && !walk_t.is_error()) {
            this.ctx.emit_error_at(ErrorCode::E0204_UNDEFINED_FIELD,
                fmt::format("no field or method `%s` on type `%s`",
                    this.intern.resolve(member.member), this.arena.format_display(walk_t)), acc_span);
        }
        return TypeRef::invalid();
    }

    /// `obj.m` read as a value where `m` names a method of the receiver's
    /// type and no field: a method is reached only by calling it, so the
    /// read names nothing a value can be taken from.
    report_method_read(mut &this, member: MemberAccessExpr*, type_name: string,
                       span: SourceSpan) -> void {
        const name: string = this.intern.resolve(member.member);
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0204_UNDEFINED_FIELD,
            fmt::format("no field `%s` on type `%s`", name, type_name));
        d = d.at_with_label(span, "a method, not a field");
        d = d.suggest(Suggestion::single(span, fmt::format("%s()", name),
            fmt::format("`%s` is a method; call it", name), Applicability::MaybeIncorrect));
        this.ctx.emit_diagnostic(d);
    }

    /// A field read whose receiver is a type parameter of the body being
    /// walked: a bound gives a parameter methods, never fields, so the read
    /// names nothing in the body that declares the parameter, whatever each
    /// copy's type argument happens to declare.
    report_param_receiver_field(mut &this, member_e: ExpressionNode*, member: MemberAccessExpr*,
                                param: GenericParamType*) -> void {
        const field_name: string = this.intern.resolve(member.member);
        const param_display: string = this.intern.resolve(param.param_name);
        const primary_span: SourceSpan = if (member.member_span.has_location()) { member.member_span } else { member_e.span };
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0204_UNDEFINED_FIELD,
            fmt::format("no field `%s` on type `%s`", field_name, param_display));
        diag = diag.at_with_label(primary_span, "unknown field");
        if (this.binding.param_is_bounded(param)) {
            diag = diag.with_note(fmt::format(
                "`%s` is a type parameter; its bounds give it methods, not fields", param_display));
        } else {
            diag = diag.with_note(fmt::format(
                "`%s` is a type parameter with no bound, so it has no fields", param_display));
        }
        diag = diag.help(fmt::format(
            "read the field through a method of a trait `%s` is bounded by", param_display));
        this.ctx.emit_diagnostic(diag);
    }

    /// Deref coercion: `member.object`'s type has no `member.member`.  If it
    /// implements `Deref<Target>`, rewrite the access onto the pointee - 
    /// `obj.member` -> `(*obj.deref()).member` - and retry, repeating while the
    /// pointee is itself a `Deref` type (bounded).  On success `member.object` is
    /// committed to the `*(obj.deref())` chain (a place, so reads / writes /
    /// method receivers all work) and the member's type returned; otherwise the
    /// original `member.object` is left untouched and `invalid` returned.
    /// Restricted to concrete user receivers; a bounded `T: Deref` param is not
    /// coerced (its abstract pointee has no field/method to bind pre-mono).
    try_deref_coercion(mut &this, visitor: SemaVisitor*, member_e: ExpressionNode*,
                       member: MemberAccessExpr*) -> TypeRef {
        if (member.object == null) { return TypeRef::invalid(); }
        mut cur_obj: ExpressionNode* = member.object;
        mut cur_ty:  TypeRef         = member.object.resolved_type;
        mut guard: i32 = 0;
        while (guard < 6) {
            guard += 1;
            // Peel references to the concrete receiver; a raw pointer keeps its
            // native field auto-deref and never needs `Deref`.
            mut base_ty: TypeRef = cur_ty;
            mut t: Type* = this.arena.lookup(base_ty);
            mut rd: i32 = 0;
            while (t != null && t.kind == TypeKind::Reference && rd < 4) {
                base_ty = t.as_reference().referent;
                t = this.arena.lookup(base_ty);
                rd += 1;
            }
            if (t == null) { return TypeRef::invalid(); }
            const is_user: boolean = t.kind == TypeKind::Struct
                                  || t.kind == TypeKind::Enum   || t.kind == TypeKind::InstantiatedType;
            if (!is_user) { return TypeRef::invalid(); }
            const impl_block: ImplBlock* = this.trait_checker().select_impl(
                this.ctx.generic_registry.wellknown(LangItem::Deref), base_ty, 0);
            if (impl_block == null) { return TypeRef::invalid(); }
            // Build `*(cur_obj.deref())` and resolve it to the pointee `Target`.
            const member_acc: ExpressionNode* = this.lang_method_callee(cur_obj, LangItem::DerefDeref, member_e.span);
            if (member_acc == null) { return TypeRef::invalid(); }
            mut call: ExpressionNode* = ExpressionNode::call_expr(member_acc, member_e.span);
            const star_tok: Token = Token::new(TokenType::Star, "*",
                member_e.span.start_line as int, member_e.span.start_col as int);
            const star_expr: ExpressionNode* =
                ExpressionNode::synthetic_unary(star_tok, call, member_e.span);
            const target_ty: TypeRef = visitor.resolve_expr(star_expr);
            if (!target_ty.is_valid()) { return TypeRef::invalid(); }
            // Re-attempt the field / method lookup on `Target`.
            const r: TypeRef = this.member_type_on(member_e, member, target_ty);
            if (r.is_valid()) {
                member.object = star_expr;
                member_e.set_resolved_type(r);
                return r;
            }
            // Chain deeper: the pointee may itself implement `Deref`.
            cur_obj = star_expr;
            cur_ty  = target_ty;
        }
        return TypeRef::invalid();
    }

    /// A fresh trait checker over the shared arena + registry (a 4-pointer view).
    trait_checker(&this) -> TraitChecker {
        return TraitChecker::new(this.arena, this.ctx.generic_registry,
                                 this.intern, this.ctx.diagnostics);
    }

    /// Resolve `member.member` as a field (incl. generic-template field) or
    /// method on the ALREADY-RESOLVED receiver type `obj_type`, enforcing a
    /// field's visibility on success; a method found here is a method read,
    /// reported by the caller, and a coerced call is gated where every
    /// method call is.  Returns the member's type, or `invalid` on a
    /// genuine miss - emits no diagnostic.  Used by Deref coercion to probe each
    /// pointee in the chain without perturbing the direct-access path.
    member_type_on(mut &this, member_e: ExpressionNode*, member: MemberAccessExpr*,
                   obj_type: TypeRef) -> TypeRef {
        const acc_span: SourceSpan = if (member.member_span.has_location()) {
            member.member_span
        } else {
            member_e.span
        };
        const fa: FieldAnswer = this.field_of(obj_type, member.member);
        if (fa.found()) {
            this.pin_field(member, &fa, acc_span);
            return fa.ty;
        }
        // Method (from the dereferenced receiver symbol).
        mut walk_ty: TypeRef = obj_type;
        mut walk_t: Type* = this.arena.lookup(walk_ty);
        mut depth: i32 = 0;
        while (walk_t != null && depth < 5) {
            match (walk_t.kind) {
                TypeKind::Pointer => {
                    walk_ty = walk_t.as_pointer().pointee;
                    walk_t = this.arena.lookup(walk_ty);
                }
                TypeKind::Reference => {
                    walk_ty = walk_t.as_reference().referent;
                    walk_t = this.arena.lookup(walk_ty);
                }
                TypeKind::InstantiatedType => {
                    const it: InstantiatedType* = walk_t.as_instantiated();
                    if (!it.has_resolved_type()) { break; }
                    walk_ty = it.resolved_type;
                    walk_t = this.arena.lookup(walk_ty);
                }
                _ => { break; }
            }
            depth += 1;
        }
        const type_sym: SymbolStr = this.types.lookup_type_sym(walk_ty);
        if (type_sym.is_valid()) {
            const method_ret: TypeRef =
                this.method_return_through_door(walk_ty, member);
            if (method_ret.is_valid()) { return method_ret; }
        }
        return TypeRef::invalid();
    }

    /// The return of the method `member` names on `ty`, read off the
    /// member-function door's entries for that owner and leaf.  Invalid when
    /// the owner has no such family, or when its overloads return different
    /// types: only the call's selection can choose between those.
    method_return_through_door(&this, ty: TypeRef, member: MemberAccessExpr*) -> TypeRef {
        const owner: TypeRef = this.types.method_owner_ref(ty);
        if (!owner.is_valid()) { return TypeRef::invalid(); }
        const entries: [OverloadId] = this.ctx.decl_index.lookup_family_entries(
            FamilyOwner::Type(owner), member.member);
        if (entries.length() > 0) { return this.shared_entry_return(&entries); }
        return TypeRef::invalid();
    }

    /// The return type every entry of `entries` declares, canonicalized;
    /// invalid when they differ or none carries a signature.
    shared_entry_return(&this, entries: &[OverloadId]) -> TypeRef {
        mut ret: TypeRef = TypeRef::invalid();
        for (mut k: i64 = 0; k < entries.length(); k++) {
            const sig: Type* = this.arena.lookup(this.ctx.decl_index.entry_signature(entries[k]));
            if (sig == null || sig.kind != TypeKind::Function) { return TypeRef::invalid(); }
            const r: TypeRef = this.types.canonicalize_method_return(sig.as_function().return_type);
            if (ret.is_valid() && !ret.equals(r)) { return TypeRef::invalid(); }
            ret = r;
        }
        return ret;
    }

    /// `a.f` names a field of the type `a` has, and
    /// that type is known only once `a` is checked, so the field is found
    /// here by the receiver's type and the written leaf, and its coordinates
    /// are handed back for every later stage to read.
    ///
    /// One source per receiver shape, never a second try.  Auto-deref is one
    /// pointer or reference layer.  An instantiation with no resolved type,
    /// and a generic template itself, is read off the template's declaration:
    /// the arena type of a template holds no fields.  Everything else - a
    /// struct or union, a resolved instantiation, an array's `length` - is
    /// read off its arena type.  The
    /// field's type is seen through the receiver: the owner's parameters are
    /// replaced by the receiver's arguments (`Pair<u32, i64>.second` is `i64`).
    field_of(&this, recv: TypeRef, leaf: SymbolStr) -> FieldAnswer {
        mut owner: TypeRef = recv;
        mut t: Type* = this.arena.lookup(owner);
        if (t == null) { return FieldAnswer::none(); }
        if (t.kind == TypeKind::Pointer) {
            owner = t.as_pointer().pointee;
            t = this.arena.lookup(owner);
        } else if (t.kind == TypeKind::Reference) {
            owner = t.as_reference().referent;
            t = this.arena.lookup(owner);
        }
        if (t == null) { return FieldAnswer::none(); }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t.as_instantiated();
            if (!inst.has_resolved_type()) {
                return this.template_field(inst.generic_base, recv, leaf);
            }
            owner = inst.resolved_type;
            t = this.arena.lookup(owner);
            if (t == null) { return FieldAnswer::none(); }
        }
        const reg: GenericRegistry* = this.ctx.get_generic_registry();
        if (t.kind == TypeKind::Struct && reg != null && reg.is_template(owner)) {
            return this.template_field(owner, recv, leaf);
        }
        // A concrete type's fields, read off its arena entry.  A pointer or
        // reference still standing here is stepped through once more, and a
        // resolved instantiation reached that way is resolved once more.
        if (t.kind == TypeKind::Pointer) {
            t = this.arena.lookup(t.as_pointer().pointee);
        } else if (t.kind == TypeKind::Reference) {
            t = this.arena.lookup(t.as_reference().referent);
        }
        if (t == null) { return FieldAnswer::none(); }
        if (t.kind == TypeKind::InstantiatedType) {
            const inner: InstantiatedType* = t.as_instantiated();
            if (inner.has_resolved_type()) {
                t = this.arena.lookup(inner.resolved_type);
                if (t == null) { return FieldAnswer::none(); }
            }
        }
        if (t.kind == TypeKind::Struct) {
            mut st: StructType* = t.as_struct();
            const i: i64 = st.field_position(leaf);
            if (i >= 0) { return this.field_answer(recv, &st.fields[i], t, i); }
            return FieldAnswer::none();
        }
        // An array's `length` is an implicit `i64` field, at no position.
        if (t.kind == TypeKind::Array && this.intern.resolve(leaf).eq("length")) {
            return FieldAnswer {
                ty:          this.types.subst_owner_params_from_receiver(recv, this.arena.get_i64()),
                visibility:  Visibility::Public, declared_in: ModulePath::none(), owner: null, index: -1,
            };
        }
        return FieldAnswer::none();
    }

    /// The answer for field `entry`, at `index` in the field list of `owner`,
    /// seen through the receiver.
    field_answer(&this, recv: TypeRef, entry: FieldInfo*, owner: Type*,
                 index: i64) -> FieldAnswer {
        return FieldAnswer {
            ty:          this.types.subst_owner_params_from_receiver(recv, entry.field_type),
            visibility:  entry.visibility,
            declared_in: this.arena.declared_in(owner),
            owner:       owner,
            index:       index,
        };
    }

    /// The field `leaf` of the generic template `tmpl_ref`, read off its
    /// declaration; its position there is its position in every
    /// specialization, which is a clone of the template field for field.
    template_field(&this, tmpl_ref: TypeRef, recv: TypeRef, leaf: SymbolStr) -> FieldAnswer {
        const reg: GenericRegistry* = this.ctx.get_generic_registry();
        if (reg == null) { return FieldAnswer::none(); }
        const tmpl: TemplateEntry* = reg.template_of_type(tmpl_ref);
        if (tmpl == null || tmpl.ast_node == null) { return FieldAnswer::none(); }
        // A declared field whose type did not resolve is no answer.
        const no_fields: [DeclarationNode*] = [];
        mut fields: &[DeclarationNode*] = &no_fields;
        if (tmpl.kind == TemplateKind::Struct) {
            fields = &DeclarationNode::struct_of(tmpl.ast_node).fields;
        } else if (tmpl.kind == TemplateKind::Union) {
            fields = &DeclarationNode::union_of(tmpl.ast_node).fields;
        }
        for (mut k: i64 = 0; k < fields.length(); k++) {
            const f: FieldDecl* = DeclarationNode::field_of(fields[k]);
            if (f == null || !f.name.equals(leaf) || !f.resolved_type.is_valid()) { continue; }
            return FieldAnswer {
                ty:          this.types.subst_owner_params_from_receiver(recv, f.resolved_type),
                visibility:  f.visibility,
                declared_in: tmpl.declared_in,
                owner:       this.arena.lookup(tmpl_ref),
                index:       k,
            };
        }
        return FieldAnswer::none();
    }

    /// The names of the fields of the struct `recv` names, in declaration
    /// order, read where `field_of` reads them: a struct's or a resolved
    /// instantiation's off its arena type, an instantiation not minted yet
    /// and a generic owner off the template's declaration, whose order is
    /// every specialization's.  False when `recv` names no struct (a type
    /// parameter, a projection, an enum): it has no field list to read.
    field_names(&this, recv: TypeRef, out: mut &[SymbolStr]) -> boolean {
        mut owner: TypeRef = recv;
        mut t: Type* = this.arena.lookup(owner);
        if (t == null) { return false; }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t.as_instantiated();
            if (!inst.has_resolved_type()) { return this.template_field_names(inst.generic_base, out); }
            owner = inst.resolved_type;
            t = this.arena.lookup(owner);
            if (t == null) { return false; }
        }
        if (t.kind != TypeKind::Struct) { return false; }
        const reg: GenericRegistry* = this.ctx.get_generic_registry();
        if (reg != null && reg.is_template(owner)) { return this.template_field_names(owner, out); }
        const st: StructType* = t.as_struct();
        for (mut k: i64 = 0; k < st.fields.length(); k++) { out.push(st.fields[k].decl_name().spelling()); }
        return true;
    }

    /// The declared field names of the generic struct template `tmpl_ref`.
    template_field_names(&this, tmpl_ref: TypeRef, out: mut &[SymbolStr]) -> boolean {
        const reg: GenericRegistry* = this.ctx.get_generic_registry();
        if (reg == null) { return false; }
        const tmpl: TemplateEntry* = reg.template_of_type(tmpl_ref);
        if (tmpl == null || tmpl.ast_node == null) { return false; }
        if (tmpl.kind == TemplateKind::Struct) {
            const sn: StructDecl* = DeclarationNode::struct_of(tmpl.ast_node);
            for (mut k: i64 = 0; k < sn.fields.length(); k++) { out.push(DeclarationNode::field_of(sn.fields[k]).name); }
            return true;
        }
        return false;
    }

    /// Record the field the door found on the access, and ask its
    /// visibility of the answer the door gave.  An array's `length` has no
    /// slot.
    pin_field(mut &this, member: MemberAccessExpr*, fa: &FieldAnswer, acc_span: SourceSpan) -> void {
        if (fa.index >= 0) { member.set_resolved_member(MemberPin::Field(fa.index)); }
        this.enforce_field_visibility(fa, member.member, acc_span);
    }

    /// `obj.f(args)` where `f` is a function-typed field: tag the member with
    /// that type (so codegen emits an indirect call) and return its return type.
    /// Calling the field reads it, so it is gated as a read is: a private
    /// field is refused outside the module that may reach it.
    try_field_function_call(mut &this, obj_type: TypeRef, member_e: ExpressionNode*,
                            member: MemberAccessExpr*) -> TypeRef {
        const fa: FieldAnswer = this.field_of(obj_type, member.member);
        if (!fa.found() || fa.index < 0) { return TypeRef::invalid(); }
        const ft: Type* = this.arena.lookup(fa.ty);
        if (ft == null || ft.kind != TypeKind::Function) { return TypeRef::invalid(); }
        member_e.set_resolved_type(fa.ty);
        const acc_span: SourceSpan = if (member.member_span.has_location()) { member.member_span } else { member_e.span };
        this.pin_field(member, &fa, acc_span);
        return ft.as_function().return_type;
    }


    // -- Index access (`arr[i]` / `tup[0]`) --

    resolve_array_access(mut &this, visitor: SemaVisitor*, e: ExpressionNode*,
                         access: ArrayAccessExpr*) -> TypeRef {
        // Idempotent: a prior resolution may have rewritten `a[i]` into
        // `*(a.index(i))`.  Return its type without re-running
        // `check_index_access`, which would re-reject the user-typed base.
        if (access.desugared_call != null) {
            return access.desugared_call.resolved_type;
        }
        const array_type: TypeRef = visitor.resolve_expr(access.array);
        const index_type: TypeRef = visitor.resolve_expr(access.index);
        if (!array_type.is_valid()) { return TypeRef::invalid(); }
        // Symbolic walk: the built-in rules - a pointer's pointee, an array's
        // element, a tuple's position - answer whatever the parameters are
        // (`this.ptr[i]` on a `T*` is a `T`), so a call on the element is
        // typed, and directed by its bound, where it is written.  Only an
        // `Index` overload depends on the instantiation.
        const unresolved: boolean = this.symbolic.symbolic_type_unresolved(array_type);

        // Tuple bracket indexing (`t[0]`): compile-time bounds-checked integer.
        mut walk_ty: TypeRef = array_type;
        mut walk_t: Type* = this.arena.lookup(walk_ty);
        mut depth: i32 = 0;
        while (walk_t != null && depth < 5) {
            if (walk_t.kind == TypeKind::Pointer) {
                walk_ty = walk_t.as_pointer().pointee;
                walk_t = this.arena.lookup(walk_ty);
            } else if (walk_t.kind == TypeKind::Reference) {
                walk_ty = walk_t.as_reference().referent;
                walk_t = this.arena.lookup(walk_ty);
            } else if (walk_t.kind == TypeKind::InstantiatedType) {
                const it: InstantiatedType* = walk_t.as_instantiated();
                if (!it.has_resolved_type()) { break; }
                walk_ty = it.resolved_type;
                walk_t = this.arena.lookup(walk_ty);
            } else {
                break;
            }
            depth += 1;
        }
        if (walk_t != null && walk_t.kind == TypeKind::Tuple) {
            const tup: TupleType* = walk_t.as_tuple();
            const idx: i64 = sema_const_int_index(access.index);
            if (idx < 0) {
                this.ctx.emit_error_at(ErrorCode::E0200_TYPE_MISMATCH,
                    "tuple index must be a non-negative integer literal; runtime indices are not supported on tuples",
                    e.span);
                return TypeRef::invalid();
            }
            if (idx >= tup.elements.length()) {
                this.ctx.emit_error_at(ErrorCode::E0204_UNDEFINED_FIELD,
                    fmt::format("tuple index %lld is out of bounds for tuple with %lld elements",
                           idx, tup.elements.length()), e.span);
                return TypeRef::invalid();
            }
            return tup.elements[idx];
        }

        const result: TypeCheckResult = this.checker.check_index_access(array_type, index_type);
        if (result.success) { return result.result_type; }
        if (unresolved) {
            // A type parameter a bound gives `Index` is indexed through that
            // bound where it is written: the desugar's call is answered by
            // the bound and records it, and every copy of the body carries
            // that record.  A user aggregate carrying the parameters
            // (`&Array<T>`) is indexed through its own implementation, here
            // as for a concrete base: the copies specialize the call the
            // desugar holds and build no desugar of their own.
            const bounded: ExpressionNode* = this.try_bounded_index(visitor, e, access, array_type);
            if (bounded != null) {
                access.desugared_call = bounded;
                return bounded.resolved_type;
            }
            const owned: ExpressionNode* = this.try_index_overload(visitor, e, access, array_type);
            if (owned != null) {
                access.desugared_call = owned;
                return owned.resolved_type;
            }
            return TypeRef::invalid();
        }

        // Index operator overloading: `check_index_access` rejected a base with
        // no primitive indexing rule.  A concrete user aggregate (or a generic
        // param bounded by `Index`) that implements `Index<Idx, Output>` rewrites
        // `a[i]` into `*(a.index(i))` - the deref of the returned `Output*` is a
        // place, so the one desugar serves read / write / compound assignment.
        // Fixed arrays, strings, pointers and references to them all succeed
        // above and never reach here.
        const de: ExpressionNode* = this.try_index_overload(visitor, e, access, array_type);
        if (de != null) {
            access.desugared_call = de;
            return de.resolved_type;
        }
        if (this.emit_index_missing_impl(array_type, e.span)) {
            return TypeRef::invalid();
        }
        if (result.error_message != null && result.error_message.length() > 0) {
            this.ctx.emit_error_at(ErrorCode::E0200_TYPE_MISMATCH, result.error_message, e.span);
        }
        return TypeRef::invalid();
    }

    /// Build + resolve the index desugar `*(a.index(i))` when the base type
    /// `ty` overloads `[]`: a concrete user aggregate
    /// (Struct/Enum/InstantiatedType) with a registered `Index` impl, or
    /// a generic param bounded by `Index`.  Returns the resolved desugar
    /// expression (its `resolved_type` is the element type = the deref of the
    /// method's `Output*`) for the caller to stash, or null when no overload
    /// applies.  Deliberately does NOT unwrap pointers / references: a raw
    /// pointer or `&T` keeps its primitive indexing rule (which already
    /// succeeded in `check_index_access`), mirroring the arithmetic desugar.
    try_index_overload(mut &this, visitor: SemaVisitor*, e: ExpressionNode*, access: ArrayAccessExpr*,
                       ty: TypeRef) -> ExpressionNode* {
        mut base_ty: TypeRef = ty;
        mut t: Type* = this.arena.lookup(base_ty);
        if (t == null) { return null; }
        // Auto-deref a reference base (`&Vec`): `check_index_access` on a
        // reference recurses to the referent and fails for a user Index type, so
        // a by-reference container reaches here typed as `Reference`.  Unwrap it
        // (indexing a reference has no primitive rule that could be perturbed) so
        // `v[i]` on a `&T` parameter overloads exactly like on a value - the
        // method call auto-derefs the receiver.  Raw pointers are left alone:
        // `Vec*[i]` keeps its C pointer-arithmetic meaning (which already
        // succeeded in `check_index_access` and never reaches here).
        mut rdepth: i32 = 0;
        while (t != null && t.kind == TypeKind::Reference && rdepth < 4) {
            base_ty = t.as_reference().referent;
            t = this.arena.lookup(base_ty);
            rdepth += 1;
        }
        if (t == null) { return null; }
        // `[]` is `std::core::ops::Index`, by the identity its declaration
        // claimed; a user trait spelled `Index` overloads nothing, whether a
        // parameter is bounded by it or a type implements it.
        const index_id: DefId = this.ctx.generic_registry.wellknown(LangItem::Index);
        if (!index_id.is_valid()) { return null; }
        if (t.kind != TypeKind::Struct
                && t.kind != TypeKind::Enum && t.kind != TypeKind::InstantiatedType) {
            return null;
        }
        if (this.trait_checker().select_impl(index_id, base_ty, 0) == null) { return null; }
        return this.build_index_desugar(visitor, e, access);
    }

    /// The index desugar for a base that is a type parameter of the body
    /// being walked, when a bound in scope gives the parameter
    /// `std::core::ops::Index` - itself or as a supertrait of the trait it
    /// names.  Null for any other base.
    try_bounded_index(mut &this, visitor: SemaVisitor*, e: ExpressionNode*, access: ArrayAccessExpr*,
                      ty: TypeRef) -> ExpressionNode* {
        const param: GenericParamType* = this.binding.receiver_type_param(ty);
        if (param == null) { return null; }
        const index_id: DefId = this.ctx.generic_registry.wellknown(LangItem::Index);
        if (!index_id.is_valid() || !this.binding.param_bounded_by(param, index_id)) { return null; }
        return this.build_index_desugar(visitor, e, access);
    }

    /// Build and resolve `*(a.index(i))` for `access`; null when it does not
    /// type.
    build_index_desugar(mut &this, visitor: SemaVisitor*, e: ExpressionNode*,
                        access: ArrayAccessExpr*) -> ExpressionNode* {
        // The index expression is passed BY VALUE - the trait is
        // `index(&this, idx: Idx)`, not `&Idx` - so no synthetic `&`.
        const member: ExpressionNode* = this.lang_method_callee(access.array, LangItem::IndexIndex, e.span);
        if (member == null) { return null; }
        mut call: ExpressionNode* = ExpressionNode::call_expr(member, e.span);
        ExpressionNode::call_of(call).add_argument(access.index);
        const star_tok: Token = Token::new(TokenType::Star, "*",
            e.span.start_line as int, e.span.start_col as int);
        const de: ExpressionNode* =
            ExpressionNode::synthetic_unary(star_tok, call, e.span);
        const rty: TypeRef = visitor.resolve_expr(de);
        if (!rty.is_valid()) { return null; }
        return de;
    }

    /// The callee `recv.m` of a desugar calling `item`, a trait's method
    /// claimed as a language item, stamped with that trait and the
    /// method's position in it as an operator's call is: the trait's
    /// method answers it, and an inherent method of the same name cannot.
    /// Null when no declaration in this program claimed `item`.
    lang_method_callee(&this, recv: ExpressionNode*, item: LangItem, span: SourceSpan) -> ExpressionNode* {
        const d: DefId = this.ctx.generic_registry.wellknown(item);
        if (!d.is_valid()) { return null; }
        const m: ExpressionNode* = ExpressionNode::member_access_expr(recv, this.ctx.defs.leaf_of(d).spelling(), span, span);
        ExpressionNode::member_access_of(m).set_resolved_trait_item(
            this.ctx.defs.parent_of(d), this.ctx.generic_registry.trait_item_position(d));
        return m;
    }

    /// When `[]` hits a user type lacking an `Index` impl, emit a diagnostic that
    /// names the missing trait instead of the generic "cannot index".  Returns
    /// true when it emitted (caller skips the fallback); false for non-user bases
    /// (a genuine primitive index error keeps its original message).
    emit_index_missing_impl(mut &this, ty: TypeRef, span: SourceSpan) -> boolean {
        mut t: Type* = this.arena.lookup(ty);
        if (t == null) { return false; }
        // Look through references so `&UserType` (a by-reference container that
        // still lacks an `Index` impl) gets the trait-naming diagnostic too.
        mut rdepth: i32 = 0;
        while (t != null && t.kind == TypeKind::Reference && rdepth < 4) {
            t = this.arena.lookup(t.as_reference().referent);
            rdepth += 1;
        }
        if (t == null) { return false; }
        const is_user: boolean = t.kind == TypeKind::Struct
                              || t.kind == TypeKind::Enum || t.kind == TypeKind::InstantiatedType;
        if (!is_user) { return false; }
        const name: string = this.arena.format_display(t);
        this.ctx.emit_error_at(ErrorCode::E0200_TYPE_MISMATCH,
            fmt::format("`%s` cannot be indexed with `[]`; add `implement trait Index<Idx, Output> ... for %s` (its `index` must return `Output*`)",
                name, name), span);
        return true;
    }


    // -- Visibility enforcement --

    /// Whether code written at `span` may reach a member with visibility
    /// `v` declared in module `decl`: a private one only from that module,
    /// an internal one from any module of its package
    /// (`CompilationContext::reaches`).  Which module the code is in is the
    /// module that owns the syntax's own file - never the type the walk is
    /// inside - so an `implement` block written in another module is outside
    /// however it names the type, a free function beside the type is
    /// inside, and a lowered `async` body, whose statements keep the spans
    /// they were written with, keeps the access of where it was written.
    member_reachable(&this, v: Visibility, decl: ModulePath, span: SourceSpan) -> boolean {
        // Asked of every field read and method call: a public member needs
        // no use site, and finding one is a lookup by the file's path.
        if (v == Visibility::Public) { return true; }
        return this.ctx.reaches(v, decl, this.ctx.module_of_file(span.file));
    }

    /// Where a member of visibility `v` declared in `decl` was reached from
    /// outside of, for a refusal's label: its module, or its package.
    outside_of(&this, v: Visibility, decl: ModulePath) -> string {
        if (v == Visibility::Internal) { return "its package"; }
        return fmt::format("module `%s`", this.intern.shown(decl.decl_name()));
    }

    /// Emit E0353 when a private or internal field is reached from where it
    /// may not be (`member_reachable`).  A field is declared where its type
    /// is.  `fa` is the answer the caller's lookup gave (`field_of`);
    /// `field_name` is the spelling, for the diagnostic alone.  Nothing here
    /// finds the field again.
    enforce_field_visibility(mut &this, fa: &FieldAnswer, field_name: SymbolStr, span: SourceSpan) -> void {
        if (fa.owner == null) { return; }
        const decl: ModulePath = fa.declared_in;
        if (this.member_reachable(fa.visibility, decl, span)) { return; }

        const declaring_name: string = fa.owner.display_name();
        const field_str: string = this.intern.resolve(field_name);
        const word: string = fa.visibility.label();
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0353_PRIVATE_ACCESS,
            fmt::format("field `%s` of `%s` is %s", field_str, declaring_name, word));
        d = d.at_with_label(span, fmt::format("%s field reached outside %s", word,
            this.outside_of(fa.visibility, decl)));
        this.ctx.emit_diagnostic(d);
    }

    /// Method-call counterpart to `enforce_field_visibility` (E0353), asked
    /// of `method_decl`, the declaration the call bound: a `MethodDecl`, or
    /// the function a trait declares.  Nothing here finds the method again
    /// by its receiver and name, which an instantiation not minted yet does
    /// not answer.
    ///
    /// A method is declared where its declaration is written, which for one
    /// in an `implement` block is the block's module, not its type's.  A
    /// trait's method - declared by the trait, or implementing it - has no
    /// visibility of its own: it is reachable wherever the trait is, so a
    /// private trait's methods are refused outside its module even on a
    /// public type.
    enforce_method_visibility(mut &this, method_decl: DeclarationNode*, span: SourceSpan) -> void {
        if (method_decl == null) { return; }
        const node: MethodDecl* = DeclarationNode::method_of(method_decl);
        const func: FunctionDecl* = DeclarationNode::fn_of(if (node != null) { node.func } else { method_decl });
        if (func == null) { return; }
        const trait_def: DefId = if (func.origin_trait.is_valid()) {
            func.origin_trait
        } else {
            this.ctx.defs.parent_of(func.def)
        };
        if (this.ctx.generic_registry.get_trait_decl(trait_def) != null) {
            if (!this.ctx.hidden_from(trait_def, this.ctx.module_of_file(span.file))) { return; }
            mut td: Diagnostic = Diagnostic::error(
                ErrorCode::E0353_PRIVATE_ACCESS,
                fmt::format("method `%s` of the %s trait `%s` cannot be called here",
                    this.intern.resolve(func.name), this.ctx.declared_visibility(trait_def).label(),
                    this.intern.shown(this.ctx.defs.path_of(trait_def))));
            td = td.at_with_label(span, "a trait's methods are reachable only where the trait is");
            this.ctx.emit_diagnostic(td);
            return;
        }
        if (node == null || node.visibility == Visibility::Public) { return; }
        const decl: ModulePath = this.ctx.module_of_file(method_decl.span.file);
        if (this.member_reachable(node.visibility, decl, span)) { return; }

        const word: string = node.visibility.label();
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0353_PRIVATE_ACCESS,
            fmt::format("method `%s` of `%s` is %s", this.intern.resolve(func.name),
                this.intern.shown(this.ctx.defs.path_of(this.ctx.defs.parent_of(func.def))), word));
        d = d.at_with_label(span, fmt::format("%s method called outside %s", word,
            this.outside_of(node.visibility, decl)));
        this.ctx.emit_diagnostic(d);
    }

}
