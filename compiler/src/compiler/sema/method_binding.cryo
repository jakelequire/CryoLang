    type_ref, type_base, arena, compound, user_defined, generic, substitution,
    inference, trait_checker, generic_registry, resolver, ownership, TypeKind
};
import compiler::resolver::{ symbol_str, intern_table };
import compiler::resolver::res::{ Res };
import compiler::ast;
import compiler::ast::{
    declaration, expression, LiteralKind, node, NodeKind, statement, TraitBound, TraitRef,
    TypeAnnotation
};
import compiler::compilation_context;
import compiler::compilation_context::{ CompilationContext };
import compiler::sema::{ state, type_utils, symbolic_checker, helpers };
import std::fmt;
import compiler::ast::declaration::{
    AssocTypeDeclNode, ClassDeclNode, FunctionDeclNode, GenericParamNode, ImplBlockNode,
    MethodNode, StructDeclNode, TraitDeclNode, UnionDeclNode, VarDeclNode
};
import compiler::ast::expression::{
    BinaryExprNode, CallExprNode, ExpressionNode, LiteralNode, MemberAccessNode,
    UnaryExprNode
};
import compiler::ast::node::{ ASTNode };
import compiler::lex::{ TokenType };
import compiler::ast::node_locator::{ NodeLocator };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::res::{ DefId };
import compiler::resolver::symbol_id;
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::sema::helpers::{ sema_expr_has_numeric_suffix };
import compiler::sema::state::{ SemaState };
import compiler::sema::symbolic_checker::{ SymbolicChecker };
import compiler::sema::type_utils::{ TypeUtils };
import compiler::types::arena::{ TypeArena };
import compiler::types::compound::{
    ArrayType, FunctionType, OptionalType, PointerType, ReferenceType, TupleType
};
import compiler::types::generic::{
    AssocProjectionType, GenericParamType, InstantiatedType
};
import compiler::types::generic_registry::{ TemplateEntry };
import compiler::types::inference::{ InferCtx };
import compiler::types::resolver::{ ResolutionContext };
import compiler::types::substitution::{ TypeSubstitution };
import compiler::types::trait_checker::{ TraitChecker };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };
import compiler::types::user_defined::{ ClassType, MethodInfo, TraitType };
import utils::text::{ Text };

/// The trait a call on a bounded receiver names: every trait a bound
/// answers the method through is noted, and the call names one only when
/// they are all the same trait.  Two traits providing the name direct
/// nothing; the instantiation reports the tie.
type struct BoundDirection {
    trait_def: DefId;
    tied:      boolean;

    static none() -> BoundDirection {
        return BoundDirection { trait_def: DefId::invalid(), tied: false };
    }

    note(mut &this, d: DefId) -> void {
        if (this.tied || !d.is_valid()) { return; }
        if (!this.trait_def.is_valid()) { this.trait_def = d; return; }
        if (!this.trait_def.equals(d)) {
            this.tied = true;
            this.trait_def = DefId::invalid();
        }
    }

    /// The one trait noted, or invalid when none was or two were.
    named(&this) -> DefId {
        return this.trait_def;
    }
}

type struct MethodBinding {
    arena:    TypeArena*;
    intern:   InternTable*;
    ctx:      CompilationContext*;
    state:    SemaState*;
    types:    TypeUtils*;
    symbolic: SymbolicChecker*;

    static null() -> MethodBinding {
        return MethodBinding {
            arena: null, intern: null, ctx: null,
            state: null, types: null, symbolic: null,
        };
    }

    wire(mut &this, arena: TypeArena*, intern: InternTable*, ctx: CompilationContext*,
                    state: SemaState*, types: TypeUtils*, symbolic: SymbolicChecker*) -> void {
        this.arena    = arena;
        this.intern   = intern;
        this.ctx      = ctx;
        this.state    = state;
        this.types    = types;
        this.symbolic = symbolic;
    }

    /// A fresh trait checker over the shared arena + registry (a 4-pointer view).
    trait_checker(&this) -> TraitChecker {
        return TraitChecker::new(this.arena, this.ctx.generic_registry,
                                 this.intern, this.ctx.diagnostics);
    }


    // -- Receiver/return substitution --

    /// Substitute the receiver's bare nominal type for the `This` placeholder in
    /// `ty` (used for trait-default returns like `take -> TakeIter<This>`).
    subst_this_in_type(mut &this, ty: TypeRef, receiver: TypeRef) -> TypeRef {
        if (!ty.is_valid() || !this.types.contains_generic_param(ty)) { return ty; }
        mut recv: TypeRef = receiver;
        mut rt: Type* = this.arena.lookup(recv);
        mut depth: i32 = 0;
        while (rt != null && depth < 5) {
            if (rt.kind == TypeKind::Reference) {
                recv = (rt as ReferenceType*).referent;
                rt = this.arena.lookup(recv);
            } else if (rt.kind == TypeKind::Pointer) {
                recv = (rt as PointerType*).pointee;
                rt = this.arena.lookup(recv);
            } else {
                break;
            }
            depth += 1;
        }
        if (!recv.is_valid()) { return ty; }
        const this_name: SymbolStr = this.intern.intern("This");
        const this_ph: TypeRef = this.arena.this_placeholder(this_name);
        mut subst: TypeSubstitution = TypeSubstitution::empty();
        subst.add(this_ph, recv);
        const out: TypeRef = subst.apply(ty, this.arena);
        if (!out.is_valid()) { return ty; }
        return out;
    }

    /// Mono-after-sema: resolve a method's return type when the receiver is an
    /// unresolved generic instantiation (`Slice<u8>` pre-mono).  Walks the generic
    /// BASE template's method list for an unambiguous non-static non-method-generic
    /// match, else reads the return of `chosen`, the method the call's selection
    /// chose (an impl block's or an enum's), substituting the receiver's
    /// type_args + `This`.  Invalid on 0/ambiguous/own-generic/abstract results.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    resolve_method_return_via_template(mut &this, recv_type: TypeRef,
                                       method_name: SymbolStr, chosen: MethodNode*) -> TypeRef {
        const inst: InstantiatedType* = this.types.peel_to_instantiation(recv_type);
        if (inst == null) { return TypeRef::invalid(); }
        const tmpl: TemplateEntry* =
            this.ctx.generic_registry.template_of_type(inst.generic_base);
        if (tmpl == null || tmpl.ast_node == null) { return TypeRef::invalid(); }
        const empty_methods: MethodNode*[] = [];
        mut methods: &MethodNode*[] = &empty_methods;
        if (tmpl.node_kind == NodeKind::StructDeclaration) {
            methods = &(tmpl.ast_node as StructDeclNode*).methods;
        } else if (tmpl.node_kind == NodeKind::UnionDeclaration) {
            methods = &(tmpl.ast_node as UnionDeclNode*).methods;
        } else if (tmpl.node_kind == NodeKind::ClassDeclaration) {
            methods = &(tmpl.ast_node as ClassDeclNode*).methods;
        }
        mut found_count: i64 = 0;
        mut abstract_ret: TypeRef = TypeRef::invalid();
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null || m.is_static) { continue; }
            if (!m.func.name.equals(method_name)) { continue; }
            if (m.func.generic_params.length > 0) { return TypeRef::invalid(); }
            found_count += 1;
            abstract_ret = m.func.resolved_return_type;
        }

        // An impl block's or an enum's method: the one the selection chose,
        // its return in the owner's parameters (substituted concrete below).
        // A call the selection chose nothing for has no return to read.
        if (found_count == 0 && chosen != null && chosen.func != null) {
            const ret: TypeRef = this.types.canonicalize_method_return(
                this.ctx.decl_index.entry_owner_return(chosen.func.overload_entry));
            if (ret.is_valid()) {
                abstract_ret = ret;
                found_count = 1;
            }
        }

        if (found_count != 1 || !abstract_ret.is_valid()) { return TypeRef::invalid(); }
        const recv_subst: TypeRef =
            this.types.subst_owner_params_from_receiver(recv_type, abstract_ret);
        return this.subst_this_in_type(recv_subst, recv_type);
    }


    // -- Bound / trait-impl method lookup --

    /// Rebase a trait-declared method return onto the ACTUAL receiver by
    /// substituting the trait's canonical `This` placeholder.
    ///
    /// `AsyncRead::read` declares `-> This::ReadFut`. Called on a receiver typed
    /// `S`, the answer is `S::ReadFut` — the very projection the caller's
    /// `where S::ReadFut: Future<i64>` bound resolves to, and the one mono
    /// reduces once `S` is bound. Handed back as `This::ReadFut` it matches no
    /// bound and names no impl, so the use site is left untyped.
    ///
    /// `This` is one canonical arena entry (`GenericParam("This", sentinel)`,
    /// deduplicated across every trait by `resolve_trait_method_signatures`), so
    /// a plain type substitution reaches it wherever it sits in the return.
    subst_this_in_trait_return(mut &this, ret: TypeRef, recv: TypeRef) -> TypeRef {
        if (!ret.is_valid() || !recv.is_valid()) { return ret; }
        if (!this.arena.contains_generic_param(ret)) { return ret; }
        // The one `This` placeholder `resolve_trait_method_signatures`
        // resolved the trait's signatures against.
        const this_ty: TypeRef = this.arena.this_placeholder(this.intern.intern("This"));
        if (!this_ty.is_valid() || this_ty.equals(recv)) { return ret; }
        mut ids: TypeRef[] = [this_ty];
        mut binds: TypeRef[] = [recv];
        mut subst: TypeSubstitution = TypeSubstitution::from_params(&ids, &binds);
        const out: TypeRef = subst.apply(ret, this.arena);
        if (!out.is_valid()) { return ret; }
        return out;
    }

    /// Projection-bounded dispatch: the associated-type-projection sibling of
    /// `lookup_method_through_param_bounds`. When the receiver is an `AssocProjection`
    /// (`This::Item`) and an enclosing where-bound constrains that same
    /// projection (`where This::Item: Ord`), resolve `method_name` through the
    /// bound trait(s). The bound is matched to the receiver by the projected
    /// associated type - its trait and position there - which distinguishes
    /// e.g. `This::Item` from `This::Key` inside one method's where-clause.
    /// `dir` notes every trait the bounds answer through, as for a bare
    /// parameter.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    lookup_method_through_projection_bounds(mut &this, proj: AssocProjectionType*,
                                            recv: TypeRef,
                                            method_name: SymbolStr, dir: BoundDirection*) -> TypeRef {
        if (proj == null) { return TypeRef::invalid(); }
        if (!proj.member.is_valid()) { return TypeRef::invalid(); }
        mut out: TypeRef = TypeRef::invalid();
        if (this.state.symbolic_current_func != null) {
            out = this.scan_projection_bounds(&this.state.symbolic_current_func.trait_bounds, proj,
                method_name, recv, true, dir);
        }
        if (this.state.symbolic_impl_node != null) {
            const r: TypeRef = this.scan_projection_bounds(&this.state.symbolic_impl_node.where_bounds,
                proj, method_name, recv, !out.is_valid(), dir);
            if (!out.is_valid()) { out = r; }
        }
        return out;
    }

    /// Type a method call whose receiver is ABSTRACT, by resolving `method_name`
    /// through whatever constrains that receiver:
    ///   * a bounded param (`s: S` under `S: AsyncRead`) - through its bounds;
    ///   * an associated-type projection (`f: S::ReadFut`) - through the
    ///     enclosing `where S::ReadFut: Future<i64>` bound.
    ///
    /// Both receivers are "unresolved" to `symbolic_type_unresolved`, so the
    /// early return it guards runs before either rescue further down
    /// `resolve_method_call` can fire, and the use site reads `void`. The bounds
    /// determine the signature exactly, so the call can and must be typed here.
    /// Pointer/reference wrappers are peeled first; invalid for any other shape.
    /// `dir` notes each trait a bound answered through: the one it names,
    /// when it is one, is the method the call names wherever the receiver
    /// is later substituted.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    abstract_receiver_method_return(mut &this, recv_type: TypeRef, method_name: SymbolStr,
                                    chosen: MethodNode*, dir: BoundDirection*) -> TypeRef {
        mut walk: TypeRef = recv_type;
        mut t: Type* = this.arena.lookup(walk);
        mut depth: i32 = 0;
        while (t != null && depth < 5) {
            if (t.kind == TypeKind::Pointer) {
                walk = (t as PointerType*).pointee;
            } else if (t.kind == TypeKind::Reference) {
                walk = (t as ReferenceType*).referent;
            } else {
                break;
            }
            t = this.arena.lookup(walk);
            depth += 1;
        }
        if (t == null) { return TypeRef::invalid(); }
        if (t.kind == TypeKind::AssocProjection) {
            return this.lookup_method_through_projection_bounds(
                t as AssocProjectionType*, walk, method_name, dir);
        }
        if (t.kind == TypeKind::GenericParam) {
            return this.lookup_method_through_param_bounds(
                t as GenericParamType*, walk, method_name, dir);
        }
        // A generic owner instantiated at a still-abstract argument (`H<S>` built
        // inside a generic function) is "unresolved" only in its ARGUMENTS: the
        // base is a known template whose method list types the call exactly. The
        // template resolver leaves the return abstract when the receiver's args
        // are abstract, which is what a symbolic walk wants — monomorphization
        // substitutes it once the argument is bound. Without this the symbolic
        // path returns invalid and the call types as nothing, which an enclosing
        // `await` reports as an operand that does not implement `Future`.
        if (t.kind == TypeKind::InstantiatedType) {
            return this.resolve_method_return_via_template(walk, method_name, chosen);
        }
        return TypeRef::invalid();
    }

    /// Resolve `method_name` through the where-clause bounds naming the generic
    /// parameter `param` (`where S: AsyncRead`).
    ///
    /// A parameter's bounds live on the enclosing function/impl node, not on
    /// its type, so they are read there. The bare-parameter sibling of
    /// `lookup_method_through_projection_bounds`.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    ///
    /// The function's bounds answer first, then the impl's, then the owner
    /// declaration's; `dir` notes every trait any of them answers through,
    /// so two traits providing the name leave the call undirected.
    lookup_method_through_param_bounds(mut &this, param: GenericParamType*, recv: TypeRef,
                                       method_name: SymbolStr, dir: BoundDirection*) -> TypeRef {
        if (param == null) { return TypeRef::invalid(); }
        // `This` in a trait's default method is bounded by that trait alone,
        // which no where-clause writes.
        if (this.arena.is_this_placeholder(param as Type*)) {
            if (!this.state.symbolic_trait.is_valid()) { return TypeRef::invalid(); }
            mut none: TraitBound[] = [];
            return this.scan_param_bounds(&none, param, method_name, recv, this.state.symbolic_trait, true, dir);
        }
        mut out: TypeRef = TypeRef::invalid();
        if (this.state.symbolic_current_func != null) {
            out = this.scan_param_bounds(&this.state.symbolic_current_func.trait_bounds, param, method_name,
                recv, TypeRef::invalid(), true, dir);
        }
        if (this.state.symbolic_impl_node != null) {
            const r: TypeRef = this.scan_param_bounds(&this.state.symbolic_impl_node.where_bounds, param,
                method_name, recv, TypeRef::invalid(), !out.is_valid(), dir);
            if (!out.is_valid()) { out = r; }
        }
        const owner_bounds: TraitBound[]* = this.owner_declared_bounds();
        if (owner_bounds != null) {
            const r: TypeRef = this.scan_param_bounds(owner_bounds, param, method_name, recv,
                TypeRef::invalid(), !out.is_valid(), dir);
            if (!out.is_valid()) { out = r; }
        }
        // In an implement block's copy of a trait default, a parameter of the
        // block is what a projection the default bounds denotes.
        const r: TypeRef = this.default_copy_bound_return(recv, method_name, dir);
        if (!out.is_valid()) { out = r; }
        return out;
    }

    /// The parameter types, after its receiver, of `func` - the declared
    /// method of the trait `trait_def` - with the arguments of the `where`
    /// bound on the parameter `param_ty` naming that trait substituted in:
    /// what a call the bound directs to `func` passes (`[&JsonValue]` for
    /// `T::try_from(v)` under `where T: TryFrom<&JsonValue>`).  Empty when
    /// the trait has no parameters of its own, or no bound on `param_ty`
    /// itself names it.
    bound_method_params(mut &this, param_ty: TypeRef, trait_def: DefId,
                        func: FunctionDeclNode*) -> TypeRef[] {
        mut out: TypeRef[] = [];
        if (func == null) { return out; }
        const pt: Type* = this.arena.lookup(param_ty);
        if (pt == null || pt.kind != TypeKind::GenericParam) { return out; }
        const tdecl: TraitDeclNode* = this.ctx.generic_registry.get_trait_decl(trait_def);
        if (tdecl == null || tdecl.generic_params.length == 0) { return out; }
        const tr: TraitRef* = this.param_bound_naming(pt as GenericParamType*, trait_def);
        if (tr == null) { return out; }
        const leaf: SymbolStr = tr.path[tr.path.length - 1];
        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const p: VarDeclNode* = func.parameters[i];
            if (p == null || !p.resolved_type.is_valid()) { return []; }
            if (p.is_receiver()) { continue; }
            out.push(this.subst_bound_trait_args(p.resolved_type, leaf, tr));
        }
        return out;
    }

    /// The trait of a `where` bound on `param` itself naming `trait_def`, by
    /// identity: the enclosing function's bounds first, then the impl's,
    /// then the owner declaration's, as `lookup_method_through_param_bounds`
    /// asks them.  Null when none does.
    param_bound_naming(&this, param: GenericParamType*, trait_def: DefId) -> TraitRef* {
        if (this.state.symbolic_current_func != null) {
            const r: TraitRef* = MethodBinding::bound_ref_in(&this.state.symbolic_current_func.trait_bounds, param, trait_def);
            if (r != null) { return r; }
        }
        if (this.state.symbolic_impl_node != null) {
            const r: TraitRef* = MethodBinding::bound_ref_in(&this.state.symbolic_impl_node.where_bounds, param, trait_def);
            if (r != null) { return r; }
        }
        const owner_bounds: TraitBound[]* = this.owner_declared_bounds();
        if (owner_bounds != null) { return MethodBinding::bound_ref_in(owner_bounds, param, trait_def); }
        return null;
    }

    static bound_ref_in(bounds: &TraitBound[], param: GenericParamType*, trait_def: DefId) -> TraitRef* {
        for (mut bi: i64 = 0; bi < bounds.length; bi++) {
            const b: TraitBound* = &bounds[bi];
            if (!MethodBinding::bound_names_param(b, param)) { continue; }
            for (mut ti: i64 = 0; ti < b.trait_refs.length; ti++) {
                const tr: TraitRef* = &b.trait_refs[ti];
                if (tr.path.length == 0 || tr.refused) { continue; }
                if (tr.definition().equals(trait_def)) { return tr; }
            }
        }
        return null;
    }

    /// The `where` bounds written on the declaration of the type whose
    /// methods are being walked: they constrain the type's own parameters in
    /// every method the declaration holds, as the enclosing function's and
    /// impl's clauses constrain theirs; which parameter a bound names is
    /// decided by the parameter's declaration.  Null outside such a walk.
    owner_declared_bounds(&this) -> TraitBound[]* {
        const base: TypeRef = this.symbolic.symbolic_recv_base(this.state.current_owner_type);
        if (!base.is_valid()) { return null; }
        const tmpl: TemplateEntry* = this.ctx.generic_registry.template_of_type(base);
        if (tmpl == null) { return null; }
        return tmpl.declared_where_bounds();
    }

    /// The type parameter a method call's receiver is, or null for any other
    /// receiver.  Inside the body that declares it a parameter has no
    /// methods but those its bounds give it, so a call the bounds did not
    /// type has nothing it can mean.  `This` is bounded by its trait and is
    /// not one.  A body the user did not write where it stands - an impl's
    /// copy of a trait default, an `async` lowering's `poll` - is skipped:
    /// its source is walked, with its own bounds, where it is written.
    receiver_type_param(&this, recv_type: TypeRef) -> GenericParamType* {
        const func: FunctionDeclNode* = this.state.symbolic_current_func;
        if (func == null || func.is_synth_default || func.is_synthesized_body) { return null; }
        mut t: Type* = this.arena.lookup(recv_type);
        mut depth: i32 = 0;
        while (t != null && depth < 5) {
            if (t.kind == TypeKind::Pointer) {
                t = this.arena.lookup((t as PointerType*).pointee);
            } else if (t.kind == TypeKind::Reference) {
                t = this.arena.lookup((t as ReferenceType*).referent);
            } else {
                break;
            }
            depth += 1;
        }
        if (t == null || t.kind != TypeKind::GenericParam) { return null; }
        const param: GenericParamType* = t as GenericParamType*;
        if (this.arena.is_this_placeholder(param as Type*)) { return null; }
        return param;
    }

    /// Whether a bound in scope of the body being walked names `param`: the
    /// function's `where` clause, the impl's, or the owner declaration's.
    param_is_bounded(&this, param: GenericParamType*) -> boolean {
        const func: FunctionDeclNode* = this.state.symbolic_current_func;
        if (func != null && MethodBinding::bounds_name_param(&func.trait_bounds, param)) { return true; }
        if (this.state.symbolic_impl_node != null
            && MethodBinding::bounds_name_param(&this.state.symbolic_impl_node.where_bounds, param)) {
            return true;
        }
        const owner_bounds: TraitBound[]* = this.owner_declared_bounds();
        return owner_bounds != null && MethodBinding::bounds_name_param(owner_bounds, param);
    }

    /// Whether a bound in scope of the body being walked - the function's
    /// `where` clause, the impl's, or the owner declaration's - gives `param`
    /// the trait `trait_def`: names it, or names a trait it is a supertrait
    /// of.  Compared by identity.
    param_bounded_by(&this, param: GenericParamType*, trait_def: DefId) -> boolean {
        const func: FunctionDeclNode* = this.state.symbolic_current_func;
        if (func != null && this.bounds_give(&func.trait_bounds, param, trait_def)) { return true; }
        if (this.state.symbolic_impl_node != null
            && this.bounds_give(&this.state.symbolic_impl_node.where_bounds, param, trait_def)) {
            return true;
        }
        const owner_bounds: TraitBound[]* = this.owner_declared_bounds();
        return owner_bounds != null && this.bounds_give(owner_bounds, param, trait_def);
    }

    /// The traits the bounds in scope of the body being walked name on
    /// `param` itself.
    param_bound_traits(&this, param: GenericParamType*) -> DefId[] {
        mut out: DefId[] = [];
        const func: FunctionDeclNode* = this.state.symbolic_current_func;
        if (func != null) { MethodBinding::push_bound_traits(&func.trait_bounds, param, &out); }
        if (this.state.symbolic_impl_node != null) {
            MethodBinding::push_bound_traits(&this.state.symbolic_impl_node.where_bounds, param, &out);
        }
        const owner_bounds: TraitBound[]* = this.owner_declared_bounds();
        if (owner_bounds != null) { MethodBinding::push_bound_traits(owner_bounds, param, &out); }
        return out;
    }

    static push_bound_traits(bounds: &TraitBound[], param: GenericParamType*, out: mut &DefId[]) -> void {
        for (mut i: i64 = 0; i < bounds.length; i++) {
            if (!MethodBinding::bound_names_param(&bounds[i], param)) { continue; }
            for (mut ti: i64 = 0; ti < bounds[i].trait_refs.length; ti++) {
                const d: DefId = bounds[i].trait_refs[ti].definition();
                if (d.is_valid()) { out.push(d); }
            }
        }
    }

    /// Whether one of `bounds` on `param` itself names `trait_def` or a trait
    /// `trait_def` is a supertrait of.
    bounds_give(&this, bounds: &TraitBound[], param: GenericParamType*, trait_def: DefId) -> boolean {
        for (mut i: i64 = 0; i < bounds.length; i++) {
            if (!MethodBinding::bound_names_param(&bounds[i], param)) { continue; }
            for (mut ti: i64 = 0; ti < bounds[i].trait_refs.length; ti++) {
                const chain: DefId[] = this.trait_chain(bounds[i].trait_refs[ti].definition());
                for (mut k: i64 = 0; k < chain.length; k++) {
                    if (chain[k].equals(trait_def)) { return true; }
                }
            }
        }
        return false;
    }

    /// Whether one of `bounds` has `param` itself as its subject; a bound on a
    /// projection of it (`T::Item: Ord`) constrains the projection, not `T`.
    static bounds_name_param(bounds: &TraitBound[], param: GenericParamType*) -> boolean {
        for (mut i: i64 = 0; i < bounds.length; i++) {
            if (MethodBinding::bound_names_param(&bounds[i], param)) { return true; }
        }
        return false;
    }

    /// Whether the bound `b` has `param` itself as its subject.
    static bound_names_param(b: TraitBound*, param: GenericParamType*) -> boolean {
        return !b.has_projection_subject() && param.declared_by(b.subject_sym);
    }

    /// Search `bounds` for a BARE-parameter bound on `param`; return the first
    /// bound trait's method return with the bound's associated-type args
    /// substituted and `This` rebased onto `recv`. The bare-subject sibling of
    /// `scan_projection_bounds`.  `implied`, when valid, is a bound no
    /// where-clause writes - the trait bounding `This` in its own default
    /// methods - asked before `bounds`, with no associated-type arguments.
    /// Every bound is asked, and each trait - the bound's, or the
    /// supertrait's - whose declaration answers is noted in `dir`; the
    /// return is the first answer's, computed only when `need_ret`.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    scan_param_bounds(mut &this, bounds: &TraitBound[], param: GenericParamType*,
                      method_name: SymbolStr, recv: TypeRef, implied: TypeRef,
                      need_ret: boolean, dir: BoundDirection*) -> TypeRef {
        mut out: TypeRef = TypeRef::invalid();
        const first: i64 = if (implied.is_valid()) { -1 } else { 0 };
        for (mut bi: i64 = first; bi < bounds.length; bi++) {
            const b: TraitBound* = if (bi < 0) { null } else { &bounds[bi] };
            if (b != null && b.has_projection_subject()) { continue; }
            if (b != null && !param.declared_by(b.subject_sym)) { continue; }
            const refs: i64 = if (b == null) { 1 } else { b.trait_refs.length };
            for (mut ti: i64 = 0; ti < refs; ti++) {
                const tr: TraitRef* = if (b == null) { null } else { &b.trait_refs[ti] };
                if (tr != null && tr.path.length == 0) { continue; }
                // The method registry carries both the bare and the qualified
                // key, so the bound's identity answers it without depending on
                // the leaf being unique program-wide. `subst_bound_trait_args`
                // keeps the leaf: it reaches `get_trait_decl`, which is keyed
                // by bare leaf alone, and a qualified key there misses silently.
                //
                // A bound gives its subject its trait's methods, then each
                // supertrait's, nearest first.  The bound's arguments are the
                // named trait's, not a supertrait's, so a supertrait's return
                // has only `This` rebased.
                const bound_def: DefId = if (tr == null) {
                    this.ctx.decl_index.def_of(implied, this.arena) } else { tr.definition() };
                const chain: DefId[] = this.trait_chain(bound_def);
                const depth: i64 = if (chain.length > 1) { chain.length } else { 1 };
                for (mut k: i64 = 0; k < depth; k++) {
                    const asked: DefId = if (k == 0) { bound_def } else { chain[k] };
                    const ret: TypeRef = this.trait_declared_return(asked, method_name);
                    if (!ret.is_valid()) { continue; }
                    dir.note(if (k == 0) { bound_def } else { chain[k] });
                    if (need_ret && !out.is_valid()) {
                        if (tr == null || k > 0) {
                            out = this.subst_this_in_trait_return(ret, recv);
                        } else {
                            const leaf: SymbolStr = tr.path[tr.path.length - 1];
                            const sub: TypeRef = this.subst_bound_trait_args(ret, leaf, tr);
                            out = this.subst_this_in_trait_return(sub, recv);
                        }
                    }
                    break;
                }
            }
        }
        return out;
    }

    /// The return of `method_name` called in an implement block's copy of a
    /// trait default, through a bound the default writes on a projection of
    /// `This` (`value.compare(&best)` under `where This::Item: Ord` in
    /// `min`); every trait such a bound answers through is noted in `dir`,
    /// which names the call's trait when exactly one does.
    /// The copy is made before the trait's body is walked, so it carries
    /// none of the stamps that walk writes; in the copy, `This` is the
    /// implementing type and the projection is the type it denotes for it,
    /// and a receiver of that type is the bounded receiver the default was
    /// written on.  Invalid outside such a copy, and when no bound's subject
    /// is the receiver's type.
    ![allow(lookup_by_spelling, reason = "a method's leaf asked of the traits a bound names by identity, as every bound scan beside it asks")]
    default_copy_bound_return(mut &this, recv_type: TypeRef, method_name: SymbolStr,
                              dir: BoundDirection*) -> TypeRef {
        const func: FunctionDeclNode* = this.state.current_func;
        if (func == null || !func.is_synth_default || func.trait_bounds.length == 0) { return TypeRef::invalid(); }
        if (!this.state.this_type.is_valid()) { return TypeRef::invalid(); }
        const recv: TypeRef = this.peel_all_indirection(recv_type);
        mut out: TypeRef = TypeRef::invalid();
        mut ctx: ResolutionContext = ResolutionContext::new("");
        ctx.set_this_type(this.state.this_type);
        for (mut bi: i64 = 0; bi < func.trait_bounds.length; bi++) {
            const b: TraitBound* = &func.trait_bounds[bi];
            if (!b.has_projection_subject() || b.subject_type == null) { continue; }
            // The default's receiver is the projection itself, which carries
            // no indirection to peel; in the copy the projection is a type
            // that may (`T*`), and the receiver's peeling went through it.
            const subject: TypeRef = this.peel_all_indirection(this.reduce_assoc_projections(
                this.ctx.type_resolver.resolve(b.subject_type, &ctx)));
            if (!subject.is_valid() || !subject.equals(recv)) { continue; }
            for (mut ti: i64 = 0; ti < b.trait_refs.length; ti++) {
                const tr: TraitRef* = &b.trait_refs[ti];
                if (tr.path.length == 0 || tr.refused) { continue; }
                mut ret: TypeRef = TypeRef::invalid();
                const answered: DefId = this.bound_trait_declaring(tr, method_name, &ret);
                if (!answered.is_valid()) { continue; }
                dir.note(answered);
                if (out.is_valid()) { continue; }
                // The bound's arguments are the named trait's, not a
                // supertrait's, so a supertrait's return has only `This`
                // rebased.
                if (answered.equals(tr.definition())) {
                    ret = this.subst_bound_trait_args(ret, tr.path[tr.path.length - 1], tr);
                }
                out = this.subst_this_in_trait_return(ret, recv_type);
            }
        }
        return out;
    }

    /// `t` with every pointer and reference around it peeled, as a method
    /// call's receiver is.
    peel_all_indirection(&this, t: TypeRef) -> TypeRef {
        mut out: TypeRef = t;
        for (mut depth: i32 = 0; depth < 5; depth++) {
            const inner: TypeRef = this.types.peel_indirection(out);
            if (!inner.is_valid()) { break; }
            out = inner;
        }
        return out;
    }

    /// The trait that declares `method_name` for the bound `tr`: its own
    /// trait, else the nearest supertrait that does; the declaration's
    /// return goes to `out_ret`.  Invalid when none does.
    ![allow(lookup_by_spelling, reason = "a method's leaf asked of the traits a bound names by identity, as every bound scan beside it asks")]
    bound_trait_declaring(mut &this, tr: TraitRef*, method_name: SymbolStr, out_ret: TypeRef*) -> DefId {
        const chain: DefId[] = this.trait_chain(tr.definition());
        for (mut k: i64 = 0; k < chain.length; k++) {
            const ret: TypeRef = this.trait_declared_return(chain[k], method_name);
            if (!ret.is_valid()) { continue; }
            *out_ret = ret;
            return chain[k];
        }
        return DefId::invalid();
    }

    /// The return the trait `trait_def` declares for its method
    /// `method_name`, found through the `trait-method` door; invalid when it
    /// declares none.
    ![allow(lookup_by_spelling, reason = "a method's leaf asked of a trait by identity, through the trait-method door")]
    trait_declared_return(&this, trait_def: DefId, method_name: SymbolStr) -> TypeRef {
        const slot: i64 = this.ctx.generic_registry.trait_item_slot(trait_def, method_name);
        return this.types.canonicalize_method_return(
            this.ctx.generic_registry.trait_item_return(trait_def, slot));
    }

    /// `trait_def` followed by its supertraits, transitively, by identity;
    /// empty for an invalid id or outside a build that registered traits.
    trait_chain(&this, trait_def: DefId) -> DefId[] {
        return this.ctx.generic_registry.trait_and_supertraits(trait_def);
    }

    /// The PARAMETER types of `method_name` as the trait(s) a where-clause binds
    /// the bare generic parameter `param` to declare them.
    ///
    /// The parameter-list sibling of `lookup_method_through_param_bounds`, which
    /// answers the same question for the return type. Argument classification
    /// needs the parameters: without them a call on a where-bounded receiver
    /// (`this.inner.write_from(buf)` under `where S: AsyncTransport`) leaves
    /// every argument `Unclassified`, and each consumer then guesses — the move
    /// passes read a transfer, the async carrier substitution reads a borrow.
    ///
    /// A parameter constrained by a WHERE clause rather than inline stays a
    /// plain `GenericParam` whose bounds live on the enclosing function/impl
    /// node, so the receiver's own type cannot answer this.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    param_types_through_param_bounds(mut &this, param: GenericParamType*, method_name: SymbolStr,
                                     arg_count: i64) -> TypeRef[] {
        if (param == null) { return []; }
        if (this.state.symbolic_current_func != null) {
            const r: TypeRef[] = this.scan_param_bound_param_types(
                &this.state.symbolic_current_func.trait_bounds, param, method_name, arg_count);
            if (r.length > 0) { return r; }
        }
        if (this.state.symbolic_impl_node != null) {
            const r: TypeRef[] = this.scan_param_bound_param_types(
                &this.state.symbolic_impl_node.where_bounds, param, method_name, arg_count);
            if (r.length > 0) { return r; }
        }
        return [];
    }

    /// Search `bounds` for a BARE-parameter bound on `param` and return the
    /// first bound trait's declaration of `method_name` taking `arg_count`
    /// arguments. The parameter-list sibling of `scan_param_bounds`.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    scan_param_bound_param_types(mut &this, bounds: &TraitBound[], param: GenericParamType*,
                                 method_name: SymbolStr, arg_count: i64) -> TypeRef[] {
        for (mut bi: i64 = 0; bi < bounds.length; bi++) {
            const b: TraitBound* = &bounds[bi];
            if (b.has_projection_subject()) { continue; }
            if (!param.declared_by(b.subject_sym)) { continue; }
            for (mut ti: i64 = 0; ti < b.trait_refs.length; ti++) {
                const tr: TraitRef* = &b.trait_refs[ti];
                if (tr.path.length == 0) { continue; }
                // Identity rather than the written leaf: the leaf reaches the
                // arena's leaf index only while it is unique program-wide.  The
                // bound's trait first, then its supertraits nearest first.
                const chain: DefId[] = this.trait_chain(tr.definition());
                for (mut k: i64 = 0; k < chain.length; k++) {
                    const tref: TypeRef = this.ctx.decl_index.type_of_def(chain[k]);
                    if (!tref.is_valid()) { continue; }
                    const t: Type* = this.arena.lookup(tref);
                    if (t == null || t.kind != TypeKind::Trait) { continue; }
                    const tt: TraitType* = t as TraitType*;
                    for (mut mi: i64 = 0; mi < tt.required_methods.length; mi++) {
                        const m: MethodInfo* = &tt.required_methods[mi];
                        if (!m.name.equals(method_name)) { continue; }
                        if (m.param_types.length != arg_count) { continue; }
                        mut out: TypeRef[] = [];
                        for (mut pi: i64 = 0; pi < m.param_types.length; pi++) {
                            out.push(m.param_types[pi]);
                        }
                        return out;
                    }
                }
            }
        }
        return [];
    }

    /// Search `bounds` for a projection-subject bound whose projected
    /// associated type is `proj`'s; return the first bound-trait method
    /// return for `method_name`. Mirrors the trait-scan in
    /// `lookup_method_through_bounds`.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    scan_projection_bounds(mut &this, bounds: &TraitBound[], proj: AssocProjectionType*,
                           method_name: SymbolStr, recv: TypeRef, need_ret: boolean,
                           dir: BoundDirection*) -> TypeRef {
        mut out: TypeRef = TypeRef::invalid();
        for (mut bi: i64 = 0; bi < bounds.length; bi++) {
            const b: TraitBound* = &bounds[bi];
            if (b.subject_type == null) { continue; }
            if (!this.bound_subject_is(b.subject_type, proj)) { continue; }
            for (mut ti: i64 = 0; ti < b.trait_refs.length; ti++) {
                const tr: TraitRef* = &b.trait_refs[ti];
                if (tr.path.length == 0) { continue; }
                // Identity for the registry lookup, leaf for the assoc-arg
                // substitution: `subst_bound_trait_args` reaches
                // `get_trait_decl`, which is keyed by bare leaf alone.
                // The bound's trait first, then its supertraits nearest first.
                const leaf: SymbolStr = tr.path[tr.path.length - 1];
                mut ret: TypeRef = TypeRef::invalid();
                const answered: DefId = this.bound_trait_declaring(tr, method_name, &ret);
                if (!answered.is_valid()) { continue; }
                dir.note(answered);
                if (need_ret && !out.is_valid()) {
                    // A supertrait's return has only `This` rebased: the
                    // bound's arguments are the named trait's.
                    // Bound-supplied assoc args first (`Future<i64>` ->
                    // Output); any `This` the bound left unbound then
                    // rebases onto the projection receiver rather than
                    // dangling.
                    out = if (!answered.equals(tr.definition())) { this.subst_this_in_trait_return(ret, recv) } else {
                        this.subst_this_in_trait_return(this.subst_bound_trait_args(ret, leaf, tr), recv) };
                }
            }
        }
        return out;
    }

    /// Substitute a bound's arguments into a trait-method return read straight
    /// off the trait declaration: the trait's own parameters first, then its
    /// associated types.
    ///
    /// `Deref<Target>::deref` declares `-> Target*`, so a call under
    /// `where T: Deref<U>` returns `U*`; left as `Target*` the body is typed
    /// in a parameter it does not have, which no substitution of the body's
    /// own parameters ever replaces.
    /// `Future::poll` declares `-> Poll<This::Output>`, so a bound
    /// `where S::ReadFut: Future<i64>` has to yield `Poll<i64>`.  Left
    /// unsubstituted, every bound over one trait shares a single arena type, and
    /// two projections with different Outputs (`Future<i64>` vs
    /// `Future<boolean>`) become indistinguishable at their use sites.
    /// The trait's parameters are the bound's leading arguments; associated
    /// types are trailing POSITIONAL trait arguments
    /// (`generic_params.length + assoc_idx` - the same sugar
    /// `implement trait Iterator<i32>` uses), so the bound's own `type_args`
    /// supply both directly.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    subst_bound_trait_args(mut &this, ret: TypeRef, trait_leaf: SymbolStr,
                           tr: TraitRef*) -> TypeRef {
        const tdecl: TraitDeclNode* = this.ctx.generic_registry.get_trait_decl(tr.definition());
        if (tdecl == null) { return ret; }
        if (tdecl.generic_params.length == 0 && tdecl.assoc_types.length == 0) { return ret; }
        mut rc: ResolutionContext = ResolutionContext::new("");
        this.symbolic.symbolic_bind_params(&rc);
        mut out: TypeRef = ret;
        mut params: TypeRef[] = [];
        mut args: TypeRef[] = [];
        for (mut g: i64 = 0; g < tdecl.generic_params.length && g < tr.type_args.length; g++) {
            const gp: GenericParamNode* = tdecl.generic_params[g];
            if (gp == null) { continue; }
            const arg: TypeRef = this.ctx.type_resolver.resolve(tr.type_args[g], &rc);
            if (!arg.is_valid()) { continue; }
            params.push(this.symbolic.symbolic_param_ref(gp, g as u64));
            args.push(arg);
        }
        if (params.length > 0) {
            const by_param: TypeSubstitution = TypeSubstitution::from_params(&params, &args);
            out = by_param.apply(out, this.arena);
        }
        const trait_ty: TypeRef = this.ctx.decl_index.type_of_def(tr.definition());
        for (mut a: i64 = 0; a < tdecl.assoc_types.length; a++) {
            const decl: AssocTypeDeclNode* = tdecl.assoc_types[a];
            if (decl == null) { continue; }
            const idx: i64 = tdecl.generic_params.length + a;
            if (idx < 0 || idx >= tr.type_args.length) { continue; }
            const arg: TypeRef = this.ctx.type_resolver.resolve(tr.type_args[idx], &rc);
            if (!arg.is_valid()) { continue; }
            out = this.subst_assoc_slot(out, trait_ty, a, arg);
        }
        return out;
    }

    /// Replace every projection of the `slot`-th associated type of the trait
    /// `trait_ty` inside `ty` with `repl`, rebuilding the enclosing type
    /// structurally.  Mirrors `reduce_assoc_projections`, but keyed on the
    /// projected associated type instead of on a concrete base.
    ///
    /// It deliberately does NOT cache onto the `AssocProjectionType`: the
    /// projection is trait-relative (`This::Output` as written in the trait decl)
    /// and interned once, so it is shared by every bound over that trait -
    /// pinning one bound's answer would leak into all the others.
    subst_assoc_slot(mut &this, ty: TypeRef, trait_ty: TypeRef, slot: i64, repl: TypeRef) -> TypeRef {
        if (!ty.is_valid()) { return ty; }
        const t: Type* = this.arena.lookup(ty);
        if (t == null) { return ty; }
        match (t.kind) {
            TypeKind::AssocProjection => {
                const proj: AssocProjectionType* = t as AssocProjectionType*;
                if (proj.slot == slot && proj.owning_trait.equals(trait_ty)) { return repl; }
                const base: TypeRef = this.subst_assoc_slot(proj.base, trait_ty, slot, repl);
                if (base.equals(proj.base)) { return ty; }
                return this.arena.create_assoc_projection(base, proj.member, proj.owning_trait, proj.slot);
            }
            TypeKind::Pointer => {
                const p: PointerType* = t as PointerType*;
                const inner: TypeRef = this.subst_assoc_slot(p.pointee, trait_ty, slot, repl);
                if (inner.equals(p.pointee)) { return ty; }
                return this.arena.get_pointer_to(inner);
            }
            TypeKind::Reference => {
                const r: ReferenceType* = t as ReferenceType*;
                const inner: TypeRef = this.subst_assoc_slot(r.referent, trait_ty, slot, repl);
                if (inner.equals(r.referent)) { return ty; }
                return this.arena.get_reference_to(inner, r.mutability);
            }
            TypeKind::Array => {
                const a: ArrayType* = t as ArrayType*;
                const inner: TypeRef = this.subst_assoc_slot(a.element, trait_ty, slot, repl);
                if (inner.equals(a.element)) { return ty; }
                return this.arena.get_array_of(inner, a.size);
            }
            TypeKind::Optional => {
                const o: OptionalType* = t as OptionalType*;
                const inner: TypeRef = this.subst_assoc_slot(o.wrapped, trait_ty, slot, repl);
                if (inner.equals(o.wrapped)) { return ty; }
                return this.arena.get_optional_of(inner);
            }
            TypeKind::Function => {
                const f: FunctionType* = t as FunctionType*;
                const new_ret: TypeRef = this.subst_assoc_slot(f.return_type, trait_ty, slot, repl);
                mut changed: boolean = !new_ret.equals(f.return_type);
                mut new_params: TypeRef[] = [];
                for (mut i: i64 = 0; i < f.param_types.length; i++) {
                    const np: TypeRef = this.subst_assoc_slot(f.param_types[i], trait_ty, slot, repl);
                    new_params.push(np);
                    if (!np.equals(f.param_types[i])) { changed = true; }
                }
                if (!changed) { return ty; }
                return this.arena.get_function(new_ret, new_params, f.is_variadic);
            }
            TypeKind::Tuple => {
                const tup: TupleType* = t as TupleType*;
                mut changed_t: boolean = false;
                mut new_elems: TypeRef[] = [];
                for (mut i: i64 = 0; i < tup.elements.length; i++) {
                    const ne: TypeRef = this.subst_assoc_slot(tup.elements[i], trait_ty, slot, repl);
                    new_elems.push(ne);
                    if (!ne.equals(tup.elements[i])) { changed_t = true; }
                }
                if (!changed_t) { return ty; }
                return this.arena.get_tuple(new_elems);
            }
            TypeKind::InstantiatedType => {
                const inst: InstantiatedType* = t as InstantiatedType*;
                mut changed_i: boolean = false;
                mut new_args: TypeRef[] = [];
                for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                    const na: TypeRef = this.subst_assoc_slot(inst.type_args[i], trait_ty, slot, repl);
                    new_args.push(na);
                    if (!na.equals(inst.type_args[i])) { changed_i = true; }
                }
                if (!changed_i) { return ty; }
                return this.arena.create_instantiation(inst.generic_base, new_args);
            }
            _ => { return ty; }
        }
    }

    /// The projected member name of a projection type-annotation, or empty for
    /// any other annotation shape.
    projection_ann_member(&this, ann: TypeAnnotation*) -> SymbolStr {
        if (ann == null) { return SymbolStr::empty(); }
        match (*ann) {
            TypeAnnotation::Projection(pj) => { return pj.member; }
            _ => { return SymbolStr::empty(); }
        }
    }

    /// Whether the written projection `ann` (a bound's subject, `This::Item`)
    /// names the associated type `proj` is a projection of: the same trait,
    /// and the same position there once the `assoc-type` door has placed the
    /// written leaf.
    bound_subject_is(&this, ann: TypeAnnotation*, proj: AssocProjectionType*) -> boolean {
        if (ann == null || proj == null || proj.slot < 0) { return false; }
        match (*ann) {
            TypeAnnotation::Projection(pj) => {
                const trait_ty: TypeRef = this.ctx.type_resolver.projection_trait(pj);
                if (!trait_ty.equals(proj.owning_trait)) { return false; }
                const tdecl: TraitDeclNode* = this.ctx.type_resolver.trait_decl_of(trait_ty);
                return tdecl != null && tdecl.assoc_type_index(pj.member) == proj.slot;
            }
            _ => { return false; }
        }
    }

    /// The registered type a written argument names, off its stamp: a
    /// declaration's type (its template, for an instantiation), a
    /// primitive's.  Invalid for a type parameter, a projection, or a shape
    /// that names no registered type.
    item_type_of(&this, ann: TypeAnnotation*) -> TypeRef {
        if (ann == null) { return TypeRef::invalid(); }
        return match (*ann) {
            TypeAnnotation::Named(n) => {
                match (n.res.require(Text::new("method_binding:item annotation"))) {
                    Res::Def(d)    => { this.ctx.decl_index.type_of_def(d) }
                    Res::PrimTy(p) => { this.ctx.type_resolver.resolve_primitive(p) }
                    _              => { TypeRef::invalid() }
                }
            }
            TypeAnnotation::Primitive(p) => { this.ctx.type_resolver.resolve_primitive(p.name) }
            TypeAnnotation::Generic(g)   => { this.item_type_of(g.base) }
            TypeAnnotation::Reference(r) => { this.item_type_of(r.inner) }
            TypeAnnotation::Pointer(p)   => { this.item_type_of(p.inner) }
            _ => { TypeRef::invalid() }
        };
    }

    /// True when a projection-bounded trait-DEFAULT method `method_name`
    /// (`min`/`max` with `where This::Item: Ord`) is NOT applicable to the
    /// concrete receiver `recv_type` because its Item does not implement a bound
    /// trait. This lets sema reject `nonOrdIter.min()` cleanly (a normal
    /// "no method" E0358) instead of resolving it via the trait default and
    /// leaving it to fail at codegen (E0636). Mirrors the synthesize-time
    /// default-filter applicability check, but on the CALL side. Returns false
    /// (do not block) for symbolic receivers or symbolic Item types.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    projection_default_unavailable(&this, recv_type: TypeRef, method_name: SymbolStr) -> boolean {
        if (!method_name.is_valid()) { return false; }
        // The WRITTEN heads: the Item is read off the head's positional trait
        // arguments, which a placed clone has already substituted.
        const blocks: ImplBlockNode*[] = this.ctx.generic_registry.template_trait_impls_of(recv_type, this.intern);
        for (mut ti: i64 = 0; ti < blocks.length; ti++) {
            const dimpl: ImplBlockNode* = blocks[ti];
            const tdecl: TraitDeclNode* = this.ctx.generic_registry.get_trait_decl(dimpl.trait_def);
            if (tdecl == null) { continue; }
            // The trait's default-bodied method of this name, if projection-bounded.
            mut mfunc: FunctionDeclNode* = null;
            for (mut mi: i64 = 0; mi < tdecl.methods.length; mi++) {
                const f: FunctionDeclNode* = tdecl.methods[mi];
                if (f != null && f.name.equals(method_name) && f.has_body()) { mfunc = f; break; }
            }
            if (mfunc == null) { continue; }
            if (this.projection_bound_fails(mfunc, dimpl, tdecl)) { return true; }
        }
        return false;
    }

    /// Whether any projection-subject where-bound on `mfunc` has a CONCRETE Item
    /// (drawn from `impl_node`'s positional trait args) that fails the bound
    /// trait. Symbolic Item (a projection, or an impl generic param) -> false.
    projection_bound_fails(&this, mfunc: FunctionDeclNode*, impl_node: ImplBlockNode*,
                           tdecl: TraitDeclNode*) -> boolean {
        if (mfunc == null || impl_node == null || tdecl == null) { return false; }
        if (impl_node.trait_annotation == null) { return false; }
        // The impl's positional trait-arg annotations.
        mut has_args: boolean = false;
        mut arg_len: i64 = 0;
        match (*impl_node.trait_annotation) {
            TypeAnnotation::Generic(g) => { has_args = true; arg_len = g.args.length; }
            _ => { }
        }
        if (!has_args) { return false; }
        for (mut bi: i64 = 0; bi < mfunc.trait_bounds.length; bi++) {
            const b: TraitBound* = &mfunc.trait_bounds[bi];
            if (!b.has_projection_subject()) { continue; }
            const member: SymbolStr = this.projection_ann_member(b.subject_type);
            if (!member.is_valid()) { continue; }
            const assoc_idx: i64 = tdecl.assoc_type_index(member);
            if (assoc_idx < 0) { continue; }
            const arg_idx: i64 = tdecl.generic_params.length + assoc_idx;
            if (arg_idx < 0 || arg_idx >= arg_len) { continue; }
            mut item_ann: TypeAnnotation* = null;
            match (*impl_node.trait_annotation) {
                TypeAnnotation::Generic(g) => { item_ann = g.args[arg_idx]; }
                _ => { }
            }
            if (item_ann == null) { continue; }
            // Symbolic Item (projection or impl-declared param) -> undecidable, keep.
            match (*item_ann) {
                TypeAnnotation::Projection(_) => { continue; }
                _ => { }
            }
            // A concrete Item - its registered type, off the stamp - must
            // implement every bound trait, asked of the trait's IDENTITY and
            // the type: a leaf answers for every module's trait and type of
            // that leaf, and `.min()` on an iterator of one module's `Rank`
            // was admitted because another module's `Rank` is `Ord`.
            const item_ty: TypeRef = this.item_type_of(item_ann);
            if (!item_ty.is_valid()) { continue; }
            for (mut ri: i64 = 0; ri < b.trait_refs.length; ri++) {
                const tr: TraitRef* = &b.trait_refs[ri];
                if (tr.path.length == 0) { continue; }
                if (this.ctx.generic_registry.select_trait_impl(tr.definition(), item_ty, this.intern) == null) {
                    return true;
                }
            }
        }
        return false;
    }

    /// Scan registered trait decls for one that defines `method_name`; returns the
    /// trait's bare name (or empty), for the "implement the owning trait" hint.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    lookup_trait_defining_method(&this, method_name: SymbolStr) -> SymbolStr {
        return this.ctx.generic_registry.find_trait_defining_method(method_name);
    }

    /// GATED: mono-after-sema (R1). When `member.generic_args` carry explicit
    /// method-level args (`obj.method<U>(...)`), re-resolve the method's template
    /// return annotation with the receiver's + the explicit args bound.  Falls
    /// back to `fallback` (the bare-lookup return) on any miss - these
    /// `return fallback` exits are the pre-mono re-derivation; keep only the
    /// symbolic-walk branch once sema is authoritative post-mono.
    resolve_method_return_with_explicit_args(mut &this, recv_type: TypeRef,
                                             member: MemberAccessNode*,
                                             fallback: TypeRef) -> TypeRef {
        if (member.generic_args.length == 0)   { return fallback; }

        // An explicit arg naming the enclosing body's own parameters
        // (`raw.cast::<F>()` inside `f<F>`) types the return abstractly
        // (`NonNull<F>`): the call after it is selected on that instantiation
        // through its template, and is typed before monomorphization like
        // every other call in the body.  An arg that names nothing leaves the
        // call untyped rather than typed by the bare lookup's `fallback`.
        if (this.state.in_symbolic_check) {
            mut sym_ctx: ResolutionContext = ResolutionContext::new("");
            this.symbolic.symbolic_bind_params(&sym_ctx);
            for (mut i: i64 = 0; i < member.generic_args.length; i++) {
                const a: TypeRef = this.ctx.type_resolver.resolve(member.generic_args[i], &sym_ctx);
                if (!a.is_valid()) { return TypeRef::invalid(); }
            }
        }

        // Unwrap one layer of Pointer/Reference to the owning InstantiatedType /
        // template Struct/Class.
        mut owner_ref: TypeRef = recv_type;
        mut owner_t: Type* = this.arena.lookup(owner_ref);
        mut depth: i32 = 0;
        while (owner_t != null && depth < 5) {
            if (owner_t.kind == TypeKind::Pointer) {
                owner_ref = (owner_t as PointerType*).pointee;
                owner_t = this.arena.lookup(owner_ref);
            } else if (owner_t.kind == TypeKind::Reference) {
                owner_ref = (owner_t as ReferenceType*).referent;
                owner_t = this.arena.lookup(owner_ref);
            } else {
                break;
            }
            depth += 1;
        }
        if (owner_t == null) { return fallback; }

        // The owner may be a pre-mono InstantiatedType wrapper OR a post-mono
        // concrete aggregate (single-id identity flips the slot in place).  Recover
        // its instantiation view either way so the base TEMPLATE's method AST is
        // found - keying off a concrete's own spec name ("NonNull_u8") finds no
        // template and leaks a sibling spec's return.
        const owner_base: TypeRef = this.types.view_generic_base(owner_ref);
        mut owner_ast: ASTNode* = null;
        if (owner_base.is_valid()) {
            const tmpl: TemplateEntry* =
                this.ctx.generic_registry.template_of_type(owner_base);
            if (tmpl != null) { owner_ast = tmpl.ast_node; }
        }
        if (owner_ast == null) {
            owner_ast = this.ctx.generic_registry.lookup_inherent_owner(owner_ref);
            if (owner_ast == null) {
                const tmpl: TemplateEntry* = this.ctx.generic_registry.template_of_type(owner_ref);
                if (tmpl != null) { owner_ast = tmpl.ast_node; }
            }
        }
        // Primitive / non-generic receiver whose generic method lives in an
        // inherent `implement T { ... }` block (e.g. `"42".parse_int<u64>()` on
        // `implement string`).  There is no Struct/Class/InstantiatedType AST to
        // walk, but the inherent-impl registry holds the block.  Bind the
        // method's OWN generic params from the explicit args and resolve its
        // return annotation directly.
        if (owner_ast == null) {
            const im: MethodNode* = this.ctx.generic_registry.find_inherent_impl_method(
                owner_ref, member.member, member.generic_args.length);
            if (im != null && im.func != null
                    && im.func.return_type_annotation != null) {
                mut imp_ctx: ResolutionContext = ResolutionContext::new("");
                this.symbolic.symbolic_bind_params(&imp_ctx);
                for (mut i: i64 = 0; i < im.func.generic_params.length; i++) {
                    const gp: GenericParamNode* = im.func.generic_params[i];
                    if (gp == null) { continue; }
                    const ar: TypeRef = this.ctx.type_resolver.resolve(member.generic_args[i], &imp_ctx);
                    if (!ar.is_valid()) { return fallback; }
                    imp_ctx.add_binding(gp.sym_id, gp.name, ar);
                }
                const ir: TypeRef = this.ctx.type_resolver.resolve(
                    im.func.return_type_annotation, &imp_ctx);
                if (ir.is_valid()) { return ir; }
            }
        }
        if (owner_ast == null) { return fallback; }

        const empty_methods: MethodNode*[] = [];
        const empty_params: GenericParamNode*[] = [];
        mut owner_methods: &MethodNode*[] = &empty_methods;
        mut owner_params:  &GenericParamNode*[] = &empty_params;
        if (owner_ast.kind == NodeKind::StructDeclaration) {
            const sn: StructDeclNode* = owner_ast as StructDeclNode*;
            owner_methods = &sn.methods;
            owner_params  = &sn.generic_params;
        } else if (owner_ast.kind == NodeKind::UnionDeclaration) {
            const un: UnionDeclNode* = owner_ast as UnionDeclNode*;
            owner_methods = &un.methods;
            owner_params  = &un.generic_params;
        } else if (owner_ast.kind == NodeKind::ClassDeclaration) {
            const cn: ClassDeclNode* = owner_ast as ClassDeclNode*;
            owner_methods = &cn.methods;
            owner_params  = &cn.generic_params;
        } else {
            return fallback;
        }

        mut found: MethodNode* = null;
        for (mut k: i64 = 0; k < owner_methods.length; k++) {
            const m: MethodNode* = owner_methods[k];
            if (m == null || m.func == null) { continue; }
            if (!m.func.name.equals(member.member)) { continue; }
            if (m.func.generic_params.length != member.generic_args.length) { continue; }
            found = m;
            break;
        }
        mut impl_block: ImplBlockNode* = null;
        if (found == null) {
            found = this.find_method_in_trait_impls(
                owner_ref, member.member, member.generic_args.length, &impl_block);
            if (found != null && impl_block != null) {
                owner_params = &impl_block.generic_params;
            }
        }
        if (found == null) { return fallback; }
        const ret_ann: TypeAnnotation* = found.func.return_type_annotation;
        if (ret_ann == null) { return fallback; }

        mut res_ctx: ResolutionContext = ResolutionContext::new("");
        if (owner_base.is_valid()) {
            const owner_nargs: i64 = this.types.view_type_arg_count(owner_ref);
            const n: i64 = if (owner_params.length < owner_nargs) {
                owner_params.length
            } else {
                owner_nargs
            };
            for (mut i: i64 = 0; i < n; i++) {
                const gp: GenericParamNode* = owner_params[i];
                if (gp == null) { continue; }
                res_ctx.add_binding(gp.sym_id, gp.name, this.types.view_type_arg_at(owner_ref, i));
            }
        }
        // The explicit args are the caller's spelling; in a generic body they
        // may name its parameters, bound after the owner's so those win.
        this.symbolic.symbolic_bind_params(&res_ctx);
        for (mut i: i64 = 0; i < found.func.generic_params.length; i++) {
            const gp: GenericParamNode* = found.func.generic_params[i];
            if (gp == null) { continue; }
            const arg_ref: TypeRef = this.ctx.type_resolver.resolve(member.generic_args[i], &res_ctx);
            if (!arg_ref.is_valid()) { return fallback; }
            res_ctx.add_binding(gp.sym_id, gp.name, arg_ref);
        }
        const refined: TypeRef = this.ctx.type_resolver.resolve(ret_ann, &res_ctx);
        if (!refined.is_valid()) { return fallback; }
        return refined;
    }

    /// Search the trait impls selected for `owner_ref` for a method named
    /// `method_name` whose own generic-param count matches `n_generic_args`;
    /// writes the owning impl block through `out_impl`.  The impls are the
    /// registry's candidates in registration order: a placed clone when the
    /// receiver is a specialization, else the written heads that unify.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    find_method_in_trait_impls(&this, owner_ref: TypeRef, method_name: SymbolStr,
                               n_generic_args: i64, out_impl: ImplBlockNode**) -> MethodNode* {
        const blocks: ImplBlockNode*[] = this.ctx.generic_registry.trait_impls_of(owner_ref, this.intern);
        for (mut i: i64 = 0; i < blocks.length; i++) {
            const impl_node: ImplBlockNode* = blocks[i];
            for (mut k: i64 = 0; k < impl_node.methods.length; k++) {
                const m: MethodNode* = impl_node.methods[k];
                if (m == null || m.func == null) { continue; }
                if (!m.func.name.equals(method_name)) { continue; }
                if (m.func.generic_params.length != n_generic_args) { continue; }
                *out_impl = impl_node;
                return m;
            }
        }
        return null;
    }

    /// First method named `name` in `methods` that has its OWN generic params.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    find_generic_method_in(&this, methods: &MethodNode*[], name: SymbolStr) -> MethodNode* {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null) { continue; }
            if (!m.func.name.equals(name)) { continue; }
            if (m.func.generic_params.length == 0) { continue; }
            return m;
        }
        return null;
    }

    /// Generic trait DEFAULT method named `method_name` on any trait the receiver's
    /// base implements (`map<B>`/`fold<Acc>` on `Iterator`), not yet cloned into
    /// the impl block pre-mono.  Returns the trait decl's FunctionDeclNode, or null.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    find_generic_trait_default(mut &this, recv_type: TypeRef,
                               method_name: SymbolStr) -> FunctionDeclNode* {
        const blocks: ImplBlockNode*[] = this.ctx.generic_registry.template_trait_impls_of(recv_type, this.intern);
        for (mut i: i64 = 0; i < blocks.length; i++) {
            const td: TraitDeclNode* = this.ctx.generic_registry.get_trait_decl(blocks[i].trait_def);
            if (td == null) { continue; }
            for (mut k: i64 = 0; k < td.methods.length; k++) {
                const f: FunctionDeclNode* = td.methods[k];
                if (f == null) { continue; }
                if (!f.name.equals(method_name)) { continue; }
                if (f.generic_params.length == 0) { continue; }
                return f;
            }
        }
        return null;
    }

    /// Like `find_method_in_trait_impls` but matches by name + has-own-generics
    /// (the inferred no-turbofish path solves `<U>` from arguments), over the
    /// same candidate set.  With
    /// `only_trait`, only that trait's impls are candidates.  Without one,
    /// what this answers is the method's SIGNATURE, for the call's bindings
    /// and return type: an unstamped call several traits provide is refused
    /// as ambiguous by the argument check once the receiver is concrete, and
    /// until then any candidate's signature serves; which body is bound is
    /// decided where the stamp is read.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    find_generic_method_in_trait_impls(&this, owner_ref: TypeRef, method_name: SymbolStr,
                                       only_trait: DefId,
                                       out_impl: ImplBlockNode**) -> MethodNode* {
        const blocks: ImplBlockNode*[] = this.ctx.generic_registry.trait_impls_of(owner_ref, this.intern);
        for (mut i: i64 = 0; i < blocks.length; i++) {
            const impl_node: ImplBlockNode* = blocks[i];
            if (only_trait.is_valid() && !impl_node.trait_def.equals(only_trait)) { continue; }
            const m: MethodNode* = this.find_generic_method_in(&impl_node.methods, method_name);
            if (m == null) { continue; }
            *out_impl = impl_node;
            return m;
        }
        return null;
    }

    /// Abstract-receiver method lookup (symbolic walk only): `value.fmt(f)` where
    /// `value: T`.  Recovers the param's bound trait from the impl/method where
    /// clause, the only place a bound is written, then finds the generic
    /// method on the bound trait's decl.  Returns a context binding `This` -> the
    /// abstract receiver; `*out_func` is null when nothing is found.
    find_generic_method_on_receiver_bounds(mut &this, recv_type: TypeRef,
                                           member: MemberAccessNode*,
                                           out_func: FunctionDeclNode**) -> ResolutionContext {
        *out_func = null;
        mut rc: ResolutionContext = ResolutionContext::new("");
        if (!this.state.in_symbolic_check)      { return rc; }
        if (member == null)                     { return rc; }

        mut peeled: TypeRef = recv_type;
        mut t: Type* = this.arena.lookup(peeled);
        mut depth: i32 = 0;
        while (t != null && depth < 5) {
            if (t.kind == TypeKind::Reference) {
                peeled = (t as ReferenceType*).referent;
                t = this.arena.lookup(peeled);
            } else if (t.kind == TypeKind::Pointer) {
                peeled = (t as PointerType*).pointee;
                t = this.arena.lookup(peeled);
            } else {
                break;
            }
            depth += 1;
        }
        if (t == null) { return rc; }

        if (t.kind != TypeKind::GenericParam) { return rc; }
        const gpt: GenericParamType* = t as GenericParamType*;

        mut bound_leaves: DefId[] = [];
        if (this.state.symbolic_impl_node != null) {
            for (mut bi: i64 = 0; bi < this.state.symbolic_impl_node.where_bounds.length; bi++) {
                const bound: TraitBound* = &this.state.symbolic_impl_node.where_bounds[bi];
                if (!gpt.declared_by(bound.subject_sym)) { continue; }
                for (mut ti: i64 = 0; ti < bound.trait_refs.length; ti++) {
                    const tr: TraitRef* = &bound.trait_refs[ti];
                    if (tr.path.length == 0) { continue; }
                    bound_leaves.push(tr.definition());
                }
            }
        }
        if (this.state.symbolic_current_func != null) {
            for (mut wi: i64 = 0; wi < this.state.symbolic_current_func.trait_bounds.length; wi++) {
                const wb: TraitBound* = &this.state.symbolic_current_func.trait_bounds[wi];
                if (!gpt.declared_by(wb.subject_sym)) { continue; }
                for (mut ti: i64 = 0; ti < wb.trait_refs.length; ti++) {
                    const tr: TraitRef* = &wb.trait_refs[ti];
                    if (tr.path.length == 0) { continue; }
                    bound_leaves.push(tr.definition());
                }
            }
        }
        mut found: FunctionDeclNode* = null;
        for (mut i: i64 = 0; i < bound_leaves.length && found == null; i++) {
            const td: TraitDeclNode* = this.ctx.generic_registry.get_trait_decl(bound_leaves[i]);
            if (td == null) { continue; }
            for (mut k: i64 = 0; k < td.methods.length; k++) {
                const f: FunctionDeclNode* = td.methods[k];
                if (f == null) { continue; }
                if (!f.name.equals(member.member)) { continue; }
                if (f.generic_params.length == 0) { continue; }
                found = f;
                break;
            }
        }
        if (found != null) {
            // `found` is a method of the BOUND TRAIT, so the annotations resolved
            // through this context were written in the trait's declaration file --
            // not in the module holding the `where` clause that named the bound,
            // and not in the module being checked.  The receiver is a generic param
            // and has no module of its own, so there is nothing here to key off
            // except the declaration.
            rc.set_this_type(recv_type);
            *out_func = found;
        }
        return rc;
    }

    /// Abstract-receiver companion to `stash_method_call_bindings`: stash the
    /// method-level bindings of an abstract-receiver call (`value.fmt(f)`) off the
    /// receiver param's trait bound, so mono doesn't re-infer.  No-op outside a
    /// symbolic walk or when no bound trait carries the generic method.
    stash_abstract_receiver_method(mut &this, recv_type: TypeRef,
                                   member: MemberAccessNode*, call: CallExprNode*) -> void {
        if (call == null || member == null) { return; }
        if (!this.state.in_symbolic_check)  { return; }
        mut orig_func: FunctionDeclNode* = null;
        mut owner_ctx: ResolutionContext =
            this.find_generic_method_on_receiver_bounds(recv_type, member, &orig_func);
        if (orig_func == null) { return; }
        const n_method_params: i64 = orig_func.generic_params.length;
        mut bindings: TypeRef[] = this.solve_method_bindings(orig_func, &owner_ctx, member, call);
        if (bindings.length != n_method_params) { return; }
        call.set_resolved_type_args(bindings);
    }

    /// Generic-owner companion to `stash_method_call_bindings`: stash the
    /// method-level bindings of a nested generic-method call made on the STILL-GENERIC
    /// owner inside its own template body (`this.try_push(item)` in
    /// `String<A>::push<T>`).  The receiver is the un-instantiated owner (`Box<A>`),
    /// so `find_generic_method_for_call` bails (its instantiation carries a generic
    /// arg) and `stash_method_call_bindings` never runs.  Without a stash, when the
    /// enclosing method is specialized (`push<Str>`) the cloned nested call reaches
    /// mono with no method type-args and is left unspecialized -> codegen E0636
    /// "no method 'try_push'".  Resolve the bindings symbolically here (they may BE
    /// the enclosing method's symbolic params, e.g. `[T]`); the substituter
    /// concretizes the stash when the enclosing method specializes, so mono's
    /// per-call path can then specialize the nested call.  No-op outside a symbolic
    /// walk or when the call already carries a stash.
    stash_owner_generic_method_bindings(mut &this, recv_type: TypeRef,
                                        member: MemberAccessNode*, call: CallExprNode*, chosen: MethodNode*) -> void {
        if (call == null || member == null) { return; }
        if (!this.state.in_symbolic_check) { return; }
        if (call.resolved_type_args.length > 0) { return; }
        // The template's method the selection chose names the method; the
        // owner's methods are asked by name only for a call it did not bind.
        const orig_func: FunctionDeclNode* = if (chosen != null && chosen.func != null) {
            chosen.func
        } else {
            this.symbolic.symbolic_find_owner_method(recv_type, member.member)
        };
        if (orig_func == null) { return; }
        const n_method_params: i64 = orig_func.generic_params.length;
        if (n_method_params == 0) { return; }
        mut owner_ctx: ResolutionContext = ResolutionContext::new("");
        this.symbolic.symbolic_bind_params(&owner_ctx);
        owner_ctx.set_this_type(recv_type);
        // `orig_func` is the OWNER's method, so the annotations
        // `solve_method_bindings` resolves through this context are that method's,
        // not the checked module's.  The receiver here is the un-instantiated
        // owner template and does carry a module, so keying off it answers -- but
        // what it answers is the owner's module, which parts company with the
        // declaring file whenever the method is a trait default (declared in the
        // trait's file) or sits in an `implement` block outside the owner's module.
        mut bindings: TypeRef[] = this.solve_method_bindings(orig_func, &owner_ctx, member, call);
        if (bindings.length != n_method_params) { return; }
        call.set_resolved_type_args(bindings);
    }

    /// The declaration of the generic method `chosen` the selection made,
    /// and the type or impl block it is written in (`out_site`), whose
    /// parameters the receiver's arguments bind: `chosen` itself when the
    /// receiver's template, its impl blocks or the receiver's own stores
    /// hold it, else the template's declaration a specialization's copy
    /// stands for.  Null when neither is held there - a trait's default,
    /// declared in the trait.  Found by identity.
    chosen_declaration(&this, chosen: MethodNode*, tmpl: TemplateEntry*, recv_type: TypeRef,
                       out_site: ASTNode**) -> MethodNode* {
        const own: ASTNode* = this.method_site(chosen, tmpl, recv_type);
        if (own != null) { *out_site = own; return chosen; }
        if (chosen.func.def.is_valid() || !chosen.func.copy_of.is_valid()) { return null; }
        const decl: ASTNode* = this.ctx.decl_index.method_decl_of(chosen.func.copy_of);
        if (decl == null || decl.kind != NodeKind::MethodDeclaration) { return null; }
        const written: MethodNode* = decl as MethodNode*;
        const site: ASTNode* = this.method_site(written, tmpl, recv_type);
        if (site == null) { return null; }
        *out_site = site;
        return written;
    }

    /// The type declaration or impl block holding the method `m` among the
    /// receiver's stores: the template's declaration and its impl blocks,
    /// a non-generic owner's declaration, its inherent blocks, the trait
    /// impls selected for it.  Null when none holds it.
    method_site(&this, m: MethodNode*, tmpl: TemplateEntry*, recv_type: TypeRef) -> ASTNode* {
        if (tmpl != null && tmpl.ast_node != null) {
            if (MethodNode::is_method_of(m, tmpl.ast_node)) { return tmpl.ast_node; }
            for (mut bi: i64 = 0; bi < tmpl.impl_blocks.length; bi++) {
                if (MethodNode::is_method_of(m, tmpl.impl_blocks[bi] as ASTNode*)) { return tmpl.impl_blocks[bi] as ASTNode*; }
            }
        }
        const owner_ast: ASTNode* = this.ctx.generic_registry.lookup_inherent_owner(recv_type);
        if (MethodNode::is_method_of(m, owner_ast)) { return owner_ast; }
        const inherent: ImplBlockNode*[] = this.ctx.generic_registry.inherent_impl_blocks(recv_type);
        for (mut bi: i64 = 0; bi < inherent.length; bi++) {
            if (MethodNode::is_method_of(m, inherent[bi] as ASTNode*)) { return inherent[bi] as ASTNode*; }
        }
        const traits: ImplBlockNode*[] = this.ctx.generic_registry.trait_impls_of(recv_type, this.intern);
        for (mut bi: i64 = 0; bi < traits.length; bi++) {
            if (MethodNode::is_method_of(m, traits[bi] as ASTNode*)) { return traits[bi] as ASTNode*; }
        }
        return null;
    }

    /// Locate the generic method targeted by `member` on `recv_type` and build the
    /// owner-binding context (receiver type params -> concrete args, plus `This`).
    /// Writes the method's FunctionDeclNode through `out_func` (null when nothing
    /// to infer).  Shared by `resolve_generic_method_return` + `stash_method_call_bindings`.
    find_generic_method_for_call(mut &this, mut recv_type: TypeRef, member: MemberAccessNode*,
                                 chosen: MethodNode*, out_func: FunctionDeclNode**) -> ResolutionContext {
        *out_func = null;
        mut owner_ctx: ResolutionContext = ResolutionContext::new("");
        if (member == null)                    { return owner_ctx; }

        // Unwrap a Pointer/Reference receiver to the underlying nominal type so
        // every method lookup below keys off the struct/class/enum rather than
        // the pointer type.  A pointer/reference receiver (`h: DefaultHasher*;
        // h.fold(x)`, or a `mut &this`-style forward) otherwise matches no
        // template / owner here, so the method's type-args are never stashed and
        // the monomorphizer leaves the generic call unspecialized -> codegen
        // emits the symbolic `fold$...T` symbol (E0900 / a runtime hang).  Value
        // receivers already arrive nominal, so this is a no-op for them.
        mut ru: Type* = this.arena.lookup(recv_type);
        mut du: i32 = 0;
        while (ru != null && du < 8) {
            if (ru.kind == TypeKind::Pointer) {
                recv_type = (ru as PointerType*).pointee;
                ru = this.arena.lookup(recv_type);
            } else if (ru.kind == TypeKind::Reference) {
                recv_type = (ru as ReferenceType*).referent;
                ru = this.arena.lookup(recv_type);
            } else {
                break;
            }
            du += 1;
        }

        // A generic receiver may be a pre-mono InstantiatedType wrapper OR a
        // post-mono concrete aggregate (single-id identity flips the slot in
        // place).  Recover its (base, args) either way, so method-generic
        // resolution keys off the base template - not the concrete's own id, which
        // has no template and would drop the call onto the shared symbolic return.
        const recv_base: TypeRef = this.types.view_generic_base(recv_type);
        const recv_nargs: i64 = this.types.view_type_arg_count(recv_type);
        // A receiver type-arg that still mentions an enclosing generic param
        // (`Inner<S>` inside `f<S>`, or a field of `Owner<S>`) can never yield a
        // CONCRETE owner binding, so the consumers that demand one must bail.
        // Inside the symbolic walk the bindings are allowed to stay symbolic:
        // `solve_method_bindings` admits an abstract binding under
        // `in_symbolic_check`, and the substituter concretizes the stash when the
        // enclosing generic specializes - the same contract
        // `stash_owner_generic_method_bindings` relies on for `this.m()`.  Bailing
        // unconditionally left every such call unstashed, and mono takes a
        // method's bindings SOLELY from that stash, so the specialization was
        // never minted and codegen reported E0636 "no method found".
        for (mut i: i64 = 0; i < recv_nargs; i++) {
            if (this.types.contains_generic_param(this.types.view_type_arg_at(recv_type, i))) {
                if (!this.state.in_symbolic_check) { return owner_ctx; }
                break;
            }
        }

        mut found: MethodNode* = null;
        const empty_params: GenericParamNode*[] = [];
        mut owner_params: &GenericParamNode*[] = &empty_params;
        // Template key: an instantiation (`Array<i32>`) keys off its generic base; a
        // BARE template struct used directly as a receiver (`this` in `implement
        // FmtWrite for struct String`, where `this` is the un-parameterized `String`,
        // not `String<GlobalAlloc>`) keys off its own type id.  Without the bare case
        // the call's method-arg bindings are never stashed, so mono can't pin the
        // generic call and codegen's name+arity fallback picks a wrong sibling spec.
        const tmpl_base: TypeRef = if (recv_base.is_valid()) { recv_base } else { recv_type };
        const tmpl: TemplateEntry* = this.ctx.generic_registry.template_of_type(tmpl_base);

        // The method the selection chose, when it has type parameters of its
        // own, is the one the call names: its declaration, and the type or
        // block whose parameters it is written in, are found by identity, and
        // no store below is asked for the member's name.
        mut by_identity: boolean = false;
        mut chosen_func: FunctionDeclNode* = null;
        if (chosen != null && chosen.func != null && chosen.func.generic_params.length > 0) {
            by_identity = true;
            mut site: ASTNode* = null;
            found = this.chosen_declaration(chosen, tmpl, recv_type, &site);
            if (found == null) {
                const d: DefId = if (chosen.func.def.is_valid()) { chosen.func.def } else { chosen.func.copy_of };
                chosen_func = this.ctx.decl_index.method_func_of(d);
            } else if (site.kind == NodeKind::ImplementationBlock) {
                owner_params = &(site as ImplBlockNode*).generic_params;
            } else if (site.kind == NodeKind::StructDeclaration) {
                owner_params = &(site as StructDeclNode*).generic_params;
            } else if (site.kind == NodeKind::UnionDeclaration) {
                owner_params = &(site as UnionDeclNode*).generic_params;
            } else if (site.kind == NodeKind::ClassDeclaration) {
                owner_params = &(site as ClassDeclNode*).generic_params;
            }
        }

        // The precedence `select_method` binds under.  A call stamped with a
        // trait names that trait's method, so its impls are asked first.
        // Otherwise the INHERENT stores, then the trait ones: an inherent
        // method of the call's name answers ahead of any trait impl's,
        // whatever order the blocks were written in.  Inherent: the
        // template's own methods and its inherent impl blocks, a non-generic
        // owner's own methods, the inherent-impl registry
        // (`"42".parse_int<u64>()` on `implement string`, or an `implement
        // struct Driver { run<F,R> }` block, which is merged into no owner's
        // method list).  Trait: the trait impls for the receiver, then a
        // trait default.
        mut trait_impl_block: ImplBlockNode* = null;
        if (!by_identity && member.resolved_trait.is_valid()) {
            found = this.find_generic_method_in_trait_impls(
                recv_type, member.member, member.resolved_trait, &trait_impl_block);
            if (found != null && trait_impl_block != null) {
                owner_params = &trait_impl_block.generic_params;
            }
        }
        if (!by_identity && found == null && tmpl != null && tmpl.ast_node != null) {
            if (tmpl.node_kind == NodeKind::StructDeclaration) {
                const sn: StructDeclNode* = tmpl.ast_node as StructDeclNode*;
                found = this.find_generic_method_in(&sn.methods, member.member);
                if (found != null) { owner_params = &sn.generic_params; }
            } else if (tmpl.node_kind == NodeKind::UnionDeclaration) {
                const un: UnionDeclNode* = tmpl.ast_node as UnionDeclNode*;
                found = this.find_generic_method_in(&un.methods, member.member);
                if (found != null) { owner_params = &un.generic_params; }
            } else if (tmpl.node_kind == NodeKind::ClassDeclaration) {
                const cn: ClassDeclNode* = tmpl.ast_node as ClassDeclNode*;
                found = this.find_generic_method_in(&cn.methods, member.member);
                if (found != null) { owner_params = &cn.generic_params; }
            }
            if (found == null) {
                for (mut bi: i64 = 0; bi < tmpl.impl_blocks.length; bi++) {
                    const ib: ImplBlockNode* = tmpl.impl_blocks[bi];
                    if (ib == null || ib.is_trait_impl()) { continue; }
                    const m: MethodNode* = this.find_generic_method_in(&ib.methods, member.member);
                    if (m != null) {
                        found = m;
                        owner_params = &ib.generic_params;
                        break;
                    }
                }
            }
        }
        if (!by_identity && found == null) {
            const owner_ast: ASTNode* = this.ctx.generic_registry.lookup_inherent_owner(recv_type);
            if (owner_ast != null) {
                if (owner_ast.kind == NodeKind::StructDeclaration) {
                    found = this.find_generic_method_in(
                        &(owner_ast as StructDeclNode*).methods, member.member);
                } else if (owner_ast.kind == NodeKind::UnionDeclaration) {
                    found = this.find_generic_method_in(
                        &(owner_ast as UnionDeclNode*).methods, member.member);
                } else if (owner_ast.kind == NodeKind::ClassDeclaration) {
                    found = this.find_generic_method_in(
                        &(owner_ast as ClassDeclNode*).methods, member.member);
                }
            }
        }
        if (!by_identity && found == null) {
            mut impl_blk: ImplBlockNode* = null;
            found = this.ctx.generic_registry.find_inherent_impl_generic_method(
                recv_type, member.member, &impl_blk);
            if (found != null && impl_blk != null) { owner_params = &impl_blk.generic_params; }
        }
        if (!by_identity && found == null) {
            found = this.find_generic_method_in_trait_impls(
                recv_type, member.member, DefId::invalid(), &trait_impl_block);
            if (found != null && trait_impl_block != null) {
                owner_params = &trait_impl_block.generic_params;
            }
        }
        mut orig_func: FunctionDeclNode* = null;
        if (found != null) {
            orig_func = found.func;
        } else if (by_identity) {
            orig_func = chosen_func;
        } else {
            orig_func = this.find_generic_trait_default(recv_type, member.member);
        }
        if (orig_func == null) { return owner_ctx; }
        if (orig_func.generic_params.length == 0) { return owner_ctx; }

        // The annotations resolved through this context (and through the clones
        // every caller makes of it) are `orig_func`'s own, so their scope is the
        // file that DECLARES the method -- not the receiver's module and not the
        // module being checked.  The three differ: a trait default's body lives in
        // the trait's file while the receiver is the implementing type, and an
        // `implement` block may sit in a third module again.  Keying off the
        // receiver type also has no answer at all for a symbolic receiver, and an
        // empty module normalizes to `Unset`, which drops every name resolved here
        // into the module-blind chain while the source reads as though a scope was
        // established.  This is set after `orig_func` is known because the
        // declaration is the thing that carries the answer; the early returns above
        // hand back an unscoped context, and every caller discards it when
        // `*out_func` is null.

        if (recv_base.is_valid()) {
            const n_owner: i64 = if (owner_params.length < recv_nargs) {
                owner_params.length
            } else {
                recv_nargs
            };
            for (mut i: i64 = 0; i < n_owner; i++) {
                const gp: GenericParamNode* = owner_params[i];
                if (gp == null) { continue; }
                owner_ctx.add_binding(gp.sym_id, gp.name, this.types.view_type_arg_at(recv_type, i));
            }
        }
        owner_ctx.set_this_type(recv_type);

        *out_func = orig_func;
        return owner_ctx;
    }

    /// A bare / negated / arithmetic-constant numeric literal is polymorphic for
    /// generic inference (adopts whatever a non-literal arg or context binds), so
    /// its `resolved_type` (the DEFAULT `i32`/`f64`) must not pin a method param.
    /// Mirrors `CallResolver::sema_arg_is_polymorphic_literal` for the method path.
    method_arg_is_polymorphic_literal(&this, expr: ExpressionNode*) -> boolean {
        if (expr == null) { return false; }
        // A suffixed literal names its own type - see the free-function mirror.
        if (sema_expr_has_numeric_suffix(expr)) { return false; }
        const node: ASTNode* = expr as ASTNode*;
        if (node.kind == NodeKind::Literal) {
            const lit: LiteralNode* = expr as LiteralNode*;
            return lit.literal_kind == LiteralKind::Integer
                || lit.literal_kind == LiteralKind::Float;
        }
        if (node.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = expr as UnaryExprNode*;
            if (u.op.kind == TokenType::Minus || u.op.kind == TokenType::Plus || u.op.kind == TokenType::Tilde) {
                return this.method_arg_is_polymorphic_literal(u.operand);
            }
            return false;
        }
        if (node.kind == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = expr as BinaryExprNode*;
            const op: TokenType = b.op.kind;
            const is_arith: boolean =
                op == TokenType::Plus || op == TokenType::Minus || op == TokenType::Star || op == TokenType::Slash || op == TokenType::Percent
                || op == TokenType::LessLess || op == TokenType::GreaterGreater || op == TokenType::Amp || op == TokenType::Pipe || op == TokenType::Caret;
            if (!is_arith) { return false; }
            return this.method_arg_is_polymorphic_literal(b.left)
                && this.method_arg_is_polymorphic_literal(b.right);
        }
        return false;
    }

    /// Solve every method-level generic param of `orig_func` for this call:
    /// explicit turbofish, else formal/actual unification (with return-type
    /// recovery + polymorphic-literal adoption, mirroring the free-fn path).
    /// Returns the bindings in declaration order, or `[]`
    /// when any stays unbound/abstract (caller defers to mono).
    solve_method_bindings(mut &this, orig_func: FunctionDeclNode*,
                          owner_ctx: ResolutionContext*, member: MemberAccessNode*,
                          call: CallExprNode*) -> TypeRef[] {
        if (member == null) { return []; }
        return this.solve_method_bindings_at(orig_func, owner_ctx, &member.generic_args, call, 0);
    }

    /// `solve_method_bindings` for a call whose method arguments start at
    /// `first_arg` - 0 for `recv.m(args)`, 1 for a path call
    /// `Owner::m(recv, args)`, whose receiver is its first argument - with
    /// the turbofish `generic_args` the call wrote for the method.
    solve_method_bindings_at(mut &this, orig_func: FunctionDeclNode*,
                             owner_ctx: ResolutionContext*, generic_args: &TypeAnnotation*[],
                             call: CallExprNode*, first_arg: i64) -> TypeRef[] {
        if (orig_func == null || call == null) { return []; }
        if (call.arguments.length < first_arg) { return []; }
        const n_method_params: i64 = orig_func.generic_params.length;
        if (n_method_params == 0) { return []; }

        mut method_bindings: TypeRef[] = [];
        for (mut i: i64 = 0; i < n_method_params; i++) {
            method_bindings.push(TypeRef::invalid());
        }

        if (generic_args.length == n_method_params && generic_args.length > 0) {
            // Explicit turbofish is authoritative.  CRITICAL: resolve in the
            // CALLER's scope, NOT through `owner_ctx` (which would shadow an
            // enclosing param sharing the receiver's param name).  Inside a
            // generic body, resolve in the enclosing symbolic-param context so an
            // enclosing `T` stays abstract for the substituter to concretize.
            mut tf_ctx_buf: ResolutionContext = ResolutionContext::new("");
            mut use_symbolic: boolean = false;
            if (this.state.in_symbolic_check) {
                this.symbolic.symbolic_bind_params(&tf_ctx_buf);
                use_symbolic = true;
            }
            for (mut i: i64 = 0; i < n_method_params; i++) {
                const tf_ctx: ResolutionContext* =
                    if (use_symbolic) { &tf_ctx_buf } else { owner_ctx };
                const tr: TypeRef = this.ctx.type_resolver.resolve(generic_args[i], tf_ctx);
                if (!tr.is_valid()) { return []; }
                if (this.types.contains_generic_param(tr) && !this.state.in_symbolic_check) {
                    return [];
                }
                method_bindings[i] = tr;
            }
        } else {
            // Infer from arguments: bind each method param to a fresh GenericParam
            // for the unifier, resolve each formal in a context with owner args
            // concrete + method params as those fresh refs, then unify vs actuals.
            mut infer_ctx: ResolutionContext = owner_ctx.clone();
            mut method_param_ids: TypeRef[] = [];
            for (mut i: i64 = 0; i < n_method_params; i++) {
                const gp: GenericParamNode* = orig_func.generic_params[i];
                if (gp == null) { return []; }
                const gp_ref: TypeRef = this.arena.create_generic_param(gp.sym_id, gp.name, i as u64);
                infer_ctx.add_binding(gp.sym_id, gp.name, gp_ref);
                method_param_ids.push(gp_ref);
            }
            mut explicit_params: VarDeclNode*[] = [];
            for (mut i: i64 = 0; i < orig_func.parameters.length; i++) {
                const p: VarDeclNode* = orig_func.parameters[i];
                if (p == null) { continue; }
                if (p.is_receiver()) { continue; }
                explicit_params.push(p);
            }
            const n_args: i64 = call.arguments.length - first_arg;
            if (explicit_params.length != n_args) { return []; }

            mut ictx: InferCtx = InferCtx::for_template(this.arena, method_param_ids);
            // Resolve each parameter's formal type once (in the fresh-param
            // context), so all three inference passes share it.
            mut formals: TypeRef[] = [];
            for (mut i: i64 = 0; i < n_args; i++) {
                const param: VarDeclNode* = explicit_params[i];
                if (param == null || param.type_annotation == null) { return []; }
                mut formal: TypeRef = this.ctx.type_resolver.resolve(param.type_annotation, &infer_ctx);
                if (!formal.is_valid()) { return []; }
                formal = this.reduce_assoc_projections(formal);
                formals.push(formal);
            }
            // PASS A - bind from NON-literal args. A BARE numeric literal (`100`)
            // carries its DEFAULT type (`i32`) in `resolved_type`, so unifying
            // `T` against it would wrongly pin `T = i32`. Skip those here and let
            // context/adoption bind them, exactly as the free-function inference
            // path does. A SUFFIXED literal (`100u64`) is not skipped: the suffix
            // is its type, so it binds `T` like any other typed argument.
            for (mut i: i64 = 0; i < n_args; i++) {
                const arg: ExpressionNode* = call.arguments[first_arg + i];
                if (arg == null) { return []; }
                if (this.method_arg_is_polymorphic_literal(arg)) { continue; }
                const actual: TypeRef = arg.resolved_type;
                if (!actual.is_valid()) { return []; }
                ictx.unify(formals[i], actual);
            }
            // PASS B - recover still-unbound method params from a CONCRETE
            // expected type via the return annotation. Not gated on `is_implicit`:
            // any generic method whose param appears in the return (`next_range<T>
            // (lo: T, hi: T) -> T` bound to a `u64` context) needs it once its
            // only value-carrying args are polymorphic literals.
            mut any_unbound: boolean = false;
            for (mut i: i64 = 0; i < n_method_params; i++) {
                if (!ictx.bindings[i].is_valid()) { any_unbound = true; break; }
            }
            if (any_unbound
                    && this.state.expected_type.is_valid()
                    && !this.types.contains_generic_param(this.state.expected_type)
                    && orig_func.return_type_annotation != null) {
                mut ret_formal: TypeRef = this.ctx.type_resolver.resolve(
                    orig_func.return_type_annotation, &infer_ctx);
                if (ret_formal.is_valid()) {
                    ret_formal = this.reduce_assoc_projections(ret_formal);
                    ictx.unify(ret_formal, this.state.expected_type);
                }
            }
            // PASS C - a polymorphic literal adopts whatever its param now binds;
            // if still unbound, it falls back to the literal's own default type.
            for (mut i: i64 = 0; i < n_args; i++) {
                const arg: ExpressionNode* = call.arguments[first_arg + i];
                if (arg == null) { return []; }
                if (!this.method_arg_is_polymorphic_literal(arg)) { continue; }
                const f_idx: i64 = ictx.binding_index(formals[i]);
                if (f_idx >= 0 && ictx.bindings[f_idx].is_valid()) { continue; }
                const lit_actual: TypeRef = arg.resolved_type;
                if (!lit_actual.is_valid()) { continue; }
                ictx.unify(formals[i], lit_actual);
            }
            // PASS D - fill a method param that appears ONLY in a where-bound
            // (`R` in `run<F, R>(fut: F) -> R where F: Future<R>`) by projecting
            // it off the now-bound subject (`R = F::Output`), so a return-only /
            // bound-only method param settles from argument inference alone - no
            // turbofish or expected-type hint required. Shares the free-function
            // projection; `ictx.bindings[i]` is index-aligned with
            // `orig_func.generic_params[i]` (both built from the same order).
            mut method_param_syms_d: SymbolID[] = [];
            for (mut i: i64 = 0; i < n_method_params; i++) {
                const gp: GenericParamNode* = orig_func.generic_params[i];
                if (gp == null) { return []; }
                method_param_syms_d.push(gp.sym_id);
            }
            this.ctx.type_resolver.project_where_bound_params_into(
                &orig_func.trait_bounds, &method_param_syms_d, &ictx, this.ctx.source_file,
                this.state.in_symbolic_check);
            for (mut i: i64 = 0; i < n_method_params; i++) {
                const b: TypeRef = ictx.bindings[i];
                if (!b.is_valid()) { return []; }
                if (this.types.contains_generic_param(b) && !this.state.in_symbolic_check) {
                    return [];
                }
                method_bindings[i] = b;
            }
        }
        return method_bindings;
    }

    /// Stash the method's concrete method-level bindings on the call so mono's
    /// `try_infer_method_call` reads them instead of re-inferring.  Called for
    /// every method call; no-op for non-generic methods / abstract bindings.
    stash_method_call_bindings(mut &this, recv_type: TypeRef,
                               member: MemberAccessNode*, call: CallExprNode*, chosen: MethodNode*) -> void {
        if (call == null || member == null) { return; }
        mut orig_func: FunctionDeclNode* = null;
        mut owner_ctx: ResolutionContext =
            this.find_generic_method_for_call(recv_type, member, chosen, &orig_func);
        if (orig_func == null) { return; }
        const n_method_params: i64 = orig_func.generic_params.length;
        mut bindings: TypeRef[] = this.solve_method_bindings(orig_func, &owner_ctx, member, call);
        if (bindings.length != n_method_params) { return; }
        call.set_resolved_type_args(bindings);
    }

    /// GATED: mono-after-sema (R1).  Resolve the CONCRETE return type of a call to
    /// a GENERIC method by inferring its method-level params and substituting both
    /// receiver + method args into the return annotation BEFORE mono runs.
    /// `resolved_callee` stays UNPINNED (mono still specializes).
    /// Returns `fallback` (the caller's prior resolution) on any miss - these
    /// exits are the pre-mono re-derivation; deletable once sema is authoritative.
    resolve_generic_method_return(mut &this, recv_type: TypeRef, member: MemberAccessNode*,
                                  call: CallExprNode*, chosen: MethodNode*, fallback: TypeRef) -> TypeRef {
        if (call == null || member == null) { return fallback; }
        mut orig_func: FunctionDeclNode* = null;
        mut owner_ctx: ResolutionContext =
            this.find_generic_method_for_call(recv_type, member, chosen, &orig_func);
        if (orig_func == null) { return fallback; }
        const ret_ann: TypeAnnotation* = orig_func.return_type_annotation;
        if (ret_ann == null) { return fallback; }
        const n_method_params: i64 = orig_func.generic_params.length;

        mut method_bindings: TypeRef[] = this.solve_method_bindings(orig_func, &owner_ctx, member, call);
        if (method_bindings.length != n_method_params) { return fallback; }

        mut ret_ctx: ResolutionContext = owner_ctx.clone();
        for (mut i: i64 = 0; i < n_method_params; i++) {
            const gp: GenericParamNode* = orig_func.generic_params[i];
            if (gp == null) { return fallback; }
            ret_ctx.add_binding(gp.sym_id, gp.name, method_bindings[i]);
        }
        ret_ctx.set_this_type(recv_type);
        mut refined: TypeRef = this.ctx.type_resolver.resolve(ret_ann, &ret_ctx);
        refined = this.reduce_assoc_projections(refined);
        if (!refined.is_valid() || this.types.contains_generic_param(refined)
                || this.types.contains_unresolved_projection(refined)) {
            return fallback;
        }
        return refined;
    }


    // -- Associated-type projection reduction --

    /// Bind impl-introduced generic params the Self type doesn't determine
    /// (`A`/`O` in `ZipIter<I,J> where I: Iterator<A>, J: Iterator<O>`) into `res_ctx`.
    proj_derive_impl_where_generics(mut &this, impl_node: ImplBlockNode*,
                                    subst: TypeSubstitution*, res_ctx: ResolutionContext*) -> void {
        if (impl_node == null || subst == null) { return; }
        if (impl_node.where_bounds.length == 0) { return; }
        for (mut bi: i64 = 0; bi < impl_node.where_bounds.length; bi++) {
            const bound: TraitBound* = &impl_node.where_bounds[bi];
            const subject: TypeRef = this.trait_checker().lookup_subst_for_param(bound.subject_sym, subst);
            if (!subject.is_valid()) { continue; }
            for (mut ti: i64 = 0; ti < bound.trait_refs.length; ti++) {
                const tr: TraitRef* = &bound.trait_refs[ti];
                if (tr.path.length == 0) { continue; }
                const concrete_args: TypeRef[] = this.ctx.type_resolver.concrete_trait_slots(subject, tr.definition());
                if (tr.type_args.length > concrete_args.length) { continue; }
                for (mut ai: i64 = 0; ai < tr.type_args.length; ai++) {
                    const ta: TypeAnnotation* = tr.type_args[ai];
                    if (ta == null) { continue; }
                    this.proj_bind_where_arg_param(ta, concrete_args[ai], subst, res_ctx);
                }
            }
        }
    }

    /// Bind a where-bound trait-arg annotation against a concrete trait arg,
    /// descending through pointer/reference wrappers.
    proj_bind_where_arg_param(mut &this, ta: TypeAnnotation*, concrete: TypeRef,
                              subst: TypeSubstitution*, res_ctx: ResolutionContext*) -> void {
        if (ta == null || !concrete.is_valid()) { return; }
        match (*ta) {
            TypeAnnotation::Named(n) => {
                if (this.trait_checker().lookup_subst_for_param(n.param_sym(), subst).is_invalid()
                        && res_ctx.lookup_binding(n.param_sym()).is_invalid()) {
                    res_ctx.add_binding(n.param_sym(), n.name, concrete);
                }
            }
            TypeAnnotation::Pointer(p) => {
                const inner: TypeRef = this.types.proj_pointer_pointee(concrete);
                if (inner.is_valid()) {
                    this.proj_bind_where_arg_param(p.inner, inner, subst, res_ctx);
                }
            }
            TypeAnnotation::Reference(r) => {
                const inner: TypeRef = this.types.proj_reference_referent(concrete);
                if (inner.is_valid()) {
                    this.proj_bind_where_arg_param(r.inner, inner, subst, res_ctx);
                }
            }
            _ => {}
        }
    }

    /// Recursively replace concrete-base associated-type projections in `ty` with
    /// their member type, caching on each `AssocProjectionType`.  Symbolic
    /// projections and projection-free types pass through unchanged.
    reduce_assoc_projections(mut &this, ty: TypeRef) -> TypeRef {
        if (!ty.is_valid()) { return ty; }
        const t: Type* = this.arena.lookup(ty);
        if (t == null) { return ty; }
        match (t.kind) {
            TypeKind::AssocProjection => {
                const proj: AssocProjectionType* = t as AssocProjectionType*;
                if (proj.resolved_type.is_valid()) { return proj.resolved_type; }
                const base: TypeRef = this.reduce_assoc_projections(proj.base);
                const reduced: TypeRef = this.ctx.type_resolver.concrete_projection(base, proj.slot, proj.owning_trait);
                if (reduced.is_valid()) {
                    proj.set_resolved_type(reduced);
                    return reduced;
                }
                return ty;
            }
            TypeKind::Pointer => {
                const p: PointerType* = t as PointerType*;
                const inner: TypeRef = this.reduce_assoc_projections(p.pointee);
                if (inner.equals(p.pointee)) { return ty; }
                return this.arena.get_pointer_to(inner);
            }
            TypeKind::Reference => {
                const r: ReferenceType* = t as ReferenceType*;
                const inner: TypeRef = this.reduce_assoc_projections(r.referent);
                if (inner.equals(r.referent)) { return ty; }
                return this.arena.get_reference_to(inner, r.mutability);
            }
            TypeKind::Array => {
                const a: ArrayType* = t as ArrayType*;
                const inner: TypeRef = this.reduce_assoc_projections(a.element);
                if (inner.equals(a.element)) { return ty; }
                return this.arena.get_array_of(inner, a.size);
            }
            TypeKind::Optional => {
                const o: OptionalType* = t as OptionalType*;
                const inner: TypeRef = this.reduce_assoc_projections(o.wrapped);
                if (inner.equals(o.wrapped)) { return ty; }
                return this.arena.get_optional_of(inner);
            }
            TypeKind::Function => {
                const f: FunctionType* = t as FunctionType*;
                const new_ret: TypeRef = this.reduce_assoc_projections(f.return_type);
                mut changed: boolean = !new_ret.equals(f.return_type);
                mut new_params: TypeRef[] = [];
                for (mut i: i64 = 0; i < f.param_types.length; i++) {
                    const np: TypeRef = this.reduce_assoc_projections(f.param_types[i]);
                    new_params.push(np);
                    if (!np.equals(f.param_types[i])) { changed = true; }
                }
                if (!changed) { return ty; }
                return this.arena.get_function(new_ret, new_params, f.is_variadic);
            }
            TypeKind::Tuple => {
                const tup: TupleType* = t as TupleType*;
                mut changed_t: boolean = false;
                mut new_elems: TypeRef[] = [];
                for (mut i: i64 = 0; i < tup.elements.length; i++) {
                    const ne: TypeRef = this.reduce_assoc_projections(tup.elements[i]);
                    new_elems.push(ne);
                    if (!ne.equals(tup.elements[i])) { changed_t = true; }
                }
                if (!changed_t) { return ty; }
                return this.arena.get_tuple(new_elems);
            }
            TypeKind::InstantiatedType => {
                const inst: InstantiatedType* = t as InstantiatedType*;
                mut changed_i: boolean = false;
                mut new_args: TypeRef[] = [];
                for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                    const na: TypeRef = this.reduce_assoc_projections(inst.type_args[i]);
                    new_args.push(na);
                    if (!na.equals(inst.type_args[i])) { changed_i = true; }
                }
                if (!changed_i) { return ty; }
                return this.arena.create_instantiation(inst.generic_base, new_args);
            }
            _ => { return ty; }
        }
    }

    /// Mono-after-sema: resolve a trait-impl method's return for a CONCRETE
    /// receiver by binding every impl param (struct params from the receiver's
    /// args + where-clause-derived params), resolving the return annotation, and
    /// reducing projections.  Invalid when not a concrete instantiation / no impl
    /// / still abstract.  `resolved_callee` stays UNPINNED.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    resolve_trait_impl_method_return(mut &this, recv_type: TypeRef,
                                     method_name: SymbolStr) -> TypeRef {
        mut subject_ref: TypeRef = recv_type;
        mut st: Type* = this.arena.lookup(subject_ref);
        mut depth: i32 = 0;
        while (st != null && depth < 5) {
            if (st.kind == TypeKind::Reference) {
                subject_ref = (st as ReferenceType*).referent;
                st = this.arena.lookup(subject_ref);
            } else if (st.kind == TypeKind::Pointer) {
                subject_ref = (st as PointerType*).pointee;
                st = this.arena.lookup(subject_ref);
            } else {
                break;
            }
            depth += 1;
        }
        if (st == null) { return TypeRef::invalid(); }
        // The subject's instantiation identity, read directly: a post-mono concrete
        // carries its own base + args, so there is no carrier to normalize to.
        const subj_nargs: i64 = this.arena.inst_type_arg_count(subject_ref);
        if (subj_nargs == 0) { return TypeRef::invalid(); }
        // The TEMPLATE's impl, not this specialization's: the impl supplies the
        // type args this projection substitutes (`Named` target arguments bound
        // to the subject's), which a placed clone has already substituted away.
        mut found_impl: ImplBlockNode* = null;
        mut found_method: MethodNode* = null;
        const blocks: ImplBlockNode*[] = this.ctx.generic_registry.template_trait_impls_of(subject_ref, this.intern);
        for (mut i: i64 = 0; i < blocks.length; i++) {
            const impl_node: ImplBlockNode* = blocks[i];
            for (mut k: i64 = 0; k < impl_node.methods.length; k++) {
                const m: MethodNode* = impl_node.methods[k];
                if (m == null || m.func == null) { continue; }
                if (!m.func.name.equals(method_name)) { continue; }
                found_impl = impl_node;
                found_method = m;
                break;
            }
            if (found_method != null) { break; }
        }
        if (found_method == null || found_impl == null) { return TypeRef::invalid(); }
        const ret_ann: TypeAnnotation* = found_method.func.return_type_annotation;
        if (ret_ann == null) { return TypeRef::invalid(); }

        mut rc: ResolutionContext = ResolutionContext::new("");
        mut subst: TypeSubstitution = TypeSubstitution::empty();
        if (found_impl.target_args.length == subj_nargs) {
            for (mut i: i64 = 0; i < found_impl.target_args.length; i++) {
                const ta: TypeAnnotation* = found_impl.target_args[i];
                if (ta == null) { continue; }
                match (*ta) {
                    TypeAnnotation::Named(n) => {
                        rc.add_binding(n.param_sym(), n.name, this.arena.inst_type_arg_at(subject_ref, i));
                        // A concrete argument written in the head is no parameter.
                        if (!n.param_sym().is_valid()) { continue; }
                        const gp_ref: TypeRef = this.arena.create_generic_param(n.param_sym(), n.name, i as u64);
                        subst.add(gp_ref, this.arena.inst_type_arg_at(subject_ref, i));
                    }
                    _ => {}
                }
            }
        }
        this.proj_derive_impl_where_generics(found_impl, &subst, &rc);
        rc.set_this_type(subject_ref);
        const resolved: TypeRef = this.ctx.type_resolver.resolve(ret_ann, &rc);
        if (!resolved.is_valid()) { return TypeRef::invalid(); }
        const reduced: TypeRef = this.reduce_assoc_projections(resolved);
        if (!reduced.is_valid() || this.types.contains_generic_param(reduced)) {
            return TypeRef::invalid();
        }
        return reduced;
    }

    /// Finalize a method-call return off a CONCRETE receiver: reduce projections,
    /// and if still abstract (an unbound where-clause impl param or an unreduced
    /// projection) recompute through the trait impl.  Unchanged when already
    /// concrete / unimprovable.
    finalize_assoc_return(mut &this, recv_type: TypeRef, member: MemberAccessNode*,
                          candidate: TypeRef) -> TypeRef {
        if (!candidate.is_valid()) { return candidate; }
        const reduced: TypeRef = this.reduce_assoc_projections(candidate);
        if (this.types.contains_generic_param(reduced)
                || this.types.contains_unresolved_projection(reduced)) {
            const via_impl: TypeRef = this.resolve_trait_impl_method_return(recv_type, member.member);
            if (via_impl.is_valid()) { return via_impl; }
        }
        return reduced;
    }
}
