/// `--emit=facts`: what each call that passes a spelling bound, each
/// comparison of spellings, and each `match` over one, as sema decided it.
///
/// A KEY is a value that names something by its text: `string`,
/// `SymbolStr`, `QualifiedName` (a path of `SymbolStr` segments) and
/// `ModulePath`, by value, by reference or as an array.  One record per
/// argument a call passes to a key parameter, and one per `==` / `!=` whose
/// operand is a key or a number read out of one.  Each record carries the
/// key's type, so a consumer takes the population it defines - condition
/// two's spellings, D32's key types - from the same file.
///
/// The records are written from what sema resolved - the call's pinned
/// declaration and its signature - so they describe the program that
/// compiled, not a reading of its source.  Tab-separated, one per line:
///
///     kind  file  line  col  index  type  provenance  receiver  callee  pin
///           callee-decl  enclosing  callee-text  enclosing-text  depth
///
/// `kind` is `call` (one per call, whatever it passes; `index` is its
/// argument count), `arg`, `sarg`, `cmp`, `match`, `noparams` (a call with
/// arguments whose parameter types sema never had) or `unaligned` (a
/// signature whose parameters could not be matched to the arguments); a call
/// the instrument cannot see into is counted rather than dropped.  `index` is
/// the argument's position, the receiver not counted, or a comparison's
/// operator.  `type` is the key parameter's type, or the compared key's.
/// `provenance` is where the argument's value comes from, and `receiver`
/// where the method's receiver does (a comparison's right and left operands).
///
/// An `arg` is decided by the PARAMETER's type.  A `sarg` is decided by the
/// argument's own VALUE, for an argument no `arg` record covers - passed to a
/// parameter whose type carries no key, to a generic or variadic parameter,
/// or to a call whose parameter types sema never had: a key, a `Text` or a
/// `Keyword`, or a number read out of one (`name.id`).  Its `type` is what
/// the value is: the key's or wrapper's name, `<name>.<member>` for a
/// number read out of one.  A `match` is one per `match` whose subject's
/// value is a spelling by the same test: `index` is how many arms carry a
/// literal pattern, `type` the subject's spelling, `provenance` where the
/// subject comes from, and `receiver` the literal patterns, comma-separated,
/// `-` for none; the callee columns are `-`:
///
///     literal:<text>         a literal as written, a string quoted
///     param:<name>           the enclosing function's own parameter
///     local:<name>@<d>=<prov>  a local declared at loop depth <d>, and where
///                            its initializer comes from (`local:mut` when
///                            it can be reassigned)
///     global:<path>          a global or constant
///     field:<type>.<member><-<prov>  a member read off a value from <prov>
///     call:<callee-text> of <prov>  a call's return, and where its first
///                            argument comes from
///     element:<prov>         an element of an array from <prov>
///     element@<d>:<prov>     the same, indexed by a local declared at loop
///                            depth <d> (a counter: the loop it drives)
///     sourceloc:<FILE|LINE>  a source-location constant
///     name:<spelling>        a name sema left unanswered
///     expr:<kind>            any other expression
///
/// read through `&`, `*` and casts.  `callee` and `enclosing` are linker
/// symbols, the identity a declaration is emitted under, and the `-text`
/// fields render them for a reader; `callee-decl` is where the callee is
/// declared.  `pin` says which of sema's answers named the callee: `call`
/// the call's own pin, `callee` the pin on its callee expression, `method`
/// the method sema selected, `none` nothing.  `depth` is how many loops
/// enclose the record: with a local's own depth it tells an element bound
/// inside the innermost loop - the array the loop searches - from one bound
/// outside it, the source of the key searched for.
///
/// The same file carries one record per DECLARATION a module makes, in the
/// same fifteen columns, written by the same check after it has walked the
/// module's bodies: what a type, a field or a signature is, as resolution
/// decided it.
///
///     type   file line col  fields  base    visibility  kind  -       -    ...  path   -             0
///     field  file line col  index   type    visibility  -     -       key  ...  owner  name          0
///     fn     file line col  params  return  visibility  role  symbol  -    ...  owner  name          0
///     param  file line col  index   type    visibility  role  symbol  key  ...  owner  fn:parameter  0
///
/// (`callee-decl` and `enclosing` are `-`.)  `kind` is `struct`, `union`,
/// `class`, `enum` or `trait`; `role` is `free`, `method`, `static`,
/// `constructor` or `destructor`; `params` and a parameter's `index` do not
/// count a receiver, which has no record.  `base` is the path of the class
/// a class extends, `-` for any other type or a class extending none.
/// `path` and `owner` are
/// definition paths - a function's owner is its type, or its module when it
/// is free.  `key` is the key the declared type carries (`string`,
/// `SymbolStr`, `QualifiedName`, `ModulePath`) by value, by reference or as
/// an array, or `-`; `?` stands for what resolution left unanswered.

namespace compiler::sema::call_facts;

import compiler::ast;
import compiler::ast::{ LiteralKind, NodeKind, PatternKind };
import compiler::ast::node::{ ASTNode, ProgramNode };
import compiler::lex::{ TokenType };
import compiler::ast::declaration::{
    ClassDeclNode, EnumDeclNode, FieldDeclNode, FunctionDeclNode, ImplBlockNode, MethodNode,
    StructDeclNode, TraitDeclNode, UnionDeclNode, VarDeclNode
};
import compiler::ast::expression::{
    ArrayAccessNode, BinaryExprNode, CallExprNode, CalleePin, CastExprNode, ExpressionNode,
    IdentifierNode, LiteralNode, MemberAccessNode, ScopeResolutionNode, UnaryExprNode
};
import compiler::ast::statement::{ BlockStmtNode, ExprStmtNode, StatementNode };
import compiler::ast::pattern::{ MatchArmNode, PatternNode };
import compiler::compilation_context;
import compiler::compilation_context::{ CompilationContext };
import compiler::decl_index::{ OverloadId };
import compiler::diag::source_span::{ SourceSpan };
import compiler::resolver::res::{ DefId, FamilyOwner, Res, ResSlot };
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::demangler::{ Demangler };
import compiler::types;
import compiler::types::{ TypeKind };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };
import compiler::types::arena::{ TypeArena };
import compiler::types::compound::{ ArrayType, FunctionType, ReferenceType };
import std::fmt;
import std::fs::dir;
import std::fs::file;
import std::fs::path::{ Path };
import std::collections::string::{ String };
import compiler::sema::state::{ SemaState };
import utils::text::{ Text };

/// What a record reads besides the node it describes: the compilation, the
/// function whose body is being checked, and the body check's state, which
/// holds the initializer of every local declared so far.
type struct FactsScope {
    ctx:   CompilationContext*;
    arena: TypeArena*;
    func:  FunctionDeclNode*;
    state: SemaState*;
}

/// A local a loop's condition claimed as its counter, and the depth it had
/// before, so the loop hands the depth back when its body is done.
type struct LoopCounter {
    key:   u64;
    had:   boolean;
    depth: u64;
}

/// The entry sema bound a call to, and which of its answers named it.
type struct CalleeAnswer {
    entry: OverloadId;
    pin:   string;
}

type struct CallFacts {

    /// Record `call`'s key arguments.  `params` are the types sema
    /// classified its arguments against, and `known` whether they belong to
    /// this call.
    static record(fs: &FactsScope, call: CallExprNode*, params: &TypeRef[], known: boolean) -> void {
        if (call == null) { return; }
        const ctx: CompilationContext* = fs.ctx;
        const arena: TypeArena* = fs.arena;
        const site: string = CallFacts::site_of(ctx, (call as ASTNode*).span);
        const answer: CalleeAnswer = CallFacts::callee_entry(ctx, call);
        const entry: OverloadId = answer.entry;
        const pin: string = answer.pin;
        mut callee: string = "?";
        mut callee_text: string = CallFacts::callee_spelled(ctx, call);
        mut callee_decl: string = "-";
        if (entry.is_valid()) {
            callee = CallFacts::symbol_text(ctx, entry);
            callee_text = Demangler::demangle(callee);
            const ds: SourceSpan = ctx.decl_index.entry_span(entry);
            callee_decl = CallFacts::normalized_path(ctx, Text::new(ds.file)) + ":" + fmt::format("%u", ds.start_line);
        }
        mut receiver: string = "-";
        const cn: ASTNode* = call.callee as ASTNode*;
        if (cn != null && cn.kind == NodeKind::MemberAccess) {
            receiver = CallFacts::provenance(fs, (call.callee as MemberAccessNode*).object, 0);
        }
        const tail: string = callee + "\t" + pin + "\t" + callee_decl + "\t"
            + CallFacts::enclosing(fs) + "\t" + callee_text + "\t" + CallFacts::enclosing_text(fs)
            + "\t" + fmt::format("%d", fs.state.loop_depth);

        // Every call, whatever it passes: what it bound and from where.  A
        // reader that places calls by the declaration they reach counts from
        // these, a call returning a name and a call taking no argument among
        // them; the records below describe the arguments.
        ctx.facts.push("call\t" + site + "\t" + fmt::format("%lld", call.arguments.length)
            + "\t-\t-\t" + receiver + "\t" + tail);
        if (call.arguments.length == 0) { return; }
        // Which arguments an `arg` record describes; every other argument
        // whose value is a spelling gets a `sarg`, on every path out.
        mut covered: boolean[] = [];
        for (mut i: i64 = 0; i < call.arguments.length; i++) { covered.push(false); }

        // The parameter types: the pinned declaration's signature when sema
        // pinned one, the types sema classified the arguments against when
        // it did not.  A signature lists a method's receiver first, so a
        // call through a receiver skips it: the offset is how many more
        // parameters the signature has than the call has arguments, and a
        // difference other than 0 or 1 (a signature that lost a parameter)
        // is recorded as unaligned rather than guessed.
        mut types: TypeRef[] = [];
        mut offset: i64 = 0;
        if (entry.is_valid()) {
            const sig: Type* = arena.lookup(ctx.decl_index.entry_signature(entry));
            if (sig == null || sig.kind != TypeKind::Function) {
                ctx.facts.push("noparams\t" + site + "\t-\t-\t-\t" + receiver + "\t" + tail);
                CallFacts::record_spelled_args(fs, call, &covered, site, receiver, tail);
                return;
            }
            const ft: FunctionType* = sig as FunctionType*;
            for (mut k: i64 = 0; k < ft.param_types.length; k++) { types.push(ft.param_types[k]); }
            if (cn != null && cn.kind == NodeKind::MemberAccess) {
                offset = types.length - call.arguments.length;
            }
            if (offset < 0 || offset > 1
                    || (types.length - offset < call.arguments.length && !ft.is_variadic)) {
                ctx.facts.push("unaligned\t" + site + "\t-\t-\t-\t" + receiver + "\t" + tail);
                CallFacts::record_spelled_args(fs, call, &covered, site, receiver, tail);
                return;
            }
        } else {
            if (!known || params.length == 0) {
                ctx.facts.push("noparams\t" + site + "\t-\t-\t-\t" + receiver + "\t" + tail);
                CallFacts::record_spelled_args(fs, call, &covered, site, receiver, tail);
                return;
            }
            for (mut k: i64 = 0; k < params.length; k++) { types.push(params[k]); }
        }
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            if (i + offset >= types.length) { break; }
            const pt: TypeRef = types[i + offset];
            if (!CallFacts::carries_key(ctx, arena, pt)) { continue; }
            covered[i] = true;
            ctx.facts.push("arg\t" + site + "\t" + fmt::format("%lld", i) + "\t"
                + CallFacts::type_text(arena, pt) + "\t"
                + CallFacts::provenance(fs, call.arguments[i], 0) + "\t" + receiver + "\t" + tail);
        }
        CallFacts::record_spelled_args(fs, call, &covered, site, receiver, tail);
    }

    /// A `sarg` for each argument of `call` whose value is a spelling and
    /// which no `arg` record describes.
    static record_spelled_args(fs: &FactsScope, call: CallExprNode*, covered: &boolean[],
                               site: string, receiver: string, tail: string) -> void {
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            if (covered[i]) { continue; }
            const spelled: string = CallFacts::spelling_of_value(fs, call.arguments[i], 0);
            if (spelled.length() == 0) { continue; }
            fs.ctx.facts.push("sarg\t" + site + "\t" + fmt::format("%lld", i) + "\t" + spelled + "\t"
                + CallFacts::provenance(fs, call.arguments[i], 0) + "\t" + receiver + "\t" + tail);
        }
    }

    /// Record a `match` whose subject's value is a spelling, with the
    /// literal patterns its arms compare it with.
    static record_match(fs: &FactsScope, subject: ExpressionNode*, arms: &MatchArmNode*[],
                        span: SourceSpan) -> void {
        const spelled: string = CallFacts::spelling_of_value(fs, subject, 0);
        if (spelled.length() == 0) { return; }
        const ctx: CompilationContext* = fs.ctx;
        mut literal_arms: i64 = 0;
        mut literals: string = "";
        for (mut i: i64 = 0; i < arms.length; i++) {
            const arm: MatchArmNode* = arms[i];
            if (arm == null) { continue; }
            mut has_literal: boolean = false;
            for (mut j: i64 = 0; j < arm.patterns.length; j++) {
                const pat: PatternNode* = arm.patterns[j];
                if (pat == null || pat.pattern_kind != PatternKind::Literal) { continue; }
                has_literal = true;
                if (literals.length() > 0) { literals = literals + ","; }
                literals = literals + CallFacts::escaped_literal(
                    ctx.intern_table.resolve(pat.value), pat.literal_kind);
            }
            if (has_literal) { literal_arms = literal_arms + 1; }
        }
        if (literals.length() == 0) { literals = "-"; }
        ctx.facts.push("match\t" + CallFacts::site_of(ctx, span) + "\t"
            + fmt::format("%lld", literal_arms) + "\t" + spelled + "\t"
            + CallFacts::provenance(fs, subject, 0) + "\t" + literals + "\t-\t-\t-\t"
            + CallFacts::enclosing(fs) + "\t-\t" + CallFacts::enclosing_text(fs)
            + "\t" + fmt::format("%d", fs.state.loop_depth));
    }

    /// The spelling `e`'s VALUE is, whatever it is passed to, as a `sarg` or
    /// `match` record prints it - a key (`key_of`), `Text` or `Keyword`, or
    /// `<that>.<member>` for a number read out of one (`name.id`) - or ""
    /// for none.  Read through `&`, `*` and casts, the way `provenance` is.
    static spelling_of_value(fs: &FactsScope, e: ExpressionNode*, depth: i32) -> string {
        if (e == null || depth > 8) { return ""; }
        if (e.resolved_type.is_valid()) {
            const own: string = CallFacts::spelling_of(fs.ctx, fs.arena, e.resolved_type);
            if (own.length() > 0) { return own; }
        }
        const n: ASTNode* = e as ASTNode*;
        if (n.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = e as UnaryExprNode*;
            if (u.op.kind == TokenType::Amp || u.op.kind == TokenType::Star) {
                return CallFacts::spelling_of_value(fs, u.operand, depth + 1);
            }
            return "";
        }
        if (n.kind == NodeKind::CastExpression) {
            return CallFacts::spelling_of_value(fs, (e as CastExprNode*).expression, depth + 1);
        }
        if (n.kind != NodeKind::MemberAccess || !e.resolved_type.is_valid()) { return ""; }
        const t: Type* = fs.arena.lookup(e.resolved_type);
        if (t == null || t.kind != TypeKind::Int) { return ""; }
        const obj: ExpressionNode* = (e as MemberAccessNode*).object;
        if (obj == null || !obj.resolved_type.is_valid()) { return ""; }
        mut one: TypeRef = obj.resolved_type;
        const ot: Type* = fs.arena.lookup(one);
        if (ot != null && (ot.kind == TypeKind::Reference || ot.kind == TypeKind::Pointer)) {
            one = if (ot.kind == TypeKind::Reference) { (ot as ReferenceType*).referent }
                  else { fs.arena.pointer_pointee_of(one) };
        }
        const kt: Type* = fs.arena.lookup(one);
        if (kt == null || kt.kind == TypeKind::Array) { return ""; }
        const holder: string = CallFacts::spelling_of(fs.ctx, fs.arena, one);
        if (holder.length() == 0) { return ""; }
        return holder + "." + fs.ctx.intern_table.resolve((e as MemberAccessNode*).member);
    }

    /// The spelling a value of type `t` is: a key, as `key_of` names it, or
    /// the compiler's two wrappers of a spelling that is not a name, `Text`
    /// and `Keyword` - under any number of references and arrays - or "".
    /// The wrappers are not keys: a declaration taking one takes no name.
    /// They are named here because a value carried in one is still a
    /// spelling, and a lookup keyed by one is still a lookup by spelling.
    static spelling_of(ctx: CompilationContext*, arena: TypeArena*, t: TypeRef) -> string {
        const k: string = CallFacts::key_of(ctx, arena, t);
        if (k.length() > 0) { return k; }
        mut cur: TypeRef = t;
        for (mut depth: i32 = 0; depth < 8; depth++) {
            if (!cur.is_valid()) { return ""; }
            const ty: Type* = arena.lookup(cur);
            if (ty == null) { return ""; }
            if (ty.kind == TypeKind::Reference) {
                cur = (ty as ReferenceType*).referent;
                continue;
            }
            if (ty.kind == TypeKind::Array) {
                cur = (ty as ArrayType*).element;
                continue;
            }
            if (ty.kind != TypeKind::Struct) { return ""; }
            const d: DefId = ctx.decl_index.registered_def(cur);
            if (!d.is_valid()) { return ""; }
            const path: string = CallFacts::def_text(ctx, d);
            if (path == "utils::text::Text") { return "Text"; }
            if (path == "utils::keyword::Keyword") { return "Keyword"; }
            return "";
        }
        return "";
    }

    /// Record `bin` when it compares keys: an `==` or `!=` whose operand is
    /// a key, or a number read out of one - a spelling compared by its
    /// interned id.
    static record_compare(fs: &FactsScope, bin: BinaryExprNode*) -> void {
        if (bin == null || bin.left == null || bin.right == null) { return; }
        if (bin.op.kind != TokenType::EqualEqual && bin.op.kind != TokenType::ExclaimEqual) { return; }
        mut key: TypeRef = CallFacts::compared_key(fs, bin.left);
        if (!key.is_valid()) { key = CallFacts::compared_key(fs, bin.right); }
        if (!key.is_valid()) { return; }
        const ctx: CompilationContext* = fs.ctx;
        ctx.facts.push("cmp\t" + CallFacts::site_of(ctx, (bin as ASTNode*).span) + "\t"
            + bin.op.lexeme + "\t" + CallFacts::type_text(fs.arena, key) + "\t"
            + CallFacts::provenance(fs, bin.right, 0) + "\t"
            + CallFacts::provenance(fs, bin.left, 0) + "\t-\t-\t-\t"
            + CallFacts::enclosing(fs) + "\t-\t" + CallFacts::enclosing_text(fs)
            + "\t" + fmt::format("%d", fs.state.loop_depth));
    }

    /// The key an operand compares: its own type when that is a key, the
    /// type of the value it is read out of when it is a number read off one
    /// key (`name.id`, not an array of them's `length`); invalid otherwise.
    static compared_key(fs: &FactsScope, e: ExpressionNode*) -> TypeRef {
        if (e == null || !e.resolved_type.is_valid()) { return TypeRef::invalid(); }
        if (CallFacts::carries_key(fs.ctx, fs.arena, e.resolved_type)) { return e.resolved_type; }
        const n: ASTNode* = e as ASTNode*;
        if (n.kind != NodeKind::MemberAccess) { return TypeRef::invalid(); }
        const t: Type* = fs.arena.lookup(e.resolved_type);
        if (t == null || t.kind != TypeKind::Int) { return TypeRef::invalid(); }
        const obj: ExpressionNode* = (e as MemberAccessNode*).object;
        if (obj == null || !obj.resolved_type.is_valid()) { return TypeRef::invalid(); }
        mut one: TypeRef = obj.resolved_type;
        const ot: Type* = fs.arena.lookup(one);
        if (ot != null && ot.kind == TypeKind::Reference) { one = (ot as ReferenceType*).referent; }
        const kt: Type* = fs.arena.lookup(one);
        if (kt == null || kt.kind == TypeKind::Array) { return TypeRef::invalid(); }
        if (CallFacts::carries_key(fs.ctx, fs.arena, one)) { return one; }
        return TypeRef::invalid();
    }

    /// Write the recorded facts to `path`, sorted and without repeats: a
    /// call re-resolved in one build records twice, and the order sema
    /// visits bodies in is not the order anyone compares them in.
    static write(ctx: CompilationContext*, path_text: Text) -> boolean {
        const path: string = path_text.as_string();
        mut lines: string[] = [];
        for (mut i: i64 = 0; i < ctx.facts.length; i++) {
            lines.push(CallFacts::sort_key(ctx.facts[i]) + "\n" + ctx.facts[i]);
        }
        lines.sort();
        mut text: String = String::new();
        mut prev: string = "";
        for (mut i: i64 = 0; i < lines.length; i++) {
            const at: i64 = lines[i].find_char('\n' as i8);
            const rec: string = lines[i].substr(at + 1, lines[i].length() as i64 - at - 1);
            if (i > 0 && rec == prev) { continue; }
            text.push(rec);
            text.push_byte(10 as u8);
            prev = rec;
        }
        dir::create_dir_all(Path::from(path.parent_dir()));
        return match (file::write(Path::from(path), text.as_bytes())) {
            Result::Ok(_)  => { true }
            Result::Err(_) => { false }
        };
    }

    /// The record behind its file and its line and column right-aligned, so
    /// a sort of the keys orders records by file, then line and column as
    /// numbers.
    static sort_key(rec: string) -> string {
        mut fields: string[] = rec.split("\t");
        if (fields.length < 4) { return rec; }
        return fields[1] + "\t" + fmt::format("%8s", fields[2]) + "\t"
            + fmt::format("%6s", fields[3]) + "\t" + rec;
    }

    /// `file<TAB>line<TAB>col` of a span.
    static site_of(ctx: CompilationContext*, span: SourceSpan) -> string {
        return CallFacts::normalized_path(ctx, Text::new(span.file)) + "\t"
            + fmt::format("%u", span.start_line) + "\t"
            + fmt::format("%u", span.start_col);
    }

    /// A source path with forward slashes, so one file is spelled one way
    /// whichever separator the loader was handed, and a standard library
    /// file as `<stdlib>` and its path inside the library, so the records
    /// do not depend on where the library was found.
    static normalized_path(ctx: CompilationContext*, p_text: Text) -> string {
        const p: string = p_text.as_string();
        mut f: string = p.replace("\\", "/");
        if (f.starts_with("./")) { f = f.substr(2, f.length() as i64 - 2); }
        const root: string = ctx.stdlib_root.replace("\\", "/");
        const n: i64 = root.length() as i64;
        if (n > 0 && f.starts_with(root + "/")) {
            return "<stdlib>" + f.substr(n, f.length() as i64 - n);
        }
        return f;
    }

    // The three ways a record renders an identity as text, one place each:
    // what it prints is the report, never a key anything is looked up by.

    /// An entry's linker symbol.
    static symbol_text(ctx: CompilationContext*, e: OverloadId) -> string {
        return ctx.intern_table.resolve(ctx.decl_index.entry_symbol(e));
    }

    /// A type as a diagnostic spells it.
    static type_text(arena: TypeArena*, t: TypeRef) -> string {
        return arena.resolve_display_name(t);
    }

    /// A definition's path.
    static def_text(ctx: CompilationContext*, d: DefId) -> string {
        return ctx.intern_table.resolve(ctx.defs.path_of(d));
    }

    /// The enclosing function's linker symbol; `-` outside a function and
    /// `?` for one registered under none.
    static enclosing(fs: &FactsScope) -> string {
        if (fs.func == null) { return "-"; }
        if (!fs.func.overload_entry.is_valid()) { return "?"; }
        return CallFacts::symbol_text(fs.ctx, fs.func.overload_entry);
    }

    static enclosing_text(fs: &FactsScope) -> string {
        if (fs.func == null) { return "-"; }
        if (!fs.func.overload_entry.is_valid()) { return fs.ctx.intern_table.resolve(fs.func.name); }
        return Demangler::demangle(CallFacts::enclosing(fs));
    }

    /// The entry sema bound `call` to, and which of its answers named it.
    static callee_entry(ctx: CompilationContext*, call: CallExprNode*) -> CalleeAnswer {
        if (call.resolved_callee.is_some()) {
            return CalleeAnswer { entry: CallFacts::pinned_entry(ctx, &call.resolved_callee), pin: "call" };
        }
        const cn: ASTNode* = call.callee as ASTNode*;
        if (cn != null && cn.kind == NodeKind::Identifier) {
            const ident: IdentifierNode* = call.callee as IdentifierNode*;
            if (ident.resolved_callee.is_some()) {
                return CalleeAnswer { entry: CallFacts::pinned_entry(ctx, &ident.resolved_callee), pin: "callee" };
            }
        }
        if (cn != null && cn.kind == NodeKind::ScopeResolution) {
            const scope: ScopeResolutionNode* = call.callee as ScopeResolutionNode*;
            if (scope.resolved_callee.is_some()) {
                return CalleeAnswer { entry: CallFacts::pinned_entry(ctx, &scope.resolved_callee), pin: "callee" };
            }
        }
        if (call.resolved_method != null) {
            const m: MethodNode* = call.resolved_method as MethodNode*;
            if (m.func != null) {
                return CalleeAnswer { entry: m.func.overload_entry, pin: "method" };
            }
        }
        return CalleeAnswer { entry: OverloadId::invalid(), pin: "none" };
    }

    /// The entry a pin names: a declaration's own, or a family's only one.
    static pinned_entry(ctx: CompilationContext*, p: &CalleePin) -> OverloadId {
        match (p) {
            CalleePin::Decl(e) => { return e; }
            CalleePin::Family(owner, leaf) => {
                const entries: OverloadId[] = ctx.decl_index.lookup_family_entries(owner, leaf);
                if (entries.length == 1) { return entries[0]; }
            }
            _ => { }
        }
        return OverloadId::invalid();
    }

    /// The callee as written, for a record whose callee sema did not pin.
    static callee_spelled(ctx: CompilationContext*, call: CallExprNode*) -> string {
        const cn: ASTNode* = call.callee as ASTNode*;
        if (cn == null) { return "?"; }
        if (cn.kind == NodeKind::Identifier) {
            return ctx.intern_table.resolve((call.callee as IdentifierNode*).name);
        }
        if (cn.kind == NodeKind::MemberAccess) {
            return "." + ctx.intern_table.resolve((call.callee as MemberAccessNode*).member);
        }
        if (cn.kind == NodeKind::ScopeResolution) {
            const s: ScopeResolutionNode* = call.callee as ScopeResolutionNode*;
            return ctx.intern_table.resolve(s.scope_name) + "::"
                + ctx.intern_table.resolve(s.member_name);
        }
        return "expr:" + cn.kind.to_string();
    }

    /// Whether a value of type `t` is a key, under any number of references
    /// and arrays.  The compiler's own three key types are named by their
    /// declarations' paths because they are this report's subject, not a
    /// rule of the language: in a program that declares none of them, only
    /// `string` qualifies.
    static carries_key(ctx: CompilationContext*, arena: TypeArena*, t: TypeRef) -> boolean {
        return CallFacts::key_of(ctx, arena, t).length() > 0;
    }

    /// The key a value of type `t` carries, as a declaration record prints
    /// it - `string`, `SymbolStr`, `QualifiedName` or `ModulePath` - or ""
    /// when it carries none; `carries_key` is this test.
    static key_of(ctx: CompilationContext*, arena: TypeArena*, t: TypeRef) -> string {
        mut cur: TypeRef = t;
        for (mut depth: i32 = 0; depth < 8; depth++) {
            if (!cur.is_valid()) { return ""; }
            const ty: Type* = arena.lookup(cur);
            if (ty == null) { return ""; }
            if (ty.kind == TypeKind::Reference) {
                cur = (ty as ReferenceType*).referent;
                continue;
            }
            if (ty.kind == TypeKind::Array) {
                cur = (ty as ArrayType*).element;
                continue;
            }
            if (ty.kind == TypeKind::String) { return "string"; }
            if (ty.kind != TypeKind::Struct) { return ""; }
            const d: DefId = ctx.decl_index.registered_def(cur);
            if (!d.is_valid()) { return ""; }
            const path: string = CallFacts::def_text(ctx, d);
            if (path == "compiler::resolver::symbol_str::SymbolStr") { return "SymbolStr"; }
            if (path == "compiler::resolver::qualified_name::QualifiedName") { return "QualifiedName"; }
            if (path == "compiler::module_graph::ModulePath") { return "ModulePath"; }
            return "";
        }
        return "";
    }

    // Declarations.  One record per type, field, function and parameter a
    // module declares, written by the same check as the call records, so a
    // reader asks the compiler what a declaration IS - its path, each
    // member's resolved type and visibility, each signature - instead of
    // reading its source (the header lists the columns).

    /// Record every declaration `root` makes.  The walk is the spelling
    /// lint's: top-level functions, and the methods of structs, unions,
    /// classes and `implement` blocks, plus each type's own record and
    /// fields and a trait's required methods.
    static record_declarations(ctx: CompilationContext*, arena: TypeArena*, root: ProgramNode*) -> void {
        if (root == null) { return; }
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }
            if (stmt.kind == NodeKind::FunctionDeclaration) {
                const fd: FunctionDeclNode* = stmt as FunctionDeclNode*;
                const vis: string = if (fd.is_public) { "public" } else { "private" };
                mut module_path: string = "?";
                if (fd.def.is_valid()) { module_path = CallFacts::decl_path(ctx, ctx.defs.parent_of(fd.def)); }
                CallFacts::record_function(ctx, arena, fd, stmt.span, Text::new(module_path),
                                           Text::new("free"), Text::new(vis));
            } else if (stmt.kind == NodeKind::StructDeclaration) {
                const sd: StructDeclNode* = stmt as StructDeclNode*;
                CallFacts::record_type(ctx, arena, stmt, sd.def, Text::new("struct"), sd.is_public, &sd.fields,
                                       Text::new("-"));
                CallFacts::record_methods(ctx, arena, &sd.methods, Text::new(CallFacts::decl_path(ctx, sd.def)));
            } else if (stmt.kind == NodeKind::UnionDeclaration) {
                const ud: UnionDeclNode* = stmt as UnionDeclNode*;
                CallFacts::record_type(ctx, arena, stmt, ud.def, Text::new("union"), ud.is_public, &ud.fields,
                                       Text::new("-"));
                CallFacts::record_methods(ctx, arena, &ud.methods, Text::new(CallFacts::decl_path(ctx, ud.def)));
            } else if (stmt.kind == NodeKind::ClassDeclaration) {
                const cd: ClassDeclNode* = stmt as ClassDeclNode*;
                CallFacts::record_type(ctx, arena, stmt, cd.def, Text::new("class"), cd.is_public, &cd.fields,
                                       Text::new(CallFacts::base_text(ctx, cd)));
                CallFacts::record_methods(ctx, arena, &cd.methods, Text::new(CallFacts::decl_path(ctx, cd.def)));
            } else if (stmt.kind == NodeKind::EnumDeclaration) {
                const ed: EnumDeclNode* = stmt as EnumDeclNode*;
                const none: FieldDeclNode*[] = [];
                CallFacts::record_type(ctx, arena, stmt, ed.def, Text::new("enum"), ed.is_public, &none,
                                       Text::new("-"));
            } else if (stmt.kind == NodeKind::TraitDeclaration) {
                const td: TraitDeclNode* = stmt as TraitDeclNode*;
                const none: FieldDeclNode*[] = [];
                CallFacts::record_type(ctx, arena, stmt, td.def, Text::new("trait"), true, &none,
                                       Text::new("-"));
                const trait_path: string = CallFacts::decl_path(ctx, td.def);
                for (mut k: i64 = 0; k < td.methods.length; k++) {
                    const tf: FunctionDeclNode* = td.methods[k];
                    if (tf == null) { continue; }
                    const role: string = if (tf.is_static) { "static" } else { "method" };
                    CallFacts::record_function(ctx, arena, tf, (tf as ASTNode*).span, Text::new(trait_path),
                                               Text::new(role), Text::new("public"));
                }
            } else if (stmt.kind == NodeKind::ImplementationBlock) {
                const ib: ImplBlockNode* = stmt as ImplBlockNode*;
                CallFacts::record_methods(ctx, arena, &ib.methods, Text::new(CallFacts::impl_target_text(ctx, ib)));
            }
        }
    }

    /// The path of the class `cd` extends, `-` when it extends none, `?` when
    /// its base was left unanswered.
    static base_text(ctx: CompilationContext*, cd: ClassDeclNode*) -> string {
        match (cd.base_res) {
            ResSlot::Answered(r) => {
                match (r) {
                    Res::Def(d) => { return CallFacts::decl_path(ctx, d); }
                    _           => { }
                }
            }
            _ => { }
        }
        if (cd.base_class.is_empty()) { return "-"; }
        return "?";
    }

    /// A type's own record, then one per field in declaration order.
    static record_type(ctx: CompilationContext*, arena: TypeArena*, node: ASTNode*, def: DefId,
                       kind_text: Text, is_public: boolean, fields: &FieldDeclNode*[],
                       base: Text) -> void {
        const owner: string = CallFacts::decl_path(ctx, def);
        const vis: string = if (is_public) { "public" } else { "private" };
        ctx.facts.push("type\t" + CallFacts::site_of(ctx, node.span) + "\t"
            + fmt::format("%lld", fields.length) + "\t" + base.as_string() + "\t" + vis + "\t" + kind_text.as_string()
            + "\t-\t-\t-\t-\t" + owner + "\t-\t0");
        for (mut i: i64 = 0; i < fields.length; i++) {
            const f: FieldDeclNode* = fields[i];
            if (f == null) { continue; }
            ctx.facts.push("field\t" + CallFacts::site_of(ctx, (f as ASTNode*).span) + "\t"
                + fmt::format("%lld", i) + "\t" + CallFacts::declared_type_text(arena, f.resolved_type)
                + "\t" + f.visibility.label() + "\t-\t-\t"
                + CallFacts::key_text(ctx, arena, f.resolved_type) + "\t-\t-\t" + owner + "\t"
                + ctx.intern_table.resolve(f.name) + "\t0");
        }
    }

    /// The type an `implement` block's head was resolved to: its definition's
    /// path, a primitive's own name, `?` when the head is unanswered.
    static impl_target_text(ctx: CompilationContext*, ib: ImplBlockNode*) -> string {
        match (ib.res) {
            ResSlot::Answered(r) => {
                match (r) {
                    Res::Def(d)     => { return CallFacts::decl_path(ctx, d); }
                    Res::PrimTy(p)  => { return ctx.intern_table.resolve(p); }
                    _               => { }
                }
            }
            _ => { }
        }
        return "?";
    }

    /// Each method's record, under `owner_text`, the path of the type the
    /// block declares them on; a method cloned from a trait's default body
    /// is the trait's declaration, recorded there, and is skipped.
    static record_methods(ctx: CompilationContext*, arena: TypeArena*, methods: &MethodNode*[],
                          owner_text: Text) -> void {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null || m.func.is_synth_default) { continue; }
            mut role: string = "method";
            if (m.is_constructor) {
                role = "constructor";
            } else if (m.is_destructor) {
                role = "destructor";
            } else if (m.is_static || m.func.is_static) {
                role = "static";
            }
            CallFacts::record_function(ctx, arena, m.func, (m as ASTNode*).span, owner_text,
                                       Text::new(role), Text::new(m.visibility.label()));
        }
    }

    /// A function's record - its parameter count (the receiver not counted),
    /// return type, visibility, role and linker symbol - then one per
    /// parameter other than the receiver.
    static record_function(ctx: CompilationContext*, arena: TypeArena*, f: FunctionDeclNode*,
                           span: SourceSpan, owner_text: Text, role_text: Text, vis_text: Text) -> void {
        const owner: string = owner_text.as_string();
        const role: string = role_text.as_string();
        const vis: string = vis_text.as_string();
        mut params: VarDeclNode*[] = [];
        for (mut i: i64 = 0; i < f.parameters.length; i++) {
            const p: VarDeclNode* = f.parameters[i];
            if (p != null && !p.is_receiver()) { params.push(p); }
        }
        mut symbol: string = "?";
        if (f.overload_entry.is_valid()) { symbol = CallFacts::symbol_text(ctx, f.overload_entry); }
        const name: string = ctx.intern_table.resolve(f.name);
        ctx.facts.push("fn\t" + CallFacts::site_of(ctx, span) + "\t"
            + fmt::format("%lld", params.length) + "\t"
            + CallFacts::declared_type_text(arena, f.resolved_return_type) + "\t" + vis + "\t" + role
            + "\t" + symbol + "\t-\t-\t-\t" + owner + "\t" + name + "\t0");
        for (mut i: i64 = 0; i < params.length; i++) {
            const p: VarDeclNode* = params[i];
            ctx.facts.push("param\t" + CallFacts::site_of(ctx, (p as ASTNode*).span) + "\t"
                + fmt::format("%lld", i) + "\t" + CallFacts::declared_type_text(arena, p.resolved_type)
                + "\t" + vis + "\t" + role + "\t" + symbol + "\t"
                + CallFacts::key_text(ctx, arena, p.resolved_type) + "\t-\t-\t" + owner + "\t"
                + name + ":" + ctx.intern_table.resolve(p.name) + "\t0");
        }
    }

    /// A declaration's path, or `?` for one registered under no definition.
    static decl_path(ctx: CompilationContext*, d: DefId) -> string {
        if (!d.is_valid()) { return "?"; }
        return CallFacts::def_text(ctx, d);
    }

    /// A declared type as a record prints it, `?` when resolution left none.
    static declared_type_text(arena: TypeArena*, t: TypeRef) -> string {
        if (!t.is_valid()) { return "?"; }
        return CallFacts::type_text(arena, t);
    }

    /// The key column of a field or parameter record: the key its type
    /// carries, `-` for none.
    static key_text(ctx: CompilationContext*, arena: TypeArena*, t: TypeRef) -> string {
        const k: string = CallFacts::key_of(ctx, arena, t);
        if (k.length() == 0) { return "-"; }
        return k;
    }

    /// Where `e`'s value comes from (the table in this module's header).
    static provenance(fs: &FactsScope, e: ExpressionNode*, depth: i32) -> string {
        if (e == null) { return "expr:none"; }
        if (depth > 8) { return "expr:deep"; }
        const ctx: CompilationContext* = fs.ctx;
        const n: ASTNode* = e as ASTNode*;
        if (n.kind == NodeKind::Literal) { return "literal:" + CallFacts::literal_text(e as LiteralNode*); }
        if (n.kind == NodeKind::Identifier) {
            const ident: IdentifierNode* = e as IdentifierNode*;
            const spelled: string = ctx.intern_table.resolve(ident.name);
            match (ident.res) {
                ResSlot::Answered(r) => {
                    match (r) {
                        Res::Local(sym) => { return CallFacts::local_provenance(fs, sym, spelled, depth); }
                        Res::Def(d) => {
                            return "global:" + CallFacts::def_text(ctx, d);
                        }
                        Res::SourceLoc(_) => { return "sourceloc:" + spelled; }
                        _ => { }
                    }
                }
                _ => { }
            }
            return "name:" + spelled;
        }
        if (n.kind == NodeKind::MemberAccess) {
            const ma: MemberAccessNode* = e as MemberAccessNode*;
            mut owner: string = "?";
            if (ma.object != null && ma.object.resolved_type.is_valid()) {
                owner = CallFacts::type_text(fs.arena, ma.object.resolved_type);
            }
            return "field:" + owner + "." + ctx.intern_table.resolve(ma.member)
                + "<-" + CallFacts::provenance(fs, ma.object, depth + 1);
        }
        if (n.kind == NodeKind::CallExpression) {
            const inner: CallExprNode* = e as CallExprNode*;
            const entry: OverloadId = CallFacts::callee_entry(ctx, inner).entry;
            mut head: string = "call:" + CallFacts::callee_spelled(ctx, inner);
            if (entry.is_valid()) {
                head = "call:" + Demangler::demangle(CallFacts::symbol_text(ctx, entry));
            }
            if (inner.arguments.length == 0) { return head; }
            return head + " of " + CallFacts::provenance(fs, inner.arguments[0], depth + 1);
        }
        if (n.kind == NodeKind::UnaryExpression) {
            return CallFacts::provenance(fs, (e as UnaryExprNode*).operand, depth + 1);
        }
        if (n.kind == NodeKind::CastExpression) {
            return CallFacts::provenance(fs, (e as CastExprNode*).expression, depth + 1);
        }
        if (n.kind == NodeKind::ArrayAccess) {
            const acc: ArrayAccessNode* = e as ArrayAccessNode*;
            return "element" + CallFacts::index_depth(fs, acc.index) + ":"
                + CallFacts::provenance(fs, acc.array, depth + 1);
        }
        if (n.kind == NodeKind::ScopeResolution) {
            const s: ScopeResolutionNode* = e as ScopeResolutionNode*;
            return "global:" + ctx.intern_table.resolve(s.scope_name) + "::"
                + ctx.intern_table.resolve(s.member_name);
        }
        return "expr:" + n.kind.to_string();
    }

    /// A literal as written, a string's text quoted, with tabs, newlines,
    /// quotes and backslashes escaped so a record stays one line of fields,
    /// and cut at 60 characters.
    static literal_text(lit: LiteralNode*) -> string {
        return CallFacts::escaped_literal(lit.value, lit.literal_kind);
    }

    /// A literal's text, escaped and cut as `literal_text` says; a string
    /// quoted.
    static escaped_literal(value: string, kind: LiteralKind) -> string {
        mut v: string = value;
        if (v.length() > 60) { v = v.substr(0, 60) + "..."; }
        v = v.replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n").replace("\r", "\\r");
        if (kind == LiteralKind::String) {
            return "\"" + v.replace("\"", "\\\"") + "\"";
        }
        return v;
    }

    /// `@<d>` when an element's index is a local declared at loop depth <d>
    /// (a loop counter at the depth of the loop it drives): the element is
    /// read by that loop, whatever loop the read stands in.  Empty otherwise.
    static index_depth(fs: &FactsScope, idx: ExpressionNode*) -> string {
        if (idx == null || (idx as ASTNode*).kind != NodeKind::Identifier) { return ""; }
        match ((idx as IdentifierNode*).res) {
            ResSlot::Answered(r) => {
                match (r) {
                    Res::Local(sym) => {
                        match (fs.state.facts_depths.get(&sym.key())) {
                            Option::Some(d) => { return fmt::format("@%llu", d); }
                            Option::None => { }
                        }
                    }
                    _ => { }
                }
            }
            _ => { }
        }
        return "";
    }

    /// Claim for a loop at `depth` its counters, recording each one's
    /// previous depth in `out`: a local the condition compares directly
    /// (`i < n`, `i != end`, through `&&`, `||` and `!`) that the loop also
    /// steps (`stepped`).  A counter declared before a `while` drives that
    /// loop, as a `for` header's does the loop it heads: an element it
    /// indexes in the body is read by that loop, not by the one the counter
    /// was declared in.  A local the condition only reads is a bound (`j <
    /// i` inside a loop over `i`) and keeps its depth; so does a member read
    /// (`it.pos < n`), whose value may be an element bound outside the loop.
    static claim_counters(state: SemaState*, cond: ExpressionNode*, depth: u64, stepped: &u64[],
                          out: mut &LoopCounter[]) -> void {
        if (cond == null) { return; }
        const n: ASTNode* = cond as ASTNode*;
        if (n.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = cond as UnaryExprNode*;
            if (u.op.kind == TokenType::Exclaim) { CallFacts::claim_counters(state, u.operand, depth, stepped, out); }
            return;
        }
        if (n.kind != NodeKind::BinaryExpression) { return; }
        const bin: BinaryExprNode* = cond as BinaryExprNode*;
        const op: TokenType = bin.op.kind;
        if (op == TokenType::AmpAmp || op == TokenType::PipePipe) {
            CallFacts::claim_counters(state, bin.left, depth, stepped, out);
            CallFacts::claim_counters(state, bin.right, depth, stepped, out);
            return;
        }
        if (op == TokenType::LAngle || op == TokenType::LessEqual || op == TokenType::RAngle || op == TokenType::GreaterEqual || op == TokenType::EqualEqual || op == TokenType::ExclaimEqual) {
            CallFacts::claim_counter(state, bin.left, depth, stepped, out);
            CallFacts::claim_counter(state, bin.right, depth, stepped, out);
        }
    }

    /// The locals a loop steps - `i++`, `--i`, `i += 1`, `i = next` - in its
    /// `for` update and in the statements directly in its body.  A step
    /// nested deeper (inside an `if`) is not seen, and its counter keeps
    /// the depth it was declared at.
    static stepped_locals(update: ExpressionNode*, body: StatementNode*) -> u64[] {
        mut out: u64[] = [];
        CallFacts::add_stepped(update, &out);
        if (body != null && (body as ASTNode*).kind == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = body as BlockStmtNode*;
            for (mut i: i64 = 0; i < blk.statements.length; i++) {
                const s: StatementNode* = blk.statements[i];
                if (s != null && (s as ASTNode*).kind == NodeKind::ExpressionStatement) {
                    CallFacts::add_stepped((s as ExprStmtNode*).expression, &out);
                }
            }
        }
        return out;
    }

    static add_stepped(e: ExpressionNode*, out: mut &u64[]) -> void {
        if (e == null) { return; }
        const n: ASTNode* = e as ASTNode*;
        mut target: ExpressionNode* = null;
        if (n.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = e as UnaryExprNode*;
            if (u.op.kind == TokenType::PlusPlus || u.op.kind == TokenType::MinusMinus) { target = u.operand; }
        }
        if (n.kind == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            if (b.op.kind.is_assignment_op()) { target = b.left; }
        }
        if (target == null || (target as ASTNode*).kind != NodeKind::Identifier) { return; }
        match ((target as IdentifierNode*).res) {
            ResSlot::Answered(r) => {
                match (r) {
                    Res::Local(sym) => { out.push(sym.key()); }
                    _ => { }
                }
            }
            _ => { }
        }
    }

    static claim_counter(state: SemaState*, e: ExpressionNode*, depth: u64, stepped: &u64[],
                         out: mut &LoopCounter[]) -> void {
        if (e == null || (e as ASTNode*).kind != NodeKind::Identifier) { return; }
        match ((e as IdentifierNode*).res) {
            ResSlot::Answered(r) => {
                match (r) {
                    Res::Local(sym) => {
                        const key: u64 = sym.key();
                        mut steps: boolean = false;
                        for (mut i: i64 = 0; i < stepped.length; i++) {
                            if (stepped[i] == key) { steps = true; }
                        }
                        if (!steps) { return; }
                        match (state.facts_depths.get(&key)) {
                            Option::Some(d) => {
                                if (d >= depth) { return; }
                                out.push(LoopCounter { key: key, had: true, depth: d });
                            }
                            Option::None => { out.push(LoopCounter { key: key, had: false, depth: 0 }); }
                        }
                        state.facts_depths.insert(key, depth);
                    }
                    _ => { }
                }
            }
            _ => { }
        }
    }

    /// Hand back the depths `claim_counters` took, latest first.
    static release_counters(state: SemaState*, claimed: &LoopCounter[]) -> void {
        for (mut i: i64 = claimed.length - 1; i >= 0; i--) {
            const c: LoopCounter = claimed[i];
            if (c.had) {
                state.facts_depths.insert(c.key, c.depth);
            } else {
                state.facts_depths.remove(&c.key);
            }
        }
    }

    /// A local's provenance: a parameter of the enclosing function by its
    /// name, any other local by its name and its initializer's provenance.
    /// Only the initializer: a `mut` local says so, since what it holds
    /// later may come from elsewhere.
    static local_provenance(fs: &FactsScope, sym: SymbolID, spelled: string, depth: i32) -> string {
        if (fs.func != null) {
            for (mut i: i64 = 0; i < fs.func.parameters.length; i++) {
                const p: VarDeclNode* = fs.func.parameters[i];
                if (p != null && p.sym_id.equals(sym)) { return "param:" + spelled; }
            }
        }
        match (fs.state.facts_inits.get(&sym.key())) {
            Option::Some(v) => {
                const decl: VarDeclNode* = v as VarDeclNode*;
                const mark: string = if (decl.is_mutable) { "mut " } else { "" };
                mut at: string = "";
                match (fs.state.facts_depths.get(&sym.key())) {
                    Option::Some(d) => { at = fmt::format("@%llu", d); }
                    Option::None => { }
                }
                return "local:" + mark + spelled + at + "="
                    + CallFacts::provenance(fs, decl.initializer, depth + 1);
            }
            Option::None => { }
        }
        return "local:" + spelled;
    }
}
