/// ScopeManager
///
/// Owns the per-function local bindings and their undo log.  A local is
/// asked by the binding the name layer stamped on its use (`Res::Local`),
/// never by its spelling: two locals of one spelling in one function are two
/// bindings, and the stamp already says which one a use names.
///
/// A lexical scope is entered by `save_scope()` (returns a checkpoint) and
/// left by `restore_scope(checkpoint)`, which rolls every binding made since
/// back to its prior state: a binding the scope declared is dropped, and one
/// a `static match` arm re-declared with a narrowed type gets its type back.
///
/// All state lives on the shared `SemaState`; this collaborator is the
/// single owner of the logic that reads and mutates it.

namespace compiler::sema::scope_manager;

import compiler::types::type_ref;
import compiler::types::type_ref::{ TypeRef };
import compiler::diag::source_span;
import compiler::diag::source_span::{ SourceSpan };
import compiler::sema::state;
import compiler::sema::state::{ LocalBinding, SemaState };
import compiler::resolver::symbol_id;
import compiler::resolver::symbol_id::{ SymbolID, SymbolKey };
import std::collections::hashmap;
import std::collections::hashmap::{ HashMap };
import std::collections::hashset;
import std::collections::hashset::{ HashSet };
import std::core::option;
import std::core::option::{ Option };

type struct ScopeManager {
    state: SemaState*;

    static null() -> ScopeManager {
        return ScopeManager { state: null };
    }

    wire(mut &this, state: SemaState*) -> void {
        this.state = state;
    }

    /// Forget every binding: a function's body starts with none.
    reset(mut &this) -> void {
        this.state.bindings         = HashMap::<SymbolKey, LocalBinding>::new();
        this.state.binding_undo     = [];
        this.state.binding_prev     = [];
        this.state.payload_bindings = HashSet::<SymbolKey>::new();
        this.state.alias_bindings   = HashSet::<SymbolKey>::new();
        this.state.param_bindings   = HashSet::<SymbolKey>::new();
        this.state.outer_bindings   = HashMap::<SymbolKey, TypeRef>::new();
    }


    // -- Lookup --

    /// What is known of the local binding `sym`; `LocalBinding::none()` when
    /// it is not one of this function's live locals.
    binding(&this, sym: SymbolID) -> LocalBinding {
        if (!sym.is_valid()) { return LocalBinding::none(); }
        return match (this.state.bindings.get(&sym.table_key())) {
            Option::Some(b) => { b }
            Option::None    => { LocalBinding::none() }
        };
    }

    /// The type bound to the local `sym`, or invalid when it is not a live
    /// local or its declaration failed to type.
    type_of(&this, sym: SymbolID) -> TypeRef {
        return this.binding(sym).ty;
    }

    /// Whether `sym` is a live local or parameter, typed or not.
    binds(&this, sym: SymbolID) -> boolean {
        return this.binding(sym).sym.is_valid();
    }

    /// The local `sym`'s mutability; true for a binding this function does
    /// not hold, so a global or an untracked symbol is never reported as
    /// assigned while immutable.
    is_mutable(&this, sym: SymbolID) -> boolean {
        const b: LocalBinding = this.binding(sym);
        if (!b.sym.is_valid()) { return true; }
        return b.is_mut;
    }

    /// The type of `sym` when it is a binding the lambda being checked can
    /// see outside itself - a local of an enclosing frame or a further-out
    /// capture - and so captures; none otherwise.
    outer_type_of(&this, sym: SymbolID) -> Option<TypeRef> {
        if (!sym.is_valid()) { return Option::None; }
        return this.state.outer_bindings.get(&sym.table_key());
    }

    /// The `const`/`mut` keyword span of the local `sym`; no location when
    /// none was recorded.
    kw_span_of(&this, sym: SymbolID) -> SourceSpan {
        return this.binding(sym).kw_span;
    }

    /// Whether `sym` is one of the current function's parameters (or its
    /// receiver).  Parameters are caller-backed, so `&param` re-borrows the
    /// caller's storage rather than escaping a stack slot.
    names_param(&this, sym: SymbolID) -> boolean {
        return sym.is_valid() && this.state.param_bindings.contains(&sym.table_key());
    }

    /// Whether `sym` is a `match`-arm payload binding.  Over a by-value
    /// subject such a binding aliases a stack temporary, so returning a
    /// pointer or reference to it dangles - the return-escape check (E0455)
    /// consults this.  See `names_alias` for the case where it does not.
    names_payload(&this, sym: SymbolID) -> boolean {
        return sym.is_valid() && this.state.payload_bindings.contains(&sym.table_key());
    }

    /// Whether `sym` is a `match`-arm binding whose subject was reached
    /// through a by-reference parameter.  It names the caller's storage, so
    /// unlike an ordinary payload binding its address stays valid after
    /// this function returns and `return &name` is sound.
    names_alias(&this, sym: SymbolID) -> boolean {
        return sym.is_valid() && this.state.alias_bindings.contains(&sym.table_key());
    }


    // -- Scope save / restore --

    /// Checkpoint the current scope: an index into the undo log that
    /// `restore_scope` rolls back to.
    save_scope(&this) -> i64 {
        return this.state.binding_undo.length;
    }

    /// Bind the local `sym` to `ty`, recording its previous state in the undo
    /// log so leaving the scope restores it.  The keyword span starts empty;
    /// the declaration attaches its own with `set_kw_span`.  A binding with
    /// no identity holds nothing: no use can name it.
    declare(mut &this, sym: SymbolID, ty: TypeRef, is_mut: boolean) -> void {
        if (!sym.is_valid()) { return; }
        const key: SymbolKey = sym.table_key();
        this.state.binding_undo.push(key);
        this.state.binding_prev.push(this.binding(sym));
        this.state.bindings.insert(key, LocalBinding { sym: sym, ty: ty, is_mut: is_mut, kw_span: SourceSpan::none() });
    }

    /// Attach the `const`/`mut` keyword span to the just-declared local
    /// `sym`, for E0218's quickfix.  No-op when the span has no location.
    set_kw_span(mut &this, sym: SymbolID, kw_span: SourceSpan) -> void {
        if (!kw_span.has_location()) { return; }
        mut b: LocalBinding = this.binding(sym);
        if (!b.sym.is_valid()) { return; }
        b.kw_span = kw_span;
        this.state.bindings.insert(sym.table_key(), b);
    }

    /// Roll bindings back to a checkpoint, restoring each one's previous
    /// state, and truncate the undo log.
    restore_scope(mut &this, save_point: i64) -> void {
        // Undo in reverse order.
        for (mut i: i64 = this.state.binding_undo.length - 1; i >= save_point; i -= 1) {
            const key: SymbolKey = this.state.binding_undo[i];
            const prev: LocalBinding = this.state.binding_prev[i];
            if (prev.ty.is_valid()) {
                this.state.bindings.insert(key, prev);
            } else {
                this.state.bindings.remove(&key);
            }
        }
        while (this.state.binding_undo.length > save_point) {
            this.state.binding_undo.pop();
            this.state.binding_prev.pop();
        }
    }
}
