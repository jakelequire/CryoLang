/// TypeUtils
///
/// Pure type-system queries and declaration-index lookup delegates shared across
/// the Sema collaborators: structural probes (contains-generic-param, peel /
/// unwrap, projection accessors), small relational predicates (reference?,
/// ptr-or-ref?, indirection-compatible?), display naming, and the thin
/// DeclarationIndex delegates that the call/member resolvers build on.
///
/// Holds the immutable environment by pointer (`arena`, `intern`, `ctx`,
/// `checker`); no per-pass state.
///
/// NOTE: the name-lookup methods here carry historic
/// `bare -> qualified -> cross-module -> arena-leaf` widen cascades (tagged
/// `// widen:` below).  Each consumer (call_resolver / member_resolver /
/// identifier resolution) drives them directly; they have not been unified into
/// a single keyed resolver.

namespace Compiler::Sema::TypeUtils;

import Compiler::Types::{
    TypeRef, Type, Arena, Compound, UserDefined, Generic, Checker, TypeKind
};
import Compiler::Resolver::{ SymbolStr, InternTable, Resolver };
import Compiler::Resolver::Res;
import Compiler::CompilationContext;
import Compiler::ResolveCounter;
import Compiler::DeclIndex;
import Compiler::AST;
import Compiler::AST::Node;
import Compiler::AST::Expression;
import std::core::slice;

type struct TypeUtils {
    arena:   TypeArena*;
    intern:  InternTable*;
    ctx:     CompilationContext*;
    checker: TypeChecker*;

    static null() -> TypeUtils {
        return TypeUtils { arena: null, intern: null, ctx: null, checker: null };
    }

    wire(mut &this, arena: TypeArena*, intern: InternTable*,
                    ctx: CompilationContext*, checker: TypeChecker*) -> void {
        this.arena   = arena;
        this.intern  = intern;
        this.ctx     = ctx;
        this.checker = checker;
    }


    // -- DeclarationIndex lookup delegates --

    lookup_func_return(&this, name: SymbolStr) -> TypeRef {
        return this.ctx.decl_index.lookup_func_return(name);
    }

    /// The global a WRITTEN name refers to, or invalid when it refers to
    /// something else or to nothing.
    ///
    /// Absence and "answered, but not a definition" are deliberately one
    /// outcome: a bare name may be a local, a builtin or a function, so
    /// neither is a failure and neither licenses a second lookup under
    /// another key.  The stamp is the writer's own answer, and it is a
    /// canonical name, which the spelling - a leaf - can never be.
    spelling_global(&this, slot: ResSlot) -> TypeRef {
        return match (slot) {
            ResSlot::Answered(r) => { this.lookup_global_exact(r.def_name()) }
            _                    => { TypeRef::invalid() }
        };
    }

    /// The type a WRITTEN name refers to, or invalid when it refers to
    /// something else or to nothing.
    ///
    /// The bare-identifier counterpart of `spelling_global`, and absent for the
    /// same reasons: a name that answers `Local`, `PrimTy` or `GenericParam`
    /// names no declaration to look up, and that is an answer rather than a
    /// failure, so it licenses no second lookup under another key.
    spelling_type(&this, slot: ResSlot, nodef_site: ResolveCounter::Site) -> TypeRef {
        return match (slot) {
            ResSlot::Answered(r) => { this.spelling_type_answered(r, nodef_site) }
            _                    => {
                ResolveCounter::Site::SpellTyPending.bump();
                TypeRef::invalid()
            }
        };
    }

    /// The three outcomes `spelling_type` collapses into one invalid answer.
    ///
    /// Split because a caller reading `!is_valid()` cannot tell an answer that
    /// declines to name a type - which is complete, and licenses no second
    /// lookup - from one naming a definition the index does not hold, which is
    /// a registration defect a spelling lookup would paper over.  The returned
    /// value is unchanged; only the counters are new.
    spelling_type_answered(&this, r: Res, nodef_site: ResolveCounter::Site) -> TypeRef {
        const q: SymbolStr = r.def_name();
        if (!q.is_valid()) {
            ResolveCounter::Site::SpellTyNoDef.bump();
            nodef_site.bump();
            return TypeRef::invalid();
        }
        const found: TypeRef = this.lookup_type_exact(q);
        if (found.is_valid()) {
            ResolveCounter::Site::SpellTyHit.bump();
        } else {
            ResolveCounter::Site::SpellTyDefMissing.bump();
        }
        return found;
    }

    /// The global `name` as declared by the module named by `scope_leaf`, for a
    /// qualified `scope_leaf::name` reference. Invalid when no single module
    /// matches.
    lookup_global_in_scope(&this, name: SymbolStr, scope_leaf: SymbolStr,
                           out_ns: SymbolStr*) -> TypeRef {
        mut module: SymbolStr = SymbolStr::empty();
        return this.ctx.decl_index.find_global_in_scope(name, scope_leaf, this.intern,
                                                        out_ns, &module);
    }

    /// The global registered under the canonical name `q`.
    ///
    /// One key and one lookup: `q` is the name layer's own answer for the
    /// path, so there is nothing a spelling-derived or leaf-keyed second
    /// attempt could add except a chance to disagree with it.
    lookup_global_exact(&this, q: SymbolStr) -> TypeRef {
        return this.ctx.decl_index.lookup_global(q);
    }

    lookup_method_return(&this, type_sym: SymbolStr, method_sym: SymbolStr) -> TypeRef {
        return this.canonicalize_method_return(
            this.lookup_method_return_raw(type_sym, method_sym));
    }

    /// Fold a method's stored return annotation to its canonical instantiation
    /// (e.g. bare `String` -> `String<GlobalAlloc>`) so a call's resolved type
    /// matches every other path; otherwise an inline `Box::new(String::from_str)`
    /// mints a bogus bare-`String` clone whose method is never emitted.
    canonicalize_method_return(&this, ty: TypeRef) -> TypeRef {
        if (this.ctx.type_resolver == null) { return ty; }
        return this.ctx.type_resolver.canonicalize_default_generic_type(ty);
    }

    // widen: bare -> qualified -> cross-module cascade.
    lookup_method_return_raw(&this, type_sym: SymbolStr, method_sym: SymbolStr) -> TypeRef {
        mut ret: TypeRef = TypeRef::invalid();
        this.resolve_method_owner(type_sym, method_sym, &ret);
        return ret;
    }

    /// The name `method_sym` is REGISTERED under for an owner segment spelled
    /// `type_sym`, or an invalid symbol when no owner carries the method.
    ///
    /// The spelling a call site writes is not a registry key: a scope segment
    /// may be a bare leaf, the writer's own module-qualified form, or a
    /// module-relative path (`Deque::Gadget`), while the registries hold one
    /// canonical name per declaration.  Widening is therefore part of asking
    /// the question, and the answer is WHICH name carried the method - not just
    /// that some name did.
    ///
    /// Every consumer keys off this one answer.  A caller that recovers the
    /// return type here and then rebuilds a symbol from the written spelling is
    /// naming a declaration that does not exist, and the failure surfaces a
    /// whole stage later as an unresolvable callee.
    ///
    /// A winning probe has already fetched the return type it validated, so
    /// `out_ret` (when non-null) hands that value back: asking the registry
    /// again under the owner just returned would re-derive what this call
    /// already proved.  It is left untouched when no owner carries the method.
    resolve_method_owner(&this, type_sym: SymbolStr, method_sym: SymbolStr,
                         out_ret: TypeRef*) -> SymbolStr {
        // As-is (already-qualified names from monomorphized types).
        const as_is: TypeRef = this.ctx.decl_index.lookup_method_return(type_sym, method_sym);
        if (as_is.is_valid()) {
            if (out_ret != null) { *out_ret = as_is; }
            return type_sym;
        }
        // Module-qualified (local/same-module types registered under qualified names).
        const qualified: SymbolStr = this.ctx.qualify_symbol_sym_at(type_sym, "wrap/tu-method-owner", "");
        if (!qualified.equals(type_sym)) {
            const q_ret: TypeRef = this.ctx.decl_index.lookup_method_return(qualified, method_sym);
            if (q_ret.is_valid()) {
                if (out_ret != null) { *out_ret = q_ret; }
                return qualified;
            }
        }
        // Cross-module: resolve the type's original module via the scope chain.
        // This is the only probe that answers a written path whose own leading
        // segments name a module, since the import-scoped index is keyed by leaf.
        const cross_sym: SymbolStr = this.resolve_cross_module_name(type_sym);
        if (cross_sym.is_valid()) {
            const c_ret: TypeRef = this.ctx.decl_index.lookup_method_return(cross_sym, method_sym);
            if (c_ret.is_valid()) {
                if (out_ret != null) { *out_ret = c_ret; }
                return cross_sym;
            }
        }
        return SymbolStr::empty();
    }

    /// The type registered under EXACTLY this name, with no widening.
    ///
    /// A name that is already canonical has nothing left to resolve, so the
    /// cascade's qualify/cross-module steps would be re-asking a question that
    /// is already answered.  Shared by the stamp reader below and by the
    /// cascade's already-qualified step, so the two cannot drift into
    /// answering it differently.
    lookup_type_exact(&this, name: SymbolStr) -> TypeRef {
        return this.ctx.decl_index.lookup_type(name);
    }

    /// The type this path's QUALIFIER names, read off the answer the name layer
    /// wrote on the node rather than re-derived from the spelling.
    ///
    /// `TypeRelative` is a positive claim that the qualifier names a type, and
    /// it carries WHICH: a canonical name that already accounts for the imports
    /// of the module that WROTE the path.  Matching the written spelling
    /// against the index answers the same question from strictly less
    /// information - the tier that ends that cascade is keyed by bare leaf and
    /// so answers from any module in the program, with no import in hand.  That
    /// is how a reference synthesized into a module which never imported the
    /// type still resolved, and it would answer just as readily with a
    /// same-leaf type from a module the writer cannot see.
    ///
    /// Invalid for every other answer.  A qualifier naming a MODULE is not a
    /// type claim, and a base that is a primitive or a type parameter names no
    /// declaration to look up; manufacturing a type for any of them here would
    /// assert an ownership the stamp does not make.
    scope_qualifier_type(&this, scope: ScopeResolutionNode*, site: string) -> TypeRef {
        // Named at the event: the delayed tally says HOW MANY nodes arrived
        // unclaimed, only a per-node line says WHICH.
        if (scope.scope_res.is_pending() && !scope.has_resolved_type()) {
            ResolveCounter::path_hit(
                "RES-PENDING", this.intern.resolve(scope.scope_name),
                this.intern.resolve(scope.member_name), scope.span.to_string());
        }
        mut base: ResBase = ResBase::PrimTy(scope.scope_name);
        const seen: Res = scope.require_scope_res("sema: scope-resolution qualifier");
        match (seen) {
            Res::TypeRelative(b, _) => { base = b; }
            _                       => {
                ResolveCounter::path_hit(
                    "SCOPE-QUAL-NOTREL", site + " " + seen.to_string(),
                    this.intern.resolve(scope.scope_name), scope.span.to_string());
                return TypeRef::invalid();
            }
        }
        mut q: SymbolStr = SymbolStr::empty();
        match (base) {
            ResBase::Def(d) => { q = d; }
            _               => {
                ResolveCounter::path_hit(
                    "SCOPE-QUAL-NOTDEF", site + " " + base.to_string(),
                    this.intern.resolve(scope.scope_name), scope.span.to_string());
                return TypeRef::invalid();
            }
        }
        const ty: TypeRef = this.lookup_type_exact(q);
        if (!ty.is_valid()) {
            // The stamp names a declaration the index does not carry under that
            // name.  Emitted rather than searched for under another key: a
            // second lookup for a question already answered is how this
            // cascade grew, and the pair (stamped name, written spelling) is
            // what says whether the defect is in the stamp or in registration.
            ResolveCounter::path_hit(
                "SCOPE-TY-STAMP-MISS", site + " " + this.intern.resolve(scope.scope_name),
                this.intern.resolve(q), scope.span.to_string());
        }
        return ty;
    }

    // widen: direct -> qualified -> cross-module -> arena-leaf cascade.
    //
    // The EXACT lookup runs first, so the ambient cursor can only widen a name
    // no declaration carries as written - it cannot displace one that is
    // already registered.  That ordering is what keeps the cursor out of
    // binding decisions: a step able to override an exact match is choosing
    // between two declarations, and the module a cursor happens to be standing
    // in is not a sound basis for that choice.
    //
    // `site` names the caller.  One question is answered four ways here, and
    // the change that removes the widening is per-call-site - a caller holding
    // a stamped node can read an answer, one holding a bare name cannot - so a
    // tally that cannot say WHICH caller needed a step cannot size that work.
    lookup_type_by_sym(&this, name: SymbolStr, site: string) -> TypeRef {
        // Already-qualified names (specialized impl target_type) + cross-module aliases.
        const direct: TypeRef = this.lookup_type_exact(name);
        if (direct.is_valid()) {
            this.cascade_outcome(site, "1-EXACT", name, name, "SELF");
            return direct;
        }
        // The current module's qualified name.  Reached only when nothing is
        // registered under the written spelling, so this widens, never rebinds.
        const qualified: SymbolStr = this.ctx.qualify_symbol_sym_at(name, "wrap/tu-cascade-cursor", "");
        if (!qualified.equals(name)) {
            const q_ty: TypeRef = this.ctx.decl_index.lookup_type(qualified);
            if (q_ty.is_valid()) {
                this.cascade_outcome(site, "2-CURSOR", name, qualified,
                                     "PRIOR-NONE");
                return q_ty;
            }
        }
        // Cross-module via scope chain.
        const cross_sym: SymbolStr = this.resolve_cross_module_name(name);
        if (cross_sym.is_valid()) {
            const cross_ty: TypeRef = this.ctx.decl_index.lookup_type(cross_sym);
            if (cross_ty.is_valid()) {
                this.cascade_outcome(site, "3-CROSSMOD", name, cross_sym,
                                     "PRIOR-NONE");
                return cross_ty;
            }
        }
        // Arena leaf-index: types visible via the TypeResolver fallback chain but
        // not in the Resolver's scope chain (indirectly-imported submodule types).
        //
        // An arena lookup by the BARE name is not an alternative to this: a
        // specialization is cached under its bare mangled spec name, which
        // carries no module, so two modules instantiating one generic collide
        // on that key exactly as they do on a leaf.  `resolution_leaf_index`
        // is the test that says so.
        const leaf_ref: TypeRef = this.arena.lookup_by_leaf(name);
        if (leaf_ref.is_valid()) {
            ResolveCounter::Site::LeafViaTypeUtils.bump();
            // The tally cannot be classified: it says how many names need
            // the index, never which.  Emitted with the module that asked,
            // because a leaf is only ambiguous relative to a writer.
            ResolveCounter::path_hit(
                "LEAF-TYPEUTILS",
                this.intern.resolve(this.ctx.qualify_symbol_sym_at(name, "wrap/tu-cascade-audit", "")),
                this.intern.resolve(name), "");
            this.cascade_outcome(site, "4-LEAF", name, name, "PRIOR-NONE");
            return leaf_ref;
        }
        this.cascade_outcome(site, "5-MISS", name, SymbolStr::empty(),
                             "PRIOR-NONE");
        return TypeRef::invalid();
    }

    /// One outcome of the cascade above, named at the event.
    ///
    /// Every call leaves through exactly one exit and each of them reports
    /// here, so the row count equals the call count.  That identity is the
    /// control: without it a step reading zero cannot be told apart from a
    /// stream nothing ever reached, which is the reading error this whole
    /// measurement exists to avoid.
    ///
    /// Every step after the first reports `PRIOR-NONE`: the exact lookup has
    /// already answered nothing by the time they run, so re-asking it would
    /// record a fixed answer as though it were evidence.
    cascade_outcome(&this, site: string, step: string, name: SymbolStr,
                    answered_as: SymbolStr, control: string) -> void {
        if (!ResolveCounter::Audit::Path.enabled()) { return; }
        mut answer: string = "-";
        if (answered_as.is_valid()) { answer = this.intern.resolve(answered_as); }
        ResolveCounter::type_cascade(site, step, this.intern.resolve(name),
                                     answer, control);
    }

    /// Resolve a bare name to its original module-qualified form via the
    /// Resolver's scope chain, or empty if not found.
    resolve_cross_module_name(&this, name: SymbolStr) -> SymbolStr {
        const resolver: Resolver* = this.ctx.get_resolver();
        if (resolver == null) { return SymbolStr::empty(); }
        return resolver.resolve_type_qualified_name(name);
    }

    /// The registry name for a type: direct, else (for an InstantiatedType) its
    /// resolved concrete type, else the generic base (pre-mono fallback so
    /// method-by-type probes resolve identically pre- and post-mono).
    lookup_type_sym(&this, ty: TypeRef) -> SymbolStr {
        const direct: SymbolStr = this.ctx.decl_index.lookup_type_name(ty);
        if (direct.is_valid()) { return direct; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t != null && t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (inst.has_resolved_type()) {
                return this.ctx.decl_index.lookup_type_name(inst.resolved_type);
            }
            const base: SymbolStr = this.ctx.decl_index.lookup_type_name(inst.generic_base);
            if (base.is_valid()) { return base; }
        }
        // A dynamic array shares the `Array_<T>` method/layout registry, but its
        // TypeRef is not canonical (many TypeRefs describe the same `T[]`), so the
        // TypeRef-keyed `direct` lookup above misses. Resolve its name by ELEMENT
        // type, the canonical key - the same mapping codegen dispatches through.
        // Without this a `T[]` receiver has no name, so method resolution can't
        // find `pop`/`push`/etc. on it and (for a value use like
        // `const x = arr.pop()`) silently falls through unresolved instead of
        // resolving to the real return type (`pop -> Option<T>`) or erroring.
        if (t != null && t.kind == TypeKind::Array && (t as ArrayType*).is_dynamic()) {
            return this.ctx.decl_index.lookup_array_type_name((t as ArrayType*).element);
        }
        return SymbolStr::empty();
    }

    /// Non-receiver parameter count of a qualified free function, or -1.
    scope_fn_arity(&this, q_sym: SymbolStr) -> i64 {
        if (this.ctx.decl_index == null) { return -1; }
        const ft_ref: TypeRef = this.ctx.decl_index.lookup_func_type(q_sym);
        if (!ft_ref.is_valid()) { return -1; }
        const t: Type* = this.arena.lookup(ft_ref.id);
        if (t == null || t.kind != TypeKind::Function) { return -1; }
        return (t as FunctionType*).param_types.length;
    }

    /// The template module recorded for an injected specialization (side table
    /// populated during GenericExpressionResolution injection).
    find_template_module(&this, node: ASTNode*) -> SymbolStr {
        if (node == null) { return SymbolStr::empty(); }
        return this.ctx.lookup_injected_origin(node as u64);
    }


    // -- Structural type probes --

    /// Any unsubstituted generic parameter (GenericParam / BoundedParam) anywhere
    /// in the type's structure.  Gates type-mismatch diagnostics that would fire
    /// spuriously on a leftover template-form signature type inside a
    /// monomorphized caller.
    contains_generic_param(&this, tref: TypeRef) -> boolean {
        if (!tref.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(tref.id);
        if (t == null) { return false; }
        if (t.kind == TypeKind::GenericParam || t.kind == TypeKind::BoundedParam) {
            return true;
        }
        if (t.kind == TypeKind::Pointer) {
            return this.contains_generic_param((t as PointerType*).pointee);
        }
        if (t.kind == TypeKind::Reference) {
            return this.contains_generic_param((t as ReferenceType*).referent);
        }
        if (t.kind == TypeKind::Array) {
            return this.contains_generic_param((t as ArrayType*).element);
        }
        if (t.kind == TypeKind::Optional) {
            return this.contains_generic_param((t as OptionalType*).wrapped);
        }
        if (t.kind == TypeKind::Tuple) {
            const tup: TupleType* = t as TupleType*;
            for (mut i: i64 = 0; i < tup.elements.length; i++) {
                if (this.contains_generic_param(tup.elements[i])) { return true; }
            }
            return false;
        }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                if (this.contains_generic_param(inst.type_args[i])) { return true; }
            }
            return false;
        }
        return false;
    }

    /// An associated-type projection not yet reduced to a concrete member type.
    /// Distinct from `contains_generic_param`: a projection's base may be fully
    /// concrete (`Range<i32>::Item`) yet the type stays abstract until reduced.
    contains_unresolved_projection(&this, tref: TypeRef) -> boolean {
        if (!tref.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(tref.id);
        if (t == null) { return false; }
        if (t.kind == TypeKind::AssocProjection) {
            return !(t as AssocProjectionType*).resolved_type.is_valid();
        }
        if (t.kind == TypeKind::Pointer) {
            return this.contains_unresolved_projection((t as PointerType*).pointee);
        }
        if (t.kind == TypeKind::Reference) {
            return this.contains_unresolved_projection((t as ReferenceType*).referent);
        }
        if (t.kind == TypeKind::Array) {
            return this.contains_unresolved_projection((t as ArrayType*).element);
        }
        if (t.kind == TypeKind::Optional) {
            return this.contains_unresolved_projection((t as OptionalType*).wrapped);
        }
        if (t.kind == TypeKind::Tuple) {
            const tup: TupleType* = t as TupleType*;
            for (mut i: i64 = 0; i < tup.elements.length; i++) {
                if (this.contains_unresolved_projection(tup.elements[i])) { return true; }
            }
            return false;
        }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                if (this.contains_unresolved_projection(inst.type_args[i])) { return true; }
            }
            return false;
        }
        return false;
    }

    /// Peel Reference / Pointer / resolved-InstantiatedType wrappers to the
    /// underlying concrete type (caller checks for the kind it wants, e.g. Enum).
    unwrap_to_enum(&this, ty: TypeRef) -> Type* {
        if (!ty.is_valid()) { return null; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return null; }
        if (t.kind == TypeKind::Reference) {
            return this.unwrap_to_enum((t as ReferenceType*).referent);
        }
        if (t.kind == TypeKind::Pointer) {
            return this.unwrap_to_enum((t as PointerType*).pointee);
        }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (inst.has_resolved_type()) { return this.unwrap_to_enum(inst.resolved_type); }
            return null;
        }
        return t;
    }

    /// Peel Reference / Pointer wrappers to the innermost InstantiatedType (even
    /// when its `resolved_type` is still invalid), or null.
    peel_to_instantiation(&this, ty: TypeRef) -> InstantiatedType* {
        if (!ty.is_valid()) { return null; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return null; }
        if (t.kind == TypeKind::Reference) {
            return this.peel_to_instantiation((t as ReferenceType*).referent);
        }
        if (t.kind == TypeKind::Pointer) {
            return this.peel_to_instantiation((t as PointerType*).pointee);
        }
        if (t.kind == TypeKind::InstantiatedType) {
            return t as InstantiatedType*;
        }
        return null;
    }

    // -- Generic-identity views (carrier-free) ---------------------------------
    //
    // These answer "what generic instantiation is this?" for BOTH a pre-mono
    // `InstantiatedType` wrapper and a post-mono concrete aggregate, WITHOUT
    // routing through the origin carrier: a wrapper answers from its own node, a
    // concrete from its intrinsic `generic_base` / `type_args`.  Pointer and
    // Reference layers are peeled.
    //
    // A monomorphized type answers these from its own fields; there is no side
    // node to consult and none to forget.

    /// The template `ty` is an instantiation of, or invalid.
    view_generic_base(&this, ty: TypeRef) -> TypeRef {
        if (!ty.is_valid()) { return TypeRef::invalid(); }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return TypeRef::invalid(); }
        if (t.kind == TypeKind::Reference) {
            return this.view_generic_base((t as ReferenceType*).referent);
        }
        if (t.kind == TypeKind::Pointer) {
            return this.view_generic_base((t as PointerType*).pointee);
        }
        return this.arena.inst_generic_base(ty);
    }

    /// Number of type arguments `ty` carries as an instantiation (0 if none).
    view_type_arg_count(&this, ty: TypeRef) -> i64 {
        if (!ty.is_valid()) { return 0; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return 0; }
        if (t.kind == TypeKind::Reference) {
            return this.view_type_arg_count((t as ReferenceType*).referent);
        }
        if (t.kind == TypeKind::Pointer) {
            return this.view_type_arg_count((t as PointerType*).pointee);
        }
        return this.arena.inst_type_arg_count(ty);
    }

    /// The `i`-th type argument of `ty` as an instantiation, or invalid.
    view_type_arg_at(&this, ty: TypeRef, i: i64) -> TypeRef {
        if (!ty.is_valid() || i < 0) { return TypeRef::invalid(); }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return TypeRef::invalid(); }
        if (t.kind == TypeKind::Reference) {
            return this.view_type_arg_at((t as ReferenceType*).referent, i);
        }
        if (t.kind == TypeKind::Pointer) {
            return this.view_type_arg_at((t as PointerType*).pointee, i);
        }
        return this.arena.inst_type_arg_at(ty, i);
    }

    /// The CONCRETE specialization denoted by `ty` when `ty` is an instantiation:
    /// a post-mono concrete is already it (single-id identity), a pre-mono wrapper
    /// yields its `resolved_type`.  Invalid when `ty` is a wrapper that has not
    /// been monomorphized yet.
    view_concrete_of(&this, ty: TypeRef) -> TypeRef {
        if (!ty.is_valid()) { return TypeRef::invalid(); }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return TypeRef::invalid(); }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (inst.has_resolved_type()) { return inst.resolved_type; }
            return TypeRef::invalid();
        }
        if (this.arena.inst_generic_base(ty).is_valid()) { return ty; }
        return TypeRef::invalid();
    }

    /// Copy `ty`'s instantiation type arguments into a fresh owned array.
    /// Element-wise by construction - never hand back a borrow of the type's own
    /// buffer, which would be freed twice.
    view_type_args_copy(&this, ty: TypeRef) -> TypeRef[] {
        mut out: TypeRef[] = [];
        const n: i64 = this.view_type_arg_count(ty);
        for (mut i: i64 = 0; i < n; i++) { out.push(this.view_type_arg_at(ty, i)); }
        return out;
    }

    /// Peel Pointer / Reference / resolved-InstantiatedType wrappers (bounded
    /// depth) to the underlying base `Type*`, or null if an instantiation is
    /// still unresolved.
    unwrap_to_base_type(&this, ty: TypeRef) -> Type* {
        mut t: Type* = this.arena.lookup(ty.id);
        mut depth: i32 = 0;
        while (t != null && depth < 5) {
            match (t.kind) {
                TypeKind::Pointer => {
                    t = this.arena.lookup((t as PointerType*).pointee.id);
                }
                TypeKind::Reference => {
                    t = this.arena.lookup((t as ReferenceType*).referent.id);
                }
                TypeKind::InstantiatedType => {
                    const it: InstantiatedType* = t as InstantiatedType*;
                    if (!it.has_resolved_type()) { return null; }
                    t = this.arena.lookup(it.resolved_type.id);
                }
                _ => { return t; }
            }
            depth += 1;
        }
        return t;
    }

    /// The generic base of an instantiation, or invalid.
    ///
    /// Alias for `view_generic_base`: the whole contract of this function is
    /// "give me what this is an instantiation OF", which a monomorphized type now
    /// answers from its own intrinsic identity.  A bare `kind == InstantiatedType`
    /// test here would return invalid for precisely the types callers ask about.
    generic_base_of(&this, ty: TypeRef) -> TypeRef {
        return this.view_generic_base(ty);
    }

    /// Pointee of a concrete pointer TypeRef, or invalid if not a pointer.
    proj_pointer_pointee(&this, t: TypeRef) -> TypeRef {
        const ty: Type* = this.arena.lookup(t.id);
        if (ty != null && ty.kind == TypeKind::Pointer) {
            return (ty as PointerType*).pointee;
        }
        return TypeRef::invalid();
    }

    /// Referent of a concrete reference TypeRef, or invalid if not a ref.
    proj_reference_referent(&this, t: TypeRef) -> TypeRef {
        const ty: Type* = this.arena.lookup(t.id);
        if (ty != null && ty.kind == TypeKind::Reference) {
            return (ty as ReferenceType*).referent;
        }
        return TypeRef::invalid();
    }


    // -- Relational predicates --

    /// True when one side is an Enum and the other an Int (enum<->discriminant).
    enum_int_compatible(&this, a: TypeRef, b: TypeRef) -> boolean {
        const at: Type* = this.arena.lookup(a.id);
        const bt: Type* = this.arena.lookup(b.id);
        if (at == null || bt == null) { return false; }
        if (at.kind == TypeKind::Enum && bt.kind == TypeKind::Int) { return true; }
        if (at.kind == TypeKind::Int && bt.kind == TypeKind::Enum) { return true; }
        return false;
    }

    /// True when `t` resolves to a reference (`&T`) type.
    is_reference_type(&this, t: TypeRef) -> boolean {
        if (!t.is_valid()) { return false; }
        const ty: Type* = this.arena.lookup(t.id);
        return ty != null && ty.kind == TypeKind::Reference;
    }

    /// True when `t` resolves to a function type (`(A) -> R`) - a callable slot.
    is_function_type(&this, t: TypeRef) -> boolean {
        if (!t.is_valid()) { return false; }
        const ty: Type* = this.arena.lookup(t.id);
        return ty != null && ty.kind == TypeKind::Function;
    }

    /// True when `t` resolves to a reference OR pointer - the value is already an
    /// address and must not be auto-ref'd again.
    is_ref_or_ptr_type(&this, t: TypeRef) -> boolean {
        if (!t.is_valid()) { return false; }
        const ty: Type* = this.arena.lookup(t.id);
        if (ty == null) { return false; }
        return ty.kind == TypeKind::Reference || ty.kind == TypeKind::Pointer;
    }

    /// One level of pointer/reference indirection peeled off `t`, or invalid when
    /// `t` is neither a pointer nor a reference.
    peel_indirection(&this, t: TypeRef) -> TypeRef {
        const ty: Type* = this.arena.lookup(t.id);
        if (ty == null) { return TypeRef::invalid(); }
        if (ty.kind == TypeKind::Pointer)   { return (ty as PointerType*).pointee; }
        if (ty.kind == TypeKind::Reference) { return (ty as ReferenceType*).referent; }
        return TypeRef::invalid();
    }

    /// True when `arg` and `param` describe the same underlying type up to one
    /// level of pointer/reference spelling - `&T`<->`&mut T`, `&T`<->`T*`, and
    /// value<->`&T`/`T*` (call-site auto-ref).  At least one side must be an
    /// indirection, and the underlying types must be ASSIGNABLE to each other.
    ///
    /// Assignable, not merely "not Incompatible": this predicate is the second
    /// opinion asked after `can_assign` has already said no, so accepting a pair
    /// that needs an explicit cast means one peel plus any castable relation is
    /// enough to waive the diagnosis - `i64` against `i32*` peels to `i64` vs
    /// `i32`, which are cast-compatible.
    ///
    /// The auto-ref clause below is why a value whose type ALREADY equals the
    /// pointee still binds a pointer parameter: `f(42)` against `i32*` matches
    /// on `equals` and the call site materializes a temporary.  That is this
    /// predicate's purpose at a CALL; a plain `=` must not ask it, and asks
    /// `indirection_spelling_compatible` instead.
    indirection_compatible(&this, arg_ty: TypeRef, param_ty: TypeRef) -> boolean {
        const a_peeled: TypeRef = this.peel_indirection(arg_ty);
        const p_peeled: TypeRef = this.peel_indirection(param_ty);
        if (!a_peeled.is_valid() && !p_peeled.is_valid()) { return false; }
        const a_in: TypeRef = if (a_peeled.is_valid()) { a_peeled } else { arg_ty };
        const p_in: TypeRef = if (p_peeled.is_valid()) { p_peeled } else { param_ty };
        if (a_in.equals(p_in)) { return true; }
        // Derived -> Base upcast through the indirection (value-form receiver
        // forwarded to a `Base*`/`&Base` parameter), which check_compatibility
        // only models for `Derived*`->`Base*`.
        if (this.checker.is_subclass_of(a_in, p_in)) { return true; }
        const c: TypeCompatibility = this.checker.check_compatibility(a_in, p_in);
        return c.is_assignable();
    }

    /// True when two types differ only in how the SAME indirection is spelled -
    /// `&T` vs `&mut T` vs `T*`.  BOTH sides must be indirections.
    ///
    /// This is `indirection_compatible` minus its call-site auto-ref clause, and
    /// it is what a plain `=` must ask.  Auto-ref is something a CALL does: the
    /// callee gets the address of a temporary the call site materializes.  An
    /// assignment materializes nothing, so admitting the value<->pointer half
    /// there waived the diagnosis for `p = 42` on a `i32*` - and since the
    /// literal defaults to `i32`, it matched the pointee exactly and never even
    /// reached a compatibility question.  What codegen then emitted was a 32-bit
    /// store into the 64-bit pointer slot, leaving the high half of the previous
    /// pointer in place.
    indirection_spelling_compatible(&this, from_ty: TypeRef, to_ty: TypeRef) -> boolean {
        const f_peeled: TypeRef = this.peel_indirection(from_ty);
        const t_peeled: TypeRef = this.peel_indirection(to_ty);
        if (!f_peeled.is_valid() || !t_peeled.is_valid()) { return false; }
        if (f_peeled.equals(t_peeled)) { return true; }
        if (this.checker.is_subclass_of(f_peeled, t_peeled)) { return true; }
        return this.checker.check_compatibility(f_peeled, t_peeled).is_assignable();
    }

    /// Whether `t` is concrete enough for argument / assignment type-checking to
    /// judge.  A `()` or `void` VALUE is never a mismatch, so it is skipped here;
    /// everything else defers to `arg_type_part_is_concrete`.
    ///
    /// The void skip belongs at the TOP LEVEL only.  Applied to a component it
    /// says `void*` cannot be judged, which silently disabled the check for every
    /// `void*` argument and assignment in the tree - and `void*` is the type the
    /// FFI and type-erasure seams are made of, so that is the last place the
    /// check should be absent.
    arg_type_is_concrete(&this, t: TypeRef) -> boolean {
        if (!t.is_valid()) { return false; }
        const ty: Type* = this.arena.lookup(t.id);
        if (ty == null) { return false; }
        if (ty.kind == TypeKind::Unit) { return false; }
        if (ty.kind == TypeKind::Void) { return false; }
        return this.arg_type_part_is_concrete(t);
    }

    /// Whether every part of `t` names a settled type - one a mismatch can be
    /// judged against.  False for generic/bounded params, function TEMPLATES,
    /// and unresolved instantiations; recurses through
    /// pointer/reference/array/optional/tuple and through a function signature.
    ///
    /// A `Function` is settled once its parameters and return type are: it is an
    /// address with a known signature, structurally interned, so two spellings of
    /// one signature share an id and a mismatch is real.  Treating the whole kind
    /// as unjudgeable - which this inherited from the generic-INFERENCE predicate,
    /// where the question is instead "can this pin a type variable?" - left a
    /// callback field or parameter accepting any value at all, and the failure is
    /// a call through the slot into whatever was stored there.
    arg_type_part_is_concrete(&this, t: TypeRef) -> boolean {
        if (!t.is_valid()) { return false; }
        const ty: Type* = this.arena.lookup(t.id);
        if (ty == null) { return false; }
        if (ty.kind == TypeKind::GenericParam)     { return false; }
        if (ty.kind == TypeKind::BoundedParam)     { return false; }
        if (ty.kind == TypeKind::FunctionTemplate) { return false; }
        if (ty.kind == TypeKind::Pointer) {
            return this.arg_type_part_is_concrete((ty as PointerType*).pointee);
        }
        if (ty.kind == TypeKind::Reference) {
            return this.arg_type_part_is_concrete((ty as ReferenceType*).referent);
        }
        if (ty.kind == TypeKind::Array) {
            return this.arg_type_part_is_concrete((ty as ArrayType*).element);
        }
        if (ty.kind == TypeKind::Optional) {
            return this.arg_type_part_is_concrete((ty as OptionalType*).wrapped);
        }
        if (ty.kind == TypeKind::Tuple) {
            const tt: TupleType* = ty as TupleType*;
            for (mut i: i64 = 0; i < tt.elements.length; i++) {
                if (!this.arg_type_part_is_concrete(tt.elements[i])) { return false; }
            }
            return true;
        }
        if (ty.kind == TypeKind::Function) {
            const ft: FunctionType* = ty as FunctionType*;
            for (mut i: i64 = 0; i < ft.param_types.length; i++) {
                if (!this.arg_type_part_is_concrete(ft.param_types[i])) { return false; }
            }
            return this.arg_type_part_is_concrete(ft.return_type);
        }
        if (ty.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = ty as InstantiatedType*;
            if (!inst.has_resolved_type()) { return false; }
        }
        return true;
    }

    /// Structural equality of two parameter-type lists by length and arena id;
    /// collapses a base method and its identical override into one candidate.
    same_param_sig(&this, a: Slice<TypeRef>, b: Slice<TypeRef>) -> boolean {
        if (a.length != b.length) { return false; }
        for (mut i: i64 = 0; i < a.length as i64; i++) {
            if (a.get(i as u64).unwrap().id != b.get(i as u64).unwrap().id) { return false; }
        }
        return true;
    }

    /// Type identity: plain arena-id equality.
    ///
    /// Plain id equality, with no name-based fallback for struct/class/enum:
    /// nominals are keyed by qualified name in the arena and compound types are
    /// interned structurally, so one semantic type has exactly one id.
    types_equivalent(&this, a: TypeRef, b: TypeRef) -> boolean {
        return a.id == b.id;
    }

    /// True when `t` is a pointer/reference whose pointee is the same type as `v`.
    is_ptr_or_ref_to(&this, t: TypeRef, v: TypeRef) -> boolean {
        const ty: Type* = this.arena.lookup(t.id);
        if (ty == null) { return false; }
        if (ty.kind == TypeKind::Pointer) {
            return this.types_equivalent((ty as PointerType*).pointee, v);
        }
        if (ty.kind == TypeKind::Reference) {
            return this.types_equivalent((ty as ReferenceType*).referent, v);
        }
        return false;
    }

    /// Display name for a TypeRef (re-interned so it doesn't outlive the
    /// formatter's static buffer).  Returns "?" for invalid refs.
    type_display_name(&this, ty: TypeRef) -> string {
        if (!ty.is_valid()) { return "?"; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return "?"; }
        const sym: SymbolStr = this.intern.intern(this.arena.format_display(t));
        return this.intern.resolve(sym);
    }
}
