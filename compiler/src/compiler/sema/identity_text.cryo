/// The identity-text check: an identity is opaque.
///
/// A `DeclName` is the text a definition is known by, read off the
/// definition.  The definition already answers every question that text
/// could be asked, so text computed from one is for showing - a message, a
/// mangled symbol, the name a synthesized node prints as - and never the
/// key of a lookup.  Asking again by the text is a second answering path,
/// and the two disagree as soon as two definitions share a spelling.
///
/// Sema follows such text through the function that reads it.  A value is
/// identity text when its type is `DeclName`, when it is a local whose
/// initializer or an assignment to it was identity text, or when it is
/// computed from identity text: concatenated, formatted, cast, indexed, a
/// field read off it, or the result of a call that is handed it (as an
/// argument or as the receiver) and returns text.
/// Identity text is refused where it is:
///
///   * an argument of a door - a function whose doc comment carries a door
///     marker, the only places a spelling becomes a binding;
///   * the key handed to a hash table (`HashMap` or `HashSet`).
///
/// A door's own body is not checked: comparing text is what a door is for.
/// Nor is the body of a declaration that says why it may, with
/// `![allow(lookup_by_spelling, reason = "...")]` - the marker the spelling
/// lint reads, and the one a function that mangles a definition's path into
/// its link symbol carries.  It refuses, too, identity text compared with
/// other text (`==`, `!=`, or a call answering a `boolean` handed more than
/// one text), and identity text as a `match`'s subject.
///
/// Text that leaves the function - handed to another function's parameter
/// or receiver, or returned - is followed there: each function records
/// where its parameters, its receiver and its answer go, and once every
/// module is checked the lookups that text read off a definition reaches
/// through any chain of calls are refused (`IdentityFlow`).  A door's or an
/// allowed body is not followed into: what it is handed is its own to
/// judge.  Text stored into a field and read back elsewhere is not
/// followed.  It runs over the compiler's own modules, the only ones a
/// `DeclName` is declared in.
namespace compiler::sema::identity_text;

import compiler::ast;
import compiler::ast::{ NodeKind };
import compiler::ast::node::{ ASTNode };
import compiler::ast::declaration::{ FunctionDeclNode, MethodNode, VarDeclNode };
import compiler::ast::expression::{
    ArrayAccessNode, BinaryExprNode, CallExprNode, CastExprNode, ExpressionNode, IdentifierNode,
    IfExprNode, LiteralNode, MemberAccessNode, TernaryExprNode, UnaryExprNode
};
import compiler::ast::{ LiteralKind };
import compiler::compilation_context;
import compiler::compilation_context::{ CompilationContext };
import compiler::decl_index::{ OverloadId, OverloadKey };
import compiler::diag::source_span::{ SourceSpan };
import compiler::lex::{ TokenType };
import compiler::resolver::symbol_id::{ SymbolKey };
import compiler::sema::identity_flow::{ FlowFinding, FlowNode, FlowSink };
import std::collections::hashmap;
import std::collections::hashmap::{ HashMap };
import std::collections::hashset;
import std::collections::hashset::{ HashSet };
import std::core::option;
import std::core::option::{ Option };
import compiler::diag;
import compiler::diag::{ ErrorCode };
import compiler::diag::diagnostic::{ Diagnostic };
import compiler::passes::directive_processing::{ DirectiveProcessingPasses };
import compiler::resolver::lang_item::{ LangItem };
import compiler::resolver::res::{ DefId, Res, ResSlot };
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::sema::call_facts::{ CallFacts };
import compiler::sema::state::{ SemaState };
import compiler::types;
import compiler::types::{ TypeKind };
import compiler::types::arena::{ TypeArena };
import compiler::types::compound::{ ArrayType, PointerType, ReferenceType };
import compiler::types::generic::{ InstantiatedType };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };
import compiler::types::generic_registry::{ GenericRegistry };
import std::fmt;
import utils::text::{ Text };

/// How deep an expression is followed into its operands.  Text deeper than
/// this in one expression is not followed.
const IDENTITY_TEXT_DEPTH: i32 = 24;

type struct IdentityTextCheck {}

implement struct IdentityTextCheck {
    /// Whether the module being checked is one the check runs over.
    static applies(ctx: CompilationContext*) -> boolean {
        return DirectiveProcessingPasses::in_store_root(ctx);
    }

    /// Whether the body of `func`, about to be checked, is exempt: a door's,
    /// or one whose declaration allows `lookup_by_spelling` with a reason.
    /// A method's doc comment and directives are on its method node.
    static function_is_exempt(ctx: CompilationContext*, func: FunctionDeclNode*) -> boolean {
        if (func == null) { return false; }
        if (DirectiveProcessingPasses::is_door(func as ASTNode*)
                || DirectiveProcessingPasses::allows_spelling(&func.attached_directives)) {
            return true;
        }
        const decl: ASTNode* = ctx.decl_index.entry_decl(func.overload_entry);
        if (decl == null || decl.kind != NodeKind::MethodDeclaration) { return false; }
        return DirectiveProcessingPasses::is_door(decl)
            || DirectiveProcessingPasses::allows_spelling(&(decl as MethodNode*).attached_directives);
    }

    /// Whether a value of type `ty` is a `DeclName`, directly or through a
    /// reference, a pointer or an array.
    static is_identity_text_type(ctx: CompilationContext*, ty: TypeRef) -> boolean {
        return DirectiveProcessingPasses::carries_identity_text(ctx, ty);
    }

    /// Start checking `func`'s body: each parameter of a text type, the
    /// receiver included, carries whatever its callers hand it, which is
    /// known only once every caller is checked - so each is a node of the
    /// flow between functions (`IdentityFlow`).  A door's or an allowed
    /// body records nothing.
    static enter(ctx: CompilationContext*, state: SemaState*, func: FunctionDeclNode*) -> void {
        state.identity_locals = HashSet::<SymbolKey>::new();
        state.flow_locals = HashMap::<SymbolKey, FlowNode[]>::new();
        state.identity_entry = OverloadId::invalid();
        state.identity_exempt = state.identity_text_on && IdentityTextCheck::function_is_exempt(ctx, func);
        if (!state.identity_text_on || state.identity_exempt || func == null) { return; }
        if (!func.overload_entry.is_valid()) { return; }
        state.identity_entry = func.overload_entry;
        const key: OverloadKey = func.overload_entry.table_key();
        mut position: i64 = 0;
        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const p: VarDeclNode* = func.parameters[i];
            if (p == null) { continue; }
            const node: FlowNode = if (p.is_receiver()) { FlowNode::receiver(key) } else { FlowNode::argument(key, position) };
            if (!p.is_receiver()) { position = position + 1; }
            if (!p.sym_id.is_valid() || !IdentityTextCheck::is_text(ctx, p.resolved_type)) { continue; }
            if (IdentityTextCheck::is_identity_text_type(ctx, p.resolved_type)) { continue; }
            state.flow_locals.insert(p.sym_id.table_key(), [node]);
        }
    }

    /// Whether the function being checked records its flows.
    static flowing(state: SemaState*) -> boolean {
        return state.identity_text_on && !state.identity_exempt && state.identity_entry.is_valid();
    }

    /// Whether `e` is identity text, as the header says.
    static is_identity_text(ctx: CompilationContext*, state: SemaState*, e: ExpressionNode*,
                            depth: i32) -> boolean {
        mut nodes: FlowNode[] = [];
        return IdentityTextCheck::taint(ctx, state, e, depth, &nodes);
    }

    /// Whether `e` is identity text, as the header says; each flow node
    /// whose text `e` may hold - a parameter or receiver of the function
    /// being checked, or the answer of a call - is added to `nodes`.
    static taint(ctx: CompilationContext*, state: SemaState*, e: ExpressionNode*,
                 depth: i32, nodes: FlowNode[]*) -> boolean {
        if (e == null || depth > IDENTITY_TEXT_DEPTH) { return false; }
        if (e.resolved_type.is_valid() && IdentityTextCheck::is_identity_text_type(ctx, e.resolved_type)) {
            return true;
        }
        const n: ASTNode* = e as ASTNode*;
        if (n.kind == NodeKind::Identifier) {
            const ident: IdentifierNode* = e as IdentifierNode*;
            match (ident.res) {
                ResSlot::Answered(r) => {
                    match (r) {
                        Res::Local(sym) => {
                            match (state.flow_locals.get_ref(&sym.table_key())) {
                                Option::Some(held) => {
                                    for (mut k: i64 = 0; k < (*held).length; k++) {
                                        IdentityTextCheck::add_node(nodes, (*held)[k]);
                                    }
                                }
                                Option::None => { }
                            }
                            return state.identity_locals.contains(&sym.table_key());
                        }
                        _ => { return false; }
                    }
                }
                _ => { return false; }
            }
        }
        if (!IdentityTextCheck::is_text(ctx, e.resolved_type)) { return false; }
        if (n.kind == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            const l: boolean = IdentityTextCheck::taint(ctx, state, b.left, depth + 1, nodes);
            const r: boolean = IdentityTextCheck::taint(ctx, state, b.right, depth + 1, nodes);
            return l || r;
        }
        if (n.kind == NodeKind::UnaryExpression) {
            return IdentityTextCheck::taint(ctx, state, (e as UnaryExprNode*).operand, depth + 1, nodes);
        }
        if (n.kind == NodeKind::CastExpression) {
            return IdentityTextCheck::taint(ctx, state, (e as CastExprNode*).expression, depth + 1, nodes);
        }
        if (n.kind == NodeKind::ArrayAccess) {
            return IdentityTextCheck::taint(ctx, state, (e as ArrayAccessNode*).array, depth + 1, nodes);
        }
        if (n.kind == NodeKind::TernaryExpression) {
            const t: TernaryExprNode* = e as TernaryExprNode*;
            const a: boolean = IdentityTextCheck::taint(ctx, state, t.true_expr, depth + 1, nodes);
            const c: boolean = IdentityTextCheck::taint(ctx, state, t.false_expr, depth + 1, nodes);
            return a || c;
        }
        if (n.kind == NodeKind::IfExpression) {
            const ie: IfExprNode* = e as IfExprNode*;
            const a: boolean = IdentityTextCheck::taint(ctx, state, ie.then_expr, depth + 1, nodes);
            const c: boolean = IdentityTextCheck::taint(ctx, state, ie.else_expr, depth + 1, nodes);
            return a || c;
        }
        if (n.kind == NodeKind::MemberAccess) {
            return IdentityTextCheck::taint(ctx, state, (e as MemberAccessNode*).object, depth + 1, nodes);
        }
        if (n.kind == NodeKind::CallExpression) {
            const call: CallExprNode* = e as CallExprNode*;
            // The call's own answer, whatever it is handed.
            const entry: OverloadId = CallFacts::callee_entry(ctx, call).entry;
            if (entry.is_valid()) { IdentityTextCheck::add_node(nodes, FlowNode::returned(entry.table_key())); }
            mut held: boolean = false;
            const cn: ASTNode* = call.callee as ASTNode*;
            if (cn != null && cn.kind == NodeKind::MemberAccess
                    && IdentityTextCheck::taint(ctx, state, (call.callee as MemberAccessNode*).object, depth + 1, nodes)) {
                held = true;
            }
            for (mut i: i64 = 0; i < call.arguments.length; i++) {
                if (IdentityTextCheck::taint(ctx, state, call.arguments[i], depth + 1, nodes)) { held = true; }
            }
            return held;
        }
        return false;
    }

    /// Add `node` to `nodes` unless it is there.
    static add_node(nodes: FlowNode[]*, node: FlowNode) -> void {
        for (mut i: i64 = 0; i < (*nodes).length; i++) {
            if ((*nodes)[i].equals(&node)) { return; }
        }
        (*nodes).push(node);
    }

    /// Record the local `var_node` declares as identity text when its
    /// initializer is, and as holding the flow nodes its initializer holds.
    static note_local(ctx: CompilationContext*, state: SemaState*, var_node: VarDeclNode*) -> void {
        if (!state.identity_text_on || var_node == null || !var_node.sym_id.is_valid()) { return; }
        IdentityTextCheck::note_write(ctx, state, var_node.sym_id.table_key(), var_node.initializer);
    }

    /// Record the local an assignment writes as identity text when the
    /// value it is given is.  A local once identity text stays so: the
    /// check does not follow which assignment reaches which read.
    static note_assignment(ctx: CompilationContext*, state: SemaState*, bin: BinaryExprNode*) -> void {
        if (!state.identity_text_on || bin == null || !bin.op.kind.is_assignment_op()) { return; }
        const ln: ASTNode* = bin.left as ASTNode*;
        if (ln == null || ln.kind != NodeKind::Identifier) { return; }
        match ((bin.left as IdentifierNode*).res) {
            ResSlot::Answered(r) => {
                match (r) {
                    Res::Local(sym) => { IdentityTextCheck::note_write(ctx, state, sym.table_key(), bin.right); }
                    _               => { }
                }
            }
            _ => { }
        }
    }

    /// The local `key` is written `value`.
    static note_write(ctx: CompilationContext*, state: SemaState*, key: SymbolKey, value: ExpressionNode*) -> void {
        mut nodes: FlowNode[] = [];
        if (IdentityTextCheck::taint(ctx, state, value, 0, &nodes)) { state.identity_locals.insert(key); }
        if (nodes.length == 0 || !IdentityTextCheck::flowing(state)) { return; }
        const held: FlowNode[]* = state.flow_locals.get_or_insert(key, []);
        for (mut i: i64 = 0; i < nodes.length; i++) { IdentityTextCheck::add_node(held, nodes[i]); }
    }

    /// The function being checked answers `value`.  What it answers from
    /// its own parameters is not recorded: a caller takes the answer of a
    /// call to hold what it handed the call, so the text a caller hands
    /// comes back to that caller and no other.
    static check_return(ctx: CompilationContext*, state: SemaState*, value: ExpressionNode*) -> void {
        if (!IdentityTextCheck::flowing(state) || value == null || state.in_lambda_depth > 0) { return; }
        const own: OverloadKey = state.identity_entry.table_key();
        const answer: FlowNode = FlowNode::returned(own);
        mut nodes: FlowNode[] = [];
        if (IdentityTextCheck::taint(ctx, state, value, 0, &nodes)) {
            ctx.identity_flow.seed(answer, value.span);
        }
        for (mut i: i64 = 0; i < nodes.length; i++) {
            if (nodes[i].is_input_of(own)) { continue; }
            ctx.identity_flow.flow(nodes[i], answer);
        }
    }

    /// Refuse identity text compared with other text (`==`, `!=`): the
    /// comparison asks which definition the text names, which the
    /// identity it was read from answers.
    static check_compare(ctx: CompilationContext*, state: SemaState*, bin: BinaryExprNode*) -> void {
        if (!state.identity_text_on || state.identity_exempt || bin == null) { return; }
        if (bin.op.kind != TokenType::EqualEqual && bin.op.kind != TokenType::ExclaimEqual) { return; }
        if (!IdentityTextCheck::is_text(ctx, bin.left.resolved_type) || !IdentityTextCheck::is_text(ctx, bin.right.resolved_type)) {
            return;
        }
        if (IdentityTextCheck::is_empty_text(bin.left) || IdentityTextCheck::is_empty_text(bin.right)) { return; }
        IdentityTextCheck::sink_or_refuse(ctx, state, bin.left, (bin as ASTNode*).span, "==", Text::new("operand of a comparison"), false);
        IdentityTextCheck::sink_or_refuse(ctx, state, bin.right, (bin as ASTNode*).span, "==", Text::new("operand of a comparison"), false);
    }

    /// Refuse identity text as a `match`'s subject: the arms ask which
    /// definition the text names.
    static check_match(ctx: CompilationContext*, state: SemaState*, subject: ExpressionNode*) -> void {
        if (!state.identity_text_on || state.identity_exempt || subject == null) { return; }
        if (!IdentityTextCheck::is_text(ctx, subject.resolved_type)) { return; }
        IdentityTextCheck::sink_or_refuse(ctx, state, subject, subject.span, "match", Text::new("subject of a `match`"), false);
    }

    /// Whether `e` is the empty string literal: a comparison with it asks
    /// whether there is any text, not which.
    static is_empty_text(e: ExpressionNode*) -> boolean {
        if (e == null || (e as ASTNode*).kind != NodeKind::Literal) { return false; }
        const lit: LiteralNode* = e as LiteralNode*;
        return lit.literal_kind == LiteralKind::String && lit.value.length() == 0;
    }

    /// Whether a value of type `ty` is text: a `string` or one of the
    /// compiler's spelling or identity-text types, directly or through a
    /// reference, a pointer or an array.  A message's `Text` is not: text
    /// put into a message is shown.
    static is_text(ctx: CompilationContext*, ty: TypeRef) -> boolean {
        mut cur: TypeRef = ty;
        for (mut depth: i32 = 0; depth < 8; depth++) {
            if (!cur.is_valid()) { return false; }
            const t: Type* = ctx.type_arena.lookup(cur);
            if (t == null) { return false; }
            match (t.kind) {
                TypeKind::Reference => { cur = (t as ReferenceType*).referent; }
                TypeKind::Pointer   => { cur = (t as PointerType*).pointee; }
                TypeKind::Array     => { cur = (t as ArrayType*).element; }
                TypeKind::String    => { return true; }
                _                   => {
                    return DirectiveProcessingPasses::spelling_type_of(ctx, cur).length() > 0
                        || IdentityTextCheck::is_identity_text_type(ctx, cur);
                }
            }
        }
        return false;
    }

    /// Whether `call` asks a hash table by a key: a method of `HashMap` or
    /// `HashSet` handed at least one argument, the first of which is the key.
    static is_table_call(ctx: CompilationContext*, call: CallExprNode*) -> boolean {
        const cn: ASTNode* = call.callee as ASTNode*;
        if (cn == null || cn.kind != NodeKind::MemberAccess || call.arguments.length == 0) { return false; }
        mut ty: TypeRef = (call.callee as MemberAccessNode*).object.resolved_type;
        for (mut depth: i32 = 0; depth < 4; depth++) {
            const t: Type* = ctx.type_arena.lookup(ty);
            if (t == null) { return false; }
            if (t.kind == TypeKind::Reference) { ty = (t as ReferenceType*).referent; continue; }
            if (t.kind == TypeKind::Pointer) { ty = (t as PointerType*).pointee; continue; }
            break;
        }
        const base_ty: TypeRef = ctx.type_arena.inst_generic_base(ty);
        if (!base_ty.is_valid()) { return false; }
        const base: DefId = ctx.decl_index.registered_def(base_ty);
        const reg: GenericRegistry* = ctx.get_generic_registry();
        if (!base.is_valid() || reg == null) { return false; }
        return base.equals(reg.wellknown(LangItem::HashMap)) || base.equals(reg.wellknown(LangItem::HashSet));
    }

    /// E0157 at each argument of `call` that is identity text, when the
    /// call is a door's or a hash table's; text that may come from a
    /// parameter or another call's answer is recorded as a sink of that
    /// node.  Any other call is a flow: what each argument and the receiver
    /// may hold goes on to the callee's matching node.
    static check_call(ctx: CompilationContext*, state: SemaState*, call: CallExprNode*, ty: TypeRef) -> void {
        if (!state.identity_text_on || state.identity_exempt || call == null) { return; }
        IdentityTextCheck::check_text_question(ctx, state, call, ty);
        const entry: OverloadId = CallFacts::callee_entry(ctx, call).entry;
        if (DirectiveProcessingPasses::is_door(ctx.decl_index.entry_decl(entry))) {
            const callee: string = IdentityTextCheck::callee_shown(ctx, call);
            for (mut i: i64 = 0; i < call.arguments.length; i++) {
                IdentityTextCheck::sink_or_refuse(ctx, state, call.arguments[i], call.arguments[i].span, callee,
                    Text::new("argument of a door"), true);
            }
            return;
        }
        if (IdentityTextCheck::is_table_call(ctx, call)) {
            IdentityTextCheck::sink_or_refuse(ctx, state, call.arguments[0], call.arguments[0].span,
                IdentityTextCheck::callee_shown(ctx, call), Text::new("key of a hash table"), false);
            return;
        }
        if (!entry.is_valid()) { return; }
        const key: OverloadKey = entry.table_key();
        const cn: ASTNode* = call.callee as ASTNode*;
        if (cn != null && cn.kind == NodeKind::MemberAccess) {
            IdentityTextCheck::flow_into(ctx, state, (call.callee as MemberAccessNode*).object, FlowNode::receiver(key));
        }
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            IdentityTextCheck::flow_into(ctx, state, call.arguments[i], FlowNode::argument(key, i));
        }
    }

    /// A call answering a `boolean` that is handed more than one text -
    /// receiver and arguments - compares them (`a.equals(b)`,
    /// `s.starts_with(p)`): each is looked up as a comparison's operand.
    static check_text_question(ctx: CompilationContext*, state: SemaState*, call: CallExprNode*, ty: TypeRef) -> void {
        const t: Type* = ctx.type_arena.lookup(ty);
        if (t == null || t.kind != TypeKind::Bool) { return; }
        mut operands: ExpressionNode*[] = [];
        const cn: ASTNode* = call.callee as ASTNode*;
        if (cn != null && cn.kind == NodeKind::MemberAccess) {
            const recv: ExpressionNode* = (call.callee as MemberAccessNode*).object;
            if (recv != null && IdentityTextCheck::is_text(ctx, recv.resolved_type)) { operands.push(recv); }
        }
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            const a: ExpressionNode* = call.arguments[i];
            if (a != null && IdentityTextCheck::is_text(ctx, a.resolved_type) && !IdentityTextCheck::is_empty_text(a)) {
                operands.push(a);
            }
        }
        if (operands.length < 2) { return; }
        const callee: string = IdentityTextCheck::callee_shown(ctx, call);
        for (mut i: i64 = 0; i < operands.length; i++) {
            IdentityTextCheck::sink_or_refuse(ctx, state, operands[i], (call as ASTNode*).span, callee,
                Text::new("operand of a comparison"), false);
        }
    }

    /// What `value` may hold goes on to `to`; identity text in it enters
    /// there.
    static flow_into(ctx: CompilationContext*, state: SemaState*, value: ExpressionNode*, to: FlowNode) -> void {
        if (value == null) { return; }
        mut nodes: FlowNode[] = [];
        if (IdentityTextCheck::taint(ctx, state, value, 0, &nodes)) { ctx.identity_flow.seed(to, value.span); }
        if (!IdentityTextCheck::flowing(state)) { return; }
        for (mut i: i64 = 0; i < nodes.length; i++) { ctx.identity_flow.flow(nodes[i], to); }
    }

    /// The call's callee as written, for a message.
    static callee_shown(ctx: CompilationContext*, call: CallExprNode*) -> string {
        mut callee: string = CallFacts::callee_spelled(ctx, call);
        if (callee.starts_with(".")) { callee = callee.substr(1, callee.length() as i64 - 1); }
        return callee;
    }

    /// `arg` is looked up at `site` by `callee`, a door's when `of_door`
    /// says: E0157 when it is identity text; a sink of each flow node it may
    /// hold otherwise.
    static sink_or_refuse(ctx: CompilationContext*, state: SemaState*, arg: ExpressionNode*, site: SourceSpan,
                          callee: string, asked: Text, of_door: boolean) -> void {
        if (arg == null) { return; }
        mut nodes: FlowNode[] = [];
        if (IdentityTextCheck::taint(ctx, state, arg, 0, &nodes)) {
            IdentityTextCheck::refuse(ctx, callee, site, asked, SourceSpan::none());
            return;
        }
        if (!IdentityTextCheck::flowing(state)) { return; }
        const f: FunctionDeclNode* = state.current_func;
        const within: string = if (f != null) { ctx.intern_table.resolve(f.name) } else { "" };
        for (mut i: i64 = 0; i < nodes.length; i++) {
            ctx.identity_flow.sink(nodes[i], FlowSink {
                span: site, callee: callee, asked: asked.as_string(), within: within, of_door: of_door
            });
        }
    }

    /// E0157 at `site`: identity text is looked up by `callee`.  `entered`,
    /// when it names a place, is where the text left the function that read
    /// it off a definition.
    static refuse(ctx: CompilationContext*, callee: string, site: SourceSpan, asked: Text, entered: SourceSpan) -> void {
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0157_LOOKUP_BY_SPELLING, Text::new(fmt::format(
            "`%s` is handed text read off a definition, which is shown and never looked up by",
            callee)));
        diag = diag.at_with_label(site, Text::new(fmt::format(
            "computed from a `DeclName`, and the %s", asked.as_string())));
        if (entered.file.length() > 0) {
            diag = diag.also_at(entered, Text::new("the definition's text leaves the function that read it here"));
        }
        diag = diag.help(Text::new(
            "ask with the identity the text was read from: its `DefId`, or the `TypeRef` it declares"));
        ctx.emit_diagnostic(diag);
    }

    /// Once every module is checked: E0157 at each lookup that text read off
    /// a definition reaches through other functions.
    static report_flows(ctx: CompilationContext*) -> void {
        const found: FlowFinding[] = ctx.identity_flow.findings();
        for (mut i: i64 = 0; i < found.length; i++) {
            IdentityTextCheck::refuse(ctx, found[i].sink.callee, found[i].sink.span,
                Text::new(found[i].sink.asked), found[i].entered);
        }
    }
}
