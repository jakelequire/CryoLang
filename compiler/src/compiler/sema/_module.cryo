/// Sema Module  (compiler::sema)
///
/// The type check.  Structured after codegen's `IRGeneratorVisitor`: one
/// main struct, `SemaVisitor`, dispatching on each node's kind, plus
/// collaborators wired to it by back-pointer.  A collaborator that recurses
/// into the tree is handed the `SemaVisitor*` and calls it.

namespace compiler::sema;

// -- Foundations --
public module State;        // SemaState (shared mutable per-pass state)

// -- Collaborators (leaf -> core; appended as built) --
public module Helpers;         // pure free fns + numeric constants
public module ScopeManager;    // per-function locals + scope undo log
public module LiteralResolver; // literal typing + the single literal-default rule
public module TypeUtils;       // pure type queries + DI lookup delegates (R4-tagged)
public module Diagnostics;     // mismatch builder, did-you-mean, arity/payload emitters
public module SymbolicChecker; // pure symbolic generic-body helpers (KEEP cluster)
public module MethodBinding;   // generic method resolution + binding stash + assoc-proj
public module MemberResolver;  // obj.field / obj[i] / method-as-value + visibility
public module PatternResolver; // match-pattern binding + exhaustiveness
public module LambdaSynth;     // lambda typing + closure-struct synthesis
public module AsyncLower;      // async-fn -> Future state-machine lowering
public module CallResolver;    // call dispatch + overload + free/method/scope resolution

// -- Main visitor (declared LAST: imports every collaborator) --
public module Sema;            // type class SemaVisitor + SemanticPasses::run_sema
