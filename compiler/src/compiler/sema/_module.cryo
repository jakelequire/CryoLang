/// Sema Module  (compiler::sema)
///
/// The type check.  Structured after codegen's `IRGeneratorVisitor`: one
/// main struct, `SemaVisitor`, dispatching on each node's kind, plus
/// collaborators wired to it by back-pointer.  A collaborator that recurses
/// into the tree is handed the `SemaVisitor*` and calls it.

namespace compiler::sema;

// -- Foundations --
module State;        // SemaState (shared mutable per-pass state)

// -- Collaborators (leaf -> core; appended as built) --
module {
    Helpers;         // pure free fns + numeric constants
    ScopeManager;    // per-function locals + scope undo log
    LiteralResolver; // literal typing + the single literal-default rule
    TypeUtils;       // pure type queries + DI lookup delegates (R4-tagged)
    Diagnostics;     // mismatch builder, did-you-mean, arity/payload emitters
    SymbolicChecker; // pure symbolic generic-body helpers (KEEP cluster)
    MethodBinding;   // generic method resolution + binding stash + assoc-proj
    MemberResolver;  // obj.field / obj[i] / method-as-value + visibility
    PatternResolver; // match-pattern binding + exhaustiveness
    LambdaSynth;     // lambda typing + closure-struct synthesis
    AsyncLower;      // async-fn -> Future state-machine lowering
    CallResolver;    // call dispatch + overload + free/method/scope resolution
}

// -- Main visitor (declared LAST: imports every collaborator) --
module Sema;            // type struct SemaVisitor + SemanticPasses::run_sema
