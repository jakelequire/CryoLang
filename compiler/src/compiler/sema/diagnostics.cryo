/// Diagnostics
///
/// Sema's diagnostic construction helpers: the rich "mismatched types"
/// builder with literal-aware quickfixes, the did-you-mean candidate collectors
/// + attachment, and the arity / payload-escape emitters.  Centralizing them
/// keeps the resolvers focused on resolution and gives every code a uniform
/// headline/label/suggestion shape.
///
/// Holds the env by pointer plus `state` (for the local-name collector) and a
/// peer pointer to `TypeUtils` (for `type_display_name`).
///
/// TODO(port): the import-insertion machinery lives in the entangled core region
/// of the monolith (find_import_insertion_span, suggest_similar_method,
/// find_shadowed_*, emit_free_* - sema.cryo ~9883+).
/// They are ported here when that region is read for the core trio.  emit_free_*
/// stays with CallResolver.

namespace compiler::sema::diagnostics;

import compiler::diag;
import compiler::diag::{ diagnostic, edit_distance, ErrorCode, source_span, suggestion };
import compiler::types::{ type_ref, type_base, arena, compound, user_defined, TypeKind };
import compiler::resolver::{ symbol_str, intern_table, qualified_name };
import compiler::compilation_context;
import compiler::compilation_context::{ CompilationContext };
import compiler::decl_index;
import compiler::decl_index::{ DeclarationIndex };
import compiler::ast;
import compiler::ast::{ expression, LiteralKind, node, TypeAnnotation };
import compiler::lex;
import compiler::sema::{ state, helpers, type_utils };
import std::core::option;
import std::core::option::{ Option };
import std::collections::hashmap;
import std::collections::hashmap::{ HashMapIter };
import std::fmt;
import compiler::types::generic;
import compiler::types::generic::{ InstantiatedType };
import compiler::ast::expression::{ CallExpr, ExpressionNode, LiteralExpr };
import compiler::ast::node::{ ProgramNode };
import compiler::diag::diagnostic::{ Diagnostic };
import compiler::diag::edit_distance::{ find_best_candidate };
import compiler::diag::source_span::{ SourceSpan };
import compiler::diag::suggestion::{ Applicability, Suggestion };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::qualified_name::{ QualifiedName };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::decl_name::{ DeclName };
import compiler::sema::helpers::{ lexeme_looks_like_number };
import compiler::sema::state::{ SemaState };
import compiler::sema::type_utils::{ TypeUtils };
import compiler::types::arena::{ TypeArena };
import compiler::types::compound::{ PointerType, ReferenceType };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };
import compiler::types::user_defined::{ EnumType, MethodInfo, StructType };
import compiler::module_graph::{ ModulePath };
import compiler::ast::{ ImportStyle };
import compiler::ast::declaration::{ DeclarationNode, ImportDecl };

/// Another type of a refused name's spelling: its path, as text for the
/// message, and the module it is declared in.
type struct ShadowCandidate {
    path:   string;
    module: ModulePath;
}

type struct Diagnostics {
    arena:  TypeArena*;
    intern: InternTable*;
    ctx:    CompilationContext*;
    state:  SemaState*;
    types:  TypeUtils*;

    static null() -> Diagnostics {
        return Diagnostics { arena: null, intern: null, ctx: null, state: null, types: null };
    }

    wire(mut &this, arena: TypeArena*, intern: InternTable*, ctx: CompilationContext*,
                    state: SemaState*, types: TypeUtils*) -> void {
        this.arena  = arena;
        this.intern = intern;
        this.ctx    = ctx;
        this.state  = state;
        this.types  = types;
    }


    // -- Did-you-mean candidate collectors --
    //
    // Each walks one symbol table and returns bare (non-`::`) names to feed
    // `find_best_candidate` from a typo diagnostic.

    /// Field + method names on a struct (E0204 did-you-mean).  Walks past
    /// pointer/reference/instantiation wrappers like the member-access resolver.
    collect_struct_member_names(&this, obj_type: TypeRef) -> [string] {
        mut out: [string] = [];
        mut walk_ty: TypeRef = obj_type;
        mut walk_t:  Type*   = this.arena.lookup(walk_ty);
        mut depth: i32 = 0;
        while (walk_t != null && depth < 5) {
            match (walk_t.kind) {
                TypeKind::Pointer => {
                    walk_ty = walk_t.as_pointer().pointee;
                    walk_t  = this.arena.lookup(walk_ty);
                }
                TypeKind::Reference => {
                    walk_ty = walk_t.as_reference().referent;
                    walk_t  = this.arena.lookup(walk_ty);
                }
                TypeKind::InstantiatedType => {
                    const it: InstantiatedType* = walk_t.as_instantiated();
                    if (!it.has_resolved_type()) { break; }
                    walk_ty = it.resolved_type;
                    walk_t  = this.arena.lookup(walk_ty);
                }
                _ => { break; }
            }
            depth += 1;
        }
        if (walk_t == null) { return out; }

        match (walk_t.kind) {
            TypeKind::Struct => {
                const st: StructType* = walk_t.as_struct();
                for (mut i: i64 = 0; i < st.fields.length; i++)  { out.push(this.intern.shown(st.fields[i].decl_name())); }
                for (mut i: i64 = 0; i < st.methods.length; i++) { out.push(this.intern.resolve(st.methods[i].name)); }
            }
            _ => {}
        }
        return out;
    }


    // -- Mismatched-types builder --

    /// Rich "mismatched types" diagnostic with the `expected `<E>`,
    /// found `<F>`` inline label.  `context_msg` becomes the explanatory note;
    /// `context_span`, when set, attaches an "expected due to this" secondary.
    emit_type_mismatch(mut &this, code: ErrorCode, span: SourceSpan,
                       expected: TypeRef, found: TypeRef,
                       context_msg: string, context_span: SourceSpan) -> void {
        this.emit_type_mismatch_with_value(code, span, expected, found,
            context_msg, context_span, null);
    }

    /// As `emit_type_mismatch`, plus the offending value expression so a
    /// literal-aware quickfix can be attached.
    emit_type_mismatch_with_value(mut &this, code: ErrorCode, span: SourceSpan,
                                  expected: TypeRef, found: TypeRef,
                                  context_msg: string, context_span: SourceSpan,
                                  value_expr: ExpressionNode*) -> void {
        this.emit_mismatch_shown(code, span, expected, this.types.type_display_name(expected),
            found, context_msg, context_span, value_expr);
    }

    /// As `emit_type_mismatch_with_value`, where the expected type is the
    /// one the annotation `expected_ann` declared: it is shown as the
    /// annotation writes it.
    emit_declared_mismatch(mut &this, code: ErrorCode, span: SourceSpan,
                           expected: TypeRef, expected_ann: TypeAnnotation*, found: TypeRef,
                           context_msg: string, context_span: SourceSpan,
                           value_expr: ExpressionNode*) -> void {
        this.emit_mismatch_shown(code, span, expected,
            this.types.written_display_name(expected, expected_ann),
            found, context_msg, context_span, value_expr);
    }

    emit_mismatch_shown(mut &this, code: ErrorCode, span: SourceSpan,
                        expected: TypeRef, expected_name: string, found: TypeRef,
                        context_msg: string, context_span: SourceSpan,
                        value_expr: ExpressionNode*) -> void {
        const found_name: string = this.types.type_display_name(found);

        mut diag: Diagnostic = Diagnostic::error(code, "mismatched types");
        diag = diag.at_with_label(span,
            fmt::format("expected `%s`, found `%s`", expected_name, found_name));
        if (context_span.has_location()) {
            diag = diag.also_at(context_span, "expected due to this");
        }
        if (context_msg != "") {
            diag = diag.with_note(context_msg);
        }
        if (this.kind_or_void(expected) == TypeKind::Bool) {
            diag = diag.with_note(this.truth_test_hint(found));
        }
        diag = this.attach_type_coercion_suggestion(diag, span,
            expected, found, expected_name, value_expr);
        this.ctx.emit_diagnostic(diag);
    }

    /// The kind of type `ty`, or `Void` when it names none.
    kind_or_void(&this, ty: TypeRef) -> TypeKind {
        const t: Type* = this.arena.lookup(ty);
        if (t == null) { return TypeKind::Void; }
        return t.kind;
    }

    /// How a truth test on a value of type `ty` is written, since no type
    /// converts to `boolean`: as the comparison the test means.
    truth_test_hint(&this, ty: TypeRef) -> string {
        mut t: Type* = this.arena.lookup(ty);
        if (t != null && t.kind == TypeKind::InstantiatedType) {
            const it: InstantiatedType* = t.as_instantiated();
            if (it.has_resolved_type()) { t = this.arena.lookup(it.resolved_type); }
        }
        if (t == null) { return "write the comparison the test means, or `match` on it"; }
        if (t.kind == TypeKind::Enum && !t.as_enum().is_simple_enum()) {
            return "`match` on it";
        }
        return match (t.kind) {
            TypeKind::Int     => { "compare it explicitly, as in `n != 0`" }
            TypeKind::Float   => { "compare it explicitly, as in `x != 0.0`" }
            TypeKind::Char    => { "compare it explicitly, as in `c != '\\0'`" }
            TypeKind::Pointer => { "compare it with `null` explicitly, as in `p != null`" }
            TypeKind::String  => { "compare it with `null` explicitly, as in `s != null`" }
            TypeKind::Enum    => { fmt::format("compare it with one of `%s`'s variants (`==`), or `match` on it",
                                       this.types.type_display_name(ty)) }
            _                 => { "write the comparison the test means, or `match` on it" }
        };
    }

    /// Attach a literal-aware quickfix when the (expected, found, value) triple
    /// has an obvious bridge: bool<-`"true"`/`"false"`/`0`/`1`, string<-numeric
    /// literal (wrap in quotes), numeric<-numeric-looking string (drop quotes).
    /// All MachineApplicable; returns the diagnostic unchanged when none fit.
    attach_type_coercion_suggestion(&this, diag: Diagnostic, span: SourceSpan,
                                    expected: TypeRef, found: TypeRef, expected_name: string,
                                    value_expr: ExpressionNode*) -> Diagnostic {
        if (value_expr == null || !span.has_location()) { return diag; }
        const lit: LiteralExpr* = ExpressionNode::literal_of(value_expr);
        if (lit == null) { return diag; }

        const want_kind: TypeKind = this.kind_or_void(expected);
        const want_bool: boolean = want_kind == TypeKind::Bool;
        const want_string:  boolean = want_kind == TypeKind::String;
        const want_number:  boolean = want_kind == TypeKind::Int || want_kind == TypeKind::Float;
        const found_string: boolean = this.kind_or_void(found) == TypeKind::String;

        if (want_bool && lit.literal_kind == LiteralKind::String) {
            if (lit.value.eq("true")) {
                return diag.suggest(Suggestion::machine_applicable(
                    span, "true", "drop the quotes to write a `boolean`"));
            }
            if (lit.value.eq("false")) {
                return diag.suggest(Suggestion::machine_applicable(
                    span, "false", "drop the quotes to write a `boolean`"));
            }
        }
        if (want_bool && lit.literal_kind == LiteralKind::Integer) {
            if (lit.value.eq("0")) {
                return diag.suggest(Suggestion::machine_applicable(
                    span, "false", "use the boolean literal"));
            }
            if (lit.value.eq("1")) {
                return diag.suggest(Suggestion::machine_applicable(
                    span, "true", "use the boolean literal"));
            }
        }
        if (want_string &&
            (lit.literal_kind == LiteralKind::Integer
             || lit.literal_kind == LiteralKind::Float)) {
            return diag.suggest(Suggestion::machine_applicable(
                span, fmt::format("\"%s\"", lit.value),
                "wrap the literal in quotes to make it a string"));
        }
        if (found_string && !want_bool && !want_string
            && want_number
            && lexeme_looks_like_number(lit.value)) {
            return diag.suggest(Suggestion::machine_applicable(
                span, lit.value,
                fmt::format("drop the quotes to write a `%s`", expected_name)));
        }

        return diag;
    }


    // -- Arity / payload-escape emitters --

    /// Arity diagnostic (E0215/E0216) for a method / static-method call whose
    /// name resolved but argument count matched no overload.  `expected` < 0 when
    /// candidates disagree on arity (overloaded), giving a generic message.
    /// `variadic` names a callee whose `expected` is the count of its declared
    /// parameters, each required, with an unconstrained tail past them.
    emit_method_arity_error(mut &this, at: SourceSpan, name: SymbolStr,
                            kind: string, expected: i64, got: i64, variadic: boolean) -> void {
        const nm: string = this.intern.resolve(name);
        if (expected < 0) {
            mut d: Diagnostic = Diagnostic::error(
                ErrorCode::E0215_TOO_MANY_ARGS,
                fmt::format("no overload of %s `%s` takes %lld argument(s)", kind, nm, got));
            d = d.at_with_label(at, "no matching overload for this argument count");
            this.ctx.diagnostics.emit(d);
            return;
        }
        if (got < expected) {
            mut d: Diagnostic = Diagnostic::error(
                ErrorCode::E0216_TOO_FEW_ARGS,
                fmt::format("%s `%s` takes %s%lld argument(s) but %lld were supplied",
                       kind, nm, if (variadic) { "at least " } else { "" }, expected, got));
            d = d.at_with_label(at,
                fmt::format("missing %lld argument%s", expected - got,
                    if (expected - got == 1) { "" } else { "s" }));
            this.ctx.diagnostics.emit(d);
            return;
        }
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0215_TOO_MANY_ARGS,
            fmt::format("%s `%s` takes %lld argument(s) but %lld were supplied",
                   kind, nm, expected, got));
        d = d.at_with_label(at,
            fmt::format("unexpected argument%s", if (got - expected == 1) { "" } else { "s" }));
        this.ctx.diagnostics.emit(d);
    }

    /// Fold a same-named candidate's parameter count into a running unique-arity
    /// tally for arity diagnostics.  `uniq` starts at -1 (none seen) and becomes
    /// -2 once two candidates disagree on arity.
    note_arity(&this, uniq: i64, param_count: i64) -> i64 {
        if (uniq == -1)          { return param_count; }
        if (uniq != param_count) { return -2; }
        return uniq;
    }

    /// E0455 for returning a pointer/reference to a `match`-bound payload (lives
    /// in a temporary freed at function return).
    emit_payload_escape(mut &this, span: SourceSpan) -> void {
        this.ctx.emit_error_at(
            ErrorCode::E0455_DANGLING_POINTER,
            "cannot return a pointer or reference to a value bound by `match`: the payload lives in a temporary that is freed when the function returns. Return it by value (move the payload out) instead.",
            span);
    }


    // -- Method-not-found hints + import-shadow detection --

    /// Closest method name on `ty_ref` to `method_name` (edit-distance), or empty.
    suggest_similar_method(&this, ty_ref: TypeRef, method_name: SymbolStr) -> SymbolStr {
        if (!ty_ref.is_valid() || !method_name.is_valid()) { return SymbolStr::empty(); }
        const needle: string = this.intern.resolve(method_name);
        const cands: [string] = this.collect_struct_member_names(ty_ref);
        const best: string = find_best_candidate(needle, cands);
        if (best == "") { return SymbolStr::empty(); }
        return this.intern.intern(best);
    }

    /// A refused member access is offered the import that
    /// would have made its written type name the one meant: the types whose
    /// last segment is that spelling and which own the member.  The answer is
    /// each type's path as TEXT, for the diagnostic
    /// (`attach_shadow_import_suggestions`), and reaches no lookup.
    ///
    /// Other user-defined types whose simple-name matches `simple_name` - the
    /// written type spelling, or with none the last segment of
    /// `resolved_type`'s own path - and that own `member_name`
    /// (import-shadow detection); `resolved_type` is excluded.
    /// Capped at 4 candidates.
    find_shadowed_type_candidates(&this, simple_name: SymbolStr, member_name: SymbolStr,
                                  resolved_type: TypeRef) -> [ShadowCandidate] {
        const needle: string = if (simple_name.is_valid()) {
            this.intern.resolve(simple_name)
        } else {
            QualifiedName::leaf_of(this.intern.shown(this.arena.get_qualified_name(resolved_type)))
        };
        if (needle == "") { return []; }
        mut results: [ShadowCandidate] = [];
        const filter_member: boolean = member_name.is_valid();
        const n: i64 = this.arena.type_count();
        for (mut i: i64 = 0; i < n; i++) {
            const t: Type* = this.arena.types[i];
            if (t == null) { continue; }
            if (resolved_type.is_valid() && t.id == resolved_type.key()) { continue; }
            mut qname: DeclName = DeclName::empty();
            mut declared_in: ModulePath = ModulePath::none();
            mut has_member: boolean = !filter_member;
            const no_methods: [MethodInfo] = [];
            mut methods: &[MethodInfo] = &no_methods;
            if (t.kind == TypeKind::Struct) {
                const st: StructType* = t.as_struct();
                qname = st.qualified_name;
                declared_in = st.declared_in;
                methods = &st.methods;
            } else if (t.kind == TypeKind::Enum) {
                const et: EnumType* = t.as_enum();
                qname = et.qualified_name;
                declared_in = et.declared_in;
                methods = &et.methods;
                if (filter_member && et.variant_index(member_name) >= 0) { has_member = true; }
            } else {
                continue;
            }
            for (mut k: i64 = 0; filter_member && !has_member && k < methods.length; k++) {
                if (methods[k].name.equals(member_name)) { has_member = true; }
            }
            if (!qname.is_valid() || !has_member) { continue; }
            const qstr: string = this.intern.shown(qname);
            const leaf: string = QualifiedName::leaf_of(qstr);
            if (leaf != needle) { continue; }
            mut dup: boolean = false;
            for (mut j: i64 = 0; j < results.length; j++) {
                if (results[j].path == qstr) { dup = true; break; }
            }
            if (dup) { continue; }
            results.push(ShadowCandidate { path: qstr, module: declared_in });
            if (results.length >= 4) { break; }
        }
        return results;
    }

    /// A zero-width span for inserting a new `import ...;` line (after the last
    /// existing import, else the first non-import top-level node), or none.
    find_import_insertion_span(&this) -> SourceSpan {
        if (this.ctx == null) { return SourceSpan::none(); }
        const root: ProgramNode* = this.ctx.artifacts.ast.root;
        if (root == null) { return SourceSpan::none(); }
        mut last_import_span: SourceSpan = SourceSpan::none();
        mut fallback_span: SourceSpan = SourceSpan::none();
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const item: Node = root.statements[i];
            if (item.is_null()) { continue; }
            if (DeclarationNode::import_of(item.as_decl()) != null) { last_import_span = item.span(); }
            else if (!fallback_span.has_location()) { fallback_span = item.span(); }
        }
        const anchor: SourceSpan = if (last_import_span.has_location()) { last_import_span } else { fallback_span };
        if (!anchor.has_location()) { return SourceSpan::none(); }
        return SourceSpan::new(anchor.file, anchor.end_line, anchor.end_col, anchor.end_line, anchor.end_col);
    }

    /// Attach a note for each shadowed candidate `find_shadowed_type_candidates`
    /// answered with, and the way to reach it: when the file already imports
    /// the candidate's module, a help naming the qualified spelling, which is
    /// not applied for the user; otherwise a quickfix importing the module
    /// (MachineApplicable for a single candidate, else MaybeIncorrect).
    attach_shadow_import_suggestions(&this, diag: Diagnostic, simple_name_str: string,
                                     candidates: [ShadowCandidate]) -> Diagnostic {
        if (candidates.length == 0) { return diag; }
        mut out: Diagnostic = diag;
        const insert_span: SourceSpan = this.find_import_insertion_span();
        const apply: Applicability = if (candidates.length == 1) {
            Applicability::MachineApplicable
        } else {
            Applicability::MaybeIncorrect
        };
        mut any_to_import: boolean = false;
        for (mut i: i64 = 0; i < candidates.length; i++) {
            const cand_str: string = candidates[i].path;
            out = out.with_note(fmt::format("another `%s` exists: `%s`", simple_name_str, cand_str));
            const import_path: string = QualifiedName::parent_of(cand_str);
            if (import_path == "") { continue; }
            const bound: string = this.module_import_name(candidates[i].module);
            if (bound != "") {
                out = out.help(fmt::format("`%s` is already imported; write `%s::%s`",
                    import_path, bound, simple_name_str));
                continue;
            }
            any_to_import = true;
            if (insert_span.has_location()) {
                const insertion: string = fmt::format("\nimport %s;", import_path);
                const msg: string = fmt::format("import `%s`", import_path);
                out = out.suggest(Suggestion::single(insert_span, insertion, msg, apply));
            }
        }
        if (any_to_import) {
            out = out.help(fmt::format(
                "the unqualified name `%s` resolved to a different type than the one you meant; import the intended module to disambiguate",
                simple_name_str));
        }
        return out;
    }

    /// The name the current file's import of the whole module `m` binds it
    /// under - its alias, or the path's last segment - or "" when no such
    /// import names `m`.
    module_import_name(&this, m: ModulePath) -> string {
        if (this.ctx == null || !m.is_valid()) { return ""; }
        const root: ProgramNode* = this.ctx.artifacts.ast.root;
        if (root == null) { return ""; }
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: DeclarationNode* = root.statements[i].as_decl();
            if (stmt == null) { continue; }
            const imp: ImportDecl* = DeclarationNode::import_of(stmt);
            if (imp == null) { continue; }
            // `import A::B as C;` is one entry naming the sub-module.
            if (imp.path_entry) {
                for (mut k: i64 = 0; k < imp.specific_defs.length; k++) {
                    if (!this.ctx.module_graph.module_of_def(imp.specific_defs[k]).equals(m)) { continue; }
                    const e: i64 = imp.specific_def_entries[k];
                    if (e < imp.specific_aliases.length && imp.specific_aliases[e].is_valid()) {
                        return this.intern.resolve(imp.specific_aliases[e]);
                    }
                    return this.intern.resolve(imp.specific_imports[e]);
                }
                continue;
            }
            match (imp.style) {
                ImportStyle::Module => { }
                _ => { continue; }
            }
            if (!imp.resolved_module.equals(m)) { continue; }
            if (imp.alias.is_valid()) { return this.intern.resolve(imp.alias); }
            return QualifiedName::leaf_of(this.intern.shown(m.decl_name()));
        }
        return "";
    }
}
