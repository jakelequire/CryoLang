/// Operator -> (language trait, method) overloading map. `valid == false` means
/// the operator is not overloadable; `negate` flags `!=`, which lowers to
/// `!a.equals(&b)`. `ord_pred` (non-empty only for the relational operators
/// `< > <= >=`) names an `Ordering` predicate: those lower to
/// `a.compare(&b).<ord_pred>()` (e.g. `a < b` -> `a.compare(&b).is_lt()`).
/// `deref_wrap` flags the unary `*` -> `Deref`: the built `b.deref()` call
/// returns `Target*`, so the desugar wraps it in an outer `*` (`*(b.deref())`),
/// a place that serves read / write / compound uniformly.
/// Kept in one place so the plain-binary, compound-assignment, and unary sema
/// paths agree on the mapping.
type struct OperatorTraitMap {
    lang:       LangItem;
    method:     string;
    ord_pred:   string;
    negate:     boolean;
    deref_wrap: boolean;
    valid:      boolean;

    static none() -> OperatorTraitMap {
        return OperatorTraitMap { lang: LangItem::Add, method: "", ord_pred: "", negate: false, deref_wrap: false, valid: false };
    }

    static mk(t: LangItem, m: string, neg: boolean) -> OperatorTraitMap {
        return OperatorTraitMap { lang: t, method: m, ord_pred: "", negate: neg, deref_wrap: false, valid: true };
    }

    /// A relational operator: `a OP b` -> `a.compare(&b).<pred>()` via `Ord`.
    static mk_ord(pred: string) -> OperatorTraitMap {
        return OperatorTraitMap { lang: LangItem::Ord, method: "compare", ord_pred: pred, negate: false, deref_wrap: false, valid: true };
    }

    /// Unary `*` -> `Deref::deref`: `*b` desugars to `*(b.deref())`.
    static mk_deref() -> OperatorTraitMap {
        return OperatorTraitMap { lang: LangItem::Deref, method: "deref", ord_pred: "", negate: false, deref_wrap: true, valid: true };
    }

    /// Binary `+ - * / %` (arithmetic), `== !=` (equality via `Eq`), and
    /// `< > <= >=` (relational via `Ord::compare`). Bitwise, shift, and logical
    /// operators are intentionally absent: they are not overloadable in v1.
    static for_binary(op: string) -> OperatorTraitMap {
        if (op == "+")  { return OperatorTraitMap::mk(LangItem::Add, "add", false); }
        if (op == "-")  { return OperatorTraitMap::mk(LangItem::Sub, "sub", false); }
        if (op == "*")  { return OperatorTraitMap::mk(LangItem::Mul, "mul", false); }
        if (op == "/")  { return OperatorTraitMap::mk(LangItem::Div, "div", false); }
        if (op == "%")  { return OperatorTraitMap::mk(LangItem::Rem, "rem", false); }
        if (op == "==") { return OperatorTraitMap::mk(LangItem::Eq, "equals", false); }
        if (op == "!=") { return OperatorTraitMap::mk(LangItem::Eq, "equals", true); }
        if (op == "<")  { return OperatorTraitMap::mk_ord("is_lt"); }
        if (op == ">")  { return OperatorTraitMap::mk_ord("is_gt"); }
        if (op == "<=") { return OperatorTraitMap::mk_ord("is_le"); }
        if (op == ">=") { return OperatorTraitMap::mk_ord("is_ge"); }
        if (op == "&")  { return OperatorTraitMap::mk(LangItem::BitAnd, "bitand", false); }
        if (op == "|")  { return OperatorTraitMap::mk(LangItem::BitOr,  "bitor",  false); }
        if (op == "^")  { return OperatorTraitMap::mk(LangItem::BitXor, "bitxor", false); }
        if (op == "<<") { return OperatorTraitMap::mk(LangItem::Shl,    "shl",    false); }
        if (op == ">>") { return OperatorTraitMap::mk(LangItem::Shr,    "shr",    false); }
        return OperatorTraitMap::none();
    }

    /// Unary `-` (negation) -> `Neg`, `!` -> `Not`, `~` -> `BitNot`, and `*`
    /// (dereference) -> `Deref`. All are type-directed and only fire when the
    /// primitive `check_unary_op` rule rejects the operand.
    static for_unary(op: string) -> OperatorTraitMap {
        if (op == "-") { return OperatorTraitMap::mk(LangItem::Neg, "neg", false); }
        if (op == "!") { return OperatorTraitMap::mk(LangItem::Not, "not", false); }
        if (op == "~") { return OperatorTraitMap::mk(LangItem::BitNot, "bitnot", false); }
        if (op == "*") { return OperatorTraitMap::mk_deref(); }
        return OperatorTraitMap::none();
    }
}


type class SemaVisitor : BaseASTVisitor {
public:
    // -- Immutable environment + the by-value checker (handed to collaborators
    //    as pointers via wire()) --
    arena:    TypeArena*;
    checker:  TypeChecker;
    intern:   InternTable*;
    ctx:      CompilationContext*;
    this_sym: SymbolStr;
    /// The allocator the `?` desugaring takes its bindings' identities from.
    /// That desugaring declares two bindings after name resolution has run,
    /// and a binding's identity comes from the one allocator that hands them
    /// out.  Held from `wire()`, one door; never asked by name.
    resolver: Resolver*;

    // -- Shared mutable per-pass state (shared by pointer) --
    state: SemaState;

    // -- Collaborators (owned by value; back-pointers set in wire()) --
    scopes:   ScopeManager;
    types:    TypeUtils;
    literals: LiteralResolver;
    diag:     Diagnostics;
    dispatch: SemaDispatch;
    symbolic: SymbolicChecker;
    binding:  MethodBinding;
    patterns: PatternResolver;
    lambda:   LambdaSynth;
    async_lower: AsyncLower;
    member:   MemberResolver;
    calls:    CallResolver;

    SemaVisitor(arena: TypeArena*, intern: InternTable*, ctx: CompilationContext*) : BaseASTVisitor() {
        this.arena    = arena;
        this.checker  = TypeChecker::new(arena);
        this.intern   = intern;
        this.ctx      = ctx;
        this.this_sym = intern.intern("this");
        this.resolver = null;
        this.state    = SemaState::new();
        this.scopes   = ScopeManager::null();
        this.types    = TypeUtils::null();
        this.literals = LiteralResolver::null();
        this.diag     = Diagnostics::null();
        this.dispatch = SemaDispatch::null();
        this.symbolic = SymbolicChecker::null();
        this.binding  = MethodBinding::null();
        this.patterns = PatternResolver::null();
        this.lambda   = LambdaSynth::null();
        this.async_lower = AsyncLower::null();
        this.member   = MemberResolver::null();
        this.calls    = CallResolver::null();
    }

    /// Build from the compilation context (declaration lookups go through
    /// ctx.decl_index, so no AST scan here).
    static build(ctx: CompilationContext*) -> SemaVisitor {
        return SemaVisitor(ctx.type_arena, ctx.get_intern_table(), ctx);
    }

    /// Two-phase init step 2: set every collaborator's back-pointers.  MUST run
    /// AFTER this visitor is at its stable heap address (see run_sema's leak()).
    wire(mut &this) -> void {
        this.resolver = this.ctx.get_resolver();
        this.scopes.wire(&this.state);
        this.types.wire(this.arena, this.intern, this.ctx, &this.checker);
        this.literals.wire(this.arena, this.ctx, &this.state);
        this.diag.wire(this.arena, this.intern, this.ctx, &this.state, &this.types);
        this.dispatch.wire(this.ctx, &this.state);
        this.symbolic.wire(this.arena, this.ctx, &this.state, &this.types);
        this.binding.wire(this.arena, this.intern, this.ctx, &this.state, &this.types, &this.symbolic);
        this.patterns.wire(this.arena, this.intern, this.ctx, &this.state, &this.types,
                           &this.symbolic, &this.scopes);
        this.lambda.wire(this.arena, this.intern, this.ctx, &this.state, &this.symbolic,
                         &this.scopes, &this.dispatch);
        this.async_lower.wire(this.arena, this.intern, this.ctx, &this.patterns);
        this.member.wire(this.arena, this.intern, this.ctx, &this.checker, &this.state, &this.types,
                         &this.symbolic, &this.binding, &this.diag, &this.dispatch);
        this.calls.wire(this.arena, this.intern, this.ctx, &this.checker, &this.state, &this.types,
                        &this.literals, &this.diag, &this.binding, &this.symbolic, &this.member,
                        &this.lambda, &this.scopes, &this.dispatch);
    }

    /// A wired visitor for a pass that synthesizes calls after sema has run
    /// (drop insertion, codegen's drop glue).  Leaked to a stable address the
    /// way `run_sema` does, because the collaborators hold back-pointers.
    static synthesized_binder(ctx: CompilationContext*) -> SemaVisitor* {
        const _box_v: Box<SemaVisitor> = Box::<SemaVisitor>::new(SemaVisitor::build(ctx));
        const v: SemaVisitor* = _box_v.leak();
        v.wire();
        return v;
    }

    /// Bind a method call another pass built.  The receiver already carries
    /// its type - the synthesizer put it there - so the walk starts at
    /// overload selection and pins `resolved_method` / `resolved_callee` the
    /// way it would for the same call written in source.  A receiver with no
    /// method of that name is left unpinned, which is what the caller's
    /// `.drop()` on a type without a user drop relies on.
    bind_synthesized_method_call(mut &this, call: CallExprNode*) -> void {
        if (call == null || call.callee == null) { return; }
        if (call.callee.kind != NodeKind::MemberAccess) { return; }
        const member: MemberAccessNode* = call.callee as MemberAccessNode*;
        if (member.object == null) { return; }
        const recv: TypeRef = member.object.resolved_type;
        if (!recv.is_valid()) { return; }
        this.calls.bind_method_on_receiver(this as ASTVisitor*, call, member, recv);
    }

    /// A fresh trait checker over the shared arena + registry (a 4-pointer view).
    trait_checker(&this) -> TraitChecker {
        return TraitChecker::new(this.arena, this.ctx.generic_registry,
                                 this.intern, this.ctx.diagnostics);
    }

    // -- Top-level + statement recursion seams --

    override visit(mut &this, node: ProgramNode*) -> void {
        this.declare_async_futures(node);
        for (mut i: i64 = 0; i < node.statements.length; i++) {
            const stmt: ASTNode* = node.statements[i];
            if (stmt == null) { continue; }
            this.dispatch_top_level(stmt);
        }
    }

    /// Give every `async function` in the module its future type before any body
    /// is typed.
    ///
    /// The state machine can only be built from a typed body, so the lowering
    /// runs at the end of each function's own visit. But an `await` resolves the
    /// callee's return type through the declaration index, so a caller visited
    /// before its callee would see the callee's pre-lowering signature and report
    /// that its Output "does not implement `Future`". Declaring the whole module's
    /// futures up front makes the order of declarations irrelevant, and lets an
    /// `async function` await itself.
    ///
    /// Bounded to the statement list: the count of async fns per module is small,
    /// and `declare` is idempotent per node.
    declare_async_futures(mut &this, node: ProgramNode*) -> void {
        for (mut i: i64 = 0; i < node.statements.length; i++) {
            const stmt: ASTNode* = node.statements[i];
            if (stmt == null) { continue; }
            match (stmt.kind) {
                NodeKind::FunctionDeclaration => {
                    const f: FunctionDeclNode* = stmt as FunctionDeclNode*;
                    // A lowered one has already had `is_async` cleared.
                    if (f.is_async && f.body != null) {
                        // `async function main` is renamed out of the entry-point
                        // slot first, so the future `declare` registers is keyed
                        // to the renamed function and not to `main`.
                        this.async_lower.desugar_async_main(f);
                        this.async_lower.declare(f);
                    }
                }
                // A declaration's owner is its own registered type and the
                // key it registered under, both off the stamp.
                NodeKind::StructDeclaration => {
                    const s: StructDeclNode* = stmt as StructDeclNode*;
                    this.declare_async_methods(s.methods, s.generic_params,
                        this.ctx.decl_index.type_of_decl(s.def, "sema/async declare struct"), s.name, null);
                }
                NodeKind::UnionDeclaration => {
                    const u: UnionDeclNode* = stmt as UnionDeclNode*;
                    this.declare_async_methods(u.methods, u.generic_params,
                        this.ctx.decl_index.type_of_decl(u.def, "sema/async declare union"), u.name, null);
                }
                NodeKind::ClassDeclaration => {
                    const c: ClassDeclNode* = stmt as ClassDeclNode*;
                    this.declare_async_methods(c.methods, c.generic_params,
                        this.ctx.decl_index.type_of_decl(c.def, "sema/async declare class"), c.name, null);
                }
                NodeKind::ImplementationBlock => {
                    const ib: ImplBlockNode* = stmt as ImplBlockNode*;
                    // The head's owner, off the stamp; the written target is
                    // what a refusal names.
                    mut owner_params: GenericParamNode*[] = this.impl_owner_params(ib);
                    this.declare_async_methods(ib.methods, owner_params,
                        this.ctx.decl_index.impl_owner(ib, "sema/async declare"), ib.target_type, ib);
                }
                _ => { }
            }
        }
    }

    /// Declare the future of every `async` method in one owner's method list.
    ///
    /// `owner_params` are the OWNER's generic parameters, which the future must
    /// carry as well as the method's own; `owner_ty` is the owner's registered
    /// type, handed over by a caller that holds it and never re-derived here -
    /// the key its methods are registered under is the index's to name from
    /// it.  `written` is the owner as the source spelled it, for the refusal
    /// of a method whose owner has no type.
    /// `impl_node` is the enclosing impl block when the owner is one (null
    /// otherwise); a trait impl uses it to bind the trait's implicit
    /// `<Method>Fut` associated type to the future each method lowers to.
    declare_async_methods(mut &this, methods: &MethodNode*[],
                          owner_params: &GenericParamNode*[],
                          owner_ty: TypeRef, written: SymbolStr,
                          impl_node: ImplBlockNode*) -> void {
        if (!owner_ty.is_valid()) { this.reject_undeclarable_async(methods, written); return; }
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null || m.func.body == null) { continue; }
            if (!m.func.is_async) { continue; }
            // Each override lowers to its OWN future struct, so they return
            // different types and cannot share a vtable slot. Clearing the flag
            // keeps the method compiling as an ordinary one instead of raising a
            // second, less informative error from the lowering.
            if (m.is_virtual || m.is_override) {
                this.ctx.emit_error_at(ErrorCode::E0364_INVALID_ASYNC_MEMBER,
                    "a `virtual` or `override` method cannot be `async`: each implementation returns its own future type, so the overrides have no common return type to dispatch through",
                    m.func.span);
                m.func.set_async(false);
                continue;
            }
            mut own: AsyncOwner = AsyncOwner {
                method: m,
                ty: this.async_owner_instance(owner_ty, owner_params),
                decl: owner_ty,
                written: written,
                params: this.clone_generic_params(owner_params),
                impl_node: impl_node,
            };
            this.async_lower.declare_method(own);
        }
    }

    /// Report every `async` method of an owner whose type could not be resolved,
    /// and clear the flag.
    ///
    /// Skipping quietly is what must not happen: an `async` method left
    /// undeclared reaches `lower` with no pending record, and that fallback
    /// declares it as a FREE function — where the body's `this` would silently
    /// resolve to the generated future instead of the receiver.
    reject_undeclarable_async(mut &this, methods: &MethodNode*[], written: SymbolStr) -> void {
        const owner: string = if (written.is_valid()) { this.intern.resolve(written) } else { "?" };
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null || !m.func.is_async) { continue; }
            this.ctx.emit_error_at(ErrorCode::E0203_UNDEFINED_TYPE,
                fmt::format("cannot resolve the owner type `%s` of `async` method `%s`, so its future cannot be declared",
                       owner, this.intern.resolve(m.func.name)),
                m.func.span);
            m.func.set_async(false);
        }
    }

    /// The owner type as a method body sees `this`: the type itself, or the
    /// template instantiated over its own parameters for a generic owner
    /// (`Box<T>`), which is what the symbolic walk binds `this` to.
    async_owner_instance(mut &this, base: TypeRef, params: &GenericParamNode*[]) -> TypeRef {
        if (!base.is_valid() || params.length == 0) { return base; }
        const t: Type* = this.arena.lookup(base.id);
        if (t == null || t.kind == TypeKind::InstantiatedType) { return base; }
        mut refs: TypeRef[] = TypeResolutionPasses::create_generic_param_types(params, this.arena);
        const inst: TypeRef = this.arena.create_instantiation(base, &refs);
        refs.drop();
        return inst;
    }

    /// The generic parameters the OWNER of an impl block's methods actually has.
    ///
    /// An impl block on a generic template writes them on the TARGET
    /// (`implement trait Sink for struct Buf<S>`), not on the block itself, so
    /// `generic_params` is empty there while the method bodies may still mention
    /// `S`. A future lowered from such a method has to be generic in `S` too: the
    /// future's own impl block is what decides whether sema walks its `poll` body
    /// symbolically, and a body walked concretely while an abstract projection
    /// (`S::ReadFut::Output`) is still in it fails every check against that
    /// projection instead of deferring until monomorphization resolves it.
    impl_owner_params(mut &this, ib: ImplBlockNode*) -> GenericParamNode*[] {
        if (ib.generic_params.length > 0) {
            return this.clone_generic_params(ib.generic_params);
        }
        const greg: GenericRegistry* = this.ctx.generic_registry;
        if (greg == null) { return []; }
        // The template the head's stamp names.  The target is written bare
        // (`BufStream`), and a spelling qualified by the module the impl sits
        // in names the template only when that module declares the type; an
        // impl written anywhere else missed, handed back no parameters, and
        // left the future non-generic in `S` while the body still mentioned
        // it.
        const tmpl: TemplateEntry* = greg.template_of(ib.target_def());
        if (tmpl == null || tmpl.ast_node == null) { return []; }
        if (tmpl.node_kind == NodeKind::StructDeclaration) {
            return this.clone_generic_params((tmpl.ast_node as StructDeclNode*).generic_params);
        }
        if (tmpl.node_kind == NodeKind::ClassDeclaration) {
            return this.clone_generic_params((tmpl.ast_node as ClassDeclNode*).generic_params);
        }
        if (tmpl.node_kind == NodeKind::EnumDeclaration) {
            return this.clone_generic_params((tmpl.ast_node as EnumDeclNode*).generic_params);
        }
        if (tmpl.node_kind == NodeKind::UnionDeclaration) {
            return this.clone_generic_params((tmpl.ast_node as UnionDeclNode*).generic_params);
        }
        return [];
    }

    clone_generic_params(&this, params: &GenericParamNode*[]) -> GenericParamNode*[] {
        mut out: GenericParamNode*[] = [];
        for (mut i: i64 = 0; i < params.length; i++) { out.push(params[i]); }
        return out;
    }

    /// Dispatch a top-level node, swapping to the template's module/namespace
    /// while walking an injected specialization (so qualified-name lookups land).
    dispatch_top_level(mut &this, stmt: ASTNode*) -> void {
        mut saved_scope: u64 = 0;
        mut saved_namespace: SymbolStr = SymbolStr::empty();
        mut needs_restore: boolean = false;
        const template_mod: SymbolStr = this.types.find_template_module(stmt);
        if (template_mod.is_valid()) {
            const resolver: Resolver* = this.ctx.get_resolver();
            if (resolver != null) {
                saved_scope = resolver.get_current_scope_id();
                const template_scope: u64 = resolver.find_module_scope(ModulePath::of(template_mod));
                if (template_scope > 0) {
                    // `find_module_scope` asks whether the module was entered
                    // without creating a scope for one that was not.
                    resolver.set_module(template_mod);
                    saved_namespace = this.ctx.swap_namespace(template_mod);
                    needs_restore = true;
                }
            }
        }
        stmt.accept(this);
        if (needs_restore) {
            const resolver: Resolver* = this.ctx.get_resolver();
            if (resolver != null) {
                resolver.restore_scope(saved_namespace, saved_scope);
            }
            this.ctx.swap_namespace(saved_namespace);
        }
    }

    /// Dispatch a statement to its typed visit() override via double-dispatch.
    dispatch_stmt(mut &this, stmt: StatementNode*) -> void {
        if (stmt == null) { return; }
        stmt.accept(this);
    }


    // -- Declaration visitors --

    override visit(mut &this, node: FunctionDeclNode*) -> void {
        if (node.body == null) { return; }
        if (node.is_generic()) {
            // A generic body is typed by the symbolic walk, against abstract
            // parameter refs. An `async function`'s state machine is then built
            // from the resolved types that walk leaves on the body, and the
            // future it produces is generic in the same parameters, so the
            // monomorphizer specializes it from the same demand that specializes
            // the function.
            this.symbolic_check_body(node, TypeRef::invalid(), TypeRef::invalid());
            if (node.is_async) {
                this.async_lower.lower(node);
            }
            return;
        }
        this.enter_function(node, TypeRef::invalid());
        this.visit(node.body);
        this.state.body_count += 1;
        this.check_function_returns(node);
        this.check_opaque_return_item(node);
        // Lower an `async function` into a Future state machine AFTER its body is
        // typed against the declared Output type. The generic case returned above.
        if (node.is_async) {
            this.async_lower.lower(node);
        }
    }

    override visit(mut &this, node: StructDeclNode*) -> void {
        // The declaration's own registration, by the id it stamped - for an
        // injected specialization the one its injector wrote, whichever
        // module the clone was placed in.
        const st_type: TypeRef = this.ctx.decl_index.type_of_decl(node.def, "sema/visit:StructDeclNode");
        if (node.is_generic()) {
            this.symbolic_check_owner_methods(node.methods, st_type, node.generic_params);
            return;
        }
        this.visit_methods(node.methods, st_type);
    }

    override visit(mut &this, node: UnionDeclNode*) -> void {
        const un_type: TypeRef = this.ctx.decl_index.type_of_decl(node.def, "sema/visit:UnionDeclNode");
        if (node.is_generic()) {
            this.symbolic_check_owner_methods(node.methods, un_type, node.generic_params);
            return;
        }
        this.visit_methods(node.methods, un_type);
    }

    override visit(mut &this, node: ClassDeclNode*) -> void {
        const cl_type: TypeRef = this.ctx.decl_index.type_of_decl(node.def, "sema/visit:ClassDeclNode");
        if (node.is_generic()) {
            this.symbolic_check_owner_methods(node.methods, cl_type, node.generic_params);
            return;
        }
        this.visit_methods(node.methods, cl_type);
    }

    override visit(mut &this, node: TraitDeclNode*) -> void {
        if (node.is_generic()) { return; }
        const this_name: SymbolStr = this.intern.intern("This");
        const this_placeholder: TypeRef = this.arena.this_placeholder(this_name);
        for (mut j: i64 = 0; j < node.methods.length; j++) {
            const func: FunctionDeclNode* = node.methods[j];
            if (func == null || func.body == null) { continue; }
            // A GENERIC default method (its own `<T>`) may use `static match (T)`
            // in its body; that has to be walked SYMBOLICALLY (in_symbolic_check),
            // exactly like a struct/impl generic method (visit_methods), so the
            // arms are deferred to monomorphization instead of tripping E0645
            // ("static match outside a generic context").  Non-generic defaults
            // keep the plain walk.
            if (func.is_generic()) {
                this.symbolic_check_body(func, this_placeholder, this_placeholder);
                continue;
            }
            this.enter_function(func, this_placeholder);
            this.visit(func.body);
            this.state.body_count += 1;
        }
    }

    override visit(mut &this, node: ImplBlockNode*) -> void {
        if (node.is_generic()) {
            const impl_target: TypeRef = this.ctx.decl_index.impl_owner(node, "sema/visit:ImplBlockNode");
            const saved_impl: ImplBlockNode* = this.state.symbolic_impl_node;
            this.state.symbolic_impl_node = node;
            this.symbolic_check_owner_methods(node.methods, impl_target, node.generic_params);
            this.state.symbolic_impl_node = saved_impl;
            return;
        }
        const greg: GenericRegistry* = this.ctx.generic_registry;
        if (greg != null) {
            // The template the head is written for, off the head's stamp.  A
            // head with no parameters of its own whose target is a template
            // names a concrete instantiation (`implement trait Clone for
            // String<GlobalAlloc>`; the elided form is refused where the head
            // is attached to its template).  Its methods are walked
            // symbolically over the TEMPLATE's parameters, as a generic head's
            // are over its own: that is what produces the method-spec demand
            // mono consumes (`call.set_resolved_type_args`), and the concrete
            // path below cannot type-check a body whose receiver is a template.
            // A walk over the instantiation itself waits on impl selection
            // honouring a concrete target argument, which nothing does yet.
            mut tmpl: TemplateEntry* = null;
            match (node.res) {
                ResSlot::Answered(r) => {
                    match (r) {
                        Res::Def(q) => { tmpl = greg.template_of(q); }
                        _           => { }
                    }
                }
                _ => { }
            }
            if (tmpl != null) {
                if (tmpl.ast_node != null) {
                    const owner_ty: TypeRef = this.ctx.decl_index.impl_owner(node, "sema/visit:ImplBlockNode");
                    const saved_impl: ImplBlockNode* = this.state.symbolic_impl_node;
                    this.state.symbolic_impl_node = node;
                    if (tmpl.node_kind == NodeKind::StructDeclaration) {
                        this.symbolic_check_owner_methods(node.methods, owner_ty,
                            (tmpl.ast_node as StructDeclNode*).generic_params);
                    } else if (tmpl.node_kind == NodeKind::ClassDeclaration) {
                        this.symbolic_check_owner_methods(node.methods, owner_ty,
                            (tmpl.ast_node as ClassDeclNode*).generic_params);
                    } else if (tmpl.node_kind == NodeKind::EnumDeclaration) {
                        this.symbolic_check_owner_methods(node.methods, owner_ty,
                            (tmpl.ast_node as EnumDeclNode*).generic_params);
                    } else if (tmpl.node_kind == NodeKind::UnionDeclaration) {
                        this.symbolic_check_owner_methods(node.methods, owner_ty,
                            (tmpl.ast_node as UnionDeclNode*).generic_params);
                    }
                    this.state.symbolic_impl_node = saved_impl;
                }
                return;
            }
        }
        const impl_this: TypeRef = this.ctx.decl_index.impl_owner(node, "sema/visit:ImplBlockNode");
        this.check_assoc_decl_bounds(node, impl_this);
        this.visit_methods(node.methods, impl_this);
    }

    /// Type-check all method bodies in a type or impl block.
    visit_methods(mut &this, methods: &MethodNode*[], owner_type: TypeRef) -> void {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const method: MethodNode* = methods[i];
            if (method == null || method.func == null || method.func.body == null) { continue; }
            if (method.func.is_generic()) {
                const sym_this: TypeRef = if (method.is_static) { TypeRef::invalid() } else { owner_type };
                // Same shape as the free-function case: the walk types the body,
                // and an `async` one's state machine is then built from what it
                // left there.  `begin_body_check` lends the declared Output back
                // for the walk and is a no-op for anything not a pending `async`
                // method.
                const displaced: TypeRef = this.async_lower.begin_body_check(method.func);
                this.symbolic_check_body(method.func, sym_this, owner_type);
                this.async_lower.end_body_check(method.func, displaced);
                if (method.func.is_async) {
                    this.async_lower.lower(method.func);
                }
                continue;
            }
            // A self-returning trait default (`take -> TakeIter<This>`) is
            // instantiated lazily, per call site, so its body is typed the way
            // a generic body is: symbolically, demanding no instantiation.
            // An eager walk would demand the adapter over this owner, whose
            // own impl carries the same default, without end.  The walk still
            // has to happen: what it leaves on the body - the callee stashes
            // above all - is what the lazy specialization's clone carries.
            if (method.func.is_self_returning_default) {
                const lazy_this: TypeRef = if (method.is_static) { TypeRef::invalid() } else { owner_type };
                this.symbolic_check_body(method.func, lazy_this, owner_type);
                continue;
            }
            const method_this: TypeRef = if (method.is_static) { TypeRef::invalid() } else { owner_type };
            const saved_owner: TypeRef = this.state.current_owner_type;
            this.state.current_owner_type = owner_type;
            // An `async` method's node already carries its FUTURE type, so
            // callers typed before it resolve correctly; its own body is still
            // checked against the declared Output.
            const displaced: TypeRef = this.async_lower.begin_body_check(method.func);
            this.enter_function(method.func, method_this);
            if (method.is_constructor && method.has_base_ctor()) {
                for (mut k: i64 = 0; k < method.base_ctor_args.length; k++) {
                    this.resolve_expr(method.base_ctor_args[k]);
                }
            }
            this.visit(method.func.body);
            this.state.body_count += 1;
            if (!method.is_constructor && !method.is_destructor) {
                this.check_function_returns(method.func);
            }
            this.async_lower.end_body_check(method.func, displaced);
            // Lower AFTER the body is typed against the declared Output type,
            // exactly as `visit(FunctionDeclNode*)` does for a free function.
            if (method.func.is_async) { this.async_lower.lower(method.func); }
            this.state.current_owner_type = saved_owner;
        }
    }

    /// Enforce a trait's declaration-site associated-type bounds against this
    /// concrete impl's binding (E0306).
    check_assoc_decl_bounds(mut &this, node: ImplBlockNode*, impl_this: TypeRef) -> void {
        if (node == null || !node.is_trait_impl()) { return; }
        if (this.ctx.generic_registry == null || this.ctx.type_resolver == null) { return; }
        if (!impl_this.is_valid()) { return; }
        const trait_leaf: DefId = TypeAnnotation::trait_def(node.trait_annotation);
        if (!trait_leaf.is_valid()) { return; }
        const tdecl: TraitDeclNode* = this.ctx.generic_registry.get_trait_decl(trait_leaf);
        if (tdecl == null) { return; }
        const span: SourceSpan = if (node.target_type_span.has_location()) { node.target_type_span } else { node.span };
        const trait_str: string = this.intern.resolve(this.ctx.defs.path_of(trait_leaf));
        for (mut i: i64 = 0; i < tdecl.assoc_types.length; i++) {
            const adecl: AssocTypeDeclNode* = tdecl.assoc_types[i];
            if (adecl == null || adecl.bounds.length == 0) { continue; }
            mut rc: ResolutionContext = ResolutionContext::new("");
            const item_ty: TypeRef = this.ctx.type_resolver.resolve_concrete_member(impl_this, adecl.name, tdecl, &rc);
            if (!item_ty.is_valid()) { continue; }
            if (this.arena.contains_generic_param(item_ty)) { continue; }
            const item_name: string = this.intern.resolve(adecl.name);
            const item_t: Type* = this.arena.lookup(item_ty.id);
            const item_disp: string = if (item_t != null) { this.arena.format_display(item_t) } else { "?" };
            for (mut b: i64 = 0; b < adecl.bounds.length; b++) {
                const tref: TraitRef* = &adecl.bounds[b];
                if (tref.path.length == 0) { continue; }
                const bound_trait: SymbolStr = tref.path[tref.path.length - 1];
                if (this.trait_checker().type_implements_trait(item_ty, tref.definition(), 0)) { continue; }
                const bound_str: string = this.intern.resolve(bound_trait);
                this.ctx.emit_error_at(
                    ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
                    fmt::format("associated type `%s` of trait `%s` is bound to `%s`, which does not satisfy the declared bound `%s: %s`",
                        item_name, trait_str, item_disp, item_name, bound_str),
                    span);
            }
        }
    }


    // -- Symbolic generic-body walk drivers (drive visit(body); stay here) --

    /// Type-check one generic body against abstract parameter refs.
    ///
    /// This is the ONLY pass that types a generic template body, and what it
    /// leaves on that body is load-bearing twice over: it reports, ahead of any
    /// instantiation, errors the body would produce, AND it is the resolution
    /// monomorphization and codegen consume downstream — a where-bound call in a
    /// template (`value.hash(&h)` in `digest<T>`) reaches codegen with no
    /// resolved callee if the body was never walked, and lowering a generic
    /// `async function` builds its state machine out of these very types. So the
    /// walk is unconditional; it is not a diagnostic add-on to be switched off.
    symbolic_check_body(mut &this, func: FunctionDeclNode*, this_type: TypeRef,
                        owner_type: TypeRef) -> void {
        if (func == null || func.body == null) { return; }
        const sink: DiagnosticSink* = this.ctx.diagnostics;
        if (sink == null) { return; }
        const snap: DiagnosticSnapshot = sink.snapshot();
        const saved_owner:    TypeRef = this.state.current_owner_type;
        const saved_symbolic: boolean = this.state.in_symbolic_check;
        const saved_cur_func: FunctionDeclNode* = this.state.symbolic_current_func;
        this.state.symbolic_current_func = func;
        mut saved_method_nodes: GenericParamNode*[] = [];
        swap(&this.state.symbolic_method_param_nodes, &saved_method_nodes);
        this.state.current_owner_type = owner_type;
        this.state.in_symbolic_check  = true;
        const ar: TypeArena* = this.arena;
        const saved_no_demand: boolean = if (ar != null) { ar.symbolic_no_demand_active } else { false };
        if (ar != null) { ar.set_symbolic_no_demand(true); }
        mut method_nodes: GenericParamNode*[] = [];
        for (mut gp: i64 = 0; gp < func.generic_params.length; gp++) {
            const pnode: GenericParamNode* = func.generic_params[gp];
            if (pnode != null) { method_nodes.push(pnode); }
        }
        this.state.symbolic_method_param_nodes = method_nodes;

        mut eff_this: TypeRef = this_type;
        if (this_type.is_valid() && owner_type.is_valid() && this_type.id == owner_type.id) {
            eff_this = this.symbolic.symbolic_owner_instance(owner_type);
        }
        this.enter_function(func, eff_this);
        this.visit(func.body);

        if (ar != null) { ar.set_symbolic_no_demand(saved_no_demand); }
        swap(&this.state.symbolic_method_param_nodes, &saved_method_nodes);
        this.state.in_symbolic_check  = saved_symbolic;
        this.state.current_owner_type = saved_owner;
        this.state.symbolic_current_func = saved_cur_func;
        this.state.symbolic_bodies_walked += 1;
        this.state.symbolic_total_would_emit += sink.errors_since(snap) as i64;
    }

    /// Walk every method body of a GENERIC owner symbolically.  A method on a
    /// generic owner reaches sema only here, so this is also where an `async` one
    /// is lowered, off the types the walk leaves on its body.
    symbolic_check_owner_methods(mut &this, methods: &MethodNode*[], owner_type: TypeRef,
                                 owner_params: &GenericParamNode*[]) -> void {
        const saved_owner_generic: boolean = this.state.symbolic_owner_is_generic;
        mut saved_owner_nodes: GenericParamNode*[] = [];
        swap(&this.state.symbolic_owner_param_nodes, &saved_owner_nodes);
        mut onodes: GenericParamNode*[] = [];
        for (mut i: i64 = 0; i < owner_params.length; i++) {
            const p: GenericParamNode* = owner_params[i];
            if (p != null) { onodes.push(p); }
        }
        this.state.symbolic_owner_param_nodes = onodes;
        this.state.symbolic_owner_is_generic  = true;
        for (mut i: i64 = 0; i < methods.length; i++) {
            const method: MethodNode* = methods[i];
            if (method == null || method.func == null || method.func.body == null) { continue; }
            const sym_this: TypeRef = if (method.is_static) { TypeRef::invalid() } else { owner_type };
            // A method on a GENERIC owner reaches sema only here, whether or not
            // it has generic parameters of its own — so this is where an `async`
            // one is lowered, off the types the walk just left on its body.
            const displaced: TypeRef = this.async_lower.begin_body_check(method.func);
            this.symbolic_check_body(method.func, sym_this, owner_type);
            this.async_lower.end_body_check(method.func, displaced);
            if (method.func.is_async) {
                this.async_lower.lower(method.func);
            }
        }
        swap(&this.state.symbolic_owner_param_nodes, &saved_owner_nodes);
        this.state.symbolic_owner_is_generic  = saved_owner_generic;
    }


    // -- Per-function frame setup --

    /// A resolution context for annotations written in the body being checked:
    /// the annotations carry their own stamps, so it starts with no bindings
    /// and no `This`, and the caller adds what the body is checked under.
    body_res_ctx(&this) -> ResolutionContext {
        return ResolutionContext::new("");
    }

    enter_function(mut &this, func: FunctionDeclNode*, fn_this_type: TypeRef) -> void {
        this.state.locals         = HashMap::<u32, TypeRef>::new();
        this.state.local_muts     = HashMap::<u32, boolean>::new();
        this.state.local_kw_spans = HashMap::<u32, SourceSpan>::new();
        this.state.undo_keys      = [];
        this.state.undo_prev      = [];
        this.state.undo_muts      = [];
        this.state.undo_kw_spans  = [];
        this.state.return_type     = func.resolved_return_type;
        this.state.return_type_ann = func.return_type_annotation;
        // Provenance for the body's annotations, from the declaration's own
        // span rather than from wherever the walk happens to be standing.
        this.state.async_poll_output = this.async_poll_output_of(func);
        this.state.this_type       = fn_this_type;
        this.state.this_is_mut = false;
        this.state.payload_binding_ids = [];
        this.state.alias_binding_ids = [];
        this.state.this_is_by_ref = false;
        this.state.receiver_sym = SymbolID::invalid();
        this.state.param_ids = [];
        this.state.in_lambda_depth     = 0;
        this.state.lambda_outer_locals = HashMap::<u32, TypeRef>::new();
        this.state.current_lambda      = null;

        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null) { continue; }
            // A parameter whose annotation failed to resolve was reported
            // where it was written; it is bound with NO type, so a use of it
            // is silent rather than a second report about `void`.
            mut ty: TypeRef = TypeRef::invalid();
            if (param.resolved_type.is_valid()) {
                ty = param.resolved_type;
            } else if (func.is_variadic && i == func.parameters.length - 1
                       && param.type_annotation == null) {
                ty = this.arena.get_pointer_to(this.arena.get_void());
            }
            if (param.is_receiver()) { this.state.receiver_sym = param.sym_id; }
            if (param.is_ref_receiver()) {
                this.state.this_is_mut = param.is_mutable;
                this.state.this_is_by_ref = true;
            } else {
                this.scopes.register_local_with_mut(param.name, ty, param.is_mutable);
                this.scopes.record_local_kw_span(param.name, param.kw_span);
                this.state.param_ids.push(param.name.id);
            }
        }
        if (fn_this_type.is_valid()) {
            this.scopes.register_local_with_mut(this.this_sym, fn_this_type, this.state.this_is_mut);
            this.state.param_ids.push(this.this_sym.id);
        }
    }


    // -- Statement visitors --

    override visit(mut &this, block: BlockStmtNode*) -> void {
        if (block == null) { return; }
        const save: i64 = this.scopes.save_scope();
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            this.dispatch_stmt(block.statements[i]);
        }
        this.scopes.restore_scope(save);
    }

    override visit(mut &this, node: ExprStmtNode*) -> void {
        this.resolve_expr(node.expression);
    }

    override visit(mut &this, node: ReturnStmtNode*) -> void {
        if (node.has_expression()) {
            const saved_expected: TypeRef = this.state.expected_type;
            if (this.state.return_type.is_valid()) {
                this.state.expected_type = this.state.return_type;
            }
            const expr_type: TypeRef = this.resolve_expr(node.expression);
            this.state.expected_type = saved_expected;
            if (expr_type.is_valid() && this.state.return_type.is_valid()
                    && !this.symbolic.type_has_unresolved_projection(this.state.return_type)
                    && !this.symbolic.type_has_unresolved_projection(expr_type)
                    && !this.symbolic.symbolic_defer_type(this.state.return_type)
                    && !this.symbolic.symbolic_defer_type(expr_type)) {
                if (!this.checker.can_assign(expr_type, this.state.return_type)) {
                    const value_span: SourceSpan = if (node.expression != null) { node.expression.span } else { node.span };
                    const ann_span: SourceSpan = annotation_span(this.state.return_type_ann);
                    this.diag.emit_type_mismatch_with_value(
                        ErrorCode::E0200_TYPE_MISMATCH, value_span, this.state.return_type, expr_type,
                        "the function's declared return type doesn't match the value returned here",
                        ann_span, node.expression);
                }
            }
            if (this.state.return_type.is_valid()) {
                this.check_return_payload_escape(node.expression, this.state.return_type);
            }
            this.check_return_stack_address(node.expression);
        }
    }

    override visit(mut &this, node: IfStmtNode*) -> void {
        this.resolve_expr(node.condition);
        this.dispatch_stmt(node.then_stmt);
        if (node.has_else()) { this.dispatch_stmt(node.else_stmt); }
    }

    override visit(mut &this, node: WhileStmtNode*) -> void {
        this.resolve_expr(node.condition);
        this.state.loop_depth += 1;
        this.dispatch_stmt(node.body);
        this.state.loop_depth -= 1;
    }

    override visit(mut &this, node: DoWhileStmtNode*) -> void {
        this.state.loop_depth += 1;
        this.dispatch_stmt(node.body);
        this.state.loop_depth -= 1;
        this.resolve_expr(node.condition);
    }

    override visit(mut &this, node: ForStmtNode*) -> void {
        const save: i64 = this.scopes.save_scope();
        if (node.init != null) {
            if (node.init.kind == NodeKind::DeclarationStatement) {
                this.visit(node.init as DeclStmtNode*);
            } else if (node.init.kind == NodeKind::VariableDeclaration) {
                const var_node: VarDeclNode* = node.init as VarDeclNode*;
                if (var_node.type_annotation == null) {
                    const init_e: ExpressionNode* = var_node.initializer;
                    const init_is_lambda: boolean = init_e != null
                        && (init_e as ASTNode*).kind == NodeKind::LambdaExpression;
                    if (!init_is_lambda) {
                        const var_name: string = this.intern.resolve(var_node.name);
                        mut diag: Diagnostic = Diagnostic::error(
                            ErrorCode::E0104_EXPECTED_TYPE,
                            fmt::format("for-loop initializer `%s` needs a type annotation; type inference is only available for lambda initializers", var_name));
                        diag = diag.at_with_label(var_node.span, "missing `:` and type annotation");
                        this.ctx.emit_diagnostic(diag);
                    }
                }
                if (var_node.has_initializer()) { this.resolve_expr(var_node.initializer); }
                if (var_node.resolved_type.is_valid()) {
                    this.scopes.register_local_with_mut(var_node.name, var_node.resolved_type, var_node.is_mutable);
                } else if (var_node.has_initializer() && var_node.initializer.resolved_type.is_valid()) {
                    this.scopes.register_local_with_mut(var_node.name, var_node.initializer.resolved_type, var_node.is_mutable);
                } else {
                    this.scopes.register_local_with_mut(var_node.name, this.arena.get_i32(), var_node.is_mutable);
                }
            } else if (node.init.kind == NodeKind::ExpressionStatement) {
                this.resolve_expr((node.init as ExprStmtNode*).expression);
            }
        }
        if (node.condition != null) { this.resolve_expr(node.condition); }
        if (node.update != null)    { this.resolve_expr(node.update); }
        this.state.loop_depth += 1;
        this.dispatch_stmt(node.body);
        this.state.loop_depth -= 1;
        this.scopes.restore_scope(save);
    }

    override visit(mut &this, node: LoopStmtNode*) -> void {
        this.state.loop_depth += 1;
        this.dispatch_stmt(node.body);
        this.state.loop_depth -= 1;
    }

    override visit(mut &this, node: BreakStmtNode*) -> void {
        if (this.state.loop_depth == 0) {
            this.ctx.emit_error_at(ErrorCode::E0400_INVALID_BREAK,
                "`break` outside of a loop", node.span);
        }
    }

    override visit(mut &this, node: ContinueStmtNode*) -> void {
        if (this.state.loop_depth == 0) {
            this.ctx.emit_error_at(ErrorCode::E0401_INVALID_CONTINUE,
                "`continue` outside of a loop", node.span);
        }
    }

    override visit(mut &this, node: UnsafeBlockStmtNode*) -> void {
        this.visit(node.block);
    }

    override visit(mut &this, node: AsmBlockStmtNode*) -> void {
        // A mandatory `![arch(<arch>, <dialect>)]` directive supplies the
        // arch (gating) and dialect; its absence is an error.
        if (node.arch == "") {
            this.ctx.emit_error_at(ErrorCode::E0111_INVALID_SYNTAX,
                "`asm` block requires an `![arch(<arch>, <dialect>)]` directive above it",
                node.span);
        }
        // Module-level (naked / global) asm is operand-free.
        if (node.is_module_level) {
            if (node.operands.length > 0) {
                this.ctx.emit_error_at(ErrorCode::E0111_INVALID_SYNTAX,
                    "module-level `asm` block cannot bind `{...}` operands (naked/global asm only)",
                    node.span);
            }
            return;
        }
        // Type-check each operand expression so codegen sees resolved types.
        for (mut i: i64 = 0; i < node.operands.length; i++) {
            const op: AsmOperand* = node.operands[i];
            if (op == null || op.expr == null) { continue; }
            this.resolve_expr(op.expr);
        }
    }

    override visit(mut &this, node: MatchStmtNode*) -> void {
        const subject_type: TypeRef = this.resolve_expr(node.subject);
        const caller_backed: boolean = this.subject_is_caller_backed(node.subject);
        for (mut i: i64 = 0; i < node.arms.length; i++) {
            const arm: MatchArmNode* = node.arms[i];
            if (arm == null) { continue; }
            const save: i64 = this.scopes.save_scope();
            this.patterns.bind_arm_patterns(arm, subject_type, caller_backed);
            if (arm.guard != null) { this.resolve_expr(arm.guard); }
            if (arm.body != null) { this.dispatch_stmt(arm.body); }
            this.scopes.restore_scope(save);
        }
        this.patterns.check_match_exhaustive(node.subject, subject_type, node.arms, node.span);
        this.patterns.check_duplicate_default_arm(node.arms);
        this.patterns.check_range_patterns(node.arms, subject_type);
    }

    override visit(mut &this, node: StaticMatchStmtNode*) -> void {
        if (node == null || node.arms.length == 0) { return; }
        if (node.arms.length > 1 && !this.state.in_symbolic_check) {
            this.ctx.emit_error_at(ErrorCode::E0645_NO_STATIC_MATCH_ARM,
                "`static match` outside a generic context is not supported yet (its type could not be resolved to a single arm)",
                node.span);
        }
        // First arm: the representative diagnostic walk, narrowed to its concrete
        // type when the scrutinee is a generic param (symbolic-only, eligible).
        const arm0: StaticMatchArmNode* = node.arms[0];
        if (arm0 != null && arm0.body != null) {
            const s0: i64 = this.narrow_static_match_arm(node.scrutinee, arm0);
            this.dispatch_stmt(arm0.body);
            this.scopes.restore_scope(s0);
        }
        // Remaining arms (symbolic only): stamp their bodies - narrowed to each
        // arm's concrete type - for correct monomorphization and hover, with
        // diagnostics suppressed so arms this instantiation may never select
        // don't report concrete-check errors.
        if (this.state.in_symbolic_check && node.arms.length > 1) {
            const sink: DiagnosticSink* = this.ctx.diagnostics;
            for (mut ai: i64 = 1; ai < node.arms.length; ai++) {
                const arm: StaticMatchArmNode* = node.arms[ai];
                if (arm == null || arm.body == null) { continue; }
                const sv: i64 = this.narrow_static_match_arm(node.scrutinee, arm);
                if (sink != null) { sink.begin_suppress(); }
                this.dispatch_stmt(arm.body);
                if (sink != null) { sink.end_suppress(); }
                this.scopes.restore_scope(sv);
            }
        }
    }

    override visit(mut &this, node: DeclStmtNode*) -> void {
        if (node.declaration == null) { return; }
        const decl: ASTNode* = node.declaration;
        if (decl.kind == NodeKind::DestructureDeclaration) {
            this.visit(decl as DestructureDeclNode*);
            return;
        }
        if (decl.kind != NodeKind::VariableDeclaration) { return; }
        const var_node: VarDeclNode* = decl as VarDeclNode*;
        this.check_var_decl(var_node);
        this.register_var_decl_local(var_node);
    }

    /// A declaration written at MODULE scope.  It reaches sema as a bare
    /// `VarDeclNode` in the program's statement list, not wrapped in the
    /// `DeclStmtNode` a body uses, so without this override `accept` found
    /// nothing and a global's initializer was never resolved: no type for
    /// codegen's constant folder to work from (the global then landed on the
    /// zero fallback), and no diagnostic for anything wrong inside it - naming
    /// an enum variant that does not exist compiled clean.
    ///
    /// Guarded on `is_global` so this cannot become a second answering path for
    /// a local; the statement form and the for-loop form own those.
    override visit(mut &this, node: VarDeclNode*) -> void {
        if (node == null || !node.is_global) { return; }
        this.check_var_decl(node);
    }

    /// Resolve and type-check one variable declaration: its annotation, its
    /// initializer (resolved under that annotation as the expected type), the
    /// type inferred from the initializer when there is no annotation, and the
    /// E0200 agreement between the two.  Shared by the statement form and the
    /// module-level form - they reach sema through different visitors and must
    /// not answer this differently.
    check_var_decl(mut &this, var_node: VarDeclNode*) -> void {

        // A type-less binding with no initializer has nothing to infer from.
        // With an initializer, the binding's type is inferred from it below
        // (general local type inference; see the `resolved_type = init_type`
        // step). A void-valued initializer is rejected there, after we know
        // the initializer's type.
        if (var_node.type_annotation == null && !var_node.has_resolved_type()
                && !var_node.is_auto && !var_node.has_initializer()) {
            const var_name: string = this.intern.resolve(var_node.name);
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0104_EXPECTED_TYPE,
                fmt::format("variable `%s` needs a type annotation or an initializer to infer from: write `: T` or `= <expr>`", var_name));
            diag = diag.at_with_label(var_node.span, "no `:` type and no `=` initializer to infer from");
            this.ctx.emit_diagnostic(diag);
        }

        if (!var_node.has_resolved_type() && var_node.type_annotation != null && this.ctx.type_resolver != null) {
            this.prime_typeof_annotation(var_node.type_annotation);
            mut res_ctx: ResolutionContext = this.body_res_ctx();
            this.symbolic.symbolic_bind_params(&res_ctx);
            const vtype: TypeRef = this.ctx.type_resolver.resolve(var_node.type_annotation, &res_ctx);
            if (vtype.is_valid()) { var_node.resolved_type = vtype; }
            else { this.refuse_unresolved_body_annotation(var_node.type_annotation); }
        }

        if (var_node.has_initializer()) {
            const saved_expected: TypeRef = this.state.expected_type;
            if (var_node.has_resolved_type()) { this.state.expected_type = var_node.resolved_type; }
            mut init_type: TypeRef = this.resolve_expr(var_node.initializer);
            this.state.expected_type = saved_expected;

            if (var_node.is_auto && init_type.is_valid() && var_node.initializer != null) {
                const arr_t: Type* = this.arena.lookup(init_type.id);
                if (arr_t != null && arr_t.kind == TypeKind::Array) {
                    const at: ArrayType* = arr_t as ArrayType*;
                    if (at.is_fixed()) {
                        const orig_init: ExpressionNode* = var_node.initializer;
                        const sp: SourceSpan = orig_init.span;
                        const zero_lit: LiteralNode* = new LiteralNode("0", LiteralKind::Integer, sp);
                        const idx: ArrayAccessNode* = new ArrayAccessNode(orig_init, zero_lit as ExpressionNode*, sp);
                        const amp_tok: Token = Token::new(TokenType::Amp, "&", sp.start_line as int, sp.start_col as int);
                        mut amp: UnaryExprNode* = new UnaryExprNode(amp_tok, idx as ExpressionNode*, sp);
                        amp.is_synthetic = true;
                        const n_str: string = fmt::format("%ld", at.size);
                        const n_lit: LiteralNode* = new LiteralNode(n_str, LiteralKind::Integer, sp);
                        const slice_sym: SymbolStr = this.intern.intern("Slice");
                        const from_raw_sym: SymbolStr = this.intern.intern("from_raw");
                        mut sr: ScopeResolutionNode* = new ScopeResolutionNode(slice_sym, from_raw_sym, sp);
                        // The reference is to the stdlib `Slice`, which the
                        // prelude carries so this lowering can name it - the
                        // one declaration it means, whatever the writing
                        // module's own scope holds under that leaf.  A
                        // synthesizer owes its node the definition it refers
                        // to, and this one knows it without a lookup.
                        sr.set_synthesized_res(
                            this.ctx.generic_registry.wellknown(LangItem::Slice));
                        mut elt_named: NamedAnnotation* = new NamedAnnotation {
                            name: SymbolStr::empty(), span: sp, pre_resolved: at.element,
                            res: ResSlot::Pending,
                        };
                        const elt_ann: TypeAnnotation* = new TypeAnnotation::Named(elt_named);
                        mut gen_args: TypeAnnotation*[] = [];
                        gen_args.push(elt_ann);
                        sr.set_scope_generic_args(gen_args);
                        mut call: CallExprNode* = new CallExprNode(sr as ExpressionNode*, sp);
                        call.add_argument(amp as ExpressionNode*);
                        call.add_argument(n_lit as ExpressionNode*);
                        var_node.set_initializer(call as ExpressionNode*);
                        init_type = this.resolve_expr(var_node.initializer);
                    }
                }
                // The loop calls `Iterator::next` on this binding, so the
                // scrutinee is an iterator when its type implements the
                // language's `Iterator` - never because it has a method
                // spelled `next`.  A collection that is not one is iterated
                // through its `iter()`.
                const iterator_id: DefId = this.ctx.generic_registry.wellknown(LangItem::Iterator);
                if (!this.for_scrutinee_iterates(init_type, iterator_id)) {
                    const owner_ref: TypeRef = this.types.method_owner_ref(this.for_scrutinee_subject(init_type));
                    if (owner_ref.is_valid()) {
                        const iter_ret: TypeRef = this.types.lookup_method_return(owner_ref, this.intern.intern("iter"));
                        if (iter_ret.is_valid()) {
                            const orig_init: ExpressionNode* = var_node.initializer;
                            const wrap_span: SourceSpan = orig_init.span;
                            mut iter_member: MemberAccessNode* = new MemberAccessNode(orig_init, this.intern.intern("iter"), wrap_span, wrap_span);
                            mut iter_call: CallExprNode* = new CallExprNode(iter_member as ExpressionNode*, wrap_span);
                            var_node.set_initializer(iter_call as ExpressionNode*);
                            init_type = this.resolve_expr(var_node.initializer);
                        }
                    }
                    // Refused once, here, at the scrutinee: the binding keeps
                    // no type, so the `next` call the loop makes on it reports
                    // nothing further.  An `iter()` that failed has already
                    // said why.
                    if (init_type.is_valid() && !this.for_scrutinee_iterates(init_type, iterator_id)) {
                        if (!this.state.in_symbolic_check) {
                            const shown: string = this.arena.resolve_display_name_short(
                                this.for_scrutinee_subject(init_type).id);
                            mut d: Diagnostic = Diagnostic::error(ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
                                fmt::format("`%s` does not implement `Iterator`", shown));
                            d = d.at_with_label(var_node.initializer.span,
                                fmt::format("no `implement trait Iterator for %s` selects an implementation here", shown));
                            this.ctx.emit_diagnostic(d);
                        }
                        init_type = TypeRef::invalid();
                    }
                }
            }

            const imp_ann: ImplTraitAnnotation* = this.impl_trait_annotation_of(var_node.type_annotation);
            const init_t_node: Type* = this.arena.lookup(init_type.id);
            const init_is_void: boolean = init_t_node != null && init_t_node.kind == TypeKind::Void;
            // General local type inference: a binding with no annotation adopts
            // the initializer's type. When an annotation is present resolved_type
            // is already set above (and wins); the lambda / for-loop `is_auto` /
            // impl-trait cases are subsumed here. The inferred type is the
            // concrete type the initializer produces - not an erased
            // `implement Trait` - so methods on it stay callable.  A binding
            // whose annotation was REFUSED keeps no type at all: the type it
            // was declared with is not the initializer's, and a use of it
            // reported against the initializer's type (`no field on i32`)
            // blames a type the program never wrote.
            if (!var_node.has_resolved_type() && init_type.is_valid() && !init_is_void
                    && var_node.initializer != null
                    && !TypeAnnotation::refused(var_node.type_annotation)) {
                var_node.resolved_type = init_type;
            }
            // A type-less binding whose initializer yields no value can't be
            // inferred: surface that rather than silently binding `void`.
            if (var_node.type_annotation == null && !var_node.has_resolved_type()
                    && !var_node.is_auto && init_is_void) {
                const var_name: string = this.intern.resolve(var_node.name);
                mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0104_EXPECTED_TYPE,
                    fmt::format("cannot infer the type of `%s`: its initializer produces no value (`void`); add a `: T` annotation or use a value-producing initializer", var_name));
                diag = diag.at_with_label(var_node.span, "binding has no inferable type");
                this.ctx.emit_diagnostic(diag);
            }
            if (imp_ann != null && init_type.is_valid()) {
                this.verify_impl_trait_bounds(imp_ann, init_type, var_node);
            }
            if (var_node.has_resolved_type() && init_type.is_valid() && imp_ann == null
                    && !this.symbolic.symbolic_defer_type(init_type)
                    && !this.symbolic.symbolic_defer_type(var_node.resolved_type)) {
                if (!this.checker.can_assign(init_type, var_node.resolved_type)) {
                    const conv: ExpressionNode* = this.calls.build_implicit_conversion(
                        this, var_node.initializer, init_type, var_node.resolved_type);
                    if (conv != null) {
                        var_node.set_initializer(conv);
                        init_type = var_node.resolved_type;
                    } else {
                        const var_name: string = this.intern.resolve(var_node.name);
                        const value_span: SourceSpan = if (var_node.initializer != null) { var_node.initializer.span } else { var_node.span };
                        const ann_span: SourceSpan = annotation_span(var_node.type_annotation);
                        this.diag.emit_type_mismatch_with_value(
                            ErrorCode::E0200_TYPE_MISMATCH, value_span, var_node.resolved_type, init_type,
                            fmt::format("`%s` was declared with this type; the initializer must match", var_name),
                            ann_span, var_node.initializer);
                    }
                }
            }
        }

    }

    /// Bind the declaration's name in the current scope.  Only the statement
    /// form does this: a module-level declaration is already registered as a
    /// global by an earlier pass, and binding it here would shadow that global
    /// with a local for the rest of the module.
    register_var_decl_local(mut &this, var_node: VarDeclNode*) -> void {
        if (var_node.resolved_type.is_valid()) {
            this.scopes.register_local_with_mut(var_node.name, var_node.resolved_type, var_node.is_mutable);
        } else if (var_node.type_annotation != null && TypeAnnotation::refused(var_node.type_annotation)) {
            // The declaration named a type the name layer refused, reported
            // where it was written; bound with NO type, as a parameter is,
            // so a use of it is silent rather than a second report against
            // the initializer's type or `void`.
            this.scopes.register_local_with_mut(var_node.name, TypeRef::invalid(), var_node.is_mutable);
        } else if (var_node.is_auto) {
            // A `for` loop's iterator binding left untyped: its scrutinee was
            // refused, or failed, where it was written.  Bound with no type,
            // so the `next` call the loop makes on it is silent rather than
            // a second report against the scrutinee's type or `void`.
            this.scopes.register_local_with_mut(var_node.name, TypeRef::invalid(), var_node.is_mutable);
        } else if (var_node.has_initializer()) {
            const init_type: TypeRef = var_node.initializer.resolved_type;
            if (init_type.is_valid()) {
                this.scopes.register_local_with_mut(var_node.name, init_type, var_node.is_mutable);
            } else {
                this.scopes.register_local_with_mut(var_node.name, this.arena.get_void(), var_node.is_mutable);
            }
        } else {
            this.scopes.register_local(var_node.name, this.arena.get_void());
        }
        this.scopes.record_local_kw_span(var_node.name, var_node.kw_span);
    }

    override visit(mut &this, node: DestructureDeclNode*) -> void {
        if (!node.has_resolved_type() && node.type_annotation != null && this.ctx.type_resolver != null) {
            mut res_ctx: ResolutionContext = this.body_res_ctx();
            this.symbolic.symbolic_bind_params(&res_ctx);
            const ttype: TypeRef = this.ctx.type_resolver.resolve(node.type_annotation, &res_ctx);
            if (ttype.is_valid()) { node.resolved_type = ttype; }
        }
        if (node.has_initializer()) {
            const saved_expected: TypeRef = this.state.expected_type;
            if (node.has_resolved_type()) { this.state.expected_type = node.resolved_type; }
            const init_type: TypeRef = this.resolve_expr(node.initializer);
            this.state.expected_type = saved_expected;
            if (node.has_resolved_type() && init_type.is_valid()) {
                if (!this.checker.can_assign(init_type, node.resolved_type)) {
                    const value_span: SourceSpan = if (node.initializer != null) { node.initializer.span } else { node.span };
                    const ann_span: SourceSpan = annotation_span(node.type_annotation);
                    this.diag.emit_type_mismatch_with_value(
                        ErrorCode::E0200_TYPE_MISMATCH, value_span, node.resolved_type, init_type,
                        "destructure pattern's declared type must match the initializer", ann_span, node.initializer);
                }
            }
        }
        if (this.symbolic.symbolic_defer_type(node.resolved_type)) { this.register_destructure_locals_void(node); return; }
        if (!node.has_resolved_type()) { this.register_destructure_locals_void(node); return; }
        const ty: Type* = this.arena.lookup(node.resolved_type.id);
        if (ty == null) { this.register_destructure_locals_void(node); return; }

        const empty_fields: FieldInfo[] = [];
        mut fields_ptr: &FieldInfo[] = &empty_fields;
        mut got_fields: boolean = false;
        if (ty.kind == TypeKind::Struct) { fields_ptr = &(ty as StructType*).fields; got_fields = true; }
        else if (ty.kind == TypeKind::Class) { fields_ptr = &(ty as ClassType*).fields; got_fields = true; }
        if (!got_fields) {
            const ty_name: string = this.intern.resolve(this.intern.intern(this.arena.format_display(ty)));
            this.ctx.emit_error_at(ErrorCode::E0361_DESTRUCTURE_NON_STRUCT,
                fmt::format("cannot destructure non-struct type '%s'", ty_name), node.span);
            this.register_destructure_locals_void(node);
            return;
        }

        for (mut i: i64 = 0; i < node.bindings.length; i++) {
            mut b: DestructureBinding = node.bindings[i];
            mut dup: boolean = false;
            for (mut j: i64 = 0; j < i; j++) {
                if (node.bindings[j].source_field.id == b.source_field.id) { dup = true; break; }
            }
            if (dup) {
                const dup_name: string = this.intern.resolve(b.source_field);
                mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0356_DUPLICATE_FIELD,
                    fmt::format("field `%s` bound more than once in destructure", dup_name));
                diag = diag.at_with_label(b.span, fmt::format("duplicate binding for `%s`", dup_name));
                const prev: DestructureBinding = node.bindings[i - 1];
                if (prev.span.has_location() && b.span.has_location()) {
                    const removal: SourceSpan = SourceSpan::new(b.span.file, prev.span.end_line, prev.span.end_col, b.span.end_line, b.span.end_col);
                    diag = diag.suggest(Suggestion::machine_applicable(removal, "", fmt::format("remove the duplicate binding `%s`", dup_name)));
                }
                this.ctx.emit_diagnostic(diag);
                this.scopes.register_local_with_mut(b.local_name, this.arena.get_void(), b.is_mutable);
                continue;
            }
            mut field_type: TypeRef = TypeRef::invalid();
            mut found: boolean = false;
            for (mut k: i64 = 0; k < fields_ptr.length; k++) {
                if (fields_ptr[k].name.id == b.source_field.id) { field_type = fields_ptr[k].field_type; found = true; break; }
            }
            if (!found) {
                const field_name: string = this.intern.resolve(b.source_field);
                const ty_name: string = this.intern.resolve(this.intern.intern(this.arena.format_display(ty)));
                mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0350_STRUCT_FIELD_NOT_FOUND,
                    fmt::format("no field `%s` on type `%s`", field_name, ty_name));
                diag = diag.at_with_label(b.span, "unknown field");
                mut cands: string[] = [];
                for (mut k: i64 = 0; k < fields_ptr.length; k++) { cands.push(this.intern.resolve(fields_ptr[k].name)); }
                diag = diag.did_you_mean(field_name, cands, "field", b.span);
                this.ctx.emit_diagnostic(diag);
                this.scopes.register_local_with_mut(b.local_name, this.arena.get_void(), b.is_mutable);
                continue;
            }
            b.resolved_type = field_type;
            node.bindings[i] = b;
            this.scopes.register_local_with_mut(b.local_name, field_type, b.is_mutable);
        }

        if (node.bindings.length < fields_ptr.length) {
            mut missing: string = "";
            mut count: i64 = 0;
            for (mut k: i64 = 0; k < fields_ptr.length; k++) {
                mut bound: boolean = false;
                for (mut bi: i64 = 0; bi < node.bindings.length; bi++) {
                    if (node.bindings[bi].source_field.id == fields_ptr[k].name.id) { bound = true; break; }
                }
                if (!bound) {
                    if (count > 0) { missing = fmt::format("%s, %s", missing, this.intern.resolve(fields_ptr[k].name)); }
                    else { missing = this.intern.resolve(fields_ptr[k].name); }
                    count++;
                }
            }
            const ty_name: string = this.intern.resolve(this.intern.intern(this.arena.format_display(ty)));
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0362_DESTRUCTURE_INCOMPLETE,
                fmt::format("destructure of `%s` must bind all %lld field(s); missing: %s", ty_name, fields_ptr.length, missing));
            diag = diag.at_with_label(node.span, fmt::format("missing %lld field%s", count, if (count == 1) { "" } else { "s" }));
            this.ctx.emit_diagnostic(diag);
        }
    }

    register_destructure_locals_void(mut &this, node: DestructureDeclNode*) -> void {
        for (mut i: i64 = 0; i < node.bindings.length; i++) {
            const b: DestructureBinding = node.bindings[i];
            this.scopes.register_local_with_mut(b.local_name, this.arena.get_void(), b.is_mutable);
        }
    }


    // -- Expression visit() overrides (thin recursion-seam delegates) --

    override visit(mut &this, node: LiteralNode*) -> void          { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: IdentifierNode*) -> void       { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: BinaryExprNode*) -> void       { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: UnaryExprNode*) -> void        { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: TernaryExprNode*) -> void      { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: IfExprNode*) -> void           { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: MatchExprNode*) -> void        { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: StaticMatchExprNode*) -> void  { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: CallExprNode*) -> void         { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: NewExprNode*) -> void          { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: SizeofExprNode*) -> void       { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: AlignofExprNode*) -> void      { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: CastExprNode*) -> void         { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: StructLiteralNode*) -> void    { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: ArrayLiteralNode*) -> void     { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: TupleLiteralNode*) -> void     { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: LambdaExprNode*) -> void       { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: ArrayAccessNode*) -> void      { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: MemberAccessNode*) -> void     { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: ScopeResolutionNode*) -> void  { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: TypeofExprNode*) -> void       { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: DeleteExprNode*) -> void       { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: AwaitExprNode*) -> void        { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: YieldExprNode*) -> void        { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }
    override visit(mut &this, node: TryExprNode*) -> void          { this.state.last_expr_type = this.resolve_expr(node as ExpressionNode*); }


    // -- The authoritative expression dispatch --

    resolve_expr(mut &this, expr: ExpressionNode*) -> TypeRef {
        if (expr == null) { return TypeRef::invalid(); }
        if (expr.has_resolved_type() && !this.state.post_mono_verify) {
            return expr.resolved_type;
        }
        const n: ASTNode* = expr as ASTNode*;
        const result: TypeRef = match (n.kind) {
            NodeKind::Literal           => { this.literals.resolve_literal(expr as LiteralNode*) }
            NodeKind::Identifier        => { this.resolve_identifier(expr as IdentifierNode*) }
            NodeKind::BinaryExpression  => { this.resolve_binary(expr as BinaryExprNode*) }
            NodeKind::UnaryExpression   => { this.resolve_unary(expr as UnaryExprNode*) }
            NodeKind::CallExpression    => { this.calls.resolve_call(this, expr as CallExprNode*) }
            NodeKind::MemberAccess      => { this.member.resolve_member_access(this, expr as MemberAccessNode*) }
            NodeKind::ArrayAccess       => { this.member.resolve_array_access(this, expr as ArrayAccessNode*) }
            NodeKind::CastExpression    => { this.resolve_cast(expr as CastExprNode*) }
            NodeKind::IfExpression      => { this.resolve_if_expr(expr as IfExprNode*) }
            NodeKind::TernaryExpression => { this.resolve_ternary(expr as TernaryExprNode*) }
            NodeKind::MatchExpression   => { this.resolve_match_expr(expr as MatchExprNode*) }
            NodeKind::StaticMatchExpression => { this.resolve_static_match_expr(expr as StaticMatchExprNode*) }
            NodeKind::StructLiteral     => { this.resolve_struct_literal(expr as StructLiteralNode*) }
            NodeKind::ScopeResolution   => { this.resolve_scope_resolution(expr as ScopeResolutionNode*) }
            NodeKind::NewExpression     => { this.resolve_new_expr(expr as NewExprNode*) }
            NodeKind::ArrayLiteral      => { this.resolve_array_literal(expr as ArrayLiteralNode*) }
            NodeKind::TupleLiteral      => { this.resolve_tuple_literal(expr as TupleLiteralNode*) }
            NodeKind::SizeofExpression  => {
                const s: SizeofExprNode* = expr as SizeofExprNode*;
                if (!s.operand_type.is_valid()) {
                    s.set_operand_type(this.resolve_layout_operand(s.type_ann));
                }
                this.arena.get_u64()
            }
            NodeKind::AlignofExpression => {
                const a: AlignofExprNode* = expr as AlignofExprNode*;
                if (!a.operand_type.is_valid()) {
                    a.set_operand_type(this.resolve_layout_operand(a.type_ann));
                }
                this.arena.get_u64()
            }
            NodeKind::TypeofExpression  => {
                const te: TypeofExprNode* = expr as TypeofExprNode*;
                this.resolve_expr(te.operand);
                this.ctx.emit_error_at(ErrorCode::E0209_INVALID_OPERATION,
                    "`typeof` may only be used in type position (e.g. `const y: typeof(x)`)", expr.span);
                TypeRef::invalid()
            }
            NodeKind::DeleteExpression  => {
                const de: DeleteExprNode* = expr as DeleteExprNode*;
                this.resolve_expr(de.operand);
                this.arena.get_void()
            }
            NodeKind::TryExpression     => { this.resolve_try_expr(expr as TryExprNode*) }
            NodeKind::LambdaExpression  => { this.lambda.resolve_lambda(this, expr as LambdaExprNode*) }
            NodeKind::AwaitExpression   => { this.resolve_await(expr as AwaitExprNode*) }
            _ => { TypeRef::invalid() }
        };
        if (result.is_valid()) { expr.set_resolved_type(result); }
        return result;
    }

    /// Type an `await e`: `e` must be a `Future`, and the await evaluates to
    /// that future's `Output` associated type. Projecting `F::Output` here (a)
    /// types the body before `AsyncLower` runs so `const v = await e;` binds `v`
    /// at the right type, and (b) leaves the projected type cached on the node
    /// so the lowering can read the awaited future type (`operand`) and its
    /// result type (this node) without re-projecting.
    resolve_await(mut &this, node: AwaitExprNode*) -> TypeRef {
        if (node == null || node.operand == null) { return TypeRef::invalid(); }
        const fut_ty: TypeRef = this.resolve_expr(node.operand);
        if (!fut_ty.is_valid()) { return TypeRef::invalid(); }
        if (this.ctx.type_resolver == null) { return TypeRef::invalid(); }
        const out_sym: SymbolStr = this.intern.intern("Output");
        mut rc: ResolutionContext = ResolutionContext::new("");
        // `Output` is the language's `Future`'s, whatever else the operand's
        // type implements.
        const future_decl: TraitDeclNode* = this.ctx.generic_registry.lang_trait_decl(LangItem::Future);
        const future_ty: TypeRef = if (future_decl != null) {
            this.ctx.decl_index.type_of_def(future_decl.def)
        } else {
            TypeRef::invalid()
        };
        const out_ty: TypeRef = this.ctx.type_resolver.resolve_concrete_member(fut_ty, out_sym, future_decl, &rc);
        if (out_ty.is_valid()) { return out_ty; }
        // An operand typed by an associated-type projection (`s.read(n)` typed
        // `S::ReadFut` inside a generic body) has no impl to read a binding from
        // yet. Its Output is the nested projection `(S::ReadFut)::Output` —
        // abstract, but precisely what monomorphization reduces once `S` is
        // bound, and the lowering needs a valid type to build the frame field
        // from. Restricted to the symbolic walk: a CONCRETE operand that fails
        // the lookup genuinely does not implement `Future` and must still be
        // diagnosed below.
        if (this.state.in_symbolic_check && this.arena.contains_generic_param(fut_ty)) {
            const sym_out: TypeRef = this.ctx.type_resolver.project_member(fut_ty, out_sym, future_ty, &rc);
            if (sym_out.is_valid()) { return sym_out; }
        }
        if (!out_ty.is_valid()) {
            const disp: string = this.arena.resolve_display_name(fut_ty.id);
            this.ctx.emit_error_at(ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
                fmt::format("`await` requires an expression whose type implements `Future`; `%s` does not", disp),
                node.span);
            return TypeRef::invalid();
        }
        return out_ty;
    }


    // -- Expression resolvers kept on the main visitor --

    /// Whether `id` is a use of the receiver of the method being checked: the
    /// binding it names is the receiver parameter's.  Every instance method
    /// has that parameter, written or synthesized, and the name layer binds
    /// it as `this`, so the identity answers where the spelling would also
    /// answer for a local or capture that happens to be spelled `this`.
    names_receiver(&this, id: IdentifierNode*) -> boolean {
        if (id == null || !this.state.receiver_sym.is_valid()) { return false; }
        return id.res.local_sym().id == this.state.receiver_sym.id;
    }

    resolve_identifier(mut &this, ident: IdentifierNode*) -> TypeRef {
        if (this.names_receiver(ident)) {
            if (this.state.this_type.is_valid()) { return this.state.this_type; }
            if (ident.resolved_type.is_valid()) { return ident.resolved_type; }
        }
        const local: TypeRef = this.scopes.lookup_local(ident.name);
        if (local.is_valid()) { return local; }
        // Bound, with no type: the declaration failed to type and said so.
        if (this.scopes.is_local_or_param(ident.name)) { return TypeRef::invalid(); }
        if (this.state.in_lambda_depth > 0 && this.state.current_lambda != null) {
            match (this.state.lambda_outer_locals.get(&ident.name.id)) {
                Option::Some(outer_ty) => { return this.lambda.record_lambda_capture(ident, outer_ty); }
                Option::None => { /* fall through */ }
            }
        }
        const global: TypeRef = this.types.spelling_global(ident.res);
        if (global.is_valid()) { return global; }
        const name_str: string = this.intern.resolve(ident.name);
        // A function named as a value.  The stamp is the writer's own answer
        // and a canonical name, so the index either holds it or the name is
        // not a function; the bare leaf would answer from whichever module
        // registered it last, and for a name no import offers - a private
        // declaration elsewhere - from a module the writer cannot see.
        mut func_ty: TypeRef = TypeRef::invalid();
        mut def_id: DefId = DefId::invalid();
        mut def_q: SymbolStr = SymbolStr::empty();
        match (ident.res) {
            ResSlot::Answered(r) => {
                // A source-location pseudo-constant is typed by its kind; the
                // value is codegen's, read off the reference's own span.
                match (r) {
                    Res::SourceLoc(k) => {
                        return match (k) {
                            SourceLoc::File => { this.arena.get_string() }
                            SourceLoc::Line => { this.arena.get_u32() }
                        };
                    }
                    _ => { }
                }
                func_ty = this.ctx.decl_index.func_type_of_res(r);
                def_id = r.def_id();
                // The pin below is keyed by the canonical name; the type and
                // the visibility gate are not.
                def_q = this.ctx.defs.path_of(def_id);
            }
            _ => { }
        }
        if (func_ty.is_valid()) {
            this.calls.enforce_value_ref_visibility(def_id, ident.span);
            // The pin, as the scope form's: the qualified name codegen's
            // registry is keyed by.  A TEMPLATE pins nothing - mono selects
            // the instantiation for a turbofished value and refuses to when a
            // pin is already there.
            if (!ident.resolved_callee.is_some() && !this.state.in_symbolic_check) {
                mut is_tmpl: boolean = false;
                if (this.ctx.generic_registry != null) {
                    const tm: TemplateEntry* = this.ctx.generic_registry.template_of(def_id);
                    if (tm != null && tm.node_kind == NodeKind::FunctionDeclaration) { is_tmpl = true; }
                }
                if (!is_tmpl) { ident.set_resolved_callee(CalleePin::Family(def_q)); }
            }
            return func_ty;
        }
        // Not a local, not a global, not a function.  A name no rib bound
        // was refused where it was written and arrives `Err`; one that
        // binds to something that is not a value - a type, a module - is
        // refused here, where what the binding is has been asked.  A slot
        // nothing answered is a bug, not a name to report.
        match (ident.res.require("sema/resolve_identifier")) {
            Res::Err => { return TypeRef::invalid(); }
            _        => { }
        }
        // Bound to a function whose signature was refused where it was
        // written: it registered no type to take a value by, and it exists.
        if (this.ctx.defs.signature_refused(def_id)) { return TypeRef::invalid(); }
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0201_UNDEFINED_VARIABLE,
            fmt::format("cannot find value `%s` in this scope", name_str));
        diag = diag.at_with_label(ident.span, "not found in this scope");
        this.ctx.emit_diagnostic(diag);
        return TypeRef::invalid();
    }

    // -- Operator overloading (arithmetic / equality / relational / negation) --
    //
    // Type-directed: the raw `check_binary_op` / `check_unary_op` rules run
    // first so primitive / pointer / string operations keep emitting native
    // instructions (and the compiler's own IR stays byte-identical).  Only when
    // an operand is a user type (Phase 1) or a generic param bounded by the
    // operator's trait (Phase 2) do we rewrite `a + b` into the trait-method
    // call `a.add(&b)` and hand it back for the caller to hang on the node.

    /// Build `receiver.method(&rhs)` (or `receiver.method()` when `rhs` is
    /// null).  The `&rhs` is a compiler-synthesized address-of, matching the
    /// `<=>` desugar so it is exempt from the "no address-of a literal" check.
    /// The call names the operator's TRAIT method - `==` is `Eq::equals`, not
    /// an inherent `equals` the receiver may also declare - so the node
    /// carries the trait, the way a bound-directed call does.  `trait_id` is
    /// the trait's IDENTITY - the canonical name the impl that was found
    /// declares, or the bound's - never the operator table's leaf: two traits
    /// can share a leaf, and a leaf would let the wrong one's method win.
    build_operator_call(mut &this, receiver: ExpressionNode*, method: SymbolStr,
                        trait_id: DefId, rhs: ExpressionNode*, op_tok: Token,
                        span: SourceSpan) -> ExpressionNode* {
        const member: MemberAccessNode* = new MemberAccessNode(receiver, method, span, span);
        member.set_resolved_trait(trait_id);
        mut call: CallExprNode* = new CallExprNode(member as ExpressionNode*, span);
        if (rhs != null) {
            // The trait method takes `rhs: &Rhs`.  When the operand is already a
            // reference (`&Rhs`, e.g. a by-reference parameter or `&scratch[0]`),
            // pass it straight through; only synthesize `&rhs` for a value
            // operand, so we never build a `&&Rhs` that fails to type-check.
            const rhs_t: Type* = this.arena.lookup(rhs.resolved_type.id);
            if (rhs_t != null && rhs_t.kind == TypeKind::Reference) {
                call.add_argument(rhs);
            } else {
                const amp: Token = Token::new(TokenType::Amp, "&", op_tok.line, op_tok.column);
                mut ref_rhs: UnaryExprNode* = new UnaryExprNode(amp, rhs, rhs.span);
                ref_rhs.is_synthetic = true;
                call.add_argument(ref_rhs as ExpressionNode*);
            }
        }
        return call as ExpressionNode*;
    }

    /// The type a `for` scrutinee's `next` is called on: a pointer or
    /// reference auto-derefs to what it points at, and an instantiation to
    /// the type it resolved to.
    for_scrutinee_subject(&this, ty: TypeRef) -> TypeRef {
        mut r: TypeRef = ty;
        mut t: Type* = this.arena.lookup(r.id);
        mut depth: i32 = 0;
        while (t != null && depth < 5) {
            if (t.kind == TypeKind::Pointer) { r = (t as PointerType*).pointee; t = this.arena.lookup(r.id); }
            else if (t.kind == TypeKind::Reference) { r = (t as ReferenceType*).referent; t = this.arena.lookup(r.id); }
            else if (t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = t as InstantiatedType*;
                if (!inst.has_resolved_type()) { break; }
                r = inst.resolved_type; t = this.arena.lookup(r.id);
            } else { break; }
            depth += 1;
        }
        return r;
    }

    /// Whether a `for` scrutinee of type `ty` is an iterator: its subject
    /// implements `iterator_id`, the language's `Iterator` - a parameter by
    /// a bound naming it, a concrete type by an impl of it.  An impl whose
    /// where-clause binds a generic the target does not carry
    /// (`CopiedIter<I>`, `where I: Iterator<T*>`) is confirmed when its clone
    /// is placed, so a head that unifies answers here, as for an `implement
    /// Iterator` binding.
    for_scrutinee_iterates(&this, ty: TypeRef, iterator_id: DefId) -> boolean {
        if (!iterator_id.is_valid()) { return false; }
        const subject: TypeRef = this.for_scrutinee_subject(ty);
        const t: Type* = this.arena.lookup(subject.id);
        if (t == null) { return false; }
        return this.trait_checker().type_satisfies_opaque_bound(subject, iterator_id);
    }

    /// Decide whether operand type `ty` overloads `map`'s operator and, if so,
    /// build + resolve the trait-method call, returning the resolved desugar
    /// expression (its `resolved_type` set) for the caller to attach.  Returns
    /// null when no overload applies (caller keeps the primitive path or errors).
    /// Only a concrete user type (Struct/Class/Enum/Instantiated) with a
    /// registered trait impl overloads.
    operator_overload_expr(mut &this, receiver: ExpressionNode*, ty: TypeRef,
                           rhs: ExpressionNode*, map: OperatorTraitMap,
                           op_tok: Token, span: SourceSpan,
                           deref_ref: boolean) -> ExpressionNode* {
        if (!map.valid) { return null; }
        mut base_ty: TypeRef = ty;
        mut t: Type* = this.arena.lookup(base_ty.id);
        if (t == null) { return null; }
        // Cheap kind gate.  We NEVER unwrap raw pointers: `this.ptr == null`,
        // pointer arithmetic, and pointer comparison must keep the primitive
        // path (unwrapping a `Pair<..>*`'s pointee and finding its `Eq` impl is
        // exactly how `p == null` got miscompiled into `p.equals(&null)`).
        //
        // References ARE unwrapped, but ONLY when `deref_ref` is set - which the
        // callers do exclusively on the FAILURE path, i.e. after the primitive
        // `check_binary_op`/`check_unary_op` already rejected the operands.  On
        // the success path (reference + numeric arithmetic `&p + n`, reference
        // identity comparison `refA == refB`) the primitive rule applies and
        // must be preserved byte-identical, so those callers pass
        // `deref_ref = false`.  With this split, `a + b` / `-a` on a `&T`
        // parameter (the common by-reference case) overloads just like on a
        // value, while the pointer-ish primitive paths are untouched.  Bounded
        // depth guards a pathological `&&T`.
        if (deref_ref) {
            mut rdepth: i32 = 0;
            while (t != null && t.kind == TypeKind::Reference && rdepth < 4) {
                base_ty = (t as ReferenceType*).referent;
                t = this.arena.lookup(base_ty.id);
                rdepth += 1;
            }
            if (t == null) { return null; }
        }
        const is_user: boolean = t.kind == TypeKind::Struct || t.kind == TypeKind::Class
                              || t.kind == TypeKind::Enum || t.kind == TypeKind::InstantiatedType;
        if (!is_user) { return null; }
        // The operator's trait is the language's (`std::core::ops::Add` for
        // `+`, as Rust's `+` is `core::ops::Add`), by the identity its
        // declaration claimed; the table spells the leaf and nothing else.
        // A type overloads when it has an impl of that trait; a user trait
        // of the same spelling is not it.
        const trait_id: DefId = this.ctx.generic_registry.wellknown(map.lang);
        if (!trait_id.is_valid()) { return null; }
        if (this.trait_checker().select_impl(trait_id, base_ty, 0) == null) { return null; }
        const method_sym: SymbolStr = this.intern.intern(map.method);
        mut desugared: ExpressionNode* =
            this.build_operator_call(receiver, method_sym, trait_id, rhs, op_tok, span);
        // Relational operators: wrap the `compare` call in an `Ordering`
        // predicate - `a < b` -> `a.compare(&b).is_lt()`.
        if (map.ord_pred != "") {
            const pred_sym: SymbolStr = this.intern.intern(map.ord_pred);
            const pred_member: MemberAccessNode* =
                new MemberAccessNode(desugared, pred_sym, span, span);
            desugared = new CallExprNode(pred_member as ExpressionNode*, span) as ExpressionNode*;
        }
        if (map.negate) {
            const bang: Token = Token::new(TokenType::Exclaim, "!", op_tok.line, op_tok.column);
            desugared = new UnaryExprNode(bang, desugared, span) as ExpressionNode*;
        }
        // Deref: wrap the `b.deref()` call (which returns `Target*`) in an outer
        // `*` so `*b` yields the pointee.  The inner call's `Target*` is a real
        // pointer, so the wrapping `*` resolves on the primitive pointer rule and
        // never re-enters this hook.  `*ptr` is a place, so the one desugar serves
        // reads (`v = *b`), writes (`*b = x`), and compound (`*b += x`).
        if (map.deref_wrap) {
            const star: Token = Token::new(TokenType::Star, "*", op_tok.line, op_tok.column);
            mut star_node: UnaryExprNode* = new UnaryExprNode(star, desugared, span);
            star_node.is_synthetic = true;
            desugared = star_node as ExpressionNode*;
        }
        const rty: TypeRef = this.resolve_expr(desugared);
        if (!rty.is_valid()) { return null; }
        return desugared;
    }

    /// True when a comparison (`== != < > <= >=`) should unwrap a reference
    /// operand to reach a user `Eq`/`Ord` referent for value comparison: at least
    /// one operand is `&T`, and NEITHER operand is void (a `null` literal), so
    /// `ref == null` keeps its pointer null-check.  The user-vs-primitive decision
    /// is left to `operator_overload_expr` (which only fires for a user referent),
    /// so `&i32 == &i32` and pointer/class null-checks stay on the identity path.
    comparison_unwraps_reference(&this, lhs: TypeRef, rhs: TypeRef) -> boolean {
        const lt: Type* = this.arena.lookup(lhs.id);
        const rt: Type* = this.arena.lookup(rhs.id);
        if (lt == null || rt == null) { return false; }
        if (lt.kind == TypeKind::Void || rt.kind == TypeKind::Void) { return false; }
        return lt.kind == TypeKind::Reference || rt.kind == TypeKind::Reference;
    }

    /// Reflected operator overloading for a PRIMITIVE left operand: `2 * vec`,
    /// where the user type is the RIGHT operand and the operator trait is
    /// implemented ON the primitive (`implement trait Mul<Vec, Vec> for i32`).
    ///
    /// Operator dispatch is LHS-driven and primitives are excluded from the
    /// normal `operator_overload_expr` gate (their arithmetic must stay on the
    /// native fast path).  This is therefore a SEPARATE, FAILURE-PATH-ONLY
    /// attempt, tried only after `check_binary_op` rejected the operands and the
    /// normal (LHS-driven) overload found nothing: a primitive OP primitive
    /// always type-checks and never reaches here, so the native path is never
    /// perturbed, and primitive OP user-type would otherwise be a hard error, so this is
    /// purely additive.  Builds `lhs.method(&rhs)` - primitive receivers support
    /// trait-method calls (cf. `Ord::compare` / `Step::successor` on `i32`).
    ///
    /// Restricted to the arithmetic / bitwise / shift traits, whose `Rhs` is a
    /// free type parameter.  `Eq`/`Ord` are excluded: their receiver and operand
    /// share `This`, so `2 == vec` can never match a primitive's own comparison
    /// impl, and attempting it would only risk a spurious diagnostic.
    reflected_operator_overload_expr(mut &this, lhs_expr: ExpressionNode*, lhs: TypeRef,
                                     rhs_expr: ExpressionNode*, map: OperatorTraitMap,
                                     op_tok: Token, span: SourceSpan) -> ExpressionNode* {
        if (!map.valid) { return null; }
        if (map.ord_pred != "" || map.lang == LangItem::Eq) { return null; }
        const lt: Type* = this.arena.lookup(lhs.id);
        if (lt == null) { return null; }
        // Only a genuine primitive scalar LHS.  A user / bounded / pointer /
        // reference / string LHS is handled (or deliberately not) elsewhere.
        const is_primitive: boolean = lt.kind == TypeKind::Int || lt.kind == TypeKind::Float
                                   || lt.kind == TypeKind::Char || lt.kind == TypeKind::Bool;
        if (!is_primitive) { return null; }
        // Gate on the impl EXISTING on the primitive before building anything,
        // so a plain `2 * 3`-shaped error never materializes a bogus call.
        const impl_block: ImplBlockNode* = this.trait_checker().select_impl(
            this.ctx.generic_registry.wellknown(map.lang), lhs, 0);
        if (impl_block == null || !impl_block.trait_def.is_valid()) { return null; }
        const method_sym: SymbolStr = this.intern.intern(map.method);
        mut desugared: ExpressionNode* =
            this.build_operator_call(lhs_expr, method_sym, impl_block.trait_def, rhs_expr, op_tok, span);
        const rty: TypeRef = this.resolve_expr(desugared);
        if (!rty.is_valid()) { return null; }
        return desugared;
    }

    /// When an overloadable operator hits a user type that lacks the required
    /// trait impl, emit a diagnostic that names the missing trait instead of the
    /// generic "cannot apply".  Returns true when it emitted (so the caller
    /// skips the fallback error); false for non-user operands (a genuine
    /// primitive type error keeps its original message).
    emit_operator_missing_impl(mut &this, ty: TypeRef, map: OperatorTraitMap,
                               op_lexeme: string, span: SourceSpan) -> boolean {
        if (!map.valid) { return false; }
        mut t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return false; }
        // Look through references so `&UserType OP x` (a by-reference operand
        // lacking the trait impl) gets the trait-naming diagnostic too.
        mut rdepth: i32 = 0;
        while (t != null && t.kind == TypeKind::Reference && rdepth < 4) {
            t = this.arena.lookup((t as ReferenceType*).referent.id);
            rdepth += 1;
        }
        if (t == null) { return false; }
        const is_user: boolean = t.kind == TypeKind::Struct || t.kind == TypeKind::Class
                              || t.kind == TypeKind::Enum || t.kind == TypeKind::InstantiatedType;
        if (!is_user) { return false; }
        const name: string = this.arena.format_display(t);
        this.ctx.emit_error_at(ErrorCode::E0229_INVALID_BINARY_OP,
            fmt::format("`%s` does not implement `%s`; add `implement trait %s ... for %s` to use the `%s` operator on it",
                name, map.lang.leaf(), map.lang.leaf(), name, op_lexeme), span);
        return true;
    }

    /// Warn when two DIFFERENT concrete numeric types meet in one operation.
    ///
    /// Only the widening direction can occur here - the common-type rule picks
    /// the wider operand, so the narrower one converts up to it - and narrowing
    /// is already rejected where it can appear, at the assignment and argument
    /// boundaries.  Widening is accepted for now, so this is a warning and not
    /// an error, but the language reference states that every conversion is
    /// written with `as`, so the message says the acceptance is temporary
    /// rather than letting the code quietly contradict the reference.
    ///
    /// Suppressible by code through `DiagConfig` like any other warning, which
    /// matters while the tree still carries mixed-width integer arithmetic.
    warn_implicit_numeric_conversion(mut &this, bin: BinaryExprNode*,
                                     lhs: TypeRef, rhs: TypeRef) -> void {
        if (!lhs.is_valid() || !rhs.is_valid()) { return; }
        if (lhs.id == rhs.id) { return; }
        const lt: Type* = this.arena.lookup(lhs.id);
        const rt2: Type* = this.arena.lookup(rhs.id);
        if (lt == null || rt2 == null) { return; }
        const l_num: boolean = lt.kind == TypeKind::Int || lt.kind == TypeKind::Float;
        const r_num: boolean = rt2.kind == TypeKind::Int || rt2.kind == TypeKind::Float;
        if (!l_num || !r_num) { return; }
        mut diag: Diagnostic = Diagnostic::warning(
            ErrorCode::W0005_IMPLICIT_CONVERSION,
            fmt::format("implicit conversion between `%s` and `%s`; the narrower operand widens to the wider one. Write it with `as` - this is accepted for now and will become an error before v1.0.0",
                this.types.type_display_name(lhs),
                this.types.type_display_name(rhs)));
        diag = diag.at(bin.span);
        this.ctx.emit_diagnostic(diag);
    }

    resolve_binary(mut &this, bin: BinaryExprNode*) -> TypeRef {
        // Idempotent: if a previous resolution already rewrote this operator
        // into a trait-method call, return its type without re-running
        // `check_binary_op` (which would re-reject the user-typed operands and
        // emit a spurious E0229 the second time around).
        // Post-mono the desugar is a clone the substituter left unbound: walk
        // it again (see `resolve_array_access`).
        if (bin.desugared_call != null) {
            if (this.state.post_mono_verify) { return this.resolve_expr(bin.desugared_call); }
            return bin.desugared_call.resolved_type;
        }
        const left_is_lit:  boolean = is_numeric_literal_expr(bin.left);
        const right_is_lit: boolean = is_numeric_literal_expr(bin.right);
        // A negated or folded constant (`-1.0`, `16.0 / 9.0`) is as
        // width-polymorphic as the bare literal above, but it is a Unary/Binary
        // node so the two flags miss it and neither operand hints the other.
        const left_is_const_num:  boolean = is_constant_numeric_expr(bin.left);
        const right_is_const_num: boolean = is_constant_numeric_expr(bin.right);
        mut lhs: TypeRef = TypeRef::invalid();
        mut rhs: TypeRef = TypeRef::invalid();

        if (bin.op.kind.is_assignment_op()) {
            lhs = this.resolve_expr(bin.left);
            if (lhs.is_valid()) {
                const saved_exp: TypeRef = this.state.expected_type;
                this.state.expected_type = lhs;
                rhs = this.resolve_expr(bin.right);
                this.state.expected_type = saved_exp;
            } else {
                rhs = this.resolve_expr(bin.right);
            }
            this.check_assignment_lvalue(bin.left);
            if (bin.op.lexeme == "=" && lhs.is_valid() && rhs.is_valid()
                && this.types.arg_type_is_concrete(lhs) && this.types.arg_type_is_concrete(rhs)
                && !this.checker.can_assign(rhs, lhs)
                && !this.types.indirection_spelling_compatible(rhs, lhs)) {
                const value_span: SourceSpan = if (bin.right != null) { bin.right.span } else { bin.span };
                this.diag.emit_type_mismatch_with_value(
                    ErrorCode::E0200_TYPE_MISMATCH, value_span, lhs, rhs,
                    "the value assigned here doesn't match the type of the assignment target",
                    bin.left.span, bin.right);
            }
            // Compound assignment (`+=`, `-=`, `*=`, ...) also has to
            // type-check the *underlying* binary operation.  Plain binary
            // exprs run through `check_binary_op` (see below); the
            // assignment branch must too, or a
            // nonsense compound like `s *= 3` (string) or `p /= 2`
            // (pointer) passes sema and silently emits null IR in
            // codegen (the base op has no arm in `codegen_binary`).
            // Validate the base op the same way, guarding on
            // symbolically-unresolved operands so pre-monomorphization
            // generic bodies don't trip.
            const base_lex: string = bin.op.kind.compound_base_lexeme();
            if (base_lex != "" && lhs.is_valid() && rhs.is_valid()
                && !this.symbolic.symbolic_type_unresolved(lhs)
                && !this.symbolic.symbolic_type_unresolved(rhs)) {
                const cres: TypeCheckResult = this.checker.check_binary_op(base_lex, lhs, rhs);
                // Compound assignment routes through the same operator traits:
                // `a += b` overloads to `a.add(&b)` and stores the result back
                // into `a` (codegen). Phase 2 bounded params overload on the
                // success path; concrete user types on the failure path.
                const map: OperatorTraitMap = OperatorTraitMap::for_binary(base_lex);
                if (cres.success) {
                    if (map.valid && bin.desugared_call == null) {
                        const de: ExpressionNode* = this.operator_overload_expr(
                            bin.left, lhs, bin.right, map, bin.op, bin.span, false);
                        if (de != null) { bin.desugared_call = de; }
                    }
                } else {
                    mut overloaded: boolean = false;
                    if (map.valid && bin.desugared_call == null) {
                        const de: ExpressionNode* = this.operator_overload_expr(
                            bin.left, lhs, bin.right, map, bin.op, bin.span, true);
                        if (de != null) { bin.desugared_call = de; overloaded = true; }
                    }
                    if (!overloaded
                        && !this.emit_operator_missing_impl(lhs, map, base_lex, bin.span)) {
                        this.ctx.emit_error_at(ErrorCode::E0229_INVALID_BINARY_OP,
                            cres.error_message, bin.span);
                    }
                }
            }
            return lhs;
        }

        if ((bin.op.lexeme == "/" || bin.op.lexeme == "%") && is_zero_int_literal(bin.right)) {
            this.ctx.emit_error_at(ErrorCode::E0226_DIVISION_BY_ZERO,
                if (bin.op.lexeme == "/") { "division by zero" } else { "remainder with a zero divisor" }, bin.span);
        }

        mut force_wide: TypeRef = TypeRef::invalid();
        if (!this.literals.expected_type_is_int_type()) {
            mut folded: i64 = 0;
            if (try_fold_const_i64(bin as ExpressionNode*, &folded)) {
                const mag: u64 = if (folded < 0) { (0 - folded) as u64 } else { folded as u64 };
                if (mag > sema_i32_max_mag()) { force_wide = this.arena.get_i64(); }
            }
        }
        if (force_wide.is_valid()) {
            const saved_fw: TypeRef = this.state.expected_type;
            this.state.expected_type = force_wide;
            lhs = this.resolve_expr(bin.left);
            rhs = this.resolve_expr(bin.right);
            this.state.expected_type = saved_fw;
        } else if (right_is_lit && !left_is_lit) {
            lhs = this.resolve_expr(bin.left);
            if (lhs.is_valid()) {
                const saved_exp: TypeRef = this.state.expected_type;
                this.state.expected_type = lhs;
                rhs = this.resolve_expr(bin.right);
                this.state.expected_type = saved_exp;
            } else {
                rhs = this.resolve_expr(bin.right);
            }
        } else if (left_is_lit && !right_is_lit) {
            rhs = this.resolve_expr(bin.right);
            if (rhs.is_valid()) {
                const saved_exp: TypeRef = this.state.expected_type;
                this.state.expected_type = rhs;
                lhs = this.resolve_expr(bin.left);
                this.state.expected_type = saved_exp;
            } else {
                lhs = this.resolve_expr(bin.left);
            }
        // A constant numeric expression adopts its peer's type on exactly the
        // slots the call path pushes a parameter type onto, and for the same
        // two reasons.  A narrow FLOAT: the constant otherwise settles on the
        // f64 default and the pair reaches codegen as `fadd double, float`,
        // which fails module verification with no source location.  A WIDE int:
        // `value < -128` against an `i64` otherwise computes the constant at
        // the i32 default and then widens it, which is a conversion the source
        // never asked for.  Narrow int peers are excluded on purpose - pushing
        // one onto `1 << 20` would truncate a constant that currently computes
        // at the i32 default and is then widened correctly.
        } else if (right_is_const_num && !left_is_const_num) {
            lhs = this.resolve_expr(bin.left);
            if (is_narrow_float_type(this.arena, lhs) || is_wide_int_type(this.arena, lhs)) {
                const saved_exp: TypeRef = this.state.expected_type;
                this.state.expected_type = lhs;
                rhs = this.resolve_expr(bin.right);
                this.state.expected_type = saved_exp;
            } else {
                rhs = this.resolve_expr(bin.right);
            }
        } else if (left_is_const_num && !right_is_const_num) {
            rhs = this.resolve_expr(bin.right);
            if (is_narrow_float_type(this.arena, rhs) || is_wide_int_type(this.arena, rhs)) {
                const saved_exp: TypeRef = this.state.expected_type;
                this.state.expected_type = rhs;
                lhs = this.resolve_expr(bin.left);
                this.state.expected_type = saved_exp;
            } else {
                lhs = this.resolve_expr(bin.left);
            }
        } else {
            lhs = this.resolve_expr(bin.left);
            rhs = this.resolve_expr(bin.right);
        }

        if (this.symbolic.symbolic_type_unresolved(lhs) || this.symbolic.symbolic_type_unresolved(rhs)) {
            return TypeRef::invalid();
        }
        if (lhs.is_valid() && rhs.is_valid()) {
            const result: TypeCheckResult = this.checker.check_binary_op(bin.op.lexeme, lhs, rhs);
            const map: OperatorTraitMap = OperatorTraitMap::for_binary(bin.op.lexeme);
            if (result.success) {
                this.warn_implicit_numeric_conversion(bin, lhs, rhs);
                // Phase 2: a bounded-param operand (`T: Add`) still overloads,
                // even though `check_binary_op` passed the generic param through.
                // Concrete primitives fall straight through (no user impl).
                if (map.valid && bin.desugared_call == null) {
                    // References to a user `Eq`/`Ord` type compare BY VALUE, not by
                    // identity: `&a == &b` -> `a.equals(&b)` (and `<`/`>` via `Ord`).
                    // `check_binary_op` passes any reference comparison as a `bool`
                    // (pointer identity); for the comparison traits we instead unwrap
                    // the reference and overload when the referent is a user type
                    // implementing the trait.  Everything else keeps identity: a
                    // `null`/void operand (`ref == null` stays a pointer null-check),
                    // and a reference to a primitive or a non-`Eq` type - those make
                    // `operator_overload_expr` return null and fall through here.
                    const succ_deref: boolean =
                        (map.lang == LangItem::Eq || map.lang == LangItem::Ord)
                        && this.comparison_unwraps_reference(lhs, rhs);
                    const de: ExpressionNode* = this.operator_overload_expr(
                        bin.left, lhs, bin.right, map, bin.op, bin.span, succ_deref);
                    if (de != null) { bin.desugared_call = de; return de.resolved_type; }
                }
                return result.result_type;
            }
            // Phase 1: `check_binary_op` rejected - a concrete user type with a
            // registered impl overloads; otherwise it is a genuine type error.
            if (map.valid && bin.desugared_call == null) {
                const de: ExpressionNode* = this.operator_overload_expr(
                    bin.left, lhs, bin.right, map, bin.op, bin.span, true);
                if (de != null) { bin.desugared_call = de; return de.resolved_type; }
                // Reflected: a PRIMITIVE left operand with the trait implemented
                // on it (`2 * vec` => `(2).mul(&vec)`).  LHS-driven dispatch skips
                // primitives, so this is the one place the right operand's user
                // type can pull in an impl hung on the primitive.
                const rde: ExpressionNode* = this.reflected_operator_overload_expr(
                    bin.left, lhs, bin.right, map, bin.op, bin.span);
                if (rde != null) { bin.desugared_call = rde; return rde.resolved_type; }
                if (this.emit_operator_missing_impl(lhs, map, bin.op.lexeme, bin.span)) {
                    return TypeRef::invalid();
                }
            }
            this.ctx.emit_error_at(ErrorCode::E0229_INVALID_BINARY_OP, result.error_message, bin.span);
        }
        if (lhs.is_valid()) { return lhs; }
        if (rhs.is_valid()) { return rhs; }
        return TypeRef::invalid();
    }

    check_assignment_lvalue(mut &this, lhs: ExpressionNode*) -> void {
        if (lhs == null) { return; }
        match (lhs.kind) {
            NodeKind::Identifier => {
                const id: IdentifierNode* = lhs as IdentifierNode*;
                if (this.names_receiver(id)) { return; }
                match (this.state.local_muts.get(&id.name.id)) {
                    Option::Some(is_mut) => {
                        if (!is_mut) {
                            const name_str: string = this.intern.resolve(id.name);
                            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0218_IMMUTABLE_ASSIGNMENT,
                                fmt::format("cannot assign to immutable variable `%s`", name_str));
                            diag = diag.at_with_label(lhs.span, "this binding is immutable");
                            match (this.state.local_kw_spans.get(&id.name.id)) {
                                Option::Some(kw) => {
                                    const kw_len: u32 = if (kw.end_col > kw.start_col) { kw.end_col - kw.start_col } else { 0 };
                                    if (kw_len == 0) {
                                        diag = diag.suggest(Suggestion::machine_applicable(kw, "mut ", fmt::format("make `%s` mutable", name_str)));
                                    } else {
                                        diag = diag.suggest(Suggestion::machine_applicable(kw, "mut", fmt::format("make `%s` mutable", name_str)));
                                    }
                                }
                                Option::None => {
                                    diag = diag.with_note("declare the binding with `mut` instead of `const` to allow reassignment");
                                }
                            }
                            this.ctx.diagnostics.emit(diag);
                        }
                    }
                    Option::None => {}
                }
            }
            NodeKind::MemberAccess => {
                const ma: MemberAccessNode* = lhs as MemberAccessNode*;
                if (ma.object == null) { return; }
                const recv_t: Type* = this.arena.lookup(ma.object.resolved_type.id);
                if (recv_t != null && (recv_t.kind == TypeKind::Pointer || recv_t.kind == TypeKind::Reference)) { return; }
                if (this.symbolic.symbolic_type_unresolved(ma.object.resolved_type)) { return; }
                this.check_assignment_lvalue(ma.object);
            }
            NodeKind::ArrayAccess => {
                const aa: ArrayAccessNode* = lhs as ArrayAccessNode*;
                if (aa.array == null) { return; }
                const arr_t: Type* = this.arena.lookup(aa.array.resolved_type.id);
                if (arr_t != null && (arr_t.kind == TypeKind::Pointer || arr_t.kind == TypeKind::Reference)) { return; }
                if (this.symbolic.symbolic_type_unresolved(aa.array.resolved_type)) { return; }
                this.check_assignment_lvalue(aa.array);
            }
            NodeKind::Literal => {
                this.ctx.emit_error_at(ErrorCode::E0232_INVALID_ASSIGNMENT_TARGET,
                    "cannot assign to a literal; the left-hand side of an assignment must be a place (variable, field, or index)", lhs.span);
            }
            _ => {}
        }
    }

    resolve_unary(mut &this, unary: UnaryExprNode*) -> TypeRef {
        // Idempotent (see resolve_binary): a prior resolution may have rewritten
        // `-x` into `x.neg()`; return its type rather than re-rejecting.
        if (unary.desugared_call != null) {
            if (this.state.post_mono_verify) { return this.resolve_expr(unary.desugared_call); }
            return unary.desugared_call.resolved_type;
        }
        // Address-of resolved against an expected `&T`: a numeric-literal
        // operand must adopt the referent width (`&3` bound to `&i64` -> `&i64`,
        // not `&i32`; otherwise codegen spills a too-narrow temp and the
        // callee's `*rhs` reads uninitialised high bytes). The literal is
        // resolved under the REFERENT as its expected type - the reference
        // itself is not a type an integer literal adopts - and that answer is
        // the operand's type: resolving the operand again under the reference
        // would default the width back (the post-mono walk does resolve
        // again, so the first answer has to be the one kept). Only polymorphic
        // numeric literals are touched; a real place keeps its own type.
        mut operand_type: TypeRef = TypeRef::invalid();
        if (unary.op.lexeme == "&" && unary.operand != null
            && unary.operand.kind == NodeKind::Literal
            && this.state.expected_type.is_valid()) {
            const exp_t0: Type* = this.arena.lookup(this.state.expected_type.id);
            if (exp_t0 != null && exp_t0.kind == TypeKind::Reference) {
                const ref_ty0: TypeRef = (exp_t0 as ReferenceType*).referent;
                const rt0: Type* = this.arena.lookup(ref_ty0.id);
                const lit0: LiteralNode* = unary.operand as LiteralNode*;
                const numeric_match: boolean = rt0 != null
                    && ((rt0.kind == TypeKind::Int && lit0.literal_kind == LiteralKind::Integer)
                     || (rt0.kind == TypeKind::Float && lit0.literal_kind == LiteralKind::Float));
                if (numeric_match) {
                    const saved_exp0: TypeRef = this.state.expected_type;
                    this.state.expected_type = ref_ty0;
                    const lit_ty0: TypeRef = this.literals.resolve_literal(lit0);
                    this.state.expected_type = saved_exp0;
                    if (lit_ty0.is_valid()) {
                        unary.operand.set_resolved_type(lit_ty0);
                        operand_type = lit_ty0;
                    }
                }
            }
        }
        if (!operand_type.is_valid()) { operand_type = this.resolve_expr(unary.operand); }
        if (!operand_type.is_valid()) { return TypeRef::invalid(); }
        if (unary.op.lexeme == "&" && !unary.is_synthetic && unary.operand != null
            && unary.operand.kind == NodeKind::Literal) {
            this.ctx.emit_error_at(ErrorCode::E0223_INVALID_ADDRESS_OF,
                "cannot take the address of a literal; `&` requires a place (variable, field, or index)", unary.span);
            return TypeRef::invalid();
        }
        if (unary.op.lexeme == "*" && unary.operand != null && unary.operand.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = unary.operand as IdentifierNode*;
            if (this.names_receiver(id)) { return operand_type; }
        }
        const result: TypeCheckResult = this.checker.check_unary_op(unary.op.lexeme, operand_type);
        if (!result.success) {
            if (this.symbolic.symbolic_type_unresolved(operand_type)) { return operand_type; }
            // Operator overloading: `-x` on a user type (Phase 1) or a
            // `Neg`-bounded generic param (Phase 2) rewrites to `x.neg()`.
            // A bounded param is non-numeric, so it reaches this failure path.
            const map: OperatorTraitMap = OperatorTraitMap::for_unary(unary.op.lexeme);
            if (map.valid && unary.desugared_call == null) {
                const de: ExpressionNode* = this.operator_overload_expr(
                    unary.operand, operand_type, null, map, unary.op, unary.span, true);
                if (de != null) { unary.desugared_call = de; return de.resolved_type; }
                if (this.emit_operator_missing_impl(operand_type, map, unary.op.lexeme, unary.span)) {
                    return operand_type;
                }
            }
            this.ctx.emit_error_at(ErrorCode::E0230_INVALID_UNARY_OP, result.error_message, unary.span);
            return operand_type;
        }
        if (unary.op.lexeme == "&") {
            if (this.state.expected_type.is_valid()) {
                const exp_type: Type* = this.arena.lookup(this.state.expected_type.id);
                if (exp_type != null && exp_type.kind == TypeKind::Reference) {
                    const exp_ref: ReferenceType* = exp_type as ReferenceType*;
                    if (exp_ref.is_mutable()) {
                        return this.arena.get_reference_to(operand_type, RefMutability::Mutable);
                    }
                }
            }
        }
        return result.result_type;
    }

    /// The type a `sizeof`/`alignof` measures, resolved from its annotation
    /// in the body's own context - the same question a cast target asks, and
    /// answered once: the node carries the answer for the const folder and
    /// codegen, neither of which re-derives it.  A clone arrives with the slot
    /// cleared by the substituter and is answered here again over the
    /// substituted annotation.
    resolve_layout_operand(mut &this, ann: TypeAnnotation*) -> TypeRef {
        if (ann == null || this.ctx.type_resolver == null) { return TypeRef::invalid(); }
        this.prime_typeof_annotation(ann);
        mut res_ctx: ResolutionContext = this.body_res_ctx();
        this.symbolic.symbolic_bind_params(&res_ctx);
        const ty: TypeRef = this.ctx.type_resolver.resolve(ann, &res_ctx);
        if (!ty.is_valid()) { this.refuse_unresolved_body_annotation(ann); }
        return ty;
    }

    /// A body annotation the type layer could not resolve - a local's, a
    /// `sizeof`/`alignof` operand's, a cast target's.  A name in it the name
    /// layer refused was reported where it was written, and a leaf left
    /// unanswered is recorded by the door; a failure that is neither (a form
    /// resolved later in the walk) is left to that walk.
    refuse_unresolved_body_annotation(&this, ann: TypeAnnotation*) -> void {
        TypeAnnotation::refused(ann);
    }

    resolve_cast(mut &this, cast: CastExprNode*) -> TypeRef {
        // The operand of an explicit cast is not bounded by the SURROUNDING
        // annotation.  `as` names its own target, and performing a conversion
        // the operand would not survive implicitly is the whole reason to write
        // one - so leaving the enclosing expected type in scope let the bound
        // the cast exists to satisfy reject the cast's own operand:
        // `const x: i32 = 18446744073709551613 as i32` was "out of range for
        // i32", which is how a two's-complement bit pattern is spelled and what
        // the C importer emits for a negative constant.  Cleared rather than
        // replaced by the target: the literal takes its natural width and the
        // cast truncates, which is the same answer for an in-range operand and
        // the only one that admits a full-width pattern.  A bare literal keeps
        // its bound (no cast, no clear), and a suffixed one is settled before
        // the expected type is consulted at all.
        const saved_expected: TypeRef = this.state.expected_type;
        this.state.expected_type = TypeRef::invalid();
        const from_ty: TypeRef = this.resolve_expr(cast.expression);
        this.state.expected_type = saved_expected;
        if (!cast.has_resolved_target() && cast.target_annotation != null && this.ctx.type_resolver != null) {
            this.prime_typeof_annotation(cast.target_annotation);
            mut res_ctx: ResolutionContext = ResolutionContext::new("");
            // `x as T` is written inside a body, so the target annotation means
            // what that body's module says (spec §8.2l, same shape as
            // `body_res_ctx`).
            // Bind the enclosing generic's type parameters so a cast target like
            // `x as T` resolves `T` to the abstract method/owner type parameter,
            // not a same-named global type in another module.  Without this an
            // innocent user `type struct T` shadows the parameter of any pulled
            // generic (e.g. stdlib `RandomSource::next_range<T>`), turning
            // `<scalar> as T` into an aggregate cast -> spurious E0208.  Mirrors
            // the identical bind at the var-decl / other cast/annotation sites.
            this.symbolic.symbolic_bind_params(&res_ctx);
            const target: TypeRef = this.ctx.type_resolver.resolve(cast.target_annotation, &res_ctx);
            if (target.is_valid()) { cast.set_resolved_target(target); }
            else { this.refuse_unresolved_body_annotation(cast.target_annotation); }
        }
        const to_ty: TypeRef = cast.resolved_target;
        if (from_ty.is_valid() && to_ty.is_valid()
            && !this.cast_operand_is_byref_receiver(cast.expression)
            && this.types.arg_type_is_concrete(from_ty) && this.types.arg_type_is_concrete(to_ty)
            && this.is_aggregate_scalar_cast(from_ty, to_ty)) {
            this.ctx.emit_error_at(ErrorCode::E0208_INVALID_CAST,
                "invalid cast between an aggregate type (struct/class/tuple/array) and a scalar or pointer: there is no valid representation for this conversion",
                cast.span);
        }
        return cast.resolved_target;
    }

    /// True when the cast operand is `this` inside a BY-REFERENCE method.
    ///
    /// Such a receiver is an address - it is passed as a pointer - but it is
    /// typed as the owner so that member access inside the body reads as the
    /// value it stands for.  So `this as void*` is pointer-to-pointer, not the
    /// aggregate-to-scalar conversion E0208 exists to reject, and it is how the
    /// C client-data idiom is spelled (`clang_visitChildren(cur, visitor, this
    /// as void*)`).  A BY-VALUE receiver is a real aggregate and still reports:
    /// there the cast has no representation, exactly as for any other value.
    cast_operand_is_byref_receiver(&this, expr: ExpressionNode*) -> boolean {
        if (expr == null || !this.state.this_is_by_ref) { return false; }
        const n: ASTNode* = expr as ASTNode*;
        if (n.kind != NodeKind::Identifier) { return false; }
        return this.names_receiver(expr as IdentifierNode*);
    }

    /// True when a cast crosses between a memory aggregate and a scalar/pointer
    /// type (no valid LLVM lowering).  Class instances are heap pointers, so not
    /// aggregates here.
    is_aggregate_scalar_cast(&this, from: TypeRef, to: TypeRef) -> boolean {
        mut f: Type* = this.arena.lookup(from.id);
        mut t: Type* = this.arena.lookup(to.id);
        if (f == null || t == null) { return false; }
        if (f.kind == TypeKind::InstantiatedType) {
            const fi: InstantiatedType* = f as InstantiatedType*;
            if (!fi.has_resolved_type()) { return false; }
            f = this.arena.lookup(fi.resolved_type.id);
        }
        if (t.kind == TypeKind::InstantiatedType) {
            const ti: InstantiatedType* = t as InstantiatedType*;
            if (!ti.has_resolved_type()) { return false; }
            t = this.arena.lookup(ti.resolved_type.id);
        }
        if (f == null || t == null) { return false; }
        const f_agg: boolean = f.kind == TypeKind::Struct || f.kind == TypeKind::Tuple || f.kind == TypeKind::Array;
        const t_agg: boolean = t.kind == TypeKind::Struct || t.kind == TypeKind::Tuple || t.kind == TypeKind::Array;
        const f_scl: boolean = f.kind == TypeKind::Int || f.kind == TypeKind::Float || f.kind == TypeKind::Bool
                            || f.kind == TypeKind::Char || f.kind == TypeKind::String || f.kind == TypeKind::Pointer
                            || f.kind == TypeKind::Reference || f.kind == TypeKind::Enum;
        const t_scl: boolean = t.kind == TypeKind::Int || t.kind == TypeKind::Float || t.kind == TypeKind::Bool
                            || t.kind == TypeKind::Char || t.kind == TypeKind::String || t.kind == TypeKind::Pointer
                            || t.kind == TypeKind::Reference || t.kind == TypeKind::Enum;
        return (f_agg && t_scl) || (f_scl && t_agg);
    }

    /// Arms of a value-producing branch have to agree on a type.  Neither arm is
    /// the "expected" one, so compatibility is tested in both directions and only
    /// a pair that is incompatible each way reports; a diverging arm carries
    /// `Never`, which coerces to anything and therefore never fires here.
    /// Without this check the resolver returns whichever arm happens to type
    /// first, so arms of unrelated types (`char` vs `i8`) reach codegen and the
    /// result is read at the wrong width.
    check_branch_agreement(mut &this, first: TypeRef, first_span: SourceSpan,
                           second: TypeRef, second_span: SourceSpan,
                           context_msg: string) -> void {
        if (!first.is_valid() || !second.is_valid()) { return; }
        if (first.id == second.id) { return; }
        // Inside a generic template an arm's type can still be a bare parameter
        // or an unresolved projection; agreement is only decidable per
        // instantiation, so defer exactly as the return-type check does.
        if (this.symbolic.type_has_unresolved_projection(first)
                || this.symbolic.type_has_unresolved_projection(second)
                || this.symbolic.symbolic_defer_type(first)
                || this.symbolic.symbolic_defer_type(second)) { return; }
        if (this.checker.check_compatibility(first, second) != TypeCompatibility::Incompatible) { return; }
        if (this.checker.check_compatibility(second, first) != TypeCompatibility::Incompatible) { return; }
        this.diag.emit_type_mismatch(ErrorCode::E0238_BRANCH_TYPE_MISMATCH,
            second_span, first, second, context_msg, first_span);
    }

    resolve_if_expr(mut &this, if_expr: IfExprNode*) -> TypeRef {
        this.resolve_expr(if_expr.condition);
        const then_type: TypeRef = this.resolve_expr(if_expr.then_expr);
        const else_type: TypeRef = this.resolve_expr(if_expr.else_expr);
        this.check_branch_agreement(then_type, if_expr.then_expr.span,
            else_type, if_expr.else_expr.span,
            "both branches of an `if` expression must produce the same type");
        if (then_type.is_valid()) { return then_type; }
        if (else_type.is_valid()) { return else_type; }
        return TypeRef::invalid();
    }

    resolve_ternary(mut &this, ternary: TernaryExprNode*) -> TypeRef {
        this.resolve_expr(ternary.condition);
        const true_type: TypeRef = this.resolve_expr(ternary.true_expr);
        const false_type: TypeRef = this.resolve_expr(ternary.false_expr);
        this.check_branch_agreement(true_type, ternary.true_expr.span,
            false_type, ternary.false_expr.span,
            "both arms of a conditional expression must produce the same type");
        if (true_type.is_valid()) { return true_type; }
        if (false_type.is_valid()) { return false_type; }
        return TypeRef::invalid();
    }

    resolve_match_expr(mut &this, match_expr: MatchExprNode*) -> TypeRef {
        const subject_type: TypeRef = this.resolve_expr(match_expr.subject);
        const caller_backed: boolean = this.subject_is_caller_backed(match_expr.subject);
        this.patterns.check_duplicate_default_arm(match_expr.arms);
        const outer_expected: TypeRef = this.state.expected_type;
        mut result_type: TypeRef = TypeRef::invalid();
        mut result_span: SourceSpan = match_expr.span;
        for (mut i: i64 = 0; i < match_expr.arms.length; i++) {
            const arm: MatchArmNode* = match_expr.arms[i];
            if (arm == null || arm.body == null) { continue; }
            const save: i64 = this.scopes.save_scope();
            this.patterns.bind_arm_patterns(arm, subject_type, caller_backed);
            if (arm.guard != null) { this.resolve_expr(arm.guard); }
            const body_node: ASTNode* = arm.body as ASTNode*;
            if (body_node.kind == NodeKind::BlockStatement) {
                const block: BlockStmtNode* = arm.body as BlockStmtNode*;
                const last_idx: i64 = block.statements.length - 1;
                for (mut j: i64 = 0; j < block.statements.length; j++) {
                    if (j == last_idx && outer_expected.is_valid()) { this.state.expected_type = outer_expected; }
                    this.dispatch_stmt(block.statements[j]);
                    if (j == last_idx) { this.state.expected_type = outer_expected; }
                }
                if (block.statements.length > 0) {
                    const last: StatementNode* = block.statements[block.statements.length - 1];
                    if ((last as ASTNode*).kind == NodeKind::ExpressionStatement) {
                        const es: ExprStmtNode* = last as ExprStmtNode*;
                        if (es.expression != null && es.expression.has_resolved_type()) {
                            const arm_type: TypeRef = es.expression.resolved_type;
                            if (!result_type.is_valid()) {
                                result_type = arm_type;
                                result_span = es.expression.span;
                            } else {
                                this.check_branch_agreement(result_type, result_span,
                                    arm_type, es.expression.span,
                                    "every arm of a `match` expression must produce the same type");
                            }
                        }
                    }
                }
            } else {
                this.dispatch_stmt(arm.body);
            }
            this.scopes.restore_scope(save);
        }
        this.state.expected_type = outer_expected;
        this.patterns.check_match_exhaustive(match_expr.subject, subject_type, match_expr.arms, match_expr.span);
        this.patterns.check_range_patterns(match_expr.arms, subject_type);
        if (outer_expected.is_valid()) { return outer_expected; }
        return result_type;
    }

    resolve_static_match_expr(mut &this, sm: StaticMatchExprNode*) -> TypeRef {
        if (sm == null || sm.arms.length == 0) { return TypeRef::invalid(); }
        if (sm.arms.length > 1 && !this.state.in_symbolic_check) {
            this.ctx.emit_error_at(ErrorCode::E0645_NO_STATIC_MATCH_ARM,
                "`static match` outside a generic context is not supported yet (its type could not be resolved to a single arm)",
                sm.span);
        }
        const outer_expected: TypeRef = this.state.expected_type;
        mut result_type: TypeRef = TypeRef::invalid();
        // During the symbolic (generic-template) check, type-check EVERY arm body - 
        // not just `arms[0]`.  Each concrete instantiation prunes the static match
        // to whichever arm matches its type and clones that arm's body; an unchecked
        // arm clones with an untyped receiver and un-stashed nested generic calls,
        // so a spec landing on a non-first arm (`String<A>::try_push<u8>` -> the `u8`
        // arm) can't resolve its inner call (codegen E0636 / wrong-spec miscompile).
        // A concrete (already-pruned) static match has exactly one arm, so the
        // non-symbolic path checks only `arms[0]` exactly as before.
        const n_arms: i64 = if (this.state.in_symbolic_check) { sm.arms.length } else { 1 };
        const sink: DiagnosticSink* = this.ctx.diagnostics;
        for (mut ai: i64 = 0; ai < n_arms; ai++) {
            const arm: StaticMatchArmNode* = sm.arms[ai];
            if (arm == null || arm.body == null) { continue; }
            // Narrow this arm to its concrete type (symbolic-only, eligible arms)
            // so `item`/method calls resolve concretely and hover sees the real
            // type.  Arms after the first are still walked (stamping their bodies
            // for correct monomorphization) but with diagnostics suppressed - the
            // first arm is the representative one for reporting, and the concrete
            // re-check of later arms would otherwise surface errors for arms this
            // instantiation may never select.
            const nsave: i64 = this.narrow_static_match_arm(sm.scrutinee, arm);
            const suppress: boolean = ai > 0 && sink != null;
            if (suppress) { sink.begin_suppress(); }
            mut arm_result: TypeRef = TypeRef::invalid();
            if ((arm.body as ASTNode*).kind == NodeKind::BlockStatement) {
                const block: BlockStmtNode* = arm.body as BlockStmtNode*;
                const last_idx: i64 = block.statements.length - 1;
                for (mut j: i64 = 0; j < block.statements.length; j++) {
                    if (j == last_idx && outer_expected.is_valid()) { this.state.expected_type = outer_expected; }
                    this.dispatch_stmt(block.statements[j]);
                    if (j == last_idx) { this.state.expected_type = outer_expected; }
                }
                if (block.statements.length > 0) {
                    const last: StatementNode* = block.statements[block.statements.length - 1];
                    if ((last as ASTNode*).kind == NodeKind::ExpressionStatement) {
                        const es: ExprStmtNode* = last as ExprStmtNode*;
                        if (es.expression != null && es.expression.has_resolved_type()) { arm_result = es.expression.resolved_type; }
                    }
                }
            } else {
                this.dispatch_stmt(arm.body);
            }
            if (suppress) { sink.end_suppress(); }
            this.scopes.restore_scope(nsave);
            // The static match's type is the first arm's (all arms must agree).
            if (ai == 0) { result_type = arm_result; }
        }
        this.state.expected_type = outer_expected;
        if (outer_expected.is_valid()) { return outer_expected; }
        return result_type;
    }

    /// During the symbolic generic-body check, narrow a `static match (T)` arm to
    /// its concrete type for the duration of that arm's body walk.  When the
    /// scrutinee is a bare generic param (`T`) and the arm lists exactly one
    /// concrete type pattern (`String => ...`), every in-scope local typed
    /// exactly `T` is rebound to that concrete type, so member/method resolution
    /// - and hover - sees the real type instead of an abstract param.  The
    /// rebinding is logged on the scope undo log; the caller restores the
    /// returned checkpoint after the body.  A no-op returning the checkpoint
    /// unchanged when not eligible (non-symbolic walk, multi-type / wildcard arm,
    /// non-generic scrutinee, or a still-generic arm pattern).
    narrow_static_match_arm(mut &this, scrutinee: TypeAnnotation*,
                            arm: StaticMatchArmNode*) -> i64 {
        const save: i64 = this.scopes.save_scope();
        if (!this.state.in_symbolic_check) { return save; }
        if (scrutinee == null || arm == null) { return save; }
        if (arm.type_patterns.length != 1) { return save; }
        if (this.ctx.type_resolver == null || this.arena == null) { return save; }

        mut rc: ResolutionContext = ResolutionContext::new("");
        // The scrutinee annotation is written at the `static match`, inside a
        // body (spec §8.2l).
        this.symbolic.symbolic_bind_params(&rc);
        const scrut_ref: TypeRef = this.ctx.type_resolver.resolve(scrutinee, &rc);
        if (!scrut_ref.is_valid()) { return save; }
        const st: Type* = this.arena.lookup(scrut_ref.id);
        if (st == null) { return save; }
        if (st.kind != TypeKind::GenericParam) { return save; }

        const arm_ref: TypeRef = this.ctx.type_resolver.resolve(arm.type_patterns[0], &rc);
        if (!arm_ref.is_valid() || this.arena.contains_generic_param(arm_ref)) { return save; }

        // Collect locals typed exactly as the scrutinee param first, then rebind:
        // register_local_with_mut mutates `state.locals`, so it must not run while
        // the entry iterator is live.
        mut keys: u32[] = [];
        mut it: HashMapIter<u32, TypeRef> = this.state.locals.iter();
        loop {
            match (it.next()) {
                Option::Some(pair) => {
                    if (pair.second.id == scrut_ref.id) { keys.push(pair.first); }
                }
                Option::None => { break; }
            }
        }
        for (mut i: i64 = 0; i < keys.length; i++) {
            const nm: SymbolStr = SymbolStr::from_id(keys[i]);
            const is_mut: boolean = this.scopes.local_is_mutable(nm);
            this.scopes.register_local_with_mut(nm, arm_ref, is_mut);
        }
        keys.drop();
        return save;
    }

    /// `Poll::Ready(value)`, typed as `poll_out`. Mirrors the wrapper the async
    /// lowering puts on every `return` it moves into a `poll` body.
    make_poll_ready(&this, value: ExpressionNode*, poll_out: TypeRef,
                    span: SourceSpan) -> ExpressionNode* {
        mut scope: ScopeResolutionNode* = new ScopeResolutionNode(
            this.async_lower.poll_identity(), this.intern.intern("Ready"), span);
        scope.set_synthesized_ref(poll_out, this.ctx.decl_index.def_of(poll_out, this.ctx.type_arena));
        mut call: CallExprNode* = new CallExprNode(scope as ExpressionNode*, span);
        call.add_argument(value);
        call.set_resolved_type(poll_out);
        return call as ExpressionNode*;
    }

    /// `func`'s Output if it is the `poll` an `async fn` was lowered into,
    /// otherwise invalid.
    ///
    /// The lowering moves the async function's own statements into this body, so
    /// a construct whose legality depends on the enclosing return type — `?` —
    /// must be judged against what the source function returned. Identified by
    /// the three marks `declare` puts on the generated method (a synthesized
    /// body, `Future`'s `poll`), never by shape alone: a hand-written
    /// `-> Poll<Result<..>>` is a real function and keeps the ordinary rule.
    async_poll_output_of(&this, func: FunctionDeclNode*) -> TypeRef {
        if (func == null) { return TypeRef::invalid(); }
        if (!func.is_synthesized_body) { return TypeRef::invalid(); }
        // `origin_trait` is the trait's identity, so the comparison is against
        // the declaration the language means by `Future` - a user trait that
        // happens to share the leaf is not it.
        const future_id: DefId = this.ctx.generic_registry.wellknown(LangItem::Future);
        if (!future_id.is_valid() || !func.origin_trait.equals(future_id)) { return TypeRef::invalid(); }
        if (!func.name.equals(this.intern.intern("poll"))) { return TypeRef::invalid(); }
        // Read the Output off `Poll::Ready`'s payload rather than the return
        // type's generic argument: once monomorphization has specialized it,
        // `Poll<Output>` is a plain enum with no instantiation left to peel.
        // The enum is the language's `Poll` by its declaration's identity
        // (a specialized enum carries its template as `generic_base`), and
        // `Ready` is read inside a type known to declare it.
        const e: Type* = this.types.unwrap_to_enum(func.resolved_return_type);
        if (e == null || e.kind != TypeKind::Enum) { return TypeRef::invalid(); }
        const et: EnumType* = e as EnumType*;
        mut decl: EnumType* = et;
        if (et.generic_base.is_valid()) {
            const base: Type* = this.arena.lookup(et.generic_base.id);
            if (base != null && base.kind == TypeKind::Enum) { decl = base as EnumType*; }
        }
        const poll_id: SymbolStr = this.async_lower.poll_identity();
        if (!poll_id.is_valid() || !decl.qualified_name.equals(poll_id)) { return TypeRef::invalid(); }
        const ready: EnumVariantInfo* = et.get_variant(this.intern.intern("Ready"));
        if (ready == null || ready.payload_types.length != 1) { return TypeRef::invalid(); }
        return ready.payload_types[0];
    }

    /// 1 when `ty` is the language's `Result`, 2 when it is its `Option`, 0
    /// otherwise - by the identity each declaration claimed
    /// (`GenericRegistry::wellknown`), never by the variants an enum spells:
    /// `type enum Outcome { Ok(i32); Err(i32); }` is another enum, and `?` on
    /// it is refused as on any other.  An instantiation answers as its
    /// template, resolved (a specialized enum carries its `generic_base`) or
    /// not.
    enum_try_shape(&this, ty: TypeRef) -> i32 {
        mut e: Type* = this.types.unwrap_to_enum(ty);
        if (e == null) {
            const inst: InstantiatedType* = this.types.peel_to_instantiation(ty);
            if (inst != null && !inst.has_resolved_type()) { e = this.types.unwrap_to_enum(inst.generic_base); }
        }
        if (e == null || e.kind != TypeKind::Enum) { return 0; }
        mut et: EnumType* = e as EnumType*;
        if (et.generic_base.is_valid()) {
            const base: Type* = this.arena.lookup(et.generic_base.id);
            if (base != null && base.kind == TypeKind::Enum) { et = base as EnumType*; }
        }
        const result_id: DefId = this.ctx.generic_registry.wellknown(LangItem::Result);
        if (result_id.is_valid() && et.qualified_name.equals(this.ctx.defs.path_of(result_id))) { return 1; }
        const option_id: DefId = this.ctx.generic_registry.wellknown(LangItem::Option);
        if (option_id.is_valid() && et.qualified_name.equals(this.ctx.defs.path_of(option_id))) { return 2; }
        return 0;
    }

    /// `ret_ty` is the ENCLOSING FUNCTION's return type, not the operand's: the
    /// `Err`/`None` this builds is the value returned on the error arm, so that
    /// is the enum its scope segment names. The two agree on shape (the caller
    /// rejects a mismatch) but not necessarily on instantiation, and only the
    /// returned one is what the synthesized reference refers to.
    build_try_desugar(mut &this, node: TryExprNode*, is_result: boolean,
                      operand_ty: TypeRef, ret_ty: TypeRef) -> MatchExprNode* {
        const span: SourceSpan = node.span;
        this.state.try_counter += 1;
        const enum_name: SymbolStr = this.intern.intern(if (is_result) { "Result" } else { "Option" });
        const ok_variant: SymbolStr = this.intern.intern(if (is_result) { "Ok" } else { "Some" });
        const err_variant: SymbolStr = this.intern.intern(if (is_result) { "Err" } else { "None" });
        const ok_bind: SymbolStr = this.intern.intern(fmt::format("__cryo_try_%u", this.state.try_counter));

        mut match_expr: MatchExprNode* = new MatchExprNode(node.operand, span);
        mut ok_pat: EnumPatternNode* = new EnumPatternNode(span);
        ok_pat.set_enum_name(enum_name);
        ok_pat.set_variant_name(ok_variant);
        ok_pat.set_res(Res::Def(this.ctx.decl_index.def_of(operand_ty, this.ctx.type_arena)));
        // Both bindings are declared here, after name resolution ran, so each
        // takes its identity from the allocator and every use this builds
        // carries it: a later pass tracking the payload's move asks by it.
        const ok_sym: SymbolID = this.resolver.alloc_synthetic_binding();
        const ok_pb: PatternBinding* = new PatternBinding {
            name: ok_bind, span: span, sym_id: ok_sym,
            resolved_type: TypeRef::invalid()
        };
        ok_pat.add_element(PatternElement::Binding(ok_pb));
        mut ok_arm: MatchArmNode* = new MatchArmNode(span);
        ok_arm.add_pattern(ok_pat as PatternNode*);
        const ok_ident: IdentifierNode* = new IdentifierNode(ok_bind, span);
        ok_ident.set_res(Res::Local(ok_sym));
        const ok_stmt: ExprStmtNode* = new ExprStmtNode(ok_ident as ExpressionNode*, span);
        mut ok_block: BlockStmtNode* = new BlockStmtNode(span);
        ok_block.add_statement(ok_stmt as StatementNode*);
        ok_arm.set_body(ok_block as StatementNode*);
        match_expr.add_arm(ok_arm);

        mut err_pat: EnumPatternNode* = new EnumPatternNode(span);
        err_pat.set_enum_name(enum_name);
        err_pat.set_variant_name(err_variant);
        err_pat.set_res(Res::Def(this.ctx.decl_index.def_of(operand_ty, this.ctx.type_arena)));
        mut ret_value: ExpressionNode* = null;
        if (is_result) {
            const err_bind: SymbolStr = this.intern.intern(fmt::format("__cryo_try_err_%u", this.state.try_counter));
            const err_sym: SymbolID = this.resolver.alloc_synthetic_binding();
            const err_pb: PatternBinding* = new PatternBinding {
                name: err_bind, span: span, sym_id: err_sym,
                resolved_type: TypeRef::invalid()
            };
            err_pat.add_element(PatternElement::Binding(err_pb));
            mut err_scope: ScopeResolutionNode* = new ScopeResolutionNode(enum_name, err_variant, span);
            err_scope.set_synthesized_ref(ret_ty, this.ctx.decl_index.def_of(ret_ty, this.ctx.type_arena));
            mut err_call: CallExprNode* = new CallExprNode(err_scope as ExpressionNode*, span);
            const err_ident: IdentifierNode* = new IdentifierNode(err_bind, span);
            err_ident.set_res(Res::Local(err_sym));
            err_call.add_argument(err_ident as ExpressionNode*);
            ret_value = err_call as ExpressionNode*;
        } else {
            mut bare_err: ScopeResolutionNode* =
                new ScopeResolutionNode(enum_name, err_variant, span);
            bare_err.set_synthesized_ref(ret_ty, this.ctx.decl_index.def_of(ret_ty, this.ctx.type_arena));
            ret_value = bare_err as ExpressionNode*;
        }
        // Inside the `poll` an `async fn` was lowered into, every `return`
        // carries `Poll::Ready(...)`. The lowering wrapped the returns it could
        // see, but this desugar is built after it ran — a `?` in a GENERIC body
        // can only be shaped once its operand's `Result`/`Option` type is
        // concrete, which is after specialization — so it wraps its own.
        if (this.state.async_poll_output.is_valid()) {
            ret_value = this.make_poll_ready(ret_value, this.state.return_type, span);
        }
        mut err_arm: MatchArmNode* = new MatchArmNode(span);
        err_arm.add_pattern(err_pat as PatternNode*);
        const ret_stmt: ReturnStmtNode* = new ReturnStmtNode(ret_value, span);
        mut err_block: BlockStmtNode* = new BlockStmtNode(span);
        err_block.add_statement(ret_stmt as StatementNode*);
        err_arm.set_body(err_block as StatementNode*);
        match_expr.add_arm(err_arm);
        return match_expr;
    }

    resolve_try_expr(mut &this, node: TryExprNode*) -> TypeRef {
        // The operand is resolved on EVERY visit, including one that reuses an
        // existing desugar: call-specialization and dispatch annotation both
        // walk `operand` (never `desugared`), so a specialization whose operand
        // went unresolved here reaches codegen with an unresolvable call.
        const saved_expected: TypeRef = this.state.expected_type;
        this.state.expected_type = TypeRef::invalid();
        const operand_type: TypeRef = this.resolve_expr(node.operand);
        this.state.expected_type = saved_expected;

        // Already desugared: that desugar IS the expression from here on, and it
        // is kept rather than rebuilt — the async lowering has since rewritten
        // it in place (awaits hoisted out, `return`s wrapped in `Poll::Ready`,
        // bindings alpha-renamed), and a fresh one would throw all of that away.
        // Re-resolving it re-derives the types a specialization clone dropped.
        if (node.desugared != null) { return this.resolve_expr(node.desugared); }

        if (!operand_type.is_valid()) { return TypeRef::invalid(); }

        const operand_shape: i32 = this.enum_try_shape(operand_type);
        if (operand_shape == 0) {
            if (this.symbolic.symbolic_type_unresolved(operand_type)) { return TypeRef::invalid(); }
            const ot: Type* = this.arena.lookup(operand_type.id);
            const disp: string = if (ot != null) { this.arena.format_display(ot) } else { "?" };
            this.ctx.emit_error_at(ErrorCode::E0234_INVALID_TRY_OPERAND,
                fmt::format("the `?` operator requires a `Result` or `Option` value, but the operand has type '%s'", disp), node.span);
            return TypeRef::invalid();
        }
        // Inside a lowered `poll`, the async function's Output is what `?`
        // propagates out of; everywhere else it is the function's own return.
        const fn_ret: TypeRef = if (this.state.async_poll_output.is_valid()) {
            this.state.async_poll_output
        } else { this.state.return_type };
        const fn_shape: i32 = this.enum_try_shape(fn_ret);
        if (fn_shape != operand_shape) {
            // A return type that still mentions an abstract parameter cannot
            // settle this. An `async` trait default body is walked once with its
            // return type ALREADY rewritten to the future it lowers to
            // (`This::…Fut`), before the walk that sees the declared output, and
            // judging a `?` against the future would reject every one of them.
            // Deferring is what the shape check does with any not-yet-concrete
            // type — the concrete walk is where a `?` can be shaped at all.
            if (this.arena.contains_generic_param(fn_ret)) { return TypeRef::invalid(); }
            if (this.symbolic.symbolic_type_unresolved(fn_ret)
                    || this.symbolic.symbolic_type_unresolved(operand_type)) {
                return TypeRef::invalid();
            }
            const want: string = if (operand_shape == 1) { "Result" } else { "Option" };
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0235_TRY_OUTSIDE_RESULT_FN,
                fmt::format("the `?` operator can only be used in a function that returns `%s`", want));
            diag = diag.at_with_label(node.span, fmt::format("propagates a `%s`, but the enclosing function doesn't return one", want));
            const ann_span: SourceSpan = annotation_span(this.state.return_type_ann);
            if (ann_span.has_location()) {
                const ret_repl: string = this.arena.resolve_display_name_short(operand_type.id);
                diag = diag.suggest(Suggestion::single(ann_span, ret_repl, fmt::format("change the return type to `%s`", ret_repl), Applicability::HasPlaceholders));
            }
            this.ctx.emit_diagnostic(diag);
            return TypeRef::invalid();
        }
        mut desugared: MatchExprNode* = this.build_try_desugar(node, operand_shape == 1, operand_type, fn_ret);
        node.set_desugared(desugared as ExpressionNode*);
        return this.resolve_expr(desugared as ExpressionNode*);
    }

    /// Resolve a struct/union/class literal's TYPE through the SAME canonical path
    /// a type ANNOTATION uses - `instantiate_for_module`, exactly as `resolve()`
    /// does for `x as Foo<Args>`.  ONE resolution authority: a `Foo<Args> {}`
    /// literal denotes the same canonical TypeID as the annotation `Foo<Args>`, so
    /// `return NonNull<U> {}` matches its declared `-> NonNull<U>` by identity - no
    /// name-lookup that races spec registration.  Fires ONLY when every arg
    /// resolves CONCRETE: an abstract arg (`Pair<T, V>` in a template body, or an
    /// unresolved method generic) would materialize a `Foo<?>` instantiation that
    /// GenericValidation flags (E0900), so those return invalid and the caller
    /// keeps the demand-free name-based path.
    resolve_struct_literal_type(mut &this, lit: StructLiteralNode*) -> TypeRef {
        if (this.ctx.type_resolver == null || this.ctx.generic_registry == null
                || lit.generic_args.length == 0) {
            return TypeRef::invalid();
        }
        // The BASE comes from the answer the name layer wrote on this node, not
        // from matching its spelling against the index.  The stamp is a
        // canonical name that already accounts for the imports of the module
        // that WROTE the literal; the spelling is the same question asked with
        // strictly less information, and the tier that ends its cascade is keyed
        // by bare leaf and so answers from any module in the program.
        //
        // A `Res` names a DEFINITION, so it is exactly the base a template is
        // registered under - and unlike the spelling it cannot be confused with
        // a specialization, because there is no way to write one in it.
        mut base_ref: TypeRef = TypeRef::invalid();
        // Through the door: a struct literal's type is written where the
        // literal is, and the name layer stamped every one in the corpus.
        match (lit.res.require("sema:struct literal base")) {
            Res::Def(q) => { base_ref = this.ctx.decl_index.type_of_def(q); }
            // A literal's type is a struct, so a primitive stamp here is
            // not a template to look up.  Named rather than folded into the
            // wildcard: the primitive answer is new, and a reader must be
            // able to see it was considered.
            Res::PrimTy(_) => { }
            _              => { }
        }
        if (!base_ref.is_valid()) { return TypeRef::invalid(); }
        // Demand-FREE, and answered by the SAME primitive the call resolver uses
        // for a scope qualifier: one node carries a base and written arguments,
        // and so does the other.  Two copies would drift on how arguments are
        // homed and resolve one source text to two different slots.
        //
        // The literal only REFERENCES the type; its monomorphization demand comes
        // from the declared type it flows into.  An argument that mentions a
        // generic parameter yields the template-internal instantiation, which is
        // what the literal denotes inside a template body and what specialization
        // rewrites - falling back to the bare base would erase the arguments, and
        // a type built from it mentions no parameter at all, so specialization
        // would leave it untouched.
        return this.calls.resolve_generic_scope_type(base_ref, lit.generic_args,
                                                     lit.span);
    }

    resolve_struct_literal(mut &this, lit: StructLiteralNode*) -> TypeRef {
        mut struct_ref: TypeRef = TypeRef::invalid();
        // Monomorphization records a specialized literal's instantiation as the
        // arena id itself, which IS `(definition, arguments)` already resolved.
        // Reading it is the whole answer.  Deriving one from the spelling
        // instead would ask the same question from strictly less information:
        // the spelling deliberately keeps what the source wrote, so it names a
        // definition and can never name a specialization.
        if (lit.resolved_type.is_valid()) { struct_ref = lit.resolved_type; }
        // The pair answers next: a base named by the stamp plus this node's own
        // substituted arguments, keyed through the arena's canonical
        // instantiation slot.  It runs BEFORE any name is minted because it is
        // the same fact without the round trip through a string - and a mangled
        // spec name minted from an already-mangled spelling names nothing at
        // all, which is what made this lookup miss three times in four.
        if (!struct_ref.is_valid() && lit.generic_args.length > 0) {
            struct_ref = this.resolve_struct_literal_type(lit);
        }
        // A literal with no arguments has no pair to resolve, so neither branch
        // above applies and the stamp is the whole answer: it names one
        // definition, canonically, accounting for the writing module's imports.
        // A C-imported aggregate is stamped like any other: its alias-qualified
        // spelling is the name it was declared under, whole, and the name layer
        // reads it from the writing module's scope.  There is deliberately no
        // spelling lookup beneath the stamp - a literal the stamp makes no claim
        // for names nothing, and a lookup by its spelling would answer from
        // whichever module owns the leaf.
        if (!struct_ref.is_valid()) {
            struct_ref = this.types.spelling_type(lit.res);
        }
        mut struct_t: Type* = if (struct_ref.is_valid()) { this.arena.lookup(struct_ref.id) } else { null };
        if (struct_t != null && struct_t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = struct_t as InstantiatedType*;
            if (inst.has_resolved_type()) { struct_t = this.arena.lookup(inst.resolved_type.id); }
        }

        // The literal's TYPE is the canonical default instantiation for a bare
        // all-default generic (`String { .. }` denotes `String<GlobalAlloc>`),
        // matching how a bare `String` annotation resolves - so the literal shares
        // ONE TypeID with its declared type.  `struct_ref`/`struct_t` stay raw
        // below for the template's field lookup, visibility, and arity checks.
        mut lit_type: TypeRef = struct_ref;
        if (this.ctx.type_resolver != null) {
            lit_type = this.ctx.type_resolver.canonicalize_default_generic_type(struct_ref);
        }

        const saved_expected: TypeRef = this.state.expected_type;
        for (mut i: i64 = 0; i < lit.field_inits.length; i++) {
            const field_init: FieldInit = lit.field_inits[i];
            const value_expr: ExpressionNode* = field_init.value;
            mut field_type: TypeRef = TypeRef::invalid();
            // The field this initializer names, by its coordinates in the
            // literal's type - a class's base fields included, walked
            // derived-first as `check_field_access` walks them - recorded
            // on the initializer so codegen stores at those coordinates.
            // A struct literal names a field directly, so it obeys the same
            // module-scoped visibility as a `.field` access (E0353), asked of
            // the entry this one walk found.
            mut f_depth: i64 = -1;
            mut f_index: i64 = -1;
            if (struct_t != null
                && (struct_t.kind == TypeKind::Struct || struct_t.kind == TypeKind::Class)) {
                mut fl: FieldLookup = FieldLookup::none();
                const found: TypeCheckResult = this.checker.check_field_access(
                    struct_ref, field_init.field_name, &fl);
                if (found.success && found.result_type.is_valid()) { field_type = found.result_type; }
                if (fl.found()) {
                    f_depth = fl.depth;
                    f_index = fl.index;
                    this.member.enforce_field_visibility(fl.field, fl.owner, field_init.field_name, field_init.span);
                }
            }
            // A literal of the generic OWNER inside its own body (`String {
            // buffer: RawBuffer::new(), .. }` in `String<A>::new`): the arena
            // type of a template holds no fields, so the field's abstract type
            // is read off the template's AST, as `this.<field>` reads it.  The
            // value then has an expected type to bind its own owner arguments
            // from; without one a generic-owner static call in the field
            // position stashes nothing and is never pinned.
            if (!field_type.is_valid()) {
                mut o_index: i64 = -1;
                field_type = this.symbolic.symbolic_resolve_owner_field(struct_ref, field_init.field_name, &o_index);
                if (field_type.is_valid()) { f_depth = 0; f_index = o_index; }
            }
            if (f_index >= 0) {
                lit.field_inits[i].pin = MemberPin::Field(f_depth, f_index);
                lit.field_inits[i].pin_carried = false;
            }
            if (value_expr == null) { field_type = TypeRef::invalid(); }
            if (field_type.is_valid()) { this.state.expected_type = field_type; }
            else { this.state.expected_type = TypeRef::invalid(); }
            const value_type: TypeRef = this.resolve_expr(value_expr);
            if (field_type.is_valid() && value_type.is_valid() && value_expr != null) {
                const skip: boolean = this.types.contains_generic_param(value_type) || this.types.contains_generic_param(field_type);
                if (!skip && !this.checker.can_assign(value_type, field_type)) {
                    const field_name_str: string = this.intern.resolve(field_init.field_name);
                    this.diag.emit_type_mismatch_with_value(
                        ErrorCode::E0200_TYPE_MISMATCH, value_expr.span, field_type, value_type,
                        fmt::format("field `%s` expects this type", field_name_str), SourceSpan::none(), value_expr);
                }
            }
        }
        this.state.expected_type = saved_expected;

        // Union literal: exactly one field may be initialized (an untagged
        // union overlaps all fields, so a literal names the single active
        // member).  The per-field type check above already validated that
        // member's value; skip the struct "all fields required" (E0355) check.
        mut is_union_lit: boolean = false;
        if (struct_t != null && struct_t.kind == TypeKind::Struct) {
            is_union_lit = (struct_t as StructType*).is_union;
        }
        if (is_union_lit) {
            if (lit.field_inits.length != 1) {
                const un_name: string = this.intern.resolve(this.intern.intern(this.arena.format_display(struct_t)));
                mut udiag: Diagnostic = Diagnostic::error(ErrorCode::E0363_UNION_LITERAL_ARITY,
                    fmt::format("union literal of `%s` must initialize exactly one field, found %lld",
                        un_name, lit.field_inits.length));
                udiag = udiag.at_with_label(lit.span,
                    if (lit.field_inits.length == 0) { "no field initialized" } else { "more than one field initialized" });
                this.ctx.emit_diagnostic(udiag);
            }
            return lit_type;
        }

        if (struct_t != null && (struct_t.kind == TypeKind::Struct || struct_t.kind == TypeKind::Class)) {
            const empty_fields: FieldInfo[] = [];
            mut fields_ptr: &FieldInfo[] = &empty_fields;
            mut is_complete: boolean = false;
            if (struct_t.kind == TypeKind::Struct) { const st: StructType* = struct_t as StructType*; fields_ptr = &st.fields; is_complete = st.is_complete; }
            else { const ct: ClassType* = struct_t as ClassType*; fields_ptr = &ct.fields; is_complete = ct.is_complete; }
            if (is_complete && fields_ptr.length > 0) {
                mut missing_names: SymbolStr[] = [];
                for (mut k: i64 = 0; k < fields_ptr.length; k++) {
                    const decl_name: SymbolStr = fields_ptr[k].name;
                    mut covered: boolean = false;
                    for (mut fi: i64 = 0; fi < lit.field_inits.length; fi++) {
                        if (lit.field_inits[fi].field_name.id == decl_name.id) { covered = true; break; }
                    }
                    if (covered) { continue; }
                    // A literal sets every field, the ones it leaves to their
                    // defaults included, so one the writer may not reach
                    // refuses the literal whether it is named or not.
                    this.member.enforce_field_visibility(&fields_ptr[k], struct_t, decl_name, lit.span);
                    // An omitted field carrying a `= default` is filled in: clone the
                    // default, resolve + type-check it, and append it as a synthetic
                    // field-init so codegen materializes it.  Only an omitted field
                    // WITHOUT a default is a missing-field error (E0355).
                    if (fields_ptr[k].has_default()) {
                        this.fill_field_default(lit, &fields_ptr[k], k, decl_name);
                    } else {
                        missing_names.push(decl_name);
                    }
                }
                if (missing_names.length > 0) {
                    mut names_str: string = "";
                    const cap: i64 = if (missing_names.length < 4) { missing_names.length } else { 4 };
                    for (mut i: i64 = 0; i < cap; i++) {
                        const nm: string = this.intern.resolve(missing_names[i]);
                        if (i == 0) { names_str = fmt::format("`%s`", nm); } else { names_str = fmt::format("%s, `%s`", names_str, nm); }
                    }
                    if (missing_names.length > cap) { names_str = fmt::format("%s, and %lld more", names_str, missing_names.length - cap); }
                    const ty_name: string = this.intern.resolve(this.intern.intern(this.arena.format_display(struct_t)));
                    mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0355_MISSING_FIELD_INIT,
                        fmt::format("missing field%s %s in initializer of `%s`",
                            if (missing_names.length == 1) { "" } else { "s" }, names_str, ty_name));
                    diag = diag.at_with_label(lit.span,
                        if (missing_names.length == 1) { fmt::format("missing field %s", names_str) } else { fmt::format("missing fields %s", names_str) });
                    this.ctx.emit_diagnostic(diag);
                }
            }
        }
        return lit_type;
    }

    /// Materialize a struct field's `= default` at a construction site that omits
    /// it: clone the default (each construction evaluates its own copy), resolve
    /// and type-check it against the field type (E0200 on mismatch), then append
    /// it to the literal as a synthetic field-init so codegen fills the field.
    /// The default is a standalone expression - it never sees the other fields.
    fill_field_default(mut &this, lit: StructLiteralNode*, field: FieldInfo*,
                       index: i64, name: SymbolStr) -> void {
        if (field.default_value == null) { return; }
        mut cloner: ASTCloner = ASTCloner();
        const cloned: ExpressionNode* = cloner.clone_expr(field.default_value);
        if (cloned == null) { return; }
        const field_type: TypeRef = field.field_type;
        const saved: TypeRef = this.state.expected_type;
        if (field_type.is_valid()) { this.state.expected_type = field_type; }
        else { this.state.expected_type = TypeRef::invalid(); }
        const value_type: TypeRef = this.resolve_expr(cloned);
        this.state.expected_type = saved;
        if (field_type.is_valid() && value_type.is_valid()) {
            const skip: boolean = this.types.contains_generic_param(value_type)
                || this.types.contains_generic_param(field_type);
            if (!skip && !this.checker.can_assign(value_type, field_type)) {
                const nm: string = this.intern.resolve(name);
                this.diag.emit_type_mismatch_with_value(
                    ErrorCode::E0200_TYPE_MISMATCH, cloned.span, field_type, value_type,
                    fmt::format("field `%s` default expects this type", nm), SourceSpan::none(), cloned);
            }
        }
        lit.add_field_init(FieldInit {
            field_name: name,
            value:      cloned,
            span:        lit.span,
            pin:         MemberPin::Field(0, index),
            pin_carried: false,
        });
    }

    /// Whether `A::B` reaches B THROUGH the type `A`, as opposed to through a
    /// module that merely shares its name.
    ///
    /// One qualifier can name both: a module `Buffer` declaring a struct
    /// `Buffer` is the shape that exposed this.  Answering "it is the type"
    /// without asking whether `B` is a member of it types the whole path as the
    /// TYPE, so a module-level `const` reached this way arrives as a struct -
    /// and nothing complains until the value is USED, where it surfaces as
    /// `Buffer does not implement BitOr`, naming neither the constant nor the
    /// module nor anything the author can act on.
    ///
    /// A struct or class carries no associated constants, only `methods`, so a
    /// member that names no method of it cannot be reached through the type and
    /// the qualifier must be the module.
    ///
    /// Every other kind answers yes unchanged.  An ENUM especially: a variant's
    /// type IS the enum, and `validate_enum_scope_member` owns the "no such
    /// variant" diagnostic, which has to stay reachable.
    scope_member_binds_type(mut &this, ty: TypeRef, scope: ScopeResolutionNode*) -> boolean {
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return true; }
        if (t.kind == TypeKind::Struct) {
            const st: StructType* = t as StructType*;
            return st.get_method(scope.member_name) != null;
        }
        if (t.kind == TypeKind::Class) {
            const ct: ClassType* = t as ClassType*;
            return ct.get_method(scope.member_name) != null;
        }
        return true;
    }

    /// The function type of a STATIC method named `ty::member`, or invalid when
    /// `ty` names no struct/class, the member is not one of its methods, or the
    /// method takes a receiver - an instance method is not a value on its own.
    /// The stored `function_type` already excludes the receiver and is interned
    /// through the same `get_function` an annotation goes through, so it is the
    /// SAME id a `(A) -> R` annotation resolves to.
    scope_static_method_type(mut &this, ty: TypeRef, scope: ScopeResolutionNode*) -> TypeRef {
        if (!ty.is_valid()) { return TypeRef::invalid(); }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return TypeRef::invalid(); }
        mut m: MethodInfo* = null;
        if (t.kind == TypeKind::Struct)     { m = (t as StructType*).get_method(scope.member_name); }
        else if (t.kind == TypeKind::Class) { m = (t as ClassType*).get_method(scope.member_name); }
        else { return TypeRef::invalid(); }
        if (m == null || !m.is_static) { return TypeRef::invalid(); }
        return m.function_type;
    }

    resolve_scope_resolution(mut &this, scope: ScopeResolutionNode*) -> TypeRef {
        // The qualifier's type is the resolver's own answer for this segment,
        // a primitive included.  A stamp that makes no type claim names a
        // module or a type parameter, and the index holds no type under
        // either spelling; the module lane below is a different question.
        const found: TypeRef = this.types.scope_qualifier_type(scope);
        // `Type::static_method` as a VALUE is the method, not the type.  The
        // type-binding branch below answers "does this path name something the
        // type owns" - what an enum variant needs - and a static method satisfies
        // it too, so the expression took its OWNER's type.  A callback handed out
        // that way arrived as a struct value with no signature to check against,
        // and the address codegen emitted for it was never the one sema had
        // described.
        const static_ft: TypeRef = this.scope_static_method_type(found, scope);
        if (static_ft.is_valid()) {
            // The owner's method table holds every declared method, a
            // refused signature's included, as `() -> ?`; the index holds
            // the refusal, and a value taken from it reports nothing more.
            if (this.calls.scope_callee_signature_refused(scope, false)) { return TypeRef::invalid(); }
            return this.calls.pin_scope_value_static_method(scope, found, static_ft);
        }
        if (found.is_valid() && this.scope_member_binds_type(found, scope)) {
            this.validate_enum_scope_member(found, scope);
            return this.calls.promote_to_expected_instantiation(found);
        }
        const scope_str: string = this.intern.resolve(scope.scope_name);
        const member_str: string = this.intern.resolve(scope.member_name);
        // The qualifier's stamp names the module, so the global's canonical
        // name is that module's name and the written member leaf.  That is the
        // answer: a leaf-keyed or namespace-suffix-matched retry answers from
        // whichever module registered last, so `syscall::FIONBIO` would take
        // `libc::FIONBIO`'s value and its type.
        const st_global: TypeRef = this.types.scope_global_type(scope);
        if (st_global.is_valid()) { return st_global; }
        // A qualified path in value position may name a FUNCTION.  Sema owned no
        // lookup for this shape, so codegen resolved it alone and unobserved:
        // a path naming a function that does not exist compiled, linked, and
        // called a null pointer at run time, and a `private` one was offered to
        // no gate.  Asking here is what gives both an owner.
        const fn_val: TypeRef = this.calls.lookup_scope_value_function(scope);
        if (fn_val.is_valid()) { return fn_val; }
        // Nothing declares this path.  `found` is invalid here by construction:
        // the only way past the type lookup at the top is for it to have missed.  Everything codegen can emit for a
        // ScopeResolution - type, global, enum variant, function - has now been
        // asked, so the miss is real rather than a lane sema does not model.
        if (this.state.in_symbolic_check) { return found; }
        // A module's function whose signature was refused where it was
        // written registered none, and the value reports nothing more.
        mut names_module: boolean = false;
        match (scope.require_scope_res("scope-value owner kind")) {
            Res::Def(_) => { names_module = true; }
            _           => { }
        }
        if (this.calls.scope_callee_signature_refused(scope, names_module)) { return found; }
        const path_str: string = fmt::format("%s::%s", scope_str, member_str);
        mut miss: Diagnostic = Diagnostic::error(ErrorCode::E0201_UNDEFINED_VARIABLE,
            fmt::format("cannot find value `%s` in this scope", path_str));
        miss = miss.at_with_label(scope.span, "not found in this scope");
        this.ctx.emit_diagnostic(miss);
        return found;
    }

    validate_enum_scope_member(mut &this, scope_ty: TypeRef, scope: ScopeResolutionNode*) -> void {
        const t: Type* = this.arena.lookup(scope_ty.id);
        if (t == null || t.kind != TypeKind::Enum) { return; }
        const et: EnumType* = t as EnumType*;
        const vi: i64 = et.variant_index(scope.member_name);
        if (vi >= 0) {
            // The ordinal is the same in the template and in every
            // instantiation, so a value's node carries it whichever the
            // qualifier resolved to here.
            scope.set_resolved_member(MemberPin::Variant(vi));
            return;
        }
        if (et.get_method(scope.member_name) != null) { return; }
        const enum_name: string = this.intern.resolve(scope.scope_name);
        const member:    string = this.intern.resolve(scope.member_name);
        mut cands: string[] = [];
        for (mut i: i64 = 0; i < et.variants.length; i++) { cands.push(this.intern.resolve(et.variants[i].name)); }
        const best: string = find_best_candidate(member, cands);
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0640_INVALID_ENUM_VARIANT_ACCESS,
            fmt::format("enum `%s` has no variant `%s`", enum_name, member));
        d = d.at_with_label(scope.span, "unknown variant");
        if (best.length() > 0) { d = d.help(fmt::format("did you mean `%s::%s`?", enum_name, best)); }
        this.ctx.diagnostics.emit(d);
    }

    resolve_new_expr(mut &this, new_expr: NewExprNode*) -> TypeRef {
        for (mut i: i64 = 0; i < new_expr.arguments.length; i++) { this.resolve_expr(new_expr.arguments[i]); }
        if (new_expr.has_struct_init()) { this.resolve_struct_literal(new_expr.struct_init); }
        if (new_expr.has_array_size()) { this.resolve_expr(new_expr.array_size); }
        // The name layer's own answer for the written type name, and the only
        // one: a primitive (`new u8[n]`, and `new int[100]` folded to `i32`)
        // is `PrimTy`, a declared type its definition.  A self-reference
        // inside the specialized body never reaches here: the substituter
        // records the instantiation's arena id on the node, and
        // `resolve_expr` returns that before this runs.
        const base: TypeRef = this.types.spelling_type(new_expr.res);
        if (!base.is_valid()) { return TypeRef::invalid(); }
        // `new E::V(..)`: the variant is found here, once, inside the enum the
        // stamp names, and its ordinal recorded for codegen to build from.  A
        // leaf the enum does not declare is refused as `E::V` in value
        // position is (`validate_enum_scope_member`).
        if (new_expr.has_variant()) {
            const e: Type* = this.types.unwrap_to_enum(base);
            if (e != null && e.kind == TypeKind::Enum) {
                const et: EnumType* = e as EnumType*;
                const vi: i64 = et.variant_index(new_expr.variant_name);
                if (vi >= 0) {
                    new_expr.set_resolved_member(MemberPin::Variant(vi));
                } else {
                    const enum_name: string = this.intern.resolve(new_expr.type_name);
                    const member: string = this.intern.resolve(new_expr.variant_name);
                    mut cands: string[] = [];
                    for (mut i: i64 = 0; i < et.variants.length; i++) { cands.push(this.intern.resolve(et.variants[i].name)); }
                    const best: string = find_best_candidate(member, cands);
                    mut d: Diagnostic = Diagnostic::error(ErrorCode::E0640_INVALID_ENUM_VARIANT_ACCESS,
                        fmt::format("enum `%s` has no variant `%s`", enum_name, member));
                    d = d.at_with_label(new_expr.span, "unknown variant");
                    if (best.length() > 0) { d = d.help(fmt::format("did you mean `%s::%s`?", enum_name, best)); }
                    this.ctx.diagnostics.emit(d);
                    return TypeRef::invalid();
                }
            }
        }
        return this.arena.get_pointer_to(base);
    }

    expected_is_dynamic_array(&this) -> boolean {
        if (!this.state.expected_type.is_valid()) { return false; }
        mut exp_t: Type* = this.arena.lookup(this.state.expected_type.id);
        if (exp_t != null && exp_t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = exp_t as InstantiatedType*;
            if (inst.has_resolved_type()) { exp_t = this.arena.lookup(inst.resolved_type.id); }
        }
        if (exp_t == null || exp_t.kind != TypeKind::Array) { return false; }
        return !(exp_t as ArrayType*).is_fixed();
    }

    /// The element count of a `[value; N]` repeat expression, or -1 when `N`
    /// is not a compile-time integer and the literal is therefore a dynamic
    /// array sized at run time.
    ///
    /// Folded through the same environment an array size in a type is folded
    /// through, so `T[N]` and `[v; N]` cannot disagree about `N` - a field and
    /// its initializer sharing one name for their length is the whole point of
    /// naming it.  No arena: a repeat count is fixed before TypeLowering, the
    /// same position an array annotation's size is fixed at.
    const_repeat_count(&this, arr: ArrayLiteralNode*) -> i64 {
        if (this.ctx == null) { return -1; }
        const ev: ConstEval = ConstEval::new(this.ctx.const_table, this.ctx.intern_table, null);
        mut n: i64 = 0;
        if (!ev.fold(arr.repeat_count_expr, &n)) { return -1; }
        if (n < 0) { return -1; }
        return n;
    }

    resolve_array_literal(mut &this, arr: ArrayLiteralNode*) -> TypeRef {
        mut elem_expected: TypeRef = TypeRef::invalid();
        if (this.state.expected_type.is_valid()) {
            mut exp_t: Type* = this.arena.lookup(this.state.expected_type.id);
            if (exp_t != null && exp_t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = exp_t as InstantiatedType*;
                if (inst.has_resolved_type()) { exp_t = this.arena.lookup(inst.resolved_type.id); }
            }
            if (exp_t != null && exp_t.kind == TypeKind::Array) { elem_expected = (exp_t as ArrayType*).element; }
        }
        const saved_expected: TypeRef = this.state.expected_type;
        mut elem_type: TypeRef = TypeRef::invalid();
        for (mut i: i64 = 0; i < arr.elements.length; i++) {
            if (elem_expected.is_valid()) { this.state.expected_type = elem_expected; }
            const t: TypeRef = this.resolve_expr(arr.elements[i]);
            this.state.expected_type = saved_expected;
            mut target: TypeRef = elem_expected;
            if (!target.is_valid()) { target = elem_type; }
            if (target.is_valid() && t.is_valid() && !this.checker.can_assign(t, target)) {
                this.diag.emit_type_mismatch_with_value(
                    ErrorCode::E0200_TYPE_MISMATCH, arr.elements[i].span, target, t,
                    "array elements must all have the same type", SourceSpan::none(), arr.elements[i]);
            }
            if (!elem_type.is_valid() && t.is_valid()) {
                elem_type = t;
                // The element was resolved UNDER `elem_expected` and checked
                // against it just above.  When the two differ only in which
                // pointee the compiler believes in - both one machine word,
                // no instruction between them - the literal IS an array of
                // the expected element type.  `null` is typed `void*` and is
                // valid in any pointer context, so `[null; 8]` written into a
                // `T*[8]` must be a `T*[8]`; typing it `void*[8]` makes the
                // enclosing assignment fail on a difference that does not
                // exist at runtime.
                //
                // Restricted to pointer-shaped on purpose: an element that
                // needs a VALUE change to reach the expected type (an integer
                // widening) must not adopt it, because the element emitter
                // stores what the element evaluated to - adopting there would
                // store a narrow value into a wide slot.
                if (elem_expected.is_valid() && !t.equals(elem_expected)
                        && this.checker.can_assign(t, elem_expected)
                        && this.checker.is_pointer_shaped(t)
                        && this.checker.is_pointer_shaped(elem_expected)) {
                    elem_type = elem_expected;
                }
            }
        }
        if (arr.repeat_count_expr != null) { this.resolve_expr(arr.repeat_count_expr); }
        if (!elem_type.is_valid() && this.state.expected_type.is_valid()
            && arr.elements.length == 0 && arr.repeat_count == 0 && arr.repeat_count_expr == null) {
            mut exp_t: Type* = this.arena.lookup(this.state.expected_type.id);
            if (exp_t != null && exp_t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = exp_t as InstantiatedType*;
                if (inst.has_resolved_type()) { exp_t = this.arena.lookup(inst.resolved_type.id); }
            }
            if (exp_t != null && exp_t.kind == TypeKind::Array) { return this.state.expected_type; }
        }
        if (elem_type.is_valid()) {
            mut size: i64 = arr.elements.length;
            if (arr.repeat_count > 0) {
                size = arr.repeat_count;
            } else if (arr.repeat_count_expr != null) {
                size = -1;
                if (!this.expected_is_dynamic_array()) {
                    const fill_count: i64 = this.const_repeat_count(arr);
                    if (fill_count >= 0) { size = fill_count; }
                }
            }
            if (this.state.expected_type.is_valid() && arr.repeat_count == 0 && arr.repeat_count_expr == null) {
                mut exp_t: Type* = this.arena.lookup(this.state.expected_type.id);
                if (exp_t != null && exp_t.kind == TypeKind::InstantiatedType) {
                    const inst: InstantiatedType* = exp_t as InstantiatedType*;
                    if (inst.has_resolved_type()) { exp_t = this.arena.lookup(inst.resolved_type.id); }
                }
                if (exp_t != null && exp_t.kind == TypeKind::Array) {
                    const exp_arr: ArrayType* = exp_t as ArrayType*;
                    if (!exp_arr.is_fixed() && this.checker.can_assign(elem_type, exp_arr.element)) {
                        return this.state.expected_type;
                    }
                }
            }
            return this.arena.get_array_of(elem_type, size);
        }
        return TypeRef::invalid();
    }

    /// Resolve a tuple literal, propagating the expected type per POSITION.
    ///
    /// Each element is resolved under ITS OWN expected type, mirroring what
    /// `resolve_array_literal` does per element and struct literals do per field.
    /// The per-position hint is what makes `return (1, 2)` from a `-> (i64, i64)`
    /// function type both elements as i64 rather than letting the second take the
    /// i32 default.
    ///
    /// Setting the hint per position also matters for what it PREVENTS: the
    /// enclosing hint must not survive into the elements.  `resolve_integer_literal`
    /// only adopts a hint whose kind is `Int`, so a leaked `(i64, i64)` tuple hint
    /// is ignored silently rather than diagnosed, and the element quietly falls
    /// back to i32.
    ///
    /// Because elements adopt their expected type directly, a correctly typed
    /// tuple needs no coercion downstream at all - which is what lets
    /// `check_compatibility` refuse to coerce tuples element-wise (see the note
    /// there; doing so miscompiles).  A genuinely mixed-width tuple - a
    /// non-literal `i32` element in an `i64` slot - is a hard E0200 here; the
    /// cast has to be written explicitly.
    resolve_tuple_literal(mut &this, tup: TupleLiteralNode*) -> TypeRef {
        mut exp_tup: TupleType* = null;
        if (this.state.expected_type.is_valid()) {
            mut exp_t: Type* = this.arena.lookup(this.state.expected_type.id);
            if (exp_t != null && exp_t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = exp_t as InstantiatedType*;
                if (inst.has_resolved_type()) { exp_t = this.arena.lookup(inst.resolved_type.id); }
            }
            if (exp_t != null && exp_t.kind == TypeKind::Tuple) {
                const cand: TupleType* = exp_t as TupleType*;
                // Arity must match, or the positions do not correspond and the
                // per-element hints would be nonsense; fall through untyped and
                // let the arity mismatch be diagnosed by the caller.
                if (cand.elements.length == tup.elements.length) { exp_tup = cand; }
            }
        }
        const saved_expected: TypeRef = this.state.expected_type;
        mut elem_types: TypeRef[] = [];
        for (mut i: i64 = 0; i < tup.elements.length; i++) {
            if (exp_tup != null) {
                this.state.expected_type = exp_tup.elements[i];
            } else {
                // No usable tuple hint: clear rather than leak the enclosing one.
                this.state.expected_type = TypeRef::invalid();
            }
            elem_types.push(this.resolve_expr(tup.elements[i]));
            this.state.expected_type = saved_expected;
        }
        return this.arena.get_tuple(elem_types);
    }


    // -- typeof priming --

    /// Resolve any `typeof(expr)` inside a type annotation and cache the operand's
    /// static type on the annotation (the TypeResolver hands it back later).
    prime_typeof_annotation(mut &this, ann: TypeAnnotation*) -> void {
        if (ann == null) { return; }
        match (ann) {
            TypeAnnotation::Typeof(to) => {
                if (!to.resolved.is_valid() && to.operand != null) {
                    const ty: TypeRef = this.resolve_expr(to.operand as ExpressionNode*);
                    if (ty.is_valid()) { to.resolved = ty; }
                }
            }
            TypeAnnotation::Pointer(p)   => { this.prime_typeof_annotation(p.inner); }
            TypeAnnotation::Reference(r) => { this.prime_typeof_annotation(r.inner); }
            TypeAnnotation::Array(a)     => { this.prime_typeof_annotation(a.element); }
            TypeAnnotation::Generic(g)   => {
                for (mut i: i64 = 0; i < g.args.length; i++) { this.prime_typeof_annotation(g.args[i]); }
            }
            TypeAnnotation::Tuple(t)     => {
                for (mut i: i64 = 0; i < t.elements.length; i++) { this.prime_typeof_annotation(t.elements[i]); }
            }
            _ => {}
        }
    }


    // -- Control-flow / all-paths-return analysis --

    check_function_returns(mut &this, func: FunctionDeclNode*) -> void {
        if (func == null || func.body == null) { return; }
        if (!this.return_type_requires_return(func.resolved_return_type)) { return; }
        if (this.block_always_returns(func.body)) { return; }
        const fn_name: string = this.intern.resolve(func.name);
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0403_MISSING_RETURN,
            fmt::format("function `%s` is declared to return a value but reaches the end of its body without returning", fn_name));
        diag = diag.at(func.span);
        diag = diag.with_note("every control-flow path through the body must end in `return <expr>`, a divergent call (e.g. `panic(...)`), or an infinite `loop { ... }` with no `break`");
        diag = diag.with_note("if a missing path is unreachable, end it with `return <default>` or `panic(\"unreachable\")`");
        if (func.body.statements.length > 0) {
            const last: StatementNode* = func.body.statements[func.body.statements.length - 1];
            if (last != null && last.span.has_location()) {
                const anchor: SourceSpan = SourceSpan::new(last.span.file, last.span.end_line, last.span.end_col, last.span.end_line, last.span.end_col);
                const placeholder: string = this.default_return_expr_for(func.resolved_return_type);
                diag = diag.suggest(Suggestion::single(anchor, fmt::format("\nreturn %s;", placeholder),
                    "add a `return` at the end of the body", Applicability::HasPlaceholders));
            }
        }
        this.ctx.diagnostics.emit(diag);
    }

    default_return_expr_for(&this, ret_ty: TypeRef) -> string {
        if (!ret_ty.is_valid()) { return "<value>"; }
        const t: Type* = this.arena.lookup(ret_ty.id);
        if (t == null) { return "<value>"; }
        match (t.kind) {
            TypeKind::Pointer  => { return "null"; }
            TypeKind::Optional => { return "Option::None"; }
            _ => {}
        }
        const name: string = this.types.type_display_name(ret_ty);
        if (name.eq("boolean") || name.eq("bool")) { return "false"; }
        if (name.eq("string")) { return "\"\""; }
        if (name.eq("f32") || name.eq("f64")) { return "0.0"; }
        if (name.eq("i8")  || name.eq("i16") || name.eq("i32") || name.eq("i64")
         || name.eq("i128") || name.eq("u8")  || name.eq("u16")
         || name.eq("u32") || name.eq("u64") || name.eq("u128")
         || name.eq("isize") || name.eq("usize")) { return "0"; }
        return fmt::format("<%s>", name);
    }

    return_type_requires_return(&this, ret: TypeRef) -> boolean {
        if (!ret.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(ret.id);
        if (t == null) { return false; }
        if (t.kind == TypeKind::Void) { return false; }
        if (t.kind == TypeKind::Unit) { return false; }
        if (t.kind == TypeKind::Never) { return false; }
        return true;
    }

    block_always_returns(&this, block: BlockStmtNode*) -> boolean {
        if (block == null) { return false; }
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            if (this.stmt_always_returns(block.statements[i])) { return true; }
        }
        return false;
    }

    stmt_always_returns(&this, stmt: StatementNode*) -> boolean {
        if (stmt == null) { return false; }
        const node: ASTNode* = stmt as ASTNode*;
        match (node.kind) {
            NodeKind::ReturnStatement => { return true; }
            NodeKind::BlockStatement => { return this.block_always_returns(stmt as BlockStmtNode*); }
            NodeKind::UnsafeBlockStatement => { return this.block_always_returns((stmt as UnsafeBlockStmtNode*).block); }
            NodeKind::IfStatement => {
                const ifs: IfStmtNode* = stmt as IfStmtNode*;
                if (!ifs.has_else()) { return false; }
                return this.stmt_always_returns(ifs.then_stmt) && this.stmt_always_returns(ifs.else_stmt);
            }
            NodeKind::MatchStatement => {
                const ms: MatchStmtNode* = stmt as MatchStmtNode*;
                if (!this.patterns.match_is_exhaustive(ms.subject, ms.arms)) { return false; }
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm == null || arm.body == null) { return false; }
                    if (!this.stmt_always_returns(arm.body)) { return false; }
                }
                return true;
            }
            NodeKind::StaticMatchStatement => {
                const sms: StaticMatchStmtNode* = stmt as StaticMatchStmtNode*;
                if (sms.arms.length == 0 || sms.arms[0] == null || sms.arms[0].body == null) { return false; }
                return this.stmt_always_returns(sms.arms[0].body);
            }
            NodeKind::LoopStatement => {
                const ls: LoopStmtNode* = stmt as LoopStmtNode*;
                const loop_body: BlockStmtNode* = ls.body as BlockStmtNode*;
                if (!this.block_contains_break(loop_body)) { return true; }
                return this.block_always_returns(loop_body);
            }
            NodeKind::DoWhileStatement => { return this.stmt_always_returns((stmt as DoWhileStmtNode*).body); }
            NodeKind::ExpressionStatement => { return this.expr_is_divergent((stmt as ExprStmtNode*).expression); }
            _ => {}
        }
        return false;
    }

    block_contains_break(&this, block: BlockStmtNode*) -> boolean {
        if (block == null) { return false; }
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            if (this.stmt_contains_break(block.statements[i])) { return true; }
        }
        return false;
    }

    stmt_contains_break(&this, stmt: StatementNode*) -> boolean {
        if (stmt == null) { return false; }
        const node: ASTNode* = stmt as ASTNode*;
        match (node.kind) {
            NodeKind::BreakStatement => { return true; }
            NodeKind::BlockStatement => { return this.block_contains_break(stmt as BlockStmtNode*); }
            NodeKind::UnsafeBlockStatement => { return this.block_contains_break((stmt as UnsafeBlockStmtNode*).block); }
            NodeKind::IfStatement => {
                const ifs: IfStmtNode* = stmt as IfStmtNode*;
                if (this.stmt_contains_break(ifs.then_stmt)) { return true; }
                if (ifs.has_else()) { if (this.stmt_contains_break(ifs.else_stmt)) { return true; } }
                return false;
            }
            NodeKind::MatchStatement => {
                const ms: MatchStmtNode* = stmt as MatchStmtNode*;
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm != null && this.stmt_contains_break(arm.body)) { return true; }
                }
                return false;
            }
            NodeKind::StaticMatchStatement => {
                const sms: StaticMatchStmtNode* = stmt as StaticMatchStmtNode*;
                if (sms.arms.length == 0 || sms.arms[0] == null) { return false; }
                return this.stmt_contains_break(sms.arms[0].body);
            }
            _ => {}
        }
        return false;
    }

    // A call diverges (does not return to the caller) if its resolved
    // return type is `never` - e.g. `core::panic` / `intrinsics::panic`,
    // both declared `-> never`. Divergence is carried structurally by the
    // type, so no special-casing on the callee's symbol name is needed.
    expr_is_divergent(&this, expr: ExpressionNode*) -> boolean {
        if (expr == null) { return false; }
        if (expr.kind != NodeKind::CallExpression) { return false; }
        const call: CallExprNode* = expr as CallExprNode*;
        if (call.callee == null) { return false; }
        if (call.resolved_type.is_valid()) {
            const rt: Type* = this.arena.lookup(call.resolved_type.id);
            if (rt != null && rt.kind == TypeKind::Never) { return true; }
        }
        return false;
    }


    // -- Return-escape analysis (E0455) --

    check_return_payload_escape(mut &this, e: ExpressionNode*, ret_ty: TypeRef) -> void {
        if (e == null) { return; }
        if (e.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = e as IdentifierNode*;
            if (this.scopes.is_payload_binding(id.name) && this.ret_carries_pointer_to(ret_ty, id.resolved_type)) {
                this.diag.emit_payload_escape(e.span);
            }
            return;
        }
        if (e.kind == NodeKind::CallExpression) {
            const c: CallExprNode* = e as CallExprNode*;
            if (c.arguments.length == 1 && c.arguments[0] != null
                    && c.arguments[0].kind == NodeKind::Identifier && this.callee_names_ret_variant(c.callee, ret_ty)) {
                const id: IdentifierNode* = c.arguments[0] as IdentifierNode*;
                if (this.scopes.is_payload_binding(id.name) && this.ret_carries_pointer_to(ret_ty, id.resolved_type)) {
                    this.diag.emit_payload_escape(c.arguments[0].span);
                }
            }
            return;
        }
        if (e.kind == NodeKind::MatchExpression) {
            const me: MatchExprNode* = e as MatchExprNode*;
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                const arm: MatchArmNode* = me.arms[i];
                if (arm == null) { continue; }
                this.check_return_payload_escape(this.patterns.arm_tail_expr(arm.body), ret_ty);
            }
            return;
        }
        if (e.kind == NodeKind::StaticMatchExpression) {
            const sme: StaticMatchExprNode* = e as StaticMatchExprNode*;
            for (mut i: i64 = 0; i < sme.arms.length; i++) {
                const arm: StaticMatchArmNode* = sme.arms[i];
                if (arm == null) { continue; }
                this.check_return_payload_escape(this.patterns.arm_tail_expr(arm.body), ret_ty);
            }
            return;
        }
        if (e.kind == NodeKind::IfExpression) {
            const ie: IfExprNode* = e as IfExprNode*;
            this.check_return_payload_escape(ie.then_expr, ret_ty);
            this.check_return_payload_escape(ie.else_expr, ret_ty);
            return;
        }
    }

    ret_carries_pointer_to(&this, ret_ty: TypeRef, v: TypeRef) -> boolean {
        if (this.types.is_ptr_or_ref_to(ret_ty, v)) { return true; }
        const t: Type* = this.arena.lookup(ret_ty.id);
        if (t != null && t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                if (this.types.is_ptr_or_ref_to(inst.type_args[i], v)) { return true; }
            }
        }
        return false;
    }

    callee_names_ret_variant(&this, callee: ExpressionNode*, ret_ty: TypeRef) -> boolean {
        if (callee == null) { return false; }
        mut leaf: SymbolStr = SymbolStr::empty();
        if (callee.kind == NodeKind::Identifier) { leaf = (callee as IdentifierNode*).name; }
        else if (callee.kind == NodeKind::ScopeResolution) { leaf = (callee as ScopeResolutionNode*).member_name; }
        else { return false; }
        if (!leaf.is_valid()) { return false; }
        const et: Type* = this.types.unwrap_to_enum(ret_ty);
        if (et == null || et.kind != TypeKind::Enum) { return false; }
        const e: EnumType* = et as EnumType*;
        return e.get_variant(leaf) != null;
    }

    /// Whether a `match` subject's storage belongs to the CALLER rather than to
    /// this frame, so a payload binding taken from it aliases storage that
    /// outlives the function and `&binding` may legitimately be returned.
    ///
    /// True only for a subject reached through a by-reference receiver
    /// (`match (&this)` in a `&this` / `mut &this` method) or a pointer/reference
    /// parameter (`match (slot)` where `slot: Option<T>*`) - the same
    /// caller-backed reasoning that already exempts `&param` from the check.
    /// A BY-VALUE parameter does NOT qualify: it lives in this frame like any
    /// local, so a pointer into its payload dangles once the frame is gone.
    subject_is_caller_backed(&this, e: ExpressionNode*) -> boolean {
        if (e == null) { return false; }
        const k: NodeKind = e.kind;
        if (k == NodeKind::Identifier) {
            const id: IdentifierNode* = e as IdentifierNode*;
            if (this.names_receiver(id)) { return this.state.this_is_by_ref; }
            if (!this.scopes.is_param(id.name)) { return false; }
            return this.type_is_indirect(id.resolved_type);
        }
        // `&subject` / `*subject` keep naming the same storage; a member or
        // element of caller-backed storage is caller-backed too.
        if (k == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = e as UnaryExprNode*;
            if (u.desugared_call != null) { return false; }
            if (u.op.lexeme != "&" && u.op.lexeme != "*") { return false; }
            return this.subject_is_caller_backed(u.operand);
        }
        if (k == NodeKind::MemberAccess) {
            return this.subject_is_caller_backed((e as MemberAccessNode*).object);
        }
        if (k == NodeKind::ArrayAccess) {
            return this.subject_is_caller_backed((e as ArrayAccessNode*).array);
        }
        return false;
    }

    /// Whether `ty` is a pointer or a reference — storage reached through it is
    /// somebody else's.
    type_is_indirect(&this, ty: TypeRef) -> boolean {
        if (!ty.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return false; }
        return t.kind == TypeKind::Pointer || t.kind == TypeKind::Reference;
    }

    check_return_stack_address(mut &this, e: ExpressionNode*) -> void {
        if (e == null) { return; }
        if (e.kind == NodeKind::IfExpression) {
            const ie: IfExprNode* = e as IfExprNode*;
            this.check_return_stack_address(ie.then_expr);
            this.check_return_stack_address(ie.else_expr);
            return;
        }
        if (e.kind == NodeKind::MatchExpression) {
            const me: MatchExprNode* = e as MatchExprNode*;
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                const arm: MatchArmNode* = me.arms[i];
                if (arm == null) { continue; }
                this.check_return_stack_address(this.patterns.arm_tail_expr(arm.body));
            }
            return;
        }
        if (e.kind == NodeKind::StaticMatchExpression) {
            const sme: StaticMatchExprNode* = e as StaticMatchExprNode*;
            for (mut i: i64 = 0; i < sme.arms.length; i++) {
                const arm: StaticMatchArmNode* = sme.arms[i];
                if (arm == null) { continue; }
                this.check_return_stack_address(this.patterns.arm_tail_expr(arm.body));
            }
            return;
        }
        if (e.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = e as UnaryExprNode*;
            if (u.op.lexeme == "&" && u.operand != null && u.operand.kind == NodeKind::Identifier) {
                const id: IdentifierNode* = u.operand as IdentifierNode*;
                // A payload binding over a caller-backed subject names the
                // caller's storage, not a copy in this frame, so its address
                // survives the return — that is exactly an in-place accessor.
                if (this.scopes.is_aliasing_binding(id.name)) { return; }
                if (this.scopes.is_local_or_param(id.name) && !this.scopes.is_param(id.name)) {
                    this.ctx.emit_error_at(ErrorCode::E0455_DANGLING_POINTER,
                        "cannot return the address of a local variable: it lives on this function's stack frame and is freed when the function returns. Return the value by move, or a heap allocation, instead.",
                        e.span);
                }
            }
        }
    }


    // -- impl-trait (opaque type) checks --

    impl_trait_annotation_of(&this, ann: TypeAnnotation*) -> ImplTraitAnnotation* {
        if (ann == null) { return null; }
        match (*ann) {
            TypeAnnotation::ImplTrait(imp) => { return imp; }
            _ => { return null; }
        }
    }

    trait_leaf_name(&this, ann: TypeAnnotation*) -> SymbolStr {
        if (ann == null) { return SymbolStr::empty(); }
        match (*ann) {
            TypeAnnotation::Named(n)   => { return n.name; }
            TypeAnnotation::Generic(g) => { return this.trait_leaf_name(g.base); }
            _ => { return SymbolStr::empty(); }
        }
    }

    verify_impl_trait_bounds(mut &this, imp: ImplTraitAnnotation*, concrete: TypeRef, var_node: VarDeclNode*) -> void {
        if (imp == null || this.ctx.generic_registry == null) { return; }
        for (mut i: i64 = 0; i < imp.bounds.length; i++) {
            const trait_name: SymbolStr = this.trait_leaf_name(imp.bounds[i]);
            if (!trait_name.is_valid()) { continue; }
            const bound_id: DefId = TypeAnnotation::trait_def(imp.bounds[i]);
            if (this.trait_checker().type_satisfies_opaque_bound(
                    concrete, bound_id)) {
                this.check_opaque_assoc_item(imp.bounds[i], concrete, var_node);
                continue;
            }
            const var_name:  string = this.intern.resolve(var_node.name);
            const trait_str: string = this.intern.resolve(trait_name);
            const conc_str:  string = this.types.type_display_name(concrete);
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0200_TYPE_MISMATCH,
                fmt::format("`%s` is declared `implement %s`, but its initializer has type `%s`, which does not implement `%s`",
                       var_name, trait_str, conc_str, trait_str));
            diag = diag.at_with_label(annotation_span(var_node.type_annotation),
                "this opaque type requires the initializer to implement the trait");
            this.ctx.emit_diagnostic(diag);
            return;
        }
    }

    opaque_assoc_item_mismatch(mut &this, bound_ann: TypeAnnotation*, concrete: TypeRef,
                               out_expected: TypeRef*, out_actual: TypeRef*,
                               out_trait: SymbolStr*, out_item: SymbolStr*) -> boolean {
        if (bound_ann == null) { return false; }
        if (this.ctx.generic_registry == null || this.ctx.type_resolver == null) { return false; }
        mut gen: GenericAnnotation* = null;
        match (*bound_ann) {
            TypeAnnotation::Generic(g) => { gen = g; }
            _ => { return false; }
        }
        if (gen == null || gen.args.length != 1) { return false; }
        const trait_leaf: DefId = TypeAnnotation::trait_def(bound_ann);
        if (!trait_leaf.is_valid()) { return false; }
        const tdecl: TraitDeclNode* = this.ctx.generic_registry.get_trait_decl(trait_leaf);
        if (tdecl == null) { return false; }
        if (tdecl.generic_params.length != 0 || tdecl.assoc_types.length != 1) { return false; }
        const adecl: AssocTypeDeclNode* = tdecl.assoc_types[0];
        if (adecl == null) { return false; }
        // The bound's argument is syntax written where the annotation is, and
        // carries that module's stamp.  An ABSTRACT param is a different
        // question: it needs a binding, which nothing here supplies, so those
        // keep failing here by construction.
        mut rc: ResolutionContext = ResolutionContext::new("");
        const expected: TypeRef = this.ctx.type_resolver.resolve(gen.args[0], &rc);
        const actual:   TypeRef = this.ctx.type_resolver.resolve_concrete_member(concrete, adecl.name, tdecl, &rc);
        if (!expected.is_valid() || !actual.is_valid()) { return false; }
        if (expected.id == actual.id) { return false; }
        if (this.checker.check_compatibility(expected, actual) != TypeCompatibility::Incompatible) { return false; }
        if (this.checker.check_compatibility(actual, expected) != TypeCompatibility::Incompatible) { return false; }
        *out_expected = expected;
        *out_actual   = actual;
        *out_trait    = this.ctx.defs.path_of(trait_leaf);
        *out_item     = adecl.name;
        return true;
    }

    check_opaque_assoc_item(mut &this, bound_ann: TypeAnnotation*, concrete: TypeRef, var_node: VarDeclNode*) -> void {
        mut expected: TypeRef = TypeRef::invalid();
        mut actual:   TypeRef = TypeRef::invalid();
        mut trait_sym: SymbolStr = SymbolStr::empty();
        mut item_sym:  SymbolStr = SymbolStr::empty();
        if (!this.opaque_assoc_item_mismatch(bound_ann, concrete, &expected, &actual, &trait_sym, &item_sym)) { return; }
        const var_name:  string = this.intern.resolve(var_node.name);
        const trait_str: string = this.intern.resolve(trait_sym);
        const item_str:  string = this.intern.resolve(item_sym);
        const exp_str:   string = this.types.type_display_name(expected);
        const act_str:   string = this.types.type_display_name(actual);
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0200_TYPE_MISMATCH,
            fmt::format("`%s` is declared `implement %s<%s>`, but its initializer's `%s::%s` is `%s`, not `%s`",
                   var_name, trait_str, exp_str, trait_str, item_str, act_str, exp_str));
        diag = diag.at_with_label(annotation_span(var_node.type_annotation),
            "this opaque type's element type does not match the initializer");
        this.ctx.emit_diagnostic(diag);
    }

    check_opaque_return_item(mut &this, func: FunctionDeclNode*) -> void {
        if (func == null || func.return_type_annotation == null) { return; }
        if (!func.resolved_return_type.is_valid()) { return; }
        mut imp: ImplTraitAnnotation* = null;
        match (*func.return_type_annotation) {
            TypeAnnotation::ImplTrait(node) => { imp = node; }
            _ => { return; }
        }
        if (imp == null) { return; }
        for (mut i: i64 = 0; i < imp.bounds.length; i++) {
            mut expected: TypeRef = TypeRef::invalid();
            mut actual:   TypeRef = TypeRef::invalid();
            mut trait_sym: SymbolStr = SymbolStr::empty();
            mut item_sym:  SymbolStr = SymbolStr::empty();
            if (!this.opaque_assoc_item_mismatch(imp.bounds[i], func.resolved_return_type, &expected, &actual, &trait_sym, &item_sym)) { continue; }
            const fn_name:   string = this.intern.resolve(func.name);
            const trait_str: string = this.intern.resolve(trait_sym);
            const item_str:  string = this.intern.resolve(item_sym);
            const exp_str:   string = this.types.type_display_name(expected);
            const act_str:   string = this.types.type_display_name(actual);
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0200_TYPE_MISMATCH,
                fmt::format("`%s` is declared to return `implement %s<%s>`, but it returns a type whose `%s::%s` is `%s`, not `%s`",
                       fn_name, trait_str, exp_str, trait_str, item_str, act_str, exp_str));
            diag = diag.at_with_label(annotation_span(func.return_type_annotation),
                "this opaque return type's element type does not match the returned value");
            this.ctx.emit_diagnostic(diag);
            return;
        }
    }
}


// SemanticPasses: static dispatch for the pass registry.

type struct SemanticPasses {

    /// Walk all function bodies and fill resolved_type on every ExpressionNode.
    /// Runs AFTER monomorphization (post-mono authoritative pass when
    /// MonomorphizationComplete is provisioned).
    static run_sema(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();
        if (ctx.debug_mode) {
            cdebug("[Sema] Type-checking function bodies\n");
        }
        const arena: TypeArena* = ctx.type_arena;
        if (arena == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR, "Sema: type system not initialized");
            return PassResult::failure(1);
        }
        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) { return PassResult::ok(); }

        // Leak to a stable heap address, THEN wire (collaborators take back-
        // pointers into the visitor's fields), mirroring codegen/passes.cryo.
        // Bind the Box to a typed local first so `.leak()`'s generic `T*` return
        // is inferred as `SemaVisitor*` (an inline `Box<..>::new(..).leak()`
        // leaves `T` unbound - see codegen's `_box_gen` two-step).
        const _box_v: Box<SemaVisitor> = Box::<SemaVisitor>::new(SemaVisitor::build(ctx));
        const v: SemaVisitor* = _box_v.leak();
        v.state.post_mono_verify = ctx.provisions.has(Provision::MonomorphizationComplete);
        v.wire();
        v.visit(root);

        if (ctx.debug_mode) {
            cdebug("[Sema] Type-checked %lld function bodies\n", v.state.body_count);
        }
        if (ctx.debug_mode) {
            cdebug("[symbolic-check] walked %lld generic bodies, emitted %lld errors\n",
                v.state.symbolic_bodies_walked, v.state.symbolic_total_would_emit);
        }
        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }
}
