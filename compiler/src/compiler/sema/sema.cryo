/// What converting a value to a trait object answered
/// (`SemaVisitor::convert_to_object`).
type enum ObjectConversionOutcome {
    /// The target is no trait object, or the value is not of a form that
    /// becomes one: the site reports its own mismatch.
    Mismatch;
    /// Refused, and the refusal reported.
    Refused;
    /// The value, converted.
    Converted(ExpressionNode*);
}


/// Operator -> (language trait, method) overloading map. `valid == false` means
/// the operator is not overloadable; `negate` flags `!=`, which lowers to
/// `!a.equals(&b)`. `ord_pred` (non-empty only for the relational operators
/// `< > <= >=`) names an `Ordering` predicate: those lower to
/// `a.compare(&b).<ord_pred>()` (e.g. `a < b` -> `a.compare(&b).is_lt()`).
/// `deref_wrap` flags the unary `*` -> `Deref`: the built `b.deref()` call
/// returns `Target*`, so the desugar wraps it in an outer `*` (`*(b.deref())`),
/// a place that serves read / write / compound uniformly.
/// Kept in one place so the plain-binary, compound-assignment, and unary sema
/// paths agree on the mapping.
type struct OperatorTraitMap {
    lang:       LangItem;
    method:     string;
    ord_pred:   string;
    negate:     boolean;
    deref_wrap: boolean;
    valid:      boolean;

    static none() -> OperatorTraitMap {
        return OperatorTraitMap { lang: LangItem::Add, method: "", ord_pred: "", negate: false, deref_wrap: false, valid: false };
    }

    static mk(t: LangItem, m: string, neg: boolean) -> OperatorTraitMap {
        return OperatorTraitMap { lang: t, method: m, ord_pred: "", negate: neg, deref_wrap: false, valid: true };
    }

    /// A relational operator: `a OP b` -> `a.compare(&b).<pred>()` via `Ord`.
    static mk_ord(pred: string) -> OperatorTraitMap {
        return OperatorTraitMap { lang: LangItem::Ord, method: "compare", ord_pred: pred, negate: false, deref_wrap: false, valid: true };
    }

    /// Unary `*` -> `Deref::deref`: `*b` desugars to `*(b.deref())`.
    static mk_deref() -> OperatorTraitMap {
        return OperatorTraitMap { lang: LangItem::Deref, method: "deref", ord_pred: "", negate: false, deref_wrap: true, valid: true };
    }

    /// Binary `+ - * / %` (arithmetic), `== !=` (equality via `Eq`), and
    /// `< > <= >=` (relational via `Ord::compare`). Bitwise, shift, and logical
    /// operators are intentionally absent: they are not overloadable in v1.
    static for_binary(op: TokenType) -> OperatorTraitMap {
        if (op == TokenType::Plus)  { return OperatorTraitMap::mk(LangItem::Add, "add", false); }
        if (op == TokenType::Minus)  { return OperatorTraitMap::mk(LangItem::Sub, "sub", false); }
        if (op == TokenType::Star)  { return OperatorTraitMap::mk(LangItem::Mul, "mul", false); }
        if (op == TokenType::Slash)  { return OperatorTraitMap::mk(LangItem::Div, "div", false); }
        if (op == TokenType::Percent)  { return OperatorTraitMap::mk(LangItem::Rem, "rem", false); }
        if (op == TokenType::EqualEqual) { return OperatorTraitMap::mk(LangItem::Eq, "equals", false); }
        if (op == TokenType::ExclaimEqual) { return OperatorTraitMap::mk(LangItem::Eq, "equals", true); }
        if (op == TokenType::LAngle)  { return OperatorTraitMap::mk_ord("is_lt"); }
        if (op == TokenType::RAngle)  { return OperatorTraitMap::mk_ord("is_gt"); }
        if (op == TokenType::LessEqual) { return OperatorTraitMap::mk_ord("is_le"); }
        if (op == TokenType::GreaterEqual) { return OperatorTraitMap::mk_ord("is_ge"); }
        if (op == TokenType::Amp)  { return OperatorTraitMap::mk(LangItem::BitAnd, "bitand", false); }
        if (op == TokenType::Pipe)  { return OperatorTraitMap::mk(LangItem::BitOr,  "bitor",  false); }
        if (op == TokenType::Caret)  { return OperatorTraitMap::mk(LangItem::BitXor, "bitxor", false); }
        if (op == TokenType::LessLess) { return OperatorTraitMap::mk(LangItem::Shl,    "shl",    false); }
        if (op == TokenType::GreaterGreater) { return OperatorTraitMap::mk(LangItem::Shr,    "shr",    false); }
        return OperatorTraitMap::none();
    }

    /// Unary `-` (negation) -> `Neg`, `!` -> `Not`, `~` -> `BitNot`, and `*`
    /// (dereference) -> `Deref`. All are type-directed and only fire when the
    /// primitive `check_unary_op` rule rejects the operand.
    static for_unary(op: TokenType) -> OperatorTraitMap {
        if (op == TokenType::Minus) { return OperatorTraitMap::mk(LangItem::Neg, "neg", false); }
        if (op == TokenType::Exclaim) { return OperatorTraitMap::mk(LangItem::Not, "not", false); }
        if (op == TokenType::Tilde) { return OperatorTraitMap::mk(LangItem::BitNot, "bitnot", false); }
        if (op == TokenType::Star) { return OperatorTraitMap::mk_deref(); }
        return OperatorTraitMap::none();
    }
}


type struct SemaVisitor {
    // -- Immutable environment + the by-value checker (handed to collaborators
    //    as pointers via wire()) --
    arena:    TypeArena*;
    checker:  TypeChecker;
    intern:   InternTable*;
    ctx:      CompilationContext*;
    this_sym: SymbolStr;
    /// The allocator the `?` desugaring takes its bindings' identities from.
    /// That desugaring declares two bindings after name resolution has run,
    /// and a binding's identity comes from the one allocator that hands them
    /// out.  Held from `wire()`, one door; never asked by name.
    resolver: Resolver*;

    // -- Shared mutable per-pass state (shared by pointer) --
    state: SemaState;

    // -- Collaborators (owned by value; back-pointers set in wire()) --
    scopes:   ScopeManager;
    types:    TypeUtils;
    literals: LiteralResolver;
    diag:     Diagnostics;
    symbolic: SymbolicChecker;
    binding:  MethodBinding;
    patterns: PatternResolver;
    lambda:   LambdaSynth;
    async_lower: AsyncLower;
    member:   MemberResolver;
    calls:    CallResolver;

    /// Build from the compilation context (declaration lookups go through
    /// ctx.decl_index, so no AST scan here).
    static build(ctx: CompilationContext*) -> SemaVisitor {
        const arena: TypeArena* = ctx.type_arena;
        const intern: InternTable* = ctx.get_intern_table();
        return SemaVisitor {
            arena:       arena,
            checker:     TypeChecker::new(arena, ctx.decl_index),
            intern:      intern,
            ctx:         ctx,
            this_sym:    intern.intern("this"),
            resolver:    null,
            state:       SemaState::new(),
            scopes:      ScopeManager::null(),
            types:       TypeUtils::null(),
            literals:    LiteralResolver::null(),
            diag:        Diagnostics::null(),
            symbolic:    SymbolicChecker::null(),
            binding:     MethodBinding::null(),
            patterns:    PatternResolver::null(),
            lambda:      LambdaSynth::null(),
            async_lower: AsyncLower::null(),
            member:      MemberResolver::null(),
            calls:       CallResolver::null(),
        };
    }

    /// Two-phase init step 2: set every collaborator's back-pointers.  MUST run
    /// AFTER this visitor is at its stable heap address (see run_sema's leak()).
    wire(mut &this) -> void {
        this.resolver = this.ctx.get_resolver();
        this.scopes.wire(&this.state);
        this.types.wire(this.arena, this.intern, this.ctx, &this.checker);
        this.literals.wire(this.arena, this.ctx, &this.state);
        this.diag.wire(this.arena, this.intern, this.ctx, &this.state, &this.types);
        this.symbolic.wire(this.arena, this.ctx, &this.state, &this.types);
        this.binding.wire(this.arena, this.intern, this.ctx, &this.state, &this.types, &this.symbolic);
        this.patterns.wire(this.arena, this.intern, this.ctx, &this.state, &this.types,
                           &this.symbolic, &this.scopes);
        this.lambda.wire(this.arena, this.intern, this.ctx, &this.state, &this.symbolic,
                         &this.scopes);
        this.async_lower.wire(this.arena, this.intern, this.ctx, &this.patterns, &this.literals, &this.member);
        this.member.wire(this.arena, this.intern, this.ctx, &this.checker, &this.state, &this.types,
                         &this.symbolic, &this.binding, &this.diag);
        this.calls.wire(this.arena, this.intern, this.ctx, &this.checker, &this.state, &this.types,
                        &this.literals, &this.diag, &this.binding, &this.symbolic, &this.member,
                        &this.lambda, &this.scopes);
    }

    /// A wired visitor for a pass that synthesizes calls after sema has run
    /// (drop insertion, codegen's drop glue).  Leaked to a stable address the
    /// way `run_sema` does, because the collaborators hold back-pointers.
    static synthesized_binder(ctx: CompilationContext*) -> SemaVisitor* {
        const _box_v: Box<SemaVisitor> = Box::<SemaVisitor>::new(SemaVisitor::build(ctx));
        const v: SemaVisitor* = _box_v.leak();
        v.wire();
        return v;
    }

    /// Bind a destructor call another pass built - `x.drop()` standing for
    /// releasing `x` - to the destructor of the receiver's type by identity
    /// (`CallResolver::bind_destructor`); left unpinned when the type has
    /// none, for codegen to release with the type's glue or not at all.  A
    /// method of the type merely named `drop` is never bound here, and a
    /// pointer receiver is a `Copy` value with no destructor: it never
    /// reaches its pointee's.
    bind_destructor_call(mut &this, call_e: ExpressionNode*) -> void {
        const call: CallExpr* = ExpressionNode::call_of(call_e);
        if (call == null || call.callee == null) { return; }
        if (ExpressionNode::member_access_of(call.callee) == null) { return; }
        const member: MemberAccessExpr* = ExpressionNode::member_access_of(call.callee);
        if (member.object == null || !member.object.resolved_type.is_valid()) { return; }
        this.calls.bind_destructor(this as SemaVisitor*, call, member.object.resolved_type);
    }

    /// A fresh trait checker over the shared arena + registry (a 4-pointer view).
    trait_checker(&this) -> TraitChecker {
        return TraitChecker::new(this.arena, this.ctx.generic_registry,
                                 this.intern, this.ctx.diagnostics);
    }

    // -- Top-level + statement recursion seams --

    visit_program(mut &this, node: ProgramNode*) -> void {
        this.declare_async_futures(node);
        this.state.current_func = null;
        this.type_unwritten_globals(node);
        this.state.unbound_variants.clear();
        for (mut i: i64 = 0; i < node.statements.length; i++) {
            const stmt: Node = node.statements[i];
            if (stmt.is_null()) { continue; }
            // An item is outside every function until its own visit enters
            // one; a global's initializer must not read the last body's.
            this.state.current_func = null;
            this.dispatch_top_level(stmt);
        }
        this.calls.refuse_unbound_variants();
    }

    /// Give every `async function` in the module its future type before any body
    /// is typed.
    ///
    /// The state machine can only be built from a typed body, so the lowering
    /// runs at the end of each function's own visit. But an `await` resolves the
    /// callee's return type through the declaration index, so a caller visited
    /// before its callee would see the callee's pre-lowering signature and report
    /// that its Output "does not implement `Future`". Declaring the whole module's
    /// futures up front makes the order of declarations irrelevant, and lets an
    /// `async function` await itself.
    ///
    /// Bounded to the statement list: the count of async fns per module is small,
    /// and `declare` is idempotent per node.
    declare_async_futures(mut &this, node: ProgramNode*) -> void {
        for (mut i: i64 = 0; i < node.statements.length; i++) {
            const stmt: DeclarationNode* = node.statements[i].as_decl();
            if (stmt == null) { continue; }
            match (stmt.kind) {
                DeclKind::Function(f) => {
                    const f_decl: DeclarationNode* = stmt;
                    // A lowered one has already had `is_async` cleared.
                    if (f.is_async && f.body != null) {
                        // `async function main` is renamed out of the entry-point
                        // slot first, so the future `declare` registers is keyed
                        // to the renamed function and not to `main`.
                        this.async_lower.desugar_async_main(f_decl);
                        this.async_lower.declare(f_decl);
                    }
                }
                DeclKind::Impl(ib) => {
                    // The head's owner, off the stamp; the written
                    // target is what a refusal names.
                    mut owner_params: [DeclarationNode*] = this.impl_owner_params(ib);
                    this.declare_async_methods(ib.methods, owner_params,
                        this.ctx.decl_index.impl_owner(ib, "sema/async declare"), ib.target_type,
                        stmt);
                }
                DeclKind::Struct(s) => {
                    this.declare_async_methods(s.methods, s.generic_params,
                        this.ctx.decl_index.type_of_decl(s.def, "sema/async declare struct"), s.name, null);
                }
                DeclKind::Union(u) => {
                    this.declare_async_methods(u.methods, u.generic_params,
                        this.ctx.decl_index.type_of_decl(u.def, "sema/async declare union"), u.name, null);
                }
                DeclKind::Destructure(_) | DeclKind::Enum(_) | DeclKind::Extern(_)
                | DeclKind::Field(_) | DeclKind::GenericParam(_) | DeclKind::Import(_)
                | DeclKind::Intrinsic(_) | DeclKind::Module(_) | DeclKind::Trait(_)
                | DeclKind::TypeAlias(_) | DeclKind::Variable(_) | DeclKind::Variant(_) | DeclKind::Method(_) => { }
            }
        }
    }

    /// Declare the future of every `async` method in one owner's method list.
    ///
    /// `owner_params` are the OWNER's generic parameters, which the future must
    /// carry as well as the method's own; `owner_ty` is the owner's registered
    /// type, handed over by a caller that holds it and never re-derived here -
    /// the key its methods are registered under is the index's to name from
    /// it.  `written` is the owner as the source spelled it, for the refusal
    /// of a method whose owner has no type.
    /// `impl_decl` is the enclosing impl block's declaration when the owner
    /// is one (null otherwise); a trait impl uses it to bind the trait's
    /// implicit `<Method>Fut` associated type to the future each method
    /// lowers to.
    declare_async_methods(mut &this, methods: &[DeclarationNode*],
                          owner_params: &[DeclarationNode*],
                          owner_ty: TypeRef, written: SymbolStr,
                          impl_decl: DeclarationNode*) -> void {
        if (!owner_ty.is_valid()) { this.reject_undeclarable_async(methods, written); return; }
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m_decl: DeclarationNode* = methods[i];
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m == null || m.func == null || DeclarationNode::fn_of(m.func).body == null) { continue; }
            if (!DeclarationNode::fn_of(m.func).is_async) { continue; }
            mut own: AsyncOwner = AsyncOwner {
                method: m_decl,
                ty: this.async_owner_instance(owner_ty, owner_params),
                decl: owner_ty,
                written: written,
                params: this.clone_generic_params(owner_params),
                impl_decl: impl_decl,
            };
            this.async_lower.declare_method(own);
        }
    }

    /// Report every `async` method of an owner whose type could not be resolved,
    /// and clear the flag.
    ///
    /// Skipping quietly is what must not happen: an `async` method left
    /// undeclared reaches `lower` with no pending record, and that fallback
    /// declares it as a FREE function — where the body's `this` would silently
    /// resolve to the generated future instead of the receiver.
    reject_undeclarable_async(mut &this, methods: &[DeclarationNode*], written: SymbolStr) -> void {
        const owner: string = if (written.is_valid()) { this.intern.resolve(written) } else { "?" };
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m_decl: DeclarationNode* = methods[i];
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m == null || m.func == null || !DeclarationNode::fn_of(m.func).is_async) { continue; }
            this.ctx.emit_error_at(ErrorCode::E0203_UNDEFINED_TYPE,
                fmt::format("cannot resolve the owner type `%s` of `async` method `%s`, so its future cannot be declared",
                       owner, this.intern.resolve(DeclarationNode::fn_of(m.func).name)),
                m.func.span);
            DeclarationNode::fn_of(m.func).set_async(false);
        }
    }

    /// The owner type as a method body sees `this`: the type itself, or the
    /// template instantiated over its own parameters for a generic owner
    /// (`Box<T>`), which is what the symbolic walk binds `this` to.
    async_owner_instance(mut &this, base: TypeRef, params: &[DeclarationNode*]) -> TypeRef {
        if (!base.is_valid() || params.length == 0) { return base; }
        const t: Type* = this.arena.lookup(base);
        if (t == null || t.kind == TypeKind::InstantiatedType) { return base; }
        mut refs: [TypeRef] = TypeResolutionPasses::create_generic_param_types(params, this.arena);
        const inst: TypeRef = this.arena.create_instantiation(base, &refs);
        mem::drop(refs);
        return inst;
    }

    /// The generic parameters the OWNER of an impl block's methods actually has.
    ///
    /// An impl block on a generic template writes them on the TARGET
    /// (`implement trait Sink for struct Buf<S>`), not on the block itself, so
    /// `generic_params` is empty there while the method bodies may still mention
    /// `S`. A future lowered from such a method has to be generic in `S` too: the
    /// future's own impl block is what decides whether sema walks its `poll` body
    /// symbolically, and a body walked concretely while an abstract projection
    /// (`S::ReadFut::Output`) is still in it fails every check against that
    /// projection instead of deferring until monomorphization resolves it.
    impl_owner_params(mut &this, ib: ImplBlock*) -> [DeclarationNode*] {
        if (ib.generic_params.length > 0) {
            return this.clone_generic_params(ib.generic_params);
        }
        const greg: GenericRegistry* = this.ctx.generic_registry;
        if (greg == null) { return []; }
        // The template the head's stamp names.  The target is written bare
        // (`BufStream`), and a spelling qualified by the module the impl sits
        // in names the template only when that module declares the type; an
        // impl written anywhere else missed, handed back no parameters, and
        // left the future non-generic in `S` while the body still mentioned
        // it.
        const tmpl: TemplateEntry* = greg.template_of(ib.target_def());
        if (tmpl == null || tmpl.ast_node == null) { return []; }
        if (tmpl.kind == TemplateKind::Struct) {
            return this.clone_generic_params((DeclarationNode::struct_of(tmpl.ast_node)).generic_params);
        }
        if (tmpl.kind == TemplateKind::Enum) {
            return this.clone_generic_params(DeclarationNode::enum_of(tmpl.ast_node).generic_params);
        }
        if (tmpl.kind == TemplateKind::Union) {
            return this.clone_generic_params((DeclarationNode::union_of(tmpl.ast_node)).generic_params);
        }
        return [];
    }

    clone_generic_params(&this, params: &[DeclarationNode*]) -> [DeclarationNode*] {
        mut out: [DeclarationNode*] = [];
        for (mut i: i64 = 0; i < params.length; i++) { out.push(params[i]); }
        return out;
    }

    /// Dispatch a top-level node, swapping to the template's module/namespace
    /// while walking an injected specialization (so qualified-name lookups land).
    dispatch_top_level(mut &this, stmt: Node) -> void {
        mut saved_scope: u64 = 0;
        mut saved_module: ModulePath = ModulePath::none();
        mut saved_unit: ModulePath = ModulePath::none();
        mut needs_restore: boolean = false;
        const template_mod: ModulePath = this.types.find_template_module(stmt.as_decl());
        if (template_mod.is_valid()) {
            const resolver: Resolver* = this.ctx.get_resolver();
            if (resolver != null) {
                saved_scope = resolver.get_current_scope_id();
                const template_scope: u64 = resolver.find_module_scope(template_mod);
                if (template_scope > 0) {
                    // `find_module_scope` asks whether the module was entered
                    // without creating a scope for one that was not.
                    saved_module = resolver.set_module(template_mod);
                    saved_unit = this.ctx.swap_unit_module(template_mod);
                    needs_restore = true;
                }
            }
        }
        this.dispatch_node(stmt);
        if (needs_restore) {
            const resolver: Resolver* = this.ctx.get_resolver();
            if (resolver != null) {
                resolver.restore_scope(saved_module, saved_scope);
            }
            this.ctx.swap_unit_module(saved_unit);
        }
    }

    /// Dispatch a statement to the check for its kind.
    dispatch_stmt(mut &this, stmt: Stmt*) -> void {
        if (stmt == null) { return; }
        match (stmt.kind) {
            StmtKind::Block(_)       => { this.visit_block(stmt); }
            StmtKind::UnsafeBlock(n) => { this.visit_unsafe_block(stmt, n); }
            StmtKind::Asm(n)         => { this.visit_asm_block(stmt, n); }
            StmtKind::Return(n)      => { this.visit_return(stmt, n); }
            StmtKind::If(n)          => { this.visit_if(stmt, n); }
            StmtKind::While(n)       => { this.visit_while(stmt, n); }
            StmtKind::DoWhile(n)     => { this.visit_do_while(stmt, n); }
            StmtKind::For(n)         => { this.visit_for(stmt, n); }
            StmtKind::Match(n)       => { this.visit_match_stmt(stmt, n); }
            StmtKind::StaticMatch(n) => { this.visit_static_match_stmt(stmt, n); }
            StmtKind::Break          => { this.visit_break(stmt); }
            StmtKind::Continue       => { this.visit_continue(stmt); }
            StmtKind::Expr(n)        => { this.visit_expr_stmt(stmt, n); }
            StmtKind::Decl(n)        => { this.visit_decl_stmt(stmt, n); }
            StmtKind::Loop(n)        => { this.visit_loop(stmt, n); }
        }
    }


    // -- Declaration visitors --

    visit_function(mut &this, node_decl: DeclarationNode*) -> void {
        const node: FunctionDecl* = DeclarationNode::fn_of(node_decl);
        if (node.body == null) { return; }
        if (node.is_generic()) {
            // A generic body is typed by the symbolic walk, against abstract
            // parameter refs. An `async function`'s state machine is then built
            // from the resolved types that walk leaves on the body, and the
            // future it produces is generic in the same parameters, so the
            // monomorphizer specializes it from the same demand that specializes
            // the function.
            this.symbolic_check_body(node_decl, TypeRef::invalid(), TypeRef::invalid());
            if (node.is_async) {
                this.async_lower.lower(node_decl);
            }
            return;
        }
        this.enter_function(node_decl, TypeRef::invalid());
        this.visit_block(node.body);
        this.state.body_count += 1;
        this.check_function_returns(node_decl);
        this.check_opaque_return_item(node_decl);
        // Lower an `async function` into a Future state machine AFTER its body is
        // typed against the declared Output type. The generic case returned above.
        if (node.is_async) {
            this.async_lower.lower(node_decl);
        }
    }

    visit_struct(mut &this, node: StructDecl*) -> void {
        // The declaration's own registration, by the id it stamped - for an
        // injected specialization the one its injector wrote, whichever
        // module the clone was placed in.
        const st_type: TypeRef = this.ctx.decl_index.type_of_decl(node.def, "sema/visit:StructDecl");        if (node.is_generic()) {
            this.symbolic_check_owner_methods(node.methods, st_type, node.generic_params);
            return;
        }
        this.visit_methods(node.methods, st_type);
    }

    visit_union(mut &this, node: UnionDecl*) -> void {
        const un_type: TypeRef = this.ctx.decl_index.type_of_decl(node.def, "sema/visit:UnionDecl");
        if (node.is_generic()) {
            this.symbolic_check_owner_methods(node.methods, un_type, node.generic_params);
            return;
        }
        this.visit_methods(node.methods, un_type);
    }

    visit_trait(mut &this, node: TraitDecl*) -> void {
        if (node.is_generic()) { return; }
        const this_name: SymbolStr = this.intern.intern("This");
        const this_placeholder: TypeRef = this.arena.this_placeholder(this_name);
        const saved_trait: TypeRef = this.state.symbolic_trait;
        this.state.symbolic_trait = this.ctx.decl_index.type_of_decl(node.def, "sema/visit:TraitDecl");
        for (mut j: i64 = 0; j < node.methods.length; j++) {
            const func_decl: DeclarationNode* = node.methods[j];
            const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
            if (func == null || func.body == null) { continue; }
            // Every default method is walked SYMBOLICALLY: its receiver `This` is
            // abstract whether or not the method has type parameters of its own,
            // so `this.m()` is typed through the trait that bounds `This`.  A
            // plain walk treats `This` as a concrete type with no methods and
            // leaves every such call, and everything bound from it, untyped.
            // A generic default also needs it for `static match (T)`, whose arms
            // are deferred to monomorphization instead of tripping E0645.
            this.symbolic_check_body(func_decl, this_placeholder, this_placeholder);
        }
        this.state.symbolic_trait = saved_trait;
    }

    visit_impl(mut &this, decl: DeclarationNode*, node: ImplBlock*) -> void {
        this.check_supertraits_implemented(decl, node);
        if (node.is_generic()) {
            const impl_target: TypeRef = this.ctx.decl_index.impl_owner(node, "sema/visit:ImplBlock");
            const saved_impl: ImplBlock* = this.state.symbolic_impl_node;
            this.state.symbolic_impl_node = node;
            this.symbolic_check_owner_methods(node.methods, impl_target, node.generic_params);
            this.state.symbolic_impl_node = saved_impl;
            return;
        }
        const greg: GenericRegistry* = this.ctx.generic_registry;
        if (greg != null) {
            // The template the head is written for, off the head's stamp.  A
            // head with no parameters of its own whose target is a template
            // names a concrete instantiation (`implement trait Clone for
            // String<GlobalAlloc>`; the elided form is refused where the head
            // is attached to its template).  Its methods are walked
            // symbolically over the TEMPLATE's parameters, as a generic head's
            // are over its own: that is what produces the method-spec demand
            // mono consumes (`call.set_resolved_type_args`), and the concrete
            // path below cannot type-check a body whose receiver is a template.
            // A walk over the instantiation itself waits on impl selection
            // honouring a concrete target argument, which nothing does yet.
            mut tmpl: TemplateEntry* = null;
            match (node.res) {
                ResSlot::Answered(r) => {
                    match (r) {
                        Res::Def(q) => { tmpl = greg.template_of(q); }
                        _           => { }
                    }
                }
                _ => { }
            }
            if (tmpl != null) {
                if (tmpl.ast_node != null) {
                    const owner_ty: TypeRef = this.ctx.decl_index.impl_owner(node, "sema/visit:ImplBlock");
                    const saved_impl: ImplBlock* = this.state.symbolic_impl_node;
                    this.state.symbolic_impl_node = node;
                    if (tmpl.kind == TemplateKind::Struct) {
                        this.symbolic_check_owner_methods(node.methods, owner_ty,
                            (DeclarationNode::struct_of(tmpl.ast_node)).generic_params);
                    } else if (tmpl.kind == TemplateKind::Enum) {
                        this.symbolic_check_owner_methods(node.methods, owner_ty,
                            DeclarationNode::enum_of(tmpl.ast_node).generic_params);
                    } else if (tmpl.kind == TemplateKind::Union) {
                        this.symbolic_check_owner_methods(node.methods, owner_ty,
                            (DeclarationNode::union_of(tmpl.ast_node)).generic_params);
                    }
                    this.state.symbolic_impl_node = saved_impl;
                }
                return;
            }
        }
        const impl_this: TypeRef = this.ctx.decl_index.impl_owner(node, "sema/visit:ImplBlock");
        this.check_assoc_decl_bounds(decl, node, impl_this);
        this.visit_methods(node.methods, impl_this);
    }

    /// Type-check all method bodies in a type or impl block.
    visit_methods(mut &this, methods: &[DeclarationNode*], owner_type: TypeRef) -> void {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const method_decl: DeclarationNode* = methods[i];
            const method: MethodDecl* = DeclarationNode::method_of(method_decl);
            if (method == null || method.func == null || DeclarationNode::fn_of(method.func).body == null) { continue; }
            if (DeclarationNode::fn_of(method.func).is_generic()) {
                const sym_this: TypeRef = if (method.is_static) { TypeRef::invalid() } else { owner_type };
                // Same shape as the free-function case: the walk types the body,
                // and an `async` one's state machine is then built from what it
                // left there.  `begin_body_check` lends the declared Output back
                // for the walk and is a no-op for anything not a pending `async`
                // method.
                const displaced: TypeRef = this.async_lower.begin_body_check(method.func);
                this.symbolic_check_body(method.func, sym_this, owner_type);
                this.async_lower.end_body_check(method.func, displaced);
                if (DeclarationNode::fn_of(method.func).is_async) {
                    this.async_lower.lower(method.func);
                }
                continue;
            }
            // A self-returning trait default (`take -> TakeIter<This>`) and a
            // method whose return grows its owner (`as_ref -> Option<T*>`)
            // are instantiated lazily, per call site, so the body is typed the
            // way a generic body is: symbolically, demanding no instantiation.
            // An eager walk would demand the adapter over this owner, whose
            // own impl carries the same default, without end.  The walk still
            // has to happen: what it leaves on the body - the callee stashes
            // above all - is what the lazy specialization's clone carries.  A
            // specialization's copy of such a method is that clone's source
            // and is never emitted; its body is not substituted, so after
            // monomorphization it is not walked, like a generic template.
            if (DeclarationNode::fn_of(method.func).is_self_returning_default || DeclarationNode::fn_of(method.func).is_lazy_self_growing) {
                const lazy_this: TypeRef = if (method.is_static) { TypeRef::invalid() } else { owner_type };
                this.symbolic_check_body(method.func, lazy_this, owner_type);
                continue;
            }
            const method_this: TypeRef = if (method.is_static) { TypeRef::invalid() } else { owner_type };
            const saved_owner: TypeRef = this.state.current_owner_type;
            this.state.current_owner_type = owner_type;
            // An `async` method's node already carries its FUTURE type, so
            // callers typed before it resolve correctly; its own body is still
            // checked against the declared Output.
            const displaced: TypeRef = this.async_lower.begin_body_check(method.func);
            this.enter_function(method.func, method_this);
            this.visit_block(DeclarationNode::fn_of(method.func).body);
            this.state.body_count += 1;
            this.check_function_returns(method.func);
            this.async_lower.end_body_check(method.func, displaced);
            // Lower AFTER the body is typed against the declared Output type,
            // exactly as `visit(FunctionDecl*)` does for a free function.
            if (DeclarationNode::fn_of(method.func).is_async) { this.async_lower.lower(method.func); }
            this.state.current_owner_type = saved_owner;
        }
    }

    /// Enforce a trait's declaration-site associated-type bounds against this
    /// concrete impl's binding (E0306).
    check_assoc_decl_bounds(mut &this, decl: DeclarationNode*, node: ImplBlock*, impl_this: TypeRef) -> void {
        if (node == null || !node.is_trait_impl()) { return; }
        if (!impl_this.is_valid()) { return; }
        const trait_leaf: DefId = TypeAnnotation::trait_def(node.trait_annotation);
        if (!trait_leaf.is_valid()) { return; }
        const tdecl: TraitDecl* = this.ctx.generic_registry.get_trait_decl(trait_leaf);
        if (tdecl == null) { return; }
        const span: SourceSpan = if (node.target_type_span.has_location()) { node.target_type_span } else { decl.span };
        const trait_str: string = this.intern.shown(this.ctx.defs.path_of(trait_leaf));
        for (mut i: i64 = 0; i < tdecl.assoc_types.length; i++) {
            const adecl: AssocTypeDeclNode* = tdecl.assoc_types[i];
            if (adecl == null || adecl.bounds.length == 0) { continue; }
            mut rc: ResolutionContext = ResolutionContext::new("");
            const item_ty: TypeRef = this.ctx.type_resolver.resolve_concrete_member(impl_this, i, tdecl, &rc);
            if (!item_ty.is_valid()) { continue; }
            if (this.arena.contains_generic_param(item_ty)) { continue; }
            const item_name: string = this.intern.resolve(adecl.name);
            const item_t: Type* = this.arena.lookup(item_ty);
            const item_disp: string = if (item_t != null) { this.arena.format_display(item_t) } else { "?" };
            for (mut b: i64 = 0; b < adecl.bounds.length; b++) {
                const tref: TraitRef* = &adecl.bounds[b];
                if (tref.path.length == 0) { continue; }
                const bound_trait: SymbolStr = tref.path[tref.path.length - 1];
                if (this.trait_checker().type_implements_trait(item_ty, tref.definition(), 0)) { continue; }
                const bound_str: string = this.intern.resolve(bound_trait);
                this.ctx.emit_error_at(
                    ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
                    fmt::format("associated type `%s` of trait `%s` is bound to `%s`, which does not satisfy the declared bound `%s: %s`",
                        item_name, trait_str, item_disp, item_name, bound_str),
                    span);
            }
        }
    }


    // -- Symbolic generic-body walk drivers (drive visit(body); stay here) --

    /// Type-check one generic body against abstract parameter refs.
    ///
    /// This is the ONLY pass that types a generic template body, and what it
    /// leaves on that body is load-bearing twice over: it reports, ahead of any
    /// instantiation, errors the body would produce, AND it is the resolution
    /// monomorphization and codegen consume downstream — a where-bound call in a
    /// template (`value.hash(&h)` in `digest<T>`) reaches codegen with no
    /// resolved callee if the body was never walked, and lowering a generic
    /// `async function` builds its state machine out of these very types. So the
    /// walk before monomorphization is unconditional; it is not a diagnostic
    /// add-on to be switched off.
    symbolic_check_body(mut &this, func_decl: DeclarationNode*, this_type: TypeRef,
                        owner_type: TypeRef) -> void {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null || func.body == null) { return; }
        const sink: DiagnosticSink* = this.ctx.diagnostics;
        if (sink == null) { return; }
        const snap: DiagnosticSnapshot = sink.snapshot();
        const saved_owner:    TypeRef = this.state.current_owner_type;
        const saved_symbolic: boolean = this.state.in_symbolic_check;
        const saved_cur_func_decl: DeclarationNode* = this.state.symbolic_current_func;
        this.state.symbolic_current_func = func_decl;
        mut saved_method_nodes: [DeclarationNode*] = [];
        swap(&this.state.symbolic_method_param_nodes, &saved_method_nodes);
        this.state.current_owner_type = owner_type;
        this.state.in_symbolic_check  = true;
        const ar: TypeArena* = this.arena;
        const saved_no_demand: boolean = if (ar != null) { ar.symbolic_no_demand_active } else { false };
        if (ar != null) { ar.set_symbolic_no_demand(true); }
        mut method_nodes: [DeclarationNode*] = [];
        for (mut gp: i64 = 0; gp < func.generic_params.length; gp++) {
            const pnode_decl: DeclarationNode* = func.generic_params[gp];
            const pnode: GenericParamDecl* = DeclarationNode::generic_param_of(pnode_decl);
            if (pnode != null) { method_nodes.push(pnode_decl); }
        }
        this.state.symbolic_method_param_nodes = method_nodes;

        mut eff_this: TypeRef = this_type;
        if (this_type.is_valid() && owner_type.is_valid() && this_type.equals(owner_type)) {
            eff_this = this.symbolic.symbolic_owner_instance(owner_type);
            const written: TypeRef = this.written_receiver_type(func_decl);
            if (written.is_valid()) { eff_this = written; }
        }
        this.enter_function(func_decl, eff_this);
        this.visit_block(func.body);

        if (ar != null) { ar.set_symbolic_no_demand(saved_no_demand); }
        swap(&this.state.symbolic_method_param_nodes, &saved_method_nodes);
        this.state.in_symbolic_check  = saved_symbolic;
        this.state.current_owner_type = saved_owner;
        this.state.symbolic_current_func = saved_cur_func_decl;
        this.state.symbolic_bodies_walked += 1;
        this.state.symbolic_total_would_emit += sink.errors_since(snap) as i64;
    }

    /// The instantiation a method exists for when its receiver is written
    /// with a type of its own (`only_i32(this: &Wrapper<i32>)`), seen through
    /// the reference; invalid for a receiver written `this` or `&this`, which
    /// is the owner with its own parameters.
    written_receiver_type(&this, func_decl: DeclarationNode*) -> TypeRef {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const p_decl: DeclarationNode* = func.parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p == null || !p.is_value_receiver() || p.type_annotation == null) { continue; }
            if (!p.resolved_type.is_valid()) { return TypeRef::invalid(); }
            mut written: TypeRef = p.resolved_type;
            mut t: Type* = this.arena.lookup(written);
            if (t != null && t.kind == TypeKind::Reference) {
                written = t.as_reference().referent;
                t = this.arena.lookup(written);
            }
            // An alias names its target (`this: &WideWrapper`).
            mut depth: i32 = 0;
            while (t != null && t.kind == TypeKind::TypeAlias && depth < 8) {
                const al: TypeAliasType* = t.as_alias();
                if (!al.has_target()) { return TypeRef::invalid(); }
                written = al.target;
                t = this.arena.lookup(written);
                depth += 1;
            }
            return written;
        }
        return TypeRef::invalid();
    }

    /// Walk every method body of a GENERIC owner symbolically.  A method on a
    /// generic owner reaches sema only here, so this is also where an `async` one
    /// is lowered, off the types the walk leaves on its body.
    symbolic_check_owner_methods(mut &this, methods: &[DeclarationNode*], owner_type: TypeRef,
                                 owner_params: &[DeclarationNode*]) -> void {
        const saved_owner_generic: boolean = this.state.symbolic_owner_is_generic;
        mut saved_owner_nodes: [DeclarationNode*] = [];
        swap(&this.state.symbolic_owner_param_nodes, &saved_owner_nodes);
        mut onodes: [DeclarationNode*] = [];
        for (mut i: i64 = 0; i < owner_params.length; i++) {
            const p_decl: DeclarationNode* = owner_params[i];
            const p: GenericParamDecl* = DeclarationNode::generic_param_of(p_decl);
            if (p != null) { onodes.push(p_decl); }
        }
        this.state.symbolic_owner_param_nodes = onodes;
        this.state.symbolic_owner_is_generic  = true;
        for (mut i: i64 = 0; i < methods.length; i++) {
            const method_decl: DeclarationNode* = methods[i];
            const method: MethodDecl* = DeclarationNode::method_of(method_decl);
            if (method == null || method.func == null || DeclarationNode::fn_of(method.func).body == null) { continue; }
            const sym_this: TypeRef = if (method.is_static) { TypeRef::invalid() } else { owner_type };
            // A method on a GENERIC owner reaches sema only here, whether or not
            // it has generic parameters of its own — so this is where an `async`
            // one is lowered, off the types the walk just left on its body.
            const displaced: TypeRef = this.async_lower.begin_body_check(method.func);
            this.symbolic_check_body(method.func, sym_this, owner_type);
            this.async_lower.end_body_check(method.func, displaced);
            if (DeclarationNode::fn_of(method.func).is_async) {
                this.async_lower.lower(method.func);
            }
        }
        swap(&this.state.symbolic_owner_param_nodes, &saved_owner_nodes);
        this.state.symbolic_owner_is_generic  = saved_owner_generic;
    }


    // -- Per-function frame setup --

    /// A resolution context for annotations written in the body being checked:
    /// the annotations carry their own stamps, so it starts with no bindings
    /// and no `This`, and the caller adds what the body is checked under.
    body_res_ctx(&this) -> ResolutionContext {
        return ResolutionContext::new("");
    }

    enter_function(mut &this, func_decl: DeclarationNode*, fn_this_type: TypeRef) -> void {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        this.scopes.reset();
        this.state.return_type     = func.resolved_return_type;
        this.state.return_type_ann = func.return_type_annotation;
        // Provenance for the body's annotations, from the declaration's own
        // span rather than from wherever the walk happens to be standing.
        this.state.async_poll_output = this.async_poll_output_of(func_decl);
        this.state.this_type       = fn_this_type;
        this.state.this_is_mut = false;
        this.state.this_is_by_ref = false;
        this.state.receiver_sym = SymbolID::invalid();
        this.state.current_func = func_decl;
        this.state.in_lambda_depth     = 0;
        this.state.current_lambda      = null;

        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const param_decl: DeclarationNode* = func.parameters[i];
            const param: VarDecl* = DeclarationNode::var_of(param_decl);
            if (param == null) { continue; }
            // A parameter whose annotation failed to resolve was reported
            // where it was written; it is bound with NO type, so a use of it
            // is silent rather than a second report about `void`.
            mut ty: TypeRef = TypeRef::invalid();
            if (param.resolved_type.is_valid()) {
                ty = param.resolved_type;
            } else if (func.is_variadic && i == func.parameters.length - 1
                       && param.type_annotation == null) {
                ty = this.arena.get_pointer_to(this.arena.get_void());
            }
            if (param.is_receiver()) { this.state.receiver_sym = param.sym_id; }
            if (param.is_ref_receiver()) {
                this.state.this_is_mut = param.is_mutable;
                this.state.this_is_by_ref = true;
            } else {
                this.scopes.declare(param.sym_id, ty, param.is_mutable);
                this.scopes.set_kw_span(param.sym_id, param.kw_span);
                if (param.sym_id.is_valid()) { this.state.param_bindings.insert(param.sym_id.table_key()); }
            }
        }
        if (fn_this_type.is_valid() && this.state.receiver_sym.is_valid()) {
            this.scopes.declare(this.state.receiver_sym, fn_this_type, this.state.this_is_mut);
            this.state.param_bindings.insert(this.state.receiver_sym.table_key());
        }
    }


    // -- Statement visitors --

    visit_block(mut &this, block: Stmt*) -> void {
        if (block == null) { return; }
        const b: BlockStmt* = block.as_block();
        const save: i64 = this.scopes.save_scope();
        for (mut i: i64 = 0; i < b.statements.length; i++) {
            this.dispatch_stmt(b.statements[i]);
        }
        this.scopes.restore_scope(save);
    }

    visit_expr_stmt(mut &this, stmt: Stmt*, node: ExprStmt*) -> void {
        this.resolve_expr(node.expression);
    }

    visit_return(mut &this, stmt: Stmt*, node: ReturnStmt*) -> void {
        if (node.expression != null) {
            const saved_expected: TypeRef = this.state.expected_type;
            const declared: TypeRef = this.symbolic.symbolic_narrowed(this.state.return_type);
            if (declared.is_valid()) {
                this.state.expected_type = declared;
            }
            const expr_type: TypeRef = this.resolve_expr(node.expression);
            this.state.expected_type = saved_expected;
            if (expr_type.is_valid() && declared.is_valid()
                    && !this.symbolic.type_has_unresolved_projection(declared)
                    && !this.symbolic.type_has_unresolved_projection(expr_type)
                    && this.symbolic.symbolic_judgeable(declared)
                    && this.symbolic.symbolic_judgeable(expr_type)) {
                this.lambda.refuse_stored_closure(expr_type, declared,
                    if (node.expression != null) { node.expression.span } else { stmt.span }, "a returned value");
                if (!this.checker.can_assign(expr_type, declared)) {
                    match (this.convert_to_object(node.expression, expr_type, declared)) {
                        ObjectConversionOutcome::Converted(c) => { node.expression = c; }
                        ObjectConversionOutcome::Refused => { }
                        ObjectConversionOutcome::Mismatch => {
                            const value_span: SourceSpan = if (node.expression != null) { node.expression.span } else { stmt.span };
                            const ann_span: SourceSpan = annotation_span(this.state.return_type_ann);
                            this.diag.emit_declared_mismatch(
                                ErrorCode::E0200_TYPE_MISMATCH, value_span, declared, this.state.return_type_ann, expr_type,
                                "the function's declared return type doesn't match the value returned here",
                                ann_span, node.expression);
                        }
                    }
                }
            }
            if (this.state.return_type.is_valid()) {
                this.check_return_payload_escape(node.expression, this.state.return_type);
            }
            this.check_return_stack_address(node.expression);
        }
    }

    /// Type `cond` and require it to be exactly `boolean`: a condition is
    /// held to the rule a value assigned to `boolean` is, and no other type
    /// converts to one.
    resolve_condition(mut &this, cond: ExpressionNode*) -> void {
        const ty: TypeRef = this.resolve_expr(cond);
        if (cond == null || !ty.is_valid() || !this.assignment_judgeable(ty)) { return; }
        const want: TypeRef = this.arena.get_bool();
        if (this.checker.can_assign(ty, want)) { return; }
        this.diag.emit_type_mismatch_with_value(ErrorCode::E0200_TYPE_MISMATCH, cond.span,
            want, ty, "a condition must be a `boolean`", SourceSpan::none(), cond);
    }

    visit_if(mut &this, stmt: Stmt*, node: IfStmt*) -> void {
        this.resolve_condition(node.condition);
        this.dispatch_stmt(node.then_stmt);
        if (node.else_stmt != null) { this.dispatch_stmt(node.else_stmt); }
    }

    visit_while(mut &this, stmt: Stmt*, node: WhileStmt*) -> void {
        this.resolve_condition(node.condition);
        this.state.loop_depth += 1;
        this.dispatch_stmt(node.body);
        this.state.loop_depth -= 1;
    }

    visit_do_while(mut &this, stmt: Stmt*, node: DoWhileStmt*) -> void {
        this.state.loop_depth += 1;
        this.dispatch_stmt(node.body);
        this.state.loop_depth -= 1;
        this.resolve_condition(node.condition);
    }

    visit_for(mut &this, stmt: Stmt*, node: ForStmt*) -> void {
        const save: i64 = this.scopes.save_scope();
        if (!node.init.is_null()) {
            if (node.init.as_stmt() != null) {
                const init_stmt: Stmt* = node.init.as_stmt();
                match (init_stmt.kind) {
                    StmtKind::Decl(d) => { this.visit_decl_stmt(init_stmt, d); }
                    StmtKind::Expr(e) => { this.resolve_expr(e.expression); }
                    _ => {}
                }
            } else if (DeclarationNode::var_of(node.init.as_decl()) != null) {
                const decl: DeclarationNode* = node.init.as_decl();
                const var_node: VarDecl* = DeclarationNode::var_of(decl);
                if (var_node.type_annotation == null) {
                    const init_e: ExpressionNode* = var_node.initializer;
                    const init_is_lambda: boolean = ExpressionNode::lambda_of(init_e) != null;
                    if (!init_is_lambda) {
                        const var_name: string = this.intern.resolve(var_node.name);
                        mut diag: Diagnostic = Diagnostic::error(
                            ErrorCode::E0104_EXPECTED_TYPE,
                            fmt::format("for-loop initializer `%s` needs a type annotation; type inference is only available for lambda initializers", var_name));
                        diag = diag.at_with_label(decl.span, "missing `:` and type annotation");
                        this.ctx.emit_diagnostic(diag);
                    }
                }
                // Past the annotation rule a for-loop's binding is a declaration
                // like any other: its initializer is typed under the declared
                // type and checked against it.
                this.check_var_decl(decl, var_node);
                this.register_var_decl_local(var_node);
            }
        }
        if (node.condition != null) { this.resolve_condition(node.condition); }
        if (node.update != null)    { this.resolve_expr(node.update); }
        this.state.loop_depth += 1;
        this.dispatch_stmt(node.body);
        this.state.loop_depth -= 1;
        this.scopes.restore_scope(save);
    }

    visit_loop(mut &this, stmt: Stmt*, node: LoopStmt*) -> void {
        this.state.loop_depth += 1;
        this.dispatch_stmt(node.body);
        this.state.loop_depth -= 1;
    }

    visit_break(mut &this, stmt: Stmt*) -> void {
        if (this.state.loop_depth == 0) {
            this.ctx.emit_error_at(ErrorCode::E0400_INVALID_BREAK,
                "`break` outside of a loop", stmt.span);
        }
    }

    visit_continue(mut &this, stmt: Stmt*) -> void {
        if (this.state.loop_depth == 0) {
            this.ctx.emit_error_at(ErrorCode::E0401_INVALID_CONTINUE,
                "`continue` outside of a loop", stmt.span);
        }
    }

    visit_unsafe_block(mut &this, stmt: Stmt*, node: UnsafeBlockStmt*) -> void {
        this.visit_block(node.block);
    }

    visit_asm_block(mut &this, stmt: Stmt*, node: AsmBlockStmt*) -> void {
        // A mandatory `![arch(<arch>, <dialect>)]` directive supplies the
        // arch (gating) and dialect; its absence is an error.
        if (node.arch == "") {
            this.ctx.emit_error_at(ErrorCode::E0111_INVALID_SYNTAX,
                "`asm` block requires an `![arch(<arch>, <dialect>)]` directive above it",
                stmt.span);
        }
        // Module-level (naked / global) asm is operand-free.
        if (node.is_module_level) {
            if (node.operands.length > 0) {
                this.ctx.emit_error_at(ErrorCode::E0111_INVALID_SYNTAX,
                    "module-level `asm` block cannot bind `{...}` operands (naked/global asm only)",
                    stmt.span);
            }
            return;
        }
        // Type-check each operand expression so codegen sees resolved types.
        for (mut i: i64 = 0; i < node.operands.length; i++) {
            const op: AsmOperand = node.operands[i];
            if (op.expr == null) { continue; }
            this.resolve_expr(op.expr);
        }
    }

    visit_match_stmt(mut &this, stmt: Stmt*, node: MatchStmt*) -> void {
        const subject_type: TypeRef = this.resolve_expr(node.subject);
        const caller_backed: boolean = this.subject_is_caller_backed(node.subject);
        for (mut i: i64 = 0; i < node.arms.length; i++) {
            const arm: MatchArmNode* = node.arms[i];
            if (arm == null) { continue; }
            const save: i64 = this.scopes.save_scope();
            this.patterns.bind_arm_patterns(arm, subject_type, caller_backed);
            if (arm.guard != null) { this.resolve_condition(arm.guard); }
            if (arm.body != null) { this.dispatch_stmt(arm.body); }
            this.scopes.restore_scope(save);
        }
        this.patterns.check_match_exhaustive(node.subject, subject_type, node.arms, stmt.span);
        this.patterns.check_duplicate_default_arm(node.arms);
        this.patterns.check_literal_patterns(node.arms, subject_type);
    }

    visit_static_match_stmt(mut &this, stmt: Stmt*, node: StaticMatchStmt*) -> void {
        if (node.arms.length == 0) { return; }
        if (node.arms.length > 1 && !this.state.in_symbolic_check) {
            this.ctx.emit_error_at(ErrorCode::E0645_NO_STATIC_MATCH_ARM,
                "`static match` outside a generic context is not supported yet (its type could not be resolved to a single arm)",
                stmt.span);
        }
        // A concrete (already-pruned) static match has exactly one arm.
        if (this.state.in_symbolic_check && ASTCloner::has_multi_type_arm(&node.arms)) {
            node.arms = ASTCloner::split_multi_type_arms(&node.arms);
        }
        const n_arms: i64 = if (this.state.in_symbolic_check) { node.arms.length } else { 1 };
        for (mut ai: i64 = 0; ai < n_arms; ai++) {
            const arm: StaticMatchArmNode* = node.arms[ai];
            if (arm == null || arm.body == null) { continue; }
            this.walk_static_match_arm(node.scrutinee, arm, false, TypeRef::invalid());
        }
    }

    visit_decl_stmt(mut &this, stmt: Stmt*, node: DeclStmt*) -> void {
        if (node.declaration == null) { return; }
        const decl: DeclarationNode* = node.declaration;
        const dd: DestructureDecl* = DeclarationNode::destructure_of(node.declaration);
        if (dd != null) {
            this.visit_destructure(node.declaration, dd);
            return;
        }
        if (DeclarationNode::var_of(decl) == null) { return; }
        const var_node: VarDecl* = DeclarationNode::var_of(decl);
        this.check_var_decl(node.declaration, var_node);
        this.register_var_decl_local(var_node);
    }

    /// A declaration written at MODULE scope.  It reaches sema as a bare
    /// `VarDecl` in the program's statement list, not wrapped in the
    /// `DeclStmt` a body uses, so without this override `accept` found
    /// nothing and a global's initializer was never resolved: no type for
    /// codegen's constant folder to work from (the global then landed on the
    /// zero fallback), and no diagnostic for anything wrong inside it - naming
    /// an enum variant that does not exist compiled clean.
    ///
    /// Guarded on `is_global` so this cannot become a second answering path for
    /// a local; the statement form and the for-loop form own those.
    visit_var(mut &this, decl: DeclarationNode*, node: VarDecl*) -> void {
        if (node == null || !node.is_global) { return; }
        if (node.owner != null) { this.refuse_constant_member_clash(decl, node); }
        if (this.typed_before_bodies(node)) { return; }
        this.check_var_decl(decl, node);
    }

    /// A type's constant shares its name with no other member of the type -
    /// a field, a method (static or not, in any `implement` block) or an
    /// enum variant - so `T::NAME` and a member reached any other way never
    /// name two things (E0205).  Run once every `implement` block's methods
    /// are registered, which the name layer's walk of the constant precedes.
    refuse_constant_member_clash(mut &this, decl: DeclarationNode*, node: VarDecl*) -> void {
        const owner: TypeRef = this.ctx.decl_index.type_of_def(this.ctx.defs.parent_of(node.def));
        const t: Type* = this.arena.lookup(owner);
        if (t == null) { return; }
        mut clash: string = "";
        if (t.kind == TypeKind::Struct && t.as_struct().field_position(node.name) >= 0) {
            clash = "a field";
        } else if (t.kind == TypeKind::Enum && t.as_enum().variant_index(node.name) >= 0) {
            clash = "a variant";
        } else if (this.calls.owner_declares_member(owner, node.name)) {
            clash = "a method";
        }
        if (clash == "") { return; }
        this.ctx.emit_error_at(ErrorCode::E0205_REDEFINED_SYMBOL,
            fmt::format("the constant `%s` has the name of %s of `%s`; a type's constants and other members need distinct names",
                this.intern.resolve(node.name), clash, this.arena.format_display(t)),
            decl.name_span);
    }

    /// Whether `node` is a module-level variable with no written type and an
    /// initializer, which `type_unwritten_globals` checked before any body.
    typed_before_bodies(&this, node: VarDecl*) -> boolean {
        return node.type_annotation == null && node.has_initializer();
    }

    /// Check and register, before any body is checked, every module-level
    /// variable whose type is its initializer's.  Type resolution registers a
    /// global whose type is written; one with no written type has none until
    /// its initializer is typed, and a body that reads it - in this module,
    /// above or below it, or in a module that imports this one - finds it
    /// only through its registration.
    type_unwritten_globals(mut &this, root: ProgramNode*) -> void {
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: DeclarationNode* = root.statements[i].as_decl();
            if (stmt == null || DeclarationNode::var_of(stmt) == null) { continue; }
            const var_node: VarDecl* = DeclarationNode::var_of(stmt);
            if (!var_node.is_global || !this.typed_before_bodies(var_node)) { continue; }
            const registered: boolean = var_node.resolved_type.is_valid();
            const decl: DeclarationNode* = stmt;
            this.check_var_decl(decl, var_node);
            if (!registered && var_node.resolved_type.is_valid()) {
                TypeResolutionRunner::register_module_global(this.ctx, decl, var_node);
            }
        }
    }

    /// Resolve and type-check one variable declaration: its annotation, its
    /// initializer (resolved under that annotation as the expected type), the
    /// type inferred from the initializer when there is no annotation, and the
    /// E0200 agreement between the two.  Shared by the statement form and the
    /// module-level form - they reach sema through different visitors and must
    /// not answer this differently.
    check_var_decl(mut &this, decl: DeclarationNode*, var_node: VarDecl*) -> void {

        // A type-less binding with no initializer has nothing to infer from.
        // With an initializer, the binding's type is inferred from it below
        // (general local type inference; see the `resolved_type = init_type`
        // step). A void-valued initializer is rejected there, after we know
        // the initializer's type.
        if (var_node.type_annotation == null && !var_node.has_resolved_type()
                && !var_node.is_auto && !var_node.has_initializer()) {
            const var_name: string = this.intern.resolve(var_node.name);
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0104_EXPECTED_TYPE,
                fmt::format("variable `%s` needs a type annotation or an initializer to infer from: write `: T` or `= <expr>`", var_name));
            diag = diag.at_with_label(decl.span, "no `:` type and no `=` initializer to infer from");
            this.ctx.emit_diagnostic(diag);
        }

        if (!var_node.has_resolved_type() && var_node.type_annotation != null) {
            this.prime_typeof_annotation(var_node.type_annotation);
            mut res_ctx: ResolutionContext = this.body_res_ctx();
            this.symbolic.symbolic_bind_params(&res_ctx);
            const vtype: TypeRef = this.ctx.type_resolver.resolve(var_node.type_annotation, &res_ctx);
            if (vtype.is_valid()) { var_node.resolved_type = vtype; }
            else { this.refuse_unresolved_body_annotation(var_node.type_annotation); }
        }

        if (var_node.has_initializer()) {
            const saved_expected: TypeRef = this.state.expected_type;
            const saved_binding: SymbolStr = this.state.untyped_binding;
            const saved_init: ExpressionNode* = this.state.untyped_init;
            if (var_node.has_resolved_type()) {
                this.state.expected_type = var_node.resolved_type;
                this.state.untyped_binding = SymbolStr::empty();
                this.state.untyped_init = null;
            } else {
                this.state.untyped_binding = var_node.name;
                this.state.untyped_init = var_node.initializer;
            }
            mut init_type: TypeRef = this.resolve_expr(var_node.initializer);
            this.state.expected_type = saved_expected;
            this.state.untyped_binding = saved_binding;
            this.state.untyped_init = saved_init;

            if (var_node.is_auto && init_type.is_valid() && var_node.initializer != null) {
                const arr_t: Type* = this.arena.lookup(init_type);
                if (arr_t != null && arr_t.kind == TypeKind::Array) {
                    const at: ArrayType* = arr_t.as_array();
                    {
                        const orig_init: ExpressionNode* = var_node.initializer;
                        const sp: SourceSpan = orig_init.span;
                        const zero_lit: ExpressionNode* = ExpressionNode::literal("0", LiteralKind::Integer, sp);
                        const idx: ExpressionNode* = ExpressionNode::array_access_expr(orig_init, zero_lit, sp);
                        const amp_tok: Token = Token::new(TokenType::Amp, "&", sp.start_line as int, sp.start_col as int);
                        const amp: ExpressionNode* =
                            ExpressionNode::synthetic_unary(amp_tok, idx, sp);
                        const n_str: string = fmt::format("%ld", at.size);
                        const n_lit: ExpressionNode* = ExpressionNode::literal(n_str, LiteralKind::Integer, sp);
                        const slice_sym: SymbolStr = this.intern.intern("Slice");
                        const from_raw_sym: SymbolStr = this.intern.intern("from_raw");
                        const sr_e: ExpressionNode* = ExpressionNode::scope_resolution_expr(slice_sym, from_raw_sym, sp);
                        mut sr: ScopeResolutionExpr* = ExpressionNode::scope_resolution_of(sr_e);
                        // The reference is to the stdlib `Slice`, which the
                        // prelude carries so this lowering can name it - the
                        // one declaration it means, whatever the writing
                        // module's own scope holds under that leaf.  A
                        // synthesizer owes its node the definition it refers
                        // to, and this one knows it without a lookup.
                        sr.set_synthesized_res(
                            this.ctx.generic_registry.wellknown(LangItem::Slice));
                        mut elt_named: NamedAnnotation* = new NamedAnnotation {
                            name: SymbolStr::empty(), span: sp, pre_resolved: at.element,
                            res: ResSlot::Pending,
                        };
                        const elt_ann: TypeAnnotation* = new TypeAnnotation::Named(elt_named);
                        mut gen_args: [TypeAnnotation*] = [];
                        gen_args.push(elt_ann);
                        sr.set_scope_generic_args(gen_args);
                        mut call: ExpressionNode* = ExpressionNode::call_expr(sr_e, sp);
                        ExpressionNode::call_of(call).add_argument(amp);
                        ExpressionNode::call_of(call).add_argument(n_lit);
                        var_node.set_initializer(call);
                        init_type = this.resolve_expr(var_node.initializer);
                    }
                }
                // The loop calls `Iterator::next` on this binding, so the
                // scrutinee is an iterator when its type implements the
                // language's `Iterator` - never because it has a method
                // spelled `next`.  A collection that is not one is iterated
                // through its `iter()`.
                const iterator_id: DefId = this.ctx.generic_registry.wellknown(LangItem::Iterator);
                if (!this.for_scrutinee_iterates(init_type, iterator_id)) {
                    const owner_ref: TypeRef = this.types.method_owner_ref(this.for_scrutinee_subject(init_type));
                    if (owner_ref.is_valid()) {
                        if (this.ctx.decl_index.lookup_family_entries(
                                FamilyOwner::Type(owner_ref), this.intern.intern("iter")).length > 0) {
                            const orig_init: ExpressionNode* = var_node.initializer;
                            const wrap_span: SourceSpan = orig_init.span;
                            mut iter_member: ExpressionNode* = ExpressionNode::member_access_expr(orig_init, this.intern.intern("iter"), wrap_span, wrap_span);
                            mut iter_call: ExpressionNode* = ExpressionNode::call_expr(iter_member, wrap_span);
                            var_node.set_initializer(iter_call);
                            init_type = this.resolve_expr(var_node.initializer);
                        }
                    }
                    // Refused once, here, at the scrutinee: the binding keeps
                    // no type, so the `next` call the loop makes on it reports
                    // nothing further.  An `iter()` that failed has already
                    // said why.
                    if (init_type.is_valid() && !this.for_scrutinee_iterates(init_type, iterator_id)) {
                        if (!this.state.in_symbolic_check) {
                            const shown: string = this.arena.resolve_display_name_short(
                                this.for_scrutinee_subject(init_type));
                            mut d: Diagnostic = Diagnostic::error(ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
                                fmt::format("`%s` does not implement `Iterator`", shown));
                            d = d.at_with_label(var_node.initializer.span,
                                fmt::format("no `implement trait Iterator for %s` selects an implementation here", shown));
                            this.ctx.emit_diagnostic(d);
                        }
                        init_type = TypeRef::invalid();
                    }
                }
            }

            const imp_ann: ImplTraitAnnotation* = this.impl_trait_annotation_of(var_node.type_annotation);
            const init_t_node: Type* = this.arena.lookup(init_type);
            const init_is_void: boolean = init_t_node != null && init_t_node.kind == TypeKind::Void;
            // General local type inference: a binding with no annotation adopts
            // the initializer's type. When an annotation is present resolved_type
            // is already set above (and wins); the lambda / for-loop `is_auto` /
            // impl-trait cases are subsumed here. The inferred type is the
            // concrete type the initializer produces - not an erased
            // `implement Trait` - so methods on it stay callable.  A binding
            // whose annotation was REFUSED keeps no type at all: the type it
            // was declared with is not the initializer's, and a use of it
            // reported against the initializer's type (`no field on i32`)
            // blames a type the program never wrote.
            if (!var_node.has_resolved_type() && init_type.is_valid() && !init_is_void
                    && var_node.initializer != null
                    && !TypeAnnotation::refused(var_node.type_annotation)) {
                var_node.resolved_type = init_type;
            }
            // A type-less binding whose initializer yields no value can't be
            // inferred: surface that rather than silently binding `void`.
            if (var_node.type_annotation == null && !var_node.has_resolved_type()
                    && !var_node.is_auto && init_is_void) {
                const var_name: string = this.intern.resolve(var_node.name);
                mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0104_EXPECTED_TYPE,
                    fmt::format("cannot infer the type of `%s`: its initializer produces no value (`void`); add a `: T` annotation or use a value-producing initializer", var_name));
                diag = diag.at_with_label(decl.span, "binding has no inferable type");
                this.ctx.emit_diagnostic(diag);
            }
            if (imp_ann != null && init_type.is_valid()) {
                this.verify_impl_trait_bounds(imp_ann, init_type, var_node);
            }
            if (var_node.type_annotation != null && var_node.has_resolved_type()) {
                this.literals.refuse_narrowing_constant(var_node.initializer, var_node.resolved_type);
            }
            if (var_node.has_resolved_type() && init_type.is_valid() && imp_ann == null
                    && this.symbolic.symbolic_judgeable(init_type)
                    && this.symbolic.symbolic_judgeable(var_node.resolved_type)) {
                this.lambda.refuse_stored_closure(init_type, var_node.resolved_type,
                    if (var_node.initializer != null) { var_node.initializer.span } else { decl.span }, "a variable");
                if (!this.checker.can_assign(init_type, var_node.resolved_type)) {
                    match (this.convert_to_object(var_node.initializer, init_type, var_node.resolved_type)) {
                        ObjectConversionOutcome::Converted(c) => {
                            var_node.set_initializer(c);
                            init_type = var_node.resolved_type;
                        }
                        ObjectConversionOutcome::Refused => { }
                        ObjectConversionOutcome::Mismatch => {
                            const conv: ExpressionNode* = this.calls.build_implicit_conversion(
                                this, var_node.initializer, init_type, var_node.resolved_type);
                            if (conv != null) {
                                var_node.set_initializer(conv);
                                init_type = var_node.resolved_type;
                            } else {
                                const var_name: string = this.intern.resolve(var_node.name);
                                const value_span: SourceSpan = if (var_node.initializer != null) { var_node.initializer.span } else { decl.span };
                                const ann_span: SourceSpan = annotation_span(var_node.type_annotation);
                                this.diag.emit_declared_mismatch(
                                    ErrorCode::E0200_TYPE_MISMATCH, value_span, var_node.resolved_type,
                                    var_node.type_annotation, init_type,
                                    fmt::format("`%s` was declared with this type; the initializer must match", var_name),
                                    ann_span, var_node.initializer);
                            }
                        }
                    }
                }
            }
        }

    }

    /// Bind the declaration's name in the current scope.  Only the statement
    /// form does this: a module-level declaration is already registered as a
    /// global by an earlier pass, and binding it here would shadow that global
    /// with a local for the rest of the module.
    register_var_decl_local(mut &this, var_node: VarDecl*) -> void {
        mut ty: TypeRef = this.arena.get_void();
        mut is_mut: boolean = var_node.is_mutable;
        if (var_node.resolved_type.is_valid()) {
            ty = var_node.resolved_type;
        } else if (var_node.type_annotation != null && TypeAnnotation::refused(var_node.type_annotation)) {
            // The declaration named a type the name layer refused, reported
            // where it was written; bound with NO type, as a parameter is,
            // so a use of it is silent rather than a second report against
            // the initializer's type or `void`.
            ty = TypeRef::invalid();
        } else if (var_node.is_auto) {
            // A `for` loop's iterator binding left untyped: its scrutinee was
            // refused, or failed, where it was written.  Bound with no type,
            // so the `next` call the loop makes on it is silent rather than
            // a second report against the scrutinee's type or `void`.
            ty = TypeRef::invalid();
        } else if (var_node.has_initializer()) {
            // An initializer that produced no type was refused where it was
            // written (a struct literal whose type name was refused, among
            // others): bound with no type, so a use of it is silent rather
            // than a second report against `void`.
            ty = var_node.initializer.resolved_type;
        } else {
            is_mut = false;
        }
        this.scopes.declare(var_node.sym_id, ty, is_mut);
        this.scopes.set_kw_span(var_node.sym_id, var_node.kw_span);
    }

    visit_destructure(mut &this, d: DeclarationNode*, node: DestructureDecl*) -> void {
        if (!node.has_resolved_type() && node.type_annotation != null) {
            mut res_ctx: ResolutionContext = this.body_res_ctx();
            this.symbolic.symbolic_bind_params(&res_ctx);
            const ttype: TypeRef = this.ctx.type_resolver.resolve(node.type_annotation, &res_ctx);
            if (ttype.is_valid()) { node.resolved_type = ttype; }
        }
        if (node.has_initializer()) {
            const saved_expected: TypeRef = this.state.expected_type;
            if (node.has_resolved_type()) { this.state.expected_type = node.resolved_type; }
            const init_type: TypeRef = this.resolve_expr(node.initializer);
            this.state.expected_type = saved_expected;
            if (node.has_resolved_type() && init_type.is_valid()) {
                this.lambda.refuse_stored_closure(init_type, node.resolved_type,
                    if (node.initializer != null) { node.initializer.span } else { d.span }, "a variable");
                if (!this.checker.can_assign(init_type, node.resolved_type)) {
                    const value_span: SourceSpan = if (node.initializer != null) { node.initializer.span } else { d.span };
                    const ann_span: SourceSpan = annotation_span(node.type_annotation);
                    this.diag.emit_declared_mismatch(
                        ErrorCode::E0200_TYPE_MISMATCH, value_span, node.resolved_type, node.type_annotation,
                        init_type, "destructure pattern's declared type must match the initializer",
                        ann_span, node.initializer);
                }
            }
        }
        if (this.symbolic.symbolic_defer_type(node.resolved_type)) {
            this.register_destructure_locals_abstract(d, node);
            return;
        }
        if (!node.has_resolved_type()) { this.register_destructure_locals_void(node); return; }
        const ty: Type* = this.arena.lookup(node.resolved_type);
        if (ty == null) { this.register_destructure_locals_void(node); return; }

        const empty_fields: [FieldInfo] = [];
        mut fields_ptr: &[FieldInfo] = &empty_fields;
        mut got_fields: boolean = false;
        if (ty.kind == TypeKind::Struct) { fields_ptr = &ty.as_struct().fields; got_fields = true; }
        if (!got_fields) {
            const ty_name: string = this.arena.format_display(ty);
            this.ctx.emit_error_at(ErrorCode::E0361_DESTRUCTURE_NON_STRUCT,
                fmt::format("cannot destructure non-struct type '%s'", ty_name), d.span);
            this.register_destructure_locals_void(node);
            return;
        }

        mut names: [SymbolStr] = [];
        for (mut k: i64 = 0; k < fields_ptr.length; k++) { names.push(fields_ptr[k].decl_name().spelling()); }
        const positions: [i64] = this.check_destructure_shape(d, node, &names,
            this.arena.format_display(ty));
        for (mut i: i64 = 0; i < node.bindings.length; i++) {
            mut b: DestructureBinding = node.bindings[i];
            if (positions[i] < 0) {
                this.scopes.declare(b.sym_id, this.arena.get_void(), b.is_mutable);
                continue;
            }
            const field_type: TypeRef = fields_ptr[positions[i]].field_type;
            b.resolved_type = field_type;
            b.field_index = positions[i];
            node.bindings[i] = b;
            this.scopes.declare(b.sym_id, field_type, b.is_mutable);
        }
    }

    /// Report a destructure whose bindings do not match the fields `names`
    /// of the type it destructures (`ty_name` in the messages): a field bound
    /// twice, a field the type does not have, a field left out.  Each
    /// binding's field position in `names`, or -1 for one reported here.
    check_destructure_shape(mut &this, d: DeclarationNode*, node: DestructureDecl*, names: &[SymbolStr],
                            ty_name: string) -> [i64] {
        mut positions: [i64] = [];
        for (mut i: i64 = 0; i < node.bindings.length; i++) {
            const b: DestructureBinding = node.bindings[i];
            mut dup: boolean = false;
            for (mut j: i64 = 0; j < i; j++) {
                if (node.bindings[j].source_field.id == b.source_field.id) { dup = true; break; }
            }
            if (dup) {
                const dup_name: string = this.intern.resolve(b.source_field);
                mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0356_DUPLICATE_FIELD,
                    fmt::format("field `%s` bound more than once in destructure", dup_name));
                diag = diag.at_with_label(b.span, fmt::format("duplicate binding for `%s`", dup_name));
                const prev: DestructureBinding = node.bindings[i - 1];
                if (prev.span.has_location() && b.span.has_location()) {
                    const removal: SourceSpan = SourceSpan::new(b.span.file, prev.span.end_line, prev.span.end_col, b.span.end_line, b.span.end_col);
                    diag = diag.suggest(Suggestion::machine_applicable(removal, "", fmt::format("remove the duplicate binding `%s`", dup_name)));
                }
                this.ctx.emit_diagnostic(diag);
                positions.push(-1);
                continue;
            }
            mut pos: i64 = -1;
            for (mut k: i64 = 0; k < names.length; k++) {
                if (names[k].id == b.source_field.id) { pos = k; break; }
            }
            if (pos < 0) {
                const field_name: string = this.intern.resolve(b.source_field);
                mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0350_STRUCT_FIELD_NOT_FOUND,
                    fmt::format("no field `%s` on type `%s`", field_name, ty_name));
                diag = diag.at_with_label(b.span, "unknown field");
                mut cands: [string] = [];
                for (mut k: i64 = 0; k < names.length; k++) { cands.push(this.intern.resolve(names[k])); }
                diag = diag.did_you_mean(field_name, cands, "field", b.span);
                this.ctx.emit_diagnostic(diag);
            }
            positions.push(pos);
        }

        if (node.bindings.length < names.length) {
            mut missing: string = "";
            mut count: i64 = 0;
            for (mut k: i64 = 0; k < names.length; k++) {
                mut bound: boolean = false;
                for (mut bi: i64 = 0; bi < node.bindings.length; bi++) {
                    if (node.bindings[bi].source_field.id == names[k].id) { bound = true; break; }
                }
                if (!bound) {
                    if (count > 0) { missing = fmt::format("%s, %s", missing, this.intern.resolve(names[k])); }
                    else { missing = this.intern.resolve(names[k]); }
                    count++;
                }
            }
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0362_DESTRUCTURE_INCOMPLETE,
                fmt::format("destructure of `%s` must bind all %lld field(s); missing: %s", ty_name, names.length, missing));
            diag = diag.at_with_label(d.span, fmt::format("missing %lld field%s", count, if (count == 1) { "" } else { "s" }));
            this.ctx.emit_diagnostic(diag);
        }
        return positions;
    }

    /// A destructure in a generic body whose type still names the body's
    /// parameters (`const { inner }: PathBuf<A> = this;`): each binding is
    /// typed as its field seen through that type, so a call on it is selected
    /// before monomorphization as a call on `this.inner` is.  The shape is
    /// checked here, against the fields the template declares - they are
    /// every specialization's fields, in the same order - so a broken
    /// destructure is refused whether or not anything instantiates the body.
    /// A type with no field list on the generic body (a type parameter, a
    /// projection) is not checked.  Each binding's type is recorded on the
    /// template, which every copy substitutes.
    register_destructure_locals_abstract(mut &this, d: DeclarationNode*, node: DestructureDecl*) -> void {
        mut names: [SymbolStr] = [];
        mut positions: [i64] = [];
        if (node.has_resolved_type() && this.member.template_field_names(node.resolved_type, &names)) {
            positions = this.check_destructure_shape(d, node, &names,
                this.arena.resolve_display_name(node.resolved_type));
        }
        for (mut i: i64 = 0; i < node.bindings.length; i++) {
            const b: DestructureBinding = node.bindings[i];
            mut ty: TypeRef = TypeRef::invalid();
            const refused: boolean = positions.length > i && positions[i] < 0;
            if (node.has_resolved_type() && !refused) {
                ty = this.member.field_of(node.resolved_type, b.source_field).ty;
            }
            if (ty.is_valid()) { node.bindings[i].resolved_type = ty; }
            if (positions.length > i) { node.bindings[i].field_index = positions[i]; }
            if (!ty.is_valid()) { ty = this.arena.get_void(); }
            this.scopes.declare(b.sym_id, ty, b.is_mutable);
        }
    }

    register_destructure_locals_void(mut &this, node: DestructureDecl*) -> void {
        for (mut i: i64 = 0; i < node.bindings.length; i++) {
            const b: DestructureBinding = node.bindings[i];
            this.scopes.declare(b.sym_id, this.arena.get_void(), b.is_mutable);
        }
    }


    // -- Dispatch by kind --

    /// Hand `n` to the check for its kind; an expression's type is what
    /// `resolve_expr` returns.  The kinds with no check of their own are
    /// reached through their owners (a method through its implement block, a
    /// match arm through its match) or need none.
    dispatch_node(mut &this, n: Node) -> void {
        if (n.is_null()) { return; }
        match (n) {
            Node::Program(p) => { this.visit_program(p); }

            Node::Expr(e) => {
                this.resolve_expr(e);
            }

            Node::Stmt(s) => { this.dispatch_stmt(s); }

            Node::Arm(_) | Node::StaticArm(_) | Node::Pattern(_) | Node::Directive(_) => { }

            Node::Decl(d) => {
                match (d.kind) {
                    DeclKind::Function(_) => { this.visit_function(d); }
                    DeclKind::Destructure(dd) => { this.visit_destructure(d, dd); }
                    DeclKind::Variable(v)     => { this.visit_var(d, v); }
                    DeclKind::Trait(t)        => { this.visit_trait(t); }
                    DeclKind::Union(u)        => { this.visit_union(u); }
                    DeclKind::Struct(s)       => { this.visit_struct(s); }
                    DeclKind::Impl(ib)        => { this.visit_impl(d, ib); }
                    // None of these has a check here; a method is checked
                    // with its owner.
                    DeclKind::Method(_) | DeclKind::Import(_) | DeclKind::Intrinsic(_)
                    | DeclKind::Module(_) | DeclKind::Variant(_) | DeclKind::Extern(_)
                    | DeclKind::TypeAlias(_) | DeclKind::Field(_) | DeclKind::GenericParam(_)
                    | DeclKind::Enum(_) => { }
                }
            }
        }
    }


    // -- The authoritative expression dispatch --

    resolve_expr(mut &this, expr: ExpressionNode*) -> TypeRef {
        if (expr == null) { return TypeRef::invalid(); }
        if (expr.has_resolved_type()) {
            return expr.resolved_type;
        }
        const result: TypeRef = this.resolve_expr_shape(expr);
        if (result.is_valid()) { expr.set_resolved_type(result); }
        return result;
    }

    /// The type of an expression whose kind has a payload; `resolve_expr`
    /// records it on the header.
    resolve_expr_shape(mut &this, expr: ExpressionNode*) -> TypeRef {
        return match (expr.kind) {
            ExprKind::Sizeof(s) => {
                if (!s.operand_type.is_valid()) {
                    s.set_operand_type(this.resolve_layout_operand(s.type_ann));
                }
                this.arena.get_u64()
            }
            ExprKind::Alignof(a) => {
                if (!a.operand_type.is_valid()) {
                    a.set_operand_type(this.resolve_layout_operand(a.type_ann));
                }
                this.arena.get_u64()
            }
            ExprKind::Typeof(te) => {
                this.resolve_expr(te.operand);
                this.ctx.emit_error_at(ErrorCode::E0209_INVALID_OPERATION,
                    "`typeof` may only be used in type position (e.g. `const y: typeof(x)`)", expr.span);
                TypeRef::invalid()
            }
            ExprKind::Delete(d) => {
                this.refuse_delete_of_non_pointer(d.operand, this.resolve_expr(d.operand));
                this.arena.get_void()
            }
            // Made by this pass around an operand it already resolved; a
            // walk that meets it again keeps its object type.
            ExprKind::ObjectConversion(_) => { expr.resolved_type }
            // A `yield` has no type: codegen refuses it.
            ExprKind::Yield(_) => { TypeRef::invalid() }
            ExprKind::Identifier(i) => {
                this.calls.located_value_checked(expr, this.resolve_identifier(expr, i))
            }
            ExprKind::ScopeResolution(s) => {
                this.calls.located_value_checked(expr, this.resolve_scope_resolution(expr, s))
            }
            ExprKind::MemberAccess(m) => { this.member.resolve_member_access(this, expr, m) }
            ExprKind::Try(t)   => { this.resolve_try_expr(expr, t) }
            ExprKind::New(ne)  => { this.resolve_new_expr(expr, ne) }
            ExprKind::Tuple(t) => { this.resolve_tuple_literal(t) }
            ExprKind::Array(a) => { this.resolve_array_literal(expr, a) }
            ExprKind::Struct(s) => { this.resolve_struct_literal(expr, s) }
            ExprKind::Literal(l) => { this.literals.resolve_literal(expr, l) }
            ExprKind::Ternary(t) => { this.resolve_ternary(t) }
            ExprKind::If(i) => { this.resolve_if_expr(i) }
            ExprKind::StaticMatch(s) => { this.resolve_static_match_expr(expr, s) }
            ExprKind::Match(m) => { this.resolve_match_expr(expr, m) }
            ExprKind::Cast(c) => { this.resolve_cast(expr, c) }
            ExprKind::Unary(u) => { this.resolve_unary(expr, u) }
            ExprKind::Binary(b) => { this.resolve_binary(expr, b) }
            ExprKind::ArrayAccess(a) => { this.member.resolve_array_access(this, expr, a) }
            ExprKind::Lambda(l) => { this.lambda.resolve_lambda(this, expr, l) }
            ExprKind::Await(a) => { this.resolve_await(expr, a) }
            ExprKind::Call(c) => { this.calls.resolve_call(this, expr, c) }
        };
    }

    /// Type an `await e`: `e` must be a `Future`, and the await evaluates to
    /// that future's `Output` associated type. Projecting `F::Output` here (a)
    /// types the body before `AsyncLower` runs so `const v = await e;` binds `v`
    /// at the right type, and (b) leaves the projected type cached on the node
    /// so the lowering can read the awaited future type (`operand`) and its
    /// result type (this node) without re-projecting.
    resolve_await(mut &this, e: ExpressionNode*, node: AwaitExpr*) -> TypeRef {
        if (node == null || node.operand == null) { return TypeRef::invalid(); }
        this.check_await_in_async_body(e);
        const fut_ty: TypeRef = this.resolve_expr(node.operand);
        if (!fut_ty.is_valid()) { return TypeRef::invalid(); }
        const out_sym: SymbolStr = this.intern.intern("Output");
        mut rc: ResolutionContext = ResolutionContext::new("");
        // `Output` is the language's `Future`'s, whatever else the operand's
        // type implements.
        const future_decl: TraitDecl* = this.ctx.generic_registry.lang_trait_decl(LangItem::Future);
        const future_ty: TypeRef = if (future_decl != null) {
            this.ctx.decl_index.type_of_def(future_decl.def)
        } else {
            TypeRef::invalid()
        };
        const out_slot: i64 = if (future_decl == null) { -1 } else { future_decl.assoc_type_index(out_sym) };
        const out_ty: TypeRef = this.ctx.type_resolver.resolve_concrete_member(fut_ty, out_slot, future_decl, &rc);
        if (out_ty.is_valid()) { return out_ty; }
        // An operand typed by an associated-type projection (`s.read(n)` typed
        // `S::ReadFut` inside a generic body) has no impl to read a binding from
        // yet. Its Output is the nested projection `(S::ReadFut)::Output` —
        // abstract, but precisely what monomorphization reduces once `S` is
        // bound, and the lowering needs a valid type to build the frame field
        // from. Restricted to the symbolic walk: a CONCRETE operand that fails
        // the lookup genuinely does not implement `Future` and must still be
        // diagnosed below.
        if (this.state.in_symbolic_check && this.arena.contains_generic_param(fut_ty)) {
            const declared: TypeRef = this.async_trait_method_output(fut_ty);
            if (declared.is_valid()) { return declared; }
            const sym_out: TypeRef = this.ctx.type_resolver.project_member(fut_ty, out_sym, future_ty, &rc);
            if (sym_out.is_valid()) { return sym_out; }
        }
        if (!out_ty.is_valid()) {
            const disp: string = this.arena.resolve_display_name(fut_ty);
            this.ctx.emit_error_at(ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
                fmt::format("`await` requires an expression whose type implements `Future`; `%s` does not", disp),
                e.span);
            return TypeRef::invalid();
        }
        return out_ty;
    }

    /// E0600: an `await` outside the body of an `async` function or method.
    /// Only an `async` body is lowered into a state machine that can
    /// suspend; a lambda's body is a function of its own and is never one.
    /// The `await` is still typed, so what reads its value is checked as
    /// written and the refusal is the only report.
    check_await_in_async_body(mut &this, e: ExpressionNode*) -> void {
        const in_lambda: boolean = this.state.in_lambda_depth > 0;
        const f: FunctionDecl* = DeclarationNode::fn_of(this.state.current_func);
        if (!in_lambda && f != null && f.is_async) { return; }
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0600_CODEGEN_FAILED,
            "`await` is only allowed in the body of an `async` function or method");
        mut label: string = "the enclosing function is not `async`";
        if (in_lambda) {
            label = "a lambda's body is a function of its own, and it is not `async`";
        } else if (f == null) {
            label = "this is outside every function";
        }
        d = d.at_with_label(e.span, label);
        this.ctx.emit_diagnostic(d);
    }


    /// The Output of `fut_ty` when it is the implicit `<Method>Fut` of an
    /// `async` trait method: that method's declared return, with `This` read
    /// as the projection's base.  Each implementation binds the associated
    /// type to the future its own `async` method lowers to, whose Output is
    /// that method's return, so every implementation agrees on it and a
    /// generic body knows it before any copy exists - which is what lets a `?`
    /// on the awaited value be shaped there.  Invalid for any other type, and
    /// for a method of a generic trait, whose return may name the trait's
    /// parameters.
    async_trait_method_output(mut &this, fut_ty: TypeRef) -> TypeRef {
        const t: Type* = this.arena.lookup(fut_ty);
        if (t == null || t.kind != TypeKind::AssocProjection) { return TypeRef::invalid(); }
        const ap: AssocProjectionType* = t.as_assoc_projection();
        if (ap.slot < 0) { return TypeRef::invalid(); }
        const tdecl: TraitDecl* = this.ctx.generic_registry.get_trait_decl(
            this.ctx.decl_index.def_of(ap.owning_trait, this.ctx.type_arena));
        if (tdecl == null || tdecl.generic_params.length > 0) { return TypeRef::invalid(); }
        for (mut i: i64 = 0; i < tdecl.methods.length; i++) {
            const f_decl: DeclarationNode* = tdecl.methods[i];
            const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
            if (f == null || !f.is_async || f.async_fut_slot != ap.slot) { continue; }
            if (f.return_type_annotation == null) { return TypeRef::invalid(); }
            mut rc: ResolutionContext = ResolutionContext::new("");
            const declared: TypeRef = this.ctx.type_resolver.resolve(f.return_type_annotation, &rc);
            if (!declared.is_valid()) { return TypeRef::invalid(); }
            return this.binding.subst_this_in_type(declared, ap.base);
        }
        return TypeRef::invalid();
    }

    // -- Expression resolvers kept on the main visitor --

    /// Whether `id` is a use of the receiver of the method being checked: the
    /// binding it names is the receiver parameter's.  Every instance method
    /// has that parameter, written or synthesized, and the name layer binds
    /// it as `this`, so the identity answers where the spelling would also
    /// answer for a local or capture that happens to be spelled `this`.
    names_receiver(&this, id: IdentifierExpr*) -> boolean {
        if (id == null || !this.state.receiver_sym.is_valid()) { return false; }
        return id.res.local_sym().key() == this.state.receiver_sym.key();
    }

    resolve_identifier(mut &this, e: ExpressionNode*, ident: IdentifierExpr*) -> TypeRef {
        if (this.names_receiver(ident)) {
            if (this.state.this_type.is_valid()) { return this.state.this_type; }
            if (e.resolved_type.is_valid()) { return e.resolved_type; }
        }
        const sym: SymbolID = ident.res.local_sym();
        const local: TypeRef = this.scopes.type_of(sym);
        if (local.is_valid()) { return local; }
        // Bound, with no type: the declaration failed to type and said so.
        if (this.scopes.binds(sym)) { return TypeRef::invalid(); }
        if (this.state.in_lambda_depth > 0 && this.state.current_lambda != null) {
            match (this.scopes.outer_type_of(sym)) {
                Option::Some(outer_ty) => { return this.lambda.record_lambda_capture(e, ident, outer_ty); }
                Option::None => { /* fall through */ }
            }
        }
        const global: TypeRef = this.types.spelling_global(ident.res);
        if (global.is_valid()) { return global; }
        const name_str: string = this.intern.resolve(ident.name);
        // A function named as a value.  The stamp is the writer's own answer
        // and a canonical name, so the index either holds it or the name is
        // not a function; the bare leaf would answer from whichever module
        // registered it last, and for a name no import offers - a private
        // declaration elsewhere - from a module the writer cannot see.
        mut func_ty: TypeRef = TypeRef::invalid();
        mut def_id: DefId = DefId::invalid();
        match (ident.res) {
            ResSlot::Answered(r) => {
                func_ty = this.ctx.decl_index.func_type_of_res(r);
                def_id = r.def_id();
            }
            _ => { }
        }
        if (func_ty.is_valid()) {
            if (ident.resolved_callee.is_some()) {
                this.calls.enforce_value_ref_visibility(def_id, e.span);
                return func_ty;
            }
            // A family holding a generic function: the overload the
            // turbofish and the expected type choose.
            mut refused: boolean = false;
            const chosen: OverloadId = this.calls.value_family_entry(def_id, &ident.generic_args, name_str,
                e.span, e, &refused);
            if (refused) { return TypeRef::invalid(); }
            if (chosen.is_valid()) {
                const decl: DeclarationNode* = this.ctx.decl_index.entry_decl(chosen);
                def_id = DeclarationNode::fn_of(decl).def;
                func_ty = this.ctx.decl_index.entry_signature(chosen);
            }
            this.calls.enforce_value_ref_visibility(def_id, e.span);
            // A generic function as a value is one instance of it: the
            // template applied to the arguments the turbofish writes or the
            // expected function type binds.  Its type is the signature with
            // those arguments, and the template and arguments are kept on the
            // node, from which monomorphization pins the instance.
            const tm: TemplateEntry* = this.ctx.generic_registry.template_of(def_id);
            if (tm != null && tm.kind == TemplateKind::Function) {
                mut args: [TypeRef] = [];
                const inst_ty: TypeRef = this.calls.generic_value_type(tm, &tm.param_types, func_ty, &ident.generic_args,
                    name_str, fmt::format("%s::<...>", name_str), e.span, &args);
                if (inst_ty.is_valid()) { ident.set_value_instance(tm.base_type, args); }
                return inst_ty;
            }
            // The pin is set in a template's symbolic check too: no pass
            // checks the copies, and a non-generic declaration named as a
            // value is the same declaration in every copy.
            if (chosen.is_valid()) {
                ident.set_resolved_callee(CalleePin::Decl(chosen));
                return func_ty;
            }
            // An overloaded function as a value is the overload the expected
            // function type selects, pinned by its entry.
            const family: [OverloadId] = this.calls.family_entries(def_id);
            const picked: TypeRef = this.calls.value_overload_signature(&family, name_str,
                e.span, e, &refused);
            if (refused) { return TypeRef::invalid(); }
            if (picked.is_valid()) {
                for (mut i: i64 = 0; i < family.length; i++) {
                    if (this.ctx.decl_index.entry_signature(family[i]).equals(picked)) {
                        ident.set_resolved_callee(CalleePin::Decl(family[i]));
                        return picked;
                    }
                }
            }
            const sole: OverloadId = this.calls.sole_entry(&family);
            if (sole.is_valid()) { ident.set_resolved_callee(CalleePin::Decl(sole)); }
            return func_ty;
        }
        // Not a local, not a global, not a function.  A name no rib bound
        // was refused where it was written and arrives `Err`; one that
        // binds to something that is not a value - a type, a module - is
        // refused here, where what the binding is has been asked.  A slot
        // nothing answered is a bug, not a name to report.
        match (ident.res.require("sema/resolve_identifier")) {
            Res::Err => { return TypeRef::invalid(); }
            _        => { }
        }
        // Bound to a function whose signature was refused where it was
        // written: it registered no type to take a value by, and it exists.
        if (this.ctx.defs.signature_refused(def_id)) { return TypeRef::invalid(); }
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0201_UNDEFINED_VARIABLE,
            fmt::format("cannot find value `%s` in this scope", name_str));
        diag = diag.at_with_label(e.span, "not found in this scope");
        this.ctx.emit_diagnostic(diag);
        return TypeRef::invalid();
    }

    // -- Operator overloading (arithmetic / equality / relational / negation) --
    //
    // Type-directed: the raw `check_binary_op` / `check_unary_op` rules run
    // first so primitive / pointer / string operations keep emitting native
    // instructions (and the compiler's own IR stays byte-identical).  Only when
    // an operand is a user type (Phase 1) or a generic param bounded by the
    // operator's trait (Phase 2) do we rewrite `a + b` into the trait-method
    // call `a.add(&b)` and hand it back for the caller to hang on the node.

    /// Build `receiver.method(&rhs)` (or `receiver.method()` when `rhs` is
    /// null).  The `&rhs` is a compiler-synthesized address-of, matching the
    /// `<=>` desugar so it is exempt from the "no address-of a literal" check.
    /// The call names the operator's TRAIT method - `==` is `Eq::equals`, not
    /// an inherent `equals` the receiver may also declare - so the node
    /// carries the trait, the way a bound-directed call does.  `trait_id` is
    /// the trait's IDENTITY - the canonical name the impl that was found
    /// declares, or the bound's - never the operator table's leaf: two traits
    /// can share a leaf, and a leaf would let the wrong one's method win.
    build_operator_call(mut &this, receiver: ExpressionNode*, method: SymbolStr,
                        trait_id: DefId, rhs: ExpressionNode*, op_tok: Token,
                        span: SourceSpan) -> ExpressionNode* {
        const member: ExpressionNode* = ExpressionNode::member_access_expr(receiver, method, span, span);
        this.calls.stamp_trait_item(ExpressionNode::member_access_of(member), trait_id);
        mut call: ExpressionNode* = ExpressionNode::call_expr(member, span);
        if (rhs != null) {
            // The trait method takes `rhs: &Rhs`.  When the operand is already a
            // reference (`&Rhs`, e.g. a by-reference parameter or `&scratch[0]`),
            // pass it straight through; only synthesize `&rhs` for a value
            // operand, so we never build a `&&Rhs` that fails to type-check.
            const rhs_t: Type* = this.arena.lookup(rhs.resolved_type);
            if (rhs_t != null && rhs_t.kind == TypeKind::Reference) {
                ExpressionNode::call_of(call).add_argument(rhs);
            } else {
                const amp: Token = Token::new(TokenType::Amp, "&", op_tok.line, op_tok.column);
                ExpressionNode::call_of(call).add_argument(ExpressionNode::synthetic_unary(amp, rhs, rhs.span));
            }
        }
        return call;
    }

    /// Bind `bin`, a `+` whose left operand is a string, to the standard
    /// library's `append(&this, other: string) -> string` on `string`,
    /// where the `+` is written, so code generation calls the entry it is
    /// handed.  The family is asked through the member-function door and
    /// the entry chosen by its signature: a program's own `append` on
    /// `string` taking anything else is another overload, and not it.
    /// Nothing for any other operator or operand.
    pin_string_append(mut &this, bin: BinaryExpr*, op: TokenType, lhs: TypeRef) -> void {
        if (op != TokenType::Plus) { return; }
        const lt: Type* = this.arena.lookup(lhs);
        if (lt == null || lt.kind != TypeKind::String) { return; }
        const string_ty: TypeRef = this.arena.get_string();
        const di: DeclarationIndex* = this.ctx.decl_index;
        const entries: [OverloadId] = di.lookup_family_entries(
            FamilyOwner::Type(string_ty), this.intern.intern("append"));        for (mut i: i64 = 0; i < entries.length; i++) {
            const sig: Type* = this.arena.lookup(di.entry_signature(entries[i]));
            if (sig == null || sig.kind != TypeKind::Function) { continue; }
            const ft: FunctionType* = sig.as_function();
            if (ft.param_types.length == 2 && ft.param_types[1].equals(string_ty)
                    && ft.return_type.equals(string_ty)) {
                bin.append_entry = entries[i];
                return;
            }
        }
    }

    /// The type a `for` scrutinee's `next` is called on: a pointer or
    /// reference auto-derefs to what it points at, and an instantiation to
    /// the type it resolved to.
    for_scrutinee_subject(&this, ty: TypeRef) -> TypeRef {
        mut r: TypeRef = ty;
        mut t: Type* = this.arena.lookup(r);
        mut depth: i32 = 0;
        while (t != null && depth < 5) {
            if (t.kind == TypeKind::Pointer) { r = t.as_pointer().pointee; t = this.arena.lookup(r); }
            else if (t.kind == TypeKind::Reference) { r = t.as_reference().referent; t = this.arena.lookup(r); }
            else if (t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = t.as_instantiated();
                if (!inst.has_resolved_type()) { break; }
                r = inst.resolved_type; t = this.arena.lookup(r);
            } else { break; }
            depth += 1;
        }
        return r;
    }

    /// Whether a `for` scrutinee of type `ty` is an iterator: its subject
    /// implements `iterator_id`, the language's `Iterator` - a parameter by
    /// a bound naming it, a concrete type by an impl of it.  An impl whose
    /// where-clause binds a generic the target does not carry
    /// (`CopiedIter<I>`, `where I: Iterator<T*>`) is confirmed when its clone
    /// is placed, so a head that unifies answers here, as for an `implement
    /// Iterator` binding.
    for_scrutinee_iterates(&this, ty: TypeRef, iterator_id: DefId) -> boolean {
        if (!iterator_id.is_valid()) { return false; }
        const subject: TypeRef = this.for_scrutinee_subject(ty);
        const t: Type* = this.arena.lookup(subject);
        if (t == null) { return false; }
        return this.trait_checker().type_satisfies_opaque_bound(subject, iterator_id);
    }

    /// Decide whether operand type `ty` overloads `map`'s operator and, if so,
    /// build + resolve the trait-method call, returning the resolved desugar
    /// expression (its `resolved_type` set) for the caller to attach.  Returns
    /// null when no overload applies (caller keeps the primitive path or errors).
    /// Only a concrete user type (Struct/Enum/Instantiated) with a
    /// registered trait impl overloads.
    operator_overload_expr(mut &this, receiver: ExpressionNode*, ty: TypeRef,
                           rhs: ExpressionNode*, map: OperatorTraitMap,
                           op_tok: Token, span: SourceSpan,
                           deref_ref: boolean) -> ExpressionNode* {
        if (!map.valid) { return null; }
        mut base_ty: TypeRef = ty;
        mut t: Type* = this.arena.lookup(base_ty);
        if (t == null) { return null; }
        // Cheap kind gate.  We NEVER unwrap raw pointers: `this.ptr == null`,
        // pointer arithmetic, and pointer comparison must keep the primitive
        // path (unwrapping a `Pair<..>*`'s pointee and finding its `Eq` impl is
        // exactly how `p == null` got miscompiled into `p.equals(&null)`).
        //
        // References ARE unwrapped, but ONLY when `deref_ref` is set - which the
        // callers do exclusively on the FAILURE path, i.e. after the primitive
        // `check_binary_op`/`check_unary_op` already rejected the operands.  On
        // the success path (reference + numeric arithmetic `&p + n`, reference
        // identity comparison `refA == refB`) the primitive rule applies and
        // must be preserved byte-identical, so those callers pass
        // `deref_ref = false`.  With this split, `a + b` / `-a` on a `&T`
        // parameter (the common by-reference case) overloads just like on a
        // value, while the pointer-ish primitive paths are untouched.  Bounded
        // depth guards a pathological `&&T`.
        if (deref_ref) {
            mut rdepth: i32 = 0;
            while (t != null && t.kind == TypeKind::Reference && rdepth < 4) {
                base_ty = t.as_reference().referent;
                t = this.arena.lookup(base_ty);
                rdepth += 1;
            }
            if (t == null) { return null; }
        }
        const is_user: boolean = t.kind == TypeKind::Struct
                              || t.kind == TypeKind::Enum || t.kind == TypeKind::InstantiatedType;
        if (!is_user) { return null; }
        // The operator's trait is the language's (`std::core::ops::Add` for
        // `+`), by the identity its
        // declaration claimed; the table spells the leaf and nothing else.
        // A type overloads when it has an impl of that trait; a user trait
        // of the same spelling is not it.
        const trait_id: DefId = this.ctx.generic_registry.wellknown(map.lang);
        if (!trait_id.is_valid()) { return null; }
        if (this.trait_checker().select_impl(trait_id, base_ty, 0) == null) { return null; }
        return this.operator_desugar(receiver, rhs, map, trait_id, op_tok, span);
    }

    /// `*b` on a type parameter whose bound gives it `Deref` (likewise `-x`
    /// under `Neg`, `!x` under `Not`), in a generic body: the desugar the
    /// bound licenses, built where the operator is written.  A reference to
    /// the parameter is looked through, as the concrete path does once the
    /// primitive operator refused it.  Null on any other operand.  A copy whose operand is not a user type applies the
    /// primitive operator instead (`UnaryExpr::desugar_by_bound`).
    bound_unary_desugar(mut &this, e: ExpressionNode*, unary: UnaryExpr*, ty: TypeRef) -> ExpressionNode* {
        if (!this.state.in_symbolic_check) { return null; }
        // A pointer keeps the primitive operator, as it does on the concrete path.
        const t: Type* = this.arena.lookup(ty);
        if (t == null || t.kind == TypeKind::Pointer) { return null; }
        const map: OperatorTraitMap = OperatorTraitMap::for_unary(unary.op.kind);
        if (!map.valid) { return null; }
        const trait_id: DefId = this.ctx.generic_registry.wellknown(map.lang);
        if (!trait_id.is_valid()) { return null; }
        const param: GenericParamType* = this.binding.receiver_type_param(ty);
        if (param == null || !this.binding.param_bounded_by(param, trait_id)) { return null; }
        return this.operator_desugar(unary.operand, null, map, trait_id, unary.op, e.span);
    }

    /// `a + b` on a left operand that is a type parameter whose bound gives
    /// it the operator's trait (`T: Add<T, T>`; `a == b` under `Eq`, `a < b`
    /// under `Ord`), or a reference to one, in a generic body: the desugar
    /// the bound licenses, built where the operator is written, as the
    /// concrete path builds it for a user type or a reference to one.  Null
    /// on any other left operand.  A copy whose operand is not a user type,
    /// or a reference to one, applies the primitive operator instead
    /// (`BinaryExpr::desugar_by_bound`).
    bound_binary_desugar(mut &this, e: ExpressionNode*, bin: BinaryExpr*, lhs: TypeRef) -> ExpressionNode* {
        if (!this.state.in_symbolic_check) { return null; }
        mut t: Type* = this.arena.lookup(lhs);
        mut depth: i32 = 0;
        while (t != null && t.kind == TypeKind::Reference && depth < 4) {
            t = this.arena.lookup(t.as_reference().referent);
            depth += 1;
        }
        if (t == null || t.kind != TypeKind::GenericParam) { return null; }
        const map: OperatorTraitMap = OperatorTraitMap::for_binary(bin.op.kind);
        if (!map.valid) { return null; }
        const trait_id: DefId = this.ctx.generic_registry.wellknown(map.lang);
        if (!trait_id.is_valid()) { return null; }
        const param: GenericParamType* = this.binding.receiver_type_param(lhs);
        if (param == null || !this.binding.param_bounded_by(param, trait_id)) { return null; }
        return this.operator_desugar(bin.left, bin.right, map, trait_id, bin.op, e.span);
    }

    /// The operator's call on `trait_id`'s method, wrapped as `map` says,
    /// and resolved.
    operator_desugar(mut &this, receiver: ExpressionNode*, rhs: ExpressionNode*,
                     map: OperatorTraitMap, trait_id: DefId, op_tok: Token,
                     span: SourceSpan) -> ExpressionNode* {
        const method_sym: SymbolStr = this.intern.intern(map.method);
        mut desugared: ExpressionNode* =
            this.build_operator_call(receiver, method_sym, trait_id, rhs, op_tok, span);
        // Relational operators: wrap the `compare` call in an `Ordering`
        // predicate - `a < b` -> `a.compare(&b).is_lt()`.
        if (map.ord_pred != "") {
            const pred_sym: SymbolStr = this.intern.intern(map.ord_pred);
            const pred_member: ExpressionNode* =
                ExpressionNode::member_access_expr(desugared, pred_sym, span, span);
            desugared = ExpressionNode::call_expr(pred_member, span) as ExpressionNode*;
        }
        if (map.negate) {
            const bang: Token = Token::new(TokenType::Exclaim, "!", op_tok.line, op_tok.column);
            desugared = ExpressionNode::unary_expr(bang, desugared, span);
        }
        // Deref: wrap the `b.deref()` call (which returns `Target*`) in an outer
        // `*` so `*b` yields the pointee.  The inner call's `Target*` is a real
        // pointer, so the wrapping `*` resolves on the primitive pointer rule and
        // never re-enters this hook.  `*ptr` is a place, so the one desugar serves
        // reads (`v = *b`), writes (`*b = x`), and compound (`*b += x`).
        if (map.deref_wrap) {
            const star: Token = Token::new(TokenType::Star, "*", op_tok.line, op_tok.column);
            desugared = ExpressionNode::synthetic_unary(star, desugared, span);
        }
        const snap: DiagnosticSnapshot = this.ctx.diagnostics.snapshot();
        const rty: TypeRef = this.resolve_expr(desugared);
        if (!rty.is_valid()) {
            // The type implements the trait; a call its method refused was
            // reported there, and that report is the operator's error.
            if (this.ctx.diagnostics.errors_since(snap) > 0) { return desugared; }
            return null;
        }
        return desugared;
    }

    /// True when a comparison (`== != < > <= >=`) should unwrap a reference
    /// operand to reach a user `Eq`/`Ord` referent for value comparison: at least
    /// one operand is `&T`, and NEITHER operand is void (a `null` literal), so
    /// `ref == null` keeps its pointer null-check.  The user-vs-primitive decision
    /// is left to `operator_overload_expr` (which only fires for a user referent),
    /// so `&i32 == &i32` and pointer null-checks stay on the identity path.
    comparison_unwraps_reference(&this, lhs: TypeRef, rhs: TypeRef) -> boolean {
        const lt: Type* = this.arena.lookup(lhs);
        const rt: Type* = this.arena.lookup(rhs);
        if (lt == null || rt == null) { return false; }
        if (lt.kind == TypeKind::Void || rt.kind == TypeKind::Void) { return false; }
        return lt.kind == TypeKind::Reference || rt.kind == TypeKind::Reference;
    }

    /// Reflected operator overloading for a PRIMITIVE left operand: `2 * vec`,
    /// where the user type is the RIGHT operand and the operator trait is
    /// implemented ON the primitive (`implement trait Mul<Vec, Vec> for i32`).
    ///
    /// Operator dispatch is LHS-driven and primitives are excluded from the
    /// normal `operator_overload_expr` gate (their arithmetic must stay on the
    /// native fast path).  This is therefore a SEPARATE, FAILURE-PATH-ONLY
    /// attempt, tried only after `check_binary_op` rejected the operands and the
    /// normal (LHS-driven) overload found nothing: a primitive OP primitive
    /// always type-checks and never reaches here, so the native path is never
    /// perturbed, and primitive OP user-type would otherwise be a hard error, so this is
    /// purely additive.  Builds `lhs.method(&rhs)` - primitive receivers support
    /// trait-method calls (cf. `Ord::compare` / `Step::successor` on `i32`).
    ///
    /// Restricted to the arithmetic / bitwise / shift traits, whose `Rhs` is a
    /// free type parameter.  `Eq`/`Ord` are excluded: their receiver and operand
    /// share `This`, so `2 == vec` can never match a primitive's own comparison
    /// impl, and attempting it would only risk a spurious diagnostic.
    reflected_operator_overload_expr(mut &this, lhs_expr: ExpressionNode*, lhs: TypeRef,
                                     rhs_expr: ExpressionNode*, map: OperatorTraitMap,
                                     op_tok: Token, span: SourceSpan) -> ExpressionNode* {
        if (!map.valid) { return null; }
        if (map.ord_pred != "" || map.lang == LangItem::Eq) { return null; }
        const lt: Type* = this.arena.lookup(lhs);
        if (lt == null) { return null; }
        // Only a genuine primitive scalar LHS.  A user / bounded / pointer /
        // reference / string LHS is handled (or deliberately not) elsewhere.
        const is_primitive: boolean = lt.kind == TypeKind::Int || lt.kind == TypeKind::Float
                                   || lt.kind == TypeKind::Char || lt.kind == TypeKind::Bool;
        if (!is_primitive) { return null; }
        // Gate on the impl EXISTING on the primitive before building anything,
        // so a plain `2 * 3`-shaped error never materializes a bogus call.
        const impl_block: ImplBlock* = this.trait_checker().select_impl(
            this.ctx.generic_registry.wellknown(map.lang), lhs, 0);
        if (impl_block == null || !impl_block.trait_def.is_valid()) { return null; }
        const method_sym: SymbolStr = this.intern.intern(map.method);
        mut desugared: ExpressionNode* =
            this.build_operator_call(lhs_expr, method_sym, impl_block.trait_def, rhs_expr, op_tok, span);
        const rty: TypeRef = this.resolve_expr(desugared);
        if (!rty.is_valid()) { return null; }
        return desugared;
    }

    /// When an overloadable operator hits a user type that lacks the required
    /// trait impl, emit a diagnostic that names the missing trait instead of the
    /// generic "cannot apply".  Returns true when it emitted (so the caller
    /// skips the fallback error); false for non-user operands (a genuine
    /// primitive type error keeps its original message).
    emit_operator_missing_impl(mut &this, ty: TypeRef, map: OperatorTraitMap,
                               op: TokenType, span: SourceSpan) -> boolean {
        if (!map.valid) { return false; }
        mut t: Type* = this.arena.lookup(ty);
        if (t == null) { return false; }
        // Look through references so `&UserType OP x` (a by-reference operand
        // lacking the trait impl) gets the trait-naming diagnostic too.
        mut rdepth: i32 = 0;
        while (t != null && t.kind == TypeKind::Reference && rdepth < 4) {
            t = this.arena.lookup(t.as_reference().referent);
            rdepth += 1;
        }
        if (t == null) { return false; }
        const is_user: boolean = t.kind == TypeKind::Struct
                              || t.kind == TypeKind::Enum || t.kind == TypeKind::InstantiatedType;
        if (!is_user) { return false; }
        const name: string = this.arena.format_display(t);
        this.ctx.emit_error_at(ErrorCode::E0229_INVALID_BINARY_OP,
            fmt::format("`%s` does not implement `%s`; add `implement trait %s ... for %s` to use the `%s` operator on it",
                name, map.lang.leaf(), map.lang.leaf(), name, op.to_string()), span);
        return true;
    }

    /// An operator applied in a generic body to an operand that is still one
    /// of the body's type parameters is licensed by that parameter's bounds
    /// alone: one of them must give it the operator's language trait, or a
    /// trait that has it as a supertrait.  A parameter with no such bound -
    /// unbounded, or bounded only by other traits, a user trait spelled like
    /// the language's among them - is refused here, on the generic body,
    /// whatever any instantiation would have supplied.  A pointer operand is
    /// left to the pointer rules.  True when it reported.
    refuse_unlicensed_param_operator(mut &this, op: TokenType, unary: boolean,
                                     lhs: TypeRef, rhs: TypeRef, span: SourceSpan) -> boolean {
        if (!this.state.in_symbolic_check) { return false; }
        const map: OperatorTraitMap = if (unary) { OperatorTraitMap::for_unary(op) } else { OperatorTraitMap::for_binary(op) };
        if (!map.valid) { return false; }
        const lang_def: DefId = this.ctx.generic_registry.wellknown(map.lang);
        if (!lang_def.is_valid()) { return false; }
        if (this.refuse_unlicensed_operand(op, map, lang_def, lhs, span)) { return true; }
        if (unary) { return false; }
        return this.refuse_unlicensed_operand(op, map, lang_def, rhs, span);
    }

    refuse_unlicensed_operand(mut &this, op: TokenType, map: OperatorTraitMap, lang_def: DefId,
                              ty: TypeRef, span: SourceSpan) -> boolean {
        const t: Type* = this.arena.lookup(ty);
        if (t == null || t.kind == TypeKind::Pointer) { return false; }
        const param: GenericParamType* = this.binding.receiver_type_param(ty);
        if (param == null) { return false; }
        if (this.binding.param_bounded_by(param, lang_def)) { return false; }
        const shown: string = this.intern.resolve(param.param_name);
        const op_text: string = op.to_string();
        // The trait is spelled by its path: a bound of the program's own may
        // share its name.
        const trait_path: string = map.lang.path();
        const bounds: [DefId] = this.binding.param_bound_traits(param);
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0229_INVALID_BINARY_OP,
            fmt::format("the `%s` operator cannot be applied to `%s`: its bounds do not give it `%s`",
                op_text, shown, trait_path));
        diag = diag.at_with_label(span, fmt::format("`%s` needs `%s: %s`", op_text, shown, trait_path));
        if (bounds.length == 0) {
            diag = diag.with_note(fmt::format(
                "`%s` is a type parameter with no bound, so no operator applies to it", shown));
        } else if (bounds.length == 1) {
            diag = diag.with_note(fmt::format(
                "`%s` is bounded by `%s`, which is not `%s` and does not have it as a supertrait",
                shown, this.intern.shown(this.ctx.defs.leaf_of(bounds[0])), trait_path));
        } else {
            mut listed: string = "";
            for (mut i: i64 = 0; i < bounds.length; i++) {
                const name: string = this.intern.shown(this.ctx.defs.leaf_of(bounds[i]));
                listed = if (i == 0) { fmt::format("`%s`", name) } else { fmt::format("%s, `%s`", listed, name) };
            }
            diag = diag.with_note(fmt::format(
                "`%s` is bounded by %s; none of them is `%s` or has it as a supertrait", shown, listed, trait_path));
        }
        diag = diag.help(fmt::format("add the bound: `where %s: %s`", shown, trait_path));
        this.ctx.emit_diagnostic(diag);
        return true;
    }

    /// Warn when two DIFFERENT concrete numeric types meet in one operation.
    ///
    /// Only the widening direction can occur here - the common-type rule picks
    /// the wider operand, so the narrower one converts up to it - and narrowing
    /// is already rejected where it can appear, at the assignment and argument
    /// boundaries.  Widening is accepted for now, so this is a warning and not
    /// an error, but the language reference states that every conversion is
    /// written with `as`, so the message says the acceptance is temporary
    /// rather than letting the code quietly contradict the reference.
    ///
    /// Suppressible by code through `DiagConfig` like any other warning, which
    /// matters while the tree still carries mixed-width integer arithmetic.
    warn_implicit_numeric_conversion(mut &this, e: ExpressionNode*,
                                     lhs: TypeRef, rhs: TypeRef) -> void {
        if (!lhs.is_valid() || !rhs.is_valid()) { return; }
        if (lhs.equals(rhs)) { return; }
        const lt: Type* = this.arena.lookup(lhs);
        const rt2: Type* = this.arena.lookup(rhs);
        if (lt == null || rt2 == null) { return; }
        const l_num: boolean = lt.kind == TypeKind::Int || lt.kind == TypeKind::Float;
        const r_num: boolean = rt2.kind == TypeKind::Int || rt2.kind == TypeKind::Float;
        if (!l_num || !r_num) { return; }
        mut diag: Diagnostic = Diagnostic::warning(
            ErrorCode::W0005_IMPLICIT_CONVERSION,
            fmt::format("implicit conversion between `%s` and `%s`; the narrower operand widens to the wider one. Write it with `as` - this is accepted for now and will become an error before v1.0.0",
                this.types.type_display_name(lhs),
                this.types.type_display_name(rhs)));
        diag = diag.at(e.span);
        this.ctx.emit_diagnostic(diag);
    }

    resolve_binary(mut &this, e: ExpressionNode*, bin: BinaryExpr*) -> TypeRef {
        // Idempotent: if a previous resolution already rewrote this operator
        // into a trait-method call, return its type without re-running
        // `check_binary_op` (which would re-reject the user-typed operands and
        // emit a spurious E0229 the second time around).
        if (bin.desugared_call != null) {
            return bin.desugared_call.resolved_type;
        }
        const left_is_lit:  boolean = is_numeric_literal_expr(bin.left);
        const right_is_lit: boolean = is_numeric_literal_expr(bin.right);
        // A negated or folded constant (`-1.0`, `16.0 / 9.0`) is as
        // width-polymorphic as the bare literal above, but it is a Unary/Binary
        // node so the two flags miss it and neither operand hints the other.
        const left_is_const_num:  boolean = is_constant_numeric_expr(bin.left);
        const right_is_const_num: boolean = is_constant_numeric_expr(bin.right);
        mut lhs: TypeRef = TypeRef::invalid();
        mut rhs: TypeRef = TypeRef::invalid();

        if (bin.op.kind.is_assignment_op()) {
            lhs = this.resolve_expr(bin.left);
            if (lhs.is_valid()) {
                const saved_exp: TypeRef = this.state.expected_type;
                this.state.expected_type = lhs;
                rhs = this.resolve_expr(bin.right);
                this.state.expected_type = saved_exp;
                if (bin.op.kind == TokenType::Equal) {
                    this.literals.refuse_narrowing_constant(bin.right, lhs);
                }
            } else {
                rhs = this.resolve_expr(bin.right);
            }
            this.check_assignment_lvalue(bin.left);
            if (bin.op.kind == TokenType::Equal) {
                this.lambda.refuse_stored_closure(rhs, lhs,
                    if (bin.right != null) { bin.right.span } else { e.span }, "an assigned place");
            }
            // Judged as a declaration's initializer is: an instantiation not
            // yet minted (`[E]`, `Option<i64>`) is one type here, as it is
            // there, and a pair this skips is never checked again.
            if (bin.op.kind == TokenType::Equal && lhs.is_valid() && rhs.is_valid()
                && this.symbolic.symbolic_judgeable(lhs) && this.symbolic.symbolic_judgeable(rhs)
                && !this.checker.can_assign(rhs, lhs)
                && !this.types.indirection_spelling_compatible(rhs, lhs)) {
                match (this.convert_to_object(bin.right, rhs, lhs)) {
                    ObjectConversionOutcome::Converted(c) => { bin.right = c; }
                    ObjectConversionOutcome::Refused => { }
                    ObjectConversionOutcome::Mismatch => {
                        const value_span: SourceSpan = if (bin.right != null) { bin.right.span } else { e.span };
                        this.diag.emit_type_mismatch_with_value(
                            ErrorCode::E0200_TYPE_MISMATCH, value_span, lhs, rhs,
                            "the value assigned here doesn't match the type of the assignment target",
                            bin.left.span, bin.right);
                    }
                }
            }
            // Compound assignment (`+=`, `-=`, `*=`, ...) also has to
            // type-check the *underlying* binary operation.  Plain binary
            // exprs run through `check_binary_op` (see below); the
            // assignment branch must too, or a
            // nonsense compound like `s *= 3` (string) or `p /= 2`
            // (pointer) passes sema and silently emits null IR in
            // codegen (the base op has no arm in `codegen_binary`).
            // Validate the base op the same way, guarding on
            // symbolically-unresolved operands so pre-monomorphization
            // generic bodies don't trip.
            const base_op: TokenType = bin.op.kind.compound_base();
            if (base_op != TokenType::Unknown && lhs.is_valid() && rhs.is_valid()
                && (this.symbolic.symbolic_type_unresolved(lhs) || this.symbolic.symbolic_type_unresolved(rhs))) {
                this.refuse_unlicensed_param_operator(base_op, false, lhs, rhs, e.span);
            }
            if (base_op != TokenType::Unknown && lhs.is_valid() && rhs.is_valid()
                && !this.symbolic.symbolic_type_unresolved(lhs)
                && !this.symbolic.symbolic_type_unresolved(rhs)) {
                const cres: TypeCheckResult = this.checker.check_binary_op(base_op, lhs, rhs);
                // Compound assignment routes through the same operator traits:
                // `a += b` overloads to `a.add(&b)` and stores the result back
                // into `a` (codegen). Phase 2 bounded params overload on the
                // success path; concrete user types on the failure path.
                const map: OperatorTraitMap = OperatorTraitMap::for_binary(base_op);
                if (cres.success) {
                    if (map.valid && bin.desugared_call == null) {
                        const de: ExpressionNode* = this.operator_overload_expr(
                            bin.left, lhs, bin.right, map, bin.op, e.span, false);
                        if (de != null) { bin.desugared_call = de; }
                    }
                    if (bin.desugared_call == null) { this.pin_string_append(bin, base_op, lhs); }
                } else {
                    mut overloaded: boolean = false;
                    if (map.valid && bin.desugared_call == null) {
                        const de: ExpressionNode* = this.operator_overload_expr(
                            bin.left, lhs, bin.right, map, bin.op, e.span, true);
                        if (de != null) { bin.desugared_call = de; overloaded = true; }
                    }
                    if (!overloaded
                        && !this.emit_operator_missing_impl(lhs, map, base_op, e.span)) {
                        this.ctx.emit_error_at(ErrorCode::E0229_INVALID_BINARY_OP,
                            cres.error_message, e.span);
                    }
                }
            }
            return lhs;
        }

        if ((bin.op.kind == TokenType::Slash || bin.op.kind == TokenType::Percent) && is_zero_int_literal(bin.right)) {
            this.ctx.emit_error_at(ErrorCode::E0226_DIVISION_BY_ZERO,
                if (bin.op.kind == TokenType::Slash) { "division by zero" } else { "remainder with a zero divisor" }, e.span);
        }

        mut force_wide: TypeRef = TypeRef::invalid();
        if (!this.literals.expected_type_is_int_type()) {
            // The narrowest of i64 and u64 that holds the value, as for a
            // single literal; a value neither holds keeps its literals' widths.
            match (try_fold_const_integer(e)) {
                Option::Some(folded) => {
                    if (folded >= i64::MIN as i128 && folded <= i64::MAX as i128) {
                        const mag: i128 = if (folded < 0) { 0 - folded } else { folded };
                        if (mag > i32::MAX as i128) { force_wide = this.arena.get_i64(); }
                    } else if (folded > 0 && folded <= u64::MAX as i128) {
                        force_wide = this.arena.get_u64();
                    }
                }
                Option::None => { }
            }
        }
        // A shift's result has its left operand's width, and the amount says
        // nothing about that width, so a constant shifted there takes the
        // integer type the result is expected to have instead of adopting the
        // amount's: `1 << (u64::BITS - 1)` stored into a `u64` shifts at 64
        // bits, where adopting the `u32` amount shifted at 32.
        const shift_keeps_expected: boolean =
            (bin.op.kind == TokenType::LessLess || bin.op.kind == TokenType::GreaterGreater)
            && this.literals.expected_type_is_int_type();
        if (force_wide.is_valid()) {
            const saved_fw: TypeRef = this.state.expected_type;
            this.state.expected_type = force_wide;
            lhs = this.resolve_expr(bin.left);
            rhs = this.resolve_expr(bin.right);
            this.state.expected_type = saved_fw;
        } else if (right_is_lit && !left_is_lit) {
            lhs = this.resolve_expr(bin.left);
            if (lhs.is_valid()) {
                const saved_exp: TypeRef = this.state.expected_type;
                this.state.expected_type = lhs;
                rhs = this.resolve_expr(bin.right);
                this.state.expected_type = saved_exp;
            } else {
                rhs = this.resolve_expr(bin.right);
            }
        } else if (left_is_lit && !right_is_lit) {
            rhs = this.resolve_expr(bin.right);
            if (rhs.is_valid() && !shift_keeps_expected) {
                const saved_exp: TypeRef = this.state.expected_type;
                this.state.expected_type = rhs;
                lhs = this.resolve_expr(bin.left);
                this.state.expected_type = saved_exp;
            } else {
                lhs = this.resolve_expr(bin.left);
            }
        // A constant numeric expression adopts its peer's type on exactly the
        // slots the call path pushes a parameter type onto, and for the same
        // two reasons.  A narrow FLOAT: the constant otherwise settles on the
        // f64 default and the pair reaches codegen as `fadd double, float`,
        // which fails module verification with no source location.  A WIDE int:
        // `value < -128` against an `i64` otherwise computes the constant at
        // the i32 default and then widens it, which is a conversion the source
        // never asked for.  A SIGNED peer of a negated literal: `x != -128` with
        // `x: i8` is a literal of `x`'s type, as `x != 127` is, and an unsigned
        // peer is left out so that `-1` cannot adopt it and turn huge.  Other
        // narrow int peers are excluded on purpose - pushing one onto `1 << 20`
        // would truncate a constant that currently computes at the i32 default
        // and is then widened correctly.
        } else if (right_is_const_num && !left_is_const_num) {
            lhs = this.resolve_expr(bin.left);
            if (is_narrow_float_type(this.arena, lhs) || is_wide_int_type(this.arena, lhs)
                || (is_negative_numeric_literal_expr(bin.right) && this.literals.is_signed_int_type(lhs))) {
                const saved_exp: TypeRef = this.state.expected_type;
                this.state.expected_type = lhs;
                rhs = this.resolve_expr(bin.right);
                this.state.expected_type = saved_exp;
            } else {
                rhs = this.resolve_expr(bin.right);
            }
        } else if (left_is_const_num && !right_is_const_num) {
            rhs = this.resolve_expr(bin.right);
            if (!shift_keeps_expected
                && (is_narrow_float_type(this.arena, rhs) || is_wide_int_type(this.arena, rhs)
                    || (is_negative_numeric_literal_expr(bin.left) && this.literals.is_signed_int_type(rhs)))) {
                const saved_exp: TypeRef = this.state.expected_type;
                this.state.expected_type = rhs;
                lhs = this.resolve_expr(bin.left);
                this.state.expected_type = saved_exp;
            } else {
                lhs = this.resolve_expr(bin.left);
            }
        } else {
            lhs = this.resolve_expr(bin.left);
            rhs = this.resolve_expr(bin.right);
        }

        if ((this.symbolic.symbolic_type_unresolved(lhs) || this.symbolic.symbolic_type_unresolved(rhs))
                && !this.pointer_rule_settles(lhs, rhs)) {
            if (this.refuse_unlicensed_param_operator(bin.op.kind, false, lhs, rhs, e.span)) {
                return TypeRef::invalid();
            }
            const bde: ExpressionNode* = this.bound_binary_desugar(e, bin, lhs);
            if (bde != null) {
                bin.desugared_call = bde;
                bin.desugar_by_bound = true;
                return bde.resolved_type;
            }
            return TypeRef::invalid();
        }
        if (lhs.is_valid() && rhs.is_valid() && this.object_operand_checked(e, bin, lhs, rhs)) {
            return if (bin.op.kind.yields_boolean()) { this.arena.get_bool() } else { TypeRef::invalid() };
        }
        if (lhs.is_valid() && rhs.is_valid()) {
            if (bin.op.kind.yields_boolean() && this.checker.comparison_of_unrelated(lhs, rhs)) {
                this.ctx.emit_error_at(ErrorCode::E0200_TYPE_MISMATCH,
                    fmt::format("cannot compare `%s` with `%s`: they are unrelated types",
                        this.arena.format_display(this.arena.lookup(lhs)),
                        this.arena.format_display(this.arena.lookup(rhs))), e.span);
                return this.arena.get_bool();
            }
            const result: TypeCheckResult = this.checker.check_binary_op(bin.op.kind, lhs, rhs);
            const map: OperatorTraitMap = OperatorTraitMap::for_binary(bin.op.kind);
            // A shift's amount widening to the shifted value's type changes no
            // value - its type never reaches the result - so only the shifted
            // value widening, to a wider amount, is a conversion to report.
            const amount_widens_only: boolean =
                (bin.op.kind == TokenType::LessLess || bin.op.kind == TokenType::GreaterGreater)
                && result.result_type.equals(lhs);
            if (result.success) {
                if (!amount_widens_only) { this.warn_implicit_numeric_conversion(e, lhs, rhs); }
                // Phase 2: a bounded-param operand (`T: Add`) still overloads,
                // even though `check_binary_op` passed the generic param through.
                // Concrete primitives fall straight through (no user impl).
                if (map.valid && bin.desugared_call == null) {
                    // References to a user `Eq`/`Ord` type compare BY VALUE, not by
                    // identity: `&a == &b` -> `a.equals(&b)` (and `<`/`>` via `Ord`).
                    // `check_binary_op` passes any reference comparison as a `bool`
                    // (pointer identity); for the comparison traits we instead unwrap
                    // the reference and overload when the referent is a user type
                    // implementing the trait.  Everything else keeps identity: a
                    // `null`/void operand (`ref == null` stays a pointer null-check),
                    // and a reference to a primitive or a non-`Eq` type - those make
                    // `operator_overload_expr` return null and fall through here.
                    const succ_deref: boolean =
                        (map.lang == LangItem::Eq || map.lang == LangItem::Ord)
                        && this.comparison_unwraps_reference(lhs, rhs);
                    const de: ExpressionNode* = this.operator_overload_expr(
                        bin.left, lhs, bin.right, map, bin.op, e.span, succ_deref);
                    if (de != null) { bin.desugared_call = de; return de.resolved_type; }
                }
                this.pin_string_append(bin, bin.op.kind, lhs);
                return result.result_type;
            }
            // Phase 1: `check_binary_op` rejected - a concrete user type with a
            // registered impl overloads; otherwise it is a genuine type error.
            if (map.valid && bin.desugared_call == null) {
                const de: ExpressionNode* = this.operator_overload_expr(
                    bin.left, lhs, bin.right, map, bin.op, e.span, true);
                if (de != null) { bin.desugared_call = de; return de.resolved_type; }
                // Reflected: a PRIMITIVE left operand with the trait implemented
                // on it (`2 * vec` => `(2).mul(&vec)`).  LHS-driven dispatch skips
                // primitives, so this is the one place the right operand's user
                // type can pull in an impl hung on the primitive.
                const rde: ExpressionNode* = this.reflected_operator_overload_expr(
                    bin.left, lhs, bin.right, map, bin.op, e.span);
                if (rde != null) { bin.desugared_call = rde; return rde.resolved_type; }
                if (this.emit_operator_missing_impl(lhs, map, bin.op.kind, e.span)) {
                    return TypeRef::invalid();
                }
            }
            this.ctx.emit_error_at(ErrorCode::E0229_INVALID_BINARY_OP, result.error_message, e.span);
        }
        // A refused comparison, or one over an operand already reported, is
        // still a `boolean`, so the condition holding it reports nothing more.
        if (bin.op.kind.yields_boolean()) { return this.arena.get_bool(); }
        if (lhs.is_valid()) { return lhs; }
        if (rhs.is_valid()) { return rhs; }
        return TypeRef::invalid();
    }

    /// Whether a binary operation is decided by the pointer rules alone,
    /// which read an operand's top-level kind and never its pointee: one
    /// operand is a pointer, and each operand is a pointer, `null`, or a
    /// type the symbolic walk has settled.  `p == null`, `p != q` and
    /// `p + n` on a `T*` are typed in the generic body without knowing `T`.
    pointer_rule_settles(&this, lhs: TypeRef, rhs: TypeRef) -> boolean {
        const lt: Type* = this.arena.lookup(lhs);
        const rt: Type* = this.arena.lookup(rhs);
        if (lt == null || rt == null) { return false; }
        if (lt.kind != TypeKind::Pointer && rt.kind != TypeKind::Pointer) { return false; }
        return this.pointer_rule_operand(lhs, lt) && this.pointer_rule_operand(rhs, rt);
    }

    pointer_rule_operand(&this, ty: TypeRef, t: Type*) -> boolean {
        if (t.kind == TypeKind::Pointer || t.kind == TypeKind::Void) { return true; }
        return !this.symbolic.symbolic_type_unresolved(ty);
    }

    /// Whether one side of an `=` names a type a mismatch can be judged
    /// against: a settled type, or - in a generic body - a type whose only
    /// unsettled parts are that body's own parameters, each one opaque type.
    assignment_judgeable(&this, ty: TypeRef) -> boolean {
        return this.types.arg_type_is_concrete(ty) || this.symbolic.symbolic_params_settle(ty);
    }

    check_assignment_lvalue(mut &this, lhs: ExpressionNode*) -> void {
        if (lhs == null) { return; }
        const id: IdentifierExpr* = ExpressionNode::identifier_of(lhs);
        if (id != null) {
            if (this.names_receiver(id)) { return; }
            const sym: SymbolID = id.res.local_sym();
            if (this.scopes.is_mutable(sym)) { return; }
            const name_str: string = this.intern.resolve(id.name);
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0218_IMMUTABLE_ASSIGNMENT,
                fmt::format("cannot assign to immutable variable `%s`", name_str));
            diag = diag.at_with_label(lhs.span, "this binding is immutable");
            const kw: SourceSpan = this.scopes.kw_span_of(sym);
            if (kw.has_location()) {
                const kw_len: u32 = if (kw.end_col > kw.start_col) { kw.end_col - kw.start_col } else { 0 };
                if (kw_len == 0) {
                    diag = diag.suggest(Suggestion::machine_applicable(kw, "mut ", fmt::format("make `%s` mutable", name_str)));
                } else {
                    diag = diag.suggest(Suggestion::machine_applicable(kw, "mut", fmt::format("make `%s` mutable", name_str)));
                }
            } else {
                diag = diag.with_note("declare the binding with `mut` instead of `const` to allow reassignment");
            }
            this.ctx.diagnostics.emit(diag);
            return;
        }
        const ma: MemberAccessExpr* = ExpressionNode::member_access_of(lhs);
        if (ma != null) {
            if (ma.object == null) { return; }
            const recv_t: Type* = this.arena.lookup(ma.object.resolved_type);
            if (recv_t != null && (recv_t.kind == TypeKind::Pointer || recv_t.kind == TypeKind::Reference)) { return; }
            if (this.symbolic.symbolic_type_unresolved(ma.object.resolved_type)) { return; }
            this.check_assignment_lvalue(ma.object);
            return;
        }
        if (ExpressionNode::literal_of(lhs) != null) {
            this.ctx.emit_error_at(ErrorCode::E0232_INVALID_ASSIGNMENT_TARGET,
                "cannot assign to a literal; the left-hand side of an assignment must be a place (variable, field, or index)", lhs.span);
        }
        const aa: ArrayAccessExpr* = ExpressionNode::array_access_of(lhs);
        if (aa != null) {
            if (aa.array == null) { return; }
            const arr_t: Type* = this.arena.lookup(aa.array.resolved_type);
            if (arr_t != null && (arr_t.kind == TypeKind::Pointer || arr_t.kind == TypeKind::Reference)) { return; }
            if (this.symbolic.symbolic_type_unresolved(aa.array.resolved_type)) { return; }
            this.check_assignment_lvalue(aa.array);
        }
    
    }

    resolve_unary(mut &this, e: ExpressionNode*, unary: UnaryExpr*) -> TypeRef {
        // Idempotent (see resolve_binary): a prior resolution may have rewritten
        // `-x` into `x.neg()`; return its type rather than re-rejecting.
        if (unary.desugared_call != null) {
            return unary.desugared_call.resolved_type;
        }
        // Address-of resolved against an expected `&T`: a numeric-literal
        // operand must adopt the referent width (`&3` bound to `&i64` -> `&i64`,
        // not `&i32`; otherwise codegen spills a too-narrow temp and the
        // callee's `*rhs` reads uninitialised high bytes). The literal is
        // resolved under the REFERENT as its expected type - the reference
        // itself is not a type an integer literal adopts - and that answer is
        // the operand's type: resolving the operand again under the reference
        // would default the width back, so the first answer is the one kept. Only polymorphic
        // numeric literals are touched; a real place keeps its own type.
        mut operand_type: TypeRef = TypeRef::invalid();
        if (unary.op.kind == TokenType::Amp && unary.operand != null
            && ExpressionNode::literal_of(unary.operand) != null
            && this.state.expected_type.is_valid()) {
            const exp_t0: Type* = this.arena.lookup(this.state.expected_type);
            if (exp_t0 != null && exp_t0.kind == TypeKind::Reference) {
                const ref_ty0: TypeRef = exp_t0.as_reference().referent;
                const rt0: Type* = this.arena.lookup(ref_ty0);
                const lit0: LiteralExpr* = ExpressionNode::literal_of(unary.operand);
                const numeric_match: boolean = rt0 != null
                    && ((rt0.kind == TypeKind::Int && lit0.literal_kind == LiteralKind::Integer)
                     || (rt0.kind == TypeKind::Float && lit0.literal_kind == LiteralKind::Float));
                if (numeric_match) {
                    const saved_exp0: TypeRef = this.state.expected_type;
                    this.state.expected_type = ref_ty0;
                    const lit_ty0: TypeRef = this.literals.resolve_literal(unary.operand, lit0);
                    this.state.expected_type = saved_exp0;
                    if (lit_ty0.is_valid()) {
                        unary.operand.set_resolved_type(lit_ty0);
                        operand_type = lit_ty0;
                    }
                }
            }
        }
        if (!operand_type.is_valid()) { operand_type = this.resolve_expr(unary.operand); }
        if (!operand_type.is_valid()) { return TypeRef::invalid(); }
        if (unary.op.kind == TokenType::Amp && !unary.is_synthetic && unary.operand != null
            && ExpressionNode::literal_of(unary.operand) != null) {
            this.ctx.emit_error_at(ErrorCode::E0223_INVALID_ADDRESS_OF,
                "cannot take the address of a literal; `&` requires a place (variable, field, or index)", e.span);
            return TypeRef::invalid();
        }
        if (unary.op.kind == TokenType::Star) {
            const id: IdentifierExpr* = ExpressionNode::identifier_of(unary.operand);
            if (id != null && this.names_receiver(id)) { return operand_type; }
        }
        const result: TypeCheckResult = this.checker.check_unary_op(unary.op.kind, operand_type);
        if (!result.success) {
            if (this.symbolic.symbolic_type_unresolved(operand_type)) {
                if (this.refuse_unlicensed_param_operator(unary.op.kind, true, operand_type, TypeRef::invalid(), e.span)) {
                    return operand_type;
                }
                const bde: ExpressionNode* = this.bound_unary_desugar(e, unary, operand_type);
                if (bde != null) {
                    unary.desugared_call = bde;
                    unary.desugar_by_bound = true;
                    return bde.resolved_type;
                }
                return operand_type;
            }
            // Operator overloading: `-x` on a user type (Phase 1) or a
            // `Neg`-bounded generic param (Phase 2) rewrites to `x.neg()`.
            // A bounded param is non-numeric, so it reaches this failure path.
            const map: OperatorTraitMap = OperatorTraitMap::for_unary(unary.op.kind);
            if (map.valid && unary.desugared_call == null) {
                const de: ExpressionNode* = this.operator_overload_expr(
                    unary.operand, operand_type, null, map, unary.op, e.span, true);
                if (de != null) { unary.desugared_call = de; return de.resolved_type; }
                if (this.emit_operator_missing_impl(operand_type, map, unary.op.kind, e.span)) {
                    return operand_type;
                }
            }
            this.ctx.emit_error_at(ErrorCode::E0230_INVALID_UNARY_OP, result.error_message, e.span);
            return operand_type;
        }
        if (unary.op.kind == TokenType::Amp) {
            if (this.state.expected_type.is_valid()) {
                const exp_type: Type* = this.arena.lookup(this.state.expected_type);
                if (exp_type != null && exp_type.kind == TypeKind::Reference) {
                    const exp_ref: ReferenceType* = exp_type.as_reference();
                    if (exp_ref.is_mutable()) {
                        return this.arena.get_reference_to(operand_type, RefMutability::Mutable);
                    }
                }
                // A mutably borrowed object borrows its value as a mutable
                // reference would.
                if (exp_type != null && exp_type.kind == TypeKind::Object
                        && exp_type.as_object().form == ObjectForm::MutableBorrowed) {
                    return this.arena.get_reference_to(operand_type, RefMutability::Mutable);
                }
            }
        }
        return result.result_type;
    }

    /// The type a `sizeof`/`alignof` measures, resolved from its annotation
    /// in the body's own context - the same question a cast target asks, and
    /// answered once: the node carries the answer for the const folder and
    /// codegen, neither of which re-derives it.  A clone arrives with the slot
    /// cleared by the substituter and is answered here again over the
    /// substituted annotation.
    resolve_layout_operand(mut &this, ann: TypeAnnotation*) -> TypeRef {
        if (ann == null) { return TypeRef::invalid(); }
        this.prime_typeof_annotation(ann);
        mut res_ctx: ResolutionContext = this.body_res_ctx();
        this.symbolic.symbolic_bind_params(&res_ctx);
        const ty: TypeRef = this.ctx.type_resolver.resolve(ann, &res_ctx);
        if (!ty.is_valid()) { this.refuse_unresolved_body_annotation(ann); }
        return ty;
    }

    /// A body annotation the type layer could not resolve - a local's, a
    /// `sizeof`/`alignof` operand's, a cast target's.  A name in it the name
    /// layer refused was reported where it was written, and a leaf left
    /// unanswered is recorded by the door; a failure that is neither (a form
    /// resolved later in the walk) is left to that walk.
    refuse_unresolved_body_annotation(&this, ann: TypeAnnotation*) -> void {
        TypeAnnotation::refused(ann);
    }

    /// E0200 at `delete` of an operand that is not a pointer: `delete`
    /// releases a pointee and frees its block, and any other value has
    /// neither.  A trait object is refused with its own note: what it
    /// points at has a size and a destructor only its table knows, and the
    /// table holds neither yet.  An error-typed operand stays silent, its
    /// error already reported.
    refuse_delete_of_non_pointer(&this, operand: ExpressionNode*, operand_type: TypeRef) -> void {
        const t: Type* = this.arena.lookup(operand_type);
        if (t == null || t.is_error() || t.kind == TypeKind::Pointer) { return; }
        if (t.kind == TypeKind::Object) {
            mut d: Diagnostic = Diagnostic::error(ErrorCode::E0200_TYPE_MISMATCH,
                fmt::format("`delete` takes a pointer, and `%s` is a trait object", this.arena.format_display(t)));
            d = d.at(operand.span);
            d = d.with_note("a trait object's value has a size and a destructor that are not known where the object is used");
            this.ctx.emit_diagnostic(d);
            return;
        }
        this.ctx.emit_error_at(ErrorCode::E0200_TYPE_MISMATCH,
            fmt::format("`delete` takes a pointer, and `%s` is not a pointer", this.arena.format_display(t)),
            operand.span);
    }

    /// Convert `expr`, of type `from`, to the trait object `to`.  A borrowed
    /// object takes a reference to the value, in either form as a reference
    /// parameter does; a raw object takes a pointer.  The value's type must implement
    /// the trait by a non-generic implementation, whose table the
    /// conversion names; anything else that has the right shape is E0315.
    /// An object converts to its own type alone, which needs no conversion.
    convert_to_object(mut &this, expr: ExpressionNode*, from: TypeRef, to: TypeRef) -> ObjectConversionOutcome {
        const target: Type* = this.arena.lookup(to);
        const source: Type* = this.arena.lookup(from);
        if (expr == null || target == null || source == null || target.kind != TypeKind::Object) {
            return ObjectConversionOutcome::Mismatch;
        }
        const object: ObjectType* = target.as_object();
        mut value: TypeRef = TypeRef::invalid();
        match (object.form) {
            ObjectForm::Raw => {
                if (source.kind == TypeKind::Pointer) { value = source.as_pointer().pointee; }
            }
            _ => {
                if (source.kind == TypeKind::Reference) { value = source.as_reference().referent; }
            }
        }
        const value_t: Type* = this.arena.lookup(value);
        if (value_t == null) { return ObjectConversionOutcome::Mismatch; }

        const shown_from: string = this.arena.format_display(source);
        const shown_to: string = this.arena.format_display(target);
        const shown_value: string = this.arena.format_display(value_t);
        const trait_t: Type* = this.arena.lookup(object.trait_type);
        const shown_trait: string = if (trait_t != null) {
            this.arena.display_with_arguments(this.arena.format_display(trait_t), &object.args)
        } else {
            shown_to
        };
        if (this.arena.contains_generic_param(value)) {
            this.ctx.emit_error_at(ErrorCode::E0315_OBJECT_CONVERSION,
                fmt::format("`%s` cannot become `%s`: `%s` is a type parameter, whose implementation of `%s` is not known here",
                    shown_from, shown_to, shown_value, shown_trait), expr.span);
            return ObjectConversionOutcome::Refused;
        }
        const implementation: DeclarationNode* = this.object_implementation(object, value);
        if (implementation == null) {
            this.ctx.emit_error_at(ErrorCode::E0315_OBJECT_CONVERSION,
                fmt::format("`%s` does not implement `%s`, so `%s` cannot become `%s`",
                    shown_value, shown_trait, shown_from, shown_to), expr.span);
            return ObjectConversionOutcome::Refused;
        }
        const block: ImplBlock* = DeclarationNode::impl_of(implementation);
        // An implementation for a generic type's template is generic too:
        // each instantiation has its own copy of the methods.
        if (block.is_generic() || this.ctx.generic_registry.template_of(block.target_def()) != null) {
            mut d: Diagnostic = Diagnostic::error(ErrorCode::E0315_OBJECT_CONVERSION,
                fmt::format("`%s` implements `%s` by a generic implementation, so `%s` cannot become `%s`",
                    shown_value, shown_trait, shown_from, shown_to));
            d = d.at(expr.span);
            d = d.with_note("a value whose implementation is generic does not convert to a trait object yet");
            this.ctx.emit_diagnostic(d);
            return ObjectConversionOutcome::Refused;
        }
        mut blocks: [ImplBlock*] = [];
        if (!this.object_table_implementations(expr, object, value, block, &blocks, shown_from, shown_to,
                shown_value, shown_trait)) {
            return ObjectConversionOutcome::Refused;
        }
        this.ctx.note_object_table(implementation, blocks);
        return ObjectConversionOutcome::Converted(ExpressionNode::object_conversion(expr, value, block, to));
    }

    /// The implementation for `value` of each trait the table of an object
    /// of `object`'s trait holds methods of, in the table's order, `own`
    /// in the object's trait's place.  A supertrait's methods are in the
    /// table too, so the type must implement each supertrait, at the
    /// arguments the object gives it (`TypeResolver::object_trait_arguments`);
    /// false, with E0315 reported, when it does not.
    object_table_implementations(mut &this, expr: ExpressionNode*, object: ObjectType*, value: TypeRef,
                                 own: ImplBlock*, blocks: mut &[ImplBlock*], shown_from: string,
                                 shown_to: string, shown_value: string, shown_trait: string) -> boolean {
        const registry: GenericRegistry* = this.ctx.generic_registry;
        const traits: [DefId] = registry.object_table_traits(object.trait_def);
        const checker: TraitChecker = this.trait_checker();
        for (mut k: i64 = 0; k < traits.length; k++) {
            if (traits[k].equals(object.trait_def)) { blocks.push(own); continue; }
            const args: [TypeRef] = this.ctx.type_resolver.object_trait_arguments(object, traits[k]);
            const shown_super: string = this.arena.display_with_arguments(
                this.intern.resolve(this.ctx.defs.path_of(traits[k]).spelling()), &args);
            const heads: [DeclarationNode*] = registry.heads_for(traits[k], value, this.intern);
            mut found: ImplBlock* = null;
            for (mut i: i64 = 0; i < heads.length; i++) {
                const candidate: ImplBlock* = DeclarationNode::impl_of(heads[i]);
                if (candidate == null || !registry.binds_trait_arguments(candidate, &args, this.intern)) { continue; }
                if (checker.impl_applies(candidate, value, 0)) { found = candidate; break; }
            }
            if (found == null) {
                this.ctx.emit_error_at(ErrorCode::E0315_OBJECT_CONVERSION,
                    fmt::format("`%s` does not implement `%s`, which `%s` requires, so `%s` cannot become `%s`",
                        shown_value, shown_super, shown_trait, shown_from, shown_to), expr.span);
                return false;
            }
            blocks.push(found);
        }
        return true;
    }

    /// A binary operator with a trait object on either side, checked here
    /// and nowhere else; true when one is.  A raw object `virtual T*`
    /// compares with the `null` literal by `==` and `!=`, by its data word;
    /// a borrowed object never compares, and no other operator takes an
    /// object (E0229).
    object_operand_checked(mut &this, e: ExpressionNode*, bin: BinaryExpr*, lhs: TypeRef, rhs: TypeRef) -> boolean {
        const lt: Type* = this.arena.lookup(lhs);
        const rt: Type* = this.arena.lookup(rhs);
        const left_object: boolean = lt != null && lt.kind == TypeKind::Object;
        const right_object: boolean = rt != null && rt.kind == TypeKind::Object;
        if (!left_object && !right_object) { return false; }
        const object_t: Type* = if (left_object) { lt } else { rt };
        const other: ExpressionNode* = if (left_object) { bin.right } else { bin.left };
        const shown: string = this.arena.format_display(object_t);
        match (object_t.as_object().form) {
            ObjectForm::Raw => {
                const equality: boolean = bin.op.kind == TokenType::EqualEqual || bin.op.kind == TokenType::ExclaimEqual;
                if (equality && this.calls.sema_arg_is_null_literal(other)) { return true; }
                this.ctx.emit_error_at(ErrorCode::E0229_INVALID_BINARY_OP,
                    fmt::format("`%s` compares only with `null`, by `==` or `!=`", shown), e.span);
            }
            _ => {
                this.ctx.emit_error_at(ErrorCode::E0229_INVALID_BINARY_OP,
                    fmt::format("`%s` is a borrowed trait object, which does not compare", shown), e.span);
            }
        }
        return true;
    }

    /// E0312 at an implementation of a trait for a type that does not
    /// implement each of the trait's supertraits, at the arguments the trait
    /// writes on it with this implementation's put in
    /// (`TypeResolver::supertrait_arguments`): whatever implements a
    /// subtrait promises the supertrait's methods too.  A supertrait's own
    /// supertraits are its implementation's to check.  Asked here, where
    /// every module's implementations are registered.  A concrete
    /// implementation's supertrait implementation must have its
    /// where-clause hold for the type; a generic one's type arguments are
    /// not known here, so the supertrait's head unifying with it is enough.
    check_supertraits_implemented(mut &this, decl: DeclarationNode*, node: ImplBlock*) -> void {
        if (!node.is_trait_impl() || node.spec_owner.is_valid()) { return; }
        const registry: GenericRegistry* = this.ctx.generic_registry;
        const trait_decl: TraitDecl* = registry.get_trait_decl(node.trait_def);
        if (trait_decl == null || trait_decl.base_traits.length == 0) { return; }
        const owner: TypeRef = this.ctx.decl_index.impl_owner(node, "sema/supertraits implemented");
        const owner_t: Type* = this.arena.lookup(owner);
        if (owner_t == null) { return; }
        const resolver: TypeResolver* = this.ctx.type_resolver;
        mut args: [TypeRef] = [];
        const positions: i64 = trait_decl.generic_params.length + trait_decl.assoc_types.length;
        for (mut k: i64 = 0; k < positions; k++) {
            if (k < trait_decl.generic_params.length && k < node.trait_arg_types.length) {
                args.push(node.trait_arg_types[k]);
                continue;
            }
            const written: TypeAnnotation* = node.trait_slot_annotation(trait_decl, k);
            mut rc: ResolutionContext = ResolutionContext::new("");
            args.push(if (written != null && !node.is_generic()) { resolver.resolve(written, &rc) } else { TypeRef::invalid() });
        }
        const generic: boolean = node.is_generic() || registry.template_of(node.target_def()) != null;
        const checker: TraitChecker = this.trait_checker();
        const shown_owner: string = this.arena.format_display(owner_t);
        const shown_trait: string = this.intern.resolve(this.ctx.defs.path_of(node.trait_def).spelling());
        for (mut i: i64 = 0; i < trait_decl.base_traits.length; i++) {
            const base: DefId = trait_decl.base_traits[i].definition();
            if (!base.is_valid() || registry.get_trait_decl(base) == null) { continue; }
            const base_args: [TypeRef] = resolver.supertrait_arguments(node.trait_def, &args, i);
            const heads: [DeclarationNode*] = registry.heads_for(base, owner, this.intern);
            mut found: boolean = false;
            for (mut h: i64 = 0; h < heads.length && !found; h++) {
                const candidate: ImplBlock* = DeclarationNode::impl_of(heads[h]);
                if (candidate == null || !registry.binds_trait_arguments(candidate, &base_args, this.intern)) { continue; }
                found = generic || checker.impl_applies(candidate, owner, 0);
            }
            if (found) { continue; }
            const shown_base: string = this.arena.display_with_arguments(
                this.intern.resolve(this.ctx.defs.path_of(base).spelling()), &base_args);
            const span: SourceSpan = if (node.target_type_span.has_location()) { node.target_type_span } else { decl.span };
            this.ctx.emit_error_at(ErrorCode::E0312_TRAIT_IMPL_MISMATCH,
                fmt::format("`%s` does not implement `%s`, which `%s` requires, so `%s` cannot implement `%s`",
                    shown_owner, shown_base, shown_trait, shown_owner, shown_trait), span);
        }
    }

    /// The implementation of `object`'s trait for `value` whose where-clause
    /// holds, among those binding the trait at the object's arguments
    /// (`GenericRegistry::binds_trait_arguments`); null when there is none.
    object_implementation(&this, object: ObjectType*, value: TypeRef) -> DeclarationNode* {
        const registry: GenericRegistry* = this.ctx.generic_registry;
        if (registry == null) { return null; }
        const heads: [DeclarationNode*] = registry.heads_for(object.trait_def, value, this.intern);
        const checker: TraitChecker = this.trait_checker();
        for (mut i: i64 = 0; i < heads.length; i++) {
            const block: ImplBlock* = DeclarationNode::impl_of(heads[i]);
            if (block == null) { continue; }
            if (!registry.binds_trait_arguments(block, &object.args, this.intern)) { continue; }
            if (checker.impl_applies(block, value, 0)) { return heads[i]; }
        }
        return null;
    }

    resolve_cast(mut &this, e: ExpressionNode*, cast: CastExpr*) -> TypeRef {
        // The operand of an explicit cast is not bounded by the SURROUNDING
        // annotation.  `as` names its own target, and performing a conversion
        // the operand would not survive implicitly is the whole reason to write
        // one - so leaving the enclosing expected type in scope let the bound
        // the cast exists to satisfy reject the cast's own operand:
        // `const x: i32 = 18446744073709551613 as i32` was "out of range for
        // i32", which is how a two's-complement bit pattern is spelled and what
        // the C importer emits for a negative constant.  Cleared rather than
        // replaced by the target: the literal takes its natural width and the
        // cast truncates, which is the same answer for an in-range operand and
        // the only one that admits a full-width pattern.  A bare literal keeps
        // its bound (no cast, no clear), and a suffixed one is settled before
        // the expected type is consulted at all.
        const saved_expected: TypeRef = this.state.expected_type;
        this.state.expected_type = TypeRef::invalid();
        const from_ty: TypeRef = this.resolve_expr(cast.expression);
        this.state.expected_type = saved_expected;
        if (!cast.has_resolved_target() && cast.target_annotation != null) {
            this.prime_typeof_annotation(cast.target_annotation);
            mut res_ctx: ResolutionContext = ResolutionContext::new("");
            // `x as T` is written inside a body, so the target annotation means
            // what that body's module says (the same shape as
            // `body_res_ctx`).
            // Bind the enclosing generic's type parameters so a cast target like
            // `x as T` resolves `T` to the abstract method/owner type parameter,
            // not a same-named global type in another module.  Without this an
            // innocent user `type struct T` shadows the parameter of any pulled
            // generic (e.g. stdlib `RandomSource::next_range<T>`), turning
            // `<scalar> as T` into an aggregate cast -> spurious E0208.  Mirrors
            // the identical bind at the var-decl / other cast/annotation sites.
            this.symbolic.symbolic_bind_params(&res_ctx);
            const target: TypeRef = this.ctx.type_resolver.resolve(cast.target_annotation, &res_ctx);
            if (target.is_valid()) { cast.set_resolved_target(target); }
            else { this.refuse_unresolved_body_annotation(cast.target_annotation); }
        }
        const to_ty: TypeRef = cast.resolved_target;
        if (from_ty.is_valid() && to_ty.is_valid()
            && !this.cast_operand_is_byref_receiver(cast.expression)
            && this.types.arg_type_is_concrete(from_ty) && this.types.arg_type_is_concrete(to_ty)
            && this.is_aggregate_scalar_cast(from_ty, to_ty)) {
            mut d: Diagnostic = Diagnostic::error(ErrorCode::E0208_INVALID_CAST,
                "invalid cast between an aggregate type (struct/tuple/array) and a scalar or pointer: there is no valid representation for this conversion");
            d = d.at(e.span);
            this.ctx.emit_diagnostic(d);
        } else if (from_ty.is_valid() && to_ty.is_valid()
            && this.types.arg_type_is_concrete(from_ty) && this.types.arg_type_is_concrete(to_ty)
            && this.is_cast_into_other_aggregate(from_ty, to_ty)) {
            const to_name: string = this.types.type_display_name(to_ty);
            mut d: Diagnostic = Diagnostic::error(ErrorCode::E0208_INVALID_CAST,
                fmt::format("cannot cast `%s` to `%s`: a struct, tuple or array value is cast only from a value of its own type",
                    this.types.type_display_name(from_ty), to_name));
            d = d.at_with_label(e.span, "no conversion makes this value");
            this.ctx.emit_diagnostic(d);
        }
        if (from_ty.is_valid() && to_ty.is_valid()
            && this.diag.kind_or_void(to_ty) == TypeKind::Bool
            && this.assignment_judgeable(from_ty)
            && !this.checker.can_assign(from_ty, to_ty)) {
            this.ctx.emit_error_at(ErrorCode::E0208_INVALID_CAST,
                fmt::format("cannot cast `%s` to `boolean`: nothing converts to `boolean`; %s",
                    this.types.type_display_name(from_ty), this.diag.truth_test_hint(from_ty)),
                e.span);
        }
        return cast.resolved_target;
    }

    /// True when the cast operand is `this` inside a BY-REFERENCE method.
    ///
    /// Such a receiver is an address - it is passed as a pointer - but it is
    /// typed as the owner so that member access inside the body reads as the
    /// value it stands for.  So `this as void*` is pointer-to-pointer, not the
    /// aggregate-to-scalar conversion E0208 exists to reject, and it is how the
    /// C client-data idiom is spelled (`clang_visitChildren(cur, visitor, this
    /// as void*)`).  A BY-VALUE receiver is a real aggregate and still reports:
    /// there the cast has no representation, exactly as for any other value.
    cast_operand_is_byref_receiver(&this, expr: ExpressionNode*) -> boolean {
        if (expr == null || !this.state.this_is_by_ref) { return false; }
        const id: IdentifierExpr* = ExpressionNode::identifier_of(expr);
        if (id == null) { return false; }
        return this.names_receiver(id);
    }

    /// True when a cast's target is a struct, tuple or array value and
    /// its operand is of any other type.  Such a value is laid out in memory,
    /// and no conversion builds one from a pointer, a scalar or a different
    /// aggregate: code generation has only a bitcast to offer, which is
    /// invalid between those representations.  An instantiation compares as
    /// the type it resolved to.
    is_cast_into_other_aggregate(&this, from: TypeRef, to: TypeRef) -> boolean {
        const f: TypeRef = this.cast_subject(from);
        const t: TypeRef = this.cast_subject(to);
        if (!f.is_valid() || !t.is_valid() || f.equals(t)) { return false; }
        const tt: Type* = this.arena.lookup(t);
        if (tt == null) { return false; }
        return tt.kind == TypeKind::Struct
            || tt.kind == TypeKind::Tuple || tt.kind == TypeKind::Array;
    }

    /// The type an instantiation resolved to; any other type is itself.
    /// Invalid for an instantiation not yet resolved.
    cast_subject(&this, ty: TypeRef) -> TypeRef {
        const t: Type* = this.arena.lookup(ty);
        if (t == null) { return TypeRef::invalid(); }
        if (t.kind != TypeKind::InstantiatedType) { return ty; }
        const inst: InstantiatedType* = t.as_instantiated();
        if (!inst.has_resolved_type()) { return TypeRef::invalid(); }
        return inst.resolved_type;
    }

    /// True when a cast crosses between a struct, tuple or array value and a
    /// scalar/pointer type (no valid LLVM lowering).  A by-reference `this`
    /// is an address already and is not asked here
    /// (`cast_operand_is_byref_receiver`).  An aggregate as the TARGET is
    /// `is_cast_into_other_aggregate`'s.
    is_aggregate_scalar_cast(&this, from: TypeRef, to: TypeRef) -> boolean {
        mut f: Type* = this.arena.lookup(from);
        mut t: Type* = this.arena.lookup(to);
        if (f == null || t == null) { return false; }
        if (f.kind == TypeKind::InstantiatedType) {
            const fi: InstantiatedType* = f.as_instantiated();
            if (!fi.has_resolved_type()) { return false; }
            f = this.arena.lookup(fi.resolved_type);
        }
        if (t.kind == TypeKind::InstantiatedType) {
            const ti: InstantiatedType* = t.as_instantiated();
            if (!ti.has_resolved_type()) { return false; }
            t = this.arena.lookup(ti.resolved_type);
        }
        if (f == null || t == null) { return false; }
        const f_agg: boolean = f.kind == TypeKind::Struct
                            || f.kind == TypeKind::Tuple || f.kind == TypeKind::Array;
        const t_agg: boolean = t.kind == TypeKind::Struct || t.kind == TypeKind::Tuple || t.kind == TypeKind::Array;
        const f_scl: boolean = f.kind == TypeKind::Int || f.kind == TypeKind::Float || f.kind == TypeKind::Bool
                            || f.kind == TypeKind::Char || f.kind == TypeKind::String || f.kind == TypeKind::Pointer
                            || f.kind == TypeKind::Reference || f.kind == TypeKind::Enum;
        const t_scl: boolean = t.kind == TypeKind::Int || t.kind == TypeKind::Float || t.kind == TypeKind::Bool
                            || t.kind == TypeKind::Char || t.kind == TypeKind::String || t.kind == TypeKind::Pointer
                            || t.kind == TypeKind::Reference || t.kind == TypeKind::Enum;
        return (f_agg && t_scl) || (f_scl && t_agg);
    }

    /// Arms of a value-producing branch have to agree on a type.  Neither arm is
    /// the "expected" one, so compatibility is tested in both directions and only
    /// a pair that is incompatible each way reports; a diverging arm carries
    /// `Never`, which coerces to anything and therefore never fires here.
    /// Without this check the resolver returns whichever arm happens to type
    /// first, so arms of unrelated types (`char` vs `i8`) reach codegen and the
    /// result is read at the wrong width.
    check_branch_agreement(mut &this, first: TypeRef, first_span: SourceSpan,
                           second: TypeRef, second_span: SourceSpan,
                           context_msg: string) -> void {
        if (!first.is_valid() || !second.is_valid()) { return; }
        if (first.equals(second)) { return; }
        // An unresolved projection is not yet a type, so agreement with one is
        // only decidable per instantiation; a bare parameter is a type.
        if (this.symbolic.type_has_unresolved_projection(first)
                || this.symbolic.type_has_unresolved_projection(second)
                || !this.symbolic.symbolic_judgeable(first)
                || !this.symbolic.symbolic_judgeable(second)) { return; }
        if (this.checker.check_compatibility(first, second) != TypeCompatibility::Incompatible) { return; }
        if (this.checker.check_compatibility(second, first) != TypeCompatibility::Incompatible) { return; }
        this.diag.emit_type_mismatch(ErrorCode::E0238_BRANCH_TYPE_MISMATCH,
            second_span, first, second, context_msg, first_span);
    }

    resolve_if_expr(mut &this, if_expr: IfExpr*) -> TypeRef {
        this.resolve_condition(if_expr.condition);
        const then_type: TypeRef = this.resolve_expr(if_expr.then_expr);
        const else_type: TypeRef = this.resolve_expr(if_expr.else_expr);
        this.check_branch_agreement(then_type, if_expr.then_expr.span,
            else_type, if_expr.else_expr.span,
            "both branches of an `if` expression must produce the same type");
        return this.branch_result_type(if_expr.then_expr, then_type, else_type);
    }

    /// The type a two-branch expression produces: its first branch's, unless
    /// that branch is `null`, which converts to every pointer and so says
    /// nothing about the value; the other branch's type then does.  Typed as
    /// the `null`, the value read as `void*` and assigned to a pointer of any
    /// type, whatever the other branch held.
    branch_result_type(&this, first_expr: ExpressionNode*, first: TypeRef, second: TypeRef) -> TypeRef {
        if (second.is_valid() && (!first.is_valid() || this.calls.sema_arg_is_null_literal(first_expr))) { return second; }
        return first;
    }

    resolve_ternary(mut &this, ternary: TernaryExpr*) -> TypeRef {
        this.resolve_condition(ternary.condition);
        const true_type: TypeRef = this.resolve_expr(ternary.true_expr);
        const false_type: TypeRef = this.resolve_expr(ternary.false_expr);
        this.check_branch_agreement(true_type, ternary.true_expr.span,
            false_type, ternary.false_expr.span,
            "both arms of a conditional expression must produce the same type");
        return this.branch_result_type(ternary.true_expr, true_type, false_type);
    }

    resolve_match_expr(mut &this, e: ExpressionNode*, match_expr: MatchExpr*) -> TypeRef {
        const subject_type: TypeRef = this.resolve_expr(match_expr.subject);
        const caller_backed: boolean = this.subject_is_caller_backed(match_expr.subject);
        this.patterns.check_duplicate_default_arm(match_expr.arms);
        const outer_expected: TypeRef = this.state.expected_type;
        mut result_type: TypeRef = TypeRef::invalid();
        mut result_span: SourceSpan = e.span;
        for (mut i: i64 = 0; i < match_expr.arms.length; i++) {
            const arm: MatchArmNode* = match_expr.arms[i];
            if (arm == null || arm.body == null) { continue; }
            const save: i64 = this.scopes.save_scope();
            this.patterns.bind_arm_patterns(arm, subject_type, caller_backed);
            if (arm.guard != null) { this.resolve_condition(arm.guard); }
            match (arm.body.kind) {
                StmtKind::Block(block) => {
                    const last_idx: i64 = block.statements.length - 1;
                    for (mut j: i64 = 0; j < block.statements.length; j++) {
                        if (j == last_idx && outer_expected.is_valid()) { this.state.expected_type = outer_expected; }
                        this.dispatch_stmt(block.statements[j]);
                        if (j == last_idx) { this.state.expected_type = outer_expected; }
                    }
                    if (block.statements.length > 0) {
                        match (block.statements[block.statements.length - 1].kind) {
                            StmtKind::Expr(es) => {
                                if (es.expression != null && es.expression.has_resolved_type()) {
                                    const arm_type: TypeRef = es.expression.resolved_type;
                                    if (!result_type.is_valid()) {
                                        result_type = arm_type;
                                        result_span = es.expression.span;
                                    } else {
                                        this.check_branch_agreement(result_type, result_span,
                                            arm_type, es.expression.span,
                                            "every arm of a `match` expression must produce the same type");
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                }
                _ => { this.dispatch_stmt(arm.body); }
            }
            this.scopes.restore_scope(save);
        }
        this.state.expected_type = outer_expected;
        this.patterns.check_match_exhaustive(match_expr.subject, subject_type, match_expr.arms, e.span);
        this.patterns.check_literal_patterns(match_expr.arms, subject_type);
        if (outer_expected.is_valid()) { return outer_expected; }
        return result_type;
    }

    resolve_static_match_expr(mut &this, e: ExpressionNode*, sm: StaticMatchExpr*) -> TypeRef {
        if (sm == null || sm.arms.length == 0) { return TypeRef::invalid(); }
        if (sm.arms.length > 1 && !this.state.in_symbolic_check) {
            this.ctx.emit_error_at(ErrorCode::E0645_NO_STATIC_MATCH_ARM,
                "`static match` outside a generic context is not supported yet (its type could not be resolved to a single arm)",
                e.span);
        }
        const outer_expected: TypeRef = this.state.expected_type;
        mut result_type: TypeRef = TypeRef::invalid();
        // A generic template's walk checks EVERY arm: each instantiation keeps
        // the arm its type selects and copies that arm's body, so an unwalked
        // arm copies with untyped receivers and unbound inner calls.  A concrete
        // (already-pruned) static match has exactly one arm.
        if (this.state.in_symbolic_check && ASTCloner::has_multi_type_arm(&sm.arms)) {
            sm.arms = ASTCloner::split_multi_type_arms(&sm.arms);
        }
        const n_arms: i64 = if (this.state.in_symbolic_check) { sm.arms.length } else { 1 };
        for (mut ai: i64 = 0; ai < n_arms; ai++) {
            const arm: StaticMatchArmNode* = sm.arms[ai];
            if (arm == null || arm.body == null) { continue; }
            const arm_result: TypeRef = this.walk_static_match_arm(sm.scrutinee, arm, true, outer_expected);
            // The static match's type is the first arm's (all arms must agree).
            if (ai == 0) { result_type = arm_result; }
        }
        this.state.expected_type = outer_expected;
        if (outer_expected.is_valid()) { return outer_expected; }
        return result_type;
    }

    /// Walk one arm of a `static match (T)`, reporting what is wrong in it
    /// whichever instantiation selects it.  An arm listing a type is walked
    /// with `T` narrowed to that type; the wildcard arm with `T` abstract,
    /// knowing only `T`'s bounds.  An arm listing several types has been
    /// split into one arm per type before this (`split_multi_type_arms`).
    /// Returns the arm's value type when `as_value`.
    walk_static_match_arm(mut &this, scrutinee: TypeAnnotation*, arm: StaticMatchArmNode*,
                          as_value: boolean, outer_expected: TypeRef) -> TypeRef {
        const pattern: TypeAnnotation* = if (arm.type_patterns.length == 1) { arm.type_patterns[0] } else { null };
        const body: Stmt* = arm.body;
        const depth: u64 = this.state.symbolic_narrow_syms.length as u64;
        const save: i64 = this.narrow_static_match_arm(scrutinee, pattern);
        mut arm_result: TypeRef = TypeRef::invalid();
        const value_block: BlockStmt* = if (as_value) {
            match (body.kind) {
                StmtKind::Block(b) => { b }
                _                  => { null }
            }
        } else {
            null
        };
        if (value_block != null) {
            const last_idx: i64 = value_block.statements.length - 1;
            for (mut j: i64 = 0; j < value_block.statements.length; j++) {
                if (j == last_idx && outer_expected.is_valid()) { this.state.expected_type = outer_expected; }
                this.dispatch_stmt(value_block.statements[j]);
                if (j == last_idx) { this.state.expected_type = outer_expected; }
            }
            if (value_block.statements.length > 0) {
                match (value_block.statements[last_idx].kind) {
                    StmtKind::Expr(es) => {
                        if (es.expression != null && es.expression.has_resolved_type()) { arm_result = es.expression.resolved_type; }
                    }
                    _ => {}
                }
            }
        } else {
            this.dispatch_stmt(body);
        }
        this.scopes.restore_scope(save);
        this.state.symbolic_narrow_syms.truncate(depth);
        this.state.symbolic_narrow_types.truncate(depth);
        return arm_result;
    }

    /// During the symbolic generic-body check, narrow a `static match (T)` arm to
    /// the concrete type `pattern` for the duration of one walk of its body.
    /// When the scrutinee is a bare generic param (`T`), a type naming `T` is
    /// the pattern's type inside the arm (`symbolic_bind_params` reads the
    /// narrowing), and every in-scope local typed exactly `T` is rebound to it,
    /// so member/method resolution - and hover - sees the real type instead of
    /// an abstract param.  The rebinding is logged on the scope undo log; the
    /// caller restores the returned checkpoint after the body and pops the
    /// narrowing.  A no-op returning the checkpoint unchanged when not eligible
    /// (non-symbolic walk, no pattern, non-generic scrutinee, or a
    /// still-generic pattern).
    narrow_static_match_arm(mut &this, scrutinee: TypeAnnotation*,
                            pattern: TypeAnnotation*) -> i64 {
        const save: i64 = this.scopes.save_scope();
        if (!this.state.in_symbolic_check) { return save; }
        if (scrutinee == null || pattern == null) { return save; }
        if (this.arena == null) { return save; }

        mut rc: ResolutionContext = ResolutionContext::new("");
        // The scrutinee annotation is written at the `static match`, inside a
        // body, and resolves there.
        this.symbolic.symbolic_bind_params(&rc);
        const scrut_ref: TypeRef = this.ctx.type_resolver.resolve(scrutinee, &rc);
        if (!scrut_ref.is_valid()) { return save; }
        const st: Type* = this.arena.lookup(scrut_ref);
        if (st == null) { return save; }
        if (st.kind != TypeKind::GenericParam) { return save; }

        const arm_ref: TypeRef = this.ctx.type_resolver.resolve(pattern, &rc);
        if (!arm_ref.is_valid() || this.arena.contains_generic_param(arm_ref)) { return save; }
        this.state.symbolic_narrow_syms.push(st.as_generic_param().param_sym);
        this.state.symbolic_narrow_types.push(arm_ref);

        // Collect the locals whose type names the scrutinee param first - `T`
        // itself, or `&T`, `T*`, `Array<T>` - then re-declare each with the
        // arm's type in the param's place: `declare` mutates
        // `state.bindings`, so it must not run while the entry iterator is
        // live.
        mut params: [TypeRef] = [scrut_ref];
        mut args: [TypeRef] = [arm_ref];
        const narrowing: TypeSubstitution = TypeSubstitution::from_params(&params, &args);
        mut rebound: [LocalBinding] = [];
        mut rebound_types: [TypeRef] = [];
        mut bit: HashMapIter<SymbolKey, LocalBinding> = this.state.bindings.iter();
        loop {
            match (bit.next()) {
                Option::Some(pair) => {
                    const b: LocalBinding = pair.second;
                    if (b.ty.equals(scrut_ref)) {
                        rebound.push(b);
                        rebound_types.push(arm_ref);
                    } else if (this.arena.contains_generic_param(b.ty)) {
                        const nt: TypeRef = narrowing.apply(b.ty, this.arena);
                        if (nt.is_valid() && !nt.equals(b.ty)) {
                            rebound.push(b);
                            rebound_types.push(nt);
                        }
                    }
                }
                Option::None => { break; }
            }
        }
        for (mut i: i64 = 0; i < rebound.length; i++) {
            this.scopes.declare(rebound[i].sym, rebound_types[i], rebound[i].is_mut);
        }
        return save;
    }

    /// `Poll::Ready(value)` for a `return` of type `poll_out`. Mirrors the
    /// wrapper the async lowering puts on every `return` it moves into a
    /// `poll` body.  The `Res` alone and no type: a node that carries its type
    /// is answered from it and never walked, and the walk of the `return` it
    /// is built into is what pins the variant.
    make_poll_ready(&this, value: ExpressionNode*, poll_out: TypeRef,
                    span: SourceSpan) -> ExpressionNode* {
        const scope: ExpressionNode* = ExpressionNode::scope_resolution_expr(
            this.async_lower.poll_identity(), this.intern.intern("Ready"), span);
        ExpressionNode::scope_resolution_of(scope).set_synthesized_res(
            this.ctx.decl_index.def_of(poll_out, this.ctx.type_arena));
        mut call: ExpressionNode* = ExpressionNode::call_expr(scope, span);
        ExpressionNode::call_of(call).add_argument(value);
        return call;
    }

    /// `func`'s Output if it is the `poll` an `async fn` was lowered into,
    /// otherwise invalid.
    ///
    /// The lowering moves the async function's own statements into this body, so
    /// a construct whose legality depends on the enclosing return type — `?` —
    /// must be judged against what the source function returned. Identified by
    /// the three marks `declare` puts on the generated method (a synthesized
    /// body, `Future`'s `poll`), never by shape alone: a hand-written
    /// `-> Poll<Result<..>>` is a real function and keeps the ordinary rule.
    async_poll_output_of(&this, func_decl: DeclarationNode*) -> TypeRef {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null) { return TypeRef::invalid(); }
        if (!func.is_synthesized_body) { return TypeRef::invalid(); }
        // `origin_trait` is the trait's identity, so the comparison is against
        // the declaration the language means by `Future` - a user trait that
        // happens to share the leaf is not it.
        const future_id: DefId = this.ctx.generic_registry.wellknown(LangItem::Future);
        if (!future_id.is_valid() || !func.origin_trait.equals(future_id)) { return TypeRef::invalid(); }
        if (!this.ctx.generic_registry.names_lang_method(func.name, LangItem::FuturePoll)) { return TypeRef::invalid(); }
        // Read the Output off `Poll::Ready`'s payload rather than the return
        // type's generic argument: once monomorphization has specialized it,
        // `Poll<Output>` is a plain enum with no instantiation left to peel.
        // The enum is the language's `Poll` by its declaration's identity
        // (a specialized enum carries its template as `generic_base`), and
        // `Ready` is read inside a type known to declare it.
        const e: Type* = this.types.unwrap_to_enum(func.resolved_return_type);
        if (e == null || e.kind != TypeKind::Enum) { return TypeRef::invalid(); }
        const et: EnumType* = e.as_enum();
        const poll_def: DefId = this.ctx.generic_registry.wellknown(LangItem::Poll);
        if (!poll_def.is_valid() || !this.enum_decl_def(func.resolved_return_type).equals(poll_def)) {
            return TypeRef::invalid();
        }
        const ready: i64 = et.variant_index(this.intern.intern("Ready"));
        if (ready < 0 || et.variants[ready].payload_types.length != 1) { return TypeRef::invalid(); }
        return et.variants[ready].payload_types[0];
    }

    /// 1 when `ty` is the language's `Result`, 2 when it is its `Option`, 0
    /// otherwise - by the identity each declaration claimed
    /// (`GenericRegistry::wellknown`), never by the variants an enum spells:
    /// `type enum Outcome { Ok(i32); Err(i32); }` is another enum, and `?` on
    /// it is refused as on any other.  An instantiation answers as its
    /// template, resolved (a specialized enum carries its `generic_base`) or
    /// not.
    enum_try_shape(&this, ty: TypeRef) -> i32 {
        const d: DefId = this.enum_decl_def(ty);
        if (!d.is_valid()) { return 0; }
        const result_id: DefId = this.ctx.generic_registry.wellknown(LangItem::Result);
        if (result_id.is_valid() && d.equals(result_id)) { return 1; }
        const option_id: DefId = this.ctx.generic_registry.wellknown(LangItem::Option);
        if (option_id.is_valid() && d.equals(option_id)) { return 2; }
        return 0;
    }

    /// The declaration of the enum `ty` is, through references, pointers and
    /// an instantiation: a specialization answers as its template.  Invalid
    /// when `ty` is no enum.
    enum_decl_def(&this, ty: TypeRef) -> DefId {
        if (!ty.is_valid()) { return DefId::invalid(); }
        const t: Type* = this.arena.lookup(ty);
        if (t == null) { return DefId::invalid(); }
        if (t.kind == TypeKind::Reference) { return this.enum_decl_def(t.as_reference().referent); }
        if (t.kind == TypeKind::Pointer) { return this.enum_decl_def(t.as_pointer().pointee); }
        if (t.kind == TypeKind::InstantiatedType) {
            return this.enum_decl_def(t.as_instantiated().generic_base);
        }
        if (t.kind != TypeKind::Enum) { return DefId::invalid(); }
        const base: TypeRef = t.as_enum().generic_base;
        return this.ctx.decl_index.def_of(if (base.is_valid()) { base } else { ty }, this.ctx.type_arena);
    }

    /// `ret_ty` is the ENCLOSING FUNCTION's return type, not the operand's: the
    /// `Err`/`None` this builds is the value returned on the error arm, so that
    /// is the enum its scope segment names. The two agree on shape (the caller
    /// rejects a mismatch) but not necessarily on instantiation, and only the
    /// returned one is what the synthesized reference refers to.
    build_try_desugar(mut &this, e: ExpressionNode*, node: TryExpr*, is_result: boolean,
                      operand_ty: TypeRef, ret_ty: TypeRef) -> ExpressionNode* {
        const span: SourceSpan = e.span;
        this.state.try_counter += 1;
        const enum_name: SymbolStr = this.intern.intern(if (is_result) { "Result" } else { "Option" });
        const ok_variant: SymbolStr = this.intern.intern(if (is_result) { "Ok" } else { "Some" });
        const err_variant: SymbolStr = this.intern.intern(if (is_result) { "Err" } else { "None" });
        const ok_bind: SymbolStr = this.intern.intern(fmt::format("__cryo_try_%u", this.state.try_counter));

        const desugar: ExpressionNode* = ExpressionNode::match_expr(node.operand, span);
        mut match_expr: MatchExpr* = ExpressionNode::match_of(desugar);
        const ok_node: Pattern* = Pattern::enum_variant(enum_name, ok_variant, span);
        mut ok_pat: EnumPattern* = ok_node.enum_payload();
        ok_pat.set_res(Res::Def(this.ctx.decl_index.def_of(operand_ty, this.ctx.type_arena)));
        // Both bindings are declared here, after name resolution ran, so each
        // takes its identity from the allocator and every use this builds
        // carries it: a later pass tracking the payload's move asks by it.
        const ok_sym: SymbolID = this.resolver.alloc_synthetic_binding();
        const ok_pb: PatternBinding* = new PatternBinding {
            name: ok_bind, span: span, sym_id: ok_sym,
            resolved_type: TypeRef::invalid(), written_mut: false
        };
        ok_pat.add_element(PatternElement::Binding(ok_pb));
        mut ok_arm: MatchArmNode* = MatchArmNode::new(span);
        ok_arm.add_pattern(ok_node);
        const ok_ident: ExpressionNode* = ExpressionNode::identifier_expr(ok_bind, span);
        ExpressionNode::identifier_of(ok_ident).set_res(Res::Local(ok_sym));
        const ok_block: Stmt* = Stmt::block(span);
        ok_block.as_block().add_statement(Stmt::expr_stmt(ok_ident, span));
        ok_arm.set_body(ok_block);
        match_expr.add_arm(ok_arm);

        const err_node: Pattern* = Pattern::enum_variant(enum_name, err_variant, span);
        mut err_pat: EnumPattern* = err_node.enum_payload();
        err_pat.set_res(Res::Def(this.ctx.decl_index.def_of(operand_ty, this.ctx.type_arena)));
        mut ret_value: ExpressionNode* = null;
        if (is_result) {
            const err_bind: SymbolStr = this.intern.intern(fmt::format("__cryo_try_err_%u", this.state.try_counter));
            const err_sym: SymbolID = this.resolver.alloc_synthetic_binding();
            const err_pb: PatternBinding* = new PatternBinding {
                name: err_bind, span: span, sym_id: err_sym,
                resolved_type: TypeRef::invalid(), written_mut: false
            };
            err_pat.add_element(PatternElement::Binding(err_pb));
            const err_scope: ExpressionNode* = ExpressionNode::scope_resolution_expr(enum_name, err_variant, span);
            ExpressionNode::scope_resolution_of(err_scope).set_synthesized_ref(err_scope, ret_ty,
                this.ctx.decl_index.def_of(ret_ty, this.ctx.type_arena));
            mut err_call: ExpressionNode* = ExpressionNode::call_expr(err_scope, span);
            const err_ident: ExpressionNode* = ExpressionNode::identifier_expr(err_bind, span);
            ExpressionNode::identifier_of(err_ident).set_res(Res::Local(err_sym));
            ExpressionNode::call_of(err_call).add_argument(err_ident);
            ret_value = err_call;
        } else {
            const bare_err: ExpressionNode* =
                ExpressionNode::scope_resolution_expr(enum_name, err_variant, span);
            // The `Res` alone: a node that carries its type is answered from
            // it and never walked, and the walk is what pins the variant
            // codegen builds.  It types the value by the return it is in.
            ExpressionNode::scope_resolution_of(bare_err).set_synthesized_res(
                this.ctx.decl_index.def_of(ret_ty, this.ctx.type_arena));
            ret_value = bare_err;
        }
        // Inside the `poll` an `async fn` was lowered into, every `return`
        // carries `Poll::Ready(...)`. The lowering wrapped the returns it could
        // see, but this desugar is built after it ran — a `?` in a GENERIC body
        // can only be shaped once its operand's `Result`/`Option` type is
        // concrete, which is after specialization — so it wraps its own.
        if (this.state.async_poll_output.is_valid()) {
            ret_value = this.make_poll_ready(ret_value, this.state.return_type, span);
        }
        mut err_arm: MatchArmNode* = MatchArmNode::new(span);
        err_arm.add_pattern(err_node);
        const err_block: Stmt* = Stmt::block(span);
        err_block.as_block().add_statement(Stmt::return_stmt(ret_value, span));
        err_arm.set_body(err_block);
        match_expr.add_arm(err_arm);
        return desugar;
    }

    resolve_try_expr(mut &this, e: ExpressionNode*, node: TryExpr*) -> TypeRef {
        // The operand is resolved on EVERY visit, including one that reuses an
        // existing desugar: call-specialization and dispatch annotation both
        // walk `operand` (never `desugared`), so a specialization whose operand
        // went unresolved here reaches codegen with an unresolvable call.
        const saved_expected: TypeRef = this.state.expected_type;
        this.state.expected_type = TypeRef::invalid();
        const operand_type: TypeRef = this.resolve_expr(node.operand);
        this.state.expected_type = saved_expected;

        // Already desugared: that desugar IS the expression from here on, and it
        // is kept rather than rebuilt — the async lowering has since rewritten
        // it in place (awaits hoisted out, `return`s wrapped in `Poll::Ready`,
        // bindings alpha-renamed), and a fresh one would throw all of that away.
        // Re-resolving it re-derives the types a specialization clone dropped.
        if (node.desugared != null) { return this.resolve_expr(node.desugared); }

        if (!operand_type.is_valid()) { return TypeRef::invalid(); }

        const operand_shape: i32 = this.enum_try_shape(operand_type);
        if (operand_shape == 0) {
            if (this.symbolic.symbolic_type_unresolved(operand_type)) { return TypeRef::invalid(); }
            const ot: Type* = this.arena.lookup(operand_type);
            const disp: string = if (ot != null) { this.arena.format_display(ot) } else { "?" };
            this.ctx.emit_error_at(ErrorCode::E0234_INVALID_TRY_OPERAND,
                fmt::format("the `?` operator requires a `Result` or `Option` value, but the operand has type '%s'", disp), e.span);
            return TypeRef::invalid();
        }
        // Inside a lowered `poll`, the async function's Output is what `?`
        // propagates out of; everywhere else it is the function's own return.
        const fn_ret: TypeRef = if (this.state.async_poll_output.is_valid()) {
            this.state.async_poll_output
        } else { this.state.return_type };
        const fn_shape: i32 = this.enum_try_shape(fn_ret);
        if (fn_shape != operand_shape) {
            // A return type that still mentions an abstract parameter cannot
            // settle this. An `async` trait default body is walked once with its
            // return type ALREADY rewritten to the future it lowers to
            // (`This::…Fut`), before the walk that sees the declared output, and
            // judging a `?` against the future would reject every one of them.
            // Deferring is what the shape check does with any not-yet-concrete
            // type — the concrete walk is where a `?` can be shaped at all.
            if (this.arena.contains_generic_param(fn_ret)) { return TypeRef::invalid(); }
            if (this.symbolic.symbolic_type_unresolved(fn_ret)
                    || this.symbolic.symbolic_type_unresolved(operand_type)) {
                return TypeRef::invalid();
            }
            const want: string = if (operand_shape == 1) { "Result" } else { "Option" };
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0235_TRY_OUTSIDE_RESULT_FN,
                fmt::format("the `?` operator can only be used in a function that returns `%s`", want));
            diag = diag.at_with_label(e.span, fmt::format("propagates a `%s`, but the enclosing function doesn't return one", want));
            const ann_span: SourceSpan = annotation_span(this.state.return_type_ann);
            if (ann_span.has_location()) {
                const ret_repl: string = this.arena.resolve_display_name_short(operand_type);
                diag = diag.suggest(Suggestion::single(ann_span, ret_repl, fmt::format("change the return type to `%s`", ret_repl), Applicability::HasPlaceholders));
            }
            this.ctx.emit_diagnostic(diag);
            return TypeRef::invalid();
        }
        const desugared: ExpressionNode* = this.build_try_desugar(e, node, operand_shape == 1, operand_type, fn_ret);
        node.set_desugared(desugared);
        return this.resolve_expr(desugared);
    }

    /// Resolve a struct/union literal's TYPE through the SAME canonical path
    /// a type ANNOTATION uses - `instantiate_for_module`, exactly as `resolve()`
    /// does for `x as Foo<Args>`.  ONE resolution authority: a `Foo<Args> {}`
    /// literal denotes the same canonical TypeID as the annotation `Foo<Args>`, so
    /// `return NonNull<U> {}` matches its declared `-> NonNull<U>` by identity - no
    /// name-lookup that races spec registration.  Fires ONLY when every arg
    /// resolves CONCRETE: an abstract arg (`Pair<T, V>` in a template body, or an
    /// unresolved method generic) would materialize a `Foo<?>` instantiation that
    /// GenericValidation flags (E0900), so those return invalid and the caller
    /// keeps the demand-free name-based path.
    resolve_struct_literal_type(mut &this, e: ExpressionNode*, lit: StructExpr*) -> TypeRef {
        if (lit.generic_args.length == 0) {
            return TypeRef::invalid();
        }
        // The BASE comes from the answer the name layer wrote on this node, not
        // from matching its spelling against the index.  The stamp is a
        // canonical name that already accounts for the imports of the module
        // that WROTE the literal; the spelling is the same question asked with
        // strictly less information, and the tier that ends its cascade is keyed
        // by bare leaf and so answers from any module in the program.
        //
        // A `Res` names a DEFINITION, so it is exactly the base a template is
        // registered under - and unlike the spelling it cannot be confused with
        // a specialization, because there is no way to write one in it.
        mut base_ref: TypeRef = TypeRef::invalid();
        // Through the door: a struct literal's type is written where the
        // literal is, and the name layer stamped every one in the corpus.
        match (lit.res.require("sema:struct literal base")) {
            Res::Def(q) => { base_ref = this.ctx.decl_index.type_of_def(q); }
            // A literal's type is a struct, so a primitive stamp here is
            // not a template to look up.  Named rather than folded into the
            // wildcard: the primitive answer is new, and a reader must be
            // able to see it was considered.
            Res::PrimTy(_) => { }
            _              => { }
        }
        if (!base_ref.is_valid()) { return TypeRef::invalid(); }
        // Demand-FREE, and answered by the SAME primitive the call resolver uses
        // for a scope qualifier: one node carries a base and written arguments,
        // and so does the other.  Two copies would drift on how arguments are
        // homed and resolve one source text to two different slots.
        //
        // The literal only REFERENCES the type; its monomorphization demand comes
        // from the declared type it flows into.  An argument that mentions a
        // generic parameter yields the template-internal instantiation, which is
        // what the literal denotes inside a template body and what specialization
        // rewrites - falling back to the bare base would erase the arguments, and
        // a type built from it mentions no parameter at all, so specialization
        // would leave it untouched.
        return this.calls.resolve_generic_scope_type(base_ref, lit.generic_args,
                                                     e.span);
    }

    resolve_struct_literal(mut &this, e: ExpressionNode*, lit: StructExpr*) -> TypeRef {
        mut struct_ref: TypeRef = TypeRef::invalid();
        // Monomorphization records a specialized literal's instantiation as the
        // arena id itself, which IS `(definition, arguments)` already resolved.
        // Reading it is the whole answer.  Deriving one from the spelling
        // instead would ask the same question from strictly less information:
        // the spelling deliberately keeps what the source wrote, so it names a
        // definition and can never name a specialization.
        if (e.resolved_type.is_valid()) { struct_ref = e.resolved_type; }
        // The pair answers next: a base named by the stamp plus this node's own
        // substituted arguments, keyed through the arena's canonical
        // instantiation slot.  It runs BEFORE any name is minted because it is
        // the same fact without the round trip through a string - and a mangled
        // spec name minted from an already-mangled spelling names nothing at
        // all, which is what made this lookup miss three times in four.
        if (!struct_ref.is_valid() && lit.generic_args.length > 0) {
            struct_ref = this.resolve_struct_literal_type(e, lit);
        }
        // A literal with no arguments has no pair to resolve, so neither branch
        // above applies and the stamp is the whole answer: it names one
        // definition, canonically, accounting for the writing module's imports.
        // A C-imported aggregate is stamped like any other: its alias-qualified
        // spelling is the name it was declared under, whole, and the name layer
        // reads it from the writing module's scope.  There is deliberately no
        // spelling lookup beneath the stamp - a literal the stamp makes no claim
        // for names nothing, and a lookup by its spelling would answer from
        // whichever module owns the leaf.
        if (!struct_ref.is_valid()) {
            struct_ref = this.types.spelling_type(lit.res);
        }
        mut struct_t: Type* = if (struct_ref.is_valid()) { this.arena.lookup(struct_ref) } else { null };
        if (struct_t != null && struct_t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = struct_t.as_instantiated();
            if (inst.has_resolved_type()) { struct_t = this.arena.lookup(inst.resolved_type); }
        }

        // The literal's TYPE is the canonical default instantiation for a bare
        // all-default generic (`String { .. }` denotes `String<GlobalAlloc>`),
        // matching how a bare `String` annotation resolves - so the literal shares
        // ONE TypeID with its declared type.  `struct_ref`/`struct_t` stay raw
        // below for the template's field lookup, visibility, and arity checks.
        mut lit_type: TypeRef = struct_ref;
        lit_type = this.ctx.type_resolver.canonicalize_default_generic_type(struct_ref);

        // A generic struct's literal written without arguments, outside a
        // generic body, is one instance of it: the one the expected type
        // names (`const b: Boxy<i32> = Boxy { v: 3 };`), else the one its
        // field values bind (`second(Pair { a: 1, b: 5 })`).  Its fields are
        // that instance's; the template still answers the literal's shape.
        mut field_owner: TypeRef = struct_ref;
        mut infer_from: TemplateEntry* = null;
        if (!this.state.in_symbolic_check && lit.generic_args.length == 0
                && !e.resolved_type.is_valid() && lit_type.equals(struct_ref) && struct_ref.is_valid()) {
            const lt: TemplateEntry* = this.ctx.generic_registry.template_of_type(struct_ref);
            if (lt != null && lt.param_types.length > 0
                    && (lt.kind == TemplateKind::Struct)) {
                const promoted: TypeRef = this.calls.promote_to_expected_instantiation(struct_ref);
                if (!promoted.equals(struct_ref) && !this.types.contains_generic_param(promoted)) {
                    lit_type = promoted;
                    field_owner = promoted;
                } else {
                    infer_from = lt;
                }
            }
        }
        mut infer_fields: [TypeRef] = [];
        mut infer_values: [TypeRef] = [];

        const saved_expected: TypeRef = this.state.expected_type;
        for (mut i: i64 = 0; i < lit.field_inits.length; i++) {
            const field_init: FieldInit = lit.field_inits[i];
            const value_expr: ExpressionNode* = field_init.value;
            mut field_type: TypeRef = TypeRef::invalid();
            // The field this initializer names, found by the member door as a
            // `.field` access finds it - and recorded on the initializer by its
            // coordinates so codegen stores there.  A struct literal names a
            // field directly, so it obeys the same module-scoped visibility
            // as a `.field` access (E0353), asked of the entry the door found.
            // Asked of a struct, of an instantiation not minted yet
            // (`RefIter::<T> { index: 0, .. }`, `Pair::<u32, u64> { .. }`), whose
            // fields are the template's read through its arguments, and of the
            // generic OWNER inside its own body (`String { buffer:
            // RawBuffer::new(), .. }` in `String<A>::new`).  The field types give
            // the values an expected type: a literal takes the field's width,
            // and a generic-owner static call in the field position binds the
            // owner's arguments from it.
            if (struct_t != null
                && (struct_t.kind == TypeKind::Struct
                    || struct_t.kind == TypeKind::InstantiatedType
                    || this.symbolic.symbolic_is_generic_owner_receiver(struct_ref))) {
                const fa: FieldAnswer = this.member.field_of(field_owner, field_init.field_name);
                field_type = fa.ty;
                if (fa.index >= 0) {
                    lit.field_inits[i].pin = MemberPin::Field(fa.index);
                    lit.field_inits[i].pin_carried = false;
                }
                if (fa.entry != null) {
                    this.member.enforce_field_visibility(fa.entry, fa.owner, field_init.field_name, field_init.span);
                }
            }
            if (value_expr == null) { field_type = TypeRef::invalid(); }
            if (field_type.is_valid()) { this.state.expected_type = field_type; }
            else { this.state.expected_type = TypeRef::invalid(); }
            const value_type: TypeRef = this.resolve_expr(value_expr);
            if (infer_from != null && field_type.is_valid() && value_type.is_valid()) {
                infer_fields.push(field_type);
                infer_values.push(value_type);
            }
            if (field_type.is_valid() && value_type.is_valid() && value_expr != null) {
                const skip: boolean = this.types.contains_generic_param(value_type) || this.types.contains_generic_param(field_type);
                this.lambda.refuse_stored_closure(value_type, field_type, value_expr.span, "a field");
                if (!skip && !this.checker.can_assign(value_type, field_type)) {
                    match (this.convert_to_object(value_expr, value_type, field_type)) {
                        ObjectConversionOutcome::Converted(c) => { lit.field_inits[i].value = c; }
                        ObjectConversionOutcome::Refused => { }
                        ObjectConversionOutcome::Mismatch => {
                            const field_name_str: string = this.intern.resolve(field_init.field_name);
                            this.diag.emit_type_mismatch_with_value(
                                ErrorCode::E0200_TYPE_MISMATCH, value_expr.span, field_type, value_type,
                                fmt::format("field `%s` expects this type", field_name_str), SourceSpan::none(), value_expr);
                        }
                    }
                }
            }
        }
        this.state.expected_type = saved_expected;
        if (infer_from != null) {
            const bound: TypeRef = this.calls.instance_from_fields(infer_from, &infer_fields, &infer_values);
            if (bound.is_valid()) { lit_type = bound; }
        }

        // Union literal: exactly one field may be initialized (an untagged
        // union overlaps all fields, so a literal names the single active
        // member).  The per-field type check above already validated that
        // member's value; skip the struct "all fields required" (E0355) check.
        mut is_union_lit: boolean = false;
        if (struct_t != null && struct_t.kind == TypeKind::Struct) {
            is_union_lit = struct_t.as_struct().is_union;
        }
        if (is_union_lit) {
            if (lit.field_inits.length != 1) {
                const un_name: string = this.arena.format_display(struct_t);
                mut udiag: Diagnostic = Diagnostic::error(ErrorCode::E0363_UNION_LITERAL_ARITY,
                    fmt::format("union literal of `%s` must initialize exactly one field, found %lld",
                        un_name, lit.field_inits.length));
                udiag = udiag.at_with_label(e.span,
                    if (lit.field_inits.length == 0) { "no field initialized" } else { "more than one field initialized" });
                this.ctx.emit_diagnostic(udiag);
            }
            return lit_type;
        }

        if (struct_t != null && struct_t.kind == TypeKind::Struct) {
            const st: StructType* = struct_t.as_struct();
            const fields_ptr: &[FieldInfo] = &st.fields;
            const is_complete: boolean = st.is_complete;
            if (is_complete && fields_ptr.length > 0) {
                mut missing_names: [SymbolStr] = [];
                for (mut k: i64 = 0; k < fields_ptr.length; k++) {
                    const decl_name: SymbolStr = fields_ptr[k].decl_name().spelling();
                    mut covered: boolean = false;
                    for (mut fi: i64 = 0; fi < lit.field_inits.length; fi++) {
                        // Pinned above to the type's own field `k`.
                        const own_k: boolean = match (lit.field_inits[fi].pin) {
                            MemberPin::Field(ix) => { ix == k }
                            _                       => { false }
                        };
                        if (own_k) { covered = true; break; }
                    }
                    if (covered) { continue; }
                    // A literal sets every field, the ones it leaves to their
                    // defaults included, so one the writer may not reach
                    // refuses the literal whether it is named or not.
                    this.member.enforce_field_visibility(&fields_ptr[k], struct_t, decl_name, e.span);
                    // An omitted field carrying a `= default` is filled in: clone the
                    // default, resolve + type-check it, and append it as a synthetic
                    // field-init so codegen materializes it.  Only an omitted field
                    // WITHOUT a default is a missing-field error (E0355).
                    if (fields_ptr[k].has_default()) {
                        this.fill_field_default(e, lit, &fields_ptr[k], k, decl_name);
                    } else {
                        missing_names.push(decl_name);
                    }
                }
                if (missing_names.length > 0) {
                    mut names_str: string = "";
                    const cap: i64 = if (missing_names.length < 4) { missing_names.length } else { 4 };
                    for (mut i: i64 = 0; i < cap; i++) {
                        const nm: string = this.intern.resolve(missing_names[i]);
                        if (i == 0) { names_str = fmt::format("`%s`", nm); } else { names_str = fmt::format("%s, `%s`", names_str, nm); }
                    }
                    if (missing_names.length > cap) { names_str = fmt::format("%s, and %lld more", names_str, missing_names.length - cap); }
                    const ty_name: string = this.arena.format_display(struct_t);
                    mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0355_MISSING_FIELD_INIT,
                        fmt::format("missing field%s %s in initializer of `%s`",
                            if (missing_names.length == 1) { "" } else { "s" }, names_str, ty_name));
                    diag = diag.at_with_label(e.span,
                        if (missing_names.length == 1) { fmt::format("missing field %s", names_str) } else { fmt::format("missing fields %s", names_str) });
                    this.ctx.emit_diagnostic(diag);
                }
            }
        }
        return lit_type;
    }

    /// Materialize a struct field's `= default` at a construction site that omits
    /// it: clone the default (each construction evaluates its own copy), resolve
    /// and type-check it against the field type (E0200 on mismatch), then append
    /// it to the literal as a synthetic field-init so codegen fills the field.
    /// The default is a standalone expression - it never sees the other fields.
    fill_field_default(mut &this, e: ExpressionNode*, lit: StructExpr*, field: FieldInfo*,
                       index: i64, name: SymbolStr) -> void {
        if (field.default_value == null) { return; }
        mut cloner: ASTCloner = ASTCloner::new();
        const cloned: ExpressionNode* = cloner.clone_expr(field.default_value);
        if (cloned == null) { return; }
        const field_type: TypeRef = field.field_type;
        const saved: TypeRef = this.state.expected_type;
        if (field_type.is_valid()) { this.state.expected_type = field_type; }
        else { this.state.expected_type = TypeRef::invalid(); }
        const value_type: TypeRef = this.resolve_expr(cloned);
        this.state.expected_type = saved;
        mut value: ExpressionNode* = cloned;
        if (field_type.is_valid() && value_type.is_valid()) {
            const skip: boolean = this.types.contains_generic_param(value_type)
                || this.types.contains_generic_param(field_type);
            this.lambda.refuse_stored_closure(value_type, field_type, cloned.span, "a field");
            if (!skip && !this.checker.can_assign(value_type, field_type)) {
                match (this.convert_to_object(cloned, value_type, field_type)) {
                    ObjectConversionOutcome::Converted(c) => { value = c; }
                    ObjectConversionOutcome::Refused => { }
                    ObjectConversionOutcome::Mismatch => {
                        const nm: string = this.intern.resolve(name);
                        this.diag.emit_type_mismatch_with_value(
                            ErrorCode::E0200_TYPE_MISMATCH, cloned.span, field_type, value_type,
                            fmt::format("field `%s` default expects this type", nm), SourceSpan::none(), cloned);
                    }
                }
            }
        }
        lit.add_field_init(FieldInit {
            field_name: name,
            value:      value,
            span:        e.span,
            pin:         MemberPin::Field(index),
            pin_carried: false,
        });
    }

    /// Whether `A::B` reaches B THROUGH the type `A`, as opposed to through a
    /// module that merely shares its name.
    ///
    /// One qualifier can name both: a module `Buffer` declaring a struct
    /// `Buffer` is the shape that exposed this.  Answering "it is the type"
    /// without asking whether `B` is a member of it types the whole path as the
    /// TYPE, so a module-level `const` reached this way arrives as a struct -
    /// and nothing complains until the value is USED, where it surfaces as
    /// `Buffer does not implement BitOr`, naming neither the constant nor the
    /// module nor anything the author can act on.
    ///
    /// A struct carries no associated constants, only `methods`, so a
    /// member that names no method of it cannot be reached through the type and
    /// the qualifier must be the module.
    ///
    /// An ENUM answers yes for any member: a variant's type IS the enum, and
    /// `validate_enum_scope_member` owns the "no such variant" diagnostic,
    /// which has to stay reachable.
    ///
    /// No other kind owns a value member.  A primitive declares none, so
    /// `i32::MAX` is no value of `i32`: answering yes would type it as one
    /// with nothing behind it, and code generation would store nothing into
    /// the variable it initializes.
    scope_member_binds_type(mut &this, ty: TypeRef, scope: ScopeResolutionExpr*) -> boolean {
        const t: Type* = this.arena.lookup(ty);
        if (t == null) { return true; }
        if (t.kind == TypeKind::Struct) {
            return this.calls.owner_declares_member(ty, scope.member_name);
        }
        return t.kind == TypeKind::Enum;
    }

    /// The method `ty::member` names when `ty` is a struct and the
    /// member one of its methods; null otherwise.
    scope_method(mut &this, ty: TypeRef, scope: ScopeResolutionExpr*) -> MethodInfo* {
        if (!ty.is_valid()) { return null; }
        const t: Type* = this.arena.lookup(ty);
        if (t == null) { return null; }
        if (t.kind != TypeKind::Struct) { return null; }
        return this.ctx.decl_index.type_method(ty, scope.member_name, this.arena);
    }

    /// Whether `ty::member` names a method of a struct whose signature the
    /// name layer refused.
    scope_method_refused(mut &this, ty: TypeRef, scope: ScopeResolutionExpr*) -> boolean {
        if (!ty.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(ty);
        if (t == null || t.kind != TypeKind::Struct) { return false; }
        return this.calls.scope_callee_signature_refused(scope, false);
    }

    /// The function type of a STATIC method named `ty::member`, or invalid when
    /// `ty` names no struct, the member is not one of its methods, or the
    /// method takes a receiver (`scope_receiver_method_type`).  The stored
    /// `function_type` already excludes the receiver and is interned through
    /// the same `get_function` an annotation goes through, so it is the SAME id
    /// a `(A) -> R` annotation resolves to.
    scope_static_method_type(mut &this, ty: TypeRef, scope: ScopeResolutionExpr*) -> TypeRef {
        const m: MethodInfo* = this.scope_method(ty, scope);
        if (m == null || !m.is_static) { return TypeRef::invalid(); }
        return m.function_type;
    }

    /// The function type of a method WITH a receiver named `ty::member` as a
    /// value: its signature with the receiver's type first - `IgTn::go` for
    /// `go(&this, u: i32) -> i64` is
    /// `(&IgTn, i32) -> i64`.  Invalid for a static method, a member that is
    /// no method, a declaration whose receiver is not typed, and a signature
    /// still naming a generic parameter - a generic method's, or a generic
    /// owner's, whose value is one instance's (`generic_owner_method_value`).
    scope_receiver_method_type(mut &this, m: MethodInfo*) -> TypeRef {
        if (m == null || m.is_static || m.ast_node == null) { return TypeRef::invalid(); }
        const node_decl: DeclarationNode* = m.ast_node;
        const node: MethodDecl* = DeclarationNode::method_of(node_decl);
        if (node.func == null || DeclarationNode::fn_of(node.func).parameters.length == 0) { return TypeRef::invalid(); }
        const recv_decl: DeclarationNode* = DeclarationNode::fn_of(node.func).parameters[0];
        const recv: VarDecl* = DeclarationNode::var_of(recv_decl);
        if (recv == null || !recv.is_receiver() || !recv.resolved_type.is_valid()) { return TypeRef::invalid(); }
        const sig: Type* = this.arena.lookup(m.function_type);
        if (sig == null || sig.kind != TypeKind::Function) { return TypeRef::invalid(); }
        const ft: FunctionType* = sig.as_function();
        if (DeclarationNode::fn_of(node.func).generic_params.length > 0) { return TypeRef::invalid(); }
        mut params: [TypeRef] = [recv.resolved_type];
        for (mut i: i64 = 0; i < ft.param_types.length; i++) { params.push(ft.param_types[i]); }
        const value_ft: TypeRef = this.arena.get_function(ft.return_type, &params, ft.is_variadic);
        if (this.types.contains_generic_param(value_ft)) { return TypeRef::invalid(); }
        return value_ft;
    }

    resolve_scope_resolution(mut &this, e: ExpressionNode*, scope: ScopeResolutionExpr*) -> TypeRef {
        // The qualifier's type is the resolver's own answer for this segment,
        // a primitive included.  A stamp that makes no type claim names a
        // module or a type parameter, and the index holds no type under
        // either spelling; the module lane below is a different question.
        const found: TypeRef = this.types.scope_qualifier_type(scope);
        // A constant the type declares (`Point::ORIGIN`, `i32::MAX`).  A
        // name that is both a constant and another member of one type is
        // refused at the constant's declaration, so nothing below can answer
        // this path too.
        const constant: TypeRef = this.scope_type_constant(e, scope, found);
        if (constant.is_valid()) { return constant; }
        // `Type::static_method` as a VALUE is the method, not the type.  The
        // type-binding branch below answers "does this path name something the
        // type owns" - what an enum variant needs - and a static method satisfies
        // it too, so the expression took its OWNER's type.  A callback handed out
        // that way arrived as a struct value with no signature to check against,
        // and the address codegen emitted for it was never the one sema had
        // described.
        // A method whose signature the name layer refused is no answer of
        // the member-function door; the index holds the refusal, and a value
        // taken from it reports nothing more.
        if (this.scope_method_refused(found, scope)) { return TypeRef::invalid(); }
        // A method with type parameters of its own is one instance of it.
        mut generic_method: boolean = false;
        const method_value: TypeRef = this.calls.generic_method_value(e, scope, found, &generic_method);
        if (generic_method) { return method_value; }
        const static_ft: TypeRef = this.scope_static_method_type(found, scope);
        if (static_ft.is_valid()) {
            return this.calls.pin_scope_value_static_method(e, scope, found, static_ft);
        }
        // A method WITH a receiver, named by path, is a function value taking
        // the receiver first.  It names its method's entry exactly as a
        // static method's value does - a method's entry is registered under
        // that receiver-first signature - so an inherent method beside a
        // trait's of the same name is the same tie (E0156), and an
        // impl-qualified path answers the type of the entry it delivers.
        const recv_m: MethodInfo* = this.scope_method(found, scope);
        const recv_ft: TypeRef = this.scope_receiver_method_type(recv_m);
        if (recv_ft.is_valid()) {
            return this.calls.pin_scope_value_static_method(e, scope, found, recv_ft);
        }
        // A generic owner's method is one instance's method.
        mut owner_method: boolean = false;
        const owner_value: TypeRef = this.calls.generic_owner_method_value(e, scope, found, &owner_method);
        if (owner_method) { return owner_value; }
        if (found.is_valid() && this.scope_member_binds_type(found, scope)) {
            this.validate_enum_scope_member(e, found, scope);
            // Type arguments written on the path (`Option::<i32>::None`,
            // `Option::None::<i32>`) name the instantiation; only a path
            // with none takes it from the expected type.
            if (scope.scope_generic_args.length > 0) {
                return this.calls.demanded_scope_type(found, &scope.scope_generic_args, e.span);
            }
            if (scope.generic_args.length > 0) {
                return this.calls.demanded_scope_type(found, &scope.generic_args, e.span);
            }
            const promoted: TypeRef = this.calls.promote_to_expected_instantiation(found);
            // A payload-free variant of a generic enum that neither its path
            // nor the expected type instantiates is recorded, as a payload
            // variant is: an enclosing generic call may still bind it, and
            // what none binds is refused when the module's walk ends.
            if (promoted.equals(found) && !this.state.in_symbolic_check
                    && this.ctx.generic_registry.is_template(found)) {
                this.state.unbound_variants.push(e);
            }
            return promoted;
        }
        const scope_str: string = this.intern.resolve(scope.scope_name);
        const member_str: string = this.intern.resolve(scope.member_name);
        // The qualifier's stamp names the module, so the global's canonical
        // name is that module's name and the written member leaf.  That is the
        // answer: a leaf-keyed or namespace-suffix-matched retry answers from
        // whichever module registered last, so `syscall::FIONBIO` would take
        // `libc::FIONBIO`'s value and its type.
        const st_global: TypeRef = this.types.scope_global_type(scope);
        if (st_global.is_valid()) { return st_global; }
        // A qualified path in value position may name a FUNCTION.  Sema owned no
        // lookup for this shape, so codegen resolved it alone and unobserved:
        // a path naming a function that does not exist compiled, linked, and
        // called a null pointer at run time, and a `private` one was offered to
        // no gate.  Asking here is what gives both an owner.
        const fn_val: TypeRef = this.calls.lookup_scope_value_function(e, scope);
        if (fn_val.is_valid()) { return fn_val; }
        // Nothing declares this path.  `found` is invalid here by construction:
        // the only way past the type lookup at the top is for it to have missed.  Everything codegen can emit for a
        // ScopeResolution - type, global, enum variant, function - has now been
        // asked, so the miss is real rather than a lane sema does not model.
        if (this.state.in_symbolic_check) {
            // `T::make` taken as a value names the bound's member as the
            // call `T::make()` does, and records the trait's method for each
            // copy to bind on the type the parameter becomes.
            this.calls.direct_param_path(scope);
            if (scope.resolved_trait.is_valid() && !scope.template_method.is_valid()) {
                scope.template_method = this.calls.trait_item_def(scope.resolved_trait, scope);
            }
            return found;
        }
        // A module's function whose signature was refused where it was
        // written registered none, and the value reports nothing more.
        mut names_module: boolean = false;
        match (scope.require_scope_res("scope-value owner kind")) {
            Res::Def(_) => { names_module = true; }
            _           => { }
        }
        if (this.calls.scope_callee_signature_refused(scope, names_module)) { return found; }
        const path_str: string = fmt::format("%s::%s", scope_str, member_str);
        mut miss: Diagnostic = Diagnostic::error(ErrorCode::E0201_UNDEFINED_VARIABLE,
            fmt::format("cannot find value `%s` in this scope", path_str));
        miss = miss.at_with_label(e.span, "not found in this scope");
        this.ctx.emit_diagnostic(miss);
        return found;
    }

    /// The type of the constant the path `T::NAME` names, when `T` is a type
    /// (`found`) that declares one, pinning the constant's definition and
    /// registration on the path; invalid otherwise.  The owner is the type
    /// `found` is, so an alias reaches its target's constants.  A `private`
    /// constant is reached only from its own module (E0353).
    scope_type_constant(mut &this, e: ExpressionNode*, scope: ScopeResolutionExpr*,
                        found: TypeRef) -> TypeRef {
        if (!found.is_valid()) { return TypeRef::invalid(); }
        const owner: DefId = this.ctx.decl_index.def_of(found, this.arena);
        const def: DefId = this.ctx.const_table.type_constant(owner, scope.member_name);
        if (!def.is_valid()) { return TypeRef::invalid(); }
        const entry: GlobalEntry = this.ctx.decl_index.global_entry_of_def(def);
        // A constant whose type never resolved was refused where it is
        // declared, and a use of it reports nothing more.
        if (!entry.valid) { return TypeRef::invalid(); }
        scope.member_def = def;
        scope.resolved_member = MemberPin::Global(entry.slot);
        const constant: VarDecl* = DeclarationNode::var_of(this.ctx.decl_index.declaration_of(def));
        if (constant != null && constant.member_visibility == Visibility::Private
                && !this.member.member_reachable(entry.declared_in, e.span)) {
            mut d: Diagnostic = Diagnostic::error(ErrorCode::E0353_PRIVATE_ACCESS,
                fmt::format("constant `%s` of `%s` is private",
                    this.intern.resolve(scope.member_name), this.arena.format_display(this.arena.lookup(found))));
            d = d.at_with_label(e.span, fmt::format("private constant reached outside module `%s`",
                this.intern.shown(entry.declared_in.decl_name())));
            this.ctx.emit_diagnostic(d);
        }
        return entry.type_ref;
    }

    validate_enum_scope_member(mut &this, e: ExpressionNode*, scope_ty: TypeRef, scope: ScopeResolutionExpr*) -> void {
        const t: Type* = this.arena.lookup(scope_ty);
        if (t == null || t.kind != TypeKind::Enum) { return; }
        const et: EnumType* = t.as_enum();
        const vi: i64 = et.variant_index(scope.member_name);
        if (vi >= 0) {
            // The ordinal is the same in the template and in every
            // instantiation, so a value's node carries it whichever the
            // qualifier resolved to here.
            scope.set_resolved_member(MemberPin::Variant(vi));
            return;
        }
        if (this.calls.owner_declares_member(scope_ty, scope.member_name)) { return; }
        const enum_name: string = this.intern.resolve(scope.scope_name);
        const member:    string = this.intern.resolve(scope.member_name);
        mut cands: [string] = [];
        for (mut i: i64 = 0; i < et.variants.length; i++) { cands.push(et.variants[i].display_name(this.intern)); }
        const best: string = find_best_candidate(member, cands);
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0640_INVALID_ENUM_VARIANT_ACCESS,
            fmt::format("enum `%s` has no variant `%s`", enum_name, member));
        d = d.at_with_label(e.span, "unknown variant");
        if (best.length() > 0) { d = d.help(fmt::format("did you mean `%s::%s`?", enum_name, best)); }
        this.ctx.diagnostics.emit(d);
    }

    resolve_new_expr(mut &this, expr: ExpressionNode*, new_expr: NewExpr*) -> TypeRef {
        for (mut i: i64 = 0; i < new_expr.arguments.length; i++) { this.resolve_expr(new_expr.arguments[i]); }
        if (new_expr.has_array_size()) { this.resolve_expr(new_expr.array_size); }
        // `new T { .. }` places the literal it holds, so the literal's type is
        // the type allocated: the instance its written arguments name, or the
        // one its expected type or field values bind (`new Cell { v: 1 }`).
        if (new_expr.has_struct_init()) {
            const saved_expected: TypeRef = this.state.expected_type;
            this.state.expected_type = this.arena.pointer_pointee_of(saved_expected);
            const lit_type: TypeRef = this.resolve_struct_literal(new_expr.struct_init, ExpressionNode::struct_of(new_expr.struct_init));
            this.state.expected_type = saved_expected;
            if (!lit_type.is_valid()) { return TypeRef::invalid(); }
            return this.arena.get_pointer_to(lit_type);
        }
        // The name layer's own answer for the written type name, and the only
        // one: a primitive (`new u8[n]`, and `new int[100]` folded to `i32`)
        // is `PrimTy`, a declared type its definition.  A self-reference
        // inside the specialized body never reaches here: the substituter
        // records the instantiation's arena id on the node, and
        // `resolve_expr` returns that before this runs.
        //
        // The type allocated is that name with the arguments written on it
        // (`new Cell<i32> { .. }` is a `Cell<i32>`), as a type annotation's
        // is: the template itself has no layout, and an allocation sized
        // and initialized by it, or served by its `Allocate`, is wrong.
        const named: TypeRef = this.types.spelling_type(new_expr.res);
        const base: TypeRef = this.calls.resolve_generic_scope_type(named, &new_expr.generic_args, expr.span);
        if (!base.is_valid()) { return TypeRef::invalid(); }
        // `new E::V(..)`: the variant is found here, once, inside the enum the
        // stamp names, and its ordinal recorded for codegen to build from.  A
        // leaf the enum does not declare is refused as `E::V` in value
        // position is (`validate_enum_scope_member`).
        if (new_expr.has_variant()) {
            // An instantiation's variants are its declaration's, at the same
            // ordinals.
            const e: Type* = this.types.unwrap_to_enum(named);
            if (e != null && e.kind == TypeKind::Enum) {
                const et: EnumType* = e.as_enum();
                const vi: i64 = et.variant_index(new_expr.variant_name);
                if (vi >= 0) {
                    new_expr.set_resolved_member(MemberPin::Variant(vi));
                } else {
                    const enum_name: string = this.intern.resolve(new_expr.type_name);
                    const member: string = this.intern.resolve(new_expr.variant_name);
                    mut cands: [string] = [];
                    for (mut i: i64 = 0; i < et.variants.length; i++) { cands.push(et.variants[i].display_name(this.intern)); }
                    const best: string = find_best_candidate(member, cands);
                    mut d: Diagnostic = Diagnostic::error(ErrorCode::E0640_INVALID_ENUM_VARIANT_ACCESS,
                        fmt::format("enum `%s` has no variant `%s`", enum_name, member));
                    d = d.at_with_label(expr.span, "unknown variant");
                    if (best.length() > 0) { d = d.help(fmt::format("did you mean `%s::%s`?", enum_name, best)); }
                    this.ctx.diagnostics.emit(d);
                    return TypeRef::invalid();
                }
            }
        }
        // Arguments in parentheses build only an enum variant: a type is
        // built by its literal or by a function, never by a constructor.
        if (!new_expr.has_variant() && new_expr.arguments.length > 0) {
            const shown: string = this.intern.resolve(new_expr.type_name);
            mut d: Diagnostic = Diagnostic::error(ErrorCode::E0117_REMOVED_FORM,
                fmt::format("`new %s(..)` is not part of Cryo", shown));
            d = d.at_with_label(expr.span, "a constructor call");
            d = d.help(fmt::format("build it with `new %s { .. }`, or write a `static new` factory", shown));
            this.ctx.emit_diagnostic(d);
            return TypeRef::invalid();
        }
        return this.arena.get_pointer_to(base);
    }

    /// The element of the owning dynamic array an array literal written
    /// here builds: the expected type's, when it is `[T]` (`Array<T>` with
    /// the default allocator), whose storage the literal allocates; invalid
    /// for any other expected type.
    expected_dynamic_element(&this) -> TypeRef {
        return this.arena.default_array_element(this.state.expected_type);
    }

    /// The element count of a `[value; N]` repeat expression, or -1 when `N`
    /// is not a compile-time integer and the literal is therefore a dynamic
    /// array sized at run time.
    ///
    /// Folded through the same environment an array size in a type is folded
    /// through, so `[T; N]` and `[v; N]` cannot disagree about `N` - a field and
    /// its initializer sharing one name for their length is the whole point of
    /// naming it.  No arena: a repeat count is fixed before TypeLowering, the
    /// same position an array annotation's size is fixed at.
    const_repeat_count(&this, arr: ArrayExpr*) -> i64 {
        if (this.ctx == null) { return -1; }
        const ev: ConstEval = ConstEval::new(this.ctx.const_table, this.ctx.intern_table, null);
        const folded: Option<FoldedInteger> = ev.fold(arr.repeat_count_expr);
        if (folded.is_none()) { return -1; }
        const n: FoldedInteger = folded.unwrap();
        if (n.negative || n.bits > i64::MAX as u128) { return -1; }
        return n.bits as i64;
    }

    resolve_array_literal(mut &this, e: ExpressionNode*, arr: ArrayExpr*) -> TypeRef {
        const dynamic_elem: TypeRef = this.expected_dynamic_element();
        mut elem_expected: TypeRef = dynamic_elem;
        if (!elem_expected.is_valid() && this.state.expected_type.is_valid()) {
            mut exp_t: Type* = this.arena.lookup(this.state.expected_type);
            if (exp_t != null && exp_t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = exp_t.as_instantiated();
                if (inst.has_resolved_type()) { exp_t = this.arena.lookup(inst.resolved_type); }
            }
            if (exp_t != null && exp_t.kind == TypeKind::Array) { elem_expected = exp_t.as_array().element; }
        }
        const saved_expected: TypeRef = this.state.expected_type;
        mut elem_type: TypeRef = TypeRef::invalid();
        for (mut i: i64 = 0; i < arr.elements.length; i++) {
            if (elem_expected.is_valid()) { this.state.expected_type = elem_expected; }
            mut t: TypeRef = this.resolve_expr(arr.elements[i]);
            this.state.expected_type = saved_expected;
            mut target: TypeRef = elem_expected;
            if (!target.is_valid()) { target = elem_type; }
            this.lambda.refuse_stored_closure(t, target, arr.elements[i].span, "an array element");
            if (target.is_valid() && t.is_valid() && !this.checker.can_assign(t, target)) {
                match (this.convert_to_object(arr.elements[i], t, target)) {
                    ObjectConversionOutcome::Converted(c) => {
                        arr.elements[i] = c;
                        t = target;
                    }
                    ObjectConversionOutcome::Refused => { }
                    ObjectConversionOutcome::Mismatch => {
                        this.diag.emit_type_mismatch_with_value(
                            ErrorCode::E0200_TYPE_MISMATCH, arr.elements[i].span, target, t,
                            "array elements must all have the same type", SourceSpan::none(), arr.elements[i]);
                    }
                }
            }
            if (!elem_type.is_valid() && t.is_valid()) {
                elem_type = t;
                // The element was resolved UNDER `elem_expected` and checked
                // against it just above.  When the two differ only in which
                // pointee the compiler believes in - both one machine word,
                // no instruction between them - the literal IS an array of
                // the expected element type.  `null` is typed `void*` and is
                // valid in any pointer context, so `[null; 8]` written into a
                // `[T*; 8]` must be a `[T*; 8]`; typing it `[void*; 8]` makes the
                // enclosing assignment fail on a difference that does not
                // exist at runtime.
                //
                // Restricted to pointer-shaped on purpose: an element that
                // needs a VALUE change to reach the expected type (an integer
                // widening) must not adopt it, because the element emitter
                // stores what the element evaluated to - adopting there would
                // store a narrow value into a wide slot.
                if (elem_expected.is_valid() && !t.equals(elem_expected)
                        && this.checker.can_assign(t, elem_expected)
                        && this.checker.is_pointer_shaped(t)
                        && this.checker.is_pointer_shaped(elem_expected)) {
                    elem_type = elem_expected;
                }
            }
        }
        if (arr.repeat_count_expr != null) { this.resolve_expr(arr.repeat_count_expr); }
        // `[value; n]` evaluates `value` once and stores it in every slot,
        // so every slot would release the one value: the element must be a
        // plain-copy type.  An element still written in a generic body's
        // parameters is checked in each copy of the body.
        if ((arr.repeat_count > 0 || arr.repeat_count_expr != null) && elem_type.is_valid()
                && !this.symbolic.symbolic_type_unresolved(elem_type)
                && !OwnershipQuery::is_copy(this.arena, this.ctx.generic_registry, this.intern, elem_type)) {
            this.ctx.emit_error_at(ErrorCode::E0453_DOUBLE_FREE,
                fmt::format("`[value; n]` stores one value in every slot, so its element must be a plain-copy type; `%s` is not, and the one value would be released once per slot",
                    this.arena.resolve_display_name_short(elem_type)),
                e.span);
        }
        if (!elem_type.is_valid() && this.state.expected_type.is_valid()
            && arr.elements.length == 0 && arr.repeat_count == 0 && arr.repeat_count_expr == null) {
            mut exp_t: Type* = this.arena.lookup(this.state.expected_type);
            if (exp_t != null && exp_t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = exp_t.as_instantiated();
                if (inst.has_resolved_type()) { exp_t = this.arena.lookup(inst.resolved_type); }
            }
            if (exp_t != null && exp_t.kind == TypeKind::Array) { return this.state.expected_type; }
            if (dynamic_elem.is_valid()) { return this.state.expected_type; }
        }
        if (elem_type.is_valid()) {
            mut size: i64 = arr.elements.length;
            if (arr.repeat_count > 0) {
                size = arr.repeat_count;
            } else if (arr.repeat_count_expr != null) {
                size = -1;
                if (!dynamic_elem.is_valid()) {
                    const fill_count: i64 = this.const_repeat_count(arr);
                    if (fill_count >= 0) { size = fill_count; }
                }
            }
            // A literal written where an `Array<T>` is expected is that
            // array, its elements in storage the literal allocates, in
            // every form: listed, or filled to a count fixed or run-time.
            if (dynamic_elem.is_valid() && this.checker.can_assign(elem_type, dynamic_elem)) {
                return this.state.expected_type;
            }
            // A fill to a run-time count is an `Array<T>`.
            if (size < 0) { return this.ctx.type_resolver.dynamic_array_type(elem_type); }
            return this.arena.get_array_of(elem_type, size);
        }
        return TypeRef::invalid();
    }

    /// Resolve a tuple literal, propagating the expected type per POSITION.
    ///
    /// Each element is resolved under ITS OWN expected type, mirroring what
    /// `resolve_array_literal` does per element and struct literals do per field.
    /// The per-position hint is what makes `return (1, 2)` from a `-> (i64, i64)`
    /// function type both elements as i64 rather than letting the second take the
    /// i32 default.
    ///
    /// Setting the hint per position also matters for what it PREVENTS: the
    /// enclosing hint must not survive into the elements.  `resolve_integer_literal`
    /// only adopts a hint whose kind is `Int`, so a leaked `(i64, i64)` tuple hint
    /// is ignored silently rather than diagnosed, and the element quietly falls
    /// back to i32.
    ///
    /// Because elements adopt their expected type directly, a correctly typed
    /// tuple needs no coercion downstream at all - which is what lets
    /// `check_compatibility` refuse to coerce tuples element-wise (see the note
    /// there; doing so miscompiles).  A genuinely mixed-width tuple - a
    /// non-literal `i32` element in an `i64` slot - is a hard E0200 here; the
    /// cast has to be written explicitly.
    resolve_tuple_literal(mut &this, tup: TupleExpr*) -> TypeRef {
        mut exp_tup: TupleType* = null;
        if (this.state.expected_type.is_valid()) {
            mut exp_t: Type* = this.arena.lookup(this.state.expected_type);
            if (exp_t != null && exp_t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = exp_t.as_instantiated();
                if (inst.has_resolved_type()) { exp_t = this.arena.lookup(inst.resolved_type); }
            }
            if (exp_t != null && exp_t.kind == TypeKind::Tuple) {
                const cand: TupleType* = exp_t.as_tuple();
                // Arity must match, or the positions do not correspond and the
                // per-element hints would be nonsense; fall through untyped and
                // let the arity mismatch be diagnosed by the caller.
                if (cand.elements.length == tup.elements.length) { exp_tup = cand; }
            }
        }
        const saved_expected: TypeRef = this.state.expected_type;
        mut elem_types: [TypeRef] = [];
        for (mut i: i64 = 0; i < tup.elements.length; i++) {
            if (exp_tup != null) {
                this.state.expected_type = exp_tup.elements[i];
            } else {
                // No usable tuple hint: clear rather than leak the enclosing one.
                this.state.expected_type = TypeRef::invalid();
            }
            elem_types.push(this.resolve_expr(tup.elements[i]));
            this.state.expected_type = saved_expected;
        }
        // `()` is the unit value, of the unit type, as the annotation `()` is.
        if (elem_types.length == 0) { return this.arena.get_unit(); }
        return this.arena.get_tuple(elem_types);
    }


    // -- typeof priming --

    /// Resolve any `typeof(expr)` inside a type annotation and cache the operand's
    /// static type on the annotation (the TypeResolver hands it back later).
    prime_typeof_annotation(mut &this, ann: TypeAnnotation*) -> void {
        if (ann == null) { return; }
        match (ann) {
            TypeAnnotation::Typeof(to) => {
                if (!to.resolved.is_valid() && to.operand != null) {
                    const ty: TypeRef = this.resolve_expr(to.operand);
                    if (ty.is_valid()) { to.resolved = ty; }
                }
            }
            TypeAnnotation::Pointer(p)   => { this.prime_typeof_annotation(p.inner); }
            TypeAnnotation::Reference(r) => { this.prime_typeof_annotation(r.inner); }
            TypeAnnotation::Object(o)    => { this.prime_typeof_annotation(o.trait_annotation); }
            TypeAnnotation::Array(a)     => { this.prime_typeof_annotation(a.element); }
            TypeAnnotation::Generic(g)   => {
                for (mut i: i64 = 0; i < g.args.length; i++) { this.prime_typeof_annotation(g.args[i]); }
            }
            TypeAnnotation::Tuple(t)     => {
                for (mut i: i64 = 0; i < t.elements.length; i++) { this.prime_typeof_annotation(t.elements[i]); }
            }
            _ => {}
        }
    }


    // -- Control-flow / all-paths-return analysis --

    check_function_returns(mut &this, func_decl: DeclarationNode*) -> void {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null || func.body == null) { return; }
        if (!this.return_type_requires_return(func.resolved_return_type)) { return; }
        if (this.stmt_always_returns(func.body)) { return; }
        const fn_name: string = this.intern.resolve(func.name);
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0403_MISSING_RETURN,
            fmt::format("function `%s` is declared to return a value but reaches the end of its body without returning", fn_name));
        diag = diag.at(func_decl.span);
        diag = diag.with_note("every control-flow path through the body must end in `return <expr>`, a divergent call (e.g. `panic(...)`), or an infinite `loop { ... }` with no `break`");
        diag = diag.with_note("if a missing path is unreachable, end it with `return <default>` or `panic(\"unreachable\")`");
        const body: BlockStmt* = func.body.as_block();
        if (body.statements.length > 0) {
            const last: Stmt* = body.statements[body.statements.length - 1];
            if (last != null && last.span.has_location()) {
                const anchor: SourceSpan = SourceSpan::new(last.span.file, last.span.end_line, last.span.end_col, last.span.end_line, last.span.end_col);
                const placeholder: string = this.default_return_expr_for(func.resolved_return_type);
                diag = diag.suggest(Suggestion::single(anchor, fmt::format("\nreturn %s;", placeholder),
                    "add a `return` at the end of the body", Applicability::HasPlaceholders));
            }
        }
        this.ctx.diagnostics.emit(diag);
    }

    default_return_expr_for(&this, ret_ty: TypeRef) -> string {
        if (!ret_ty.is_valid()) { return "<value>"; }
        const t: Type* = this.arena.lookup(ret_ty);
        if (t == null) { return "<value>"; }
        match (t.kind) {
            TypeKind::Pointer  => { return "null"; }
            TypeKind::Optional => { return "Option::None"; }
            TypeKind::Bool     => { return "false"; }
            TypeKind::String   => { return "\"\""; }
            TypeKind::Float    => { return "0.0"; }
            TypeKind::Int      => { return "0"; }
            _ => {}
        }
        return fmt::format("<%s>", this.types.type_display_name(ret_ty));
    }

    return_type_requires_return(&this, ret: TypeRef) -> boolean {
        if (!ret.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(ret);
        if (t == null) { return false; }
        if (t.kind == TypeKind::Void) { return false; }
        if (t.kind == TypeKind::Unit) { return false; }
        if (t.kind == TypeKind::Never) { return false; }
        return true;
    }

    stmt_always_returns(&this, stmt: Stmt*) -> boolean {
        if (stmt == null) { return false; }
        match (stmt.kind) {
            StmtKind::Return(_) => { return true; }
            StmtKind::Block(b) => {
                for (mut i: i64 = 0; i < b.statements.length; i++) {
                    if (this.stmt_always_returns(b.statements[i])) { return true; }
                }
                return false;
            }
            StmtKind::UnsafeBlock(u) => { return this.stmt_always_returns(u.block); }
            StmtKind::If(ifs) => {
                if (ifs.else_stmt == null) { return false; }
                return this.stmt_always_returns(ifs.then_stmt) && this.stmt_always_returns(ifs.else_stmt);
            }
            StmtKind::Match(ms) => {
                if (!this.patterns.match_is_exhaustive(ms.subject, ms.arms)) { return false; }
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm == null || arm.body == null) { return false; }
                    if (!this.stmt_always_returns(arm.body)) { return false; }
                }
                return true;
            }
            StmtKind::StaticMatch(sms) => {
                if (sms.arms.length == 0 || sms.arms[0] == null || sms.arms[0].body == null) { return false; }
                return this.stmt_always_returns(sms.arms[0].body);
            }
            StmtKind::Loop(ls) => {
                if (!this.stmt_contains_break(ls.body)) { return true; }
                return this.stmt_always_returns(ls.body);
            }
            StmtKind::DoWhile(d) => { return this.stmt_always_returns(d.body); }
            StmtKind::Expr(e) => { return this.expr_is_divergent(e.expression); }
            // A `while` or `for` may run its body zero times.
            StmtKind::While(_) | StmtKind::For(_) => { return false; }
            StmtKind::Asm(_) | StmtKind::Break | StmtKind::Continue | StmtKind::Decl(_) => { return false; }
        }
    }

    /// Whether a `break` in `stmt` leaves the loop enclosing it: one inside a
    /// nested loop leaves that loop instead, so a loop is not searched.
    stmt_contains_break(&this, stmt: Stmt*) -> boolean {
        if (stmt == null) { return false; }
        match (stmt.kind) {
            StmtKind::Break => { return true; }
            StmtKind::Block(b) => {
                for (mut i: i64 = 0; i < b.statements.length; i++) {
                    if (this.stmt_contains_break(b.statements[i])) { return true; }
                }
                return false;
            }
            StmtKind::UnsafeBlock(u) => { return this.stmt_contains_break(u.block); }
            StmtKind::If(ifs) => {
                if (this.stmt_contains_break(ifs.then_stmt)) { return true; }
                return this.stmt_contains_break(ifs.else_stmt);
            }
            StmtKind::Match(ms) => {
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm != null && this.stmt_contains_break(arm.body)) { return true; }
                }
                return false;
            }
            StmtKind::StaticMatch(sms) => {
                if (sms.arms.length == 0 || sms.arms[0] == null) { return false; }
                return this.stmt_contains_break(sms.arms[0].body);
            }
            StmtKind::While(_) | StmtKind::DoWhile(_) | StmtKind::For(_) | StmtKind::Loop(_) => { return false; }
            StmtKind::Asm(_) | StmtKind::Continue | StmtKind::Return(_) | StmtKind::Expr(_)
            | StmtKind::Decl(_) => { return false; }
        }
    }

    // A call diverges (does not return to the caller) if its resolved
    // return type is `never` - e.g. `core::panic` / `intrinsics::panic`,
    // both declared `-> never`. Divergence is carried structurally by the
    // type, so no special-casing on the callee's symbol name is needed.
    expr_is_divergent(&this, expr: ExpressionNode*) -> boolean {
        if (expr == null) { return false; }
        if (ExpressionNode::call_of(expr) == null) { return false; }
        const call: CallExpr* = ExpressionNode::call_of(expr);
        if (call.callee == null) { return false; }
        if (expr.resolved_type.is_valid()) {
            const rt: Type* = this.arena.lookup(expr.resolved_type);
            if (rt != null && rt.kind == TypeKind::Never) { return true; }
        }
        return false;
    }


    // -- Return-escape analysis (E0455) --

    check_return_payload_escape(mut &this, e: ExpressionNode*, ret_ty: TypeRef) -> void {
        if (e == null) { return; }
        const id: IdentifierExpr* = ExpressionNode::identifier_of(e);
        if (id != null) {
            if (this.scopes.names_payload(id.res.local_sym()) && this.ret_carries_pointer_to(ret_ty, e.resolved_type)) {
                this.diag.emit_payload_escape(e.span);
            }
            return;
        }
        if (ExpressionNode::call_of(e) != null) {
            const c: CallExpr* = ExpressionNode::call_of(e);
            const arg_id: IdentifierExpr* = if (c.arguments.length == 1) { ExpressionNode::identifier_of(c.arguments[0]) } else { null };
            if (arg_id != null && this.callee_names_ret_variant(c.callee, ret_ty)) {
                if (this.scopes.names_payload(arg_id.res.local_sym()) && this.ret_carries_pointer_to(ret_ty, c.arguments[0].resolved_type)) {
                    this.diag.emit_payload_escape(c.arguments[0].span);
                }
            }
            return;
        }
        const me: MatchExpr* = ExpressionNode::match_of(e);
        if (me != null) {
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                const arm: MatchArmNode* = me.arms[i];
                if (arm == null) { continue; }
                this.check_return_payload_escape(this.patterns.arm_tail_expr(arm.body), ret_ty);
            }
            return;
        }
        const sme: StaticMatchExpr* = ExpressionNode::static_match_of(e);
        if (sme != null) {
            for (mut i: i64 = 0; i < sme.arms.length; i++) {
                const arm: StaticMatchArmNode* = sme.arms[i];
                if (arm == null) { continue; }
                this.check_return_payload_escape(this.patterns.arm_tail_expr(arm.body), ret_ty);
            }
            return;
        }
        const ie: IfExpr* = ExpressionNode::if_of(e);
        if (ie != null) {
            this.check_return_payload_escape(ie.then_expr, ret_ty);
            this.check_return_payload_escape(ie.else_expr, ret_ty);
            return;
        }
    }

    ret_carries_pointer_to(&this, ret_ty: TypeRef, v: TypeRef) -> boolean {
        if (this.types.is_ptr_or_ref_to(ret_ty, v)) { return true; }
        const t: Type* = this.arena.lookup(ret_ty);
        if (t != null && t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t.as_instantiated();
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                if (this.types.is_ptr_or_ref_to(inst.type_args[i], v)) { return true; }
            }
        }
        return false;
    }

    callee_names_ret_variant(&this, callee: ExpressionNode*, ret_ty: TypeRef) -> boolean {
        if (callee == null) { return false; }
        mut leaf: SymbolStr = SymbolStr::empty();
        const id: IdentifierExpr* = ExpressionNode::identifier_of(callee);
        if (id != null) { leaf = id.name; }
        else if (ExpressionNode::scope_resolution_of(callee) != null) {
            leaf = ExpressionNode::scope_resolution_of(callee).member_name;
        }
        else { return false; }
        if (!leaf.is_valid()) { return false; }
        const et: Type* = this.types.unwrap_to_enum(ret_ty);
        if (et == null || et.kind != TypeKind::Enum) { return false; }
        const e: EnumType* = et.as_enum();
        return e.variant_index(leaf) >= 0;
    }

    /// Whether a `match` subject's storage belongs to the CALLER rather than to
    /// this frame, so a payload binding taken from it aliases storage that
    /// outlives the function and `&binding` may legitimately be returned.
    ///
    /// True only for a subject reached through a by-reference receiver
    /// (`match (&this)` in a `&this` / `mut &this` method) or a pointer/reference
    /// parameter (`match (slot)` where `slot: Option<T>*`) - the same
    /// caller-backed reasoning that already exempts `&param` from the check.
    /// A BY-VALUE parameter does NOT qualify: it lives in this frame like any
    /// local, so a pointer into its payload dangles once the frame is gone.
    subject_is_caller_backed(&this, e: ExpressionNode*) -> boolean {
        if (e == null) { return false; }
        const id: IdentifierExpr* = ExpressionNode::identifier_of(e);
        if (id != null) {
            if (this.names_receiver(id)) { return this.state.this_is_by_ref; }
            if (!this.scopes.names_param(id.res.local_sym())) { return false; }
            return this.type_is_indirect(e.resolved_type);
        }
        // `&subject` / `*subject` keep naming the same storage; a member or
        // element of caller-backed storage is caller-backed too.
        const u: UnaryExpr* = ExpressionNode::unary_of(e);
        if (u != null) {
            if (u.desugared_call != null) { return false; }
            if (u.op.kind != TokenType::Amp && u.op.kind != TokenType::Star) { return false; }
            return this.subject_is_caller_backed(u.operand);
        }
        const ma: MemberAccessExpr* = ExpressionNode::member_access_of(e);
        if (ma != null) {
            return this.subject_is_caller_backed(ma.object);
        }
        const aa: ArrayAccessExpr* = ExpressionNode::array_access_of(e);
        if (aa != null) {
            return this.subject_is_caller_backed(aa.array);
        }
        return false;
    }

    /// Whether `ty` is a pointer or a reference — storage reached through it is
    /// somebody else's.
    type_is_indirect(&this, ty: TypeRef) -> boolean {
        if (!ty.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(ty);
        if (t == null) { return false; }
        return t.kind == TypeKind::Pointer || t.kind == TypeKind::Reference;
    }

    check_return_stack_address(mut &this, e: ExpressionNode*) -> void {
        if (e == null) { return; }
        // An object holds its operand's address as its data word.
        const oc: ObjectConversionExpr* = ExpressionNode::object_conversion_of(e);
        if (oc != null) {
            this.check_return_stack_address(oc.operand);
            return;
        }
        const ie: IfExpr* = ExpressionNode::if_of(e);
        if (ie != null) {
            this.check_return_stack_address(ie.then_expr);
            this.check_return_stack_address(ie.else_expr);
            return;
        }
        const me: MatchExpr* = ExpressionNode::match_of(e);
        if (me != null) {
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                const arm: MatchArmNode* = me.arms[i];
                if (arm == null) { continue; }
                this.check_return_stack_address(this.patterns.arm_tail_expr(arm.body));
            }
            return;
        }
        const sme: StaticMatchExpr* = ExpressionNode::static_match_of(e);
        if (sme != null) {
            for (mut i: i64 = 0; i < sme.arms.length; i++) {
                const arm: StaticMatchArmNode* = sme.arms[i];
                if (arm == null) { continue; }
                this.check_return_stack_address(this.patterns.arm_tail_expr(arm.body));
            }
            return;
        }
        const u: UnaryExpr* = ExpressionNode::unary_of(e);
        if (u != null) {
            const id: IdentifierExpr* = ExpressionNode::identifier_of(u.operand);
            if (u.op.kind == TokenType::Amp && id != null) {
                // A payload binding over a caller-backed subject names the
                // caller's storage, not a copy in this frame, so its address
                // survives the return — that is exactly an in-place accessor.
                if (this.scopes.names_alias(id.res.local_sym())) { return; }
                if (this.scopes.binds(id.res.local_sym()) && !this.scopes.names_param(id.res.local_sym())) {
                    this.ctx.emit_error_at(ErrorCode::E0455_DANGLING_POINTER,
                        "cannot return the address of a local variable: it lives on this function's stack frame and is freed when the function returns. Return the value by move, or a heap allocation, instead.",
                        e.span);
                }
            }
        }
    }


    // -- impl-trait (opaque type) checks --

    impl_trait_annotation_of(&this, ann: TypeAnnotation*) -> ImplTraitAnnotation* {
        if (ann == null) { return null; }
        match (*ann) {
            TypeAnnotation::ImplTrait(imp) => { return imp; }
            _ => { return null; }
        }
    }

    trait_leaf_name(&this, ann: TypeAnnotation*) -> SymbolStr {
        if (ann == null) { return SymbolStr::empty(); }
        match (*ann) {
            TypeAnnotation::Named(n)   => { return n.name; }
            TypeAnnotation::Generic(g) => { return this.trait_leaf_name(g.base); }
            _ => { return SymbolStr::empty(); }
        }
    }

    verify_impl_trait_bounds(mut &this, imp: ImplTraitAnnotation*, concrete: TypeRef, var_node: VarDecl*) -> void {
        if (imp == null) { return; }
        for (mut i: i64 = 0; i < imp.bounds.length; i++) {
            const trait_name: SymbolStr = this.trait_leaf_name(imp.bounds[i]);
            if (!trait_name.is_valid()) { continue; }
            const bound_id: DefId = TypeAnnotation::trait_def(imp.bounds[i]);
            if (this.trait_checker().type_satisfies_opaque_bound(
                    concrete, bound_id)) {
                this.check_opaque_assoc_item(imp.bounds[i], concrete, var_node);
                continue;
            }
            const var_name:  string = this.intern.resolve(var_node.name);
            const trait_str: string = this.intern.resolve(trait_name);
            const conc_str:  string = this.types.type_display_name(concrete);
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0200_TYPE_MISMATCH,
                fmt::format("`%s` is declared `implement %s`, but its initializer has type `%s`, which does not implement `%s`",
                       var_name, trait_str, conc_str, trait_str));
            diag = diag.at_with_label(annotation_span(var_node.type_annotation),
                "this opaque type requires the initializer to implement the trait");
            this.ctx.emit_diagnostic(diag);
            return;
        }
    }

    opaque_assoc_item_mismatch(mut &this, bound_ann: TypeAnnotation*, concrete: TypeRef,
                               out_expected: TypeRef*, out_actual: TypeRef*,
                               out_trait: SymbolStr*, out_item: SymbolStr*) -> boolean {
        if (bound_ann == null) { return false; }
        mut gen: GenericAnnotation* = null;
        match (*bound_ann) {
            TypeAnnotation::Generic(g) => { gen = g; }
            _ => { return false; }
        }
        if (gen == null || gen.args.length != 1) { return false; }
        const trait_leaf: DefId = TypeAnnotation::trait_def(bound_ann);
        if (!trait_leaf.is_valid()) { return false; }
        const tdecl: TraitDecl* = this.ctx.generic_registry.get_trait_decl(trait_leaf);
        if (tdecl == null) { return false; }
        if (tdecl.generic_params.length != 0 || tdecl.assoc_types.length != 1) { return false; }
        const adecl: AssocTypeDeclNode* = tdecl.assoc_types[0];
        if (adecl == null) { return false; }
        // The bound's argument is syntax written where the annotation is, and
        // carries that module's stamp.  An ABSTRACT param is a different
        // question: it needs a binding, which nothing here supplies, so those
        // keep failing here by construction.
        mut rc: ResolutionContext = ResolutionContext::new("");
        const expected: TypeRef = this.ctx.type_resolver.resolve(gen.args[0], &rc);
        const actual:   TypeRef = this.ctx.type_resolver.resolve_concrete_member(concrete, 0, tdecl, &rc);
        if (!expected.is_valid() || !actual.is_valid()) { return false; }
        if (expected.equals(actual)) { return false; }
        if (this.checker.check_compatibility(expected, actual) != TypeCompatibility::Incompatible) { return false; }
        if (this.checker.check_compatibility(actual, expected) != TypeCompatibility::Incompatible) { return false; }
        *out_expected = expected;
        *out_actual   = actual;
        *out_trait    = this.ctx.defs.path_of(trait_leaf).spelling();
        *out_item     = adecl.name;
        return true;
    }

    check_opaque_assoc_item(mut &this, bound_ann: TypeAnnotation*, concrete: TypeRef, var_node: VarDecl*) -> void {
        mut expected: TypeRef = TypeRef::invalid();
        mut actual:   TypeRef = TypeRef::invalid();
        mut trait_sym: SymbolStr = SymbolStr::empty();
        mut item_sym:  SymbolStr = SymbolStr::empty();
        if (!this.opaque_assoc_item_mismatch(bound_ann, concrete, &expected, &actual, &trait_sym, &item_sym)) { return; }
        const var_name:  string = this.intern.resolve(var_node.name);
        const trait_str: string = this.intern.resolve(trait_sym);
        const item_str:  string = this.intern.resolve(item_sym);
        const exp_str:   string = this.types.type_display_name(expected);
        const act_str:   string = this.types.type_display_name(actual);
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0200_TYPE_MISMATCH,
            fmt::format("`%s` is declared `implement %s<%s>`, but its initializer's `%s::%s` is `%s`, not `%s`",
                   var_name, trait_str, exp_str, trait_str, item_str, act_str, exp_str));
        diag = diag.at_with_label(annotation_span(var_node.type_annotation),
            "this opaque type's element type does not match the initializer");
        this.ctx.emit_diagnostic(diag);
    }

    check_opaque_return_item(mut &this, func_decl: DeclarationNode*) -> void {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null || func.return_type_annotation == null) { return; }
        if (!func.resolved_return_type.is_valid()) { return; }
        mut imp: ImplTraitAnnotation* = null;
        match (*func.return_type_annotation) {
            TypeAnnotation::ImplTrait(node) => { imp = node; }
            _ => { return; }
        }
        if (imp == null) { return; }
        for (mut i: i64 = 0; i < imp.bounds.length; i++) {
            mut expected: TypeRef = TypeRef::invalid();
            mut actual:   TypeRef = TypeRef::invalid();
            mut trait_sym: SymbolStr = SymbolStr::empty();
            mut item_sym:  SymbolStr = SymbolStr::empty();
            if (!this.opaque_assoc_item_mismatch(imp.bounds[i], func.resolved_return_type, &expected, &actual, &trait_sym, &item_sym)) { continue; }
            const fn_name:   string = this.intern.resolve(func.name);
            const trait_str: string = this.intern.resolve(trait_sym);
            const item_str:  string = this.intern.resolve(item_sym);
            const exp_str:   string = this.types.type_display_name(expected);
            const act_str:   string = this.types.type_display_name(actual);
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0200_TYPE_MISMATCH,
                fmt::format("`%s` is declared to return `implement %s<%s>`, but it returns a type whose `%s::%s` is `%s`, not `%s`",
                       fn_name, trait_str, exp_str, trait_str, item_str, act_str, exp_str));
            diag = diag.at_with_label(annotation_span(func.return_type_annotation),
                "this opaque return type's element type does not match the returned value");
            this.ctx.emit_diagnostic(diag);
            return;
        }
    }
}


// SemanticPasses: static dispatch for the pass registry.

type struct SemanticPasses {

    /// Walk all function bodies and fill resolved_type on every ExpressionNode.
    /// Runs once, before monomorphization; a copy carries what it decided.
    static run_sema(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();
        const arena: TypeArena* = ctx.type_arena;
        if (arena == null) {
            ctx.emit_error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR, "Sema: type system not initialized");
            return PassResult::failure(1);
        }
        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) { return PassResult::ok(); }

        // Leak to a stable heap address, THEN wire (collaborators take back-
        // pointers into the visitor's fields), mirroring codegen/passes.cryo.
        // Bind the Box to a typed local first so `.leak()`'s generic `T*` return
        // is inferred as `SemaVisitor*` (an inline `Box<..>::new(..).leak()`
        // leaves `T` unbound - see codegen's `_box_gen` two-step).
        const _box_v: Box<SemaVisitor> = Box::<SemaVisitor>::new(SemaVisitor::build(ctx));
        const v: SemaVisitor* = _box_v.leak();
        v.wire();
        v.visit_program(root);

        if (Log::enabled(LogArea::Sema, LogLevel::Debug)) {
            Log::debug(LogArea::Sema, f"type-checked {v.state.body_count} function bodies");
            Log::debug(LogArea::Sema, f"symbolic check walked {v.state.symbolic_bodies_walked} generic bodies, emitted {v.state.symbolic_total_would_emit} errors");
        }
        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }
}
