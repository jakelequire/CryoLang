/// AsyncLower
///
/// Lowers a non-generic `async function` into a poll-driven state machine: a
/// synthesized struct (the function's parameters as captured fields + a `state`
/// discriminant) that implements `std::future::traits::Future`, plus a rewrite
/// of the original function into a constructor returning that struct. The
/// original body moves into the generated `poll` method with every `return E`
/// rewritten to `return Poll::Ready(E)`.
///
/// Increment 1b handles the NO-AWAIT case: the body runs to completion in a
/// single `poll`, so no `switch (state)` resume dispatcher is emitted yet.
/// `await` suspend states, cross-await local promotion, and the resumable
/// switch arrive in later increments.
///
/// Mirrors LambdaSynth's synthesize + register + inject machinery (a closure
/// struct + `__call__`), adding the trait-impl registration a closure omits: the
/// generated struct must formally implement `Future` so `block_on<F,R> where
/// F: Future<R>` binds and `.poll()` dispatches. The two trait-registry keys are
/// registered directly (dispatch keys on the struct's qualified name; the bound
/// check on its qualified-name id), avoiding the DeclCollection/TypeResolution
/// funnels whose target-name qualification assumes a parser-bare target.

namespace Compiler::Sema::AsyncLower;

import Compiler::Types::{ TypeRef, Type, Arena, Compound, UserDefined, Ownership, Resolver, GenericRegistry };
import Compiler::Resolver::{ SymbolStr, InternTable, QualifiedName, MangledName };
import Compiler::AST;
import Compiler::AST::{ Node, Visitor, Expression, Statement, Declaration, Pattern, Cloner };
import Compiler::Lex;
import Compiler::Diag;
import Compiler::Diag::{ Diagnostic, SourceSpan };
import Compiler::Passes::TypeResolution;
import Compiler::CompilationContext;
import std::core::{ option, mem };
import std::fmt;

/// The state-machine builder's accumulator for lowering one `async function`
/// body with >= 1 `await`. `lower` seeds the configuration; the recursive
/// builder (`build_poll_body_sm` and friends) fills `blocks` — one straight-line
/// state block per `match (this.state)` arm — plus the discovered sub-future and
/// promoted-local inventories, which `lower` then turns into the generated
/// struct's fields and constructor initializers.
///
/// A forward edge between states is a `this.state = <k>;` assignment: the arm
/// falls off and the enclosing `loop` re-dispatches the advanced state. Awaits
/// split the current state at the suspend point (a `resume` state polls the
/// stashed sub-future); an `if`/`else` holding an await dispatches to per-branch
/// entry states that converge on a join state.
type struct PollSm {
    // configuration (set by `lower`)
    struct_ref: TypeRef;
    poll_out:   TypeRef;
    ctx_ptr_ty: TypeRef;
    state_sym:  SymbolStr;
    u32_ty:     TypeRef;
    cx_sym:     SymbolStr;
    opt_base:   TypeRef;              // the `Option<>` base, for `Option<F_k>`
    span:       SourceSpan;

    // accumulated state blocks (index == state value) + a hard-error flag: an
    // unsupported await shape or an illegal cross-suspend local sets ok=false
    // and unwinds the build.
    blocks:     BlockStmtNode*[];
    ok:         boolean;

    // one `fut_k: Option<F_k>` sub-future field per await (pre-order ordinal)
    fut_syms:   SymbolStr[];
    fut_opt:    TypeRef[];
    naw:        i64;

    // one field per promoted cross-state scalar local (read in a state other
    // than the one it is declared in, so it cannot live on the native stack)
    prom_field: SymbolStr[];
    prom_tys:   TypeRef[];
    nprom:      i64;

    // Loop-target stacks (innermost loop last). Entering an await-carrying loop
    // pushes its continue-target (header / `for` update) and break-target (the
    // after state); `break`/`continue` in the body lower to a `this.state = <top>;`
    // edge. `break`/`continue` in an await-free nested loop stay native (that
    // loop is emitted wholesale), so the top of the stack is always the innermost
    // EXPLODED loop, which is exactly the source loop the edge targets.
    loop_cont:  i64[];
    loop_brk:   i64[];
}

type struct AsyncLower {
    arena:   TypeArena*;
    intern:  InternTable*;
    ctx:     CompilationContext*;
    counter: u64;

    static null() -> AsyncLower {
        return AsyncLower { arena: null, intern: null, ctx: null, counter: 0u64 };
    }

    wire(mut &this, arena: TypeArena*, intern: InternTable*, ctx: CompilationContext*) -> void {
        this.arena  = arena;
        this.intern = intern;
        this.ctx    = ctx;
    }

    /// Resolve a stdlib future type by its import-visible leaf (`Poll`,
    /// `Context`) to its arena TypeRef. Invalid if the module didn't import it.
    lookup_future_type(&this, leaf: string) -> TypeRef {
        const leaf_sym: SymbolStr = this.intern.intern(leaf);
        const qual: SymbolStr = this.ctx.resolve_scoped_or(leaf_sym);
        return this.ctx.decl_index.lookup_type(qual);
    }

    mint_bare(mut &this, base: string) -> SymbolStr {
        const idx: u64 = this.counter;
        this.counter += 1u64;
        return this.intern.intern(format("%s$Future_%llu", base, idx));
    }

    /// Build a `Named` type annotation whose resolution short-circuits to `ty`
    /// (via `pre_resolved`), so a synthesized annotation resolves without a name
    /// lookup.
    make_type_ann(&this, ty: TypeRef, span: SourceSpan) -> TypeAnnotation* {
        const disp: string = this.arena.resolve_display_name(ty.id);
        mut n: NamedAnnotation* = new NamedAnnotation {
            name: this.intern.intern(disp), span: span, pre_resolved: ty,
        };
        return new TypeAnnotation::Named(n);
    }

    /// Wrap an already-typed value expression in `Poll::Ready(<expr>)` typed as
    /// `Poll<Output>`.
    make_poll_ready(&this, value: ExpressionNode*, poll_out: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut scope: ScopeResolutionNode* = new ScopeResolutionNode(
            this.intern.intern("Poll"), this.intern.intern("Ready"), span);
        scope.set_resolved_type(poll_out);
        mut call: CallExprNode* = new CallExprNode(scope as ExpressionNode*, span);
        call.add_argument(value);
        call.set_resolved_type(poll_out);
        return call as ExpressionNode*;
    }

    /// Rewrite every `return E;` reachable in `stmt` to `return Poll::Ready(E);`,
    /// recursing into blocks and every control-flow container so a return nested
    /// in an if / loop / match is wrapped too. Return sites are found by a plain
    /// structural walk (no await handling); `await` suspend points inside these
    /// containers arrive with the later state-machine increments. Does NOT descend
    /// into nested function-like bodies (a lambda's returns are its own, and a
    /// lambda is an expression this statement walk never enters).
    rewrite_returns(mut &this, stmt: StatementNode*, poll_out: TypeRef, span: SourceSpan) -> void {
        if (stmt == null) { return; }
        if (stmt.kind == NodeKind::ReturnStatement) {
            const ret: ReturnStmtNode* = stmt as ReturnStmtNode*;
            if (ret.expression != null) {
                ret.expression = this.make_poll_ready(ret.expression, poll_out, span);
            }
            return;
        }
        if (stmt.kind == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = stmt as BlockStmtNode*;
            for (mut i: i64 = 0; i < blk.statements.length; i++) {
                this.rewrite_returns(blk.statements[i], poll_out, span);
            }
            return;
        }
        if (stmt.kind == NodeKind::IfStatement) {
            const iff: IfStmtNode* = stmt as IfStmtNode*;
            this.rewrite_returns(iff.then_stmt, poll_out, span);
            this.rewrite_returns(iff.else_stmt, poll_out, span);
            return;
        }
        if (stmt.kind == NodeKind::WhileStatement) {
            this.rewrite_returns((stmt as WhileStmtNode*).body, poll_out, span);
            return;
        }
        if (stmt.kind == NodeKind::DoWhileStatement) {
            this.rewrite_returns((stmt as DoWhileStmtNode*).body, poll_out, span);
            return;
        }
        if (stmt.kind == NodeKind::ForStatement) {
            this.rewrite_returns((stmt as ForStmtNode*).body, poll_out, span);
            return;
        }
        if (stmt.kind == NodeKind::LoopStatement) {
            this.rewrite_returns((stmt as LoopStmtNode*).body, poll_out, span);
            return;
        }
        if (stmt.kind == NodeKind::MatchStatement) {
            const m: MatchStmtNode* = stmt as MatchStmtNode*;
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                if (m.arms[i] != null) {
                    this.rewrite_returns(m.arms[i].body, poll_out, span);
                }
            }
            return;
        }
    }

    // ---- await discovery (Inc 2: a single straight-line await) ----

    /// Count `await` sub-expressions in an expression tree. Covers the node
    /// kinds an awaited-future expression realistically nests under; kinds not
    /// walked can only UNDER-count, and any `await` the lowering leaves in place
    /// is caught by codegen's `await`-not-implemented hard error, so an
    /// imperfect count degrades only the diagnostic, never soundness.
    expr_await_count(&this, e: ExpressionNode*) -> i64 {
        if (e == null) { return 0i64; }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::AwaitExpression) {
            return 1i64 + this.expr_await_count((e as AwaitExprNode*).operand);
        }
        if (k == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            return this.expr_await_count(b.left) + this.expr_await_count(b.right);
        }
        if (k == NodeKind::UnaryExpression) {
            return this.expr_await_count((e as UnaryExprNode*).operand);
        }
        if (k == NodeKind::CallExpression) {
            const c: CallExprNode* = e as CallExprNode*;
            mut n: i64 = this.expr_await_count(c.callee);
            for (mut i: i64 = 0; i < c.arguments.length; i++) {
                n += this.expr_await_count(c.arguments[i]);
            }
            return n;
        }
        if (k == NodeKind::MemberAccess) {
            return this.expr_await_count((e as MemberAccessNode*).object);
        }
        return 0i64;
    }

    /// Count `await`s in a statement, recursing through control-flow containers
    /// so an `await` buried in a nested block/branch/loop is still tallied (and
    /// therefore rejected — Inc 2 lowers only a single straight-line await).
    stmt_await_count(&this, stmt: StatementNode*) -> i64 {
        if (stmt == null) { return 0i64; }
        const k: NodeKind = stmt.kind;
        if (k == NodeKind::ExpressionStatement) {
            return this.expr_await_count((stmt as ExprStmtNode*).expression);
        }
        if (k == NodeKind::ReturnStatement) {
            return this.expr_await_count((stmt as ReturnStmtNode*).expression);
        }
        if (k == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = stmt as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                return this.expr_await_count((ds.declaration as VarDeclNode*).initializer);
            }
            return 0i64;
        }
        if (k == NodeKind::BlockStatement) {
            return this.block_await_count(stmt as BlockStmtNode*);
        }
        if (k == NodeKind::IfStatement) {
            const iff: IfStmtNode* = stmt as IfStmtNode*;
            return this.expr_await_count(iff.condition)
                 + this.stmt_await_count(iff.then_stmt)
                 + this.stmt_await_count(iff.else_stmt);
        }
        if (k == NodeKind::WhileStatement) {
            const w: WhileStmtNode* = stmt as WhileStmtNode*;
            return this.expr_await_count(w.condition) + this.stmt_await_count(w.body);
        }
        if (k == NodeKind::DoWhileStatement) {
            const d: DoWhileStmtNode* = stmt as DoWhileStmtNode*;
            return this.expr_await_count(d.condition) + this.stmt_await_count(d.body);
        }
        if (k == NodeKind::ForStatement) {
            const f: ForStmtNode* = stmt as ForStmtNode*;
            mut n: i64 = this.expr_await_count(f.condition) + this.expr_await_count(f.update)
                       + this.stmt_await_count(f.body);
            if (f.init != null) {
                if ((f.init as ASTNode*).kind == NodeKind::VariableDeclaration) {
                    n += this.expr_await_count((f.init as VarDeclNode*).initializer);
                } else {
                    n += this.expr_await_count(f.init as ExpressionNode*);
                }
            }
            return n;
        }
        if (k == NodeKind::LoopStatement) {
            return this.stmt_await_count((stmt as LoopStmtNode*).body);
        }
        if (k == NodeKind::MatchStatement) {
            const m: MatchStmtNode* = stmt as MatchStmtNode*;
            mut n: i64 = 0i64;
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                if (m.arms[i] != null) { n += this.stmt_await_count(m.arms[i].body); }
            }
            return n;
        }
        return 0i64;
    }

    block_await_count(&this, blk: BlockStmtNode*) -> i64 {
        if (blk == null) { return 0i64; }
        mut n: i64 = 0i64;
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            n += this.stmt_await_count(blk.statements[i]);
        }
        return n;
    }

    /// If `stmt`'s TOP-LEVEL expression is an `await`, return that node; else
    /// null. The three carriers Inc 2 supports: `const/mut x = await e;`,
    /// `return await e;`, and a bare `await e;`. An await nested deeper in an
    /// expression is intentionally not a carrier (the count gate rejects it).
    stmt_toplevel_await(&this, stmt: StatementNode*) -> AwaitExprNode* {
        if (stmt == null) { return null; }
        if (stmt.kind == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = stmt as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                const vd: VarDeclNode* = ds.declaration as VarDeclNode*;
                if (vd.initializer != null && vd.initializer.kind == NodeKind::AwaitExpression) {
                    return vd.initializer as AwaitExprNode*;
                }
            }
            return null;
        }
        if (stmt.kind == NodeKind::ReturnStatement) {
            const rs: ReturnStmtNode* = stmt as ReturnStmtNode*;
            if (rs.expression != null && rs.expression.kind == NodeKind::AwaitExpression) {
                return rs.expression as AwaitExprNode*;
            }
            return null;
        }
        if (stmt.kind == NodeKind::ExpressionStatement) {
            const es: ExprStmtNode* = stmt as ExprStmtNode*;
            if (es.expression != null && es.expression.kind == NodeKind::AwaitExpression) {
                return es.expression as AwaitExprNode*;
            }
            return null;
        }
        return null;
    }

    /// Replace the top-level `await e` in a carrier statement with `repl` (the
    /// identifier bound to the awaited result). The carrier then runs, on
    /// resume, reading the result instead of the (removed) await.
    rewrite_carrier_await(&this, stmt: StatementNode*, repl: ExpressionNode*) -> void {
        if (stmt == null) { return; }
        if (stmt.kind == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = stmt as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                (ds.declaration as VarDeclNode*).initializer = repl;
            }
            return;
        }
        if (stmt.kind == NodeKind::ReturnStatement) {
            (stmt as ReturnStmtNode*).expression = repl;
            return;
        }
        if (stmt.kind == NodeKind::ExpressionStatement) {
            (stmt as ExprStmtNode*).expression = repl;
            return;
        }
    }

    // ---- small typed-AST builders (shared by the poll-body synthesis) ----

    this_ident(&this, struct_ref: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut ti: IdentifierNode* = new IdentifierNode(this.intern.intern("this"), span);
        ti.set_resolved_type(struct_ref);
        return ti as ExpressionNode*;
    }

    ident(&this, name: SymbolStr, ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut id: IdentifierNode* = new IdentifierNode(name, span);
        id.set_resolved_type(ty);
        return id as ExpressionNode*;
    }

    member(&this, obj: ExpressionNode*, field: SymbolStr, ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut m: MemberAccessNode* = new MemberAccessNode(obj, field, span, span);
        m.set_resolved_type(ty);
        return m as ExpressionNode*;
    }

    u32_lit(&this, value: u64, span: SourceSpan) -> ExpressionNode* {
        mut lit: LiteralNode* = new LiteralNode(format("%llu", value), LiteralKind::Integer, span);
        lit.set_resolved_type(this.arena.get_u32());
        return lit as ExpressionNode*;
    }

    /// `recv.name()` typed `ret_ty`. The member/call re-resolve by name during
    /// the post-mono body re-check; `ret_ty` is the pre-mono hint.
    method_call0(&this, recv: ExpressionNode*, name: string, ret_ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut m: MemberAccessNode* = new MemberAccessNode(recv, this.intern.intern(name), span, span);
        mut c: CallExprNode* = new CallExprNode(m as ExpressionNode*, span);
        c.set_resolved_type(ret_ty);
        return c as ExpressionNode*;
    }

    method_call1(&this, recv: ExpressionNode*, name: string, arg: ExpressionNode*,
                 ret_ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut m: MemberAccessNode* = new MemberAccessNode(recv, this.intern.intern(name), span, span);
        mut c: CallExprNode* = new CallExprNode(m as ExpressionNode*, span);
        c.add_argument(arg);
        c.set_resolved_type(ret_ty);
        return c as ExpressionNode*;
    }

    /// `this.<field> = <rhs>;` as a statement.
    assign_member_stmt(&this, struct_ref: TypeRef, field: SymbolStr, field_ty: TypeRef,
                       rhs: ExpressionNode*, span: SourceSpan) -> StatementNode* {
        mut lhs: ExpressionNode* = this.member(this.this_ident(struct_ref, span), field, field_ty, span);
        const eq: Token = Token::new(TokenType::Equal, "=", span.start_line as int, span.start_col as int);
        mut assign: BinaryExprNode* = new BinaryExprNode(eq, lhs, rhs, span);
        assign.set_resolved_type(this.arena.get_void());
        mut es: ExprStmtNode* = new ExprStmtNode(assign as ExpressionNode*, span);
        return es as StatementNode*;
    }

    /// A `match` arm `<value> => { <body> }` with a bare integer-literal pattern.
    /// Mirrors the parser's literal-int pattern (`PatternKind::Literal` +
    /// `LiteralKind::Integer`, no type suffix); the `u32` state type is inferred
    /// from the match subject, so the pattern text stays a bare integer.
    match_arm_int(&this, value: u64, body: BlockStmtNode*, span: SourceSpan) -> MatchArmNode* {
        mut pat: PatternNode* = new PatternNode(PatternKind::Literal, span);
        pat.set_value(this.intern.intern(format("%llu", value)));
        pat.set_literal_kind(LiteralKind::Integer);
        mut arm: MatchArmNode* = new MatchArmNode(span);
        arm.add_pattern(pat);
        arm.set_body(body as StatementNode*);
        return arm;
    }

    /// A `match` arm `_ => { <body> }` (the wildcard, making the state dispatch
    /// exhaustive over the open `u32` domain).
    match_arm_wild(&this, body: BlockStmtNode*, span: SourceSpan) -> MatchArmNode* {
        mut pat: PatternNode* = new PatternNode(PatternKind::Wildcard, span);
        mut arm: MatchArmNode* = new MatchArmNode(span);
        arm.add_pattern(pat);
        arm.set_body(body as StatementNode*);
        return arm;
    }

    /// `Option::Some(<value>)` typed `opt_ty`.
    option_some(&this, value: ExpressionNode*, opt_ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut scope: ScopeResolutionNode* = new ScopeResolutionNode(
            this.intern.intern("Option"), this.intern.intern("Some"), span);
        scope.set_resolved_type(opt_ty);
        mut call: CallExprNode* = new CallExprNode(scope as ExpressionNode*, span);
        call.add_argument(value);
        call.set_resolved_type(opt_ty);
        return call as ExpressionNode*;
    }

    /// `Option::None` typed `opt_ty`.
    option_none(&this, opt_ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut scope: ScopeResolutionNode* = new ScopeResolutionNode(
            this.intern.intern("Option"), this.intern.intern("None"), span);
        scope.set_resolved_type(opt_ty);
        return scope as ExpressionNode*;
    }

    /// `Poll::Pending` typed `poll_ty`.
    poll_pending(&this, poll_ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut scope: ScopeResolutionNode* = new ScopeResolutionNode(
            this.intern.intern("Poll"), this.intern.intern("Pending"), span);
        scope.set_resolved_type(poll_ty);
        return scope as ExpressionNode*;
    }

    var_decl_stmt(&this, name: SymbolStr, mutable: boolean, ty: TypeRef,
                  init: ExpressionNode*, span: SourceSpan) -> StatementNode* {
        mut vd: VarDeclNode* = new VarDeclNode(name, span);
        vd.set_mutable(mutable);
        vd.set_resolved_type(ty);
        vd.set_initializer(init);
        mut ds: DeclStmtNode* = new DeclStmtNode(vd as DeclarationNode*, span);
        return ds as StatementNode*;
    }

    /// The arg-shadow prelude common to every generated `poll`: `const p =
    /// this.p;` for each captured parameter, so the moved body resolves its
    /// parameter names against the struct fields.
    emit_shadow_prelude(&this, node: FunctionDeclNode*, body: BlockStmtNode*,
                        struct_ref: TypeRef, span: SourceSpan) -> void {
        const this_sym: SymbolStr = this.intern.intern("this");
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            const p: VarDeclNode* = node.parameters[i];
            if (p == null || !p.resolved_type.is_valid()) { continue; }
            mut this_ref: IdentifierNode* = new IdentifierNode(this_sym, span);
            this_ref.set_resolved_type(struct_ref);
            mut access: MemberAccessNode* = new MemberAccessNode(
                this_ref as ExpressionNode*, p.name, span, span);
            access.set_resolved_type(p.resolved_type);
            mut shadow: VarDeclNode* = new VarDeclNode(p.name, span);
            shadow.set_mutable(false);
            shadow.set_resolved_type(p.resolved_type);
            shadow.set_initializer(access as ExpressionNode*);
            const shadow_stmt: DeclStmtNode* = new DeclStmtNode(shadow as DeclarationNode*, span);
            body.add_statement(shadow_stmt as StatementNode*);
        }
    }

    /// No-await body: shadow prelude + the original body with `return E`
    /// rewritten to `return Poll::Ready(E)` (runs to completion in one poll).
    build_poll_body_no_await(mut &this, node: FunctionDeclNode*, struct_ref: TypeRef,
                             poll_out: TypeRef, span: SourceSpan) -> BlockStmtNode* {
        mut body: BlockStmtNode* = new BlockStmtNode(span);
        this.emit_shadow_prelude(node, body, struct_ref, span);
        if (node.body.kind == NodeKind::BlockStatement) {
            const orig: BlockStmtNode* = node.body as BlockStmtNode*;
            for (mut bi: i64 = 0; bi < orig.statements.length; bi++) {
                this.rewrite_returns(orig.statements[bi], poll_out, span);
                body.add_statement(orig.statements[bi]);
            }
        }
        return body;
    }

    // ---- cross-await promotion analysis (Inc 3) ----

    /// True if `name` is read (appears as an identifier) anywhere in `e`. Walks
    /// the expression kinds an awaited body realistically nests names under; a
    /// missed kind can only UNDER-report, which leaves a cross-await local
    /// unpromoted and surfaces as a plain "not found" at its later use — a loud
    /// compile error, never a silent miscompile.
    name_read_in_expr(&this, e: ExpressionNode*, name: SymbolStr) -> boolean {
        if (e == null) { return false; }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::Identifier) {
            return (e as IdentifierNode*).name.equals(name);
        }
        if (k == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            return this.name_read_in_expr(b.left, name) || this.name_read_in_expr(b.right, name);
        }
        if (k == NodeKind::UnaryExpression) {
            return this.name_read_in_expr((e as UnaryExprNode*).operand, name);
        }
        if (k == NodeKind::CallExpression) {
            const c: CallExprNode* = e as CallExprNode*;
            if (this.name_read_in_expr(c.callee, name)) { return true; }
            for (mut i: i64 = 0; i < c.arguments.length; i++) {
                if (this.name_read_in_expr(c.arguments[i], name)) { return true; }
            }
            return false;
        }
        if (k == NodeKind::MemberAccess) {
            return this.name_read_in_expr((e as MemberAccessNode*).object, name);
        }
        if (k == NodeKind::CastExpression) {
            return this.name_read_in_expr((e as CastExprNode*).expression, name);
        }
        if (k == NodeKind::ArrayAccess) {
            const a: ArrayAccessNode* = e as ArrayAccessNode*;
            return this.name_read_in_expr(a.array, name) || this.name_read_in_expr(a.index, name);
        }
        if (k == NodeKind::TernaryExpression) {
            const t: TernaryExprNode* = e as TernaryExprNode*;
            return this.name_read_in_expr(t.condition, name)
                || this.name_read_in_expr(t.true_expr, name)
                || this.name_read_in_expr(t.false_expr, name);
        }
        if (k == NodeKind::StructLiteral) {
            const sl: StructLiteralNode* = e as StructLiteralNode*;
            for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                if (this.name_read_in_expr(sl.field_inits[i].value, name)) { return true; }
            }
            return false;
        }
        if (k == NodeKind::AwaitExpression) {
            return this.name_read_in_expr((e as AwaitExprNode*).operand, name);
        }
        return false;
    }

    /// True if `name` is read anywhere in statement `s`, recursing through the
    /// (await-free) control-flow containers a straight-line segment may hold.
    name_read_in_stmt(&this, s: StatementNode*, name: SymbolStr) -> boolean {
        if (s == null) { return false; }
        const k: NodeKind = s.kind;
        if (k == NodeKind::ExpressionStatement) {
            return this.name_read_in_expr((s as ExprStmtNode*).expression, name);
        }
        if (k == NodeKind::ReturnStatement) {
            return this.name_read_in_expr((s as ReturnStmtNode*).expression, name);
        }
        if (k == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = s as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                return this.name_read_in_expr((ds.declaration as VarDeclNode*).initializer, name);
            }
            return false;
        }
        if (k == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = s as BlockStmtNode*;
            for (mut i: i64 = 0; i < blk.statements.length; i++) {
                if (this.name_read_in_stmt(blk.statements[i], name)) { return true; }
            }
            return false;
        }
        if (k == NodeKind::IfStatement) {
            const iff: IfStmtNode* = s as IfStmtNode*;
            return this.name_read_in_expr(iff.condition, name)
                || this.name_read_in_stmt(iff.then_stmt, name)
                || this.name_read_in_stmt(iff.else_stmt, name);
        }
        if (k == NodeKind::WhileStatement) {
            const w: WhileStmtNode* = s as WhileStmtNode*;
            return this.name_read_in_expr(w.condition, name) || this.name_read_in_stmt(w.body, name);
        }
        if (k == NodeKind::DoWhileStatement) {
            const d: DoWhileStmtNode* = s as DoWhileStmtNode*;
            return this.name_read_in_expr(d.condition, name) || this.name_read_in_stmt(d.body, name);
        }
        if (k == NodeKind::ForStatement) {
            const f: ForStmtNode* = s as ForStmtNode*;
            if (f.init != null && this.name_read_in_stmt(f.init as StatementNode*, name)) { return true; }
            return this.name_read_in_expr(f.condition, name)
                || this.name_read_in_expr(f.update, name)
                || this.name_read_in_stmt(f.body, name);
        }
        if (k == NodeKind::LoopStatement) {
            return this.name_read_in_stmt((s as LoopStmtNode*).body, name);
        }
        if (k == NodeKind::MatchStatement) {
            const m: MatchStmtNode* = s as MatchStmtNode*;
            if (this.name_read_in_expr(m.subject, name)) { return true; }
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                if (m.arms[i] != null && this.name_read_in_stmt(m.arms[i].body, name)) { return true; }
            }
            return false;
        }
        return false;
    }

    // ---- in-place identifier rewrite (mut cross-state promotion) ----

    /// Rewrite every read of identifier `name` in `e` to `this.<field>` (typed
    /// `ty`), returning the (possibly replaced) expression for the caller's slot.
    /// The mutating twin of `name_read_in_expr` — the promoted `mut` field is the
    /// single source of truth, so reads AND assignment targets (`name = …`, whose
    /// LHS is an identifier) both become `this.<field>`. Covers the same node
    /// kinds; an unwalked kind leaves a `name` read in place, which surfaces as a
    /// loud "not found" at its use, never a silent miscompile.
    subst_name_expr(mut &this, e: ExpressionNode*, name: SymbolStr, field: SymbolStr,
                    struct_ref: TypeRef, ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        if (e == null) { return null; }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::Identifier) {
            if ((e as IdentifierNode*).name.equals(name)) {
                return this.member(this.this_ident(struct_ref, span), field, ty, span);
            }
            return e;
        }
        if (k == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            b.left  = this.subst_name_expr(b.left, name, field, struct_ref, ty, span);
            b.right = this.subst_name_expr(b.right, name, field, struct_ref, ty, span);
            return e;
        }
        if (k == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = e as UnaryExprNode*;
            u.operand = this.subst_name_expr(u.operand, name, field, struct_ref, ty, span);
            return e;
        }
        if (k == NodeKind::CallExpression) {
            const c: CallExprNode* = e as CallExprNode*;
            c.callee = this.subst_name_expr(c.callee, name, field, struct_ref, ty, span);
            for (mut i: i64 = 0; i < c.arguments.length; i++) {
                c.arguments[i] = this.subst_name_expr(c.arguments[i], name, field, struct_ref, ty, span);
            }
            return e;
        }
        if (k == NodeKind::MemberAccess) {
            const m: MemberAccessNode* = e as MemberAccessNode*;
            m.object = this.subst_name_expr(m.object, name, field, struct_ref, ty, span);
            return e;
        }
        if (k == NodeKind::CastExpression) {
            const ce: CastExprNode* = e as CastExprNode*;
            ce.expression = this.subst_name_expr(ce.expression, name, field, struct_ref, ty, span);
            return e;
        }
        if (k == NodeKind::ArrayAccess) {
            const a: ArrayAccessNode* = e as ArrayAccessNode*;
            a.array = this.subst_name_expr(a.array, name, field, struct_ref, ty, span);
            a.index = this.subst_name_expr(a.index, name, field, struct_ref, ty, span);
            return e;
        }
        if (k == NodeKind::TernaryExpression) {
            const t: TernaryExprNode* = e as TernaryExprNode*;
            t.condition  = this.subst_name_expr(t.condition, name, field, struct_ref, ty, span);
            t.true_expr  = this.subst_name_expr(t.true_expr, name, field, struct_ref, ty, span);
            t.false_expr = this.subst_name_expr(t.false_expr, name, field, struct_ref, ty, span);
            return e;
        }
        if (k == NodeKind::StructLiteral) {
            const sl: StructLiteralNode* = e as StructLiteralNode*;
            mut newf: FieldInit[] = [];
            for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                const fi: FieldInit = sl.field_inits[i];
                newf.push(FieldInit {
                    field_name: fi.field_name,
                    value: this.subst_name_expr(fi.value, name, field, struct_ref, ty, span),
                    span: fi.span });
            }
            sl.field_inits = newf;
            return e;
        }
        if (k == NodeKind::AwaitExpression) {
            const aw: AwaitExprNode* = e as AwaitExprNode*;
            aw.operand = this.subst_name_expr(aw.operand, name, field, struct_ref, ty, span);
            return e;
        }
        return e;
    }

    /// Rewrite every read of `name` in statement `s` to `this.<field>`, recursing
    /// through control-flow containers (including await-free nested loops emitted
    /// wholesale). Mutates the statement's expression slots in place.
    subst_name_stmt(mut &this, s: StatementNode*, name: SymbolStr, field: SymbolStr,
                    struct_ref: TypeRef, ty: TypeRef, span: SourceSpan) -> void {
        if (s == null) { return; }
        const k: NodeKind = s.kind;
        if (k == NodeKind::ExpressionStatement) {
            const es: ExprStmtNode* = s as ExprStmtNode*;
            es.expression = this.subst_name_expr(es.expression, name, field, struct_ref, ty, span);
            return;
        }
        if (k == NodeKind::ReturnStatement) {
            const rs: ReturnStmtNode* = s as ReturnStmtNode*;
            rs.expression = this.subst_name_expr(rs.expression, name, field, struct_ref, ty, span);
            return;
        }
        if (k == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = s as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                const vd: VarDeclNode* = ds.declaration as VarDeclNode*;
                vd.initializer = this.subst_name_expr(vd.initializer, name, field, struct_ref, ty, span);
            }
            return;
        }
        if (k == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = s as BlockStmtNode*;
            for (mut i: i64 = 0; i < blk.statements.length; i++) {
                this.subst_name_stmt(blk.statements[i], name, field, struct_ref, ty, span);
            }
            return;
        }
        if (k == NodeKind::IfStatement) {
            const iff: IfStmtNode* = s as IfStmtNode*;
            iff.condition = this.subst_name_expr(iff.condition, name, field, struct_ref, ty, span);
            this.subst_name_stmt(iff.then_stmt, name, field, struct_ref, ty, span);
            this.subst_name_stmt(iff.else_stmt, name, field, struct_ref, ty, span);
            return;
        }
        if (k == NodeKind::WhileStatement) {
            const w: WhileStmtNode* = s as WhileStmtNode*;
            w.condition = this.subst_name_expr(w.condition, name, field, struct_ref, ty, span);
            this.subst_name_stmt(w.body, name, field, struct_ref, ty, span);
            return;
        }
        if (k == NodeKind::DoWhileStatement) {
            const d: DoWhileStmtNode* = s as DoWhileStmtNode*;
            d.condition = this.subst_name_expr(d.condition, name, field, struct_ref, ty, span);
            this.subst_name_stmt(d.body, name, field, struct_ref, ty, span);
            return;
        }
        if (k == NodeKind::ForStatement) {
            const f: ForStmtNode* = s as ForStmtNode*;
            if (f.init != null) {
                if ((f.init as ASTNode*).kind == NodeKind::VariableDeclaration) {
                    const vd: VarDeclNode* = f.init as VarDeclNode*;
                    vd.initializer = this.subst_name_expr(vd.initializer, name, field, struct_ref, ty, span);
                } else {
                    f.init = this.subst_name_expr(f.init as ExpressionNode*, name, field, struct_ref, ty, span) as ASTNode*;
                }
            }
            f.condition = this.subst_name_expr(f.condition, name, field, struct_ref, ty, span);
            f.update    = this.subst_name_expr(f.update, name, field, struct_ref, ty, span);
            this.subst_name_stmt(f.body, name, field, struct_ref, ty, span);
            return;
        }
        if (k == NodeKind::LoopStatement) {
            this.subst_name_stmt((s as LoopStmtNode*).body, name, field, struct_ref, ty, span);
            return;
        }
        if (k == NodeKind::MatchStatement) {
            const m: MatchStmtNode* = s as MatchStmtNode*;
            m.subject = this.subst_name_expr(m.subject, name, field, struct_ref, ty, span);
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                if (m.arms[i] != null) {
                    this.subst_name_stmt(m.arms[i].body, name, field, struct_ref, ty, span);
                }
            }
            return;
        }
    }

    /// The variable declared by a top-level `const/mut x = …;` statement
    /// (including an `await` carrier `const x = await e;`), or null if the
    /// statement declares no local.
    stmt_decl_var(&this, s: StatementNode*) -> VarDeclNode* {
        if (s == null || s.kind != NodeKind::DeclarationStatement) { return null; }
        const ds: DeclStmtNode* = s as DeclStmtNode*;
        if (ds.declaration == null || ds.declaration.kind != NodeKind::VariableDeclaration) {
            return null;
        }
        return ds.declaration as VarDeclNode*;
    }

    /// A promoted cross-await local must sit in a struct field the constructor
    /// can zero-initialize without dropping garbage — i.e. a scalar Copy type.
    /// (Aggregates / non-Copy owners are deferred; references are forbidden
    /// across a suspend entirely — see §4.)
    zeroable_kind(&this, k: TypeKind) -> boolean {
        return k == TypeKind::Int || k == TypeKind::Bool
            || k == TypeKind::Float || k == TypeKind::Pointer;
    }

    /// A zero value of `field_ty` for the constructor. The promoted field is
    /// always written (`this.x = x`) before any read, so this initial value is
    /// never observed — it exists only to satisfy "all fields initialized".
    zero_value(&this, field_ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        const t: Type* = this.arena.lookup(field_ty.id);
        const k: TypeKind = if (t != null) { t.kind } else { TypeKind::Error };
        mut lit: LiteralNode* = null;
        if (k == TypeKind::Bool) {
            lit = new LiteralNode("false", LiteralKind::Boolean, span);
        } else if (k == TypeKind::Float) {
            lit = new LiteralNode("0.0", LiteralKind::Float, span);
        } else if (k == TypeKind::Pointer) {
            lit = new LiteralNode("null", LiteralKind::Null, span);
        } else {
            lit = new LiteralNode("0", LiteralKind::Integer, span);
        }
        lit.set_resolved_type(field_ty);
        return lit as ExpressionNode*;
    }

    // ---- state-machine builder (recursive; awaits across straight-line + if/else) ----

    /// Allocate a fresh empty state block; return its index (== its state value).
    sm_alloc(mut &this, sm: PollSm*) -> i64 {
        const idx: i64 = sm.blocks.length;
        sm.blocks.push(new BlockStmtNode(sm.span));
        return idx;
    }

    /// Append `this.state = <to>;` to state block `from` — a forward edge: the
    /// arm falls off and the enclosing loop re-dispatches the advanced state.
    sm_goto(mut &this, sm: PollSm*, from: i64, to: i64) -> void {
        sm.blocks[from].add_statement(this.assign_member_stmt(
            sm.struct_ref, sm.state_sym, sm.u32_ty, this.u32_lit(to as u64, sm.span), sm.span));
    }

    /// Lower every statement of `blk` starting in state `cur`; return the state
    /// execution continues in after the block.
    lower_block_sm(mut &this, sm: PollSm*, blk: BlockStmtNode*, cur: i64) -> i64 {
        mut s: i64 = cur;
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            if (!sm.ok) { return s; }
            const st: StatementNode* = blk.statements[i];
            s = this.lower_stmt_sm(sm, st, s);
            // A `return`/`break`/`continue` transfers control off this block; a
            // following statement (unreachable source) would otherwise be emitted
            // AFTER the edge assignment and silently run before the arm falls off.
            if (this.stmt_diverges(st)) { return s; }
        }
        return s;
    }

    /// Lower a branch body (a block, or a bare statement / else-if) starting in
    /// state `entry`; return its end state.
    lower_branch_sm(mut &this, sm: PollSm*, branch: StatementNode*, entry: i64) -> i64 {
        if (branch == null) { return entry; }
        if (branch.kind == NodeKind::BlockStatement) {
            return this.lower_block_sm(sm, branch as BlockStmtNode*, entry);
        }
        return this.lower_stmt_sm(sm, branch, entry);
    }

    /// Lower a single statement. await-free -> emit as-is (returns wrapped in
    /// `Poll::Ready`); a top-level `await` carrier or an `if` holding an `await`
    /// -> explode into states; any other await-carrying shape (nested in an
    /// expression, or inside a loop or `match`) -> E0600 (a later increment).
    lower_stmt_sm(mut &this, sm: PollSm*, stmt: StatementNode*, cur: i64) -> i64 {
        if (stmt == null) { return cur; }
        const k: NodeKind = stmt.kind;
        if (k == NodeKind::BreakStatement)    { return this.lower_break_sm(sm, cur, stmt.span); }
        if (k == NodeKind::ContinueStatement) { return this.lower_continue_sm(sm, cur, stmt.span); }
        if (!this.stmt_needs_explode(stmt)) {
            this.rewrite_returns(stmt, sm.poll_out, sm.span);
            sm.blocks[cur].add_statement(stmt);
            return cur;
        }
        const aw: AwaitExprNode* = this.stmt_toplevel_await(stmt);
        if (aw != null) { return this.lower_carrier_sm(sm, stmt, aw, cur); }
        if (k == NodeKind::IfStatement)      { return this.lower_if_sm(sm, stmt as IfStmtNode*, cur); }
        if (k == NodeKind::WhileStatement)   { return this.lower_while_sm(sm, stmt as WhileStmtNode*, cur); }
        if (k == NodeKind::DoWhileStatement) { return this.lower_do_while_sm(sm, stmt as DoWhileStmtNode*, cur); }
        if (k == NodeKind::ForStatement)     { return this.lower_for_sm(sm, stmt as ForStmtNode*, cur); }
        if (k == NodeKind::LoopStatement)    { return this.lower_loop_sm(sm, stmt as LoopStmtNode*, cur); }
        this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
            "async: this `await` shape is not supported yet; write it as `const x = await e;` / `return await e;` / `await e;`, inside an `if`/`else` branch, or inside a `while`/`for`/`loop`/`do-while` body (an `await` nested in an expression, or inside a `match` arm, arrives in a later increment)",
            stmt.span);
        sm.ok = false;
        return cur;
    }

    /// Lower a top-level `await` carrier (`const/mut x = await e;`,
    /// `return await e;`, `await e;`): stash the sub-future in `cur`, allocate a
    /// resume state that polls it (suspending on `Pending`, re-entering itself),
    /// and run the carrier there with its `await` replaced by the ready result.
    lower_carrier_sm(mut &this, sm: PollSm*, stmt: StatementNode*, aw: AwaitExprNode*, cur: i64) -> i64 {
        const span: SourceSpan = sm.span;
        if (aw.operand == null) {
            this.ctx.emit_error_at(ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
                "async: malformed `await` (no operand)", span);
            sm.ok = false; return cur;
        }
        const fi: TypeRef = aw.operand.resolved_type;
        const ao: TypeRef = aw.resolved_type;
        if (!fi.is_valid() || !ao.is_valid()) {
            this.ctx.emit_error_at(ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
                "async: could not resolve an awaited future's type (its operand must implement `Future`)", span);
            sm.ok = false; return cur;
        }
        const k: i64 = sm.naw;
        sm.naw += 1i64;
        const fut_sym: SymbolStr = this.intern.intern(format("fut_%lld", k));
        mut opt_args: TypeRef[] = [fi];
        const fut_opt: TypeRef = this.ctx.generic_registry.instantiate(sm.opt_base, &opt_args);
        sm.fut_syms.push(fut_sym);
        sm.fut_opt.push(fut_opt);

        // In `cur`: build the sub-future lazily, then advance to the resume state.
        sm.blocks[cur].add_statement(this.assign_member_stmt(sm.struct_ref, fut_sym, fut_opt,
            this.option_some(aw.operand, fut_opt, span), span));
        const resume: i64 = this.sm_alloc(sm);
        this.sm_goto(sm, cur, resume);

        // Resume state: take/poll the sub-future; on `Pending` put it back, mark
        // this state, and suspend; else bind the ready value and run the carrier.
        const sub_sym: SymbolStr = this.intern.intern(format("__sub_%lld", k));
        mut take_call: ExpressionNode* = this.method_call0(
            this.member(this.this_ident(sm.struct_ref, span), fut_sym, fut_opt, span),
            "take", fut_opt, span);
        mut unwrap_call: ExpressionNode* = this.method_call0(take_call, "unwrap", fi, span);
        sm.blocks[resume].add_statement(this.var_decl_stmt(sub_sym, true, fi, unwrap_call, span));

        const poll_sym: SymbolStr = this.intern.intern(format("__poll_%lld", k));
        mut poll_call: ExpressionNode* = this.method_call1(
            this.ident(sub_sym, fi, span), "poll",
            this.ident(sm.cx_sym, sm.ctx_ptr_ty, span), sm.poll_out, span);
        sm.blocks[resume].add_statement(this.var_decl_stmt(poll_sym, true, sm.poll_out, poll_call, span));

        mut pend: BlockStmtNode* = new BlockStmtNode(span);
        pend.add_statement(this.assign_member_stmt(sm.struct_ref, fut_sym, fut_opt,
            this.option_some(this.ident(sub_sym, fi, span), fut_opt, span), span));
        pend.add_statement(this.assign_member_stmt(sm.struct_ref, sm.state_sym, sm.u32_ty,
            this.u32_lit(resume as u64, span), span));
        pend.add_statement(new ReturnStmtNode(this.poll_pending(sm.poll_out, span), span) as StatementNode*);
        sm.blocks[resume].add_statement(new IfStmtNode(
            this.method_call0(this.ident(poll_sym, sm.poll_out, span), "is_pending", this.arena.get_bool(), span),
            pend as StatementNode*, null, span) as StatementNode*);

        const await_sym: SymbolStr = this.intern.intern(format("__await_%lld", k));
        sm.blocks[resume].add_statement(this.var_decl_stmt(await_sym, false, ao,
            this.method_call0(this.ident(poll_sym, sm.poll_out, span), "into_ready", ao, span), span));

        this.rewrite_carrier_await(stmt, this.ident(await_sym, ao, span));
        this.rewrite_returns(stmt, sm.poll_out, span);
        sm.blocks[resume].add_statement(stmt);
        return resume;
    }

    /// Lower an `if`/`else` whose branches contain `await`s: the condition (in
    /// `cur`) dispatches to a per-branch entry state; each branch runs as its own
    /// state sequence and, unless it returns, converges on a shared join state.
    lower_if_sm(mut &this, sm: PollSm*, iff: IfStmtNode*, cur: i64) -> i64 {
        const span: SourceSpan = sm.span;
        if (this.expr_await_count(iff.condition) > 0i64) {
            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                "async: an `await` in an `if` condition is not supported; bind it first (`const c = await e; if (c) { … }`)",
                span);
            sm.ok = false; return cur;
        }
        const then_entry: i64 = this.sm_alloc(sm);
        mut else_entry: i64 = -1i64;
        if (iff.else_stmt != null) { else_entry = this.sm_alloc(sm); }
        const join: i64 = this.sm_alloc(sm);

        // `cur`: evaluate the condition and set the taken branch's entry state
        // (or the join directly when there is no else), then fall off to
        // re-dispatch. Both arms assign, so `cur` always advances.
        mut then_set: BlockStmtNode* = new BlockStmtNode(span);
        then_set.add_statement(this.assign_member_stmt(sm.struct_ref, sm.state_sym, sm.u32_ty,
            this.u32_lit(then_entry as u64, span), span));
        const else_target: i64 = if (else_entry >= 0i64) { else_entry } else { join };
        mut else_set: BlockStmtNode* = new BlockStmtNode(span);
        else_set.add_statement(this.assign_member_stmt(sm.struct_ref, sm.state_sym, sm.u32_ty,
            this.u32_lit(else_target as u64, span), span));
        sm.blocks[cur].add_statement(new IfStmtNode(iff.condition,
            then_set as StatementNode*, else_set as StatementNode*, span) as StatementNode*);

        // Whether a branch converges on the join is a property of the SOURCE
        // branch (does it end in a `return`/`break`/`continue`?), not of the
        // lowered block: a branch ending in `break` leaves its final state block
        // holding a `this.state = <after>;` edge, which is not a divergence marker.
        const t_end: i64 = this.lower_branch_sm(sm, iff.then_stmt, then_entry);
        if (!sm.ok) { return cur; }
        if (!this.stmt_diverges(iff.then_stmt)) { this.sm_goto(sm, t_end, join); }
        if (else_entry >= 0i64) {
            const e_end: i64 = this.lower_branch_sm(sm, iff.else_stmt, else_entry);
            if (!sm.ok) { return cur; }
            if (!this.stmt_diverges(iff.else_stmt)) { this.sm_goto(sm, e_end, join); }
        }
        return join;
    }

    /// Append `if (<cond>) { this.state = <t>; } else { this.state = <f>; }` to
    /// state block `from` — a two-way state dispatch (a loop header's test, a
    /// `do-while`'s tail test). The arm falls off after the assignment and the
    /// enclosing loop re-dispatches the chosen state.
    emit_cond_dispatch(mut &this, sm: PollSm*, from: i64, cond: ExpressionNode*,
                       t: i64, f: i64, span: SourceSpan) -> void {
        mut then_set: BlockStmtNode* = new BlockStmtNode(span);
        then_set.add_statement(this.assign_member_stmt(sm.struct_ref, sm.state_sym, sm.u32_ty,
            this.u32_lit(t as u64, span), span));
        mut else_set: BlockStmtNode* = new BlockStmtNode(span);
        else_set.add_statement(this.assign_member_stmt(sm.struct_ref, sm.state_sym, sm.u32_ty,
            this.u32_lit(f as u64, span), span));
        sm.blocks[from].add_statement(new IfStmtNode(cond,
            then_set as StatementNode*, else_set as StatementNode*, span) as StatementNode*);
    }

    /// `break` -> jump to the innermost exploded loop's after state; `continue`
    /// -> jump to its continue target (a `while`/`loop` header, a `for` update
    /// state, a `do-while` tail test). A native `break`/`continue` would break
    /// the dispatch `loop`/`match`, so these lower to `this.state = <target>;`.
    lower_break_sm(mut &this, sm: PollSm*, cur: i64, span: SourceSpan) -> i64 {
        if (sm.loop_brk.length == 0i64) {
            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                "async: `break` outside a loop", span);
            sm.ok = false; return cur;
        }
        this.sm_goto(sm, cur, sm.loop_brk[sm.loop_brk.length - 1i64]);
        return cur;
    }

    lower_continue_sm(mut &this, sm: PollSm*, cur: i64, span: SourceSpan) -> i64 {
        if (sm.loop_cont.length == 0i64) {
            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                "async: `continue` outside a loop", span);
            sm.ok = false; return cur;
        }
        this.sm_goto(sm, cur, sm.loop_cont[sm.loop_cont.length - 1i64]);
        return cur;
    }

    /// `loop { body }` -> a body-entry state whose back-edge returns to itself
    /// (an infinite loop; `break` exits to the after state, `continue` re-enters
    /// the body). A suspend inside the body splits it into further states; the
    /// back-edge re-dispatches the body from the top each iteration.
    lower_loop_sm(mut &this, sm: PollSm*, lp: LoopStmtNode*, cur: i64) -> i64 {
        const body_entry: i64 = this.sm_alloc(sm);
        const after: i64 = this.sm_alloc(sm);
        this.sm_goto(sm, cur, body_entry);
        sm.loop_cont.push(body_entry);
        sm.loop_brk.push(after);
        const body_end: i64 = this.lower_branch_sm(sm, lp.body, body_entry);
        sm.loop_cont.pop();
        sm.loop_brk.pop();
        if (!sm.ok) { return cur; }
        if (!this.stmt_diverges(lp.body)) { this.sm_goto(sm, body_end, body_entry); }
        return after;
    }

    /// `while (cond) { body }` -> a header state that tests `cond` (dispatching to
    /// the body entry or the after state), a body sequence, and a back-edge from
    /// the body tail to the header. `continue` re-tests at the header; `break`
    /// exits to after.
    lower_while_sm(mut &this, sm: PollSm*, w: WhileStmtNode*, cur: i64) -> i64 {
        const span: SourceSpan = sm.span;
        if (this.expr_await_count(w.condition) > 0i64) {
            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                "async: an `await` in a `while` condition is not supported; bind it first (`const c = await e; while (c) { … }`)",
                span);
            sm.ok = false; return cur;
        }
        const header: i64 = this.sm_alloc(sm);
        const body_entry: i64 = this.sm_alloc(sm);
        const after: i64 = this.sm_alloc(sm);
        this.sm_goto(sm, cur, header);
        this.emit_cond_dispatch(sm, header, w.condition, body_entry, after, span);
        sm.loop_cont.push(header);
        sm.loop_brk.push(after);
        const body_end: i64 = this.lower_branch_sm(sm, w.body, body_entry);
        sm.loop_cont.pop();
        sm.loop_brk.pop();
        if (!sm.ok) { return cur; }
        if (!this.stmt_diverges(w.body)) { this.sm_goto(sm, body_end, header); }
        return after;
    }

    /// `do { body } while (cond)` -> a body-entry state (run unconditionally
    /// first), a tail-test state, and the after state. `continue` jumps to the
    /// tail test; `break` exits to after.
    lower_do_while_sm(mut &this, sm: PollSm*, d: DoWhileStmtNode*, cur: i64) -> i64 {
        const span: SourceSpan = sm.span;
        if (this.expr_await_count(d.condition) > 0i64) {
            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                "async: an `await` in a `do-while` condition is not supported; bind it first",
                span);
            sm.ok = false; return cur;
        }
        const body_entry: i64 = this.sm_alloc(sm);
        const cond_state: i64 = this.sm_alloc(sm);
        const after: i64 = this.sm_alloc(sm);
        this.sm_goto(sm, cur, body_entry);
        sm.loop_cont.push(cond_state);
        sm.loop_brk.push(after);
        const body_end: i64 = this.lower_branch_sm(sm, d.body, body_entry);
        sm.loop_cont.pop();
        sm.loop_brk.pop();
        if (!sm.ok) { return cur; }
        if (!this.stmt_diverges(d.body)) { this.sm_goto(sm, body_end, cond_state); }
        this.emit_cond_dispatch(sm, cond_state, d.condition, body_entry, after, span);
        return after;
    }

    /// `for (init; cond; update) { body }` -> lower `init` into the current
    /// state, then a header (test `cond`), a body sequence, an update state, and
    /// the after state. `continue` jumps to the update; `break` exits to after.
    /// A null `cond` means "always enter the body" (an infinite `for (;;)`).
    lower_for_sm(mut &this, sm: PollSm*, f: ForStmtNode*, cur: i64) -> i64 {
        const span: SourceSpan = sm.span;
        if (this.expr_await_count(f.condition) > 0i64 || this.expr_await_count(f.update) > 0i64) {
            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                "async: an `await` in a `for` condition or update expression is not supported; restructure the loop",
                span);
            sm.ok = false; return cur;
        }
        mut s0: i64 = cur;
        if (f.init != null) {
            if (this.expr_await_count(this.for_init_expr(f)) > 0i64) {
                this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                    "async: an `await` in a `for` initializer is not supported; bind it before the loop",
                    span);
                sm.ok = false; return cur;
            }
            if ((f.init as ASTNode*).kind == NodeKind::VariableDeclaration) {
                mut ds: DeclStmtNode* = new DeclStmtNode(f.init as DeclarationNode*, span);
                s0 = this.lower_stmt_sm(sm, ds as StatementNode*, s0);
            } else {
                mut es: ExprStmtNode* = new ExprStmtNode(f.init as ExpressionNode*, span);
                s0 = this.lower_stmt_sm(sm, es as StatementNode*, s0);
            }
            if (!sm.ok) { return cur; }
        }
        const header: i64 = this.sm_alloc(sm);
        const body_entry: i64 = this.sm_alloc(sm);
        const update_state: i64 = this.sm_alloc(sm);
        const after: i64 = this.sm_alloc(sm);
        this.sm_goto(sm, s0, header);
        if (f.condition != null) {
            this.emit_cond_dispatch(sm, header, f.condition, body_entry, after, span);
        } else {
            this.sm_goto(sm, header, body_entry);
        }
        sm.loop_cont.push(update_state);
        sm.loop_brk.push(after);
        const body_end: i64 = this.lower_branch_sm(sm, f.body, body_entry);
        sm.loop_cont.pop();
        sm.loop_brk.pop();
        if (!sm.ok) { return cur; }
        if (!this.stmt_diverges(f.body)) { this.sm_goto(sm, body_end, update_state); }
        if (f.update != null) {
            sm.blocks[update_state].add_statement(new ExprStmtNode(f.update, span) as StatementNode*);
        }
        this.sm_goto(sm, update_state, header);
        return after;
    }

    /// The `for` initializer's initializer expression (for the await check), or
    /// null when the init is absent or a bare expression with no sub-await.
    for_init_expr(&this, f: ForStmtNode*) -> ExpressionNode* {
        if (f.init == null) { return null; }
        if ((f.init as ASTNode*).kind == NodeKind::VariableDeclaration) {
            return (f.init as VarDeclNode*).initializer;
        }
        return f.init as ExpressionNode*;
    }

    /// True if the statement never falls through to whatever follows it, so a
    /// following state transition (a branch join, a loop back-edge, or the rest
    /// of a block) would be unreachable and must be suppressed. Structural over
    /// `return` / `break` / `continue` (all transfer control elsewhere), a
    /// block-tail, a both-arm `if`, and an infinite `loop` (no `break`).
    stmt_diverges(&this, stmt: StatementNode*) -> boolean {
        if (stmt == null) { return false; }
        const k: NodeKind = stmt.kind;
        if (k == NodeKind::ReturnStatement) { return true; }
        if (k == NodeKind::BreakStatement || k == NodeKind::ContinueStatement) { return true; }
        if (k == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = stmt as BlockStmtNode*;
            if (blk.statements.length == 0i64) { return false; }
            return this.stmt_diverges(blk.statements[blk.statements.length - 1i64]);
        }
        if (k == NodeKind::IfStatement) {
            const iff: IfStmtNode* = stmt as IfStmtNode*;
            if (iff.else_stmt == null) { return false; }
            return this.stmt_diverges(iff.then_stmt) && this.stmt_diverges(iff.else_stmt);
        }
        if (k == NodeKind::LoopStatement) {
            // A `loop {}` exits only via a `break` targeting it; with none, it is
            // an infinite loop and control never reaches the following statement.
            return !this.has_free_break((stmt as LoopStmtNode*).body);
        }
        return false;
    }

    block_diverges(&this, blk: BlockStmtNode*) -> boolean {
        if (blk == null || blk.statements.length == 0i64) { return false; }
        return this.stmt_diverges(blk.statements[blk.statements.length - 1i64]);
    }

    /// True if `stmt` holds a `break`/`continue` that targets the ENCLOSING loop
    /// (i.e. one not captured by a loop nested inside `stmt`). Used to decide
    /// whether an otherwise await-free statement must still be exploded into
    /// states (its edge cannot stay a native `break`, which would break the
    /// dispatch `loop`/`match`), and — restricted to `break` — whether a `loop {}`
    /// is infinite. Does NOT descend into nested loops (they capture their own).
    has_free_edge(&this, stmt: StatementNode*, break_only: boolean) -> boolean {
        if (stmt == null) { return false; }
        const k: NodeKind = stmt.kind;
        if (k == NodeKind::BreakStatement) { return true; }
        if (k == NodeKind::ContinueStatement) { return !break_only; }
        if (k == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = stmt as BlockStmtNode*;
            for (mut i: i64 = 0; i < blk.statements.length; i++) {
                if (this.has_free_edge(blk.statements[i], break_only)) { return true; }
            }
            return false;
        }
        if (k == NodeKind::IfStatement) {
            const iff: IfStmtNode* = stmt as IfStmtNode*;
            return this.has_free_edge(iff.then_stmt, break_only)
                || this.has_free_edge(iff.else_stmt, break_only);
        }
        if (k == NodeKind::MatchStatement) {
            const m: MatchStmtNode* = stmt as MatchStmtNode*;
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                if (m.arms[i] != null && this.has_free_edge(m.arms[i].body, break_only)) { return true; }
            }
            return false;
        }
        // While/For/Loop/DoWhile capture their own break/continue — not free here.
        return false;
    }

    has_free_break(&this, stmt: StatementNode*) -> boolean {
        return this.has_free_edge(stmt, true);
    }

    has_free_break_continue(&this, stmt: StatementNode*) -> boolean {
        return this.has_free_edge(stmt, false);
    }

    /// A statement must be lowered into states (rather than emitted wholesale into
    /// the current state) if it contains an `await` OR a `break`/`continue` that
    /// targets an enclosing exploded loop.
    stmt_needs_explode(&this, stmt: StatementNode*) -> boolean {
        return this.stmt_await_count(stmt) > 0i64 || this.has_free_break_continue(stmt);
    }

    // ---- cross-state local promotion (build-then-scan) ----

    /// True if `name` is read in any top-level statement of `blk`.
    block_reads_name(&this, blk: BlockStmtNode*, name: SymbolStr) -> boolean {
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            if (this.name_read_in_stmt(blk.statements[i], name)) { return true; }
        }
        return false;
    }

    /// Prepend `const <name> = this.<field>;` to `blk` so reads of a promoted
    /// local resolve to the reloaded value rather than the out-of-scope binding.
    prepend_load(mut &this, blk: BlockStmtNode*, name: SymbolStr, field: SymbolStr,
                 ty: TypeRef, struct_ref: TypeRef, span: SourceSpan) -> void {
        mut ld: ExpressionNode* = this.member(this.this_ident(struct_ref, span), field, ty, span);
        mut rebuilt: StatementNode*[] = [this.var_decl_stmt(name, false, ty, ld, span)];
        for (mut i: i64 = 0; i < blk.statements.length; i++) { rebuilt.push(blk.statements[i]); }
        blk.statements = rebuilt;
    }

    /// Replace the `mut <name> = <init>;` declaration (located by node identity in
    /// state block `ds`) with `this.<field> = <init>;`, so the promoted field —
    /// not a stack local — receives the value. A declaration with no initializer
    /// is dropped: the constructor already zero-initialized the field.
    rewrite_mut_decl(mut &this, sm: PollSm*, ds: i64, vd: VarDeclNode*,
                     field: SymbolStr, lty: TypeRef) -> void {
        const span: SourceSpan = sm.span;
        const blk: BlockStmtNode* = sm.blocks[ds];
        mut rebuilt: StatementNode*[] = [];
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            const s: StatementNode* = blk.statements[i];
            if (this.stmt_decl_var(s) == vd) {
                if (vd.initializer != null) {
                    rebuilt.push(this.assign_member_stmt(sm.struct_ref, field, lty, vd.initializer, span));
                }
            } else {
                rebuilt.push(s);
            }
        }
        blk.statements = rebuilt;
    }

    /// After the state blocks are built, promote every top-level local read in a
    /// state other than the one it is declared in to a struct field: a value
    /// cannot live on the native stack across a suspend. The store goes at the
    /// end of the declaring block (it still runs before that block falls off);
    /// a `const <name> = this.<field>;` load is prepended to every other block
    /// that reads it. References across a suspend are forbidden (E0455); `mut` /
    /// aggregate locals across a suspend are deferred with a loud diagnostic.
    promote_cross_state(mut &this, sm: PollSm*) -> void {
        const span: SourceSpan = sm.span;
        mut d_names: SymbolStr[] = [];
        mut d_states: i64[] = [];
        mut d_nodes: VarDeclNode*[] = [];
        for (mut b: i64 = 0; b < sm.blocks.length; b++) {
            const blk: BlockStmtNode* = sm.blocks[b];
            for (mut i: i64 = 0; i < blk.statements.length; i++) {
                const vd: VarDeclNode* = this.stmt_decl_var(blk.statements[i]);
                if (vd != null) { d_names.push(vd.name); d_states.push(b); d_nodes.push(vd); }
            }
        }

        for (mut d: i64 = 0; d < d_names.length; d++) {
            const nm: SymbolStr = d_names[d];
            const ds: i64 = d_states[d];
            const vd: VarDeclNode* = d_nodes[d];

            mut cross: boolean = false;
            for (mut b: i64 = 0; b < sm.blocks.length; b++) {
                if (b != ds && this.block_reads_name(sm.blocks[b], nm)) { cross = true; }
            }
            if (!cross) { continue; }

            const lty: TypeRef = vd.resolved_type;
            const lt: Type* = this.arena.lookup(lty.id);
            const lk: TypeKind = if (lt != null) { lt.kind } else { TypeKind::Error };
            if (lk == TypeKind::Reference) {
                this.ctx.emit_error_at(ErrorCode::E0455_DANGLING_POINTER,
                    "async: a reference cannot be held live across an `await` (owned values only); a suspended future may outlive the referent",
                    vd.span);
                sm.ok = false; return;
            }
            if (!this.zeroable_kind(lk)) {
                this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                    "async: only a scalar (integer/bool/float/pointer) local may currently be held across an `await`; carrying an aggregate across a suspend arrives in a later increment",
                    vd.span);
                sm.ok = false; return;
            }

            if (vd.is_mutable) {
                // A `mut` value written across states cannot live on the native
                // stack (each state re-enters `poll` afresh), and the const
                // store/load model would leave stale copies diverging from later
                // writes. Promote to a field that is the SINGLE source of truth:
                // replace the declaration with a field store and rewrite every
                // read AND write of the name to `this.<field>` in place. A by-name
                // rewrite is ambiguous if the name is re-declared in another state,
                // so reject that (rare) case rather than conflate two live ranges.
                mut decl_sites: i64 = 0i64;
                for (mut d2: i64 = 0; d2 < d_names.length; d2++) {
                    if (d_names[d2].equals(nm)) { decl_sites += 1i64; }
                }
                if (decl_sites > 1i64) {
                    this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                        "async: a `mut` local whose name is re-declared in another state cannot be carried across an `await`; rename one of them",
                        vd.span);
                    sm.ok = false; return;
                }
                const mfield: SymbolStr = this.intern.intern(
                    format("__mut_%lld_%s", ds, this.intern.resolve(nm)));
                this.rewrite_mut_decl(sm, ds, vd, mfield, lty);
                for (mut b: i64 = 0; b < sm.blocks.length; b++) {
                    const blk2: BlockStmtNode* = sm.blocks[b];
                    for (mut i: i64 = 0; i < blk2.statements.length; i++) {
                        this.subst_name_stmt(blk2.statements[i], nm, mfield, sm.struct_ref, lty, span);
                    }
                }
                sm.prom_field.push(mfield);
                sm.prom_tys.push(lty);
                sm.nprom += 1i64;
                continue;
            }

            // A const scalar is written once, so a copy per reader is sound: keep
            // the local, store its value at the end of the declaring block, and
            // reload it at the top of every other block that reads it.
            const field: SymbolStr = this.intern.intern(
                format("__cross_%lld_%s", ds, this.intern.resolve(nm)));
            sm.blocks[ds].add_statement(this.assign_member_stmt(
                sm.struct_ref, field, lty, this.ident(nm, lty, span), span));
            for (mut b: i64 = 0; b < sm.blocks.length; b++) {
                if (b != ds && this.block_reads_name(sm.blocks[b], nm)) {
                    this.prepend_load(sm.blocks[b], nm, field, lty, sm.struct_ref, span);
                }
            }
            sm.prom_field.push(field);
            sm.prom_tys.push(lty);
            sm.nprom += 1i64;
        }
    }

    /// Build the state-machine `poll` body for a body with >= 1 `await`: the
    /// arg-shadow prelude, then `loop { match (this.state) { i => <block i>,
    /// _ => Poll::Pending } }`. Returns null (after a diagnostic) for an
    /// unsupported await shape, a body that can fall off its end, or a
    /// `mut`/aggregate/reference held across a suspend. Populates `sm.fut_*` /
    /// `sm.prom_*`, which `lower` consumes to build the struct fields.
    build_poll_body_sm(mut &this, node: FunctionDeclNode*, sm: PollSm*) -> BlockStmtNode* {
        const span: SourceSpan = sm.span;
        mut body: BlockStmtNode* = new BlockStmtNode(span);
        this.emit_shadow_prelude(node, body, sm.struct_ref, span);

        const orig: BlockStmtNode* = node.body as BlockStmtNode*;
        const entry: i64 = this.sm_alloc(sm);   // state 0
        this.lower_block_sm(sm, orig, entry);
        if (!sm.ok) { return null; }

        // Every terminal state must return: a value async fn does (the
        // pre-lowering return check guarantees it), but a body that can fall off
        // its end (implicit unit return) would spin the dispatch loop or re-poll
        // a taken sub-future, so reject it rather than miscompile.
        if (!this.stmt_diverges(orig as StatementNode*)) {
            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                "async: an `async function` with `await`s must return on every path; a body that falls off its end (implicit unit return) is not yet supported here",
                span);
            return null;
        }

        this.promote_cross_state(sm);
        if (!sm.ok) { return null; }

        // Assemble `loop { match (this.state) { i => <block i>, _ => Pending } }`.
        mut dispatch: MatchStmtNode* = new MatchStmtNode(
            this.member(this.this_ident(sm.struct_ref, span), sm.state_sym, sm.u32_ty, span), span);
        for (mut i: i64 = 0; i < sm.blocks.length; i++) {
            dispatch.add_arm(this.match_arm_int(i as u64, sm.blocks[i], span));
        }
        mut wblk: BlockStmtNode* = new BlockStmtNode(span);
        wblk.add_statement(new ReturnStmtNode(this.poll_pending(sm.poll_out, span), span) as StatementNode*);
        dispatch.add_arm(this.match_arm_wild(wblk, span));

        mut loop_body: BlockStmtNode* = new BlockStmtNode(span);
        loop_body.add_statement(dispatch as StatementNode*);
        body.add_statement(new LoopStmtNode(loop_body as StatementNode*, span) as StatementNode*);
        return body;
    }

    /// The lowering entry: gate on `node.is_async && !node.is_generic()` at the
    /// call site. Synthesizes the future struct + `Future` impl, registers them,
    /// and rewrites `node` into the constructor.
    lower(mut &this, node: FunctionDeclNode*) -> void {
        if (node == null || node.body == null) { return; }
        const output_ref: TypeRef = node.resolved_return_type;
        if (!output_ref.is_valid()) { return; }

        // Future core types require the module to import them.
        const poll_base: TypeRef = this.lookup_future_type("Poll");
        const ctx_ref:   TypeRef = this.lookup_future_type("Context");
        if (!poll_base.is_valid() || !ctx_ref.is_valid()) {
            this.ctx.emit_error_at(ErrorCode::E0233_UNDEFINED_SYMBOL,
                "an `async function` requires the future types in scope; add `import std::future;`",
                node.span);
            return;
        }

        const span: SourceSpan = node.span;
        const module_sym: SymbolStr = this.intern.intern(this.ctx.source_file);
        const bare: SymbolStr = this.mint_bare(this.intern.resolve(node.name));
        const q_name: SymbolStr = this.ctx.qualify_symbol_sym(bare);

        const state_sym: SymbolStr = this.intern.intern("state");
        const u32_ty: TypeRef = this.arena.get_u32();

        mut poll_args: TypeRef[] = [output_ref];
        const poll_out: TypeRef = this.ctx.generic_registry.instantiate(poll_base, &poll_args);
        const ctx_ptr_ty: TypeRef = this.arena.get_pointer_to(ctx_ref);

        // The future struct's TypeRef is needed by the poll-body build (its
        // `this.<field>` accesses); its FIELDS are set only afterwards, once the
        // build has discovered the sub-future + promoted-local inventory.
        const struct_ref: TypeRef = this.arena.create_struct(q_name, module_sym);

        // ---- 0. poll body ----
        // No await => run to completion in one poll (Inc 1b). Otherwise the
        // recursive builder emits `loop { match (this.state) {…} }`, recording one
        // `fut_k: Option<F_k>` sub-future per await and one field per promoted
        // cross-state scalar local into `sm`.
        const total_await: i64 = if (node.body.kind == NodeKind::BlockStatement) {
            this.block_await_count(node.body as BlockStmtNode*)
        } else { 0i64 };

        mut sm: PollSm = PollSm {
            struct_ref: struct_ref, poll_out: poll_out, ctx_ptr_ty: ctx_ptr_ty,
            state_sym: state_sym, u32_ty: u32_ty, cx_sym: this.intern.intern("cx"),
            opt_base: TypeRef::invalid(), span: span,
            blocks: [], ok: true,
            fut_syms: [], fut_opt: [], naw: 0i64,
            prom_field: [], prom_tys: [], nprom: 0i64,
            loop_cont: [], loop_brk: [],
        };

        mut body_block: BlockStmtNode* = null;
        if (total_await > 0i64) {
            sm.opt_base = this.lookup_future_type("Option");
            if (!sm.opt_base.is_valid()) {
                this.ctx.emit_error_at(ErrorCode::E0233_UNDEFINED_SYMBOL,
                    "async: `Option` must be in scope to lower `await`", span);
                return;
            }
            body_block = this.build_poll_body_sm(node, &sm);
        } else {
            body_block = this.build_poll_body_no_await(node, struct_ref, poll_out, span);
        }
        if (body_block == null) { return; }   // a diagnostic was already emitted

        // ---- 1. Struct decl fields (state + params + sub-futures + promoted) ----
        mut struct_decl: StructDeclNode* = new StructDeclNode(q_name, span);
        struct_decl.repr_c = false;
        struct_decl.repr_packed = false;
        struct_decl.repr_transparent = false;
        struct_decl.min_alignment = 0;

        mut state_field: FieldDeclNode* = new FieldDeclNode(state_sym, span);
        state_field.set_visibility(Visibility::Public);
        state_field.set_resolved_type(u32_ty);
        struct_decl.add_field(state_field);

        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            const p: VarDeclNode* = node.parameters[i];
            if (p == null || !p.resolved_type.is_valid()) { continue; }
            mut f: FieldDeclNode* = new FieldDeclNode(p.name, span);
            f.set_visibility(Visibility::Public);
            f.set_resolved_type(p.resolved_type);
            struct_decl.add_field(f);
        }
        // One sub-future field per await (`Option::None` until built lazily on
        // first entry to its resume state) so the machine can suspend/resume.
        for (mut i: i64 = 0; i < sm.naw; i++) {
            mut ff: FieldDeclNode* = new FieldDeclNode(sm.fut_syms[i], span);
            ff.set_visibility(Visibility::Public);
            ff.set_resolved_type(sm.fut_opt[i]);
            struct_decl.add_field(ff);
        }
        // One field per promoted cross-state local (a value read in a state other
        // than the one declaring it cannot live on the native stack).
        for (mut i: i64 = 0; i < sm.nprom; i++) {
            mut pf: FieldDeclNode* = new FieldDeclNode(sm.prom_field[i], span);
            pf.set_visibility(Visibility::Public);
            pf.set_resolved_type(sm.prom_tys[i]);
            struct_decl.add_field(pf);
        }

        // ---- 2. Arena StructType + FieldInfo (mirrors the decl fields) ----
        const struct_t: Type* = this.arena.lookup(struct_ref.id);
        if (struct_t != null && struct_t.kind == TypeKind::Struct) {
            const st: StructType* = struct_t as StructType*;
            mut infos: FieldInfo[] = [];
            infos.push(FieldInfo::new(state_sym, u32_ty, true, false, false));
            for (mut i: i64 = 0; i < node.parameters.length; i++) {
                const p: VarDeclNode* = node.parameters[i];
                if (p == null || !p.resolved_type.is_valid()) { continue; }
                infos.push(FieldInfo::new(p.name, p.resolved_type, true, false, false));
            }
            for (mut i: i64 = 0; i < sm.naw; i++) {
                infos.push(FieldInfo::new(sm.fut_syms[i], sm.fut_opt[i], true, false, false));
            }
            for (mut i: i64 = 0; i < sm.nprom; i++) {
                infos.push(FieldInfo::new(sm.prom_field[i], sm.prom_tys[i], true, false, false));
            }
            st.set_fields(infos);
        }

        // ---- 3. poll method: (mut &this, cx: Context*) -> Poll<Output> ----
        mut poll_fn: FunctionDeclNode* = new FunctionDeclNode(this.intern.intern("poll"), span);
        poll_fn.set_resolved_return_type(poll_out);
        poll_fn.set_origin_trait(this.intern.intern("Future"));
        mut cx_param: VarDeclNode* = new VarDeclNode(this.intern.intern("cx"), span);
        cx_param.set_resolved_type(ctx_ptr_ty);
        poll_fn.add_parameter(cx_param);
        poll_fn.set_body(body_block);

        mut poll_method: MethodNode* = new MethodNode(poll_fn, span);
        poll_method.set_visibility(Visibility::Public);
        poll_method.set_static(false);
        poll_method.set_sink(false);

        // StructType.methods so overload resolution sees `poll` on the receiver.
        if (struct_t != null && struct_t.kind == TypeKind::Struct) {
            const st: StructType* = struct_t as StructType*;
            mut poll_param_types: TypeRef[] = [ctx_ptr_ty];
            const poll_fn_ty: TypeRef = this.arena.get_function(poll_out, poll_param_types, false);
            const minfo: MethodInfo = MethodInfo {
                name:          this.intern.intern("poll"),
                function_type: poll_fn_ty,
                is_public:     true,
                is_protected:  false,
                is_static:     false,
                is_virtual:    false,
                is_override:   false,
                param_types:   poll_param_types,
                ast_node:      poll_method as void*,
            };
            st.add_method(minfo);
        }

        // ---- 4. `implement trait Future<Output> for struct <Q>` ----
        mut impl: ImplBlockNode* = new ImplBlockNode(q_name, span);
        mut future_named: NamedAnnotation* = new NamedAnnotation {
            name: this.intern.intern("Future"), span: span, pre_resolved: TypeRef::invalid(),
        };
        mut future_base_ann: TypeAnnotation* = new TypeAnnotation::Named(future_named);
        mut gen: GenericAnnotation* = new GenericAnnotation {
            base: future_base_ann,
            args: [this.make_type_ann(output_ref, span)],
            span: span,
        };
        impl.set_trait_annotation(new TypeAnnotation::Generic(gen));
        impl.add_assoc_binding(this.intern.intern("Output"), this.make_type_ann(output_ref, span));
        impl.add_method(poll_method);

        // ---- 5. Register struct + trait impl ----
        this.ctx.decl_index.register_type_with_module(q_name, struct_ref, module_sym);
        mut method_arr: MethodNode*[] = [poll_method];
        this.ctx.decl_index.register_methods_with_module(
            q_name, method_arr, module_sym, this.intern, this.arena);

        const future_leaf: SymbolStr = this.intern.intern("Future");
        // Dispatch key: `.poll()` resolution keys on the struct's qualified name.
        this.ctx.generic_registry.register_trait_impl(future_leaf, q_name, impl);
        // Bound-check key: `F: Future<R>` resolves via qualified-name id + leaf.
        const tgt_leaf: SymbolStr = OwnershipQuery::registry_name_of(this.arena, this.intern, struct_ref);
        const qual_id: u64 = OwnershipQuery::named_qualified_id(this.arena, this.intern, struct_ref);
        this.ctx.generic_registry.register_trait_impl_typed(future_leaf, tgt_leaf, qual_id, impl);

        // ---- 6. Inject so mono/codegen walk the struct + impl ----
        if (this.ctx.artifacts.ast.root != null) {
            this.ctx.artifacts.ast.root.add_statement(struct_decl as ASTNode*);
            this.ctx.artifacts.ast.root.add_statement(impl as ASTNode*);
        }

        // ---- 7. Rewrite the async fn into the constructor ----
        // Body: `return <Q> { state: 0, p0: p0, …, fut_k: Option::None, … };`
        mut ctor_lit: StructLiteralNode* = new StructLiteralNode(q_name, span);
        mut zero: LiteralNode* = new LiteralNode("0", LiteralKind::Integer, span);
        zero.set_resolved_type(u32_ty);
        ctor_lit.add_field_init(FieldInit { field_name: state_sym, value: zero as ExpressionNode*, span: span });
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            const p: VarDeclNode* = node.parameters[i];
            if (p == null || !p.resolved_type.is_valid()) { continue; }
            mut pid: IdentifierNode* = new IdentifierNode(p.name, span);
            pid.set_resolved_type(p.resolved_type);
            ctor_lit.add_field_init(FieldInit { field_name: p.name, value: pid as ExpressionNode*, span: span });
        }
        // Each sub-future starts empty (built lazily on first entry to its resume
        // state); each promoted field starts zero (always written before read).
        for (mut i: i64 = 0; i < sm.naw; i++) {
            ctor_lit.add_field_init(FieldInit {
                field_name: sm.fut_syms[i], value: this.option_none(sm.fut_opt[i], span), span: span });
        }
        for (mut i: i64 = 0; i < sm.nprom; i++) {
            ctor_lit.add_field_init(FieldInit {
                field_name: sm.prom_field[i], value: this.zero_value(sm.prom_tys[i], span), span: span });
        }
        ctor_lit.set_resolved_type(struct_ref);
        mut ret: ReturnStmtNode* = new ReturnStmtNode(ctor_lit as ExpressionNode*, span);
        mut new_body: BlockStmtNode* = new BlockStmtNode(span);
        new_body.add_statement(ret as StatementNode*);

        node.set_body(new_body);
        node.set_resolved_return_type(struct_ref);
        node.set_return_type_annotation(this.make_type_ann(struct_ref, span));
        node.set_async(false);

        // Re-register the now-future return type so callers of `<name>(...)`
        // resolve to the state-machine struct, not the old Output. Drop the stale
        // Output-return overload first (bare + qualified) so the struct-return
        // signature is the sole overload at call sites.
        this.ctx.decl_index.reset_function_overloads(node.name);
        this.ctx.decl_index.reset_function_overloads(this.ctx.qualify_symbol_sym(node.name));
        TypeResolutionPasses::register_decl_in_index(node as ASTNode*, this.ctx, false, module_sym);
    }
}
