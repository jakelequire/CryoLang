/// AsyncLower
///
/// Lowers a non-generic `async function` into a poll-driven state machine: a
/// synthesized struct (the function's parameters as captured fields + a `state`
/// discriminant) that implements `std::future::traits::Future`, plus a rewrite
/// of the original function into a constructor returning that struct. The
/// original body moves into the generated `poll` method with every `return E`
/// rewritten to `return Poll::Ready(E)`.
///
/// Increment 1b handles the NO-AWAIT case: the body runs to completion in a
/// single `poll`, so no `switch (state)` resume dispatcher is emitted yet.
/// `await` suspend states, cross-await local promotion, and the resumable
/// switch arrive in later increments.
///
/// Mirrors LambdaSynth's synthesize + register + inject machinery (a closure
/// struct + `__call__`), adding the trait-impl registration a closure omits: the
/// generated struct must formally implement `Future` so `block_on<F,R> where
/// F: Future<R>` binds and `.poll()` dispatches. The two trait-registry keys are
/// registered directly (dispatch keys on the struct's qualified name; the bound
/// check on its qualified-name id), avoiding the DeclCollection/TypeResolution
/// funnels whose target-name qualification assumes a parser-bare target.
namespace Compiler::Sema::AsyncLower;

import Compiler::Types::{ TypeRef, Type, Arena, Compound, UserDefined, Ownership, Resolver, GenericRegistry };
import Compiler::Resolver::{ SymbolStr, InternTable, QualifiedName, MangledName };
import Compiler::AST;
import Compiler::AST::{ Node, Visitor, Expression, Statement, Declaration, Pattern, Cloner };
import Compiler::Lex;
import Compiler::Diag;
import Compiler::Diag::{ Diagnostic, SourceSpan };
import Compiler::Passes::TypeResolution;
import Compiler::CompilationContext;
import Compiler::Sema::{ PatternResolver };
import std::core::{ option, mem };
import std::fmt;

/// The state-machine builder's accumulator for lowering one `async function`
/// body with >= 1 `await`. `lower` seeds the configuration; the recursive
/// builder (`build_poll_body_sm` and friends) fills `blocks` — one straight-line
/// state block per `match (this.state)` arm — plus the discovered sub-future and
/// promoted-local inventories, which `lower` then turns into the generated
/// struct's fields and constructor initializers.
///
/// A forward edge between states is a `this.state = <k>;` assignment: the arm
/// falls off and the enclosing `loop` re-dispatches the advanced state. Awaits
/// split the current state at the suspend point (a `resume` state polls the
/// stashed sub-future); an `if`/`else` holding an await dispatches to per-branch
/// entry states that converge on a join state.
type struct PollSm {
    // configuration (set by `lower`)
    struct_ref: TypeRef;
    poll_out:   TypeRef;              // `Poll<Output>` of THIS function
    poll_base:  TypeRef;              // the `Poll<>` base, for `Poll<F_k::Output>`
    ctx_ptr_ty: TypeRef;
    state_sym:  SymbolStr;
    u32_ty:     TypeRef;
    cx_sym:     SymbolStr;
    opt_base:   TypeRef;              // the `Option<>` base, for `Option<F_k>`
    span:       SourceSpan;

    // accumulated state blocks (index == state value) + a hard-error flag: an
    // unsupported await shape or an illegal cross-suspend local sets ok=false
    // and unwinds the build.
    blocks:     BlockStmtNode*[];
    ok:         boolean;

    // one `fut_k: Option<F_k>` sub-future field per await (pre-order ordinal)
    fut_syms:   SymbolStr[];
    fut_opt:    TypeRef[];
    naw:        i64;

    // one field per promoted cross-state scalar local (read in a state other
    // than the one it is declared in, so it cannot live on the native stack)
    prom_field: SymbolStr[];
    prom_tys:   TypeRef[];
    // Parallel to the two above: true when the field is the `Option<T>` wrapper
    // an aggregate is held in (constructed `None`) rather than a bare value the
    // constructor can zero.
    prom_opt:   boolean[];
    nprom:      i64;

    // Loop-target stacks (innermost loop last). Entering an await-carrying loop
    // pushes its continue-target (header / `for` update) and break-target (the
    // after state); `break`/`continue` in the body lower to a `this.state = <top>;`
    // edge. `break`/`continue` in an await-free nested loop stay native (that
    // loop is emitted wholesale), so the top of the stack is always the innermost
    // EXPLODED loop, which is exactly the source loop the edge targets.
    loop_cont:  i64[];
    loop_brk:   i64[];

    // Names whose storage lives in the poll frame: the body's locals and
    // `match`-arm bindings (re-materialized on every poll) plus the parameters
    // (re-bound by the shadow prelude on every poll). An address rooted in one
    // of these is invalid once the poll that produced it returns, so it may not
    // be held across a suspend; an address rooted anywhere else (a global, the
    // future struct's own fields, a pointee in the caller's frame or on the
    // heap) is untouched by a suspend.
    frame_names: SymbolStr[];

    // True when the function was declared `-> void`, so `Output` is unit and a
    // body that ends without a `return` completes with `Poll::Ready(())` rather
    // than being rejected for having no value to hand back.
    unit_output: boolean;
}

/// Lexical scope stack for `disambiguate_locals`, the pre-lowering alpha-rename
/// that makes every local binding's name globally unique before the body is
/// flattened into state blocks (so the by-name cross-state promotion cannot
/// conflate a promoted local with a same-named parameter or a sibling-scope
/// local). `orig`/`repl` are a flat binding stack (parallel arrays: an original
/// local name and the fresh name it was renamed to); `marks` records each
/// scope's start index so leaving a scope pops exactly its bindings. A use
/// resolves by scanning `orig` from the top (innermost binding first); a name in
/// no frame is a parameter/global/outer and is left unchanged.
type struct RenameCtx {
    orig:  SymbolStr[];
    repl:  SymbolStr[];
    marks: i64[];
}

/// The distinct binding names of one `match` arm paired with the fresh,
/// globally-unique names they are alpha-renamed to (`disambiguate_locals`).
/// OR-alternatives (`A(v) | B(v)`) contribute the name once and share one
/// fresh name so the arm body's uses resolve consistently.
type struct BindingRename {
    orig:  SymbolStr[];
    fresh: SymbolStr[];

    push_orig(mut &this, name: SymbolStr) -> void {
        for (mut i: i64 = 0; i < this.orig.length; i++) {
            if (this.orig[i].equals(name)) { return; }
        }
        this.orig.push(name);
    }

    index_of(&this, name: SymbolStr) -> i64 {
        for (mut i: i64 = 0; i < this.orig.length; i++) {
            if (this.orig[i].equals(name)) { return i; }
        }
        return -1;
    }
}

/// The statements one rewrite step lifted out of an expression, in the order
/// they must run. The `await` hoisting pass threads one of these through an
/// expression tree and splices it in ahead of the statement that owned the tree;
/// a construct that must keep a suspend conditional (`&&`, `||`, `?:`) gives its
/// conditional part a fresh one and empties it into a branch block instead.
type struct HoistPre {
    stmts: StatementNode*[];

    push(mut &this, s: StatementNode*) -> void {
        if (s != null) { this.stmts.push(s); }
    }
}

/// What remains of an expression after its `await`s were lifted into their own
/// statements, paired with the state those statements ended in — which is the
/// state the remainder must be evaluated in, since a suspend between the two
/// splits them across a poll.
type struct HoistedExpr {
    expr: ExpressionNode*;
    end:  i64;
}

/// A `match` arm's distinct pattern bindings paired with their (re-derived)
/// payload types, collected by `lower_match_sm` to promote each scalar binding
/// read across a suspend to a struct field.
type struct BindingCapture {
    names: SymbolStr[];
    tys:   TypeRef[];

    push_unique(mut &this, name: SymbolStr, ty: TypeRef) -> void {
        for (mut i: i64 = 0; i < this.names.length; i++) {
            if (this.names[i].equals(name)) { return; }
        }
        this.names.push(name);
        this.tys.push(ty);
    }
}

/// Where an `async function` lives, and — when it is a method — everything the
/// future declaration needs to know about its owner.
///
/// A free function and a method differ in exactly three places: the future's
/// name, how callers are repointed at the future type (a free function has an
/// overload set to drop and rebuild; a method's signature lives in the owner's
/// arena entry and under a combined `Owner::method` key instead), and the
/// receiver, which the body reads as a bare `this`.
type struct AsyncOwner {
    /// Null for a free function.
    method:       MethodNode*;
    /// The owner type.
    ty:           TypeRef;
    /// The canonical qualified owner name: the key the declaration index
    /// registered this method's signature under.
    qname:        SymbolStr;
    /// Further owner names the original registration aliased that key to (an
    /// impl block registers up to three forms). Re-registered through the
    /// aliased helper so every form keeps the canonical mangled symbol; the
    /// un-aliased helper would recompute a different one per form, which links
    /// only for whichever form a caller happened to use.
    alias_qnames: SymbolStr[];
    /// The owner's generic parameters. The future is generic in these as well
    /// as in the method's own, since the body may mention either.
    params:       GenericParamNode*[];
    /// The enclosing impl block when the owner is one, else null. Carried so an
    /// `async` method implementing an `async` TRAIT method can bind the trait's
    /// implicit `<Method>Fut` associated type to the future it lowers to.
    impl_node:    ImplBlockNode*;

    /// The owner of a free function: no method, no receiver, no owner keys.
    static free() -> AsyncOwner {
        return AsyncOwner { method: null, ty: TypeRef::invalid(),
                            qname: SymbolStr::empty(), alias_qnames: [], params: [],
                            impl_node: null };
    }
}

/// What `declare` builds for one `async function` and `lower` finishes.
///
/// The two run at different times on purpose: the future TYPE has to exist
/// before any body in the module is typed (an `await` on a callee declared lower
/// in the file resolves through the declaration index), while the state machine
/// can only be built from a body sema has already walked. So `declare` creates
/// the struct, the `poll` signature and the `Future` impl and registers them,
/// and `lower` fills in the struct's fields, `poll`'s body, and the constructor.
///
/// `ok` is false when `declare` failed; the record is still kept so `lower`
/// knows not to retry and re-report.
type struct AsyncDecl {
    node:        FunctionDeclNode*;
    ok:          boolean;

    q_name:      SymbolStr;
    module_sym:  SymbolStr;
    struct_ref:  TypeRef;
    // The future type a VALUE of it has. Identical to `struct_ref` for a
    // non-generic `async function`; for a generic one `struct_ref` is the
    // uninstantiated base the template registers against and carries the arena
    // field table, while `self_ty` is `Fut<T, …>` — what the function returns,
    // what the constructor literal builds, and the type of `this` inside `poll`.
    self_ty:     TypeRef;
    // True when the future carries generic parameters, so everything the
    // lowering synthesizes must spell them BY NAME (see `future_type_ann`).
    generic:     boolean;
    // The parameters the future is generic in: the owner's followed by the
    // function's own. Empty when `generic` is false.
    fut_params:  GenericParamNode*[];

    // Null when this is a free function. Non-null makes `lower` capture the
    // receiver and skip the free-function overload rebuild, which a method has
    // no counterpart to.
    method:      MethodNode*;
    // The future field holding the receiver, invalid when there is none (a
    // free function or a `static` method). Named with a `$` so no user field
    // can collide with it.
    recv_field:  SymbolStr;
    // True when the receiver is held BY POINTER (`&this` / `mut &this`). The
    // body was typed against the owner by value either way, so a pointer
    // receiver is read back through a deref.
    recv_ptr:    boolean;
    // The owner type as the BODY sees the receiver: always by value.
    recv_ty:     TypeRef;
    // The `Future`'s `Output`: the declared return type, or unit for `-> void`.
    output_ref:  TypeRef;
    // The return type as WRITTEN, which the body is still checked against.
    declared_ref: TypeRef;
    poll_out:    TypeRef;
    poll_base:   TypeRef;
    ctx_ptr_ty:  TypeRef;
    u32_ty:      TypeRef;
    state_sym:   SymbolStr;

    // Nodes created empty by `declare` and completed by `lower`.
    struct_decl: StructDeclNode*;
    impl_node:   ImplBlockNode*;
    poll_fn:     FunctionDeclNode*;
    poll_method: MethodNode*;
}

type struct AsyncLower {
    arena:    TypeArena*;
    intern:   InternTable*;
    ctx:      CompilationContext*;
    // Borrowed sema peer: re-derives a `match`-arm pattern binding's payload
    // type (`resolve_variant_payload_types`) and answers `match_is_exhaustive`,
    // neither of which is cached on the AST. Used only by the `match`-arm await
    // lowering; null for every other path.
    patterns: PatternResolver*;
    counter:  u64;
    // Every name `mint_local` hands out for the async body currently being
    // lowered — i.e. exactly the body's locals and `match`-arm bindings, which
    // are the values that live in the poll frame rather than in the future
    // struct. Reset per function by `disambiguate_locals`, the sole caller-side
    // funnel; consumed by the address-of-across-suspend check, which must know
    // whether a place is rooted in the frame (moves on every poll) or in a
    // global (does not).
    frame_locals: SymbolStr[];
    // Parallel to `frame_locals`: the source spelling each minted name replaced,
    // so a diagnostic about a local can name it as the user wrote it instead of
    // showing the internal `$L` suffix.
    frame_local_src: SymbolStr[];
    // One record per `async function` this module has declared but not yet
    // lowered. Keyed by node identity rather than name: a name is not unique
    // across overloads, and the record has to reach exactly the visit that owns
    // the body.
    pending: AsyncDecl[];
    // The "awaits" graph over generated future types, as arena type-id pairs
    // (`edge_from[i]` holds a sub-future of type `edge_to[i]`). A cycle in it
    // means a state machine would contain itself and have no finite size, so the
    // edge that would close one is rejected. Recorded here rather than recovered
    // from the struct fields because a future's fields are populated only when
    // ITS body is lowered, which for a mutually recursive pair is after the first
    // of them needs the answer.
    edge_from: u64[];
    edge_to:   u64[];
    // Interned once by `wire`: the receiver spellings a method's parameter list
    // and body use, and the future field a captured receiver lands in.
    this_sym:     SymbolStr;
    this_amp_sym: SymbolStr;
    recv_sym:     SymbolStr;
    // How `subst_name_expr` spells a substituted name. Defaults to the field
    // form and is restored to it after the one pass that needs another; see
    // `subst_target`.
    subst_mode: i64;

    static null() -> AsyncLower {
        return AsyncLower { arena: null, intern: null, ctx: null, patterns: null, counter: 0u64,
                            frame_locals: [], frame_local_src: [], pending: [],
                            edge_from: [], edge_to: [],
                            this_sym: SymbolStr::empty(), this_amp_sym: SymbolStr::empty(),
                            recv_sym: SymbolStr::empty(), subst_mode: 0i64 };
    }

    /// True when a future of type `from` holds — directly or through the futures
    /// it awaits — a future of type `target`. Depth-first over the recorded edges
    /// with a visited set, so an already-recorded cycle cannot spin.
    future_reaches(&this, from: u64, target: u64) -> boolean {
        if (from == target) { return true; }
        mut stack: u64[] = [from];
        mut seen:  u64[] = [from];
        while (stack.length > 0i64) {
            const cur: u64 = stack[stack.length - 1i64];
            stack.pop();
            for (mut i: i64 = 0; i < this.edge_from.length; i++) {
                if (this.edge_from[i] != cur) { continue; }
                const next: u64 = this.edge_to[i];
                if (next == target) { return true; }
                mut known: boolean = false;
                for (mut s: i64 = 0; s < seen.length; s++) {
                    if (seen[s] == next) { known = true; }
                }
                if (!known) { seen.push(next); stack.push(next); }
            }
        }
        return false;
    }

    /// Put the DECLARED return type back on a pending `async` node for the
    /// duration of its body walk, and return what was displaced.
    ///
    /// Only a METHOD needs this. A free function's callers resolve through the
    /// declaration index, so `declare` can repoint the index and hand the node
    /// straight back to the body check. A method's callers resolve through the
    /// NODE, so `declare` has to leave the future type on it — otherwise a
    /// caller whose body is typed before the callee's own (the callee declared
    /// lower in the type) sees the declared Output and reports that it does not
    /// implement `Future`. The body's `return`s still produce the Output, so
    /// that type is swapped back in here and out again by `end_body_check`.
    ///
    /// Invalid (and a no-op) for anything that is not a pending `async` method.
    begin_body_check(mut &this, node: FunctionDeclNode*) -> TypeRef {
        const i: i64 = this.pending_index(node);
        if (i < 0i64 || !this.pending[i].ok || this.pending[i].method == null) {
            return TypeRef::invalid();
        }
        const displaced: TypeRef = node.resolved_return_type;
        node.set_resolved_return_type(this.pending[i].declared_ref);
        return displaced;
    }

    /// Undo `begin_body_check`. `displaced` invalid means it was a no-op.
    end_body_check(mut &this, node: FunctionDeclNode*, displaced: TypeRef) -> void {
        if (!displaced.is_valid()) { return; }
        node.set_resolved_return_type(displaced);
    }

    /// Index of `node`'s pending record, or -1.
    pending_index(&this, node: FunctionDeclNode*) -> i64 {
        for (mut i: i64 = 0; i < this.pending.length; i++) {
            if (this.pending[i].node == node) { return i; }
        }
        return -1i64;
    }

    wire(mut &this, arena: TypeArena*, intern: InternTable*, ctx: CompilationContext*,
         patterns: PatternResolver*) -> void {
        this.arena    = arena;
        this.intern   = intern;
        this.ctx      = ctx;
        this.patterns = patterns;
        this.this_sym     = intern.intern("this");
        this.this_amp_sym = intern.intern("&this");
        this.recv_sym     = intern.intern("this$recv");
    }

    /// True when `p` is a method's receiver slot rather than a user parameter.
    ///
    /// `&this` / `mut &this` are one parameter literally named `"&this"` and
    /// semantically a `T*`; a by-value receiver is named `"this"` and is left
    /// without a resolved type by type resolution. Neither name is a field name
    /// the future can use, and neither is the name the body reads the receiver
    /// by, so every parameter walk routes the receiver through `recv_field`.
    is_receiver_param(&this, p: VarDeclNode*) -> boolean {
        if (p == null || !p.name.is_valid()) { return false; }
        return p.name.equals(this.this_amp_sym) || p.name.equals(this.this_sym);
    }

    /// The future field backing parameter `p`, and the name the poll body binds
    /// it to: its own name, or the receiver field for a receiver.
    param_field_name(&this, p: VarDeclNode*) -> SymbolStr {
        if (this.is_receiver_param(p)) { return this.recv_sym; }
        return p.name;
    }

    /// The type parameter `p` is stored and bound as. The receiver's is the one
    /// `declare` settled (a pointer for `&this`, the owner by value otherwise);
    /// type resolution leaves a by-value `this` with no resolved type at all.
    param_slot_type(&this, d: AsyncDecl*, p: VarDeclNode*) -> TypeRef {
        if (this.is_receiver_param(p)) {
            if (d.recv_ptr) { return this.arena.get_pointer_to(d.recv_ty); }
            return d.recv_ty;
        }
        return p.resolved_type;
    }

    /// True when `p` contributes a field to the future at all. Every parameter
    /// does, except a receiver on a lowering that captured none — which cannot
    /// happen, but keeps the walks total rather than depending on it.
    param_has_slot(&this, d: AsyncDecl*, p: VarDeclNode*) -> boolean {
        if (p == null) { return false; }
        if (this.is_receiver_param(p)) { return d.recv_field.is_valid(); }
        return p.resolved_type.is_valid();
    }

    /// Resolve a stdlib future type by its import-visible leaf (`Poll`,
    /// `Context`) to its arena TypeRef. Invalid if the module didn't import it.
    lookup_future_type(&this, leaf: string) -> TypeRef {
        const leaf_sym: SymbolStr = this.intern.intern(leaf);
        const qual: SymbolStr = this.ctx.resolve_scoped_or(leaf_sym);
        return this.ctx.decl_index.lookup_type(qual);
    }

    mint_bare(mut &this, base: string) -> SymbolStr {
        const idx: u64 = this.counter;
        this.counter += 1u64;
        return this.intern.intern(format("%s$Future_%llu", base, idx));
    }

    /// Build a `Named` type annotation whose resolution short-circuits to `ty`
    /// (via `pre_resolved`), so a synthesized annotation resolves without a name
    /// lookup.
    make_type_ann(&this, ty: TypeRef, span: SourceSpan) -> TypeAnnotation* {
        const disp: string = this.arena.resolve_display_name(ty.id);
        mut n: NamedAnnotation* = new NamedAnnotation {
            name: this.intern.intern(disp), span: span, pre_resolved: ty,
        };
        return new TypeAnnotation::Named(n);
    }

    /// A `Named` annotation resolved by NAME LOOKUP rather than short-circuited.
    ///
    /// The counterpart to `make_type_ann`, and mandatory for anything a generic
    /// future mentions: monomorphization specializes a template by rewriting the
    /// generic parameters that appear in its ANNOTATIONS, and `pre_resolved`
    /// bypasses annotation resolution entirely — a pre-resolved `T` would reach
    /// codegen still being `T`. `name` must therefore be resolvable where the
    /// annotation lands, which for a synthesized one means fully qualified.
    named_ann(&this, name: SymbolStr, span: SourceSpan) -> TypeAnnotation* {
        mut n: NamedAnnotation* = new NamedAnnotation {
            name: name, span: span, pre_resolved: TypeRef::invalid(),
        };
        return new TypeAnnotation::Named(n);
    }

    /// `<T, U, …>` — the function's own generic parameters spelled by name, the
    /// form the monomorphizer's substituter rewrites. A fresh array of fresh
    /// nodes per call: substitution edits annotations IN PLACE, so two uses may
    /// not share one node.
    generic_param_anns(&this, params: &GenericParamNode*[], span: SourceSpan) -> TypeAnnotation*[] {
        mut args: TypeAnnotation*[] = [];
        for (mut i: i64 = 0; i < params.length; i++) {
            const gp: GenericParamNode* = params[i];
            if (gp == null) { continue; }
            args.push(this.named_ann(gp.name, span));
        }
        return args;
    }

    /// An annotation for the generated future type: `Fut` when the function is
    /// not generic (pre-resolved, no lookup), `Fut<T, …>` when it is.
    future_type_ann(mut &this, d: AsyncDecl*, span: SourceSpan) -> TypeAnnotation* {
        if (!d.generic) { return this.make_type_ann(d.struct_ref, span); }
        mut gen: GenericAnnotation* = new GenericAnnotation {
            base: this.named_ann(d.q_name, span),
            args: this.generic_param_anns(d.fut_params, span),
            span: span,
        };
        return new TypeAnnotation::Generic(gen);
    }

    /// Bind the trait's implicit `<Method>Fut` associated type to the future this
    /// `async` method just lowered to.
    ///
    /// `async read(&this, n) -> i64` on a TRAIT desugars to `type ReadFut;` plus a
    /// `This::ReadFut` return (`desugar_async_trait_methods`); the impl side closes
    /// that loop here, so `Ticker::ReadFut` reduces to the synthesized future and a
    /// generic caller's `await s.read(n)` resolves. An explicit binding already on
    /// the impl wins — a hand-written `implement trait AsyncRead<MyFut>` stays
    /// authoritative. No-op unless this method belongs to a trait impl whose trait
    /// declares that associated type.
    bind_async_trait_assoc(mut &this, owner: AsyncOwner*, node: FunctionDeclNode*,
                           fut_ann: TypeAnnotation*) -> void {
        if (owner == null || node == null || fut_ann == null) { return; }
        if (owner.impl_node == null || !owner.impl_node.is_trait_impl()) { return; }
        if (this.ctx.generic_registry == null) { return; }
        const leaf: SymbolStr =
            TypeResolutionPasses::extract_trait_leaf(owner.impl_node.trait_annotation);
        if (!leaf.is_valid()) { return; }
        const tdecl: TraitDeclNode* = this.ctx.generic_registry.get_trait_decl(leaf);
        if (tdecl == null) { return; }
        const assoc: SymbolStr =
            TypeResolutionPasses::async_fut_assoc_name(this.ctx, node.name);
        if (!assoc.is_valid()) { return; }
        if (tdecl.lookup_assoc_type(assoc) == null) { return; }
        if (owner.impl_node.lookup_assoc_binding(assoc) != null) { return; }
        owner.impl_node.add_assoc_binding(assoc, fut_ann);
    }

    /// An annotation for the `Future`'s `Output` — the declared return type, or
    /// unit for `-> void`.
    output_type_ann(mut &this, d: AsyncDecl*, span: SourceSpan) -> TypeAnnotation* {
        return this.type_ann_for(d.output_ref, span);
    }

    /// Spell `ty` as an annotation monomorphization can substitute.
    ///
    /// A subtree with no generic parameter anywhere in it is pre-resolved — the
    /// substituter has nothing to do there, and pre-resolving skips a name lookup
    /// that a synthesized name might not survive. A subtree that DOES mention one
    /// is rebuilt structurally down to the parameter, which is spelled by name so
    /// the substituter can see and rewrite it.
    ///
    /// Null when the type mentions a parameter through a shape with no annotation
    /// spelling; the caller reports that rather than emitting a field whose type
    /// would silently stay generic.
    type_ann_for(mut &this, ty: TypeRef, span: SourceSpan) -> TypeAnnotation* {
        if (!ty.is_valid()) { return null; }
        if (!this.arena.contains_generic_param(ty)) { return this.make_type_ann(ty, span); }

        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return null; }
        if (t.kind == TypeKind::GenericParam) {
            return this.named_ann((t as GenericParamType*).param_name, span);
        }
        if (t.kind == TypeKind::BoundedParam) {
            return this.named_ann((t as BoundedParamType*).param_name, span);
        }
        if (t.kind == TypeKind::Pointer) {
            const p: PointerType* = t as PointerType*;
            mut inner: TypeAnnotation* = this.type_ann_for(p.pointee, span);
            if (inner == null) { return null; }
            return new TypeAnnotation::Pointer(new PointerAnnotation {
                inner: inner, is_const: false, span: span,
            });
        }
        if (t.kind == TypeKind::Reference) {
            const r: ReferenceType* = t as ReferenceType*;
            mut inner: TypeAnnotation* = this.type_ann_for(r.referent, span);
            if (inner == null) { return null; }
            return new TypeAnnotation::Reference(new ReferenceAnnotation {
                inner: inner, is_mutable: r.is_mutable(), span: span,
            });
        }
        if (t.kind == TypeKind::Array) {
            const a: ArrayType* = t as ArrayType*;
            mut elem: TypeAnnotation* = this.type_ann_for(a.element, span);
            if (elem == null) { return null; }
            return new TypeAnnotation::Array(new ArrayAnnotation {
                element: elem, size: a.size, size_expr: null, span: span,
            });
        }
        // An associated-type projection (`S::ReadFut`, or the nested
        // `(S::ReadFut)::Output` an `await` on one produces) is spelled as a
        // Projection annotation so the substituter rewrites its BASE when the
        // enclosing template specializes; mono then reduces the projection.
        // Without this the frame field for such an `await` cannot be spelled at
        // all and the whole lowering is refused.
        if (t.kind == TypeKind::AssocProjection) {
            const proj: AssocProjectionType* = t as AssocProjectionType*;
            mut base: TypeAnnotation* = this.type_ann_for(proj.base, span);
            if (base == null) { return null; }
            return new TypeAnnotation::Projection(new ProjectionAnnotation {
                base:         base,
                member:       proj.member,
                owning_trait: SymbolStr::empty(),
                resolved:     TypeRef::invalid(),
                span:         span,
            });
        }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            const base_q: SymbolStr = OwnershipQuery::qualified_name_of(this.arena, inst.generic_base);
            if (!base_q.is_valid()) { return null; }
            mut args: TypeAnnotation*[] = [];
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                mut arg: TypeAnnotation* = this.type_ann_for(inst.type_args[i], span);
                if (arg == null) { return null; }
                args.push(arg);
            }
            return new TypeAnnotation::Generic(new GenericAnnotation {
                base: this.named_ann(base_q, span), args: args, span: span,
            });
        }
        return null;
    }

    /// An annotation for `Poll<X>` over an already-built `X`.
    poll_type_ann(mut &this, arg: TypeAnnotation*, span: SourceSpan) -> TypeAnnotation* {
        mut gen: GenericAnnotation* = new GenericAnnotation {
            base: this.named_ann(this.ctx.resolve_scoped_or(this.intern.intern("Poll")), span),
            args: [arg],
            span: span,
        };
        return new TypeAnnotation::Generic(gen);
    }

    is_void_type(&this, ty: TypeRef) -> boolean {
        if (!ty.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return false; }
        return t.kind == TypeKind::Void;
    }

    /// The unit value `()`. Spelled the way the parser spells it, so the rest of
    /// the pipeline sees an ordinary unit literal rather than a shape unique to
    /// the async lowering.
    unit_value(&this, span: SourceSpan) -> ExpressionNode* {
        mut lit: LiteralNode* = new LiteralNode("void", LiteralKind::Null, span);
        lit.set_resolved_type(this.arena.get_unit());
        return lit as ExpressionNode*;
    }

    /// `return Poll::Ready(());` — the terminal return of a `-> void` async fn,
    /// whose `Output` is unit.
    unit_ready_return(&this, poll_out: TypeRef, span: SourceSpan) -> StatementNode* {
        return new ReturnStmtNode(
            this.make_poll_ready(this.unit_value(span), poll_out, span), span) as StatementNode*;
    }

    /// Wrap an already-typed value expression in `Poll::Ready(<expr>)` typed as
    /// `Poll<Output>`.
    make_poll_ready(&this, value: ExpressionNode*, poll_out: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut scope: ScopeResolutionNode* = new ScopeResolutionNode(
            this.intern.intern("Poll"), this.intern.intern("Ready"), span);
        scope.set_resolved_type(poll_out);
        mut call: CallExprNode* = new CallExprNode(scope as ExpressionNode*, span);
        call.add_argument(value);
        call.set_resolved_type(poll_out);
        return call as ExpressionNode*;
    }

    /// Rewrite every `return E;` reachable in `stmt` to `return Poll::Ready(E);`,
    /// recursing into blocks and every control-flow container so a return nested
    /// in an if / loop / match is wrapped too. Return sites are found by a plain
    /// structural walk (no await handling); `await` suspend points inside these
    /// containers arrive with the later state-machine increments. Does NOT descend
    /// into nested function-like bodies (a lambda's returns are its own, and a
    /// lambda is an expression this statement walk never enters).
    rewrite_returns(mut &this, stmt: StatementNode*, poll_out: TypeRef, span: SourceSpan) -> void {
        if (stmt == null) { return; }
        if (stmt.kind == NodeKind::ReturnStatement) {
            const ret: ReturnStmtNode* = stmt as ReturnStmtNode*;
            if (ret.expression != null) {
                // The returned expression may itself hold a `match` expression
                // whose arms return; rewrite those before wrapping this one, so
                // the wrap sees a fully rewritten operand.
                this.rewrite_returns_expr(ret.expression, poll_out, span);
                ret.expression = this.make_poll_ready(ret.expression, poll_out, span);
            } else {
                // A bare `return;` only type-checks in a `-> void` function, whose
                // `Output` is unit — so the value `Poll::Ready` carries is `()`.
                // `poll` returns a value on every path, so the bare form cannot
                // survive into the generated body.
                ret.expression = this.make_poll_ready(this.unit_value(span), poll_out, span);
            }
            return;
        }
        if (stmt.kind == NodeKind::ExpressionStatement) {
            this.rewrite_returns_expr((stmt as ExprStmtNode*).expression, poll_out, span);
            return;
        }
        if (stmt.kind == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = stmt as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                this.rewrite_returns_expr((ds.declaration as VarDeclNode*).initializer, poll_out, span);
            }
            return;
        }
        if (stmt.kind == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = stmt as BlockStmtNode*;
            for (mut i: i64 = 0; i < blk.statements.length; i++) {
                this.rewrite_returns(blk.statements[i], poll_out, span);
            }
            return;
        }
        if (stmt.kind == NodeKind::IfStatement) {
            const iff: IfStmtNode* = stmt as IfStmtNode*;
            this.rewrite_returns_expr(iff.condition, poll_out, span);
            this.rewrite_returns(iff.then_stmt, poll_out, span);
            this.rewrite_returns(iff.else_stmt, poll_out, span);
            return;
        }
        if (stmt.kind == NodeKind::WhileStatement) {
            const w: WhileStmtNode* = stmt as WhileStmtNode*;
            this.rewrite_returns_expr(w.condition, poll_out, span);
            this.rewrite_returns(w.body, poll_out, span);
            return;
        }
        if (stmt.kind == NodeKind::DoWhileStatement) {
            const d: DoWhileStmtNode* = stmt as DoWhileStmtNode*;
            this.rewrite_returns(d.body, poll_out, span);
            this.rewrite_returns_expr(d.condition, poll_out, span);
            return;
        }
        if (stmt.kind == NodeKind::ForStatement) {
            const f: ForStmtNode* = stmt as ForStmtNode*;
            if (f.init != null) {
                if ((f.init as ASTNode*).kind == NodeKind::VariableDeclaration) {
                    this.rewrite_returns_expr((f.init as VarDeclNode*).initializer, poll_out, span);
                } else {
                    this.rewrite_returns_expr(f.init as ExpressionNode*, poll_out, span);
                }
            }
            this.rewrite_returns_expr(f.condition, poll_out, span);
            this.rewrite_returns(f.body, poll_out, span);
            this.rewrite_returns_expr(f.update, poll_out, span);
            return;
        }
        if (stmt.kind == NodeKind::LoopStatement) {
            this.rewrite_returns((stmt as LoopStmtNode*).body, poll_out, span);
            return;
        }
        if (stmt.kind == NodeKind::MatchStatement) {
            const m: MatchStmtNode* = stmt as MatchStmtNode*;
            this.rewrite_returns_expr(m.subject, poll_out, span);
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                if (m.arms[i] != null) {
                    this.rewrite_returns_expr(m.arms[i].guard, poll_out, span);
                    this.rewrite_returns(m.arms[i].body, poll_out, span);
                }
            }
            return;
        }
    }

    /// Statement half of `rewrite_returns` reached through an expression: only a
    /// `match` used as an expression puts statements — and therefore `return`s —
    /// inside an expression tree. Every other expression kind is walked purely to
    /// reach a `match` expression nested within it.
    rewrite_returns_expr(mut &this, e: ExpressionNode*, poll_out: TypeRef, span: SourceSpan) -> void {
        if (e == null) { return; }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::MatchExpression) {
            const me: MatchExprNode* = e as MatchExprNode*;
            this.rewrite_returns_expr(me.subject, poll_out, span);
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                if (me.arms[i] != null) {
                    this.rewrite_returns_expr(me.arms[i].guard, poll_out, span);
                    this.rewrite_returns(me.arms[i].body, poll_out, span);
                }
            }
            return;
        }
        if (k == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            this.rewrite_returns_expr(b.left, poll_out, span);
            this.rewrite_returns_expr(b.right, poll_out, span);
            return;
        }
        if (k == NodeKind::UnaryExpression) {
            this.rewrite_returns_expr((e as UnaryExprNode*).operand, poll_out, span);
            return;
        }
        if (k == NodeKind::CallExpression) {
            const c: CallExprNode* = e as CallExprNode*;
            this.rewrite_returns_expr(c.callee, poll_out, span);
            for (mut i: i64 = 0; i < c.arguments.length; i++) {
                this.rewrite_returns_expr(c.arguments[i], poll_out, span);
            }
            return;
        }
        if (k == NodeKind::MemberAccess) {
            this.rewrite_returns_expr((e as MemberAccessNode*).object, poll_out, span);
            return;
        }
        if (k == NodeKind::CastExpression) {
            this.rewrite_returns_expr((e as CastExprNode*).expression, poll_out, span);
            return;
        }
        if (k == NodeKind::ArrayAccess) {
            const a: ArrayAccessNode* = e as ArrayAccessNode*;
            this.rewrite_returns_expr(a.array, poll_out, span);
            this.rewrite_returns_expr(a.index, poll_out, span);
            return;
        }
        if (k == NodeKind::TernaryExpression) {
            const t: TernaryExprNode* = e as TernaryExprNode*;
            this.rewrite_returns_expr(t.condition, poll_out, span);
            this.rewrite_returns_expr(t.true_expr, poll_out, span);
            this.rewrite_returns_expr(t.false_expr, poll_out, span);
            return;
        }
        if (k == NodeKind::StructLiteral) {
            const sl: StructLiteralNode* = e as StructLiteralNode*;
            for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                this.rewrite_returns_expr(sl.field_inits[i].value, poll_out, span);
            }
            return;
        }
        if (k == NodeKind::AwaitExpression) {
            this.rewrite_returns_expr((e as AwaitExprNode*).operand, poll_out, span);
            return;
        }
    }

    // ---- await discovery (Inc 2: a single straight-line await) ----

    /// Count `await` sub-expressions in an expression tree. Covers the node
    /// kinds an awaited-future expression realistically nests under; kinds not
    /// walked can only UNDER-count, and any `await` the lowering leaves in place
    /// is caught by codegen's `await`-not-implemented hard error, so an
    /// imperfect count degrades only the diagnostic, never soundness.
    expr_await_count(&this, e: ExpressionNode*) -> i64 {
        if (e == null) { return 0i64; }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::AwaitExpression) {
            return 1i64 + this.expr_await_count((e as AwaitExprNode*).operand);
        }
        if (k == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            return this.expr_await_count(b.left) + this.expr_await_count(b.right);
        }
        if (k == NodeKind::UnaryExpression) {
            return this.expr_await_count((e as UnaryExprNode*).operand);
        }
        if (k == NodeKind::CallExpression) {
            const c: CallExprNode* = e as CallExprNode*;
            mut n: i64 = this.expr_await_count(c.callee);
            for (mut i: i64 = 0; i < c.arguments.length; i++) {
                n += this.expr_await_count(c.arguments[i]);
            }
            return n;
        }
        if (k == NodeKind::MemberAccess) {
            return this.expr_await_count((e as MemberAccessNode*).object);
        }
        if (k == NodeKind::TernaryExpression) {
            const t: TernaryExprNode* = e as TernaryExprNode*;
            return this.expr_await_count(t.condition)
                 + this.expr_await_count(t.true_expr)
                 + this.expr_await_count(t.false_expr);
        }
        if (k == NodeKind::CastExpression) {
            return this.expr_await_count((e as CastExprNode*).expression);
        }
        if (k == NodeKind::ArrayAccess) {
            const a: ArrayAccessNode* = e as ArrayAccessNode*;
            return this.expr_await_count(a.array) + this.expr_await_count(a.index);
        }
        if (k == NodeKind::ArrayLiteral) {
            const al: ArrayLiteralNode* = e as ArrayLiteralNode*;
            mut n: i64 = 0i64;
            for (mut i: i64 = 0; i < al.elements.length; i++) {
                n += this.expr_await_count(al.elements[i]);
            }
            return n;
        }
        if (k == NodeKind::StructLiteral) {
            const sl: StructLiteralNode* = e as StructLiteralNode*;
            mut n: i64 = 0i64;
            for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                n += this.expr_await_count(sl.field_inits[i].value);
            }
            return n;
        }
        // A lambda body is a separate function: an `await` in one belongs to
        // that function, not to this one, and counting it here would make this
        // body try to explode a suspend it does not contain.
        if (k == NodeKind::MatchExpression) {
            // A `match` expression holds statement bodies, so an `await` can hide
            // in an arm. Counting it is what routes the shape to the E0600 for an
            // await nested in an expression, instead of leaving the `await` in
            // place for codegen to reject with no source context.
            const me: MatchExprNode* = e as MatchExprNode*;
            mut n: i64 = this.expr_await_count(me.subject);
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                if (me.arms[i] != null) {
                    n += this.expr_await_count(me.arms[i].guard);
                    n += this.stmt_await_count(me.arms[i].body);
                }
            }
            return n;
        }
        return 0i64;
    }

    /// Count `await`s in a statement, recursing through control-flow containers
    /// so an `await` buried in a nested block/branch/loop is still tallied (and
    /// therefore rejected — Inc 2 lowers only a single straight-line await).
    stmt_await_count(&this, stmt: StatementNode*) -> i64 {
        if (stmt == null) { return 0i64; }
        const k: NodeKind = stmt.kind;
        if (k == NodeKind::ExpressionStatement) {
            return this.expr_await_count((stmt as ExprStmtNode*).expression);
        }
        if (k == NodeKind::ReturnStatement) {
            return this.expr_await_count((stmt as ReturnStmtNode*).expression);
        }
        if (k == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = stmt as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                return this.expr_await_count((ds.declaration as VarDeclNode*).initializer);
            }
            return 0i64;
        }
        if (k == NodeKind::BlockStatement) {
            return this.block_await_count(stmt as BlockStmtNode*);
        }
        if (k == NodeKind::IfStatement) {
            const iff: IfStmtNode* = stmt as IfStmtNode*;
            return this.expr_await_count(iff.condition)
                 + this.stmt_await_count(iff.then_stmt)
                 + this.stmt_await_count(iff.else_stmt);
        }
        if (k == NodeKind::WhileStatement) {
            const w: WhileStmtNode* = stmt as WhileStmtNode*;
            return this.expr_await_count(w.condition) + this.stmt_await_count(w.body);
        }
        if (k == NodeKind::DoWhileStatement) {
            const d: DoWhileStmtNode* = stmt as DoWhileStmtNode*;
            return this.expr_await_count(d.condition) + this.stmt_await_count(d.body);
        }
        if (k == NodeKind::ForStatement) {
            const f: ForStmtNode* = stmt as ForStmtNode*;
            mut n: i64 = this.expr_await_count(f.condition) + this.expr_await_count(f.update)
                       + this.stmt_await_count(f.body);
            if (f.init != null) {
                if ((f.init as ASTNode*).kind == NodeKind::VariableDeclaration) {
                    n += this.expr_await_count((f.init as VarDeclNode*).initializer);
                } else {
                    n += this.expr_await_count(f.init as ExpressionNode*);
                }
            }
            return n;
        }
        if (k == NodeKind::LoopStatement) {
            return this.stmt_await_count((stmt as LoopStmtNode*).body);
        }
        if (k == NodeKind::MatchStatement) {
            const m: MatchStmtNode* = stmt as MatchStmtNode*;
            // The subject and the guards count too: an `await` left uncounted
            // anywhere sends the whole function down the no-await path, where
            // nothing rewrites it and codegen meets it with no state to resume.
            mut n: i64 = this.expr_await_count(m.subject);
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                if (m.arms[i] != null) {
                    n += this.expr_await_count(m.arms[i].guard);
                    n += this.stmt_await_count(m.arms[i].body);
                }
            }
            return n;
        }
        return 0i64;
    }

    block_await_count(&this, blk: BlockStmtNode*) -> i64 {
        if (blk == null) { return 0i64; }
        mut n: i64 = 0i64;
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            n += this.stmt_await_count(blk.statements[i]);
        }
        return n;
    }

    /// If `stmt`'s TOP-LEVEL expression is an `await`, return that node; else
    /// null. The three carriers Inc 2 supports: `const/mut x = await e;`,
    /// `return await e;`, and a bare `await e;`. An await nested deeper in an
    /// expression is intentionally not a carrier (the count gate rejects it).
    stmt_toplevel_await(&this, stmt: StatementNode*) -> AwaitExprNode* {
        if (stmt == null) { return null; }
        if (stmt.kind == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = stmt as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                const vd: VarDeclNode* = ds.declaration as VarDeclNode*;
                if (vd.initializer != null && vd.initializer.kind == NodeKind::AwaitExpression) {
                    return vd.initializer as AwaitExprNode*;
                }
            }
            return null;
        }
        if (stmt.kind == NodeKind::ReturnStatement) {
            const rs: ReturnStmtNode* = stmt as ReturnStmtNode*;
            if (rs.expression != null && rs.expression.kind == NodeKind::AwaitExpression) {
                return rs.expression as AwaitExprNode*;
            }
            return null;
        }
        if (stmt.kind == NodeKind::ExpressionStatement) {
            const es: ExprStmtNode* = stmt as ExprStmtNode*;
            if (es.expression != null && es.expression.kind == NodeKind::AwaitExpression) {
                return es.expression as AwaitExprNode*;
            }
            return null;
        }
        return null;
    }

    /// Replace the top-level `await e` in a carrier statement with `repl` (the
    /// identifier bound to the awaited result). The carrier then runs, on
    /// resume, reading the result instead of the (removed) await.
    rewrite_carrier_await(&this, stmt: StatementNode*, repl: ExpressionNode*) -> void {
        if (stmt == null) { return; }
        if (stmt.kind == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = stmt as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                (ds.declaration as VarDeclNode*).initializer = repl;
            }
            return;
        }
        if (stmt.kind == NodeKind::ReturnStatement) {
            (stmt as ReturnStmtNode*).expression = repl;
            return;
        }
        if (stmt.kind == NodeKind::ExpressionStatement) {
            (stmt as ExprStmtNode*).expression = repl;
            return;
        }
    }

    // ---- small typed-AST builders (shared by the poll-body synthesis) ----

    this_ident(&this, struct_ref: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut ti: IdentifierNode* = new IdentifierNode(this.intern.intern("this"), span);
        ti.set_resolved_type(struct_ref);
        return ti as ExpressionNode*;
    }

    ident(&this, name: SymbolStr, ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut id: IdentifierNode* = new IdentifierNode(name, span);
        id.set_resolved_type(ty);
        return id as ExpressionNode*;
    }

    /// `*(<e>)` typed `ty`. Marked synthetic: the address-of / deref checks
    /// that constrain user syntax read that flag to skip compiler-built nodes.
    deref(&this, e: ExpressionNode*, ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        const star: Token = Token::new(TokenType::Star, "*",
                                       span.start_line as int, span.start_col as int);
        mut u: UnaryExprNode* = new UnaryExprNode(star, e, span);
        u.is_synthetic = true;
        u.set_resolved_type(ty);
        return u as ExpressionNode*;
    }

    /// `&(<e>)` typed `ty`.
    addr_of(&this, e: ExpressionNode*, ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        const amp: Token = Token::new(TokenType::Amp, "&",
                                      span.start_line as int, span.start_col as int);
        mut u: UnaryExprNode* = new UnaryExprNode(amp, e, span);
        u.is_synthetic = true;
        u.set_resolved_type(ty);
        return u as ExpressionNode*;
    }

    member(&this, obj: ExpressionNode*, field: SymbolStr, ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut m: MemberAccessNode* = new MemberAccessNode(obj, field, span, span);
        m.set_resolved_type(ty);
        return m as ExpressionNode*;
    }

    u32_lit(&this, value: u64, span: SourceSpan) -> ExpressionNode* {
        mut lit: LiteralNode* = new LiteralNode(format("%llu", value), LiteralKind::Integer, span);
        lit.set_resolved_type(this.arena.get_u32());
        return lit as ExpressionNode*;
    }

    /// `recv.name()` typed `ret_ty`. The member/call re-resolve by name during
    /// the post-mono body re-check; `ret_ty` is the pre-mono hint.
    method_call0(&this, recv: ExpressionNode*, name: string, ret_ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut m: MemberAccessNode* = new MemberAccessNode(recv, this.intern.intern(name), span, span);
        mut c: CallExprNode* = new CallExprNode(m as ExpressionNode*, span);
        c.set_resolved_type(ret_ty);
        return c as ExpressionNode*;
    }

    method_call1(&this, recv: ExpressionNode*, name: string, arg: ExpressionNode*,
                 ret_ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut m: MemberAccessNode* = new MemberAccessNode(recv, this.intern.intern(name), span, span);
        mut c: CallExprNode* = new CallExprNode(m as ExpressionNode*, span);
        c.add_argument(arg);
        c.set_resolved_type(ret_ty);
        return c as ExpressionNode*;
    }

    /// `this.<field> = <rhs>;` as a statement.
    assign_member_stmt(&this, struct_ref: TypeRef, field: SymbolStr, field_ty: TypeRef,
                       rhs: ExpressionNode*, span: SourceSpan) -> StatementNode* {
        mut lhs: ExpressionNode* = this.member(this.this_ident(struct_ref, span), field, field_ty, span);
        const eq: Token = Token::new(TokenType::Equal, "=", span.start_line as int, span.start_col as int);
        mut assign: BinaryExprNode* = new BinaryExprNode(eq, lhs, rhs, span);
        assign.set_resolved_type(this.arena.get_void());
        mut es: ExprStmtNode* = new ExprStmtNode(assign as ExpressionNode*, span);
        return es as StatementNode*;
    }

    /// A `match` arm `<value> => { <body> }` with a bare integer-literal pattern.
    /// Mirrors the parser's literal-int pattern (`PatternKind::Literal` +
    /// `LiteralKind::Integer`, no type suffix); the `u32` state type is inferred
    /// from the match subject, so the pattern text stays a bare integer.
    match_arm_int(&this, value: u64, body: BlockStmtNode*, span: SourceSpan) -> MatchArmNode* {
        mut pat: PatternNode* = new PatternNode(PatternKind::Literal, span);
        pat.set_value(this.intern.intern(format("%llu", value)));
        pat.set_literal_kind(LiteralKind::Integer);
        mut arm: MatchArmNode* = new MatchArmNode(span);
        arm.add_pattern(pat);
        arm.set_body(body as StatementNode*);
        return arm;
    }

    /// A `match` arm `_ => { <body> }` (the wildcard, making the state dispatch
    /// exhaustive over the open `u32` domain).
    match_arm_wild(&this, body: BlockStmtNode*, span: SourceSpan) -> MatchArmNode* {
        mut pat: PatternNode* = new PatternNode(PatternKind::Wildcard, span);
        mut arm: MatchArmNode* = new MatchArmNode(span);
        arm.add_pattern(pat);
        arm.set_body(body as StatementNode*);
        return arm;
    }

    /// `Option::Some(<value>)` typed `opt_ty`.
    option_some(&this, value: ExpressionNode*, opt_ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut scope: ScopeResolutionNode* = new ScopeResolutionNode(
            this.intern.intern("Option"), this.intern.intern("Some"), span);
        scope.set_resolved_type(opt_ty);
        mut call: CallExprNode* = new CallExprNode(scope as ExpressionNode*, span);
        call.add_argument(value);
        call.set_resolved_type(opt_ty);
        return call as ExpressionNode*;
    }

    /// `Option::None` typed `opt_ty`.
    option_none(&this, opt_ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut scope: ScopeResolutionNode* = new ScopeResolutionNode(
            this.intern.intern("Option"), this.intern.intern("None"), span);
        scope.set_resolved_type(opt_ty);
        return scope as ExpressionNode*;
    }

    /// `Poll::Pending` typed `poll_ty`.
    poll_pending(&this, poll_ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        mut scope: ScopeResolutionNode* = new ScopeResolutionNode(
            this.intern.intern("Poll"), this.intern.intern("Pending"), span);
        scope.set_resolved_type(poll_ty);
        return scope as ExpressionNode*;
    }

    var_decl_stmt(&this, name: SymbolStr, mutable: boolean, ty: TypeRef,
                  init: ExpressionNode*, span: SourceSpan) -> StatementNode* {
        mut vd: VarDeclNode* = new VarDeclNode(name, span);
        vd.set_mutable(mutable);
        vd.set_resolved_type(ty);
        vd.set_initializer(init);
        mut ds: DeclStmtNode* = new DeclStmtNode(vd as DeclarationNode*, span);
        return ds as StatementNode*;
    }

    /// The arg-shadow prelude common to every generated `poll`: `const p =
    /// this.p;` for each captured parameter, so the moved body resolves its
    /// parameter names against the struct fields.
    emit_shadow_prelude(&this, d: AsyncDecl*, node: FunctionDeclNode*, body: BlockStmtNode*,
                        struct_ref: TypeRef, skip_carried: boolean, span: SourceSpan) -> void {
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            const p: VarDeclNode* = node.parameters[i];
            if (!this.param_has_slot(d, p)) { continue; }
            const slot_ty: TypeRef = this.param_slot_type(d, p);
            // A carried parameter is materialized per state by `carry_params`
            // instead: one shared shadow would be moved from inside the loop.
            if (skip_carried && this.param_needs_carrier(slot_ty)) { continue; }
            const fname: SymbolStr = this.param_field_name(p);
            mut this_ref: IdentifierNode* = new IdentifierNode(this.this_sym, span);
            this_ref.set_resolved_type(struct_ref);
            mut access: MemberAccessNode* = new MemberAccessNode(
                this_ref as ExpressionNode*, fname, span, span);
            access.set_resolved_type(slot_ty);
            mut shadow: VarDeclNode* = new VarDeclNode(fname, span);
            shadow.set_mutable(false);
            shadow.set_resolved_type(slot_ty);
            shadow.set_initializer(access as ExpressionNode*);
            const shadow_stmt: DeclStmtNode* = new DeclStmtNode(shadow as DeclarationNode*, span);
            body.add_statement(shadow_stmt as StatementNode*);
        }
    }

    /// No-await body: shadow prelude + the original body with `return E`
    /// rewritten to `return Poll::Ready(E)` (runs to completion in one poll).
    build_poll_body_no_await(mut &this, d: AsyncDecl*, node: FunctionDeclNode*, struct_ref: TypeRef,
                             poll_out: TypeRef, span: SourceSpan) -> BlockStmtNode* {
        mut body: BlockStmtNode* = new BlockStmtNode(span);
        this.emit_shadow_prelude(d, node, body, struct_ref, false, span);
        if (node.body.kind == NodeKind::BlockStatement) {
            const orig: BlockStmtNode* = node.body as BlockStmtNode*;
            for (mut bi: i64 = 0; bi < orig.statements.length; bi++) {
                this.rewrite_returns(orig.statements[bi], poll_out, span);
                body.add_statement(orig.statements[bi]);
            }
            // A void body may end without a `return`, but `poll` may not: give it
            // the unit completion the source left implicit.
            if (!this.block_diverges(orig)) {
                body.add_statement(this.unit_ready_return(poll_out, span));
            }
        }
        return body;
    }

    // ---- cross-await promotion analysis (Inc 3) ----

    /// True if `name` is read (appears as an identifier) anywhere in `e`. Walks
    /// the expression kinds an awaited body realistically nests names under; a
    /// missed kind can only UNDER-report, which leaves a cross-await local
    /// unpromoted and surfaces as a plain "not found" at its later use — a loud
    /// compile error, never a silent miscompile.
    name_read_in_expr(&this, e: ExpressionNode*, name: SymbolStr) -> boolean {
        if (e == null) { return false; }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::Identifier) {
            return (e as IdentifierNode*).name.equals(name);
        }
        if (k == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            return this.name_read_in_expr(b.left, name) || this.name_read_in_expr(b.right, name);
        }
        if (k == NodeKind::UnaryExpression) {
            return this.name_read_in_expr((e as UnaryExprNode*).operand, name);
        }
        if (k == NodeKind::CallExpression) {
            const c: CallExprNode* = e as CallExprNode*;
            if (this.name_read_in_expr(c.callee, name)) { return true; }
            for (mut i: i64 = 0; i < c.arguments.length; i++) {
                if (this.name_read_in_expr(c.arguments[i], name)) { return true; }
            }
            return false;
        }
        if (k == NodeKind::MemberAccess) {
            return this.name_read_in_expr((e as MemberAccessNode*).object, name);
        }
        if (k == NodeKind::CastExpression) {
            return this.name_read_in_expr((e as CastExprNode*).expression, name);
        }
        if (k == NodeKind::ArrayAccess) {
            const a: ArrayAccessNode* = e as ArrayAccessNode*;
            return this.name_read_in_expr(a.array, name) || this.name_read_in_expr(a.index, name);
        }
        if (k == NodeKind::TernaryExpression) {
            const t: TernaryExprNode* = e as TernaryExprNode*;
            return this.name_read_in_expr(t.condition, name)
                || this.name_read_in_expr(t.true_expr, name)
                || this.name_read_in_expr(t.false_expr, name);
        }
        if (k == NodeKind::StructLiteral) {
            const sl: StructLiteralNode* = e as StructLiteralNode*;
            for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                if (this.name_read_in_expr(sl.field_inits[i].value, name)) { return true; }
            }
            return false;
        }
        if (k == NodeKind::AwaitExpression) {
            return this.name_read_in_expr((e as AwaitExprNode*).operand, name);
        }
        if (k == NodeKind::MatchExpression) {
            const me: MatchExprNode* = e as MatchExprNode*;
            if (this.name_read_in_expr(me.subject, name)) { return true; }
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                if (me.arms[i] == null) { continue; }
                if (this.name_read_in_expr(me.arms[i].guard, name)) { return true; }
                if (this.name_read_in_stmt(me.arms[i].body, name)) { return true; }
            }
            return false;
        }
        return false;
    }

    /// True if `name` is read anywhere in statement `s`, recursing through the
    /// (await-free) control-flow containers a straight-line segment may hold.
    name_read_in_stmt(&this, s: StatementNode*, name: SymbolStr) -> boolean {
        if (s == null) { return false; }
        const k: NodeKind = s.kind;
        if (k == NodeKind::ExpressionStatement) {
            return this.name_read_in_expr((s as ExprStmtNode*).expression, name);
        }
        if (k == NodeKind::ReturnStatement) {
            return this.name_read_in_expr((s as ReturnStmtNode*).expression, name);
        }
        if (k == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = s as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                return this.name_read_in_expr((ds.declaration as VarDeclNode*).initializer, name);
            }
            return false;
        }
        if (k == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = s as BlockStmtNode*;
            for (mut i: i64 = 0; i < blk.statements.length; i++) {
                if (this.name_read_in_stmt(blk.statements[i], name)) { return true; }
            }
            return false;
        }
        if (k == NodeKind::IfStatement) {
            const iff: IfStmtNode* = s as IfStmtNode*;
            return this.name_read_in_expr(iff.condition, name)
                || this.name_read_in_stmt(iff.then_stmt, name)
                || this.name_read_in_stmt(iff.else_stmt, name);
        }
        if (k == NodeKind::WhileStatement) {
            const w: WhileStmtNode* = s as WhileStmtNode*;
            return this.name_read_in_expr(w.condition, name) || this.name_read_in_stmt(w.body, name);
        }
        if (k == NodeKind::DoWhileStatement) {
            const d: DoWhileStmtNode* = s as DoWhileStmtNode*;
            return this.name_read_in_expr(d.condition, name) || this.name_read_in_stmt(d.body, name);
        }
        if (k == NodeKind::ForStatement) {
            const f: ForStmtNode* = s as ForStmtNode*;
            if (f.init != null && this.name_read_in_stmt(f.init as StatementNode*, name)) { return true; }
            return this.name_read_in_expr(f.condition, name)
                || this.name_read_in_expr(f.update, name)
                || this.name_read_in_stmt(f.body, name);
        }
        if (k == NodeKind::LoopStatement) {
            return this.name_read_in_stmt((s as LoopStmtNode*).body, name);
        }
        if (k == NodeKind::MatchStatement) {
            const m: MatchStmtNode* = s as MatchStmtNode*;
            if (this.name_read_in_expr(m.subject, name)) { return true; }
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                if (m.arms[i] != null && this.name_read_in_stmt(m.arms[i].body, name)) { return true; }
            }
            return false;
        }
        return false;
    }

    // ---- in-place identifier rewrite (mut cross-state promotion) ----

    /// Rewrite every read of identifier `name` in `e` to `this.<field>` (typed
    /// `ty`), returning the (possibly replaced) expression for the caller's slot.
    /// The mutating twin of `name_read_in_expr` — the promoted `mut` field is the
    /// single source of truth, so reads AND assignment targets (`name = …`, whose
    /// LHS is an identifier) both become `this.<field>`. Covers the same node
    /// kinds; an unwalked kind leaves a `name` read in place, which surfaces as a
    /// loud "not found" at its use, never a silent miscompile.
    // -- Substitution spellings (`subst_mode`) --
    //
    // Everything a name may be rewritten INTO. `to_field` is the ordinary case:
    // a promoted local or a carried parameter lives in the future, so its uses
    // become `this.<field>`. The receiver is different — it is bound by the
    // poll frame like a parameter, and a pointer receiver has to be read back
    // by value, because the body was typed against the owner by value.
    subst_to_field(&this)       -> i64 { return 0i64; }
    subst_to_local(&this)       -> i64 { return 1i64; }
    subst_to_local_deref(&this) -> i64 { return 2i64; }

    /// What a substituted name becomes, per `subst_mode`. `ty` is always the
    /// type the name had in the body, so the rewritten expression type-checks
    /// exactly where the original did.
    subst_target(mut &this, field: SymbolStr, struct_ref: TypeRef, ty: TypeRef,
                 span: SourceSpan) -> ExpressionNode* {
        if (this.subst_mode == this.subst_to_local()) {
            return this.ident(field, ty, span);
        }
        if (this.subst_mode == this.subst_to_local_deref()) {
            return this.deref(this.ident(field, this.arena.get_pointer_to(ty), span), ty, span);
        }
        return this.member(this.this_ident(struct_ref, span), field, ty, span);
    }

    subst_name_expr(mut &this, e: ExpressionNode*, name: SymbolStr, field: SymbolStr,
                    struct_ref: TypeRef, ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        if (e == null) { return null; }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::Identifier) {
            if ((e as IdentifierNode*).name.equals(name)) {
                return this.subst_target(field, struct_ref, ty, span);
            }
            return e;
        }
        if (k == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            b.left  = this.subst_name_expr(b.left, name, field, struct_ref, ty, span);
            b.right = this.subst_name_expr(b.right, name, field, struct_ref, ty, span);
            return e;
        }
        if (k == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = e as UnaryExprNode*;
            u.operand = this.subst_name_expr(u.operand, name, field, struct_ref, ty, span);
            return e;
        }
        if (k == NodeKind::CallExpression) {
            const c: CallExprNode* = e as CallExprNode*;
            c.callee = this.subst_name_expr(c.callee, name, field, struct_ref, ty, span);
            for (mut i: i64 = 0; i < c.arguments.length; i++) {
                c.arguments[i] = this.subst_name_expr(c.arguments[i], name, field, struct_ref, ty, span);
            }
            return e;
        }
        if (k == NodeKind::MemberAccess) {
            const m: MemberAccessNode* = e as MemberAccessNode*;
            m.object = this.subst_name_expr(m.object, name, field, struct_ref, ty, span);
            return e;
        }
        if (k == NodeKind::CastExpression) {
            const ce: CastExprNode* = e as CastExprNode*;
            ce.expression = this.subst_name_expr(ce.expression, name, field, struct_ref, ty, span);
            return e;
        }
        if (k == NodeKind::ArrayAccess) {
            const a: ArrayAccessNode* = e as ArrayAccessNode*;
            a.array = this.subst_name_expr(a.array, name, field, struct_ref, ty, span);
            a.index = this.subst_name_expr(a.index, name, field, struct_ref, ty, span);
            return e;
        }
        if (k == NodeKind::TernaryExpression) {
            const t: TernaryExprNode* = e as TernaryExprNode*;
            t.condition  = this.subst_name_expr(t.condition, name, field, struct_ref, ty, span);
            t.true_expr  = this.subst_name_expr(t.true_expr, name, field, struct_ref, ty, span);
            t.false_expr = this.subst_name_expr(t.false_expr, name, field, struct_ref, ty, span);
            return e;
        }
        if (k == NodeKind::StructLiteral) {
            const sl: StructLiteralNode* = e as StructLiteralNode*;
            mut newf: FieldInit[] = [];
            for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                const fi: FieldInit = sl.field_inits[i];
                newf.push(FieldInit {
                    field_name: fi.field_name,
                    value: this.subst_name_expr(fi.value, name, field, struct_ref, ty, span),
                    span: fi.span });
            }
            sl.field_inits = newf;
            return e;
        }
        if (k == NodeKind::AwaitExpression) {
            const aw: AwaitExprNode* = e as AwaitExprNode*;
            aw.operand = this.subst_name_expr(aw.operand, name, field, struct_ref, ty, span);
            return e;
        }
        if (k == NodeKind::MatchExpression) {
            const me: MatchExprNode* = e as MatchExprNode*;
            me.subject = this.subst_name_expr(me.subject, name, field, struct_ref, ty, span);
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                if (me.arms[i] == null) { continue; }
                me.arms[i].guard = this.subst_name_expr(me.arms[i].guard, name, field, struct_ref, ty, span);
                this.subst_name_stmt(me.arms[i].body, name, field, struct_ref, ty, span);
            }
            return e;
        }
        return e;
    }

    /// Rewrite every read of `name` in statement `s` to `this.<field>`, recursing
    /// through control-flow containers (including await-free nested loops emitted
    /// wholesale). Mutates the statement's expression slots in place.
    subst_name_stmt(mut &this, s: StatementNode*, name: SymbolStr, field: SymbolStr,
                    struct_ref: TypeRef, ty: TypeRef, span: SourceSpan) -> void {
        if (s == null) { return; }
        const k: NodeKind = s.kind;
        if (k == NodeKind::ExpressionStatement) {
            const es: ExprStmtNode* = s as ExprStmtNode*;
            es.expression = this.subst_name_expr(es.expression, name, field, struct_ref, ty, span);
            return;
        }
        if (k == NodeKind::ReturnStatement) {
            const rs: ReturnStmtNode* = s as ReturnStmtNode*;
            rs.expression = this.subst_name_expr(rs.expression, name, field, struct_ref, ty, span);
            return;
        }
        if (k == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = s as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                const vd: VarDeclNode* = ds.declaration as VarDeclNode*;
                vd.initializer = this.subst_name_expr(vd.initializer, name, field, struct_ref, ty, span);
            }
            return;
        }
        if (k == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = s as BlockStmtNode*;
            for (mut i: i64 = 0; i < blk.statements.length; i++) {
                this.subst_name_stmt(blk.statements[i], name, field, struct_ref, ty, span);
            }
            return;
        }
        if (k == NodeKind::IfStatement) {
            const iff: IfStmtNode* = s as IfStmtNode*;
            iff.condition = this.subst_name_expr(iff.condition, name, field, struct_ref, ty, span);
            this.subst_name_stmt(iff.then_stmt, name, field, struct_ref, ty, span);
            this.subst_name_stmt(iff.else_stmt, name, field, struct_ref, ty, span);
            return;
        }
        if (k == NodeKind::WhileStatement) {
            const w: WhileStmtNode* = s as WhileStmtNode*;
            w.condition = this.subst_name_expr(w.condition, name, field, struct_ref, ty, span);
            this.subst_name_stmt(w.body, name, field, struct_ref, ty, span);
            return;
        }
        if (k == NodeKind::DoWhileStatement) {
            const d: DoWhileStmtNode* = s as DoWhileStmtNode*;
            d.condition = this.subst_name_expr(d.condition, name, field, struct_ref, ty, span);
            this.subst_name_stmt(d.body, name, field, struct_ref, ty, span);
            return;
        }
        if (k == NodeKind::ForStatement) {
            const f: ForStmtNode* = s as ForStmtNode*;
            if (f.init != null) {
                if ((f.init as ASTNode*).kind == NodeKind::VariableDeclaration) {
                    const vd: VarDeclNode* = f.init as VarDeclNode*;
                    vd.initializer = this.subst_name_expr(vd.initializer, name, field, struct_ref, ty, span);
                } else {
                    f.init = this.subst_name_expr(f.init as ExpressionNode*, name, field, struct_ref, ty, span) as ASTNode*;
                }
            }
            f.condition = this.subst_name_expr(f.condition, name, field, struct_ref, ty, span);
            f.update    = this.subst_name_expr(f.update, name, field, struct_ref, ty, span);
            this.subst_name_stmt(f.body, name, field, struct_ref, ty, span);
            return;
        }
        if (k == NodeKind::LoopStatement) {
            this.subst_name_stmt((s as LoopStmtNode*).body, name, field, struct_ref, ty, span);
            return;
        }
        if (k == NodeKind::MatchStatement) {
            const m: MatchStmtNode* = s as MatchStmtNode*;
            m.subject = this.subst_name_expr(m.subject, name, field, struct_ref, ty, span);
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                if (m.arms[i] != null) {
                    this.subst_name_stmt(m.arms[i].body, name, field, struct_ref, ty, span);
                }
            }
            return;
        }
    }

    /// The variable declared by a top-level `const/mut x = …;` statement
    /// (including an `await` carrier `const x = await e;`), or null if the
    /// statement declares no local.
    stmt_decl_var(&this, s: StatementNode*) -> VarDeclNode* {
        if (s == null || s.kind != NodeKind::DeclarationStatement) { return null; }
        const ds: DeclStmtNode* = s as DeclStmtNode*;
        if (ds.declaration == null || ds.declaration.kind != NodeKind::VariableDeclaration) {
            return null;
        }
        return ds.declaration as VarDeclNode*;
    }

    /// A promoted cross-await local must sit in a struct field the constructor
    /// can zero-initialize without dropping garbage — i.e. a scalar Copy type.
    /// (Aggregates / non-Copy owners are deferred; references are forbidden
    /// across a suspend entirely — see §4.)
    /// True when a parameter of this type must be carried in an `Option<T>`
    /// slot rather than copied out of its field on every poll. A non-`Copy`
    /// value has (or contains) a destructor, so the shadow prelude's `const p =
    /// this.p;` would be a move: it would run once per poll, and the move
    /// checker rightly rejects moving it again inside the dispatch loop.
    param_needs_carrier(&this, ty: TypeRef) -> boolean {
        if (!ty.is_valid()) { return false; }
        return !OwnershipQuery::is_copy(this.arena, this.ctx.get_generic_registry(),
                                        this.intern, ty);
    }

    /// True when this lowering actually carries a parameter of `ty` in a slot.
    ///
    /// The carrier only exists to survive a suspend, and it is built out of
    /// `Option`, which is looked up only when the body has an `await`. A body
    /// with none runs to completion in a single poll and reads its parameters
    /// straight out of their fields, so there is nothing to carry — and no
    /// `Option` base to carry it in.
    param_is_carried(&this, sm: PollSm*, ty: TypeRef) -> boolean {
        return sm.opt_base.is_valid() && this.param_needs_carrier(ty);
    }

    /// The struct field type backing a parameter: itself, or `Option<T>` when it
    /// has to be carried (see `param_is_carried`).
    param_field_type(mut &this, sm: PollSm*, ty: TypeRef) -> TypeRef {
        if (!this.param_is_carried(sm, ty)) { return ty; }
        mut args: TypeRef[] = [ty];
        const opt: TypeRef = this.ctx.generic_registry.instantiate(sm.opt_base, &args);
        if (!opt.is_valid()) { return ty; }
        return opt;
    }

    /// Give every state that uses a carried parameter its own binding: a state
    /// that reads it takes it out of the slot and hands it back on the way out,
    /// a state that only assigns it gets an empty binding to fill. Identical to
    /// how an aggregate local is carried across a suspend, except that the
    /// constructor — not a declaring state — put the first value in the slot.
    carry_params(mut &this, d: AsyncDecl*, sm: PollSm*, node: FunctionDeclNode*) -> void {
        const span: SourceSpan = sm.span;
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            const p: VarDeclNode* = node.parameters[i];
            if (!this.param_has_slot(d, p)) { continue; }
            const lty: TypeRef = this.param_slot_type(d, p);
            if (!this.param_is_carried(sm, lty)) { continue; }
            const pname: SymbolStr = this.param_field_name(p);
            const opt_ty: TypeRef = this.param_field_type(sm, lty);
            if (!opt_ty.is_valid() || opt_ty.id == lty.id) { continue; }
            for (mut b: i64 = 0; b < sm.blocks.length; b++) {
                const use_kind: i64 = this.block_first_use(sm.blocks[b], pname);
                if (use_kind == 0i64) { continue; }
                // Same reasoning as a local: a reassignment nested in a branch
                // keeps the incoming value on the path the branch skips, so the
                // state carries it in rather than binding a fresh one. The
                // constructor always publishes a parameter into its field, so
                // the take on entry has something to find.
                mut carried_in: boolean = (use_kind == 1i64);
                if (!carried_in && this.block_cond_write(sm.blocks[b], pname)) {
                    carried_in = true;
                }
                if (carried_in) {
                    this.prepend_agg_take(sm.blocks[b], pname, pname, lty, opt_ty,
                                          sm.struct_ref, true, span);
                    this.store_before_suspends(sm, sm.blocks[b] as StatementNode*,
                                               pname, opt_ty, pname, lty, span);
                } else if (!this.decl_at_first_assignment(sm.blocks[b], pname, lty, span)) {
                    this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                        "async: this parameter is reassigned after an `await` from inside a branch; assign it once at the top level of that step so the state machine can bind it there",
                        p.span);
                    sm.ok = false; return;
                }
                if (this.needs_handback(sm.blocks[b], pname)) {
                    sm.blocks[b].add_statement(
                        this.agg_store_stmt(sm, pname, opt_ty, pname, lty, span));
                }
            }
        }
    }

    zeroable_kind(&this, k: TypeKind) -> boolean {
        return k == TypeKind::Int || k == TypeKind::Bool
            || k == TypeKind::Float || k == TypeKind::Pointer;
    }

    /// A zero value of `field_ty` for the constructor. The promoted field is
    /// always written (`this.x = x`) before any read, so this initial value is
    /// never observed — it exists only to satisfy "all fields initialized".
    zero_value(&this, field_ty: TypeRef, span: SourceSpan) -> ExpressionNode* {
        const t: Type* = this.arena.lookup(field_ty.id);
        const k: TypeKind = if (t != null) { t.kind } else { TypeKind::Error };
        mut lit: LiteralNode* = null;
        if (k == TypeKind::Bool) {
            lit = new LiteralNode("false", LiteralKind::Boolean, span);
        } else if (k == TypeKind::Float) {
            lit = new LiteralNode("0.0", LiteralKind::Float, span);
        } else if (k == TypeKind::Pointer) {
            lit = new LiteralNode("null", LiteralKind::Null, span);
        } else {
            lit = new LiteralNode("0", LiteralKind::Integer, span);
        }
        lit.set_resolved_type(field_ty);
        return lit as ExpressionNode*;
    }

    // ---- state-machine builder (recursive; awaits across straight-line + if/else) ----

    /// Allocate a fresh empty state block; return its index (== its state value).
    sm_alloc(mut &this, sm: PollSm*) -> i64 {
        const idx: i64 = sm.blocks.length;
        sm.blocks.push(new BlockStmtNode(sm.span));
        return idx;
    }

    /// Append `this.state = <to>;` to state block `from` — a forward edge: the
    /// arm falls off and the enclosing loop re-dispatches the advanced state.
    sm_goto(mut &this, sm: PollSm*, from: i64, to: i64) -> void {
        sm.blocks[from].add_statement(this.assign_member_stmt(
            sm.struct_ref, sm.state_sym, sm.u32_ty, this.u32_lit(to as u64, sm.span), sm.span));
    }

    /// Lower every statement of `blk` starting in state `cur`; return the state
    /// execution continues in after the block.
    lower_block_sm(mut &this, sm: PollSm*, blk: BlockStmtNode*, cur: i64) -> i64 {
        mut s: i64 = cur;
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            if (!sm.ok) { return s; }
            const st: StatementNode* = blk.statements[i];
            s = this.lower_stmt_sm(sm, st, s);
            // A `return`/`break`/`continue` transfers control off this block; a
            // following statement (unreachable source) would otherwise be emitted
            // AFTER the edge assignment and silently run before the arm falls off.
            if (this.stmt_diverges(st)) { return s; }
        }
        return s;
    }

    /// Lower a branch body (a block, or a bare statement / else-if) starting in
    /// state `entry`; return its end state.
    lower_branch_sm(mut &this, sm: PollSm*, branch: StatementNode*, entry: i64) -> i64 {
        if (branch == null) { return entry; }
        if (branch.kind == NodeKind::BlockStatement) {
            return this.lower_block_sm(sm, branch as BlockStmtNode*, entry);
        }
        return this.lower_stmt_sm(sm, branch, entry);
    }

    /// Lower a single statement. await-free -> emit as-is (returns wrapped in
    /// `Poll::Ready`); a top-level `await` carrier or an `if` holding an `await`
    /// -> explode into states; any other await-carrying shape (nested in an
    /// expression, or inside a loop or `match`) -> E0600 (a later increment).
    lower_stmt_sm(mut &this, sm: PollSm*, stmt: StatementNode*, cur: i64) -> i64 {
        if (stmt == null) { return cur; }
        const k: NodeKind = stmt.kind;
        if (k == NodeKind::BreakStatement)    { return this.lower_break_sm(sm, cur, stmt.span); }
        if (k == NodeKind::ContinueStatement) { return this.lower_continue_sm(sm, cur, stmt.span); }
        if (!this.stmt_needs_explode(stmt)) {
            this.rewrite_returns(stmt, sm.poll_out, sm.span);
            sm.blocks[cur].add_statement(stmt);
            return cur;
        }
        const aw: AwaitExprNode* = this.stmt_toplevel_await(stmt);
        if (aw != null) { return this.lower_carrier_sm(sm, stmt, aw, cur); }
        // A bare `{ … await … }` block is just a nested statement sequence: lower
        // it into the current state chain (its locals already got their own scope
        // frame from the pre-flattening alpha-rename).
        if (k == NodeKind::BlockStatement)   { return this.lower_block_sm(sm, stmt as BlockStmtNode*, cur); }
        if (k == NodeKind::IfStatement)      { return this.lower_if_sm(sm, stmt as IfStmtNode*, cur); }
        if (k == NodeKind::WhileStatement)   { return this.lower_while_sm(sm, stmt as WhileStmtNode*, cur); }
        if (k == NodeKind::DoWhileStatement) { return this.lower_do_while_sm(sm, stmt as DoWhileStmtNode*, cur); }
        if (k == NodeKind::ForStatement)     { return this.lower_for_sm(sm, stmt as ForStmtNode*, cur); }
        if (k == NodeKind::LoopStatement)    { return this.lower_loop_sm(sm, stmt as LoopStmtNode*, cur); }
        if (k == NodeKind::MatchStatement)   { return this.lower_match_sm(sm, stmt as MatchStmtNode*, cur); }
        // No `await` here means the statement was exploded for its `break`/
        // `continue` alone, and the only expression form that can hold one is a
        // `match` used as an expression. Its arms are part of an expression, so
        // the edge cannot become a state transition the way a `match` STATEMENT
        // arm's can; emitted as-is it would compile to a native `break` out of
        // the state-dispatch loop rather than the user's loop.
        if (this.stmt_await_count(stmt) == 0i64) {
            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                "async: a `break`/`continue` inside a `match` EXPRESSION arm is not supported inside a loop that awaits; write the `match` as a statement that assigns the value",
                stmt.span);
            sm.ok = false;
            return cur;
        }
        this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
            "async: this `await` shape is not supported yet; write it as `const x = await e;` / `return await e;` / `await e;`, inside an `if`/`else` branch, inside a `while`/`for`/`loop`/`do-while` body, or inside a `match` arm (an `await` nested in an expression arrives in a later increment)",
            stmt.span);
        sm.ok = false;
        return cur;
    }

    /// The type of the receiver pointer the future `fi` stores, or an invalid ref
    /// when it stores none.
    ///
    /// Only an `async` method with a `&this` / `mut &this` receiver keeps one: a
    /// free function and a `static` method have no receiver slot at all, and a
    /// by-value receiver holds the object itself, which cannot go stale. The
    /// slot's pointer-ness is the test rather than its name, because a by-value
    /// receiver lands in a slot of the same name.
    ///
    /// A future generic in its owner arrives here as an `InstantiatedType`: its
    /// fields are filled in by specialization, which has not run yet, so the slot
    /// is looked for on the TEMPLATE the instantiation came from — the struct
    /// `lower` did populate. Answering from the instantiation alone would find no
    /// field and silently skip the refresh, leaving the method writing through a
    /// pointer to storage the frame has since stopped using.
    ///
    /// The type returned is therefore the template's, which for such a future
    /// still mentions the owner's parameters. It answers "is there a receiver
    /// pointer to refresh"; the pointer type to store at a given call site comes
    /// from the receiver place there (see `lower_carrier_sm`).
    awaited_recv_ptr_type(&this, fi: TypeRef) -> TypeRef {
        mut t: Type* = this.arena.lookup(fi.id);
        if (t != null && t.kind != TypeKind::Struct) {
            const base: TypeRef = this.arena.inst_generic_base(fi);
            t = if (base.is_valid()) { this.arena.lookup(base.id) } else { null };
        }
        if (t == null || t.kind != TypeKind::Struct) { return TypeRef::invalid(); }
        const st: StructType* = t as StructType*;
        mut f: FieldInfo* = st.get_field(this.recv_sym);
        if (f == null) { return TypeRef::invalid(); }
        const ft: Type* = this.arena.lookup(f.field_type.id);
        if (ft == null || ft.kind != TypeKind::Pointer) { return TypeRef::invalid(); }
        return f.field_type;
    }

    /// The receiver place of `e` when `e` is a method call, or null otherwise.
    ///
    /// A method call is `Call(callee = MemberAccess(object = <receiver>))`, and
    /// the `&` that turns the receiver into the callee's receiver pointer is
    /// implicit in the call ABI. The place itself is therefore what has to be
    /// re-addressed; there is no `&` node to find.
    awaited_recv_place(&this, e: ExpressionNode*) -> ExpressionNode* {
        if (e == null || (e as ASTNode*).kind != NodeKind::CallExpression) { return null; }
        const c: CallExprNode* = e as CallExprNode*;
        if (c.callee == null || (c.callee as ASTNode*).kind != NodeKind::MemberAccess) {
            return null;
        }
        return (c.callee as MemberAccessNode*).object;
    }

    /// A fresh copy of the pure-read place `e`, or null when `e` is not one.
    ///
    /// Fresh nodes rather than the originals: the place already has a parent in
    /// the state that builds the sub-future, and a node reachable from two
    /// parents is walked — and drop-analysed — twice. Only pure reads qualify,
    /// because this copy is re-evaluated on every poll and repeating a call or an
    /// assignment would repeat its effect.
    rebuild_place(mut &this, e: ExpressionNode*) -> ExpressionNode* {
        if (e == null) { return null; }
        const k: NodeKind = (e as ASTNode*).kind;
        const ty: TypeRef = e.resolved_type;
        const span: SourceSpan = (e as ASTNode*).span;
        if (k == NodeKind::Identifier) {
            return this.ident((e as IdentifierNode*).name, ty, span);
        }
        if (k == NodeKind::MemberAccess) {
            const ma: MemberAccessNode* = e as MemberAccessNode*;
            mut obj: ExpressionNode* = this.rebuild_place(ma.object);
            if (obj == null) { return null; }
            return this.member(obj, ma.member, ty, span);
        }
        if (k == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = e as UnaryExprNode*;
            // Only `*p` is a place: `&x` names no storage of its own, `++`/`--`
            // write, and an overloaded operator is a call.
            if (u.op.kind != TokenType::Star || u.desugared_call != null) { return null; }
            mut inner: ExpressionNode* = this.rebuild_place(u.operand);
            if (inner == null) { return null; }
            return this.deref(inner, ty, span);
        }
        return null;
    }

    /// `<obj>.<field> = <rhs>;` — the arbitrary-object twin of
    /// `assign_member_stmt`, which can only write through `this`.
    assign_field_of_stmt(&this, obj: ExpressionNode*, field: SymbolStr, field_ty: TypeRef,
                         rhs: ExpressionNode*, span: SourceSpan) -> StatementNode* {
        mut lhs: ExpressionNode* = this.member(obj, field, field_ty, span);
        const eq: Token = Token::new(TokenType::Equal, "=", span.start_line as int, span.start_col as int);
        mut assign: BinaryExprNode* = new BinaryExprNode(eq, lhs, rhs, span);
        assign.set_resolved_type(this.arena.get_void());
        mut es: ExprStmtNode* = new ExprStmtNode(assign as ExpressionNode*, span);
        return es as StatementNode*;
    }

    /// Lower a top-level `await` carrier (`const/mut x = await e;`,
    /// `return await e;`, `await e;`): stash the sub-future in `cur`, allocate a
    /// resume state that polls it (suspending on `Pending`, re-entering itself),
    /// and run the carrier there with its `await` replaced by the ready result.
    lower_carrier_sm(mut &this, sm: PollSm*, stmt: StatementNode*, aw: AwaitExprNode*, cur: i64) -> i64 {
        const span: SourceSpan = sm.span;
        if (aw.operand == null) {
            this.ctx.emit_error_at(ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
                "async: malformed `await` (no operand)", span);
            sm.ok = false; return cur;
        }
        const fi: TypeRef = aw.operand.resolved_type;
        const ao: TypeRef = aw.resolved_type;
        if (!fi.is_valid() || !ao.is_valid()) {
            this.ctx.emit_error_at(ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
                "async: could not resolve an awaited future's type (its operand must implement `Future`)", span);
            sm.ok = false; return cur;
        }
        // The sub-future is stashed in a field and polled again from a later
        // state's frame, so an address of the current frame handed to it is
        // dangling by the time the operation writes through it — and writes to a
        // dead frame slot corrupt silently instead of faulting.
        const op_root: SymbolStr = this.frame_addr_root_expr(sm, aw.operand);
        if (op_root.is_valid()) {
            this.ctx.emit_error_at(ErrorCode::E0455_DANGLING_POINTER,
                format("async: this `await` hands the address of the local or parameter `%s` to a future that outlives the current step; each poll runs on a fresh frame, so the address is dangling when the future resumes — have the caller own the storage and pass a pointer parameter, or use an operation that owns the buffer itself",
                       this.intern.resolve(this.strip_local_marker(op_root))),
                aw.span);
            sm.ok = false; return cur;
        }

        // A future stores every future it awaits as a field, so awaiting one that
        // (transitively) stores THIS one would make the state machine contain
        // itself: no finite size, and the layout that results overlaps the nested
        // future with the outer one and re-polls a completed sub-future at
        // runtime. There is no boxing escape hatch to offer yet, so the recursion
        // itself has to go.
        if (this.future_reaches(fi.id, sm.struct_ref.id)) {
            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                "async: this `await` would make the state machine contain itself, which has no finite size (the awaited future leads back to this one); rewrite the recursion as a loop",
                aw.span);
            sm.ok = false; return cur;
        }
        this.edge_from.push(sm.struct_ref.id);
        this.edge_to.push(fi.id);

        const k: i64 = sm.naw;
        sm.naw += 1i64;
        const fut_sym: SymbolStr = this.intern.intern(format("fut_%lld", k));
        mut opt_args: TypeRef[] = [fi];
        const fut_opt: TypeRef = this.ctx.generic_registry.instantiate(sm.opt_base, &opt_args);
        sm.fut_syms.push(fut_sym);
        sm.fut_opt.push(fut_opt);

        // In `cur`: build the sub-future lazily, then advance to the resume state.
        sm.blocks[cur].add_statement(this.assign_member_stmt(sm.struct_ref, fut_sym, fut_opt,
            this.option_some(aw.operand, fut_opt, span), span));
        const resume: i64 = this.sm_alloc(sm);
        this.sm_goto(sm, cur, resume);

        // Resume state: take/poll the sub-future; on `Pending` put it back, mark
        // this state, and suspend; else bind the ready value and run the carrier.
        const sub_sym: SymbolStr = this.intern.intern(format("__sub_%lld", k));
        mut take_call: ExpressionNode* = this.method_call0(
            this.member(this.this_ident(sm.struct_ref, span), fut_sym, fut_opt, span),
            "take", fut_opt, span);
        mut unwrap_call: ExpressionNode* = this.method_call0(take_call, "unwrap", fi, span);
        sm.blocks[resume].add_statement(this.var_decl_stmt(sub_sym, true, fi, unwrap_call, span));

        // The sub-future recorded the ADDRESS of its receiver when it was built,
        // and that address is only right for the state that built it. An owning
        // receiver promoted across states lives in a fresh block-local on every
        // poll — taken from its frame field on entry, handed back on the way out
        // — and the frame itself may have been moved between polls. So re-address
        // the receiver from this frame's own storage before every poll. Without
        // it an `async` method with a `&this` receiver reads and writes through a
        // stale pointer from its second poll onwards, corrupting silently instead
        // of faulting.
        const recv_slot_ty: TypeRef = this.awaited_recv_ptr_type(fi);
        if (recv_slot_ty.is_valid()) {
            mut place: ExpressionNode* = this.awaited_recv_place(aw.operand);
            if (place == null) {
                this.ctx.emit_error_at(ErrorCode::E0455_DANGLING_POINTER,
                    "async: this `await` polls an `async` method's future that the awaited expression did not itself produce, so the receiver it points at cannot be re-addressed when the future resumes; await the method call directly (`await r.m(...)`) rather than storing its future first",
                    aw.span);
                sm.ok = false; return cur;
            }
            mut fresh: ExpressionNode* = this.rebuild_place(place);
            if (fresh == null) {
                this.ctx.emit_error_at(ErrorCode::E0455_DANGLING_POINTER,
                    "async: this `await` calls an `async` method on a receiver that names no storage (a temporary, or the result of a call), so the receiver dies with the step that built the future; bind it to a local and await on that (`mut r = <expr>; await r.m(...);`)",
                    aw.span);
                sm.ok = false; return cur;
            }
            // A receiver reached through a pointer already IS the address the
            // callee stored; taking its address again would hand over the slot
            // holding the pointer instead of the object.
            //
            // The pointer's type comes from the place rather than from the slot:
            // the slot's is the template's, and for a future generic in its owner
            // that still mentions the owner's parameters, which cannot type a node
            // in a caller that is already concrete. The place is the receiver
            // itself, so its type is the owner's here.
            const place_ty: TypeRef = place.resolved_type;
            mut place_t: Type* = null;
            if (place_ty.is_valid()) { place_t = this.arena.lookup(place_ty.id); }
            const via_ptr: boolean = place_t != null && place_t.kind == TypeKind::Pointer;
            mut recv_ptr_ty: TypeRef = recv_slot_ty;
            if (place_ty.is_valid()) {
                recv_ptr_ty = if (via_ptr) { place_ty } else { this.arena.get_pointer_to(place_ty) };
            }
            mut recv_val: ExpressionNode* = fresh;
            if (!via_ptr) { recv_val = this.addr_of(fresh, recv_ptr_ty, span); }
            sm.blocks[resume].add_statement(this.assign_field_of_stmt(
                this.ident(sub_sym, fi, span), this.recv_sym, recv_ptr_ty, recv_val, span));
        }

        // The sub-future's `poll` yields `Poll<F_k::Output>`, which is the type of
        // the awaited expression — NOT this function's own `Poll<Output>`. They
        // coincide only when a function awaits a future that produces exactly what
        // the function returns; typing the temp with `sm.poll_out` would reject
        // every other await with a mismatched-type error.
        mut sub_poll_args: TypeRef[] = [ao];
        const sub_poll_out: TypeRef =
            this.ctx.generic_registry.instantiate(sm.poll_base, &sub_poll_args);
        const poll_sym: SymbolStr = this.intern.intern(format("__poll_%lld", k));
        mut poll_call: ExpressionNode* = this.method_call1(
            this.ident(sub_sym, fi, span), "poll",
            this.ident(sm.cx_sym, sm.ctx_ptr_ty, span), sub_poll_out, span);
        sm.blocks[resume].add_statement(this.var_decl_stmt(poll_sym, true, sub_poll_out, poll_call, span));

        mut pend: BlockStmtNode* = new BlockStmtNode(span);
        pend.add_statement(this.assign_member_stmt(sm.struct_ref, fut_sym, fut_opt,
            this.option_some(this.ident(sub_sym, fi, span), fut_opt, span), span));
        pend.add_statement(this.assign_member_stmt(sm.struct_ref, sm.state_sym, sm.u32_ty,
            this.u32_lit(resume as u64, span), span));
        pend.add_statement(new ReturnStmtNode(this.poll_pending(sm.poll_out, span), span) as StatementNode*);
        sm.blocks[resume].add_statement(new IfStmtNode(
            this.method_call0(this.ident(poll_sym, sub_poll_out, span), "is_pending", this.arena.get_bool(), span),
            pend as StatementNode*, null, span) as StatementNode*);

        const await_sym: SymbolStr = this.intern.intern(format("__await_%lld", k));
        sm.blocks[resume].add_statement(this.var_decl_stmt(await_sym, false, ao,
            this.method_call0(this.ident(poll_sym, sub_poll_out, span), "into_ready", ao, span), span));

        this.rewrite_carrier_await(stmt, this.ident(await_sym, ao, span));
        this.rewrite_returns(stmt, sm.poll_out, span);
        sm.blocks[resume].add_statement(stmt);
        return resume;
    }

    /// Lower an `if`/`else` whose branches contain `await`s: the condition (in
    /// `cur`) dispatches to a per-branch entry state; each branch runs as its own
    /// state sequence and, unless it returns, converges on a shared join state.
    lower_if_sm(mut &this, sm: PollSm*, iff: IfStmtNode*, cur: i64) -> i64 {
        const span: SourceSpan = sm.span;
        // The condition is evaluated once, before either branch, so a suspend in
        // it runs as its own states ahead of the dispatch.
        const hc: HoistedExpr = this.lower_hoisted(sm, iff.condition, cur);
        if (!sm.ok) { return cur; }
        const at: i64 = hc.end;
        const then_entry: i64 = this.sm_alloc(sm);
        mut else_entry: i64 = -1i64;
        if (iff.else_stmt != null) { else_entry = this.sm_alloc(sm); }
        const join: i64 = this.sm_alloc(sm);

        // In `at`: evaluate the condition and set the taken branch's entry state
        // (or the join directly when there is no else), then fall off to
        // re-dispatch. Both arms assign, so `at` always advances.
        mut then_set: BlockStmtNode* = new BlockStmtNode(span);
        then_set.add_statement(this.assign_member_stmt(sm.struct_ref, sm.state_sym, sm.u32_ty,
            this.u32_lit(then_entry as u64, span), span));
        const else_target: i64 = if (else_entry >= 0i64) { else_entry } else { join };
        mut else_set: BlockStmtNode* = new BlockStmtNode(span);
        else_set.add_statement(this.assign_member_stmt(sm.struct_ref, sm.state_sym, sm.u32_ty,
            this.u32_lit(else_target as u64, span), span));
        sm.blocks[at].add_statement(new IfStmtNode(hc.expr,
            then_set as StatementNode*, else_set as StatementNode*, span) as StatementNode*);

        // Whether a branch converges on the join is a property of the SOURCE
        // branch (does it end in a `return`/`break`/`continue`?), not of the
        // lowered block: a branch ending in `break` leaves its final state block
        // holding a `this.state = <after>;` edge, which is not a divergence marker.
        const t_end: i64 = this.lower_branch_sm(sm, iff.then_stmt, then_entry);
        if (!sm.ok) { return cur; }
        if (!this.stmt_diverges(iff.then_stmt)) { this.sm_goto(sm, t_end, join); }
        if (else_entry >= 0i64) {
            const e_end: i64 = this.lower_branch_sm(sm, iff.else_stmt, else_entry);
            if (!sm.ok) { return cur; }
            if (!this.stmt_diverges(iff.else_stmt)) { this.sm_goto(sm, e_end, join); }
        }
        return join;
    }

    /// Lower a `match` whose arms contain `await`s. In `cur` a dispatch `match`
    /// (reusing the original patterns + guards) captures each awaiting arm's
    /// scalar pattern bindings into fields and jumps to a per-arm entry state;
    /// each arm body runs as its own state sequence and, unless it diverges,
    /// converges on a shared join state. An await-free arm runs wholesale in the
    /// dispatch arm (its bindings stay native). A non-exhaustive match gets a
    /// synthesized `_ => join` so a non-matching subject continues past the
    /// `match` rather than spinning the dispatch loop.
    ///
    /// A guard that itself suspends cannot be evaluated inside that dispatch, so
    /// such a `match` takes the decision-chain form instead
    /// (`lower_match_chain_sm`). The two produce the same behaviour; the dispatch
    /// is kept for every other match because it costs one state rather than one
    /// per arm.
    lower_match_sm(mut &this, sm: PollSm*, m: MatchStmtNode*, cur: i64) -> i64 {
        for (mut gi: i64 = 0; gi < m.arms.length; gi++) {
            if (m.arms[gi] != null && this.expr_await_count(m.arms[gi].guard) > 0i64) {
                return this.lower_match_chain_sm(sm, m, cur);
            }
        }

        const span: SourceSpan = sm.span;
        // The subject is evaluated once, before any arm, so a suspend in it runs
        // as its own states ahead of the dispatch.
        const hs: HoistedExpr = this.lower_hoisted(sm, m.subject, cur);
        if (!sm.ok) { return cur; }
        const at: i64 = hs.end;
        const subject_type: TypeRef = hs.expr.resolved_type;
        const exhaustive: boolean = this.patterns.match_is_exhaustive(hs.expr, m.arms);

        const join: i64 = this.sm_alloc(sm);
        mut dispatch: MatchStmtNode* = new MatchStmtNode(hs.expr, span);
        for (mut ai: i64 = 0; ai < m.arms.length; ai++) {
            const arm: MatchArmNode* = m.arms[ai];
            if (arm == null) { continue; }

            mut cap: BlockStmtNode* = new BlockStmtNode(span);
            if (!this.stmt_needs_explode(arm.body)) {
                // No suspend and no edge into an enclosing exploded loop: run the
                // arm body (bindings intact) directly in the dispatch arm, then
                // converge on the join unless the body itself diverges.
                this.rewrite_returns(arm.body, sm.poll_out, span);
                cap.add_statement(arm.body);
                if (!this.stmt_diverges(arm.body)) { this.append_goto(cap, sm, join, span); }
            } else {
                const entry: i64 = this.sm_alloc(sm);
                this.capture_arm_bindings(sm, arm, subject_type, entry, cap, false, false);
                if (!sm.ok) { return cur; }
                this.append_goto(cap, sm, entry, span);
                const end: i64 = this.lower_branch_sm(sm, arm.body, entry);
                if (!sm.ok) { return cur; }
                if (!this.stmt_diverges(arm.body)) { this.sm_goto(sm, end, join); }
            }

            mut darm: MatchArmNode* = new MatchArmNode(span);
            for (mut pi: i64 = 0; pi < arm.patterns.length; pi++) {
                darm.add_pattern(arm.patterns[pi]);
            }
            if (arm.guard != null) { darm.set_guard(arm.guard); }
            darm.set_body(cap as StatementNode*);
            dispatch.add_arm(darm);
        }
        if (!sm.ok) { return cur; }

        // A non-exhaustive `match` normally falls through to the following
        // statement; in the flattened machine that must be an explicit edge to
        // the join, or a non-matching subject would fall off the arm and respin
        // the (unchanged) dispatch state forever.
        if (!exhaustive) {
            mut wblk: BlockStmtNode* = new BlockStmtNode(span);
            this.append_goto(wblk, sm, join, span);
            dispatch.add_arm(this.match_arm_wild(wblk, span));
        }

        sm.blocks[at].add_statement(dispatch as StatementNode*);
        return join;
    }

    /// Promote every scalar binding of `arm` that its body — or, when the guard
    /// runs in a state of its own, its guard — reads into a struct field,
    /// appending the capture stores to `cap` and repointing those reads at the
    /// field.
    ///
    /// A binding is bound where the pattern matched but read in a DIFFERENT state
    /// (the arm's body at `entry`, and the guard's own state before it), so it
    /// cannot live on the native stack. The capture reads the pattern-bound name,
    /// which is valid in the dispatch arm's scope; every read elsewhere is
    /// rewritten.
    ///
    /// `rewrite_guard` must be set exactly when the guard was lifted out of the
    /// pattern arm. A guard still ATTACHED to its pattern has the pattern's names
    /// in scope and would break if they were rewritten to fields the arm has not
    /// stored yet.
    capture_arm_bindings(mut &this, sm: PollSm*, arm: MatchArmNode*, subject_type: TypeRef,
                         entry: i64, cap: BlockStmtNode*, rewrite_guard: boolean,
                         no_move_out: boolean) -> void {
        const span: SourceSpan = sm.span;
        mut bs: BindingCapture = BindingCapture { names: [], tys: [] };
        this.collect_arm_bindings(arm, subject_type, &bs);
        for (mut bi: i64 = 0; bi < bs.names.length; bi++) {
            const bname: SymbolStr = bs.names[bi];
            const in_guard: boolean = rewrite_guard && this.name_read_in_expr(arm.guard, bname);
            if (!this.name_read_in_stmt(arm.body, bname) && !in_guard) { continue; }
            const bt: TypeRef = bs.tys[bi];
            const bt_t: Type* = this.arena.lookup(bt.id);
            const bk: TypeKind = if (bt_t != null) { bt_t.kind } else { TypeKind::Error };
            if (!bt.is_valid() || bk == TypeKind::Error) {
                this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                    "async: could not resolve a `match`-arm binding's type to carry it across an `await`",
                    span);
                sm.ok = false; return;
            }
            if (bk == TypeKind::Reference) {
                this.ctx.emit_error_at(ErrorCode::E0455_DANGLING_POINTER,
                    "async: a `match`-arm binding that is a reference cannot be held live across an `await` (owned values only)",
                    span);
                sm.ok = false; return;
            }
            if (!this.zeroable_kind(bk)) {
                // An aggregate cannot be re-read from a field the way a scalar
                // can — reading one copies it, and a copy of a value that owns a
                // resource frees it twice. It moves through an `Option` carrier
                // instead: the dispatch arm hands the binding over, and the arm's
                // own state takes it back as a local. The body then reads an
                // ordinary local, which is what lets the generic cross-state
                // promotion carry it further if a later state needs it.
                //
                // The local is given a NAME OF ITS OWN and the body's reads are
                // pointed at it, so the pattern's name occurs only in the
                // hand-over. A local sharing the pattern's name would make that
                // hand-over look like a read of the local from a state before the
                // one declaring it, and the promotion would insert a take of a
                // field nothing had stored yet.
                //
                // A guard cannot take part in this: the take happens on entry to
                // ONE state, and the guard's state runs before the body's and may
                // fall through to the next arm without ever reaching it, which
                // would leave the carrier empty for an arm that still owns it.
                if (in_guard) {
                    this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                        "async: a `match`-arm guard that awaits cannot read an aggregate binding of its own pattern; test it in the arm body instead",
                        span);
                    sm.ok = false; return;
                }
                // Taking an owning payload out of the subject leaves the subject
                // moved-from, and in a guarded chain the subject is matched again
                // by every later test. A scalar binding copies and is fine; this
                // one would hand the next test a hollowed-out value.
                if (no_move_out) {
                    this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                        "async: a `match` with an awaiting arm guard cannot bind an owning payload out of its subject, because a guard that fails re-matches that subject against the following arms; bind it in a nested `match` inside the arm body instead",
                        span);
                    sm.ok = false; return;
                }
                const afield: SymbolStr = this.intern.intern(
                    format("__bind_%lld_%s", entry, this.intern.resolve(bname)));
                mut bopt_args: TypeRef[] = [bt];
                const bopt_ty: TypeRef =
                    this.ctx.generic_registry.instantiate(sm.opt_base, &bopt_args);
                const blocal: SymbolStr = this.mint_temp(
                    format("%s$bind", this.intern.resolve(bname)));
                this.subst_mode = this.subst_to_local();
                this.subst_name_stmt(arm.body, bname, blocal, sm.struct_ref, bt, span);
                this.subst_mode = this.subst_to_field();
                cap.add_statement(this.agg_store_stmt(sm, afield, bopt_ty, bname, bt, span));
                this.prepend_agg_take(sm.blocks[entry], blocal, afield, bt, bopt_ty,
                                      sm.struct_ref, false, span);
                sm.prom_field.push(afield);
                sm.prom_tys.push(bopt_ty);
                sm.prom_opt.push(true);
                sm.nprom += 1i64;
                continue;
            }
            const field: SymbolStr = this.intern.intern(
                format("__bind_%lld_%s", entry, this.intern.resolve(bname)));
            this.subst_name_stmt(arm.body, bname, field, sm.struct_ref, bt, span);
            if (in_guard) {
                arm.guard = this.subst_name_expr(arm.guard, bname, field,
                                                 sm.struct_ref, bt, span);
            }
            cap.add_statement(this.assign_member_stmt(
                sm.struct_ref, field, bt, this.ident(bname, bt, span), span));
            sm.prom_field.push(field);
            sm.prom_tys.push(bt);
            sm.prom_opt.push(false);
            sm.nprom += 1i64;
        }
    }

    /// Lower a `match` in which some arm's GUARD suspends.
    ///
    /// The ordinary lowering emits ONE dispatch `match` reusing the source
    /// patterns AND guards. A suspending guard cannot live there: it runs after
    /// its own pattern matched and before the next arm is tried, so its suspend
    /// would land in the middle of the dispatch — and a `match` has no way to
    /// resume into the middle of itself.
    ///
    /// The match therefore becomes a DECISION CHAIN, one test state per arm:
    ///
    ///     t_k : match (subj) { pat_k => { capture; -> g_k }   _ => { -> t_k+1 } }
    ///     g_k : <guard, may suspend>;  true -> entry_k,  false -> t_k+1
    ///     t_n : -> join                                  (nothing matched)
    ///
    /// which is precisely what "a false guard tries the next arm" means once the
    /// guard is no longer something the dispatch can evaluate in one go. An arm
    /// whose guard does NOT suspend keeps that guard on its pattern, where a
    /// false guard already falls through to the same `_ => -> t_k+1` — so only
    /// the arms that need states cost states.
    ///
    /// The subject is evaluated ONCE — re-evaluating it per arm would run its
    /// side effects once per arm tried — and stored in a field of the future,
    /// which every test reads. The chain owns that field rather than leaving it
    /// to the cross-state promotion: the promotion treats a `match` subject as
    /// CONSUMED by the match (true of the single dispatch, which matches it
    /// once), so it would publish nothing and the second test would take from an
    /// empty carrier. Here the subject is deliberately still live after a test
    /// that did not match, so it is handed back after every one.
    ///
    /// That hand-back is only sound while no test moves out of the subject, which
    /// is why an arm binding an aggregate payload is rejected below: a scalar
    /// binding copies out and leaves the subject whole, an owning one does not,
    /// and a later test would then match a moved-from value.
    lower_match_chain_sm(mut &this, sm: PollSm*, m: MatchStmtNode*, cur: i64) -> i64 {
        const span: SourceSpan = sm.span;
        const hs: HoistedExpr = this.lower_hoisted(sm, m.subject, cur);
        if (!sm.ok) { return cur; }
        const at: i64 = hs.end;
        const subject_type: TypeRef = hs.expr.resolved_type;
        if (!subject_type.is_valid()) {
            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                "async: could not resolve the type of a `match` subject whose arm guard awaits",
                span);
            sm.ok = false; return cur;
        }
        const join: i64 = this.sm_alloc(sm);

        // The subject's home for the length of the chain. A scalar sits in a
        // plain field and every test reads a copy; anything else has no zero
        // value the constructor could give the field, so it rides in the same
        // `Option` carrier an aggregate local uses — taken at the top of a test
        // and handed back at the bottom.
        const subj_t: Type* = this.arena.lookup(subject_type.id);
        const subj_kind: TypeKind = if (subj_t != null) { subj_t.kind } else { TypeKind::Error };
        const subj_scalar: boolean = this.zeroable_kind(subj_kind);
        // Minted rather than derived from the state index: two chains that begin
        // in the same state would otherwise share a field and overwrite each
        // other's subject.
        const subj_field: SymbolStr = this.mint_temp("__msubj");
        mut subj_opt_ty: TypeRef = TypeRef::invalid();
        if (subj_scalar) {
            sm.blocks[at].add_statement(this.assign_member_stmt(
                sm.struct_ref, subj_field, subject_type, hs.expr, span));
            sm.prom_field.push(subj_field);
            sm.prom_tys.push(subject_type);
            sm.prom_opt.push(false);
        } else {
            mut subj_args: TypeRef[] = [subject_type];
            subj_opt_ty = this.ctx.generic_registry.instantiate(sm.opt_base, &subj_args);
            if (!subj_opt_ty.is_valid()) {
                this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                    "async: could not build the carrier for a `match` subject whose arm guard awaits",
                    span);
                sm.ok = false; return cur;
            }
            const seed: SymbolStr = this.mint_temp("match$subj");
            sm.blocks[at].add_statement(
                this.var_decl_stmt(seed, false, subject_type, hs.expr, span));
            sm.blocks[at].add_statement(
                this.agg_store_stmt(sm, subj_field, subj_opt_ty, seed, subject_type, span));
            sm.prom_field.push(subj_field);
            sm.prom_tys.push(subj_opt_ty);
            sm.prom_opt.push(true);
        }
        sm.nprom += 1i64;

        // One test state per arm, all allocated up front: a failed test or a
        // false guard jumps to the NEXT arm's test, so every target has to exist
        // before any arm is emitted. The subject's state only publishes and then
        // enters the chain, which keeps every test block the same shape.
        mut tests: i64[] = [];
        for (mut ai: i64 = 0; ai < m.arms.length; ai++) { tests.push(this.sm_alloc(sm)); }

        // Where each arm goes when it does not match: the next arm that HAS a
        // test, or the join. A null arm is emitted by nothing, so its state stays
        // empty — and an empty state does not fall through, it re-dispatches
        // itself forever. Resolved back-to-front so a run of them is skipped.
        mut nexts: i64[] = [];
        for (mut ai: i64 = 0; ai < m.arms.length; ai++) { nexts.push(join); }
        mut after: i64 = join;
        for (mut ai: i64 = m.arms.length - 1i64; ai >= 0i64; ai--) {
            nexts[ai] = after;
            if (m.arms[ai] != null) { after = tests[ai]; }
        }
        this.sm_goto(sm, at, after);

        for (mut ai: i64 = 0; ai < m.arms.length; ai++) {
            const arm: MatchArmNode* = m.arms[ai];
            if (arm == null) { continue; }
            const next: i64 = nexts[ai];
            const guard_suspends: boolean = this.expr_await_count(arm.guard) > 0i64;

            mut cap: BlockStmtNode* = new BlockStmtNode(span);
            if (!guard_suspends && !this.stmt_needs_explode(arm.body)) {
                // Neither the guard nor the body needs a state: the arm runs
                // whole inside its own test, exactly as in the dispatch form.
                this.rewrite_returns(arm.body, sm.poll_out, span);
                cap.add_statement(arm.body);
                if (!this.stmt_diverges(arm.body)) { this.append_goto(cap, sm, join, span); }
            } else {
                const entry: i64 = this.sm_alloc(sm);
                this.capture_arm_bindings(sm, arm, subject_type, entry, cap,
                                          guard_suspends, !subj_scalar);
                if (!sm.ok) { return cur; }
                if (guard_suspends) {
                    // The pattern matched, so the guard decides; it gets the
                    // state the dispatch could not give it.
                    const gstate: i64 = this.sm_alloc(sm);
                    this.append_goto(cap, sm, gstate, span);
                    const ghs: HoistedExpr = this.lower_hoisted(sm, arm.guard, gstate);
                    if (!sm.ok) { return cur; }
                    this.emit_cond_dispatch(sm, ghs.end, ghs.expr, entry, next, span);
                } else {
                    this.append_goto(cap, sm, entry, span);
                }
                const end: i64 = this.lower_branch_sm(sm, arm.body, entry);
                if (!sm.ok) { return cur; }
                if (!this.stmt_diverges(arm.body)) { this.sm_goto(sm, end, join); }
            }

            // The subject this test matches. The scalar form reads the field
            // directly (a copy, so nothing has to be given back); the carrier
            // form takes it into a local of THIS state — a fresh name per test,
            // so the cross-state promotion sees a local declared and used in one
            // block and leaves it alone — and hands it back below.
            mut subj_local: SymbolStr = SymbolStr::empty();
            mut subj_read: ExpressionNode* = null;
            if (subj_scalar) {
                subj_read = this.member(this.this_ident(sm.struct_ref, span),
                                        subj_field, subject_type, span);
            } else {
                subj_local = this.mint_temp("match$subj");
                this.prepend_agg_take(sm.blocks[tests[ai]], subj_local, subj_field,
                                      subject_type, subj_opt_ty, sm.struct_ref, false, span);
                subj_read = this.ident(subj_local, subject_type, span);
            }
            mut test: MatchStmtNode* = new MatchStmtNode(subj_read, span);
            mut darm: MatchArmNode* = new MatchArmNode(span);
            for (mut pi: i64 = 0; pi < arm.patterns.length; pi++) {
                darm.add_pattern(arm.patterns[pi]);
            }
            // A guard that stayed on its pattern still decides the arm: when it
            // is false the arm does not match and the wildcard below carries the
            // subject to the next test, which is the same fall-through the source
            // `match` would have done.
            if (!guard_suspends && arm.guard != null) { darm.set_guard(arm.guard); }
            darm.set_body(cap as StatementNode*);
            test.add_arm(darm);

            // The fall-through to the next test, but ONLY when this arm can fail
            // to match. An irrefutable pattern whose guard was lifted out always
            // matches, so a `_` here would be a second wildcard arm next to the
            // first (E0114) as well as dead code — the guard's own state is what
            // reaches `next` in that shape.
            mut one: MatchArmNode*[] = [darm];
            if (!this.patterns.match_is_exhaustive(subj_read, one)) {
                mut miss: BlockStmtNode* = new BlockStmtNode(span);
                this.append_goto(miss, sm, next, span);
                test.add_arm(this.match_arm_wild(miss, span));
            }

            sm.blocks[tests[ai]].add_statement(test as StatementNode*);
            // Hand the subject back for the next test. No test moves out of it
            // (an aggregate binding is rejected in chain mode), so the value put
            // back is the whole one that was taken. On a path that left the
            // future entirely — an inline arm body that returns — this never
            // runs, which is correct: nothing will look for it again.
            if (!subj_scalar) {
                sm.blocks[tests[ai]].add_statement(
                    this.agg_store_stmt(sm, subj_field, subj_opt_ty, subj_local,
                                        subject_type, span));
            }
        }

        // Exhaustiveness needs no separate handling here, unlike the dispatch
        // form: every test already carries its own `_ =>` fall-through, and the
        // last one targets the join. A subject that matches nothing walks the
        // chain and lands there, which is the fall-through a non-exhaustive
        // `match` means.
        return join;
    }

    /// Append `this.state = <to>;` to an arbitrary block (not a state-indexed
    /// block, so `sm_goto` does not apply) — the transition that ends a dispatch
    /// arm before the enclosing loop re-dispatches.
    append_goto(mut &this, blk: BlockStmtNode*, sm: PollSm*, to: i64, span: SourceSpan) -> void {
        blk.add_statement(this.assign_member_stmt(
            sm.struct_ref, sm.state_sym, sm.u32_ty, this.u32_lit(to as u64, span), span));
    }

    /// Collect the distinct pattern bindings of `arm` (across OR-alternatives and
    /// nested sub-patterns) paired with their payload types, re-deriving each type
    /// via `PatternResolver::resolve_variant_payload_types` (patterns carry no
    /// cached type). Mirrors `PatternResolver::bind_arm_patterns`.
    collect_arm_bindings(mut &this, arm: MatchArmNode*, subject_type: TypeRef,
                         bs: BindingCapture*) -> void {
        for (mut i: i64 = 0; i < arm.patterns.length; i++) {
            this.collect_pat_bindings(arm.patterns[i], subject_type, bs);
        }
    }

    collect_pat_bindings(mut &this, pat: PatternNode*, value_type: TypeRef,
                         bs: BindingCapture*) -> void {
        if (pat == null) { return; }
        if (pat.pattern_kind == PatternKind::Identifier && pat.binding_name.is_valid()) {
            bs.push_unique(pat.binding_name, value_type);
            return;
        }
        if (pat.pattern_kind != PatternKind::Enum) { return; }
        const epat: EnumPatternNode* = pat as EnumPatternNode*;
        const payloads: TypeRef[] = this.patterns.resolve_variant_payload_types(value_type, epat);
        for (mut j: i64 = 0; j < epat.elements.length; j++) {
            mut elem_ty: TypeRef = value_type;
            if (j < payloads.length && payloads[j].is_valid()) { elem_ty = payloads[j]; }
            const pb: PatternBinding* = epat.binding_at(j);
            if (pb != null && pb.name.is_valid()) { bs.push_unique(pb.name, elem_ty); continue; }
            const sub: PatternNode* = epat.sub_at(j);
            if (sub != null) { this.collect_pat_bindings(sub, elem_ty, bs); }
        }
    }

    /// Append `if (<cond>) { this.state = <t>; } else { this.state = <f>; }` to
    /// state block `from` — a two-way state dispatch (a loop header's test, a
    /// `do-while`'s tail test). The arm falls off after the assignment and the
    /// enclosing loop re-dispatches the chosen state.
    emit_cond_dispatch(mut &this, sm: PollSm*, from: i64, cond: ExpressionNode*,
                       t: i64, f: i64, span: SourceSpan) -> void {
        mut then_set: BlockStmtNode* = new BlockStmtNode(span);
        then_set.add_statement(this.assign_member_stmt(sm.struct_ref, sm.state_sym, sm.u32_ty,
            this.u32_lit(t as u64, span), span));
        mut else_set: BlockStmtNode* = new BlockStmtNode(span);
        else_set.add_statement(this.assign_member_stmt(sm.struct_ref, sm.state_sym, sm.u32_ty,
            this.u32_lit(f as u64, span), span));
        sm.blocks[from].add_statement(new IfStmtNode(cond,
            then_set as StatementNode*, else_set as StatementNode*, span) as StatementNode*);
    }

    /// `break` -> jump to the innermost exploded loop's after state; `continue`
    /// -> jump to its continue target (a `while`/`loop` header, a `for` update
    /// state, a `do-while` tail test). A native `break`/`continue` would break
    /// the dispatch `loop`/`match`, so these lower to `this.state = <target>;`.
    lower_break_sm(mut &this, sm: PollSm*, cur: i64, span: SourceSpan) -> i64 {
        if (sm.loop_brk.length == 0i64) {
            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                "async: `break` outside a loop", span);
            sm.ok = false; return cur;
        }
        this.sm_goto(sm, cur, sm.loop_brk[sm.loop_brk.length - 1i64]);
        return cur;
    }

    lower_continue_sm(mut &this, sm: PollSm*, cur: i64, span: SourceSpan) -> i64 {
        if (sm.loop_cont.length == 0i64) {
            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                "async: `continue` outside a loop", span);
            sm.ok = false; return cur;
        }
        this.sm_goto(sm, cur, sm.loop_cont[sm.loop_cont.length - 1i64]);
        return cur;
    }

    /// `loop { body }` -> a body-entry state whose back-edge returns to itself
    /// (an infinite loop; `break` exits to the after state, `continue` re-enters
    /// the body). A suspend inside the body splits it into further states; the
    /// back-edge re-dispatches the body from the top each iteration.
    lower_loop_sm(mut &this, sm: PollSm*, lp: LoopStmtNode*, cur: i64) -> i64 {
        const body_entry: i64 = this.sm_alloc(sm);
        const after: i64 = this.sm_alloc(sm);
        this.sm_goto(sm, cur, body_entry);
        sm.loop_cont.push(body_entry);
        sm.loop_brk.push(after);
        const body_end: i64 = this.lower_branch_sm(sm, lp.body, body_entry);
        sm.loop_cont.pop();
        sm.loop_brk.pop();
        if (!sm.ok) { return cur; }
        if (!this.stmt_diverges(lp.body)) { this.sm_goto(sm, body_end, body_entry); }
        return after;
    }

    /// `while (cond) { body }` -> a header state that tests `cond` (dispatching to
    /// the body entry or the after state), a body sequence, and a back-edge from
    /// the body tail to the header. `continue` re-tests at the header; `break`
    /// exits to after.
    lower_while_sm(mut &this, sm: PollSm*, w: WhileStmtNode*, cur: i64) -> i64 {
        const span: SourceSpan = sm.span;
        const header: i64 = this.sm_alloc(sm);
        const body_entry: i64 = this.sm_alloc(sm);
        const after: i64 = this.sm_alloc(sm);
        this.sm_goto(sm, cur, header);
        const hc: HoistedExpr = this.lower_hoisted(sm, w.condition, header);
        if (!sm.ok) { return cur; }
        this.emit_cond_dispatch(sm, hc.end, hc.expr, body_entry, after, span);
        sm.loop_cont.push(header);
        sm.loop_brk.push(after);
        const body_end: i64 = this.lower_branch_sm(sm, w.body, body_entry);
        sm.loop_cont.pop();
        sm.loop_brk.pop();
        if (!sm.ok) { return cur; }
        if (!this.stmt_diverges(w.body)) { this.sm_goto(sm, body_end, header); }
        return after;
    }

    /// `do { body } while (cond)` -> a body-entry state (run unconditionally
    /// first), a tail-test state, and the after state. `continue` jumps to the
    /// tail test; `break` exits to after.
    lower_do_while_sm(mut &this, sm: PollSm*, d: DoWhileStmtNode*, cur: i64) -> i64 {
        const span: SourceSpan = sm.span;
        const body_entry: i64 = this.sm_alloc(sm);
        const cond_state: i64 = this.sm_alloc(sm);
        const after: i64 = this.sm_alloc(sm);
        this.sm_goto(sm, cur, body_entry);
        sm.loop_cont.push(cond_state);
        sm.loop_brk.push(after);
        const body_end: i64 = this.lower_branch_sm(sm, d.body, body_entry);
        sm.loop_cont.pop();
        sm.loop_brk.pop();
        if (!sm.ok) { return cur; }
        if (!this.stmt_diverges(d.body)) { this.sm_goto(sm, body_end, cond_state); }
        const hc: HoistedExpr = this.lower_hoisted(sm, d.condition, cond_state);
        if (!sm.ok) { return cur; }
        this.emit_cond_dispatch(sm, hc.end, hc.expr, body_entry, after, span);
        return after;
    }

    /// `for (init; cond; update) { body }` -> lower `init` into the current
    /// state, then a header (test `cond`), a body sequence, an update state, and
    /// the after state. `continue` jumps to the update; `break` exits to after.
    /// A null `cond` means "always enter the body" (an infinite `for (;;)`).
    lower_for_sm(mut &this, sm: PollSm*, f: ForStmtNode*, cur: i64) -> i64 {
        const span: SourceSpan = sm.span;
        mut s0: i64 = cur;
        if (f.init != null) {
            if ((f.init as ASTNode*).kind == NodeKind::VariableDeclaration) {
                mut ds: DeclStmtNode* = new DeclStmtNode(f.init as DeclarationNode*, span);
                s0 = this.lower_stmt_sm(sm, ds as StatementNode*, s0);
            } else {
                mut es: ExprStmtNode* = new ExprStmtNode(f.init as ExpressionNode*, span);
                s0 = this.lower_stmt_sm(sm, es as StatementNode*, s0);
            }
            if (!sm.ok) { return cur; }
        }
        const header: i64 = this.sm_alloc(sm);
        const body_entry: i64 = this.sm_alloc(sm);
        const update_state: i64 = this.sm_alloc(sm);
        const after: i64 = this.sm_alloc(sm);
        this.sm_goto(sm, s0, header);
        if (f.condition != null) {
            const hc: HoistedExpr = this.lower_hoisted(sm, f.condition, header);
            if (!sm.ok) { return cur; }
            this.emit_cond_dispatch(sm, hc.end, hc.expr, body_entry, after, span);
        } else {
            this.sm_goto(sm, header, body_entry);
        }
        sm.loop_cont.push(update_state);
        sm.loop_brk.push(after);
        const body_end: i64 = this.lower_branch_sm(sm, f.body, body_entry);
        sm.loop_cont.pop();
        sm.loop_brk.pop();
        if (!sm.ok) { return cur; }
        if (!this.stmt_diverges(f.body)) { this.sm_goto(sm, body_end, update_state); }
        mut update_end: i64 = update_state;
        if (f.update != null) {
            const hu: HoistedExpr = this.lower_hoisted(sm, f.update, update_state);
            if (!sm.ok) { return cur; }
            update_end = hu.end;
            if (hu.expr != null) {
                sm.blocks[update_end].add_statement(new ExprStmtNode(hu.expr, span) as StatementNode*);
            }
        }
        this.sm_goto(sm, update_end, header);
        return after;
    }

    /// Lower the statements that lifting `e`'s `await`s produced into the state
    /// chain starting at `at`, and hand back what remains of `e` together with
    /// the state it must be evaluated in.
    ///
    /// A loop's condition and update are rewritten HERE rather than by the
    /// pre-lowering hoist because both are re-evaluated every iteration: lifting
    /// them out to before the loop would run them once, and `continue` has to
    /// re-enter them — which is exactly what their own state already is.
    lower_hoisted(mut &this, sm: PollSm*, e: ExpressionNode*, at: i64) -> HoistedExpr {
        if (e == null || this.expr_await_count(e) == 0i64) {
            return HoistedExpr { expr: e, end: at };
        }
        mut pre: HoistPre = HoistPre { stmts: [] };
        mut rest: ExpressionNode* = this.hoist_expr(e, &pre);
        mut end: i64 = at;
        for (mut i: i64 = 0; i < pre.stmts.length; i++) {
            end = this.lower_stmt_sm(sm, pre.stmts[i], end);
            if (!sm.ok) { return HoistedExpr { expr: rest, end: end }; }
        }
        return HoistedExpr { expr: rest, end: end };
    }

    /// True if the statement never falls through to whatever follows it, so a
    /// following state transition (a branch join, a loop back-edge, or the rest
    /// of a block) would be unreachable and must be suppressed. Structural over
    /// `return` / `break` / `continue` (all transfer control elsewhere), a
    /// block-tail, a both-arm `if`, and an infinite `loop` (no `break`).
    stmt_diverges(&this, stmt: StatementNode*) -> boolean {
        if (stmt == null) { return false; }
        const k: NodeKind = stmt.kind;
        if (k == NodeKind::ReturnStatement) { return true; }
        if (k == NodeKind::BreakStatement || k == NodeKind::ContinueStatement) { return true; }
        if (k == NodeKind::ExpressionStatement) {
            return this.expr_diverges((stmt as ExprStmtNode*).expression);
        }
        if (k == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = stmt as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                return this.expr_diverges((ds.declaration as VarDeclNode*).initializer);
            }
            return false;
        }
        if (k == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = stmt as BlockStmtNode*;
            if (blk.statements.length == 0i64) { return false; }
            return this.stmt_diverges(blk.statements[blk.statements.length - 1i64]);
        }
        if (k == NodeKind::IfStatement) {
            const iff: IfStmtNode* = stmt as IfStmtNode*;
            if (iff.else_stmt == null) { return false; }
            return this.stmt_diverges(iff.then_stmt) && this.stmt_diverges(iff.else_stmt);
        }
        if (k == NodeKind::LoopStatement) {
            // A `loop {}` exits only via a `break` targeting it; with none, it is
            // an infinite loop and control never reaches the following statement.
            return !this.has_free_break((stmt as LoopStmtNode*).body);
        }
        if (k == NodeKind::MatchStatement) {
            // A `match` never falls through only if it is exhaustive (some subject
            // always matches an arm) AND every arm body itself diverges. A
            // guarded or partial arm leaves a fall-through path, which
            // `match_is_exhaustive` accounts for.
            const m: MatchStmtNode* = stmt as MatchStmtNode*;
            if (m.arms.length == 0i64) { return false; }
            if (!this.patterns.match_is_exhaustive(m.subject, m.arms)) { return false; }
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                if (m.arms[i] == null || !this.stmt_diverges(m.arms[i].body)) { return false; }
            }
            return true;
        }
        return false;
    }

    block_diverges(&this, blk: BlockStmtNode*) -> boolean {
        if (blk == null || blk.statements.length == 0i64) { return false; }
        return this.stmt_diverges(blk.statements[blk.statements.length - 1i64]);
    }

    /// An expression yields control to the next statement unless it is a `match`
    /// expression that cannot fall through — the expression form of the rule
    /// `stmt_diverges` applies to a `match` statement. Any other kind is reported
    /// as falling through, which can only leave a hand-back store the state never
    /// reaches; `needs_handback` is the sole consumer and over-reporting there
    /// costs a dead store, never a missing one.
    expr_diverges(&this, e: ExpressionNode*) -> boolean {
        if (e == null) { return false; }
        if ((e as ASTNode*).kind != NodeKind::MatchExpression) { return false; }
        const me: MatchExprNode* = e as MatchExprNode*;
        if (me.arms.length == 0i64) { return false; }
        if (!this.patterns.match_is_exhaustive(me.subject, me.arms)) { return false; }
        for (mut i: i64 = 0; i < me.arms.length; i++) {
            if (me.arms[i] == null || !this.stmt_diverges(me.arms[i].body)) { return false; }
        }
        return true;
    }

    /// True if `stmt` holds a `break`/`continue` that targets the ENCLOSING loop
    /// (i.e. one not captured by a loop nested inside `stmt`). Used to decide
    /// whether an otherwise await-free statement must still be exploded into
    /// states (its edge cannot stay a native `break`, which would break the
    /// dispatch `loop`/`match`), and — restricted to `break` — whether a `loop {}`
    /// is infinite. Does NOT descend into nested loops (they capture their own).
    has_free_edge(&this, stmt: StatementNode*, break_only: boolean) -> boolean {
        if (stmt == null) { return false; }
        const k: NodeKind = stmt.kind;
        if (k == NodeKind::BreakStatement) { return true; }
        if (k == NodeKind::ContinueStatement) { return !break_only; }
        if (k == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = stmt as BlockStmtNode*;
            for (mut i: i64 = 0; i < blk.statements.length; i++) {
                if (this.has_free_edge(blk.statements[i], break_only)) { return true; }
            }
            return false;
        }
        if (k == NodeKind::IfStatement) {
            const iff: IfStmtNode* = stmt as IfStmtNode*;
            return this.expr_has_free_edge(iff.condition, break_only)
                || this.has_free_edge(iff.then_stmt, break_only)
                || this.has_free_edge(iff.else_stmt, break_only);
        }
        if (k == NodeKind::MatchStatement) {
            const m: MatchStmtNode* = stmt as MatchStmtNode*;
            if (this.expr_has_free_edge(m.subject, break_only)) { return true; }
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                if (m.arms[i] != null && this.has_free_edge(m.arms[i].body, break_only)) { return true; }
            }
            return false;
        }
        if (k == NodeKind::ExpressionStatement) {
            return this.expr_has_free_edge((stmt as ExprStmtNode*).expression, break_only);
        }
        if (k == NodeKind::ReturnStatement) {
            return this.expr_has_free_edge((stmt as ReturnStmtNode*).expression, break_only);
        }
        if (k == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = stmt as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                return this.expr_has_free_edge((ds.declaration as VarDeclNode*).initializer, break_only);
            }
            return false;
        }
        // While/For/Loop/DoWhile capture their own break/continue — not free here.
        return false;
    }

    /// Expression half of `has_free_edge`: a `match` used as an expression holds
    /// statement bodies, so a `break`/`continue` targeting the enclosing loop can
    /// sit inside one. Missing it leaves the edge as a native `break`, which in an
    /// exploded loop escapes the state-dispatch `loop` instead of the user's loop.
    expr_has_free_edge(&this, e: ExpressionNode*, break_only: boolean) -> boolean {
        if (e == null) { return false; }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::MatchExpression) {
            const me: MatchExprNode* = e as MatchExprNode*;
            if (this.expr_has_free_edge(me.subject, break_only)) { return true; }
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                if (me.arms[i] != null && this.has_free_edge(me.arms[i].body, break_only)) { return true; }
            }
            return false;
        }
        if (k == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            return this.expr_has_free_edge(b.left, break_only)
                || this.expr_has_free_edge(b.right, break_only);
        }
        if (k == NodeKind::UnaryExpression) {
            return this.expr_has_free_edge((e as UnaryExprNode*).operand, break_only);
        }
        if (k == NodeKind::CallExpression) {
            const c: CallExprNode* = e as CallExprNode*;
            if (this.expr_has_free_edge(c.callee, break_only)) { return true; }
            for (mut i: i64 = 0; i < c.arguments.length; i++) {
                if (this.expr_has_free_edge(c.arguments[i], break_only)) { return true; }
            }
            return false;
        }
        if (k == NodeKind::MemberAccess) {
            return this.expr_has_free_edge((e as MemberAccessNode*).object, break_only);
        }
        if (k == NodeKind::CastExpression) {
            return this.expr_has_free_edge((e as CastExprNode*).expression, break_only);
        }
        if (k == NodeKind::ArrayAccess) {
            const a: ArrayAccessNode* = e as ArrayAccessNode*;
            return this.expr_has_free_edge(a.array, break_only)
                || this.expr_has_free_edge(a.index, break_only);
        }
        if (k == NodeKind::TernaryExpression) {
            const t: TernaryExprNode* = e as TernaryExprNode*;
            return this.expr_has_free_edge(t.condition, break_only)
                || this.expr_has_free_edge(t.true_expr, break_only)
                || this.expr_has_free_edge(t.false_expr, break_only);
        }
        if (k == NodeKind::StructLiteral) {
            const sl: StructLiteralNode* = e as StructLiteralNode*;
            for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                if (this.expr_has_free_edge(sl.field_inits[i].value, break_only)) { return true; }
            }
            return false;
        }
        if (k == NodeKind::AwaitExpression) {
            return this.expr_has_free_edge((e as AwaitExprNode*).operand, break_only);
        }
        return false;
    }

    has_free_break(&this, stmt: StatementNode*) -> boolean {
        return this.has_free_edge(stmt, true);
    }

    has_free_break_continue(&this, stmt: StatementNode*) -> boolean {
        return this.has_free_edge(stmt, false);
    }

    /// A statement must be lowered into states (rather than emitted wholesale into
    /// the current state) if it contains an `await` OR a `break`/`continue` that
    /// targets an enclosing exploded loop.
    stmt_needs_explode(&this, stmt: StatementNode*) -> boolean {
        return this.stmt_await_count(stmt) > 0i64 || this.has_free_break_continue(stmt);
    }

    // ---- cross-state local promotion (build-then-scan) ----

    /// True if `name` is read in any top-level statement of `blk`.
    block_reads_name(&this, blk: BlockStmtNode*, name: SymbolStr) -> boolean {
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            if (this.name_read_in_stmt(blk.statements[i], name)) { return true; }
        }
        return false;
    }

    /// Prepend `const <name> = this.<field>;` to `blk` so reads of a promoted
    /// local resolve to the reloaded value rather than the out-of-scope binding.
    // How a state block first touches a name: nowhere (0), reads it before
    // writing it (1), or writes it first (2). This is the difference between a
    // value that must survive the suspend and one the block produces for itself
    // — and it is what keeps the owned-handle I/O idiom (hand the socket to the
    // operation, take it back from the result) from being carried at all.
    first_use_none(&this)  -> i64 { return 0i64; }
    first_use_read(&this)  -> i64 { return 1i64; }
    first_use_write(&this) -> i64 { return 2i64; }

    /// How `blk` first touches `name`, scanning in execution order.
    block_first_use(&this, blk: BlockStmtNode*, name: SymbolStr) -> i64 {
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            const r: i64 = this.stmt_first_use(blk.statements[i], name);
            if (r != 0i64) { return r; }
        }
        return 0i64;
    }

    stmt_first_use(&this, s: StatementNode*, name: SymbolStr) -> i64 {
        if (s == null) { return 0i64; }
        const k: NodeKind = s.kind;
        if (k == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = s as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                const vd: VarDeclNode* = ds.declaration as VarDeclNode*;
                // The initializer runs before the name exists, so a mention of
                // the name in it refers to an outer binding and is a read.
                const r: i64 = this.expr_first_use(vd.initializer, name);
                if (r != 0i64) { return r; }
                if (vd.name.equals(name)) { return 2i64; }
            }
            return 0i64;
        }
        if (k == NodeKind::ExpressionStatement) {
            return this.expr_first_use((s as ExprStmtNode*).expression, name);
        }
        if (k == NodeKind::ReturnStatement) {
            return this.expr_first_use((s as ReturnStmtNode*).expression, name);
        }
        if (k == NodeKind::BlockStatement) {
            return this.block_first_use(s as BlockStmtNode*, name);
        }
        if (k == NodeKind::IfStatement) {
            const iff: IfStmtNode* = s as IfStmtNode*;
            mut r: i64 = this.expr_first_use(iff.condition, name);
            if (r != 0i64) { return r; }
            r = this.stmt_first_use(iff.then_stmt, name);
            if (r != 0i64) { return r; }
            return this.stmt_first_use(iff.else_stmt, name);
        }
        if (k == NodeKind::WhileStatement) {
            const w: WhileStmtNode* = s as WhileStmtNode*;
            const r: i64 = this.expr_first_use(w.condition, name);
            if (r != 0i64) { return r; }
            return this.stmt_first_use(w.body, name);
        }
        if (k == NodeKind::DoWhileStatement) {
            const d: DoWhileStmtNode* = s as DoWhileStmtNode*;
            const r: i64 = this.stmt_first_use(d.body, name);
            if (r != 0i64) { return r; }
            return this.expr_first_use(d.condition, name);
        }
        if (k == NodeKind::ForStatement) {
            const f: ForStmtNode* = s as ForStmtNode*;
            mut r: i64 = 0i64;
            if (f.init != null) { r = this.stmt_first_use(f.init as StatementNode*, name); }
            if (r != 0i64) { return r; }
            r = this.expr_first_use(f.condition, name);
            if (r != 0i64) { return r; }
            r = this.stmt_first_use(f.body, name);
            if (r != 0i64) { return r; }
            return this.expr_first_use(f.update, name);
        }
        if (k == NodeKind::LoopStatement) {
            return this.stmt_first_use((s as LoopStmtNode*).body, name);
        }
        if (k == NodeKind::MatchStatement) {
            const m: MatchStmtNode* = s as MatchStmtNode*;
            const r: i64 = this.expr_first_use(m.subject, name);
            if (r != 0i64) { return r; }
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                const a: i64 = this.stmt_first_use(m.arms[i].body, name);
                if (a != 0i64) { return a; }
            }
            return 0i64;
        }
        // Anything else can only mention the name by reading it.
        if (this.name_read_in_stmt(s, name)) { return 1i64; }
        return 0i64;
    }

    expr_first_use(&this, e: ExpressionNode*, name: SymbolStr) -> i64 {
        if (e == null) { return 0i64; }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::Identifier) {
            if ((e as IdentifierNode*).name.equals(name)) { return 1i64; }
            return 0i64;
        }
        if (k == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            if (b.op.kind == TokenType::Equal) {
                // The right side is evaluated first; only a bare `name = ...`
                // is a write, while `name.f = ...` or `name[i] = ...` reads it.
                const r: i64 = this.expr_first_use(b.right, name);
                if (r != 0i64) { return r; }
                if (b.left != null && (b.left as ASTNode*).kind == NodeKind::Identifier
                        && (b.left as IdentifierNode*).name.equals(name)) {
                    return 2i64;
                }
                return this.expr_first_use(b.left, name);
            }
            const l: i64 = this.expr_first_use(b.left, name);
            if (l != 0i64) { return l; }
            return this.expr_first_use(b.right, name);
        }
        if (k == NodeKind::MatchExpression) {
            // Same shape as the statement form: the subject runs first, then the
            // arm that matched. Distinguishing a write in an arm from a read is
            // what lets `block_cond_write` see it as a branch-nested write, whose
            // skipped path still needs the previous state's value.
            const me: MatchExprNode* = e as MatchExprNode*;
            const r: i64 = this.expr_first_use(me.subject, name);
            if (r != 0i64) { return r; }
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                if (me.arms[i] == null) { continue; }
                const g: i64 = this.expr_first_use(me.arms[i].guard, name);
                if (g != 0i64) { return g; }
                const a: i64 = this.stmt_first_use(me.arms[i].body, name);
                if (a != 0i64) { return a; }
            }
            return 0i64;
        }
        if (this.name_read_in_expr(e, name)) { return 1i64; }
        return 0i64;
    }

    /// True when the LAST thing a state does with `name` gives the value away:
    /// passes it by value, assigns it to something else, or returns it. Such a
    /// state must not hand the value back to the carrier field on the way out —
    /// it no longer owns it. This is what makes the owned-handle idiom work
    /// where the value IS carried: the state that passes the socket to an
    /// operation stays silent, and the state that takes it back out of the
    /// result publishes the new one.
    /// True when the state still has to hand the carried value back to its
    /// carrier field as it falls off the end.
    ///
    /// Two states do not: one that gave the value away (`last_use_consumes`),
    /// and one whose tail diverges — a block ending in `return` never reaches a
    /// trailing statement, so a store appended there is dead code. It is not
    /// harmless dead code either: every synthesized node carries the async
    /// function's own span, so the dead-code lint reports an unreachable
    /// statement against the user's `async function`, pointing at source that
    /// looks perfectly reachable. Suspends are handled separately by
    /// `store_before_suspends`, which stores BEFORE the `return Poll::Pending`,
    /// so skipping the trailing store loses nothing on that path.
    needs_handback(&this, blk: BlockStmtNode*, name: SymbolStr) -> boolean {
        if (this.last_use_consumes(blk, name)) { return false; }
        return !this.stmt_diverges(blk as StatementNode*);
    }

    last_use_consumes(&this, blk: BlockStmtNode*, name: SymbolStr) -> boolean {
        mut kind: i64 = 0i64;
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            this.mark_last_use_stmt(blk.statements[i], name, &kind);
        }
        return kind == 2i64;
    }

    /// Record how each mention of `name` uses it, in execution order; the last
    /// write to `*out` describes the final mention. 1 = borrowed/overwritten
    /// (the state still owns the value), 2 = given away.
    mark_last_use_stmt(&this, s: StatementNode*, name: SymbolStr, out: i64*) -> void {
        if (s == null) { return; }
        const k: NodeKind = s.kind;
        if (k == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = s as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                this.mark_last_use_expr((ds.declaration as VarDeclNode*).initializer, name, true, out);
            }
            return;
        }
        if (k == NodeKind::ExpressionStatement) {
            this.mark_last_use_expr((s as ExprStmtNode*).expression, name, false, out);
            return;
        }
        if (k == NodeKind::ReturnStatement) {
            this.mark_last_use_expr((s as ReturnStmtNode*).expression, name, true, out);
            return;
        }
        if (k == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = s as BlockStmtNode*;
            for (mut i: i64 = 0; i < blk.statements.length; i++) {
                this.mark_last_use_stmt(blk.statements[i], name, out);
            }
            return;
        }
        if (k == NodeKind::IfStatement) {
            const iff: IfStmtNode* = s as IfStmtNode*;
            this.mark_last_use_expr(iff.condition, name, false, out);
            this.mark_last_use_stmt(iff.then_stmt, name, out);
            this.mark_last_use_stmt(iff.else_stmt, name, out);
            return;
        }
        if (k == NodeKind::WhileStatement) {
            const w: WhileStmtNode* = s as WhileStmtNode*;
            this.mark_last_use_expr(w.condition, name, false, out);
            this.mark_last_use_stmt(w.body, name, out);
            return;
        }
        if (k == NodeKind::DoWhileStatement) {
            const d: DoWhileStmtNode* = s as DoWhileStmtNode*;
            this.mark_last_use_stmt(d.body, name, out);
            this.mark_last_use_expr(d.condition, name, false, out);
            return;
        }
        if (k == NodeKind::ForStatement) {
            const f: ForStmtNode* = s as ForStmtNode*;
            if (f.init != null) { this.mark_last_use_stmt(f.init as StatementNode*, name, out); }
            this.mark_last_use_expr(f.condition, name, false, out);
            this.mark_last_use_stmt(f.body, name, out);
            this.mark_last_use_expr(f.update, name, false, out);
            return;
        }
        if (k == NodeKind::LoopStatement) {
            this.mark_last_use_stmt((s as LoopStmtNode*).body, name, out);
            return;
        }
        if (k == NodeKind::MatchStatement) {
            const m: MatchStmtNode* = s as MatchStmtNode*;
            this.mark_last_use_expr(m.subject, name, true, out);
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                if (m.arms[i] == null) { continue; }
                // A guard runs before its body and only reads, so a name last
                // mentioned there is still owned by the state.
                this.mark_last_use_expr(m.arms[i].guard, name, false, out);
                this.mark_last_use_stmt(m.arms[i].body, name, out);
            }
            return;
        }
    }

    /// `by_value` says whether a bare mention in THIS position hands the value
    /// over (a call argument, an initializer, a returned expression) or merely
    /// reaches into it (a receiver, a field access, an address-of).
    mark_last_use_expr(&this, e: ExpressionNode*, name: SymbolStr,
                       by_value: boolean, out: i64*) -> void {
        if (e == null) { return; }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::Identifier) {
            if ((e as IdentifierNode*).name.equals(name)) {
                *out = if (by_value) { 2i64 } else { 1i64 };
            }
            return;
        }
        if (k == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            if (b.op.kind == TokenType::Equal) {
                this.mark_last_use_expr(b.right, name, true, out);
                // Assigning to the name replaces whatever it held: the state
                // owns the new value regardless of what happened before.
                this.mark_last_use_expr(b.left, name, false, out);
                return;
            }
            this.mark_last_use_expr(b.left, name, false, out);
            this.mark_last_use_expr(b.right, name, false, out);
            return;
        }
        if (k == NodeKind::CallExpression) {
            const c: CallExprNode* = e as CallExprNode*;
            // A receiver is reached into, an argument is handed over.
            this.mark_last_use_expr(c.callee, name, false, out);
            for (mut i: i64 = 0; i < c.arguments.length; i++) {
                this.mark_last_use_expr(c.arguments[i], name, true, out);
            }
            return;
        }
        if (k == NodeKind::MemberAccess) {
            this.mark_last_use_expr((e as MemberAccessNode*).object, name, false, out);
            return;
        }
        if (k == NodeKind::UnaryExpression) {
            this.mark_last_use_expr((e as UnaryExprNode*).operand, name, false, out);
            return;
        }
        if (k == NodeKind::CastExpression) {
            this.mark_last_use_expr((e as CastExprNode*).expression, name, by_value, out);
            return;
        }
        if (k == NodeKind::ArrayAccess) {
            const a: ArrayAccessNode* = e as ArrayAccessNode*;
            this.mark_last_use_expr(a.array, name, false, out);
            this.mark_last_use_expr(a.index, name, false, out);
            return;
        }
        if (k == NodeKind::TernaryExpression) {
            const t: TernaryExprNode* = e as TernaryExprNode*;
            this.mark_last_use_expr(t.condition, name, false, out);
            this.mark_last_use_expr(t.true_expr, name, by_value, out);
            this.mark_last_use_expr(t.false_expr, name, by_value, out);
            return;
        }
        if (k == NodeKind::StructLiteral) {
            const sl: StructLiteralNode* = e as StructLiteralNode*;
            for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                this.mark_last_use_expr(sl.field_inits[i].value, name, true, out);
            }
            return;
        }
        if (k == NodeKind::MatchExpression) {
            const me: MatchExprNode* = e as MatchExprNode*;
            this.mark_last_use_expr(me.subject, name, true, out);
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                if (me.arms[i] == null) { continue; }
                this.mark_last_use_expr(me.arms[i].guard, name, false, out);
                this.mark_last_use_arm(me.arms[i].body, name, by_value, out);
            }
            return;
        }
        // Anything else: a mention can only be a read of the value in place.
        if (this.name_read_in_expr(e, name)) { *out = 1i64; }
    }

    /// Walk a match-EXPRESSION arm body. Its trailing expression is the arm's
    /// value, so that expression sits in the match's own position: when the match
    /// result is handed over, an arm yielding the name hands the name over too.
    /// Every other statement in the body is an ordinary statement.
    mark_last_use_arm(&this, body: StatementNode*, name: SymbolStr,
                      by_value: boolean, out: i64*) -> void {
        if (body == null) { return; }
        if (body.kind != NodeKind::BlockStatement) {
            this.mark_last_use_stmt(body, name, out);
            return;
        }
        const blk: BlockStmtNode* = body as BlockStmtNode*;
        const last: i64 = blk.statements.length - 1i64;
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            const s: StatementNode* = blk.statements[i];
            if (i == last && s != null && s.kind == NodeKind::ExpressionStatement) {
                this.mark_last_use_expr((s as ExprStmtNode*).expression, name, by_value, out);
                continue;
            }
            this.mark_last_use_stmt(s, name, out);
        }
    }

    /// Turn the state's first `<name> = <expr>;` into `mut <name> = <expr>;`, so
    /// a state that produces its own value declares it there. Returns false if
    /// the state has no such top-level assignment.
    ///
    /// Declaring at the assignment — rather than declaring the name empty at the
    /// top of the state — is what keeps the binding from ever holding a value
    /// nobody wrote. That matters for a type with a destructor: an unwritten
    /// binding is whatever the stack held, and dropping it would run that
    /// destructor on garbage. For a socket, "garbage" can be a perfectly valid
    /// descriptor number, so the drop closes an unrelated file.
    decl_at_first_assignment(mut &this, blk: BlockStmtNode*, name: SymbolStr,
                             lty: TypeRef, span: SourceSpan) -> boolean {
        const i: i64 = this.top_level_assignment_index(blk, name);
        if (i < 0i64) { return false; }
        const b: BinaryExprNode* =
            ((blk.statements[i] as ExprStmtNode*).expression) as BinaryExprNode*;
        blk.statements[i] = this.var_decl_stmt(name, true, lty, b.right, span);
        return true;
    }

    /// Index of the state's first `<name> = <expr>;` written at the TOP level of
    /// the state, or -1. Top level is what makes the assignment unconditional:
    /// it runs on every path through the state, so the state really does produce
    /// its own value.
    top_level_assignment_index(&this, blk: BlockStmtNode*, name: SymbolStr) -> i64 {
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            const s: StatementNode* = blk.statements[i];
            if (s == null || s.kind != NodeKind::ExpressionStatement) { continue; }
            const e: ExpressionNode* = (s as ExprStmtNode*).expression;
            if (e == null || (e as ASTNode*).kind != NodeKind::BinaryExpression) { continue; }
            const b: BinaryExprNode* = e as BinaryExprNode*;
            if (b.op.kind != TokenType::Equal) { continue; }
            if (b.left == null || (b.left as ASTNode*).kind != NodeKind::Identifier) { continue; }
            if (!(b.left as IdentifierNode*).name.equals(name)) { continue; }
            return i;
        }
        return -1i64;
    }

    /// True when a state's first touch of `name` is a write that is NOT
    /// guaranteed to run — the assignment sits inside a branch, loop or match
    /// arm rather than at the top level of the state.
    ///
    /// Such a state does not produce its own value: on the path where the write
    /// is skipped the name still has to hold whatever the previous state left in
    /// it, so the value is live across the suspend and must be carried exactly
    /// like a value the state reads. Treating it as a self-produced value
    /// instead would give the state a binding nobody wrote on that path, and the
    /// hand-back at the end of the state would publish that garbage into the
    /// carrier field for the next state to take.
    block_cond_write(&this, blk: BlockStmtNode*, name: SymbolStr) -> boolean {
        if (this.block_first_use(blk, name) != this.first_use_write()) { return false; }
        return this.top_level_assignment_index(blk, name) < 0i64;
    }

    /// `this.<field> = Option::Some(<name>);` — hand a promoted aggregate from
    /// the block-local holding it back to the field that survives the suspend.
    /// Built fresh per call: each insertion point needs its own nodes.
    agg_store_stmt(mut &this, sm: PollSm*, field: SymbolStr, opt_ty: TypeRef,
                   name: SymbolStr, lty: TypeRef, span: SourceSpan) -> StatementNode* {
        return this.assign_member_stmt(sm.struct_ref, field, opt_ty,
            this.option_some(this.ident(name, lty, span), opt_ty, span), span);
    }

    /// Prepend `<name> = this.<field>.take().unwrap();` so the state opens with
    /// the value back in an ordinary local. `take` empties the field, so the
    /// value is never reachable through two places at once. Mirrors how a
    /// sub-future is taken out of its slot at the top of a resume state.
    prepend_agg_take(mut &this, blk: BlockStmtNode*, name: SymbolStr, field: SymbolStr,
                     lty: TypeRef, opt_ty: TypeRef, struct_ref: TypeRef,
                     mutable: boolean, span: SourceSpan) -> void {
        mut fld: ExpressionNode* = this.member(this.this_ident(struct_ref, span), field, opt_ty, span);
        mut take_call: ExpressionNode* = this.method_call0(fld, "take", opt_ty, span);
        mut unwrap_call: ExpressionNode* = this.method_call0(take_call, "unwrap", lty, span);
        mut rebuilt: StatementNode*[] = [this.var_decl_stmt(name, mutable, lty, unwrap_call, span)];
        for (mut i: i64 = 0; i < blk.statements.length; i++) { rebuilt.push(blk.statements[i]); }
        blk.statements = rebuilt;
    }

    /// Insert the hand-back store before every `return Poll::Pending` inside
    /// `s`. A suspend leaves `poll` from the middle of a state, so the store at
    /// the end of the state never runs on that path; without this the next poll
    /// would take an empty field. Only ever applied to states that opened with a
    /// `take`, so the local is in scope at each suspend.
    store_before_suspends(mut &this, sm: PollSm*, s: StatementNode*, field: SymbolStr,
                          opt_ty: TypeRef, name: SymbolStr, lty: TypeRef,
                          span: SourceSpan) -> void {
        if (s == null) { return; }
        const k: NodeKind = s.kind;
        if (k == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = s as BlockStmtNode*;
            mut rebuilt: StatementNode*[] = [];
            for (mut i: i64 = 0; i < blk.statements.length; i++) {
                const st: StatementNode* = blk.statements[i];
                if (this.is_pending_return(st)) {
                    rebuilt.push(this.agg_store_stmt(sm, field, opt_ty, name, lty, span));
                    rebuilt.push(st);
                } else {
                    this.store_before_suspends(sm, st, field, opt_ty, name, lty, span);
                    rebuilt.push(st);
                }
            }
            blk.statements = rebuilt;
            return;
        }
        if (k == NodeKind::IfStatement) {
            const iff: IfStmtNode* = s as IfStmtNode*;
            this.store_before_suspends(sm, iff.then_stmt, field, opt_ty, name, lty, span);
            this.store_before_suspends(sm, iff.else_stmt, field, opt_ty, name, lty, span);
            return;
        }
        if (k == NodeKind::WhileStatement) {
            this.store_before_suspends(sm, (s as WhileStmtNode*).body, field, opt_ty, name, lty, span);
            return;
        }
        if (k == NodeKind::DoWhileStatement) {
            this.store_before_suspends(sm, (s as DoWhileStmtNode*).body, field, opt_ty, name, lty, span);
            return;
        }
        if (k == NodeKind::ForStatement) {
            this.store_before_suspends(sm, (s as ForStmtNode*).body, field, opt_ty, name, lty, span);
            return;
        }
        if (k == NodeKind::LoopStatement) {
            this.store_before_suspends(sm, (s as LoopStmtNode*).body, field, opt_ty, name, lty, span);
            return;
        }
        if (k == NodeKind::MatchStatement) {
            const m: MatchStmtNode* = s as MatchStmtNode*;
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                this.store_before_suspends(sm, m.arms[i].body, field, opt_ty, name, lty, span);
            }
            return;
        }
    }

    /// True for the suspend statement the await lowering emits: `return
    /// Poll::Pending`. A user `return` was already rewritten to `Poll::Ready`,
    /// so the member name alone tells them apart.
    is_pending_return(&this, s: StatementNode*) -> boolean {
        if (s == null || s.kind != NodeKind::ReturnStatement) { return false; }
        const e: ExpressionNode* = (s as ReturnStmtNode*).expression;
        if (e == null || (e as ASTNode*).kind != NodeKind::ScopeResolution) { return false; }
        return (e as ScopeResolutionNode*).member_name.equals(this.intern.intern("Pending"));
    }

    prepend_load(mut &this, blk: BlockStmtNode*, name: SymbolStr, field: SymbolStr,
                 ty: TypeRef, struct_ref: TypeRef, span: SourceSpan) -> void {
        mut ld: ExpressionNode* = this.member(this.this_ident(struct_ref, span), field, ty, span);
        mut rebuilt: StatementNode*[] = [this.var_decl_stmt(name, false, ty, ld, span)];
        for (mut i: i64 = 0; i < blk.statements.length; i++) { rebuilt.push(blk.statements[i]); }
        blk.statements = rebuilt;
    }

    /// Replace the `mut <name> = <init>;` declaration (located by node identity in
    /// state block `ds`) with `this.<field> = <init>;`, so the promoted field —
    /// not a stack local — receives the value. A declaration with no initializer
    /// is dropped: the constructor already zero-initialized the field.
    rewrite_mut_decl(mut &this, sm: PollSm*, ds: i64, vd: VarDeclNode*,
                     field: SymbolStr, lty: TypeRef) -> void {
        const span: SourceSpan = sm.span;
        const blk: BlockStmtNode* = sm.blocks[ds];
        mut rebuilt: StatementNode*[] = [];
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            const s: StatementNode* = blk.statements[i];
            if (this.stmt_decl_var(s) == vd) {
                if (vd.initializer != null) {
                    rebuilt.push(this.assign_member_stmt(sm.struct_ref, field, lty, vd.initializer, span));
                }
            } else {
                rebuilt.push(s);
            }
        }
        blk.statements = rebuilt;
    }

    // ---- address-of-across-a-suspend soundness ----

    /// Record the names whose storage is the poll frame: the parameters (re-bound
    /// by the shadow prelude on entry to every poll) and every local and
    /// `match`-arm binding (renamed, and thereby recorded, by
    /// `disambiguate_locals`). Must run after that rename, so the recorded names
    /// are the ones the body now uses.
    collect_frame_names(mut &this, d: AsyncDecl*, sm: PollSm*, node: FunctionDeclNode*) -> void {
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            const p: VarDeclNode* = node.parameters[i];
            if (!this.param_has_slot(d, p)) { continue; }
            sm.frame_names.push(this.param_field_name(p));
        }
        for (mut i: i64 = 0; i < this.frame_locals.length; i++) {
            sm.frame_names.push(this.frame_locals[i]);
        }
    }

    is_frame_name(&this, sm: PollSm*, name: SymbolStr) -> boolean {
        for (mut i: i64 = 0; i < sm.frame_names.length; i++) {
            if (sm.frame_names[i].equals(name)) { return true; }
        }
        return false;
    }

    /// True when a place built on `base` reaches storage the poll frame does not
    /// own, because `base` is itself an indirection: a pointer or reference names
    /// its pointee, and a dynamic array names its heap block. Neither moves when
    /// a poll returns, so `&p[0]` / `&p.f` / `&*p` on such a base is sound to
    /// hold across a suspend even though `p` itself lives in the frame.
    place_leaves_frame(&this, base: ExpressionNode*) -> boolean {
        if (base == null) { return true; }
        const bt: TypeRef = base.resolved_type;
        if (!bt.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(bt.id);
        if (t == null) { return false; }
        if (t.kind == TypeKind::Pointer || t.kind == TypeKind::Reference) { return true; }
        if (t.kind == TypeKind::Array) { return (t as ArrayType*).is_dynamic(); }
        return false;
    }

    /// The frame-resident local or parameter whose own storage the place `e`
    /// names, or the empty symbol when `e` names storage elsewhere. Each step is
    /// tested against the type it indexes into, so a place stops being rooted in
    /// the frame at the first indirection it passes through.
    addr_place_root(&this, sm: PollSm*, e: ExpressionNode*) -> SymbolStr {
        if (e == null) { return SymbolStr::empty(); }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::Identifier) {
            const nm: SymbolStr = (e as IdentifierNode*).name;
            if (this.is_frame_name(sm, nm)) { return nm; }
            return SymbolStr::empty();
        }
        if (k == NodeKind::MemberAccess) {
            const ma: MemberAccessNode* = e as MemberAccessNode*;
            if (this.place_leaves_frame(ma.object)) { return SymbolStr::empty(); }
            return this.addr_place_root(sm, ma.object);
        }
        if (k == NodeKind::ArrayAccess) {
            const aa: ArrayAccessNode* = e as ArrayAccessNode*;
            if (this.place_leaves_frame(aa.array)) { return SymbolStr::empty(); }
            return this.addr_place_root(sm, aa.array);
        }
        // A dereference (`&*p`), a call result, a cast: not frame storage a name
        // owns. `*p` in particular is the caller-owned-buffer idiom this check
        // steers users toward, so it must not be reported.
        return SymbolStr::empty();
    }

    /// The frame-resident root of the first user-written `&` anywhere in `e`, or
    /// the empty symbol if `e` takes no such address. Synthesized `&` nodes are
    /// skipped: the compiler materializes those for a receiver or a comparison
    /// temp that it consumes within the same expression, so they never outlive
    /// the state that built them.
    frame_addr_root_expr(&this, sm: PollSm*, e: ExpressionNode*) -> SymbolStr {
        if (e == null) { return SymbolStr::empty(); }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = e as UnaryExprNode*;
            if (u.op.lexeme == "&" && !u.is_synthetic) {
                const root: SymbolStr = this.addr_place_root(sm, u.operand);
                if (root.is_valid()) { return root; }
            }
            return this.frame_addr_root_expr(sm, u.operand);
        }
        if (k == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            const l: SymbolStr = this.frame_addr_root_expr(sm, b.left);
            if (l.is_valid()) { return l; }
            return this.frame_addr_root_expr(sm, b.right);
        }
        if (k == NodeKind::CallExpression) {
            const c: CallExprNode* = e as CallExprNode*;
            const cl: SymbolStr = this.frame_addr_root_expr(sm, c.callee);
            if (cl.is_valid()) { return cl; }
            for (mut i: i64 = 0; i < c.arguments.length; i++) {
                const a: SymbolStr = this.frame_addr_root_expr(sm, c.arguments[i]);
                if (a.is_valid()) { return a; }
            }
            return SymbolStr::empty();
        }
        if (k == NodeKind::MemberAccess) {
            return this.frame_addr_root_expr(sm, (e as MemberAccessNode*).object);
        }
        if (k == NodeKind::CastExpression) {
            return this.frame_addr_root_expr(sm, (e as CastExprNode*).expression);
        }
        if (k == NodeKind::ArrayAccess) {
            const aa: ArrayAccessNode* = e as ArrayAccessNode*;
            const av: SymbolStr = this.frame_addr_root_expr(sm, aa.array);
            if (av.is_valid()) { return av; }
            return this.frame_addr_root_expr(sm, aa.index);
        }
        if (k == NodeKind::TernaryExpression) {
            const t: TernaryExprNode* = e as TernaryExprNode*;
            const c1: SymbolStr = this.frame_addr_root_expr(sm, t.condition);
            if (c1.is_valid()) { return c1; }
            const c2: SymbolStr = this.frame_addr_root_expr(sm, t.true_expr);
            if (c2.is_valid()) { return c2; }
            return this.frame_addr_root_expr(sm, t.false_expr);
        }
        if (k == NodeKind::StructLiteral) {
            const sl: StructLiteralNode* = e as StructLiteralNode*;
            for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                const f: SymbolStr = this.frame_addr_root_expr(sm, sl.field_inits[i].value);
                if (f.is_valid()) { return f; }
            }
            return SymbolStr::empty();
        }
        if (k == NodeKind::AwaitExpression) {
            return this.frame_addr_root_expr(sm, (e as AwaitExprNode*).operand);
        }
        if (k == NodeKind::MatchExpression) {
            const me: MatchExprNode* = e as MatchExprNode*;
            const s: SymbolStr = this.frame_addr_root_expr(sm, me.subject);
            if (s.is_valid()) { return s; }
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                if (me.arms[i] == null) { continue; }
                const g: SymbolStr = this.frame_addr_root_expr(sm, me.arms[i].guard);
                if (g.is_valid()) { return g; }
                const b2: SymbolStr = this.frame_addr_root_stmt(sm, me.arms[i].body);
                if (b2.is_valid()) { return b2; }
            }
            return SymbolStr::empty();
        }
        return SymbolStr::empty();
    }

    /// Statement twin of `frame_addr_root_expr`, for the value-block body of a
    /// `match` expression arm.
    frame_addr_root_stmt(&this, sm: PollSm*, s: StatementNode*) -> SymbolStr {
        if (s == null) { return SymbolStr::empty(); }
        const k: NodeKind = s.kind;
        if (k == NodeKind::ExpressionStatement) {
            return this.frame_addr_root_expr(sm, (s as ExprStmtNode*).expression);
        }
        if (k == NodeKind::ReturnStatement) {
            return this.frame_addr_root_expr(sm, (s as ReturnStmtNode*).expression);
        }
        if (k == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = s as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                return this.frame_addr_root_expr(sm, (ds.declaration as VarDeclNode*).initializer);
            }
            return SymbolStr::empty();
        }
        if (k == NodeKind::BlockStatement) {
            const blk: BlockStmtNode* = s as BlockStmtNode*;
            for (mut i: i64 = 0; i < blk.statements.length; i++) {
                const r: SymbolStr = this.frame_addr_root_stmt(sm, blk.statements[i]);
                if (r.is_valid()) { return r; }
            }
            return SymbolStr::empty();
        }
        return SymbolStr::empty();
    }

    /// The frame-resident address root assigned into `name` by a `<name> = <expr>;`
    /// anywhere in `blk`, or the empty symbol. Complements the declaration
    /// initializer: a pointer may be declared null and filled in later.
    assigned_frame_addr_root(&this, sm: PollSm*, blk: BlockStmtNode*, name: SymbolStr) -> SymbolStr {
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            const s: StatementNode* = blk.statements[i];
            if (s == null || s.kind != NodeKind::ExpressionStatement) { continue; }
            const e: ExpressionNode* = (s as ExprStmtNode*).expression;
            if (e == null || (e as ASTNode*).kind != NodeKind::BinaryExpression) { continue; }
            const b: BinaryExprNode* = e as BinaryExprNode*;
            if (b.op.kind != TokenType::Equal) { continue; }
            if (b.left == null || (b.left as ASTNode*).kind != NodeKind::Identifier) { continue; }
            if (!(b.left as IdentifierNode*).name.equals(name)) { continue; }
            const r: SymbolStr = this.frame_addr_root_expr(sm, b.right);
            if (r.is_valid()) { return r; }
        }
        return SymbolStr::empty();
    }

    /// Reject a value that is about to be carried across a suspend when what it
    /// holds is the address of something in the poll frame.
    ///
    /// Every poll runs on a fresh native frame, and a carried local is
    /// re-materialized at a new address in each state, so an address taken in one
    /// state names storage that is dead by the time a later state dereferences
    /// it. The write then lands on unrelated stack instead of faulting, which is
    /// why this has to be a compile error rather than something a test catches.
    /// Returns true when it reported, leaving the caller to unwind.
    reject_frame_addr_carry(mut &this, sm: PollSm*, vd: VarDeclNode*, nm: SymbolStr) -> boolean {
        mut root: SymbolStr = this.frame_addr_root_expr(sm, vd.initializer);
        if (!root.is_valid()) {
            for (mut b: i64 = 0; b < sm.blocks.length; b++) {
                if (root.is_valid()) { continue; }
                root = this.assigned_frame_addr_root(sm, sm.blocks[b], nm);
            }
        }
        if (!root.is_valid()) { return false; }
        this.ctx.emit_error_at(ErrorCode::E0455_DANGLING_POINTER,
            format("async: `%s` holds the address of the local or parameter `%s` and is live across an `await`; each poll runs on a fresh frame, so that address is dangling by the time a later step uses it — have the caller own the storage and pass a pointer parameter, whose pointee the suspend does not move",
                   this.intern.resolve(this.strip_local_marker(nm)),
                   this.intern.resolve(this.strip_local_marker(root))),
            vd.span);
        sm.ok = false;
        return true;
    }

    /// A local's source spelling, recovered from the rename `mint_local`
    /// recorded, so a diagnostic never shows the internal `$L` suffix. A name
    /// that was never renamed (a parameter, a global) passes through.
    strip_local_marker(&this, name: SymbolStr) -> SymbolStr {
        for (mut i: i64 = 0; i < this.frame_locals.length; i++) {
            if (this.frame_locals[i].equals(name)) { return this.frame_local_src[i]; }
        }
        return name;
    }

    /// After the state blocks are built, promote every top-level local read in a
    /// state other than the one it is declared in to a struct field: a value
    /// cannot live on the native stack across a suspend. The store goes at the
    /// end of the declaring block (it still runs before that block falls off);
    /// a `const <name> = this.<field>;` load is prepended to every other block
    /// that reads it. References across a suspend are forbidden (E0455); `mut` /
    /// aggregate locals across a suspend are deferred with a loud diagnostic.
    promote_cross_state(mut &this, sm: PollSm*) -> void {
        const span: SourceSpan = sm.span;
        mut d_names: SymbolStr[] = [];
        mut d_states: i64[] = [];
        mut d_nodes: VarDeclNode*[] = [];
        for (mut b: i64 = 0; b < sm.blocks.length; b++) {
            const blk: BlockStmtNode* = sm.blocks[b];
            for (mut i: i64 = 0; i < blk.statements.length; i++) {
                const vd: VarDeclNode* = this.stmt_decl_var(blk.statements[i]);
                if (vd != null) { d_names.push(vd.name); d_states.push(b); d_nodes.push(vd); }
            }
        }

        for (mut d: i64 = 0; d < d_names.length; d++) {
            const nm: SymbolStr = d_names[d];
            const ds: i64 = d_states[d];
            const vd: VarDeclNode* = d_nodes[d];

            mut cross: boolean = false;
            for (mut b: i64 = 0; b < sm.blocks.length; b++) {
                if (b != ds && this.block_reads_name(sm.blocks[b], nm)) { cross = true; }
            }
            if (!cross) { continue; }

            const lty: TypeRef = vd.resolved_type;
            const lt: Type* = this.arena.lookup(lty.id);
            const lk: TypeKind = if (lt != null) { lt.kind } else { TypeKind::Error };
            if (lk == TypeKind::Reference) {
                this.ctx.emit_error_at(ErrorCode::E0455_DANGLING_POINTER,
                    "async: a reference cannot be held live across an `await` (owned values only); a suspended future may outlive the referent",
                    vd.span);
                sm.ok = false; return;
            }
            if (!this.zeroable_kind(lk)) {
                // An aggregate cannot use either scalar strategy: there is no
                // zero value for the constructor to give the field, and the
                // const path's copy-per-reader would drop an owning value once
                // per copy. It lives in an `Option<T>` field instead — `None`
                // until first stored, so a future dropped before that has
                // nothing to drop — and moves between that field and a plain
                // block-local: taken on entry to a state, handed back on the way
                // out. Exactly one live copy at any moment, and inside a block
                // the value is an ordinary local, so every use of it (method
                // call, field access, reassignment, partial move, scope-exit
                // drop) keeps its normal meaning.
                //
                // A by-name protocol needs the name to identify one value, so a
                // name declared in two states is rejected rather than conflated.
                mut agg_decls: i64 = 0i64;
                for (mut d2: i64 = 0; d2 < d_names.length; d2++) {
                    if (d_names[d2].equals(nm)) { agg_decls += 1i64; }
                }
                if (agg_decls > 1i64) {
                    this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                        "async: an aggregate local whose name is re-declared in another state cannot be carried across an `await`; rename one of them",
                        vd.span);
                    sm.ok = false; return;
                }
                // Only a state that READS the value before writing it needs it to
                // have survived the suspend. A state that assigns first produces
                // its own value and merely needs the name to exist — which is the
                // whole owned-handle I/O idiom (`s` is handed to the operation and
                // taken back out of its result, so it is never live across the
                // suspend at all). Carrying such a value anyway would try to store
                // a name the state had already moved away.
                mut needs_carry: boolean = false;
                for (mut b: i64 = 0; b < sm.blocks.length; b++) {
                    if (b == ds) { continue; }
                    if (this.block_first_use(sm.blocks[b], nm) == 1i64) { needs_carry = true; }
                    // A rebuild nested in a branch is not a self-produced value:
                    // the path that skips the branch keeps the previous one, so
                    // the value crosses the suspend either way.
                    if (this.block_cond_write(sm.blocks[b], nm)) { needs_carry = true; }
                }

                if (!needs_carry) {
                    // Nothing reads it across a state boundary: leave the value
                    // on the stack and let each other state that assigns it
                    // declare it at that assignment.
                    for (mut b: i64 = 0; b < sm.blocks.length; b++) {
                        if (b == ds) { continue; }
                        if (this.block_first_use(sm.blocks[b], nm) == 0i64) { continue; }
                        if (!this.decl_at_first_assignment(sm.blocks[b], nm, lty, span)) {
                            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                                "async: this value is rebuilt after an `await` from inside a branch; assign it once at the top level of that step (`x = …;`) so the state machine can bind it there",
                                vd.span);
                            sm.ok = false; return;
                        }
                    }
                    continue;
                }

                if (this.reject_frame_addr_carry(sm, vd, nm)) { return; }

                mut agg_args: TypeRef[] = [lty];
                const opt_ty: TypeRef = this.ctx.generic_registry.instantiate(sm.opt_base, &agg_args);
                if (!opt_ty.is_valid()) {
                    this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                        "async: could not build the carrier for an aggregate held across an `await`",
                        vd.span);
                    sm.ok = false; return;
                }
                const afield: SymbolStr = this.intern.intern(
                    format("__agg_%lld_%s", ds, this.intern.resolve(nm)));

                // Declaring state: the local is built as written, then handed to
                // the field as the state falls off — unless the state gave the
                // value away (passed it to the operation it is awaiting), in
                // which case there is nothing of its own left to hand over. No
                // hand-back before this state's own suspend either: that suspend
                // is what produces the value, so it runs before it exists.
                // Read before the store below is appended: that store hands the
                // value to `Option::Some` BY VALUE, so asking afterwards would
                // report every declaring state as having given the value away.
                const ds_publishes: boolean = this.needs_handback(sm.blocks[ds], nm);
                if (ds_publishes) {
                    sm.blocks[ds].add_statement(
                        this.agg_store_stmt(sm, afield, opt_ty, nm, lty, span));
                }

                // Every other state that touches it: a reader takes it back on
                // entry, a writer gets a fresh binding to fill; either way the
                // value is handed over again on the way out — including before a
                // suspend, which returns before the block's tail runs and would
                // otherwise leave the field empty for the next poll.
                for (mut b: i64 = 0; b < sm.blocks.length; b++) {
                    if (b == ds) { continue; }
                    const use_kind: i64 = this.block_first_use(sm.blocks[b], nm);
                    if (use_kind == 0i64) { continue; }
                    // A conditional rebuild is carried in like a read: the take
                    // gives the state the previous value, the nested assignment
                    // replaces it only on the path that runs, and either way the
                    // one live value is handed back on the way out.
                    mut carried_in: boolean = (use_kind == 1i64);
                    if (!carried_in && this.block_cond_write(sm.blocks[b], nm)) {
                        // The take can only find a value the declaring state
                        // actually published.  A state that gave the value away
                        // stored nothing, so there is no previous value for the
                        // skipped path to keep and the rebuild has to be
                        // unconditional.
                        if (!ds_publishes) {
                            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                                "async: this value is given away before the `await` and then rebuilt from inside a branch, so the branch that is not taken has nothing to keep; assign it once at the top level of that step (`x = …;`)",
                                vd.span);
                            sm.ok = false; return;
                        }
                        carried_in = true;
                    }
                    if (carried_in) {
                        this.prepend_agg_take(sm.blocks[b], nm, afield, lty, opt_ty,
                                              sm.struct_ref, true, span);
                        // Live from the top of this state, so a suspend partway
                        // through has to hand it back first.
                        this.store_before_suspends(sm, sm.blocks[b] as StatementNode*,
                                                   afield, opt_ty, nm, lty, span);
                    } else if (!this.decl_at_first_assignment(sm.blocks[b], nm, lty, span)) {
                        this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                            "async: this value is rebuilt after an `await` from inside a branch; assign it once at the top level of that step (`x = …;`) so the state machine can bind it there",
                            vd.span);
                        sm.ok = false; return;
                    }
                    if (this.needs_handback(sm.blocks[b], nm)) {
                        sm.blocks[b].add_statement(
                            this.agg_store_stmt(sm, afield, opt_ty, nm, lty, span));
                    }
                }
                sm.prom_field.push(afield);
                sm.prom_tys.push(opt_ty);
                sm.prom_opt.push(true);
                sm.nprom += 1i64;
                continue;
            }

            // Reaching here the value is a scalar that one of the two paths below
            // will carry, so an address of the frame inside it would outlive the
            // storage it names.
            if (this.reject_frame_addr_carry(sm, vd, nm)) { return; }

            if (vd.is_mutable) {
                // A `mut` value written across states cannot live on the native
                // stack (each state re-enters `poll` afresh), and the const
                // store/load model would leave stale copies diverging from later
                // writes. Promote to a field that is the SINGLE source of truth:
                // replace the declaration with a field store and rewrite every
                // read AND write of the name to `this.<field>` in place. A by-name
                // rewrite is ambiguous if the name is re-declared in another state,
                // so reject that (rare) case rather than conflate two live ranges.
                mut decl_sites: i64 = 0i64;
                for (mut d2: i64 = 0; d2 < d_names.length; d2++) {
                    if (d_names[d2].equals(nm)) { decl_sites += 1i64; }
                }
                if (decl_sites > 1i64) {
                    this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                        "async: a `mut` local whose name is re-declared in another state cannot be carried across an `await`; rename one of them",
                        vd.span);
                    sm.ok = false; return;
                }
                const mfield: SymbolStr = this.intern.intern(
                    format("__mut_%lld_%s", ds, this.intern.resolve(nm)));
                this.rewrite_mut_decl(sm, ds, vd, mfield, lty);
                for (mut b: i64 = 0; b < sm.blocks.length; b++) {
                    const blk2: BlockStmtNode* = sm.blocks[b];
                    for (mut i: i64 = 0; i < blk2.statements.length; i++) {
                        this.subst_name_stmt(blk2.statements[i], nm, mfield, sm.struct_ref, lty, span);
                    }
                }
                sm.prom_field.push(mfield);
                sm.prom_tys.push(lty);
                sm.prom_opt.push(false);
                sm.nprom += 1i64;
                continue;
            }

            // A const scalar is written once, so a copy per reader is sound: keep
            // the local, store its value at the end of the declaring block, and
            // reload it at the top of every other block that reads it.
            const field: SymbolStr = this.intern.intern(
                format("__cross_%lld_%s", ds, this.intern.resolve(nm)));
            sm.blocks[ds].add_statement(this.assign_member_stmt(
                sm.struct_ref, field, lty, this.ident(nm, lty, span), span));
            for (mut b: i64 = 0; b < sm.blocks.length; b++) {
                if (b != ds && this.block_reads_name(sm.blocks[b], nm)) {
                    this.prepend_load(sm.blocks[b], nm, field, lty, sm.struct_ref, span);
                }
            }
            sm.prom_field.push(field);
            sm.prom_tys.push(lty);
            sm.prom_opt.push(false);
            sm.nprom += 1i64;
        }
    }

    // ---- pre-lowering `await` hoisting (statement-level ANF) ----

    /// A fresh frame temporary for a hoisted subexpression.
    ///
    /// `disambiguate_locals` runs after this pass and renames these along with
    /// the user's own locals, which is what registers them as frame locals — so
    /// every check downstream, the address-of-across-suspend one included,
    /// treats a temp exactly as it treats a local the user wrote.
    mint_temp(mut &this, base: string) -> SymbolStr {
        const idx: u64 = this.counter;
        this.counter += 1u64;
        const fresh: SymbolStr = this.intern.intern(format("%s$H%llu", base, idx));
        // Registered as a frame local so the address-of-across-suspend check
        // sees a temp exactly as it sees a local. Harmless for the pre-rename
        // pass, whose registrations `disambiguate_locals` clears before making
        // its own; load-bearing for the temps minted during lowering itself,
        // which the rename has already run past.
        this.frame_locals.push(fresh);
        this.frame_local_src.push(fresh);
        return fresh;
    }

    /// `<name> = <rhs>;` against a local.
    assign_local_stmt(&this, name: SymbolStr, ty: TypeRef, rhs: ExpressionNode*,
                      span: SourceSpan) -> StatementNode* {
        mut lhs: ExpressionNode* = this.ident(name, ty, span);
        const eq: Token = Token::new(TokenType::Equal, "=",
                                     span.start_line as int, span.start_col as int);
        mut assign: BinaryExprNode* = new BinaryExprNode(eq, lhs, rhs, span);
        assign.set_resolved_type(this.arena.get_void());
        mut es: ExprStmtNode* = new ExprStmtNode(assign as ExpressionNode*, span);
        return es as StatementNode*;
    }

    /// `!(<e>)`. Marked synthetic for the same reason `deref`/`addr_of` are: the
    /// checks that constrain user syntax skip compiler-built nodes.
    not_expr(&this, e: ExpressionNode*, span: SourceSpan) -> ExpressionNode* {
        const bang: Token = Token::new(TokenType::Exclaim, "!",
                                       span.start_line as int, span.start_col as int);
        mut u: UnaryExprNode* = new UnaryExprNode(bang, e, span);
        u.is_synthetic = true;
        u.set_resolved_type(this.arena.get_bool());
        return u as ExpressionNode*;
    }

    /// True when evaluating `e` produces no effect the surrounding order can
    /// observe, so leaving it in place while an `await` to its RIGHT is lifted
    /// out above it preserves what the program does.
    ///
    /// Reads qualify, and not merely as an optimization — they MUST stay in
    /// place. Lifting `acc` out of `acc = acc + await f()` into a temporary
    /// would MOVE a droppable local out of `acc`, leaving the assignment to read
    /// a binding that no longer owns anything. Their value also cannot change
    /// across the suspend: reaching this frame from elsewhere needs a pointer
    /// into it held across the `await`, which `E0455` rejects.
    await_transparent(&this, e: ExpressionNode*) -> boolean {
        if (e == null) { return true; }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::Literal || k == NodeKind::Identifier ||
            k == NodeKind::ScopeResolution || k == NodeKind::SizeofExpression ||
            k == NodeKind::AlignofExpression) { return true; }
        if (k == NodeKind::MemberAccess) {
            return this.await_transparent((e as MemberAccessNode*).object);
        }
        if (k == NodeKind::CastExpression) {
            return this.await_transparent((e as CastExprNode*).expression);
        }
        if (k == NodeKind::ArrayAccess) {
            const aa: ArrayAccessNode* = e as ArrayAccessNode*;
            // An overloaded `[]` is a call, and a call is not transparent.
            if (aa.desugared_call != null) { return false; }
            return this.await_transparent(aa.array) && this.await_transparent(aa.index);
        }
        if (k == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = e as UnaryExprNode*;
            // `++`/`--` write, and an overloaded operator is a call.
            if (u.op.kind == TokenType::PlusPlus || u.op.kind == TokenType::MinusMinus) {
                return false;
            }
            if (u.desugared_call != null) { return false; }
            return this.await_transparent(u.operand);
        }
        if (k == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            if (b.op.kind.is_assignment_op() || b.desugared_call != null) { return false; }
            return this.await_transparent(b.left) && this.await_transparent(b.right);
        }
        return false;
    }

    /// Lift `e` into a temporary when something to its right will suspend
    /// (`force`) and it is not a pure read. Returns what the parent should hold
    /// in its place.
    hoist_operand(mut &this, e: ExpressionNode*, force: boolean,
                  pre: HoistPre*) -> ExpressionNode* {
        mut r: ExpressionNode* = this.hoist_expr(e, pre);
        if (!force || r == null) { return r; }
        if (this.await_transparent(r)) { return r; }
        const ty: TypeRef = r.resolved_type;
        // Without a type there is no well-formed temporary to declare. The shape
        // that produced it is already ill-typed, so leaving it in place lets the
        // real diagnostic stand instead of adding a confusing second one.
        if (!ty.is_valid()) { return r; }
        const t: SymbolStr = this.mint_temp("__ord");
        pre.push(this.var_decl_stmt(t, false, ty, r, (r as ASTNode*).span));
        return this.ident(t, ty, (r as ASTNode*).span);
    }

    /// True when any of `args[from..]` holds an `await`, i.e. whether evaluating
    /// argument `from - 1` happens before a suspend.
    args_await_after(&this, args: &ExpressionNode*[], from: i64) -> boolean {
        for (mut i: i64 = from; i < args.length; i++) {
            if (this.expr_await_count(args[i]) > 0i64) { return true; }
        }
        return false;
    }

    /// Lift every `await` nested inside `e` into its own statement appended to
    /// `pre`, returning the expression the parent should hold instead.
    ///
    /// Operands are visited strictly left to right, and any operand to the left
    /// of a lifted `await` that is not a pure read is lifted with it — so no
    /// effect ever crosses the suspend it originally preceded.
    hoist_expr(mut &this, e: ExpressionNode*, pre: HoistPre*) -> ExpressionNode* {
        if (e == null) { return null; }
        // A `break`/`continue` in a `match` EXPRESSION arm needs the same
        // rewrite an `await` there does, for the same reason: in an exploded
        // loop the edge is a state transition, which only a `match` STATEMENT
        // arm can carry. Left an expression it would compile to a native break
        // out of the state-dispatch loop rather than the user's.
        if (this.expr_await_count(e) == 0i64 && !this.expr_has_free_edge(e, false)) { return e; }
        const k: NodeKind = (e as ASTNode*).kind;
        const span: SourceSpan = (e as ASTNode*).span;

        if (k == NodeKind::AwaitExpression) {
            mut aw: AwaitExprNode* = e as AwaitExprNode*;
            aw.operand = this.hoist_expr(aw.operand, pre);
            const ao: TypeRef = aw.resolved_type;
            if (!ao.is_valid()) { return e; }
            const t: SymbolStr = this.mint_temp("__aw");
            pre.push(this.var_decl_stmt(t, false, ao, e, span));
            return this.ident(t, ao, span);
        }

        if (k == NodeKind::BinaryExpression) {
            mut b: BinaryExprNode* = e as BinaryExprNode*;
            // `&&`/`||` only evaluate their right operand for some values of the
            // left, so lifting an `await` out of it would run the suspend
            // unconditionally. Becomes a branch instead.
            if ((b.op.kind == TokenType::AmpAmp || b.op.kind == TokenType::PipePipe) &&
                this.expr_await_count(b.right) > 0i64) {
                return this.hoist_short_circuit(b, pre);
            }
            if (b.op.kind.is_assignment_op()) {
                b.left  = this.hoist_place(b.left, this.expr_await_count(b.right) > 0i64, pre);
                b.right = this.hoist_expr(b.right, pre);
                return e;
            }
            b.left  = this.hoist_operand(b.left, this.expr_await_count(b.right) > 0i64, pre);
            b.right = this.hoist_expr(b.right, pre);
            return e;
        }

        if (k == NodeKind::TernaryExpression) {
            mut t: TernaryExprNode* = e as TernaryExprNode*;
            // Same reason as `&&`: an arm runs only for one value of the
            // condition, so its `await` cannot be lifted above the test.
            if (this.expr_await_count(t.true_expr) > 0i64 ||
                this.expr_await_count(t.false_expr) > 0i64) {
                return this.hoist_ternary(t, pre);
            }
            t.condition = this.hoist_expr(t.condition, pre);
            return e;
        }

        if (k == NodeKind::UnaryExpression) {
            mut u: UnaryExprNode* = e as UnaryExprNode*;
            u.operand = this.hoist_expr(u.operand, pre);
            return e;
        }

        if (k == NodeKind::CastExpression) {
            mut c: CastExprNode* = e as CastExprNode*;
            c.expression = this.hoist_expr(c.expression, pre);
            return e;
        }

        if (k == NodeKind::CallExpression) {
            mut c: CallExprNode* = e as CallExprNode*;
            // The callee is evaluated first. A method call's callee is a member
            // access on the receiver, which `await_transparent` keeps in place —
            // lifting it would copy (and so move out of) the receiver.
            c.callee = this.hoist_operand(c.callee, this.args_await_after(&c.arguments, 0i64), pre);
            for (mut i: i64 = 0; i < c.arguments.length; i++) {
                c.arguments[i] = this.hoist_operand(
                    c.arguments[i], this.args_await_after(&c.arguments, i + 1i64), pre);
            }
            return e;
        }

        if (k == NodeKind::MemberAccess) {
            mut m: MemberAccessNode* = e as MemberAccessNode*;
            m.object = this.hoist_expr(m.object, pre);
            return e;
        }

        if (k == NodeKind::MatchExpression) {
            mut me: MatchExprNode* = e as MatchExprNode*;
            mut in_arms: i64 = 0i64;
            for (mut i: i64 = 0; i < me.arms.length; i++) {
                if (me.arms[i] != null) {
                    in_arms += this.expr_await_count(me.arms[i].guard);
                    in_arms += this.stmt_await_count(me.arms[i].body);
                    if (this.has_free_edge(me.arms[i].body, false)) { in_arms += 1i64; }
                }
            }
            // Only an arm that suspends or leaves the loop needs the expression
            // to become a statement; an `await` confined to the subject lifts
            // like any other operand and leaves the `match` an expression.
            if (in_arms == 0i64) {
                me.subject = this.hoist_expr(me.subject, pre);
                return e;
            }
            return this.hoist_match_expr(me, pre);
        }

        if (k == NodeKind::ArrayAccess) {
            mut a: ArrayAccessNode* = e as ArrayAccessNode*;
            a.array = this.hoist_operand(a.array, this.expr_await_count(a.index) > 0i64, pre);
            a.index = this.hoist_expr(a.index, pre);
            return e;
        }

        if (k == NodeKind::ArrayLiteral) {
            mut al: ArrayLiteralNode* = e as ArrayLiteralNode*;
            for (mut i: i64 = 0; i < al.elements.length; i++) {
                al.elements[i] = this.hoist_operand(
                    al.elements[i], this.args_await_after(&al.elements, i + 1i64), pre);
            }
            return e;
        }

        if (k == NodeKind::StructLiteral) {
            mut sl: StructLiteralNode* = e as StructLiteralNode*;
            for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                mut rest: boolean = false;
                for (mut j: i64 = i + 1i64; j < sl.field_inits.length; j++) {
                    if (this.expr_await_count(sl.field_inits[j].value) > 0i64) { rest = true; }
                }
                sl.field_inits[i].value = this.hoist_operand(sl.field_inits[i].value, rest, pre);
            }
            return e;
        }

        return e;
    }

    /// A place expression (an assignment's left side). Its subexpressions are
    /// evaluated for an address, not a value, so only the parts that ARE values
    /// — an index, the object of a member access — are lifted. Lifting the place
    /// itself would assign to a copy.
    hoist_place(mut &this, e: ExpressionNode*, force: boolean,
                pre: HoistPre*) -> ExpressionNode* {
        if (e == null) { return null; }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::ArrayAccess) {
            mut a: ArrayAccessNode* = e as ArrayAccessNode*;
            a.array = this.hoist_place(a.array, force, pre);
            a.index = this.hoist_operand(a.index, force, pre);
            return e;
        }
        if (k == NodeKind::MemberAccess) {
            mut m: MemberAccessNode* = e as MemberAccessNode*;
            m.object = this.hoist_place(m.object, force, pre);
            return e;
        }
        if (k == NodeKind::UnaryExpression) {
            mut u: UnaryExprNode* = e as UnaryExprNode*;
            u.operand = this.hoist_operand(u.operand, force, pre);
            return e;
        }
        return this.hoist_expr(e, pre);
    }

    /// `L && R` / `L || R` where `R` awaits, as the branch it already means:
    ///
    ///     mut $sc = L;  if ($sc) { … $sc = R; }        // `&&`
    ///     mut $sc = L;  if (!$sc) { … $sc = R; }       // `||`
    ///
    /// `R`'s own lifted statements go INSIDE the branch, which is what keeps the
    /// suspend conditional.
    hoist_short_circuit(mut &this, b: BinaryExprNode*, pre: HoistPre*) -> ExpressionNode* {
        const span: SourceSpan = (b as ASTNode*).span;
        const bool_ty: TypeRef = this.arena.get_bool();
        mut left: ExpressionNode* = this.hoist_expr(b.left, pre);
        const t: SymbolStr = this.mint_temp("__sc");
        pre.push(this.var_decl_stmt(t, true, bool_ty, left, span));

        mut inner: HoistPre = HoistPre { stmts: [] };
        mut right: ExpressionNode* = this.hoist_expr(b.right, &inner);
        mut blk: BlockStmtNode* = new BlockStmtNode(span);
        for (mut i: i64 = 0; i < inner.stmts.length; i++) { blk.add_statement(inner.stmts[i]); }
        blk.add_statement(this.assign_local_stmt(t, bool_ty, right, span));

        mut test: ExpressionNode* = this.ident(t, bool_ty, span);
        if (b.op.kind == TokenType::PipePipe) { test = this.not_expr(test, span); }
        pre.push(new IfStmtNode(test, blk as StatementNode*, null, span) as StatementNode*);
        return this.ident(t, bool_ty, span);
    }

    /// `C ? A : B` where an arm awaits, as the branch it already means:
    ///
    ///     mut $tv: T;  if (C) { … $tv = A; } else { … $tv = B; }
    ///
    /// The temporary is declared without an initializer on purpose: both arms
    /// assign it, so it is always initialized before its use, and giving it a
    /// placeholder value would mean synthesizing one for a type that may own a
    /// resource.
    hoist_ternary(mut &this, t: TernaryExprNode*, pre: HoistPre*) -> ExpressionNode* {
        const span: SourceSpan = (t as ASTNode*).span;
        const vty: TypeRef = (t as ExpressionNode*).resolved_type;
        if (!vty.is_valid()) { return t as ExpressionNode*; }
        mut cond: ExpressionNode* = this.hoist_expr(t.condition, pre);
        const tv: SymbolStr = this.mint_temp("__tv");
        pre.push(this.var_decl_stmt(tv, true, vty, null, span));

        mut then_blk: BlockStmtNode* = this.hoist_arm_block(t.true_expr, tv, vty, span);
        mut else_blk: BlockStmtNode* = this.hoist_arm_block(t.false_expr, tv, vty, span);
        pre.push(new IfStmtNode(cond, then_blk as StatementNode*,
                                else_blk as StatementNode*, span) as StatementNode*);
        return this.ident(tv, vty, span);
    }

    /// A `match` EXPRESSION whose arms suspend, as the `match` STATEMENT it
    /// already means:
    ///
    ///     mut $mv: T;
    ///     match (S) { p => { … $mv = <arm value>; } … }
    ///
    /// The state machine already lowers a `match` STATEMENT arm into its own
    /// states, so turning each arm's value into an assignment is the whole of
    /// what an awaiting arm needs. The value has to become the assignment BEFORE
    /// the arm block is rewritten: a bare `await f()` in value position would
    /// otherwise lift into a carrier whose result nothing reads.
    hoist_match_expr(mut &this, me: MatchExprNode*, pre: HoistPre*) -> ExpressionNode* {
        const span: SourceSpan = (me as ASTNode*).span;
        const vty: TypeRef = (me as ExpressionNode*).resolved_type;
        if (!vty.is_valid()) { return me as ExpressionNode*; }
        // A guard is left ON its arm rather than lifted: it runs per arm, after
        // that arm's pattern matched, so it cannot be evaluated above the
        // `match`. One that suspends is why the statement this becomes may lower
        // to a decision chain instead of a dispatch (`lower_match_chain_sm`).
        mut subject: ExpressionNode* = this.hoist_expr(me.subject, pre);
        const tv: SymbolStr = this.mint_temp("__mv");
        pre.push(this.var_decl_stmt(tv, true, vty, null, span));

        mut ms: MatchStmtNode* = new MatchStmtNode(subject, span);
        for (mut i: i64 = 0; i < me.arms.length; i++) {
            mut arm: MatchArmNode* = me.arms[i];
            if (arm == null) { continue; }
            arm.body = this.arm_value_to_assign(arm.body, tv, vty);
            arm.body = this.hoist_branch(arm.body);
            ms.add_arm(arm);
        }
        pre.push(ms as StatementNode*);
        return this.ident(tv, vty, span);
    }

    /// Rewrite a `match`-expression arm body so it ASSIGNS the arm's value to
    /// `tv` instead of producing it. The value is the block's trailing
    /// expression statement, which is how an arm value is recorded; an arm that
    /// diverges instead has none and is returned untouched.
    arm_value_to_assign(mut &this, body: StatementNode*, tv: SymbolStr,
                        vty: TypeRef) -> StatementNode* {
        if (body == null) { return null; }
        if (body.kind == NodeKind::ExpressionStatement) {
            const es: ExprStmtNode* = body as ExprStmtNode*;
            return this.assign_local_stmt(tv, vty, es.expression, body.span);
        }
        if (body.kind != NodeKind::BlockStatement) { return body; }
        mut blk: BlockStmtNode* = body as BlockStmtNode*;
        const n: i64 = blk.statements.length;
        if (n == 0i64) { return body; }
        const last: StatementNode* = blk.statements[n - 1i64];
        if (last == null || last.kind != NodeKind::ExpressionStatement) { return body; }
        const es: ExprStmtNode* = last as ExprStmtNode*;
        blk.statements[n - 1i64] = this.assign_local_stmt(tv, vty, es.expression, last.span);
        return body;
    }

    /// `{ <lifted statements of `value`>; <tv> = <value>; }` — one arm of a
    /// lowered `?:`.
    hoist_arm_block(mut &this, value: ExpressionNode*, tv: SymbolStr, vty: TypeRef,
                    span: SourceSpan) -> BlockStmtNode* {
        mut inner: HoistPre = HoistPre { stmts: [] };
        mut v: ExpressionNode* = this.hoist_expr(value, &inner);
        mut blk: BlockStmtNode* = new BlockStmtNode(span);
        for (mut i: i64 = 0; i < inner.stmts.length; i++) { blk.add_statement(inner.stmts[i]); }
        blk.add_statement(this.assign_local_stmt(tv, vty, v, span));
        return blk;
    }

    /// Rewrite every statement of `blk` in place, splicing each one's lifted
    /// statements in immediately before it.
    hoist_block(mut &this, blk: BlockStmtNode*) -> void {
        if (blk == null) { return; }
        mut acc: HoistPre = HoistPre { stmts: [] };
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            this.hoist_stmt(blk.statements[i], &acc);
        }
        blk.statements = acc.stmts;
    }

    /// A branch body (a block, a bare statement, or an `else if`) rewritten into
    /// a block, so a statement that lifts anything has somewhere to put it.
    hoist_branch(mut &this, s: StatementNode*) -> StatementNode* {
        if (s == null) { return null; }
        if (s.kind == NodeKind::BlockStatement) {
            this.hoist_block(s as BlockStmtNode*);
            return s;
        }
        mut out: HoistPre = HoistPre { stmts: [] };
        this.hoist_stmt(s, &out);
        if (out.stmts.length == 1i64) { return out.stmts[0]; }
        mut blk: BlockStmtNode* = new BlockStmtNode(s.span);
        for (mut i: i64 = 0; i < out.stmts.length; i++) { blk.add_statement(out.stmts[i]); }
        return blk as StatementNode*;
    }

    /// Rewrite one statement, appending what it lifts and then the statement
    /// itself to `out`. A statement holding no `await` anywhere is untouched.
    hoist_stmt(mut &this, s: StatementNode*, out: HoistPre*) -> void {
        if (s == null) { return; }
        if (this.stmt_await_count(s) == 0i64 && !this.has_free_break_continue(s)) {
            out.push(s); return;
        }
        const k: NodeKind = s.kind;
        mut pre: HoistPre = HoistPre { stmts: [] };

        if (k == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = s as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                mut vd: VarDeclNode* = ds.declaration as VarDeclNode*;
                vd.initializer = this.hoist_toplevel(vd.initializer, &pre);
            }
        } else if (k == NodeKind::ReturnStatement) {
            mut rs: ReturnStmtNode* = s as ReturnStmtNode*;
            rs.expression = this.hoist_toplevel(rs.expression, &pre);
        } else if (k == NodeKind::ExpressionStatement) {
            mut es: ExprStmtNode* = s as ExprStmtNode*;
            es.expression = this.hoist_toplevel(es.expression, &pre);
        } else if (k == NodeKind::BlockStatement) {
            this.hoist_block(s as BlockStmtNode*);
        } else if (k == NodeKind::IfStatement) {
            mut iff: IfStmtNode* = s as IfStmtNode*;
            // The condition is evaluated once, before either branch, so its
            // lifted statements belong ahead of the whole `if`.
            iff.condition = this.hoist_expr(iff.condition, &pre);
            iff.then_stmt = this.hoist_branch(iff.then_stmt);
            iff.else_stmt = this.hoist_branch(iff.else_stmt);
        } else if (k == NodeKind::MatchStatement) {
            mut m: MatchStmtNode* = s as MatchStmtNode*;
            m.subject = this.hoist_expr(m.subject, &pre);
            for (mut i: i64 = 0; i < m.arms.length; i++) {
                if (m.arms[i] != null) { m.arms[i].body = this.hoist_branch(m.arms[i].body); }
            }
        } else if (k == NodeKind::LoopStatement) {
            mut lp: LoopStmtNode* = s as LoopStmtNode*;
            lp.body = this.hoist_branch(lp.body);
        } else if (k == NodeKind::WhileStatement) {
            mut w: WhileStmtNode* = s as WhileStmtNode*;
            w.body = this.hoist_branch(w.body);
        } else if (k == NodeKind::DoWhileStatement) {
            mut dw: DoWhileStmtNode* = s as DoWhileStmtNode*;
            dw.body = this.hoist_branch(dw.body);
        } else if (k == NodeKind::ForStatement) {
            mut f: ForStmtNode* = s as ForStmtNode*;
            // The initializer runs once, before the loop, so what it lifts
            // belongs ahead of the whole `for`. The condition and the update run
            // per iteration and are rewritten during lowering instead, inside
            // the states `continue` re-enters.
            if (f.init != null) {
                if ((f.init as ASTNode*).kind == NodeKind::VariableDeclaration) {
                    mut vd: VarDeclNode* = f.init as VarDeclNode*;
                    vd.initializer = this.hoist_toplevel(vd.initializer, &pre);
                } else {
                    f.init = this.hoist_toplevel(f.init as ExpressionNode*, &pre) as ASTNode*;
                }
            }
            f.body = this.hoist_branch(f.body);
        }

        for (mut i: i64 = 0; i < pre.stmts.length; i++) { out.push(pre.stmts[i]); }
        out.push(s);
    }

    /// The expression a carrier statement holds. A top-level `await` is left
    /// where it is — that IS the shape the state machine explodes — and only its
    /// operand is rewritten.
    hoist_toplevel(mut &this, e: ExpressionNode*, pre: HoistPre*) -> ExpressionNode* {
        if (e == null) { return null; }
        if ((e as ASTNode*).kind == NodeKind::AwaitExpression) {
            mut aw: AwaitExprNode* = e as AwaitExprNode*;
            aw.operand = this.hoist_expr(aw.operand, pre);
            return e;
        }
        return this.hoist_expr(e, pre);
    }

    /// Rewrite the body so every surviving `await` sits at the top level of a
    /// statement the state machine already explodes: `const x = await e;`,
    /// `return await e;`, or `await e;`.
    ///
    ///     acc = g() + await f();   ->   const $g = g();
    ///                                   const $a = await f();
    ///                                   acc = $g + $a;
    ///
    /// Runs before `disambiguate_locals`, so the temporaries it introduces go
    /// through the same alpha-rename and frame registration as the body's own
    /// locals and are indistinguishable from them afterwards.
    hoist_awaits(mut &this, node: FunctionDeclNode*) -> void {
        if (node == null || node.body == null) { return; }
        if (node.body.kind != NodeKind::BlockStatement) { return; }
        this.hoist_block(node.body as BlockStmtNode*);
    }

    // ---- pre-lowering local disambiguation (scope-aware alpha-rename) ----

    rc_enter(&this, ctx: RenameCtx*) -> void { ctx.marks.push(ctx.orig.length); }

    rc_leave(&this, ctx: RenameCtx*) -> void {
        if (ctx.marks.length == 0i64) { return; }
        const m: i64 = ctx.marks[ctx.marks.length - 1i64];
        ctx.marks.pop();
        while (ctx.orig.length > m) { ctx.orig.pop(); ctx.repl.pop(); }
    }

    rc_bind(&this, ctx: RenameCtx*, name: SymbolStr, fresh: SymbolStr) -> void {
        ctx.orig.push(name);
        ctx.repl.push(fresh);
    }

    /// Resolve a use: the innermost binding of `name`, or `name` unchanged if it
    /// is bound in no active scope (a parameter / global / outer capture).
    rc_lookup(&this, ctx: RenameCtx*, name: SymbolStr) -> SymbolStr {
        mut i: i64 = ctx.orig.length - 1i64;
        while (i >= 0i64) {
            if (ctx.orig[i].equals(name)) { return ctx.repl[i]; }
            i -= 1i64;
        }
        return name;
    }

    /// A fresh, globally-unique local name derived from the original (kept as a
    /// prefix for readable generated IR). The `$L` marker never appears in source.
    mint_local(mut &this, orig: SymbolStr) -> SymbolStr {
        const idx: u64 = this.counter;
        this.counter += 1u64;
        const fresh: SymbolStr = this.intern.intern(format("%s$L%llu", this.intern.resolve(orig), idx));
        this.frame_locals.push(fresh);
        this.frame_local_src.push(orig);
        return fresh;
    }

    /// Rename a `const/mut <name> = <init>;` local: recurse into the initializer
    /// FIRST (its identifiers resolve to the enclosing scope, so `const x = x`
    /// reads the outer `x`), then mint a fresh name, rename the declaration in
    /// place, and bind original->fresh so the rest of this scope sees the local.
    rn_var_decl(mut &this, ctx: RenameCtx*, vd: VarDeclNode*) -> void {
        if (vd == null) { return; }
        this.rn_expr(ctx, vd.initializer);
        const orig: SymbolStr = vd.name;
        const fresh: SymbolStr = this.mint_local(orig);
        vd.name = fresh;
        this.rc_bind(ctx, orig, fresh);
    }

    /// Walk a block in its own scope.
    rn_block(mut &this, ctx: RenameCtx*, blk: BlockStmtNode*) -> void {
        if (blk == null) { return; }
        this.rc_enter(ctx);
        for (mut i: i64 = 0; i < blk.statements.length; i++) {
            this.rn_stmt(ctx, blk.statements[i]);
        }
        this.rc_leave(ctx);
    }

    /// Walk a branch/loop body as a scope (a bare non-block statement still gets
    /// its own frame, so a declaration in it does not leak to the enclosing scope).
    rn_scoped(mut &this, ctx: RenameCtx*, s: StatementNode*) -> void {
        if (s == null) { return; }
        if (s.kind == NodeKind::BlockStatement) { this.rn_block(ctx, s as BlockStmtNode*); return; }
        this.rc_enter(ctx);
        this.rn_stmt(ctx, s);
        this.rc_leave(ctx);
    }

    /// Walk a `match`/`match`-expression arm, alpha-renaming its pattern bindings
    /// to globally-unique names (exactly as `rn_var_decl` renames a `VarDecl`) so
    /// the by-name cross-state promotion in `lower_match_sm` cannot conflate this
    /// arm's binding with a same-named binding in a nested `match`, a sibling arm,
    /// or an outer local/param. Bindings shadow outer locals within the arm; the
    /// fresh name is bound into the scope so uses in the guard and body rewrite to
    /// it. OR-alternatives (`A(v) | B(v)`) share one fresh name for `v`.
    rn_arm(mut &this, ctx: RenameCtx*, arm: MatchArmNode*) -> void {
        if (arm == null) { return; }
        this.rc_enter(ctx);
        mut map: BindingRename = BindingRename { orig: [], fresh: [] };
        for (mut i: i64 = 0; i < arm.patterns.length; i++) {
            this.collect_pat_binding_names(arm.patterns[i], &map);
        }
        for (mut i: i64 = 0; i < map.orig.length; i++) {
            const f: SymbolStr = this.mint_local(map.orig[i]);
            map.fresh.push(f);
            this.rc_bind(ctx, map.orig[i], f);
        }
        for (mut i: i64 = 0; i < arm.patterns.length; i++) {
            this.rn_pat_apply(arm.patterns[i], &map);
        }
        this.rn_expr(ctx, arm.guard);
        this.rn_stmt(ctx, arm.body);
        this.rc_leave(ctx);
    }

    /// Collect the distinct binding names introduced by `pat` (a top-level
    /// identifier binding, an enum-variant payload binding, or a nested
    /// sub-pattern) into `map.orig`. A const-value identifier pattern (its
    /// `binding_name` was cleared by name resolution) introduces no binding.
    collect_pat_binding_names(&this, pat: PatternNode*, map: BindingRename*) -> void {
        if (pat == null) { return; }
        if (pat.pattern_kind == PatternKind::Identifier && pat.binding_name.is_valid()) {
            map.push_orig(pat.binding_name);
            return;
        }
        if (pat.pattern_kind != PatternKind::Enum) { return; }
        const epat: EnumPatternNode* = pat as EnumPatternNode*;
        for (mut j: i64 = 0; j < epat.elements.length; j++) {
            const pb: PatternBinding* = epat.binding_at(j);
            if (pb != null && pb.name.is_valid()) { map.push_orig(pb.name); continue; }
            const sub: PatternNode* = epat.sub_at(j);
            if (sub != null) { this.collect_pat_binding_names(sub, map); }
        }
    }

    /// Rewrite each binding name in `pat` to its fresh name from `map`, in place
    /// (mutating `PatternNode.binding_name` / `PatternBinding.name` through the
    /// AST node). The mirror of `collect_pat_binding_names`.
    rn_pat_apply(&this, pat: PatternNode*, map: BindingRename*) -> void {
        if (pat == null) { return; }
        if (pat.pattern_kind == PatternKind::Identifier && pat.binding_name.is_valid()) {
            const idx: i64 = map.index_of(pat.binding_name);
            if (idx >= 0i64) { pat.set_binding_name(map.fresh[idx]); }
            return;
        }
        if (pat.pattern_kind != PatternKind::Enum) { return; }
        const epat: EnumPatternNode* = pat as EnumPatternNode*;
        for (mut j: i64 = 0; j < epat.elements.length; j++) {
            mut pb: PatternBinding* = epat.binding_at(j);
            if (pb != null && pb.name.is_valid()) {
                const idx: i64 = map.index_of(pb.name);
                if (idx >= 0i64) { pb.name = map.fresh[idx]; }
                continue;
            }
            const sub: PatternNode* = epat.sub_at(j);
            if (sub != null) { this.rn_pat_apply(sub, map); }
        }
    }

    /// Walk a lambda: rename any capture that names a renamed outer local, then
    /// walk the body in a new scope where the lambda's own parameters shadow.
    rn_lambda(mut &this, ctx: RenameCtx*, lam: LambdaExprNode*) -> void {
        if (lam == null) { return; }
        for (mut i: i64 = 0; i < lam.captured_names.length; i++) {
            lam.captured_names[i] = this.rc_lookup(ctx, lam.captured_names[i]);
        }
        this.rc_enter(ctx);
        for (mut i: i64 = 0; i < lam.parameters.length; i++) {
            const p: VarDeclNode* = lam.parameters[i];
            if (p != null) { this.rc_bind(ctx, p.name, p.name); }
        }
        this.rn_stmt(ctx, lam.body);
        this.rc_leave(ctx);
    }

    /// Rename identifier uses in an expression in place (mutating `IdentifierNode.
    /// name`), recursing through every expression form that can hold a local read.
    /// A use bound in no active scope is left unchanged (parameter/global). An
    /// unwalked form leaves a renamed local's use un-renamed, which surfaces as a
    /// loud "not found" at that use — never a silent miscompile.
    rn_expr(mut &this, ctx: RenameCtx*, e: ExpressionNode*) -> void {
        if (e == null) { return; }
        const k: NodeKind = (e as ASTNode*).kind;
        if (k == NodeKind::Identifier) {
            const id: IdentifierNode* = e as IdentifierNode*;
            id.name = this.rc_lookup(ctx, id.name);
            return;
        }
        if (k == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = e as BinaryExprNode*;
            this.rn_expr(ctx, b.left);
            this.rn_expr(ctx, b.right);
            this.rn_expr(ctx, b.desugared_call);
            return;
        }
        if (k == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = e as UnaryExprNode*;
            this.rn_expr(ctx, u.operand);
            this.rn_expr(ctx, u.desugared_call);
            return;
        }
        if (k == NodeKind::TernaryExpression) {
            const t: TernaryExprNode* = e as TernaryExprNode*;
            this.rn_expr(ctx, t.condition);
            this.rn_expr(ctx, t.true_expr);
            this.rn_expr(ctx, t.false_expr);
            return;
        }
        if (k == NodeKind::IfExpression) {
            const ie: IfExprNode* = e as IfExprNode*;
            this.rn_expr(ctx, ie.condition);
            this.rn_expr(ctx, ie.then_expr);
            this.rn_expr(ctx, ie.else_expr);
            return;
        }
        if (k == NodeKind::CallExpression) {
            const c: CallExprNode* = e as CallExprNode*;
            this.rn_expr(ctx, c.callee);
            for (mut i: i64 = 0; i < c.arguments.length; i++) { this.rn_expr(ctx, c.arguments[i]); }
            return;
        }
        if (k == NodeKind::NewExpression) {
            const ne: NewExprNode* = e as NewExprNode*;
            for (mut i: i64 = 0; i < ne.arguments.length; i++) { this.rn_expr(ctx, ne.arguments[i]); }
            if (ne.has_array_size()) { this.rn_expr(ctx, ne.array_size); }
            if (ne.has_struct_init()) { this.rn_expr(ctx, ne.struct_init as ExpressionNode*); }
            return;
        }
        if (k == NodeKind::CastExpression) {
            this.rn_expr(ctx, (e as CastExprNode*).expression); return;
        }
        if (k == NodeKind::StructLiteral) {
            const sl: StructLiteralNode* = e as StructLiteralNode*;
            for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                this.rn_expr(ctx, sl.field_inits[i].value);
            }
            return;
        }
        if (k == NodeKind::ArrayLiteral) {
            const al: ArrayLiteralNode* = e as ArrayLiteralNode*;
            for (mut i: i64 = 0; i < al.elements.length; i++) { this.rn_expr(ctx, al.elements[i]); }
            if (al.repeat_count_expr != null) { this.rn_expr(ctx, al.repeat_count_expr); }
            return;
        }
        if (k == NodeKind::TupleLiteral) {
            const tl: TupleLiteralNode* = e as TupleLiteralNode*;
            for (mut i: i64 = 0; i < tl.elements.length; i++) { this.rn_expr(ctx, tl.elements[i]); }
            return;
        }
        if (k == NodeKind::ArrayAccess) {
            const a: ArrayAccessNode* = e as ArrayAccessNode*;
            this.rn_expr(ctx, a.array);
            this.rn_expr(ctx, a.index);
            this.rn_expr(ctx, a.desugared_call);
            return;
        }
        if (k == NodeKind::MemberAccess) {
            this.rn_expr(ctx, (e as MemberAccessNode*).object); return;
        }
        if (k == NodeKind::TypeofExpression) {
            this.rn_expr(ctx, (e as TypeofExprNode*).operand); return;
        }
        if (k == NodeKind::DeleteExpression) {
            this.rn_expr(ctx, (e as DeleteExprNode*).operand); return;
        }
        if (k == NodeKind::AwaitExpression) {
            this.rn_expr(ctx, (e as AwaitExprNode*).operand); return;
        }
        if (k == NodeKind::TryExpression) {
            const tr: TryExprNode* = e as TryExprNode*;
            this.rn_expr(ctx, tr.operand);
            this.rn_expr(ctx, tr.desugared);
            return;
        }
        if (k == NodeKind::MatchExpression) {
            const me: MatchExprNode* = e as MatchExprNode*;
            this.rn_expr(ctx, me.subject);
            for (mut i: i64 = 0; i < me.arms.length; i++) { this.rn_arm(ctx, me.arms[i]); }
            return;
        }
        if (k == NodeKind::LambdaExpression) {
            this.rn_lambda(ctx, e as LambdaExprNode*); return;
        }
        // Literal / ScopeResolution / Sizeof / Alignof / StaticMatch / Yield /
        // Async carry no local identifier read to rename.
    }

    /// Rename identifier uses and local declarations in a statement in place,
    /// tracking lexical scopes so a binding is visible only after its declaration
    /// and only within its scope. Covers the control-flow containers an async fn
    /// body uses; an unwalked container leaves a renamed local's use un-renamed
    /// (a loud "not found"), never a silent miscompile.
    rn_stmt(mut &this, ctx: RenameCtx*, s: StatementNode*) -> void {
        if (s == null) { return; }
        const k: NodeKind = s.kind;
        if (k == NodeKind::ExpressionStatement) {
            this.rn_expr(ctx, (s as ExprStmtNode*).expression); return;
        }
        if (k == NodeKind::ReturnStatement) {
            this.rn_expr(ctx, (s as ReturnStmtNode*).expression); return;
        }
        if (k == NodeKind::DeclarationStatement) {
            const ds: DeclStmtNode* = s as DeclStmtNode*;
            if (ds.declaration != null && ds.declaration.kind == NodeKind::VariableDeclaration) {
                this.rn_var_decl(ctx, ds.declaration as VarDeclNode*);
            }
            return;
        }
        if (k == NodeKind::BlockStatement) { this.rn_block(ctx, s as BlockStmtNode*); return; }
        if (k == NodeKind::UnsafeBlockStatement) {
            this.rn_block(ctx, (s as UnsafeBlockStmtNode*).block); return;
        }
        if (k == NodeKind::IfStatement) {
            const iff: IfStmtNode* = s as IfStmtNode*;
            this.rn_expr(ctx, iff.condition);
            this.rn_scoped(ctx, iff.then_stmt);
            this.rn_scoped(ctx, iff.else_stmt);
            return;
        }
        if (k == NodeKind::WhileStatement) {
            const w: WhileStmtNode* = s as WhileStmtNode*;
            this.rn_expr(ctx, w.condition);
            this.rn_scoped(ctx, w.body);
            return;
        }
        if (k == NodeKind::DoWhileStatement) {
            const d: DoWhileStmtNode* = s as DoWhileStmtNode*;
            this.rn_scoped(ctx, d.body);
            this.rn_expr(ctx, d.condition);
            return;
        }
        if (k == NodeKind::ForStatement) {
            const f: ForStmtNode* = s as ForStmtNode*;
            this.rc_enter(ctx);   // the for-init scope encloses cond / update / body
            if (f.init != null) {
                if ((f.init as ASTNode*).kind == NodeKind::VariableDeclaration) {
                    this.rn_var_decl(ctx, f.init as VarDeclNode*);
                } else {
                    this.rn_expr(ctx, f.init as ExpressionNode*);
                }
            }
            this.rn_expr(ctx, f.condition);
            this.rn_expr(ctx, f.update);
            this.rn_scoped(ctx, f.body);
            this.rc_leave(ctx);
            return;
        }
        if (k == NodeKind::LoopStatement) {
            this.rn_scoped(ctx, (s as LoopStmtNode*).body); return;
        }
        if (k == NodeKind::MatchStatement) {
            const m: MatchStmtNode* = s as MatchStmtNode*;
            this.rn_expr(ctx, m.subject);
            for (mut i: i64 = 0; i < m.arms.length; i++) { this.rn_arm(ctx, m.arms[i]); }
            return;
        }
        if (k == NodeKind::SwitchStatement) {
            const sw: SwitchStmtNode* = s as SwitchStmtNode*;
            this.rn_expr(ctx, sw.expression);
            for (mut i: i64 = 0; i < sw.cases.length; i++) {
                const cs: CaseStmtNode* = sw.cases[i];
                if (cs != null) {
                    this.rn_expr(ctx, cs.value);
                    this.rn_block(ctx, cs.body);
                }
            }
            return;
        }
        // Break / Continue / Asm carry no local read or declaration.
    }

    /// Alpha-rename every local declaration in the async body to a globally-unique
    /// name before the body is flattened. Parameters are intentionally left
    /// unbound: their uses fall through unchanged and resolve to the shadow
    /// prelude (`const <param> = this.<param>`), so a local that shadows a
    /// parameter no longer collides with it once the body is flattened and the
    /// by-name cross-state promotion runs.
    disambiguate_locals(mut &this, node: FunctionDeclNode*) -> void {
        this.frame_locals = [];
        this.frame_local_src = [];
        if (node.body == null || node.body.kind != NodeKind::BlockStatement) { return; }
        mut ctx: RenameCtx = RenameCtx { orig: [], repl: [], marks: [] };
        this.rn_block(&ctx, node.body as BlockStmtNode*);
    }

    /// Build the state-machine `poll` body for a body with >= 1 `await`: the
    /// arg-shadow prelude, then `loop { match (this.state) { i => <block i>,
    /// _ => Poll::Pending } }`. Returns null (after a diagnostic) for an
    /// unsupported await shape, a body that can fall off its end, or a
    /// `mut`/aggregate/reference held across a suspend. Populates `sm.fut_*` /
    /// `sm.prom_*`, which `lower` consumes to build the struct fields.
    build_poll_body_sm(mut &this, d: AsyncDecl*, node: FunctionDeclNode*, sm: PollSm*) -> BlockStmtNode* {
        const span: SourceSpan = sm.span;
        // Reduce every `await` to one of the three carrier shapes the state
        // machine explodes, so the passes below never meet one nested in an
        // expression. First, because the temporaries it introduces have to go
        // through the rename and frame registration that follow.
        this.hoist_awaits(node);
        // Make every local's name globally unique BEFORE flattening, so the
        // by-name cross-state promotion below cannot conflate a promoted local
        // with a same-named parameter or a sibling-scope local.
        this.disambiguate_locals(node);
        // Records what the frame owns, which the address-of checks below test
        // places against. Must follow the rename: it registers the names the
        // body now uses.
        this.collect_frame_names(d, sm, node);

        mut body: BlockStmtNode* = new BlockStmtNode(span);
        this.emit_shadow_prelude(d, node, body, sm.struct_ref, true, span);

        const orig: BlockStmtNode* = node.body as BlockStmtNode*;
        const entry: i64 = this.sm_alloc(sm);   // state 0
        const tail: i64 = this.lower_block_sm(sm, orig, entry);
        if (!sm.ok) { return null; }

        // Every terminal state must return, or the dispatch loop would spin on it
        // and re-poll an already-taken sub-future. A void body legitimately ends
        // without a `return`, and its terminal state gets the unit completion
        // appended below. A value-returning body reaching here means the return
        // analysis disagrees with the pre-lowering check, which is a shape this
        // lowering cannot express — report it rather than miscompile.
        const falls_off: boolean = !this.stmt_diverges(orig as StatementNode*);
        if (falls_off && !sm.unit_output) {
            this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                "async: an `async function` with `await`s must return on every path; this body can fall off its end without producing its return value",
                span);
            return null;
        }

        this.promote_cross_state(sm);
        if (!sm.ok) { return null; }
        this.carry_params(d, sm, node);
        if (!sm.ok) { return null; }

        // Appended AFTER the two carry passes: both append their hand-back stores
        // to the end of a state, and a `return` placed before those would strand
        // them behind it.
        if (falls_off) {
            sm.blocks[tail].add_statement(this.unit_ready_return(sm.poll_out, span));
        }

        // Assemble `loop { match (this.state) { i => <block i>, _ => Pending } }`.
        mut dispatch: MatchStmtNode* = new MatchStmtNode(
            this.member(this.this_ident(sm.struct_ref, span), sm.state_sym, sm.u32_ty, span), span);
        for (mut i: i64 = 0; i < sm.blocks.length; i++) {
            dispatch.add_arm(this.match_arm_int(i as u64, sm.blocks[i], span));
        }
        mut wblk: BlockStmtNode* = new BlockStmtNode(span);
        wblk.add_statement(new ReturnStmtNode(this.poll_pending(sm.poll_out, span), span) as StatementNode*);
        dispatch.add_arm(this.match_arm_wild(wblk, span));

        mut loop_body: BlockStmtNode* = new BlockStmtNode(span);
        loop_body.add_statement(dispatch as StatementNode*);
        body.add_statement(new LoopStmtNode(loop_body as StatementNode*, span) as StatementNode*);
        return body;
    }

    /// Rewrite `async function main` into a synchronous entry point that drives
    /// the async one to completion on an `Executor` scoped to `main`.
    ///
    /// An `async function` lowers to a constructor returning its future, which
    /// for `main` would leave the program's entry point returning a struct. The
    /// async `main` is therefore renamed out of the entry-point slot and a
    /// synchronous `main` is synthesized in its place:
    ///
    ///     function main() -> i32 {
    ///         mut ex: Executor = Executor::new();
    ///         const main$out: i32 = ex.block_on(main$async());
    ///         return main$out;
    ///     }
    ///
    /// A `-> void` async `main` drops the binding and returns `0`, so the
    /// synthesized entry point returns `i32` either way.
    ///
    /// An `Executor` rather than `future::block_on`, because the current-reactor
    /// handle is published by a worker thread as it comes up: under
    /// `future::block_on` there is none, and every I/O or timer future would park
    /// with nowhere to register. The executor is a LOCAL of `main`, so its `Drop`
    /// tears the runtime down at exit — a runtime scoped to the entry point
    /// rather than an ambient global one — and it drops only after the root's
    /// value has been bound, which is what keeps that value readable.
    ///
    /// Parameters are forwarded rather than rejected: codegen widens a
    /// ZERO-parameter `main` to `(argc, argv, envp)` and publishes them to
    /// `std::env`, and a `main` that declares parameters opts out of that. Both
    /// behaviours are keyed off the synthesized entry point's own parameter list,
    /// so an `async main` behaves exactly as the synchronous one it replaces.
    ///
    /// MUST run before `declare`, which registers the future under whatever name
    /// the node carries; renaming afterwards would leave that registration keyed
    /// to `main`. False (nothing rewritten) when `node` is not an `async main`.
    desugar_async_main(mut &this, node: FunctionDeclNode*) -> boolean {
        if (node == null || node.body == null || !node.is_async) { return false; }
        const main_sym: SymbolStr = this.intern.intern("main");
        if (!node.name.equals(main_sym)) { return false; }

        // Without `std::future` the module has no future types at all, and
        // `declare` reports that with the message naming the missing import; bow
        // out silently rather than reporting one cause twice.
        if (!this.lookup_future_type("Poll").is_valid()) { return false; }
        const exec_ty: TypeRef = this.lookup_future_type("Executor");
        if (!exec_ty.is_valid()) {
            this.ctx.emit_error_at(ErrorCode::E0233_UNDEFINED_SYMBOL,
                "`async function main` is driven by an `Executor`; add `import std::future;`",
                node.span);
            return false;
        }

        if (node.generic_params.length > 0i64) {
            this.ctx.emit_error_at(ErrorCode::E0365_INVALID_ASYNC_MAIN,
                "`async function main` cannot be generic: the entry point is called with no type arguments",
                node.span);
            return false;
        }

        // The entry point hands its value to the process exit status, so the
        // async root has to produce one that fits: an `i32`, or nothing at all.
        const declared: TypeRef = node.resolved_return_type;
        const i32_ty: TypeRef = this.arena.get_i32();
        const returns_void: boolean = this.is_void_type(declared);
        if (!returns_void && !declared.equals(i32_ty)) {
            this.ctx.emit_error_at(ErrorCode::E0365_INVALID_ASYNC_MAIN,
                format("`async function main` must return `i32` or `void`; found `%s`",
                       this.arena.resolve_display_name(declared.id)),
                node.span);
            return false;
        }

        const span: SourceSpan = node.span;
        const inner_sym: SymbolStr = this.intern.intern("main$async");
        const ex_sym: SymbolStr = this.intern.intern("ex");
        node.set_name(inner_sym);

        mut wrapper: FunctionDeclNode* = new FunctionDeclNode(main_sym, span);
        wrapper.set_resolved_return_type(i32_ty);
        wrapper.set_return_type_annotation(this.make_type_ann(i32_ty, span));

        // The forwarded arguments are read off the WRAPPER's own parameters, so
        // each is an ordinary identifier the synthesized body binds.
        mut cloner: ASTCloner = ASTCloner();
        mut fwd: ExpressionNode*[] = [];
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            const p: VarDeclNode* = node.parameters[i];
            if (p == null) { continue; }
            const cloned: ASTNode* = cloner.clone_node(p as ASTNode*);
            if (cloned == null || cloned.kind != NodeKind::VariableDeclaration) { continue; }
            mut cp: VarDeclNode* = cloned as VarDeclNode*;
            // A clone keeps the annotation but drops the resolved type, and type
            // resolution has already run — codegen would meet a parameter it
            // cannot lower and skip the entry point's body entirely.
            cp.set_resolved_type(p.resolved_type);
            wrapper.add_parameter(cp);
            fwd.push(new IdentifierNode(p.name, span) as ExpressionNode*);
        }

        mut body: BlockStmtNode* = new BlockStmtNode(span);

        // `mut ex: Executor = Executor::new();`
        mut ex_new: CallExprNode* = new CallExprNode(
            new ScopeResolutionNode(this.intern.intern("Executor"),
                                    this.intern.intern("new"), span) as ExpressionNode*, span);
        mut ex_decl: VarDeclNode* = new VarDeclNode(ex_sym, span);
        ex_decl.set_mutable(true);
        ex_decl.set_type_annotation(this.make_type_ann(exec_ty, span));
        ex_decl.set_initializer(ex_new as ExpressionNode*);
        body.add_statement(new DeclStmtNode(ex_decl as DeclarationNode*, span) as StatementNode*);

        // `ex.block_on(main$async(<forwarded>))`
        mut root: CallExprNode* = new CallExprNode(
            new IdentifierNode(inner_sym, span) as ExpressionNode*, span);
        for (mut i: i64 = 0; i < fwd.length; i++) { root.add_argument(fwd[i]); }
        mut drive: CallExprNode* = new CallExprNode(
            new MemberAccessNode(new IdentifierNode(ex_sym, span) as ExpressionNode*,
                                 this.intern.intern("block_on"), span, span) as ExpressionNode*, span);
        drive.add_argument(root as ExpressionNode*);

        if (returns_void) {
            body.add_statement(new ExprStmtNode(drive as ExpressionNode*, span) as StatementNode*);
            body.add_statement(new ReturnStmtNode(
                new LiteralNode("0", LiteralKind::Integer, span) as ExpressionNode*,
                span) as StatementNode*);
        } else {
            // Bound to a local rather than returned directly: the binding's
            // annotation is the expected type that fixes `block_on`'s `O`, which
            // is otherwise reachable only through its where-bound.
            const out_sym: SymbolStr = this.intern.intern("main$out");
            mut out_decl: VarDeclNode* = new VarDeclNode(out_sym, span);
            out_decl.set_mutable(false);
            out_decl.set_type_annotation(this.make_type_ann(i32_ty, span));
            out_decl.set_initializer(drive as ExpressionNode*);
            body.add_statement(new DeclStmtNode(out_decl as DeclarationNode*, span) as StatementNode*);
            body.add_statement(new ReturnStmtNode(
                new IdentifierNode(out_sym, span) as ExpressionNode*, span) as StatementNode*);
        }
        wrapper.set_body(body);
        // Name resolution has already run, so the resolution map holds no entry
        // for the locals this body declares and the unused-local lint has no
        // evidence to judge them by — it would report the executor and the
        // root's value as unused even though both are read here.
        wrapper.set_synthesized_body(true);

        if (this.ctx.artifacts.ast.root != null) {
            this.ctx.artifacts.ast.root.add_statement(wrapper as ASTNode*);
        }
        // The index still holds the pre-rewrite `main` — the async function's
        // DECLARED signature, which no definition answers to any more. Dropping
        // it leaves the synthesized entry point the only `main` a caller or
        // codegen can resolve.
        this.ctx.decl_index.reset_function_overloads(main_sym);
        this.ctx.decl_index.reset_function_overloads(this.ctx.qualify_symbol_sym(main_sym));
        TypeResolutionPasses::register_decl_in_index(wrapper as ASTNode*, this.ctx, false,
                                                     this.intern.intern(this.ctx.source_file));
        return true;
    }

    /// Give an `async function` its future type, ahead of any body being typed.
    ///
    /// Everything a CALLER needs is established here — the state-machine struct,
    /// its `poll` signature, the `Future` impl, and the function's registered
    /// return type — so `await f()` resolves whether `f` is declared above the
    /// caller, below it, or is the caller itself. What needs a typed body (the
    /// struct's fields, `poll`'s body, the constructor) waits for `lower`.
    ///
    /// The node's own `resolved_return_type` deliberately keeps the DECLARED
    /// type: `enter_function` types the body's `return`s against it and
    /// `check_function_returns` validates them, both before `lower` runs. Only
    /// the index entry is repointed at the struct.
    ///
    /// False (with a diagnostic) if the future types are not in scope. The record
    /// is kept either way, so `lower` neither retries nor re-reports.
    declare(mut &this, node: FunctionDeclNode*) -> boolean {
        return this.declare_in(node, AsyncOwner::free());
    }

    /// `declare` for an `async` METHOD. `owner` supplies the receiver's type,
    /// the generic parameters the owner contributes to the future, and the
    /// declaration-index keys the method's signature is registered under.
    declare_method(mut &this, owner: AsyncOwner) -> boolean {
        if (owner.method == null || owner.method.func == null) { return false; }
        return this.declare_in(owner.method.func, owner);
    }

    declare_in(mut &this, node: FunctionDeclNode*, owner: AsyncOwner) -> boolean {
        if (node == null || node.body == null) { return false; }
        const existing: i64 = this.pending_index(node);
        if (existing >= 0i64) { return this.pending[existing].ok; }

        const declared_ref: TypeRef = node.resolved_return_type;
        if (!declared_ref.is_valid()) { return false; }
        // A future has to produce a value for `Poll::Ready` to carry, and `void`
        // is the absence of one. `-> void` therefore yields `Output = ()`: unit
        // IS a value, so the terminal `return` has something to hand back and
        // `poll`'s own return type stays well-formed. Awaiting such a function
        // yields `()`, which callers discard exactly as they do a void call.
        const output_ref: TypeRef = if (this.is_void_type(declared_ref)) {
            this.arena.get_unit()
        } else { declared_ref };

        const span: SourceSpan = node.span;
        const module_sym: SymbolStr = this.intern.intern(this.ctx.source_file);

        // Future core types require the module to import them.
        const poll_base: TypeRef = this.lookup_future_type("Poll");
        const ctx_ref:   TypeRef = this.lookup_future_type("Context");
        if (!poll_base.is_valid() || !ctx_ref.is_valid()) {
            this.ctx.emit_error_at(ErrorCode::E0233_UNDEFINED_SYMBOL,
                "an `async function` requires the future types in scope; add `import std::future;`",
                node.span);
            this.pending.push(AsyncDecl {
                node: node, ok: false,
                q_name: SymbolStr::empty(), module_sym: module_sym,
                struct_ref: TypeRef::invalid(), self_ty: TypeRef::invalid(),
                generic: false, fut_params: [], method: owner.method,
                recv_field: SymbolStr::empty(), recv_ptr: false,
                recv_ty: TypeRef::invalid(), output_ref: output_ref,
                declared_ref: declared_ref, poll_out: TypeRef::invalid(),
                poll_base: poll_base, ctx_ptr_ty: TypeRef::invalid(),
                u32_ty: TypeRef::invalid(), state_sym: SymbolStr::empty(),
                struct_decl: null, impl_node: null, poll_fn: null, poll_method: null,
            });
            return false;
        }

        // A method's future is named for the owner as well, so two types with a
        // same-named `async` method read apart in a diagnostic. (The counter in
        // `mint_bare` already makes them distinct.)
        const base_name: string = if (owner.method != null && owner.qname.is_valid()) {
            format("%s$%s", this.intern.resolve(
                       OwnershipQuery::leaf_segment(this.intern, owner.qname)),
                   this.intern.resolve(node.name))
        } else { this.intern.resolve(node.name) };
        const bare: SymbolStr = this.mint_bare(base_name);
        const q_name: SymbolStr = this.ctx.qualify_symbol_sym(bare);

        const state_sym: SymbolStr = this.intern.intern("state");
        const u32_ty: TypeRef = this.arena.get_u32();

        // The future is generic in the OWNER's parameters as well as the
        // function's own: an `async` method on `Box<T>` may mention `T`
        // anywhere its free-function counterpart could mention its own.
        mut fut_params: GenericParamNode*[] = [];
        for (mut oi: i64 = 0; oi < owner.params.length; oi++) {
            if (owner.params[oi] != null) { fut_params.push(owner.params[oi]); }
        }
        for (mut gi: i64 = 0; gi < node.generic_params.length; gi++) {
            if (node.generic_params[gi] != null) { fut_params.push(node.generic_params[gi]); }
        }

        // A generic `async function` yields a future generic in the SAME
        // parameters, so every type built from here on may mention one. Those
        // instantiations (`Fut<T>`, `Poll<T>`, `Option<T>`) are abstract: nothing
        // in the program demands them, and recording demand for one would leave
        // GenericValidation with an instantiation no specialization ever resolves.
        // The arena tags what it builds in this mode symbolic, which is what makes
        // it skippable. Restored before every return below.
        const generic: boolean = fut_params.length > 0i64;
        const saved_no_demand: boolean = this.arena.symbolic_no_demand_active;
        if (generic) { this.arena.set_symbolic_no_demand(true); }

        // The receiver, which the future has to hold for the body to reach it
        // after a suspend. `&this` / `mut &this` are one parameter literally
        // named `"&this"`, already resolved to `T*`; a by-value `this` is named
        // `"this"` and type resolution leaves its type unset, so the owner
        // supplies it. A non-static method with NEITHER has an implicit `&this`
        // (see `method_receiver_kind`) and so no parameter node for the field
        // walks to find — one is synthesized, which is what the implicit form
        // already means to every consumer downstream.
        mut recv_field: SymbolStr = SymbolStr::empty();
        mut recv_ptr: boolean = false;
        if (owner.method != null && !owner.method.is_static && owner.ty.is_valid()) {
            mut recv: VarDeclNode* = null;
            for (mut i: i64 = 0; i < node.parameters.length; i++) {
                if (this.is_receiver_param(node.parameters[i])) { recv = node.parameters[i]; }
            }
            if (recv == null) {
                recv = new VarDeclNode(this.this_amp_sym, span);
                recv.set_mutable(false);
                // The receiver leads the parameter list, which is where the
                // consumers that index rather than search expect it.
                node.add_parameter(recv);
                for (mut i: i64 = node.parameters.length - 1i64; i > 0i64; i--) {
                    node.parameters[i] = node.parameters[i - 1i64];
                }
                node.parameters[0] = recv;
            }
            recv_ptr = recv.name.equals(this.this_amp_sym);
            if (!recv.resolved_type.is_valid()) {
                recv.set_resolved_type(if (recv_ptr) {
                    this.arena.get_pointer_to(owner.ty)
                } else { owner.ty });
            }
            recv_field = this.recv_sym;
        }

        mut poll_args: TypeRef[] = [output_ref];
        const poll_out: TypeRef = this.ctx.generic_registry.instantiate(poll_base, &poll_args);
        const ctx_ptr_ty: TypeRef = this.arena.get_pointer_to(ctx_ref);

        // The struct's TypeRef is needed by the poll-body build (its
        // `this.<field>` accesses) and by every caller's return type; its FIELDS
        // are set in `lower`, once the body build has discovered the sub-future
        // and promoted-local inventory.
        const struct_ref: TypeRef = this.arena.create_struct(q_name, module_sym);

        mut struct_decl: StructDeclNode* = new StructDeclNode(q_name, span);
        struct_decl.repr_c = false;
        struct_decl.repr_packed = false;
        struct_decl.repr_transparent = false;
        struct_decl.min_alignment = 0;

        // Register the generic future as an ordinary struct template, so the
        // demand that specializes `identity<i64>` also specializes its
        // `identity$Future<i64>` — one mechanism, not a parallel one. The
        // function's OWN parameter nodes are reused rather than cloned: generic
        // param types are interned by name, so this keeps the body's `T` and the
        // future's `T` the same arena type.
        mut self_ty: TypeRef = struct_ref;
        if (generic) {
            for (mut gi: i64 = 0; gi < fut_params.length; gi++) {
                struct_decl.add_generic_param(fut_params[gi]);
            }
            const param_refs: TypeRef[] = TypeResolutionPasses::create_generic_param_types(
                fut_params, this.arena);
            mut param_names: SymbolStr[] = [];
            mut param_type_ids: u64[] = [];
            for (mut gi: i64 = 0; gi < fut_params.length; gi++) {
                param_names.push(fut_params[gi].name);
                param_type_ids.push(param_refs[gi].id);
            }
            // The NAMESPACE, not the file path: the monomorphizer's resolution
            // context qualifies type lookups against a template's module name.
            const tmpl_module: SymbolStr = if (this.ctx.has_namespace()) {
                this.ctx.namespace_str
            } else { module_sym };
            this.ctx.generic_registry.register_template(TemplateEntry::new(
                bare, q_name, tmpl_module, param_names, param_type_ids,
                struct_decl as ASTNode*, NodeKind::StructDeclaration, struct_ref));
            self_ty = this.ctx.generic_registry.instantiate(struct_ref, &param_refs);
        }

        // The record is completed in place below: the annotation builders read
        // `generic` / `q_name` / `self_ty` off it, so it has to exist first.
        mut d: AsyncDecl = AsyncDecl {
            node: node, ok: true,
            q_name: q_name, module_sym: module_sym,
            struct_ref: struct_ref, self_ty: self_ty, generic: generic,
            fut_params: fut_params, method: owner.method,
            recv_field: recv_field, recv_ptr: recv_ptr, recv_ty: owner.ty,
            output_ref: output_ref, declared_ref: declared_ref,
            poll_out: poll_out, poll_base: poll_base, ctx_ptr_ty: ctx_ptr_ty,
            u32_ty: u32_ty, state_sym: state_sym,
            struct_decl: struct_decl, impl_node: null,
            poll_fn: null, poll_method: null,
        };

        // `poll`'s signature, whose body `lower` supplies.
        mut poll_fn: FunctionDeclNode* = new FunctionDeclNode(this.intern.intern("poll"), span);
        poll_fn.set_resolved_return_type(poll_out);
        poll_fn.set_origin_trait(this.intern.intern("Future"));
        // The body is built in `lower`, long after name resolution: its shadow
        // bindings are absent from the resolution map, so the unused-local lint
        // would report every one of them against the async function's own span.
        poll_fn.set_synthesized_body(true);
        if (generic) {
            poll_fn.set_return_type_annotation(
                this.poll_type_ann(this.output_type_ann(&d, span), span));
        }
        mut cx_param: VarDeclNode* = new VarDeclNode(this.intern.intern("cx"), span);
        cx_param.set_resolved_type(ctx_ptr_ty);
        if (generic) {
            // Concrete, but the specialized clone drops every `resolved_type`, so
            // the signature only survives if it is also spelled as an annotation.
            cx_param.set_type_annotation(new TypeAnnotation::Pointer(new PointerAnnotation {
                inner: this.make_type_ann(ctx_ref, span), is_const: false, span: span,
            }));
        }
        poll_fn.add_parameter(cx_param);

        mut poll_method: MethodNode* = new MethodNode(poll_fn, span);
        poll_method.set_visibility(Visibility::Public);
        poll_method.set_static(false);
        poll_method.set_sink(false);

        // StructType.methods so overload resolution sees `poll` on the receiver.
        const struct_t: Type* = this.arena.lookup(struct_ref.id);
        if (struct_t != null && struct_t.kind == TypeKind::Struct) {
            const st: StructType* = struct_t as StructType*;
            mut poll_param_types: TypeRef[] = [ctx_ptr_ty];
            const poll_fn_ty: TypeRef = this.arena.get_function(poll_out, poll_param_types, false);
            const minfo: MethodInfo = MethodInfo {
                name:          this.intern.intern("poll"),
                function_type: poll_fn_ty,
                is_public:     true,
                is_protected:  false,
                is_static:     false,
                is_virtual:    false,
                is_override:   false,
                param_types:   poll_param_types,
                ast_node:      poll_method as void*,
            };
            st.add_method(minfo);
        }

        // `implement trait Future<Output> for struct <Q>`
        mut impl_node: ImplBlockNode* = new ImplBlockNode(q_name, span);
        mut gen: GenericAnnotation* = new GenericAnnotation {
            base: this.named_ann(this.intern.intern("Future"), span),
            args: [this.output_type_ann(&d, span)],
            span: span,
        };
        impl_node.set_trait_annotation(new TypeAnnotation::Generic(gen));
        impl_node.add_assoc_binding(this.intern.intern("Output"), this.output_type_ann(&d, span));
        impl_node.add_method(poll_method);
        if (generic) {
            for (mut gi: i64 = 0; gi < d.fut_params.length; gi++) {
                impl_node.add_generic_param(d.fut_params[gi]);
            }
            // `target_args` is what makes `This` inside the impl resolve to the
            // full `Fut<T>` rather than the bare template base.
            impl_node.set_target_args(this.generic_param_anns(d.fut_params, span));
            impl_node.qualified_target_name = q_name;
            // Hang the block off the template so the same demand that specializes
            // `Fut<i64>` specializes its `Future` impl. Without it the
            // specialization exists but has no `poll`.
            this.ctx.generic_registry.register_impl_block(q_name, impl_node);
        }
        d.impl_node = impl_node;
        this.bind_async_trait_assoc(&owner, node, this.future_type_ann(&d, span));

        // Register struct + trait impl.
        this.ctx.decl_index.register_type_with_module(q_name, struct_ref, module_sym);
        mut method_arr: MethodNode*[] = [poll_method];
        this.ctx.decl_index.register_methods_with_module(
            q_name, method_arr, module_sym, this.intern, this.arena);

        const future_leaf: SymbolStr = this.intern.intern("Future");
        // Dispatch key: `.poll()` resolution keys on the struct's qualified name.
        this.ctx.generic_registry.register_trait_impl(future_leaf, q_name, impl_node);
        // Bound-check key: `F: Future<R>` resolves via qualified-name id + leaf.
        const tgt_leaf: SymbolStr = OwnershipQuery::registry_name_of(this.arena, this.intern, struct_ref);
        const qual_id: u64 = OwnershipQuery::named_qualified_id(this.arena, this.intern, struct_ref);
        this.ctx.generic_registry.register_trait_impl_typed(future_leaf, tgt_leaf, qual_id, impl_node);

        // Repoint callers at the future type.
        node.set_resolved_return_type(self_ty);
        if (owner.method != null) {
            this.repoint_method(&owner, node, module_sym);
            // A method's callers read the NODE, so the future type STAYS on it;
            // `begin_body_check` lends the declared type back for the body walk.
        } else {
            // Drop the stale Output-return overload first (bare + qualified) so
            // the struct-return signature is the sole overload at call sites.
            // The node itself carries the struct type only for the duration of
            // the registration, which reads it off the node; the DECLARED type
            // goes back afterwards, because the body is still typed and
            // `check_function_returns`-checked against it.
            this.ctx.decl_index.reset_function_overloads(node.name);
            this.ctx.decl_index.reset_function_overloads(this.ctx.qualify_symbol_sym(node.name));
            TypeResolutionPasses::register_decl_in_index(node as ASTNode*, this.ctx, false, module_sym);
            node.set_resolved_return_type(declared_ref);
        }

        d.poll_fn     = poll_fn;
        d.poll_method = poll_method;
        this.pending.push(d);
        if (generic) { this.arena.set_symbolic_no_demand(saved_no_demand); }
        return true;
    }

    /// The method's parameter types with the receiver excluded — the shape both
    /// the owner's `MethodInfo` and the declaration index are built from.
    method_param_types(&this, node: FunctionDeclNode*) -> TypeRef[] {
        mut ptypes: TypeRef[] = [];
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            const p: VarDeclNode* = node.parameters[i];
            if (p == null || this.is_receiver_param(p)) { continue; }
            ptypes.push(p.resolved_type);
        }
        return ptypes;
    }

    /// Rebuild the owner's arena `MethodInfo` for `m` around the node's current
    /// return type.
    ///
    /// The entry is found by AST identity, the key `type_resolution` built it
    /// under — a name is not unique across overloads. Mutated in place:
    /// `add_method` appends, so re-adding would leave two entries and make
    /// overload resolution depend on which one it reached first.
    rebuild_method_info(mut &this, owner_ty: TypeRef, m: MethodNode*,
                        node: FunctionDeclNode*) -> void {
        const t: Type* = this.arena.lookup(owner_ty.id);
        if (t == null) { return; }
        const fn_ty: TypeRef = this.arena.get_function(
            node.resolved_return_type, this.method_param_types(node), node.is_variadic);
        // A union is a StructType with `is_union`, so Struct covers it too.
        if (t.kind == TypeKind::Struct) {
            mut st: StructType* = t as StructType*;
            for (mut i: i64 = 0; i < st.methods.length; i++) {
                if (st.methods[i].ast_node != (m as void*)) { continue; }
                st.methods[i].function_type = fn_ty;
                return;
            }
            return;
        }
        if (t.kind == TypeKind::Class) {
            mut ct: ClassType* = t as ClassType*;
            for (mut i: i64 = 0; i < ct.methods.length; i++) {
                if (ct.methods[i].ast_node != (m as void*)) { continue; }
                ct.methods[i].function_type = fn_ty;
                return;
            }
        }
    }

    /// Drop every overload registered under the combined `<owner>::<method>`
    /// key. The free-function counterpart resets the plain name; a method's
    /// overload set hangs off the combined key instead, and without this the
    /// stale Output-return signature stays resolvable next to the new one.
    reset_method_overloads(mut &this, owner_qname: SymbolStr, method_name: SymbolStr) -> void {
        const combined: string = format("%s::%s", this.intern.resolve(owner_qname),
                                        this.intern.resolve(method_name));
        this.ctx.decl_index.reset_function_overloads(this.intern.intern(combined));
    }

    /// Point callers of an `async` METHOD at its future type.
    ///
    /// A free function's whole overload set is dropped and rebuilt from the
    /// node; a method has no such set. Its signature lives in the owner's arena
    /// entry (what overload resolution reads) and in the declaration index under
    /// the combined `Owner::method` key (what cross-module callers and codegen
    /// read). Both derive from the node's `resolved_return_type`, which the
    /// caller has set to the future type around this call.
    repoint_method(mut &this, owner: AsyncOwner*, node: FunctionDeclNode*,
                   module_sym: SymbolStr) -> void {
        this.rebuild_method_info(owner.ty, owner.method, node);

        mut arr: MethodNode*[] = [owner.method];
        this.reset_method_overloads(owner.qname, node.name);
        this.ctx.decl_index.register_methods_with_module(
            owner.qname, arr, module_sym, this.intern, this.arena);
        for (mut i: i64 = 0; i < owner.alias_qnames.length; i++) {
            const alias: SymbolStr = owner.alias_qnames[i];
            if (!alias.is_valid() || alias.equals(owner.qname)) { continue; }
            this.reset_method_overloads(alias, node.name);
            this.ctx.decl_index.register_methods_with_module_aliased(
                owner.qname, alias, arr, module_sym, this.intern, this.arena);
        }
    }

    /// Append one field to the generated future's declaration.
    ///
    /// A generic future additionally needs the field spelled as an ANNOTATION:
    /// specialization clones the decl, and the clone keeps annotations but drops
    /// every `resolved_type`. False (with a diagnostic) when the type mentions a
    /// generic parameter through a shape `type_ann_for` cannot spell — emitting
    /// the field anyway would leave the specialization's field still generic,
    /// which surfaces far from here as an unresolved member type.
    add_future_field(mut &this, struct_decl: StructDeclNode*, name: SymbolStr,
                     ty: TypeRef, generic: boolean, span: SourceSpan) -> boolean {
        mut f: FieldDeclNode* = new FieldDeclNode(name, span);
        f.set_visibility(Visibility::Public);
        f.set_resolved_type(ty);
        if (generic) {
            mut ann: TypeAnnotation* = this.type_ann_for(ty, span);
            if (ann == null) {
                this.ctx.emit_error_at(ErrorCode::E0600_CODEGEN_FAILED,
                    format("async: a generic `async function` cannot carry a value of type `%s` across a suspend; give it a concrete type",
                           this.arena.resolve_display_name(ty.id)),
                    span);
                return false;
            }
            f.set_type_annotation(ann);
        }
        struct_decl.add_field(f);
        return true;
    }

    /// Build the state machine for an `async function` whose body sema has now
    /// typed: fill in the struct's fields, `poll`'s body, and the constructor the
    /// function itself becomes. Requires `declare` to have run (it is called here
    /// if the module pre-pass did not reach this node).
    lower(mut &this, node: FunctionDeclNode*) -> void {
        if (node == null || node.body == null) { return; }
        mut pi: i64 = this.pending_index(node);
        if (pi < 0i64) {
            this.declare(node);
            pi = this.pending_index(node);
            if (pi < 0i64) { return; }
        }
        if (!this.pending[pi].ok) { return; }

        const q_name:      SymbolStr = this.pending[pi].q_name;
        const module_sym:  SymbolStr = this.pending[pi].module_sym;
        const struct_ref:  TypeRef   = this.pending[pi].struct_ref;
        // The type a VALUE of the future has: `Fut<T>` when generic, the bare
        // struct otherwise. Everything the state machine builds a value of — the
        // constructor literal, the function's return type, `this` inside `poll` —
        // uses this; `struct_ref` remains the arena entry holding the field table.
        const self_ty:     TypeRef   = this.pending[pi].self_ty;
        const generic:     boolean   = this.pending[pi].generic;
        const declared_ref: TypeRef  = this.pending[pi].declared_ref;
        const poll_out:    TypeRef   = this.pending[pi].poll_out;
        const poll_base:   TypeRef   = this.pending[pi].poll_base;
        const ctx_ptr_ty:  TypeRef   = this.pending[pi].ctx_ptr_ty;
        const u32_ty:      TypeRef   = this.pending[pi].u32_ty;
        const state_sym:   SymbolStr = this.pending[pi].state_sym;
        mut struct_decl: StructDeclNode*   = this.pending[pi].struct_decl;
        mut impl:        ImplBlockNode*    = this.pending[pi].impl_node;
        mut poll_fn:     FunctionDeclNode* = this.pending[pi].poll_fn;
        const method:      MethodNode* = this.pending[pi].method;
        const recv_field:  SymbolStr   = this.pending[pi].recv_field;
        const span: SourceSpan = node.span;

        // ---- 0. Receiver ----
        // A method's body reads its receiver as a bare `this`, which inside the
        // generated `poll` would resolve to the FUTURE. Rewrite it to the frame
        // binding the shadow prelude declares for the receiver field, restoring
        // the by-value type the body was typed against when the receiver is held
        // by pointer.
        //
        // This runs BEFORE the poll body is built, and so before every other
        // rewrite: the shadow prelude, the cross-state promotion and the carry
        // passes all synthesize `this.<field>` accesses of their own, and a
        // receiver pass run after them would rewrite the `this` in those too.
        if (recv_field.is_valid() && node.body.kind == NodeKind::BlockStatement) {
            this.subst_mode = if (this.pending[pi].recv_ptr) {
                this.subst_to_local_deref()
            } else { this.subst_to_local() };
            this.subst_name_stmt(node.body as StatementNode*, this.this_sym, recv_field,
                                 self_ty, this.pending[pi].recv_ty, span);
            this.subst_mode = this.subst_to_field();
        }

        // ---- 0b. poll body ----
        // No await => run to completion in one poll (Inc 1b). Otherwise the
        // recursive builder emits `loop { match (this.state) {…} }`, recording one
        // `fut_k: Option<F_k>` sub-future per await and one field per promoted
        // cross-state scalar local into `sm`.
        const total_await: i64 = if (node.body.kind == NodeKind::BlockStatement) {
            this.block_await_count(node.body as BlockStmtNode*)
        } else { 0i64 };

        // A generic future's own body instantiates types that mention its
        // parameters (`Option<T>`, the `Poll<F::Output>` of a sub-future). None
        // of them is a real demand — the specialization of `Fut<T>` is what
        // creates the concrete ones — so build them symbolically, exactly as
        // `declare` did. Restored at every exit below.
        const saved_no_demand: boolean = this.arena.symbolic_no_demand_active;
        if (generic) { this.arena.set_symbolic_no_demand(true); }

        mut sm: PollSm = PollSm {
            struct_ref: self_ty, poll_out: poll_out, poll_base: poll_base,
            ctx_ptr_ty: ctx_ptr_ty,
            state_sym: state_sym, u32_ty: u32_ty, cx_sym: this.intern.intern("cx"),
            opt_base: TypeRef::invalid(), span: span,
            blocks: [], ok: true,
            fut_syms: [], fut_opt: [], naw: 0i64,
            prom_field: [], prom_tys: [], prom_opt: [], nprom: 0i64,
            loop_cont: [], loop_brk: [],
            frame_names: [],
            unit_output: this.is_void_type(declared_ref),
        };

        mut body_block: BlockStmtNode* = null;
        if (total_await > 0i64) {
            sm.opt_base = this.lookup_future_type("Option");
            if (!sm.opt_base.is_valid()) {
                this.ctx.emit_error_at(ErrorCode::E0233_UNDEFINED_SYMBOL,
                    "async: `Option` must be in scope to lower `await`", span);
                if (generic) { this.arena.set_symbolic_no_demand(saved_no_demand); }
                return;
            }
            body_block = this.build_poll_body_sm(&this.pending[pi], node, &sm);
        } else {
            body_block = this.build_poll_body_no_await(
                &this.pending[pi], node, self_ty, poll_out, span);
        }
        if (body_block == null) {   // a diagnostic was already emitted
            if (generic) { this.arena.set_symbolic_no_demand(saved_no_demand); }
            return;
        }

        // ---- 1. Struct decl fields (state + params + sub-futures + promoted) ----
        // A generic future is specialized from its DECL, and the clone a
        // specialization starts from carries annotations only — every
        // `resolved_type` is dropped and re-derived. So each field is spelled as
        // an annotation as well as resolved; `add_future_field` reports a type
        // with no such spelling rather than emitting a field that would stay
        // generic in the specialization.
        mut fields_ok: boolean = this.add_future_field(struct_decl, state_sym, u32_ty, generic, span);

        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            const p: VarDeclNode* = node.parameters[i];
            if (!this.param_has_slot(&this.pending[pi], p)) { continue; }
            if (!this.add_future_field(struct_decl, this.param_field_name(p),
                    this.param_field_type(&sm, this.param_slot_type(&this.pending[pi], p)),
                    generic, span)) {
                fields_ok = false;
            }
        }
        // One sub-future field per await (`Option::None` until built lazily on
        // first entry to its resume state) so the machine can suspend/resume.
        for (mut i: i64 = 0; i < sm.naw; i++) {
            if (!this.add_future_field(struct_decl, sm.fut_syms[i], sm.fut_opt[i], generic, span)) {
                fields_ok = false;
            }
        }
        // One field per promoted cross-state local (a value read in a state other
        // than the one declaring it cannot live on the native stack).
        for (mut i: i64 = 0; i < sm.nprom; i++) {
            if (!this.add_future_field(struct_decl, sm.prom_field[i], sm.prom_tys[i], generic, span)) {
                fields_ok = false;
            }
        }
        if (!fields_ok) {
            this.arena.set_symbolic_no_demand(saved_no_demand);
            return;
        }

        // ---- 2. Arena StructType + FieldInfo (mirrors the decl fields) ----
        const struct_t: Type* = this.arena.lookup(struct_ref.id);
        if (struct_t != null && struct_t.kind == TypeKind::Struct) {
            const st: StructType* = struct_t as StructType*;
            mut infos: FieldInfo[] = [];
            infos.push(FieldInfo::new(state_sym, u32_ty, true, false, false));
            for (mut i: i64 = 0; i < node.parameters.length; i++) {
                const p: VarDeclNode* = node.parameters[i];
                if (!this.param_has_slot(&this.pending[pi], p)) { continue; }
                infos.push(FieldInfo::new(this.param_field_name(p),
                    this.param_field_type(&sm, this.param_slot_type(&this.pending[pi], p)),
                    true, false, false));
            }
            for (mut i: i64 = 0; i < sm.naw; i++) {
                infos.push(FieldInfo::new(sm.fut_syms[i], sm.fut_opt[i], true, false, false));
            }
            for (mut i: i64 = 0; i < sm.nprom; i++) {
                infos.push(FieldInfo::new(sm.prom_field[i], sm.prom_tys[i], true, false, false));
            }
            st.set_fields(infos);
        }

        // ---- 3. poll body into the signature `declare` registered ----
        poll_fn.set_body(body_block);

        // ---- 4. Inject so mono/codegen walk the struct + impl ----
        if (this.ctx.artifacts.ast.root != null) {
            this.ctx.artifacts.ast.root.add_statement(struct_decl as ASTNode*);
            this.ctx.artifacts.ast.root.add_statement(impl as ASTNode*);
        }

        // ---- 5. Rewrite the async fn into the constructor ----
        // Body: `return <Q> { state: 0, p0: p0, …, fut_k: Option::None, … };`
        mut ctor_lit: StructLiteralNode* = new StructLiteralNode(q_name, span);
        mut zero: LiteralNode* = new LiteralNode("0", LiteralKind::Integer, span);
        zero.set_resolved_type(u32_ty);
        ctor_lit.add_field_init(FieldInit { field_name: state_sym, value: zero as ExpressionNode*, span: span });
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            const p: VarDeclNode* = node.parameters[i];
            if (!this.param_has_slot(&this.pending[pi], p)) { continue; }
            const slot_ty: TypeRef = this.param_slot_type(&this.pending[pi], p);
            // The receiver is not readable by its parameter name (`&this` is
            // not an identifier), and a pointer receiver has to be the ADDRESS
            // of the caller's object rather than a copy of it — this body still
            // runs as the method, so `this` is that object.
            mut pval: ExpressionNode* = if (this.is_receiver_param(p)) {
                if (this.pending[pi].recv_ptr) {
                    this.addr_of(this.ident(this.this_sym, this.pending[pi].recv_ty, span),
                                 slot_ty, span)
                } else {
                    this.ident(this.this_sym, slot_ty, span)
                }
            } else {
                this.ident(p.name, slot_ty, span)
            };
            const pfty: TypeRef = this.param_field_type(&sm, slot_ty);
            if (this.param_is_carried(&sm, slot_ty)) {
                pval = this.option_some(pval, pfty, span);
            }
            ctor_lit.add_field_init(FieldInit {
                field_name: this.param_field_name(p), value: pval, span: span });
        }
        // Each sub-future starts empty (built lazily on first entry to its resume
        // state); each promoted field starts zero (always written before read).
        for (mut i: i64 = 0; i < sm.naw; i++) {
            ctor_lit.add_field_init(FieldInit {
                field_name: sm.fut_syms[i], value: this.option_none(sm.fut_opt[i], span), span: span });
        }
        for (mut i: i64 = 0; i < sm.nprom; i++) {
            // An aggregate's slot starts `None`: there is no zero value to give
            // it, and `None` is what makes a future dropped before the value is
            // ever assigned have nothing to drop.
            mut init: ExpressionNode* = this.zero_value(sm.prom_tys[i], span);
            if (sm.prom_opt[i]) { init = this.option_none(sm.prom_tys[i], span); }
            ctor_lit.add_field_init(FieldInit {
                field_name: sm.prom_field[i], value: init, span: span });
        }
        // The literal's OWN type arguments, so it builds `Fut<T>` rather than the
        // bare template — without them the function's return type and the value
        // it returns stop matching.
        if (generic) {
            ctor_lit.set_generic_args(this.generic_param_anns(this.pending[pi].fut_params, span));
        }
        ctor_lit.set_resolved_type(self_ty);
        mut ret: ReturnStmtNode* = new ReturnStmtNode(ctor_lit as ExpressionNode*, span);
        mut new_body: BlockStmtNode* = new BlockStmtNode(span);
        new_body.add_statement(ret as StatementNode*);

        node.set_body(new_body);
        node.set_resolved_return_type(self_ty);
        node.set_return_type_annotation(this.future_type_ann(&this.pending[pi], span));
        node.set_async(false);

        // Re-register now that the node itself carries the struct return type and
        // its annotation. `declare` already pointed callers here, so this settles
        // the entry against the finished node rather than changing where calls
        // resolve. Dropping the stale overloads first (bare + qualified) keeps the
        // struct-return signature the sole one at call sites.
        //
        // A METHOD needs none of this: `declare` registered its signature with
        // the future return type already, under keys that are stable across the
        // rewrite, and re-running the registration would only append a second
        // entry with the same mangled symbol.
        if (method == null) {
            this.ctx.decl_index.reset_function_overloads(node.name);
            this.ctx.decl_index.reset_function_overloads(this.ctx.qualify_symbol_sym(node.name));
            TypeResolutionPasses::register_decl_in_index(node as ASTNode*, this.ctx, false, module_sym);
        }

        // The record has served its purpose; `is_async` is now false, so nothing
        // will look it up again.
        this.pending[pi].ok = false;
        this.arena.set_symbolic_no_demand(saved_no_demand);
    }
}
