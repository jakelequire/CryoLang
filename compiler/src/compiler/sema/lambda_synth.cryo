/// LambdaSynth
///
/// Lambda typing + closure lowering: resolving a lambda's param/return types and
/// walking its body in a fresh per-function frame, recording captured names off
/// the enclosing scope, synthesising a closure struct (+ `__call__`, + a `Drop`
/// implementation for non-Copy captures) for a capturing lambda, rewriting `f(args)` to
/// `f.__call__(args)` when `f` is a closure local, and the free-call
/// closure-arg specialisation.
///
/// `resolve_lambda` walks the body via the dispatch seam, so it takes
/// `visitor: SemaVisitor*`.  All per-function frame save/restore goes through
/// `state` (alias-and-restore, relying on Cryo not
/// dropping on field reassignment; owning arrays are exchanged via `swap`).
///
/// Env (arena/intern/ctx) + peers: state, symbolic (param binding), scopes (local
/// registration), dispatch (body walk).

namespace compiler::sema::lambda_synth;

import compiler::types::{
    type_ref, type_base, arena, compound, user_defined, ownership, resolver, generic_registry, RefMutability,
    TypeKind
};
import compiler::lex::{ Token, TokenType };
import compiler::resolver::{ symbol_str, intern_table, mangled_name, qualified_name };
import compiler::ast::{
    cloner, declaration, expression, MemberPin, NamedAnnotation, node, statement,
    TypeAnnotation, Visibility
};
import compiler::diag::{ diagnostic, ErrorCode, source_span };
import compiler::compilation_context::{ CompilationContext };
import compiler::sema::{ state, symbolic_checker, scope_manager };
import std::core::{ option, mem };
import std::collections::hashmap::{ HashMap };
import std::collections::pair::{ Pair };
import std::core::iter::{ Iterator };
import std::fmt;
import compiler::ast::cloner::{ ASTCloner };
import compiler::ast::declaration::{
    DeclarationNode, DeclKind, FieldDecl, FunctionDecl, GenericParamDecl, ImplBlock, MethodDecl,
    ReceiverForm, StructDecl, VarDecl
};
import compiler::passes::type_resolution::{ TypeResolutionPasses };
import compiler::sema::type_spelling::{ TypeSpelling };
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::types::generic_registry::{ TemplateEntry, TemplateKind };
import compiler::resolver::lang_item::{ LangItem };
import compiler::ast::expression::{
    CalleePin,
    CallExpr, ExpressionNode, IdentifierExpr, LambdaExpr, MemberAccessExpr
};
import compiler::ast::node::{ Node };
import compiler::ast::statement::{ BlockStmt, Stmt, StmtKind };
import compiler::sema::sema::{ SemaVisitor };
import compiler::diag::diagnostic::{ Diagnostic };
import compiler::diag::source_span::{ SourceSpan };
import compiler::diag::suggestion::{ Applicability, Suggestion };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::mangled_name::{ MangledName };
import compiler::resolver::qualified_name::{ QualifiedName };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::res::{ Res, ResSlot, DefId, DefKey, DefKind, FamilyOwner };
import compiler::decl_index::{ OverloadId };
import compiler::module_graph::{ ModulePath };
import compiler::resolver::resolver::{ Resolver };
import compiler::sema::scope_manager::{ ScopeManager };
import compiler::sema::state::{ LocalBinding, SemaState };
import compiler::resolver::symbol_id::{ SymbolKey };
import std::collections::hashset::{ HashSet };
import compiler::sema::symbolic_checker::{ SymbolicChecker };
import compiler::types::arena::{ TypeArena };
import compiler::types::compound::{ FunctionType };
import compiler::types::generic_registry::{ GenericRegistry };
import compiler::types::ownership::{ OwnershipQuery };
import compiler::types::resolver::{ ResolutionContext };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };
import compiler::types::user_defined::{ FieldInfo, MethodInfo, StructType };
import std::core::mem::{ swap };
import std::core::option::{ Option };

type struct LambdaSynth {
    arena:    mut TypeArena*;
    intern:   mut InternTable*;
    ctx:      mut CompilationContext*;
    state:    mut SemaState*;
    symbolic: SymbolicChecker*;
    scopes:   mut ScopeManager*;
    /// The allocator a synthesized binding's identity comes from.  The shadow
    /// locals this synthesis writes into a closure body are declared after
    /// name resolution ran, so nothing else can say which binding each is.
    resolver: mut Resolver*;

    static null() -> LambdaSynth {
        return LambdaSynth {
            arena: null, intern: null, ctx: null, state: null,
            symbolic: null, scopes: null, resolver: null,
        };
    }

    wire(mut &this, arena: mut TypeArena*, intern: mut InternTable*, ctx: mut CompilationContext*,
                    state: mut SemaState*, symbolic: SymbolicChecker*, scopes: mut ScopeManager*) -> void {
        this.arena    = arena;
        this.intern   = intern;
        this.ctx      = ctx;
        this.resolver = ctx.get_resolver();
        this.state    = state;
        this.symbolic = symbolic;
        this.scopes   = scopes;
    }


    /// Type a lambda: resolve its param/return types, walk its body in a fresh
    /// per-function frame (capturing free variables), and return either the
    /// synthesised closure-struct type (capturing) or a function type (non-capturing).
    resolve_lambda(mut &this, visitor: mut SemaVisitor*, e: ExpressionNode*, node: mut LambdaExpr*) -> TypeRef {
        // One-shot guard: a capturing lambda an earlier walk already lowered
        // carries its closure-struct type - return it, don't re-lower.
        if (node.is_capturing() && e.has_resolved_type()
                && this.is_closure_struct_type(e.resolved_type)) {
            return e.resolved_type;
        }

        mut res_ctx: ResolutionContext = ResolutionContext::new("");
        // A lambda's parameter and return annotations are written where the
        // lambda is, inside a body, and resolve there.
        this.symbolic.symbolic_bind_params(&res_ctx);

        mut param_types: [TypeRef] = [];
        for (mut i: i64 = 0; i < node.parameters.length(); i++) {
            const p_decl: DeclarationNode* = node.parameters[i];
            const p: mut VarDecl* = DeclarationNode::var_of(p_decl);
            if (p == null) { continue; }
            mut pty: TypeRef = p.resolved_type;
            if (!pty.is_valid() && p.type_annotation != null) {
                pty = this.ctx.type_resolver.resolve(p.type_annotation, &res_ctx);
                if (pty.is_valid()) { p.resolved_type = pty; }
            }
            if (!pty.is_valid()) { pty = this.arena.get_void(); }
            param_types.push(pty);
        }

        mut ret_ty: TypeRef = node.return_type;
        if (!ret_ty.is_valid()) {
            if (node.return_type_ann != null) {
                ret_ty = this.ctx.type_resolver.resolve(node.return_type_ann, &res_ctx);
            }
            if (!ret_ty.is_valid()) { ret_ty = this.arena.get_void(); }
            node.set_return_type(ret_ty);
        }

        // Save the enclosing frame, install a fresh one for the lambda body:
        // the owning tables start empty and are exchanged via `swap`.
        const saved_ret:       TypeRef         = this.state.return_type;
        const saved_ret_ann:   TypeAnnotation* = this.state.return_type_ann;
        const saved_this:      TypeRef         = this.state.this_type;
        const saved_this_mut:  boolean         = this.state.this_is_mut;
        const saved_this_byref: boolean        = this.state.this_is_by_ref;
        const saved_expected:  TypeRef         = this.state.expected_type;
        const saved_loop:      i32             = this.state.loop_depth;
        const saved_lambda_depth: i32                   = this.state.in_lambda_depth;
        const saved_current_lam:  mut LambdaExpr*           = this.state.current_lambda;
        mut saved_bindings: HashMap<SymbolKey, LocalBinding> = HashMap::<SymbolKey, LocalBinding>::new();
        mut saved_binding_undo: [SymbolKey] = [];
        mut saved_binding_prev: [LocalBinding] = [];
        mut saved_payload: HashSet<SymbolKey> = HashSet::<SymbolKey>::new();
        mut saved_alias:   HashSet<SymbolKey> = HashSet::<SymbolKey>::new();
        mut saved_outer:   HashMap<SymbolKey, TypeRef> = HashMap::<SymbolKey, TypeRef>::new();
        mut saved_params:  HashSet<SymbolKey> = HashSet::<SymbolKey>::new();
        swap(&this.state.bindings, &saved_bindings);
        swap(&this.state.binding_undo, &saved_binding_undo);
        swap(&this.state.binding_prev, &saved_binding_prev);
        swap(&this.state.payload_bindings, &saved_payload);
        swap(&this.state.alias_bindings, &saved_alias);
        swap(&this.state.outer_bindings, &saved_outer);

        // Compose the body's view of out-of-scope bindings: further-out
        // captures plus the enclosing frame's bindings.
        mut outer_it: implement Iterator<Pair<SymbolKey, TypeRef>> = saved_outer.iter();
        loop {
            match (outer_it.next()) {
                Option::Some(pair) => { this.state.outer_bindings.insert(pair.first, pair.second); }
                Option::None => { break; }
            }
        }
        mut local_it: implement Iterator<Pair<SymbolKey, LocalBinding>> = saved_bindings.iter();
        loop {
            match (local_it.next()) {
                Option::Some(pair) => { this.state.outer_bindings.insert(pair.first, pair.second.ty); }
                Option::None => { break; }
            }
        }

        this.state.return_type     = ret_ty;
        this.state.return_type_ann = node.return_type_ann;
        // A lambda returns for itself, not for an enclosing `poll`: a `?` in its
        // body propagates out of the lambda, so it must not inherit the
        // `Poll::Ready` wrapping that applies to the poll body around it.
        const saved_poll_out: TypeRef = this.state.async_poll_output;
        this.state.async_poll_output = TypeRef::invalid();
        this.state.this_type       = TypeRef::invalid();
        this.state.this_is_mut     = false;
        this.state.this_is_by_ref  = false;
        // The lambda's body has no caller-backed parameters of the enclosing
        // function; those come back when it is done.
        swap(&this.state.param_bindings, &saved_params);
        this.state.expected_type   = TypeRef::invalid();
        this.state.loop_depth      = 0;
        this.state.in_lambda_depth     = saved_lambda_depth + 1;
        this.state.current_lambda      = node;

        for (mut pi: i64 = 0; pi < node.parameters.length(); pi++) {
            const p_decl: DeclarationNode* = node.parameters[pi];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p == null) { continue; }
            this.scopes.declare(p.sym_id, p.resolved_type, p.is_mutable);
        }

        if (node.body != null) {
            visitor.dispatch_stmt(node.body);
        }

        // Restore the enclosing frame.
        swap(&this.state.bindings, &saved_bindings);
        swap(&this.state.binding_undo, &saved_binding_undo);
        swap(&this.state.binding_prev, &saved_binding_prev);
        swap(&this.state.payload_bindings, &saved_payload);
        swap(&this.state.alias_bindings, &saved_alias);
        swap(&this.state.outer_bindings, &saved_outer);
        swap(&this.state.param_bindings, &saved_params);
        this.state.return_type     = saved_ret;
        this.state.return_type_ann = saved_ret_ann;
        this.state.async_poll_output = saved_poll_out;
        this.state.this_type       = saved_this;
        this.state.this_is_mut     = saved_this_mut;
        this.state.this_is_by_ref  = saved_this_byref;
        this.state.expected_type   = saved_expected;
        this.state.loop_depth      = saved_loop;
        this.state.in_lambda_depth     = saved_lambda_depth;
        this.state.current_lambda      = saved_current_lam;

        // Nested-capture propagation: an inner lambda's captures not in the outer
        // lambda's own locals must be captured by the outer lambda too, each
        // as the outer lambda captures (`capture_by_reference`).
        if (node.is_capturing() && saved_current_lam != null && saved_lambda_depth > 0) {
            for (mut ci: i64 = 0; ci < node.captured_names.length(); ci++) {
                const cap_name: SymbolStr = node.captured_names[ci];
                if (!this.scopes.type_of(node.captured_syms[ci]).is_valid()) {
                    const cap_ty: TypeRef = node.captured_types[ci];
                    saved_current_lam.add_capture(cap_name, node.captured_syms[ci],
                                                  cap_ty, node.captured_spans[ci],
                                                  this.capture_by_reference(saved_current_lam, cap_ty));
                }
            }
        }

        if (node.is_capturing()) {
            return this.synthesize_closure_struct(node, e.span);
        }
        return this.arena.get_function(ret_ty, param_types, false);
    }

    /// Record a captured outer binding `outer_ty` for the surrounding lambda,
    /// shadow it as a per-lambda local, and return its type so the
    /// referencing identifier resolves.
    record_lambda_capture(mut &this, e: ExpressionNode*, ident: IdentifierExpr*, outer_ty: TypeRef) -> TypeRef {
        this.scopes.declare(ident.res.local_sym(), outer_ty, false);
        if (this.state.current_lambda != null) {
            this.state.current_lambda.add_capture(ident.name, ident.res.local_sym(),
                                                  outer_ty, e.span,
                                                  this.capture_by_reference(this.state.current_lambda, outer_ty));
        }
        return outer_ty;
    }

    /// Whether `lambda` holds a capture of type `ty` by reference.  A `Copy`
    /// value is copied into any closure; any other value is moved into a
    /// `move` closure and borrowed by every other closure.
    capture_by_reference(mut &this, lambda: LambdaExpr*, ty: TypeRef) -> boolean {
        if (lambda.is_move) { return false; }
        return !OwnershipQuery::is_copy(this.arena, this.ctx.get_generic_registry(), this.intern, ty);
    }

    /// Register the definition of a new closure struct, `<ns>::__Closure_<N>`,
    /// in the module being lowered.  The synthesizer creates the declaration,
    /// so this is its one registration; its name is the definition's path.
    mint_closure_def(mut &this, span: SourceSpan) -> DefId {
        const idx: u64 = this.state.closure_counter;
        this.state.closure_counter += 1;
        if (this.ctx.has_namespace()) {
            return this.ctx.register_in_module(this.ctx.unit_module,
                this.intern.intern(fmt::format("__Closure_%lld", idx as i64).into_raw()), DefKind::Type, span);
        }
        return this.ctx.register_in_module(ModulePath::none(),
            this.intern.intern(fmt::format("%s::__Closure_%lld", this.ctx.source_file, idx as i64).into_raw()),
            DefKind::Type, span);
    }

    /// The receiver of a method synthesized on a closure struct: the struct by
    /// reference, with a binding of its own, as every method's receiver is.
    closure_receiver(mut &this, struct_ref: TypeRef, span: SourceSpan) -> DeclarationNode* {
        mut recv: mut VarDecl* = VarDecl::new(this.intern.intern("&this"));
        const recv_decl: DeclarationNode* = DeclarationNode::of(DeclKind::Variable(recv), span);
        recv.set_receiver(ReceiverForm::ByReference);
        recv.set_sym_id(this.resolver.alloc_synthetic_binding());
        recv.set_mutable(false);
        recv.set_resolved_type(this.arena.get_pointer_to(struct_ref));
        return recv_decl;
    }

    /// Synthesise the closure-struct + `__call__` (+ `Drop` for non-Copy captures)
    /// for a capturing lambda written at `span`; returns the closure struct's
    /// TypeRef.
    synthesize_closure_struct(mut &this, lambda: mut LambdaExpr*, span: SourceSpan) -> TypeRef {
        const ctx_ptr: mut CompilationContext* = this.ctx;
        const intern_ptr: mut InternTable* = this.intern;
        const arena_ptr: mut TypeArena* = this.arena;

        const closure_def: DefId = this.mint_closure_def(span);
        const qual_name: SymbolStr = ctx_ptr.defs.path_of(closure_def).spelling();

        // A lambda written in a generic body may mention that body's type
        // parameters - in what it captures, its signature or its body - so
        // its closure is a template over them (the owner's, then the
        // function's own), specialized with each copy of the body as a
        // written generic struct is.  The parameter nodes are the body's
        // own, so the closure's `T` and the body's `T` are one arena type.
        mut params: [DeclarationNode*] = [];
        if (this.state.in_symbolic_check) {
            for (mut i: i64 = 0; i < this.state.symbolic_owner_param_nodes.length(); i++) {
                params.push(this.state.symbolic_owner_param_nodes[i]);
            }
            for (mut i: i64 = 0; i < this.state.symbolic_method_param_nodes.length(); i++) {
                params.push(this.state.symbolic_method_param_nodes[i]);
            }
        }
        const generic: boolean = params.length() > 0;
        const spelling: TypeSpelling = TypeSpelling::new(arena_ptr, ctx_ptr);
        // What a template builds from its own parameters is abstract: nothing
        // demands those instantiations.
        const saved_no_demand: boolean = arena_ptr.symbolic_no_demand_active;
        if (generic) { arena_ptr.set_symbolic_no_demand(true); }

        // 1. The struct declaration and its fields.
        const struct_decl: mut StructDecl* = StructDecl::new(qual_name);
        const struct_header: mut DeclarationNode* = DeclarationNode::of(DeclKind::Struct(struct_decl), span);
        struct_header.generated = true;

        // A borrowed capture's field is a reference to the binding; any other
        // capture's field holds the value.
        mut field_types: [TypeRef] = [];
        mut borrows_frame: boolean = false;
        for (mut i: i64 = 0; i < lambda.captured_names.length(); i++) {
            if (lambda.borrows_capture(i)) {
                field_types.push(arena_ptr.get_reference_to(lambda.captured_types[i], RefMutability::Immutable));
                borrows_frame = true;
            } else {
                field_types.push(lambda.captured_types[i]);
                if (arena_ptr.holds_frame_borrow(lambda.captured_types[i])) { borrows_frame = true; }
            }
        }
        // Each field's initializer where the closure is made: the binding
        // itself, or its address for a borrowed capture.
        mut capture_values: [mut ExpressionNode*] = [];
        for (mut i: i64 = 0; i < lambda.captured_names.length(); i++) {
            mut value: mut ExpressionNode* = ExpressionNode::identifier_expr(
                lambda.captured_names[i], lambda.captured_spans[i]);
            ExpressionNode::identifier_of(value).set_res(Res::Local(lambda.captured_syms[i]));
            value.set_resolved_type(lambda.captured_types[i]);
            if (lambda.borrows_capture(i)) {
                const amp: Token = Token::new(TokenType::Amp, "&",
                    lambda.captured_spans[i].start_line as int, lambda.captured_spans[i].start_col as int);
                value = ExpressionNode::synthetic_unary(amp, value, lambda.captured_spans[i]);
                value.set_resolved_type(field_types[i]);
            }
            capture_values.push(value);
        }
        lambda.capture_values = capture_values;
        for (mut i: i64 = 0; i < lambda.captured_names.length(); i++) {
            mut field: mut FieldDecl* = FieldDecl::new(lambda.captured_names[i]);
            field.visibility = Visibility::Public;
            field.resolved_type = field_types[i];
            if (generic) {
                field.type_annotation = spelling.of(field_types[i], &params, span);
                if (field.type_annotation == null) {
                    ctx_ptr.ice_at(fmt::format("a closure in a generic body captures a value of type `%s`, which has no annotation spelling",
                        arena_ptr.resolve_display_name(field_types[i])).into_raw(), span);
                }
            }
            struct_decl.fields.push(DeclarationNode::of(DeclKind::Field(field), span));
        }

        // 2. Arena StructType + fields.
        const struct_ref: TypeRef = arena_ptr.create_struct(
            qual_name, ctx_ptr.declaring_module(closure_def));
        // The type a value of the closure has: the template at its own
        // parameters when generic, the struct itself otherwise.
        mut self_ty: TypeRef = struct_ref;
        if (generic) {
            for (mut i: i64 = 0; i < params.length(); i++) { struct_decl.generic_params.push(params[i]); }
            const param_refs: [TypeRef] = TypeResolutionPasses::create_generic_param_types(params, arena_ptr);
            mut param_names: [SymbolStr] = [];
            mut param_syms: [SymbolID] = [];
            mut param_types: [TypeRef] = [];
            for (mut i: i64 = 0; i < params.length(); i++) {
                const gp: GenericParamDecl* = DeclarationNode::generic_param_of(params[i]);
                param_names.push(gp.name);
                param_syms.push(gp.sym_id);
                param_types.push(param_refs[i]);
            }
            ctx_ptr.get_generic_registry().register_template(TemplateEntry::new(
                ctx_ptr.defs.leaf_of(closure_def).spelling(), qual_name, closure_def, ctx_ptr.current_module(),
                param_names, param_syms, param_types, struct_header, TemplateKind::Struct, struct_ref));
            self_ty = ctx_ptr.get_generic_registry().instantiate(struct_ref, &param_refs);
        }
        const struct_t: Type* = arena_ptr.lookup(struct_ref);
        if (struct_t != null && struct_t.kind == TypeKind::Struct) {
            const st: mut StructType* = struct_t.as_struct();
            mut infos: [FieldInfo] = [];
            for (mut i: i64 = 0; i < lambda.captured_names.length(); i++) {
                infos.push(FieldInfo::new(
                    lambda.captured_names[i], field_types[i], Visibility::Public, false));
            }
            st.set_fields(infos);
            st.borrows_frame = borrows_frame;
        }

        // 3. `__call__` FunctionDecl: the closure struct by reference, then
        // the lambda's own parameters.
        const call_name: SymbolStr = intern_ptr.intern("__call__");
        mut call_fn: mut FunctionDecl* = FunctionDecl::new(call_name);
        const call_fn_decl: DeclarationNode* = DeclarationNode::of(DeclKind::Function(call_fn), span);
        call_fn.written_in = FunctionDecl::written_in_of(this.state.current_func);
        call_fn.set_resolved_return_type(lambda.return_type);
        if (generic) {
            call_fn.set_return_type_annotation(spelling.of(lambda.return_type, &params, span));
        }
        const call_recv_decl: DeclarationNode* = this.closure_receiver(self_ty, span);
        const call_recv: VarDecl* = DeclarationNode::var_of(call_recv_decl);
        call_fn.add_parameter(call_recv_decl);
        for (mut i: i64 = 0; i < lambda.parameters.length(); i++) {
            call_fn.add_parameter(lambda.parameters[i]);
        }

        // 4. __call__ body: `{ const cap_i = this.cap_i; <lambda body> }`, and
        // `const cap_i = *this.cap_i;` for a borrowed capture.
        const body_block: Stmt* = Stmt::block(span);
        const body: mut BlockStmt* = body_block.as_block();
        const this_ident_sym: SymbolStr = intern_ptr.intern("this");
        const cap_registry: GenericRegistry* = this.ctx.get_generic_registry();
        for (mut i: i64 = 0; i < lambda.captured_names.length(); i++) {
            const cap_name: SymbolStr = lambda.captured_names[i];
            const cap_ty:   TypeRef   = lambda.captured_types[i];

            const this_ident: mut ExpressionNode* = ExpressionNode::identifier_expr(this_ident_sym, span);
            this_ident.set_resolved_type(self_ty);
            ExpressionNode::identifier_of(this_ident).set_res(Res::Local(call_recv.sym_id));
            mut access: mut ExpressionNode* = ExpressionNode::member_access_expr(
                this_ident, cap_name, span, span);
            access.set_resolved_type(field_types[i]);
            // Capture `i` is field `i` of the struct laid out above; nothing
            // after this walks a node that already carries its type, so the
            // position is recorded here, where it is known.
            ExpressionNode::member_access_of(access).set_resolved_member(MemberPin::Field(i));
            if (lambda.borrows_capture(i)) {
                const star: Token = Token::new(TokenType::Star, "*",
                    span.start_line as int, span.start_col as int);
                access = ExpressionNode::synthetic_unary(star, access, span);
                access.set_resolved_type(cap_ty);
            }
            // The shadow is the captured binding inside `__call__`: the body
            // moved in below still names that binding in every use it holds, so
            // the shadow takes its identity.  With a fresh one, a move of the
            // capture inside the body names no declaration of `__call__`, and
            // the checks keyed by binding never see it.
            mut shadow: mut VarDecl* = VarDecl::new(cap_name);
            const shadow_decl: mut DeclarationNode* = DeclarationNode::of(DeclKind::Variable(shadow), span);
            shadow_decl.generated = true;
            shadow.set_sym_id(if (lambda.captured_syms[i].is_valid()) {
                lambda.captured_syms[i]
            } else {
                this.resolver.alloc_synthetic_binding()
            });
            shadow.set_mutable(false);
            shadow.set_resolved_type(cap_ty);
            if (generic) { shadow.set_type_annotation(spelling.of(cap_ty, &params, span)); }
            shadow.set_initializer(access);
            // A value that is not `Copy` stays the closure's, or its owner's
            // when borrowed: the shadow names it and owns nothing.
            if (!OwnershipQuery::is_copy(arena_ptr, cap_registry, intern_ptr, cap_ty)) {
                shadow.set_capture_alias(true);
            }
            body.add_statement(Stmt::decl_stmt(shadow_decl, span));
        }
        if (lambda.body != null) {
            match (lambda.body.kind) {
                StmtKind::Block(orig_blk) => {
                    for (mut bi: i64 = 0; bi < orig_blk.statements.length(); bi++) {
                        body.add_statement(orig_blk.statements[bi]);
                    }
                }
                _ => { body.add_statement(lambda.body); }
            }
        }
        call_fn.set_body(body_block);

        // 5. MethodDecl + attach.
        mut method: mut MethodDecl* = MethodDecl::new(call_fn_decl);
        const method_decl: DeclarationNode* = DeclarationNode::of(DeclKind::Method(method), span);
        call_fn.def = ctx_ptr.define_method(closure_def, call_fn.name, span,
            method_decl);
        method.set_visibility(Visibility::Public);
        method.set_static(false);
        method.set_sink(false);
        struct_decl.methods.push(method_decl);

        // 6. Populate StructType.methods so overload resolution finds `__call__`.
        if (struct_t != null && struct_t.kind == TypeKind::Struct) {
            const st: mut StructType* = struct_t.as_struct();
            mut method_param_types: [TypeRef] = [];
            for (mut pi: i64 = 0; pi < call_fn.parameters.length(); pi++) {
                const pp_decl: DeclarationNode* = call_fn.parameters[pi];
                const pp: VarDecl* = DeclarationNode::var_of(pp_decl);
                // A method's entry lists what a call passes: not the receiver.
                if (pp != null && !pp.is_receiver() && pp.resolved_type.is_valid()) {
                    method_param_types.push(pp.resolved_type);
                }
            }
            const call_fn_ty: TypeRef = arena_ptr.get_function(
                lambda.return_type, method_param_types, false);
            const minfo: MethodInfo = MethodInfo {
                name:          call_name,
                function_type: call_fn_ty,
                is_static:     false,
                param_types:   method_param_types,
                ast_node:      method_decl as void*,
            };
            st.add_method(minfo);
        }

        // 7. DeclarationIndex registration.
        struct_decl.def = closure_def;
        ctx_ptr.decl_index.register_type(closure_def, struct_ref, Visibility::Public);
        mut method_arr: [DeclarationNode*] = [method_decl];
        ctx_ptr.decl_index.register_methods(
            struct_ref, method_arr, intern_ptr, arena_ptr, "closure/struct methods");
        // A call of the closure in the generic body it was made in asks the
        // template's own instantiation for `__call__`.
        if (generic) { ctx_ptr.decl_index.register_template_methods(closure_def, &method_arr, arena_ptr); }
        const drop_impl: mut DeclarationNode* = this.closure_drop_impl(lambda, struct_decl, struct_ref, span);
        // A template's `Drop` is specialized with it, by the demand that
        // specializes the closure.
        if (generic && drop_impl != null) {
            const drop_block: mut ImplBlock* = DeclarationNode::impl_of(drop_impl);
            for (mut i: i64 = 0; i < params.length(); i++) { drop_block.generic_params.push(params[i]); }
            drop_block.target_args = spelling.generic_parameters(&params, span);
            ctx_ptr.get_generic_registry().register_impl_block(drop_block.target_def(), drop_impl);
        }

        // 8. Inject into ProgramNode so subsequent passes walk it.
        if (ctx_ptr.artifacts.ast.root != null) {
            ctx_ptr.artifacts.ast.root.add_statement(Node::Decl(struct_header));
            if (drop_impl != null) {
                drop_impl.generated = true;
                ctx_ptr.artifacts.ast.root.add_statement(Node::Decl(drop_impl));
            }
        }

        if (generic) { arena_ptr.set_symbolic_no_demand(saved_no_demand); }
        return self_ty;
    }

    /// `implement trait Drop for struct <closure>`, for a closure that owns
    /// a captured value that is not `Copy`; null when it owns none - every
    /// capture is `Copy` or borrowed - so the closure is `Copy` too.  The
    /// destructor's body is empty: the captures are the struct's fields, and
    /// they are released after its `drop` runs, as any aggregate's are.
    /// Being the closure's destructor, it is what a written `f.drop()` and
    /// the scope-exit release both reach.
    closure_drop_impl(mut &this, lambda: LambdaExpr*, struct_decl: StructDecl*,
                      struct_ref: TypeRef, span: SourceSpan) -> mut DeclarationNode* {
        const registry_ptr: mut GenericRegistry* = this.ctx.get_generic_registry();
        mut has_noncopy_capture: boolean = false;
        for (mut di: i64 = 0; di < lambda.captured_names.length(); di++) {
            if (lambda.borrows_capture(di)) { continue; }
            if (!OwnershipQuery::is_copy(this.arena, registry_ptr, this.intern, lambda.captured_types[di])) {
                has_noncopy_capture = true;
                break;
            }
        }
        if (!has_noncopy_capture) { return null; }
        const drop_id: DefId = registry_ptr.wellknown(LangItem::Drop);
        if (!drop_id.is_valid()) { return null; }

        const drop_name: SymbolStr = this.intern.intern("drop");
        mut drop_fn: mut FunctionDecl* = FunctionDecl::new(drop_name);
        const drop_fn_decl: DeclarationNode* = DeclarationNode::of(DeclKind::Function(drop_fn), span);
        drop_fn.set_resolved_return_type(this.arena.get_void());
        drop_fn.set_origin_trait(drop_id);
        drop_fn.add_parameter(this.closure_receiver(struct_ref, span));
        drop_fn.set_body(Stmt::block(span));
        mut drop_method: mut MethodDecl* = MethodDecl::new(drop_fn_decl);
        const drop_method_decl: DeclarationNode* = DeclarationNode::of(DeclKind::Method(drop_method), span);
        drop_fn.def = this.ctx.define_method(struct_decl.def, drop_name, span,
            drop_method_decl);
        drop_method.set_visibility(Visibility::Public);
        drop_method.set_static(false);
        drop_method.set_sink(false);

        const impl_node: mut ImplBlock* = ImplBlock::new(struct_decl.name);
        const impl_decl: mut DeclarationNode* = DeclarationNode::of(DeclKind::Impl(impl_node), span);
        // A synthesized head is walked by no resolver, so the synthesizer,
        // which holds both definitions, records what it names.
        impl_node.res.answer(Res::Def(struct_decl.def));
        mut trait_ann: mut NamedAnnotation* = new NamedAnnotation {
            name: this.intern.intern("Drop"), span: span, pre_resolved: TypeRef::invalid(),
            res: ResSlot::Pending,
        };
        trait_ann.res.answer(Res::Def(drop_id));
        impl_node.trait_annotation = new TypeAnnotation::Named(trait_ann);
        impl_node.trait_def = drop_id;
        impl_node.methods.push(drop_method_decl);

        mut impl_methods: [DeclarationNode*] = [drop_method_decl];
        this.ctx.decl_index.register_methods(
            struct_ref, impl_methods, this.intern, this.arena, "closure/drop impl");
        registry_ptr.register_trait_impl(drop_id, struct_ref, impl_decl);
        return impl_decl;
    }

    /// True when `ty` is a struct carrying a `__call__` method (a closure type).
    is_closure_struct_type(mut &this, ty: TypeRef) -> boolean {
        return this.closure_call_type(ty).is_valid();
    }

    /// The function type the closure type `ty` is called as - its
    /// `__call__`'s parameters after the receiver, and its return - which is
    /// what a function-typed parameter it is passed to must be; invalid when
    /// `ty` is no closure type.
    closure_call_type(mut &this, ty: TypeRef) -> TypeRef {
        const t: Type* = this.arena.lookup(ty);
        if (t == null || (t.kind != TypeKind::Struct && t.kind != TypeKind::InstantiatedType)) {
            return TypeRef::invalid();
        }
        return this.ctx.type_resolver.call_signature_of(ty);
    }

    /// True if any of `call`'s arguments is a capturing closure (an anonymous
    /// closure-struct value, i.e. has a `__call__` method). Non-capturing
    /// lambdas lower to plain function pointers and are NOT closure structs.
    call_has_closure_struct_arg(mut &this, call: CallExpr*) -> boolean {
        if (call == null) { return false; }
        for (mut i: i64 = 0; i < call.arguments.length(); i++) {
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null) { continue; }
            if (this.is_closure_struct_type(arg.resolved_type)) { return true; }
        }
        return false;
    }

    /// If `call.callee` is a closure-struct local, rewrite `f(args)` to
    /// `f.__call__(args)` in place.
    maybe_rewrite_closure_call(mut &this, call: mut CallExpr*) -> void {
        if (call == null || call.callee == null) { return; }
        const ident: IdentifierExpr* = ExpressionNode::identifier_of(call.callee);
        if (ident == null) { return; }
        const local_ty: TypeRef = this.scopes.type_of(ident.res.local_sym());
        if (!this.is_closure_struct_type(local_ty)) { return; }
        call.callee.set_resolved_type(local_ty);
        const call_sym: SymbolStr = this.intern.intern("__call__");
        call.callee = ExpressionNode::member_access_expr(
            call.callee, call_sym, call.callee.span, call.callee.span);
    }

    /// When a call passes capturing closures to fn-typed params of a
    /// non-generic free function, synthesise a spec'd clone whose params are typed
    /// as the concrete closure-struct, inject it, and pin `call.resolved_callee`.
    ///
    /// The callee is `selected`, the entry of the stamped declaration's
    /// family the call's arguments select (`CallResolver::closure_call_entry`):
    /// the signature is that entry's own, and the clone is of the declaration
    /// it was registered for.  The stamp names the family, not one of its
    /// overloads, so neither the stamp's definition nor its path says which
    /// signature a call means.  A local (a fn-pointer parameter or binding)
    /// names no declaration and is not specialized - asking the bare index
    /// for the leaf instead handed back whichever global shared the local's
    /// spelling, and a capturing closure passed to a parameter `f` was then
    /// bound to global `f`'s clone, exit 0.
    ///
    /// A callee declared in another module has no AST in this root and is
    /// not specialized here; that is the reach of the pass, not a lookup
    /// that failed.
    try_specialize_for_closure_args(mut &this, call: mut CallExpr*, ident: IdentifierExpr*,
                                    selected: OverloadId) -> void {
        if (call == null || ident == null) { return; }

        mut callee_res: Res = Res::Err;
        match (ident.res) {
            ResSlot::Answered(r) => { callee_res = r; }
            _ => {}
        }
        const callee_def: DefId = callee_res.def_id();
        if (!callee_def.is_valid()) {
            // A local of function type holds a function pointer, and the
            // pointer's parameters take function pointers: there is no
            // declaration to copy for the closure.
            match (callee_res) {
                Res::Local(sym) => {
                    const local_t: Type* = this.arena.lookup(this.scopes.type_of(sym));
                    if (local_t != null && local_t.kind == TypeKind::Function) {
                        this.refuse_closures_into_function_parameters(call, &local_t.as_function().param_types,
                            fmt::format("the function value `%s`", this.intern.resolve(ident.name)).into_raw());
                    }
                }
                _ => {}
            }
            return;
        }

        // A generic function's parameter of function type is a function
        // pointer in every copy of the function, so a closure is refused
        // there, before the early returns below; one passed to a type
        // parameter is that parameter's argument, and the copy for it calls
        // it directly.
        const stamped_fn_decl: DeclarationNode* = this.top_level_function_of(callee_def);
        const stamped_fn: FunctionDecl* = DeclarationNode::fn_of(stamped_fn_decl);
        if (stamped_fn != null && stamped_fn.is_generic() && this.call_has_closure_struct_arg(call)) {
            mut generic_params: [TypeRef] = [];
            for (mut i: i64 = 0; i < stamped_fn.parameters.length(); i++) {
                generic_params.push(DeclarationNode::var_of(stamped_fn.parameters[i]).resolved_type);
            }
            this.refuse_closures_into_function_parameters(call, &generic_params,
                fmt::format("`%s`", this.intern.resolve(ident.name)).into_raw());
            return;
        }

        if (call.resolved_callee.is_some()) { return; }
        if (call.generic_args.length() > 0) { return; }

        // The signature is the selected entry's own, and the declaration
        // cloned is the one that entry was registered for.
        if (!selected.is_valid()) { return; }
        const callee_fn_ref: TypeRef = this.ctx.decl_index.entry_signature(selected);
        if (!callee_fn_ref.is_valid()) { return; }
        const selected_decl: DeclarationNode* = this.ctx.decl_index.entry_decl(selected);
        const orig_func_decl: DeclarationNode* =
            if (selected_decl == null || DeclarationNode::fn_of(selected_decl) == null) { null } else {
                this.top_level_function_of(DeclarationNode::fn_of(selected_decl).def) };
        const orig_func: FunctionDecl* = DeclarationNode::fn_of(orig_func_decl);

        const ft_raw: Type* = this.arena.lookup(callee_fn_ref);
        if (ft_raw == null || ft_raw.kind != TypeKind::Function) { return; }
        const ft: FunctionType* = ft_raw.as_function();
        if (ft.is_variadic) { return; }
        if (ft.param_types.length() != call.arguments.length()) { return; }

        mut sub_indices: [i64] = [];
        mut sub_types:   [TypeRef] = [];
        for (mut i: i64 = 0; i < ft.param_types.length(); i++) {
            const p_t: Type* = this.arena.lookup(ft.param_types[i]);
            if (p_t == null || p_t.kind != TypeKind::Function) { continue; }
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null) { continue; }
            if (!this.is_closure_struct_type(arg.resolved_type)) { continue; }
            sub_indices.push(i);
            sub_types.push(arg.resolved_type);
        }
        if (sub_indices.length() == 0) { return; }

        // Declared in another module: there is no body here to copy.
        if (orig_func == null) {
            this.refuse_closures_into_function_parameters(call, &ft.param_types,
                fmt::format("`%s` (declared in another module)", this.intern.resolve(ident.name)).into_raw());
            return;
        }
        // Keyed by the selected DEFINITION: two callees sharing a leaf, or
        // overloads sharing a path, must not share a specialization.
        const def_slot: DefKey = this.ctx.defs.table_key(orig_func.def);
        mut rec_pos: [i64] = [];
        mut rec_types: [TypeRef] = [];
        for (mut qi: i64 = 0; qi < sub_types.length(); qi++) {
            rec_pos.push(sub_indices[qi]);
            rec_types.push(sub_types[qi]);
        }
        const prior: OverloadId = this.state.closure_spec(def_slot, &rec_pos, &rec_types);
        if (prior.is_valid()) {
            call.set_resolved_callee(CalleePin::Decl(prior));
            return;
        }

        // Generic receivers are handled by the capturing-closure guard at the
        // top of this function (they are rejected before reaching here).
        if (orig_func.is_generic()) { return; }
        if (orig_func.body == null) { return; }

        mut cloner: ASTCloner = ASTCloner::new();
        const spec_func_decl: DeclarationNode* = cloner.clone_decl(orig_func_decl);
        if (spec_func_decl == null) { return; }
        if (DeclarationNode::fn_of(spec_func_decl) == null) { return; }
        mut spec_func: mut FunctionDecl* = DeclarationNode::fn_of(spec_func_decl);

        for (mut i: i64 = 0; i < spec_func.parameters.length(); i++) {
            const p_decl: DeclarationNode* = spec_func.parameters[i];
            mut p: mut VarDecl* = DeclarationNode::var_of(p_decl);
            if (p == null) { continue; }
            mut sub_ty: TypeRef = TypeRef::invalid();
            for (mut si: i64 = 0; si < sub_indices.length(); si++) {
                if (sub_indices[si] == i) { sub_ty = sub_types[si]; break; }
            }
            if (sub_ty.is_valid()) {
                p.set_resolved_type(sub_ty);
            } else if (i < orig_func.parameters.length()
                    && orig_func.parameters[i] != null
                    && DeclarationNode::var_of(orig_func.parameters[i]).resolved_type.is_valid()) {
                p.set_resolved_type(DeclarationNode::var_of(orig_func.parameters[i]).resolved_type);
            }
        }
        spec_func.set_resolved_return_type(orig_func.resolved_return_type);

        const spec_name: SymbolStr = this.mint_closure_spec_name(orig_func.name, sub_types);
        spec_func.set_name(spec_name);

        if (this.ctx.artifacts.ast.root != null) {
            this.ctx.artifacts.ast.root.add_statement(Node::Decl(spec_func_decl));
        }

        // The specialization is a copy of `orig_func`: registered in no
        // family, its symbol mangled under the module `orig_func` is
        // declared in; the definition, this pin and the closure-spec cache
        // read the one entry.
        mut spec_param_types: [TypeRef] = [];
        for (mut i: i64 = 0; i < spec_func.parameters.length(); i++) {
            spec_param_types.push(DeclarationNode::var_of(spec_func.parameters[i]).resolved_type);
        }
        const spec_ft: TypeRef = this.arena.get_function(
            spec_func.resolved_return_type, spec_param_types, false);
        const entry: OverloadId = this.ctx.decl_index.register_copy_signature(
            this.ctx.copy_module_family(orig_func.def), spec_name, spec_func.resolved_return_type, spec_ft,
            this.intern, this.arena, spec_func_decl.span, spec_func_decl);
        spec_func.set_overload_entry(entry);
        call.set_resolved_callee(CalleePin::Decl(entry));
        this.state.add_closure_spec(def_slot, rec_pos, rec_types, entry);
    }

    /// The top-level function of this root that declares the definition `d`,
    /// or null - a function declared in another module, or a definition no
    /// function declares.
    top_level_function_of(&this, d: DefId) -> DeclarationNode* {
        if (this.ctx.artifacts.ast.root == null) { return null; }
        const stmts: &[Node] = &this.ctx.artifacts.ast.root.statements;
        for (mut i: i64 = 0; i < stmts.length(); i++) {
            const fn_decl: DeclarationNode* = stmts[i].as_decl();
            const fn: FunctionDecl* = DeclarationNode::fn_of(fn_decl);
            if (fn == null) { continue; }
            if (fn.def.equals(d)) { return fn_decl; }
        }
        return null;
    }

    /// The identifier of a closure-arg specialization of `orig`: the
    /// specialization encoding over the closure types, through the one
    /// mangler every specialization goes through.  A closure type's name is
    /// its module and a per-build counter (`mint_closure_def`), so the
    /// identifier is a function of the source; an arena id is not, and a
    /// symbol spelling one moves whenever an unrelated type is created
    /// earlier.
    mint_closure_spec_name(mut &this, orig: SymbolStr, closure_tys: [TypeRef]) -> SymbolStr {
        return MangledName::specialized_identifier(
            this.intern, this.arena, QualifiedName::from_symbol(orig), &closure_tys);
    }

    /// Where the closure of type `closure_ty` is written: the lambda its
    /// struct was made for.
    static closure_site(ctx: CompilationContext*, closure_ty: TypeRef) -> SourceSpan {
        return ctx.defs.span_of(ctx.decl_index.registered_def(closure_ty));
    }

    /// The suggestion to write `move` before the closure of type
    /// `closure_ty`, so it owns what it captures; none when the closure has
    /// no place to write it.
    static own_captures_fix(ctx: CompilationContext*, closure_ty: TypeRef) -> Option<Suggestion> {
        const site: SourceSpan = LambdaSynth::closure_site(ctx, closure_ty);
        if (!site.has_location()) { return Option::None; }
        return Option::Some(Suggestion::single(site.start_point(), "move ",
            "make the closure own what it captures: a `move` closure takes each captured value where it is made",
            Applicability::MaybeIncorrect));
    }

    /// E0457 when the value of type `value_ty` returned at `span` holds a
    /// closure that borrows from this frame: what it borrows is released
    /// when the function returns, and the closure would read it afterwards.
    refuse_returned_borrow(mut &this, value_ty: TypeRef, span: SourceSpan) -> void {
        mut held: [TypeRef] = [];
        this.arena.frame_borrowing_closures(value_ty, &held);
        if (held.length() == 0) { return; }
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0457_NON_COPY_CAPTURE,
            "cannot return a closure that borrows values of this function");
        diag = diag.at_with_label(span, "this value holds a closure that borrows local values");
        const site: SourceSpan = LambdaSynth::closure_site(this.ctx, held[0]);
        if (site.has_location()) {
            diag = diag.also_at(site, "this closure borrows what it captures");
        }
        diag = diag.with_note(
            "a closure written without `move` borrows each captured value that is not `Copy`, and those values are released when the function returns");
        match (LambdaSynth::own_captures_fix(this.ctx, held[0])) {
            Option::Some(fix) => { diag = diag.suggest(fix); }
            Option::None => {}
        }
        this.ctx.emit_diagnostic(diag);
    }

    /// E0458 when a capturing closure of type `value_ty` is held by a slot
    /// of function type `slot_ty` - `what`, a variable, a field, an array
    /// element, a variant's payload, an assigned place or a returned value.
    /// A function-typed slot holds a function pointer, which has no room for
    /// the closure's captures; a slot of the closure's own type, or of a type
    /// parameter, holds it.  `annotation` is a variable's written `: Type`,
    /// from the end of its name, which the fix removes; no location for any
    /// other slot.
    refuse_stored_closure(mut &this, value_ty: TypeRef, slot_ty: TypeRef, span: SourceSpan,
                          what: string, annotation: SourceSpan) -> void {
        if (!this.is_closure_struct_type(value_ty)) { return; }
        const st: Type* = this.arena.lookup(slot_ty);
        if (st == null || st.kind != TypeKind::Function) { return; }
        const shown: string = this.arena.format_display(st);
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0458_CLOSURE_ARG_NON_FREE,
            fmt::format("a capturing closure cannot be held by %s of function type `%s`", what, shown));
        diag = diag.at_with_label(span, "this closure captures from its environment");
        diag = diag.with_note(
            "a function-typed value is a function pointer, with no room for a closure's captures; a binding of the closure's own type holds it, and so does a value of a type parameter");
        diag = diag.help(fmt::format(
            "leave a variable's type to inference (`const f = (...) -> T { ... };`), or give the slot a type parameter with a callable bound: `where F: %s`",
            shown));
        if (annotation.has_location()) {
            diag = diag.suggest(Suggestion::machine_applicable(annotation, "",
                "let the variable take the closure's own type"));
        }
        this.ctx.emit_diagnostic(diag);
    }

    /// E0458 for each capturing closure among `call`'s arguments that lands
    /// on a parameter of function type in `param_types`, the parameters of
    /// what `call` calls (`callee` names it).  A function-typed parameter
    /// holds a function pointer, which has no room for the closure's
    /// captures; a closure that lands on a type parameter is passed as the
    /// value it is, and a callable bound on that parameter is what lets the
    /// callee call it.  An argument past the known parameters is refused the
    /// same way: nothing says it reaches anything but a function pointer.
    refuse_closures_into_function_parameters(mut &this, call: CallExpr*, param_types: &[TypeRef],
                                             callee: string) -> void {
        if (call == null) { return; }
        for (mut i: i64 = 0; i < call.arguments.length(); i++) {
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null) { continue; }
            if (!this.is_closure_struct_type(arg.resolved_type)) { continue; }
            const slot: Type* = if (i < param_types.length()) { this.arena.lookup(param_types[i]) } else { null };
            if (slot != null && slot.kind != TypeKind::Function) { continue; }
            const shown: string = if (slot != null) { this.arena.format_display(slot) } else { "(...) -> ..." };
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0458_CLOSURE_ARG_NON_FREE,
                fmt::format("a capturing closure cannot be passed to a parameter of function type `%s` of %s",
                    shown, callee));
            diag = diag.at_with_label(arg.span, "this closure captures from its environment");
            diag = diag.with_note(
                "a function-typed parameter takes a function pointer, which has no room for a closure's captures; only a non-generic free function of this module is copied for each closure passed to it");
            diag = diag.help(fmt::format(
                "declare the parameter's type as a type parameter with a callable bound, which takes a closure: `<F>(f: F) where F: %s`",
                shown));
            this.ctx.emit_diagnostic(diag);
        }
    }
}
