// Format-argument categories for the `printf`/`eprintf` directive checker.
// A `%` conversion expects one of these; each variadic argument's resolved
// type maps to one; a category mismatch (or a wrong argument count) is
// reported as W0013.  `PF_NONE` doubles as "no argument" (for `%%` and
// unknown conversions) and "cannot judge" (an unresolved/generic argument):
// both mean "skip".
const PF_NONE:    i64 = 0;
const PF_INT:     i64 = 1;   // %d %i %u %x %X %o %c
const PF_FLOAT:   i64 = 2;   // %f %e %g %a (and their capitals)
const PF_STRING:  i64 = 3;   // %s  (a C `string`)
const PF_POINTER: i64 = 4;   // %p
const PF_STRUCT:  i64 = 5;   // an aggregate argument - never valid for C printf

/// One method selection.  `owner_inst` is the receiver when it is an
/// instantiation not yet minted, whose template's methods are the
/// candidates, and invalid otherwise.  `chosen` is the method selected and
/// `ret` its return type as the receiver sees it; `tier` is the binding
/// tier its arguments bound at, and `info` the receiver's own method entry
/// it was found as (null when it came from a declaration or an impl
/// block).  Selecting writes nothing to the call: a candidate set can be
/// asked whether it applies, and the call is bound once, by
/// `commit_selection`.  `recv` is the receiver the selection was made on,
/// unwrapped: `owner_inst` when that is valid, else the minted type;
/// invalid on a call already bound.
type struct Selection {
    owner_inst: TypeRef;
    recv:       TypeRef;
    chosen:     DeclarationNode*;
    ret:        TypeRef;
    tier:       i32;
    info:       MethodInfo*;
    /// Not null when the selection only records the candidates it tries,
    /// for the argument check, and binds nothing.
    collect:    ArgCandidates*;

    static none() -> Selection {
        return Selection { owner_inst: TypeRef::invalid(), recv: TypeRef::invalid(), chosen: null,
                           ret: TypeRef::invalid(), tier: 0, info: null, collect: null };
    }

    /// A call already bound: its pin, and the pin's declared return.
    static of(mn_decl: DeclarationNode*) -> Selection {
        const mn: MethodDecl* = DeclarationNode::method_of(mn_decl);
        const r: TypeRef = if (mn != null && mn.func != null) { DeclarationNode::fn_of(mn.func).resolved_return_type } else { TypeRef::invalid() };
        return Selection { owner_inst: TypeRef::invalid(), recv: TypeRef::invalid(), chosen: mn_decl, ret: r,
                           tier: 0, info: null, collect: null };
    }
}

/// The methods a call's arguments are checked against when the selection
/// bound none: how many have the member's name, their arities, and the
/// parameters of those with the call's arity, `argc` each, flat.
type struct ArgCandidates {
    argc:       i64;
    name_seen:  i64;
    uniq_arity: i64;
    count:      i64;
    variadic:   boolean;
    params:     [TypeRef];

    static new(argc: i64) -> ArgCandidates {
        return ArgCandidates { argc: argc, name_seen: 0, uniq_arity: -1, count: 0,
                               variadic: false, params: [] };
    }
}

type struct CallResolver {
    arena:    TypeArena*;
    intern:   InternTable*;
    ctx:      CompilationContext*;
    checker:  TypeChecker*;
    state:    SemaState*;
    types:    TypeUtils*;
    literals: LiteralResolver*;
    diag:     Diagnostics*;
    binding:  MethodBinding*;
    symbolic: SymbolicChecker*;
    member:   MemberResolver*;
    lambda:   LambdaSynth*;
    scopes:   ScopeManager*;

    static null() -> CallResolver {
        return CallResolver {
            arena: null, intern: null, ctx: null, checker: null, state: null,
            types: null, literals: null, diag: null, binding: null, symbolic: null,
            member: null, lambda: null, scopes: null,
        };
    }

    wire(mut &this, arena: TypeArena*, intern: InternTable*, ctx: CompilationContext*,
                    checker: TypeChecker*, state: SemaState*, types: TypeUtils*,
                    literals: LiteralResolver*, diag: Diagnostics*, binding: MethodBinding*,
                    symbolic: SymbolicChecker*, member: MemberResolver*, lambda: LambdaSynth*,
                    scopes: ScopeManager*) -> void {
        this.arena    = arena;
        this.intern   = intern;
        this.ctx      = ctx;
        this.checker  = checker;
        this.state    = state;
        this.types    = types;
        this.literals = literals;
        this.diag     = diag;
        this.binding  = binding;
        this.symbolic = symbolic;
        this.member   = member;
        this.lambda   = lambda;
        this.scopes   = scopes;
    }

    /// A fresh trait checker over the shared arena + registry (a 4-pointer view).
    trait_checker(&this) -> TraitChecker {
        return TraitChecker::new(this.arena, this.ctx.generic_registry,
                                 this.intern, this.ctx.diagnostics);
    }

    /// The use site a bare CALL must be judged against: the module whose source
    /// text contains the call, not the module the compiler happens to be
    /// standing in while it types the call.
    ///
    /// Every scope and visibility rule is relative to a use site.  The unit's
    /// module is the wrong one while a generic body is typed: the cursor is
    /// parked on the module that owns the receiver type, and a call that never
    /// leaves its own file would be judged cross-module.
    ///
    /// Falls back to the unit's module - not to "no scope" - when the span
    /// names no module in the graph (a node synthesized without a file,
    /// single-file mode).
    call_use_site_module(&this, span: SourceSpan) -> ModulePath {
        if (this.ctx == null) { return ModulePath::none(); }
        const syn: ModulePath = this.ctx.module_of_file(span.file);
        if (syn.is_valid()) { return syn; }
        return this.ctx.unit_module;
    }

    /// The definition a bare callee names, whose family - its parent and its
    /// leaf - holds every signature of that declaration; invalid when the
    /// callee names no definition.
    ///
    /// A `Def` stamp names the family - the name layer answered from the
    /// scope the call was written in, and the declaration index registers
    /// the overload entries in the family of that definition.  A `Local` is a value with a
    /// type, not a set of signatures, and is read where the value is bound.
    /// A stamp the name layer did not answer names nothing: a bare name
    /// means a declaration in scope or it is an error, the allocator leaf
    /// included (`malloc`/`free`/`realloc` are written `libc::free`,
    /// `heap::free` or `intrinsics::free`, or declared in the writing
    /// module - an extern block, or `no_std`'s own declaration - and reached
    /// by their stamp like every other name).
    callee_def(&this, ident: IdentifierNode*) -> DefId {
        return match (ident.res) {
            ResSlot::Answered(r) => { r.def_id() }
            _                    => { DefId::invalid() }
        };
    }

    /// The index into `overloads` of the signature a call with `arg_types`
    /// selects from one family, or -1 when none does.  A family with a single
    /// signature is selected outright - argument conversion is checked
    /// downstream, and a literal narrower than the parameter must not unpin
    /// the only candidate.  Among several, the first whose parameters match
    /// the arguments exactly (variadic: on the fixed prefix).
    select_family_overload(&this, overloads: &[TypeRef], arg_types: &[TypeRef]) -> i64 {
        if (overloads.length == 1) { return 0; }
        for (mut oi: i64 = 0; oi < overloads.length; oi++) {
            if (this.signature_accepts(overloads[oi], arg_types)) { return oi; }
        }
        return -1;
    }

    /// Whether the signature `sig` takes `arg_types` exactly (variadic: on
    /// its fixed prefix).
    signature_accepts(&this, sig: TypeRef, arg_types: &[TypeRef]) -> boolean {
        const ot: Type* = this.arena.lookup(sig);
        if (ot == null || ot.kind != TypeKind::Function) { return false; }
        const fn_ty: FunctionType* = ot.as_function();
        if (fn_ty.is_variadic) {
            if (arg_types.length < fn_ty.param_types.length) { return false; }
        } else if (fn_ty.param_types.length != arg_types.length) {
            return false;
        }
        for (mut pi: i64 = 0; pi < fn_ty.param_types.length; pi++) {
            if (!this.overload_param_matches_arg(fn_ty.param_types[pi], arg_types[pi])) { return false; }
        }
        return true;
    }


    // -- Callee / payload-type lookups (for expected-type propagation) --

    lookup_callee_function_type(&this, callee: ExpressionNode*) -> TypeRef {
        if (callee == null) { return TypeRef::invalid(); }
        const n: ASTNode* = callee as ASTNode*;
        if (n.kind == NodeKind::Identifier) {
            const ident: IdentifierNode* = callee as IdentifierNode*;
            // The stamp is the writing scope's own answer for this callee and
            // names ONE binding.  A local (closure, fn-pointer, plain value)
            // hints from its own type when that is callable; a definition
            // hints from the signature registered under its canonical name.
            // Anything else - a type, a type parameter, an unanswered slot -
            // is no callee the index holds a signature for, and there is
            // deliberately no spelling lookup beneath: the bare slot is
            // last-write-wins across every module declaring the leaf, so an
            // imported `sleep` reached by leaf took whichever `sleep`
            // registered last - a different signature entirely, which was
            // then what expected-type propagation handed the arguments.
            // Every bare callee is answered - bound, or `Err` for one the
            // name layer refused - so a slot with no answer is a defect the
            // door records.
            const r: Res = ident.res.require("call_resolver:callee hint");
            match (r) {
                Res::Local(sym) => {
                    const local: TypeRef = this.scopes.type_of(sym);
                    if (local.is_valid()) {
                        const local_t: Type* = this.arena.lookup(local);
                        if (local_t != null && local_t.kind == TypeKind::Function) { return local; }
                    }
                    return TypeRef::invalid();
                }
                Res::Def(_) => { return this.ctx.decl_index.func_type_of_res(r); }
                _           => { return TypeRef::invalid(); }
            }
        }
        if (n.kind == NodeKind::ScopeResolution) {
            const sr: ScopeResolutionNode* = callee as ScopeResolutionNode*;
            // A MODULE scope - a graph module's or an `extern module`
            // alias's - is the module lane's to answer, from the stamp, and
            // it is asked next (`lookup_module_qualified_param_types`); no
            // spelling is probed for it here.  The owner a TYPE scope
            // names is asked under its registered name, whatever the source
            // spelled: `Beacon::make` written against an imported `Beacon`
            // once answered another module's same-leaf `Beacon::make`.
            match (sr.require_scope_res("callee hint owner kind")) {
                Res::Def(_) => { return TypeRef::invalid(); }
                _           => { }
            }
            mut owner: FamilyOwner = FamilyOwner::Def(DefId::invalid());
            if (this.scope_owner(sr, &owner)) {
                return this.types.lookup_func_type_exact(owner, sr.member_name);
            }
            return TypeRef::invalid();
        }
        return TypeRef::invalid();
    }

    /// The parameter types `candidates` agree on, position by position, for
    /// an argument's expected type: a position two candidates of the call's
    /// arity disagree on is invalid, and no such candidate is no answer.
    agreed_candidate_params(&this, candidates: &ArgCandidates) -> [TypeRef] {
        mut out: [TypeRef] = [];
        if (candidates.count == 0) { return out; }
        for (mut p: i64 = 0; p < candidates.argc; p++) {
            const first: TypeRef = candidates.params[p];
            mut agree: boolean = true;
            for (mut c: i64 = 1; c < candidates.count; c++) {
                if (!candidates.params[c * candidates.argc + p].equals(first)) { agree = false; break; }
            }
            out.push(if (agree) { first } else { TypeRef::invalid() });
        }
        return out;
    }

    /// Arity-matching method overloads' non-receiver param types for `member`, as
    /// an expected-type hint (a position-wise merge where all overloads agree).
    lookup_method_param_types(mut &this, visitor: SemaVisitor*, call: CallExprNode*,
                              member: MemberAccessNode*, arg_count: i64) -> [TypeRef] {
        const obj_type: TypeRef = visitor.resolve_expr(member.object);
        if (!obj_type.is_valid()) { return []; }
        mut base_ref: TypeRef = obj_type;
        mut base_t: Type* = this.arena.lookup(obj_type);
        mut depth: i32 = 0;
        while (base_t != null && depth < 5) {
            match (base_t.kind) {
                TypeKind::Pointer => {
                    base_ref = base_t.as_pointer().pointee;
                    base_t = this.arena.lookup(base_ref);
                }
                TypeKind::Reference => {
                    base_ref = base_t.as_reference().referent;
                    base_t = this.arena.lookup(base_ref);
                }
                TypeKind::InstantiatedType => {
                    const inst: InstantiatedType* = base_t.as_instantiated();
                    if (inst.has_resolved_type()) {
                        base_ref = inst.resolved_type;
                        base_t = this.arena.lookup(base_ref);
                    } else {
                        // An instantiation not minted yet - `Option<u8>`, or
                        // `Gen<S>` seen from inside `Gen<S>`'s own body - has no
                        // method set of its own, so its parameters are the
                        // candidates the selection tries on it, seen through it
                        // (`unwrap_or(default_value: T)` on an `Option<u8>` takes
                        // a `u8`).  Left without them, every argument of such a
                        // call stays `Unclassified`, and a literal takes its
                        // default width while the parameter states another.
                        mut cands: ArgCandidates = ArgCandidates::new(arg_count);
                        if (!this.collect_on_template(visitor, call, member, base_ref, &cands)) { return []; }
                        return this.agreed_candidate_params(&cands);
                    }
                }
                _ => { break; }
            }
            depth += 1;
        }
        if (base_t == null) { return []; }

        mut found: [MethodInfo*] = [];
        const named: [DeclarationNode*] = this.ctx.decl_index.methods_named(FamilyOwner::Type(base_ref), member.member);
        if (base_t.kind == TypeKind::Class) {
            const ct: ClassType* = base_t.as_class();
            for (mut i: i64 = 0; i < ct.methods.length; i++) {
                const m: MethodInfo* = &ct.methods[i];
                if (DeclarationIndex::holds_method(&named, DeclarationNode::with_shape(m.ast_node)) && m.param_types.length == arg_count) { found.push(m); }
            }
        } else if (base_t.kind == TypeKind::Struct) {
            const st: StructType* = base_t.as_struct();
            for (mut i: i64 = 0; i < st.methods.length; i++) {
                const m: MethodInfo* = &st.methods[i];
                if (DeclarationIndex::holds_method(&named, DeclarationNode::with_shape(m.ast_node)) && m.param_types.length == arg_count) { found.push(m); }
            }
        } else if (base_t.kind == TypeKind::Enum) {
            const et: EnumType* = base_t.as_enum();
            for (mut i: i64 = 0; i < et.methods.length; i++) {
                const m: MethodInfo* = &et.methods[i];
                if (DeclarationIndex::holds_method(&named, DeclarationNode::with_shape(m.ast_node)) && m.param_types.length == arg_count) { found.push(m); }
            }
        } else if (base_t.kind == TypeKind::GenericParam) {
            // A parameter bounded by a WHERE clause rather than inline stays a
            // plain `GenericParam` — its bounds live on the enclosing function
            // or impl node, not on the type — so the receiver cannot answer
            // this and the enclosing bounds must. Left unhandled, every
            // argument of `this.inner.write_from(buf)` under
            // `where S: AsyncTransport` stays `Unclassified` and each consumer
            // guesses its own answer.
            return this.binding.param_types_through_param_bounds(
                base_t.as_generic_param(), member.member, arg_count);
        } else {
            return [];
        }

        if (found.length == 0) { return []; }
        if (found.length == 1) {
            mut single: [TypeRef] = [];
            for (mut i: i64 = 0; i < found[0].param_types.length; i++) {
                single.push(found[0].param_types[i]);
            }
            return single;
        }
        mut merged: [TypeRef] = [];
        for (mut p: i64 = 0; p < arg_count; p++) {
            const first_ty: TypeRef = found[0].param_types[p];
            mut agree: boolean = true;
            for (mut j: i64 = 1; j < found.length; j++) {
                if (!found[j].param_types[p].equals(first_ty)) { agree = false; break; }
            }
            if (agree) { merged.push(first_ty); } else { merged.push(TypeRef::invalid()); }
        }
        return merged;
    }

    /// Enum-variant payload types for a scope callee (`Option::Some`), so args get
    /// proper expected-type hints; consults `expected_type` for the spec when the
    /// template's variants are empty.
    lookup_scope_variant_payload_types(&this, scope: ScopeResolutionNode*) -> [TypeRef] {
        // The enum this variant belongs to is what the qualifier names, and the
        // node already carries the name layer's answer for that segment.  A
        // stamp that makes no type claim names a module, which owns no
        // variant; matching its spelling against the index answered the
        // primitive `f32` for the module `float`.
        // Type arguments written on the qualifier (`Result::<i32, i32>::Ok`)
        // name the instance the call constructs, which
        // `try_resolve_type_or_variant` answers; the variant is the
        // template's, at the same position in every instance, and an
        // instance not yet minted has no variants to ask.
        const type_ref: TypeRef = this.types.scope_qualifier_type(scope);
        if (!type_ref.is_valid()) { return []; }
        // An instance named on the qualifier gives the payload its own
        // arguments, so each argument is typed against what it must be.
        const inst_base: TypeRef = this.types.view_generic_base(type_ref);
        if (inst_base.is_valid()) {
            const base_t: Type* = this.arena.lookup(inst_base);
            if (base_t == null || base_t.kind != TypeKind::Enum) { return []; }
            const bet: EnumType* = base_t.as_enum();
            const bvi: i64 = bet.variant_index(scope.member_name);
            if (bvi < 0) { return []; }
            scope.set_resolved_member(MemberPin::Variant(bvi));
            const inst_args: [TypeRef] = this.types.view_type_args_copy(type_ref);
            return this.substitute_payload_types(bet.variants[bvi].payload_types, inst_base, &inst_args);
        }
        mut enum_t: Type* = this.arena.lookup(type_ref);
        if (enum_t == null) { return []; }
        if (enum_t.kind == TypeKind::Enum) {
            const et: EnumType* = enum_t.as_enum();
            if (et.variants.length == 0 && this.state.expected_type.is_valid()) {
                mut exp_ref: TypeRef = this.state.expected_type;
                mut exp_t: Type* = this.arena.lookup(exp_ref);
                if (exp_t != null && exp_t.kind == TypeKind::TypeAlias) {
                    const alias: TypeAliasType* = exp_t.as_alias();
                    if (alias.has_target()) { exp_ref = alias.target; exp_t = this.arena.lookup(exp_ref); }
                }
                // Generic-identity view, not a raw `kind == InstantiatedType` test:
                // under single-id identity the expected type may already BE the
                // concrete specialization sitting at the former wrapper's id, and
                // a concrete carries its own base + args.
                if (this.types.view_generic_base(exp_ref).equals(type_ref)) {
                    const spec: TypeRef = this.types.view_concrete_of(exp_ref);
                    if (spec.is_valid()) { enum_t = this.arena.lookup(spec); }
                }
            }
        }
        if (enum_t == null || enum_t.kind != TypeKind::Enum) { return []; }
        const et: EnumType* = enum_t.as_enum();
        const vi: i64 = et.variant_index(scope.member_name);
        if (vi < 0) { return []; }
        const variant: EnumVariantInfo* = &et.variants[vi];
        scope.set_resolved_member(MemberPin::Variant(vi));
        if (this.state.expected_type.is_valid()) {
            mut exp_ref2: TypeRef = this.state.expected_type;
            mut exp_t2: Type* = this.arena.lookup(exp_ref2);
            if (exp_t2 != null && exp_t2.kind == TypeKind::TypeAlias) {
                const alias2: TypeAliasType* = exp_t2.as_alias();
                if (alias2.has_target()) { exp_ref2 = alias2.target; exp_t2 = this.arena.lookup(exp_ref2); }
            }
            // Same single-id concern as above: a post-mono concrete expected type
            // still yields its `(generic_base, type_args)` through the view, so a
            // nested construction (`Result::Ok(Option::Some(x))`) gets the
            // SUBSTITUTED payload (`Option<u8>`) pushed as its argument hint
            // instead of falling through to the abstract `T` below.
            if (this.types.view_generic_base(exp_ref2).equals(type_ref)) {
                const exp_args: [TypeRef] = this.types.view_type_args_copy(exp_ref2);
                return this.substitute_payload_types(variant.payload_types, type_ref, &exp_args);
            }
        }
        return sema_copy_type_refs(&variant.payload_types);
    }

    /// Substitute an enum template's generic params with concrete type args in a
    /// payload-type list.
    substitute_payload_types(&this, payload: &[TypeRef], template_ref: TypeRef,
                             type_args: &[TypeRef]) -> [TypeRef] {
        const entry: TemplateEntry* =
            this.ctx.generic_registry.template_of_type(template_ref);
        if (entry == null) { return sema_copy_type_refs(payload); }
        if (entry.param_count != type_args.length) { return sema_copy_type_refs(payload); }
        mut result: [TypeRef] = [];
        for (mut i: i64 = 0; i < payload.length; i++) {
            const pt: Type* = this.arena.lookup(payload[i]);
            if (pt == null) {
                result.push(payload[i]);
            } else if (pt.kind == TypeKind::GenericParam) {
                const gp: GenericParamType* = pt.as_generic_param();
                mut substituted: TypeRef = payload[i];
                for (mut p: i64 = 0; p < entry.param_count; p++) {
                    if (gp.declared_by(entry.param_syms[p])) { substituted = type_args[p]; break; }
                }
                result.push(substituted);
            } else {
                result.push(payload[i]);
            }
        }
        return result;
    }

    /// `call`'s declared parameter types viewed through its OWNER's type
    /// arguments, for expected-type propagation only.  Invalid at every position
    /// needing no substitution, so the caller falls back to the declared type.
    ///
    /// A method or static declared on a generic owner states its formals in the
    /// OWNER's parameters - `Atomic<T>::store(val: T, ..)` - and they arrive at
    /// `resolve_call` unsubstituted, because the signature it reads is the
    /// template's.  The numeric rules there require a CONCRETE numeric slot, so
    /// none of them fire on an abstract `T`: `a.store(1, ..)` leaves the literal
    /// at its i32 default even though the receiver already states the width, and
    /// the caller has to spell it out.
    ///
    /// Deliberately a SEPARATE array rather than a rewrite of `param_types`:
    /// those same types feed `classify_args_from_params`, which derives each
    /// argument's move/borrow classification from them, so substituting in place
    /// would flip classifications for every call on a generic owner in the
    /// program.  Only a substitution the propagation consumes is recorded - an
    /// adoptable numeric type, or an array type an array-literal argument lands
    /// on - so no other consumer of the call's typing can observe this.
    ///
    /// Owner parameters are matched by NAME against the template's declared
    /// list, never by `param_index`: a METHOD-level parameter carries an index
    /// into the method's own list, and reading the owner's argument at that
    /// index would substitute an unrelated type.  A name the owner does not
    /// declare yields no hint, which is what keeps `NlsBox<S>::take<T>(v: T)`
    /// inferring `T` from the argument as before.
    owner_generic_numeric_hints(mut &this, call: CallExprNode*,
                                param_types: &[TypeRef]) -> [TypeRef] {
        mut out: [TypeRef] = [];
        for (mut i: i64 = 0; i < param_types.length; i++) { out.push(TypeRef::invalid()); }
        if (out.length == 0) { return out; }

        mut any_abstract: boolean = false;
        for (mut i: i64 = 0; i < param_types.length; i++) {
            if (param_types[i].is_valid() && this.types.contains_generic_param(param_types[i])) {
                any_abstract = true;
                break;
            }
        }
        if (!any_abstract) { return out; }

        // The owner's (declared params, bound args).  An instance call reads
        // them off the receiver; a static call off the scope's turbofish, which
        // is the only place they are written.
        mut tmpl: TemplateEntry* = null;
        mut owner_args: [TypeRef] = [];
        const callee_node: ASTNode* = call.callee as ASTNode*;
        if (callee_node.kind == NodeKind::MemberAccess) {
            const member: MemberAccessNode* = call.callee as MemberAccessNode*;
            if (member.object == null) { return out; }
            const recv: TypeRef = member.object.resolved_type;
            // Generic-identity view, not a raw kind test: the receiver may be a
            // pre-mono `InstantiatedType` wrapper or a post-mono concrete
            // aggregate, and both answer through it.  Pointer/reference layers
            // are peeled for free.
            const base: TypeRef = this.types.view_generic_base(recv);
            if (!base.is_valid()) { return out; }
            tmpl = this.ctx.generic_registry.template_of_type(base);
            owner_args = this.types.view_type_args_copy(recv);
        } else if (callee_node.kind == NodeKind::ScopeResolution) {
            const sr: ScopeResolutionNode* = call.callee as ScopeResolutionNode*;
            if (sr.scope_generic_args.length == 0) { return out; }
            tmpl = this.lookup_scope_template(
                sr.require_scope_res("scope-call owner template"));
            if (tmpl == null) { return out; }
            mut res_ctx: ResolutionContext = ResolutionContext::new("");
            // `Wrap<u8>::make` - the turbofish is syntax the CALLER wrote, so its
            // bare leaves mean what the caller's module says.
            this.symbolic.symbolic_bind_params(&res_ctx);
            for (mut i: i64 = 0; i < sr.scope_generic_args.length; i++) {
                owner_args.push(this.ctx.type_resolver.resolve(sr.scope_generic_args[i], &res_ctx));
            }
            if (owner_args.length < tmpl.param_count) {
                owner_args = this.ctx.type_resolver.expand_default_type_args(
                    tmpl, owner_args, &res_ctx);
            }
        } else {
            return out;
        }
        if (tmpl == null) { return out; }
        if (tmpl.param_names.length != owner_args.length) { return out; }

        for (mut i: i64 = 0; i < param_types.length; i++) {
            if (!param_types[i].is_valid()) { continue; }
            const pt: Type* = this.arena.lookup(param_types[i]);
            if (pt == null) { continue; }
            if (pt.kind != TypeKind::GenericParam) { continue; }
            const gpt: GenericParamType* = pt.as_generic_param();
            for (mut p: i64 = 0; p < tmpl.param_syms.length; p++) {
                if (!gpt.declared_by(tmpl.param_syms[p])) { continue; }
                // Inside the owner's own template body the argument is still the
                // symbolic parameter, which is not numeric - so the body's own
                // literals keep defaulting, exactly as before.
                if (is_adoptable_numeric_type(this.arena, owner_args[p])
                        || this.array_literal_into_array(call, i, owner_args[p])) {
                    out[i] = owner_args[p];
                }
                break;
            }
        }
        return out;
    }

    /// Whether argument `i` of `call` is an array literal landing on an array
    /// slot.  The literal reads its element type off the slot, and an empty
    /// one has nothing else to read it from: `m.get_or_insert(k, [])` on a
    /// `HashMap<K, [u32]>` is a `[u32]` only through the receiver's
    /// argument, and an argument with no type leaves the call unselected.
    array_literal_into_array(&this, call: CallExprNode*, i: i64, slot: TypeRef) -> boolean {
        if (i >= call.arguments.length || call.arguments[i] == null) { return false; }
        if ((call.arguments[i] as ASTNode*).kind != NodeKind::ArrayLiteral) { return false; }
        const st: Type* = this.arena.lookup(slot);
        return st != null && st.kind == TypeKind::Array;
    }


    // -- The central dispatcher --

    /// Warn on a hand-written `x.drop()`.
    ///
    /// Releasing a value is the compiler's job: it drops every owning local at
    /// scope exit, and it drops an aggregate's fields after the type's own
    /// `drop` body runs.  On a tracked local, `x.drop()` is read as a move by
    /// both drop insertion and the move checker, so it releases once and a
    /// later use is refused - what `mem::drop(x)` does, which says it.  On a
    /// field, the owner's field glue releases the field again, which stays
    /// correct only for as long as every leaf drop nulls what it frees.
    ///
    /// A warning rather than an error while the tree still carries the
    /// hand-written releases that predate field glue; the message says so, so
    /// nobody reads the current tolerance as the rule.
    ///
    /// Emitted from sema, which is the last stage that sees only what the
    /// AUTHOR wrote: DropInsertion's scope-exit drops and codegen's field glue
    /// are both synthesized later, so neither can trip this.
    warn_explicit_drop_call(mut &this, call: CallExprNode*) -> void {
        if (!this.is_explicit_drop_call(call)) { return; }
        mut diag: Diagnostic = Diagnostic::warning(
            ErrorCode::W0015_EXPLICIT_DROP_CALL,
            "explicit destructor call; write `mem::drop(x)` instead. On a local, `x.drop()` releases the value there and ends the local as `mem::drop(x)` does: it is not released again at scope exit, and a later use is refused. On a field, the owner releases the field again when it is released itself. This is a warning while the tree is being cleaned up and will become an error");
        diag = diag.at(call.span);
        this.ctx.emit_diagnostic(diag);
    }

    /// Whether `call` is an explicit destructor call `x.drop()` as written.
    is_explicit_drop_call(mut &this, call: CallExprNode*) -> boolean {
        if (call.arguments.length != 0) { return false; }
        if (call.callee == null || call.callee.kind != NodeKind::MemberAccess) { return false; }
        const ma: MemberAccessNode* = call.callee as MemberAccessNode*;
        return this.ctx.get_generic_registry().names_lang_method(ma.member, LangItem::DropDrop);
    }

    /// A method call whose receiver is a type parameter its bounds did not
    /// type: inside the body declaring it the parameter has only the
    /// methods its bounds give it, so the call names nothing - whether no
    /// bound names the parameter or none of those naming it declares the
    /// method.  An explicit destructor call (`(*p).drop()`) is not one a
    /// bound licenses: its help names the function that runs a pointee's
    /// destructor.
    report_param_receiver_call(mut &this, member: MemberAccessNode*, param: GenericParamType*,
                               bounded: boolean, call: CallExprNode*) -> void {
        const method_name: string = this.intern.resolve(member.member);
        const param_display: string = this.arena.format_generic_param(param);
        const primary_span: SourceSpan = if (member.member_span.has_location()) { member.member_span } else { member.span };
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0358_UNDEFINED_METHOD_IMPL,
            fmt::format("no method named `%s` found on type `%s`", method_name, param_display));
        diag = diag.at(primary_span);
        if (!bounded) {
            diag = diag.with_note(fmt::format(
                "`%s` is a type parameter with no bound, so it has no methods", param_display));
        }
        if (this.is_explicit_drop_call(call)) {
            diag = diag.help(fmt::format("use `std::core::ptr::drop_in_place(%s)`",
                this.pointer_to_receiver_text(member.object)));
        } else {
            diag = diag.help(fmt::format(
                "add a `where %s: Trait` bound naming a trait that declares `%s`", param_display, method_name));
        }
        this.ctx.emit_diagnostic(diag);
    }

    /// The pointer to a destructor call's receiver, as the writer would spell
    /// it: the operand of `(*q).drop()`, the address of `x` in `x.drop()`.
    /// A receiver that is not a name or a field path reads `p`.
    pointer_to_receiver_text(&this, recv: ExpressionNode*) -> string {
        if (recv != null && recv.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = recv as UnaryExprNode*;
            if (u.op.kind == TokenType::Star) {
                const inner: string = this.place_text(u.operand);
                return if (inner.length() > 0) { inner } else { "p" };
            }
        }
        const place: string = this.place_text(recv);
        return if (place.length() > 0) { fmt::format("&%s", place) } else { "p" };
    }

    /// A name or a field path as written (`q`, `this.slot`); empty for any
    /// other expression.
    place_text(&this, e: ExpressionNode*) -> string {
        if (e == null) { return ""; }
        if (e.kind == NodeKind::Identifier) {
            return this.intern.resolve((e as IdentifierNode*).name);
        }
        if (e.kind == NodeKind::MemberAccess) {
            const ma: MemberAccessNode* = e as MemberAccessNode*;
            const base: string = this.place_text(ma.object);
            if (base.length() == 0) { return ""; }
            return fmt::format("%s.%s", base, this.intern.resolve(ma.member));
        }
        return "";
    }

    /// The declaration a free-function call names - a bare call's stamp, or
    /// the member a module-qualified path's stamp binds - or an invalid id
    /// for any other callee.
    family_callee(&this, callee: ExpressionNode*) -> DefId {
        if (callee == null) { return DefId::invalid(); }
        const n: ASTNode* = callee as ASTNode*;
        if (n.kind == NodeKind::Identifier) { return this.callee_def(callee as IdentifierNode*); }
        if (n.kind != NodeKind::ScopeResolution) { return DefId::invalid(); }
        const sr: ScopeResolutionNode* = callee as ScopeResolutionNode*;
        return match (sr.scope_res) {
            ResSlot::Answered(Res::Def(_)) => { sr.member_def }
            _                              => { DefId::invalid() }
        };
    }

    /// The entries of `callee`'s function family - its overloads - read off
    /// the definition's own entry.
    family_entries(&this, callee: DefId) -> [OverloadId] {
        if (!callee.is_valid()) { return []; }
        return this.ctx.decl_index.family_entries_of_def(callee);
    }

    /// The entry a callee whose family is `entries` is when nothing chose
    /// among them: the family's only one.  Invalid for an overloaded family,
    /// which only a selection can pin.
    sole_entry(&this, entries: &[OverloadId]) -> OverloadId {
        if (entries.length != 1) { return OverloadId::invalid(); }
        return entries[0];
    }

    /// `ty`, the type of the value `expr` - a function named by a bare name
    /// or a path - or invalid when the function is `![caller_location]` and
    /// is refused as a value (E0151): it takes its caller's location as
    /// hidden arguments, and a call through the value has none to pass.
    located_value_checked(&this, expr: ExpressionNode*, ty: TypeRef) -> TypeRef {
        if (!ty.is_valid()) { return ty; }
        mut entry: OverloadId = OverloadId::invalid();
        mut template: TypeRef = TypeRef::invalid();
        const n: ASTNode* = expr as ASTNode*;
        if (n.kind == NodeKind::Identifier) {
            const ident: IdentifierNode* = expr as IdentifierNode*;
            entry = ident.resolved_callee.decl_entry();
            template = ident.value_template;
        } else if (n.kind == NodeKind::ScopeResolution) {
            const scope: ScopeResolutionNode* = expr as ScopeResolutionNode*;
            entry = scope.resolved_callee.decl_entry();
            template = scope.value_template;
        }
        mut decl: ASTNode* = null;
        if (entry.is_valid()) {
            decl = this.ctx.decl_index.entry_decl(entry);
        } else if (template.is_valid()) {
            const tm: TemplateEntry* = this.ctx.generic_registry.template_of_type(template);
            if (tm != null) { decl = tm.ast_node; }
        }
        if (!FunctionDecl::caller_located(decl)) { return ty; }
        this.ctx.emit_error_at(ErrorCode::E0151_DIRECTIVE_MISPLACED,
            "a `![caller_location]` function cannot be taken as a value: a call through the value would have no caller location to pass it",
            expr.span);
        return TypeRef::invalid();
    }


    /// The entry of the bare callee's family that a call passing capturing
    /// closures selects, by the one selection a call's arguments make
    /// (`select_family_overload`), each closure argument standing for the
    /// function type it is called as - what the function-typed parameter it
    /// is passed to must be.  Invalid when the call is pinned already,
    /// passes no closure, or no signature accepts it.
    closure_call_entry(mut &this, call: CallExprNode*, ident: IdentifierNode*) -> OverloadId {
        if (call == null || call.resolved_callee.is_some()) { return OverloadId::invalid(); }
        mut arg_types: [TypeRef] = [];
        mut any_closure: boolean = false;
        for (mut ai: i64 = 0; ai < call.arguments.length; ai++) {
            const arg: ExpressionNode* = call.arguments[ai];
            if (arg == null) { return OverloadId::invalid(); }
            const called_as: TypeRef = this.lambda.closure_call_type(arg.resolved_type);
            if (called_as.is_valid()) { any_closure = true; }
            arg_types.push(if (called_as.is_valid()) { called_as } else { arg.resolved_type });
        }
        if (!any_closure) { return OverloadId::invalid(); }
        const entries: [OverloadId] = this.family_entries(this.callee_def(ident));
        if (entries.length == 0) { return OverloadId::invalid(); }
        mut overloads: [TypeRef] = [];
        for (mut ei: i64 = 0; ei < entries.length; ei++) {
            overloads.push(this.ctx.decl_index.entry_signature(entries[ei]));
        }
        const oi: i64 = this.select_family_overload(&overloads, &arg_types);
        if (oi < 0) { return OverloadId::invalid(); }
        return entries[oi];
    }

    /// The parameter types a call of `argc` arguments to an overloaded
    /// family hints its arguments with: at each position, the type every
    /// signature of that arity agrees on, and none where they differ.  A
    /// literal at such a position keeps its own default type - an integer
    /// `i32` - and that is what selects among the signatures, never the
    /// parameter type of whichever signature a lookup met first.  A method
    /// call's arguments are hinted the same way.  Empty for a family with one
    /// signature, or none of that arity, which hints as one declaration does.
    family_param_hints(&this, callee: DefId, argc: i64) -> [TypeRef] {
        const entries: [OverloadId] = this.family_entries(callee);
        mut out: [TypeRef] = [];
        if (entries.length < 2) { return out; }
        mut have: boolean = false;
        for (mut ei: i64 = 0; ei < entries.length; ei++) {
            const t: Type* = this.arena.lookup(this.ctx.decl_index.entry_signature(entries[ei]));
            if (t == null || t.kind != TypeKind::Function) { continue; }
            const ft: FunctionType* = t.as_function();
            if (ft.is_variadic || ft.param_types.length != argc) { continue; }
            if (!have) {
                for (mut p: i64 = 0; p < argc; p++) { out.push(ft.param_types[p]); }
                have = true;
                continue;
            }
            for (mut p: i64 = 0; p < argc; p++) {
                if (!out[p].equals(ft.param_types[p])) { out[p] = TypeRef::invalid(); }
            }
        }
        return out;
    }

    resolve_call(mut &this, visitor: SemaVisitor*, call: CallExprNode*) -> TypeRef {
        // Closure-call rewrite: `f(args)` where `f` is a closure-struct value.
        this.lambda.maybe_rewrite_closure_call(call);
        this.warn_explicit_drop_call(call);

        // Compute the callee's param types for expected-type propagation: an
        // overloaded family's agreed positions, or the one signature a
        // callee has.
        mut param_types: [TypeRef] = this.family_param_hints(
            this.family_callee(call.callee), call.arguments.length);
        if (param_types.length == 0) {
            const callee_fn_type: TypeRef = this.lookup_callee_function_type(call.callee);
            if (callee_fn_type.is_valid()) {
                const ft_raw: Type* = this.arena.lookup(callee_fn_type);
                if (ft_raw != null && ft_raw.kind == TypeKind::Function) {
                    param_types = sema_copy_type_refs(&ft_raw.as_function().param_types);
                }
            }
        }
        // A callee that is no name, path or member is a value the program
        // computes - a call's result, an element.  It is typed once, here,
        // so its parameters hint the arguments and its return types the
        // call below.
        mut computed_type: TypeRef = TypeRef::invalid();
        mut computed_fn: TypeRef = TypeRef::invalid();
        if (!CallResolver::callee_is_named(call.callee)) {
            computed_type = visitor.resolve_expr(call.callee);
            if (this.types.is_function_type(computed_type)) {
                computed_fn = computed_type;
            } else if (this.types.is_function_type(this.types.peel_indirection(computed_type))) {
                computed_fn = this.types.peel_indirection(computed_type);
            }
            if (computed_fn.is_valid() && param_types.length == 0) {
                param_types = sema_copy_type_refs(&this.arena.lookup(computed_fn).as_function().param_types);
            }
        }
        if (param_types.length == 0) {
            const callee_node: ASTNode* = call.callee as ASTNode*;
            if (callee_node.kind == NodeKind::MemberAccess) {
                param_types = this.lookup_method_param_types(
                    visitor, call, call.callee as MemberAccessNode*, call.arguments.length);
            }
        }
        if (param_types.length == 0) {
            const callee_node: ASTNode* = call.callee as ASTNode*;
            if (callee_node.kind == NodeKind::ScopeResolution) {
                param_types = this.lookup_scope_variant_payload_types(call.callee as ScopeResolutionNode*);
            }
        }
        // A scope that names a MODULE rather than a type or enum reaches none of
        // the above: the first two ask for a type-scoped name and the third for
        // an enum variant.  Resolved through the module graph so a namespace
        // written as a suffix (`mem` for `std::core::mem`) is found.
        if (param_types.length == 0) {
            const callee_node: ASTNode* = call.callee as ASTNode*;
            if (callee_node.kind == NodeKind::ScopeResolution) {
                param_types = this.lookup_module_qualified_param_types(
                    call.callee as ScopeResolutionNode*);
            }
        }
        // For an EXPLICIT generic free call (`passthru<i32>(...)`), the param
        // types above came from the template fn type and still carry the
        // template's generic params (e.g. `Option<Option<T>>`).  Substitute the
        // call's explicit type args into them so the expected-type pushed onto
        // each argument is CONCRETE.  Otherwise an enum/array constructor arg
        // would adopt the unbound `T` verbatim, producing a size-0 unresolved
        // argument value that miscompiles (DirectPair `hi` becomes a null
        // operand at codegen).
        // Indices whose formal came from an EXPLICIT turbofish. Those must be
        // pushed as the argument's expected type unconditionally: for a generic
        // callee the argument's own type is what selects the specialization, so
        // the literal-clearing default below (which a non-generic callee
        // survives via the call boundary's integer width coercion) would bind
        // the call to the wrong specialization.
        mut forced_expected: [boolean] = [];
        param_types = this.substitute_explicit_generic_param_types(
            call, &param_types, &forced_expected);

        // A formal stated in a generic OWNER's parameters (`Atomic<T>::store(val: T, ..)`)
        // is abstract here, so every numeric rule below rejects it.  This is the
        // same list viewed through the receiver's / turbofish's type arguments,
        // filled only where that view is a concrete numeric slot; `param_types`
        // itself must stay as declared, because `classify_args_from_params`
        // reads it.  Empty for a non-generic owner.
        const owner_hints: [TypeRef] = this.owner_generic_numeric_hints(call, &param_types);

        const saved_expected: TypeRef = this.state.expected_type;
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            mut push_expected: boolean = false;
            if (i < forced_expected.length && forced_expected[i]) { push_expected = true; }
            const arg: ExpressionNode* = call.arguments[i];
            // The slot this argument actually binds: the owner-substituted view
            // where there is one, the declared type otherwise.
            mut slot: TypeRef = TypeRef::invalid();
            if (i < param_types.length) { slot = param_types[i]; }
            if (i < owner_hints.length && owner_hints[i].is_valid()) { slot = owner_hints[i]; }
            // A slot naming the callee's own parameters (`d: Option<T>`
            // before `T` is inferred) is no type in this body; the argument
            // types itself, and its type is what infers `T`.
            if (slot.is_valid() && this.symbolic.names_param_out_of_scope(slot)) {
                slot = TypeRef::invalid();
                push_expected = false;
            }
            if (arg != null && slot.is_valid()) {
                const arg_node: ASTNode* = arg as ASTNode*;
                if (arg_node.kind == NodeKind::ArrayLiteral) {
                    push_expected = true;
                } else if (arg_node.kind == NodeKind::TupleLiteral) {
                    // Same reason as ArrayLiteral: an aggregate literal needs the
                    // parameter type to hint its ELEMENTS, and
                    // `resolve_tuple_literal` destructures it per position.
                    // Without this the `else` below actively CLEARS the hint, so
                    // a tuple literal in argument position had no hint by
                    // construction and its integer elements defaulted to i32 -
                    // which then relied on a tuple coercion branch in
                    // `check_compatibility` that lowered to the wrong layout.
                    push_expected = true;
                } else if (arg_node.kind == NodeKind::CallExpression
                        || arg_node.kind == NodeKind::ScopeResolution) {
                    push_expected = true;
                } else if (arg_node.kind == NodeKind::StructLiteral) {
                    // A generic struct's literal written without arguments is
                    // the instance the parameter names.
                    push_expected = true;
                } else if (arg_node.kind == NodeKind::Identifier && this.types.is_function_type(slot)) {
                    // A function named as a value takes the overload a
                    // function-typed parameter selects.
                    push_expected = true;
                // A constant numeric expression - negated, or arithmetic over
                // literals - is width-polymorphic exactly like the bare literal
                // handled below, so a concrete slot has to reach the whole
                // expression before its operands settle on a default width.
                // The int side is deliberately narrow: SIGNED for a negation, so
                // `-1` cannot adopt an unsigned slot and turn huge; for the rest,
                // a WIDE slot, or one that holds every value the expression
                // computes on the way (`take_u32(8 * 10000 + 64 * 100)`), as a
                // single literal adopts a slot it fits - one that does not
                // keeps its default width and meets the narrowing check, so a
                // genuine narrowing is still flagged.  Neither hazard
                // exists for a float slot, and a float that misses its slot is
                // not merely imprecise: there is no float width coercion at the
                // call boundary, so an f64-defaulted value reaches an `f32`
                // parameter as a `double` against a `float` signature and the
                // module fails verification with no source location.
                } else if (is_negative_numeric_literal_expr(arg)
                        && (this.literals.is_signed_int_type(slot)
                            || is_narrow_float_type(this.arena, slot))) {
                    push_expected = true;
                } else if ((arg_node.kind == NodeKind::BinaryExpression
                            || arg_node.kind == NodeKind::UnaryExpression)
                        && is_constant_numeric_expr(arg)
                        && !is_negative_numeric_literal_expr(arg)
                        && (is_wide_int_type(this.arena, slot)
                            || is_narrow_float_type(this.arena, slot)
                            || this.literals.const_expr_fits_target(arg, slot))) {
                    push_expected = true;
                } else if (arg_node.kind == NodeKind::Literal
                        && is_adoptable_numeric_type(this.arena, slot)) {
                    // A numeric literal argument adopts the PARAMETER's type, the
                    // same way one adopts a declaration's annotation.  The `else`
                    // below otherwise CLEARS the hint, leaving the literal at its
                    // default width: for floats that is fatal (a bare `1.5` takes
                    // f64 and passes a `double` against a `float` signature, since
                    // unlike integers there is no float coercion at the call
                    // boundary, so `take_f32(1.5)` fails module verification), and
                    // for integers it forces the caller to write the width by hand
                    // - the parameter already states it, so `f(1)` binding a `u64`
                    // slot should not need `f(1u64)`.  Restricted to a concrete
                    // numeric slot: an unresolved generic parameter is a different
                    // type kind, so the argument's own type still selects the
                    // specialization.
                    push_expected = true;
                } else if (this.sema_arg_is_null_literal(arg)
                        && this.types.is_function_type(slot)) {
                    // `null` is typed `void*` and reaches a data-pointer slot
                    // through the universal pointer rule.  A function-pointer
                    // slot is not reachable that way - the conversion between
                    // `void*` and `(A) -> R` is explicit in both directions - so
                    // the literal has to adopt the parameter's type, exactly as
                    // it does at an annotated binding.  Without the hint the
                    // `else` below CLEARS it and an optional callback passed as
                    // a bare `null` is a mismatch.  Narrow on purpose: only the
                    // null literal, only against a concrete function slot, so no
                    // other argument changes which type it takes - in particular
                    // a `null` bound to a `T*` parameter still must not pin `T`.
                    push_expected = true;
                } else if (arg_node.kind == NodeKind::UnaryExpression) {
                    // Address-of-a-literal arg (`&<literal>`) bound to a `&T`
                    // parameter: forward the reference type so `resolve_unary`
                    // hints the referent `T` to the literal. A synthetic
                    // `&<literal>` (operator desugar, e.g. `a * 3` ->
                    // `a.mul(&3)`) then adopts the parameter's width instead of
                    // defaulting to i32 - otherwise codegen spills a too-narrow
                    // temp and the callee's `*rhs` reads uninitialised high
                    // bytes. Scoped to a literal operand so `&place` / `&mut`
                    // argument typing is untouched.
                    const u_arg: UnaryExprNode* = arg as UnaryExprNode*;
                    const pt_ref: Type* = this.arena.lookup(slot);
                    if (u_arg.op.kind == TokenType::Amp && u_arg.operand != null
                        && u_arg.operand.kind == NodeKind::Literal
                        && pt_ref != null && pt_ref.kind == TypeKind::Reference) {
                        push_expected = true;
                    }
                }
            }
            if (push_expected) {
                this.state.expected_type = slot;
            } else {
                this.state.expected_type = TypeRef::invalid();
            }
            visitor.resolve_expr(arg);
        }
        this.state.expected_type = saved_expected;

        this.classify_args_from_params(call, param_types);

        // Type-check a `printf`/`eprintf` call's `%` directives against its
        // variadic arguments now that each argument carries a resolved type.
        this.check_printf_call(call);

        const callee: ExpressionNode* = call.callee;
        const callee_node: ASTNode* = callee as ASTNode*;

        if (callee_node.kind == NodeKind::Identifier) {
            const ident: IdentifierNode* = callee as IdentifierNode*;
            this.lambda.try_specialize_for_closure_args(call, ident, this.closure_call_entry(call, ident));

            const inferred_generic_ret: TypeRef = this.check_generic_free_call(call, ident);

            if (call.resolved_callee.is_some()) {
                // The pin is ground truth: on a re-resolution of an
                // already-pinned call (a match subject is resolved once
                // standalone and once for arm binding), the name-based
                // fallbacks below would re-derive the type from the BARE
                // single-slot maps, which can belong to a different
                // same-leaf declaration (an intrinsic-owned leaf keeps the
                // intrinsic's i64, not the pinned `fs::write`'s Result).
                // A declaration pin answers through its entry's own
                // signature, an instance pin through its copy's.
                mut pinned_ft: TypeRef = TypeRef::invalid();
                match (&call.resolved_callee) {
                    CalleePin::Instance(i) => {
                        pinned_ft = this.ctx.decl_index.entry_signature(this.ctx.decl_index.entry_of_instance(i));
                    }
                    CalleePin::Decl(e) => {
                        pinned_ft = this.ctx.decl_index.entry_signature(e);
                    }
                    _ => { }
                }
                if (pinned_ft.is_valid()) {
                    const pinned_ret: TypeRef = this.overload_return_type(pinned_ft);
                    if (pinned_ret.is_valid()) {
                        // Returning early must not skip `![implicit]`
                        // converter insertion for the pinned signature (a
                        // call pinned outside the normal identifier flow
                        // never reached check_call_arity).  Errorless: the
                        // authoritative arg-check pass owns diagnostics.
                        const pt_raw: Type* = this.arena.lookup(pinned_ft);
                        if (pt_raw != null && pt_raw.kind == TypeKind::Function) {
                            this.apply_implicit_conversions_only(visitor, call,
                                pt_raw.as_function().param_types.as_slice());
                        }
                        return pinned_ret;
                    }
                }
            }
            if (inferred_generic_ret.is_valid()) {
                this.check_generic_free_call_args(visitor, call, ident);
                return inferred_generic_ret;
            }
            if (call.generic_args.length > 0) {
                const spec_tmpl: TemplateEntry* = this.spelling_template(ident.res);
                if (spec_tmpl != null && spec_tmpl.kind == TemplateKind::Function) {
                    // A function template's instance: its placeholder with
                    // the written arguments.
                    const inst: TypeRef = this.resolve_generic_scope_type(
                        spec_tmpl.base_type, &call.generic_args, call.span);
                    if (inst.is_valid()) {
                        call.set_resolved_callee(CalleePin::Instance(inst));
                        const spec_ret: TypeRef = this.instance_return_type(inst);
                        if (spec_ret.is_valid()) { return spec_ret; }
                    }
                }
            }
            // A callee the name layer bound to a local is a value, not a
            // declaration: no overload family to check arity against or to
            // pin, whatever global shares its leaf.
            const callee_is_local: boolean = match (ident.res) {
                ResSlot::Answered(r) => {
                    match (r) {
                        Res::Local(_) => { true }
                        _             => { false }
                    }
                }
                _ => { false }
            };
            if (!callee_is_local) {
                this.check_call_arity(visitor, call, ident);
                const ovl_ret: TypeRef = this.try_pin_overload_mangled_callee(call, ident);
                if (ovl_ret.is_valid() && !this.types.contains_generic_param(ovl_ret)) {
                    return ovl_ret;
                }
            }
            return this.resolve_direct_call(call, ident);
        }
        if (callee_node.kind == NodeKind::MemberAccess) {
            const arg_snap: DiagnosticSnapshot = this.ctx.diagnostics.snapshot();
            this.lambda.reject_closure_struct_args_in_non_free_call(call,
                "passing a capturing closure as a method-call argument");
            const selected: Selection = this.resolve_method_overload(visitor, call, callee as MemberAccessNode*);
            this.check_method_call_arg_types(visitor, call, callee as MemberAccessNode*, selected.chosen);
            this.check_symbolic_method_bounds(callee as MemberAccessNode*, selected.chosen);
            const args_refused: boolean = this.ctx.diagnostics.errors_since(arg_snap) > 0;
            const mret: TypeRef = this.resolve_method_call(visitor, callee as MemberAccessNode*, call,
                                                           selected, args_refused);
            // A pinned non-generic method's return type overrides `mret` for a
            // genuine overload, but NOT when `mret` is a generic method's per-call
            // canonical (scalar or unit) return: there the pin can be a SIBLING
            // spec of a different instantiation, and `mret` is authoritative
            // (`generic_canonical_return`).
            const ovl_pin: OverloadId = call.resolved_callee.decl_entry();
            if (mret.is_valid() && ovl_pin.is_valid()
                    && !this.generic_canonical_return(call, mret)) {
                const ovl_rm_decl: DeclarationNode* = this.ctx.decl_index.entry_method(ovl_pin);
                const ovl_rm: MethodDecl* = DeclarationNode::method_of(ovl_rm_decl);
                if (ovl_rm != null && ovl_rm.func != null
                        && DeclarationNode::fn_of(ovl_rm.func).generic_params.length == 0
                        && DeclarationNode::fn_of(ovl_rm.func).resolved_return_type.is_valid()
                        && !DeclarationNode::fn_of(ovl_rm.func).resolved_return_type.equals(mret)) {
                    const ovl_mem: MemberAccessNode* = callee as MemberAccessNode*;
                    ovl_mem.set_resolved_type(DeclarationNode::fn_of(ovl_rm.func).resolved_return_type);
                    return DeclarationNode::fn_of(ovl_rm.func).resolved_return_type;
                }
            }
            return mret;
        }
        if (callee_node.kind == NodeKind::ScopeResolution) {
            this.lambda.reject_closure_struct_args_in_non_free_call(call,
                "passing a capturing closure to a scope-resolution call");
            // A call whose owner declares the member is checked against its
            // candidates even when none was selected, which is what reports
            // the arguments that selected none.
            mut claimed: boolean = false;
            const scope_ret: TypeRef = this.resolve_scope_call(callee as ScopeResolutionNode*, call, &claimed);
            if (scope_ret.is_valid() || claimed) {
                this.check_scope_call_arg_types(visitor, callee as ScopeResolutionNode*, call);
            }
            this.stash_scope_resolution_call_bindings(call, callee as ScopeResolutionNode*);
            return scope_ret;
        }

        // A computed callee was typed above; a call through a function value
        // has that function's return type, as a call through a local does.
        if (computed_fn.is_valid()) {
            return this.arena.lookup(computed_fn).as_function().return_type;
        }
        if (computed_type.is_valid()) {
            this.refuse_call_of_non_function(call.callee.span, computed_type);
            return TypeRef::invalid();
        }
        return computed_type;
    }

    /// E0213: a call whose callee, written at `callee`, is a value of
    /// `found`, which is no function.  A callee already refused (an error
    /// type) is not reported twice.
    refuse_call_of_non_function(mut &this, callee: SourceSpan, found: TypeRef) -> void {
        const ft: Type* = this.arena.lookup(found);
        if (ft != null && ft.kind == TypeKind::Error) { return; }
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0213_NON_CALLABLE,
            fmt::format("expected function, found `%s`", this.types.type_display_name(found)));
        d = d.at_with_label(callee, "call expression requires function");
        this.ctx.emit_diagnostic(d);
    }

    /// Whether a call's callee is a name, a path or a member - the callees
    /// a declaration is selected for - rather than a value an expression
    /// computes.
    static callee_is_named(callee: ExpressionNode*) -> boolean {
        const kind: NodeKind = (callee as ASTNode*).kind;
        return kind == NodeKind::Identifier
            || kind == NodeKind::ScopeResolution
            || kind == NodeKind::MemberAccess;
    }

    /// Record how each argument binds to the parameter it lands on
    /// (`CallExprNode::bind_arguments`).
    classify_args_from_params(mut &this, call: CallExprNode*, param_types: [TypeRef]) -> void {
        call.bind_arguments(this.arena, &param_types);
    }

    // -- printf/eprintf format-string checking (W0013) --
    //
    // The C variadic ABI does not type-check `printf`-family arguments, so a
    // wrong specifier (`%s` on an integer, a `String` struct on `%s`, a
    // missing or extra argument) is undefined behaviour.  When the format
    // string is a literal we can parse its `%` conversions at compile time
    // and warn on a category or count mismatch before it becomes UB.

    /// Entry point: if `call` names a function whose format is checked
    /// (`checks_format`) - by the declaration its callee is bound to,
    /// whatever name it is written with - and its format is a string
    /// literal, check the format's conversions against the variadic
    /// arguments.
    check_printf_call(mut &this, call: CallExprNode*) -> void {
        const callee: DefId = this.family_callee(call.callee);
        if (!this.checks_format(callee)) { return; }
        if (call.arguments.length == 0) { return; }
        const fmt_arg: ExpressionNode* = call.arguments[0];
        if (fmt_arg == null) { return; }
        const fmt_ast: ASTNode* = fmt_arg as ASTNode*;
        if (fmt_ast.kind != NodeKind::Literal) { return; }   // runtime format: not checkable
        const lit: LiteralNode* = fmt_arg as LiteralNode*;
        if (lit.literal_kind != LiteralKind::String) { return; }
        this.check_printf_directives(call, lit);
    }

    /// Whether `callee` is a function whose calls have their format
    /// checked: the standard library's `printf` and `eprintf`, and the C
    /// `printf` its `libc` module declares - each by the definition that
    /// claimed it.
    checks_format(&this, callee: DefId) -> boolean {
        if (!callee.is_valid()) { return false; }
        const registry: GenericRegistry* = this.ctx.get_generic_registry();
        return callee.equals(registry.wellknown(LangItem::Printf))
            || callee.equals(registry.wellknown(LangItem::Eprintf))
            || callee.equals(registry.wellknown(LangItem::LibcPrintf));
    }

    /// Walk the format string's `%` conversions, checking each against the
    /// corresponding variadic argument, then report a count mismatch.
    check_printf_directives(mut &this, call: CallExprNode*, lit: LiteralNode*) -> void {
        const fmt: string = lit.value;
        const n: i64 = fmt.length() as i64;
        const provided: i64 = call.arguments.length - 1;
        mut arg_idx: i64 = 0;
        mut i: i64 = 0;
        while (i < n) {
            if ((*(fmt + i) as char) != '%') { i += 1; continue; }
            i += 1;
            if (i >= n) { break; }                             // trailing '%'
            if ((*(fmt + i) as char) == '%') { i += 1; continue; }  // %% literal

            // flags
            while (i < n && this.printf_is_flag(*(fmt + i) as char)) { i += 1; }
            // width (a `*` takes an int argument)
            if (i < n && (*(fmt + i) as char) == '*') {
                arg_idx = this.printf_check_arg(call, arg_idx, provided, PF_INT, '*');
                i += 1;
            } else {
                while (i < n && this.printf_is_digit(*(fmt + i) as char)) { i += 1; }
            }
            // precision
            if (i < n && (*(fmt + i) as char) == '.') {
                i += 1;
                if (i < n && (*(fmt + i) as char) == '*') {
                    arg_idx = this.printf_check_arg(call, arg_idx, provided, PF_INT, '*');
                    i += 1;
                } else {
                    while (i < n && this.printf_is_digit(*(fmt + i) as char)) { i += 1; }
                }
            }
            // length modifiers
            while (i < n && this.printf_is_length(*(fmt + i) as char)) { i += 1; }
            if (i >= n) { break; }
            const conv: char = *(fmt + i) as char;
            i += 1;
            const cat: i64 = this.printf_conv_category(conv);
            if (cat == PF_NONE) { continue; }   // unknown conversion: consumes no arg
            arg_idx = this.printf_check_arg(call, arg_idx, provided, cat, conv);
        }

        // Only a shortfall (fewer arguments than conversions) is reported: a
        // missing argument makes `printf` read a garbage value (real UB).
        // An over-count is deliberately not flagged - it would false-positive
        // whenever the format contains an embedded NUL, since a `\0` escape
        // truncates the C string and hides the later conversions.
        // Truncation can only ever undercount conversions, so it
        // never produces a false shortfall.
        if (arg_idx > provided) {
            this.emit_printf_too_few(lit, arg_idx, provided);
        }
    }

    /// Check the argument at variadic position `arg_idx` against a directive
    /// expecting `expected` (skipping when the argument is absent or its type
    /// is unresolved), and return the next position.
    printf_check_arg(mut &this, call: CallExprNode*, arg_idx: i64, provided: i64,
                     expected: i64, conv: char) -> i64 {
        if (arg_idx >= provided) { return arg_idx + 1; }   // missing: counted below
        const arg: ExpressionNode* = call.arguments[1 + arg_idx];
        if (arg == null) { return arg_idx + 1; }
        const actual: i64 = this.printf_arg_category(arg.resolved_type);
        if (actual == PF_NONE) { return arg_idx + 1; }     // unresolved/generic: skip
        if (!this.printf_cat_compatible(expected, actual)) {
            this.emit_printf_type_mismatch(arg, conv, expected, actual);
        }
        return arg_idx + 1;
    }

    /// True when an argument of category `actual` is acceptable for a
    /// directive expecting `expected`. `%s`/`%p` accept either a C string or
    /// a pointer (a `char*` is both); the numeric categories are exact.
    printf_cat_compatible(&this, expected: i64, actual: i64) -> boolean {
        if (expected == PF_INT)     { return actual == PF_INT; }
        if (expected == PF_FLOAT)   { return actual == PF_FLOAT; }
        if (expected == PF_STRING)  { return actual == PF_STRING || actual == PF_POINTER; }
        if (expected == PF_POINTER) { return actual == PF_POINTER || actual == PF_STRING; }
        return false;
    }

    /// A human-readable name for a format category, for diagnostics.
    printf_cat_name(&this, cat: i64) -> string {
        if (cat == PF_INT)     { return "an integer"; }
        if (cat == PF_FLOAT)   { return "a float"; }
        if (cat == PF_STRING)  { return "a C string (`string`)"; }
        if (cat == PF_POINTER) { return "a pointer"; }
        if (cat == PF_STRUCT)  { return "an aggregate (struct/array)"; }
        return "a value";
    }

    printf_is_flag(&this, c: char) -> boolean {
        return c == '-' || c == '+' || c == ' ' || c == '#' || c == '0';
    }

    printf_is_digit(&this, c: char) -> boolean {
        return c >= '0' && c <= '9';
    }

    printf_is_length(&this, c: char) -> boolean {
        return c == 'h' || c == 'l' || c == 'L' || c == 'z' || c == 'j' || c == 't';
    }

    /// The argument category a conversion character expects, or `PF_NONE`
    /// for an unknown conversion (which we assume consumes no argument).
    printf_conv_category(&this, c: char) -> i64 {
        if (c == 'd' || c == 'i' || c == 'u' || c == 'x' || c == 'X'
                || c == 'o' || c == 'c') { return PF_INT; }
        if (c == 'f' || c == 'F' || c == 'e' || c == 'E'
                || c == 'g' || c == 'G' || c == 'a' || c == 'A') { return PF_FLOAT; }
        if (c == 's') { return PF_STRING; }
        if (c == 'p' || c == 'n') { return PF_POINTER; }
        return PF_NONE;
    }

    /// Map a resolved argument type to a format category. `PF_NONE` means the
    /// type can't be judged (unresolved or still generic), so it is skipped.
    printf_arg_category(&this, tref: TypeRef) -> i64 {
        if (!tref.is_valid()) { return PF_NONE; }
        const t: Type* = this.arena.lookup(tref);
        if (t == null) { return PF_NONE; }
        return match (t.kind) {
            TypeKind::Int      => { PF_INT }
            TypeKind::Char     => { PF_INT }
            TypeKind::Bool     => { PF_INT }
            TypeKind::Float    => { PF_FLOAT }
            TypeKind::String   => { PF_STRING }
            TypeKind::Pointer  => { PF_POINTER }
            TypeKind::VaList   => { PF_POINTER }
            TypeKind::Struct   => { PF_STRUCT }
            TypeKind::Class    => { PF_STRUCT }
            TypeKind::Enum     => { PF_STRUCT }
            TypeKind::Array    => { PF_STRUCT }
            TypeKind::Tuple    => { PF_STRUCT }
            TypeKind::Optional => { PF_STRUCT }
            _                  => { PF_NONE }
        };
    }

    emit_printf_type_mismatch(mut &this, arg: ExpressionNode*, conv: char,
                              expected: i64, actual: i64) -> void {
        mut d: Diagnostic = Diagnostic::warning(
            ErrorCode::W0013_FORMAT_STRING_MISMATCH,
            fmt::format("`%%%c` expects %s, but this argument is %s",
                conv as i64, this.printf_cat_name(expected), this.printf_cat_name(actual)));
        d = d.at(arg.span);
        if (actual == PF_STRUCT && expected == PF_STRING) {
            d = d.with_note("`%s` needs a C `string` (`i8*`); `Str`/`String` are length-prefixed structs, not NUL-terminated pointers");
            d = d.help("format via an f-string instead, e.g. `println(f\"{value}\")`, or pass `value.as_ptr()` / `value.with_null()`");
        }
        this.ctx.emit_diagnostic(d);
    }

    emit_printf_too_few(mut &this, lit: LiteralNode*,
                        expected: i64, provided: i64) -> void {
        mut d: Diagnostic = Diagnostic::warning(
            ErrorCode::W0013_FORMAT_STRING_MISMATCH,
            fmt::format("format string needs %lld argument(s), but only %lld were provided",
                expected, provided));
        d = d.at(lit.span);
        d = d.with_note("a `%` conversion with no matching argument reads a garbage value at runtime");
        this.ctx.emit_diagnostic(d);
    }


    // -- Generic free-call inference (the keystone) --

    /// The generic function template a bare call names, or null.
    ///
    /// ONE question, asked of the stamp: a `Def` names one declaration and the
    /// registry is keyed by that canonical name (`lookup_scope_template`).  A
    /// local is never a template, so a fn-pointer variable shadowing a
    /// same-leaf generic global names none here - which is what lets the
    /// local win the call.  There is no search by leaf beneath this: the
    /// registry spans the whole program, and a leaf-and-arity scan picked
    /// between same-named generics by the ambient cursor's module and then by
    /// import visibility, both of which the stamp already accounts for.
    ///
    /// The stamp names one definition of the callee's family, and an
    /// overloaded name has several: the call's is the one its arity admits,
    /// read off the family (the member-function door, by the definition's
    /// owner and leaf).  A template whose parameter count differs from the
    /// call's is not this call's template: generic inference would otherwise
    /// proceed on a mismatched count and return a type, and the arity
    /// diagnostic that the non-generic path reports would never run.  Two
    /// declarations of the call's arity are for the overload selection to
    /// tell apart, and name no template here.
    find_fn_template_for_call(&this, ident: IdentifierNode*, argc: i64) -> TemplateEntry* {
        // The name layer answers every bare callee - a binding, or `Err`
        // for one it refused - so a slot with no answer is a defect the door
        // records; measured at 0 over the corpus before the door went in.
        const r: Res = ident.res.require("call_resolver:free-call template");
        const t: TemplateEntry* = this.lookup_scope_template(r);
        if (t == null || t.kind != TemplateKind::Function) { return null; }
        const entries: [OverloadId] = this.family_entries(r.def_id());
        mut fits: DeclarationNode* = null;
        mut count: i64 = 0;
        for (mut i: i64 = 0; i < entries.length; i++) {
            const d: ASTNode* = this.ctx.decl_index.entry_decl(entries[i]);
            if (d == null || DeclarationNode::fn_of(d) == null) { continue; }
            const f_decl: DeclarationNode* = DeclarationNode::with_shape(d);
            const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
            if (f.parameters.length != argc) { continue; }
            fits = f_decl;
            count = count + 1;
        }
        if (count != 1) { return null; }
        const chosen: TemplateEntry* = this.ctx.generic_registry.template_of(DeclarationNode::fn_of(fits).def);
        if (chosen == null || chosen.kind != TemplateKind::Function) { return null; }
        return chosen;
    }

    /// A bare / negated / arithmetic-constant numeric literal is polymorphic for
    /// generic inference (adopts whatever a non-literal arg or context binds).
    sema_arg_is_polymorphic_literal(&this, expr: ExpressionNode*) -> boolean {
        if (expr == null) { return false; }
        // A written-down type suffix is not a default to be adopted: it is the
        // argument's type, and it is the ONLY signal available where the callee's
        // type parameter is reachable from no other argument or context
        // (`ident(7u64)`).  Skipping it here bound the parameter to the
        // magnitude default instead, silently returning a wrong answer.
        if (sema_expr_has_numeric_suffix(expr)) { return false; }
        const node: ASTNode* = expr as ASTNode*;
        if (node.kind == NodeKind::Literal) {
            const lit: LiteralNode* = expr as LiteralNode*;
            return lit.literal_kind == LiteralKind::Integer || lit.literal_kind == LiteralKind::Float;
        }
        if (node.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = expr as UnaryExprNode*;
            if (u.op.kind == TokenType::Minus || u.op.kind == TokenType::Plus || u.op.kind == TokenType::Tilde) {
                return this.sema_arg_is_polymorphic_literal(u.operand);
            }
            return false;
        }
        if (node.kind == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = expr as BinaryExprNode*;
            const op: TokenType = b.op.kind;
            const is_arith: boolean =
                op == TokenType::Plus || op == TokenType::Minus || op == TokenType::Star || op == TokenType::Slash || op == TokenType::Percent
                || op == TokenType::LessLess || op == TokenType::GreaterGreater || op == TokenType::Amp || op == TokenType::Pipe || op == TokenType::Caret;
            if (!is_arith) { return false; }
            return this.sema_arg_is_polymorphic_literal(b.left)
                && this.sema_arg_is_polymorphic_literal(b.right);
        }
        return false;
    }

    /// A `null` literal argument carries NO pointee-type information: it adopts
    /// whatever pointer type the call site binds.  It must not constrain a
    /// generic owner/param during inference.  `null` is typed `void*`, so
    /// unifying a `T*` parameter against it would wrongly pin `T = void`
    /// (e.g. `Slice<MethodInfo>::from_raw(null, 0)` overriding the explicit
    /// `<MethodInfo>` turbofish, monomorphizing `Slice<void>` and emitting an
    /// invalid `getelementptr(void, ..)` that crashes LLVM instruction selection).
    sema_arg_is_null_literal(&this, expr: ExpressionNode*) -> boolean {
        if (expr == null) { return false; }
        const node: ASTNode* = expr as ASTNode*;
        if (node.kind != NodeKind::Literal) { return false; }
        return (expr as LiteralNode*).literal_kind == LiteralKind::Null;
    }

    /// True when `t` bottoms out fully concrete (no open generic/bounded param,
    /// not void/unit) - mirrors mono's `infer_type_is_concrete` for the E0214 gate.
    free_infer_type_concrete(&this, t: TypeRef) -> boolean {
        if (!t.is_valid()) { return false; }
        const ty: Type* = this.arena.lookup(t);
        if (ty == null) { return false; }
        if (ty.kind == TypeKind::GenericParam)     { return false; }
        if (ty.kind == TypeKind::FunctionTemplate) { return false; }
        if (ty.kind == TypeKind::Function)         { return false; }
        if (ty.kind == TypeKind::Unit)             { return false; }
        if (ty.kind == TypeKind::Void)             { return false; }
        if (ty.kind == TypeKind::Pointer)   { return this.free_infer_type_concrete(ty.as_pointer().pointee); }
        if (ty.kind == TypeKind::Reference) { return this.free_infer_type_concrete(ty.as_reference().referent); }
        if (ty.kind == TypeKind::Array)     { return this.free_infer_type_concrete(ty.as_array().element); }
        if (ty.kind == TypeKind::Optional)  { return this.free_infer_type_concrete(ty.as_optional().wrapped); }
        if (ty.kind == TypeKind::InstantiatedType) {
            if (!ty.as_instantiated().has_resolved_type()) { return false; }
        }
        return true;
    }

    /// Whether a polymorphic numeric literal can adopt the concrete binding `bnd`
    /// already pinned for its generic param (any numeric / enum binding; not str/bool/struct).
    literal_adopts_binding(&this, bnd: TypeRef) -> boolean {
        if (!bnd.is_valid()) { return false; }
        const ty: Type* = this.arena.lookup(bnd);
        if (ty == null) { return false; }
        return ty.kind == TypeKind::Int || ty.kind == TypeKind::Float || ty.kind == TypeKind::Enum;
    }

    /// Whether a call argument's `resolved_type` is authoritative enough pre-mono
    /// to drive an inference conflict / bound error.
    ///
    /// Inside a template body an abstract call type is not provisional - it IS
    /// this walk's answer, and nothing before mono sharpens it. `this.pump(n)`
    /// in `implement struct PConn<S>` is `PConn$pump$Future<S>`, and refusing it
    /// left the ENCLOSING call's parameters unbound, so
    /// `Futures::timeout(d, this.pump(n))` resolved to nothing at all inside a
    /// generic impl. Outside a symbolic walk the old rule stands: a generic
    /// param in a concrete body's call type means inference has not finished.
    ///
    /// This only decides whether the argument may BIND. Both callers gate their
    /// conflict report on `free_infer_type_concrete` for each side separately,
    /// so admitting an abstract type here cannot turn into a spurious E0214.
    free_infer_arg_reliable(&this, arg: ExpressionNode*) -> boolean {
        if (arg == null) { return false; }
        const node: ASTNode* = arg as ASTNode*;
        if (node.kind == NodeKind::CallExpression) {
            if (!arg.resolved_type.is_valid()) { return false; }
            if (this.state.in_symbolic_check) { return true; }
            return !this.types.contains_generic_param(arg.resolved_type);
        }
        return true;
    }

    /// Pre-mono call-site analysis + the mono-after-sema keystone: infer a generic
    /// free call's type args from its arguments (or turbofish), emit E0214/E0306/
    /// E0307, stash the bindings, and return the CONCRETE substituted return type.
    /// Invalid when not a generic free call, a binding stays abstract, or a
    /// diagnostic fired.  `resolved_callee` is left unpinned (mono specializes).

    check_generic_free_call(mut &this, call: CallExprNode*, ident: IdentifierNode*) -> TypeRef {
        const entry: TemplateEntry* = this.find_fn_template_for_call(ident, call.arguments.length);
        if (entry == null) { return TypeRef::invalid(); }
        const tmpl_decl: DeclarationNode* = DeclarationNode::with_shape(entry.ast_node);
        const tmpl: FunctionDecl* = DeclarationNode::fn_of(tmpl_decl);
        if (tmpl == null) { return TypeRef::invalid(); }
        if (entry.param_types.length == 0) { return TypeRef::invalid(); }
        // Record WHICH template won, not just the type args: only sema has the
        // caller's import scope, so mono can't re-derive this choice.
        call.set_resolved_template(entry.base_type);

        mut bindings: [TypeRef] = [];
        for (mut i: i64 = 0; i < entry.param_types.length; i++) { bindings.push(TypeRef::invalid()); }

        if (call.generic_args.length > 0) {
            mut rc: ResolutionContext = ResolutionContext::new("");
            this.symbolic.symbolic_bind_params(&rc);
            mut n: i64 = call.generic_args.length;
            if (n > bindings.length) { n = bindings.length; }
            for (mut i: i64 = 0; i < n; i++) {
                const tr: TypeRef = this.ctx.type_resolver.resolve(call.generic_args[i], &rc);
                if (tr.is_valid()) { bindings[i] = tr; }
            }
        } else {
            if (tmpl.parameters.length != call.arguments.length) { return TypeRef::invalid(); }
            mut pids: [TypeRef] = [];
            for (mut i: i64 = 0; i < entry.param_types.length; i++) { pids.push(entry.param_types[i]); }
            mut ictx: InferCtx = InferCtx::for_template(this.arena, pids);

            // PASS A - non-literal args; reject two concrete actuals for one T (E0214).
            for (mut i: i64 = 0; i < call.arguments.length; i++) {
                const param_decl: DeclarationNode* = tmpl.parameters[i];
                const param: VarDecl* = DeclarationNode::var_of(param_decl);
                if (param == null || !param.resolved_type.is_valid()) { continue; }
                const arg: ExpressionNode* = call.arguments[i];
                if (this.sema_arg_is_polymorphic_literal(arg)) { continue; }
                if (this.bind_from_variant_payload(&ictx, param.resolved_type, arg)) { continue; }
                if (!this.free_infer_arg_reliable(arg)) { continue; }
                const actual: TypeRef = arg.resolved_type;
                if (!actual.is_valid()) { continue; }
                ictx.conflict_from = TypeRef::invalid();
                ictx.conflict_to   = TypeRef::invalid();
                ictx.unify(param.resolved_type, actual);
                if (ictx.conflict_from.is_valid() && ictx.conflict_to.is_valid()
                        && this.free_infer_type_concrete(ictx.conflict_from)
                        && this.free_infer_type_concrete(ictx.conflict_to)) {
                    this.emit_free_infer_conflict(call, tmpl.name, arg, ictx.conflict_from, ictx.conflict_to);
                    return TypeRef::invalid();
                }
            }
            // PASS D first for what the arguments bound: a param a where-bound
            // projects is what the bound requires, which the expected type
            // below must not decide instead.
            this.project_where_bound_params(tmpl_decl, entry, &ictx);
            // PASS B - recover unbound params from a CONCRETE expected type.
            if (this.state.expected_type.is_valid() && tmpl.resolved_return_type.is_valid()
                    && !this.types.contains_generic_param(this.state.expected_type)) {
                mut any_unbound: boolean = false;
                for (mut i: i64 = 0; i < ictx.bindings.length; i++) {
                    if (!ictx.bindings[i].is_valid()) { any_unbound = true; break; }
                }
                if (any_unbound) { ictx.unify(tmpl.resolved_return_type, this.state.expected_type); }
            }
            // PASS C - literal fallback (a polymorphic literal adopts a pinned numeric T).
            for (mut i: i64 = 0; i < call.arguments.length; i++) {
                const param_decl: DeclarationNode* = tmpl.parameters[i];
                const param: VarDecl* = DeclarationNode::var_of(param_decl);
                if (param == null || !param.resolved_type.is_valid()) { continue; }
                const arg: ExpressionNode* = call.arguments[i];
                if (!this.sema_arg_is_polymorphic_literal(arg)) { continue; }
                const lit_actual: TypeRef = arg.resolved_type;
                if (!lit_actual.is_valid()) { continue; }
                const f_idx: i64 = ictx.binding_index(param.resolved_type);
                if (f_idx >= 0 && ictx.bindings[f_idx].is_valid()) {
                    const bnd: TypeRef = ictx.bindings[f_idx];
                    if (this.free_infer_type_concrete(bnd) && !this.literal_adopts_binding(bnd)) {
                        this.emit_free_infer_conflict(call, tmpl.name, arg, bnd, lit_actual);
                        return TypeRef::invalid();
                    }
                    continue;
                }
                ictx.unify(param.resolved_type, lit_actual);
            }
            // PASS D - fill a param that appears only in a where-bound (the `R`
            // in `where F: Future<R>`) by projecting it off the now-bound subject
            // (`R = F::Output`), so a return-only bound param resolves from the
            // arguments alone - no turbofish or expected-type context required.
            this.project_where_bound_params(tmpl_decl, entry, &ictx);

            for (mut i: i64 = 0; i < bindings.length; i++) { bindings[i] = ictx.bindings[i]; }

            mut all_bound: boolean = true;
            for (mut i: i64 = 0; i < bindings.length; i++) {
                if (!bindings[i].is_valid()) { all_bound = false; break; }
            }
            if (!all_bound) {
                if (tmpl.is_implicit && call.arguments.length == 0 && !this.state.expected_type.is_valid()) {
                    this.emit_free_cannot_infer(call, tmpl.name);
                }
                return TypeRef::invalid();
            }
        }

        // E0306 - where-clause bound satisfaction for the bound type args.
        if (!this.check_call_where_bounds(call.span, tmpl_decl, &entry.param_syms, &bindings)) {
            return TypeRef::invalid();
        }

        // KEYSTONE: stash all-bound bindings + substitute into the template return.
        mut all_bound_stash: boolean = bindings.length == entry.param_types.length;
        for (mut ci: i64 = 0; ci < bindings.length && all_bound_stash; ci++) {
            if (!bindings[ci].is_valid()) { all_bound_stash = false; }
        }
        if (all_bound_stash) {
            mut stash: [TypeRef] = [];
            for (mut ci: i64 = 0; ci < bindings.length; ci++) { stash.push(bindings[ci]); }
            call.set_resolved_type_args(stash);
            this.retype_variant_arguments(call, tmpl_decl, entry, &bindings);
        }
        return this.subst_free_call_return(entry, &bindings, tmpl.resolved_return_type);
    }

    /// The type a construction by value (`Cell(4)`, `Cell::<i32>(4)`) makes:
    /// for a generic type, the instance its written type arguments name, else
    /// the one the expected type names, else the one its constructor's
    /// arguments bind.  The template itself is no value's type - it has no
    /// constructor code generation can call.  Any other type is `ty` itself.
    construction_instance(mut &this, call: CallExprNode*, ty: TypeRef) -> TypeRef {
        const tmpl: TemplateEntry* = this.ctx.generic_registry.template_of_type(ty);
        if (tmpl == null || !tmpl.base_type.equals(ty)) { return ty; }
        if (call.generic_args.length > 0) {
            return this.demanded_scope_type(ty, &call.generic_args, call.span);
        }
        const expected: TypeRef = this.promote_to_expected_instantiation(ty);
        if (!expected.equals(ty)) { return expected; }
        return this.instance_from_constructor_args(call, tmpl, ty);
    }

    /// The instance of the generic class `ty` that a construction's arguments
    /// bind, inferred as a generic function call's type arguments are: from
    /// the arguments whose types are known first, then a literal's own type
    /// for a parameter nothing else binds.  `ty` itself when the class has no
    /// single constructor taking that many arguments, or a type parameter
    /// stays unbound.
    instance_from_constructor_args(mut &this, call: CallExprNode*, tmpl: TemplateEntry*, ty: TypeRef) -> TypeRef {
        if (tmpl.kind != TemplateKind::Class || tmpl.ast_node == null) { return ty; }
        if (tmpl.param_types.length == 0) { return ty; }
        const cd: ClassDeclNode* = tmpl.ast_node as ClassDeclNode*;
        mut ctor: DeclarationNode* = null;
        for (mut i: i64 = 0; i < cd.methods.length; i++) {
            const m_decl: DeclarationNode* = cd.methods[i];
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m == null || !m.is_constructor || m.func == null) { continue; }
            if (CallResolver::non_receiver_count(m.func) != call.arguments.length) { continue; }
            if (ctor != null) { return ty; }
            ctor = m.func;
        }
        if (ctor == null) { return ty; }
        mut params: [VarDecl*] = [];
        for (mut j: i64 = 0; j < DeclarationNode::fn_of(ctor).parameters.length; j++) {
            const p_decl: DeclarationNode* = DeclarationNode::fn_of(ctor).parameters[j];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p != null && !p.is_receiver()) { params.push(p); }
        }
        mut pids: [TypeRef] = [];
        for (mut i: i64 = 0; i < tmpl.param_types.length; i++) { pids.push(tmpl.param_types[i]); }
        mut ictx: InferCtx = InferCtx::for_template(this.arena, pids);
        for (mut i: i64 = 0; i < params.length; i++) {
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null || !params[i].resolved_type.is_valid() || !arg.resolved_type.is_valid()) { continue; }
            if (this.sema_arg_is_polymorphic_literal(arg) || !this.free_infer_arg_reliable(arg)) { continue; }
            ictx.unify(params[i].resolved_type, arg.resolved_type);
        }
        for (mut i: i64 = 0; i < params.length; i++) {
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null || !params[i].resolved_type.is_valid() || !arg.resolved_type.is_valid()) { continue; }
            if (!this.sema_arg_is_polymorphic_literal(arg)) { continue; }
            const f_idx: i64 = ictx.binding_index(params[i].resolved_type);
            if (f_idx >= 0 && ictx.bindings[f_idx].is_valid()) { continue; }
            ictx.unify(params[i].resolved_type, arg.resolved_type);
        }
        mut bindings: [TypeRef] = [];
        for (mut i: i64 = 0; i < ictx.bindings.length; i++) {
            if (!ictx.bindings[i].is_valid()) { return ty; }
            bindings.push(ictx.bindings[i]);
        }
        return this.ctx.generic_registry.instantiate(ty, &bindings);
    }

    /// How many parameters `f` takes besides its receiver.
    static non_receiver_count(f_decl: DeclarationNode*) -> i64 {
        const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
        mut n: i64 = 0;
        for (mut i: i64 = 0; i < f.parameters.length; i++) {
            const p_decl: DeclarationNode* = f.parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p != null && !p.is_receiver()) { n += 1; }
        }
        return n;
    }

    /// The path naming a variant when `arg` is one - `E::V` or `E::V(..)` -
    /// and null for any other argument.
    static variant_scope_of(arg: ExpressionNode*) -> ScopeResolutionNode* {
        mut scope: ScopeResolutionNode* = null;
        if (arg.kind == NodeKind::ScopeResolution) {
            scope = arg as ScopeResolutionNode*;
        } else if (arg.kind == NodeKind::CallExpression) {
            const callee: ExpressionNode* = (arg as CallExprNode*).callee;
            if (callee != null && callee.kind == NodeKind::ScopeResolution) {
                scope = callee as ScopeResolutionNode*;
            }
        }
        if (scope == null) { return null; }
        return match (scope.resolved_member) {
            MemberPin::Variant(_) => { scope }
            _                     => { null }
        };
    }

    /// Bind what a variant argument's payload says about a generic call's
    /// parameters.  A variant call typed as its generic enum - its payload
    /// binds only the parameters that variant carries, so `Result::Ok(1)`
    /// stays `Result` - is no binding as a whole, but its payload is:
    /// `Ok(1)` makes the enum's `T` an `i32`, so for `r: Result<T, E>` the
    /// call's `T` is `i32` and its `E` is left to the other arguments.
    /// True when `arg` is such a variant, whatever its payload bound: the
    /// enum's own parameters, which its type still carries, are no binding.
    bind_from_variant_payload(&this, ictx: mut &InferCtx, param_ty: TypeRef, arg: ExpressionNode*) -> boolean {
        if (arg.kind != NodeKind::CallExpression || !arg.resolved_type.is_valid()) { return false; }
        const scope: ScopeResolutionNode* = CallResolver::variant_scope_of(arg);
        if (scope == null) { return false; }
        const enum_tmpl: TemplateEntry* = this.ctx.generic_registry.template_of_type(arg.resolved_type);
        if (enum_tmpl == null || !enum_tmpl.base_type.equals(arg.resolved_type)) { return false; }
        if (!this.arena.inst_generic_base(param_ty).equals(enum_tmpl.base_type)) { return false; }
        const et: Type* = this.arena.lookup(enum_tmpl.base_type);
        if (et == null || et.kind != TypeKind::Enum) { return false; }
        const variant: i64 = match (scope.resolved_member) {
            MemberPin::Variant(v) => { v }
            _                     => { -1 }
        };
        const variants: &[EnumVariantInfo] = &et.as_enum().variants;
        if (variant < 0 || variant >= variants.length) { return true; }
        const payload: &[TypeRef] = &variants[variant].payload_types;
        const call: CallExprNode* = arg as CallExprNode*;
        if (payload.length != call.arguments.length) { return true; }
        mut enum_params: [TypeRef] = [];
        for (mut i: i64 = 0; i < enum_tmpl.param_types.length; i++) { enum_params.push(enum_tmpl.param_types[i]); }
        mut ectx: InferCtx = InferCtx::for_template(this.arena, enum_params);
        for (mut k: i64 = 0; k < payload.length; k++) {
            const a: ExpressionNode* = call.arguments[k];
            if (a == null || !a.resolved_type.is_valid() || this.types.contains_generic_param(a.resolved_type)) {
                continue;
            }
            ectx.unify(payload[k], a.resolved_type);
        }
        if (this.arena.inst_type_arg_count(param_ty) != ectx.bindings.length) { return true; }
        for (mut j: i64 = 0; j < ectx.bindings.length; j++) {
            if (ectx.bindings[j].is_valid()) {
                ictx.unify(this.arena.inst_type_arg_at(param_ty, j), ectx.bindings[j]);
            }
        }
        return true;
    }

    /// A variant written as an argument types itself from its own payload,
    /// which binds only the parameters that variant carries:
    /// `Result::Ok(4)` for `r: Result<T, T>` leaves `E` of the enum unbound
    /// and stays the generic enum, which has no layout.  Once the call's
    /// bindings are known the argument is the parameter's instance, and it
    /// takes that type.  An argument some other source already typed as an
    /// instance is left as it is.
    retype_variant_arguments(mut &this, call: CallExprNode*, tmpl_decl: DeclarationNode*,
                             entry: TemplateEntry*, bindings: &[TypeRef]) -> void {
        const tmpl: FunctionDecl* = DeclarationNode::fn_of(tmpl_decl);
        if (tmpl.parameters.length != call.arguments.length) { return; }
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            const arg: ExpressionNode* = call.arguments[i];
            const param_decl: DeclarationNode* = tmpl.parameters[i];
            const param: VarDecl* = DeclarationNode::var_of(param_decl);
            if (arg == null || param == null || !arg.has_resolved_type()) { continue; }
            const scope: ScopeResolutionNode* = CallResolver::variant_scope_of(arg);
            if (scope == null) { continue; }
            const arg_tmpl: TemplateEntry* = this.ctx.generic_registry.template_of_type(arg.resolved_type);
            if (arg_tmpl == null || !arg_tmpl.base_type.equals(arg.resolved_type)) { continue; }
            const want: TypeRef = this.subst_free_call_return(entry, bindings, param.resolved_type);
            if (!want.is_valid() || this.types.contains_generic_param(want)) { continue; }
            if (!this.ctx.decl_index.def_of(want, this.ctx.type_arena)
                    .equals(this.ctx.decl_index.def_of(arg.resolved_type, this.ctx.type_arena))) { continue; }
            arg.set_resolved_type(want);
            scope.set_resolved_type(want);
        }
    }

    /// When `call` is an EXPLICIT generic free call (`f<i32>(...)` on a bare
    /// identifier), substitute the explicit type args into `param_types` in
    /// place so expected-type propagation pushes concrete argument types.
    /// No-op when the callee isn't an identifier, has no explicit generic args,
    /// names no function template, or any binding fails to resolve.
    substitute_explicit_generic_param_types(mut &this, call: CallExprNode*,
                                            param_types: &[TypeRef],
                                            forced: mut &[boolean]) -> [TypeRef] {
        mut out: [TypeRef] = sema_copy_type_refs(param_types);
        for (mut i: i64 = 0; i < out.length; i++) { forced.push(false); }
        if (out.length == 0) { return out; }
        const callee_node: ASTNode* = call.callee as ASTNode*;
        // A METHOD call carries its turbofish on the MemberAccess
        // (`b.queue<u8>(0x42)`), not on the call node, so the identifier path
        // below never sees one.  It needs the same substitution and for the
        // same reason: leaving the formal `data: T` abstract pushes no expected
        // type onto the argument, so a bare integer literal keeps its `i32`
        // default -- and a wrongly typed argument then resolves the call to a
        // SIBLING instantiation of the same method rather than the one the
        // turbofish named.
        if (callee_node.kind == NodeKind::MemberAccess) {
            return this.substitute_explicit_method_param_types(call, &out, forced);
        }
        if (callee_node.kind == NodeKind::ScopeResolution) {
            return this.substitute_explicit_path_param_types(call, &out, forced);
        }
        if (call.generic_args.length == 0) { return out; }
        if (callee_node.kind != NodeKind::Identifier) { return out; }
        const ident: IdentifierNode* = call.callee as IdentifierNode*;
        const entry: TemplateEntry* = this.find_fn_template_for_call(
            ident, call.arguments.length);
        if (entry == null || entry.param_types.length == 0) { return out; }

        mut bindings: [TypeRef] = [];
        for (mut i: i64 = 0; i < entry.param_types.length; i++) { bindings.push(TypeRef::invalid()); }
        mut rc: ResolutionContext = ResolutionContext::new("");
        this.symbolic.symbolic_bind_params(&rc);
        mut n: i64 = call.generic_args.length;
        if (n > bindings.length) { n = bindings.length; }
        for (mut i: i64 = 0; i < n; i++) {
            const tr: TypeRef = this.ctx.type_resolver.resolve(call.generic_args[i], &rc);
            if (tr.is_valid()) { bindings[i] = tr; }
        }
        for (mut i: i64 = 0; i < bindings.length; i++) {
            if (!bindings[i].is_valid()) { return out; }
        }

        mut subst: TypeSubstitution = TypeSubstitution::from_params(entry.param_types, bindings);
        for (mut pi: i64 = 0; pi < out.length; pi++) {
            if (!out[pi].is_valid()) { continue; }
            if (!this.types.contains_generic_param(out[pi])) { continue; }
            const sub: TypeRef = subst.apply(out[pi], this.arena);
            if (sub.is_valid() && !this.types.contains_generic_param(sub)) {
                out[pi] = sub;
                if (pi < forced.length) { forced[pi] = true; }
            }
        }
        return out;
    }

    /// Substitute a METHOD call's explicit turbofish (`recv.m<u8>(x)`) into the
    /// method's formal parameter types, so expected-type propagation pushes a
    /// CONCRETE type onto each argument.
    ///
    /// Without it a polymorphic integer literal never learns the type the
    /// turbofish named and falls back to `i32`, which does not match any
    /// parameter shape of the intended specialization; the call then binds to
    /// whichever sibling specialization of the same method the argument's type
    /// happens to select, and the literal is passed in THAT spec's parameter
    /// shape. That is a silent miscompile rather than a diagnostic: a
    /// `queue<u8>(0x42)` bound to `queue<Slice<u8>>` hands the callee 66 as a
    /// pointer.
    ///
    /// No-op unless the callee is a member access carrying a full-arity
    /// turbofish for a locatable generic method whose args all resolve
    /// concretely — every miss leaves the caller's types untouched.
    /// The path form of the method rule above: `(BetaG for NgTf)::go::<u8>(&g, 7)`
    /// names a generic method whose formal `u: U` is `u8` at this call, and
    /// left abstract it pushes no expected type, so the literal keeps its
    /// `i32` default and no signature accepts it where the call is written.
    /// The formals are the owner's method's, with its own parameters bound
    /// from the turbofish (`static_entry_params`), for the one generic method
    /// of the family - an impl head's trait's, under one - that the
    /// turbofish and the argument count admit.
    substitute_explicit_path_param_types(mut &this, call: CallExprNode*,
                                         param_types: &[TypeRef],
                                         forced: mut &[boolean]) -> [TypeRef] {
        mut out: [TypeRef] = sema_copy_type_refs(param_types);
        const scope: ScopeResolutionNode* = call.callee as ScopeResolutionNode*;
        const n_targs: i64 = if (call.generic_args.length > 0) { call.generic_args.length } else { scope.generic_args.length };
        if (n_targs == 0) { return out; }
        // A variant's turbofish names its enum's instance
        // (`Result::Ok::<u8, i32>(5)`): each argument is typed against the
        // payload in that instance.
        const payload: [TypeRef] = this.written_variant_payload(scope);
        if (payload.length > 0 && payload.length == out.length) {
            for (mut i: i64 = 0; i < out.length; i++) {
                if (!out[i].is_valid() || !this.types.contains_generic_param(out[i])) { continue; }
                out[i] = payload[i];
                if (i < forced.length) { forced[i] = true; }
            }
            return out;
        }
        mut owner: FamilyOwner = FamilyOwner::Def(DefId::invalid());
        if (!this.scope_owner(scope, &owner)) { return out; }
        const head_trait: DefId = if (scope.impl_trait != null) { this.impl_qualified_trait(scope) } else { DefId::invalid() };
        const entries: [OverloadId] = this.member_entries(owner, scope.member_name);
        mut chosen: OverloadId = OverloadId::invalid();
        for (mut i: i64 = 0; i < entries.length; i++) {
            if (head_trait.is_valid() && !this.ctx.decl_index.entry_trait(entries[i]).equals(head_trait)) { continue; }
            const m_decl: DeclarationNode* = this.ctx.decl_index.entry_method(entries[i]);
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m == null || m.func == null || m.is_static || DeclarationNode::fn_of(m.func).generic_params.length != n_targs) { continue; }
            if (chosen.is_valid()) { return out; }
            chosen = entries[i];
        }
        if (!chosen.is_valid()) { return out; }
        const formals: [TypeRef] = this.static_entry_params(chosen, call, scope);
        if (formals.length != out.length) { return out; }
        for (mut i: i64 = 0; i < out.length; i++) {
            if (!out[i].is_valid() || !this.types.contains_generic_param(out[i])) { continue; }
            if (!formals[i].is_valid() || this.types.contains_generic_param(formals[i])) { continue; }
            out[i] = formals[i];
            if (i < forced.length) { forced[i] = true; }
        }
        return out;
    }

    /// The payload types of the variant `scope` names, in the instance the
    /// variant's own type arguments write (`Result::Ok::<u8, i32>`); none when
    /// the path names no generic enum's variant or an argument does not
    /// resolve.
    written_variant_payload(mut &this, scope: ScopeResolutionNode*) -> [TypeRef] {
        if (scope.generic_args.length == 0) { return []; }
        const base: TypeRef = this.types.scope_qualifier_type(scope);
        const t: Type* = this.arena.lookup(base);
        if (t == null || t.kind != TypeKind::Enum) { return []; }
        const tmpl: TemplateEntry* = this.ctx.generic_registry.template_of_type(base);
        if (tmpl == null || tmpl.param_count != scope.generic_args.length) { return []; }
        const et: EnumType* = t.as_enum();
        const vi: i64 = et.variant_index(scope.member_name);
        if (vi < 0) { return []; }
        mut rc: ResolutionContext = ResolutionContext::new("");
        this.symbolic.symbolic_bind_params(&rc);
        mut args: [TypeRef] = [];
        for (mut i: i64 = 0; i < scope.generic_args.length; i++) {
            const tr: TypeRef = this.ctx.type_resolver.resolve(scope.generic_args[i], &rc);
            if (!tr.is_valid()) { return []; }
            args.push(tr);
        }
        return this.substitute_payload_types(et.variants[vi].payload_types, base, &args);
    }

    substitute_explicit_method_param_types(mut &this, call: CallExprNode*,
                                           param_types: &[TypeRef],
                                           forced: mut &[boolean]) -> [TypeRef] {
        mut out: [TypeRef] = sema_copy_type_refs(param_types);
        const member: MemberAccessNode* = call.callee as MemberAccessNode*;
        if (member == null || member.generic_args.length == 0) { return out; }
        if (member.object == null) { return out; }
        const recv_type: TypeRef = member.object.resolved_type;
        if (!recv_type.is_valid()) { return out; }

        mut orig_func: DeclarationNode* = null;
        mut owner_ctx: ResolutionContext =
            this.binding.find_generic_method_for_call(recv_type, member, null, &orig_func);
        if (orig_func == null) { return out; }
        const n_method_params: i64 = DeclarationNode::fn_of(orig_func).generic_params.length;
        if (n_method_params == 0) { return out; }
        if (member.generic_args.length != n_method_params) { return out; }

        // Resolve the turbofish in the CALLER's scope, not through `owner_ctx`:
        // an owner binding would shadow an enclosing parameter that happens to
        // share the receiver's parameter name. Mirrors the same choice in
        // `MethodBinding::solve_method_bindings`.
        mut tf_ctx: ResolutionContext = ResolutionContext::new("");
        this.symbolic.symbolic_bind_params(&tf_ctx);
        mut bindings: [TypeRef] = [];
        for (mut i: i64 = 0; i < n_method_params; i++) {
            const tr: TypeRef = this.ctx.type_resolver.resolve(member.generic_args[i], &tf_ctx);
            if (!tr.is_valid()) { return out; }
            // A still-abstract binding cannot type an argument in a concrete
            // caller; leave the formals alone and let inference/mono decide.
            if (this.types.contains_generic_param(tr)) { return out; }
            bindings.push(tr);
        }

        // Re-resolve the formals with owner args concrete AND the method's own
        // params bound, rather than substituting into the already-resolved
        // types: resolution handles a param nested inside another type
        // (`Array<T>`, `Option<T>`) for free.
        mut pctx: ResolutionContext = owner_ctx.clone();
        for (mut i: i64 = 0; i < n_method_params; i++) {
            const gp_decl: DeclarationNode* = DeclarationNode::fn_of(orig_func).generic_params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            if (gp == null) { return out; }
            pctx.add_binding(gp.sym_id, gp.name, bindings[i]);
        }
        pctx.set_this_type(recv_type);

        mut explicit_params: [VarDecl*] = [];
        for (mut i: i64 = 0; i < DeclarationNode::fn_of(orig_func).parameters.length; i++) {
            const p_decl: DeclarationNode* = DeclarationNode::fn_of(orig_func).parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p == null) { continue; }
            if (p.is_receiver()) { continue; }
            explicit_params.push(p);
        }
        if (explicit_params.length != out.length) { return out; }

        for (mut i: i64 = 0; i < out.length; i++) {
            const p: VarDecl* = explicit_params[i];
            if (p == null || p.type_annotation == null) { continue; }
            const formal: TypeRef = this.ctx.type_resolver.resolve(p.type_annotation, &pctx);
            if (!formal.is_valid()) { continue; }
            if (this.types.contains_generic_param(formal)) { continue; }
            out[i] = formal;
            if (i < forced.length) { forced[i] = true; }
        }
        return out;
    }

    /// Substitute a generic free function's inferred/explicit type args into its
    /// template return, yielding the concrete call return pre-mono (or invalid).
    subst_free_call_return(mut &this, entry: TemplateEntry*, bindings: &[TypeRef],
                           tmpl_ret: TypeRef) -> TypeRef {
        if (!tmpl_ret.is_valid()) { return TypeRef::invalid(); }
        if (bindings.length != entry.param_types.length) { return TypeRef::invalid(); }
        // A still-generic result is meaningless to a CONCRETE caller typed
        // pre-mono, so it is rejected there. Inside the symbolic generic-body
        // walk it is the correct answer: the caller's own parameters are abstract,
        // so `mk<T>(v)` genuinely has type `W<T>`, and monomorphization
        // substitutes it along with the rest of the body. Rejecting it there
        // leaves the call untyped, which only shows up where something needs the
        // type — `await f<T>(x)`, whose operand type IS the answer.
        const symbolic: boolean = this.state.in_symbolic_check;
        for (mut i: i64 = 0; i < bindings.length; i++) {
            if (!bindings[i].is_valid()) { return TypeRef::invalid(); }
            if (!symbolic && this.types.contains_generic_param(bindings[i])) {
                return TypeRef::invalid();
            }
        }
        return this.subst_params(&entry.param_types, bindings, tmpl_ret);
    }

    /// `ty` with each of `params` replaced by the binding at its position,
    /// a projection that made concrete reduced to the type its impl binds.
    /// Invalid when a still-generic result reaches a concrete caller.
    subst_params(mut &this, params: &[TypeRef], bindings: &[TypeRef], ty: TypeRef) -> TypeRef {
        const symbolic: boolean = this.state.in_symbolic_check;
        const tmpl_ret: TypeRef = ty;
        mut subst: TypeSubstitution = TypeSubstitution::from_params(params, bindings);
        // A projection the substitution made concrete (`I::Item` with `I`
        // bound to `Count`) is the type `Count`'s impl binds, not a
        // projection: `Option<Count::Item>` is `Option<i32>` to the caller.
        // The unreduced form is built without demanding it - nothing
        // monomorphizes an instantiation holding a projection.
        const was: boolean = this.arena.symbolic_no_demand_active;
        this.arena.set_symbolic_no_demand(true);
        const applied: TypeRef = subst.apply(tmpl_ret, this.arena);
        this.arena.set_symbolic_no_demand(was);
        const out: TypeRef = this.ctx.type_resolver.reduce_projections(applied, false);
        if (!out.is_valid()) { return TypeRef::invalid(); }
        if (!symbolic && this.types.contains_generic_param(out)) { return TypeRef::invalid(); }
        return out;
    }

    /// Bound-directed projection ("PASS D") for a generic FREE-function call:
    /// fill a param that appears only in a where-bound (the `R` in
    /// `where F: Future<R>`) by projecting it off the now-bound subject
    /// (`R = F::Output`). Thin wrapper over the shared
    /// `TypeResolver::project_where_bound_params_into`, which the static + instance
    /// generic-method paths share; the template's `param_syms` are index-aligned
    /// with `ictx.bindings`, exactly as that helper requires.
    project_where_bound_params(mut &this, tmpl_decl: DeclarationNode*, entry: TemplateEntry*,
                               ictx: InferCtx*) -> void {
        const tmpl: FunctionDecl* = DeclarationNode::fn_of(tmpl_decl);
        this.ctx.type_resolver.project_where_bound_params_into(
            &tmpl.trait_bounds, &entry.param_syms, ictx, this.ctx.source_file,
            this.state.in_symbolic_check);
    }

    /// PASS A/B/C argument inference returning the per-param bindings (no
    /// diagnostics), used by the module-scoped scope-resolution path.
    infer_free_call_bindings(mut &this, call: CallExprNode*, entry: TemplateEntry*,
                             tmpl_decl: DeclarationNode*) -> [TypeRef] {
        const tmpl: FunctionDecl* = DeclarationNode::fn_of(tmpl_decl);
        mut empty: [TypeRef] = [];
        if (entry.param_types.length == 0) { return empty; }
        if (tmpl.parameters.length != call.arguments.length) { return empty; }
        mut pids: [TypeRef] = [];
        for (mut i: i64 = 0; i < entry.param_types.length; i++) { pids.push(entry.param_types[i]); }
        mut ictx: InferCtx = InferCtx::for_template(this.arena, pids);

        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            const param_decl: DeclarationNode* = tmpl.parameters[i];
            const param: VarDecl* = DeclarationNode::var_of(param_decl);
            if (param == null || !param.resolved_type.is_valid()) { continue; }
            const arg: ExpressionNode* = call.arguments[i];
            if (this.sema_arg_is_polymorphic_literal(arg)) { continue; }
            if (!this.free_infer_arg_reliable(arg)) { continue; }
            const actual: TypeRef = arg.resolved_type;
            if (!actual.is_valid()) { continue; }
            ictx.conflict_from = TypeRef::invalid();
            ictx.conflict_to   = TypeRef::invalid();
            ictx.unify(param.resolved_type, actual);
            if (ictx.conflict_from.is_valid() && ictx.conflict_to.is_valid()
                    && this.free_infer_type_concrete(ictx.conflict_from)
                    && this.free_infer_type_concrete(ictx.conflict_to)) {
                return empty;
            }
        }
        // A param a where-bound projects off a bound subject is what the bound
        // requires; the expected type only fills what nothing else decides.
        this.project_where_bound_params(tmpl_decl, entry, &ictx);
        if (this.state.expected_type.is_valid() && tmpl.resolved_return_type.is_valid()
                && !this.types.contains_generic_param(this.state.expected_type)) {
            mut any_unbound: boolean = false;
            for (mut i: i64 = 0; i < ictx.bindings.length; i++) {
                if (!ictx.bindings[i].is_valid()) { any_unbound = true; break; }
            }
            if (any_unbound) { ictx.unify(tmpl.resolved_return_type, this.state.expected_type); }
        }
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            const param_decl: DeclarationNode* = tmpl.parameters[i];
            const param: VarDecl* = DeclarationNode::var_of(param_decl);
            if (param == null || !param.resolved_type.is_valid()) { continue; }
            const arg: ExpressionNode* = call.arguments[i];
            if (!this.sema_arg_is_polymorphic_literal(arg)) { continue; }
            const lit_actual: TypeRef = arg.resolved_type;
            if (!lit_actual.is_valid()) { continue; }
            const f_idx: i64 = ictx.binding_index(param.resolved_type);
            if (f_idx >= 0 && ictx.bindings[f_idx].is_valid()) { continue; }
            ictx.unify(param.resolved_type, lit_actual);
        }
        // PASS D - project a where-bound-only param off its now-bound subject
        // (mirrors `check_generic_free_call`; keeps the qualified scope path,
        // e.g. `future::block_on(fut)`, in step with the bare-identifier path).
        this.project_where_bound_params(tmpl_decl, entry, &ictx);
        mut bindings: [TypeRef] = [];
        for (mut i: i64 = 0; i < ictx.bindings.length; i++) { bindings.push(ictx.bindings[i]); }
        for (mut i: i64 = 0; i < bindings.length; i++) {
            if (!bindings[i].is_valid()) { return empty; }
        }
        return bindings;
    }

    /// Stash the generic type-arg bindings for a TYPE-scoped generic static-method
    /// scope-resolution call (`Layout::of<T>()`) so mono need not re-infer.
    stash_scope_resolution_call_bindings(mut &this, call: CallExprNode*,
                                         scope: ScopeResolutionNode*) -> void {
        if (call == null || scope == null) { return; }
        if (call.resolved_type_args.length > 0) { return; }
        const entry: TemplateEntry* = this.find_static_method_template(scope, call);
        if (entry == null || entry.kind != TemplateKind::Function) { return; }
        if (entry.param_types.length == 0) { return; }
        const tmpl_decl: DeclarationNode* = DeclarationNode::with_shape(entry.ast_node);
        const tmpl: FunctionDecl* = DeclarationNode::fn_of(tmpl_decl);
        if (tmpl == null) { return; }
        const binds: [TypeRef] = this.template_call_bindings(call, scope, entry, tmpl_decl);
        if (binds.length == 0) { return; }
        call.set_resolved_type_args(binds);
    }

    /// The type arguments `call` binds the generic function `tmpl` (its
    /// template `entry`) with - a generic static method called through
    /// `scope`, or a free function, whose `scope` is null: the turbofish
    /// written on the member or the scope, else the arguments' inference.
    /// Empty when the turbofish's count differs from the function's, a type
    /// argument does not resolve, or inference leaves a parameter unbound.
    template_call_bindings(mut &this, call: CallExprNode*, scope: ScopeResolutionNode*,
                           entry: TemplateEntry*, tmpl_decl: DeclarationNode*) -> [TypeRef] {
        mut targs: &[TypeAnnotation*] = &call.generic_args;
        if (targs.length == 0 && scope != null && scope.generic_args.length > 0) { targs = &scope.generic_args; }
        if (targs.length == 0) { return this.infer_free_call_bindings(call, entry, tmpl_decl); }
        mut binds: [TypeRef] = [];
        if (targs.length != entry.param_types.length) { return binds; }
        mut rc: ResolutionContext = ResolutionContext::new("");
        this.symbolic.symbolic_bind_params(&rc);
        for (mut i: i64 = 0; i < targs.length; i++) {
            const tr: TypeRef = this.ctx.type_resolver.resolve(targs[i], &rc);
            if (!tr.is_valid()) { return []; }
            binds.push(tr);
        }
        return binds;
    }

    emit_free_call_bound_failure(mut &this, at: SourceSpan, tmpl_decl: DeclarationNode*,
                                 tref: TraitRef*, concrete: TypeRef, trait_name: SymbolStr) -> void {
        const tmpl: FunctionDecl* = DeclarationNode::fn_of(tmpl_decl);
        const trait_str: string = this.intern.resolve(trait_name);
        const fn_str:    string = this.intern.resolve(tmpl.name);
        const conc_str:  string = this.types.type_display_name(concrete);
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
            fmt::format("the trait bound `%s: %s` is not satisfied", conc_str, trait_str));
        d = d.at(at);
        d = d.also_at(tref.span, fmt::format("required by this bound in `%s`", fn_str));
        d = d.with_note(fmt::format("the trait `%s` is not implemented for `%s`", trait_str, conc_str));
        d = d.help(fmt::format("implement `%s` for `%s`, or pass an argument of a type that already does",
            trait_str, conc_str));
        this.ctx.emit_diagnostic(d);
    }

    emit_free_cannot_infer(mut &this, call: CallExprNode*, fn_name: SymbolStr) -> void {
        const fn_str: string = this.intern.resolve(fn_name);
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0307_CANNOT_INFER_TYPE_ARG,
            fmt::format("cannot infer the type argument for `%s`", fn_str));
        d = d.at(call.span);
        d = d.with_note("`![implicit]` recovers the type argument from the expected type, but this call is not in a typed context (e.g. a `const x: T = ...` initializer)");
        d = d.help(fmt::format("write the type argument explicitly, e.g. `%s<T>(...)`", fn_str));
        this.ctx.emit_diagnostic(d);
    }

    emit_free_infer_conflict(mut &this, call: CallExprNode*, fn_name: SymbolStr,
                             arg: ExpressionNode*, bound: TypeRef, got: TypeRef) -> void {
        const fn_str:    string = this.intern.resolve(fn_name);
        const bound_str: string = this.types.type_display_name(bound);
        const got_str:   string = this.types.type_display_name(got);
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0214_ARGUMENT_MISMATCH,
            fmt::format("conflicting types for the type parameter of `%s`", fn_str));
        const anchor: SourceSpan = if (arg != null && arg.span.has_location()) { arg.span } else { call.span };
        d = d.at_with_label(anchor,
            fmt::format("expected `%s` (inferred from an earlier argument), found `%s`", bound_str, got_str));
        d = d.with_note(fmt::format("a single type parameter cannot be both `%s` and `%s`", bound_str, got_str));
        this.ctx.emit_diagnostic(d);
    }


    // -- Free-call arity + argument type checking --

    check_call_arity(mut &this, visitor: SemaVisitor*, call: CallExprNode*, ident: IdentifierNode*) -> void {
        if (call.generic_args.length > 0) { return; }
        // Arity is checked against the family the callee names and nothing
        // else: a leaf-keyed list holds every module's `write`, and an arity
        // reported against one of those is a diagnostic about a function the
        // call never named.
        const callee: DefId = this.callee_def(ident);
        if (!callee.is_valid()) { return; }
        const overloads: [TypeRef] = this.family_signatures_of(callee);
        // A class's name called is its constructor (the value its name
        // binds), checked as `new` checks one.
        if (this.ctx.defs.kind_of(callee) == DefKind::Type) {
            this.check_constructor_args(visitor, callee, &overloads, &call.arguments, call.span);
            return;
        }
        if (overloads.length == 0) { return; }
        if (overloads.length > 1) {
            this.check_overloaded_free_call_arity(call, ident, overloads);
            return;
        }
        const ft_raw: Type* = this.arena.lookup(overloads[0]);
        if (ft_raw == null || ft_raw.kind != TypeKind::Function) { return; }
        const ft: FunctionType* = ft_raw.as_function();
        // A variadic callee's declared parameters are parameters: each must
        // be supplied and each is checked against its declared type.  Only
        // the tail past them is unconstrained.
        const expected: i64 = ft.param_types.length;
        const got: i64 = call.arguments.length;
        if (got < expected) {
            const name: string = this.intern.resolve(ident.name);
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0216_TOO_FEW_ARGS,
                fmt::format("function `%s` takes %s%lld argument(s) but %lld were supplied", name,
                    if (ft.is_variadic) { "at least " } else { "" }, expected, got));
            diag = diag.at_with_label(call.span,
                fmt::format("missing %lld argument%s", expected - got, if (expected - got == 1) { "" } else { "s" }));
            if (call.span.has_location() && call.span.end_col > 0) {
                mut repl: string = "";
                for (mut k: i64 = got; k < expected; k++) {
                    const pname: string = this.arena.resolve_display_name_short(ft.param_types[k]);
                    const sep: string = if (k == 0) { "" } else { ", " };
                    repl = fmt::format("%s%s<%s>", repl, sep, pname);
                }
                const ins: SourceSpan = SourceSpan::new(
                    call.span.file, call.span.end_line, call.span.end_col - 1,
                    call.span.end_line, call.span.end_col - 1);
                diag = diag.suggest(Suggestion::single(ins, repl,
                    if (expected - got == 1) { "provide the missing argument" } else { "provide the missing arguments" },
                    Applicability::HasPlaceholders));
            }
            this.ctx.diagnostics.emit(diag);
            return;
        }
        if (got > expected && !ft.is_variadic) {
            const name: string = this.intern.resolve(ident.name);
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0215_TOO_MANY_ARGS,
                fmt::format("function `%s` takes %lld argument(s) but %lld were supplied", name, expected, got));
            diag = diag.at_with_label(call.span,
                fmt::format("unexpected argument%s", if (got - expected == 1) { "" } else { "s" }));
            mut anchor_end_line: u32 = 0;
            mut anchor_end_col:  u32 = 0;
            mut anchor_ok:       boolean = false;
            if (expected == 0) {
                if (call.arguments.length > 0 && call.arguments[0] != null
                        && call.arguments[0].span.has_location()) {
                    anchor_end_line = call.arguments[0].span.start_line;
                    anchor_end_col  = call.arguments[0].span.start_col;
                    anchor_ok = true;
                }
            } else {
                const last_keep: ExpressionNode* = call.arguments[expected - 1];
                if (last_keep != null && last_keep.span.has_location()) {
                    anchor_end_line = last_keep.span.end_line;
                    anchor_end_col  = last_keep.span.end_col;
                    anchor_ok = true;
                }
            }
            if (anchor_ok && call.span.has_location() && call.span.end_col > 0) {
                const removal: SourceSpan = SourceSpan::new(
                    call.span.file, anchor_end_line, anchor_end_col,
                    call.span.end_line, call.span.end_col - 1);
                diag = diag.suggest(Suggestion::machine_applicable(removal, "",
                    if (got - expected == 1) { "remove the extra argument" }
                    else { fmt::format("remove the %lld extra arguments", got - expected) }));
            }
            this.ctx.diagnostics.emit(diag);
            return;
        }
        this.check_args_against_params(visitor, &call.arguments, ft.param_types.as_slice());
    }

    /// The signatures of the family the definition `def` names, in
    /// registration order: a function's overloads, read off its own entry,
    /// or a type's constructors.  Which of the two is the definition's
    /// kind: a function and a type may share a path.
    family_signatures_of(&this, def: DefId) -> [TypeRef] {
        const entries: [OverloadId] = if (this.ctx.defs.kind_of(def) == DefKind::Type) {
            this.ctx.decl_index.constructor_entries_of(def)
        } else {
            this.ctx.decl_index.family_entries_of_def(def)
        };
        mut sigs: [TypeRef] = [];
        for (mut i: i64 = 0; i < entries.length; i++) { sigs.push(this.ctx.decl_index.entry_signature(entries[i])); }
        return sigs;
    }

    /// The arguments of a construction - `new C(args)`, or `C(args)` by
    /// value - checked against the constructor of the call's arity, the one
    /// code generation calls.  A constructor is registered as a method of
    /// its type under the type's own leaf, its first parameter the storage
    /// being initialized, so a signature of `n + 1` parameters takes `n`
    /// arguments.  A call no constructor's arity fits is an arity error,
    /// naming the one arity the type offers, or none when it offers several;
    /// a type that declares no constructor takes no arguments.  A generic
    /// type's constructors are registered on its instantiations when they
    /// are specialized, so an unregistered one is not judged here.  `ctors`
    /// is the type's family, `family_signatures_of(def)`.
    check_constructor_args(mut &this, visitor: SemaVisitor*, def: DefId, ctors: &[TypeRef],
                           args: mut &[ExpressionNode*], at: SourceSpan) -> void {
        const leaf: SymbolStr = this.ctx.defs.leaf_of(def).spelling();
        const got: i64 = args.length;
        if (ctors.length == 0) {
            if (got == 0) { return; }
            if (this.ctx.generic_registry.template_of(def) != null) { return; }
        }
        mut offered: i64 = -1;
        for (mut i: i64 = 0; i < ctors.length; i++) {
            const t: Type* = this.arena.lookup(ctors[i]);
            if (t == null || t.kind != TypeKind::Function) { return; }
            const ft: FunctionType* = t.as_function();
            const takes: i64 = ft.param_types.length - 1;
            if (takes == got) {
                const params: Slice<TypeRef> = ft.param_types.as_slice();
                this.check_args_against_params(visitor, args, params.subslice(1, params.length));
                return;
            }
            offered = this.diag.note_arity(offered, takes);
        }
        if (ctors.length == 0) { offered = 0; }
        const expected: i64 = if (offered < 0) { -1 } else { offered };
        this.diag.emit_method_arity_error(at, leaf, "constructor", expected, got, false);
    }

    check_overloaded_free_call_arity(mut &this, call: CallExprNode*, ident: IdentifierNode*,
                                     overloads: [TypeRef]) -> void {
        const got: i64 = call.arguments.length;
        mut uniq_arity:  i64 = -1;
        mut any_variadic: boolean = false;
        mut matches:      boolean = false;
        for (mut i: i64 = 0; i < overloads.length; i++) {
            const t: Type* = this.arena.lookup(overloads[i]);
            if (t == null || t.kind != TypeKind::Function) { return; }
            const ft: FunctionType* = t.as_function();
            if (ft.is_variadic) { any_variadic = true; continue; }
            const ar: i64 = ft.param_types.length;
            uniq_arity = this.diag.note_arity(uniq_arity, ar);
            if (ar == got) { matches = true; }
        }
        if (any_variadic || matches) { return; }
        const expected_for_msg: i64 = if (uniq_arity >= 0) { uniq_arity } else { -1 };
        this.diag.emit_method_arity_error(call.span, ident.name, "function", expected_for_msg, got, false);
    }

    /// Non-emitting category check: do the call's args fit `params`?  Non-concrete
    /// args/params count as fitting (mono re-checks).
    args_fit_params_loosely(mut &this, call: CallExprNode*, params: Slice<TypeRef>) -> boolean {
        const n: i64 = params.length as i64;
        for (mut i: i64 = 0; i < n; i++) {
            if (i >= call.arguments.length) { break; }
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null) { continue; }
            const arg_ty:   TypeRef = arg.resolved_type;
            const param_ty: TypeRef = params.get(i as u64).unwrap();
            if (!this.types.arg_type_is_concrete(arg_ty))   { continue; }
            if (!this.types.arg_type_is_concrete(param_ty)) { continue; }
            const compat: TypeCompatibility = this.checker.check_compatibility(arg_ty, param_ty);
            if (compat == TypeCompatibility::Incompatible) {
                if (this.types.indirection_compatible(arg_ty, param_ty)) { continue; }
                if (this.types.enum_int_compatible(arg_ty, param_ty)) { continue; }
                return false;
            }
        }
        return true;
    }

    /// True when a registered `![implicit]` converter bridges `arg_ty -> param_ty`.
    has_implicit_converter(&this, arg_ty: TypeRef, param_ty: TypeRef) -> boolean {
        if (!arg_ty.is_valid() || !param_ty.is_valid()) { return false; }
        if (arg_ty.equals(param_ty)) { return false; }
        if (this.ctx.decl_index.lookup_implicit_converter(arg_ty, param_ty).is_valid()) { return true; }
        const base: TypeRef = this.types.generic_base_of(param_ty);
        return base.is_valid()
            && this.ctx.decl_index.lookup_implicit_converter(arg_ty, base).is_valid();
    }

    /// Synthesize + re-resolve an implicit-converter call around `expr` when one
    /// bridges `from_ty -> to_ty`; returns the new node, or null.
    build_implicit_conversion(mut &this, visitor: SemaVisitor*, expr: ExpressionNode*,
                              from_ty: TypeRef, to_ty: TypeRef) -> ExpressionNode* {
        if (expr == null) { return null; }
        if (!from_ty.is_valid() || !to_ty.is_valid()) { return null; }
        if (from_ty.equals(to_ty)) { return null; }
        if (this.state.in_implicit_conversion) { return null; }

        mut conv: DefId = this.ctx.decl_index.lookup_implicit_converter(from_ty, to_ty);
        if (!conv.is_valid()) {
            const base: TypeRef = this.types.generic_base_of(to_ty);
            if (base.is_valid()) {
                conv = this.ctx.decl_index.lookup_implicit_converter(from_ty, base);
            }
        }
        if (!conv.is_valid()) { return null; }

        // The call names the converter by its definition: a function by the
        // identifier's stamp, a method on the type that declares it, bound
        // to its entry before it is resolved.  Neither the use site's scope
        // nor another member of a family answers instead.  The spellings on
        // the nodes are the definition's own.
        const sp: SourceSpan = expr.span;
        mut callee: ExpressionNode* = null;
        mut conv_call: CallExprNode* = null;
        if (this.ctx.defs.kind_of(conv) != DefKind::Method) {
            mut id: IdentifierNode* = new IdentifierNode(this.ctx.defs.leaf_of(conv).spelling(), sp);
            id.set_res(Res::Def(conv));
            callee = id as ExpressionNode*;
            conv_call = new CallExprNode(callee, sp);
        } else {
            // The owner is the type declaring the converter; `to_ty` when the
            // converter yields its own type, keeping the target's arguments.
            const owner_def: DefId = this.ctx.defs.parent_of(conv);
            const owner_ty: TypeRef = if (this.ctx.decl_index.def_of(to_ty, this.ctx.type_arena).equals(owner_def)) {
                to_ty
            } else {
                this.ctx.decl_index.type_of_def(owner_def)
            };
            mut sr: ScopeResolutionNode* = new ScopeResolutionNode(
                this.ctx.defs.leaf_of(owner_def).spelling(), this.ctx.defs.leaf_of(conv).spelling(), sp);
            sr.set_synthesized_ref(owner_ty, owner_def);
            // Generic-identity view: a post-mono concrete target still needs its
            // type_args stamped onto the synthesized scope, or the converter call
            // resolves against the bare generic scope name.
            const n_args: i64 = this.types.view_type_arg_count(owner_ty);
            if (n_args > 0) {
                mut gargs: [TypeAnnotation*] = [];
                for (mut gi: i64 = 0; gi < n_args; gi++) {
                    mut na: NamedAnnotation* = new NamedAnnotation {
                        name:         SymbolStr::empty(),
                        span:         sp,
                        pre_resolved: this.types.view_type_arg_at(owner_ty, gi),
                        res: ResSlot::Pending,
                    };
                    gargs.push(new TypeAnnotation::Named(na));
                }
                sr.set_scope_generic_args(gargs);
            }
            callee = sr as ExpressionNode*;
            conv_call = new CallExprNode(callee, sp);
            // The owner's own method, or its copy on a built instance, is
            // pinned.  An instance not built yet reads its methods off its
            // generic template, whose method no call can run: the call is
            // left as a written path on it is, for monomorphization, which
            // demands the instance's method as it binds it.
            const methods_of: TypeRef = this.types.method_owner_ref(owner_ty);
            if (this.ctx.generic_registry.template_of_type(methods_of) == null) {
                const e: OverloadId = this.ctx.decl_index.method_entry_on(methods_of, conv);
                if (e.is_valid()) { conv_call.set_resolved_callee(CalleePin::Decl(e)); }
            }
        }
        // The operand's text spells no converter: the call and its callee are
        // the compiler's, around the written operand.
        callee.generated = true;
        conv_call.generated = true;
        conv_call.add_argument(expr);

        this.state.in_implicit_conversion = true;
        const result_ty: TypeRef = visitor.resolve_expr(conv_call as ExpressionNode*);
        this.state.in_implicit_conversion = false;

        if (!result_ty.is_valid() || !this.checker.can_assign(result_ty, to_ty)) { return null; }
        return conv_call as ExpressionNode*;
    }

    /// Rewrite `args[idx]` through an implicit converter when one bridges
    /// `arg_ty -> param_ty`; returns true if converted.
    try_apply_implicit_conversion(mut &this, visitor: SemaVisitor*, args: mut &[ExpressionNode*], idx: i64,
                                  arg: ExpressionNode*, arg_ty: TypeRef, param_ty: TypeRef) -> boolean {
        const c: ExpressionNode* = this.build_implicit_conversion(visitor, arg, arg_ty, param_ty);
        if (c == null) { return false; }
        args[idx] = c;
        return true;
    }

    /// Like `check_args_against_params` but inserts `![implicit]` converters ONLY
    /// - never emits a mismatch/narrowing/sign diagnostic.  Used for the
    /// abbreviated-namespace scope-call path (`fmt::println("x")`), whose calls
    /// are not arg-checked at all: applying the needed conversion
    /// (e.g. `string -> String`) fixes a real miscompile, but newly *enforcing*
    /// the type errors there would break code that relies on that leniency.
    apply_implicit_conversions_only(mut &this, visitor: SemaVisitor*, call: CallExprNode*,
                                    param_types: Slice<TypeRef>) -> void {
        const n: i64 = param_types.length as i64;
        for (mut i: i64 = 0; i < n; i++) {
            if (i >= call.arguments.length) { break; }
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null) { continue; }
            const arg_ty:   TypeRef = arg.resolved_type;
            const param_ty: TypeRef = param_types.get(i as u64).unwrap();
            if (!this.types.arg_type_is_concrete(arg_ty))   { continue; }
            if (!this.types.arg_type_is_concrete(param_ty)) { continue; }
            if (this.checker.check_compatibility(arg_ty, param_ty) != TypeCompatibility::Incompatible) { continue; }
            if (this.types.indirection_compatible(arg_ty, param_ty)) { continue; }
            if (this.types.enum_int_compatible(arg_ty, param_ty)) { continue; }
            this.try_apply_implicit_conversion(visitor, &call.arguments, i, arg, arg_ty, param_ty);
        }
    }

    /// After an overload has been *selected* whose match relied on a registered
    /// `![implicit]` converter for one or more arguments, rewrite those argument
    /// nodes through the converter so the converted value - not the raw source - 
    /// reaches the pinned overload.
    ///
    /// Overload selection (`bind_method_on_receiver` / `bind_on_impl_block`)
    /// is free to *accept* a candidate on the strength of `has_implicit_converter`,
    /// but it pins by the candidate's parameter types and leaves the argument node
    /// untouched.  For a builtin coercion (`can_implicit_convert` / an int literal
    /// that fits) that is correct - codegen coerces natively.  For a user
    /// `![implicit]` converter (e.g. `string -> Str` via `Str::new`) it is NOT: the
    /// raw `string` pointer would be dropped straight into the `Str` slot and the
    /// callee would read a garbage length.  This pass closes that gap; it is a
    /// no-op for arguments that already match or only need a builtin coercion, so
    /// callers may invoke it unconditionally after choosing the overload.
    apply_overload_converter_args(mut &this, visitor: SemaVisitor*, call: CallExprNode*,
                                  param_types: Slice<TypeRef>) -> void {
        const n: i64 = param_types.length as i64;
        for (mut i: i64 = 0; i < n; i++) {
            if (i >= call.arguments.length) { break; }
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null) { continue; }
            const arg_ty:   TypeRef = arg.resolved_type;
            const param_ty: TypeRef = param_types.get(i as u64).unwrap();
            if (!arg_ty.is_valid() || !param_ty.is_valid()) { continue; }
            if (arg_ty.equals(param_ty)) { continue; }
            if (this.checker.can_implicit_convert(arg_ty, param_ty)) { continue; }
            if (this.literals.int_literal_fits_target(arg, param_ty)) { continue; }
            if (!this.has_implicit_converter(arg_ty, param_ty)) { continue; }
            this.try_apply_implicit_conversion(visitor, &call.arguments, i, arg, arg_ty, param_ty);
        }
    }

    /// Whether an argument's type, or its parameter's, names a type a
    /// mismatch can be judged against: one type, or in a generic body a type
    /// whose only unsettled parts are the body's own parameters.  A generic
    /// body is checked once and its copies are not, so a pair skipped here
    /// is never checked.
    arg_side_judgeable(&this, ty: TypeRef) -> boolean {
        return this.types.arg_type_names_one_type(ty) || this.symbolic.symbolic_params_settle(ty);
    }

    /// Per-argument type checking for a 1:1 arg/param list.  Flags only hard
    /// category mismatches / lossy narrowing / same-width sign reinterpret;
    /// synthesizes implicit conversions where registered.
    check_args_against_params(mut &this, visitor: SemaVisitor*, args: mut &[ExpressionNode*],
                              param_types: Slice<TypeRef>) -> void {
        const n: i64 = param_types.length as i64;
        for (mut i: i64 = 0; i < n; i++) {
            if (i >= args.length) { break; }
            const arg: ExpressionNode* = args[i];
            if (arg == null) { continue; }
            // Inside a `static match (T)` arm, `T` reads as the arm's type on
            // both sides, a field typed `T` (`&this.value`) as surely as a local.
            const arg_ty:   TypeRef = this.symbolic.symbolic_narrowed(arg.resolved_type);
            const param_ty: TypeRef = this.symbolic.symbolic_narrowed(param_types.get(i as u64).unwrap());
            // In a generic body a value of a type parameter is that parameter
            // and nothing else: whatever an instantiation binds it to, it is
            // not the concrete type a parameter declares (`x: T` passed for
            // an `f64`).
            if (!this.arg_side_judgeable(arg_ty))   { continue; }
            if (!this.arg_side_judgeable(param_ty)) { continue; }
            const compat: TypeCompatibility = this.checker.check_compatibility(arg_ty, param_ty);
            if (compat == TypeCompatibility::Incompatible) {
                if (this.types.indirection_compatible(arg_ty, param_ty)) { continue; }
                if (this.types.enum_int_compatible(arg_ty, param_ty)) { continue; }
                if (this.try_apply_implicit_conversion(visitor, args, i, arg, arg_ty, param_ty)) { continue; }
                this.diag.emit_type_mismatch_with_value(
                    ErrorCode::E0214_ARGUMENT_MISMATCH, arg.span, param_ty, arg_ty,
                    fmt::format("argument %lld doesn't match the parameter's declared type", i + 1),
                    SourceSpan::none(), arg);
            } else if (this.checker.is_const_drop(arg_ty, param_ty)) {
                this.diag.emit_type_mismatch_with_value(
                    ErrorCode::E0214_ARGUMENT_MISMATCH, arg.span, param_ty, arg_ty,
                    fmt::format("argument %lld drops `const` from the pointee; add an explicit `as` cast if this is intended", i + 1),
                    SourceSpan::none(), arg);
            } else if (this.checker.is_lossy_numeric_narrowing(arg_ty, param_ty)
                       && !this.literals.int_literal_fits_target(arg, param_ty)) {
                this.diag.emit_type_mismatch_with_value(
                    ErrorCode::E0214_ARGUMENT_MISMATCH, arg.span, param_ty, arg_ty,
                    fmt::format("argument %lld narrows the value and would silently truncate; add an explicit `as` cast", i + 1),
                    SourceSpan::none(), arg);
            } else if (this.checker.is_same_width_sign_reinterpret(arg_ty, param_ty)
                       && (
                           ((is_numeric_literal_expr(arg) || is_negative_numeric_literal_expr(arg))
                            && !this.literals.int_literal_fits_target(arg, param_ty))
                           || (!is_numeric_literal_expr(arg) && !is_negative_numeric_literal_expr(arg)
                               && this.checker.is_subword_sign_reinterpret(arg_ty, param_ty))
                       )) {
                this.diag.emit_type_mismatch_with_value(
                    ErrorCode::E0214_ARGUMENT_MISMATCH, arg.span, param_ty, arg_ty,
                    fmt::format("argument %lld reinterprets the sign of a same-width integer and would silently change its value; add an explicit `as` cast", i + 1),
                    SourceSpan::none(), arg);
            }
        }
    }


    // -- Method / static overload metadata helpers --

    method_type_is_variadic(&this, fn_type: TypeRef) -> boolean {
        if (!fn_type.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(fn_type);
        if (t == null || t.kind != TypeKind::Function) { return false; }
        return t.as_function().is_variadic;
    }

    /// The canonical qualified trait a method came from, as stamped when the
    /// impl block was resolved.  Returned verbatim: the stamp is already the
    /// identity, and re-folding it through a program-wide leaf search would
    /// reintroduce a dependence on no other declaration sharing the leaf.
    method_origin_trait(&this, m: &MethodInfo) -> DefId {
        if (m.ast_node == null) { return DefId::invalid(); }
        const mn_decl: DeclarationNode* = DeclarationNode::with_shape(m.ast_node);
        const mn: MethodDecl* = DeclarationNode::method_of(mn_decl);
        if (mn.func == null) { return DefId::invalid(); }
        return DeclarationNode::fn_of(mn.func).origin_trait;
    }

    /// `(&f32, i64)` - one parameter list, rendered.  `from` is where the
    /// candidate's slice starts in the flat array, `n` how long it is.
    render_param_list(&this, params: &[TypeRef], from: i64, n: i64) -> string {
        mut s: string = "(";
        for (mut i: i64 = 0; i < n; i++) {
            if (i > 0) { s = s + ", "; }
            s = s + this.types.type_display_name(params[from + i]);
        }
        return s + ")";
    }

    /// No member of an overload set accepts this call's arguments.
    ///
    /// Reported here rather than deferred to `check_args_against_params`, which
    /// needs ONE signature to compare against: the defining feature of this case
    /// is that there are several and none of them fits, so the argument types
    /// and the candidate list are what make it actionable.
    ///
    /// Silent unless every argument has a concrete type - an abstract one has
    /// nothing to judge, and the same guard is why `check_args_against_params`
    /// skips those positions.
    emit_no_matching_overload(mut &this, call: CallExprNode*, member: MemberAccessNode*,
                              recv: TypeRef, cand_params: &[TypeRef], argc: i64) -> void {
        if (this.state.in_symbolic_check) { return; }
        mut argstr: string = "";
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null) { return; }
            if (!this.types.arg_type_is_concrete(arg.resolved_type)) { return; }
            if (i > 0) { argstr = argstr + ", "; }
            argstr = argstr + this.types.type_display_name(arg.resolved_type);
        }
        const name_str: string = this.intern.resolve(member.member);
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0214_ARGUMENT_MISMATCH,
            fmt::format("no overload of `%s` accepts these arguments", name_str));
        diag = diag.at_with_label(call.span,
            fmt::format("no `%s` on `%s` takes `(%s)`", name_str,
                   this.types.type_display_name(recv), argstr));
        if (argc > 0) {
            const count: i64 = cand_params.length / argc;
            mut note: string = "candidates are ";
            for (mut c: i64 = 0; c < count; c++) {
                if (c > 0) {
                    if (c + 1 == count) { note = note + " and "; }
                    else                { note = note + ", "; }
                }
                note = note + "`" + name_str
                     + this.render_param_list(cand_params, c * argc, argc) + "`";
            }
            if (count > 0) { diag = diag.with_note(note); }
        }
        this.ctx.emit_diagnostic(diag);
    }

    /// Per-argument type checking for an instance method call.  Gathers same-named
    /// candidates from inherent methods + trait impls; checks against the single
    /// signature when one emerges, and against the binder's verdict when several
    /// do; flags two-trait ambiguity / arity.  `chosen_method` is the method
    /// the selection bound the call to, null when it bound none.
    check_method_call_arg_types(mut &this, visitor: SemaVisitor*, call: CallExprNode*,
                                member: MemberAccessNode*, chosen_method_decl: DeclarationNode*) -> void {
        const chosen_method: MethodDecl* = DeclarationNode::method_of(chosen_method_decl);
        const obj_type: TypeRef = member.object.resolved_type;
        if (!obj_type.is_valid()) { return; }
        mut base_ref: TypeRef = obj_type;
        mut base_t: Type* = this.arena.lookup(obj_type);
        mut unwrap_depth: i32 = 0;
        while (base_t != null && unwrap_depth < 5) {
            if (base_t.kind == TypeKind::Pointer) {
                base_ref = base_t.as_pointer().pointee;
            } else if (base_t.kind == TypeKind::Reference) {
                base_ref = base_t.as_reference().referent;
            } else if (base_t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = base_t.as_instantiated();
                if (!inst.has_resolved_type()) {
                    // Not minted yet: the selection tried its template's
                    // methods; a call it bound is checked where it is minted,
                    // unless the receiver is a generic body's own
                    // instantiation (`Array<T>`), whose copies are not checked.
                    if (this.symbolic.symbolic_params_settle(base_ref)
                            || (chosen_method == null && !this.types.contains_generic_param(base_ref))) {
                        this.check_args_on_template(visitor, call, member, base_ref);
                    }
                    return;
                }
                base_ref = inst.resolved_type;
            } else {
                break;
            }
            base_t = this.arena.lookup(base_ref);
            unwrap_depth += 1;
        }
        if (base_t == null) { return; }

        const argc: i64 = call.arguments.length;
        mut found:     boolean = false;
        mut ambiguous: boolean = false;
        mut trait_ambiguous: boolean = false;
        mut found_trait: DefId = DefId::invalid();
        mut other_trait: DefId = DefId::invalid();
        // Every trait candidate at the call's arity, with where it is
        // declared, for the tie report.
        mut tie_traits: [DefId] = [];
        mut tie_spans: [SourceSpan] = [];
        mut variadic_ok: boolean = false;
        mut chosen:    [TypeRef] = [];
        mut chosen_fn: DeclarationNode* = null;
        mut name_seen:  i64 = 0;
        mut uniq_arity: i64 = -1;
        // Every arity-matching candidate's parameter types, flat: each candidate
        // contributes exactly `argc` entries, so the diagnostic chunks them back
        // apart.  Collected in the walk that finds them rather than by a second
        // walk at the diagnostic, so the set reported is by construction the set
        // that was considered - and held as TypeRefs rather than rendered text,
        // because this runs at every method call and only the error path needs
        // the strings.
        mut cand_params: [TypeRef] = [];

        const empty_minfo: [MethodInfo] = [];
        mut methods_ref: &[MethodInfo] = &empty_minfo;
        mut start_cls: ClassType* = null;
        match (base_t.kind) {
            TypeKind::Class => { start_cls = base_t.as_class(); methods_ref = &start_cls.methods; }
            TypeKind::Struct => { methods_ref = &base_t.as_struct().methods; }
            TypeKind::Enum   => { methods_ref = &base_t.as_enum().methods; }
            _ => { }
        }
        // The receiver's inherent methods are the candidates when any of
        // them has the call's arity; the ones its trait impls deliver are
        // consulted only when none does.  Two traits providing the name is
        // an ambiguity reported here; an inherent method beside a trait
        // method that also applies is one the selection reports
        // (`report_inherent_trait_tie`), and the arguments are checked
        // against the inherent method.  A call stamped with a trait (an
        // operator's, a desugar's, a bound's) names that trait's method:
        // its candidates are that trait's methods alone.
        const want_trait: DefId = member.resolved_trait;
        for (mut pass: i32 = 1; pass <= 2; pass++) {
            if (pass == 2 && found) { break; }
            if (pass == 1 && want_trait.is_valid()) { continue; }
            mut walk: ClassType* = start_cls;
            mut cur: &[MethodInfo] = methods_ref;
            mut cur_owner: TypeRef = base_ref;
            mut depth: i32 = 0;
            while (depth < 16) {
                const named: [DeclarationNode*] = this.ctx.decl_index.methods_named(FamilyOwner::Type(cur_owner), member.member);
                for (mut mi: i64 = 0; mi < cur.length; mi++) {
                    const m: &MethodInfo = &cur[mi];
                    if (!DeclarationIndex::holds_method(&named, DeclarationNode::with_shape(m.ast_node))) { continue; }
                    const m_origin: DefId = this.method_origin_trait(m);
                    if (pass == 1 && m_origin.is_valid()) { continue; }
                    if (pass == 2 && !m_origin.is_valid()) { continue; }
                    if (want_trait.is_valid() && !m_origin.equals(want_trait)) { continue; }
                    if (this.method_type_is_variadic(m.function_type)) { variadic_ok = true; continue; }
                    name_seen  += 1;
                    uniq_arity  = this.diag.note_arity(uniq_arity, m.param_types.length);
                    if (m.param_types.length != argc) { continue; }
                    for (mut ci: i64 = 0; ci < m.param_types.length; ci++) {
                        cand_params.push(m.param_types[ci]);
                    }
                    if (m_origin.is_valid()) {
                        mut seen_trait: boolean = false;
                        for (mut ti: i64 = 0; ti < tie_traits.length; ti++) {
                            if (tie_traits[ti].equals(m_origin)) { seen_trait = true; break; }
                        }
                        if (!seen_trait) {
                            tie_traits.push(m_origin);
                            const tmn_decl: DeclarationNode* = DeclarationNode::with_shape(m.ast_node);
                            const tmn: MethodDecl* = DeclarationNode::method_of(tmn_decl);
                            tie_spans.push(if (tmn != null && tmn.func != null) {
                                if (tmn.func.has_name_span()) { tmn.func.name_span } else { tmn.func.span }
                            } else { SourceSpan::none() });
                        }
                    }
                    if (!found) {
                        found = true;
                        chosen = [];
                        for (mut ci: i64 = 0; ci < m.param_types.length; ci++) { chosen.push(m.param_types[ci]); }
                        const cmn_decl: DeclarationNode* = DeclarationNode::with_shape(m.ast_node);
                        const cmn: MethodDecl* = DeclarationNode::method_of(cmn_decl);
                        chosen_fn = if (cmn != null) { cmn.func } else { null };
                        found_trait = m_origin;
                    } else {
                        if (found_trait.is_valid() && m_origin.is_valid() && !m_origin.equals(found_trait)) {
                            trait_ambiguous = true;
                            other_trait = m_origin;
                        } else if (!this.types.same_param_sig(chosen.as_slice(), m.param_types.as_slice())) {
                            ambiguous = true;
                        }
                    }
                }
                if (walk == null) { break; }
                if (!walk.has_base || !walk.base_class.is_valid()) { break; }
                const parent_t: Type* = this.arena.lookup(walk.base_class);
                if (parent_t == null || parent_t.kind != TypeKind::Class) { break; }
                cur_owner = walk.base_class;
                walk = parent_t.as_class();
                cur = &walk.methods;
                depth += 1;
            }
        }

        // The trait impls are candidates only when no inherent method took
        // the call.
        if (!ambiguous && !trait_ambiguous && !(found && !found_trait.is_valid())
) {
            // The impls selected for the receiver: a placed clone when it is
            // a specialization, else the written heads that unify with it and
            // whose bounds hold.
            const blocks: [ImplBlock*] = this.trait_checker().impls_of(base_ref);
            if (blocks.length > 0) {
                for (mut ti: i64 = 0; ti < blocks.length; ti++) {
                    if (ambiguous || trait_ambiguous) { break; }
                    const block: ImplBlock* = blocks[ti];
                    if (want_trait.is_valid() && !block.trait_def.equals(want_trait)) { continue; }
                    const block_named: [DeclarationNode*] = this.block_methods_named(block, member.member);
                    for (mut bmi: i64 = 0; bmi < block.methods.length; bmi++) {
                        const mn_decl: DeclarationNode* = block.methods[bmi];
                        const mn: MethodDecl* = DeclarationNode::method_of(mn_decl);
                        if (mn == null || mn.func == null) { continue; }
                        const fn_node_decl: DeclarationNode* = mn.func;
                        const fn_node: FunctionDecl* = DeclarationNode::fn_of(fn_node_decl);
                        if (!DeclarationIndex::holds_method(&block_named, mn_decl)) { continue; }
                        if (fn_node.is_variadic) { variadic_ok = true; continue; }
                        mut tparams: [TypeRef] = [];
                        for (mut pi: i64 = 0; pi < fn_node.parameters.length; pi++) {
                            const pp_decl: DeclarationNode* = fn_node.parameters[pi];
                            const pp: VarDecl* = DeclarationNode::var_of(pp_decl);
                            if (pp == null) { continue; }
                            if (pp.is_receiver()) { continue; }
                            tparams.push(pp.resolved_type);
                        }
                        name_seen  += 1;
                        uniq_arity  = this.diag.note_arity(uniq_arity, tparams.length);
                        if (tparams.length != argc) { mem::drop(tparams); continue; }
                        for (mut ci: i64 = 0; ci < tparams.length; ci++) {
                            cand_params.push(tparams[ci]);
                        }
                        if (!found) {
                            found = true;
                            chosen = tparams;
                            chosen_fn = fn_node_decl;
                            found_trait = block.trait_def;
                        } else {
                            const same: boolean = this.types.same_param_sig(chosen.as_slice(), tparams.as_slice());
                            mem::drop(tparams);
                            const cand_trait: DefId = block.trait_def;
                            if (found_trait.is_valid() && cand_trait.is_valid()
                                    && !cand_trait.equals(found_trait)) {
                                trait_ambiguous = true;
                                other_trait = cand_trait;
                                break;
                            } else if (!same) {
                                ambiguous = true;
                                break;
                            }
                        }
                    }
                }
            }
        }

        if (trait_ambiguous && !member.resolved_trait.is_valid()) {
            this.report_method_call_tie(call, member, base_ref, &tie_traits, &tie_spans, null);
            return;
        }
        // Several arity-matching signatures is an overload SET, not a reason to
        // stop checking.  There is no single `chosen` to compare against, but
        // `resolve_method_overload` ran first and has already decided which
        // member this call names; when it bound nothing, no candidate accepts
        // these arguments.  Returning silently hands such a call to codegen,
        // whose name+arity fallback picks a same-named sibling and reads the
        // argument at THAT signature's parameter type - a reinterpretation with
        // no diagnostic, where a single candidate would have produced E0214.
        if (ambiguous) {
            if (!call.resolved_callee.decl_entry().is_valid()) {
                this.emit_no_matching_overload(call, member, base_ref, cand_params, argc);
            }
            return;
        }
        if (found) {
            const params: [TypeRef] = this.method_call_params(call, chosen_fn, &chosen);
            this.check_args_against_params(visitor, &call.arguments, params.as_slice());
            return;
        }
        if (variadic_ok) { return; }
        if (name_seen > 0) {
            this.diag.emit_method_arity_error(call.span, member.member, "method", uniq_arity, argc, false);
        }
    }

    /// `check_method_call_arg_types` for a call on an instantiation not yet
    /// minted that the selection bound to nothing.  The candidates are the
    /// ones `select_on_template` tried - the template's inherent methods,
    /// then, when none has the member's name, the trait impls selected for
    /// the instantiation - with their parameters seen through it (`push(x: T)`
    /// on an `Array<i64>` takes an `i64`).  One candidate of the call's arity
    /// checks the arguments against its parameters, as on a minted receiver;
    /// several is an overload set none of which took them.
    check_args_on_template(mut &this, visitor: SemaVisitor*, call: CallExprNode*,
                           member: MemberAccessNode*, owner_inst: TypeRef) -> void {
        mut found: ArgCandidates = ArgCandidates::new(call.arguments.length);
        if (!this.collect_on_template(visitor, call, member, owner_inst, &found)) { return; }
        if (found.count == 1) {
            this.check_args_against_params(visitor, &call.arguments, found.params.as_slice());
        } else if (found.count > 1) {
            this.emit_no_matching_overload(call, member, owner_inst, &found.params, found.argc);
        } else if (!found.variadic && found.name_seen > 0) {
            this.diag.emit_method_arity_error(call.span, member.member, "method", found.uniq_arity,
                found.argc, false);
        }
    }

    /// Record in `found` the candidates the selection tries for `call` on
    /// the instantiation `owner_inst`, not minted yet: the template's
    /// inherent methods, then, when none has the member's name, the trait
    /// impls selected for the instantiation, each with its parameters seen
    /// through it.  False when `owner_inst` names no template.
    collect_on_template(mut &this, visitor: SemaVisitor*, call: CallExprNode*,
                        member: MemberAccessNode*, owner_inst: TypeRef, found: ArgCandidates*) -> boolean {
        const tmpl: TemplateEntry* = this.ctx.generic_registry.template_of_type(
            this.arena.inst_generic_base(owner_inst));
        if (tmpl == null) { return false; }
        mut sel: Selection = Selection::none();
        sel.owner_inst = owner_inst;
        sel.recv = owner_inst;
        sel.collect = found;
        const no_args: [TypeRef] = [];
        this.select_on_template(visitor, call, member, tmpl, &no_args, DefId::invalid(), false, false, &sel);
        this.select_on_template(visitor, call, member, tmpl, &no_args, DefId::invalid(), false, true, &sel);
        if (found.name_seen == 0) {
            this.select_on_template(visitor, call, member, tmpl, &no_args, DefId::invalid(), true, false, &sel);
            this.select_on_template(visitor, call, member, tmpl, &no_args, DefId::invalid(), true, true, &sel);
        }
        return true;
    }

    /// Record in `found` a candidate the selection tried, with its
    /// parameters seen through `view` (null: as declared) when it has the
    /// call's arity.
    record_candidate(mut &this, fn_node_decl: DeclarationNode*, params: &[TypeRef],
                     view: TypeSubstitution*, found: ArgCandidates*) -> void {
        const fn_node: FunctionDecl* = DeclarationNode::fn_of(fn_node_decl);
        if (fn_node.is_variadic) { found.variadic = true; return; }
        found.name_seen += 1;
        found.uniq_arity = this.diag.note_arity(found.uniq_arity, params.length);
        if (params.length != found.argc) { return; }
        found.count += 1;
        for (mut ci: i64 = 0; ci < params.length; ci++) {
            found.params.push(if (view != null) { this.seen_through(view, params[ci]) } else { params[ci] });
        }
    }

    /// The type arguments of an instantiation, in order.
    inst_args(&this, inst: TypeRef) -> [TypeRef] {
        mut args: [TypeRef] = [];
        for (mut ai: i64 = 0; ai < this.arena.inst_type_arg_count(inst); ai++) {
            args.push(this.arena.inst_type_arg_at(inst, ai));
        }
        return args;
    }

    /// How the methods written in `block` see an instantiation not yet
    /// minted: the block's own parameters bound by its head (`T` in
    /// `implement enum Option<T>`, for `Option<u8>`, is `u8`) and by its
    /// where-clause.
    impl_view(mut &this, block: ImplBlock*, owner_inst: TypeRef) -> TypeSubstitution {
        mut view: TypeSubstitution = TypeSubstitution::empty();
        const args: [TypeRef] = this.inst_args(owner_inst);
        this.trait_checker().add_head_param_bindings(block, &args, &view);
        this.bind_where_only_params(block, &view);
        return view;
    }


    // -- Direct (free-function) call resolution --

    /// Pin a bare call to one signature of the family its callee names.
    ///
    /// The family is the stamp's canonical name (`callee_family`), and the
    /// only key asked: every signature of a declaration is registered under
    /// it, and nothing outside it is a candidate.  What used to stand here
    /// asked the writing module's qualifier and then the bare leaf, and the
    /// leaf's list holds every module's declaration of that name - so the
    /// selection then had to classify each candidate by the use site's
    /// imports, and refuse a tie, and it still bound an intrinsic's C symbol
    /// where the stamp named the exported wrapper.  A `Def` is already the
    /// answer to which declaration; only which SIGNATURE is decided here.
    try_pin_overload_mangled_callee(mut &this, call: CallExprNode*, ident: IdentifierNode*) -> TypeRef {
        if (call.resolved_callee.is_some()) { return TypeRef::invalid(); }
        // GATED: a generic function template has no concrete spec pre-mono; leave
        // unpinned so mono specializes.
        const gen_tmpl: TemplateEntry* = this.find_fn_template_for_call(ident, call.arguments.length);
        if (gen_tmpl != null && gen_tmpl.param_types.length > 0) { return TypeRef::invalid(); }
        return this.pin_family_signature(call, this.callee_def(ident), null);
    }

    /// Pin `call` to the signature of `callee`'s family its arguments select,
    /// and answer that signature's return.  The family's entries come through
    /// the member-function door, by the declaration's owner and leaf; which
    /// entry is the selection (`select_family_overload`).  Invalid, pinning
    /// nothing, when an argument is untyped or no signature accepts them.
    /// Shared by a bare call and a module-qualified one, whose path is
    /// `scope` (null for a bare call): both name a declaration, and which of
    /// its signatures a call means is one question.
    pin_family_signature(mut &this, call: CallExprNode*, callee: DefId,
                         scope: ScopeResolutionNode*) -> TypeRef {
        if (call == null || call.resolved_callee.is_some()) { return TypeRef::invalid(); }
        mut arg_types: [TypeRef] = [];
        for (mut ai: i64 = 0; ai < call.arguments.length; ai++) {
            const arg: ExpressionNode* = call.arguments[ai];
            if (arg == null || !arg.resolved_type.is_valid()) { return TypeRef::invalid(); }
            arg_types.push(arg.resolved_type);
        }
        const entries: [OverloadId] = this.family_entries(callee);
        if (entries.length == 0) { return TypeRef::invalid(); }
        mut overloads: [TypeRef] = [];
        for (mut ei: i64 = 0; ei < entries.length; ei++) {
            overloads.push(this.ctx.decl_index.entry_signature(entries[ei]));
        }
        const oi: i64 = this.select_family_overload(&overloads, &arg_types);
        if (oi < 0) {
            this.refuse_unmatched_family_call(call, this.intern.shown(this.ctx.defs.leaf_of(callee)),
                &overloads, &arg_types);
            return TypeRef::invalid();
        }
        this.report_free_generic_tie(call, callee, scope, &arg_types);
        // The pin is the selected entry: the declaration and the one of its
        // signatures the arguments chose, carrying its own symbol.
        call.set_resolved_callee(CalleePin::Decl(entries[oi]));
        // Among several signatures, the arguments were classified only
        // where the signatures agree; the one selected decides the rest.
        if (entries.length > 1) {
            const sel_t: Type* = this.arena.lookup(overloads[oi]);
            if (sel_t != null && sel_t.kind == TypeKind::Function) {
                this.classify_args_from_params(call, sema_copy_type_refs(&sel_t.as_function().param_types));
            }
        }
        return this.overload_return_type(overloads[oi]);
    }

    /// E0154 when a non-generic signature of `callee`'s family and one of its
    /// generic functions both accept the arguments of `call`, and true then.
    /// A function is not preferred for being non-generic, as a method is
    /// not, so the call is ambiguous.  Asked by a bare call and a
    /// module-qualified one alike, whichever declaration the name layer
    /// stamped; the caller keeps whatever it pinned, so the tie is the one
    /// error the call reports.  A type argument, on the call or on the path
    /// `scope` (null for a bare call), names the generic function, so no tie.
    report_free_generic_tie(mut &this, call: CallExprNode*, callee: DefId,
                            scope: ScopeResolutionNode*, arg_types: &[TypeRef]) -> boolean {
        if (call.generic_args.length > 0) { return false; }
        if (scope != null && scope.generic_args.length > 0) { return false; }
        const entries: [OverloadId] = this.family_entries(callee);
        if (entries.length < 2) { return false; }
        mut plain: OverloadId = OverloadId::invalid();
        mut generics: [OverloadId] = [];
        for (mut i: i64 = 0; i < entries.length; i++) {
            const d: ASTNode* = this.ctx.decl_index.entry_decl(entries[i]);
            if (d == null || DeclarationNode::fn_of(d) == null) { continue; }
            const f_decl: DeclarationNode* = DeclarationNode::with_shape(d);
            const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
            if (f.generic_params.length == 0) {
                if (!plain.is_valid()
                        && this.signature_accepts(this.ctx.decl_index.entry_signature(entries[i]), arg_types)) {
                    plain = entries[i];
                }
                continue;
            }
            const t: TemplateEntry* = this.ctx.generic_registry.template_of(f.def);
            if (t == null || t.kind != TemplateKind::Function) { continue; }
            if (!this.template_fits(t, call, null, arg_types)) { continue; }
            // A generic whose where-clause the arguments fail does not
            // accept them.
            const binds: [TypeRef] = this.template_call_bindings(call, null, t, f_decl);
            mut unmet_arg: TypeRef = TypeRef::invalid();
            if (this.unmet_call_bound(f_decl, &t.param_syms, &binds, &unmet_arg) != null) { continue; }
            generics.push(entries[i]);
        }
        if (!plain.is_valid() || generics.length == 0) { return false; }
        const leaf: string = this.intern.shown(this.ctx.defs.leaf_of(callee));
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0154_AMBIGUOUS_CALL,
            fmt::format("`%s` is ambiguous: a non-generic and a generic function both accept these arguments", leaf));
        d = d.at_with_label(call.span, "both functions apply here");
        d = d.with_note_at(fmt::format("candidate #1: `%s`, not generic", leaf),
            this.ctx.decl_index.entry_span(plain));
        for (mut i: i64 = 0; i < generics.length; i++) {
            d = d.with_note_at(fmt::format("candidate #%d: `%s`, generic", (i + 2) as i32, leaf),
                this.ctx.decl_index.entry_span(generics[i]));
        }
        d = d.help(fmt::format(
            "a function is not preferred for being non-generic; rename one of them, or call the generic one with its type arguments (`%s::<T>(...)`)",
            leaf));
        this.ctx.emit_diagnostic(d);
        return true;
    }

    /// E0214 for a call to an overloaded family that no signature of the
    /// call's arity accepts, as for a method.  A family with no signature of
    /// that arity is the arity check's to report.  An integer literal is
    /// `i32` wherever the signatures differ in its type, so a literal only
    /// another width accepts is refused here, with the help to write it.
    /// `leaf` is the family's name as the candidates are shown.
    refuse_unmatched_family_call(mut &this, call: CallExprNode*, leaf: string,
                                 overloads: &[TypeRef], arg_types: &[TypeRef]) -> void {
        if (this.state.in_symbolic_check || overloads.length < 2) { return; }
        const argc: i64 = arg_types.length;
        mut literal: boolean = false;
        for (mut i: i64 = 0; i < argc; i++) {
            if (!this.types.arg_type_is_concrete(arg_types[i])) { return; }
            if (is_numeric_literal_expr(call.arguments[i]) || is_negative_numeric_literal_expr(call.arguments[i])) {
                literal = true;
            }
        }
        // The signatures of the call's arity, their parameters end to end.
        mut cand_params: [TypeRef] = [];
        mut count: i64 = 0;
        for (mut oi: i64 = 0; oi < overloads.length; oi++) {
            const t: Type* = this.arena.lookup(overloads[oi]);
            if (t == null || t.kind != TypeKind::Function) { continue; }
            const ft: FunctionType* = t.as_function();
            if (ft.param_types.length != argc) { continue; }
            for (mut p: i64 = 0; p < argc; p++) {
                cand_params.push(ft.param_types[p]);
                // A generic parameter takes a literal's type; it does not
                // fix one.
                if (this.types.contains_generic_param(ft.param_types[p])) { literal = false; }
            }
            count = count + 1;
        }
        if (count == 0) { return; }
        mut cands: string = "candidates are ";
        for (mut c: i64 = 0; c < count; c++) {
            if (c > 0) { cands = cands + ", "; }
            cands = cands + "`" + leaf + this.render_param_list(&cand_params, c * argc, argc) + "`";
        }
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0214_ARGUMENT_MISMATCH,
            fmt::format("no overload of `%s` accepts these arguments", leaf));
        diag = diag.at_with_label(call.span, fmt::format("no `%s` takes `%s`", leaf,
            this.render_param_list(arg_types, 0, argc)));
        diag = diag.with_note(cands);
        if (literal) {
            diag = diag.help(
                "an integer literal is `i32` where the overloads differ in its type; write the type you mean with `as`");
        }
        this.ctx.emit_diagnostic(diag);
    }

    /// Visibility is a GATE, not a tie-breaker.  Emits E0353 when
    /// `callee` belongs to another module and is not public.
    ///
    /// Each early `return` is a deliberate refusal to judge, because the
    /// failure mode this gate must not have is the FALSE POSITIVE, not
    /// the miss:
    ///
    ///   - a symbolic/trial walk is in progress: those bind speculatively;
    ///   - the callee has no owning namespace - an `extern "C"` twin or an
    ///     intrinsic, which is not a module member to enforce against;
    ///   - the use site is UNKNOWN.  `call_use_site_module` answers no module
    ///     when nothing names the span's module, and no module is unequal to
    ///     every real one - judging here would reject every call rather than
    ///     none;
    ///   - the use site IS the declaring module.  The use site is where the
    ///     syntax was written, not the module the compiler stands in: a
    ///     generic body is typed with the cursor on its receiver's module.
    ///
    /// This REPORTS; it does not change which symbol binds.  Removing a private
    /// candidate from overload selection would silently rebind the call to a
    /// different function, and a wrong bind is a miscompile that every gate in
    /// this repo stays green through.  A hard error is the honest one.
    enforce_callee_visibility(mut &this, callee: DefId, use_module: ModulePath,
                              span: SourceSpan) -> void {
        if (this.state.in_symbolic_check) { return; }
        if (!this.ctx.decl_index.hidden_from(callee, this.ctx.module_def_of(use_module))) { return; }
        const callee_str: string = this.intern.shown(this.ctx.defs.path_of(callee));
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0353_PRIVATE_ACCESS,
            fmt::format("`%s` is private and cannot be called from `%s`",
                callee_str, this.intern.shown(use_module.decl_name())));
        d = d.at_with_label(span,
            fmt::format("`%s` is private to its declaring module", callee_str));
        d = d.with_note("declare it `public` to allow calls from other modules");
        this.ctx.emit_diagnostic(d);
    }

    /// Gate a function named in VALUE position (`const f: () -> i32 = door5;`).
    ///
    /// `enforce_callee_visibility` is reached only from call paths, so a
    /// reference that never becomes a call is never offered to it - not a
    /// branch that answered wrong, a lane that was never asked.  This is where
    /// it asks.  `def` is the stamp, the writer's own answer, which needs no
    /// resolution against any module.
    enforce_value_ref_visibility(mut &this, def: DefId, span: SourceSpan) -> void {
        this.enforce_callee_visibility(def, this.call_use_site_module(span), span);
    }

    /// The function a qualified path in VALUE position names, or an invalid
    /// TypeRef when it names none.
    ///
    /// Resolved through `resolve_module_qualified_def` - the same declaration
    /// the CALL form of this path resolves through - so `Ns::Mod::f` and
    /// `Ns::Mod::f()` cannot disagree about which function they mean.  The
    /// value form is gated here because it reaches no other gate.
    lookup_scope_value_function(mut &this, scope: ScopeResolutionNode*) -> TypeRef {
        mut callee: DefId = this.resolve_module_qualified_def(scope);
        if (!callee.is_valid()) { return TypeRef::invalid(); }
        mut ft: TypeRef = this.ctx.decl_index.func_type_of_def(callee);
        if (!ft.is_valid()) { return TypeRef::invalid(); }
        const shown: string = fmt::format("%s::%s",
            this.intern.resolve(scope.scope_name), this.intern.resolve(scope.member_name));
        // A family holding a generic function: the overload the turbofish
        // and the expected type choose.
        mut chosen: OverloadId = OverloadId::invalid();
        if (!scope.resolved_callee.is_some()) {
            mut refused: boolean = false;
            chosen = this.value_family_entry(callee, &scope.generic_args, shown, scope.span,
                scope as ExpressionNode*, &refused);
            if (refused) { return TypeRef::invalid(); }
            if (chosen.is_valid()) {
                callee = DeclarationNode::fn_of(this.ctx.decl_index.entry_decl(chosen)).def;
                ft = this.ctx.decl_index.entry_signature(chosen);
            }
        }
        this.enforce_callee_visibility(callee, this.call_use_site_module(scope.span),
            scope.span);
        // The pin is the entry the function's family is emitted as, read off
        // the definition, as the call form's is.  A function TEMPLATE's value
        // is one instance of it, whose template and type arguments are kept
        // on the node for monomorphization to pin.
        const tmpl: TemplateEntry* = this.ctx.generic_registry.template_of(callee);
        if (tmpl != null && tmpl.kind == TemplateKind::Function) {
            if (scope.resolved_callee.is_some()) { return ft; }
            mut args: [TypeRef] = [];
            const inst_ty: TypeRef = this.generic_value_type(tmpl, &tmpl.param_types, ft, &scope.generic_args,
                shown, fmt::format("%s::<...>", shown), scope.span, &args);
            if (inst_ty.is_valid()) {
                scope.value_template = tmpl.base_type;
                scope.value_type_args = args;
            }
            return inst_ty;
        }
        if (!scope.resolved_callee.is_some()) {
            if (chosen.is_valid()) {
                scope.set_resolved_callee(CalleePin::Decl(chosen));
                return ft;
            }
            const family: [OverloadId] = this.family_entries(callee);
            const sole: OverloadId = this.sole_entry(&family);
            if (sole.is_valid()) { scope.set_resolved_callee(CalleePin::Decl(sole)); }
        }
        return ft;
    }

    /// Gate the static method a `Type::method(...)` call is about to pin.
    ///
    /// Placed at the pin rather than at each resolution branch because all four
    /// static-bind paths funnel here, and shutting three of four is
    /// indistinguishable from shutting all four unless one function sees them
    /// all.  A `scope_sym` that names a MODULE rather than a type resolves to no
    /// type, finds no method, and falls out without a verdict - module-qualified
    /// free functions keep their own door.
    enforce_static_method_visibility(mut &this, owner: TypeRef, member_sym: SymbolStr,
                                     span: SourceSpan) -> void {
        if (this.state.in_symbolic_check) { return; }
        // `owner` is the type the call binds against, as its caller holds it -
        // the segment's own type, a specialization, a DI key's type - never a
        // name to look up again.  A written qualifier that makes no type claim
        // names a module, which owns no method to gate.
        if (!owner.is_valid()) { return; }
        this.member.enforce_method_visibility(owner, member_sym, span);
    }

    overload_return_type(&this, fn_ref: TypeRef) -> TypeRef {
        const ft: Type* = this.arena.lookup(fn_ref);
        if (ft == null || ft.kind != TypeKind::Function) { return TypeRef::invalid(); }
        return ft.as_function().return_type;
    }

    /// What a generic function's instance returns, read off the entry its
    /// copy registered; invalid before the copy is registered.
    instance_return_type(&this, inst: TypeRef) -> TypeRef {
        const e: OverloadId = this.ctx.decl_index.entry_of_instance(inst);
        if (!e.is_valid()) { return TypeRef::invalid(); }
        return this.overload_return_type(this.ctx.decl_index.entry_signature(e));
    }

    overload_param_matches_arg(&this, param: TypeRef, arg: TypeRef) -> boolean {
        if (param.equals(arg)) { return true; }
        const pt: Type* = this.arena.lookup(param);
        const at: Type* = this.arena.lookup(arg);
        if (pt == null || at == null) { return false; }
        if (pt.kind == TypeKind::Pointer && at.kind == TypeKind::Reference) {
            return pt.as_pointer().pointee.equals(at.as_reference().referent);
        }
        if (pt.kind == TypeKind::Reference && at.kind == TypeKind::Pointer) {
            return pt.as_reference().referent.equals(at.as_pointer().pointee);
        }
        return false;
    }

    resolve_direct_call(mut &this, call: CallExprNode*, ident: IdentifierNode*) -> TypeRef {
        // The name layer's own answer for this callee, and the only one asked.
        // A local is a value: when its type is callable, the call's type is
        // that signature's return, whatever global shares the leaf.  A
        // definition is a canonical name and names ONE declaration; asking
        // the bare leaf instead answers from whichever module registered it
        // last, which is a different function.  A refused name has already
        // been reported by the resolver that refused it, and is not reported
        // again as a name that does not exist.
        mut stamped_r: Res = Res::Err;
        match (ident.res) {
            ResSlot::Answered(r) => {
                match (r) {
                    Res::Local(sym) => {
                        const fp_local: TypeRef = this.scopes.type_of(sym);
                        if (fp_local.is_valid()) {
                            const fp_t: Type* = this.arena.lookup(fp_local);
                            if (fp_t != null && fp_t.kind == TypeKind::Function) {
                                ident.set_resolved_type(fp_local);
                                return fp_t.as_function().return_type;
                            }
                            // A local is a value, and one of no function type is
                            // not called: E0213 at the callee, as for a computed one.
                            this.refuse_call_of_non_function(ident.span, fp_local);
                            return TypeRef::invalid();
                        } else if (this.scopes.binds(sym)) {
                            // Bound, with no type: reported at the declaration.
                            return TypeRef::invalid();
                        }
                    }
                    Res::Err => { return TypeRef::invalid(); }
                    _        => { stamped_r = r; }
                }
            }
            _ => {}
        }
        // The return type is the stamped signature's own, asked by the id.
        const func_ret: TypeRef = this.overload_return_type(
            this.ctx.decl_index.func_type_of_res(stamped_r));
        if (func_ret.is_valid()) {
            if (this.state.expected_type.is_valid()) {
                const ret_t: Type* = this.arena.lookup(func_ret);
                if (ret_t != null) {
                    if (ret_t.kind == TypeKind::FunctionTemplate) { return this.state.expected_type; }
                    if (ret_t.kind == TypeKind::InstantiatedType) {
                        const inst: InstantiatedType* = ret_t.as_instantiated();
                        if (!inst.has_resolved_type() && this.types.contains_generic_param(func_ret)) {
                            return this.state.expected_type;
                        }
                    }
                }
            }
            return func_ret;
        }
        // A module's global is a value, called as a local is: through a
        // function type, and E0213 at the callee for any other type.
        const global_ty: TypeRef = this.types.spelling_global(ident.res);
        if (global_ty.is_valid()) {
            const g_t: Type* = this.arena.lookup(global_ty);
            if (g_t != null && g_t.kind == TypeKind::Function) {
                ident.set_resolved_type(global_ty);
                return g_t.as_function().return_type;
            }
            this.refuse_call_of_non_function(ident.span, global_ty);
            return TypeRef::invalid();
        }
        // The name layer's own answer for this identifier, which is a canonical
        // name and so names one declaration; a slot it did not answer names
        // nothing the index holds a type for.
        const stamped_ty: TypeRef = this.types.spelling_type(ident.res);
        if (stamped_ty.is_valid()) { return this.construction_instance(call, stamped_ty); }

        // Bound, and to nothing callable: a callee no rib bound was refused
        // where it was written (E0202, with the owners of the leaf and the
        // nearest visible function) and returned `Err` above.  A slot
        // nothing answered is a bug, not a name to report.
        match (ident.res.require("sema/resolve_direct_call")) {
            Res::Err => { return TypeRef::invalid(); }
            _        => { }
        }
        // Bound to a declaration whose signature was refused where it was
        // written: it has no signature to type the call by, and it exists.
        if (this.ctx.defs.signature_refused(stamped_r.def_id())) { return TypeRef::invalid(); }
        const name: string = this.intern.resolve(ident.name);
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0202_UNDEFINED_FUNCTION,
            fmt::format("cannot find function `%s` in this scope", name));
        diag = diag.at_with_label(ident.span, "not found in this scope");
        this.ctx.emit_diagnostic(diag);
        return TypeRef::invalid();
    }


    // -- Method overload selection (pins resolved_callee) --

    /// Pin a method call to the method's own registered entry.  The node is
    /// the declaration sema bound the call to; its entry carries the symbol
    /// registration computed for it - a `![symbol]` link name, a generic
    /// specialization's `$MG` disambiguator, a trait impl's trait - so
    /// nothing is mangled here.  A method the index never registered (a
    /// deferred combinator template) is left unpinned.
    pin_method_callee(mut &this, call: CallExprNode*, mn_decl: DeclarationNode*, is_static: boolean) -> void {
        const mn: MethodDecl* = DeclarationNode::method_of(mn_decl);
        if (mn == null || mn.func == null) { return; }
        const fn_node_decl: DeclarationNode* = mn.func;
        const fn_node: FunctionDecl* = DeclarationNode::fn_of(fn_node_decl);
        if (!fn_node.resolved_return_type.is_valid()) { return; }
        // GATED (R2): never stomp mono's exact-spec pin with a generic template's entry.
        if (fn_node.generic_params.length > 0 && call.resolved_callee.is_some()) { return; }
        if (!fn_node.overload_entry.is_valid()) { return; }
        call.set_resolved_callee(CalleePin::Decl(fn_node.overload_entry));
    }

    /// Pin `resolved_callee` for an instance method call.  Candidates are
    /// the receiver's own methods (walking a class's base chain), then the
    /// inherent blocks of a primitive, then its trait impls; each set is
    /// tried at every binding tier before the next set is consulted.  Leaves
    /// it unset on no match.
    /// Returns what `bind_method_on_receiver` returns.
    resolve_method_overload(mut &this, visitor: SemaVisitor*, call: CallExprNode*,
                            member: MemberAccessNode*) -> Selection {
        const obj_type: TypeRef = visitor.resolve_expr(member.object);
        if (!obj_type.is_valid()) { return Selection::none(); }
        return this.bind_method_on_receiver(visitor, call, member, obj_type);
    }

    /// Overload selection against a receiver whose type is already in hand.
    /// A call another pass synthesizes (a scope-exit `.drop()`, drop glue's
    /// `.field.drop()`) carries its receiver's type on the node but sits in
    /// no scope the identifier could be re-resolved from, so it enters here
    /// and is bound exactly as a written call is.
    ///
    /// Returns the selection: the method the call names - the pin, or, for a
    /// receiver that is an instantiation not yet minted, its template's
    /// method, selected but not pinned.  Such a receiver has no method set of its own until
    /// monomorphization mints it; the template's methods, seen through the
    /// receiver's arguments, are what the call can name before then.  The
    /// pin is left to the pass that sees the minted type: a template method
    /// pinned here reads to mono as a call needing no specialization.
    bind_method_on_receiver(mut &this, visitor: SemaVisitor*, call: CallExprNode*,
                            member: MemberAccessNode*, obj_type: TypeRef) -> Selection {
        // A member answered as a function-typed field where it was written
        // - in this body, or in the template a copy was made from - is a
        // call through that field's value; no method is selected for it.
        const through_field: boolean = match (member.resolved_member) {
            MemberPin::Field(_, _) => { true }
            _                      => { false }
        };
        if (through_field) { return Selection::none(); }
        // A call that is already bound stays bound.  Mono binds a generic
        // method call to the specialization it minted - a clone with no
        // generic parameters left, under the `$MG` symbol - and selecting
        // again here can only find the TEMPLATE, which a parameterless method
        // (`v.as<Str>()`) matches exactly.
        const bound: OverloadId = call.resolved_callee.decl_entry();
        if (bound.is_valid()) {
            return Selection::of(this.ctx.decl_index.entry_method(bound));
        }
        mut base_ref: TypeRef = obj_type;
        mut base_t: Type* = this.arena.lookup(obj_type);
        mut owner_inst: TypeRef = TypeRef::invalid();
        mut unwrap_depth: i32 = 0;
        while (base_t != null && unwrap_depth < 5) {
            if (base_t.kind == TypeKind::Pointer) {
                base_ref = base_t.as_pointer().pointee;
                base_t = this.arena.lookup(base_ref);
            } else if (base_t.kind == TypeKind::Reference) {
                base_ref = base_t.as_reference().referent;
                base_t = this.arena.lookup(base_ref);
            } else if (base_t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = base_t.as_instantiated();
                if (!inst.has_resolved_type()) {
                    owner_inst = base_ref;
                    base_ref = inst.generic_base;
                    base_t = this.arena.lookup(base_ref);
                    break;
                }
                base_ref = inst.resolved_type;
                base_t = this.arena.lookup(base_ref);
            } else {
                break;
            }
            unwrap_depth += 1;
        }

        // A call the compiler generated names its method by definition and
        // is bound by that identity alone.
        if (call.named_method.is_valid()) {
            return this.bind_named_method(visitor, call, member, base_ref, owner_inst);
        }
        // A call a generic body's template pinned is bound by that identity
        // in each copy of the body whose receiver is minted: to the
        // receiver's entry for the pinned definition, or, for a method with
        // type parameters of its own, after monomorphization, to the instance
        // monomorphization made of it for the call and pinned, which the
        // guard above answers.  A copy with no instance pinned leaves the
        // call unbound, which monomorphization reports; nothing selects it
        // again by its member's name.
        const pinned_fn_decl: DeclarationNode* = this.ctx.decl_index.method_func_of(call.template_method);
        const pinned_fn: FunctionDecl* = DeclarationNode::fn_of(pinned_fn_decl);
        if (call.template_method.is_valid() && !owner_inst.is_valid()
                && !this.types.contains_generic_param(base_ref)) {
            if (pinned_fn == null || !pinned_fn.is_generic()) {
                return this.bind_template_method(visitor, call, base_ref);
            }
        }
        if (!member.resolved_trait.is_valid()) {
            mut copied: BoundDirection = BoundDirection::none();
            this.binding.default_copy_bound_return(obj_type, member.member, &copied);
            if (copied.named().is_valid()) { this.stamp_trait_item(member, copied.named()); }
        }

        if (base_t == null) { return Selection::none(); }
        mut methods_ref: Slice<MethodInfo> = Slice::<MethodInfo>::from_raw(null, 0);
        mut start_cls: ClassType* = null;
        // A declared owner has a path; a primitive is declared nowhere and
        // is an owner by its kind.
        mut has_owner: boolean = false;
        match (base_t.kind) {
            TypeKind::Class => {
                start_cls = base_t.as_class();
                methods_ref = start_cls.methods.as_slice();
                has_owner = start_cls.qualified_name.is_valid();
            }
            TypeKind::Struct => {
                methods_ref = base_t.as_struct().methods.as_slice();
                has_owner = base_t.as_struct().qualified_name.is_valid();
            }
            TypeKind::Enum => {
                methods_ref = base_t.as_enum().methods.as_slice();
                has_owner = base_t.as_enum().qualified_name.is_valid();
            }
            TypeKind::Int | TypeKind::Float | TypeKind::Bool
            | TypeKind::Char | TypeKind::String | TypeKind::Unit => {
                has_owner = true;
            }
            _ => { return Selection::none(); }
        }
        if (!has_owner) { return Selection::none(); }

        mut arg_types: [TypeRef] = [];
        for (mut ai: i64 = 0; ai < call.arguments.length; ai++) {
            const arg_expr: ExpressionNode* = call.arguments[ai];
            if (arg_expr == null) { return Selection::none(); }
            if (!arg_expr.resolved_type.is_valid()) { return Selection::none(); }
            arg_types.push(arg_expr.resolved_type);
        }

        // Bound-directed dispatch.  A node stamped with the trait its call
        // names (`fst.fmt(f)` inside `Display for Pair`, or a call a bound
        // answered in a generic body) selects that trait's method ahead of
        // any other: `Display::fmt` and `Debug::fmt` share a name, a
        // signature and a receiver, so nothing but the stamp can tell them
        // apart, and a type substituted for a bounded parameter may declare
        // an inherent method of the name that the generic body never saw.
        // On a minted receiver the stamp's recorded position answers through
        // the implementations' tables (`bind_trait_item`); the selection by
        // name below serves the call where it is written, before
        // monomorphization.  Compared by identity: the stamp is
        // the trait's canonical name, and so is a method's `origin_trait`
        // and an impl head's `trait_def`.  Two traits can share a leaf, and
        // a leaf comparison binds whichever of them registered first.
        //
        // Unstamped, the inherent methods and the trait methods are two
        // sets and neither outranks the other: when both have a method the
        // arguments bind to, whether either is generic, the call is
        // ambiguous (`report_inherent_trait_tie`).  Within each set a
        // generic method's own type parameters bind by unification with the
        // arguments, and the generic candidates are tried after the others.
        const want_trait: DefId = member.resolved_trait;
        mut sel: Selection = Selection::none();
        sel.owner_inst = owner_inst;
        sel.recv = if (owner_inst.is_valid()) { owner_inst } else { base_ref };
        // The template's arena type carries no methods; its declaration and
        // the impl blocks attached to it do.
        mut tmpl: TemplateEntry* = null;
        if (owner_inst.is_valid()) {
            tmpl = this.ctx.generic_registry.template_of_type(base_ref);
            if (tmpl == null) { return Selection::none(); }
        }
        // On a minted receiver, a call that recorded its trait method's
        // position names the method the receiver's implementation of that
        // trait provides there.  A method with type parameters of its own,
        // or a default instantiated per call, is bound to its specialization
        // instead, and selected below.
        if (want_trait.is_valid() && tmpl == null && member.resolved_trait_slot >= 0) {
            const items: [DeclarationNode*] = this.trait_item_answers(member, base_ref);
            if (CallResolver::all_plain_methods(&items)) {
                return this.bind_trait_item(visitor, call, &items, &arg_types);
            }
        }
        if (want_trait.is_valid() && this.select_in_set(visitor, call, member, base_ref, base_t, start_cls,
                methods_ref, &arg_types, tmpl, want_trait, true, &sel)) {
            if (tmpl == null) { this.check_trait_item_table(member, base_ref, sel.chosen); }
            this.pin_minted_method(call, sel, base_ref);
            return this.commit_selection(visitor, call, sel);
        }
        if (this.select_in_set(visitor, call, member, base_ref, base_t, start_cls, methods_ref,
                &arg_types, tmpl, DefId::invalid(), false, &sel)) {
            // An instantiation whose arguments are still a generic body's
            // parameters is asked again where it is instantiated.
            if (tmpl == null || !this.types.contains_generic_param(owner_inst)) {
                this.report_generic_tie(visitor, call, member, base_ref, base_t, start_cls,
                    methods_ref, &arg_types, tmpl, owner_inst, false, sel.chosen);
                this.report_inherent_trait_tie(visitor, call, member, base_ref, base_t, start_cls,
                    methods_ref, &arg_types, tmpl, owner_inst, sel.chosen);
            }
            this.pin_minted_method(call, sel, base_ref);
            return this.commit_selection(visitor, call, sel);
        }
        if (this.select_in_set(visitor, call, member, base_ref, base_t, start_cls, methods_ref,
                &arg_types, tmpl, DefId::invalid(), true, &sel)) {
            if (tmpl == null || !this.types.contains_generic_param(owner_inst)) {
                this.report_generic_tie(visitor, call, member, base_ref, base_t, start_cls,
                    methods_ref, &arg_types, tmpl, owner_inst, true, sel.chosen);
            }
            this.pin_minted_method(call, sel, base_ref);
            return this.commit_selection(visitor, call, sel);
        }
        return Selection::none();
    }

    /// Record on a call in a generic body the method selected for it, when
    /// the receiver is an unminted instantiation of a generic type: an
    /// inherent method of that type, by the template's definition, or a
    /// trait's default copied into the type's implementation, by the
    /// trait's definition the copy stands for.  Every copy of the body
    /// carries it, and monomorphization maps it to the receiver's copy -
    /// instantiated when the method has type parameters of its own or is a
    /// default instantiated per call.  Any other selection records nothing.
    pin_template_method(&this, call: CallExprNode*, mn_decl: DeclarationNode*, owner_inst: TypeRef) -> void {
        const mn: MethodDecl* = DeclarationNode::method_of(mn_decl);
        if (mn.func == null) { return; }
        const base: TypeRef = this.arena.inst_generic_base(owner_inst);
        if (!base.is_valid()) { return; }
        if (!DeclarationNode::fn_of(mn.func).def.is_valid()) {
            if (DeclarationNode::fn_of(mn.func).copy_of.is_valid()) {
                call.template_method = DeclarationNode::fn_of(mn.func).copy_of;
                call.template_recv = owner_inst;
            }
            return;
        }
        if (!this.ctx.defs.parent_of(DeclarationNode::fn_of(mn.func).def).equals(this.ctx.decl_index.registered_def(base))) { return; }
        call.template_method = DeclarationNode::fn_of(mn.func).def;
        call.template_recv = owner_inst;
    }

    /// Record on a call in a generic body the method selected for it on a
    /// minted receiver - an inherent method or a trait's, whichever set the
    /// selection found it in - when that method has no type parameters of
    /// its own, is instantiated with its owner, and is the receiver's own
    /// entry for its definition: the receiver is the same type in every copy
    /// of the body, which binds that method by its definition after
    /// monomorphization (`bind_template_method`) instead of selecting again.
    pin_minted_method(&this, call: CallExprNode*, sel: Selection, recv: TypeRef) -> void {
        const mn_decl: DeclarationNode* = sel.chosen;
        const mn: MethodDecl* = DeclarationNode::method_of(mn_decl);
        if (!this.state.in_symbolic_check || sel.owner_inst.is_valid() || mn == null) { return; }
        const f_decl: DeclarationNode* = mn.func;
        const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
        if (f == null || f.generic_params.length > 0
                || f.is_self_returning_default || f.is_lazy_self_growing) { return; }
        // A trait's default copied into an implementation has no definition
        // of its own; it is the receiver's entry for the default it copies.
        const d: DefId = if (f.def.is_valid()) { f.def } else { f.copy_of };
        if (!d.is_valid()) { return; }
        if (this.types.contains_generic_param(recv)) { return; }
        if (!this.ctx.decl_index.method_entry_on(recv, d).equals(f.overload_entry)) { return; }
        call.template_method = d;
        call.template_recv = recv;
    }

    /// Bind a call carrying a template pin to the receiver's entry for the
    /// pinned definition, by identity: the method itself when the receiver
    /// declares it, else the copy the receiver's specialization holds of
    /// it.  Nothing is selected by the member's name.  A receiver with
    /// neither leaves the call unbound, which monomorphization reports.
    bind_template_method(mut &this, visitor: SemaVisitor*, call: CallExprNode*, recv: TypeRef) -> Selection {
        const chosen: DeclarationNode* = this.ctx.decl_index.entry_method(
            this.ctx.decl_index.method_entry_on(recv, call.template_method));
        if (chosen == null) { return Selection::none(); }
        return this.commit_selection(visitor, call, Selection::of(chosen));
    }

    /// Bind a call that names its method by definition - a method language
    /// item a lowering wrote - to the receiver's own method for it: for a
    /// trait's declared method, the method the receiver's implementation of
    /// the trait provides at that method's position; for any other, the
    /// receiver's entry for the definition, its own or its copy of it.
    /// Nothing is selected by name, and a concrete receiver without the
    /// method is an internal error rather than a cue to try the member's
    /// name.  A receiver still written in a generic body's parameters has no
    /// method set of its own: the call is bound in each copy of the body
    /// that substitutes them, and left alone here.
    bind_named_method(mut &this, visitor: SemaVisitor*, call: CallExprNode*, member: MemberAccessNode*,
                      recv: TypeRef, owner_inst: TypeRef) -> Selection {
        const d: DefId = call.named_method;
        const subject: TypeRef = if (owner_inst.is_valid()) { owner_inst } else { recv };
        if (this.types.contains_generic_param(subject) || this.types.contains_unresolved_projection(subject)) {
            return Selection::none();
        }
        mut chosen: DeclarationNode* = null;
        if (recv.is_valid() && !owner_inst.is_valid()) {
            const slot: i64 = this.ctx.generic_registry.trait_item_position(d);
            if (slot >= 0) {
                const block: ImplBlock* = DeclarationNode::impl_of(this.ctx.generic_registry.select_trait_impl(
                    this.ctx.defs.parent_of(d), recv, this.intern));
                chosen = this.ctx.generic_registry.trait_item_method(block, slot);
            } else {
                chosen = this.ctx.decl_index.entry_method(this.ctx.decl_index.method_entry_on(recv, d));
            }
        }
        if (chosen == null) {
            mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                fmt::format("code the compiler generated calls `%s` by its definition, and the receiver's type has no method for it",
                    this.intern.shown(this.ctx.defs.leaf_of(d))));
            diag = diag.at_with_label(member.span, "generated call");
            this.ctx.emit_diagnostic(diag);
            return Selection::none();
        }
        return this.commit_selection(visitor, call, Selection::of(chosen));
    }

    /// Bind `x.drop()` built to release `x` to the destructor of `x`'s
    /// type, by identity: the implementation of `Drop` that applies to the
    /// type (its head selects it and its where-clause holds), then its
    /// method at `Drop::drop`'s position.  A type with no implementation
    /// that applies has no destructor to call, and the call is left
    /// unpinned: codegen releases the value with its glue, or not at all
    /// when it is `Copy`.  A method of the type that is merely named `drop`
    /// is not its destructor and is never reached.
    bind_destructor(mut &this, visitor: SemaVisitor*, call: CallExprNode*, recv: TypeRef) -> Selection {
        const d: DefId = this.ctx.generic_registry.wellknown(LangItem::DropDrop);
        if (!d.is_valid()) { return Selection::none(); }
        // The call names the release of its receiver by the language item,
        // whether or not the type has a destructor to bind: code generation
        // releases one without by its glue, and knows the call by this.
        call.named_method = d;
        const block: ImplBlock* = this.trait_checker().select_impl(
            this.ctx.defs.parent_of(d), recv, 0);
        const chosen: DeclarationNode* = this.ctx.generic_registry.trait_item_method(
            block, this.ctx.generic_registry.trait_item_position(d));
        if (chosen == null) { return Selection::none(); }
        return this.commit_selection(visitor, call, Selection::of(chosen));
    }

    /// Stamp the call `member` is the callee of with the trait a bound
    /// answered it through and the position of the method it names among
    /// that trait's declared ones, found where the call is written.
    stamp_trait_item(&this, member: MemberAccessNode*, trait_def: DefId) -> void {
        member.set_resolved_trait_item(trait_def, this.trait_slot_of(trait_def, member.member));
    }

    /// The position of `trait_def`'s declared method `leaf` among the
    /// trait's methods, through the trait-method door; -1 for none.
    trait_slot_of(&this, trait_def: DefId, leaf: SymbolStr) -> i64 {
        return this.ctx.generic_registry.trait_item_slot(trait_def, leaf);
    }

    /// The type of a call a bound answered, `ret` being its trait method's
    /// return: a method with type parameters of its own returns in them
    /// (`next<T>(mut &this) -> T`), and the call's type arguments say what
    /// they are at this call, so `r.next::<f64>()` is an `f64` where it is
    /// written.  The method is the trait's declared one at the position the
    /// call recorded.  `ret` unchanged when the call carries no type
    /// arguments for it.
    bound_return_at_call_args(&this, member: MemberAccessNode*, call: CallExprNode*, ret: TypeRef) -> TypeRef {
        if (call.resolved_type_args.length == 0 || member.resolved_trait_slot < 0) { return ret; }
        const decl: TraitDecl* = this.ctx.generic_registry.get_trait_decl(member.resolved_trait);
        if (decl == null || member.resolved_trait_slot >= decl.methods.length) { return ret; }
        const f_decl: DeclarationNode* = decl.methods[member.resolved_trait_slot];
        const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
        if (f == null || f.generic_params.length != call.resolved_type_args.length) { return ret; }
        mut view: TypeSubstitution = TypeSubstitution::empty();
        for (mut i: i64 = 0; i < f.generic_params.length; i++) {
            const gp_decl: DeclarationNode* = f.generic_params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            if (gp == null) { return ret; }
            view.add(this.ctx.type_resolver.create_param_type(gp, i as u64), call.resolved_type_args[i]);
        }
        return view.apply(ret, this.arena);
    }

    /// The methods `recv`'s implementations of the call's trait provide for
    /// the trait's method the call names, found without the member's name:
    /// each implementation selected by (trait, type), in registration order,
    /// then its method at the position the call recorded.  A trait
    /// implemented at several arguments (`Mul<f32, V>` and `Mul<V, V>` for
    /// `V`) has an implementation, and an answer, for each.  Empty when the
    /// call recorded no position or no implementation is selected.
    trait_item_answers(&this, member: MemberAccessNode*, recv: TypeRef) -> [DeclarationNode*] {
        mut out: [DeclarationNode*] = [];
        if (member.resolved_trait_slot < 0) { return out; }
        const heads: [DeclarationNode*] = this.ctx.generic_registry.heads_for(
            member.resolved_trait, recv, this.intern);
        for (mut i: i64 = 0; i < heads.length; i++) {
            const m: DeclarationNode* = this.ctx.generic_registry.trait_item_method(
                DeclarationNode::impl_of(heads[i]), member.resolved_trait_slot);
            if (m != null) { out.push(m); }
        }
        return out;
    }

    /// Whether every method in `items` is bound as it is written: none has
    /// type parameters of its own, and none is a default the implementation
    /// instantiates per call.  An empty set qualifies; it binds nothing.
    static all_plain_methods(items: &[DeclarationNode*]) -> boolean {
        for (mut i: i64 = 0; i < items.length; i++) {
            const f_decl: DeclarationNode* = DeclarationNode::method_of(items[i]).func;
            const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
            if (f == null || f.generic_params.length > 0
                    || f.is_self_returning_default || f.is_lazy_self_growing) { return false; }
        }
        return true;
    }

    /// Bind a call a bound answered where it is written to one of `items`,
    /// the methods the receiver's implementations of that trait provide at
    /// the call's recorded position: the first the arguments bind to, at
    /// the lowest tier any of them binds.  Several are candidates only when
    /// the trait is implemented at several arguments, which the arguments
    /// tell apart.  Nothing is selected by the member's name, and no method
    /// outside the trait's implementations is a candidate: arguments that
    /// bind to none of them leave the call unbound.
    bind_trait_item(mut &this, visitor: SemaVisitor*, call: CallExprNode*, items: &[DeclarationNode*],
                    arg_types: &[TypeRef]) -> Selection {
        for (mut tier: i32 = 0; tier <= 3; tier++) {
            if (tier == 3 && this.state.in_implicit_conversion) { break; }
            for (mut i: i64 = 0; i < items.length; i++) {
                const f_decl: DeclarationNode* = DeclarationNode::method_of(items[i]).func;
                const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
                mut params: [TypeRef] = [];
                for (mut pi: i64 = 0; pi < f.parameters.length; pi++) {
                    const pp_decl: DeclarationNode* = f.parameters[pi];
                    const pp: VarDecl* = DeclarationNode::var_of(pp_decl);
                    if (pp == null || pp.is_receiver()) { continue; }
                    params.push(pp.resolved_type);
                }
                if (!this.args_bind_to_params(call, arg_types, params.as_slice(), f.is_variadic, tier)) { continue; }
                mut sel: Selection = Selection::of(items[i]);
                sel.tier = tier;
                return this.commit_selection(visitor, call, sel);
            }
        }
        return Selection::none();
    }

    /// A call a trait's method was selected for by name on a concrete
    /// receiver must name a method one of the trait's implementations for
    /// the receiver provides at the call's recorded position - that method,
    /// or a specialization of it the monomorphizer minted.  The two answers
    /// come from two independent paths, the selection by the member's name
    /// among the receiver's methods and the implementations' tables by
    /// position; a disagreement is a defect in one of them, reported as an
    /// internal error rather than compiled.
    check_trait_item_table(mut &this, member: MemberAccessNode*, recv: TypeRef, chosen_decl: DeclarationNode*) -> void {
        const chosen: MethodDecl* = DeclarationNode::method_of(chosen_decl);
        if (member.resolved_trait_slot < 0) { return; }
        const items: [DeclarationNode*] = this.trait_item_answers(member, recv);
        for (mut i: i64 = 0; i < items.length; i++) {
            if (items[i] == chosen_decl || (chosen != null && chosen.spec_of == items[i])) { return; }
        }
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
            fmt::format("`%s` was selected by name as a trait's method, and the method table of the implementation the trait and the receiver select answers %s",
                this.intern.resolve(member.member), if (items.length == 0) { "no method" } else { "a different one" }));
        d = d.at_with_label(member.span, "the two ways of finding this call's method disagree");
        this.ctx.emit_diagnostic(d);
    }

    /// Select in one candidate set - the inherent methods, or with
    /// `from_trait` the trait methods, only `only_trait`'s when it is
    /// valid - the non-generic methods before the generic ones.  `tmpl`,
    /// when not null, is the template of the instantiation not yet minted
    /// the receiver is (`sel.owner_inst`), whose candidates are read off it.
    select_in_set(mut &this, visitor: SemaVisitor*, call: CallExprNode*, member: MemberAccessNode*,
                  base_ref: TypeRef, base_t: Type*, start_cls: ClassType*, methods_ref: Slice<MethodInfo>,
                  arg_types: &[TypeRef], tmpl: TemplateEntry*, only_trait: DefId,
                  from_trait: boolean, sel: Selection*) -> boolean {
        for (mut pass: i32 = 0; pass < 2; pass++) {
            if (tmpl != null) {
                if (this.select_on_template(visitor, call, member, tmpl, arg_types,
                        only_trait, from_trait, pass == 1, sel)) { return true; }
            } else {
                if (this.select_method(visitor, call, member, base_ref, base_t, start_cls, methods_ref,
                        arg_types, only_trait, from_trait, pass == 1, sel)) { return true; }
            }
        }
        return false;
    }

    /// A non-generic method the arguments bind to (`chosen`) and a generic
    /// method of the same name, in the same candidate set, that they bind
    /// to as well: neither outranks the other for being non-generic, so the
    /// call is ambiguous (E0154).  Silent when `chosen` is itself generic -
    /// no non-generic method applied - or when no generic one applies.
    report_generic_tie(mut &this, visitor: SemaVisitor*, call: CallExprNode*, member: MemberAccessNode*,
                       base_ref: TypeRef, base_t: Type*, start_cls: ClassType*,
                       methods_ref: Slice<MethodInfo>, arg_types: &[TypeRef],
                       tmpl: TemplateEntry*, owner_inst: TypeRef, from_trait: boolean,
                       chosen_decl: DeclarationNode*) -> void {
        const chosen: MethodDecl* = DeclarationNode::method_of(chosen_decl);
        if (chosen == null || chosen.func == null || DeclarationNode::fn_of(chosen.func).generic_params.length > 0) { return; }
        mut alt: Selection = Selection::none();
        alt.owner_inst = owner_inst;
        alt.recv = if (owner_inst.is_valid()) { owner_inst } else { base_ref };
        const bound: boolean = if (tmpl != null) {
            this.select_on_template(visitor, call, member, tmpl, arg_types,
                DefId::invalid(), from_trait, true, &alt)
        } else {
            this.select_method(visitor, call, member, base_ref, base_t, start_cls, methods_ref,
                arg_types, DefId::invalid(), from_trait, true, &alt)
        };
        if (!bound || alt.chosen == null || alt.chosen == chosen_decl || DeclarationNode::method_of(alt.chosen).func == null) { return; }
        const subject: TypeRef = if (owner_inst.is_valid()) { owner_inst } else { base_ref };
        const leaf: string = this.intern.resolve(member.member);
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0154_AMBIGUOUS_CALL,
            fmt::format("`%s` is ambiguous: a non-generic and a generic method of `%s` both accept these arguments",
                leaf, this.arena.resolve_display_name_short(subject)));
        d = d.at_with_label(member.span, "both methods apply here");
        const f1_decl: DeclarationNode* = chosen.func;
        const f2_decl: DeclarationNode* = DeclarationNode::method_of(alt.chosen).func;
        d = d.with_note_at(fmt::format("candidate #1: `%s`, not generic", leaf),
            if (f1_decl.has_name_span()) { f1_decl.name_span } else { f1_decl.span });
        d = d.with_note_at(fmt::format("candidate #2: `%s`, generic", leaf),
            if (f2_decl.has_name_span()) { f2_decl.name_span } else { f2_decl.span });
        d = d.help("a method is not preferred for being non-generic; rename one of them");
        this.ctx.emit_diagnostic(d);
    }

    /// An inherent method the arguments bind to (`inherent`) and a trait
    /// method of the same name they bind to are both candidates for an
    /// unstamped call, and neither outranks the other: the call is
    /// ambiguous, reported with every trait that offers the method.  The
    /// caller names the trait's method through the impl-qualified path,
    /// `(Trait for Owner)::member(args)`, or renames one of them.  Silent
    /// when no trait method applies.  Reported in a generic body's walk too:
    /// the receiver is a minted type, whose call is pinned here and not
    /// selected again for an instantiation.
    report_inherent_trait_tie(mut &this, visitor: SemaVisitor*, call: CallExprNode*, member: MemberAccessNode*,
                              base_ref: TypeRef, base_t: Type*, start_cls: ClassType*,
                              methods_ref: Slice<MethodInfo>, arg_types: &[TypeRef],
                              tmpl: TemplateEntry*, owner_inst: TypeRef, inherent_decl: DeclarationNode*) -> void {
        const inherent: MethodDecl* = DeclarationNode::method_of(inherent_decl);
        if (inherent == null || inherent.func == null) { return; }
        mut traits: [DefId] = [];
        mut spans: [SourceSpan] = [];
        // Every trait whose method applies, each asked alone: the trait set
        // asked whole answers only its first.  Only the impls whose
        // where-clauses hold for the receiver count, minted or not.
        const subject: TypeRef = if (owner_inst.is_valid()) { owner_inst } else { base_ref };
        const blocks: [ImplBlock*] = this.trait_checker().impls_of(subject);
        for (mut ti: i64 = 0; ti < blocks.length; ti++) {
            const tid: DefId = blocks[ti].trait_def;
            if (!tid.is_valid()) { continue; }
            mut seen: boolean = false;
            for (mut k: i64 = 0; k < traits.length; k++) {
                if (traits[k].equals(tid)) { seen = true; break; }
            }
            if (seen) { continue; }
            mut one: Selection = Selection::none();
            one.owner_inst = owner_inst;
            if (!this.select_in_set(visitor, call, member, base_ref, base_t, start_cls, methods_ref,
                    arg_types, tmpl, tid, true, &one)) { continue; }
            traits.push(tid);
            const f_decl: DeclarationNode* = DeclarationNode::method_of(one.chosen).func;
            spans.push(if (f_decl.has_name_span()) { f_decl.name_span } else { f_decl.span });
        }
        if (traits.length == 0) { return; }
        this.report_method_call_tie(call, member, subject, &traits, &spans, inherent.func);
    }

    /// E0156 for a method call `recv.member(args)` on `owner`: the tie's
    /// help quotes the call's receiver and arguments as the impl-qualified
    /// form takes them.  See `report_trait_method_tie`.
    report_method_call_tie(mut &this, call: CallExprNode*, member: MemberAccessNode*, owner: TypeRef,
                           traits: &[DefId], decl_spans: &[SourceSpan], inherent_decl: DeclarationNode*) -> void {
        const args_text: string = this.receiver_call_args_text(call, member);
        this.report_trait_method_tie(member.span, member.member, owner,
            traits, decl_spans, args_text, true, inherent_decl);
    }

    /// A method call's arguments as the impl-qualified form writes them:
    /// the receiver first - by reference when it is not one already, as
    /// the method form's auto-ref made it - and the call's own arguments
    /// after it, quoted from the source.
    receiver_call_args_text(mut &this, call: CallExprNode*, member: MemberAccessNode*) -> string {
        mut args_text: string = this.source_text(member.object.span);
        if (args_text.length() == 0) { args_text = "receiver"; }
        const recv_t: Type* = this.arena.lookup(member.object.resolved_type);
        if (recv_t == null || recv_t.kind != TypeKind::Reference) { args_text = "&" + args_text; }
        if (call.arguments.length > 0) {
            const first: ExpressionNode* = call.arguments[0];
            const last: ExpressionNode* = call.arguments[call.arguments.length - 1];
            const rest: string = this.source_text(SourceSpan::new(first.span.file,
                first.span.start_line, first.span.start_col, last.span.end_line, last.span.end_col));
            args_text = args_text + ", " + (if (rest.length() == 0) { "..." } else { rest });
        }
        return args_text;
    }

    /// Record the method a selection chose, the tier its arguments bound at
    /// and its return seen through `view` (null: as declared).
    choose_method(mut &this, mn_decl: DeclarationNode*, tier: i32, info: MethodInfo*,
                  sel: Selection*, view: TypeSubstitution*) -> void {
        const mn: MethodDecl* = DeclarationNode::method_of(mn_decl);
        sel.chosen = mn_decl;
        sel.tier = tier;
        sel.info = info;
        sel.ret = if (view != null) {
            this.seen_through(view, DeclarationNode::fn_of(mn.func).resolved_return_type)
        } else { DeclarationNode::fn_of(mn.func).resolved_return_type };
    }

    /// Bind the call to the method `sel` chose.  An argument that bound
    /// only through an `![implicit]` converter is converted.  A receiver
    /// that is a minted type pins the method on the call; an instantiation
    /// not yet minted (`sel.owner_inst`) does not - see
    /// `bind_method_on_receiver`.
    commit_selection(mut &this, visitor: SemaVisitor*, call: CallExprNode*, sel: Selection) -> Selection {
        const mn_decl: DeclarationNode* = sel.chosen;
        const mn: MethodDecl* = DeclarationNode::method_of(mn_decl);
        if (mn == null) { return sel; }
        if (sel.owner_inst.is_valid()) {
            this.pin_template_method(call, mn_decl, sel.owner_inst);
            return sel;
        }
        if (sel.tier == 3) {
            if (sel.info != null) {
                this.apply_overload_converter_args(visitor, call, sel.info.param_types.as_slice());
            } else {
                mut params: [TypeRef] = [];
                for (mut pi: i64 = 0; pi < DeclarationNode::fn_of(mn.func).parameters.length; pi++) {
                    const pp_decl: DeclarationNode* = DeclarationNode::fn_of(mn.func).parameters[pi];
                    const pp: VarDecl* = DeclarationNode::var_of(pp_decl);
                    if (pp == null || pp.is_receiver()) { continue; }
                    params.push(pp.resolved_type);
                }
                this.apply_overload_converter_args(visitor, call, params.as_slice());
            }
        }
        this.pin_method_callee(call, mn_decl, mn.is_static);
        this.pin_instantiated_method(call, mn_decl, sel.recv);
        return sel;
    }

    /// Record on a call the method sema selected for it on a minted
    /// receiver when monomorphization instantiates that method for the call:
    /// one with type parameters of its own, or a default instantiated per
    /// call (`take`, `map`).  Recorded by the method's definition - the
    /// declaration itself, or the one a copy stands for; monomorphization
    /// maps it to the receiver's method for that definition and to its
    /// instance, and nothing finds the method again by its member's name.
    /// A call bound with no receiver in hand (`recv` invalid) records
    /// nothing.
    pin_instantiated_method(&this, call: CallExprNode*, mn_decl: DeclarationNode*, recv: TypeRef) -> void {
        const mn: MethodDecl* = DeclarationNode::method_of(mn_decl);
        if (mn.func == null || !recv.is_valid()) { return; }
        if (DeclarationNode::fn_of(mn.func).generic_params.length == 0 && !DeclarationNode::fn_of(mn.func).is_self_returning_default
                && !DeclarationNode::fn_of(mn.func).is_lazy_self_growing) { return; }
        const d: DefId = if (DeclarationNode::fn_of(mn.func).def.is_valid()) { DeclarationNode::fn_of(mn.func).def } else { DeclarationNode::fn_of(mn.func).copy_of };
        if (d.is_valid()) {
            call.template_method = d;
            call.template_recv = recv;
        }
    }

    /// `ty` as a receiver sees it through `view`: its parameters substituted,
    /// and each projection whose base that makes concrete replaced by the
    /// type it reduces to (`FilterIter<I>::Item`, for a `FilterIter<
    /// TakeIter<Range<i32>>>`, is `i32`) before anything enclosing it is
    /// built - an `Option<..::Item>` built first would be an instantiation
    /// no code demands and monomorphization never mints.
    seen_through(mut &this, view: TypeSubstitution*, ty: TypeRef) -> TypeRef {
        mut full: TypeSubstitution = TypeSubstitution::from_params(&view.params, &view.replacements);
        this.bind_projections(ty, &full);
        return full.apply(ty, this.arena);
    }

    /// `params` as the call's type arguments `subst` instantiates them: what
    /// an argument is judged against.  A parameter that holds a projection
    /// (`d: I::Item`) is seen through `subst` from `decl`, its form as
    /// written, so the type the impl binds for the base `subst` gives (`i32`
    /// for `I` bound to `Count`) is reached; any other has `subst` applied.
    /// One `subst` leaves open - a projection still unreduced, or a type
    /// parameter that is neither bound nor the generic body's own - is as
    /// given.  `decl` is index-aligned with `params`.
    params_seen_through(mut &this, subst: TypeSubstitution*, decl: &[TypeRef],
                        params: &[TypeRef]) -> [TypeRef] {
        mut out: [TypeRef] = [];
        for (mut i: i64 = 0; i < params.length; i++) {
            if (i >= decl.length) {
                out.push(params[i]);
                continue;
            }
            const seen: TypeRef = if (this.types.contains_unresolved_projection(decl[i])) {
                this.seen_through(subst, decl[i])
            } else {
                subst.apply(params[i], this.arena)
            };
            const open: boolean = !seen.is_valid() || this.types.contains_unresolved_projection(seen)
                || (this.types.contains_generic_param(seen) && !this.symbolic.symbolic_params_settle(seen));
            out.push(if (open) { params[i] } else { seen });
        }
        return out;
    }

    /// A generic free call's arguments, checked against its parameters as
    /// the call's type arguments instantiate them.  Written type arguments
    /// (`id::<i32>(x)`) are decided by nothing the arguments say, and
    /// inferred ones by a unification that skips what it cannot bind, so
    /// either way an argument can still disagree with its parameter.
    check_generic_free_call_args(mut &this, visitor: SemaVisitor*, call: CallExprNode*,
                                 ident: IdentifierNode*) -> void {
        const entry: TemplateEntry* = this.find_fn_template_for_call(ident, call.arguments.length);
        if (entry == null) { return; }
        const tmpl_decl: DeclarationNode* = DeclarationNode::with_shape(entry.ast_node);
        const tmpl: FunctionDecl* = DeclarationNode::fn_of(tmpl_decl);
        if (tmpl == null || tmpl.parameters.length != call.arguments.length) { return; }
        mut decl: [TypeRef] = [];
        for (mut i: i64 = 0; i < tmpl.parameters.length; i++) {
            const p_decl: DeclarationNode* = tmpl.parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            decl.push(if (p != null) { p.resolved_type } else { TypeRef::invalid() });
        }
        const params: [TypeRef] = this.free_call_params(entry, call, &decl, &decl);
        this.check_args_against_params(visitor, &call.arguments, params.as_slice());
    }

    /// `params` of the generic function `entry` as `call` instantiates them,
    /// through the type arguments the call carries; see
    /// `params_seen_through`.  As given when `entry` is no template or the
    /// call carries no type argument for each of its type parameters.
    free_call_params(mut &this, entry: TemplateEntry*, call: CallExprNode*, decl: &[TypeRef],
                     params: &[TypeRef]) -> [TypeRef] {
        if (entry == null || entry.param_types.length == 0
                || call.resolved_type_args.length != entry.param_types.length) {
            return sema_copy_type_refs(params);
        }
        mut subst: TypeSubstitution = TypeSubstitution::from_params(&entry.param_types, &call.resolved_type_args);
        return this.params_seen_through(&subst, decl, params);
    }

    /// The parameters of the method `func` as `call` instantiates its own
    /// type parameters: each bound by the explicit turbofish, else by
    /// unifying a parameter with its argument, as the selection binds them
    /// (`method_args_bind`); see `params_seen_through`.  `params` are the
    /// candidate's, index-aligned with `func`'s non-receiver parameters.
    method_call_params(mut &this, call: CallExprNode*, func_decl: DeclarationNode*,
                       params: &[TypeRef]) -> [TypeRef] {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null || func.generic_params.length == 0) { return sema_copy_type_refs(params); }
        mut decl: [TypeRef] = [];
        for (mut pi: i64 = 0; pi < func.parameters.length; pi++) {
            const pp_decl: DeclarationNode* = func.parameters[pi];
            const pp: VarDecl* = DeclarationNode::var_of(pp_decl);
            if (pp == null || pp.is_receiver()) { continue; }
            decl.push(pp.resolved_type);
        }
        if (decl.length != params.length) { return sema_copy_type_refs(params); }
        mut pids: [TypeRef] = [];
        for (mut i: i64 = 0; i < func.generic_params.length; i++) {
            const gp_decl: DeclarationNode* = func.generic_params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            if (gp == null) { return sema_copy_type_refs(params); }
            pids.push(this.symbolic.symbolic_param_ref(gp, i as u64));
        }
        mut ictx: InferCtx = InferCtx::for_template(this.arena, pids);
        mut targs: &[TypeAnnotation*] = &call.generic_args;
        const callee_node: ASTNode* = call.callee as ASTNode*;
        if (targs.length == 0 && callee_node != null && callee_node.kind == NodeKind::MemberAccess) {
            targs = &(call.callee as MemberAccessNode*).generic_args;
        }
        if (targs.length > 0) {
            if (targs.length != func.generic_params.length) { return sema_copy_type_refs(params); }
            const explicit: [TypeRef] = this.resolve_turbofish(targs);
            if (explicit.length != targs.length) { return sema_copy_type_refs(params); }
            for (mut i: i64 = 0; i < explicit.length; i++) { ictx.bind_slot(i, explicit[i]); }
        }
        for (mut i: i64 = 0; i < decl.length && i < call.arguments.length; i++) {
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null || !arg.resolved_type.is_valid()) { continue; }
            ictx.unify(decl[i], arg.resolved_type);
        }
        mut subst: TypeSubstitution = TypeSubstitution::from_params(&ictx.params, &ictx.bindings);
        return this.params_seen_through(&subst, &decl, params);
    }

    /// Add to `subst` every projection in `ty` whose base `subst` makes
    /// concrete, bound to the member type that base's impl gives it;
    /// innermost first, so an outer projection's base is built from the
    /// reduced inner one.
    bind_projections(mut &this, ty: TypeRef, subst: TypeSubstitution*) -> void {
        const t: Type* = this.arena.lookup(ty);
        if (t == null) { return; }
        match (t.kind) {
            TypeKind::AssocProjection => {
                const proj: AssocProjectionType* = t.as_assoc_projection();
                this.bind_projections(proj.base, subst);
                const applied: TypeRef = subst.apply(ty, this.arena);
                if (applied.equals(ty) || this.types.contains_generic_param(applied)) { return; }
                const reduced: TypeRef = this.binding.reduce_assoc_projections(applied);
                const rt: Type* = this.arena.lookup(reduced);
                if (rt != null && rt.kind != TypeKind::AssocProjection) { subst.add(ty, reduced); }
            }
            TypeKind::Pointer   => { this.bind_projections(t.as_pointer().pointee, subst); }
            TypeKind::Reference => { this.bind_projections(t.as_reference().referent, subst); }
            TypeKind::Function  => {
                const f: FunctionType* = t.as_function();
                for (mut i: i64 = 0; i < f.param_types.length; i++) { this.bind_projections(f.param_types[i], subst); }
                this.bind_projections(f.return_type, subst);
            }
            TypeKind::Tuple => {
                const tup: TupleType* = t.as_tuple();
                for (mut i: i64 = 0; i < tup.elements.length; i++) { this.bind_projections(tup.elements[i], subst); }
            }
            TypeKind::InstantiatedType => {
                const inst: InstantiatedType* = t.as_instantiated();
                for (mut i: i64 = 0; i < inst.type_args.length; i++) { this.bind_projections(inst.type_args[i], subst); }
            }
            _ => { }
        }
    }

    /// One pass of selection over one candidate set, each tier before the
    /// next source.  The inherent set (`from_trait` false) is the
    /// receiver's own inherent methods (a class's base chain, leaf to root -
    /// the most-derived declaration wins at a tier before a base's is tried
    /// at the same tier), then a primitive's inherent blocks; the trait set
    /// is the methods the receiver's trait impls deliver, then the trait
    /// impls in registration order.  With `only_trait`, only that trait's
    /// methods are candidates and only the trait set is asked; `generic`
    /// selects the generic methods, the others otherwise.  Returns true
    /// when the call was bound.  For an instantiation not yet minted,
    /// `base_ref` is its template, and its trait impls are the ones
    /// selected for the instantiation.
    select_method(mut &this, visitor: SemaVisitor*, call: CallExprNode*, member: MemberAccessNode*,
                  base_ref: TypeRef, base_t: Type*, start_cls: ClassType*, methods_ref: Slice<MethodInfo>,
                  arg_types: &[TypeRef], only_trait: DefId, from_trait: boolean,
                  generic: boolean, sel: Selection*) -> boolean {
        if (only_trait.is_valid() && !from_trait) { return false; }
        // The receiver's own list holds its inherent methods and the methods
        // its trait impls deliver, in declaration order; `from_trait` says
        // which of the two it is asked for, so the order two `implement`
        // blocks were written in does not decide which body a call runs.
        mut own_tier: i32 = 0;
        const own: MethodInfo* = this.pick_own_method(call, member, base_ref, start_cls, methods_ref,
                                   arg_types, only_trait, from_trait, generic, &own_tier);
        if (own != null) {
            this.choose_method(DeclarationNode::with_shape(own.ast_node), own_tier, own, sel, null);
            return true;
        }


        // A primitive's inherent methods: the `implement string { }` blocks the
        // registry indexes under its type.  A declared type's blocks were
        // folded into its method set above.
        if (!from_trait) {
            if (start_cls == null && base_t.kind != TypeKind::Struct && base_t.kind != TypeKind::Enum) {
                const blocks: [DeclarationNode*] = this.ctx.generic_registry.inherent_impl_blocks(base_ref);
                for (mut bi: i64 = 0; bi < blocks.length; bi++) {
                    if (this.bind_on_impl_block(visitor, call, member, DeclarationNode::impl_of(blocks[bi]),
                            arg_types, generic, sel)) { return true; }
                }
            }
            return false;
        }

        // The trait impls selected for the receiver, in registration order: a
        // placed clone when it is a specialization, else the written heads
        // that unify with it and whose bounds hold.
        const impl_subject: TypeRef = if (sel.owner_inst.is_valid()) { sel.owner_inst } else { base_ref };
        const blocks: [ImplBlock*] = this.trait_checker().impls_of(impl_subject);
        for (mut ti: i64 = 0; ti < blocks.length; ti++) {
            const block: ImplBlock* = blocks[ti];
            // WHICH trait the block provides is the head's stamped identity.
            if (only_trait.is_valid() && !block.trait_def.equals(only_trait)) { continue; }
            if (this.bind_on_impl_block(visitor, call, member, block, arg_types, generic, sel)) { return true; }
        }
        return false;
    }

    /// The first of the receiver's own methods (a class's base chain, leaf
    /// to root) named as the call is whose parameters the arguments bind to,
    /// each tier before the next.  `from_trait` selects the set: the methods
    /// a trait impl delivers, or the inherent ones.  With `only_trait`, only
    /// that trait's methods are candidates; `generic` takes the generic
    /// methods, the others otherwise.  Writes the tier it bound at.
    pick_own_method(mut &this, call: CallExprNode*, member: MemberAccessNode*, owner: TypeRef,
                    start_cls: ClassType*, methods_ref: Slice<MethodInfo>,
                    arg_types: &[TypeRef], only_trait: DefId, from_trait: boolean, generic: boolean,
                    out_tier: i32*) -> MethodInfo* {
        for (mut tier: i32 = 0; tier <= 3; tier++) {
            if (tier == 3 && this.state.in_implicit_conversion) { break; }
            mut walk: ClassType* = start_cls;
            mut depth: i32 = 0;
            mut cur_methods: Slice<MethodInfo> = methods_ref;
            mut cur_owner: TypeRef = owner;
            while (depth < 16) {
                const named: [DeclarationNode*] = this.ctx.decl_index.methods_named(FamilyOwner::Type(cur_owner), member.member);
                for (mut mi: u64 = 0; mi < cur_methods.length; mi++) {
                    const m: MethodInfo* = cur_methods.get_ref(mi).unwrap();
                    if (!DeclarationIndex::holds_method(&named, DeclarationNode::with_shape(m.ast_node))) { continue; }
                    if (this.method_origin_trait(m).is_valid() != from_trait) { continue; }
                    if (only_trait.is_valid() && !this.method_provided_by(DeclarationNode::with_shape(m.ast_node), only_trait)) { continue; }
                    const mfn_decl: DeclarationNode* = if (m.ast_node != null) { DeclarationNode::method_of(m.ast_node).func } else { null };
                    const mfn: FunctionDecl* = DeclarationNode::fn_of(mfn_decl);
                    if ((mfn != null && mfn.generic_params.length > 0) != generic) { continue; }
                    if (!this.method_args_bind(call, arg_types, m.param_types.as_slice(),
                            this.method_type_is_variadic(m.function_type), tier, mfn_decl, null)) { continue; }
                    *out_tier = tier;
                    return m;
                }
                if (walk == null) { break; }
                if (!walk.has_base || !walk.base_class.is_valid()) { break; }
                const parent_t: Type* = this.arena.lookup(walk.base_class);
                if (parent_t == null || parent_t.kind != TypeKind::Class) { break; }
                cur_owner = walk.base_class;
                walk = parent_t.as_class();
                cur_methods = walk.methods.as_slice();
                depth += 1;
            }
        }
        return null;
    }

    /// Whether `mn` is the named trait's method, i.e. sits in an
    /// `implement trait T for ..` block for `T` - by identity: `trait_id` and
    /// `origin_trait` are both the trait's canonical name.
    method_provided_by(&this, mn_decl: DeclarationNode*, trait_id: DefId) -> boolean {
        const mn: MethodDecl* = DeclarationNode::method_of(mn_decl);
        if (mn == null || mn.func == null || !DeclarationNode::fn_of(mn.func).origin_trait.is_valid()) { return false; }
        return DeclarationNode::fn_of(mn.func).origin_trait.equals(trait_id);
    }

    /// `select_method` for an instantiation not yet minted (`sel.owner_inst`):
    /// the candidates are its template's, in the same sets - the inherent
    /// set is the methods written in the declaration and in its inherent
    /// impl blocks, the trait set the trait impls selected for the
    /// instantiation.
    select_on_template(mut &this, visitor: SemaVisitor*, call: CallExprNode*, member: MemberAccessNode*,
                       tmpl: TemplateEntry*, arg_types: &[TypeRef],
                       only_trait: DefId, from_trait: boolean, generic: boolean,
                       sel: Selection*) -> boolean {
        if (only_trait.is_valid() && !from_trait) { return false; }
        if (!from_trait) {
            // The declaration's methods are written in the template's own
            // parameters.
            const args: [TypeRef] = this.inst_args(sel.owner_inst);
            mut view: TypeSubstitution = TypeSubstitution::from_params(&tmpl.param_types, &args);
            const decl: ASTNode* = tmpl.ast_node;
            const named: [DeclarationNode*] = this.ctx.decl_index.methods_named(FamilyOwner::Template(tmpl.def), member.member);
            if (decl != null && DeclarationNode::struct_of(decl) != null) {
                if (this.bind_on_methods(visitor, call, member, &(DeclarationNode::struct_of(decl)).methods, &named,
                        arg_types, generic, sel, &view)) { return true; }
            } else if (decl != null && DeclarationNode::union_of(decl) != null) {
                if (this.bind_on_methods(visitor, call, member, &(DeclarationNode::union_of(decl)).methods, &named,
                        arg_types, generic, sel, &view)) { return true; }
            } else if (decl != null && decl.kind == NodeKind::ClassDeclaration) {
                if (this.bind_on_methods(visitor, call, member, &(decl as ClassDeclNode*).methods, &named,
                        arg_types, generic, sel, &view)) { return true; }
            }
            for (mut bi: i64 = 0; bi < tmpl.impl_blocks.length; bi++) {
                const block: ImplBlock* = DeclarationNode::impl_of(tmpl.impl_blocks[bi]);
                if (block == null || block.is_trait_impl()) { continue; }
                if (this.bind_on_impl_block(visitor, call, member, block, arg_types, generic, sel)) { return true; }
            }
            return false;
        }
        // The trait impls whose heads unify with the instantiation.  Their
        // where-clauses are not confirmed here: a parameter an impl binds
        // only in its where-clause cannot be bound by the checker, so an
        // instantiation not yet minted would fail every such head.  The pass
        // that sees the minted type selects among confirmed impls.
        const blocks: [DeclarationNode*] = this.ctx.generic_registry.trait_impls_of(sel.owner_inst, this.intern);
        for (mut ti: i64 = 0; ti < blocks.length; ti++) {
            const block: ImplBlock* = DeclarationNode::impl_of(blocks[ti]);
            if (only_trait.is_valid() && !block.trait_def.equals(only_trait)) { continue; }
            if (this.bind_on_impl_block(visitor, call, member, block, arg_types, generic, sel)) { return true; }
        }
        return false;
    }

    /// Select among one impl block's methods; see `bind_on_methods`.
    bind_on_impl_block(mut &this, visitor: SemaVisitor*, call: CallExprNode*, member: MemberAccessNode*,
                       block: ImplBlock*, arg_types: &[TypeRef],
                       generic: boolean, sel: Selection*) -> boolean {
        if (block == null) { return false; }
        const named: [DeclarationNode*] = this.block_methods_named(block, member.member);
        if (!sel.owner_inst.is_valid()) {
            return this.bind_on_methods(visitor, call, member, &block.methods, &named, arg_types,
                                        generic, sel, null);
        }
        mut view: TypeSubstitution = this.impl_view(block, sel.owner_inst);
        return this.bind_on_methods(visitor, call, member, &block.methods, &named, arg_types,
                                    generic, sel, &view);
    }

    /// The methods implement block `block` holds under `leaf`: a trait
    /// implementation's by the trait-method door, from the trait's method of
    /// that leaf; an inherent block's by the member-function door, asked of
    /// the owner whose families keep them.
    block_methods_named(&this, block: ImplBlock*, leaf: SymbolStr) -> [DeclarationNode*] {
        if (block.is_trait_impl()) { return this.ctx.generic_registry.impl_methods_at_leaf(block, leaf); }
        const owner: FamilyOwner = match (this.ctx.decl_index.impl_family_owner(block)) {
            FamilyOwner::Def(d)      => { this.ctx.generic_registry.methods_owner_of(d) }
            FamilyOwner::Type(t)     => { FamilyOwner::Type(t) }
            FamilyOwner::Template(d) => { FamilyOwner::Template(d) }
        };
        return this.ctx.decl_index.methods_named(owner, leaf);
    }

    /// Bind the parameters an impl introduces only in its where-clause from
    /// the impls its bound subjects have: in `implement<I, A> Iterator<A>
    /// for TakeIter<I> where I: Iterator<A>`, a `TakeIter<Range<i32>>` has
    /// `I` bound by the head, and `A` is `i32` because that is what
    /// `Range<i32>`'s `Iterator` impl writes.  Bounds are read in order, so
    /// a bound may use a parameter an earlier one bound.
    bind_where_only_params(mut &this, block: ImplBlock*, view: TypeSubstitution*) -> void {
        for (mut bi: i64 = 0; bi < block.where_bounds.length; bi++) {
            const bound: &TraitBound = &block.where_bounds[bi];
            const subject: TypeRef = this.trait_checker().lookup_subst_for_param(bound.subject_sym, view);
            if (!subject.is_valid() || this.types.contains_generic_param(subject)) { continue; }
            for (mut ti: i64 = 0; ti < bound.trait_refs.length; ti++) {
                const tr: &TraitRef = &bound.trait_refs[ti];
                if (tr.type_args.length == 0) { continue; }
                const slots: [TypeRef] = this.ctx.type_resolver.concrete_trait_slots(subject, tr.definition());
                for (mut ai: i64 = 0; ai < tr.type_args.length && ai < slots.length; ai++) {
                    this.bind_where_arg(block, tr.type_args[ai], slots[ai], view);
                }
            }
        }
    }

    /// Bind a parameter of `block` a where-clause writes as a trait argument
    /// (`A` in `Iterator<A>`, `T` in `Iterator<T*>`) to the concrete argument
    /// in its place, unless it is bound already.
    bind_where_arg(mut &this, block: ImplBlock*, ta: TypeAnnotation*, concrete: TypeRef,
                   view: TypeSubstitution*) -> void {
        if (ta == null || !concrete.is_valid()) { return; }
        match (*ta) {
            TypeAnnotation::Named(n) => {
                if (!n.param_sym().is_valid()) { return; }
                if (this.trait_checker().lookup_subst_for_param(n.param_sym(), view).is_valid()) { return; }
                for (mut gi: i64 = 0; gi < block.generic_params.length; gi++) {
                    const gp_decl: DeclarationNode* = block.generic_params[gi];
                    const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
                    if (gp == null || !gp.sym_id.equals(n.param_sym())) { continue; }
                    view.add(this.symbolic.symbolic_param_ref(gp, gi as u64), concrete);
                    return;
                }
            }
            TypeAnnotation::Pointer(p) => {
                this.bind_where_arg(block, p.inner, this.types.proj_pointer_pointee(concrete), view);
            }
            TypeAnnotation::Reference(r) => {
                this.bind_where_arg(block, r.inner, this.types.proj_reference_referent(concrete), view);
            }
            _ => {}
        }
    }

    /// Select among one list of declared methods, every tier in turn;
    /// `generic` takes its generic methods, the others otherwise.  `view`,
    /// when not null, is how the receiver sees the parameters the list is
    /// written in.  Returns true when the call was bound.
    bind_on_methods(mut &this, visitor: SemaVisitor*, call: CallExprNode*, member: MemberAccessNode*,
                    methods: &[DeclarationNode*], named: &[DeclarationNode*], arg_types: &[TypeRef],
                    generic: boolean, sel: Selection*, view: TypeSubstitution*) -> boolean {
        // A self-returning default (an iterator adapter's `take`) is a
        // template the block carries until a concrete sibling is minted;
        // once one exists the template is not a candidate.
        mut has_concrete_sibling: boolean = false;
        for (mut ci: i64 = 0; ci < methods.length; ci++) {
            const cm_decl: DeclarationNode* = methods[ci];
            const cm: MethodDecl* = DeclarationNode::method_of(cm_decl);
            if (cm != null && cm.func != null && DeclarationIndex::holds_method(named, cm_decl)
                    && !DeclarationNode::fn_of(cm.func).is_self_returning_default) {
                has_concrete_sibling = true;
                break;
            }
        }
        // A method whose own `where` clause the receiver's arguments do not
        // meet, or whose receiver is written as the owner with other
        // arguments (`this: &Wrapper<i64>` asked of a `Wrapper<i32>`), is not
        // a method of that instantiation: monomorphization leaves it out by
        // the same predicates (`TraitChecker::method_bounds_satisfied`,
        // `method_receiver_excludes`), asked of the same bindings, so it is
        // no candidate here either.  Asked only of concrete arguments; a
        // generic body's are checked per instance.
        const where_asked: boolean = view != null && sel.owner_inst.is_valid() && !this.view_is_abstract(view);
        const owner_base: TypeRef = this.arena.inst_generic_base(sel.owner_inst);
        const owner_args: [TypeRef] = this.inst_args(sel.owner_inst);
        for (mut tier: i32 = 0; tier <= 3; tier++) {
            if (tier == 3 && this.state.in_implicit_conversion) { break; }
            for (mut mi: i64 = 0; mi < methods.length; mi++) {
                const mn_decl: DeclarationNode* = methods[mi];
                const mn: MethodDecl* = DeclarationNode::method_of(mn_decl);
                if (mn == null || mn.func == null) { continue; }
                const fn_node_decl: DeclarationNode* = mn.func;
                const fn_node: FunctionDecl* = DeclarationNode::fn_of(fn_node_decl);
                if (!DeclarationIndex::holds_method(named, mn_decl)) { continue; }
                if (fn_node.is_self_returning_default && has_concrete_sibling) { continue; }
                if ((fn_node.generic_params.length > 0) != generic) { continue; }
                if (where_asked && !this.trait_checker().method_bounds_satisfied(fn_node_decl, view)) { continue; }
                if (where_asked && this.trait_checker().method_receiver_excludes(fn_node_decl, view,
                        owner_base, &owner_args)) { continue; }
                mut params: [TypeRef] = [];
                for (mut pi: i64 = 0; pi < fn_node.parameters.length; pi++) {
                    const pp_decl: DeclarationNode* = fn_node.parameters[pi];
                    const pp: VarDecl* = DeclarationNode::var_of(pp_decl);
                    if (pp == null) { continue; }
                    if (pp.is_receiver()) { continue; }
                    params.push(pp.resolved_type);
                }
                // Collecting for the argument check binds nothing: each
                // candidate is recorded once.
                if (sel.collect != null) {
                    this.record_candidate(fn_node_decl, &params, view, sel.collect);
                    continue;
                }
                if (!this.method_args_bind(call, arg_types, params.as_slice(), fn_node.is_variadic, tier, fn_node_decl,
                        view)) { continue; }
                this.choose_method(mn_decl, tier, null, sel, view);
                return true;
            }
            if (sel.collect != null) { return false; }
        }
        return false;
    }

    /// Whether any type `view` binds still holds a type parameter.
    view_is_abstract(&this, view: TypeSubstitution*) -> boolean {
        for (mut i: i64 = 0; i < view.replacements.length; i++) {
            if (this.types.contains_generic_param(view.replacements[i])) { return true; }
        }
        return false;
    }

    /// Whether every argument binds to its parameter at `tier`; the one rule
    /// for every candidate set, so a method is selected the same way whether
    /// it is declared inline, in an inherent block or in a trait impl.  A
    /// variadic method binds its declared parameters and takes any tail.
    ///   0  the same arena type;
    ///   1  an implicit conversion (but never between pointers to different
    ///      pointees), an integer literal that fits, an auto-ref of `T` to
    ///      `&T` / `T*`, or `&T` for `T*` and back;
    ///   2  tier 1, with pointer conversions and an upcast to a base class;
    ///   3  tier 2, or an `![implicit]` converter the caller then applies.
    args_bind_to_params(&this, call: CallExprNode*, arg_types: &[TypeRef],
                        params: Slice<TypeRef>, variadic: boolean, tier: i32) -> boolean {
        mut fixed: i64 = params.length as i64;
        if (variadic) {
            // A named pack (`args...`) is a parameter with no type; it takes
            // the tail and binds nothing itself.
            if (fixed > 0 && !params.get((fixed - 1) as u64).unwrap().is_valid()) { fixed -= 1; }
            if (arg_types.length < fixed) { return false; }
        } else if (fixed != arg_types.length) {
            return false;
        }
        for (mut pi: i64 = 0; pi < fixed; pi++) {
            const param: TypeRef = params.get(pi as u64).unwrap();
            if (!this.arg_binds_to_param(call, pi, arg_types[pi], param, tier)) { return false; }
        }
        return true;
    }

    /// `args_bind_to_params` for a method candidate `func`.  A generic
    /// method's own type parameters are unknowns: an explicit turbofish
    /// binds them first; then each argument unifies with its parameter,
    /// binding the rest consistently across the call (the one structural
    /// unifier, `InferCtx`), and an argument that does not unify binds by
    /// the tier's rule against the parameter with the bindings substituted
    /// (`&w` for a `C` the turbofish made `W*`).  A method with none binds
    /// exactly as `args_bind_to_params`.  A `view` binds the parameters it
    /// substitutes the same way, as slots already solved (`push(x: T)` on a
    /// `Vec<i32>` takes an `i32`): unification compares through them
    /// without building the substituted parameter, which a candidate that
    /// is never chosen would otherwise leave behind as a type nothing
    /// demands.
    method_args_bind(mut &this, call: CallExprNode*, arg_types: &[TypeRef], params: Slice<TypeRef>,
                     variadic: boolean, tier: i32, func_decl: DeclarationNode*, view: TypeSubstitution*) -> boolean {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        const n_own: i64 = if (func != null) { func.generic_params.length } else { 0 };
        if (n_own == 0 && view == null) {
            return this.args_bind_to_params(call, arg_types, params, variadic, tier);
        }
        mut fixed: i64 = params.length as i64;
        if (variadic) {
            if (fixed > 0 && !params.get((fixed - 1) as u64).unwrap().is_valid()) { fixed -= 1; }
            if (arg_types.length < fixed) { return false; }
        } else if (fixed != arg_types.length) {
            return false;
        }
        mut pids: [TypeRef] = [];
        for (mut i: i64 = 0; i < n_own; i++) {
            const gp_decl: DeclarationNode* = func.generic_params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            if (gp == null) { return false; }
            pids.push(this.symbolic.symbolic_param_ref(gp, i as u64));
        }
        if (view != null) {
            for (mut vi: i64 = 0; vi < view.params.length; vi++) { pids.push(view.params[vi]); }
        }
        mut ictx: InferCtx = InferCtx::for_template(this.arena, pids);
        if (view != null) {
            for (mut vi: i64 = 0; vi < view.replacements.length; vi++) {
                ictx.bind_slot(n_own + vi, view.replacements[vi]);
            }
        }
        if (n_own > 0) {
            mut targs: &[TypeAnnotation*] = &call.generic_args;
            const callee_node: ASTNode* = call.callee as ASTNode*;
            if (targs.length == 0 && callee_node != null && callee_node.kind == NodeKind::MemberAccess) {
                targs = &(call.callee as MemberAccessNode*).generic_args;
            }
            if (targs.length > 0) {
                if (targs.length != n_own) { return false; }
                const explicit: [TypeRef] = this.resolve_turbofish(targs);
                if (explicit.length != targs.length) { return false; }
                for (mut i: i64 = 0; i < explicit.length; i++) { ictx.bind_slot(i, explicit[i]); }
            }
        }
        for (mut pi: i64 = 0; pi < fixed; pi++) {
            const param: TypeRef = params.get(pi as u64).unwrap();
            if (ictx.unify(param, arg_types[pi])) { continue; }
            mut subst: TypeSubstitution = TypeSubstitution::from_params(ictx.params, ictx.bindings);
            mut bound: TypeRef = TypeRef::invalid();
            if (view != null) {
                // A projection the view makes concrete (`TakeIter<Range<i32>>
                // ::Item`) unifies only once reduced; what it stood in front
                // of (`B` in `(Item) -> B`) binds then.
                bound = this.seen_through(&subst, param);
                if (!bound.equals(param) && ictx.unify(bound, arg_types[pi])) { continue; }
            } else {
                // A projection the method's own bindings make concrete
                // (`d: I::Item` with `I` bound to `Count`) is the type
                // `Count`'s impl binds, which the argument is judged against.
                bound = this.seen_through(&subst, param);
            }
            if (!this.arg_binds_to_param(call, pi, arg_types[pi], bound, tier)) { return false; }
        }
        return true;
    }

    arg_binds_to_param(&this, call: CallExprNode*, ai: i64, arg: TypeRef, param: TypeRef,
                       tier: i32) -> boolean {
        if (arg.equals(param)) { return true; }
        if (tier == 0) { return false; }
        const at: Type* = this.arena.lookup(arg);
        const pt: Type* = this.arena.lookup(param);
        mut allow_implicit: boolean = true;
        if (tier == 1 && at != null && pt != null
                && at.kind == TypeKind::Pointer && pt.kind == TypeKind::Pointer
                && !at.as_pointer().pointee.equals(pt.as_pointer().pointee)) {
            allow_implicit = false;
        }
        if (allow_implicit && this.checker.can_implicit_convert(arg, param)) { return true; }
        if (ai < call.arguments.length && call.arguments[ai] != null
                && this.literals.int_literal_fits_target(call.arguments[ai], param)) {
            return true;
        }
        // The unit value is spelled `()`, which the parser records as the
        // null literal `void`; it binds to a unit parameter (`HashSet`'s
        // `HashMap<T, ()>::insert(value, ())`).
        if (pt != null && pt.kind == TypeKind::Unit
                && ai < call.arguments.length && call.arguments[ai] != null
                && call.arguments[ai].kind == NodeKind::Literal) {
            const lit: LiteralNode* = call.arguments[ai] as LiteralNode*;
            if (lit.literal_kind == LiteralKind::Null && lit.value == "void") { return true; }
        }
        if (pt != null) {
            mut pointee: TypeRef = TypeRef::invalid();
            if (pt.kind == TypeKind::Pointer) { pointee = pt.as_pointer().pointee; }
            else if (pt.kind == TypeKind::Reference) { pointee = pt.as_reference().referent; }
            if (pointee.is_valid()) {
                if (pointee.equals(arg)) { return true; }
                if (at != null) {
                    mut arg_pointee: TypeRef = TypeRef::invalid();
                    if (at.kind == TypeKind::Pointer) { arg_pointee = at.as_pointer().pointee; }
                    else if (at.kind == TypeKind::Reference) { arg_pointee = at.as_reference().referent; }
                    if (arg_pointee.is_valid() && arg_pointee.equals(pointee)) { return true; }
                    if (tier >= 2 && arg_pointee.is_valid()
                            && this.checker.is_subclass_of(arg_pointee, pointee)) { return true; }
                }
                if (tier >= 2 && this.checker.is_subclass_of(arg, pointee)) { return true; }
            }
        }
        if (tier >= 3 && this.has_implicit_converter(arg, param)) { return true; }
        return false;
    }

    /// The first method a generic template's declaration writes that is one
    /// of `named`, the member-function door's answer for the leaf asked.
    template_method_held(&this, ast_node: ASTNode*, named: &[DeclarationNode*]) -> DeclarationNode* {
        if (ast_node == null) { return null; }
        const no_methods: [DeclarationNode*] = [];
        mut methods: &[DeclarationNode*] = &no_methods;
        if (DeclarationNode::struct_of(ast_node) != null) {
            methods = &(DeclarationNode::struct_of(ast_node)).methods;
        } else if (DeclarationNode::union_of(ast_node) != null) {
            methods = &(DeclarationNode::union_of(ast_node)).methods;
        } else if (ast_node.kind == NodeKind::ClassDeclaration) {
            methods = &(ast_node as ClassDeclNode*).methods;
        }
        for (mut i: i64 = 0; i < methods.length; i++) {
            if (DeclarationIndex::holds_method(named, methods[i])) { return DeclarationNode::method_of(methods[i]).func; }
        }
        return null;
    }


    // -- Method call return typing --

    /// True when `call` targets a GENERIC method (it carries stashed method-level
    /// `resolved_type_args`) whose return type `t` is a primitive SCALAR.  For
    /// such a return the per-call inference (`resolve_generic_method_return`,
    /// driven by THIS call's own type args) reproduces the EXACT interned type,
    /// so it can safely override the method's by-name pin - which, once the method
    /// is instantiated at several types, may be a SIBLING spec (a `next_range<u64>`
    /// call reading `next_range<i64>`'s `i64`).  Compound / instantiated returns
    /// are EXCLUDED: re-deriving them mints a DISTINCT arena TypeID from mono's
    /// materialized one (iterator adapters like `ChainIter`/`ZipIter`/`TakeIter`),
    /// which would spuriously mismatch, so their pin stays authoritative.
    /// A unit-shaped return belongs here for the same reason a scalar does: it
    /// is canonical, so re-deriving it cannot mint a distinct TypeID either.
    /// Leaving it out silently loses the repair — the re-derivation produces the
    /// right `()` and this predicate then refuses to adopt it, so the leaked
    /// sibling scalar stays. That reaches codegen as a NAMED call to a
    /// void-returning function, which LLVM rejects outright.
    generic_canonical_return(&this, call: CallExprNode*, t: TypeRef) -> boolean {
        if (call == null || call.resolved_type_args.length == 0) { return false; }
        if (!t.is_valid()) { return false; }
        const ty: Type* = this.arena.lookup(t);
        if (ty == null) { return false; }
        return ty.kind == TypeKind::Int || ty.kind == TypeKind::Float
            || ty.kind == TypeKind::Bool || ty.kind == TypeKind::Char
            || ty.kind == TypeKind::Unit || ty.kind == TypeKind::Void
            || ty.kind == TypeKind::Never;
    }

    /// The type of a method call.  Which method it names was answered by
    /// the selection (`bind_method_on_receiver`), whose answer is `selected`;
    /// `args_refused` is whether the argument check reported this call.
    resolve_method_call(mut &this, visitor: SemaVisitor*, member: MemberAccessNode*,
                        call: CallExprNode*, selected: Selection, args_refused: boolean) -> TypeRef {
        const obj_type: TypeRef = visitor.resolve_expr(member.object);
        if (!obj_type.is_valid()) {
            return TypeRef::invalid();
        }
        if (this.symbolic.symbolic_is_generic_owner_receiver(obj_type)) {
            // A nested generic-method call on the still-generic owner (`this.try_push(item)`
            // inside `String<A>::push<T>`) must stash its method bindings now; the
            // substituter concretizes them when the enclosing method specializes, so
            // mono can specialize the nested call (else codegen E0636).
            this.binding.stash_owner_generic_method_bindings(obj_type, member, call, selected.chosen);
            mut mret: TypeRef = this.symbolic.symbolic_resolve_owner_method_return(obj_type, member.member);
            if (!mret.is_valid()) {
                // A method delivered by a trait impl ON the owner
                // (`implement trait AsyncRead for struct BufStream<S>`) is not in
                // the template's own method list, so the owner-template lookup
                // above cannot see it. The instantiation resolver reads the
                // declaration index and the owner's trait impls, which is where
                // such a method IS recorded.
                //
                // Leaving it unresolved is survivable for a synchronous call —
                // monomorphization retypes it once the owner's argument is
                // bound — but not for an awaited one: the state machine has to
                // know the sub-future's type to give it a field, so an
                // unresolved receiver method surfaces as "operand does not
                // implement `Future`" at the `await` instead.
                mret = this.binding.resolve_method_return_via_template(obj_type, member.member, selected.chosen);
            }
            // A method's own type parameters the call writes (`this.map::<i64>(g)`)
            // are bound in its return as the owner's are.
            if (mret.is_valid() && member.generic_args.length > 0) {
                mret = this.binding.resolve_method_return_with_explicit_args(obj_type, member, selected.chosen, mret);
            }
            if (mret.is_valid()) { member.set_resolved_type(mret); return mret; }
            // No method of the name: a call through a function-typed field,
            // pinned here so every copy of the body carries the field.
            return this.member.try_field_function_call(obj_type, member);
        }
        if (this.symbolic.symbolic_type_unresolved(obj_type)) {
            this.binding.stash_abstract_receiver_method(obj_type, member, call);
            // `symbolic_type_unresolved` is true for any receiver that merely
            // CONTAINS a generic param, so a generic INSTANTIATION (`Inner<S>`
            // inside `f<S>`, or a field of `Owner<S>`) lands here too - but it is
            // not abstract for method lookup: its base template is known, and its
            // methods resolve through that template rather than through the
            // receiver's trait bounds, which is all the stash above consults.  A
            // bare param / projection receiver keeps that bounds lookup (it is the
            // only thing that can name its methods), so this fills in ONLY when the
            // bounds lookup produced nothing.  Without it such a call gets no
            // stash, and sema's stash is the sole producer of method-spec
            // demand, so mono mints no specialization and the call is left
            // bound to nothing.
            if (call.resolved_type_args.length == 0) {
                this.binding.stash_method_call_bindings(obj_type, member, call, selected.chosen);
            }
            // The stash solves the method's own type args but yields no RETURN
            // type, so every use of the result reads `void`. A bounded-param or
            // projection receiver is constrained enough to type the call exactly;
            // this early return sits before both rescues further down (past the
            // type-symbol lookup), making them unreachable in a symbolic walk.
            //
            // A call a bound answered names that trait's method, and the
            // node keeps it: the receiver is substituted by monomorphization,
            // and the type it becomes may declare a method of the same name
            // the generic body could not see.
            // A generic owner's method the call gives type arguments
            // (`w.conv::<u32>(5)` on a `Wrap<A>`) returns in them, whether
            // the method is declared in the type's body or in an `implement`
            // block; the bound path below binds a trait method's the same way.
            mut dir: BoundDirection = BoundDirection::none();
            const abs_ret: TypeRef = if (member.generic_args.length > 0
                    && this.types.peel_to_instantiation(obj_type) != null) {
                this.binding.resolve_method_return_with_explicit_args(obj_type, member, selected.chosen,
                    TypeRef::invalid())
            } else {
                this.binding.abstract_receiver_method_return(obj_type, member.member, selected.chosen, &dir)
            };
            if (abs_ret.is_valid()) {
                if (dir.named().is_valid() && !member.resolved_trait.is_valid()) {
                    this.stamp_trait_item(member, dir.named());
                    call.bound_trait_args = dir.bound_args();
                }
                // The receiver the bound answered on, in the body's own
                // parameters: each copy of the body substitutes it, which is
                // what monomorphization selects the implementation for.  A
                // copy's receiver expression carries no type of its own.
                if (member.resolved_trait.is_valid() && member.resolved_trait_slot >= 0) {
                    call.template_recv = obj_type;
                }
                const typed_ret: TypeRef = this.bound_return_at_call_args(member, call, abs_ret);
                member.set_resolved_type(typed_ret);
                return typed_ret;
            }
            const param: GenericParamType* = this.binding.receiver_type_param(obj_type);
            if (param != null) {
                this.report_param_receiver_call(member, param, this.binding.param_is_bounded(param), call);
            }
            return TypeRef::invalid();
        }
        this.binding.stash_method_call_bindings(obj_type, member, call, selected.chosen);

        mut lookup_ref: TypeRef = obj_type;
        mut base_t: Type* = this.arena.lookup(obj_type);
        mut unwrap_depth: i32 = 0;
        while (base_t != null && unwrap_depth < 5) {
            if (base_t.kind == TypeKind::Pointer) {
                lookup_ref = base_t.as_pointer().pointee;
                base_t = this.arena.lookup(lookup_ref);
            } else if (base_t.kind == TypeKind::Reference) {
                lookup_ref = base_t.as_reference().referent;
                base_t = this.arena.lookup(lookup_ref);
            } else if (base_t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = base_t.as_instantiated();
                if (!inst.has_resolved_type()) { break; }
                lookup_ref = inst.resolved_type;
                base_t = this.arena.lookup(lookup_ref);
            } else {
                break;
            }
            unwrap_depth += 1;
        }

        const type_sym: SymbolStr = this.types.lookup_type_sym(lookup_ref);
        if (!type_sym.is_valid()) {
            // A receiver with no type symbol names no type, so there is no
            // method set to search and this is a failure, not a search.
            //
            // Every abstract receiver shape - a bounded parameter, a
            // projection, a generic return, the owner template - is answered
            // ABOVE, by the generic-owner and abstract-receiver arms, so
            // reaching this point means those arms declined; re-asking the
            // same sources with less information cannot turn that into an
            // answer.
            return TypeRef::invalid();
        }

        // A projection-bounded trait-default method (`min`/`max` with
        // `where This::Item: Ord`) must NOT resolve on a concrete receiver whose
        // Item does not satisfy the bound: skip the trait-default resolution so
        // it falls through to a clean "no method" diagnostic (E0358) instead of
        // resolving here and failing later at codegen (E0636). False for
        // symbolic receivers / symbolic Item types (undecidable -> allow).
        const proj_blocked: boolean =
            this.binding.projection_default_unavailable(obj_type, member.member);
        // The method the selection chose: the pin on a minted receiver, the
        // template's method on an instantiation not yet minted.
        const lookup_t: Type* = this.arena.lookup(lookup_ref);
        const on_template: boolean = lookup_t != null && lookup_t.kind == TypeKind::InstantiatedType;
        const named_decl: DeclarationNode* = selected.chosen;
        const named: MethodDecl* = DeclarationNode::method_of(named_decl);
        const ret: TypeRef = if (on_template) { selected.ret } else { if (named != null && named.func != null) {
            DeclarationNode::fn_of(named.func).resolved_return_type
        } else { TypeRef::invalid() } };
        if (ret.is_valid() && !proj_blocked) {
            const acc_span: SourceSpan = if (member.member_span.has_location()) { member.member_span } else { member.span };
            this.member.enforce_method_visibility(lookup_ref, member.member, acc_span);
            const refined: TypeRef = if (member.generic_args.length > 0) {
                this.binding.resolve_method_return_with_explicit_args(obj_type, member, named_decl, ret)
            } else {
                this.types.subst_owner_params_from_receiver(obj_type, ret)
            };
            // When the return is still abstract, resolve it per-call (existing).
            // Otherwise, if the call targets a generic method whose by-name lookup
            // handed back a CONCRETE (post-mono) return, re-derive it from THIS
            // call's args and prefer that ONLY when it is a primitive scalar - a
            // sibling spec of a different instantiation can otherwise leak in (a
            // `next_range<u64>` call seeing `next_range<i64>`'s `i64`). Compound
            // returns keep `refined` (see `generic_canonical_return`).
            mut final_ret: TypeRef = refined;
            if (refined.is_valid() && this.types.contains_generic_param(refined)) {
                final_ret = this.binding.resolve_generic_method_return(obj_type, member, call, selected.chosen, refined);
            } else if (this.generic_canonical_return(call, refined)) {
                // Only when the by-name lookup already returned a concrete SCALAR
                // for a generic method (a possible sibling-spec leak). Gating the
                // genret CALL on a scalar `refined` matters: re-deriving a compound
                // return (iterator adapters) has arena side effects that break mono.
                const grt: TypeRef =
                    this.binding.resolve_generic_method_return(obj_type, member, call, selected.chosen, refined);
                if (this.generic_canonical_return(call, grt)) { final_ret = grt; }
            }
            final_ret = this.binding.finalize_assoc_return(obj_type, member, final_ret);
            member.set_resolved_type(final_ret);
            return final_ret;
        }

        const field_ret: TypeRef = this.member.try_field_function_call(lookup_ref, member);
        if (field_ret.is_valid()) {
            return field_ret;
        }

        if (this.ctx.get_generic_registry().names_lang_method(member.member, LangItem::DropDrop)
                && OwnershipQuery::is_copy(this.arena, this.ctx.get_generic_registry(), this.intern, lookup_ref)) {
            member.set_resolved_type(this.arena.get_void());
            return this.arena.get_void();
        }

        // Deref coercion: no such method on the receiver, but if it implements
        // `Deref<Target>`, retry the method on the pointee - `b.method()` on a
        // `Box<Foo>` becomes `(*b.deref()).method()` (transitively).  The Member
        // resolver rewrites `member.object` into the `*(b.deref())` place and
        // returns the method's type; re-stash the call bindings against the
        // coerced receiver so mono/codegen bind the method on `Target`.
        const coerced: TypeRef = this.member.try_deref_coercion(visitor, member);
        if (coerced.is_valid()) {
            // The call names the method on the coerced receiver, bound here
            // where it is written.
            this.bind_method_on_receiver(visitor, call, member, member.object.resolved_type);
            this.binding.stash_method_call_bindings(member.object.resolved_type, member, call, null);
            member.set_resolved_type(coerced);
            return coerced;
        }

        // The selection binds only an argument list whose types are all
        // known, so a call with an argument that failed to type named no
        // method: that is the argument's failure, not a missing method.
        for (mut ai: i64 = 0; ai < call.arguments.length; ai++) {
            const arg: ExpressionNode* = call.arguments[ai];
            if (arg == null || !arg.resolved_type.is_valid()) { return TypeRef::invalid(); }
        }
        // The arguments were refused against the method the leaf names, and
        // that report is this call's error; no overload binding them is the
        // same failure, not a second one.
        if (args_refused) { return TypeRef::invalid(); }

        // Every remaining exit is a failure, diagnosed one of several ways.
        // Counted once here so the tally is over OUTCOMES, not diagnostics.

        const method_name: string = this.intern.resolve(member.member);
        const recv_t: Type* = this.arena.lookup(lookup_ref);
        const type_display: string = if (recv_t != null) { this.arena.format_display(recv_t) } else { this.intern.resolve(type_sym) };
        const primary_span: SourceSpan = if (member.member_span.has_location()) { member.member_span } else { member.span };

        const failed_trait: DeclName = this.trait_checker().diagnose_method_bounds_failure(lookup_ref, member.member);
        if (failed_trait.is_valid()) {
            // The identity, rendered by its leaf as the tie report does.
            const trait_str: string = QualifiedName::leaf_of(this.intern.shown(failed_trait));
            mut diag: Diagnostic = Diagnostic::error(
                ErrorCode::E0358_UNDEFINED_METHOD_IMPL,
                fmt::format("the trait `%s` is not implemented for `%s`", trait_str, type_display));
            diag = diag.at(primary_span);
            diag = diag.with_note(fmt::format(
                "the impl of `%s` for this type has a where-clause that this specialization does not satisfy", trait_str));
            diag = diag.help(fmt::format(
                "method `%s` belongs to trait `%s`; ensure the type arguments satisfy the impl's bounds", method_name, trait_str));
            this.ctx.emit_diagnostic(diag);
            return TypeRef::invalid();
        }
        if (this.try_diagnose_method_bound_failure(obj_type, member)) { return TypeRef::invalid(); }

        // The method is declared and its signature was refused where it was
        // written; it registered none, and the call reports nothing more.
        if (this.ctx.decl_index.method_signature_refused(
                this.types.method_owner_ref(lookup_ref), member.member)) {
            return TypeRef::invalid();
        }

        // No method of the name, and a field of it that is no function: the
        // field is a value, and a value of no function type is not called.
        const nf: FieldAnswer = this.member.field_of(lookup_ref, member.member);
        if (nf.found() && nf.index >= 0) {
            this.refuse_call_of_non_function(member.span, nf.ty);
            return TypeRef::invalid();
        }

        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0358_UNDEFINED_METHOD_IMPL,
            fmt::format("no method named `%s` found on type `%s`", method_name, type_display));
        diag = diag.at(primary_span);
        const owning_trait: DeclName = this.binding.lookup_trait_defining_method(member.member);
        if (owning_trait.is_valid()) {
            const trait_str: string = this.intern.shown(owning_trait);
            diag = diag.with_note(fmt::format("the method `%s` is defined on trait `%s`", method_name, trait_str));
            diag = diag.help(fmt::format("implement `%s` for `%s`, or change the receiver to a type that already does", trait_str, type_display));
        } else {
            const suggestion: SymbolStr = this.diag.suggest_similar_method(lookup_ref, member.member);
            if (suggestion.is_valid()) {
                const sug_str: string = this.intern.resolve(suggestion);
                diag = diag.help(fmt::format("a method with a similar name exists: `%s`", sug_str));
                if (member.member_span.has_location()) {
                    diag = diag.suggest(Suggestion::machine_applicable(member.member_span, sug_str,
                        fmt::format("did you mean `%s`?", sug_str)));
                }
            }
        }
        if (this.arena.get_qualified_name(lookup_ref).is_valid()) {
            const simple: string = QualifiedName::leaf_of(this.intern.shown(this.arena.get_qualified_name(lookup_ref)));
            if (simple != "") {
                const shadows: [ShadowCandidate] = this.diag.find_shadowed_type_candidates(SymbolStr::empty(), member.member, lookup_ref);
                if (shadows.length > 0) {
                    diag = this.diag.attach_shadow_import_suggestions(diag, simple, shadows);
                } else {
                    mem::drop(shadows);
                }
            }
        }
        this.ctx.emit_diagnostic(diag);
        return TypeRef::invalid();
    }

    /// E0358: a method gated behind a `where` bound the concrete type args don't satisfy.
    try_diagnose_method_bound_failure(mut &this, obj_type: TypeRef, member: MemberAccessNode*) -> boolean {
        const reg: GenericRegistry* = this.ctx.get_generic_registry();
        if (reg == null) { return false; }
        mut t: Type* = this.arena.lookup(obj_type);
        mut depth: i32 = 0;
        while (t != null && depth < 5) {
            if (t.kind == TypeKind::InstantiatedType) { break; }
            if (t.kind == TypeKind::Reference) { t = this.arena.lookup(t.as_reference().referent); }
            else if (t.kind == TypeKind::Pointer) { t = this.arena.lookup(t.as_pointer().pointee); }
            else { break; }
            depth += 1;
        }
        if (t == null || t.kind != TypeKind::InstantiatedType) { return false; }
        const inst: InstantiatedType* = t.as_instantiated();
        const tmpl: TemplateEntry* = reg.template_of_type(inst.generic_base);
        if (tmpl == null || tmpl.ast_node == null) { return false; }
        if (tmpl.param_names.length != inst.type_args.length) { return false; }
        const named: [DeclarationNode*] = this.ctx.decl_index.methods_named(FamilyOwner::Template(tmpl.def), member.member);
        const func_decl: DeclarationNode* = this.template_method_held(tmpl.ast_node, &named);
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null || func.trait_bounds.length == 0) { return false; }
        for (mut bi: i64 = 0; bi < func.trait_bounds.length; bi++) {
            const bound: &TraitBound = &func.trait_bounds[bi];
            mut concrete: TypeRef = TypeRef::invalid();
            for (mut pi: i64 = 0; pi < tmpl.param_syms.length; pi++) {
                if (tmpl.param_syms[pi].equals(bound.subject_sym)) { concrete = inst.type_args[pi]; break; }
            }
            if (!concrete.is_valid()) { continue; }
            for (mut ri: i64 = 0; ri < bound.trait_refs.length; ri++) {
                const tref: &TraitRef = &bound.trait_refs[ri];
                if (tref.path.length == 0) { continue; }
                if (this.trait_checker().type_implements_trait(concrete, tref.definition(), 0)) { continue; }
                this.emit_method_bound_unmet(member, bound, tref, concrete);
                return true;
            }
        }
        return false;
    }

    /// E0358 at `member`: its method requires `bound`'s subject to have the
    /// trait `tref`, and `concrete`, the subject as the receiver binds it,
    /// does not.
    emit_method_bound_unmet(mut &this, member: MemberAccessNode*, bound: &TraitBound, tref: &TraitRef,
                            concrete: TypeRef) -> void {
        const method_str: string = this.intern.resolve(member.member);
        const trait_str:  string = this.intern.resolve(tref.path[tref.path.length - 1]);
        const param_str:  string = this.intern.resolve(bound.type_parameter);
        const conc_str:   string = this.types.type_display_name(concrete);
        const primary: SourceSpan = if (member.member_span.has_location()) { member.member_span } else { member.span };
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0358_UNDEFINED_METHOD_IMPL,
            fmt::format("the trait bound `%s: %s` is not satisfied", conc_str, trait_str));
        d = d.at(primary);
        d = d.with_note(fmt::format("method `%s` requires `%s: %s`", method_str, param_str, trait_str));
        const ct: Type* = this.arena.lookup(concrete);
        if (ct != null && ct.kind == TypeKind::GenericParam) {
            d = d.help(fmt::format("add `%s: %s` to the bounds in scope here", conc_str, trait_str));
        } else if (tref.definition().equals(this.ctx.generic_registry.wellknown(LangItem::Copy))) {
            d = d.help(fmt::format(
                "`%s` owns resources, so it isn't `Copy`, and `%s` is only available when `%s` is",
                conc_str, method_str, param_str));
        }
        this.ctx.emit_diagnostic(d);
    }

    /// In a generic body, the `where` bounds of the method `chosen` that a
    /// call on the body's own instantiation of its owner (`xs.get(0)` on an
    /// `Array<T>`) leaves to the receiver's type arguments: each must hold of
    /// the argument there, a parameter of the body by the bounds in scope.
    /// The body's copies are not checked, so a bound unmet here is never
    /// reported, and a copy calls a method its element type does not offer.
    check_symbolic_method_bounds(mut &this, member: MemberAccessNode*, chosen_decl: DeclarationNode*) -> void {
        const chosen: MethodDecl* = DeclarationNode::method_of(chosen_decl);
        if (!this.state.in_symbolic_check || chosen == null || chosen.func == null) { return; }
        const func_decl: DeclarationNode* = chosen.func;
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func.trait_bounds.length == 0 || member.object == null) { return; }
        mut t: Type* = this.arena.lookup(member.object.resolved_type);
        mut depth: i32 = 0;
        while (t != null && depth < 5) {
            if (t.kind == TypeKind::Reference) { t = this.arena.lookup(t.as_reference().referent); }
            else if (t.kind == TypeKind::Pointer) { t = this.arena.lookup(t.as_pointer().pointee); }
            else { break; }
            depth += 1;
        }
        if (t == null || t.kind != TypeKind::InstantiatedType) { return; }
        const inst: InstantiatedType* = t.as_instantiated();
        if (inst.has_resolved_type()) { return; }
        const tmpl: TemplateEntry* = this.ctx.generic_registry.template_of_type(inst.generic_base);
        if (tmpl == null || tmpl.param_syms.length != inst.type_args.length) { return; }
        for (mut bi: i64 = 0; bi < func.trait_bounds.length; bi++) {
            const bound: &TraitBound = &func.trait_bounds[bi];
            mut arg: TypeRef = TypeRef::invalid();
            for (mut pi: i64 = 0; pi < tmpl.param_syms.length; pi++) {
                if (tmpl.param_syms[pi].equals(bound.subject_sym)) { arg = inst.type_args[pi]; break; }
            }
            if (!arg.is_valid()) { continue; }
            const at: Type* = this.arena.lookup(arg);
            const param: GenericParamType* = if (at != null && at.kind == TypeKind::GenericParam) {
                at.as_generic_param()
            } else {
                null
            };
            if (param != null && !this.symbolic.symbolic_param_in_scope(param.param_sym)) { continue; }
            if (param == null && !this.types.arg_type_names_one_type(arg)) { continue; }
            for (mut ri: i64 = 0; ri < bound.trait_refs.length; ri++) {
                const tref: &TraitRef = &bound.trait_refs[ri];
                if (tref.path.length == 0) { continue; }
                const holds: boolean = if (param != null) {
                    this.binding.param_bounded_by(param, tref.definition())
                } else {
                    this.trait_checker().type_implements_trait(arg, tref.definition(), 0)
                };
                if (holds) { continue; }
                this.emit_method_bound_unmet(member, bound, tref, arg);
                return;
            }
        }
    }


    // -- Scope-resolution call resolution (Type::method / Module::func / variant) --

    /// The type a scope segment's owner IS: the handle `scope_owner_key`
    /// names.  A specialization the substituter recorded on the node, by its
    /// arena id; otherwise the type the segment's stamp names.  Invalid
    /// where the key is empty - a type parameter no clone has substituted,
    /// a module - because nothing there owns a member.
    scope_owner_base_type(&this, scope: ScopeResolutionNode*) -> TypeRef {
        if (scope.spec_owner.is_valid()
                && this.ctx.decl_index.lookup_type_name(scope.spec_owner).is_valid()) {
            return scope.spec_owner;
        }
        return this.types.scope_qualifier_type(scope);
    }

    /// The type a scope segment denotes as written: the instantiation its
    /// written arguments make of the template the stamp names
    /// (`Array<i32>::new`), interned from the pair, else the owner itself.
    /// The instantiation exists before monomorphization builds it, which is
    /// what a type question about the segment is asked of.
    scope_owner_type(mut &this, scope: ScopeResolutionNode*) -> TypeRef {
        if (scope.scope_generic_args.length > 0) {
            const inst: TypeRef = this.resolve_generic_scope_type(
                this.types.scope_qualifier_type(scope), scope.scope_generic_args, scope.span);
            if (inst.is_valid()) { return inst; }
        }
        return this.scope_owner_base_type(scope);
    }

    /// The registered name of the TYPE the scope segment names, or empty
    /// when the segment names no type owner.
    ///
    /// A substituter that rewrote the segment - a template's self-reference
    /// collapsed into the clone, or a type parameter replaced by the
    /// instantiation's argument - recorded the concrete type on the node,
    /// and the registries hold a specialization's methods under its
    /// registered name; that is asked first, by arena id.  Otherwise the
    /// stamp: a declared type's qualified name, or the spelling a primitive
    /// is registered under, since a primitive owns members while declaring
    /// nothing.
    ///
    /// Nothing else is an owner, and no spelling stands in for one.  A type
    /// parameter names no declaration, so its spelling is never a
    /// registration key.  A MODULE qualifier is not a type-owner claim: the
    /// module lane answers from the segment's own stamp.  A segment nothing
    /// in the program owns has no key at all - a lookup by its spelling can
    /// only find a registration that is itself keyed by a bare spelling,
    /// which is a name no stamp ever named.
    scope_owner_key(&this, scope: ScopeResolutionNode*) -> SymbolStr {
        if (scope.spec_owner.is_valid()) {
            const spec_q: SymbolStr = this.ctx.decl_index.lookup_type_name(scope.spec_owner);
            if (spec_q.is_valid()) { return spec_q; }
        }
        return match (scope.require_scope_res("scope-call owner key")) {
            Res::TypeRelative(b, _) => {
                match (b) {
                    ResBase::Def(d)          => { this.ctx.defs.path_of(d).spelling() }
                    ResBase::PrimTy(n)       => { n }
                    ResBase::GenericParam(_) => { SymbolStr::empty() }
                }
            }
            _                       => { SymbolStr::empty() }
        };
    }

    /// The owner whose family a `Type::member` path's member is in, as
    /// `scope_owner_key` above names it, written to `*out`; false when the
    /// segment names no type owner.
    scope_owner(&this, scope: ScopeResolutionNode*, out: FamilyOwner*) -> boolean {
        if (scope.spec_owner.is_valid()
                && this.ctx.decl_index.registered_def(scope.spec_owner).is_valid()) {
            *out = FamilyOwner::Type(scope.spec_owner);
            return true;
        }
        match (scope.require_scope_res("scope-call owner key")) {
            Res::TypeRelative(b, _) => {
                match (b) {
                    ResBase::Def(d)          => { *out = FamilyOwner::Def(d); return true; }
                    ResBase::PrimTy(_)       => {
                        *out = FamilyOwner::Type(this.types.scope_qualifier_type(scope));
                        return true;
                    }
                    ResBase::GenericParam(_) => { return false; }
                }
            }
            _ => { return false; }
        }
    }

    /// A `Scope::member(...)` call.  The scope segment's stamp says which
    /// store can own the member: a segment naming a MODULE (`Def` - a graph
    /// module's, or an `extern module` alias's, whose functions are
    /// declared in the alias's module) owns a module function and nothing
    /// else; any other segment names a type - a declaration, a primitive,
    /// a type parameter - and owns a static method or a variant.  Modules
    /// and types share one namespace, so a segment is never both, and the
    /// stores of the other kind are not asked.
    /// `claimed` is set when the owner the segment names declares the
    /// member (`try_resolve_static_method`).
    resolve_scope_call(mut &this, scope: ScopeResolutionNode*, call: CallExprNode*, claimed: boolean*) -> TypeRef {
        mut names_module: boolean = false;
        match (scope.require_scope_res("scope-call owner kind")) {
            Res::Def(_) => { names_module = true; }
            // A path the name layer refused (a member two re-exports offer)
            // was reported where it was written; no store owns it.
            Res::Err    => { return TypeRef::invalid(); }
            _           => { }
        }
        if (names_module) {
            const fn_ret: TypeRef = this.try_resolve_module_function(scope, call);
            if (fn_ret.is_valid()) { return fn_ret; }
        } else {
            // A segment written with arguments (`Wrap::<i32>::make()`) is
            // asked as the instantiation they make of its template, by that
            // pair (`scope_owner_type`); no name is minted for it.
            const lookup_sym: SymbolStr = this.scope_owner_key(scope);
            const owner_ty: TypeRef = this.scope_owner_type(scope);
            const method_ret: TypeRef = this.try_resolve_static_method(scope, lookup_sym, owner_ty, call, claimed);
            if (method_ret.is_valid() || *claimed) { return method_ret; }
            const type_ret: TypeRef = this.try_resolve_type_or_variant(scope, owner_ty, call);
            if (type_ret.is_valid()) { return type_ret; }
        }

        // A segment naming a parameter of the body under symbolic check owns
        // nothing yet: its members are the instantiation's.  By the stamp,
        // not the spelling - a type sharing a template parameter's spelling
        // (`type struct A` beside `Holder<A>`) is not that parameter.
        if (this.symbolic.symbolic_scope_is_generic_param(scope)) {
            const param_ret: TypeRef = this.direct_param_path(scope);
            // The member is the declared method of the trait an impl head or
            // a bound directs the path through, which every copy of the body
            // binds on the type the parameter becomes.
            const directing: DefId = if (scope.impl_trait != null) {
                this.impl_qualified_trait(scope)
            } else {
                scope.resolved_trait
            };
            if (directing.is_valid() && !call.template_method.is_valid()) {
                call.template_method = this.trait_item_def(directing, scope);
                if (scope.impl_trait == null) {
                    call.bound_params = this.binding.bound_method_params(
                        this.symbolic.symbolic_scope_param_type(scope), directing,
                        this.ctx.decl_index.method_func_of(call.template_method));
                }
            }
            return param_ret;
        }

        // A declaration whose signature was refused where it was written
        // registered none, and a call to it reports nothing more: the
        // module's function under its canonical name, or the type's method
        // under `Owner::member`.
        if (this.scope_callee_signature_refused(scope, names_module)) { return TypeRef::invalid(); }

        // An impl-qualified path that reached no method is refused in the
        // head's terms - the trait the type does not implement, or the
        // member its implementation lacks - not as a bare path's miss.
        if (scope.impl_trait != null) {
            const owner_key: SymbolStr = this.scope_owner_key(scope);
            const trait_sym: DefId = this.impl_qualified_trait(scope);
            if (owner_key.is_valid() && trait_sym.is_valid()) {
                this.report_impl_qualified_miss(scope, owner_key, this.scope_owner_base_type(scope), trait_sym, scope.member_name);
            }
            if (owner_key.is_valid() || !trait_sym.is_valid()) { return TypeRef::invalid(); }
        }

        const scope_str: string = this.intern.resolve(scope.scope_name);
        const member_str: string = this.intern.resolve(scope.member_name);
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0233_UNDEFINED_SYMBOL,
            fmt::format("cannot find `%s::%s`: no matching static method, variant, or type", scope_str, member_str));
        diag = diag.at(scope.span);
        const shadows: [ShadowCandidate] = this.diag.find_shadowed_type_candidates(scope.scope_name, scope.member_name, TypeRef::invalid());
        if (shadows.length > 0) {
            diag = this.diag.attach_shadow_import_suggestions(diag, scope_str, shadows);
        } else {
            mem::drop(shadows);
        }
        this.ctx.emit_diagnostic(diag);
        return TypeRef::invalid();
    }

    /// A path through a bounded type parameter, `T::make()` or `T::go(t)`
    /// under `where T: Beta`, names the member of the bound's trait that
    /// declares it, as a method call on a receiver of that parameter does,
    /// whichever `where` level writes the bound.  The path records that
    /// trait: once `T` is substituted, the type it becomes may provide a
    /// member of the same name through another trait.  A head the writer
    /// qualified (`(Beta for T)::go`) is already directed; two traits
    /// answering leave the path undirected, and the instantiation reports
    /// the tie.
    ///
    /// Returns the call's type as the directing trait declares it, `This`
    /// being the parameter (`T::try_from(v)` under `where T: TryFrom<X>` is
    /// a `Result<T, ConversionError>`), so a call on the result is typed,
    /// and selected, where it is written.  Invalid when no one trait
    /// directs the path.
    direct_param_path(mut &this, scope: ScopeResolutionNode*) -> TypeRef {
        if (scope.impl_trait != null) { return TypeRef::invalid(); }
        const param_ty: TypeRef = this.symbolic.symbolic_scope_param_type(scope);
        if (!param_ty.is_valid()) { return TypeRef::invalid(); }
        mut dir: BoundDirection = BoundDirection::none();
        const ret: TypeRef = this.binding.abstract_receiver_method_return(param_ty, scope.member_name, null, &dir);
        if (!dir.named().is_valid()) { return TypeRef::invalid(); }
        // A walk that directed the path already finds the same trait.
        if (!scope.resolved_trait.is_valid()) { scope.set_resolved_trait(dir.named()); }
        if (!scope.resolved_trait.equals(dir.named())) { return TypeRef::invalid(); }
        return ret;
    }

    /// Whether the declaration a `Scope::member` call names has a signature
    /// the name layer refused: a module's function, the definition the name
    /// layer bound for the member (`names_module`), else the owner's method,
    /// by the owner type its methods registered on and the written leaf.
    scope_callee_signature_refused(mut &this, scope: ScopeResolutionNode*, names_module: boolean) -> boolean {
        if (names_module) {
            return this.ctx.defs.signature_refused(scope.member_def);
        }
        mut owner_t: TypeRef = scope.spec_owner;
        if (!owner_t.is_valid()) { owner_t = this.types.scope_qualifier_type(scope); }
        return this.ctx.decl_index.method_signature_refused(owner_t, scope.member_name);
    }

    /// True when `owner` - the type that won resolution, or a written
    /// specialization's instantiation - is a generic template, the static
    /// method the call `call` through `scope` selects of it is a template of
    /// its own (`static_call_template`), or the owner is an instantiation
    /// not yet built.  Sema then leaves the callee unpinned for mono.
    scope_is_generic_template(mut &this, owner: TypeRef, scope: ScopeResolutionNode*, call: CallExprNode*) -> boolean {
        if (!owner.is_valid()) { return false; }
        if (this.ctx.generic_registry.template_of_type(owner) != null) { return true; }
        const owner_def: DefId = this.ctx.decl_index.def_of(owner, this.ctx.type_arena);
        if (owner_def.is_valid() && this.static_call_template(owner_def, scope, call) != null) {
            return true;
        }
        const t: Type* = this.arena.lookup(owner);
        return t != null && t.kind == TypeKind::InstantiatedType;
    }

    /// The generic OWNER template a static call's scope segment names, or
    /// null when it names none.
    ///
    /// Read off the segment's stamp: a template is a declaration, and the
    /// stamp names the declaration under the canonical name the registry is
    /// keyed by, accounting for the imports of the module that WROTE the
    /// segment.  A spelling cannot: a bare leaf reaches no registry key, and
    /// a module-qualified path (`hashmap::HashMap`) is any whole-segment
    /// suffix of the canonical one.  A segment already spelled as a
    /// specialization carries its template's stamp and so still names the
    /// template here, which is the question this answers; the specialization's
    /// own registry key is a different question, and the owner key answers it.
    resolve_scope_owner_template(&this, scope: ScopeResolutionNode*) -> TemplateEntry* {
        return this.lookup_scope_template(
            scope.require_scope_res("static-call owner template"));
    }

    pin_scope_callee_combined(mut &this, call: CallExprNode*, scope: ScopeResolutionNode*, scope_sym: SymbolStr,
                              owner: TypeRef, member_sym: SymbolStr) -> void {
        if (call == null) { return; }
        // Judge BEFORE the early returns below: a call whose callee is already
        // pinned, or whose owner is a generic template, is still a call to a
        // method the use site may not name.  `scope_sym` is the owner that won
        // resolution, so the verdict is about the method that actually binds.
        if (member_sym.is_valid() && scope_sym.is_valid()) {
            this.enforce_static_method_visibility(owner, member_sym, call.span);
        }
        if (call.resolved_callee.is_some()) { return; }
        if (!scope_sym.is_valid() || !member_sym.is_valid()) { return; }
        if (this.scope_is_generic_template(owner, scope, call)) {
            this.record_template_static(call, scope, owner);
            return;
        }
        const scope_str: string = this.intern.resolve(scope_sym);
        const member_str: string = this.intern.resolve(member_sym);
        if (scope_str.length() == 0 || member_str.length() == 0) { return; }
        if (scope.impl_trait != null) {
            this.pin_impl_qualified_call(call, scope, scope_sym, owner, member_sym);
            return;
        }
        // A path a bound directs (`T::make()` under `where T: Beta`, the
        // parameter since substituted): the member is THAT trait's when its
        // implementation for the owner delivers one - a direction, so a
        // trait that delivers nothing leaves the path to the bare reading.
        if (scope.resolved_trait.is_valid()) {
            const directed: [OverloadId] = this.trait_delivered_entries(FamilyOwner::Type(owner), scope.resolved_trait, member_sym);
            if (directed.length > 0 && this.pin_trait_delivered_call(call, scope, &directed)) { return; }
        }
        if (this.pin_trait_qualified_call(call, scope, member_sym)) { return; }
        if (this.try_pin_static_method_overload(call, scope, FamilyOwner::Type(owner), member_sym)) { return; }
        // Single-entry static method: pin the entry, consistent with
        // instance methods (`bind_method_on_receiver`) and the multi-entry
        // static path above.  A family the arguments cannot select one entry
        // of is left unpinned: a name codegen would have to resolve by
        // spelling is not a pin.
        if (this.ctx.decl_index != null) {
            const entries: [OverloadId] = this.ctx.decl_index.lookup_family_entries(FamilyOwner::Type(owner), member_sym);
            if (entries.length == 1) {
                this.pin_static_entry(call, scope, entries[0]);
            }
        }
    }

    /// Record on a static call whose owner is a generic type - its template,
    /// or an instantiation not built yet - the method it names, in the
    /// template's terms, where it is written: through an impl head, that
    /// trait's declared method; otherwise the method of the template's
    /// family the arguments' count admits, a tie between an inherent method
    /// and a trait's reported here as everywhere (`choose_entry`).  Every
    /// copy of the body carries it, and monomorphization binds it on the
    /// minted owner by identity.
    /// Records nothing for an owner with no template: its generic static
    /// method is a template of its own, which monomorphization specializes.
    record_template_static(mut &this, call: CallExprNode*, scope: ScopeResolutionNode*, owner: TypeRef) -> void {
        if (call.template_method.is_valid()) { return; }
        if (scope.impl_trait != null) {
            const head_trait: DefId = this.impl_qualified_trait(scope);
            if (head_trait.is_valid()) { call.template_method = this.trait_item_def(head_trait, scope); }
            return;
        }
        mut base: TypeRef = this.arena.inst_generic_base(owner);
        if (!base.is_valid()) { base = owner; }
        if (this.ctx.generic_registry.template_of_type(base) == null) { return; }
        const entries: [OverloadId] = this.member_entries(FamilyOwner::Type(base), scope.member_name);
        mut fits: [OverloadId] = [];
        for (mut i: i64 = 0; i < entries.length; i++) {
            const et: Type* = this.arena.lookup(this.ctx.decl_index.entry_signature(entries[i]));
            if (et == null || et.kind != TypeKind::Function) { continue; }
            if (et.as_function().param_types.length == call.arguments.length) { fits.push(entries[i]); }
        }
        if (fits.length == 0) { return; }
        // A tie is reported against the owner as written (`GnTf<i32>`).
        const chosen: OverloadId = this.choose_entry(&fits, scope, call, FamilyOwner::Type(this.scope_owner_type(scope)));
        const m_decl: DeclarationNode* = this.ctx.decl_index.entry_method(chosen);
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m == null || m.func == null) { return; }
        call.template_method = if (DeclarationNode::fn_of(m.func).def.is_valid()) { DeclarationNode::fn_of(m.func).def } else { DeclarationNode::fn_of(m.func).copy_of };
    }

    /// The definition of `trait_def`'s declared method the path `scope`
    /// names, found through the trait-method door; invalid when the trait
    /// declares none.
    trait_item_def(&this, trait_def: DefId, scope: ScopeResolutionNode*) -> DefId {
        const slot: i64 = this.trait_slot_of(trait_def, scope.member_name);
        const decl: TraitDecl* = this.ctx.generic_registry.get_trait_decl(trait_def);
        if (slot < 0 || decl == null || slot >= decl.methods.length || decl.methods[slot] == null) {
            return DefId::invalid();
        }
        return DeclarationNode::fn_of(decl.methods[slot]).def;
    }

    /// A call written through a TRAIT's path, `Beta::go(&p, ...)`: the
    /// implementation is the receiver's - the first argument's type, behind
    /// any reference or pointer - and the method is the one that trait
    /// delivers for it, so a name two traits provide is chosen by naming
    /// the trait, `Trait::method(recv)`.  Answers false when
    /// the scope is not a trait, and true once the scope is a trait whether
    /// or not an implementation was found: the path names a trait's method
    /// and no other selector applies to it.  A static trait method takes no
    /// receiver and selects nothing here.
    pin_trait_qualified_call(mut &this, call: CallExprNode*, scope: ScopeResolutionNode*,
                             member_sym: SymbolStr) -> boolean {
        const qual: TypeRef = this.types.scope_qualifier_type(scope);
        if (!qual.is_valid()) { return false; }
        const qt: Type* = this.arena.lookup(qual);
        if (qt == null || qt.kind != TypeKind::Trait) { return false; }
        const trait_sym: DefId = this.ctx.decl_index.def_of(qual, this.ctx.type_arena);
        // No argument selects an implementation: a static trait method, or
        // a method called with nothing.  Refused here, where the path is
        // known to be a trait's, rather than left for codegen to fail to
        // resolve; the help names the form that does select.
        if (call.arguments.length == 0) {
            this.report_trait_qualified_unselected(scope, trait_sym, member_sym, call);
            return true;
        }
        const recv: ExpressionNode* = call.arguments[0];
        if (recv == null || !recv.resolved_type.is_valid()) { return true; }
        const owner_ty: TypeRef = this.trait_qualified_owner(recv.resolved_type);
        const owner_sym: SymbolStr = this.ctx.decl_index.lookup_type_name(owner_ty);
        if (!owner_sym.is_valid()) { return true; }
        const entries: [OverloadId] = this.trait_delivered_entries(FamilyOwner::Type(owner_ty), trait_sym, member_sym);
        if (entries.length == 0) {
            this.report_impl_qualified_miss(scope, owner_sym, owner_ty, trait_sym, member_sym);
            return true;
        }
        this.pin_trait_delivered_call(call, scope, &entries);
        return true;
    }

    /// The registered name of the type a trait-qualified call's first
    /// argument selects the implementation by: the argument's type behind
    /// any reference or pointer.  Empty for a type the index holds no name
    /// for (a primitive's impl, left to codegen's refusal as before).
    trait_qualified_owner(&this, recv_type: TypeRef) -> TypeRef {
        mut owner_ref: TypeRef = recv_type;
        mut hops: i32 = 0;
        while (hops < 4) {
            const ot: Type* = this.arena.lookup(owner_ref);
            if (ot == null) { break; }
            if (ot.kind == TypeKind::Reference) { owner_ref = ot.as_reference().referent; }
            else if (ot.kind == TypeKind::Pointer) { owner_ref = ot.as_pointer().pointee; }
            else { break; }
            hops = hops + 1;
        }
        return owner_ref;
    }

    /// `Trait::m()` with no argument: nothing selects an implementation.  A
    /// static method through the trait's own path has no receiver to select
    /// by, which is what the impl-qualified path exists for.  Silent during
    /// a symbolic generic-body walk.
    report_trait_qualified_unselected(mut &this, scope: ScopeResolutionNode*, trait_sym: DefId,
                                      member_sym: SymbolStr, call: CallExprNode*) -> void {
        if (this.state.in_symbolic_check) { return; }
        const trait_leaf: string = QualifiedName::leaf_of(this.intern.shown(this.ctx.defs.path_of(trait_sym)));
        const member_str: string = this.intern.resolve(member_sym);
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0233_UNDEFINED_SYMBOL,
            fmt::format("`%s::%s()` selects no implementation: a call through a trait's path selects by its first argument's type, and there is none",
                trait_leaf, member_str));
        d = d.at_with_label(call.span, "no argument to select an implementation by");
        d = d.help(fmt::format("name the implementation: `(%s for Type)::%s()`", trait_leaf, member_str));
        this.ctx.emit_diagnostic(d);
    }

    /// The signature an overloaded function taken as a VALUE names: the
    /// overload whose signature is the expected function type.  Invalid when
    /// there is nothing to choose - fewer than two signatures, or an expected
    /// type that is no function type - and when no overload has the expected
    /// one; the caller keeps the declaration's own signature, which the
    /// binding it flows into then checks.  With no expected type at all
    /// nothing chooses, and the value is refused as ambiguous (E0154) with
    /// each overload named and a help line that types the binding the value
    /// initializes - `value` itself when it is a declaration's whole
    /// initializer - with the first overload's signature; `refused` says so.
    value_overload_signature(mut &this, entries: &[OverloadId], shown: string, span: SourceSpan,
                             value: ExpressionNode*, refused: mut &boolean) -> TypeRef {
        if (entries.length < 2) { return TypeRef::invalid(); }
        const first: TypeRef = this.ctx.decl_index.entry_signature(entries[0]);
        mut several: boolean = false;
        for (mut i: i64 = 1; i < entries.length; i++) {
            if (!this.ctx.decl_index.entry_signature(entries[i]).equals(first)) { several = true; }
        }
        if (!several) { return TypeRef::invalid(); }
        const expected: TypeRef = this.state.expected_type;
        if (expected.is_valid()) {
            const et: Type* = this.arena.lookup(expected);
            if (et == null || et.kind != TypeKind::Function) { return TypeRef::invalid(); }
            for (mut i: i64 = 0; i < entries.length; i++) {
                const sig: TypeRef = this.ctx.decl_index.entry_signature(entries[i]);
                if (sig.equals(expected)) { return sig; }
            }
            return TypeRef::invalid();
        }
        this.report_ambiguous_value(entries, shown, span, value, first);
        *refused = true;
        return TypeRef::invalid();
    }

    /// E0154 for an overloaded function taken as a value that nothing
    /// chooses among `entries`, each named, with a help line that types the
    /// binding the value initializes with `example`.
    report_ambiguous_value(mut &this, entries: &[OverloadId], shown: string, span: SourceSpan,
                           value: ExpressionNode*, example: TypeRef) -> void {
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0154_AMBIGUOUS_CALL,
            fmt::format("`%s` is overloaded, and nothing here says which overload is meant", shown));
        d = d.at_with_label(span, fmt::format("%lld overloads", entries.length));
        for (mut i: i64 = 0; i < entries.length; i++) {
            const at: SourceSpan = this.ctx.decl_index.entry_span(entries[i]);
            if (at.has_location()) {
                d = d.with_note_at(fmt::format("an overload of `%s`", shown), at);
            }
        }
        const binding: string = if (value != null && value == this.state.untyped_init && this.state.untyped_binding.is_valid()) {
            this.intern.resolve(this.state.untyped_binding)
        } else {
            "f"
        };
        d = d.help(fmt::format("give the variable a function type to pick one: `const %s: %s = %s;`",
            binding, this.types.type_display_name(example), shown));
        this.ctx.emit_diagnostic(d);
    }

    /// The overload of `def`'s family a function taken as a VALUE names, when
    /// the family holds a generic function: the one entry whose value fits
    /// the turbofish `written` and the expected type.  A generic overload
    /// fits when every type parameter is bound - by `written`, its defaults,
    /// or the expected function type unified with its signature - and the
    /// signature with those arguments is the expected type, when there is
    /// one.  A non-generic overload fits when nothing is written and its
    /// signature is the expected type.  With neither a turbofish nor an
    /// expected type nothing chooses.  More than one fit is refused as
    /// ambiguous (E0154) and `refused` says so; invalid with no refusal when
    /// the family is a single function or holds no generic one, and when
    /// nothing fits - the declaration the name binds is then the value, and
    /// the binding it flows into reports the mismatch.
    value_family_entry(mut &this, def: DefId, written: &[TypeAnnotation*], shown: string,
                       span: SourceSpan, value: ExpressionNode*, refused: mut &boolean) -> OverloadId {
        const family: [OverloadId] = this.family_entries(def);
        if (family.length < 2) { return OverloadId::invalid(); }
        mut any_generic: boolean = false;
        for (mut i: i64 = 0; i < family.length; i++) {
            const d: ASTNode* = this.ctx.decl_index.entry_decl(family[i]);
            if (d != null && DeclarationNode::fn_of(d) != null
                    && DeclarationNode::fn_of(d).generic_params.length > 0) { any_generic = true; }
        }
        if (!any_generic) { return OverloadId::invalid(); }
        mut expected: TypeRef = this.state.expected_type;
        if (expected.is_valid()) {
            const et: Type* = this.arena.lookup(expected);
            if (et == null || et.kind != TypeKind::Function
                    || (!this.state.in_symbolic_check && this.types.contains_generic_param(expected))) {
                expected = TypeRef::invalid();
            }
        }
        if (written.length == 0 && !expected.is_valid()) {
            this.report_ambiguous_value(&family, shown, span, value,
                this.ctx.decl_index.entry_signature(family[0]));
            *refused = true;
            return OverloadId::invalid();
        }
        // The written arguments are resolved once here, so an unknown type
        // among them is reported once, by the value's own instance below.
        if (written.length > 0) {
            mut rc: ResolutionContext = ResolutionContext::new("");
            this.symbolic.symbolic_bind_params(&rc);
            for (mut i: i64 = 0; i < written.length; i++) {
                if (!this.ctx.type_resolver.resolve(written[i], &rc).is_valid()) { return OverloadId::invalid(); }
            }
        }
        mut fits: [OverloadId] = [];
        mut example: TypeRef = TypeRef::invalid();
        for (mut i: i64 = 0; i < family.length; i++) {
            const d: ASTNode* = this.ctx.decl_index.entry_decl(family[i]);
            if (d == null || DeclarationNode::fn_of(d) == null) { continue; }
            const f_decl: DeclarationNode* = DeclarationNode::with_shape(d);
            const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
            const sig: TypeRef = this.ctx.decl_index.entry_signature(family[i]);
            if (!sig.is_valid()) { continue; }
            const tm: TemplateEntry* = this.ctx.generic_registry.template_of(f.def);
            if (tm == null || tm.kind != TemplateKind::Function) {
                if (written.length == 0 && expected.is_valid() && sig.equals(expected)) {
                    fits.push(family[i]);
                    example = sig;
                }
                continue;
            }
            const inst: TypeRef = this.generic_value_fit(tm, sig, written, expected, span);
            if (inst.is_valid()) {
                fits.push(family[i]);
                example = inst;
            }
        }
        if (fits.length == 1) { return fits[0]; }
        if (fits.length == 0) { return OverloadId::invalid(); }
        this.report_ambiguous_value(&fits, shown, span, value, example);
        *refused = true;
        return OverloadId::invalid();
    }

    /// The type a generic function `entry` with signature `sig` takes as a
    /// value under the turbofish `written` and the function type `expected`
    /// (either may be absent), or invalid when a type parameter stays unbound,
    /// the turbofish names more arguments than the function has, or the
    /// result is not `expected`.  Reports nothing: it answers whether this
    /// overload is the one meant.
    generic_value_fit(mut &this, entry: TemplateEntry*, sig: TypeRef, written: &[TypeAnnotation*],
                      expected: TypeRef, span: SourceSpan) -> TypeRef {
        if (written.length > entry.param_types.length) { return TypeRef::invalid(); }
        mut bindings: [TypeRef] = [];
        mut pids: [TypeRef] = [];
        for (mut i: i64 = 0; i < entry.param_types.length; i++) {
            bindings.push(TypeRef::invalid());
            pids.push(entry.param_types[i]);
        }
        if (written.length > 0) {
            const named: TypeRef = this.resolve_generic_scope_type(entry.base_type, written, span);
            if (!named.is_valid() || named.equals(entry.base_type)) { return TypeRef::invalid(); }
            const resolved: [TypeRef] = this.types.view_type_args_copy(named);
            for (mut i: i64 = 0; i < bindings.length && i < resolved.length; i++) { bindings[i] = resolved[i]; }
        } else {
            mut ictx: InferCtx = InferCtx::for_template(this.arena, pids);
            ictx.unify(sig, expected);
            for (mut i: i64 = 0; i < bindings.length; i++) { bindings[i] = ictx.bindings[i]; }
        }
        for (mut i: i64 = 0; i < bindings.length; i++) {
            if (!bindings[i].is_valid()) { return TypeRef::invalid(); }
        }
        const ty: TypeRef = this.subst_params(&entry.param_types, &bindings, sig);
        if (expected.is_valid() && !ty.equals(expected)) { return TypeRef::invalid(); }
        return ty;
    }

    /// The overload of a method family `entries` that a method taken as a
    /// VALUE names, when the family holds a generic method: the one entry
    /// whose value fits the turbofish `scope` writes and the expected type,
    /// as `value_family_entry` chooses among a function's.  With neither a
    /// turbofish nor an expected function type nothing chooses, and more
    /// than one fit is ambiguous: both are refused (E0154) and `refused`
    /// says so.  Null with no refusal when the family is a single method or
    /// holds no generic one, and when nothing fits - the first method is
    /// then the value, and the binding it flows into reports the mismatch.
    method_value_entry(mut &this, entries: &[OverloadId], scope: ScopeResolutionNode*,
                       refused: mut &boolean) -> DeclarationNode* {
        if (entries.length < 2) { return null; }
        mut any_generic: boolean = false;
        for (mut i: i64 = 0; i < entries.length; i++) {
            const m_decl: DeclarationNode* = this.ctx.decl_index.entry_method(entries[i]);
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m != null && m.func != null && DeclarationNode::fn_of(m.func).generic_params.length > 0) { any_generic = true; }
        }
        if (!any_generic) { return null; }
        const shown: string = fmt::format("%s::%s",
            this.intern.resolve(scope.scope_name), this.intern.resolve(scope.member_name));
        mut expected: TypeRef = this.state.expected_type;
        if (expected.is_valid()) {
            const et: Type* = this.arena.lookup(expected);
            if (et == null || et.kind != TypeKind::Function
                    || (!this.state.in_symbolic_check && this.types.contains_generic_param(expected))) {
                expected = TypeRef::invalid();
            }
        }
        if (scope.generic_args.length == 0 && !expected.is_valid()) {
            this.report_ambiguous_value(entries, shown, scope.span, scope as ExpressionNode*,
                this.ctx.decl_index.entry_signature(entries[0]));
            *refused = true;
            return null;
        }
        // The written arguments are resolved once here; one that names no
        // type is reported by the value's own instance.
        mut written: [TypeRef] = [];
        if (scope.generic_args.length > 0) {
            mut rc: ResolutionContext = ResolutionContext::new("");
            this.symbolic.symbolic_bind_params(&rc);
            for (mut i: i64 = 0; i < scope.generic_args.length; i++) {
                const tr: TypeRef = this.ctx.type_resolver.resolve(scope.generic_args[i], &rc);
                if (!tr.is_valid()) { return null; }
                written.push(tr);
            }
        }
        mut fits: [OverloadId] = [];
        mut example: TypeRef = TypeRef::invalid();
        for (mut i: i64 = 0; i < entries.length; i++) {
            const ty: TypeRef = this.method_value_fit(entries[i], &written, expected);
            if (ty.is_valid()) {
                fits.push(entries[i]);
                example = ty;
            }
        }
        if (fits.length == 1) { return this.ctx.decl_index.entry_method(fits[0]); }
        if (fits.length == 0) { return null; }
        this.report_ambiguous_value(&fits, shown, scope.span, scope as ExpressionNode*, example);
        *refused = true;
        return null;
    }

    /// The type method entry `entry` takes as a value under the type
    /// arguments `written` and the function type `expected` (either may be
    /// absent), or invalid when one of its own type parameters stays
    /// unbound, more arguments are written than it has, or the result is not
    /// `expected`.  A method with no type parameters fits only with nothing
    /// written.  Reports nothing.
    method_value_fit(mut &this, entry: OverloadId, written: &[TypeRef], expected: TypeRef) -> TypeRef {
        const node_decl: DeclarationNode* = this.ctx.decl_index.entry_method(entry);
        const node: MethodDecl* = DeclarationNode::method_of(node_decl);
        const sig: TypeRef = this.ctx.decl_index.entry_signature(entry);
        if (node == null || node.func == null || !sig.is_valid()) { return TypeRef::invalid(); }
        const gps: &[DeclarationNode*] = &DeclarationNode::fn_of(node.func).generic_params;
        if (gps.length == 0) {
            if (written.length == 0 && expected.is_valid() && sig.equals(expected)) { return sig; }
            return TypeRef::invalid();
        }
        if (written.length > gps.length) { return TypeRef::invalid(); }
        mut named: [TypeRef] = [];
        this.arena.generic_params_in(sig, &named);
        mut handles: [TypeRef] = [];
        mut bindings: [TypeRef] = [];
        for (mut i: i64 = 0; i < gps.length; i++) {
            mut handle: TypeRef = TypeRef::invalid();
            for (mut k: i64 = 0; k < named.length; k++) {
                const gt: Type* = this.arena.lookup(named[k]);
                if (gt != null && gt.as_generic_param().param_sym.equals(DeclarationNode::generic_param_of(gps[i]).sym_id)) { handle = named[k]; }
            }
            handles.push(handle);
            bindings.push(if (i < written.length) { written[i] } else { TypeRef::invalid() });
        }
        // A generic owner's parameters the signature names are bound by the
        // expected type alone; the path's owner arguments are applied to the
        // instance the value becomes, not to the choice of overload.
        mut others: [TypeRef] = [];
        for (mut k: i64 = 0; k < named.length; k++) {
            mut own: boolean = false;
            for (mut i: i64 = 0; i < handles.length; i++) {
                if (handles[i].is_valid() && handles[i].equals(named[k])) { own = true; }
            }
            if (!own) { others.push(named[k]); }
        }
        mut sub_params: [TypeRef] = [];
        mut sub_args: [TypeRef] = [];
        if (expected.is_valid()) {
            mut pids: [TypeRef] = [];
            for (mut i: i64 = 0; i < handles.length; i++) {
                if (handles[i].is_valid() && !bindings[i].is_valid()) { pids.push(handles[i]); }
            }
            for (mut k: i64 = 0; k < others.length; k++) { pids.push(others[k]); }
            mut ictx: InferCtx = InferCtx::for_template(this.arena, pids);
            ictx.unify(sig, expected);
            mut p: i64 = 0;
            for (mut i: i64 = 0; i < handles.length; i++) {
                if (!handles[i].is_valid() || bindings[i].is_valid()) { continue; }
                bindings[i] = ictx.bindings[p];
                p = p + 1;
            }
            for (mut k: i64 = 0; k < others.length; k++) {
                if (!ictx.bindings[p].is_valid()) { return TypeRef::invalid(); }
                sub_params.push(others[k]);
                sub_args.push(ictx.bindings[p]);
                p = p + 1;
            }
        }
        for (mut i: i64 = 0; i < handles.length; i++) {
            if (!bindings[i].is_valid()) { return TypeRef::invalid(); }
            if (handles[i].is_valid()) {
                sub_params.push(handles[i]);
                sub_args.push(bindings[i]);
            }
        }
        const ty: TypeRef = this.subst_params(&sub_params, &sub_args, sig);
        if (expected.is_valid() && !ty.equals(expected)) { return TypeRef::invalid(); }
        return ty;
    }

    /// The type of a generic function or a generic owner's method taken as a
    /// VALUE: its signature `sig`, written over `params` - the template's
    /// type parameters, positionally `entry`'s - with the type arguments the
    /// turbofish `written` names, or, with none written, those the expected
    /// function type binds when unified with the signature.  `out_args`
    /// receives them, in that order - the instance the value is.  A
    /// parameter neither binds is refused (E0307): nothing else could choose
    /// the instance.  Invalid when refused or not all bound.
    generic_value_type(mut &this, entry: TemplateEntry*, params: &[TypeRef], sig: TypeRef,
                       written: &[TypeAnnotation*], shown: string, with_args: string, span: SourceSpan,
                       out_args: mut &[TypeRef]) -> TypeRef {
        if (params.length != entry.param_types.length) { return TypeRef::invalid(); }
        mut bindings: [TypeRef] = [];
        for (mut i: i64 = 0; i < params.length; i++) { bindings.push(TypeRef::invalid()); }
        if (written.length > 0) {
            // The written arguments, defaults filled, as the template's
            // instantiation they name.
            const named: TypeRef = this.resolve_generic_scope_type(entry.base_type, written, span);
            if (!named.is_valid() || named.equals(entry.base_type)) { return TypeRef::invalid(); }
            const resolved: [TypeRef] = this.types.view_type_args_copy(named);
            for (mut i: i64 = 0; i < bindings.length && i < resolved.length; i++) { bindings[i] = resolved[i]; }
        } else {
            const expected: TypeRef = this.state.expected_type;
            mut et: Type* = null;
            if (expected.is_valid()) { et = this.arena.lookup(expected); }
            if (et != null && et.kind == TypeKind::Function
                    && (this.state.in_symbolic_check || !this.types.contains_generic_param(expected))) {
                mut pids: [TypeRef] = [];
                for (mut i: i64 = 0; i < params.length; i++) { pids.push(params[i]); }
                mut ictx: InferCtx = InferCtx::for_template(this.arena, pids);
                ictx.unify(sig, expected);
                for (mut i: i64 = 0; i < bindings.length; i++) { bindings[i] = ictx.bindings[i]; }
            }
        }
        for (mut i: i64 = 0; i < bindings.length; i++) {
            if (bindings[i].is_valid()) { continue; }
            this.report_uninferable_value(this.types.type_display_name(entry.param_types[i]),
                shown, with_args, span);
            return TypeRef::invalid();
        }
        // A function's where-clause holds for the instance, as for a call.
        if (entry.kind == TemplateKind::Function && entry.ast_node != null
                && !this.check_call_where_bounds(span, DeclarationNode::with_shape(entry.ast_node), &entry.param_syms, &bindings)) {
            return TypeRef::invalid();
        }
        const ty: TypeRef = this.subst_params(params, &bindings, sig);
        if (ty.is_valid()) { *out_args = bindings; }
        return ty;
    }

    /// E0307 for a generic function or method taken as a value whose type
    /// parameter `pname` nothing binds.
    report_uninferable_value(mut &this, pname: string, shown: string, with_args: string,
                             span: SourceSpan) -> void {
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0307_CANNOT_INFER_TYPE_ARG,
            fmt::format("cannot infer `%s` for `%s` used as a value", pname, shown));
        d = d.at_with_label(span, "generic, and nothing here says which instance this names");
        d = d.help(fmt::format(
            "write the type arguments, `%s`, or give the binding a function type", with_args));
        this.ctx.emit_diagnostic(d);
    }

    /// A method with type parameters of its own taken as a value,
    /// `Box::wrap::<i32>`: one instance of it, whose type arguments the
    /// turbofish on the member writes, one per parameter, or the expected
    /// function type binds when unified with the method's signature -
    /// receiver first for a method with one.  The method's definition, its
    /// owner and the arguments are recorded on the node, from which
    /// monomorphization mints and pins the instance.  On a generic owner,
    /// `Wrap::<i32>::conv::<u8>`, the value is the method of one instance
    /// of the owner too, whose arguments the path writes on the owner or the
    /// expected type binds.  `owns` says whether the path names such a
    /// method at all, so the caller's answer is this one, valid or refused.
    generic_method_value(mut &this, scope: ScopeResolutionNode*, found: TypeRef,
                         owns: mut &boolean) -> TypeRef {
        if (!found.is_valid() || scope.impl_trait != null) { return TypeRef::invalid(); }
        mut owner: TypeRef = this.arena.inst_generic_base(found);
        if (!owner.is_valid()) { owner = found; }
        const ft0: Type* = this.arena.lookup(owner);
        if (ft0 == null || (ft0.kind != TypeKind::Struct && ft0.kind != TypeKind::Class)) { return TypeRef::invalid(); }
        // A generic owner's methods are its template's family, read through
        // the member-function door; a type's own are its method table's.
        const owner_entry: TemplateEntry* = this.ctx.generic_registry.template_of_type(owner);
        const generic_owner: boolean = owner_entry != null && owner_entry.param_types.length > 0;
        mut node: DeclarationNode* = null;
        mut is_static: boolean = false;
        mut call_params: [TypeRef] = [];
        mut ret: TypeRef = TypeRef::invalid();
        mut variadic: boolean = false;
        // An overloaded family is the overload the value's turbofish and
        // expected type choose; a single method is itself.
        const entries: [OverloadId] = this.member_entries(FamilyOwner::Type(owner), scope.member_name);
        mut refused: boolean = false;
        const chosen_decl: DeclarationNode* = this.method_value_entry(&entries, scope, &refused);
        const chosen: MethodDecl* = DeclarationNode::method_of(chosen_decl);
        if (refused) {
            *owns = true;
            return TypeRef::invalid();
        }
        if (generic_owner) {
            if (chosen != null) {
                node = chosen_decl;
            } else if (entries.length == 1) {
                node = this.ctx.decl_index.entry_method(entries[0]);
            }
            if (node == null || DeclarationNode::method_of(node).func == null) { return TypeRef::invalid(); }
            is_static = DeclarationNode::method_of(node).is_static;
            for (mut i: i64 = 0; i < DeclarationNode::fn_of(DeclarationNode::method_of(node).func).parameters.length; i++) {
                const p_decl: DeclarationNode* = DeclarationNode::fn_of(DeclarationNode::method_of(node).func).parameters[i];
                const p: VarDecl* = DeclarationNode::var_of(p_decl);
                if (p == null || !p.resolved_type.is_valid()) { return TypeRef::invalid(); }
                if (!p.is_receiver()) { call_params.push(p.resolved_type); }
            }
            ret = DeclarationNode::fn_of(DeclarationNode::method_of(node).func).resolved_return_type;
        } else {
            mut m: MethodInfo* = null;
            if (chosen != null) {
                const one: [DeclarationNode*] = [chosen_decl];
                m = this.ctx.decl_index.type_method_among(owner, &one, this.arena);
            } else {
                m = this.ctx.decl_index.type_method(owner, scope.member_name, this.arena);
            }
            if (m == null || m.ast_node == null) { return TypeRef::invalid(); }
            node = DeclarationNode::with_shape(m.ast_node);
            is_static = m.is_static;
            const st: Type* = this.arena.lookup(m.function_type);
            if (st == null || st.kind != TypeKind::Function) { return TypeRef::invalid(); }
            const ft: FunctionType* = st.as_function();
            for (mut i: i64 = 0; i < ft.param_types.length; i++) { call_params.push(ft.param_types[i]); }
            ret = ft.return_type;
            variadic = ft.is_variadic;
        }
        if (DeclarationNode::method_of(node).func == null || DeclarationNode::fn_of(DeclarationNode::method_of(node).func).generic_params.length == 0 || !DeclarationNode::fn_of(DeclarationNode::method_of(node).func).def.is_valid()) {
            return TypeRef::invalid();
        }
        *owns = true;
        if (this.scope_callee_signature_refused(scope, false)) { return TypeRef::invalid(); }
        // Read again after monomorphization: the instance it was pinned to.
        const pinned: OverloadId = scope.resolved_callee.decl_entry();
        if (pinned.is_valid()) { return this.ctx.decl_index.entry_signature(pinned); }
        if (!ret.is_valid()) { return TypeRef::invalid(); }
        // Each type parameter as the signature names it, found by the
        // symbol its declaration bound; one the signature never names has
        // no handle, and only a turbofish binds it.
        mut named: [TypeRef] = [];
        for (mut i: i64 = 0; i < call_params.length; i++) { this.arena.generic_params_in(call_params[i], &named); }
        this.arena.generic_params_in(ret, &named);
        mut owner_handles: [TypeRef] = [];
        if (generic_owner && !this.owner_param_handles(owner_entry, node, &named, &owner_handles)) {
            return TypeRef::invalid();
        }
        mut params: [TypeRef] = [];
        if (!is_static) {
            if (DeclarationNode::fn_of(DeclarationNode::method_of(node).func).parameters.length == 0) { return TypeRef::invalid(); }
            const recv_decl: DeclarationNode* = DeclarationNode::fn_of(DeclarationNode::method_of(node).func).parameters[0];
            const recv: VarDecl* = DeclarationNode::var_of(recv_decl);
            if (recv == null || !recv.is_receiver() || !recv.resolved_type.is_valid()) { return TypeRef::invalid(); }
            // A generic owner's receiver is the owner over the parameters
            // the signature names.
            params.push(if (generic_owner) {
                this.receiver_over(recv.resolved_type,
                    this.arena.create_instantiation(owner_entry.base_type, &owner_handles))
            } else {
                recv.resolved_type
            });
        }
        for (mut i: i64 = 0; i < call_params.length; i++) { params.push(call_params[i]); }
        const sig: TypeRef = this.arena.get_function(ret, &params, variadic);
        mut handles: [TypeRef] = [];
        mut syms: [SymbolID] = [];
        mut bindings: [TypeRef] = [];
        for (mut i: i64 = 0; i < DeclarationNode::fn_of(DeclarationNode::method_of(node).func).generic_params.length; i++) {
            const gp_decl: DeclarationNode* = DeclarationNode::fn_of(DeclarationNode::method_of(node).func).generic_params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            mut handle: TypeRef = TypeRef::invalid();
            for (mut k: i64 = 0; k < named.length; k++) {
                const gt: Type* = this.arena.lookup(named[k]);
                if (gt != null && gt.as_generic_param().param_sym.equals(gp.sym_id)) { handle = named[k]; }
            }
            handles.push(handle);
            syms.push(gp.sym_id);
            bindings.push(TypeRef::invalid());
        }
        // A generic owner's type parameters are bound by the arguments the
        // path writes on the owner, or else with the method's own by the
        // expected function type.
        mut owner_args: [TypeRef] = [];
        mut owner_unbound: boolean = false;
        if (generic_owner) {
            mut written_owner: TypeRef = TypeRef::invalid();
            if (scope.scope_generic_args.length > 0) {
                written_owner = this.resolve_generic_scope_type(owner_entry.base_type, &scope.scope_generic_args, scope.span);
                if (!written_owner.is_valid() || written_owner.equals(owner_entry.base_type)) { return TypeRef::invalid(); }
            } else if (!found.equals(owner)) {
                written_owner = found;
            }
            if (written_owner.is_valid()) { owner_args = this.types.view_type_args_copy(written_owner); }
            for (mut i: i64 = owner_args.length; i < owner_handles.length; i++) {
                owner_args.push(TypeRef::invalid());
                owner_unbound = true;
            }
        }
        const shown: string = fmt::format("%s::%s",
            this.intern.resolve(scope.scope_name), this.intern.resolve(scope.member_name));
        const with_args: string = fmt::format("%s::<...>", shown);
        if (scope.generic_args.length > 0) {
            mut rc: ResolutionContext = ResolutionContext::new("");
            this.symbolic.symbolic_bind_params(&rc);
            for (mut i: i64 = 0; i < scope.generic_args.length && i < bindings.length; i++) {
                const tr: TypeRef = this.ctx.type_resolver.resolve(scope.generic_args[i], &rc);
                if (!tr.is_valid()) { return TypeRef::invalid(); }
                bindings[i] = tr;
            }
        }
        if (scope.generic_args.length == 0 || owner_unbound) {
            const expected: TypeRef = this.state.expected_type;
            mut et: Type* = null;
            if (expected.is_valid()) { et = this.arena.lookup(expected); }
            if (et != null && et.kind == TypeKind::Function
                    && (this.state.in_symbolic_check || !this.types.contains_generic_param(expected))) {
                mut pids: [TypeRef] = [];
                for (mut i: i64 = 0; i < handles.length; i++) {
                    if (handles[i].is_valid() && !bindings[i].is_valid()) { pids.push(handles[i]); }
                }
                for (mut i: i64 = 0; i < owner_handles.length; i++) {
                    if (!owner_args[i].is_valid()) { pids.push(owner_handles[i]); }
                }
                mut ictx: InferCtx = InferCtx::for_template(this.arena, pids);
                ictx.unify(sig, expected);
                mut p: i64 = 0;
                for (mut i: i64 = 0; i < handles.length; i++) {
                    if (!handles[i].is_valid() || bindings[i].is_valid()) { continue; }
                    bindings[i] = ictx.bindings[p];
                    p = p + 1;
                }
                for (mut i: i64 = 0; i < owner_handles.length; i++) {
                    if (owner_args[i].is_valid()) { continue; }
                    owner_args[i] = ictx.bindings[p];
                    p = p + 1;
                }
            }
        }
        for (mut i: i64 = 0; i < owner_args.length; i++) {
            if (owner_args[i].is_valid()) { continue; }
            this.report_uninferable_value(this.types.type_display_name(owner_entry.param_types[i]), shown,
                fmt::format("%s::<...>::%s", this.intern.resolve(scope.scope_name),
                    this.intern.resolve(scope.member_name)),
                scope.span);
            return TypeRef::invalid();
        }
        for (mut i: i64 = 0; i < bindings.length; i++) {
            if (bindings[i].is_valid()) { continue; }
            this.report_uninferable_value(this.intern.resolve(DeclarationNode::generic_param_of(DeclarationNode::fn_of(DeclarationNode::method_of(node).func).generic_params[i]).name),
                shown, with_args, scope.span);
            return TypeRef::invalid();
        }
        if (scope.generic_args.length > bindings.length) {
            const plural: string = if (bindings.length == 1) { "" } else { "s" };
            mut d: Diagnostic = Diagnostic::error(ErrorCode::E0307_CANNOT_INFER_TYPE_ARG,
                fmt::format("`%s` has %lld type parameter%s, and %lld type arguments are written", shown,
                    bindings.length, plural, scope.generic_args.length));
            d = d.at_with_label(scope.span, "too many type arguments");
            this.ctx.emit_diagnostic(d);
            return TypeRef::invalid();
        }
        if (!this.check_call_where_bounds(scope.span, DeclarationNode::method_of(node).func, &syms, &bindings)) { return TypeRef::invalid(); }
        mut sub_params: [TypeRef] = [];
        mut sub_args: [TypeRef] = [];
        for (mut i: i64 = 0; i < handles.length; i++) {
            if (handles[i].is_valid()) {
                sub_params.push(handles[i]);
                sub_args.push(bindings[i]);
            }
        }
        for (mut i: i64 = 0; i < owner_handles.length; i++) {
            sub_params.push(owner_handles[i]);
            sub_args.push(owner_args[i]);
        }
        const value_ty: TypeRef = this.subst_params(&sub_params, &sub_args, sig);
        if (!value_ty.is_valid()) { return TypeRef::invalid(); }
        scope.template_method = DeclarationNode::fn_of(DeclarationNode::method_of(node).func).def;
        scope.spec_owner = if (owner_handles.length == 0) {
            found
        } else {
            if (this.types.contains_generic_param(value_ty)) {
                this.arena.create_instantiation(owner_entry.base_type, &owner_args)
            } else {
                this.ctx.generic_registry.instantiate(owner_entry.base_type, &owner_args)
            }
        };
        scope.value_type_args = bindings;
        return value_ty;
    }

    /// A generic owner's method taken as a value, `Wrap::get` or
    /// `Wrap::<i32>::get`: the method of one instance of the owner, whose
    /// type arguments the path writes on the owner or the expected function
    /// type binds (`const g: (&Wrap<i32>) -> i32 = Wrap::get;`).  The
    /// method is the owner template's entry under the member's leaf, and the
    /// value's type is its declaration's signature, receiver first, with the
    /// arguments.  The owner instance and the method's
    /// definition are recorded on the node, for monomorphization to pin the
    /// instance's method.  `owns` says whether the path is such a method at
    /// all - a generic owner's, without type parameters of its own, one
    /// entry - so the caller's answer is this one, valid or refused.
    generic_owner_method_value(mut &this, scope: ScopeResolutionNode*, found: TypeRef,
                               owns: mut &boolean) -> TypeRef {
        if (!found.is_valid() || scope.impl_trait != null) { return TypeRef::invalid(); }
        mut base: TypeRef = this.arena.inst_generic_base(found);
        if (!base.is_valid()) { base = found; }
        const owner_entry: TemplateEntry* = this.ctx.generic_registry.template_of_type(base);
        if (owner_entry == null || owner_entry.param_types.length == 0) { return TypeRef::invalid(); }
        if (owner_entry.kind != TemplateKind::Struct && owner_entry.kind != TemplateKind::Union
                && owner_entry.kind != TemplateKind::Class) { return TypeRef::invalid(); }
        const entries: [OverloadId] = this.member_entries(FamilyOwner::Type(base), scope.member_name);
        if (entries.length != 1) { return TypeRef::invalid(); }
        const m_decl: DeclarationNode* = this.ctx.decl_index.entry_method(entries[0]);
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m == null || m.func == null || DeclarationNode::fn_of(m.func).generic_params.length > 0 || !DeclarationNode::fn_of(m.func).def.is_valid()) {
            return TypeRef::invalid();
        }
        *owns = true;
        if (this.scope_callee_signature_refused(scope, false)) { return TypeRef::invalid(); }
        // The method's signature names the type parameters of the block that
        // declares it: an inherent `implement<T> struct Wrap<T>` block's own,
        // which stand positionally for the owner's, or the owner's when the
        // method is declared in the type's body.  Its receiver is the owner
        // over those same parameters.
        // The block's parameters are found where the signature names them, by
        // the symbol each declaration bound; one the signature never names is
        // held by the owner's, which nothing in the signature matches.
        mut named: [TypeRef] = [];
        for (mut i: i64 = 0; i < DeclarationNode::fn_of(m.func).parameters.length; i++) {
            if (DeclarationNode::fn_of(m.func).parameters[i] != null) {
                this.arena.generic_params_in(DeclarationNode::var_of(DeclarationNode::fn_of(m.func).parameters[i]).resolved_type, &named);
            }
        }
        this.arena.generic_params_in(DeclarationNode::fn_of(m.func).resolved_return_type, &named);
        mut tparams: [TypeRef] = [];
        if (!this.owner_param_handles(owner_entry, m_decl, &named, &tparams)) { return TypeRef::invalid(); }
        const self_ty: TypeRef = this.arena.create_instantiation(owner_entry.base_type, &tparams);
        mut params: [TypeRef] = [];
        for (mut i: i64 = 0; i < DeclarationNode::fn_of(m.func).parameters.length; i++) {
            const p_decl: DeclarationNode* = DeclarationNode::fn_of(m.func).parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p == null || !p.resolved_type.is_valid()) { return TypeRef::invalid(); }
            params.push(if (i == 0 && p.is_receiver()) { this.receiver_over(p.resolved_type, self_ty) } else { p.resolved_type });
        }
        if (!DeclarationNode::fn_of(m.func).resolved_return_type.is_valid()) { return TypeRef::invalid(); }
        const sig: TypeRef = this.arena.get_function(DeclarationNode::fn_of(m.func).resolved_return_type, &params, false);
        mut args: [TypeRef] = [];
        const shown: string = fmt::format("%s::%s",
            this.intern.resolve(scope.scope_name), this.intern.resolve(scope.member_name));
        const value_ty: TypeRef = this.generic_value_type(owner_entry, &tparams, sig, &scope.scope_generic_args,
            shown,
            fmt::format("%s::<...>::%s", this.intern.resolve(scope.scope_name), this.intern.resolve(scope.member_name)),
            scope.span, &args);
        if (!value_ty.is_valid()) { return TypeRef::invalid(); }
        scope.spec_owner = if (this.types.contains_generic_param(value_ty)) {
            this.arena.create_instantiation(owner_entry.base_type, &args)
        } else {
            this.ctx.generic_registry.instantiate(owner_entry.base_type, &args)
        };
        scope.template_method = DeclarationNode::fn_of(m.func).def;
        return value_ty;
    }

    /// The generic owner's type parameters as the signature of its method
    /// `m` names them, one per owner parameter, into `out`.  The signature
    /// names those of the block that declares the method: an inherent
    /// `implement<T> struct Wrap<T>` block's own, which stand positionally
    /// for the owner's, or the owner's when the method is declared in the
    /// type's body.  `named` is every type parameter the signature names;
    /// each block parameter is found among them by the symbol its
    /// declaration bound, and one the signature never names is held by the
    /// owner's, which nothing in the signature matches.  False when the
    /// block's parameters do not stand one for one for the owner's.
    owner_param_handles(&this, owner_entry: TemplateEntry*, m_decl: DeclarationNode*, named: &[TypeRef],
                        out: mut &[TypeRef]) -> boolean {
        for (mut b: i64 = 0; b < owner_entry.impl_blocks.length && out.length == 0; b++) {
            const block: ImplBlock* = DeclarationNode::impl_of(owner_entry.impl_blocks[b]);
            if (block == null || block.trait_annotation != null) { continue; }
            if (!MethodDecl::is_method_of(m_decl, owner_entry.impl_blocks[b] as ASTNode*)) { continue; }
            if (block.generic_params.length != owner_entry.param_types.length) { return false; }
            for (mut i: i64 = 0; i < block.generic_params.length; i++) {
                mut handle: TypeRef = owner_entry.param_types[i];
                for (mut k: i64 = 0; k < named.length; k++) {
                    const gt: Type* = this.arena.lookup(named[k]);
                    if (gt != null && gt.as_generic_param().param_sym.equals(DeclarationNode::generic_param_of(block.generic_params[i]).sym_id)) {
                        handle = named[k];
                    }
                }
                out.push(handle);
            }
        }
        if (out.length == 0) {
            for (mut i: i64 = 0; i < owner_entry.param_types.length; i++) { out.push(owner_entry.param_types[i]); }
        }
        return true;
    }

    /// A receiver's declared type `recv` - the owner by value, by reference
    /// or by pointer - with the owner replaced by `self_ty`.
    receiver_over(mut &this, recv: TypeRef, self_ty: TypeRef) -> TypeRef {
        const t: Type* = this.arena.lookup(recv);
        if (t == null) { return self_ty; }
        if (t.kind == TypeKind::Reference) {
            return this.arena.get_reference_to(self_ty, t.as_reference().mutability);
        }
        if (t.kind == TypeKind::Pointer) { return this.arena.get_pointer_to(self_ty); }
        return self_ty;
    }

    /// The entries of `owner`'s family `member`, through the member-function
    /// door: what a static path written against `owner` names.
    member_entries(&this, owner: FamilyOwner, member_sym: SymbolStr) -> [OverloadId] {
        return this.ctx.decl_index.lookup_family_entries(owner, member_sym);
    }

    /// The entries of `owner`'s family `member` that `trait_sym`'s
    /// implementation delivers - the candidates a call naming the trait
    /// selects among, in registration order.
    trait_delivered_entries(&this, owner: FamilyOwner, trait_sym: DefId,
                            member_sym: SymbolStr) -> [OverloadId] {
        const all: [OverloadId] = this.member_entries(owner, member_sym);
        mut entries: [OverloadId] = [];
        for (mut i: i64 = 0; i < all.length; i++) {
            if (this.ctx.decl_index.entry_trait(all[i]).equals(trait_sym)) { entries.push(all[i]); }
        }
        return entries;
    }

    /// Pin `call` to the one of `entries` its arguments select, with the two
    /// passes every static pin uses, and type the path from that entry:
    /// the implementation's signature, not the trait declaration's, which
    /// may spell it in terms the impl decides.  Answers whether one was
    /// pinned.  An argument with no type yet, or a fit count other than one,
    /// pins nothing; a wrong count or a wrong type is reported by the
    /// argument checks, and the one mismatch those accept - a shared
    /// reference where the parameter is exclusive - is reported here.
    pin_trait_delivered_call(mut &this, call: CallExprNode*, scope: ScopeResolutionNode*,
                             entries: &[OverloadId]) -> boolean {
        mut arg_types: [TypeRef] = [];
        for (mut ai: i64 = 0; ai < call.arguments.length; ai++) {
            const arg: ExpressionNode* = call.arguments[ai];
            if (arg == null || !arg.resolved_type.is_valid()) { return false; }
            arg_types.push(arg.resolved_type);
        }
        mut fits: [OverloadId] = this.select_static_overload(entries, &arg_types, false, call, scope);
        if (fits.length == 0) { fits = this.select_static_overload(entries, &arg_types, true, call, scope); }
        if (fits.length == 0) { this.report_shared_for_exclusive(call, scope, entries, &arg_types); }
        if (fits.length != 1) { return false; }
        this.type_from_delivered_entry(scope, fits[0]);
        this.pin_static_entry(call, scope, fits[0]);
        return true;
    }

    /// A call through a trait's path has the selected implementation's
    /// return type: the trait declaration's names `This` and `This::Item`,
    /// which stand for no type at the call (`Dup::dup(&r)` is `Count`, not
    /// `This`; `Peek::peek(&r)` is `Option<i32>`, not `Option<This::Out>`).
    /// A call through a trait's path that no entry accepts because an
    /// argument is a SHARED reference where the parameter is an EXCLUSIVE
    /// one - `Iterator::next(&r)` against `next(mut &this)`.  A path call
    /// does not re-borrow its arguments: `&r` is not made `mut &r`,
    /// so the argument is refused, naming the parameter; the help
    /// gives the spelling that borrows exclusively.  Cryo writes no
    /// exclusive borrow as an expression: passing the value itself does,
    /// as the method form `r.next()` does.  Reported only when an entry
    /// accepts every argument once the mutability of a reference is set
    /// aside; a wrong count or type is the argument checks' to report.
    /// Silent during a symbolic generic-body walk.
    report_shared_for_exclusive(mut &this, call: CallExprNode*, scope: ScopeResolutionNode*,
                                entries: &[OverloadId], arg_types: &[TypeRef]) -> void {
        if (this.state.in_symbolic_check) { return; }
        for (mut ei: i64 = 0; ei < entries.length; ei++) {
            const et: Type* = this.arena.lookup(this.ctx.decl_index.entry_signature(entries[ei]));
            if (et == null || et.kind != TypeKind::Function) { continue; }
            const fn_ty: FunctionType* = et.as_function();
            if (fn_ty.param_types.length != arg_types.length) { continue; }
            mut first_shared: i64 = -1;
            mut rest_fit: boolean = true;
            for (mut pi: i64 = 0; pi < arg_types.length; pi++) {
                if (this.overload_param_matches_arg(fn_ty.param_types[pi], arg_types[pi])) { continue; }
                const pt: Type* = this.arena.lookup(fn_ty.param_types[pi]);
                const at: Type* = this.arena.lookup(arg_types[pi]);
                const shared_for_exclusive: boolean = pt != null && at != null
                    && pt.kind == TypeKind::Reference && at.kind == TypeKind::Reference
                    && pt.as_reference().is_mutable() && !at.as_reference().is_mutable()
                    && pt.as_reference().referent.equals(at.as_reference().referent);
                if (!shared_for_exclusive) { rest_fit = false; break; }
                if (first_shared < 0) { first_shared = pi; }
            }
            if (!rest_fit || first_shared < 0) { continue; }
            const member: string = this.intern.resolve(scope.member_name);
            const arg: ExpressionNode* = call.arguments[first_shared];
            // The borrowed binding's name, when the argument is `&name`.
            mut borrowed: string = "";
            if ((arg as ASTNode*).kind == NodeKind::UnaryExpression) {
                const operand: ExpressionNode* = (arg as UnaryExprNode*).operand;
                if (operand != null && (operand as ASTNode*).kind == NodeKind::Identifier) {
                    borrowed = this.intern.resolve((operand as IdentifierNode*).name);
                }
            }
            const what: string = if (first_shared == 0) { "its receiver" } else {
                fmt::format("argument %lld", first_shared + 1)
            };
            mut d: Diagnostic = Diagnostic::error(ErrorCode::E0214_ARGUMENT_MISMATCH,
                fmt::format("`%s` takes %s as an exclusive reference (`mut &`), and this is a shared one",
                    member, what));
            d = d.at_with_label(arg.span, "a shared reference; the parameter is `mut &`");
            if (borrowed.length() == 0) {
                d = d.help("pass the value itself: a call borrows it exclusively where the parameter is `mut &`");
            } else if (first_shared == 0) {
                const rest: string = if (call.arguments.length == 1) { "" } else { "..." };
                d = d.help(fmt::format("pass `%s` itself, which the call borrows exclusively, or call the method: `%s.%s(%s)`",
                    borrowed, borrowed, member, rest));
            } else {
                d = d.help(fmt::format("pass `%s` itself, which the call borrows exclusively", borrowed));
            }
            this.ctx.emit_diagnostic(d);
            return;
        }
    }

    /// Whether `owner` declares a member `leaf` a static path can call: a
    /// method of a type's family (the member-function door), or a method a
    /// trait declares (the trait-method door).
    owner_declares_member(&this, owner: TypeRef, leaf: SymbolStr) -> boolean {
        if (!owner.is_valid()) { return false; }
        const ot: Type* = this.arena.lookup(owner);
        if (ot != null && ot.kind == TypeKind::Trait) {
            return this.trait_slot_of(this.ctx.decl_index.def_of(owner, this.arena), leaf) >= 0;
        }
        return this.member_entries(FamilyOwner::Type(owner), leaf).length > 0;
    }

    /// The type of a static call through `owner`, which declares its member:
    /// the method is selected first (`pin_scope_callee_combined`), and the
    /// call has the return of the method selected.  A pinned call has its
    /// entry's return on EVERY walk of the body: the first walk's pin sets
    /// it, and a later walk finds the call already pinned - the
    /// implementation's return for a call through a trait's own path
    /// (`Dup::dup(&r)`), not the declaration's `This`, and each
    /// specialization's for a generic method's (`Q::id(&q, 2u64)` beside
    /// `Q::id(&q, 3)`).  An unpinned call the selection typed keeps that
    /// type: a generic method's template, whose return the selection read
    /// with the method's own parameters bound for this call
    /// (`pin_static_entry`).  Any other unpinned call has the return of the
    /// method `selected_static_return` reads, with the owner's written
    /// arguments substituted; none when nothing was selected, which the
    /// selection reported.
    type_static_call(mut &this, call: CallExprNode*, scope: ScopeResolutionNode*,
                     owner: TypeRef, owner_sym: SymbolStr) -> TypeRef {
        scope.set_resolved_type(TypeRef::invalid());
        this.pin_scope_callee_combined(call, scope, owner_sym, owner, scope.member_name);
        const pinned: OverloadId = call.resolved_callee.decl_entry();
        if (pinned.is_valid()) {
            this.type_from_delivered_entry(scope, pinned);
            return scope.resolved_type;
        }
        if (scope.resolved_type.is_valid()) { return scope.resolved_type; }
        const ret: TypeRef = this.types.canonicalize_method_return(
            this.selected_static_return(call, scope, owner));
        const resolved: TypeRef = this.try_resolve_generic_return(ret, scope.scope_name, scope.member_name, scope);
        scope.set_resolved_type(resolved);
        return resolved;
    }

    /// The return of the method an unpinned static call through `owner`
    /// selects, in the owner's parameters: through a trait's own path, the
    /// trait's declared method; on a generic owner, the method recorded
    /// where the call is written (`record_template_static`), read by its
    /// definition; through an impl-qualified path, the one method the
    /// head's implementation delivers, whose arguments the argument check
    /// reports when they do not fit; else the owner's only method of the
    /// name.  Invalid when none was selected: several methods the arguments
    /// did not choose between, which the selection reported.
    selected_static_return(&this, call: CallExprNode*, scope: ScopeResolutionNode*, owner: TypeRef) -> TypeRef {
        const di: DeclarationIndex* = this.ctx.decl_index;
        const leaf: SymbolStr = scope.member_name;
        const ot: Type* = this.arena.lookup(owner);
        if (ot != null && ot.kind == TypeKind::Trait) {
            const trait_def: DefId = di.def_of(owner, this.arena);
            return this.ctx.generic_registry.trait_item_return(trait_def, this.trait_slot_of(trait_def, leaf));
        }
        const d: DefId = call.template_method;
        if (d.is_valid()) {
            mut base: TypeRef = this.arena.inst_generic_base(owner);
            if (!base.is_valid()) { base = owner; }
            const e: OverloadId = di.method_entry_on(base, d);
            if (e.is_valid()) { return di.entry_owner_return(e); }
            const pos: i64 = this.ctx.generic_registry.trait_item_position(d);
            if (pos >= 0) { return this.ctx.generic_registry.trait_item_return(this.ctx.defs.parent_of(d), pos); }
            return TypeRef::invalid();
        }
        if (scope.impl_trait != null) {
            const head: DefId = this.impl_head_trait(scope);
            if (!head.is_valid()) { return TypeRef::invalid(); }
            const delivered: [OverloadId] = this.trait_delivered_entries(FamilyOwner::Type(owner), head, leaf);
            if (delivered.length == 1) { return di.entry_owner_return(delivered[0]); }
            return TypeRef::invalid();
        }
        const entries: [OverloadId] = this.member_entries(FamilyOwner::Type(owner), leaf);
        if (entries.length == 1) { return di.entry_owner_return(entries[0]); }
        return TypeRef::invalid();
    }

    type_from_delivered_entry(mut &this, scope: ScopeResolutionNode*, entry: OverloadId) -> void {
        const ft: Type* = this.arena.lookup(this.ctx.decl_index.entry_signature(entry));
        if (ft != null && ft.kind == TypeKind::Function) {
            scope.set_resolved_type(ft.as_function().return_type);
        }
    }

    /// The trait an impl-qualified path's head names, by identity, when the
    /// name resolves to a trait; empty otherwise, with the refusal reported
    /// here: a head naming no trait selects no implementation, and the path
    /// would otherwise fall to the bare `Type::member` reading and answer
    /// for a trait the writer did not name.
    impl_qualified_trait(mut &this, scope: ScopeResolutionNode*) -> DefId {
        if (TypeAnnotation::refused(scope.impl_trait)) { return DefId::invalid(); }
        const trait_def: DefId = this.impl_head_trait(scope);
        if (trait_def.is_valid()) { return trait_def; }
        if (this.state.in_symbolic_check) { return DefId::invalid(); }
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0233_UNDEFINED_SYMBOL,
            fmt::format("`%s` is not a trait", TypeAnnotation::spell(scope.impl_trait, this.intern)));
        d = d.at_with_label(scope.scope_span,
            "`(Trait for Type)::member` names the member of the trait's implementation for the type");
        this.ctx.emit_diagnostic(d);
        return DefId::invalid();
    }

    /// The trait an impl-qualified path's head names, by identity; invalid
    /// when the head is refused or names no trait.  Reports nothing:
    /// `impl_qualified_trait` refuses a head naming no trait.
    impl_head_trait(&this, scope: ScopeResolutionNode*) -> DefId {
        if (TypeAnnotation::refused(scope.impl_trait)) { return DefId::invalid(); }
        const trait_def: DefId = TypeAnnotation::trait_def(scope.impl_trait);
        if (!trait_def.is_valid()) { return DefId::invalid(); }
        const tt: Type* = this.arena.lookup(this.ctx.decl_index.type_of_def(trait_def));
        if (tt == null || tt.kind != TypeKind::Trait) { return DefId::invalid(); }
        return trait_def;
    }

    /// A call written through an impl-qualified path, `(Beta for P)::make()`
    /// or `(Beta for P)::go(&p)`: the member is the one `Beta`'s
    /// implementation for `P` delivers, whether or not other traits provide
    /// it - the spelling a tie of static methods needs, since no receiver
    /// selects there, and the same rule for a method with one.  `owner_sym`
    /// is the owner that won resolution for the scope segment: the written
    /// type, or the type a generic body's parameter was instantiated with.
    /// A head whose trait the type does not implement, or whose
    /// implementation has no such member, is refused here rather than left
    /// unpinned, because an unpinned static call is bound by name and arity
    /// later - which is the pick by registration order the head exists to
    /// rule out.  Arguments no delivered entry accepts are reported as any
    /// static call's are, from the pin's absence.
    pin_impl_qualified_call(mut &this, call: CallExprNode*, scope: ScopeResolutionNode*,
                            owner_sym: SymbolStr, owner: TypeRef, member_sym: SymbolStr) -> void {
        const trait_sym: DefId = this.impl_qualified_trait(scope);
        if (!trait_sym.is_valid()) { return; }
        const entries: [OverloadId] = this.trait_delivered_entries(FamilyOwner::Type(owner), trait_sym, member_sym);
        if (entries.length > 0) {
            this.pin_trait_delivered_call(call, scope, &entries);
            return;
        }
        this.report_impl_qualified_miss(scope, owner_sym, owner, trait_sym, member_sym);
    }

    /// `(Trait for Type)::member` where `Trait`'s implementation for `Type`
    /// delivers no `member`: `Type` does not implement the trait, or the
    /// implementation has no method of that name.  Silent during a symbolic
    /// generic-body walk: the concrete instantiation reports.
    report_impl_qualified_miss(mut &this, scope: ScopeResolutionNode*, owner_sym: SymbolStr,
                               owner: TypeRef, trait_sym: DefId, member_sym: SymbolStr) -> void {
        if (this.state.in_symbolic_check) { return; }
        const owner_str: string = this.intern.resolve(owner_sym);
        const trait_leaf: string = QualifiedName::leaf_of(this.intern.shown(this.ctx.defs.path_of(trait_sym)));
        const owner_ref: TypeRef = owner;
        if (owner_ref.is_valid()
                && !this.trait_checker().type_implements_trait(owner_ref, trait_sym, 0)) {
            mut d: Diagnostic = Diagnostic::error(ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
                fmt::format("`%s` does not implement `%s`",
                    this.arena.resolve_display_name_short(owner_ref), trait_leaf));
            d = d.at_with_label(scope.scope_span,
                fmt::format("no `implement trait %s for %s` selects an implementation here",
                    trait_leaf, this.arena.resolve_display_name_short(owner_ref)));
            this.ctx.emit_diagnostic(d);
            return;
        }
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0233_UNDEFINED_SYMBOL,
            fmt::format("`%s`'s implementation for `%s` has no method `%s`",
                trait_leaf, QualifiedName::leaf_of(owner_str), this.intern.resolve(member_sym)));
        d = d.at_with_label(scope.member_span, "not a method of this implementation");
        this.ctx.emit_diagnostic(d);
    }

    /// Pin the static method a `Type::method` VALUE names, by the symbol
    /// codegen's registry is keyed by - the same one the CALL form of this path
    /// pins (`pin_scope_callee_combined`), so a method taken as a value and the
    /// same method called cannot address two symbols.
    ///
    /// The entry is the one whose function type sema already selected, not
    /// the first registered under the name: `MethodInfo::function_type` and the
    /// index's entry are interned through the same `get_function`, so the id
    /// identifies it.  The owner key is the type's REGISTERED name, read off
    /// the type sema resolved rather than off the spelling, which may be any
    /// path that reaches it.  A method with no entry yet pins the combined
    /// name, as the call form does; several trait methods of the selected
    /// signature under one name with no inherent one to prefer is the tie
    /// `choose_entry` reports.
    ///
    /// A method with a receiver is a value too (`IgTn::go`), asked with its
    /// receiver-first signature, the form its entry is registered under.
    ///
    /// Answers the value's type: `method_ft` - or, for an impl-qualified
    /// path `(Beta for P)::make`, the signature of the entry `Beta`'s
    /// implementation delivers, which `method_ft` (the first method of the
    /// name the type holds) need not be.  A head that delivers nothing is
    /// refused as the call form's is and answers no type.
    pin_scope_value_static_method(mut &this, scope: ScopeResolutionNode*, owner: TypeRef,
                                  method_ft: TypeRef) -> TypeRef {
        if (scope.resolved_callee.is_some()) { return method_ft; }
        if (this.ctx.decl_index == null) { return method_ft; }
        const owner_sym: SymbolStr = this.ctx.decl_index.lookup_type_name(owner);
        if (!owner_sym.is_valid()) { return method_ft; }
        if (scope.impl_trait != null) {
            const trait_sym: DefId = this.impl_qualified_trait(scope);
            if (!trait_sym.is_valid()) { return TypeRef::invalid(); }
            const entries: [OverloadId] = this.trait_delivered_entries(FamilyOwner::Type(owner), trait_sym, scope.member_name);
            if (entries.length == 0) {
                this.report_impl_qualified_miss(scope, owner_sym, owner, trait_sym, scope.member_name);
                return TypeRef::invalid();
            }
            // Several delivered entries are one implementation's overloads
            // of the name; the one of the signature sema selected, else the
            // first, as a bare path's value takes the first of the name.
            mut chosen: OverloadId = entries[0];
            for (mut i: i64 = 0; i < entries.length; i++) {
                if (this.ctx.decl_index.entry_signature(entries[i]).equals(method_ft)) { chosen = entries[i]; }
            }
            scope.set_resolved_callee(CalleePin::Decl(chosen));
            return this.ctx.decl_index.entry_signature(chosen);
        }
        // A bound-directed value, `T::make` under `where T: Beta`: that
        // trait's entry of the selected signature, when it delivers one.
        if (scope.resolved_trait.is_valid()) {
            const directed: [OverloadId] = this.trait_delivered_entries(FamilyOwner::Type(owner), scope.resolved_trait, scope.member_name);
            for (mut i: i64 = 0; i < directed.length; i++) {
                if (this.ctx.decl_index.entry_signature(directed[i]).equals(method_ft)) {
                    scope.set_resolved_callee(CalleePin::Decl(directed[i]));
                    return method_ft;
                }
            }
        }
        const family: [OverloadId] = this.ctx.decl_index.lookup_family_entries(FamilyOwner::Type(owner), scope.member_name);
        mut refused: boolean = false;
        const picked: TypeRef = this.value_overload_signature(&family,
            fmt::format("%s::%s", this.intern.resolve(scope.scope_name), this.intern.resolve(scope.member_name)),
            scope.span, scope as ExpressionNode*, &refused);
        if (refused) { return TypeRef::invalid(); }
        const value_ft: TypeRef = if (picked.is_valid()) { picked } else { method_ft };
        const chosen: OverloadId = this.entry_of_signature(&family, FamilyOwner::Type(owner), value_ft, scope);
        const entry: OverloadId = if (chosen.is_valid()) { chosen } else { this.sole_entry(&family) };
        if (entry.is_valid()) { scope.set_resolved_callee(CalleePin::Decl(entry)); }
        return value_ft;
    }

    /// The entry of `owner`'s family `entries` with signature `ft` the
    /// `Type::method` path `path` names; invalid when there is none, or
    /// several the path cannot choose between (`choose_entry`).
    entry_of_signature(mut &this, entries: &[OverloadId], owner: FamilyOwner, ft: TypeRef,
                       path: ScopeResolutionNode*) -> OverloadId {
        mut fits: [OverloadId] = [];
        for (mut i: i64 = 0; i < entries.length; i++) {
            if (this.ctx.decl_index.entry_signature(entries[i]).equals(ft)) { fits.push(entries[i]); }
        }
        return this.choose_entry(&fits, path, null, owner);
    }

    /// The one entry of `fits` the `Type::method` path `path` names.  One
    /// fit is it.  Several fit when methods share the key and the arguments
    /// bind to each, and no candidate outranks another: an inherent method
    /// beside one or more traits' is a tie as two traits' are, reported here
    /// where every candidate is in hand.  The caller names a trait's method
    /// through the impl-qualified path, `(Trait for Owner)::member(args)`,
    /// or renames one.  An inherent method in a tie stays bound, so the tie
    /// is the one error the call reports; a tie of traits alone binds
    /// nothing.
    choose_entry(mut &this, fits: &[OverloadId], path: ScopeResolutionNode*, call: CallExprNode*,
                 owner: FamilyOwner) -> OverloadId {
        if (fits.length == 1) { return fits[0]; }
        mut inherent: OverloadId = OverloadId::invalid();
        mut n: i64 = 0;
        for (mut i: i64 = 0; i < fits.length; i++) {
            if (!this.ctx.decl_index.entry_trait(fits[i]).is_valid()) { inherent = fits[i]; n = n + 1; }
        }
        if (n == 1) {
            this.report_static_path_tie(fits, path, call, inherent, owner);
            return inherent;
        }
        if (n == 0 && fits.length >= 2) { this.report_static_path_tie(fits, path, call, OverloadId::invalid(), owner); }
        if (n >= 2) { return this.report_static_generic_tie(fits, path, call, owner); }
        return OverloadId::invalid();
    }

    /// Several inherent entries of `fits` accept the arguments, so the
    /// `Type::method` call is ambiguous (E0154): a non-generic method does
    /// not outrank a generic one for being non-generic, and no generic
    /// method outranks another.  The non-generic entry, when there is one,
    /// is answered so the tie is the one error the call reports; invalid
    /// otherwise.
    report_static_generic_tie(mut &this, fits: &[OverloadId], path: ScopeResolutionNode*,
                              call: CallExprNode*, owner: FamilyOwner) -> OverloadId {
        mut plain: OverloadId = OverloadId::invalid();
        mut generics: [OverloadId] = [];
        for (mut i: i64 = 0; i < fits.length; i++) {
            if (this.ctx.decl_index.entry_trait(fits[i]).is_valid()) { continue; }
            const m_decl: DeclarationNode* = this.ctx.decl_index.entry_method(fits[i]);
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m == null || m.func == null) { continue; }
            if (DeclarationNode::fn_of(m.func).generic_params.length > 0) { generics.push(fits[i]); } else { plain = fits[i]; }
        }
        if (generics.length == 0 || (!plain.is_valid() && generics.length < 2)) { return OverloadId::invalid(); }
        const leaf: string = if (path != null) { this.intern.resolve(path.member_name) } else { "" };
        const owner_t: TypeRef = match (owner) {
            FamilyOwner::Type(t) => { t }
            FamilyOwner::Def(d)  => { this.ctx.decl_index.type_of_def(d) }
            FamilyOwner::Template(_) => { TypeRef::invalid() }
        };
        const owner_str: string = this.arena.resolve_display_name_short(owner_t);
        const at: SourceSpan = if (path != null) { path.span } else { call.span };
        const primary: string = if (plain.is_valid()) {
            fmt::format("`%s` is ambiguous: a non-generic and a generic method of `%s` both accept these arguments",
                leaf, owner_str)
        } else {
            fmt::format("`%s` is ambiguous: more than one generic method of `%s` accepts these arguments",
                leaf, owner_str)
        };
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0154_AMBIGUOUS_CALL, primary);
        d = d.at_with_label(at, if (plain.is_valid()) { "both methods apply here" } else { "these methods all apply here" });
        mut n: i32 = 1;
        if (plain.is_valid()) {
            d = d.with_note_at(fmt::format("candidate #1: `%s`, not generic", leaf),
                this.ctx.decl_index.entry_span(plain));
            n = 2;
        }
        for (mut i: i64 = 0; i < generics.length; i++) {
            d = d.with_note_at(fmt::format("candidate #%d: `%s`, generic", n, leaf),
                this.ctx.decl_index.entry_span(generics[i]));
            n = n + 1;
        }
        d = d.help(if (plain.is_valid()) { "a method is not preferred for being non-generic; rename one of them" }
                   else { "rename one of them, or write the type arguments that leave one applying" });
        this.ctx.emit_diagnostic(d);
        return plain;
    }

    /// `path` names a method every trait entry of `fits` provides through a
    /// different trait - and `inherent`, when valid, an inherent method too
    /// - and none of them outranks another.  The candidates are the
    /// entries, each carrying where its declaration is written; the call
    /// form's arguments are the receiver the trait-qualified call keeps.
    report_static_path_tie(mut &this, fits: &[OverloadId], path: ScopeResolutionNode*,
                           call: CallExprNode*, inherent: OverloadId, owner: FamilyOwner) -> void {
        mut traits: [DefId] = [];
        mut spans: [SourceSpan] = [];
        for (mut i: i64 = 0; i < fits.length; i++) {
            if (fits[i].equals(inherent)) { continue; }
            traits.push(this.ctx.decl_index.entry_trait(fits[i]));
            spans.push(this.ctx.decl_index.entry_span(fits[i]));
        }
        const inh_decl: DeclarationNode* = this.ctx.decl_index.entry_method(inherent);
        const inh: MethodDecl* = DeclarationNode::method_of(inh_decl);
        const inh_func_decl: DeclarationNode* = if (inh != null) { inh.func } else { null };
        mut args_text: string = "";
        if (call != null && call.arguments.length > 0) {
            const first: ExpressionNode* = call.arguments[0];
            const last: ExpressionNode* = call.arguments[call.arguments.length - 1];
            args_text = this.source_text(SourceSpan::new(first.span.file,
                first.span.start_line, first.span.start_col, last.span.end_line, last.span.end_col));
        }
        // The owner whose family the candidates are - `GIgTn<i32>` for
        // `GIgTn::<i32>::go` - which a trait's method is provided for.
        const owner_t: TypeRef = match (owner) {
            FamilyOwner::Type(t) => { t }
            FamilyOwner::Def(_)  => { TypeRef::invalid() }
            FamilyOwner::Template(_) => { TypeRef::invalid() }
        };
        this.report_trait_method_tie(path.span, path.member_name, owner_t,
            &traits, &spans, args_text, call != null, inh_func_decl);
    }

    /// The source text under a single-line `span`, or "" when it spans lines
    /// or the file is not readable: a suggestion quotes the program's own
    /// spelling of a receiver, never a rendering of it.
    source_text(&this, span: SourceSpan) -> string {
        if (this.ctx.diag_renderer == null || !span.has_location()) { return ""; }
        if (span.start_line != span.end_line || span.end_col <= span.start_col) { return ""; }
        if (!this.ctx.diag_renderer.load_source(span.file)) { return ""; }
        const line: string = this.ctx.diag_renderer.get_line(span.file, span.start_line);
        if ((line.length() as u32) < span.end_col - 1) { return ""; }
        return line.substring(span.start_col - 1, span.end_col - span.start_col);
    }

    /// E0156: `member` is provided for `owner` by every trait in `traits`, at
    /// the signature the use selects - and, when `inherent` is not null, by
    /// that inherent method too, which outranks none of them.  A tie is an
    /// error, never a pick by declaration or import order.  Each candidate
    /// is named where it is declared (`decl_spans`), and the help names the
    /// spelling that chooses a trait's: the impl-qualified path
    /// `(Trait for Owner)::member(args)`, one rule for a method with a
    /// receiver (the receiver its first argument, as `args_text` carries
    /// it), a static method, and a method taken as a value.  A tie of
    /// traits alone on an owner that holds a type parameter is silent during
    /// a symbolic generic-body walk: which impls apply depends on the
    /// argument, and the concrete instantiation reports.  On a concrete
    /// owner the tie is the same in every instantiation and is reported here.
    report_trait_method_tie(mut &this, span: SourceSpan, member: SymbolStr, owner: TypeRef,
                            traits: &[DefId], decl_spans: &[SourceSpan],
                            args_text: string, is_call: boolean, inherent_decl: DeclarationNode*) -> void {
        const inherent: FunctionDecl* = DeclarationNode::fn_of(inherent_decl);
        if (this.state.in_symbolic_check && inherent == null
                && this.types.contains_generic_param(owner)) { return; }
        if (!owner.is_valid()) { return; }
        // The owner as the impl-qualified form writes it: `GnTf<i32>`.
        const owner_display: string = this.arena.resolve_display_name_short(owner);
        const member_str: string = this.intern.resolve(member);
        const primary: string = if (inherent != null) {
            fmt::format("`%s` is both an inherent method of `%s` and provided by a trait implemented for it",
                member_str, owner_display)
        } else {
            fmt::format("`%s` is provided by more than one trait implemented for `%s`", member_str, owner_display)
        };
        mut diag: Diagnostic = Diagnostic::error(ErrorCode::E0156_AMBIGUOUS_TRAIT_METHOD, primary);
        diag = diag.at_with_label(span,
            fmt::format("which `%s` is meant here is ambiguous", member_str));
        // The inherent candidate is named first; the traits' number after it.
        mut first_trait: i32 = 1;
        if (inherent != null) {
            const inh_note: string = fmt::format("candidate #1: the inherent method `%s::%s`", owner_display, member_str);
            const inh_span: SourceSpan = if (inherent_decl.has_name_span()) { inherent_decl.name_span } else { inherent_decl.span };
            diag = if (inh_span.has_location()) { diag.with_note_at(inh_note, inh_span) } else { diag.with_note(inh_note) };
            first_trait = 2;
        }
        // Two candidates of one leaf (`Alpha::Render`, `Omega::Render`) are
        // told apart only by their full paths; otherwise the leaf reads as
        // the program writes it.
        mut leaf_collides: boolean = false;
        for (mut a: i64 = 0; a < traits.length; a++) {
            for (mut b: i64 = a + 1; b < traits.length; b++) {
                if (this.leaves_print_alike(traits[a], traits[b])) { leaf_collides = true; }
            }
        }
        mut help: string = "";
        for (mut i: i64 = 0; i < traits.length; i++) {
            const trait_str: string = this.intern.shown(this.ctx.defs.path_of(traits[i]));
            const leaf: string = if (leaf_collides) { trait_str } else { QualifiedName::leaf_of(trait_str) };
            const note: string = fmt::format("candidate #%d: `%s::%s`, from `implement trait %s for %s`",
                (i as i32) + first_trait, leaf, member_str, trait_str, owner_display);
            diag = if (decl_spans[i].has_location()) { diag.with_note_at(note, decl_spans[i]) } else { diag.with_note(note) };
            const form: string = if (is_call) { fmt::format("`(%s for %s)::%s(%s)`", leaf, owner_display, member_str, args_text) }
                                 else { fmt::format("`(%s for %s)::%s`", leaf, owner_display, member_str) };
            help = if (help.length() == 0) { form } else { help + " or " + form };
        }
        const help_line: string = if (inherent != null) {
            fmt::format("neither outranks the other: call the trait's method as %s, or rename one of them", help)
        } else { fmt::format("name the implementation the call is meant through: %s", help) };
        diag = diag.help(help_line);
        this.ctx.emit_diagnostic(diag);
    }

    /// Pin a static call to the one entry of the family `(owner, leaf)` its
    /// arguments select, or decline.  Exact matches first; only when no
    /// signature matches exactly, the auto-ref the call site performs is
    /// admitted - a value argument for a `&T` parameter, which is how a
    /// trait default's `&this` receiver reaches `T::try_from(this)`.  Two
    /// passes rather than one predicate so a family carrying both `f(T)` and
    /// `f(&T)` selects the exact one whatever order they registered in.
    /// Several fits in one pass go to `choose_entry`.
    try_pin_static_method_overload(mut &this, call: CallExprNode*, scope: ScopeResolutionNode*,
                                   owner: FamilyOwner, leaf: SymbolStr) -> boolean {
        const di: DeclarationIndex* = this.ctx.decl_index;
        const entries: [OverloadId] = di.lookup_family_entries(owner, leaf);
        if (entries.length < 2) { return false; }
        mut arg_types: [TypeRef] = [];
        for (mut ai: i64 = 0; ai < call.arguments.length; ai++) {
            const arg: ExpressionNode* = call.arguments[ai];
            if (arg == null || !arg.resolved_type.is_valid()) { return false; }
            arg_types.push(arg.resolved_type);
        }
        mut fits: [OverloadId] = this.select_static_overload(&entries, &arg_types, false, call, scope);
        if (fits.length == 0) { fits = this.select_static_overload(&entries, &arg_types, true, call, scope); }
        if (fits.length == 0) {
            this.refuse_unmatched_static_call(call, &entries, &arg_types, leaf);
            return false;
        }
        const chosen: OverloadId = this.choose_entry(&fits, scope, call, owner);
        if (!chosen.is_valid()) { return false; }
        this.pin_static_entry(call, scope, chosen);
        return true;
    }

    /// E0214 for a static call no entry of the family `entries` accepts
    /// (`refuse_unmatched_family_call`).  A family with one entry of the
    /// call's arity that is not generic is left to the argument check, which
    /// compares the arguments with that one signature; a generic one's
    /// parameters are its own type parameters there, which that check
    /// cannot judge.
    refuse_unmatched_static_call(mut &this, call: CallExprNode*, entries: &[OverloadId],
                                 arg_types: &[TypeRef], leaf: SymbolStr) -> void {
        mut overloads: [TypeRef] = [];
        mut same_arity: i64 = 0;
        mut generic: boolean = false;
        for (mut i: i64 = 0; i < entries.length; i++) {
            const sig: TypeRef = this.ctx.decl_index.entry_signature(entries[i]);
            overloads.push(sig);
            const ft: Type* = this.arena.lookup(sig);
            if (ft == null || ft.kind != TypeKind::Function) { continue; }
            if (ft.as_function().param_types.length != arg_types.length) { continue; }
            same_arity = same_arity + 1;
            if (this.static_entry_template(entries[i]) != null) { generic = true; }
        }
        if (same_arity == 1 && !generic) { return; }
        this.refuse_unmatched_family_call(call, this.intern.resolve(leaf), &overloads, arg_types);
    }

    /// Every entry of `entries` whose parameters (`static_entry_params`)
    /// every argument fits, a generic static method among them when its own
    /// type parameters bind to the arguments (`template_fits`).
    /// `autoref` admits a value argument for a reference parameter to its
    /// type.
    select_static_overload(mut &this, entries: &[OverloadId], arg_types: &[TypeRef],
                           autoref: boolean, call: CallExprNode*,
                           scope: ScopeResolutionNode*) -> [OverloadId] {
        mut fits: [OverloadId] = [];
        for (mut oi: i64 = 0; oi < entries.length; oi++) {
            const tmpl: TemplateEntry* = this.static_entry_template(entries[oi]);
            if (tmpl != null) {
                if (this.template_fits(tmpl, call, scope, arg_types)) { fits.push(entries[oi]); }
                continue;
            }
            const params: [TypeRef] = this.static_entry_params(entries[oi], call, scope);
            if (params.length == 0 && arg_types.length > 0) { continue; }
            if (params.length != arg_types.length) { continue; }
            mut all_match: boolean = true;
            for (mut pi: i64 = 0; pi < params.length; pi++) {
                mut ok: boolean = this.overload_param_matches_arg(params[pi], arg_types[pi]);
                if (!ok && autoref) {
                    const pt: Type* = this.arena.lookup(params[pi]);
                    ok = pt != null && pt.kind == TypeKind::Reference
                        && pt.as_reference().referent.equals(arg_types[pi]);
                }
                if (!ok) { all_match = false; break; }
            }
            if (all_match) { fits.push(entries[oi]); }
        }
        return fits;
    }

    /// Whether the generic function `t` - a static method called through
    /// `scope`, or a free function, whose `scope` is null - accepts `call`'s
    /// arguments: its own type parameters bind from the call
    /// (`template_call_bindings`), and every argument fits the parameter
    /// they make - an untyped numeric literal any numeric parameter, which
    /// it adopts as it does in a call to the function alone.
    template_fits(mut &this, t: TemplateEntry*, call: CallExprNode*,
                  scope: ScopeResolutionNode*, arg_types: &[TypeRef]) -> boolean {
        if (call == null) { return false; }
        const f_decl: DeclarationNode* = DeclarationNode::with_shape(t.ast_node);
        const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
        if (f == null || f.parameters.length != arg_types.length) { return false; }
        const binds: [TypeRef] = this.template_call_bindings(call, scope, t, f_decl);
        if (binds.length != t.param_types.length) { return false; }
        for (mut i: i64 = 0; i < f.parameters.length; i++) {
            const p_decl: DeclarationNode* = f.parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p == null || !p.resolved_type.is_valid()) { return false; }
            const param: TypeRef = this.subst_params(&t.param_types, &binds, p.resolved_type);
            if (!param.is_valid()) { return false; }
            if (this.overload_param_matches_arg(param, arg_types[i])) { continue; }
            if (this.sema_arg_is_polymorphic_literal(call.arguments[i]) && this.literal_adopts_binding(param)) { continue; }
            return false;
        }
        return true;
    }

    /// The parameters a path call `Owner::m(args)` passes to entry `e`: its
    /// signature's.  A generic method's template takes its signature with
    /// the method's own type parameters bound for this call
    /// (`path_method_bindings`) - the receiver, the first argument, as
    /// written - and none when they do not bind.  A method-level
    /// specialization takes none: it is an instance minted from a template,
    /// not a declaration a path names.  A generic static method is its own
    /// function template, which `template_fits` judges.
    static_entry_params(mut &this, e: OverloadId, call: CallExprNode*,
                        scope: ScopeResolutionNode*) -> [TypeRef] {
        mut params: [TypeRef] = [];
        const ot: Type* = this.arena.lookup(this.ctx.decl_index.entry_signature(e));
        if (ot == null || ot.kind != TypeKind::Function) { return params; }
        const fn_ty: FunctionType* = ot.as_function();
        const m_decl: DeclarationNode* = this.ctx.decl_index.entry_method(e);
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m != null && m.func != null && DeclarationNode::fn_of(m.func).spec_type_args.length > 0) { return params; }
        if (m == null || m.func == null || DeclarationNode::fn_of(m.func).generic_params.length == 0) {
            for (mut pi: i64 = 0; pi < fn_ty.param_types.length; pi++) { params.push(fn_ty.param_types[pi]); }
            return params;
        }
        if (m.is_static || call == null || fn_ty.param_types.length == 0) { return params; }
        mut binds: [TypeRef] = [];
        mut ctx: ResolutionContext = this.path_method_context(m_decl, fn_ty.param_types[0], call, scope, &binds);
        if (binds.length == 0) { return params; }
        params.push(fn_ty.param_types[0]);
        for (mut pi: i64 = 0; pi < DeclarationNode::fn_of(m.func).parameters.length; pi++) {
            const p_decl: DeclarationNode* = DeclarationNode::fn_of(m.func).parameters[pi];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p == null || p.is_receiver()) { continue; }
            if (p.type_annotation == null) { return []; }
            const f: TypeRef = this.binding.reduce_assoc_projections(this.ctx.type_resolver.resolve(p.type_annotation, &ctx));
            // In a template body's symbolic walk the arguments are typed in
            // the enclosing parameters (`w: W`), so a parameter bound to one
            // stays abstract for the substituter, as a turbofish's does.
            if (!f.is_valid() || (this.types.contains_generic_param(f) && !this.state.in_symbolic_check)) { return []; }
            params.push(f);
        }
        return params;
    }

    /// The context generic method `m`'s signature is read in for the path
    /// call `call`: the owner its receiver parameter `recv_param` names, and
    /// the method's own type parameters bound from the call's turbofish,
    /// else from the arguments after the receiver, as `recv.m(args)` binds
    /// them.  The bindings, in declaration order, go to `out_binds`, left
    /// empty when any stays unbound.
    path_method_context(mut &this, m_decl: DeclarationNode*, recv_param: TypeRef, call: CallExprNode*,
                        scope: ScopeResolutionNode*, out_binds: [TypeRef]*) -> ResolutionContext {
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        mut ctx: ResolutionContext = ResolutionContext::new("");
        mut owner: TypeRef = recv_param;
        const rt: Type* = this.arena.lookup(recv_param);
        if (rt != null && rt.kind == TypeKind::Reference) { owner = rt.as_reference().referent; }
        if (rt != null && rt.kind == TypeKind::Pointer) { owner = rt.as_pointer().pointee; }
        ctx.set_this_type(owner);
        mut targs: &[TypeAnnotation*] = &call.generic_args;
        if (targs.length == 0 && scope != null) { targs = &scope.generic_args; }
        const binds: [TypeRef] = this.binding.solve_method_bindings_at(m.func, &ctx, targs, call, 1);
        if (binds.length != DeclarationNode::fn_of(m.func).generic_params.length) { return ctx; }
        for (mut i: i64 = 0; i < binds.length; i++) {
            const gp_decl: DeclarationNode* = DeclarationNode::fn_of(m.func).generic_params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            if (gp == null) { return ctx; }
            ctx.add_binding(gp.sym_id, gp.name, binds[i]);
        }
        for (mut i: i64 = 0; i < binds.length; i++) { (*out_binds).push(binds[i]); }
        return ctx;
    }

    /// Bind the path call `call` to entry `e`.  A generic method's template
    /// is not a definition the call can run: the call records its definition
    /// (`template_method`) and its own type parameters, bound here - stashed
    /// for monomorphization, which mints the specialization and pins it as it
    /// does for `recv.m(args)` - and the path is typed through them.  Any
    /// other entry is pinned.
    pin_static_entry(mut &this, call: CallExprNode*, scope: ScopeResolutionNode*, e: OverloadId) -> void {
        const m_decl: DeclarationNode* = this.ctx.decl_index.entry_method(e);
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m == null || m.func == null || DeclarationNode::fn_of(m.func).generic_params.length == 0 || m.is_static) {
            call.set_resolved_callee(CalleePin::Decl(e));
            return;
        }
        const ot: Type* = this.arena.lookup(this.ctx.decl_index.entry_signature(e));
        if (ot == null || ot.kind != TypeKind::Function) { return; }
        const fn_ty: FunctionType* = ot.as_function();
        if (fn_ty.param_types.length == 0) { return; }
        mut binds: [TypeRef] = [];
        mut ctx: ResolutionContext = this.path_method_context(m_decl, fn_ty.param_types[0], call, scope, &binds);
        if (binds.length == 0) { return; }
        call.set_resolved_type_args(binds);
        if (!call.template_method.is_valid()) {
            call.template_method = if (DeclarationNode::fn_of(m.func).def.is_valid()) { DeclarationNode::fn_of(m.func).def } else { DeclarationNode::fn_of(m.func).copy_of };
        }
        if (DeclarationNode::fn_of(m.func).return_type_annotation != null) {
            const ret: TypeRef = this.binding.reduce_assoc_projections(
                this.ctx.type_resolver.resolve(DeclarationNode::fn_of(m.func).return_type_annotation, &ctx));
            if (ret.is_valid() && !this.types.contains_generic_param(ret)) { scope.set_resolved_type(ret); }
        }
    }

    /// Pin a module-qualified call to the entry the family of the function
    /// `callee` the name layer bound is emitted as, unless something
    /// already pinned it.
    pin_scope_callee_def(mut &this, call: CallExprNode*, callee: DefId) -> void {
        if (call == null) { return; }
        if (call.resolved_callee.is_some()) { return; }
        if (!callee.is_valid()) { return; }
        const family: [OverloadId] = this.family_entries(callee);
        const sole: OverloadId = this.sole_entry(&family);
        if (sole.is_valid()) { call.set_resolved_callee(CalleePin::Decl(sole)); }
    }

    /// GATED (R1): try Scope::Member as a static method (specialized -> base -> DI
    /// -> template).  The template path carries pre-mono re-derivation.
    /// Sets `claimed` when the owner declares the member, whether or not a
    /// method was selected: a call the selection refused was reported there,
    /// and no other reading of the path applies to it.
    try_resolve_static_method(mut &this, scope: ScopeResolutionNode*, lookup_sym: SymbolStr,
                              owner_ty: TypeRef, call: CallExprNode*, claimed: boolean*) -> TypeRef {
        // A GENERIC method on a GENERIC owner called through a path
        // (`Wrap<A>::make<T>`, `String<A>::from<T>`, `Wrap<A>::keep<T>(&w, t)`)
        // is the path analogue of the instance
        // generic-method path: sema infers the method's OWN `<T>` + stashes it,
        // resolves the return, and leaves the callee UNPINNED for mono to specialize
        // (specialize_static_method_on_generic_owner).  Handled before the
        // owner-only stash / DI-return branches below, which bail on generic methods.
        const gsm_ret: TypeRef = this.try_resolve_generic_static_method(scope, call);
        if (gsm_ret.is_valid()) { return gsm_ret; }
        // A GENERIC static method on a NON-generic owner (`Bo::drive<F, R>`) is
        // registered as its OWN function template keyed `Owner::method`
        // (register_static_method_templates), so it resolves like a free function:
        // infer the method's `<F, R>`, stash them, and substitute into the return.
        // The owner has no params to instantiate; mono specializes the method
        // template exactly as a free-function call.  Handled before the owner's
        // method path below, which would type the call with the still-abstract
        // method return type (`R`) and trip E0200.
        const smt_ret: TypeRef = this.try_resolve_static_method_template(scope, call);
        if (smt_ret.is_valid()) { return smt_ret; }
        // Stash the owner's concrete type args for mono BEFORE the return-type
        // resolution below.  The stash must be produced on EVERY path: a call
        // typed from the method it selects (`type_static_call`) never calls
        // `resolve_static_method_return_via_template`, which is otherwise the
        // ONLY stash site - so a call like
        // `const r: Result<Array<u64,GlobalAlloc>, E> = Array::try_with_capacity_in(..)`
        // would reach mono with an empty stash and fail to specialize the owner
        // (E0636).  Run it here, while `expected_type` is still live, so the
        // expected-type-unify source can recover an owner param the args don't
        // determine.  Idempotent (no-op once `resolved_type_args` is set).
        this.stash_static_owner_bindings_for(scope, call);
        // `owner_ty` is the type the segment denotes - the owner the method
        // was registered on - and `lookup_sym` its registered name, which
        // the pin carries.
        const owner_ref: TypeRef = owner_ty;
        const owner_sym: SymbolStr = lookup_sym;
        if (this.owner_declares_member(owner_ref, scope.member_name)) {
            *claimed = true;
            mut resolved: TypeRef = this.type_static_call(call, scope, owner_ref, owner_sym);
            if (!call.resolved_callee.decl_entry().is_valid() && this.types.contains_generic_param(resolved)) {
                const inferred: TypeRef = this.resolve_static_method_return_via_template(scope, call);
                if (inferred.is_valid() && !this.types.contains_generic_param(inferred)) {
                    resolved = inferred;
                    scope.set_resolved_type(resolved);
                }
            }
            return resolved;
        }
        // The TEMPLATE's own method, when the specialization the scope names
        // is not materialized yet - pre-mono, or inside a generic body where
        // the arguments still mention the enclosing parameters.  Keyed by the
        // owner the segment names, not by its spelling: the spelling reaches
        // the template only when it is the bare leaf, by a widening a
        // module-qualified path cannot take.
        const owner_key: SymbolStr = this.scope_owner_key(scope);
        const base_ty: TypeRef = this.scope_owner_base_type(scope);
        // The owner, not the spelling: the pin stands down for a generic
        // owner, and it recognizes one by its type.
        if (base_ty.is_valid() && !owner_ty.equals(base_ty)
                && this.owner_declares_member(base_ty, scope.member_name)) {
            *claimed = true;
            return this.type_static_call(call, scope, base_ty, owner_key);
        }
        const tmpl_ret: TypeRef = this.resolve_static_method_return_via_template(scope, call);
        if (tmpl_ret.is_valid()) {
            scope.set_resolved_type(tmpl_ret);
            return tmpl_ret;
        }
        return TypeRef::invalid();
    }

    /// True when the scope segment names a declared TYPE, distinguishing a
    /// static-method scope (`Bo`) from a module scope (`future`).  Used to keep
    /// the static-method-template path off module-qualified free-function calls.
    ///
    /// Read off the node's `Res`, which is the answer the name layer already
    /// produced from the scope the path was WRITTEN in: a remainder the type
    /// layer owns is exactly what `TypeRelative` records, and a module is `Def`.
    /// Asking an index by spelling cannot separate the two when one leaf names
    /// both a module and a type, and it answers for whichever was registered
    /// first rather than for what this file can see.
    scope_names_a_type(&this, scope: ScopeResolutionNode*) -> boolean {
        return match (scope.require_scope_res("scope_names_a_type")) {
            Res::TypeRelative(_, _) => { true }
            _                       => { false }
        };
    }

    /// The function template a `Owner::method` scope-resolution call names,
    /// for a GENERIC static method on a NON-generic owner (registered by
    /// `register_static_method_templates`, keyed `Owner::method` under the
    /// owner's registered name).  The owner is the one the scope segment
    /// names; null when the method the call selects is no such template.
    find_static_method_template(mut &this, scope: ScopeResolutionNode*, call: CallExprNode*) -> TemplateEntry* {
        // A specialization owns no template of its own: its static methods
        // are specialized with it, so a segment spelled as one names none.
        if (scope.spec_owner.is_valid()) { return null; }
        return match (scope.require_scope_res("static-method template owner")) {
            Res::TypeRelative(ResBase::Def(d), _) => { this.static_call_template(d, scope, call) }
            _                                     => { null }
        };
    }

    /// The generic static method of the non-generic owner `owner` that the
    /// call `call` through `scope` names, as its own function template: the
    /// owner's only method of the leaf when it is one, else the one entry of
    /// the family the arguments select (`select_static_overload`) when that
    /// entry is a template.  Null when the selection is a plain method, or
    /// none or several entries - the static overload pin reports a call the
    /// arguments select no single entry of.
    static_call_template(mut &this, owner: DefId, scope: ScopeResolutionNode*, call: CallExprNode*) -> TemplateEntry* {
        const leaf: SymbolStr = scope.member_name;
        if (!owner.is_valid() || !leaf.is_valid()) { return null; }
        const entries: [OverloadId] = this.ctx.decl_index.lookup_family_entries(FamilyOwner::Def(owner), leaf);
        if (entries.length < 2) { return this.ctx.member_template(ResBase::Def(owner), leaf); }
        if (call == null) { return null; }
        mut arg_types: [TypeRef] = [];
        for (mut ai: i64 = 0; ai < call.arguments.length; ai++) {
            const arg: ExpressionNode* = call.arguments[ai];
            if (arg == null || !arg.resolved_type.is_valid()) { return null; }
            arg_types.push(arg.resolved_type);
        }
        mut fits: [OverloadId] = this.select_static_overload(&entries, &arg_types, false, call, scope);
        if (fits.length == 0) { fits = this.select_static_overload(&entries, &arg_types, true, call, scope); }
        if (fits.length != 1) { return null; }
        return this.static_entry_template(fits[0]);
    }

    /// The function template entry `e` is when it is a generic static
    /// method; null for any other entry.
    static_entry_template(&this, e: OverloadId) -> TemplateEntry* {
        const m_decl: DeclarationNode* = this.ctx.decl_index.entry_method(e);
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m == null || m.func == null || !m.is_static || DeclarationNode::fn_of(m.func).generic_params.length == 0) { return null; }
        const t: TemplateEntry* = this.ctx.generic_registry.template_of(DeclarationNode::fn_of(m.func).def);
        if (t == null || t.kind != TemplateKind::Function) { return null; }
        return t;
    }

    /// Resolve a call to a GENERIC static method on a NON-generic owner
    /// (`Bo::drive<F, R>(fut)`).  Such a method is registered as its own function
    /// template keyed `Owner::method`, so it resolves exactly like a generic free
    /// function: infer the method's `<F, R>` (explicit turbofish -> argument types
    /// -> where-bound projection via `infer_free_call_bindings`), stash them for
    /// mono, and substitute them into the template return.  The owner has no type
    /// params to instantiate, and the callee is LEFT UNPINNED: mono's
    /// `specialize_free_call` re-finds this same `Owner::method` template (via the
    /// pinned `resolved_template`) and materializes the spec.  Returns invalid -
    /// falling through to the owner-only static paths - unless the scope names a
    /// registered generic static-method template whose args fully infer.
    try_resolve_static_method_template(mut &this, scope: ScopeResolutionNode*,
                                       call: CallExprNode*) -> TypeRef {
        if (call == null || scope == null) { return TypeRef::invalid(); }
        // Fire ONLY when the scope names a TYPE (a static method).  A GENERIC
        // FREE function called module-qualified (`future::block_on(fut)`) is ALSO
        // registered as a qualified-name FunctionDeclaration template, but it is
        // resolved - with its own where-bound projection AND same-leaf/arity/prefix
        // disambiguation - by `resolve_module_qualified_function`; intercepting it
        // here would bypass that disambiguation and mis-resolve an overloaded
        // module function.  The owner of a static method is always a nominal type.
        if (!this.scope_names_a_type(scope)) { return TypeRef::invalid(); }
        const entry: TemplateEntry* = this.find_static_method_template(scope, call);
        if (entry == null || entry.kind != TemplateKind::Function) {
            return TypeRef::invalid();
        }
        if (entry.param_types.length == 0) { return TypeRef::invalid(); }
        const tmpl_decl: DeclarationNode* = DeclarationNode::with_shape(entry.ast_node);
        const tmpl: FunctionDecl* = DeclarationNode::fn_of(tmpl_decl);
        if (tmpl == null || !tmpl.resolved_return_type.is_valid()) { return TypeRef::invalid(); }

        // The method's own type args: explicit turbofish (on the member or,
        // as a fallback, the scope), else argument inference + where-bound
        // projection (the free-function inference, which runs PASS D).
        const binds: [TypeRef] = this.template_call_bindings(call, scope, entry, tmpl_decl);
        if (binds.length != entry.param_types.length) { return TypeRef::invalid(); }
        // Every arg must BIND; it need not yet be CONCRETE.  Called from inside a
        // generic body the args carry the enclosing template's parameters
        // (`Futures::timeout(d, this.read())` in `implement struct BufStream<S>`
        // binds `F` to a future type mentioning `S`), and demanding concreteness
        // here abandoned the call: the return type then fell through to the
        // owner-only static paths, which answer with the template's own abstract
        // return and report it as `void`.  Mono is built for the symbolic case -
        // `specialize_free_call` runs every stashed arg through
        // `concretize_stashed_arg` with the active specialization, a no-op on an
        // already-concrete stash - and this mirrors the free-function path, which
        // has always resolved with abstract bindings.
        for (mut i: i64 = 0; i < binds.length; i++) {
            if (!binds[i].is_valid()) { return TypeRef::invalid(); }
        }

        // E0306 - where-clause bound satisfaction for the bound method args, so an
        // unsatisfied bound is a clean call-site error rather than a downstream miss.
        if (!this.check_call_where_bounds(call.span, tmpl_decl, &entry.param_syms, &binds)) {
            return TypeRef::invalid();
        }

        // Stash for mono + record the winning template (mono can't re-derive the
        // caller's import scope), then substitute into the return.  Callee stays
        // UNPINNED: `specialize_free_call` pins the `$`-mangled spec symbol.
        if (call.resolved_type_args.length == 0) {
            mut stash: [TypeRef] = [];
            for (mut i: i64 = 0; i < binds.length; i++) { stash.push(binds[i]); }
            call.set_resolved_type_args(stash);
        }
        call.set_resolved_template(entry.base_type);
        const ret: TypeRef = this.subst_free_call_return(entry, &binds, tmpl.resolved_return_type);
        if (!ret.is_valid()) { return TypeRef::invalid(); }
        scope.set_resolved_type(ret);
        return ret;
    }

    /// E0306 where-clause bound check for a generic call whose bound args are in
    /// `bindings` (declaration order, index-aligned with `param_syms`, the
    /// symbols the type parameters were declared as).
    /// Emits the bound failure and returns false on the first unsatisfied bound;
    /// true when every bound holds (or the arg is still abstract/skippable).
    /// Shared by the free-function and static-method-template call paths and
    /// a generic function or method taken as a value; `at` is the use's span.
    check_call_where_bounds(mut &this, at: SourceSpan, tmpl_decl: DeclarationNode*,
                            param_syms: &[SymbolID], bindings: &[TypeRef]) -> boolean {
        mut concrete: TypeRef = TypeRef::invalid();
        const tref: TraitRef* = this.unmet_call_bound(tmpl_decl, param_syms, bindings, &concrete);
        if (tref == null) { return true; }
        this.emit_free_call_bound_failure(at, tmpl_decl, tref, concrete, tref.path[tref.path.length - 1]);
        return false;
    }

    /// The first where-clause bound of `tmpl` that the bound args in
    /// `bindings` do not satisfy, with the arg it fails written to
    /// `out_concrete`; null when every bound holds (or the arg is still
    /// abstract/skippable).  Reports nothing.
    unmet_call_bound(mut &this, tmpl_decl: DeclarationNode*, param_syms: &[SymbolID],
                     bindings: &[TypeRef], out_concrete: TypeRef*) -> TraitRef* {
        const tmpl: FunctionDecl* = DeclarationNode::fn_of(tmpl_decl);
        for (mut bi: i64 = 0; bi < tmpl.trait_bounds.length; bi++) {
            const bound: TraitBound* = &tmpl.trait_bounds[bi];
            mut idx: i64 = -1;
            for (mut pi: i64 = 0; pi < param_syms.length; pi++) {
                if (param_syms[pi].equals(bound.subject_sym)) { idx = pi; break; }
            }
            if (idx < 0 || idx >= bindings.length) { continue; }
            const concrete: TypeRef = bindings[idx];
            if (!concrete.is_valid()) { continue; }
            if (this.types.contains_generic_param(concrete)) { continue; }
            for (mut ri: i64 = 0; ri < bound.trait_refs.length; ri++) {
                const tref: TraitRef* = &bound.trait_refs[ri];
                // A bound refused where it is written is reported there.
                if (tref.path.length == 0 || tref.refused) { continue; }
                if (!this.trait_checker().type_implements_trait(concrete, tref.definition(), 0)) {
                    *out_concrete = concrete;
                    return tref;
                }
            }
        }
        return null;
    }

    /// Resolve a call through a path to a GENERIC method of a GENERIC-owner
    /// template (`Wrap<A>::make<T>(item)`, `Wrap<A>::keep<T>(&w, item)`) - the
    /// path analogue of the instance generic-method path.  Infers the method's OWN `<T>` from the
    /// call (turbofish or argument types), stashes it for mono, then resolves the
    /// return type by substituting the owner's args (turbofish or defaults) AND the
    /// method's `<T>` into the method's abstract return.  The callee is deliberately
    /// LEFT UNPINNED - the monomorphizer materializes the owner spec, specializes
    /// the method, and pins the `$MG`-disambiguated symbol
    /// (specialize_static_method_on_generic_owner).  Returns invalid (falls through
    /// to the non-generic static paths) unless `scope` is a registered generic owner
    /// and the method the path records has type parameters that fully infer.
    try_resolve_generic_static_method(mut &this, scope: ScopeResolutionNode*,
                                      call: CallExprNode*) -> TypeRef {
        if (call == null || scope == null) { return TypeRef::invalid(); }
        mut tmpl: TemplateEntry* =
            this.resolve_scope_owner_template(scope);
        if (tmpl == null || tmpl.ast_node == null) { return TypeRef::invalid(); }
        if (tmpl.param_types.length == 0) { return TypeRef::invalid(); }

        if (tmpl.kind != TemplateKind::Struct && tmpl.kind != TemplateKind::Union
                && tmpl.kind != TemplateKind::Class) { return TypeRef::invalid(); }

        // The method the path names, wherever the owner's method is written -
        // its declaration or an impl block of the template - static or taking
        // its receiver as the path's first argument.  A non-generic one is
        // handled by the owner-only path.
        this.record_template_static(call, scope, this.scope_owner_type(scope));
        const func_decl: DeclarationNode* = this.ctx.decl_index.method_func_of(call.template_method);
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null || func.generic_params.length == 0) { return TypeRef::invalid(); }
        if (!func.resolved_return_type.is_valid()) { return TypeRef::invalid(); }

        // Infer the method's OWN `<T>` (turbofish -> argument types).  Inside a
        // generic body either argument list may name the body's parameters;
        // each copy of the body concretizes the stash.
        mut method_binds: [TypeRef] = this.infer_generic_method_bindings(call, scope, func_decl);
        if (method_binds.length != func.generic_params.length) { return TypeRef::invalid(); }
        for (mut i: i64 = 0; i < method_binds.length; i++) {
            if (!method_binds[i].is_valid()) { return TypeRef::invalid(); }
        }

        // Owner args: explicit scope turbofish, else all-defaults.
        mut owner_binds: [TypeRef] = this.compute_generic_static_owner_binds(scope, tmpl);
        if (owner_binds.length != tmpl.param_types.length) { return TypeRef::invalid(); }

        // Stash the METHOD binds for mono (mono derives owner binds itself from the
        // scope turbofish / defaults, exactly as here).
        if (call.resolved_type_args.length == 0) {
            mut stash: [TypeRef] = [];
            for (mut i: i64 = 0; i < method_binds.length; i++) { stash.push(method_binds[i]); }
            call.set_resolved_type_args(stash);
        }

        // Resolve the return type: substitute owner params AND the method's `<T>`.
        mut subst: TypeSubstitution = TypeSubstitution::empty();
        if (!this.path_method_subst(tmpl, call.template_method, &owner_binds, &method_binds, &subst)) {
            return TypeRef::invalid();
        }
        mut ret: TypeRef = subst.apply(func.resolved_return_type, this.arena);
        if (!ret.is_valid()) { return TypeRef::invalid(); }
        // A bare-owner return (`-> Wrap`) substitutes to the still-bare owner
        // TEMPLATE (a 0-field layout).  The caller and the specialized method body
        // both use the CONCRETE owner spec, so return that instantiation instead - 
        // otherwise the call site's ABI (bare template) diverges from the callee's
        // (concrete spec) and the returned value is garbage.
        if (ret.equals(tmpl.base_type)) {
            const inst: TypeRef = this.arena.create_instantiation(tmpl.base_type, owner_binds);
            if (inst.is_valid()) { ret = inst; }
        }
        scope.set_resolved_type(ret);
        // Deliberately DO NOT pin resolved_callee: mono pins the `$MG` spec
        // symbol of the method recorded here, which it reads by identity.
        return ret;
    }

    /// The substitution a path call to the generic owner's method `d` is
    /// typed under: the owner's parameters, as the block that declares the
    /// method names them in its signature, to `owner_args`, and the method's
    /// own parameters (name+index-keyed, matching specialize_method's ids) to
    /// `method_args`.  False when the method is not a declared method or its
    /// block's parameters do not stand one for one for the owner's.
    path_method_subst(mut &this, tmpl: TemplateEntry*, d: DefId, owner_args: &[TypeRef],
                      method_args: &[TypeRef], out: mut &TypeSubstitution) -> boolean {
        const recorded: ASTNode* = this.ctx.decl_index.method_decl_of(d);
        if (recorded == null || DeclarationNode::method_of(recorded) == null) { return false; }
        const m_decl: DeclarationNode* = DeclarationNode::with_shape(recorded);
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        const func_decl: DeclarationNode* = m.func;
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null || func.generic_params.length != method_args.length) { return false; }
        mut named: [TypeRef] = [];
        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            if (func.parameters[i] != null) {
                this.arena.generic_params_in(DeclarationNode::var_of(func.parameters[i]).resolved_type, &named);
            }
        }
        this.arena.generic_params_in(func.resolved_return_type, &named);
        mut tparams: [TypeRef] = [];
        if (!this.owner_param_handles(tmpl, m_decl, &named, &tparams)) { return false; }
        *out = TypeSubstitution::from_params(&tparams, owner_args);
        for (mut i: i64 = 0; i < func.generic_params.length; i++) {
            const gp_decl: DeclarationNode* = func.generic_params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            if (gp == null) { return false; }
            out.add(this.arena.create_generic_param(gp.sym_id, gp.name, i as u64), method_args[i]);
        }
        return true;
    }

    /// Infer a generic METHOD's own type args from an explicit turbofish
    /// (`make<i32>(..)`) or, failing that, from the argument types - the method
    /// analogue of `infer_free_call_bindings`.  Returns a length-`generic_params`
    /// all-valid array, or `[]` when inference is incomplete.
    /// A call's explicit type arguments, resolved as the caller wrote them,
    /// with the enclosing body's generic parameters in scope; `[]` when any
    /// fails to resolve.
    resolve_turbofish(mut &this, targs: &[TypeAnnotation*]) -> [TypeRef] {
        mut empty: [TypeRef] = [];
        mut rc: ResolutionContext = ResolutionContext::new("");
        this.symbolic.symbolic_bind_params(&rc);
        mut binds: [TypeRef] = [];
        for (mut i: i64 = 0; i < targs.length; i++) {
            const tr: TypeRef = this.ctx.type_resolver.resolve(targs[i], &rc);
            if (!tr.is_valid()) { return empty; }
            binds.push(tr);
        }
        return binds;
    }

    infer_generic_method_bindings(mut &this, call: CallExprNode*, scope: ScopeResolutionNode*,
                                  func_decl: DeclarationNode*) -> [TypeRef] {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        mut empty: [TypeRef] = [];
        const n: i64 = func.generic_params.length;
        if (n == 0) { return empty; }
        mut pids: [TypeRef] = [];
        for (mut i: i64 = 0; i < n; i++) {
            const gp_decl: DeclarationNode* = func.generic_params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            if (gp == null) { return empty; }
            const pref: TypeRef = this.arena.create_generic_param(gp.sym_id, gp.name, i as u64);
            pids.push(pref);
        }
        // Explicit turbofish on the member (`Wrap::make<i32>(..)`).
        mut targs: &[TypeAnnotation*] = &call.generic_args;
        if (targs.length == 0 && scope.generic_args.length > 0) { targs = &scope.generic_args; }
        if (targs.length > 0) {
            if (targs.length != n) { return empty; }
            return this.resolve_turbofish(targs);
        }
        // Inference from concrete argument types.
        if (func.parameters.length != call.arguments.length) { return empty; }
        mut ictx: InferCtx = InferCtx::for_template(this.arena, pids);
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            const param_decl: DeclarationNode* = func.parameters[i];
            const param: VarDecl* = DeclarationNode::var_of(param_decl);
            if (param == null || !param.resolved_type.is_valid()) { continue; }
            const arg: ExpressionNode* = call.arguments[i];
            if (this.sema_arg_is_polymorphic_literal(arg)) { continue; }
            if (!this.free_infer_arg_reliable(arg)) { continue; }
            const actual: TypeRef = arg.resolved_type;
            if (!actual.is_valid()) { continue; }
            ictx.unify(param.resolved_type, actual);
        }
        // Polymorphic literals second (fill only still-unbound params).
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            const param_decl: DeclarationNode* = func.parameters[i];
            const param: VarDecl* = DeclarationNode::var_of(param_decl);
            if (param == null || !param.resolved_type.is_valid()) { continue; }
            const arg: ExpressionNode* = call.arguments[i];
            if (!this.sema_arg_is_polymorphic_literal(arg)) { continue; }
            const lit_actual: TypeRef = arg.resolved_type;
            if (!lit_actual.is_valid()) { continue; }
            const f_idx: i64 = ictx.binding_index(param.resolved_type);
            if (f_idx >= 0 && ictx.bindings[f_idx].is_valid()) { continue; }
            ictx.unify(param.resolved_type, lit_actual);
        }
        // PASS D - a method param that appears only in a where-bound (`R` in
        // `make<F, R>(fut: F) -> R where F: Future<R>`) projects off its now-bound
        // subject; `ictx.bindings[i]` is index-aligned with `func.generic_params[i]`.
        mut method_syms_d: [SymbolID] = [];
        for (mut i: i64 = 0; i < n; i++) { method_syms_d.push(DeclarationNode::generic_param_of(func.generic_params[i]).sym_id); }
        this.ctx.type_resolver.project_where_bound_params_into(
            &func.trait_bounds, &method_syms_d, &ictx, this.ctx.source_file,
            this.state.in_symbolic_check);
        mut bindings: [TypeRef] = [];
        for (mut i: i64 = 0; i < ictx.bindings.length; i++) { bindings.push(ictx.bindings[i]); }
        for (mut i: i64 = 0; i < bindings.length; i++) {
            if (!bindings[i].is_valid()) { return empty; }
        }
        return bindings;
    }

    /// Owner type args for a generic-owner static call: explicit scope turbofish
    /// (`Wrap<u8>::make`) if present, else all-default (`Wrap` -> `Wrap<i32>`).
    /// Owner args are NOT inferred from the arguments here - those determine the
    /// METHOD's `<T>`, not the owner's params.  Inside a generic body they may
    /// name the body's parameters.
    compute_generic_static_owner_binds(mut &this, scope: ScopeResolutionNode*,
                                       tmpl: TemplateEntry*) -> [TypeRef] {
        const want: i64 = tmpl.param_types.length;
        if (want == 0) { return []; }
        mut rc: ResolutionContext = ResolutionContext::new("");
        this.symbolic.symbolic_bind_params(&rc);
        mut sb: [TypeRef] = [];
        for (mut i: i64 = 0; i < scope.scope_generic_args.length; i++) {
            const tr: TypeRef = this.ctx.type_resolver.resolve(scope.scope_generic_args[i], &rc);
            if (!tr.is_valid()) { return []; }
            sb.push(tr);
        }
        if (sb.length < want) {
            sb = this.ctx.type_resolver.expand_default_type_args(tmpl, sb, &rc);
        }
        if (sb.length != want) { return []; }
        for (mut i: i64 = 0; i < sb.length; i++) {
            if (!sb[i].is_valid()) { return []; }
        }
        return sb;
    }

    /// Stash a call's owner type args for mono, for a call through a path
    /// whose owner is a generic type.  The method is the one recorded where
    /// the call is written (`record_template_static`), wherever the owner's
    /// method is declared - in the declaration, an impl block, or a trait
    /// (`HashSet::<i32>::default()`, `(Beta for Wrap<i32>)::make()`); a
    /// non-generic one has the owner's arguments to stash, whether it is
    /// static or takes its receiver as the path's first argument
    /// (`Box2::<i32>::get(&b)`).  Run on every `Scope::member` call so the
    /// stash is produced whichever return-type branch wins; it no-ops unless
    /// `scope` names a generic struct, union or class.
    stash_static_owner_bindings_for(mut &this, scope: ScopeResolutionNode*,
                                    call: CallExprNode*) -> void {
        if (call == null || scope == null) { return; }
        if (call.resolved_type_args.length > 0) { return; }
        mut tmpl: TemplateEntry* =
            this.resolve_scope_owner_template(scope);
        if (tmpl == null || tmpl.ast_node == null) { return; }
        if (tmpl.param_types.length == 0) { return; }
        if (tmpl.kind != TemplateKind::Struct && tmpl.kind != TemplateKind::Union
                && tmpl.kind != TemplateKind::Class) { return; }
        this.record_template_static(call, scope, this.scope_owner_type(scope));
        const func_decl: DeclarationNode* = this.ctx.decl_index.method_func_of(call.template_method);
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null || func.generic_params.length > 0) { return; }
        this.stash_static_owner_bindings(scope, call, tmpl, func_decl);
    }

    /// GATED (R1): resolve a static method's return off a generic owner TEMPLATE
    /// pre-mono, substituting inferred / default / expected owner args.
    resolve_static_method_return_via_template(mut &this, scope: ScopeResolutionNode*,
                                              call: CallExprNode*) -> TypeRef {
        mut tmpl: TemplateEntry* =
            this.resolve_scope_owner_template(scope);
        if (tmpl == null || tmpl.ast_node == null) { return TypeRef::invalid(); }
        if (tmpl.param_types.length == 0) { return TypeRef::invalid(); }
        const empty_methods: [DeclarationNode*] = [];
        mut methods: &[DeclarationNode*] = &empty_methods;
        if (tmpl.kind == TemplateKind::Struct) { methods = &(DeclarationNode::struct_of(tmpl.ast_node)).methods; }
        else if (tmpl.kind == TemplateKind::Union) { methods = &(DeclarationNode::union_of(tmpl.ast_node)).methods; }
        else if (tmpl.kind == TemplateKind::Class) { methods = &(tmpl.ast_node as ClassDeclNode*).methods; }
        else { return TypeRef::invalid(); }
        mut found_count: i64 = 0;
        mut abstract_ret: TypeRef = TypeRef::invalid();
        mut matched: DeclarationNode* = null;
        const named: [DeclarationNode*] = this.ctx.decl_index.methods_named(FamilyOwner::Template(tmpl.def), scope.member_name);
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m_decl: DeclarationNode* = methods[i];
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m == null || m.func == null || !m.is_static) { continue; }
            if (!DeclarationIndex::holds_method(&named, m_decl)) { continue; }
            if (DeclarationNode::fn_of(m.func).generic_params.length > 0) { return TypeRef::invalid(); }
            found_count += 1;
            abstract_ret = DeclarationNode::fn_of(m.func).resolved_return_type;
            matched = m_decl;
        }
        if (found_count != 1 || !abstract_ret.is_valid()) { return TypeRef::invalid(); }
        // Owner type args come from ONE authority: `compute_static_owner_bindings`
        // (turbofish -> concrete args -> expected-type unify -> expected-base ->
        // literal-default; it also emits the E0307 for a literal-only binding).  Its
        // result is stashed on the call so the monomorphizer specializes the owner
        // WITHOUT re-deriving it - sema is the sole source of truth (mono-after-sema).
        // Idempotent: `stash_static_owner_bindings_for` already ran first on every
        // static call, so this normally no-ops; it just guarantees the stash on any
        // path that reaches us without the pre-stash (absence of a stash means mono
        // cannot specialize this owner-generic static call).
        this.stash_static_owner_bindings(scope, call, tmpl, DeclarationNode::method_of(matched).func);
        if (!this.types.contains_generic_param(abstract_ret)) { return abstract_ret; }

        // B2a: the return type is the abstract return with the SAME owner bindings the
        // stash holds substituted in - no independent re-derivation.  The stash is in
        // `tmpl.param_types` declaration order, so it maps the owner params directly.
        // This collapses the former concrete-args / expected-type / owner-scope /
        // literal-default return-typing copies (each of which re-ran a subset of
        // `compute_static_owner_bindings`) into the single authority.
        if (call != null && call.resolved_type_args.length == tmpl.param_types.length) {
            mut subst: TypeSubstitution = TypeSubstitution::from_params(tmpl.param_types, call.resolved_type_args);
            const out: TypeRef = subst.apply(abstract_ret, this.arena);
            if (out.is_valid() && !this.types.contains_generic_param(out)) { return out; }
        }
        return TypeRef::invalid();
    }

    /// Infer a generic static-constructor's owner type args by unifying its params
    /// against the call args.  Returns the owner bindings (declaration order,
    /// all-bound) or `[]` if any param stays unbound.
    ///
    /// `allow_literal_default` gates Pass 2 - the GUESS that pins a still-unbound
    /// owner param from a polymorphic literal's default type (`0` -> i32, the
    /// `Atomic<u64>::new(0)` miscompile trap).  Because it is a guess, callers pass
    /// `false` for the authoritative pass and only run it (`true`) as a LAST RESORT,
    /// AFTER turbofish + concrete args + the expected type have all failed - otherwise
    /// `RwLock<i32> = RwLock::new(0)` would error (E0307) instead of taking the owner
    /// arg from the `<i32>` annotation.  This method stays a PURE inference primitive:
    /// it never emits.  The DECISION that a literal-only owner binding is an error
    /// lives in `compute_static_owner_bindings` step 3, which calls this with `true`
    /// solely to detect the case, then emits E0307 (an unannotated literal is no
    /// longer accepted as the sole source for a generic owner's type argument).
    infer_static_owner_bindings_from_args(mut &this, tmpl: TemplateEntry*, func_decl: DeclarationNode*,
                                          call: CallExprNode*, allow_literal_default: boolean) -> [TypeRef] {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null) { return []; }
        if (tmpl.param_types.length == 0) { return []; }
        if (func.parameters.length != call.arguments.length) { return []; }
        mut pids: [TypeRef] = [];
        for (mut i: i64 = 0; i < tmpl.param_types.length; i++) { pids.push(tmpl.param_types[i]); }
        mut ictx: InferCtx = InferCtx::for_template(this.arena, pids);
        // Pass 1: bind from concrete (non-literal, non-null) argument types.
        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const p_decl: DeclarationNode* = func.parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p == null || !p.resolved_type.is_valid()) { continue; }
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null) { continue; }
            if (this.sema_arg_is_polymorphic_literal(arg)) { continue; }
            if (this.sema_arg_is_null_literal(arg)) { continue; }
            const actual: TypeRef = arg.resolved_type;
            if (!actual.is_valid()) { continue; }
            ictx.unify(p.resolved_type, actual);
        }
        // Pass 2 (GATED literal-default - last resort only): a still-unbound owner
        // param adopts a polymorphic literal's default type (`0` -> i32).  This runs
        // ONLY after turbofish + concrete args + the expected type all failed.  The
        // dangerous `Atomic<u64>::new(0)` case is bound by the expected-type/turbofish
        // sources BEFORE the guess, so those never reach Pass 2.  This pass stays a
        // pure detector: it binds i32 so the caller can SEE that a literal-only owner
        // binding would complete, but the caller (`compute_static_owner_bindings` step
        // 3) then rejects that with E0307 - an unannotated literal is no longer an
        // accepted source for a generic owner's type argument.  No emission here.
        if (allow_literal_default) {
            for (mut i: i64 = 0; i < func.parameters.length; i++) {
                const p2_decl: DeclarationNode* = func.parameters[i];
                const p2: VarDecl* = DeclarationNode::var_of(p2_decl);
                if (p2 == null || !p2.resolved_type.is_valid()) { continue; }
                const arg2: ExpressionNode* = call.arguments[i];
                if (arg2 == null || !this.sema_arg_is_polymorphic_literal(arg2)) { continue; }
                const f_idx: i64 = ictx.binding_index(p2.resolved_type);
                if (f_idx >= 0 && !ictx.bindings[f_idx].is_valid()) {
                    const lit_actual: TypeRef = arg2.resolved_type;
                    if (lit_actual.is_valid()) {
                        ictx.unify(p2.resolved_type, lit_actual);
                    }
                }
            }
        }
        mut bindings: [TypeRef] = [];
        for (mut i: i64 = 0; i < ictx.bindings.length; i++) { bindings.push(ictx.bindings[i]); }
        for (mut i: i64 = 0; i < bindings.length; i++) {
            if (!this.symbolic.symbolic_type_concretizable(bindings[i])) { return []; }
        }
        return bindings;
    }

    /// Recover a generic static method's owner type args by structurally unifying
    /// its ABSTRACT declared return type against the call's expected type.  Handles
    /// the case the args can't (owner param appears only in the return type) AND
    /// the owner nested inside the return (`-> Result<Array<T,A>, E>`), which the
    /// narrow base-equality expected-type source can't.  Returns a length-`want`
    /// all-bound binding set (declaration order) or `[]`.
    infer_static_owner_bindings_from_expected(mut &this, tmpl: TemplateEntry*,
                                              func_decl: DeclarationNode*) -> [TypeRef] {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null) { return []; }
        if (tmpl.param_types.length == 0) { return []; }
        if (!this.state.expected_type.is_valid()) { return []; }
        const abstract_ret: TypeRef = func.resolved_return_type;
        if (!abstract_ret.is_valid()) { return []; }
        // Nothing to recover if the return is already concrete.
        if (!this.types.contains_generic_param(abstract_ret)) { return []; }
        mut pids: [TypeRef] = [];
        for (mut i: i64 = 0; i < tmpl.param_types.length; i++) { pids.push(tmpl.param_types[i]); }
        mut ictx: InferCtx = InferCtx::for_template(this.arena, pids);
        // formal = abstract (carries owner params), actual = the expected type.
        if (!ictx.unify(abstract_ret, this.state.expected_type)) { return []; }
        mut bindings: [TypeRef] = [];
        for (mut i: i64 = 0; i < ictx.bindings.length; i++) { bindings.push(ictx.bindings[i]); }
        for (mut i: i64 = 0; i < bindings.length; i++) {
            if (!this.symbolic.symbolic_type_concretizable(bindings[i])) { return []; }
        }
        return bindings;
    }

    /// Bind the LEADING owner params the call args + expected return determine and
    /// return that contiguous, all-bound PREFIX (stopping at the first param a
    /// source leaves unbound).  Unlike `infer_static_owner_bindings_from_args` /
    /// `_from_expected` (all-or-nothing), a prefix lets a trailing DEFAULTED owner
    /// param be backfilled from its declared default when it appears in neither the
    /// params nor the return (`Arc<T, A = GlobalAlloc>::try_new`, whose `A` is
    /// hardcoded GlobalAlloc in the signature).  Empty when nothing binds.
    infer_static_owner_prefix(mut &this, tmpl: TemplateEntry*, func_decl: DeclarationNode*,
                              call: CallExprNode*) -> [TypeRef] {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null) { return []; }
        if (tmpl.param_types.length == 0) { return []; }
        mut pids: [TypeRef] = [];
        for (mut i: i64 = 0; i < tmpl.param_types.length; i++) { pids.push(tmpl.param_types[i]); }
        mut ictx: InferCtx = InferCtx::for_template(this.arena, pids);
        // Source A: concrete (non-literal, non-null) argument types.
        if (func.parameters.length == call.arguments.length) {
            for (mut i: i64 = 0; i < func.parameters.length; i++) {
                const p_decl: DeclarationNode* = func.parameters[i];
                const p: VarDecl* = DeclarationNode::var_of(p_decl);
                if (p == null || !p.resolved_type.is_valid()) { continue; }
                const arg: ExpressionNode* = call.arguments[i];
                if (arg == null) { continue; }
                if (this.sema_arg_is_polymorphic_literal(arg)) { continue; }
                if (this.sema_arg_is_null_literal(arg)) { continue; }
                const actual: TypeRef = arg.resolved_type;
                if (!actual.is_valid()) { continue; }
                ictx.unify(p.resolved_type, actual);
            }
        }
        // Source B: the abstract return unified against the expected type, which
        // recovers a param the args don't determine (incl. one nested in the return).
        if (this.state.expected_type.is_valid()) {
            const abstract_ret: TypeRef = func.resolved_return_type;
            if (abstract_ret.is_valid() && this.types.contains_generic_param(abstract_ret)) {
                ictx.unify(abstract_ret, this.state.expected_type);
            }
        }
        // Contiguous bound prefix: stop at the first param no source bound so
        // `expand_default_type_args` backfills the trailing defaulted params.
        mut prefix: [TypeRef] = [];
        for (mut i: i64 = 0; i < ictx.bindings.length; i++) {
            const b: TypeRef = ictx.bindings[i];
            if (!this.symbolic.symbolic_type_concretizable(b)) { break; }
            prefix.push(b);
        }
        return prefix;
    }

    /// Compute a generic static-method call's owner type args (declaration order,
    /// all-bound) from the highest-priority available source.  Priority:
    /// explicit scope turbofish (authoritative) -> inferred-from-args -> expected
    /// type.  The turbofish leads: when the programmer pinned the owner args, no
    /// inference should run (a non-constraining arg must not override them).  Each
    /// source builds and returns its OWN array (no owning-array reassignment/
    /// aliasing); `[]` when no source yields a complete set.
    compute_static_owner_bindings(mut &this, scope: ScopeResolutionNode*, call: CallExprNode*,
                                  tmpl: TemplateEntry*, func_decl: DeclarationNode*) -> [TypeRef] {
        const want: i64 = tmpl.param_types.length;
        if (want == 0) { return []; }

        // 0. Explicit scope turbofish (`Slice<MethodInfo>::from_raw(..)`,
        // `Atomic<u64>::new(0)`) - AUTHORITATIVE.  When the programmer pinned the
        // owner args, they ARE the answer: no inference is wanted and none should
        // run.  Consulting args-inference first would let a non-constraining
        // argument override the turbofish - a `null` arg pinning `T = void`
        // (LLVM-illegal `getelementptr(void,..)`) or a polymorphic-literal arg
        // tripping the literal-default diagnostic (a spurious E0307 on an
        // explicitly-typed `Atomic<u64>::new(0)`).
        if (scope.scope_generic_args.length > 0) {
            mut rc: ResolutionContext = ResolutionContext::new("");
            this.symbolic.symbolic_bind_params(&rc);
            mut sb: [TypeRef] = [];
            mut ok: boolean = true;
            for (mut i: i64 = 0; i < scope.scope_generic_args.length; i++) {
                const tr: TypeRef = this.ctx.type_resolver.resolve(scope.scope_generic_args[i], &rc);
                if (!tr.is_valid()) { ok = false; break; }
                sb.push(tr);
            }
            // expand_default_type_args takes `sb` by value (move) and returns the
            // backfilled array; reassigning `sb` to its own move-result is safe.
            if (ok && sb.length < want) {
                sb = this.ctx.type_resolver.expand_default_type_args(tmpl, sb, &rc);
            }
            if (ok && sb.length == want) { return sb; }
        }

        // 1. Inferred from CONCRETE argument types (no literal-default guess yet).
        // Returns a length-`want` all-bound set or `[]`.
        const ib: [TypeRef] = this.infer_static_owner_bindings_from_args(tmpl, func_decl, call, false);
        if (ib.length == want) { return ib; }

        // 1b. Unify the method's ABSTRACT return type against the expected type to
        // recover owner params the args don't determine.  This is the general case
        // the narrow base-match in step 2 below misses: an owner that appears
        // NESTED in the return type (`Array::try_with_capacity_in -> Result<Array<T,A>, E>`)
        // - its owner param `T` is in no parameter, only in the annotation
        // `Result<Array<u64,GlobalAlloc>, E>`, so structural unification of the
        // declared return against the expected type is the only source.
        const eb_unify: [TypeRef] = this.infer_static_owner_bindings_from_expected(tmpl, func_decl);
        if (eb_unify.length == want) { return eb_unify; }

        // 2. Expected-type derived (e.g. `const s: Slice<i32> = Slice::from_raw(..)`).
        if (this.state.expected_type.is_valid()) {
            // Generic-identity view, not `peel_to_instantiation`: under single-id
            // identity the expected type is often the post-mono CONCRETE aggregate
            // sitting at the former wrapper's id, for which `peel` returns null.
            // The view reads `(generic_base, type_args)` off the concrete itself,
            // so a bare static call on a generic owner (`RawBuffer::new()` typed by
            // the field annotation `RawBuffer<u8, GlobalAlloc>`) still binds its
            // owner params here instead of falling through to the literal-default guess.
            const exp_ref_s: TypeRef = this.state.expected_type;
            if (this.types.view_generic_base(exp_ref_s).equals(tmpl.base_type)
                    && this.types.view_type_arg_count(exp_ref_s) == want
                    && this.symbolic.symbolic_type_concretizable(exp_ref_s)) {
                return this.types.view_type_args_copy(exp_ref_s);
            }
        }

        // 2b. A trailing DEFAULTED owner param that the args and return leave
        // unbound, whose owner does NOT base-match the expected type because the
        // owner is NESTED inside it: `Arc<T, A = GlobalAlloc>::try_new(x) ->
        // Result<Arc<T, GlobalAlloc>, E>`.  `A` is hardcoded GlobalAlloc in the
        // signature (so it appears in no parameter and no free return position) and
        // the `Result<...>` expected type makes step 2's base-match miss it - so
        // without this, `A` never binds, the stash stays empty, and mono cannot
        // specialize the owner (codegen E0636).  Bind the leading params the
        // args/return DO determine, then backfill the trailing defaulted params from
        // their declared defaults.  Runs AFTER step 2 so a non-default owner arg from
        // a base-matching expected type still wins.
        const prefix: [TypeRef] = this.infer_static_owner_prefix(tmpl, func_decl, call);
        if (prefix.length > 0 && prefix.length < want) {
            mut rc_d: ResolutionContext = ResolutionContext::new("");
            this.symbolic.symbolic_bind_params(&rc_d);
            // A DEFAULT type argument is syntax written in the template's own
            // declaration, so a bare leaf in it means whatever that leaf means in
            // the TEMPLATE's module -- not in the caller's, which is where the
            // ambient cursor is parked here.
            mut filled: [TypeRef] = this.ctx.type_resolver.expand_default_type_args(tmpl, prefix, &rc_d);
            if (filled.length == want) {
                mut all_ok: boolean = true;
                for (mut i: i64 = 0; i < filled.length; i++) {
                    if (!this.symbolic.symbolic_type_concretizable(filled[i])) { all_ok = false; break; }
                }
                if (all_ok) { return filled; }
            }
        }

        // 3. LAST RESORT: the literal-default GUESS (`Wrap::new(0)` with no turbofish,
        // no concrete arg, and no expected type -> the owner arg would default to i32
        // from a polymorphic literal).  Reached only after every authoritative source
        // (turbofish, concrete args, expected type) has failed; demoting it here is
        // what stops a spurious E0307 on `RwLock<i32> = RwLock::new(0)` (step 2 binds
        // it from `<i32>`).  With mono-after-sema live, an unannotated literal-only
        // owner binding is now HARDENED into an error: E0307, not a silent i32 guess.
        // We still return the guessed bindings so sema types the call as i32 and does
        // not cascade; the emitted error aborts the build.  Single-fire: `stash_*`
        // sets `resolved_type_args` from these bindings, so its idempotency guard
        // short-circuits every later `compute` for this call before it re-emits.
        const lb: [TypeRef] = this.infer_static_owner_bindings_from_args(tmpl, func_decl, call, true);
        if (lb.length == want) {
            // EXEMPTION: a range literal (`0..5` / `1..=4`) is lowered by the parser
            // into `Range::new` / `RangeInclusive::new` (see expr_parser.cryo), and its
            // element type follows the ordinary integer-literal default (i32) - a
            // language-defined default, not a guess.  Erroring here would reject every
            // unannotated `for (i in 0..N)`.  Keep the silent i32 default for the range
            // family; only USER generic owners (`Atomic::new(0)`) get E0307.
            if (!this.owner_is_range_family(tmpl)) {
                this.emit_static_owner_literal_default(scope, call);
            }
            return lb;
        }
        return [];
    }

    /// Whether two definitions print alike when each is shown by its leaf,
    /// which decides whether a message names them by their full paths.
    leaves_print_alike(&this, a: DefId, b: DefId) -> boolean {
        return QualifiedName::leaf_of(this.intern.shown(this.ctx.defs.path_of(a)))
            == QualifiedName::leaf_of(this.intern.shown(this.ctx.defs.path_of(b)));
    }

    /// Whether a generic-owner static call targets one of the built-in range types
    /// whose element type is defined to default to the integer-literal default (i32).
    /// These are the parser's range-literal lowering targets (`Range`, `RangeInclusive`
    /// - see expr_parser.cryo's `..`/`..=` desugar); a literal-only owner binding on
    /// them is intended, so they are exempt from the E0307 literal-default hardening.
    owner_is_range_family(&this, tmpl: TemplateEntry*) -> boolean {
        if (tmpl == null || !tmpl.def.is_valid()) { return false; }
        const reg: GenericRegistry* = this.ctx.generic_registry;
        return tmpl.def.equals(reg.wellknown(LangItem::Range))
            || tmpl.def.equals(reg.wellknown(LangItem::RangeInclusive));
    }

    /// E0307 for a generic-owner static call whose owner type argument could only be
    /// bound from a polymorphic literal's default (`Wrap::new(0)` in a context with no
    /// turbofish, no concrete argument, and no expected type).  Pre-mono-after-sema
    /// this was a silent i32 guess (the `Atomic<u64>::new(0)` trap); it is now an
    /// error.  Emitted at most once per call (see `compute_static_owner_bindings`
    /// step 3).  `scope.scope_name` is the owner, `scope.member_name` the method.
    emit_static_owner_literal_default(mut &this, scope: ScopeResolutionNode*,
                                      call: CallExprNode*) -> void {
        const owner_str:  string = this.intern.resolve(scope.scope_name);
        const method_str: string = this.intern.resolve(scope.member_name);
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0307_CANNOT_INFER_TYPE_ARG,
            fmt::format("cannot infer the owner type argument for `%s::%s` from a polymorphic literal",
                owner_str, method_str));
        d = d.at(call.span);
        d = d.with_note("the owner type argument would default to `i32` from an unsuffixed literal; a bare literal is no longer accepted as the only source for a generic owner's type argument");
        d = d.help(fmt::format("write the owner type argument explicitly, e.g. `%s<i64>::%s(...)`, or give the call an expected type (`const x: %s<i64> = ...`)",
            owner_str, method_str, owner_str));
        this.ctx.emit_diagnostic(d);
    }

    /// Stash a generic static-method call's owner type args on the call node so the
    /// monomorphizer specializes the owner WITHOUT re-deriving them - sema is the
    /// sole source of truth (mono-after-sema).  Best-effort: stashes only a
    /// length-matched set every source could concretize; otherwise leaves the
    /// stash empty.
    ///
    /// A binding may mention the ENCLOSING template's parameters
    /// (`Slice::from_raw(this.ptr, n)` inside `Array<T>` binds `Slice`'s
    /// param to `Array`'s `T`): the stash is symbolic there, exactly as a
    /// free generic call's is, and the specialization walk concretizes it
    /// through the clone's substitution.  Refusing a symbolic stash leaves
    /// the call with no owner at all once cloned, and codegen then has only
    /// the call's return type to bind it by.  Each source refuses a binding
    /// that names any OTHER template's parameter
    /// (`symbolic_type_concretizable`), so the next source answers instead.
    stash_static_owner_bindings(mut &this, scope: ScopeResolutionNode*, call: CallExprNode*,
                                tmpl: TemplateEntry*, func_decl: DeclarationNode*) -> void {
        if (call == null || scope == null || tmpl == null) { return; }
        if (call.resolved_type_args.length > 0) { return; }
        const want: i64 = tmpl.param_types.length;
        if (want == 0) { return; }
        // `binds` owns a fresh buffer; `set_resolved_type_args` takes it by value
        // (move), so there is no aliasing/double-free.
        mut binds: [TypeRef] = this.compute_static_owner_bindings(scope, call, tmpl, func_decl);
        if (binds.length != want) { return; }
        for (mut i: i64 = 0; i < binds.length; i++) {
            if (!binds[i].is_valid()) { return; }
        }
        call.set_resolved_type_args(binds);
    }

    /// An enum variant constructor `Enum::Variant(...)` through `owner_ty`.
    /// The owner's methods are `try_resolve_static_method`'s, asked first.
    try_resolve_type_or_variant(mut &this, scope: ScopeResolutionNode*,
                                owner_ty: TypeRef, call: CallExprNode*) -> TypeRef {
        const type_ref: TypeRef = owner_ty;
        if (!type_ref.is_valid()) { return TypeRef::invalid(); }
        // An instance - written on the owner (`Result::<i32, i32>::Ok(4)`)
        // or substituted into a copy - is the answer; whether it is an enum
        // is its template's question, since an instance not yet minted has
        // no enum of its own.
        const base: TypeRef = this.types.view_generic_base(type_ref);
        const enum_t: Type* = this.arena.lookup(if (base.is_valid()) { base } else { type_ref });
        if (enum_t == null || enum_t.kind != TypeKind::Enum) { return TypeRef::invalid(); }
        if (base.is_valid()) {
            scope.set_resolved_type(type_ref);
            this.check_variant_arguments(scope, call, type_ref);
            return type_ref;
        }
        // Type arguments written on the variant (`Result::Ok::<i32, i32>(4)`)
        // name the instantiation, as they do on a payload-less variant.
        if (scope.generic_args.length > 0) {
            const written: TypeRef = this.demanded_scope_type(type_ref, &scope.generic_args, scope.span);
            scope.set_resolved_type(written);
            this.check_variant_arguments(scope, call, written);
            return written;
        }
        const promoted: TypeRef = this.promote_to_expected_instantiation(type_ref);
        // `promote` only specialises when an expected type supplies the args.
        // With none - an inline `Option::Some(<expr>)` standing as a `match`
        // subject, or initializing an unannotated local - it returns the
        // generic base, so the variant binding lands as the raw param `T`.
        // That is wrong in two ways: a `T`-typed binding hides a `Drop`-field
        // move-out from move-check (a real double-free), and a bare `T` payload
        // has no layout to lower, so the construction is rejected at codegen
        // (E0600) rather than losing its payload silently.  The constructor's
        // own argument types determine the instantiation, so recover it from
        // them whenever nothing else supplied one.
        if (promoted.equals(type_ref)) {
            const inferred: TypeRef = this.infer_variant_instantiation(type_ref, scope, call);
            if (inferred.is_valid()) { scope.set_resolved_type(inferred); return inferred; }
            // Outside a template's body only an enclosing generic call can
            // still bind the arguments (`retype_variant_arguments`); what
            // none binds is refused when the module's walk ends.
            if (!this.state.in_symbolic_check && this.ctx.generic_registry.is_template(type_ref)) {
                this.state.unbound_variants.push(scope);
            }
        }
        scope.set_resolved_type(promoted);
        return promoted;
    }

    /// E0214 at each argument of a variant constructed in `instance` - named
    /// by type arguments written on the path - that its payload type in that
    /// instance does not accept.  The payload is the template's with the
    /// instance's arguments substituted, so `Result::<i32, i32>::Ok("x")` is
    /// checked against `i32`, not the template's `T`.
    check_variant_arguments(mut &this, scope: ScopeResolutionNode*, call: CallExprNode*,
                            instance: TypeRef) -> void {
        if (call == null || !instance.is_valid()) { return; }
        const base: TypeRef = this.types.view_generic_base(instance);
        if (!base.is_valid()) { return; }
        const base_t: Type* = this.arena.lookup(base);
        if (base_t == null || base_t.kind != TypeKind::Enum) { return; }
        const et: EnumType* = base_t.as_enum();
        const vi: i64 = et.variant_index(scope.member_name);
        if (vi < 0) { return; }
        const args: [TypeRef] = this.types.view_type_args_copy(instance);
        const payload: [TypeRef] = this.substitute_payload_types(et.variants[vi].payload_types, base, &args);
        const n: i64 = if (call.arguments.length < payload.length) { call.arguments.length } else { payload.length };
        for (mut i: i64 = 0; i < n; i++) {
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null || !arg.resolved_type.is_valid()) { continue; }
            const want: TypeRef = payload[i];
            if (!this.types.arg_type_is_concrete(want) || !this.types.arg_type_is_concrete(arg.resolved_type)) { continue; }
            if (this.checker.can_assign(arg.resolved_type, want)) { continue; }
            this.diag.emit_type_mismatch_with_value(ErrorCode::E0214_ARGUMENT_MISMATCH, arg.span,
                want, arg.resolved_type,
                fmt::format("argument %lld of `%s` is its payload in `%s`", i + 1,
                    this.intern.resolve(scope.member_name), this.types.type_display_name(instance)),
                SourceSpan::none(), arg);
        }
    }

    /// E0307 at each recorded variant still typed as its generic enum: no
    /// instance was named, and neither its arguments, the expected type nor
    /// an enclosing call determined one, so the value has no layout.
    refuse_unbound_variants(mut &this) -> void {
        for (mut i: i64 = 0; i < this.state.unbound_variants.length; i++) {
            const scope: ScopeResolutionNode* = this.state.unbound_variants[i];
            if (this.ctx.generic_registry.is_template(scope.resolved_type)) {
                this.emit_variant_cannot_infer(scope, scope.resolved_type);
            }
        }
        this.state.unbound_variants.clear();
    }

    /// E0307 for a generic enum's variant constructed with no instance named
    /// and none its arguments or the expected type determine.
    emit_variant_cannot_infer(mut &this, scope: ScopeResolutionNode*, enum_ref: TypeRef) -> void {
        const enum_str: string = this.types.type_display_name(enum_ref);
        const member_str: string = this.intern.resolve(scope.member_name);
        mut has_payload: boolean = true;
        const et_t: Type* = this.arena.lookup(enum_ref);
        if (et_t != null && et_t.kind == TypeKind::Enum) {
            const et: EnumType* = et_t.as_enum();
            const vi: i64 = et.variant_index(scope.member_name);
            if (vi >= 0) { has_payload = et.variants[vi].payload_types.length > 0; }
        }
        const args_tail: string = if (has_payload) { "(...)" } else { "" };
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0307_CANNOT_INFER_TYPE_ARG,
            fmt::format("cannot infer the type arguments of `%s` for its variant `%s`", enum_str, member_str));
        d = d.at_with_label(scope.span, "generic, and nothing here says which instance this constructs");
        d = d.help(fmt::format(
            "write the type arguments, `%s::<...>::%s%s`, or give the value an expected type", enum_str, member_str, args_tail));
        this.ctx.emit_diagnostic(d);
    }

    /// Infer the concrete instantiation of a generic enum from an enum-variant
    /// constructor's argument types (`Option::Some(<Holder>)` -> `Option<Holder>`)
    /// when no expected type promoted it.  Matches each of the variant's
    /// bare-param payload positions against the corresponding argument's resolved
    /// type and binds the template params.  Returns an `InstantiatedType` only
    /// when every template param is bound to an argument type naming one type;
    /// otherwise `TypeRef::invalid()` so the caller keeps the generic base
    /// (generic template bodies stay on that path).
    infer_variant_instantiation(mut &this, base_ref: TypeRef, scope: ScopeResolutionNode*,
                                call: CallExprNode*) -> TypeRef {
        if (call == null) { return TypeRef::invalid(); }
        const tmpl: TemplateEntry* = this.ctx.generic_registry.template_of_type(base_ref);
        if (tmpl == null || tmpl.param_count == 0) { return TypeRef::invalid(); }
        const base_t: Type* = this.arena.lookup(base_ref);
        if (base_t == null || base_t.kind != TypeKind::Enum) { return TypeRef::invalid(); }
        const et: EnumType* = base_t.as_enum();
        // The variant is the one this call's payload lookup already found
        // and pinned on the path (`lookup_scope_variant_payload_types`);
        // the ordinal is the same in the template and every instantiation.
        mut ordinal: i64 = -1;
        match (scope.resolved_member) {
            MemberPin::Variant(v) => { ordinal = v; }
            _                     => { }
        }
        if (ordinal < 0 || ordinal >= et.variants.length) { return TypeRef::invalid(); }
        const variant: EnumVariantInfo* = &et.variants[ordinal];
        if (variant.payload_types.length != call.arguments.length) { return TypeRef::invalid(); }

        mut bindings: [TypeRef] = [];
        for (mut p: i64 = 0; p < tmpl.param_count; p++) { bindings.push(TypeRef::invalid()); }

        for (mut i: i64 = 0; i < variant.payload_types.length; i++) {
            const pt: Type* = this.arena.lookup(variant.payload_types[i]);
            if (pt == null) { continue; }
            // Only the direct `T` payload shape (the position IS a bare param).
            mut gpt: GenericParamType* = null;
            if (pt.kind == TypeKind::GenericParam) { gpt = pt.as_generic_param(); }
            else { continue; }
            const arg: ExpressionNode* = call.arguments[i];
            if (arg == null || !arg.has_resolved_type()) { continue; }
            const arg_ty: TypeRef = arg.resolved_type;
            // Only an argument naming one type may bind. A generic param would
            // instantiate the enum over a parameter rather than a type, and so
            // would an instantiation holding one - `Option<?>`, a
            // specialization monomorphization cannot produce, which then
            // fails the codegen module as an ICE rather than as a source
            // error. Both stay on the generic-base path, where the enclosing
            // template's specialization binds them later.  An instantiation
            // not yet minted whose arguments are types names one type, and
            // binds as its specialization will after monomorphization.
            if (!this.types.arg_type_names_one_type(arg_ty)) { continue; }
            for (mut p: i64 = 0; p < tmpl.param_count; p++) {
                if (gpt.declared_by(tmpl.param_syms[p])) { bindings[p] = arg_ty; break; }
            }
        }

        // Every parameter must come out bound. A partially-bound enum has no
        // layout, so returning one would only move the failure downstream.
        for (mut p: i64 = 0; p < tmpl.param_count; p++) {
            if (!bindings[p].is_valid()) { return TypeRef::invalid(); }
        }
        // Register the instantiation so it is monomorphized for codegen;
        // `instantiate` stays arena-only under a symbolic no-demand walk.
        return this.ctx.generic_registry.instantiate(base_ref, &bindings);
    }

    try_resolve_module_function(mut &this, scope: ScopeResolutionNode*, call: CallExprNode*) -> TypeRef {
        const q_ret: TypeRef = this.resolve_module_qualified_function(scope.scope_name, scope.member_name, call, scope);
        if (q_ret.is_valid()) { scope.set_resolved_type(q_ret); return q_ret; }
        return TypeRef::invalid();
    }

    /// The function a module-qualified call (`intrinsics::frexp`, `mem::swap`)
    /// names, or an invalid id when the path names no function.
    ///
    /// The written scope may be any whole-segment SUFFIX of the defining
    /// namespace (`mem` for `std::core::mem`), and several modules can share
    /// one suffix, so the spelling alone does not identify the module - the
    /// imports of the file that wrote it do.  NameResolution answers that while
    /// those imports are still in hand, binds the member the module offers,
    /// and records that declaration on the node (`member_def`); this reads the
    /// answer and does not re-derive it, so the declaration the call names is
    /// the one the name layer bound and never a `module::member` composed here.
    ///
    /// There is deliberately NO second strategy when the node carries no
    /// answer.  The graph scan that used to stand here matched every namespace
    /// carrying the suffix and broke ties by arity, then by longest shared
    /// prefix with the ambient cursor, then by enumeration order - none of
    /// which the source mentions, so it could and did bind a call to a module
    /// the file never imported.  Returning nothing lets the caller diagnose an
    /// unresolved path, which is the honest answer to a question this stage no
    /// longer has the inputs to answer.
    ///
    /// Shared by return-type resolution and by parameter-type lookup so the two
    /// cannot pick different modules: classifying an argument against one
    /// module's signature while the call resolves to another's would hand the
    /// move passes an ownership answer for a function that is not being called.
    resolve_module_qualified_def(&this, scope: ScopeResolutionNode*) -> DefId {
        if (scope == null) { return DefId::invalid(); }
        const d: DefId = scope.member_def;
        // A member the module offers that is not a function - a type, a
        // global - names no call.
        if (!this.overload_return_type(this.ctx.decl_index.func_type_of_def(d)).is_valid()) {
            return DefId::invalid();
        }
        return d;
    }

    /// The declared parameter types of a module-qualified free function, for
    /// expected-type propagation and argument classification.
    ///
    /// `lookup_callee_function_type` cannot answer this shape: its
    /// `ScopeResolution` branch looks the call site's own spelling
    /// (`mem::swap`) up as written.  A scope that names a MODULE by a
    /// suffix of its namespace therefore found nothing, and every argument of
    /// such a call stayed unclassified - so the move passes read each one as a
    /// transfer and the `*p` move-out rejection stood down on the exact call
    /// shape (`mem::swap<T>(&s, this)`) it exists to police.  Generic or not is
    /// irrelevant: `helper::eat_res(*p)` missed it too.
    ///
    /// For a generic template the parameters still carry the template's own
    /// generic params (`T*`); the caller substitutes any turbofish args, and
    /// either way the ownership answer is the same, since substitution cannot
    /// turn a pointer parameter into a by-value one.
    lookup_module_qualified_param_types(mut &this, scope: ScopeResolutionNode*) -> [TypeRef] {
        if (this.ctx.decl_index == null || this.ctx.module_graph == null) { return []; }
        const ft: TypeRef = this.ctx.decl_index.func_type_of_def(
            this.resolve_module_qualified_def(scope));
        if (!ft.is_valid()) { return []; }
        const ft_raw: Type* = this.arena.lookup(ft);
        if (ft_raw == null || ft_raw.kind != TypeKind::Function) { return []; }
        return sema_copy_type_refs(&ft_raw.as_function().param_types);
    }

    /// The return type of a module-qualified function (`intrinsics::frexp`),
    /// from the module NameResolution recorded on the scope segment.
    ///
    /// `call` is for the visibility gate and the template specialization below
    /// it, not for choosing the module - that question is already answered.
    resolve_module_qualified_function(mut &this, scope_name: SymbolStr, member_name: SymbolStr,
                                      call: CallExprNode*, scope: ScopeResolutionNode*) -> TypeRef {
        const callee: DefId = this.resolve_module_qualified_def(scope);
        if (!callee.is_valid()) { return TypeRef::invalid(); }
        const ret: TypeRef = this.overload_return_type(this.ctx.decl_index.func_type_of_def(callee));
        if (!ret.is_valid()) { return TypeRef::invalid(); }
        // A WRITTEN qualified path resolves straight to a symbol here and
        // never meets the bare binder's scope classifier, so visibility is
        // checked here or nowhere: a private function reached by its path
        // would otherwise be called from any module.
        //
        const q_span: SourceSpan = if (call != null) {
            call.span
        } else {
            if (scope != null) { scope.span } else { SourceSpan::none() }
        };
        this.enforce_callee_visibility(callee, this.call_use_site_module(q_span), q_span);

        // A generic function is the template its definition is: the one the
        // name layer bound the member to, asked by identity.  The call records
        // it, so the monomorphizer specializes that template and never looks
        // the member up again.
        mut is_fn_template: boolean = false;
        mut tmpl: TemplateEntry* = null;
        tmpl = this.ctx.generic_registry.template_of(callee);
        if (tmpl != null && tmpl.kind == TemplateKind::Function) { is_fn_template = true; }
        if (is_fn_template && call != null) {
            call.set_resolved_template(tmpl.base_type);
            // The instance the call is pinned to, else the one its turbofish
            // writes: the template's placeholder with the arguments.
            mut spec_inst: TypeRef = TypeRef::invalid();
            match (&call.resolved_callee) {
                CalleePin::Instance(i) => { spec_inst = i; }
                _                      => { }
            }
            if (!spec_inst.is_valid()) {
                if (scope != null && scope.generic_args.length > 0) {
                    spec_inst = this.resolve_generic_scope_type(tmpl.base_type, &scope.generic_args, scope.span);
                } else if (call.generic_args.length > 0) {
                    spec_inst = this.resolve_generic_scope_type(tmpl.base_type, &call.generic_args, call.span);
                }
            }
            if (spec_inst.is_valid()) {
                const spec_ret: TypeRef = this.instance_return_type(spec_inst);
                if (spec_ret.is_valid()) {
                    call.set_resolved_callee(CalleePin::Instance(spec_inst));
                    return spec_ret;
                }
            }
            const no_turbofish: boolean =
                (scope == null || scope.generic_args.length == 0) && call.generic_args.length == 0;
            if (no_turbofish) {
                // The stamp names the family's generic function; a
                // non-generic signature of it may accept the arguments too.
                mut arg_types: [TypeRef] = [];
                for (mut ai: i64 = 0; ai < call.arguments.length; ai++) {
                    const arg: ExpressionNode* = call.arguments[ai];
                    if (arg == null || !arg.resolved_type.is_valid()) { break; }
                    arg_types.push(arg.resolved_type);
                }
                if (arg_types.length == call.arguments.length) {
                    this.report_free_generic_tie(call, callee, scope, &arg_types);
                }
                const tfn_decl: DeclarationNode* = DeclarationNode::with_shape(tmpl.ast_node);
                const tfn: FunctionDecl* = DeclarationNode::fn_of(tfn_decl);
                if (tfn != null) {
                    mut binds: [TypeRef] = this.infer_free_call_bindings(call, tmpl, tfn_decl);
                    if (binds.length > 0) {
                        mut stash: [TypeRef] = [];
                        for (mut i: i64 = 0; i < binds.length; i++) { stash.push(binds[i]); }
                        call.set_resolved_type_args(stash);
                        const cret: TypeRef = this.subst_free_call_return(tmpl, &binds, ret);
                        if (cret.is_valid()) { return cret; }
                    }
                }
            }
            mut subst_ret: TypeRef = TypeRef::invalid();
            if (scope != null && scope.generic_args.length > 0) {
                subst_ret = this.subst_return_from_call_args(call, tmpl, &scope.generic_args, ret);
            } else if (call.generic_args.length > 0) {
                subst_ret = this.subst_return_from_call_args(call, tmpl, &call.generic_args, ret);
            }
            if (subst_ret.is_valid()) { return subst_ret; }
        }
        if (!is_fn_template) {
            // A call already pinned to one of the member's signatures - by
            // the walk before monomorphization, read again after it - returns
            // what that signature returns; the declaration the path names is
            // one overload of the family, not necessarily the one called.
            if (call != null) {
                match (&call.resolved_callee) {
                    CalleePin::Decl(e) => {
                        return this.overload_return_type(this.ctx.decl_index.entry_signature(e));
                    }
                    _ => { }
                }
            }
            // Which of the member's signatures the arguments select, as for
            // a bare call; the first declaration the path names is not the
            // answer when the member is overloaded.
            const selected_ret: TypeRef = this.pin_family_signature(call, callee, scope);
            if (selected_ret.is_valid()) { return selected_ret; }
            this.pin_scope_callee_def(call, callee);
        }
        return ret;
    }

    /// Substitute a generic function's explicit turbofish args into its template
    /// return (concrete return BEFORE mono creates the spec).  Stashes the args.
    subst_return_from_call_args(mut &this, call: CallExprNode*, tmpl: TemplateEntry*,
                                generic_args: &[TypeAnnotation*], tmpl_ret: TypeRef) -> TypeRef {
        if (generic_args.length != tmpl.param_types.length) { return TypeRef::invalid(); }
        mut rc: ResolutionContext = ResolutionContext::new("");
        // Explicit turbofish on the call: the CALLER's syntax, not the
        // template's, resolved where it is written.
        this.symbolic.symbolic_bind_params(&rc);
        mut arg_refs: [TypeRef] = [];
        for (mut i: i64 = 0; i < generic_args.length; i++) {
            const tr: TypeRef = this.ctx.type_resolver.resolve(generic_args[i], &rc);
            if (!tr.is_valid()) { mem::drop(arg_refs); return TypeRef::invalid(); }
            arg_refs.push(tr);
        }
        if (call != null) {
            mut stash: [TypeRef] = [];
            for (mut i: i64 = 0; i < arg_refs.length; i++) { stash.push(arg_refs[i]); }
            call.set_resolved_type_args(stash);
        }
        mut subst: TypeSubstitution = TypeSubstitution::from_params(tmpl.param_types, arg_refs);
        const out: TypeRef = subst.apply(tmpl_ret, this.arena);
        if (!out.is_valid() || this.types.contains_generic_param(out)) { return TypeRef::invalid(); }
        return out;
    }

    /// The generic template a written name refers to (`Atomic` in
    /// `Atomic<u64>::new(..)`, `Array` in `Array<T> { .. }`).
    ///
    /// ONE question, asked of the `Res` the resolver stamped on the node that
    /// WROTE the name.  `Res` names a DEFINITION and the registry is keyed by
    /// that same canonical name, so the two meet without a search - and a
    /// spelling already mangled to an instantiation still answers, because the
    /// stamp names what the instantiation is OF and no spelling of it carries
    /// that.
    ///
    /// An answer naming no definition - a local, a generic parameter, a
    /// failure - is not a template, and there is deliberately nowhere here to
    /// put a second lookup for one.  Callers pass their own node's answer;
    /// there is no node-kind branch, because the question does not depend on
    /// which kind asked.
    lookup_scope_template(&this, r: Res) -> TemplateEntry* {
        return match (r) {
            Res::TypeRelative(b, _) => {
                match (b) {
                    ResBase::Def(d) => { this.ctx.generic_registry.template_of(d) }
                    // A primitive or a type parameter declares nothing, so
                    // there is no template for it to be.
                    _               => { null }
                }
            }
            Res::Def(q) => { this.ctx.generic_registry.template_of(q) }
            _           => { null }
        };
    }

    /// The same question asked of an explicit-generic call's callee
    /// (`f<T>(..)`), through the door: the name layer stamps every bare
    /// callee it can place and sema refuses the rest (E0202) before a
    /// turbofish is read, so a callee with no answer here is a defect the
    /// door records - measured at 0 over the corpus before the door went in.
    spelling_template(&this, slot: ResSlot) -> TemplateEntry* {
        return this.lookup_scope_template(slot.require("call_resolver:explicit-generic callee"));
    }

    /// The TYPE a generic scope denotes, from the pair rather than from a name:
    /// a base the caller read off its node's stamp, plus the arguments written
    /// at the use site.  `(base, args)` IS an instantiation's identity, and the
    /// arena keys its canonical slot on exactly that, so no name is minted for
    /// it: a static call through the segment (`Wrap::<i32>::make()`) asks this
    /// instance's family.
    ///
    /// `use_span` is the span of the syntax that named the SCOPE - always a
    /// call/scope/identifier/literal node at the use site.  It is the fallback
    /// home, not the home: `default_expansion` splices a CLONE of the
    /// template's own default annotation into the argument list, and the clone
    /// keeps the template's span.  Resolving that clone against the scope's
    /// module would bind `String<A = GlobalAlloc>`'s default in whichever
    /// module happened to name `String`.  Each argument therefore resolves in
    /// the module that WROTE IT, which its own span records; the scope's
    /// module answers only when an argument carries no file of its own.
    ///
    /// Invalid when the base names no template, which is the caller's signal
    /// that its node asks about something other than an instantiation - never a
    /// licence to retry this question by spelling.
    resolve_generic_scope_type(mut &this, base: TypeRef,
                               generic_args: &[TypeAnnotation*],
                               use_span: SourceSpan) -> TypeRef {
        if (!base.is_valid()) { return TypeRef::invalid(); }
        if (generic_args.length == 0) { return base; }
        const tmpl: TemplateEntry* =
            this.ctx.generic_registry.template_of_type(base);
        if (tmpl == null) { return TypeRef::invalid(); }
        mut res_ctx: ResolutionContext = ResolutionContext::new("");
        // Inside a template body an argument may name the enclosing generic
        // parameters, which resolve only against their bindings; binding them
        // also marks the context demand-free, so an abstract instantiation
        // registers no monomorphization demand.  Each argument otherwise
        // resolves by its own stamp, in the module that WROTE it: a default
        // spliced from the template keeps the TEMPLATE's answer.
        this.symbolic.symbolic_bind_params(&res_ctx);
        mut arg_refs: [TypeRef] = [];
        for (mut i: i64 = 0; i < generic_args.length; i++) {
            const a: TypeRef = this.ctx.type_resolver.resolve(generic_args[i], &res_ctx);
            if (!a.is_valid()) { return TypeRef::invalid(); }
            arg_refs.push(a);
        }
        // A trailing default is written nowhere at the use site, so the pair is
        // short by exactly those positions and would key a slot the canonical
        // one never meets.
        if (arg_refs.length < tmpl.param_count) {
            arg_refs = this.ctx.type_resolver.expand_default_type_args(tmpl, arg_refs, &res_ctx);
        }
        // Demand-FREE, like every other reference to an instantiation: the slot
        // is demanded by the declared type this flows into, and adding a fresh
        // demand here perturbs the mono worklist.
        return this.arena.create_instantiation(base, &arg_refs);
    }

    /// The instantiation a path's written arguments name, as the type of a
    /// value the path denotes (`Tagged::<i32>::Hi`).  Such a value may flow
    /// into no declared type that would demand the instantiation - a cast,
    /// an argument - so it is demanded here.
    demanded_scope_type(mut &this, base: TypeRef, generic_args: &[TypeAnnotation*],
                        use_span: SourceSpan) -> TypeRef {
        const t: TypeRef = this.resolve_generic_scope_type(base, generic_args, use_span);
        if (!t.is_valid() || t.equals(base)) { return t; }
        const args: [TypeRef] = this.types.view_type_args_copy(t);
        return this.ctx.generic_registry.instantiate(base, &args);
    }

    /// Resolve a generic scope-call return (`Result::ok`) to the concrete
    /// specialization, from explicit scope args or the expected type.  The
    /// owner's written arguments are substituted into whatever the return
    /// is - an instantiation (`Result<Arc<T, A>, E>`), a bare parameter
    /// (`-> T`), a pointer to one (`-> T*`); the expected type answers only
    /// an instantiation of the generic it names.
    try_resolve_generic_return(mut &this, ret: TypeRef, scope_name: SymbolStr,
                               member_name: SymbolStr, scope: ScopeResolutionNode*) -> TypeRef {
        const ret_t: Type* = this.arena.lookup(ret);
        if (ret_t == null) { return ret; }
        const instantiated: boolean = ret_t.kind == TypeKind::InstantiatedType;
        if (instantiated && ret_t.as_instantiated().has_resolved_type()) { return ret; }
        if (!instantiated && !this.types.contains_generic_param(ret)) { return ret; }
        // Turbofish owner args (`Arc<Thing, GlobalAlloc>::try_new`): map them to the
        // OWNER's generic params and substitute throughout the return type. This
        // handles BOTH a return that IS the owner (`-> Arc<T, A>`) and one where the
        // owner is NESTED (`-> Result<Arc<T, GlobalAlloc>, E>`). The former positional
        // `instantiate(ret_base, args)` was valid only when the return's outermost
        // base WAS the owner; for a nested owner it substituted the owner args into
        // the OUTER generic - `Arc<Thing, GlobalAlloc>::try_new` typed as
        // `Result<Thing, GlobalAlloc>` instead of `Result<Arc<Thing, GlobalAlloc>, E>`
        // (it fired only because the arg counts coincidentally matched).
        if (scope != null && scope.scope_generic_args.length > 0) {
            mut tmpl: TemplateEntry* = this.resolve_scope_owner_template(scope);
            if (tmpl != null && tmpl.param_types.length >= scope.scope_generic_args.length) {
                mut resolved_args: [TypeRef] = [];
                mut all_valid: boolean = true;
                mut res_ctx: ResolutionContext = ResolutionContext::new("");
                // Scope turbofish written at the use site, resolved there. The
                // `expand_default_type_args` below re-homes itself on the
                // TEMPLATE's module, so the two do not conflict.
                this.symbolic.symbolic_bind_params(&res_ctx);
                for (mut i: i64 = 0; i < scope.scope_generic_args.length; i++) {
                    const arg_ref: TypeRef = this.ctx.type_resolver.resolve(scope.scope_generic_args[i], &res_ctx);
                    if (!arg_ref.is_valid()) { all_valid = false; break; }
                    resolved_args.push(arg_ref);
                }
                if (all_valid && resolved_args.length < tmpl.param_types.length) {
                    resolved_args = this.ctx.type_resolver.expand_default_type_args(tmpl, resolved_args, &res_ctx);
                }
                if (all_valid && resolved_args.length == tmpl.param_types.length) {
                    mut subst: TypeSubstitution = TypeSubstitution::from_params(tmpl.param_types, resolved_args);
                    const out: TypeRef = subst.apply(ret, this.arena);
                    if (out.is_valid()) { return out; }
                }
            }
        }
        if (!instantiated || !this.state.expected_type.is_valid()) { return ret; }
        const ret_inst: InstantiatedType* = ret_t.as_instantiated();
        mut exp_ref: TypeRef = this.state.expected_type;
        mut exp_t: Type* = this.arena.lookup(exp_ref);
        if (exp_t != null && exp_t.kind == TypeKind::TypeAlias) {
            const alias: TypeAliasType* = exp_t.as_alias();
            if (alias.has_target()) { exp_ref = alias.target; exp_t = this.arena.lookup(exp_ref); }
        }
        // Sibling of the expected-type peel in `compute_static_owner_bindings`:
        // via the generic-identity view so a post-mono concrete expected type still
        // yields its type_args.  Without it this returns the still-abstract `ret`.
        const exp_base: TypeRef = this.types.view_generic_base(exp_ref);
        if (!exp_base.is_valid()) { return ret; }
        if (!ret_inst.generic_base.equals(exp_base)) { return ret; }
        // The expected type IS the instantiation the return names.
        return this.state.expected_type;
    }

    /// The instance of the generic struct `tmpl` a literal written without
    /// arguments builds, from its fields: each field's declared type, over
    /// the template's parameters, unified with the type of the value given
    /// for it.  Demanded, since the literal may flow where nothing else
    /// names the instance (a generic function's argument).  Invalid unless
    /// every parameter is bound to a concrete type.
    instance_from_fields(mut &this, tmpl: TemplateEntry*, fields: &[TypeRef], values: &[TypeRef]) -> TypeRef {
        mut pids: [TypeRef] = [];
        for (mut i: i64 = 0; i < tmpl.param_types.length; i++) { pids.push(tmpl.param_types[i]); }
        mut ictx: InferCtx = InferCtx::for_template(this.arena, pids);
        for (mut i: i64 = 0; i < fields.length && i < values.length; i++) { ictx.unify(fields[i], values[i]); }
        mut args: [TypeRef] = [];
        for (mut i: i64 = 0; i < ictx.bindings.length; i++) {
            const b: TypeRef = ictx.bindings[i];
            if (!b.is_valid() || this.types.contains_generic_param(b)) { return TypeRef::invalid(); }
            args.push(b);
        }
        return this.ctx.generic_registry.instantiate(tmpl.base_type, &args);
    }

    /// Promote an enum-variant constructor's base-type return to the matching
    /// concrete specialization from `expected_type`.
    promote_to_expected_instantiation(&this, found: TypeRef) -> TypeRef {
        if (!this.state.expected_type.is_valid()) { return found; }
        mut exp_ref: TypeRef = this.state.expected_type;
        mut exp_t: Type* = this.arena.lookup(exp_ref);
        if (exp_t != null && exp_t.kind == TypeKind::TypeAlias) {
            const alias: TypeAliasType* = exp_t.as_alias();
            if (alias.has_target()) { exp_ref = alias.target; exp_t = this.arena.lookup(exp_ref); }
        }
        if (exp_t == null) { return found; }
        // One O(1) question for both representations: is the expected type an
        // instantiation OF `found`?  A pre-mono wrapper and a post-mono concrete
        // both answer from their own generic identity.
        //
        // This replaces an O(arena) scan that looked for an InstantiatedType whose
        // `resolved_type` was the expected concrete - i.e. it depended on the
        // origin-carrier node existing, and silently found nothing once the
        // concrete carried its identity itself.
        const exp_base: TypeRef = this.types.view_generic_base(exp_ref);
        if (exp_base.is_valid() && exp_base.equals(found)) { return exp_ref; }
        return found;
    }


    // -- Scope-call argument type checking --

    /// Argument type-check for a `Type::method(args)` / `Module::func(args)`
    /// scope-resolution call: checks only when exactly ONE function-typed
    /// overload is registered under the callee's key, else defers to the
    /// inherent static-method gather.  A module segment owns a module
    /// function under the module's own qualified name, which the segment's
    /// stamp carries and the spelling does not (`fmt` for `std::fmt`, and
    /// two modules can share a suffix), so its key comes from the one path
    /// that resolves the call's return - the signature checked is the one
    /// called.  A type segment's key is the owner's registered name.
    check_scope_call_arg_types(mut &this, visitor: SemaVisitor*, scope: ScopeResolutionNode*,
                               call: CallExprNode*) -> void {
        if (this.ctx.decl_index == null) { return; }
        mut names_module: boolean = false;
        match (scope.require_scope_res("scope-call arg check")) {
            Res::Def(_) => { names_module = true; }
            _           => { }
        }
        const lookup_sym: SymbolStr = this.scope_owner_key(scope);
        mut callee: DefId = DefId::invalid();
        mut overloads: [TypeRef] = [];
        if (names_module) {
            callee = this.resolve_module_qualified_def(scope);
            if (!callee.is_valid()) { return; }
            const family: [OverloadId] = this.ctx.decl_index.family_entries_of_def(callee);
            for (mut i: i64 = 0; i < family.length; i++) {
                overloads.push(this.ctx.decl_index.entry_signature(family[i]));
            }
        } else {
            const owner_ty: TypeRef = this.scope_owner_type(scope);
            if (this.scope_is_generic_template(owner_ty, scope, call)) {
                this.check_template_static_args(visitor, scope, call);
                return;
            }
            const scope_str:  string = this.intern.resolve(lookup_sym);
            const member_str: string = this.intern.resolve(scope.member_name);
            if (scope_str.length() == 0 || member_str.length() == 0) { return; }
            if (scope.impl_trait != null) {
                this.check_impl_qualified_args(visitor, FamilyOwner::Type(owner_ty), scope, call);
                return;
            }
            // A scope naming a TRAIT: the call's signature is the receiver's
            // implementation's, not the trait declaration's (which registers
            // no signature under `Trait::m`).
            const qt: Type* = this.arena.lookup(this.types.scope_qualifier_type(scope));
            if (qt != null && qt.kind == TypeKind::Trait) {
                this.check_trait_qualified_args(visitor, this.ctx.decl_index.def_of(this.types.scope_qualifier_type(scope), this.ctx.type_arena), scope, call);
                return;
            }
            overloads = this.ctx.decl_index.lookup_func_type_overloads(FamilyOwner::Type(owner_ty), scope.member_name);
        }
        if (overloads.length == 1) {
            const ot: Type* = this.arena.lookup(overloads[0]);
            if (ot != null && ot.kind == TypeKind::Function) {
                const ft: FunctionType* = ot.as_function();
                // A variadic callee's declared parameters are checked like any
                // other's; only the tail past them is unconstrained.
                const expected: i64 = ft.param_types.length;
                const got: i64 = call.arguments.length;
                if (got == expected || (ft.is_variadic && got > expected)) {
                    const params: [TypeRef] = this.free_call_params(
                        if (callee.is_valid()) { this.ctx.generic_registry.template_of(callee) } else { null },
                        call, &ft.param_types, &ft.param_types);
                    this.check_args_against_params(visitor, &call.arguments, params.as_slice());
                } else {
                    this.diag.emit_method_arity_error(call.span, scope.member_name, "function",
                        expected, got, ft.is_variadic);
                }
            }
            return;
        }
        // A module owns no static methods; only a type segment has an
        // inherent gather to defer to.
        if (names_module) { return; }
        this.check_static_scope_method_args(visitor, scope, call);
    }

    /// Argument check for a call through a path whose owner is a generic
    /// type (`String::from_str("node")`): against the parameters of the
    /// method the call recorded where it is written, with the owner's
    /// arguments it stashed substituted in.  This is where an argument meets
    /// its converter (`"node"` into a `Str`), so a call whose method is
    /// bound only after monomorphization is converted here, in the body as
    /// written, and every copy carries the converted argument.  A parameter
    /// still naming a type parameter or an unreduced projection
    /// (`(&FilterIter<I>::Item) -> boolean`) is not checked here (passed as invalid,
    /// which `check_args_against_params` skips): its projections are reduced
    /// only in the copies.  A method with type parameters of its own has the
    /// METHOD's arguments stashed, and the owner's from the path or the
    /// template's defaults.  A call with no complete stash is not checked here.
    check_template_static_args(mut &this, visitor: SemaVisitor*, scope: ScopeResolutionNode*,
                               call: CallExprNode*) -> void {
        const func_decl: DeclarationNode* = this.ctx.decl_index.method_func_of(call.template_method);
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null) { return; }
        const tmpl: TemplateEntry* = this.resolve_scope_owner_template(scope);
        if (tmpl == null || tmpl.param_types.length == 0) { return; }
        const no_args: [TypeRef] = [];
        mut owner_args: [TypeRef] = [];
        mut method_args: &[TypeRef] = &no_args;
        if (func.generic_params.length == 0) {
            for (mut i: i64 = 0; i < call.resolved_type_args.length; i++) { owner_args.push(call.resolved_type_args[i]); }
        } else {
            owner_args = this.compute_generic_static_owner_binds(scope, tmpl);
            method_args = &call.resolved_type_args;
        }
        if (owner_args.length != tmpl.param_types.length) { return; }
        mut subst: TypeSubstitution = TypeSubstitution::empty();
        if (!this.path_method_subst(tmpl, call.template_method, &owner_args, method_args, &subst)) { return; }
        mut params: [TypeRef] = [];
        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const p_decl: DeclarationNode* = func.parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p == null || !p.resolved_type.is_valid()) { return; }
            const pt: TypeRef = this.binding.reduce_assoc_projections(subst.apply(p.resolved_type, this.arena));
            const open: boolean = this.types.contains_generic_param(pt) || this.types.contains_unresolved_projection(pt);
            params.push(if (open) { TypeRef::invalid() } else { pt });
        }
        this.check_args_against_params(visitor, &call.arguments, params.as_slice());
    }

    /// Argument check for an impl-qualified call, `(Beta for P)::go(&p)`:
    /// the candidates are the entries `Beta`'s implementation for the owner
    /// delivers under the member's name, whether they take a receiver or
    /// not, and the one of the call's arity is checked argument by
    /// argument; none of its arity is the arity error, naming the arities
    /// the implementation offers.  A head that delivers nothing was refused
    /// where the call resolved, and a trait the head does not name was
    /// refused there too.
    check_impl_qualified_args(mut &this, visitor: SemaVisitor*, owner: FamilyOwner,
                              scope: ScopeResolutionNode*, call: CallExprNode*) -> void {
        if (TypeAnnotation::refused(scope.impl_trait)) { return; }
        const trait_sym: DefId = TypeAnnotation::trait_def(scope.impl_trait);
        if (!trait_sym.is_valid()) { return; }
        const entries: [OverloadId] = this.trait_delivered_entries(owner, trait_sym, scope.member_name);
        this.check_delivered_args(visitor, &entries, scope, call);
    }

    /// The same check for the trait-qualified form, `Beta::go(&p, ..)`: the
    /// owner is the first argument's type and the trait is the scope's own
    /// stamp.  A call with no argument was refused at the pin; an owner the
    /// index holds no name for is left to codegen, as the pin leaves it.
    check_trait_qualified_args(mut &this, visitor: SemaVisitor*, trait_sym: DefId,
                               scope: ScopeResolutionNode*, call: CallExprNode*) -> void {
        if (call.arguments.length == 0) { return; }
        const recv: ExpressionNode* = call.arguments[0];
        if (recv == null || !recv.resolved_type.is_valid()) { return; }
        const owner_ty: TypeRef = this.trait_qualified_owner(recv.resolved_type);
        if (!this.ctx.decl_index.lookup_type_name(owner_ty).is_valid()) { return; }
        const entries: [OverloadId] = this.trait_delivered_entries(FamilyOwner::Type(owner_ty), trait_sym, scope.member_name);
        this.check_delivered_args(visitor, &entries, scope, call);
    }

    /// Argument check against `entries`, the candidates a trait's
    /// implementation delivers: the one of the call's arity is checked
    /// argument by argument, none of its arity is the arity error naming
    /// the arities offered; no entries at all was reported at the pin.
    check_delivered_args(mut &this, visitor: SemaVisitor*, entries: &[OverloadId],
                         scope: ScopeResolutionNode*, call: CallExprNode*) -> void {
        if (entries.length == 0) { return; }
        const argc: i64 = call.arguments.length;
        mut uniq_arity: i64 = -1;
        mut of_arity: [FunctionType*] = [];
        for (mut i: i64 = 0; i < entries.length; i++) {
            const et: Type* = this.arena.lookup(this.ctx.decl_index.entry_signature(entries[i]));
            if (et == null || et.kind != TypeKind::Function) { continue; }
            const ft: FunctionType* = et.as_function();
            if (ft.is_variadic) { return; }
            uniq_arity = this.diag.note_arity(uniq_arity, ft.param_types.length);
            if (ft.param_types.length == argc) { of_arity.push(ft); }
        }
        if (of_arity.length == 0) {
            this.diag.emit_method_arity_error(call.span, scope.member_name, "method", uniq_arity, argc, false);
            return;
        }
        // Several of the arity are one implementation's overloads: the one
        // the arguments fit is checked, as the inherent static gather does.
        mut chosen: FunctionType* = of_arity[0];
        if (of_arity.length > 1) {
            mut fits: i64 = 0;
            for (mut i: i64 = 0; i < of_arity.length; i++) {
                if (this.args_fit_params_loosely(call, of_arity[i].param_types.as_slice())) {
                    fits += 1;
                    chosen = of_arity[i];
                }
            }
            if (fits != 1) { return; }
        }
        this.check_args_against_params(visitor, &call.arguments, chosen.param_types.as_slice());
    }

    /// Argument type-check for a `Type::method(args)` static call whose callee is
    /// an inherent static method (registered as MethodInfo); checks only when a
    /// single static signature of the call's arity is found.
    check_static_scope_method_args(mut &this, visitor: SemaVisitor*,
                                   scope: ScopeResolutionNode*, call: CallExprNode*) -> void {
        // The pair first, for the same reason as the sibling site above; then
        // the owner the segment names, which is the type by identity (a
        // specialization, a DI key) where the written qualifier is not.
        mut type_ref: TypeRef = this.resolve_generic_scope_type(
            this.types.scope_qualifier_type(scope), scope.scope_generic_args,
            scope.span);
        if (!type_ref.is_valid()) {
            type_ref = this.scope_owner_base_type(scope);
        }
        if (!type_ref.is_valid()) { return; }
        mut t: Type* = this.arena.lookup(type_ref);
        mut owner_ref: TypeRef = type_ref;
        if (t != null && t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t.as_instantiated();
            if (!inst.has_resolved_type()) { return; }
            owner_ref = inst.resolved_type;
            t = this.arena.lookup(inst.resolved_type);
        }
        if (t == null) { return; }
        const named: [DeclarationNode*] = this.ctx.decl_index.methods_named(FamilyOwner::Type(owner_ref), scope.member_name);
        mut methods: [MethodInfo] = [];
        match (t.kind) {
            TypeKind::Struct => { methods = t.as_struct().methods; }
            TypeKind::Class  => { methods = t.as_class().methods; }
            TypeKind::Enum   => { methods = t.as_enum().methods; }
            _ => { return; }
        }
        const argc: i64 = call.arguments.length;
        mut found:     boolean = false;
        mut ambiguous: boolean = false;
        mut variadic_ok: boolean = false;
        mut chosen:    [TypeRef] = [];
        mut name_seen:  i64 = 0;
        mut uniq_arity: i64 = -1;
        for (mut mi: i64 = 0; mi < methods.length; mi++) {
            const m: &MethodInfo = &methods[mi];
            if (!m.is_static) { continue; }
            if (!DeclarationIndex::holds_method(&named, DeclarationNode::with_shape(m.ast_node))) { continue; }
            if (this.method_type_is_variadic(m.function_type)) { variadic_ok = true; continue; }
            name_seen  += 1;
            uniq_arity  = this.diag.note_arity(uniq_arity, m.param_types.length);
            if (m.param_types.length != argc) { continue; }
            if (!found) {
                found = true;
                chosen = [];
                for (mut ci: i64 = 0; ci < m.param_types.length; ci++) { chosen.push(m.param_types[ci]); }
            } else if (!this.types.same_param_sig(chosen.as_slice(), m.param_types.as_slice())) {
                ambiguous = true;
            }
        }
        if (ambiguous) {
            mut fit_count:  i64 = 0;
            mut fit_params: [TypeRef] = [];
            for (mut mi: i64 = 0; mi < methods.length; mi++) {
                const m: &MethodInfo = &methods[mi];
                if (!m.is_static) { continue; }
                if (!DeclarationIndex::holds_method(&named, DeclarationNode::with_shape(m.ast_node))) { continue; }
                if (this.method_type_is_variadic(m.function_type)) { continue; }
                if (m.param_types.length != argc) { continue; }
                if (this.args_fit_params_loosely(call, m.param_types.as_slice())) {
                    fit_count += 1;
                    fit_params = [];
                    for (mut ci: i64 = 0; ci < m.param_types.length; ci++) { fit_params.push(m.param_types[ci]); }
                }
            }
            if (fit_count == 1) { this.check_args_against_params(visitor, &call.arguments, fit_params.as_slice()); }
            return;
        }
        if (found) { this.check_args_against_params(visitor, &call.arguments, chosen.as_slice()); return; }
        if (variadic_ok) { return; }
        if (name_seen > 0) {
            this.diag.emit_method_arity_error(call.span, scope.member_name, "static method", uniq_arity, argc, false);
        }
    }
}
