/// SemaDispatch - the recursion seam
///
/// Collaborators (CallResolver, MemberResolver, PatternResolver, ...) recurse
/// back into the type check through here.  `SemaVisitor::dispatch_node` hands
/// a node to the method for its kind; an expression's is `resolve_expr`, whose
/// answer is left on `state.last_expr_type` and read back here.

namespace compiler::sema::dispatch;

import compiler::ast;
import compiler::ast::node;
import compiler::ast::node::{ ASTNode };
import compiler::sema::sema;
import compiler::sema::sema::{ SemaVisitor };
import compiler::ast::expression;
import compiler::ast::expression::{ ExpressionNode };
import compiler::ast::statement;
import compiler::ast::statement::{ StatementNode };
import compiler::types::type_ref;
import compiler::types::type_ref::{ TypeRef };
import compiler::compilation_context;
import compiler::compilation_context::{ CompilationContext };
import compiler::sema::state;
import compiler::sema::state::{ SemaState };

type struct SemaDispatch {
    ctx:   CompilationContext*;
    state: SemaState*;

    static null() -> SemaDispatch {
        return SemaDispatch { ctx: null, state: null };
    }

    wire(mut &this, ctx: CompilationContext*, state: SemaState*) -> void {
        this.ctx   = ctx;
        this.state = state;
    }

    /// Recurse into an expression and return its resolved type.  Resets the
    /// channel, dispatches the expression (which writes the channel through
    /// `resolve_expr`), then reads it back.
    resolve_expr(mut &this, visitor: SemaVisitor*, e: ExpressionNode*) -> TypeRef {
        if (e == null) { return TypeRef::invalid(); }
        this.state.last_expr_type = TypeRef::invalid();
        visitor.dispatch_node(e);
        return this.state.last_expr_type;
    }

    /// Recurse into a statement (statements carry no return channel).
    dispatch_stmt(mut &this, visitor: SemaVisitor*, stmt: StatementNode*) -> void {
        if (stmt == null) { return; }
        visitor.dispatch_node(stmt);
    }

}
