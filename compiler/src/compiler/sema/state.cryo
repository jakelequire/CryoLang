/// SemaState
///
/// Per-pass MUTABLE state for the semantic-analysis visitor, factored out of the
/// main `SemaVisitor` so the `type struct` collaborators (ScopeManager,
/// CallResolver, SymbolicChecker, ...) can share it by pointer - mirroring how
/// codegen's `VisitorState` is shared across its sub-emitters.
///
/// The IMMUTABLE environment (`arena`, `intern`, `ctx`), the interned-once
/// `this_sym`, and the by-value `checker` stay owned on `SemaVisitor` and are
/// handed to collaborators as pointers via `wire()`.  Only state that is reset
/// or mutated during the walk lives here.
///
/// `SemaState::new()` reproduces the original `TypeCheckVisitor` constructor
/// body minus those env fields.
///
/// Leaf component: owns its fields, holds no back-pointers.

namespace compiler::sema::state;

import compiler::types::type_ref;
import compiler::types::type_ref::{ TypeRef };
import compiler::diag::source_span;
import compiler::diag::source_span::{ SourceSpan };
import compiler::ast;
import compiler::ast::{ TypeAnnotation };
import compiler::ast::node;
import compiler::ast::expression;
import compiler::ast::expression::{ CallExprNode, ExpressionNode, LambdaExprNode };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::ast::declaration;
import compiler::ast::declaration::{ FunctionDeclNode, GenericParamNode, ImplBlockNode };
import compiler::resolver::res;
import compiler::resolver::res::{ DefKey };
import compiler::decl_index::{ OverloadId };
import compiler::resolver::symbol_id;
import compiler::resolver::symbol_id::{ SymbolID };
import std::collections::hashmap;
import std::collections::hashmap::{ HashMap };

/// A function's copy specialized for the capturing closures one call
/// passes: each argument position a closure is passed at, and the closure's
/// type there.
type struct ClosureSpec {
    positions: i64[];
    types:     TypeRef[];
    entry:     OverloadId;

    /// Whether this copy is the one for closures of `types` at `positions`,
    /// compared by identity.
    binds(&this, positions: &i64[], types: &TypeRef[]) -> boolean {
        if (this.positions.length != positions.length) { return false; }
        for (mut i: i64 = 0; i < positions.length; i++) {
            if (this.positions[i] != positions[i]) { return false; }
            if (!this.types[i].equals(types[i])) { return false; }
        }
        return true;
    }
}

type struct SemaState {
    // -- Per-function locals (reset via ScopeManager.enter_function) --
    ![allow(lookup_by_spelling, reason = "a scope rib: a function's locals are bound by the names written for them")]
    locals:         HashMap<u32, TypeRef>;   // local variable scope (fast path)
    ![allow(lookup_by_spelling, reason = "a scope rib: a function's locals are bound by the names written for them")]
    local_muts:     HashMap<u32, boolean>;   // mutability flag for each local
    // Span of the declaring `const`/`mut` keyword (top-level locals) or a
    // zero-width insertion anchor (params declared without `mut`).  E0218
    // reads this for a precise "replace `const` with `mut`" / "insert `mut`"
    // quickfix; a missing entry means the explanatory note only.
    ![allow(lookup_by_spelling, reason = "a scope rib: a function's locals are bound by the names written for them")]
    local_kw_spans: HashMap<u32, SourceSpan>;
    undo_keys:      u32[];                    // scope undo log: keys modified
    undo_prev:      TypeRef[];                // scope undo log: previous values
    undo_muts:      boolean[];                // scope undo log: previous mut flags
    undo_kw_spans:  SourceSpan[];             // scope undo log: previous kw_spans

    // -- Per-function frame --
    return_type:     TypeRef;                 // current function return type
    return_type_ann: TypeAnnotation*;         // current return-type annotation (secondary spans)
    // Inside the `poll` an `async fn` was lowered into, this is that function's
    // declared Output — the `Poll<Output>` return peeled back to what the source
    // said. `?` is judged against it, because the body being walked is the
    // async function's, written against `Output`, not `Poll<Output>`.
    // Invalid in any function that is not such a `poll`.
    async_poll_output: TypeRef;
    this_type:       TypeRef;                 // current method receiver type (invalid for static)
    this_is_mut:     boolean;                 // method has `mut &this`
    // Type whose method body we're inside, regardless of static-ness.  Matches
    // `this_type` for non-static methods; for static methods `this_type` is
    // invalid but this still names the owner so visibility checks recognize
    // `Foo::static_method` as "inside Foo".  Invalid outside any method body.
    current_owner_type: TypeRef;
    body_count:      i64;                     // counter for debug output

    // -- Loop nesting (break/continue validation) --
    loop_depth:   i32;

    // -- Expected-type hint (set by DeclStmt for initializer resolution) --
    expected_type: TypeRef;

    // -- The binding an unannotated declaration's initializer flows into --
    // A value that needs an expected type names this binding in its help
    // line; `untyped_init` is the initializer itself, so a value nested in
    // it (an argument) is not mistaken for the whole.
    untyped_binding: SymbolStr;
    untyped_init:    ExpressionNode*;

    // -- Match-arm payload binding names (intern ids), per function --
    // A `match` arm pattern `Variant(p)` binds `p` to a temporary copy of the
    // matched payload; returning a pointer/reference to `p` dangles once the
    // function returns.  These ids let the return-escape check reject that
    // (E0455) instead of miscompiling into a use-after-free.
    payload_binding_ids: u32[];
    // The subset of the bindings above whose subject is reached through a
    // by-reference parameter (`match (&this)`, `match (ptr_param)`).  Such a
    // binding names the CALLER's storage rather than a copy in this frame, so
    // `&binding` stays valid after the function returns and the escape check
    // above must not reject it - that is what an in-place accessor
    // (`payload_ptr(&this) -> T*`) is.  Kept as a separate set rather than by
    // suppressing the entry above, because the payload-escape check has its own
    // reason to know a name is a payload binding.
    alias_binding_ids: u32[];
    // True while inside a method whose receiver is `&this` / `mut &this`.  A
    // by-value `this` receiver lives in THIS frame, so it is not caller-backed.
    this_is_by_ref: boolean;
    // The binding of the method's receiver parameter - what every use of
    // `this` in the body names.  Invalid outside a method.
    receiver_sym: SymbolID;
    // The current function's parameter (and `this`) names.  Autoref'd /
    // caller-backed, so `&param` re-borrows caller storage rather than escaping
    // a stack slot - the return-escape check flags only `&<body-local>`.
    param_ids: u32[];
    // The function whose body is being checked; null outside one.
    current_func: FunctionDeclNode*;
    // The last call whose arguments were classified, and the parameter types
    // they were classified against - one per argument position, the receiver
    // excluded, as sema itself aligned them.  Kept only under `--emit=facts`,
    // where the call's record reads them once the call is resolved.
    facts_call:   CallExprNode*;
    facts_params: TypeRef[];
    // Every local declared with an initializer, by its symbol's key, to its
    // declaration; a record reads where a local's value came from here.
    ![allow(lookup_by_spelling, reason = "the `--emit=facts` report's scratch, keyed by a binding's number; it is deleted with the report")]
    facts_inits:  HashMap<u64, u64>;
    // The loop depth each of those locals is declared at.
    ![allow(lookup_by_spelling, reason = "the `--emit=facts` report's scratch, keyed by a binding's number; it is deleted with the report")]
    facts_depths: HashMap<u64, u64>;

    // -- Closure-capture detection (mutated by LambdaSynth, read by resolve_identifier) --
    // `in_lambda_depth`: 0 outside any lambda, 1 inside the outermost, deeper
    // when nested; gates the capture-fallback path so non-lambda calls never pay.
    // `lambda_outer_locals`: names visible from outside the lambda currently
    // being checked (enclosing function locals + outer lambdas' captures); a hit
    // here on a `locals` miss means "free variable, record a capture".
    // `current_lambda`: the lambda whose body we're walking - the capture sink.
    in_lambda_depth:     i32;
    ![allow(lookup_by_spelling, reason = "a scope rib: the names visible from outside the lambda being checked")]
    lambda_outer_locals: HashMap<u32, TypeRef>;
    current_lambda:      LambdaExprNode*;

    // Per-module monotonic counter for synthesised closure-struct names.
    // Cross-module uniqueness comes from the namespace prefix; never reset.
    closure_counter: u64;
    // A free function's copies specialized for capturing closures, one per
    // (function, the closures' positions and types), so every call passing
    // the same closures is pinned to one copy.  Keyed by the function's
    // definition; a key's copies are told apart by `ClosureSpec::binds`.
    closure_specs:     ClosureSpec[];
    closure_spec_keys: HashMap<DefKey, i64[]>;

    // Re-entrancy guard for implicit-conversion synthesis: set while re-resolving
    // a synthesized `converter(arg)` call so its own args don't re-trigger a
    // conversion attempt (and converter-aware method selection doesn't recurse).
    in_implicit_conversion: boolean;


    // Monotonic counter for the synthetic bindings introduced when lowering `?`
    // to a `match` (build_try_desugar); a unique suffix keeps nested `?` readable.
    try_counter: u32;

    // -- Symbolic generic-body check --
    // True only while a symbolic generic-body walk is in progress.
    in_symbolic_check: boolean;
    // True while symbolically checking a method of a GENERIC owner: owner-rooted
    // field/method accesses (`this.field`) are deferred - concrete monos re-check.
    symbolic_owner_is_generic: boolean;
    // The OWNER type's generic-param AST nodes (`Box<T>`'s `T`), declaration
    // order = abstract-param index.
    symbolic_owner_param_nodes: GenericParamNode*[];
    // The CURRENT method/free-fn's own generic-param AST nodes; separate 0-based
    // index space from the owner list.
    symbolic_method_param_nodes: GenericParamNode*[];
    // The impl block whose method body is currently symbolically walked (the AST
    // outlives the visitor).  Recovers an in-scope param's where-clause bounds
    // (`T: Display`) which an abstract receiver type does not carry.
    symbolic_impl_node: ImplBlockNode*;
    // The function/method whose body is currently symbolically walked.  A
    // method/free-fn `where T: Display` clause lands in
    // `FunctionDeclNode.trait_bounds`, recovered from here for abstract receivers.
    symbolic_current_func: FunctionDeclNode*;
    // The trait whose default methods are being walked.  `This` in such a body
    // is any type implementing that trait, so the trait is `This`'s bound; no
    // where-clause writes it, and one `This` placeholder serves every trait,
    // so the placeholder itself cannot say which trait bounds it.
    symbolic_trait: TypeRef;
    // The parameters the `static match` arms being walked narrow, innermost
    // last, each beside the type its arm listed: inside such an arm a type
    // naming the parameter is that type.
    symbolic_narrow_syms:  SymbolID[];
    symbolic_narrow_types: TypeRef[];
    // Telemetry (debug-only): generic bodies walked, and real errors emitted.
    symbolic_bodies_walked:    i64;
    symbolic_total_would_emit: i64;

    // -- Recursion seam (side-channel) --
    // The expression return channel.  `SemaVisitor.resolve_expr` is the
    // authoritative `match`-on-kind dispatch; each `override visit(SomeExpr*)`
    // stashes its result here, and a collaborator recursing via
    // `dispatch.resolve_expr(visitor, child)` reads it back.  Avoids importing
    // the concrete `SemaVisitor` into collaborators (keeps the graph acyclic),
    // and avoids touching the live shared `BaseASTVisitor` vtable.
    last_expr_type: TypeRef;

    static new() -> SemaState {
        return SemaState {
            locals:         HashMap::<u32, TypeRef>::new(),
            local_muts:     HashMap::<u32, boolean>::new(),
            local_kw_spans: HashMap::<u32, SourceSpan>::new(),
            undo_keys:      [],
            undo_prev:      [],
            undo_muts:      [],
            undo_kw_spans:  [],
            return_type:       TypeRef::invalid(),
            return_type_ann:   null,
            async_poll_output: TypeRef::invalid(),
            this_type:       TypeRef::invalid(),
            this_is_mut:     false,
            current_owner_type: TypeRef::invalid(),
            body_count:      0,
            loop_depth:   0,
            expected_type: TypeRef::invalid(),
            untyped_binding: SymbolStr::empty(),
            untyped_init:    null,
            payload_binding_ids: [],
            alias_binding_ids: [],
            this_is_by_ref:  false,
            receiver_sym:    SymbolID::invalid(),
            param_ids: [],
            current_func: null,
            facts_call:   null,
            facts_params: [],
            facts_inits:  HashMap::<u64, u64>::new(),
            facts_depths: HashMap::<u64, u64>::new(),
            in_lambda_depth:     0,
            lambda_outer_locals: HashMap::<u32, TypeRef>::new(),
            current_lambda:      null,
            closure_counter:  0,
            closure_specs:     [],
            closure_spec_keys: HashMap::<DefKey, i64[]>::new(),
            in_implicit_conversion: false,
            try_counter: 0,
            in_symbolic_check:           false,
            symbolic_owner_is_generic:   false,
            symbolic_owner_param_nodes:  [],
            symbolic_method_param_nodes: [],
            symbolic_impl_node:    null,
            symbolic_current_func: null,
            symbolic_trait:        TypeRef::invalid(),
            symbolic_narrow_syms:  [],
            symbolic_narrow_types: [],
            symbolic_bodies_walked:    0,
            symbolic_total_would_emit: 0,
            last_expr_type: TypeRef::invalid(),
        };
    }

    /// The entry of the copy of the function at `def_slot` specialized for
    /// closures of `types` at `positions`; invalid when none was made.
    closure_spec(&this, def_slot: DefKey, positions: &i64[], types: &TypeRef[]) -> OverloadId {
        match (this.closure_spec_keys.get_ref(&def_slot)) {
            Option::Some(at) => {
                for (mut k: i64 = 0; k < (*at).length; k++) {
                    const spec: ClosureSpec* = &this.closure_specs[(*at)[k]];
                    if (spec.binds(positions, types)) { return spec.entry; }
                }
            }
            Option::None => { }
        }
        return OverloadId::invalid();
    }

    /// Record `entry` as the copy of the function at `def_slot` specialized
    /// for closures of `types` at `positions`.
    add_closure_spec(mut &this, def_slot: DefKey, positions: i64[], types: TypeRef[], entry: OverloadId) -> void {
        const at: i64[]* = this.closure_spec_keys.get_or_insert(def_slot, []);
        at.push(this.closure_specs.length);
        this.closure_specs.push(ClosureSpec { positions: positions, types: types, entry: entry });
    }
}
