///! Name-Resolution Instrumentation Counter
///!
///! Phase 0 instrumentation for the name-resolution unification effort
///! (`.todo/NAME_RESOLUTION_PLAN.md`).  Pure measurement: every entry point
///! here only bumps a counter, so enabling or disabling it cannot change
///! what the compiler resolves.
///!
///! **Not scaffolding.**  `docs/name-resolution.md` §7.2 mechanism 3 makes
///! `B1 == 0` a permanent gate: the cascade grew for years because nobody
///! could see it growing, and deleting the meter after fixing the leak is how
///! the leak comes back.  Individual SITES are disposable - a site whose
///! fallback has been deleted has nothing left to count - but the module is
///! not.
///!
///! The plan's §3.2 rule 2 splits resolution into two answers, and the
///! counter mirrors that split into two BUCKETS:
///!
///!   B1 - path re-derivation.  A stage recomputing, from a string, an
///!        answer the resolver already produced.  Every B1 site must read
///!        ZERO before Phase 5 deletes the fallback that feeds it.
///!   B2 - type-dependent lookup.  Resolution that genuinely needs a
///!        receiver type (method/trait selection, associated-item
///!        projection).  Expected to stay nonzero forever; enumerated and
///!        justified rather than eliminated.
///!
///! Bucket labels here are the plan's current reading and are expected to
///! be revised once `docs/name-resolution.md` settles them.  The counter
///! records SITES; the bucket is only a report-time annotation.
///!
///! Counting is unconditional - a global array increment is cheaper than
///! the branch that would guard it, and always-on counting removes any
///! init-ordering question.  Only the REPORT is gated, on
///! `CRYO_RESOLVE_COUNTER=1`.
///!
///! Two caveats on any reading this produces:
///!   - Counters are per-PROCESS.  Multiprocess codegen (`>= 16` modules,
///!     see `CODEGEN_MULTIPROC_MIN_MODULES` in `instance.cryo`) loses child
///!     tallies, so a baseline run must pin `CRYO_CODEGEN_THREADS=1`.
///!   - Increments are not atomic.  Any threaded phase makes counts
///!     approximate, never exact.

namespace Compiler::ResolveCounter;

import std::fmt;
import std::env;
import std::collections::str;

// ---- Storage -----------------------------------------------------------

/// Capacity of the tally array.
///
/// A `Site` whose index reaches this reports 0 while never being measured, and
/// a zero that was never recorded is indistinguishable from a real one - the
/// same trap `is_candidate_public` defaulting to `true` sets.  Capacity being
/// "obviously large enough" is not a safeguard: it stood at 64 against 67
/// variants, so the three `Scope*` tier rows read 0 from the day they were
/// added, and the B1 gate would have accepted the resulting `M4 267 -> 0` as
/// progress.  `g_tally_dropped` below is the safeguard, because it counts the
/// event rather than restating the intent.
const TALLY_CAP: i64 = 256;

/// Per-site tallies.  Zero-initialized in BSS; indexed by `Site`.
mut g_tally: u64[256];

/// Bumps discarded because the site's index was outside `g_tally`.
///
/// Detects exactly the false zeros: a site past the end that WOULD have fired
/// increments this, while one that never fires has a genuine 0 either way.
/// Nothing here is hand-maintained, so it cannot rot the way the capacity did.
mut g_tally_dropped: u64 = 0;

/// Suspend depth.  Non-zero means "a measurement is currently re-running
/// production lookups; record nothing".
mut g_suspend: i32 = 0;

/// Per-stream tri-state env cache: 0 unknown, 1 on, 2 off.  Indexed by
/// `Audit`.  Cached because these hooks run inside the hottest lookup in the
/// compiler and an `env::var` per call would dominate the measurement.
mut g_audit_state: i32[8];

const AUDIT_CAP: i64 = 8;

// ---- Sites -------------------------------------------------------------

/// One counted resolution OUTCOME.
///
/// An enum rather than a block of `const i64` indices, for two reasons that
/// both bit this module in practice:
///
///   - the old `RC_SITE_COUNT` bound was hand-maintained, and a new constant
///     added past it made `bump` silently no-op.  A counter reading zero
///     because it was never recorded is indistinguishable from a real zero,
///     which is the same trap as `is_candidate_public` defaulting to `true`
///     (§8.1 landmine).  The bound is now the array capacity.
///   - `label()` and `bucket()` below are exhaustive `match`es, so a new
///     variant cannot be added without giving it a report row.  That is
///     §7.2 mechanism 1 applied to the counter itself.
///
/// Declaration order is the storage order and is otherwise arbitrary; nothing
/// persists tallies across runs, so variants may be regrouped freely.
type enum Site {
    // `types/resolver.cryo` resolve_named cascade.  One site per OUTCOME, so
    // the tally shows which step actually answered rather than which steps
    // were attempted.  §2.3 of the plan.
    RnCalls;
    RnGenericBinding;
    RnAssocProjection;
    RnPrimitive;
    RnHomeModule;
    RnHomeModuleSyntax;
    RnAmbiguous;
    RnDiLiteral;
    RnDiCanonical;
    RnDiBare;
    RnArenaBootstrap;
    RnScopeArenaBootstrap;
    RnLeafIndex;
    RnFailed;

    // `sema/call_resolver.cryo` resolve_method_call.  B2's bulk: dispatch that
    // genuinely needs the receiver's type, and cannot move into the resolver
    // (§6.2).  One site per OUTCOME, same as the resolve_named cascade above,
    // because the question these answer is the same one - "which mechanism
    // actually answered" - and a total cannot distinguish a receiver-typed
    // lookup from a retry after one missed.
    McCalls;
    McOwnerSymbolic;
    McOwnerTemplate;
    McAbstractReceiver;
    McNoTypeSym;
    McInheritance;
    McBoundsPostSym;
    McTraitImpls;
    McFieldFn;
    McCopyDrop;
    McDerefCoercion;
    McFailed;

    // `types/arena.cryo` global leaf index.
    LeafCalls;
    LeafHits;

    // `decl_index.cryo` bare-name alternatives.
    BareAltsCalls;
    BareAltsHits;
    BareAltsMulti;
    BareAltsViaScoped;
    BareAltsViaCanonical;
    BareAltsViaAmbigDiag;

    // Visibility-gate blast radius.
    VisFastpath;
    VisWouldReject;
    VisRejectUnreachable;
    VisRejectNotPublic;

    // Where the SCOPE-call lane's use site came from (`Pair` in `Pair::new`).
    // The rows above say what a gate would reject; these say whose namespace it
    // would have been judged against, which is the half that decides whether a
    // rejection is a defect in the source or an artifact of the caller.  Diff is
    // the one to read: it counts the scope names whose writing module and
    // ambient cursor disagree, i.e. exactly the set the cursor was mis-judging.
    ScopeUseSyntax;
    ScopeUseCursor;
    ScopeUseDiff;

    // A default type argument expanded with no owning module on its template,
    // so it resolved against the caller instead of the file it was written in.
    DefaultArgNoOwner;

    // Leaf-index consumers, bumped on a HIT (an answer actually produced).
    LeafViaResolveNamed;
    LeafViaResolverBound;
    LeafViaSymbolicCheck;
    LeafViaTypeUtils;
    LeafViaTypeResBound;
    LeafViaTypeResBase;

    // Free-function bare-call binder.  Counted apart because they need
    // different fixes: D-A is a missing check, D-B is a missing input.
    // SingleHidden is the D-A blast radius; PrivateBound is D-B's (it counts
    // binds in ANY branch, so it is not a subset of Single).  UnscopedRet is
    // a SECOND door - `resolve_direct_call`'s fallback to the program-wide
    // bare `func_returns` map, which has no owner column and therefore no
    // scope input whatsoever.  One pins the SYMBOL, the other supplies the
    // TYPE, and a call can be answered by either alone.
    FnBindSingle;
    FnBindSingleHidden;
    FnBindPrivateBound;
    FnBindUnscopedRet;

    // Where the bare-call binder's USE SITE came from.  Every scope and
    // visibility verdict above is relative to a use site, so these say whether
    // those verdicts were computed against the module that wrote the call or
    // against the ambient cursor.  UseDiff is the one to read: it counts the
    // calls where the two disagree, i.e. exactly the population the cursor was
    // mis-judging.  Reading SingleHidden without it repeats §8.1e - a violation
    // count says what a gate would CATCH, never what it would BREAK.
    FnBindUseSyntax;
    FnBindUseCursor;
    FnBindUseDiff;

    // ENFORCED (spec §3.3, §8.1e): calls rejected as cross-module `private`.
    // Unlike the rows above this one is not a blast radius - it is the gate
    // firing.  A NON-zero value is only correct if every event is a real
    // violation; read it with the corpus, never on its own.
    FnBindVisReject;
    // ...broken down by WHICH of the doors in §8.1e caught it.  Qualified is
    // the written path, Single the bare binder's one-candidate fast path,
    // Plural its multi-candidate selection, RetLane the separate door that
    // supplies a return TYPE from the owner-less bare map.
    FnBindVisQualified;
    FnBindVisSingle;
    FnBindVisPlural;
    FnBindVisRetLane;
    // ...and the two VALUE doors.  A function named without being called is
    // not offered to the gate by any call path, so these two lanes ask for
    // themselves: Bare is `f = leaf`, Qual is `f = Ns::Mod::leaf`.
    FnBindVisValueBare;
    FnBindVisValueQual;

    // ENFORCED: METHOD calls rejected as non-public (E0353), and which lane
    // caught it.  Member is the receiver-access lane, Static the `Type::m()`
    // one - which reached no gate at all until it was named here, because
    // `enforce_method_visibility` was only ever called from member access.
    MethodVisReject;
    MethodVisMember;
    MethodVisStatic;

    // Where a BODY's type-annotation context got its home module (§8, task #7).
    // `body_res_ctx` answers "which module wrote this annotation".  Inside a
    // method the owner type's module answers it; outside one there was no
    // answer at all and it read the ambient cursor.  Syntax/Cursor say which
    // input was available; Diff counts the annotations where the span-derived
    // module and the cursor DISAGREE - i.e. exactly the set the cursor was
    // getting wrong.  Read Diff, not Cursor: a large Cursor with a zero Diff
    // means the cursor was right every time, which is the null result.
    BodyNsOwner;
    BodyNsSyntax;
    BodyNsCursor;
    BodyNsDiff;

    // Ambient-cursor divergence (§2b, §5.2), measured where the true scope is
    // KNOWN: the home-module preference step.  There a caller has said which
    // module the annotation was written in, so the module-blind chain can be
    // re-run and compared.  §6's caveat is that the cursor contaminates any
    // measurement of itself; this is the one place that is not true.
    //
    // Read CursorSame/CursorDiff FIRST.  A comparison where home and cursor
    // are the same module proves nothing - one scope was in play, so
    // agreement is forced.  DiffPlural is the control on that control: scope
    // can only change an answer when the leaf has more than one declaring
    // module.  With DiffPlural at zero, a zero Diverge says nothing about
    // scope; it says the corpus has no collisions.
    HomeCursorSame;
    HomeCursorDiff;
    HomeDiffPlural;
    HomeAgree;
    HomeDiverge;
    HomeBlindMiss;

    // What remains of the namespace-suffix matchers.  M1 is a CHECK: it
    // validates an answer already chosen against the qualifier the source
    // wrote.  It produces no binding of its own, which is why its rows are
    // flagged but never summed into B1.
    M1AgreeCalls;
    M1AgreeHits;
    // The check's two negative outcomes, which its `hits` row cannot show:
    // a rejection, and a leaf that never resolved so the check was not asked.
    M1QualReject;
    M1LeafMiss;
    // Coverage of the annotation stamp, per outcome.  Nothing reads the stamp
    // yet, so these say what a consumer WOULD be able to rely on: `Seen` is the
    // population, and everything below `Def`/`GenericParam` is a name the
    // annotation lane still has to resolve for itself.
    AnnResSeen;
    AnnResDef;
    AnnResGenericParam;
    AnnResQualified;
    AnnResNoHome;
    AnnResNoHomeScope;
    AnnResUnresolved;
    M2Calls;
    M4Calls;
    M4Hits;
    M5Calls;
    M5Hits;
    ScopeDeclOverImport;
    ScopeImportShadowed;
    ScopeAmbigRetracted;

    // Module-scope `Res`, stamped on the node by NameResolution and read back
    // instead of re-derived.  The three non-answers are classified rather than
    // summed: a bare count of "not stamped" cannot separate a segment that
    // names a TYPE (nothing to stamp, and not this lane's question) from one
    // that names a module the writing file cannot see (which IS this lane's
    // question, and today resolves anyway).
    ScopeResStamped;
    ScopeResNoModule;
    ScopeResUnreachable;
    ScopeResAmbiguous;
    M2ViaStamp;
    M2StampMemberMiss;

    /// Of `BareAltsViaCanonical`, the calls that actually FOLDED - one
    /// candidate, and its qualified form differs from the name handed in.
    ///
    /// The call row cannot stand in for this one: it is bumped on entry, so it
    /// counts attempts, while a bucket total counts answers produced.  A call
    /// that hands its input back changed nothing and is what the caller would
    /// have used anyway.
    BareAltsCanonFolded;

    /// `ScopeResNoModule`, split by whether the segment bound to anything in
    /// the writer's scope.  The two halves are different answers, not one
    /// silence: a segment that binds names a TYPE, and the type layer owning
    /// the rest of the path is a positive claim; a segment that binds to
    /// nothing while no module carries the spelling has no owner to name.
    /// Recording them as one number is what would let a failed lookup be
    /// laundered into an ownership claim.
    ScopeResTypeScope;
    ScopeResNoBind;

    /// Of `ScopeResNoBind`, the segments that are themselves module-rooted
    /// paths and were WALKED to the type they name, rather than recorded as
    /// type-owned on the strength of binding nowhere.  Counted apart from the
    /// bucket it came out of so that the walk going quiet - which would put
    /// those segments straight back into `ScopeResNoBase` - is visible as a
    /// number rather than as a later crash.
    ScopeResWalked;

    /// Segments that reached the end of every way of naming a type and matched
    /// none of them, so no base could be recorded and the slot stays
    /// unanswered.  This is the population that MUST be zero: a segment here
    /// names nothing the program declares, and a later stage requiring its
    /// answer is what reports it.
    ScopeResNoBase;

    /// Exits that leave the slot `Pending` because this pass has no inputs to
    /// answer from: no module graph, or a span naming no module (the
    /// fingerprint of a synthesized node, whose synthesizer owes it a `Res`).
    /// Separated from the classified answers because these are the population
    /// the delayed-bug flush reports on, and a bucket that mixes them with a
    /// real answer cannot say whether the flush is silent for a good reason.
    ScopeResUnanswerable;

    /// Of `AnnResQualified`, the ones whose FIRST segment names a type or a
    /// generic parameter, so the type layer owns the remainder.  Counted apart
    /// from the module-path remainder because the two have opposite owners, and
    /// a single "qualified" total says nothing about which lane owes an answer.
    AnnResTypeRelative;
}

implement enum Site {
    /// Record one occurrence.
    ///
    /// Out-of-range is ignored rather than trapping: instrumentation must
    /// never be able to abort a build.
    bump(&this) -> void {
        if (g_suspend > 0) { return; }
        const i: i64 = this as i64;
        if (i < 0 || i >= TALLY_CAP) {
            g_tally_dropped = g_tally_dropped + 1;
            return;
        }
        g_tally[i] = g_tally[i] + 1;
    }

    /// Read the tally back.  Used by the report and by tests.
    count(&this) -> u64 {
        const i: i64 = this as i64;
        if (i < 0 || i >= TALLY_CAP) { return 0; }
        return g_tally[i];
    }

    /// The report bucket this site belongs to.  `"B1"` must reach zero,
    /// `"B2"` stays, `"B3"` is authoritative, `"  "` is context-only and
    /// `"!!"` flags a violation row.
    ///
    /// A trailing `*` qualifies the row's membership, and means something
    /// different in each family because the families are asserted differently:
    /// on a B1 row it marks a site that is NOT a summand (it nests inside
    /// another B1 row, so summing both double-counts); on a B3 row it marks a
    /// site the gate pins ANYWAY, against the rule that B3 is context-only.
    /// A B3 row is normally unasserted because B3's target is "once per path"
    /// rather than a fixed number, and pinning one would make the gate noisy;
    /// the exception exists for a site that left B1 while still being able to
    /// regrow into a binding path, where dropping the row would replace a
    /// reachable target with a blind spot.
    ///
    /// Exhaustive on purpose: a new site cannot be added without classifying
    /// it.
    bucket(&this) -> string {
        return match (this) {
            Site::RnCalls               => { "   " }
            Site::RnGenericBinding      => { "B3 " }
            Site::RnAssocProjection     => { "B2 " }
            Site::McCalls               => { "   " }
            Site::McOwnerSymbolic       => { "B2 " }
            Site::McOwnerTemplate       => { "B2 " }
            Site::McAbstractReceiver    => { "B2 " }
            Site::McNoTypeSym           => { "   " }
            Site::McInheritance         => { "B2 " }
            Site::McBoundsPostSym       => { "B2 " }
            Site::McTraitImpls          => { "B2 " }
            Site::McFieldFn             => { "B2 " }
            Site::McCopyDrop            => { "B2 " }
            Site::McDerefCoercion       => { "B2 " }
            Site::McFailed              => { "   " }
            Site::RnPrimitive           => { "B3 " }
            Site::RnHomeModule          => { "B1 " }
            Site::RnHomeModuleSyntax    => { "B3 " }
            Site::RnAmbiguous           => { "B1 " }
            Site::RnDiLiteral           => { "B3 " }
            Site::RnDiCanonical         => { "B3 " }
            Site::RnDiBare              => { "B3 " }
            Site::RnArenaBootstrap      => { "B1 " }
            Site::RnScopeArenaBootstrap => { "B1 " }
            Site::RnLeafIndex           => { "B1*" }
            Site::RnFailed              => { "   " }
            Site::LeafCalls             => { "B1 " }
            Site::LeafHits              => { "B1 " }
            Site::BareAltsCalls         => { "   " }
            Site::BareAltsHits          => { "   " }
            Site::BareAltsMulti         => { "   " }
            Site::BareAltsViaScoped     => { "B3 " }
            Site::BareAltsViaCanonical  => { "B3*" }
            Site::BareAltsViaAmbigDiag  => { "B1 " }
            Site::ScopeUseSyntax        => { "   " }
            Site::ScopeUseCursor        => { "   " }
            Site::ScopeUseDiff          => { "   " }
            Site::DefaultArgNoOwner     => { "!! " }
            Site::VisFastpath           => { "   " }
            Site::VisWouldReject        => { "!! " }
            Site::VisRejectUnreachable  => { "   " }
            Site::VisRejectNotPublic    => { "   " }
            Site::LeafViaResolveNamed   => { "   " }
            Site::LeafViaResolverBound  => { "   " }
            Site::LeafViaSymbolicCheck  => { "   " }
            Site::LeafViaTypeUtils      => { "   " }
            Site::LeafViaTypeResBound   => { "   " }
            Site::LeafViaTypeResBase    => { "   " }
            Site::FnBindSingle          => { "   " }
            Site::FnBindSingleHidden    => { "!! " }
            Site::FnBindPrivateBound    => { "!! " }
            Site::FnBindUnscopedRet     => { "B1 " }
            Site::FnBindUseSyntax       => { "   " }
            Site::FnBindUseCursor       => { "   " }
            Site::FnBindUseDiff         => { "   " }
            Site::FnBindVisReject       => { "!! " }
            Site::FnBindVisQualified    => { "   " }
            Site::FnBindVisSingle       => { "   " }
            Site::FnBindVisPlural       => { "   " }
            Site::FnBindVisRetLane      => { "   " }
            Site::FnBindVisValueBare    => { "   " }
            Site::FnBindVisValueQual    => { "   " }
            Site::MethodVisReject       => { "!! " }
            Site::MethodVisMember       => { "   " }
            Site::MethodVisStatic       => { "   " }
            Site::BodyNsOwner           => { "   " }
            Site::BodyNsSyntax          => { "   " }
            Site::BodyNsCursor          => { "   " }
            Site::BodyNsDiff            => { "   " }
            Site::HomeCursorSame        => { "   " }
            Site::HomeCursorDiff        => { "   " }
            Site::HomeDiffPlural        => { "   " }
            Site::HomeAgree             => { "   " }
            Site::HomeDiverge           => { "!! " }
            Site::HomeBlindMiss         => { "   " }
            Site::M1AgreeCalls          => { "B1 " }
            Site::M1AgreeHits           => { "B1 " }
            Site::M1QualReject          => { "   " }
            Site::M1LeafMiss            => { "   " }
            Site::AnnResSeen            => { "   " }
            Site::AnnResDef             => { "   " }
            Site::AnnResGenericParam    => { "   " }
            Site::AnnResQualified       => { "   " }
            Site::AnnResNoHome          => { "   " }
            Site::AnnResNoHomeScope     => { "   " }
            Site::AnnResUnresolved      => { "   " }
            Site::M2Calls               => { "B1 " }
            Site::M4Calls               => { "B1 " }
            Site::M4Hits                => { "B1 " }
            Site::M5Calls               => { "B1 " }
            Site::M5Hits                => { "B1 " }
            Site::ScopeDeclOverImport   => { "B3 " }
            Site::ScopeImportShadowed   => { "B3 " }
            Site::ScopeAmbigRetracted   => { "B3 " }
            Site::ScopeResStamped       => { "B3 " }
            Site::ScopeResNoModule      => { "   " }
            Site::ScopeResTypeScope     => { "   " }
            Site::ScopeResNoBind        => { "   " }
            Site::ScopeResWalked        => { "   " }
            Site::ScopeResNoBase        => { "!! " }
            Site::ScopeResUnanswerable  => { "!! " }
            Site::AnnResTypeRelative    => { "   " }
            Site::ScopeResUnreachable   => { "!! " }
            Site::ScopeResAmbiguous     => { "!! " }
            Site::M2ViaStamp            => { "B3 " }
            Site::M2StampMemberMiss     => { "!! " }
            Site::BareAltsCanonFolded   => { "B3*" }
        };
    }

    /// The report row label.  Exhaustive: a new site cannot be added without
    /// a line in the report, which is the failure this enum exists to make
    /// impossible.
    label(&this) -> string {
        return match (this) {
            Site::RnCalls               => { "calls (total)" }
            Site::RnGenericBinding      => { "1   generic binding" }
            Site::RnAssocProjection     => { "1b  assoc-type projection (I::Item)" }
            Site::McCalls               => { "calls (total)" }
            Site::McOwnerSymbolic       => { "m1  generic-owner receiver, own template" }
            Site::McOwnerTemplate       => { "m1b generic-owner receiver, via template" }
            Site::McAbstractReceiver    => { "m2  abstract receiver, via bounds" }
            Site::McNoTypeSym           => { "m3* no type sym: branch ENTERED" }
            Site::McInheritance         => { "m5  by name + inheritance (concrete)" }
            Site::McBoundsPostSym       => { "m6  BoundedParam bound, AFTER m5 missed" }
            Site::McTraitImpls          => { "m7  through trait impls" }
            Site::McFieldFn             => { "m8  field holding a function" }
            Site::McCopyDrop            => { "m9  no-op drop on a Copy type" }
            Site::McDerefCoercion       => { "m10 deref coercion, retry on pointee" }
            Site::McFailed              => { "unresolved" }
            Site::RnPrimitive           => { "2   primitive name" }
            Site::RnHomeModule          => { "2c  home-module (ambient cursor)" }
            Site::RnHomeModuleSyntax    => { "2c* home-module (syntax provenance)" }
            Site::RnAmbiguous           => { "2b  ambiguity -> E0203" }
            Site::RnDiLiteral           => { "3a  DI exact qualified literal" }
            Site::RnDiCanonical         => { "3b  DI canonicalized qualified" }
            Site::RnDiBare              => { "3c  DI bare name" }
            Site::RnArenaBootstrap      => { "4   arena (bootstrap-only)" }
            Site::RnScopeArenaBootstrap => { "4a  scope+arena (bootstrap-only)" }
            Site::RnLeafIndex           => { "5   GLOBAL LEAF INDEX  (* in leaf hits)" }
            Site::RnFailed              => { "    unresolved" }
            Site::LeafCalls             => { "lookup_by_leaf calls" }
            Site::LeafHits              => { "lookup_by_leaf hits" }
            Site::BareAltsCalls         => { "lookup_qualified_alternatives calls" }
            Site::BareAltsHits          => { "lookup_qualified_alternatives hits" }
            Site::BareAltsMulti         => { "  of which ambiguous (>1 candidate)" }
            Site::BareAltsViaScoped     => { "  by caller: resolve_qualified_scoped" }
            Site::BareAltsViaCanonical  => { "  by caller: canonical_qualified" }
            Site::BareAltsCanonFolded   => { "    of those, actually folded" }
            Site::BareAltsViaAmbigDiag  => { "  by caller: sema ambiguity diag" }
            Site::ScopeUseSyntax        => { "scope use site from the SYNTAX's own module" }
            Site::ScopeUseCursor        => { "  no provenance: fell back to the cursor" }
            Site::ScopeUseDiff          => { "  syntax != cursor (the mis-judged set)" }
            Site::DefaultArgNoOwner     => { "default arg expanded with NO owning module" }
            Site::VisFastpath           => { "single-candidate fast path taken" }
            Site::VisWouldReject        => { "  WOULD BE REJECTED once gated" }
            Site::VisRejectUnreachable  => { "    cause: namespace not reachable" }
            Site::VisRejectNotPublic    => { "    cause: candidate not public" }
            Site::LeafViaResolveNamed   => { "  by caller: resolve_named step 5" }
            Site::LeafViaResolverBound  => { "  by caller: resolver generic bound" }
            Site::LeafViaSymbolicCheck  => { "  by caller: symbolic_checker" }
            Site::LeafViaTypeUtils      => { "  by caller: sema type_utils" }
            Site::LeafViaTypeResBound   => { "  by caller: type_resolution bound" }
            Site::LeafViaTypeResBase    => { "  by caller: type_resolution base" }
            Site::FnBindSingle          => { "single-overload pins (no scope check)" }
            Site::FnBindSingleHidden    => { "  of those, owner NOT in scope (D-A)" }
            Site::FnBindPrivateBound    => { "bound to a PRIVATE candidate  (D-B)" }
            Site::FnBindUnscopedRet     => { "bare return-type answers, NO scope input" }
            Site::FnBindUseSyntax       => { "use site from the SYNTAX's own module" }
            Site::FnBindUseCursor       => { "  no provenance: fell back to the cursor" }
            Site::FnBindUseDiff         => { "  syntax != cursor (the mis-judged set)" }
            Site::FnBindVisReject       => { "REJECTED: private, cross-module (E0353)" }
            Site::FnBindVisQualified    => { "  door 1: written qualified path" }
            Site::FnBindVisSingle       => { "  door 2: single-overload fast path" }
            Site::FnBindVisPlural       => { "  door 3: multi-candidate selection" }
            Site::FnBindVisRetLane      => { "  door 4: bare return-type lane" }
            Site::FnBindVisValueBare    => { "  door 5b: bare name in value position" }
            Site::FnBindVisValueQual    => { "  door 5a: qualified path, value position" }
            Site::MethodVisReject       => { "REJECTED: non-public method (E0353)" }
            Site::MethodVisMember       => { "  lane: receiver member access" }
            Site::MethodVisStatic       => { "  lane: static `Type::method()` call" }
            Site::BodyNsOwner           => { "body annots: owner type's module" }
            Site::BodyNsSyntax          => { "body annots: the body's OWN file" }
            Site::BodyNsCursor          => { "  no provenance: fell back to the cursor" }
            Site::BodyNsDiff            => { "  syntax != cursor (the mis-judged set)" }
            Site::HomeCursorSame        => { "home == ambient cursor (proves nothing)" }
            Site::HomeCursorDiff        => { "home != ambient cursor (the evidence)" }
            Site::HomeDiffPlural        => { "  of those, leaf declared by >1 module" }
            Site::HomeAgree             => { "  both chains agreed" }
            Site::HomeDiverge           => { "  blind chain binds a DIFFERENT type" }
            Site::HomeBlindMiss         => { "  blind chain answers nothing" }
            Site::M1AgreeCalls          => { "M1 CHECK qualifier_agrees calls" }
            Site::M1AgreeHits           => { "M1 CHECK qualifier_agrees agreed" }
            Site::M1QualReject          => { "  CHECK rejected the leaf answer" }
            Site::M1LeafMiss            => { "  leaf unresolved, CHECK not asked" }
            Site::AnnResSeen            => { "annotations offered to the stamp" }
            Site::AnnResDef             => { "  stamped Def (bare, via home scope)" }
            Site::AnnResGenericParam    => { "  stamped GenericParam" }
            Site::AnnResQualified       => { "  qualified spelling" }
            Site::AnnResTypeRelative    => { "    of which stamped TypeRelative" }
            Site::AnnResNoHome          => { "  UNSTAMPED span names no module" }
            Site::AnnResNoHomeScope     => { "  UNSTAMPED module has no scope" }
            Site::AnnResUnresolved      => { "  UNSTAMPED bare name not in scope" }
            Site::M2Calls               => { "M2 resolve_module_qualified_sym calls" }
            Site::M4Calls               => { "M4 mono bare-name template scan" }
            Site::M4Hits                => { "M4 mono bare-name scan hits" }
            Site::M5Calls               => { "M5 import suffix fallback calls" }
            Site::M5Hits                => { "M5 import suffix fallback hits" }
            Site::ScopeDeclOverImport   => { "declaration took a slot an import held" }
            Site::ScopeImportShadowed   => { "import shadowed by a declaration" }
            Site::ScopeAmbigRetracted   => { "import-vs-import ambiguity retracted" }
            Site::ScopeResStamped       => { "module-scope Res stamped" }
            Site::ScopeResNoModule      => { "  not a module scope (type scope)" }
            Site::ScopeResTypeScope     => { "    of which binds in scope (type)" }
            Site::ScopeResNoBind        => { "    of which binds to NOTHING" }
            Site::ScopeResWalked        => { "      of which WALKED to a type" }
            Site::ScopeResNoBase        => { "      of which named NO type" }
            Site::ScopeResUnanswerable  => { "  left Pending (no inputs)" }
            Site::ScopeResUnreachable   => { "  module NOT visible from writer" }
            Site::ScopeResAmbiguous     => { "  two visible modules match" }
            Site::M2ViaStamp            => { "M2 answered from the stamp" }
            Site::M2StampMemberMiss     => { "  stamped module lacks the member" }
        };
    }

    /// One report row: bucket, label, tally.
    print_row(&this) -> void {
        fmt::eprintf("  %-3s %-46s %12llu\n",
                     this.bucket(), this.label(), this.count());
    }
}

// ---- Suspension --------------------------------------------------------

/// Stop recording until the matching `resume`.
///
/// An instrument that re-runs a production lookup to compare answers would
/// otherwise be counted as if the compiler had really taken that path -
/// `lookup_by_leaf` bumps the leaf sites, and `resolve_type_qualified_name`
/// emits M1 path-audit events.  Both sit underneath the divergence probe, so
/// without this the probe would inflate the exact numbers it exists to put in
/// context.
///
/// Counted, not a flag, so nesting is safe.  `Audit::enabled` honors it too,
/// so a suspended region emits no audit lines either.
public function suspend() -> void { g_suspend = g_suspend + 1; }

public function resume() -> void {
    if (g_suspend > 0) { g_suspend = g_suspend - 1; }
}

// ---- Audit streams -----------------------------------------------------

/// A line-oriented audit stream, each switched on by its own env var.
///
/// Line-oriented on purpose: a run can be piped through `sort -u` to get the
/// distinct set, and the classification can be re-cut offline without a
/// recompile.
///
/// `CRYO_RESOLVE_COUNTER` is deliberately NOT a variant here.  It gates a
/// summary printed once at exit rather than per-event lines, and it must not
/// be suppressed by `suspend` - folding it in would mean a probe region could
/// silently swallow the report.
type enum Audit {
    Leaf;
    Visibility;
    Path;
    Scope;
    Named;
}

implement enum Audit {
    /// The environment variable that switches this stream on.
    var_name(&this) -> string {
        return match (this) {
            Audit::Leaf       => { "CRYO_LEAF_AUDIT" }
            Audit::Visibility => { "CRYO_VIS_AUDIT" }
            Audit::Path       => { "CRYO_PATH_AUDIT" }
            Audit::Scope      => { "CRYO_SCOPE_PROBE" }
            Audit::Named      => { "CRYO_RN_AUDIT" }
        };
    }

    /// Whether this stream is on.  Exposed so a caller can skip building the
    /// strings an audit line needs - interning a namespace is not free, and
    /// these sites sit in the resolution hot path.
    enabled(&this) -> boolean {
        if (g_suspend > 0) { return false; }
        const i: i64 = this as i64;
        if (i < 0 || i >= AUDIT_CAP) { return false; }
        if (g_audit_state[i] == 0) {
            match (env::var(Str::new(this.var_name()))) {
                Option::Some(_) => { g_audit_state[i] = 1; }
                Option::None    => { g_audit_state[i] = 2; }
            }
        }
        return g_audit_state[i] == 1;
    }
}

// ---- Audit emitters ----------------------------------------------------
//
// Free functions rather than methods on `Audit`, deliberately.  A method would
// be callable on any variant - `Audit::Leaf.scope_diverge(...)` would compile
// and then gate a SCOPE-DIVERGE line on `CRYO_LEAF_AUDIT`.  That is a silent
// mis-gating bug of exactly the kind this module exists to catch.  Each
// emitter below names its own stream once, in one place.

/// Log one name that the GLOBAL LEAF INDEX answered, with the module that
/// asked.
public function leaf_hit(use_site: string, name: string) -> void {
    if (!Audit::Leaf.enabled()) { return; }
    fmt::eprintf("LEAF-HIT\t%s\t%s\n", use_site, name);
}

/// Print one would-be-rejected resolution, so a run yields the distinct
/// migration set.
///
/// The site and origin are what make the count readable: `use_site` is whatever
/// namespace the caller supplied, and a caller that supplies the ambient cursor
/// names a module that never wrote the syntax.  Counting rejections without
/// them measures the callers as much as the sources - and the callers disagree,
/// since three of the four pass a cursor by their own contract while one passes
/// a context's home module.
public function vis_violation(use_site: string, cand: string,
                              site_file: string, site_line: i32,
                              origin: string) -> void {
    if (!Audit::Visibility.enabled()) { return; }
    fmt::eprintf("VIS-VIOLATION\t%s\t%s\t%s:%d\t%s\n",
                 use_site, cand, site_file, site_line, origin);
}

/// Print one recorded visibility verdict, so a run can prove the
/// `decl_visibility` map is populated before any conclusion is drawn from a
/// zero rejection count (`is_candidate_public` defaults to `true`, so an
/// unwired recorder and a genuinely-all-public program look identical).
public function vis_record(qualified: string, is_public: boolean) -> void {
    if (!Audit::Visibility.enabled()) { return; }
    const flag: i32 = if (is_public) { 1 } else { 0 };
    fmt::eprintf("VIS-RECORD\t%d\t%s\n", flag, qualified);
}

/// Print one fast-path encounter with a candidate recorded as PRIVATE, tagged
/// with why it was (or was not) let through.  Distinguishes "the gate saw no
/// private candidates" from "the gate never got to look".
public function vis_private(kind: string, use_site: string, cand: string) -> void {
    if (!Audit::Visibility.enabled()) { return; }
    fmt::eprintf("VIS-PRIVATE\t%s\t%s\t%s\n", kind, use_site, cand);
}

/// Print one bare free-function call that bound to a candidate the use site
/// should not be able to name.  `kind` is `HIDDEN` (D-A: not imported) or
/// `PRIVATE` (D-B: imported but not public).
public function fnbind_violation(kind: string, use_site: string,
                                 cand: string) -> void {
    if (!Audit::Visibility.enabled()) { return; }
    fmt::eprintf("FNBIND-VIOLATION\t%s\t%s\t%s\n", kind, use_site, cand);
}

/// Log one call REJECTED by the visibility gate, naming the door it was
/// caught by.
///
/// Emitted at the rejection rather than tallied for the end-of-run report,
/// because a rejected call means the build FAILS, and the report only prints
/// on the success path after link.  Without this, the one measurement that
/// matters for a compile_fail corpus entry - "did the door this case was
/// written for actually fire?" - is unavailable precisely when the case
/// works.  `visibility_gate`'s `stash` is the motivating example: if its
/// second declarer stopped being compiled, the call would silently fall back
/// to the single-overload door and the project would still pass while testing
/// nothing it claims to.
public function vis_gate_reject(door: string, use_site: string,
                                cand: string) -> void {
    if (!Audit::Visibility.enabled()) { return; }
    fmt::eprintf("VIS-GATE\t%s\t%s\t%s\n", door, use_site, cand);
}

/// Log the answer `resolve_named` gave for ONE annotation, naming the cascade
/// step that produced it.
///
/// The end-of-run tally says how many answers each step gave; it cannot say
/// which NAME a step answered, and that is the question a wrong bind poses.
/// `docs/name-resolution.md` §8.2m: a module that declares a leaf it also
/// imports binds the IMPORT in every annotation position, and every existing
/// instrument reads green through it, because they all measure whether the
/// home module was DERIVED correctly rather than what it then RESOLVED to.
///
/// `step` is the cascade label from the report; `home` is the module the
/// annotation was written in as the context knows it (`<none>` when the site
/// never established one); `cursor` is the ambient scope cursor, which is what
/// every step below 2c canonicalizes against; `site` names the caller that
/// built the context; `answer` is the qualified name that won.
///
/// `home` and `cursor` are separate columns because they answer different
/// questions and the difference is the whole finding: on the body-local
/// reproduction the cursor is CORRECT (it names the writing module) and the
/// answer is still the imported type. An instrument reporting only provenance
/// reads green there. Compare with
/// `awk -F'\t' '$2=="3b-di-canonical" && $7 !~ "^"$4"::"'`.
///
/// `site` is what makes a fallback answer actionable: `home=<none>` says a
/// scope is missing, and only the site says which caller has to supply it.
/// Attribute with `awk -F'\t' '$3=="<none>" {print $2"\t"$5}' | sort | uniq -c`.
public function rn_answer(step: string, home: string, cursor: string,
                          site_file: string, site_line: i32,
                          name: string, answer: string) -> void {
    if (!Audit::Named.enabled()) { return; }
    fmt::eprintf("RN\t%s\t%s\t%s\t%s:%d\t%s\t%s\n",
                 step, home, cursor, site_file, site_line, name, answer);
}

/// Log a `set_home_module` call that supplied an EMPTY module while naming a
/// real origin.
///
/// The scope is normalized to `Unset` there, so the context falls into the
/// module-blind chain even though its construction site does establish a scope
/// on every other path.  Grepping for `set_home_module` therefore over-counts
/// the sites that are done: this is the population that call it and still
/// arrive unscoped, and it can only be observed at the call.
public function home_empty(site_file: string, site_line: i32,
                           origin: string) -> void {
    if (!Audit::Named.enabled()) { return; }
    fmt::eprintf("RN-HOME-EMPTY\t%s:%d\t%s\n", site_file, site_line, origin);
}

/// Log a default type argument expanded WITHOUT its template's own module.
///
/// `expand_default_type_args` re-homes on `entry.module_name` because a default
/// annotation is syntax written in the TEMPLATE's file.  When the entry carries
/// no module the re-home is skipped and the default resolves against whichever
/// module asked for the expansion, so one declaration's default binds
/// differently per caller.  A count cannot say WHICH template lost its owner,
/// and the template is the only actionable part.
public function default_arg_no_owner(template: string, fallback_home: string) -> void {
    if (!Audit::Named.enabled()) { return; }
    fmt::eprintf("DEF-ARG-NO-OWNER\t%s\t%s\n", template, fallback_home);
}

/// Log one QUALIFIED PATH that a namespace-suffix matcher resolved, to size
/// the migration §5.1 ("first segment resolves in scope, remainder rooted")
/// implies.  `docs/name-resolution.md` §9 / plan R4.
///
/// Emitted at the DECISION, not inside the matcher.  M1's raw hit count is
/// probes-inside-a-loop (once per export candidate), so it cannot answer "how
/// many written paths need an import" - only one event per accepted path can.
///
/// `written` is the path as the source spelled it; `resolved` is the canonical
/// name it bound to.  The relationship between the two - exact, abbreviated
/// suffix, or a shallower prefix needing a re-export - is what classifies the
/// churn, and it is computed offline from these two strings rather than here,
/// so the classification can be re-cut without a recompile.
public function path_hit(kind: string, use_site: string,
                         written: string, resolved: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("PATH-HIT\t%s\t%s\t%s\t%s\n", kind, use_site, written, resolved);
}

/// Log one module-scope segment that was NOT stamped although some module
/// spells it, naming which of the two refusals fired.
///
/// Emitted at the refusal rather than tallied, for the same reason as
/// `vis_gate_reject`: the end-of-run report prints only after a successful
/// link, and the corpus most likely to name a module its writer cannot see is
/// the compile_fail corpus, which never gets there.  A zero pooled from
/// linking projects alone is a zero measured over the population that by
/// construction has no such case.
///
/// `reason` is `UNREACHABLE` (a module carries the spelling, the writer cannot
/// reach it) or `AMBIGUOUS` (two reachable modules carry it, so the spelling
/// names neither).  `cand` is one matching namespace: the count says how big
/// the case is, only the namespace says what it is.
public function scope_res_refused(reason: string, use_site: string,
                                  written: string, cand: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("SCOPE-RES-REFUSED\t%s\t%s\t%s\t%s\n",
                 reason, use_site, written, cand);
}

/// Log one module-scope segment that WAS stamped.
///
/// The control for `scope_res_refused`'s zero, and the same role `vis_record`
/// plays for `vis_violation`: on a build that does not link there is no
/// end-of-run tally, so "no refusals" and "this lane was never reached" emit
/// exactly the same nothing.  Pair the two counts and the zero becomes
/// readable.
public function scope_res_stamped(use_site: string, written: string,
                                  cand: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("SCOPE-RES-STAMPED\t%s\t%s\t%s\n", use_site, written, cand);
}

/// Log one settled module scope that does not declare the member under its own
/// name - the call resolves to nothing and the caller diagnoses an unknown path.
///
/// Emitted at the event for the same reason as `scope_res_refused`.  The
/// qualified name is what classifies it - a re-export puts the declaration in
/// another namespace, and only the pair says which.
public function scope_res_member_miss(stamped_ns: string, member: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("SCOPE-RES-MEMBER-MISS\t%s\t%s\n", stamped_ns, member);
}

/// Dump one `module -> visible namespace` edge, so the offline classifier can
/// ask the compiler's OWN reachability question ("is this first segment in
/// scope here?") instead of re-deriving it with a regex over import lines,
/// which cannot see the prelude or brace-list items.
public function path_scope(ns: string, visible: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("PATH-SCOPE\t%s\t%s\n", ns, visible);
}

/// Dump one prelude namespace - in scope everywhere, so a path rooted at one
/// needs no import no matter where it is written.
public function path_prelude(ns: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("PATH-PRELUDE\t%s\n", ns);
}

/// Print one annotation whose meaning DEPENDS on having a scope: the module
/// it was written in binds `name` to `home_qn`, the ambient chain binds it to
/// `blind_qn`, and they are not the same type.
public function scope_diverge(home: string, name: string,
                              home_qn: string, blind_qn: string) -> void {
    if (!Audit::Scope.enabled()) { return; }
    fmt::eprintf("SCOPE-DIVERGE\t%s\t%s\t%s\t%s\n", home, name, home_qn, blind_qn);
}

/// Print one body-annotation context where the module that WROTE the body and
/// the ambient cursor name different modules (§8, task #7).
///
/// `file` is carried because the two namespaces alone do not identify the
/// body: the whole point of the divergence is that one module's function is
/// being checked while the walk stands in another, and only the file says
/// which function.  Emitted at the event, so it survives a failing build -
/// see `vis_gate_reject` for why that matters.
public function body_ns_diff(file: string, syntax_ns: string,
                             cursor_ns: string) -> void {
    if (!Audit::Scope.enabled()) { return; }
    fmt::eprintf("BODY-NS\t%s\t%s\t%s\n", file, syntax_ns, cursor_ns);
}

/// Print one MONO-side resolution context, naming (a) the file whose syntax it
/// is about to resolve, (b) the module of the ENTITY the context could derive a
/// home from, and (c) the ambient cursor.
///
/// Mono cannot call `module_ns_of_file`: `compilation_context.cryo` imports
/// `Compiler::Mono::Monomorphizer`, so the reverse edge is a module cycle.  That
/// leaves two candidate mechanisms for the `template` row (spec §8.2l) - derive
/// the home from an entity already in hand (a `TemplateEntry`, an owner type),
/// or plumb a file -> namespace map into mono - and the choice between them is
/// only decidable by measuring whether the entity's module and the file's module
/// ever disagree.  They disagree exactly when a body is written in an impl block
/// that lives in neither the trait's nor the owner type's module.
///
/// `file` is printed raw rather than mapped here, so the file -> namespace step
/// happens offline against each file's own `namespace` declaration - the one
/// derivation that cannot be contaminated by the thing being measured.
/// `home` is what mono actually derived through the graph.  It is printed
/// alongside rather than trusted: an empty `home` on a populated `file` is the
/// signal that the map is not reaching this call site at all, which looks
/// identical to "the change is safe here" if only the totals are read (§4.6).
public function mono_home(kind: string, file: string, entity_ns: string,
                          cursor_ns: string, home: string) -> void {
    if (!Audit::Scope.enabled()) { return; }
    fmt::eprintf("MONO-HOME\t%s\t%s\t%s\t%s\t%s\n", kind, file, entity_ns,
                 cursor_ns, home);
}

// ---- Reporting ---------------------------------------------------------

/// Drop every tally back to zero.  Exists so a driver that compiles more
/// than one unit in a process can attribute counts per unit.
public function reset() -> void {
    for (mut i: i64 = 0; i < TALLY_CAP; i++) {
        g_tally[i] = 0;
    }
    g_tally_dropped = 0;
}

/// Whether `CRYO_RESOLVE_COUNTER` is set in the environment.
public function enabled() -> boolean {
    match (env::var(Str::new("CRYO_RESOLVE_COUNTER"))) {
        Option::Some(_) => { return true;  }
        Option::None    => { return false; }
    }
}

/// Print the tally to stderr.  No-op unless `CRYO_RESOLVE_COUNTER` is set.
///
/// B1 total is the number the unification effort drives to zero; it is
/// printed last so it is the final thing on screen.
public function report() -> void {
    if (!enabled()) { return; }

    fmt::eprintf("\n");
    fmt::eprintf("=============== name-resolution counter ===============\n");
    fmt::eprintf("  B1 = fuzzy fallback        -> must reach ZERO\n");
    fmt::eprintf("  B2 = type-dependent lookup -> stays; enumerate+justify\n");
    fmt::eprintf("  B3 = authoritative lookup  -> once per path, NOT zero\n");
    fmt::eprintf("\n");
    fmt::eprintf("  Sites NEST: cascade step 5 is a subset of leaf-index\n");
    fmt::eprintf("  hits, and bare_alts hits are a subset of its callers'\n");
    fmt::eprintf("  calls.  Totals are taken over a DISJOINT selection and\n");
    fmt::eprintf("  count site events, not distinct resolutions.\n");
    fmt::eprintf("\n");

    // Printed FIRST, and loudly: every row below is unreadable while this is
    // non-zero, because the rows that lost their bumps still print a plausible
    // 0.  A gate comparing those zeros to a golden would read the blindness as
    // progress rather than as an unmeasured counter.
    if (g_tally_dropped > 0) {
        fmt::eprintf("!! TALLY OVERFLOW: %llu bumps discarded -- a Site index is\n",
                     g_tally_dropped);
        fmt::eprintf("!! outside g_tally (capacity %d).  Rows below may read 0\n",
                     TALLY_CAP);
        fmt::eprintf("!! WITHOUT having been measured.  Raise TALLY_CAP.\n");
        fmt::eprintf("\n");
    }

    fmt::eprintf("-- resolve_named cascade (types/resolver.cryo:1324) ----\n");
    Site::RnCalls.print_row();
    Site::RnGenericBinding.print_row();
    Site::RnAssocProjection.print_row();
    Site::RnPrimitive.print_row();
    Site::RnHomeModule.print_row();
    Site::RnHomeModuleSyntax.print_row();
    Site::RnAmbiguous.print_row();
    Site::RnDiLiteral.print_row();
    Site::RnDiCanonical.print_row();
    Site::RnDiBare.print_row();
    Site::RnArenaBootstrap.print_row();
    Site::RnScopeArenaBootstrap.print_row();
    Site::McCalls.print_row();
    Site::McOwnerSymbolic.print_row();
    Site::McOwnerTemplate.print_row();
    Site::McAbstractReceiver.print_row();
    Site::McNoTypeSym.print_row();
    Site::McInheritance.print_row();
    Site::McBoundsPostSym.print_row();
    Site::McTraitImpls.print_row();
    Site::McFieldFn.print_row();
    Site::McCopyDrop.print_row();
    Site::McDerefCoercion.print_row();
    Site::McFailed.print_row();
    Site::RnLeafIndex.print_row();
    Site::RnFailed.print_row();

    fmt::eprintf("\n-- global leaf index (types/arena.cryo:1023) ----------\n");
    Site::LeafCalls.print_row();
    Site::LeafHits.print_row();
    Site::LeafViaResolveNamed.print_row();
    Site::LeafViaResolverBound.print_row();
    Site::LeafViaSymbolicCheck.print_row();
    Site::LeafViaTypeUtils.print_row();
    Site::LeafViaTypeResBound.print_row();
    Site::LeafViaTypeResBase.print_row();

    fmt::eprintf("\n-- DeclarationIndex bare_alts (decl_index.cryo:1405) --\n");
    Site::BareAltsCalls.print_row();
    Site::BareAltsHits.print_row();
    Site::BareAltsMulti.print_row();
    Site::BareAltsViaScoped.print_row();
    Site::BareAltsViaCanonical.print_row();
    Site::BareAltsCanonFolded.print_row();
    Site::BareAltsViaAmbigDiag.print_row();

    fmt::eprintf("\n-- visibility gate blast radius (spec §8.1) -----------\n");
    Site::ScopeUseSyntax.print_row();
    Site::ScopeUseCursor.print_row();
    Site::ScopeUseDiff.print_row();
    Site::DefaultArgNoOwner.print_row();
    Site::VisFastpath.print_row();
    Site::VisWouldReject.print_row();
    Site::VisRejectUnreachable.print_row();
    Site::VisRejectNotPublic.print_row();

    fmt::eprintf("\n-- free-fn bare-call binder (spec §3.3, §4) ----------\n");
    Site::FnBindSingle.print_row();
    Site::FnBindSingleHidden.print_row();
    Site::FnBindPrivateBound.print_row();
    Site::FnBindUnscopedRet.print_row();
    Site::FnBindUseSyntax.print_row();
    Site::FnBindUseCursor.print_row();
    Site::FnBindUseDiff.print_row();
    Site::FnBindVisReject.print_row();
    Site::FnBindVisQualified.print_row();
    Site::FnBindVisSingle.print_row();
    Site::FnBindVisPlural.print_row();
    Site::FnBindVisRetLane.print_row();
    Site::FnBindVisValueBare.print_row();
    Site::FnBindVisValueQual.print_row();
    Site::MethodVisReject.print_row();
    Site::MethodVisMember.print_row();
    Site::MethodVisStatic.print_row();

    fmt::eprintf("\n-- scope tiers (spec §4 rules 1-2) --------------------\n");
    Site::ScopeDeclOverImport.print_row();
    Site::ScopeImportShadowed.print_row();
    Site::ScopeAmbigRetracted.print_row();

    fmt::eprintf("\n-- body annotation provenance (spec §8, task #7) ------\n");
    Site::BodyNsOwner.print_row();
    Site::BodyNsSyntax.print_row();
    Site::BodyNsCursor.print_row();
    Site::BodyNsDiff.print_row();

    fmt::eprintf("\n-- ambient-cursor divergence (spec §2b, §5.2) ---------\n");
    fmt::eprintf("     (CRYO_SCOPE_PROBE only; all zero without it)\n");
    Site::HomeCursorSame.print_row();
    Site::HomeCursorDiff.print_row();
    Site::HomeDiffPlural.print_row();
    Site::HomeAgree.print_row();
    Site::HomeDiverge.print_row();
    Site::HomeBlindMiss.print_row();

    fmt::eprintf("\n-- namespace-suffix matchers --------------------------\n");
    Site::M1AgreeCalls.print_row();
    Site::M1AgreeHits.print_row();
    Site::M1QualReject.print_row();
    Site::M1LeafMiss.print_row();
    Site::M2Calls.print_row();
    Site::M4Calls.print_row();
    Site::M4Hits.print_row();
    Site::M5Calls.print_row();
    Site::M5Hits.print_row();

    fmt::eprintf("\n-- module-scope Res, stamped on the node ---------------\n");
    Site::ScopeResStamped.print_row();
    Site::ScopeResNoModule.print_row();
    Site::ScopeResTypeScope.print_row();
    Site::ScopeResNoBind.print_row();
    Site::ScopeResWalked.print_row();
    Site::ScopeResNoBase.print_row();
    Site::ScopeResUnanswerable.print_row();
    Site::ScopeResUnreachable.print_row();
    Site::ScopeResAmbiguous.print_row();
    Site::M2ViaStamp.print_row();
    Site::M2StampMemberMiss.print_row();

    fmt::eprintf("\n-- annotation Res, stamped on the node -----------------\n");
    Site::AnnResSeen.print_row();
    Site::AnnResDef.print_row();
    Site::AnnResGenericParam.print_row();
    Site::AnnResQualified.print_row();
    Site::AnnResTypeRelative.print_row();
    Site::AnnResNoHome.print_row();
    Site::AnnResNoHomeScope.print_row();
    Site::AnnResUnresolved.print_row();

    // Bucket totals, over DISJOINT selections.
    //
    // B1 counts ANSWERS PRODUCED (hits, cascade outcomes), never attempts:
    // a fallback that is called but returns nothing is not load-bearing,
    // and counting attempts would make "drive it to zero" unreachable for
    // the wrong reason.  Cascade step 5 is deliberately NOT added - it is
    // already inside `Site::LeafHits`, and adding both double-counts it.
    //
    // `M1AgreeHits` is excluded for the same reason and is the clearest case
    // of it: `qualifier_agrees` is a CHECK.  Its `true` lets an answer another
    // lookup already produced stand, so summing it counts that answer twice
    // and credits the fallback bucket with work no fallback did.  The row
    // stays flagged and asserted - a validator that starts agreeing with
    // something it used to refuse is a resolution change, and the golden must
    // still catch it - it just is not a summand.
    //
    // The bootstrap arena steps are B1 because Phase 2 deletes
    // `bootstrap_mode` outright; they need a home, not a smaller count.
    mut b1: u64 = 0;
    b1 = b1 + Site::RnHomeModule.count();
    b1 = b1 + Site::RnAmbiguous.count();
    b1 = b1 + Site::RnArenaBootstrap.count();
    b1 = b1 + Site::RnScopeArenaBootstrap.count();
    b1 = b1 + Site::LeafHits.count();
    b1 = b1 + Site::BareAltsViaAmbigDiag.count();
    b1 = b1 + Site::M4Hits.count();
    b1 = b1 + Site::M5Hits.count();

    // `resolve_method_call`'s outcome cascade plus the assoc-type projection.
    // Still a FLOOR, for one named reason: overload selection
    // (`resolve_method_overload`) and member access outside a call are not
    // counted, so a method reached by those routes is missing here.
    mut b2: u64 = Site::RnAssocProjection.count();
    b2 = b2 + Site::McOwnerSymbolic.count();
    b2 = b2 + Site::McOwnerTemplate.count();
    b2 = b2 + Site::McAbstractReceiver.count();
    b2 = b2 + Site::McInheritance.count();
    b2 = b2 + Site::McBoundsPostSym.count();
    b2 = b2 + Site::McTraitImpls.count();
    b2 = b2 + Site::McFieldFn.count();
    b2 = b2 + Site::McCopyDrop.count();
    b2 = b2 + Site::McDerefCoercion.count();

    // B3 is authoritative resolution: correct mechanisms that answer from
    // scope/imports rather than by guessing.  The unification target for
    // these is ONCE PER PATH, not zero - today they are re-derived by every
    // downstream stage, which is what §3.2 rule 2 is really about.
    mut b3: u64 = 0;
    b3 = b3 + Site::RnGenericBinding.count();
    b3 = b3 + Site::RnPrimitive.count();
    b3 = b3 + Site::RnDiLiteral.count();
    b3 = b3 + Site::RnHomeModuleSyntax.count();
    b3 = b3 + Site::RnDiCanonical.count();
    b3 = b3 + Site::RnDiBare.count();
    b3 = b3 + Site::BareAltsViaScoped.count();
    // `canonical_qualified` is authoritative rather than fuzzy: it never
    // answers "which declaration does this name bind to", only "what is this
    // type's module-independent identity", and it folds ONLY when exactly one
    // qualified candidate is registered - a colliding leaf is handed back
    // bare.  Its consumers are coherence keys, which must key the same type
    // identically from every module, so a use-site-dependent answer would be
    // the defect here and not the fix.
    //
    // Summed by what it FOLDED, not by how often it was called: the call row
    // is bumped on entry, and a call that hands its input back produced
    // nothing the caller would not have had anyway.  Both rows are pinned by
    // the gate regardless - a caller that starts asking more often, or a new
    // one that uses this to BIND rather than to key, is the change worth
    // catching, and it would be invisible in an unasserted bucket.
    b3 = b3 + Site::BareAltsCanonFolded.count();

    fmt::eprintf("\n-------------------------------------------------------\n");
    fmt::eprintf("  B1 fuzzy fallback   -> ZERO           %12llu\n", b1);
    fmt::eprintf("  B2 type-dependent   -> stays (FLOOR)  %12llu\n", b2);
    fmt::eprintf("  B3 authoritative    -> once per path  %12llu\n", b3);
    fmt::eprintf("=======================================================\n");
}
