            Site::M4ResAgree            => { "    stamp REACHES the same template" }
            Site::M4ResDiffers          => { "    stamp reaches a DIFFERENT one" }
            Site::M4ResNoTemplate       => { "    stamp names no template" }
            Site::M4PreAgree            => { "pre-scan exit: stamp agrees" }
            Site::M4PreDiffers          => { "pre-scan exit: stamp DIFFERS" }
            Site::M4PreNoStamp          => { "pre-scan exit: no stamp" }
            Site::M4ViaRes              => { "answered from the callee's stamp" }
