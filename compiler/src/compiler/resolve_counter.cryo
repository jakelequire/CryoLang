///! Name-Resolution Instrumentation Counter
///!
///! Phase 0 instrumentation for the name-resolution unification effort
///! (`.todo/NAME_RESOLUTION_PLAN.md`).  Pure measurement: every entry point
///! here only bumps a counter, so enabling or disabling it cannot change
///! what the compiler resolves.
///!
///! **Not scaffolding.**  `docs/name-resolution.md` §7.2 mechanism 3 makes
///! `B1 == 0` a permanent gate: the cascade grew for years because nobody
///! could see it growing, and deleting the meter after fixing the leak is how
///! the leak comes back.  Individual SITES are disposable - a site whose
///! fallback has been deleted has nothing left to count - but the module is
///! not.
///!
///! The plan's §3.2 rule 2 splits resolution into two answers, and the
///! counter mirrors that split into two BUCKETS:
///!
///!   B1 - path re-derivation.  A stage recomputing, from a string, an
///!        answer the resolver already produced.  Every B1 site must read
///!        ZERO before Phase 5 deletes the fallback that feeds it.
///!   B2 - type-dependent lookup.  Resolution that genuinely needs a
///!        receiver type (method/trait selection, associated-item
///!        projection).  Expected to stay nonzero forever; enumerated and
///!        justified rather than eliminated.
///!
///! Bucket labels here are the plan's current reading and are expected to
///! be revised once `docs/name-resolution.md` settles them.  The counter
///! records SITES; the bucket is only a report-time annotation.
///!
///! Counting is unconditional - a global array increment is cheaper than
///! the branch that would guard it, and always-on counting removes any
///! init-ordering question.  Only the REPORT is gated, on
///! `CRYO_RESOLVE_COUNTER=1`.
///!
///! Two caveats on any reading this produces:
///!   - Counters are per-PROCESS.  Multiprocess codegen (`>= 16` modules,
///!     see `CODEGEN_MULTIPROC_MIN_MODULES` in `instance.cryo`) loses child
///!     tallies, so a baseline run must pin `CRYO_CODEGEN_THREADS=1`.
///!   - Increments are not atomic.  Any threaded phase makes counts
///!     approximate, never exact.

namespace Compiler::ResolveCounter;

import std::fmt;
import std::env;
import std::collections::str;

// ---- Storage -----------------------------------------------------------

/// Capacity of the tally array.  Sized well above the variant count so
/// adding a `Site` never requires resizing, and so the bound is a property
/// of the STORAGE rather than a hand-maintained "number of sites" constant
/// that a new variant could silently outrun.
const TALLY_CAP: i64 = 64;

/// Per-site tallies.  Zero-initialized in BSS; indexed by `Site`.
mut g_tally: u64[64];

/// Suspend depth.  Non-zero means "a measurement is currently re-running
/// production lookups; record nothing".
mut g_suspend: i32 = 0;

/// Per-stream tri-state env cache: 0 unknown, 1 on, 2 off.  Indexed by
/// `Audit`.  Cached because these hooks run inside the hottest lookup in the
/// compiler and an `env::var` per call would dominate the measurement.
mut g_audit_state: i32[8];

const AUDIT_CAP: i64 = 8;

// ---- Sites -------------------------------------------------------------

/// One counted resolution OUTCOME.
///
/// An enum rather than a block of `const i64` indices, for two reasons that
/// both bit this module in practice:
///
///   - the old `RC_SITE_COUNT` bound was hand-maintained, and a new constant
///     added past it made `bump` silently no-op.  A counter reading zero
///     because it was never recorded is indistinguishable from a real zero,
///     which is the same trap as `is_candidate_public` defaulting to `true`
///     (§8.1 landmine).  The bound is now the array capacity.
///   - `label()` and `bucket()` below are exhaustive `match`es, so a new
///     variant cannot be added without giving it a report row.  That is
///     §7.2 mechanism 1 applied to the counter itself.
///
/// Declaration order is the storage order and is otherwise arbitrary; nothing
/// persists tallies across runs, so variants may be regrouped freely.
type enum Site {
    // `types/resolver.cryo` resolve_named cascade.  One site per OUTCOME, so
    // the tally shows which step actually answered rather than which steps
    // were attempted.  §2.3 of the plan.
    RnCalls;
    RnGenericBinding;
    RnAssocProjection;
    RnPrimitive;
    RnHomeModule;
    RnAmbiguous;
    RnDiLiteral;
    RnDiCanonical;
    RnDiBare;
    RnArenaBootstrap;
    RnScopeArenaBootstrap;
    RnLeafIndex;
    RnFailed;

    // `types/arena.cryo` global leaf index.
    LeafCalls;
    LeafHits;

    // `decl_index.cryo` bare-name alternatives.
    BareAltsCalls;
    BareAltsHits;
    BareAltsMulti;
    BareAltsViaScoped;
    BareAltsViaCanonical;
    BareAltsViaAmbigDiag;

    // Visibility-gate blast radius.
    VisFastpath;
    VisWouldReject;
    VisRejectUnreachable;
    VisRejectNotPublic;

    // Leaf-index consumers, bumped on a HIT (an answer actually produced).
    LeafViaResolveNamed;
    LeafViaResolverBound;
    LeafViaSymbolicCheck;
    LeafViaTypeUtils;
    LeafViaTypeResBound;
    LeafViaTypeResBase;

    // Free-function bare-call binder.  Counted apart because they need
    // different fixes: D-A is a missing check, D-B is a missing input.
    // SingleHidden is the D-A blast radius; PrivateBound is D-B's (it counts
    // binds in ANY branch, so it is not a subset of Single).  UnscopedRet is
    // a SECOND door - `resolve_direct_call`'s fallback to the program-wide
    // bare `func_returns` map, which has no owner column and therefore no
    // scope input whatsoever.  One pins the SYMBOL, the other supplies the
    // TYPE, and a call can be answered by either alone.
    FnBindSingle;
    FnBindSingleHidden;
    FnBindPrivateBound;
    FnBindUnscopedRet;

    // Ambient-cursor divergence (§2b, §5.2), measured where the true scope is
    // KNOWN: the home-module preference step.  There a caller has said which
    // module the annotation was written in, so the module-blind chain can be
    // re-run and compared.  §6's caveat is that the cursor contaminates any
    // measurement of itself; this is the one place that is not true.
    //
    // Read CursorSame/CursorDiff FIRST.  A comparison where home and cursor
    // are the same module proves nothing - one scope was in play, so
    // agreement is forced.  DiffPlural is the control on that control: scope
    // can only change an answer when the leaf has more than one declaring
    // module.  With DiffPlural at zero, a zero Diverge says nothing about
    // scope; it says the corpus has no collisions.
    HomeCursorSame;
    HomeCursorDiff;
    HomeDiffPlural;
    HomeAgree;
    HomeDiverge;
    HomeBlindMiss;

    // The five namespace-suffix matchers.
    M1Calls;
    M1Hits;
    M2Calls;
    M2Hits;
    M3Calls;
    M3Hits;
    M4Calls;
    M4Hits;
    M5Calls;
    M5Hits;
}

implement enum Site {
    /// Record one occurrence.
    ///
    /// Out-of-range is ignored rather than trapping: instrumentation must
    /// never be able to abort a build.
    bump(&this) -> void {
        if (g_suspend > 0) { return; }
        const i: i64 = this as i64;
        if (i < 0 || i >= TALLY_CAP) { return; }
        g_tally[i] = g_tally[i] + 1;
    }

    /// Read the tally back.  Used by the report and by tests.
    count(&this) -> u64 {
        const i: i64 = this as i64;
        if (i < 0 || i >= TALLY_CAP) { return 0; }
        return g_tally[i];
    }

    /// The report bucket this site belongs to.  `"B1"` must reach zero,
    /// `"B2"` stays, `"B3"` is authoritative, `"  "` is context-only and
    /// `"!!"` flags a violation row.
    ///
    /// Exhaustive on purpose: a new site cannot be added without classifying
    /// it.
    bucket(&this) -> string {
        return match (this) {
            Site::RnCalls               => { "   " }
            Site::RnGenericBinding      => { "B3 " }
            Site::RnAssocProjection     => { "B2 " }
            Site::RnPrimitive           => { "B3 " }
            Site::RnHomeModule          => { "B1 " }
            Site::RnAmbiguous           => { "B1 " }
            Site::RnDiLiteral           => { "B3 " }
            Site::RnDiCanonical         => { "B3 " }
            Site::RnDiBare              => { "B3 " }
            Site::RnArenaBootstrap      => { "B1 " }
            Site::RnScopeArenaBootstrap => { "B1 " }
            Site::RnLeafIndex           => { "B1*" }
            Site::RnFailed              => { "   " }
            Site::LeafCalls             => { "B1 " }
            Site::LeafHits              => { "B1 " }
            Site::BareAltsCalls         => { "   " }
            Site::BareAltsHits          => { "   " }
            Site::BareAltsMulti         => { "   " }
            Site::BareAltsViaScoped     => { "B3 " }
            Site::BareAltsViaCanonical  => { "B1 " }
            Site::BareAltsViaAmbigDiag  => { "B1 " }
            Site::VisFastpath           => { "   " }
            Site::VisWouldReject        => { "!! " }
            Site::VisRejectUnreachable  => { "   " }
            Site::VisRejectNotPublic    => { "   " }
            Site::LeafViaResolveNamed   => { "   " }
            Site::LeafViaResolverBound  => { "   " }
            Site::LeafViaSymbolicCheck  => { "   " }
            Site::LeafViaTypeUtils      => { "   " }
            Site::LeafViaTypeResBound   => { "   " }
            Site::LeafViaTypeResBase    => { "   " }
            Site::FnBindSingle          => { "   " }
            Site::FnBindSingleHidden    => { "!! " }
            Site::FnBindPrivateBound    => { "!! " }
            Site::FnBindUnscopedRet     => { "B1 " }
            Site::HomeCursorSame        => { "   " }
            Site::HomeCursorDiff        => { "   " }
            Site::HomeDiffPlural        => { "   " }
            Site::HomeAgree             => { "   " }
            Site::HomeDiverge           => { "!! " }
            Site::HomeBlindMiss         => { "   " }
            Site::M1Calls               => { "B1 " }
            Site::M1Hits                => { "B1 " }
            Site::M2Calls               => { "B1 " }
            Site::M2Hits                => { "B1 " }
            Site::M3Calls               => { "B1 " }
            Site::M3Hits                => { "B1 " }
            Site::M4Calls               => { "B1 " }
            Site::M4Hits                => { "B1 " }
            Site::M5Calls               => { "B1 " }
            Site::M5Hits                => { "B1 " }
        };
    }

    /// The report row label.  Exhaustive: a new site cannot be added without
    /// a line in the report, which is the failure this enum exists to make
    /// impossible.
    label(&this) -> string {
        return match (this) {
            Site::RnCalls               => { "calls (total)" }
            Site::RnGenericBinding      => { "1   generic binding" }
            Site::RnAssocProjection     => { "1b  assoc-type projection (I::Item)" }
            Site::RnPrimitive           => { "2   primitive name" }
            Site::RnHomeModule          => { "2c  home-module preference" }
            Site::RnAmbiguous           => { "2b  ambiguity -> E0203" }
            Site::RnDiLiteral           => { "3a  DI exact qualified literal" }
            Site::RnDiCanonical         => { "3b  DI canonicalized qualified" }
            Site::RnDiBare              => { "3c  DI bare name" }
            Site::RnArenaBootstrap      => { "4   arena (bootstrap-only)" }
            Site::RnScopeArenaBootstrap => { "4a  scope+arena (bootstrap-only)" }
            Site::RnLeafIndex           => { "5   GLOBAL LEAF INDEX  (* in leaf hits)" }
            Site::RnFailed              => { "    unresolved" }
            Site::LeafCalls             => { "lookup_by_leaf calls" }
            Site::LeafHits              => { "lookup_by_leaf hits" }
            Site::BareAltsCalls         => { "lookup_qualified_alternatives calls" }
            Site::BareAltsHits          => { "lookup_qualified_alternatives hits" }
            Site::BareAltsMulti         => { "  of which ambiguous (>1 candidate)" }
            Site::BareAltsViaScoped     => { "  by caller: resolve_qualified_scoped" }
            Site::BareAltsViaCanonical  => { "  by caller: canonical_qualified" }
            Site::BareAltsViaAmbigDiag  => { "  by caller: sema ambiguity diag" }
            Site::VisFastpath           => { "single-candidate fast path taken" }
            Site::VisWouldReject        => { "  WOULD BE REJECTED once gated" }
            Site::VisRejectUnreachable  => { "    cause: namespace not reachable" }
            Site::VisRejectNotPublic    => { "    cause: candidate not public" }
            Site::LeafViaResolveNamed   => { "  by caller: resolve_named step 5" }
            Site::LeafViaResolverBound  => { "  by caller: resolver generic bound" }
            Site::LeafViaSymbolicCheck  => { "  by caller: symbolic_checker" }
            Site::LeafViaTypeUtils      => { "  by caller: sema type_utils" }
            Site::LeafViaTypeResBound   => { "  by caller: type_resolution bound" }
            Site::LeafViaTypeResBase    => { "  by caller: type_resolution base" }
            Site::FnBindSingle          => { "single-overload pins (no scope check)" }
            Site::FnBindSingleHidden    => { "  of those, owner NOT in scope (D-A)" }
            Site::FnBindPrivateBound    => { "bound to a PRIVATE candidate  (D-B)" }
            Site::FnBindUnscopedRet     => { "bare return-type answers, NO scope input" }
            Site::HomeCursorSame        => { "home == ambient cursor (proves nothing)" }
            Site::HomeCursorDiff        => { "home != ambient cursor (the evidence)" }
            Site::HomeDiffPlural        => { "  of those, leaf declared by >1 module" }
            Site::HomeAgree             => { "  both chains agreed" }
            Site::HomeDiverge           => { "  blind chain binds a DIFFERENT type" }
            Site::HomeBlindMiss         => { "  blind chain answers nothing" }
            Site::M1Calls               => { "M1 module_ns_matches_prefix calls" }
            Site::M1Hits                => { "M1 module_ns_matches_prefix hits" }
            Site::M2Calls               => { "M2 resolve_module_qualified_sym calls" }
            Site::M2Hits                => { "M2 resolve_module_qualified_sym hits" }
            Site::M3Calls               => { "M3 collect_namespace_suffix calls" }
            Site::M3Hits                => { "M3 collect_namespace_suffix hits" }
            Site::M4Calls               => { "M4 mono bare-name template scan" }
            Site::M4Hits                => { "M4 mono bare-name scan hits" }
            Site::M5Calls               => { "M5 import suffix fallback calls" }
            Site::M5Hits                => { "M5 import suffix fallback hits" }
        };
    }

    /// One report row: bucket, label, tally.
    print_row(&this) -> void {
        fmt::eprintf("  %-3s %-46s %12llu\n",
                     this.bucket(), this.label(), this.count());
    }
}

// ---- Suspension --------------------------------------------------------

/// Stop recording until the matching `resume`.
///
/// An instrument that re-runs a production lookup to compare answers would
/// otherwise be counted as if the compiler had really taken that path -
/// `lookup_by_leaf` bumps the leaf sites, and `resolve_type_qualified_name`
/// emits M1 path-audit events.  Both sit underneath the divergence probe, so
/// without this the probe would inflate the exact numbers it exists to put in
/// context.
///
/// Counted, not a flag, so nesting is safe.  `Audit::enabled` honors it too,
/// so a suspended region emits no audit lines either.
public function suspend() -> void { g_suspend = g_suspend + 1; }

public function resume() -> void {
    if (g_suspend > 0) { g_suspend = g_suspend - 1; }
}

// ---- Audit streams -----------------------------------------------------

/// A line-oriented audit stream, each switched on by its own env var.
///
/// Line-oriented on purpose: a run can be piped through `sort -u` to get the
/// distinct set, and the classification can be re-cut offline without a
/// recompile.
///
/// `CRYO_RESOLVE_COUNTER` is deliberately NOT a variant here.  It gates a
/// summary printed once at exit rather than per-event lines, and it must not
/// be suppressed by `suspend` - folding it in would mean a probe region could
/// silently swallow the report.
type enum Audit {
    Leaf;
    Visibility;
    Path;
    Scope;
}

implement enum Audit {
    /// The environment variable that switches this stream on.
    var_name(&this) -> string {
        return match (this) {
            Audit::Leaf       => { "CRYO_LEAF_AUDIT" }
            Audit::Visibility => { "CRYO_VIS_AUDIT" }
            Audit::Path       => { "CRYO_PATH_AUDIT" }
            Audit::Scope      => { "CRYO_SCOPE_PROBE" }
        };
    }

    /// Whether this stream is on.  Exposed so a caller can skip building the
    /// strings an audit line needs - interning a namespace is not free, and
    /// these sites sit in the resolution hot path.
    enabled(&this) -> boolean {
        if (g_suspend > 0) { return false; }
        const i: i64 = this as i64;
        if (i < 0 || i >= AUDIT_CAP) { return false; }
        if (g_audit_state[i] == 0) {
            match (env::var(Str::new(this.var_name()))) {
                Option::Some(_) => { g_audit_state[i] = 1; }
                Option::None    => { g_audit_state[i] = 2; }
            }
        }
        return g_audit_state[i] == 1;
    }
}

// ---- Audit emitters ----------------------------------------------------
//
// Free functions rather than methods on `Audit`, deliberately.  A method would
// be callable on any variant - `Audit::Leaf.scope_diverge(...)` would compile
// and then gate a SCOPE-DIVERGE line on `CRYO_LEAF_AUDIT`.  That is a silent
// mis-gating bug of exactly the kind this module exists to catch.  Each
// emitter below names its own stream once, in one place.

/// Log one name that the GLOBAL LEAF INDEX answered, with the module that
/// asked.
public function leaf_hit(use_site: string, name: string) -> void {
    if (!Audit::Leaf.enabled()) { return; }
    fmt::eprintf("LEAF-HIT\t%s\t%s\n", use_site, name);
}

/// Print one would-be-rejected resolution, so a run yields the distinct
/// migration set.
public function vis_violation(use_site: string, cand: string) -> void {
    if (!Audit::Visibility.enabled()) { return; }
    fmt::eprintf("VIS-VIOLATION\t%s\t%s\n", use_site, cand);
}

/// Print one recorded visibility verdict, so a run can prove the
/// `decl_visibility` map is populated before any conclusion is drawn from a
/// zero rejection count (`is_candidate_public` defaults to `true`, so an
/// unwired recorder and a genuinely-all-public program look identical).
public function vis_record(qualified: string, is_public: boolean) -> void {
    if (!Audit::Visibility.enabled()) { return; }
    const flag: i32 = if (is_public) { 1 } else { 0 };
    fmt::eprintf("VIS-RECORD\t%d\t%s\n", flag, qualified);
}

/// Print one fast-path encounter with a candidate recorded as PRIVATE, tagged
/// with why it was (or was not) let through.  Distinguishes "the gate saw no
/// private candidates" from "the gate never got to look".
public function vis_private(kind: string, use_site: string, cand: string) -> void {
    if (!Audit::Visibility.enabled()) { return; }
    fmt::eprintf("VIS-PRIVATE\t%s\t%s\t%s\n", kind, use_site, cand);
}

/// Print one bare free-function call that bound to a candidate the use site
/// should not be able to name.  `kind` is `HIDDEN` (D-A: not imported) or
/// `PRIVATE` (D-B: imported but not public).
public function fnbind_violation(kind: string, use_site: string,
                                 cand: string) -> void {
    if (!Audit::Visibility.enabled()) { return; }
    fmt::eprintf("FNBIND-VIOLATION\t%s\t%s\t%s\n", kind, use_site, cand);
}

/// Log one QUALIFIED PATH that a namespace-suffix matcher resolved, to size
/// the migration §5.1 ("first segment resolves in scope, remainder rooted")
/// implies.  `docs/name-resolution.md` §9 / plan R4.
///
/// Emitted at the DECISION, not inside the matcher.  M1's raw hit count is
/// probes-inside-a-loop (once per export candidate), so it cannot answer "how
/// many written paths need an import" - only one event per accepted path can.
///
/// `written` is the path as the source spelled it; `resolved` is the canonical
/// name it bound to.  The relationship between the two - exact, abbreviated
/// suffix, or a shallower prefix needing a re-export - is what classifies the
/// churn, and it is computed offline from these two strings rather than here,
/// so the classification can be re-cut without a recompile.
public function path_hit(kind: string, use_site: string,
                         written: string, resolved: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("PATH-HIT\t%s\t%s\t%s\t%s\n", kind, use_site, written, resolved);
}

/// Dump one `module -> visible namespace` edge, so the offline classifier can
/// ask the compiler's OWN reachability question ("is this first segment in
/// scope here?") instead of re-deriving it with a regex over import lines,
/// which cannot see the prelude or brace-list items.
public function path_scope(ns: string, visible: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("PATH-SCOPE\t%s\t%s\n", ns, visible);
}

/// Dump one prelude namespace - in scope everywhere, so a path rooted at one
/// needs no import no matter where it is written.
public function path_prelude(ns: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("PATH-PRELUDE\t%s\n", ns);
}

/// Print one annotation whose meaning DEPENDS on having a scope: the module
/// it was written in binds `name` to `home_qn`, the ambient chain binds it to
/// `blind_qn`, and they are not the same type.
public function scope_diverge(home: string, name: string,
                              home_qn: string, blind_qn: string) -> void {
    if (!Audit::Scope.enabled()) { return; }
    fmt::eprintf("SCOPE-DIVERGE\t%s\t%s\t%s\t%s\n", home, name, home_qn, blind_qn);
}

// ---- Reporting ---------------------------------------------------------

/// Drop every tally back to zero.  Exists so a driver that compiles more
/// than one unit in a process can attribute counts per unit.
public function reset() -> void {
    for (mut i: i64 = 0; i < TALLY_CAP; i++) {
        g_tally[i] = 0;
    }
}

/// Whether `CRYO_RESOLVE_COUNTER` is set in the environment.
public function enabled() -> boolean {
    match (env::var(Str::new("CRYO_RESOLVE_COUNTER"))) {
        Option::Some(_) => { return true;  }
        Option::None    => { return false; }
    }
}

/// Print the tally to stderr.  No-op unless `CRYO_RESOLVE_COUNTER` is set.
///
/// B1 total is the number the unification effort drives to zero; it is
/// printed last so it is the final thing on screen.
public function report() -> void {
    if (!enabled()) { return; }

    fmt::eprintf("\n");
    fmt::eprintf("=============== name-resolution counter ===============\n");
    fmt::eprintf("  B1 = fuzzy fallback        -> must reach ZERO\n");
    fmt::eprintf("  B2 = type-dependent lookup -> stays; enumerate+justify\n");
    fmt::eprintf("  B3 = authoritative lookup  -> once per path, NOT zero\n");
    fmt::eprintf("\n");
    fmt::eprintf("  Sites NEST: cascade step 5 is a subset of leaf-index\n");
    fmt::eprintf("  hits, and bare_alts hits are a subset of its callers'\n");
    fmt::eprintf("  calls.  Totals are taken over a DISJOINT selection and\n");
    fmt::eprintf("  count site events, not distinct resolutions.\n");
    fmt::eprintf("\n");

    fmt::eprintf("-- resolve_named cascade (types/resolver.cryo:1324) ----\n");
    Site::RnCalls.print_row();
    Site::RnGenericBinding.print_row();
    Site::RnAssocProjection.print_row();
    Site::RnPrimitive.print_row();
    Site::RnHomeModule.print_row();
    Site::RnAmbiguous.print_row();
    Site::RnDiLiteral.print_row();
    Site::RnDiCanonical.print_row();
    Site::RnDiBare.print_row();
    Site::RnArenaBootstrap.print_row();
    Site::RnScopeArenaBootstrap.print_row();
    Site::RnLeafIndex.print_row();
    Site::RnFailed.print_row();

    fmt::eprintf("\n-- global leaf index (types/arena.cryo:1023) ----------\n");
    Site::LeafCalls.print_row();
    Site::LeafHits.print_row();
    Site::LeafViaResolveNamed.print_row();
    Site::LeafViaResolverBound.print_row();
    Site::LeafViaSymbolicCheck.print_row();
    Site::LeafViaTypeUtils.print_row();
    Site::LeafViaTypeResBound.print_row();
    Site::LeafViaTypeResBase.print_row();

    fmt::eprintf("\n-- DeclarationIndex bare_alts (decl_index.cryo:1405) --\n");
    Site::BareAltsCalls.print_row();
    Site::BareAltsHits.print_row();
    Site::BareAltsMulti.print_row();
    Site::BareAltsViaScoped.print_row();
    Site::BareAltsViaCanonical.print_row();
    Site::BareAltsViaAmbigDiag.print_row();

    fmt::eprintf("\n-- visibility gate blast radius (spec §8.1) -----------\n");
    Site::VisFastpath.print_row();
    Site::VisWouldReject.print_row();
    Site::VisRejectUnreachable.print_row();
    Site::VisRejectNotPublic.print_row();

    fmt::eprintf("\n-- free-fn bare-call binder (spec §3.3, §4) ----------\n");
    Site::FnBindSingle.print_row();
    Site::FnBindSingleHidden.print_row();
    Site::FnBindPrivateBound.print_row();
    Site::FnBindUnscopedRet.print_row();

    fmt::eprintf("\n-- ambient-cursor divergence (spec §2b, §5.2) ---------\n");
    fmt::eprintf("     (CRYO_SCOPE_PROBE only; all zero without it)\n");
    Site::HomeCursorSame.print_row();
    Site::HomeCursorDiff.print_row();
    Site::HomeDiffPlural.print_row();
    Site::HomeAgree.print_row();
    Site::HomeDiverge.print_row();
    Site::HomeBlindMiss.print_row();

    fmt::eprintf("\n-- namespace-suffix heuristic, 5 copies ---------------\n");
    Site::M1Calls.print_row();
    Site::M1Hits.print_row();
    Site::M2Calls.print_row();
    Site::M2Hits.print_row();
    Site::M3Calls.print_row();
    Site::M3Hits.print_row();
    Site::M4Calls.print_row();
    Site::M4Hits.print_row();
    Site::M5Calls.print_row();
    Site::M5Hits.print_row();

    // Bucket totals, over DISJOINT selections.
    //
    // B1 counts ANSWERS PRODUCED (hits, cascade outcomes), never attempts:
    // a fallback that is called but returns nothing is not load-bearing,
    // and counting attempts would make "drive it to zero" unreachable for
    // the wrong reason.  Cascade step 5 is deliberately NOT added - it is
    // already inside `Site::LeafHits`, and adding both double-counts it.
    //
    // The bootstrap arena steps are B1 because Phase 2 deletes
    // `bootstrap_mode` outright; they need a home, not a smaller count.
    mut b1: u64 = 0;
    b1 = b1 + Site::RnHomeModule.count();
    b1 = b1 + Site::RnAmbiguous.count();
    b1 = b1 + Site::RnArenaBootstrap.count();
    b1 = b1 + Site::RnScopeArenaBootstrap.count();
    b1 = b1 + Site::LeafHits.count();
    b1 = b1 + Site::BareAltsViaCanonical.count();
    b1 = b1 + Site::BareAltsViaAmbigDiag.count();
    b1 = b1 + Site::M1Hits.count();
    b1 = b1 + Site::M2Hits.count();
    b1 = b1 + Site::M3Hits.count();
    b1 = b1 + Site::M4Hits.count();
    b1 = b1 + Site::M5Hits.count();

    // INCOMPLETE.  Only `resolve_named`'s assoc-type projection is
    // instrumented so far; sema's method/trait dispatch - the actual bulk
    // of type-dependent resolution, and the §2.6 `call_resolver.cryo:1862`
    // case - is NOT counted yet.  Treat this as a floor, not a total.
    const b2: u64 = Site::RnAssocProjection.count();

    // B3 is authoritative resolution: correct mechanisms that answer from
    // scope/imports rather than by guessing.  The unification target for
    // these is ONCE PER PATH, not zero - today they are re-derived by every
    // downstream stage, which is what §3.2 rule 2 is really about.
    mut b3: u64 = 0;
    b3 = b3 + Site::RnGenericBinding.count();
    b3 = b3 + Site::RnPrimitive.count();
    b3 = b3 + Site::RnDiLiteral.count();
    b3 = b3 + Site::RnDiCanonical.count();
    b3 = b3 + Site::RnDiBare.count();
    b3 = b3 + Site::BareAltsViaScoped.count();

    fmt::eprintf("\n-------------------------------------------------------\n");
    fmt::eprintf("  B1 fuzzy fallback   -> ZERO           %12llu\n", b1);
    fmt::eprintf("  B2 type-dependent   -> stays (FLOOR)  %12llu\n", b2);
    fmt::eprintf("  B3 authoritative    -> once per path  %12llu\n", b3);
    fmt::eprintf("=======================================================\n");
}
