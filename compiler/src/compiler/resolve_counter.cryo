    /// One report row: bucket, label, tally.
    print_row(&this) -> void {
        fmt::eprintf("  %-3s %-46s %12llu\n",
                     this.bucket(), this.label(), this.count());
    }
}

// ---- Suspension --------------------------------------------------------

/// Stop recording until the matching `resume`.
///
/// An instrument that re-runs a production lookup to compare answers would
/// otherwise be counted as if the compiler had really taken that path -
/// `lookup_by_leaf` bumps the leaf sites, and `resolve_type_qualified_name`
/// emits M1 path-audit events.  Both sit underneath the divergence probe, so
/// without this the probe would inflate the exact numbers it exists to put in
/// context.
///
/// Counted, not a flag, so nesting is safe.  `Audit::enabled` honors it too,
/// so a suspended region emits no audit lines either.
public function suspend() -> void { g_suspend = g_suspend + 1; }

public function resume() -> void {
    if (g_suspend > 0) { g_suspend = g_suspend - 1; }
}

// ---- Audit streams -----------------------------------------------------

/// A line-oriented audit stream, each switched on by its own env var.
///
/// Line-oriented on purpose: a run can be piped through `sort -u` to get the
/// distinct set, and the classification can be re-cut offline without a
/// recompile.
///
/// `CRYO_RESOLVE_COUNTER` is deliberately NOT a variant here.  It gates a
/// summary printed once at exit rather than per-event lines, and it must not
/// be suppressed by `suspend` - folding it in would mean a probe region could
/// silently swallow the report.
type enum Audit {
    Leaf;
    Visibility;
    Path;
    Scope;
    Named;
    Trait;
}

implement enum Audit {
    /// The environment variable that switches this stream on.
    var_name(&this) -> string {
        return match (this) {
            Audit::Leaf       => { "CRYO_LEAF_AUDIT" }
            Audit::Visibility => { "CRYO_VIS_AUDIT" }
            Audit::Path       => { "CRYO_PATH_AUDIT" }
            Audit::Scope      => { "CRYO_SCOPE_PROBE" }
            Audit::Named      => { "CRYO_RN_AUDIT" }
            Audit::Trait      => { "CRYO_TRAIT_AUDIT" }
        };
    }

    /// Whether this stream is on.  Exposed so a caller can skip building the
    /// strings an audit line needs - interning a namespace is not free, and
    /// these sites sit in the resolution hot path.
    enabled(&this) -> boolean {
        if (g_suspend > 0) { return false; }
        const i: i64 = this as i64;
        if (i < 0 || i >= AUDIT_CAP) { return false; }
        if (g_audit_state[i] == 0) {
            match (env::var(Str::new(this.var_name()))) {
                Option::Some(_) => { g_audit_state[i] = 1; }
                Option::None    => { g_audit_state[i] = 2; }
            }
        }
        return g_audit_state[i] == 1;
    }
}

// ---- Audit emitters ----------------------------------------------------
//
// Free functions rather than methods on `Audit`, deliberately.  A method would
// be callable on any variant - `Audit::Leaf.body_ns_diff(...)` would compile
// and then gate a BODY-NS line on `CRYO_LEAF_AUDIT`.  That is a silent
// mis-gating bug of exactly the kind this module exists to catch.  Each
// emitter below names its own stream once, in one place.

/// Log one name that the GLOBAL LEAF INDEX answered, with the module that
/// asked.
public function leaf_hit(use_site: string, name: string) -> void {
    if (!Audit::Leaf.enabled()) { return; }
    fmt::eprintf("LEAF-HIT\t%s\t%s\n", use_site, name);
}

/// Print one would-be-rejected resolution, so a run yields the distinct
/// migration set.
///
/// The site and origin are what make the count readable: `use_site` is whatever
/// namespace the caller supplied, and a caller that supplies the ambient cursor
/// names a module that never wrote the syntax.  Counting rejections without
/// them measures the callers as much as the sources - and the callers disagree,
/// since three of the four pass a cursor by their own contract while one passes
/// a context's home module.
public function vis_violation(use_site: string, cand: string,
                              site_file: string, site_line: i32,
                              origin: string) -> void {
    if (!Audit::Visibility.enabled()) { return; }
    fmt::eprintf("VIS-VIOLATION\t%s\t%s\t%s:%d\t%s\n",
                 use_site, cand, site_file, site_line, origin);
}

/// Print one recorded visibility verdict, so a run can prove the
/// `decl_visibility` map is populated before any conclusion is drawn from a
/// zero rejection count (`is_candidate_public` defaults to `true`, so an
/// unwired recorder and a genuinely-all-public program look identical).
public function vis_record(qualified: string, is_public: boolean) -> void {
    if (!Audit::Visibility.enabled()) { return; }
    const flag: i32 = if (is_public) { 1 } else { 0 };
    fmt::eprintf("VIS-RECORD\t%d\t%s\n", flag, qualified);
}

/// Print one fast-path encounter with a candidate recorded as PRIVATE, tagged
/// with why it was (or was not) let through.  Distinguishes "the gate saw no
/// private candidates" from "the gate never got to look".
public function vis_private(kind: string, use_site: string, cand: string) -> void {
    if (!Audit::Visibility.enabled()) { return; }
    fmt::eprintf("VIS-PRIVATE\t%s\t%s\t%s\n", kind, use_site, cand);
}

/// Print one bare free-function call that bound to a candidate the use site
/// should not be able to name.  `kind` is `HIDDEN` (D-A: not imported) or
/// `PRIVATE` (D-B: imported but not public).
public function fnbind_violation(kind: string, use_site: string,
                                 cand: string) -> void {
    if (!Audit::Visibility.enabled()) { return; }
    fmt::eprintf("FNBIND-VIOLATION\t%s\t%s\t%s\n", kind, use_site, cand);
}

/// Log one call REJECTED by the visibility gate, naming the door it was
/// caught by.
///
/// Emitted at the rejection rather than tallied for the end-of-run report,
/// because a rejected call means the build FAILS, and the report only prints
/// on the success path after link.  Without this, the one measurement that
/// matters for a compile_fail corpus entry - "did the door this case was
/// written for actually fire?" - is unavailable precisely when the case
/// works.  `visibility_gate`'s `stash` is the motivating example: if its
/// second declarer stopped being compiled, the call would silently fall back
/// to the single-overload door and the project would still pass while testing
/// nothing it claims to.
public function vis_gate_reject(door: string, use_site: string,
                                cand: string) -> void {
    if (!Audit::Visibility.enabled()) { return; }
    fmt::eprintf("VIS-GATE\t%s\t%s\t%s\n", door, use_site, cand);
}

/// Log the answer `resolve_named` gave for ONE annotation, naming the cascade
/// step that produced it.
///
/// The end-of-run tally says how many answers each step gave; it cannot say
/// which NAME a step answered, and that is the question a wrong bind poses.
/// `docs/name-resolution.md` §8.2m: a module that declares a leaf it also
/// imports binds the IMPORT in every annotation position, and every existing
/// instrument reads green through it, because they all measure whether the
/// home module was DERIVED correctly rather than what it then RESOLVED to.
///
/// `step` is the cascade label from the report; `home` is the module the
/// annotation was written in as the context knows it (`<none>` when the site
/// never established one); `cursor` is the ambient scope cursor, which is what
/// every step below 2c canonicalizes against; `site` names the caller that
/// built the context; `answer` is the qualified name that won.
///
/// `home` and `cursor` are separate columns because they answer different
/// questions and the difference is the whole finding: on the body-local
/// reproduction the cursor is CORRECT (it names the writing module) and the
/// answer is still the imported type. An instrument reporting only provenance
/// reads green there. Compare with
/// `awk -F'\t' '$2=="3b-di-canonical" && $7 !~ "^"$4"::"'`.
///
/// `site` is what makes a fallback answer actionable: `home=<none>` says a
/// scope is missing, and only the site says which caller has to supply it.
/// Attribute with `awk -F'\t' '$3=="<none>" {print $2"\t"$5}' | sort | uniq -c`.
public function rn_answer(step: string, home: string, cursor: string,
                          site_file: string, site_line: i32,
                          name: string, answer: string) -> void {
    if (!Audit::Named.enabled()) { return; }
    fmt::eprintf("RN\t%s\t%s\t%s\t%s:%d\t%s\t%s\n",
                 step, home, cursor, site_file, site_line, name, answer);
}

/// Log a `set_home_module` call that supplied an EMPTY module while naming a
/// real origin.
///
/// The scope is normalized to `Unset` there, so the context falls into the
/// module-blind chain even though its construction site does establish a scope
/// on every other path.  Grepping for `set_home_module` therefore over-counts
/// the sites that are done: this is the population that call it and still
/// arrive unscoped, and it can only be observed at the call.
public function home_empty(site_file: string, site_line: i32,
                           origin: string) -> void {
    if (!Audit::Named.enabled()) { return; }
    fmt::eprintf("RN-HOME-EMPTY\t%s:%d\t%s\n", site_file, site_line, origin);
}

/// Log a default type argument expanded WITHOUT its template's own module.
///
/// `expand_default_type_args` re-homes on `entry.module_name` because a default
/// annotation is syntax written in the TEMPLATE's file.  When the entry carries
/// no module the re-home is skipped and the default resolves against whichever
/// module asked for the expansion, so one declaration's default binds
/// differently per caller.  A count cannot say WHICH template lost its owner,
/// and the template is the only actionable part.
public function default_arg_no_owner(template: string, fallback_home: string) -> void {
    if (!Audit::Named.enabled()) { return; }
    fmt::eprintf("DEF-ARG-NO-OWNER\t%s\t%s\n", template, fallback_home);
}

/// Log one QUALIFIED PATH that a namespace-suffix matcher resolved, to size
/// the migration §5.1 ("first segment resolves in scope, remainder rooted")
/// implies.  `docs/name-resolution.md` §9 / plan R4.
///
/// Emitted at the DECISION, not inside the matcher.  M1's raw hit count is
/// probes-inside-a-loop (once per export candidate), so it cannot answer "how
/// many written paths need an import" - only one event per accepted path can.
///
/// `written` is the path as the source spelled it; `resolved` is the canonical
/// name it bound to.  The relationship between the two - exact, abbreviated
/// suffix, or a shallower prefix needing a re-export - is what classifies the
/// churn, and it is computed offline from these two strings rather than here,
/// so the classification can be re-cut without a recompile.
public function path_hit(kind: string, use_site: string,
                         written: string, resolved: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("PATH-HIT\t%s\t%s\t%s\t%s\n", kind, use_site, written, resolved);
}
/// Log one OUTCOME of the type cascade in `sema/type_utils.cryo`, naming the
/// step that answered and the call site that asked.
///
/// The cascade answers one question - "what type does this name mean?" - in
/// four ways, and only the last of them is tallied.  A tally could say how
/// many names the last step served; it cannot say whether the three before it
/// were widening a name that had no exact answer or overriding one that did,
/// and that difference is what decides whether a step can be deleted.
///
/// Emitted once per CALL, on every exit including the one that answers
/// nothing.  Every call leaves through exactly one of them, so the row count
/// equals the call count - which is the control that says whether rows are
/// being dropped.  A step tally with no such identity cannot tell a genuine
/// zero from a stream that was never reached.
///
/// `site` is threaded from the caller rather than recovered from a stack the
/// compiler does not keep: the migration this sizes is per-call-site, and a
/// name alone cannot say which caller needs a scope.  `control` is what the
/// EXACT lookup would have answered in the same place, and it is meaningful
/// only where the exact lookup has not already run - the steps where it has
/// say so rather than re-asking a question whose answer is fixed.
public function type_cascade(site: string, step: string, asked: string,
                             answered_as: string, control: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("TYPE-CASCADE\t%s\t%s\t%s\t%s\t%s\n",
                 site, step, asked, answered_as, control);
}

/// Log one module-scope segment that was NOT stamped although some module
/// spells it, naming which of the two refusals fired.
///
/// Emitted at the refusal rather than tallied, for the same reason as
/// `vis_gate_reject`: the end-of-run report prints only after a successful
/// link, and the corpus most likely to name a module its writer cannot see is
/// the compile_fail corpus, which never gets there.  A zero pooled from
/// linking projects alone is a zero measured over the population that by
/// construction has no such case.
///
/// `reason` is `UNREACHABLE` (a module carries the spelling, the writer cannot
/// reach it) or `AMBIGUOUS` (two reachable modules carry it, so the spelling
/// names neither).  `cand` is one matching namespace: the count says how big
/// the case is, only the namespace says what it is.
public function scope_res_refused(reason: string, use_site: string,
                                  written: string, cand: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("SCOPE-RES-REFUSED\t%s\t%s\t%s\t%s\n",
                 reason, use_site, written, cand);
}

/// Log one module-scope segment that WAS stamped.
///
/// The control for `scope_res_refused`'s zero, and the same role `vis_record`
/// plays for `vis_violation`: on a build that does not link there is no
/// end-of-run tally, so "no refusals" and "this lane was never reached" emit
/// exactly the same nothing.  Pair the two counts and the zero becomes
/// readable.
public function scope_res_stamped(use_site: string, written: string,
                                  cand: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("SCOPE-RES-STAMPED\t%s\t%s\t%s\n", use_site, written, cand);
}

/// Log one settled module scope that does not declare the member under its own
/// name - the call resolves to nothing and the caller diagnoses an unknown path.
///
/// Emitted at the event for the same reason as `scope_res_refused`.  The
/// qualified name is what classifies it - a re-export puts the declaration in
/// another namespace, and only the pair says which.
public function scope_res_member_miss(stamped_ns: string, member: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("SCOPE-RES-MEMBER-MISS\t%s\t%s\n", stamped_ns, member);
}

/// Dump one `module -> visible namespace` edge, so the offline classifier can
/// ask the compiler's OWN reachability question ("is this first segment in
/// scope here?") instead of re-deriving it with a regex over import lines,
/// which cannot see the prelude or brace-list items.
public function path_scope(ns: string, visible: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("PATH-SCOPE\t%s\t%s\n", ns, visible);
}

/// Dump one prelude namespace - in scope everywhere, so a path rooted at one
/// needs no import no matter where it is written.
public function path_prelude(ns: string) -> void {
    if (!Audit::Path.enabled()) { return; }
    fmt::eprintf("PATH-PRELUDE\t%s\n", ns);
}

/// Log one trait-declaration registry lookup, naming the CALL SITE that asked.
///
/// A leaf and an identity are both `SymbolStr`, so a consumer that keeps
/// asking by leaf type-checks and then misses silently; nothing in the type
/// system can catch it.  `key` is what classifies the ask - a key carrying no
/// `::` is a leaf - and `site` is the only thing that says which consumer
/// produced it, which is why the parameter is threaded rather than recovered
/// from a call stack the compiler does not keep.
/// Log one `TraitRef::identity()` call that fell back to the written leaf.
///
/// The fallback is silent by construction - a leaf and an identity share
/// one type - so the span is the only thing that says WHICH bound was
/// never stamped, and therefore which owner the stamping walk misses.
public function trait_ref_unstamped(file: string, line: u32) -> void {
    if (!Audit::Trait.enabled()) { return; }
    fmt::eprintf("TRAITREF-UNSTAMPED\t%s\t%u\n", file, line);
}

public function trait_decl_lookup(site: string, key: string,
                                  outcome: string) -> void {
    if (!Audit::Trait.enabled()) { return; }
    fmt::eprintf("TRAIT-DECL-LOOKUP\t%s\t%s\t%s\n",
                 site, key, outcome);
}

/// Print one body-annotation context where the module that WROTE the body and
/// the ambient cursor name different modules (§8, task #7).
///
/// `file` is carried because the two namespaces alone do not identify the
/// body: the whole point of the divergence is that one module's function is
/// being checked while the walk stands in another, and only the file says
/// which function.  Emitted at the event, so it survives a failing build -
/// see `vis_gate_reject` for why that matters.
public function body_ns_diff(file: string, syntax_ns: string,
                             cursor_ns: string) -> void {
    if (!Audit::Scope.enabled()) { return; }
    fmt::eprintf("BODY-NS\t%s\t%s\t%s\n", file, syntax_ns, cursor_ns);
}

/// Print one MONO-side resolution context, naming (a) the file whose syntax it
/// is about to resolve, (b) the module of the ENTITY the context could derive a
/// home from, and (c) the ambient cursor.
///
/// Mono cannot call `module_ns_of_file`: `compilation_context.cryo` imports
/// `Compiler::Mono::Monomorphizer`, so the reverse edge is a module cycle.  That
/// leaves two candidate mechanisms for the `template` row (spec §8.2l) - derive
/// the home from an entity already in hand (a `TemplateEntry`, an owner type),
/// or plumb a file -> namespace map into mono - and the choice between them is
/// only decidable by measuring whether the entity's module and the file's module
/// ever disagree.  They disagree exactly when a body is written in an impl block
/// that lives in neither the trait's nor the owner type's module.
///
/// `file` is printed raw rather than mapped here, so the file -> namespace step
/// happens offline against each file's own `namespace` declaration - the one
/// derivation that cannot be contaminated by the thing being measured.
/// `home` is what mono actually derived through the graph.  It is printed
/// alongside rather than trusted: an empty `home` on a populated `file` is the
/// signal that the map is not reaching this call site at all, which looks
/// identical to "the change is safe here" if only the totals are read (§4.6).
public function mono_home(kind: string, file: string, entity_ns: string,
                          cursor_ns: string, home: string) -> void {
    if (!Audit::Scope.enabled()) { return; }
    fmt::eprintf("MONO-HOME\t%s\t%s\t%s\t%s\t%s\n", kind, file, entity_ns,
                 cursor_ns, home);
}

// ---- Reporting ---------------------------------------------------------

/// Drop every tally back to zero.  Exists so a driver that compiles more
/// than one unit in a process can attribute counts per unit.
public function reset() -> void {
    for (mut i: i64 = 0; i < TALLY_CAP; i++) {
        g_tally[i] = 0;
    }
    g_tally_dropped = 0;
}

/// Whether `CRYO_RESOLVE_COUNTER` is set in the environment.
public function enabled() -> boolean {
    match (env::var(Str::new("CRYO_RESOLVE_COUNTER"))) {
        Option::Some(_) => { return true;  }
        Option::None    => { return false; }
    }
}

/// Print the tally to stderr.  No-op unless `CRYO_RESOLVE_COUNTER` is set.
///
/// B1 total is the number the unification effort drives to zero; it is
/// printed last so it is the final thing on screen.
public function report() -> void {
    if (!enabled()) { return; }
    if (g_reported) { return; }
    g_reported = true;

    fmt::eprintf("\n");
    fmt::eprintf("=============== name-resolution counter ===============\n");
    fmt::eprintf("  B1 = fuzzy fallback        -> must reach ZERO\n");
    fmt::eprintf("  B2 = type-dependent lookup -> stays; enumerate+justify\n");
    fmt::eprintf("  B3 = authoritative lookup  -> once per path, NOT zero\n");
    fmt::eprintf("  B4 = instantiation id      -> stays; a Res cannot name one\n");
    fmt::eprintf("\n");
    fmt::eprintf("  Sites NEST: cascade step 5 is a subset of leaf-index\n");
    fmt::eprintf("  hits, and bare_alts hits are a subset of its callers'\n");
    fmt::eprintf("  calls.  Totals are taken over a DISJOINT selection and\n");
    fmt::eprintf("  count site events, not distinct resolutions.\n");
    fmt::eprintf("\n");

    // Printed FIRST, and loudly: every row below is unreadable while this is
    // non-zero, because the rows that lost their bumps still print a plausible
    // 0.  A gate comparing those zeros to a golden would read the blindness as
    // progress rather than as an unmeasured counter.
    if (g_tally_dropped > 0) {
        fmt::eprintf("!! TALLY OVERFLOW: %llu bumps discarded -- a Site index is\n",
                     g_tally_dropped);
        fmt::eprintf("!! outside g_tally (capacity %d).  Rows below may read 0\n",
                     TALLY_CAP);
        fmt::eprintf("!! WITHOUT having been measured.  Raise TALLY_CAP.\n");
        fmt::eprintf("\n");
    }

    fmt::eprintf("-- resolve_named cascade (types/resolver.cryo:1324) ----\n");
    Site::RnCalls.print_row();
    Site::RnGenericBinding.print_row();
    Site::RnAssocProjection.print_row();
    Site::RnPrimitive.print_row();
    Site::RnHomeModule.print_row();
    Site::RnHomeModuleSyntax.print_row();
    Site::RnAmbiguous.print_row();
    Site::RnDiLiteral.print_row();
    Site::RnDiCanonical.print_row();
    Site::RnDiBare.print_row();
    Site::McCalls.print_row();
    Site::McOwnerSymbolic.print_row();
    Site::McOwnerTemplate.print_row();
    Site::McAbstractReceiver.print_row();
    Site::McNoTypeSym.print_row();
    Site::McInheritance.print_row();
    Site::McBoundsPostSym.print_row();
    Site::McTraitImpls.print_row();
    Site::McFieldFn.print_row();
    Site::McCopyDrop.print_row();
    Site::McDerefCoercion.print_row();
    Site::McFailed.print_row();
    Site::RnLeafIndex.print_row();
    Site::RnFailed.print_row();

    fmt::eprintf("\n-- global leaf index (types/arena.cryo:1023) ----------\n");
    Site::LeafCalls.print_row();
    Site::LeafHits.print_row();
    Site::LeafViaResolveNamed.print_row();
    Site::LeafViaResolverBound.print_row();
    Site::LeafViaSymbolicCheck.print_row();
    Site::LeafViaTypeUtils.print_row();
    Site::LeafViaTypeResBound.print_row();

    fmt::eprintf("
-- const-table bare leaf (const_table.cryo) -----------
");
    Site::ConstLeafCalls.print_row();
    Site::ConstLeafHits.print_row();

    fmt::eprintf("\n-- DeclarationIndex bare_alts (decl_index.cryo:1405) --\n");
    Site::BareAltsCalls.print_row();
    Site::BareAltsHits.print_row();
    Site::BareAltsMulti.print_row();
    Site::BareAltsViaScoped.print_row();
    Site::BareAltsViaCanonical.print_row();
    Site::BareAltsCanonFolded.print_row();
    Site::BareAltsViaAmbigDiag.print_row();

    fmt::eprintf("\n-- visibility gate blast radius (spec §8.1) -----------\n");
    Site::ScopeUseSyntax.print_row();
    Site::ScopeUseCursor.print_row();
    Site::ScopeUseDiff.print_row();
    Site::DefaultArgNoOwner.print_row();
    Site::VisFastpath.print_row();
    Site::VisWouldReject.print_row();
    Site::VisRejectUnreachable.print_row();
    Site::VisRejectNotPublic.print_row();

    fmt::eprintf("\n-- free-fn bare-call binder (spec §3.3, §4) ----------\n");
    Site::FnBindSingle.print_row();
    Site::FnBindSingleHidden.print_row();
    Site::FnBindPrivateBound.print_row();
    Site::FnBindStampedRet.print_row();
    Site::FnBindUseSyntax.print_row();
    Site::FnBindUseCursor.print_row();
    Site::FnBindUseDiff.print_row();
    Site::FnBindVisReject.print_row();
    Site::FnBindVisQualified.print_row();
    Site::FnBindVisSingle.print_row();
    Site::FnBindVisPlural.print_row();
    Site::FnBindVisRetLane.print_row();
    Site::FnBindVisValueBare.print_row();
    Site::FnBindVisValueQual.print_row();
    Site::MethodVisReject.print_row();
    Site::MethodVisMember.print_row();
    Site::MethodVisStatic.print_row();

    fmt::eprintf("\n-- scope tiers (spec §4 rules 1-2) --------------------\n");
    Site::ScopeDeclOverImport.print_row();
    Site::ScopeImportShadowed.print_row();
    Site::ScopeAmbigRetracted.print_row();

    fmt::eprintf("\n-- body annotation provenance (spec §8, task #7) ------\n");
    Site::BodyNsOwner.print_row();
    Site::BodyNsSyntax.print_row();
    Site::BodyNsCursor.print_row();
    Site::BodyNsDiff.print_row();


    fmt::eprintf("\n-- namespace-suffix matchers --------------------------\n");
    Site::M1AgreeCalls.print_row();
    Site::M1AgreeHits.print_row();
    Site::M1QualReject.print_row();
    Site::M1LeafMiss.print_row();
    Site::M2Calls.print_row();
    Site::M4Calls.print_row();
    Site::M4Hits.print_row();
    Site::M5Calls.print_row();
    Site::M5Hits.print_row();

    fmt::eprintf("\n-- module-scope Res, stamped on the node ---------------\n");
    Site::ScopeResStamped.print_row();
    Site::ScopeResNoModule.print_row();
    Site::ScopeResTypeScope.print_row();
    Site::ScopeResNoBind.print_row();
    Site::ScopeResWalked.print_row();
    Site::ScopeResNoBase.print_row();
    Site::ScopeResUnanswerable.print_row();
    Site::ScopeResUnreachable.print_row();
    Site::ScopeResAmbiguous.print_row();
    Site::M2ViaStamp.print_row();
    Site::M2StampMemberMiss.print_row();
    Site::SynthScopeResStamped.print_row();
    Site::SynthScopeResNoName.print_row();

    fmt::eprintf("
-- impl-head target stamp, at the async declare walk ---
");
    Site::ImplHeadSeen.print_row();
    Site::ImplHeadUnstamped.print_row();
    Site::ImplHeadAsync.print_row();
    Site::ImplHeadAsyncUnstamped.print_row();
    Site::CgImplTargetSeen.print_row();
    Site::CgImplTargetUnstamped.print_row();
    Site::CgImplTargetUnResDef.print_row();
    Site::CgImplTargetUnResPrim.print_row();
    Site::CgImplTargetUnResPend.print_row();
    Site::CgImplTargetUnResOther.print_row();
    Site::M4Single.print_row();
    Site::SfCalls.print_row();
    Site::SfScanNone.print_row();
    Site::SfScanOne.print_row();
    Site::SfScanPlural.print_row();
    Site::SfViaRes.print_row();
    Site::SpellTyPending.print_row();
    Site::SpellTyNoDef.print_row();
    Site::SpellTyHit.print_row();
    Site::SpellTyDefMissing.print_row();
    Site::SpellTyNewStep2.print_row();
    Site::SpellTyNewStep3.print_row();
    Site::AnnResPrimTy.print_row();
    Site::SpellTyLitNoDef.print_row();
    Site::SpellTyNewNoDef.print_row();
    Site::SpellTyIdNoDef.print_row();
    Site::ImplResVisit.print_row();
    Site::ImplResStamped.print_row();
    Site::ImplResDeclined.print_row();
    Site::SpellTyImplCalls.print_row();
    Site::SpellTyImplResDef.print_row();
    Site::SpellTyImplResPrim.print_row();
    Site::SpellTyImplResPend.print_row();
    Site::SpellTyImplResOther.print_row();
    Site::SpellTyLitCalls.print_row();
    Site::SpellTyLitFbHit.print_row();
    Site::SpellTyLitFbMiss.print_row();
    Site::SpellTyNewCalls.print_row();
    Site::SpellTyNewFbHit.print_row();
    Site::SpellTyNewFbMiss.print_row();
    Site::SpellTyIdCalls.print_row();
    Site::SpellTyIdFbHit.print_row();
    Site::SpellTyIdFbMiss.print_row();
    Site::M4ScanNone.print_row();
    Site::M4ScanOne.print_row();
    Site::M4ScanPlural.print_row();
    Site::M4ResDef.print_row();
    Site::M4ResOther.print_row();
    Site::M4ResPending.print_row();
    Site::M4ResAgree.print_row();
    Site::M4ResDiffers.print_row();
    Site::M4ResNoTemplate.print_row();
    Site::M4PreAgree.print_row();
    Site::M4PreDiffers.print_row();
    Site::M4PreNoStamp.print_row();
    Site::M4ViaRes.print_row();

    fmt::eprintf("\n-- annotation Res, stamped on the node -----------------\n");
    Site::AnnResSeen.print_row();
    Site::AnnResDef.print_row();
    Site::AnnResGenericParam.print_row();
    Site::AnnResQualified.print_row();
    Site::AnnResTypeRelative.print_row();
    Site::AnnResNoHome.print_row();
    Site::AnnResNoHomeScope.print_row();
    Site::AnnResUnresolved.print_row();

    // Bucket totals, over DISJOINT selections.
    //
    // B1 counts ANSWERS PRODUCED (hits, cascade outcomes), never attempts:
    // a fallback that is called but returns nothing is not load-bearing,
    // and counting attempts would make "drive it to zero" unreachable for
    // the wrong reason.  Cascade step 5 is deliberately NOT added - it is
    // already inside `Site::LeafHits`, and adding both double-counts it.
    //
    // `M1AgreeHits` is excluded for the same reason and is the clearest case
    // of it: `qualifier_agrees` is a CHECK.  Its `true` lets an answer another
    // lookup already produced stand, so summing it counts that answer twice
    // and credits the fallback bucket with work no fallback did.  The row
    // stays flagged and asserted - a validator that starts agreeing with
    // something it used to refuse is a resolution change, and the golden must
    // still catch it - it just is not a summand.
    mut b1: u64 = 0;
    b1 = b1 + Site::RnHomeModule.count();
    b1 = b1 + Site::RnAmbiguous.count();
    b1 = b1 + Site::ConstLeafHits.count();
    b1 = b1 + Site::BareAltsViaAmbigDiag.count();
    b1 = b1 + Site::M4Hits.count();
    b1 = b1 + Site::M5Hits.count();

    // `resolve_method_call`'s outcome cascade plus the assoc-type projection.
    // Still a FLOOR, for one named reason: overload selection
    // (`resolve_method_overload`) and member access outside a call are not
    // counted, so a method reached by those routes is missing here.
    mut b2: u64 = Site::RnAssocProjection.count();
    b2 = b2 + Site::McOwnerSymbolic.count();
    b2 = b2 + Site::McOwnerTemplate.count();
    b2 = b2 + Site::McAbstractReceiver.count();
    b2 = b2 + Site::McInheritance.count();
    b2 = b2 + Site::McBoundsPostSym.count();
    b2 = b2 + Site::McTraitImpls.count();
    b2 = b2 + Site::McFieldFn.count();
    b2 = b2 + Site::McCopyDrop.count();
    b2 = b2 + Site::McDerefCoercion.count();

    // B3 is authoritative resolution: correct mechanisms that answer from
    // scope/imports rather than by guessing.  The unification target for
    // these is ONCE PER PATH, not zero - today they are re-derived by every
    // downstream stage, which is what §3.2 rule 2 is really about.
    mut b3: u64 = 0;
    b3 = b3 + Site::RnGenericBinding.count();
    b3 = b3 + Site::RnPrimitive.count();
    b3 = b3 + Site::RnDiLiteral.count();
    b3 = b3 + Site::RnHomeModuleSyntax.count();
    b3 = b3 + Site::RnDiCanonical.count();
    b3 = b3 + Site::RnDiBare.count();
    b3 = b3 + Site::BareAltsViaScoped.count();
    // `canonical_qualified` is authoritative rather than fuzzy: it never
    // answers "which declaration does this name bind to", only "what is this
    // type's module-independent identity", and it folds ONLY when exactly one
    // qualified candidate is registered - a colliding leaf is handed back
    // bare.  Its consumers are coherence keys, which must key the same type
    // identically from every module, so a use-site-dependent answer would be
    // the defect here and not the fix.
    //
    // Summed by what it FOLDED, not by how often it was called: the call row
    // is bumped on entry, and a call that hands its input back produced
    // nothing the caller would not have had anyway.  Both rows are pinned by
    // the gate regardless - a caller that starts asking more often, or a new
    // one that uses this to BIND rather than to key, is the change worth
    // catching, and it would be invisible in an unasserted bucket.
    b3 = b3 + Site::BareAltsCanonFolded.count();

    // B4 is instantiation identity.  A `Res` names a DECLARATION; an
    // instantiation is minted by monomorphization afterwards and is asked for
    // by its MANGLED name, which no source file contains and no import brings
    // into scope - so no amount of name-layer correctness answers it.  Counting
    // it against B1's target of zero makes that target permanently false and
    // hides whatever real fuzzy fallback might regrow underneath it.
    //
    // Cascade step 5 is NOT added: it is already inside `LeafHits`, the same
    // nesting that keeps it out of B1's sum.
    const b4: u64 = Site::LeafHits.count();

    fmt::eprintf("\n-------------------------------------------------------\n");
    fmt::eprintf("  B1 fuzzy fallback   -> ZERO           %12llu\n", b1);
    fmt::eprintf("  B2 type-dependent   -> stays (FLOOR)  %12llu\n", b2);
    fmt::eprintf("  B3 authoritative    -> once per path  %12llu\n", b3);
    fmt::eprintf("  B4 instantiation id -> stays (FLOOR)  %12llu\n", b4);
    fmt::eprintf("=======================================================\n");
}
