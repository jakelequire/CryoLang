/// ModulePath
///
/// A module's canonical namespace path - `std::fs`, `compiler::resolver` -
/// which is the module's identity: a module and a type can never carry the
/// same name, and the graph registers every module under exactly one path.
///
/// It is a type of its own so that a door asking for a MODULE cannot be
/// handed a spelling that names something else.  A `SymbolStr` holds a leaf
/// (`fs`), a composed path (`Outer::inner`) and a canonical one alike, and a
/// door taking one cannot tell them apart; a leaf handed to a module lookup
/// answers "no such module" for a module that exists, and a namespace compared
/// against a leaf answers "not imported" for one that is.
///
/// `of` is the one way in, and it is not a lookup: it asserts that the caller
/// already holds a module's path - a module's own registration, a file's
/// `namespace` declaration, a declaration's recorded home, a path the graph
/// handed back.

namespace compiler::resolver::module_path;

import compiler::resolver::symbol_str;
import compiler::resolver::symbol_str::{ SymbolStr };

type struct ModulePath {
    sym: SymbolStr;

    /// The path of a module the caller already holds.
    static of(sym: SymbolStr) -> ModulePath {
        return ModulePath { sym: sym };
    }

    /// No module.
    static none() -> ModulePath {
        return ModulePath { sym: SymbolStr::empty() };
    }

    is_valid(&this) -> boolean {
        return this.sym.is_valid();
    }

    equals(&this, other: ModulePath) -> boolean {
        return this.sym.equals(other.sym);
    }

    /// The path as interned text, for a store keyed by it and for display.
    as_sym(&this) -> SymbolStr {
        return this.sym;
    }
}
