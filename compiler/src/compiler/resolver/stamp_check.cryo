/// The name layer's exit check.
///
/// Every written name is resolved once, where it is written: the name layer
/// stamps the node that carries it, or refuses it there (a refusal is an
/// answer too).  This walks a module's whole tree after the name layer has
/// run over it and counts every name-bearing slot still unanswered - an
/// identifier, a path's scope segment, a struct literal's or `new`'s type
/// name, an enum pattern's enum, a constant named by a pattern, a written
/// type name, an impl's target, a class's base, a trait a bound names.
///
/// It is a walk of its own, not a tally the name layer keeps: a node the
/// name layer never reached is exactly the defect, and a tally kept by the
/// walker that missed it would miss it too.  It is a `Walk`, so it reaches
/// every child the tree has and every annotation, bound and named trait a
/// node holds; it overrides only the hooks of the slots that carry a name.
/// Member names (`a.b`) and calls are not here; they are answered by the
/// type check and by monomorphization.
namespace compiler::resolver::stamp_check;

import compiler::ast;
import compiler::ast::{
    declaration, expression, statement, pattern, node, NamedAnnotation,
    TraitBound, TraitRef, TypeAnnotation
};
import compiler::ast::declaration::{
    ClassDeclNode, DeclarationNode, ImplBlock, MethodDecl
};
import compiler::ast::expression::{
    ExpressionNode, IdentifierExpr, NewExpr, ScopeResolutionExpr, StructExpr
};
import compiler::ast::node::{ ProgramNode };
import compiler::ast::pattern::{ ConstantPattern, EnumPattern, Pattern };
import compiler::ast::walk::{ Walk };
import compiler::diag::source_span::{ SourceSpan };
import compiler::resolver::res::{ ResSlot };
import std::fmt;

/// Which kind of name-bearing slot was left unanswered, for the report.
type enum StampSite {
    Identifier;
    PathScope;
    StructLiteral;
    NewType;
    EnumPattern;
    ConstantPattern;
    TypeName;
    ImplTarget;
    BaseClass;
    TraitInBound;
}

implement enum StampSite {
    label(&this) -> string {
        return match (this) {
            StampSite::Identifier      => { "identifier" }
            StampSite::PathScope       => { "path scope" }
            StampSite::StructLiteral   => { "struct literal type" }
            StampSite::NewType         => { "type in `new`" }
            StampSite::EnumPattern     => { "enum pattern" }
            StampSite::ConstantPattern => { "constant pattern" }
            StampSite::TypeName        => { "type name" }
            StampSite::ImplTarget      => { "impl target" }
            StampSite::BaseClass       => { "base class" }
            StampSite::TraitInBound    => { "trait in a bound" }
        };
    }
}

type struct StampCheck {
    /// Name-bearing slots found unanswered.
    unanswered: u64;
    /// Where the first one was written, and what it is.
    first_site: string;
    /// Set only by the compiler's own test of this check: the label of a
    /// kind of slot (`"identifier"`, `"enum pattern"`, ...), the first slot
    /// of which is counted as unanswered whatever it holds, so a correct
    /// program exercises the refusal at that kind of name.  Cleared once
    /// spent; empty in every real build.
    plant: string;

    static new(plant: string) -> StampCheck {
        return StampCheck { unanswered: 0, first_site: "", plant: plant };
    }

    /// A slot no resolver answered.  `Lang` is a claimed language item,
    /// settled once the item is registered: an answer, not an absence.
    static unanswered_slot(slot: &ResSlot) -> boolean {
        return match (slot) {
            ResSlot::Pending => { true }
            _                => { false }
        };
    }

    note(mut &this, slot: &ResSlot, what: StampSite, span: SourceSpan) -> void {
        mut planted: boolean = false;
        if (this.plant.length() > 0 && this.plant == what.label()) {
            planted = true;
            this.plant = "";
        }
        if (!planted && !StampCheck::unanswered_slot(slot)) { return; }
        this.note_missing(what, span);
    }

    note_missing(mut &this, what: StampSite, span: SourceSpan) -> void {
        if (this.unanswered == 0) {
            this.first_site = fmt::format("%s at %s:%d:%d", what.label(), span.file,
                span.start_line as i64, span.start_col as i64);
        }
        this.unanswered = this.unanswered + 1;
    }

    check_program(mut &this, program: ProgramNode*) -> void {
        if (program == null) { return; }
        this.walk_program(program);
    }
}

implement trait Walk for struct StampCheck {
    /// The program's items, then its `static_assert` conditions.
    walk_program(mut &this, n: ProgramNode*) -> void {
        ProgramNode::walk_children(n, this);
        for (mut i: i64 = 0; i < n.static_asserts.length; i++) {
            this.walk_expr(n.static_asserts[i].cond);
        }
    }

    walk_identifier(mut &this, e: ExpressionNode*, n: IdentifierExpr*) -> void {
        this.note(&n.res, StampSite::Identifier, e.span);
        IdentifierExpr::walk_children(n, this);
    }

    walk_scope_resolution(mut &this, e: ExpressionNode*, n: ScopeResolutionExpr*) -> void {
        this.note(&n.scope_res, StampSite::PathScope, n.scope_span);
        ScopeResolutionExpr::walk_children(n, this);
    }

    walk_struct_literal(mut &this, e: ExpressionNode*, n: StructExpr*) -> void {
        this.note(&n.res, StampSite::StructLiteral, e.span);
        StructExpr::walk_children(n, this);
    }

    walk_new(mut &this, e: ExpressionNode*, n: NewExpr*) -> void {
        this.note(&n.res, StampSite::NewType, e.span);
        NewExpr::walk_children(n, this);
    }

    walk_enum_pattern(mut &this, p: Pattern*, n: EnumPattern*) -> void {
        this.note(&n.res, StampSite::EnumPattern, n.enum_span);
        EnumPattern::walk_children(n, this);
    }

    walk_constant_pattern(mut &this, p: Pattern*, n: ConstantPattern*) -> void {
        this.note(&n.res, StampSite::ConstantPattern, p.span);
    }

    walk_impl(mut &this, d: DeclarationNode*, n: ImplBlock*) -> void {
        this.note(&n.res, StampSite::ImplTarget, n.target_type_span);
        ImplBlock::walk_children(n, this);
    }

    walk_class(mut &this, n: ClassDeclNode*) -> void {
        if (n.base_class.is_valid()) { this.note(&n.base_res, StampSite::BaseClass, n.base_span); }
        ClassDeclNode::walk_children(n, this);
    }

    /// A method's function, then a constructor's base-constructor arguments.
    walk_method(mut &this, d: DeclarationNode*, n: MethodDecl*) -> void {
        MethodDecl::walk_children(n, this);
        for (mut i: i64 = 0; i < n.base_ctor_args.length; i++) { this.walk_expr(n.base_ctor_args[i]); }
    }

    /// A written type: each name in it, and the expressions it holds (an
    /// array's length, a `typeof` operand).  A primitive and `This` carry no
    /// written name to answer.
    walk_annotation(mut &this, ann: TypeAnnotation*) -> void {
        if (ann == null) { return; }
        match (*ann) {
            TypeAnnotation::Named(n) => {
                if (n != null) { this.note(&n.res, StampSite::TypeName, n.span); }
            }
            TypeAnnotation::Pointer(p)   => { if (p != null) { this.walk_annotation(p.inner); } }
            TypeAnnotation::Reference(r) => { if (r != null) { this.walk_annotation(r.inner); } }
            TypeAnnotation::Array(a) => {
                if (a != null) {
                    this.walk_annotation(a.element);
                    this.walk_expr(a.size_expr);
                }
            }
            TypeAnnotation::Function(f) => {
                if (f != null) {
                    this.walk_annotations(&f.parameters);
                    this.walk_annotation(f.return_type);
                }
            }
            TypeAnnotation::Tuple(t) => { if (t != null) { this.walk_annotations(&t.elements); } }
            TypeAnnotation::Generic(g) => {
                if (g != null) {
                    this.walk_annotation(g.base);
                    this.walk_annotations(&g.args);
                }
            }
            TypeAnnotation::Typeof(t) => { if (t != null) { this.walk_expr(t.operand); } }
            TypeAnnotation::ImplTrait(it) => { if (it != null) { this.walk_annotations(&it.bounds); } }
            TypeAnnotation::Projection(p) => { if (p != null) { this.walk_annotation(p.base); } }
            _ => { }
        }
    }

    walk_bound(mut &this, b: &TraitBound) -> void {
        this.walk_annotation(b.subject_type);
        this.walk_trait_refs(&b.trait_refs);
    }

    walk_trait_ref(mut &this, r: &TraitRef) -> void {
        if (!r.resolved.is_valid() && !r.refused) { this.note_missing(StampSite::TraitInBound, r.span); }
        this.walk_annotations(&r.type_args);
    }
}
