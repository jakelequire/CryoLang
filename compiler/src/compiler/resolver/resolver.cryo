/// Resolver
///
/// The core Resolver struct.  Owns all symbols and scopes, builds the
/// scope tree, and holds the resolution map.  Used during the NameResolution
/// pass to declare symbols and resolve names, then queried by downstream
/// passes via SymbolID lookups.

namespace compiler::resolver::resolver;

import std::fmt;
import compiler::module_graph;
import compiler::module_graph::{ ModuleGraph };
import compiler::resolver;
import compiler::resolver::{ symbol_id, symbol_str, intern_table, symbol, scope, resolution_map };
import compiler::resolver::res;
import compiler::resolver::res::{ DefId, Res, ResBase, DefTable, DefKind };
import compiler::resolver::namespace_kind;
import compiler::resolver::namespace_kind::{ Namespace };
import compiler::diag;
import compiler::diag::source_span;
import compiler::diag::source_span::{ SourceSpan };
import std::collections::{ pair, hashmap };
import std::core::option;
import std::core::option::{ Option };
import utils::logger;
import utils::logger::{ cdebug, LOG_DEBUG, LogComponent };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::resolution_map::{ ResolutionMap };
import compiler::resolver::scope::{ Scope, ScopeID, ScopeKind };
import compiler::resolver::symbol::{ Symbol, SymbolKind };
import compiler::resolver::symbol_id::{ SymbolID, SymbolIds };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::module_graph::{ ModulePath };
import std::collections::hashmap::{ HashMap };
import std::collections::pair::{ Pair };
import utils::text::{ Text };

type struct Resolver {
    /// The compilation's definitions, for a definition's path.  Borrowed;
    /// set by `CompilationContext`, which owns it.
    defs: DefTable*;
    /// The module graph, for the definition a declaring symbol's module is:
    /// a declaration's id is registered under its module's.
    graph: ModuleGraph*;
    // Intern table: borrowed pointer, owned by CompilationContext
    intern_table:       InternTable*;

    // Symbol arena
    symbols:            Symbol[];
    symbol_ids:         SymbolIds;

    // Scope tree
    scopes:             Scope[];
    next_scope_id:      u64;
    global_scope:       ScopeID;
    current_scope:      ScopeID;

    // Resolution map
    resolution_map:     ResolutionMap;

    // Cross-module exports: Pair<SymbolID, u64>[] avoids T[][] codegen
    // paths.  SymbolID[][] and HashMap<K, SymbolID[]>
    // mishandle T[] as a generic type argument (inner array descriptor
    // corrupted on store/load).  Pair<A,B>[] sidesteps generic-over-array
    // codegen entirely.
    exports:              Pair<SymbolID, u64>[];  // .first = exported symbol, .second = module key (SymbolStr.id)


    // Current context
    current_module:     ModulePath;

    /// The namespaces a file can name WITHOUT importing them.
    ///
    /// §4's tier chain ends at the prelude, and until this existed the chain
    /// stopped one tier short: the scope walk knew about a module's own
    /// declarations and its imports, and nothing at all about the names that
    /// are reachable by default.  A file writing `Option::Some` while importing
    /// no option module therefore bound nothing, and the answer came instead
    /// from a leaf-index search that is not scoped to the writer at all - which
    /// is the mechanical origin of the fallback this subsystem is retiring.
    ///
    /// Held as namespaces rather than as copied symbols so the tier stays one
    /// list instead of a per-module duplication of every prelude export, and so
    /// it shadows correctly: it is consulted only after every real scope has
    /// been asked, which is what makes an inner declaration win.
    prelude_modules:    ModulePath[];

    // Index: interned module name id -> the id of that module's scope.  A
    // lookup would otherwise linear-scan every scope with a per-scope strcmp
    // (~3% frontend self-time combined).  One entry per module, never several:
    // the scope is built on first ask and reused, so there is no candidate set
    // to choose between.
    /// The one scope a module owns, by its interned name.
    ///
    /// A module scope is not a rib.  A rib - a function body, a block, a
    /// generic parameter list - is pushed on entry and popped on exit, and a
    /// stack is right for it.  A module is a persistent node: it is built once
    /// and looked up forever after, and entering one sets a pointer to
    /// something that already exists.  Treating the two alike is what made
    /// entering a module fourteen times produce fourteen scopes, only the
    /// third of them populated, and a save/restore mechanism necessary to
    /// paper over it.
    module_scopes: HashMap<u32, u64>;

    /// The traits a `where` clause bounds each type parameter by: `.first`
    /// the parameter's symbol, `.second` the trait's definition.  `S::Item`
    /// is `Item` of whichever of these traits declares it; a trait the
    /// parameter is not bounded by does not answer it, however it is spelled.
    param_bounds:  Pair<SymbolID, DefId>[];

    /// The declaration each import binding names, by the binding's key.  An
    /// import of a leaf binds every declaration the module offers under it,
    /// one binding each, so a type and a same-leaf function arrive as two
    /// bindings and each one's target is what a namespace chooses between.
    import_targets: HashMap<u64, SymbolID>;

    /// The import bindings an explicit entry - `import M::{ name }` - made,
    /// by binding.  A glob's bindings are not among them: a second explicit
    /// import of a name is refused against an explicit one only.
    explicit_imports: HashMap<u64, boolean>;

    /// Create a new Resolver with a global scope.
    /// Every pointer must outlive the Resolver (owned by CompilationContext).
    static new(table: InternTable*, defs: DefTable*, graph: ModuleGraph*) -> Resolver {
        const global_id: ScopeID = ScopeID::new(1);
        const global: Scope = Scope::new(
            global_id, ScopeKind::Global, ScopeID::invalid(),
            "<global>", SourceSpan::none()
        );

        return Resolver {
            defs: defs,
            graph: graph,
            intern_table:         table,
            symbols:              [],
            symbol_ids:           SymbolIds::new(),
            scopes:               [global],
            next_scope_id:        2,
            global_scope:         global_id,
            current_scope:        global_id,
            resolution_map:       ResolutionMap::new(),
            exports:              [],
            current_module:       ModulePath::none(),
            prelude_modules:      [],
            module_scopes:        HashMap::<u32, u64>::new(),
            param_bounds:         [],
            import_targets:       HashMap::<u64, SymbolID>::new(),
            explicit_imports:     HashMap::<u64, boolean>::new(),
        };
    }

    /// Record that the type parameter `param` is bounded by the trait `bound`.
    record_param_bound(mut &this, param: SymbolID, bound: DefId) -> void {
        if (!param.is_valid() || !bound.is_valid()) { return; }
        for (mut i: i64 = 0; i < this.param_bounds.length; i++) {
            if (this.param_bounds[i].first.equals(param) && this.param_bounds[i].second.equals(bound)) { return; }
        }
        this.param_bounds.push(Pair::<SymbolID, DefId>::new(param, bound));
    }

    /// The traits the type parameter `param` is bounded by, in the order its
    /// `where` clauses name them.
    bounds_of_param(&this, param: SymbolID) -> DefId[] {
        mut out: DefId[] = [];
        if (!param.is_valid()) { return out; }
        for (mut i: i64 = 0; i < this.param_bounds.length; i++) {
            if (this.param_bounds[i].first.equals(param)) { out.push(this.param_bounds[i].second); }
        }
        return out;
    }


    // Scope management

    /// Allocate and register a new scope as a child of the given parent.
    create_scope(mut &this, kind: ScopeKind, parent: ScopeID,
                 owner: string, span: SourceSpan) -> ScopeID {
        const id: ScopeID = ScopeID::new(this.next_scope_id);
        this.next_scope_id += 1;

        const scope: Scope = Scope::new(id, kind, parent, owner, span);
        this.scopes.push(scope);

        // Register as child of parent (O(1) direct index)
        if (parent.is_valid()) {
            this.scopes[parent.id - 1].add_child(id);
        }

        return id;
    }

    /// The module the ambient scope cursor is currently standing in.
    current_module_path(&this) -> ModulePath { return this.current_module; }

    /// Create a child scope of the current scope and move the cursor into it.
    enter_scope(mut &this, kind: ScopeKind, owner: string, span: SourceSpan) -> ScopeID {
        LOG_DEBUG(LogComponent::General, "[Resolver] enter_scope() kind=%s owner='%s'", kind.to_string(), owner);
        const id: ScopeID = this.create_scope(kind, this.current_scope, owner, span);
        this.current_scope = id;
        return id;
    }

    /// Move the cursor back to the parent scope.  Never exits past global.
    exit_scope(mut &this) -> void {
        LOG_DEBUG(LogComponent::General, "[Resolver] exit_scope()");
        const scope: Scope* = this.get_scope(this.current_scope);
        if (scope.parent_id.is_valid()) {
            this.current_scope = scope.parent_id;
        }
    }

    // Symbol declaration

    /// Allocate the next monotonic SymbolID.
    alloc_symbol_id(mut &this) -> SymbolID {
        return this.symbol_ids.next();
    }

    /// The identity of a binding a pass SYNTHESIZED after name resolution ran.
    ///
    /// Such a binding is never looked up by name - the pass that made it holds
    /// the declaration and every use it wrote - so it gets no scope entry and
    /// no `Symbol`.  What it does need is to be DISTINCT: a later pass keeping
    /// per-binding state has to tell it from an unrelated binding that happens
    /// to share its spelling, and the spelling cannot do that (a synthesized
    /// state-machine local and a user local can spell the same thing, and two
    /// synthesized ones in one body routinely do).
    ///
    /// Not a way to introduce a name.  A binding that a later reader must find
    /// BY NAME is declared, in a scope, through `declare_variable`.
    alloc_synthetic_binding(mut &this) -> SymbolID {
        return this.alloc_symbol_id();
    }

    /// Put a declaring symbol in the arena, stamped with the definition it is.
    ///
    /// The one place the name layer registers a definition: every
    /// declaration enters the arena through it, and an import enters carrying
    /// the id of the declaration it binds (`declare_import`), so an answer the
    /// name layer gives for any binding reads a stamp, and two answers for one
    /// binding cannot name two definitions.
    ///
    /// A binding a body introduces - a local, a parameter, a generic
    /// parameter - is not a definition and keeps `DefId::invalid()`: it is
    /// named by its `SymbolID`, and an answer for one is `Res::Local` or
    /// `Res::GenericParam`, never `Res::Def`.
    admit(mut &this, sym: Symbol) -> void {
        const at: i64 = this.symbol_ids.slot_of(sym.id);
        if (at != this.symbols.length) {
            panic(fmt::format(
                "internal compiler error: symbol admitted at arena slot %lld, its id names slot %lld",
                this.symbols.length, at), FILE, LINE);
        }
        this.symbols.push(sym);
        if (!this.is_definition(&this.symbols[at])) { return; }
        this.symbols[at].def = this.defs.register(
            this.declaring_module_def(&this.symbols[at]), this.symbols[at].name,
            this.def_kind_of(&this.symbols[at]), this.symbols[at].declaring_span);
    }

    /// The definition of the module `sym` is declared in; invalid for a
    /// symbol declared in no module.
    ///
    /// The symbol holds its module as the graph's identity, so this is the
    /// graph's definition for that module and nothing is looked up by text.
    declaring_module_def(&this, sym: &Symbol) -> DefId {
        if (!sym.source_module.is_valid()) { return DefId::invalid(); }
        return this.graph.module_def(sym.source_module);
    }

    /// Whether a declaring symbol is a definition this arena registers: an
    /// item a path can name from outside the body that declares it.  A
    /// variable is one only at module scope, where it is a global.  A method
    /// is a definition too, but its parent is its owner, which the symbol
    /// does not hold: the name layer registers it and the symbol arrives
    /// carrying the id (`declare_method`).
    is_definition(&this, sym: &Symbol) -> boolean {
        if (sym.kind == SymbolKind::Variable) {
            return this.scopes[(sym.scope_id.id - 1) as i64].kind == ScopeKind::Module;
        }
        return sym.kind == SymbolKind::Namespace
            || sym.kind == SymbolKind::Function
            || sym.kind == SymbolKind::Intrinsic
            || sym.kind == SymbolKind::Type
            || sym.kind == SymbolKind::TypeAlias
            || sym.kind == SymbolKind::Constant;
    }

    /// What kind of definition a declaring symbol is; `is_definition` holds.
    def_kind_of(&this, sym: &Symbol) -> DefKind {
        return match (sym.kind) {
            SymbolKind::Namespace => { DefKind::Module }
            SymbolKind::Type      => { DefKind::Type }
            SymbolKind::TypeAlias => { DefKind::Type }
            SymbolKind::Variable  => { DefKind::Value }
            SymbolKind::Constant  => { DefKind::Value }
            _                     => { DefKind::Function }
        };
    }

    /// Insert a symbol into the arena and current scope.
    /// Returns the SymbolID on success.  If the name already exists in the
    /// current scope and is not overloadable, the symbol is still added to
    /// the arena but NOT indexed in the scope; a debug log is emitted so
    /// the duplicate can be diagnosed without flooding the user.
    declare(mut &this, sym: Symbol) -> SymbolID {
        LOG_DEBUG(LogComponent::Resolver, "declare() symbol id=%lu", sym.id.key());
        const id: SymbolID = sym.id;
        this.admit(sym);

        // Insert into current scope (O(1) direct index)
        const allows_overload: boolean = sym.kind.allows_overload();
        const inserted: boolean = this.scopes[this.current_scope.id - 1]
            .insert(sym.name, id, allows_overload);

        if (!inserted) {
            LOG_DEBUG(LogComponent::Resolver,
                "duplicate declaration '%s' in scope '%s' (ignored)",
                this.intern_table.resolve(sym.name),
                this.scopes[this.current_scope.id - 1].owner_name);
        }

        return id;
    }

    /// Declare an import symbol with ambiguity detection.
    /// If the name already exists from a DIFFERENT module in the same
    /// namespace, the name is marked ambiguous in that namespace and the
    /// resolver will emit an error when it's used there without
    /// qualification (e.g. "use Pair" when both BattleTest::Pair and
    /// Collections::Pair::Pair are imported).
    ///
    /// The symbol carries the id of the declaration it binds, copied by the
    /// import that found it: an import is not a definition, so it is not
    /// admitted as one.  `target` is that declaration: one binding names one
    /// declaration, and a second declaration the same module offers under
    /// the leaf - a type beside a function - is a second binding of the
    /// name, held in the scope's overload set as the declaring module's own
    /// scope holds it.  The same declaration imported again binds nothing new.
    ///
    /// `explicit` is an entry of `import M::{ name }`, as opposed to a glob.
    /// An explicit entry whose name an earlier explicit entry already brought
    /// into this scope, in the namespace `target` is in, binds nothing, and
    /// the earlier binding is answered for the caller to refuse the import
    /// (E0243); a type and a function of one leaf are two namespaces and do
    /// not collide.  Otherwise the answer is invalid.  `check_repeat` is
    /// false for the entry's second and later declarations in a namespace -
    /// a function's overloads - which join the entry's own first binding.
    declare_import(mut &this, sym: Symbol, target: SymbolID, explicit: boolean,
                   check_repeat: boolean) -> SymbolID {
        const id: SymbolID = sym.id;
        const name: SymbolStr = sym.name;
        // Intern the module path to get a heap-safe SymbolStr ID
        const new_module_sym: SymbolStr = sym.source_module.as_sym();
        const new_module_id: u32 = new_module_sym.id;
        this.symbols.push(sym);
        this.import_targets.insert(id.key(), target);

        // Get the existing symbol's module ID (if any) so the scope
        // can detect cross-module name conflicts.
        mut existing_module_id: u32 = 0;
        const existing_id: SymbolID = this.scopes[this.current_scope.id - 1].find(name);
        if (existing_id.is_valid()) {
            // Every binding the scope holds under the name answers both
            // questions: whether an explicit entry already brought it in,
            // and whether one of them already names `target`.
            const all: SymbolID[] = this.scopes[this.current_scope.id - 1].get_overloads(name);
            if (explicit && check_repeat) {
                const first: SymbolID = this.binding_beside(&all, target, true);
                if (first.is_valid()) { return first; }
            }
            // The import this one competes with is the one in its namespace;
            // with none there, the name's first binding.
            const ex: Symbol = this.symbols[this.symbol_ids.slot_of(existing_id)];
            const rival: SymbolID = this.binding_beside(&all, target, false);
            const peer: Symbol = if (rival.is_valid()) { this.symbols[this.symbol_ids.slot_of(rival)] } else { ex };
            existing_module_id = peer.source_module.as_sym().id;
            if (ex.kind == SymbolKind::Import && existing_module_id == new_module_id) {
                const bound: SymbolID = this.binding_to(&all, target);
                if (!bound.is_valid()) {
                    this.scopes[this.current_scope.id - 1].add_overload(name, id);
                }
                if (explicit) {
                    this.explicit_imports.insert(if (bound.is_valid()) { bound.key() } else { id.key() }, true);
                }
                return SymbolID::invalid();
            }
            // Another module's item of the leaf in the OTHER namespace - a
            // function beside an imported type - is a second binding of the
            // name, not a rival for it: a lookup chooses between them by
            // namespace, as it does for one module's type and function.
            if (ex.kind == SymbolKind::Import && !rival.is_valid()) {
                this.scopes[this.current_scope.id - 1].add_overload(name, id);
                if (explicit) { this.explicit_imports.insert(id.key(), true); }
                return SymbolID::invalid();
            }
        }

        this.scopes[this.current_scope.id - 1]
            .insert_import(name, id, new_module_id, existing_module_id, this.namespace_of(target));
        if (explicit) { this.explicit_imports.insert(id.key(), true); }
        return SymbolID::invalid();
    }

    /// Among one name's `bindings`, the import binding whose target is
    /// `target`, or an invalid id.
    binding_to(&this, bindings: &SymbolID[], target: SymbolID) -> SymbolID {
        for (mut i: i64 = 0; i < bindings.length; i++) {
            const t: Option<SymbolID> = this.import_targets.get(&bindings[i].key());
            if (t.is_some() && t.unwrap().equals(target)) { return bindings[i]; }
        }
        return SymbolID::invalid();
    }

    /// The namespace the declaration `target` is bound in.
    namespace_of(&this, target: SymbolID) -> Namespace {
        return if (Namespace::Type.accepts(this.symbols[this.symbol_ids.slot_of(target)].kind)) {
            Namespace::Type
        } else {
            Namespace::Value
        };
    }

    /// Among one name's `bindings`, an import binding whose target is in the
    /// namespace `target` is in - one an explicit entry made, when
    /// `explicit_only` - or an invalid id.
    binding_beside(&this, bindings: &SymbolID[], target: SymbolID, explicit_only: boolean) -> SymbolID {
        const ns: Namespace = this.namespace_of(target);
        for (mut i: i64 = 0; i < bindings.length; i++) {
            if (explicit_only && !this.explicit_imports.get(&bindings[i].key()).is_some()) { continue; }
            const t: Option<SymbolID> = this.import_targets.get(&bindings[i].key());
            if (t.is_some() && ns.accepts(this.symbols[this.symbol_ids.slot_of(t.unwrap())].kind)) {
                return bindings[i];
            }
        }
        return SymbolID::invalid();
    }

    /// The declaration an import binding names in the namespace `ns`: among
    /// the bindings its scope holds under its name, the target whose kind
    /// `ns` accepts, or an invalid id when the module offered nothing under
    /// the leaf in `ns`.  The binding a lookup returned is one of them, so
    /// the answer is chosen by namespace, never by which declaration the
    /// module happened to list first.
    import_target(&this, s: &Symbol, ns: Namespace) -> SymbolID {
        if (s.kind != SymbolKind::Import || !s.scope_id.is_valid()) { return SymbolID::invalid(); }
        const all: SymbolID[] = this.scopes[s.scope_id.id - 1].get_overloads(s.name);
        for (mut i: i64 = 0; i < all.length; i++) {
            const t: Option<SymbolID> = this.import_targets.get(&all[i].key());
            if (!t.is_some()) { continue; }
            const target: SymbolID = t.unwrap();
            if (ns.accepts(this.symbols[this.symbol_ids.slot_of(target)].kind)) { return target; }
        }
        return SymbolID::invalid();
    }

    /// True when `name` is already bound in the CURRENT scope (parents are
    /// not consulted). Lets the name-resolution pass reject a same-scope
    /// redeclaration of a value binding (E0205) while leaving shadowing in a
    /// nested block - a distinct child scope - permitted.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    current_scope_has(&this, name: SymbolStr) -> boolean {
        return this.scopes[this.current_scope.id - 1].find(name).is_valid();
    }

    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    declare_variable(mut &this, name: SymbolStr, span: SourceSpan,
                     is_mutable: boolean, is_public: boolean) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const sym: Symbol = Symbol::variable(id, name, this.current_scope, span,
                                              this.current_module, is_mutable, is_public);
        return this.declare(sym);
    }

    /// Declare a named constant (`SymbolKind::Constant`). Used for immutable
    /// module-level `const` declarations so they can be told apart from
    /// mutable globals and local bindings - e.g. a `const` named in a `match`
    /// arm is a value pattern, not a fresh binding.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    declare_constant(mut &this, name: SymbolStr, span: SourceSpan) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const sym: Symbol = Symbol::constant(id, name, this.current_scope, span,
                                             this.current_module);
        return this.declare(sym);
    }

    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    declare_function(mut &this, name: SymbolStr, span: SourceSpan, is_public: boolean) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const sym: Symbol = Symbol::function(id, name, this.current_scope, span,
                                              this.current_module, is_public);
        return this.declare(sym);
    }

    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    declare_type(mut &this, name: SymbolStr, span: SourceSpan, is_public: boolean) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const sym: Symbol = Symbol::type_sym(id, name, this.current_scope, span,
                                              this.current_module, is_public);
        return this.declare(sym);
    }

    /// Declare the constructor of the class `class_sym` just declared: a
    /// value binding under the class's name, in the same scope, carrying the
    /// class's definition and visibility.
    declare_constructor(mut &this, class_sym: SymbolID) -> SymbolID {
        const cls: Symbol = this.get_symbol(class_sym);
        const id: SymbolID = this.alloc_symbol_id();
        return this.declare(Symbol::constructor(id, cls.name, this.current_scope, cls.declaring_span,
                                                this.current_module, cls.visibility.is_public(), cls.def));
    }

    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    declare_parameter(mut &this, name: SymbolStr, span: SourceSpan) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const sym: Symbol = Symbol::parameter(id, name, this.current_scope, span,
                                               this.current_module);
        return this.declare(sym);
    }

    /// Bind `name` in the current scope as a refused import, so a use of it
    /// resolves to `Res::Err` instead of to nothing.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    declare_refused(mut &this, name: SymbolStr, span: SourceSpan) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        return this.declare(Symbol::refused(id, name, this.current_scope, span));
    }

    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    declare_field(mut &this, name: SymbolStr, span: SourceSpan) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const sym: Symbol = Symbol::field(id, name, this.current_scope, span,
                                           this.current_module);
        return this.declare(sym);
    }

    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    declare_enum_variant(mut &this, name: SymbolStr, span: SourceSpan) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const sym: Symbol = Symbol::enum_variant(id, name, this.current_scope, span,
                                                  this.current_module);
        return this.declare(sym);
    }

    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    declare_method(mut &this, name: SymbolStr, span: SourceSpan, is_public: boolean,
                   def: DefId) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        mut sym: Symbol = Symbol::method(id, name, this.current_scope, span,
                                          this.current_module, is_public);
        sym.def = def;
        return this.declare(sym);
    }

    /// Declare one generic parameter as a symbol in the current scope and
    /// answer its id, which is what every reference to the parameter is
    /// stamped with.  The one door for introducing a generic parameter into
    /// the scope tree; `NameResolution::declare_generics` is its caller.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    declare_generic_param(mut &this, name: SymbolStr, span: SourceSpan) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const sym: Symbol = Symbol::generic_param(id, name, this.current_scope, span,
            this.current_module);
        return this.declare(sym);
    }


    // Ambiguity detection

    /// Check if a name is ambiguous in the current scope chain.
    /// Returns true if the name was imported from multiple modules.
    /// NOTE: Accesses scopes via array index directly (not by-value copy)
    /// to ensure the ambiguity arrays added during import processing are visible.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    is_ambiguous(&this, name: SymbolStr, ns: Namespace) -> boolean {
        mut scope_id: ScopeID = this.current_scope;
        while (scope_id.is_valid()) {
            if (this.scopes[scope_id.id - 1].is_ambiguous(name, ns)) {
                return true;
            }
            scope_id = this.scopes[scope_id.id - 1].parent_id;
        }
        return false;
    }

    /// Get the conflicting module paths for an ambiguous name.
    /// Returns two interned SymbolStr values: [module_a, module_b].
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    get_ambiguous_modules(&this, name: SymbolStr, ns: Namespace) -> SymbolStr[] {
        return this.ambiguous_modules_from(this.current_scope, name, ns);
    }

    /// The two modules whose imports tie for `name`, walking outward from an
    /// EXPLICIT scope - the one a name was written in - rather than from the
    /// cursor, which a pass called from elsewhere may have left standing in
    /// another module.  Empty when no rib on the chain records a tie.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    ambiguous_modules_from(&this, start: ScopeID, name: SymbolStr, ns: Namespace) -> SymbolStr[] {
        mut scope_id: ScopeID = start;
        while (scope_id.is_valid()) {
            const ids: u32[] = this.scopes[scope_id.id - 1].get_ambiguous_module_ids(name, ns);
            if (ids.length >= 2) {
                return [SymbolStr::from_id(ids[0]), SymbolStr::from_id(ids[1])];
            }
            scope_id = this.scopes[scope_id.id - 1].parent_id;
        }
        return [];
    }


    // Name lookup

    /// Walk the scope chain from `start` upward, looking for `name`.
    /// Uses SymbolStr for O(1) comparison during scope walks.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    lookup(&this, name: SymbolStr, start: ScopeID) -> SymbolID {
        mut scope_id: ScopeID = start;
        while (scope_id.is_valid()) {
            const scope: Scope* = this.get_scope(scope_id);
            const found: SymbolID = scope.find(name);
            if (found.is_valid()) {
                return found;
            }
            scope_id = scope.parent_id;
        }
        const any_ns: Option<Namespace> = Option::None;
        return this.lookup_prelude(name, any_ns);
    }

    /// Door `scope-value`.  A bare identifier in value position is written
    /// as text and nothing but the ribs of its writer can say what it binds,
    /// so this is where that text becomes a binding - once, for the node
    /// that carries it; every later reader asks the stamp.
    ///
    /// The binding `name` has in the VALUE namespace, walking the rib chain
    /// outward from `start`, or an invalid id.
    ///
    /// Each rib is asked for every binding it holds under the name - a type
    /// and a function may share one - and answers with the first a value can
    /// be: a declaration the value namespace accepts, a refused import (which
    /// binds the name to nothing and stops the walk), or an import that binds
    /// a value.  A binding that is only a type neither answers nor shadows:
    /// the two namespaces are separate, so an inner type spelled like an
    /// outer function leaves the function reachable.  The prelude is asked
    /// last, in the value namespace.  The binding is returned as the rib
    /// holds it - an import, not its target - because an import's own
    /// record is what says whether it was ambiguous.
    ![allow(lookup_by_spelling, reason = "a bare identifier is written as a spelling, and the ribs it is answered in bind names by their spelling; this is where the spelling becomes a binding")]
    lookup_value(&this, name: SymbolStr, start: ScopeID) -> SymbolID {
        mut scope_id: ScopeID = start;
        while (scope_id.is_valid()) {
            const scope: Scope* = this.get_scope(scope_id);
            const all: SymbolID[] = scope.get_overloads(name);
            for (mut i: i64 = 0; i < all.length; i++) {
                const sym: Symbol = this.get_symbol(all[i]);
                if (sym.kind == SymbolKind::Import) {
                    if (this.import_target(&sym, Namespace::Value).is_valid()) { return all[i]; }
                    continue;
                }
                if (Namespace::Value.accepts(sym.kind)) { return all[i]; }
            }
            scope_id = scope.parent_id;
        }
        return this.lookup_prelude(name, Option::Some(Namespace::Value));
    }

    /// The declaration a value binding names: an import's target in the
    /// value namespace, any other binding itself.
    value_target(&this, id: SymbolID) -> SymbolID {
        if (!id.is_valid()) { return id; }
        const sym: Symbol = this.get_symbol(id);
        if (sym.kind != SymbolKind::Import) { return id; }
        const target: SymbolID = this.import_target(&sym, Namespace::Value);
        if (target.is_valid()) { return target; }
        return id;
    }

    /// The outermost tier of the rib chain: names reachable without an import.
    ///
    /// Consulted only after every enclosing scope has been asked, which is what
    /// makes it a TIER and not a second strategy - an inner declaration or an
    /// explicit import shadows it, exactly as a nearer rib shadows a farther
    /// one.  It answers the same question the walk above does and returns the
    /// same kind of answer, so no caller acquires a branch on which tier
    /// replied.
    ///
    /// A name two prelude modules both export is left UNANSWERED rather than
    /// taken from whichever module the graph happens to list first: picking
    /// would make the meaning of a program depend on module order, which is the
    /// property this subsystem exists to remove.
    ///
    /// Asked in a namespace, a module answers with its declaration in that
    /// namespace.  Asked in none, a module offering several declarations
    /// under the leaf - a type and a function - is left unanswered for the
    /// same reason: which of them it lists first is declaration order.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    lookup_prelude(&this, name: SymbolStr, ns: Option<Namespace>) -> SymbolID {
        mut found: SymbolID = SymbolID::invalid();
        for (mut i: i64 = 0; i < this.prelude_modules.length; i++) {
            const all: SymbolID[] = this.exports_named(this.prelude_modules[i], name);
            if (all.length == 0) { continue; }
            mut hit: SymbolID = SymbolID::invalid();
            if (ns.is_some()) {
                hit = this.export_in(this.prelude_modules[i], name, ns.unwrap());
                if (!hit.is_valid()) { continue; }
            } else {
                if (all.length > 1) { return SymbolID::invalid(); }
                hit = all[0];
            }
            if (found.is_valid()) { return SymbolID::invalid(); }
            found = hit;
        }
        return found;
    }

    /// Record the namespaces reachable without an import.  Derived from the
    /// prelude module's own `public module` list, so it is empty when no
    /// prelude was loaded rather than defaulting to a transcribed set.
    set_prelude_modules(mut &this, mods: ModulePath[]) -> void {
        this.prelude_modules = mods;
    }

    /// Look up a name in the current scope only.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    lookup_local(&this, name: SymbolStr) -> SymbolID {
        const scope: Scope* = this.get_scope(this.current_scope);
        return scope.find(name);
    }

    /// Collect all overloads for a name across the scope chain.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    lookup_overloads(&this, name: SymbolStr, start: ScopeID) -> SymbolID[] {
        mut result: SymbolID[] = [];
        mut scope_id: ScopeID = start;
        while (scope_id.is_valid()) {
            const scope: Scope* = this.get_scope(scope_id);
            const overloads: SymbolID[] = scope.get_overloads(name);
            for (mut i: i64 = 0; i < overloads.length; i++) {
                result.push(overloads[i]);
            }
            scope_id = scope.parent_id;
        }
        return result;
    }


    // Resolution map access

    /// Record that a span resolved to a specific symbol.
    record_resolution(mut &this, span: SourceSpan, sym_id: SymbolID) -> void {
        this.resolution_map.record(span, sym_id);
    }

    /// Resolve a span to a symbol.
    resolve(&this, span: SourceSpan) -> SymbolID {
        return this.resolution_map.resolve(span);
    }

    /// Record an overload set for a span.
    record_overloads(mut &this, span: SourceSpan, sym_ids: SymbolID[]) -> void {
        this.resolution_map.record_overloads(span, sym_ids);
    }


    // Cross-module

    /// Register a symbol as exported from the current module.
    export_symbol(mut &this, sym_id: SymbolID) -> void {
        this.exports.push(Pair::<SymbolID, u64>::new(sym_id, this.current_module.as_sym().id as u64));
    }

    /// Get all exported symbols from a module.
    get_exports(&this, m: ModulePath) -> SymbolID[] {
        const mod_key: u64 = m.as_sym().id as u64;
        mut result: SymbolID[] = [];
        for (mut i: i64 = 0; i < this.exports.length; i++) {
            if (this.exports[i].second == mod_key) {
                result.push(this.exports[i].first);
            }
        }
        return result;
    }

    /// The declaration `id` stands for: the one an import binding names, or
    /// `id` itself for a declaration.  An `export` entry with `as` offers
    /// its binding under the alias, and a reader of a module's export list is
    /// handed what the binding names, never the binding.
    declaration_of(&this, id: SymbolID) -> SymbolID {
        const t: Option<SymbolID> = this.import_targets.get(&id.key());
        return if (t.is_some()) { t.unwrap() } else { id };
    }

    /// The public declaration module `m` exports under `name` in the
    /// namespace `ns`, or an invalid id: `M::f` in an expression names the
    /// function `f`, never a type `M` also declares as `f`.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    export_in(&this, m: ModulePath, name: SymbolStr, ns: Namespace) -> SymbolID {
        const all: SymbolID[] = this.exports_named(m, name);
        for (mut i: i64 = 0; i < all.length; i++) {
            if (ns.accepts(this.get_symbol(all[i]).kind)) { return all[i]; }
        }
        return SymbolID::invalid();
    }

    /// Every public declaration module `m` exports under `name`, in
    /// declaration order: a type and a function may share a leaf, and a
    /// reader that wants one of them chooses by kind.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    exports_named(&this, m: ModulePath, name: SymbolStr) -> SymbolID[] {
        mut out: SymbolID[] = [];
        const mod_key: u64 = m.as_sym().id as u64;
        for (mut i: i64 = 0; i < this.exports.length; i++) {
            if (this.exports[i].second == mod_key) {
                const sym: Symbol = this.get_symbol(this.exports[i].first);
                if (sym.name.equals(name) && sym.visibility.is_public()) {
                    out.push(this.declaration_of(this.exports[i].first));
                }
            }
        }
        return out;
    }

    /// The top-level declarations `module` holds under `name` and marks
    /// `private` - the one case a path or an import can name a declaration
    /// and still be handed nothing, which the writer must be told about
    /// rather than left to read as "no such name".  Every one, in
    /// declaration order: a type and a function may share a leaf (the second
    /// sits in the scope's overload set), and a reader that wants one of
    /// them chooses by kind.
    ///
    /// Read off the module's own scope: the export list holds only what is
    /// public, so a private declaration is exactly what it does not carry.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    private_declarations(&this, m: ModulePath, name: SymbolStr) -> SymbolID[] {
        mut out: SymbolID[] = [];
        const sid: u64 = this.find_module_scope(m);
        if (sid == 0) { return out; }
        const scope: Scope* = this.get_scope(ScopeID { id: sid });
        const all: SymbolID[] = scope.get_overloads(name);
        for (mut i: i64 = 0; i < all.length; i++) {
            const sym: Symbol = this.get_symbol(all[i]);
            if (sym.kind == SymbolKind::Import) { continue; }
            if (sym.visibility.is_public()) { continue; }
            out.push(all[i]);
        }
        return out;
    }

    /// Get a symbol by its SymbolID, one this resolver's allocator made.
    get_symbol(&this, id: SymbolID) -> Symbol {
        return this.symbols[this.symbol_ids.slot_of(id)];
    }

    /// Borrow a scope by its ScopeID.  Indexes by id-1 (IDs start at 1).
    /// Returns a pointer into `this.scopes` rather than a copy: `Scope`
    /// owns a HashMap + Pair[], so a by-value return would alias their heap
    /// and (under drop glue) double-free at the caller's scope exit.
    get_scope(&this, id: ScopeID) -> Scope* {
        return &this.scopes[id.id - 1];
    }

    /// Total number of symbols declared.
    symbol_count(&this) -> i64 {
        return this.symbols.length;
    }

    /// Total number of scopes created.
    scope_count(&this) -> i64 {
        return this.scopes.length;
    }


    // Type name resolution (used by TypeResolver)

    /// Whether `written` is how a source file may spell the module whose
    /// namespace is `mod_str`: the same namespace with zero or more of its
    /// LEADING segments omitted.
    ///
    /// `future` matches `std::future` (the root `std` is omitted, which is the
    /// tolerance this predicate exists to provide) and `other` does not.
    ///
    /// It must be a suffix, NOT any interior run. Anchoring to the end is what
    /// makes the qualifier name the module that actually DECLARES the item:
    ///
    ///     mod = "App::Lib::Helper", written "Lib::Helper"  -> true  (root omitted)
    ///     mod = "App::Lib::Helper", written "App::Lib"     -> FALSE (see below)
    ///
    /// The second case is the defect this anchoring fixes. `App::Lib::Widget`
    /// used to resolve to `App::Lib::Helper::Widget` because `App::Lib` occurs
    /// inside the module path as a whole-segment run — so a path could name a
    /// module that declares nothing of the sort and still resolve, by silently
    /// dropping TRAILING segments. Spec §5.1: "the first segment resolves in
    /// scope; the remainder is rooted ... no substring matching, no suffix
    /// matching. A path that does not resolve is an error with a suggestion,
    /// not an invitation to search."
    ///
    /// Omitting leading segments is a scope question (does `future` name
    /// `std::future` from here?) and stays. Omitting trailing ones is a claim
    /// about where a declaration lives, and is false when it is wrong.
    ///
    /// The predicate alone decides nothing.  Used as a guess - "find me a
    /// module this could mean" - it is a fuzzy fallback and its caller is
    /// counted as one.  Used as a FILTER over the modules a file can actually
    /// see, followed by a uniqueness requirement, it is ordinary path
    /// resolution.  Same test, so the two can never drift about what a spelling
    /// may name; each caller counts itself, so the accounting does not claim a
    /// scoped answer is a guess — or a validator's `true` is an answer.
    static ns_written_as(mod_str: string, written: string) -> boolean {
        const ml: i64 = mod_str.length() as i64;
        const pl: i64 = written.length() as i64;
        if (pl == 0 || pl > ml) { return false; }
        // Only one alignment can be a suffix, so this is a single check rather
        // than a scan.
        const i: i64 = ml - pl;
        if (!mod_str.substring(i as u32, pl as u32).eq(written)) { return false; }
        // ...and it must start ON a segment boundary, so `ture` does not match
        // `std::future`.
        return i == 0 || (i >= 2 && mod_str[i - 1] == ':' && mod_str[i - 2] == ':');
    }

    /// The canonical qualified name of a symbol.
    ///
    /// A symbol stores its leaf and its declaring module separately, so the
    /// canonical form is built rather than read off.  Every answer that names a
    /// definition is built here, because a second construction site is how two
    /// lanes come to disagree about what the same declaration is called - and
    /// the qualified name is the key `DeclarationIndex`, the type arena and the
    /// mangler all use, so disagreeing about it is not a cosmetic difference.
    ///
    /// A re-exported symbol keeps the module that DECLARED it, which is what
    /// makes the name canonical rather than a statement about the route taken
    /// to reach it.
    qualified_name_of(&this, sym: &Symbol) -> SymbolStr {
        if (!sym.source_module.is_valid()) { return sym.name; }
        return this.intern_table.intern(
            this.intern_table.resolve(sym.source_module.as_sym()) + "::" + this.intern_table.resolve(sym.name));
    }

    /// THE path-resolution entry point (§5.2).
    ///
    /// `ns` is a parameter rather than a separate function per kind, and that is
    /// the whole point: every per-kind lookup in this compiler re-derived the
    /// scope and import rules for itself, so they drifted, and the cascade grew
    /// in whichever lane was cheapest to extend next.  A namespace is a filter
    /// over `SymbolKind` - which those lookups already hardcoded - so making it
    /// an argument costs nothing and makes "resolve `Foo`" a question with one
    /// answer instead of a guess about which index to consult.
    ///
    /// `scope` is explicit, with no ambient-cursor default.  The largest
    /// answering step this cascade ever had existed solely to correct a cursor
    /// pointing at the wrong module; given the writer's scope there is nothing
    /// for such a step to correct.
    ///
    /// §5.1's rule decides the shape: only the FIRST segment resolves in scope,
    /// and everything after it is resolved within whatever that named.  So a
    /// multi-segment path whose head names a type is finished by the type layer,
    /// which is what `TypeRelative` claims.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    resolve_path(&this, segments: &SymbolStr[], ns: Namespace,
                 scope: ScopeID) -> Res {
        if (segments.length == 0) { return Res::Err; }

        // How many segments the head does NOT account for.  The head is
        // resolved here and nothing after it is, so this is a statement about
        // this walk rather than an estimate.
        const head: SymbolStr = segments[0];
        const trailing: u32 = (segments.length - 1) as u32;

        // The head, in scope.  Walking outward is the rib chain: an inner tier
        // shadows the outer one, and the first acceptable binding wins.
        mut scope_id: ScopeID = scope;
        while (scope_id.is_valid()) {
            const sc: Scope* = this.get_scope(scope_id);
            const found: SymbolID = sc.find(head);
            if (found.is_valid()) {
                const sym: Symbol = this.get_symbol(found);
                if (ns.accepts(sym.kind)) {
                    // Two imports of one leaf from different modules bind
                    // the name to neither (§4 rule 2: ambiguity within a
                    // tier).  The rib keeps the first so a lookup lands
                    // somewhere; the record of the second is what says the
                    // first was never the answer.  The rib DID bind the
                    // head - to nothing - so the walk stops here rather than
                    // letting an outer tier answer a name this one holds.
                    if (sym.kind == SymbolKind::Import && sc.is_ambiguous(head, ns)) {
                        return Res::Err;
                    }
                    // An import names the declaration it binds in `ns`.  One
                    // that binds none there keeps its own answer, and the
                    // stage that needs the kind reports the mismatch.
                    const target: SymbolID = this.import_target(&sym, ns);
                    if (target.is_valid()) {
                        const tsym: Symbol = this.get_symbol(target);
                        return this.res_for_head(&tsym, trailing);
                    }
                    return this.res_for_head(&sym, trailing);
                }
            }
            scope_id = sc.parent_id;
        }

        // The outermost rib: names reachable without an import.  Reached here,
        // after every enclosing scope has been asked, because that is what
        // makes the prelude a TIER - an inner declaration or an explicit import
        // shadows it - and because a caller that consults the prelude for
        // itself when this returns `Err` would be a second way to answer one
        // question, free to disagree with this one about what a bare name
        // means.  `lookup` reaches the same tier at the same point in its walk.
        //
        // Filtered by `ns` like every other rib.  Without the filter a question
        // asked in one namespace is answerable by whatever kind a prelude
        // module happens to export under the name.
        const asked: Option<Namespace> = Option::Some(ns);
        const pre: SymbolID = this.lookup_prelude(head, asked);
        if (pre.is_valid()) {
            const psym: Symbol = this.get_symbol(pre);
            if (ns.accepts(psym.kind)) {
                return this.res_for_head(&psym, trailing);
            }
        }

        // No rib bound the head, the prelude included.  Reported as `Err`
        // WITHOUT a diagnostic only because every caller today projects this
        // back into its own not-found path and diagnoses there; the moment a
        // caller reads the `Res` directly, the diagnostic belongs here, since
        // this is the only place that knows which namespace was asked and from
        // where.
        return Res::Err;
    }

    /// The answer a resolved head produces, given how many segments follow it.
    ///
    /// Every tier of `resolve_path` builds its result here.  A tier that
    /// constructs its own is free to disagree with the others about what a
    /// generic parameter or a trailing segment means, and nothing downstream
    /// can tell which tier replied.
    res_for_head(&this, sym: &Symbol, trailing: u32) -> Res {
        // A refused import bound the head to nothing, and the import's own
        // diagnostic is the report; nothing rooted in it is answered.
        if (sym.kind == SymbolKind::Refused) { return Res::Err; }
        // A parameter names ITSELF.  Substitution happens strictly below this,
        // in the type layer, which is what lets a `Res` be copied verbatim by
        // `ASTCloner`.
        if (sym.kind == SymbolKind::GenericParam) {
            if (trailing > 0) {
                return Res::TypeRelative(
                    ResBase::GenericParam(sym.id), trailing);
            }
            return Res::GenericParam(sym.id);
        }
        // The remainder is rooted in what the head named; a type owner needs a
        // receiver type, so it is not finishable here.
        if (trailing > 0) {
            return Res::TypeRelative(ResBase::Def(sym.def), trailing);
        }
        return Res::Def(sym.def);
    }


    // String helpers (qualified name parsing)

    /// Check if a string contains "::" separator.
    contains_separator(&this, s: string) -> boolean {
        const len: i64 = s.length() as i64;
        for (mut i: i64 = 0; i + 1 < len; i++) {
            if (s[i] == ':' && s[i + 1] == ':') {
                return true;
            }
        }
        return false;
    }


    /// Enter a module: its scope becomes the current one.
    ///
    /// A LOOKUP, not a construction.  The module owns exactly one scope for
    /// the life of the compilation, built on the first ask and returned
    /// unchanged after, so entering a module twice lands in the same scope
    /// and there is nothing to save or restore across the gap.
    ///
    /// Use this whenever the destination is a MODULE.  `restore_scope` is for
    /// the other half of the model - resuming a scope captured earlier, which
    /// may be a rib inside a module rather than the module itself.
    ///
    /// Answers the module the cursor stood in before, for a caller that
    /// switches in and must hand it back (`restore_scope`).
    set_module(mut &this, name: ModulePath) -> ModulePath {
        const previous: ModulePath = this.current_module;
        this.current_module = name;
        this.current_scope = ScopeID { id: this.module_scope_of(name) };
        return previous;
    }

    /// The scope a module owns, built on first ask and returned unchanged
    /// after.
    ///
    /// Every entry into a module goes through here, so there is exactly one
    /// scope per module for the life of the compilation and nothing to save or
    /// restore: the scope a pass left behind is the scope the next pass finds.
    /// The module's `Symbol` is declared with it, so the identity and the
    /// bindings it owns are created together.
    module_scope_of(mut &this, name: ModulePath) -> u64 {
        const oid: u32 = name.as_sym().id;
        match (this.module_scopes.get(&oid)) {
            Option::Some(sid) => { return sid; }
            Option::None      => { }
        }
        const fresh: ScopeID = this.create_scope(
            ScopeKind::Module, this.global_scope,
            this.intern_table.resolve(name.as_sym()), SourceSpan::none());
        this.module_scopes.insert(oid, fresh.id);
        this.declare_module_symbol(name);
        return fresh.id;
    }

    /// Give a module an IDENTITY.
    ///
    /// A module scope is keyed by the module's interned name, and a consumer
    /// that wants to say WHICH module a path names holds that same handle -
    /// so no layer has to rebuild a bare leaf's module by concatenation.  The
    /// symbol is what a `Res` can eventually name.
    ///
    /// Declared in the global scope under the module's FULL name, because
    /// module scopes are flat there rather than nested: there is no parent
    /// module scope to declare it in.  A full name is never asked for as a
    /// bare leaf, so nothing resolves differently for having it; binding a
    /// module under its LEAF is what an import does, and that is separate.
    ///
    /// First-wins: every entry into a module runs through `set_module`, and
    /// the scope it finds persists across all of them, so without this guard
    /// the symbol would be re-declared on every re-entry.
    declare_module_symbol(mut &this, m: ModulePath) -> void {
        const g: i64 = (this.global_scope.id - 1) as i64;
        const name: SymbolStr = m.as_sym();
        if (this.scopes[g].find(name).is_valid()) { return; }
        const id: SymbolID = this.alloc_symbol_id();
        const sym: Symbol = Symbol::namespace_sym(
            id, name, this.global_scope, SourceSpan::none(), m);
        this.admit(sym);
        this.scopes[g].insert(name, id, false);
    }

    /// Resume a scope captured earlier, under `name` as the current module.
    ///
    /// The transient half of the model, and the reason this is not just
    /// `set_module`: `saved_scope` comes from `get_current_scope_id()` at the
    /// top of a scope-switched region and may be a RIB - a function body a
    /// pass was standing in - rather than a module scope.  Jumping to the
    /// module's own scope instead would lose that nesting.
    ///
    /// A module destination wants `set_module`.  Reaching for this one with a
    /// scope that was just looked up for the same module says "restore" while
    /// meaning "enter", which is how two readings of these call sites were
    /// wrong about what they do.
    restore_scope(mut &this, name: ModulePath, saved_scope: u64) -> void {
        this.current_module = name;
        if (saved_scope > 0) {
            this.current_scope = ScopeID { id: saved_scope };
        } else {
            this.current_scope = this.global_scope;
        }
    }

    /// Get the current scope ID as a raw u64 (for saving/restoring).
    get_current_scope_id(&this) -> u64 {
        return this.current_scope.id;
    }

    /// The scope a module owns, or 0 when no module of that name was entered.
    ///
    /// This used to search every scope recorded under the name and return the
    /// most populated one, because entering a module built a new scope each
    /// time and all but one of them were empty.  There is one scope now, so
    /// there is nothing to choose between.
    find_module_scope(&this, module_name: ModulePath) -> u64 {
        if (!module_name.is_valid()) { return 0; }
        const oid: u32 = module_name.as_sym().id;
        return match (this.module_scopes.get(&oid)) {
            Option::Some(sid) => { sid }
            Option::None      => { 0 }
        };
    }

    /// Dump the current scope tree and symbol table for debugging.
    debug_dump(&this) -> void {
        cdebug(Text::new("=== Resolver Dump ===\n"));
        cdebug(Text::new("Symbols:\n"));
        for (mut i: i64 = 0; i < this.symbols.length; i++) {
            const sym: Symbol = this.symbols[i];
            const name: string = this.intern_table.resolve(sym.name);
            cdebug(Text::new("  [%lu] %s (scope %u) module='%s'\n"),
                sym.id.key(), name, sym.scope_id.id,
                this.intern_table.resolve(sym.source_module.as_sym()));
        }

        cdebug(Text::new("Exports: %lld symbols\n"), this.exports.length);

        cdebug(Text::new("=== End Resolver Dump ===\n"));
    }
}
