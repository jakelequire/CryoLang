/// Resolver
///
/// The core Resolver struct.  Owns all symbols and scopes, builds the
/// scope tree, and holds the resolution map.  Used during the NameResolution
/// pass to declare symbols and resolve names, then queried by downstream
/// passes via SymbolID lookups.

namespace Compiler::Resolver::Resolver;

import Compiler::Resolver;
import Compiler::Resolver::{ SymbolID, SymbolStr, InternTable, Symbol, Scope, ResolutionMap };
import Compiler::Resolver::Res;
import Compiler::Resolver::Namespace;
import Compiler::Diag;
import Compiler::Diag::SourceSpan;
import Compiler::ResolveCounter;
import std::collections::{ pair, hashmap };
import std::core::option;
import Utils::Logger;

type struct Resolver {
    // Intern table: borrowed pointer, owned by CompilationContext
    intern_table:       InternTable*;

    // Symbol arena
    symbols:            Symbol[];
    next_symbol_id:     u64;

    // Scope tree
    scopes:             Scope[];
    next_scope_id:      u64;
    global_scope:       ScopeID;
    current_scope:      ScopeID;

    // Resolution map
    resolution_map:     ResolutionMap;

    // Cross-module exports: Pair<SymbolID, u64>[] avoids T[][] codegen
    // paths.  SymbolID[][] and HashMap<K, SymbolID[]>
    // mishandle T[] as a generic type argument (inner array descriptor
    // corrupted on store/load).  Pair<A,B>[] sidesteps generic-over-array
    // codegen entirely.
    exports:              Pair<SymbolID, u64>[];  // .first = exported symbol, .second = module key (SymbolStr.id)

    import_aliases:       Pair<SymbolStr, SymbolID>[];  // .first = alias name, .second = sym_id

    // Current context
    current_module:     SymbolStr;

    /// The namespaces a file can name WITHOUT importing them.
    ///
    /// §4's tier chain ends at the prelude, and until this existed the chain
    /// stopped one tier short: the scope walk knew about a module's own
    /// declarations and its imports, and nothing at all about the names that
    /// are reachable by default.  A file writing `Option::Some` while importing
    /// no option module therefore bound nothing, and the answer came instead
    /// from a leaf-index search that is not scoped to the writer at all - which
    /// is the mechanical origin of the fallback this subsystem is retiring.
    ///
    /// Held as namespaces rather than as copied symbols so the tier stays one
    /// list instead of a per-module duplication of every prelude export, and so
    /// it shadows correctly: it is consulted only after every real scope has
    /// been asked, which is what makes an inner declaration win.
    prelude_modules:    SymbolStr[];

    // Index: interned owner_name id -> ids of Module-kind scopes with that
    // name.  find_module_scope would otherwise linear-scan every scope with a
    // per-scope strcmp (~3% frontend self-time combined).  The resolver may
    // create several same-named Module scopes across pipeline stages, so this
    // is a multimap; find_module_scope iterates only the candidates and still
    // picks the most-populated live scope (symbol counts read live).
    module_scope_index: HashMap<u32, u64[]>;

    /// Create a new Resolver with a global scope.
    /// The InternTable pointer must outlive the Resolver (owned by CompilationContext).
    static new(table: InternTable*) -> Resolver {
        const global_id: ScopeID = ScopeID::new(1);
        const global: Scope = Scope::new(
            global_id, ScopeKind::Global, ScopeID::invalid(),
            "", "<global>", SourceSpan::none()
        );

        return Resolver {
            intern_table:         table,
            symbols:              [],
            next_symbol_id:       1,
            scopes:               [global],
            next_scope_id:        2,
            global_scope:         global_id,
            current_scope:        global_id,
            resolution_map:       ResolutionMap::new(),
            exports:              [],
            import_aliases:       [],
            current_module:       SymbolStr::empty(),
            prelude_modules:      [],
            module_scope_index:   HashMap<u32, u64[]>::new(),
        };
    }


    // Scope management

    /// Allocate and register a new scope as a child of the given parent.
    create_scope(mut &this, kind: ScopeKind, parent: ScopeID, module: string,
                 owner: string, span: SourceSpan) -> ScopeID {
        const id: ScopeID = ScopeID::new(this.next_scope_id);
        this.next_scope_id += 1;

        const scope: Scope = Scope::new(id, kind, parent, module, owner, span);
        this.scopes.push(scope);

        // Index Module-kind scopes by their interned owner name so
        // find_module_scope skips the full scope scan.
        if (kind == ScopeKind::Module) {
            const oid: u32 = this.intern_table.intern(owner).id;
            const bucket: u64[]* = this.module_scope_index.get_or_insert(oid, []);
            (*bucket).push(id.id);
        }

        // Register as child of parent (O(1) direct index)
        if (parent.is_valid()) {
            this.scopes[parent.id - 1].add_child(id);
        }

        return id;
    }

    /// The module the ambient scope cursor is currently standing in.
    ///
    /// Exposed for the divergence probe in `types/resolver.cryo`, which has to
    /// report whether an explicit home module actually DIFFERED from the
    /// cursor. Without it, "both answers agreed" cannot be told apart from
    /// "there was only ever one scope in play", and a zero divergence count
    /// means nothing.
    current_module_sym(&this) -> SymbolStr { return this.current_module; }

    /// Create a child scope of the current scope and move the cursor into it.
    enter_scope(mut &this, kind: ScopeKind, owner: string, span: SourceSpan) -> ScopeID {
        LOG_DEBUG(LogComponent::General, "[Resolver] enter_scope() kind=%s owner='%s'", kind.to_string(), owner);
        const mod_str: string = this.intern_table.resolve(this.current_module);
        const id: ScopeID = this.create_scope(kind, this.current_scope,
                                               mod_str, owner, span);
        this.current_scope = id;
        return id;
    }

    /// Move the cursor back to the parent scope.  Never exits past global.
    exit_scope(mut &this) -> void {
        LOG_DEBUG(LogComponent::General, "[Resolver] exit_scope()");
        const scope: Scope* = this.get_scope(this.current_scope);
        if (scope.parent_id.is_valid()) {
            this.current_scope = scope.parent_id;
        }
    }

    // Symbol declaration

    /// Allocate the next monotonic SymbolID.
    alloc_symbol_id(mut &this) -> SymbolID {
        const id: SymbolID = SymbolID::new(this.next_symbol_id);
        this.next_symbol_id += 1;
        return id;
    }

    /// Insert a symbol into the arena and current scope.
    /// Returns the SymbolID on success.  If the name already exists in the
    /// current scope and is not overloadable, the symbol is still added to
    /// the arena but NOT indexed in the scope; a debug log is emitted so
    /// the duplicate can be diagnosed without flooding the user.
    declare(mut &this, sym: Symbol) -> SymbolID {
        LOG_DEBUG(LogComponent::Resolver, "declare() symbol id=%lu", sym.id.id);
        const id: SymbolID = sym.id;
        this.symbols.push(sym);

        // Insert into current scope (O(1) direct index)
        const allows_overload: boolean = sym.kind.allows_overload();
        const inserted: boolean = this.scopes[this.current_scope.id - 1]
            .insert(sym.name, id, allows_overload);

        if (!inserted) {
            LOG_DEBUG(LogComponent::Resolver,
                "duplicate declaration '%s' in scope '%s' (ignored)",
                this.intern_table.resolve(sym.name),
                this.scopes[this.current_scope.id - 1].owner_name);
        }

        return id;
    }

    /// Declare an import symbol with ambiguity detection.
    /// If the name already exists from a DIFFERENT module, the name is
    /// marked ambiguous and the resolver will emit an error when it's used
    /// without qualification (e.g. "use Pair" when both BattleTest::Pair
    /// and Collections::Pair::Pair are imported).
    declare_import(mut &this, sym: Symbol) -> SymbolID {
        const id: SymbolID = sym.id;
        // Intern the module path to get a heap-safe SymbolStr ID
        const new_module_sym: SymbolStr = this.intern_table.intern(sym.source_module);
        const new_module_id: u32 = new_module_sym.id;
        this.symbols.push(sym);

        // Get the existing symbol's module ID (if any) so the scope
        // can detect cross-module name conflicts.
        mut existing_module_id: u32 = 0;
        const existing_id: SymbolID = this.scopes[this.current_scope.id - 1].find(sym.name);
        if (existing_id.is_valid()) {
            const ex_mod: string = this.symbols[existing_id.id - 1].source_module;
            const ex_mod_sym: SymbolStr = this.intern_table.intern(ex_mod);
            existing_module_id = ex_mod_sym.id;
        }

        this.scopes[this.current_scope.id - 1]
            .insert_import(sym.name, id, new_module_id, existing_module_id);
        return id;
    }

    /// True when `name` is already bound in the CURRENT scope (parents are
    /// not consulted). Lets the name-resolution pass reject a same-scope
    /// redeclaration of a value binding (E0205) while leaving shadowing in a
    /// nested block - a distinct child scope - permitted.
    current_scope_has(&this, name: SymbolStr) -> boolean {
        return this.scopes[this.current_scope.id - 1].find(name).is_valid();
    }

    declare_variable(mut &this, name: SymbolStr, span: SourceSpan,
                     is_mutable: boolean, is_public: boolean) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const mod_str: string = this.intern_table.resolve(this.current_module);
        const sym: Symbol = Symbol::variable(id, name, this.current_scope, span,
                                              mod_str, is_mutable, is_public);
        return this.declare(sym);
    }

    /// Declare a named constant (`SymbolKind::Constant`). Used for immutable
    /// module-level `const` declarations so they can be told apart from
    /// mutable globals and local bindings - e.g. a `const` named in a `match`
    /// arm is a value pattern, not a fresh binding.
    declare_constant(mut &this, name: SymbolStr, span: SourceSpan) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const mod_str: string = this.intern_table.resolve(this.current_module);
        const sym: Symbol = Symbol::constant(id, name, this.current_scope, span,
                                             mod_str);
        return this.declare(sym);
    }

    declare_function(mut &this, name: SymbolStr, span: SourceSpan, is_public: boolean) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const mod_str: string = this.intern_table.resolve(this.current_module);
        const sym: Symbol = Symbol::function(id, name, this.current_scope, span,
                                              mod_str, is_public);
        return this.declare(sym);
    }

    declare_type(mut &this, name: SymbolStr, span: SourceSpan, is_public: boolean) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const mod_str: string = this.intern_table.resolve(this.current_module);
        const sym: Symbol = Symbol::type_sym(id, name, this.current_scope, span,
                                              mod_str, is_public);
        return this.declare(sym);
    }

    /// Declare a C-imported type under its ALIAS-QUALIFIED spelling.
    ///
    /// Such a declaration belongs to its extern block's alias namespace
    /// (`cit::Mode`) rather than to the file that wrote the block, and that
    /// alias-qualified form is already the key the declaration index and the
    /// type arena hold it under.  Its bare leaf is deliberately left undeclared
    /// - binding `Mode` in the file scope would shadow a same-named type in
    /// another module - so the qualified spelling is the only form a written
    /// path can name it by, and a path that names it must find it here or not
    /// at all.
    ///
    /// The source module is empty because the alias namespace is the whole
    /// canonical name: prefixing the writing file's module would build a name
    /// no index has ever registered, and the `Res` would then carry a spelling
    /// nothing downstream could resolve.
    declare_c_imported_type(mut &this, qualified: SymbolStr,
                            span: SourceSpan) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const sym: Symbol = Symbol::type_sym(id, qualified, this.current_scope,
                                              span, "", true);
        return this.declare(sym);
    }

    declare_parameter(mut &this, name: SymbolStr, span: SourceSpan) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const mod_str: string = this.intern_table.resolve(this.current_module);
        const sym: Symbol = Symbol::parameter(id, name, this.current_scope, span,
                                               mod_str);
        return this.declare(sym);
    }

    declare_field(mut &this, name: SymbolStr, span: SourceSpan) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const mod_str: string = this.intern_table.resolve(this.current_module);
        const sym: Symbol = Symbol::field(id, name, this.current_scope, span,
                                           mod_str);
        return this.declare(sym);
    }

    declare_enum_variant(mut &this, name: SymbolStr, span: SourceSpan) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const mod_str: string = this.intern_table.resolve(this.current_module);
        const sym: Symbol = Symbol::enum_variant(id, name, this.current_scope, span,
                                                  mod_str);
        return this.declare(sym);
    }

    declare_method(mut &this, name: SymbolStr, span: SourceSpan, is_public: boolean) -> SymbolID {
        const id: SymbolID = this.alloc_symbol_id();
        const mod_str: string = this.intern_table.resolve(this.current_module);
        const sym: Symbol = Symbol::method(id, name, this.current_scope, span,
                                            mod_str, is_public);
        return this.declare(sym);
    }

    /// Declare a set of generic parameters as symbols in the current scope.
    /// This is the single source of truth for introducing generic param names
    /// into the scope tree; used by NameResolution for function, struct,
    /// class, enum, and trait declarations.
    declare_generic_params(mut &this, names: SymbolStr[], spans: SourceSpan[]) -> void {
        const mod_str: string = this.intern_table.resolve(this.current_module);
        for (mut i: int = 0; i < names.length; i++) {
            const id: SymbolID = this.alloc_symbol_id();
            const sym: Symbol = Symbol::generic_param(id, names[i],
                this.current_scope, spans[i],
                mod_str);
            this.declare(sym);
        }
    }


    // Ambiguity detection

    /// Check if a name is ambiguous in the current scope chain.
    /// Returns true if the name was imported from multiple modules.
    /// NOTE: Accesses scopes via array index directly (not by-value copy)
    /// to ensure the ambiguity arrays added during import processing are visible.
    is_ambiguous(&this, name: SymbolStr) -> boolean {
        mut scope_id: ScopeID = this.current_scope;
        while (scope_id.is_valid()) {
            if (this.scopes[scope_id.id - 1].is_ambiguous(name)) {
                return true;
            }
            scope_id = this.scopes[scope_id.id - 1].parent_id;
        }
        return false;
    }

    /// Get the conflicting module paths for an ambiguous name.
    /// Returns two interned SymbolStr values: [module_a, module_b].
    get_ambiguous_modules(&this, name: SymbolStr) -> SymbolStr[] {
        mut scope_id: ScopeID = this.current_scope;
        while (scope_id.is_valid()) {
            const ids: u32[] = this.scopes[scope_id.id - 1].get_ambiguous_module_ids(name);
            if (ids.length >= 2) {
                return [SymbolStr::from_id(ids[0]), SymbolStr::from_id(ids[1])];
            }
            scope_id = this.scopes[scope_id.id - 1].parent_id;
        }
        return [];
    }


    // Name lookup

    /// Walk the scope chain from `start` upward, looking for `name`.
    /// Uses SymbolStr for O(1) comparison during scope walks.
    lookup(&this, name: SymbolStr, start: ScopeID) -> SymbolID {
        mut scope_id: ScopeID = start;
        while (scope_id.is_valid()) {
            const scope: Scope* = this.get_scope(scope_id);
            const found: SymbolID = scope.find(name);
            if (found.is_valid()) {
                return found;
            }
            scope_id = scope.parent_id;
        }
        return this.lookup_prelude(name);
    }

    /// The outermost tier of the rib chain: names reachable without an import.
    ///
    /// Consulted only after every enclosing scope has been asked, which is what
    /// makes it a TIER and not a second strategy - an inner declaration or an
    /// explicit import shadows it, exactly as a nearer rib shadows a farther
    /// one.  It answers the same question the walk above does and returns the
    /// same kind of answer, so no caller acquires a branch on which tier
    /// replied.
    ///
    /// A name two prelude modules both export is left UNANSWERED rather than
    /// taken from whichever module the graph happens to list first: picking
    /// would make the meaning of a program depend on module order, which is the
    /// property this subsystem exists to remove.
    lookup_prelude(&this, name: SymbolStr) -> SymbolID {
        mut found: SymbolID = SymbolID::invalid();
        for (mut i: i64 = 0; i < this.prelude_modules.length; i++) {
            const hit: SymbolID = this.lookup_in_module(this.prelude_modules[i], name);
            if (!hit.is_valid()) { continue; }
            if (found.is_valid()) { return SymbolID::invalid(); }
            found = hit;
        }
        return found;
    }

    /// Record the namespaces reachable without an import.  Derived from the
    /// prelude module's own `public module` list, so it is empty when no
    /// prelude was loaded rather than defaulting to a transcribed set.
    set_prelude_modules(mut &this, mods: SymbolStr[]) -> void {
        this.prelude_modules = mods;
    }

    /// Look up a name in the current scope only.
    lookup_local(&this, name: SymbolStr) -> SymbolID {
        const scope: Scope* = this.get_scope(this.current_scope);
        return scope.find(name);
    }

    /// Collect all overloads for a name across the scope chain.
    lookup_overloads(&this, name: SymbolStr, start: ScopeID) -> SymbolID[] {
        mut result: SymbolID[] = [];
        mut scope_id: ScopeID = start;
        while (scope_id.is_valid()) {
            const scope: Scope* = this.get_scope(scope_id);
            const overloads: SymbolID[] = scope.get_overloads(name);
            for (mut i: i64 = 0; i < overloads.length; i++) {
                result.push(overloads[i]);
            }
            scope_id = scope.parent_id;
        }
        return result;
    }


    // Resolution map access

    /// Record that a span resolved to a specific symbol.
    record_resolution(mut &this, span: SourceSpan, sym_id: SymbolID) -> void {
        this.resolution_map.record(span, sym_id);
    }

    /// Resolve a span to a symbol.
    resolve(&this, span: SourceSpan) -> SymbolID {
        return this.resolution_map.resolve(span);
    }

    /// Record an overload set for a span.
    record_overloads(mut &this, span: SourceSpan, sym_ids: SymbolID[]) -> void {
        this.resolution_map.record_overloads(span, sym_ids);
    }


    // Cross-module

    /// Register a symbol as exported from the current module.
    export_symbol(mut &this, sym_id: SymbolID) -> void {
        this.exports.push(Pair<SymbolID, u64>::new(sym_id, this.current_module.id as u64));
    }

    /// Get all exported symbols from a module.
    get_exports(&this, module: SymbolStr) -> SymbolID[] {
        const mod_key: u64 = module.id as u64;
        mut result: SymbolID[] = [];
        for (mut i: i64 = 0; i < this.exports.length; i++) {
            if (this.exports[i].second == mod_key) {
                result.push(this.exports[i].first);
            }
        }
        return result;
    }

    /// Look up a specific name in a module's exports.
    lookup_in_module(&this, module: SymbolStr, name: SymbolStr) -> SymbolID {
        const mod_key: u64 = module.id as u64;
        for (mut i: i64 = 0; i < this.exports.length; i++) {
            if (this.exports[i].second == mod_key) {
                const sym: Symbol = this.get_symbol(this.exports[i].first);
                if (sym.name.equals(name) && sym.visibility.is_public()) {
                    return this.exports[i].first;
                }
            }
        }
        return SymbolID::invalid();
    }

    /// Register an import alias (e.g., `import Foo as Bar` maps "Bar" -> sym_id).
    register_import_alias(mut &this, alias: SymbolStr, sym_id: SymbolID) -> void {
        this.import_aliases.push(Pair<SymbolStr, SymbolID>::new(alias, sym_id));
    }

    /// Look up an import alias.
    lookup_import_alias(&this, alias: SymbolStr) -> SymbolID {
        for (mut i: i64 = 0; i < this.import_aliases.length; i++) {
            if (this.import_aliases[i].first.equals(alias)) {
                return this.import_aliases[i].second;
            }
        }
        return SymbolID::invalid();
    }

    /// Get a symbol by its SymbolID.  Indexes by id-1 (IDs start at 1).
    get_symbol(&this, id: SymbolID) -> Symbol {
        return this.symbols[id.id - 1];
    }

    /// Borrow a scope by its ScopeID.  Indexes by id-1 (IDs start at 1).
    /// Returns a pointer into `this.scopes` rather than a copy: `Scope`
    /// owns a HashMap + Pair[], so a by-value return would alias their heap
    /// and (under drop glue) double-free at the caller's scope exit.
    get_scope(&this, id: ScopeID) -> Scope* {
        return &this.scopes[id.id - 1];
    }

    /// Total number of symbols declared.
    symbol_count(&this) -> i64 {
        return this.symbols.length;
    }

    /// Total number of scopes created.
    scope_count(&this) -> i64 {
        return this.scopes.length;
    }


    // Type name resolution (used by TypeResolver)

    /// Resolve a type name to its module-qualified form by walking the scope
    /// chain from global and checking cross-module imports.
    ///
    /// Returns the qualified name string (e.g., "MyModule::MyStruct") that
    /// can be used for TypeArena/DeclarationIndex lookup, or empty if not found.
    ///
    /// Handles both bare names ("Vec2") and already-qualified names
    /// ("Math::Vec2::Vec2").  For qualified input, extracts the leaf segment and
    /// resolves that, then validates the written prefix against the module the
    /// symbol was declared in — two modules may export the same leaf name, and
    /// the leaf-keyed scope chain cannot tell them apart on its own.
    resolve_type_qualified_name(&this, name: SymbolStr) -> SymbolStr {
        return this.resolve_type_qualified_name_from(this.current_scope, name);
    }

    /// `resolve_type_qualified_name`, but resolving the leaf from an EXPLICIT
    /// scope rather than the ambient cursor.  See
    /// `resolve_type_qualified_name_bare_from` for why the scope is a parameter.
    resolve_type_qualified_name_from(&this, start: ScopeID,
                                     name: SymbolStr) -> SymbolStr {
        const name_str: string = this.intern_table.resolve(name);
        LOG_DEBUG(LogComponent::Resolver,
            "[resolve_type_qn] looking for '%s' starting at scope %llu",
            name_str, start.id);

        // If the name is already qualified (contains "::"), try it as-is first
        // (it may already be the canonical form), then fall back to extracting
        // the leaf and resolving that.
        if (this.contains_separator(name_str)) {
            const answered: SymbolStr =
                this.resolve_type_qualified_name_strict_from(start, name_str);
            if (answered.is_valid()) { return answered; }
            // Return the input as-is; it may be the canonical form already.
            // A caller that has to RECORD the answer cannot read this value -
            // the refusal and the canonical form are the same string - and asks
            // the strict overload instead.
            return name;
        }

        return this.resolve_type_qualified_name_bare_from(start, name);
    }

    /// What a QUALIFIED type path names, or empty when nothing answers it.
    ///
    /// The same walk `resolve_type_qualified_name_from` performs, differing
    /// only in how it reports a refusal.  That one hands the written name back,
    /// because its callers pass the result straight into an arena lookup that
    /// may already hold the canonical form; a caller that must record the
    /// answer on a node cannot tell that convention's refusal from its success.
    /// Both go through this one walk so the two views cannot come to disagree
    /// about what a path names.
    ///
    /// The scope chain is keyed by leaf alone, so resolving the leaf can land
    /// on a same-named type from an entirely different module -
    /// `executor::JoinHandle` reaching `thread::JoinHandle` in a program that
    /// imports both.  The result is accepted only when its declaring module
    /// agrees with the qualifier the source wrote; binding a contradicted
    /// answer would make the winner whichever module registered the leaf last,
    /// which is not a property the source mentions.
    resolve_type_qualified_name_strict_from(&this, start: ScopeID,
                                            name_str: string) -> SymbolStr {
        const leaf_sym: SymbolStr = this.extract_leaf(name_str);
        if (!leaf_sym.is_valid()) {
            ResolveCounter::Site::M1LeafMiss.bump();
            return SymbolStr::empty();
        }
        const resolved: SymbolStr =
            this.resolve_type_qualified_name_bare_from(start, leaf_sym);
        // Separates the two ways this produces no answer: the qualifier check
        // said no, or it was never asked because nothing resolved.  Those call
        // for opposite fixes and the agreement counter alone cannot tell them
        // apart.
        if (!resolved.is_valid()) {
            ResolveCounter::Site::M1LeafMiss.bump();
            return SymbolStr::empty();
        }
        if (!this.qualifier_agrees(resolved, name_str)) {
            return SymbolStr::empty();
        }
        ResolveCounter::path_hit(
            "M1-AGREE", this.intern_table.resolve(this.current_module),
            name_str, this.intern_table.resolve(resolved));
        return resolved;
    }

    /// True when the module `resolved` was declared in is consistent with the
    /// qualifier written in `written_str`. `resolved` is a canonical
    /// `Module::Leaf`; `written_str` is the `Prefix::Leaf` the source spelled.
    ///
    /// An unqualified `written_str` agrees with anything — there is no qualifier
    /// to contradict. A `resolved` with no module of its own agrees with nothing
    /// qualified, since a written prefix cannot name the global namespace.
    qualifier_agrees(&this, resolved: SymbolStr, written_str: string) -> boolean {
        const written_prefix: string = this.prefix_of(written_str);
        if ((written_prefix.length() as i64) == 0) { return true; }
        const resolved_mod: string = this.prefix_of(this.intern_table.resolve(resolved));
        // Emitted at the refusal, not tallied: the end-of-run report prints
        // only after a successful link, and the corpus that spells a qualifier
        // the declaring module contradicts is the compile_fail corpus, which
        // never gets there. `M1-AGREE` is the control for this line's zero.
        if ((resolved_mod.length() as i64) == 0) {
            ResolveCounter::Site::M1QualReject.bump();
            ResolveCounter::path_hit(
                "M1-REJECT", this.intern_table.resolve(this.current_module),
                written_str, "<no module>");
            return false;
        }
        ResolveCounter::Site::M1AgreeCalls.bump();
        if (!Resolver::ns_written_as(resolved_mod, written_prefix)) {
            ResolveCounter::Site::M1QualReject.bump();
            ResolveCounter::path_hit(
                "M1-REJECT", this.intern_table.resolve(this.current_module),
                written_str, resolved_mod);
            return false;
        }
        ResolveCounter::Site::M1AgreeHits.bump();
        return true;
    }

    /// Everything before the final "::" in `s`, or empty when there is none.
    /// E.g. "std::future::executor::JoinHandle" -> "std::future::executor".
    prefix_of(&this, s: string) -> string {
        const len: i64 = s.length() as i64;
        mut last_sep: i64 = -1;
        for (mut i: i64 = 0; i + 1 < len; i++) {
            if (s[i] == ':' && s[i + 1] == ':') {
                last_sep = i;
            }
        }
        if (last_sep <= 0) { return ""; }
        return s.substring(0, last_sep);
    }

    /// Whether `written` is how a source file may spell the module whose
    /// namespace is `mod_str`: the same namespace with zero or more of its
    /// LEADING segments omitted.
    ///
    /// `future` matches `std::future` (the root `std` is omitted, which is the
    /// tolerance this predicate exists to provide) and `other` does not.
    ///
    /// It must be a suffix, NOT any interior run. Anchoring to the end is what
    /// makes the qualifier name the module that actually DECLARES the item:
    ///
    ///     mod = "App::Lib::Helper", written "Lib::Helper"  -> true  (root omitted)
    ///     mod = "App::Lib::Helper", written "App::Lib"     -> FALSE (see below)
    ///
    /// The second case is the defect this anchoring fixes. `App::Lib::Widget`
    /// used to resolve to `App::Lib::Helper::Widget` because `App::Lib` occurs
    /// inside the module path as a whole-segment run — so a path could name a
    /// module that declares nothing of the sort and still resolve, by silently
    /// dropping TRAILING segments. Spec §5.1: "the first segment resolves in
    /// scope; the remainder is rooted ... no substring matching, no suffix
    /// matching. A path that does not resolve is an error with a suggestion,
    /// not an invitation to search."
    ///
    /// Omitting leading segments is a scope question (does `future` name
    /// `std::future` from here?) and stays. Omitting trailing ones is a claim
    /// about where a declaration lives, and is false when it is wrong.
    ///
    /// The predicate alone decides nothing.  Used as a guess - "find me a
    /// module this could mean" - it is a fuzzy fallback and its caller is
    /// counted as one.  Used as a FILTER over the modules a file can actually
    /// see, followed by a uniqueness requirement, it is ordinary path
    /// resolution.  Same test, so the two can never drift about what a spelling
    /// may name; each caller counts itself, so the accounting does not claim a
    /// scoped answer is a guess — or a validator's `true` is an answer.
    static ns_written_as(mod_str: string, written: string) -> boolean {
        const ml: i64 = mod_str.length() as i64;
        const pl: i64 = written.length() as i64;
        if (pl == 0 || pl > ml) { return false; }
        // Only one alignment can be a suffix, so this is a single check rather
        // than a scan.
        const i: i64 = ml - pl;
        if (!mod_str.substring(i, pl).eq(written)) { return false; }
        // ...and it must start ON a segment boundary, so `ture` does not match
        // `std::future`.
        return i == 0 || (i >= 2 && mod_str[i - 1] == ':' && mod_str[i - 2] == ':');
    }

    /// The defining module of the function a bare name resolves to here, or an
    /// empty SymbolStr when the name isn't a function visible from this scope.
    ///
    /// This is the import-aware half of picking between same-named functions in
    /// different modules: the scope chain already models what the current
    /// module can see, so a candidate whose defining module this returns is the
    /// one the source actually names. Without it, selection can only compare
    /// candidate counts, and two same-named generics anywhere in the program
    /// leave every caller of either one unresolvable.
    resolve_function_source_module(&this, name: SymbolStr) -> SymbolStr {
        mut scope_id: ScopeID = this.current_scope;
        while (scope_id.is_valid()) {
            const scope: Scope* = this.get_scope(scope_id);
            const found: SymbolID = scope.find(name);
            if (found.is_valid()) {
                const sym: Symbol = this.get_symbol(found);
                // `Import` is the kind a name brought in by `import` carries -
                // an imported function is not re-declared as `Function` in the
                // importer's scope. `resolve_type_qualified_name_bare` accepts
                // it for the same reason.
                if (sym.kind == SymbolKind::Function || sym.kind == SymbolKind::Import) {
                    if (sym.source_module == "") { return SymbolStr::empty(); }
                    return this.intern_table.intern(sym.source_module);
                }
            }
            scope_id = scope.parent_id;
        }
        return SymbolStr::empty();
    }

    /// `resolve_type_qualified_name_bare`, but walking from an EXPLICIT scope
    /// instead of the resolver's ambient cursor.
    ///
    /// A bare leaf in a type annotation means what the annotation's OWN module
    /// says: that module's declarations, then its imports, then the prelude. The
    /// ambient cursor answers for whatever module a pass happens to be walking,
    /// which is the caller's at any re-resolution site - so two modules exporting
    /// the same leaf silently bind to the wrong one.
    ///
    /// Taking the start scope as a PARAMETER is what makes this safe where a
    /// cursor swap is not: resolution recurses (a type's arguments, a function
    /// annotation's parameters), and each nested resolution carries its own
    /// start scope. Repointing the shared cursor instead leaks the switch into
    /// every nested resolution underneath it.
    resolve_type_qualified_name_bare_from(&this, start: ScopeID,
                                          name: SymbolStr) -> SymbolStr {
        // 1. The scope walk, asked in the TYPE namespace.
        //
        // A generic parameter is a type-namespace answer that has no qualified
        // form - it names itself, never what a call site binds it to - so the
        // primitive reports it and this projection, whose result type is a
        // qualified name, has nothing to hand back for it.  Callers that need
        // to tell "no answer" from "answered, and it is a parameter" read the
        // `Res` instead of this string.
        mut segs: SymbolStr[] = [];
        segs.push(name);
        const r: Res = this.resolve_path(&segs, Namespace::Type, start);
        match (r) {
            Res::Def(q) => { return q; }
            _           => { }
        }

        // 2. Check import aliases.
        //    `import_aliases` is resolver-global and reset per module, so it holds
        //    the aliases of the module the cursor is on - not of `start`. Consult
        //    it only when those are the same module; for a foreign start scope an
        //    alias hit would be the CALLER's `import X as Y`, which is exactly the
        //    kind of cross-module leak this overload exists to prevent. (Aliases
        //    are not yet stored per-scope, so a foreign module's own aliases are
        //    simply not visible here; the caller falls through to its next
        //    lookup rather than binding something wrong.)
        if (start.id == this.current_scope.id) {
            const alias_id: SymbolID = this.lookup_import_alias(name);
            if (alias_id.is_valid()) {
                const alias_sym: Symbol = this.get_symbol(alias_id);
                const resolved: string = this.intern_table.resolve(alias_sym.name);
                if (alias_sym.source_module != "") {
                    return this.intern_table.intern(alias_sym.source_module + "::" + resolved);
                }
                return alias_sym.name;
            }
        }

        // 3. Not found
        return SymbolStr::empty();
    }


    /// The canonical qualified name of a symbol.
    ///
    /// A symbol stores its leaf and its declaring module separately, so the
    /// canonical form is built rather than read off.  Every answer that names a
    /// definition is built here, because a second construction site is how two
    /// lanes come to disagree about what the same declaration is called - and
    /// the qualified name is the key `DeclarationIndex`, the type arena and the
    /// mangler all use, so disagreeing about it is not a cosmetic difference.
    ///
    /// A re-exported symbol keeps the module that DECLARED it, which is what
    /// makes the name canonical rather than a statement about the route taken
    /// to reach it.
    qualified_name_of(&this, sym: &Symbol) -> SymbolStr {
        if (sym.source_module == "") { return sym.name; }
        return this.intern_table.intern(
            sym.source_module + "::" + this.intern_table.resolve(sym.name));
    }

    /// THE path-resolution entry point (§5.2).
    ///
    /// `ns` is a parameter rather than a separate function per kind, and that is
    /// the whole point: every per-kind lookup in this compiler re-derived the
    /// scope and import rules for itself, so they drifted, and the cascade grew
    /// in whichever lane was cheapest to extend next.  A namespace is a filter
    /// over `SymbolKind` - which those lookups already hardcoded - so making it
    /// an argument costs nothing and makes "resolve `Foo`" a question with one
    /// answer instead of a guess about which index to consult.
    ///
    /// `scope` is explicit, with no ambient-cursor default.  The largest
    /// answering step this cascade ever had existed solely to correct a cursor
    /// pointing at the wrong module; given the writer's scope there is nothing
    /// for such a step to correct.
    ///
    /// §5.1's rule decides the shape: only the FIRST segment resolves in scope,
    /// and everything after it is resolved within whatever that named.  So a
    /// multi-segment path whose head names a type is finished by the type layer,
    /// which is what `TypeRelative` claims.
    resolve_path(&this, segments: &SymbolStr[], ns: Namespace,
                 scope: ScopeID) -> Res {
        if (segments.length == 0) { return Res::Err; }

        // How many segments the head does NOT account for.  The head is
        // resolved here and nothing after it is, so this is a statement about
        // this walk rather than an estimate.
        const head: SymbolStr = segments[0];
        const trailing: u32 = (segments.length - 1) as u32;

        // The head, in scope.  Walking outward is the rib chain: an inner tier
        // shadows the outer one, and the first acceptable binding wins.
        mut scope_id: ScopeID = scope;
        while (scope_id.is_valid()) {
            const sc: Scope* = this.get_scope(scope_id);
            const found: SymbolID = sc.find(head);
            if (found.is_valid()) {
                const sym: Symbol = this.get_symbol(found);
                if (ns.accepts(sym.kind)) {
                    return this.res_for_head(&sym, trailing);
                }
            }
            scope_id = sc.parent_id;
        }

        // The outermost rib: names reachable without an import.  Reached here,
        // after every enclosing scope has been asked, because that is what
        // makes the prelude a TIER - an inner declaration or an explicit import
        // shadows it - and because a caller that consults the prelude for
        // itself when this returns `Err` would be a second way to answer one
        // question, free to disagree with this one about what a bare name
        // means.  `lookup` reaches the same tier at the same point in its walk.
        //
        // Filtered by `ns` like every other rib.  Without the filter a question
        // asked in one namespace is answerable by whatever kind a prelude
        // module happens to export under the name.
        const pre: SymbolID = this.lookup_prelude(head);
        if (pre.is_valid()) {
            const psym: Symbol = this.get_symbol(pre);
            if (ns.accepts(psym.kind)) {
                return this.res_for_head(&psym, trailing);
            }
        }

        // No rib bound the head, the prelude included.  Reported as `Err`
        // WITHOUT a diagnostic only because every caller today projects this
        // back into its own not-found path and diagnoses there; the moment a
        // caller reads the `Res` directly, the diagnostic belongs here, since
        // this is the only place that knows which namespace was asked and from
        // where.
        return Res::Err;
    }

    /// The answer a resolved head produces, given how many segments follow it.
    ///
    /// Every tier of `resolve_path` builds its result here.  A tier that
    /// constructs its own is free to disagree with the others about what a
    /// generic parameter or a trailing segment means, and nothing downstream
    /// can tell which tier replied.
    res_for_head(&this, sym: &Symbol, trailing: u32) -> Res {
        // A parameter names ITSELF.  Substitution happens strictly below this,
        // in the type layer, which is what lets a `Res` be copied verbatim by
        // `ASTCloner`.
        if (sym.kind == SymbolKind::GenericParam) {
            if (trailing > 0) {
                return Res::TypeRelative(
                    ResBase::GenericParam(sym.name), trailing);
            }
            return Res::GenericParam(sym.name);
        }
        const qualified: SymbolStr = this.qualified_name_of(sym);
        // The remainder is rooted in what the head named; a type owner needs a
        // receiver type, so it is not finishable here.
        if (trailing > 0) {
            return Res::TypeRelative(ResBase::Def(qualified), trailing);
        }
        return Res::Def(qualified);
    }


    // String helpers (qualified name parsing)

    /// Check if a string contains "::" separator.
    contains_separator(&this, s: string) -> boolean {
        const len: i64 = s.length() as i64;
        for (mut i: i64 = 0; i + 1 < len; i++) {
            if (s[i] == ':' && s[i + 1] == ':') {
                return true;
            }
        }
        return false;
    }

    /// Extract the last segment after the final "::" in a string.
    /// E.g., "Math::Vec2::Vec2" -> intern("Vec2")
    extract_leaf(&this, s: string) -> SymbolStr {
        const len: i64 = s.length() as i64;
        mut last_sep: i64 = -1;
        for (mut i: i64 = 0; i + 1 < len; i++) {
            if (s[i] == ':' && s[i + 1] == ':') {
                last_sep = i;
            }
        }
        if (last_sep < 0) {
            return this.intern_table.intern(s);
        }
        const start: i64 = last_sep + 2;
        if (start >= len) {
            return SymbolStr::empty();
        }
        return this.intern_table.intern(s.substring(start, len - start));
    }


    // Module-level reset (batch mode)

    /// Reset per-module state for the next module.  Preserves accumulated
    /// symbols/scopes/exports but resets the scope cursor to global.
    reset_for_next_module(mut &this) -> void {
        this.current_scope = this.global_scope;
        this.current_module = SymbolStr::empty();
        this.import_aliases = [];
    }

    /// Switch to a specific module.  Creates a fresh Module scope
    /// parented to global so that each module's declarations live in
    /// their own scope and bare names cannot collide across modules.
    /// Used by NameResolution (Phase 3).  Later phases restore the
    /// saved scope via set_module_with_scope().
    set_module(mut &this, name: SymbolStr) -> void {
        this.current_module = name;
        const mod_str: string = this.intern_table.resolve(name);
        this.current_scope = this.create_scope(
            ScopeKind::Module, this.global_scope,
            mod_str, mod_str, SourceSpan::none());
        this.import_aliases = [];
    }

    /// Switch to a module and restore a previously saved scope.
    /// Used by the multi-module orchestrator for passes after NameResolution.
    set_module_with_scope(mut &this, name: SymbolStr, saved_scope: u64) -> void {
        this.current_module = name;
        if (saved_scope > 0) {
            this.current_scope = ScopeID { id: saved_scope };
        } else {
            this.current_scope = this.global_scope;
        }
        this.import_aliases = [];
    }

    /// Get the current scope ID as a raw u64 (for saving/restoring).
    get_current_scope_id(&this) -> u64 {
        return this.current_scope.id;
    }

    /// Find the scope ID for a module by its namespace name.
    /// Searches all Module-kind scopes for one whose owner_name matches
    /// the given module name string.  Returns the most populated scope
    /// (highest symbol count) since the Resolver may create multiple
    /// scopes with the same module name at different pipeline stages.
    find_module_scope(&this, module_name: string) -> u64 {
        mut best_id: u64 = 0;
        mut best_count: i64 = -1;
        const oid: u32 = this.intern_table.lookup(module_name).id;
        match (this.module_scope_index.get_ref(&oid)) {
            Option::Some(plist) => {
                for (mut k: i64 = 0; k < (*plist).length; k++) {
                    const sid: u64 = (*plist)[k];
                    const idx: i64 = (sid - 1) as i64;
                    const count: i64 = this.scopes[idx].symbols.length;
                    if (count > best_count) {
                        best_count = count;
                        best_id = sid;
                    }
                }
            }
            Option::None => { }
        }
        return best_id;
    }

    /// Dump the current scope tree and symbol table for debugging.
    debug_dump(&this) -> void {
        cdebug("=== Resolver Dump ===\n");
        cdebug("Symbols:\n");
        for (mut i: i64 = 0; i < this.symbols.length; i++) {
            const sym: Symbol = this.symbols[i];
            const name: string = this.intern_table.resolve(sym.name);
            cdebug("  [%lu] %s (scope %u) module='%s'\n",
                sym.id.id, name, sym.scope_id.id, sym.source_module);
        }

        cdebug("Exports: %lld symbols\n", this.exports.length);

        cdebug("Import Aliases:\n");
        for (mut i: i64 = 0; i < this.import_aliases.length; i++) {
            const alias: string = this.intern_table.resolve(this.import_aliases[i].first);
            const sym: Symbol = this.get_symbol(this.import_aliases[i].second);
            const name: string = this.intern_table.resolve(sym.name);
            cdebug("  %s -> [%lu] %s (scope %u)\n",
                alias, sym.id.id, name, sym.scope_id.id);
        }

        cdebug("=== End Resolver Dump ===\n");
    }
}
