/// Resolver Module
///
/// Name resolution subsystem for the Cryo self-hosted compiler.
/// Owns all symbols and scopes, builds a resolution map (span -> SymbolID)
/// during a dedicated NameResolution pass.

namespace compiler::resolver;

module {
    SymbolStr;
    InternTable;
    QualifiedName;
    MangledName;
    Demangler;
    SymbolID;
    Res;
    Namespace;
    Symbol;
    Scope;
    ResolutionMap;
    Resolver;
    NameResolution;
}
