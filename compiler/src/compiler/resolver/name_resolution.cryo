/// Name Resolution Pass
///
/// Two-pass AST walk that populates the Resolver's symbol table and
/// resolution map.  Pass 1 forward-declares all top-level names.
/// Pass 2 walks the full AST, opening scopes, resolving identifiers,
/// and recording (span -> SymbolID) entries in the resolution map.
///
/// After this pass, downstream consumers look up results by SymbolID;
/// no more string-based name lookups.

namespace compiler::resolver::name_resolution;

import compiler::resolver;
import compiler::resolver::{ symbol_id, symbol_str, symbol, scope, resolver, qualified_name, intern_table };
import compiler::resolver::res;
import compiler::resolver::res::{ DefId, Res, ResBase, ResSlot, SourceLoc };
import compiler::resolver::namespace_kind;
import compiler::resolver::namespace_kind::{ Namespace };
import compiler::const_table;
import compiler::const_table::{ ConstantTable };
import compiler::diag;
import compiler::diag::{ ErrorCode, snapshot, source_span, edit_distance };
import compiler::diag::edit_distance::{ find_best_candidate };
import compiler::diag::diagnostic;
import compiler::diag::diagnostic::{ Diagnostic };
import compiler::ast;
import compiler::ast::{
    ImportStyle, NamedAnnotation, NodeKind, PatternBinding, PatternKind,
    TraitBound, TraitRef, TypeAnnotation, Visibility, declaration, expression, node,
    pattern, statement, visitor
};
import compiler::passes::pass_id;
import compiler::passes::pass_id::{ PassResult };
import compiler::compilation_context;
import compiler::compilation_context::{ CompilationContext, ModuleSpellingMatch };
import compiler::module_graph;
import compiler::module_graph::{ ModuleGraph, ModuleInfo };
import utils::logger;
import utils::logger::{ LOG_DEBUG, LogComponent };
import std::fmt;
import compiler::ast::declaration::{
    ClassDeclNode, DestructureBinding, DestructureDeclNode, EnumDeclNode, EnumVariantNode,
    ExternBlockNode, FieldDeclNode, FunctionDeclNode, GenericParamNode, ImplBlockNode,
    ImportDeclNode, IntrinsicConstDeclNode, IntrinsicDeclNode, MethodNode, StructDeclNode,
    TraitDeclNode, TypeAliasDeclNode, UnionDeclNode, VarDeclNode
};
import compiler::ast::expression::{
    AlignofExprNode, ArrayAccessNode, ArrayLiteralNode, AwaitExprNode, BinaryExprNode,
    CallExprNode, CastExprNode, DeleteExprNode, ExpressionNode, IdentifierNode, IfExprNode,
    LambdaExprNode, LiteralNode, MatchExprNode, MemberAccessNode, NewExprNode,
    ScopeResolutionNode, SizeofExprNode, StaticMatchExprNode, StructLiteralNode,
    TernaryExprNode, TryExprNode, TupleLiteralNode, TypeofExprNode, UnaryExprNode,
    YieldExprNode
};
import compiler::ast::node::{ ASTNode, ProgramNode, StaticAssertItem };
import compiler::ast::pattern::{
    EnumPatternNode, MatchArmNode, PatternNode, StaticMatchArmNode
};
import compiler::ast::statement::{
    AsmBlockStmtNode, AsmOperand, BlockStmtNode, DeclStmtNode, DoWhileStmtNode,
    ExprStmtNode, ForStmtNode, IfStmtNode, LoopStmtNode, MatchStmtNode, ReturnStmtNode,
    StaticMatchStmtNode, UnsafeBlockStmtNode, WhileStmtNode
};
import compiler::ast::visitor::{ ASTVisitor, BaseASTVisitor };
import compiler::diag::snapshot::{ DiagnosticSnapshot };
import compiler::diag::source_span::{ SourceSpan };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::qualified_name::{ QualifiedName };
import compiler::resolver::resolver::{ Resolver };
import compiler::resolver::scope::{ Scope, ScopeEntry, ScopeID, ScopeKind };
import compiler::resolver::symbol::{ Symbol, SymbolKind };
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::resolver::symbol_str::{ SymbolStr };


type class NameResolver : BaseASTVisitor {
public:
    resolver: Resolver*;
    ctx:      CompilationContext*;
    /// The method whose base-constructor initializer list is still unresolved,
    /// set while descending into its function so the list can be resolved in
    /// the parameter scope that only the function visitor opens.
    pending_base_ctor: MethodNode*;

    NameResolver(resolver: Resolver*, ctx: CompilationContext*)
        : BaseASTVisitor() {
        this.resolver = resolver;
        this.ctx      = ctx;
        this.pending_base_ctor = null;
    }

    /// Extract names and spans from GenericParamNode*[] and delegate to
    /// Resolver::declare_generic_params.  Single call site for introducing
    /// generic type parameter symbols into the current scope.
    declare_generics(generic_params: &GenericParamNode*[]) -> void {
        if (generic_params.length == 0) { return; }
        mut names: SymbolStr[] = [];
        mut spans: SourceSpan[] = [];
        for (mut i: int = 0; i < generic_params.length; i++) {
            const gp: GenericParamNode* = generic_params[i];
            names.push(gp.name);
            spans.push(gp.span);
        }
        this.resolver.declare_generic_params(names, spans);

        // A parameter's default (`struct Array<T, A = GlobalAlloc>`) is written
        // type syntax with a span, in the template's own file, and it is
        // resolved like any other annotation - so it needs an answer like any
        // other annotation.  Unstamped, the only thing a reader has is the
        // spelling, which a leaf-keyed lookup would answer from whichever
        // module happens to own the leaf.
        //
        // After the parameters are declared, so a default naming an earlier one
        // (`<T, U = T>`) is answered by that parameter instead of being searched
        // for among declarations.
        for (mut i: int = 0; i < generic_params.length; i++) {
            const gp: GenericParamNode* = generic_params[i];
            if (gp.has_default_annotation()) {
                this.stamp_annotation(gp.default_annotation);
            }
        }
    }


    // Pass 1: Forward declaration collection (top-level only)

    /// Walk top-level statements and forward-declare all names.
    forward_declare(program: ProgramNode*) -> void {
        LOG_DEBUG(LogComponent::General, "[NameResolver] forward_declare() with %d statements", program.statements.length);
        for (mut i: int = 0; i < program.statements.length; i++) {
            const stmt: ASTNode* = program.statements[i];
            this.forward_declare_node(stmt);
        }
    }

    /// Declare a C-imported type under `alias::name`.
    ///
    /// One home for the four declaration kinds an extern block emits, because
    /// the rule is about where a C-imported declaration LIVES and not about
    /// which kind it is; four copies of it would drift the moment one kind
    /// gained a case.
    declare_c_imported(&this, alias: SymbolStr, name: SymbolStr,
                       span: SourceSpan) -> void {
        if (alias.is_empty() || !name.is_valid()) { return; }
        const q: string = this.resolver.intern_table.resolve(alias) + "::"
                        + this.resolver.intern_table.resolve(name);
        this.resolver.declare_c_imported_type(
            this.resolver.intern_table.intern(q), span);
    }

    forward_declare_node(node: ASTNode*) -> void {
        match (node.kind) {
            NodeKind::FunctionDeclaration => {
                const fn_node: FunctionDeclNode* = node as FunctionDeclNode*;
                const sym_id: SymbolID = this.resolver.declare_function(
                    fn_node.name, fn_node.span, fn_node.is_public);
                if (fn_node.is_public) {
                    this.resolver.export_symbol(sym_id);
                }
            }
            NodeKind::StructDeclaration => {
                const struct_node: StructDeclNode* = node as StructDeclNode*;
                // A C-imported struct (binding_namespace set) is reachable only
                // through its alias namespace (`cit::Vec2`, via the decl_index
                // qualified key); declaring its bare name in the file scope here
                // would shadow same-named types in other modules.
                if (struct_node.binding_namespace.is_empty()) {
                    // A `private` type is nameable only inside its own module,
                    // the same rule a `private` function gets above.  Declared
                    // public here it binds in every importer's scope, and the
                    // only thing left saying otherwise is the declaration
                    // index - two lanes with two answers about one name.
                    const sym_id: SymbolID = this.resolver.declare_type(
                        struct_node.name, struct_node.span,
                        struct_node.is_public);
                    if (struct_node.is_public) {
                        this.resolver.export_symbol(sym_id);
                    }
                } else {
                    this.declare_c_imported(struct_node.binding_namespace,
                                            struct_node.name, struct_node.span);
                }
            }
            NodeKind::UnionDeclaration => {
                const union_node: UnionDeclNode* = node as UnionDeclNode*;
                // Same binding_namespace rule as structs (see above).
                if (union_node.binding_namespace.is_empty()) {
                    const sym_id: SymbolID = this.resolver.declare_type(
                        union_node.name, union_node.span, union_node.is_public);
                    if (union_node.is_public) {
                        this.resolver.export_symbol(sym_id);
                    }
                } else {
                    this.declare_c_imported(union_node.binding_namespace,
                                            union_node.name, union_node.span);
                }
            }
            NodeKind::EnumDeclaration => {
                const enum_node: EnumDeclNode* = node as EnumDeclNode*;
                this.record_enum_decl(enum_node);
                if (enum_node.binding_namespace.is_empty()) {
                    const sym_id: SymbolID = this.resolver.declare_type(
                        enum_node.name, enum_node.span, enum_node.is_public);
                    if (enum_node.is_public) {
                        this.resolver.export_symbol(sym_id);
                    }
                } else {
                    this.declare_c_imported(enum_node.binding_namespace,
                                            enum_node.name, enum_node.span);
                }
            }
            NodeKind::ClassDeclaration => {
                const class_node: ClassDeclNode* = node as ClassDeclNode*;
                const sym_id: SymbolID = this.resolver.declare_type(
                    class_node.name, class_node.span, class_node.is_public);
                if (class_node.is_public) {
                    this.resolver.export_symbol(sym_id);
                }
            }
            NodeKind::TraitDeclaration => {
                const trait_node: TraitDeclNode* = node as TraitDeclNode*;
                const sym_id: SymbolID = this.resolver.declare_type(
                    trait_node.name, trait_node.span, true);
                this.resolver.export_symbol(sym_id);
            }
            NodeKind::TypeAliasDeclaration => {
                const alias_node: TypeAliasDeclNode* = node as TypeAliasDeclNode*;
                if (alias_node.binding_namespace.is_empty()) {
                    const sym_id: SymbolID = this.resolver.declare_type(
                        alias_node.alias_name, alias_node.span, true);
                    this.resolver.export_symbol(sym_id);
                } else {
                    this.declare_c_imported(alias_node.binding_namespace,
                                            alias_node.alias_name,
                                            alias_node.span);
                }
            }
            NodeKind::VariableDeclaration => {
                const var_node: VarDeclNode* = node as VarDeclNode*;
                // A C-imported global const (binding_namespace set) is reachable
                // only through its alias namespace (`cit::NAME`, via the
                // decl_index qualified key); declaring it bare here would pollute
                // the file scope and shadow same-leaf globals in other modules.
                if (var_node.is_global && var_node.binding_namespace.is_empty()) {
                    // An immutable global is a named constant
                    // (`SymbolKind::Constant`); a mutable global is a variable.
                    // The kind lets later passes treat a const named in a
                    // `match` arm as a value pattern rather than a binding.
                    const sym_id: SymbolID = if (var_node.is_mutable) {
                        this.resolver.declare_variable(
                            var_node.name, var_node.span, true, true)
                    } else {
                        this.resolver.declare_constant(
                            var_node.name, var_node.span)
                    };
                    this.resolver.record_resolution(var_node.span, sym_id);
                    // The export set is what `lookup_in_module` reads, so a
                    // module-level declaration left out of it cannot be
                    // resolved across modules by the name layer at all - which
                    // is what forces a later stage to key the global map by
                    // bare leaf and take whichever module registered last.
                    this.resolver.export_symbol(sym_id);
                    if (!var_node.is_mutable) {
                        this.record_const_value(var_node);
                    }
                }
            }
            NodeKind::ImportDeclaration => {
                // Deliberately NOT processed here.  An import is answered from
                // the declaring module's exports, so processing it while this
                // module is still declaring its own names binds it against
                // whatever happens to have been declared so far.  It is done on
                // the walk instead, by which point every module has declared.
            }
            NodeKind::IntrinsicDeclaration => {
                const intr_node: IntrinsicDeclNode* = node as IntrinsicDeclNode*;
                const id: SymbolID = this.resolver.alloc_symbol_id();
                // `intr_node.name` is already an interned SymbolStr; use it
                // directly (re-`intern`-ing a SymbolStr passed the 4-byte
                // handle where a `string` was expected - a latent mismatch).
                const sym_name: SymbolStr = intr_node.name;
                // The declaring module is the symbol's canonical prefix: a
                // bare call of an intrinsic from the module that declares it
                // is stamped `Def(<module>::<leaf>)`, and that is the key the
                // declaration index registers the intrinsic's signature under.
                // A placeholder here stamps a name nothing is registered
                // under, and the call is refused as unknown.
                const intr_mod: string = this.resolver.intern_table.resolve(
                    this.resolver.current_module);
                const sym: Symbol = Symbol::intrinsic(id, sym_name,
                    this.resolver.current_scope, intr_node.span, intr_mod);
                this.resolver.declare(sym);
            }
            NodeKind::IntrinsicConstDeclaration => {
                const ic_node: IntrinsicConstDeclNode* = node as IntrinsicConstDeclNode*;
                const ic_id: SymbolID = this.resolver.alloc_symbol_id();
                const mod_str: string = this.resolver.intern_table.resolve(this.resolver.current_module);
                const ic_sym: Symbol = Symbol::constant(ic_id, ic_node.name,
                    this.resolver.current_scope, ic_node.span, mod_str);
                const declared_id: SymbolID = this.resolver.declare(ic_sym);
                this.resolver.export_symbol(declared_id);
            }
            NodeKind::ExternBlock => {
                const extern_node: ExternBlockNode* = node as ExternBlockNode*;
                if (extern_node.is_c_import()) {
                    // CImport: declare the namespace alias as a symbol, create
                    // a child scope, and declare all imported functions in it.
                    const alias: SymbolStr = extern_node.namespace_alias;
                    const ns_id: SymbolID = this.resolver.alloc_symbol_id();
                    const mod_str: string = this.resolver.intern_table.resolve(
                        this.resolver.current_module);
                    const ns_sym: Symbol = Symbol::namespace_sym(
                        ns_id, alias, this.resolver.current_scope,
                        extern_node.span, mod_str);
                    this.resolver.declare(ns_sym);
                    this.resolver.export_symbol(ns_id);

                    // Enter a child scope for the namespace alias
                    const alias_str: string = this.resolver.intern_table.resolve(alias);
                    const _scope_id: ScopeID = this.resolver.enter_scope(
                        ScopeKind::Module, alias_str, extern_node.span);

                    for (mut j: int = 0; j < extern_node.functions.length; j++) {
                        const fn_node: FunctionDeclNode* = extern_node.functions[j];
                        const fn_sym: SymbolID = this.resolver.declare_function(
                            fn_node.name, fn_node.span, true);
                        this.resolver.export_symbol(fn_sym);
                    }

                    this.resolver.exit_scope();
                } else {
                    // Regular extern block: declare functions in current scope
                    for (mut j: int = 0; j < extern_node.functions.length; j++) {
                        const fn_node: FunctionDeclNode* = extern_node.functions[j];
                        const sym_id: SymbolID = this.resolver.declare_function(
                            fn_node.name, fn_node.span, fn_node.is_public);
                        if (fn_node.is_public) {
                            this.resolver.export_symbol(sym_id);
                        }
                    }
                }
            }
            NodeKind::DeclarationStatement => {
                const decl_stmt: DeclStmtNode* = node as DeclStmtNode*;
                if (decl_stmt.declaration != null) {
                    this.forward_declare_node(decl_stmt.declaration as ASTNode*);
                }
            }
            _ => {
                // Other nodes don't introduce module-level names, skip
            }
        }
    }


    // Pass 2: Full resolution walk

    // -- ProgramNode --
    override visit(node: ProgramNode*) -> void {
        // The module's own names are already declared and exported, and the
        // scope holding them is the one the caller restored.  Naming the module
        // again here would CREATE a second scope of the same name and walk into
        // it, leaving every symbol declared above unreachable from the walk.
        for (mut i: int = 0; i < node.statements.length; i++) {
            node.statements[i].accept(this);
        }

        // A `static_assert` condition lives in a side list, not the statement
        // stream, so the loop above never reaches it.  Its condition is an
        // ordinary expression that may name a constant or an enum variant, and
        // the fold that reads it runs in TypeLowering - long after the only
        // pass that can say which module a written qualifier denotes.  Without
        // this walk the qualifier reaches that fold with no `Res` to read.
        //
        // The list is this module's own: the driver swaps `ast.root` per module
        // before the walk, so a condition is resolved in the scope of the file
        // that wrote it.
        for (mut i: i64 = 0; i < node.static_asserts.length; i++) {
            const sa: StaticAssertItem* = node.static_asserts[i];
            if (sa == null || sa.cond == null) { continue; }
            (sa.cond as ExpressionNode*).accept(this);
        }

        this.refuse_module_type_collisions();
    }

    /// Whether a bound symbol names a TYPE: declared as one, or an import
    /// whose target is one.  An import binds a name without recording what
    /// it names, so its target is reached through the owning module's export
    /// set - the way every qualified path is - and ITS kind is the answer.
    /// The type index cannot serve this: it is not populated until a later
    /// pass.
    symbol_names_type(&this, s: &Symbol) -> boolean {
        if (s.kind == SymbolKind::Type || s.kind == SymbolKind::TypeAlias) { return true; }
        if (s.kind != SymbolKind::Import) { return false; }
        const qn: string = this.resolver.intern_table.resolve(
            this.resolver.qualified_name_of(s));
        const parent: string = QualifiedName::parent_of(qn);
        const leaf: string = QualifiedName::leaf_of(qn);
        if (parent.length() == 0 || leaf.length() == 0) { return false; }
        const tgt: SymbolID = this.resolver.lookup_in_module(
            this.resolver.intern_table.intern(parent),
            this.resolver.intern_table.intern(leaf));
        if (!tgt.is_valid()) { return false; }
        const ts: Symbol = this.resolver.get_symbol(tgt);
        return ts.kind == SymbolKind::Type || ts.kind == SymbolKind::TypeAlias;
    }

    /// Modules and types share ONE namespace in a file's scope.  A type
    /// bound there - declared in the file, or imported into it - whose name
    /// also spells a module the file can reach (its own module by the
    /// module's leaf, an imported module, a prelude module), or whose
    /// canonical name IS a module's, is a redeclaration, refused where the
    /// pair is completed (E0205, the ordinary one).  A path written later
    /// then never has two owners under one segment, so no downstream reader
    /// adjudicates between a module and a type: a segment names what the
    /// scope binds it to.
    ///
    /// Asked once per module scope after its imports are bound, because the
    /// pair can be completed from either side: the type declared and the
    /// module imported, or the module imported and the type imported after
    /// it.  The scope entries are walked in insertion order, so the span
    /// named is the entry that completed the pair.
    refuse_module_type_collisions(&this) -> void {
        if (this.ctx == null || this.ctx.module_graph == null) { return; }
        const ns: SymbolStr = this.resolver.current_module_sym();
        if (!ns.is_valid()) { return; }
        const ns_str: string = this.resolver.intern_table.resolve(ns);
        const scope: Scope* = this.resolver.get_scope(this.resolver.current_scope);
        if (scope == null) { return; }
        for (mut i: i64 = 0; i < scope.symbols.length; i++) {
            const entry: ScopeEntry* = &scope.symbols[i];
            const s: Symbol = this.resolver.get_symbol(entry.sym);
            if (!this.symbol_names_type(&s)) { continue; }
            const name_str: string = this.resolver.intern_table.resolve(s.name);
            const m: ModuleSpellingMatch = this.ctx.modules_written_as(name_str, ns);
            mut clash: SymbolStr = if (m.visible >= 1) { m.found } else { SymbolStr::empty() };
            if (!clash.is_valid()) {
                // `namespace A;` declaring `type N` beside a module `A::N`:
                // the two canonical names are one name.
                const canonical: SymbolStr =
                    this.resolver.intern_table.intern(ns_str + "::" + name_str);
                if (this.ctx.module_graph.find_module_index(canonical) >= 0) {
                    clash = canonical;
                }
            }
            if (!clash.is_valid()) { continue; }
            mut d: Diagnostic = Diagnostic::error(
                ErrorCode::E0205_REDEFINED_SYMBOL,
                fmt::format("the name `%s` is already declared in this scope: `%s` is a module",
                    name_str, this.resolver.intern_table.resolve(clash)));
            d = d.at_with_label(s.declaring_span,
                if (s.kind == SymbolKind::Import) { "a type imported under a module's name" }
                else { "a type declared under a module's name" });
            d = d.with_note(
                "modules and types share one namespace; rename one of them, or reach the type by its module's path instead of importing it");
            this.ctx.emit_diagnostic(d);
        }
    }


    // -- Declarations --
    override visit(node: FunctionDeclNode*) -> void {
        LOG_DEBUG(LogComponent::General, "[NameResolver] visit(FunctionDecl) name='%s' generics=%d",
            this.resolver.intern_table.resolve(node.name), node.generic_params.length);
        // Enter function scope
        this.resolver.enter_scope(ScopeKind::Function, this.resolver.intern_table.resolve(node.name), node.span);

        // Declare generic params
        this.declare_generics(node.generic_params);

        // Declare parameters and record spans for type write-back
        for (mut i: int = 0; i < node.parameters.length; i++) {
            const param: VarDeclNode* = node.parameters[i];
            // Reject a duplicate parameter name (E0205). `Scope::insert` drops
            // the duplicate silently, so `function f(x: i32, x: i32)` would
            // otherwise compile with the second `x` shadowed and unreachable.
            // Scan only prior parameters (rather than `current_scope_has`) so a
            // value parameter sharing a generic param's name is not falsely
            // flagged.
            for (mut j: int = 0; j < i; j++) {
                if (node.parameters[j].name.id == param.name.id) {
                    this.ctx.emit_error_at(
                        ErrorCode::E0205_REDEFINED_SYMBOL,
                        fmt::format("the parameter `%s` is already declared in this function",
                            this.resolver.intern_table.resolve(param.name)),
                        param.span);
                    break;
                }
            }
            const param_sym: SymbolID = this.resolver.declare_parameter(param.name, param.span);
            this.resolver.record_resolution(param.span, param_sym);
            // After `declare_generics`, so a parameter spelled `T` is answered
            // as the generic param it names rather than searched for as a type.
            this.stamp_annotation(param.type_annotation);
        }
        this.stamp_annotation(node.return_type_annotation);
        this.stamp_trait_bounds(&node.trait_bounds);

        // The base-constructor initializer list, if this function is the
        // constructor one was written on.  Resolved here, after the parameters
        // are declared and before the body, because that is the scope the
        // language evaluates it in.  Every other consumer - sema, codegen,
        // drop insertion, the substituter, the cloner - already walks these
        // arguments; name resolution was the only pass that did not, so a path
        // written in one reached codegen with nothing recorded.
        if (this.pending_base_ctor != null
                && this.pending_base_ctor.func == node) {
            const owner: MethodNode* = this.pending_base_ctor;
            // Cleared for the descent: an argument containing a lambda or a
            // nested constructor call must not re-enter this branch and resolve
            // the same list a second time.
            this.pending_base_ctor = null;
            for (mut i: i64 = 0; i < owner.base_ctor_args.length; i++) {
                owner.base_ctor_args[i].accept(this);
            }
            this.pending_base_ctor = owner;
        }

        // Visit body
        if (node.has_body()) {
            this.visit_block_contents(node.body);
        }

        this.resolver.exit_scope();
    }

    override visit(node: MethodNode*) -> void {
        if (node.func != null) {
            // A base-constructor initializer list is written outside the body
            // but evaluated inside it: `: Base(kind, span)` reads the
            // constructor's own parameters, so it has to be resolved with those
            // in scope.  Handed to the function visitor rather than walked here
            // because that is the one place the parameter scope is open, and
            // opening a second one would put the same names in two scopes.
            this.pending_base_ctor = node;
            node.func.accept(this);
            this.pending_base_ctor = null;
        }
    }

    override visit(node: StructDeclNode*) -> void {
        LOG_DEBUG(LogComponent::General, "[NameResolver] visit(StructDecl) name='%s'", this.resolver.intern_table.resolve(node.name));
        // Enter type body scope
        this.resolver.enter_scope(ScopeKind::TypeBody, this.resolver.intern_table.resolve(node.name), node.span);

        // Declare generic params
        this.declare_generics(node.generic_params);
        // The declaration's own `where` clause, read after its parameters are
        // declared so a bound naming one is answered as that parameter.
        this.stamp_trait_bounds(&node.where_bounds);

        // Declare fields
        for (mut i: int = 0; i < node.fields.length; i++) {
            const field: FieldDeclNode* = node.fields[i];
            this.resolver.declare_field(field.name, field.span);
        }

        // Then walk them.  Declaring a field is not resolving what its type
        // annotation NAMES, and the field visitor - which stamps that
        // annotation - was reachable from nothing: every field's annotation
        // reached the type layer with no `Res` on it.  Declaration stays a
        // separate first pass so a field's default value can name a sibling
        // declared after it.
        for (mut i: int = 0; i < node.fields.length; i++) {
            node.fields[i].accept(this);
        }

        // Visit methods
        for (mut i: int = 0; i < node.methods.length; i++) {
            node.methods[i].accept(this);
        }

        this.resolver.exit_scope();
    }

    override visit(node: UnionDeclNode*) -> void {
        LOG_DEBUG(LogComponent::General, "[NameResolver] visit(UnionDecl) name='%s'", this.resolver.intern_table.resolve(node.name));
        // Enter type body scope
        this.resolver.enter_scope(ScopeKind::TypeBody, this.resolver.intern_table.resolve(node.name), node.span);

        // Declare generic params
        this.declare_generics(node.generic_params);
        this.stamp_trait_bounds(&node.where_bounds);

        // Declare fields
        for (mut i: int = 0; i < node.fields.length; i++) {
            const field: FieldDeclNode* = node.fields[i];
            this.resolver.declare_field(field.name, field.span);
        }

        // Then walk them.  Declaring a field is not resolving what its type
        // annotation NAMES, and the field visitor - which stamps that
        // annotation - was reachable from nothing: every field's annotation
        // reached the type layer with no `Res` on it.  Declaration stays a
        // separate first pass so a field's default value can name a sibling
        // declared after it.
        for (mut i: int = 0; i < node.fields.length; i++) {
            node.fields[i].accept(this);
        }

        // Visit methods
        for (mut i: int = 0; i < node.methods.length; i++) {
            node.methods[i].accept(this);
        }

        this.resolver.exit_scope();
    }

    override visit(node: ClassDeclNode*) -> void {
        LOG_DEBUG(LogComponent::General, "[NameResolver] visit(ClassDecl) name='%s'", this.resolver.intern_table.resolve(node.name));

        // The base, in the scope ENCLOSING the class.  It has to be asked
        // before `enter_scope`: the class body declares the class's own name
        // and its generic parameters, either of which would shadow the base.
        //
        // The parser accepts a single identifier here, so this is always a
        // one-segment question in the type namespace - and one this layer can
        // finish, which is why anything other than a definition is reported
        // here rather than passed on.  A base that names nothing leaves the
        // class with no base at all, so letting it through silently drops
        // every member the class was written to inherit.
        if (node.has_base_class()) {
            mut segs: SymbolStr[] = [];
            segs.push(node.base_class);
            const r: Res = this.resolver.resolve_path(
                &segs, Namespace::Type, this.resolver.current_scope);
            match (r) {
                Res::Def(_) => { node.set_base_res(r); }
                _           => {
                    const written: string =
                        this.resolver.intern_table.resolve(node.base_class);
                    mut d: Diagnostic = Diagnostic::error(
                        ErrorCode::E0203_UNDEFINED_TYPE,
                        fmt::format("cannot find type `%s` in this scope", written));
                    d = d.at_with_label(node.base_span, "not found in this scope");
                    d = d.with_note("a base class is resolved in the scope the class is written in, before the class body");
                    this.ctx.emit_diagnostic(d);
                    node.set_base_res(Res::Err);
                }
            }
        }

        this.resolver.enter_scope(ScopeKind::TypeBody, this.resolver.intern_table.resolve(node.name), node.span);

        // Declare generic params
        this.declare_generics(node.generic_params);
        this.stamp_trait_bounds(&node.where_bounds);

        // Declare fields
        for (mut i: int = 0; i < node.fields.length; i++) {
            const field: FieldDeclNode* = node.fields[i];
            this.resolver.declare_field(field.name, field.span);
        }

        // Then walk them.  Declaring a field is not resolving what its type
        // annotation NAMES, and the field visitor - which stamps that
        // annotation - was reachable from nothing: every field's annotation
        // reached the type layer with no `Res` on it.  Declaration stays a
        // separate first pass so a field's default value can name a sibling
        // declared after it.
        for (mut i: int = 0; i < node.fields.length; i++) {
            node.fields[i].accept(this);
        }

        // Visit methods
        for (mut i: int = 0; i < node.methods.length; i++) {
            node.methods[i].accept(this);
        }

        this.resolver.exit_scope();
    }

    override visit(node: EnumDeclNode*) -> void {
        LOG_DEBUG(LogComponent::General, "[NameResolver] visit(EnumDecl) name='%s'", this.resolver.intern_table.resolve(node.name));
        this.resolver.enter_scope(ScopeKind::TypeBody, this.resolver.intern_table.resolve(node.name), node.span);

        // Declare generic params
        this.declare_generics(node.generic_params);
        this.stamp_trait_bounds(&node.where_bounds);

        // Declare variants
        for (mut i: int = 0; i < node.variants.length; i++) {
            const variant: EnumVariantNode* = node.variants[i];
            this.resolver.declare_enum_variant(variant.name, variant.span);
            // A payload is written type syntax; a variant carrying one spells
            // a type exactly as a field declaration does.
            this.stamp_annotation_list(&variant.associated_types);
        }

        this.resolver.exit_scope();
    }

    override visit(node: TraitDeclNode*) -> void {
        LOG_DEBUG(LogComponent::General, "[NameResolver] visit(TraitDecl) name='%s'", this.resolver.intern_table.resolve(node.name));
        this.resolver.enter_scope(ScopeKind::Trait, this.resolver.intern_table.resolve(node.name), node.span);

        // Declare generic params
        this.declare_generics(node.generic_params);

        // An associated type's declared bound (`type Item: Copy;`) names a
        // trait the way a where clause does, and is written in this file.
        for (mut i: i64 = 0; i < node.assoc_types.length; i++) {
            if (node.assoc_types[i] == null) { continue; }
            for (mut j: i64 = 0; j < node.assoc_types[i].bounds.length; j++) {
                const tref: TraitRef* = &node.assoc_types[i].bounds[j];
                this.stamp_trait_ref_identity(tref);
                this.stamp_annotation_list(&tref.type_args);
            }
        }

        // Every signature is declared before any body is walked, so a default
        // body may call a sibling method declared after it.
        for (mut i: int = 0; i < node.methods.length; i++) {
            const method: FunctionDeclNode* = node.methods[i];
            this.resolver.declare_method(method.name, method.span, true);
        }

        // A default body is source written in THIS file, and is the only place
        // the module that wrote it is still known: it is later instantiated
        // against each implementing type, where the surrounding module is the
        // implementor's, not the trait's.  Skipping it here leaves every path
        // it spells to be re-derived from wherever the compiler is standing at
        // instantiation time.  A method with no default has no body, and
        // `visit(FunctionDeclNode*)` already walks one only when it exists.
        for (mut i: int = 0; i < node.methods.length; i++) {
            node.methods[i].accept(this);
        }

        this.resolver.exit_scope();
    }

    override visit(node: ImplBlockNode*) -> void {
        this.resolver.enter_scope(ScopeKind::Impl,
            this.resolver.intern_table.resolve(node.target_type), node.span);

        // Declare generic params (e.g., implement enum Optional<T> { ... })
        this.declare_generics(node.generic_params);

        // Resolve the target type name
        const target_id: SymbolID = this.resolver.lookup(
            node.target_type, this.resolver.current_scope);
        if (target_id.is_valid()) {
            this.resolver.record_resolution(node.span, target_id);
        }
        // The type an impl head is FOR, stamped after `declare_generics` for
        // the same reason the trait side is: a name spelled like an impl
        // generic is that param, not a type to search for.
        match (this.type_spelling_res(node.target_type, node.span)) {
            ResSlot::Answered(r) => {
                node.set_res(r);
            }
            _                    => { }
        }

        // The trait an impl head names. After `declare_generics`, for the same
        // reason a parameter annotation is stamped there: a name spelled like
        // an impl generic is that param, not a type to search for.
        //
        // Without this the head's identity is only ever recoverable as the
        // leaf its spelling ends in, which is a search key - it answers only
        // while that leaf is unique program-wide.
        this.stamp_annotation(node.trait_annotation);
        // What the head writes AFTER the target: a parameter of its own, or
        // a declaration (`Array<T, GlobalAlloc>`), and only a stamp can say
        // which.  Read after `declare_generics` for the reason the trait
        // side is.
        this.stamp_annotation_list(&node.target_args);

        // `type Item = T;` in the body binds an associated type to written
        // syntax, and the impl's own `where` clause spells types the same way
        // a method's does.  Both are read after the generic params are
        // declared, so a binding naming one is answered as that param.
        this.stamp_annotation_list(&node.assoc_binding_annotations);
        this.stamp_trait_bounds(&node.where_bounds);

        // Declare and visit methods
        for (mut i: int = 0; i < node.methods.length; i++) {
            const method: MethodNode* = node.methods[i];
            if (method.func != null) {
                const is_public: boolean =
                    method.visibility == Visibility::Public;
                this.resolver.declare_method(
                    method.func.name, method.func.span, is_public);
            }
            method.accept(this);
        }

        this.resolver.exit_scope();
    }

    override visit(node: VarDeclNode*) -> void {
        this.stamp_annotation(node.type_annotation);
        // Local variable declarations (globals handled in forward_declare)
        if (!node.is_global) {
            // Reject a same-scope redeclaration of a value binding (E0205).
            // Without this check, `const x = 1; const x = 2;` in one block keeps
            // only one of the two: Scope::insert drops the duplicate from the
            // index with nothing but a debug log, so the second binding is
            // silently accepted. Shadowing in a nested block is a distinct
            // child scope and remains allowed.
            if (this.resolver.current_scope_has(node.name)) {
                this.ctx.emit_error_at(
                    ErrorCode::E0205_REDEFINED_SYMBOL,
                    fmt::format("the name `%s` is already declared in this scope",
                        this.resolver.intern_table.resolve(node.name)),
                    node.span);
            }
            const sym_id: SymbolID = this.resolver.declare_variable(node.name, node.span, node.is_mutable,
                                                          false);
            // Record the declaration span so downstream passes (TypeResolution,
            // Sema) can map VarDeclNode.span -> SymbolID for type write-back.
            this.resolver.record_resolution(node.span, sym_id);
        }

        // Visit initializer expression
        if (node.has_initializer()) {
            node.initializer.accept(this);
        }
    }

    override visit(node: DestructureDeclNode*) -> void {
        this.stamp_annotation(node.type_annotation);
        // Resolve the initializer first; its identifiers must bind to the
        // outer scope, before the new field locals shadow anything.
        if (node.has_initializer()) {
            node.initializer.accept(this);
        }
        // Declare each binding's local in the current scope.
        for (mut i: i64 = 0; i < node.bindings.length; i++) {
            const b: DestructureBinding = node.bindings[i];
            // Reject two bindings that introduce the same local name (E0205):
            // `const {x, x} = ...` would otherwise drop the duplicate silently.
            for (mut j: i64 = 0; j < i; j++) {
                if (node.bindings[j].local_name.id == b.local_name.id) {
                    this.ctx.emit_error_at(
                        ErrorCode::E0205_REDEFINED_SYMBOL,
                        fmt::format("the name `%s` is bound more than once in this destructuring",
                            this.resolver.intern_table.resolve(b.local_name)),
                        b.name_span);
                    break;
                }
            }
            const sym_id: SymbolID = this.resolver.declare_variable(
                b.local_name, b.name_span, b.is_mutable, false);
            this.resolver.record_resolution(b.name_span, sym_id);
        }
    }

    override visit(node: TypeAliasDeclNode*) -> void {
        // Already forward-declared; nothing more to resolve here.
        // Target type resolution is deferred to the TypeResolution pass.
        this.stamp_annotation(node.target_annotation);
    }

    override visit(node: ImportDeclNode*) -> void {
        // Every module has declared and exported its own names by now, so the
        // exports this import reads from exist whichever order the modules are
        // walked in - including inside an import cycle, where no order can put
        // the declarer first.
        //
        // Running after this module's own declarations rather than before them
        // does not change which of the two wins: the scope tiers them, so a
        // declaration owns the slot and shadows the import either way.
        this.process_import(node);
    }

    override visit(node: ExternBlockNode*) -> void {
        // Already forward-declared functions; visit bodies if any.
        for (mut i: int = 0; i < node.functions.length; i++) {
            node.functions[i].accept(this);
        }
    }

    override visit(node: IntrinsicDeclNode*) -> void {
        // Already forward-declared; visit parameters/body if needed.
        if (node.has_body()) {
            this.resolver.enter_scope(ScopeKind::Function, this.resolver.intern_table.resolve(node.name), node.span);
            for (mut i: int = 0; i < node.parameters.length; i++) {
                const param: VarDeclNode* = node.parameters[i];
                const param_sym: SymbolID = this.resolver.declare_parameter(param.name, param.span);
                this.resolver.record_resolution(param.span, param_sym);
            }
            this.visit_block_contents(node.body);
            this.resolver.exit_scope();
        }
    }

    override visit(node: FieldDeclNode*) -> void {
        this.stamp_annotation(node.type_annotation);
        // Fields already declared by parent struct/class visitor.
        // Visit default value expression if present.
        if (node.has_default_value()) {
            node.default_value.accept(this);
        }
    }

    override visit(node: GenericParamNode*) -> void {
        // Already declared by parent function/struct visitor.
    }


    // -- Expressions --

    /// The `Res` a scope lookup's answer records for a BARE name.
    ///
    /// One mapping, because `SymbolKind` is what decides which variant is true
    /// and a second copy of that decision is a second opinion about the same
    /// symbol.
    ///
    /// `qualified_name_of` builds `module::leaf`, which is the canonical name
    /// of a declaration living directly in a module and is NOT the canonical
    /// name of a MEMBER - a method, a field and an enum variant are all named
    /// through their owner, so `module::leaf` for one of them is a name nothing
    /// is registered under.  Those are left unanswered rather than stamped with
    /// a name no later stage can check; an unanswered slot is reported against
    /// whatever stage actually needed it.
    ///
    /// Returned as a `ResSlot` because "this lookup names nothing a `Res` can
    /// state" is exactly `Pending`, and the resolver is the one place allowed
    /// to observe it.
    bare_name_res(&this, sym_id: SymbolID) -> ResSlot {
        if (!sym_id.is_valid()) { return ResSlot::Pending; }
        const s: Symbol = this.resolver.get_symbol(sym_id);
        if (s.kind == SymbolKind::GenericParam) {
            return ResSlot::Answered(Res::GenericParam(s.name));
        }
        if (s.kind == SymbolKind::Parameter) {
            return ResSlot::Answered(Res::Local(sym_id));
        }
        if (s.kind == SymbolKind::Variable) {
            // A module-level `mut` global and a function local share this
            // kind, and only the scope each was declared in separates them.
            // A global is a definition later stages reach by canonical name,
            // so answering `Local` would hand them a symbol id no index is
            // keyed by.
            if (s.scope_id.is_valid()) {
                const sc: Scope* = this.resolver.get_scope(s.scope_id);
                if (sc.kind.is_module_level()) {
                    return ResSlot::Answered(
                        Res::Def(DefId::of_definition(this.resolver.qualified_name_of(&s))));
                }
            }
            return ResSlot::Answered(Res::Local(sym_id));
        }
        if (s.kind == SymbolKind::Method || s.kind == SymbolKind::Field
                || s.kind == SymbolKind::EnumVariant) {
            return ResSlot::Pending;
        }
        return ResSlot::Answered(Res::Def(DefId::of_definition(this.resolver.qualified_name_of(&s))));
    }

    override visit(node: IdentifierNode*) -> void {
        mut sym_id: SymbolID = this.resolver.lookup(
            node.name, this.resolver.current_scope);
        if (!sym_id.is_valid()) {
            // A source-location pseudo-constant is declared nowhere, so no
            // binding can answer it; the spelling is the answer, as a
            // primitive's is on the type lane.  Asked only once every scope
            // has declined, so a binding of the same spelling shadows it.
            match (SourceLoc::of_spelling(this.resolver.intern_table.resolve(node.name))) {
                Option::Some(k) => {
                    node.set_res(Res::SourceLoc(k));
                    this.stamp_annotation_list(&node.generic_args);
                    return;
                }
                Option::None => { }
            }
            LOG_DEBUG(LogComponent::General, "[NameResolver] Identifier '%s' not found in scope", this.resolver.intern_table.resolve(node.name));
            // No error here; could be a built-in type or forward reference
            // that will be resolved by TypeResolution
        }
        if (sym_id.is_valid()) {
            this.resolver.record_resolution(node.span, sym_id);
            // Two imports of one leaf from different modules bind the name to
            // neither: the scope keeps the first so a lookup lands somewhere,
            // and the record of the second is what says the first was never
            // the answer.  Refused here, where the name is used, because an
            // import brings a name into scope and it is naming the item that
            // needs it to name one.  A declaration of the leaf in this module
            // shadows every import of it and clears the record, so this is
            // reached only for the import-vs-import tie.
            const bound: Symbol = this.resolver.get_symbol(sym_id);
            if (bound.kind == SymbolKind::Import
                    && this.resolver.is_ambiguous(node.name)) {
                const mods: SymbolStr[] = this.resolver.get_ambiguous_modules(node.name);
                const leaf: string = this.resolver.intern_table.resolve(node.name);
                const a: string = if (mods.length > 0) { this.resolver.intern_table.resolve(mods[0]) } else { "" };
                const b: string = if (mods.length > 1) { this.resolver.intern_table.resolve(mods[1]) } else { "" };
                mut d: Diagnostic = Diagnostic::error(
                    ErrorCode::E0154_AMBIGUOUS_CALL,
                    fmt::format("`%s` is ambiguous: it is imported from both `%s` and `%s`",
                        leaf, a, b));
                d = d.at_with_label(node.span, "ambiguous name");
                d = d.with_note(fmt::format(
                    "write the path out to say which one is meant, `%s::%s` or `%s::%s`",
                    a, leaf, b, leaf));
                this.ctx.emit_diagnostic(d);
                node.set_res(Res::Err);
                this.stamp_annotation_list(&node.generic_args);
                return;
            }
        }
        // Stamped from the lookup already performed, never a second one: the
        // scope this walk stands in is the scope the name was written in, and
        // that is the only place the answer is knowable.
        match (this.bare_name_res(sym_id)) {
            ResSlot::Answered(r) => { node.set_res(r); }
            _                    => { }
        }
        this.stamp_annotation_list(&node.generic_args);
    }

    override visit(node: ScopeResolutionNode*) -> void {
        // Look up the scope name (e.g., "Foo" in "Foo::Bar")
        const scope_sym: SymbolID = this.resolver.lookup(
            node.scope_name, this.resolver.current_scope);
        if (scope_sym.is_valid()) {
            this.resolver.record_resolution(node.span, scope_sym);
        }
        // A segment that already binds in scope names a TYPE (or a value), and
        // what its members are is sema's question, not this one.  Passing the
        // SYMBOL through is what keeps the two refusals below from judging a
        // type that merely shares its name with some module elsewhere in the
        // program, and it is also the base a type-relative answer records - so
        // the stamp is built from the lookup already performed rather than from
        // a second one asking the same question.
        this.stamp_module_scope(node, scope_sym);
        // The scope segment's own arguments (`Pair<String, String>::new`) and
        // the member's (`Layout::of<Entry<K, V>>`) are written types in their
        // own right; what they name is settled here, where the writing scope
        // is still the current one.
        this.stamp_annotation_list(&node.scope_generic_args);
        this.stamp_annotation_list(&node.generic_args);
        // Member resolution within the type's scope is deferred to
        // TypeResolution (needs type info to find the TypeBody scope).
    }

    /// The type named by a scope segment that is itself a module-rooted path,
    /// or an invalid id when the segment is not one.
    ///
    /// `libc::Whence` sits in the scope position of `libc::Whence::SEEK_END`:
    /// its head names a module, and its last segment names a type in that
    /// module's export set.  Resolving it in that order is the language's rule
    /// for paths, and the result is a declaration this pass can name - so
    /// recording the segment as type-owned WITHOUT walking it would hand the
    /// type layer a base the name layer was supposed to supply.
    ///
    /// This is not a second attempt at the scope lookup.  A segment either
    /// binds in the writer's scope or spells a module path, never both, and
    /// which of the two it is has already been decided when this runs.
    walk_module_rooted_type(&this, written: string,
                            use_ns: SymbolStr, span: SourceSpan) -> SymbolID {
        const prefix: string = QualifiedName::parent_of(written);
        if (prefix.length() == 0) { return SymbolID::invalid(); }
        const leaf: string = QualifiedName::leaf_of(written);
        if (leaf.length() == 0) { return SymbolID::invalid(); }

        // A spelling two reachable modules share names neither of them, so the
        // walk stops rather than picking one.
        const head: ModuleSpellingMatch = this.ctx.modules_written_as(prefix, use_ns);
        if (head.visible != 1) { return SymbolID::invalid(); }

        // The segment after the head resolves inside what the head named - the
        // module's OFFERED set, which is its own exports plus what its `export`
        // edges pass on.  A private declaration is not a candidate, so a path
        // can never reach one by being spelled out in full.
        //
        // The re-export half is what makes a facade path a real path: one item
        // has many valid spellings and `Aggregate::Widget` is one of them, even
        // though `Inner` declared it.  It is NOT a weaker alias - the same
        // refusal applies as anywhere else, so a name two of the facade's
        // children declare is ambiguous here and resolves to neither.
        mut offered: i64 = 0;
        const leaf_sym: SymbolStr = this.resolver.intern_table.intern(leaf);
        const hit: SymbolID = this.module_offering(head.found, leaf_sym, &offered);
        if (offered == 1) { return hit; }
        // Offered by nothing, and declared by the head as `private`: the path
        // names a declaration the writer may not see.  Visibility is checked
        // where the candidate is proposed, and this walk is where a spelled-out
        // path proposes one, so the refusal is reported here rather than left
        // as a name that appears not to exist - or, worse, re-derived by a
        // later stage from the spelling, which is registered under exactly
        // this name and would answer it.
        if (offered == 0) {
            const hidden: SymbolID = this.resolver.private_declaration(head.found, leaf_sym);
            if (hidden.is_valid()) {
                const hs: Symbol = this.resolver.get_symbol(hidden);
                const owner: string = this.resolver.intern_table.resolve(head.found);
                if (hs.kind == SymbolKind::Type || hs.kind == SymbolKind::TypeAlias) {
                    mut d: Diagnostic = Diagnostic::error(
                        ErrorCode::E0503_PRIVATE_SYMBOL_ACCESS,
                        fmt::format("type `%s` is private to module `%s`", leaf, owner));
                    d = d.at_with_label(span,
                        fmt::format("`%s` cannot be named outside its module `%s`", leaf, owner));
                    this.ctx.emit_diagnostic(d);
                } else {
                    mut d: Diagnostic = Diagnostic::error(
                        ErrorCode::E0353_PRIVATE_ACCESS,
                        fmt::format("`%s::%s` is private and cannot be named from `%s`",
                            owner, leaf, this.resolver.intern_table.resolve(use_ns)));
                    d = d.at_with_label(span, "private declaration named by this path");
                    this.ctx.emit_diagnostic(d);
                }
            }
        }
        return SymbolID::invalid();
    }

    /// Record which MODULE the scope segment of `Ns::member` names, as the file
    /// that wrote it can see.
    ///
    /// The source may spell any whole-segment suffix of a module's namespace,
    /// and several modules can share one suffix, so the spelling alone does not
    /// identify the module - the writer's imports do.  Answering that once,
    /// here, is what stops the question being re-asked later from wherever the
    /// compiler happens to be standing, where the only inputs left are the
    /// graph's order and the ambient cursor.
    ///
    /// Silent when the segment names no visible module.  That is not this
    /// question failing: a segment naming a TYPE needs a receiver type, which
    /// does not exist yet, and belongs to sema.
    ///
    /// Reports only when the segment binds to NOTHING in scope and a module
    /// nevertheless carries the spelling - then the source has written a module
    /// path, and the two ways it can fail are worth naming where they happen.
    /// `scope_sym` is the caller's already-answered lookup, not a second one:
    /// asking again here would be the same question with a second answer.  It
    /// is passed as the symbol rather than as a yes/no because a type-relative
    /// answer has to name the type it stopped on, and that name is exactly what
    /// the caller's lookup produced.
    stamp_module_scope(&this, node: ScopeResolutionNode*,
                       scope_sym: SymbolID) -> void {
        const binds_in_scope: boolean = scope_sym.is_valid();
        if (this.ctx == null || this.ctx.module_graph == null) {
            return;
        }
        if (this.ctx.decl_index == null) {
            return;
        }

        // The use site comes from the syntax.  A span naming no module means
        // this node was synthesized, and a synthesizer that knows what it is
        // referring to sets the `Res` itself; guessing a use site here would
        // compare an unknown writer unequal to every real module and reject
        // what it cannot place.
        const use_ns: SymbolStr =
            this.ctx.module_ns_sym_of_file(node.scope_span.file);
        if (!use_ns.is_valid()) {
            return;
        }

        const written: string = this.resolver.intern_table.resolve(node.scope_name);
        if (written.length() == 0) {
            return;
        }

        // What a type-relative answer on this node would name, decided once.
        //
        // Three disjoint ways a scope segment names a type, selected by a
        // property of the segment rather than tried in turn: it binds in the
        // writer's scope, it spells a primitive (which is declared nowhere and
        // so binds nowhere), or it is a module-rooted path whose own last
        // segment names the type.  A segment in none of them is a segment
        // nothing in the program owns, and it is counted rather than guessed
        // at, because a base invented here is a claim the type layer cannot
        // check.
        //
        // A `ScopeResolutionNode` is exactly `scope :: member`, so whatever the
        // scope segment names, the one member is what is left for the type
        // layer to finish.
        const trailing: u32 = 1;
        mut base: ResBase = ResBase::PrimTy(node.scope_name);
        mut have_base: boolean = false;
        if (binds_in_scope) {
            const s: Symbol = this.resolver.get_symbol(scope_sym);
            if (s.kind == SymbolKind::GenericParam) {
                base = ResBase::GenericParam(s.name);
            } else {
                base = ResBase::Def(DefId::of_definition(this.resolver.qualified_name_of(&s)));
            }
            have_base = true;
        } else if (ResBase::is_primitive_spelling(written)) {
            base = ResBase::PrimTy(node.scope_name);
            have_base = true;
        } else {
            const rooted: SymbolID = this.walk_module_rooted_type(written, use_ns, node.scope_span);
            if (rooted.is_valid()) {
                const rs: Symbol = this.resolver.get_symbol(rooted);
                base = ResBase::Def(DefId::of_definition(this.resolver.qualified_name_of(&rs)));
                have_base = true;
            }
        }

        // A segment that binds in the writer's scope as a TYPE names that
        // type.  No module can be spelled the same way from this scope:
        // modules and types share one namespace, and a type whose name
        // spells a reachable module is refused where it is bound
        // (`refuse_module_type_collisions`), so there is no second owner to
        // ask about and nothing here to choose between.
        if (binds_in_scope && have_base) {
            const bound: Symbol = this.resolver.get_symbol(scope_sym);
            if (bound.kind == SymbolKind::GenericParam || this.symbol_names_type(&bound)) {
                node.set_scope_res(Res::TypeRelative(base, trailing));
                return;
            }
        }
        const m: ModuleSpellingMatch = this.ctx.modules_written_as(written, use_ns);
        const found:   SymbolStr = m.found;
        const other:   SymbolStr = m.other;
        const any:     SymbolStr = m.any;
        const visible: i64 = m.visible;
        const matched: i64 = m.matched;

        if (visible == 1) {
            // The module the segment names offers the member either from its
            // own declarations or through its `export` edges, and a path
            // through a facade names the same item the declaring module's
            // path names - one item, many spellings.  The stamp records the
            // module that DECLARES the member, because that is the namespace
            // the member is registered under and the one every consumer of
            // this stamp appends the member to; recording the facade would
            // make `test::expect_eq` name a function `std::test` never
            // declared.  A member two of the facade's children declare is
            // refused, as it is everywhere else.
            mut owner: SymbolStr = found;
            mut offered: i64 = 0;
            const hit: SymbolID = this.module_offering(found, node.member_name, &offered);
            if (offered > 1) {
                const leaf_str: string = this.resolver.intern_table.resolve(node.member_name);
                mut d: Diagnostic = Diagnostic::error(
                    ErrorCode::E0155_AMBIGUOUS_BARE_NAME,
                    fmt::format("`%s` is offered by `%s` from more than one module, so it names nothing",
                        leaf_str, written));
                d = d.at_with_label(node.span, "ambiguous through this path");
                d = d.with_note(
                    "name the declaring module instead; a re-export offers what its children offer, and two of them offer this");
                this.ctx.emit_diagnostic(d);
                node.set_scope_res(Res::Err);
                return;
            }
            if (offered == 1) {
                const hs: Symbol = this.resolver.get_symbol(hit);
                const declared_in: string = QualifiedName::parent_of(
                    this.resolver.intern_table.resolve(
                        this.resolver.qualified_name_of(&hs)));
                if (declared_in.length() > 0) {
                    owner = this.resolver.intern_table.intern(declared_in);
                }
            }
            node.set_scope_res(Res::Def(DefId::of_definition(owner)));
            return;
        }
        if (visible > 1) {
            // Two modules the writer can see, both spelled this way: the
            // spelling does not name one of them.  Never picked, because
            // picking is the defect.
            const a: string = this.resolver.intern_table.resolve(found);
            const b: string = this.resolver.intern_table.resolve(other);
            if (!binds_in_scope) {
                mut d: Diagnostic = Diagnostic::error(
                    ErrorCode::E0154_AMBIGUOUS_CALL,
                    fmt::format("`%s` names more than one module in scope", written));
                d = d.at_with_label(node.scope_span, "ambiguous module path");
                d = d.with_note(fmt::format("it could be `%s` or `%s`", a, b));
                d = d.with_note(
                    "write the path out in full to say which one is meant");
                this.ctx.emit_diagnostic(d);
                node.set_scope_res(Res::Err);
            } else {
                // The segment binds in scope, so it names a TYPE and the module
                // spellings never applied to it.  No diagnostic was emitted, so
                // `Err` would be a refusal nobody reported.
                node.set_scope_res(Res::TypeRelative(base, trailing));
            }
            return;
        }
        if (matched > 0) {
            // A module carries this spelling and the writer cannot reach it.
            // The name exists, so this is E0240's story and not "no such name"
            // (E0203) nor "reachable but private" (E0353).
            const owner: string = this.resolver.intern_table.resolve(any);
            if (!binds_in_scope) {
                mut d: Diagnostic = Diagnostic::error(
                    ErrorCode::E0240_NAMESPACE_NOT_REACHABLE,
                    fmt::format("`%s` is not reachable from this module", written));
                d = d.at_with_label(node.scope_span, "not reachable in this scope");
                // The import names the WHOLE namespace: what makes the path
                // unreachable is that its first segment binds to nothing here,
                // and only the full path fixes that.
                d = d.with_note(fmt::format("`%s` is the module it would name", owner));
                d = d.with_note(
                    fmt::format("add `import %s;` to bring it into scope", owner));
                this.ctx.emit_diagnostic(d);
                node.set_scope_res(Res::Err);
            } else {
                // Binds in scope: a type wearing a module's spelling.  The
                // module was never what this path named, so its unreachability
                // is not this node's answer.
                node.set_scope_res(Res::TypeRelative(base, trailing));
            }
            return;
        }
        // No module in the program carries this spelling, so whatever the
        // segment names is not a module and the rest of the path needs a
        // receiver type.  That is the type layer's to finish, which is what
        // `TypeRelative` asserts - and the assertion has to be earned per node
        // rather than taken as the leftover case, or a lookup this pass simply
        // could not perform gets recorded as somebody else's property.
        //
        // A segment that binds in the writer's scope names a type outright.
        // One that binds to nothing still reaches here for two reasons that are
        // equally type-owned - it spells a primitive, which owns members
        // without being declared anywhere, or it is itself a path whose own
        // last segment names the type.  A segment belonging to none of those
        // is a segment nothing in the program owns, so there is no type to
        // name as the base: it is left unanswered, because a stamp invented
        // here would assert an ownership the type layer cannot check, and an
        // unanswered slot is reported against whatever later stage actually
        // needs it - with a location - instead of being absorbed here.
        if (!have_base) { return; }
        node.set_scope_res(Res::TypeRelative(base, trailing));
    }

    /// Stamp the written types in a `where` clause.
    ///
    /// A bound spells types three times over - the projection it constrains,
    /// the trait it names, and the arguments of that trait - and all three are
    /// ordinary written syntax in the file holding the clause.
    stamp_trait_bounds(&this, bounds: &TraitBound[]) -> void {
        for (mut i: i64 = 0; i < bounds.length; i++) {
            const b: TraitBound* = &bounds[i];
            this.stamp_annotation(b.subject_type);
            for (mut j: i64 = 0; j < b.trait_refs.length; j++) {
                const tref: TraitRef* = &b.trait_refs[j];
                this.stamp_trait_ref_identity(tref);
                this.stamp_annotation_list(&tref.type_args);
            }
        }
    }

    /// Record which trait a bound names, under the canonical name the trait
    /// registries are keyed by.
    ///
    /// The path is a type spelling like any other and is answered the same
    /// way: a bare leaf in the writer's scope, a qualified path rooted at the
    /// module its head names.  Answering it here is what lets a bound be
    /// written as `traits::Future<i64>`: the scope map alone canonicalizes a
    /// bare leaf and hands a qualified spelling back as written, and a bound
    /// keyed by its spelling reaches no registered trait, so every method
    /// dispatched through it came back untyped.
    ///
    /// Only a definition is an identity.  A type parameter or a spelling this
    /// pass cannot place leaves the field empty, and `TraitRef::identity`
    /// then falls back to the written leaf and says so on its audit row.
    stamp_trait_ref_identity(&this, tref: TraitRef*) -> void {
        if (tref == null || tref.path.length == 0) { return; }
        if (tref.resolved_name.is_valid()) { return; }
        mut written: string = this.resolver.intern_table.resolve(tref.path[0]);
        for (mut i: i64 = 1; i < tref.path.length; i++) {
            written = written + "::" + this.resolver.intern_table.resolve(tref.path[i]);
        }
        match (this.type_spelling_res(this.resolver.intern_table.intern(written), tref.span)) {
            ResSlot::Answered(r) => {
                match (r) {
                    Res::Def(q) => { tref.resolved_name = q.qualified_name(); }
                    _           => { }
                }
            }
            _ => { }
        }
    }

    /// Stamp a written list of type arguments.
    ///
    /// An expression carries the same written type syntax a declaration does -
    /// `Array<T, GlobalAlloc> { }` and `Layout::of<Entry<K, V>>()` spell a type
    /// the way an annotation spells one - and the position a spelling is
    /// written in does not change what it names.  A list left unwalked is a
    /// node with a span and a slot that no consumer can read an answer from.
    stamp_annotation_list(&this, args: &TypeAnnotation*[]) -> void {
        for (mut i: i64 = 0; i < args.length; i++) {
            this.stamp_annotation(args[i]);
        }
    }

    /// Stamp every `Named` node in a type-annotation tree.
    ///
    /// A `TypeAnnotation` is not an AST node and is never `accept`-visited, so
    /// the walk is explicit and every visitor holding one calls it.
    ///
    /// It descends per NODE rather than judging the tree at its root, because
    /// an annotation tree is not written in one place: a spliced default type
    /// argument keeps the span of the file it came FROM, so judging it at the
    /// enclosing declaration would make one declaration's default mean a
    /// different thing per caller.
    stamp_annotation(&this, ann: TypeAnnotation*) -> void {
        if (ann == null) { return; }
        match (*ann) {
            TypeAnnotation::Named(n)       => { this.stamp_named_annotation(n); }
            TypeAnnotation::Pointer(p)     => { this.stamp_annotation(p.inner); }
            TypeAnnotation::Reference(r)   => { this.stamp_annotation(r.inner); }
            TypeAnnotation::Array(a)       => {
                this.stamp_annotation(a.element);
                // `T[N]`'s size is the one EXPRESSION hanging off an
                // annotation.  It may name a constant or an enum variant, and
                // the fold that reads it runs in TypeResolution, so a written
                // qualifier has to be stamped here or there is nothing for
                // that fold to read but the spelling.
                if (a.size_expr != null) { a.size_expr.accept(this); }
            }
            TypeAnnotation::Projection(pj) => { this.stamp_annotation(pj.base); }
            TypeAnnotation::Function(f)    => {
                for (mut i: i64 = 0; i < f.parameters.length; i++) {
                    this.stamp_annotation(f.parameters[i]);
                }
                this.stamp_annotation(f.return_type);
            }
            TypeAnnotation::Tuple(t)       => {
                for (mut i: i64 = 0; i < t.elements.length; i++) {
                    this.stamp_annotation(t.elements[i]);
                }
            }
            TypeAnnotation::Generic(g)     => {
                this.stamp_annotation(g.base);
                for (mut i: i64 = 0; i < g.args.length; i++) {
                    this.stamp_annotation(g.args[i]);
                }
            }
            TypeAnnotation::ImplTrait(imp) => {
                for (mut i: i64 = 0; i < imp.bounds.length; i++) {
                    this.stamp_annotation(imp.bounds[i]);
                }
            }
            _ => {}
        }
    }

    /// What a written TYPE SPELLING refers to, as the file that WROTE it can
    /// see - never as the module the walk happens to be standing in.
    ///
    /// One answering path for every written type name, whatever node carries
    /// it: an annotation and a generic struct literal's `struct_type` ask the
    /// same question of the same syntax, and a second walk for the second node
    /// would be a second opinion about the same spelling - answering, in
    /// particular, straight past a module the writer cannot reach.
    ///
    /// `Pending` rather than a guess in every case it cannot answer. That is
    /// not a failed lookup: the type layer still resolves the name as it always
    /// did, and it is the only reason adding a stamp cannot change what a
    /// program compiles to.
    type_spelling_res(&this, name: SymbolStr, span: SourceSpan) -> ResSlot {
        const written: string = this.resolver.intern_table.resolve(name);
        if (written.length() == 0) { return ResSlot::Pending; }

        // A primitive names a builtin rather than a declaration, so the bare
        // lane below - which resolves against the writing module's declared
        // names - can never answer one, and `implement trait Clone for i8`
        // would be left Pending for a name that is not in doubt.  `Res` has no
        // variant meaning "missing", so this is an ANSWER: the spelling names
        // `i8` outright and nothing later can refine it.
        //
        // `is_primitive_spelling` is the authority, and the scope lane asks the
        // same one.  Two predicates for one question is a place for them to
        // disagree silently, and the keyword table cannot be the survivor: `()`
        // is punctuation, so no keyword spells the unit type.
        if (ResBase::is_primitive_spelling(written)) {
            return ResSlot::Answered(Res::PrimTy(name));
        }

        // A generic parameter names ITSELF, never whatever a call site binds it
        // to. Answering it here is what keeps the stamp a statement about
        // syntax; substitution happens strictly below this, in the type layer.
        const in_scope: SymbolID =
            this.resolver.lookup(name, this.resolver.current_scope);
        if (in_scope.is_valid()) {
            const sym: Symbol = this.resolver.get_symbol(in_scope);
            if (sym.kind == SymbolKind::GenericParam) {
                return ResSlot::Answered(Res::GenericParam(name));
            }
        }

        // A path's meaning turns on its first segment: that one resolves in
        // scope, and every later segment resolves inside whatever it named.  So
        // the question here is not "does this whole string name something" but
        // "who owns the rest of it".  A first segment naming a type - including
        // a generic parameter, whose associated items are reached through its
        // bound - hands the remainder to the type layer, which is what
        // `TypeRelative` states.  `I::Item` is that case and cannot be anything
        // else: no module is named `I`, so a refusal here would report a
        // failure the name layer has no standing to report.
        if (this.resolver.contains_separator(written)) {
            const head: string = QualifiedName::head_of(written);
            const head_sym: SymbolID = this.resolver.lookup(
                this.resolver.intern_table.intern(head),
                this.resolver.current_scope);
            if (head_sym.is_valid()) {
                mut hs: Symbol = this.resolver.get_symbol(head_sym);
                // An import binds a NAME; it does not say what kind of thing
                // the name is. The declaration it points at does, and it is
                // reached by the same canonical `module::name` the stamp would
                // record. Reading the binding's own kind instead answers
                // `Import` for every imported type, so `Enum::Variant` walked
                // straight past the type-relative answer and was left for a
                // later stage to re-derive from the written spelling.
                if (hs.kind == SymbolKind::Import && hs.source_module != "") {
                    const decl: SymbolID = this.resolver.lookup_in_module(
                        this.resolver.intern_table.intern(hs.source_module),
                        hs.name);
                    if (decl.is_valid()) { hs = this.resolver.get_symbol(decl); }
                }
                if (hs.kind == SymbolKind::GenericParam
                        || hs.kind == SymbolKind::Type) {
                    // The head is resolved and nothing after it is, so the
                    // count is what this walk did not account for rather than
                    // an estimate of what remains hard.
                    const trailing: u32 =
                        QualifiedName::segment_count(written) - 1;
                    mut hb: ResBase = ResBase::GenericParam(hs.name);
                    if (hs.kind == SymbolKind::Type) {
                        hb = ResBase::Def(DefId::of_definition(this.resolver.qualified_name_of(&hs)));
                    }
                    return ResSlot::Answered(Res::TypeRelative(hb, trailing));
                }
            }
            // The head names neither a type nor a generic parameter, so the
            // whole path names ONE definition - no receiver type is left for a
            // later stage to supply, which is what separates this from the
            // `TypeRelative` answer above.
            //
            // Which lane owns the path turns on what the head names, not on
            // which lane would answer first: a namespace some module
            // registered, or a scope the writing module owns.  Asked from the
            // annotation's OWN module rather than the cursor's, because a
            // qualified spelling means what the writing file's imports say it
            // means and the cursor is on whatever module the pass is walking.
            const q_ns: SymbolStr = this.ctx.module_ns_sym_of_file(span.file);
            if (q_ns.is_valid()) {
                const q_prefix: string = QualifiedName::parent_of(written);
                const q_mods: ModuleSpellingMatch =
                    this.ctx.modules_written_as(q_prefix, q_ns);
                if (q_mods.matched > 0) {
                    // A module carries the written prefix, so the module lane
                    // owns this path: it answers, or the path is refused.  It
                    // is deliberately NOT handed on to the leaf reading below,
                    // which resolves the leaf in the writer's scope and would
                    // answer straight past a module that is ambiguous or that
                    // the writer cannot reach - recording a name the source may
                    // not legally spell as though it were fine.
                    const q_rooted: SymbolID =
                        this.walk_module_rooted_type(written, q_ns, span);
                    if (q_rooted.is_valid()) {
                        const q_sym: Symbol = this.resolver.get_symbol(q_rooted);
                        const q_def: SymbolStr =
                            this.resolver.qualified_name_of(&q_sym);
                        return ResSlot::Answered(Res::Def(DefId::of_definition(q_def)));
                    }
                } else {
                    // No module in the program spells the prefix, so the head
                    // is not a module path at all.  A C-import namespace alias
                    // reaches here: it is a scope the writing module owns
                    // rather than a namespace any module registered, so the
                    // leaf reading in the writer's own module is what owns it.
                    //
                    // Declared under its alias-qualified spelling, whole -
                    // the bare leaf is deliberately not bound - so the
                    // spelling itself is the name looked up, in the writing
                    // module's scope, and its canonical name is that
                    // spelling.  A leaf lookup finds nothing here by
                    // construction.
                    const q_sid: u64 = this.resolver.find_module_scope(q_ns);
                    if (q_sid != 0) {
                        const alias_slot: ResSlot = this.leaf_in_module_scope(q_sid, name, span);
                        if (!alias_slot.is_pending()) { return alias_slot; }
                    }
                }
            }
            // Nothing in the writing module's scope answers the leaf, or the
            // module it was declared in contradicts the written qualifier.
            // Left unstamped, because recording an answer this pass cannot
            // produce is how a tool limitation becomes a claim.
            return ResSlot::Pending;
        }

        // The use site comes from the syntax. A span naming no module means a
        // synthesized node, and a synthesizer that knows its referent sets the
        // `Res` itself; judging against an invalid namespace would compare
        // unequal to every real module and refuse everything.
        const use_ns: SymbolStr = this.ctx.module_ns_sym_of_file(span.file);
        if (!use_ns.is_valid()) {
            return ResSlot::Pending;
        }
        const home_sid: u64 = this.resolver.find_module_scope(use_ns);
        if (home_sid == 0) {
            return ResSlot::Pending;
        }
        return this.leaf_in_module_scope(home_sid, name, span);
    }

    /// A bare leaf resolved in a MODULE's scope - that module's declarations,
    /// its imports, then the prelude - by the one entry point, and stamped
    /// from its answer directly.  A walk that starts at a module scope
    /// crosses no rib that binds a generic parameter, so the answer is a
    /// definition or nothing; nothing is `Pending`, because recording an
    /// answer this pass cannot produce is how a tool limitation becomes a
    /// claim.
    ///
    /// A leaf two imports of that scope tie for is refused HERE, where the
    /// name is written (E0154, as the identifier lane refuses it), and
    /// stamped `Err` so the type layer stays silent about it: `resolve_path`
    /// answered nothing for it, and the not-found the type layer would
    /// report is false - the name is found twice.  The tie is asked of the
    /// scope the name was written in, never of the cursor.
    leaf_in_module_scope(&this, module_scope: u64, name: SymbolStr,
                         span: SourceSpan) -> ResSlot {
        mut segs: SymbolStr[] = [];
        segs.push(name);
        const scope: ScopeID = ScopeID { id: module_scope };
        const r: Res = this.resolver.resolve_path(&segs, Namespace::Type, scope);
        match (r) {
            Res::Def(_) => { return ResSlot::Answered(r); }
            _           => { }
        }
        const mods: SymbolStr[] = this.resolver.ambiguous_modules_from(scope, name);
        if (mods.length < 2) { return ResSlot::Pending; }
        const leaf: string = this.resolver.intern_table.resolve(name);
        const a: string = this.resolver.intern_table.resolve(mods[0]);
        const b: string = this.resolver.intern_table.resolve(mods[1]);
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0154_AMBIGUOUS_CALL,
            fmt::format("`%s` is ambiguous: it is imported from both `%s` and `%s`",
                leaf, a, b));
        d = d.at_with_label(span, "ambiguous type name");
        d = d.with_note(fmt::format(
            "write the path out to say which one is meant, `%s::%s` or `%s::%s`",
            a, leaf, b, leaf));
        this.ctx.emit_diagnostic(d);
        return ResSlot::Answered(Res::Err);
    }

    /// Record what one annotation's written name refers to.
    ///
    /// The annotation is one of two nodes carrying a written TYPE SPELLING;
    /// a generic struct literal's `struct_type` is the other, and both are
    /// answered by `type_spelling_res` so the two cannot come to disagree
    /// about what a spelling names.
    stamp_named_annotation(&this, n: NamedAnnotation*) -> void {
        match (this.type_spelling_res(n.name, n.span)) {
            ResSlot::Answered(r) => { n.res.answer(r); }
            _                    => { }
        }
    }

    override visit(node: CallExprNode*) -> void {
        // Visit the callee expression (resolves the function name)
        node.callee.accept(this);

        const callee_node: ASTNode* = node.callee as ASTNode*;
        // If callee is an identifier, also collect overloads
        if (callee_node.kind == NodeKind::Identifier) {
            const id_node: IdentifierNode* = node.callee as IdentifierNode*;
            const overloads: SymbolID[] = this.resolver.lookup_overloads(
                id_node.name, this.resolver.current_scope);
            if (overloads.length > 1) {
                this.resolver.record_overloads(node.span, overloads);
            } else {
                // 0 or 1 candidate: record_overloads isn't called, so release
                // the array spine here rather than leaking it (SymbolID is Copy).
                overloads.drop();
            }
        }

        this.stamp_annotation_list(&node.generic_args);

        // Visit arguments
        for (mut i: int = 0; i < node.arguments.length; i++) {
            node.arguments[i].accept(this);
        }
    }

    override visit(node: MemberAccessNode*) -> void {
        // Visit the object expression; member resolution deferred to TypeResolution
        node.object.accept(this);
        this.stamp_annotation_list(&node.generic_args);
    }

    override visit(node: BinaryExprNode*) -> void {
        node.left.accept(this);
        node.right.accept(this);
    }

    override visit(node: UnaryExprNode*) -> void {
        node.operand.accept(this);
    }

    override visit(node: TernaryExprNode*) -> void {
        node.condition.accept(this);
        node.true_expr.accept(this);
        node.false_expr.accept(this);
    }

    override visit(node: IfExprNode*) -> void {
        node.condition.accept(this);
        node.then_expr.accept(this);
        if (node.else_expr != null) {
            node.else_expr.accept(this);
        }
    }

    override visit(node: MatchExprNode*) -> void {
        node.subject.accept(this);
        for (mut i: int = 0; i < node.arms.length; i++) {
            node.arms[i].accept(this);
        }
    }

    override visit(node: StaticMatchExprNode*) -> void {
        // The scrutinee is a type annotation resolved later by the
        // TypeResolver; each arm stamps its own type patterns.
        for (mut i: int = 0; i < node.arms.length; i++) {
            node.arms[i].accept(this);
        }
    }

    override visit(node: NewExprNode*) -> void {
        // `new <path>` denotes one of two things and the parser decides
        // neither: a TYPE to allocate, or a VARIANT of an enum.  One question
        // separates them, and it is the question every path already asks.
        //
        // `TypeRelative` means the name layer walked to a type and a type owns
        // the rest of the path - which for `new` is exactly `Enum::Variant`.
        // Any other answer means the whole path names one definition, so it is
        // the type being allocated.  There is no second lookup and no ordering
        // to get wrong: the single answer carries which case this is.
        // A `new` path is a TYPE path, optionally followed by one VARIANT
        // segment, and the parser decides neither half.
        //
        // Classification first, from what the WHOLE path resolves to.
        // `TypeRelative` means the name layer walked to a type and a type owns
        // the tail - which for `new` is exactly `Enum::Variant`. When the whole
        // path answers nothing, the same question is asked of the type path it
        // contains, one segment shorter: that is what `Mod::Enum::Variant` is.
        // Any other answer means the whole path names the type being allocated.
        const written: string = this.resolver.intern_table.resolve(node.type_name);
        mut do_split: boolean = false;
        match (this.type_spelling_res(node.type_name, node.span)) {
            ResSlot::Answered(r) => {
                match (r) {
                    Res::TypeRelative(_, _) => { do_split = true; }
                    _                       => { }
                }
            }
            _ => {
                if (this.resolver.contains_separator(written)) {
                    const parent_sym: SymbolStr = this.resolver.intern_table.intern(
                        QualifiedName::parent_of(written));
                    match (this.type_spelling_res(parent_sym, node.span)) {
                        ResSlot::Answered(pr) => {
                            match (pr) {
                                Res::Def(_) => { do_split = true; }
                                _           => { }
                            }
                        }
                        _ => { }
                    }
                }
            }
        }
        if (do_split) {
            node.set_variant_name(this.resolver.intern_table.intern(
                QualifiedName::leaf_of(written)));
            node.type_name = this.resolver.intern_table.intern(
                QualifiedName::parent_of(written));
        }

        // The node is stamped from the path it actually names - the type,
        // after any variant segment has been taken off it.  Stamping the
        // classification answer instead records the enum by a `Def` that
        // carries no generic arguments, and `new Option<i64>::Some(41)` then
        // resolves to `Option` rather than `Option<i64>`.
        match (this.type_spelling_res(node.type_name, node.span)) {
            ResSlot::Answered(r2) => { node.set_res(r2); }
            _                     => { }
        }

        // Resolve type name.  After the split above, so a variant path records
        // the ENUM rather than a leaf no scope binds.
        const type_sym: SymbolID = this.resolver.lookup(
            node.type_name, this.resolver.current_scope);
        if (type_sym.is_valid()) {
            this.resolver.record_resolution(node.span, type_sym);
        }

        this.stamp_annotation_list(&node.generic_args);

        for (mut i: int = 0; i < node.arguments.length; i++) {
            node.arguments[i].accept(this);
        }

        if (node.has_array_size()) {
            node.array_size.accept(this);
        }

        // Struct-initializer form `new Foo { field: value }`: resolve the field
        // initializer expressions so identifier references inside them are
        // recorded in the resolution map (mirrors visit(StructLiteralNode)).
        // Without this, a local used only as a `new`-init field value looks
        // unreferenced (drives W0001 false positives and misses LSP hover/def).
        if (node.has_struct_init()) {
            node.struct_init.accept(this);
        }
    }

    override visit(node: CastExprNode*) -> void {
        node.expression.accept(this);
        this.stamp_annotation(node.target_annotation);
    }

    override visit(node: StructLiteralNode*) -> void {
        // Resolve struct type name
        const type_sym: SymbolID = this.resolver.lookup(
            node.struct_type, this.resolver.current_scope);
        if (type_sym.is_valid()) {
            this.resolver.record_resolution(node.span, type_sym);
        }
        // The literal names a TYPE, and its spelling may be qualified, so it
        // is the annotation's question rather than the single-segment scope
        // lookup a bare value name gets - `type_sym` above answers whether the
        // leaf binds here, which is not the same thing.
        match (this.type_spelling_res(node.struct_type, node.span)) {
            ResSlot::Answered(r) => { node.set_res(r); }
            _                    => { }
        }
        this.stamp_annotation_list(&node.generic_args);

        // Visit field initializer expressions
        for (mut i: int = 0; i < node.field_inits.length; i++) {
            const init_value: ExpressionNode* = node.field_inits[i].value as ExpressionNode*;
            if (init_value != null) {
                init_value.accept(this);
            }
        }
    }

    override visit(node: ArrayLiteralNode*) -> void {
        for (mut i: int = 0; i < node.elements.length; i++) {
            node.elements[i].accept(this);
        }
        if (node.repeat_count_expr != null) {
            node.repeat_count_expr.accept(this);
        }
    }

    override visit(node: TupleLiteralNode*) -> void {
        for (mut i: int = 0; i < node.elements.length; i++) {
            node.elements[i].accept(this);
        }
    }

    override visit(node: ArrayAccessNode*) -> void {
        node.array.accept(this);
        node.index.accept(this);
    }

    override visit(node: LambdaExprNode*) -> void {
        this.resolver.enter_scope(ScopeKind::Lambda, "<lambda>", node.span);

        // Declare parameters
        for (mut i: int = 0; i < node.parameters.length; i++) {
            const param: VarDeclNode* = node.parameters[i];
            this.resolver.declare_parameter(param.name, param.span);
            this.stamp_annotation(param.type_annotation);
        }
        this.stamp_annotation(node.return_type_ann);

        // Visit body
        if (node.body != null) {
            node.body.accept(this);
        }

        this.resolver.exit_scope();
    }

    // Leaf expressions: no name resolution needed
    override visit(node: LiteralNode*) -> void {}
    override visit(node: SizeofExprNode*) -> void {
        this.stamp_annotation(node.type_ann);
    }
    override visit(node: AlignofExprNode*) -> void {
        this.stamp_annotation(node.type_ann);
    }


    // -- Statements --

    override visit(node: BlockStmtNode*) -> void {
        this.resolver.enter_scope(ScopeKind::Block, "<block>", node.span);
        this.visit_block_contents(node);
        this.resolver.exit_scope();
    }

    override visit(node: ReturnStmtNode*) -> void {
        if (node.has_expression()) {
            node.expression.accept(this);
        }
    }

    override visit(node: IfStmtNode*) -> void {
        node.condition.accept(this);
        node.then_stmt.accept(this);
        if (node.has_else()) {
            node.else_stmt.accept(this);
        }
    }

    override visit(node: WhileStmtNode*) -> void {
        node.condition.accept(this);
        node.body.accept(this);
    }

    override visit(node: DoWhileStmtNode*) -> void {
        node.body.accept(this);
        node.condition.accept(this);
    }

    override visit(node: LoopStmtNode*) -> void {
        if (node.body != null) { node.body.accept(this); }
    }

    override visit(node: TypeofExprNode*) -> void {
        if (node.operand != null) { node.operand.accept(this); }
    }

    override visit(node: DeleteExprNode*) -> void {
        if (node.operand != null) { node.operand.accept(this); }
    }

    override visit(node: AwaitExprNode*) -> void {
        if (node.operand != null) { node.operand.accept(this); }
    }

    override visit(node: YieldExprNode*) -> void {
        if (node.operand != null) { node.operand.accept(this); }
    }

    override visit(node: TryExprNode*) -> void {
        // Name resolution runs long before sema lowers `?`, so only the
        // source operand exists at this point.
        if (node.operand != null) { node.operand.accept(this); }
    }

    override visit(node: ForStmtNode*) -> void {
        // For loops create a scope for the loop variable
        this.resolver.enter_scope(ScopeKind::Block, "<for>", node.span);

        if (node.init != null) {
            node.init.accept(this);
        }
        if (node.condition != null) {
            node.condition.accept(this);
        }
        if (node.update != null) {
            node.update.accept(this);
        }
        if (node.body != null) {
            node.body.accept(this);
        }

        this.resolver.exit_scope();
    }

    override visit(node: MatchStmtNode*) -> void {
        node.subject.accept(this);
        for (mut i: int = 0; i < node.arms.length; i++) {
            node.arms[i].accept(this);
        }
    }

    override visit(node: MatchArmNode*) -> void {
        // Each arm gets its own scope for pattern bindings
        this.resolver.enter_scope(ScopeKind::Block, "<match-arm>", node.span);

        // Visit patterns (may introduce bindings)
        for (mut i: int = 0; i < node.patterns.length; i++) {
            node.patterns[i].accept(this);
        }

        // The guard is an expression of this arm's scope: it reads the
        // pattern's bindings and anything the module can see, so it is
        // resolved where the body is.  Left unvisited, every name in it stays
        // unstamped - a module constant in `n if n > LIMIT` is then refused
        // as not in scope, and a callee in it binds by spelling.
        if (node.guard != null) {
            node.guard.accept(this);
        }

        // Visit body
        if (node.body != null) {
            node.body.accept(this);
        }

        this.resolver.exit_scope();
    }

    override visit(node: StaticMatchStmtNode*) -> void {
        for (mut i: int = 0; i < node.arms.length; i++) {
            node.arms[i].accept(this);
        }
    }

    override visit(node: StaticMatchArmNode*) -> void {
        // The pattern IS a type, written in this file, so it is stamped like
        // any other written type.  It binds no name, which is why the arm
        // scope below holds only the body.
        this.stamp_annotation_list(&node.type_patterns);
        this.resolver.enter_scope(ScopeKind::Block, "<static-match-arm>", node.span);
        if (node.body != null) {
            node.body.accept(this);
        }
        this.resolver.exit_scope();
    }

    override visit(node: PatternNode*) -> void {
        // A bare identifier pattern is normally a fresh binding. But if the
        // name resolves to an existing `const`, it is a *value* pattern -
        // compare the subject against the constant - not a binding (the rule
        // Rust uses for named constants in patterns). Without this, a match
        // like `match (code) { ENOENT => ...; EAGAIN => ... }` silently treats
        // every const arm as a catch-all binding, so only the first arm ever
        // runs. Reclassify by moving the name into `value` and clearing
        // `binding_name`; downstream passes (sema, codegen) treat an Identifier
        // pattern with no `binding_name` as a constant-value pattern.
        if (node.pattern_kind == PatternKind::Identifier) {
            const sym: SymbolID = this.resolver.lookup(
                node.binding_name, this.resolver.current_scope);
            if (sym.is_valid()
                    && this.resolver.get_symbol(sym).kind == SymbolKind::Constant) {
                this.resolver.record_resolution(node.span, sym);
                node.set_value(node.binding_name);
                node.set_binding_name(SymbolStr::empty());
                // The same answer an identifier naming this constant gets,
                // recorded on the node for the stage that compares against it.
                match (this.bare_name_res(sym)) {
                    ResSlot::Answered(r) => { node.set_const_res(r); }
                    _                    => { }
                }
            } else {
                this.resolver.declare_variable(node.binding_name, node.span, false,
                                               false);
            }
        }
    }

    override visit(node: EnumPatternNode*) -> void {
        // Resolve enum name
        const enum_sym: SymbolID = this.resolver.lookup(
            node.enum_name, this.resolver.current_scope);
        if (enum_sym.is_valid()) {
            this.resolver.record_resolution(node.span, enum_sym);
        }
        // The pattern names a TYPE, and its spelling may be qualified, so it is
        // the annotation's question rather than the single-segment scope lookup
        // a bare value name gets.  `enum_span` is the enum-path side of the
        // pattern, which is what this stamp is about.
        match (this.type_spelling_res(node.enum_name, node.enum_span)) {
            ResSlot::Answered(r) => { node.set_res(r); }
            _                    => { }
        }

        // Declare each binding variable
        for (mut i: i64 = 0; i < node.elements.length; i++) {
            const pb: PatternBinding* = node.binding_at(i);
            if (pb == null) { continue; }
            this.resolver.declare_variable(pb.name, pb.span, false, false);
        }
    }

    override visit(node: ExprStmtNode*) -> void {
        node.expression.accept(this);
    }

    override visit(node: DeclStmtNode*) -> void {
        if (node.declaration != null) {
            node.declaration.accept(this);
        }
    }

    override visit(node: UnsafeBlockStmtNode*) -> void {
        if (node.block != null) {
            node.block.accept(this);
        }
    }

    override visit(node: AsmBlockStmtNode*) -> void {
        // Resolve the variable references inside each `{...}` operand so
        // sema and codegen see bound identifiers.
        for (mut i: i64 = 0; i < node.operands.length; i++) {
            const op: AsmOperand* = node.operands[i];
            if (op != null && op.expr != null) {
                op.expr.accept(this);
            }
        }
    }

    /// Visit block contents without creating a new scope (caller manages scope).
    visit_block_contents(block: BlockStmtNode*) -> void {
        if (block == null) { return; }
        for (mut i: int = 0; i < block.statements.length; i++) {
            block.statements[i].accept(this);
        }
    }

    /// Record a module-level `const NAME = expr;` so its value can be folded.
    ///
    /// Fixed array sizes (`u8[NAME]`) are resolved long before codegen turns a
    /// const into a runtime global, so the initializer has to be captured here
    /// or the array's size is never known.
    ///
    /// The value is NOT computed here.  An initializer may name a constant or
    /// an enum that another module declares, and this pass runs over every
    /// module before any of them is walked; folding at the declaration could
    /// only ever see what preceded it.  A non-integer initializer is recorded
    /// too and simply never folds - only a use that needs the value reports
    /// anything.
    record_const_value(&this, node: VarDeclNode*) -> void {
        if (this.ctx == null || this.ctx.const_table == null) { return; }
        const intern: InternTable* = this.ctx.intern_table;
        if (intern == null) { return; }
        if (node.initializer == null) { return; }

        const qualified: SymbolStr = if (this.ctx.has_namespace()) {
            ConstantTable::intern_qualified(intern, this.ctx.namespace_str, node.name)
        } else {
            node.name
        };
        // The declared type travels with the initializer: it is what decides
        // whether `1 / 2` is this constant's 0 or its 0.5, and the folder
        // cannot recover it from the expression.
        this.ctx.const_table.register(
            qualified, node.initializer,
            ConstantTable::declares_integer(node.type_annotation, intern));
    }

    /// Record a module-level enum so `Enum::Variant` folds to its discriminant
    /// wherever a compile-time integer is wanted.  Keyed the same two ways a
    /// constant is, because a use site spells an enum the same ways.
    record_enum_decl(&this, node: EnumDeclNode*) -> void {
        if (this.ctx == null || this.ctx.const_table == null) { return; }
        const intern: InternTable* = this.ctx.intern_table;
        if (intern == null) { return; }

        const qualified: SymbolStr = if (this.ctx.has_namespace()) {
            ConstantTable::intern_qualified(intern, this.ctx.namespace_str, node.name)
        } else {
            node.name
        };
        this.ctx.const_table.register_enum(qualified, node);
    }

    /// The module in `m`'s `export` closure that publicly exports `name`, or
    /// an invalid SymbolStr when none does.
    ///
    /// This is the second half of one question - what does `m` OFFER under
    /// this name - whose first half is `m`'s own export table.  It is not a
    /// second strategy for the same lookup: the offered set is defined as the
    /// union, because an `export` grants an importer what the same path would
    /// grant if it were imported there.
    reexport_offering(&this, m: SymbolStr, name: SymbolStr) -> SymbolStr {
        const via: SymbolStr[] = this.ctx.module_graph.reexport_closure(m);
        for (mut i: i64 = 0; i < via.length; i++) {
            if (this.resolver.lookup_in_module(via[i], name).is_valid()) {
                return via[i];
            }
        }
        return SymbolStr::empty();
    }

    /// The declaration module `m` OFFERS under `name`, or invalid.
    ///
    /// A module offers its own exports plus everything its `export` edges pass
    /// on.  One item may have many valid paths - `std::collections::HashMap` is
    /// a re-export and nobody writes the declaring module - so a facade path is
    /// a first-class path and not a weaker alias.  What stays canonical is the
    /// IDENTITY the path reaches, which is why two routes to one declaration
    /// count once and two declarations count twice.
    ///
    /// The closure must answer EXACTLY ONCE.  `std::alloc` re-exports both
    /// `arc` and `rc`, so `alloc::Weak` reaches two declarations and therefore
    /// names neither; returning whichever the walk met first would make the
    /// answer depend on the order the graph happened to be built in, which is
    /// the property this migration exists to delete.  102 names in the tree are
    /// plural this way and none is written today.
    ///
    /// `hits` separates "no such name here" from "that name is ambiguous here",
    /// because those call for different diagnostics and a bare invalid cannot
    /// tell them apart.
    module_offering(&this, m: SymbolStr, name: SymbolStr, hits: i64*) -> SymbolID {
        *hits = 0;
        // A module that DECLARES the name offers that one.  A re-export cannot
        // displace a declaration, so this is not a first-of-several choice.
        const own: SymbolID = this.resolver.lookup_in_module(m, name);
        if (own.is_valid()) {
            *hits = 1;
            return own;
        }
        const via: SymbolStr[] = this.ctx.module_graph.reexport_closure(m);
        mut found: SymbolID = SymbolID::invalid();
        mut seen: SymbolStr = SymbolStr::empty();
        for (mut i: i64 = 0; i < via.length; i++) {
            const cand: SymbolID = this.resolver.lookup_in_module(via[i], name);
            if (!cand.is_valid()) { continue; }
            const cs: Symbol = this.resolver.get_symbol(cand);
            const q: SymbolStr = this.resolver.qualified_name_of(&cs);
            if (seen.is_valid()) {
                // Same declaration reached by a second route is one item, not
                // two candidates.
                if (!q.equals(seen)) { *hits = *hits + 1; }
                continue;
            }
            seen = q;
            found = cand;
            *hits = 1;
        }
        return found;
    }

    /// Binds what an `import` - or an `export` - names into the current scope.
    ///
    /// An export is deliberately NOT branched on here.  It grants an importer
    /// of this module what the same path would grant if it were imported here,
    /// and it grants this module the same thing, so binding it locally is not a
    /// side effect: it is half the rule, and it is why a module that
    /// re-exports a name can use that name without spelling the path twice.
    /// A branch would make the two forms drift.
    ///
    /// The other half - carrying those names on to this module's importers -
    /// is not reachable from here.  It needs the whole graph, and the walk it
    /// takes may revisit a module, whereas this pass sees one module at a time
    /// in topological order and re-exports create no ordering edge to sort by.
    /// `instance.cryo` closes over `ModuleInfo.reexports` once discovery has
    /// the full graph, and `DeclarationIndex` answers from that.
    /// Everything `module_sym` offers to a braced import, by leaf: its own
    /// public exports, the public exports of its re-export closure, and its
    /// sub-modules.  The set an `import M::{ name }` entry is answered from,
    /// in the order the three rungs ask.
    offered_leaves(&this, module_sym: SymbolStr, resolved_module: string) -> string[] {
        mut out: string[] = [];
        const own: SymbolID[] = this.resolver.get_exports(module_sym);
        for (mut i: i64 = 0; i < own.length; i++) {
            const sym: Symbol = this.resolver.get_symbol(own[i]);
            if (sym.visibility.is_public()) {
                out.push(this.resolver.intern_table.resolve(sym.name));
            }
        }
        const rx_all: SymbolStr[] = this.ctx.module_graph.reexport_closure(module_sym);
        for (mut rx: i64 = 0; rx < rx_all.length; rx++) {
            const rx_exports: SymbolID[] = this.resolver.get_exports(rx_all[rx]);
            for (mut re: i64 = 0; re < rx_exports.length; re++) {
                const sym: Symbol = this.resolver.get_symbol(rx_exports[re]);
                if (sym.visibility.is_public()) {
                    out.push(this.resolver.intern_table.resolve(sym.name));
                }
            }
        }
        const prefix: string = resolved_module + "::";
        const graph: ModuleGraph* = this.ctx.module_graph;
        for (mut mi: u32 = 0; mi < graph.modules.length; mi++) {
            const cand: string = this.resolver.intern_table.resolve(graph.modules[mi].name);
            if (!cand.starts_with(prefix)) { continue; }
            const rest: string = cand.substring(prefix.length() as u32, (cand.length() - prefix.length()) as u32);
            if (rest.contains("::")) { continue; }
            out.push(rest);
        }
        return out;
    }

    /// E0502: a braced import entry that names nothing the module offers -
    /// not a declaration, not a re-export, not a sub-module.  The module's
    /// offering is named so the writer can see what to write instead; a
    /// close spelling is offered as the fix.
    refuse_unoffered_import(&this, node: ImportDeclNode*, module_sym: SymbolStr,
                            resolved_module: string, name_str: string) -> void {
        const offered: string[] = this.offered_leaves(module_sym, resolved_module);
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0502_INVALID_IMPORT,
            fmt::format("`%s` does not offer `%s`", resolved_module, name_str));
        d = d.at_with_label(node.span, "no declaration, re-export or sub-module of that name");
        mut listed: string = "";
        const count: i64 = offered.length;
        const cap: i64 = if (count < 12) { count } else { 12 };
        for (mut i: i64 = 0; i < cap; i++) {
            if (i > 0) { listed = listed + ", "; }
            listed = listed + "`" + offered[i] + "`";
        }
        if (count > cap) {
            listed = listed + fmt::format(" and %lld more", count - cap);
        }
        // Last: the candidate search consumes the list.
        const best: string = find_best_candidate(name_str, offered);
        if (best != "") {
            d = d.help(fmt::format("a name with a similar spelling is offered: `%s`", best));
        }
        if (count == 0) {
            d = d.with_note(fmt::format("`%s` offers no public name", resolved_module));
        } else {
            d = d.with_note(fmt::format("`%s` offers %s", resolved_module, listed));
        }
        this.ctx.emit_diagnostic(d);
    }

    /// E0502: an import path that is no module's registered name.  The
    /// modules whose name the path is a whole-segment suffix of are offered
    /// as the fix, because that is the mistake the shape comes from - the
    /// path a QUALIFIER may abbreviate to is written where the whole name
    /// is required.
    refuse_unknown_module_import(&this, node: ImportDeclNode*, module_path: string) -> void {
        mut d: Diagnostic = Diagnostic::error(
            ErrorCode::E0502_INVALID_IMPORT,
            fmt::format("`%s` is not a module's name", module_path));
        d = d.at_with_label(node.span, "no module is registered under this name");
        const graph: ModuleGraph* = this.ctx.module_graph;
        mut named: string = "";
        mut count: i64 = 0;
        for (mut mi: u32 = 0; mi < graph.modules.length; mi++) {
            const cand: string = this.resolver.intern_table.resolve(graph.modules[mi].namespace_name);
            if (cand.length() == 0 || !Resolver::ns_written_as(cand, module_path)) { continue; }
            if (count > 0) { named = named + ", "; }
            named = named + "`" + cand + "`";
            count = count + 1;
        }
        if (count > 0) {
            d = d.help(fmt::format("an import names a module whole; the name this path abbreviates is %s", named));
        }
        this.ctx.emit_diagnostic(d);
    }

    process_import(node: ImportDeclNode*) -> void {
        const module_path: string = node.module_path;
        LOG_DEBUG(LogComponent::General, "[NameResolver] process_import() module='%s'", module_path);

        // Resolve import path to actual module namespace name.
        // Import paths (e.g. "core::option") may differ from the target
        // module's namespace (e.g. "std::core::option").  The module graph
        // stores dependencies by namespace name (after the module_loader fix),
        // so we look up by dependency name first, then fall back to raw path.
        mut module_sym: SymbolStr = this.resolver.intern_table.intern(module_path);

        // Try to find the module in the graph by its actual registered name.
        // ModuleGraph::find_module_index uses the module's namespace-based name,
        // which matches dependencies recorded by the loader.
        // NOTE: Access module_graph directly through this.ctx rather than a local
        // pointer; method-call and field-access resolution through the receiver
        // chain is more reliable than through a local pointer alias.
        // An import path names a module by its registered name; a path the
        // graph does not hold binds nothing, and the use site reports it.
        // The suffix match that stood here answered zero imports over the
        // corpus and was deleted.

        // An import names a module by its registered name, whole.  A path
        // the loader resolved to a file whose namespace is spelled
        // otherwise (`import core::option;` for `std::core::option`) names
        // no module in the graph: nothing it could bind is registered under
        // that spelling, and a plain `import M;` would otherwise stand in the
        // file binding nothing and saying nothing.  Refused here for every
        // form, before the braced form's entries are judged against an
        // offering that does not exist.
        if (this.ctx.module_graph != null
                && this.ctx.module_graph.find_module_index(module_sym) < 0) {
            this.refuse_unknown_module_import(node, module_path);
            return;
        }

        const exports: SymbolID[] = this.resolver.get_exports(module_sym);

        // Use the resolved namespace name for source_module on import symbols
        // so that `qualified_name_of` builds the canonical name (e.g.
        // "std::core::option::Option", not "core::option::Option").
        const resolved_module: string = this.resolver.intern_table.resolve(module_sym);

        // `ImportStyle::Module` - a plain `import M;` - binds no names at all,
        // so it falls out of both branches below.  The work above it still
        // matters: the path is resolved to a module, which is what `M::X`
        // answers against and what the loader's dependency edge is keyed on.
        //
        // `Wildcard` is the EXPLICIT glob, `M::*`, plus the two the compiler
        // injects: the prelude and the f-string runtime.  Those stay globs
        // because their contents are data - no name list can be written for a
        // prelude - and neither is a module path anybody wrote.
        if (node.style == ImportStyle::Wildcard) {
            // Bring all public exports into scope as Import-kind symbols.
            // Uses declare_import (last-import-wins) so that when two modules
            // export the same bare name, the later import takes priority.
            for (mut i: i64 = 0; i < exports.length; i++) {
                const export_sym: Symbol = this.resolver.get_symbol(exports[i]);
                if (export_sym.visibility.is_public()) {
                    const id: SymbolID = this.resolver.alloc_symbol_id();
                    const import_sym: Symbol = Symbol::import_sym(
                        id, export_sym.name, this.resolver.current_scope,
                        node.span, resolved_module);
                    this.resolver.declare_import(import_sym);
                }
            }
            // A re-exported namespace is part of what this module offers, so
            // importing the module brings its names too.  The walk is
            // transitive because `export` is: a name reachable through a facade
            // of a facade is offered by both, and stopping one hop in leaves it
            // bound nowhere in scope, findable only by a leaf search that
            // ignores the writing file entirely.
            //
            // Each name keeps the module that DECLARED it, not the one that
            // passed it along: the qualified name is an identity, and routing
            // it through the re-exporter would give the same declaration two.
            const rx_all: SymbolStr[] =
                this.ctx.module_graph.reexport_closure(module_sym);
            for (mut rx: i64 = 0; rx < rx_all.length; rx++) {
                const rx_ns: SymbolStr = rx_all[rx];
                const rx_str: string = this.resolver.intern_table.resolve(rx_ns);
                const rx_exports: SymbolID[] = this.resolver.get_exports(rx_ns);
                for (mut re: i64 = 0; re < rx_exports.length; re++) {
                    const rx_sym: Symbol = this.resolver.get_symbol(rx_exports[re]);
                    if (!rx_sym.visibility.is_public()) { continue; }
                    const rx_src: string =
                        if (rx_sym.source_module != "") { rx_sym.source_module }
                        else { rx_str };
                    const rid: SymbolID = this.resolver.alloc_symbol_id();
                    const rimp: Symbol = Symbol::import_sym(
                        rid, rx_sym.name, this.resolver.current_scope,
                        node.span, rx_src);
                    this.resolver.declare_import(rimp);
                }
            }
        } else if (node.style == ImportStyle::Specific) {
            // ImportStyle::Specific: each entry is either
            //   (a) a symbol `module_path` OFFERS - declared by it, or
            //       reached through its `export` closure, e.g.
            //       `import std::fmt::{ println }`, OR
            //   (b) a sub-module of `module_path`, e.g.
            //       `import compiler::{ CompileMode, Codegen }`.
            // (a) is ONE question - what does this module offer under this
            // name - and the offered set is its own exports UNION what it
            // re-exports, which is the set the Wildcard branch binds.  Reading
            // only the own-exports half is what made `import M::{ N };` and
            // `import M;` answer differently for the same `N`.
            // (b) is a DIFFERENT question, asked only when the module offers
            // no such symbol: build `<resolved_module>::<name>`, locate that
            // sub-module in the graph, and wildcard-import its exports -
            // exactly what `import compiler::compile_mode;` does in Wildcard
            // mode.
            for (mut i: int = 0; i < node.specific_imports.length; i++) {
                const name: SymbolStr = node.specific_imports[i];
                mut offered: boolean = false;
                mut offered_src: string = "";
                const found: SymbolID = this.resolver.lookup_in_module(module_sym, name);
                if (found.is_valid()) {
                    offered_src = resolved_module;
                    offered = true;
                } else {
                    // Reached through `module_path`'s `export` closure.  The
                    // name keeps the module that DECLARED it, not the one that
                    // passed it along, exactly as the Wildcard branch does: the
                    // qualified name is an identity, and routing it through the
                    // re-exporter would give the same declaration two.
                    const via: SymbolStr = this.reexport_offering(module_sym, name);
                    if (via.is_valid()) {
                        const vid: SymbolID =
                            this.resolver.lookup_in_module(via, name);
                        const vsym: Symbol = this.resolver.get_symbol(vid);
                        const vstr: string =
                            this.resolver.intern_table.resolve(via);
                        const vsrc: string =
                            if (vsym.source_module != "") { vsym.source_module }
                            else { vstr };
                        offered_src = vsrc;
                        offered = true;
                    }
                }
                if (offered) {
                    const id: SymbolID = this.resolver.alloc_symbol_id();
                    const import_sym: Symbol = Symbol::import_sym(
                        id, name, this.resolver.current_scope,
                        node.span, offered_src);
                    this.resolver.declare_import(import_sym);
                } else if (!node.is_export
                           && this.resolver.private_declaration(module_sym, name).is_valid()) {
                    // The module declares the name and marks it `private`.
                    // Visibility is a gate at the point a candidate is
                    // proposed, and the import is where this one is: binding
                    // nothing here in silence would leave the use site to
                    // report "no such name" for a name that exists, and
                    // binding it would make `private` advisory.  An `export`
                    // naming a private declaration is E0241, reported by the
                    // export check once the graph is whole.
                    const name_str: string = this.resolver.intern_table.resolve(name);
                    mut d: Diagnostic = Diagnostic::error(
                        ErrorCode::E0353_PRIVATE_ACCESS,
                        fmt::format("`%s::%s` is private and cannot be imported into `%s`",
                            resolved_module, name_str,
                            this.resolver.intern_table.resolve(this.ctx.current_module_ns())));
                    d = d.at_with_label(node.span, "private declaration named by this import");
                    this.ctx.emit_diagnostic(d);
                } else if (node.is_export
                           && this.resolver.private_declaration(module_sym, name).is_valid()) {
                    // An `export` naming a private declaration is E0241,
                    // reported by the export check once the graph is whole;
                    // it is not a name the module fails to offer.
                } else {
                    // (b) sub-module: "<resolved_module>::<name>"
                    const name_str: string = this.resolver.intern_table.resolve(name);
                    const sub_path: string = fmt::format("%s::%s", resolved_module, name_str);
                    const sub_sym: SymbolStr = this.resolver.intern_table.intern(sub_path);
                    if (this.ctx.module_graph.find_module_index(sub_sym) < 0) {
                        // Neither offered nor a sub-module: the entry names
                        // nothing, and binding nothing in silence leaves a
                        // use site - which may never exist - to say so.  The
                        // import is where the name is written, and what the
                        // module DOES offer is what a writer needs to fix it.
                        this.refuse_unoffered_import(node, module_sym, resolved_module, name_str);
                        continue;
                    }
                    // Import all public exports from the resolved sub-module.
                    const sub_exports: SymbolID[] = this.resolver.get_exports(sub_sym);
                    const sub_resolved: string = this.resolver.intern_table.resolve(sub_sym);
                    for (mut j: i64 = 0; j < sub_exports.length; j++) {
                        const sub_export_sym: Symbol = this.resolver.get_symbol(sub_exports[j]);
                        if (sub_export_sym.visibility.is_public()) {
                            const id: SymbolID = this.resolver.alloc_symbol_id();
                            const import_sym: Symbol = Symbol::import_sym(
                                id, sub_export_sym.name, this.resolver.current_scope,
                                node.span, sub_resolved);
                            this.resolver.declare_import(import_sym);
                        }
                    }
                }
            }
        }

        // Handle aliased imports
        if (node.has_alias()) {
            // The alias is a binding in the importing scope, as the module's
            // own name would be.
            const alias_id: SymbolID = this.resolver.alloc_symbol_id();
            const alias_sym: Symbol = Symbol::import_sym(
                alias_id, node.alias, this.resolver.current_scope,
                node.span, resolved_module);
            this.resolver.declare(alias_sym);
        }
    }
}


// Entry points: static methods for cross-module resolution

/// Declares and exports one module's own top-level names, and walks nothing.
///
/// Split out of NameResolution so a driver can run it over EVERY module before
/// any module's imports are processed.  An import is answered from the
/// declaring module's exports, and those exist only once that module has been
/// declared; inside an import cycle no module order can put every declarer
/// first, so the earlier module's import declares no symbol at all and the name
/// is absent from its scope for the rest of the compilation.
type struct NameDeclarationPass {
    static run(ctx: CompilationContext*) -> PassResult {
        LOG_DEBUG(LogComponent::General, "[NameDeclaration] run() entry");
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        ctx.init_resolver();
        if (ctx.resolver == null) {
            ctx.emit_error(ErrorCode::E0805_INTERNAL_ERROR, "Failed to initialize Resolver");
            return PassResult::failure(1);
        }

        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            LOG_DEBUG(LogComponent::General, "[NameDeclaration] No AST root available, skipping");
            return PassResult::ok();
        }

        // Creating the module's scope belongs with the declarations that go
        // into it.  In multi-module mode `switch_to_module` tries to set the
        // name but the Resolver may not exist yet, so the module graph is the
        // source of truth; the AST's own namespace wins where it carries one.
        if (ctx.active_module_index >= 0
            && ctx.active_module_index < ctx.module_graph.modules.length as i64) {
            const mod_info: ModuleInfo* = &ctx.module_graph.modules[ctx.active_module_index];
            const mod_name: SymbolStr = mod_info.namespace_name;
            if (mod_name.is_valid()) {
                ctx.resolver.set_module(mod_name);
            }
        }
        if (root.namespace_name != "") {
            ctx.resolver.set_module(ctx.intern(root.namespace_name));
        }

        const visitor: NameResolver = NameResolver(ctx.resolver, ctx);
        visitor.forward_declare(root);

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }
}

/// Wrapper struct so the entry point is a static method.  Cross-module
/// resolution of free functions through imported namespaces is
/// brittle at codegen time (compilation-ordering dependent); static methods
/// resolve reliably.
type struct NameResolutionPass {
    /// Run the name resolution pass on the compilation context.
    static run(ctx: CompilationContext*) -> PassResult {
        LOG_DEBUG(LogComponent::General, "[NameResolution] run() entry");
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();

        // Initialize the resolver if needed
        ctx.init_resolver();

        if (ctx.resolver == null) {
            ctx.emit_error(ErrorCode::E0805_INTERNAL_ERROR, "Failed to initialize Resolver");
            return PassResult::failure(1);
        }

        // Get AST root from artifacts
        const root: ProgramNode* = ctx.artifacts.ast.root;
        if (root == null) {
            LOG_DEBUG(LogComponent::General, "[NameResolution] No AST root available, skipping");
            return PassResult::ok();
        }

        // Entering the module is what this wants, and `set_module` is the way
        // in whose destination IS a module: the scope it lands in is the one
        // the module owns, built once and returned unchanged after, so there is
        // nothing here to save across the gap.  The scope the walk is standing
        // in at this point is that same module scope rather than a rib inside
        // it, so jumping to it moves nothing.
        //
        // The second arm keeps `restore_scope` because it is reached only when
        // no module graph entry matches, where the namespace comes off the AST
        // root and no module scope is known to exist for it.
        const walk_scope: u64 = ctx.resolver.get_current_scope_id();
        if (ctx.active_module_index >= 0
            && ctx.active_module_index < ctx.module_graph.modules.length as i64) {
            const mod_info: ModuleInfo* = &ctx.module_graph.modules[ctx.active_module_index];
            const mod_name: SymbolStr = mod_info.namespace_name;
            if (mod_name.is_valid()) {
                ctx.resolver.set_module(mod_name);
            }
        } else if (root.namespace_name != "") {
            ctx.resolver.restore_scope(ctx.intern(root.namespace_name), walk_scope);
        }

        // Create and run the visitor
        const visitor: NameResolver = NameResolver(ctx.resolver, ctx);
        root.accept(&visitor as ASTVisitor*);

        LOG_DEBUG(LogComponent::General, "[NameResolution] Resolved %lld symbols in %lld scopes, %lld map entries",
            ctx.resolver.symbol_count(),
            ctx.resolver.scope_count(),
            ctx.resolver.resolution_map.count());

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }

}
