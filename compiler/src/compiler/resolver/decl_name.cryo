/// DeclName
///
/// The text a declaration is known by - its own name as declared, or the
/// path of names that leads to it - when it is read off an identity rather
/// than off the source.  It is for showing: a diagnostic prints it, a
/// symbol is mangled from it, a synthesized node is named with it.  It is
/// never the key a lookup is asked by: the identity it came from already
/// answers every question the text could, and asking again by the text
/// is a second answering path that can disagree with the first.
///
/// The type is sealed: its text is read back only through
/// `InternTable::shown`, the bytes for a message, and `spelling`, the
/// interned name for a node that must carry one.  Sema follows what either
/// produces through the function that asked for it (`IdentityTextCheck`):
/// text computed from a `DeclName` that reaches a door's argument or a hash
/// table's key is refused there.
namespace compiler::resolver::decl_name;

import compiler::resolver::symbol_str;
import compiler::resolver::symbol_str::{ SymbolStr };

type struct DeclName {
private:
    sym: SymbolStr;

public:
    /// Seal `s`, the interned text of a declaration's name or path.
    ![allow(lookup_by_spelling, reason = "where a declaration's name becomes display-only text; it looks nothing up")]
    static of(s: SymbolStr) -> DeclName {
        return DeclName { sym: s };
    }

    /// The name of nothing: what an invalid identity reads as.
    static empty() -> DeclName {
        return DeclName { sym: SymbolStr::empty() };
    }

    is_valid(&this) -> boolean {
        return this.sym.is_valid();
    }

    /// The interned name, for a node synthesized to carry it.  The node is
    /// stamped with the identity where it is made; the name is what it
    /// prints as.
    spelling(&this) -> SymbolStr {
        return this.sym;
    }
}
