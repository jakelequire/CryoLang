/// Scope
///
/// Scope tree nodes for the Resolver.  Each Scope is a tree node with a
/// parent pointer (ScopeID) and child list.  Symbols within a scope are
/// stored in parallel arrays for ordered iteration, with a HashMap index
/// for O(1) name->SymbolID lookup.

namespace Compiler::Resolver::Scope;

import Compiler::Resolver::{ SymbolID, SymbolStr };
import Compiler::Diag;
import Compiler::Diag::SourceSpan;
import Utils::Logger;
import Compiler::ResolveCounter;
import std::core::option;
import std::collections::{ hashmap, pair };

type struct ScopeID {
    id: u64;

    /// Create an invalid scope ID (id = 0).
    static invalid() -> ScopeID {
        return ScopeID { id: 0 };
    }

    /// Create a new scope ID with the given value.
    static new(id: u64) -> ScopeID {
        return ScopeID { id: id };
    }

    /// Whether this refers to a valid scope (id != 0).
    is_valid(&this) -> boolean {
        return this.id != 0;
    }

    /// Check equality by ID.
    equals(&this, other: ScopeID) -> boolean {
        return this.id == other.id;
    }
}

type enum ScopeKind {
    Global;
    Module;
    Function;
    Block;
    TypeBody;
    Impl;
    Trait;
    Lambda;
}

implement enum ScopeKind {
    to_string(&this) -> string {
        return match (this) {
            ScopeKind::Global   => { "Global" }
            ScopeKind::Module   => { "Module" }
            ScopeKind::Function => { "Function" }
            ScopeKind::Block    => { "Block" }
            ScopeKind::TypeBody => { "TypeBody" }
            ScopeKind::Impl     => { "Impl" }
            ScopeKind::Trait    => { "Trait" }
            ScopeKind::Lambda   => { "Lambda" }
        };
    }


    /// Whether a name bound directly in this scope is a module-level
    /// declaration rather than a binding inside a function body.
    ///
    /// `SymbolKind` does not separate the two: a module-level `mut` global and
    /// a function local both declare as `Variable`, so the scope each was
    /// declared in is the only thing that tells them apart.  A global is
    /// reached by its canonical name in every index a later stage consults,
    /// while a local is reached only by its symbol, so answering one for the
    /// other hands that stage a key nothing is stored under.
    is_module_level(&this) -> boolean {
        return match (this) {
            ScopeKind::Global => { true }
            ScopeKind::Module => { true }
            _                 => { false }
        };
    }
}

/// One name bound directly in a scope, with the TIER it occupies.
///
/// `docs/name-resolution.md` §4 orders a scope's bindings:
///
///     locals / generic params
///       -> current-module items          (public AND private)
///       -> imported modules' export sets
///       -> prelude
///
/// and rule 1 makes that precedence TOTAL: an inner tier shadows an outer one
/// silently. A flat `name -> SymbolID` map cannot express it -- a declaration
/// and an import compete for one slot and the first writer wins -- so the tier
/// has to travel WITH the entry.
///
/// It is a field rather than a parallel `boolean[]` deliberately. A parallel
/// array holds its invariant only as long as every push site remembers to
/// update both, and a later third insert path that forgets desyncs it
/// silently: every index-based read after the missing push returns a
/// NEIGHBOUR's tier, which is a wrong bind with no diagnostic -- the exact
/// failure class this type exists to remove. §8.2l's rule, on a new surface:
/// put the fact where the entity is, so a future caller cannot forget it.
///
/// `Scope` holds SymbolIDs, not Symbols, and has no route back to the symbol
/// arena, so it cannot recover `SymbolKind::Import` on its own; the tier is
/// stated at insert time by which entry point was used.
///
/// The PRELUDE tier is not modelled here: it lives in the DeclarationIndex
/// (`prelude_ns`, `is_prelude_ns`), so `is_import == false` means "not an
/// import into this scope", not "tier 2 exclusively".
///
/// Note which system already had this precedence.
/// `DeclarationIndex::resolve_qualified_scoped` documents and implements it
/// ("a local definition beats imports") and is what the VALUE lane goes
/// through -- which is why a bare call in a module that both declares and
/// imports a leaf has always bound correctly, while the same shape in an
/// annotation bound to the import. Spec §4.4's "two answers for one question"
/// was this: two lookup systems, only one of which implemented §4.
type struct ScopeEntry {
    name:      SymbolStr;
    sym:       SymbolID;
    /// false = declared by this scope's own module (tier 2, or a local/param
    ///         in a Function/Block scope); true = brought in by an `import`
    ///         (tier 3).
    is_import: boolean;

    static new(name: SymbolStr, sym: SymbolID, is_import: boolean) -> ScopeEntry {
        return ScopeEntry { name: name, sym: sym, is_import: is_import };
    }
}

type struct Scope {
    id:              ScopeID;
    kind:            ScopeKind;
    parent_id:       ScopeID;
    module_name:     string;
    owner_name:      string;
    span:            SourceSpan;

    // One entry per name bound directly in this scope, in insertion order.
    symbols:         ScopeEntry[];

    // Fast lookup index: SymbolStr.id -> index in symbols[]
    symbol_index:    HashMap<u32, i64>;

    // Overloaded names: flat array of (name_key, SymbolID) pairs.
    overloads:       Pair<u32, SymbolID>[];

    child_scope_ids: ScopeID[];

    // Ambiguous imports: tracks names that were imported from multiple
    // modules.  When two imports define the same bare name from different
    // modules (e.g. "Pair" from BattleTest and Collections::Pair),
    // the name is recorded here so the resolver can emit an ambiguity error.
    // Uses SymbolStr (interned) to avoid dangling string pointers.
    ambig_name_ids:   u32[];      // SymbolStr.id of ambiguous names
    ambig_module_a:   u32[];      // SymbolStr.id of first module's path
    ambig_module_b:   u32[];      // SymbolStr.id of conflicting module's path

    static new(id: ScopeID, kind: ScopeKind, parent: ScopeID,
               module: string, owner: string, span: SourceSpan) -> Scope {
        return Scope {
            id:                 id,
            kind:               kind,
            parent_id:          parent,
            module_name:        module,
            owner_name:         owner,
            span:               span,
            symbols:            [],
            symbol_index:       HashMap<u32, i64>::new(),
            overloads:          [],
            child_scope_ids:    [],
            ambig_name_ids:     [],
            ambig_module_a:     [],
            ambig_module_b:     [],
        };
    }

    /// Look up a symbol in this scope only.  Returns invalid SymbolID if not found.
    find(&this, name: SymbolStr) -> SymbolID {
        const h: u64 = hash_int(name.id as u64);
        LOG_DEBUG(LogComponent::General,
            "[Scope] find('%s' id=%u) hash=%llu in scope '%s' (syms=%lld, map_len=%llu)",
            "<name>", name.id, h, this.owner_name,
            this.symbols.length, this.symbol_index.length());
        const opt: Option<i64> = this.symbol_index.get(&name.id);
        if (opt.is_some()) {
            const idx: i64 = opt.unwrap();
            LOG_DEBUG(LogComponent::General, "[Scope] find() found at idx=%lld in scope '%s'", idx, this.owner_name);
            return this.symbols[idx].sym;
        }
        LOG_DEBUG(LogComponent::General, "[Scope] find() NOT found in scope '%s'", this.owner_name);
        return SymbolID::invalid();
    }

    /// Insert a DECLARATION into this scope (tier 2, or a local/param).
    ///
    /// If the name already exists and allows_overload is true, adds to the
    /// overload set instead.  Returns false if the name is a duplicate
    /// declaration and overloading is not allowed.
    ///
    /// A declaration arriving over an IMPORT takes the slot: §4 rule 1 makes
    /// the precedence total, and it is a property of the two tiers, not of
    /// which line of the file came first.  Before this, `insert` returned
    /// false here and the module silently lost the ability to name its own
    /// declaration -- the whole defect, in one branch.
    insert(mut &this, name: SymbolStr, sym_id: SymbolID, allows_overload: boolean) -> boolean {

        // Check for existing symbol with the same name
        const existing: Option<i64> = this.symbol_index.get(&name.id);
        if (existing.is_some()) {
            const idx: i64 = existing.unwrap();
            if (this.symbols[idx].is_import) {
                // Tier 2 over tier 3.  The displaced import is dropped rather
                // than demoted into the overload set: §4 rule 1 says the
                // inner tier SHADOWS the outer one, so the import is reachable
                // only by a qualified path from here on.  Dropping it is also
                // what makes the two source orders agree -- declaration-first
                // already produced exactly this set, because `insert_import`
                // never added itself as an overload.
                ResolveCounter::Site::ScopeDeclOverImport.bump();
                this.symbols[idx].sym = sym_id;
                this.symbols[idx].is_import = false;
                // Any ambiguity recorded for this name was import-vs-import.
                // A declaration shadows every import of the name, so the
                // ambiguity is no longer reachable and must not be reported:
                // §4 rule 2 confines ambiguity to WITHIN a tier.
                this.clear_ambiguity(name);
                return true;
            }
            // An existing DECLARATION: unchanged behavior.
            if (allows_overload) {
                this.add_overload(name, sym_id);
                return true;
            }
            return false;
        }

        this.push_entry(name, sym_id, false);
        return true;
    }

    /// Insert an IMPORT symbol (tier 3).
    ///
    /// If this scope's own module already DECLARES the name, the import is
    /// shadowed and skipped silently -- §4 rule 1, and explicitly not a
    /// diagnostic.  If the name already exists as an import from a DIFFERENT
    /// module, mark it ambiguous (the user must qualify); from the SAME module
    /// (re-import), skip silently.
    /// module_a_id and module_b_id are SymbolStr IDs (interned, heap-safe).
    insert_import(mut &this, name: SymbolStr, sym_id: SymbolID,
                  new_module_id: u32, existing_module_id: u32) -> boolean {
        const existing: Option<i64> = this.symbol_index.get(&name.id);
        if (existing.is_some()) {
            const idx: i64 = existing.unwrap();
            // A declaration owns the slot; the import is shadowed.  Recording
            // ambiguity here is what made a module's own type "ambiguous"
            // against an import of the same leaf (E0203), which §4 rule 2
            // forbids: the two are in different tiers, so they never compete.
            if (!this.symbols[idx].is_import) {
                ResolveCounter::Site::ScopeImportShadowed.bump();
                return true;
            }
            // Same module re-import; skip silently
            if (new_module_id == existing_module_id) {
                return true;
            }
            // Different module; mark as ambiguous, keep the first import
            // so lookups still find SOMETHING, but the ambiguity flag
            // tells the resolver to emit an error.
            this.ambig_name_ids.push(name.id);
            this.ambig_module_a.push(existing_module_id);
            this.ambig_module_b.push(new_module_id);
            return true;
        }
        // No existing entry; insert normally
        this.push_entry(name, sym_id, true);
        return true;
    }

    /// Append a fresh binding and index it.  The ONLY place a `ScopeEntry` is
    /// created, so the tier and the index can never disagree with the array.
    push_entry(mut &this, name: SymbolStr, sym_id: SymbolID,
               is_import: boolean) -> void {
        const idx: i64 = this.symbols.length;
        this.symbols.push(ScopeEntry::new(name, sym_id, is_import));
        this.symbol_index.insert(name.id, idx);
    }

    /// Drop every ambiguity record for `name`.
    ///
    /// Called when a declaration takes the name's slot: the recorded conflict
    /// was between two imports, and both are now shadowed.
    clear_ambiguity(mut &this, name: SymbolStr) -> void {
        for (mut i: i64 = 0; i < this.ambig_name_ids.length; i++) {
            if (this.ambig_name_ids[i] == name.id) {
                ResolveCounter::Site::ScopeAmbigRetracted.bump();
            }
        }
        mut keep_names: u32[] = [];
        mut keep_a:     u32[] = [];
        mut keep_b:     u32[] = [];
        for (mut i: i64 = 0; i < this.ambig_name_ids.length; i++) {
            if (this.ambig_name_ids[i] == name.id) { continue; }
            keep_names.push(this.ambig_name_ids[i]);
            keep_a.push(this.ambig_module_a[i]);
            keep_b.push(this.ambig_module_b[i]);
        }
        this.ambig_name_ids = keep_names;
        this.ambig_module_a = keep_a;
        this.ambig_module_b = keep_b;
    }

    /// Check if a name is ambiguous (imported from multiple modules).
    is_ambiguous(&this, name: SymbolStr) -> boolean {
        for (mut i: i64 = 0; i < this.ambig_name_ids.length; i++) {
            if (this.ambig_name_ids[i] == name.id) {
                return true;
            }
        }
        return false;
    }

    /// Get the two conflicting module SymbolStr IDs for an ambiguous name.
    /// Returns [module_a_id, module_b_id] as u32 pair, or [0, 0] if not ambiguous.
    get_ambiguous_module_ids(&this, name: SymbolStr) -> u32[] {
        for (mut i: i64 = 0; i < this.ambig_name_ids.length; i++) {
            if (this.ambig_name_ids[i] == name.id) {
                return [this.ambig_module_a[i], this.ambig_module_b[i]];
            }
        }
        return [];
    }

    /// Add a symbol to the overload set for the given name.
    add_overload(mut &this, name: SymbolStr, sym_id: SymbolID) -> void {
        this.overloads.push(Pair<u32, SymbolID>::new(name.id, sym_id));
    }

    /// Get all overloads for a name (including the primary symbol).
    get_overloads(&this, name: SymbolStr) -> SymbolID[] {
        mut result: SymbolID[] = [];

        // Primary symbol
        const opt: Option<i64> = this.symbol_index.get(&name.id);
        if (opt.is_some()) {
            result.push(this.symbols[opt.unwrap()].sym);
        }

        // Overloaded symbols
        for (mut i: i64 = 0; i < this.overloads.length; i++) {
            if (this.overloads[i].first == name.id) {
                result.push(this.overloads[i].second);
            }
        }

        return result;
    }

    /// Register a child scope.
    add_child(mut &this, child: ScopeID) -> void {
        this.child_scope_ids.push(child);
    }
}
