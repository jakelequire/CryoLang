/// Demangler: Cryo Mangling Scheme v1.0.0 (docs/cryo-mangling-spec.md).
///
/// Pure-string state machine: takes a mangled symbol and renders a
/// human-readable Cryo-flavored signature.  No InternTable / TypeArena
/// is needed; the mangled form is self-describing.
///
/// Falls back to "<input> (unmangled)" for inputs that don't start with
/// `C$` (per spec section 1) and "<input> (malformed)" if parsing breaks
/// partway through, matching the spec's robustness goal.

namespace Compiler::Resolver::Demangler;
import ffi::libc;


// Cursor: linear scan position over the mangled string.

type struct Cursor {
    text: string;
    pos:  i64;
    len:  i64;
    ok:   boolean;
}

implement Cursor {
    static new(text: string) -> Cursor {
        return Cursor {
            text: text,
            pos:  0,
            len:  libc::strlen(text) as i64,
            ok:   true,
        };
    }

    eof(&this) -> boolean { return this.pos >= this.len; }

    peek(&this) -> char {
        if (this.pos >= this.len) { return 0 as char; }
        return this.text[this.pos];
    }

    peek_at(&this, off: i64) -> char {
        const i: i64 = this.pos + off;
        if (i < 0 || i >= this.len) { return 0 as char; }
        return this.text[i];
    }

    starts_with2(&this, a: char, b: char) -> boolean {
        if (this.pos + 1 >= this.len) { return false; }
        return this.text[this.pos] == a && this.text[this.pos + 1] == b;
    }

    advance(mut &this, n: i64) -> void {
        this.pos += n;
    }

    expect2(mut &this, a: char, b: char) -> void {
        if (!this.starts_with2(a, b)) { this.ok = false; return; }
        this.advance(2);
    }

    expect_char(mut &this, c: char) -> void {
        if (this.pos >= this.len || this.text[this.pos] != c) {
            this.ok = false;
            return;
        }
        this.advance(1);
    }

    take(mut &this, n: i64) -> string {
        if (n < 0 || this.pos + n > this.len) {
            this.ok = false;
            return "";
        }
        const s: string = this.text.substr(this.pos as u64, n as u64);
        this.pos += n;
        return s;
    }

    /// Read a non-empty run of decimal digits as an i64.  Returns 0 and
    /// flips `ok` to false if the next char isn't a digit.
    read_decimal(mut &this) -> i64 {
        if (this.pos >= this.len) { this.ok = false; return 0; }
        const c0: char = this.text[this.pos];
        if (!(c0 >= '0' && c0 <= '9')) { this.ok = false; return 0; }
        mut value: i64 = 0;
        while (this.pos < this.len) {
            const c: char = this.text[this.pos];
            if (!(c >= '0' && c <= '9')) { break; }
            value = value * 10 + ((c as i64) - ('0' as i64));
            this.advance(1);
        }
        return value;
    }

    // Parsing.  Each parse_* method consumes input via the cursor and
    // returns already-rendered strings; there's no intermediate AST.

    /// Identifier: `<decimal length><raw bytes>`.
    parse_ident(mut &this) -> string {
        const n: i64 = this.read_decimal();
        if (!this.ok) { return ""; }
        return this.take(n);
    }

    /// Segment: `<ident>` optionally followed by `$L <type-list> $G`.
    parse_segment(mut &this) -> string {
        const name: string = this.parse_ident();
        if (!this.ok) { return ""; }
        if (!this.starts_with2('$', 'L')) { return name; }
        this.advance(2);
        mut buf: string = name;
        buf += "<";
        mut first: boolean = true;
        while (this.ok) {
            if (this.starts_with2('$', 'G')) { this.advance(2); break; }
            if (!first) { this.expect_char('_'); }
            const t: string = this.parse_type();
            if (!this.ok) { return ""; }
            if (!first) { buf += ", "; }
            buf += t;
            first = false;
        }
        if (!this.ok) { return ""; }
        buf += ">";
        return buf;
    }

    /// Path: `<seg>{ . <seg> }*[ - <member-seg> ]`.
    parse_path(mut &this) -> ParsedPath {
        mut segs: string[] = [];
        const first_seg: string = this.parse_segment();
        if (!this.ok) {
            return ParsedPath { segments: segs, member: "", has_member: false };
        }
        segs.push(first_seg);
        while (this.ok && this.peek() == '.') {
            this.advance(1);
            const s: string = this.parse_segment();
            if (!this.ok) { break; }
            segs.push(s);
        }
        mut member: string = "";
        mut has_member: boolean = false;
        if (this.ok && this.peek() == '-') {
            this.advance(1);
            member = this.parse_segment();
            has_member = true;
        }
        return ParsedPath {
            segments:   segs,
            member:     member,
            has_member: has_member,
        };
    }

    /// Type: primitive | P/R/A<T> | N$L<path>$G | F$L<params>$G<ret> | K$L<params>$G<ret>.
    parse_type(mut &this) -> string {
        if (!this.ok || this.eof()) { this.ok = false; return ""; }
        const head: char = this.peek();

        if (Cursor::is_prim_code(head)) {
            this.advance(1);
            return Cursor::prim_code_to_name(head);
        }

        if (head == 'P') {
            this.advance(1);
            const inner: string = this.parse_type();
            if (!this.ok) { return ""; }
            return inner + "*";
        }
        if (head == 'R') {
            this.advance(1);
            const inner: string = this.parse_type();
            if (!this.ok) { return ""; }
            return "&" + inner;
        }
        if (head == 'A') {
            this.advance(1);
            const inner: string = this.parse_type();
            if (!this.ok) { return ""; }
            return inner + "[]";
        }
        if (head == 'N') {
            this.advance(1);
            this.expect2('$', 'L');
            if (!this.ok) { return ""; }
            const inner_path: ParsedPath = this.parse_path();
            this.expect2('$', 'G');
            if (!this.ok) { return ""; }
            return inner_path.render_inline();
        }
        if (head == 'F') {
            this.advance(1);
            this.expect2('$', 'L');
            if (!this.ok) { return ""; }
            const params: string = this.parse_param_list();
            this.expect2('$', 'G');
            if (!this.ok) { return ""; }
            const ret: string = this.parse_type();
            if (!this.ok) { return ""; }
            return "fn(" + params + ") -> " + ret;
        }
        if (head == 'K') {
            this.advance(1);
            this.expect2('$', 'L');
            if (!this.ok) { return ""; }
            const params: string = this.parse_param_list();
            this.expect2('$', 'G');
            if (!this.ok) { return ""; }
            const ret: string = this.parse_type();
            if (!this.ok) { return ""; }
            return "|" + params + "| -> " + ret;
        }

        this.ok = false;
        return "";
    }

    /// Parameter list: literal `v` for empty, otherwise `Param { _ Param }* [$V]`.
    /// Param ::= $s | $m | Type.  Receiver tokens are only valid in the first
    /// position; we render them verbatim either way and let the caller decide.
    parse_param_list(mut &this) -> string {
        if (!this.ok) { return ""; }

        // Empty list: literal 'v' that isn't the start of a Type tail (Type 'v'
        // means void, but as a *param* a bare leading 'v' with nothing else is
        // the empty marker per spec section 7).
        if (this.peek() == 'v') {
            const next: char = this.peek_at(1);
            // 'v' followed by a separator / end-of-list closer is the empty marker.
            if (next == 0 as char || next == '$' || next == ')') {
                this.advance(1);
                return "";
            }
        }

        mut buf: string = "";
        mut first: boolean = true;
        while (this.ok) {
            if (!first) {
                if (this.peek() != '_') { break; }
                this.advance(1);
                buf += ", ";
            }
            // Receiver markers
            if (this.starts_with2('$', 's')) {
                this.advance(2);
                buf += "&this";
                first = false;
                continue;
            }
            if (this.starts_with2('$', 'm')) {
                this.advance(2);
                buf += "mut &this";
                first = false;
                continue;
            }
            // Stop conditions: hit a structural marker that isn't a type or `_`.
            const a: char = this.peek();
            if (a == '$') { break; }
            if (a == 0 as char) { break; }

            const t: string = this.parse_type();
            if (!this.ok) { return ""; }
            buf += t;
            first = false;
        }

        // Variadic marker
        if (this.ok && this.starts_with2('$', 'V')) {
            this.advance(2);
            if (libc::strlen(buf) > 0) { buf += ", ..."; }
            else { buf = "..."; }
        }
        return buf;
    }

    // Mangling-code decode tables and demangle glue (no cursor state; kept
    // here as statics so the demangling vocabulary lives on one type).

    /// Operator-code -> source symbol (inverse of OperatorKind::code()).
    ///
    /// `match` on a string subject lowers to a `strcmp` content comparison,
    /// which is what's wanted here: `code` is substr-derived, so a
    /// pointer-compare string `==` would be wrong.
    static op_code_to_symbol(code: string) -> string {
        return match (code) {
            "add"  => { "+"  }
            "sub"  => { "-"  }
            "mul"  => { "*"  }
            "div"  => { "/"  }
            "mod"  => { "%"  }
            "band" => { "&"  }
            "bor"  => { "|"  }
            "xor"  => { "^"  }
            "shl"  => { "<<" }
            "shr"  => { ">>" }
            "eq"   => { "==" }
            "ne"   => { "!=" }
            "lt"   => { "<"  }
            "le"   => { "<=" }
            "gt"   => { ">"  }
            "ge"   => { ">=" }
            "land" => { "&&" }
            "lor"  => { "||" }
            "lnot" => { "!"  }
            "idx"  => { "[]" }
            "call" => { "()" }
            "neg"  => { "-"  }
            _      => { code }
        };
    }

    /// Primitive type code -> spelling (mirror of encode_int_kind /
    /// encode_float_kind and the primitive table in mangled_name.cryo).
    static prim_code_to_name(c: char) -> string {
        return match (c) {
            'a' => { "i8"      }
            's' => { "i16"     }
            'i' => { "int"     }
            'l' => { "i64"     }
            'n' => { "i128"    }
            'h' => { "u8"      }
            't' => { "u16"     }
            'j' => { "u32"     }
            'm' => { "u64"     }
            'o' => { "u128"    }
            'x' => { "isize"   }
            'y' => { "usize"   }
            'f' => { "f32"     }
            'd' => { "f64"     }
            'b' => { "boolean" }
            'c' => { "char"    }
            'S' => { "string"  }
            'v' => { "void"    }
            'u' => { "()"      }
            _   => { ""        }
        };
    }

    static is_prim_code(c: char) -> boolean {
        return match (c) {
            'a' | 's' | 'i' | 'l' | 'n' | 'h' | 't' | 'j' | 'm' | 'o'
            | 'x' | 'y' | 'f' | 'd' | 'b' | 'c' | 'S' | 'v' | 'u' => { true }
            _ => { false }
        };
    }

    /// Two-char kind-tag recognizer (vt/ti/ct/dt/op/mi/cl/tr).
    static is_kind_tag(a: char, b: char) -> boolean {
        if (a == 'v' && b == 't') { return true; }
        if (a == 't' && b == 'i') { return true; }
        if (a == 'c' && b == 't') { return true; }
        if (a == 'd' && b == 't') { return true; }
        if (a == 'o' && b == 'p') { return true; }
        if (a == 'm' && b == 'i') { return true; }
        if (a == 'c' && b == 'l') { return true; }
        if (a == 't' && b == 'r') { return true; }
        return false;
    }

    /// Glue the rendered head together with the parameter list, return type,
    /// and any trailing overload / LLVM-suffix annotations.
    static finalize(head: string, params: string, ret: string,
                    overload: i64, llvm_suffix: i64) -> string {
        mut out: string = head;
        out += "(" + params + ")";
        if (libc::strlen(ret) > 0) {
            out += " -> " + ret;
        }
        if (overload >= 0) {
            out += " [overload ";
            out += overload.to_decimal_str();
            out += "]";
        }
        if (llvm_suffix >= 0) {
            out += " [.";
            out += llvm_suffix.to_decimal_str();
            out += "]";
        }
        return out;
    }
}


// Parsed-path bundle: carries segment list + optional `-member`.

type struct ParsedPath {
    /// Pretty-rendered segments (each may already include `<...>` from generics).
    segments: string[];
    /// Pretty-rendered member, or "" if the path has no `-<member>` tail.
    member:   string;
    has_member: boolean;

    /// Path used inline as a type: segments joined by `::`, member (if any)
    /// appended via `::` (we have no receiver context here).
    render_inline(&this) -> string {
        mut buf: string = "";
        for (mut i: i64 = 0; i < this.segments.length; i++) {
            if (i > 0) { buf += "::"; }
            buf += this.segments[i];
        }
        if (this.has_member) {
            buf += "::";
            buf += this.member;
        }
        return buf;
    }

    /// Path as the head of a function-like signature.  `is_method` flips the
    /// member separator: `.` for instance methods, `::` for static methods and
    /// free functions.
    render_head(&this, is_method: boolean) -> string {
        mut buf: string = "";
        for (mut i: i64 = 0; i < this.segments.length; i++) {
            if (i > 0) { buf += "::"; }
            buf += this.segments[i];
        }
        if (this.has_member) {
            buf += (if (is_method) { "." } else { "::" });
            buf += this.member;
        }
        return buf;
    }

    /// Render the path's namespace + type chain WITHOUT the `-<member>` tail.
    render_no_member(&this) -> string {
        mut buf: string = "";
        for (mut i: i64 = 0; i < this.segments.length; i++) {
            if (i > 0) { buf += "::"; }
            buf += this.segments[i];
        }
        return buf;
    }
}


// Top-level demangler.

/// Symbol demangler: turns `C$`-mangled linker names back into readable
/// Cryo signatures (used by `cryo demangle` / diagnostics).  Single
/// `static` entry point over the module-level `Cursor`/`ParsedPath`.
type struct Demangler {

    /// Returns the pretty form of `input`.  For non-`C$`-prefixed inputs,
    /// returns `"<input> (unmangled)"`.  For malformed inputs, returns
    /// `"<input> (malformed)"`.
    static demangle(input: string) -> string {
        const len: i64 = libc::strlen(input) as i64;
        if (len < 2 || input[0] != 'C' || input[1] != '$') {
            return input + " (unmangled)";
        }

        mut cur: Cursor = Cursor::new(input);
        cur.advance(2);

        // Optional kind tag.  The mangler emits `C$<code>$<path>` (one `$`
        // shared between the `C$` prefix and the kind-tag opener), so after
        // consuming `C$` we look directly at the two code chars and check for
        // a closing `$` after them.  Kept as a (char, char) pair rather than
        // a substring + dynamic `==` comparison to avoid heap allocation on a
        // hot path; demangling runs once per symbol lookup.
        mut kind_a: char = 0 as char;
        mut kind_b: char = 0 as char;
        {
            const a: char = cur.peek_at(0);
            const b: char = cur.peek_at(1);
            const close: char = cur.peek_at(2);
            if (close == '$' && Cursor::is_kind_tag(a, b)) {
                kind_a = a;
                kind_b = b;
                cur.advance(2);            // consume code
                cur.expect_char('$');      // consume trailing `$`
            }
        }

        // Trait impls have a different head: `<trait-segment>$f<owner-path>`.
        mut trait_seg: string = "";
        mut path: ParsedPath = ParsedPath { segments: [], member: "", has_member: false };

        if (kind_a == 't' && kind_b == 'r') {
            trait_seg = cur.parse_segment();
            if (cur.ok) { cur.expect2('$', 'f'); }
            if (cur.ok) { path = cur.parse_path(); }
        } else {
            path = cur.parse_path();
        }

        if (!cur.ok) { return input + " (malformed)"; }

        // Optional signature: `$F <params> $R <ret>`.
        mut has_sig: boolean = false;
        mut params_str: string = "";
        mut return_str: string = "";
        mut leads_with_receiver: boolean = false;

        if (cur.starts_with2('$', 'F')) {
            cur.advance(2);
            has_sig = true;
            // Detect receiver before dispatching so the path-head separator can
            // adapt: methods use `.`, statics use `::`.
            if (cur.starts_with2('$', 's') || cur.starts_with2('$', 'm')) {
                leads_with_receiver = true;
            }
            params_str = cur.parse_param_list();
            if (!cur.ok) { return input + " (malformed)"; }
            cur.expect2('$', 'R');
            if (!cur.ok) { return input + " (malformed)"; }
            return_str = cur.parse_type();
            if (!cur.ok) { return input + " (malformed)"; }
        }

        // Optional overload index: `$O<digits>`.
        mut overload: i64 = -1;
        if (cur.starts_with2('$', 'O')) {
            cur.advance(2);
            overload = cur.read_decimal();
            if (!cur.ok) { return input + " (malformed)"; }
        }

        // Optional LLVM uniquification suffix: `.<digits>` (spec section 14).
        mut llvm_suffix: i64 = -1;
        if (cur.peek() == '.') {
            // Only consume if the rest is purely digits.
            mut k: i64 = cur.pos + 1;
            mut all_digits: boolean = (k < cur.len);
            while (k < cur.len) {
                const c2: char = cur.text[k];
                if (!(c2 >= '0' && c2 <= '9')) { all_digits = false; break; }
                k += 1;
            }
            if (all_digits) {
                cur.advance(1);
                llvm_suffix = cur.read_decimal();
            }
        }

        if (!cur.eof()) { return input + " (malformed)"; }

        // Render the demangled symbol.  Branching on kind keeps the formatting
        // concerns (data symbols vs. function-like) cleanly separate.

        const path_inline: string = path.render_inline();

        if (kind_a == 'v' && kind_b == 't') { return "<vtable for " + path_inline + ">"; }
        if (kind_a == 't' && kind_b == 'i') { return "<typeinfo for " + path_inline + ">"; }
        if (kind_a == 'm' && kind_b == 'i') { return "<module init for " + path_inline + ">"; }

        if (kind_a == 'c' && kind_b == 'l') {
            mut out: string = "<closure";
            if (overload >= 0) {
                out += " #";
                out += overload.to_decimal_str();
            }
            out += " inside " + path_inline + ">";
            if (llvm_suffix >= 0) {
                out += " [.";
                out += llvm_suffix.to_decimal_str();
                out += "]";
            }
            return out;
        }

        // Function-like symbols from here on need a signature.
        if (!has_sig) {
            // Bare data symbol: just `C$<path>` with no kind tag.
            mut bare: string = path_inline;
            if (overload >= 0) {
                bare += " [overload ";
                bare += overload.to_decimal_str();
                bare += "]";
            }
            if (llvm_suffix >= 0) {
                bare += " [.";
                bare += llvm_suffix.to_decimal_str();
                bare += "]";
            }
            return bare;
        }

        // For ct/dt/op the member segment carries either the type leaf (ct/dt)
        // or the operator code (op).  Render those in source-style form.
        if (kind_a == 'c' && kind_b == 't') {
            // `Owner::Owner(args) -> Owner`; drop the `-Owner` tail and add it
            // back as the constructor name with `::`.
            mut head: string = path.render_no_member();
            if (path.has_member) {
                head += "::";
                head += path.member;
            }
            return Cursor::finalize(head, params_str, return_str, overload, llvm_suffix);
        }
        if (kind_a == 'd' && kind_b == 't') {
            mut head: string = "~" + path.render_no_member();
            if (path.has_member) {
                head += "::";
                head += path.member;
            }
            return Cursor::finalize(head, params_str, return_str, overload, llvm_suffix);
        }
        if (kind_a == 'o' && kind_b == 'p') {
            mut head: string = path.render_no_member();
            head += "::operator";
            if (path.has_member) {
                head += Cursor::op_code_to_symbol(path.member);
            }
            return Cursor::finalize(head, params_str, return_str, overload, llvm_suffix);
        }
        if (kind_a == 't' && kind_b == 'r') {
            const owner: string = path.render_no_member();
            mut head: string = "<" + trait_seg + " for " + owner + ">";
            if (path.has_member) {
                head += (if (leads_with_receiver) { "." } else { "::" }) + path.member;
            }
            return Cursor::finalize(head, params_str, return_str, overload, llvm_suffix);
        }

        // Plain function or method (no kind tag).
        const head2: string = path.render_head(leads_with_receiver);
        return Cursor::finalize(head2, params_str, return_str, overload, llvm_suffix);
    }
}
