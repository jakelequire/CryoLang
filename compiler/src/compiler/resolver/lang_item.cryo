/// Language items: the declarations the compiler itself reasons about by
/// identity, and the modules it imports on a program's behalf.
///
/// In the name layer because a reference the compiler writes before any
/// declaration exists - a desugared `for`, `a..b`, `x ?? d`, an f-string -
/// names a language item rather than a spelling, and the slot that holds it
/// (`ResSlot::Lang`) is the name layer's.

namespace compiler::resolver::lang_item;

import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::symbol_str::{ SymbolStr };

/// A declaration the language itself reasons about by identity: the
/// structural markers, `Clone`, which a refused move offers to copy through,
/// `Drop`, `Future`, the traits an operator desugars to (`[]` among them,
/// through `Index` for an element and `IndexView` for a view),
/// the two a container's reference converts to a slice reference through,
/// `Allocate`, which `new` and `delete` get and return storage through, the
/// two traits `?` desugars through - `Try`, which splits a value into the
/// `ControlFlow` it continues or stops with, and `FromResidual`, which builds
/// the enclosing function's return value from what it stops with - with that
/// enum, the two enums `?` applies to and `From`, which an error is converted
/// through, and the one the async lowering
/// completes its state machines with; the structs a lowering builds or a
/// rule singles out (`Array` behind `[T]`, `Slice` and `Range` behind `for`
/// and `a..b`, `RangeFrom`, `RangeTo` and `RangeFull` behind `a..`, `..b`
/// and `..`, the types never `Send`, the executor and waker context an
/// `async` program is driven by); the traits a `with [...]` clause
/// generates implementations of (`Eq`, `Ord`, `Hash`, `Clone`, `Debug`,
/// `Default`) and the types their methods' signatures and bodies name
/// (`Ordering`, `Hasher`, `Formatter`, `FmtError`); and the functions generated code calls
/// (the allocator, the entry point's `set_args`/`set_env`, the test runner,
/// the builders an f-string lowers to, and the ones it lowers to instead
/// where it is an `fmt::Arguments` argument, with that struct);
/// the `Location` codegen builds for `location()` and for the caller of a
/// `![caller_location]` function;
/// and the methods generated code calls - the async lowering's `take`,
/// `unwrap`, `unwrap_ptr`, `is_pending`, `into_ready` and `Future::poll`,
/// `Drop::drop`, the destructor a released value's type implements,
/// `as_slice` and `as_mutable_slice`, which that conversion calls,
/// `From::from`, the conversion an error goes through, and `Try::branch` and
/// `FromResidual::from_residual`, which `?` calls.
///
/// A declaration is an item by saying so, `![language("name")]` with the
/// item's `name()`, and nothing else makes it one: a user trait spelled
/// `Add` does not overload `+`, and an enum spelling `Ok`/`Err` is not the
/// one `?` desugars through.  A consumer names the item, never a spelling:
/// a misspelt item does not compile, where a misspelt leaf silently
/// answered "absent".
type enum LangItem {
    Copy;
    Clone;
    Send;
    Sync;
    Drop;
    Future;
    Eq;
    Ord;
    Add;
    Sub;
    Mul;
    Div;
    Rem;
    Neg;
    Not;
    BitNot;
    BitAnd;
    BitOr;
    BitXor;
    Shl;
    Shr;
    Deref;
    DerefMutable;
    Index;
    IndexMutable;
    AsSlice;
    AsMutableSlice;
    From;
    Try;
    FromResidual;
    Allocate;
    Result;
    Option;
    ControlFlow;
    Poll;
    Iterator;
    Array;
    Slice;
    Range;
    RangeInclusive;
    Rc;
    MutexGuard;
    RwLockReadGuard;
    RwLockWriteGuard;
    /// The handle a scope of threads hands its body: never shared between
    /// threads, and never outliving the scope.
    ThreadScope;
    Context;
    Executor;
    Location;
    Malloc;
    Free;
    Alloc;
    Dealloc;
    SetArgs;
    SetEnv;
    RunAll;
    OptionTake;
    OptionReplace;
    OptionUnwrap;
    OptionUnwrapPtr;
    PollIsPending;
    PollIntoReady;
    FuturePoll;
    DropDrop;
    IndexIndex;
    IndexMutableIndexMutable;
    DerefDeref;
    DerefMutableDerefMutable;
    AsSliceAsSlice;
    AsMutableSliceAsMutableSlice;
    FromFrom;
    TryBranch;
    FromResidualFromResidual;
    AllocateAllocate;
    AllocateRelease;
    Printf;
    Eprintf;
    LibcPrintf;
    FormatNew;
    FormatAppendLiteral;
    FormatAppendDisplay;
    FormatAppendDebug;
    FormatAppendSpec;
    FormatArguments;
    FormatArgumentsNew;
    FormatPiecesNew;
    FormatPiecesLiteral;
    FormatPiecesDisplay;
    FormatPiecesDebug;
    FormatPiecesSpec;
    FormatAppendDebugPretty;
    FormatPiecesDebugPretty;
    Hash;
    Hasher;
    Debug;
    Formatter;
    FormatError;
    Default;
    Ordering;
    IndexView;
    IndexViewMutable;
    IndexViewView;
    IndexViewMutableViewMutable;
    RangeFrom;
    RangeTo;
    RangeFull;
}

implement enum LangItem {
    /// The name a declaration gives in `![language("name")]` to be this
    /// item.  Also what a diagnostic prints for an item no declaration in
    /// the program claimed.
    name(&this) -> string {
        return match (&this) {
            LangItem::Copy   => { "copy" }
            LangItem::Clone  => { "clone" }
            LangItem::Send   => { "send" }
            LangItem::Sync   => { "sync" }
            LangItem::Drop   => { "drop" }
            LangItem::Future => { "future" }
            LangItem::Eq     => { "eq" }
            LangItem::Ord    => { "ord" }
            LangItem::Add    => { "add" }
            LangItem::Sub    => { "sub" }
            LangItem::Mul    => { "mul" }
            LangItem::Div    => { "div" }
            LangItem::Rem    => { "rem" }
            LangItem::Neg    => { "neg" }
            LangItem::Not    => { "not" }
            LangItem::BitNot => { "bit_not" }
            LangItem::BitAnd => { "bit_and" }
            LangItem::BitOr  => { "bit_or" }
            LangItem::BitXor => { "bit_xor" }
            LangItem::Shl    => { "shl" }
            LangItem::Shr    => { "shr" }
            LangItem::Deref  => { "deref" }
            LangItem::DerefMutable => { "deref_mutable" }
            LangItem::Index  => { "index" }
            LangItem::IndexMutable => { "index_mutable" }
            LangItem::AsSlice => { "as_slice" }
            LangItem::AsMutableSlice => { "as_mutable_slice" }
            LangItem::From   => { "from" }
            LangItem::Try    => { "try" }
            LangItem::FromResidual => { "from_residual" }
            LangItem::Allocate => { "allocate" }
            LangItem::Result => { "result" }
            LangItem::Option => { "option" }
            LangItem::ControlFlow => { "control_flow" }
            LangItem::Poll   => { "poll" }
            LangItem::Iterator => { "iterator" }
            LangItem::Array    => { "array" }
            LangItem::Slice    => { "slice" }
            LangItem::Range    => { "range" }
            LangItem::RangeInclusive   => { "range_inclusive" }
            LangItem::Rc               => { "rc" }
            LangItem::MutexGuard       => { "mutex_guard" }
            LangItem::RwLockReadGuard  => { "rwlock_read_guard" }
            LangItem::RwLockWriteGuard => { "rwlock_write_guard" }
            LangItem::ThreadScope      => { "thread_scope" }
            LangItem::Context  => { "context" }
            LangItem::Executor => { "executor" }
            LangItem::Location => { "location" }
            LangItem::Malloc   => { "malloc" }
            LangItem::Free     => { "free" }
            LangItem::Alloc    => { "alloc" }
            LangItem::Dealloc  => { "dealloc" }
            LangItem::SetArgs  => { "set_args" }
            LangItem::SetEnv   => { "set_env" }
            LangItem::RunAll   => { "run_all_tests" }
            LangItem::OptionTake      => { "option_take" }
            LangItem::OptionReplace   => { "option_replace" }
            LangItem::OptionUnwrap    => { "option_unwrap" }
            LangItem::OptionUnwrapPtr => { "option_unwrap_pointer" }
            LangItem::PollIsPending   => { "poll_is_pending" }
            LangItem::PollIntoReady   => { "poll_into_ready" }
            LangItem::FuturePoll      => { "future_poll" }
            LangItem::DropDrop        => { "drop_drop" }
            LangItem::IndexIndex      => { "index_index" }
            LangItem::IndexMutableIndexMutable => { "index_mutable_index_mutable" }
            LangItem::DerefDeref      => { "deref_deref" }
            LangItem::DerefMutableDerefMutable => { "deref_mutable_deref_mutable" }
            LangItem::AsSliceAsSlice  => { "as_slice_as_slice" }
            LangItem::AsMutableSliceAsMutableSlice => { "as_mutable_slice_as_mutable_slice" }
            LangItem::FromFrom        => { "from_from" }
            LangItem::TryBranch       => { "try_branch" }
            LangItem::FromResidualFromResidual => { "from_residual_from_residual" }
            LangItem::AllocateAllocate => { "allocate_allocate" }
            LangItem::AllocateRelease  => { "allocate_release" }
            LangItem::Printf          => { "printf" }
            LangItem::Eprintf         => { "eprintf" }
            LangItem::LibcPrintf      => { "c_printf" }
            LangItem::FormatNew           => { "format_new" }
            LangItem::FormatAppendLiteral => { "format_append_literal" }
            LangItem::FormatAppendDisplay => { "format_append_display" }
            LangItem::FormatAppendDebug   => { "format_append_debug" }
            LangItem::FormatAppendSpec    => { "format_append_spec" }
            LangItem::FormatArguments     => { "format_arguments" }
            LangItem::FormatArgumentsNew  => { "format_arguments_new" }
            LangItem::FormatPiecesNew     => { "format_pieces_new" }
            LangItem::FormatPiecesLiteral => { "format_pieces_literal" }
            LangItem::FormatPiecesDisplay => { "format_pieces_display" }
            LangItem::FormatPiecesDebug   => { "format_pieces_debug" }
            LangItem::FormatPiecesSpec    => { "format_pieces_spec" }
            LangItem::FormatAppendDebugPretty => { "format_append_debug_pretty" }
            LangItem::FormatPiecesDebugPretty => { "format_pieces_debug_pretty" }
            LangItem::Hash        => { "hash" }
            LangItem::Hasher      => { "hasher" }
            LangItem::Debug       => { "debug" }
            LangItem::Formatter   => { "formatter" }
            LangItem::FormatError => { "format_error" }
            LangItem::Default     => { "default" }
            LangItem::Ordering    => { "ordering" }
            LangItem::IndexView        => { "index_view" }
            LangItem::IndexViewMutable => { "index_view_mutable" }
            LangItem::IndexViewView    => { "index_view_view" }
            LangItem::IndexViewMutableViewMutable => { "index_view_mutable_view_mutable" }
            LangItem::RangeFrom => { "range_from" }
            LangItem::RangeTo   => { "range_to" }
            LangItem::RangeFull => { "range_full" }
        };
    }

    /// The builder an f-string's `String` builder is replaced by where the
    /// f-string is an `fmt::Arguments` argument: the one that records the
    /// same piece for the callee to write, where this one appends it.  None
    /// for an item that is no `String` builder.
    pieces_builder(&this) -> Option<LangItem> {
        return match (&this) {
            LangItem::FormatNew           => { Option::Some(LangItem::FormatPiecesNew) }
            LangItem::FormatAppendLiteral => { Option::Some(LangItem::FormatPiecesLiteral) }
            LangItem::FormatAppendDisplay => { Option::Some(LangItem::FormatPiecesDisplay) }
            LangItem::FormatAppendDebug   => { Option::Some(LangItem::FormatPiecesDebug) }
            LangItem::FormatAppendSpec    => { Option::Some(LangItem::FormatPiecesSpec) }
            LangItem::FormatAppendDebugPretty => { Option::Some(LangItem::FormatPiecesDebugPretty) }
            _                             => { Option::None }
        };
    }

    /// The trait a `with [...]` clause entry asks the compiler to implement,
    /// by the leaf of its spelling as written (`Eq`, `cmp::Eq`), or none
    /// when the compiler generates no implementation of a trait spelled so.
    /// The spelling only chooses what is generated: the clause's type check
    /// confirms it names this very trait.
    static derivable_spelled(leaf: string) -> Option<LangItem> {
        const items: [LangItem] = LangItem::derivable();
        for (mut i: i64 = 0; i < items.length(); i++) {
            if (items[i].derived_spelling() == leaf) { return Option::Some(items[i]); }
        }
        return Option::None;
    }

    /// The traits a `with [...]` clause can generate implementations of.
    static derivable() -> [LangItem] {
        return [LangItem::Eq, LangItem::Ord, LangItem::Hash, LangItem::Clone,
                LangItem::Debug, LangItem::Default];
    }

    /// How a `with [...]` clause spells this derivable trait; empty for any
    /// other item.
    derived_spelling(&this) -> string {
        return match (&this) {
            LangItem::Eq      => { "Eq" }
            LangItem::Ord     => { "Ord" }
            LangItem::Hash    => { "Hash" }
            LangItem::Clone   => { "Clone" }
            LangItem::Debug   => { "Debug" }
            LangItem::Default => { "Default" }
            _                 => { "" }
        };
    }

    /// The item `name` names in `![language(name)]`, or none when no item
    /// is called that.
    static named(name: string) -> Option<LangItem> {
        const items: [LangItem] = LangItem::all();
        for (mut i: i64 = 0; i < items.length(); i++) {
            if (items[i].name() == name) { return Option::Some(items[i]); }
        }
        return Option::None;
    }

    /// Every item.
    static all() -> [LangItem] {
        return [
            LangItem::Copy, LangItem::Clone, LangItem::Send, LangItem::Sync, LangItem::Drop,
            LangItem::Future, LangItem::Eq, LangItem::Ord, LangItem::Add,
            LangItem::Sub, LangItem::Mul, LangItem::Div, LangItem::Rem,
            LangItem::Neg, LangItem::Not, LangItem::BitNot, LangItem::BitAnd,
            LangItem::BitOr, LangItem::BitXor, LangItem::Shl, LangItem::Shr,
            LangItem::Deref, LangItem::DerefMutable, LangItem::Index, LangItem::IndexMutable,
            LangItem::AsSlice, LangItem::AsMutableSlice,
            LangItem::From, LangItem::Try,
            LangItem::FromResidual, LangItem::Allocate, LangItem::Result,
            LangItem::Option, LangItem::ControlFlow, LangItem::Poll, LangItem::Iterator,
            LangItem::Array,
            LangItem::Slice, LangItem::Range,
            LangItem::RangeInclusive, LangItem::Rc, LangItem::MutexGuard,
            LangItem::RwLockReadGuard, LangItem::RwLockWriteGuard, LangItem::ThreadScope,
            LangItem::Context, LangItem::Executor, LangItem::Location, LangItem::Malloc,
            LangItem::Free, LangItem::Alloc, LangItem::Dealloc,
            LangItem::SetArgs, LangItem::SetEnv, LangItem::RunAll,
            LangItem::OptionTake, LangItem::OptionReplace, LangItem::OptionUnwrap, LangItem::OptionUnwrapPtr,
            LangItem::PollIsPending, LangItem::PollIntoReady, LangItem::FuturePoll,
            LangItem::DropDrop, LangItem::IndexIndex, LangItem::IndexMutableIndexMutable,
            LangItem::DerefDeref, LangItem::DerefMutableDerefMutable,
            LangItem::AsSliceAsSlice, LangItem::AsMutableSliceAsMutableSlice, LangItem::FromFrom,
            LangItem::TryBranch, LangItem::FromResidualFromResidual,
            LangItem::AllocateAllocate, LangItem::AllocateRelease,
            LangItem::Printf, LangItem::Eprintf, LangItem::LibcPrintf,
            LangItem::FormatNew, LangItem::FormatAppendLiteral,
            LangItem::FormatAppendDisplay, LangItem::FormatAppendDebug,
            LangItem::FormatAppendSpec, LangItem::FormatArguments,
            LangItem::FormatArgumentsNew, LangItem::FormatPiecesNew,
            LangItem::FormatPiecesLiteral, LangItem::FormatPiecesDisplay,
            LangItem::FormatPiecesDebug, LangItem::FormatPiecesSpec,
            LangItem::FormatAppendDebugPretty, LangItem::FormatPiecesDebugPretty,
            LangItem::Hash, LangItem::Hasher, LangItem::Debug, LangItem::Formatter,
            LangItem::FormatError, LangItem::Default, LangItem::Ordering,
            LangItem::IndexView, LangItem::IndexViewMutable,
            LangItem::IndexViewView, LangItem::IndexViewMutableViewMutable,
            LangItem::RangeFrom, LangItem::RangeTo, LangItem::RangeFull,
        ];
    }
}

/// A module the compiler itself imports or looks for: the prelude every
/// module is given, and the formatting runtime an f-string desugars into.
///
/// Not a `LangItem`, and never claimed: a module's path IS its identity - the
/// module graph registers every module under exactly one path - and the
/// compiler needs these before any declaration exists, to write the import
/// that loads them.  So the path is named here, the one place it is spelled,
/// and asked of the graph (`ModulePath`) or written into an import.
type enum LangModule {
    Prelude;
    Interp;
}

implement enum LangModule {
    path(&this) -> string {
        return match (&this) {
            LangModule::Prelude => { "std::prelude" }
            LangModule::Interp  => { "std::fmt::interp" }
        };
    }

    /// These modules are a table the compiler fixes, and
    /// an import is matched against it before any module is bound: whether
    /// `written`, a module path as an import writes it, names this module.
    is_written(&this, written: SymbolStr, intern: InternTable*) -> boolean {
        return intern.resolve(written).eq(this.path());
    }
}
