/// Language items: the declarations the compiler itself reasons about by
/// identity, and the modules it imports on a program's behalf.
///
/// In the name layer because a reference the compiler writes before any
/// declaration exists - a desugared `for`, `a..b`, `x ?? d` - names a
/// language item rather than a spelling, and the slot that holds it
/// (`ResSlot::Lang`) is the name layer's.

namespace compiler::resolver::lang_item;

import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::symbol_str::{ SymbolStr };

/// A declaration the language itself reasons about by identity: the
/// structural markers, `Drop`, `Future`, the traits an operator desugars to,
/// `Allocate`, which `new` and `delete` get and return storage through, the
/// two enums `?` desugars through, and the one the async lowering
/// completes its state machines with; the structs a lowering builds or a
/// rule singles out (`Array` behind `[T]`, `Slice` and `Range` behind `for`
/// and `a..b`, the types never `Send`, the executor and waker context an
/// `async` program is driven by); and the functions generated code calls
/// (the allocator, the entry point's `set_args`/`set_env`, the test runner);
/// the `Location` codegen builds for `location()` and for the caller of a
/// `![caller_location]` function;
/// and the methods generated code calls - the async lowering's `take`,
/// `unwrap`, `unwrap_ptr`, `is_pending`, `into_ready` and `Future::poll`,
/// and `Drop::drop`, the destructor a released value's type implements.
/// `a + b` is `std::core::ops::Add::add`, the language's own
/// `Add` - a user trait spelled `Add` does not overload the
/// operator; `x?` is on `std::core::result::Result` or
/// `std::core::option::Option`, and an enum spelling `Ok`/`Err` is another
/// enum.
///
/// A consumer names the item, never a spelling: a misspelt item does not
/// compile, where a misspelt leaf silently answered "absent".
type enum LangItem {
    Copy;
    Send;
    Sync;
    Drop;
    Future;
    Eq;
    Ord;
    Add;
    Sub;
    Mul;
    Div;
    Rem;
    Neg;
    Not;
    BitNot;
    BitAnd;
    BitOr;
    BitXor;
    Shl;
    Shr;
    Deref;
    Index;
    Allocate;
    Result;
    Option;
    Poll;
    Iterator;
    Array;
    Slice;
    Range;
    RangeInclusive;
    Rc;
    MutexGuard;
    RwLockReadGuard;
    RwLockWriteGuard;
    Context;
    Executor;
    Location;
    Malloc;
    Free;
    Alloc;
    Dealloc;
    SetArgs;
    SetEnv;
    RunAll;
    OptionTake;
    OptionUnwrap;
    OptionUnwrapPtr;
    PollIsPending;
    PollIntoReady;
    FuturePoll;
    DropDrop;
    IndexIndex;
    DerefDeref;
    AllocateAllocate;
    AllocateRelease;
    Printf;
    Eprintf;
    LibcPrintf;
    FormatNew;
    FormatAppendLiteral;
    FormatAppendDisplay;
    FormatAppendDebug;
    FormatAppendSpec;
    OrdCompare;
    ExecutorNew;
    ExecutorBlockOn;
}

implement enum LangItem {
    /// The canonical path the item's declaration is registered under.  The
    /// one place the compiler knows how these declarations are spelled.
    path(&this) -> string {
        return match (&this) {
            LangItem::Copy   => { "std::core::marker::Copy" }
            LangItem::Send   => { "std::core::marker::Send" }
            LangItem::Sync   => { "std::core::marker::Sync" }
            LangItem::Drop   => { "std::core::drop::Drop" }
            LangItem::Future => { "std::future::traits::Future" }
            LangItem::Eq     => { "std::core::cmp::Eq" }
            LangItem::Ord    => { "std::core::cmp::Ord" }
            LangItem::Add    => { "std::core::ops::Add" }
            LangItem::Sub    => { "std::core::ops::Sub" }
            LangItem::Mul    => { "std::core::ops::Mul" }
            LangItem::Div    => { "std::core::ops::Div" }
            LangItem::Rem    => { "std::core::ops::Rem" }
            LangItem::Neg    => { "std::core::ops::Neg" }
            LangItem::Not    => { "std::core::ops::Not" }
            LangItem::BitNot => { "std::core::ops::BitNot" }
            LangItem::BitAnd => { "std::core::ops::BitAnd" }
            LangItem::BitOr  => { "std::core::ops::BitOr" }
            LangItem::BitXor => { "std::core::ops::BitXor" }
            LangItem::Shl    => { "std::core::ops::Shl" }
            LangItem::Shr    => { "std::core::ops::Shr" }
            LangItem::Deref  => { "std::core::ops::Deref" }
            LangItem::Index  => { "std::core::ops::Index" }
            LangItem::Allocate => { "std::core::ops::Allocate" }
            LangItem::Result => { "std::core::result::Result" }
            LangItem::Option => { "std::core::option::Option" }
            LangItem::Poll   => { "std::future::poll::Poll" }
            LangItem::Iterator => { "std::core::iter::Iterator" }
            LangItem::Array    => { "std::collections::array::Array" }
            LangItem::Slice    => { "std::core::slice::Slice" }
            LangItem::Range    => { "std::core::ops::Range" }
            LangItem::RangeInclusive   => { "std::core::ops::RangeInclusive" }
            LangItem::Rc               => { "std::alloc::rc::Rc" }
            LangItem::MutexGuard       => { "std::sync::mutex::MutexGuard" }
            LangItem::RwLockReadGuard  => { "std::sync::rwlock::RwLockReadGuard" }
            LangItem::RwLockWriteGuard => { "std::sync::rwlock::RwLockWriteGuard" }
            LangItem::Context  => { "std::future::waker::Context" }
            LangItem::Executor => { "std::future::executor::Executor" }
            LangItem::Location => { "std::core::intrinsics::Location" }
            LangItem::Malloc   => { "std::core::intrinsics::malloc" }
            LangItem::Free     => { "std::core::intrinsics::free" }
            LangItem::Alloc    => { "std::alloc::allocator::alloc" }
            LangItem::Dealloc  => { "std::alloc::allocator::free" }
            LangItem::SetArgs  => { "std::env::set_args" }
            LangItem::SetEnv   => { "std::env::set_env" }
            LangItem::RunAll   => { "std::test::runner::run_all" }
            LangItem::OptionTake      => { "std::core::option::Option::take" }
            LangItem::OptionUnwrap    => { "std::core::option::Option::unwrap" }
            LangItem::OptionUnwrapPtr => { "std::core::option::Option::unwrap_ptr" }
            LangItem::PollIsPending   => { "std::future::poll::Poll::is_pending" }
            LangItem::PollIntoReady   => { "std::future::poll::Poll::into_ready" }
            LangItem::FuturePoll      => { "std::future::traits::Future::poll" }
            LangItem::DropDrop        => { "std::core::drop::Drop::drop" }
            LangItem::IndexIndex      => { "std::core::ops::Index::index" }
            LangItem::DerefDeref      => { "std::core::ops::Deref::deref" }
            LangItem::AllocateAllocate => { "std::core::ops::Allocate::allocate" }
            LangItem::AllocateRelease  => { "std::core::ops::Allocate::release" }
            LangItem::Printf         => { "std::fmt::printf" }
            LangItem::Eprintf         => { "std::fmt::eprintf" }
            LangItem::LibcPrintf      => { "std::ffi::libc::printf" }
            LangItem::FormatNew           => { "std::fmt::interp::fmt_new" }
            LangItem::FormatAppendLiteral => { "std::fmt::interp::fmt_append_lit" }
            LangItem::FormatAppendDisplay => { "std::fmt::interp::fmt_append_display" }
            LangItem::FormatAppendDebug   => { "std::fmt::interp::fmt_append_debug" }
            LangItem::FormatAppendSpec    => { "std::fmt::interp::fmt_append_fmt" }
            LangItem::OrdCompare      => { "std::core::cmp::Ord::compare" }
            LangItem::ExecutorNew     => { "std::future::executor::Executor::new" }
            LangItem::ExecutorBlockOn => { "std::future::executor::Executor::block_on" }
        };
    }

    /// The name a declaration gives in `![language("name")]` to be this
    /// item.
    name(&this) -> string {
        return match (&this) {
            LangItem::Copy   => { "copy" }
            LangItem::Send   => { "send" }
            LangItem::Sync   => { "sync" }
            LangItem::Drop   => { "drop" }
            LangItem::Future => { "future" }
            LangItem::Eq     => { "eq" }
            LangItem::Ord    => { "ord" }
            LangItem::Add    => { "add" }
            LangItem::Sub    => { "sub" }
            LangItem::Mul    => { "mul" }
            LangItem::Div    => { "div" }
            LangItem::Rem    => { "rem" }
            LangItem::Neg    => { "neg" }
            LangItem::Not    => { "not" }
            LangItem::BitNot => { "bit_not" }
            LangItem::BitAnd => { "bit_and" }
            LangItem::BitOr  => { "bit_or" }
            LangItem::BitXor => { "bit_xor" }
            LangItem::Shl    => { "shl" }
            LangItem::Shr    => { "shr" }
            LangItem::Deref  => { "deref" }
            LangItem::Index  => { "index" }
            LangItem::Allocate => { "allocate" }
            LangItem::Result => { "result" }
            LangItem::Option => { "option" }
            LangItem::Poll   => { "poll" }
            LangItem::Iterator => { "iterator" }
            LangItem::Array    => { "array" }
            LangItem::Slice    => { "slice" }
            LangItem::Range    => { "range" }
            LangItem::RangeInclusive   => { "range_inclusive" }
            LangItem::Rc               => { "rc" }
            LangItem::MutexGuard       => { "mutex_guard" }
            LangItem::RwLockReadGuard  => { "rwlock_read_guard" }
            LangItem::RwLockWriteGuard => { "rwlock_write_guard" }
            LangItem::Context  => { "context" }
            LangItem::Executor => { "executor" }
            LangItem::Location => { "location" }
            LangItem::Malloc   => { "malloc" }
            LangItem::Free     => { "free" }
            LangItem::Alloc    => { "alloc" }
            LangItem::Dealloc  => { "dealloc" }
            LangItem::SetArgs  => { "set_args" }
            LangItem::SetEnv   => { "set_env" }
            LangItem::RunAll   => { "run_all_tests" }
            LangItem::OptionTake      => { "option_take" }
            LangItem::OptionUnwrap    => { "option_unwrap" }
            LangItem::OptionUnwrapPtr => { "option_unwrap_pointer" }
            LangItem::PollIsPending   => { "poll_is_pending" }
            LangItem::PollIntoReady   => { "poll_into_ready" }
            LangItem::FuturePoll      => { "future_poll" }
            LangItem::DropDrop        => { "drop_drop" }
            LangItem::IndexIndex      => { "index_index" }
            LangItem::DerefDeref      => { "deref_deref" }
            LangItem::AllocateAllocate => { "allocate_allocate" }
            LangItem::AllocateRelease  => { "allocate_release" }
            LangItem::Printf          => { "printf" }
            LangItem::Eprintf         => { "eprintf" }
            LangItem::LibcPrintf      => { "c_printf" }
            LangItem::FormatNew           => { "format_new" }
            LangItem::FormatAppendLiteral => { "format_append_literal" }
            LangItem::FormatAppendDisplay => { "format_append_display" }
            LangItem::FormatAppendDebug   => { "format_append_debug" }
            LangItem::FormatAppendSpec    => { "format_append_spec" }
            LangItem::OrdCompare      => { "ord_compare" }
            LangItem::ExecutorNew     => { "executor_new" }
            LangItem::ExecutorBlockOn => { "executor_block_on" }
        };
    }

    /// The item `name` names in `![language(name)]`, or none when no item
    /// is called that.
    static named(name: string) -> Option<LangItem> {
        const items: [LangItem] = LangItem::all();
        for (mut i: i64 = 0; i < items.length; i++) {
            if (items[i].name() == name) { return Option::Some(items[i]); }
        }
        return Option::None;
    }

    /// The declaration's own name, the last segment of its path - for a
    /// diagnostic that names the trait to the user.
    leaf(&this) -> string {
        const s: string = this.path();
        const n: i64 = s.length() as i64;
        mut leaf_start: i64 = 0;
        for (mut i: i64 = 0; i + 1 < n; i++) {
            if (s[i] == ':' && s[i + 1] == ':') { leaf_start = i + 2; }
        }
        return s.substr(leaf_start, n - leaf_start);
    }

    /// Every item, for the registration site to match a declaration against.
    static all() -> [LangItem] {
        return [
            LangItem::Copy, LangItem::Send, LangItem::Sync, LangItem::Drop,
            LangItem::Future, LangItem::Eq, LangItem::Ord, LangItem::Add,
            LangItem::Sub, LangItem::Mul, LangItem::Div, LangItem::Rem,
            LangItem::Neg, LangItem::Not, LangItem::BitNot, LangItem::BitAnd,
            LangItem::BitOr, LangItem::BitXor, LangItem::Shl, LangItem::Shr,
            LangItem::Deref, LangItem::Index, LangItem::Allocate, LangItem::Result,
            LangItem::Option, LangItem::Poll, LangItem::Iterator,
            LangItem::Array,
            LangItem::Slice, LangItem::Range,
            LangItem::RangeInclusive, LangItem::Rc, LangItem::MutexGuard,
            LangItem::RwLockReadGuard, LangItem::RwLockWriteGuard,
            LangItem::Context, LangItem::Executor, LangItem::Location, LangItem::Malloc,
            LangItem::Free, LangItem::Alloc, LangItem::Dealloc,
            LangItem::SetArgs, LangItem::SetEnv, LangItem::RunAll,
            LangItem::OptionTake, LangItem::OptionUnwrap, LangItem::OptionUnwrapPtr,
            LangItem::PollIsPending, LangItem::PollIntoReady, LangItem::FuturePoll,
            LangItem::DropDrop, LangItem::IndexIndex, LangItem::DerefDeref,
            LangItem::AllocateAllocate, LangItem::AllocateRelease,
            LangItem::Printf, LangItem::Eprintf, LangItem::LibcPrintf,
            LangItem::FormatNew, LangItem::FormatAppendLiteral,
            LangItem::FormatAppendDisplay, LangItem::FormatAppendDebug,
            LangItem::FormatAppendSpec, LangItem::OrdCompare,
            LangItem::ExecutorNew, LangItem::ExecutorBlockOn,
        ];
    }
}

/// A module the compiler itself imports or looks for: the prelude every
/// module is given, and the formatting runtime an f-string desugars into.
///
/// Not a `LangItem`, and never claimed: a module's path IS its identity - the
/// module graph registers every module under exactly one path - and the
/// compiler needs these before any declaration exists, to write the import
/// that loads them.  So the path is named here, the one place it is spelled,
/// and asked of the graph (`ModulePath`) or written into an import.
type enum LangModule {
    Prelude;
    Interp;
}

implement enum LangModule {
    path(&this) -> string {
        return match (&this) {
            LangModule::Prelude => { "std::prelude" }
            LangModule::Interp  => { "std::fmt::interp" }
        };
    }

    /// These modules are a table the compiler fixes, and
    /// an import is matched against it before any module is bound: whether
    /// `written`, a module path as an import writes it, names this module.
    is_written(&this, written: SymbolStr, intern: InternTable*) -> boolean {
        return intern.resolve(written).eq(this.path());
    }
}
