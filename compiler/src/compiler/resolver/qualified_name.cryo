/// QualifiedName
///
/// A structured multi-part name such as `std::collections::Array`.
/// Stored as an array of interned SymbolStr parts, not a flat string.
///
/// Construction patterns:
///   QualifiedName::single(intern, "println")         => println
///   QualifiedName::from_parts(intern, parts)         => std::io::println
///   QualifiedName::parse(intern, "std::io::println") => std::io::println
///   name.child(intern, "method")                     => std::io::IO::method
///
/// Every method that needs to intern new strings takes an InternTable*
/// parameter.  Methods that only read (leaf, parent, equals, display)
/// do not.

namespace compiler::resolver::qualified_name;

import compiler::resolver::{ symbol_str, intern_table };
import std::ffi::libc;
import std::collections::str::{ Str };
import std::core::iter::{ Iterator };
import compiler::lex::lexer::{ Lexer };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::symbol_str::{ SymbolStr };

type struct QualifiedName {
    /// The interned segments, e.g. ["std", "collections", "Array"].
    /// Always has at least one part (leaf).  An empty QualifiedName uses
    /// a single SymbolStr::empty() part.
    parts: [SymbolStr];

    /// An empty / invalid qualified name.
    static empty() -> QualifiedName {
        return QualifiedName { parts: [] };
    }

    /// A single-segment name (e.g. a local variable or bare type name).
    static single(table: InternTable*, text: string) -> QualifiedName {
        mut qn: QualifiedName = QualifiedName { parts: [] };
        qn.parts.push(table.intern(text));
        return qn;
    }

    /// A single-segment name from an already-interned SymbolStr.
    static from_symbol(sym: SymbolStr) -> QualifiedName {
        mut qn: QualifiedName = QualifiedName { parts: [] };
        qn.parts.push(sym);
        return qn;
    }


    /// Parse a "::" delimited string into a QualifiedName.
    /// Use this at boundaries where raw strings enter the compiler
    /// (e.g. parsing module paths from source text).  Avoid in hot
    /// paths; prefer building incrementally with child() / push().
    static parse(table: InternTable*, text: string) -> QualifiedName {
        mut qn: QualifiedName = QualifiedName { parts: [] };

        if (text == "") {
            return qn;
        }

        const segments: [string] = text.split_nonempty("::");
        for (mut i: i64 = 0; i < segments.length(); i++) {
            qn.parts.push(table.intern(segments[i]));
        }
        return qn;
    }

    /// Number of parts (e.g. "std::io::println" has depth 3).
    depth(&this) -> i64 {
        return this.parts.length();
    }

    /// Whether this name has no parts.
    is_empty(&this) -> boolean {
        return this.parts.length() == 0;
    }

    /// The final segment (the "symbol name" itself).
    /// e.g. "std::io::println" => "println"
    /// Returns SymbolStr::empty() if the name is empty.
    leaf(&this) -> SymbolStr {
        if (this.parts.length() == 0) {
            return SymbolStr::empty();
        }
        return this.parts[this.parts.length() - 1];
    }

    /// Get a specific segment by index.
    /// Returns SymbolStr::empty() for out-of-range indices.
    part_at(&this, index: i64) -> SymbolStr {
        if (index < 0 || index >= this.parts.length()) {
            return SymbolStr::empty();
        }
        return this.parts[index];
    }



    /// Append a segment in place (mutating).
    push(mut &this, table: InternTable*, text: string) -> void {
        this.parts.push(table.intern(text));
    }


    /// Produce the "::" separated display string.
    /// e.g. ["std", "io", "println"] => "std::io::println"
    /// This allocates a new string; use only for diagnostics, error
    /// messages, and LLVM name emission, not for equality checks.
    display(&this, table: InternTable*) -> string {
        if (this.parts.length() == 0) {
            return "";
        }

        mut result: string = table.resolve(this.parts[0]);
        for (mut i: i64 = 1; i < this.parts.length(); i++) {
            result = result.append("::");
            result = result.append(table.resolve(this.parts[i]));
        }
        return result;
    }


    /// Extract the FIRST segment, before the first "::".  E.g. `I::Item` ->
    /// `I`, `A::B::C` -> `A`.  Returns the input as-is if no "::" is found.
    ///
    /// Distinct from `parent_of`, which splits on the LAST separator: for a
    /// two-segment name the two agree, and for a longer one they do not.  The
    /// first segment is what a path's meaning turns on - it is the only one
    /// resolved in scope, with every later segment resolved within whatever it
    /// named - so a caller deciding who owns a path needs this one specifically.
    static head_of(s: string) -> string {
        const separator: i64 = s.find("::");
        if (separator < 0) { return s; }
        return s.substr(0, separator);
    }

    /// Extract the last segment after the final "::" in a qualified-name
    /// string.  E.g., "compiler::ast::declaration::DeclarationNode" ->
    /// "DeclarationNode".  Returns the input as-is if no "::" is found.
    /// Operates on the raw-string form (for callers holding a flat name
    /// rather than a structured QualifiedName).
    static leaf_of(s: string) -> string {
        const separator: i64 = s.rfind("::");
        if (separator < 0) { return s; }
        return s.substr(separator + 2, s.length() - separator - 2);
    }

    /// How many "::"-separated segments a raw name string has.
    ///
    /// A path's head accounts for exactly one of them, so a caller recording
    /// how much of a path it did NOT finish subtracts what it resolved from
    /// this.  Empty is zero segments rather than one, so that a name and the
    /// absence of one do not report the same length.
    static segment_count(s: string) -> u32 {
        if (s.length() == 0) { return 0; }
        const separator: Str = Str::from("::");
        mut segments: implement Iterator<Str> = Str::from(s).split(&separator);
        return segments.count() as u32;
    }

    /// Inverse of `leaf_of`: return everything BEFORE the final "::".
    /// Used when building import suggestions - we want the module path
    /// that owns the type (`compiler::diag::diagnostic`), not the type's
    /// own fully-qualified path (`compiler::diag::diagnostic::Diagnostic`).
    /// Returns the empty string when the input has no "::" (single-segment
    /// names like a primitive have no parent path).
    static parent_of(s: string) -> string {
        const separator: i64 = s.rfind("::");
        if (separator <= 0) { return ""; }
        return s.substr(0, separator);
    }

    /// Shorten every qualified path in `s` to its leaf, keeping all
    /// non-identifier punctuation (`<`, `>`, `,`, `&`, `*`, etc.) intact.
    /// Unlike `leaf_of`, this is safe to apply to display strings that
    /// contain generic-arg lists:
    ///
    ///   "Array<u8, std::alloc::allocator::GlobalAlloc>"
    ///     -> "Array<u8, GlobalAlloc>"
    ///
    /// The walk treats `Foo::Bar::Baz` as one identifier path and emits
    /// only the last segment; mangled names (which use `.` and `$L$G`,
    /// not `::`) pass through unchanged because no `::` ever matches.
    /// Used by `format_display_short` for the leaf user-defined type
    /// case where the Type's `display_name()` already includes generic
    /// args from the monomorphizer's `custom_display`.
    static shorten_paths(s: string) -> string {
        const len: i64 = s.length() as i64;
        // Worst case the output is the same length as the input (when no
        // qualified path appears) so a single len+1 buffer suffices.
        const buf: i8* = libc::malloc((len + 1) as u64) as i8*;
        mut out_idx: i64 = 0;
        mut i: i64 = 0;
        while (i < len) {
            const c: char = s[i];
            if (Lexer::is_identifier_start(c)) {
                // Scan an identifier path: <ident> ("::" <ident>)*
                mut leaf_start: i64 = i;
                while (i < len && Lexer::is_identifier_continue(s[i] as char)) { i += 1; }
                while (i + 2 < len
                       && s[i] == ':' as i8
                       && s[i + 1] == ':' as i8
                       && Lexer::is_identifier_start(s[i + 2] as char)) {
                    i += 2;
                    leaf_start = i;
                    while (i < len && Lexer::is_identifier_continue(s[i] as char)) { i += 1; }
                }
                for (mut j: i64 = leaf_start; j < i; j++) {
                    buf[out_idx] = s[j] as i8;
                    out_idx += 1;
                }
            } else {
                buf[out_idx] = c as i8;
                out_idx += 1;
                i += 1;
            }
        }
        buf[out_idx] = 0 as i8;
        return buf as string;
    }
}
