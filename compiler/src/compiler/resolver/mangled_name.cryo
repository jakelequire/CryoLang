/// MangledName: Cryo Mangling Scheme v1.0.0
///
/// Implements `docs/cryo-mangling-spec.md` v1.0.0.  Every emitted symbol
/// is a legal LLVM unquoted identifier (`[-a-zA-Z$._][-a-zA-Z$._0-9]*`)
/// with a `C$` prefix marking it as Cryo-mangled.
///
/// Quick reference:
///   PREFIX         C$
///   KIND TAGS      $ti$ $op$ $mi$ $cl$ $tr$ $vt$
///   PATH SEP       .            MEMBER SEP    -
///   GENERIC OPEN   $L           GENERIC CLOSE $G
///   TYPELIST SEP   _            EMPTY PARAMS  v
///   PARAMS START   $F           RETURN START  $R
///   RECEIVER       $s (&this)   $m (mut &this)
///   TRAIT FOR      $f           OVERLOAD      $O<N>
///   VARIADIC       $V (trailing, after last fixed param)
///
///   POINTER P<T>   REFERENCE R<T>   ARRAY A<T>
///   NAMED   N$L <Path> $G
///
///   PRIMS  i8=a  i16=s  i32/int=i  i64=l
///          u8=h  u16=t  u32=j      u64=m
///          f32=f f64=d  bool=b     char=c
///          string=S    void=v      unit=u

namespace compiler::resolver::mangled_name;

import compiler::resolver::{ symbol_str, intern_table, qualified_name };
import compiler::types::{
    arena, compound, FloatKind, generic, IntegerKind, type_base, type_ref, TypeKind,
    user_defined
};
import std::fmt;
import std::core::intrinsics;
import utils;
import utils::log::{ Log, LogArea };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::qualified_name::{ QualifiedName };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::decl_name::{ DeclName };
import compiler::types::arena::{ TypeArena };
import compiler::types::compound::{
    ArrayType, FunctionType, ObjectType, OptionalType, PointerType, ReferenceType, TupleType
};
import compiler::ast::{ ObjectForm };
import compiler::types::generic::{
    AssocProjectionType, GenericParamType, InstantiatedType
};
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };
import compiler::types::user_defined::{
    EnumType, FunctionTemplateType, StructType, TraitType, TypeAliasType
};


// Mangler internal-compiler-error gate.
//
// The mangler panics on impossible inputs (invalid TypeRef, null Type*,
// unhandled TypeKind) because in a CLI build those states are silent-
// miscompile hazards: falling back to "v" would produce a symbol that
// collides with a real void-typed declaration.  Loud panic = the
// regression is impossible to miss.
//
// The language server, however, is a long-running process that analyses
// repeatedly as files are opened and saved and routinely sees incomplete
// pipelines (a saved edit that breaks another file, a lone file outside
// any project).  A panic in that context kills the editor's language
// server with no recovery path.
//
// `set_lsp_safe(true)` switches the four panic sites to a softer mode:
// they write the offending message to stderr and return a poisoned
// sentinel symbol (`MANGLER_POISON`) instead of aborting.  The LSP
// entry points in `compiler::instance` flip this on right after they
// create their `CompileMode::Lsp` context.  CLI builds never set it,
// so the loud-fail property is preserved for normal `cryo build`.
mut g_mangler_lsp_safe: boolean = false;

/// Sentinel symbol returned by the mangler in LSP-safe mode when it
/// would otherwise panic.  Deliberately unmistakable in nm output and
/// linker errors so the recovered diagnostic is the obvious thing to
/// search for.
const MANGLER_POISON: string = "N$L18__MANGLER_POISON__$G";

/// Switch the mangler between CLI-loud and LSP-safe error handling.
/// Idempotent.  See `g_mangler_lsp_safe` for the rationale.
public function set_lsp_safe(enabled: boolean) -> void {
    g_mangler_lsp_safe = enabled;
}


// ReceiverKind: first-parameter receiver shape for non-static methods

type enum ReceiverKind {
    None;       // free function or static method
    ImmutRef;   // &this        -> encoded as $s
    MutRef;     // mut &this    -> encoded as $m
}

implement enum ReceiverKind {
    is_none(&this) -> boolean {
        return match (this) {
            ReceiverKind::None => { true }
            _                  => { false }
        };
    }

    encode(&this) -> string {
        return match (this) {
            ReceiverKind::None     => { "" }
            ReceiverKind::ImmutRef => { "$s" }
            ReceiverKind::MutRef   => { "$m" }
        };
    }
}


// MangledName: a link symbol

/// A symbol as the linker and the backend see it: a Cryo-mangled name, a C
/// function's own name, a runtime entry point, an LLVM intrinsic.  The
/// backend's symbol table is looked up by these bytes and nothing else looks
/// anything up by them - a declaration is found by its identity, and a name
/// in source is a `SymbolStr` - so a function taking a `MangledName` takes
/// no spelling a program wrote.
///
/// The bytes are one NUL-terminated `string`, so wrapping and unwrapping
/// cost nothing.  `as_string` is written where a C function or a
/// `string`-typed store needs them.
type struct MangledName {
private:
    raw: string;

public:
    /// Mark `s` as a link symbol: a C or runtime symbol, an LLVM intrinsic,
    /// or a symbol the mangler already produced.
    static new(s: string) -> MangledName {
        return MangledName { raw: s };
    }

    /// The raw NUL-terminated bytes.
    as_string(&this) -> string {
        return this.raw;
    }


    // Empty / pass-through


    // Function-like factories

    /// Mangle a free function: `C$<path>$F<params>$R<ret>`.
    static for_free_function(table: InternTable*, arena: TypeArena*,
                             qname: QualifiedName,
                             params: &[TypeRef], ret: TypeRef,
                             is_variadic: boolean) -> MangledName {
        mut ctx: MangleContext = MangleContext::new(table, arena);
        return ctx.mangle_function_like(
            "", qname, SymbolStr::empty(), false,
            params, ret, ReceiverKind::None, is_variadic);
    }


    /// Mangle a method: `C$<owner>-<member>$F[$s|$m_]<params>$R<ret>`.
    /// Pass `receiver = ReceiverKind::None` for static methods.
    static for_method(table: InternTable*, arena: TypeArena*,
                      owner_qname: QualifiedName, method: SymbolStr,
                      receiver: ReceiverKind,
                      params: &[TypeRef], ret: TypeRef,
                      is_variadic: boolean) -> MangledName {
        mut ctx: MangleContext = MangleContext::new(table, arena);
        return ctx.mangle_function_like(
            "", owner_qname, method, true,
            params, ret, receiver, is_variadic);
    }


    /// Mangle a trait-impl method: `C$tr$<trait>$f<owner>-<method>$F...`.
    /// A trait implemented with arguments carries them on its segment
    /// (`C$tr$4Conv$Li$G$f1S-4conv...`), so one type implementing it at two
    /// arguments has two symbols.
    static for_trait_impl(table: InternTable*, arena: TypeArena*,
                          trait_qname: QualifiedName, trait_args: &[TypeRef],
                          owner_qname: QualifiedName, method: SymbolStr,
                          receiver: ReceiverKind,
                          params: &[TypeRef], ret: TypeRef,
                          is_variadic: boolean) -> MangledName {
        // C$tr$<trait_path>[$L<args>$G]$f<owner_path>-<method>$F<params>$R<ret>
        mut ctx: MangleContext = MangleContext::new(table, arena);
        mut buf: string = "C$tr$";
        buf += MangleContext::encode_path(table, trait_qname, SymbolStr::empty(), false);
        if (trait_args.length() > 0) {
            buf += "$L";
            for (mut i: i64 = 0; i < trait_args.length(); i++) {
                if (i > 0) { buf += "_"; }
                buf += ctx.encode_type_ref(trait_args[i], "for_trait_impl.trait_arg");
            }
            buf += "$G";
        }
        buf += "$f";
        buf += MangleContext::encode_path(table, owner_qname, method, true);
        buf += "$F";
        buf += ctx.encode_params(params, receiver, is_variadic);
        buf += "$R";
        buf += ctx.encode_type_ref(ret, "for_trait_impl.ret");
        return MangledName { raw: buf };
    }

    /// Mangle the table of a trait's methods for a type, a trait object's
    /// second word: `C$vt$<trait>[$L<args>$G]$f<owner>`, the trait-impl
    /// method's symbol with no member and no signature, so two traits'
    /// tables for one type differ.
    static for_object_table(table: InternTable*, arena: TypeArena*,
                            trait_qname: QualifiedName, trait_args: &[TypeRef],
                            owner_qname: QualifiedName) -> MangledName {
        mut ctx: MangleContext = MangleContext::new(table, arena);
        mut buf: string = "C$vt$";
        buf += MangleContext::encode_path(table, trait_qname, SymbolStr::empty(), false);
        if (trait_args.length() > 0) {
            buf += "$L";
            for (mut i: i64 = 0; i < trait_args.length(); i++) {
                if (i > 0) { buf += "_"; }
                buf += ctx.encode_type_ref(trait_args[i], "for_object_table.trait_arg");
            }
            buf += "$G";
        }
        buf += "$f";
        buf += MangleContext::encode_path(table, owner_qname, SymbolStr::empty(), false);
        return MangledName { raw: buf };
    }

    /// Choose between inherent-method and trait-impl mangling based on
    /// whether the method carries an originating trait (see
    /// `FunctionDecl.origin_trait`).  When `origin_trait` is valid the
    /// symbol is the trait-qualified form (`C$tr$<trait>$f<owner>-<method>`)
    /// so two distinct traits that define a same-named method for the same
    /// type don't collide; otherwise it is the plain `for_method` form.
    /// Every method mangling site routes through here so the definition,
    /// the call-site pin, and the cross-module extern decl always agree on
    /// the symbol.
    static for_method_or_trait_impl(table: InternTable*, arena: TypeArena*,
                                    owner_qname: QualifiedName,
                                    origin_trait: SymbolStr, trait_args: &[TypeRef],
                                    method: SymbolStr, receiver: ReceiverKind,
                                    params: &[TypeRef], ret: TypeRef,
                                    is_variadic: boolean) -> MangledName {
        if (origin_trait.is_valid()) {
            const trait_qname: QualifiedName =
                QualifiedName::from_symbol(origin_trait);
            return MangledName::for_trait_impl(
                table, arena, trait_qname, trait_args, owner_qname, method, receiver,
                params, ret, is_variadic);
        }
        return MangledName::for_method(
            table, arena, owner_qname, method, receiver, params, ret,
            is_variadic);
    }


    // Data-symbol factories (no signature)

    /// Global variable / constant: `C$<namespace_path>.<name>` (data symbol,
    /// no signature).  When `namespace_sym` is empty the result is the
    /// historical bare `C$<name>` form (used for root-namespace globals,
    /// e.g. things imported via raw extern blocks).  Both the defining
    /// module and consumer modules must call this with the SAME namespace
    /// for the symbol to link; `resolve_global` looks up the defining
    /// namespace via `DeclarationIndex::get_global_namespace`.
    ///
    /// The full path is wrapped in a single-segment QualifiedName and fed
    /// to `encode_path`, whose depth==1 branch routes through
    /// `string::split_nonempty("::")` (libc `substr`, NUL-safe).  Going through
    /// `QualifiedName::parse` here instead produced 0-length segments
    /// because `text.substring` doesn't always re-NUL-terminate; keeping
    /// to the depth==1 path avoids that pitfall.
    static for_global(table: InternTable*, home: DeclName,
                      name: SymbolStr) -> MangledName {
        mut full: string = "";
        if (home.is_valid()) {
            full = table.shown(home) + "::" + table.resolve(name);
        } else {
            full = table.resolve(name);
        }
        const qname: QualifiedName = QualifiedName::single(table, full);
        const path: string = MangleContext::encode_path(table, qname, SymbolStr::empty(), false);
        return MangledName { raw: "C$" + path };
    }

    /// A type's constant: `C$<type path>-<name>`, the member form a method
    /// takes, with no signature since it is data (`Point::ORIGIN` in
    /// `Geom` is `C$4Geom.5Point-6ORIGIN`, `i32::MAX` is `C$3i32-3MAX`).
    static for_type_constant(table: InternTable*, owner: DeclName,
                             name: SymbolStr) -> MangledName {
        const qname: QualifiedName = QualifiedName::single(table, table.shown(owner));
        const path: string = MangleContext::encode_path(table, qname, name, true);
        return MangledName { raw: "C$" + path };
    }

    /// LLVM struct type name for a Cryo type: `C$<path>`.
    /// Same shape as `for_global` since LLVM type and value namespaces
    /// are distinct; the `C$` prefix unambiguously marks Cryo origin.
    static for_struct_type(table: InternTable*, qname: QualifiedName) -> MangledName {
        const path: string = MangleContext::encode_path(table, qname, SymbolStr::empty(), false);
        return MangledName { raw: "C$" + path };
    }


    /// Centralized identifier generator for generic specializations.
    /// This is **the** way to spell a monomorphized type's or function's
    /// identifier: the specializer names its clone with it, and codegen
    /// later passes the result through `for_struct_type` for the LLVM
    /// symbol.  It is a name and never a key: a specialization is
    /// registered and found by its template and its type arguments.
    ///
    /// The output is the path-with-leaf-generics encoding, without
    /// the `C$` prefix or signature.  E.g. `Box<Monomorphizer>` ->
    /// `3Box$LN$L13Monomorphizer$G$G`, `Pair<int, string>` ->
    /// `4Pair$Li_S$G`.
    ///
    /// No callsite outside this module is allowed to invent its own
    /// specialization-name format.  If a future need can't be expressed
    /// here, extend this function; don't roll your own.
    static specialized_identifier(table: InternTable*, arena: TypeArena*,
                                  base_qname: QualifiedName,
                                  type_args: &[TypeRef]) -> SymbolStr {
        mut ctx: MangleContext = MangleContext::new(table, arena);
        const encoded: string = ctx.encode_path_with_leaf_generics(
            base_qname, type_args, SymbolStr::empty(), false);
        return table.intern(encoded);
    }


    // Overload disambiguator


    /// Append `$MG<arg>{_<arg>}*$` encoding the concrete type arguments of a
    /// generic METHOD specialization (`m<T>` with `T = i64`).  A generic method
    /// whose own signature does not mention `T` (e.g. `name<T>() -> string`)
    /// would otherwise mangle identically for every `T`, collapsing every
    /// instantiation onto the first emitted spec (`m<i64>` and `m<u64>` share
    /// one LLVM symbol).  The owner-template path disambiguates via the spec'd
    /// owner name (`Atomic_u64`), but a method-level spec on a fixed owner has
    /// no such carrier - so the method's own type args go here.  No-op for an
    /// empty arg list, so every non-generic-method symbol is byte-unchanged.
    /// The mono call-site pin and the codegen definition both feed
    /// `func.spec_type_args` through this, so the two always agree.
    with_method_spec_args(&this, table: InternTable*, arena: TypeArena*,
                          args: &[TypeRef]) -> MangledName {
        if (args.length() == 0) { return MangledName { raw: this.raw }; }
        mut ctx: MangleContext = MangleContext::new(table, arena);
        mut buf_m: string = this.raw;
        buf_m += "$MG";
        for (mut i: i64 = 0; i < args.length(); i++) {
            if (i > 0) { buf_m += "_"; }
            buf_m += ctx.encode_type_ref(args[i], "with_method_spec_args.arg");
        }
        buf_m += "$";
        return MangledName { raw: buf_m };
    }

}


// MangleContext: bundles the InternTable + TypeArena the encoders thread
// through, so the encoding routines are methods rather than free functions
// that pass `(table, arena)` to one another by hand.  Table-only encoders
// (paths don't recurse into the arena) and the pure code tables are statics.

type struct MangleContext {
    table: InternTable*;
    arena: TypeArena*;

    static new(table: InternTable*, arena: TypeArena*) -> MangleContext {
        return MangleContext { table: table, arena: arena };
    }


    // Function-like spines

    /// Common spine for function-like symbols:
    ///   C$[<kind>$]<path>[-<member>]$F<params>$R<ret>
    mangle_function_like(&this, kind_code: string,
                         owner_qname: QualifiedName,
                         member: SymbolStr, has_member: boolean,
                         params: &[TypeRef], ret: TypeRef,
                         receiver: ReceiverKind,
                         is_variadic: boolean) -> MangledName {
        const path: string = MangleContext::encode_path(this.table, owner_qname, member, has_member);
        return this.mangle_with_path(kind_code, path, params, ret,
                                     receiver, is_variadic, true);
    }

    /// Same as above but with a pre-built path string (for callers that
    /// need leaf-generic encoding).
    mangle_with_path(&this, kind_code: string, path: string,
                     params: &[TypeRef], ret: TypeRef,
                     receiver: ReceiverKind, is_variadic: boolean,
                     emit_signature: boolean) -> MangledName {
        mut buf: string = "C$";
        if (kind_code.length() > 0) {
            buf += kind_code;
            buf += "$";
        }
        buf += path;
        if (emit_signature) {
            buf += "$F";
            buf += this.encode_params(params, receiver, is_variadic);
            buf += "$R";
            buf += this.encode_type_ref(ret, "mangle_with_path.ret");
        }
        return MangledName { raw: buf };
    }


    // Path encoders

    /// Encode a QualifiedName as `<seg>{.<seg>}*[-<member>]`.  Each segment
    /// is length-prefixed (`<byte_len><raw>`).  If the qname is a single
    /// part containing `::` sequences (the common case from
    /// QualifiedName::from_symbol on a pre-joined string), it is split into
    /// multiple segments.  Table-only (no arena recursion) -> static.
    static encode_path(table: InternTable*, qname: QualifiedName,
                       member: SymbolStr, has_member: boolean) -> string {
        mut buf: string = "";

        if (qname.is_empty()) {
            // Defensive: emit a single empty segment so the result is still
            // structurally well-formed.
            buf = "0";
        } else if (qname.depth() == 1) {
            const raw: string = table.resolve(qname.part_at(0));
            const segs: [string] = raw.split_nonempty("::");
            if (segs.length() == 0) {
                buf = MangleContext::encode_ident(raw);
            } else {
                for (mut i: i64 = 0; i < segs.length(); i++) {
                    if (i > 0) { buf += "."; }
                    buf += MangleContext::encode_ident(segs[i]);
                }
            }
        } else {
            for (mut i: i64 = 0; i < qname.depth(); i++) {
                if (i > 0) { buf += "."; }
                buf += MangleContext::encode_ident(table.resolve(qname.part_at(i)));
            }
        }

        if (has_member && member.is_valid()) {
            buf += "-";
            buf += MangleContext::encode_ident(table.resolve(member));
        }
        return buf;
    }

    /// Encode a path where the LAST segment carries a generic arg list.
    ///   Pair<int>           -> 4Pair$Li$G
    ///   Pair<int>::new      -> 4Pair$Li$G-3new
    ///   Math::Vec2<int>     -> 4Math.4Vec2$Li$G
    encode_path_with_leaf_generics(&this, qname: QualifiedName, generic_args: &[TypeRef],
                                   member: SymbolStr, has_member: boolean) -> string {
        // First produce the segment list (split on "::" if needed).
        mut segs: [string] = [];
        if (qname.is_empty()) {
            segs.push("");
        } else if (qname.depth() == 1) {
            const raw: string = this.table.resolve(qname.part_at(0));
            const split: [string] = raw.split_nonempty("::");
            if (split.length() == 0) {
                segs.push(raw);
            } else {
                for (mut i: i64 = 0; i < split.length(); i++) {
                    segs.push(split[i]);
                }
            }
        } else {
            for (mut i: i64 = 0; i < qname.depth(); i++) {
                segs.push(this.table.resolve(qname.part_at(i)));
            }
        }

        // Build the path, attaching $L<args>$G to the last segment if any.
        mut buf: string = "";
        const last_idx: i64 = segs.length() - 1;
        for (mut i: i64 = 0; i < segs.length(); i++) {
            if (i > 0) { buf += "."; }
            buf += MangleContext::encode_ident(segs[i]);
            if (i == last_idx && generic_args.length() > 0) {
                buf += "$L";
                for (mut j: i64 = 0; j < generic_args.length(); j++) {
                    if (j > 0) { buf += "_"; }
                    buf += this.encode_type_ref(generic_args[j], "leaf_generics.arg");
                }
                buf += "$G";
            }
        }

        if (has_member && member.is_valid()) {
            buf += "-";
            buf += MangleContext::encode_ident(this.table.resolve(member));
        }
        return buf;
    }


    // Parameter + type encoders

    /// Encode a parameter list with optional receiver and variadic marker.
    /// Empty list with no receiver and no variadic -> literal "v".
    encode_params(&this, params: &[TypeRef], receiver: ReceiverKind,
                  is_variadic: boolean) -> string {
        if (params.length() == 0 && receiver.is_none() && !is_variadic) {
            return "v";
        }

        mut buf: string = "";
        mut first: boolean = true;

        if (!receiver.is_none()) {
            buf += receiver.encode();
            first = false;
        }

        for (mut i: i64 = 0; i < params.length(); i++) {
            if (!first) { buf += "_"; }
            buf += this.encode_type_ref(params[i], "encode_params.param");
            first = false;
        }

        if (is_variadic) {
            buf += "$V";
        }
        return buf;
    }

    /// Encode a type by TypeRef, recursing into compound shapes via the arena.
    ///
    /// An invalid TypeRef or a null arena lookup at this point is an
    /// internal compiler error: by the time the mangler runs, every type
    /// referenced by a declaration MUST have been resolved.  Earlier
    /// versions emitted a build-survivable warning + `v` fallback while
    /// the upstream resolution gaps were being closed off; the gaps are
    /// now closed (see commits in `new-stdlib`), so reaching this state
    /// indicates a NEW resolution gap and we panic with the caller-site
    /// label so the regression is loud rather than producing a junk
    /// symbol whose `$R` slot is `v`.
    encode_type_ref(&this, ty: TypeRef, caller: string) -> string {
        if (!ty.is_valid()) {
            return MangleContext::ice(fmt::format(
                "encode_type_ref: invalid TypeRef (id=0) at %s; upstream resolution gap",
                caller));
        }
        const t: Type* = this.arena.lookup(ty);
        if (t == null) {
            return MangleContext::ice(fmt::format(
                "encode_type_ref: arena lookup returned null for TypeRef id=%llu at %s",
                ty.key(), caller));
        }
        return this.encode_type(ty, t);
    }

    /// Encode `ty`, the Type `ref` names.  Compound types recurse via
    /// encode_type_ref.
    encode_type(&this, ref: TypeRef, ty: Type*) -> string {
        if (ty == null) {
            return MangleContext::ice("encode_type: null Type* (internal compiler error, caller passed null)");
        }

        if (ty.kind == TypeKind::Void)   { return "v"; }
        if (ty.kind == TypeKind::Unit)   { return "u"; }
        if (ty.kind == TypeKind::Bool)   { return "b"; }
        if (ty.kind == TypeKind::Char)   { return "c"; }
        if (ty.kind == TypeKind::String) { return "S"; }
        if (ty.kind == TypeKind::Never)  { return "v"; }   // no spec code; map to void
        if (ty.kind == TypeKind::VaList) { return "V"; }

        if (ty.kind == TypeKind::Int) {
            const it: IntegerKind = ty.int_kind();
            return MangleContext::int_code(it);
        }
        if (ty.kind == TypeKind::Float) {
            const ft: FloatKind = ty.float_kind();
            return MangleContext::float_code(ft);
        }

        if (ty.kind == TypeKind::Pointer) {
            const p: PointerType* = ty.as_pointer();
            return "P" + this.encode_type_ref(p.pointee, "Pointer.pointee");
        }
        if (ty.kind == TypeKind::Reference) {
            const r: ReferenceType* = ty.as_reference();
            return "R" + this.encode_type_ref(r.referent, "Reference.referent");
        }
        if (ty.kind == TypeKind::Array) {
            // A fixed array carries its length: `[T; 8]`, `[T; 16]` and `[T]` are
            // three distinct types, and `specialized_identifier` spells every
            // monomorphization's symbol off this encoding.  Dropping the
            // length gives them one symbol, so `Option<[u8; 8]>` and
            // `Option<[u8]>` would link as one.
            //
            // The length is bracketed in `$L`/`$G` rather than written bare:
            // no type code may begin with `$`, so the form is self-delimiting
            // and round-trips, where a bare `A8h` could not be told from an
            // element code beginning with a digit.  A dynamic `[T]` is the
            // `Array<T>` instance and is encoded as one.
            //
            // `size` is authoritative here.  The fixed-pending marker (-2, a
            // `[T; NAME]` whose size expression has not yet been folded) lives
            // on `ArrayAnnotation`, and `TypeResolver::array_size_of` folds it
            // at the one site that builds an arena array - so a pending size
            // cannot reach the mangler and split one type across two keys.
            const a: ArrayType* = ty.as_array();
            const elem_a: string = this.encode_type_ref(a.element, "Array.element");
            const len_a: u64 = a.size as u64;
            mut buf_a: string = "A$L";
            buf_a += len_a.to_decimal_str();
            buf_a += "$G";
            buf_a += elem_a;
            return buf_a;
        }
        if (ty.kind == TypeKind::Optional) {
            // Optional<T>: encode as a synthetic named generic so the form
            // is round-trippable through the demangler.
            const o: OptionalType* = ty.as_optional();
            const inner_o: string = this.encode_type_ref(o.wrapped, "Optional.wrapped");
            mut buf_o: string = "N$L8Optional$L";
            buf_o += inner_o;
            buf_o += "$G$G";
            return buf_o;
        }
        if (ty.kind == TypeKind::Object) {
            // A trait object: a synthetic named generic over a reserved name
            // per form, whose arguments are the trait and then the trait's
            // bound arguments, as `Optional` is encoded.
            const obj: ObjectType* = ty.as_object();
            mut buf_v: string = match (obj.form) {
                ObjectForm::Borrowed        => { "N$L10VirtualRef$L" }
                ObjectForm::MutableBorrowed => { "N$L13VirtualMutRef$L" }
                ObjectForm::Raw             => { "N$L10VirtualPtr$L" }
            };
            buf_v += this.encode_type_ref(obj.trait_type, "Object.trait");
            for (mut i: i64 = 0; i < obj.args.length(); i++) {
                buf_v += "_";
                buf_v += this.encode_type_ref(obj.args[i], "Object.argument");
            }
            buf_v += "$G$G";
            return buf_v;
        }

        if (ty.kind == TypeKind::Function) {
            const f: FunctionType* = ty.as_function();
            const inner_params: string = this.encode_params(
                f.param_types, ReceiverKind::None, f.is_variadic);
            const inner_ret: string = this.encode_type_ref(f.return_type, "FunctionType.ret");
            mut buf_f: string = "F$L";
            buf_f += inner_params;
            buf_f += "$G";
            buf_f += inner_ret;
            return buf_f;
        }

        if (ty.kind == TypeKind::Struct
         || ty.kind == TypeKind::Enum
         || ty.kind == TypeKind::Trait
         || ty.kind == TypeKind::TypeAlias
         || ty.kind == TypeKind::FunctionTemplate) {
            // SINGLE-ID IDENTITY: a monomorphized generic now lives at its former
            // wrapper's id AS a concrete Struct/Enum carrying the mangled
            // SPEC name, so it lands here - while any path still holding an
            // InstantiatedType node lands on the `encode_instantiated` branch
            // below.  One logical type, two symbols: the definition is emitted
            // under the spec-named form while call sites reference the base+args
            // form (or vice versa), and the link fails with undefined references.
            //
            // Normalize onto the base+args form, which is what the pinned
            // pre-swap compiler emits for every generic instantiation.  Encoding
            // toward the spec-named form instead would change every generic
            // symbol in the program relative to the pin, breaking selfhost
            // byte-identity and forcing a two-phase repin.
            if (ty.kind == TypeKind::Struct
             || ty.kind == TypeKind::Enum) {
                const inst_base: TypeRef = this.arena.inst_generic_base(ref);
                if (inst_base.is_valid()) {
                    return this.encode_instantiation_of(inst_base, ref);
                }
            }
            const inner_n: string = MangleContext::encode_named_type_path(this.table, ty);
            mut buf_n: string = "N$L";
            buf_n += inner_n;
            buf_n += "$G";
            return buf_n;
        }

        if (ty.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = ty.as_instantiated();
            return this.encode_instantiated(ref, inst);
        }

        if (ty.kind == TypeKind::GenericParam) {
            const gp: GenericParamType* = ty.as_generic_param();
            // Should be resolved before mangling; emit the param name so any
            // leaks are easy to spot in IR rather than a silent collision.
            return "N$L" + MangleContext::encode_ident(this.table.resolve(gp.param_name)) + "$G";
        }
        if (ty.kind == TypeKind::AssocProjection) {
            // Symbolic associated-type projection (`I::Item`). Like GenericParam,
            // it appears only in TEMPLATE signatures and is resolved to its concrete
            // member type before a real (codegen'd) spec is mangled - so emit a
            // stable, distinct placeholder (`base` + `::` + `member`) rather than
            // ICE. A leak into an emitted symbol stays visible (never collides with
            // a genuine named type), matching the GenericParam policy above.
            const proj: AssocProjectionType* = ty.as_assoc_projection();
            mut buf_pj: string = "N$L";
            buf_pj += this.encode_type_ref(proj.base, "AssocProjection.base");
            buf_pj += "_";   // `::` escape
            buf_pj += MangleContext::encode_ident(this.table.resolve(proj.member));
            buf_pj += "$G";
            return buf_pj;
        }

        // Tuple<T0, T1, ...>: encode as a synthetic named generic so distinct
        // element shapes produce distinct mangled names. Must include element
        // types: collapsing all tuples to a single placeholder caused
        // generic specs like `Option<(i32, i32)>` and `Option<(String, String)>`
        // to share a spec name, with the second registration overwriting the
        // first in the type registry.
        if (ty.kind == TypeKind::Tuple) {
            const tup: TupleType* = ty.as_tuple();
            mut buf_t: string = "N$L5Tuple$L";
            for (mut i: i64 = 0; i < tup.elements.length(); i++) {
                if (i > 0) { buf_t += "_"; }
                buf_t += this.encode_type_ref(tup.elements[i], "Tuple.element");
            }
            buf_t += "$G$G";
            return buf_t;
        }

        // Unhandled type kind.  Reaching here means either:
        //   1. A new TypeKind was added without updating the mangler, or
        //   2. A type that should have been substituted/resolved earlier
        //      survived to mangling (e.g. an Error sentinel or a leak from
        //      an upstream pass).
        // Either way, falling back to "v" silently produces a symbol that
        // collides with genuine void-typed declarations; panic so the
        // offending site is loud rather than silently miscompiled.
        return MangleContext::ice(fmt::format("encode_type: unhandled type kind %s; extend the mangler or close the upstream resolution gap",
                     ty.kind.to_string()));
    }

    /// Encode the qualified path of a named type for use INSIDE `N$L...$G`.
    /// Table-only -> static.
    static encode_named_type_path(table: InternTable*, ty: Type*) -> string {
        if (ty.kind == TypeKind::Struct) {
            const s: StructType* = ty.as_struct();
            return MangleContext::encode_named_qname(table, s.qualified_name.spelling());
        }
        if (ty.kind == TypeKind::Enum) {
            const e: EnumType* = ty.as_enum();
            return MangleContext::encode_named_qname(table, e.qualified_name.spelling());
        }
        if (ty.kind == TypeKind::Trait) {
            const tr: TraitType* = ty.as_trait();
            return MangleContext::encode_named_qname(table, tr.qualified_name.spelling());
        }
        if (ty.kind == TypeKind::TypeAlias) {
            const ta: TypeAliasType* = ty.as_alias();
            return MangleContext::encode_named_qname(table, ta.alias_name);
        }
        if (ty.kind == TypeKind::FunctionTemplate) {
            const ft: FunctionTemplateType* = ty.as_function_template();
            return MangleContext::encode_named_qname(table, ft.qualified_name.spelling());
        }
        return MangleContext::encode_ident("?");
    }

    /// Encode a single SymbolStr that may contain `::` separators as a
    /// length-prefixed segment chain (`4Math.6Vector.4Vec2`).  Table-only -> static.
    static encode_named_qname(table: InternTable*, sym: SymbolStr) -> string {
        const raw: string = table.resolve(sym);
        const segs: [string] = raw.split_nonempty("::");
        if (segs.length() == 0) {
            return MangleContext::encode_ident(raw);
        }
        mut buf: string = "";
        for (mut i: i64 = 0; i < segs.length(); i++) {
            if (i > 0) { buf += "."; }
            buf += MangleContext::encode_ident(segs[i]);
        }
        return buf;
    }

    /// Encode an InstantiatedType as a named generic instance:
    ///   Pair<int>       -> 4Pair$Li$G
    ///   Result<T, U>    -> 6Result$L<T>_<U>$G
    encode_instantiated(&this, ref: TypeRef, inst: InstantiatedType*) -> string {
        return this.encode_instantiation_of(inst.generic_base, ref);
    }

    /// Encode an instantiation from its `(generic_base, type_args)` identity,
    /// reading the args off `owner` (a pre-mono wrapper OR a post-mono concrete -
    /// both carry the same identity).  Keeping ONE encoder for both is what
    /// guarantees a type mangles to a single symbol regardless of which
    /// representation the caller happens to hold; encoding them separately is
    /// what produced the defined-vs-referenced symbol split.
    encode_instantiation_of(&this, base: TypeRef, owner: TypeRef) -> string {
        const base_t: Type* = this.arena.lookup(base);
        mut buf: string = "N$L";
        if (base_t == null) {
            buf += MangleContext::encode_ident("?");
        } else {
            buf += MangleContext::encode_named_type_path(this.table, base_t);
        }
        buf += "$L";
        const n: i64 = this.arena.inst_type_arg_count(owner);
        for (mut i: i64 = 0; i < n; i++) {
            if (i > 0) { buf += "_"; }
            buf += this.encode_type_ref(this.arena.inst_type_arg_at(owner, i),
                                        "InstantiatedType.arg");
        }
        buf += "$G";
        buf += "$G";
        return buf;
    }


    // Pure code tables + identifier primitive (no table/arena) -> statics

    /// Length-prefix an identifier: `<byte_len><raw>`, the length counting
    /// bytes, not code points (docs/cryo-mangling-spec.md).
    static encode_ident(text: string) -> string {
        return fmt::format("%lld%s", text.length() as i64, text);
    }

    static int_code(k: IntegerKind) -> string {
        return match (k) {
            IntegerKind::I8   => { "a" }
            IntegerKind::I16  => { "s" }
            IntegerKind::I32  => { "i" }
            IntegerKind::I64  => { "l" }
            // 128-bit ints use the Itanium builtin codes `n` (__int128) and
            // `o` (unsigned __int128). These MUST be distinct from i64/u64 (`l`/`m`):
            // sharing a code collapses `foo<u128>` and `foo<u64>` to one symbol, so
            // a generic instantiated for both (e.g. `format_to_string`) binds the
            // u128 call to the u64 body and silently truncates to 64 bits.
            IntegerKind::I128 => { "n" }
            IntegerKind::U8   => { "h" }
            IntegerKind::U16  => { "t" }
            IntegerKind::U32  => { "j" }
            IntegerKind::U64  => { "m" }
            IntegerKind::U128 => { "o" }
            // Platform-width ints. No Itanium builtin code exists for size types
            // (they're typedefs there), so we use distinct scheme-local codes.
            // MUST differ from i64/u64 (`l`/`m`) for the same reason i128/u128 do:
            // a shared code collapses `foo<usize>` and `foo<u64>` to one symbol.
            IntegerKind::Isize => { "x" }
            IntegerKind::Usize => { "y" }
        };
    }

    static float_code(k: FloatKind) -> string {
        return match (k) {
            FloatKind::F32 => { "f" }
            FloatKind::F64 => { "d" }
        };
    }

    /// Internal: report an unrecoverable mangler state.  In CLI mode this
    /// calls `intrinsics::panic` (which aborts).  In LSP-safe mode it
    /// logs the error in the `lsp` area and returns the poison sentinel so
    /// the daemon survives.
    static ice(msg: string) -> string {
        if (g_mangler_lsp_safe) {
            Log::error(LogArea::Lsp, f"mangler internal error: {msg}");
            return MANGLER_POISON;
        }
        intrinsics::panic(msg, intrinsics::location());
        return MANGLER_POISON;
    }
}
