/// MangledName — Cryo Mangling Scheme v0.2
///
/// Implements `docs/cryo-mangling-spec.md` v0.2.  Every emitted symbol
/// is a legal LLVM unquoted identifier (`[-a-zA-Z$._][-a-zA-Z$._0-9]*`)
/// with a `C$` prefix marking it as Cryo-mangled.
///
/// Quick reference:
///   PREFIX         C$
///   KIND TAGS      $vt$ $ti$ $ct$ $dt$ $op$ $mi$ $cl$ $tr$
///   PATH SEP       .            MEMBER SEP    -
///   GENERIC OPEN   $L           GENERIC CLOSE $G
///   TYPELIST SEP   _            EMPTY PARAMS  v
///   PARAMS START   $F           RETURN START  $R
///   RECEIVER       $s (&this)   $m (mut &this)
///   TRAIT FOR      $f           OVERLOAD      $O<N>
///   VARIADIC       $V (trailing, after last fixed param)
///
///   POINTER P<T>   REFERENCE R<T>   ARRAY A<T>
///   NAMED   N$L <Path> $G
///
///   PRIMS  i8=a  i16=s  i32/int=i  i64=l
///          u8=h  u16=t  u32=j      u64=m
///          f32=f f64=d  bool=b     char=c
///          string=S    void=v      unit=u

namespace Compiler::Resolver::MangledName;

import Compiler::Resolver::SymbolStr;
import Compiler::Resolver::InternTable;
import Compiler::Resolver::QualifiedName;
import Compiler::Types::TypeRef;
import Compiler::Types::Type;
import Compiler::Types::Compound;
import Compiler::Types::UserDefined;
import Compiler::Types::Generic;
import Compiler::Types::Arena;
import Compiler::Types;


// ============================================================================
// ReceiverKind — first-parameter receiver shape for non-static methods
// ============================================================================

type enum ReceiverKind {
    None;       // free function or static method
    ImmutRef;   // &this        → encoded as $s
    MutRef;     // mut &this    → encoded as $m
}

implement enum ReceiverKind {
    is_none(&this) -> boolean {
        return match (this) {
            ReceiverKind::None => { true }
            _                  => { false }
        };
    }

    encode(&this) -> string {
        return match (this) {
            ReceiverKind::None     => { "" }
            ReceiverKind::ImmutRef => { "$s" }
            ReceiverKind::MutRef   => { "$m" }
        };
    }
}


// ============================================================================
// OperatorKind — canonical short codes for operator overloads (spec §7)
// ============================================================================

type enum OperatorKind {
    Add; Sub; Mul; Div; Mod;
    Band; Bor; Xor; Shl; Shr;
    Eq; Ne; Lt; Le; Gt; Ge;
    Land; Lor; Lnot;
    Idx; Call; Neg;
}

implement enum OperatorKind {
    /// Spec §7 operator-code mapping.
    code(&this) -> string {
        return match (this) {
            OperatorKind::Add  => { "add"  }
            OperatorKind::Sub  => { "sub"  }
            OperatorKind::Mul  => { "mul"  }
            OperatorKind::Div  => { "div"  }
            OperatorKind::Mod  => { "mod"  }
            OperatorKind::Band => { "band" }
            OperatorKind::Bor  => { "bor"  }
            OperatorKind::Xor  => { "xor"  }
            OperatorKind::Shl  => { "shl"  }
            OperatorKind::Shr  => { "shr"  }
            OperatorKind::Eq   => { "eq"   }
            OperatorKind::Ne   => { "ne"   }
            OperatorKind::Lt   => { "lt"   }
            OperatorKind::Le   => { "le"   }
            OperatorKind::Gt   => { "gt"   }
            OperatorKind::Ge   => { "ge"   }
            OperatorKind::Land => { "land" }
            OperatorKind::Lor  => { "lor"  }
            OperatorKind::Lnot => { "lnot" }
            OperatorKind::Idx  => { "idx"  }
            OperatorKind::Call => { "call" }
            OperatorKind::Neg  => { "neg"  }
        };
    }
}

/// Map a method-name spelling (raw operator like "+", "operator+",
/// or already-resolved code like "add") to its OperatorKind.
/// Returns Option::None for unknown spellings.
function operator_kind_from_name(name: string) -> Option<OperatorKind> {
    // Strip an optional "operator" prefix.
    mut s: string = name;
    const slen0: u64 = strlen(s);
    if (slen0 >= 8) {
        const head: string = substr(s, 0, 8);
        if (head == "operator") {
            s = substr(s, 8, slen0 - 8);
        }
    }

    if (s == "+"  || s == "add" ) { return Option::Some(OperatorKind::Add);  }
    if (s == "-"  || s == "sub" ) { return Option::Some(OperatorKind::Sub);  }
    if (s == "*"  || s == "mul" ) { return Option::Some(OperatorKind::Mul);  }
    if (s == "/"  || s == "div" ) { return Option::Some(OperatorKind::Div);  }
    if (s == "%"  || s == "mod" ) { return Option::Some(OperatorKind::Mod);  }
    if (s == "&"  || s == "band") { return Option::Some(OperatorKind::Band); }
    if (s == "|"  || s == "bor" ) { return Option::Some(OperatorKind::Bor);  }
    if (s == "^"  || s == "xor" ) { return Option::Some(OperatorKind::Xor);  }
    if (s == "<<" || s == "shl" ) { return Option::Some(OperatorKind::Shl);  }
    if (s == ">>" || s == "shr" ) { return Option::Some(OperatorKind::Shr);  }
    if (s == "==" || s == "eq"  ) { return Option::Some(OperatorKind::Eq);   }
    if (s == "!=" || s == "ne"  ) { return Option::Some(OperatorKind::Ne);   }
    if (s == "<"  || s == "lt"  ) { return Option::Some(OperatorKind::Lt);   }
    if (s == "<=" || s == "le"  ) { return Option::Some(OperatorKind::Le);   }
    if (s == ">"  || s == "gt"  ) { return Option::Some(OperatorKind::Gt);   }
    if (s == ">=" || s == "ge"  ) { return Option::Some(OperatorKind::Ge);   }
    if (s == "&&" || s == "land") { return Option::Some(OperatorKind::Land); }
    if (s == "||" || s == "lor" ) { return Option::Some(OperatorKind::Lor);  }
    if (s == "!"  || s == "lnot") { return Option::Some(OperatorKind::Lnot); }
    if (s == "[]" || s == "idx" ) { return Option::Some(OperatorKind::Idx);  }
    if (s == "()" || s == "call") { return Option::Some(OperatorKind::Call); }
    if (s == "neg")               { return Option::Some(OperatorKind::Neg);  }
    return Option::None;
}


// ============================================================================
// MangledName — opaque LLVM-safe symbol handle
// ============================================================================

type struct MangledName {
    /// The interned mangled string.  Treat as opaque — only resolve
    /// through the InternTable when emitting to LLVM IR or diagnostics.
    value: SymbolStr;


    // ----------------------------------------------------------------
    // Empty / pass-through
    // ----------------------------------------------------------------

    /// An empty / invalid mangled name.
    static empty() -> MangledName {
        return MangledName { value: SymbolStr::empty() };
    }

    /// Pass-through for `extern "C"`: the linker-visible name is the
    /// source name, unmangled (spec §12.9).
    static extern_c(table: InternTable*, name: string) -> MangledName {
        return MangledName { value: table.intern(name) };
    }


    // ----------------------------------------------------------------
    // Function-like factories
    // ----------------------------------------------------------------

    /// Mangle a free function: `C$<path>$F<params>$R<ret>`.
    static for_free_function(table: InternTable*, arena: TypeArena*,
                             qname: QualifiedName,
                             params: TypeRef[], ret: TypeRef,
                             is_variadic: boolean) -> MangledName {
        return mangle_function_like(
            table, arena, "", qname, SymbolStr::empty(), false,
            params, ret, ReceiverKind::None, is_variadic);
    }

    /// Mangle a free generic function: `C$<base$L<args>$G>$F<params>$R<ret>`.
    /// The leaf segment of `qname` carries the generic arg list.
    static for_free_function_generic(table: InternTable*, arena: TypeArena*,
                                     qname: QualifiedName, generic_args: TypeRef[],
                                     params: TypeRef[], ret: TypeRef,
                                     is_variadic: boolean) -> MangledName {
        const path: string = encode_path_with_leaf_generics(
            table, arena, qname, generic_args, SymbolStr::empty(), false);
        return mangle_with_path(
            table, arena, "", path, params, ret,
            ReceiverKind::None, is_variadic, true);
    }

    /// Mangle a method: `C$<owner>-<member>$F[$s|$m_]<params>$R<ret>`.
    /// Pass `receiver = ReceiverKind::None` for static methods.
    static for_method(table: InternTable*, arena: TypeArena*,
                      owner_qname: QualifiedName, method: SymbolStr,
                      receiver: ReceiverKind,
                      params: TypeRef[], ret: TypeRef,
                      is_variadic: boolean) -> MangledName {
        return mangle_function_like(
            table, arena, "", owner_qname, method, true,
            params, ret, receiver, is_variadic);
    }

    /// Mangle a method on a generic type: `<owner_base$L<args>$G>-<method>...`.
    static for_method_generic(table: InternTable*, arena: TypeArena*,
                              owner_qname: QualifiedName, owner_generics: TypeRef[],
                              method: SymbolStr, receiver: ReceiverKind,
                              params: TypeRef[], ret: TypeRef,
                              is_variadic: boolean) -> MangledName {
        const path: string = encode_path_with_leaf_generics(
            table, arena, owner_qname, owner_generics, method, true);
        return mangle_with_path(
            table, arena, "", path, params, ret, receiver, is_variadic, true);
    }

    /// Mangle a constructor: `C$ct$<owner>-<owner_leaf>$F<params>$Rv`.
    /// The convention is that the constructor's "method name" duplicates
    /// the type's leaf segment (spec §8.9).
    static for_constructor(table: InternTable*, arena: TypeArena*,
                           owner_qname: QualifiedName,
                           params: TypeRef[], ret: TypeRef,
                           is_variadic: boolean) -> MangledName {
        const leaf: SymbolStr = owner_qname_leaf_or_intern(table, owner_qname);
        return mangle_function_like(
            table, arena, "ct", owner_qname, leaf, true,
            params, ret, ReceiverKind::None, is_variadic);
    }

    /// Mangle a destructor: `C$dt$<owner>-<owner_leaf>$F$s$Rv`.
    static for_destructor(table: InternTable*, arena: TypeArena*,
                          owner_qname: QualifiedName,
                          params: TypeRef[], ret: TypeRef) -> MangledName {
        const leaf: SymbolStr = owner_qname_leaf_or_intern(table, owner_qname);
        return mangle_function_like(
            table, arena, "dt", owner_qname, leaf, true,
            params, ret, ReceiverKind::ImmutRef, false);
    }

    /// Mangle an operator overload: `C$op$<owner>-<op_code>$F...`.
    static for_operator(table: InternTable*, arena: TypeArena*,
                        owner_qname: QualifiedName, op: OperatorKind,
                        receiver: ReceiverKind,
                        params: TypeRef[], ret: TypeRef) -> MangledName {
        const code_sym: SymbolStr = table.intern(op.code());
        return mangle_function_like(
            table, arena, "op", owner_qname, code_sym, true,
            params, ret, receiver, false);
    }

    /// Mangle a trait-impl method: `C$tr$<trait>$f<owner>-<method>$F...`.
    static for_trait_impl(table: InternTable*, arena: TypeArena*,
                          trait_qname: QualifiedName,
                          owner_qname: QualifiedName, method: SymbolStr,
                          receiver: ReceiverKind,
                          params: TypeRef[], ret: TypeRef,
                          is_variadic: boolean) -> MangledName {
        // C$tr$<trait_path>$f<owner_path>-<method>$F<params>$R<ret>
        mut buf: string = "C$tr$";
        buf = buf + encode_path(table, trait_qname, SymbolStr::empty(), false);
        buf = buf + "$f";
        buf = buf + encode_path(table, owner_qname, method, true);
        buf = buf + "$F";
        buf = buf + encode_params(table, arena, params, receiver, is_variadic);
        buf = buf + "$R";
        buf = buf + encode_type_ref(table, arena, ret);
        return MangledName { value: table.intern(buf) };
    }


    // ----------------------------------------------------------------
    // Data-symbol factories (no signature)
    // ----------------------------------------------------------------

    /// Vtable for a class: `C$vt$<path>`.
    static for_vtable(table: InternTable*, owner_qname: QualifiedName) -> MangledName {
        const path: string = encode_path(table, owner_qname, SymbolStr::empty(), false);
        return MangledName { value: table.intern("C$vt$" + path) };
    }

    /// Type info for a class: `C$ti$<path>`.
    static for_type_info(table: InternTable*, owner_qname: QualifiedName) -> MangledName {
        const path: string = encode_path(table, owner_qname, SymbolStr::empty(), false);
        return MangledName { value: table.intern("C$ti$" + path) };
    }

    /// Module initializer: `C$mi$<namespace_path>`.
    static for_module_init(table: InternTable*, ns_qname: QualifiedName) -> MangledName {
        const path: string = encode_path(table, ns_qname, SymbolStr::empty(), false);
        return MangledName { value: table.intern("C$mi$" + path) };
    }

    /// Compiler-generated closure: `C$cl$<enclosing_path>$O<index>`.
    static for_closure(table: InternTable*, enclosing_qname: QualifiedName,
                       index: u32) -> MangledName {
        const path: string = encode_path(table, enclosing_qname, SymbolStr::empty(), false);
        const idx_str: string = u64_to_decimal(index as u64);
        mut buf_cl: string = "C$cl$";
        buf_cl = buf_cl + path;
        buf_cl = buf_cl + "$O";
        buf_cl = buf_cl + idx_str;
        return MangledName { value: table.intern(buf_cl) };
    }

    /// Global variable / constant: `C$<path>` (data symbol — no signature).
    static for_global(table: InternTable*, qname: QualifiedName) -> MangledName {
        const path: string = encode_path(table, qname, SymbolStr::empty(), false);
        return MangledName { value: table.intern("C$" + path) };
    }

    /// LLVM struct type name for a Cryo type: `C$<path>`.
    /// Same shape as `for_global` since LLVM type and value namespaces
    /// are distinct; the `C$` prefix unambiguously marks Cryo origin.
    static for_struct_type(table: InternTable*, qname: QualifiedName) -> MangledName {
        const path: string = encode_path(table, qname, SymbolStr::empty(), false);
        return MangledName { value: table.intern("C$" + path) };
    }

    /// Mangled path for a generic specialization (no signature attached).
    /// `Pair<int>` → `C$4Pair$Li$G`.  Used by the monomorphizer / specializer
    /// to label instantiated structs.
    static for_generic_path(table: InternTable*, arena: TypeArena*,
                            base_qname: QualifiedName,
                            type_args: TypeRef[]) -> MangledName {
        const path: string = encode_path_with_leaf_generics(
            table, arena, base_qname, type_args, SymbolStr::empty(), false);
        mut buf: string = "C$";
        buf = buf + path;
        return MangledName { value: table.intern(buf) };
    }

    /// Centralized identifier generator for generic specializations.
    /// This is **the** way to derive a unique key for a monomorphized
    /// type / function — the specializer registers it, sema looks it up
    /// through this same call, and codegen later passes the result
    /// through `for_struct_type` for the LLVM symbol.
    ///
    /// The output is the v0.2 path-with-leaf-generics encoding, without
    /// the `C$` prefix or signature.  E.g. `Box<Monomorphizer>` →
    /// `3Box$LN$L13Monomorphizer$G$G`, `Pair<int, string>` →
    /// `4Pair$Li_S$G`.
    ///
    /// No callsite outside this module is allowed to invent its own
    /// specialization-name format.  If a future need can't be expressed
    /// here, extend this function — don't roll your own.
    static specialized_identifier(table: InternTable*, arena: TypeArena*,
                                  base_qname: QualifiedName,
                                  type_args: TypeRef[]) -> SymbolStr {
        const encoded: string = encode_path_with_leaf_generics(
            table, arena, base_qname, type_args, SymbolStr::empty(), false);
        return table.intern(encoded);
    }


    // ----------------------------------------------------------------
    // Overload disambiguator
    // ----------------------------------------------------------------

    /// Append `$O<N>` to disambiguate overloads where signatures collide
    /// (e.g., overloads differing only in return type — spec §12.5).
    with_overload_index(&this, table: InternTable*, n: u32) -> MangledName {
        const cur: string = table.resolve(this.value);
        const idx_str: string = u64_to_decimal(n as u64);
        mut buf_o: string = cur;
        buf_o = buf_o + "$O";
        buf_o = buf_o + idx_str;
        return MangledName { value: table.intern(buf_o) };
    }


    // ----------------------------------------------------------------
    // Accessors
    // ----------------------------------------------------------------

    is_empty(&this) -> boolean { return this.value.is_empty(); }
    is_valid(&this) -> boolean { return this.value.is_valid(); }
    equals(&this, other: MangledName) -> boolean { return this.value.equals(other.value); }
    resolve(&this, table: InternTable*) -> string { return table.resolve(this.value); }
}


// ============================================================================
// Internal mangling helpers
// ============================================================================

/// Common spine for function-like symbols:
///   C$[<kind>$]<path>[-<member>]$F<params>$R<ret>
function mangle_function_like(table: InternTable*, arena: TypeArena*,
                              kind_code: string,
                              owner_qname: QualifiedName,
                              member: SymbolStr, has_member: boolean,
                              params: TypeRef[], ret: TypeRef,
                              receiver: ReceiverKind,
                              is_variadic: boolean) -> MangledName {
    const path: string = encode_path(table, owner_qname, member, has_member);
    return mangle_with_path(table, arena, kind_code, path, params, ret,
                            receiver, is_variadic, true);
}

/// Same as above but with a pre-built path string (for callers that
/// need leaf-generic encoding).
function mangle_with_path(table: InternTable*, arena: TypeArena*,
                          kind_code: string, path: string,
                          params: TypeRef[], ret: TypeRef,
                          receiver: ReceiverKind, is_variadic: boolean,
                          emit_signature: boolean) -> MangledName {
    mut buf: string = "C$";
    if (strlen(kind_code) > 0) {
        buf = buf + kind_code;
        buf = buf + "$";
    }
    buf = buf + path;
    if (emit_signature) {
        buf = buf + "$F";
        buf = buf + encode_params(table, arena, params, receiver, is_variadic);
        buf = buf + "$R";
        buf = buf + encode_type_ref(table, arena, ret);
    }
    return MangledName { value: table.intern(buf) };
}

/// Encode a QualifiedName as `<seg>{.<seg>}*[-<member>]`.  Each segment
/// is length-prefixed (`<byte_len><raw>`).  If the qname is a single
/// part containing `::` sequences (the common case from
/// QualifiedName::from_symbol on a pre-joined string), it is split into
/// multiple segments.
function encode_path(table: InternTable*, qname: QualifiedName,
                     member: SymbolStr, has_member: boolean) -> string {
    mut buf: string = "";

    if (qname.is_empty()) {
        // Defensive: emit a single empty segment so the result is still
        // structurally well-formed.
        buf = "0";
    } else if (qname.depth() == 1) {
        const raw: string = table.resolve(qname.part_at(0));
        const segs: string[] = split_double_colon(raw);
        if (segs.length == 0) {
            buf = encode_ident(raw);
        } else {
            for (mut i: i64 = 0; i < segs.length; i++) {
                if (i > 0) { buf = buf + "."; }
                buf = buf + encode_ident(segs[i]);
            }
        }
    } else {
        for (mut i: i64 = 0; i < qname.depth(); i++) {
            if (i > 0) { buf = buf + "."; }
            buf = buf + encode_ident(table.resolve(qname.part_at(i)));
        }
    }

    if (has_member && member.is_valid()) {
        buf = buf + "-";
        buf = buf + encode_ident(table.resolve(member));
    }
    return buf;
}

/// Encode a path where the LAST segment carries a generic arg list.
///   Pair<int>           → 4Pair$Li$G
///   Pair<int>::new      → 4Pair$Li$G-3new
///   Math::Vec2<int>     → 4Math.4Vec2$Li$G
function encode_path_with_leaf_generics(table: InternTable*, arena: TypeArena*,
                                        qname: QualifiedName, generic_args: TypeRef[],
                                        member: SymbolStr, has_member: boolean) -> string {
    // First produce the segment list (split on "::" if needed).
    mut segs: string[] = [];
    if (qname.is_empty()) {
        segs.push("");
    } else if (qname.depth() == 1) {
        const raw: string = table.resolve(qname.part_at(0));
        const split: string[] = split_double_colon(raw);
        if (split.length == 0) {
            segs.push(raw);
        } else {
            for (mut i: i64 = 0; i < split.length; i++) {
                segs.push(split[i]);
            }
        }
    } else {
        for (mut i: i64 = 0; i < qname.depth(); i++) {
            segs.push(table.resolve(qname.part_at(i)));
        }
    }

    // Build the path, attaching $L<args>$G to the last segment if any.
    mut buf: string = "";
    const last_idx: i64 = segs.length - 1;
    for (mut i: i64 = 0; i < segs.length; i++) {
        if (i > 0) { buf = buf + "."; }
        buf = buf + encode_ident(segs[i]);
        if (i == last_idx && generic_args.length > 0) {
            buf = buf + "$L";
            for (mut j: i64 = 0; j < generic_args.length; j++) {
                if (j > 0) { buf = buf + "_"; }
                buf = buf + encode_type_ref(table, arena, generic_args[j]);
            }
            buf = buf + "$G";
        }
    }

    if (has_member && member.is_valid()) {
        buf = buf + "-";
        buf = buf + encode_ident(table.resolve(member));
    }
    return buf;
}

/// Encode a parameter list with optional receiver and variadic marker.
/// Empty list with no receiver and no variadic → literal "v".
function encode_params(table: InternTable*, arena: TypeArena*,
                       params: TypeRef[], receiver: ReceiverKind,
                       is_variadic: boolean) -> string {
    if (params.length == 0 && receiver.is_none() && !is_variadic) {
        return "v";
    }

    mut buf: string = "";
    mut first: boolean = true;

    if (!receiver.is_none()) {
        buf = buf + receiver.encode();
        first = false;
    }

    for (mut i: i64 = 0; i < params.length; i++) {
        if (!first) { buf = buf + "_"; }
        buf = buf + encode_type_ref(table, arena, params[i]);
        first = false;
    }

    if (is_variadic) {
        buf = buf + "$V";
    }
    return buf;
}

/// Encode a type by TypeRef, recursing into compound shapes via the arena.
function encode_type_ref(table: InternTable*, arena: TypeArena*,
                         ty: TypeRef) -> string {
    if (!ty.is_valid()) { return "v"; }
    const t: Type* = arena.lookup(ty.id);
    if (t == null) { return "v"; }
    return encode_type(table, arena, t);
}

/// Encode a Type* directly.  Compound types recurse via encode_type_ref.
function encode_type(table: InternTable*, arena: TypeArena*, ty: Type*) -> string {
    if (ty == null) { return "v"; }

    if (ty.kind == TypeKind::Void)   { return "v"; }
    if (ty.kind == TypeKind::Unit)   { return "u"; }
    if (ty.kind == TypeKind::Bool)   { return "b"; }
    if (ty.kind == TypeKind::Char)   { return "c"; }
    if (ty.kind == TypeKind::String) { return "S"; }
    if (ty.kind == TypeKind::Never)  { return "v"; }   // no spec code; map to void

    if (ty.kind == TypeKind::Int) {
        const it: IntType* = ty as IntType*;
        return encode_int_kind(it.int_kind);
    }
    if (ty.kind == TypeKind::Float) {
        const ft: FloatType* = ty as FloatType*;
        return encode_float_kind(ft.float_kind);
    }

    if (ty.kind == TypeKind::Pointer) {
        const p: PointerType* = ty as PointerType*;
        return "P" + encode_type_ref(table, arena, p.pointee);
    }
    if (ty.kind == TypeKind::Reference) {
        const r: ReferenceType* = ty as ReferenceType*;
        return "R" + encode_type_ref(table, arena, r.referent);
    }
    if (ty.kind == TypeKind::Array) {
        const a: ArrayType* = ty as ArrayType*;
        return "A" + encode_type_ref(table, arena, a.element);
    }
    if (ty.kind == TypeKind::Optional) {
        // Optional<T>: encode as a synthetic named generic so the form
        // is round-trippable through the demangler.
        const o: OptionalType* = ty as OptionalType*;
        const inner_o: string = encode_type_ref(table, arena, o.wrapped);
        mut buf_o: string = "N$L8Optional$L";
        buf_o = buf_o + inner_o;
        buf_o = buf_o + "$G$G";
        return buf_o;
    }

    if (ty.kind == TypeKind::Function) {
        const f: FunctionType* = ty as FunctionType*;
        const inner_params: string = encode_params(
            table, arena, f.param_types, ReceiverKind::None, f.is_variadic);
        const inner_ret: string = encode_type_ref(table, arena, f.return_type);
        mut buf_f: string = "F$L";
        buf_f = buf_f + inner_params;
        buf_f = buf_f + "$G";
        buf_f = buf_f + inner_ret;
        return buf_f;
    }

    if (ty.kind == TypeKind::Struct
     || ty.kind == TypeKind::Class
     || ty.kind == TypeKind::Enum
     || ty.kind == TypeKind::Trait
     || ty.kind == TypeKind::TypeAlias
     || ty.kind == TypeKind::FunctionTemplate) {
        const inner_n: string = encode_named_type_path(table, ty);
        mut buf_n: string = "N$L";
        buf_n = buf_n + inner_n;
        buf_n = buf_n + "$G";
        return buf_n;
    }

    if (ty.kind == TypeKind::InstantiatedType) {
        const inst: InstantiatedType* = ty as InstantiatedType*;
        return encode_instantiated(table, arena, inst);
    }

    if (ty.kind == TypeKind::GenericParam) {
        const gp: GenericParamType* = ty as GenericParamType*;
        // Should be resolved before mangling; emit the param name so any
        // leaks are easy to spot in IR rather than a silent collision.
        return "N$L" + encode_ident(table.resolve(gp.param_name)) + "$G";
    }
    if (ty.kind == TypeKind::BoundedParam) {
        const bp: BoundedParamType* = ty as BoundedParamType*;
        return "N$L" + encode_ident(table.resolve(bp.param_name)) + "$G";
    }

    // Tuple is being dropped from the language; emit a placeholder so
    // any residual usage shows up clearly in IR rather than crashing.
    if (ty.kind == TypeKind::Tuple) { return "N$L5Tuple$G"; }

    // Error / unhandled — last-resort placeholder.
    return "v";
}

/// Encode the qualified path of a named type for use INSIDE `N$L...$G`.
function encode_named_type_path(table: InternTable*, ty: Type*) -> string {
    if (ty.kind == TypeKind::Struct) {
        const s: StructType* = ty as StructType*;
        return encode_named_qname(table, s.qualified_name);
    }
    if (ty.kind == TypeKind::Class) {
        const c: ClassType* = ty as ClassType*;
        return encode_named_qname(table, c.qualified_name);
    }
    if (ty.kind == TypeKind::Enum) {
        const e: EnumType* = ty as EnumType*;
        return encode_named_qname(table, e.qualified_name);
    }
    if (ty.kind == TypeKind::Trait) {
        const tr: TraitType* = ty as TraitType*;
        return encode_named_qname(table, tr.qualified_name);
    }
    if (ty.kind == TypeKind::TypeAlias) {
        const ta: TypeAliasType* = ty as TypeAliasType*;
        return encode_named_qname(table, ta.alias_name);
    }
    if (ty.kind == TypeKind::FunctionTemplate) {
        const ft: FunctionTemplateType* = ty as FunctionTemplateType*;
        return encode_named_qname(table, ft.qualified_name);
    }
    return encode_ident("?");
}

/// Encode a single SymbolStr that may contain `::` separators as a
/// length-prefixed segment chain (`4Math.6Vector.4Vec2`).
function encode_named_qname(table: InternTable*, sym: SymbolStr) -> string {
    const raw: string = table.resolve(sym);
    const segs: string[] = split_double_colon(raw);
    if (segs.length == 0) {
        return encode_ident(raw);
    }
    mut buf: string = "";
    for (mut i: i64 = 0; i < segs.length; i++) {
        if (i > 0) { buf = buf + "."; }
        buf = buf + encode_ident(segs[i]);
    }
    return buf;
}

/// Encode an InstantiatedType as a named generic instance:
///   Pair<int>       → 4Pair$Li$G
///   Result<T, U>    → 6Result$L<T>_<U>$G
function encode_instantiated(table: InternTable*, arena: TypeArena*,
                             inst: InstantiatedType*) -> string {
    const base_t: Type* = arena.lookup(inst.generic_base.id);
    mut buf: string = "N$L";
    if (base_t == null) {
        buf = buf + encode_ident("?");
    } else {
        buf = buf + encode_named_type_path(table, base_t);
    }
    buf = buf + "$L";
    for (mut i: i64 = 0; i < inst.type_args.length; i++) {
        if (i > 0) { buf = buf + "_"; }
        buf = buf + encode_type_ref(table, arena, inst.type_args[i]);
    }
    buf = buf + "$G";
    buf = buf + "$G";
    return buf;
}

/// Length-prefix an identifier: `<byte_len><raw>` (spec §12.3 — counts bytes,
/// not code points).
function encode_ident(text: string) -> string {
    return format("%lld%s", strlen(text) as i64, text);
}

/// Convert a u64 to its decimal ASCII representation.  Used by the closure
/// index and overload disambiguator suffixes.  Goes through `snprintf` into
/// a fresh buffer so the result isn't aliased by other `format(...)` calls
/// in the same expression.
function u64_to_decimal(value: u64) -> string {
    const buf: i8* = malloc(24) as i8*;
    snprintf(buf, 24, "%llu", value);
    return buf as string;
}

function encode_int_kind(k: IntegerKind) -> string {
    return match (k) {
        IntegerKind::I8   => { "a" }
        IntegerKind::I16  => { "s" }
        IntegerKind::I32  => { "i" }
        IntegerKind::I64  => { "l" }
        // i128: not in spec; collapse to i64 code so symbols stay legal.
        IntegerKind::I128 => { "l" }
        IntegerKind::U8   => { "h" }
        IntegerKind::U16  => { "t" }
        IntegerKind::U32  => { "j" }
        IntegerKind::U64  => { "m" }
        IntegerKind::U128 => { "m" }
    };
}

function encode_float_kind(k: FloatKind) -> string {
    return match (k) {
        FloatKind::F32 => { "f" }
        FloatKind::F64 => { "d" }
    };
}

/// Split a `::`-delimited string into segments.  Empty input → empty array.
function split_double_colon(text: string) -> string[] {
    mut out: string[] = [];
    const len: i64 = strlen(text) as i64;
    if (len == 0) { return out; }

    mut start: i64 = 0;
    mut i: i64 = 0;
    while (i < len) {
        if (i + 1 < len && text[i] == ':' && text[i + 1] == ':') {
            if (i > start) {
                out.push(substr(text, start as u64, (i - start) as u64));
            }
            i = i + 2;
            start = i;
        } else {
            i++;
        }
    }
    if (start < len) {
        out.push(substr(text, start as u64, (len - start) as u64));
    }
    return out;
}

/// Returns the leaf SymbolStr of a QualifiedName.  If the qname is a
/// single part containing "::", returns the substring after the last "::"
/// re-interned.
function owner_qname_leaf_or_intern(table: InternTable*,
                                    qname: QualifiedName) -> SymbolStr {
    if (qname.is_empty()) { return SymbolStr::empty(); }
    if (qname.depth() == 1) {
        const raw: string = table.resolve(qname.part_at(0));
        const segs: string[] = split_double_colon(raw);
        if (segs.length == 0) {
            return qname.part_at(0);
        }
        return table.intern(segs[segs.length - 1]);
    }
    return qname.part_at(qname.depth() - 1);
}
