///! Generic Registry
///!
///! Unified registry for all generic/template infrastructure.  Consolidates the
///! previous GenericRegistry (instantiation cache + mono tracking) and
///! TemplateRegistry (generic AST declarations + metadata) into a single
///! source of truth.
///!
///! Three responsibilities:
///!   1. **Template storage**: Stores TemplateEntry records (AST + param
///!      metadata) for every generic declaration.  The TemplateRegistration
///!      pass populates these.
///!   2. **Instantiation cache**: When the TypeResolver encounters
///!      `Array<i32>`, it calls `instantiate(base, [i32_ref])` which
///!      deduplicates and returns a stable TypeRef.
///!   3. **Monomorphization tracking**: The Monomorphizer queries
///!      `collect_unmonomorphized()` to find instantiations that still need
///!      specialization, and marks them done via `mark_monomorphized()`.

namespace Compiler::Types::GenericRegistry;

import Compiler::AST::Node;
import std::core::option;
import Compiler::AST;
import Compiler::Types::Generic;
import Compiler::Types::Type;
import Compiler::Types;
import Compiler::Types::Arena;
import Compiler::Types::TypeRef;
import Compiler::AST::Declaration;
import Compiler::Resolver::SymbolStr;
import std::collections::pair;
import std::collections::hashmap;


// TemplateEntry: Metadata for a single generic declaration

/// All information needed to specialize a single generic type or function.
type struct TemplateEntry {
    name:           SymbolStr;           // Unqualified: "Array"
    qualified_name: SymbolStr;             // interned "std::collections::Array"
    module_name:    SymbolStr;
    param_names:    SymbolStr[];         // [intern("T"), intern("E")]
    param_type_ids: u64[];              // TypeIDs of GenericParamType objects
    param_count:    i64;
    ast_node:       ASTNode*;           // Original generic declaration
    node_kind:      NodeKind;
    base_type:      TypeRef;            // The uninstantiated generic type in arena
    impl_blocks:    ImplBlockNode*[];   // Associated impl blocks
    // True when this is a free-function template whose bare leaf name also
    // exists as a free function in another module (e.g. `read_frame` in both
    // `net::ws::frame` and `net::http2::frame`).  Set once by
    // `GenericRegistry::finalize_disambiguation()`; consulted by
    // `spec_base_name` to fold the defining module into the spec symbol so the
    // two specializations don't collapse to one (`read_frame_TcpStream`).
    module_disambig: boolean;

    /// Create a new template entry.
    static new(name: SymbolStr, qualified_name: SymbolStr, module_name: SymbolStr,
               param_names: SymbolStr[], param_type_ids: u64[],
               ast_node: ASTNode*, node_kind: NodeKind,
               base_type: TypeRef) -> TemplateEntry {
        const param_count_val: i64 = param_names.length;
        return TemplateEntry {
            name:           name,
            qualified_name: qualified_name,
            module_name:    module_name,
            param_names:    param_names,
            param_type_ids: param_type_ids,
            param_count:    param_count_val,
            ast_node:       ast_node,
            node_kind:      node_kind,
            base_type:      base_type,
            impl_blocks:    [],
            module_disambig: false,
        };
    }

    /// Spec base name for this template, used by `MangledName::specialized_identifier`
    /// keys against.  For free functions this is the bare name (`offset`); for
    /// static method templates registered under `Owner::method` it folds the
    /// owner's leaf into the bare name (`Owner_method`) so two methods with
    /// the same leaf in different owners don't collapse to a single spec
    /// symbol.  Detected by checking whether the qualified name has more
    /// segments than `module_name + "::" + name` would account for.
    spec_base_name(&this, table: InternTable*) -> SymbolStr {
        const qualified_str: string = table.resolve(this.qualified_name);
        const module_str: string = table.resolve(this.module_name);
        const name_str: string = table.resolve(this.name);
        const qualified_len: i64 = strlen(qualified_str) as i64;
        const module_len: i64 = strlen(module_str) as i64;
        const name_len: i64 = strlen(name_str) as i64;
        const expected_no_owner: i64 = if (module_len == 0) {
            name_len
        } else {
            module_len + 2 + name_len
        };
        if (qualified_len <= expected_no_owner) {
            // Free function (no owner type segment).  Normally the bare leaf
            // is a unique spec base, but two same-leaf free functions in
            // different modules (`net::ws::frame::read_frame` vs
            // `net::http2::frame::read_frame`) would otherwise collapse to one
            // spec symbol (`read_frame_TcpStream`), poisoning return-type
            // lookups.  When flagged, fold the full defining module path into
            // the base (`std_net_ws_frame_read_frame`) so each module's
            // specialization gets a distinct symbol.  Only colliding leaves are
            // flagged, so non-colliding free functions keep their bare base.
            if (this.module_disambig && module_len > 0) {
                mut folded: string = "";
                for (mut ci: i64 = 0; ci < module_len; ci += 1) {
                    if (module_str[ci] == ':') {
                        const flen: i64 = strlen(folded) as i64;
                        if (flen > 0 && folded[flen - 1] != '_') { folded += "_"; }
                    } else {
                        folded += substr(module_str, ci, 1);
                    }
                }
                return table.intern(folded + "_" + name_str);
            }
            return this.name;
        }
        // qualified = "module::Owner::name": extract `Owner` (the segment
        // immediately preceding the leaf) and prepend it to the spec base.
        const owner_start: i64 = if (module_len == 0) { 0 } else { module_len + 2 };
        const owner_end: i64 = qualified_len - 2 - name_len;
        if (owner_end <= owner_start) { return this.name; }
        // Use the LAST owner segment only; multi-segment owners (nested
        // namespaces) would produce ugly names; the immediate parent type
        // is what disambiguates same-leaf method collisions.
        mut last_sep: i64 = owner_start - 1;
        for (mut i: i64 = owner_start; i + 1 < owner_end; i += 1) {
            if (qualified_str[i] == ':' && qualified_str[i + 1] == ':') {
                last_sep = i + 1;
            }
        }
        const leaf_start: i64 = last_sep + 1;
        const owner_leaf: string = substr(
            qualified_str, leaf_start, owner_end - leaf_start);
        return table.intern(owner_leaf + "_" + name_str);
    }

    /// Return the GenericParamNode array on the underlying AST declaration.
    /// Used by default-type-parameter substitution to access each param's
    /// `default_annotation`. Returns an empty array for kinds that don't
    /// carry generic params (or null ast_node).
    get_generic_params(&this) -> GenericParamNode*[] {
        if (this.ast_node == null) { return []; }
        return match (this.node_kind) {
            NodeKind::StructDeclaration => {
                const decl: StructDeclNode* = this.ast_node as StructDeclNode*;
                decl.generic_params
            }
            NodeKind::ClassDeclaration => {
                const decl: ClassDeclNode* = this.ast_node as ClassDeclNode*;
                decl.generic_params
            }
            NodeKind::EnumDeclaration => {
                const decl: EnumDeclNode* = this.ast_node as EnumDeclNode*;
                decl.generic_params
            }
            NodeKind::FunctionDeclaration => {
                const decl: FunctionDeclNode* = this.ast_node as FunctionDeclNode*;
                decl.generic_params
            }
            NodeKind::TraitDeclaration => {
                const decl: TraitDeclNode* = this.ast_node as TraitDeclNode*;
                decl.generic_params
            }
            NodeKind::TypeAliasDeclaration => {
                const decl: TypeAliasDeclNode* = this.ast_node as TypeAliasDeclNode*;
                decl.generic_params
            }
            _ => { [] }
        };
    }
}


// GenericRegistry: Unified template + instantiation registry

type struct GenericRegistry {
    arena: TypeArena*;

    // -- Template storage --
    entries:     TemplateEntry[];
    // Secondary data arrays for TypeID->index (kept for iteration)
    tmpl_type_ids:    u64[];
    tmpl_type_indices: i64[];

    // -- HashMap indices for O(1) lookup --
    name_index: HashMap<u32, i64>;      // qualified_name SymbolStr.id -> entry index
    type_index: HashMap<u64, i64>;      // TypeID -> entry index

    // -- Instantiation cache --
    // Kept as arrays for ordered iteration in collect_unmonomorphized
    cache_keys: string[];
    cache_refs: TypeRef[];
    cache_index: HashMap<string, i64>;  // cache_key -> index in cache_refs

    // -- Monomorphization tracking --
    mono_set: HashMap<string, boolean>; // cache_key -> true

    // -- Per-module instantiation demand tracking --
    // Records which modules requested each instantiation.
    demand: Pair<string, u32>[];  // .first = cache_key, .second = SymbolStr.id of module

    // -- Trait-impl registry (Phase B.3) --
    // Maps `(trait_name, target_name)` -> ImplBlockNode*. Populated during
    // TemplateRegistration when an ImplBlockNode carries a trait_annotation.
    // Trait-impl registry: keyed by (trait_name.id << 32) | (target_name.id & 0xFFFFFFFF).
    // Ordered iteration via the array; O(1) lookup via trait_impl_index.
    trait_impls:      Pair<u64, ImplBlockNode*>[];  // .first = key, .second = impl block
    trait_impl_index:   HashMap<u64, i64>;

    // -- Trait-impl coherence index --
    // Separate from `trait_impls` because that table is keyed on bare,
    // parser-captured names and is written under several keys per node
    // (bare/canonical/legacy) and also by monomorphizer-injected spec
    // clones, so its last-wins overwrites can't distinguish a genuine
    // duplicate from a re-registration.  This index is keyed on the
    // interned CANONICAL impl-head signature (import-resolved trait + args,
    // target + args, where-bounds; impl generic params normalized) and is
    // written exactly once per source-level trait impl (see
    // `register_coherence`), so a second distinct node under the same key
    // is a true conflict — same file or across modules.  `.second` holds
    // the first node seen; it is nulled after the conflict is reported to
    // suppress duplicate diagnostics from a re-run of the pass.
    coherence_records:  Pair<u64, ImplBlockNode*>[];
    coherence_index:    HashMap<u64, i64>;

    // -- Trait-decl registry (Phase B.6) --
    // Maps a bare trait name (SymbolStr.id) to its TraitDeclNode*. Used by
    // default-method synthesis: when an impl block names a trait, we look
    // up the trait's AST to clone any default-bodied methods the impl
    // didn't override.  Populated during FunctionSignature for ALL traits
    // (generic or not); non-generic traits aren't in `entries`.
    trait_decl_index:   HashMap<u32, i64>;
    trait_decl_nodes:   TraitDeclNode*[];

    // -- Inherent-owner registry --
    // Maps a qualified type name (SymbolStr.id) to the StructDeclNode* /
    // ClassDeclNode* that owns inline generic methods on a NON-generic
    // type.  Lets `try_infer_method_call` find the AST for receivers like
    // `Request` or `Response` whose generic method declarations
    // (`parse<R>`, `write_to<W>`) live inline on the struct rather than
    // in an `implement` block; those never go through monomorphization
    // themselves and therefore have no spec_entries row to walk.
    // Populated during TemplateRegistration for any non-generic
    // struct/class that has at least one generic method (static or not).
    inherent_owner_index: HashMap<u32, i64>;
    inherent_owner_nodes: ASTNode*[];

    // Inherent (non-trait) `implement T { ... }` blocks whose target `T`
    // is NON-generic, and therefore has no TemplateEntry to hang its
    // `impl_blocks` on.  Parallel arrays: `inherent_impl_keys[i]` is the
    // target name id (both qualified and bare forms are registered,
    // mirroring `inherent_owner_*`), `inherent_impl_nodes[i]` the block.
    // Lets ownership classification see a `drop` declared in a separate
    // impl block rather than inline in the type body — without this the
    // type is wrongly treated as Copy and never dropped.
    inherent_impl_keys:  u32[];
    inherent_impl_nodes: ImplBlockNode*[];

    // Set once by `finalize_disambiguation()` so the O(N^2) leaf-collision
    // scan runs a single time even though `process_all` is invoked per module.
    disambig_finalized: boolean;


    static new(arena: TypeArena*) -> GenericRegistry {
        return GenericRegistry {
            arena:             arena,
            entries:           [],
            tmpl_type_ids:     [],
            tmpl_type_indices: [],
            name_index:        HashMap<u32, i64>::new(),
            type_index:        HashMap<u64, i64>::new(),
            cache_keys:        [],
            cache_refs:        [],
            cache_index:       HashMap<string, i64>::new(),
            mono_set:          HashMap<string, boolean>::new(),
            demand:            [],
            trait_impls:       [],
            trait_impl_index:  HashMap<u64, i64>::new(),
            coherence_records: [],
            coherence_index:   HashMap<u64, i64>::new(),
            trait_decl_index:  HashMap<u32, i64>::new(),
            trait_decl_nodes:  [],
            inherent_owner_index: HashMap<u32, i64>::new(),
            inherent_owner_nodes: [],
            inherent_impl_keys:   [],
            inherent_impl_nodes:  [],
            disambig_finalized:   false,
        };
    }

    /// One-shot pass (after all templates are registered, before any
    /// specialization) that flags free-function templates whose bare leaf name
    /// is shared by a free function in a DIFFERENT module.  Such leaves would
    /// otherwise collapse to a single spec symbol (e.g. both `ws::frame` and
    /// `http2::frame` define `read_frame`, and `read_frame<TcpStream>` would
    /// mangle to one `read_frame_TcpStream`), so `spec_base_name` folds the
    /// module path into the base only for the flagged entries.  Idempotent and
    /// guarded so the O(N^2) scan runs once across the per-module mono loop.
    finalize_disambiguation(mut &this, table: InternTable*) -> void {
        if (this.disambig_finalized) { return; }
        this.disambig_finalized = true;
        for (mut i: i64 = 0; i < this.entries.length; i += 1) {
            if (this.entries[i].node_kind != NodeKind::FunctionDeclaration) {
                continue;
            }
            // Free function only: a static method's qualified name carries an
            // owner segment, already disambiguated by `spec_base_name`.
            if (!this.is_free_function(&this.entries[i], table)) { continue; }
            if (this.entries[i].module_disambig) { continue; }
            for (mut j: i64 = i + 1; j < this.entries.length; j += 1) {
                if (this.entries[j].node_kind != NodeKind::FunctionDeclaration) {
                    continue;
                }
                if (!this.is_free_function(&this.entries[j], table)) { continue; }
                if (!this.entries[i].name.equals(this.entries[j].name)) { continue; }
                // Same leaf, different defining module: flag both.
                if (!this.entries[i].module_name.equals(this.entries[j].module_name)) {
                    this.entries[i].module_disambig = true;
                    this.entries[j].module_disambig = true;
                }
            }
        }
    }

    /// True when `entry`'s qualified name is exactly `module::name` (no owner
    /// type segment), i.e. a module-level free function rather than a static
    /// method whose qualified name is `module::Owner::name`.
    is_free_function(&this, entry: TemplateEntry*, table: InternTable*) -> boolean {
        const qualified_str: string = table.resolve(entry.qualified_name);
        const module_str: string = table.resolve(entry.module_name);
        const name_str: string = table.resolve(entry.name);
        const module_len: i64 = strlen(module_str) as i64;
        const name_len: i64 = strlen(name_str) as i64;
        const expected: i64 = if (module_len == 0) {
            name_len
        } else {
            module_len + 2 + name_len
        };
        return (strlen(qualified_str) as i64) <= expected;
    }


    //  Template registration & lookup

    /// Register a template entry.  Deduplicates by qualified_name;
    /// if an entry with the same name exists, it is overwritten.
    register_template(mut &this, entry: TemplateEntry) -> void {
        // Capture the Copy fields before `entry` is moved into the store.
        const qname_id:  u32     = entry.qualified_name.id;
        const base_type: TypeRef = entry.base_type;
        const h: u64 = hash_int(qname_id as u64);
        const existing: Option<i64> = this.name_index.get(&qname_id);

        if (existing.is_some()) {
            // Overwrite existing
            const i: i64 = existing.unwrap();
            this.entries[i] = entry;
            if (base_type.is_valid()) {
                this.update_type_index(base_type.id, i);
            }
            return;
        }

        // New entry
        const idx: i64 = this.entries.length;
        this.entries.push(entry);
        this.name_index.insert(qname_id, idx);

        if (base_type.is_valid()) {
            this.tmpl_type_ids.push(base_type.id);
            this.tmpl_type_indices.push(idx);
            this.type_index.insert(base_type.id, idx);
        }
    }

    /// Associate an impl block with a registered template.
    /// Caller must provide the qualified name of the target type.
    /// Uses pointer-based access to avoid value-copy semantics on the
    /// array subscript; without this, push() would modify a temporary.
    register_impl_block(mut &this, qualified_name: SymbolStr, block: ImplBlockNode*) -> void {
        const h: u64 = hash_int(qualified_name.id as u64);
        const opt: Option<i64> = this.name_index.get(&qualified_name.id);
        if (opt.is_some()) {
            const idx: i64 = opt.unwrap();
            mut entry_ptr: TemplateEntry* = &this.entries[idx];
            entry_ptr.impl_blocks.push(block);
        }
    }

    /// Record an inherent (non-trait) impl block under a target name so
    /// ownership classification can find a `drop` (or other method)
    /// declared in a separate `implement T { ... }` block on a NON-generic
    /// type.  Generic targets already capture their blocks on the
    /// TemplateEntry; this is the fallback for the template-less case.
    /// Callers register under both the qualified and bare names.
    register_inherent_impl_block(mut &this, name: SymbolStr,
                                 block: ImplBlockNode*) -> void {
        if (block == null || !name.is_valid()) { return; }
        this.inherent_impl_keys.push(name.id);
        this.inherent_impl_nodes.push(block);
    }

    /// True when any inherent impl block registered under `name` declares a
    /// method named `method_sym`.  Linear scan: the inherent-impl set is
    /// small and this is only consulted on the ownership slow path.
    inherent_impl_has_method(&this, name: SymbolStr,
                             method_sym: SymbolStr) -> boolean {
        if (!name.is_valid() || !method_sym.is_valid()) { return false; }
        for (mut i: i64 = 0; i < this.inherent_impl_keys.length; i++) {
            if (this.inherent_impl_keys[i] != name.id) { continue; }
            const ib: ImplBlockNode* = this.inherent_impl_nodes[i];
            if (ib == null) { continue; }
            for (mut j: i64 = 0; j < ib.methods.length; j++) {
                const m: MethodNode* = ib.methods[j];
                if (m == null || m.func == null) { continue; }
                if (m.func.name.equals(method_sym)) { return true; }
            }
        }
        return false;
    }

    /// Pack a `(trait_name, target_name)` pair into a single u64 key. Both
    /// SymbolStr ids fit in the lower/upper 32-bit halves so collisions are
    /// only possible when two pairs alias both ids, which is practically zero.
    static trait_impl_key(trait_name: SymbolStr, target_name: SymbolStr) -> u64 {
        return ((trait_name.id as u64) << 32) | ((target_name.id as u64) & 0xFFFFFFFF);
    }

    /// Register a trait-impl block (`implement trait Foo for Bar { ... }`).
    /// Indexed by the bare names of the trait and target, both as the parser
    /// captured them. Cross-module resolution and qualified-name handling
    /// remain B.4 work; for now this gives downstream sema a fast lookup
    /// for the common single-module case.
    register_trait_impl(mut &this, trait_name: SymbolStr, target_name: SymbolStr,
                        block: ImplBlockNode*) -> void {
        if (block == null) { return; }
        if (!trait_name.is_valid() || !target_name.is_valid()) { return; }
        const key: u64 = GenericRegistry::trait_impl_key(trait_name, target_name);
        const h: u64 = hash_int(key);
        const existing: Option<i64> = this.trait_impl_index.get(&key);
        if (existing.is_some()) {
            // Latest impl wins; matches register_template's overwrite policy.
            const idx: i64 = existing.unwrap();
            this.trait_impls[idx].second = block;
            return;
        }
        const idx: i64 = this.trait_impls.length;
        this.trait_impls.push(Pair::new(key, block));
        this.trait_impl_index.insert(key, idx);
    }

    /// Trait-impl coherence: record the first source-level trait impl seen
    /// for a canonical impl-head key and report a collision when a second,
    /// distinct impl arrives.  Returns the PRIOR impl node on the first
    /// conflict for a key (caller emits E0308), otherwise null (first
    /// registration, same node re-seen, or an already-reported key).
    ///
    /// `key` is the interned canonical impl-head signature built by
    /// `TypeResolutionPasses::coherence_key_for`: the import-resolved trait
    /// reference (with type args), the import-resolved target type (with
    /// type args), and the where-bounds, with the impl's own generic params
    /// normalized to positional markers.  Two impls collide iff their full
    /// heads are structurally identical, so (a) same-leaf types in different
    /// modules stay distinct, (b) an impl on an imported type collides with
    /// the type's home-module impl, (c) `From<i8>` and `From<i16>` for one
    /// type stay distinct, and (d) bound-differentiated impls stay distinct.
    /// After the first conflict the stored node is nulled, so a re-run of
    /// the registering pass — or a third impl of the same key — does not
    /// double-report.
    register_coherence(mut &this, key_sym: SymbolStr,
                       node: ImplBlockNode*) -> ImplBlockNode* {
        if (node == null || !key_sym.is_valid()) { return null; }
        const key: u64 = key_sym.id as u64;
        const existing: Option<i64> = this.coherence_index.get(&key);
        if (existing.is_none()) {
            const idx: i64 = this.coherence_records.length;
            this.coherence_records.push(Pair::new(key, node));
            this.coherence_index.insert(key, idx);
            return null;
        }
        const idx: i64 = existing.unwrap();
        const prior: ImplBlockNode* = this.coherence_records[idx].second;
        if (prior == null || prior == node) { return null; }
        // First genuine conflict for this key: hand the prior node back to
        // the caller and clear the slot so later passes/impls stay quiet.
        this.coherence_records[idx].second = null;
        return prior;
    }

    /// Look up the impl block for a `(trait, target)` pair. Returns null
    /// when no impl is registered.
    lookup_trait_impl(&this, trait_name: SymbolStr, target_name: SymbolStr) -> ImplBlockNode* {
        if (!trait_name.is_valid() || !target_name.is_valid()) { return null; }
        const key: u64 = GenericRegistry::trait_impl_key(trait_name, target_name);
        const opt: Option<i64> = this.trait_impl_index.get(&key);
        if (opt.is_some()) {
            return this.trait_impls[opt.unwrap()].second;
        }
        return null;
    }

    /// Number of registered trait impls. Useful for debug prints and tests.
    trait_impl_count(&this) -> i64 {
        return this.trait_impls.length;
    }

    /// Return the list of trait names for which `target_name` has a
    /// registered impl. Linear scan, acceptable while the trait-impl
    /// table remains small. Used by sema to resolve calls to default
    /// trait methods on a concrete type that doesn't define them inline.
    traits_implemented_by(&this, target_name: SymbolStr) -> SymbolStr[] {
        mut result: SymbolStr[] = [];
        if (!target_name.is_valid()) { return result; }
        const target_lo: u64 = (target_name.id as u64) & 0xFFFFFFFF;
        for (mut i: i64 = 0; i < this.trait_impls.length; i++) {
            const key: u64 = this.trait_impls[i].first;
            if ((key & 0xFFFFFFFF) != target_lo) { continue; }
            const trait_id: u32 = (key >> 32) as u32;
            result.push(SymbolStr::from_id(trait_id));
        }
        return result;
    }

    /// Register a trait declaration's AST so default-method synthesis can
    /// find it cross-module when an impl block names the trait. Idempotent:
    /// later calls with the same bare name overwrite earlier ones.
    register_trait_decl(mut &this, name: SymbolStr, node: TraitDeclNode*) -> void {
        if (node == null || !name.is_valid()) { return; }
        const h: u64 = hash_int(name.id as u64);
        const existing: Option<i64> = this.trait_decl_index.get(&name.id);
        if (existing.is_some()) {
            this.trait_decl_nodes[existing.unwrap()] = node;
            return;
        }
        const idx: i64 = this.trait_decl_nodes.length;
        this.trait_decl_nodes.push(node);
        this.trait_decl_index.insert(name.id, idx);
    }

    /// Look up a trait declaration's AST by bare name. Returns null when the
    /// trait wasn't registered, most commonly because it's in a module
    /// that hasn't been processed yet.
    get_trait_decl(&this, name: SymbolStr) -> TraitDeclNode* {
        if (!name.is_valid()) { return null; }
        const h: u64 = hash_int(name.id as u64);
        const opt: Option<i64> = this.trait_decl_index.get(&name.id);
        if (opt.is_some()) {
            return this.trait_decl_nodes[opt.unwrap()];
        }
        return null;
    }

    /// Walk all registered trait decls looking for one that defines a
    /// method named `method_name`. Returns the trait's bare name, or
    /// `SymbolStr::empty()` when no trait declares the method. Used by
    /// sema to render an actionable hint on "no method found" errors:
    /// `note: method 'X' is defined on trait 'Y'`. Linear scan, fine
    /// while trait counts stay small (dozens, not thousands).
    find_trait_defining_method(&this, method_name: SymbolStr) -> SymbolStr {
        if (!method_name.is_valid()) { return SymbolStr::empty(); }
        for (mut i: i64 = 0; i < this.trait_decl_nodes.length; i++) {
            const td: TraitDeclNode* = this.trait_decl_nodes[i];
            if (td == null) { continue; }
            for (mut mi: i64 = 0; mi < td.methods.length; mi++) {
                const m: FunctionDeclNode* = td.methods[mi];
                if (m != null && m.name.equals(method_name)) {
                    return td.name;
                }
            }
        }
        return SymbolStr::empty();
    }

    /// Register a non-generic struct/class declaration as an "inherent
    /// owner": a type whose inline `methods[]` array carries one or
    /// more generic methods.  Indexed by qualified-name SymbolStr.id so
    /// inference paths can recover the AST from a receiver TypeRef via
    /// the arena's qualified name. Idempotent: the latest registration
    /// wins (matches register_template's overwrite policy).
    register_inherent_owner(mut &this, qualified_name: SymbolStr,
                             node: ASTNode*) -> void {
        if (node == null || !qualified_name.is_valid()) { return; }
        const h: u64 = hash_int(qualified_name.id as u64);
        const existing: Option<i64> = this.inherent_owner_index.get(&qualified_name.id);
        if (existing.is_some()) {
            this.inherent_owner_nodes[existing.unwrap()] = node;
            return;
        }
        const idx: i64 = this.inherent_owner_nodes.length;
        this.inherent_owner_nodes.push(node);
        this.inherent_owner_index.insert(qualified_name.id, idx);
    }

    /// Look up an inherent-owner AST by qualified name. Returns null
    /// when nothing matches, most commonly because the receiver type
    /// is generic (those go through spec_entries instead) or the type
    /// has no inline generic methods to register.
    lookup_inherent_owner(&this, qualified_name: SymbolStr) -> ASTNode* {
        if (!qualified_name.is_valid()) { return null; }
        const h: u64 = hash_int(qualified_name.id as u64);
        const opt: Option<i64> = this.inherent_owner_index.get(&qualified_name.id);
        if (opt.is_some()) {
            return this.inherent_owner_nodes[opt.unwrap()];
        }
        return null;
    }

    /// Look up a template entry by qualified name.  The single lookup path.
    get_template(&this, qualified_name: SymbolStr) -> TemplateEntry* {
        const opt: Option<i64> = this.name_index.get(&qualified_name.id);
        if (opt.is_some()) {
            return &this.entries[opt.unwrap()];
        }
        return null;
    }

    /// Look up a template entry by its base TypeID.  Used by the Monomorphizer
    /// since InstantiatedType stores the base type's ID, not its name.
    get_template_by_type_id(&this, type_id: u64) -> TemplateEntry* {
        const opt: Option<i64> = this.type_index.get(&type_id);
        if (opt.is_some()) {
            return &this.entries[opt.unwrap()];
        }
        return null;
    }

    /// Check whether a TypeID corresponds to a registered template.
    is_template(&this, type_id: u64) -> boolean {
        return this.type_index.contains_key(&type_id);
    }

    /// Number of registered templates.
    template_count(&this) -> i64 {
        return this.entries.length;
    }


    //  Instantiation cache

    /// Get or create an InstantiatedType for the given base + type args.
    /// Deduplicates via string key so the same instantiation always returns
    /// the same TypeRef.
    instantiate(mut &this, base: TypeRef, args: &TypeRef[]) -> TypeRef {
        const key: string = this.make_cache_key(base, args);
        const h: u64 = hash_str(key);

        const cached: Option<i64> = this.cache_index.get(&key);
        if (cached.is_some()) {
            return this.cache_refs[cached.unwrap()];
        }

        // Cache miss: create new InstantiatedType
        const inst: TypeRef = this.arena.create_instantiation(base, args);
        const idx: i64 = this.cache_keys.length;
        this.cache_keys.push(key);
        this.cache_refs.push(inst);
        this.cache_index.insert(key, idx);
        return inst;
    }


    /// Like instantiate(), but also records which module requested it.
    /// Used by TypeResolution to track per-module demand for codegen.
    instantiate_for_module(mut &this, base: TypeRef, args: &TypeRef[],
                           module: SymbolStr) -> TypeRef {
        const result: TypeRef = this.instantiate(base, args);
        // Record the demand regardless of cache hit; a module that uses
        // an already-cached instantiation still needs it available at codegen.
        const key: string = this.make_cache_key(base, args);
        this.demand.push(Pair<string, u32>::new(key, module.id));
        return result;
    }

    /// Get all modules that requested a specific instantiation.
    get_modules_using(&this, cache_key: string) -> SymbolStr[] {
        mut result: SymbolStr[] = [];
        for (mut i: i64 = 0; i < this.demand.length; i++) {
            if (strcmp(this.demand[i].first, cache_key) == 0) {
                const sym: SymbolStr = SymbolStr::from_id(this.demand[i].second);
                // Deduplicate: skip if already in result
                mut found: boolean = false;
                for (mut j: i64 = 0; j < result.length; j++) {
                    if (result[j].id == sym.id) {
                        found = true;
                    }
                }
                if (!found) {
                    result.push(sym);
                }
            }
        }
        return result;
    }


    //  Monomorphization tracking

    /// Check if an instantiation has already been monomorphized.
    is_monomorphized(&this, base: TypeRef, args: &TypeRef[]) -> boolean {
        const key: string = this.make_cache_key(base, args);
        return this.mono_set.contains_key(&key);
    }

    /// Mark an instantiation as monomorphized (specialization completed).
    mark_monomorphized(mut &this, base: TypeRef, args: &TypeRef[]) -> void {
        const key: string = this.make_cache_key(base, args);
        const h: u64 = hash_str(key);
        if (!this.mono_set.contains_key(&key)) {
            this.mono_set.insert(key, true);
        }
    }

    /// Collect all cached instantiations that have not yet been monomorphized.
    /// Returns the TypeRefs of unprocessed InstantiatedTypes.
    collect_unmonomorphized(&this) -> TypeRef[] {
        mut result: TypeRef[] = [];
        for (mut i: i64 = 0; i < this.cache_keys.length; i++) {
            const key: string = this.cache_keys[i];
            if (!this.mono_set.contains_key(&key)) {
                result.push(this.cache_refs[i]);
            }
        }
        return result;
    }

    /// Number of cached instantiations.
    cache_count(&this) -> i64 {
        return this.cache_keys.length;
    }

    /// Number of monomorphized instantiations.
    mono_count(&this) -> i64 {
        return this.mono_set.length() as i64;
    }

    make_cache_key(&this, base: TypeRef, args: &TypeRef[]) -> string {
        mut key: string = format("%llu<", base.id);
        for (mut i: i64 = 0; i < args.length; i++) {
            if (i > 0) {
                key += ",";
            }
            key += format("%llu", args[i].id);
        }
        key += ">";
        return key;
    }

    /// Update the secondary TypeID index for an existing entry.
    update_type_index(mut &this, type_id: u64, entry_idx: i64) -> void {
        const h: u64 = hash_int(type_id);
        // Update or insert in HashMap
        this.type_index.insert(type_id, entry_idx);
        // Also update parallel arrays for consistency
        for (mut i: i64 = 0; i < this.tmpl_type_ids.length; i++) {
            if (this.tmpl_type_ids[i] == type_id) {
                this.tmpl_type_indices[i] = entry_idx;
                return;
            }
        }
        // Not found: add new mapping
        this.tmpl_type_ids.push(type_id);
        this.tmpl_type_indices.push(entry_idx);
    }
}
