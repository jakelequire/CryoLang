///! Compound Types
///!
///! The payloads of pointer, reference, array, function, tuple, and optional
///! types.  These wrap other types (via TypeRef handles) and are deduplicated
///! by the arena.
///!
///! NOTE: display_name() on compound types returns raw TypeRef IDs as fallback.
///! For human-readable names, use TypeArena::format_display(ty) which resolves
///! inner type references through the arena.

namespace compiler::types::compound;

import compiler::types::type_ref::{ TypeRef };
import compiler::types::{ RefMutability };
import compiler::ast::{ ObjectForm };
import compiler::resolver::res::{ DefId };
import std::fmt;


// ObjectType: a trait object, `virtual &Shape`

/// A value of any type implementing a trait, reached through a table of the
/// trait's methods: the address of the value and the address of its table.
/// It is a type kind of its own, never a pointer or a reference, so a
/// consumer that knows only those refuses it.  `trait_type` is the trait's
/// type; `args` bind the trait's parameters, then its associated types, in
/// declaration order.
type struct ObjectType {
    trait_def:  DefId;
    trait_type: TypeRef;
    args:       [TypeRef];
    form:       ObjectForm;

    static new(trait_def: DefId, trait_type: TypeRef, args: [TypeRef], form: ObjectForm) -> ObjectType* {
        return new ObjectType { trait_def: trait_def, trait_type: trait_type, args: args, form: form };
    }

    display_name(&this) -> string {
        return this.form.spell(fmt::format("%lu", this.trait_type.key()));
    }
}


// PointerType: Raw pointer to another type

type struct PointerType {
    pointee: TypeRef;
    /// `true` for `const T*` (pointee is const). ABI-identical to a plain
    /// pointer and excluded from mangling; only the type-checker reads it to
    /// forbid implicitly dropping const.
    const_pointee: boolean;

    static new(pointee: TypeRef, const_pointee: boolean) -> PointerType* {
        return new PointerType { pointee: pointee, const_pointee: const_pointee };
    }

    display_name(&this) -> string {
        if (this.const_pointee) {
            return fmt::format("const %lu*", this.pointee.key());
        }
        return fmt::format("%lu*", this.pointee.key());
    }
}


// ReferenceType: Borrowed reference (immutable or mutable)

type struct ReferenceType {
    referent:   TypeRef;
    mutability: RefMutability;

    static new(referent: TypeRef, mutability: RefMutability) -> ReferenceType* {
        return new ReferenceType { referent: referent, mutability: mutability };
    }

    is_mutable(&this) -> boolean {
        return this.mutability.is_mutable();
    }

    display_name(&this) -> string {
        // Cryo spells a mutable reference `mut &T`, not `&mut T`.
        if (this.is_mutable()) {
            return fmt::format("mut &%lu", this.referent.key());
        }
        return fmt::format("&%lu", this.referent.key());
    }
}


// ArrayType: the fixed array `[T; N]`.  The dynamic `[T]` is `Array<T>`.

type struct ArrayType {
    element:        TypeRef;
    size:           i64;
    computed_size:  u64;       // Computed by the TypeLowering pass
    computed_align: u64;

    static new(element: TypeRef, size: i64) -> ArrayType* {
        return new ArrayType { element: element, size: size, computed_size: 0, computed_align: 0 };
    }

    /// The type as a program writes it, `[T; N]`, around the text
    /// `element_text` its caller wrote for the element.
    spelled(&this, element_text: string) -> string {
        return "[" + element_text + "; " + fmt::format("%ld", this.size) + "]";
    }

    display_name(&this) -> string {
        return fmt::format("%lu[%ld]", this.element.key(), this.size);
    }

    set_layout(mut &this, size: u64, align: u64) -> void {
        this.computed_size  = size;
        this.computed_align = align;
    }
}


// FunctionType: Function signature

type struct FunctionType {
    return_type: TypeRef;
    param_types: [TypeRef];
    is_variadic: boolean;

    static new(return_type: TypeRef, param_types: [TypeRef], is_variadic: boolean) -> FunctionType* {
        return new FunctionType {
            return_type: return_type,
            param_types: param_types,
            is_variadic: is_variadic,
        };
    }

    display_name(&this) -> string {
        mut result: string = "(";
        for (mut i: i64 = 0; i < this.param_types.length(); i++) {
            if (i > 0) {
                result += ", ";
            }
            result = fmt::format("%s%lu", result, this.param_types[i].key());
        }
        if (this.is_variadic) {
            if (this.param_types.length() > 0) {
                result += ", ";
            }
            result += "...";
        }
        result = fmt::format("%s) -> %lu", result, this.return_type.key());
        return result;
    }
}


// TupleType: Heterogeneous fixed-size collection

type struct TupleType {
    elements:       [TypeRef];
    computed_size:  u64;
    computed_align: u64;

    static new(elements: [TypeRef]) -> TupleType* {
        return new TupleType { elements: elements, computed_size: 0, computed_align: 0 };
    }

    display_name(&this) -> string {
        mut result: string = "(";
        for (mut i: i64 = 0; i < this.elements.length(); i++) {
            if (i > 0) {
                result += ", ";
            }
            result = fmt::format("%s%lu", result, this.elements[i].key());
        }
        result += ")";
        return result;
    }

    set_layout(mut &this, size: u64, align: u64) -> void {
        this.computed_size  = size;
        this.computed_align = align;
    }
}


// OptionalType: Nullable wrapper (T?)

type struct OptionalType {
    wrapped:        TypeRef;
    computed_size:  u64;
    computed_align: u64;

    static new(wrapped: TypeRef) -> OptionalType* {
        return new OptionalType { wrapped: wrapped, computed_size: 0, computed_align: 0 };
    }

    display_name(&this) -> string {
        return fmt::format("%lu?", this.wrapped.key());
    }

    set_layout(mut &this, size: u64, align: u64) -> void {
        this.computed_size  = size;
        this.computed_align = align;
    }
}
