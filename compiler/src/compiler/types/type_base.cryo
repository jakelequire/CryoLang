///! The Type
///!
///! Every type is a `Type`: its id, its kind and its data.  A primitive's data
///! is the variant alone (or its integer or float kind); every other kind's
///! data points at the payload struct that holds its fields, declared in
///! `compound`, `generic` or `user_defined`.  Each Type is owned by a TypeArena
///! and referenced through TypeRef handles.

namespace compiler::types::type_base;

import compiler::types;
import compiler::types::{ FloatKind, IntegerKind, TypeKind };
import compiler::types::type_ref;
import compiler::types::compound::{
    ArrayType, FunctionType, ObjectType, OptionalType, PointerType, ReferenceType, TupleType
};
import compiler::types::generic::{
    AssocProjectionType, GenericParamType, InstantiatedType
};
import compiler::types::user_defined::{
    EnumType, FunctionTemplateType, StructType, TraitType, TypeAliasType
};


/// What a type is, one variant per `TypeKind`.  A `string` is a
/// null-terminated `i8*` (`type_map.cryo`'s `map_string`), and a `va_list` is
/// passed as one pointer on every supported ABI, so both are 8 bytes: the
/// size reported here must match the lowering, or struct layout puts field
/// offsets where LLVM's GEP stride does not.
type enum TypeData {
    Void;
    Unit;
    Bool;
    Char;
    String;
    Never;
    VaList;
    Int(IntegerKind);
    Float(FloatKind);
    Pointer(PointerType*);
    Reference(ReferenceType*);
    Array(ArrayType*);
    Function(FunctionType*);
    Tuple(TupleType*);
    Optional(OptionalType*);
    Object(ObjectType*);
    Struct(StructType*);
    Enum(EnumType*);
    Trait(TraitType*);
    TypeAlias(TypeAliasType*);
    GenericParam(GenericParamType*);
    Instantiated(InstantiatedType*);
    AssocProjection(AssocProjectionType*);
    FunctionTemplate(FunctionTemplateType*);
    Error;
}

implement enum TypeData {
    /// The kind this data is.
    kind(&this) -> TypeKind {
        return match (this) {
            TypeData::Void                => { TypeKind::Void }
            TypeData::Unit                => { TypeKind::Unit }
            TypeData::Bool                => { TypeKind::Bool }
            TypeData::Char                => { TypeKind::Char }
            TypeData::String              => { TypeKind::String }
            TypeData::Never               => { TypeKind::Never }
            TypeData::VaList              => { TypeKind::VaList }
            TypeData::Int(_)              => { TypeKind::Int }
            TypeData::Float(_)            => { TypeKind::Float }
            TypeData::Pointer(_)          => { TypeKind::Pointer }
            TypeData::Reference(_)        => { TypeKind::Reference }
            TypeData::Array(_)            => { TypeKind::Array }
            TypeData::Function(_)         => { TypeKind::Function }
            TypeData::Tuple(_)            => { TypeKind::Tuple }
            TypeData::Optional(_)         => { TypeKind::Optional }
            TypeData::Object(_)           => { TypeKind::Object }
            TypeData::Struct(_)           => { TypeKind::Struct }
            TypeData::Enum(_)             => { TypeKind::Enum }
            TypeData::Trait(_)            => { TypeKind::Trait }
            TypeData::TypeAlias(_)        => { TypeKind::TypeAlias }
            TypeData::GenericParam(_)     => { TypeKind::GenericParam }
            TypeData::Instantiated(_)     => { TypeKind::InstantiatedType }
            TypeData::AssocProjection(_)  => { TypeKind::AssocProjection }
            TypeData::FunctionTemplate(_) => { TypeKind::FunctionTemplate }
            TypeData::Error               => { TypeKind::Error }
        };
    }
}


/// A type: its arena id, its kind, and the data of that kind.  `kind` is
/// always `data.kind()`; `Type::new` is the one place it is set.
///
/// The `as_*` accessors read the payload of the one kind they name.  The
/// caller has established the kind; asking a type for another kind's
/// payload is a compiler defect and stops the compilation.
type struct Type {
    id:   u64;
    kind: TypeKind;
    data: TypeData;

    /// A type with `data`, at arena id `id`.
    static new(id: u64, data: TypeData) -> Type* {
        return new Type { id: id, kind: data.kind(), data: data };
    }

    /// Human-readable display name (e.g., "i32", "string", "MyStruct").
    display_name(&this) -> string {
        return match (this.data) {
            TypeData::Void                => { "void" }
            TypeData::Unit                => { "()" }
            TypeData::Bool                => { "boolean" }
            TypeData::Char                => { "char" }
            TypeData::String              => { "string" }
            TypeData::Never               => { "never" }
            TypeData::VaList              => { "va_list" }
            TypeData::Int(k)              => { k.to_string() }
            TypeData::Float(k)            => { k.to_string() }
            TypeData::Pointer(p)          => { p.display_name() }
            TypeData::Reference(p)        => { p.display_name() }
            TypeData::Array(p)            => { p.display_name() }
            TypeData::Function(p)         => { p.display_name() }
            TypeData::Tuple(p)            => { p.display_name() }
            TypeData::Optional(p)         => { p.display_name() }
            TypeData::Object(p)           => { p.display_name() }
            TypeData::Struct(p)           => { p.display_name() }
            TypeData::Enum(p)             => { p.display_name() }
            TypeData::Trait(p)            => { p.display_name() }
            TypeData::TypeAlias(p)        => { p.display_name() }
            TypeData::GenericParam(p)     => { p.display_name() }
            TypeData::Instantiated(p)     => { p.display_name() }
            TypeData::AssocProjection(p)  => { p.display_name() }
            TypeData::FunctionTemplate(p) => { p.display_name() }
            TypeData::Error               => { "<error>" }
        };
    }

    /// Size of this type in bytes (0 for void/unit/never/unresolved).
    size_bytes(&this) -> u64 {
        return match (this.data) {
            TypeData::Void                => { 0 }
            TypeData::Unit                => { 0 }
            TypeData::Bool                => { 1 }
            TypeData::Char                => { 4 }
            TypeData::String              => { 8 }
            TypeData::Never               => { 0 }
            TypeData::VaList              => { 8 }
            TypeData::Int(k)              => { k.byte_size() }
            TypeData::Float(k)            => { k.byte_size() }
            TypeData::Pointer(_)          => { 8 }
            TypeData::Reference(_)        => { 8 }
            TypeData::Array(p)            => { p.computed_size }
            TypeData::Function(_)         => { 8 }
            TypeData::Tuple(p)            => { p.computed_size }
            TypeData::Optional(p)         => { p.computed_size }
            TypeData::Object(_)           => { 16 }
            TypeData::Struct(p)           => { p.computed_size }
            TypeData::Enum(p)             => { p.computed_size }
            TypeData::Trait(_)            => { 0 }
            TypeData::TypeAlias(p)        => { p.computed_size }
            TypeData::GenericParam(_)     => { 0 }
            TypeData::Instantiated(p)     => { p.computed_size }
            TypeData::AssocProjection(_)  => { 0 }
            TypeData::FunctionTemplate(_) => { 0 }
            TypeData::Error               => { 0 }
        };
    }

    /// Alignment of this type in bytes.  A nominal aggregate whose layout is
    /// not computed yet reports 1.
    alignment(&this) -> u64 {
        return match (this.data) {
            TypeData::Void                => { 0 }
            TypeData::Unit                => { 1 }
            TypeData::Bool                => { 1 }
            TypeData::Char                => { 4 }
            TypeData::String              => { 8 }
            TypeData::Never               => { 0 }
            TypeData::VaList              => { 8 }
            TypeData::Int(k)              => { k.byte_size() }
            TypeData::Float(k)            => { k.byte_size() }
            TypeData::Pointer(_)          => { 8 }
            TypeData::Reference(_)        => { 8 }
            TypeData::Array(p)            => { p.computed_align }
            TypeData::Function(_)         => { 8 }
            TypeData::Tuple(p)            => { p.computed_align }
            TypeData::Optional(p)         => { p.computed_align }
            TypeData::Object(_)           => { 8 }
            TypeData::Struct(p)           => { Type::at_least_one(p.computed_align) }
            TypeData::Enum(p)             => { Type::at_least_one(p.computed_align) }
            TypeData::Trait(_)            => { 0 }
            TypeData::TypeAlias(p)        => { p.computed_align }
            TypeData::GenericParam(_)     => { 0 }
            TypeData::Instantiated(p)     => { p.computed_align }
            TypeData::AssocProjection(_)  => { 0 }
            TypeData::FunctionTemplate(_) => { 0 }
            TypeData::Error               => { 0 }
        };
    }

    static at_least_one(align: u64) -> u64 {
        if (align > 0) { return align; }
        return 1;
    }

    /// Whether this type is a numeric type (int or float).
    is_numeric(&this) -> boolean {
        return this.kind.is_numeric();
    }

    /// Whether this type is an error placeholder.
    is_error(&this) -> boolean {
        return this.kind.is_error();
    }

    int_kind(&this) -> IntegerKind {
        match (this.data) {
            TypeData::Int(k) => { return k; }
            _ => { unreachable(); }
        }
    }

    float_kind(&this) -> FloatKind {
        match (this.data) {
            TypeData::Float(k) => { return k; }
            _ => { unreachable(); }
        }
    }

    as_pointer(&this) -> PointerType* {
        match (this.data) {
            TypeData::Pointer(p) => { return p; }
            _ => { unreachable(); }
        }
    }

    as_reference(&this) -> ReferenceType* {
        match (this.data) {
            TypeData::Reference(p) => { return p; }
            _ => { unreachable(); }
        }
    }

    as_object(&this) -> ObjectType* {
        match (this.data) {
            TypeData::Object(p) => { return p; }
            _ => { unreachable(); }
        }
    }

    as_array(&this) -> ArrayType* {
        match (this.data) {
            TypeData::Array(p) => { return p; }
            _ => { unreachable(); }
        }
    }

    as_function(&this) -> FunctionType* {
        match (this.data) {
            TypeData::Function(p) => { return p; }
            _ => { unreachable(); }
        }
    }

    as_tuple(&this) -> TupleType* {
        match (this.data) {
            TypeData::Tuple(p) => { return p; }
            _ => { unreachable(); }
        }
    }

    as_optional(&this) -> OptionalType* {
        match (this.data) {
            TypeData::Optional(p) => { return p; }
            _ => { unreachable(); }
        }
    }

    as_struct(&this) -> StructType* {
        match (this.data) {
            TypeData::Struct(p) => { return p; }
            _ => { unreachable(); }
        }
    }

    as_enum(&this) -> EnumType* {
        match (this.data) {
            TypeData::Enum(p) => { return p; }
            _ => { unreachable(); }
        }
    }

    as_trait(&this) -> TraitType* {
        match (this.data) {
            TypeData::Trait(p) => { return p; }
            _ => { unreachable(); }
        }
    }

    as_alias(&this) -> TypeAliasType* {
        match (this.data) {
            TypeData::TypeAlias(p) => { return p; }
            _ => { unreachable(); }
        }
    }

    as_generic_param(&this) -> GenericParamType* {
        match (this.data) {
            TypeData::GenericParam(p) => { return p; }
            _ => { unreachable(); }
        }
    }

    as_instantiated(&this) -> InstantiatedType* {
        match (this.data) {
            TypeData::Instantiated(p) => { return p; }
            _ => { unreachable(); }
        }
    }

    as_assoc_projection(&this) -> AssocProjectionType* {
        match (this.data) {
            TypeData::AssocProjection(p) => { return p; }
            _ => { unreachable(); }
        }
    }

    as_function_template(&this) -> FunctionTemplateType* {
        match (this.data) {
            TypeData::FunctionTemplate(p) => { return p; }
            _ => { unreachable(); }
        }
    }
}
