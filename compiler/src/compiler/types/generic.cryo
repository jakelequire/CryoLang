///! Generic Types & ErrorType
///!
///! Type classes for generic parameters, bounded parameters, instantiated
///! (monomorphized) types, and the error sentinel type.

namespace Compiler::Types::Generic;

import Compiler::Diag;
import Compiler::Diag::SourceSpan;
import Compiler::Types;
import Compiler::Types::{ UserDefined, TypeRef };
import Compiler::Resolver::SymbolStr;


// GenericParamType: Unresolved generic type parameter (e.g., T)

/// Represents an unbound generic parameter.
/// Identified by INDEX (not name) to prevent "T" collisions across scopes.
type class GenericParamType : Type {
public:
    param_name:  SymbolStr;
    param_index: u64;

    GenericParamType(id: u64, param_name: SymbolStr, param_index: u64)
        : Type(id, TypeKind::GenericParam) {
        this.param_name  = param_name;
        this.param_index = param_index;
    }

    override display_name(&this) -> string {
        return format("T%lu", this.param_index);
    }

    override size_bytes(&this) -> u64 { return 0; }
    override alignment(&this) -> u64  { return 0; }

    /// Generic parameters are NOT resolved until instantiation.
    override is_resolved(&this) -> boolean { return false; }
}


// BoundedParamType: Generic parameter with trait bounds (e.g., T: Clone + Debug)

type class BoundedParamType : Type {
public:
    param_name:  SymbolStr;
    param_index: u64;
    bounds:      TypeRef[];   // Each points to a TraitType

    BoundedParamType(id: u64, param_name: SymbolStr, param_index: u64, bounds: TypeRef[])
        : Type(id, TypeKind::BoundedParam) {
        this.param_name  = param_name;
        this.param_index = param_index;
        this.bounds      = bounds;
    }

    bound_count(&this) -> i64 {
        return this.bounds.length;
    }

    override display_name(&this) -> string {
        return format("T%lu", this.param_index);
    }

    override size_bytes(&this) -> u64 { return 0; }
    override alignment(&this) -> u64  { return 0; }

    /// Bounded parameters are NOT resolved until instantiation.
    override is_resolved(&this) -> boolean { return false; }
}


// InstantiatedType: Concrete instantiation of a generic type

/// Created when a generic type is instantiated with concrete type arguments.
/// E.g., Array<i32> -> InstantiatedType(base=Array, args=[i32]).
/// After monomorphization, resolved_type points to the concrete StructType/etc.
type class InstantiatedType : Type {
public:
    generic_base:   TypeRef;       // The uninstantiated generic type
    type_args:      TypeRef[];     // Concrete type arguments
    resolved_type:  TypeRef;       // Filled after monomorphization
    computed_size:  u64;           // Computed by TypeLowering pass
    computed_align: u64;
    // True when this instantiation was created only by the additive symbolic
    // generic-body walk (sema's TypeCheckVisitor, while its demand-free mode is
    // active). Such a node may be a CONCRETE instantiation that lives only inside
    // a never-instantiated generic template - nothing ever monomorphizes it, so
    // GenericValidation must not flag it as an unresolved instantiation (E0900).
    // It is never codegen'd. Real code that later needs the same (base, args)
    // reuses this arena node and sets resolved_type, after which the flag is moot.
    is_symbolic:    boolean;

    InstantiatedType(id: u64, generic_base: TypeRef, type_args: TypeRef[])
        : Type(id, TypeKind::InstantiatedType) {
        this.generic_base   = generic_base;
        this.type_args      = type_args;
        this.resolved_type  = TypeRef::invalid();
        this.computed_size  = 0;
        this.computed_align = 0;
        this.is_symbolic    = false;
    }

    has_resolved_type(&this) -> boolean {
        return this.resolved_type.is_valid();
    }

    set_resolved_type(mut &this, resolved: TypeRef) -> void {
        this.resolved_type = resolved;
    }

    // -- Function-template instantiations: the SIGNATURE view of this slot --
    //
    // `resolved_type` carries two categorically different meanings depending on
    // what `generic_base` is:
    //
    //   - AGGREGATE base (struct/class/enum): the wrapper COLLAPSED into that
    //     concrete type.  Under single-id identity they are the SAME semantic
    //     type at the SAME arena id (see `swap_wrapper_to_concrete`).
    //   - FUNCTION-TEMPLATE base: the wrapper does NOT collapse, ever.  The slot
    //     holds the interned `FunctionType` for the spec's SIGNATURE - a
    //     DIFFERENT semantic type, deliberately SHARED between every function
    //     with that signature (`get_function` interns on the signature alone, so
    //     `identity<i32>` and `negate<i32>` resolve to ONE FunctionType id).
    //     These two can never share an id: one id cannot serve two wrappers.
    //
    // This mirrors Rust's split between `FnDef(DefId, Substs)` - unique per
    // (function, type args), which is what this wrapper is - and `FnPtr(FnSig)`
    // - structural and shared, which is what the FunctionType is.  The two are
    // bridged by a COERCION, never by an identity claim.
    //
    // Storage is shared with `resolved_type` deliberately: every generic consumer
    // that derefs a wrapper must keep working unchanged.  These accessors exist
    // so function-specific sites say what they mean.  Prefer the arena's
    // `instantiation_signature`, which additionally VERIFIES the slot holds a
    // FunctionType.
    //
    // Use these ONLY where the function-template meaning is what's intended.
    // Most `resolved_type` readers are generic wrapper-derefs that must serve
    // BOTH meanings (`check_compatibility` is the clearest example); routing
    // those through a signature accessor would be wrong, not tidier.
    has_signature(&this) -> boolean {
        return this.resolved_type.is_valid();
    }

    signature_of(&this) -> TypeRef {
        return this.resolved_type;
    }

    set_signature(mut &this, signature: TypeRef) -> void {
        this.resolved_type = signature;
    }

    arg_count(&this) -> i64 {
        return this.type_args.length;
    }

    override display_name(&this) -> string {
        // Fallback using raw TypeRef IDs.  For human-readable output,
        // use TypeArena::format_display() which resolves inner types.
        mut result: string = format("%lu<", this.generic_base.id);
        for (mut i: i64 = 0; i < this.type_args.length; i++) {
            if (i > 0) {
                result += ", ";
            }
            result = format("%s%lu", result, this.type_args[i].id);
        }
        result += ">";
        return result;
    }

    set_layout(mut &this, size: u64, align: u64) -> void {
        this.computed_size  = size;
        this.computed_align = align;
    }

    override size_bytes(&this) -> u64 { return this.computed_size; }
    override alignment(&this) -> u64  { return this.computed_align; }

    override is_resolved(&this) -> boolean {
        return this.has_resolved_type();
    }
}


// AssocProjectionType: Symbolic associated-type projection (e.g. I::Item)

/// Represents an associated-type projection `Base::Member` that cannot yet be
/// resolved to a concrete type because `Base` is still an unbound generic
/// parameter (e.g. `I::Item` inside the template `MapIter<I, O>`). Stays
/// symbolic through type resolution and is resolved during monomorphization:
/// when `Base` is specialized to a concrete type, the monomorphizer looks up
/// that type's impl of the owning trait and reads its `Member` binding,
/// filling `resolved_type`. A concrete-base projection never needs this class - 
/// the resolver projects it directly.
type class AssocProjectionType : Type {
public:
    base:          TypeRef;     // The projected-over type (usually a GenericParam)
    member:        SymbolStr;   // The associated-type name (e.g. `Item`)
    owning_trait:  TypeRef;     // Trait that declares `member` (invalid = infer)
    resolved_type: TypeRef;     // Filled at monomorphization

    AssocProjectionType(id: u64, base: TypeRef, member: SymbolStr, owning_trait: TypeRef)
        : Type(id, TypeKind::AssocProjection) {
        this.base          = base;
        this.member        = member;
        this.owning_trait  = owning_trait;
        this.resolved_type = TypeRef::invalid();
    }

    has_resolved_type(&this) -> boolean { return this.resolved_type.is_valid(); }
    set_resolved_type(mut &this, resolved: TypeRef) -> void {
        this.resolved_type = resolved;
    }

    override display_name(&this) -> string {
        return format("%lu::%u", this.base.id, this.member.id);
    }

    override size_bytes(&this) -> u64 { return 0; }
    override alignment(&this) -> u64  { return 0; }

    /// Unresolved until the base is specialized and the binding is read.
    override is_resolved(&this) -> boolean { return this.has_resolved_type(); }
}


// ErrorType: Placeholder for type resolution failures

/// Captures type resolution failures explicitly so that downstream passes
/// can report meaningful errors rather than crashing on null pointers.
type class ErrorType : Type {
public:
    reason: string;
    span:   SourceSpan;
    notes:  string[];

    ErrorType(id: u64, reason: string, span: SourceSpan)
        : Type(id, TypeKind::Error) {
        this.reason = reason;
        this.span   = span;
        this.notes  = [];
    }

    add_note(note: string) -> void {
        this.notes.push(note);
    }

    override display_name(&this) -> string {
        return format("<error: %s>", this.reason);
    }

    override size_bytes(&this) -> u64 { return 0; }
    override alignment(&this) -> u64  { return 0; }
}
