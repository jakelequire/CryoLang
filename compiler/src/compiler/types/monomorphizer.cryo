///! Monomorphizer
///!
///! Worklist-driven engine that processes all generic instantiations to completion.
///! Repeatedly dequeues InstantiatedTypes, specializes them via ASTSpecializer,
///! creates concrete types in the TypeArena, and discovers transitive dependencies.
///!
///! After process_all() completes, every InstantiatedType has a resolved_type
///! pointing to a concrete Struct/Enum/Class, and get_all_specialized_asts()
///! returns the full set of specialized declarations ready for injection into
///! the program AST.

namespace Compiler::Types::Monomorphizer;

import Compiler::AST;
import std::collections::hashmap;
import Compiler::Types::Generic;
import Compiler::Types::UserDefined;
import Compiler::Types::Compound;
import Compiler::Types::Type;
import Compiler::Types::Arena;
import Compiler::Types::TypeRef;
import Compiler::Diag::Sink;
import Compiler::Diag::Diagnostic;
import Compiler::Diag::SourceSpan;
import Compiler::AST::Node;
import Compiler::AST::Declaration;
import Compiler::AST::Statement;
import Compiler::AST::Expression;
import Compiler::AST::Specializer;
import Compiler::AST::Pattern;
import Compiler::Types::Substitution;
import Compiler::Types::Inference;
import Compiler::Types::Checker;
import Compiler::Types::Resolver;
import Compiler::Types::GenericRegistry;
import Compiler::Types::Ownership;
import Compiler::Resolver::InternTable;
import Compiler::Resolver::SymbolStr;
import Compiler::Resolver::Resolver;
import Compiler::Resolver::QualifiedName;
import Compiler::Resolver::MangledName;
import Compiler::DeclIndex;
import Compiler::Diag;
import Compiler::Lex;
import Utils::Logger;


// MonomorphRequest: a pending instantiation to specialize

type struct MonomorphRequest {
    generic_type: TypeRef;          // The InstantiatedType
    type_args:    TypeRef[];        // Concrete type arguments
    base_type:    TypeRef;          // The generic base type
    span:         SourceSpan;

    /// Deep copy. `type_args` is a heap array of Copy `TypeRef` handles, so
    /// the worklist loop clones an entry before processing it: the worklist
    /// (`pending`) grows during processing (specialization enqueues more
    /// instantiations), and the cloned snapshot owns an independent buffer
    /// so dropping it at the end of an iteration cannot double-free the
    /// entry the worklist still owns.
    clone(&this) -> MonomorphRequest {
        mut args_copy: TypeRef[] = [];
        for (mut i: i64 = 0; i < this.type_args.length; i++) {
            args_copy.push(this.type_args[i]);
        }
        return MonomorphRequest {
            generic_type: this.generic_type,
            type_args:    args_copy,
            base_type:    this.base_type,
            span:         this.span,
        };
    }
}


// SpecializationEntry: a completed specialization

type struct SpecializationEntry {
    specialized_type:  TypeRef;
    specialized_name:  SymbolStr;
    ast_node:          ASTNode*;
    impl_nodes:        ASTNode*[];
    origin_module:     SymbolStr;      // Module that first triggered this specialization
    template_module:   SymbolStr;      // Module where the template is defined
    instantiated_type: TypeRef;        // The InstantiatedType that was resolved
}


/// True when `s` ends with `suffix`.  Used by scope-qualified template
/// lookup to match a candidate's qualified name against the call's scope.
function mono_str_ends_with(s: string, suffix: string) -> boolean {
    const sl: i64 = strlen(s) as i64;
    const fl: i64 = strlen(suffix) as i64;
    if (fl > sl) { return false; }
    mut i: i64 = 0;
    while (i < fl) {
        if (s[sl - fl + i] != suffix[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// Independent copy of a `TypeRef[]`. `TypeRef` is `Copy`, so an element-wise
/// push duplicates the buffer without aliasing the source's owned storage.
/// Used wherever an owning request/local would otherwise alias an
/// `InstantiatedType`'s `type_args` (or a variant's payload) buffer — a shared
/// buffer would be freed twice. Mirrors `MonomorphRequest::clone`'s copy.
function mono_copy_type_refs(src: &TypeRef[]) -> TypeRef[] {
    mut out: TypeRef[] = [];
    for (mut i: i64 = 0; i < src.length; i++) { out.push(src[i]); }
    return out;
}

// Monomorphizer: worklist engine

type struct Monomorphizer {
    arena:             TypeArena*;
    generic_registry:  GenericRegistry*;
    intern_table:      InternTable*;
    diagnostics:       DiagnosticSink*;
    type_resolver:     TypeResolver*;
    decl_index:        DeclarationIndex*;
    specializer:       ASTSpecializer;

    // Worklist
    pending:           MonomorphRequest[];
    pending_cursor:    i64;                  // Index cursor (avoids O(n) erase-from-front)

    // Cache
    spec_keys:         string[];
    spec_entries:      SpecializationEntry[];
    spec_index:        HashMap<string, i64>;   // key -> index in spec_entries

    // Cycle detection
    in_progress:       HashMap<string, boolean>;

    // Error tracking
    error_count:       i64;

    // Incremental injection tracking (for batch compilation)
    injection_cursor:  i64;

    // Current module being processed (set by pass before calling process_all)
    current_module:    SymbolStr;

    // Visited set for request_nested_instantiations cycle detection.
    nested_visited: u64[];

    // Per-module consumption tracking (flat parallel arrays).
    // Records which modules consumed (had injected) each specialization.
    // consumer_spec_indices[i] is the spec_entries index,
    // consumer_modules[i] is the SymbolStr.id of the consuming module.
    consumer_spec_indices: i64[];
    consumer_modules:      u32[];

    // Transient inference scratch buffer.  `try_infer_function_call`
    // clears and rebuilds this per-call; `unify_for_inference` reads
    // and writes it directly.  Lives on the struct (rather than as a
    // pointer-to-array argument): write-through-pointer-to-array
    // (`(*ptr_to_array)[i] = value`) has historically not lowered
    // correctly.  Recursion through unify is safe: it only self-calls,
    // so all frames share the same buffer.
    inference_bindings: TypeRef[];

    // Param TypeRef IDs the unifier consults when matching a formal
    // GenericParam.  Populated by the inference entry points before
    // calling unify_for_inference (free-fn calls use the template's
    // entry.param_type_ids; method-call inference uses the method's
    // own generic param IDs from create_generic_param).
    inference_param_ids: u64[];

    // Transient: the (existing, new) actuals from the most recent open-param
    // unification conflict, surfaced by `unify_for_inference` from the
    // InferCtx. `try_infer_function_call` resets these before each per-arg
    // unify and, on a conflict, decides via `check_compatibility` whether the
    // two are a genuine "no single T" type error (reject) or a coercible
    // mismatch (keep the pin-first behavior). Both are Copy.
    infer_conflict_from: TypeRef;
    infer_conflict_to:   TypeRef;

    // Expected type of the expression currently being walked, when it sits in
    // an expected-type position (a typed `const/mut x: T = <expr>` initializer).
    // Drives return-type inference for `![implicit]` callees: an omitted
    // generic arg that arg-unification can't pin is recovered by unifying the
    // callee's return type against this.  Invalid outside such positions; the
    // call-expression walk clears it before recursing into arg/callee
    // sub-expressions so only the directly-bound call inherits it.
    current_expected_type: TypeRef;

    // In-progress spec context.  Set by specialize_request before calling
    // resolve_specialized_ast on a struct/class spec, cleared after.  Lets
    // resolve_arg_type_for_inference look up `this.field` types via the
    // spec'd AST when the InstantiatedType wrapper's resolved_type isn't
    // installed yet (populate_concrete_type runs after resolve_specialized_ast).
    current_spec_inst_id: u64;
    current_spec_struct:  StructDeclNode*;

    // Transient: most recent constructor-shaped static-method instantiation
    // discovered by `try_infer_static_method_on_generic_template`.  Set
    // when value-arg inference promotes a call like `Range::new(0, 5)`
    // from the template `Range<T>` to the spec'd `Range<i32>`.  Read
    // (and cleared) by the `is_auto` VarDecl back-propagation in
    // `discover_inferred_calls_in_stmt` so the synthesized for-in
    // iterator local picks up the spec'd type without ever mutating
    // `call.resolved_type` (which other passes treat as load-bearing).
    last_static_inst_ref: TypeRef;

    // Per-walker scope stack for match-arm bindings.  Populated by
    // `push_arm_bindings_to_scope` before walking an arm body and torn
    // down by `pop_scope_bindings` afterwards.  `lookup_local_type` and
    // `resolve_arg_type_for_inference` consult this stack so identifiers
    // bound by patterns (e.g. `Result::Ok(raw) => raw.method<...>()`)
    // resolve correctly inside generic-method bodies that sema skipped.
    // Direct field access bypasses the array-by-value pitfall that bit
    // the names/types parameter passing.
    scope_names: SymbolStr[];
    scope_types: TypeRef[];


    static new(arena: TypeArena*, generic_registry: GenericRegistry*,
               intern_table: InternTable*, diagnostics: DiagnosticSink*,
               type_resolver: TypeResolver*,
               decl_index: DeclarationIndex*) -> Monomorphizer {
        return Monomorphizer {
            arena:                 arena,
            generic_registry:      generic_registry,
            intern_table:          intern_table,
            diagnostics:           diagnostics,
            type_resolver:         type_resolver,
            decl_index:            decl_index,
            specializer:           ASTSpecializer::new(arena, intern_table),
            pending:               [],
            pending_cursor:        0,
            spec_keys:             [],
            spec_entries:          [],
            spec_index:            HashMap<string, i64>::new(),
            in_progress:           HashMap<string, boolean>::new(),
            error_count:           0,
            injection_cursor:      0,
            current_module:        SymbolStr::empty(),
            consumer_spec_indices: [],
            consumer_modules:      [],
            nested_visited:        [],
            inference_bindings:    [],
            inference_param_ids:   [],
            infer_conflict_from:   TypeRef::invalid(),
            infer_conflict_to:     TypeRef::invalid(),
            current_expected_type: TypeRef::invalid(),
            current_spec_inst_id:  0,
            current_spec_struct:   null,
            last_static_inst_ref:  TypeRef::invalid(),
            scope_names:           [],
            scope_types:           [],
        };
    }


    // Main worklist loop

    /// Set the current module context for origin tracking.
    set_current_module(mut &this, module: SymbolStr) -> void {
        this.current_module = module;
    }

    /// True iff every queued specialization request has been drained.
    /// Used by the pipeline driver between Phase 6a (mono across all
    /// modules) and Phase 6b (sema/validation) to assert that no
    /// specialization remains pending when sema starts walking.  The
    /// invariant is structural; sema reads InstantiatedType wrappers
    /// in the shared TypeArena, and a stale request means sema would
    /// see types whose specialized AST hasn't been materialized yet.
    worklist_empty(&this) -> boolean {
        return this.pending_cursor >= this.pending.length;
    }

    /// Number of requests still queued (for diagnostic messages).
    pending_count(&this) -> i64 {
        const remaining: i64 = this.pending.length - this.pending_cursor;
        if (remaining < 0) { return 0; }
        return remaining;
    }

    /// Process all pending monomorphization requests.
    /// Returns true if all succeeded, false if any errors occurred.
    process_all(mut &this) -> boolean {
        // Import all unmonomorphized instantiations from the generic registry
        const unprocessed: TypeRef[] = this.generic_registry.collect_unmonomorphized();

        // Nothing new to process; skip the worklist entirely.
        // This is the common case for modules after the first few in a
        // multi-module build: earlier modules already monomorphized everything.
        if (unprocessed.length == 0) {
            return true;
        }

        LOG_DEBUG(LogComponent::TypeChecker, "[Monomorphizer::process_all] %lld unmonomorphized instantiations",
            unprocessed.length);

        for (mut i: i64 = 0; i < unprocessed.length; i++) {
            this.enqueue_from_type_ref(unprocessed[i]);
        }

        // Process worklist until empty
        while (this.pending_cursor < this.pending.length) {
            const request: MonomorphRequest = this.pending[this.pending_cursor].clone();
            this.pending_cursor += 1;

            const key: string = this.make_key(request);

            // Already cached; mark in mono_set so collect_unmonomorphized()
            // won't return it again on the next module.  Propagate the
            // cached concrete type to this module's fresh InstantiatedType
            // (sema creates a new one per call site, and the cache hit
            // bypasses the set_resolved_type path in specialize_with_entry).
            if (this.is_cached(key)) {
                this.propagate_cached_resolution(key, request);
                this.generic_registry.mark_monomorphized(request.base_type, request.type_args);
                continue;
            }

            // Cycle detection
            if (this.is_in_progress(key)) {
                this.diagnostics.emit(Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    format("monomorphization cycle detected for %s", key)));
                this.error_count += 1;
                continue;
            }

            // Mark as in-progress
            const ip_h: u64 = hash_str(key);
            this.in_progress.insert(key, true);

            // Specialize
            const success: boolean = this.specialize_request(request, key);

            // Remove from in-progress
            this.remove_in_progress(key);

            if (!success) {
                this.error_count += 1;
            }
        }

        // Second pass: discover Array<T> for standalone T[] usages.
        // The nested discovery above only catches arrays that appear as
        // fields of other monomorphized types.  Standalone T[] (in function
        // params, locals) creates ArrayType without InstantiatedType.
        // Scan the arena once for dynamic ArrayTypes with concrete elements
        // and enqueue any missing Array<T> instantiations.
        const array_sym: SymbolStr = this.intern_table.intern("std::collections::array::Array");
        const array_entry: TemplateEntry* = this.generic_registry.get_template(array_sym);
        if (array_entry != null) {
            const array_base: TypeRef = array_entry.base_type;
            const type_count: i64 = this.arena.type_count();
            for (mut tid: u64 = 1; tid <= type_count as u64; tid++) {
                const at: Type* = this.arena.lookup(tid);
                if (at == null || at.kind != TypeKind::Array) { continue; }
                const arr: ArrayType* = at as ArrayType*;
                if (!arr.is_dynamic() || !arr.element.is_valid()) { continue; }
                const elem_t: Type* = this.arena.lookup(arr.element.id);
                if (elem_t == null) { continue; }
                if (elem_t.kind == TypeKind::GenericParam ||
                    elem_t.kind == TypeKind::BoundedParam) { continue; }
                mut arr_args: TypeRef[] = [];
                arr_args.push(arr.element);
                // Expand defaults so e.g. stdlib-next's `Array<T, A = GlobalAlloc>`
                // gets a 2-arg instantiation here, not just the element type.
                const _mod_dummy: string = "";
                mut arr_ctx: ResolutionContext = ResolutionContext::new(_mod_dummy, _mod_dummy);
                arr_args = this.type_resolver.expand_default_type_args(array_entry, arr_args, &arr_ctx);
                const inst_ref: TypeRef = this.generic_registry.instantiate(array_base, arr_args);
                this.enqueue_from_type_ref(inst_ref);
            }
            // Process any newly enqueued Array<T> instantiations.
            while (this.pending_cursor < this.pending.length) {
                const req: MonomorphRequest = this.pending[this.pending_cursor].clone();
                this.pending_cursor += 1;
                const rkey: string = this.make_key(req);
                if (this.is_cached(rkey)) {
                    this.propagate_cached_resolution(rkey, req);
                    this.generic_registry.mark_monomorphized(req.base_type, req.type_args);
                    continue;
                }
                if (this.is_in_progress(rkey)) { continue; }
                const rip_h: u64 = hash_str(rkey);
                this.in_progress.insert(rkey, true);
                const rsuccess: boolean = this.specialize_request(req, rkey);
                this.remove_in_progress(rkey);
                if (!rsuccess) { this.error_count += 1; }
            }
        }

        // Mark ALL collected items as monomorphized, including those that
        // enqueue_from_type_ref() filtered out (template-internal references
        // whose args contain GenericParam, non-template base types, etc.).
        // Without this, collect_unmonomorphized() keeps returning the same
        // filtered-out items on every subsequent module in a batch build.
        for (mut i: i64 = 0; i < unprocessed.length; i++) {
            const t: Type* = this.arena.lookup(unprocessed[i].id);
            if (t != null && t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = t as InstantiatedType*;
                this.generic_registry.mark_monomorphized(inst.generic_base, inst.type_args);
            }
        }

        return this.error_count == 0;
    }


    // Worklist drain (for follow-up inference passes)

    /// Drain the pending instantiation worklist without the
    /// `collect_unmonomorphized()` pre-pass that `process_all` runs.
    /// Used after `discover_inferred_calls_in_module` queues new
    /// instantiations via `instantiate_for_module`; calling
    /// `process_all` a second time would re-feed items the first call
    /// filtered out (partial specs containing GenericParam), and the
    /// post-pass marking is already done.  This drains only what's
    /// freshly enqueued.  Returns true on success.
    drain_pending_worklist(mut &this) -> boolean {
        mut errors: i64 = 0;
        while (this.pending_cursor < this.pending.length) {
            const request: MonomorphRequest = this.pending[this.pending_cursor].clone();
            this.pending_cursor += 1;
            const key: string = this.make_key(request);
            if (this.is_cached(key)) {
                this.propagate_cached_resolution(key, request);
                this.generic_registry.mark_monomorphized(request.base_type, request.type_args);
                continue;
            }
            if (this.is_in_progress(key)) {
                this.diagnostics.emit(Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    format("monomorphization cycle detected for %s", key)));
                errors += 1;
                continue;
            }
            this.in_progress.insert(key, true);
            const ok: boolean = this.specialize_request(request, key);
            this.remove_in_progress(key);
            if (!ok) { errors += 1; }
        }
        if (errors > 0) {
            this.error_count += errors;
        }
        return errors == 0;
    }


    // Bound-directed dispatch annotation (Bug C)

    /// Annotate method calls with a disambiguating trait so the
    /// monomorphizer's trait-impl method lookups pick the right impl when a
    /// type implements two traits that declare a same-named method (the
    /// canonical case: `Display::fmt` vs `Debug::fmt`).  The information
    /// that disambiguates them - a `where T: Debug` bound, or the enclosing
    /// trait-impl's trait - is only available PRE-monomorphization (once a
    /// generic is substituted to a concrete type the bound is gone), so this
    /// runs over EVERY decl (generic templates included) before mono clones
    /// anything; the cloner copies `resolved_trait` onto every spec.
    ///
    /// Two rules:
    ///   1. Param receiver: `recv.m()` where `recv` is a parameter whose
    ///      annotation head is a generic param bounded by exactly ONE trait
    ///      -> that trait.  (Fixes e.g. `format_debug_to_string`'s own
    ///      `value.fmt()` where `value: &T, T: Debug`.)
    ///   2. Trait-impl recursion: a call to the enclosing method's own name
    ///      inside a trait-impl method -> the impl's trait.  (Fixes container
    ///      recursion: `element.fmt()` inside `Array::Debug::fmt` -> Debug,
    ///      regardless of how `element` was bound - match arm, get_ref, etc.)
    annotate_bound_dispatch_in_module(mut &this, root: ProgramNode*) -> void {
        if (root == null) { return; }
        mut no_bounds: TraitBound[] = [];
        const no_trait: SymbolStr = SymbolStr::empty();
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }
            match (stmt.kind) {
                NodeKind::FunctionDeclaration => {
                    const f: FunctionDeclNode* = stmt as FunctionDeclNode*;
                    this.annotate_dispatch_in_func(f, f.trait_bounds, no_trait);
                }
                NodeKind::StructDeclaration => {
                    const sn: StructDeclNode* = stmt as StructDeclNode*;
                    this.annotate_dispatch_in_methods(sn.methods, no_bounds, no_trait);
                }
                NodeKind::ClassDeclaration => {
                    const cn: ClassDeclNode* = stmt as ClassDeclNode*;
                    this.annotate_dispatch_in_methods(cn.methods, no_bounds, no_trait);
                }
                NodeKind::ImplementationBlock => {
                    const ib: ImplBlockNode* = stmt as ImplBlockNode*;
                    mut trait_leaf: SymbolStr = SymbolStr::empty();
                    if (ib.is_trait_impl()) {
                        trait_leaf = this.trait_leaf_of_ann(ib.trait_annotation);
                    }
                    this.annotate_dispatch_in_methods(ib.methods, ib.where_bounds, trait_leaf);
                }
                _ => {}
            }
        }
    }

    annotate_dispatch_in_methods(mut &this, methods: &MethodNode*[],
                                 impl_bounds: &TraitBound[],
                                 trait_leaf: SymbolStr) -> void {
        for (mut k: i64 = 0; k < methods.length; k++) {
            const m: MethodNode* = methods[k];
            if (m == null || m.func == null) { continue; }
            // Rule 1 needs the param's bound, which may be impl-level
            // (`implement<T> ... where T: Debug`) or method-level; merge both.
            mut bounds: TraitBound[] = [];
            for (mut a: i64 = 0; a < impl_bounds.length; a++) {
                bounds.push(impl_bounds[a].clone());
            }
            for (mut b: i64 = 0; b < m.func.trait_bounds.length; b++) {
                bounds.push(m.func.trait_bounds[b].clone());
            }
            this.annotate_dispatch_in_func(m.func, bounds, trait_leaf);
        }
    }

    annotate_dispatch_in_func(mut &this, func: FunctionDeclNode*,
                              bounds: &TraitBound[],
                              enclosing_trait: SymbolStr) -> void {
        if (func == null || func.body == null) { return; }
        this.annotate_dispatch_stmt(func.body as StatementNode*, func, bounds,
                                    enclosing_trait);
    }

    /// Apply the two annotation rules to a single method-call's MemberAccess.
    annotate_dispatch_member(mut &this, ma: MemberAccessNode*,
                             func: FunctionDeclNode*, bounds: &TraitBound[],
                             enclosing_trait: SymbolStr) -> void {
        if (ma == null) { return; }
        if (ma.resolved_trait.is_valid()) { return; }
        // Rule 1: receiver is a parameter typed as a single-bounded generic.
        const obj_node: ASTNode* = ma.object as ASTNode*;
        if (obj_node != null && obj_node.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = ma.object as IdentifierNode*;
            for (mut p: i64 = 0; p < func.parameters.length; p++) {
                const param: VarDeclNode* = func.parameters[p];
                if (param == null) { continue; }
                if (!param.name.equals(id.name)) { continue; }
                const head: SymbolStr = this.trait_leaf_of_ann(param.type_annotation);
                if (head.is_valid()) {
                    const tr: SymbolStr = this.single_bound_trait_for(head, bounds);
                    if (tr.is_valid()) {
                        ma.set_resolved_trait(tr);
                        return;
                    }
                }
                break;
            }
        }
        // Rule 2: recursive same-named call inside a trait-impl method.
        if (enclosing_trait.is_valid() && ma.member.equals(func.name)) {
            ma.set_resolved_trait(enclosing_trait);
        }
    }

    /// Return the single trait bounding `param_name`, or empty when the
    /// param has zero or more-than-one bound trait (ambiguous - leave the
    /// dispatch to its default).
    single_bound_trait_for(&this, param_name: SymbolStr,
                           bounds: &TraitBound[]) -> SymbolStr {
        mut found: SymbolStr = SymbolStr::empty();
        mut count: i64 = 0;
        for (mut i: i64 = 0; i < bounds.length; i++) {
            const b: TraitBound* = &bounds[i];
            if (!b.type_parameter.equals(param_name)) { continue; }
            for (mut j: i64 = 0; j < b.trait_refs.length; j++) {
                const tr: TraitRef* = &b.trait_refs[j];
                if (tr.path.length == 0) { continue; }
                found = tr.path[tr.path.length - 1];
                count += 1;
            }
        }
        if (count == 1) { return found; }
        return SymbolStr::empty();
    }

    annotate_dispatch_stmt(mut &this, stmt: StatementNode*,
                           func: FunctionDeclNode*, bounds: &TraitBound[],
                           enclosing_trait: SymbolStr) -> void {
        if (stmt == null) { return; }
        const node: ASTNode* = stmt as ASTNode*;
        match (node.kind) {
            NodeKind::ExpressionStatement => {
                const es: ExprStmtNode* = stmt as ExprStmtNode*;
                this.annotate_dispatch_expr(es.expression, func, bounds, enclosing_trait);
            }
            NodeKind::DeclarationStatement => {
                const ds: DeclStmtNode* = stmt as DeclStmtNode*;
                const inner: DeclarationNode* = ds.declaration;
                if (inner != null && (inner as ASTNode*).kind == NodeKind::VariableDeclaration) {
                    const vd: VarDeclNode* = inner as VarDeclNode*;
                    if (vd.initializer != null) {
                        this.annotate_dispatch_expr(vd.initializer, func, bounds, enclosing_trait);
                    }
                }
            }
            NodeKind::ReturnStatement => {
                const rs: ReturnStmtNode* = stmt as ReturnStmtNode*;
                if (rs.expression != null) {
                    this.annotate_dispatch_expr(rs.expression, func, bounds, enclosing_trait);
                }
            }
            NodeKind::BlockStatement => {
                const bs: BlockStmtNode* = stmt as BlockStmtNode*;
                for (mut i: i64 = 0; i < bs.statements.length; i++) {
                    this.annotate_dispatch_stmt(bs.statements[i], func, bounds, enclosing_trait);
                }
            }
            NodeKind::IfStatement => {
                const ifs: IfStmtNode* = stmt as IfStmtNode*;
                this.annotate_dispatch_expr(ifs.condition, func, bounds, enclosing_trait);
                if (ifs.then_stmt != null) {
                    this.annotate_dispatch_stmt(ifs.then_stmt, func, bounds, enclosing_trait);
                }
                if (ifs.has_else() && ifs.else_stmt != null) {
                    this.annotate_dispatch_stmt(ifs.else_stmt, func, bounds, enclosing_trait);
                }
            }
            NodeKind::WhileStatement => {
                const ws: WhileStmtNode* = stmt as WhileStmtNode*;
                this.annotate_dispatch_expr(ws.condition, func, bounds, enclosing_trait);
                if (ws.body != null) {
                    this.annotate_dispatch_stmt(ws.body, func, bounds, enclosing_trait);
                }
            }
            NodeKind::ForStatement => {
                const fs: ForStmtNode* = stmt as ForStmtNode*;
                if (fs.condition != null) {
                    this.annotate_dispatch_expr(fs.condition, func, bounds, enclosing_trait);
                }
                if (fs.body != null) {
                    this.annotate_dispatch_stmt(fs.body, func, bounds, enclosing_trait);
                }
            }
            NodeKind::LoopStatement => {
                const ls: LoopStmtNode* = stmt as LoopStmtNode*;
                if (ls.body != null) {
                    this.annotate_dispatch_stmt(ls.body, func, bounds, enclosing_trait);
                }
            }
            NodeKind::MatchStatement => {
                const ms: MatchStmtNode* = stmt as MatchStmtNode*;
                this.annotate_dispatch_expr(ms.subject, func, bounds, enclosing_trait);
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm == null) { continue; }
                    if (arm.guard != null) {
                        this.annotate_dispatch_expr(arm.guard, func, bounds, enclosing_trait);
                    }
                    if (arm.body != null) {
                        this.annotate_dispatch_stmt(arm.body, func, bounds, enclosing_trait);
                    }
                }
            }
            _ => {}
        }
    }

    annotate_dispatch_expr(mut &this, expr: ExpressionNode*,
                           func: FunctionDeclNode*, bounds: &TraitBound[],
                           enclosing_trait: SymbolStr) -> void {
        if (expr == null) { return; }
        const node: ASTNode* = expr as ASTNode*;
        match (node.kind) {
            NodeKind::CallExpression => {
                const call: CallExprNode* = expr as CallExprNode*;
                if (call.callee != null
                        && (call.callee as ASTNode*).kind == NodeKind::MemberAccess) {
                    this.annotate_dispatch_member(
                        call.callee as MemberAccessNode*, func, bounds, enclosing_trait);
                }
                for (mut i: i64 = 0; i < call.arguments.length; i++) {
                    this.annotate_dispatch_expr(call.arguments[i], func, bounds, enclosing_trait);
                }
                if (call.callee != null) {
                    this.annotate_dispatch_expr(call.callee, func, bounds, enclosing_trait);
                }
            }
            NodeKind::MemberAccess => {
                const ma: MemberAccessNode* = expr as MemberAccessNode*;
                this.annotate_dispatch_expr(ma.object, func, bounds, enclosing_trait);
            }
            NodeKind::BinaryExpression => {
                const be: BinaryExprNode* = expr as BinaryExprNode*;
                this.annotate_dispatch_expr(be.left, func, bounds, enclosing_trait);
                this.annotate_dispatch_expr(be.right, func, bounds, enclosing_trait);
            }
            NodeKind::UnaryExpression => {
                const ue: UnaryExprNode* = expr as UnaryExprNode*;
                this.annotate_dispatch_expr(ue.operand, func, bounds, enclosing_trait);
            }
            NodeKind::TryExpression => {
                const te: TryExprNode* = expr as TryExprNode*;
                this.annotate_dispatch_expr(te.operand, func, bounds, enclosing_trait);
            }
            NodeKind::ArrayAccess => {
                const aa: ArrayAccessNode* = expr as ArrayAccessNode*;
                this.annotate_dispatch_expr(aa.array, func, bounds, enclosing_trait);
                this.annotate_dispatch_expr(aa.index, func, bounds, enclosing_trait);
            }
            NodeKind::CastExpression => {
                const ce: CastExprNode* = expr as CastExprNode*;
                this.annotate_dispatch_expr(ce.expression, func, bounds, enclosing_trait);
            }
            NodeKind::StructLiteral => {
                const sl: StructLiteralNode* = expr as StructLiteralNode*;
                for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                    this.annotate_dispatch_expr(sl.field_inits[i].value, func, bounds, enclosing_trait);
                }
            }
            NodeKind::ArrayLiteral => {
                const al: ArrayLiteralNode* = expr as ArrayLiteralNode*;
                for (mut i: i64 = 0; i < al.elements.length; i++) {
                    this.annotate_dispatch_expr(al.elements[i], func, bounds, enclosing_trait);
                }
            }
            _ => {}
        }
    }


    // Module-wide inferred-call discovery

    /// Walk every non-generic top-level declaration in the given module
    /// AST, firing `try_infer_function_call` / `try_infer_method_call`
    /// against each call expression in their bodies.  Without this pass
    /// the inference machinery only fires inside SPEC'D bodies; calls
    /// to generic functions/methods from non-generic free functions or
    /// inline non-generic methods (e.g. `Request::parse(stream)` inside
    /// `handle_connection`) leave `resolved_callee` / `resolved_method`
    /// null, and codegen falls back to a name-based mangle that bakes
    /// the unsubstituted generic param into the LLVM symbol (`$L1R$G`).
    ///
    /// New instantiations queued by `try_infer_function_call` are NOT
    /// drained here; the caller should re-run `process_all()` after
    /// this completes so the queued specs get materialized in the same
    /// mono iteration.  `try_infer_method_call` specializes inline (no
    /// queue) and produces no follow-up worklist work.
    discover_inferred_calls_in_module(mut &this, root: ProgramNode*) -> void {
        if (root == null) { return; }
        const _empty: string = "";
        mut res_ctx: ResolutionContext = ResolutionContext::new(_empty, _empty);
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }
            match (stmt.kind) {
                NodeKind::FunctionDeclaration => {
                    const func: FunctionDeclNode* = stmt as FunctionDeclNode*;
                    if (func.is_generic()) { continue; }
                    this.discover_in_func_body(func, TypeRef::invalid(), &res_ctx);
                }
                NodeKind::StructDeclaration => {
                    const sn: StructDeclNode* = stmt as StructDeclNode*;
                    if (sn.is_generic()) { continue; }
                    const owner_ref: TypeRef = this.lookup_owner_type_ref(sn.name);
                    for (mut k: i64 = 0; k < sn.methods.length; k++) {
                        const m: MethodNode* = sn.methods[k];
                        if (m == null || m.func == null) { continue; }
                        if (m.func.is_generic()) { continue; }
                        const this_ty: TypeRef = if (m.is_static) {
                            TypeRef::invalid()
                        } else {
                            owner_ref
                        };
                        this.discover_in_func_body(m.func, this_ty, &res_ctx);
                    }
                }
                NodeKind::ClassDeclaration => {
                    const cn: ClassDeclNode* = stmt as ClassDeclNode*;
                    if (cn.is_generic()) { continue; }
                    const owner_ref: TypeRef = this.lookup_owner_type_ref(cn.name);
                    for (mut k: i64 = 0; k < cn.methods.length; k++) {
                        const m: MethodNode* = cn.methods[k];
                        if (m == null || m.func == null) { continue; }
                        if (m.func.is_generic()) { continue; }
                        const this_ty: TypeRef = if (m.is_static) {
                            TypeRef::invalid()
                        } else {
                            owner_ref
                        };
                        this.discover_in_func_body(m.func, this_ty, &res_ctx);
                    }
                }
                NodeKind::ImplementationBlock => {
                    const ib: ImplBlockNode* = stmt as ImplBlockNode*;
                    if (ib.generic_params.length > 0) { continue; }
                    const owner_ref: TypeRef = this.lookup_owner_type_ref(ib.target_type);
                    for (mut k: i64 = 0; k < ib.methods.length; k++) {
                        const m: MethodNode* = ib.methods[k];
                        if (m == null || m.func == null) { continue; }
                        if (m.func.is_generic()) { continue; }
                        const this_ty: TypeRef = if (m.is_static) {
                            TypeRef::invalid()
                        } else {
                            owner_ref
                        };
                        this.discover_in_func_body(m.func, this_ty, &res_ctx);
                    }
                }
                _ => {}
            }
        }
    }

    /// Helper for `discover_inferred_calls_in_module`, which sets up the
    /// param/local table and walks the function body.  Mirrors the
    /// table-construction logic at the tail of `resolve_func_and_body`,
    /// but is reused here for non-spec'd bodies (where subst is null).
    discover_in_func_body(mut &this, func: FunctionDeclNode*,
                           this_type: TypeRef,
                           res_ctx: ResolutionContext*) -> void {
        if (func == null || func.body == null) { return; }
        mut local_names: SymbolStr[] = [];
        mut local_types: TypeRef[] = [];
        if (this_type.is_valid()) {
            local_names.push(this.intern_table.intern("this"));
            local_types.push(this_type);
        }
        for (mut pi: i64 = 0; pi < func.parameters.length; pi++) {
            const p: VarDeclNode* = func.parameters[pi];
            if (p == null || !p.resolved_type.is_valid()) { continue; }
            local_names.push(p.name);
            local_types.push(p.resolved_type);
        }
        this.collect_locals_in_block(func.body, &local_names, &local_types);
        this.discover_inferred_calls_in_block(func.body, res_ctx, null,
                                              local_names, local_types);
    }

    /// Resolve a struct/class owner name to its canonical TypeRef.  Tries
    /// the locally-qualified form first (the form `register_decl_in_index`
    /// uses), then the bare name.  Used by the inherent-method walk to
    /// seed `this`'s type for non-generic instance methods so receiver-
    /// type-based inference can recognize `this.foo(...)` shapes.
    lookup_owner_type_ref(&this, owner_name: SymbolStr) -> TypeRef {
        if (this.decl_index == null || !owner_name.is_valid()) {
            return TypeRef::invalid();
        }
        const qualified: SymbolStr = this.decl_index.resolve_qualified(owner_name);
        mut ty: TypeRef = this.decl_index.lookup_type(qualified);
        if (!ty.is_valid()) {
            ty = this.decl_index.lookup_type(owner_name);
        }
        return ty;
    }


    // Single request specialization

    specialize_request(mut &this, request: &MonomorphRequest, key: string) -> boolean {
        // Look up template by TypeID, the single source of truth.
        // If the type wasn't registered during TemplateRegistration, it's an error.
        cdebug("[Monomorphizer::specialize_request] key='%s' base_type.id=%llu\n", key, request.base_type.id);
        const _base_dbg: Type* = this.arena.lookup(request.base_type.id);
        if (_base_dbg != null) {
            cdebug("  base type: kind=%s display='%s'\n", _base_dbg.kind.to_string(), _base_dbg.display_name());
        } else {
            cdebug("  base type: LOOKUP FAILED for id=%llu\n", request.base_type.id);
        }
        cdebug("  registered templates: %lld\n", this.generic_registry.template_count());
        const entry: TemplateEntry* = this.generic_registry.get_template_by_type_id(request.base_type.id);
        if (entry == null) {
            this.diagnostics.emit(Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("no template found for type ID %llu", request.base_type.id)));
            return false;
        }

        return this.specialize_with_entry(request, key, entry);
    }

    // `request` is BORROWED, not taken by value: it carries an owning
    // `type_args: TypeRef[]` and the caller (`specialize_request`) already
    // only holds a borrow, so a by-value parameter would bitwise-copy the
    // struct - aliasing the caller's type_args buffer - and the by-value
    // copy's scope-exit drop would free a buffer the caller still owns and
    // re-frees (double free).  All uses below are reads, so a borrow is
    // sufficient.
    specialize_with_entry(mut &this, request: &MonomorphRequest, key: string,
                          entry: TemplateEntry*) -> boolean {
        // Validate arg count
        if (request.type_args.length != entry.param_count) {
            const qn_str: string = this.intern_table.resolve(entry.qualified_name);
            this.diagnostics.emit(Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("arg count mismatch for %s: expected %lld, got %lld",
                        qn_str, entry.param_count, request.type_args.length)));
            return false;
        }

        // Build display names for type args.
        // Use the qualified name for user-defined types so that
        // resolve_func_signature can find cross-module types in the arena.
        // e.g., Option<Layout> where Layout is from alloc::global; the
        // substituted annotation becomes Named("std::alloc::global::Layout")
        // which resolves via arena lookup regardless of the template's module.
        mut type_arg_displays: string[] = [];
        for (mut i: i64 = 0; i < request.type_args.length; i++) {
            const arg_t: Type* = this.arena.lookup(request.type_args[i].id);
            if (arg_t != null) {
                // For user-defined types, use the qualified name from the arena
                // so that cross-module resolution works.  For primitives,
                // display_name() already returns the correct name.
                const qname: SymbolStr = this.arena.get_qualified_name(request.type_args[i]);
                if (qname.is_valid()) {
                    type_arg_displays.push(this.intern_table.resolve(qname));
                } else {
                    // Use format_display() instead of display_name() so that
                    // compound types (InstantiatedType, Pointer, etc.) get
                    // properly resolved through the arena instead of falling
                    // back to raw TypeRef IDs.
                    type_arg_displays.push(this.arena.format_display(arg_t));
                }
            } else {
                type_arg_displays.push(format("unknown_%llu", request.type_args[i].id));
            }
        }

        // Call AST specializer
        const result: SpecializationResult = this.specializer.specialize(
            entry, request.type_args, type_arg_displays
        );
        if (!result.success) {
            const qn_str: string = this.intern_table.resolve(entry.qualified_name);
            mut args_str: string = "";
            for (mut ai: i64 = 0; ai < type_arg_displays.length; ai++) {
                if (ai > 0) { args_str = format("%s,%s", args_str, type_arg_displays[ai]); }
                else        { args_str = type_arg_displays[ai]; }
            }
            this.diagnostics.emit(Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("specialization failed for %s<%s>: %s",
                        qn_str, args_str, result.error_message)));
            return false;
        }

        // Intern the specialized name for type system use
        const spec_name_sym: SymbolStr = this.intern_table.intern(result.spec_name);

        // Build the *qualified* specialized name for the arena.
        // Regular types live in the arena under qualified names (e.g. "BattleTest::Pair"),
        // so monomorphized types must too (e.g. "BattleTest::Pair_string").
        // Extract the namespace prefix from the template's qualified name.
        const qualified_spec_sym: SymbolStr = this.qualify_spec_name(entry, result.spec_name);

        // Create concrete type in arena based on node kind
        const subst: TypeSubstitution = TypeSubstitution::from_params(
            entry.param_type_ids, request.type_args
        );

        // Drop impls and methods whose where-bounds aren't satisfied for
        // this substitution.  A bounds-violating impl/method is genuinely
        // inapplicable to this spec; sema's call-site bounds check would
        // reject any user code trying to invoke it, so there's no valid
        // call site that can ever reach the spec'd version.  Removing
        // them here (rather than cloning + flagging + filtering at every
        // downstream consumer) means:
        //   * resolve_specialized_ast never sees an uncompilable body
        //   * DI registration never indexes a junk signature
        //   * the mangler never sees an invalid TypeRef
        // and there's no `bounds_disabled` flag to forget to check.
        this.filter_bounds_violating_methods(result.specialized_ast, &subst);
        const kept_impl_asts: ASTNode*[] = this.filter_bounds_violating_impls(
            result.impl_asts, &subst);

        const concrete_type: TypeRef = this.create_concrete_type(entry, qualified_spec_sym, &subst);

        // Register the bare spec name as an alias in the arena so that
        // resolve_body_locals() can find the type.  The ASTTypeSubstituter
        // rewrites annotations to bare names (e.g. "Triple_i32_string"),
        // but create_concrete_type registered under the qualified name
        // ("Collections::Pair::Triple_i32_string").  Without the alias,
        // local variable type resolution fails in method bodies.
        if (concrete_type.is_valid() && !spec_name_sym.equals(qualified_spec_sym)) {
            this.arena.add_name_alias(spec_name_sym, concrete_type);
        }

        // Set human-readable display name (e.g., "Pair<i32, string>") on the
        // concrete type so debug output shows the generic form, not the mangled name.
        if (concrete_type.is_valid()) {
            const inst_for_name: Type* = this.arena.lookup(request.generic_type.id);
            if (inst_for_name != null) {
                const display: string = this.arena.format_display(inst_for_name);
                const concrete_t: Type* = this.arena.lookup(concrete_type.id);
                if (concrete_t != null) {
                    if (concrete_t.kind == TypeKind::Struct) {
                        const st: StructType* = concrete_t as StructType*;
                        st.set_display_name(display);
                    } else if (concrete_t.kind == TypeKind::Enum) {
                        const et: EnumType* = concrete_t as EnumType*;
                        et.set_display_name(display);
                    } else if (concrete_t.kind == TypeKind::Class) {
                        const ct: ClassType* = concrete_t as ClassType*;
                        ct.set_display_name(display);
                    }
                }
            }
        }

        // SCOPE-SWITCHED REGION (see matching restore at end of region).
        //
        // Temporarily switch the Resolver to the template's module scope
        // so that names imported by the template's module (e.g. Option,
        // Result, AllocError) can be resolved through the scope chain.
        // This wraps BOTH AST resolution AND type population so that
        // enum variant payload types also resolve in the correct scope.
        //
        // !!! DO NOT add early returns or `panic` paths between this line
        // and the matching `// END SCOPE-SWITCHED REGION` marker.  The
        // resolver's scope state is process-global; bailing out here
        // leaves the wrong scope active for every subsequent
        // specialization in the same pipeline run, which surfaces as
        // bizarre cross-module name-resolution failures that are very
        // hard to diagnose.  If you need to bail, jump to the restore
        // first and then return.
        mut saved_scope: u64 = 0;
        if (this.type_resolver.name_resolver != null && entry.module_name.is_valid()) {
            const mod_name: string = this.intern_table.resolve(entry.module_name);
            saved_scope = this.type_resolver.name_resolver.get_current_scope_id();
            const template_scope: u64 = this.type_resolver.name_resolver.find_module_scope(mod_name);
            if (template_scope > 0) {
                this.type_resolver.name_resolver.set_module_with_scope(
                    entry.module_name, template_scope);
            }
        }

        // Re-resolve type annotations on the specialized AST.  The
        // InstantiatedType wrapper (request.generic_type) is passed as
        // the `this_type` for method bodies (not the concrete struct).
        // The wrapper is what `unify_for_inference` needs to recover
        // (base, type_args) when matching a still-generic formal like
        // `mut &HashMap<K, V, A>`.  Its `resolved_type -> concrete_type`
        // link isn't installed until `populate_concrete_type` runs
        // below (after this re-resolution), so a `find_inst_wrapping`
        // search keyed off `concrete_type` would miss right now.
        const this_type_for_methods: TypeRef = if (request.generic_type.is_valid()) {
            request.generic_type
        } else {
            concrete_type
        };
        // Stash the in-progress struct AST so resolve_arg_type_for_inference
        // can read `this.field` types via the spec'd FieldDeclNodes (which
        // already have resolved_type set by the resolve_fields call inside
        // resolve_specialized_ast).  The InstantiatedType wrapper's own
        // resolved_type isn't installed until populate_concrete_type below.
        const prev_spec_inst_id: u64 = this.current_spec_inst_id;
        const prev_spec_struct:  StructDeclNode* = this.current_spec_struct;
        if ((entry.node_kind == NodeKind::StructDeclaration ||
             entry.node_kind == NodeKind::ClassDeclaration) &&
            result.specialized_ast != null && request.generic_type.is_valid()) {
            this.current_spec_inst_id = request.generic_type.id;
            this.current_spec_struct  = result.specialized_ast as StructDeclNode*;
        }
        this.resolve_specialized_ast(result.specialized_ast, entry.node_kind, entry, &subst, this_type_for_methods);
        for (mut ri: i64 = 0; ri < kept_impl_asts.length; ri++) {
            this.resolve_specialized_ast(kept_impl_asts[ri], NodeKind::ImplementationBlock, entry, &subst, this_type_for_methods);
        }
        this.current_spec_inst_id = prev_spec_inst_id;
        this.current_spec_struct  = prev_spec_struct;

        // Populate the concrete type and set resolved_type on the InstantiatedType.
        // For type templates (struct/enum/class): populate fields/variants from
        // the specialized AST, then set resolved_type to the concrete arena type.
        // For function templates: create a FunctionType from the resolved signature
        // so that InstantiatedType.resolved_type is valid for ALL generics; no
        // special-casing needed in GenericValidation or codegen.
        if (concrete_type.is_valid()) {
            this.populate_concrete_type(concrete_type, result.specialized_ast, entry.node_kind, &subst, entry);

            const inst_t: Type* = this.arena.lookup(request.generic_type.id);
            if (inst_t != null) {
                const inst: InstantiatedType* = inst_t as InstantiatedType*;
                inst.set_resolved_type(concrete_type);
            }
            // Sema can create an InstantiatedType for a generic before the
            // monomorphizer hands its own `request.generic_type` to this
            // path, and the arena cache keeps them as one slot, but on
            // rare substituter-driven paths multiple slots still exist, so
            // propagate to any others with the same (base, args).
            this.arena.propagate_instantiated_resolution(
                request.base_type, request.type_args, concrete_type);
        } else if (entry.node_kind == NodeKind::FunctionDeclaration) {
            // Function templates don't create named arena types (no struct/enum),
            // but we still create a concrete FunctionType from the resolved
            // signature so the InstantiatedType has a valid resolved_type.
            // This unifies function generics with type generics; every
            // InstantiatedType gets a resolved_type, period.
            const func_type: TypeRef = this.build_function_type_from_ast(result.specialized_ast);
            if (func_type.is_valid()) {
                const inst_t: Type* = this.arena.lookup(request.generic_type.id);
                if (inst_t != null) {
                    const inst: InstantiatedType* = inst_t as InstantiatedType*;
                    inst.set_resolved_type(func_type);
                }
                this.arena.propagate_instantiated_resolution(
                    request.base_type, request.type_args, func_type);
            }
        }

        // Restore the Resolver's scope.  END SCOPE-SWITCHED REGION.
        if (saved_scope > 0 && this.type_resolver.name_resolver != null) {
            this.type_resolver.name_resolver.set_module_with_scope(
                this.current_module, saved_scope);
        }

        // Mark as monomorphized
        this.generic_registry.mark_monomorphized(request.base_type, request.type_args);

        // Cache the result.
        // origin_module is the first module that REQUESTED this instantiation
        // (via instantiate_for_module), so GenericExpressionResolution injects
        // each spec into the module that needs it.  Falls back to the
        // template's module if no demand was recorded (single-file mode).
        mut origin: SymbolStr = this.current_module;
        const demand_modules: SymbolStr[] = this.generic_registry.get_modules_using(key);
        if (demand_modules.length > 0) {
            origin = demand_modules[0];
        } else if (entry.module_name.is_valid()) {
            origin = entry.module_name;
        }
        const spec_entry: SpecializationEntry = SpecializationEntry {
            specialized_type:  concrete_type,
            specialized_name:  spec_name_sym,
            ast_node:          result.specialized_ast,
            impl_nodes:        kept_impl_asts,
            origin_module:     origin,
            template_module:   entry.module_name,
            instantiated_type: request.generic_type,
        };
        const idx: i64 = this.spec_entries.length;
        this.spec_keys.push(key);
        this.spec_entries.push(spec_entry);
        const cache_h: u64 = hash_str(key);
        this.spec_index.insert(key, idx);

        // Discover nested instantiations from the concrete type's fields
        // (struct/enum/class) or the function type's param/return types
        // (function templates).  Function templates set concrete_type to
        // invalid but still need nested discovery; e.g., a generic function
        // returning Option<T> where T is now i32 must trigger Option<i32>.
        if (concrete_type.is_valid()) {
            this.nested_visited = [];
            this.request_nested_instantiations(concrete_type);
        } else if (entry.node_kind == NodeKind::FunctionDeclaration) {
            const inst_t: Type* = this.arena.lookup(request.generic_type.id);
            if (inst_t != null) {
                const inst: InstantiatedType* = inst_t as InstantiatedType*;
                if (inst.resolved_type.is_valid()) {
                    this.nested_visited = [];
                    this.request_nested_instantiations(inst.resolved_type);
                }
            }
        }
        return true;
    }


    // Concrete type creation

    create_concrete_type(mut &this, entry: TemplateEntry*, spec_name: SymbolStr,
                         subst: TypeSubstitution*) -> TypeRef {
        return match (entry.node_kind) {
            NodeKind::StructDeclaration => {
                this.arena.create_struct(spec_name, entry.module_name)
            }
            NodeKind::EnumDeclaration => {
                this.arena.create_enum(spec_name, entry.module_name)
            }
            NodeKind::ClassDeclaration => {
                this.arena.create_class(spec_name, entry.module_name)
            }
            NodeKind::FunctionDeclaration => {
                // Generic functions don't create arena types; they just
                // produce specialized AST declarations.  Return invalid
                // to signal that specialize_with_entry should skip type
                // population and resolved_type assignment.
                TypeRef::invalid()
            }
            _ => {
                this.arena.create_struct(spec_name, entry.module_name)
            }
        };
    }


    // Name qualification

    /// Build a qualified specialized name from the template's qualified name
    /// and the bare specialized name.
    /// E.g. template qualified "BattleTest::Pair" + spec "Pair_string" -> "BattleTest::Pair_string"
    /// If the template has no namespace prefix, returns the bare spec name.
    qualify_spec_name(&this, entry: TemplateEntry*, spec_name: string) -> SymbolStr {
        const qualified_str: string = this.intern_table.resolve(entry.qualified_name);
        const bare_str: string = this.intern_table.resolve(entry.name);

        // Find the namespace prefix by locating the bare name at the end
        // of the qualified name.  If qualified == bare, there is no namespace.
        const q_len: i64 = strlen(qualified_str) as i64;
        const b_len: i64 = strlen(bare_str) as i64;
        if (q_len <= b_len) {
            // No namespace prefix; return bare spec name
            return this.intern_table.intern(spec_name);
        }

        // Extract prefix including the "::" separator
        // qualified = "BattleTest::Pair" -> prefix = "BattleTest::"
        const prefix_len: i64 = q_len - b_len;
        const prefix: string = substr(qualified_str, 0, prefix_len);
        return this.intern_table.intern(prefix + spec_name);
    }


    // Re-resolution: fill resolved_type on the specialized AST

    /// Walk the specialized AST and resolve all type annotations into
    /// concrete TypeRefs.  After cloning + substitution, the AST has
    /// concrete type annotation strings (e.g., Named("i32")) but all
    /// resolved_type fields are invalid.  This step fills them.
    ///
    /// Uses the template entry's module name to build a proper resolution
    /// context so that cross-module and user-defined types resolve correctly
    /// through the Resolver's scope chain.
    resolve_specialized_ast(mut &this, ast_node: ASTNode*, node_kind: NodeKind,
                            entry: TemplateEntry*, subst: TypeSubstitution*,
                            this_type: TypeRef) -> void {
        if (ast_node == null || this.type_resolver == null) { return; }

        mut module_name: string = "";
        if (entry != null && entry.module_name.is_valid()) {
            module_name = this.intern_table.resolve(entry.module_name);
        }
        mut res_ctx: ResolutionContext = ResolutionContext::new(module_name, "");

        match (node_kind) {
            NodeKind::StructDeclaration => {
                const decl: StructDeclNode* = ast_node as StructDeclNode*;
                if (decl == null) { return; }
                this.type_resolver.resolve_fields(decl.fields, &res_ctx);
                this.resolve_methods(decl.methods, &res_ctx, subst, this_type);
            }
            NodeKind::ClassDeclaration => {
                const decl: ClassDeclNode* = ast_node as ClassDeclNode*;
                if (decl == null) { return; }
                this.type_resolver.resolve_fields(decl.fields, &res_ctx);
                this.resolve_methods(decl.methods, &res_ctx, subst, this_type);
            }
            NodeKind::EnumDeclaration => {
                // Enum variants use SymbolStr names, not type annotations.
                // Resolution handled in populate_enum_variants via name lookup.
            }
            NodeKind::FunctionDeclaration => {
                const decl: FunctionDeclNode* = ast_node as FunctionDeclNode*;
                if (decl == null) { return; }
                // Free functions have no `this`.
                this.resolve_func_and_body(decl, &res_ctx, subst, TypeRef::invalid());
            }
            NodeKind::ImplementationBlock => {
                const decl: ImplBlockNode* = ast_node as ImplBlockNode*;
                if (decl == null) { return; }
                // Impl- and method-level where-bounds were already
                // verified by `filter_bounds_violating_impls` /
                // `filter_bounds_violating_methods` in
                // `specialize_with_entry`; bounds-violating impls
                // and methods were stripped pre-clone and never reach
                // this resolver.
                //
                // Bind the trait's outer generic params to the impl's
                // trait args.  ASTTypeSubstituter only rewrites names
                // in `param_names` (the impl's own `<T,...>`), so trait
                // generics like `Iterator<Item>`'s `Item` survive
                // substitution as bare `Named("Item")` annotations.
                // Without binding `Item` to the impl's concrete arg
                // here, cloned default-method bodies (e.g. `fold<Acc>`'s
                // `f: (Acc, Item) -> Acc`) re-resolve through this
                // empty context, the inner `Item` lookup misses, and
                // the resulting FunctionType has an invalid TypeRef
                // in its param list, which the mangler later encodes
                // as `v`, pinning a junk symbol.
                //
                // First derive any impl-introduced generic the Self type
                // doesn't determine (e.g. `A` in `implement<I, A> Iterator<A>
                // for TakeN<I> where I: Iterator<A>`) from the where-bounds,
                // so both the trait-arg binding below and the method
                // signatures resolve it concretely.
                this.derive_impl_where_generics(decl, subst, &res_ctx);
                this.bind_trait_args_for_spec_impl(decl, &res_ctx);
                // Persist the concrete trait-element bindings (`A -> i32`,
                // `Item -> i32`) onto the spec'd impl.  Self-returning default
                // combinators (`map`/`filter`) are skipped by `resolve_methods`
                // below (instantiated lazily at call sites), so their cloned
                // signatures keep the bare element name (`A`) unresolved.  When
                // a chained call (`r.take(n).map(f)`) later specializes such a
                // default via `specialize_method`, it re-seeds these bindings so
                // the element resolves concretely.  Only concrete bindings are
                // kept (a residual generic param would mint a bogus spec).  This
                // is a pure snapshot of the already-populated context - it does
                // NOT re-enter the resolver, avoiding the re-entrancy that the
                // where-clause derivation machinery is not safe for here.
                this.cache_derived_trait_params(decl, &res_ctx);
                this.resolve_methods(decl.methods, &res_ctx, subst, this_type);
            }
            _ => {}
        }
    }

    /// Resolve signatures on an array of methods; delegates core signature
    /// resolution to TypeResolver, then resolves body locals.
    resolve_methods(mut &this, methods: &MethodNode*[], res_ctx: ResolutionContext*,
                    subst: TypeSubstitution*, this_type: TypeRef) -> void {
        // Share `nested_visited` across all methods in this impl block so
        // repeated return types (e.g. the common Option<T> return) only
        // produce a single monomorphization request per impl.
        this.nested_visited = [];
        for (mut i: i64 = 0; i < methods.length; i++) {
            const method: MethodNode* = methods[i];
            if (method == null || method.func == null) { continue; }
            // Self-returning trait defaults (combinators like `map`/`take`
            // returning an adapter over `This`) are instantiated lazily at
            // call sites, never eagerly: synthesized into an adapter's own
            // impl, eager resolution would request `Adapter<Adapter<…>>`
            // without bound, recursing forever.  Skip here; the call-site
            // inference path (`try_infer_method_call`) specializes the ones
            // that are actually invoked.
            if (method.func.is_self_returning_default) { continue; }
            // Per-method where-bounds were already verified by
            // `filter_bounds_violating_methods` /
            // `filter_bounds_violating_impls` in `specialize_with_entry`;
            // bounds-violating methods were dropped pre-clone and never
            // reach this resolver.
            // Static methods don't take `this`; pass invalid so the
            // inference walker doesn't seed a spurious `this` binding.
            const m_this: TypeRef = if (method.is_static) {
                TypeRef::invalid()
            } else {
                this_type
            };
            // If the method has its own generic params (e.g. `hash<H>`
            // on a spec'd `implement<A> trait Hash for String<A>`), bind
            // them in a per-method resolution context before signature
            // resolution.  Without this, the cloned method's params
            // (whose resolved_type was reset by ASTCloner) re-resolve
            // through `resolve_func_signature` with H unbound, and the
            // Reference branch of the resolver builds `Reference(invalid)`
            // rather than `Reference(GenericParam_H)`, baking a `Rv`
            // (Reference-void) into the spec'd method's mangled name.
            if (method.func.is_generic()) {
                mut method_ctx: ResolutionContext = res_ctx.clone();
                for (mut j: i64 = 0; j < method.func.generic_params.length; j++) {
                    const gp: GenericParamNode* = method.func.generic_params[j];
                    if (gp == null) { continue; }
                    const gp_ref: TypeRef = this.arena.create_generic_param(
                        gp.name, j as u64);
                    method_ctx.add_binding(gp.name, gp_ref);
                }
                this.resolve_func_and_body(method.func, &method_ctx, subst, m_this);
            } else {
                this.resolve_func_and_body(method.func, res_ctx, subst, m_this);
            }
        }
    }

    /// Check that every `where`-clause TraitBound on `func` has a registered
    /// impl for the substituted type. Returns true when there are no bounds,
    /// when every bound has a registered impl, or when the substitution is
    /// missing entirely (e.g. a non-generic context). Returns false only
    /// when at least one bound's impl is *known absent*; in that case the
    /// caller should skip body specialization for this method.
    method_bounds_satisfied(&this, func: FunctionDeclNode*,
                            subst: TypeSubstitution*) -> boolean {
        if (func == null) { return true; }
        if (func.trait_bounds.length == 0) { return true; }
        return this.bounds_satisfied(func.trait_bounds, subst);
    }

    /// For a spec'd trait impl block, bind the trait's outer generic
    /// param names to the concrete trait args inside `res_ctx`.  Mirrors
    /// `TypeResolutionPasses::bind_trait_args_for_impl`, but operates on
    /// already-spec'd impls whose `trait_annotation` carries concrete
    /// args after `ASTTypeSubstituter` ran.
    ///
    /// Concrete case: `implement<T> trait Iterator<T> for Bar<T>` gets
    /// specialized to `T -> u8` by ASTSpecializer.  The clone's
    /// `trait_annotation` becomes `Generic(Iterator, [u8])`.  But the
    /// substituter only rewrites names in the impl's own `param_names`
    /// (= `[T]`); the trait's generic-param names like `Item` survive
    /// inside any annotation that mentioned them (e.g. fold's
    /// `f: (Acc, Item) -> Acc`).  Without binding `Item -> u8` here,
    /// the cloned default body's `Item` lookup misses and the resulting
    /// FunctionType has an invalid internal param.
    bind_trait_args_for_spec_impl(mut &this, impl_node: ImplBlockNode*,
                                   res_ctx: ResolutionContext*) -> void {
        if (impl_node == null || !impl_node.is_trait_impl()) { return; }
        const trait_ann: TypeAnnotation* = impl_node.trait_annotation;
        if (trait_ann == null) { return; }

        // Extract concrete args.  Mirrors TypeResolutionPasses::extract_trait_args.
        mut trait_args: TypeAnnotation*[] = [];
        match (*trait_ann) {
            TypeAnnotation::Generic(g) => { trait_args = g.args; }
            _ => { return; }
        }
        if (trait_args.length == 0) { return; }

        // Extract the trait's bare leaf name to look up its decl.
        mut trait_leaf: SymbolStr = SymbolStr::empty();
        match (*trait_ann) {
            TypeAnnotation::Named(n) => { trait_leaf = n.name; }
            TypeAnnotation::Generic(g) => {
                match (*g.base) {
                    TypeAnnotation::Named(n) => { trait_leaf = n.name; }
                    _ => {}
                }
            }
            _ => {}
        }
        if (!trait_leaf.is_valid()) { return; }
        if (this.generic_registry == null) { return; }
        const trait_decl: TraitDeclNode* = this.generic_registry.get_trait_decl(trait_leaf);
        if (trait_decl == null) { return; }
        if (trait_decl.generic_params.length != trait_args.length) { return; }

        for (mut i: i64 = 0; i < trait_args.length; i++) {
            const gp: GenericParamNode* = trait_decl.generic_params[i];
            if (gp == null) { continue; }
            const arg_ty: TypeRef = this.type_resolver.resolve(trait_args[i], res_ctx);
            if (!arg_ty.is_valid()) { continue; }
            res_ctx.add_binding(gp.name, arg_ty);
        }
    }

    /// Given a concrete type `subject` (e.g. `Range<i32>`) and a bare trait
    /// leaf name (e.g. `Iterator`), return the concrete trait args of
    /// `subject`'s impl of that trait (e.g. `[i32]`).  Empty on any failure.
    ///
    /// Works from the template impl plus `subject`'s own type args, so it
    /// doesn't depend on `subject` having been monomorphized yet: bind the
    /// subject impl's params (`T` in `implement<T> Iterator<T> for Range<T>`)
    /// to `subject`'s concrete args (`i32`), then resolve the impl's
    /// `trait_annotation` args under that binding.
    concrete_trait_args_for(mut &this, subject_in: TypeRef,
                            trait_leaf: SymbolStr) -> TypeRef[] {
        mut out: TypeRef[] = [];
        if (this.generic_registry == null || this.type_resolver == null) { return out; }
        // The monomorphizer often binds a where-clause param straight to the
        // concrete spec'd Struct/Class/Enum (e.g. `I := Range<i32>` struct)
        // rather than its InstantiatedType wrapper. A concrete spec's bare
        // name is its MANGLED spec name (`5Range$Li$G`), so the trait-impl
        // lookup below — keyed on the template's bare name (`Range`) — would
        // miss, and the wrapper's type args (needed to bind the trait's
        // generic, e.g. deriving `A := i32` from `Range<i32>: Iterator<i32>`)
        // would be unavailable. Recover the wrapper first. Mirrors the same
        // recovery in `type_implements_trait`.
        mut subject: TypeRef = subject_in;
        const subj_t: Type* = this.arena.lookup(subject_in.id);
        if (subj_t != null
                && (subj_t.kind == TypeKind::Struct
                    || subj_t.kind == TypeKind::Class
                    || subj_t.kind == TypeKind::Enum)) {
            const wrapper: TypeRef = find_inst_wrapping(this.arena, subject_in);
            if (wrapper.is_valid()) { subject = wrapper; }
        }
        const base_name: SymbolStr = this.bare_name_of(subject);
        if (!base_name.is_valid()) { return out; }
        const impl_node: ImplBlockNode* =
            this.generic_registry.lookup_trait_impl(trait_leaf, base_name);
        if (impl_node == null) { return out; }
        const trait_ann: TypeAnnotation* = impl_node.trait_annotation;
        if (trait_ann == null) { return out; }

        mut ctx: ResolutionContext = ResolutionContext::new("", "");
        const st: Type* = this.arena.lookup(subject.id);
        if (st != null && st.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = st as InstantiatedType*;
            // Bind the struct's OWN params from the TARGET args (`I` in
            // `for TakeIter<I>`), not the full generic-param list - a
            // where-clause can introduce extra generics (`A`) the struct
            // doesn't carry.
            mut subst: TypeSubstitution = TypeSubstitution::empty();
            if (impl_node.target_args.length == inst.type_args.length) {
                for (mut i: i64 = 0; i < impl_node.target_args.length; i++) {
                    const ta: TypeAnnotation* = impl_node.target_args[i];
                    if (ta == null) { continue; }
                    match (*ta) {
                        TypeAnnotation::Named(n) => {
                            ctx.add_binding(n.name, inst.type_args[i]);
                            const gp_ref: TypeRef =
                                this.arena.create_generic_param(n.name, i as u64);
                            subst.add(gp_ref.id, inst.type_args[i]);
                        }
                        _ => {}
                    }
                }
            }
            // Derive any where-clause-introduced generic the struct args don't
            // determine (e.g. `A` in `implement<I,A> Iterator<A> for TakeIter<I>
            // where I: Iterator<A>`).  Without this, an adapter subject's trait
            // arg (`A`) stays an unbound `Named("A")` and the trait-arg list
            // below carries an invalid TypeRef - which surfaces when the trait
            // arg is itself another adapter's element type (chaining).
            this.derive_impl_where_generics(impl_node, &subst, &ctx);
        }

        match (*trait_ann) {
            TypeAnnotation::Generic(g) => {
                for (mut i: i64 = 0; i < g.args.length; i++) {
                    out.push(this.type_resolver.resolve(g.args[i], &ctx));
                }
            }
            _ => {}
        }
        return out;
    }

    /// Bind impl-introduced generic params that the Self type doesn't
    /// determine (e.g. `A` in `implement<I, A> Iterator<A> for TakeN<I>
    /// where I: Iterator<A>`) into `res_ctx`, by resolving each where-bound
    /// against the concrete subject.  Here `I` is bound by the struct subst
    /// to `Range<i32>`; the bound `I: Iterator<A>` then pins `A` to
    /// `Range<i32>`'s Iterator element (`i32`).  Without this the cloned
    /// method bodies re-resolve `A` through an empty context, leaving an
    /// invalid TypeRef in the signature that aborts the mangler.  Run before
    /// `bind_trait_args_for_spec_impl` so the trait-arg binding can also see
    /// the derived param.
    derive_impl_where_generics(mut &this, impl_node: ImplBlockNode*,
                               subst: TypeSubstitution*,
                               res_ctx: ResolutionContext*) -> void {
        if (impl_node == null || subst == null) { return; }
        if (impl_node.where_bounds.length == 0) { return; }
        for (mut bi: i64 = 0; bi < impl_node.where_bounds.length; bi++) {
            const bound: TraitBound* = &impl_node.where_bounds[bi];
            // The subject (e.g. `I`) must be determined by the instantiation;
            // otherwise the bound can't be resolved to a concrete type here.
            const subject: TypeRef = this.lookup_subst_for_param(
                bound.type_parameter, subst);
            if (!subject.is_valid()) { continue; }
            for (mut ti: i64 = 0; ti < bound.trait_refs.length; ti++) {
                const tr: TraitRef* = &bound.trait_refs[ti];
                if (tr.path.length == 0) { continue; }
                const trait_leaf: SymbolStr = tr.path[tr.path.length - 1];
                const concrete_args: TypeRef[] =
                    this.concrete_trait_args_for(subject, trait_leaf);
                if (concrete_args.length != tr.type_args.length) { continue; }
                for (mut ai: i64 = 0; ai < tr.type_args.length; ai++) {
                    const ta: TypeAnnotation* = tr.type_args[ai];
                    if (ta == null) { continue; }
                    this.bind_where_arg_param(ta, concrete_args[ai], subst, res_ctx);
                }
            }
        }
    }

    /// Snapshot the concrete generic bindings accumulated in `res_ctx` (by
    /// `derive_impl_where_generics` + `bind_trait_args_for_spec_impl`) onto the
    /// spec'd impl node, so a self-returning default specialized later can
    /// recover the trait element it doesn't carry as a struct parameter.  Only
    /// fully-concrete bindings are kept: a binding still containing a generic
    /// param would let `specialize_method` resolve a partially-generic signature
    /// and mint a bogus spec (a GenericParam reads as "resolved" to the mangler).
    cache_derived_trait_params(mut &this, impl_node: ImplBlockNode*,
                               res_ctx: ResolutionContext*) -> void {
        if (impl_node == null || res_ctx == null) { return; }
        for (mut i: i64 = 0; i < res_ctx.generic_bindings.length; i++) {
            const name: SymbolStr = res_ctx.generic_bindings[i].first;
            const ty: TypeRef = res_ctx.generic_bindings[i].second;
            if (!ty.is_valid()) { continue; }
            if (this.type_contains_generic_param(ty)) { continue; }
            if (impl_node.lookup_derived_param(name).is_valid()) { continue; }
            impl_node.add_derived_param(name, ty);
        }
    }

    /// Bind a where-bound trait-arg annotation against a concrete trait
    /// arg, descending through pointer/reference wrappers so a param that
    /// appears only *inside* a pointer can still be recovered. Examples:
    ///
    ///   bound `I: Iterator<A>`  vs concrete `Iterator<i32>`   -> A = i32
    ///   bound `I: Iterator<T*>` vs concrete `Iterator<i32*>`  -> T = i32
    ///   bound `I: Iterator<&T>` vs concrete `Iterator<&i32>`  -> T = i32
    ///
    /// The bare-`Named` case is the original behaviour (TakeIter's `A`);
    /// the pointer/reference cases are what let by-reference adapters
    /// (`CopiedIter<I> where I: Iterator<T*>`) recover their element type
    /// `T` from the inner iterator instead of carrying it as an explicit
    /// struct parameter. Peeling stops when the annotation and the
    /// concrete type stop agreeing in shape (the bound just pins nothing).
    bind_where_arg_param(mut &this, ta: TypeAnnotation*, concrete: TypeRef,
                         subst: TypeSubstitution*,
                         res_ctx: ResolutionContext*) -> void {
        if (ta == null || !concrete.is_valid()) { return; }
        match (*ta) {
            TypeAnnotation::Named(n) => {
                // Bind a where-bound param (e.g. `A` / `T`) that the
                // Self-type substitution doesn't already fix and that
                // isn't already bound. The spec'd impl clone has its
                // `generic_params` cleared, so we can't gate on membership
                // there; the subst/res_ctx checks keep this from rebinding
                // a concrete param.
                if (this.lookup_subst_for_param(n.name, subst).is_invalid()
                        && res_ctx.lookup_binding(n.name).is_invalid()) {
                    res_ctx.add_binding(n.name, concrete);
                }
            }
            TypeAnnotation::Pointer(p) => {
                // `T*` vs a concrete `i32*`: peel one pointer layer off
                // both sides and recurse on `T` vs `i32`.
                const inner: TypeRef = this.peel_pointer_pointee(concrete);
                if (inner.is_valid()) {
                    this.bind_where_arg_param(p.inner, inner, subst, res_ctx);
                }
            }
            TypeAnnotation::Reference(r) => {
                const inner: TypeRef = this.peel_reference_referent(concrete);
                if (inner.is_valid()) {
                    this.bind_where_arg_param(r.inner, inner, subst, res_ctx);
                }
            }
            _ => {}
        }
    }

    /// Pointee of a concrete pointer TypeRef, or invalid if not a pointer.
    peel_pointer_pointee(&this, t: TypeRef) -> TypeRef {
        const ty: Type* = this.arena.lookup(t.id);
        if (ty != null && ty.kind == TypeKind::Pointer) {
            return (ty as PointerType*).pointee;
        }
        return TypeRef::invalid();
    }

    /// Referent of a concrete reference TypeRef, or invalid if not a ref.
    peel_reference_referent(&this, t: TypeRef) -> TypeRef {
        const ty: Type* = this.arena.lookup(t.id);
        if (ty != null && ty.kind == TypeKind::Reference) {
            return (ty as ReferenceType*).referent;
        }
        return TypeRef::invalid();
    }

    /// Check that every TraitBound in `bounds` has a registered trait-impl
    /// for the substituted concrete type. Returns true on no bounds or
    /// no substitution. Returns false when at least one bound is known
    /// absent OR when we can't resolve the target type to a registry key
    /// The second case is conservative: dropping a body for a type we
    /// don't know how to name is safer than letting codegen attempt to
    /// emit a call to a method that has no impl (which segfaults the
    /// monomorphizer's unguarded MemberAccess path).
    bounds_satisfied(&this, bounds: &TraitBound[], subst: TypeSubstitution*) -> boolean {
        if (bounds.length == 0) { return true; }
        if (subst == null || subst.replacements.length == 0) { return true; }
        for (mut bi: i64 = 0; bi < bounds.length; bi++) {
            const bound: TraitBound* = &bounds[bi];
            const concrete: TypeRef = this.lookup_subst_for_param(bound.type_parameter, subst);
            if (!concrete.is_valid()) {
                // No substitution for this param; the bound names a
                // generic the caller didn't supply.  This is normal for
                // method-level generics (e.g. `hash<H> where H: Hasher`
                // inside an impl that's only substituting outer params
                // like `A`): the bound applies at method-spec time, not
                // at impl-spec time.  Skip this bound rather than
                // wholesale failing; preserving the method body so the
                // method-call inference pass can clone+substitute it
                // for a concrete H later.
                continue;
            }
            for (mut ri: i64 = 0; ri < bound.trait_refs.length; ri++) {
                const tref: TraitRef* = &bound.trait_refs[ri];
                if (tref.path.length == 0) { continue; }
                const trait_name: SymbolStr = tref.path[tref.path.length - 1];
                if (!this.type_implements_trait(concrete, trait_name, 0)) {
                    return false;
                }
            }
        }
        return true;
    }

    /// Drop methods whose own where-bounds aren't satisfied by `subst`
    /// from the spec'd type's inherent-method list.  Operates in-place
    /// on Struct/Class/Enum AST nodes; no-op for other kinds.
    ///
    /// Called pre-resolution so that resolve_specialized_ast never
    /// type-checks an inherent method whose body would call non-existent
    /// methods on the substituted concrete types (e.g.
    /// `Result::contains where T: Eq` cloned for `Result<T, E>` where
    /// `T` doesn't implement `Eq`).
    filter_bounds_violating_methods(mut &this, ast_node: ASTNode*,
                                     subst: TypeSubstitution*) -> void {
        if (ast_node == null) { return; }
        // Enums have no inline methods; their methods live in
        // `implement enum Foo<T> {...}` blocks routed through impl_asts.
        if (ast_node.kind == NodeKind::StructDeclaration) {
            const decl: StructDeclNode* = ast_node as StructDeclNode*;
            decl.methods = this.filter_methods(decl.methods, subst);
        } else if (ast_node.kind == NodeKind::ClassDeclaration) {
            const decl: ClassDeclNode* = ast_node as ClassDeclNode*;
            decl.methods = this.filter_methods(decl.methods, subst);
        }
    }

    /// Drop bounds-violating impls entirely; for surviving impls, drop
    /// any methods whose own where-bounds don't hold.  Returns the
    /// pruned impl-AST array so callers can plug it into downstream
    /// registration/codegen without touching `result.impl_asts`.
    ///
    /// Removing the impl outright (rather than flagging) means no
    /// downstream consumer needs to filter, and the spec'd type
    /// simply won't have the trait method registered, making sema's
    /// "method not found" diagnostic at the call site truthful (the
    /// method genuinely doesn't apply here because its bounds fail).
    filter_bounds_violating_impls(mut &this, impl_asts: &ASTNode*[],
                                   subst: TypeSubstitution*) -> ASTNode*[] {
        mut kept: ASTNode*[] = [];
        for (mut i: i64 = 0; i < impl_asts.length; i++) {
            const impl_ast: ASTNode* = impl_asts[i];
            const impl_node: ImplBlockNode* = impl_ast as ImplBlockNode*;
            if (impl_node == null) { continue; }
            if (!this.bounds_satisfied(impl_node.where_bounds, subst)) {
                continue;
            }
            impl_node.methods = this.filter_methods(impl_node.methods, subst);
            kept.push(impl_ast);
        }
        return kept;
    }

    /// Helper: keep only methods whose per-method where-bounds (the
    /// `where T: Trait` after the signature) are satisfied by `subst`.
    filter_methods(&this, methods: &MethodNode*[],
                    subst: TypeSubstitution*) -> MethodNode*[] {
        mut kept: MethodNode*[] = [];
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null) { continue; }
            if (!this.method_bounds_satisfied(m.func, subst)) {
                continue;
            }
            kept.push(m);
        }
        return kept;
    }

    /// Diagnostic helper: when sema's call-site method lookup misses on
    /// a spec'd type, we want to distinguish "this method genuinely
    /// doesn't exist" from "the trait providing this method has a
    /// where-clause that isn't satisfied for this specialization".
    /// Walks the trait impls registered against `receiver`'s base type
    /// and returns the bare name of the first trait whose impl provides
    /// `method_name` but whose `where_bounds` aren't satisfied for the
    /// receiver's type args.  Returns `SymbolStr::empty()` when no such
    /// trait exists.
    diagnose_method_bounds_failure(&this, receiver: TypeRef,
                                    method_name: SymbolStr) -> SymbolStr {
        if (this.generic_registry == null) { return SymbolStr::empty(); }

        // Sema typically passes the spec'd concrete type (e.g. the
        // Enum for `Result_int_OpaqueErr`) rather than the
        // InstantiatedType wrapper.  `bare_name_of` on a Struct/Class/
        // Enum returns its qualified leaf; for spec'd types that's
        // the mangled spec name (`Result_int_OpaqueErr`), not the
        // template's bare name (`Result`).  Trait impls are registered
        // against the template's bare name, so without walking back
        // to the wrapper here, the registry lookup misses every
        // template impl and we'd silently fall through to the generic
        // "method not found" diagnostic.  Same reasoning applies to
        // the recursive `type_implements_trait` call below; it also
        // requires the InstantiatedType wrapper to substitute the
        // template's generic params with the receiver's type args.
        mut probe_ref: TypeRef = receiver;
        const recv_t: Type* = this.arena.lookup(receiver.id);
        if (recv_t != null && recv_t.kind != TypeKind::InstantiatedType) {
            const wrapper: TypeRef = find_inst_wrapping(this.arena, receiver);
            if (wrapper.is_valid()) { probe_ref = wrapper; }
        }

        const base_name: SymbolStr = this.bare_name_of(probe_ref);
        if (!base_name.is_valid()) { return SymbolStr::empty(); }
        const traits: SymbolStr[] = this.generic_registry.traits_implemented_by(base_name);
        for (mut i: i64 = 0; i < traits.length; i++) {
            const trait_name: SymbolStr = traits[i];
            const impl_block: ImplBlockNode* =
                this.generic_registry.lookup_trait_impl(trait_name, base_name);
            if (impl_block == null) { continue; }
            // Does this impl provide the method we're looking for?
            mut has_method: boolean = false;
            for (mut mi: i64 = 0; mi < impl_block.methods.length; mi++) {
                const m: MethodNode* = impl_block.methods[mi];
                if (m != null && m.func != null && m.func.name.equals(method_name)) {
                    has_method = true;
                    break;
                }
            }
            if (!has_method) { continue; }
            // Method exists; check whether bounds hold for this receiver.
            if (!this.type_implements_trait(probe_ref, trait_name, 0)) {
                return trait_name;
            }
        }
        return SymbolStr::empty();
    }

    /// Recursively check whether a concrete TypeRef implements a trait.
    /// For an InstantiatedType `Option<X>` and trait `Eq`:
    ///   1. Look up the impl block for (Eq, Option). Missing -> false.
    ///   2. If the impl has a `where T: Eq` clause, recursively verify
    ///      `X: Eq` with the impl's generic params bound to the
    ///      InstantiatedType's args.
    /// `depth` guards against pathological loops in cyclic impl chains;
    /// the depth limit is conservative (we don't expect realistic chains
    /// past a handful of levels) and a depleted depth conservatively
    /// returns false so an unsatisfiable bound never accidentally enables
    /// body specialization.
    type_implements_trait(&this, ty: TypeRef, trait_name: SymbolStr, depth: i32) -> boolean {
        if (depth >= 16) { return false; }

        // `Copy` is a structural marker: bound satisfaction is computed
        // by walking the type rather than searching the trait-impl
        // registry. The marker trait declared in core/marker.cryo
        // intentionally has no impl blocks; the compiler is the single
        // source of truth for "is this type bitwise-duplicable".
        const copy_name: SymbolStr = this.intern_table.intern("Copy");
        if (copy_name.is_valid() && trait_name.equals(copy_name)) {
            return OwnershipQuery::is_copy(this.arena, this.generic_registry,
                                            this.intern_table, ty);
        }

        // `Send` and `Sync` follow the same "structural marker" pattern
        // as `Copy`: the compiler decides via a type walk, not via
        // `implement trait Send for T { ... }` lookups.  See
        // OwnershipQuery::is_send / is_sync for the rules.
        const send_name: SymbolStr = this.intern_table.intern("Send");
        if (send_name.is_valid() && trait_name.equals(send_name)) {
            return OwnershipQuery::is_send(this.arena, this.generic_registry,
                                            this.intern_table, ty);
        }
        const sync_name: SymbolStr = this.intern_table.intern("Sync");
        if (sync_name.is_valid() && trait_name.equals(sync_name)) {
            return OwnershipQuery::is_sync(this.arena, this.generic_registry,
                                            this.intern_table, ty);
        }

        // Pointers are non-owning aliases; dropping one is a trivial no-op.
        // Delegate `T*: Drop` to `T: Drop` so primitive pointers (`u8*`,
        // `i32*`, etc.) auto-pass via the primitive Drop impls in
        // stdlib/core/drop.cryo, while pointers to user types still require
        // the pointee to `implement trait Drop`. Avoids needing a parser
        // extension to support pointer impl targets like `for u8*`.
        const drop_name: SymbolStr = this.intern_table.intern("Drop");
        if (drop_name.is_valid() && trait_name.equals(drop_name)) {
            // Pointers/references are non-owning aliases.  Delegate
            // `T*: Drop` to `T: Drop` so primitive pointers auto-pass while
            // pointers to user types require the pointee to impl `Drop`.  This
            // is checked BEFORE the `Copy` rule below: a pointer is itself
            // `Copy`, but a `where T: Drop` container of `T*` must still drop
            // its elements through the pointee's real `Drop` - answering
            // "satisfied" off the pointer's own Copy-ness would wrongly
            // instantiate a container drop whose body derefs to a non-Copy
            // pointee that has no `drop` method.
            const t_ptr: Type* = this.arena.lookup(ty.id);
            if (t_ptr != null && t_ptr.kind == TypeKind::Pointer) {
                const pt: PointerType* = t_ptr as PointerType*;
                return this.type_implements_trait(pt.pointee, trait_name, depth + 1);
            }

            // A non-pointer `Copy` type owns no resources, so dropping it is a
            // no-op: it trivially satisfies `Drop`.  This lets user-defined
            // POD types (all-Copy fields, no `drop`) live in `where T: Drop`
            // containers (`Array`, `Box`, ...) exactly the way primitives do -
            // which carry explicit no-op `Drop` impls in core/drop.cryo -
            // while staying `Copy` so `Array::get` still works.  The matching
            // codegen/sema rules emit nothing for a `.drop()` on such a type.
            if (OwnershipQuery::is_copy(this.arena, this.generic_registry,
                                         this.intern_table, ty)) {
                return true;
            }
        }

        // Normalize the subject to its InstantiatedType wrapper when we
        // were handed the concrete spec'd Struct/Class/Enum directly. The
        // monomorphizer substitutes a where-clause param straight to the
        // concrete spec (e.g. checking `I: Iterator<A>` for `TakeIter<I>`,
        // where `I` was bound to the concrete `Range<i32>` struct rather
        // than its wrapper). A concrete spec struct's bare name is its
        // MANGLED spec name (`5Range$Li$G`), so the trait-impl registry
        // lookup below — keyed on the template's bare name (`Range`) —
        // would miss, and the impl would be wrongly dropped. The wrapper
        // both bare-names back to the template AND carries the type args
        // needed to verify the matched impl's own where-bounds
        // (`Range<T> where T: Step`). Mirrors diagnose_method_bounds_failure.
        mut subject: TypeRef = ty;
        const subj_t0: Type* = this.arena.lookup(ty.id);
        if (subj_t0 != null
                && (subj_t0.kind == TypeKind::Struct
                    || subj_t0.kind == TypeKind::Class
                    || subj_t0.kind == TypeKind::Enum)) {
            const wrapper: TypeRef = find_inst_wrapping(this.arena, ty);
            if (wrapper.is_valid()) { subject = wrapper; }
        }

        const target_name: SymbolStr = this.bare_name_of(subject);
        if (!target_name.is_valid()) { return false; }
        const impl_block: ImplBlockNode* =
            this.generic_registry.lookup_trait_impl(trait_name, target_name);
        if (impl_block == null) {
            // No `implement trait Drop` for this type - but a non-Copy
            // type whose destructor is written as an inherent `drop`
            // method still satisfies Drop: drop-insertion and codegen
            // both resolve `.drop()` to the inherent method (mirroring
            // `is_copy`, which already treats an inherent `drop` as
            // non-Copy).  Without this, a `where T: Drop` container
            // (`Box<T>`, `Rc<T>`, `Array<T>`, ...) rejects any T whose
            // destructor is inline rather than a trait impl, and
            // `Box<T>::drop` is never instantiated -> E0636 at codegen.
            // Container types always carry a trait Drop impl, so they
            // never reach this branch and keep the `where T: Drop` check
            // below.
            if (drop_name.is_valid() && trait_name.equals(drop_name)) {
                return OwnershipQuery::has_inherent_drop(this.arena,
                    this.generic_registry, this.intern_table, ty);
            }
            return false;
        }
        if (impl_block.where_bounds.length == 0) { return true; }
        // Build a fresh substitution from the impl's generic params to
        // the concrete type's args. For `implement<T> trait Eq for Option<T>`
        // and `ty = Option<X>`, the impl's `T` maps to the InstantiatedType's
        // `type_args[0]`.
        const t: Type* = this.arena.lookup(subject.id);
        if (t == null) { return false; }
        if (t.kind != TypeKind::InstantiatedType) {
            // No outer args to substitute through; bounds reference impl
            // params that have no concrete value, so the impl's where
            // clauses can't be checked. Conservatively report unsatisfied
            // so we don't accidentally enable a body that would crash.
            return false;
        }
        const inst: InstantiatedType* = t as InstantiatedType*;
        // Map the impl's TARGET type args - the names the struct itself is
        // parameterized by (`I` in `for TakeIter<I>`) - to the concrete
        // instantiation's args.  This is NOT the same as the impl's full
        // generic-param list: a where-clause can introduce extra generics the
        // struct doesn't carry (`A` in `implement<I, A> Iterator<A> for
        // TakeIter<I> where I: Iterator<A>`), so keying off `generic_params`
        // and requiring it to equal `type_args.length` wrongly rejected every
        // such impl (e.g. the nested `TakeIter<TakeIter<Range<i32>>>` while
        // chaining).  The where-bound check below only needs the target params
        // bound; it looks up bound subjects by name.
        if (impl_block.target_args.length != inst.type_args.length) {
            return false;
        }
        mut nested: TypeSubstitution = TypeSubstitution::empty();
        for (mut gi: i64 = 0; gi < impl_block.target_args.length; gi++) {
            const ta: TypeAnnotation* = impl_block.target_args[gi];
            if (ta == null) { continue; }
            match (*ta) {
                TypeAnnotation::Named(n) => {
                    // `lookup_subst_for_param` keys by the GenericParam's
                    // name, so the index here only has to make a GenericParam
                    // TypeRef; the name is what matters.
                    const gp_ref: TypeRef = this.arena.create_generic_param(n.name, gi as u64);
                    nested.add(gp_ref.id, inst.type_args[gi]);
                }
                _ => {}
            }
        }
        return this.bounds_satisfied_at_depth(impl_block.where_bounds, &nested, depth + 1);
    }

    /// Lenient "does `ty` implement `trait_name`" check for verifying an
    /// `implement Trait` binding annotation against its initializer.
    ///
    /// `type_implements_trait` fully verifies an impl's where-bounds, but it
    /// can't bind where-clause-ONLY generics — e.g. the `T` in
    /// `implement<I, T> Iterator<T> for CopiedIter<I> where I: Iterator<T*>`
    /// is recovered by pointer-peeling at instantiation, which the bound
    /// checker doesn't replay — so it wrongly reports `CopiedIter`/`TakeIter`/
    /// `MapIter`/`FilterIter` as non-implementers. For an opaque-binding
    /// sanity check the precise where-bounds don't matter: it's enough that
    /// the trait is implemented for this type at all (a genuinely unrelated
    /// type has no such impl). Any truly-unsatisfied where-bound still
    /// surfaces precisely at the first trait-method call on the concrete type.
    type_satisfies_opaque_bound(&this, ty: TypeRef, trait_name: SymbolStr) -> boolean {
        if (this.type_implements_trait(ty, trait_name, 0)) { return true; }
        if (this.generic_registry == null) { return false; }
        mut subject: TypeRef = ty;
        const subj_t0: Type* = this.arena.lookup(ty.id);
        if (subj_t0 != null
                && (subj_t0.kind == TypeKind::Struct
                    || subj_t0.kind == TypeKind::Class
                    || subj_t0.kind == TypeKind::Enum)) {
            const wrapper: TypeRef = find_inst_wrapping(this.arena, ty);
            if (wrapper.is_valid()) { subject = wrapper; }
        }
        const target_name: SymbolStr = this.bare_name_of(subject);
        if (!target_name.is_valid()) { return false; }
        return this.generic_registry.lookup_trait_impl(trait_name, target_name) != null;
    }

    /// `bounds_satisfied` with explicit recursion depth, used by
    /// `type_implements_trait` so the recursive chain shares a single
    /// depth budget.
    bounds_satisfied_at_depth(&this, bounds: &TraitBound[],
                               subst: TypeSubstitution*, depth: i32) -> boolean {
        if (bounds.length == 0) { return true; }
        if (subst == null || subst.replacements.length == 0) { return true; }
        for (mut bi: i64 = 0; bi < bounds.length; bi++) {
            const bound: TraitBound* = &bounds[bi];
            const concrete: TypeRef = this.lookup_subst_for_param(bound.type_parameter, subst);
            if (!concrete.is_valid()) { return false; }
            for (mut ri: i64 = 0; ri < bound.trait_refs.length; ri++) {
                const tref: TraitRef* = &bound.trait_refs[ri];
                if (tref.path.length == 0) { continue; }
                const trait_name: SymbolStr = tref.path[tref.path.length - 1];
                if (!this.type_implements_trait(concrete, trait_name, depth)) {
                    return false;
                }
            }
        }
        return true;
    }

    /// Find the substituted concrete TypeRef for a generic param by name.
    lookup_subst_for_param(&this, name: SymbolStr, subst: TypeSubstitution*) -> TypeRef {
        if (subst == null) { return TypeRef::invalid(); }
        for (mut i: i64 = 0; i < subst.param_ids.length; i++) {
            const pt: Type* = this.arena.lookup(subst.param_ids[i]);
            if (pt == null) { continue; }
            if (pt.kind == TypeKind::GenericParam) {
                const gp: GenericParamType* = pt as GenericParamType*;
                if (gp.param_name.equals(name)) { return subst.replacements[i]; }
            } else if (pt.kind == TypeKind::BoundedParam) {
                const bp: BoundedParamType* = pt as BoundedParamType*;
                if (bp.param_name.equals(name)) { return subst.replacements[i]; }
            }
        }
        return TypeRef::invalid();
    }

    /// Return the bare (unqualified) leaf name of a TypeRef, suitable for
    /// keying into the trait-impl registry. For primitives, returns the
    /// display name. For user-defined types, returns the last `::` segment
    /// of the qualified name. Returns empty when no name is available.
    bare_name_of(&this, ty: TypeRef) -> SymbolStr {
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return SymbolStr::empty(); }
        // Primitives carry their name as display_name (e.g. "i32").  Unit
        // hashes under "()" so `implement trait Drop for ()` (and any
        // future trait impls on the unit type) round-trip through the
        // registry.  Void has no value-level uses outside return types,
        // so it stays empty.
        const k: TypeKind = t.kind;
        if (k == TypeKind::Int || k == TypeKind::Float || k == TypeKind::Bool ||
            k == TypeKind::Char || k == TypeKind::String) {
            return this.intern_table.intern(t.display_name());
        }
        if (k == TypeKind::Unit) {
            return this.intern_table.intern("()");
        }
        if (k == TypeKind::Void) {
            return SymbolStr::empty();
        }
        // Generic instantiations: trait impls are registered against the
        // TEMPLATE's bare name (e.g. `implement trait Hash for String`
        // registers `(Hash, String)` regardless of which `String<A>` spec
        // the bound is being checked for). Recurse on `generic_base`
        // instead of unwrapping through `resolved_type`, so a spec like
        // `String<GlobalAlloc>` keys against `String`.
        if (k == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            return this.bare_name_of(inst.generic_base);
        }
        const qname: SymbolStr = this.arena.get_qualified_name(ty);
        if (!qname.is_valid()) { return SymbolStr::empty(); }
        const qstr: string = this.intern_table.resolve(qname);
        const qlen: i64 = strlen(qstr) as i64;
        mut last_sep: i64 = -1;
        for (mut i: i64 = 0; i + 1 < qlen; i++) {
            if (qstr[i] == ':' && qstr[i + 1] == ':') { last_sep = i + 2; }
        }
        if (last_sep < 0) { return qname; }
        mut tail: string = "";
        for (mut i: i64 = last_sep; i < qlen; i++) {
            tail = format("%s%c", tail, qstr[i] as i32);
        }
        return this.intern_table.intern(tail);
    }

    /// Resolve a function's signature (via TypeResolver) and then resolve
    /// local variable types in its body (monomorphizer-specific concern,
    /// since cloned AST bodies have cleared resolved_type fields).
    resolve_func_and_body(mut &this, func: FunctionDeclNode*, res_ctx: ResolutionContext*,
                          subst: TypeSubstitution*, this_type: TypeRef) -> void {
        // Spec'd method clones have their `&this` parameter annotated as
        // `Reference(ThisType)`, which the resolver dispatches via
        // `ctx.this_type`.  When `this_type` is supplied (instance method
        // on a spec'd struct/class), thread it onto a per-call copy of
        // the context so `&this` resolves to `Reference(<spec'd_owner>)`
        // instead of returning invalid.  Without this, every spec'd
        // method's `&this`.resolved_type stays at id=0, the mangler
        // produces a junk symbol with `v` in place of the receiver, and
        // any cross-module DI lookup of `Owner_Spec::method` returns the
        // wrong mangle.
        mut sig_ctx: ResolutionContext = res_ctx.clone();
        if (this_type.is_valid()) {
            sig_ctx.set_this_type(this_type);
        }
        this.type_resolver.resolve_func_signature(func, &sig_ctx);

        // Back-fill `&this` / `this` parameters when they have no
        // explicit annotation; the parser leaves `type_annotation` null
        // on the implicit receiver, so `resolve_func_signature` skips
        // them and `param.resolved_type` stays at the default invalid
        // sentinel.  The non-spec path's `resolve_method_signatures`
        // does this same back-fill from `owner_type` (resolver.cryo
        // line 308-317); duplicating it here so spec'd method clones
        // get the same treatment.
        //
        // For `&this` we want `Pointer(this_type)`; Cryo lowers
        // references on receivers to pointer-to-owner at the LLVM
        // level (matching what `register_methods_with_module_aliased`
        // expects).  For bare `this` we want the owner type directly.
        if (this_type.is_valid()) {
            const this_amp: SymbolStr = this.intern_table.intern("&this");
            const this_val: SymbolStr = this.intern_table.intern("this");
            for (mut bp: i64 = 0; bp < func.parameters.length; bp++) {
                const param: VarDeclNode* = func.parameters[bp];
                if (param == null || param.resolved_type.is_valid()) { continue; }
                if (param.name.equals(this_amp)) {
                    param.resolved_type = this.arena.get_pointer_to(this_type);
                } else if (param.name.equals(this_val)) {
                    param.resolved_type = this_type;
                }
            }
        }
        // Fallback resolution with substitution-derived bindings.  After
        // ASTSpecializer clones the AST, ASTTypeSubstituter rewrites the
        // annotation tree to replace generic-param references with their
        // concrete replacements, but the substituter doesn't always reach
        // every spot (virtual-dispatch gaps in the visitor and some
        // annotation kinds - Function, nested Generic - are not walked).
        // When that happens, the post-substitution annotation
        // still reads `T` and the empty `res_ctx` can't resolve it, so
        // `resolve_func_signature` above leaves the return type and any
        // affected params at the invalid sentinel.
        //
        // Build a `gen_ctx` that maps every original generic-param
        // SymbolStr to its concrete replacement (so `Named("T")` -> `u64`,
        // `Named("Item")` -> whatever) and re-resolve every still-invalid
        // signature slot through it.  Concrete-mapping rather than
        // GenericParam-rebinding is intentional: we want the final
        // resolved_type to be the substituted form, not a re-encoded
        // GenericParam that downstream substitution would then have to
        // chase a second time.
        if (subst != null) {
            mut gen_ctx: ResolutionContext = res_ctx.clone();
            if (this_type.is_valid()) { gen_ctx.set_this_type(this_type); }
            for (mut si: i64 = 0; si < subst.param_ids.length; si++) {
                const param_t: Type* = this.arena.lookup(subst.param_ids[si]);
                if (param_t != null && param_t.kind == TypeKind::GenericParam) {
                    const gp: GenericParamType* = param_t as GenericParamType*;
                    gen_ctx.add_binding(gp.param_name, subst.replacements[si]);
                }
            }
            // Return type fallback (existing behavior).
            if (!func.has_resolved_return_type() && func.return_type_annotation != null) {
                const resolved: TypeRef = this.type_resolver.resolve(
                    func.return_type_annotation, &gen_ctx);
                if (resolved.is_valid()) {
                    func.resolved_return_type = resolved;
                }
            }
            // Param fallback: same logic, every still-unresolved
            // explicitly-annotated parameter gets one more shot via the
            // concrete-binding context.  Skips `&this`/`this` because
            // those are back-filled above from `this_type` directly.
            for (mut pi: i64 = 0; pi < func.parameters.length; pi++) {
                const param: VarDeclNode* = func.parameters[pi];
                if (param == null) { continue; }
                if (param.resolved_type.is_valid()) { continue; }
                if (param.type_annotation == null) { continue; }
                const ptype: TypeRef = this.type_resolver.resolve(
                    param.type_annotation, &gen_ctx);
                if (ptype.is_valid()) {
                    param.resolved_type = ptype;
                }
            }
        }
        if (func.body != null) {
            this.resolve_body_locals(func.body, res_ctx);
            // Walk the body to find inferred-arg generic free-function
            // calls like `alloc_entry(map, h, k, v)` inside a specialized
            // HashMap method, after the substituter has rewritten the
            // surrounding annotations.  Each match pins a specialized
            // callee on the call (so codegen can find it) and queues
            // an instantiation request so the function template gets
            // specialized in this same mono iteration.
            //
            // Build a lightweight name -> TypeRef table from the enclosing
            // function's parameters and the body's local declarations so
            // call-arg identifier lookups work without a full sema pass.
            // (Sema runs AFTER mono in the pipeline, so call-arg
            //  expressions don't yet have `resolved_type` populated.)
            mut local_names: SymbolStr[] = [];
            mut local_types: TypeRef[] = [];
            // Seed `this` for instance methods.  `this` is implicit (not
            // a regular parameter), so the param loop below would miss
            // it; without this seed, calls of the form
            // `alloc_entry(this, ...)` couldn't recover the receiver's
            // concrete type at inference time.
            if (this_type.is_valid()) {
                local_names.push(this.intern_table.intern("this"));
                local_types.push(this_type);
            }
            for (mut pi: i64 = 0; pi < func.parameters.length; pi++) {
                const p: VarDeclNode* = func.parameters[pi];
                if (p == null || !p.resolved_type.is_valid()) { continue; }
                local_names.push(p.name);
                local_types.push(p.resolved_type);
            }
            this.collect_locals_in_block(func.body, &local_names, &local_types);
            this.discover_inferred_calls_in_block(func.body, res_ctx, subst,
                                                  local_names, local_types);
        }

        // Discover transitive instantiations from the method's return type.
        // Without this, methods that return another generic type
        // (e.g. IoResult<T>::ok() -> Option<T>) fail to trigger monomorphization
        // of the referenced generic when the outer template is specialized.
        // Note: caller (resolve_methods) owns `nested_visited` lifecycle so
        // repeated return types across methods in the same impl block dedupe.
        if (func.has_resolved_return_type()) {
            this.request_nested_instantiations(func.resolved_return_type);
        }
    }

    // Inferred-arg generic free-function calls

    /// Walk a block for `Identifier(...)` calls whose callee names a
    /// generic free-function template; if formal/actual unification
    /// succeeds, pin a specialized callee symbol on the call and queue
    /// the instantiation.  Recurses into nested blocks and into the
    /// expression tree (call args, binary, unary, etc.) so calls buried
    /// in `match` arms or nested expressions are still discovered.
    /// Collect VarDecl name -> TypeRef bindings from a block's statements.
    /// Recurses into nested blocks / control-flow stmt bodies so `for`'s
    /// loop variable and locals declared inside an `if` are reachable.
    /// Mirrors the structure of `resolve_body_locals` but writes into
    /// the caller-owned arrays instead of the resolver.
    collect_locals_in_block(mut &this, block: BlockStmtNode*,
                            names: SymbolStr[]*, types: TypeRef[]*) -> void {
        if (block == null) { return; }
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            this.collect_locals_in_stmt(block.statements[i], names, types);
        }
    }

    collect_locals_in_stmt(mut &this, stmt: StatementNode*,
                           names: SymbolStr[]*, types: TypeRef[]*) -> void {
        if (stmt == null) { return; }
        const node: ASTNode* = stmt as ASTNode*;
        match (node.kind) {
            NodeKind::DeclarationStatement => {
                const ds: DeclStmtNode* = stmt as DeclStmtNode*;
                const inner: DeclarationNode* = ds.declaration;
                if (inner != null) {
                    const inner_node: ASTNode* = inner as ASTNode*;
                    if (inner_node.kind == NodeKind::VariableDeclaration) {
                        const vd: VarDeclNode* = inner as VarDeclNode*;
                        if (vd.resolved_type.is_valid()) {
                            names.push(vd.name);
                            types.push(vd.resolved_type);
                        } else if (vd.type_annotation != null
                                && this.type_resolver != null) {
                            // Mono runs BEFORE sema in the pipeline, so most
                            // local VarDecls don't have their resolved_type
                            // populated yet.  Fall back to resolving the
                            // type_annotation on demand so call-arg inference
                            // can recover concrete types from typed locals
                            // (e.g. `const local: u8[1] = [byte]; ...
                            // Slice::from_raw(&local[0], 1)` (without this,
                            // T can't be inferred from arg[0]'s array element
                            // type).  Resolve in an empty context; the
                            // annotation is concrete (no method-level
                            // generics on a body local), and any type names
                            // resolve through the resolver's name_resolver
                            // module scope.
                            const _empty: string = "";
                            mut ctx: ResolutionContext = ResolutionContext::new(_empty, _empty);
                            const tr: TypeRef = this.type_resolver.resolve(
                                vd.type_annotation, &ctx);
                            if (tr.is_valid()) {
                                names.push(vd.name);
                                types.push(tr);
                            }
                        }
                    }
                }
            }
            NodeKind::BlockStatement => {
                this.collect_locals_in_block(stmt as BlockStmtNode*, names, types);
            }
            NodeKind::IfStatement => {
                const ifs: IfStmtNode* = stmt as IfStmtNode*;
                if (ifs.then_stmt != null) {
                    this.collect_locals_in_stmt(ifs.then_stmt, names, types);
                }
                if (ifs.has_else() && ifs.else_stmt != null) {
                    this.collect_locals_in_stmt(ifs.else_stmt, names, types);
                }
            }
            NodeKind::WhileStatement => {
                const ws: WhileStmtNode* = stmt as WhileStmtNode*;
                if (ws.body != null) {
                    this.collect_locals_in_stmt(ws.body, names, types);
                }
            }
            NodeKind::ForStatement => {
                const fs: ForStmtNode* = stmt as ForStmtNode*;
                if (fs.body != null) {
                    this.collect_locals_in_stmt(fs.body, names, types);
                }
            }
            NodeKind::LoopStatement => {
                const ls: LoopStmtNode* = stmt as LoopStmtNode*;
                if (ls.body != null) {
                    this.collect_locals_in_stmt(ls.body, names, types);
                }
            }
            NodeKind::MatchStatement => {
                const ms: MatchStmtNode* = stmt as MatchStmtNode*;
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm != null && arm.body != null) {
                        this.collect_locals_in_stmt(arm.body, names, types);
                    }
                }
            }
            _ => {}
        }
    }

    /// Look up an identifier's TypeRef in the param/local table.
    lookup_local_type(&this, name: SymbolStr,
                      names: &SymbolStr[], types: &TypeRef[]) -> TypeRef {
        for (mut i: i64 = 0; i < names.length; i++) {
            if (names[i].equals(name)) { return types[i]; }
        }
        return TypeRef::invalid();
    }

    discover_inferred_calls_in_block(mut &this, block: BlockStmtNode*,
                                     res_ctx: ResolutionContext*,
                                     subst: TypeSubstitution*,
                                     names: &SymbolStr[],
                                     types: &TypeRef[]) -> void {
        if (block == null) { return; }
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            this.discover_inferred_calls_in_stmt(block.statements[i], res_ctx, subst, names, types);
        }
    }

    discover_inferred_calls_in_stmt(mut &this, stmt: StatementNode*,
                                    res_ctx: ResolutionContext*,
                                    subst: TypeSubstitution*,
                                    names: &SymbolStr[],
                                    types: &TypeRef[]) -> void {
        if (stmt == null) { return; }
        const node: ASTNode* = stmt as ASTNode*;
        match (node.kind) {
            NodeKind::ExpressionStatement => {
                const es: ExprStmtNode* = stmt as ExprStmtNode*;
                this.discover_inferred_calls_in_expr(es.expression, res_ctx, subst, names, types);
            }
            NodeKind::DeclarationStatement => {
                const ds: DeclStmtNode* = stmt as DeclStmtNode*;
                const inner: DeclarationNode* = ds.declaration;
                if (inner != null) {
                    const inner_node: ASTNode* = inner as ASTNode*;
                    if (inner_node.kind == NodeKind::VariableDeclaration) {
                        mut vd: VarDeclNode* = inner as VarDeclNode*;
                        if (vd.initializer != null) {
                            // Push the declared type as the expected type so an
                            // `![implicit]` initializer (`const v: T = make()`)
                            // can infer its generic arg from `T`.
                            const saved_exp: TypeRef = this.current_expected_type;
                            mut exp: TypeRef = vd.resolved_type;
                            if (!exp.is_valid() && vd.type_annotation != null
                                    && this.type_resolver != null && res_ctx != null) {
                                exp = this.type_resolver.resolve(vd.type_annotation, res_ctx);
                            }
                            if (exp.is_valid() && subst != null) {
                                exp = subst.apply(exp, this.arena);
                            }
                            this.current_expected_type = exp;
                            const saved_inst: TypeRef = this.last_static_inst_ref;
                            this.last_static_inst_ref = TypeRef::invalid();
                            this.discover_inferred_calls_in_expr(vd.initializer, res_ctx, subst, names, types);
                            const inst_from_init: TypeRef = this.last_static_inst_ref;
                            this.last_static_inst_ref = saved_inst;
                            this.current_expected_type = saved_exp;

                            // `is_auto` bindings are compiler-synthesised
                            // (today: the `__cryo_for_iter_N` iterator local
                            // emitted by the for-in desugar) and have no
                            // user-written type annotation.  Sema typed the
                            // binding from the initializer's call return,
                            // which for a generic constructor call is the
                            // template (`Range<T>`).  Value-arg inference
                            // ran above and pinned the concrete owner type
                            // for any constructor-shaped static; lift it
                            // here so codegen's method lookup on the
                            // binding sees `Range<i32>` (etc.) instead of
                            // the template.  We deliberately do NOT touch
                            // `call.resolved_type`; other passes treat the
                            // call's typing as load-bearing and rewriting
                            // it from this side channel destabilises them.
                            // Only lift from the static-constructor side channel
                            // when the initializer IS directly that constructor
                            // call (`for (x in Range::new(0,10))`).  When it's a
                            // method chain on one (`Range::new(..).take(n)`),
                            // `last_static_inst_ref` holds the INNER constructor's
                            // owner (`Range<i32>`), not the chain's result
                            // (`TakeIter<Range<i32>>`); overwriting with it
                            // mistypes the iterator binding.  Sema types the
                            // method-chain binding from the call's resolved_method
                            // instead, so leave it alone here.
                            mut init_is_direct_static: boolean = false;
                            if (vd.initializer != null) {
                                const init_n: ASTNode* = vd.initializer as ASTNode*;
                                if (init_n.kind == NodeKind::CallExpression) {
                                    const init_call: CallExprNode* = vd.initializer as CallExprNode*;
                                    if (init_call.callee != null
                                            && (init_call.callee as ASTNode*).kind
                                               == NodeKind::ScopeResolution) {
                                        init_is_direct_static = true;
                                    }
                                }
                            }
                            if (vd.is_auto && inst_from_init.is_valid()
                                    && init_is_direct_static) {
                                vd.resolved_type = inst_from_init;
                            }

                            // for-in over a fixed-size array `T[N]`: sema
                            // (which runs AFTER mono) lowers the scrutinee
                            // to `Slice<T>::from_raw(...).iter()`, but mono
                            // never sees that synthesized call and so never
                            // instantiates `Slice<T>` / `SliceIter<T>`.
                            // Seed them here, keyed off the binding's
                            // fixed-array element type, so the specs exist
                            // by codegen time.
                            if (vd.is_auto) {
                                const it_ty: TypeRef =
                                    this.resolve_arg_type_for_inference(
                                        vd.initializer, names, types);
                                if (it_ty.is_valid()) {
                                    mut it_t: Type* = this.arena.lookup(it_ty.id);
                                    if (it_t != null
                                            && it_t.kind == TypeKind::Array) {
                                        const fa: ArrayType* = it_t as ArrayType*;
                                        if (fa.is_fixed() && fa.element.is_valid()) {
                                            this.seed_fixed_array_iter_specs(fa.element);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            NodeKind::ReturnStatement => {
                const rs: ReturnStmtNode* = stmt as ReturnStmtNode*;
                if (rs.expression != null) {
                    this.discover_inferred_calls_in_expr(rs.expression, res_ctx, subst, names, types);
                }
            }
            NodeKind::BlockStatement => {
                this.discover_inferred_calls_in_block(stmt as BlockStmtNode*, res_ctx, subst, names, types);
            }
            NodeKind::IfStatement => {
                const ifs: IfStmtNode* = stmt as IfStmtNode*;
                this.discover_inferred_calls_in_expr(ifs.condition, res_ctx, subst, names, types);
                if (ifs.then_stmt != null) {
                    this.discover_inferred_calls_in_stmt(ifs.then_stmt, res_ctx, subst, names, types);
                }
                if (ifs.has_else() && ifs.else_stmt != null) {
                    this.discover_inferred_calls_in_stmt(ifs.else_stmt, res_ctx, subst, names, types);
                }
            }
            NodeKind::WhileStatement => {
                const ws: WhileStmtNode* = stmt as WhileStmtNode*;
                this.discover_inferred_calls_in_expr(ws.condition, res_ctx, subst, names, types);
                if (ws.body != null) {
                    this.discover_inferred_calls_in_stmt(ws.body, res_ctx, subst, names, types);
                }
            }
            NodeKind::ForStatement => {
                const fs: ForStmtNode* = stmt as ForStmtNode*;
                if (fs.condition != null) {
                    this.discover_inferred_calls_in_expr(fs.condition, res_ctx, subst, names, types);
                }
                if (fs.body != null) {
                    this.discover_inferred_calls_in_stmt(fs.body, res_ctx, subst, names, types);
                }
            }
            NodeKind::LoopStatement => {
                const ls: LoopStmtNode* = stmt as LoopStmtNode*;
                if (ls.body != null) {
                    this.discover_inferred_calls_in_stmt(ls.body, res_ctx, subst, names, types);
                }
            }
            NodeKind::MatchStatement => {
                const ms: MatchStmtNode* = stmt as MatchStmtNode*;
                this.discover_inferred_calls_in_expr(ms.subject, res_ctx, subst, names, types);
                // Resolve subject's type and pre-register each arm's pattern
                // bindings on a per-walker scratch stack so `try_infer_method_call`
                // can look up match-arm bindings (e.g. `Result::Ok(raw) =>
                // raw.method<...>()` inside a generic body that sema skipped).
                // We can't push into `names`/`types` directly; those are
                // pass-by-value arrays here, so pushes don't propagate to the
                // caller's view but pops do (since pop is just a length tweak),
                // and that mismatch corrupts the worklist for sibling arms.
                mut subj_type: TypeRef = this.resolve_arg_type_for_inference(
                    ms.subject, names, types);
                if (subj_type.is_valid() && subst != null) {
                    subj_type = subst.apply(subj_type, this.arena);
                }
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm == null) { continue; }
                    const pushed: i64 = this.push_arm_bindings_to_scope(arm, subj_type);
                    if (arm.guard != null) {
                        this.discover_inferred_calls_in_expr(arm.guard, res_ctx, subst, names, types);
                    }
                    if (arm.body != null) {
                        this.discover_inferred_calls_in_stmt(arm.body, res_ctx, subst, names, types);
                    }
                    this.pop_scope_bindings(pushed);
                }
            }
            _ => {}
        }
    }

    /// Push each pattern's bindings onto the walker's scope stack so
    /// `lookup_local_type` resolves them when an arm's body references
    /// them.  Returns the count to be popped after the arm is walked.
    /// Direct mutation of `this.scope_names` / `this.scope_types`
    /// avoids the by-value-array pitfall that breaks pushing into the
    /// `names`/`types` parameters threaded through the walker.
    push_arm_bindings_to_scope(mut &this, arm: MatchArmNode*,
                                subject_type: TypeRef) -> i64 {
        if (arm == null) { return 0; }
        if (!subject_type.is_valid()) { return 0; }
        mut added: i64 = 0;
        for (mut i: i64 = 0; i < arm.patterns.length; i++) {
            const pat: PatternNode* = arm.patterns[i];
            if (pat == null) { continue; }

            if (pat.pattern_kind == PatternKind::Identifier) {
                this.scope_names.push(pat.binding_name);
                this.scope_types.push(subject_type);
                added += 1;
                continue;
            }
            if (pat.pattern_kind != PatternKind::Enum) { continue; }

            const enum_pat: EnumPatternNode* = pat as EnumPatternNode*;

            // Walk to a concrete EnumType, falling through to the template
            // when the InstantiatedType is still unresolved.
            mut enum_ty: Type* = null;
            mut t: Type* = this.arena.lookup(subject_type.id);
            mut depth: i32 = 0;
            while (t != null && depth < 5) {
                if (t.kind == TypeKind::Enum) { enum_ty = t; break; }
                if (t.kind == TypeKind::Pointer) {
                    const pt: PointerType* = t as PointerType*;
                    t = this.arena.lookup(pt.pointee.id);
                } else if (t.kind == TypeKind::Reference) {
                    const rt: ReferenceType* = t as ReferenceType*;
                    t = this.arena.lookup(rt.referent.id);
                } else if (t.kind == TypeKind::InstantiatedType) {
                    const inst: InstantiatedType* = t as InstantiatedType*;
                    if (inst.has_resolved_type()) {
                        t = this.arena.lookup(inst.resolved_type.id);
                    } else {
                        const base_t: Type* = this.arena.lookup(inst.generic_base.id);
                        if (base_t != null && base_t.kind == TypeKind::Enum) {
                            enum_ty = base_t;
                        }
                        break;
                    }
                } else {
                    break;
                }
                depth += 1;
            }
            if (enum_ty == null || enum_ty.kind != TypeKind::Enum) {
                for (mut j: i64 = 0; j < enum_pat.elements.length; j++) {
                    const pb: PatternBinding* = enum_pat.binding_at(j);
                    if (pb == null) { continue; }
                    this.scope_names.push(pb.name);
                    this.scope_types.push(subject_type);
                    added += 1;
                }
                continue;
            }
            const et: EnumType* = enum_ty as EnumType*;
            const variant: EnumVariantInfo* = et.get_variant(enum_pat.variant_name);
            if (variant == null) { continue; }
            mut payload_types: TypeRef[] = mono_copy_type_refs(&variant.payload_types);
            mut subj_t: Type* = this.arena.lookup(subject_type.id);
            if (subj_t != null && subj_t.kind == TypeKind::InstantiatedType
                    && this.generic_registry != null) {
                const inst2: InstantiatedType* = subj_t as InstantiatedType*;
                const tmpl: TemplateEntry* =
                    this.generic_registry.get_template_by_type_id(
                        inst2.generic_base.id);
                if (tmpl != null
                        && tmpl.param_type_ids.length == inst2.type_args.length) {
                    mut sub: TypeSubstitution = TypeSubstitution::from_params(
                        tmpl.param_type_ids, inst2.type_args);
                    mut substituted: TypeRef[] = [];
                    for (mut k: i64 = 0; k < payload_types.length; k++) {
                        substituted.push(sub.apply(payload_types[k], this.arena));
                    }
                    payload_types = substituted;
                }
            }
            for (mut j: i64 = 0; j < enum_pat.elements.length; j++) {
                mut bind_t: TypeRef = TypeRef::invalid();
                if (j < payload_types.length && payload_types[j].is_valid()) {
                    bind_t = payload_types[j];
                } else {
                    bind_t = subject_type;
                }
                if (!bind_t.is_valid()) { continue; }
                const pb: PatternBinding* = enum_pat.binding_at(j);
                if (pb != null) {
                    this.scope_names.push(pb.name);
                    this.scope_types.push(bind_t);
                    added += 1;
                    continue;
                }
                // Nested sub-pattern: recurse so its bindings are in scope for
                // generic-call discovery in the arm body.
                const sub: PatternNode* = enum_pat.sub_at(j);
                if (sub != null) {
                    added += this.push_subpattern_bindings_mono(sub, bind_t);
                }
            }
        }
        return added;
    }

    /// Recursive companion of `push_arm_bindings_to_scope` for nested
    /// sub-patterns: pushes the names introduced by `pat` (matched against a
    /// value of `value_type`) onto the walker's scope stack. Returns the count
    /// pushed.
    push_subpattern_bindings_mono(mut &this, pat: PatternNode*,
                                  value_type: TypeRef) -> i64 {
        if (pat == null || !value_type.is_valid()) { return 0; }
        if (pat.pattern_kind == PatternKind::Identifier) {
            this.scope_names.push(pat.binding_name);
            this.scope_types.push(value_type);
            return 1;
        }
        if (pat.pattern_kind != PatternKind::Enum) { return 0; }
        const enum_pat: EnumPatternNode* = pat as EnumPatternNode*;
        mut t: Type* = this.arena.lookup(value_type.id);
        mut depth: i32 = 0;
        while (t != null && depth < 5 && t.kind != TypeKind::Enum) {
            if (t.kind == TypeKind::Pointer) {
                t = this.arena.lookup((t as PointerType*).pointee.id);
            } else if (t.kind == TypeKind::Reference) {
                t = this.arena.lookup((t as ReferenceType*).referent.id);
            } else if (t.kind == TypeKind::InstantiatedType
                    && (t as InstantiatedType*).has_resolved_type()) {
                t = this.arena.lookup((t as InstantiatedType*).resolved_type.id);
            } else { break; }
            depth += 1;
        }
        if (t == null || t.kind != TypeKind::Enum) { return 0; }
        const variant: EnumVariantInfo* =
            (t as EnumType*).get_variant(enum_pat.variant_name);
        if (variant == null) { return 0; }
        mut added: i64 = 0;
        for (mut j: i64 = 0; j < enum_pat.elements.length; j++) {
            mut elem_t: TypeRef = value_type;
            if (j < variant.payload_types.length && variant.payload_types[j].is_valid()) {
                elem_t = variant.payload_types[j];
            }
            const pb: PatternBinding* = enum_pat.binding_at(j);
            if (pb != null) {
                this.scope_names.push(pb.name);
                this.scope_types.push(elem_t);
                added += 1;
                continue;
            }
            const sub: PatternNode* = enum_pat.sub_at(j);
            if (sub != null) {
                added += this.push_subpattern_bindings_mono(sub, elem_t);
            }
        }
        return added;
    }

    /// Pop `count` entries off the walker's scope stack.  Symmetric to
    /// `push_arm_bindings_to_scope`.
    pop_scope_bindings(mut &this, count: i64) -> void {
        for (mut k: i64 = 0; k < count; k++) {
            if (this.scope_names.length == 0) { break; }
            this.scope_names.pop();
            this.scope_types.pop();
        }
    }


    discover_inferred_calls_in_expr(mut &this, expr: ExpressionNode*,
                                    res_ctx: ResolutionContext*,
                                    subst: TypeSubstitution*,
                                    names: &SymbolStr[],
                                    types: &TypeRef[]) -> void {
        if (expr == null) { return; }
        const node: ASTNode* = expr as ASTNode*;
        match (node.kind) {
            NodeKind::CallExpression => {
                const call: CallExprNode* = expr as CallExprNode*;
                // Arg/callee sub-expressions don't inherit this call's expected
                // type; clear it across the recursion and restore for the call's
                // own inference (only the directly-bound call carries it).
                const saved_exp: TypeRef = this.current_expected_type;
                this.current_expected_type = TypeRef::invalid();
                for (mut i: i64 = 0; i < call.arguments.length; i++) {
                    this.discover_inferred_calls_in_expr(call.arguments[i], res_ctx, subst, names, types);
                }
                if (call.callee != null) {
                    this.discover_inferred_calls_in_expr(call.callee, res_ctx, subst, names, types);
                }
                this.current_expected_type = saved_exp;
                this.try_infer_function_call(call, res_ctx, subst, names, types);
                this.try_infer_method_call(call, subst, names, types);
            }
            NodeKind::BinaryExpression => {
                const be: BinaryExprNode* = expr as BinaryExprNode*;
                this.discover_inferred_calls_in_expr(be.left, res_ctx, subst, names, types);
                this.discover_inferred_calls_in_expr(be.right, res_ctx, subst, names, types);
            }
            NodeKind::UnaryExpression => {
                const ue: UnaryExprNode* = expr as UnaryExprNode*;
                this.discover_inferred_calls_in_expr(ue.operand, res_ctx, subst, names, types);
            }
            NodeKind::TryExpression => {
                // `expr?`: mono runs before sema lowers `?`, so only the source
                // operand exists.  Recurse into it so a generic free-function
                // call used as the `?` operand (`expect_eq(a, b)?`) still gets
                // its specialization discovered and `resolved_callee` pinned.
                const te: TryExprNode* = expr as TryExprNode*;
                this.discover_inferred_calls_in_expr(te.operand, res_ctx, subst, names, types);
            }
            NodeKind::IfExpression => {
                // `if` used as a VALUE (initializer, call arg, match
                // scrutinee). Without this, a generic free-fn call in the
                // condition or a branch is never discovered and codegen
                // can't resolve it. Each sub-expr may be null (the
                // recursion guards on null).
                const ie: IfExprNode* = expr as IfExprNode*;
                this.discover_inferred_calls_in_expr(ie.condition, res_ctx, subst, names, types);
                this.discover_inferred_calls_in_expr(ie.then_expr, res_ctx, subst, names, types);
                this.discover_inferred_calls_in_expr(ie.else_expr, res_ctx, subst, names, types);
            }
            NodeKind::MatchExpression => {
                // `match` used as a VALUE (e.g. `const x = match (gen())
                // {...}`). Mirrors the MatchStatement handler: recurse
                // into the subject, then each arm body with the arm's
                // pattern bindings pushed so method-call inference inside
                // arms resolves. Previously this fell through to the
                // no-op default, so a generic free-fn call in the subject
                // (`match (alloc_entry(...)) {...}`) was never discovered.
                const me: MatchExprNode* = expr as MatchExprNode*;
                this.discover_inferred_calls_in_expr(me.subject, res_ctx, subst, names, types);
                mut subj_type: TypeRef = this.resolve_arg_type_for_inference(
                    me.subject, names, types);
                if (subj_type.is_valid() && subst != null) {
                    subj_type = subst.apply(subj_type, this.arena);
                }
                for (mut i: i64 = 0; i < me.arms.length; i++) {
                    const arm: MatchArmNode* = me.arms[i];
                    if (arm == null) { continue; }
                    const pushed: i64 = this.push_arm_bindings_to_scope(arm, subj_type);
                    if (arm.guard != null) {
                        this.discover_inferred_calls_in_expr(arm.guard, res_ctx, subst, names, types);
                    }
                    if (arm.body != null) {
                        this.discover_inferred_calls_in_stmt(arm.body, res_ctx, subst, names, types);
                    }
                    this.pop_scope_bindings(pushed);
                }
            }
            NodeKind::MemberAccess => {
                const ma: MemberAccessNode* = expr as MemberAccessNode*;
                this.discover_inferred_calls_in_expr(ma.object, res_ctx, subst, names, types);
            }
            NodeKind::ArrayAccess => {
                const aa: ArrayAccessNode* = expr as ArrayAccessNode*;
                this.discover_inferred_calls_in_expr(aa.array, res_ctx, subst, names, types);
                this.discover_inferred_calls_in_expr(aa.index, res_ctx, subst, names, types);
            }
            NodeKind::CastExpression => {
                const ce: CastExprNode* = expr as CastExprNode*;
                this.discover_inferred_calls_in_expr(ce.expression, res_ctx, subst, names, types);
            }
            NodeKind::StructLiteral => {
                // `Slice { ptr: mem::offset(...), ... }`: without recursing
                // into field initializer values, generic free-fn calls inside
                // struct ctors never get pinned and codegen mangles them
                // against the unspecialized template's `1T` placeholder.
                const sl: StructLiteralNode* = expr as StructLiteralNode*;
                for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                    this.discover_inferred_calls_in_expr(
                        sl.field_inits[i].value, res_ctx, subst, names, types);
                }
            }
            NodeKind::ArrayLiteral => {
                const al: ArrayLiteralNode* = expr as ArrayLiteralNode*;
                for (mut i: i64 = 0; i < al.elements.length; i++) {
                    this.discover_inferred_calls_in_expr(
                        al.elements[i], res_ctx, subst, names, types);
                }
            }
            NodeKind::Identifier => {
                // A bare identifier carrying turbofish args is a generic
                // function-reference VALUE (`tramp<i32>` passed/cast/assigned,
                // not called). Pin its specialized symbol + queue the
                // instantiation, mirroring the call path. Ordinary identifiers
                // (no generic args) bail out immediately on the length check.
                this.try_resolve_function_value_ref(
                    expr as IdentifierNode*, res_ctx, subst);
            }
            _ => { }
        }
    }

    /// Resolve a generic function-reference value `name<Args>` used as a
    /// first-class value (GAP 1): look up the named function template,
    /// resolve the explicit turbofish args to concrete types (applying the
    /// enclosing specialization's `subst` so `name<C,T>` inside a spec'd
    /// body maps `C,T` to their concrete bindings), then pin the specialized
    /// callee symbol on the identifier and queue the instantiation so the
    /// concrete function is produced in this same mono iteration and codegen
    /// can take its address. No-op for ordinary identifiers (no turbofish).
    try_resolve_function_value_ref(mut &this, ident: IdentifierNode*,
                                   res_ctx: ResolutionContext*,
                                   subst: TypeSubstitution*) -> void {
        if (ident == null) { return; }
        if (ident.generic_args.length == 0) { return; }
        if (ident.resolved_callee.is_valid()) { return; }
        if (this.type_resolver == null || res_ctx == null) { return; }
        if (this.generic_registry == null) { return; }

        const entry: TemplateEntry* =
            this.find_function_template_for_call(ident.name);
        if (entry == null) { return; }
        if (entry.node_kind != NodeKind::FunctionDeclaration) { return; }

        // Resolve each explicit arg to a TypeRef; apply the enclosing
        // spec's subst so generic-param args become concrete.
        mut seeded: TypeRef[] = [];
        for (mut i: i64 = 0; i < ident.generic_args.length; i++) {
            mut tr: TypeRef = this.type_resolver.resolve(ident.generic_args[i], res_ctx);
            if (!tr.is_valid()) { return; }
            if (subst != null) {
                tr = subst.apply(tr, this.arena);
            }
            seeded.push(tr);
        }
        seeded = this.type_resolver.expand_default_type_args(entry, seeded, res_ctx);
        if (seeded.length != entry.param_type_ids.length) { return; }

        const base_sym: SymbolStr = entry.spec_base_name(this.intern_table);
        const base_qname: QualifiedName = QualifiedName::from_symbol(base_sym);
        const spec_sym: SymbolStr = MangledName::specialized_identifier(
            this.intern_table, this.arena, base_qname, seeded);
        if (!spec_sym.is_valid()) { return; }
        ident.set_resolved_callee(spec_sym);
        const new_inst: TypeRef = this.generic_registry.instantiate_for_module(
            entry.base_type, seeded, this.current_module);
        this.enqueue_from_type_ref(new_inst);
    }

    /// Resolve an identifier, `&ident`, `obj.field`, or `value as TYPE`
    /// expression to a TypeRef using the param/local table.  This is the
    /// minimal mini-sema needed to feed the unifier a concrete type for the
    /// call's actual arguments; expressions don't carry resolved_type yet
    /// at mono time.  Returns invalid for shapes we can't resolve cheaply
    /// (free-fn or method calls, complex expressions); inference simply
    /// skips those args, and the post-loop "all bindings filled" check
    /// catches the case where no other arg pinned the missing binding.
    /// Instantiate `Slice<elt>` and `SliceIter<elt>` (and enqueue them on
    /// the worklist) so the for-in-over-`T[N]` lowering sema emits later
    /// (`Slice<elt>::from_raw(...).iter()`) has concrete specs at codegen
    /// time.  Both templates take a single type param.  Idempotent: a
    /// cache hit just re-enqueues, which `enqueue_from_type_ref` no-ops.
    seed_fixed_array_iter_specs(mut &this, elt: TypeRef) -> void {
        if (this.generic_registry == null || !elt.is_valid()) { return; }
        const elt_t: Type* = this.arena.lookup(elt.id);
        if (elt_t == null) { return; }
        if (elt_t.kind == TypeKind::GenericParam
                || elt_t.kind == TypeKind::BoundedParam) { return; }
        const names2: SymbolStr[] = [
            this.intern_table.intern("std::core::slice::Slice"),
            this.intern_table.intern("std::core::slice::SliceIter"),
        ];
        for (mut i: i64 = 0; i < names2.length; i++) {
            const entry: TemplateEntry* =
                this.generic_registry.get_template(names2[i]);
            if (entry == null) { continue; }
            mut args: TypeRef[] = [];
            args.push(elt);
            const inst_ref: TypeRef =
                this.generic_registry.instantiate_for_module(
                    entry.base_type, args, this.current_module);
            this.enqueue_from_type_ref(inst_ref);
        }
    }

    resolve_arg_type_for_inference(&this, expr: ExpressionNode*,
                                   names: &SymbolStr[], types: &TypeRef[]) -> TypeRef {
        if (expr == null) { return TypeRef::invalid(); }
        const node: ASTNode* = expr as ASTNode*;
        if (node.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = expr as IdentifierNode*;
            const local: TypeRef = this.lookup_local_type(id.name, names, types);
            if (local.is_valid()) { return local; }
            // Fall back to the walker's match-arm scope stack: pattern
            // bindings (e.g. `Result::Ok(raw)`) registered by
            // `push_arm_bindings_to_scope` aren't in the by-value
            // `names`/`types` worklist but live on `this.scope_names`.
            for (mut si: i64 = this.scope_names.length - 1; si >= 0; si--) {
                if (this.scope_names[si].equals(id.name)) {
                    return this.scope_types[si];
                }
            }
            // An identifier naming a global function passed as a
            // function-typed argument (`opt.map(tentimes)`): recover its
            // signature from the declaration index so the unifier can bind a
            // generic that appears only inside the callback's type, e.g.
            // `(T) -> U` against `(int) -> int`.  Only when exactly one
            // overload exists; an ambiguous name can't be resolved here
            // without the formal to disambiguate against.
            if (this.decl_index != null) {
                mut fns: TypeRef[] = this.decl_index.lookup_func_type_overloads(
                    this.decl_index.resolve_qualified(id.name));
                if (fns.length == 0) {
                    fns = this.decl_index.lookup_func_type_overloads(id.name);
                }
                if (fns.length == 1) {
                    const fnt: Type* = this.arena.lookup(fns[0].id);
                    if (fnt != null && fnt.kind == TypeKind::Function) {
                        return fns[0];
                    }
                }
            }
            return TypeRef::invalid();
        }
        if (node.kind == NodeKind::LambdaExpression) {
            // A lambda argument's type is its function-pointer signature,
            // built from the parameter annotations and the explicit return
            // annotation.  Sema runs after mono, so neither the lambda nor its
            // params carry a resolved_type yet; resolve straight from the
            // annotations.  This binds a generic that appears only in the
            // callback's return (`(T) -> U`) from a lambda actual like
            // `opt.map((n: int) -> int { return n * 10; })`.  A lambda with no
            // return annotation yields invalid (inference simply skips it).
            if (this.type_resolver == null) { return TypeRef::invalid(); }
            const lam: LambdaExprNode* = expr as LambdaExprNode*;
            mut lam_ctx: ResolutionContext = ResolutionContext::new("", "");
            mut p_types: TypeRef[] = [];
            for (mut i: i64 = 0; i < lam.parameters.length; i++) {
                const p: VarDeclNode* = lam.parameters[i];
                if (p == null) { return TypeRef::invalid(); }
                mut pty: TypeRef = p.resolved_type;
                if (!pty.is_valid() && p.type_annotation != null) {
                    pty = this.type_resolver.resolve(p.type_annotation, &lam_ctx);
                }
                if (!pty.is_valid()) { return TypeRef::invalid(); }
                p_types.push(pty);
            }
            mut r_ty: TypeRef = lam.return_type;
            if (!r_ty.is_valid() && lam.return_type_ann != null) {
                r_ty = this.type_resolver.resolve(lam.return_type_ann, &lam_ctx);
            }
            if (!r_ty.is_valid()) { return TypeRef::invalid(); }
            return this.arena.get_function(r_ty, p_types, false);
        }
        if (node.kind == NodeKind::UnaryExpression) {
            // `&x` produces a pointer to x.  Wrap the operand's type
            // with Pointer so a `T*` formal unifies cleanly:
            //   * `Slice::from_raw(&local[0], 1)` formal arg[0] is
            //     `T*`, actual `&local[0]` is `*<element_of_local>`.
            //     Without the Pointer wrap, the unifier sees Pointer
            //     vs element-type and fails to bind T.
            // The unifier already peels Reference symmetrically, so
            // returning the pointee directly worked for `&T` formals
            // but didn't for `T*` formals; surface the pointer level
            // here and let the unifier handle the symmetry.
            const ue: UnaryExprNode* = expr as UnaryExprNode*;
            const inner: TypeRef = this.resolve_arg_type_for_inference(ue.operand, names, types);
            if (!inner.is_valid()) { return TypeRef::invalid(); }
            // For unary `&`, return Pointer(inner).  For other unary
            // ops (`-`, `!`, etc.), the result type is the same as the
            // operand; return it unchanged.  Cryo treats unary `&` as
            // BitwiseAnd in the parser; check for that opcode.
            if (ue.op.kind == TokenType::Amp) {
                return this.arena.get_pointer_to(inner);
            }
            return inner;
        }
        if (node.kind == NodeKind::CastExpression) {
            // `value as TYPE`: the result type is `TYPE`, regardless of
            // what `value` is.  The target annotation is resolvable through
            // the type_resolver with the in-progress spec's module context;
            // returning the cast's target lets calls like
            // `mem::offset(p, count as i64)` provide arg[1]'s type without
            // needing to resolve the underlying expression.
            const ce: CastExprNode* = expr as CastExprNode*;
            if (ce.target_annotation == null || this.type_resolver == null) {
                return TypeRef::invalid();
            }
            mut cast_ctx: ResolutionContext = ResolutionContext::new("", "");
            return this.type_resolver.resolve(ce.target_annotation, &cast_ctx);
        }
        if (node.kind == NodeKind::CallExpression) {
            // Sema-resolved calls already carry their concrete return type
            // on the node itself.  Trust that when set; falling back to
            // decl_index for generic templates here returns an unsubstituted
            // GenericParam type that downstream paths (e.g. `expect_eq<T>
            // where T: Eq`) misinterpret as a missing trait bound.
            if (expr.resolved_type.is_valid()) {
                return expr.resolved_type;
            }
            const ce_call: CallExprNode* = expr as CallExprNode*;
            // A combinator call earlier in this same inference walk
            // (`r.map(f)` as the receiver of `.fold(..)`) has had its
            // `resolved_method` pinned to the concrete spec, but not its
            // `resolved_type` (sema runs later).  `lookup_method_return` below
            // can't recover the spec's return for an own-generic combinator
            // (it can't fill `B`), so consult the pinned spec method's already-
            // concrete return type first.
            if (ce_call.resolved_method != null) {
                const rm: ASTNode* = ce_call.resolved_method;
                if (rm.kind == NodeKind::MethodDeclaration) {
                    const rmm: MethodNode* = ce_call.resolved_method as MethodNode*;
                    if (rmm.func != null
                            && rmm.func.resolved_return_type.is_valid()) {
                        return rmm.func.resolved_return_type;
                    }
                }
            }
            // For calls inside a generic-method body that sema skipped, we
            // still need a best-effort return type so downstream match
            // subjects can be typed.  The receiver-driven path: when the
            // callee is `obj.method(...)` and the receiver resolves to a
            // concrete type, look up the method's return on that type.
            // Restricted to method calls because free-function generics
            // would yield unsubstituted GenericParams here, which break
            // bound-checking elsewhere.
            if (ce_call.callee == null) { return TypeRef::invalid(); }
            const callee_node: ASTNode* = ce_call.callee as ASTNode*;
            // Free-function call (`cnt(geti(9))`) as an inferred argument:
            // recover the callee's declared return type so a generic param that
            // can ONLY be pinned from this argument still binds. Without it mono
            // leaves the binding unset, never pins the OUTER call, and codegen
            // later fails with "cannot resolve function" (E0636) on the
            // unspecialized template - the symptom behind nesting a call inside
            // a generic whose own return type doesn't mention the param (so the
            // return-type pass can't recover it either). Only a single,
            // CONCRETE-returning overload is read directly: a generic free
            // function's return type is an unsubstituted GenericParam - the very
            // hazard the method-only restriction below was written to avoid -
            // which infer_type_is_concrete rejects, and an ambiguous
            // multi-overload name can't be disambiguated without the formal.
            if (callee_node.kind == NodeKind::Identifier && this.decl_index != null) {
                const cid: IdentifierNode* = ce_call.callee as IdentifierNode*;
                // Look up by the BARE name only and require a single, globally
                // unique definition. A `resolve_qualified` attempt is context-
                // free here and would pick an arbitrary same-named function
                // from another module (e.g. two `classify`s with different
                // return types), pinning T to the wrong type. Bare uniqueness
                // is the conservative signal: collisions yield length != 1 and
                // are skipped, falling back to the other args / the literal
                // default just as before this fast path existed.
                const fns: TypeRef[] = this.decl_index.lookup_func_type_overloads(cid.name);
                if (fns.length == 1) {
                    const fnt: Type* = this.arena.lookup(fns[0].id);
                    if (fnt != null && fnt.kind == TypeKind::Function) {
                        const fty: FunctionType* = fnt as FunctionType*;
                        if (this.infer_type_is_concrete(fty.return_type)) {
                            return fty.return_type;
                        }
                    }
                }
            }
            // NOTE: a ScopeResolution (static-call) receiver is deliberately
            // NOT resolved here.  Feeding static-call return types into the
            // general inference path mis-specializes ordinary generic methods
            // on call-expression receivers (e.g. `Box::new(..).clone()`),
            // producing caller/callee mangle mismatches.  The one place that
            // genuinely needs it - a self-returning combinator on a static-call
            // receiver (`Range<i32>::new(..).take(n)`) - resolves it explicitly
            // in `try_infer_method_call`, gated on the combinator check.
            if (callee_node.kind != NodeKind::MemberAccess) {
                return TypeRef::invalid();
            }
            if (this.decl_index == null) { return TypeRef::invalid(); }
            const ma_call: MemberAccessNode* = ce_call.callee as MemberAccessNode*;
            mut recv: TypeRef = this.resolve_arg_type_for_inference(
                ma_call.object, names, types);
            if (!recv.is_valid()) { return TypeRef::invalid(); }
            // Unwrap one or two pointer/reference layers so the type-symbol
            // reverse-lookup lands on the user-facing struct/class name.
            mut t: Type* = this.arena.lookup(recv.id);
            mut depth: i32 = 0;
            while (t != null && depth < 5) {
                if (t.kind == TypeKind::Pointer) {
                    const pt: PointerType* = t as PointerType*;
                    recv = pt.pointee;
                    t = this.arena.lookup(recv.id);
                } else if (t.kind == TypeKind::Reference) {
                    const rt: ReferenceType* = t as ReferenceType*;
                    recv = rt.referent;
                    t = this.arena.lookup(recv.id);
                } else if (t.kind == TypeKind::InstantiatedType) {
                    const inst: InstantiatedType* = t as InstantiatedType*;
                    if (!inst.has_resolved_type()) { break; }
                    recv = inst.resolved_type;
                    t = this.arena.lookup(recv.id);
                } else {
                    break;
                }
                depth += 1;
            }
            const type_sym: SymbolStr = this.decl_index.lookup_type_name(recv);
            if (!type_sym.is_valid()) { return TypeRef::invalid(); }
            return this.decl_index.lookup_method_return(type_sym, ma_call.member);
        }
        if (node.kind == NodeKind::MemberAccess) {
            // `obj.field`: recursively resolve the receiver, walk through
            // pointer/reference wrappers, and return the field's TypeRef
            // from the underlying struct.  Common shape inside spec'd method
            // bodies (`mem::offset(this.ptr, 1)`).
            //
            // For an InstantiatedType receiver whose `resolved_type` link
            // hasn't been installed yet (resolve_specialized_ast runs before
            // populate_concrete_type (see resolve_specialized_ast comment),
            // fall back to the template's `generic_base` struct: its field
            // types still carry the unsubstituted generic params (`T*`),
            // which the caller's `subst.apply` then concretizes (`Point*`).
            const ma: MemberAccessNode* = expr as MemberAccessNode*;
            mut recv: TypeRef = this.resolve_arg_type_for_inference(ma.object, names, types);
            if (!recv.is_valid()) { return TypeRef::invalid(); }
            mut t: Type* = this.arena.lookup(recv.id);
            mut depth: i32 = 0;
            while (t != null && depth < 8) {
                if (t.kind == TypeKind::Pointer) {
                    const pt: PointerType* = t as PointerType*;
                    recv = pt.pointee;
                    t = this.arena.lookup(recv.id);
                } else if (t.kind == TypeKind::Reference) {
                    const rt: ReferenceType* = t as ReferenceType*;
                    recv = rt.referent;
                    t = this.arena.lookup(recv.id);
                } else if (t.kind == TypeKind::InstantiatedType) {
                    const inst: InstantiatedType* = t as InstantiatedType*;
                    if (inst.has_resolved_type()) {
                        recv = inst.resolved_type;
                        t = this.arena.lookup(recv.id);
                    } else if (recv.id == this.current_spec_inst_id &&
                               this.current_spec_struct != null) {
                        // In-progress spec: read the field's resolved_type
                        // straight off the spec'd StructDeclNode (resolve_fields
                        // already populated it).  Returns directly because no
                        // more arena unwrapping is meaningful at this point.
                        const fields: &FieldDeclNode*[] = &this.current_spec_struct.fields;
                        for (mut fi: i64 = 0; fi < fields.length; fi++) {
                            const f: FieldDeclNode* = fields[fi];
                            if (f != null && f.name.equals(ma.member) &&
                                f.resolved_type.is_valid()) {
                                return f.resolved_type;
                            }
                        }
                        return TypeRef::invalid();
                    } else {
                        // Last resort: walk the template's generic_base.  For
                        // a still-template struct (no fields populated), this
                        // returns invalid, which is better than looping forever.
                        recv = inst.generic_base;
                        t = this.arena.lookup(recv.id);
                    }
                } else {
                    break;
                }
                depth += 1;
            }
            if (t == null || t.kind != TypeKind::Struct) { return TypeRef::invalid(); }
            const st: StructType* = t as StructType*;
            for (mut i: i64 = 0; i < st.fields.length; i++) {
                if (st.fields[i].name.equals(ma.member)) {
                    return st.fields[i].field_type;
                }
            }
            return TypeRef::invalid();
        }
        if (node.kind == NodeKind::CallExpression) {
            // `recv.method(...)` buried inside another call's arg list.
            // Common shape: `mem::offset(this.buffer.ptr(), n)`: the
            // outer mem::offset is the inferred-arg call we're about
            // to bind <T> on, and arg[0]'s type tells the unifier what
            // T should be.  Sema runs after mono, so the inner call's
            // expression doesn't carry resolved_type, so we walk the
            // callee shape ourselves.
            return this.resolve_method_call_arg_type(expr as CallExprNode*, names, types);
        }
        if (node.kind == NodeKind::ArrayAccess) {
            // `arr[i]`: return the array's element type.  Used for
            // call args like `&local[0]` where the address-of peel above
            // recurses into the ArrayAccess; without this, the unifier
            // can't infer T from arg[0] in `Slice::from_raw(&local[0],
            // 1)` synthesized into a trait-default body.
            const aa: ArrayAccessNode* = expr as ArrayAccessNode*;
            mut arr_t: TypeRef = this.resolve_arg_type_for_inference(aa.array, names, types);
            if (!arr_t.is_valid()) { return TypeRef::invalid(); }
            mut t_arr: Type* = this.arena.lookup(arr_t.id);
            mut depth_a: i32 = 0;
            while (t_arr != null && depth_a < 4) {
                if (t_arr.kind == TypeKind::Pointer) {
                    const pa: PointerType* = t_arr as PointerType*;
                    return pa.pointee;
                }
                if (t_arr.kind == TypeKind::Array) {
                    const a: ArrayType* = t_arr as ArrayType*;
                    return a.element;
                }
                if (t_arr.kind == TypeKind::Reference) {
                    const ra: ReferenceType* = t_arr as ReferenceType*;
                    arr_t = ra.referent;
                    t_arr = this.arena.lookup(arr_t.id);
                    depth_a += 1;
                    continue;
                }
                break;
            }
            return TypeRef::invalid();
        }
        if (node.kind == NodeKind::Literal) {
            // Sema hasn't run yet at mono time, so a literal's
            // `resolved_type` is rarely set.  Fall back to the literal's
            // default type read straight off `literal_kind`, adequate
            // for inferring a generic param from a literal arg
            // (`expect_eq(2 + 2, 4)`, `Pair::new(0, "x")`, etc.).
            if (expr.resolved_type.is_valid()) {
                return expr.resolved_type;
            }
            const lit: LiteralNode* = expr as LiteralNode*;
            return match (lit.literal_kind) {
                LiteralKind::Integer => { this.arena.get_i32() }
                LiteralKind::Float   => { this.arena.get_f64() }
                LiteralKind::Boolean => { this.arena.get_bool() }
                LiteralKind::Char    => { this.arena.get_char() }
                LiteralKind::String  => { this.arena.get_string() }
                LiteralKind::Null    => { TypeRef::invalid() }
            };
        }
        if (node.kind == NodeKind::BinaryExpression) {
            // `a op b`: for arithmetic and comparison ops the result
            // type tracks the operand type.  Recurse into the left
            // operand and return its inferred type; the right operand
            // would give the same answer for matched-type binops, and
            // mono-time inference doesn't need full arithmetic-promotion
            // semantics; sema will reject any genuine mismatch later.
            // Without this arm, `expect_eq(2 + 2, 4)` can't pin T from
            // arg[0] because the binop falls through to the
            // `resolved_type.is_valid()` check, which is empty pre-sema.
            const be: BinaryExprNode* = expr as BinaryExprNode*;
            const lhs_t: TypeRef = this.resolve_arg_type_for_inference(
                be.left, names, types);
            if (lhs_t.is_valid()) { return lhs_t; }
            return this.resolve_arg_type_for_inference(be.right, names, types);
        }
        if (expr.resolved_type.is_valid()) { return expr.resolved_type; }
        return TypeRef::invalid();
    }

    /// Compute the return type of a method-style call expression
    /// (`receiver.method(...)`) used as an argument to an outer
    /// inferred-arg generic call.  Resolves the receiver's TypeRef
    /// via the regular arg-resolution path, walks Pointer/Reference
    /// wrappers, then looks the method up:
    ///
    ///   * InstantiatedType receiver: find the template via
    ///     `generic_base`, look up the non-generic method by name on
    ///     the template's StructDeclNode/ClassDeclNode, take its
    ///     resolved_return_type, and substitute the template's
    ///     GenericParam IDs with the InstantiatedType's type_args
    ///     (the spec for the receiver may not exist yet; we're
    ///     called *during* the outer struct's spec resolution).
    ///   * Already-spec'd Struct/Class receiver: read the spec'd
    ///     ast_node from spec_entries; the cloned methods' return
    ///     types are already substituted, no extra work needed.
    ///
    /// Generic methods deliberately skipped; they belong to
    /// `try_infer_method_call`, which clones+substitutes the body.
    /// Any other callee shape (free fn, scope resolution, complex
    /// expr) returns invalid: the caller treats invalid args as
    /// "couldn't pin this binding from this arg" and either pins it
    /// from another arg or gives up cleanly.
    resolve_method_call_arg_type(mut &this, call: CallExprNode*,
                                 names: &SymbolStr[], types: &TypeRef[]) -> TypeRef {
        if (call == null || call.callee == null) { return TypeRef::invalid(); }
        const callee_node: ASTNode* = call.callee as ASTNode*;
        if (callee_node.kind != NodeKind::MemberAccess) {
            return TypeRef::invalid();
        }
        const ma: MemberAccessNode* = call.callee as MemberAccessNode*;

        mut recv: TypeRef = this.resolve_arg_type_for_inference(ma.object, names, types);
        if (!recv.is_valid()) { return TypeRef::invalid(); }

        // Strip Pointer/Reference but PRESERVE InstantiatedType; its
        // (generic_base, type_args) drive the substitution below.
        mut t: Type* = this.arena.lookup(recv.id);
        mut depth: i32 = 0;
        while (t != null && depth < 8) {
            if (t.kind == TypeKind::Pointer) {
                const pt: PointerType* = t as PointerType*;
                recv = pt.pointee;
                t = this.arena.lookup(recv.id);
            } else if (t.kind == TypeKind::Reference) {
                const rt: ReferenceType* = t as ReferenceType*;
                recv = rt.referent;
                t = this.arena.lookup(recv.id);
            } else {
                break;
            }
            depth += 1;
        }
        if (t == null) { return TypeRef::invalid(); }

        mut struct_ast: StructDeclNode* = null;
        mut method_subst: TypeSubstitution = TypeSubstitution::empty();

        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            const tmpl: TemplateEntry* =
                this.generic_registry.get_template_by_type_id(inst.generic_base.id);
            if (tmpl == null) { return TypeRef::invalid(); }
            if (tmpl.node_kind != NodeKind::StructDeclaration &&
                tmpl.node_kind != NodeKind::ClassDeclaration) {
                return TypeRef::invalid();
            }
            struct_ast = tmpl.ast_node as StructDeclNode*;
            const n: i64 = if (tmpl.param_type_ids.length < inst.type_args.length) {
                tmpl.param_type_ids.length
            } else {
                inst.type_args.length
            };
            for (mut i: i64 = 0; i < n; i++) {
                method_subst.add(tmpl.param_type_ids[i], inst.type_args[i]);
            }
        } else if (t.kind == TypeKind::Struct || t.kind == TypeKind::Class) {
            for (mut i: i64 = 0; i < this.spec_entries.length; i++) {
                const e: SpecializationEntry* = &this.spec_entries[i];
                if (e.specialized_type.id != recv.id) { continue; }
                if (e.ast_node == null) { continue; }
                struct_ast = e.ast_node as StructDeclNode*;
                break;
            }
            if (struct_ast == null) { return TypeRef::invalid(); }
        } else {
            return TypeRef::invalid();
        }

        for (mut i: i64 = 0; i < struct_ast.methods.length; i++) {
            const m: MethodNode* = struct_ast.methods[i];
            if (m == null || m.func == null) { continue; }
            if (!m.func.name.equals(ma.member)) { continue; }
            // Generic methods route through try_infer_method_call,
            // which clones + substitutes the body.  Their template
            // return type still references the method's own params
            // (e.g. `H` on `hash<H>`); we can't substitute those
            // here without redoing inference.
            if (m.func.generic_params.length > 0) { return TypeRef::invalid(); }
            mut ret: TypeRef = m.func.resolved_return_type;
            if (!ret.is_valid()) { return TypeRef::invalid(); }
            if (!method_subst.is_empty()) {
                ret = method_subst.apply(ret, this.arena);
            }
            return ret;
        }
        return TypeRef::invalid();
    }

    /// Compute the return type of a static-method call expression
    /// (`Type<args>::method(...)`) for inference.  Resolves the scope to a
    /// struct/class template, binds the template's generic params from the
    /// scope's `<args>`, finds the (non-own-generic) static method by name,
    /// and substitutes its declared return type.  For `Range<i32>::new(0,100)`
    /// this yields `Range<i32>` - the concrete receiver type the chained
    /// `.take(4)` then specializes against.  Own-generic static methods are
    /// skipped (they route through `try_infer_function_call`, which redoes
    /// inference); any unresolved scope/arg/method returns invalid so the
    /// caller falls back cleanly.
    resolve_static_call_return_type(mut &this, call: CallExprNode*) -> TypeRef {
        if (call == null || call.callee == null) { return TypeRef::invalid(); }
        if (this.decl_index == null || this.type_resolver == null) {
            return TypeRef::invalid();
        }
        const sr: ScopeResolutionNode* = call.callee as ScopeResolutionNode*;

        // Resolve the scope name to a generic struct/class template.  Try the
        // name as written, then its qualified form.
        mut base: TypeRef = this.decl_index.lookup_type(sr.scope_name);
        if (!base.is_valid()) {
            base = this.decl_index.lookup_type(
                this.decl_index.resolve_qualified(sr.scope_name));
        }
        if (!base.is_valid()) { return TypeRef::invalid(); }
        const tmpl: TemplateEntry* =
            this.generic_registry.get_template_by_type_id(base.id);
        if (tmpl == null) { return TypeRef::invalid(); }
        if (tmpl.node_kind != NodeKind::StructDeclaration &&
            tmpl.node_kind != NodeKind::ClassDeclaration) {
            return TypeRef::invalid();
        }
        const struct_ast: StructDeclNode* = tmpl.ast_node as StructDeclNode*;
        if (struct_ast == null) { return TypeRef::invalid(); }

        // Bind the scope's generic args (`<i32>`) to the template's params.
        mut method_subst: TypeSubstitution = TypeSubstitution::empty();
        mut ctx: ResolutionContext = ResolutionContext::new("", "");
        const nargs: i64 = if (tmpl.param_type_ids.length < sr.scope_generic_args.length) {
            tmpl.param_type_ids.length
        } else {
            sr.scope_generic_args.length
        };
        for (mut i: i64 = 0; i < nargs; i++) {
            const a: TypeRef = this.type_resolver.resolve(sr.scope_generic_args[i], &ctx);
            if (!a.is_valid()) { return TypeRef::invalid(); }
            method_subst.add(tmpl.param_type_ids[i], a);
        }

        for (mut i: i64 = 0; i < struct_ast.methods.length; i++) {
            const m: MethodNode* = struct_ast.methods[i];
            if (m == null || m.func == null) { continue; }
            if (!m.func.name.equals(sr.member_name)) { continue; }
            if (m.func.generic_params.length > 0) { return TypeRef::invalid(); }
            mut ret: TypeRef = m.func.resolved_return_type;
            if (!ret.is_valid()) { return TypeRef::invalid(); }
            if (!method_subst.is_empty()) {
                ret = method_subst.apply(ret, this.arena);
            }
            // `apply` builds a fresh InstantiatedType (e.g. `Range<i32>` from
            // `Range<T>`); link it to the already-monomorphized concrete type
            // when one exists so a chained `.take(n)` specializes against a
            // resolved receiver.
            return this.arena.canonical_resolved(ret);
        }
        return TypeRef::invalid();
    }

    /// Look up a generic function template by call-site bare name.
    /// Tries the current consuming module first, then walks the registry's
    /// declarations to find a function template whose unqualified name matches.
    /// Returns null when nothing matches or the match isn't a function template.
    /// Scope-aware variant of `find_function_template_for_call` for a
    /// module-qualified call (`scope::name`): finds a free-function template
    /// whose leaf is `name` AND whose defining module equals `scope_q` (the
    /// call's resolved scope namespace).  This is what keeps a namespace
    /// qualifier load-bearing: `parser::parse` must NOT bind to an unrelated
    /// type's static method `Request::parse<R>` just because both share the
    /// leaf `parse` (which then fails its `where R: Read` bound, E0306).  A
    /// type's static method has the type as its module/scope, so it won't
    /// match a module namespace here.
    find_scoped_function_template(mut &this, name: SymbolStr,
                                  scope: SymbolStr) -> TemplateEntry* {
        const registry: GenericRegistry* = this.generic_registry;
        if (registry == null || !scope.is_valid()) { return null; }
        // Match by qualified-name suffix against the scope AS WRITTEN, e.g.
        // `mem::offset` accepts `std::core::mem::offset` (suffix
        // `::mem::offset`) but a same-leaf static method
        // `std::net::http::request::Request::parse` does NOT (its suffix is
        // `::Request::parse`).  This is independent of `resolve_qualified`,
        // which doesn't reliably expand a module alias to its full path.
        const scope_str: string = this.intern_table.resolve(scope);
        const name_str: string  = this.intern_table.resolve(name);
        const tail: string      = format("%s::%s", scope_str, name_str);
        const sep_tail: string  = format("::%s", tail);
        const tail_len: i64     = strlen(tail) as i64;
        const total: i64 = registry.template_count();
        for (mut i: i64 = 0; i < total; i++) {
            const cand: TemplateEntry* = &registry.entries[i];
            if (cand == null) { continue; }
            if (cand.node_kind != NodeKind::FunctionDeclaration) { continue; }
            if (!cand.name.equals(name)) { continue; }
            const qn: string = this.intern_table.resolve(cand.qualified_name);
            // qn ends with `::scope::name`, or IS exactly `scope::name`.
            if (mono_str_ends_with(qn, sep_tail)) { return cand; }
            if (strlen(qn) as i64 == tail_len && mono_str_ends_with(qn, tail)) {
                return cand;
            }
        }
        return null;
    }

    find_function_template_for_call(mut &this, name: SymbolStr) -> TemplateEntry* {
        const registry: GenericRegistry* = this.generic_registry;
        if (registry == null) { return null; }
        // Try current module's qualified form first.
        const name_str: string = this.intern_table.resolve(name);
        const cur_mod_str: string = this.intern_table.resolve(this.current_module);
        if (strlen(cur_mod_str) > 0) {
            const q1_str: string = cur_mod_str + "::" + name_str;
            const q1: SymbolStr = this.intern_table.intern(q1_str);
            const e1: TemplateEntry* = registry.get_template(q1);
            if (e1 != null && e1.node_kind == NodeKind::FunctionDeclaration) { return e1; }
        }
        // Bare-name registry lookup (usually a miss because templates are
        // keyed by their qualified name, but cheap to attempt).
        const e2: TemplateEntry* = registry.get_template(name);
        if (e2 != null && e2.node_kind == NodeKind::FunctionDeclaration) { return e2; }
        // Linear scan: the call site's `current_module` is the consuming
        // module, not the module where the function was defined (e.g.,
        // `alloc_entry` lives in `std::collections::hash_map`, but a
        // consuming call site might be in `std::env` or any module that
        // instantiated `HashMap`).  Match by bare `entry.name` to find
        // any function template whose unqualified name matches.  Linear
        // is fine for now; the registry holds tens-to-hundreds of
        // entries and inferred-arg calls are rare relative to total
        // expression visits.
        const total: i64 = registry.template_count();
        for (mut i: i64 = 0; i < total; i++) {
            const cand: TemplateEntry* = &registry.entries[i];
            if (cand == null) { continue; }
            if (cand.node_kind != NodeKind::FunctionDeclaration) { continue; }
            if (cand.name.equals(name)) { return cand; }
        }
        return null;
    }

    /// Pin a specialized callee on a generic free-function call so codegen
    /// can resolve it.  Accepts both bare-Identifier callees (`offset(p, n)`)
    /// and ScopeResolution callees (`mem::offset(p, n)`, `Layout::array<T>(n)`).
    /// When the call carries explicit generic args the bindings are seeded
    /// directly; otherwise they're inferred by formal<->actual unification on
    /// the call's argument types.  Queues an instantiation request so the
    /// concrete function is produced in the same mono iteration.  No-op when
    /// the callee isn't a generic function template, arity mismatches, or
    /// inference fails.
    try_infer_function_call(mut &this, call: CallExprNode*,
                            res_ctx: ResolutionContext*,
                            subst: TypeSubstitution*,
                            names: &SymbolStr[], types: &TypeRef[]) -> void {
        if (call == null) { return; }
        if (call.resolved_callee.is_valid()) { return; }
        if (call.callee == null) { return; }
        const callee_node: ASTNode* = call.callee as ASTNode*;

        // Extract the bare callee name and any qualifying scope.  Identifier
        // callees are bare (`offset(...)`); ScopeResolution callees are
        // `scope::member` where scope can be a module or a type.  Explicit
        // generic args may live on the call itself OR on the ScopeResolution
        // node (e.g., `Layout::array<T>(n)` parses with the <T> on the SR).
        mut callee_name:  SymbolStr           = SymbolStr::empty();
        mut callee_scope: SymbolStr           = SymbolStr::empty();
        mut explicit_args: &TypeAnnotation*[] = &call.generic_args;
        if (callee_node.kind == NodeKind::Identifier) {
            const ident: IdentifierNode* = call.callee as IdentifierNode*;
            callee_name = ident.name;
        } else if (callee_node.kind == NodeKind::ScopeResolution) {
            const sr: ScopeResolutionNode* = call.callee as ScopeResolutionNode*;
            callee_name  = sr.member_name;
            callee_scope = sr.scope_name;
            if (explicit_args.length == 0 && sr.generic_args.length > 0) {
                explicit_args = &sr.generic_args;
            }
        } else {
            return;
        }

        // Look up the function template.  Two flavors of ScopeResolution:
        //   * Type-scope (`Owner::method(...)` where Owner is a struct/
        //     class/enum): must match an exact `Owner::method` template.
        //     Bare-name linear-scan fallback is suppressed because it
        //     would happily resolve `IpV4Addr::parse(addr)` to
        //     `Request::parse<R>` (same leaf "parse"), inferring R from
        //     the wrong arg-shape and specializing a never-correct
        //     instantiation.
        //   * Module-scope (`mod::fn(...)`): bare-name fallback IS
        //     correct: templates are registered under their fully-
        //     qualified module path (e.g.
        //     `std::core::mem::offset`), not under the user-written
        //     module alias (`mem`).  Distinguished by `lookup_type`
        //     returning invalid for the scope (i.e. it isn't a type).
        //   * Identifier callees (no scope): bare-name search is
        //     always right; module qualification is implicit.
        mut entry: TemplateEntry* = null;
        if (callee_scope.is_valid()) {
            const member_str: string = this.intern_table.resolve(callee_name);
            const qualified_scope: SymbolStr = if (this.decl_index != null) {
                this.decl_index.resolve_qualified(callee_scope)
            } else {
                callee_scope
            };
            // Qualified scope first.
            const qscope_str: string = this.intern_table.resolve(qualified_scope);
            const qualified_str: string = qscope_str + "::" + member_str;
            const qsym: SymbolStr = this.intern_table.intern(qualified_str);
            const qe: TemplateEntry* = this.generic_registry.get_template(qsym);
            if (qe != null && qe.node_kind == NodeKind::FunctionDeclaration) {
                entry = qe;
            }
            // Bare-scope form (in case the scope is already qualified or
            // the template happens to be registered under the bare key).
            if (entry == null && !qualified_scope.equals(callee_scope)) {
                const bscope_str: string = this.intern_table.resolve(callee_scope);
                const bare_str: string = bscope_str + "::" + member_str;
                const bsym: SymbolStr = this.intern_table.intern(bare_str);
                const be: TemplateEntry* = this.generic_registry.get_template(bsym);
                if (be != null && be.node_kind == NodeKind::FunctionDeclaration) {
                    entry = be;
                }
            }
            // Module-scope fallback: if the scope isn't a known type,
            // it must be a module alias; re-run the bare-name search,
            // which scans templates by their leaf name and finds e.g.
            // `std::core::mem::offset` from a source `mem::offset(...)`.
            if (entry == null && this.decl_index != null) {
                const scope_as_type: TypeRef = this.decl_index.lookup_type(callee_scope);
                const qscope_as_type: TypeRef =
                    if (qualified_scope.equals(callee_scope)) {
                        scope_as_type
                    } else {
                        this.decl_index.lookup_type(qualified_scope)
                    };
                if (!scope_as_type.is_valid() && !qscope_as_type.is_valid()) {
                    // Scope-qualified call to a non-type scope (a module
                    // alias): only accept a free-function template that
                    // actually lives in that module.  A bare leaf-name match
                    // would wrongly bind `parser::parse` to a same-named
                    // static method on an unrelated type (e.g.
                    // `Request::parse<R> where R: Read`) and fail its bound.
                    entry = this.find_scoped_function_template(callee_name, callee_scope);
                }
                // Static-method-on-generic-struct case: scope IS a known
                // type AND it's a generic template (e.g. `Slice<T>`).  The
                // method is non-generic (lives on the parent struct's
                // generic params, not its own), so it isn't in
                // `entries[]` as a function template; instead, walk the
                // template's StructDeclNode methods, infer the struct's
                // generics from the call's arg types, instantiate the
                // spec'd struct, and pin the spec'd callee symbol.  Without
                // this, calls like `Slice::from_raw(&local[0], 1)`
                // synthesized into trait-default bodies (e.g. FmtWrite's
                // `write_byte`) leave `resolved_callee` null and codegen
                // fails to find the spec'd `Slice_u8::from_raw`.
                if (entry == null) {
                    if (this.try_infer_static_method_on_generic_template(
                            call, qualified_scope, callee_scope, callee_name,
                            res_ctx, subst, names, types)) {
                        return;
                    }
                }
            }
        } else {
            entry = this.find_function_template_for_call(callee_name);
        }
        if (entry == null) { return; }
        const tmpl_func: FunctionDeclNode* = entry.ast_node as FunctionDeclNode*;
        if (tmpl_func == null) { return; }

        // Reset and size the inference scratch buffer.  Lives on the
        // struct so the recursive unifier can read/write it without a
        // pointer-to-array argument (write-through-`(*ptr)[i] = value`
        // has historically not lowered correctly).  Reusing across calls
        // is safe because unify_for_inference only self-calls; no other
        // code path touches this.inference_bindings while we're filling it.
        this.inference_bindings = [];
        this.inference_param_ids = [];
        for (mut i: i64 = 0; i < entry.param_type_ids.length; i++) {
            this.inference_bindings.push(TypeRef::invalid());
            this.inference_param_ids.push(entry.param_type_ids[i]);
        }

        if (explicit_args.length > 0) {
            // Caller-supplied generic args are authoritative; resolve each
            // annotation to a TypeRef and seed the bindings directly.  This
            // skips arg-type unification because the caller already pinned
            // every parameter.  Handles both `Layout::array<T>(n)` (one
            // explicit arg, one generic param) and partially-supplied cases
            // by running expand_default_type_args afterward.
            if (res_ctx == null || this.type_resolver == null) { return; }
            mut seeded: TypeRef[] = [];
            for (mut i: i64 = 0; i < explicit_args.length; i++) {
                mut tr: TypeRef = this.type_resolver.resolve(explicit_args[i], res_ctx);
                if (!tr.is_valid()) { return; }
                if (subst != null) {
                    tr = subst.apply(tr, this.arena);
                }
                seeded.push(tr);
            }
            seeded = this.type_resolver.expand_default_type_args(entry, seeded, res_ctx);
            if (seeded.length != entry.param_type_ids.length) { return; }
            for (mut i: i64 = 0; i < seeded.length; i++) {
                this.inference_bindings[i] = seeded[i];
            }
        } else {
            // No explicit args; infer from the call's argument types.
            if (tmpl_func.parameters.length != call.arguments.length) { return; }

            // Walk every (formal, actual) pair, but skip the arg when it
            // can't be resolved to a TypeRef (e.g. a literal that hasn't
            // gone through sema yet) or the formal lacks a resolved type.
            // Skipping is safe: unify_for_inference only fills a binding on
            // match, so a missed arg can't introduce a wrong binding; it
            // just leaves that binding for another arg to fill.  The
            // post-loop "all bindings valid" check below remains the
            // authoritative gate; we only pin a callee when every generic
            // param has been bound.  This is what lets `mem::offset(this.ptr,
            // 1)` resolve: T pins from arg[0] (`T*` <-> `Point*`), arg[1] (`1`)
            // is unresolvable but inconsequential since it has no generics.
            // PASS A - bind generic params from NON-literal arguments only.
            // Integer/float literals are polymorphic (see
            // arg_is_polymorphic_literal): they must not pin `T` to their i32
            // default, or a wider sibling argument / return-type context gets
            // silently narrowed. Literals are filled in Pass C below.
            for (mut i: i64 = 0; i < call.arguments.length; i++) {
                const param: VarDeclNode* = tmpl_func.parameters[i];
                if (param == null || !param.resolved_type.is_valid()) { continue; }
                const arg: ExpressionNode* = call.arguments[i];
                if (this.arg_is_polymorphic_literal(arg)) { continue; }
                mut actual: TypeRef = this.resolve_arg_type_for_inference(arg, names, types);
                if (!actual.is_valid()) { continue; }
                if (subst != null) {
                    actual = subst.apply(actual, this.arena);
                }
                this.infer_conflict_from = TypeRef::invalid();
                this.infer_conflict_to   = TypeRef::invalid();
                this.unify_for_inference(param.resolved_type, actual);
                // A generic param bound by an earlier argument now meets a
                // structurally different actual in this position. Both are
                // NON-literal concrete types (literals were skipped), so there
                // is genuinely no single `T`: reject precisely - whether the
                // pair is a hard category mismatch (`i32`/`string`) or merely a
                // coercible numeric pair (`i32`/`i64`). The old code let
                // coercible pairs through "pin-first", which silently narrowed
                // the second argument to the first's width - a miscompile. Any
                // pair still carrying a generic param keeps pin-first so
                // generic forwarding (`T` <- `U`) is unaffected.
                if (this.infer_conflict_from.is_valid()
                        && this.infer_conflict_to.is_valid()
                        && this.infer_type_is_concrete(this.infer_conflict_from)
                        && this.infer_type_is_concrete(this.infer_conflict_to)) {
                    this.emit_infer_conflict(call, callee_name, arg,
                        this.infer_conflict_from, this.infer_conflict_to);
                    return;
                }
            }
        }

        // PASS B - return-type-driven inference. Any generic param still
        // unbound after non-literal args is recovered by unifying the
        // template's declared return type against the call's expected type
        // (the `const x: T = ...` this call initializes). Bare `T` return
        // types bind directly; compound return types (`Option<T>`, `T*`,
        // `Box<T>`) bind structurally via the same unifier.
        //
        // This now runs for ALL callees (not just `![implicit]`): with Pass A
        // no longer letting a polymorphic literal pin `T`, a call like
        // `mut b: Box<i64> = Box::new(99)` must recover `T = i64` from the
        // expected `Box<i64>` rather than defaulting the literal to i32 and
        // monomorphizing `Box<i32>` (the silent-truncation miscompile). It is
        // fill-only (guarded by `any_unbound`) and never overrides a param a
        // real argument already pinned, so calls that fully infer from their
        // arguments are unaffected.
        if (this.current_expected_type.is_valid()
                && tmpl_func.resolved_return_type.is_valid()) {
            mut any_unbound: boolean = false;
            for (mut i: i64 = 0; i < this.inference_bindings.length; i++) {
                if (!this.inference_bindings[i].is_valid()) { any_unbound = true; break; }
            }
            if (any_unbound) {
                this.unify_for_inference(
                    tmpl_func.resolved_return_type, this.current_expected_type);
            }
        }

        // PASS C - literal fallback. A polymorphic literal argument whose
        // generic param is STILL unbound (no non-literal arg and no usable
        // return-type context pinned it) fills the param with its default
        // type (i32 / f64). A literal whose param another source already
        // bound is left alone - codegen coerces the literal to that width, so
        // `Box<i64>::new(99)` stores a full i64. This keeps `Box::new(99)` and
        // `id(0)` inferring as before when no wider context exists.
        if (explicit_args.length == 0) {
            for (mut i: i64 = 0; i < call.arguments.length; i++) {
                const param: VarDeclNode* = tmpl_func.parameters[i];
                if (param == null || !param.resolved_type.is_valid()) { continue; }
                const arg: ExpressionNode* = call.arguments[i];
                if (!this.arg_is_polymorphic_literal(arg)) { continue; }
                mut lit_actual: TypeRef = this.resolve_arg_type_for_inference(arg, names, types);
                if (!lit_actual.is_valid()) { continue; }
                if (subst != null) {
                    lit_actual = subst.apply(lit_actual, this.arena);
                }
                const bound: TypeRef = this.bound_type_for_formal(param.resolved_type);
                if (bound.is_valid()) {
                    // The param was already pinned (by a non-literal arg or the
                    // return type). The literal adopts that type IF it can
                    // coerce to it - any numeric width. A non-numeric binding
                    // (e.g. `second(5, "hello")` pins `T = string` from the
                    // string arg) means the literal genuinely has no shared
                    // `T`: reject, mirroring the two-concrete case in Pass A.
                    // Without this, reordering literals to a later pass would
                    // let `second(5, "hello")` slip through unflagged.
                    mut tc: TypeChecker = TypeChecker::new(this.arena);
                    if (tc.check_compatibility(lit_actual, bound)
                            == TypeCompatibility::Incompatible) {
                        this.emit_infer_conflict(call, callee_name, arg, bound, lit_actual);
                        return;
                    }
                    continue;  // numeric: codegen coerces the literal to `bound`
                }
                // Param still unbound: fill it with the literal's default type.
                this.unify_for_inference(param.resolved_type, lit_actual);
            }
        }

        mut fn_all_bound: boolean = true;
        for (mut i: i64 = 0; i < this.inference_bindings.length; i++) {
            if (!this.inference_bindings[i].is_valid()) { fn_all_bound = false; break; }
        }
        if (!fn_all_bound) {
            // An `![implicit]` callee with no explicit args that we still
            // couldn't pin had no usable expected type (or a return type the
            // expected type didn't determine): report it precisely instead of
            // letting codegen later fail with a misleading "not in scope".
            if (tmpl_func.is_implicit && explicit_args.length == 0) {
                this.emit_cannot_infer(call, tmpl_func.name);
            }
            return;
        }

        // Where-clause bound check at the call site.  If the inferred
        // type args don't satisfy the function's `where T: Trait`
        // clauses, emit a "the trait bound `X: Y` is not satisfied"
        // diagnostic at the call expression and skip pin + queue.
        // Skipping the queue prevents the spec'd body from being
        // produced; that's what suppresses the cascade of follow-on
        // errors (`as_str`, `drop`, ...) that come from the rejected
        // body's type-check after monomorphization.
        if (!this.check_function_bounds_at_call(call, tmpl_func, entry)) {
            return;
        }

        // Pin the specialized callee symbol on the call (codegen consumes it)
        // and queue the instantiation so this same mono iteration produces
        // the concrete function before codegen runs.  Use `spec_base_name`
        // so static method templates with the same leaf (`Request::parse`,
        // `Response::parse`) get distinct spec symbols.
        const base_sym: SymbolStr = entry.spec_base_name(this.intern_table);
        const base_qname: QualifiedName = QualifiedName::from_symbol(base_sym);
        const spec_sym: SymbolStr = MangledName::specialized_identifier(
            this.intern_table, this.arena, base_qname, this.inference_bindings);
        if (!spec_sym.is_valid()) { return; }
        call.set_resolved_callee(spec_sym);
        const new_inst: TypeRef = this.generic_registry.instantiate_for_module(
            entry.base_type, this.inference_bindings, this.current_module);
        // Seed mono's pending worklist directly: the registry only tracks
        // cache_keys, and drain_pending_worklist (run by the discover-walk's
        // caller) iterates `pending`, not cache_keys.  Without this seed, an
        // instantiation discovered by the LAST module in topo order is left
        // in cache_keys with no specialization, and GenericValidation later
        // rejects the orphaned InstantiatedType with E0900.  enqueue_from_type_ref
        // is idempotent on already-monomorphized refs and filters partial specs,
        // so calling it on a cache-hit is also safe.
        this.enqueue_from_type_ref(new_inst);
    }

    /// Verify the function template's `where`-clause bounds hold for
    /// the inferred type args in `inference_bindings`.  On the first
    /// failing bound, emits a rich diagnostic (primary span at the
    /// call expression, secondary at the failing TraitRef) and returns
    /// false so the caller can skip pinning and enqueueing; that's
    /// what stops the cascade of follow-on errors from the rejected
    /// body type-check.
    check_function_bounds_at_call(mut &this, call: CallExprNode*,
                                    tmpl_func: FunctionDeclNode*,
                                    entry: TemplateEntry*) -> boolean {
        if (tmpl_func == null || entry == null) { return true; }
        if (tmpl_func.trait_bounds.length == 0) { return true; }
        for (mut bi: i64 = 0; bi < tmpl_func.trait_bounds.length; bi++) {
            const bound: TraitBound* = &tmpl_func.trait_bounds[bi];
            // Find the position of this bound's type parameter in the
            // template's generic-param order, which is the index into
            // `inference_bindings` for the inferred concrete type.
            mut idx: i64 = -1;
            for (mut pi: i64 = 0; pi < entry.param_names.length; pi++) {
                if (entry.param_names[pi].equals(bound.type_parameter)) {
                    idx = pi;
                    break;
                }
            }
            if (idx < 0 || idx >= this.inference_bindings.length) { continue; }
            const concrete: TypeRef = this.inference_bindings[idx];
            if (!concrete.is_valid()) { continue; }
            // Each `T: A + B` carries a list of trait_refs; every one
            // must hold.  First failure emits and short-circuits.
            for (mut ri: i64 = 0; ri < bound.trait_refs.length; ri++) {
                const tref: TraitRef* = &bound.trait_refs[ri];
                if (tref.path.length == 0) { continue; }
                const trait_name: SymbolStr = tref.path[tref.path.length - 1];
                if (!this.type_implements_trait(concrete, trait_name, 0)) {
                    this.emit_call_bound_failure(
                        call, tmpl_func, tref, concrete, trait_name);
                    return false;
                }
            }
        }
        return true;
    }

    /// Emit a "the trait bound `X: Y` is not satisfied" diagnostic in
    /// the format the user's call-site sees: primary caret at the
    /// invocation, a secondary "required by this bound in `func`"
    /// label at the offending where-clause TraitRef, and a help line
    /// with the actionable next step.
    emit_call_bound_failure(mut &this, call: CallExprNode*,
                              tmpl_func: FunctionDeclNode*,
                              tref: TraitRef, concrete: TypeRef,
                              trait_name: SymbolStr) -> void {
        const trait_str: string = this.intern_table.resolve(trait_name);
        const fn_str: string = this.intern_table.resolve(tmpl_func.name);
        const concrete_t: Type* = this.arena.lookup(concrete.id);
        const concrete_str: string = if (concrete_t != null) {
            this.arena.format_display(concrete_t)
        } else {
            "?"
        };
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
            format("the trait bound `%s: %s` is not satisfied",
                concrete_str, trait_str));
        diag = diag.at(call.span);
        diag = diag.also_at(tref.span, format(
            "required by this bound in `%s`", fn_str));
        diag = diag.with_note(format(
            "the trait `%s` is not implemented for `%s`",
            trait_str, concrete_str));
        diag = diag.help(format(
            "implement `%s` for `%s`, or pass an argument of a type that already does",
            trait_str, concrete_str));
        this.diagnostics.emit(diag);
    }

    /// Emit E0307 for an `![implicit]` call whose generic type argument could
    /// not be recovered: there was no expected type at the call site (it isn't
    /// the initializer of a typed binding) and no argument pins the parameter.
    /// Points at the call and suggests writing the type argument explicitly.
    emit_cannot_infer(mut &this, call: CallExprNode*, fn_name: SymbolStr) -> void {
        const fn_str: string = this.intern_table.resolve(fn_name);
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0307_CANNOT_INFER_TYPE_ARG,
            format("cannot infer the type argument for `%s`", fn_str));
        diag = diag.at(call.span);
        diag = diag.with_note(
            "`![implicit]` recovers the type argument from the expected type, but this call is not in a typed context (e.g. a `const x: T = ...` initializer)");
        diag = diag.help(format(
            "write the type argument explicitly, e.g. `%s<T>(...)`", fn_str));
        this.diagnostics.emit(diag);
    }

    /// True when `t` contains no open generic/bounded param and bottoms out at
    /// a concrete representation. Mirrors sema's `arg_type_is_concrete` so the
    /// inference-conflict check applies the same conservatism: `()`/`void` and
    /// any param-carrying type are treated as non-concrete and never flagged.
    infer_type_is_concrete(&this, t: TypeRef) -> boolean {
        if (!t.is_valid()) { return false; }
        const ty: Type* = this.arena.lookup(t.id);
        if (ty == null) { return false; }
        if (ty.kind == TypeKind::GenericParam)     { return false; }
        if (ty.kind == TypeKind::BoundedParam)     { return false; }
        if (ty.kind == TypeKind::FunctionTemplate) { return false; }
        if (ty.kind == TypeKind::Function)         { return false; }
        if (ty.kind == TypeKind::Unit)             { return false; }
        if (ty.kind == TypeKind::Void)             { return false; }
        if (ty.kind == TypeKind::Pointer) {
            const pt: PointerType* = ty as PointerType*;
            return this.infer_type_is_concrete(pt.pointee);
        }
        if (ty.kind == TypeKind::Reference) {
            const rt: ReferenceType* = ty as ReferenceType*;
            return this.infer_type_is_concrete(rt.referent);
        }
        if (ty.kind == TypeKind::Array) {
            const at: ArrayType* = ty as ArrayType*;
            return this.infer_type_is_concrete(at.element);
        }
        if (ty.kind == TypeKind::Optional) {
            const ot: OptionalType* = ty as OptionalType*;
            return this.infer_type_is_concrete(ot.wrapped);
        }
        if (ty.kind == TypeKind::Tuple) {
            const tt: TupleType* = ty as TupleType*;
            for (mut i: i64 = 0; i < tt.elements.length; i++) {
                if (!this.infer_type_is_concrete(tt.elements[i])) { return false; }
            }
            return true;
        }
        if (ty.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = ty as InstantiatedType*;
            if (!inst.has_resolved_type()) { return false; }
        }
        return true;
    }

    /// True when `expr` is a bare (or simply negated) integer / float
    /// literal whose type has not yet been pinned by an earlier phase.
    /// Such literals are POLYMORPHIC during generic-argument inference: a
    /// literal must adopt whatever concrete type the generic param is bound
    /// to by a non-literal argument or the expected return type, defaulting
    /// to i32 / f64 only when nothing else constrains it. Letting a literal
    /// pin `T` to its i32 default (the old behavior) silently truncated wider
    /// values - e.g. `Box<i64>::new(1234567890123)` monomorphized `Box<i32>`
    /// and stored 4 bytes. Mono runs before sema, so the literal carries no
    /// resolved_type here; that is exactly why the default must not pin T.
    arg_is_polymorphic_literal(&this, expr: ExpressionNode*) -> boolean {
        if (expr == null) { return false; }
        if (expr.resolved_type.is_valid()) { return false; }
        const node: ASTNode* = expr as ASTNode*;
        if (node.kind == NodeKind::Literal) {
            const lit: LiteralNode* = expr as LiteralNode*;
            return lit.literal_kind == LiteralKind::Integer
                || lit.literal_kind == LiteralKind::Float;
        }
        // `-5`, `+n`, `~mask` parse as Unary(op, <expr>); a unary over a
        // polymorphic numeric constant is itself polymorphic.
        if (node.kind == NodeKind::UnaryExpression) {
            const u: UnaryExprNode* = expr as UnaryExprNode*;
            if (u.op.lexeme == "-" || u.op.lexeme == "+" || u.op.lexeme == "~") {
                return this.arg_is_polymorphic_literal(u.operand);
            }
            return false;
        }
        // A compile-time-constant numeric expression (`1 << 40`,
        // `3_000_000_000 + 3_000_000_000`) is as polymorphic as the bare
        // literals it is built from: its operands default to i32, so letting
        // it pin `T` silently narrows a wider slot (`Box<i64>`, a `u64` param)
        // exactly like a bare literal would. Only arithmetic/bitwise/shift ops
        // qualify - comparisons and logical ops yield bool, not a numeric the
        // param could adopt. The expected type recovers the real width in
        // Pass B; codegen evaluates the operands at that width (sema pushes the
        // slot type onto the expression - see is_constant_numeric_expr).
        if (node.kind == NodeKind::BinaryExpression) {
            const b: BinaryExprNode* = expr as BinaryExprNode*;
            const op: string = b.op.lexeme;
            const is_arith: boolean =
                op == "+" || op == "-" || op == "*" || op == "/" || op == "%"
                || op == "<<" || op == ">>" || op == "&" || op == "|" || op == "^";
            if (!is_arith) { return false; }
            return this.arg_is_polymorphic_literal(b.left)
                && this.arg_is_polymorphic_literal(b.right);
        }
        return false;
    }

    /// When `formal` is a bare open generic param of the call being inferred
    /// that already has a binding, return that bound concrete type; otherwise
    /// return invalid. Used by the literal-fallback pass to decide whether a
    /// polymorphic literal can adopt the param's already-pinned type (any
    /// numeric width) or genuinely conflicts with it (e.g. a `string`).
    bound_type_for_formal(&this, formal: TypeRef) -> TypeRef {
        if (!formal.is_valid()) { return TypeRef::invalid(); }
        const ft: Type* = this.arena.lookup(formal.id);
        if (ft == null) { return TypeRef::invalid(); }
        if (ft.kind != TypeKind::GenericParam && ft.kind != TypeKind::BoundedParam) {
            return TypeRef::invalid();
        }
        for (mut i: i64 = 0; i < this.inference_param_ids.length; i++) {
            if (this.inference_param_ids[i] == formal.id) {
                return this.inference_bindings[i];
            }
        }
        return TypeRef::invalid();
    }

    /// A single generic parameter was inferred to two incompatible concrete
    /// types across argument positions (`f<T>(a: T, b: T)` called
    /// `f(5, "hello")`). Report at the offending argument so the user sees
    /// exactly which value disagrees with the earlier-pinned type.
    emit_infer_conflict(mut &this, call: CallExprNode*, fn_name: SymbolStr,
                        arg: ExpressionNode*, bound: TypeRef, got: TypeRef) -> void {
        const fn_str:    string = this.intern_table.resolve(fn_name);
        const bound_str: string = this.arena.resolve_display_name_short(bound.id);
        const got_str:   string = this.arena.resolve_display_name_short(got.id);
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0214_ARGUMENT_MISMATCH,
            format("conflicting types for the type parameter of `%s`", fn_str));
        const anchor: SourceSpan = if (arg != null && arg.span.has_location()) {
            arg.span
        } else {
            call.span
        };
        diag = diag.at_with_label(anchor,
            format("expected `%s` (inferred from an earlier argument), found `%s`",
                   bound_str, got_str));
        diag = diag.with_note(format(
            "a single type parameter cannot be both `%s` and `%s`",
            bound_str, got_str));
        this.diagnostics.emit(diag);
    }

    /// Try to specialize `Owner::method(...)` where Owner is a GENERIC
    /// struct/class template and `method` is a (possibly non-generic)
    /// inline method on that template.  Used for calls like
    /// `Slice::from_raw(&local[0], 1)` whose owner type's generic
    /// params (T) come from the parent struct, not the method itself.
    ///
    /// Inference walks the method's formal params against the call's
    /// actual args, unifying to bind the OWNER's generic params (the
    /// `param_type_ids` come from the template entry, not the method).
    /// On success, instantiates the spec'd owner type (e.g. `Slice<u8>`)
    /// and pins a `Owner_<args>::method`-shaped resolved_callee on the
    /// call.  Returns true when inference succeeds and the call is pinned.
    /// Force an InstantiatedType receiver to be monomorphized *now* so an
    /// adapter built over it specializes against a resolved struct, not an
    /// unresolved placeholder.  The named-local combinator path (`r.take(n)`)
    /// works because the local's annotation was monomorphized in `process_all`
    /// before inference runs; a call-expression receiver
    /// (`Range<i32>::new(..).take(n)`) produces its instantiation during this
    /// same inference walk, so its concrete struct doesn't exist yet.  Resolving
    /// the `This` in the adapter's `TakeIter<This>` return against an unresolved
    /// receiver yields an invalid type and crashes the mangler; specializing the
    /// receiver here closes that gap.  Returns the resolved concrete type when
    /// it could be produced, else `ty` unchanged.
    ensure_receiver_inst_resolved(mut &this, ty: TypeRef) -> TypeRef {
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null || t.kind != TypeKind::InstantiatedType) { return ty; }
        const inst: InstantiatedType* = t as InstantiatedType*;
        if (inst.has_resolved_type()) { return inst.resolved_type; }
        if (this.generic_registry == null) { return ty; }
        // An equivalent instantiation may already be resolved under a different
        // arg representation; reuse it before doing any work.
        const existing: TypeRef = this.arena.canonical_resolved(ty);
        if (!existing.equals(ty)) { return existing; }
        const key: string = this.make_key_for(inst.generic_base, inst.type_args);
        // Already specialized elsewhere: the canonical-resolved lookup above
        // would have found it unless its raw-id propagation didn't reach this
        // inst; force the link, then return the concrete type.
        if (this.is_cached(key)) {
            const req_c: MonomorphRequest = MonomorphRequest {
                generic_type: ty,            type_args: mono_copy_type_refs(&inst.type_args),
                base_type:    inst.generic_base, span:   SourceSpan::none(),
            };
            this.propagate_cached_resolution(key, req_c);
            return this.arena.canonical_resolved(ty);
        }
        // Mid-specialization of this very type (we're walking its own body):
        // don't re-enter, or the cycle guard fires.  Leave it unresolved.
        if (this.is_in_progress(key)) { return ty; }
        // Specialize JUST this receiver instantiation now - not the whole
        // worklist, which would error on items legitimately in-progress higher
        // up the specialization stack.  Mirror the worklist loop's in-progress
        // bracketing; nested instantiations the spec discovers are enqueued for
        // the post-walk drain, not processed here.
        const reg: TypeRef = this.generic_registry.instantiate_for_module(
            inst.generic_base, inst.type_args, this.current_module);
        const reg_t: Type* = this.arena.lookup(reg.id);
        if (reg_t == null || reg_t.kind != TypeKind::InstantiatedType) { return ty; }
        const reg_inst: InstantiatedType* = reg_t as InstantiatedType*;
        const request: MonomorphRequest = MonomorphRequest {
            generic_type: reg,                  type_args: mono_copy_type_refs(&reg_inst.type_args),
            base_type:    reg_inst.generic_base, span:      SourceSpan::none(),
        };
        this.in_progress.insert(key, true);
        this.specialize_request(request, key);
        this.remove_in_progress(key);
        this.generic_registry.mark_monomorphized(reg_inst.generic_base, reg_inst.type_args);
        return this.arena.canonical_resolved(ty);
    }

    try_infer_static_method_on_generic_template(mut &this,
            call: CallExprNode*, qualified_scope: SymbolStr,
            bare_scope: SymbolStr, member_name: SymbolStr,
            res_ctx: ResolutionContext*, subst: TypeSubstitution*,
            names: &SymbolStr[], types: &TypeRef[]) -> boolean {
        const registry: GenericRegistry* = this.generic_registry;
        if (registry == null) { return false; }
        // Resolve the scope to a template entry.  Try qualified first
        // (the form TemplateRegistration uses), then bare.
        mut entry: TemplateEntry* = registry.get_template(qualified_scope);
        if (entry == null && !qualified_scope.equals(bare_scope)) {
            entry = registry.get_template(bare_scope);
        }
        if (entry == null) { return false; }
        if (entry.node_kind != NodeKind::StructDeclaration
                && entry.node_kind != NodeKind::ClassDeclaration) {
            return false;
        }
        if (entry.param_count == 0) { return false; }
        if (entry.ast_node == null) { return false; }

        // Find the matching inline method on the owner's AST.  Skip
        // generic methods; those have their OWN inference path
        // (`try_infer_method_call` for instance methods, the existing
        // function-template path for static generic methods on
        // non-generic structs).  This branch only handles non-generic
        // methods on generic owners.
        mut method_func: FunctionDeclNode* = null;
        mut method_is_static: boolean = false;
        if (entry.node_kind == NodeKind::StructDeclaration) {
            const sn: StructDeclNode* = entry.ast_node as StructDeclNode*;
            for (mut i: i64 = 0; i < sn.methods.length; i++) {
                const m: MethodNode* = sn.methods[i];
                if (m == null || m.func == null) { continue; }
                if (!m.func.name.equals(member_name)) { continue; }
                if (m.func.generic_params.length > 0) { continue; }
                method_func = m.func;
                method_is_static = m.is_static;
                break;
            }
        } else {
            const cn: ClassDeclNode* = entry.ast_node as ClassDeclNode*;
            for (mut i: i64 = 0; i < cn.methods.length; i++) {
                const m: MethodNode* = cn.methods[i];
                if (m == null || m.func == null) { continue; }
                if (!m.func.name.equals(member_name)) { continue; }
                if (m.func.generic_params.length > 0) { continue; }
                method_func = m.func;
                method_is_static = m.is_static;
                break;
            }
        }
        if (method_func == null) { return false; }
        // ScopeResolution callees are static-method form (`Type::method`);
        // routing an instance method through here would emit a call with
        // a missing receiver.  Bail to let the regular method-call path
        // handle it.
        if (!method_is_static) { return false; }

        // Build arg-vs-formal unification using the OWNER'S param_type_ids
        // as the inference target; the formals reference T (the owner's
        // generic param), not method-level params.
        this.inference_bindings = [];
        this.inference_param_ids = [];
        for (mut i: i64 = 0; i < entry.param_type_ids.length; i++) {
            this.inference_bindings.push(TypeRef::invalid());
            this.inference_param_ids.push(entry.param_type_ids[i]);
        }

        // Walk explicit user params (skip &this/this, which are irrelevant for
        // static methods, but defensive in case the method is non-static).
        const this_amp: SymbolStr = this.intern_table.intern("&this");
        const this_val: SymbolStr = this.intern_table.intern("this");
        mut explicit_params: VarDeclNode*[] = [];
        for (mut i: i64 = 0; i < method_func.parameters.length; i++) {
            const p: VarDeclNode* = method_func.parameters[i];
            if (p == null) { continue; }
            if (p.name.equals(this_amp) || p.name.equals(this_val)) { continue; }
            explicit_params.push(p);
        }
        if (explicit_params.length != call.arguments.length) { return false; }

        // Three-pass inference, identical in spirit to the free-function
        // path in `discover_inferred_calls_in_expr` (see the Pass A/B/C
        // comments there). The target params here are the OWNER'S generic
        // params (`T` in `Box<T>`), not method-level params.
        //
        // PASS A - bind the owner's params from NON-literal args. An integer/
        // float literal is polymorphic and must NOT pin `T` to its i32
        // default: `Box::new(1234567890123)` for `mut b: Box<i64>` would
        // monomorphize `Box<i32>` and truncate the literal to 1912276171.
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            const param: VarDeclNode* = explicit_params[i];
            if (param == null || !param.resolved_type.is_valid()) { continue; }
            const arg: ExpressionNode* = call.arguments[i];
            if (this.arg_is_polymorphic_literal(arg)) { continue; }
            mut actual: TypeRef = this.resolve_arg_type_for_inference(arg, names, types);
            if (!actual.is_valid()) { continue; }
            if (subst != null) {
                actual = subst.apply(actual, this.arena);
            }
            this.unify_for_inference(param.resolved_type, actual);
        }

        // PASS B - recover any still-unbound owner param from the expected
        // type by unifying the method's declared return type against it. For
        // a constructor `Box::new -> Box<T>` initialising `mut b: Box<i64>`,
        // this binds `T = i64` (the only way a wide literal `Box::new(...)`
        // gets the right owner instantiation). Fill-only; never overrides a
        // param a real argument already pinned.
        if (this.current_expected_type.is_valid()
                && method_func.resolved_return_type.is_valid()) {
            mut any_unbound_b: boolean = false;
            for (mut i: i64 = 0; i < this.inference_bindings.length; i++) {
                if (!this.inference_bindings[i].is_valid()) { any_unbound_b = true; break; }
            }
            if (any_unbound_b) {
                this.unify_for_inference(
                    method_func.resolved_return_type, this.current_expected_type);
            }
        }

        // PASS C - literal fallback. A literal whose owner param is still
        // unbound fills it with the literal's default (i32/f64); a literal
        // whose param another source pinned adopts that type if numeric
        // (codegen coerces), or is rejected if the binding is non-numeric.
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            const param: VarDeclNode* = explicit_params[i];
            if (param == null || !param.resolved_type.is_valid()) { continue; }
            const arg: ExpressionNode* = call.arguments[i];
            if (!this.arg_is_polymorphic_literal(arg)) { continue; }
            mut lit_actual: TypeRef = this.resolve_arg_type_for_inference(arg, names, types);
            if (!lit_actual.is_valid()) { continue; }
            if (subst != null) {
                lit_actual = subst.apply(lit_actual, this.arena);
            }
            const bound: TypeRef = this.bound_type_for_formal(param.resolved_type);
            if (bound.is_valid()) {
                mut tc_c: TypeChecker = TypeChecker::new(this.arena);
                if (tc_c.check_compatibility(lit_actual, bound)
                        == TypeCompatibility::Incompatible) {
                    this.emit_infer_conflict(call, member_name, arg, bound, lit_actual);
                    return true;
                }
                continue;
            }
            this.unify_for_inference(param.resolved_type, lit_actual);
        }

        // Apply default type args (e.g. `String<A = GlobalAlloc>`,
        // `Array<T, A = GlobalAlloc>`) BEFORE the validity check.  The
        // canonical case is a static method whose params don't mention
        // any of the owner's generic params at all (`String::from_str(
        // source: Str)` never references `A`); the inference loop above
        // therefore leaves every binding invalid, but the owner's
        // declared defaults can still pin every slot to a concrete type.
        //
        // `expand_default_type_args` only appends trailing defaults to
        // a *short* args list (`args.length < entry.param_count`).  The
        // pre-sized scratch buffer is already at full length, so we
        // first truncate to the longest valid prefix; expansion then
        // fills the trailing invalid slots from defaults.
        if (res_ctx != null && this.type_resolver != null) {
            mut prefix_len: i64 = 0;
            while (prefix_len < this.inference_bindings.length
                   && this.inference_bindings[prefix_len].is_valid()) {
                prefix_len += 1;
            }
            mut prefix: TypeRef[] = [];
            for (mut i: i64 = 0; i < prefix_len; i++) {
                prefix.push(this.inference_bindings[i]);
            }
            const filled: TypeRef[] = this.type_resolver.expand_default_type_args(
                entry, prefix, res_ctx);
            if (filled.length == entry.param_type_ids.length) {
                this.inference_bindings = filled;
            } else {
                // Default expansion didn't produce the expected arity, so
                // `filled` is discarded here; release its array spine rather
                // than leaking it (TypeRef elements are Copy).
                filled.drop();
            }
        }
        for (mut i: i64 = 0; i < this.inference_bindings.length; i++) {
            if (!this.inference_bindings[i].is_valid()) { return false; }
        }

        // Instantiate the spec'd owner type and ENQUEUE it for the
        // monomorphization worklist.  `instantiate_for_module` only
        // creates the arena InstantiatedType + records demand; it
        // doesn't push onto the worklist.  Without the explicit
        // enqueue, the spec is in the cache but never specialize_request'd,
        // so its methods never get codegen-registered and the linker
        // sees no definition for the symbol we just pinned.  The
        // subsequent `drain_pending_worklist` call in run_monomorphization
        // will pick this request up and produce the spec'd struct +
        // methods.
        const inst_ref: TypeRef = this.generic_registry.instantiate_for_module(
            entry.base_type, this.inference_bindings, this.current_module);
        if (!inst_ref.is_valid()) { return false; }
        this.enqueue_from_type_ref(inst_ref);

        // Constructor-shaped static methods (`Range::new -> Range<T>`,
        // `Array::with_capacity -> Array<T, A>`) return the owner's own
        // instantiation, and value-arg inference has just pinned the
        // type arguments concretely.  Stash the spec'd owner so the
        // `is_auto` VarDecl back-propagation downstream
        // (`discover_inferred_calls_in_stmt`) can lift the for-in
        // iterator local from the template `Range<T>` to `Range<i32>`.
        // Not all statics return their owner template; the matches gate
        // keeps the stash off for `Layout::array<T>(n) -> Layout` (etc.).
        if (this.return_type_matches_owner_template(method_func, entry)) {
            this.last_static_inst_ref = inst_ref;
        }

        // Build the spec'd qualified-owner name and the combined-key
        // callee symbol.  Mirror what `ASTSpecializer::specialize` does:
        //   spec_name      = MangledName::specialized_identifier(<bare>, args)
        //   qualified_spec = qualify_spec_name(entry, spec_name)
        // Then combine with `::<method>` for the codegen lookup key.
        // Without the bare-form `entry.name` here, we'd encode the full
        // qualified path INTO the spec_name (e.g.
        // `3std.4core.5slice.5Slice$Lh$G`); that doesn't match how the
        // ASTSpecializer registers the spec'd struct, so codegen's
        // resolve_function lookup misses.
        const base_qname: QualifiedName = QualifiedName::from_symbol(entry.name);
        const spec_name_sym: SymbolStr = MangledName::specialized_identifier(
            this.intern_table, this.arena, base_qname, this.inference_bindings);
        if (!spec_name_sym.is_valid()) { return false; }
        const spec_name_str: string = this.intern_table.resolve(spec_name_sym);
        const qualified_owner: SymbolStr = this.qualify_spec_name(entry, spec_name_str);
        const owner_str: string = this.intern_table.resolve(qualified_owner);
        const member_str: string = this.intern_table.resolve(member_name);
        const combined_str: string = format("%s::%s", owner_str, member_str);
        const combined_sym: SymbolStr = this.intern_table.intern(combined_str);
        call.set_resolved_callee(combined_sym);
        return true;
    }

    /// True when the syntactic name of the method's declared return type
    /// matches the owner template's bare name.  Used by
    /// `try_infer_static_method_on_generic_template` to detect
    /// constructor-shaped statics (`Range::new -> Range<T>`,
    /// `Array::with_capacity -> Array<T, A>`) so the call's resolved_type
    /// can be updated to the spec'd owner instantiation.
    return_type_matches_owner_template(mut &this, method_func: FunctionDeclNode*,
                                       entry: TemplateEntry*) -> boolean {
        if (method_func == null || entry == null) { return false; }
        if (method_func.return_type_annotation == null) { return false; }
        if (!entry.name.is_valid()) { return false; }
        const ret_name: SymbolStr = this.type_annotation_base_name(
            method_func.return_type_annotation);
        if (!ret_name.is_valid()) { return false; }
        // Compare against the un-qualified template name (`Range`, `Array`)
        // since the return-type annotation is written in the owner's own
        // scope and never carries the full module path.
        return ret_name.equals(entry.name);
    }

    /// Extract the syntactic base name from a type annotation:
    ///   `Named(Range)`           -> "Range"
    ///   `Generic(Named(Range))`  -> "Range"   (peeled once)
    /// Returns an empty SymbolStr for unnameable shapes (tuples, function
    /// pointers, etc.) so the caller short-circuits safely.
    type_annotation_base_name(mut &this, ann: TypeAnnotation*) -> SymbolStr {
        if (ann == null) { return SymbolStr::empty(); }
        return match (*ann) {
            TypeAnnotation::Named(na)   => { na.name }
            TypeAnnotation::Generic(ga) => {
                this.type_annotation_base_name(ga.base)
            }
            _                            => { SymbolStr::empty() }
        };
    }

    /// `&this` twin of `type_annotation_base_name`, peeling
    /// Generic/Reference/Pointer/Optional to the head Named name.  Used by
    /// the trait-impl method lookups (which are `&this`) to read an impl
    /// block's trait leaf and a param annotation's head type for
    /// bound-directed dispatch (Display vs Debug `fmt`).
    trait_leaf_of_ann(&this, ann: TypeAnnotation*) -> SymbolStr {
        if (ann == null) { return SymbolStr::empty(); }
        return match (*ann) {
            TypeAnnotation::Named(na)     => { na.name }
            TypeAnnotation::Generic(ga)   => { this.trait_leaf_of_ann(ga.base) }
            TypeAnnotation::Reference(ra) => { this.trait_leaf_of_ann(ra.inner) }
            TypeAnnotation::Pointer(pa)   => { this.trait_leaf_of_ann(pa.inner) }
            TypeAnnotation::Optional(oa)  => { this.trait_leaf_of_ann(oa.inner) }
            _                             => { SymbolStr::empty() }
        };
    }

    /// Walk every spec'd impl block looking for one whose target is the
    /// given concrete type and that has a method with the given name.
    /// Returns null if no match.  Used by method-call inference to find
    /// the spec'd Hash impl on `String<GA>` (etc.) so `key.hash(&hasher)`
    /// can be monomorphized.
    /// Walk the spec'd struct/class's own `methods[]` for a generic method
    /// whose name matches.  Used for receivers like `NonNull<u8>` whose
    /// owner template carries `cast<U>` inline (not in an impl block).
    /// `out_owner_ast` receives the spec'd struct/class AST so the caller
    /// can push the spec'd sibling onto the right `methods[]` array.
    /// Returns null when no spec entry exists for the receiver yet; the
    /// caller should enqueue the receiver and try again on a later mono
    /// iteration, instead of pushing onto the template's `methods[]`
    /// (which would leak across all instantiations).
    find_spec_inline_method(mut &this, target_type: TypeRef, method_name: SymbolStr,
                             out_owner_ast: ASTNode**) -> MethodNode* {
        // Borrow target: the method arrays below belong to AST decl nodes;
        // aliasing them into an owning local would free the node's buffer.
        const empty_methods: MethodNode*[] = [];
        for (mut i: i64 = 0; i < this.spec_entries.length; i++) {
            const entry: SpecializationEntry* = &this.spec_entries[i];
            if (entry.specialized_type.id != target_type.id) { continue; }
            if (entry.ast_node == null) { continue; }
            mut owner_methods: &MethodNode*[] = &empty_methods;
            if (entry.ast_node.kind == NodeKind::StructDeclaration) {
                const sn: StructDeclNode* = entry.ast_node as StructDeclNode*;
                owner_methods = &sn.methods;
            } else if (entry.ast_node.kind == NodeKind::ClassDeclaration) {
                const cn: ClassDeclNode* = entry.ast_node as ClassDeclNode*;
                owner_methods = &cn.methods;
            } else {
                continue;
            }
            for (mut k: i64 = 0; k < owner_methods.length; k++) {
                const m: MethodNode* = owner_methods[k];
                if (m == null || m.func == null) { continue; }
                if (!m.func.name.equals(method_name)) { continue; }
                if (m.func.generic_params.length == 0) { continue; }
                *out_owner_ast = entry.ast_node;
                return m;
            }
        }

        // No spec entry yet for this receiver.  Two-step recovery:
        // (1) enqueue the receiver so the next mono iteration creates the
        // spec entry; (2) return the template's method node so the caller
        // can specialize it against the explicit/inferred type args.  The
        // caller is responsible for routing the spec'd MethodNode to the
        // RECEIVER'S spec entry once one exists, not onto the template's
        // own `methods[]`, which would leak across every instantiation.
        if (this.generic_registry == null) { return null; }
        const recv_t: Type* = this.arena.lookup(target_type.id);
        if (recv_t == null || recv_t.kind != TypeKind::InstantiatedType) {
            return null;
        }
        this.enqueue_from_type_ref(target_type);
        const inst: InstantiatedType* = recv_t as InstantiatedType*;
        const tmpl: TemplateEntry* =
            this.generic_registry.get_template_by_type_id(inst.generic_base.id);
        if (tmpl == null || tmpl.ast_node == null) { return null; }
        mut tmpl_methods: &MethodNode*[] = &empty_methods;
        if (tmpl.ast_node.kind == NodeKind::StructDeclaration) {
            const sn: StructDeclNode* = tmpl.ast_node as StructDeclNode*;
            tmpl_methods = &sn.methods;
        } else if (tmpl.ast_node.kind == NodeKind::ClassDeclaration) {
            const cn: ClassDeclNode* = tmpl.ast_node as ClassDeclNode*;
            tmpl_methods = &cn.methods;
        } else {
            return null;
        }
        for (mut k: i64 = 0; k < tmpl_methods.length; k++) {
            const m: MethodNode* = tmpl_methods[k];
            if (m == null || m.func == null) { continue; }
            if (!m.func.name.equals(method_name)) { continue; }
            if (m.func.generic_params.length == 0) { continue; }
            // Caller distinguishes the template-found case from the
            // spec'd-found case by `*out_owner_ast == tmpl.ast_node`.
            *out_owner_ast = tmpl.ast_node;
            return m;
        }
        return null;
    }

    find_spec_impl_method(&this, target_type: TypeRef, method_name: SymbolStr,
                          preferred_trait: SymbolStr,
                          out_impl: ImplBlockNode**) -> MethodNode* {
        // Bound-directed dispatch: when two traits declare a same-named
        // method for this type (e.g. Display::fmt and Debug::fmt on
        // String<A>), the call site records the intended trait in
        // `preferred_trait`.  Prefer the impl of that trait; otherwise keep
        // the historical first-match behavior.
        mut first_m: MethodNode* = null;
        mut first_impl: ImplBlockNode* = null;
        for (mut i: i64 = 0; i < this.spec_entries.length; i++) {
            const entry: SpecializationEntry* = &this.spec_entries[i];
            if (entry.specialized_type.id != target_type.id) { continue; }
            for (mut j: i64 = 0; j < entry.impl_nodes.length; j++) {
                const impl_node: ImplBlockNode* = entry.impl_nodes[j] as ImplBlockNode*;
                if (impl_node == null) { continue; }
                for (mut k: i64 = 0; k < impl_node.methods.length; k++) {
                    const m: MethodNode* = impl_node.methods[k];
                    if (m == null || m.func == null) { continue; }
                    if (!m.func.name.equals(method_name)) { continue; }
                    if (m.func.generic_params.length == 0) { continue; }
                    if (preferred_trait.is_valid() && impl_node.is_trait_impl()) {
                        const tl: SymbolStr =
                            this.trait_leaf_of_ann(impl_node.trait_annotation);
                        if (tl.is_valid() && tl.equals(preferred_trait)) {
                            *out_impl = impl_node;
                            return m;
                        }
                    }
                    if (first_m == null) { first_m = m; first_impl = impl_node; }
                }
            }
        }
        if (first_m != null) { *out_impl = first_impl; }
        return first_m;
    }

    /// Walk the methods[] of a non-generic struct/class whose AST was
    /// registered in `inherent_owner_index` during TemplateRegistration.
    /// Used for receivers like `Request` / `Response` whose generic
    /// methods (`parse<R>`, `write_to<W>`) live inline on the type; the
    /// type itself is never monomorphized so `find_spec_impl_method`
    /// doesn't see it, and there's no `implement Foo` block so
    /// `find_trait_impl_method_for_target` doesn't either.
    ///
    /// Returns the matching MethodNode and writes the owner ASTNode
    /// through `out_owner_ast` so the caller can push the spec'd
    /// sibling onto the right `methods[]` array.  Non-generic methods
    /// skip; they don't need monomorphization.
    find_inherent_method(&this, recv_type: TypeRef, method_name: SymbolStr,
                          out_owner_ast: ASTNode**) -> MethodNode* {
        if (!recv_type.is_valid()) { return null; }
        const registry: GenericRegistry* = this.generic_registry;
        if (registry == null) { return null; }
        // Try the receiver's qualified name first (the form
        // TemplateRegistration uses), then fall back to the bare name
        // (mirrors `register_inherent_owner`, which double-registers
        // when the qualified and bare names differ, e.g. for primitive
        // owners in namespaced modules).
        mut owner_ast: ASTNode* = null;
        const qname: SymbolStr = this.arena.get_qualified_name(recv_type);
        if (qname.is_valid()) {
            owner_ast = registry.lookup_inherent_owner(qname);
        }
        if (owner_ast == null) {
            const bare: SymbolStr = this.bare_name_of(recv_type);
            if (bare.is_valid()) {
                owner_ast = registry.lookup_inherent_owner(bare);
            }
        }
        if (owner_ast == null) { return null; }

        const empty_methods: MethodNode*[] = [];
        mut owner_methods: &MethodNode*[] = &empty_methods;
        if (owner_ast.kind == NodeKind::StructDeclaration) {
            const sn: StructDeclNode* = owner_ast as StructDeclNode*;
            owner_methods = &sn.methods;
        } else if (owner_ast.kind == NodeKind::ClassDeclaration) {
            const cn: ClassDeclNode* = owner_ast as ClassDeclNode*;
            owner_methods = &cn.methods;
        } else {
            return null;
        }
        for (mut k: i64 = 0; k < owner_methods.length; k++) {
            const m: MethodNode* = owner_methods[k];
            if (m == null || m.func == null) { continue; }
            if (!m.func.name.equals(method_name)) { continue; }
            if (m.func.generic_params.length == 0) { continue; }
            *out_owner_ast = owner_ast;
            return m;
        }
        return null;
    }

    /// Walk the trait-impl registry for any impl block whose `target_type`
    /// equals `bare_target_name` and that has a generic method with the
    /// given name.  Used for primitive receivers (`i32`, `string`, ...):
    /// `find_spec_impl_method` only sees impls attached to spec_entries,
    /// which only tracks instantiations of generic types.  Trait impls on
    /// primitives go straight to `trait_impl_blocks` keyed by
    /// (trait_name, target_name) and never appear in spec_entries.
    /// First matching impl wins; non-generic methods skip (handled by
    /// codegen's direct-call path, not inference).
    find_trait_impl_method_for_target(&this, bare_target_name: SymbolStr,
                                      method_name: SymbolStr,
                                      preferred_trait: SymbolStr,
                                      out_impl: ImplBlockNode**) -> MethodNode* {
        if (!bare_target_name.is_valid()) { return null; }
        const registry: GenericRegistry* = this.generic_registry;
        if (registry == null) { return null; }
        // Bound-directed dispatch: prefer the impl of `preferred_trait` when
        // the call site disambiguated a same-named method across two traits
        // (e.g. Debug vs Display `fmt`); otherwise keep first-match.
        mut first_m: MethodNode* = null;
        mut first_impl: ImplBlockNode* = null;
        for (mut i: i64 = 0; i < registry.trait_impls.length; i++) {
            const impl_node: ImplBlockNode* = registry.trait_impls[i].second;
            if (impl_node == null) { continue; }
            if (!impl_node.target_type.equals(bare_target_name)) { continue; }
            for (mut k: i64 = 0; k < impl_node.methods.length; k++) {
                const m: MethodNode* = impl_node.methods[k];
                if (m == null || m.func == null) { continue; }
                if (!m.func.name.equals(method_name)) { continue; }
                if (m.func.generic_params.length == 0) { continue; }
                if (preferred_trait.is_valid() && impl_node.is_trait_impl()) {
                    const tl: SymbolStr =
                        this.trait_leaf_of_ann(impl_node.trait_annotation);
                    if (tl.is_valid() && tl.equals(preferred_trait)) {
                        *out_impl = impl_node;
                        return m;
                    }
                }
                if (first_m == null) { first_m = m; first_impl = impl_node; }
            }
        }
        if (first_m != null) { *out_impl = first_impl; }
        return first_m;
    }

    /// Attempt formal<->actual unification on a CallExprNode whose callee
    /// is a MemberAccess on a generic-method receiver.  Pattern:
    /// `key.hash(&hasher)` inside a spec'd body where `key: &String<GA>`
    /// and the Hash impl's hash method is `hash<H> where H: Hasher`.
    /// On success: clones+substitutes the method body for the inferred
    /// H, adds the spec'd MethodNode to the impl block, and pins
    /// `call.resolved_method`.  Codegen Strategy 0 then computes the
    /// fully-mangled call-target symbol from the method's now-concrete
    /// param types, and the impl-block injection pass declares it.
    /// Find a self-returning trait default (combinator) named `method_name`
    /// on `recv_type`'s impl, regardless of its own-generic count.  Searches
    /// the receiver's specialized impl blocks first, then the bare-name
    /// trait-impl registry (non-generic receivers).  Writes the owning impl
    /// through `out_impl`.
    find_self_returning_default(&this, recv_type: TypeRef,
                                method_name: SymbolStr,
                                out_impl: ImplBlockNode**) -> MethodNode* {
        for (mut i: i64 = 0; i < this.spec_entries.length; i++) {
            const entry: SpecializationEntry* = &this.spec_entries[i];
            if (entry.specialized_type.id != recv_type.id) { continue; }
            for (mut j: i64 = 0; j < entry.impl_nodes.length; j++) {
                const impl_node: ImplBlockNode* = entry.impl_nodes[j] as ImplBlockNode*;
                if (impl_node == null) { continue; }
                for (mut k: i64 = 0; k < impl_node.methods.length; k++) {
                    const m: MethodNode* = impl_node.methods[k];
                    if (m == null || m.func == null) { continue; }
                    if (!m.func.name.equals(method_name)) { continue; }
                    if (!m.func.is_self_returning_default) { continue; }
                    *out_impl = impl_node;
                    return m;
                }
            }
        }
        if (this.generic_registry == null) { return null; }
        const bare: SymbolStr = this.bare_name_of(recv_type);
        if (!bare.is_valid()) { return null; }
        for (mut i: i64 = 0; i < this.generic_registry.trait_impls.length; i++) {
            const impl_node: ImplBlockNode* = this.generic_registry.trait_impls[i].second;
            if (impl_node == null) { continue; }
            if (!impl_node.target_type.equals(bare)) { continue; }
            for (mut k: i64 = 0; k < impl_node.methods.length; k++) {
                const m: MethodNode* = impl_node.methods[k];
                if (m == null || m.func == null) { continue; }
                if (!m.func.name.equals(method_name)) { continue; }
                if (!m.func.is_self_returning_default) { continue; }
                *out_impl = impl_node;
                return m;
            }
        }
        return null;
    }

    /// Lazily instantiate a zero-own-generic self-returning trait default
    /// (e.g. `take`/`filter`) at a call site, for the concrete receiver.
    /// These are skipped by eager `resolve_methods` (they would self-apply
    /// forever); here we clone + resolve the one actually called, push the
    /// concrete sibling onto the receiver's impl, register it, and walk its
    /// body so its own nested calls (`TakeIter::new`, the returned adapter)
    /// get monomorphized.  Returns true when handled; false (so the caller
    /// continues to the generic-inference path) for own-generic defaults
    /// like `map<B>`, which retain their generic and infer it from args.
    try_instantiate_self_returning_default(mut &this, call: CallExprNode*,
                                           ma: MemberAccessNode*,
                                           recv_type_in: TypeRef) -> boolean {
        mut recv_type: TypeRef = recv_type_in;
        mut impl_node: ImplBlockNode* = null;
        mut orig: MethodNode* = this.find_self_returning_default(
            recv_type, ma.member, &impl_node);
        if (orig == null || orig.func == null || impl_node == null) { return false; }
        // Own-generic combinators (`map<B>`) keep their generic; the
        // inference path handles them.
        if (orig.func.generic_params.length > 0) { return false; }
        // Confirmed: a zero-own-generic self-returning combinator.  If the
        // receiver is an instantiation that hasn't been monomorphized yet (a
        // call-expression receiver such as `Range<i32>::new(..)`, produced
        // during this very inference walk), specialize it now so we resolve
        // `TakeIter<This>` against a concrete struct - an unresolved receiver
        // yields an invalid return type and crashes the mangler.  Gated behind
        // the combinator check so ordinary method calls (e.g. `clone`) keep
        // their existing specialization timing untouched.
        const resolved_recv: TypeRef = this.ensure_receiver_inst_resolved(recv_type);
        if (!resolved_recv.equals(recv_type)) {
            recv_type = resolved_recv;
            // Re-find against the now-concrete receiver so the spec method
            // lands on the receiver spec's own impl block, not the template's.
            impl_node = null;
            orig = this.find_self_returning_default(recv_type, ma.member, &impl_node);
            if (orig == null || orig.func == null || impl_node == null) { return false; }
            if (orig.func.generic_params.length > 0) { return false; }
        }
        // Reuse an already-instantiated sibling (a prior call on the same
        // concrete receiver type) rather than minting a duplicate symbol.
        for (mut k: i64 = 0; k < impl_node.methods.length; k++) {
            const m: MethodNode* = impl_node.methods[k];
            if (m == null || m.func == null) { continue; }
            if (m == orig) { continue; }
            if (m.func.name.equals(ma.member)
                    && !m.func.is_self_returning_default
                    && m.func.generic_params.length == 0) {
                call.set_resolved_method(m as ASTNode*);
                return true;
            }
        }
        mut empty_names: SymbolStr[] = [];
        mut empty_args: TypeRef[] = [];
        const spec_method: MethodNode* = this.specialize_method(
            orig, empty_names, empty_args, recv_type, impl_node);
        if (spec_method == null || spec_method.func == null) { return false; }
        // The clone is concrete now, not a deferred template.
        spec_method.func.set_self_returning_default(false);
        impl_node.methods.push(spec_method);
        call.set_resolved_method(spec_method as ASTNode*);
        this.register_spec_method_in_di(spec_method, recv_type, impl_node);
        // Walk the spec'd body so the returned adapter and `Adapter::new`
        // get monomorphized.  The adapter's own self-returning defaults stay
        // skipped, so this terminates.
        if (spec_method.func.body != null) {
            mut spec_local_names: SymbolStr[] = [];
            mut spec_local_types: TypeRef[] = [];
            if (recv_type.is_valid()) {
                spec_local_names.push(this.intern_table.intern("this"));
                spec_local_types.push(recv_type);
            }
            for (mut pi: i64 = 0; pi < spec_method.func.parameters.length; pi++) {
                const p: VarDeclNode* = spec_method.func.parameters[pi];
                if (p == null || !p.resolved_type.is_valid()) { continue; }
                spec_local_names.push(p.name);
                spec_local_types.push(p.resolved_type);
            }
            this.collect_locals_in_block(spec_method.func.body,
                                         &spec_local_names, &spec_local_types);
            mut spec_ctx: ResolutionContext = ResolutionContext::new("", "");
            this.discover_inferred_calls_in_block(spec_method.func.body,
                &spec_ctx, null, spec_local_names, spec_local_types);
        }
        return true;
    }

    /// Resolve a static call's scope name (`T` in `T::new()`) to its
    /// registered type, tolerating a relative module path (`thread::Builder`
    /// for the registered `std::thread::Builder`). Monomorphization runs
    /// before sema, so the import-expanded name isn't on the node; recover
    /// it by trying the name as written, its bare->qualified mapping, and
    /// finally the leaf segment's mapping. The leaf fallback is skipped when
    /// the leaf is ambiguous across modules (so it can't silently bind the
    /// wrong same-leaf type).
    resolve_scope_type(&this, scope_name: SymbolStr) -> TypeRef {
        if (this.decl_index == null) { return TypeRef::invalid(); }
        mut t: TypeRef = this.decl_index.lookup_type(scope_name);
        if (t.is_valid()) { return t; }
        t = this.decl_index.lookup_type(this.decl_index.resolve_qualified(scope_name));
        if (t.is_valid()) { return t; }
        const s: string = this.intern_table.resolve(scope_name);
        const qn: QualifiedName = QualifiedName::parse(this.intern_table, s);
        const leaf: SymbolStr = qn.leaf();
        if (leaf.is_valid() && leaf.id != scope_name.id) {
            // Don't guess through an ambiguous leaf (two `Builder`s in
            // sibling modules); only resolve when it's unique.
            if (this.decl_index.lookup_qualified_alternatives(leaf).length <= 1) {
                t = this.decl_index.lookup_type(this.decl_index.resolve_qualified(leaf));
                if (t.is_valid()) { return t; }
                t = this.decl_index.lookup_type(leaf);
                if (t.is_valid()) { return t; }
            }
        }
        return TypeRef::invalid();
    }

    /// Best-effort receiver type for a generic method call whose receiver
    /// is a CALL EXPRESSION (a temporary) - the fluent-builder shape
    /// `T::new().cfg(..).generic_method<..>()`, including a chain of
    /// non-generic configuration methods. Resolves ONLY to a plain,
    /// NON-GENERIC concrete struct/class/enum: a generic static-call
    /// receiver (`Box::new(..)`, `Range<i32>::new(..)`) is deliberately
    /// left unresolved (its return is an `InstantiatedType` /
    /// unsubstituted `Box<T>`, which the kind gate below rejects), matching
    /// the exclusion in `resolve_arg_type_for_inference`. Used ONLY for the
    /// receiver of a generic method call (never for argument inference), so
    /// it cannot perturb generic-argument type inference.
    resolve_concrete_call_receiver_type(&this, expr: ExpressionNode*) -> TypeRef {
        if (expr == null || this.decl_index == null) { return TypeRef::invalid(); }
        const node: ASTNode* = expr as ASTNode*;
        if (node.kind != NodeKind::CallExpression) { return TypeRef::invalid(); }
        const ce: CallExprNode* = expr as CallExprNode*;
        if (ce.callee == null) { return TypeRef::invalid(); }
        const cnode: ASTNode* = ce.callee as ASTNode*;

        mut type_sym: SymbolStr = SymbolStr::empty();
        mut member:   SymbolStr = SymbolStr::empty();
        if (cnode.kind == NodeKind::ScopeResolution) {
            // Static call `T::member(..)`: the receiver type is `T` itself.
            const sr: ScopeResolutionNode* = ce.callee as ScopeResolutionNode*;
            const base: TypeRef = this.resolve_scope_type(sr.scope_name);
            if (!base.is_valid()) { return TypeRef::invalid(); }
            type_sym = this.decl_index.lookup_type_name(base);
            member   = sr.member_name;
        } else if (cnode.kind == NodeKind::MemberAccess) {
            // A configuration-method link `recv.member(..)`: resolve `recv`
            // (recursing through earlier chain links), then this member's
            // return type on it.
            const ma2: MemberAccessNode* = ce.callee as MemberAccessNode*;
            const recv_t: TypeRef = this.resolve_concrete_call_receiver_type(ma2.object);
            if (!recv_t.is_valid()) { return TypeRef::invalid(); }
            type_sym = this.decl_index.lookup_type_name(recv_t);
            member   = ma2.member;
        } else {
            return TypeRef::invalid();
        }

        if (!type_sym.is_valid()) { return TypeRef::invalid(); }
        const ret: TypeRef = this.decl_index.lookup_method_return(type_sym, member);
        if (!ret.is_valid() || !this.infer_type_is_concrete(ret)) {
            return TypeRef::invalid();
        }
        const rt: Type* = this.arena.lookup(ret.id);
        if (rt == null) { return TypeRef::invalid(); }
        if (rt.kind == TypeKind::Struct || rt.kind == TypeKind::Class
                || rt.kind == TypeKind::Enum) {
            return ret;
        }
        return TypeRef::invalid();
    }

    try_infer_method_call(mut &this, call: CallExprNode*,
                          subst: TypeSubstitution*,
                          names: &SymbolStr[], types: &TypeRef[]) -> void {
        if (call == null) { return; }
        if (call.resolved_method != null) { return; }
        if (call.callee == null) { return; }
        const callee_node: ASTNode* = call.callee as ASTNode*;
        if (callee_node.kind != NodeKind::MemberAccess) { return; }
        const ma: MemberAccessNode* = call.callee as MemberAccessNode*;

        // Recover the receiver's TypeRef from the param/local table; bail
        // when the receiver is anything but a name we can look up.
        mut recv_type: TypeRef = this.resolve_arg_type_for_inference(ma.object, names, types);
        // A static-call receiver (`Range<i32>::new(..).take(n)`) is left
        // unresolved by the general path (resolving it there perturbs ordinary
        // generic inference - see resolve_arg_type_for_inference).  Resolve it
        // here ONLY when the call is a self-returning combinator, so the
        // adapter has a concrete receiver to specialize against.
        if (!recv_type.is_valid() && ma.object != null) {
            const obj_node: ASTNode* = ma.object as ASTNode*;
            if (obj_node.kind == NodeKind::CallExpression) {
                const obj_call: CallExprNode* = ma.object as CallExprNode*;
                if (obj_call.callee != null &&
                    (obj_call.callee as ASTNode*).kind == NodeKind::ScopeResolution) {
                    const cand: TypeRef = this.resolve_static_call_return_type(obj_call);
                    if (cand.is_valid()) {
                        mut probe_impl: ImplBlockNode* = null;
                        const srd: MethodNode* = this.find_self_returning_default(
                            cand, ma.member, &probe_impl);
                        if (srd != null && srd.func != null &&
                            srd.func.generic_params.length == 0) {
                            recv_type = cand;
                        }
                    }
                }
            }
        }
        // Fluent-builder receiver: a call-expression temporary whose chain
        // returns a concrete, non-generic struct/class/enum
        // (`Builder::new().cfg(..).spawn<C,T>(..)`). The general path can't
        // type a call-expression receiver before sema runs; recover it from
        // the declared method-return types. Scoped to the receiver only, so
        // it can't perturb generic-argument inference.
        if (!recv_type.is_valid()) {
            recv_type = this.resolve_concrete_call_receiver_type(ma.object);
        }
        if (!recv_type.is_valid()) { return; }
        if (subst != null) {
            recv_type = subst.apply(recv_type, this.arena);
        }
        // An adapter receiver produced earlier in this same inference walk
        // (`r.map(f)` as the receiver of `.fold(..)`) may not be monomorphized
        // yet, so its spec'd impl - and the inherited default we're about to
        // specialize on it - doesn't exist in `spec_entries` until the
        // post-walk drain.  Force it now so `find_spec_impl_method` sees it.
        // No-op when the receiver is already resolved or isn't an instantiation.
        // An adapter receiver produced earlier in this same inference walk
        // (`r.map(f)` as the receiver of `.fold(..)`) may not be monomorphized
        // yet, so its spec'd impl - and the inherited default we're about to
        // specialize on it - doesn't exist in `spec_entries` until forced.
        // Force it now so `find_spec_impl_method` sees it.  No-op when the
        // receiver is already resolved or isn't an instantiation.
        recv_type = this.ensure_receiver_inst_resolved(recv_type);
        // Unwrap Reference/Pointer/InstantiatedType to land on a concrete
        // Struct/Class/Enum (which is what spec_entries.specialized_type
        // points at).
        mut t: Type* = this.arena.lookup(recv_type.id);
        mut depth: i32 = 0;
        while (t != null && depth < 8) {
            if (t.kind == TypeKind::Pointer) {
                const pt: PointerType* = t as PointerType*;
                recv_type = pt.pointee;
                t = this.arena.lookup(recv_type.id);
            } else if (t.kind == TypeKind::Reference) {
                const rt: ReferenceType* = t as ReferenceType*;
                recv_type = rt.referent;
                t = this.arena.lookup(recv_type.id);
            } else if (t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = t as InstantiatedType*;
                if (!inst.has_resolved_type()) { break; }
                recv_type = inst.resolved_type;
                t = this.arena.lookup(recv_type.id);
            } else {
                break;
            }
            depth += 1;
        }
        if (t == null) { return; }
        // Allowed receiver kinds:
        //   * Struct/Class/Enum: instance methods or trait impls on
        //     user-defined types; lookup via spec_entries.
        //   * Int/Float/Bool/Char/String: trait impls on primitives
        //     (e.g. `implement trait Hash for i32 { hash<H>(...) }`);
        //     lookup via trait_impl_blocks keyed by the bare type name,
        //     since primitives never go through monomorphization and
        //     have no spec_entries row.
        const tk: TypeKind = t.kind;
        const is_user_kind: boolean = tk == TypeKind::Struct
                                   || tk == TypeKind::Class
                                   || tk == TypeKind::Enum;
        const is_primitive_kind: boolean = tk == TypeKind::Int
                                        || tk == TypeKind::Float
                                        || tk == TypeKind::Bool
                                        || tk == TypeKind::Char
                                        || tk == TypeKind::String;
        // An InstantiatedType whose concrete struct hasn't been resolved yet
        // is also acceptable; `find_spec_inline_method`'s template-fallback
        // path handles these directly via `generic_base`.
        const is_unresolved_inst: boolean = tk == TypeKind::InstantiatedType;
        if (!is_user_kind && !is_primitive_kind && !is_unresolved_inst) { return; }

        // Self-returning trait defaults (combinators returning an adapter
        // over `This`) are skipped by eager `resolve_methods`; instantiate
        // the one being called here, for this concrete receiver.  The
        // zero-own-generic ones (`take`/`filter`/...) are fully handled in
        // the helper; own-generic ones (`map<B>`) return false and fall
        // through to the generic-inference path below.
        if (this.try_instantiate_self_returning_default(call, ma, recv_type)) {
            return;
        }

        // Find the impl method.  Three lookup paths:
        //   1. spec_entries: generic types whose spec'd impl blocks
        //      carry the method (e.g. `String<GA>::hash<H>`).
        //   2. trait_impl_blocks: primitive receivers whose trait impls
        //      live keyed by bare type name (`i32::hash<H>`).
        //   3. inherent_owner_index: generic INSTANCE methods declared
        //      inline on a non-generic struct/class (e.g.
        //      `Response::write_to<W>`).  The owner has no spec_entries
        //      row (it's never monomorphized) and no trait-impl key, so
        //      the first two paths miss; this path uses the qualified
        //      name registered in TemplateRegistration to recover the
        //      StructDecl/ClassDecl AST.  No impl block exists for these
        //      methods; the spec'd sibling gets pushed onto the owner's
        //      own `methods[]` array instead, and codegen's
        //      `declare_struct_methods` / `declare_class_methods` walks
        //      that array directly.
        mut impl_node: ImplBlockNode* = null;
        mut inherent_owner_ast: ASTNode* = null;
        mut orig_method: MethodNode* = null;
        if (is_user_kind || is_unresolved_inst) {
            orig_method = this.find_spec_impl_method(recv_type, ma.member, ma.resolved_trait, &impl_node);
            if (orig_method == null) {
                orig_method = this.find_inherent_method(
                    recv_type, ma.member, &inherent_owner_ast);
            }
            if (orig_method == null) {
                // Third path: a generic struct/class with an INLINE generic
                // method (e.g. `NonNull<T>::cast<U>`).  The owner is itself
                // generic, so it isn't in `inherent_owner_index`; the method
                // isn't in an impl block, so `find_spec_impl_method` misses
                // it.  But the spec'd type's own `ast_node` carries cloned
                // copies of every inline method; search there, and fall
                // back to the template's own AST when the receiver wasn't
                // monomorphized directly.
                orig_method = this.find_spec_inline_method(
                    recv_type, ma.member, &inherent_owner_ast);
            }
            if (orig_method == null) {
                // Fourth path: a SYNTHESIZED default trait method (e.g.
                // `Wrapper::wrap<B>`) on a trait impl for a NON-generic user
                // struct/class.  The owner has no spec entry and the method
                // isn't inline on the type, so the three paths above miss;
                // the clone lives on the trait impl block keyed by the bare
                // target name, exactly like the primitive-receiver case
                // below.  Also matches HAND-WRITTEN generic trait methods
                // (e.g. a user `Display`'s `fmt<W>`, or `Str::fmt<W>`): these
                // do NOT specialize through any other route - without this
                // they reach codegen as an unsubstituted `Formatter<W>`
                // symbol (E0636).  Gated to generic methods (`is_generic()`):
                // a non-generic trait method hits `n_method_params == 0` and
                // returns below; a generic method whose param can't be bound
                // is rejected by the inference early-returns (no bogus
                // still-generic spec is minted).  The spec'd signature is
                // fully substituted by the post-resolution subst sweep in
                // `specialize_method`, which closes the nested-`W` gap that
                // the AST annotation substituter leaves open.
                const bare: SymbolStr = this.bare_name_of(recv_type);
                mut cand_impl: ImplBlockNode* = null;
                const cand: MethodNode* = this.find_trait_impl_method_for_target(
                    bare, ma.member, ma.resolved_trait, &cand_impl);
                if (cand != null && cand.func != null
                        && (cand.func.is_synth_default || cand.func.is_generic())) {
                    orig_method = cand;
                    impl_node = cand_impl;
                }
            }
        } else {
            const bare: SymbolStr = this.bare_name_of(recv_type);
            orig_method = this.find_trait_impl_method_for_target(
                bare, ma.member, ma.resolved_trait, &impl_node);
        }
        if (orig_method == null) { return; }
        if (impl_node == null && inherent_owner_ast == null) { return; }
        const orig_func: FunctionDeclNode* = orig_method.func;
        if (orig_func == null) { return; }

        // Identify the method's *own* generic params (e.g. `<H>` on
        // `hash<H>`).  Build TypeRefs for them via create_generic_param
        // so the unifier can match against them.  These are different
        // from the impl block's outer generics, which were already
        // substituted when the impl was specialized.
        const n_method_params: i64 = orig_func.generic_params.length;
        if (n_method_params == 0) { return; }
        this.inference_bindings = [];
        this.inference_param_ids = [];
        mut method_param_names: SymbolStr[] = [];
        for (mut i: i64 = 0; i < n_method_params; i++) {
            const gp: GenericParamNode* = orig_func.generic_params[i];
            if (gp == null) { return; }
            const gp_ref: TypeRef = this.arena.create_generic_param(gp.name, i as u64);
            this.inference_bindings.push(TypeRef::invalid());
            this.inference_param_ids.push(gp_ref.id);
            method_param_names.push(gp.name);
        }

        // Build the explicit-parameter list (skip `&this`/`this`) so we
        // can pair them against `call.arguments` 1:1.  The receiver isn't
        // an explicit arg at the call site; codegen prepends it later.
        const this_amp: SymbolStr = this.intern_table.intern("&this");
        const this_val: SymbolStr = this.intern_table.intern("this");
        mut explicit_params: VarDeclNode*[] = [];
        for (mut i: i64 = 0; i < orig_func.parameters.length; i++) {
            const p: VarDeclNode* = orig_func.parameters[i];
            if (p == null) { continue; }
            if (p.name.equals(this_amp) || p.name.equals(this_val)) { continue; }
            explicit_params.push(p);
        }
        if (explicit_params.length != call.arguments.length) { return; }

        // Build a resolution context that binds the method's own generic
        // params to their TypeRefs.  Used to fill `resolved_type` on the
        // template method's params on demand; sema skips generic-method
        // bodies, so `resolve_methods` left them invalid.
        mut method_ctx: ResolutionContext = ResolutionContext::new("", "");
        for (mut i: i64 = 0; i < n_method_params; i++) {
            method_ctx.add_binding(method_param_names[i],
                TypeRef::new(this.inference_param_ids[i], this.arena));
        }
        if (recv_type.is_valid()) {
            method_ctx.set_this_type(recv_type);
        }
        // Seed the concrete trait-element bindings cached at impl-spec time
        // (e.g. `A -> i32` for a `TakeIter` receiver, whose element lives only
        // in the where-bound).  An own-generic combinator default cloned into
        // such an impl (`map<B>`, returning `MapIter<This, A, B>` with formal
        // `f: (A) -> B`) must resolve `A` here so the formal/actual unification
        // below can bind the method generic `B`; without it the formal's `A`
        // stays unresolved, unification fails, and the spec is never minted.
        if (impl_node != null) {
            for (mut di: i64 = 0; di < impl_node.derived_param_names.length; di++) {
                method_ctx.add_binding(impl_node.derived_param_names[di],
                                       impl_node.derived_param_types[di]);
            }
        }

        // Two paths to populate `inference_bindings`:
        //   - Explicit method-level generic args at the call site
        //     (`obj.method<U>(...)`): resolve them in `method_ctx` and bind
        //     directly.  Skips unification entirely; the args ARE the answer.
        //   - Inference from formal/actual arg unification: used when the
        //     user didn't write explicit args, so `U` has to fall out of the
        //     pairing between each formal type and the call's actual.
        if (call.generic_args.length > 0
                && call.generic_args.length == n_method_params
                && this.type_resolver != null) {
            mut all_resolved: boolean = true;
            for (mut i: i64 = 0; i < n_method_params; i++) {
                const arg_ref: TypeRef = this.type_resolver.resolve(
                    call.generic_args[i], &method_ctx);
                if (!arg_ref.is_valid()) {
                    all_resolved = false;
                    break;
                }
                this.inference_bindings[i] = arg_ref;
            }
            if (!all_resolved) { return; }
        } else {
            // Unify each formal explicit param against the call's actual arg.
            mut ok: boolean = true;
            for (mut i: i64 = 0; i < call.arguments.length; i++) {
                const param: VarDeclNode* = explicit_params[i];
                if (param == null) { ok = false; break; }
                mut formal: TypeRef = param.resolved_type;
                if (!formal.is_valid() && param.type_annotation != null
                        && this.type_resolver != null) {
                    formal = this.type_resolver.resolve(param.type_annotation, &method_ctx);
                }
                if (!formal.is_valid()) { ok = false; break; }
                const arg: ExpressionNode* = call.arguments[i];
                mut actual: TypeRef = this.resolve_arg_type_for_inference(arg, names, types);
                if (!actual.is_valid()) { ok = false; break; }
                if (subst != null) {
                    actual = subst.apply(actual, this.arena);
                }
                if (!this.unify_for_inference(formal, actual)) {
                    ok = false;
                    break;
                }
            }
            if (!ok) { return; }

            // Return-type-driven inference for `![implicit]` methods: a
            // method-level generic still unbound after arg unification is
            // recovered by unifying the declared return type against the
            // call's expected type.  Needed for receiver-only reads like
            // `const v: T = args.next()` where the method takes no args and
            // `T` appears solely in the return position.  Resolve the return
            // annotation in `method_ctx` so its generic params carry the same
            // fresh ids as `inference_param_ids`.
            if (orig_func.is_implicit && this.current_expected_type.is_valid()) {
                mut ret_ty: TypeRef = TypeRef::invalid();
                if (orig_func.return_type_annotation != null
                        && this.type_resolver != null) {
                    ret_ty = this.type_resolver.resolve(
                        orig_func.return_type_annotation, &method_ctx);
                }
                if (!ret_ty.is_valid()) {
                    ret_ty = orig_func.resolved_return_type;
                }
                if (ret_ty.is_valid()) {
                    this.unify_for_inference(ret_ty, this.current_expected_type);
                }
            }

            mut m_all_bound: boolean = true;
            for (mut i: i64 = 0; i < this.inference_bindings.length; i++) {
                if (!this.inference_bindings[i].is_valid()) { m_all_bound = false; break; }
            }
            if (!m_all_bound) {
                if (orig_func.is_implicit && call.generic_args.length == 0) {
                    this.emit_cannot_infer(call, orig_func.name);
                }
                return;
            }
        }

        // Defer when a binding isn't concrete.  Inference can bind a method
        // generic to ANOTHER generic param when this call is walked inside a
        // still-generic context - e.g. `view.fmt(f)` inside the TEMPLATE body
        // of `String::Debug::fmt<W>` binds `Str::fmt`'s `W` to the enclosing
        // (still-generic) `W` rather than a concrete type.  `m_all_bound`
        // accepts it because a GenericParam is a valid TypeRef, but
        // specializing now would mint a bogus still-generic spec (`fmt` with
        // `Formatter<W>`) that reaches codegen as an unsubstituted symbol
        // (E0636).  Skip; the concrete spec is minted later when the
        // enclosing generic method is itself specialized with a concrete `W`
        // and its body re-walked.
        for (mut bi: i64 = 0; bi < this.inference_bindings.length; bi++) {
            if (this.type_contains_generic_param(this.inference_bindings[bi])) {
                return;
            }
        }

        // Inferred all method-level params.  Specialize the method by
        // cloning + substituting so the owner ends up with a concrete
        // sibling alongside the still-generic original.  Spec'd siblings
        // get emitted by codegen because `declare_method` skips
        // `generic_params.length > 0`; the spec'd clone is non-generic.
        const spec_method: MethodNode* = this.specialize_method(
            orig_method, method_param_names, this.inference_bindings, recv_type,
            impl_node);
        if (spec_method == null) { return; }
        // The clone is a concrete specialization, not a deferred template - even
        // when the original was a self-returning combinator default (`map<B>`).
        // Clearing the flag (mirroring `try_instantiate_self_returning_default`)
        // makes sema treat the spec's resolved return type as load-bearing
        // instead of skipping it as a template, so a chained consumer
        // (`r.map(f).count()`) sees the concrete adapter type.
        spec_method.func.set_self_returning_default(false);
        if (inherent_owner_ast != null) {
            // Push onto the inherent owner's own methods[] array so
            // `declare_struct_methods` / `declare_class_methods` picks
            // it up when codegen walks the (non-generic) owner.
            //
            // When `find_spec_inline_method` fell back to the receiver's
            // template AST (because no spec entry existed for the
            // receiver yet), routing the spec'd MethodNode there would
            // leak it into every other instantiation that shares the
            // template.  Detect that case and prefer the receiver's spec
            // entry instead; `find_spec_inline_method` enqueued the
            // receiver, and the spec entry exists by the time mono is
            // emitting code.  If it still doesn't exist (e.g. enqueue
            // happened too late in the pass), fall back to the template
            // path; codegen's spec-lookup wins by symbol name.
            mut target_ast: ASTNode* = inherent_owner_ast;
            mut from_template: boolean = false;
            if (this.generic_registry != null) {
                const recv_t: Type* = this.arena.lookup(recv_type.id);
                if (recv_t != null && recv_t.kind == TypeKind::InstantiatedType) {
                    const inst_recv: InstantiatedType* = recv_t as InstantiatedType*;
                    const tmpl_recv: TemplateEntry* =
                        this.generic_registry.get_template_by_type_id(
                            inst_recv.generic_base.id);
                    if (tmpl_recv != null && tmpl_recv.ast_node == inherent_owner_ast) {
                        from_template = true;
                    }
                }
            }
            if (from_template) {
                // Look for a spec entry whose specialized_type matches recv.
                for (mut si: i64 = 0; si < this.spec_entries.length; si++) {
                    const e: SpecializationEntry* = &this.spec_entries[si];
                    if (e.specialized_type.id == recv_type.id && e.ast_node != null) {
                        target_ast = e.ast_node;
                        break;
                    }
                }
            }
            if (target_ast.kind == NodeKind::StructDeclaration) {
                const sn: StructDeclNode* = target_ast as StructDeclNode*;
                sn.methods.push(spec_method);
            } else if (target_ast.kind == NodeKind::ClassDeclaration) {
                const cn: ClassDeclNode* = target_ast as ClassDeclNode*;
                cn.methods.push(spec_method);
            }
        } else {
            impl_node.methods.push(spec_method);
        }
        call.set_resolved_method(spec_method as ASTNode*);
        // Register the spec in DI under the receiver type's canonical name so
        // cross-module call sites (and in-module declare_extern fallback) find
        // the right func_type/mangled-name pair.  Without this, the only DI
        // entry for `Type::method` is the (now-skipped) generic template's
        // sema-time registration, which has GenericParam(H) baked into its
        // param types and produces a `1H`-placeholder mangle.
        if (inherent_owner_ast != null) {
            this.register_spec_method_in_di_inherent(
                spec_method, recv_type, inherent_owner_ast);
            // Pin the precise mangled symbol so codegen targets THIS spec
            // rather than colliding with a sibling spec under the shared
            // `<receiver>::<method>` + arity key (see
            // mangled_symbol_for_spec_method).  Scoped to INHERENT generic
            // methods on a fixed receiver type (`Request::write_to<TcpStream>`
            // vs `<TlsStream>`, `Inner::relay<A>` vs `<B>`): there the spec's
            // DI-registered mangle equals the symbol codegen's `declare_method`
            // emits, so the pin resolves directly.  Trait-impl / combinator
            // defaults (the `else` branch) are deliberately left unpinned:
            // their DI mangle can diverge from the emitted definition symbol,
            // so pinning would declare an extern that never links; those keep
            // relying on codegen's overload-aware fallback.
            const spec_callee: SymbolStr = this.mangled_symbol_for_spec_method(
                spec_method, this.arena.get_qualified_name(recv_type));
            if (spec_callee.is_valid()) {
                call.set_resolved_callee(spec_callee);
            }
        } else {
            this.register_spec_method_in_di(spec_method, recv_type, impl_node);
        }

        // Re-walk the spec'd method body for inferred-arg generic free-fn
        // calls.  Without this, transitive calls like `hash_u64_le(hasher,
        // this as u64)` inside `i32::hash<DefaultHasher>` stay un-spec'd:
        // resolve_methods only walks the impl block once at populate time,
        // and the spec'd sibling is added after that pass.  The body has
        // already been substituted by specialize_method, so subst=null.
        if (spec_method.func != null && spec_method.func.body != null) {
            mut spec_local_names: SymbolStr[] = [];
            mut spec_local_types: TypeRef[] = [];
            if (recv_type.is_valid()) {
                spec_local_names.push(this.intern_table.intern("this"));
                spec_local_types.push(recv_type);
            }
            for (mut pi: i64 = 0; pi < spec_method.func.parameters.length; pi++) {
                const p: VarDeclNode* = spec_method.func.parameters[pi];
                if (p == null || !p.resolved_type.is_valid()) { continue; }
                spec_local_names.push(p.name);
                spec_local_types.push(p.resolved_type);
            }
            this.collect_locals_in_block(spec_method.func.body,
                                         &spec_local_names, &spec_local_types);
            mut spec_ctx: ResolutionContext = ResolutionContext::new("", "");
            this.discover_inferred_calls_in_block(spec_method.func.body,
                &spec_ctx, null, spec_local_names, spec_local_types);
        }
    }

    /// Clone a generic method's func, run ASTTypeSubstituter to replace
    /// its generic params with `args`, clear `generic_params`, and
    /// re-resolve type annotations against the impl's owner type so
    /// `&this` / param annotations resolve to concrete TypeRefs.  Returns
    /// the spec'd MethodNode, or null on failure.  No-op when the method
    /// is non-generic; caller should filter those out.
    ///
    /// `owner_impl` (null for inherent owners) supplies the concrete
    /// trait-element bindings cached at impl-spec time
    /// (`cache_derived_trait_params`).  They seed the signature-resolution
    /// context so a self-returning default cloned into a where-clause-element
    /// impl (`map`/`filter` on a `TakeIter`, whose element `A` lives only in the
    /// where-bound) resolves its element concretely instead of failing.
    specialize_method(mut &this, original: MethodNode*,
                       param_names: SymbolStr[], args: &TypeRef[],
                       owner_type: TypeRef, owner_impl: ImplBlockNode*) -> MethodNode* {
        if (original == null || original.func == null) { return null; }
        if (param_names.length != args.length) { return null; }

        // Build display SymbolStrs for the substituter.
        mut arg_displays: SymbolStr[] = [];
        for (mut i: i64 = 0; i < args.length; i++) {
            const arg_t: Type* = this.arena.lookup(args[i].id);
            mut display: string = "";
            if (arg_t != null) {
                const qname: SymbolStr = this.arena.get_qualified_name(args[i]);
                if (qname.is_valid()) {
                    display = this.intern_table.resolve(qname);
                } else {
                    display = this.arena.format_display(arg_t);
                }
            } else {
                display = format("unknown_%llu", args[i].id);
            }
            arg_displays.push(this.intern_table.intern(display));
        }

        // Build the substitution.  Param IDs come from
        // create_generic_param(name, index), the same recipe used to create
        // the IDs the unifier matched against above; arena-deduped so we
        // get the same TypeRefs back.
        mut param_ids: u64[] = [];
        for (mut i: i64 = 0; i < param_names.length; i++) {
            const gp_ref: TypeRef = this.arena.create_generic_param(param_names[i], i as u64);
            param_ids.push(gp_ref.id);
        }
        const subst_val: TypeSubstitution = TypeSubstitution::from_params(param_ids, args);
        const subst_ptr: TypeSubstitution* = malloc(sizeof(TypeSubstitution)) as TypeSubstitution*;
        *subst_ptr = subst_val;

        // Clone the method via the normal visitor path. `for_specialization`
        // is for type templates (renames the type itself); methods don't get
        // a renamed leaf, so a plain cloner is correct here.
        mut cloner: ASTCloner = ASTCloner();
        (original as ASTNode*).accept(cloner);
        mut spec_method: MethodNode* = cloner.result as MethodNode*;
        if (spec_method == null || spec_method.func == null) { return null; }
        const cloned_node: ASTNode* = spec_method as ASTNode*;
        // The cloner copies `generic_params` by ref; reset to empty so
        // sema/declare_method don't classify the spec as still generic.
        spec_method.func.generic_params = [];
        spec_method.func.set_resolved_return_type(TypeRef::invalid());
        for (mut i: i64 = 0; i < spec_method.func.parameters.length; i++) {
            const p: VarDeclNode* = spec_method.func.parameters[i];
            if (p != null) { p.set_resolved_type(TypeRef::invalid()); }
        }

        // Run the substituter; pass empty base/spec names since we're
        // not renaming a self-type, just substituting the method's own
        // generic params (e.g. H -> DefaultHasher).
        const empty_sym: SymbolStr = SymbolStr::empty();
        mut substituter: ASTTypeSubstituter* = new ASTTypeSubstituter(
            subst_ptr, this.arena, this.intern_table,
            empty_sym, empty_sym,
            param_names, arg_displays);
        cloned_node.accept(substituter);

        // Re-resolve types on the spec'd method's signature.  Bind
        // `&this` to the impl's owner type so the receiver's
        // resolved_type lands on the spec'd struct.
        if (this.type_resolver != null) {
            mut module_name: string = "";
            mut res_ctx: ResolutionContext = ResolutionContext::new(module_name, "");
            if (owner_type.is_valid()) {
                res_ctx.set_this_type(owner_type);
            }
            // Seed the concrete trait-element bindings cached at impl-spec time
            // (e.g. `A -> i32` for a `TakeIter` receiver) so a default's bare
            // element name resolves here.  No-op when the element is already a
            // struct param (the annotation carries the concrete type directly)
            // or for inherent owners (no impl).
            if (owner_impl != null) {
                for (mut di: i64 = 0; di < owner_impl.derived_param_names.length; di++) {
                    res_ctx.add_binding(owner_impl.derived_param_names[di],
                                        owner_impl.derived_param_types[di]);
                }
            }
            this.type_resolver.resolve_func_signature(spec_method.func, &res_ctx);
            // Back-fill `&this` / `this` param's resolved_type the same
            // way resolve_method_signatures does for inherent methods;
            // the parser leaves these implicit-typed.
            for (mut i: i64 = 0; i < spec_method.func.parameters.length; i++) {
                const p: VarDeclNode* = spec_method.func.parameters[i];
                if (p == null) { continue; }
                if (p.resolved_type.is_valid()) { continue; }
                const this_amp: SymbolStr = this.intern_table.intern("&this");
                const this_val: SymbolStr = this.intern_table.intern("this");
                if (p.name.equals(this_amp)) {
                    if (owner_type.is_valid()) {
                        p.set_resolved_type(this.arena.get_reference_to(
                            owner_type, RefMutability::Immutable));
                    }
                } else if (p.name.equals(this_val)) {
                    if (owner_type.is_valid()) {
                        p.set_resolved_type(owner_type);
                    }
                }
            }
        }
        // Fallback for a signature the annotation re-resolution couldn't fully
        // concretize.  An own-generic default inherited into a where-clause-
        // generic impl (`fold<Acc>` on `implement<I,A> Iterator<A> for
        // TakeIter<I> where I: Iterator<A>`) keeps the impl param `A` as a bare
        // `Named("A")` in its cloned annotation (`f: (Acc, A) -> Acc`); `A`
        // isn't a Self-type arg, so re-resolving the annotation in this context
        // leaves it unbound.  But `original` is the spec'd impl's copy, whose
        // *resolved* signature already had `A` bound to the concrete element
        // type during impl specialization.  So when re-resolution fails for a
        // slot, substitute the method's own generics onto `original`'s resolved
        // type for that slot - which carries the concrete `A` - instead.
        if (this.type_has_unresolved(spec_method.func.resolved_return_type, 0)
                && original.func.resolved_return_type.is_valid()) {
            const cand: TypeRef = subst_ptr.apply(
                original.func.resolved_return_type, this.arena);
            if (!this.type_has_unresolved(cand, 0)) {
                spec_method.func.set_resolved_return_type(cand);
            }
        }
        const n_clone_params: i64 = spec_method.func.parameters.length;
        const n_orig_params: i64 = original.func.parameters.length;
        if (n_clone_params == n_orig_params) {
            for (mut i: i64 = 0; i < n_clone_params; i++) {
                const p: VarDeclNode* = spec_method.func.parameters[i];
                const op: VarDeclNode* = original.func.parameters[i];
                if (p == null || op == null) { continue; }
                if (!this.type_has_unresolved(p.resolved_type, 0)) { continue; }
                if (!op.resolved_type.is_valid()) { continue; }
                const cand: TypeRef = subst_ptr.apply(op.resolved_type, this.arena);
                if (!this.type_has_unresolved(cand, 0)) {
                    p.set_resolved_type(cand);
                }
            }
        }

        // Substitution sweep over the resolved signature.  The AST
        // annotation substituter (ASTTypeSubstituter, above) does not reach
        // a method generic param NESTED inside an instantiated annotation
        // (e.g. the `W` in `f: mut &Formatter<W>`), so after
        // `resolve_func_signature` that slot resolves to
        // `Formatter<GenericParam(W)>` - a TypeRef that `type_has_unresolved`
        // treats as fully valid (a GenericParam is not "invalid"), so the
        // fallbacks above leave it untouched.  It then reaches codegen as
        // `Formatter<W>` and member calls on it (`f.write_str`) fail with
        // E0636.  Re-apply the method-generic substitution to every resolved
        // signature slot; `apply` recurses into Pointer/Reference/Array/
        // Optional/Function/Tuple/InstantiatedType, replacing `W` at any
        // depth.  It is a no-op for already-concrete slots (e.g. a top-level
        // `hasher: H` that the AST substituter already rewrote), so the
        // working cases are unaffected.
        if (spec_method.func.resolved_return_type.is_valid()) {
            spec_method.func.set_resolved_return_type(
                subst_ptr.apply(spec_method.func.resolved_return_type, this.arena));
        }
        for (mut i: i64 = 0; i < spec_method.func.parameters.length; i++) {
            const sp: VarDeclNode* = spec_method.func.parameters[i];
            if (sp != null && sp.resolved_type.is_valid()) {
                sp.set_resolved_type(subst_ptr.apply(sp.resolved_type, this.arena));
            }
        }

        // Refuse to hand back a spec whose signature didn't fully resolve.
        // The mangler treats an invalid TypeRef in a registered method as an
        // internal error and aborts.  Failing here instead leaves
        // `resolved_method` unset so the call surfaces a clean "method not
        // found"/type-mismatch diagnostic rather than crashing the compiler.
        if (this.type_has_unresolved(spec_method.func.resolved_return_type, 0)) {
            return null;
        }
        for (mut i: i64 = 0; i < spec_method.func.parameters.length; i++) {
            const p: VarDeclNode* = spec_method.func.parameters[i];
            if (p != null && this.type_has_unresolved(p.resolved_type, 0)) {
                return null;
            }
        }
        return spec_method;
    }

    /// True when `ty` is invalid or *contains* an invalid TypeRef at any depth
    /// (through Function params/return, Pointer, Reference, Array, Optional,
    /// Tuple, or InstantiatedType args).  A shallow `is_valid()` check misses
    /// an unbound element type buried in a function-typed parameter such as
    /// `(Acc, Item) -> Acc`, which the mangler would then abort on.
    type_has_unresolved(&this, ty: TypeRef, depth: i32) -> boolean {
        if (!ty.is_valid()) { return true; }
        if (depth > 16) { return false; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return true; }
        if (t.kind == TypeKind::Function) {
            const f: FunctionType* = t as FunctionType*;
            if (this.type_has_unresolved(f.return_type, depth + 1)) { return true; }
            for (mut i: i64 = 0; i < f.param_types.length; i++) {
                if (this.type_has_unresolved(f.param_types[i], depth + 1)) { return true; }
            }
            return false;
        }
        if (t.kind == TypeKind::Pointer) {
            return this.type_has_unresolved((t as PointerType*).pointee, depth + 1);
        }
        if (t.kind == TypeKind::Reference) {
            return this.type_has_unresolved((t as ReferenceType*).referent, depth + 1);
        }
        if (t.kind == TypeKind::Array) {
            return this.type_has_unresolved((t as ArrayType*).element, depth + 1);
        }
        if (t.kind == TypeKind::Optional) {
            return this.type_has_unresolved((t as OptionalType*).wrapped, depth + 1);
        }
        if (t.kind == TypeKind::Tuple) {
            const tup: TupleType* = t as TupleType*;
            for (mut i: i64 = 0; i < tup.elements.length; i++) {
                if (this.type_has_unresolved(tup.elements[i], depth + 1)) { return true; }
            }
            return false;
        }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                if (this.type_has_unresolved(inst.type_args[i], depth + 1)) { return true; }
            }
            return false;
        }
        return false;
    }

    /// Register a freshly created spec method in the DeclarationIndex.
    /// `register_methods_with_module_aliased` skips generic templates, so
    /// without this call the only DI entry for `Type::method` would be empty
    /// (template skipped); cross-module externs and primitive-impl in-module
    /// resolution would both fall back to the bare template's `1H`-placeholder
    /// mangle.  Derives the canonical owner name from `recv_type` so primitive
    /// impls register under their bare arena name (`i32`) and struct/class
    /// impls register under their qualified name.
    register_spec_method_in_di(mut &this, spec_method: MethodNode*,
                                recv_type: TypeRef,
                                impl_node: ImplBlockNode*) -> void {
        if (this.decl_index == null) { return; }
        if (spec_method == null || impl_node == null) { return; }

        // Match the qualification logic that TypeResolution uses for the
        // template's sema-time registration.  Without that match the spec
        // ends up keyed differently in DI than the template; the
        // declare_extern_function_overload lookup at cross-module call
        // sites only sees the template's overload entry (which has a
        // GenericParam-typed func_type that build_function_ltype rejects),
        // and falls back to the template's stale `1H`-placeholder mangle.
        mut qualified_target: SymbolStr = impl_node.qualified_target_name;
        if (!qualified_target.is_valid()) {
            qualified_target = impl_node.target_type;
        }
        // Bare alias: only when the qualified form differs from the
        // user-written target (mirrors register_methods_with_module_aliased
        // gating in TypeResolution).
        mut bare_alias: SymbolStr = SymbolStr::empty();
        if (!qualified_target.equals(impl_node.target_type)) {
            bare_alias = impl_node.target_type;
        }

        // Owning module for cross-module visibility tracking.
        mut owning_module: SymbolStr = SymbolStr::empty();
        if (impl_node.source_module != "") {
            owning_module = this.intern_table.intern(impl_node.source_module);
        } else {
            owning_module = this.current_module;
        }

        mut spec_methods: MethodNode*[] = [];
        spec_methods.push(spec_method);
        if (bare_alias.is_valid()) {
            this.decl_index.register_methods_with_module_aliased(
                qualified_target, bare_alias, spec_methods, owning_module,
                this.intern_table, this.arena);
        } else {
            this.decl_index.register_methods_with_module(
                qualified_target, spec_methods, owning_module,
                this.intern_table, this.arena);
        }
    }

    /// Register a freshly created spec method whose owner is a non-
    /// generic struct/class (no impl block).  Mirrors the impl-block
    /// path in `register_spec_method_in_di`, but pulls the
    /// qualified-target name from the receiver's arena qualified name
    /// and the source module from the owner AST's `source_module`.
    register_spec_method_in_di_inherent(mut &this, spec_method: MethodNode*,
                                          recv_type: TypeRef,
                                          owner_ast: ASTNode*) -> void {
        if (this.decl_index == null) { return; }
        if (spec_method == null || owner_ast == null) { return; }

        // Qualified target: the receiver's canonical arena name.  For
        // non-generic structs this matches the form TypeResolution uses
        // when registering inline methods, so the spec'd method lands
        // under the same key the template's overload entry occupies.
        mut qualified_target: SymbolStr = this.arena.get_qualified_name(recv_type);
        if (!qualified_target.is_valid()) { return; }

        // Source module: take it from the owner AST's source_module
        // field (set by SpecializationPasses::tag_decl_source_module
        // during TemplateRegistration).  Fall back to the current
        // mono module when the field is empty; this happens for the
        // inherent-method's *defining* module, which TemplateRegistration
        // already processed before the consuming module hits it here.
        mut source_module_str: string = "";
        if (owner_ast.kind == NodeKind::StructDeclaration) {
            const sn: StructDeclNode* = owner_ast as StructDeclNode*;
            source_module_str = sn.source_module;
        } else if (owner_ast.kind == NodeKind::ClassDeclaration) {
            const cn: ClassDeclNode* = owner_ast as ClassDeclNode*;
            source_module_str = cn.source_module;
        }
        mut owning_module: SymbolStr = SymbolStr::empty();
        if (source_module_str != "") {
            owning_module = this.intern_table.intern(source_module_str);
        } else {
            owning_module = this.current_module;
        }

        mut spec_methods: MethodNode*[] = [];
        spec_methods.push(spec_method);
        this.decl_index.register_methods_with_module(
            qualified_target, spec_methods, owning_module,
            this.intern_table, this.arena);
    }

    /// Compute the exact LLVM-mangled symbol a spec'd method will be emitted
    /// under, so the call site can pin `resolved_callee` straight to it.
    /// Mirrors the mangle in `DeclarationIndex::register_methods_with_module`
    /// and codegen's `declare_method` (all three must agree on the symbol).
    ///
    /// Without this, a generic INSTANCE method whose own generic varies while
    /// the RECEIVER type stays fixed (`Inner::relay<A>` vs `Inner::relay<B>`,
    /// or `Request::write_to<TcpStream>` vs `<TlsStream>`) mints distinct specs
    /// but leaves `resolved_callee` empty (the substituter cleared it).  Codegen
    /// then falls back to a `<receiver-type>::<method>` + arity lookup, which
    /// keys both specs identically and hands back whichever was registered last
    /// - so every call resolves to the same (wrong) spec.  Pinning the precise
    /// mangle here disambiguates them.  `qualified_target` is the same owner
    /// name used to register the spec in DI.  Empty on failure (caller leaves
    /// `resolved_callee` clear, falling back to the old behavior).
    mangled_symbol_for_spec_method(mut &this, spec_method: MethodNode*,
                                   qualified_target: SymbolStr) -> SymbolStr {
        if (spec_method == null || spec_method.func == null) { return SymbolStr::empty(); }
        if (!qualified_target.is_valid()) { return SymbolStr::empty(); }
        const func: FunctionDeclNode* = spec_method.func;
        const type_qname: QualifiedName = QualifiedName::from_symbol(qualified_target);
        const method_param_refs: TypeRef[] = method_non_receiver_params(
            func, this.intern_table);
        const mangled: MangledName = MangledName::for_method_or_trait_impl(
            this.intern_table, this.arena, type_qname, func.origin_trait, func.name,
            method_receiver_kind(func, spec_method.is_static, this.intern_table),
            method_param_refs, func.resolved_return_type, func.is_variadic);
        return mangled.value;
    }

    /// Find an InstantiatedType in the arena whose resolved_type is the
    /// given concrete type.  Used by the unifier to walk back from a
    /// monomorphized struct/class/enum to its `(base, args)` wrapper so
    /// type-arg recovery works against still-generic formals.
    /// Recursive structural unifier for inference. Delegates to the shared
    /// `InferCtx` engine (types/inference.cryo): adopts the in-progress
    /// scratch side-table (`inference_param_ids` + `inference_bindings`),
    /// unifies one (formal, actual) pair, and writes the accumulated bindings
    /// back. Callers populate `this.inference_param_ids` before invoking; for
    /// free-fn calls that's the template's `entry.param_type_ids`; for
    /// method-call specs it's the method's own generic-param TypeRef IDs.
    unify_for_inference(mut &this, formal: TypeRef, actual: TypeRef) -> boolean {
        mut ctx: InferCtx = InferCtx::adopt(
            this.arena, this.inference_param_ids, this.inference_bindings);
        const ok: boolean = ctx.unify(formal, actual);
        // Copy the solved bindings back; `ctx` owns its buffer (adopt cloned
        // it) and drops it at scope exit, so a move here would double-free.
        // TypeRef is Copy.
        mut solved: TypeRef[] = [];
        for (mut i: i64 = 0; i < ctx.bindings.length; i++) { solved.push(ctx.bindings[i]); }
        this.inference_bindings = solved;
        // Surface any open-param binding conflict the unifier recorded so the
        // caller can judge whether it is a real type error or a coercible one.
        this.infer_conflict_from = ctx.conflict_from;
        this.infer_conflict_to   = ctx.conflict_to;
        return ok;
    }

    /// Walk a block statement and resolve type annotations on all local
    /// variable declarations.  Recurses into nested blocks.
    resolve_body_locals(mut &this, block: BlockStmtNode*, res_ctx: ResolutionContext*) -> void {
        if (block == null) { return; }
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            const stmt: StatementNode* = block.statements[i];
            if (stmt == null) { continue; }
            const node: ASTNode* = stmt as ASTNode*;

            if (node.kind == NodeKind::DeclarationStatement) {
                const decl_stmt: DeclStmtNode* = stmt as DeclStmtNode*;
                const inner_decl: DeclarationNode* = decl_stmt.declaration;
                if (inner_decl != null) {
                    const inner_node: ASTNode* = inner_decl as ASTNode*;
                    if (inner_node.kind == NodeKind::VariableDeclaration) {
                        const var_decl: VarDeclNode* = inner_decl as VarDeclNode*;
                        if (var_decl.type_annotation != null && !var_decl.resolved_type.is_valid()) {
                            const vtype: TypeRef = this.type_resolver.resolve(
                                var_decl.type_annotation, res_ctx);
                            if (vtype.is_valid()) {
                                var_decl.resolved_type = vtype;
                            }
                        }
                    }
                }
            }
            // Recurse into nested blocks
            if (node.kind == NodeKind::BlockStatement) {
                this.resolve_body_locals(stmt as BlockStmtNode*, res_ctx);
            }
            if (node.kind == NodeKind::IfStatement) {
                const if_stmt: IfStmtNode* = stmt as IfStmtNode*;
                if (if_stmt.then_stmt != null) {
                    const then_node: ASTNode* = if_stmt.then_stmt as ASTNode*;
                    if (then_node.kind == NodeKind::BlockStatement) {
                        this.resolve_body_locals(if_stmt.then_stmt as BlockStmtNode*, res_ctx);
                    }
                }
                if (if_stmt.has_else() && if_stmt.else_stmt != null) {
                    const else_node: ASTNode* = if_stmt.else_stmt as ASTNode*;
                    if (else_node.kind == NodeKind::BlockStatement) {
                        this.resolve_body_locals(if_stmt.else_stmt as BlockStmtNode*, res_ctx);
                    }
                }
            }
            if (node.kind == NodeKind::WhileStatement) {
                const while_stmt: WhileStmtNode* = stmt as WhileStmtNode*;
                if (while_stmt.body != null) {
                    const body_node: ASTNode* = while_stmt.body as ASTNode*;
                    if (body_node.kind == NodeKind::BlockStatement) {
                        this.resolve_body_locals(while_stmt.body as BlockStmtNode*, res_ctx);
                    }
                }
            }
            if (node.kind == NodeKind::ForStatement) {
                const for_stmt: ForStmtNode* = stmt as ForStmtNode*;
                // Resolve the loop's init VarDecl (e.g. `mut i: int = 0`).
                // Without this, codegen sees `i` as an unresolved identifier
                // and indexing like `this.keys[i]` produces a null index.
                // The init can be either a bare VariableDeclaration or a
                // DeclarationStatement wrapping one, depending on how it
                // was parsed.
                if (for_stmt.init != null) {
                    const init_node: ASTNode* = for_stmt.init;
                    mut for_var: VarDeclNode* = null;
                    if (init_node.kind == NodeKind::VariableDeclaration) {
                        for_var = for_stmt.init as VarDeclNode*;
                    } else if (init_node.kind == NodeKind::DeclarationStatement) {
                        const init_decl: DeclStmtNode* = for_stmt.init as DeclStmtNode*;
                        const inner_decl: DeclarationNode* = init_decl.declaration;
                        if (inner_decl != null) {
                            const inner_node: ASTNode* = inner_decl as ASTNode*;
                            if (inner_node.kind == NodeKind::VariableDeclaration) {
                                for_var = inner_decl as VarDeclNode*;
                            }
                        }
                    }
                    if (for_var != null && for_var.type_annotation != null
                            && !for_var.resolved_type.is_valid()) {
                        const vtype: TypeRef = this.type_resolver.resolve(
                            for_var.type_annotation, res_ctx);
                        if (vtype.is_valid()) {
                            for_var.resolved_type = vtype;
                        }
                    }
                }
                if (for_stmt.body != null) {
                    const body_node: ASTNode* = for_stmt.body as ASTNode*;
                    if (body_node.kind == NodeKind::BlockStatement) {
                        this.resolve_body_locals(for_stmt.body as BlockStmtNode*, res_ctx);
                    }
                }
            }
            if (node.kind == NodeKind::MatchStatement) {
                const match_stmt: MatchStmtNode* = stmt as MatchStmtNode*;
                for (mut mi: i64 = 0; mi < match_stmt.arms.length; mi++) {
                    const arm: MatchArmNode* = match_stmt.arms[mi];
                    if (arm != null && arm.body != null) {
                        const arm_body: ASTNode* = arm.body as ASTNode*;
                        if (arm_body.kind == NodeKind::BlockStatement) {
                            this.resolve_body_locals(arm.body as BlockStmtNode*, res_ctx);
                        }
                    }
                }
            }
            if (node.kind == NodeKind::LoopStatement) {
                const loop_stmt: LoopStmtNode* = stmt as LoopStmtNode*;
                if (loop_stmt.body != null) {
                    const loop_body: ASTNode* = loop_stmt.body as ASTNode*;
                    if (loop_body.kind == NodeKind::BlockStatement) {
                        this.resolve_body_locals(loop_stmt.body as BlockStmtNode*, res_ctx);
                    }
                }
            }
        }
    }


    // Concrete type population: read from specialized AST

    /// Populate the concrete arena type from the specialized AST node,
    /// which now has resolved_type fields filled by the re-resolution step.
    populate_concrete_type(mut &this, concrete_type: TypeRef, specialized_ast: ASTNode*,
                           node_kind: NodeKind, subst: TypeSubstitution*,
                           entry: TemplateEntry*) -> void {
        const concrete_t: Type* = this.arena.lookup(concrete_type.id);
        if (concrete_t == null || specialized_ast == null) { return; }

        match (node_kind) {
            NodeKind::StructDeclaration => {
                this.populate_struct_fields(concrete_t as StructType*,
                    specialized_ast as StructDeclNode*);
            }
            NodeKind::ClassDeclaration => {
                this.populate_class_fields(concrete_t as ClassType*,
                    specialized_ast as ClassDeclNode*);
            }
            NodeKind::EnumDeclaration => {
                this.populate_enum_variants(concrete_t as EnumType*,
                    specialized_ast as EnumDeclNode*, subst, entry);
            }
            _ => {}
        }
    }

    /// Populate a specialized StructType's fields from the specialized AST.
    /// resolved_type on each FieldDeclNode was filled by resolve_specialized_ast().
    populate_struct_fields(mut &this, st: StructType*, decl: StructDeclNode*) -> void {
        if (decl == null) { return; }

        mut field_infos: FieldInfo[] = [];
        for (mut i: i64 = 0; i < decl.fields.length; i++) {
            const field: FieldDeclNode* = decl.fields[i];
            if (field == null) { continue; }
            const is_pub: boolean = field.visibility == Visibility::Public;
            const is_prot: boolean = field.visibility == Visibility::Protected;
            field_infos.push(FieldInfo::new(field.name, field.resolved_type, is_pub, is_prot, true));
        }
        st.set_fields(field_infos);

        // Stamp the chosen layout onto the concrete type. The flags came
        // from the generic template via the cloner; DirectiveProcessing
        // (which fills them for non-generic structs) runs before mono and
        // never sees this specialization, so without this a `![repr]` /
        // `![align]` on a generic struct would be silently dropped for
        // every instantiation.
        st.set_repr(decl.repr_c, decl.repr_packed, decl.repr_transparent);
        st.set_min_alignment(decl.min_alignment);

        this.populate_struct_methods(st, decl);
    }

    /// Populate a specialized ClassType's fields from the specialized AST.
    populate_class_fields(mut &this, ct: ClassType*, decl: ClassDeclNode*) -> void {
        if (decl == null) { return; }

        mut field_infos: FieldInfo[] = [];
        for (mut i: i64 = 0; i < decl.fields.length; i++) {
            const field: FieldDeclNode* = decl.fields[i];
            if (field == null) { continue; }
            const is_pub: boolean = field.visibility == Visibility::Public;
            const is_prot: boolean = field.visibility == Visibility::Protected;
            field_infos.push(FieldInfo::new(field.name, field.resolved_type, is_pub, is_prot, true));
        }
        ct.set_fields(field_infos);

        // Stamp the chosen layout onto the concrete type (see
        // populate_struct_fields for why this is needed).
        ct.set_repr(decl.repr_c, decl.repr_packed, decl.repr_transparent);
        ct.set_min_alignment(decl.min_alignment);

        this.populate_class_methods(ct, decl);
    }

    /// Mirror the specialized AST's methods onto the spec'd StructType.
    /// Without this, sema's `resolve_method_overload` can't find any
    /// methods on `Box<i32>` etc.; `methods_ref = sst.methods` is empty
    /// even though `decl.methods` has them post-monomorphization, and
    /// `resolved_method` stays null.  That breaks consume detection for
    /// by-value receivers (move-checker/drop-synthesizer can't read
    /// `OwnershipQuery::method_consumes_receiver`), causing synth drops
    /// to fire on already-consumed bindings.
    populate_struct_methods(mut &this, st: StructType*, decl: StructDeclNode*) -> void {
        if (st == null || decl == null) { return; }
        const this_amp: SymbolStr = this.intern_table.intern("&this");
        const this_val: SymbolStr = this.intern_table.intern("this");
        for (mut mi: i64 = 0; mi < decl.methods.length; mi++) {
            const m: MethodNode* = decl.methods[mi];
            if (m == null || m.func == null) { continue; }
            mut ptypes: TypeRef[] = [];
            for (mut pi: i64 = 0; pi < m.func.parameters.length; pi++) {
                const pp: VarDeclNode* = m.func.parameters[pi];
                if (pp == null) { continue; }
                if (pp.name.equals(this_amp)) { continue; }
                if (pp.name.equals(this_val)) { continue; }
                ptypes.push(pp.resolved_type);
            }
            const fn_ty: TypeRef = this.arena.get_function(
                m.func.resolved_return_type, ptypes, m.func.is_variadic);
            const minfo: MethodInfo = MethodInfo {
                name:          m.func.name,
                function_type: fn_ty,
                is_public:     m.visibility == Visibility::Public,
                is_protected:  m.visibility == Visibility::Protected,
                is_static:     m.is_static,
                is_virtual:    m.is_virtual,
                is_override:   m.is_override,
                param_types:   ptypes,
                ast_node:      m as void*,
            };
            st.add_method(minfo);
        }
    }

    /// Class counterpart to populate_struct_methods.  Same rationale;
    /// sema needs the spec's methods to resolve member-access calls on
    /// generic class instantiations.
    populate_class_methods(mut &this, ct: ClassType*, decl: ClassDeclNode*) -> void {
        if (ct == null || decl == null) { return; }
        const this_amp: SymbolStr = this.intern_table.intern("&this");
        const this_val: SymbolStr = this.intern_table.intern("this");
        for (mut mi: i64 = 0; mi < decl.methods.length; mi++) {
            const m: MethodNode* = decl.methods[mi];
            if (m == null || m.func == null) { continue; }
            mut ptypes: TypeRef[] = [];
            for (mut pi: i64 = 0; pi < m.func.parameters.length; pi++) {
                const pp: VarDeclNode* = m.func.parameters[pi];
                if (pp == null) { continue; }
                if (pp.name.equals(this_amp)) { continue; }
                if (pp.name.equals(this_val)) { continue; }
                ptypes.push(pp.resolved_type);
            }
            const fn_ty: TypeRef = this.arena.get_function(
                m.func.resolved_return_type, ptypes, m.func.is_variadic);
            const minfo: MethodInfo = MethodInfo {
                name:          m.func.name,
                function_type: fn_ty,
                is_public:     m.visibility == Visibility::Public,
                is_protected:  m.visibility == Visibility::Protected,
                is_static:     m.is_static,
                is_virtual:    m.is_virtual,
                is_override:   m.is_override,
                param_types:   ptypes,
                ast_node:      m as void*,
            };
            ct.add_method(minfo);
        }
    }

    /// Populate a specialized EnumType's variants by applying the
    /// substitution to the base generic enum's variant payload types.
    ///
    /// The earlier approach walked the (cloned + substituted) AST and
    /// re-resolved each variant annotation via the TypeResolver.  That
    /// failed for "partial" specializations like `Option<T*>` whose
    /// substituted variant annotation is `T`, referring to an outer
    /// generic param that has no binding in the local ResolutionContext.
    ///
    /// Substituting against the base's already-resolved payload TypeRefs
    /// avoids the binding gap entirely: subst maps the base's
    /// GenericParam_T to whatever the caller specified (e.g.,
    /// `Pointer(GenericParam_T_outer)`), producing a valid TypeRef
    /// without needing the resolver to know about outer scopes.
    populate_enum_variants(mut &this, et: EnumType*, decl: EnumDeclNode*,
                           subst: TypeSubstitution*, entry: TemplateEntry*) -> void {
        if (entry == null || subst == null) { return; }

        // Stamp the chosen layout onto the concrete enum (see
        // populate_struct_fields). `repr_c` is currently a no-op marker for
        // enums; `min_alignment` is honoured by TypeLowering.
        if (decl != null) {
            et.set_repr_c(decl.repr_c);
            et.set_min_alignment(decl.min_alignment);
        }

        // Idempotency guard: partial specs (e.g., `Option<T*>` for two outer
        // generics T_a and T_b) collapse to the same spec_name `Option_LPN_L1T_G_G`
        // and therefore the same EnumType in the arena.  Without this guard,
        // populate runs once per outer caller and accumulates duplicate
        // variants ([Some, None, Some, None, ...]), which then breaks
        // `et.get_variant("Some")` (returns the first match, possibly the
        // wrong substitution).
        if (et.variants.length > 0) { return; }

        // Look up the base generic enum.  Its variants were populated by
        // type_resolution.cryo's EnumDeclaration handler with GenericParam
        // payloads (`Some(T)` -> `payload_types = [GenericParam_T]`).
        const base_t: Type* = this.arena.lookup(entry.base_type.id);
        if (base_t == null || base_t.kind != TypeKind::Enum) { return; }
        const base_et: EnumType* = base_t as EnumType*;

        // Propagate the explicit discriminant base (`type enum E<T> : i64`)
        // to the specialization so a SIMPLE enum spec lowers its tag at the
        // declared width.  The base is normally a concrete primitive;
        // route through `subst` anyway so it stays correct under any binding.
        if (base_et.discriminant_type.is_valid()) {
            et.set_discriminant_type(
                subst.apply(base_et.discriminant_type, this.arena));
        }

        for (mut i: i64 = 0; i < base_et.variants.length; i++) {
            const base_variant: EnumVariantInfo* = &base_et.variants[i];
            mut payload_types: TypeRef[] = [];
            for (mut j: i64 = 0; j < base_variant.payload_types.length; j++) {
                const substituted: TypeRef = subst.apply(base_variant.payload_types[j], this.arena);
                payload_types.push(substituted);
            }
            et.add_variant(EnumVariantInfo::new(
                base_variant.name, payload_types, base_variant.tag_value));
        }
    }

    // Function type creation from specialized AST

    /// Build a concrete FunctionType from a specialized FunctionDeclNode whose
    /// signature has already been resolved by resolve_specialized_ast().
    /// Returns invalid if the return type wasn't resolved (shouldn't happen
    /// after a successful resolve_specialized_ast, but defensive).
    build_function_type_from_ast(mut &this, ast_node: ASTNode*) -> TypeRef {
        if (ast_node == null) { return TypeRef::invalid(); }
        const func: FunctionDeclNode* = ast_node as FunctionDeclNode*;
        if (func == null) { return TypeRef::invalid(); }

        // Return type must have been resolved
        const ret_type: TypeRef = func.resolved_return_type;
        if (!ret_type.is_valid()) {
            return TypeRef::invalid();
        }

        // Collect resolved parameter types
        mut param_types: TypeRef[] = [];
        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param != null && param.resolved_type.is_valid()) {
                param_types.push(param.resolved_type);
            } else {
                // If any param is unresolved, bail; shouldn't happen
                return TypeRef::invalid();
            }
        }

        return this.arena.get_function(ret_type, param_types, func.is_variadic);
    }


    // Nested instantiation discovery

    /// Walk a type recursively, enqueuing any unmonomorphized InstantiatedTypes.
    /// Uses enqueue_from_type_ref (not enqueue_from_inst) so that all requests
    /// go through the same validation: base type must be a registered template,
    /// args must not contain unresolved generic params, etc.
    request_nested_instantiations(mut &this, ty: TypeRef) -> void {
        if (ty.is_invalid() || ty.id == 0) { return; }

        // Cycle detection: skip types we've already visited in this traversal
        for (mut v: i64 = 0; v < this.nested_visited.length; v++) {
            if (this.nested_visited[v] == ty.id) { return; }
        }
        this.nested_visited.push(ty.id);

        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return; }

        match (t.kind) {
            TypeKind::InstantiatedType => {
                const inst: InstantiatedType* = t as InstantiatedType*;
                if (!inst.has_resolved_type()) {
                    this.enqueue_from_type_ref(ty);
                }
                // Also recurse into type args
                for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                    this.request_nested_instantiations(inst.type_args[i]);
                }
            }
            TypeKind::Pointer => {
                const ptr: PointerType* = t as PointerType*;
                this.request_nested_instantiations(ptr.pointee);
            }
            TypeKind::Reference => {
                const ref: ReferenceType* = t as ReferenceType*;
                this.request_nested_instantiations(ref.referent);
            }
            TypeKind::Array => {
                const arr: ArrayType* = t as ArrayType*;
                this.request_nested_instantiations(arr.element);
                // For dynamic arrays with concrete element types, ensure
                // Array<elem> is monomorphized.  T[] creates ArrayType but
                // not InstantiatedType(Array,[T]), so the worklist misses it.
                if (arr.is_dynamic() && arr.element.is_valid()) {
                    const elem_t: Type* = this.arena.lookup(arr.element.id);
                    if (elem_t != null && elem_t.kind != TypeKind::GenericParam
                                       && elem_t.kind != TypeKind::BoundedParam) {
                        const array_sym: SymbolStr = this.intern_table.intern(
                            "std::collections::array::Array");
                        const array_entry: TemplateEntry* =
                            this.generic_registry.get_template(array_sym);
                        if (array_entry != null) {
                            mut args: TypeRef[] = [];
                            args.push(arr.element);
                            const _empty: string = "";
                            mut nested_ctx: ResolutionContext = ResolutionContext::new(_empty, _empty);
                            args = this.type_resolver.expand_default_type_args(array_entry, args, &nested_ctx);
                            const inst_ref: TypeRef =
                                this.generic_registry.instantiate(array_entry.base_type, args);
                            this.enqueue_from_type_ref(inst_ref);
                        }
                    }
                }
            }
            TypeKind::Optional => {
                const opt: OptionalType* = t as OptionalType*;
                this.request_nested_instantiations(opt.wrapped);
            }
            TypeKind::Function => {
                const func: FunctionType* = t as FunctionType*;
                this.request_nested_instantiations(func.return_type);
                for (mut i: i64 = 0; i < func.param_types.length; i++) {
                    this.request_nested_instantiations(func.param_types[i]);
                }
            }
            TypeKind::Tuple => {
                const tup: TupleType* = t as TupleType*;
                for (mut i: i64 = 0; i < tup.elements.length; i++) {
                    this.request_nested_instantiations(tup.elements[i]);
                }
            }
            TypeKind::Struct => {
                const st: StructType* = t as StructType*;
                for (mut i: i64 = 0; i < st.fields.length; i++) {
                    this.request_nested_instantiations(st.fields[i].field_type);
                }
            }
            TypeKind::Class => {
                const cl: ClassType* = t as ClassType*;
                for (mut i: i64 = 0; i < cl.fields.length; i++) {
                    this.request_nested_instantiations(cl.fields[i].field_type);
                }
            }
            TypeKind::Enum => {
                const en: EnumType* = t as EnumType*;
                for (mut i: i64 = 0; i < en.variants.length; i++) {
                    for (mut j: i64 = 0; j < en.variants[i].payload_types.length; j++) {
                        const payload_ty: TypeRef = en.variants[i].payload_types[j];
                        this.request_nested_instantiations(payload_ty);
                    }
                }
            }
            _ => {
                // No nested types to discover
            }
        }
    }


    // Batch compilation support

    /// Reset transient per-module state while preserving the specialization
    /// cache and injection cursor.  Called between modules in StdlibBatch mode
    /// so the Monomorphizer can be reused without losing cross-module results.
    reset_for_next_module(mut &this) -> void {
        this.pending        = [];
        this.pending_cursor = 0;
        this.in_progress    = HashMap<string, boolean>::new();
        this.error_count    = 0;
    }

    /// Get only the specialized ASTs produced since the last call to this
    /// method (or since construction).  Advances the injection cursor so
    /// each module receives only its new specializations, avoiding duplicate
    /// declarations in the ProgramNode during batch compilation.
    ///
    get_new_specialized_asts(mut &this) -> ASTNode*[] {
        mut result: ASTNode*[] = [];
        for (mut i: i64 = this.injection_cursor; i < this.spec_entries.length; i++) {
            if (this.spec_entries[i].ast_node != null) {
                result.push(this.spec_entries[i].ast_node);
            }
            for (mut j: i64 = 0; j < this.spec_entries[i].impl_nodes.length; j++) {
                result.push(this.spec_entries[i].impl_nodes[j]);
            }
        }
        this.injection_cursor = this.spec_entries.length;
        return result;
    }


    // Result access

    /// Get all specialized AST declarations for injection into the program.
    get_all_specialized_asts(&this) -> ASTNode*[] {
        mut result: ASTNode*[] = [];
        for (mut i: i64 = 0; i < this.spec_entries.length; i++) {
            if (this.spec_entries[i].ast_node != null) {
                result.push(this.spec_entries[i].ast_node);
            }
            // Also include impl block ASTs
            for (mut j: i64 = 0; j < this.spec_entries[i].impl_nodes.length; j++) {
                result.push(this.spec_entries[i].impl_nodes[j]);
            }
        }
        return result;
    }

    /// Number of specializations completed.
    specialization_count(&this) -> i64 {
        return this.spec_entries.length;
    }

    /// Record that a module consumes (has injected) a specialization.
    /// Uses flat parallel arrays to avoid push-through-pointer codegen issues.
    record_consuming_module(mut &this, spec_index: i64, module: SymbolStr) -> void {
        if (spec_index >= 0 && spec_index < this.spec_entries.length) {
            this.consumer_spec_indices.push(spec_index);
            this.consumer_modules.push(module.id);
        }
    }

    /// Get all modules that consume a specific specialization.
    get_consuming_modules(&this, spec_index: i64) -> SymbolStr[] {
        mut result: SymbolStr[] = [];
        for (mut i: i64 = 0; i < this.consumer_spec_indices.length; i++) {
            if (this.consumer_spec_indices[i] == spec_index) {
                result.push(SymbolStr::from_id(this.consumer_modules[i]));
            }
        }
        return result;
    }


    // Internal helpers

    /// Enqueue a monomorphization request from a TypeRef that is an InstantiatedType.
    /// Skips instantiations that cannot be monomorphized:
    ///   - Base type is not a registered template (e.g., void, primitives)
    ///   - Base type is a TypeAlias (generic aliases are expanded during type
    ///     resolution, not monomorphized, e.g., SomeResult<int> -> Result<int, string>)
    ///   - Type args containing unresolved GenericParamType or BoundedParamType
    ///     (template-internal references like Pair<T> in a generic method return type)
    enqueue_from_type_ref(mut &this, ty: TypeRef) -> void {
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null || t.kind != TypeKind::InstantiatedType) { return; }
        const inst: InstantiatedType* = t as InstantiatedType*;

        // Skip if base type is not a monomorphizable kind.
        // Only Struct, Enum, Class, Trait, and Function types can be templates.
        // This prevents non-generic types (void, primitives, etc.) from being
        // spuriously fed into the monomorphizer.
        const base_t: Type* = this.arena.lookup(inst.generic_base.id);
        if (base_t == null) { return; }
        if (base_t.kind == TypeKind::TypeAlias) { return; }
        if (base_t.kind != TypeKind::Struct &&
            base_t.kind != TypeKind::Enum &&
            base_t.kind != TypeKind::Class &&
            base_t.kind != TypeKind::Trait &&
            base_t.kind != TypeKind::Function &&
            base_t.kind != TypeKind::FunctionTemplate) {
            return;
        }

        // Double-check against the GenericRegistry; only enqueue types that
        // were actually registered as templates during TemplateRegistration.
        if (!this.generic_registry.is_template(inst.generic_base.id)) {
            return;
        }

        // Skip partial specs; any type arg that *contains* an unresolved
        // GenericParam at any depth (including nested through Pointer,
        // Reference, Array, Optional, Tuple, Function, InstantiatedType) is
        // not yet concrete.  Mono should only process fully-concrete specs;
        // partial ones get further substituted when the *outer* template is
        // monomorphized, and would otherwise collide on spec_name and produce
        // miscompiled bodies (e.g., return type doubled to T**).
        for (mut i: i64 = 0; i < inst.type_args.length; i++) {
            if (this.type_contains_generic_param(inst.type_args[i])) {
                return;
            }
        }

        this.enqueue_from_inst(ty, inst);
    }

    /// Recursively check if a type contains any unresolved GenericParam or
    /// BoundedParam at any depth.  Used to filter partial specs out of
    /// monomorphization (see enqueue_from_type_ref).
    type_contains_generic_param(&this, ty: TypeRef) -> boolean {
        if (!ty.is_valid()) { return false; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return false; }
        if (t.kind == TypeKind::GenericParam) { return true; }
        if (t.kind == TypeKind::BoundedParam) { return true; }
        if (t.kind == TypeKind::Pointer) {
            const ptr: PointerType* = t as PointerType*;
            return this.type_contains_generic_param(ptr.pointee);
        }
        if (t.kind == TypeKind::Reference) {
            const ref: ReferenceType* = t as ReferenceType*;
            return this.type_contains_generic_param(ref.referent);
        }
        if (t.kind == TypeKind::Array) {
            const arr: ArrayType* = t as ArrayType*;
            return this.type_contains_generic_param(arr.element);
        }
        if (t.kind == TypeKind::Optional) {
            const opt: OptionalType* = t as OptionalType*;
            return this.type_contains_generic_param(opt.wrapped);
        }
        if (t.kind == TypeKind::Tuple) {
            const tup: TupleType* = t as TupleType*;
            for (mut i: i64 = 0; i < tup.elements.length; i++) {
                if (this.type_contains_generic_param(tup.elements[i])) { return true; }
            }
            return false;
        }
        if (t.kind == TypeKind::Function) {
            const func: FunctionType* = t as FunctionType*;
            if (this.type_contains_generic_param(func.return_type)) { return true; }
            for (mut i: i64 = 0; i < func.param_types.length; i++) {
                if (this.type_contains_generic_param(func.param_types[i])) { return true; }
            }
            return false;
        }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                if (this.type_contains_generic_param(inst.type_args[i])) { return true; }
            }
            return false;
        }
        return false;
    }

    enqueue_from_inst(mut &this, ty: TypeRef, inst: InstantiatedType*) -> void {
        const request: MonomorphRequest = MonomorphRequest {
            generic_type: ty,
            type_args:    mono_copy_type_refs(&inst.type_args),
            base_type:    inst.generic_base,
            span:         SourceSpan::none(),
        };
        this.pending.push(request);
    }

    /// Build a cache key from a request, used to dedup specializations in
    /// `spec_index`.  Mirrors GenericRegistry's `make_cache_key` format
    /// (`base<arg,arg>`) but canonicalizes each argument id through
    /// `canon_type_id`: an arg that arrives as an InstantiatedType wrapper
    /// (e.g. the inner `Range<i32>` of a Phase-5 annotation `TakeIter<Range<i32>>`)
    /// collapses to the same concrete id the monomorphizer used when it built
    /// the spec from the concrete struct.  Without this, two equivalent
    /// instantiations key differently and produce two distinct concrete
    /// structs for one type, which then compare unequal (spurious E0200 on
    /// `mut t: TakeIter<Range<i32>> = r.take(n)`).  When no argument needs
    /// canonicalizing the key is byte-identical to the raw form, so existing
    /// behavior is unchanged.
    make_key(&this, request: &MonomorphRequest) -> string {
        return this.make_key_for(request.base_type, request.type_args);
    }

    /// `make_key` over a raw `(base, args)` pair.  Canonicalizes each arg id
    /// (see `canon_type_id`) so equivalent instantiations dedup to one spec.
    make_key_for(&this, base: TypeRef, type_args: &TypeRef[]) -> string {
        mut key: string = format("%llu<", base.id);
        for (mut i: i64 = 0; i < type_args.length; i++) {
            if (i > 0) { key += ","; }
            key += format("%llu", this.arena.canon_type_id(type_args[i]));
        }
        key += ">";
        return key;
    }

    /// Check if a key is already in the specialization cache.
    is_cached(&this, key: string) -> boolean {
        const h: u64 = hash_str(key);
        return this.spec_index.get(&key).is_some();
    }

    /// Link a cache-hit request's InstantiatedType(s) to the previously
    /// computed concrete type.  Sema creates a fresh InstantiatedType per
    /// call site, so when a later module revisits an already-specialized
    /// pair (base, args) the new placeholder stays unresolved unless we
    /// explicitly propagate.  Codegen's scope-call fallback walks
    /// `resolved_type` to reach the concrete struct name, so without this
    /// link it emits E0147 for calls like `HashMap<string, u32>::new()`
    /// in any module that isn't the first to specialize the pair.
    propagate_cached_resolution(mut &this, key: string, request: &MonomorphRequest) -> void {
        const h: u64 = hash_str(key);
        const idx_opt: Option<i64> = this.spec_index.get(&key);
        if (!idx_opt.is_some()) { return; }
        const idx: i64 = idx_opt.unwrap();
        if (idx < 0 || idx >= this.spec_entries.length) { return; }
        const entry: SpecializationEntry* = &this.spec_entries[idx];
        if (!entry.specialized_type.is_valid()) { return; }
        this.arena.propagate_instantiated_resolution(
            request.base_type, request.type_args, entry.specialized_type);
    }

    /// Check if a key is currently being processed (cycle detection).
    is_in_progress(&this, key: string) -> boolean {
        const h: u64 = hash_str(key);
        return this.in_progress.get(&key).is_some();
    }

    /// Remove a key from the in-progress set.
    remove_in_progress(mut &this, key: string) -> void {
        const h: u64 = hash_str(key);
        this.in_progress.remove(&key);
    }
}
