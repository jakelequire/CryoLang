///! User-Defined Types
///!
///! The payloads of struct, class, enum, trait, type alias and function
///! template types, and their helper structs.  Supports forward declaration
///! (is_complete flag) and incremental population of fields/methods.

namespace compiler::types::user_defined;

import compiler::types;
import compiler::types::type_ref;
import compiler::types::type_ref::{ TypeRef };
import compiler::resolver::{ symbol_str, intern_table };
import compiler::ast::expression;
import compiler::ast::expression::{ ExpressionNode };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::decl_name;
import compiler::resolver::decl_name::{ DeclName };
import compiler::resolver::res::{ DefId };
import compiler::module_graph;
import compiler::module_graph::{ ModulePath };


// FieldInfo: Metadata for a struct/class field

type struct FieldInfo {
private:
    name:       SymbolStr;
public:
    field_type: TypeRef;
    offset:     u64;
    is_public:  boolean;
    /// `protected` visibility: accessible from the declaring type and any
    /// of its subclasses (but not unrelated code).  Mutually exclusive
    /// with `is_public`; both false => `private`.
    is_protected: boolean;
    is_mutable: boolean;
    /// The field's `= expr` default, or null.  When a struct literal omits this
    /// field, sema clones this expression, resolves it, and appends it as a
    /// synthetic field-init (so codegen fills the field); a field with no default
    /// that is omitted is `E0355`.  Carries an AST pointer for the same reason the
    /// generic registry does - it is the authority the use site consults.
    default_value: ExpressionNode*;

    static new(name: SymbolStr, field_type: TypeRef, is_public: boolean,
               is_protected: boolean, is_mutable: boolean) -> FieldInfo {
        return FieldInfo {
            name:          name,
            field_type:    field_type,
            offset:        0,
            is_public:     is_public,
            is_protected:  is_protected,
            is_mutable:    is_mutable,
            default_value: null,
        };
    }

    has_default(&this) -> boolean { return this.default_value != null; }
    set_default_value(v: ExpressionNode*) -> void { this.default_value = v; }

    /// The field's declared name, sealed: printed with `InternTable::shown`,
    /// or carried by a node synthesized for this field (`spelling`) beside
    /// the position it is pinned to.  Never a key: a field is found by the
    /// `member-field` door.
    decl_name(&this) -> DeclName {
        return DeclName::of(this.name);
    }
}


// MethodInfo: Metadata for a type method

type struct MethodInfo {
    name:          SymbolStr;
    function_type: TypeRef;   // Points to a FunctionType in the arena
    is_public:     boolean;
    /// `protected` visibility: callable from the declaring type and its
    /// subclasses.  Mutually exclusive with `is_public`; both false =>
    /// `private`.
    is_protected:  boolean;
    is_static:     boolean;
    is_virtual:    boolean;
    is_override:   boolean;
    /// Canonical parameter TypeRefs: the non-self params in declaration
    /// order.  This is the overload discriminator for vtable slot
    /// identity: two methods share a slot if they have the same `name`
    /// AND all param TypeRefs equal by arena ID.  The arena dedups types,
    /// so identical parameter types always share an ID regardless of how
    /// they were spelled at the source level.
    param_types:   [TypeRef];
    /// Opaque back-reference to the AST `MethodNode*`.  Typed as
    /// `void*` here to keep the Types module free of AST imports
    /// (AST depends on Types, so the other direction would cycle);
    /// callers downcast to `MethodNode*` at the use site.  Enables sema
    /// to walk from `ClassType.methods` back to the declaration during
    /// overload resolution, and codegen to identify the chosen overload.
    ast_node:      void*;

    static new(name: SymbolStr, function_type: TypeRef, is_public: boolean, is_static: boolean) -> MethodInfo {
        return MethodInfo {
            name:          name,
            function_type: function_type,
            is_public:     is_public,
            is_protected:  false,
            is_static:     is_static,
            is_virtual:    false,
            is_override:   false,
            param_types:   [],
            ast_node:      null,
        };
    }
}


// EnumVariantInfo: Metadata for an enum variant
//
// The variant's name is private to this module: `EnumType::variant_index`
// is the one place a written leaf finds a variant, and any other reader
// asks for the name as text to print.

type struct EnumVariantInfo {
    private name:  SymbolStr;
    payload_types: [TypeRef];
    tag_value:     u64;

    static new(name: SymbolStr, payload_types: [TypeRef], tag_value: u64) -> EnumVariantInfo {
        return EnumVariantInfo {
            name:          name,
            payload_types: payload_types,
            tag_value:     tag_value,
        };
    }

    has_payload(&this) -> boolean {
        return this.payload_types.length > 0;
    }

    /// This variant with `payload_types` in place of its own: the same
    /// name and tag, for an instance whose payloads are substituted.
    with_payloads(&this, payload_types: [TypeRef]) -> EnumVariantInfo {
        return EnumVariantInfo::new(this.name, payload_types, this.tag_value);
    }

    /// The variant's name as text, for a message.  Never a key: a variant
    /// is found by its leaf only through `EnumType::variant_index`.
    display_name(&this, table: InternTable*) -> string {
        return table.resolve(this.name);
    }
}


// StructType: Named struct with fields and methods

type struct StructType {
    qualified_name: DeclName;
    /// The module the type is declared in; none for a unit the module graph
    /// did not load.
    declared_in:    ModulePath;
    intern_table:   InternTable*;
    fields:         [FieldInfo];
    methods:        [MethodInfo];
    is_complete:    boolean;
    /// A specialization's display (`Vec<i32>`), read off its template's and
    /// arguments' definitions; the name of nothing on any other type.
    custom_display: DeclName;
    computed_size:  u64;        // Computed by TypeLowering pass (0 = not yet computed)
    computed_align: u64;        // Computed by TypeLowering pass (0 = not yet computed)
    /// Layout attributes copied from the StructDeclNode by TypeResolution.
    /// `repr_c`/`repr_packed`/`repr_transparent` are mutually exclusive.
    /// `min_alignment` is 0 when no `![align]` directive applies, else a
    /// power-of-two byte count.  TypeLowering honours these when computing
    /// field offsets and the type's overall size/alignment; codegen
    /// reads them when emitting the LLVM struct body.
    repr_c:           boolean;
    repr_packed:      boolean;
    repr_transparent: boolean;
    min_alignment:    u64;
    /// True when this type came from `type union NAME { ... }` (AST
    /// `UnionDeclNode`).  An untagged C-style union: TypeLowering overlaps all
    /// fields at offset 0 (size = largest field, align = largest field), codegen
    /// lowers it to a single storage blob and accesses members via a bitcast at
    /// offset 0, and drop analysis treats it as POD (no field is auto-dropped,
    /// since the active member is unknown).  The struct machinery (field lookup,
    /// member resolution, generics) is otherwise shared.
    is_union:         boolean;
    /// The index in `fields` of the receiver slot on a future the async
    /// lowering minted for an `async` method (`StructDeclNode.async_recv_slot`,
    /// carried onto every instantiation of it); -1 on every other struct.
    async_recv_slot:  i64;
    /// The generic instantiation this concrete IS, carried intrinsically:
    /// `Box<i32>` holds `generic_base` = the `Box` template and `type_args` =
    /// `[i32]`.  The template and its arguments - the
    /// substitutions - live ON the type, so no side node has to be consulted.
    /// Invalid / empty for a non-generic type.
    generic_base:     TypeRef;
    type_args:        [TypeRef];

    static new(qualified_name: SymbolStr, declared_in: ModulePath, intern_table: InternTable*) -> StructType* {
        return new StructType {
            qualified_name:   DeclName::of(qualified_name),
            declared_in:      declared_in,
            intern_table:     intern_table,
            fields:           [],
            methods:          [],
            is_complete:      false,
            custom_display:   DeclName::empty(),
            computed_size:    0,
            computed_align:   0,
            repr_c:           false,
            repr_packed:      false,
            repr_transparent: false,
            min_alignment:    0,
            is_union:         false,
            async_recv_slot:  -1,
            generic_base:     TypeRef::invalid(),
            type_args:        [],
        };
    }

    /// Record the instantiation this concrete was monomorphized from.  `args` is
    /// copied ELEMENT-WISE: assigning a `[TypeRef]` by value aliases the source
    /// buffer, and dropping either owner would free the other's live storage.
    set_generic_origin(mut &this, base: TypeRef, args: &[TypeRef]) -> void {
        this.generic_base = base;
        mut copied: [TypeRef] = [];
        for (mut i: i64 = 0; i < args.length; i++) { copied.push(args[i]); }
        this.type_args = copied;
    }

    set_repr(mut &this, c: boolean, packed: boolean, transparent: boolean) -> void {
        this.repr_c           = c;
        this.repr_packed      = packed;
        this.repr_transparent = transparent;
    }

    set_union(mut &this, u: boolean) -> void {
        this.is_union = u;
    }

    set_async_recv_slot(mut &this, slot: i64) -> void {
        this.async_recv_slot = slot;
    }

    /// The receiver slot's entry on a future struct, or null on a struct
    /// that carries none.
    async_recv_field(&this) -> FieldInfo* {
        if (this.async_recv_slot < 0 || this.async_recv_slot >= this.fields.length) { return null; }
        return &this.fields[this.async_recv_slot];
    }

    set_min_alignment(mut &this, n: u64) -> void {
        this.min_alignment = n;
    }

    /// Populate fields for a previously forward-declared struct.
    set_fields(mut &this, fields: [FieldInfo]) -> void {
        this.fields      = fields;
        this.is_complete = true;
    }

    add_method(mut &this, method: MethodInfo) -> void {
        this.methods.push(method);
    }

    /// A field written as a leaf on a struct in hand:
    /// its position among the struct's fields, or -1.  The owner is known,
    /// so the leaf is asked inside it, here beside the field list.
    field_position(&this, leaf: SymbolStr) -> i64 {
        for (mut i: i64 = 0; i < this.fields.length; i++) {
            if (this.fields[i].name.equals(leaf)) { return i; }
        }
        return -1;
    }

    set_display_name(mut &this, name: DeclName) -> void { this.custom_display = name; }

    set_layout(mut &this, size: u64, align: u64) -> void {
        this.computed_size  = size;
        this.computed_align = align;
    }

    set_field_offset(mut &this, index: i64, offset: u64) -> void {
        this.fields[index].offset = offset;
    }

    display_name(&this) -> string {
        if (this.custom_display.is_valid()) { return this.intern_table.shown(this.custom_display); }
        return this.intern_table.shown(this.qualified_name);
    }
}


// ClassType: Class with inheritance support

type struct ClassType {
    qualified_name:      DeclName;
    declared_in:         ModulePath;
    intern_table:        InternTable*;
    fields:              [FieldInfo];
    methods:             [MethodInfo];
    base_class:          TypeRef;
    has_base:            boolean;
    has_virtual_methods: boolean;
    is_complete:         boolean;
    /// A specialization's display; the name of nothing on any other type.
    custom_display:      DeclName;
    computed_size:       u64;
    computed_align:      u64;

    /// Layout attributes copied from the ClassDeclNode by TypeResolution.
    /// See StructType for semantics.
    repr_c:           boolean;
    repr_packed:      boolean;
    repr_transparent: boolean;
    min_alignment:    u64;
    /// See StructType.generic_base / type_args: the instantiation this concrete
    /// IS, carried intrinsically rather than via a side node.
    generic_base:     TypeRef;
    type_args:        [TypeRef];

    static new(qualified_name: SymbolStr, declared_in: ModulePath, intern_table: InternTable*) -> ClassType* {
        return new ClassType {
            qualified_name:      DeclName::of(qualified_name),
            declared_in:         declared_in,
            intern_table:        intern_table,
            fields:              [],
            methods:             [],
            base_class:          TypeRef::invalid(),
            has_base:            false,
            has_virtual_methods: false,
            is_complete:         false,
            custom_display:      DeclName::empty(),
            computed_size:       0,
            computed_align:      0,
            repr_c:              false,
            repr_packed:         false,
            repr_transparent:    false,
            min_alignment:       0,
            generic_base:        TypeRef::invalid(),
            type_args:           [],
        };
    }

    /// See StructType::set_generic_origin - `args` is copied element-wise.
    set_generic_origin(mut &this, base: TypeRef, args: &[TypeRef]) -> void {
        this.generic_base = base;
        mut copied: [TypeRef] = [];
        for (mut i: i64 = 0; i < args.length; i++) { copied.push(args[i]); }
        this.type_args = copied;
    }

    set_repr(mut &this, c: boolean, packed: boolean, transparent: boolean) -> void {
        this.repr_c           = c;
        this.repr_packed      = packed;
        this.repr_transparent = transparent;
    }

    set_min_alignment(mut &this, n: u64) -> void {
        this.min_alignment = n;
    }

    set_fields(mut &this, fields: [FieldInfo]) -> void {
        this.fields      = fields;
        this.is_complete = true;
    }

    set_base_class(mut &this, base: TypeRef) -> void {
        this.base_class = base;
        this.has_base   = true;
    }

    add_method(mut &this, method: MethodInfo) -> void {
        const is_virtual: boolean  = method.is_virtual;
        const is_override: boolean = method.is_override;
        this.methods.push(method);
        if (is_virtual || is_override) {
            this.has_virtual_methods = true;
        }
    }

    /// A field written as a leaf on a class in hand:
    /// its position among the class's OWN fields, or -1.  A base's fields
    /// are its own class's to answer; the caller walks the chain.
    own_field_position(&this, leaf: SymbolStr) -> i64 {
        for (mut i: i64 = 0; i < this.fields.length; i++) {
            if (this.fields[i].name.equals(leaf)) { return i; }
        }
        return -1;
    }

    set_display_name(mut &this, name: DeclName) -> void { this.custom_display = name; }

    set_layout(mut &this, size: u64, align: u64) -> void {
        this.computed_size  = size;
        this.computed_align = align;
    }

    set_field_offset(mut &this, index: i64, offset: u64) -> void {
        this.fields[index].offset = offset;
    }

    display_name(&this) -> string {
        if (this.custom_display.is_valid()) { return this.intern_table.shown(this.custom_display); }
        return this.intern_table.shown(this.qualified_name);
    }
}


// EnumType: Discriminated union with variants

type struct EnumType {
    qualified_name: DeclName;
    declared_in:    ModulePath;
    intern_table:   InternTable*;
    variants:       [EnumVariantInfo];
    methods:        [MethodInfo];

    /// A specialization's display; the name of nothing on any other type.
    custom_display: DeclName;
    computed_size:  u64;
    computed_align: u64;
    /// Layout attributes copied from EnumDeclNode by TypeResolution.
    /// `repr_c` is currently a no-op marker reserved for full C-ABI ADT
    /// layout post-1.0; `min_alignment` is honoured by TypeLowering.
    repr_c:        boolean;
    min_alignment: u64;
    /// Explicit discriminant base type from `type enum Foo : i64 { ... }`,
    /// resolved by TypeResolution.  Invalid when omitted.  Drives the tag's
    /// LLVM width for SIMPLE (C-style) enums so an FFI enum round-trips
    /// through the declared C ABI width and large discriminants don't
    /// truncate; ADT enums keep an i32 tag (full ADT C-ABI is post-1.0).
    discriminant_type: TypeRef;
    /// See StructType.generic_base / type_args: the instantiation this concrete
    /// IS, carried intrinsically rather than via a side node.
    generic_base:      TypeRef;
    type_args:         [TypeRef];

    static new(qualified_name: SymbolStr, declared_in: ModulePath, intern_table: InternTable*) -> EnumType* {
        return new EnumType {
            qualified_name:    DeclName::of(qualified_name),
            declared_in:       declared_in,
            intern_table:      intern_table,
            variants:          [],
            methods:           [],
            custom_display:    DeclName::empty(),
            computed_size:     0,
            computed_align:    0,
            repr_c:            false,
            min_alignment:     0,
            discriminant_type: TypeRef::invalid(),
            generic_base:      TypeRef::invalid(),
            type_args:         [],
        };
    }

    /// See StructType::set_generic_origin - `args` is copied element-wise.
    set_generic_origin(mut &this, base: TypeRef, args: &[TypeRef]) -> void {
        this.generic_base = base;
        mut copied: [TypeRef] = [];
        for (mut i: i64 = 0; i < args.length; i++) { copied.push(args[i]); }
        this.type_args = copied;
    }

    set_repr_c(mut &this, c: boolean) -> void {
        this.repr_c = c;
    }

    set_discriminant_type(mut &this, ty: TypeRef) -> void {
        this.discriminant_type = ty;
    }

    set_min_alignment(mut &this, n: u64) -> void {
        this.min_alignment = n;
    }

    add_variant(mut &this, variant: EnumVariantInfo) -> void {
        this.variants.push(variant);
    }

    add_method(mut &this, method: MethodInfo) -> void {
        this.methods.push(method);
    }

    /// Whether all variants have no payload (simple C-style enum).
    is_simple_enum(&this) -> boolean {
        for (mut i: i64 = 0; i < this.variants.length; i++) {
            if (this.variants[i].has_payload()) {
                return false;
            }
        }
        return true;
    }

    /// `E::V` and a `V(..)` pattern name a variant
    /// of an enum the name layer bound; the variant is written as a leaf of
    /// that owner, so it is found here by the owner and the leaf.
    ///
    /// The ordinal of the variant named `name` in `variants`, or -1: the
    /// coordinate a node carries so a later stage reads `variants[i]` and
    /// searches nothing.
    variant_index(name: SymbolStr) -> i64 {
        for (mut i: i64 = 0; i < this.variants.length; i++) {
            if (this.variants[i].name.equals(name)) {
                return i;
            }
        }
        return -1;
    }

    set_display_name(mut &this, name: DeclName) -> void { this.custom_display = name; }

    set_layout(mut &this, size: u64, align: u64) -> void {
        this.computed_size  = size;
        this.computed_align = align;
    }

    display_name(&this) -> string {
        if (this.custom_display.is_valid()) { return this.intern_table.shown(this.custom_display); }
        return this.intern_table.shown(this.qualified_name);
    }
}


// TraitType: Interface definition with required methods

type struct TraitType {
    qualified_name:   DeclName;
    declared_in:      ModulePath;
    intern_table:     InternTable*;
    required_methods: [MethodInfo];
    /// Names of associated types declared in this trait (`type Item;`). Empty
    /// for traits without associated types. The concrete binding for each is
    /// per-impl (see ImplBlockNode's assoc bindings); a projection
    /// `X::<name>` resolves by looking up X's impl of this trait.
    assoc_type_names: [SymbolStr];

    static new(qualified_name: SymbolStr, declared_in: ModulePath, intern_table: InternTable*) -> TraitType* {
        return new TraitType {
            qualified_name:   DeclName::of(qualified_name),
            declared_in:      declared_in,
            intern_table:     intern_table,
            required_methods: [],
            assoc_type_names: [],
        };
    }

    add_required_method(method: MethodInfo) -> void {
        this.required_methods.push(method);
    }

    add_assoc_type(name: SymbolStr) -> void {
        this.assoc_type_names.push(name);
    }

    display_name(&this) -> string { return this.intern_table.shown(this.qualified_name); }
}


// TypeAliasType: Named alias for another type

type struct TypeAliasType {
    alias_name:   SymbolStr;
    intern_table: InternTable*;
    target:       TypeRef;
    is_generic:   boolean;

    computed_size:  u64;
    computed_align: u64;

    static new(alias_name: SymbolStr, intern_table: InternTable*, target: TypeRef) -> TypeAliasType* {
        return new TypeAliasType {
            alias_name:     alias_name,
            intern_table:   intern_table,
            target:         target,
            is_generic:     false,
            computed_size:  0,
            computed_align: 0,
        };
    }

    has_target(&this) -> boolean {
        return this.target.is_valid();
    }

    set_target(target: TypeRef) -> void {
        this.target = target;
    }

    display_name(&this) -> string { return this.intern_table.resolve(this.alias_name); }

    set_layout(mut &this, size: u64, align: u64) -> void {
        this.computed_size  = size;
        this.computed_align = align;
    }
}


// FunctionTemplateType: Placeholder for generic function templates
//
// Generic functions (e.g., `identity<T>`) have no arena type of their own,
// but the GenericRegistry needs a stable TypeID to track instantiations and
// build cache keys.
//
// FunctionTemplateType is a lightweight sentinel that occupies an arena slot
// solely for ID generation.  It has no fields, methods, or layout.

type struct FunctionTemplateType {
    qualified_name: DeclName;
    intern_table:   InternTable*;

    static new(qualified_name: SymbolStr, intern_table: InternTable*) -> FunctionTemplateType* {
        return new FunctionTemplateType {
            qualified_name: DeclName::of(qualified_name),
            intern_table:   intern_table,
        };
    }

    display_name(&this) -> string { return this.intern_table.shown(this.qualified_name); }
}
