///! TypeArena
///!
///! The single owner of all Type objects.  Manages allocation, deduplication,
///! and singleton primitives.  All types are created through the arena's factory
///! methods, which return TypeRef handles.
///!
///! Design note: User-defined type caches are keyed by qualified name only
///! (not module_id::name) so cross-module references dedup against the
///! same arena entry; keying on module-prefixed names produces phantom
///! duplicate types at every import site.

namespace Compiler::Types::Arena;

import Compiler::Diag;
import Compiler::Diag::SourceSpan;
import Compiler::Types;
import Compiler::Types::{ TypeRef, Type, Compound, UserDefined, Generic };
import Compiler::Resolver::{ SymbolStr, InternTable, QualifiedName };
import Utils::Logger;
import std::core::option;
import std::collections::hashmap;


/// One entry in the canonical structural interner (a hash-cons table).
///
/// The entry owns an IMMUTABLE copy of the key it was interned under: `kind`,
/// the scalar discriminators `aux0`/`aux1`, and its operand type ids, which
/// live in the arena's flat `intern_ops` pool at
/// `[ops_start, ops_start + ops_len)`.
///
/// Keeping the key here - rather than reading it back off `ty`'s node - is the
/// whole point.  Type nodes are MUTATED IN PLACE by design
/// (`swap_wrapper_to_concrete` replaces an `InstantiatedType` with a concrete
/// aggregate at the same id; `populate_concrete_type` fills fields later).  An
/// interner that re-derived its key from the node would stop recognising an
/// entry the moment the node changed, probe past it, and mint a SECOND id for
/// a type that already exists - measurably breaking `a.id == b.id` for one
/// semantic type.  Storing the key makes identity independent of every
/// subsequent mutation.
///
/// All fields are Copy (`TypeRef` is a handle), so entries are freely copied
/// and no owning buffer is aliased.
type struct InternEntry {
    kind:      TypeKind;
    aux0:      u64;
    aux1:      u64;
    ops_start: i64;
    ops_len:   i64;
    ty:        TypeRef;
}

type struct TypeArena {
    // -- Ownership --
    types:   Type*[];           // All types (indexed by allocation order)
    next_id: u64;               // Monotonic counter (starts at 1; 0 = invalid)
    // True for the duration of a symbolic generic-body walk (sema sets it around
    // `symbolic_check_body`). While set, `create_instantiation` tags every new
    // InstantiatedType `is_symbolic`, so concrete instantiations that exist only
    // inside a never-instantiated template (resolved by the walk but never
    // monomorphized) are excluded from GenericValidation's E0900 check. The
    // GenericRegistry also consults it to keep walk instantiations demand-free.
    symbolic_no_demand_active: boolean;

    // -- Interned string table (borrowed from CompilationContext) --
    intern_table: InternTable*;

    // -- Primitive singletons --
    void_type:   TypeRef;
    unit_type:   TypeRef;
    bool_type:   TypeRef;
    char_type:   TypeRef;
    string_type: TypeRef;
    never_type:  TypeRef;
    va_list_type: TypeRef;

    i8_type:   TypeRef;
    i16_type:  TypeRef;
    i32_type:  TypeRef;
    i64_type:  TypeRef;
    i128_type: TypeRef;
    u8_type:   TypeRef;
    u16_type:  TypeRef;
    u32_type:  TypeRef;
    u64_type:  TypeRef;
    u128_type: TypeRef;
    isize_type: TypeRef;
    usize_type: TypeRef;
    f32_type:  TypeRef;
    f64_type:  TypeRef;

    // -- Canonical structural interner ------------------------------------
    //
    // ONE dedup path for every structurally-identified compound type: Pointer,
    // Reference, Array, Optional, Function, Tuple, AssocProjection and
    // InstantiatedType.  Identity is exactly `(kind, aux0, aux1, operand ids)`,
    // and `entry_matches` is the single formal authority on what that means.
    // It replaces eight ad-hoc `format()`-built string keys, so there is now one
    // definition of "same type" rather than one per constructor.
    //
    // A hash-cons table: `intern_cache` maps a 64-bit structural hash (linear
    // probed) to an index into `intern_entries`, each of which holds an
    // immutable copy of its key, with operands in the flat `intern_ops` pool.
    // A hit is confirmed by EXACT comparison against that stored key, so
    // identity never depends on hash quality NOR on the current state of the
    // type's node - see `InternEntry`.  No key is materialized as a string: no
    // per-lookup allocation and no string hashing on these hot paths.
    //
    // Deliberately NOT used for:
    //   * nominal types (Struct/Class/Enum/Trait/Alias) - keyed by qualified
    //     name; see the file header on why module-prefixed keys are wrong.
    //   * GenericParam / BoundedParam - keyed by NAME ONLY, dropping `index`
    //     and `bounds`.  That is a correctness fix, not an oversight: see
    //     `create_generic_param`.  Re-including them here would regress it.
    intern_entries: InternEntry[];
    intern_ops:     TypeRef[];          // flat operand pool, sliced by InternEntry
    intern_cache:   HashMap<u64, i64>;  // structural hash (probed) -> intern_entries index

    // -- User-defined type caches (SymbolStr.id -> TypeRef) --
    struct_cache: HashMap<u32, TypeRef>;
    class_cache:  HashMap<u32, TypeRef>;
    enum_cache:   HashMap<u32, TypeRef>;
    trait_cache:  HashMap<u32, TypeRef>;
    alias_cache:  HashMap<u32, TypeRef>;

    // -- Function template placeholder cache (SymbolStr.id -> TypeRef) --
    func_template_cache: HashMap<u32, TypeRef>;

    // -- Generic parameter dedup cache (key: (name.id << 32) | index -> TypeRef) --
    // Integer key is a perf choice (no format()/string-hash per lookup), NOT a
    // correctness one: `HashMap<string, V>` deduplicates by CONTENT today (see
    // `Hash`/`Eq for string`; verified empirically).  An older comment claiming
    // raw `string` equality is pointer-compare was stale (pre-`Eq for string`).
    generic_param_cache:   HashMap<u64, TypeRef>;
    bounded_param_cache:   HashMap<u64, TypeRef>;

    // -- Reverse index: bare leaf name -> qualified name --
    // Populated by create_struct/class/enum/trait/alias.
    // Used by TypeResolver as a clean O(1) fallback for cross-module
    // type references that can't be resolved through the scope chain.
    leaf_index: HashMap<u32, u32>;   // bare SymbolStr.id -> qualified SymbolStr.id



    /// Create a new TypeArena and initialize all 20 primitive singletons.
    static new(intern_table: InternTable*) -> TypeArena {
        mut arena: TypeArena = TypeArena {
            types:   [],
            next_id: 1,
            symbolic_no_demand_active: false,
            intern_table: intern_table,

            void_type:   TypeRef::invalid(),
            unit_type:   TypeRef::invalid(),
            bool_type:   TypeRef::invalid(),
            char_type:   TypeRef::invalid(),
            string_type: TypeRef::invalid(),
            never_type:  TypeRef::invalid(),
            va_list_type: TypeRef::invalid(),

            i8_type:   TypeRef::invalid(),
            i16_type:  TypeRef::invalid(),
            i32_type:  TypeRef::invalid(),
            i64_type:  TypeRef::invalid(),
            i128_type: TypeRef::invalid(),
            u8_type:   TypeRef::invalid(),
            u16_type:  TypeRef::invalid(),
            u32_type:  TypeRef::invalid(),
            u64_type:  TypeRef::invalid(),
            u128_type: TypeRef::invalid(),
            isize_type: TypeRef::invalid(),
            usize_type: TypeRef::invalid(),
            f32_type:  TypeRef::invalid(),
            f64_type:  TypeRef::invalid(),

            intern_entries:      [],
            intern_ops:          [],
            intern_cache:        HashMap<u64, i64>::new(),
            struct_cache:        HashMap<u32, TypeRef>::new(),
            class_cache:         HashMap<u32, TypeRef>::new(),
            enum_cache:          HashMap<u32, TypeRef>::new(),
            trait_cache:         HashMap<u32, TypeRef>::new(),
            alias_cache:         HashMap<u32, TypeRef>::new(),
            func_template_cache: HashMap<u32, TypeRef>::new(),
            generic_param_cache: HashMap<u64, TypeRef>::new(),
            bounded_param_cache: HashMap<u64, TypeRef>::new(),
            leaf_index:          HashMap<u32, u32>::new(),
        };

        arena.init_primitives();
        return arena;
    }


    // Internal: primitive initialization

    init_primitives(mut &this) -> void {
        this.void_type   = this.alloc_type(new VoidType(this.next_id));
        this.unit_type   = this.alloc_type(new UnitType(this.next_id));
        this.bool_type   = this.alloc_type(new BoolType(this.next_id));
        this.char_type   = this.alloc_type(new CharType(this.next_id));
        this.string_type = this.alloc_type(new StringType(this.next_id));
        this.never_type  = this.alloc_type(new NeverType(this.next_id));
        this.va_list_type = this.alloc_type(new VaListType(this.next_id));

        this.i8_type   = this.alloc_type(new IntType(this.next_id, IntegerKind::I8));
        this.i16_type  = this.alloc_type(new IntType(this.next_id, IntegerKind::I16));
        this.i32_type  = this.alloc_type(new IntType(this.next_id, IntegerKind::I32));
        this.i64_type  = this.alloc_type(new IntType(this.next_id, IntegerKind::I64));
        this.i128_type = this.alloc_type(new IntType(this.next_id, IntegerKind::I128));
        this.u8_type   = this.alloc_type(new IntType(this.next_id, IntegerKind::U8));
        this.u16_type  = this.alloc_type(new IntType(this.next_id, IntegerKind::U16));
        this.u32_type  = this.alloc_type(new IntType(this.next_id, IntegerKind::U32));
        this.u64_type  = this.alloc_type(new IntType(this.next_id, IntegerKind::U64));
        this.u128_type = this.alloc_type(new IntType(this.next_id, IntegerKind::U128));
        this.isize_type = this.alloc_type(new IntType(this.next_id, IntegerKind::Isize));
        this.usize_type = this.alloc_type(new IntType(this.next_id, IntegerKind::Usize));
        this.f32_type  = this.alloc_type(new FloatType(this.next_id, FloatKind::F32));
        this.f64_type  = this.alloc_type(new FloatType(this.next_id, FloatKind::F64));
    }

    /// Allocate a type, assign it an ID, store it, and return a TypeRef.
    alloc_type(mut &this, ty: Type*) -> TypeRef {
        mut id: u64 = this.next_id;
        ty.id = id;
        this.next_id += 1;
        this.types.push(ty);
        return TypeRef::new(id, this);
    }


    // Primitive getters

    get_void(&this) -> TypeRef   { return this.void_type; }
    get_unit(&this) -> TypeRef   { return this.unit_type; }
    get_bool(&this) -> TypeRef   { return this.bool_type; }
    get_char(&this) -> TypeRef   { return this.char_type; }
    get_string(&this) -> TypeRef { return this.string_type; }
    get_never(&this) -> TypeRef  { return this.never_type; }
    get_va_list(&this) -> TypeRef { return this.va_list_type; }

    get_i8(&this) -> TypeRef   { return this.i8_type; }
    get_i16(&this) -> TypeRef  { return this.i16_type; }
    get_i32(&this) -> TypeRef  { return this.i32_type; }
    get_i64(&this) -> TypeRef  { return this.i64_type; }
    get_i128(&this) -> TypeRef { return this.i128_type; }
    get_u8(&this) -> TypeRef   { return this.u8_type; }
    get_u16(&this) -> TypeRef  { return this.u16_type; }
    get_u32(&this) -> TypeRef  { return this.u32_type; }
    get_u64(&this) -> TypeRef  { return this.u64_type; }
    get_u128(&this) -> TypeRef { return this.u128_type; }
    get_isize(&this) -> TypeRef { return this.isize_type; }
    get_usize(&this) -> TypeRef { return this.usize_type; }
    get_f32(&this) -> TypeRef  { return this.f32_type; }
    get_f64(&this) -> TypeRef  { return this.f64_type; }

    /// Look up an integer type by IntegerKind.
    get_int(mut &this, int_kind: IntegerKind) -> TypeRef {
        return match (int_kind) {
            IntegerKind::I8   => { this.i8_type   }
            IntegerKind::I16  => { this.i16_type  }
            IntegerKind::I32  => { this.i32_type  }
            IntegerKind::I64  => { this.i64_type  }
            IntegerKind::I128 => { this.i128_type }
            IntegerKind::U8   => { this.u8_type   }
            IntegerKind::U16  => { this.u16_type  }
            IntegerKind::U32  => { this.u32_type  }
            IntegerKind::U64  => { this.u64_type  }
            IntegerKind::U128 => { this.u128_type }
            IntegerKind::Isize => { this.isize_type }
            IntegerKind::Usize => { this.usize_type }
        };
    }

    /// Look up a float type by FloatKind.
    get_float(mut &this, float_kind: FloatKind) -> TypeRef {
        return match (float_kind) {
            FloatKind::F32 => { this.f32_type }
            FloatKind::F64 => { this.f64_type }
        };
    }


    // -- Canonical structural interning ------------------------------------
    //
    // Every structurally-identified compound type is created through exactly
    // one shape:
    //
    //     const hit: TypeRef = this.intern_find(KIND, aux0, aux1, &ops);
    //     if (hit.is_valid()) { return hit; }
    //     const ref: TypeRef = this.alloc_type(new ...);
    //     this.intern_record(KIND, aux0, aux1, &ops, ref);
    //
    // `ops` carries the operand types in a fixed per-kind order; `aux0`/`aux1`
    // carry the scalar discriminators (constness, mutability, array size,
    // variadic-ness, projection member/trait).  Nothing else participates in
    // identity.

    /// Mix one 64-bit value into a structural hash (FNV-1a over its bytes).
    hash_mix(&this, acc: u64, v: u64) -> u64 {
        mut h: u64 = acc;
        mut x: u64 = v;
        for (mut i: i64 = 0; i < 8; i++) {
            h = (h ^ (x & 255)) * 1099511628211;
            x = x >> 8;
        }
        return h;
    }

    /// Structural hash of a canonical type key.  Only ever a bucket selector -
    /// `entry_matches` decides identity, so a poor hash costs probes, never
    /// correctness.  The operand COUNT is mixed in so that `(a)` and `(a, a)`
    /// cannot land on the same key by accident.
    structural_hash(&this, kind: TypeKind, aux0: u64, aux1: u64, ops: &TypeRef[]) -> u64 {
        mut h: u64 = 2166136261;
        h = this.hash_mix(h, kind as u64);
        h = this.hash_mix(h, aux0);
        h = this.hash_mix(h, aux1);
        for (mut i: i64 = 0; i < ops.length; i++) {
            h = this.hash_mix(h, ops[i].id);
        }
        return this.hash_mix(h, ops.length as u64);
    }

    /// Exact comparison of a stored entry against a canonical key.
    ///
    /// THE authority on structural type identity.  Compares ONLY the entry's
    /// own immutable copy of the key - it never looks at `ty`'s node.  That is
    /// what makes identity stable across in-place node mutation
    /// (`swap_wrapper_to_concrete`, `populate_concrete_type`); see
    /// `InternEntry`.  It also means derived data such as `computed_size` /
    /// `computed_align`, filled in later by TypeLowering, can never split one
    /// semantic type into two.
    entry_matches(&this, idx: i64, kind: TypeKind, aux0: u64, aux1: u64,
                  ops: &TypeRef[]) -> boolean {
        if (idx < 0 || idx >= this.intern_entries.length) { return false; }
        if (this.intern_entries[idx].kind != kind) { return false; }
        if (this.intern_entries[idx].aux0 != aux0) { return false; }
        if (this.intern_entries[idx].aux1 != aux1) { return false; }
        if (this.intern_entries[idx].ops_len != ops.length) { return false; }
        const base_off: i64 = this.intern_entries[idx].ops_start;
        for (mut i: i64 = 0; i < ops.length; i++) {
            if (this.intern_ops[base_off + i].id != ops[i].id) { return false; }
        }
        return true;
    }

    /// The interned type for this canonical key, or invalid when absent.
    ///
    /// Linear probing over the hash keyspace.
    intern_find(&this, kind: TypeKind, aux0: u64, aux1: u64, ops: &TypeRef[]) -> TypeRef {
        mut k: u64 = this.structural_hash(kind, aux0, aux1, ops);
        // Terminates: the map holds finitely many keys, so probing distinct
        // successive keys reaches an absent one in at most `count + 1` steps.
        while (true) {
            const slot: Option<i64> = this.intern_cache.get(&k);
            if (slot.is_none()) { return TypeRef::invalid(); }
            const idx: i64 = slot.unwrap();
            if (this.entry_matches(idx, kind, aux0, aux1, ops)) {
                return this.intern_entries[idx].ty;
            }
            k += 1;
        }
        return TypeRef::invalid();
    }

    /// Re-look-up entry `idx` using its OWN stored key.
    /// Used by `verify_canonical_identity`; see there for why.
    intern_find_entry_key(&this, idx: i64) -> TypeRef {
        if (idx < 0 || idx >= this.intern_entries.length) { return TypeRef::invalid(); }
        mut ops: TypeRef[] = [];
        const s: i64 = this.intern_entries[idx].ops_start;
        for (mut i: i64 = 0; i < this.intern_entries[idx].ops_len; i++) {
            ops.push(this.intern_ops[s + i]);
        }
        return this.intern_find(this.intern_entries[idx].kind,
                                this.intern_entries[idx].aux0,
                                this.intern_entries[idx].aux1, &ops);
    }

    /// D1 SELF-CHECK: canonical type identity.
    ///
    /// Asserts the property the whole interner exists to provide - for any two
    /// `TypeRef`s denoting the same semantic type, `a.id == b.id` - by checking
    /// that every interned entry is still reachable BY ITS OWN KEY and resolves
    /// to itself.  Returns the number of violations; 0 means identity is
    /// canonical.
    ///
    /// A violation means two entries share one key while denoting different
    /// types, i.e. identity forked.  That is exactly the defect an earlier
    /// version of this interner had: it re-derived each key from the type's
    /// NODE, so once a node was mutated in place (`swap_wrapper_to_concrete`)
    /// its entry stopped matching, `intern_find` probed past it, and a SECOND
    /// id was minted for a type that already existed.  Measured on a 12-line
    /// program, three keys had forked into two ids each.  The suite still
    /// passed, because the GenericRegistry's independent string key silently
    /// compensated - which is why this check exists rather than relying on
    /// tests to notice.
    ///
    /// O(n) lookups over the table; call it from diagnostics, not per-compile.
    verify_canonical_identity(&this) -> i64 {
        mut violations: i64 = 0;
        for (mut i: i64 = 0; i < this.intern_entries.length; i++) {
            const found: TypeRef = this.intern_find_entry_key(i);
            if (found.id != this.intern_entries[i].ty.id) { violations += 1; }
        }
        return violations;
    }

    /// Record `ty` under this canonical key, copying the key into the table.
    /// Must follow a failed `intern_find` with the SAME key, so the probe
    /// lands on the first free slot of that key's chain.
    intern_record(mut &this, kind: TypeKind, aux0: u64, aux1: u64,
                  ops: &TypeRef[], ty: TypeRef) -> void {
        mut k: u64 = this.structural_hash(kind, aux0, aux1, ops);
        while (true) {
            const slot: Option<i64> = this.intern_cache.get(&k);
            if (slot.is_none()) {
                const start: i64 = this.intern_ops.length;
                for (mut i: i64 = 0; i < ops.length; i++) {
                    this.intern_ops.push(ops[i]);
                }
                const idx: i64 = this.intern_entries.length;
                this.intern_entries.push(InternEntry {
                    kind:      kind,
                    aux0:      aux0,
                    aux1:      aux1,
                    ops_start: start,
                    ops_len:   ops.length,
                    ty:        ty,
                });
                this.intern_cache.insert(k, idx);
                return;
            }
            k += 1;
        }
    }


    // Compound type factories (deduplicated)

    /// Get or create a (non-const) pointer type to the given pointee.
    get_pointer_to(mut &this, pointee: TypeRef) -> TypeRef {
        return this.get_pointer_to_q(pointee, false);
    }

    /// Get or create a pointer type to the given pointee, distinguishing
    /// `const T*` from `T*`. The two are separate interned types (so the
    /// checker can forbid dropping const) but mangle and lower identically.
    get_pointer_to_q(mut &this, pointee: TypeRef, const_pointee: boolean) -> TypeRef {
        mut ops: TypeRef[] = [pointee];
        mut aux: u64 = 0;
        if (const_pointee) { aux = 1; }

        const hit: TypeRef = this.intern_find(TypeKind::Pointer, aux, 0, &ops);
        if (hit.is_valid()) { return hit; }

        const ref: TypeRef = this.alloc_type(new PointerType(this.next_id, pointee, const_pointee));
        this.intern_record(TypeKind::Pointer, aux, 0, &ops, ref);
        return ref;
    }

    /// Get or create a reference type to the given referent.
    get_reference_to(mut &this, referent: TypeRef, mutability: RefMutability) -> TypeRef {
        mut ops: TypeRef[] = [referent];
        mut aux: u64 = 0;
        if (mutability.is_mutable()) { aux = 1; }

        const hit: TypeRef = this.intern_find(TypeKind::Reference, aux, 0, &ops);
        if (hit.is_valid()) { return hit; }

        const ref: TypeRef = this.alloc_type(new ReferenceType(this.next_id, referent, mutability));
        this.intern_record(TypeKind::Reference, aux, 0, &ops, ref);
        return ref;
    }

    /// Get or create an array type with the given element type and size.
    /// `size` goes into the key as its raw two's-complement bits, so `-1`
    /// (dynamic) and `0` (fixed zero-length) stay distinct without the old
    /// `+1` offset - and without its 32-bit element-id / 31-bit size ceiling.
    get_array_of(mut &this, element: TypeRef, size: i64) -> TypeRef {
        mut ops: TypeRef[] = [element];
        const aux: u64 = size as u64;

        const hit: TypeRef = this.intern_find(TypeKind::Array, aux, 0, &ops);
        if (hit.is_valid()) { return hit; }

        const ref: TypeRef = this.alloc_type(new ArrayType(this.next_id, element, size));
        this.intern_record(TypeKind::Array, aux, 0, &ops, ref);
        return ref;
    }

    /// Get or create an optional type wrapping the given type.
    get_optional_of(mut &this, wrapped: TypeRef) -> TypeRef {
        mut ops: TypeRef[] = [wrapped];

        const hit: TypeRef = this.intern_find(TypeKind::Optional, 0, 0, &ops);
        if (hit.is_valid()) { return hit; }

        const ref: TypeRef = this.alloc_type(new OptionalType(this.next_id, wrapped));
        this.intern_record(TypeKind::Optional, 0, 0, &ops, ref);
        return ref;
    }

    /// Get or create a function type.
    // `params` is borrowed: get_function only reads element ids to build the
    // cache key, so callers keep ownership (and can reuse the array for a
    // MethodInfo or drop it).  On the cache-miss path the array is copied into
    // the owning FunctionType (TypeRef is Copy, so this is a cheap shallow copy).
    get_function(mut &this, ret: TypeRef, params: &TypeRef[], is_variadic: boolean) -> TypeRef {
        LOG_DEBUG(LogComponent::TypeChecker, "[TypeArena] get_function() ret=%lu params=%lld", ret.id, params.length);
        // ops[0] = return type, ops[1..] = parameters.
        mut ops: TypeRef[] = [ret];
        for (mut i: i64 = 0; i < params.length; i++) {
            ops.push(params[i]);
        }
        mut aux: u64 = 0;
        if (is_variadic) { aux = 1; }

        const hit: TypeRef = this.intern_find(TypeKind::Function, aux, 0, &ops);
        if (hit.is_valid()) { return hit; }

        mut params_owned: TypeRef[] = [];
        for (mut i: i64 = 0; i < params.length; i++) {
            params_owned.push(params[i]);
        }
        const ref: TypeRef = this.alloc_type(new FunctionType(this.next_id, ret, params_owned, is_variadic));
        this.intern_record(TypeKind::Function, aux, 0, &ops, ref);
        return ref;
    }

    /// Get or create a tuple type.
    get_tuple(mut &this, elements: TypeRef[]) -> TypeRef {
        // `elements` is MOVED into the TupleType below, so snapshot the operand
        // ids into an independent buffer first - `ops` must stay readable for
        // `intern_record` after the move.
        mut ops: TypeRef[] = [];
        for (mut i: i64 = 0; i < elements.length; i++) {
            ops.push(elements[i]);
        }

        const hit: TypeRef = this.intern_find(TypeKind::Tuple, 0, 0, &ops);
        if (hit.is_valid()) { return hit; }

        const ref: TypeRef = this.alloc_type(new TupleType(this.next_id, elements));
        this.intern_record(TypeKind::Tuple, 0, 0, &ops, ref);
        return ref;
    }


    // User-defined type factories (deduplicated by qualified name)

    /// Create or retrieve a struct type by qualified name.
    create_struct(mut &this, qualified_name: SymbolStr, module_name: SymbolStr) -> TypeRef {
        LOG_DEBUG(LogComponent::TypeChecker, "[TypeArena] create_struct() name='%s'",
            this.intern_table.resolve(qualified_name));

        const cached: Option<TypeRef> = this.struct_cache.get(&qualified_name.id);
        if (cached.is_some()) { return cached.unwrap(); }

        mut ref: TypeRef = this.alloc_type(new StructType(this.next_id, qualified_name, module_name, this.intern_table));
        this.struct_cache.insert(qualified_name.id, ref);
        this.register_leaf_name(qualified_name);
        return ref;
    }

    /// Create or retrieve a union type by qualified name.  A union is a
    /// StructType with `is_union = true`; the struct machinery (field lookup,
    /// member resolution, generics) is shared, and the flag drives the
    /// divergent layout / LLVM lowering / drop behaviour.
    create_union(mut &this, qualified_name: SymbolStr, module_name: SymbolStr) -> TypeRef {
        const ref: TypeRef = this.create_struct(qualified_name, module_name);
        const t: Type* = this.lookup(ref.id);
        if (t != null) {
            const st: StructType* = t as StructType*;
            st.set_union(true);
        }
        return ref;
    }

    /// Create or retrieve a class type by qualified name.
    create_class(mut &this, qualified_name: SymbolStr, module_name: SymbolStr) -> TypeRef {
        LOG_DEBUG(LogComponent::TypeChecker, "[TypeArena] create_class() name='%s'", this.intern_table.resolve(qualified_name));

        const cached: Option<TypeRef> = this.class_cache.get(&qualified_name.id);
        if (cached.is_some()) { return cached.unwrap(); }

        mut ref: TypeRef = this.alloc_type(new ClassType(this.next_id, qualified_name, module_name, this.intern_table));
        this.class_cache.insert(qualified_name.id, ref);
        this.register_leaf_name(qualified_name);
        return ref;
    }

    /// Create or retrieve an enum type by qualified name.
    create_enum(mut &this, qualified_name: SymbolStr, module_name: SymbolStr) -> TypeRef {
        LOG_DEBUG(LogComponent::TypeChecker, "[TypeArena] create_enum() name='%s'", this.intern_table.resolve(qualified_name));

        const cached: Option<TypeRef> = this.enum_cache.get(&qualified_name.id);
        if (cached.is_some()) { return cached.unwrap(); }

        mut ref: TypeRef = this.alloc_type(new EnumType(this.next_id, qualified_name, module_name, this.intern_table));
        this.enum_cache.insert(qualified_name.id, ref);
        this.register_leaf_name(qualified_name);
        return ref;
    }

    /// Create or retrieve a trait type by qualified name.
    create_trait(mut &this, qualified_name: SymbolStr, module_name: SymbolStr) -> TypeRef {

        const cached: Option<TypeRef> = this.trait_cache.get(&qualified_name.id);
        if (cached.is_some()) { return cached.unwrap(); }

        mut ref: TypeRef = this.alloc_type(new TraitType(this.next_id, qualified_name, module_name, this.intern_table));
        this.trait_cache.insert(qualified_name.id, ref);
        this.register_leaf_name(qualified_name);
        return ref;
    }

    /// Create or retrieve a type alias.
    create_type_alias(mut &this, alias_name: SymbolStr, target: TypeRef) -> TypeRef {

        const cached: Option<TypeRef> = this.alias_cache.get(&alias_name.id);
        if (cached.is_some()) { return cached.unwrap(); }

        mut ref: TypeRef = this.alloc_type(new TypeAliasType(this.next_id, alias_name, this.intern_table, target));
        this.alias_cache.insert(alias_name.id, ref);
        this.register_leaf_name(alias_name);
        return ref;
    }


    /// Create or retrieve a function template placeholder by qualified name.
    /// Used to give generic functions a stable TypeID for GenericRegistry
    /// cache keys and instantiation tracking, without polluting the struct cache.
    create_function_template(mut &this, qualified_name: SymbolStr) -> TypeRef {

        const cached: Option<TypeRef> = this.func_template_cache.get(&qualified_name.id);
        if (cached.is_some()) { return cached.unwrap(); }

        mut ref: TypeRef = this.alloc_type(new FunctionTemplateType(this.next_id, qualified_name, this.intern_table));
        this.func_template_cache.insert(qualified_name.id, ref);
        return ref;
    }


    // Generic type factories (deduplicated by name + index)

    /// Get or create a generic parameter type, deduplicated by NAME so a given
    /// logical param (e.g. `T`) is ONE canonical TypeID no matter which sema
    /// entry point mints it.  Several paths assign a different positional
    /// `index` to the same param (most visibly a generic enum's method resolving
    /// the enclosing `T` through a fresh scope), which under an (name, index) key
    /// produced distinct TypeIDs.  That mattered because substitution keys by
    /// param TypeID (`TypeSubstitution::from_params`): a divergent-index copy was
    /// absent from the map and stayed abstract, forcing the checker's name-only
    /// structural fallback and the canonicalization mechanisms downstream.  Keying
    /// by name collapses them and matches that long-standing name-only equality.
    /// `param_index` is still stored (first creation wins) but only feeds
    /// `display_name` (`T%lu`); the mangler encodes GenericParam by `param_name`
    /// alone, so first-index-wins is display-only and never perturbs emitted
    /// symbols.  (Within any one template, param names are unique, so nothing
    /// relies on two same-name params having distinct ids.)
    create_generic_param(mut &this, name: SymbolStr, index: u64) -> TypeRef {
        const key: u64 = name.id as u64;

        const cached: Option<TypeRef> = this.generic_param_cache.get(&key);
        if (cached.is_some()) { return cached.unwrap(); }

        mut ref: TypeRef = this.alloc_type(new GenericParamType(this.next_id, name, index));
        this.generic_param_cache.insert(key, ref);
        return ref;
    }

    /// Get or create a bounded generic parameter type, deduplicated by NAME
    /// (see `create_generic_param` for why leaves are name-canonical).  The
    /// bounds and `param_index` from the FIRST creation win; the checker already
    /// compares BoundedParams by name alone, so this is consistent.
    create_bounded_param(mut &this, name: SymbolStr, index: u64, bounds: TypeRef[]) -> TypeRef {
        const key: u64 = name.id as u64;

        const cached: Option<TypeRef> = this.bounded_param_cache.get(&key);
        if (cached.is_some()) { return cached.unwrap(); }

        mut ref: TypeRef = this.alloc_type(new BoundedParamType(this.next_id, name, index, bounds));
        this.bounded_param_cache.insert(key, ref);
        return ref;
    }

    /// Get or create a symbolic associated-type projection `Base::Member`.
    /// Deduplicated by (base.id, member.id, owning_trait.id) so the same
    /// projection always shares one arena slot - important so the
    /// monomorphizer's `set_resolved_type` reaches every reference.
    create_assoc_projection(mut &this, base: TypeRef, member: SymbolStr, owning_trait: TypeRef) -> TypeRef {
        mut ops: TypeRef[] = [base];
        const aux0: u64 = member.id as u64;
        const aux1: u64 = owning_trait.id;

        const hit: TypeRef = this.intern_find(TypeKind::AssocProjection, aux0, aux1, &ops);
        if (hit.is_valid()) { return hit; }

        const ref: TypeRef = this.alloc_type(
            new AssocProjectionType(this.next_id, base, member, owning_trait));
        this.intern_record(TypeKind::AssocProjection, aux0, aux1, &ops, ref);
        return ref;
    }

    /// Enter/leave walk-scoped symbolic mode (see `symbolic_no_demand_active`).
    set_symbolic_no_demand(mut &this, on: boolean) -> void {
        this.symbolic_no_demand_active = on;
    }

    /// Create a generic type instantiation.  Deduplicates by
    /// (generic_base, type_args) so that the same (base, args) tuple
    /// always returns the same arena slot, regardless of whether the
    /// caller is GenericRegistry.instantiate (which has its own cache)
    /// or the substituter's apply_instantiation (which creates
    /// InstantiatedTypes directly during template body rewrites).
    /// Sharing the arena slot means `set_resolved_type` done by the
    /// monomorphizer for one caller automatically satisfies the other.
    // `args` is borrowed (read for the cache key); on the cache-miss path it
    // is copied into the owning InstantiatedType (TypeRef is Copy).  Callers
    // keep ownership and can reuse the array for demand tracking.
    create_instantiation(mut &this, base: TypeRef, args: &TypeRef[]) -> TypeRef {
        // ops[0] = generic base, ops[1..] = type arguments.
        mut ops: TypeRef[] = [base];
        for (mut i: i64 = 0; i < args.length; i++) {
            ops.push(args[i]);
        }

        const hit: TypeRef = this.intern_find(TypeKind::InstantiatedType, 0, 0, &ops);
        if (hit.is_valid()) { return hit; }

        mut args_owned: TypeRef[] = [];
        for (mut i: i64 = 0; i < args.length; i++) {
            args_owned.push(args[i]);
        }
        mut inst_node: InstantiatedType* = new InstantiatedType(this.next_id, base, args_owned);
        // Tag instantiations minted during a symbolic walk so GenericValidation
        // skips them (they may be concrete instantiations living only inside a
        // never-instantiated template and are never monomorphized/codegen'd).
        if (this.symbolic_no_demand_active) { inst_node.is_symbolic = true; }
        const ref: TypeRef = this.alloc_type(inst_node);
        this.intern_record(TypeKind::InstantiatedType, 0, 0, &ops, ref);
        return ref;
    }

    /// The SIGNATURE of a function-template instantiation: the interned
    /// `FunctionType` for `inst_ref`'s specialization, or invalid if `inst_ref`
    /// is not an instantiation or has no signature filled in yet.
    ///
    /// This is the checked read half of `InstantiatedType::set_signature` (see
    /// the long note there on why a function wrapper and its FunctionType are
    /// two DIFFERENT semantic types rather than an unfinished single-id case).
    /// It verifies the slot really holds a `Function`, so a caller that means
    /// "give me the signature" cannot silently receive a collapsed aggregate
    /// concrete - the exact confusion the shared `resolved_type` field invites.
    instantiation_signature(&this, inst_ref: TypeRef) -> TypeRef {
        const t: Type* = this.lookup(inst_ref.id);
        if (t == null || t.kind != TypeKind::InstantiatedType) { return TypeRef::invalid(); }
        const inst: InstantiatedType* = t as InstantiatedType*;
        if (!inst.has_signature()) { return TypeRef::invalid(); }
        const sig: Type* = this.lookup(inst.signature_of().id);
        if (sig == null || sig.kind != TypeKind::Function) { return TypeRef::invalid(); }
        return inst.signature_of();
    }

    /// The canonical instantiation for (base, args) if one already exists,
    /// else invalid.  A PURE lookup: unlike `create_instantiation` it never
    /// mints a type, so callers that only need the identity KEY (registry
    /// bookkeeping, mono tracking) cannot perturb the arena by asking.
    find_instantiation(&this, base: TypeRef, args: &TypeRef[]) -> TypeRef {
        mut ops: TypeRef[] = [base];
        for (mut i: i64 = 0; i < args.length; i++) {
            ops.push(args[i]);
        }
        return this.intern_find(TypeKind::InstantiatedType, 0, 0, &ops);
    }

    /// Create an error type for type resolution failures.
    create_error(mut &this, reason: string, span: SourceSpan) -> TypeRef {
        return this.alloc_type(new ErrorType(this.next_id, reason, span));
    }


    /// If `id` resolves to a Pointer Type in this arena, return its
    /// pointee TypeRef; otherwise return TypeRef::invalid().  Convenience
    /// for callers in modules where `Type` / `PointerType` aren't already
    /// in scope (e.g. AST/substituter).
    pointer_pointee_of(&this, id: u64) -> TypeRef {
        const t: Type* = this.lookup(id);
        if (t == null) { return TypeRef::invalid(); }
        if (t.kind != TypeKind::Pointer) { return TypeRef::invalid(); }
        const pt: PointerType* = t as PointerType*;
        return pt.pointee;
    }

    /// If the type at `id` is an Array, return its element TypeRef; otherwise
    /// return TypeRef::invalid().  Sibling of `pointer_pointee_of` for callers
    /// in modules where `Type` / `ArrayType` aren't in scope (AST/substituter):
    /// lets the array-element annotation carry a pre-resolved TypeRef so the
    /// resolver never has to re-parse a non-bare-name element display (e.g.
    /// `i32*`, or a user-defined type out of scope at the spec site).
    array_element_of(&this, id: u64) -> TypeRef {
        const t: Type* = this.lookup(id);
        if (t == null) { return TypeRef::invalid(); }
        if (t.kind != TypeKind::Array) { return TypeRef::invalid(); }
        const at: ArrayType* = t as ArrayType*;
        return at.element;
    }

    /// Look up a Type by its ID.  Returns null if the ID is invalid.
    lookup(&this, id: u64) -> Type* {
        if (id == 0) {
            return null;
        }
        // IDs start at 1, array starts at 0
        mut index: u64 = id - 1;
        if (index >= this.types.length) {
            return null;
        }
        return this.types[index];
    }

    /// Look up a payload field type, following an `InstantiatedType`
    /// wrapper to its concrete resolved type.  The wrapper reports
    /// size/alignment 0 (only the resolved spec'd struct carries layout),
    /// so layout math on the raw wrapper collapses fields onto their
    /// predecessors.
    lookup_payload_type(&this, ty: TypeRef) -> Type* {
        mut t: Type* = this.lookup(ty.id);
        if (t != null && t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (inst.has_resolved_type()) {
                const resolved: Type* = this.lookup(inst.resolved_type.id);
                if (resolved != null) { t = resolved; }
            }
        }
        return t;
    }

    /// THE single layout authority for an ADT enum variant's payload.
    /// Returns each payload field's byte offset (aligned up to the field's
    /// alignment, C struct rules); the optional out-params receive the
    /// variant's total payload size (rounded up to its alignment) and its
    /// max field alignment.
    ///
    /// Frontend layout (compute_enum_layout), the lowered LLVM type
    /// (TypeMapper::map_enum), construction (EnumVariantEmitter), pattern
    /// binding (PatternEmitter), and drop glue (CallEmitter) must ALL
    /// consume this.  These were once five hand-synced copies; the drop
    /// glue's copy used a packed running sum with no align-up, so it freed
    /// a garbage "pointer" out of any `V(u32, String)`-shaped payload
    /// (packed offset 4 vs constructed offset 8).
    variant_payload_layout(&this, variant: EnumVariantInfo*,
                           out_size: u64*, out_align: u64*) -> u64[] {
        mut offsets: u64[] = [];
        mut running: u64 = 0;
        mut max_align: u64 = 1;
        for (mut i: i64 = 0; i < variant.payload_types.length; i++) {
            const ft: Type* = this.lookup_payload_type(variant.payload_types[i]);
            if (ft != null) {
                const fa: u64 = ft.alignment();
                if (fa > 0) {
                    // align_up the running offset to this field's alignment
                    const rem: u64 = running % fa;
                    if (rem != 0) { running += (fa - rem); }
                    if (fa > max_align) { max_align = fa; }
                }
            }
            offsets.push(running);
            if (ft != null) { running += ft.size_bytes(); }
        }
        if (out_size != null) {
            // Round the variant's total up to its own alignment.
            mut total: u64 = running;
            const rem: u64 = running % max_align;
            if (max_align > 1 && rem != 0) { total = running + (max_align - rem); }
            out_size[0] = total;
        }
        if (out_align != null) { out_align[0] = max_align; }
        return offsets;
    }

    /// Register an additional name alias for an existing type in the
    /// appropriate cache.  Used by the Monomorphizer to register a bare
    /// specialization name (e.g. "Triple_i32_string") alongside the
    /// canonical qualified name ("Collections::Pair::Triple_i32_string")
    /// so that TypeResolver can find the type during body-local resolution
    /// (where the ASTTypeSubstituter produces bare names).
    add_name_alias(mut &this, alias: SymbolStr, ty: TypeRef) -> void {
        const t: Type* = this.lookup(ty.id);
        if (t == null) { return; }
        match (t.kind) {
            TypeKind::Struct => { this.struct_cache.insert(alias.id, ty); }
            TypeKind::Class  => { this.class_cache.insert(alias.id, ty); }
            TypeKind::Enum   => { this.enum_cache.insert(alias.id, ty); }
            _                => {}
        }
    }

    /// Register the (future) concrete for a generic instantiation under its
    /// specialized names, WHILE the slot at `wrapper_ref` is still the
    /// `InstantiatedType` wrapper.  This is the early half of the swap-relocate
    /// that gives a generic instantiation a SINGLE arena id: names must resolve
    /// during `resolve_specialized_ast` (a spec body can reference itself by its
    /// bare/qualified spec name), and they must resolve to the SAME id the
    /// concrete will occupy after `swap_wrapper_to_concrete` flips the slot in
    /// place - so a body's self-reference and its `this` share one id.  `kind` is
    /// the concrete's eventual kind (Struct/Class/Enum); `is_union` selects the
    /// struct cache with the union flag semantics (unions are Structs).
    reserve_spec_names(mut &this, wrapper_ref: TypeRef, qualified_spec: SymbolStr,
                       bare_spec: SymbolStr, kind: TypeKind) -> void {
        if (kind == TypeKind::Enum) {
            this.enum_cache.insert(qualified_spec.id, wrapper_ref);
            if (!bare_spec.equals(qualified_spec)) { this.enum_cache.insert(bare_spec.id, wrapper_ref); }
        } else if (kind == TypeKind::Class) {
            this.class_cache.insert(qualified_spec.id, wrapper_ref);
            if (!bare_spec.equals(qualified_spec)) { this.class_cache.insert(bare_spec.id, wrapper_ref); }
        } else {
            this.struct_cache.insert(qualified_spec.id, wrapper_ref);
            if (!bare_spec.equals(qualified_spec)) { this.struct_cache.insert(bare_spec.id, wrapper_ref); }
        }
        this.register_leaf_name(qualified_spec);
    }

    /// Flip the `InstantiatedType` slot at `wrapper_ref` into the concrete
    /// monomorphized aggregate IN PLACE, so the instantiation keeps its original
    /// id (`wrapper.id == concrete.id`) and the concrete carries the
    /// instantiation's `(generic_base, type_args)` intrinsically.
    ///
    /// Nothing is relocated and no side node survives: a monomorphized type IS
    /// its instantiation, the way rustc's `TyKind::Adt(AdtDef, SubstsRef)` carries
    /// its substitutions on the type.  (This used to relocate the wrapper node to
    /// a fresh id as an "origin carrier" that consumers had to look up; forgetting
    /// that lookup was a silent-wrong-answer defect class.)
    ///
    /// Idempotent: if the slot is already concrete (a duplicate request) it is
    /// returned unchanged.  Returns `wrapper_ref` (now denoting the concrete).
    swap_wrapper_to_concrete(mut &this, wrapper_ref: TypeRef, qualified_spec: SymbolStr,
                             module_name: SymbolStr, kind: TypeKind, is_union: boolean,
                             display: string) -> TypeRef {
        const w_id: u64 = wrapper_ref.id;
        if (w_id == 0 || (w_id - 1) >= this.types.length) { return wrapper_ref; }
        const index: u64 = w_id - 1;
        const old: Type* = this.types[index];
        if (old == null || old.kind != TypeKind::InstantiatedType) {
            return wrapper_ref;
        }

        // Build the concrete aggregate AT the wrapper's original id and install it
        // in the wrapper's slot (no new id for the concrete).  The instantiation's
        // (base, type_args) are copied ONTO the concrete - its intrinsic generic
        // identity, the `TyKind::Adt(AdtDef, SubstsRef)` shape - so every consumer
        // reads them from the type itself.  Nothing is relocated: there is no
        // origin carrier and no side node to keep in sync.
        const w_inst: InstantiatedType* = old as InstantiatedType*;
        const w_base: TypeRef = w_inst.generic_base;
        mut concrete: Type* = null;
        if (kind == TypeKind::Enum) {
            mut et: EnumType* = new EnumType(w_id, qualified_spec, module_name, this.intern_table);
            if (display.length() > 0) { et.set_display_name(display); }
            et.set_generic_origin(w_base, &w_inst.type_args);
            concrete = et as Type*;
        } else if (kind == TypeKind::Class) {
            mut ct: ClassType* = new ClassType(w_id, qualified_spec, module_name, this.intern_table);
            if (display.length() > 0) { ct.set_display_name(display); }
            ct.set_generic_origin(w_base, &w_inst.type_args);
            concrete = ct as Type*;
        } else {
            mut st: StructType* = new StructType(w_id, qualified_spec, module_name, this.intern_table);
            if (is_union) { st.set_union(true); }
            if (display.length() > 0) { st.set_display_name(display); }
            st.set_generic_origin(w_base, &w_inst.type_args);
            concrete = st as Type*;
        }
        this.types[index] = concrete;
        return wrapper_ref;
    }

    /// Search all user-defined type caches by name.
    lookup_by_name(&this, name: SymbolStr) -> TypeRef {

        const s: Option<TypeRef> = this.struct_cache.get(&name.id);
        if (s.is_some()) { return s.unwrap(); }

        const c: Option<TypeRef> = this.class_cache.get(&name.id);
        if (c.is_some()) { return c.unwrap(); }

        const e: Option<TypeRef> = this.enum_cache.get(&name.id);
        if (e.is_some()) { return e.unwrap(); }

        const t: Option<TypeRef> = this.trait_cache.get(&name.id);
        if (t.is_some()) { return t.unwrap(); }

        const a: Option<TypeRef> = this.alias_cache.get(&name.id);
        if (a.is_some()) { return a.unwrap(); }

        return TypeRef::invalid();
    }

    /// Look up a type by its bare leaf name (e.g., "DeclarationNode" finds
    /// "Compiler::AST::Declaration::DeclarationNode").  Uses the reverse
    /// index populated during type creation.  Returns invalid if not found.
    lookup_by_leaf(&this, bare_name: SymbolStr) -> TypeRef {
        const found: Option<u32> = this.leaf_index.get(&bare_name.id);
        if (found.is_none()) { return TypeRef::invalid(); }

        const qual_sym: SymbolStr = SymbolStr { id: found.unwrap() };
        return this.lookup_by_name(qual_sym);
    }

    /// Register a bare->qualified mapping in the reverse index.
    register_leaf_name(mut &this, qualified_name: SymbolStr) -> void {
        const qname_str: string = this.intern_table.resolve(qualified_name);
        const leaf_str: string = QualifiedName::leaf_of(qname_str);
        if (leaf_str.length() == 0) { return; }

        const leaf_sym: SymbolStr = this.intern_table.intern(leaf_str);
        // First registration wins; ambiguous names require qualified imports
        if (this.leaf_index.get(&leaf_sym.id).is_none()) {
            this.leaf_index.insert(leaf_sym.id, qualified_name.id);
        }
    }

    /// Recursively check whether a type contains any GenericParam or
    /// BoundedParam at any depth.  THE single authority for this query - 
    /// monomorphization, the live sema symbolic walk, and the generic-validation
    /// pass all call it, so they can never drift out of sync and silently
    /// under-recurse.  It lives on the arena because the arena owns every Type
    /// and this is a pure structural question about one.
    ///
    /// Uses only non-virtual access on `Type*` subclass pointers: `t.kind` (plain
    /// enum field) and plain compound fields reached via `t as XType*`.  No
    /// virtual method is ever dispatched on a `Type*`, which is why even the
    /// generic-validation pass (historically prone to a vtable-offset SIGSEGV on
    /// `Type*` virtual dispatch) can call this directly.
    contains_generic_param(&this, ty: TypeRef) -> boolean {
        if (!ty.is_valid()) { return false; }
        const t: Type* = this.lookup(ty.id);
        if (t == null) { return false; }
        if (t.kind == TypeKind::GenericParam) { return true; }
        if (t.kind == TypeKind::BoundedParam) { return true; }
        if (t.kind == TypeKind::AssocProjection) {
            // An unresolved associated-type projection (`I::Item`, or `This::Item`
            // in a trait-decl signature) is not yet concrete - treat it like a
            // generic param so the monomorphizer defers any instantiation that
            // contains it (e.g. `Option<This::Item>`) until the projection's base
            // is specialized and `resolved_type` is filled.  A resolved
            // projection is concrete via its base; recurse so a still-generic
            // base surfaces.
            const proj: AssocProjectionType* = t as AssocProjectionType*;
            if (!proj.resolved_type.is_valid()) { return true; }
            return this.contains_generic_param(proj.base);
        }
        if (t.kind == TypeKind::Pointer) {
            return this.contains_generic_param((t as PointerType*).pointee);
        }
        if (t.kind == TypeKind::Reference) {
            return this.contains_generic_param((t as ReferenceType*).referent);
        }
        if (t.kind == TypeKind::Array) {
            return this.contains_generic_param((t as ArrayType*).element);
        }
        if (t.kind == TypeKind::Optional) {
            return this.contains_generic_param((t as OptionalType*).wrapped);
        }
        if (t.kind == TypeKind::Tuple) {
            const tup: TupleType* = t as TupleType*;
            for (mut i: i64 = 0; i < tup.elements.length; i++) {
                if (this.contains_generic_param(tup.elements[i])) { return true; }
            }
            return false;
        }
        if (t.kind == TypeKind::Function) {
            const func: FunctionType* = t as FunctionType*;
            if (this.contains_generic_param(func.return_type)) { return true; }
            for (mut i: i64 = 0; i < func.param_types.length; i++) {
                if (this.contains_generic_param(func.param_types[i])) { return true; }
            }
            return false;
        }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                if (this.contains_generic_param(inst.type_args[i])) { return true; }
            }
            return false;
        }
        return false;
    }

    /// True if `ty` (or a type nested inside it) is an instantiation of the
    /// generic type named `owner_qname` (its fully-qualified name) whose
    /// type-arguments are a STRICT structural superterm of the owner's own
    /// parameters - i.e. a generic param appears WRAPPED (pointer / reference /
    /// array / nested generic), not bare.
    ///
    /// This is the signature shape that towers infinitely under eager
    /// monomorphization: `Option<T>::as_ref -> Option<T*>` grows the args one
    /// pointer level per instantiation, minting `Option<T*>`, `Option<T**>`,
    /// ... forever.  A non-generic method whose return (or a param) matches
    /// this MUST be instantiated lazily at call sites, never eagerly, exactly
    /// like a self-returning trait-default combinator.
    ///
    /// The owner is identified by NAME (not a `TypeRef`): the owner handle the
    /// caller has at signature-resolution time is often an invalid `TypeRef`
    /// for `implement` blocks (the receiver is back-filled later), so an
    /// identity check would silently never match.
    ///
    /// NOT matched (these are finite, so they stay eager):
    ///   - `Option<T>`   bare param arg  -> same level, no growth
    ///   - `Option<i32*>` concrete arg   -> no param, materialized once
    ///   - `&Option<T>` (`&this`)        -> peels to the bare-param owner
    ///   - `Foo<T>` for a different base than the owner
    is_self_growing_instantiation(&this, ty: TypeRef, owner_qname: SymbolStr) -> boolean {
        if (!ty.is_valid() || !owner_qname.is_valid()) { return false; }
        const t: Type* = this.lookup(ty.id);
        if (t == null) { return false; }
        // Peel transparent wrappers so `&Option<T*>` / `Option<T*>[]` match.
        if (t.kind == TypeKind::Pointer) {
            return this.is_self_growing_instantiation((t as PointerType*).pointee, owner_qname);
        }
        if (t.kind == TypeKind::Reference) {
            return this.is_self_growing_instantiation((t as ReferenceType*).referent, owner_qname);
        }
        if (t.kind == TypeKind::Array) {
            return this.is_self_growing_instantiation((t as ArrayType*).element, owner_qname);
        }
        if (t.kind == TypeKind::Optional) {
            return this.is_self_growing_instantiation((t as OptionalType*).wrapped, owner_qname);
        }
        if (t.kind != TypeKind::InstantiatedType) { return false; }
        const inst: InstantiatedType* = t as InstantiatedType*;
        // Same generic base as the owner, matched by qualified name.
        const bn: SymbolStr = this.get_qualified_name(inst.generic_base);
        const same_base: boolean = bn.is_valid() && bn.equals(owner_qname);
        if (!same_base) {
            // Different base: the owner base may be nested deeper
            // (e.g. `Pair<i32, Option<T*>>` on owner `Option`).
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                if (this.is_self_growing_instantiation(inst.type_args[i], owner_qname)) {
                    return true;
                }
            }
            return false;
        }
        // Same base as the owner: a STRICT superterm has at least one arg that
        // contains a generic param but is not the bare param itself.
        for (mut i: i64 = 0; i < inst.type_args.length; i++) {
            const arg: TypeRef = inst.type_args[i];
            const at: Type* = this.lookup(arg.id);
            if (at == null) { continue; }
            const bare_param: boolean = at.kind == TypeKind::GenericParam
                                     || at.kind == TypeKind::BoundedParam;
            if (!bare_param && this.contains_generic_param(arg)) {
                return true;
            }
        }
        return false;
    }

    /// Get the qualified name for a user-defined type by TypeRef.
    /// Returns the name the type was registered under in the arena.
    /// Doing the `as StructType*` / `as ClassType*` cast and field read
    /// inside the arena (where the Type subclass is directly available)
    /// sidesteps a codegen miscompile of cast-pointer field access at
    /// call sites.
    get_qualified_name(&this, ty: TypeRef) -> SymbolStr {
        const t: Type* = this.lookup(ty.id);
        if (t == null) { return SymbolStr::empty(); }
        match (t.kind) {
            TypeKind::Struct => {
                const st: StructType* = t as StructType*;
                return st.qualified_name;
            }
            TypeKind::Class => {
                const ct: ClassType* = t as ClassType*;
                return ct.qualified_name;
            }
            TypeKind::Enum => {
                const et: EnumType* = t as EnumType*;
                return et.qualified_name;
            }
            TypeKind::InstantiatedType => {
                const inst: InstantiatedType* = t as InstantiatedType*;
                if (inst.has_resolved_type()) {
                    return this.get_qualified_name(inst.resolved_type);
                }
            }
            TypeKind::TypeAlias => {
                const alias: TypeAliasType* = t as TypeAliasType*;
                return alias.alias_name;
            }
            _ => { }
        }
        return SymbolStr::empty();
    }

    /// Total number of types allocated.
    type_count(&this) -> i64 {
        return this.types.length;
    }

    /// Resolve a TypeRef ID to a human-readable display name string.
    /// Delegates to format_display() so that compound types (pointers,
    /// references, arrays, etc.) resolve their inner types recursively
    /// instead of printing raw TypeRef IDs.
    resolve_display_name(&this, id: u64) -> string {
        const t: Type* = this.lookup(id);
        if (t == null) { return "?"; }
        return this.format_display(t);
    }

    /// Format a human-readable display name for any type.
    /// Uses string concatenation instead of nested sprintf to avoid
    /// static buffer aliasing (sprintf uses a shared buffer, so nested
    /// calls overwrite the previous result).
    format_display(&this, ty: Type*) -> string {
        if (ty == null) { return "?"; }

        match (ty.kind) {
            TypeKind::Pointer => {
                const p: PointerType* = ty as PointerType*;
                return this.resolve_display_name(p.pointee.id) + "*";
            }
            TypeKind::Reference => {
                const r: ReferenceType* = ty as ReferenceType*;
                const inner_name: string = this.resolve_display_name(r.referent.id);
                // Cryo spells a mutable reference `mut &T`, not `&mut T`.
                if (r.is_mutable()) { return "mut &" + inner_name; }
                return "&" + inner_name;
            }
            TypeKind::Array => {
                const a: ArrayType* = ty as ArrayType*;
                const elem_name: string = this.resolve_display_name(a.element.id);
                if (a.is_dynamic()) { return elem_name + "[]"; }
                const size_str: string = format("%ld", a.size);
                return elem_name + "[" + size_str + "]";
            }
            TypeKind::Optional => {
                const o: OptionalType* = ty as OptionalType*;
                return this.resolve_display_name(o.wrapped.id) + "?";
            }
            TypeKind::Function => {
                const f: FunctionType* = ty as FunctionType*;
                mut result: string = "(";
                for (mut i: i64 = 0; i < f.param_types.length; i++) {
                    if (i > 0) { result += ", "; }
                    result += this.resolve_display_name(f.param_types[i].id);
                }
                if (f.is_variadic) {
                    if (f.param_types.length > 0) { result += ", "; }
                    result += "...";
                }
                const ret_name: string = this.resolve_display_name(f.return_type.id);
                return result + ") -> " + ret_name;
            }
            TypeKind::Tuple => {
                const t: TupleType* = ty as TupleType*;
                mut result: string = "(";
                for (mut i: i64 = 0; i < t.elements.length; i++) {
                    if (i > 0) { result += ", "; }
                    result += this.resolve_display_name(t.elements[i].id);
                }
                return result + ")";
            }
            TypeKind::InstantiatedType => {
                const inst: InstantiatedType* = ty as InstantiatedType*;
                mut result: string = this.resolve_display_name(inst.generic_base.id) + "<";
                for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                    if (i > 0) { result += ", "; }
                    result += this.resolve_display_name(inst.type_args[i].id);
                }
                return result + ">";
            }
            TypeKind::GenericParam => {
                const gp: GenericParamType* = ty as GenericParamType*;
                return this.intern_table.resolve(gp.param_name);
            }
            TypeKind::BoundedParam => {
                const bp: BoundedParamType* = ty as BoundedParamType*;
                return this.intern_table.resolve(bp.param_name);
            }
            TypeKind::AssocProjection => {
                // `Base::Member` (e.g. `This::Item`).  The class-level
                // `display_name` can only reach raw ids (`488::489`) - it
                // has no intern table - so render it here where the base's
                // display name and the member's interned string are both
                // reachable.  A resolved projection shows the concrete type.
                const proj: AssocProjectionType* = ty as AssocProjectionType*;
                if (proj.resolved_type.is_valid()) {
                    return this.resolve_display_name(proj.resolved_type.id);
                }
                return this.resolve_display_name(proj.base.id) + "::"
                    + this.intern_table.resolve(proj.member);
            }
            _ => { }
        }

        // Primitives, user-defined types (Struct, Class, Enum, Trait)
        return ty.display_name();
    }

    /// Same as `resolve_display_name` but strips namespace prefixes
    /// from leaf type names: `std::collections::str::Str` becomes
    /// `Str`, `std::core::option::Option<std::collections::str::Str>`
    /// becomes `Option<Str>`.  Used by the LSP for hover/completion
    /// where the full path is just visual noise; call sites already
    /// say `Str::from_raw`, so the qualified prefix is implied.
    /// Composite kinds (pointer/reference/array/optional/function/
    /// tuple/instantiated) recurse through this method so every leaf
    /// is shortened.
    resolve_display_name_short(&this, id: u64) -> string {
        const t: Type* = this.lookup(id);
        if (t == null) { return "?"; }
        return this.format_display_short(t);
    }

    format_display_short(&this, ty: Type*) -> string {
        if (ty == null) { return "?"; }

        match (ty.kind) {
            TypeKind::Pointer => {
                const p: PointerType* = ty as PointerType*;
                return this.resolve_display_name_short(p.pointee.id) + "*";
            }
            TypeKind::Reference => {
                const r: ReferenceType* = ty as ReferenceType*;
                const inner: string = this.resolve_display_name_short(r.referent.id);
                // Cryo spells a mutable reference `mut &T`, not `&mut T`.
                if (r.is_mutable()) { return "mut &" + inner; }
                return "&" + inner;
            }
            TypeKind::Array => {
                const a: ArrayType* = ty as ArrayType*;
                const elem: string = this.resolve_display_name_short(a.element.id);
                if (a.is_dynamic()) { return elem + "[]"; }
                return elem + "[" + format("%ld", a.size) + "]";
            }
            TypeKind::Optional => {
                const o: OptionalType* = ty as OptionalType*;
                return this.resolve_display_name_short(o.wrapped.id) + "?";
            }
            TypeKind::Function => {
                const f: FunctionType* = ty as FunctionType*;
                mut result: string = "(";
                for (mut i: i64 = 0; i < f.param_types.length; i++) {
                    if (i > 0) { result += ", "; }
                    result += this.resolve_display_name_short(f.param_types[i].id);
                }
                if (f.is_variadic) {
                    if (f.param_types.length > 0) { result += ", "; }
                    result += "...";
                }
                return result + ") -> "
                    + this.resolve_display_name_short(f.return_type.id);
            }
            TypeKind::Tuple => {
                const t: TupleType* = ty as TupleType*;
                mut result: string = "(";
                for (mut i: i64 = 0; i < t.elements.length; i++) {
                    if (i > 0) { result += ", "; }
                    result += this.resolve_display_name_short(t.elements[i].id);
                }
                return result + ")";
            }
            TypeKind::InstantiatedType => {
                const inst: InstantiatedType* = ty as InstantiatedType*;
                mut result: string = this.resolve_display_name_short(inst.generic_base.id) + "<";
                for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                    if (i > 0) { result += ", "; }
                    result += this.resolve_display_name_short(inst.type_args[i].id);
                }
                return result + ">";
            }
            TypeKind::GenericParam => {
                const gp: GenericParamType* = ty as GenericParamType*;
                return this.intern_table.resolve(gp.param_name);
            }
            TypeKind::BoundedParam => {
                const bp: BoundedParamType* = ty as BoundedParamType*;
                return this.intern_table.resolve(bp.param_name);
            }
            TypeKind::AssocProjection => {
                // `Base::Member` (e.g. `This::Item`) - see the long-form
                // `format_display` for why this can't live on the class's
                // `display_name`.  Base is shortened too so a qualified
                // concrete base renders `Range<i32>::Item`, not the path.
                const proj: AssocProjectionType* = ty as AssocProjectionType*;
                if (proj.resolved_type.is_valid()) {
                    return this.resolve_display_name_short(proj.resolved_type.id);
                }
                return this.resolve_display_name_short(proj.base.id) + "::"
                    + this.intern_table.resolve(proj.member);
            }
            _ => { }
        }

        // Leaf user-defined types: strip qualified prefixes.
        // `QualifiedName::shorten_paths` walks the display string and
        // shortens *every* `::`-path, including those nested inside
        // a `<...>` from the monomorphizer's `custom_display`
        // (`Array<u8, std::alloc::allocator::GlobalAlloc>` ->
        // `Array<u8, GlobalAlloc>`).  Plain QualifiedName::leaf_of
        // would chop the whole thing at the inner `::` and produce
        // `GlobalAlloc>`: wrong, scary, and fielded by users.
        return QualifiedName::shorten_paths(ty.display_name());
    }

    debug_dump(&this) -> void {
        cdebug("\n=== TypeArena Dump: %lld types ===\n", this.types.length);
        cdebug("%-5s | %-16s | %-28s | %5s | %5s | %-20s | %-6s | %-17s | %s\n",
            "ID", "Kind", "Display Name", "Size", "Align",
            "Module", "Mbrs", "Status", "Refs");
        cdebug("------+------------------+------------------------------+-------+-------+----------------------+--------+-------------------+---------------------------\n");

        for (mut i: int = 0; i < this.types.length; i++) {
            const ty: Type* = this.types[i];
            if (ty == null) { continue; }

            const kind_str: string    = ty.kind.to_string();
            const display: string     = this.format_display(ty);
            const module_str: string  = this.get_type_module(ty);
            const members_str: string = this.get_type_members(ty);
            const status_str: string  = this.get_type_status(ty);
            const refs_str: string    = this.get_type_refs(ty);

            cdebug("%-5llu | %-16.16s | %-28.28s | %5llu | %5llu | %-20.20s | %-6.6s | %-17.17s | %.40s\n",
                ty.id, kind_str, display, ty.size_bytes(), ty.alignment(),
                module_str, members_str, status_str, refs_str);
        }
        cdebug("------+------------------+------------------------------+-------+-------+----------------------+--------+-------------------+---------------------------\n");

        // Summary by category
        cdebug("\n=== Type Summary ===\n");
        mut n_primitives: i64 = 0;
        mut n_compound: i64 = 0;
        mut n_user: i64 = 0;
        mut n_generic: i64 = 0;
        mut n_instantiated: i64 = 0;
        mut n_resolved_inst: i64 = 0;

        for (mut j: int = 0; j < this.types.length; j++) {
            const t: Type* = this.types[j];
            if (t == null) { continue; }
            if (t.kind.is_primitive()) { n_primitives += 1; }
            if (t.kind == TypeKind::Pointer || t.kind == TypeKind::Reference ||
                t.kind == TypeKind::Array || t.kind == TypeKind::Function ||
                t.kind == TypeKind::Tuple || t.kind == TypeKind::Optional) {
                n_compound += 1;
            }
            if (t.kind == TypeKind::Struct || t.kind == TypeKind::Class ||
                t.kind == TypeKind::Enum || t.kind == TypeKind::Trait ||
                t.kind == TypeKind::TypeAlias) {
                n_user += 1;
            }
            if (t.kind == TypeKind::GenericParam || t.kind == TypeKind::BoundedParam ||
                t.kind == TypeKind::FunctionTemplate) {
                n_generic += 1;
            }
            if (t.kind == TypeKind::InstantiatedType) {
                n_instantiated += 1;
                const inst_t: InstantiatedType* = t as InstantiatedType*;
                if (inst_t.resolved_type.is_valid()) {
                    n_resolved_inst += 1;
                }
            }
        }

        cdebug("  Primitives:    %lld\n", n_primitives);
        cdebug("  Compound:      %lld  (ptr, ref, array, fn, tuple, optional)\n", n_compound);
        cdebug("  User-defined:  %lld  (struct, class, enum, trait, alias)\n", n_user);
        cdebug("  Generic:       %lld  (params + function templates)\n", n_generic);
        cdebug("  Instantiated:  %lld  (%lld resolved)\n", n_instantiated, n_resolved_inst);
        cdebug("  Total:         %lld\n", this.types.length);

        cdebug("\n=== Dedup Caches ===\n");
        // One structural interner now covers ptr/ref/array/optional/fn/tuple/
        // assoc-projection/instantiation; the per-kind counts it replaced are
        // recoverable from the type census above.
        cdebug("  Structural interner: %lld entries | canonical-identity violations: %lld\n",
            this.intern_entries.length, this.verify_canonical_identity());
        cdebug("  GenericParam: %lld | BoundedParam: %lld\n",
            this.generic_param_cache.length(), this.bounded_param_cache.length());
        cdebug("  Struct: %lld | Class: %lld | Enum: %lld | Trait: %lld | Alias: %lld\n",
            this.struct_cache.length(), this.class_cache.length(),
            this.enum_cache.length(), this.trait_cache.length(),
            this.alias_cache.length());
    }


    // Per-column helpers for debug_dump

    /// Module column: owning module name for user-defined types.
    get_type_module(&this, ty: Type*) -> string {
        if (ty.kind == TypeKind::Struct) {
            const st: StructType* = ty as StructType*;
            return this.intern_table.resolve(st.module_name);
        }
        if (ty.kind == TypeKind::Class) {
            const cl: ClassType* = ty as ClassType*;
            return this.intern_table.resolve(cl.module_name);
        }
        if (ty.kind == TypeKind::Enum) {
            const en: EnumType* = ty as EnumType*;
            return this.intern_table.resolve(en.module_name);
        }
        if (ty.kind == TypeKind::Trait) {
            const tr: TraitType* = ty as TraitType*;
            return this.intern_table.resolve(tr.module_name);
        }
        if (ty.kind == TypeKind::FunctionTemplate) {
            const ft: FunctionTemplateType* = ty as FunctionTemplateType*;
            return this.intern_table.resolve(ft.qualified_name);
        }
        return "";
    }

    /// Members column: compact field/method/variant/param/element counts.
    ///   Struct/Class: "3f 2m"  (fields, methods)
    ///   Enum:         "4v 1m"  (variants, methods)
    ///   Trait:        "2m 1s"  (required methods, super traits)
    ///   Function:     "3p"     (params)
    ///   Tuple:        "2e"     (elements)
    ///   InstType:     "2a"     (type args)
    ///   BoundedParam: "1b"     (bounds)
    get_type_members(&this, ty: Type*) -> string {
        if (ty.kind == TypeKind::Struct) {
            const st: StructType* = ty as StructType*;
            return format("%lldf %lldm", st.fields.length, st.methods.length);
        }
        if (ty.kind == TypeKind::Class) {
            const cl: ClassType* = ty as ClassType*;
            return format("%lldf %lldm", cl.fields.length, cl.methods.length);
        }
        if (ty.kind == TypeKind::Enum) {
            const en: EnumType* = ty as EnumType*;
            return format("%lldv %lldm", en.variants.length, en.methods.length);
        }
        if (ty.kind == TypeKind::Trait) {
            const tr: TraitType* = ty as TraitType*;
            return format("%lldm %llds", tr.required_methods.length, tr.super_traits.length);
        }
        if (ty.kind == TypeKind::Function) {
            const f: FunctionType* = ty as FunctionType*;
            return format("%lldp", f.param_types.length);
        }
        if (ty.kind == TypeKind::Tuple) {
            const t: TupleType* = ty as TupleType*;
            return format("%llde", t.elements.length);
        }
        if (ty.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = ty as InstantiatedType*;
            return format("%llda", inst.type_args.length);
        }
        if (ty.kind == TypeKind::BoundedParam) {
            const bp: BoundedParamType* = ty as BoundedParamType*;
            return format("%lldb", bp.bounds.length);
        }
        return "";
    }

    /// Status column: resolution, completeness, flags.
    get_type_status(&this, ty: Type*) -> string {
        if (ty.kind == TypeKind::Struct) {
            const st: StructType* = ty as StructType*;
            return if (st.is_complete) { "complete" } else { "forward" };
        }
        if (ty.kind == TypeKind::Class) {
            const cl: ClassType* = ty as ClassType*;
            mut s: string = if (cl.is_complete) { "complete" } else { "forward" };
            if (cl.has_virtual_methods) { s += " vt"; }
            return s;
        }
        if (ty.kind == TypeKind::Enum) {
            const en: EnumType* = ty as EnumType*;
            return if (en.is_simple_enum()) { "simple" } else { "ADT" };
        }
        if (ty.kind == TypeKind::TypeAlias) {
            const al: TypeAliasType* = ty as TypeAliasType*;
            if (al.has_target()) { return "resolved"; }
            return if (al.is_generic) { "generic template" } else { "UNRESOLVED" };
        }
        if (ty.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = ty as InstantiatedType*;
            if (inst.resolved_type.is_valid()) { return "resolved"; }
            // Check if any type arg is a generic param: template-internal ref
            for (mut j: i64 = 0; j < inst.type_args.length; j++) {
                const arg_ty: Type* = this.lookup(inst.type_args[j].id);
                if (arg_ty != null) {
                    if (arg_ty.kind == TypeKind::GenericParam ||
                        arg_ty.kind == TypeKind::BoundedParam) {
                        return "template-internal";
                    }
                }
            }
            // Check if base is a function template
            const base_ty: Type* = this.lookup(inst.generic_base.id);
            if (base_ty != null && base_ty.kind == TypeKind::FunctionTemplate) {
                return "fn-template";
            }
            return "UNRESOLVED";
        }
        if (ty.kind == TypeKind::GenericParam) {
            const gp: GenericParamType* = ty as GenericParamType*;
            return format("idx=%lu", gp.param_index);
        }
        if (ty.kind == TypeKind::BoundedParam) {
            const bp: BoundedParamType* = ty as BoundedParamType*;
            return format("idx=%lu", bp.param_index);
        }
        if (ty.kind == TypeKind::Reference) {
            const r: ReferenceType* = ty as ReferenceType*;
            return r.mutability.to_string();
        }
        if (ty.kind == TypeKind::Array) {
            const a: ArrayType* = ty as ArrayType*;
            return if (a.is_dynamic()) { "dynamic" } else { "fixed" };
        }
        if (ty.kind == TypeKind::Function) {
            const f: FunctionType* = ty as FunctionType*;
            return if (f.is_variadic) { "variadic" } else { "" };
        }
        return "";
    }

    /// Refs column: type references (targets, inner types, resolved types).
    get_type_refs(&this, ty: Type*) -> string {
        if (ty.kind == TypeKind::Pointer) {
            const p: PointerType* = ty as PointerType*;
            const inner: string = this.resolve_display_name(p.pointee.id);
            return format("-> %s (#%lu)", inner, p.pointee.id);
        }
        if (ty.kind == TypeKind::Reference) {
            const r: ReferenceType* = ty as ReferenceType*;
            const inner: string = this.resolve_display_name(r.referent.id);
            return format("-> %s (#%lu)", inner, r.referent.id);
        }
        if (ty.kind == TypeKind::Array) {
            const a: ArrayType* = ty as ArrayType*;
            const elem: string = this.resolve_display_name(a.element.id);
            return format("elem: %s (#%lu)", elem, a.element.id);
        }
        if (ty.kind == TypeKind::Optional) {
            const o: OptionalType* = ty as OptionalType*;
            const inner: string = this.resolve_display_name(o.wrapped.id);
            return format("-> %s (#%lu)", inner, o.wrapped.id);
        }
        if (ty.kind == TypeKind::Function) {
            const f: FunctionType* = ty as FunctionType*;
            const ret: string = this.resolve_display_name(f.return_type.id);
            return format("ret: %s (#%lu)", ret, f.return_type.id);
        }
        if (ty.kind == TypeKind::Tuple) {
            const t: TupleType* = ty as TupleType*;
            if (t.elements.length == 0) { return "()"; }
            // Show first few element type IDs
            mut result: string = "(";
            const limit: i64 = if (t.elements.length < 4) { t.elements.length } else { 3 };
            for (mut i: i64 = 0; i < limit; i++) {
                if (i > 0) { result += ", "; }
                result += format("#%lu", t.elements[i].id);
            }
            if (t.elements.length > 3) { result += ", ..."; }
            return result + ")";
        }
        if (ty.kind == TypeKind::TypeAlias) {
            const al: TypeAliasType* = ty as TypeAliasType*;
            if (al.has_target()) {
                const target: string = this.resolve_display_name(al.target.id);
                return format("-> %s (#%lu)", target, al.target.id);
            }
            return "-> ?";
        }
        if (ty.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = ty as InstantiatedType*;
            const base: string = this.resolve_display_name(inst.generic_base.id);
            if (inst.resolved_type.is_valid()) {
                const resolved: string = this.resolve_display_name(inst.resolved_type.id);
                return format("base: %s => %s (#%lu)", base, resolved, inst.resolved_type.id);
            }
            return format("base: %s => ?", base);
        }
        if (ty.kind == TypeKind::Class) {
            const cl: ClassType* = ty as ClassType*;
            if (cl.has_base) {
                const base_name: string = this.resolve_display_name(cl.base_class.id);
                return format("extends %s (#%lu)", base_name, cl.base_class.id);
            }
        }
        if (ty.kind == TypeKind::Error) {
            const e: ErrorType* = ty as ErrorType*;
            return e.reason;
        }
        return "";
    }

    /// Establish a concrete aggregate's intrinsic generic identity from the
    /// `InstantiatedType` it was monomorphized from.  This is the NON-swap
    /// monomorphization path (a concrete allocated at a fresh id rather than
    /// installed in the wrapper's slot); it must set the same identity as
    /// `swap_wrapper_to_concrete`, or every `inst_generic_base` /
    /// `inst_type_arg_*` query on such a type answers "not an instantiation" and
    /// its associated types, trait impls and drop glue all resolve against the
    /// wrong key.  A no-op for non-aggregate concretes (e.g. a specialized
    /// function type), which carry no generic identity.
    set_type_generic_origin(mut &this, concrete: TypeRef, wrapper: TypeRef) -> void {
        const t: Type* = this.lookup(concrete.id);
        if (t == null) { return; }
        const w: Type* = this.lookup(wrapper.id);
        if (w == null || w.kind != TypeKind::InstantiatedType) { return; }
        const wi: InstantiatedType* = w as InstantiatedType*;
        if (!wi.generic_base.is_valid()) { return; }
        if (t.kind == TypeKind::Struct) {
            (t as StructType*).set_generic_origin(wi.generic_base, &wi.type_args);
        } else if (t.kind == TypeKind::Class) {
            (t as ClassType*).set_generic_origin(wi.generic_base, &wi.type_args);
        } else if (t.kind == TypeKind::Enum) {
            (t as EnumType*).set_generic_origin(wi.generic_base, &wi.type_args);
        }
    }

    // -- Intrinsic generic identity (the carrier-free accessors) ---------------
    //
    // A monomorphized aggregate carries its own `(generic_base, type_args)` - the
    // rustc `TyKind::Adt(AdtDef, SubstsRef)` shape.  Prefer these over
    // They read the type directly, so there is no side node to remember to
    // consult (forgetting to chase such a node is precisely the defect class that
    // produced the 2026-07-18 sweep).

    /// The template `ty` is an instantiation of, or invalid when it is not one.
    /// Answers for BOTH representations: a pre-mono `InstantiatedType` wrapper
    /// reads its own node; a post-mono concrete reads its intrinsic identity.
    /// Does NOT peel Pointer / Reference - see `TypeUtils::view_generic_base`.
    inst_generic_base(&this, ty: TypeRef) -> TypeRef {
        const t: Type* = this.lookup(ty.id);
        if (t == null) { return TypeRef::invalid(); }
        if (t.kind == TypeKind::InstantiatedType) { return (t as InstantiatedType*).generic_base; }
        if (t.kind == TypeKind::Struct) { return (t as StructType*).generic_base; }
        if (t.kind == TypeKind::Class)  { return (t as ClassType*).generic_base; }
        if (t.kind == TypeKind::Enum)   { return (t as EnumType*).generic_base; }
        return TypeRef::invalid();
    }

    /// Number of type arguments `ty` carries as an instantiation (0 if none).
    inst_type_arg_count(&this, ty: TypeRef) -> i64 {
        const t: Type* = this.lookup(ty.id);
        if (t == null) { return 0; }
        if (t.kind == TypeKind::InstantiatedType) { return (t as InstantiatedType*).type_args.length; }
        if (t.kind == TypeKind::Struct) { return (t as StructType*).type_args.length; }
        if (t.kind == TypeKind::Class)  { return (t as ClassType*).type_args.length; }
        if (t.kind == TypeKind::Enum)   { return (t as EnumType*).type_args.length; }
        return 0;
    }

    /// The `i`-th type argument of `ty` as an instantiation, or invalid.
    /// Indexed rather than returned as an array: handing out a `TypeRef[]` by
    /// value would alias the type's owned buffer and free it twice.
    inst_type_arg_at(&this, ty: TypeRef, i: i64) -> TypeRef {
        if (i < 0) { return TypeRef::invalid(); }
        const t: Type* = this.lookup(ty.id);
        if (t == null) { return TypeRef::invalid(); }
        if (t.kind == TypeKind::InstantiatedType) {
            const wt: InstantiatedType* = t as InstantiatedType*;
            if (i >= wt.type_args.length) { return TypeRef::invalid(); }
            return wt.type_args[i];
        }
        if (t.kind == TypeKind::Struct) {
            const st: StructType* = t as StructType*;
            if (i >= st.type_args.length) { return TypeRef::invalid(); }
            return st.type_args[i];
        }
        if (t.kind == TypeKind::Class) {
            const ct: ClassType* = t as ClassType*;
            if (i >= ct.type_args.length) { return TypeRef::invalid(); }
            return ct.type_args[i];
        }
        if (t.kind == TypeKind::Enum) {
            const et: EnumType* = t as EnumType*;
            if (i >= et.type_args.length) { return TypeRef::invalid(); }
            return et.type_args[i];
        }
        return TypeRef::invalid();
    }
}
