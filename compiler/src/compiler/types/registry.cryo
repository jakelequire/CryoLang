///! ModuleTypeRegistry
///!
///! Cross-module type tracking with visibility control.  Each module registers
///! its types here during declaration collection, and other modules look up
///! types through their import lists.

namespace Compiler::Types::Registry;

import Compiler::Resolver::SymbolStr;
import Compiler::Types::TypeRef;
import std::core::option;
import std::collections::{ hashmap, pair };


// TypeVisibility: Access control for registered types

type enum TypeVisibility {
    Public;
    Private;
    Internal;
}

implement enum TypeVisibility {
    to_string(&this) -> string {
        return match (this) {
            TypeVisibility::Public   => { "Public" }
            TypeVisibility::Private  => { "Private" }
            TypeVisibility::Internal => { "Internal" }
        };
    }

    is_public(&this) -> boolean {
        return match (this) {
            TypeVisibility::Public => { true }
            _                      => { false }
        };
    }
}


// TypeRegistryEntry: A single type registration

type struct TypeRegistryEntry {
    entry_type: TypeRef;
    visibility: TypeVisibility;
    local_name: SymbolStr;

    static new(entry_type: TypeRef, visibility: TypeVisibility, local_name: SymbolStr) -> TypeRegistryEntry {
        return TypeRegistryEntry {
            entry_type: entry_type,
            visibility: visibility,
            local_name: local_name,
        };
    }
}


type struct ModuleTypeRegistry {
    // Flat list of all registered type entries with a module key per entry.
    // NOTE: Cannot use TypeRegistryEntry[][]; codegen currently mishandles
    // `T[][]` (the inner array descriptor lowers to a bare ptr instead of
    // the `{ptr,i64,i64}` fat-pointer struct).  Flatten to Pair<...>[].
    entries: Pair<TypeRegistryEntry, i64>[];  // .first = entry, .second = module index

    // Module name registry (module_name -> index)
    module_names:     string[];
    module_index:     HashMap<string, i64>;

    // Type aliases: alias SymbolStr.id -> target TypeRef
    aliases:      Pair<SymbolStr, TypeRef>[];    // .first = alias name, .second = target

    // Alias base name tracking for chain resolution
    alias_bases:  Pair<SymbolStr, SymbolStr>[];  // .first = alias name, .second = base name

    // HashMap indices for O(1) lookup
    alias_index:      HashMap<u32, i64>;     // alias SymbolStr.id -> index
    alias_base_index: HashMap<u32, i64>;     // alias base SymbolStr.id -> index

    static new() -> ModuleTypeRegistry {
        return ModuleTypeRegistry {
            entries:          [],
            module_names:     [],
            module_index:     HashMap<string, i64>::new(),
            aliases:          [],
            alias_bases:      [],
            alias_index:      HashMap<u32, i64>::new(),
            alias_base_index: HashMap<u32, i64>::new(),
        };
    }


    // Type registration

    /// Register a type in a module with the given visibility.
    register_type(mut &this, module: string, name: SymbolStr, ty: TypeRef, vis: TypeVisibility) -> void {
        const entry: TypeRegistryEntry = TypeRegistryEntry::new(ty, vis, name);

        // Ensure module is registered
        const h: u64 = hash_str(module);
        const opt: Option<i64> = this.module_index.get(&module);
        mut mod_idx: i64 = 0;
        if (opt.is_some()) {
            mod_idx = opt.unwrap();
        } else {
            mod_idx = this.module_names.length;
            this.module_names.push(module);
            this.module_index.insert(module, mod_idx);
        }

        // Append entry with its module id
        this.entries.push(Pair::new(entry, mod_idx));
    }


    // Type lookup

    /// Look up a type in a specific module by name.
    lookup_type(&this, module: string, name: SymbolStr) -> TypeRef {
        const opt: Option<i64> = this.module_index.get(&module);
        if (opt.is_some()) {
            const mod_idx: i64 = opt.unwrap();
            for (mut j: i64 = 0; j < this.entries.length; j++) {
                if (this.entries[j].second == mod_idx &&
                    this.entries[j].first.local_name.equals(name)) {
                    return this.entries[j].first.entry_type;
                }
            }
        }
        return TypeRef::invalid();
    }

    /// Look up a type across a list of imported modules (public types only).
    lookup_type_in_imports(&this, name: SymbolStr, imports: string[]) -> TypeRef {
        for (mut i: i64 = 0; i < imports.length; i++) {
            const opt: Option<i64> = this.module_index.get(&imports[i]);
            if (opt.is_some()) {
                const mod_idx: i64 = opt.unwrap();
                for (mut k: i64 = 0; k < this.entries.length; k++) {
                    if (this.entries[k].second == mod_idx &&
                        this.entries[k].first.local_name.equals(name) &&
                        this.entries[k].first.visibility.is_public()) {
                        return this.entries[k].first.entry_type;
                    }
                }
            }
        }
        return TypeRef::invalid();
    }

    /// Visibility verdict for an unqualified type `name` referenced from
    /// `use_site_module`. Returns the owning module string when the ONLY way
    /// the name resolves is to a `private` type in a DIFFERENT module (a
    /// cross-module visibility violation); returns "" when the reference is
    /// legal — i.e. the name matches a type in the same module (any
    /// visibility) or a `public` type in some other module. "" is also
    /// returned when the name isn't registered at all (a different error, if
    /// any, owns that case). Same-module and public-elsewhere matches
    /// short-circuit, so a name that is private in A but public in B is legal.
    private_owner_module(&this, name: SymbolStr, use_site_module: string) -> string {
        mut violation: string = "";
        for (mut j: i64 = 0; j < this.entries.length; j++) {
            if (!this.entries[j].first.local_name.equals(name)) { continue; }
            const mod: string = this.module_names[this.entries[j].second];
            if (mod.eq(use_site_module)) { return ""; }
            if (this.entries[j].first.visibility.is_public()) { return ""; }
            violation = mod;
        }
        return violation;
    }

    /// Get all types registered in a module.
    get_module_types(&this, module: string) -> TypeRegistryEntry[] {
        mut result: TypeRegistryEntry[] = [];
        const opt: Option<i64> = this.module_index.get(&module);
        if (opt.is_some()) {
            const mod_idx: i64 = opt.unwrap();
            for (mut j: i64 = 0; j < this.entries.length; j++) {
                if (this.entries[j].second == mod_idx) {
                    result.push(this.entries[j].first);
                }
            }
        }
        return result;
    }

    /// Get all public types registered in a module.
    get_public_types(&this, module: string) -> TypeRegistryEntry[] {
        mut result: TypeRegistryEntry[] = [];
        const opt: Option<i64> = this.module_index.get(&module);
        if (opt.is_some()) {
            const mod_idx: i64 = opt.unwrap();
            for (mut j: i64 = 0; j < this.entries.length; j++) {
                if (this.entries[j].second == mod_idx &&
                    this.entries[j].first.visibility.is_public()) {
                    result.push(this.entries[j].first);
                }
            }
        }
        return result;
    }


    // Type aliases

    /// Register a type alias.
    register_type_alias(mut &this, alias: SymbolStr, target: TypeRef) -> void {
        const h: u64 = hash_int(alias.id as u64);
        const opt: Option<i64> = this.alias_index.get(&alias.id);
        if (opt.is_some()) {
            this.aliases[opt.unwrap()].second = target;
            return;
        }
        const idx: i64 = this.aliases.length;
        this.aliases.push(Pair::new(alias, target));
        this.alias_index.insert(alias.id, idx);
    }

    /// Look up a type alias.
    lookup_alias(&this, name: SymbolStr) -> TypeRef {
        const opt: Option<i64> = this.alias_index.get(&name.id);
        if (opt.is_some()) {
            return this.aliases[opt.unwrap()].second;
        }
        return TypeRef::invalid();
    }

    /// Resolve an alias chain (follow aliases until a non-alias is found).
    /// Returns the original name if no alias exists.
    resolve_alias(&this, name: SymbolStr) -> SymbolStr {
        mut current: SymbolStr = name;
        mut max_depth: i64 = 32;  // Prevent infinite loops

        for (mut depth: i64 = 0; depth < max_depth; depth += 1) {
            const opt: Option<i64> = this.alias_base_index.get(&current.id);
            if (opt.is_some()) {
                current = this.alias_bases[opt.unwrap()].second;
            } else {
                break;
            }
        }

        return current;
    }

    /// Register an alias base name mapping (alias -> base type name).
    register_alias_base(mut &this, alias: SymbolStr, base_name: SymbolStr) -> void {
        const h: u64 = hash_int(alias.id as u64);
        const opt: Option<i64> = this.alias_base_index.get(&alias.id);
        if (opt.is_some()) {
            this.alias_bases[opt.unwrap()].second = base_name;
            return;
        }
        const idx: i64 = this.alias_bases.length;
        this.alias_bases.push(Pair::new(alias, base_name));
        this.alias_base_index.insert(alias.id, idx);
    }

    /// Check whether a module has any registered types.
    has_module(&this, module: string) -> boolean {
        return this.module_index.contains_key(&module);
    }

    /// Total number of registered modules.
    module_count(&this) -> i64 {
        return this.module_names.length;
    }
}
