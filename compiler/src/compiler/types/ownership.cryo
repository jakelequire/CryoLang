///! Ownership queries
///!
///! Pure-function predicates over types that drive Cryo's move/borrow
///! semantics. None of the queries here mutate the arena or registry;
///! they walk the type structure (and the trait-impl table for `Drop`
///! lookup) and return a boolean.
///!
///! - `is_copy(arena, registry, intern, ty)`: true when a value of `ty`
///!   may be bitwise duplicated on assignment / argument-pass / return
///!   without ownership transfer. Primitives, pointers, references and
///!   function pointers are always Copy. Aggregates (struct/class/enum/
///!   tuple) are Copy if every component is Copy AND the type carries
///!   no user-written `Drop` impl. Generic params and unresolved types
///!   are conservatively non-Copy (the worst that happens is an extra
///!   synthesized drop the optimizer removes).
///!
///! - `type_implements_drop(arena, registry, intern, ty)`: true when
///!   the trait-impl registry has an `implement trait Drop for T { ... }`
///!   block for `ty`'s base name. Used both to guard auto-derived `Copy`
///!   (`Drop` => not `Copy`) and to decide whether the `drop_insertion`
///!   pass needs to emit a `drop()` call at scope exit. Primitive `Drop`
///!   impls in `core/drop.cryo` count: they're no-op bodies, so the
///!   synthesized drops lower to nothing in IR.
///!
///! These queries are deliberately structural and trait-registry-based
///! rather than driven by attributes on the source type. That keeps the
///! `Copy` story honest: the compiler verifies the property; the user
///! doesn't assert it. Same shape Rust uses for its `Sized` marker.

namespace Compiler::Types::Ownership;

import Compiler::AST::Declaration;
import Compiler::Types;
import Compiler::Types::{ Arena, Type, TypeRef, Compound, UserDefined, Generic, GenericRegistry, Substitution };
import Compiler::Resolver::{ SymbolStr, InternTable };


// OwnershipQuery: namespace struct holding the static predicates

type struct OwnershipQuery {
    /// Top-level Copy predicate. See module doc for the full rule.
    static is_copy(arena: TypeArena*, registry: GenericRegistry*,
                   intern: InternTable*, ty: TypeRef) -> boolean {
        return OwnershipQuery::is_copy_at_depth(arena, registry, intern, ty, 0);
    }

    /// Worker for `is_copy` carrying recursion depth.  A struct that
    /// contains itself by value is rejected during type resolution, so
    /// we expect to never hit the depth cap on well-formed input; it
    /// exists strictly so a malformed arena doesn't loop forever.
    /// Treats unresolved or out-of-budget types as non-Copy
    /// (conservative: false negatives only enable extra drop calls,
    /// never UAF).
    static is_copy_at_depth(arena: TypeArena*, registry: GenericRegistry*,
                             intern: InternTable*, ty: TypeRef,
                             depth: i32) -> boolean {
        if (depth >= 32) { return false; }
        if (arena == null) { return false; }
        const t: Type* = arena.lookup(ty.id);
        if (t == null) { return false; }
        const k: TypeKind = t.kind;

        // Primitives: always bitwise duplicable.
        if (k == TypeKind::Void   || k == TypeKind::Unit  ||
            k == TypeKind::Bool   || k == TypeKind::Int   ||
            k == TypeKind::Float  || k == TypeKind::Char  ||
            k == TypeKind::String || k == TypeKind::Never) {
            return true;
        }

        // Compound: pointers and references are address-sized handles
        // and don't own the pointee. Function pointers ditto.
        if (k == TypeKind::Pointer || k == TypeKind::Reference ||
            k == TypeKind::Function) {
            return true;
        }

        // Compound: array, optional, tuple are Copy if their components
        // are Copy. Dynamic arrays carry a heap buffer, so they are
        // never Copy regardless of element type.
        if (k == TypeKind::Array) {
            const at: ArrayType* = t as ArrayType*;
            if (at.is_dynamic()) { return false; }
            return OwnershipQuery::is_copy_at_depth(arena, registry, intern,
                                                     at.element, depth + 1);
        }
        if (k == TypeKind::Optional) {
            const ot: OptionalType* = t as OptionalType*;
            return OwnershipQuery::is_copy_at_depth(arena, registry, intern,
                                                     ot.wrapped, depth + 1);
        }
        if (k == TypeKind::Tuple) {
            const tt: TupleType* = t as TupleType*;
            return OwnershipQuery::all_copy(arena, registry, intern,
                                             tt.elements, depth + 1);
        }

        // User-defined aggregates: Copy if (a) no user-written Drop
        // (trait impl OR inherent `drop` method) AND (b) every field
        // is Copy. Stdlib types use the inherent shape, user code may
        // use either.
        if (k == TypeKind::Struct) {
            const st: StructType* = t as StructType*;
            if (OwnershipQuery::type_has_drop_impl(arena, registry, intern, ty)) {
                return false;
            }
            if (OwnershipQuery::has_inherent_drop(arena, registry, intern, ty)) {
                return false;
            }
            // A union is an untagged overlay: the active member is unknown, so
            // its fields are never auto-dropped.  It is therefore Copy/POD
            // regardless of member types (unless it declares its own `drop`,
            // handled above) -- do NOT recurse into the fields.
            if (st.is_union) {
                return true;
            }
            return OwnershipQuery::all_fields_copy(arena, registry, intern,
                                                    st.fields, depth + 1);
        }
        if (k == TypeKind::Class) {
            const ct: ClassType* = t as ClassType*;
            if (OwnershipQuery::type_has_drop_impl(arena, registry, intern, ty)) {
                return false;
            }
            if (OwnershipQuery::has_inherent_drop(arena, registry, intern, ty)) {
                return false;
            }
            return OwnershipQuery::all_fields_copy(arena, registry, intern,
                                                    ct.fields, depth + 1);
        }
        if (k == TypeKind::Enum) {
            const et: EnumType* = t as EnumType*;
            if (OwnershipQuery::type_has_drop_impl(arena, registry, intern, ty)) {
                return false;
            }
            if (OwnershipQuery::has_inherent_drop(arena, registry, intern, ty)) {
                return false;
            }
            return OwnershipQuery::all_variants_copy(arena, registry, intern,
                                                      et.variants, depth + 1);
        }

        // Aliases delegate to the target type.
        if (k == TypeKind::TypeAlias) {
            const al: TypeAliasType* = t as TypeAliasType*;
            if (!al.target.is_valid()) { return false; }
            return OwnershipQuery::is_copy_at_depth(arena, registry, intern,
                                                     al.target, depth + 1);
        }

        // InstantiatedType wrappers route Drop lookup through both
        // the trait-impl registry (template's canonical base type id) and the
        // inherent-method walk (which handles the cloned spec's
        // own `drop` method). Either match marks the type non-Copy.
        if (k == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (OwnershipQuery::type_has_drop_impl(arena, registry, intern, ty)) {
                return false;
            }
            if (OwnershipQuery::has_inherent_drop(arena, registry, intern, ty)) {
                return false;
            }
            if (inst.has_resolved_type()) {
                return OwnershipQuery::is_copy_at_depth(arena, registry, intern,
                                                         inst.resolved_type, depth + 1);
            }
            return false;
        }

        // Generic params, traits, function templates, error placeholders
        // aren't valid value-positions for the Copy query; non-Copy is
        // the safe answer.
        return false;
    }

    /// True when every TypeRef in `tys` is Copy. Empty list trivially yes.
    static all_copy(arena: TypeArena*, registry: GenericRegistry*,
                    intern: InternTable*, tys: &TypeRef[],
                    depth: i32) -> boolean {
        for (mut i: i64 = 0; i < tys.length; i++) {
            if (!OwnershipQuery::is_copy_at_depth(arena, registry, intern,
                                                   tys[i], depth)) {
                return false;
            }
        }
        return true;
    }

    /// True when every FieldInfo in `fields` has a Copy field type.
    static all_fields_copy(arena: TypeArena*, registry: GenericRegistry*,
                            intern: InternTable*, fields: &FieldInfo[],
                            depth: i32) -> boolean {
        for (mut i: i64 = 0; i < fields.length; i++) {
            if (!OwnershipQuery::is_copy_at_depth(arena, registry, intern,
                                                   fields[i].field_type, depth)) {
                return false;
            }
        }
        return true;
    }

    /// True when every variant payload type list is all-Copy. C-style
    /// enums (no payloads) trivially qualify.
    static all_variants_copy(arena: TypeArena*, registry: GenericRegistry*,
                              intern: InternTable*, variants: &EnumVariantInfo[],
                              depth: i32) -> boolean {
        for (mut i: i64 = 0; i < variants.length; i++) {
            if (!OwnershipQuery::all_copy(arena, registry, intern,
                                            variants[i].payload_types, depth)) {
                return false;
            }
        }
        return true;
    }

    // Send / Sync: structural thread-safety markers.
    //
    // Mirrors the `is_copy` shape but with thread-safety rules:
    //   - Primitives, references, function pointers, raw pointers:
    //     Send + Sync.  Raw pointers being Send+Sync is the
    //     "weaker-than-Rust" stance Cryo adopts elsewhere (no borrow
    //     checker, refs unchecked): a struct that hides a `T*` field
    //     and reasons about it correctly (Box, Arc, Array, HashMap,
    //     String, ...) doesn't have to fight the type system.  Types
    //     that genuinely aren't thread-safe (Rc, MutexGuard) go on
    //     the explicit deny-list below, keyed by their leaf name.
    //   - Arrays / Optional / Tuple: Send/Sync if every component is.
    //   - Struct / Class / Enum aggregates: Send/Sync if every field
    //     (or every variant payload, for enums) is, AND the type isn't
    //     on the deny-list.
    //   - InstantiatedType: deny-list check on the template's leaf name
    //     comes first; otherwise delegate to the resolved type.
    //   - Generic params and unresolved positions: conservative false.
    //
    // Send and Sync currently share the same structural rule.  They are
    // exposed as separate predicates so future divergence (e.g. Rust's
    // `&T: Send if T: Sync` distinction) can land without an API change.

    /// True when a value of `ty` may safely transfer between threads.
    static is_send(arena: TypeArena*, registry: GenericRegistry*,
                   intern: InternTable*, ty: TypeRef) -> boolean {
        return OwnershipQuery::is_thread_safe_at_depth(arena, registry, intern, ty, 0);
    }

    /// True when a value of `ty` may safely be shared by reference
    /// between threads.
    static is_sync(arena: TypeArena*, registry: GenericRegistry*,
                   intern: InternTable*, ty: TypeRef) -> boolean {
        return OwnershipQuery::is_thread_safe_at_depth(arena, registry, intern, ty, 0);
    }

    /// Worker shared by `is_send` and `is_sync`.  Tracks recursion
    /// depth to bail out of pathological arena chains the same way
    /// `is_copy_at_depth` does.  Returns `false` for any unresolved /
    /// out-of-budget input - false negatives only forbid extra
    /// thread-crossings, never enable an unsound one.
    static is_thread_safe_at_depth(arena: TypeArena*, registry: GenericRegistry*,
                                    intern: InternTable*, ty: TypeRef,
                                    depth: i32) -> boolean {
        if (depth >= 32) { return false; }
        if (arena == null) { return false; }
        const t: Type* = arena.lookup(ty.id);
        if (t == null) { return false; }
        const k: TypeKind = t.kind;

        // Primitives are bitwise-portable and don't carry hidden state.
        if (k == TypeKind::Void   || k == TypeKind::Unit  ||
            k == TypeKind::Bool   || k == TypeKind::Int   ||
            k == TypeKind::Float  || k == TypeKind::Char  ||
            k == TypeKind::String || k == TypeKind::Never) {
            return true;
        }

        // References, function pointers, and raw pointers: all Send +
        // Sync.  Cryo lacks borrow-checked lifetimes, so references are
        // unchecked address handles like raw pointers; treating them
        // identically keeps the rule simple.  Stdlib container types
        // (Box, Arc, Array, HashMap, String, ...) all hide a raw pointer
        // and depend on this rule to inherit Send/Sync from their
        // generic args.  Genuinely-unsafe types go on the deny-list.
        if (k == TypeKind::Pointer   || k == TypeKind::Reference ||
            k == TypeKind::Function) {
            return true;
        }

        // Compound aggregates: thread-safe if every component is.
        if (k == TypeKind::Array) {
            const at: ArrayType* = t as ArrayType*;
            if (at.is_dynamic()) {
                // A dynamic-array type alone isn't a value position;
                // Array<T> is a Struct and walks the field rule below.
                return false;
            }
            return OwnershipQuery::is_thread_safe_at_depth(arena, registry, intern,
                                                            at.element, depth + 1);
        }
        if (k == TypeKind::Optional) {
            const ot: OptionalType* = t as OptionalType*;
            return OwnershipQuery::is_thread_safe_at_depth(arena, registry, intern,
                                                            ot.wrapped, depth + 1);
        }
        if (k == TypeKind::Tuple) {
            const tt: TupleType* = t as TupleType*;
            return OwnershipQuery::all_thread_safe(arena, registry, intern,
                                                    tt.elements, depth + 1);
        }

        // User aggregates: deny-list first (Rc and friends), then
        // structural field walk.
        if (k == TypeKind::Struct) {
            const st: StructType* = t as StructType*;
            if (OwnershipQuery::is_thread_safety_denied(arena, intern, ty)) {
                return false;
            }
            return OwnershipQuery::all_fields_thread_safe(arena, registry, intern,
                                                           st.fields, depth + 1);
        }
        if (k == TypeKind::Class) {
            const ct: ClassType* = t as ClassType*;
            if (OwnershipQuery::is_thread_safety_denied(arena, intern, ty)) {
                return false;
            }
            return OwnershipQuery::all_fields_thread_safe(arena, registry, intern,
                                                           ct.fields, depth + 1);
        }
        if (k == TypeKind::Enum) {
            const et: EnumType* = t as EnumType*;
            if (OwnershipQuery::is_thread_safety_denied(arena, intern, ty)) {
                return false;
            }
            return OwnershipQuery::all_variants_thread_safe(arena, registry, intern,
                                                             et.variants, depth + 1);
        }

        if (k == TypeKind::TypeAlias) {
            const al: TypeAliasType* = t as TypeAliasType*;
            if (!al.target.is_valid()) { return false; }
            return OwnershipQuery::is_thread_safe_at_depth(arena, registry, intern,
                                                            al.target, depth + 1);
        }

        if (k == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            // Deny-list check on the template's canonical identity catches
            // `Rc<T>` even when its type_args[0] is itself thread-safe.
            if (OwnershipQuery::is_thread_safety_denied(arena, intern, ty)) {
                return false;
            }
            if (inst.has_resolved_type()) {
                return OwnershipQuery::is_thread_safe_at_depth(arena, registry, intern,
                                                                inst.resolved_type, depth + 1);
            }
            // Mono-after-sema: the instantiation has no concrete spec yet (the
            // monomorphizer runs after sema, which owns `where`-bound checks).
            // Walk the template's declared components with the instantiation's
            // type args substituted in, so the marker query is correct
            // pre-mono - e.g. `Atomic<u32>` (field `value: T` with T=u32) is
            // Send even before its concrete struct exists.
            return OwnershipQuery::inst_template_thread_safe(arena, registry,
                                                              intern, inst, depth + 1);
        }

        // Generic params, traits, function templates: not concrete
        // value positions for the marker query.  Conservative false.
        return false;
    }

    /// Thread-safety for an UNRESOLVED generic instantiation, computed off the
    /// template's declaration plus the instantiation's type args.  Required
    /// now that sema (which owns `where`-bound satisfaction) runs BEFORE the
    /// monomorphizer creates the concrete spec the resolved-type walk needs.
    /// Struct/class fields come from the AST (their `resolved_type` carries the
    /// abstract field types post-TypeResolution); enum variant payloads come
    /// from the template's arena type.  Each component type is substituted
    /// (`T -> u32`) and recursed.  Returns false when the template or a
    /// component can't be recovered - conservatively forbidding the bound
    /// rather than enabling an unsound thread-crossing (matching the
    /// conservative-false policy of the rest of this query).
    static inst_template_thread_safe(arena: TypeArena*, registry: GenericRegistry*,
                                      intern: InternTable*, inst: InstantiatedType*,
                                      depth: i32) -> boolean {
        if (depth >= 32) { return false; }
        if (registry == null) { return false; }
        const tmpl: TemplateEntry* =
            registry.get_template_by_type_id(inst.generic_base.id);
        if (tmpl == null) { return false; }
        if (tmpl.param_type_ids.length != inst.type_args.length) { return false; }
        mut subst: TypeSubstitution =
            TypeSubstitution::from_params(&tmpl.param_type_ids, &inst.type_args);

        if (tmpl.node_kind == NodeKind::StructDeclaration && tmpl.ast_node != null) {
            const sn: StructDeclNode* = tmpl.ast_node as StructDeclNode*;
            for (mut i: i64 = 0; i < sn.fields.length; i++) {
                const f: FieldDeclNode* = sn.fields[i];
                if (f == null || !f.resolved_type.is_valid()) { return false; }
                const ft: TypeRef = subst.apply(f.resolved_type, arena);
                if (!OwnershipQuery::is_thread_safe_at_depth(arena, registry, intern,
                                                              ft, depth + 1)) {
                    return false;
                }
            }
            return true;
        }
        if (tmpl.node_kind == NodeKind::UnionDeclaration && tmpl.ast_node != null) {
            const un: UnionDeclNode* = tmpl.ast_node as UnionDeclNode*;
            for (mut i: i64 = 0; i < un.fields.length; i++) {
                const f: FieldDeclNode* = un.fields[i];
                if (f == null || !f.resolved_type.is_valid()) { return false; }
                const ft: TypeRef = subst.apply(f.resolved_type, arena);
                if (!OwnershipQuery::is_thread_safe_at_depth(arena, registry, intern,
                                                              ft, depth + 1)) {
                    return false;
                }
            }
            return true;
        }
        if (tmpl.node_kind == NodeKind::ClassDeclaration && tmpl.ast_node != null) {
            const cn: ClassDeclNode* = tmpl.ast_node as ClassDeclNode*;
            for (mut i: i64 = 0; i < cn.fields.length; i++) {
                const f: FieldDeclNode* = cn.fields[i];
                if (f == null || !f.resolved_type.is_valid()) { return false; }
                const ft: TypeRef = subst.apply(f.resolved_type, arena);
                if (!OwnershipQuery::is_thread_safe_at_depth(arena, registry, intern,
                                                              ft, depth + 1)) {
                    return false;
                }
            }
            return true;
        }
        if (tmpl.node_kind == NodeKind::EnumDeclaration) {
            // Variant payloads aren't on the AST as resolved TypeRefs (only as
            // annotations); read them off the template's arena enum type.
            const base_t: Type* = arena.lookup(inst.generic_base.id);
            if (base_t == null || base_t.kind != TypeKind::Enum) { return false; }
            const et: EnumType* = base_t as EnumType*;
            for (mut vi: i64 = 0; vi < et.variants.length; vi++) {
                const payloads: &TypeRef[] = &et.variants[vi].payload_types;
                for (mut pi: i64 = 0; pi < payloads.length; pi++) {
                    const pt: TypeRef = subst.apply(payloads[pi], arena);
                    if (!OwnershipQuery::is_thread_safe_at_depth(arena, registry,
                                                                  intern, pt, depth + 1)) {
                        return false;
                    }
                }
            }
            return true;
        }
        return false;
    }

    /// True when every element type in `tys` is Send/Sync.
    static all_thread_safe(arena: TypeArena*, registry: GenericRegistry*,
                            intern: InternTable*, tys: &TypeRef[],
                            depth: i32) -> boolean {
        for (mut i: i64 = 0; i < tys.length; i++) {
            if (!OwnershipQuery::is_thread_safe_at_depth(arena, registry, intern,
                                                          tys[i], depth)) {
                return false;
            }
        }
        return true;
    }

    /// True when every field's type is Send/Sync.
    static all_fields_thread_safe(arena: TypeArena*, registry: GenericRegistry*,
                                    intern: InternTable*, fields: &FieldInfo[],
                                    depth: i32) -> boolean {
        for (mut i: i64 = 0; i < fields.length; i++) {
            if (!OwnershipQuery::is_thread_safe_at_depth(arena, registry, intern,
                                                          fields[i].field_type, depth)) {
                return false;
            }
        }
        return true;
    }

    /// True when every variant payload list is all-Send/Sync.
    static all_variants_thread_safe(arena: TypeArena*, registry: GenericRegistry*,
                                      intern: InternTable*, variants: &EnumVariantInfo[],
                                      depth: i32) -> boolean {
        for (mut i: i64 = 0; i < variants.length; i++) {
            if (!OwnershipQuery::all_thread_safe(arena, registry, intern,
                                                   variants[i].payload_types, depth)) {
                return false;
            }
        }
        return true;
    }

    /// True when `ty` IS a stdlib type that is inherently !Send + !Sync
    /// regardless of its component types:
    ///   - `Rc` : single-threaded reference counting.
    ///   - `MutexGuard`, `RwLockReadGuard`, `RwLockWriteGuard` :
    ///     pthread mutex/rwlock primitives require unlock from the
    ///     same thread that acquired the lock, so a guard cannot
    ///     cross threads.
    ///
    /// Keyed on the target's canonical QUALIFIED-NAME identity (via
    /// `named_qualified_id`, peeling an `InstantiatedType` to its template), NOT
    /// the bare leaf: a USER type merely NAMED `Rc` must not be denied Send/Sync.
    /// Conservative direction (a false deny is over-restrictive, not unsound),
    /// but keyed precisely so only the actual stdlib types are denied.
    static is_thread_safety_denied(arena: TypeArena*, intern: InternTable*,
                                   ty: TypeRef) -> boolean {
        if (arena == null || intern == null) { return false; }
        const qid: u64 = OwnershipQuery::named_qualified_id(arena, intern, ty);
        if (qid == 0) { return false; }
        if (qid == intern.intern("std::alloc::rc::Rc").id as u64) { return true; }
        if (qid == intern.intern("std::sync::mutex::MutexGuard").id as u64) { return true; }
        if (qid == intern.intern("std::sync::rwlock::RwLockReadGuard").id as u64) { return true; }
        if (qid == intern.intern("std::sync::rwlock::RwLockWriteGuard").id as u64) { return true; }
        return false;
    }

    // needs_drop: does scope-exit drop glue have to run for `ty`?
    //
    // True when a value of `ty` owns a resource that must be released at
    // scope exit - either it (or a base/template) carries a user-written
    // `drop`, or it is an aggregate transitively containing such a type.
    //
    // This is the complement of `is_copy` for concrete value types, with one
    // deliberate difference: it returns FALSE for generic params, traits,
    // and unresolved types.  Those are never dropped directly (drop_insertion
    // only runs on monomorphized bodies, where every droppable position is
    // concrete); reporting them as needs-drop would make codegen synthesise a
    // drop call it cannot lower.
    //
    // A type that carries its OWN user drop returns true immediately and the
    // recursion stops: Cryo's convention is that a hand-written `drop`
    // releases everything the value owns, so drop-glue codegen must call that
    // drop and NOT also recurse into the fields (which would double-free).
    static needs_drop(arena: TypeArena*, registry: GenericRegistry*,
                      intern: InternTable*, ty: TypeRef) -> boolean {
        return OwnershipQuery::needs_drop_at_depth(arena, registry, intern, ty, 0);
    }

    static needs_drop_at_depth(arena: TypeArena*, registry: GenericRegistry*,
                               intern: InternTable*, ty: TypeRef,
                               depth: i32) -> boolean {
        if (depth >= 32) { return false; }
        if (arena == null) { return false; }
        const t: Type* = arena.lookup(ty.id);
        if (t == null) { return false; }
        const k: TypeKind = t.kind;

        // Scalars and address-sized handles never own their referent.
        if (k == TypeKind::Void    || k == TypeKind::Unit  ||
            k == TypeKind::Bool    || k == TypeKind::Int   ||
            k == TypeKind::Float   || k == TypeKind::Char  ||
            k == TypeKind::String  || k == TypeKind::Never ||
            k == TypeKind::Pointer || k == TypeKind::Reference ||
            k == TypeKind::Function) {
            return false;
        }

        // A user-written drop (trait impl or inherent method) is
        // authoritative and self-contained: stop here.
        if (OwnershipQuery::has_inherent_drop(arena, registry, intern, ty) ||
            OwnershipQuery::type_implements_drop(arena, registry, intern, ty)) {
            return true;
        }

        if (k == TypeKind::Array) {
            const at: ArrayType* = t as ArrayType*;
            // A heap-backed `T[]` owns a malloc'd buffer (and transitively
            // its elements), so it always needs drop regardless of element
            // type.  Its synthesized `.drop()` dispatches to the
            // byte-compatible `Array<T>::drop` (call_emitter), which drops
            // each element in place and then frees the buffer.
            if (at.is_heap_dynamic()) { return true; }
            // A fixed array whose named-const/computed size is still pending
            // (FIXED_PENDING) owns no heap buffer; we also can't see its
            // element count, so don't synthesize a drop (matches the prior
            // behavior for all `size < 0` arrays).
            if (at.is_dynamic()) { return false; }
            // A resolved fixed array `[E; N]` drops if its element does.
            return OwnershipQuery::needs_drop_at_depth(arena, registry, intern,
                                                       at.element, depth + 1);
        }
        if (k == TypeKind::Optional) {
            const ot: OptionalType* = t as OptionalType*;
            return OwnershipQuery::needs_drop_at_depth(arena, registry, intern,
                                                       ot.wrapped, depth + 1);
        }
        if (k == TypeKind::Tuple) {
            const tt: TupleType* = t as TupleType*;
            return OwnershipQuery::any_needs_drop(arena, registry, intern,
                                                  tt.elements, depth + 1);
        }
        if (k == TypeKind::Struct) {
            const st: StructType* = t as StructType*;
            // A union never auto-drops its members (untagged: the active member
            // is unknown).  Any user-written `drop` was already handled above
            // and returned true; here a union owns nothing droppable.
            if (st.is_union) {
                return false;
            }
            return OwnershipQuery::any_field_needs_drop(arena, registry, intern,
                                                        st.fields, depth + 1);
        }
        if (k == TypeKind::Class) {
            const ct: ClassType* = t as ClassType*;
            return OwnershipQuery::any_field_needs_drop(arena, registry, intern,
                                                        ct.fields, depth + 1);
        }
        if (k == TypeKind::Enum) {
            const et: EnumType* = t as EnumType*;
            return OwnershipQuery::any_variant_needs_drop(arena, registry, intern,
                                                          et.variants, depth + 1);
        }
        if (k == TypeKind::TypeAlias) {
            const al: TypeAliasType* = t as TypeAliasType*;
            if (!al.target.is_valid()) { return false; }
            return OwnershipQuery::needs_drop_at_depth(arena, registry, intern,
                                                       al.target, depth + 1);
        }
        if (k == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            if (inst.has_resolved_type()) {
                return OwnershipQuery::needs_drop_at_depth(arena, registry, intern,
                                                           inst.resolved_type, depth + 1);
            }
            return false;
        }
        // Generic params, traits, templates, error placeholders: not a
        // concrete droppable value position.
        return false;
    }

    /// True when any element type in `tys` needs drop.
    static any_needs_drop(arena: TypeArena*, registry: GenericRegistry*,
                          intern: InternTable*, tys: &TypeRef[],
                          depth: i32) -> boolean {
        for (mut i: i64 = 0; i < tys.length; i++) {
            if (OwnershipQuery::needs_drop_at_depth(arena, registry, intern,
                                                    tys[i], depth)) {
                return true;
            }
        }
        return false;
    }

    /// True when any field's type needs drop.
    static any_field_needs_drop(arena: TypeArena*, registry: GenericRegistry*,
                                intern: InternTable*, fields: &FieldInfo[],
                                depth: i32) -> boolean {
        for (mut i: i64 = 0; i < fields.length; i++) {
            if (OwnershipQuery::needs_drop_at_depth(arena, registry, intern,
                                                    fields[i].field_type, depth)) {
                return true;
            }
        }
        return false;
    }

    /// True when any variant payload type needs drop.
    static any_variant_needs_drop(arena: TypeArena*, registry: GenericRegistry*,
                                  intern: InternTable*, variants: &EnumVariantInfo[],
                                  depth: i32) -> boolean {
        for (mut i: i64 = 0; i < variants.length; i++) {
            if (OwnershipQuery::any_needs_drop(arena, registry, intern,
                                               variants[i].payload_types, depth)) {
                return true;
            }
        }
        return false;
    }

    /// Top-level Drop-impl predicate. Reports whether `implement trait Drop for
    /// <ty> { ... }` was registered, using the PRECISE (collision-proof) type
    /// identity when available and falling back to the bare-name lookup
    /// otherwise (see `type_has_drop_impl`).
    static type_implements_drop(arena: TypeArena*, registry: GenericRegistry*,
                                 intern: InternTable*, ty: TypeRef) -> boolean {
        return OwnershipQuery::type_has_drop_impl(arena, registry, intern, ty);
    }

    /// The target's canonical QUALIFIED-NAME identity for a NAMED aggregate
    /// (struct/class/enum), peeling an `InstantiatedType` to its template via
    /// `generic_base`.  Returns the interned qualified-name SymbolStr id (a
    /// module-independent identity that distinguishes same-leaf types like a
    /// local `Pair` vs stdlib `std::collections::pair::Pair`).  Returns 0 for
    /// anything else (primitive, pointer, alias, tuple, unresolved) - those
    /// never carry a user `Drop` we key precisely, and 0 tells the caller to use
    /// the bare-name fallback.
    ///
    /// This keys on the interned qualified NAME rather than the arena TYPE id on
    /// purpose: the same nominal type can be materialised under several arena
    /// type ids across passes (a decl entry vs a field-type resolution vs a
    /// monomorphized spec), so a type-id key registered in one pass MISSES when
    /// the query in a later pass carries a different id for the same type - an
    /// allocation-order-dependent false negative that silently drops a real
    /// `Drop`.  The qualified name is canonical per nominal type, so the
    /// registration side (type_resolution R1) and every lookup side agree.
    static named_qualified_id(arena: TypeArena*, intern: InternTable*,
                              ty: TypeRef) -> u64 {
        if (arena == null || intern == null || !ty.is_valid()) { return 0; }
        const t: Type* = arena.lookup(ty.id);
        if (t == null) { return 0; }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            return OwnershipQuery::named_qualified_id(arena, intern,
                                                       inst.generic_base);
        }
        if (t.kind == TypeKind::Struct || t.kind == TypeKind::Class ||
            t.kind == TypeKind::Enum) {
            const qname: SymbolStr = OwnershipQuery::qualified_name_of(arena, ty);
            if (!qname.is_valid()) { return 0; }
            // The qualified-name SymbolStr id is canonical in the single shared
            // intern table, so it is directly comparable across passes and
            // between the registration and lookup sides (both reach here).
            return qname.id as u64;
        }
        return 0;
    }

    /// Precise, collision-proof "does `ty` carry a user `Drop` trait impl?".
    ///
    /// When `ty`'s base type is a named aggregate AND its `(Drop, leaf)` pair was
    /// precisely registered (some type with that leaf has a Drop impl), the
    /// QUALIFIED-NAME index is authoritative: a hit means Drop, a MISS is a
    /// genuine negative - this is what stops a user `Pair` from inheriting stdlib
    /// `Pair<A,B>`'s Drop by bare-name collision.  Otherwise (unresolvable base,
    /// or a leaf never precisely registered) we fall back to the historical
    /// bare-name lookup, so a Drop impl can never be MISSED (the fatal
    /// direction) - the fix only ever REMOVES false positives.
    static type_has_drop_impl(arena: TypeArena*, registry: GenericRegistry*,
                              intern: InternTable*, ty: TypeRef) -> boolean {
        if (arena == null || registry == null || intern == null) { return false; }
        const drop_name: SymbolStr = intern.intern("Drop");
        if (!drop_name.is_valid()) { return false; }
        const leaf: SymbolStr = OwnershipQuery::registry_name_of(arena, intern, ty);
        const qual_id: u64 = OwnershipQuery::named_qualified_id(arena, intern, ty);
        if (qual_id != 0 && registry.is_precise_trait_leaf(drop_name, leaf)) {
            // Authoritative precise path: a miss here is a true negative.
            return registry.has_trait_impl_typed(drop_name, qual_id);
        }
        // Fallback: bare-name lookup (old behaviour, safe/conservative).
        if (!leaf.is_valid()) { return false; }
        return OwnershipQuery::has_drop_impl(registry, intern, leaf);
    }

    /// Precise, collision-proof trait-impl lookup for ANY trait — the general
    /// form of `type_has_drop_impl`.  Returns the `implement trait <T> for <ty>`
    /// block, disambiguating same-leaf types (a local `Cell` vs another module's
    /// `Cell`, both implementing `Clone`) by the target's canonical
    /// QUALIFIED-NAME identity, and falling back to the historical bare-leaf
    /// lookup when `ty` is not a precisely-registered named aggregate.
    ///
    /// `ty` should be normalized to its InstantiatedType wrapper by the caller
    /// (every reroute site already does, via `TypeArena::find_inst_wrapping`), so
    /// `named_qualified_id` peels to the template's qualified name and matches the
    /// registration key.  The trait name is normalized to its LEAF on BOTH sides
    /// (`leaf_segment` here, and at the type_resolution R1 registration) so a
    /// qualified `implement trait Mod::Tr` and a bare `implement trait Tr` share
    /// one key.  Failure mode is a loud compile error (never a UAF), so the
    /// precise path is authoritative: a miss for a precisely-registered leaf is a
    /// genuine negative.
    static resolve_trait_impl_for_type(arena: TypeArena*, registry: GenericRegistry*,
                                       intern: InternTable*, trait_name: SymbolStr,
                                       ty: TypeRef) -> ImplBlockNode* {
        if (arena == null || registry == null || intern == null) { return null; }
        const trait_leaf: SymbolStr = OwnershipQuery::leaf_segment(intern, trait_name);
        const leaf: SymbolStr = OwnershipQuery::registry_name_of(arena, intern, ty);
        if (leaf.is_valid() && trait_leaf.is_valid()
                && registry.is_precise_trait_leaf(trait_leaf, leaf)) {
            const qual_id: u64 = OwnershipQuery::named_qualified_id(arena, intern, ty);
            if (qual_id != 0) {
                // Authoritative precise path: a miss here is a true negative.
                return registry.lookup_trait_impl_typed(trait_leaf, qual_id);
            }
        }
        // Fallback: historical bare-leaf lookup (keyed on the ORIGINAL trait
        // name, matching how `lookup_trait_impl`'s bare index was written).
        if (!leaf.is_valid()) { return null; }
        return registry.lookup_trait_impl(trait_name, leaf);
    }

    /// Internal: true when the trait-impl registry has a `Drop` impl
    /// keyed under `target`. Used by `is_copy` (Drop => not Copy) and
    /// the drop-insertion pass. Note: stdlib types currently express
    /// Drop as an *inherent* `drop(mut &this) -> void` method rather
    /// than `implement trait Drop for T { ... }`, so this lookup
    /// only catches user code that opts into the trait shape. The
    /// inherent-method case is handled directly in `is_copy_at_depth`
    /// via `has_inherent_drop`.
    static has_drop_impl(registry: GenericRegistry*, intern: InternTable*,
                          target: SymbolStr) -> boolean {
        if (registry == null || intern == null || !target.is_valid()) {
            return false;
        }
        const drop_name: SymbolStr = intern.intern("Drop");
        if (!drop_name.is_valid()) { return false; }
        const direct: ImplBlockNode* = registry.lookup_trait_impl(drop_name, target);
        return direct != null;
    }

    /// True when a Struct/Class type's AST declares an inherent `drop`
    /// method. Cryo's stdlib expresses ownership-handoff via inherent
    /// `drop` rather than `implement trait Drop`, so this is the predicate
    /// that actually drives Copy/non-Copy classification for stdlib types
    /// like `Box<T>`, `String`, `Array<T>`, `HashMap<K, V>`. The
    /// type-arena's `StructType.methods` is currently empty for most
    /// declarations (methods live only on the AST), so we go through
    /// the template registry to recover the original `StructDeclNode`
    /// or `ClassDeclNode` and walk its `methods[]` array.
    static has_inherent_drop(arena: TypeArena*, registry: GenericRegistry*,
                              intern: InternTable*, ty: TypeRef) -> boolean {
        if (arena == null || registry == null || intern == null) { return false; }
        const drop_sym: SymbolStr = intern.intern("drop");
        if (!drop_sym.is_valid()) { return false; }

        // For an InstantiatedType, route to the template's AST.
        const t: Type* = arena.lookup(ty.id);
        if (t == null) { return false; }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            return OwnershipQuery::has_inherent_drop(arena, registry, intern,
                                                      inst.generic_base);
        }

        const qname: SymbolStr = OwnershipQuery::qualified_name_of(arena, ty);
        if (!qname.is_valid()) { return false; }

        // Templated types (e.g. `Box<T>`) live in `entries`. Check
        // both the inline methods and any `implement` blocks attached
        // to the template; Box's `drop` is inline, but Enum decls
        // route inherent methods through impl blocks.
        const tmpl: TemplateEntry* = registry.get_template(qname);
        if (tmpl != null) {
            if (tmpl.ast_node != null &&
                OwnershipQuery::ast_has_drop(tmpl.ast_node, tmpl.node_kind, drop_sym)) {
                return true;
            }
            if (OwnershipQuery::impl_blocks_have_drop(tmpl, drop_sym)) {
                return true;
            }
        }

        // Non-generic types might be registered as inherent owners only.
        const owner_ast: ASTNode* = registry.lookup_inherent_owner(qname);
        if (owner_ast != null &&
            OwnershipQuery::ast_has_drop(owner_ast, owner_ast.kind, drop_sym)) {
            return true;
        }
        // The inherent `drop` may instead live in a separate
        // `implement T { ... }` block.  For a non-generic `T` that block
        // has no TemplateEntry (so the `tmpl` path above misses it) and is
        // not on the type-decl node (so `lookup_inherent_owner` misses it);
        // it is recorded in the inherent-impl-block index at registration.
        if (registry.inherent_impl_has_method(qname, drop_sym)) {
            return true;
        }
        return false;
    }

    /// Walk a declaration AST node's inline `methods[]` array for a
    /// method named `drop`. Handles StructDeclNode and ClassDeclNode
    /// EnumDeclNode methods live on a separate `implement enum Foo`
    /// impl block, which the caller picks up via the TemplateEntry's
    /// `impl_blocks` array (see `has_inherent_drop`).
    static ast_has_drop(node: ASTNode*, kind: NodeKind,
                         drop_sym: SymbolStr) -> boolean {
        if (node == null) { return false; }
        if (kind == NodeKind::StructDeclaration) {
            const decl: StructDeclNode* = node as StructDeclNode*;
            for (mut i: i64 = 0; i < decl.methods.length; i++) {
                const m: MethodNode* = decl.methods[i];
                if (m == null || m.func == null) { continue; }
                if (m.func.name.equals(drop_sym)) { return true; }
            }
            return false;
        }
        if (kind == NodeKind::UnionDeclaration) {
            const decl: UnionDeclNode* = node as UnionDeclNode*;
            for (mut i: i64 = 0; i < decl.methods.length; i++) {
                const m: MethodNode* = decl.methods[i];
                if (m == null || m.func == null) { continue; }
                if (m.func.name.equals(drop_sym)) { return true; }
            }
            return false;
        }
        if (kind == NodeKind::ClassDeclaration) {
            const decl: ClassDeclNode* = node as ClassDeclNode*;
            for (mut i: i64 = 0; i < decl.methods.length; i++) {
                const m: MethodNode* = decl.methods[i];
                if (m == null || m.func == null) { continue; }
                if (m.func.name.equals(drop_sym)) { return true; }
            }
            return false;
        }
        return false;
    }

    /// Walk all impl_blocks attached to `tmpl`, scanning each for a
    /// method named `drop`. Used for types whose inherent methods
    /// live in `implement` blocks rather than inline.
    static impl_blocks_have_drop(tmpl: TemplateEntry*,
                                  drop_sym: SymbolStr) -> boolean {
        if (tmpl == null) { return false; }
        for (mut i: i64 = 0; i < tmpl.impl_blocks.length; i++) {
            const ib: ImplBlockNode* = tmpl.impl_blocks[i];
            if (ib == null) { continue; }
            for (mut j: i64 = 0; j < ib.methods.length; j++) {
                const m: MethodNode* = ib.methods[j];
                if (m == null || m.func == null) { continue; }
                if (m.func.name.equals(drop_sym)) { return true; }
            }
        }
        return false;
    }

    /// Pull a registry-keyable bare name out of a TypeRef. Mirrors
    /// `Monomorphizer::bare_name_of`: primitives return their display
    /// name; user-defined types return the last `::` segment of the
    /// qualified name; instantiations route to the TEMPLATE's bare
    /// name (not the spec) since trait impls are keyed against the
    /// template.
    static registry_name_of(arena: TypeArena*, intern: InternTable*,
                             ty: TypeRef) -> SymbolStr {
        const t: Type* = arena.lookup(ty.id);
        if (t == null) { return SymbolStr::empty(); }
        const k: TypeKind = t.kind;
        if (k == TypeKind::Int || k == TypeKind::Float || k == TypeKind::Bool ||
            k == TypeKind::Char || k == TypeKind::String) {
            return intern.intern(t.display_name());
        }
        if (k == TypeKind::Unit || k == TypeKind::Void) {
            return SymbolStr::empty();
        }
        // Walk through the template-base of an instantiation rather
        // than the resolved spec; `(Drop, Box)` is the registry key,
        // not `(Drop, Box_i32)`.
        if (k == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            return OwnershipQuery::registry_name_of(arena, intern,
                                                     inst.generic_base);
        }
        // For all named user-defined types, take the bare leaf of the
        // qualified name, matching how trait_impl_key() in the registry
        // pairs trait + target by their bare-leaf SymbolStr.id.
        const qname: SymbolStr = OwnershipQuery::qualified_name_of(arena, ty);
        if (!qname.is_valid()) { return SymbolStr::empty(); }
        return OwnershipQuery::leaf_segment(intern, qname);
    }

    /// Get the qualified-name SymbolStr for a Type. Centralises the
    /// per-kind field access so `registry_name_of` stays compact.
    static qualified_name_of(arena: TypeArena*, ty: TypeRef) -> SymbolStr {
        const t: Type* = arena.lookup(ty.id);
        if (t == null) { return SymbolStr::empty(); }
        const k: TypeKind = t.kind;
        if (k == TypeKind::Struct) {
            const st: StructType* = t as StructType*;
            return st.qualified_name;
        }
        if (k == TypeKind::Class) {
            const ct: ClassType* = t as ClassType*;
            return ct.qualified_name;
        }
        if (k == TypeKind::Enum) {
            const et: EnumType* = t as EnumType*;
            return et.qualified_name;
        }
        if (k == TypeKind::TypeAlias) {
            const al: TypeAliasType* = t as TypeAliasType*;
            return al.alias_name;
        }
        return arena.get_qualified_name(ty);
    }

    /// Does a call to `method` move the receiver out of the caller?
    ///
    /// True when either:
    ///   1. The method carries `![sink]` (the user explicitly
    ///      tagged it as consuming, regardless of receiver syntax).
    ///   2. The receiver parameter is by-value (i.e. `this` or
    ///      `mut this`, lowered to a non-reference type on the first
    ///      parameter slot).  References (`&this` / `mut &this`) lower
    ///      to a `ReferenceType` and never consume on their own.
    ///
    /// Static methods (no receiver) always return false.  Methods with
    /// an unresolved first-param type return false conservatively;
    /// the worst that happens is a missed consume diagnostic; the
    /// alternative would be a false-positive use-after-move warning.
    static method_consumes_receiver(arena: TypeArena*, intern: InternTable*,
                                     method: MethodNode*) -> boolean {
        if (method == null) { return false; }
        if (method.is_static)         { return false; }
        if (method.is_sink)  { return true; }
        if (method.func == null)      { return false; }
        if (method.func.parameters.length == 0) { return false; }
        const recv: VarDeclNode* = method.func.parameters[0];
        if (recv == null || !recv.has_resolved_type()) { return false; }
        // Only an explicit by-value `this` receiver consumes. The receiver
        // token is named "this" (by-value) or "&this" (reference); a method
        // that omits the receiver and starts with an ordinary parameter -
        // e.g. the visitor pattern's `visit(node: X*)`, which uses an
        // implicit borrow receiver and whose first parameter is `node`, not
        // `this` - must NOT be read as consuming its receiver. Keying on the
        // parameter NAME (rather than its type) is what makes this precise:
        // a non-receiver first parameter can be any type, including a bare
        // value, so a type-only check would misclassify it.
        if (intern != null) {
            if (recv.name.id != intern.intern("this").id) { return false; }
        }
        if (arena == null) { return false; }
        const t: Type* = arena.lookup(recv.resolved_type.id);
        if (t == null) { return false; }
        // Reference / pointer receivers (`&this` / `mut &this`) borrow.
        if (t.kind == TypeKind::Reference || t.kind == TypeKind::Pointer) {
            return false;
        }
        // A by-value `this` receiver: taken and dropped by the callee.
        return true;
    }

    /// Receiver-type + method-name fallback for `method_consumes_receiver`,
    /// used by drop-insertion when a call's `resolved_method` is null (e.g. a
    /// monomorphized generic method call that sema did not pin).  Looks the
    /// method up on `recv_ty`'s template / impl-blocks and reports whether
    /// any matching overload consumes the receiver.  Without this, an
    /// `![sink]` combinator like `Option<T>::unwrap` fails to mark its
    /// receiver moved and drop glue double-frees the payload it copied out.
    ///
    /// Safe-biased: a false "consumes" only suppresses a glue drop (a leak),
    /// never adds one (which could double-free).  Overloads where any match
    /// consumes therefore answer true.
    static type_method_consumes(arena: TypeArena*, registry: GenericRegistry*,
                                intern: InternTable*, recv_ty: TypeRef,
                                method_name: SymbolStr) -> boolean {
        if (arena == null || registry == null || intern == null) { return false; }
        if (!method_name.is_valid()) { return false; }
        const t: Type* = arena.lookup(recv_ty.id);
        if (t == null) { return false; }
        // Peel reference / pointer / instantiation to the named type.
        if (t.kind == TypeKind::Reference) {
            const rt: ReferenceType* = t as ReferenceType*;
            return OwnershipQuery::type_method_consumes(arena, registry, intern,
                                                        rt.referent, method_name);
        }
        if (t.kind == TypeKind::Pointer) {
            const pt: PointerType* = t as PointerType*;
            return OwnershipQuery::type_method_consumes(arena, registry, intern,
                                                        pt.pointee, method_name);
        }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            return OwnershipQuery::type_method_consumes(arena, registry, intern,
                                                        inst.generic_base, method_name);
        }
        const qname: SymbolStr = OwnershipQuery::qualified_name_of(arena, recv_ty);
        if (!qname.is_valid()) { return false; }
        const tmpl: TemplateEntry* = registry.get_template(qname);
        if (tmpl != null) {
            if (tmpl.ast_node != null &&
                OwnershipQuery::ast_method_consumes(arena, intern, tmpl.ast_node,
                                                    tmpl.node_kind, method_name)) {
                return true;
            }
            if (OwnershipQuery::impl_blocks_method_consumes(arena, intern, tmpl, method_name)) {
                return true;
            }
        }
        const owner_ast: ASTNode* = registry.lookup_inherent_owner(qname);
        if (owner_ast != null &&
            OwnershipQuery::ast_method_consumes(arena, intern, owner_ast, owner_ast.kind,
                                                method_name)) {
            return true;
        }
        return false;
    }

    /// Scan a struct/class decl's inline methods for one named `method_name`
    /// that consumes its receiver.
    static ast_method_consumes(arena: TypeArena*, intern: InternTable*,
                               node: ASTNode*,
                               kind: NodeKind, method_name: SymbolStr) -> boolean {
        if (node == null) { return false; }
        if (kind == NodeKind::StructDeclaration) {
            const decl: StructDeclNode* = node as StructDeclNode*;
            for (mut i: i64 = 0; i < decl.methods.length; i++) {
                const m: MethodNode* = decl.methods[i];
                if (m == null || m.func == null) { continue; }
                if (m.func.name.equals(method_name) &&
                    OwnershipQuery::method_consumes_receiver(arena, intern, m)) { return true; }
            }
            return false;
        }
        if (kind == NodeKind::UnionDeclaration) {
            const decl: UnionDeclNode* = node as UnionDeclNode*;
            for (mut i: i64 = 0; i < decl.methods.length; i++) {
                const m: MethodNode* = decl.methods[i];
                if (m == null || m.func == null) { continue; }
                if (m.func.name.equals(method_name) &&
                    OwnershipQuery::method_consumes_receiver(arena, intern, m)) { return true; }
            }
            return false;
        }
        if (kind == NodeKind::ClassDeclaration) {
            const decl: ClassDeclNode* = node as ClassDeclNode*;
            for (mut i: i64 = 0; i < decl.methods.length; i++) {
                const m: MethodNode* = decl.methods[i];
                if (m == null || m.func == null) { continue; }
                if (m.func.name.equals(method_name) &&
                    OwnershipQuery::method_consumes_receiver(arena, intern, m)) { return true; }
            }
            return false;
        }
        return false;
    }

    /// Scan all impl-blocks attached to `tmpl` (where enum and many struct
    /// inherent methods live) for one named `method_name` that consumes its
    /// receiver.
    static impl_blocks_method_consumes(arena: TypeArena*, intern: InternTable*,
                                       tmpl: TemplateEntry*,
                                       method_name: SymbolStr) -> boolean {
        if (tmpl == null) { return false; }
        for (mut i: i64 = 0; i < tmpl.impl_blocks.length; i++) {
            const ib: ImplBlockNode* = tmpl.impl_blocks[i];
            if (ib == null) { continue; }
            for (mut j: i64 = 0; j < ib.methods.length; j++) {
                const m: MethodNode* = ib.methods[j];
                if (m == null || m.func == null) { continue; }
                if (m.func.name.equals(method_name) &&
                    OwnershipQuery::method_consumes_receiver(arena, intern, m)) { return true; }
            }
        }
        return false;
    }

    /// Strip a qualified name down to its bare leaf: the segment after
    /// the last `::`. Returns the input unchanged when no `::` is
    /// present.
    static leaf_segment(intern: InternTable*, qname: SymbolStr) -> SymbolStr {
        if (intern == null || !qname.is_valid()) { return qname; }
        const qstr: string = intern.resolve(qname);
        const qlen: i64 = strlen(qstr) as i64;
        mut last_sep: i64 = -1;
        for (mut i: i64 = 0; i + 1 < qlen; i++) {
            if (qstr[i] == ':' && qstr[i + 1] == ':') { last_sep = i + 2; }
        }
        if (last_sep < 0) { return qname; }
        // The tail is the NUL-terminated suffix of `qstr` starting at
        // `last_sep`; point straight at it and intern once.  (The old loop
        // rebuilt it char-by-char with `format("%s%c", …)` — O(n²) heap
        // allocations per call, all leaked, and a top heap consumer in a
        // self-host build.)  `intern` copies the bytes it keeps.
        const tail: string = qstr + last_sep;
        return intern.intern(tail);
    }
}
