///! TraitChecker
///!
///! Standalone trait-satisfaction query engine. Answers read-only questions of
///! the form "does this concrete type implement this trait?" and the diagnostics
///! that hang off them. It depends on nothing but the four shared read-only
///! components - the TypeArena, the GenericRegistry, the InternTable, and the
///! DiagnosticSink - and holds no mutable analysis state (no worklist, no
///! instantiation cache, no inference scratch buffers).
///!
///! This is deliberately severable from the Monomorphizer: semantic analysis
///! needs these queries to validate trait bounds and `implement Trait` bindings,
///! but must NOT depend on the monomorphizer having run. The Monomorphizer
///! composes a TraitChecker and forwards to it; sema constructs one directly
///! from the CompilationContext's shared components.

namespace compiler::types::trait_checker;

import compiler::ast::{
    declaration, expression, node, ObjectForm, pattern, statement, TraitBound, TraitRef,
    TypeAnnotation
};
import compiler::types::{
    generic, user_defined, compound, type_base, arena, type_ref,
    substitution, inference, generic_registry, ownership, TypeKind
};
import compiler::diag::{ diagnostic, ErrorCode, sink, source_span };
import compiler::resolver::{ intern_table, symbol_str };
import std::fmt;
import compiler::ast::declaration::{ DeclarationNode, FunctionDecl, GenericParamDecl, ImplBlock, MethodDecl, TraitDecl, VarDecl };
import compiler::diag::diagnostic::{ Diagnostic };
import compiler::diag::sink::{ DiagnosticSink };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::decl_name::{ DeclName };
import compiler::resolver::res::{ DefId };
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::types::arena::{ TypeArena };
import compiler::types::compound::{ ObjectType, PointerType, ReferenceType };
import compiler::types::user_defined::{ TypeAliasType };
import compiler::types::generic::{ GenericParamType };
import compiler::types::generic_registry::{ GenericRegistry };
import compiler::resolver::lang_item::{ LangItem };
import compiler::types::ownership::{ OwnershipQuery };
import compiler::types::substitution::{ TypeSubstitution };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };


/// Read-only trait-satisfaction query engine. See file header.
type struct TraitChecker {
    arena:             TypeArena*;
    generic_registry:  GenericRegistry*;
    intern_table:      InternTable*;
    diagnostics:       DiagnosticSink*;

    static new(arena: TypeArena*, generic_registry: GenericRegistry*,
               intern_table: InternTable*, diagnostics: DiagnosticSink*) -> TraitChecker {
        return TraitChecker {
            arena:            arena,
            generic_registry: generic_registry,
            intern_table:     intern_table,
            diagnostics:      diagnostics,
        };
    }

    /// Recursively check whether a concrete TypeRef implements a trait.
    /// For an InstantiatedType `Option<X>` and trait `Eq`:
    ///   1. Look up the impl block for (Eq, Option). Missing -> false.
    ///   2. If the impl has a `where T: Eq` clause, recursively verify
    ///      `X: Eq` with the impl's generic params bound to the
    ///      InstantiatedType's args.
    /// `depth` guards against pathological loops in cyclic impl chains;
    /// the depth limit is conservative (we don't expect realistic chains
    /// past a handful of levels) and a depleted depth conservatively
    /// returns false so an unsatisfiable bound never accidentally enables
    /// body specialization.
    /// `trait_name` is the trait's IDENTITY (`TraitRef::identity()`, a
    /// stamped annotation, or `GenericRegistry::wellknown`), never a written
    /// leaf: the marker comparisons below are identity comparisons, and a leaf
    /// would match a user trait that merely shares the spelling.
    ///
    /// The trait-impl registry is keyed by that identity too, so one name
    /// asks both questions.
    type_implements_trait(&this, ty: TypeRef, trait_name: DefId, depth: i32) -> boolean {
        if (depth >= 16) {
            // Depth budget exhausted on a deep or cyclic impl/where-clause
            // chain. Return false (unchanged) so an unsatisfiable bound never
            // accidentally enables body specialization - but surface a clean
            // diagnostic. Without this, the `false` propagates into
            // filter_bounds_violating_methods/impls, which silently *drop* the
            // method/impl, and the failure resurfaces far away as a baffling
            // "no method"/undefined-symbol error. No SourceSpan is
            // available here; the trait name pins it down. error_count is left
            // untouched because this receiver is `&this`; emit() records the
            // error in the sink (the same `&this` diagnostics.emit pattern used
            // elsewhere - e.g. resolver.cryo's resolve()).
            const tn: string = this.intern_table.shown(this.arena.defs.path_of(trait_name));
            this.diagnostics.emit(Diagnostic::error(
                ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                fmt::format("trait-bound resolution exceeded the recursion limit (16) while checking `%s`; the impl or where-clause chain may be cyclic", tn)));
            return false;
        }

        // `Copy` is a structural marker: bound satisfaction is computed
        // by walking the type rather than searching the trait-impl
        // registry. The marker trait declared in core/marker.cryo
        // intentionally has no impl blocks; the compiler is the single
        // source of truth for "is this type bitwise-duplicable".
        const copy_name: DefId = this.generic_registry.wellknown(LangItem::Copy);
        if (copy_name.is_valid() && trait_name.equals(copy_name)) {
            return OwnershipQuery::is_copy(this.arena, this.generic_registry,
                                            this.intern_table, ty);
        }

        // `Send` and `Sync` follow the same "structural marker" pattern
        // as `Copy`: the compiler decides via a type walk, not via
        // `implement trait Send for T { ... }` lookups.  See
        // OwnershipQuery::is_send / is_sync for the rules.
        const send_name: DefId = this.generic_registry.wellknown(LangItem::Send);
        if (send_name.is_valid() && trait_name.equals(send_name)) {
            return OwnershipQuery::is_send(this.arena, this.generic_registry,
                                            this.intern_table, ty);
        }
        const sync_name: DefId = this.generic_registry.wellknown(LangItem::Sync);
        if (sync_name.is_valid() && trait_name.equals(sync_name)) {
            return OwnershipQuery::is_sync(this.arena, this.generic_registry,
                                            this.intern_table, ty);
        }

        // Pointers are non-owning aliases; dropping one is a trivial no-op.
        // Delegate `T*: Drop` to `T: Drop` so primitive pointers (`u8*`,
        // `i32*`, etc.) auto-pass via the primitive Drop impls in
        // stdlib/core/drop.cryo, while pointers to user types still require
        // the pointee to `implement trait Drop`. Avoids needing a parser
        // extension to support pointer impl targets like `for u8*`.
        const drop_name: DefId = this.generic_registry.wellknown(LangItem::Drop);
        if (drop_name.is_valid() && trait_name.equals(drop_name)) {
            // Pointers/references are non-owning aliases.  Delegate
            // `T*: Drop` to `T: Drop` so primitive pointers auto-pass while
            // pointers to user types require the pointee to impl `Drop`.  This
            // is checked BEFORE the `Copy` rule below, which a pointer would
            // otherwise always satisfy.
            const t_ptr: Type* = this.arena.lookup(ty);
            if (t_ptr != null && t_ptr.kind == TypeKind::Pointer) {
                const pt: PointerType* = t_ptr.as_pointer();
                return this.type_implements_trait(pt.pointee, trait_name, depth + 1);
            }

            // A non-pointer `Copy` type owns no resources, so dropping it is a
            // no-op: it trivially satisfies `Drop`.  This lets user-defined
            // POD types (all-Copy fields, no `drop`) live in `where T: Drop`
            // containers (`Array`, `Box`, ...) exactly the way primitives do -
            // which carry explicit no-op `Drop` impls in core/drop.cryo -
            // while staying `Copy` so `Array::get` still works.  The matching
            // codegen/sema rules emit nothing for a `.drop()` on such a type.
            if (OwnershipQuery::is_copy(this.arena, this.generic_registry,
                                         this.intern_table, ty)) {
                return true;
            }
        }

        const object_t: Type* = this.arena.lookup(ty);
        if (object_t != null && object_t.kind == TypeKind::Object) {
            return this.object_implements_trait(object_t.as_object(), trait_name);
        }

        // The subject is used directly, whether it is a pre-mono InstantiatedType
        // wrapper or a post-mono concrete spec: both `carries_impl_key` and the
        // type-arg substitution below read the instantiation identity through the
        // `inst_*` views, and a concrete carries that identity itself.
        const subject: TypeRef = ty;
        if (!this.arena.carries_impl_key(subject, this.intern_table)) { return false; }
        // The candidates by identity, the first whose bounds hold.
        const impl_block: ImplBlock* = this.select_impl(trait_name, subject, depth);
        // A method merely named `drop` does not satisfy `Drop`: a type
        // implements it with `implement trait Drop`, as any other trait.
        return impl_block != null;
    }

    /// Whether a trait object implements `trait_def`.  The compiler makes
    /// that implementation, for the object's own trait and each of its
    /// supertraits, and no other: no implementation is written for an object
    /// type.  Each method of `trait_def` and of its supertraits is then
    /// called through the object's table, so each with no default must be
    /// callable through one (`GenericRegistry::method_object_unavailable`),
    /// in every form of object, as a call written on the object is.  A
    /// default the table cannot hold is compiled for the object instead
    /// (`MonoCallSpecializer::object_default_method`).
    object_implements_trait(&this, object: ObjectType*, trait_def: DefId) -> boolean {
        if (this.generic_registry == null) { return false; }
        if (!this.object_reaches_trait(object, trait_def)) { return false; }
        mut declaring: DefId = DefId::invalid();
        return this.object_bound_blocker(trait_def, &declaring) == null;
    }

    /// The type of the value an object of `object`'s form is made from
    /// `source`: the referent of a reference for a borrowed object, in
    /// either form as a reference parameter takes one, the pointee of a
    /// pointer for a raw one; invalid when `source` has neither form.
    object_value(&this, object: ObjectType*, source: TypeRef) -> TypeRef {
        const t: Type* = this.arena.lookup(source);
        if (t == null) { return TypeRef::invalid(); }
        match (object.form) {
            ObjectForm::Raw => {
                if (t.kind == TypeKind::Pointer) { return t.as_pointer().pointee; }
            }
            _ => {
                if (t.kind == TypeKind::Reference) { return t.as_reference().referent; }
            }
        }
        return TypeRef::invalid();
    }

    /// The implementation of `object`'s trait for `value` whose where-clause
    /// holds, among those binding the trait at the object's arguments
    /// (`GenericRegistry::binds_trait_arguments`); null when there is none.
    object_implementation(&this, object: ObjectType*, value: TypeRef) -> DeclarationNode* {
        return this.implementation_at(object.trait_def, &object.args, value);
    }

    /// The implementation of `trait_def` for `value` that binds the trait at
    /// `args` (`GenericRegistry::binds_trait_arguments`) and whose
    /// where-clause holds; null when there is none.
    implementation_at(&this, trait_def: DefId, args: &[TypeRef], value: TypeRef) -> DeclarationNode* {
        return this.implementation_at_depth(trait_def, args, value, 0);
    }

    /// `implementation_at`, sharing the recursion budget of the bound check
    /// that asks it.
    implementation_at_depth(&this, trait_def: DefId, args: &[TypeRef], value: TypeRef, depth: i32) -> DeclarationNode* {
        if (this.generic_registry == null || depth >= 16) { return null; }
        const heads: [DeclarationNode*] = this.generic_registry.heads_for(trait_def, value, this.intern_table);
        for (mut i: i64 = 0; i < heads.length(); i++) {
            const block: ImplBlock* = DeclarationNode::impl_of(heads[i]);
            if (block == null) { continue; }
            const binds: boolean = if (block.target_param().is_valid()) {
                this.generic_registry.blanket_binds(block, args, value, this.intern_table)
            } else {
                this.generic_registry.binds_trait_arguments(block, args, this.intern_table)
            };
            if (!binds) { continue; }
            if (this.impl_applies(block, value, depth)) { return heads[i]; }
        }
        return null;
    }

    /// The trait `tr` names, as a diagnostic shows it: with the arguments a
    /// bound on a type that is not a parameter gives it, substituted by
    /// `subst` (`From<OtherError>`), else its leaf.
    trait_as_required(&this, tr: TraitRef*, subst: TypeSubstitution*) -> string {
        mut shown: string = this.intern_table.resolve(tr.path[tr.path.length() - 1]);
        for (mut ai: i64 = 0; ai < tr.argument_types.length(); ai++) {
            const arg: TypeRef = if (subst != null) { subst.apply(tr.argument_types[ai], this.arena) } else { tr.argument_types[ai] };
            shown = shown + (if (ai == 0) { "<" } else { ", " }) + this.arena.format_display(this.arena.lookup(arg));
        }
        if (tr.argument_types.length() > 0) { shown = shown + ">"; }
        return shown;
    }

    /// The trait of `bound`, written on a type that is neither a parameter
    /// nor a projection (`where HighError: From<E>`, `where Wrapper<T>:
    /// Describe`), that its subject does not implement once `subst` binds
    /// the declaring declaration's parameters: the subject and the trait's
    /// arguments, as the type layer resolved them in those parameters, are
    /// substituted, and an implementation must bind the trait at those
    /// arguments with its own bounds holding.  `*out_subject` is the
    /// substituted subject.  Null when every trait has one, for a bound on
    /// a parameter or a projection, and when the subject or an argument
    /// still names a parameter, which the copy that binds it decides.
    unmet_written_trait(&this, bound: TraitBound*, subst: TypeSubstitution*, depth: i32,
                        out_subject: TypeRef*) -> TraitRef* {
        if (!bound.subject_type.is_valid()) { return null; }
        const subject: TypeRef = if (subst != null) { subst.apply(bound.subject_type, this.arena) } else { bound.subject_type };
        if (!subject.is_valid() || this.arena.contains_generic_param(subject)) { return null; }
        for (mut ri: i64 = 0; ri < bound.trait_refs.length(); ri++) {
            const tr: TraitRef* = &bound.trait_refs[ri];
            // A bound refused where it is written is reported there.
            if (tr.path.length() == 0 || tr.refused) { continue; }
            mut args: [TypeRef] = [];
            for (mut ai: i64 = 0; ai < tr.argument_types.length(); ai++) {
                const arg: TypeRef = if (subst != null) { subst.apply(tr.argument_types[ai], this.arena) } else { tr.argument_types[ai] };
                if (!arg.is_valid() || this.arena.contains_generic_param(arg)) { return null; }
                args.push(arg);
            }
            if (this.implementation_at_depth(tr.definition(), &args, subject, depth) == null) {
                *out_subject = subject;
                return tr;
            }
        }
        return null;
    }

    /// Whether `trait_def` is the object's own trait or one of its
    /// supertraits: the traits whose implementation the compiler makes for
    /// it.
    object_reaches_trait(&this, object: ObjectType*, trait_def: DefId) -> boolean {
        const reached: [DefId] = this.generic_registry.object_table_traits(object.trait_def);
        for (mut i: i64 = 0; i < reached.length(); i++) {
            if (reached[i].equals(trait_def)) { return true; }
        }
        return false;
    }

    /// The method that keeps every object from satisfying a bound of
    /// `trait_def`: the first, in `trait_def` or a supertrait, with no
    /// default that a table cannot hold, its trait written through
    /// `out_declaring`; null when there is none.
    object_bound_blocker(&this, trait_def: DefId, out_declaring: DefId*) -> DeclarationNode* {
        const required: [DefId] = this.generic_registry.object_table_traits(trait_def);
        for (mut t: i64 = 0; t < required.length(); t++) {
            const decl: TraitDecl* = this.generic_registry.get_trait_decl(required[t]);
            if (decl == null) { continue; }
            for (mut m: i64 = 0; m < decl.methods.length(); m++) {
                const method: FunctionDecl* = DeclarationNode::fn_of(decl.methods[m]);
                if (method != null && method.has_body()) { continue; }
                if (this.generic_registry.method_object_unavailable(decl.methods[m]).length() > 0) {
                    *out_declaring = required[t];
                    return decl.methods[m];
                }
            }
        }
        return null;
    }

    /// The note an unmet bound of `trait_def` on `ty` carries, `trait_shown`
    /// and `ty_shown` being the names its headline gives them.  For an
    /// object of a trait that reaches `trait_def`, the compiler makes the
    /// implementation, so the note names the method that keeps it from
    /// doing so and why, in the words a call of that method through the
    /// object is refused with (E0314).  For any other type, that the type
    /// does not implement the trait.
    bound_failure_note(&this, ty: TypeRef, trait_def: DefId, trait_shown: string, ty_shown: string) -> string {
        const t: Type* = this.arena.lookup(ty);
        if (t != null && t.kind == TypeKind::Object && this.generic_registry != null
                && this.object_reaches_trait(t.as_object(), trait_def)) {
            mut declaring: DefId = DefId::invalid();
            const method: DeclarationNode* = this.object_bound_blocker(trait_def, &declaring);
            if (method != null) {
                return fmt::format("the method `%s` of `%s` has no default, and cannot be called through `%s`: %s",
                    this.intern_table.resolve(DeclarationNode::fn_of(method).name),
                    this.intern_table.resolve(this.generic_registry.get_trait_decl(declaring).name),
                    ty_shown, this.generic_registry.method_object_unavailable(method));
            }
        }
        return fmt::format("the trait `%s` is not implemented for `%s`", trait_shown, ty_shown);
    }

    /// The help an unmet bound of `trait_def` on `ty` carries.  No
    /// implementation can be written for an object, so an object is told to
    /// give way to a type that implements the trait: one whose trait reaches
    /// `trait_def` is blocked by a method a table cannot hold, and one whose
    /// trait does not reach it never implements it.  Any other type gets
    /// `written_help`, the site's own advice.
    bound_failure_help(&this, ty: TypeRef, trait_def: DefId, trait_shown: string, ty_shown: string,
                       written_help: string) -> string {
        const t: Type* = this.arena.lookup(ty);
        if (t == null || t.kind != TypeKind::Object) { return written_help; }
        if (this.generic_registry != null && this.object_reaches_trait(t.as_object(), trait_def)) {
            return fmt::format("use a type that implements `%s` in place of `%s`, or an object of a trait whose methods a table can hold",
                trait_shown, ty_shown);
        }
        return fmt::format("use a type that implements `%s` in place of `%s`; an object implements only its own trait and that trait's supertraits",
            trait_shown, ty_shown);
    }

    /// The impl of `trait_id` for `subject` that APPLIES: the first
    /// candidate the registry assembles by unification
    /// (`GenericRegistry::heads_for`) whose where-clause holds for the
    /// subject's arguments.  Null when no head unifies or every one that
    /// does is refused by its bounds - selection, candidate assembly then
    /// confirmation, in one place.
    select_impl(&this, trait_id: DefId, subject: TypeRef, depth: i32) -> ImplBlock* {
        if (this.generic_registry == null) { return null; }
        const heads: [DeclarationNode*] = this.generic_registry.heads_for(trait_id, subject, this.intern_table);
        for (mut i: i64 = 0; i < heads.length(); i++) {
            const head: ImplBlock* = DeclarationNode::impl_of(heads[i]);
            if (this.impl_applies(head, subject, depth)) { return head; }
        }
        return null;
    }

    /// Every impl that applies to `subject`, of every trait: the registry's
    /// candidates (`trait_impls_of`) with each one's where-clause confirmed.
    /// The set a method call on a concrete receiver binds against.
    impls_of(&this, subject: TypeRef) -> [ImplBlock*] {
        mut out: [ImplBlock*] = [];
        if (this.generic_registry == null) { return out; }
        const heads: [DeclarationNode*] = this.generic_registry.trait_impls_of(subject, this.intern_table);
        for (mut i: i64 = 0; i < heads.length(); i++) {
            const head: ImplBlock* = DeclarationNode::impl_of(heads[i]);
            if (this.impl_applies(head, subject, 0)) { out.push(head); }
        }
        return out;
    }

    /// Whether a candidate head applies to `subject`: a clone the
    /// monomorphizer placed under a specialization was confirmed when it was
    /// placed (its bounds held for those arguments, and are substituted away
    /// on the clone), so it applies outright; a written head applies when
    /// its where-clause holds for the subject.
    impl_applies(&this, head: ImplBlock*, subject: TypeRef, depth: i32) -> boolean {
        if (head == null) { return false; }
        if (head.spec_owner.is_valid()) { return true; }
        return this.impl_bounds_hold(head, subject, depth);
    }

    /// Whether `impl_block`'s where-clause holds for `subject`: the head's
    /// written target parameters bound to the subject's arguments, each bound
    /// checked recursively.  A head with no where-clause holds outright.  A
    /// subject that carries no arguments cannot bind the head's parameters,
    /// so a bounded head is refused for it rather than assumed.
    impl_bounds_hold(&this, impl_block: ImplBlock*, subject: TypeRef, depth: i32) -> boolean {
        if (impl_block == null) { return false; }
        if (impl_block.where_bounds.length() == 0) { return true; }
        // A head for every type: its parameter is the subject itself.
        const target: SymbolID = impl_block.target_param();
        if (target.is_valid()) {
            mut blanket: TypeSubstitution = TypeSubstitution::empty();
            for (mut gi: i64 = 0; gi < impl_block.generic_params.length(); gi++) {
                const gp: GenericParamDecl* = DeclarationNode::generic_param_of(impl_block.generic_params[gi]);
                if (gp != null && gp.sym_id.equals(target)) {
                    blanket.add(this.arena.create_generic_param(gp.sym_id, gp.name, gi as u64), subject);
                }
            }
            return this.bounds_satisfied_at_depth(impl_block.where_bounds, &blanket, depth + 1);
        }
        // Build a fresh substitution from the impl's generic params to
        // the concrete type's args. For `implement<T> trait Eq for Option<T>`
        // and `ty = Option<X>`, the impl's `T` maps to the InstantiatedType's
        // `type_args[0]`.
        const subj_nargs: i64 = this.arena.inst_type_arg_count(subject);
        if (subj_nargs == 0) {
            // No outer args to substitute through: a bound on an impl
            // parameter has no concrete value to check, so the impl is
            // refused rather than assumed; a bound written on a type names
            // no parameter, and is checked as written.
            for (mut bi: i64 = 0; bi < impl_block.where_bounds.length(); bi++) {
                if (!impl_block.where_bounds[bi].subject_type.is_valid()) { return false; }
            }
            return this.bounds_satisfied_at_depth(impl_block.where_bounds, null, depth + 1);
        }
        // Map the impl's TARGET type args - the names the struct itself is
        // parameterized by (`I` in `for TakeIter<I>`) - to the concrete
        // instantiation's args.  This is NOT the same as the impl's full
        // generic-param list: a where-clause can introduce extra generics the
        // struct doesn't carry (`A` in `implement<I, A> Iterator<A> for
        // TakeIter<I> where I: Iterator<A>`), so keying off `generic_params`
        // and requiring it to equal `type_args.length()` wrongly rejected every
        // such impl (e.g. the nested `TakeIter<TakeIter<Range<i32>>>` while
        // chaining).  The where-bound check below only needs the target params
        // bound; it looks up bound subjects by name.
        if (impl_block.target_args.length() != subj_nargs) {
            return false;
        }
        mut args: [TypeRef] = [];
        for (mut gi: i64 = 0; gi < subj_nargs; gi++) {
            args.push(this.arena.inst_type_arg_at(subject, gi));
        }
        mut nested: TypeSubstitution = TypeSubstitution::empty();
        this.add_head_param_bindings(impl_block, &args, &nested);
        return this.bounds_satisfied_at_depth(impl_block.where_bounds, &nested, depth + 1);
    }

    /// Bind the parameters an implement block's head writes to an
    /// instantiation's arguments: `U` in `implement<U> .. for Wrap<U>`, for
    /// `Wrap<Plain>`, to `Plain`.  An impl's parameters are its own; they
    /// relate to the type's only through the head, so a bound the impl
    /// writes (`where U: Show`) is checked against these bindings and never
    /// against the type's parameters, which may be spelled differently.  A
    /// head whose argument count differs from `args` binds nothing.
    add_head_param_bindings(&this, impl_block: ImplBlock*, args: &[TypeRef],
                            subst: TypeSubstitution*) -> void {
        if (impl_block == null || subst == null) { return; }
        if (impl_block.target_args.length() != args.length()) { return; }
        for (mut gi: i64 = 0; gi < impl_block.target_args.length(); gi++) {
            const gp_ref: TypeRef = this.head_param_type(impl_block, gi);
            if (gp_ref.is_valid()) { subst.add(gp_ref, args[gi]); }
        }
    }

    /// The type of the parameter an implement block's head writes at
    /// position `index` (`U` in `.. for Wrap<U>`, at 0), or invalid where
    /// the head writes a type there.
    head_param_type(&this, impl_block: ImplBlock*, index: i64) -> TypeRef {
        if (impl_block == null || index < 0 || index >= impl_block.target_args.length()) {
            return TypeRef::invalid();
        }
        const ta: TypeAnnotation* = impl_block.target_args[index];
        if (ta == null) { return TypeRef::invalid(); }
        match (*ta) {
            TypeAnnotation::Named(n) => {
                if (n.param_sym().is_valid()) {
                    return this.arena.create_generic_param(n.param_sym(), n.name, index as u64);
                }
            }
            _ => {}
        }
        return TypeRef::invalid();
    }

    /// Lenient "does `ty` implement `trait_name`" check for verifying an
    /// `implement Trait` binding annotation against its initializer.
    ///
    /// `type_implements_trait` confirms a head's where-bounds, and cannot
    /// bind a where-clause-ONLY generic - the `T` in `implement<I, T>
    /// Iterator<T> for CopiedIter<I> where I: Iterator<T*>` is recovered by
    /// pointer-peeling at instantiation, which the bound checker does not
    /// replay - so a written head with such a bound reads as unsatisfied
    /// until its clone is placed.  For an opaque-binding sanity check the
    /// bounds do not matter: it is enough that a head of the trait unifies
    /// with the type at all (a genuinely unrelated type has none).  A truly
    /// unsatisfied bound still surfaces at the first trait-method call on
    /// the concrete type.
    type_satisfies_opaque_bound(&this, ty: TypeRef, trait_name: DefId) -> boolean {
        if (this.type_implements_trait(ty, trait_name, 0)) { return true; }
        if (this.generic_registry == null) { return false; }
        return this.generic_registry.heads_for(trait_name, ty, this.intern_table).length() > 0;
    }

    /// When sema's call-site method lookup misses on a spec'd type, we want
    /// to distinguish "this method genuinely doesn't exist" from "the trait
    /// providing this method has a where-clause that isn't satisfied for this
    /// specialization".  Walks the heads that unify with `receiver` and
    /// returns the IDENTITY of the first trait whose head provides
    /// `method_name` (by the trait-method door) but whose `where_bounds` do
    /// not hold for the receiver's type args.  Returns `DeclName::empty()`
    /// when no such trait exists.
    diagnose_method_bounds_failure(&this, receiver: TypeRef,
                                    method_name: SymbolStr) -> DeclName {
        if (this.generic_registry == null) { return DeclName::empty(); }
        const blocks: [DeclarationNode*] = this.generic_registry.trait_impls_of(receiver, this.intern_table);
        for (mut i: i64 = 0; i < blocks.length(); i++) {
            const impl_block: ImplBlock* = DeclarationNode::impl_of(blocks[i]);
            const m_decl: DeclarationNode* = this.generic_registry.impl_method_by_leaf(impl_block, method_name);
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m == null || m.func == null) { continue; }
            if (!this.type_implements_trait(receiver, impl_block.trait_def, 0)) {
                return this.arena.defs.path_of(impl_block.trait_def);
            }
        }
        return DeclName::empty();
    }

    /// Check whether every trait bound in `bounds` holds under `subst`.
    bounds_satisfied(&this, bounds: &[TraitBound], subst: TypeSubstitution*) -> boolean {
        if (bounds.length() == 0) { return true; }
        mut unmet_subject: TypeRef = TypeRef::invalid();
        for (mut bi: i64 = 0; bi < bounds.length(); bi++) {
            if (this.unmet_written_trait(&bounds[bi], subst, 0, &unmet_subject) != null) { return false; }
        }
        if (subst == null || subst.replacements.length() == 0) { return true; }
        for (mut bi: i64 = 0; bi < bounds.length(); bi++) {
            const bound: TraitBound* = &bounds[bi];
            if (bound.subject_type.is_valid()) { continue; }
            // An associated-type-projection subject (`where This::Item: Ord`)
            // is not a substitutable param name; it is enforced structurally by
            // the method body's use of the bound trait's methods (a non-`Ord`
            // element makes the body's `.compare()` unresolvable at
            // specialization). Treat it as satisfied here rather than failing
            // the whole spec. (Crisp projection-level filtering is a future
            // refinement - see plan risk #1.)
            if (bound.has_projection_subject()) { continue; }
            const concrete: TypeRef = this.lookup_subst_for_param(bound.subject_param(), subst);
            if (!concrete.is_valid()) {
                // No substitution for this param; the bound names a
                // generic the caller didn't supply.  This is normal for
                // method-level generics (e.g. `hash<H> where H: Hasher`
                // inside an impl that's only substituting outer params
                // like `A`): the bound applies at method-spec time, not
                // at impl-spec time.  Skip this bound rather than
                // wholesale failing; preserving the method body so the
                // method-call inference pass can clone+substitute it
                // for a concrete H later.
                continue;
            }
            for (mut ri: i64 = 0; ri < bound.trait_refs.length(); ri++) {
                const tref: TraitRef* = &bound.trait_refs[ri];
                if (tref.path.length() == 0) { continue; }
                if (!this.type_implements_trait(concrete, tref.definition(), 0)) {
                    return false;
                }
            }
        }
        return true;
    }

    /// The first trait reference in `bounds` that `subst` does not satisfy,
    /// or null when every one holds: `bounds_satisfied` with the failing
    /// bound named, for a diagnostic that points at it.  A bound whose
    /// argument is missing from the substitution or still abstract is
    /// deferred, as `bounds_satisfied` defers it; `*out_concrete` is the
    /// argument the failing bound was checked against.  A bound written on
    /// a type that is not a parameter (`unmet_written_trait`) is asked only
    /// with `include_written`: the implementations it needs are attached
    /// to their types after a module's annotations are first resolved, so
    /// only a check made once every module is registered can answer it.
    unsatisfied_trait_ref(&this, bounds: &[TraitBound], subst: TypeSubstitution*,
                          include_written: boolean, out_concrete: TypeRef*) -> TraitRef* {
        if (bounds.length() == 0 || subst == null) { return null; }
        for (mut bi: i64 = 0; bi < bounds.length(); bi++) {
            const bound: TraitBound* = &bounds[bi];
            if (bound.subject_type.is_valid()) {
                if (!include_written) { continue; }
                const written: TraitRef* = this.unmet_written_trait(bound, subst, 0, out_concrete);
                if (written != null) { return written; }
                continue;
            }
            if (bound.has_projection_subject()) { continue; }
            const concrete: TypeRef = this.lookup_subst_for_param(bound.subject_param(), subst);
            if (!concrete.is_valid()) { continue; }
            if (this.arena.contains_generic_param(concrete)) { continue; }
            for (mut ri: i64 = 0; ri < bound.trait_refs.length(); ri++) {
                const tref: TraitRef* = &bound.trait_refs[ri];
                // A bound refused where it is written is reported there.
                if (tref.path.length() == 0 || tref.refused) { continue; }
                if (this.type_implements_trait(concrete, tref.definition(), 0)) { continue; }
                *out_concrete = concrete;
                return tref;
            }
        }
        return null;
    }

    /// `bounds_satisfied` with explicit recursion depth, used by
    /// `type_implements_trait` so the recursive chain shares a single
    /// depth budget.
    bounds_satisfied_at_depth(&this, bounds: &[TraitBound],
                               subst: TypeSubstitution*, depth: i32) -> boolean {
        if (bounds.length() == 0) { return true; }
        mut unmet_subject: TypeRef = TypeRef::invalid();
        for (mut bi: i64 = 0; bi < bounds.length(); bi++) {
            if (this.unmet_written_trait(&bounds[bi], subst, depth, &unmet_subject) != null) { return false; }
        }
        if (subst == null || subst.replacements.length() == 0) { return true; }
        for (mut bi: i64 = 0; bi < bounds.length(); bi++) {
            const bound: TraitBound* = &bounds[bi];
            if (bound.subject_type.is_valid()) { continue; }
            // Projection subject (`where This::Item: Ord`): enforced by the
            // method body, not filterable by param substitution here. Treat as
            // satisfied rather than failing the spec (matching `bounds_satisfied`).
            if (bound.has_projection_subject()) { continue; }
            const concrete: TypeRef = this.lookup_subst_for_param(bound.subject_param(), subst);
            if (!concrete.is_valid()) { return false; }
            for (mut ri: i64 = 0; ri < bound.trait_refs.length(); ri++) {
                const tref: TraitRef* = &bound.trait_refs[ri];
                if (tref.path.length() == 0) { continue; }
                if (!this.type_implements_trait(concrete, tref.definition(), depth)) {
                    return false;
                }
            }
        }
        return true;
    }

    /// Returns true when a function's own where-bounds are satisfiable under
    /// `subst` (no bounds, every bound has a registered impl, or the
    /// substitution is missing entirely). Returns false only when at least one
    /// bound's impl is *known absent*.
    method_bounds_satisfied(&this, func_decl: DeclarationNode*,
                            subst: TypeSubstitution*) -> boolean {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null) { return true; }
        if (func.trait_bounds.length() == 0) { return true; }
        return this.bounds_satisfied(func.trait_bounds, subst);
    }

    /// Whether `func`'s receiver is written as the template `base`
    /// instantiated with arguments other than `args`, read under `subst`
    /// (the template's parameters bound to `args`): on `implement
    /// Result<T, E>` as `Result<i32, string>`, `this: Result<T*, E>` denotes
    /// `Result<i32*, string>` and is not a method of it; `this: Result<T, E>`
    /// is.  A receiver written as the bare owner names every instantiation.
    method_receiver_excludes(&this, func_decl: DeclarationNode*, subst: TypeSubstitution*,
                             base: TypeRef, args: &[TypeRef]) -> boolean {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null) { return false; }
        for (mut i: i64 = 0; i < func.parameters.length(); i++) {
            const param_decl: DeclarationNode* = func.parameters[i];
            const param: VarDecl* = DeclarationNode::var_of(param_decl);
            if (param == null || !param.is_receiver()) { continue; }
            mut ty: TypeRef = param.resolved_type;
            if (subst != null) { ty = subst.apply(ty, this.arena); }
            ty = this.receiver_core(ty);
            if (!this.arena.inst_generic_base(ty).equals(base)) { return false; }
            if (this.arena.inst_type_arg_count(ty) != args.length()) { return false; }
            for (mut ai: i64 = 0; ai < args.length(); ai++) {
                if (!this.arena.inst_type_arg_at(ty, ai).equals(args[ai])) { return true; }
            }
            return false;
        }
        return false;
    }

    /// The type a receiver is a reference or pointer to, through aliases.
    receiver_core(&this, ty: TypeRef) -> TypeRef {
        mut cur: TypeRef = ty;
        for (mut depth: i32 = 0; depth < 8; depth++) {
            const t: Type* = this.arena.lookup(cur);
            if (t == null) { return cur; }
            if (t.kind == TypeKind::Reference) { cur = t.as_reference().referent; continue; }
            if (t.kind == TypeKind::Pointer) { cur = t.as_pointer().pointee; continue; }
            if (t.kind == TypeKind::TypeAlias && t.as_alias().has_target()) {
                cur = t.as_alias().target;
                continue;
            }
            return cur;
        }
        return cur;
    }

    /// The replacement `subst` holds for the generic parameter whose
    /// declaration bound `sym`.
    lookup_subst_for_param(&this, sym: SymbolID, subst: TypeSubstitution*) -> TypeRef {
        if (subst == null) { return TypeRef::invalid(); }
        for (mut i: i64 = 0; i < subst.params.length(); i++) {
            const pt: Type* = this.arena.lookup(subst.params[i]);
            if (pt == null || pt.kind != TypeKind::GenericParam) { continue; }
            if (pt.as_generic_param().declared_by(sym)) { return subst.replacements[i]; }
        }
        return TypeRef::invalid();
    }

}
