///! TypeResolver
///!
///! Resolves unresolved TypeAnnotation nodes (from the parser) into concrete
///! TypeRef handles by looking up types in the TypeArena.
///!
///! Named-type resolution delegates to the Resolver's scope chain and
///! cross-module infrastructure via resolve_type_qualified_name(), avoiding
///! duplication of name lookup logic.
///!
///! Design note: Reuses the existing TypeAnnotation enum from AST/_module.cryo
///! directly, avoiding parallel definitions.

namespace Compiler::Types::Resolver;

import Compiler::Diag;
import Compiler::Diag::{ Sink, Diagnostic, SourceSpan };
import Compiler::Types::{ Arena, TypeRef, GenericRegistry, Registry, Inference, Ownership };
import Compiler::AST;
import Compiler::AST::{ Node, Declaration, Statement, Expression };
import Compiler::Resolver::{ SymbolStr, InternTable, Resolver };
import Compiler::DeclIndex;
import Compiler::ConstTable;
import Utils::Logger;
import std::collections::pair;


// ResolutionContext: context for type resolution

/// Ambient state needed while resolving type annotations.
type struct ResolutionContext {
    current_module:   string;
    source_file:      string;
    import_modules:   string[];     // Modules imported by this compilation unit
    generic_bindings: Pair<SymbolStr, TypeRef>[];  // generic name -> bound TypeRef
    /// What `This` resolves to in the current scope.
    /// Inside an impl block: the implementing type (same as `&this` owner).
    /// Inside a trait decl: a synthetic GenericParam("This") placeholder
    /// that downstream substitution rewrites to the impl target.
    /// Invalid outside trait/impl scopes; using `This` there is an error.
    this_type:        TypeRef;

    /// Module namespace the annotation being resolved was WRITTEN in, or "" when
    /// unknown.
    ///
    /// A type annotation is syntax, and a bare leaf in it means whatever that
    /// leaf means in ITS module - not in whichever module the resolver's ambient
    /// scope cursor happens to be parked on. Those coincide while a pass walks
    /// declarations in order, and diverge whenever an annotation is re-resolved
    /// from somewhere else: sema re-deriving a callee's return type while
    /// checking a caller, mono re-resolving a template signature while
    /// specializing. There the ambient cursor names the CALLER's module, and a
    /// bare leaf both modules define binds to the wrong one - silently, since
    /// both resolutions succeed.
    ///
    /// Set this to the annotation's owning module at any such re-resolution and
    /// `resolve_named` will prefer that module's own declaration of the leaf.
    /// Empty means "resolve as before, against the ambient scope chain", so a
    /// site that does not know its home module keeps today's behavior.
    home_module:      string;

    /// Demand-free (symbolic) resolution mode. When set, `resolve_generic`
    /// builds an arena-only `InstantiatedType` (via `arena.create_instantiation`)
    /// instead of routing through `generic_registry.instantiate_for_module`. The
    /// arena path does NOT register a monomorphization demand, so
    /// `collect_unmonomorphized` never sees the instantiation and no spurious
    /// E0900 (un-monomorphized) leaks. The symbolic generic-body walk sets this
    /// so it can resolve `Pair<T, V>`-style abstract annotations without polluting
    /// the registry with type-param-bearing instantiations.
    symbolic_no_demand: boolean;

    static new(current_module: string, source_file: string) -> ResolutionContext {
        return ResolutionContext {
            current_module:   current_module,
            source_file:      source_file,
            import_modules:   [],
            generic_bindings: [],
            this_type:        TypeRef::invalid(),
            home_module:      "",
            symbolic_no_demand: false,
        };
    }

    /// Declare which module the annotations resolved through this context were
    /// written in.  See `home_module`.
    set_home_module(mut &this, module_ns: string) -> void {
        this.home_module = module_ns;
    }

    /// Add a generic binding (e.g., T -> i32).
    add_binding(mut &this, name: SymbolStr, bound_type: TypeRef) -> void {
        this.generic_bindings.push(Pair<SymbolStr, TypeRef>::new(name, bound_type));
    }

    /// Look up a generic binding by name.
    lookup_binding(&this, name: SymbolStr) -> TypeRef {
        for (mut i: i64 = 0; i < this.generic_bindings.length; i++) {
            if (this.generic_bindings[i].first.equals(name)) {
                return this.generic_bindings[i].second;
            }
        }
        return TypeRef::invalid();
    }

    /// Bind `This` for the current resolution scope.
    set_this_type(mut &this, t: TypeRef) -> void {
        this.this_type = t;
    }

    /// Deep copy.  A bitwise `*ctx` copy aliases the owning
    /// `generic_bindings` buffer between the original and the copy, so a
    /// later `push`/realloc on either invalidates the other and end-of-scope
    /// drop-glue frees one buffer twice (double-free).  This produces an
    /// independent context with its own `generic_bindings` storage.  The
    /// element type `Pair<SymbolStr, TypeRef>` is POD (interned ids), so the
    /// per-element copies are trivial.  `import_modules` is reconstructed as
    /// `[]` - it is never populated anywhere, matching the prior behavior.
    clone(&this) -> ResolutionContext {
        mut out: ResolutionContext =
            ResolutionContext::new(this.current_module, this.source_file);
        out.this_type = this.this_type;
        out.home_module = this.home_module;
        out.symbolic_no_demand = this.symbolic_no_demand;
        for (mut i: i64 = 0; i < this.generic_bindings.length; i++) {
            out.add_binding(this.generic_bindings[i].first,
                            this.generic_bindings[i].second);
        }
        return out;
    }
}


type struct TypeResolver {
    arena:            TypeArena*;
    intern_table:     InternTable*;
    generic_registry: GenericRegistry*;
    module_registry:  ModuleTypeRegistry*;
    name_resolver:    Resolver*;
    decl_index:       DeclarationIndex*;
    /// Folded module-level integer constants, for `T[NAME]` array sizes.
    const_table:      ConstantTable*;
    diagnostics:      DiagnosticSink*;
    bootstrap_mode:   boolean;     // true during Phase 5 (TypeResolution) when DI is being populated

    /// Construct with all required dependencies.
    ///
    /// All registries are mandatory; callers must supply them. This
    /// prevents silent fallback paths where instantiations bypass the
    /// GenericRegistry and become invisible to the Monomorphizer.
    static new(arena: TypeArena*, intern_table: InternTable*,
               generic_registry: GenericRegistry*,
               module_registry: ModuleTypeRegistry*,
               name_resolver: Resolver*,
               decl_index: DeclarationIndex*,
               const_table: ConstantTable*) -> TypeResolver {
        return TypeResolver {
            arena:            arena,
            intern_table:     intern_table,
            generic_registry: generic_registry,
            module_registry:  module_registry,
            name_resolver:    name_resolver,
            decl_index:       decl_index,
            const_table:      const_table,
            diagnostics:      null,
            bootstrap_mode:   true,
        };
    }

    /// Set the diagnostic sink for error reporting.
    set_diagnostics(mut &this, sink: DiagnosticSink*) -> void {
        this.diagnostics = sink;
    }

    /// End bootstrap mode.  After this, resolve_named() uses only the
    /// DeclarationIndex (step 3) and leaf-index (step 5).  Arena fallback
    /// (steps 4, 5a) is disabled; all types should be in the DI.
    end_bootstrap(mut &this) -> void {
        this.bootstrap_mode = false;
    }


    // Main resolve entry point

    /// The element count for an array annotation.
    ///
    /// A literal size and `T[]` are already authoritative.  A `T[NAME]` /
    /// `T[NAME * 2]` arrives fixed-pending with its size expression intact and
    /// is folded here, once names are bound; the result is written back to the
    /// annotation so repeat resolutions are free.
    ///
    /// A size that will not fold is reported rather than left pending: a
    /// pending size reaches codegen as an array descriptor with no storage
    /// behind it, and every access through it is then a wild pointer.
    array_size_of(&this, a: ArrayAnnotation*, ctx: ResolutionContext*) -> i64 {
        if (a.size != ArrayAnnotation::fixed_pending_size()) { return a.size; }
        if (a.size_expr == null) { return a.size; }

        const module_ns: SymbolStr = if (this.intern_table != null) {
            this.intern_table.intern(ctx.current_module)
        } else { SymbolStr::empty() };

        mut folded: i64 = 0;
        if (ConstantTable::fold_i64(a.size_expr, this.const_table, module_ns,
                                     this.intern_table, &folded)) {
            if (folded < 0) {
                if (this.diagnostics != null) {
                    this.diagnostics.emit(Diagnostic::error(
                        ErrorCode::E0239_NON_CONST_ARRAY_SIZE,
                        format("array size must not be negative (folded to %ld)",
                               folded)).at(a.span));
                }
                return 0;
            }
            a.size = folded;              // cache: fold once per annotation
            return folded;
        }

        if (this.diagnostics != null) {
            this.diagnostics.emit(Diagnostic::error(
                ErrorCode::E0239_NON_CONST_ARRAY_SIZE,
                "array size must be a compile-time integer constant")
                .at(a.span)
                .help("only integer literals and named integer constants "
                      "may size an array"));
        }
        return 0;
    }

    /// Resolve a TypeAnnotation to a TypeRef.
    resolve(&this, ann: TypeAnnotation*, ctx: ResolutionContext*) -> TypeRef {
        if (ann == null) {
            LOG_DEBUG(LogComponent::TypeChecker, "[TypeResolver] resolve() null annotation");
            return TypeRef::invalid();
        }

        return match (*ann) {
            TypeAnnotation::Primitive(p) => {
                this.resolve_primitive(p.name)
            }
            TypeAnnotation::Named(n) => {
                if (n.pre_resolved.is_valid()) {
                    return n.pre_resolved;
                }
                // Canonicalize a BARE all-default generic name to its default
                // instantiation (`String` -> `String<GlobalAlloc>`) so a bare
                // reference shares ONE TypeID with the explicit form - the single
                // authority for default-arg identity (no-op for non-templates,
                // partially-defaulted templates, and generic-parameter bindings).
                // The base of an explicit `String<...>` is resolved directly in
                // resolve_generic and deliberately bypasses this, so it is NOT
                // canonicalized here (which would nest as `String<GlobalAlloc><...>`).
                this.canonicalize_default_generic_type(this.resolve_named(n.name, ctx))
            }
            TypeAnnotation::Pointer(p) => {
                mut inner: TypeRef = this.resolve(p.inner, ctx);
                if (inner.is_valid()) {
                    return this.arena.get_pointer_to_q(inner, p.is_const);
                } else {
                    return TypeRef::invalid();
                }
            }
            TypeAnnotation::Reference(r) => {
                mut inner: TypeRef = this.resolve(r.inner, ctx);
                if (!inner.is_valid()) {
                    return TypeRef::invalid();
                }
                mut mutability: RefMutability = RefMutability::Immutable;
                if (r.is_mutable) {
                    mutability = RefMutability::Mutable;
                }
                return this.arena.get_reference_to(inner, mutability);
            }
            TypeAnnotation::Array(a) => {
                mut elem: TypeRef = this.resolve(a.element, ctx);
                // An array with an unresolvable element is itself unresolvable;
                // propagate invalid rather than minting `Array<invalid>` (which
                // later ICEs the mangler at `Array.element`). Mirrors the
                // Pointer/Reference cases above.
                if (!elem.is_valid()) {
                    return TypeRef::invalid();
                }
                return this.arena.get_array_of(elem, this.array_size_of(a, ctx));
            }
            TypeAnnotation::Function(f) => {
                this.resolve_function(f, ctx)
            }
            TypeAnnotation::Tuple(t) => {
                this.resolve_tuple(t, ctx)
            }
            TypeAnnotation::Generic(g) => {
                this.resolve_generic(g, ctx)
            }
            TypeAnnotation::Typeof(to) => {
                // `typeof(expr)` resolves to the operand's static type, which
                // only sema can derive (it needs an expression resolver and
                // the operand in scope).  Sema caches it in `resolved` before
                // this runs; we just hand it back.  Invalid here means sema
                // hasn't primed it (e.g. typeof in a position sema doesn't
                // visit, like a function signature) - surfaced as an
                // unresolved type by the caller.
                to.resolved
            }
            TypeAnnotation::ThisType(t) => {
                if (ctx.this_type.is_valid()) {
                    return ctx.this_type;
                }
                if (this.diagnostics != null) {
                    this.diagnostics.emit(Diagnostic::error(
                        ErrorCode::E0203_UNDEFINED_TYPE,
                        "`This` used outside a trait declaration or impl block"));
                }
                return TypeRef::invalid();
            }
            TypeAnnotation::ImplTrait(imp) => {
                // `implement Trait` stands for a single concrete type the
                // monomorphizer infers (from the function body's `return`
                // exprs) / sema infers (from a local's initializer) and
                // caches in `resolved`.  Like `Typeof`, the resolver itself
                // can't derive it - it just hands back the cached value.
                // Invalid here means inference hasn't primed it yet.
                imp.resolved
            }
            TypeAnnotation::Projection(proj) => {
                // `Base::Member` associated-type projection. Resolves once the
                // base's trait impl is known. The full resolution (concrete
                // base -> impl binding lookup; generic-param base -> a symbolic
                // AssocProjection type carried through monomorphization) is
                // wired in Stage 3; until then we hand back any cached value,
                // exactly like Typeof/ImplTrait.
                this.resolve_projection(proj, ctx)
            }
        };
    }

    /// Resolve an associated-type projection `Base::Member`.
    ///   * `This::Item` - resolved via the `Item` binding the impl context
    ///     carries (added by `bind_trait_args_for_impl`), so a trait default
    ///     method / impl method body referencing `This::Item` lands on the
    ///     impl's bound element.
    ///   * `I::Item` (generic-param base) - stays a symbolic AssocProjection,
    ///     resolved by the monomorphizer once `I` is specialized.
    ///   * `X::Item` (concrete base) - looks up X's impl binding (Stage 3b).
    resolve_projection(proj: ProjectionAnnotation*, ctx: ResolutionContext*) -> TypeRef {
        if (proj.resolved.is_valid()) { return proj.resolved; }

        match (*proj.base) {
            TypeAnnotation::ThisType(_tt) => {
                const b: TypeRef = ctx.lookup_binding(proj.member);
                if (b.is_valid()) { return b; }
                if (ctx.this_type.is_valid()) {
                    return this.project_from_base(ctx.this_type, proj, ctx);
                }
                return TypeRef::invalid();
            }
            _ => {}
        }

        const base_ty: TypeRef = this.resolve(proj.base, ctx);
        if (!base_ty.is_valid()) { return TypeRef::invalid(); }
        return this.project_from_base(base_ty, proj, ctx);
    }

    /// Project `member` off a resolved base type. A generic-param base yields a
    /// symbolic AssocProjection (resolved at monomorphization); a concrete base
    /// looks up that type's impl binding (wired in Stage 3b).
    project_from_base(base_ty: TypeRef, proj: ProjectionAnnotation*,
                      ctx: ResolutionContext*) -> TypeRef {
        return this.project_member(base_ty, proj.member, ctx);
    }

    /// Project associated type `member` off a resolved base type, yielding a
    /// symbolic `AssocProjection`. A generic-param base stays symbolic until
    /// specialization; a CONCRETE base (e.g. `IntSeq::Item` after `I` is bound
    /// to `IntSeq` in a spec context) is reduced to the actual member type by
    /// the monomorphizer's `reduce_projections` (which owns the impl-binding
    /// lookup via `concrete_trait_args_for`). The resolver itself only forms
    /// the projection node; it has no impl-instantiation machinery of its own.
    project_member(&this, base_ty: TypeRef, member: SymbolStr,
                   ctx: ResolutionContext*) -> TypeRef {
        const bt: Type* = this.arena.lookup(base_ty.id);
        if (bt == null) { return TypeRef::invalid(); }
        // Generic / still-symbolic base: keep it a symbolic projection, resolved
        // when the base is specialized (the monomorphizer reduces it).
        if (bt.kind == TypeKind::GenericParam || bt.kind == TypeKind::BoundedParam
                || bt.kind == TypeKind::AssocProjection) {
            return this.arena.create_assoc_projection(base_ty, member, TypeRef::invalid());
        }
        // Concrete base (`IntSeq::Item`, `Range<i32>::Item`): resolve straight
        // to the member type by reading the base's trait-impl binding, so a
        // projection never enters an enclosing instantiation (`Option<i32>`,
        // not `Option<IntSeq::Item>`). Fall back to a symbolic projection if no
        // such impl/binding is found (a later pass diagnoses the real error).
        const concrete: TypeRef = this.resolve_concrete_member(base_ty, member, ctx);
        if (concrete.is_valid()) { return concrete; }
        return this.arena.create_assoc_projection(base_ty, member, TypeRef::invalid());
    }

    /// Bare (unqualified) leaf name of a type, for keying the trait-impl
    /// registry. Generic instantiations key against the TEMPLATE's bare name.
    /// Mirrors Monomorphizer::bare_name_of.
    proj_bare_name(&this, ty: TypeRef) -> SymbolStr {
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return SymbolStr::empty(); }
        const k: TypeKind = t.kind;
        if (k == TypeKind::Int || k == TypeKind::Float || k == TypeKind::Bool ||
            k == TypeKind::Char || k == TypeKind::String) {
            return this.intern_table.intern(t.display_name());
        }
        // Instantiations key on the TEMPLATE's bare name.  Via `inst_generic_base`
        // so this holds for a post-mono concrete too - it carries its own base,
        // and without this a spec would key on its MANGLED name, which no
        // trait-impl registry holds.
        const inst_base: TypeRef = this.arena.inst_generic_base(ty);
        if (inst_base.is_valid()) {
            return this.proj_bare_name(inst_base);
        }
        const qname: SymbolStr = this.arena.get_qualified_name(ty);
        if (!qname.is_valid()) { return SymbolStr::empty(); }
        return this.symbol_bare_leaf(qname);
    }

    /// Trailing `::`-separated segment of an interned name (`core::result::Result`
    /// -> `Result`), or the name itself when unqualified. Shared by the type-side
    /// key (`proj_bare_name`) and the annotation-side one so a bound written with
    /// a qualified base compares equal to the type it projects to.
    symbol_bare_leaf(&this, qname: SymbolStr) -> SymbolStr {
        if (!qname.is_valid()) { return SymbolStr::empty(); }
        const qstr: string = this.intern_table.resolve(qname);
        const qlen: i64 = qstr.length() as i64;
        mut last_sep: i64 = -1;
        for (mut i: i64 = 0; i + 1 < qlen; i++) {
            if (qstr[i] == ':' && qstr[i + 1] == ':') { last_sep = i + 2; }
        }
        if (last_sep < 0) { return qname; }
        return this.intern_table.intern(qstr.substring(last_sep, qlen - last_sep));
    }

    /// Resolve a concrete `Base::Member` projection to the member's actual type
    /// by finding the trait (declaring `member`) that `Base` implements and
    /// reading that impl's binding for `member` (the positional trait arg under
    /// the sugar, or an explicit `type Item = ...` body binding), instantiated
    /// against `Base`'s own type arguments. Returns invalid when none applies.
    resolve_concrete_member(&this, base_ty_in: TypeRef, member: SymbolStr,
                            ctx: ResolutionContext*) -> TypeRef {
        if (this.generic_registry == null) { return TypeRef::invalid(); }
        // The base is used directly whether it is a pre-mono InstantiatedType
        // wrapper or a post-mono concrete spec: `proj_bare_name` resolves either to
        // the TEMPLATE's bare name, and the args below come from the same
        // representation-neutral views.  (This used to recover the origin carrier
        // first, because a concrete spec answered with its mangled name and no
        // type_args.)
        const base_ty: TypeRef = base_ty_in;
        const bt: Type* = this.arena.lookup(base_ty.id);
        if (bt == null) { return TypeRef::invalid(); }
        const bare: SymbolStr = this.proj_bare_name(base_ty);
        if (!bare.is_valid()) { return TypeRef::invalid(); }

        // Element-wise copy, NOT a by-value array assignment: that would alias the
        // type's owning `type_args` buffer, and dropping the local at function exit
        // would free the base type's live storage (use-after-free that silently
        // corrupts a sibling instantiation's args - surfaces as a cyclic type graph
        // and a SIGSEGV when chaining adapters, e.g. `First<First<IntSeq>>`).
        // `inst_type_arg_at` returns by value, so this stays a copy by construction.
        mut base_args: TypeRef[] = [];
        const base_nargs: i64 = this.arena.inst_type_arg_count(base_ty);
        for (mut bi: i64 = 0; bi < base_nargs; bi++) {
            base_args.push(this.arena.inst_type_arg_at(base_ty, bi));
        }

        for (mut i: i64 = 0; i < this.generic_registry.trait_decl_nodes.length; i++) {
            const tdecl: TraitDeclNode* = this.generic_registry.trait_decl_nodes[i];
            if (tdecl == null) { continue; }
            mut assoc_pos: i64 = -1;
            for (mut a: i64 = 0; a < tdecl.assoc_types.length; a++) {
                if (tdecl.assoc_types[a] != null
                        && tdecl.assoc_types[a].name.equals(member)) {
                    assoc_pos = a;
                    break;
                }
            }
            if (assoc_pos < 0) { continue; }
            const impl_node: ImplBlockNode* =
                OwnershipQuery::resolve_trait_impl_for_type(this.arena,
                    this.generic_registry, this.intern_table, tdecl.name, base_ty);
            if (impl_node == null) { continue; }

            // The binding annotation: positional trait arg (sugar) at
            // generic-params + assoc index, else an explicit body binding.
            mut ann: TypeAnnotation* = null;
            const idx: i64 = tdecl.generic_params.length + assoc_pos;
            if (impl_node.trait_annotation != null) {
                match (*impl_node.trait_annotation) {
                    TypeAnnotation::Generic(g) => {
                        if (idx < g.args.length) { ann = g.args[idx]; }
                    }
                    _ => {}
                }
            }
            if (ann == null) { ann = impl_node.lookup_assoc_binding(member); }
            if (ann == null) { continue; }

            // Resolve the binding with the impl's target params bound to the
            // base's concrete args (`T -> i32` for `Range<i32>`); empty for a
            // non-generic base like `IntSeq`.
            mut bctx: ResolutionContext = ResolutionContext::new("", "");
            if (impl_node.target_args.length == base_args.length) {
                for (mut ti: i64 = 0; ti < impl_node.target_args.length; ti++) {
                    const ta: TypeAnnotation* = impl_node.target_args[ti];
                    if (ta == null) { continue; }
                    match (*ta) {
                        TypeAnnotation::Named(n) => { bctx.add_binding(n.name, base_args[ti]); }
                        _ => {}
                    }
                }
            }
            // An adapter whose item is carried only by a where-bound
            // (`implement<I,A> Iterator<A> for TakeIter<I> where I: Iterator<A>`)
            // names `A` in its `Item` binding, but `A` is not a target param - 
            // it is determined by `I: Iterator<A>` once `I` is concrete. Derive
            // those where-clause generics into `bctx` so the binding resolves.
            this.derive_where_assoc_bindings(impl_node, &bctx);
            const r: TypeRef = this.resolve(ann, &bctx);
            if (r.is_valid()) {
                const rt: Type* = this.arena.lookup(r.id);
                // Guard against returning another unresolved projection.
                if (rt != null && rt.kind != TypeKind::AssocProjection) {
                    return r;
                }
            }
        }
        return TypeRef::invalid();
    }

    /// Bind impl where-clause-derived generics into `bctx` for projection
    /// resolution. An adapter can carry its associated item only through a
    /// where-bound - `implement<I,A> Iterator<A> for TakeIter<I>
    /// where I: Iterator<A>` binds `Item` to `A`, but `A` is not a target
    /// parameter; it is determined by `I: Iterator<A>` once `I` is concrete.
    /// For each bound whose subject is already bound to a concrete type in
    /// `bctx`, project the bound trait's associated type(s) off that concrete
    /// subject and bind the corresponding positional generic param. Mirrors the
    /// monomorphizer's `derive_impl_where_generics`, recursing through
    /// `resolve_concrete_member` so a chain of adapters bottoms out at the
    /// source. Only simple `Named` param args are bound (a projection or
    /// concrete arg names no generic to derive); existing bindings are kept.
    derive_where_assoc_bindings(&this, impl_node: ImplBlockNode*,
                                bctx: ResolutionContext*) -> void {
        if (impl_node == null) { return; }
        for (mut bi: i64 = 0; bi < impl_node.where_bounds.length; bi++) {
            const bound: TraitBound* = &impl_node.where_bounds[bi];
            const subject: TypeRef = bctx.lookup_binding(bound.type_parameter);
            if (!subject.is_valid()) { continue; }
            for (mut ti: i64 = 0; ti < bound.trait_refs.length; ti++) {
                const tr: TraitRef* = &bound.trait_refs[ti];
                if (tr.path.length == 0) { continue; }
                const trait_leaf: SymbolStr = tr.path[tr.path.length - 1];
                const tdecl: TraitDeclNode* =
                    this.generic_registry.get_trait_decl(trait_leaf);
                if (tdecl == null) { continue; }
                const ngp: i64 = tdecl.generic_params.length;
                for (mut ai: i64 = 0; ai < tr.type_args.length; ai++) {
                    // Positional args fill generic params first, then assoc
                    // types; only the assoc-type slots derive a member here.
                    if (ai < ngp) { continue; }
                    const assoc_idx: i64 = ai - ngp;
                    if (assoc_idx >= tdecl.assoc_types.length) { continue; }
                    if (tdecl.assoc_types[assoc_idx] == null) { continue; }
                    const arg_ann: TypeAnnotation* = tr.type_args[ai];
                    if (arg_ann == null) { continue; }
                    const member: SymbolStr = tdecl.assoc_types[assoc_idx].name;
                    const derived: TypeRef =
                        this.resolve_concrete_member(subject, member, bctx);
                    if (derived.is_valid()) {
                        this.bind_where_arg_into_ctx(arg_ann, derived, bctx);
                    }
                }
            }
        }
    }

    /// Bind the generic param(s) named in a where-bound trait arg against the
    /// concrete member type derived from the subject, peeling pointer/reference
    /// wrappers so `where I: Iterator<T*>` binds `T` to the pointee of the
    /// subject's `Item` (the `CopiedIter`/`ClonedIter` by-ref->by-value bridge).
    /// Mirrors the monomorphizer's `bind_where_arg_param`. Existing bindings are
    /// kept (the Self-type substitution already fixed any struct params).
    bind_where_arg_into_ctx(&this, ta: TypeAnnotation*, concrete: TypeRef,
                            bctx: ResolutionContext*) -> void {
        if (ta == null || !concrete.is_valid()) { return; }
        match (*ta) {
            TypeAnnotation::Named(n) => {
                if (!bctx.lookup_binding(n.name).is_valid()) {
                    bctx.add_binding(n.name, concrete);
                }
            }
            TypeAnnotation::Pointer(p) => {
                const ct: Type* = this.arena.lookup(concrete.id);
                if (ct != null && ct.kind == TypeKind::Pointer) {
                    this.bind_where_arg_into_ctx(p.inner,
                        (ct as PointerType*).pointee, bctx);
                }
            }
            TypeAnnotation::Reference(r) => {
                const ct: Type* = this.arena.lookup(concrete.id);
                if (ct != null && ct.kind == TypeKind::Reference) {
                    this.bind_where_arg_into_ctx(r.inner,
                        (ct as ReferenceType*).referent, bctx);
                }
            }
            _ => {}
        }
    }

    /// Bound-directed projection ("PASS D"), shared by the free-function and both
    /// (static + instance) generic-method call paths. A type param that appears
    /// ONLY in a where-bound `P: Trait<…, R, …>` (never in a value parameter) is a
    /// functional dependency of `P`: once `P` is bound to a concrete subject, `R`
    /// is that subject's associated-type binding for the trait's positional-sugar
    /// slot (`Future<R>` ⇒ `R = P::Output`; `Iterator<T>` ⇒ `T = P::Item`). For
    /// each still-unbound assoc-slot param, project the trait's assoc type off the
    /// now-bound subject and fill it, so argument inference alone settles a
    /// return-only / bound-only param without a turbofish or expected-type hint.
    /// `param_names[i]` MUST align with `ictx.bindings[i]` (the caller builds the
    /// InferCtx from the same ordered param list). Index-keyed analogue of the
    /// impl-side `derive_where_assoc_bindings`; an existing binding is kept.
    ///
    /// The slot arg need not BE a param. A COMPOUND arg
    /// (`A: Future<Result<T1, E>>`) mentions its params only inside a nested
    /// generic, and those are recovered by pairing the annotation against the
    /// projected type (`bind_where_arg_params_from`) rather than adopting it
    /// whole. Without that, such a param stays abstract and the whole binding set
    /// is discarded — the gap that made `Futures::try_join` unconstructible.
    ///
    /// The subject need only be free of OPEN generic params (so its trait impl is
    /// findable) — NOT mono-resolved: `resolve_concrete_member` handles a pre-mono
    /// `Ready<i32>` whose monomorphized form does not exist yet (as `resolve_await`
    /// relies on), so guarding on `contains_generic_param` rather than a
    /// concreteness check is deliberate.
    ///
    /// `symbolic` (the caller's symbolic-walk flag) admits an ABSTRACT subject.
    /// Handing `block_on<F, R>` an argument typed `S::ReadFut` binds `F` to that
    /// projection, and `R` is then legitimately `(S::ReadFut)::Output` — abstract,
    /// but the correct answer inside a generic body, and monomorphization
    /// substitutes it with the rest. Refusing to derive it leaves `R` unbound, the
    /// caller discards the whole binding set, and the call reaches codegen
    /// unspecialized (E0636). Outside the symbolic walk an abstract subject has no
    /// findable impl, so it still derives nothing.
    project_where_bound_params_into(&this, trait_bounds: &TraitBound[],
                                    param_names: &SymbolStr[], ictx: InferCtx*,
                                    source_file: string, symbolic: boolean) -> void {
        if (this.generic_registry == null) { return; }
        for (mut bi: i64 = 0; bi < trait_bounds.length; bi++) {
            const bound: TraitBound* = &trait_bounds[bi];
            if (bound.has_projection_subject()) { continue; }
            const s: i64 = this.param_name_slot(param_names, bound.type_parameter);
            if (s < 0 || s >= ictx.bindings.length) { continue; }
            const subject: TypeRef = ictx.bindings[s];
            if (!subject.is_valid()) { continue; }
            const subject_abstract: boolean = this.arena.contains_generic_param(subject);
            if (subject_abstract && !symbolic) { continue; }
            for (mut ti: i64 = 0; ti < bound.trait_refs.length; ti++) {
                const tr: TraitRef* = &bound.trait_refs[ti];
                if (tr.path.length == 0) { continue; }
                const trait_leaf: SymbolStr = tr.path[tr.path.length - 1];
                const tdecl: TraitDeclNode* = this.generic_registry.get_trait_decl(trait_leaf);
                if (tdecl == null) { continue; }
                const ngp: i64 = tdecl.generic_params.length;
                for (mut ai: i64 = 0; ai < tr.type_args.length; ai++) {
                    // Positional args fill the trait's own generic params first,
                    // then its associated types; only the assoc-type slots derive.
                    if (ai < ngp) { continue; }
                    const assoc_idx: i64 = ai - ngp;
                    if (assoc_idx >= tdecl.assoc_types.length) { continue; }
                    if (tdecl.assoc_types[assoc_idx] == null) { continue; }
                    const arg_ann: TypeAnnotation* = tr.type_args[ai];
                    // A BARE `Named` arg is the direct functional dependency: the
                    // whole assoc type IS the param (`Future<R>` => `R = P::Output`).
                    // A COMPOUND arg (`Future<Result<T1, E>>`) reaches its params
                    // only by destructuring what the projection yields, which
                    // `bind_where_arg_params_from` does below. Both need the same
                    // projection, so decide which case this is, then project once.
                    const j: i64 = this.where_arg_param_slot(arg_ann, param_names);
                    if (j >= 0) {
                        if (j >= ictx.bindings.length || ictx.bindings[j].is_valid()) { continue; }
                    } else {
                        // Nothing left to solve in this arg: don't pay for a lookup.
                        if (!this.where_arg_has_unbound_param(arg_ann, param_names, ictx)) { continue; }
                    }
                    mut rc: ResolutionContext = ResolutionContext::new(source_file, "");
                    const member: SymbolStr = tdecl.assoc_types[assoc_idx].name;
                    if (subject_abstract) {
                        // `project_member` keeps an abstract base symbolic, giving
                        // the projection mono reduces once the base specializes.
                        // Only a bare param can adopt that opaque projection whole;
                        // a compound arg has no structure to pair against until the
                        // base specializes, so it derives nothing here.
                        if (j < 0) { continue; }
                        const sym_d: TypeRef = this.project_member(subject, member, &rc);
                        if (sym_d.is_valid()) { ictx.bind_slot(j, sym_d); }
                        continue;
                    }
                    const derived: TypeRef = this.resolve_concrete_member(subject, member, &rc);
                    if (!derived.is_valid() || this.arena.contains_generic_param(derived)) { continue; }
                    if (j >= 0) {
                        ictx.bind_slot(j, derived);
                    } else {
                        this.bind_where_arg_params_from(arg_ann, param_names, derived, ictx);
                    }
                }
            }
        }
    }

    /// Index of `name` in an ordered generic-param-name list, or -1. The list,
    /// the caller's param-id list, and the InferCtx's `bindings` share one index
    /// space (all built from the same ordered generic params).
    param_name_slot(&this, param_names: &SymbolStr[], name: SymbolStr) -> i64 {
        for (mut i: i64 = 0; i < param_names.length; i++) {
            if (param_names[i].equals(name)) { return i; }
        }
        return -1;
    }

    /// The param-list index a where-bound trait arg names, or -1 when it is not a
    /// bare `Named` parameter reference (a wrapped/concrete arg derives nothing).
    where_arg_param_slot(&this, ta: TypeAnnotation*, param_names: &SymbolStr[]) -> i64 {
        if (ta == null) { return -1; }
        match (*ta) {
            TypeAnnotation::Named(n) => { return this.param_name_slot(param_names, n.name); }
            _                       => { return -1; }
        }
    }

    /// True when `ta` names, at any depth, a param this context has not solved
    /// yet. Gates the associated-type projection in
    /// `project_where_bound_params_into`: an arg that can bind nothing new must
    /// not pay for the lookup, which keeps the cost of the compound case on the
    /// bounds that actually need it.
    where_arg_has_unbound_param(&this, ta: TypeAnnotation*, param_names: &SymbolStr[],
                                ictx: InferCtx*) -> boolean {
        if (ta == null) { return false; }
        match (*ta) {
            TypeAnnotation::Named(n) => {
                const s: i64 = this.param_name_slot(param_names, n.name);
                if (s < 0 || s >= ictx.bindings.length) { return false; }
                return !ictx.bindings[s].is_valid();
            }
            TypeAnnotation::Generic(g) => {
                for (mut i: i64 = 0; i < g.args.length; i++) {
                    if (this.where_arg_has_unbound_param(g.args[i], param_names, ictx)) { return true; }
                }
                return false;
            }
            _ => { return false; }
        }
    }

    /// Pair a COMPOUND where-bound trait arg against the type projected off the
    /// now-bound subject, binding each param the annotation names at the position
    /// it occupies: `A: Future<Result<T1, E>>` with `A::Output = Result<i64, bool>`
    /// binds `T1 = i64` and `E = bool`. Without this a param reachable only by
    /// destructuring a nested generic in the bound stays abstract, the caller
    /// discards the incomplete binding set, and the call reaches codegen
    /// unspecialized (E0636) or fails E0200 against the still-abstract shape —
    /// which is what kept `Futures::try_join` unconstructible.
    ///
    /// Positional pairing is only sound when the two sides are the same
    /// constructor, so the bases are compared by bare leaf; `Result<T1, E>` must
    /// not bind its params off a `Pair<i64, bool>` that merely has two args. Any
    /// shape mismatch is a silent no-op rather than an error: this is inference,
    /// and `check_call_where_bounds` is what rejects a bound the subject really
    /// fails to satisfy.
    bind_where_arg_params_from(&this, ta: TypeAnnotation*, param_names: &SymbolStr[],
                               actual: TypeRef, ictx: InferCtx*) -> void {
        if (ta == null || !actual.is_valid()) { return; }
        match (*ta) {
            TypeAnnotation::Named(n) => {
                const s: i64 = this.param_name_slot(param_names, n.name);
                if (s >= 0) { ictx.bind_slot(s, actual); }
            }
            TypeAnnotation::Generic(g) => {
                if (g.base == null) { return; }
                const want: SymbolStr = match (*g.base) {
                    TypeAnnotation::Named(bn) => { this.symbol_bare_leaf(bn.name) }
                    _                         => { SymbolStr::empty() }
                };
                if (!want.is_valid()) { return; }
                const got: SymbolStr = this.proj_bare_name(actual);
                if (!got.is_valid() || !got.equals(want)) { return; }
                if (this.arena.inst_type_arg_count(actual) != g.args.length) { return; }
                for (mut i: i64 = 0; i < g.args.length; i++) {
                    this.bind_where_arg_params_from(g.args[i], param_names,
                                                    this.arena.inst_type_arg_at(actual, i), ictx);
                }
            }
            _ => { }
        }
    }

    // Batch resolution helpers (shared by TypeResolution & Monomorphizer)

    /// Resolve a function's return type and parameter type annotations.
    /// Sets resolved_return_type on the FunctionDeclNode and resolved_type
    /// on each parameter VarDeclNode.
    resolve_func_signature(&this, func: FunctionDeclNode*,
                           res_ctx: ResolutionContext*) -> void {
        if (func == null) { return; }
        const _fname: string = this.intern_table.resolve(func.name);
        cdebug("[ResFuncSig] enter func=%p '%s' params=%lld body=%p ret_ann=%p\n",
               func, _fname, func.parameters.length,
               func.body, func.return_type_annotation);

        // Resolve return type
        if (func.return_type_annotation != null && !func.has_resolved_return_type()) {
            cdebug("[ResFuncSig]   resolving return type\n");
            const ret: TypeRef = this.resolve(func.return_type_annotation, res_ctx);
            if (ret.is_valid()) {
                func.resolved_return_type = ret;
            } else {
                // `implement Trait` returns invalid from `resolve` until inference
                // primes its `resolved` slot.  Infer the concrete type the
                // opaque alias stands for from the body's return expression,
                // here - before any caller mangles this signature.  Runs for
                // both non-generic methods (concrete body) and generic
                // templates / specializations (body already substituted by
                // the time the spec path re-enters this function).
                this.infer_impl_trait_return(func, res_ctx);
            }
        }
        // Default to void if no return type annotation was provided.
        // Methods like `increment_column(mut &this) { ... }` omit `-> void`.
        if (func.return_type_annotation == null && !func.has_resolved_return_type()) {
            func.resolved_return_type = this.arena.get_void();
        }

        // Resolve parameter types
        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null) { continue; }
            if (param.type_annotation != null && !param.resolved_type.is_valid()) {
                const ptype: TypeRef = this.resolve(param.type_annotation, res_ctx);
                if (ptype.is_valid()) {
                    param.resolved_type = ptype;
                }
            }
        }

    }

    /// Infer the concrete type an `implement Trait` return annotation stands for,
    /// from `func`'s first `return` expression, and cache it into both the
    /// annotation's `resolved` slot (so a later `resolve` of the same
    /// annotation hands it back) and `func.resolved_return_type`.
    ///
    /// Cryo is fully monomorphizing with no type erasure, so `implement Trait` is
    /// an opaque ALIAS: each function has exactly one concrete return type.
    /// Currently the return expression must be a struct literal
    /// (`return SomeIter<T> { ... }`), which covers every collection iterator
    /// entry point; other shapes leave the return unresolved (a clear
    /// downstream error rather than a silent miscompile).
    infer_impl_trait_return(&this, func: FunctionDeclNode*,
                            res_ctx: ResolutionContext*) -> void {
        if (func == null || func.return_type_annotation == null) { return; }
        mut imp: ImplTraitAnnotation* = null;
        match (*func.return_type_annotation) {
            TypeAnnotation::ImplTrait(node) => { imp = node; }
            _ => { return; }
        }
        if (imp == null) { return; }
        if (imp.resolved.is_valid()) {
            func.resolved_return_type = imp.resolved;
            return;
        }
        const ret_expr: ExpressionNode* =
            this.find_first_return_expr(func.body);
        if (ret_expr == null) { return; }
        const concrete: TypeRef = this.type_of_impl_return_expr(ret_expr, res_ctx);
        if (!concrete.is_valid()) { return; }
        imp.resolved = concrete;
        func.resolved_return_type = concrete;
    }

    /// Type an `implement Trait` body's return expression.  Only struct literals
    /// are supported for now; their type is `Name<Args>` recovered from the
    /// literal's struct name + generic args (already substituted to concrete
    /// types in a specialized body) and resolved through `res_ctx`.
    type_of_impl_return_expr(&this, expr: ExpressionNode*,
                             res_ctx: ResolutionContext*) -> TypeRef {
        if (expr == null) { return TypeRef::invalid(); }
        const node: ASTNode* = expr as ASTNode*;
        if (node.kind != NodeKind::StructLiteral) {
            return TypeRef::invalid();
        }
        const sl: StructLiteralNode* = expr as StructLiteralNode*;
        const name_ann: NamedAnnotation* = new NamedAnnotation {
            name:         sl.struct_type,
            span:         SourceSpan::none(),
            pre_resolved: TypeRef::invalid(),
        };
        mut result_ann: TypeAnnotation* = new TypeAnnotation::Named(name_ann);
        if (sl.generic_args.length > 0) {
            mut cloned_args: TypeAnnotation*[] = [];
            for (mut i: i64 = 0; i < sl.generic_args.length; i++) {
                cloned_args.push(TypeAnnotation::clone_ptr(sl.generic_args[i]));
            }
            const gen: GenericAnnotation* = new GenericAnnotation {
                base: result_ann,
                args: cloned_args,
                span: SourceSpan::none(),
            };
            result_ann = new TypeAnnotation::Generic(gen);
        }
        return this.resolve(result_ann, res_ctx);
    }

    /// First `return <expr>;` expression reachable from `block`, descending
    /// through nested blocks and `if` branches.  All returns of an
    /// `implement Trait` body must yield the same concrete type, so the first one
    /// is authoritative.
    find_first_return_expr(&this, block: BlockStmtNode*) -> ExpressionNode* {
        if (block == null) { return null; }
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            const e: ExpressionNode* =
                this.find_first_return_expr_in_stmt(block.statements[i]);
            if (e != null) { return e; }
        }
        return null;
    }

    find_first_return_expr_in_stmt(&this, stmt: StatementNode*) -> ExpressionNode* {
        if (stmt == null) { return null; }
        const node: ASTNode* = stmt as ASTNode*;
        match (node.kind) {
            NodeKind::ReturnStatement => {
                const rs: ReturnStmtNode* = stmt as ReturnStmtNode*;
                return rs.expression;
            }
            NodeKind::BlockStatement => {
                return this.find_first_return_expr(stmt as BlockStmtNode*);
            }
            NodeKind::IfStatement => {
                const ifs: IfStmtNode* = stmt as IfStmtNode*;
                if (ifs.then_stmt != null) {
                    const e: ExpressionNode* =
                        this.find_first_return_expr_in_stmt(ifs.then_stmt);
                    if (e != null) { return e; }
                }
                if (ifs.has_else() && ifs.else_stmt != null) {
                    return this.find_first_return_expr_in_stmt(ifs.else_stmt);
                }
                return null;
            }
            _ => { return null; }
        }
    }

    /// Resolve type annotations on an array of FieldDeclNode.
    resolve_fields(&this, fields: &FieldDeclNode*[],
                   res_ctx: ResolutionContext*) -> void {
        for (mut i: i64 = 0; i < fields.length; i++) {
            const field: FieldDeclNode* = fields[i];
            if (field == null) { continue; }
            if (field.type_annotation != null && !field.resolved_type.is_valid()) {
                const ftype: TypeRef = this.resolve(field.type_annotation, res_ctx);
                if (ftype.is_valid()) {
                    field.resolved_type = ftype;
                }
            }
        }
    }

    /// Resolve all method signatures (MethodNode*[]) on a struct/class/impl.
    /// `owner_type` is the receiver type, used to back-fill the
    /// `this`/`&this` parameter's resolved_type, which the parser leaves
    /// unset because the receiver is implicit-typed.  Without this, by-value
    /// `this` on primitive impls (e.g. `f64::trunc(this) -> f64`) reaches
    /// codegen with no resolved_type and gets dropped from the function's
    /// LLVM signature, producing a 0-arg `define` for what should be a
    /// 1-arg method.
    resolve_method_signatures(&this, methods: &MethodNode*[],
                              res_ctx: ResolutionContext*,
                              owner_type: TypeRef,
                              owner_qname: SymbolStr) -> void {
        const this_ref_name: SymbolStr = this.intern_table.intern("&this");
        const this_val_name: SymbolStr = this.intern_table.intern("this");
        // Bind `This` to the impl's owner type for the duration of method-
        // signature resolution. `&This` annotations on parameters/returns
        // resolve to `owner_type` here; the by-name back-fill at the bottom
        // of this function still handles the implicit-typed `&this` receiver.
        if (owner_type.is_valid()) {
            res_ctx.set_this_type(owner_type);
        }
        cdebug("[ResMthSig] count=%lld owner_id=%d\n", methods.length, owner_type.id as i32);
        for (mut i: i64 = 0; i < methods.length; i++) {
            const method: MethodNode* = methods[i];
            if (method == null || method.func == null) { continue; }

            const _mname: string = this.intern_table.resolve(method.func.name);
            cdebug("[ResMthSig]   [%lld] method='%s' generic=%d\n", i, _mname, method.func.is_generic() as i32);

            // If the method itself is generic, bind its own params
            if (method.func.is_generic()) {
                mut method_ctx: ResolutionContext = res_ctx.clone();
                for (mut j: i64 = 0; j < method.func.generic_params.length; j++) {
                    const gp: GenericParamNode* = method.func.generic_params[j];
                    const gp_ref: TypeRef = this.create_param_type(gp, j as u64);
                    method_ctx.add_binding(gp.name, gp_ref);
                }
                this.resolve_func_signature(method.func, &method_ctx);
            } else {
                this.resolve_func_signature(method.func, res_ctx);
            }

            // Anti-tower: flag a non-generic INSTANCE method whose resolved
            // return type (or a non-receiver param) is a strict structural
            // superterm of the owner - e.g. `Option<T>::as_ref -> Option<T*>`.
            // Eagerly materializing such a method recurses forever (each level
            // grows the type args: `Option<T*>`, `Option<T**>`, ...).  Reuse the
            // `is_self_returning_default` path, whose operational meaning is
            // "skip every eager-materialization site, instantiate lazily at the
            // call site" (MonoCallSpecializer::try_instantiate_self_returning_default
            // materializes the spec'd copy on demand and discovers its return
            // type's instantiation there).  Only the self-growing method is
            // deferred - drop glue and all other methods stay eager, so the
            // post-mono DropInsertion contract is unaffected.  Restricted to
            // 0-own-generic instance methods because that is the only shape the
            // lazy call path materializes.
            //
            // Compared by the owner's QUALIFIED NAME, not a `TypeRef`: for an
            // `implement enum`/`implement` block the owner `TypeRef` handed in
            // is often invalid at this pass (the receiver is back-filled later),
            // so a TypeRef-identity check would silently never fire.
            if (owner_qname.is_valid()
                    && !method.func.is_generic()
                    && !method.is_static
                    && !method.func.is_self_returning_default
                    && !method.func.is_lazy_self_growing) {
                mut grows: boolean = method.func.resolved_return_type.is_valid()
                    && this.arena.is_self_growing_instantiation(
                           method.func.resolved_return_type, owner_qname);
                if (!grows) {
                    for (mut gp: i64 = 0; gp < method.func.parameters.length; gp++) {
                        const gparam: VarDeclNode* = method.func.parameters[gp];
                        if (gparam == null || !gparam.resolved_type.is_valid()) { continue; }
                        // Skip the receiver: `&this`/`this` is the owner itself,
                        // never a superterm.
                        if (gparam.name.equals(this_ref_name)
                                || gparam.name.equals(this_val_name)) { continue; }
                        if (this.arena.is_self_growing_instantiation(
                                gparam.resolved_type, owner_qname)) {
                            grows = true;
                            break;
                        }
                    }
                }
                if (grows) {
                    method.func.set_lazy_self_growing(true);
                }
            }

            // Back-fill `this`/`&this` resolved_type from owner_type when
            // the param has no annotation (parser leaves it null on the
            // receiver; there's nothing to write there at parse time).
            // `&this` resolves to a Pointer to owner; bare `this` resolves
            // to owner directly.
            if (method.is_static || !owner_type.is_valid()) { continue; }
            for (mut p: i64 = 0; p < method.func.parameters.length; p++) {
                const param: VarDeclNode* = method.func.parameters[p];
                if (param == null || param.resolved_type.is_valid()) { continue; }
                if (param.name.equals(this_val_name)) {
                    param.resolved_type = owner_type;
                } else if (param.name.equals(this_ref_name)) {
                    param.resolved_type = this.arena.get_pointer_to(owner_type);
                }
            }
        }
    }

    /// Create the arena TypeRef for a `GenericParamNode` at position `index`.
    /// When the param has constraints (`<T: Eq + Hash>`), each constraint
    /// name is resolved against the arena's leaf index to produce a trait
    /// TypeRef and the param is created as a `BoundedParamType`. Constraints
    /// that don't resolve fall back to a plain `GenericParamType`, which is better
    /// than ICE'ing during partial-pipeline runs.
    create_param_type(&this, gp: GenericParamNode*, index: u64) -> TypeRef {
        if (gp == null) { return TypeRef::invalid(); }
        mut bounds: TypeRef[] = [];
        for (mut k: i64 = 0; k < gp.constraints.length; k++) {
            const trait_ref: TypeRef = this.arena.lookup_by_leaf(gp.constraints[k]);
            if (trait_ref.is_valid()) {
                bounds.push(trait_ref);
            }
        }
        if (bounds.length > 0) {
            return this.arena.create_bounded_param(gp.name, index, bounds);
        }
        // `bounds` is empty here but still an owning Array; drop it so it is
        // consumed on this path too (create_bounded_param consumes it on the
        // other), keeping the move state consistent.
        bounds.drop();
        return this.arena.create_generic_param(gp.name, index);
    }

    /// Fill missing trailing args from a TemplateEntry's default annotations.
    /// `args` may be shorter than `entry.param_count`; for each missing
    /// trailing param, resolve its `default_annotation` in a context that
    /// has the args resolved so far bound to their param names. Returns
    /// the args list unchanged when `args.length >= entry.param_count`,
    /// when a missing param has no default, or when a default annotation
    /// fails to resolve.
    expand_default_type_args(&this, entry: TemplateEntry*, args: TypeRef[],
                             ctx: ResolutionContext*) -> TypeRef[] {
        if (entry == null) { return args; }
        if (args.length >= entry.param_count) { return args; }
        const params: GenericParamNode*[] = entry.get_generic_params();
        const start: i64 = args.length;
        mut filled: TypeRef[] = args;
        for (mut i: i64 = start; i < entry.param_count; i++) {
            if (i >= params.length) { return filled; }
            const gp: GenericParamNode* = params[i];
            if (gp == null || !gp.has_default_annotation()) { return filled; }
            mut def_ctx: ResolutionContext = ctx.clone();
            for (mut j: i64 = 0; j < filled.length; j++) {
                def_ctx.add_binding(entry.param_names[j], filled[j]);
            }
            const def_type: TypeRef = this.resolve(gp.default_annotation, &def_ctx);
            if (!def_type.is_valid()) { return filled; }
            filled.push(def_type);
        }
        return filled;
    }

    /// Resolve all function signatures (FunctionDeclNode*[]) on a trait.
    ///
    /// Inside a trait body, `This` is a symbolic placeholder for the type
    /// that future impls will bind. We give it a stable identity by
    /// synthesizing a deduplicated GenericParam("This", sentinel-index);
    /// this lets `&This` parameters and `-> This` returns resolve to a real
    /// TypeRef that downstream substitution can rewrite per-impl.
    resolve_trait_method_signatures(&this, methods: &FunctionDeclNode*[],
                                    res_ctx: ResolutionContext*) -> void {
        if (!res_ctx.this_type.is_valid()) {
            const this_name: SymbolStr = this.intern_table.intern("This");
            // Sentinel index well above any plausible real generic-param
            // count. arena.create_generic_param dedups by (name.id, index),
            // so every trait shares this canonical `This` placeholder.
            const this_placeholder: TypeRef =
                this.arena.create_generic_param(this_name, 0xFFFFFFFF as u64);
            res_ctx.set_this_type(this_placeholder);
        }

        for (mut i: i64 = 0; i < methods.length; i++) {
            const func: FunctionDeclNode* = methods[i];
            if (func == null) { continue; }

            if (func.is_generic()) {
                mut method_ctx: ResolutionContext = res_ctx.clone();
                for (mut j: i64 = 0; j < func.generic_params.length; j++) {
                    const gp: GenericParamNode* = func.generic_params[j];
                    const gp_ref: TypeRef = this.create_param_type(gp, j as u64);
                    method_ctx.add_binding(gp.name, gp_ref);
                }
                this.resolve_func_signature(func, &method_ctx);
            } else {
                this.resolve_func_signature(func, res_ctx);
            }
        }
    }

    /// Resolve a primitive type name to its arena singleton.  Public because
    /// sema reuses it to resolve `new T[n]` element types whose name is a
    /// primitive keyword (`new int[100]`) - keeping one canonical name table.
    resolve_primitive(&this, name: SymbolStr) -> TypeRef {
        LOG_DEBUG(LogComponent::TypeChecker, "[TypeResolver] resolve_primitive() name='%s'", this.intern_table.resolve(name));
        return match (this.intern_table.resolve(name)) {
            "void"    => { this.arena.get_void() }
            "boolean" => { this.arena.get_bool() }
            "char"    => { this.arena.get_char() }
            "string"  => { this.arena.get_string() }
            "never"   => { this.arena.get_never() }
            "va_list" => { this.arena.get_va_list() }

            "i8"      => { this.arena.get_i8() }
            "i16"     => { this.arena.get_i16() }
            "i32"     => { this.arena.get_i32() }
            "i64"     => { this.arena.get_i64() }
            "i128"    => { this.arena.get_i128() }

            "u8"      => { this.arena.get_u8() }
            "u16"     => { this.arena.get_u16() }
            "u32"     => { this.arena.get_u32() }
            "u64"     => { this.arena.get_u64() }
            "u128"    => { this.arena.get_u128() }

            "isize"   => { this.arena.get_isize() }
            "usize"   => { this.arena.get_usize() }

            "f32"     => { this.arena.get_f32() }
            "f64"     => { this.arena.get_f64() }

            "int"     => { this.arena.get_i32() }
            "uint"    => { this.arena.get_u32() }
            "float"   => { this.arena.get_f32() }
            "double"  => { this.arena.get_f64() }

            _         => { TypeRef::invalid() }
        }
    }

    /// Fold an already-resolved BARE reference to a generic whose parameters
    /// are ALL defaulted (`String` for `String<A = GlobalAlloc>`) into its
    /// fully-defaulted instantiation (`String<GlobalAlloc>`).
    ///
    /// A bare `String` and a `-> String` return must denote the SAME concrete
    /// type, but a method's return annotation resolved during bootstrap keeps
    /// the raw template base while annotation / inference paths land on
    /// `String<GlobalAlloc>`.  The divergence mints two manglings of one type -
    /// surfacing as a spurious `Box<String/*bare*/>::clone` that calls a
    /// never-emitted bare `String::clone` (link error).  Read sites (e.g. a
    /// method's stored return type) call this so every path agrees.
    ///
    /// Operates on an already-resolved TypeRef (not an annotation), so unlike
    /// a resolve-time canonicalizer it cannot stack onto an explicit
    /// `Type<ExplicitArgs>` (those resolve to an `InstantiatedType`, which is
    /// skipped here).  Uses the arena's dedup instantiation - NO new demand:
    /// the all-default form is already demanded wherever the type is used, and
    /// the canonical TypeRef flows on through normal mono discovery.  No-op
    /// unless `ty` is a registered template BASE with >0 params, every one
    /// defaulted.
    canonicalize_default_generic_type(&this, ty: TypeRef) -> TypeRef {
        if (!ty.is_valid() || this.generic_registry == null) { return ty; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return ty; }
        if (t.kind != TypeKind::Struct
                && t.kind != TypeKind::Class
                && t.kind != TypeKind::Enum) { return ty; }
        const entry: TemplateEntry* =
            this.generic_registry.get_template_by_type_id(ty.id);
        if (entry == null || entry.param_count <= 0) { return ty; }
        const params: GenericParamNode*[] = entry.get_generic_params();
        if (params.length < entry.param_count) { return ty; }
        for (mut i: i64 = 0; i < entry.param_count; i++) {
            const gp: GenericParamNode* = params[i];
            if (gp == null || !gp.has_default_annotation()) { return ty; }
        }
        mut ctx: ResolutionContext = ResolutionContext::new("", "");
        mut empty: TypeRef[] = [];
        const filled: TypeRef[] = this.expand_default_type_args(entry, empty, &ctx);
        if (filled.length != entry.param_count) { return ty; }
        return this.arena.create_instantiation(ty, &filled);
    }


private:
    // Dispatch helpers

    /// Unwrap non-generic TypeAlias wrappers so downstream passes never see
    /// an alias in a resolved type.  Aliases are a naming convenience at the
    /// source level, not a semantic entity; operations like "is this an
    /// enum?" and "does this type have field X?" must answer based on the
    /// target, not the alias.  Generic aliases (e.g. `type Stack<T> = Array<T>`)
    /// are preserved; they're expanded by `resolve_generic`'s
    /// alias-expansion path, which needs the template entry intact.
    /// Transitive aliases are followed to a bounded depth; self-referential
    /// or unresolved aliases short-circuit at the first invalid target.
    follow_alias(&this, ty: TypeRef) -> TypeRef {
        mut current: TypeRef = ty;
        mut depth: i32 = 0;
        while (depth < 8) {
            if (!current.is_valid()) { return current; }
            const t: Type* = this.arena.lookup(current.id);
            if (t == null || t.kind != TypeKind::TypeAlias) { return current; }
            const alias: TypeAliasType* = t as TypeAliasType*;
            if (alias.is_generic) { return current; }
            if (!alias.has_target()) { return current; }
            current = alias.target;
            depth += 1;
        }
        return current;
    }

    /// Length of `ctx.home_module`, or 0 when the context is absent.
    home_module_len(&this, ctx: ResolutionContext*) -> i64 {
        if (ctx == null) { return 0; }
        return ctx.home_module.length() as i64;
    }

    /// Scope of the module the annotation was written in, or an invalid scope
    /// when the context does not name one (or it has no scope of its own).
    home_scope_of(&this, ctx: ResolutionContext*) -> ScopeID {
        if (this.home_module_len(ctx) == 0 || this.name_resolver == null) {
            return ScopeID::invalid();
        }
        const sid: u64 = this.name_resolver.find_module_scope(ctx.home_module);
        if (sid == 0) { return ScopeID::invalid(); }
        return ScopeID { id: sid };
    }

    /// Canonical `<module>::<leaf>` for `name`, resolved as the annotation's OWN
    /// module sees it whenever the context says which module that is.
    ///
    /// This is the step that stops annotation resolution depending on where the
    /// compiler happens to be standing.  The ambient scope chain is consulted
    /// only when the context cannot say - a site that has not yet been taught
    /// its home module, which then behaves exactly as it did before.
    canonical_type_name(&this, name: SymbolStr, ctx: ResolutionContext*) -> SymbolStr {
        if (this.name_resolver == null) { return SymbolStr::empty(); }
        const home: ScopeID = this.home_scope_of(ctx);
        if (home.is_valid()) {
            const via_home: SymbolStr =
                this.name_resolver.resolve_type_qualified_name_from(home, name);
            if (via_home.is_valid()) { return via_home; }
        }
        return this.name_resolver.resolve_type_qualified_name(name);
    }

    /// Resolve a named type (user-defined or generic binding).
    ///
    /// Fallback chain:
    ///   1. Generic bindings (T -> i32 from enclosing generic context)
    ///   2. Primitive name check (handles Named("i32") from generic substitution)
    ///   3. Arena direct lookup by bare name (fast path for same-module types)
    ///   4. Resolver scope chain + cross-module lookup -> qualified arena lookup
    ///   5. Module type registry alias resolution (last resort)
    resolve_named(&this, name: SymbolStr, ctx: ResolutionContext*) -> TypeRef {
        const name_str: string = this.intern_table.resolve(name);
        const name_len: i64 = name_str.length() as i64;
        LOG_DEBUG(LogComponent::TypeChecker, "resolve_named() name='%s'", name_str);
        // 1. Check generic bindings first (O(1) SymbolStr comparison)
        mut binding: TypeRef = ctx.lookup_binding(name);
        if (binding.is_valid()) {
            return binding;
        }

        // 1b. Associated-type projection on a generic parameter: `I::Item`,
        //     where `I` is a generic parameter in scope. Such a projection is
        //     parsed as a FLAT qualified Named (only `This::Item` becomes a
        //     Projection node), so detect it here: if the segment before the
        //     first `::` binds to a type in scope, project the remainder off it.
        //     A real module-qualified type (`core::iter::Foo`) has a prefix
        //     (`core`) that is NOT a generic-param binding, so it is unaffected.
        if (name_len > 2) {
            mut sep: i64 = -1;
            mut k: i64 = 0;
            while (k + 1 < name_len) {
                if (name_str[k] == ':' && name_str[k + 1] == ':') { sep = k; break; }
                k = k + 1;
            }
            if (sep > 0) {
                const prefix_str: string = name_str.substring(0, sep);
                const prefix_sym: SymbolStr = this.intern_table.intern(prefix_str);
                const prefix_ty: TypeRef = ctx.lookup_binding(prefix_sym);
                if (prefix_ty.is_valid()) {
                    const member_str: string =
                        name_str.substring(sep + 2, name_len - sep - 2);
                    const member_sym: SymbolStr = this.intern_table.intern(member_str);
                    const proj: TypeRef = this.project_member(prefix_ty, member_sym, ctx);
                    if (proj.is_valid()) { return proj; }
                }
            }
        }

        // 2. Check if this is a primitive type name.
        //    After generic substitution, the ASTTypeSubstituter creates
        //    Named("i32"), Named("string"), etc. instead of Primitive annotations.
        //    This fallback ensures they resolve correctly.
        const prim: TypeRef = this.resolve_primitive(name);
        if (prim.is_valid()) {
            return prim;
        }

        // 2c. Home-module preference.  A BARE leaf in an annotation means that
        //     leaf as its OWN module sees it.  Every lookup below this point
        //     goes through the ambient scope chain / leaf index, both of which
        //     answer for whatever module the resolver cursor is currently on -
        //     the caller's, at any re-resolution site.  When the caller told us
        //     where the annotation actually lives, the module's own declaration
        //     of the leaf is authoritative and settles the tie before the
        //     module-blind paths can pick the wrong same-leaf type.
        //
        //     Runs ahead of the ambiguity check: a leaf the HOME module declares
        //     is not ambiguous just because the module being compiled imports a
        //     second one under the same name.
        //
        //     Only for bare leaves - a written qualifier is handled
        //     authoritatively by 3a - and only on an exact hit, so a home module
        //     that does not declare the leaf falls through unchanged.
        if ((this.home_module_len(ctx) > 0)
                && this.name_resolver != null
                && !this.name_resolver.contains_separator(name_str)) {
            const home_qn: SymbolStr =
                this.intern_table.intern(ctx.home_module + "::" + name_str);
            if (this.decl_index != null) {
                const home_di: TypeRef = this.decl_index.lookup_type(home_qn);
                if (home_di.is_valid()) {
                    return this.follow_alias(home_di);
                }
            }
            const home_arena: TypeRef = this.arena.lookup_by_name(home_qn);
            if (home_arena.is_valid()) {
                return this.follow_alias(home_arena);
            }
        }

        // 2b. Ambiguity check: if this name was imported from multiple
        //     modules, emit an error telling the user to qualify it.
        if (this.name_resolver != null && this.name_resolver.is_ambiguous(name)) {
            const modules: SymbolStr[] = this.name_resolver.get_ambiguous_modules(name);
            if (modules.length >= 2) {
                // Re-intern to get heap-safe copies for sprintf
                const mod_a: string = this.intern_table.resolve(modules[0]);
                const mod_a_sym: SymbolStr = this.intern_table.intern(mod_a);
                const mod_a_safe: string = this.intern_table.resolve(mod_a_sym);
                const mod_b: string = this.intern_table.resolve(modules[1]);
                const mod_b_sym: SymbolStr = this.intern_table.intern(mod_b);
                const mod_b_safe: string = this.intern_table.resolve(mod_b_sym);

                const msg: string = format(
                    "ambiguous type '%s': imported from both '%s' and '%s'. "
                    "Use a qualified name: '%s::%s' or '%s::%s'",
                    name_str, mod_a_safe, mod_b_safe,
                    mod_a_safe, name_str, mod_b_safe, name_str);
                if (this.diagnostics != null) {
                    this.diagnostics.emit(
                        Diagnostic::error(ErrorCode::E0203_UNDEFINED_TYPE, msg));
                }
            }
            return TypeRef::invalid();
        }

        // 3. DeclarationIndex lookup (canonical post-population path).
        //    After TypeResolution (order 9) populates the index, this is the
        //    primary lookup path.  Falls through to arena for types not yet
        //    registered (e.g., during early resolution phases).
        //    TypeAlias types are transparent; callers of `resolve_named`
        //    should never see them in `resolved_type` fields, so the helper
        //    `follow_alias` unwraps to the alias target before returning.
        if (this.decl_index != null) {
            // 3a. Exact qualified literal first.  When `name` is already
            //     qualified (contains "::"), an exact match against its
            //     registered name is authoritative.  The canonicalizer below
            //     (`resolve_type_qualified_name`) resolves only the *leaf*
            //     segment through the scope chain and discards the prefix, so
            //     for two same-leaf types in different modules
            //     (`ModA::Widget` vs `ModB::Widget`) it would bind to
            //     whichever leaf the scope finds first.  Only fall through to
            //     leaf canonicalization when the literal isn't registered
            //     (e.g. a partially-qualified path that still needs expansion
            //     to the full arena name).
            if (this.name_resolver != null
                    && this.name_resolver.contains_separator(name_str)) {
                const di_literal: TypeRef = this.decl_index.lookup_type(name);
                if (di_literal.is_valid()) {
                    return this.follow_alias(di_literal);
                }
            }
            // Try qualified name first, canonicalized against the annotation's
            // own module when the context names one.
            if (this.name_resolver != null) {
                const qualified: SymbolStr = this.canonical_type_name(name, ctx);
                if (qualified.is_valid()) {
                    const di_found: TypeRef = this.decl_index.lookup_type(qualified);
                    if (di_found.is_valid()) {
                        return this.follow_alias(di_found);
                    }
                }
            }
            // Try bare name
            const di_bare: TypeRef = this.decl_index.lookup_type(name);
            if (di_bare.is_valid()) {
                return this.follow_alias(di_bare);
            }
        }

        // 4. Arena lookup: bootstrap-only fallback.
        //    During Phase 5 (TypeResolution), the DI is being populated, so
        //    types created earlier in the pass exist only in the arena.
        //    After bootstrap completes, all types are in the DI and this
        //    step should never be reached.
        mut found: TypeRef = TypeRef::invalid();
        if (this.bootstrap_mode) {
            found = this.arena.lookup_by_name(name);
            if (found.is_valid()) {
                const found_t: Type* = this.arena.lookup(found.id);
                if (found_t != null && found_t.kind == TypeKind::TypeAlias) {
                    const alias_t: TypeAliasType* = found_t as TypeAliasType*;
                    if (alias_t.has_target()) {
                        return alias_t.target;
                    }
                    return found;
                } else {
                    return found;
                }
            }
        }

        // 4a. Scope chain + arena lookup: bootstrap-only fallback.
        //     Uses the Resolver's scope chain to get a qualified name, then
        //     looks it up in the arena.  Same bootstrap concern as step 4.
        if (this.bootstrap_mode && this.name_resolver != null) {
            const qualified: SymbolStr = this.canonical_type_name(name, ctx);
            if (qualified.is_valid()) {
                found = this.arena.lookup_by_name(qualified);
                if (found.is_valid()) {
                    return found;
                }
            }
        }

        // (Steps 5b and 6 removed; both confirmed dead code:
        //  5b: ModuleTypeRegistry alias: 0 hits across all builds.
        //  6:  Compound-name fallback (ptr/array suffix parsing): 0 hits
        //      after ASTTypeSubstituter fix produces correct annotation kinds.)

        // 5. Leaf-index: O(1) lookup by bare leaf name.
        //    Load-bearing for circular forward references: e.g., AST node
        //    files reference ASTVisitor* in accept() methods but can't
        //    import Compiler::AST::Visitor without creating a cycle.  Also
        //    handles types from transitive submodule re-exports.
        //
        //    No length-based skip.  Step 1 already returned for any name
        //    that's a generic-param binding (`T`, `K`, `V`, `A`, ...); the
        //    earlier `name_len > 2` guard was a length-heuristic shortcut
        //    that silently blocked legitimate short type names (the
        //    visible casualty was `Rc`, which is prelude-exposed but had
        //    its arena-leaf fallback disabled, so `Rc<T>::method(...)`
        //    failed E0233 without an explicit `import alloc::rc;`).
        //    Generic params are arena-registered only as part of a
        //    template's param list and are never inserted into the leaf
        //    index by `register_leaf_name`, so this fallback can't
        //    misroute a stray `T` into a real type.
        found = this.arena.lookup_by_leaf(name);
        if (found.is_valid()) {
            return found;
        }

        // Not found; return invalid (caller should create error)
        LOG_DEBUG(LogComponent::TypeChecker, "[TypeResolver] resolve_named() FAILED for '%s'", name_str);
        return TypeRef::invalid();
    }

    /// Resolve a function type annotation.
    resolve_function(&this, f: FunctionAnnotation*, ctx: ResolutionContext*) -> TypeRef {
        mut ret: TypeRef = this.resolve(f.return_type, ctx);

        mut params: TypeRef[] = [];
        for (mut i: i64 = 0; i < f.parameters.length; i++) {
            params.push(this.resolve(f.parameters[i], ctx));
        }

        return this.arena.get_function(ret, params, false);
    }

    /// Resolve a tuple type annotation.
    /// Empty tuple `()` is the unit type, a distinct arena singleton,
    /// not a zero-element TupleType.
    resolve_tuple(&this, t: TupleAnnotation*, ctx: ResolutionContext*) -> TypeRef {
        if (t.elements.length == 0) {
            return this.arena.get_unit();
        }
        mut elements: TypeRef[] = [];
        for (mut i: i64 = 0; i < t.elements.length; i++) {
            elements.push(this.resolve(t.elements[i], ctx));
        }
        return this.arena.get_tuple(elements);
    }

    /// Resolve a generic type instantiation annotation.
    /// Routes through GenericRegistry for deduplication, ensuring the
    /// Monomorphizer can discover all instantiations via
    /// collect_unmonomorphized().
    ///
    /// Requires GenericRegistry (no silent fallback). If the registry is
    /// missing, the compiler has a pipeline ordering bug and must abort.
    resolve_generic(&this, g: GenericAnnotation*, ctx: ResolutionContext*) -> TypeRef {
        // Resolve the base template WITHOUT default-canonicalization: an explicit
        // `String<...>` must instantiate the String TEMPLATE, not the canonical
        // `String<GlobalAlloc>` (which would nest as `String<GlobalAlloc><...>`).
        // A bare Named base goes straight through resolve_named, bypassing the
        // canonicalization the `resolve()` Named arm applies to bare uses.
        mut base: TypeRef = match (*g.base) {
            TypeAnnotation::Named(bn) => { this.resolve_named(bn.name, ctx) }
            _                         => { this.resolve(g.base, ctx) }
        };

        // Bail early if the base type itself couldn't be resolved.
        if (!base.is_valid()) {
            LOG_DEBUG(LogComponent::TypeChecker,
                "[TypeResolver] resolve_generic() base type is invalid; cannot instantiate");
            return TypeRef::invalid();
        }

        mut args: TypeRef[] = [];
        for (mut i: i64 = 0; i < g.args.length; i++) {
            mut arg: TypeRef = this.resolve(g.args[i], ctx);
            if (!arg.is_valid()) {
                LOG_DEBUG(LogComponent::TypeChecker,
                    "[TypeResolver] resolve_generic() arg %d is invalid", i);
                return TypeRef::invalid();
            }
            args.push(arg);
        }

        // GenericRegistry is required; every instantiation must be tracked
        // so the Monomorphizer can discover and specialize it.
        if (this.generic_registry == null) {
            LOG_DEBUG(LogComponent::TypeChecker,
                "[TypeResolver] ICE: resolve_generic() called without GenericRegistry; "
                "pipeline ordering bug, TemplateRegistration must run before TypeResolution");
            return TypeRef::invalid();
        }

        // Validate arg count matches the template's parameter count.
        // Catches mistakes like Array<i32, string> when Array only takes <T>.
        const entry: TemplateEntry* = this.generic_registry.get_template_by_type_id(base.id);
        if (entry != null) {
            // Default-type-parameter substitution: when the annotation
            // omits trailing args (e.g. `Array<i32>` on a template defined
            // as `Array<T, A = GlobalAlloc>`), fill the tail by resolving
            // each missing param's default annotation. Defaults can
            // reference earlier params, so re-bind on every iteration.
            if (args.length < entry.param_count) {
                args = this.expand_default_type_args(entry, args, ctx);
            }

            if (args.length != entry.param_count) {
                LOG_DEBUG(LogComponent::TypeChecker,
                    "[TypeResolver] resolve_generic() arg count mismatch: "
                    "expected %d, got %d",
                    entry.param_count, args.length);
                return TypeRef::invalid();
            }

            // Generic type alias expansion: instead of creating an
            // InstantiatedType(alias, args) that the Monomorphizer cannot
            // specialize, resolve the alias's target annotation with concrete
            // args bound to its generic params.
            //   e.g. type SomeResult<T> = Result<T, string>;
            //        SomeResult<int> -> resolve Result<T, string> with {T->int}
            //                        -> Result<int, string> (a real instantiation)
            if (entry.node_kind == NodeKind::TypeAliasDeclaration) {
                const alias_node: TypeAliasDeclNode* = entry.ast_node as TypeAliasDeclNode*;
                if (alias_node != null && alias_node.target_annotation != null) {
                    mut alias_ctx: ResolutionContext = ctx.clone();
                    for (mut i: i64 = 0; i < entry.param_count; i++) {
                        alias_ctx.add_binding(entry.param_names[i], args[i]);
                    }
                    LOG_DEBUG(LogComponent::TypeChecker,
                        "[TypeResolver] expanding generic alias '%s' with %d args",
                        this.intern_table.resolve(entry.name), args.length);
                    return this.resolve(alias_node.target_annotation, &alias_ctx);
                }
            }
        }

        // Demand-free (symbolic) mode: build the InstantiatedType in the arena
        // only, skipping the registry's per-module demand registration. This lets
        // the symbolic generic-body walk resolve type-param-bearing annotations
        // (e.g. `Pair<T, V>`) to a concrete arena slot WITHOUT creating a
        // monomorphization demand that `collect_unmonomorphized` would later flag
        // as un-monomorphized (E0900). The arena dedupes by (base, args).
        if (ctx.symbolic_no_demand) {
            return this.arena.create_instantiation(base, &args);
        }

        // Track which module requested this instantiation for per-module codegen.
        const mod_sym: SymbolStr = this.intern_table.intern(ctx.source_file);
        return this.generic_registry.instantiate_for_module(base, args, mod_sym);
    }
}
